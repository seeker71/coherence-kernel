; living-world-transition-expression.fk -- current derivations may carry
; participant-learned surfaces without importing a vocabulary or grammar.
;
; A caller offers a field of admitted symbol candidates that are in view.  A
; candidate participates only when its exact referent is one current transition
; derivation or that derivation's exact next content.  Derivation reference
; keeps situated speech local; content reference lets a learned surface travel
; only where the identical content recurs.  Zero matching surfaces leaves that
; derivation explicitly unvoiced, one remains one, and several remain plural;
; no winner is selected.
; The plan retains the prediction's optional alternatives and unknown through
; exact prediction identity.  Rendering returns only an offered exact surface.
;
; This is an inspectable Form-native projection, not an authority grant or an
; imported-answer route.  Any outward act still crosses the ordinary tending
; membrane chosen by its caller.
;
; witnessed: 2026-08-09 -> 262143 existing + 1048575 content reuse on fkwu
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-field.fk

(let LWTX-SURFACE (bp "LWTX-SURFACE"))
(let LWTX-PLAN    (bp "LWTX-PLAN"))

; children: exact current derivation, exact current learned-symbol candidate,
; local path
(defn lwtx-surface (derivation symbol)
    (intern_node LWTX-SURFACE
        (list derivation symbol (lwo-local-path))))
(defn lwtx-surface? (cell) (lwo-category? cell LWTX-SURFACE))
(defn lwtx-surface-derivation (surface)
    (nth (node_children surface) 0))
(defn lwtx-surface-symbol (surface)
    (nth (node_children surface) 1))
(defn lwtx-surface-text (surface)
    (lwnv-symbol-surface
        (lwo-emergent-shape (lwtx-surface-symbol surface))))

(defn lwtx-symbol-matches? (world derivation candidate)
    (if (and (eq (lwtf-derivation-current? world derivation) 1)
             (and (eq (lwsl-integrated-current? world candidate) 1)
                  (do
                    (let referent
                        (lwnv-symbol-referent
                            (lwo-emergent-shape candidate)))
                    (if (or (node_eq referent derivation)
                            (node_eq referent
                                (lwtf-derivation-next derivation)))
                        1 0)))) 1 0))

(defn lwtx-matching-symbols-items
    (world derivation items matches)
    (if (eq (len items) 0) matches
        (do
            (let candidate (head items))
            (lwtx-matching-symbols-items world derivation (tail items)
                (if (eq (lwtx-symbol-matches?
                            world derivation candidate) 1)
                    (lwo-field-add matches candidate) matches)))))

(defn lwtx-matching-symbols (world derivation symbols)
    (lwtx-matching-symbols-items world derivation
        (lwo-field-items symbols) (lwo-empty-field)))

(defn lwtx-add-surfaces (derivation items surfaces)
    (if (eq (len items) 0) surfaces
        (lwtx-add-surfaces derivation (tail items)
            (lwo-field-add surfaces
                (lwtx-surface derivation (head items))))))

; Returns (surfaces, unvoiced derivations).  Both retain plurality.
(defn lwtx-collect
    (world derivations symbols surfaces unvoiced)
    (if (eq (len derivations) 0) (list surfaces unvoiced)
        (do
            (let derivation (head derivations))
            (let matches (lwtx-matching-symbols world derivation symbols))
            (if (eq (lwo-field-size matches) 0)
                (lwtx-collect world (tail derivations) symbols surfaces
                    (lwo-field-add unvoiced derivation))
                (lwtx-collect world (tail derivations) symbols
                    (lwtx-add-surfaces derivation
                        (lwo-field-items matches) surfaces)
                    unvoiced)))))

; children: exact prediction, offered symbol field, current surface field,
; current unvoiced derivations, plural acknowledgement, local path
(defn lwtx-plan-cell (prediction symbols surfaces unvoiced ack)
    (intern_node LWTX-PLAN
        (list prediction symbols surfaces unvoiced ack (lwo-local-path))))
(defn lwtx-plan? (cell) (lwo-category? cell LWTX-PLAN))
(defn lwtx-plan-prediction (plan) (nth (node_children plan) 0))
(defn lwtx-plan-symbols (plan) (nth (node_children plan) 1))
(defn lwtx-plan-surfaces (plan) (nth (node_children plan) 2))
(defn lwtx-plan-unvoiced (plan) (nth (node_children plan) 3))
(defn lwtx-plan-ack (plan) (nth (node_children plan) 4))
(defn lwtx-plan-alternatives (plan)
    (lwtf-prediction-alternatives (lwtx-plan-prediction plan)))
(defn lwtx-plan-unknown (plan)
    (lwtf-prediction-unknown (lwtx-plan-prediction plan)))

(defn lwtx-plan-for (world prediction symbols)
    (if (or (eq (lwo-category? symbols LWO-FIELD) 0)
            (eq (lwtf-prediction-current? world prediction) 0))
        (lwo-none)
        (do
            (let collected
                (lwtx-collect world
                    (lwo-field-items
                        (lwtf-prediction-derivations prediction))
                    symbols (lwo-empty-field) (lwo-empty-field)))
            (let surfaces (nth collected 0))
            (let unvoiced (nth collected 1))
            (let count (lwo-field-size surfaces))
            (let ack
                (if (eq count 0) (oac-nothing)
                    (if (eq count 1)
                        (oac-one (head (lwo-field-items surfaces)))
                        (oac-node surfaces))))
            (lwtx-plan-cell prediction symbols surfaces unvoiced ack))))

(defn lwtx-surface-current? (world surface)
    (if (eq (lwtx-surface? surface) 0) 0
        (if (node_eq surface
                (lwtx-surface
                    (lwtx-surface-derivation surface)
                    (lwtx-surface-symbol surface)))
            (lwtx-symbol-matches? world
                (lwtx-surface-derivation surface)
                (lwtx-surface-symbol surface)) 0)))

(defn lwtx-plan-current? (world plan)
    (if (eq (lwtx-plan? plan) 0) 0
        (if (node_eq plan
                (lwtx-plan-for world
                    (lwtx-plan-prediction plan)
                    (lwtx-plan-symbols plan))) 1 0)))

0
