; form-knowledge-query-memory-shard-exec.fk -- execute one validated,
; answer-free query-memory request through one exact public-source route.
;
; The adjacent query-memory executor proves the request's scannerless bytes,
; digests and answer-free provenance.  A generic semantic index can still offer
; a close row from another source, so this crossing binds the source before
; lookup: (key, family, path) names exactly one persisted .route reference.
; The referenced shard is then checked against the requested source digest and
; rehashed from the current repository before a hit is admitted.
;
; This is one-shot recipe execution, not a registry or operations table.  The
; request remains data; this walker adds no function per memory.  It opens no
; model, remote lane, Metal, MLX, flattened artifact, or C seed surface.
;
; A source may change after its final hash and before the caller acts on this
; returned observation.  The returned current-source-id is the exact bytes
; observed during this call, not a lease over later bytes.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/bmf-core.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/file-byte-window.fk form-stdlib/sha256.fk
; preludes: form-stdlib/hex.fk form-stdlib/form-cli-router.fk
; preludes: form-stdlib/text-tokenize.fk form-stdlib/rag-embed.fk
; preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk
; preludes: form-stdlib/rag-ask.fk form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-source-search.fk
; preludes: form-stdlib/public-source-concept-index.fk
; preludes: form-stdlib/public-source-concept-shards.fk
; preludes: form-stdlib/public-source-concept-key-routes.fk
; preludes: form-stdlib/form-knowledge-query-memory-rotation-token.fk
; preludes: form-stdlib/form-knowledge-query-memory-exec.fk
; Proven by: form-stdlib/tests/form-knowledge-query-memory-shard-exec-band.fk

(do
    (defn fkqmsx-binding-schema ()
        "form-knowledge-query-memory-source-binding-v1")
    (defn fkqmsx-result-schema ()
        "form-knowledge-query-memory-shard-exec-result-v1")

    ; The request owns its source digest.  The binding adds only the persisted
    ; shard coordinate required to select one source before lookup.
    (defn fkqmsx-binding (request family path)
        (list (fkqmsx-binding-schema) request family path))
    (defn fkqmsx-binding-request (b) (nth b 1))
    (defn fkqmsx-binding-family (b) (nth b 2))
    (defn fkqmsx-binding-path (b) (nth b 3))
    (defn fkqmsx-binding-shaped? (b)
        (if (nothing? b) 0
            (if (not (eq (len b) 4)) 0
                (if (str_eq (nth b 0) (fkqmsx-binding-schema)) 1 0))))
    (defn fkqmsx-binding-ready? (b)
        (if (eq (fkqmsx-binding-shaped? b) 0) 0
            (if (eq (fkqmx-ready? (fkqmsx-binding-request b)) 0) 0
                (psci-path-valid-for-family?
                    (fkqmsx-binding-path b) (fkqmsx-binding-family b)))))
    (defn fkqmsx-expected-source-id (b)
        (if (eq (fkqmsx-binding-shaped? b) 0) ""
            (str_concat "sha256:"
                (fkqmx-recipe-source-sha
                    (fkqmx-request-recipe (fkqmsx-binding-request b))))))

    ; result = schema status reason binding query-token key family path
    ;          expected-source-id current-source-id source-node entry-node
    ;          source-content-key entry-content-key value value-present
    ;          lookup-count hit-count executed model-executed
    ;          scannerless pretokenized trace
    (defn fkqmsx-result
        (status reason binding query-token key family path expected current
         source entry source-key entry-key value present lookups hits executed
         trace)
        (list (fkqmsx-result-schema) status reason binding query-token key
            family path expected current source entry source-key entry-key
            value present lookups hits executed 0 1 0 trace))
    (defn fkqmsx-status (r) (nth r 1))
    (defn fkqmsx-reason (r) (nth r 2))
    (defn fkqmsx-result-binding (r) (nth r 3))
    (defn fkqmsx-query-token (r) (nth r 4))
    (defn fkqmsx-key (r) (nth r 5))
    (defn fkqmsx-family (r) (nth r 6))
    (defn fkqmsx-path (r) (nth r 7))
    (defn fkqmsx-expected-source-id-of (r) (nth r 8))
    (defn fkqmsx-current-source-id (r) (nth r 9))
    (defn fkqmsx-source-node (r) (nth r 10))
    (defn fkqmsx-entry-node (r) (nth r 11))
    (defn fkqmsx-source-content-key (r) (nth r 12))
    (defn fkqmsx-entry-content-key (r) (nth r 13))
    (defn fkqmsx-value (r) (nth r 14))
    (defn fkqmsx-value-present? (r) (nth r 15))
    (defn fkqmsx-lookup-count (r) (nth r 16))
    (defn fkqmsx-hit-count (r) (nth r 17))
    (defn fkqmsx-executed? (r) (nth r 18))
    (defn fkqmsx-model-executed? (r) (nth r 19))
    (defn fkqmsx-scannerless? (r) (nth r 20))
    (defn fkqmsx-pretokenized? (r) (nth r 21))
    (defn fkqmsx-trace (r) (nth r 22))

    (defn fkqmsx-empty-result
        (status reason binding query-token key lookups executed trace)
        (fkqmsx-result status reason binding query-token key
            (if (eq (fkqmsx-binding-shaped? binding) 1)
                (fkqmsx-binding-family binding) "")
            (if (eq (fkqmsx-binding-shaped? binding) 1)
                (fkqmsx-binding-path binding) "")
            (fkqmsx-expected-source-id binding) "" (nothing) (nothing) "" ""
            (nothing) 0 lookups 0 executed trace))
    (defn fkqmsx-failure (reason binding query-token key lookups executed)
        (fkqmsx-empty-result "failure" reason binding query-token key lookups
            executed (list "choice" "failure" "cut" "undo" "refine"
                "release")))

    ; inspection = status reason record freshly-observed-source-id.
    ; Only this door touches the filesystem, and it opens the reference whose
    ; filename is derived from the request key plus the declared coordinate.
    (defn fkqmsx-inspect-source-route (ctx binding key)
        (do
            (let root (nth ctx 0))
            (let source-artifact (nth ctx 1))
            (let route-artifact (nth ctx 2))
            (let target (psckr-reference-path-at route-artifact key
                (fkqmsx-binding-family binding)
                (fkqmsx-binding-path binding)))
            (let inspected
                (psckr-inspect-reference-at root source-artifact target key))
            (if (not (str_eq (nth inspected 0) "current"))
                (list (nth inspected 0) (nth inspected 1) (empty) "")
                (do
                    (let record (nth inspected 2))
                    (let current (fkss-source-id
                        (fs-path-join root (pscish-record-path record))))
                    (list "current" "current" record current)))))

    (defn fkqmsx-record-bound? (record binding key current)
        (if (not (eq (len record) 13)) 0
            (if (not (str_eq (pscish-record-family record)
                             (fkqmsx-binding-family binding))) 0
            (if (not (str_eq (pscish-record-path record)
                             (fkqmsx-binding-path binding))) 0
            (if (not (str_eq (pscish-record-source-id record)
                             (fkqmsx-expected-source-id binding))) 0
            (if (not (str_eq current (fkqmsx-expected-source-id binding))) 0
            (if (not (str_eq current
                             (pscish-record-source-id record))) 0
                (pscish-key-member? key
                    (pscish-record-keys record)))))))))

    (defn fkqmsx-hit (binding query key record current)
        (fkqmsx-result "hit" "current-source-bound-route" binding
            (fkqt-request-token query) key
            (pscish-record-family record) (pscish-record-path record)
            (fkqmsx-expected-source-id binding) current
            (pscish-record-source record) (pscish-record-entry record)
            (pscish-record-source-content-key record)
            (pscish-record-entry-content-key record)
            (pscish-record-size record) 1 1 1 1
            (list "choice" "cut" "release")))

    ; `inspect` is injectable for adversarial proof.  It is invoked exactly
    ; once, and only after the request and its complete scannerless frame pass.
    (defn fkqmsx-execute-with (ctx inspect binding)
        (if (eq (fkqmsx-binding-ready? binding) 0)
            (fkqmsx-failure "source-binding-invalid" binding
                (nothing) "" 0 0)
            (do
                (let request (fkqmsx-binding-request binding))
                (let parsed (fkqt-parse
                    (fkqmx-query-bytes (fkqmx-request-recipe request))))
                (if (not (eq (fkqt-request-ready? parsed) 1))
                    (fkqmsx-empty-result (fkqt-request-state parsed)
                        (fkqt-request-reason parsed) binding (nothing) "" 0 0
                        (list "choice" "cut" "undo" "refine" "release"))
                    (do
                        (let key (fkqt-request-query parsed))
                        (if (eq (psci-concept-key-valid? key) 0)
                            (fkqmsx-failure "invalid-concept-key" binding
                                (fkqt-request-token parsed) key 0 0)
                            (do
                                (let observed (inspect ctx binding key))
                                (if (or (nothing? observed)
                                        (not (eq (len observed) 4)))
                                    (fkqmsx-failure "invalid-route-observation"
                                        binding (fkqt-request-token parsed)
                                        key 1 1)
                                (if (str_eq (nth observed 0) "current")
                                    (if (eq (fkqmsx-record-bound?
                                                (nth observed 2) binding key
                                                (nth observed 3)) 1)
                                        (fkqmsx-hit binding parsed key
                                            (nth observed 2) (nth observed 3))
                                        (fkqmsx-failure
                                            "route-source-binding-mismatch"
                                            binding (fkqt-request-token parsed)
                                            key 1 1))
                                (if (str_eq (nth observed 0) "missing")
                                    (fkqmsx-empty-result "miss" (nth observed 1)
                                        binding (fkqt-request-token parsed) key
                                        1 1 (list "choice" "cut" "release"))
                                (if (str_eq (nth observed 0) "nothing")
                                    (fkqmsx-empty-result "nothing"
                                        (nth observed 1) binding
                                        (fkqt-request-token parsed) key 1 1
                                        (list "choice" "cut" "undo" "refine"
                                            "release"))
                                (if (str_eq (nth observed 0) "timeout")
                                    (fkqmsx-empty-result "timeout"
                                        (nth observed 1) binding
                                        (fkqt-request-token parsed) key 1 1
                                        (list "choice" "timeout" "cut" "undo"
                                            "refine" "release"))
                                    (fkqmsx-failure (nth observed 1) binding
                                        (fkqt-request-token parsed) key
                                        1 1)))))))))))))

    (defn fkqmsx-execute-at
        (root source-artifact route-artifact binding)
        (fkqmsx-execute-with (list root source-artifact route-artifact)
            fkqmsx-inspect-source-route binding))

    0)
