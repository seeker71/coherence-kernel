; form-cli-qwen-teach-layer-live.fk — print the embodied teach-layer floor.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-qwen-teach-layer.fk

(do
    (print "fqt base=")
    (print (fqt-base))
    (print " rung=")
    (print (int_to_str (fqt-rung-now)))
    (print " adapter-kind=")
    (print (fqt-adapter-kind))
    (print " lora=")
    (print (int_to_str (fqt-lora?)))
    (print " adapter-observed=")
    (print (int_to_str (fqt-adapter-observed?)))
    (print " corpus-pairs=")
    (print (int_to_str (fqt-corpus-pairs)))
    (print " nvr-complete=")
    (print (int_to_str (fqt-nvr-complete-pairs)))
    (print " n=")
    (print (int_to_str (fqt-n)))
    (print " leakage=")
    (print (int_to_str (fqt-leakage)))
    (print " heldout-n=")
    (print (int_to_str (fqt-heldout-n)))
    (print " heldout-correct=")
    (print (int_to_str (fqt-heldout-correct)))
    (print "\n")
    (print "fqt overlay=")
    (print (fqt-overlay-prefix))
    (print "\n")
    (print "fqt prompt-hello=")
    (print (fqt-prompt "hello"))
    (print "\n")
    (print "fqt heldout nothing=")
    (print (int_to_str (fqt-verdict-index (fqt-heldout-of "nothing"))))
    (print " cut=")
    (print (int_to_str (fqt-verdict-index (fqt-heldout-of "cut"))))
    (print " stop=")
    (print (int_to_str (fqt-verdict-index (fqt-heldout-of "stop"))))
    (print " undo=")
    (print (int_to_str (fqt-verdict-index (fqt-heldout-of "undo"))))
    (print " timeout=")
    (print (int_to_str (fqt-verdict-index (fqt-heldout-of "timeout"))))
    (print " choice=")
    (print (int_to_str (fqt-verdict-index (fqt-heldout-of "choice"))))
    (print "\n")
    (print "fqt check=")
    (print (int_to_str (fqt-check)))
    (print "\n")
    0)
