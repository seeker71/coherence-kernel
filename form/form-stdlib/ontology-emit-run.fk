; ontology-emit-run.fk - regenerate what form-ontology.json generates.
; preflight-exec: forbidden
;
; With no stdin it writes form/form-stdlib/dialect-categories.fk. One stdin
; line names another target instead: "PATH" takes the dialect text (a scratch
; copy to cmp against the carried file), "engine PATH" takes the engine row
; block form/form-stdlib/engine-constants.fk carries, "pn PATH" takes the
; pn-categories source form/scripts/build_form_compiler_artifact.sh compiles.
; preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/ontology-emit.bml

(do
    (defn oer-trim-loop (s n)
        (if (le n 0) ""
            (if (str_eq (substring s (sub n 1) n) "\n")
                (oer-trim-loop s (sub n 1))
                (substring s 0 n))))

    (defn oer-line (raw)
        (if (nothing? raw) "" (oer-trim-loop raw (str_len raw))))

    (defn oer-starts? (line word)
        (if (ge (str_len line) (str_len word))
            (str_eq (substring line 0 (str_len word)) word)
            false))

    (defn oer-after (line word)
        (substring line (str_len word) (str_len line)))

    (let line (oer-line (read_line)))
    (let root (oe-root))
    (let target
        (if (eq (str_len line) 0)
            (oe-dialect-path)
        (if (oer-starts? line "engine ")
            (oer-after line "engine ")
        (if (oer-starts? line "pn ")
            (oer-after line "pn ")
            line))))
    (let text
        (if (oer-starts? line "engine ")
            (oe-engine-block root)
        (if (oer-starts? line "pn ")
            (oe-pn-categories-text root)
            (oe-dialect-text root))))
    (write_file_text target text)
    (print_str
        (str_concat "ontology-emit wrote "
            (str_concat target
                (str_concat " ("
                    (str_concat (int_to_str (str_len text)) " bytes)\n")))))
    (str_len text))
