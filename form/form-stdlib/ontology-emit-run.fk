// ontology-emit-run.fk - regenerate what form-ontology.json generates.
// preflight-exec: forbidden
//
// With no stdin it writes form/form-stdlib/dialect-categories.fk. One stdin
// line names another target instead: "PATH" takes the dialect text (a scratch
// copy to cmp against the carried file), "engine PATH" takes the engine row
// block form/form-stdlib/engine-constants.fk carries.
import form-stdlib/core.fk;
import form-stdlib/json.fk;
import form-stdlib/bml/ontology-emit.bml;
section [form.bml] {
    def oer-trim-loop(s, n) = n <= 0 ? "" : (String) substring(s, n - 1, n) == "\n" ? oer-trim-loop(s, n - 1) : substring(s, 0, n);
    def oer-line(raw) = nothing?(raw) ? "" : oer-trim-loop(raw, len(raw));
    def oer-starts?(line, word) = len(line) >= len(word) ? (String) substring(line, 0, len(word)) == word : false;
    def oer-after(line, word) = substring(line, len(word), len(line));
    let line = oer-line(read_line());
    let root = oe-root();
    let target = (Comparable) len(line) == 0 ? oe-dialect-path() : oer-starts?(line, "engine ") ? oer-after(line, "engine ") : line;
    let text = oer-starts?(line, "engine ") ? oe-engine-block(root) : oe-dialect-text(root);
    write_file_text(target, text);
    print_str(("ontology-emit wrote " + (target + (" (" + (len(text).str() + " bytes)\n")))));
    len(text);
}
