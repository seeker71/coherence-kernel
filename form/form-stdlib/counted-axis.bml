//////////////////////////////////////////////////////////////////////
//
// counted-axis.bml — a counted measure stays present at zero.
//
// High BML: one generic reading for every axis whose number can be zero.
// Present means the field was written. Absent means the field was not.
// Zero is a value (the line just moved), not a missing line.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/language-template.fk
// Proven by: form/form-stdlib/tests/counted-axis-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template CountedMeasure<TValue> {
        member present: int;
        member value: TValue;
    }

    class CountedAxis<T> {
        thought car-meaning = ["field-present-including-zero", "field-absent"];

        def car-present(has) = if eq(has, 0) then 0 else 1;
        def car-value(has, value) = if eq(has, 0) then 0 else value;
        def car-read(has, value) = [car-present(has), car-value(has, value)];
    }

    0;
}
