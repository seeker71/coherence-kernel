; covenant-census.fk — which of the body's answers are covenant, and which
; are representational accident? The pure half of the winnowing organ.
;
; A claim is one small Form expression run on every embodiment (fkwu, go,
; rust, ts). Each arm's run reduces to a RESULT (answer-text rc). Four
; results classify the claim:
;
;   covenant  — every arm alive (rc 0) and every trimmed answer identical:
;               the claim survived independent embodiment; today's run is
;               its freshness stamp (observe/belief-freshness.fk's law).
;   split     — every arm alive, answers differ: the worst class — silent
;               divergent meaning, nobody refuses, everybody disagrees.
;   partial   — some arms answer, some refuse (rc != 0): a seam with a
;               loud side; which arms refuse is carried in the answers text.
;   refused   — every arm refuses: the claim has no living surface today.
;
; The ATLAS is the dated ledger of classes (learn/covenant-atlas.txt, one
; row `name|class|answers|stamp-ms`). A later census compares its fresh
; class against the atlas row: a change is DRIFT — the exact wound this
; organ exists to close, because 2026-08-27 found two aged four-way stamps
; by hand (form-eval-full-band's nothing claim; grammars/form-eval-band's
; env idiom) and both had drifted in silence. Witness ages; the atlas makes
; the aging visible on the next run instead of years later.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/str-byte-at.fk
;
; Proven by: form-stdlib/tests/covenant-census-band.fk

(do
    ; ── one arm's result ───────────────────────────────────────────────────
    (defn cvc-result (text rc) (list text rc))
    (defn cvc-text (r) (nth r 0))
    (defn cvc-rc (r) (nth r 1))
    (defn cvc-alive? (r) (if (eq (cvc-rc r) 0) 1 0))

    ; trim ascii whitespace from both ends — arms differ in trailing
    ; newlines and print spacing; meaning lives in the trimmed bytes.
    (defn cvc-ws? (c)
        (if (eq c 32) 1 (if (eq c 10) 1 (if (eq c 13) 1 (if (eq c 9) 1 0)))))
    (defn cvc-trim-start (s i)
        (if (ge i (str_len s)) i
            (if (eq (cvc-ws? (str-byte-at s i)) 1)
                (cvc-trim-start s (add i 1)) i)))
    (defn cvc-trim-end (s j)
        (if (le j 0) j
            (if (eq (cvc-ws? (str-byte-at s (sub j 1))) 1)
                (cvc-trim-end s (sub j 1)) j)))
    (defn cvc-trim (s)
        (do (let a (cvc-trim-start s 0))
            (let b (cvc-trim-end s (str_len s)))
            (if (ge a b) "" (substring s a b))))

    ; ── classification over the four arms ──────────────────────────────────
    (defn cvc-alive-count (a b c d)
        (add (cvc-alive? a) (add (cvc-alive? b)
            (add (cvc-alive? c) (cvc-alive? d)))))
    (defn cvc-same? (a b)
        (if (str_eq (cvc-trim (cvc-text a)) (cvc-trim (cvc-text b))) 1 0))
    (defn cvc-class (a b c d)
        (do (let alive (cvc-alive-count a b c d))
            (if (eq alive 0) "refused"
            (if (lt alive 4) "partial"
            (if (and (cvc-same? a b)
                     (and (cvc-same? a c) (cvc-same? a d)))
                "covenant" "split")))))

    ; one arm's summary word: its trimmed answer, or refuse(rc)
    (defn cvc-arm-word (r)
        (if (eq (cvc-alive? r) 1) (cvc-trim (cvc-text r))
            (str_concat "refuse(" (str_concat (int_to_str (cvc-rc r)) ")"))))
    (defn cvc-answers (a b c d)
        (str_concat "fkwu=" (str_concat (cvc-arm-word a)
        (str_concat " go=" (str_concat (cvc-arm-word b)
        (str_concat " rust=" (str_concat (cvc-arm-word c)
        (str_concat " ts=" (cvc-arm-word d)))))))))

    ; ── the atlas: dated ledger rows, drift detection ──────────────────────
    (defn cvc-atlas-row (name class answers stamp)
        (str_concat name (str_concat "|" (str_concat class
        (str_concat "|" (str_concat answers
        (str_concat "|" (str_concat (int_to_str stamp) "\n"))))))))
    ; class recorded for name in an atlas text, "" when absent
    (defn cvc-atlas-class (atlas name)
        (do (let key (str_concat "\n" (str_concat name "|")))
            (let at (str_find (str_concat "\n" atlas) key 0))
            (if (lt at 0) ""
                (do (let start (add at (str_len key)))
                    (let stop (str_find (str_concat "\n" atlas) "|" start))
                    (if (lt stop 0) ""
                        (substring (str_concat "\n" atlas) start stop))))))
    ; drift: the OLD class when the atlas holds a different one; "" when the
    ; class is unchanged or the name is new (a new claim is growth, not drift)
    (defn cvc-drift (atlas name class)
        (do (let old (cvc-atlas-class atlas name))
            (if (or (str_eq old "") (str_eq old class)) "" old)))
    0)
