// typed-literal-carrier.fk -- explicit typed literal NodeID wrappers.
//
// This layer gives later program-image/cache layers a way to carry literal
// data through NodeID structure instead of guessing raw value kinds. It does
// not integrate with PIRC admission yet and does not write/load .fkb artifacts.
//
// preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk
section [form.bml] {
    def tlit-version() = "typed-literal-carrier-v1";
    def tlit-feature(name, status) = list("typed-literal-carrier-feature", name, status);
    def tlit-feature-name(f) = nth(f, 1);
    def tlit-feature-status(f) = nth(f, 2);
    def typed-literal-carrier-manifest() = list(tlit-feature("typed-int-wrapper", 1), tlit-feature("typed-string-wrapper", 1), tlit-feature("typed-list-wrapper", 1), tlit-feature("registered-blueprint-categories", 1), tlit-feature("trivial-child-node-types", 1), tlit-feature("recursive-list-validation", 1), tlit-feature("sibling-exact-node-id-guard", 1), tlit-feature("direct-fkwu-category-shape-fallback", 1), tlit-feature("direct-fkwu-raw-negative-nodeid-alias-floor", 1), tlit-feature("wide-int-child-type-admitted", 1), tlit-feature("total-sentinel-accessors", 1), tlit-feature("does-not-change-pirc-admission", 1), tlit-feature("no-parser", 1), tlit-feature("no-form-binary-io", 1), tlit-feature("no-runtime-load-call", 1), tlit-feature("no-c-seed-growth", 1));
    def typed-literal-carrier-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) tlit-feature-name(head(fs)) == name && (Comparable) tlit-feature-status(head(fs)) == 1 ? 1 : typed-literal-carrier-manifest-has?(name, tail(fs));
    def tlit-int-bp() = bp("TYPED-LITERAL-INT");
    def tlit-string-bp() = bp("TYPED-LITERAL-STRING");
    def tlit-list-bp() = bp("TYPED-LITERAL-LIST");
    def tlit-int(n) = intern_node(tlit-int-bp(), list(intern_trivial_int(n)));
    def tlit-string(s) = intern_node(tlit-string-bp(), list(intern_trivial_string(s)));
    def tlit-list(items) = intern_node(tlit-list-bp(), items);
    def tlit-exact-kind-floor?() = (String) value_kind(0) == "int" && ((String) value_kind("x") == "string" && ((String) value_kind(list(1)) == "list" && (String) value_kind(intern_trivial_int(0)) == "node_id"));
    def tlit-nodeid-carrierable?(x) = tlit-exact-kind-floor?() ? (String) value_kind(x) == "node_id" : 1;
    def tlit-int-child-type?(child) = tlit-nodeid-carrierable?(child) ? (Comparable) node_type(child) == 1 ? 1 : (Comparable) node_type(child) == 5 : 0;
    def tlit-string-child-type?(child) = tlit-nodeid-carrierable?(child) ? (Comparable) node_type(child) == 2 : 0;
    def tlit-int?(x) = tlit-nodeid-carrierable?(x) ? node_eq(node_category(x), tlit-int-bp()) ? (Comparable) len(node_children(x)) == 1 ? tlit-int-child-type?(head(node_children(x))) : 0 : 0 : 0;
    def tlit-string?(x) = tlit-nodeid-carrierable?(x) ? node_eq(node_category(x), tlit-string-bp()) ? (Comparable) len(node_children(x)) == 1 ? tlit-string-child-type?(head(node_children(x))) : 0 : 0 : 0;
    def tlit-list-items-valid?(items) = nil?(items) ? 1 : tlit?(head(items)) ? tlit-list-items-valid?(tail(items)) : 0;
    def tlit-list?(x) = tlit-nodeid-carrierable?(x) ? node_eq(node_category(x), tlit-list-bp()) ? tlit-list-items-valid?(node_children(x)) : 0 : 0;
    def tlit?(x) = tlit-int?(x) ? 1 : tlit-string?(x) ? 1 : tlit-list?(x);
    def tlit-int-value(x) = tlit-int?(x) ? node_value(head(node_children(x))) : 0;
    def tlit-string-value(x) = tlit-string?(x) ? node_value(head(node_children(x))) : "";
    def tlit-list-items(x) = tlit-list?(x) ? node_children(x) : empty();
}
