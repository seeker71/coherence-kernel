            "turn-evidence-refresh=unreconciled\n";
        };
    };
    def fctel-collect-continue(size, complete-at, turn-id, segment-start, segment-end, chunk-end, state) = {
        write_file_text(fctel-candidate-row-path(), "");
        write_file_text(fctel-progress-path(), fctel-progress-row(size, turn-id, segment-start, complete-at, chunk-end, state));
        fctel-join(["turn-evidence-refresh=progress cursor=", int_to_str(chunk-end - segment-start), "/", int_to_str(segment-end - segment-start), "\n"]);
    };
    def fctel-collect-bounded(path, size, complete-at, turn-id, segment-start, segment-end, cursor, state) = {
        let chunk = fctel-bounded-chunk(path, cursor, segment-end);
        let chunk-end = fctel-chunk-end(chunk);
        chunk-end < 0 ? fctel-collector-refuse("jsonl-row-unreadable-or-exceeds-row-cap") : {
            let state2 = fctel-process-segment(fctel-chunk-body(chunk), 0, state);
            chunk-end >= segment-end ? fctel-collect-finish(path, size, complete-at, turn-id, segment-start, segment-end, state2) : fctel-collect-continue(size, complete-at, turn-id, segment-start, segment-end, chunk-end, state2);
        };
    };
    def fctel-collect-once(path, size, complete-at, turn-id, segment-start) = {
        let segment-end = fctel-line-end(path, size, complete-at);
        segment-end < 0 ? fctel-collector-refuse("terminal-jsonl-row-exceeds-slice") : {
            let progress = fctel-read-progress();
            let resume = fctel-progress-matches?(progress, size, turn-id, segment-start, complete-at);
            let cursor = (Comparable) resume == 1 ? str_to_int(progress[5]) : segment-start;
            let state = (Comparable) resume == 1 ? fctel-progress-state(progress) : fctel-state();
            fctel-collect-bounded(path, size, complete-at, turn-id, segment-start, segment-end, cursor, state);
        };
    };
    def fctel-refresh-coordinate-once(path, size, complete-at, turn-id) = {
        let start = fctel-resolve-start-once(path, size, turn-id, complete-at);
        (Comparable) start[0] == 1 ? fctel-collect-once(path, size, complete-at, turn-id, start[1]) : {
            write_file_text(fctel-candidate-row-path(), "");
            start[2] <= 0 ? "turn-evidence-refresh=unavailable reason=missing-task-start\n" : fctel-join(["turn-evidence-refresh=locating-start cursor=", int_to_str(start[2]), "/", int_to_str(complete-at), "\n"]);
        };
    };
    def fctel-refresh-once(path) = {
        let size = file_size(path);
        let discovery = fctel-discover-latest-complete(path);
        let complete-at = discovery[1];
        let turn-id = discovery[2];
        size <= 0 || (complete-at < 0 || (String) turn-id == "") ? size <= 0 ? "turn-evidence-refresh=unavailable reason=empty-source\n" : fctel-join(["turn-evidence-refresh=discovering cursor=", int_to_str(discovery[3]), "/", int_to_str(discovery[4]), "\n"]) : fctel-refresh-coordinate-once(path, size, complete-at, turn-id);
    };
    def fctel-bound-path() =     // The private explicit binding is a host-ABI capability.  `file_size` is
    // a compatibility alias; the canonical metadata door keeps the binding
    // visible to the same carrier that wrote it.
host_file_size(fctel-binding-path()) > 0 ? fctel-trim-end(read_file(fctel-binding-path())) : "";
    // The token reading's source.  The explicit binding wins wherever it stands;
    // where nobody has written one, the body finds its own agent transcript, so the
    // six counters are a reading that exists on this host rather than an absence
    // waiting on a human step.
    //
    // This is deliberately a second door rather than a widening of the one above.
    // The completed-turn lane above reads Codex turn boundaries — turn_id, the
    // terminal payload, the tool and native-command events that make a boundary
    // share.  An agent transcript carries none of those, so handing it to that lane
    // buys no reading and costs a durable cursor walking a growing file: measured
    // here at 2.6 s per invocation to answer complete-at=-1.  The token counters,
    // by contrast, this body can read from either provider exactly.
    def fctel-cursor-transcript-path() = host_file_size(".form-cli-turn-cursor-transcript") > 0 ? fctel-trim-end(read_file(".form-cli-turn-cursor-transcript")) : "";
    def fctel-token-source-path() = {
        let bound = fctel-bound-path();
        let cursor = fctel-cursor-transcript-path();
        (String) bound == "" ? (String) cursor == "" ? fctd-discovered-path() : cursor : bound;
    };
    // The reading and the name of what answered it, taken together in one pass, so
    // a caller pays for one traversal of the session store rather than three.
    // This host's own cursor transcript, written by the attendance above, is read
    // before another agent's store. A number from a different session is not this
    // turn.
    def fctel-token-reading() = {
        let path = fctel-token-source-path();
        let kind = (String) path == "" ? "unavailable" : !((String) fctel-bound-path() == "") ? "explicit-binding" : (String) fctel-cursor-transcript-path() == "" ? "discovered-agent-transcript" : "cursor-session-transcript";
        (String) path == "" ? [path, kind, fctel-state()] : [path, kind, fctel-last-usage-state(path)];
    };
    def fctel-token-reading-path(reading) = reading[0];
    def fctel-token-reading-kind(reading) = reading[1];
    def fctel-token-reading-state(reading) = reading[2];
    def fctel-row() = file_size(fctel-observed-row-path()) <= 0 ? "unmeasured" : {
        let cached = fctel-trim-end(read_file(fctel-observed-row-path()));
        let evidence = fcte-parse(cached);
        (Comparable) fcte-valid?(evidence) == 1 && ((String) fcte-source(evidence) == fcte-source-kind() && (Comparable) fcte-provenance-shape?(evidence) == 1) ? {
            let path = fctel-bound-path();
            (String) path == "" ? "unmeasured" : (String) fcte-turn-id(evidence) == fctel-latest-complete-turn(path)[1] ? cached : "unmeasured";
        } : "unmeasured";
    };
    def fctel-evidence() = fcte-parse(fctel-row());
}
