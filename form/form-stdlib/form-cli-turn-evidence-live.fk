; form-cli-turn-evidence-live.fk — the host-carrier door for the most recent
; completed Codex turn in this workspace.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
;
; PROOF LEVEL: fkwu host carrier. The validation and apportionment behind this
; door are pure and four-way witnessable; only host-exec is lane-specific.

(defn fctel-command ()
    "python3 scripts/form_cli_turn_evidence.py --cwd . --format row")

(defn fctel-row () (host-exec (fctel-command) ""))
(defn fctel-evidence () (fcte-parse (fctel-row)))
