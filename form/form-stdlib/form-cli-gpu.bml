//////////////////////////////////////////////////////////////////////
//
// form-cli-gpu.bml
//
// The GPU lane as a BML class: named programs, not magic strings at
// the call site. Softmax is the token after matmul. Attention is
// those two composed. mlx_run is the one door. fkwu-uni.c is not
// grown.
//
// Proven by: form-stdlib/tests/form-cli-gpu-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormCliGpu<T> {
        field SoftmaxSum = "m1x3 1 2 3 softmax sum";
        field SoftmaxScale = "m1x3 1 2 3 softmax 1000 mul sum";
        field AttnSharp = "m1x2 40 0 m2x2 1 0 0 1 matmul softmax m2x1 100 0 matmul";
        field AttnUniform = "m1x2 0 0 m2x2 1 0 0 1 matmul softmax m2x1 10 30 matmul";
        field Add = "2 3 add";
        field JitArg = 2;
        field JitLit = 3;
        field JitRoot = 2;

        thought fcg-pattern = list("softmax", "matmul", "attention");

        def fcg-softmax-sum() = SoftmaxSum();
        def fcg-softmax-scale() = SoftmaxScale();
        def fcg-attn-sharp() = AttnSharp();
        def fcg-attn-uniform() = AttnUniform();
        def fcg-add() = Add();

        def fcg-check() {
            let b0 = if str_eq(fcg-softmax-sum(), "m1x3 1 2 3 softmax sum") then 1 else 0;
            let b1 = if str_eq(fcg-softmax-scale(), "m1x3 1 2 3 softmax 1000 mul sum") then 2 else 0;
            let b2 = if str_eq(fcg-attn-sharp(), "m1x2 40 0 m2x2 1 0 0 1 matmul softmax m2x1 100 0 matmul") then 4 else 0;
            let b3 = if str_eq(fcg-attn-uniform(), "m1x2 0 0 m2x2 1 0 0 1 matmul softmax m2x1 10 30 matmul") then 8 else 0;
            let b4 = if str_eq(fcg-add(), "2 3 add") then 16 else 0;
            let b5 = if eq(JitArg(), 2) then if eq(JitLit(), 3) then 32 else 0 else 0;
            add(b0, add(b1, add(b2, add(b3, add(b4, b5)))));
        }
    }
    0;
}
