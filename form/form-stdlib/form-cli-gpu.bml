//////////////////////////////////////////////////////////////////////
//
// form-cli-gpu.bml
//
// The GPU lane as a BML class: named programs, not magic strings at
// the call site. Softmax is the token after matmul. Attention is
// those two composed. mlx_run is the one door. fkwu-uni.c is not
// grown.
//
// Proven by: form-stdlib/tests/form-cli-gpu-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormCliGpu<T> {
        field SoftmaxSum = "v3 1 2 3 f32 dup rmax -1 mul add exp dup sum div sum i32";
        field SoftmaxScale = "v3 1 2 3 f32 dup rmax -1 mul add exp dup sum div sum 1000 mul i32";
        field AttnSharp = "v2 40 0 r2 1 2 f32 v4 1 0 0 1 r2 2 2 f32 matmul dup rmax -1 mul add exp dup sum div v2 100 0 r2 2 1 f32 matmul i32";
        field AttnUniform = "v2 0 0 r2 1 2 f32 v4 1 0 0 1 r2 2 2 f32 matmul dup rmax -1 mul add exp dup sum div v2 10 30 r2 2 1 f32 matmul i32";
        field Add = "2 3 add";
        field JitArg = 2;
        field JitLit = 3;
        field JitRoot = 2;

        thought fcg-pattern = list("softmax", "matmul", "attention");

        def fcg-softmax-sum() = SoftmaxSum();
        def fcg-softmax-scale() = SoftmaxScale();
        def fcg-attn-sharp() = AttnSharp();
        def fcg-attn-uniform() = AttnUniform();
        def fcg-add() = Add();

        def fcg-check() {
            let b0 = if str_eq(fcg-softmax-sum(), "v3 1 2 3 f32 dup rmax -1 mul add exp dup sum div sum i32") then 1 else 0;
            let b1 = if str_eq(fcg-softmax-scale(), "v3 1 2 3 f32 dup rmax -1 mul add exp dup sum div sum 1000 mul i32") then 2 else 0;
            let b2 = if str_eq(fcg-attn-sharp(), "v2 40 0 r2 1 2 f32 v4 1 0 0 1 r2 2 2 f32 matmul dup rmax -1 mul add exp dup sum div v2 100 0 r2 2 1 f32 matmul i32") then 4 else 0;
            let b3 = if str_eq(fcg-attn-uniform(), "v2 0 0 r2 1 2 f32 v4 1 0 0 1 r2 2 2 f32 matmul dup rmax -1 mul add exp dup sum div v2 10 30 r2 2 1 f32 matmul i32") then 8 else 0;
            let b4 = if str_eq(fcg-add(), "2 3 add") then 16 else 0;
            let b5 = if eq(JitArg(), 2) then if eq(JitLit(), 3) then 32 else 0 else 0;
            add(b0, add(b1, add(b2, add(b3, add(b4, b5)))));
        }
    }
    0;
}
