; dsv4-hook-recipe-control.fk — the first REAL recipe at the decode-hook door: the
; classifier earned leakage-free on 2026-08-18 (fresh_correct 65/150 vs the majority
; baseline 30, fresh_leakage 0) reads a DECLARED situation and offers its control
; verdict as the answer's first token, through the swap law, in-loop.
;
; This is the latch stone's intelligence moved from the adapter slot into the offer:
; there the trained values biased the exit head from a five-float file; here the same
; fit OFFERS token 128000+class and dtrs-select decides against the measured default.
;
; WHAT CROSSES AND WHAT DOES NOT, each with its ground:
;   - No situation declared -> nothing. The recipe never sniffs the prompt; declaring
;     a situation is the caller's sovereign act, the same consent shape as dce-emit.
;   - step > 0 -> nothing. The verdict speaks once at the head; the continuation is
;     the model's. A verdict repeated at every step is degeneracy, not emphasis.
;   - A leaked fit -> nothing, every class. Leakage is measured by the adapter's own
;     instrument at prepare; a fit that saw its evaluation cannot claim vitality.
;   - The offered vitality is the class's OWN held-out-fresh diagonal, as a percent
;     of its row — never the flattering aggregate, and every one of the six axes
;     carries that one measured number, so the min-floor cannot be gamed upward.
;   - A class measured at 0 -> nothing: no held-out evidence, no claim.
;   - bytes=0: this recipe moves no model weight bytes over the Metal bus; its cost
;     is the centroid dot on the host, and it is inside the measured wall clock the
;     door stamps on the candidate either way.
;
; preludes: form-stdlib/core.fk form-stdlib/dsv4-token-recipe-swap.fk form-stdlib/dsv4-control-adapter.fk
;
; Proven by: form-stdlib/tests/dsv4-decode-hook-door-band.fk

(do
    (defn dhrc-id () "dsv4-control-adapter-centroids")

    ; control token ids in dct-names order, held here so this recipe needs no
    ; GGUF-reading prelude: NIL CUT FAIL TIMEOUT CHOICE at 128000..128004, the
    ; same rows metal_dsv4_stack.sh's plumbing gate proved independently selectable.
    (defn dhrc-class-names () (list "NIL" "CUT" "FAIL" "TIMEOUT" "CHOICE"))
    (defn dhrc-class-id (idx) (add 128000 idx))

    ; state = (models matrix leak), fitted once at door spawn on train rows only,
    ; evaluated on the authored heldout-fresh rows by the adapter's own doors.
    (defn dhrc-prepare ()
        (do (let rows (dcc-corpus-with-fresh))
            (let names (dhrc-class-names))
            (let models (dca-fit rows names))
            (let matrix (dca-eval-on rows names models (dca-zero-n 25) "heldout-fresh"))
            (let leak (dca-leakage-on rows rows "heldout-fresh"))
            (list models matrix leak)))
    (defn dhrc-models (state) (nth state 0))
    (defn dhrc-matrix (state) (nth state 1))
    (defn dhrc-leak (state) (nth state 2))

    ; the class's own held-out row: diagonal count and row total
    (defn dhrc-row-total (matrix idx j acc)
        (if (eq j 5) acc
            (dhrc-row-total matrix idx (add j 1)
                (add acc (nth matrix (add (mul idx 5) j))))))
    (defn dhrc-diag (matrix idx) (nth matrix (add (mul idx 5) idx)))
    (defn dhrc-class-vitality (state idx)
        (do (let total (dhrc-row-total (dhrc-matrix state) idx 0 0))
            (if (gt (dhrc-leak state) 0) 0
                (if (le total 0) 0
                    (div (mul (dhrc-diag (dhrc-matrix state) idx) 100) total)))))

    (defn dhrc-nothing (why) (dtrs-offer "nothing" 0 0 0 why))
    (defn dhrc-witness (state idx)
        (str_concat "earned-verdict class="
        (str_concat (nth (dhrc-class-names) idx)
        (str_concat " heldout-fresh="
        (str_concat (int_to_str (dhrc-diag (dhrc-matrix state) idx))
        (str_concat "/"
        (str_concat (int_to_str (dhrc-row-total (dhrc-matrix state) idx 0 0))
                    " leakage=0 fit=dsv4-control-adapter train-rows-only")))))))

    (defn dhrc-offer (state situation context default-token step deadline)
        (if (eq (str_len situation) 0)
            (dhrc-nothing "no situation declared; the model's token stands")
        (if (gt step 0)
            (dhrc-nothing "verdict already spoken at the head; the continuation is the model's")
        (if (gt (dhrc-leak state) 0)
            (dhrc-nothing "fit leaked into its evaluation; no vitality claim crosses")
        (do (let idx (dca-predict-index (dhrc-models state) situation))
            (let pct (dhrc-class-vitality state idx))
            (if (le pct 0)
                (dhrc-nothing "held-out evidence 0 for this class; no claim crosses")
                (dtrs-offer "node" (dhrc-class-id idx) 0
                    (dtrs-vitality pct pct pct pct pct pct)
                    (dhrc-witness state idx))))))))
    0)
