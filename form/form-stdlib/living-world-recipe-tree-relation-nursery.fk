; living-world-recipe-tree-relation-nursery.fk -- contradictions may expose a
; recurrent binding relation and an already-consented operator that transfers.
;
; No role name, binding value, arithmetic token, expected answer, or ranking is
; built into this nursery.  It intersects exact binding name/value recurrence
; across distinct contradiction cases, rejects a full-coordinate intersection
; as memorization, and evaluates every operator already retained by the target's
; original consented hypothesis field.  Zero, one, or many relations remain.
; A ready field is diagnostic only: it activates no Recipe and grants no voice,
; decision, or promotion authority.
;
; The present binary Recipe codec is an explicit interface limit.  Cases with
; other arity stay open rather than being coerced into this nursery.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk

(let LWRRN-INVARIANT  (bp "LWRRN-INVARIANT"))
(let LWRRN-DERIVATION (bp "LWRRN-DERIVATION"))
(let LWRRN-TRIAL      (bp "LWRRN-TRIAL"))
(let LWRRN-FIELD      (bp "LWRRN-FIELD"))

(defn lwrrn-prior-suite (candidate)
    (do
        (let field (lwo-emergent-shape candidate))
        (let composition-candidate
            (lwrtrh-field-composition-candidate field))
        (lwrtr-field-suite (lwo-emergent-shape composition-candidate))))

(defn lwrrn-earlier-contradictions (candidate)
    (lwrtr-successor-contradicted-cases
        (lwrtrp-parent-successor candidate)
        (lwrrn-prior-suite candidate)))
(defn lwrrn-current-contradictions (candidate suite)
    (lwrtr-successor-contradicted-case-items
        (lwo-field-items
            (lwps-evaluation-placements
                (lwrtrp-evaluate-new-ready candidate suite)))
        (lwo-empty-field)))
(defn lwrrn-contradictions (candidate suite)
    (lwrtr-union-items
        (lwo-field-items (lwrrn-current-contradictions candidate suite))
        (lwrrn-earlier-contradictions candidate)))

(defn lwrrn-binding-by-name (items name)
    (if (eq (len items) 0) (lwo-none)
        (if (str_eq (lwre-binding-name (head items)) name) (head items)
            (lwrrn-binding-by-name (tail items) name))))
(defn lwrrn-binding-repeats-items? (case-items name value)
    (if (eq (len case-items) 0) 1
        (do
            (let binding
                (lwrrn-binding-by-name
                    (lwre-binding-items
                        (lwps-case-bindings (head case-items))) name))
            (if (and (not (node_eq binding (lwo-none)))
                     (node_eq (lwre-binding-value binding) value))
                (lwrrn-binding-repeats-items?
                    (tail case-items) name value) 0))))

; children: exact role-name cell, exact recurrent value, all supporting
; contradiction cases, local path.
(defn lwrrn-invariant (name value contradictions)
    (intern_node LWRRN-INVARIANT
        (list (intern_trivial_string name) value contradictions
              (lwo-local-path))))
(defn lwrrn-invariant? (cell) (lwo-category? cell LWRRN-INVARIANT))
(defn lwrrn-invariant-name (invariant)
    (node_value (nth (node_children invariant) 0)))
(defn lwrrn-invariant-value (invariant)
    (nth (node_children invariant) 1))
(defn lwrrn-invariant-support (invariant)
    (nth (node_children invariant) 2))

(defn lwrrn-invariants-from-bindings
    (binding-items case-items contradictions field)
    (if (eq (len binding-items) 0) field
        (do
            (let binding (head binding-items))
            (let name (lwre-binding-name binding))
            (let value (lwre-binding-value binding))
            (lwrrn-invariants-from-bindings (tail binding-items) case-items
                contradictions
                (if (eq (lwrrn-binding-repeats-items?
                            case-items name value) 1)
                    (lwo-field-add field
                        (lwrrn-invariant name value contradictions)) field)))))
(defn lwrrn-invariants (contradictions)
    (if (lt (lwo-field-size contradictions) 2) (lwo-empty-field)
        (do
            (let cases (lwo-field-items contradictions))
            (let first-case (head cases))
            (let binding-items
                (lwre-binding-items (lwps-case-bindings first-case)))
            (let found
                (lwrrn-invariants-from-bindings binding-items cases
                    contradictions (lwo-empty-field)))
            ; Equal cardinality is the old exact-coordinate wrapper in disguise.
            (if (ge (lwo-field-size found) (len binding-items))
                (lwo-empty-field) found))))

(defn lwrrn-original-operator-field (candidate)
    (do
        (let target (lwrtrp-target-for candidate))
        (let tissue (lwo-emergent-shape target))
        (let original-field-candidate (lwht-tissue-field tissue))
        (lwph-field-operators
            (lwo-emergent-shape original-field-candidate))))

; children: case, exact operator and Recipe, bindings, output, exact bit, path.
(defn lwrrn-derivation (case operator recipe output exact)
    (intern_node LWRRN-DERIVATION
        (list case operator recipe (lwps-case-bindings case) output
              (intern_trivial_int exact) (lwo-local-path))))
(defn lwrrn-derive-items (items operator recipe derivations exact total)
    (if (eq (len items) 0) (list derivations exact total)
        (do
            (let case (head items))
            (let output
                (intern_trivial_int
                    (lwre-evaluate-bound recipe (lwps-case-bindings case))))
            (let match
                (if (node_eq output
                        (oac-payload (lwps-case-immediate case))) 1 0))
            (lwrrn-derive-items (tail items) operator recipe
                (lwo-field-add derivations
                    (lwrrn-derivation case operator recipe output match))
                (add exact match) (add total 1)))))

; children: operator, generated Recipe, every derivation, exact/total counts,
; state, local path.
(defn lwrrn-trial (operator recipe derivations exact total state)
    (intern_node LWRRN-TRIAL
        (list operator recipe derivations (intern_trivial_int exact)
              (intern_trivial_int total) state (lwo-local-path))))
(defn lwrrn-trial? (cell) (lwo-category? cell LWRRN-TRIAL))
(defn lwrrn-trial-operator (trial) (nth (node_children trial) 0))
(defn lwrrn-trial-recipe (trial) (nth (node_children trial) 1))
(defn lwrrn-trial-derivations (trial) (nth (node_children trial) 2))
(defn lwrrn-trial-exact (trial)
    (node_value (nth (node_children trial) 3)))
(defn lwrrn-trial-total (trial)
    (node_value (nth (node_children trial) 4)))
(defn lwrrn-trial-state (trial) (nth (node_children trial) 5))

(defn lwrrn-trial-for (operator contradictions)
    (do
        (let first-case (head (lwo-field-items contradictions)))
        (let binding-items
            (lwre-binding-items (lwps-case-bindings first-case)))
        (if (not (eq (len binding-items) 2)) (lwo-none)
            (do
                (let left-name (lwre-binding-name (nth binding-items 0)))
                (let right-name (lwre-binding-name (nth binding-items 1)))
                (let recipe
                    (lwph-recipe-for operator left-name right-name))
                (let derived
                    (lwrrn-derive-items
                        (lwo-field-items contradictions) operator recipe
                        (lwo-empty-field) 0 0))
                (let exact (nth derived 1))
                (let total (nth derived 2))
                (lwrrn-trial operator recipe (nth derived 0) exact total
                    (if (and (ge total 2) (eq exact total))
                        (lwph-consistent) (lwph-divergent)))))))
(defn lwrrn-trials-items (items contradictions trials viable)
    (if (eq (len items) 0) (list trials viable)
        (do
            (let trial (lwrrn-trial-for (head items) contradictions))
            (if (node_eq trial (lwo-none))
                (lwrrn-trials-items (tail items) contradictions trials viable)
                (lwrrn-trials-items (tail items) contradictions
                    (lwo-field-add trials trial)
                    (if (eq (lwph-consistent?
                                (lwrrn-trial-state trial)) 1)
                        (lwo-field-add viable trial) viable))))))

; children: successor candidate, current suite, contradictions, recurrent
; invariants, all operator trials, viable trials, OPEN/READY/PLURAL,
; alternatives, unknowns, local path.
(defn lwrrn-field
    (candidate suite contradictions invariants trials viable status
     alternatives unknowns)
    (intern_node LWRRN-FIELD
        (list candidate suite contradictions invariants trials viable status
              alternatives unknowns (lwo-local-path))))
(defn lwrrn-field? (cell) (lwo-category? cell LWRRN-FIELD))
(defn lwrrn-field-candidate (field) (nth (node_children field) 0))
(defn lwrrn-field-suite (field) (nth (node_children field) 1))
(defn lwrrn-field-contradictions (field) (nth (node_children field) 2))
(defn lwrrn-field-invariants (field) (nth (node_children field) 3))
(defn lwrrn-field-trials (field) (nth (node_children field) 4))
(defn lwrrn-field-viable (field) (nth (node_children field) 5))
(defn lwrrn-field-status (field) (nth (node_children field) 6))
(defn lwrrn-field-alternatives (field) (nth (node_children field) 7))
(defn lwrrn-field-unknowns (field) (nth (node_children field) 8))

(defn lwrrn-field-for-ready (candidate suite)
    (do
        (let contradictions (lwrrn-contradictions candidate suite))
        (let invariants (lwrrn-invariants contradictions))
        (let grouped
            (if (lt (lwo-field-size contradictions) 2)
                (list (lwo-empty-field) (lwo-empty-field))
                (lwrrn-trials-items
                    (lwo-field-items (lwrrn-original-operator-field candidate))
                    contradictions (lwo-empty-field) (lwo-empty-field))))
        (let trials (nth grouped 0))
        (let viable (nth grouped 1))
        (let combinations
            (mul (lwo-field-size invariants) (lwo-field-size viable)))
        (let status
            (if (eq combinations 1) (lwhrn-ready)
                (if (gt combinations 1) (lwhrn-plural) (lwhrn-open))))
        (lwrrn-field candidate suite contradictions invariants trials viable
            status trials (lwo-field (list (lwlc-unknown trials))))))
(defn lwrrn-field-for (world candidate suite threshold)
    (if (eq (lwrtrp-ready? world candidate suite threshold) 0) (lwo-none)
        (lwrrn-field-for-ready candidate suite)))

(defn lwrrn-progress-target (field)
    (if (node_eq field (lwo-none)) "relation-field:nothing"
        (lcfb-cat (list
            "contradictions:"
            (int_to_str
                (lwo-field-size (lwrrn-field-contradictions field)))
            ":invariants:"
            (int_to_str (lwo-field-size (lwrrn-field-invariants field)))
            ":trials:"
            (int_to_str (lwo-field-size (lwrrn-field-trials field)))
            ":viable:"
            (int_to_str (lwo-field-size (lwrrn-field-viable field)))
            ":ready:"
            (int_to_str (lwhrn-ready? (lwrrn-field-status field)))
            ":plural:"
            (int_to_str (lwhrn-plural? (lwrrn-field-status field)))))))

; witnessed: 2026-08-09 -> recurrent relation field observed on fkwu
