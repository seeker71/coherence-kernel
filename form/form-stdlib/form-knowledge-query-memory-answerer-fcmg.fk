; form-knowledge-query-memory-answerer-fcmg.fk — the PRIMARY answerer: the
; body's own resident generator, plugged into the neutral crossing.
;
; This is the whole adapter, and it is small on purpose. fcmg-generate-resident
; already answers (list text residence), which is exactly the shape
; fqmn-cross expects back from an answerer, so nothing is wrapped, reshaped or
; re-implemented here. The adapter exists only to carry the model path and the
; step budget alongside the residence, because fqmn-cross passes one opaque
; context and fcmg needs three things.
;
; NO ADDRESS ANYWHERE IN THIS PATH. fcmg takes a MODEL PATH — a file the body
; already holds — and speaks to it through the resident Form-native lane. There
; is no machine to be listening, nothing to be up, and no number to configure.
; That is the point of making this the primary rather than a comparator.
;
; THE RESIDENCE IS THREADED, NOT HELD. What fcmg hands back is put straight
; into the returned context, so a caller that keeps what it is given keeps the
; residence, and one that drops it drops only its own warm state.
;
; THIS CELL ENTERS THE MODEL CHAIN BY CONSTRUCTION. form-cli-model-generate.fk
; preludes native/metal/qwen35-dense-token-handle.fk, so preluding this file
; compiles the Metal lane. That is the adapter's job — to be the ONE file where
; that happens — and it is why this cell is not preflighted in the same
; movement as the neutral cell and the band, which stay free of it.
;
; preludes: form-stdlib/form-cli-model-generate.fk
; preludes: form-stdlib/form-knowledge-query-memory-neutral.fk

(do
    ; ctx = (mark model-path steps residence)
    (defn fqmaf-mark () "fqma-fcmg1")
    (defn fqmaf-ctx (model-path steps residence)
        (list (fqmaf-mark) model-path steps residence))
    (defn fqmaf-ctx? (c)
        (if (eq (len c) 4) (if (str_eq (nth c 0) (fqmaf-mark)) 1 0) 0))
    (defn fqmaf-path (c)      (nth c 1))
    (defn fqmaf-steps (c)     (nth c 2))
    (defn fqmaf-residence (c) (nth c 3))
    (defn fqmaf-none () (fqmaf-ctx "" 0 (fcmr-none)))

    ; A context this adapter does not recognise is declined, not guessed at:
    ; nothing back, and the caller's own context returned untouched.
    (defn fqmaf-answerer (ctx prompt)
        (if (eq (fqmaf-ctx? ctx) 0) (list (nothing) ctx)
            (do
                (let out (fcmg-generate-resident
                            (fqmaf-residence ctx) (fqmaf-path ctx) prompt
                            (fqmaf-steps ctx)))
                (list (nth out 0)
                      (fqmaf-ctx (fqmaf-path ctx) (fqmaf-steps ctx)
                                 (nth out 1))))))

    (defn fqmaf-release-ok? (ctx)
        (if (eq (fqmaf-ctx? ctx) 0) 0 (fcmr-release-ok? (fqmaf-residence ctx))))

    0)
