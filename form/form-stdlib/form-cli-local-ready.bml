//////////////////////////////////////////////////////////////////////
//
// form-cli-local-ready.bml
//
// Executable BML. High-grammar authority:
//   form-stdlib/bml/form-cli-local-ready.bml
//
// Generic class FormLocalReady<T> — FileIO door. Named diagnostic
// marks map to teach-layer controls. A known Form repair is
// local-ready; an unknown miss stays remote. Prompt text is never
// stored.
//
// Proven by: form-stdlib/tests/form-cli-local-ready-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template MissCell<TMark> {
        member mark: TMark;
        member control: String;
        member ready: int;
    }

    class FormLocalReadyAuthority {
        field Path = "form/form-stdlib/bml/form-cli-local-ready.bml";
        field Kind = "high-bml-class-template-field";
    }

    class FormLocalReady<T> {
        field UnbalancedMark = "unbalanced-source";
        field UnresolvedMark = "unresolved-call";
        field CachedMark = "cached image was compiled with errors";
        field UnusableMark = "unusable .fkb";
        field StaleMark = "stale .fkb";
        field TimeoutMark = "timeout";
        field HostLs = "ls";
        field HostRg = "rg";
        field CtrlUndo = "undo";
        field CtrlCut = "cut";
        field CtrlStop = "stop";
        field CtrlTimeout = "timeout";
        field CtrlNothing = "nothing";
        field Quiet = "";
        field HeldoutUnbalanced = "kernel closed unbalanced-source before a verdict";
        field HeldoutUnresolved = "unresolved-call is one red line with two repairs";
        field TrainUnbalanced = "unbalanced-source at the closer";
        field TrainUnresolved = "unresolved-call matched no op";

        ref flr-authority = FormLocalReadyAuthority;
        thought flr-pattern = list("shape", "control", "ready", "walk");

        def flr-has(s, mark) = if ge(str_find(s, mark, 0), 0) then 1 else 0;

        def flr-shape-of(s) = if eq(flr-has(s, UnbalancedMark()), 1) then UnbalancedMark() else if eq(flr-has(s, UnresolvedMark()), 1) then UnresolvedMark() else if eq(flr-has(s, CachedMark()), 1) then CachedMark() else if eq(flr-has(s, UnusableMark()), 1) then UnusableMark() else if eq(flr-has(s, StaleMark()), 1) then StaleMark() else if eq(flr-has(s, TimeoutMark()), 1) then TimeoutMark() else Quiet();

        def flr-control(shape) = if str_eq(shape, UnbalancedMark()) then CtrlUndo() else if str_eq(shape, UnresolvedMark()) then CtrlCut() else if str_eq(shape, CachedMark()) then CtrlUndo() else if str_eq(shape, UnusableMark()) then CtrlStop() else if str_eq(shape, StaleMark()) then CtrlStop() else if str_eq(shape, TimeoutMark()) then CtrlTimeout() else CtrlNothing();

        def flr-host-ready(kind) = if str_eq(kind, HostLs()) then 1 else if str_eq(kind, HostRg()) then 1 else 0;

        def flr-ready(shape) = if str_eq(flr-control(shape), CtrlNothing()) then 0 else 1;

        def flr-walk(native-hit, shape) = fcr-walk(native-hit, flr-ready(shape));

        def flr-kind-walk(native-hit, kind) = fcr-walk(native-hit, flr-host-ready(kind));

        def flr-bit(ok, bit) = if ok then bit else 0;

        def flr-check() {
            let s0 = flr-shape-of(TrainUnbalanced());
            let s1 = flr-shape-of(TrainUnresolved());
            let s2 = flr-shape-of(HeldoutUnbalanced());
            let s3 = flr-shape-of(HeldoutUnresolved());
            let s4 = flr-shape-of("quiet water, no diagnostic");
            let c0 = flr-bit(and(str_eq(UnbalancedMark(), "unbalanced-source"), str_eq(UnresolvedMark(), "unresolved-call")), 1);
            let c1 = flr-bit(and(str_eq(flr-control(s1), CtrlCut()), eq(flr-ready(s1), 1)), 2);
            let c2 = flr-bit(and(str_eq(flr-control(s0), CtrlUndo()), eq(flr-walk(0, s0), 1)), 4);
            let c3 = flr-bit(and(str_eq(flr-control(CachedMark()), CtrlUndo()), str_eq(flr-control(StaleMark()), CtrlStop())), 8);
            let c4 = flr-bit(and(eq(flr-walk(0, TimeoutMark()), 1), str_eq(flr-control(TimeoutMark()), CtrlTimeout())), 16);
            let c5 = flr-bit(and(str_eq(flr-control(s4), CtrlNothing()), eq(flr-walk(0, s4), 2)), 32);
            let c6 = flr-bit(and(eq(fcr-walk(1, 1), 0), and(eq(fcr-walk(0, 1), 1), eq(fcr-walk(0, 0), 2))), 64);
            let c7 = flr-bit(and(str_eq(flr-control(s2), CtrlUndo()), str_eq(flr-control(s3), CtrlCut())), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
