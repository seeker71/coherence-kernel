//////////////////////////////////////////////////////////////////////
//
// form-cli-local-ready.bml
//
// Executable BML. High-grammar authority:
//   form-stdlib/bml/form-cli-local-ready.bml
//
// Generic class FormLocalReady<T> — FileIO door. Named diagnostic
// marks map to teach-layer controls. A known Form repair is
// local-ready; an unknown miss stays remote. Prompt text is never
// stored.
//
// Proven by: form-stdlib/tests/form-cli-local-ready-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template MissCell<TMark> {
        member mark: TMark;
        member control: String;
        member ready: int;
    }

    class FormLocalReadyAuthority {
        field Path = "form/form-stdlib/bml/form-cli-local-ready.bml";
        field Kind = "high-bml-class-template-field";
    }

    class FormLocalReady<T> {
        field UnbalancedMark = "unbalanced-source";
        field UnresolvedMark = "unresolved-call";
        field CachedMark = "cached image was compiled with errors";
        field UnusableMark = "unusable .fkb";
        field StaleMark = "stale .fkb";
        field TimeoutMark = "timeout";
        field HostLs = "ls";
        field HostRg = "rg";
        field CtrlUndo = "undo";
        field CtrlCut = "cut";
        field CtrlStop = "stop";
        field CtrlTimeout = "timeout";
        field CtrlNothing = "nothing";
        field Quiet = "";
        field HeldoutUnbalanced = "kernel closed unbalanced-source before a verdict";
        field HeldoutUnresolved = "unresolved-call is one red line with two repairs";
        field TrainUnbalanced = "unbalanced-source at the closer";
        field TrainUnresolved = "unresolved-call matched no op";

        ref flr-authority = FormLocalReadyAuthority;
        thought flr-pattern = list("shape", "control", "ready", "walk");

        def flr-has(s, mark) = if (str_find(s, mark, 0) >= 0) then 1 else 0;

        def flr-shape-of(s) = if ((Comparable) flr-has(s, UnbalancedMark()) == 1) then UnbalancedMark() else if ((Comparable) flr-has(s, UnresolvedMark()) == 1) then UnresolvedMark() else if ((Comparable) flr-has(s, CachedMark()) == 1) then CachedMark() else if ((Comparable) flr-has(s, UnusableMark()) == 1) then UnusableMark() else if ((Comparable) flr-has(s, StaleMark()) == 1) then StaleMark() else if ((Comparable) flr-has(s, TimeoutMark()) == 1) then TimeoutMark() else Quiet();

        def flr-control(shape) = if ((String) shape == UnbalancedMark()) then CtrlUndo() else if ((String) shape == UnresolvedMark()) then CtrlCut() else if ((String) shape == CachedMark()) then CtrlUndo() else if ((String) shape == UnusableMark()) then CtrlStop() else if ((String) shape == StaleMark()) then CtrlStop() else if ((String) shape == TimeoutMark()) then CtrlTimeout() else CtrlNothing();

        def flr-host-ready(kind) = if ((String) kind == HostLs()) then 1 else if ((String) kind == HostRg()) then 1 else 0;

        def flr-ready(shape) = if ((String) flr-control(shape) == CtrlNothing()) then 0 else 1;

        def flr-walk(native-hit, shape) = fcr-walk(native-hit, flr-ready(shape));

        def flr-kind-walk(native-hit, kind) = fcr-walk(native-hit, flr-host-ready(kind));

        def flr-bit(ok, bit) = if ok then bit else 0;

        def flr-check() {
            let s0 = flr-shape-of(TrainUnbalanced());
            let s1 = flr-shape-of(TrainUnresolved());
            let s2 = flr-shape-of(HeldoutUnbalanced());
            let s3 = flr-shape-of(HeldoutUnresolved());
            let s4 = flr-shape-of("quiet water, no diagnostic");
            let c0 = flr-bit((((String) UnbalancedMark() == "unbalanced-source") && ((String) UnresolvedMark() == "unresolved-call")), 1);
            let c1 = flr-bit((((String) flr-control(s1) == CtrlCut()) && ((Comparable) flr-ready(s1) == 1)), 2);
            let c2 = flr-bit((((String) flr-control(s0) == CtrlUndo()) && ((Comparable) flr-walk(0, s0) == 1)), 4);
            let c3 = flr-bit((((String) flr-control(CachedMark()) == CtrlUndo()) && ((String) flr-control(StaleMark()) == CtrlStop())), 8);
            let c4 = flr-bit((((Comparable) flr-walk(0, TimeoutMark()) == 1) && ((String) flr-control(TimeoutMark()) == CtrlTimeout())), 16);
            let c5 = flr-bit((((String) flr-control(s4) == CtrlNothing()) && ((Comparable) flr-walk(0, s4) == 2)), 32);
            let c6 = flr-bit((((Comparable) fcr-walk(1, 1) == 0) && (((Comparable) fcr-walk(0, 1) == 1) && ((Comparable) fcr-walk(0, 0) == 2))), 64);
            let c7 = flr-bit((((String) flr-control(s2) == CtrlUndo()) && ((String) flr-control(s3) == CtrlCut())), 128);
            (c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + c7)))))));
        }
    }
    0;
}
