// In-process care: providers own resources; the asking organ owns re-observation.
// Callbacks and context are supplied by the running organ, never by event text.
// preludes: form-stdlib/organ-health.bml
section [form.bml] {
 class OrganCare {
  def oc-provider(name,resources,action,supply) = list(name,resources,action,supply);
  def oc-find(providers,reading,need) = nil?(providers) ? list() : oh-has(head(providers)[1],oh-str(need,"resource")) && oh-has(oh-values(json-array-elements(oh-get(reading,"offers"))),head(providers)[2]) ? head(providers) : oc-find(tail(providers),reading,need);
  def oc-call(callback,context,reading,need) = callback(context,reading,need);
  def oc-emit(callback,context,stage,row) = callback(context,stage,row);
  def oc-observe(callback,context,reading,delivery) = callback(context,reading,delivery);
  // the need a reading names first, and the answer of care that reached no provider
  def oc-first-need(reading) = head(json-array-elements(oh-get(reading,"needs")));
  def oc-answer(reading,state) = json-node-object(list(oh-s("aspect",oh-str(reading,"aspect")),oh-s("state",state)));
  // the numbers a caller names on one line, as chosen care takes them: words split on spaces. A word names a
  // number only when it is a positive one written as the kernel writes it back (int_to_str of its value is the
  // word), so an overflowing, signed, padded or broken word names none; a line that was never read names none
  def oc-number-word?(w) = (Comparable) str_len(w) == 0 ? 0 : oc-number-back?(w,str_to_int(w));
  def oc-number-back?(w,n) = n <= 0 ? 0 : (String) int_to_str(n) == w ? 1 : 0;
  def oc-chosen-words(words) = nil?(words) ? list() : (Comparable) oc-number-word?(head(words)) == 1 ? cons(str_to_int(head(words)),oc-chosen-words(tail(words))) : oc-chosen-words(tail(words));
  def oc-chosen(line) = nothing?(line) ? list() : oc-chosen-words(split-on(line," "));
  // every reading, each answered by the asking organ's own care
  def oc-care-each(context,rows,care) = nil?(rows) ? list() : cons(care(context,head(rows)),oc-care-each(context,tail(rows),care));
  // Unease is declared content. An applied action cannot hide a still-open
  // need before the asking organ supplies its next observation.
  def oc-unease(reading) = oh-unease(reading);
  def oc-needs-valid(needs) = nil?(needs) ? 1 : (oh-text(head(needs),"resource") && (json-object-has?(head(needs),"detail") && oc-needs-valid(tail(needs))));
  def oc-need-declared(needs,need) = nil?(needs) ? 0 : (node_eq(head(needs),need) || oc-need-declared(tail(needs),need));
  def oc-need-resource(needs,need) = nil?(needs) ? 0 : (((String) oh-str(head(needs),"resource") == oh-str(need,"resource")) || oc-need-resource(tail(needs),need));
  def oc-observation-state(reading,settled) = oh-pain(reading) ? "need-open" : node_eq(oh-get(reading,"health"),json-node-null()) ? "unmeasured" : !nil?(json-array-elements(oh-get(reading,"needs"))) ? "need-open" : node_eq(oh-get(reading,"surprise"),json-node-int(1)) ? "unresolved" : settled;
  def oc-attention(reading,need,provider,state) = oh-set(reading,"attention",json-node-object(list(oh-s("state",state),json-node-pair("need",need),json-node-pair("provider",nil?(provider) ? json-node-null() : json-node-string(head(provider))))));
  // The asking organ has already emitted this observation. Attention adds a
  // routing annotation to it; it is not a new measurement or an implicit offer.
  def oc-hear(context,reading,providers,emit,observe) {
   !(oh-valid(reading) && ((String) oh-str(reading,"stage") == "observe")) ? form_error("care hears an original organ observation") : {
    let needs = json-array-elements(oh-get(reading,"needs"));
    !oc-needs-valid(needs) ? form_error("care needs a declared resource and detail")
    : nil?(needs) ? oc-hear-empty(context,reading,emit)
    : oc-hear-needs(context,reading,reading,needs,providers,emit,observe,list());
   };
  }
  def oc-hear-empty(context,reading,emit) {
   let state = oh-pain(reading) ? "need-open" : node_eq(oh-get(reading,"health"),json-node-null()) ? "unmeasured" : oc-unease(reading) ? "unresolved" : "observed";
   oc-unease(reading) ? oc-emit(emit,context,"organ-attention",oc-attention(reading,json-node-null(),list(),state)) : 1;
   json-node-object(list(oh-s("state",state),json-node-pair("observation",reading),json-node-pair("outcomes",json-node-array(list()))));
  }
  def oc-hear-needs(context,origin,reading,needs,providers,emit,observe,held) {
   let need = head(needs); let current = json-array-elements(oh-get(reading,"needs"));
   let result = oc-need-declared(current,need) ? oc-hear-declared(context,reading,need,providers,emit,observe) : oc-hear-settled(context,reading,need,current,emit);
   let outcome = oh-set(oh-set(result,"need",need),"requested_by",oh-get(origin,"id"));
   let outcomes = cons(outcome,held);
   nil?(tail(needs)) ? oc-hear-finish(result,reverse(outcomes))
   : oc-hear-needs(context,origin,oh-get(result,"observation"),tail(needs),providers,emit,observe,outcomes);
  }
  def oc-hear-declared(context,reading,need,providers,emit,observe) {
   let provider = oc-find(providers,reading,need);
   oc-emit(emit,context,"organ-attention",oc-attention(reading,need,provider,nil?(provider) ? "unclaimed" : "offered"));
   oc-care(context,reading,need,providers,emit,observe);
  }
  // A previous delivery may settle or change another original need. The
  // latest observation is authoritative; stale need details cannot actuate.
  def oc-hear-settled(context,reading,need,current,emit) {
   let state = oc-need-resource(current,need) ? "superseded-by-observation" : "settled-by-observation";
   oc-emit(emit,context,"organ-attention",oc-attention(reading,need,list(),state));
   json-node-object(list(oh-s("state",state),json-node-pair("observation",reading)));
  }
  def oc-any-delivery(outcomes) = nil?(outcomes) ? 0 : (json-object-has?(head(outcomes),"delivery") || oc-any-delivery(tail(outcomes)));
  def oc-all-state(outcomes,state) = nil?(outcomes) ? 1 : (((String) oh-str(head(outcomes),"state") == state) && oc-all-state(tail(outcomes),state));
  def oc-hear-finish(result,outcomes) {
   let state = (Comparable) len(outcomes) == 1 ? oh-str(result,"state") : oc-all-state(outcomes,"unclaimed") ? "unclaimed" : oc-observation-state(oh-get(result,"observation"),oc-any-delivery(outcomes) ? "resource-observed" : "observed");
   oh-set(oh-set(result,"state",json-node-string(state)),"outcomes",json-node-array(outcomes));
  }
  def oc-care(context,reading,need,providers,emit,observe) {
   !oh-valid(reading) ? form_error("care needs a valid organ observation") : {
    let provider = oc-find(providers,reading,need);
    nil?(provider) ? json-node-object(list(oh-s("state","unclaimed"),json-node-pair("observation",reading))) : oc-owned(context,reading,need,provider,emit,observe);
   };
  }
  def oc-owned(context,reading,need,provider,emit,observe) {
   let response = oc-control(oh-response(reading,provider[2]),reading,need,provider);
   let selected = oh-select(reading,response,"");
   (String) selected == "" ? form_error("care response does not match the asking organ") : oc-supply(context,reading,need,provider,emit,observe,response);
  }
  def oc-control(row,reading,need,provider) {
   let clean = json-node-object(oh-without(json-object-pairs(row),"care_delivery"));
   let current = (String) oh-str(row,"stage") == "response" ? json-node-object(oh-without(json-object-pairs(clean),"result")) : clean;
   oh-set(oh-set(oh-set(current,"responder",json-node-string(head(provider))),"care_need",need),"care_of",oh-get(reading,"id"));
  }
  def oc-supply(context,reading,need,provider,emit,observe,response) {
   let claimed = oc-emit(emit,context,"organ-response",response);
   let started = host_monotonic_ms();
   let supplied = oc-call(provider[3],context,reading,need);
   let delivery = oh-set(supplied,"supply_elapsed_ms",json-node-int(host_monotonic_ms() - started));
   let applied = oc-emit(emit,context,"organ-action-observed",oc-control(oh-applied(reading,oh-str(response,"selected"),delivery),reading,need,provider));
   let fresh = oc-observe(observe,context,reading,delivery);
   let bound = oh-valid(fresh) && (oc-needs-valid(json-array-elements(oh-get(fresh,"needs"))) && ((!((String) oh-str(fresh,"id") == oh-str(reading,"id"))) && (((String) oh-key(fresh) == oh-key(reading)) && (((String) oh-str(fresh,"stage") == "observe") && ((String) oh-str(fresh,"care_of") == oh-str(reading,"id"))))));
   !bound ? form_error("care needs a fresh observation from the asking organ") : oc-finish(context,emit,need,provider,delivery,fresh);
  }
  def oc-finish(context,emit,need,provider,delivery,fresh) {
   let measured = json-node-object(oh-without(oh-without(json-object-pairs(fresh),"attention"),"attentions"));
   let current = oh-set(oh-set(oh-set(measured,"responder",json-node-string(head(provider))),"care_delivery",delivery),"care_need",need);
   let observed = oc-emit(emit,context,"organ-health",current);
   json-node-object(list(oh-s("state",oc-observation-state(fresh,"resource-observed")),oh-s("responder",head(provider)),json-node-pair("delivery",delivery),json-node-pair("observation",current)));
  }
 }
 0;
}
