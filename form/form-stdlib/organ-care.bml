// In-process care: providers own resources; the asking organ owns re-observation.
// Callbacks and context are supplied by the running organ, never by event text.
import form-stdlib/organ-health.bml;
section [form.bml] {
 class OrganCare {
  def oc-provider(name,resources,action,supply) = [name,resources,action,supply];
  def oc-find(providers,reading,need) = if nil?(providers) then [] else if (oh-has(providers[0][1],oh-str(need,"resource")) && oh-has(oh-values(json-array-elements(oh-get(reading,"offers"))),providers[0][2])) then providers[0] else oc-find(providers[1:],reading,need);
  def oc-call(callback,context,reading,need) = callback(context,reading,need);
  def oc-emit(callback,context,stage,row) = callback(context,stage,row);
  def oc-observe(callback,context,reading,delivery) = callback(context,reading,delivery);
  // the need a reading names first, and the answer of care that reached no provider
  def oc-first-need(reading) = json-array-elements(oh-get(reading,"needs"))[0];
  def oc-answer(reading,state) = json-node-object([oh-s("aspect",oh-str(reading,"aspect")),oh-s("state",state)]);
  // the numbers a caller names on one line, as chosen care takes them: words split on spaces. A word names a
  // number only when it is a positive one written as the kernel writes it back (int_to_str of its value is the
  // word), so an overflowing, signed, padded or broken word names none; a line that was never read names none
  def oc-number-word?(w) = if ((Comparable) len(w) == 0) then 0 else oc-number-back?(w,str_to_int(w));
  def oc-number-back?(w,n) = if (n <= 0) then 0 else if ((String) n.str() == w) then 1 else 0;
  def oc-chosen-words(words) = if nil?(words) then [] else if ((Comparable) oc-number-word?(words[0]) == 1) then cons(str_to_int(words[0]),oc-chosen-words(words[1:])) else oc-chosen-words(words[1:]);
  def oc-chosen(line) = if nothing?(line) then [] else oc-chosen-words(split-on(line," "));
  // every reading, each answered by the asking organ's own care
  def oc-care-each(context,rows,care) = if nil?(rows) then [] else cons(care(context,rows[0]),oc-care-each(context,rows[1:],care));
  // Unease is declared content. An applied action cannot hide a still-open
  // need before the asking organ supplies its next observation.
  def oc-unease(reading) = oh-unease(reading);
  def oc-needs-valid(needs) = if nil?(needs) then 1 else (oh-text(needs[0],"resource") && (json-object-has?(needs[0],"detail") && oc-needs-valid(needs[1:])));
  def oc-need-declared(needs,need) = if nil?(needs) then 0 else (node_eq(needs[0],need) || oc-need-declared(needs[1:],need));
  def oc-need-resource(needs,need) = if nil?(needs) then 0 else (((String) oh-str(needs[0],"resource") == oh-str(need,"resource")) || oc-need-resource(needs[1:],need));
  def oc-observation-state(reading,settled) = if oh-pain(reading) then "need-open" else if node_eq(oh-get(reading,"health"),json-node-null()) then "unmeasured" else if (!nil?(json-array-elements(oh-get(reading,"needs")))) then "need-open" else if node_eq(oh-get(reading,"surprise"),json-node-int(1)) then "unresolved" else settled;
  def oc-attention(reading,need,provider,state) = oh-set(reading,"attention",json-node-object([oh-s("state",state),json-node-pair("need",need),json-node-pair("provider",if nil?(provider) then json-node-null() else json-node-string(provider[0]))]));
  // The asking organ has already emitted this observation. Attention adds a
  // routing annotation to it; it is not a new measurement or an implicit offer.
  def oc-hear(context,reading,providers,emit,observe) {
   if (!(oh-valid(reading) && ((String) oh-str(reading,"stage") == "observe"))) then form_error("care hears an original organ observation") else {
    let needs = json-array-elements(oh-get(reading,"needs"));
    if (!oc-needs-valid(needs)) then form_error("care needs a declared resource and detail")
    else if nil?(needs) then oc-hear-empty(context,reading,emit)
    else oc-hear-needs(context,reading,reading,needs,providers,emit,observe,[]);
   };
  }
  def oc-hear-empty(context,reading,emit) {
   let state = if oh-pain(reading) then "need-open" else if node_eq(oh-get(reading,"health"),json-node-null()) then "unmeasured" else if oc-unease(reading) then "unresolved" else "observed";
   if oc-unease(reading) then oc-emit(emit,context,"organ-attention",oc-attention(reading,json-node-null(),[],state)) else 1;
   json-node-object([oh-s("state",state),json-node-pair("observation",reading),json-node-pair("outcomes",json-node-array([]))]);
  }
  def oc-hear-needs(context,origin,reading,needs,providers,emit,observe,held) {
   let need = needs[0]; let current = json-array-elements(oh-get(reading,"needs"));
   let result = if oc-need-declared(current,need) then oc-hear-declared(context,reading,need,providers,emit,observe) else oc-hear-settled(context,reading,need,current,emit);
   let outcome = oh-set(oh-set(result,"need",need),"requested_by",oh-get(origin,"id"));
   let outcomes = cons(outcome,held);
   if nil?(needs[1:]) then oc-hear-finish(result,reverse(outcomes))
   else oc-hear-needs(context,origin,oh-get(result,"observation"),needs[1:],providers,emit,observe,outcomes);
  }
  def oc-hear-declared(context,reading,need,providers,emit,observe) {
   let provider = oc-find(providers,reading,need);
   oc-emit(emit,context,"organ-attention",oc-attention(reading,need,provider,if nil?(provider) then "unclaimed" else "offered"));
   oc-care(context,reading,need,providers,emit,observe);
  }
  // A previous delivery may settle or change another original need. The
  // latest observation is authoritative; stale need details cannot actuate.
  def oc-hear-settled(context,reading,need,current,emit) {
   let state = if oc-need-resource(current,need) then "superseded-by-observation" else "settled-by-observation";
   oc-emit(emit,context,"organ-attention",oc-attention(reading,need,[],state));
   json-node-object([oh-s("state",state),json-node-pair("observation",reading)]);
  }
  def oc-any-delivery(outcomes) = if nil?(outcomes) then 0 else (json-object-has?(outcomes[0],"delivery") || oc-any-delivery(outcomes[1:]));
  def oc-all-state(outcomes,state) = if nil?(outcomes) then 1 else (((String) oh-str(outcomes[0],"state") == state) && oc-all-state(outcomes[1:],state));
  def oc-hear-finish(result,outcomes) {
   let state = if ((Comparable) len(outcomes) == 1) then oh-str(result,"state") else if oc-all-state(outcomes,"unclaimed") then "unclaimed" else oc-observation-state(oh-get(result,"observation"),if oc-any-delivery(outcomes) then "resource-observed" else "observed");
   oh-set(oh-set(result,"state",json-node-string(state)),"outcomes",json-node-array(outcomes));
  }
  def oc-care(context,reading,need,providers,emit,observe) {
   if (!oh-valid(reading)) then form_error("care needs a valid organ observation") else {
    let provider = oc-find(providers,reading,need);
    if nil?(provider) then json-node-object([oh-s("state","unclaimed"),json-node-pair("observation",reading)]) else oc-owned(context,reading,need,provider,emit,observe);
   };
  }
  def oc-owned(context,reading,need,provider,emit,observe) {
   let response = oc-control(oh-response(reading,provider[2]),reading,need,provider);
   let selected = oh-select(reading,response,"");
   if ((String) selected == "") then form_error("care response does not match the asking organ") else oc-supply(context,reading,need,provider,emit,observe,response);
  }
  def oc-control(row,reading,need,provider) {
   let clean = json-node-object(oh-without(json-object-pairs(row),"care_delivery"));
   let current = if ((String) oh-str(row,"stage") == "response") then json-node-object(oh-without(json-object-pairs(clean),"result")) else clean;
   oh-set(oh-set(oh-set(current,"responder",json-node-string(provider[0])),"care_need",need),"care_of",oh-get(reading,"id"));
  }
  def oc-supply(context,reading,need,provider,emit,observe,response) {
   let claimed = oc-emit(emit,context,"organ-response",response);
   let started = host_monotonic_ms();
   let supplied = oc-call(provider[3],context,reading,need);
   let delivery = oh-set(supplied,"supply_elapsed_ms",json-node-int((host_monotonic_ms() - started)));
   let applied = oc-emit(emit,context,"organ-action-observed",oc-control(oh-applied(reading,oh-str(response,"selected"),delivery),reading,need,provider));
   let fresh = oc-observe(observe,context,reading,delivery);
   let bound = (oh-valid(fresh) && (oc-needs-valid(json-array-elements(oh-get(fresh,"needs"))) && ((!((String) oh-str(fresh,"id") == oh-str(reading,"id"))) && (((String) oh-key(fresh) == oh-key(reading)) && (((String) oh-str(fresh,"stage") == "observe") && ((String) oh-str(fresh,"care_of") == oh-str(reading,"id")))))));
   if (!bound) then form_error("care needs a fresh observation from the asking organ") else oc-finish(context,emit,need,provider,delivery,fresh);
  }
  def oc-finish(context,emit,need,provider,delivery,fresh) {
   let measured = json-node-object(oh-without(oh-without(json-object-pairs(fresh),"attention"),"attentions"));
   let current = oh-set(oh-set(oh-set(measured,"responder",json-node-string(provider[0])),"care_delivery",delivery),"care_need",need);
   let observed = oc-emit(emit,context,"organ-health",current);
   json-node-object([oh-s("state",oc-observation-state(fresh,"resource-observed")),oh-s("responder",provider[0]),json-node-pair("delivery",delivery),json-node-pair("observation",current)]);
  }
 }
 0;
}
