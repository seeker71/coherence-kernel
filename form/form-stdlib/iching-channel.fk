; iching-channel.fk — the 64 gates, read through three tongues at once.
;
; The I Ching's 64 hexagrams, the Human Design 64 gates, and the 64 Gene Keys are
; the SAME 64 cells. Ra Uru Hu mapped the I Ching onto the body; Richard Rudd grew
; the Gene Keys from the same 64. Gate 25 in Human Design, Gene Key 25, and I
; Ching hexagram 25 are ONE cell wearing three faces.
;
; THE TWO 64s. core-lexicon.fk's 64 are a closed grounding vocabulary — they
; define themselves. THESE 64 are the hexagram / gate / key cells. They are
; not the same set. The count rhymes; the meanings do not collapse.
;
; All 64 faces are seated. A key outside 1..64 still answers honest absence.
; I Ching names are King Wen tradition. Human Design gate names are the
; published keynotes. Gene Keys Shadow / Gift / Siddhi are documented
; tradition (Richard Rudd / genekeys.com), held in the direct-experience
; lane, never a verdict. Urs's eleven profile keys
; (receipts/2026-08-01-genekey-urs.md) enter here as attested rows.
;
; preludes: form-stdlib/core.fk form-stdlib/guidance-channel.fk

(do
    (defn ic64-teaching () "lc-cross-modal-unity")
    (defn ic64-total () 64)

    ; ── I Ching: (g pinyin english image) ────────────────────────────
    (defn ic-spec (g py en image) (list g py en image))
    (defn ic-spec-g  (r) (nth r 0))
    (defn ic-spec-py (r) (nth r 1))
    (defn ic-spec-en (r) (nth r 2))
    (defn ic-spec-im (r) (nth r 3))
    (defn ic-specs ()
        (list
            (ic-spec 1  "Qian"    "The Creative"              "heaven doubled; pure initiating force, act from clarity")
            (ic-spec 2  "Kun"     "The Receptive"             "earth doubled; devoted yielding that carries and completes")
            (ic-spec 3  "Zhun"    "Difficulty at the Beginning" "sprout through the hard ground")
            (ic-spec 4  "Meng"    "Youthful Folly"            "the young spring asking to be taught")
            (ic-spec 5  "Xu"      "Waiting"                   "nourishment comes in its own time")
            (ic-spec 6  "Song"    "Conflict"                  "meeting opposition without losing the centre")
            (ic-spec 7  "Shi"     "The Army"                  "many gathered under one direction")
            (ic-spec 8  "Bi"      "Holding Together"          "union that holds because it is chosen")
            (ic-spec 9  "Xiao Xu" "The Taming Power of the Small" "small restraint that gathers force")
            (ic-spec 10 "Lu"      "Treading"                  "walk the tiger's tail with care")
            (ic-spec 11 "Tai"     "Peace"                     "heaven and earth in open exchange")
            (ic-spec 12 "Pi"      "Standstill"                "heaven and earth have drawn apart")
            (ic-spec 13 "Tong Ren" "Fellowship"               "companions of the same fire")
            (ic-spec 14 "Da You"  "Possession in Great Measure" "great possession held lightly")
            (ic-spec 15 "Qian"    "Modesty"                   "the mountain under the earth")
            (ic-spec 16 "Yu"      "Enthusiasm"                "thunder that moves the many")
            (ic-spec 17 "Sui"     "Following"                 "to follow what is alive")
            (ic-spec 18 "Gu"      "Work on What Has Been Spoiled" "repair what decay has touched")
            (ic-spec 19 "Lin"     "Approach"                  "the great comes near")
            (ic-spec 20 "Guan"    "Contemplation"             "the tower that sees and is seen")
            (ic-spec 21 "Shi Ke"  "Biting Through"            "the decisive bite that clears")
            (ic-spec 22 "Bi"      "Grace"                     "beauty that adorns the bone")
            (ic-spec 23 "Bo"      "Splitting Apart"           "the mountain erodes; let the old fall")
            (ic-spec 24 "Fu"      "Return"                    "the turning point; light comes back")
            (ic-spec 25 "Wu Wang" "Innocence"                 "move in accord with the unexpected, free of calculation")
            (ic-spec 26 "Da Xu"   "The Taming Power of the Great" "great restraint that stores")
            (ic-spec 27 "Yi"      "Nourishment"               "watch what the mouth takes in")
            (ic-spec 28 "Da Guo"  "Preponderance of the Great" "the ridgepole sags; extraordinary weight")
            (ic-spec 29 "Kan"     "The Abysmal"               "water over water; the gorge")
            (ic-spec 30 "Li"      "The Clinging"              "fire clinging to what it lights")
            (ic-spec 31 "Xian"    "Influence"                 "the wooing; influence without force")
            (ic-spec 32 "Heng"    "Duration"                  "what lasts is what keeps moving truly")
            (ic-spec 33 "Dun"     "Retreat"                   "the wise withdrawal")
            (ic-spec 34 "Da Zhuang" "The Power of the Great"  "great strength that must not crush")
            (ic-spec 35 "Jin"     "Progress"                  "the sun rises over the earth")
            (ic-spec 36 "Ming Yi" "Darkening of the Light"    "light wounded; keep it inward")
            (ic-spec 37 "Jia Ren" "The Family"                "the clan as a living hearth")
            (ic-spec 38 "Kui"     "Opposition"                "two fires that cannot yet join")
            (ic-spec 39 "Jian"    "Obstruction"               "the halt that asks another way")
            (ic-spec 40 "Xie"     "Deliverance"               "the knot loosens; movement returns")
            (ic-spec 41 "Sun"     "Decrease"                  "what is given away makes room")
            (ic-spec 42 "Yi"      "Increase"                  "what is added multiplies")
            (ic-spec 43 "Guai"    "Breakthrough"              "the resolute stand that breaks through")
            (ic-spec 44 "Gou"     "Coming to Meet"            "the unexpected encounter")
            (ic-spec 45 "Cui"     "Gathering Together"        "the many gather around a centre")
            (ic-spec 46 "Sheng"   "Pushing Upward"            "the wood pushes up through earth")
            (ic-spec 47 "Kun"     "Oppression"                "the lake drained; keep the word")
            (ic-spec 48 "Jing"    "The Well"                  "the inexhaustible source, unchanged")
            (ic-spec 49 "Ge"      "Revolution"                "the molt; the necessary change")
            (ic-spec 50 "Ding"    "The Cauldron"              "the vessel that transforms")
            (ic-spec 51 "Zhen"    "The Arousing"              "thunder; the shock that wakes and brings reverent clarity")
            (ic-spec 52 "Gen"     "Keeping Still"             "the mountain; stillness of the back")
            (ic-spec 53 "Jian"    "Development"               "the tree grows on the mountain")
            (ic-spec 54 "Gui Mei" "The Marrying Maiden"       "entering a house not yet one's own")
            (ic-spec 55 "Feng"    "Abundance"                 "the zenith; fullness that will turn")
            (ic-spec 56 "Lu"      "The Wanderer"              "the fire on the mountain; a guest")
            (ic-spec 57 "Xun"     "The Gentle"                "wind and wood; the penetrating")
            (ic-spec 58 "Dui"     "The Joyous"                "the lake; joy that is shared")
            (ic-spec 59 "Huan"    "Dispersion"                "the ice melts; the gathering opens")
            (ic-spec 60 "Jie"     "Limitation"                "the measure that makes a life")
            (ic-spec 61 "Zhong Fu" "Inner Truth"              "the empty centre that hears")
            (ic-spec 62 "Xiao Guo" "Preponderance of the Small" "the bird stays near the ground")
            (ic-spec 63 "Ji Ji"   "After Completion"          "order arrived; tend it or it frays")
            (ic-spec 64 "Wei Ji"  "Before Completion"         "order not yet arrived; careful steps near the ford")))

    (defn ic-speak-of (r)
        (str_concat "Hexagram " (str_concat (int_to_str (ic-spec-g r))
        (str_concat " " (str_concat (ic-spec-py r)
        (str_concat " / " (str_concat (ic-spec-en r)
        (str_concat " — " (ic-spec-im r)))))))))
    (defn ic-entries-loop (rs)
        (if (eq (len rs) 0) (empty)
            (cons (gc-entry (ic-spec-g (head rs)) (ic-spec-g (head rs))
                            (ic-speak-of (head rs)) "lc-cross-modal-unity")
                  (ic-entries-loop (tail rs)))))
    (defn ic-hexagrams () (ic-entries-loop (ic-specs)))

    ; ── Human Design: (g name) ───────────────────────────────────────
    (defn hd-spec (g name) (list g name))
    (defn hd-spec-g (r) (nth r 0))
    (defn hd-spec-name (r) (nth r 1))
    (defn hd-specs ()
        (list
            (hd-spec 1  "Self-Expression")
            (hd-spec 2  "Direction of the Self")
            (hd-spec 3  "Ordering")
            (hd-spec 4  "Formulization")
            (hd-spec 5  "Fixed Rhythms")
