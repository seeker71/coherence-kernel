            (hd-spec 44 "Alertness")
            (hd-spec 45 "The Gatherer")
            (hd-spec 46 "Determination of the Self")
            (hd-spec 47 "Realization")
            (hd-spec 48 "Depth")
            (hd-spec 49 "Principles")
            (hd-spec 50 "Values")
            (hd-spec 51 "Shock")
            (hd-spec 52 "Stillness")
            (hd-spec 53 "Beginnings")
