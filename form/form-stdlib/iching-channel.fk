            (gk-spec 54 "Greed"            "Aspiration"       "Ascension")
            (gk-spec 55 "Victimization"    "Freedom"          "Freedom")
            (gk-spec 56 "Distraction"      "Enrichment"       "Intoxication")
            (gk-spec 57 "Unease"           "Intuition"        "Clarity")
            (gk-spec 58 "Dissatisfaction"  "Vitality"         "Bliss")
            (gk-spec 59 "Dishonesty"       "Intimacy"         "Transparency")
            (gk-spec 60 "Limitation"       "Realism"          "Justice")
            (gk-spec 61 "Psychosis"        "Inspiration"      "Sanctity")
            (gk-spec 62 "Intellect"        "Precision"        "Impeccability")
            (gk-spec 63 "Doubt"            "Inquiry"          "Truth")
            (gk-spec 64 "Confusion"        "Imagination"      "Illumination")))
    (defn gk-speak-of (r)
        (str_concat "Gene Key " (str_concat (int_to_str (gk-spec-g r))
        (str_concat " — Shadow " (str_concat (gk-spec-sh r)
        (str_concat " -> Gift " (str_concat (gk-spec-gi r)
        (str_concat " -> Siddhi " (gk-spec-si r)))))))))
    (defn gk-entries-loop (rs)
        (if (eq (len rs) 0) (empty)
            (cons (gc-entry (gk-spec-g (head rs)) (gk-spec-g (head rs))
                            (gk-speak-of (head rs)) "lc-cross-modal-unity")
                  (gk-entries-loop (tail rs)))))
    (defn gk-keys () (gk-entries-loop (gk-specs)))

    (defn ic-find-spec (rs g)
        (if (eq (len rs) 0) (empty)
            (if (eq (nth (head rs) 0) g) (head rs) (ic-find-spec (tail rs) g))))
    (defn gk-row (g) (ic-find-spec (gk-specs) g))
    (defn hd-row (g) (ic-find-spec (hd-specs) g))
    (defn ic-row (g) (ic-find-spec (ic-specs) g))
    (defn gk-shadow (g)
        (do (let r (gk-row g)) (if (eq (len r) 0) "" (gk-spec-sh r))))
    (defn gk-gift (g)
        (do (let r (gk-row g)) (if (eq (len r) 0) "" (gk-spec-gi r))))
    (defn gk-siddhi (g)
        (do (let r (gk-row g)) (if (eq (len r) 0) "" (gk-spec-si r))))
    (defn hd-name (g)
        (do (let r (hd-row g)) (if (eq (len r) 0) "" (hd-spec-name r))))
    (defn ic-name (g)
        (do (let r (ic-row g)) (if (eq (len r) 0) "" (ic-spec-en r))))

    (defn ic-hexagram-speak (g) (gc-speak (ic-hexagrams) g))
    (defn hd-gate-speak      (g) (gc-speak (hd-gates) g))
    (defn gk-key-speak       (g) (gc-speak (gk-keys) g))

    (defn ic64-read (g)
        (list (ic-hexagram-speak g) (hd-gate-speak g) (gk-key-speak g)))
    (defn ic64-one-cell? (g)
        (if (eq (gc-same-cell? (hd-gates) g (gk-keys) g) 1)
            (if (eq (gc-same-cell? (gk-keys) g (ic-hexagrams) g) 1) 1 0)
            0))
    (defn ic64-equivalents (g)
        (gc-equivalents (list (ic-hexagrams) (hd-gates) (gk-keys)) g))
    (defn ic64-seeded () (gc-coverage (ic-hexagrams)))
    (defn ic64-found? (g)
        (if (eq (len (gk-row g)) 0) 0 1))
    (defn ic64-all-found-loop (g)
        (if (gt g 64) 1
            (if (eq (ic64-found? g) 1) (ic64-all-found-loop (add g 1)) 0)))
    (defn ic64-all-found? () (ic64-all-found-loop 1))

    0)
