            (hd-spec 62 "Detail")
            (hd-spec 63 "Doubt")
            (hd-spec 64 "Confusion")))
    (defn hd-speak-of (r)
        (str_concat "Gate " (str_concat (int_to_str (hd-spec-g r))
        (str_concat " " (hd-spec-name r)))))
    (defn hd-entries-loop (rs)
        (if (eq (len rs) 0) (empty)
            (cons (gc-entry (hd-spec-g (head rs)) (hd-spec-g (head rs))
                            (hd-speak-of (head rs)) "lc-cross-modal-unity")
                  (hd-entries-loop (tail rs)))))
    (defn hd-gates () (hd-entries-loop (hd-specs)))

    ; ── Gene Keys: (g shadow gift siddhi) ────────────────────────────
    (defn gk-spec (g sh gi si) (list g sh gi si))
    (defn gk-spec-g  (r) (nth r 0))
    (defn gk-spec-sh (r) (nth r 1))
    (defn gk-spec-gi (r) (nth r 2))
    (defn gk-spec-si (r) (nth r 3))
    (defn gk-specs ()
        (list
            (gk-spec 1  "Entropy"          "Freshness"        "Beauty")
            (gk-spec 2  "Dislocation"      "Orientation"      "Unity")
            (gk-spec 3  "Chaos"            "Innovation"       "Innocence")
            (gk-spec 4  "Intolerance"      "Understanding"    "Forgiveness")
            (gk-spec 5  "Impatience"       "Patience"         "Timelessness")
            (gk-spec 6  "Conflict"         "Diplomacy"        "Peace")
            (gk-spec 7  "Division"         "Guidance"         "Virtue")
            (gk-spec 8  "Mediocrity"       "Style"            "Exquisiteness")
            (gk-spec 9  "Inertia"          "Determination"    "Invincibility")
            (gk-spec 10 "Self-Obsession"   "Naturalness"      "Being")
            (gk-spec 11 "Obscurity"        "Idealism"         "Light")
