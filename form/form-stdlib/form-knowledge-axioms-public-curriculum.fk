// form-knowledge-axioms-public-curriculum.fk -- public source-derived lessons
// for the local Form mind.
//
// This is a teaching organ, not another readiness gate.  Each public concept
// carries five independently addressable presentations: direct, paraphrase,
// corner case, source-bound scannerless query, and explicit-path scannerless
// query.  A lesson is interned as a content-addressed NodeID over its current
// source SHA, provenance, exact prompt, and exact response.  A source change
// therefore births a different lesson rather than silently retaining stale
// teaching.
//
// The callable `fkap-resident-teach-packet` is the local resident/RAG hook.  It
// returns the lesson NodeID plus both scannerless query surfaces and provenance.
// Unknown concepts, invalid variants, unreadable sources, or a reconstruction
// mismatch return exact `nothing`.  The packet claims neither model execution
// nor weight training; those remain separate physical observations.
//
// The census lesson is deliberately adaptive: a census is a current observed
// denominator, never a target fixed by this organ.  The projection is observed
// again after each crossing before another window is selected.
//
// Categories 31.2.0.120, 31.2.0.121, and 31.2.0.122 are Form-neutral lesson,
// packet, and explicit nothing-alternative categories.  Identity lives in the
// children; the categories only keep the node families distinct.  An invalid
// request still returns exact `nothing`; the alternative node rides only in a
// valid packet so a resident controller can retain the refused route's identity.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk
section [form.bml] {
    def fkap-entry(concept, path, anchor, direct-q, direct-a, paraphrase-q, paraphrase-a, corner-q, corner-a) = [concept, path, anchor, direct-q, direct-a, paraphrase-q, paraphrase-a, corner-q, corner-a];
    // Public source phrases are paraphrased into compact training answers.  The
    // exact source path and its live SHA stay attached to every presentation.
    def fkap-entries() = [fkap-entry("states", "axioms/core-axioms.form", "axiom-1-states", "What are Form's three ground states?", "The three states are 0, 1, and nothing.", "Name the complete state trinity without collapsing absence into false.", "Form keeps explicit 0, explicit 1, and first-class nothing distinct.", "A computation returns 0. Did it return nothing?", "No. Zero is a present value; nothing is a different first-class attestation."), fkap-entry("timeout", "form/form-stdlib/bml-bmf-control-curriculum.fk", "timeout-is-budgeted-nothing", "How does timeout differ from exhaustion?", "Timeout spends a bounded budget while alternatives remain untried; exhaustion has tried every alternative.", "What does a deadline say when another route still exists?", "It says timeout and returns nothing; it does not claim the alternatives were exhausted.", "The budget ended before lane three ran. May the result be labeled exhaustion?", "No. Untried lanes make it timeout, represented as nothing, not exhaustion."), fkap-entry("cell", "axioms/core-axioms.form", "axiom-2-cell", "What is a cell in the core axioms?", "Everything is a cell: a NodeID whose composition may contain child cells.", "How does Form give one shape to values, recipes, and organs?", "They are cells, identified by NodeID and able to compose child cells.", "Can a composed recipe stand outside the cell model?", "No. The recipe and its children are cells; nothing beside that kind is required."), fkap-entry("identity", "axioms/core-axioms.form", "axiom-3-content-addressing", "What determines a cell's identity?", "A cell's present composition determines its identity; the same composition is the same cell.", "Why can Form undo without overwriting the earlier cell?", "A changed composition mints a new NodeID while a referenced earlier NodeID remains available.", "If only a human-readable name stays the same after composition changes, is the cell identical?", "No. Names are query keys; changed present composition means a new NodeID."), fkap-entry("boundary", "axioms/core-axioms.form", "axiom-4-boundary", "How does a cell meet the world?", "A cell meets the world through an interface it offers, and observation through that interface makes the meeting real.", "Where do sovereignty and trust live at a cell boundary?", "The cell chooses what its interface offers and what it trusts; passage outside that interface is observable breach.", "Is an unobserved internal claim already physical evidence?", "No. Observation through an offered interface is what makes the claim real at the boundary."), fkap-entry("offer", "axioms/core-axioms.form", "axiom-5-offer", "What is the core offer operation?", "Running and speaking are one act: offer a cell with zero or more argument cells and receive nothing, 0, 1, or a node.", "Which acknowledgements may close or continue an offer?", "Nothing, 0, and 1 are terminal acknowledgements; a returned node may recur.", "May an offer silently coerce the acknowledgement 0 into nothing?", "No. Nothing and 0 are distinct acknowledgement arms and must remain observable."), fkap-entry("held-offer", "axioms/core-axioms.form", "held-offer", "What third reading can silence carry?", "Silence may mean not yet: hold the same offer without advancing, bounded by observable patience.", "What changes when an unanswered offer is presented again?", "The receiver or arguments may ripen; the held offer itself need not be replaced.", "After bounded patience is spent, should the body invent an answer?", "No. Spent patience acknowledges nothing instead of manufacturing a response."), fkap-entry("choice", "form/form-stdlib/bml-bmf-control-curriculum.fk", "choice-executes-first-evidenced-winner", "What does Form choice do with a nothing acknowledgement?", "Choice skips nothing acknowledgements and returns the first non-nothing acknowledgement.", "How does choice differ from retaining every lane?", "Choice selects the first answering lane; a lanes observation retains every alternative result.", "The first lane returns 0 and the second returns 1. Which value does choice return?", "Choice returns 0 because zero is non-nothing and therefore answers before the second lane."), fkap-entry("cut", "form/form-stdlib/bml-bmf-control-curriculum.fk", "cut-commits-and-prunes", "What does cut do after a branch is selected?", "Cut commits the selected acknowledgement and prunes the remaining alternatives.", "Why is cut not another spelling of choice?", "Choice searches for the first non-nothing answer; cut commits at its point and removes the other lanes.", "A cut branch acknowledges nothing. May execution silently try the next pruned lane?", "No. Cut commits even to that acknowledgement and the pruned alternatives do not run."), fkap-entry("undo", "form/form-stdlib/bml-bmf-control-curriculum.fk", "undo-restores-checkpoint", "What must undo restore?", "Undo restores the exact stored checkpoint before another route is tried.", "Why is a hand-authored approximation not an undo?", "Undo returns the checkpoint state byte for byte; a nearby reconstruction is a new state.", "A speculative cursor changed one byte and then failed. What state resumes?", "The exact stored cursor checkpoint resumes, not the partially changed cursor."), fkap-entry("thought-kernel", "observe/inquiry-planes.fk", "seven inquiry planes", "How are Form thought kernels selected?", "They route by inquiry plane: computable questions use exact organs and learned questions use learned kernels.", "Why should one local model not answer every inquiry in the same way?", "When, where, and which can be computed exactly, while what, who, how, and why may require learned reasoning.", "No kernel or evidence exists for the requested inquiry plane. What is the result?", "The route abstains as nothing instead of guessing a learned answer."), fkap-entry("auto-jit", "form/form-stdlib/bml-bmf-control-curriculum.fk", "auto-jit-is-earned-plan", "What does automatic JIT mean in the Form control curriculum?", "A hot pure recipe may earn a crystallization plan while its Form semantic result remains the reference.", "Does a generated CPU, GPU, Metal, or MLX plan prove native execution?", "No. Source generation, carrier installation, native call, observation, crystallization, dissolution, and release are separate signals.", "A JIT plan exists but no carrier call was observed. May live-native be 1?", "No. The plan is useful, but live-native remains 0 until separate carrier evidence arrives."), fkap-entry("self-composition", "axioms/kernel-self-composition.form", "build-bigger", "How can the kernel build a larger version of itself?", "It composes recipes over the same five primitives, can emit native code, and can persist new cells in the shared versioned substrate.", "What keeps a self-extension reversible?", "The new composition receives a new NodeID while a name can be pointed back to a still-referenced earlier NodeID.", "Does a larger kernel need a sixth primitive beneath the five axioms?", "No. A larger kernel remains recipes over the same five primitives."), fkap-entry("host-choice", "axioms/host-kernel.form", "zero-to-many-implementations", "How does a host kernel choose among implementations?", "It may hold zero to many recipes, compare measured fitness, and let the host kernel cell choose what it trusts.", "Must every host resource be reimplemented before Form may use it?", "No. A host driver or OS API is an allowed carrier when its presence and consequences are observable.", "A native challenger is newer but has not earned better measured health. Must it replace the host carrier?", "No. Native replacement is a choice earned by observation, not a debt or automatic promotion."), fkap-entry("adaptive-census", "form/form-stdlib/form-knowledge-integration-census.fk", "family census is read from the body", "Is the current family census a fixed mastery target?", "No. It is the current observed denominator; after a crossing the projection is observed again before choosing another window.", "What does selecting one observation window commit the body to next?", "It commits only to that crossing and to re-observing the projection, not to a permanently fixed count.", "The census changes after one family crosses. Should the old denominator remain authoritative?", "No. Re-observe the living body and select the next window from the new projection.")];
    def fkap-find(concept, rows) = nil?(rows) ? nothing() : (String) concept == head(rows)[0] ? head(rows) : fkap-find(concept, tail(rows));
    def fkap-variation(variant) = (Comparable) variant == 0 ? "direct" : (Comparable) variant == 1 ? "paraphrase" : (Comparable) variant == 2 ? "corner" : (Comparable) variant == 3 ? "source-bound-query" : (Comparable) variant == 4 ? "path-query" : "";
    def fkap-variation-index(label) = (String) label == "direct" ? 0 : (String) label == "paraphrase" ? 1 : (String) label == "corner" ? 2 : (String) label == "source-bound-query" ? 3 : (String) label == "path-query" ? 4 : -1;
    // Both surfaces are scannerless byte frames.  The source-bound lane lets
    // Form keep path authority; the explicit-path lane is for an unbound caller.
    def fkap-query(entry, bound) = bound ? str_concat("<|form:knowledge-query|>", str_concat(entry[2], "<|/form:knowledge-query|>")) : str_concat("<|form:knowledge-query|>", str_concat(entry[2], str_concat(" ; ", str_concat(entry[1], "<|/form:knowledge-query|>"))));
    def fkap-prompt(entry, variant) = (Comparable) variant == 0 ? entry[3] : (Comparable) variant == 1 ? entry[5] : (Comparable) variant == 2 ? entry[7] : (Comparable) variant == 3 ? str_concat("Emit only the source-bound scannerless query for: ", entry[2]) : (Comparable) variant == 4 ? str_concat("Emit only the scannerless query with explicit source for: ", entry[2]) : "";
    def fkap-answer(entry, variant) = (Comparable) variant == 0 ? entry[4] : (Comparable) variant == 1 ? entry[6] : (Comparable) variant == 2 ? entry[8] : (Comparable) variant == 3 ? fkap-query(entry, 1) : (Comparable) variant == 4 ? fkap-query(entry, 0) : "";
    def fkap-node-key(node) = str_concat(int_to_str(node_pkg(node)), str_concat(".", str_concat(int_to_str(node_level(node)), str_concat(".", str_concat(int_to_str(node_type(node)), str_concat(".", int_to_str(node_inst(node))))))));
    // lesson = schema node node-key concept variation prompt answer path
    //          source-id anchor model-executed weights-trained
    def fkap-lesson(concept, variant) = {
        let entry = fkap-find(concept, fkap-entries());
        let label = fkap-variation(variant);
        nothing?(entry) || (Comparable) str_len(label) == 0 ? nothing() : file_size(entry[1]) <= 0 ? nothing() : {
            let source-id = fkss-source-id(entry[1]);
            let prompt = fkap-prompt(entry, variant);
            let answer = fkap-answer(entry, variant);
            let node = intern_node(make_nodeid(31, 2, 0, 120), [intern_trivial_string("axioms-public-lesson-v1"), intern_trivial_string(concept), intern_trivial_string(label), intern_trivial_string(prompt), intern_trivial_string(answer), intern_trivial_string(entry[1]), intern_trivial_string(source-id), intern_trivial_string(entry[2])]);
            ["axioms-public-lesson-v1", node, fkap-node-key(node), concept, label, prompt, answer, entry[1], source-id, entry[2], 0, 0];
        };
    };
    def fkap-lesson-valid?(lesson) = nothing?(lesson) || !((Comparable) len(lesson) == 12) ? 0 : {
        let rebuilt = fkap-lesson(lesson[3], fkap-variation-index(lesson[4]));
        nothing?(rebuilt) ? 0 : {
            let checks = [(String) lesson[0] == rebuilt[0], node_eq(lesson[1], rebuilt[1]), (String) lesson[2] == rebuilt[2], (String) lesson[3] == rebuilt[3], (String) lesson[4] == rebuilt[4], (String) lesson[5] == rebuilt[5], (String) lesson[6] == rebuilt[6], (String) lesson[7] == rebuilt[7], (String) lesson[8] == rebuilt[8], (String) lesson[9] == rebuilt[9], (Comparable) lesson[10] == rebuilt[10], (Comparable) lesson[11] == rebuilt[11]];
            (Comparable) sum(checks) == len(checks) ? 1 : 0;
        };
    };
    // packet = schema packet-node packet-node-key alternative alternative-key
    //          status reason lesson-node-key source-bound-query path-query
    //          prompt answer path source-id concept variation provenance
    //          model-executed weights-trained
    def fkap-resident-teach-packet(concept, variant) = {
        let lesson = fkap-lesson(concept, variant);
        nothing?(lesson) || (Comparable) fkap-lesson-valid?(lesson) == 0 ? nothing() : {
            let entry = fkap-find(concept, fkap-entries());
            let alternative = intern_node(make_nodeid(31, 2, 0, 122), [intern_trivial_string("axioms-public-nothing-alternative-v1"), lesson[1], intern_trivial_string("nothing")]);
            let packet-node = intern_node(make_nodeid(31, 2, 0, 121), [intern_trivial_string("axioms-public-resident-teach-packet-v1"), lesson[1], intern_trivial_string(fkap-query(entry, 1)), intern_trivial_string(fkap-query(entry, 0)), alternative]);
            ["axioms-public-resident-teach-packet-v1", packet-node, fkap-node-key(packet-node), alternative, fkap-node-key(alternative), "hit", "current-public-source", lesson[2], fkap-query(entry, 1), fkap-query(entry, 0), lesson[5], lesson[6], lesson[7], lesson[8], concept, lesson[4], "public-source-derived", 0, 0];
        };
    };
    def fkap-packet-valid?(packet) = nothing?(packet) || !((Comparable) len(packet) == 19) ? 0 : {
        let rebuilt = fkap-resident-teach-packet(packet[14], fkap-variation-index(packet[15]));
        nothing?(rebuilt) ? 0 : {
            let checks = [(String) packet[0] == rebuilt[0], node_eq(packet[1], rebuilt[1]), (String) packet[2] == rebuilt[2], node_eq(packet[3], rebuilt[3]), (String) packet[4] == rebuilt[4], (String) packet[5] == rebuilt[5], (String) packet[6] == rebuilt[6], (String) packet[7] == rebuilt[7], (String) packet[8] == rebuilt[8], (String) packet[9] == rebuilt[9], (String) packet[10] == rebuilt[10], (String) packet[11] == rebuilt[11], (String) packet[12] == rebuilt[12], (String) packet[13] == rebuilt[13], (String) packet[14] == rebuilt[14], (String) packet[15] == rebuilt[15], (String) packet[16] == rebuilt[16], (Comparable) packet[17] == rebuilt[17], (Comparable) packet[18] == rebuilt[18]];
            (Comparable) sum(checks) == len(checks) ? 1 : 0;
        };
    };
    // The standard source-bound resident path calls this exact hook.  Keeping
    // it as an alias gives that path a stable name while the lesson organ may
    // continue to grow from the live public body.
    def fkap-source-bound-hook(concept, variant) = fkap-resident-teach-packet(concept, variant);
    // A query-only offer carries no teaching answer. Its discriminative anchor
    // must occur in the independent question, while Form—not the model—retains
    // path authority. The NodeID binds source identity, query and question.
    // offer = schema node node-key query path source-id anchor question-sha
    //         model-executed
    def fkap-rag-query-offer(path, anchor, question) = file_size(path) <= 0 || ((Comparable) str_len(anchor) == 0 || (str_len(anchor) > fkss-max-query-atom() || str_find(question, anchor, 0) < 0)) ? nothing() : {
        let source-id = fkss-source-id(path);
        let query = str_concat("<|form:knowledge-query|>", str_concat(anchor, "<|/form:knowledge-query|>"));
        let question-sha = hex-encode(sha256-stream-string(question));
        let node = intern_node(make_nodeid(31, 2, 0, 123), [intern_trivial_string("axioms-public-rag-query-offer-v1"), intern_trivial_string(source-id), intern_trivial_string(query), intern_trivial_string(question-sha)]);
        ["axioms-public-rag-query-offer-v1", node, fkap-node-key(node), query, path, source-id, anchor, question-sha, 0];
    };
    def fkap-rag-query-offer-valid?(offer, question) = nothing?(offer) || !((Comparable) len(offer) == 9) ? 0 : {
        let rebuilt = fkap-rag-query-offer(offer[4], offer[6], question);
        nothing?(rebuilt) ? 0 : (String) offer[0] == rebuilt[0] && (node_eq(offer[1], rebuilt[1]) && ((String) offer[2] == rebuilt[2] && ((String) offer[3] == rebuilt[3] && ((String) offer[4] == rebuilt[4] && ((String) offer[5] == rebuilt[5] && ((String) offer[6] == rebuilt[6] && ((String) offer[7] == rebuilt[7] && (Comparable) offer[8] == 0))))))) ? 1 : 0;
    };
    // A source-bound, answer-task-disjoint RAG rehearsal may give the local
    // model the exact public query token without placing any teaching answer in
    // the offer. Form still parses and executes the generated stream, injects
    // the typed source observation, and lets the model answer the independent
    // question. This is explicit retrieval supervision, never heldout credit.
    def fkap-query-rehearsal-prompt(offer, question) = (Comparable) fkap-rag-query-offer-valid?(offer, question) == 0 || (Comparable) str_len(question) == 0 ? nothing() : str_concat("Public source-bound, answer-task-disjoint RAG rehearsal. Your first generated bytes must be exactly this query token, byte for byte, with no leading prose: ", str_concat(offer[3], str_concat(" After Form injects the typed source observation, answer only the independent question in its requested shape. Question: ", question)));
    0;
}
