// form-cli-inquiry.fk — axiom-1-complete native inquiry receipts for form-cli.
//
// preludes: form-stdlib/core.fk form-stdlib/form-cli-inquiry-edge-ledger.fk
//
// That preludes line was `; import "form-cli-inquiry-edge-ledger.fk"` until
// 2026-08-15, and `; import` is a comment — this body's live directive is
// `; preludes:`. So fciel-augment never resolved, fci-edges is
// (fciel-augment (fci-static-edges)), an unresolved call answers `nothing` under
// axiom-5, and the ten static edges below went into that nothing. `inquire-core`
// through the shipped form-cli answered core-edges=0: the core proof graph read
// empty while ten edges sat three lines down. One word, and the wrong kind of
// comment held the core's re-witness shut.
// ack is actual nothing/0/1/node. timeout is nothing with reason 2.
// witnessed: 2026-07-21 -> direct source and installed form-cli agree; rewitness=1
section [form.bml] {
    def fci-edge(s, r, t, source) = [s, r, t, source];
    def fci-static-edges() = [fci-edge(1, 2, 8, 1), fci-edge(1, 2, 9, 1), fci-edge(2, 3, 8, 1), fci-edge(2, 3, 10, 1), fci-edge(3, 1, 11, 1), fci-edge(4, 1, 12, 2), fci-edge(4, 1, 7, 2), fci-edge(4, 1, 6, 2), fci-edge(6, 1, 5, 2), fci-edge(3, 4, 4, 2)];
    def fci-edges() = fciel-augment(fci-static-edges());
    def fci-s(e) = e[0];
    def fci-r(e) = e[1];
    def fci-t(e) = e[2];
    def fci-member?(x, xs) = (Comparable) len(xs) == 0 ? 0 : (Comparable) x == head(xs) ? 1 : fci-member?(x, tail(xs));
    def fci-proof(ack, reason, path, steps) = [ack, reason, path, steps];
    def fci-ack(p) = p[0];
    def fci-reason(p) = p[1];
    def fci-path(p) = p[2];
    def fci-steps(p) = p[3];
    def fci-nothing?(p) = nothing?(fci-ack(p)) ? 1 : 0;
    def fci-node?(p) = (Comparable) fci-nothing?(p) == 0 && (!((Comparable) fci-ack(p) == 0) && !((Comparable) fci-ack(p) == 1)) ? 1 : 0;
    def fci-yes?(p) = (Comparable) fci-ack(p) == 1 || (Comparable) fci-node?(p) == 1 ? 1 : 0;
    def fci-walk(all, edges, s, target, seen, fuel, pending, steps) = fuel <= 0 ? fci-proof(nothing(), 2, seen, steps) : (Comparable) len(edges) == 0 ? (Comparable) fci-nothing?(pending) == 1 ? pending : fci-proof(0, 0, [], steps) : {
        let e = head(edges);
        (Comparable) fci-s(e) == s && (Comparable) fci-r(e) == 1 ? (Comparable) fci-t(e) == target ? fci-proof([1, s, target], 0, [s, target], steps + 1) : (Comparable) fci-member?(fci-t(e), seen) == 1 ? fci-walk(all, tail(edges), s, target, seen, fuel - 1, pending, steps + 1) : {
            let child = fci-walk(all, all, fci-t(e), target, cons(fci-t(e), seen), fuel - 1, fci-proof(0, 0, [], 0), steps + 1);
            (Comparable) fci-yes?(child) == 1 ? {
                let path = cons(s, fci-path(child));
                fci-proof([1, path], 0, path, fci-steps(child));
            } : fci-walk(all, tail(edges), s, target, seen, fuel - 1, (Comparable) fci-nothing?(child) == 1 ? child : pending, steps + 1);
        } : fci-walk(all, tail(edges), s, target, seen, fuel - 1, pending, steps + 1);
    };
    def fci-requires(s, t, fuel) = s < 1 || (s > 12 || (t < 1 || t > 12)) ? fci-proof(nothing(), 1, [s, t], 0) : fci-walk(fci-edges(), fci-edges(), s, t, [s], fuel, fci-proof(0, 0, [], 0), 0);
    def fci-fold(b) = b >= 65 && b <= 90 ? b + 32 : b;
    def fci-match(s, i, w, j) = j >= str_len(w) ? 1 : i + j >= str_len(s) ? 0 : (Comparable) fci-fold(str_byte_at(s, i + j)) == fci-fold(str_byte_at(w, j)) ? fci-match(s, i, w, j + 1) : 0;
    def fci-has-loop(s, w, i) = i + str_len(w) > str_len(s) ? 0 : (Comparable) fci-match(s, i, w, 0) == 1 ? 1 : fci-has-loop(s, w, i + 1);
    def fci-has?(s, w) = fci-has-loop(s, w, 0);
    def fci-ack-name(p) = (Comparable) fci-nothing?(p) == 1 ? "nothing" : (Comparable) fci-ack(p) == 0 ? "0" : (Comparable) fci-ack(p) == 1 ? "1" : "node";
    def fci-int(n) = n < 10 ? byte_to_str(48 + n) : str_concat(fci-int(n / 10), byte_to_str(48 + n % 10));
    def fci-append-line(path, line) = {
        let prior0 = read_file(path);
        write_file(path, str_concat(nothing?(prior0) ? "" : prior0, line));
    };
    def fci-proof-line(name, p) = str_concat(name, str_concat(":ack=", str_concat(fci-ack-name(p), str_concat(",reason=", str_concat(fci-int(fci-reason(p)), str_concat(",steps=", fci-int(fci-steps(p))))))));
    def fci-ledger-path() = ".form-native-inquiry-ledger.tsv";
    // The ledger's date is asked of the host clock, never baked. now_unix_ms
    // (tag 15) is the one clock this carrier holds; the walk below is the
    // era-arithmetic civil calendar, exact after 1970 (no division meets a
    // negative). It reads UTC: at UTC+8 this body's day turns over eight hours
    // early — named here as at its sibling home (form-cli-repl.fk fc-civil;
    // preludes are per-unit closures, so the calendar lives twice until a
    // shared cell earns its place on the six mirrored source lists).
    def fci-civil(days) = {
        let z = days + 719468;
        let era = z / 146097;
        let doe = z - era * 146097;
        let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        let y0 = yoe + era * 400;
        let doy = doe - (365 * yoe + (yoe / 4 - yoe / 100));
        let mp = (5 * doy + 2) / 153;
        let d = doy - (153 * mp + 2) / 5 + 1;
        let m = mp < 10 ? mp + 3 : mp - 9;
        let y = m <= 2 ? y0 + 1 : y0;
        y * 10000 + (m * 100 + d);
    };
    def fci-today() = fci-civil(now_unix_ms() / 86400000);
    def fci-inquire(q) = {
        let a = (Comparable) fci-has?(q, "trust") == 1 && (Comparable) fci-has?(q, "trinity") == 1 ? fci-requires(1, 2, 1000) : fci-proof(nothing(), 1, [], 0);
        let b = (Comparable) fci-has?(q, "knowing") == 1 && (Comparable) fci-has?(q, "time") == 1 ? fci-requires(4, 5, 1000) : fci-proof(nothing(), 1, [], 0);
        let wrote = fci-append-line(fci-ledger-path(), str_concat(fci-int(fci-today()), str_concat("\t", str_concat(fci-ack-name(a), str_concat("\t", str_concat(fci-ack-name(b), "\n"))))));
        str_concat(fci-proof-line("trust-trinity", a), str_concat("\n", str_concat(fci-proof-line("knowing-time", b), str_concat("\nledger-written=", wrote > 0 ? "1" : "0"))));
    };
    def fci-core-rewitness() = {
        let no-path = fci-requires(1, 2, 1000);
        let node-path = fci-requires(4, 5, 1000);
        let unknown = fci-requires(99, 2, 1000);
        let timed = fci-requires(4, 5, 0);
        let valid = len(fci-edges()) >= len(fci-static-edges()) && ((Comparable) fci-ack(no-path) == 0 && ((Comparable) fci-node?(node-path) == 1 && ((Comparable) fci-reason(unknown) == 1 && ((Comparable) fci-nothing?(unknown) == 1 && ((Comparable) fci-nothing?(timed) == 1 && (Comparable) fci-reason(timed) == 2))))) ? 1 : 0;
        let wrote = fci-append-line(fci-ledger-path(), str_concat(fci-int(fci-today()), str_concat("\tcore\t", str_concat(fci-int(len(fci-edges())), str_concat("\t", str_concat(fci-int(valid), "\n"))))));
        let detail0 = str_concat("core-edges=", fci-int(len(fci-edges())));
        let detail1 = str_concat(detail0, str_concat("\nno-ack=", fci-ack-name(no-path)));
        let detail2 = str_concat(detail1, str_concat("\nnode-ack=", fci-ack-name(node-path)));
        let detail3 = str_concat(detail2, str_concat("\nunknown-ack=", fci-ack-name(unknown)));
        let detail4 = str_concat(detail3, str_concat(",reason=", fci-int(fci-reason(unknown))));
        let detail5 = str_concat(detail4, str_concat("\ntimeout-ack=", fci-ack-name(timed)));
        let detail6 = str_concat(detail5, str_concat(",reason=", fci-int(fci-reason(timed))));
        str_concat(detail6, str_concat("\nack-range=nothing,0,1,node\nrewitness=", str_concat(fci-int(valid), str_concat("\nledger-written=", wrote > 0 ? "1" : "0"))));
    };
    0;
}
