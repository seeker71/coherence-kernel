; living-world-generative-continuation.fk -- current field transitions may
; continue themselves without an imported vocabulary or answer route.
;
; A link is ordinary transition content: an arbitrary emitted cell, an
; optional next arbitrary context, an optional offered lens, and evidence.
; The walker follows only a unique current transition and only when its exact
; derivation has one current participant-learned surface.  It never chooses
; among plural next cells or plural surfaces.  No surface, context width,
; grammar, task name, answer, or stopping length lives in this organ.
;
; A request may omit its horizon, lens declaration, alternatives, unknowable
; remainder, choice, timeout/default, and outward projection independently.
; No horizon means walk the finite current graph until a terminal, missing,
; plural, unvoiced, or repeated context is observed.  Context identity makes
; cycles finite without imposing a fixed token budget.
;
; Every turn retains the current prediction, expressive plan, selected next,
; exact learned surface, emitted cell, and successor context.  The trace is
; reconstructible against the current world; revocation makes an old trace
; stale without erasing it.  Live observation projects counts and phases only.
; witnessed: 2026-08-09 -> 1048575 + held-out transfer 33554431
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-transition-field.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-transition-expression.fk form-stdlib/living-world-shared-field-channel.fk

(let LWSG-LINK       (bp "LWSG-LINK"))
(let LWSG-REQUEST    (bp "LWSG-REQUEST"))
(let LWSG-TURN       (bp "LWSG-TURN"))
(let LWSG-TURNS      (bp "LWSG-TURNS"))
(let LWSG-TRACE      (bp "LWSG-TRACE"))
(let LWSG-TERMINAL   (bp "LWSG-TERMINAL"))
(let LWSG-EXHAUSTED  (bp "LWSG-EXHAUSTED"))
(let LWSG-PLURAL     (bp "LWSG-PLURAL"))
(let LWSG-UNVOICED   (bp "LWSG-UNVOICED"))
(let LWSG-CYCLE      (bp "LWSG-CYCLE"))
(let LWSG-HORIZON    (bp "LWSG-HORIZON"))
(let LWSG-TIMED      (bp "LWSG-TIMED"))
(let LWSG-CONTINUE   (bp "LWSG-CONTINUE"))

; children: arbitrary emitted cell, optional next context, optional lens,
;           evidence, local path
(defn lwsg-link (emitted next-context lens evidence)
    (intern_node LWSG-LINK
        (list emitted next-context lens evidence (lwo-local-path))))
(defn lwsg-link? (cell)
    (if (and (eq (lwo-category? cell LWSG-LINK) 1)
             (eq (len (node_children cell)) 5)) 1 0))
(defn lwsg-link-emitted (link) (nth (node_children link) 0))
(defn lwsg-link-next-context (link) (nth (node_children link) 1))
(defn lwsg-link-lens (link) (nth (node_children link) 2))
(defn lwsg-link-evidence (link) (nth (node_children link) 3))
(defn lwsg-link-valid? (link)
    (if (eq (lwsg-link? link) 0) 0
        (if (and
                (or (node_eq (lwsg-link-next-context link) (lwo-none))
                    (eq (lwtf-context? (lwsg-link-next-context link)) 1))
                (or (node_eq (lwsg-link-lens link) (lwo-none))
                    (eq (lwlc-lens? (lwsg-link-lens link)) 1))) 1 0)))

(defn lwsg-int-cell? (cell)
    (if (and (eq (node_level cell) 1)
             (eq (node_type cell) 1)) 1 0))
(defn lwsg-horizon-valid? (horizon)
    (if (node_eq horizon (lwo-none)) 1
        (if (and (eq (lwsg-int-cell? horizon) 1)
                 (ge (node_value horizon) 0)) 1 0)))
(defn lwsg-declaration-valid? (declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-valid? declaration)))
(defn lwsg-unknown-valid? (unknown)
    (if (node_eq unknown (lwo-none)) 1 (lwlc-unknown? unknown)))
(defn lwsg-timeout-valid? (timeout)
    (if (node_eq timeout (lwo-none)) 1 (oac-timeout-valid? timeout)))

; children: initial context, optional horizon, optional lens declaration,
; alternatives, optional unknown, optional choice, optional timeout, observed
; time, optional outward projection, local path
(defn lwsg-request
    (context horizon declaration alternatives unknown choice timeout now
     projection)
    (intern_node LWSG-REQUEST
        (list context horizon declaration alternatives unknown choice timeout
              (intern_trivial_int now) projection (lwo-local-path))))
(defn lwsg-request? (cell)
    (if (and (eq (lwo-category? cell LWSG-REQUEST) 1)
             (eq (len (node_children cell)) 10)) 1 0))
(defn lwsg-request-context (request) (nth (node_children request) 0))
(defn lwsg-request-horizon (request) (nth (node_children request) 1))
(defn lwsg-request-declaration (request) (nth (node_children request) 2))
(defn lwsg-request-alternatives (request) (nth (node_children request) 3))
(defn lwsg-request-unknown (request) (nth (node_children request) 4))
(defn lwsg-request-choice (request) (nth (node_children request) 5))
(defn lwsg-request-timeout (request) (nth (node_children request) 6))
(defn lwsg-request-now-cell (request) (nth (node_children request) 7))
(defn lwsg-request-now (request)
    (node_value (lwsg-request-now-cell request)))
(defn lwsg-request-projection (request) (nth (node_children request) 8))
(defn lwsg-request-optionals-valid? (request)
    (if (eq (lwsg-declaration-valid?
                (lwsg-request-declaration request)) 0) 0
        (if (eq (lwo-category?
                    (lwsg-request-alternatives request) LWO-FIELD) 0) 0
            (if (eq (lwsg-unknown-valid?
                        (lwsg-request-unknown request)) 0) 0
                (if (eq (lwlc-choice-valid?
                            (lwsg-request-choice request)) 0) 0
                    (lwsg-timeout-valid?
                        (lwsg-request-timeout request)))))))
(defn lwsg-request-valid? (request)
    (if (eq (lwsg-request? request) 0) 0
        (if (eq (lwtf-context? (lwsg-request-context request)) 0) 0
            (if (eq (lwsg-horizon-valid?
                        (lwsg-request-horizon request)) 0) 0
                (if (eq (lwsg-int-cell?
                            (nth (node_children request) 7)) 0) 0
                    (lwsg-request-optionals-valid? request))))))

(defn lwsg-completion (kind evidence)
    (intern_node kind (list evidence (lwo-local-path))))
(defn lwsg-completion? (cell kind)
    (if (and (eq (lwo-category? cell kind) 1)
             (eq (len (node_children cell)) 2)) 1 0))
(defn lwsg-terminal (evidence) (lwsg-completion LWSG-TERMINAL evidence))
(defn lwsg-exhausted (evidence) (lwsg-completion LWSG-EXHAUSTED evidence))
(defn lwsg-plural (evidence) (lwsg-completion LWSG-PLURAL evidence))
(defn lwsg-unvoiced (evidence) (lwsg-completion LWSG-UNVOICED evidence))
(defn lwsg-cycle (evidence) (lwsg-completion LWSG-CYCLE evidence))
(defn lwsg-horizon (evidence) (lwsg-completion LWSG-HORIZON evidence))
(defn lwsg-timed (evidence) (lwsg-completion LWSG-TIMED evidence))

; children: context, prediction, plan, selected next, exact surface or none,
; emitted cell, optional successor context, local path
(defn lwsg-turn (context prediction plan next surface emitted successor)
    (intern_node LWSG-TURN
        (list context prediction plan next surface emitted successor
              (lwo-local-path))))
(defn lwsg-turn? (cell) (lwo-category? cell LWSG-TURN))
(defn lwsg-turn-context (turn) (nth (node_children turn) 0))
(defn lwsg-turn-prediction (turn) (nth (node_children turn) 1))
(defn lwsg-turn-plan (turn) (nth (node_children turn) 2))
(defn lwsg-turn-next (turn) (nth (node_children turn) 3))
(defn lwsg-turn-surface (turn) (nth (node_children turn) 4))
(defn lwsg-turn-emitted (turn) (nth (node_children turn) 5))
(defn lwsg-turn-successor (turn) (nth (node_children turn) 6))
(defn lwsg-turns (items) (intern_node LWSG-TURNS items))
(defn lwsg-turns? (cell) (lwo-category? cell LWSG-TURNS))
(defn lwsg-turn-items (turns) (node_children turns))

; children: request, ordered turns, rendered participant surfaces,
; completion, effective ack, final prediction, final plan, time state,
; local path
(defn lwsg-trace
    (request turns rendered completion ack prediction plan time-state)
    (intern_node LWSG-TRACE
        (list request turns (intern_trivial_string rendered) completion ack
              prediction plan time-state (lwo-local-path))))
(defn lwsg-trace? (cell) (lwo-category? cell LWSG-TRACE))
(defn lwsg-trace-request (trace) (nth (node_children trace) 0))
(defn lwsg-trace-turns (trace) (nth (node_children trace) 1))
(defn lwsg-trace-rendered-cell (trace) (nth (node_children trace) 2))
(defn lwsg-trace-rendered (trace)
    (node_value (lwsg-trace-rendered-cell trace)))
(defn lwsg-trace-completion (trace) (nth (node_children trace) 3))
(defn lwsg-trace-ack (trace) (nth (node_children trace) 4))
(defn lwsg-trace-prediction (trace) (nth (node_children trace) 5))
(defn lwsg-trace-plan (trace) (nth (node_children trace) 6))
(defn lwsg-trace-time-state (trace) (nth (node_children trace) 7))

(defn lwsg-context-member? (context contexts)
    (if (eq (len contexts) 0) 0
        (if (node_eq context (head contexts)) 1
            (lwsg-context-member? context (tail contexts)))))
(defn lwsg-horizon-reached? (request count)
    (if (node_eq (lwsg-request-horizon request) (lwo-none)) 0
        (if (ge count (node_value (lwsg-request-horizon request))) 1 0)))
(defn lwsg-time-state (request)
    (if (node_eq (lwsg-request-timeout request) (lwo-none)) (lwo-none)
        (oac-timeout-condense
            (lwsg-request-timeout request)
            (lwsg-request-now-cell request))))
(defn lwsg-time-expired? (time-state)
    (if (node_eq time-state (lwo-none)) 0
        (oac-time-outcome? time-state)))

(defn lwsg-next-emitted (next)
    (if (eq (lwsg-link-valid? next) 1)
        (lwsg-link-emitted next) next))
(defn lwsg-next-context (next)
    (if (eq (lwsg-link-valid? next) 1)
        (lwsg-link-next-context next) (lwo-none)))

(defn lwsg-finish
    (request reverse-turns rendered completion ack prediction plan time-state)
    (lwsg-trace request (lwsg-turns (reverse reverse-turns)) rendered
        completion ack prediction plan time-state))

(defn lwsg-progress-target (turns ack rendered)
    (lcfb-cat (list
        "turns:" (int_to_str (len turns))
        ":ack:" (int_to_str (oac-kind ack))
        ":voice-bytes:" (int_to_str (str_len rendered)))))

(defn lwsg-frame
    (observed phase target ordinal started line col)
    (if (eq observed 1)
        (lcfb-call-stream "living-world-generative-continuation"
            "generation" phase "form-native" "lwsg-walk" target ordinal
            started
            "form/form-stdlib/living-world-generative-continuation.fk"
            line col)
        (lwo-none)))

(defn lwsg-stop
    (request reverse-turns rendered completion ack prediction plan time-state
     observed started ordinal line col)
    (do
        (let left
            (lwsg-frame observed "leave"
                (lwsg-progress-target reverse-turns ack rendered)
                ordinal started line col))
        (lwsg-finish request reverse-turns rendered completion ack prediction
            plan time-state)))

(defn lwsg-stop-horizon
    (request reverse-turns rendered time-state observed started ordinal)
    (do
        (let horizon (lwsg-request-horizon request))
        (let ack (oac-node horizon))
        (lwsg-stop request reverse-turns rendered (lwsg-horizon horizon) ack
            (lwo-none) (lwo-none) time-state observed started ordinal 228 9)))

(defn lwsg-stop-cycle
    (request context reverse-turns rendered time-state observed started ordinal)
    (do
        (let ack (oac-node context))
        (lwsg-stop request reverse-turns rendered (lwsg-cycle context) ack
            (lwo-none) (lwo-none) time-state observed started ordinal 235 9)))

(defn lwsg-stop-prediction
    (request prediction reverse-turns rendered time-state observed started
     ordinal)
    (do
        (let ack (lwtf-prediction-ack prediction))
        (lwsg-stop request reverse-turns rendered
            (if (eq (oac-nothing? ack) 1)
                (lwsg-exhausted prediction) (lwsg-plural prediction))
            ack prediction (lwo-none) time-state observed started ordinal
            243 9)))

(defn lwsg-stop-voice
    (request prediction plan next reverse-turns rendered time-state observed
     started ordinal)
    (do
        (let ack
            (if (node_eq plan (lwo-none)) (oac-nothing)
                (lwtx-plan-ack plan)))
        (let turn
            (lwsg-turn (lwtf-prediction-context prediction) prediction plan
                next (lwo-none) (lwsg-next-emitted next)
                (lwsg-next-context next)))
        (let turns (cons turn reverse-turns))
        (lwsg-stop request turns rendered
            (if (eq (oac-nothing? ack) 1)
                (lwsg-unvoiced plan) (lwsg-plural plan))
            ack prediction plan time-state observed started ordinal 261 9)))

(defn lwsg-stop-terminal
    (request prediction plan emitted turns rendered time-state observed started
     ordinal)
    (do
        (let ack (oac-one emitted))
        (lwsg-stop request turns rendered (lwsg-terminal emitted) ack
            prediction plan time-state observed started ordinal 271 9)))

; A bounded trampoline keeps every non-recursive stage source-order-safe.  The
; only recursive call is lwsg-walk calling itself after an explicit CONTINUE
; cell; full source compilation therefore needs no forward function resolve.
(defn lwsg-continue
    (context visited reverse-turns rendered ordinal)
    (intern_node LWSG-CONTINUE
        (list context visited reverse-turns
              (intern_trivial_string rendered)
              (intern_trivial_int ordinal) (lwo-local-path))))
(defn lwsg-continue? (cell)
    (if (and (eq (lwo-category? cell LWSG-CONTINUE) 1)
             (eq (len (node_children cell)) 6)) 1 0))
(defn lwsg-continue-context (step) (nth (node_children step) 0))
(defn lwsg-continue-visited (step) (nth (node_children step) 1))
(defn lwsg-continue-turns (step) (nth (node_children step) 2))
(defn lwsg-continue-rendered (step)
    (node_value (nth (node_children step) 3)))
(defn lwsg-continue-ordinal (step)
    (node_value (nth (node_children step) 4)))

(defn lwsg-step-voiced
    (request context visited reverse-turns rendered time-state observed
     started ordinal prediction plan next surface)
    (do
        (let emitted (lwsg-next-emitted next))
        (let successor (lwsg-next-context next))
        (let turn
            (lwsg-turn context prediction plan next surface emitted successor))
        (let turns (cons turn reverse-turns))
        (let text (str_concat rendered (lwtx-surface-text surface)))
        (let modified
            (lwsg-frame observed "modify"
                (lwsg-progress-target turns (oac-one surface) text)
                (add ordinal 1) started 305 13))
        (if (node_eq successor (lwo-none))
            (lwsg-stop-terminal request prediction plan emitted turns text
                time-state observed started (add ordinal 2))
            (lwsg-continue successor (cons context visited) turns text
                (add ordinal 2)))))

(defn lwsg-step-unique
    (world request context visited reverse-turns rendered time-state observed
     started ordinal prediction)
    (do
        (let next (oac-payload (lwtf-prediction-ack prediction)))
        (let plan
            (lwtx-plan-for world prediction (lwsf-current-symbols world)))
        (let ack
            (if (node_eq plan (lwo-none)) (oac-nothing)
                (lwtx-plan-ack plan)))
        (if (eq (oac-one? ack) 0)
            (lwsg-stop-voice request prediction plan next reverse-turns
                rendered time-state observed started (add ordinal 1))
            (lwsg-step-voiced request context visited reverse-turns rendered
                time-state observed started ordinal prediction plan next
                (oac-payload ack)))))

(defn lwsg-step-prediction
    (world request context visited reverse-turns rendered time-state observed
     started ordinal prediction)
    (if (eq (oac-one? (lwtf-prediction-ack prediction)) 0)
        (lwsg-stop-prediction request prediction reverse-turns rendered
            time-state observed started (add ordinal 1))
        (lwsg-step-unique world request context visited reverse-turns rendered
            time-state observed started ordinal prediction)))

(defn lwsg-step
    (world request context visited reverse-turns rendered time-state observed
     started ordinal)
    (if (eq (lwsg-horizon-reached? request (len reverse-turns)) 1)
        (lwsg-stop-horizon request reverse-turns rendered time-state observed
            started (add ordinal 1))
        (if (eq (lwsg-context-member? context visited) 1)
            (lwsg-stop-cycle request context reverse-turns rendered time-state
                observed started (add ordinal 1))
            (lwsg-step-prediction world request context visited reverse-turns
                rendered time-state observed started ordinal
                (lwtf-predict world context
                    (lwsg-request-alternatives request)
                    (lwsg-request-unknown request))))))

(defn lwsg-walk
    (world request context visited reverse-turns rendered time-state
     observed started ordinal)
    (do
        (let entered
            (lwsg-frame observed "enter"
                (lcfb-cat (list
                    "turn:" (int_to_str (len reverse-turns))
                    ":visited:" (int_to_str (len visited))))
                ordinal started 360 13))
        (let step
            (lwsg-step world request context visited reverse-turns rendered
                time-state observed started ordinal))
        (if (eq (lwsg-continue? step) 0) step
            (lwsg-walk world request
                (lwsg-continue-context step)
                (lwsg-continue-visited step)
                (lwsg-continue-turns step)
                (lwsg-continue-rendered step)
                time-state observed started
                (lwsg-continue-ordinal step)))))

(defn lwsg-generate-with-observation (world request observed started ordinal)
    (if (eq (lwsg-request-valid? request) 0) (lwo-none)
        (do
            (let time-state (lwsg-time-state request))
            (if (eq (lwsg-time-expired? time-state) 1)
                (do
                    (let ack (oac-time-outcome-ack time-state))
                    (let left (lwsg-frame observed "leave"
                        (lwsg-progress-target (empty) ack "") ordinal started
                        384 31))
                    (lwsg-finish request (empty) ""
                        (lwsg-timed time-state) ack (lwo-none) (lwo-none)
                        time-state))
                (lwsg-walk world request (lwsg-request-context request)
                    (empty) (empty) "" time-state observed started ordinal)))))

(defn lwsg-generate (world request)
    (lwsg-generate-with-observation world request 0 0 0))
(defn lwsg-generate-observed (world request started ordinal)
    (lwsg-generate-with-observation world request 1 started ordinal))
(defn lwsg-trace-current? (world trace)
    (if (eq (lwsg-trace? trace) 0) 0
        (if (node_eq trace
                (lwsg-generate world (lwsg-trace-request trace))) 1 0)))

0
