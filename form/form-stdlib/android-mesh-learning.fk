// android-mesh-learning.fk - Mac + Android physical senses as native learning rows.
//
// Floor: a connected Android phone and Mac host are represented as organs with
// typed channels, high-cost feature routes, stream-merge helpers, and
// champion/challenger oracle-retirement decisions. This is the deterministic
// recipe shape used by the physical adb receipt script.
//
// North star: Mac and Android run the receipt loop continuously, feeding sensor,
// audio, video, host, GPU, and model receipts into Form-native learners. External
// LLM/model/compiler oracles become sampled teachers until native recipes win per
// category and retire them.
//
// Proven by: form-stdlib/tests/android-mesh-learning-band.fk
section [form.bml] {
    def aml-floor() = ["android and mac organs have typed learning channels", "high-cost LLM-like features route native-first when quality/trust/cost gates pass", "third-party oracles retire through the existing champion/challenger long-window gate"];
    def aml-north-star() = ["24/7 mac plus android receipts feed native learners across sensor audio video host gpu and model lanes", "external model/compiler/media oracles are sampled teachers, not hidden authority", "native Form recipes win on quality cost trust sovereignty vitality and measured heldout proof"];
    def aml-organ(name, kind, surface, status, trust) = [name, kind, surface, status, trust];
    def aml-organ-name(organ) = organ[0];
    def aml-organ-kind(organ) = organ[1];
    def aml-organ-surface(organ) = organ[2];
    def aml-organ-status(organ) = organ[3];
    def aml-organ-trust(organ) = organ[4];
    def aml-channel(from, to, protocol, codec, sample-rate, native-ready, oracle-pressure) = [from, to, protocol, codec, sample-rate, native-ready, oracle-pressure];
    def aml-channel-from(channel) = channel[0];
    def aml-channel-to(channel) = channel[1];
    def aml-channel-protocol(channel) = channel[2];
    def aml-channel-codec(channel) = channel[3];
    def aml-channel-sample-rate(channel) = channel[4];
    def aml-channel-native-ready?(channel) = channel[5];
    def aml-channel-oracle-pressure(channel) = channel[6];
    def aml-android-organ() = aml-organ("android-phone", "android-phone", "adb+coherence-sense", "physical-device", 80);
    def aml-mac-organ() = aml-organ("macos-binary", "macos-binary", "launchagent+form-kernel", "host-witness", 82);
    def aml-channels() = [aml-channel("android-phone", "macos-binary", "sensor:signal", "json:int-vector", 60, 1, "low"), aml-channel("android-phone", "macos-binary", "audio:pcm16", "pcm16", 16000, 0, "medium"), aml-channel("android-phone", "macos-binary", "video:rgba-time", "rgba-frame", 30, 0, "high"), aml-channel("android-phone", "macos-binary", "gpu:compute", "tensor-buffer", 0, 0, "medium"), aml-channel("macos-binary", "android-phone", "hati.mesh:presence", "json", 1, 1, "low")];
    def aml-ready-channel-count(channels) = (Comparable) len(channels) == 0 ? 0 : ((Comparable) aml-channel-native-ready?(head(channels)) == 1 ? 1 : 0) + aml-ready-channel-count(tail(channels));
    def aml-protocol-known?(channels, protocol) = (Comparable) len(channels) == 0 ? 0 : (String) aml-channel-protocol(head(channels)) == protocol ? 1 : aml-protocol-known?(tail(channels), protocol);
    def aml-high-cost-features() = ["summarize", "generate", "critique", "dialogue", "memory-update", "tool-select", "tool-execute", "code-lower", "cite-ground", "speech-transcribe", "vision-describe", "multimodal-align", "distill-retire"];
    def aml-known-feature-count(names) = (Comparable) len(names) == 0 ? 0 : lfcf-known?(head(names)) + aml-known-feature-count(tail(names));
    def aml-native-first?(feature, observed-quality, native-cost, oracle-cost, trust) = (Comparable) lfcf-known?(feature) == 1 && (observed-quality >= lfcf-metric-floor(lfcf-channel-by-name(feature)) && (native-cost < oracle-cost && trust >= 70)) ? 1 : 0;
    def aml-route-choice(feature, observed-quality, native-cost, oracle-cost, trust) = (Comparable) aml-native-first?(feature, observed-quality, native-cost, oracle-cost, trust) == 1 ? "native-first" : (Comparable) lfcf-known?(feature) == 1 && (observed-quality >= 70 && native-cost < oracle-cost) ? "native-first-sample-oracle" : "oracle-teacher-until-physical-samples";
    def aml-active-sample(lane, protocol, codec, count, metric, trust, privacy, active) = [lane, protocol, codec, count, metric, trust, privacy, active];
    def aml-sample-lane(sample) = sample[0];
    def aml-sample-protocol(sample) = sample[1];
    def aml-sample-codec(sample) = sample[2];
    def aml-sample-count(sample) = sample[3];
    def aml-sample-metric(sample) = sample[4];
    def aml-sample-trust(sample) = sample[5];
    def aml-sample-privacy(sample) = sample[6];
    def aml-sample-active?(sample) = sample[7];
    def aml-mic-rms-sample(count, rms) = aml-active-sample("mic", "audio:pcm16", "rms-summary", count, rms, 78, "summary-only/no-raw-audio", 1);
    def aml-camera-luma-sample(count, luma) = aml-active-sample("camera", "video:rgba-time", "luma-summary", count, luma, 76, "summary-only/no-frame", 1);
    def aml-gpu-readback-sample(count, latency-ms) = aml-active-sample("gpu", "gpu:compute", "egl-readback-summary", count, latency-ms, 74, "summary-only/no-buffer", 1);
    def aml-active-sample-valid?(sample) = (Comparable) aml-sample-active?(sample) == 1 && (aml-sample-count(sample) > 0 && (aml-sample-trust(sample) > 0 && !((String) aml-sample-privacy(sample) == ""))) ? 1 : 0;
    def aml-active-lane-count(samples) = (Comparable) len(samples) == 0 ? 0 : aml-active-sample-valid?(head(samples)) + aml-active-lane-count(tail(samples));
    def aml-has-active-lane?(samples, lane) = (Comparable) len(samples) == 0 ? 0 : (String) aml-sample-lane(head(samples)) == lane && (Comparable) aml-active-sample-valid?(head(samples)) == 1 ? 1 : aml-has-active-lane?(tail(samples), lane);
    def aml-all-summary-only?(samples) = (Comparable) len(samples) == 0 ? 1 : !((String) aml-sample-privacy(head(samples)) == "") && (Comparable) aml-active-sample-valid?(head(samples)) == 1 ? aml-all-summary-only?(tail(samples)) : 0;
    def aml-active-media-floor?(samples) = (Comparable) aml-has-active-lane?(samples, "mic") == 1 && ((Comparable) aml-has-active-lane?(samples, "camera") == 1 && (Comparable) aml-has-active-lane?(samples, "gpu") == 1) ? 1 : 0;
    def aml-active-route-choice(feature, samples, native-cost, oracle-cost, trust) = (String) feature == "speech-transcribe" ? (Comparable) aml-has-active-lane?(samples, "mic") == 1 ? aml-route-choice(feature, 82, native-cost, oracle-cost, trust) : aml-route-choice(feature, 72, native-cost, oracle-cost, trust) : (String) feature == "vision-describe" ? (Comparable) aml-has-active-lane?(samples, "camera") == 1 ? aml-route-choice(feature, 82, native-cost, oracle-cost, trust) : aml-route-choice(feature, 72, native-cost, oracle-cost, trust) : (String) feature == "multimodal-align" ? (Comparable) aml-active-media-floor?(samples) == 1 ? aml-route-choice(feature, 84, native-cost, oracle-cost, trust) : aml-route-choice(feature, 76, native-cost, oracle-cost, trust) : aml-route-choice(feature, 80, native-cost, oracle-cost, trust);
    def aml-retire?(history, min-samples, margin) = clr-retire?(history, min-samples, margin);
    def aml-authority(history, min-samples, margin) = clr-authority(history, min-samples, margin);
    def aml-merged-breadth(stream-a, stream-b) = cls-merged-breadth(stream-a, stream-b);
    def aml-24-7-ready?(android-present, mac-present, app-running, witness-running) = (Comparable) android-present == 1 && ((Comparable) mac-present == 1 && ((Comparable) app-running == 1 && (Comparable) witness-running == 1)) ? 1 : 0;
    def aml-capability-receipt(android-present, app-installed, app-running, mac-present, witness-running, sensor-count, camera, microphone, wifi, bluetooth-le, vulkan-compute) = [android-present, app-installed, app-running, mac-present, witness-running, sensor-count, camera, microphone, wifi, bluetooth-le, vulkan-compute];
    def aml-cap-android-present?(row) = row[0];
    def aml-cap-app-installed?(row) = row[1];
    def aml-cap-app-running?(row) = row[2];
    def aml-cap-mac-present?(row) = row[3];
    def aml-cap-witness-running?(row) = row[4];
    def aml-cap-sensor-count(row) = row[5];
    def aml-cap-camera?(row) = row[6];
    def aml-cap-microphone?(row) = row[7];
    def aml-cap-wifi?(row) = row[8];
    def aml-cap-bluetooth-le?(row) = row[9];
    def aml-cap-vulkan-compute?(row) = row[10];
    def aml-capability-floor?(row) = (Comparable) aml-cap-android-present?(row) == 1 && ((Comparable) aml-cap-mac-present?(row) == 1 && ((Comparable) aml-cap-app-installed?(row) == 1 && (aml-cap-sensor-count(row) >= 3 && ((Comparable) aml-cap-camera?(row) == 1 && ((Comparable) aml-cap-microphone?(row) == 1 && ((Comparable) aml-cap-wifi?(row) == 1 && (Comparable) aml-cap-bluetooth-le?(row) == 1)))))) ? 1 : 0;
    def aml-capability-learning-ready?(row) = (Comparable) aml-capability-floor?(row) == 1 && ((Comparable) aml-cap-app-running?(row) == 1 && (Comparable) aml-cap-witness-running?(row) == 1) ? 1 : 0;
    def aml-floor-proven?() = (Comparable) aml-protocol-known?(aml-channels(), "sensor:signal") == 1 && ((Comparable) aml-protocol-known?(aml-channels(), "hati.mesh:presence") == 1 && (aml-ready-channel-count(aml-channels()) >= 2 && (Comparable) aml-known-feature-count(aml-high-cost-features()) == 13)) ? 1 : 0;
    0;
}
