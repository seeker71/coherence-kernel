//////////////////////////////////////////////////////////////////////
//
// mirror-census.bml — which of a native's mirrors still stand.
//
// Authority: form/form-stdlib/mirror-census.bml
// preludes: form/form-stdlib/core.fk
// Proven by: form-stdlib/tests/mirror-census-band.fk
// Read live by: observe/mirror-census-run.fk
//
// The bearing census weighs each door and answers WHICH DOOR IS NEXT. It
// cannot answer whether a door is reachable, because a lens that weighs sees
// weight, never reach (corpus row 1358, limbkept). On 2026-09-08 that gap cost
// a day: `str_find`'s C arm had stood complete in the seed since before it was
// named, and so had its serializer arm and the three siblings' — only the op
// table row had gone, on 2026-07-01, and with the row gone there was no path
// from any call site. The body walked a recipe at 10 MB/s past a native that
// ran at 660, the bearing census called it a wall, and the remedy it asked for
// was to mint a thing that already existed.
//
// A native in this body does not stand on one thing. It stands on several
// mirrors at once, and each mirror answers a different question:
//
//   manifest  the declared surface (native-op-manifest.fk) — name, arity, TAG,
//             dispatch class. This is the only mirror that carries name -> tag
//             when the op table has lost the name, so it is the anchor: without
//             it an orphaned arm has no name and cannot be reported as one.
//   flt-ops   the hand-maintained generator source (flatten/form-flatten.fk).
//             The op table is generated FROM it, so a name here and not there
//             is a stale regen, not a missing native.
//   row       the generated op table's fk_optab (fkwu-optable.h) — THE ROUTE. A
//             call site resolves through this row and nothing else. No row, no
//             reach, however complete everything beneath it is.
//   arm       the walker's own arm (fkwu-uni.c), found by TAG, because that is
//             how the walker dispatches: `if (t == 30)`.
//   fkc       the serializer's arm (fkc-table-serialize.fk), also by tag. An op
//             without one falls to the binary fallback and flattens at the
//             wrong arity — the manifest names node_at and method_define as two
//             that missed exactly this mirror.
//   rw        the SECOND table in that same header, fk_rwtab: names reached as
//             compiled rewrites rather than as tagged arms. `substring` has
//             lived there the whole time. Its third number is a program length
//             and not a tag, so reading the two tables as one vouches for
//             routes that do not exist.
//   go rust ts  the three proof siblings' registrations, by name.
//   jit       the Go JIT's emitter arms (jit.go, `name == "..."`).
//   abi       the JIT's other name surface in the same file: the function that
//             decides whether a recipe containing a call needs the value ABI.
//             jit.go decides twice about every name, and jitabi.go's Go function
//             is a third copy reached from the emitter by symbol — so the Go
//             compiler is that copy's own band, and a missing one cannot build.
//
// The reading this cell exists for is the DISAGREEMENT between mirrors, and the
// wounds are not one kind. Ranked by what each costs:
//
//   armhush     an arm stands and no row names it. The body cannot reach a
//               native it already has, and pays a recipe for it. str_find's
//               exact shape. First because the cost is silent and daily.
//   seedgap     all three siblings hold the native and the seed has no route at
//               all — no row, no rewrite. The reading that says GO LOOK IN THE
//               SEED BEFORE MINTING, and the only one that could have named
//               str_find on the tree that had the wound: every mirror carrying
//               its NAME had gone, so no tag was left to find its arm by.
//   tagclash    a name whose own row gives a different tag than its declared
//               one, or a name with no row whose declared tag belongs to
//               somebody else. Worse than armhush to repair BLIND: restoring
//               the row from that coordinate routes a call to a stranger's arm.
//               Two names on ONE tag with both rows present is an ALIAS, not
//               this — add/_plus live that way on purpose.
//   rowhush     a row stands and no arm answers its tag. A call that resolves
//               and finds nothing.
//   fkcgap      an arm with no serializer arm, where the ARITY owes one —
//               unary, ternary and nullary do; only binary rides the fallback.
//   siblinggap  a seed native (row and arm) some siblings hold and others do
//               not. Not the same as fkwu-only: an organ NO sibling carries
//               (the sense family, `nothing`) is an honest floor, and this cell
//               says so rather than reporting 150 host doors as wounds.
//   jitsplit    a name in the JIT's emitter arms or its value-ABI list, not
//               both. A primitive that lives twice reverts silently in hot code
//               when only one copy is healed.
//   siblinglone the softer sibling reading: one or two siblings, no seed row
//               behind it. Divergence among the arms alone, as often young as
//               wounded.
//   manifestgap a row with no declared row behind it: the generated surface has
//               outrun the authority that is supposed to produce it.
//
// And three ways to be well, because a lens that only names wounds teaches the
// reader to distrust it: `whole`, `rewrite` (reached through fk_rwtab, no arm
// owed), and `no-native-here` — no mirror carries this name, which is a fact
// about the name and not a wound in the body.
//
// What this cell does NOT claim. It reads text, not C. The arm mirror is the
// walker's literal comparison forms — `(t == N)`, `(tag == N)`, `(ks_k == N)` —
// so an arm reached some other way would read as missing, and a comparison
// against a tag-shaped number that is not a dispatch would read as an arm. It
// does not rank a native as "the JIT ought to carry this": nothing in this tree
// declares which natives it ought to carry, so that ranking would be the lens's
// opinion wearing a measurement's clothes. It is a reading of the mirrors,
// offered as a reading; where it says a mirror is missing, the repair is to go
// look. A tag-keyed mirror asked about a name with no tag anywhere answers
// MCSUnread (-1), never 0 — the same honesty the bearing census keeps about an
// unmeasured door, and the reason `arm ?` on a seedgap name is a truthful
// "I have not looked" rather than a confident absence.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class MirrorCensusAuthority {
        field MCSAuthorityPath = "form/form-stdlib/mirror-census.bml";
        field MCSAuthorityKind = "high-bml-interface-class-const";
    }

    class MirrorCensus {
        field MCSSensor = "mirror";
        field MCSCadenceMs = 15000;
        field MCSUnread = -1;
        field MCSNoTag = -1;
        field MCSTopN = 24;
        field MCSIntBudget = 8;
        ref mcs-authority = MirrorCensusAuthority;
        thought mcs-pattern = list("a-row-is-the-only-route", "an-arm-without-a-row-is-a-native-nobody-can-call", "a-tag-keyed-mirror-needs-a-tag-or-it-says-unread", "fkwu-only-is-a-floor-half-the-siblings-is-a-bug", "the-lens-reads-text-and-says-so");

        // --- where each mirror lives -------------------------------------------
        // Every path is named once, here, so no reader of this cell has to hold
        // a file location in their head and no second cell can drift from it.
        def mcs-path-manifest() = "form/form-stdlib/native-op-manifest.fk";
        def mcs-path-fltops() = "flatten/form-flatten.fk";
        def mcs-path-row() = "runtime/fkwu-optable.h";
        def mcs-path-arm() = "runtime/fkwu-uni.c";
        def mcs-path-fkc() = "form/form-stdlib/fkc-table-serialize.fk";
        def mcs-path-go() = "form/form-kernel-go/main.go";
        def mcs-path-rust() = "form/form-kernel-rust/src/main.rs";
        def mcs-path-ts() = "form/form-kernel-ts/src/kernel.ts";
        def mcs-path-jit() = "form/form-kernel-go/jit.go";

        // --- byte helpers -------------------------------------------------------
        def mcs-q() = byte_to_str(34);
        def mcs-digit?(b) = if and(ge(b, 48), le(b, 57)) then 1 else 0;
        def mcs-digits-end(s, i) = if ge(i, str_len(s)) then i else if eq(mcs-digit?(str_byte_at(s, i)), 1) then mcs-digits-end(s, add(i, 1)) else i;
        // the next digit run within a short budget of bytes: a row's arity sits a
        // comma or a space away, never a paragraph, so a runaway scan is refused
        def mcs-next-digit(s, i, budget) = if le(budget, 0) then MCSUnread() else if ge(i, str_len(s)) then MCSUnread() else if eq(mcs-digit?(str_byte_at(s, i)), 1) then i else mcs-next-digit(s, add(i, 1), sub(budget, 1));
        def mcs-int-go(s, i, e, acc) = if ge(i, e) then acc else mcs-int-go(s, add(i, 1), e, add(mul(acc, 10), sub(str_byte_at(s, i), 48)));
        def mcs-int-at(s, i) = if lt(i, 0) then MCSUnread() else mcs-int-go(s, i, mcs-digits-end(s, i), 0);
        // read the int that follows position i, and answer where it ended, so the
        // next field is read from where the last one stopped and never re-scanned
        def mcs-field(s, i) = mcs-field-at(s, mcs-next-digit(s, i, MCSIntBudget()));
        def mcs-field-at(s, d) = if lt(d, 0) then list(MCSUnread(), MCSUnread()) else list(mcs-int-at(s, d), mcs-digits-end(s, d));

        // --- the generic name lift ----------------------------------------------
        // Every name-keyed mirror registers its names the same way in text: a
        // marker ending at an opening quote, then the name, then a quote. One
        // forward pass lifts them all; str_find resumes from where it stopped, so
        // the whole pass costs one walk of the file and not one per name.
        def mcs-names-go(text, marker, from, acc) = mcs-names-at(text, marker, str_find(text, marker, from), acc);
        def mcs-names-at(text, marker, at, acc) = if lt(at, 0) then acc else mcs-names-open(text, marker, add(at, str_len(marker)), acc);
        def mcs-names-open(text, marker, i, acc) = mcs-names-take(text, marker, i, str_find(text, mcs-q(), i), acc);
        def mcs-names-take(text, marker, i, close, acc) = if lt(close, 0) then acc else mcs-names-go(text, marker, add(close, 1), cons(substring(text, i, close), acc));
        def mcs-names(text, marker) = mcs-names-go(text, marker, 0, list());

        // --- the generic tag lift ------------------------------------------------
        // A tag-keyed mirror dispatches on a number, so what is lifted is the set
        // of numbers it dispatches on. The marker carries its own opening paren
        // (`(t == `), which is what keeps `first == 3)` from reading as tag 3.
        def mcs-tags-go(text, marker, from, acc) = mcs-tags-at(text, marker, str_find(text, marker, from), acc);
        def mcs-tags-at(text, marker, at, acc) = if lt(at, 0) then acc else mcs-tags-take(text, marker, add(at, str_len(marker)), acc);
        def mcs-tags-take(text, marker, i, acc) = mcs-tags-num(text, marker, i, mcs-digits-end(text, i), acc);
        def mcs-tags-num(text, marker, i, e, acc) = if le(e, i) then mcs-tags-go(text, marker, add(i, 1), acc) else mcs-tags-go(text, marker, e, cons(mcs-int-go(text, i, e, 0), acc));
        def mcs-tags(text, marker) = mcs-tags-go(text, marker, 0, list());

        // --- the row lifts (name arity tag class) --------------------------------
        // Both row mirrors carry the same four readings in two spellings —
        // `(nom-row "str_find" 3 30 "tri")` and `{ "str_find", 3, 30 }` — so the
        // separators are stepped over rather than spelled, and one walker reads
        // both. The class is the manifest's alone; the op table answers "".
        def mcs-open-manifest() = str_concat("(nom-row ", mcs-q());
        def mcs-open-row() = str_concat("{ ", mcs-q());
        def mcs-open-fltops() = str_concat("(list ", mcs-q());
        def mcs-open-go() = str_concat("registerNative(", mcs-q());
        def mcs-open-rust() = str_concat("register_native(", mcs-q());
        def mcs-open-jit() = str_concat("name == ", mcs-q());
        def mcs-marker-arm-t() = "(t == ";
        def mcs-marker-arm-tag() = "(tag == ";
        def mcs-marker-arm-ks() = "(ks_k == ";
        def mcs-marker-fkc() = "(fk-tag n) ";

        def mcs-class-at(text, i) = mcs-class-open(text, str_find(text, mcs-q(), i));
        def mcs-class-open(text, o) = if lt(o, 0) then "" else mcs-class-take(text, add(o, 1), str_find(text, mcs-q(), add(o, 1)));
        def mcs-class-take(text, i, close) = if lt(close, 0) then "" else substring(text, i, close);
        // a class is only a class when it sits on the same row: a quote a long way
        // off is the next row's name, so the reach is bounded to a short field
        def mcs-class-near(text, i) = if lt(str_find(text, mcs-q(), i), 0) then "" else if gt(sub(str_find(text, mcs-q(), i), i), MCSIntBudget()) then "" else mcs-class-at(text, i);

        def mcs-rows-go(text, marker, wantclass, from, acc) = mcs-rows-at(text, marker, wantclass, str_find(text, marker, from), acc);
        def mcs-rows-at(text, marker, wantclass, at, acc) = if lt(at, 0) then acc else mcs-rows-name(text, marker, wantclass, add(at, str_len(marker)), acc);
        def mcs-rows-name(text, marker, wantclass, i, acc) = mcs-rows-close(text, marker, wantclass, i, str_find(text, mcs-q(), i), acc);
        def mcs-rows-close(text, marker, wantclass, i, close, acc) = if lt(close, 0) then acc else mcs-rows-arity(text, marker, wantclass, substring(text, i, close), add(close, 1), acc);
        def mcs-rows-arity(text, marker, wantclass, nm, i, acc) = mcs-rows-tag(text, marker, wantclass, nm, mcs-field(text, i), acc);
        def mcs-rows-tag(text, marker, wantclass, nm, ar, acc) = mcs-rows-emit(text, marker, wantclass, nm, nth(ar, 0), mcs-field(text, nth(ar, 1)), acc);
        def mcs-rows-emit(text, marker, wantclass, nm, arity, tg, acc) = mcs-rows-go(text, marker, wantclass, nth(tg, 1), cons(list(nm, arity, nth(tg, 0), if eq(wantclass, 1) then mcs-class-near(text, nth(tg, 1)) else ""), acc));
        def mcs-rows(text, marker, wantclass) = mcs-rows-go(text, marker, wantclass, 0, list());

        // --- windows -----------------------------------------------------------------
        // Two of these files carry more than one table in the same spelling, and the
        // difference is not cosmetic. `runtime/fkwu-optable.h` holds fk_optab — the
        // natives, (name arity TAG) — and then fk_rwtab, the REWRITES, whose third
        // number is a program length and not a tag at all. Read together, `substring`
        // reads as a native at tag 14, an arm answers at 14, and the lens vouches for
        // a route that does not exist. Found by building this cell, which is the only
        // way anyone finds it: a table you have never had to tell apart looks like one
        // table. So each is read inside its own window, and the second is a mirror of
        // its own — a name reached by a rewrite IS reached, just not by an arm.
        //
        // A window is not a parser. It is where the reader would put their thumb.
        def mcs-window(text, open, close) = mcs-window-from(text, close, str_find(text, open, 0));
        def mcs-window-from(text, close, at) = if lt(at, 0) then "" else mcs-window-to(text, at, str_find(text, close, add(at, 1)));
        def mcs-window-to(text, at, end) = if lt(end, 0) then substring(text, at, str_len(text)) else substring(text, at, end);
        def mcs-nl() = byte_to_str(10);
        def mcs-window-optab(text) = mcs-window(text, "fk_optab[] = {", str_concat(mcs-nl(), "};"));
        def mcs-window-rwtab(text) = mcs-window(text, "fk_rwtab[] = {", str_concat(mcs-nl(), "};"));
        def mcs-fltops-window(text) = mcs-window(text, "(defn flt-ops ()", str_concat(mcs-nl(), "(defn "));
        // the JIT's second name surface: the function that decides whether a recipe
        // containing a call needs the value ABI at all. Its whole body carries no
        // quoted string but the names, so inside the window a bare quote is the marker.
        def mcs-window-abi(text) = mcs-window(text, str_concat(mcs-nl(), "func jitRecipeNeedsValueABI"), str_concat(mcs-nl(), "}"));

        // --- the whole mirror bundle ----------------------------------------------
        // Nine readings, held as one value, so every judgement below is arithmetic
        // over data a band can write by hand and no judgement reaches for a file.
        def mcs-bundle(manrows, fltnames, rowrows, armtags, fkctags, gonames, rustnames, tsnames, jitnames, rwnames, abinames) = list(manrows, fltnames, rowrows, armtags, fkctags, gonames, rustnames, tsnames, jitnames, rwnames, abinames);
        def mcs-b-manifest(b) = nth(b, 0);
        def mcs-b-fltops(b) = nth(b, 1);
        def mcs-b-row(b) = nth(b, 2);
        def mcs-b-armtags(b) = nth(b, 3);
        def mcs-b-fkctags(b) = nth(b, 4);
        def mcs-b-go(b) = nth(b, 5);
        def mcs-b-rust(b) = nth(b, 6);
        def mcs-b-ts(b) = nth(b, 7);
        def mcs-b-jit(b) = nth(b, 8);
        def mcs-b-rw(b) = nth(b, 9);
        def mcs-b-abi(b) = nth(b, 10);

        def mcs-read-file(path) = if lt(file_size(path), 0) then "" else read_file(path);
        // A root prefix, because the reading is of a TREE and not of this process. The
        // lens reads a tree it is not running in — an older checkout,
        // a sibling's worktree — and the reason is not convenience. `str_find` is one
        // of the natives this cell searches with, so on the tree that had lost its row
        // the lens cannot run AT ALL: the wound disables the tool that finds it. A body
        // cannot always read a wound with the body that has it. It can read the text
        // with a body that is well, and that is what a root is for.
        def mcs-at(root, path) = if eq(str_len(root), 0) then path else str_concat(root, str_concat("/", path));
        def mcs-live() = mcs-live-at("");
        def mcs-live-at(root) = mcs-live-with(root, mcs-read-file(mcs-at(root, mcs-path-arm())), mcs-read-file(mcs-at(root, mcs-path-row())), mcs-read-file(mcs-at(root, mcs-path-jit())));
        // each file is opened once and its text handed on, so a mirror read for ten
        // names costs one read and not ten
        def mcs-live-with(root, armtext, rowtext, jittext) = mcs-bundle(mcs-rows(mcs-read-file(mcs-at(root, mcs-path-manifest())), mcs-open-manifest(), 1), mcs-names(mcs-fltops-window(mcs-read-file(mcs-at(root, mcs-path-fltops()))), mcs-open-fltops()), mcs-rows(mcs-window-optab(rowtext), mcs-open-row(), 0), mcs-arm-tags(armtext), mcs-tags(mcs-read-file(mcs-at(root, mcs-path-fkc())), mcs-marker-fkc()), mcs-names(mcs-read-file(mcs-at(root, mcs-path-go())), mcs-open-go()), mcs-names(mcs-read-file(mcs-at(root, mcs-path-rust())), mcs-open-rust()), mcs-names(mcs-read-file(mcs-at(root, mcs-path-ts())), mcs-open-go()), mcs-names(jittext, mcs-open-jit()), mcs-names(mcs-window-rwtab(rowtext), mcs-open-row()), mcs-names(mcs-window-abi(jittext), mcs-q()));
        // the walker dispatches under three variable names in the seed; all three
        // are one mirror, because a call reaching any of them has been answered
        def mcs-arm-tags(armtext) = append(mcs-tags(armtext, mcs-marker-arm-t()), append(mcs-tags(armtext, mcs-marker-arm-tag()), mcs-tags(armtext, mcs-marker-arm-ks())));

        // --- membership -----------------------------------------------------------
        def mcs-in?(names, n) = if eq(len(names), 0) then 0 else if str_eq(head(names), n) then 1 else mcs-in?(tail(names), n);
        def mcs-tag-in?(tags, t) = if lt(t, 0) then 0 else if eq(len(tags), 0) then 0 else if eq(head(tags), t) then 1 else mcs-tag-in?(tail(tags), t);
        def mcs-row-of(rows, n) = if eq(len(rows), 0) then list() else if str_eq(nth(head(rows), 0), n) then head(rows) else mcs-row-of(tail(rows), n);
        def mcs-row-name-at(rows, t) = if eq(len(rows), 0) then "" else if eq(nth(head(rows), 2), t) then nth(head(rows), 0) else mcs-row-name-at(tail(rows), t);
        def mcs-row-names(rows) = if eq(len(rows), 0) then list() else cons(nth(head(rows), 0), mcs-row-names(tail(rows)));
        def mcs-has-row?(rows, n) = if eq(len(mcs-row-of(rows, n)), 0) then 0 else 1;
        def mcs-tag-of(rows, n) = if eq(mcs-has-row?(rows, n), 0) then MCSNoTag() else nth(mcs-row-of(rows, n), 2);
        def mcs-arity-of(rows, n) = if eq(mcs-has-row?(rows, n), 0) then MCSNoTag() else nth(mcs-row-of(rows, n), 1);
        def mcs-class-of(rows, n) = if eq(mcs-has-row?(rows, n), 0) then "" else nth(mcs-row-of(rows, n), 3);

        // --- one name's reading ----------------------------------------------------
        // The tag is the manifest's when it has one, the op table's otherwise. That
        // ORDER is the whole point: on the tree as it stood before the restoration
        // the op table had no str_find at all, so only the declared surface could
        // still say tag 30 and let the arm be found and named.
        def mcs-tag(b, n) = if lt(mcs-tag-of(mcs-b-manifest(b), n), 0) then mcs-tag-of(mcs-b-row(b), n) else mcs-tag-of(mcs-b-manifest(b), n);
        def mcs-arity(b, n) = if lt(mcs-arity-of(mcs-b-manifest(b), n), 0) then mcs-arity-of(mcs-b-row(b), n) else mcs-arity-of(mcs-b-manifest(b), n);
        def mcs-class(b, n) = mcs-class-of(mcs-b-manifest(b), n);
        // a tag-keyed mirror asked about a name with no tag cannot answer 0; it has
        // not looked, and unread is the only honest word for that
        def mcs-tagged?(b, n, tags) = if lt(mcs-tag(b, n), 0) then MCSUnread() else mcs-tag-in?(tags, mcs-tag(b, n));
        def mcs-m-manifest(b, n) = mcs-has-row?(mcs-b-manifest(b), n);
        def mcs-m-fltops(b, n) = mcs-in?(mcs-b-fltops(b), n);
        def mcs-m-row(b, n) = mcs-has-row?(mcs-b-row(b), n);
        def mcs-m-arm(b, n) = mcs-tagged?(b, n, mcs-b-armtags(b));
        def mcs-m-fkc(b, n) = mcs-tagged?(b, n, mcs-b-fkctags(b));
        def mcs-m-go(b, n) = mcs-in?(mcs-b-go(b), n);
        def mcs-m-rust(b, n) = mcs-in?(mcs-b-rust(b), n);
        def mcs-m-ts(b, n) = mcs-in?(mcs-b-ts(b), n);
        def mcs-m-jit(b, n) = mcs-in?(mcs-b-jit(b), n);
        def mcs-m-rw(b, n) = mcs-in?(mcs-b-rw(b), n);
        def mcs-m-abi(b, n) = mcs-in?(mcs-b-abi(b), n);
        def mcs-mirrors(b, n) = list(mcs-m-manifest(b, n), mcs-m-fltops(b, n), mcs-m-row(b, n), mcs-m-arm(b, n), mcs-m-fkc(b, n), mcs-m-rw(b, n), mcs-m-go(b, n), mcs-m-rust(b, n), mcs-m-ts(b, n), mcs-m-jit(b, n), mcs-m-abi(b, n));
        def mcs-mirror-names() = list("manifest", "flt-ops", "row", "arm", "fkc", "rw", "go", "rust", "ts", "jit", "abi");
        def mcs-known?(b, n) = if gt(add(add(mcs-m-manifest(b, n), mcs-m-row(b, n)), add(add(mcs-m-go(b, n), mcs-m-rust(b, n)), add(add(mcs-m-ts(b, n), mcs-m-fltops(b, n)), mcs-m-rw(b, n)))), 0) then 1 else 0;

        // --- the seven wounds -------------------------------------------------------
        def mcs-siblings(b, n) = add(mcs-m-go(b, n), add(mcs-m-rust(b, n), mcs-m-ts(b, n)));
        // an arm the body cannot reach: the native stands and every call walks past it
        def mcs-armhush?(b, n) = if and(eq(mcs-m-arm(b, n), 1), eq(mcs-m-row(b, n), 0)) then 1 else 0;
        // All three siblings hold this native and the seed has no route to it at all —
        // no row, no rewrite. This is the reading that would have saved 2026-09-08 and
        // the one armhush alone could NOT have given, because on the tree that had the
        // wound, NOTHING left naming str_find carried its tag: the manifest row and
        // the flt-ops row had gone with the op table row, and the tag-30 arm and its
        // serializer arm are keyed by a number nobody spelled. Three sibling
        // registrations were the only mirrors still saying the word. So the honest
        // verdict is not "an arm stands" — the lens cannot see the arm without a tag —
        // it is: three arms hold this meaning, the seed holds no route, GO LOOK IN THE
        // SEED BEFORE MINTING. Cross it with mcs-orphan-tags and the arm is right there.
        def mcs-seedgap?(b, n) = if and(eq(mcs-siblings(b, n), 3), and(eq(mcs-m-row(b, n), 0), eq(mcs-m-rw(b, n), 0))) then 1 else 0;
        // The manifest's coordinate belongs to somebody else, so a blind restore from
        // it would route this name into a stranger's arm. Two names on ONE tag is not
        // that: `add` and `_plus` are one arm under two names on purpose, and so are
        // `write_file` and `host_file_write_text`. An alias is both names present at
        // the same tag; a clash is one name whose own row says a different tag, or a
        // name with no row whose declared tag is already occupied.
        def mcs-tagclash?(b, n) = if eq(mcs-m-manifest(b, n), 0) then 0 else if eq(mcs-m-row(b, n), 1) then mcs-tagclash-both(b, n) else mcs-tagclash-taken(b, n);
        def mcs-tagclash-both(b, n) = if eq(mcs-tag-of(mcs-b-manifest(b), n), mcs-tag-of(mcs-b-row(b), n)) then 0 else 1;
        def mcs-tagclash-taken(b, n) = if eq(str_len(mcs-row-name-at(mcs-b-row(b), mcs-tag-of(mcs-b-manifest(b), n))), 0) then 0 else 1;
        // a route that resolves to nothing
        def mcs-rowhush?(b, n) = if and(eq(mcs-m-row(b, n), 1), eq(mcs-m-arm(b, n), 0)) then 1 else 0;
        // The serializer's arm is owed by ARITY, not by dispatch class: unary takes
        // fkc-un2, ternary fkc-tri2, nullary a leaf row, and only BINARY rides the
        // fallback safely. A variadic (-1) rides another road again, so it is left
        // unjudged rather than judged wrongly.
        def mcs-fkc-owed?(b, n) = if or(lt(mcs-arity(b, n), 0), eq(mcs-arity(b, n), 2)) then 0 else 1;
        def mcs-fkcgap?(b, n) = if and(eq(mcs-m-arm(b, n), 1), and(eq(mcs-m-fkc(b, n), 0), and(eq(mcs-m-manifest(b, n), 1), eq(mcs-fkc-owed?(b, n), 1)))) then 1 else 0;
        // Divergence, not floor. An organ NO sibling carries is honest — the sense
        // family and `nothing` are fkwu's alone by design, and a lens that called 150
        // of those wounds would be unreadable. Two readings instead, and the sharper
        // one first: a native the SEED carries, with a row and an arm, that some
        // sibling has and another has not, is a four-way proof that cannot close over
        // a door the body actually runs. A name living in one or two siblings with no
        // seed row behind it is the softer reading: divergence among the arms alone,
        // which is as often young as wounded.
        def mcs-in-seed?(b, n) = if and(eq(mcs-m-row(b, n), 1), eq(mcs-m-arm(b, n), 1)) then 1 else 0;
        def mcs-siblinggap?(b, n) = if and(eq(mcs-in-seed?(b, n), 1), and(gt(mcs-siblings(b, n), 0), lt(mcs-siblings(b, n), 3))) then 1 else 0;
        def mcs-siblinglone?(b, n) = if and(eq(mcs-in-seed?(b, n), 0), and(gt(mcs-siblings(b, n), 0), lt(mcs-siblings(b, n), 3))) then 1 else 0;
        // The JIT's two name surfaces, disagreeing. jit.go decides TWICE about the same
        // name: `jitRecipeNeedsValueABI` says a recipe containing this call needs the
        // value ABI, and an emitter arm says what to emit for it. A name in one list
        // and not the other is a primitive that lives twice with one copy healed —
        // either a recipe dragged onto the value ABI for a call the emitter will then
        // refuse, or an emitted call whose recipe was never given the ABI to hold it.
        //
        // And what this cell REFUSES to judge, which matters as much. It does not rank
        // a native as "the JIT should carry this and does not". The JIT's surface is a
        // deliberate subset, and nowhere in this tree does anything declare which
        // natives it OUGHT to carry — so such a ranking would be the lens's opinion
        // wearing a measurement's clothes. The jit and abi columns are reported as
        // facts and left to the reader. Naming what a lens cannot judge is part of
        // the lens; str_find was missed for ten weeks by a reading that was sure.
        def mcs-jitsplit?(b, n) = if eq(mcs-m-jit(b, n), mcs-m-abi(b, n)) then 0 else 1;
        // the generated surface has outrun the authority that produces it
        def mcs-manifestgap?(b, n) = if and(eq(mcs-m-row(b, n), 1), eq(mcs-m-manifest(b, n), 0)) then 1 else 0;

        // Ranked by what each costs the body. armhush first because it is silent,
        // daily, and pays a recipe's price for something already built; tagclash
        // above rowhush because a wrong coordinate misleads the repair itself.
        def mcs-drag(b, n) = if eq(mcs-armhush?(b, n), 1) then 90 else if eq(mcs-seedgap?(b, n), 1) then 85 else if eq(mcs-tagclash?(b, n), 1) then 80 else if eq(mcs-rowhush?(b, n), 1) then 70 else if eq(mcs-fkcgap?(b, n), 1) then 60 else if eq(mcs-siblinggap?(b, n), 1) then 50 else if eq(mcs-jitsplit?(b, n), 1) then 40 else if eq(mcs-siblinglone?(b, n), 1) then 30 else if eq(mcs-manifestgap?(b, n), 1) then 20 else 0;
        def mcs-wounds(b, n) = append(if eq(mcs-armhush?(b, n), 1) then list("armhush") else list(), append(if eq(mcs-seedgap?(b, n), 1) then list("seedgap") else list(), append(if eq(mcs-tagclash?(b, n), 1) then list("tagclash") else list(), append(if eq(mcs-rowhush?(b, n), 1) then list("rowhush") else list(), append(if eq(mcs-fkcgap?(b, n), 1) then list("fkcgap") else list(), append(if eq(mcs-siblinggap?(b, n), 1) then list("siblinggap") else list(), append(if eq(mcs-jitsplit?(b, n), 1) then list("jitsplit") else list(), append(if eq(mcs-siblinglone?(b, n), 1) then list("siblinglone") else list(), if eq(mcs-manifestgap?(b, n), 1) then list("manifestgap") else list()))))))));
        // whole is not the absence of a verdict; it is a verdict, and a name that is
        // in no mirror at all is not broken — it simply has no native here
        // Three ways to be well, and the reader is owed the difference. `whole` means
        // every mirror the name's kind calls for stands. `rewrite` means fkwu reaches
        // it through fk_rwtab — a compiled recipe, no arm owed, and `substring` has
        // lived there the whole time. `no-native-here` means no mirror carries it at
        // all, which is a fact about the name and not a wound in the body.
        def mcs-verdict(b, n) = if eq(mcs-known?(b, n), 0) then "no-native-here" else if gt(len(mcs-wounds(b, n)), 0) then head(mcs-wounds(b, n)) else if and(eq(mcs-m-rw(b, n), 1), eq(mcs-m-row(b, n), 0)) then "rewrite" else "whole";
        def mcs-reading(b, n) = list(n, mcs-arity(b, n), mcs-tag(b, n), mcs-class(b, n), mcs-mirrors(b, n), mcs-wounds(b, n), mcs-drag(b, n), mcs-verdict(b, n));
        def mcs-r-name(r) = nth(r, 0);
        def mcs-r-arity(r) = nth(r, 1);
        def mcs-r-tag(r) = nth(r, 2);
        def mcs-r-class(r) = nth(r, 3);
        def mcs-r-mirrors(r) = nth(r, 4);
        def mcs-r-wounds(r) = nth(r, 5);
        def mcs-r-drag(r) = nth(r, 6);
        def mcs-r-verdict(r) = nth(r, 7);

        // --- the whole body ----------------------------------------------------------
        // The universe is the union of every mirror that carries names, because a name
        // living in only one of them is exactly the reading worth having.
        def mcs-add-name(acc, n) = if eq(mcs-in?(acc, n), 1) then acc else cons(n, acc);
        def mcs-union(acc, names) = if eq(len(names), 0) then acc else mcs-union(mcs-add-name(acc, head(names)), tail(names));
        def mcs-universe(b) = mcs-union(mcs-union(mcs-union(mcs-union(mcs-union(mcs-union(mcs-union(list(), mcs-row-names(mcs-b-manifest(b))), mcs-row-names(mcs-b-row(b))), mcs-b-fltops(b)), mcs-b-rw(b)), mcs-b-go(b)), mcs-b-rust(b)), mcs-b-ts(b));
        def mcs-readings(b, names) = if eq(len(names), 0) then list() else cons(mcs-reading(b, head(names)), mcs-readings(b, tail(names)));

        // --- the arms nobody names -----------------------------------------------------
        // The other half of the seedgap reading, and the half no name-driven lens can
        // reach: the tags the walker dispatches on that NO row and NO manifest row
        // claims. Most are structural — a literal, a let, a cond — and belong to no
        // name. But when a native's every name-carrying mirror has gone, its arm falls
        // into exactly this list, and the reader crossing a seedgap name with these
        // numbers finds it in one reading. This is the shape str_find wore: a live arm
        // at a number nobody spelled.
        def mcs-tag-claimed?(b, t) = if gt(str_len(mcs-row-name-at(mcs-b-row(b), t)), 0) then 1 else if gt(str_len(mcs-row-name-at(mcs-b-manifest(b), t)), 0) then 1 else 0;
        def mcs-orphan-go(b, tags, acc) = if eq(len(tags), 0) then acc else mcs-orphan-go(b, tail(tags), if or(eq(mcs-tag-claimed?(b, head(tags)), 1), eq(mcs-tag-in?(acc, head(tags)), 1)) then acc else cons(head(tags), acc));
        def mcs-orphan-tags(b) = mcs-orphan-go(b, mcs-b-armtags(b), list());
        def mcs-hurt(rs) = if eq(len(rs), 0) then list() else if gt(mcs-r-drag(head(rs)), 0) then cons(head(rs), mcs-hurt(tail(rs))) else mcs-hurt(tail(rs));
        // counted by wound PRESENCE, not by worst class: a name carrying three wounds
        // is three findings to repair, and a tally that reported only its worst would
        // hide the two underneath it — the exact shape of what hid str_find
        def mcs-count-wound(rs, w) = if eq(len(rs), 0) then 0 else add(mcs-in?(mcs-r-wounds(head(rs)), w), mcs-count-wound(tail(rs), w));
        def mcs-count-drag(rs, d) = if eq(len(rs), 0) then 0 else add(if eq(mcs-r-drag(head(rs)), d) then 1 else 0, mcs-count-drag(tail(rs), d));

        // worst first, by insertion: the list is short once the whole names are gone,
        // and a sort that walks it twice is cheaper to read than one that is clever
        def mcs-insert(r, rs) = if eq(len(rs), 0) then list(r) else if gt(mcs-r-drag(r), mcs-r-drag(head(rs))) then cons(r, rs) else cons(head(rs), mcs-insert(r, tail(rs)));
        def mcs-sort(rs, acc) = if eq(len(rs), 0) then acc else mcs-sort(tail(rs), mcs-insert(head(rs), acc));
        def mcs-ranked(b) = mcs-sort(mcs-hurt(mcs-readings(b, mcs-universe(b))), list());
        def mcs-take(rs, n) = if or(le(n, 0), eq(len(rs), 0)) then list() else cons(head(rs), mcs-take(tail(rs), sub(n, 1)));

        // --- saying it -----------------------------------------------------------------
        def mcs-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), mcs-cat(tail(parts)));
        def mcs-join(parts, sep) = if eq(len(parts), 0) then "" else if eq(len(tail(parts)), 0) then head(parts) else mcs-cat(list(head(parts), sep, mcs-join(tail(parts), sep)));
        def mcs-num(v) = if lt(v, 0) then "unread" else int_to_str(v);
        def mcs-stand(v) = if lt(v, 0) then "?" else if eq(v, 1) then "+" else "-";
        def mcs-mirror-line(flags, names) = if eq(len(names), 0) then "" else mcs-cat(list(mcs-stand(head(flags)), head(names), " ", mcs-mirror-line(tail(flags), tail(names))));
        def mcs-r-text(r) = mcs-cat(list(mcs-r-verdict(r), "  ", mcs-r-name(r), "  tag ", mcs-num(mcs-r-tag(r)), " arity ", mcs-num(mcs-r-arity(r)), if eq(str_len(mcs-r-class(r)), 0) then "" else str_concat(" ", mcs-r-class(r)), "  [ ", mcs-mirror-line(mcs-r-mirrors(r), mcs-mirror-names()), "]", if eq(len(mcs-r-wounds(r)), 0) then "" else str_concat("  wounds: ", mcs-join(mcs-r-wounds(r), " "))));
        def mcs-lines(rs) = if eq(len(rs), 0) then "" else mcs-cat(list("  ", mcs-r-text(head(rs)), byte_to_str(10), mcs-lines(tail(rs))));
        def mcs-tally(rs) = mcs-cat(list("armhush ", int_to_str(mcs-count-wound(rs, "armhush")), "  seedgap ", int_to_str(mcs-count-wound(rs, "seedgap")), "  tagclash ", int_to_str(mcs-count-wound(rs, "tagclash")), "  rowhush ", int_to_str(mcs-count-wound(rs, "rowhush")), "  fkcgap ", int_to_str(mcs-count-wound(rs, "fkcgap")), "  siblinggap ", int_to_str(mcs-count-wound(rs, "siblinggap")), "  jitsplit ", int_to_str(mcs-count-wound(rs, "jitsplit")), "  siblinglone ", int_to_str(mcs-count-wound(rs, "siblinglone")), "  manifestgap ", int_to_str(mcs-count-wound(rs, "manifestgap"))));
    }
    0;
}
