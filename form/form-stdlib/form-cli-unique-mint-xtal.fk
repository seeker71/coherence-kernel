
(let SampleRow (language-template-with-members "SampleRow" (list "TClass") (list (language-template-member "split" "String") (language-template-member "className" "TClass") (language-template-member "situation" "String"))))
(defn MintAuthorityPath () "form/form-stdlib/bml/form-cli-unique-mint.bml")
(defn MintAuthorityKind () "high-bml-class-template-field")
(defn FormUniqueMintAuthority () (list "abstraction" "FormUniqueMintAuthority" (list) (list) (list "MintAuthorityPath" "MintAuthorityKind") (list) (list)))
(defn MixA () 7)
(defn MixB () 13)
(defn NSkills () 9)
(defn LoraWriter () 0)
(defn SplitTrain () "train")
(defn SplitHeldout () "heldout")
(defn fnu-authority () FormUniqueMintAuthority)
(defn fnu-pattern () (list "mint" "heldout" "overlay-fit" "lora-waits"))
(defn fnu-skills () (list "channel" "protocol" "axiom" "satsang" "nothing" "timeout" "trust" "choice-undo" "embodied-memory"))
(defn fnu-contexts () (list "offer-ack core" "satsang circle" "channel membrane" "axiom-4 boundary" "one-turn budget" "local overlay" "choice-lane walk" "ingest door"))
(defn fnu-sources () (list "form/form-stdlib/channel.fk" "form/form-stdlib/channel-interface.fk" "axioms/core-axioms.form" "form/form-stdlib/satsang.fk" "ingest/satsang-transmute.fk" "control/choice-lane-core.fk" "ingest/judged-trust.fk" "NORTH_STAR.md"))
(defn fnu-mix (i n) (mod (add (mul i (MixA)) (MixB)) n))
(defn fnu-channel-stems () (list "a channel is a Recipe whose Blueprint is CHANNEL-V0 and whose children are message-Recipes" "content-addressing is the dedup two cells appending the same payload share one CHANNEL-MSG NodeID" "honor the other side offered interface reaching beyond it is invasion" "silence is always honored from any interface"))
(defn fnu-protocol-stems () (list "to run a cell and to speak to a cell are one act offer over a channel" "kernel-offer-protocol is a theorem of axiom-5 not new ground" "first-encounter is the threshold the channel-interface is the ongoing life" "the channel invites it never forces"))
(defn fnu-axiom-stems () (list "five axioms states cell content-addressing boundary offer everything else is a theorem" "axiom-1 three states are 0 1 and nothing" "axiom-4 a cell meets the world only through an interface it offers" "axiom-5 acknowledgement is exactly one of nothing 0 1 or node"))
(defn fnu-satsang-stems () (list "a satsang is a circle that is its own cell any question is welcome" "truth is what survives the circle dissent kept visible" "silence is a whole attestation the circle never pierces the interior" "satsang-transmute pairs a low-frequency concept against an axiom and witnesses 0 1 nothing or node"))
(defn fnu-nothing-stems () (list "axiom-1 nothing is first-class the ground not a missing zero" "nothing is distinct from 0 and 1 and never becomes arithmetic" "pending is honest silence is a whole attestation" "held-offer silence may mean not-yet the offer stands unconsumed"))
(defn fnu-timeout-stems () (list "timeout is nothing no answer in time is silence not an error" "timeout spends a budget with alternatives untried exhaustion tried every alternative" "a settle-walk that spends its budget resolves to nothing never a filibuster" "oac-timed-out is declined with alternatives still waiting"))
(defn fnu-trust-stems () (list "trust is weighted decays and must be earned by repeated evidence" "receipts before trust observation through the offered interface is what makes a claim real" "judged trust may freeze into body unjudged trust is credulity and composts" "a third-party oracle is a quick answer with no trust transparency or vitality until transmuted"))
(defn fnu-choice-stems () (list "choice and undo are native control primitives not host exceptions" "choice returns the first non-nothing acknowledgement lanes collect every ack" "undo falls back to the last store checkpoint when the current ack failed" "store and restore hand a content-addressed value they do not mutate a cell"))
(defn fnu-memory-stems () (list "a checkpoint is a memory value at a moment never a mutated cell" "lanes collect nodes along the way so later picking is a separate act over collected memory" "compute when where which and look up the cell instead of walking a long reasoning chain" "the body remembers as receipts cells and checkpoints not as a chain of thoughts"))
(defn fnu-stems (class) (if (str_eq class "channel") (fnu-channel-stems) (if (str_eq class "protocol") (fnu-protocol-stems) (if (str_eq class "axiom") (fnu-axiom-stems) (if (str_eq class "satsang") (fnu-satsang-stems) (if (str_eq class "nothing") (fnu-nothing-stems) (if (str_eq class "timeout") (fnu-timeout-stems) (if (str_eq class "trust") (fnu-trust-stems) (if (str_eq class "choice-undo") (fnu-choice-stems) (fnu-memory-stems))))))))))
(defn fnu-prefix (split) (if (str_eq split (SplitTrain)) "Observed " "Boundary: observed "))
(defn fnu-situation (class i split) (do (let ctxs (fnu-contexts)) (let stems (fnu-stems class)) (let ctx (nth ctxs (fnu-mix i (len ctxs)))) (let stem (nth stems (fnu-mix i (len stems)))) (str_concat (fnu-prefix split) (str_concat ctx (str_concat " " (str_concat stem (str_concat " case " (int_to_str i))))))))
(defn fnu-row (class i split) (list split class (fnu-situation class i split)))
(defn fnu-class-rows (class i n split acc) (if (eq i n) acc (fnu-class-rows class (add i 1) n split (cons (fnu-row class i split) acc))))
(defn fnu-all-classes (names tn hn acc) (if (eq (len names) 0) acc (fnu-all-classes (tail names) tn hn (fnu-class-rows (head names) 0 hn (SplitHeldout) (fnu-class-rows (head names) 0 tn (SplitTrain) acc)))))
(defn fnu-corpus (tn hn) (fnu-all-classes (fnu-skills) tn hn (tail (list "x"))))
(defn fnu-n (tn hn) (mul (NSkills) (add tn hn)))
(defn fnu-has-situation (rows s) (if (eq (len rows) 0) 0 (if (str_eq (nth (head rows) 2) s) 1 (fnu-has-situation (tail rows) s))))
(defn fnu-train-only (rows acc) (if (eq (len rows) 0) acc (if (str_eq (nth (head rows) 0) (SplitTrain)) (fnu-train-only (tail rows) (cons (head rows) acc)) (fnu-train-only (tail rows) acc))))
(defn fnu-leakage-loop (all rows) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) (SplitHeldout)) (fnu-has-situation (fnu-train-only all (tail (list "x"))) (nth (head rows) 2)) 0) (fnu-leakage-loop all (tail rows)))))
(defn fnu-leakage (rows) (fnu-leakage-loop rows rows))
(defn fnu-unique-loop (rows seen) (if (eq (len rows) 0) (len seen) (if (eq (fnu-has-situation seen (nth (head rows) 2)) 1) (fnu-unique-loop (tail rows) seen) (fnu-unique-loop (tail rows) (cons (head rows) seen)))))
(defn fnu-unique (rows) (fnu-unique-loop rows (tail (list "x"))))
(defn fnu-count-split (rows split) (if (eq (len rows) 0) 0 (add (if (str_eq (nth (head rows) 0) split) 1 0) (fnu-count-split (tail rows) split))))
(defn fnu-lora-writer () (LoraWriter))
(defn fnu-mix-diverse () (if (eq (fnu-mix 0 8) (fnu-mix 1 8)) 0 1))
(defn fnu-predict (models names s) (nth names (fqt-predict-index models s)))
(defn fnu-heldout-hit (models names row) (if (str_eq (nth row 0) (SplitHeldout)) (if (str_eq (fnu-predict models names (nth row 2)) (nth row 1)) 1 0) 0))
(defn fnu-heldout-correct-loop (models names rows) (if (eq (len rows) 0) 0 (add (fnu-heldout-hit models names (head rows)) (fnu-heldout-correct-loop models names (tail rows)))))
(defn fnu-heldout-correct (rows) (do (let names (fnu-skills)) (let models (fqt-fit rows names)) (fnu-heldout-correct-loop models names rows)))
(defn fnu-bit (ok bit) (if ok bit 0))
(defn fnu-check () (do (let rows (fnu-corpus 3 1)) (let n (fnu-n 3 1)) (let correct (fnu-heldout-correct rows)) (let c0 (fnu-bit (eq n 36) 1)) (let c1 (fnu-bit (eq (fnu-mix-diverse) 1) 2)) (let c2 (fnu-bit (eq (fnu-leakage rows) 0) 4)) (let c3 (fnu-bit (eq (fnu-unique rows) n) 8)) (let c4 (fnu-bit (and (eq (fnu-count-split rows (SplitTrain)) 27) (eq (fnu-count-split rows (SplitHeldout)) 9)) 16)) (let c5 (fnu-bit (ge correct 7) 32)) (let c6 (fnu-bit (eq (fnu-lora-writer) 0) 64)) (let c7 (fnu-bit (eq (fnu-n 5 2) 63) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormUniqueMint () (list "abstraction" "FormUniqueMint" (list "T") (list "fnu-mix" "fnu-channel-stems" "fnu-protocol-stems" "fnu-axiom-stems" "fnu-satsang-stems" "fnu-nothing-stems" "fnu-timeout-stems" "fnu-trust-stems" "fnu-choice-stems" "fnu-memory-stems" "fnu-stems" "fnu-prefix" "fnu-situation" "fnu-row" "fnu-class-rows" "fnu-all-classes" "fnu-corpus" "fnu-n" "fnu-has-situation" "fnu-train-only" "fnu-leakage-loop" "fnu-leakage" "fnu-unique-loop" "fnu-unique" "fnu-count-split" "fnu-lora-writer" "fnu-mix-diverse" "fnu-predict" "fnu-heldout-hit" "fnu-heldout-correct-loop" "fnu-heldout-correct" "fnu-bit" "fnu-check") (list "MixA" "MixB" "NSkills" "LoraWriter" "SplitTrain" "SplitHeldout") (list "fnu-authority") (list "fnu-pattern" "fnu-skills" "fnu-contexts" "fnu-sources")))
0
