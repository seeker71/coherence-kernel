; form-knowledge-axioms-vertical-finalizer.fk -- one canonical family vertical.
;
; This pure cell answers one bounded question: are all four public `axioms`
; witnesses present and valid together -- resident lanes a and b, generative
; BML/BMF/Form execution, and native recipe execution?  It does not alter the
; body's current dynamically observed family census projection and cannot produce a
; projection-wide mastery result.  That census is observed state, not a fixed
; target; it is re-observed after this crossing.
;
; Missing evidence remains `nothing`.  Present-but-invalid evidence is `0`.
; Only recomputed valid evidence becomes `1`.
;
; preludes: form-stdlib/form-knowledge-public-resident-eval.fk

(do
    (defn fkav-family () "axioms")
    (defn fkav-basis ()
        "public-axioms-one-family-vertical+resident-a-b+generative+native-v2")
    (defn fkav-missing? (x) (if (nothing? x) 1 0))
    (defn fkav-state (evidence valid)
        (if (eq (fkav-missing? evidence) 1) (nothing)
            (if (eq valid 1) 1 0)))
    (defn fkav-state-one? (state)
        (if (nothing? state) 0 (if (eq state 1) 1 0)))
    (defn fkav-report-int (report name)
        (do
            (let marker (str_concat name "="))
            (let at (str_find report marker 0))
            (if (lt at 0) -1
                (do
                    (let start (add at (str_len marker)))
                    (let stop (str_find report "\n" start))
                    (str_to_int (substring report start
                        (if (lt stop 0) (str_len report) stop)))))))

    (defn fkav-trial-lane (trial)
        (fkp30-presentation-lane (fkp30-trial-presentation trial)))
    (defn fkav-trial-family (trial)
        (fkp30-presentation-family (fkp30-trial-presentation trial)))
    (defn fkav-trial-shape-valid? (trial)
        (if (not (eq (fkpfm-list? trial) 1)) 0
        (if (not (eq (len trial) 28)) 0
        (if (not (str_eq (head trial)
                         "public-heldout-resident-trial-v1")) 0
            (fkp30-trial-valid? trial)))))
    (defn fkav-count-lane (trials lane)
        (if (eq (len trials) 0) 0
            (add (if (str_eq (fkav-trial-lane (head trials)) lane) 1 0)
                 (fkav-count-lane (tail trials) lane))))
    (defn fkav-find-lane (trials lane)
        (if (eq (len trials) 0) (nothing)
            (if (str_eq (fkav-trial-lane (head trials)) lane)
                (head trials) (fkav-find-lane (tail trials) lane))))
    (defn fkav-trial-strong-valid? (trial lane)
        (if (not (eq (fkav-trial-shape-valid? trial) 1)) 0
            (do
                (let score (fkp30-trial-score trial))
                (let observation (fkhe-score-observation score))
                (let raw (fkp30-trial-raw-output trial))
                (let report-generated (fkav-report-int raw "generated_tokens"))
                (let report-forwards (fkav-report-int raw "forward_passes"))
                (let report-executed (if (and (gt report-generated 0)
                                              (gt report-forwards 0)) 1 0))
                ; The resident-trial v1 shape carries an explicit release bit
                ; but no structured close receipt.  Require that bit directly;
                ; absence of an error string in raw model output is not positive
                ; evidence that a state handle closed.
                (let release-asserted (fkp30-trial-state-released trial))
                (if (eq (fkpfm-all? (list
                    (str_eq (fkav-trial-family trial) (fkav-family))
                    (str_eq (fkav-trial-lane trial) lane)
                    (eq (fkp30-trial-local trial) 1)
                    (eq (fkp30-trial-remote trial) 0)
                    (eq (fkp30-trial-model-executed trial) report-executed)
                    (eq report-executed 1)
                    (eq (fkp30-trial-generated-tokens trial) report-generated)
                    (eq release-asserted 1)
                    (eq (fkp30-trial-same-residence trial) 1)
                    (eq (fkp30-trial-present trial) 1)
                    (str_eq (fkp30-trial-outcome trial) "value")
                    (gt (fkp30-trial-generated-tokens trial) 0)
                    (eq (nmfe-obs-error observation) 0)
                    (eq (fkhe-at-least95?
                        (nmfe-obs-promotion observation)) 1))) 1) 1 0))))
    (defn fkav-resident-valid? (trials)
        (if (not (eq (fkpfm-list? trials) 1)) 0
        (if (not (eq (len trials) 2)) 0
            (do
                (let first (head trials))
                (let second (nth trials 1))
                ; Do not call lane or trial accessors until both nested values
                ; have passed their complete child validators.
                (if (not (eq (fkav-trial-shape-valid? first) 1)) 0
                (if (not (eq (fkav-trial-shape-valid? second) 1)) 0
                    (do
                        (let a (fkav-find-lane trials "a"))
                        (let b (fkav-find-lane trials "b"))
                        (if (eq (fkpfm-all? (list
                            (eq (fkav-count-lane trials "a") 1)
                            (eq (fkav-count-lane trials "b") 1)
                            (not (nothing? a))
                            (not (nothing? b))
                            (eq (fkav-trial-strong-valid? a "a") 1)
                            (eq (fkav-trial-strong-valid? b "b") 1)
                            (str_eq (fkp30-trial-model-id a)
                                    (fkp30-trial-model-id b))
                            (str_eq (fkp30-trial-run-id a)
                                    (fkp30-trial-run-id b))
                            (str_eq (fkp30-trial-session-id a)
                                    (fkp30-trial-session-id b))
                            (not (str_eq (fkp30-trial-output-sha a)
                                         (fkp30-trial-output-sha b)))
                            (not (str_eq (fkp30-trial-family-nonce a)
                                         (fkp30-trial-family-nonce b)))
                            (not (str_eq (fkp30-trial-content-sha a)
                                         (fkp30-trial-content-sha b))))) 1)
                            1 0))))))))

    (defn fkav-generative-valid? (evidence)
        (if (not (eq (fkpfm-generative-valid? evidence) 1)) 0
            (if (str_eq (fkpfm-evidence-family evidence) (fkav-family)) 1 0)))
    (defn fkav-execution-valid? (evidence)
        (if (not (eq (fkpfm-execution-valid? evidence) 1)) 0
            (if (str_eq (fkpfm-evidence-family evidence) (fkav-family)) 1 0)))
    (defn fkav-same-model-run? (trials generative execution)
        (if (not (and (eq (fkav-resident-valid? trials) 1)
                      (and (eq (fkav-generative-valid? generative) 1)
                           (eq (fkav-execution-valid? execution) 1)))) 0
            (do
                (let resident (fkav-find-lane trials "a"))
                (let model-id (fkp30-trial-model-id resident))
                (let run-id (fkp30-trial-run-id resident))
                (if (and (str_eq model-id (nth generative 3))
                     (and (str_eq model-id (nth execution 3))
                     (and (str_eq run-id (nth generative 15))
                          (str_eq run-id (nth execution 14))))) 1 0))))

    (defn fkav-result-message
        (trials generative execution lane-a lane-b gen-state exec-state
         correlated present complete ready source-sha challenge-sha exec-sha)
        (fkpfm-canonical (list "public-axioms-vertical-result-v1"
            (fkpfm-public-scope) (fkav-family) (fkav-basis) trials generative
            execution lane-a lane-b gen-state exec-state correlated present
            complete ready source-sha challenge-sha exec-sha)))
    ; result = tag scope family basis trials generative execution
    ;          lane-a lane-b generative-state execution-state
    ;          cross-axis-correlated present complete ready
    ;          source-sha challenge-sha exec-sha sha
    (defn fkav-result (trials generative execution)
        (do
            (let resident-valid (fkav-resident-valid? trials))
            (let lane-a (fkav-state trials (if (eq resident-valid 1)
                (fkav-trial-strong-valid? (fkav-find-lane trials "a") "a") 0)))
            (let lane-b (fkav-state trials (if (eq resident-valid 1)
                (fkav-trial-strong-valid? (fkav-find-lane trials "b") "b") 0)))
            (let gen-state (fkav-state generative
                (fkav-generative-valid? generative)))
            (let exec-state (fkav-state execution
                (fkav-execution-valid? execution)))
            (let correlated (if (or (nothing? trials)
                                (or (nothing? generative)
                                    (nothing? execution))) (nothing)
                (fkav-same-model-run? trials generative execution)))
            (let present (if (and (not (nothing? lane-a))
                              (and (not (nothing? lane-b))
                              (and (not (nothing? gen-state))
                                   (not (nothing? exec-state))))) 1 0))
            (let complete (if (eq present 0) (nothing)
                (if (and (eq resident-valid 1)
                     (and (eq (fkav-state-one? gen-state) 1)
                     (and (eq (fkav-state-one? exec-state) 1)
                          (eq (fkav-state-one? correlated) 1)))) 1 0)))
            (let ready (if (nothing? complete) (nothing)
                (if (eq complete 1) 1 0)))
            (let source-sha (fkpfm-family-source-sha (fkav-family)))
            (let challenge-sha (fkpfm-family-challenge-sha (fkav-family)))
            (let exec-sha
                (fkpfm-family-exec-challenge-sha (fkav-family)))
            (let message (fkav-result-message trials generative execution
                lane-a lane-b gen-state exec-state correlated present complete
                ready source-sha challenge-sha exec-sha))
            (list "public-axioms-vertical-result-v1" (fkpfm-public-scope)
                (fkav-family) (fkav-basis) trials generative execution lane-a
                lane-b gen-state exec-state correlated present complete ready
                source-sha challenge-sha exec-sha (nmfe-sha256 message))))
    (defn fkav-result-correlated? (result) (nth result 11))
    (defn fkav-result-present? (result) (nth result 12))
    (defn fkav-result-complete? (result) (nth result 13))
    (defn fkav-result-ready? (result) (nth result 14))
    (defn fkav-result-valid? (result)
        (if (not (eq (fkpfm-list? result) 1)) 0
        (if (not (eq (len result) 19)) 0
        (if (not (str_eq (nth result 0)
                         "public-axioms-vertical-result-v1")) 0
            (if (eq (fkpfm-equal? result
                    (fkav-result (nth result 4) (nth result 5)
                                 (nth result 6))) 1) 1 0)))))

    0)
