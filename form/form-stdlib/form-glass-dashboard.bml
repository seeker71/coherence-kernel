//////////////////////////////////////////////////////////////////////
//
// form-glass-dashboard.bml — responsive Form-native glass scene.
//
// Authority: form-stdlib/bml/form-glass-dashboard.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-terminal-canvas.bml form/form-stdlib/form-glass-observer.bml form/form-stdlib/form-glass-telemetry-membrane.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassDashboardAuthority {
        field FGDAuthorityPath = "form/form-stdlib/bml/form-glass-dashboard.bml";
        field FGDAuthorityKind = "high-bml-interface-class-const";
    }

    class FormGlassDashboard {
        field FGDSchema = "form-glass-dashboard-v1";
        field FGDEquals = "================================================================================================================================================================================================================================================";
        field FGDHashes = "################################################################################################################################################################################################################################################";
        field FGDDots = "................................................................................................................................................................................................................................................";
        field FGDSpaces = "                                                                                                                                                                                                                                                ";
        ref fgd-authority = FormGlassDashboardAuthority;
        thought fgd-law = list("scene-before-adapter", "provenance-visible", "planes-distinct", "age-is-visible-and-alpha", "typed-non-values", "responsive-regions", "observed-frame-history", "control-is-correlated");

        def fgd-clamp(value, low, high) = if lt(value, low) then low else if gt(value, high) then high else value;
        def fgd-min(a, b) = if le(a, b) then a else b;
        def fgd-max(a, b) = if ge(a, b) then a else b;
        def fgd-fit(text, width) = if le(width, 0) then "" else if le(str_len(text), width) then text else substring(text, 0, width);
        def fgd-repeat(text, count) = if le(count, 0) then "" else str_concat(text, fgd-repeat(text, sub(count, 1)));
        def fgd-run(source, count) = if le(count, 0) then "" else substring(source, 0, fgd-min(count, str_len(source)));
        def fgd-equals(count) = fgd-repeat("=", count);
        def fgd-hashes(count) = fgd-repeat("#", count);
        def fgd-dots(count) = fgd-repeat(".", count);
        def fgd-spaces(count) = fgd-repeat(" ", count);
        def fgd-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), fgd-cat(tail(parts)));
        def fgd-pad-right(text, width) = if ge(str_len(text), width) then fgd-fit(text, width) else str_concat(text, fgd-repeat(" ", sub(width, str_len(text))));
        def fgd-format-count(value) = if ge(value, 1000000000) then str_concat(int_to_str(div(value, 1000000000)), "G") else if ge(value, 1000000) then str_concat(int_to_str(div(value, 1000000)), "M") else if ge(value, 1000) then str_concat(int_to_str(div(value, 1000)), "K") else int_to_str(value);
        def fgd-format-bytes(value) = if ge(value, 1073741824) then str_concat(int_to_str(div(value, 1073741824)), "GiB") else if ge(value, 1048576) then str_concat(int_to_str(div(value, 1048576)), "MiB") else if ge(value, 1024) then str_concat(int_to_str(div(value, 1024)), "KiB") else str_concat(int_to_str(value), "B");
        def fgd-format-age-ms(value) = if lt(value, 0) then "absent" else if lt(value, 1000) then str_concat(int_to_str(value), "ms") else if lt(value, 60000) then str_concat(int_to_str(div(value, 1000)), "s") else if lt(value, 3600000) then str_concat(int_to_str(div(value, 60000)), "m") else if lt(value, 86400000) then str_concat(int_to_str(div(value, 3600000)), "h") else str_concat(int_to_str(div(value, 86400000)), "d");

        def fgd-neutral(alpha) = ftc-style("neutral", 176, 186, 196, -1, -1, -1, alpha, 0, ".");
        def fgd-title() = ftc-style("glass-title", 130, 225, 255, 8, 18, 31, 255, 1, "@");
        def fgd-health() = ftc-style("health", 255, 92, 96, -1, -1, -1, 255, 1, "!");
        def fgd-ready() = ftc-style("ready", 94, 235, 162, -1, -1, -1, 255, 1, ">");
        def fgd-catalog() = ftc-style("catalog", 232, 190, 90, -1, -1, -1, 176, 0, "#");
        def fgd-style-for-plane(plane, alpha, bold) = if str_eq(plane, "form") then ftc-style("form", 80, 195, 255, -1, -1, -1, alpha, bold, "F") else if str_eq(plane, "cpu") then ftc-style("cpu", 105, 225, 145, -1, -1, -1, alpha, bold, "C") else if str_eq(plane, "gpu") then ftc-style("gpu", 185, 115, 255, -1, -1, -1, alpha, bold, "G") else if str_eq(plane, "metal") then ftc-style("metal", 255, 139, 72, -1, -1, -1, alpha, bold, "M") else if str_eq(plane, "mlx") then ftc-style("mlx", 110, 155, 255, -1, -1, -1, alpha, bold, "X") else if str_eq(plane, "unified") then ftc-style("unified", 205, 120, 255, -1, -1, -1, alpha, bold, "U") else if str_eq(plane, "disk") then ftc-style("disk", 235, 188, 82, -1, -1, -1, alpha, bold, "D") else if str_eq(plane, "network") then ftc-style("network", 70, 225, 215, -1, -1, -1, alpha, bold, "N") else if str_eq(plane, "membrane") then ftc-style("membrane", 255, 105, 195, -1, -1, -1, alpha, bold, "|") else fgd-neutral(alpha);
        def fgd-style-for-metric(metric) = if str_eq(fgo-evidence(metric), "catalog") then fgd-catalog() else if str_eq(fgo-domain(metric), "health") then fgd-health() else if str_eq(fgo-plane(metric), "unified-gpu") then fgd-style-for-plane("unified", 255, 0) else if str_eq(fgo-plane(metric), "disk-cache") then fgd-style-for-plane("disk", 176, 0) else if str_eq(fgo-plane(metric), "mapped-file") then fgd-style-for-plane("disk", 176, 0) else if str_eq(fgo-plane(metric), "cpu-arena") then fgd-style-for-plane("cpu", 255, 0) else if str_eq(fgo-plane(metric), "cpu-stack") then fgd-style-for-plane("cpu", 255, 0) else if str_eq(fgo-plane(metric), "os-memory") then fgd-style-for-plane("unified", 255, 0) else fgd-neutral(176);
        def fgd-truth-symbol(truth) = if str_eq(truth, "physical-live") then "*" else if str_eq(truth, "observed") then "*" else if str_eq(truth, "derived-window") then "+" else if str_eq(truth, "catalog") then "#" else if str_eq(truth, "declared") then "~" else "?";
        def fgd-state-symbol(state) = if str_eq(state, "active") then ">" else if str_eq(state, "prefilling") then ":" else if str_eq(state, "ready") then "=" else if str_eq(state, "resident") then "o" else if str_eq(state, "mapped") then "m" else if str_eq(state, "failed") then "!" else if str_eq(state, "released") then "x" else ".";

        def fgd-find-metric(rows, id) = if eq(len(rows), 0) then list() else if str_eq(fgo-id(head(rows)), id) then head(rows) else fgd-find-metric(tail(rows), id);
        def fgd-metric-value(metric) = if eq(len(metric), 0) then "absent(metric)" else if eq(fgo-present?(metric), 0) then str_concat("unavailable(", str_concat(fgo-note(metric), ")")) else if str_eq(fgo-value-kind(metric), "text") then fgo-text-value(metric) else if str_eq(fgo-unit(metric), "bytes") then fgd-format-bytes(fgo-int-value(metric)) else fgd-format-count(fgo-int-value(metric));
        def fgd-metric-age(metric) = if or(eq(len(metric), 0), lt(fgo-age(metric), 0)) then "" else str_concat(" age=", fgd-format-age-ms(fgo-age(metric)));
        def fgd-metric-line(metric, width) = if eq(len(metric), 0) then fgd-pad-right("? absent(metric:not-published)", width) else fgd-fit(fgd-cat(list(fgd-truth-symbol(fgo-evidence(metric)), " ", fgo-label(metric), " ", fgd-metric-value(metric), if eq(fgo-present?(metric), 1) then str_concat(" ", fgo-unit(metric)) else "", fgd-metric-age(metric))), width);
        def fgd-important-metrics(rows) = list(fgd-find-metric(rows, "glass-program-image"), fgd-find-metric(rows, "memory-free"), fgd-find-metric(rows, "dispatch-distinct"), fgd-find-metric(rows, "cells"), fgd-find-metric(rows, "value-stack"), fgd-find-metric(rows, "buffers"), fgd-find-metric(rows, "pipelines"), fgd-find-metric(rows, "gpu-busy"), fgd-find-metric(rows, "cpu-jit-busy"), fgd-find-metric(rows, "ops"), fgd-find-metric(rows, "events"), fgd-find-metric(rows, "fkb-count"), fgd-find-metric(rows, "fkb-bytes"), fgd-find-metric(rows, "metal-error"), fgd-find-metric(rows, "mlx-error"));
        def fgd-focus-metric?(metric, focus) = if str_eq(fgo-channel(metric), focus) then 1 else if str_eq(fgo-domain(metric), focus) then 1 else if str_eq(fgo-id(metric), focus) then 1 else if str_eq(fgo-plane(metric), focus) then 1 else 0;
        def fgd-filter-metrics(rows, focus) = if eq(len(rows), 0) then list() else if eq(fgd-focus-metric?(head(rows), focus), 1) then cons(head(rows), fgd-filter-metrics(tail(rows), focus)) else fgd-filter-metrics(tail(rows), focus);
        def fgd-focus-metrics(rows, focus) {
            let selected = if str_eq(focus, "all") then append(fgd-take(fgd-filter-metrics(rows, "process"), 6), fgd-important-metrics(rows)) else fgd-filter-metrics(rows, focus);
            if gt(len(selected), 0) then selected else fgd-important-metrics(rows);
        }
        def fgd-present-metrics(rows) = if eq(len(rows), 0) then list() else if and(gt(len(head(rows)), 0), eq(fgo-present?(head(rows)), 1)) then cons(head(rows), fgd-present-metrics(tail(rows))) else fgd-present-metrics(tail(rows));
        def fgd-longest-sample-width(samples, held) = if eq(len(samples), 0) then held else fgd-longest-sample-width(tail(samples), fgd-max(held, str_len(fgd-sample-line(head(samples), 1000))));
        def fgd-longest-metric-width(metrics, held) = if eq(len(metrics), 0) then held else fgd-longest-metric-width(tail(metrics), fgd-max(held, str_len(fgd-metric-line(head(metrics), 1000))));

        def fgd-has-channel(channels, wanted) = if eq(len(channels), 0) then 0 else if str_eq(head(channels), wanted) then 1 else fgd-has-channel(tail(channels), wanted);
        def fgd-visible?(sample, focus) = if str_eq(focus, "all") then 1 else if str_eq(fgtm-sample-id(sample), focus) then 1 else fgd-has-channel(fgtm-sample-channels(sample), focus);
        def fgd-lifecycle-score(state) = if str_eq(state, "active") then 9000 else if str_eq(state, "prefilling") then 8000 else if str_eq(state, "ready") then 7000 else if str_eq(state, "resident") then 6000 else if str_eq(state, "pinned") then 5500 else if str_eq(state, "mapped") then 5000 else if str_eq(state, "failed") then 4500 else if str_eq(state, "evictable") then 3000 else if str_eq(state, "cooling") then 2000 else if str_eq(state, "idle") then 1000 else 0;
        def fgd-field-number(field) = if eq(fgtm-field-present?(field), 1) then fgtm-field-value(field) else 0;
        def fgd-sample-score(sample) = add(fgd-lifecycle-score(fgtm-sample-lifecycle(sample)), fgd-field-number(fgtm-sample-heat(sample)));
        def fgd-hotter-sample?(left, right) = if gt(fgd-sample-score(left), fgd-sample-score(right)) then 1 else 0;
        def fgd-insert-sample(sample, rows) = if eq(len(rows), 0) then list(sample) else if eq(fgd-hotter-sample?(sample, head(rows)), 1) then cons(sample, rows) else cons(head(rows), fgd-insert-sample(sample, tail(rows)));
        def fgd-take(rows, count) = if or(le(count, 0), eq(len(rows), 0)) then list() else cons(head(rows), fgd-take(tail(rows), sub(count, 1)));
        def fgd-ranked-visible(samples, focus, limit, ranked) = if eq(len(samples), 0) then fgd-take(ranked, limit) else if eq(fgd-visible?(head(samples), focus), 1) then fgd-ranked-visible(tail(samples), focus, limit, fgd-take(fgd-insert-sample(head(samples), ranked), limit)) else fgd-ranked-visible(tail(samples), focus, limit, ranked);
        def fgd-top-samples(samples, focus, limit) = fgd-ranked-visible(samples, focus, limit, list());

        def fgd-sample-latest(sample) {
            let readPresent = fgtm-field-present?(fgtm-sample-read-epoch(sample));
            let writePresent = fgtm-field-present?(fgtm-sample-write-epoch(sample));
            let readEpoch = fgd-field-number(fgtm-sample-read-epoch(sample));
            let writeEpoch = fgd-field-number(fgtm-sample-write-epoch(sample));
            if and(eq(readPresent, 0), eq(writePresent, 0)) then -1 else if eq(readPresent, 0) then writeEpoch else if eq(writePresent, 0) then readEpoch else if ge(readEpoch, writeEpoch) then readEpoch else writeEpoch;
        }
        def fgd-sample-age(sample, epoch) {
            let latest = fgd-sample-latest(sample);
            if lt(latest, 0) then -1 else if ge(epoch, latest) then fgd-age-delta(sub(epoch, latest)) else 0;
        }
        def fgd-age-delta(delta) = div(delta, 1000);
        def fgd-sample-alpha(sample, epoch) {
            let age = fgd-sample-age(sample, epoch);
            if lt(age, 0) then 176 else fgd-clamp(sub(255, mul(age, 16)), 56, 255);
        }
        def fgd-sample-style(sample, epoch) = fgd-style-for-plane(fgtm-sample-plane(sample), fgd-sample-alpha(sample, epoch), if str_eq(fgtm-sample-lifecycle(sample), "active") then 1 else 0);
        def fgd-sample-amount(sample) = if eq(fgtm-field-present?(fgtm-sample-bytes(sample)), 1) then fgd-format-bytes(fgtm-field-value(fgtm-sample-bytes(sample))) else if eq(fgtm-field-present?(fgtm-sample-handle(sample)), 1) then str_concat("bytes:absent h", int_to_str(fgtm-field-value(fgtm-sample-handle(sample)))) else "bytes:absent";
        def fgd-field-age(field, epoch) = if eq(fgtm-field-present?(field), 0) then "absent" else if ge(epoch, fgtm-field-value(field)) then fgd-format-age-ms(sub(epoch, fgtm-field-value(field))) else "clock-skew";
        def fgd-sample-age-text(sample, epoch) = fgd-cat(list("r=", fgd-field-age(fgtm-sample-read-epoch(sample), epoch), " w=", fgd-field-age(fgtm-sample-write-epoch(sample), epoch)));
        def fgd-evictability-text(sample) = if str_eq(fgtm-sample-evictability(sample), "unknown") then "evict:unavailable" else str_concat("evict:", fgtm-sample-evictability(sample));
        def fgd-sample-stale?(sample) = if str_eq(fgtm-sample-source(sample), "glass.stale-snapshot") then 1 else if str_eq(fgtm-sample-source(sample), "glass.projection-stale") then 1 else 0;
        def fgd-sample-line(sample, width) = fgd-fit(fgd-cat(list(fgd-state-symbol(fgtm-sample-lifecycle(sample)), " ", fgtm-sample-id(sample), " [", fgtm-sample-kind(sample), "] ", fgd-sample-amount(sample), " ", fgtm-sample-lifecycle(sample), " ", fgd-truth-symbol(fgtm-sample-evidence(sample)), " ", fgd-evictability-text(sample))), width);
        def fgd-sample-line-at(sample, width, epoch) = fgd-fit(fgd-cat(list(fgd-state-symbol(fgtm-sample-lifecycle(sample)), " ", fgtm-sample-id(sample), " [", fgtm-sample-kind(sample), "] ", fgd-sample-amount(sample), " ", fgtm-sample-lifecycle(sample), " ", fgd-truth-symbol(fgtm-sample-evidence(sample)), if eq(fgd-sample-stale?(sample), 1) then " stale " else " ", fgd-sample-age-text(sample, epoch), " ", fgd-evictability-text(sample))), width);

        // A map item keeps extent, evidence, age, plane, and channels together.
        // Unknown size is a first-class shape: it is never rendered as zero.
        def fgd-map-item(id, label, present, value, unit, plane, evidence, alpha, channels, state) = list("fgd-map-item-v1", id, label, present, value, unit, plane, evidence, alpha, channels, state);
        def fgd-map-id(item) = nth(item, 1);
        def fgd-map-label(item) = nth(item, 2);
        def fgd-map-present?(item) = nth(item, 3);
        def fgd-map-value(item) = nth(item, 4);
        def fgd-map-unit(item) = nth(item, 5);
        def fgd-map-plane(item) = nth(item, 6);
        def fgd-map-evidence(item) = nth(item, 7);
        def fgd-map-alpha(item) = nth(item, 8);
        def fgd-map-channels(item) = nth(item, 9);
        def fgd-map-state(item) = nth(item, 10);
        def fgd-map-byte-unit?(unit) = if str_eq(unit, "bytes") then 1 else 0;
        def fgd-map-shape-unit?(unit) = if str_eq(unit, "cells") then 1 else if str_eq(unit, "nodes") then 1 else if str_eq(unit, "tensors") then 1 else if str_eq(unit, "entries") then 1 else if str_eq(unit, "children") then 1 else 0;
        def fgd-map-unit?(unit) = if eq(fgd-map-byte-unit?(unit), 1) then 1 else fgd-map-shape-unit?(unit);
        def fgd-map-metric?(metric) = if eq(len(metric), 0) then 0 else if eq(fgo-present?(metric), 0) then fgd-map-unit?(fgo-unit(metric)) else if not(str_eq(fgo-value-kind(metric), "int")) then 0 else fgd-map-unit?(fgo-unit(metric));
        def fgd-map-metric-alpha(metric) = if str_eq(fgo-evidence(metric), "physical-live") then 255 else if str_eq(fgo-evidence(metric), "derived-window") then 216 else if str_eq(fgo-evidence(metric), "catalog") then 176 else if str_eq(fgo-evidence(metric), "declared") then 144 else 64;
        def fgd-map-metric-item(metric) = fgd-map-item(str_concat("metric.", fgo-id(metric)), fgo-label(metric), fgo-present?(metric), if eq(fgo-present?(metric), 1) then fgo-int-value(metric) else 0, fgo-unit(metric), fgo-plane(metric), fgo-evidence(metric), fgd-map-metric-alpha(metric), list(fgo-channel(metric), fgo-domain(metric)), "metric");
        def fgd-map-byte-metric-items(metrics) = if eq(len(metrics), 0) then list() else if and(eq(fgd-map-metric?(head(metrics)), 1), eq(fgd-map-byte-unit?(fgo-unit(head(metrics))), 1)) then cons(fgd-map-metric-item(head(metrics)), fgd-map-byte-metric-items(tail(metrics))) else fgd-map-byte-metric-items(tail(metrics));
        def fgd-map-shape-metric-items(metrics) = if eq(len(metrics), 0) then list() else if and(eq(fgd-map-metric?(head(metrics)), 1), eq(fgd-map-shape-unit?(fgo-unit(head(metrics))), 1)) then cons(fgd-map-metric-item(head(metrics)), fgd-map-shape-metric-items(tail(metrics))) else fgd-map-shape-metric-items(tail(metrics));
        def fgd-drop(rows, count) = if or(le(count, 0), eq(len(rows), 0)) then rows else fgd-drop(tail(rows), sub(count, 1));
        def fgd-map-priority-metric-items(metrics) {
            let bytes = fgd-map-byte-metric-items(metrics);
            let shapes = fgd-map-shape-metric-items(metrics);
            let knownBytes = fgd-map-known(bytes);
            let knownShapes = fgd-map-known(shapes);
            let unknown = append(fgd-map-unknown(bytes), fgd-map-unknown(shapes));
            append(fgd-take(knownBytes, 2), append(knownShapes, append(fgd-drop(knownBytes, 2), unknown)));
        }
        def fgd-map-sample-item(sample, epoch) = fgd-map-item(fgtm-sample-id(sample), fgtm-sample-id(sample), fgtm-field-present?(fgtm-sample-bytes(sample)), fgd-field-number(fgtm-sample-bytes(sample)), "bytes", fgtm-sample-plane(sample), fgtm-sample-evidence(sample), fgd-sample-alpha(sample, epoch), fgtm-sample-channels(sample), fgtm-sample-lifecycle(sample));
        def fgd-map-sample-attached?(sample, allSamples) = if not(str_eq(fgtm-sample-evidence(sample), "catalog")) then 1 else if not(str_eq(fgtm-sample-kind(sample), "weights")) then 1 else if not(eq(fgtm-field-present?(fgtm-sample-parent(sample)), 1)) then 0 else fgd-physical-model-id?(allSamples, fgtm-field-value(fgtm-sample-parent(sample)));
        def fgd-map-sample-items(samples, allSamples, epoch, focus) = if eq(len(samples), 0) then list() else if and(eq(fgd-visible?(head(samples), focus), 1), eq(fgd-map-sample-attached?(head(samples), allSamples), 1)) then cons(fgd-map-sample-item(head(samples), epoch), fgd-map-sample-items(tail(samples), allSamples, epoch, focus)) else fgd-map-sample-items(tail(samples), allSamples, epoch, focus);
        def fgd-map-known(items) = if eq(len(items), 0) then list() else if eq(fgd-map-present?(head(items)), 1) then cons(head(items), fgd-map-known(tail(items))) else fgd-map-known(tail(items));
        def fgd-map-unknown(items) = if eq(len(items), 0) then list() else if eq(fgd-map-present?(head(items)), 0) then cons(head(items), fgd-map-unknown(tail(items))) else fgd-map-unknown(tail(items));
        def fgd-map-unknown-count(items) = if eq(len(items), 0) then 0 else add(if eq(fgd-map-present?(head(items)), 0) then 1 else 0, fgd-map-unknown-count(tail(items)));
        def fgd-map-focused-metrics(metrics, focus) = if str_eq(focus, "all") then metrics else fgd-filter-metrics(metrics, focus);
        def fgd-map-items(metrics, samples, epoch, focus) = append(fgd-map-sample-items(samples, samples, epoch, focus), fgd-map-priority-metric-items(fgd-map-focused-metrics(metrics, focus)));
        def fgd-log2-shape(value) = if le(value, 0) then 0 else if eq(value, 1) then 1 else add(1, fgd-log2-shape(div(value, 2)));
        def fgd-map-shape(value, width) = if le(value, 0) then 0 else fgd-clamp(fgd-log2-shape(value), 1, width);
        def fgd-map-amount(item) = if eq(fgd-map-present?(item), 0) then "unknown" else if str_eq(fgd-map-unit(item), "bytes") then fgd-format-bytes(fgd-map-value(item)) else str_concat(fgd-format-count(fgd-map-value(item)), str_concat(" ", fgd-map-unit(item)));
        def fgd-map-line(item, width) {
            let labelWidth = fgd-clamp(div(width, 3), 8, 24);
            let amount = fgd-map-amount(item);
            let barWidth = fgd-max(3, sub(width, add(labelWidth, add(str_len(amount), 8))));
            let fill = if eq(fgd-map-present?(item), 1) then fgd-map-shape(fgd-map-value(item), barWidth) else 0;
            let bar = if eq(fgd-map-present?(item), 1) then str_concat(fgd-hashes(fill), fgd-dots(sub(barWidth, fill))) else fgd-repeat("?", barWidth);
            fgd-fit(fgd-cat(list(fgd-truth-symbol(fgd-map-evidence(item)), fgd-state-symbol(fgd-map-state(item)), " ", fgd-pad-right(fgd-map-label(item), labelWidth), " [", bar, "] ", amount)), width);
        }
        def fgd-map-color-plane(plane) = if str_eq(plane, "os-memory") then "unified" else if str_eq(plane, "unified-gpu") then "unified" else if str_eq(plane, "disk-cache") then "disk" else if str_eq(plane, "mapped-file") then "disk" else if str_eq(plane, "cpu-arena") then "cpu" else if str_eq(plane, "cpu-stack") then "cpu" else plane;
        def fgd-map-style(item) = fgd-style-for-plane(fgd-map-color-plane(fgd-map-plane(item)), fgd-map-alpha(item), if str_eq(fgd-map-state(item), "active") then 1 else 0);
        def fgd-map-segment-line(item, width) = fgd-segment-line(fgd-map-line(item, width), width, fgd-map-style(item), fgd-map-id(item), fgd-map-channels(item), fgd-map-evidence(item));
        def fgd-map-segment-lines(items, width) = if eq(len(items), 0) then list() else cons(fgd-map-segment-line(head(items), width), fgd-map-segment-lines(tail(items), width));
        def fgd-map-unavailable-line(count, width) = if le(count, 0) then list() else fgd-segment-line(fgd-cat(list("? unavailable regions=", int_to_str(count), " (carrier seams)")), width, fgd-neutral(64), "memory.unavailable", list("memory", "health"), "unavailable");
        def fgd-map-lines(metrics, samples, epoch, focus, width, limit) {
            let allItems = fgd-map-items(metrics, samples, epoch, focus);
            let known = fgd-take(fgd-map-known(allItems), fgd-max(0, sub(limit, if gt(fgd-map-unknown-count(allItems), 0) then 1 else 0)));
            let missing = fgd-map-unknown-count(allItems);
            if gt(missing, 0) then append(fgd-map-segment-lines(known, width), list(fgd-map-unavailable-line(missing, width))) else fgd-map-segment-lines(known, width);
        }

        def fgd-put-section-title(canvas, x, y, width, title, style) {
            let line = fgd-fit(str_concat(title, str_concat(" ", fgd-repeat("-", fgd-max(0, sub(width, add(str_len(title), 1)))))), width);
            ftc-put-text(canvas, x, y, line, style);
        }
        def fgd-put-metrics(canvas, rows, x, y, width, count) = if or(le(count, 0), eq(len(rows), 0)) then canvas else fgd-put-metrics(ftc-put-text(canvas, x, y, fgd-metric-line(head(rows), width), fgd-style-for-metric(head(rows))), tail(rows), x, add(y, 1), width, sub(count, 1));
        def fgd-put-sample-line(canvas, sample, x, y, width, epoch) {
            let style = fgd-sample-style(sample, epoch);
            let withSymbol = ftc-put-glyph(canvas, x, y, ftc-style-symbol(style), style);
            ftc-put-text(withSymbol, add(x, 2), y, fgd-sample-line-at(sample, sub(width, 2), epoch), style);
        }
        def fgd-put-samples(canvas, rows, x, y, width, epoch) = if eq(len(rows), 0) then canvas else fgd-put-samples(fgd-put-sample-line(canvas, head(rows), x, y, width, epoch), tail(rows), x, add(y, 1), width, epoch);

        def fgd-current-or-last-observed-model?(sample) = if str_eq(fgtm-sample-evidence(sample), "physical-live") then 1 else if and(str_eq(fgtm-sample-evidence(sample), "derived-window"), str_eq(fgtm-sample-source(sample), "glass.stale-snapshot")) then 1 else 0;
        def fgd-physical-model-id?(samples, id) = if eq(len(samples), 0) then 0 else if and(str_eq(fgtm-sample-id(head(samples)), id), and(str_eq(fgtm-sample-kind(head(samples)), "model"), and(eq(fgd-current-or-last-observed-model?(head(samples)), 1), not(str_eq(fgtm-sample-lifecycle(head(samples)), "released"))))) then 1 else fgd-physical-model-id?(tail(samples), id);
        def fgd-resident-byte-sample?(sample, allSamples) = if not(eq(fgtm-field-present?(fgtm-sample-bytes(sample)), 1)) then 0 else if str_eq(fgtm-sample-evidence(sample), "physical-live") then if str_eq(fgtm-sample-plane(sample), "metal") then 1 else if str_eq(fgtm-sample-plane(sample), "mlx") then 1 else if str_eq(fgtm-sample-plane(sample), "unified") then 1 else if str_eq(fgtm-sample-plane(sample), "gpu") then 1 else 0 else if and(str_eq(fgtm-sample-evidence(sample), "catalog"), and(str_eq(fgtm-sample-kind(sample), "weights"), eq(fgtm-field-present?(fgtm-sample-parent(sample)), 1))) then fgd-physical-model-id?(allSamples, fgtm-field-value(fgtm-sample-parent(sample))) else 0;
        def fgd-memory-bar-value-go(samples, allSamples) = if eq(len(samples), 0) then 0 else add(if eq(fgd-resident-byte-sample?(head(samples), allSamples), 1) then fgd-field-number(fgtm-sample-bytes(head(samples))) else 0, fgd-memory-bar-value-go(tail(samples), allSamples));
        def fgd-memory-bar-value(samples) = fgd-memory-bar-value-go(samples, samples);
        def fgd-budget-capacity?(sample) = if not(eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1)) then 0 else if str_eq(fgtm-sample-kind(sample), "budget") then 1 else 0;
        def fgd-memory-bar-capacity-go(samples, allSamples, fallback) = if eq(len(samples), 0) then fallback else if eq(fgd-budget-capacity?(head(samples)), 1) then fgd-max(fgtm-field-value(fgtm-sample-capacity(head(samples))), fgd-memory-bar-capacity-go(tail(samples), allSamples, fallback)) else if and(eq(fgd-resident-byte-sample?(head(samples), allSamples), 1), eq(fgtm-field-present?(fgtm-sample-capacity(head(samples))), 1)) then fgd-max(fgtm-field-value(fgtm-sample-capacity(head(samples))), fgd-memory-bar-capacity-go(tail(samples), allSamples, fallback)) else fgd-memory-bar-capacity-go(tail(samples), allSamples, fallback);
        def fgd-memory-bar-capacity(samples, fallback) = fgd-memory-bar-capacity-go(samples, samples, fallback);
        def fgd-model-id-stale?(samples, id) = if eq(len(samples), 0) then 0 else if and(str_eq(fgtm-sample-id(head(samples)), id), and(str_eq(fgtm-sample-kind(head(samples)), "model"), eq(fgd-sample-stale?(head(samples)), 1))) then 1 else fgd-model-id-stale?(tail(samples), id);
        def fgd-resident-contributor-stale?(sample, allSamples) = if eq(fgd-sample-stale?(sample), 1) then 1 else if and(str_eq(fgtm-sample-evidence(sample), "catalog"), and(str_eq(fgtm-sample-kind(sample), "weights"), eq(fgtm-field-present?(fgtm-sample-parent(sample)), 1))) then fgd-model-id-stale?(allSamples, fgtm-field-value(fgtm-sample-parent(sample))) else 0;
        def fgd-memory-bar-has-stale?(samples, allSamples) = if eq(len(samples), 0) then 0 else if and(eq(fgd-resident-byte-sample?(head(samples), allSamples), 1), eq(fgd-resident-contributor-stale?(head(samples), allSamples), 1)) then 1 else fgd-memory-bar-has-stale?(tail(samples), allSamples);
        def fgd-memory-bar-evidence(samples) = if eq(fgd-memory-bar-has-stale?(samples, samples), 1) then "derived-window" else "physical-live";

        // Retained segment projection is the live fast lane.  It follows the
        // Rich lesson directly: measure, allocate regions, then emit styled
        // text runs.  The cell canvas remains the exact raster/diff adapter.
        def fgd-segment-line(text, width, style, nodeId, channels, evidence) = list(ftc-segment(fgd-fit(text, width), style, "none", nodeId, channels, evidence));
        def fgd-blank-segment-line(width) = fgd-segment-line("", width, fgd-neutral(40), "glass.blank", list(), "declared");
        def fgd-title-segment-line(text, width, nodeId) = fgd-segment-line(text, width, fgd-title(), nodeId, list("all"), "declared");
        def fgd-sample-segment-line(sample, width, epoch) = fgd-segment-line(fgd-sample-line-at(sample, width, epoch), width, fgd-sample-style(sample, epoch), fgtm-sample-id(sample), fgtm-sample-channels(sample), fgtm-sample-evidence(sample));
        def fgd-metric-style(metric) = if eq(len(metric), 0) then fgd-neutral(56) else fgd-style-for-metric(metric);
        def fgd-metric-id-or-missing(metric) = if eq(len(metric), 0) then "metric.missing" else str_concat("metric.", fgo-id(metric));
        def fgd-metric-evidence-or-missing(metric) = if eq(len(metric), 0) then "unavailable" else fgo-evidence(metric);
        def fgd-metric-channels(metric) = if eq(len(metric), 0) then list("health") else list(fgo-channel(metric), fgo-domain(metric));
        def fgd-metric-segment-line(metric, width) = fgd-segment-line(fgd-metric-line(metric, width), width, fgd-metric-style(metric), fgd-metric-id-or-missing(metric), fgd-metric-channels(metric), fgd-metric-evidence-or-missing(metric));
        def fgd-segment-row-text(text, width, style, nodeId, channel, evidence) = ftc-segment(fgd-fit(text, width), style, "none", nodeId, list(channel), evidence);
        def fgd-line-or-blank(lines, index, width) = if or(lt(index, 0), ge(index, len(lines))) then fgd-blank-segment-line(width) else nth(lines, index);
        def fgd-sample-segment-lines(samples, width, epoch) = if eq(len(samples), 0) then list() else cons(fgd-sample-segment-line(head(samples), width, epoch), fgd-sample-segment-lines(tail(samples), width, epoch));
        def fgd-metric-segment-lines(metrics, width) = if eq(len(metrics), 0) then list() else cons(fgd-metric-segment-line(head(metrics), width), fgd-metric-segment-lines(tail(metrics), width));
        def fgd-count-visible(samples, focus) = if eq(len(samples), 0) then 0 else add(if eq(fgd-visible?(head(samples), focus), 1) then 1 else 0, fgd-count-visible(tail(samples), focus));
        def fgd-bar-text(width, value, maximum) {
            let filled = if le(maximum, 0) then 0 else fgd-clamp(div(mul(width, value), maximum), 0, width);
            str_concat(fgd-hashes(filled), fgd-dots(sub(width, filled)));
        }
        def fgd-memory-bar-segment(samples, width) {
            let value = fgd-memory-bar-value(samples);
            let capacity = fgd-memory-bar-capacity(samples, value);
            let evidence = fgd-memory-bar-evidence(samples);
            if le(capacity, 0) then fgd-segment-line("unified residence unavailable door=model.resident-byte-join", width, fgd-neutral(96), "memory.capacity", list("memory", "metal"), "unavailable") else fgd-segment-line(fgd-cat(list(if str_eq(evidence, "derived-window") then "last-observed residence " else "resident ", fgd-format-bytes(value), " / budget ", fgd-format-bytes(capacity), " ", fgd-bar-text(fgd-max(4, sub(width, 30)), value, capacity))), width, fgd-style-for-plane("metal", if str_eq(evidence, "derived-window") then 112 else 220, if str_eq(evidence, "physical-live") then 1 else 0), "memory.capacity", list("memory", "metal"), evidence);
        }
        def fgd-wide-row(leftLines, rightLines, index, leftWidth, gap, rightWidth) {
            let left = fgd-line-or-blank(leftLines, index, leftWidth);
            let right = fgd-line-or-blank(rightLines, index, rightWidth);
            append(left, append(list(ftc-segment(fgd-spaces(gap), fgd-neutral(40), "none", "layout.gap", list("all"), "declared")), right));
        }
        def fgd-wide-lines-go(leftLines, rightLines, index, count, leftWidth, gap, rightWidth) = if ge(index, count) then list() else cons(fgd-wide-row(leftLines, rightLines, index, leftWidth, gap, rightWidth), fgd-wide-lines-go(leftLines, rightLines, add(index, 1), count, leftWidth, gap, rightWidth));
        def fgd-wide-lines(width, bodyCount, epoch, focus, metrics, samples) {
            let gap = 3;
            let selectedMetrics = fgd-present-metrics(fgd-focus-metrics(metrics, focus));
            let sampleMeasure = ftc-measure(40, fgd-max(40, fgd-longest-sample-width(samples, 0)));
            let metricMeasure = ftc-measure(36, fgd-max(36, fgd-longest-metric-width(selectedMetrics, 0)));
            let regions = ftc-measured-split(width, bodyCount, gap, sampleMeasure, metricMeasure);
            let leftWidth = ftc-region-width(head(regions));
            let rightWidth = ftc-region-width(nth(regions, 1));
            let mapLimit = fgd-min(7, fgd-max(1, div(fgd-max(1, sub(bodyCount, 1)), 2)));
            let mapLines = fgd-map-lines(metrics, samples, epoch, focus, leftWidth, mapLimit);
            let sampleLimit = fgd-max(0, sub(bodyCount, add(1, len(mapLines))));
            let topSamples = fgd-top-samples(samples, focus, sampleLimit);
            let hidden = fgd-max(0, sub(fgd-count-visible(samples, focus), len(topSamples)));
            let metricLimit = fgd-max(0, sub(bodyCount, 1));
            let hiddenMetrics = fgd-max(0, sub(len(selectedMetrics), metricLimit));
            let sampleTitle = fgd-title-segment-line(fgd-cat(list("MEMORY MAP / MODELS [", int_to_str(len(samples)), "] hidden=", int_to_str(hidden))), leftWidth, "section.memory");
            let leftLines = cons(sampleTitle, append(mapLines, fgd-sample-segment-lines(topSamples, leftWidth, epoch)));
            let metricTitle = fgd-title-segment-line(fgd-cat(list("ORGANS / HEALTH hidden=", int_to_str(hiddenMetrics))), rightWidth, "section.organs");
            let rightLines = cons(metricTitle, fgd-metric-segment-lines(selectedMetrics, rightWidth));
            fgd-wide-lines-go(leftLines, rightLines, 0, bodyCount, leftWidth, gap, rightWidth);
        }
        def fgd-fill-lines(lines, count, width) = if le(count, 0) then list() else if eq(len(lines), 0) then cons(fgd-blank-segment-line(width), fgd-fill-lines(list(), sub(count, 1), width)) else cons(head(lines), fgd-fill-lines(tail(lines), sub(count, 1), width));
        def fgd-narrow-lines(width, bodyCount, epoch, focus, metrics, samples) {
            let available = fgd-max(0, sub(bodyCount, 2));
            let mapLimit = if ge(width, 72) then fgd-min(7, fgd-max(1, div(fgd-max(1, available), 2))) else fgd-min(5, fgd-max(1, div(fgd-max(1, available), 2)));
            let sampleLimit = fgd-min(3, fgd-max(0, div(fgd-max(0, sub(available, mapLimit)), 2)));
            let metricLimit = fgd-max(0, sub(available, add(mapLimit, sampleLimit)));
            let mapLines = fgd-map-lines(metrics, samples, epoch, focus, width, mapLimit);
            let topSamples = fgd-top-samples(samples, focus, sampleLimit);
            let hidden = fgd-max(0, sub(fgd-count-visible(samples, focus), len(topSamples)));
            let selectedMetrics = fgd-present-metrics(fgd-focus-metrics(metrics, focus));
            let hiddenMetrics = fgd-max(0, sub(len(selectedMetrics), metricLimit));
            let sampleTitle = fgd-title-segment-line(fgd-cat(list("MEMORY MAP / MODELS [", int_to_str(len(samples)), "] hidden=", int_to_str(hidden))), width, "section.memory");
            let metricTitle = fgd-title-segment-line(fgd-cat(list("ORGANS / HEALTH hidden=", int_to_str(hiddenMetrics))), width, "section.organs");
            let lines = append(list(sampleTitle), append(mapLines, append(fgd-sample-segment-lines(topSamples, width, epoch), cons(metricTitle, fgd-metric-segment-lines(fgd-take(selectedMetrics, metricLimit), width)))));
            fgd-fill-lines(lines, bodyCount, width);
        }
        def fgd-hidden-metrics(width, bodyCount, focus, metrics, samples) {
            let selected = fgd-present-metrics(fgd-focus-metrics(metrics, focus));
            let available = fgd-max(0, sub(bodyCount, 2));
            let mapLimit = if ge(width, 72) then fgd-min(7, fgd-max(1, div(fgd-max(1, available), 2))) else fgd-min(5, fgd-max(1, div(fgd-max(1, available), 2)));
            let sampleLimit = fgd-min(3, fgd-max(0, div(fgd-max(0, sub(available, mapLimit)), 2)));
            let metricLimit = if ge(width, 100) then fgd-max(0, sub(bodyCount, 1)) else fgd-max(0, sub(available, add(mapLimit, sampleLimit)));
            fgd-max(0, sub(len(selected), metricLimit));
        }

        def fgd-compact-frame(width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let header = fgd-title-segment-line(fgd-cat(list("GLASS ", int_to_str(width), "x", int_to_str(height), " ", focus)), width, "glass.header");
            let footer = fgd-segment-line(fgd-cat(list("m=", int_to_str(len(samples)), " p=", int_to_str(len(publishers)), " ", controlState)), width, fgd-neutral(176), "glass.footer", list("all", "membrane"), "physical-live");
            let bodyCount = fgd-max(0, sub(height, 2));
            let body = fgd-narrow-lines(width, bodyCount, epoch, focus, metrics, samples);
            let lines = if le(height, 1) then list(header) else append(list(header), append(body, list(footer)));
            let hiddenSamples = fgd-max(0, sub(fgd-count-visible(samples, focus), bodyCount));
            let hiddenMetrics = fgd-hidden-metrics(width, bodyCount, focus, metrics, samples);
            list("form-glass-segment-frame-v1", width, height, lines, ftc-overflow("hidden-count", add(hiddenSamples, hiddenMetrics)));
        }
        def fgd-segment-frame(width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let safeWidth = fgd-clamp(width, 1, 1000);
            let safeHeight = fgd-clamp(height, 1, 300);
            let bodyCount = sub(safeHeight, 4);
            let header = fgd-title-segment-line(fgd-cat(list("FORM GLASS ", int_to_str(safeWidth), "x", int_to_str(safeHeight), " focus=", focus)), safeWidth, "glass.header");
            let legend = fgd-segment-line("states >active :prefill =ready oresident mmapped xreleased | *live +derived #catalog ~declared ?missing", safeWidth, fgd-neutral(176), "glass.legend", list("all"), "declared");
            let rule = fgd-title-segment-line(fgd-equals(safeWidth), safeWidth, "glass.rule");
            let body = if ge(safeWidth, 100) then fgd-wide-lines(safeWidth, bodyCount, epoch, focus, metrics, samples) else fgd-narrow-lines(safeWidth, bodyCount, epoch, focus, metrics, samples);
            let footer = fgd-segment-line(fgd-cat(list("publishers=", int_to_str(len(publishers)), " control=", controlState, " route=glass-monitor focus=visible sample/channel | form-glassctl")), safeWidth, fgd-neutral(176), "glass.footer", list("all", "membrane"), "physical-live");
            let hiddenSamples = fgd-max(0, sub(fgd-count-visible(samples, focus), sub(bodyCount, 2)));
            let hiddenMetrics = fgd-hidden-metrics(safeWidth, bodyCount, focus, metrics, samples);
            if or(lt(safeWidth, 40), lt(safeHeight, 12)) then fgd-compact-frame(safeWidth, safeHeight, epoch, focus, metrics, samples, publishers, controlState) else list("form-glass-segment-frame-v1", safeWidth, safeHeight, append(list(header, rule, legend), append(body, list(footer))), ftc-overflow("hidden-count", add(hiddenSamples, hiddenMetrics)));
        }
        def fgd-segment-frame-width(frame) = nth(frame, 1);
        def fgd-segment-frame-height(frame) = nth(frame, 2);
        def fgd-segment-frame-lines(frame) = nth(frame, 3);
        def fgd-segment-frame-overflow(frame) = nth(frame, 4);
        def fgd-segment-project(frame) = ftc-ansi-segment-lines(fgd-segment-frame-lines(frame));

        def fgd-scene-body(canvas, width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let wide = if ge(width, 100) then 1 else 0;
            let gap = if eq(wide, 1) then 3 else 0;
            let leftWidth = if eq(wide, 1) then div(sub(width, gap), 2) else width;
            let rightX = if eq(wide, 1) then add(leftWidth, gap) else 0;
            let rightWidth = if eq(wide, 1) then sub(width, rightX) else width;
            let usableRows = fgd-max(1, sub(height, 6));
            let sampleRows = if eq(wide, 1) then usableRows else fgd-max(3, div(usableRows, 2));
            let metricY = if eq(wide, 1) then 3 else add(4, sampleRows);
            let metricRows = if eq(wide, 1) then usableRows else fgd-max(1, sub(usableRows, add(sampleRows, 1)));
            let topSamples = fgd-top-samples(samples, focus, sampleRows);
            let important = fgd-focus-metrics(metrics, focus);
            let totalBytes = fgd-memory-bar-value(topSamples);
            let totalCapacity = fgd-memory-bar-capacity(topSamples, totalBytes);
            let left0 = fgd-put-section-title(canvas, 0, 3, leftWidth, fgd-cat(list("MEMORY / MODELS [", int_to_str(len(samples)), "]")), fgd-style-for-plane("unified", 255, 1));
            let left1 = if gt(leftWidth, 10) then ftc-blit(left0, ftc-bar(leftWidth, totalBytes, totalCapacity, fgd-style-for-plane("metal", 220, 1), fgd-neutral(64)), 0, 4) else left0;
            let left2 = fgd-put-samples(left1, topSamples, 0, 5, leftWidth, epoch);
            let titled = fgd-put-section-title(left2, rightX, metricY, rightWidth, "ORGANS / HEALTH", fgd-style-for-plane("form", 255, 1));
            let filled = fgd-put-metrics(titled, important, rightX, add(metricY, 1), rightWidth, metricRows);
            let footer = fgd-fit(fgd-cat(list("focus=", focus, " publishers=", int_to_str(len(publishers)), " control=", controlState, "  *live +derived #catalog ~declared ?missing")), width);
            ftc-put-text(filled, 0, sub(height, 1), footer, fgd-neutral(176));
        }

        def fgd-scene(width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let safeWidth = fgd-clamp(width, 1, 240);
            let safeHeight = fgd-clamp(height, 1, 80);
            let canvas = ftc-canvas(safeWidth, safeHeight, fgd-neutral(40));
            let header = fgd-fit(fgd-cat(list("FORM GLASS  ", int_to_str(safeWidth), "x", int_to_str(safeHeight), "  epoch ", int_to_str(epoch), "  scene=", FGDSchema())), safeWidth);
            let c0 = ftc-put-text(canvas, 0, 0, fgd-pad-right(header, safeWidth), fgd-title());
            let c1 = ftc-put-text(c0, 0, 1, fgd-repeat("=", safeWidth), fgd-title());
            let c2 = ftc-put-text(c1, 0, 2, fgd-fit("states: > active  : prefill  = ready  o resident  m mapped  x released | alpha = read/write age", safeWidth), fgd-neutral(176));
            let body = fgd-scene-body(c2, safeWidth, safeHeight, epoch, focus, metrics, samples, publishers, controlState);
            ftc-surface(body, ftc-capabilities(safeWidth, safeHeight, "observed-or-fallback"), list("all", "memory", "model", "gpu", "metal", "mlx", "cpu", "health", "cache", "query-lane", "primitive", "jit", "membrane", "network"));
        }
    }
    0;
}
