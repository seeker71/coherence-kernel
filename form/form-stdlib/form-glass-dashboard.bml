        def fgd-key-fold-in(key, hash, mask) = if eq(len(key), 0) then hash else fgd-key-fold-in(tail(key), band(add(mul(hash, 33), band(head(key), mask)), mask), mask);
        def fgd-key-hash(key) = fgd-key-fold(key, km-seed());
        // A trie node has sixteen slots. Copy an unchanged eight-slot prefix
