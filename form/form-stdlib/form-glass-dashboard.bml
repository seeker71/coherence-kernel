        def fgd-map-color-plane(plane) = if str_eq(plane, "os-memory") then "unified" else if str_eq(plane, "unified-gpu") then "unified" else if str_eq(plane, "disk-cache") then "disk" else if str_eq(plane, "mapped-file") then "disk" else if str_eq(plane, "cpu-arena") then "cpu" else if str_eq(plane, "cpu-stack") then "cpu" else plane;
