        def fgd-metric-value-bytes(metric) = if eq(len(metric), 0) then fgdb-text("?") else if eq(fgo-present?(metric), 0) then fgdb-text("?") else if str_eq(fgo-value-kind(metric), "text") then fgdb-text(fgo-text-value(metric)) else if and(eq(fgo-int-value(metric), 0), eq(fgd-semantic-zero-state?(fgo-lifecycle(metric)), 1)) then fgd-metric-semantic-zero-bytes(metric) else if str_eq(fgo-unit(metric), "bytes") then fgdb-format-bytes(fgo-int-value(metric)) else fgdb-format-count(fgo-int-value(metric));
