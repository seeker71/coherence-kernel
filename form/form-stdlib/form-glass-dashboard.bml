        def fgd-model-handle-count(samples) = (Comparable) len(samples) == 0 ? 0 : ((((String) fgtm-sample-kind(head(samples)) == "model") && ((Comparable) fgtm-field-present?(fgtm-sample-handle(head(samples))) == 1) ? 1 : 0) + fgd-model-handle-count(tail(samples)));
        def fgd-budget-capacity?(sample) = !((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1) ? 0 : (String) fgtm-sample-kind(sample) == "budget" ? 1 : 0;
        def fgd-memory-bar-capacity-go(samples, allSamples, fallback) = (Comparable) len(samples) == 0 ? fallback : (Comparable) fgd-budget-capacity?(head(samples)) == 1 ? fgd-max(fgtm-field-value(fgtm-sample-capacity(head(samples))), fgd-memory-bar-capacity-go(tail(samples), allSamples, fallback)) : fgd-memory-bar-capacity-go(tail(samples), allSamples, fallback);
        def fgd-memory-bar-capacity(samples, fallback) = fgd-memory-bar-capacity-go(samples, samples, fallback);
        def fgd-model-id-stale?(samples, id) = (Comparable) len(samples) == 0 ? 0 : ((String) fgtm-sample-id(head(samples)) == id) && (((String) fgtm-sample-kind(head(samples)) == "model") && ((Comparable) fgd-sample-stale?(head(samples)) == 1)) ? 1 : fgd-model-id-stale?(tail(samples), id);
        def fgd-resident-contributor-stale?(sample, allSamples) = (Comparable) fgd-sample-stale?(sample) == 1 ? 1 : ((String) fgtm-sample-evidence(sample) == "catalog") && (((String) fgtm-sample-kind(sample) == "weights") && ((Comparable) fgtm-field-present?(fgtm-sample-parent(sample)) == 1)) ? fgd-model-id-stale?(allSamples, fgtm-field-value(fgtm-sample-parent(sample))) : 0;
        def fgd-memory-bar-has-stale?(samples, allSamples) = (Comparable) len(samples) == 0 ? 0 : ((Comparable) fgd-resident-byte-sample?(head(samples), allSamples) == 1) && ((Comparable) fgd-resident-contributor-stale?(head(samples), allSamples) == 1) ? 1 : fgd-memory-bar-has-stale?(tail(samples), allSamples);
        def fgd-memory-bar-has-derived?(samples, allSamples) = (Comparable) len(samples) == 0 ? 0 : ((Comparable) fgd-resident-byte-sample?(head(samples), allSamples) == 1) && ((String) fgtm-sample-evidence(head(samples)) == "derived-window") ? 1 : fgd-memory-bar-has-derived?(tail(samples), allSamples);
        def fgd-memory-bar-evidence(samples) = ((Comparable) fgd-memory-bar-has-stale?(samples, samples) == 1) || ((Comparable) fgd-memory-bar-has-derived?(samples, samples) == 1) ? "derived-window" : "physical-live";
        def fgd-memory-bar-label(samples) = (Comparable) fgd-memory-bar-has-stale?(samples, samples) == 1 ? "last-observed allocated extents " : (Comparable) fgd-memory-bar-has-derived?(samples, samples) == 1 ? "derived allocated extents " : "allocated extents ";

        // Retained segment projection is the live fast lane.  It follows the
        // Rich lesson directly: measure, allocate regions, then emit styled
        // text runs.  The cell canvas remains the exact raster/diff adapter.
        def fgd-segment-line(text, width, style, nodeId, channels, evidence) = list(ftc-segment(fgd-fit(text, width), style, "none", nodeId, channels, evidence));
        def fgd-byte-segment-line(bytes, width, style, nodeId, channels, evidence) = list(ftc-segment(ftc-byte-text(fgdb-fit(bytes, width)), style, "none", nodeId, channels, evidence));
        def fgd-blank-segment-line(width) = fgd-segment-line("", width, fgd-neutral(40), "glass.blank", list(), "declared");
        // Composite rows share the same terminal width as single segments.
        // Preserve the clipped segment's style and evidence; never wrap into
        // another view row or split a UTF-8 sequence at the clipping boundary.
        def fgd-text-byte(text, at) = (Comparable) ftc-byte-text?(text) == 1 ? text[1][at] : str_byte_at(text, at);
        def fgd-text-boundary(text, at) = at <= 0 ? 0 : at >= ftc-text-width(text) ? at : (fgd-text-byte(text, at) >= 128) && (fgd-text-byte(text, at) <= 191) ? fgd-text-boundary(text, at - 1) : at;
        def fgd-clip-text(text, width) {
            let end = fgd-text-boundary(text, width);
            (Comparable) ftc-byte-text?(text) == 1 ? ftc-byte-text(fgd-take(text[1], end)) : substring(text, 0, end);
        }
        def fgd-clip-segment(segment, width) = ftc-segment(fgd-clip-text(ftc-segment-text(segment), width), ftc-segment-style(segment), ftc-segment-control(segment), ftc-segment-node-id(segment), ftc-segment-channels(segment), ftc-segment-evidence(segment));
        def fgd-clip-segments(segments, width) = (width <= 0) || ((Comparable) len(segments) == 0) ? list() : ftc-text-width(ftc-segment-text(head(segments))) > width ? list(fgd-clip-segment(head(segments), width)) : cons(head(segments), fgd-clip-segments(tail(segments), width - ftc-text-width(ftc-segment-text(head(segments)))));
        def fgd-clip-lines(lines, width) = (Comparable) len(lines) == 0 ? list() : cons(fgd-clip-segments(head(lines), width), fgd-clip-lines(tail(lines), width));
        def fgd-title-segment-line(text, width, nodeId) = fgd-segment-line(text, width, fgd-title(), nodeId, list("all"), "declared");
        def fgd-sample-segment-line(sample, width, epoch) = fgd-segment-line(fgd-sample-line-at(sample, width, epoch), width, fgd-sample-style(sample, epoch), fgd-sample-projection-id(sample), append(list(fgtm-sample-id(sample), "selector." ++ fgtm-sample-selection-id(sample)), fgtm-sample-channels(sample)), fgtm-sample-evidence(sample));
        def fgd-metric-style(metric) = (Comparable) len(metric) == 0 ? fgd-neutral(56) : fgd-style-for-metric(metric);
        def fgd-metric-id-or-missing(metric) = (Comparable) len(metric) == 0 ? "metric.missing" : (Comparable) fgo-nodeid-bound?(metric) == 1 ? fgo-nodeid-value(metric) : "metric." ++ fgo-id(metric);
        def fgd-metric-evidence-or-missing(metric) = (Comparable) len(metric) == 0 ? "unavailable" : fgo-evidence(metric);
        def fgd-metric-selector(metric) = fgd-cat(list("metric.", fgo-domain(metric), ".", fgo-id(metric)));
        def fgd-metric-channels(metric) = (Comparable) len(metric) == 0 ? list("health") : list("selector." ++ fgd-metric-selector(metric), fgo-channel(metric), fgo-domain(metric));
        def fgd-metric-segment-line(metric, width) = fgd-byte-segment-line(fgd-metric-line-bytes(metric, width), width, fgd-metric-style(metric), fgd-metric-id-or-missing(metric), fgd-metric-channels(metric), fgd-metric-evidence-or-missing(metric));
        def fgd-segment-row-text(text, width, style, nodeId, channel, evidence) = ftc-segment(fgd-fit(text, width), style, "none", nodeId, list(channel), evidence);
        def fgd-line-or-blank(lines, index, width) = (index < 0) || (index >= len(lines)) ? fgd-blank-segment-line(width) : lines[index];
        def fgd-sample-segment-lines(samples, width, epoch) = (Comparable) len(samples) == 0 ? list() : cons(fgd-sample-segment-line(head(samples), width, epoch), fgd-sample-segment-lines(tail(samples), width, epoch));
        def fgd-metric-segment-lines(metrics, width) = (Comparable) len(metrics) == 0 ? list() : cons(fgd-metric-segment-line(head(metrics), width), fgd-metric-segment-lines(tail(metrics), width));
        def fgd-count-visible(samples, focus) = (Comparable) len(samples) == 0 ? 0 : (((Comparable) fgd-visible?(head(samples), focus) == 1 ? 1 : 0) + fgd-count-visible(tail(samples), focus));
        def fgd-bar-text(width, value, maximum) {
            let filled = maximum <= 0 ? 0 : fgd-clamp((width * value) / maximum, 0, width);
            fgd-hashes(filled) ++ fgd-dots(width - filled);
        }
        def fgd-memory-bar-segment(samples, width) {
            let value = fgd-memory-bar-value(samples);
            let capacity = fgd-memory-bar-capacity(samples, 0);
            let evidence = fgd-memory-bar-evidence(samples);
            let contributors = fgd-memory-bar-contributors(samples);
            let artifact = fgd-logical-artifact-bytes(samples);
            let handles = fgd-model-handle-count(samples);
            (Comparable) contributors == 0 ? fgd-segment-line(fgd-cat(list("materialized=? door=model.materialized-resident-bytes artifact=", artifact > 0 ? fgd-format-bytes(artifact) : "absent", "(catalog) handles=", int_to_str(handles), " callable=? door=model.route-readiness")), width, fgd-neutral(96), "memory.materialized", list("memory", "metal", "model"), "unavailable") : capacity <= 0 ? fgd-segment-line(fgd-cat(list(fgd-memory-bar-label(samples), fgd-format-bytes(value), " budget=? door=model.resident-byte-capacity")), width, fgd-neutral(96), "memory.capacity", list("memory", "metal"), "unavailable") : fgd-segment-line(fgd-cat(list(fgd-memory-bar-label(samples), fgd-format-bytes(value), " / budget ", fgd-format-bytes(capacity), " ", fgd-bar-text(fgd-max(4, width - 30), value, capacity))), width, fgd-style-for-plane("metal", (String) evidence == "derived-window" ? 112 : 220, (String) evidence == "physical-live" ? 1 : 0), "memory.capacity", list("memory", "metal"), evidence);
        }
        def fgd-segment-line-width(line) = (Comparable) len(line) == 0 ? 0 : (ftc-text-width(ftc-segment-text(head(line))) + fgd-segment-line-width(tail(line)));
        // A region owns its allocated width even when its content is short or
        // absent. Keep padding separate so source styles, nodes and evidence
        // survive composition, and clip each region before joining its neighbor.
        def fgd-region-line(line, width) {
            let clipped = fgd-clip-segments(line, width);
            let room = fgd-max(0, width - fgd-segment-line-width(clipped));
            (Comparable) room == 0 ? clipped : append(clipped, list(ftc-segment(fgd-spaces(room), fgd-neutral(40), "none", "layout.padding", list("all"), "declared")));
        }
        def fgd-wide-row(leftLines, rightLines, index, leftWidth, gap, rightWidth) {
            let left = fgd-region-line(fgd-line-or-blank(leftLines, index, leftWidth), leftWidth);
            let right = fgd-clip-segments(fgd-line-or-blank(rightLines, index, rightWidth), rightWidth);
            append(left, append(list(ftc-segment(fgd-spaces(gap), fgd-neutral(40), "none", "layout.gap", list("all"), "declared")), right));
        }
        def fgd-wide-lines-go(leftLines, rightLines, index, count, leftWidth, gap, rightWidth) = index >= count ? list() : cons(fgd-wide-row(leftLines, rightLines, index, leftWidth, gap, rightWidth), fgd-wide-lines-go(leftLines, rightLines, index + 1, count, leftWidth, gap, rightWidth));
        def fgd-wide-lines(width, bodyCount, epoch, focus, metrics, samples) {
            let gap = 3;
            let selectedMetrics = fgd-present-metrics(fgd-focus-metrics(metrics, focus));
            let sampleMeasure = ftc-measure(40, fgd-max(40, fgd-longest-sample-width(samples, 0)));
            let metricMeasure = ftc-measure(36, fgd-max(36, fgd-longest-metric-width(selectedMetrics, 0)));
            let regions = ftc-measured-split(width, bodyCount, gap, sampleMeasure, metricMeasure);
            let leftWidth = ftc-region-width(head(regions));
            let rightWidth = ftc-region-width(regions[1]);
            let mapLimit = fgd-min(7, fgd-max(1, fgd-max(1, bodyCount - 1) / 2));
            let mapLines = fgd-map-lines(metrics, samples, epoch, focus, leftWidth, mapLimit);
            let sampleLimit = fgd-max(0, bodyCount - (1 + len(mapLines)));
            let topSamples = fgd-top-samples(samples, focus, sampleLimit);
            let hidden = fgd-max(0, fgd-count-visible(samples, focus) - len(topSamples));
            let metricLimit = fgd-max(0, bodyCount - 1);
            let hiddenMetrics = fgd-max(0, len(selectedMetrics) - metricLimit);
            let sampleTitle = fgd-title-segment-line(fgd-cat(list("MEMORY MAP / MODELS [", int_to_str(len(samples)), "] hidden=", int_to_str(hidden))), leftWidth, "section.memory");
            let leftLines = cons(sampleTitle, append(mapLines, fgd-sample-segment-lines(topSamples, leftWidth, epoch)));
            let metricTitle = fgd-title-segment-line(fgd-cat(list("ORGANS / HEALTH hidden=", int_to_str(hiddenMetrics))), rightWidth, "section.organs");
            let rightLines = cons(metricTitle, fgd-metric-segment-lines(selectedMetrics, rightWidth));
            fgd-wide-lines-go(leftLines, rightLines, 0, bodyCount, leftWidth, gap, rightWidth);
        }
        def fgd-fill-lines(lines, count, width) = count <= 0 ? list() : (Comparable) len(lines) == 0 ? cons(fgd-blank-segment-line(width), fgd-fill-lines(list(), count - 1, width)) : cons(head(lines), fgd-fill-lines(tail(lines), count - 1, width));
        def fgd-narrow-lines(width, bodyCount, epoch, focus, metrics, samples) {
            let available = fgd-max(0, bodyCount - 2);
            let mapLimit = width >= 72 ? fgd-min(7, fgd-max(1, fgd-max(1, available) / 2)) : fgd-min(5, fgd-max(1, fgd-max(1, available) / 2));
            let sampleLimit = fgd-min(3, fgd-max(0, fgd-max(0, available - mapLimit) / 2));
            let metricLimit = fgd-max(0, available - (mapLimit + sampleLimit));
            let mapLines = fgd-map-lines(metrics, samples, epoch, focus, width, mapLimit);
            let topSamples = fgd-top-samples(samples, focus, sampleLimit);
            let hidden = fgd-max(0, fgd-count-visible(samples, focus) - len(topSamples));
            let selectedMetrics = fgd-present-metrics(fgd-focus-metrics(metrics, focus));
            let hiddenMetrics = fgd-max(0, len(selectedMetrics) - metricLimit);
            let sampleTitle = fgd-title-segment-line(fgd-cat(list("MEMORY MAP / MODELS [", int_to_str(len(samples)), "] hidden=", int_to_str(hidden))), width, "section.memory");
            let metricTitle = fgd-title-segment-line(fgd-cat(list("ORGANS / HEALTH hidden=", int_to_str(hiddenMetrics))), width, "section.organs");
            let lines = append(list(sampleTitle), append(mapLines, append(fgd-sample-segment-lines(topSamples, width, epoch), cons(metricTitle, fgd-metric-segment-lines(fgd-take(selectedMetrics, metricLimit), width)))));
            fgd-fill-lines(lines, bodyCount, width);
        }
        def fgd-hidden-metrics(width, bodyCount, focus, metrics, samples) {
            let selected = fgd-present-metrics(fgd-focus-metrics(metrics, focus));
            let available = fgd-max(0, bodyCount - 2);
            let mapLimit = width >= 72 ? fgd-min(7, fgd-max(1, fgd-max(1, available) / 2)) : fgd-min(5, fgd-max(1, fgd-max(1, available) / 2));
            let sampleLimit = fgd-min(3, fgd-max(0, fgd-max(0, available - mapLimit) / 2));
            let metricLimit = width >= 100 ? fgd-max(0, bodyCount - 1) : fgd-max(0, available - (mapLimit + sampleLimit));
            fgd-max(0, len(selected) - metricLimit);
        }

        def fgd-compact-frame(width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let header = fgd-title-segment-line(fgd-cat(list("GLASS ", int_to_str(width), "x", int_to_str(height), " ", focus)), width, "glass.header");
            let footer = fgd-segment-line(fgd-cat(list("m=", int_to_str(len(samples)), " p=", int_to_str(len(publishers)), " ", controlState)), width, fgd-neutral(176), "glass.footer", list("all", "membrane"), "physical-live");
            let bodyCount = fgd-max(0, height - 2);
            let body = fgd-narrow-lines(width, bodyCount, epoch, focus, metrics, samples);
            let lines = height <= 1 ? list(header) : append(list(header), append(body, list(footer)));
            let hiddenSamples = fgd-max(0, fgd-count-visible(samples, focus) - bodyCount);
            let hiddenMetrics = fgd-hidden-metrics(width, bodyCount, focus, metrics, samples);
            list("form-glass-segment-frame-v1", width, height, lines, ftc-overflow("hidden-count", hiddenSamples + hiddenMetrics));
        }
        def fgd-segment-frame(width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let safeWidth = fgd-clamp(width, 1, 1000);
            let safeHeight = fgd-clamp(height, 1, 300);
            let bodyCount = safeHeight - 4;
            let header = fgd-title-segment-line(fgd-cat(list("FORM GLASS ", int_to_str(safeWidth), "x", int_to_str(safeHeight), " focus=", focus)), safeWidth, "glass.header");
            let legend = fgd-segment-line("states >active :prefill =ready oresident mmapped xreleased | *live +derived #catalog ~declared ?missing", safeWidth, fgd-neutral(176), "glass.legend", list("all"), "declared");
            let rule = fgd-title-segment-line(fgd-equals(safeWidth), safeWidth, "glass.rule");
            let body = safeWidth >= 100 ? fgd-wide-lines(safeWidth, bodyCount, epoch, focus, metrics, samples) : fgd-narrow-lines(safeWidth, bodyCount, epoch, focus, metrics, samples);
            let footer = fgd-segment-line(fgd-cat(list("publishers=", int_to_str(len(publishers)), " control=", controlState, " route=glass-monitor focus=visible sample/channel | form-glassctl")), safeWidth, fgd-neutral(176), "glass.footer", list("all", "membrane"), "physical-live");
            let hiddenSamples = fgd-max(0, fgd-count-visible(samples, focus) - (bodyCount - 2));
            let hiddenMetrics = fgd-hidden-metrics(safeWidth, bodyCount, focus, metrics, samples);
            (safeWidth < 40) || (safeHeight < 12) ? fgd-compact-frame(safeWidth, safeHeight, epoch, focus, metrics, samples, publishers, controlState) : list("form-glass-segment-frame-v1", safeWidth, safeHeight, append(list(header, rule, legend), append(body, list(footer))), ftc-overflow("hidden-count", hiddenSamples + hiddenMetrics));
        }
        def fgd-segment-frame-width(frame) = frame[1];
        def fgd-segment-frame-height(frame) = frame[2];
        def fgd-segment-frame-lines(frame) = frame[3];
        def fgd-segment-frame-overflow(frame) = frame[4];
        def fgd-segment-project(frame) = ftc-ansi-segment-lines(fgd-segment-frame-lines(frame));

        def fgd-scene-body(canvas, width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let wide = width >= 100 ? 1 : 0;
            let gap = (Comparable) wide == 1 ? 3 : 0;
            let leftWidth = (Comparable) wide == 1 ? ((width - gap) / 2) : width;
            let rightX = (Comparable) wide == 1 ? (leftWidth + gap) : 0;
            let rightWidth = (Comparable) wide == 1 ? (width - rightX) : width;
            let usableRows = fgd-max(1, height - 6);
            let sampleRows = (Comparable) wide == 1 ? usableRows : fgd-max(3, usableRows / 2);
            let metricY = (Comparable) wide == 1 ? 3 : (4 + sampleRows);
            let metricRows = (Comparable) wide == 1 ? usableRows : fgd-max(1, usableRows - (sampleRows + 1));
            let topSamples = fgd-top-samples(samples, focus, sampleRows);
            let important = fgd-focus-metrics(metrics, focus);
            let totalBytes = fgd-memory-bar-value(topSamples);
            let totalCapacity = fgd-memory-bar-capacity(topSamples, 0);
            let left0 = fgd-put-section-title(canvas, 0, 3, leftWidth, fgd-cat(list("MEMORY / MODELS [", int_to_str(len(samples)), "]")), fgd-style-for-plane("unified", 255, 1));
            let left1 = leftWidth > 10 ? ftc-blit(left0, ftc-bar(leftWidth, totalBytes, totalCapacity, fgd-style-for-plane("metal", 220, 1), fgd-neutral(64)), 0, 4) : left0;
            let left2 = fgd-put-samples(left1, topSamples, 0, 5, leftWidth, epoch);
            let titled = fgd-put-section-title(left2, rightX, metricY, rightWidth, "ORGANS / HEALTH", fgd-style-for-plane("form", 255, 1));
            let filled = fgd-put-metrics(titled, important, rightX, metricY + 1, rightWidth, metricRows);
            let footer = fgd-fit(fgd-cat(list("focus=", focus, " publishers=", int_to_str(len(publishers)), " control=", controlState, "  *live +derived #catalog ~declared ?missing")), width);
            ftc-put-text(filled, 0, height - 1, footer, fgd-neutral(176));
        }

        def fgd-scene(width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let safeWidth = fgd-clamp(width, 1, 240);
            let safeHeight = fgd-clamp(height, 1, 80);
            let canvas = ftc-canvas(safeWidth, safeHeight, fgd-neutral(40));
            let header = fgd-fit(fgd-cat(list("FORM GLASS  ", int_to_str(safeWidth), "x", int_to_str(safeHeight), "  epoch ", int_to_str(epoch), "  scene=", FGDSchema())), safeWidth);
            let c0 = ftc-put-text(canvas, 0, 0, fgd-pad-right(header, safeWidth), fgd-title());
            let c1 = ftc-put-text(c0, 0, 1, fgd-repeat("=", safeWidth), fgd-title());
            let c2 = ftc-put-text(c1, 0, 2, fgd-fit("states: > active  : prefill  = ready  o resident  m mapped  x released | alpha = read/write age", safeWidth), fgd-neutral(176));
            let body = fgd-scene-body(c2, safeWidth, safeHeight, epoch, focus, metrics, samples, publishers, controlState);
            ftc-surface(body, ftc-capabilities(safeWidth, safeHeight, "observed-or-fallback"), list("all", "memory", "model", "gpu", "metal", "cpu", "health", "cache", "query-lane", "primitive", "jit", "membrane", "network"));
        }
    }
    0;
}
