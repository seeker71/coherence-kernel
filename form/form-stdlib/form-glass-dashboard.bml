        def fgd-slot-index?(index) = if not(eq(len(index), 3)) then 0 else if not(str_eq(value_kind(head(index)), "string")) then 0 else str_eq(head(index), FGDSlotIndex());
        def fgd-same-row-keys(a, b) = if not(eq(len(a), len(b))) then 0 else fgd-same-row-keys-go(a, b);
        def fgd-same-row-keys-go(a, b) = if nil?(a) then 1 else if not(eq(lt(len(head(a)), 3), lt(len(head(b)), 3))) then 0 else if and(ge(len(head(a)), 3), not(str_eq(fgo-id(head(a)), fgo-id(head(b))))) then 0 else fgd-same-row-keys-go(tail(a), tail(b));
        def fgd-metric-index-cached(rows, prior) {
