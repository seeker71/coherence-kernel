        def fgd-semantic-zero-state?(state) = if str_eq(state, "empty") then 1 else if str_eq(state, "drained") then 1 else if str_eq(state, "idle") then 1 else if str_eq(state, "quiet") then 1 else 0;
        def fgd-semantic-zero(metric) = if str_eq(fgo-unit(metric), "bytes") then fgd-cat(list("0B(", fgo-lifecycle(metric), ")")) else fgd-cat(list("0(", fgo-lifecycle(metric), ")"));
        def fgd-metric-value(metric) = if eq(len(metric), 0) then "UNAVAILABLE door=metric.publisher reason=metric-not-published" else if eq(fgo-present?(metric), 0) then fgd-cat(list("UNAVAILABLE door=", fgo-source(metric), " reason=", fgo-note(metric))) else if str_eq(fgo-value-kind(metric), "text") then fgo-text-value(metric) else if and(eq(fgo-int-value(metric), 0), eq(fgd-semantic-zero-state?(fgo-lifecycle(metric)), 1)) then fgd-semantic-zero(metric) else if str_eq(fgo-unit(metric), "bytes") then fgd-format-bytes(fgo-int-value(metric)) else fgd-format-count(fgo-int-value(metric));
