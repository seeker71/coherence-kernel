        def fgd-slot-rowkeys(rows, prior) = if nil?(rows) then list() else cons(fgd-slot-rowkey(head(rows), if nil?(prior) then list() else head(prior)), fgd-slot-rowkeys(tail(rows), if nil?(prior) then list() else tail(prior)));
