        def fgd-slot-found(chunks, key, hash, position) = if lt(position, 0) then fgd-slot-find(tail(chunks), key, hash) else nth(head(head(chunks)), position);
        def fgd-slot-key(chunks, key) = fgd-slot-find(chunks, key, fgd-key-hash(key));
