        def fgd-resident-byte-sample?(sample, allSamples) = if (!((Comparable) fgd-memory-record?(sample) == 1)) then 0 else if (!((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1)) then 0 else if (!((Comparable) fgd-material-plane?(fgtm-sample-plane(sample)) == 1)) then 0 else if ((String) fgtm-sample-lifecycle(sample) == "released") then 0 else if ((Comparable) fgd-allocated-ledger?(sample) == 1) then 1 else if (!(((String) fgtm-sample-kind(sample) == "model") && ((Comparable) fgd-owner-ledger?(allSamples, fgtm-sample-owner(sample)) == 0))) then 0 else if ((String) fgtm-sample-evidence(sample) == "physical-live") then 1 else if (((String) fgtm-sample-evidence(sample) == "derived-window") && ((Comparable) fgd-sample-stale?(sample) == 1)) then 1 else 0;
        def fgd-memory-bar-value-go(samples, allSamples) = if ((Comparable) len(samples) == 0) then 0 else ((if ((Comparable) fgd-resident-byte-sample?(head(samples), allSamples) == 1) then fgd-field-number(fgtm-sample-bytes(head(samples))) else 0) + fgd-memory-bar-value-go(tail(samples), allSamples));
        def fgd-memory-bar-value(samples) = fgd-memory-bar-value-go(samples, samples);
        def fgd-memory-bar-contributors-go(samples, allSamples) = if ((Comparable) len(samples) == 0) then 0 else ((if ((Comparable) fgd-resident-byte-sample?(head(samples), allSamples) == 1) then 1 else 0) + fgd-memory-bar-contributors-go(tail(samples), allSamples));
        def fgd-memory-bar-contributors(samples) = fgd-memory-bar-contributors-go(samples, samples);
        def fgd-logical-artifact-byte-sample?(sample) = if (!((Comparable) fgd-catalog-weight-sample?(sample) == 1)) then 0 else if (!((Comparable) fgtm-field-present?(fgtm-sample-bytes(sample)) == 1)) then 0 else if ((String) fgtm-sample-plane(sample) == "disk") then 1 else if ((String) fgtm-sample-plane(sample) == "mapped-file") then 1 else 0;
        def fgd-logical-artifact-bytes(samples) = if ((Comparable) len(samples) == 0) then 0 else ((if ((Comparable) fgd-logical-artifact-byte-sample?(head(samples)) == 1) then fgd-field-number(fgtm-sample-bytes(head(samples))) else 0) + fgd-logical-artifact-bytes(tail(samples)));
        def fgd-model-handle-count(samples) = if ((Comparable) len(samples) == 0) then 0 else ((if (((String) fgtm-sample-kind(head(samples)) == "model") && ((Comparable) fgtm-field-present?(fgtm-sample-handle(head(samples))) == 1)) then 1 else 0) + fgd-model-handle-count(tail(samples)));
        def fgd-budget-capacity?(sample) = if (!((Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1)) then 0 else if ((String) fgtm-sample-kind(sample) == "budget") then 1 else 0;
        def fgd-memory-bar-capacity-go(samples, allSamples, fallback) = if ((Comparable) len(samples) == 0) then fallback else if ((Comparable) fgd-budget-capacity?(head(samples)) == 1) then fgd-max(fgtm-field-value(fgtm-sample-capacity(head(samples))), fgd-memory-bar-capacity-go(tail(samples), allSamples, fallback)) else fgd-memory-bar-capacity-go(tail(samples), allSamples, fallback);
        def fgd-memory-bar-capacity(samples, fallback) = fgd-memory-bar-capacity-go(samples, samples, fallback);
        def fgd-model-id-stale?(samples, id) = if ((Comparable) len(samples) == 0) then 0 else if (((String) fgtm-sample-id(head(samples)) == id) && (((String) fgtm-sample-kind(head(samples)) == "model") && ((Comparable) fgd-sample-stale?(head(samples)) == 1))) then 1 else fgd-model-id-stale?(tail(samples), id);
        def fgd-resident-contributor-stale?(sample, allSamples) = if ((Comparable) fgd-sample-stale?(sample) == 1) then 1 else if (((String) fgtm-sample-evidence(sample) == "catalog") && (((String) fgtm-sample-kind(sample) == "weights") && ((Comparable) fgtm-field-present?(fgtm-sample-parent(sample)) == 1))) then fgd-model-id-stale?(allSamples, fgtm-field-value(fgtm-sample-parent(sample))) else 0;
        def fgd-memory-bar-has-stale?(samples, allSamples) = if ((Comparable) len(samples) == 0) then 0 else if (((Comparable) fgd-resident-byte-sample?(head(samples), allSamples) == 1) && ((Comparable) fgd-resident-contributor-stale?(head(samples), allSamples) == 1)) then 1 else fgd-memory-bar-has-stale?(tail(samples), allSamples);
        def fgd-memory-bar-has-derived?(samples, allSamples) = if ((Comparable) len(samples) == 0) then 0 else if (((Comparable) fgd-resident-byte-sample?(head(samples), allSamples) == 1) && ((String) fgtm-sample-evidence(head(samples)) == "derived-window")) then 1 else fgd-memory-bar-has-derived?(tail(samples), allSamples);
        def fgd-memory-bar-evidence(samples) = if (((Comparable) fgd-memory-bar-has-stale?(samples, samples) == 1) || ((Comparable) fgd-memory-bar-has-derived?(samples, samples) == 1)) then "derived-window" else "physical-live";
        def fgd-memory-bar-label(samples) = if ((Comparable) fgd-memory-bar-has-stale?(samples, samples) == 1) then "last-observed allocated extents " else if ((Comparable) fgd-memory-bar-has-derived?(samples, samples) == 1) then "derived allocated extents " else "allocated extents ";

        // Retained segment projection is the live fast lane.  It follows the
        // Rich lesson directly: measure, allocate regions, then emit styled
        // text runs.  The cell canvas remains the exact raster/diff adapter.
        def fgd-segment-line(text, width, style, nodeId, channels, evidence) = [ftc-segment(fgd-fit(text, width), style, "none", nodeId, channels, evidence)];
        def fgd-byte-segment-line(bytes, width, style, nodeId, channels, evidence) = [ftc-segment(ftc-byte-text(fgdb-fit(bytes, width)), style, "none", nodeId, channels, evidence)];
        def fgd-blank-segment-line(width) = fgd-segment-line("", width, fgd-neutral(40), "glass.blank", [], "declared");
        // Composite rows share the same terminal width as single segments.
        // Preserve the clipped segment's style and evidence; never wrap into
        // another view row or split a UTF-8 sequence at the clipping boundary.
        def fgd-text-byte(text, at) = if ((Comparable) ftc-byte-text?(text) == 1) then text[1][at] else str_byte_at(text, at);
        def fgd-text-boundary(text, at) = if (at <= 0) then 0 else if (at >= ftc-text-width(text)) then at else if ((fgd-text-byte(text, at) >= 128) && (fgd-text-byte(text, at) <= 191)) then fgd-text-boundary(text, (at - 1)) else at;
        def fgd-clip-text(text, width) {
            let end = fgd-text-boundary(text, width);
            if ((Comparable) ftc-byte-text?(text) == 1) then ftc-byte-text(fgd-take(text[1], end)) else substring(text, 0, end);
        }
        def fgd-clip-segment(segment, width) = ftc-segment(fgd-clip-text(ftc-segment-text(segment), width), ftc-segment-style(segment), ftc-segment-control(segment), ftc-segment-node-id(segment), ftc-segment-channels(segment), ftc-segment-evidence(segment));
        def fgd-clip-segments(segments, width) = if ((width <= 0) || ((Comparable) len(segments) == 0)) then [] else if (ftc-text-width(ftc-segment-text(head(segments))) > width) then [fgd-clip-segment(head(segments), width)] else cons(head(segments), fgd-clip-segments(tail(segments), (width - ftc-text-width(ftc-segment-text(head(segments))))));
        def fgd-clip-lines(lines, width) = if ((Comparable) len(lines) == 0) then [] else cons(fgd-clip-segments(head(lines), width), fgd-clip-lines(tail(lines), width));
        def fgd-title-segment-line(text, width, nodeId) = fgd-segment-line(text, width, fgd-title(), nodeId, ["all"], "declared");
        def fgd-sample-segment-line(sample, width, epoch) = fgd-segment-line(fgd-sample-line-at(sample, width, epoch), width, fgd-sample-style(sample, epoch), fgd-sample-projection-id(sample), append([fgtm-sample-id(sample), str_concat("selector.", fgtm-sample-selection-id(sample))], fgtm-sample-channels(sample)), fgtm-sample-evidence(sample));
        def fgd-metric-style(metric) = if ((Comparable) len(metric) == 0) then fgd-neutral(56) else fgd-style-for-metric(metric);
        def fgd-metric-id-or-missing(metric) = if ((Comparable) len(metric) == 0) then "metric.missing" else if ((Comparable) fgo-nodeid-bound?(metric) == 1) then fgo-nodeid-value(metric) else str_concat("metric.", fgo-id(metric));
        def fgd-metric-evidence-or-missing(metric) = if ((Comparable) len(metric) == 0) then "unavailable" else fgo-evidence(metric);
        def fgd-metric-selector(metric) = fgd-cat(["metric.", fgo-domain(metric), ".", fgo-id(metric)]);
        def fgd-metric-channels(metric) = if ((Comparable) len(metric) == 0) then ["health"] else [str_concat("selector.", fgd-metric-selector(metric)), fgo-channel(metric), fgo-domain(metric)];
        def fgd-metric-segment-line(metric, width) = fgd-byte-segment-line(fgd-metric-line-bytes(metric, width), width, fgd-metric-style(metric), fgd-metric-id-or-missing(metric), fgd-metric-channels(metric), fgd-metric-evidence-or-missing(metric));
        def fgd-segment-row-text(text, width, style, nodeId, channel, evidence) = ftc-segment(fgd-fit(text, width), style, "none", nodeId, [channel], evidence);
        def fgd-line-or-blank(lines, index, width) = if ((index < 0) || (index >= len(lines))) then fgd-blank-segment-line(width) else lines[index];
        def fgd-sample-segment-lines(samples, width, epoch) = if ((Comparable) len(samples) == 0) then [] else cons(fgd-sample-segment-line(head(samples), width, epoch), fgd-sample-segment-lines(tail(samples), width, epoch));
        def fgd-metric-segment-lines(metrics, width) = if ((Comparable) len(metrics) == 0) then [] else cons(fgd-metric-segment-line(head(metrics), width), fgd-metric-segment-lines(tail(metrics), width));
        def fgd-count-visible(samples, focus) = if ((Comparable) len(samples) == 0) then 0 else ((if ((Comparable) fgd-visible?(head(samples), focus) == 1) then 1 else 0) + fgd-count-visible(tail(samples), focus));
        def fgd-bar-text(width, value, maximum) {
            let filled = if (maximum <= 0) then 0 else fgd-clamp(((width * value) / maximum), 0, width);
            str_concat(fgd-hashes(filled), fgd-dots((width - filled)));
        }
        def fgd-memory-bar-segment(samples, width) {
            let value = fgd-memory-bar-value(samples);
            let capacity = fgd-memory-bar-capacity(samples, 0);
            let evidence = fgd-memory-bar-evidence(samples);
            let contributors = fgd-memory-bar-contributors(samples);
            let artifact = fgd-logical-artifact-bytes(samples);
            let handles = fgd-model-handle-count(samples);
            if ((Comparable) contributors == 0) then fgd-segment-line(fgd-cat(["materialized=? door=model.materialized-resident-bytes artifact=", if (artifact > 0) then fgd-format-bytes(artifact) else "absent", "(catalog) handles=", int_to_str(handles), " callable=? door=model.route-readiness"]), width, fgd-neutral(96), "memory.materialized", ["memory", "metal", "model"], "unavailable") else if (capacity <= 0) then fgd-segment-line(fgd-cat([fgd-memory-bar-label(samples), fgd-format-bytes(value), " budget=? door=model.resident-byte-capacity"]), width, fgd-neutral(96), "memory.capacity", ["memory", "metal"], "unavailable") else fgd-segment-line(fgd-cat([fgd-memory-bar-label(samples), fgd-format-bytes(value), " / budget ", fgd-format-bytes(capacity), " ", fgd-bar-text(fgd-max(4, (width - 30)), value, capacity)]), width, fgd-style-for-plane("metal", if ((String) evidence == "derived-window") then 112 else 220, if ((String) evidence == "physical-live") then 1 else 0), "memory.capacity", ["memory", "metal"], evidence);
        }
        def fgd-segment-line-width(line) = if ((Comparable) len(line) == 0) then 0 else (ftc-text-width(ftc-segment-text(head(line))) + fgd-segment-line-width(tail(line)));
        // A region owns its allocated width even when its content is short or
        // absent. Keep padding separate so source styles, nodes and evidence
        // survive composition, and clip each region before joining its neighbor.
        def fgd-region-line(line, width) {
            let clipped = fgd-clip-segments(line, width);
            let room = fgd-max(0, (width - fgd-segment-line-width(clipped)));
            if ((Comparable) room == 0) then clipped else append(clipped, [ftc-segment(fgd-spaces(room), fgd-neutral(40), "none", "layout.padding", ["all"], "declared")]);
        }
        def fgd-wide-row(leftLines, rightLines, index, leftWidth, gap, rightWidth) {
            let left = fgd-region-line(fgd-line-or-blank(leftLines, index, leftWidth), leftWidth);
            let right = fgd-clip-segments(fgd-line-or-blank(rightLines, index, rightWidth), rightWidth);
            append(left, append([ftc-segment(fgd-spaces(gap), fgd-neutral(40), "none", "layout.gap", ["all"], "declared")], right));
        }
        def fgd-wide-lines-go(leftLines, rightLines, index, count, leftWidth, gap, rightWidth) = if (index >= count) then [] else cons(fgd-wide-row(leftLines, rightLines, index, leftWidth, gap, rightWidth), fgd-wide-lines-go(leftLines, rightLines, (index + 1), count, leftWidth, gap, rightWidth));
        def fgd-wide-lines(width, bodyCount, epoch, focus, metrics, samples) {
            let gap = 3;
            let selectedMetrics = fgd-present-metrics(fgd-focus-metrics(metrics, focus));
            let sampleMeasure = ftc-measure(40, fgd-max(40, fgd-longest-sample-width(samples, 0)));
            let metricMeasure = ftc-measure(36, fgd-max(36, fgd-longest-metric-width(selectedMetrics, 0)));
            let regions = ftc-measured-split(width, bodyCount, gap, sampleMeasure, metricMeasure);
            let leftWidth = ftc-region-width(head(regions));
            let rightWidth = ftc-region-width(regions[1]);
            let mapLimit = fgd-min(7, fgd-max(1, (fgd-max(1, (bodyCount - 1)) / 2)));
            let mapLines = fgd-map-lines(metrics, samples, epoch, focus, leftWidth, mapLimit);
            let sampleLimit = fgd-max(0, (bodyCount - (1 + len(mapLines))));
            let topSamples = fgd-top-samples(samples, focus, sampleLimit);
            let hidden = fgd-max(0, (fgd-count-visible(samples, focus) - len(topSamples)));
            let metricLimit = fgd-max(0, (bodyCount - 1));
            let hiddenMetrics = fgd-max(0, (len(selectedMetrics) - metricLimit));
            let sampleTitle = fgd-title-segment-line(fgd-cat(["MEMORY MAP / MODELS [", int_to_str(len(samples)), "] hidden=", int_to_str(hidden)]), leftWidth, "section.memory");
            let leftLines = cons(sampleTitle, append(mapLines, fgd-sample-segment-lines(topSamples, leftWidth, epoch)));
            let metricTitle = fgd-title-segment-line(fgd-cat(["ORGANS / HEALTH hidden=", int_to_str(hiddenMetrics)]), rightWidth, "section.organs");
            let rightLines = cons(metricTitle, fgd-metric-segment-lines(selectedMetrics, rightWidth));
            fgd-wide-lines-go(leftLines, rightLines, 0, bodyCount, leftWidth, gap, rightWidth);
        }
        def fgd-fill-lines(lines, count, width) = if (count <= 0) then [] else if ((Comparable) len(lines) == 0) then cons(fgd-blank-segment-line(width), fgd-fill-lines([], (count - 1), width)) else cons(head(lines), fgd-fill-lines(tail(lines), (count - 1), width));
        def fgd-narrow-lines(width, bodyCount, epoch, focus, metrics, samples) {
            let available = fgd-max(0, (bodyCount - 2));
            let mapLimit = if (width >= 72) then fgd-min(7, fgd-max(1, (fgd-max(1, available) / 2))) else fgd-min(5, fgd-max(1, (fgd-max(1, available) / 2)));
            let sampleLimit = fgd-min(3, fgd-max(0, (fgd-max(0, (available - mapLimit)) / 2)));
            let metricLimit = fgd-max(0, (available - (mapLimit + sampleLimit)));
            let mapLines = fgd-map-lines(metrics, samples, epoch, focus, width, mapLimit);
            let topSamples = fgd-top-samples(samples, focus, sampleLimit);
            let hidden = fgd-max(0, (fgd-count-visible(samples, focus) - len(topSamples)));
            let selectedMetrics = fgd-present-metrics(fgd-focus-metrics(metrics, focus));
            let hiddenMetrics = fgd-max(0, (len(selectedMetrics) - metricLimit));
            let sampleTitle = fgd-title-segment-line(fgd-cat(["MEMORY MAP / MODELS [", int_to_str(len(samples)), "] hidden=", int_to_str(hidden)]), width, "section.memory");
            let metricTitle = fgd-title-segment-line(fgd-cat(["ORGANS / HEALTH hidden=", int_to_str(hiddenMetrics)]), width, "section.organs");
            let lines = append([sampleTitle], append(mapLines, append(fgd-sample-segment-lines(topSamples, width, epoch), cons(metricTitle, fgd-metric-segment-lines(fgd-take(selectedMetrics, metricLimit), width)))));
            fgd-fill-lines(lines, bodyCount, width);
        }
        def fgd-hidden-metrics(width, bodyCount, focus, metrics, samples) {
            let selected = fgd-present-metrics(fgd-focus-metrics(metrics, focus));
            let available = fgd-max(0, (bodyCount - 2));
            let mapLimit = if (width >= 72) then fgd-min(7, fgd-max(1, (fgd-max(1, available) / 2))) else fgd-min(5, fgd-max(1, (fgd-max(1, available) / 2)));
            let sampleLimit = fgd-min(3, fgd-max(0, (fgd-max(0, (available - mapLimit)) / 2)));
            let metricLimit = if (width >= 100) then fgd-max(0, (bodyCount - 1)) else fgd-max(0, (available - (mapLimit + sampleLimit)));
            fgd-max(0, (len(selected) - metricLimit));
        }

        def fgd-compact-frame(width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let header = fgd-title-segment-line(fgd-cat(["GLASS ", int_to_str(width), "x", int_to_str(height), " ", focus]), width, "glass.header");
            let footer = fgd-segment-line(fgd-cat(["m=", int_to_str(len(samples)), " p=", int_to_str(len(publishers)), " ", controlState]), width, fgd-neutral(176), "glass.footer", ["all", "membrane"], "physical-live");
            let bodyCount = fgd-max(0, (height - 2));
            let body = fgd-narrow-lines(width, bodyCount, epoch, focus, metrics, samples);
            let lines = if (height <= 1) then [header] else append([header], append(body, [footer]));
            let hiddenSamples = fgd-max(0, (fgd-count-visible(samples, focus) - bodyCount));
            let hiddenMetrics = fgd-hidden-metrics(width, bodyCount, focus, metrics, samples);
            ["form-glass-segment-frame-v1", width, height, lines, ftc-overflow("hidden-count", (hiddenSamples + hiddenMetrics))];
        }
        def fgd-segment-frame(width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let safeWidth = fgd-clamp(width, 1, 1000);
            let safeHeight = fgd-clamp(height, 1, 300);
            let bodyCount = (safeHeight - 4);
            let header = fgd-title-segment-line(fgd-cat(["FORM GLASS ", int_to_str(safeWidth), "x", int_to_str(safeHeight), " focus=", focus]), safeWidth, "glass.header");
            let legend = fgd-segment-line("states >active :prefill =ready oresident mmapped xreleased | *live +derived #catalog ~declared ?missing", safeWidth, fgd-neutral(176), "glass.legend", ["all"], "declared");
            let rule = fgd-title-segment-line(fgd-equals(safeWidth), safeWidth, "glass.rule");
            let body = if (safeWidth >= 100) then fgd-wide-lines(safeWidth, bodyCount, epoch, focus, metrics, samples) else fgd-narrow-lines(safeWidth, bodyCount, epoch, focus, metrics, samples);
            let footer = fgd-segment-line(fgd-cat(["publishers=", int_to_str(len(publishers)), " control=", controlState, " route=glass-monitor focus=visible sample/channel | form-glassctl"]), safeWidth, fgd-neutral(176), "glass.footer", ["all", "membrane"], "physical-live");
            let hiddenSamples = fgd-max(0, (fgd-count-visible(samples, focus) - (bodyCount - 2)));
            let hiddenMetrics = fgd-hidden-metrics(safeWidth, bodyCount, focus, metrics, samples);
            if ((safeWidth < 40) || (safeHeight < 12)) then fgd-compact-frame(safeWidth, safeHeight, epoch, focus, metrics, samples, publishers, controlState) else ["form-glass-segment-frame-v1", safeWidth, safeHeight, append([header, rule, legend], append(body, [footer])), ftc-overflow("hidden-count", (hiddenSamples + hiddenMetrics))];
        }
        def fgd-segment-frame-width(frame) = frame[1];
        def fgd-segment-frame-height(frame) = frame[2];
        def fgd-segment-frame-lines(frame) = frame[3];
        def fgd-segment-frame-overflow(frame) = frame[4];
        def fgd-segment-project(frame) = ftc-ansi-segment-lines(fgd-segment-frame-lines(frame));

        def fgd-scene-body(canvas, width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let wide = if (width >= 100) then 1 else 0;
            let gap = if ((Comparable) wide == 1) then 3 else 0;
            let leftWidth = if ((Comparable) wide == 1) then ((width - gap) / 2) else width;
            let rightX = if ((Comparable) wide == 1) then (leftWidth + gap) else 0;
            let rightWidth = if ((Comparable) wide == 1) then (width - rightX) else width;
            let usableRows = fgd-max(1, (height - 6));
            let sampleRows = if ((Comparable) wide == 1) then usableRows else fgd-max(3, (usableRows / 2));
            let metricY = if ((Comparable) wide == 1) then 3 else (4 + sampleRows);
            let metricRows = if ((Comparable) wide == 1) then usableRows else fgd-max(1, (usableRows - (sampleRows + 1)));
            let topSamples = fgd-top-samples(samples, focus, sampleRows);
            let important = fgd-focus-metrics(metrics, focus);
            let totalBytes = fgd-memory-bar-value(topSamples);
            let totalCapacity = fgd-memory-bar-capacity(topSamples, 0);
            let left0 = fgd-put-section-title(canvas, 0, 3, leftWidth, fgd-cat(["MEMORY / MODELS [", int_to_str(len(samples)), "]"]), fgd-style-for-plane("unified", 255, 1));
            let left1 = if (leftWidth > 10) then ftc-blit(left0, ftc-bar(leftWidth, totalBytes, totalCapacity, fgd-style-for-plane("metal", 220, 1), fgd-neutral(64)), 0, 4) else left0;
            let left2 = fgd-put-samples(left1, topSamples, 0, 5, leftWidth, epoch);
            let titled = fgd-put-section-title(left2, rightX, metricY, rightWidth, "ORGANS / HEALTH", fgd-style-for-plane("form", 255, 1));
            let filled = fgd-put-metrics(titled, important, rightX, (metricY + 1), rightWidth, metricRows);
            let footer = fgd-fit(fgd-cat(["focus=", focus, " publishers=", int_to_str(len(publishers)), " control=", controlState, "  *live +derived #catalog ~declared ?missing"]), width);
            ftc-put-text(filled, 0, (height - 1), footer, fgd-neutral(176));
        }

        def fgd-scene(width, height, epoch, focus, metrics, samples, publishers, controlState) {
            let safeWidth = fgd-clamp(width, 1, 240);
            let safeHeight = fgd-clamp(height, 1, 80);
            let canvas = ftc-canvas(safeWidth, safeHeight, fgd-neutral(40));
            let header = fgd-fit(fgd-cat(["FORM GLASS  ", int_to_str(safeWidth), "x", int_to_str(safeHeight), "  epoch ", int_to_str(epoch), "  scene=", FGDSchema()]), safeWidth);
            let c0 = ftc-put-text(canvas, 0, 0, fgd-pad-right(header, safeWidth), fgd-title());
            let c1 = ftc-put-text(c0, 0, 1, fgd-repeat("=", safeWidth), fgd-title());
            let c2 = ftc-put-text(c1, 0, 2, fgd-fit("states: > active  : prefill  = ready  o resident  m mapped  x released | alpha = read/write age", safeWidth), fgd-neutral(176));
            let body = fgd-scene-body(c2, safeWidth, safeHeight, epoch, focus, metrics, samples, publishers, controlState);
            ftc-surface(body, ftc-capabilities(safeWidth, safeHeight, "observed-or-fallback"), ["all", "memory", "model", "gpu", "metal", "cpu", "health", "cache", "query-lane", "primitive", "jit", "membrane", "network"]);
        }
    }
    0;
}
