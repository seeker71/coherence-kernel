; form-cli-thought-run.fk — the thought door that does not wait on form-cli.fk.
;
; The heavy dispatch chain carries a standing native_blueprint lane seam on fkwu.
; Growing C to close that seam is not this breath. This cell IS the door:
;   ./fkwu form/form-stdlib/form-cli-thought-run.fk
;
; preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk form-stdlib/form-cli-thought.fk

(do
    (print "thought phase 6 1=")
    (print (fct-respond "phase" 6 1 0))
    (print "\n")
    (print "thought phase 6 9=")
    (print (fct-respond "phase" 6 9 0))
    (print "\n")
    (print "thought ask 0=")
    (print (fct-respond "ask" 0 0 0))
    (print "\n")
    (print "thought step 2 3=")
    (print (fct-respond "step" 2 3 0))
    (print "\n")
    (print "thought love 4=")
    (print (fct-respond "love" 4 0 0))
    (print " source=")
    (print (int_to_str (fct-thought-source)))
    (print "\n")
    0)
