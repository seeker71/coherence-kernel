; living-world-behavioral-species.fk -- behavior can relate without a winner.
;
; Distinct Recipe source cells may exhibit the same local observed boundary.
; This organ retains exact historical nursery trials as receipts, derives a
; deliberately bounded behavior signature from target/before/after/evaluator/
; effect, and gathers reciprocal consented observations about the pair. Recipe
; source, lens, contract, byte budget, trace, comparison, witnesses, and path
; stay visible but no source string becomes a representative or primary.
;
; ALIGNED means only local observed agreement under this exact target context.
; It is not global program equivalence. DIVERGENT retains different signatures;
; AMBIGUOUS retains dissent, alternative, or unresolved observations; OPEN
; retains insufficient reciprocal support. Silence and offered unknown remain
; first-class in every state. Only ALIGNED may cross a unanimous species
; membrane, and evidence movement or revocation makes old tissue stale.
;
; A separately offered question can ask an admitted species for its members.
; The answer is native composition with an inspectable derivation and NODE ack,
; never generated prose or a remote oracle response.
;
; witnessed: 2026-08-07 -> 3 focused bands return 32767
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk

(let LWBS-RECEIPT        (bp "LWBS-RECEIPT"))
(let LWBS-SIGNATURE      (bp "LWBS-SIGNATURE"))
(let LWBS-DIVERGENCE     (bp "LWBS-DIVERGENCE"))
(let LWBS-OBSERVATION    (bp "LWBS-OBSERVATION"))
(let LWBS-EVIDENCE       (bp "LWBS-EVIDENCE"))
(let LWBS-EVIDENCE-SET   (bp "LWBS-EVIDENCE-SET"))
(let LWBS-FIELD          (bp "LWBS-FIELD"))
(let LWBS-ALIGNED        (bp "LWBS-ALIGNED"))
(let LWBS-DIVERGENT      (bp "LWBS-DIVERGENT"))
(let LWBS-AMBIGUOUS      (bp "LWBS-AMBIGUOUS"))
(let LWBS-OPEN           (bp "LWBS-OPEN"))
(let LWBS-ORIGIN         (bp "LWBS-ORIGIN"))
(let LWBS-QUESTION       (bp "LWBS-QUESTION"))
(let LWBS-DERIVATION     (bp "LWBS-DERIVATION"))
(let LWBS-ANSWER         (bp "LWBS-ANSWER"))
(let LWBS-ANSWER-ORIGIN  (bp "LWBS-ANSWER-ORIGIN"))

(defn lwbs-status (kind) (intern_node kind (empty)))
(defn lwbs-aligned () (lwbs-status LWBS-ALIGNED))
(defn lwbs-divergent () (lwbs-status LWBS-DIVERGENT))
(defn lwbs-ambiguous () (lwbs-status LWBS-AMBIGUOUS))
(defn lwbs-open () (lwbs-status LWBS-OPEN))
(defn lwbs-aligned? (status) (if (node_eq status (lwbs-aligned)) 1 0))
(defn lwbs-divergent? (status) (if (node_eq status (lwbs-divergent)) 1 0))
(defn lwbs-ambiguous? (status) (if (node_eq status (lwbs-ambiguous)) 1 0))
(defn lwbs-open? (status) (if (node_eq status (lwbs-open)) 1 0))

; --- historical native trial receipts ----------------------------------

(defn lwbs-historical-trial-valid? (world trial-candidate)
    (if (or (eq (lwtn-trial-candidate? trial-candidate) 0)
            (eq (lwo-active? world trial-candidate) 0)) 0
        (do
            (let trial (lwo-emergent-shape trial-candidate))
            (let candidate (lwtn-trial-candidate trial))
            (let target (lwtn-candidate-target candidate))
            (let trace (lwtn-trial-trace trial))
            (let expected
                (if (eq (lwrx-integrated-current? world target) 0)
                    (lwo-none)
                    (lwrx-transformation-overall
                        (lwo-emergent-shape target))))
            (if (node_eq expected (lwo-none)) 0
                (if (eq (lwre-trace-current? world trace) 0) 0
                    (if (not (node_eq
                                (lwtn-trial-expected trial) expected)) 0
                        (if (not (node_eq
                                  (lwtn-trial-actual trial)
                                  (lwre-trace-changes trace))) 0
                            (if (not (node_eq
                                      (lwtn-trial-comparison trial)
                                      (lwtn-comparison expected
                                        (lwre-trace-changes trace)
                                        (lwtn-trial-evidence trial)))) 0
                                (if (not (node_eq
                                          (lwtn-trial-time-observation trial)
                                          (lwtn-time-observation candidate
                                            (lwtn-trial-observed-time trial))))
                                    0
                                    (if (node_eq
                                          (lwo-emergent-witnesses
                                            trial-candidate)
                                          (lwtn-trial-witnesses world trial))
                                        1 0))))))))))

; children: active historical trial candidate, target, exact Recipe and source,
; contract/evaluator/effect/budget, lens, expected/actual/comparison, native
; trace, witnesses, local path
(defn lwbs-receipt
    (trial target recipe source contract evaluator effect budget lens expected
     actual comparison trace witnesses)
    (intern_node LWBS-RECEIPT
        (list trial target recipe source contract evaluator effect
              (intern_trivial_int budget) lens expected actual comparison trace
              witnesses (lwo-local-path))))
(defn lwbs-receipt? (cell) (lwo-category? cell LWBS-RECEIPT))
(defn lwbs-receipt-trial (receipt) (nth (node_children receipt) 0))
(defn lwbs-receipt-target (receipt) (nth (node_children receipt) 1))
(defn lwbs-receipt-recipe (receipt) (nth (node_children receipt) 2))
(defn lwbs-receipt-source (receipt) (nth (node_children receipt) 3))
(defn lwbs-receipt-contract (receipt) (nth (node_children receipt) 4))
(defn lwbs-receipt-evaluator (receipt) (nth (node_children receipt) 5))
(defn lwbs-receipt-effect (receipt) (nth (node_children receipt) 6))
(defn lwbs-receipt-budget-cell (receipt) (nth (node_children receipt) 7))
(defn lwbs-receipt-budget (receipt)
    (node_value (lwbs-receipt-budget-cell receipt)))
(defn lwbs-receipt-lens (receipt) (nth (node_children receipt) 8))
(defn lwbs-receipt-expected (receipt) (nth (node_children receipt) 9))
(defn lwbs-receipt-actual (receipt) (nth (node_children receipt) 10))
(defn lwbs-receipt-comparison (receipt) (nth (node_children receipt) 11))
(defn lwbs-receipt-trace (receipt) (nth (node_children receipt) 12))
(defn lwbs-receipt-witnesses (receipt) (nth (node_children receipt) 13))
(defn lwbs-receipt-path (receipt) (nth (node_children receipt) 14))

(defn lwbs-receipt-for (world trial-candidate)
    (if (eq (lwbs-historical-trial-valid? world trial-candidate) 0)
        (lwo-none)
        (do
            (let trial (lwo-emergent-shape trial-candidate))
            (let candidate (lwtn-trial-candidate trial))
            (let recipe (lwtn-candidate-recipe candidate))
            (let contract (lwre-recipe-contract recipe))
            (lwbs-receipt trial-candidate
                (lwtn-candidate-target candidate) recipe
                (lwre-recipe-source-cell recipe) contract
                (lwre-contract-evaluator contract)
                (lwre-contract-effect contract)
                (lwre-contract-budget contract)
                (lwtn-candidate-lens candidate)
                (lwtn-trial-expected trial)
                (lwtn-trial-actual trial)
                (lwtn-trial-comparison trial)
                (lwtn-trial-trace trial)
                (lwo-emergent-witnesses trial-candidate)))))
(defn lwbs-receipt-current? (world receipt)
    (if (eq (lwbs-receipt? receipt) 0) 0
        (if (node_eq receipt
                (lwbs-receipt-for world
                    (lwbs-receipt-trial receipt))) 1 0)))

; The signature is deliberately local. Source, lens, budget, trace, and
; witnesses remain in the receipt and do not become identity of behavior.
(defn lwbs-signature (target before after evaluator effect)
    (intern_node LWBS-SIGNATURE
        (list target before after evaluator effect (lwo-local-path))))
(defn lwbs-signature? (cell) (lwo-category? cell LWBS-SIGNATURE))
(defn lwbs-signature-target (signature) (nth (node_children signature) 0))
(defn lwbs-signature-before (signature) (nth (node_children signature) 1))
(defn lwbs-signature-after (signature) (nth (node_children signature) 2))
(defn lwbs-signature-evaluator (signature) (nth (node_children signature) 3))
(defn lwbs-signature-effect (signature) (nth (node_children signature) 4))
(defn lwbs-signature-path (signature) (nth (node_children signature) 5))
(defn lwbs-signature-for (receipt)
    (lwbs-signature
        (lwbs-receipt-target receipt)
        (lwrx-overall-before (lwbs-receipt-actual receipt))
        (lwrx-overall-after (lwbs-receipt-actual receipt))
        (lwbs-receipt-evaluator receipt)
        (lwbs-receipt-effect receipt)))

(defn lwbs-divergence (first-signature second-signature)
    (intern_node LWBS-DIVERGENCE
        (list first-signature second-signature (lwo-local-path))))
(defn lwbs-comparison-for (first-receipt second-receipt)
    (do
        (let first (lwbs-signature-for first-receipt))
        (let second (lwbs-signature-for second-receipt))
        (if (node_eq first second) (oac-one first)
            (oac-alternative-ack first second
                (lwbs-divergence first second)))))

; --- reciprocal offered observations -----------------------------------

; children: oriented trial pair, ack, alternatives, optional unknown,
; evidence, local path. Orientation is provenance, never representative rank.
(defn lwbs-observation
    (first second ack alternatives unknown evidence)
    (intern_node LWBS-OBSERVATION
        (list first second ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwbs-observation? (cell) (lwo-category? cell LWBS-OBSERVATION))
(defn lwbs-observation-first (observation) (nth (node_children observation) 0))
(defn lwbs-observation-second (observation) (nth (node_children observation) 1))
(defn lwbs-observation-ack (observation) (nth (node_children observation) 2))
(defn lwbs-observation-alternatives (observation)
    (nth (node_children observation) 3))
(defn lwbs-observation-unknown (observation)
    (nth (node_children observation) 4))
(defn lwbs-observation-offered-evidence (observation)
    (nth (node_children observation) 5))
(defn lwbs-observation-path (observation) (nth (node_children observation) 6))
(defn lwbs-observation-valid? (observation)
    (if (eq (lwbs-observation? observation) 0) 0
        (if (or (eq (lwtn-trial-candidate?
                        (lwbs-observation-first observation)) 0)
                (eq (lwtn-trial-candidate?
                        (lwbs-observation-second observation)) 0)) 0
            (if (node_eq (lwbs-observation-first observation)
                         (lwbs-observation-second observation)) 0
                (if (eq (oac-valid-ack?
                            (lwbs-observation-ack observation)) 0) 0
                    (if (eq (lwo-category?
                                (lwbs-observation-alternatives observation)
                                LWO-FIELD) 0) 0
                        (lwac-optional-unknown-valid?
                            (lwbs-observation-unknown observation))))))))
(defn lwbs-exact-direction? (observation first second)
    (if (and (node_eq (lwbs-observation-first observation) first)
             (node_eq (lwbs-observation-second observation) second)) 1 0))
(defn lwbs-inverse-direction? (observation first second)
    (if (and (node_eq (lwbs-observation-first observation) second)
             (node_eq (lwbs-observation-second observation) first)) 1 0))
(defn lwbs-same-pair? (observation first second)
    (if (or (eq (lwbs-exact-direction? observation first second) 1)
            (eq (lwbs-inverse-direction? observation first second) 1)) 1 0))

(defn lwbs-evidence (observation attributions)
    (intern_node LWBS-EVIDENCE (list observation attributions)))
(defn lwbs-evidence-observation (evidence) (nth (node_children evidence) 0))
(defn lwbs-evidence-attributions (evidence) (nth (node_children evidence) 1))

; children: first supports, reciprocal supports, dissents, silences,
; alternatives, counterexamples/unresolved
(defn lwbs-evidence-set
    (first-supports second-supports dissents silences alternatives unresolved)
    (intern_node LWBS-EVIDENCE-SET
        (list first-supports second-supports dissents silences alternatives
              unresolved)))
(defn lwbs-evidence-first-supports (set) (nth (node_children set) 0))
(defn lwbs-evidence-second-supports (set) (nth (node_children set) 1))
(defn lwbs-evidence-dissents (set) (nth (node_children set) 2))
(defn lwbs-evidence-silences (set) (nth (node_children set) 3))
(defn lwbs-evidence-alternatives (set) (nth (node_children set) 4))
(defn lwbs-evidence-unresolved (set) (nth (node_children set) 5))
(defn lwbs-empty-evidence-set ()
    (lwbs-evidence-set
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)))

(defn lwbs-classify (evidence first second behavior-same set)
    (do
        (let observation (lwbs-evidence-observation evidence))
        (let ack (lwbs-observation-ack observation))
        (if (eq (oac-one? ack) 1)
            (if (eq behavior-same 0)
                (lwbs-evidence-set
                    (lwbs-evidence-first-supports set)
                    (lwbs-evidence-second-supports set)
                    (lwbs-evidence-dissents set)
                    (lwbs-evidence-silences set)
                    (lwbs-evidence-alternatives set)
                    (lwo-field-add (lwbs-evidence-unresolved set) evidence))
                (if (eq (lwbs-exact-direction?
                            observation first second) 1)
                    (lwbs-evidence-set
                        (lwo-field-add
                            (lwbs-evidence-first-supports set) evidence)
                        (lwbs-evidence-second-supports set)
                        (lwbs-evidence-dissents set)
                        (lwbs-evidence-silences set)
                        (lwbs-evidence-alternatives set)
                        (lwbs-evidence-unresolved set))
                    (lwbs-evidence-set
                        (lwbs-evidence-first-supports set)
                        (lwo-field-add
                            (lwbs-evidence-second-supports set) evidence)
                        (lwbs-evidence-dissents set)
                        (lwbs-evidence-silences set)
                        (lwbs-evidence-alternatives set)
                        (lwbs-evidence-unresolved set))))
            (if (eq (oac-zero? ack) 1)
                (lwbs-evidence-set
                    (lwbs-evidence-first-supports set)
                    (lwbs-evidence-second-supports set)
                    (lwo-field-add (lwbs-evidence-dissents set) evidence)
                    (lwbs-evidence-silences set)
                    (lwbs-evidence-alternatives set)
                    (lwbs-evidence-unresolved set))
                (if (eq (oac-nothing? ack) 1)
                    (lwbs-evidence-set
                        (lwbs-evidence-first-supports set)
                        (lwbs-evidence-second-supports set)
                        (lwbs-evidence-dissents set)
                        (lwo-field-add
                            (lwbs-evidence-silences set) evidence)
                        (lwbs-evidence-alternatives set)
                        (lwbs-evidence-unresolved set))
                    (if (eq (oac-alternative-ack? ack) 1)
                        (lwbs-evidence-set
                            (lwbs-evidence-first-supports set)
                            (lwbs-evidence-second-supports set)
                            (lwbs-evidence-dissents set)
                            (lwbs-evidence-silences set)
                            (lwo-field-add
                                (lwbs-evidence-alternatives set) evidence)
                            (lwbs-evidence-unresolved set))
                        (lwbs-evidence-set
                            (lwbs-evidence-first-supports set)
                            (lwbs-evidence-second-supports set)
                            (lwbs-evidence-dissents set)
                            (lwbs-evidence-silences set)
                            (lwbs-evidence-alternatives set)
                            (lwo-field-add
                                (lwbs-evidence-unresolved set) evidence))))))))

(defn lwbs-collect-evidence-items
    (world items first second behavior-same set)
    (if (eq (len items) 0) set
        (do
            (let observation (head items))
            (if (and (eq (lwbs-observation-valid? observation) 1)
                     (and (eq (lwbs-same-pair?
                                  observation first second) 1)
                          (eq (lwo-active? world observation) 1)))
                (lwbs-collect-evidence-items world (tail items) first second
                    behavior-same
                    (lwbs-classify
                        (lwbs-evidence observation
                            (lwo-active-attributions-for world observation))
                        first second behavior-same set))
                (lwbs-collect-evidence-items world (tail items) first second
                    behavior-same set)))))
(defn lwbs-evidence-for (world first second behavior-same)
    (lwbs-collect-evidence-items world
        (lwo-field-items (lwo-world-cells world)) first second behavior-same
        (lwbs-empty-evidence-set)))

(defn lwbs-evidence-count-items (items count)
    (if (eq (len items) 0) count
        (lwbs-evidence-count-items (tail items)
            (add count
                (lwo-field-size
                    (lwbs-evidence-attributions (head items)))))))
(defn lwbs-evidence-count (field)
    (lwbs-evidence-count-items (lwo-field-items field) 0))
(defn lwbs-blocker-count (set)
    (add (lwbs-evidence-count (lwbs-evidence-dissents set))
        (add (lwbs-evidence-count (lwbs-evidence-alternatives set))
             (lwbs-evidence-count (lwbs-evidence-unresolved set)))))

(defn lwbs-all-evidence-items (set)
    (append (lwo-field-items (lwbs-evidence-first-supports set))
        (append (lwo-field-items (lwbs-evidence-second-supports set))
            (append (lwo-field-items (lwbs-evidence-dissents set))
                (append (lwo-field-items (lwbs-evidence-silences set))
                    (append
                        (lwo-field-items (lwbs-evidence-alternatives set))
                        (lwo-field-items (lwbs-evidence-unresolved set))))))))
(defn lwbs-evidence-witness-items (items field)
    (if (eq (len items) 0) field
        (lwbs-evidence-witness-items (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwbs-evidence-attributions (head items))) field))))
(defn lwbs-field-witnesses (world first second set)
    (do
        (let with-first
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world first))
                (lwo-empty-field)))
        (let with-second
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world second)) with-first))
        (lwbs-evidence-witness-items (lwbs-all-evidence-items set)
            with-second)))

(defn lwbs-observation-alternatives-items (items field)
    (if (eq (len items) 0) field
        (do
            (let observation
                (lwbs-evidence-observation (head items)))
            (let explicit
                (lwac-field-union-items
                    (lwo-field-items
                        (lwbs-observation-alternatives observation)) field))
            (let ack (lwbs-observation-ack observation))
            (lwbs-observation-alternatives-items (tail items)
                (if (eq (oac-alternative-ack? ack) 1)
                    (lwo-field-add explicit
                        (oac-alternative-offered (oac-payload ack)))
                    (if (or (eq (oac-zero? ack) 1)
                            (and (eq (oac-node? ack) 1)
                                 (eq (oac-one? ack) 0)))
                        (lwo-field-add explicit (head items)) explicit))))))
(defn lwbs-field-alternatives (first-receipt second-receipt set)
    (do
        (let first-trial
            (lwo-emergent-shape (lwbs-receipt-trial first-receipt)))
        (let second-trial
            (lwo-emergent-shape (lwbs-receipt-trial second-receipt)))
        (let base
            (lwac-field-union-items
                (lwo-field-items (lwtn-trial-alternatives second-trial))
                (lwtn-trial-alternatives first-trial)))
        (lwbs-observation-alternatives-items
            (lwbs-all-evidence-items set) base)))
(defn lwbs-observation-unknowns-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown
                (lwbs-observation-unknown
                    (lwbs-evidence-observation (head items))))
            (lwbs-observation-unknowns-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))
(defn lwbs-field-unknowns
    (first-receipt second-receipt set status)
    (do
        (let first-trial
            (lwo-emergent-shape (lwbs-receipt-trial first-receipt)))
        (let second-trial
            (lwo-emergent-shape (lwbs-receipt-trial second-receipt)))
        (let base
            (lwac-field-union-items
                (lwo-field-items (lwtn-trial-unknowns second-trial))
                (lwtn-trial-unknowns first-trial)))
        (let offered
            (lwbs-observation-unknowns-items
                (lwbs-all-evidence-items set) base))
        (if (eq (lwbs-aligned? status) 1) offered
            (lwo-field-add offered (lwlc-unknown set)))))

; children: members (unordered semantic field), exact receipts, local behavior
; comparison, reciprocal evidence, status, alternatives, unknowns, witnesses,
; threshold, local path. There is deliberately no primary member.
(defn lwbs-field
    (members receipts comparison set status alternatives unknowns witnesses
     threshold)
    (intern_node LWBS-FIELD
        (list members receipts comparison set status alternatives unknowns
              witnesses (intern_trivial_int threshold) (lwo-local-path))))
(defn lwbs-field? (cell) (lwo-category? cell LWBS-FIELD))
(defn lwbs-field-members (field) (nth (node_children field) 0))
(defn lwbs-field-receipts (field) (nth (node_children field) 1))
(defn lwbs-field-comparison (field) (nth (node_children field) 2))
(defn lwbs-field-evidence (field) (nth (node_children field) 3))
(defn lwbs-field-status (field) (nth (node_children field) 4))
(defn lwbs-field-alternative-field (field) (nth (node_children field) 5))
(defn lwbs-field-unknown-field (field) (nth (node_children field) 6))
(defn lwbs-field-witness-field (field) (nth (node_children field) 7))
(defn lwbs-field-threshold-cell (field) (nth (node_children field) 8))
(defn lwbs-field-threshold (field)
    (node_value (lwbs-field-threshold-cell field)))
(defn lwbs-field-path (field) (nth (node_children field) 9))

(defn lwbs-field-for (world first second threshold)
    (do
        (let first-receipt (lwbs-receipt-for world first))
        (let second-receipt (lwbs-receipt-for world second))
        (if (or (node_eq first-receipt (lwo-none))
                (node_eq second-receipt (lwo-none))) (lwo-none)
            (do
                (let comparison
                    (lwbs-comparison-for first-receipt second-receipt))
                (let same (if (eq (oac-one? comparison) 1) 1 0))
                (let set (lwbs-evidence-for world first second same))
                (let first-count
                    (lwbs-evidence-count
                        (lwbs-evidence-first-supports set)))
                (let second-count
                    (lwbs-evidence-count
                        (lwbs-evidence-second-supports set)))
                (let blockers (lwbs-blocker-count set))
                (let status
                    (if (eq same 0) (lwbs-divergent)
                        (if (gt blockers 0) (lwbs-ambiguous)
                            (if (and (gt threshold 0)
                                     (and (ge first-count threshold)
                                          (ge second-count threshold)))
                                (lwbs-aligned) (lwbs-open)))))
                (let members
                    (lwo-field-add
                        (lwo-field-add (lwo-empty-field) first) second))
                (let receipts
                    (lwo-field-add
                        (lwo-field-add (lwo-empty-field) first-receipt)
                        second-receipt))
                (lwbs-field members receipts comparison set status
                    (lwbs-field-alternatives
                        first-receipt second-receipt set)
                    (lwbs-field-unknowns
                        first-receipt second-receipt set status)
                    (lwbs-field-witnesses world first second set)
                    threshold)))))

(defn lwbs-origin (first second threshold)
    (intern_node LWBS-ORIGIN
        (list first second (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwbs-proposal (world first second threshold)
    (do
        (let field (lwbs-field-for world first second threshold))
        (if (or (node_eq field (lwo-none))
                (eq (lwbs-aligned? (lwbs-field-status field)) 0))
            (lwo-none)
            (do
                (let witnesses (lwbs-field-witness-field field))
                (let count (lwo-field-size witnesses))
                (let origin (lwbs-origin first second threshold))
                (let candidate
                    (lwo-emergent field witnesses
                        (intern_trivial_int
                            (add
                                (lwbs-evidence-count
                                    (lwbs-evidence-first-supports
                                        (lwbs-field-evidence field)))
                                (lwbs-evidence-count
                                    (lwbs-evidence-second-supports
                                        (lwbs-field-evidence field)))))
                        (intern_trivial_int 2)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwbs-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwbs-field? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwbs-candidate-current? (world candidate)
    (if (eq (lwbs-candidate? candidate) 0) 0
        (do
            (let field (lwo-emergent-shape candidate))
            (let members (lwo-field-items (lwbs-field-members field)))
            (let fresh
                (lwbs-proposal world (nth members 1) (nth members 0)
                    (lwbs-field-threshold field)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwbs-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwbs-candidate-current? world candidate) 1)) 1 0))
(defn lwbs-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwbs-candidate-current? world
            (lwt-proposal-candidate proposal))))
(defn lwbs-integrate (round proposal action)
    (if (eq (lwbs-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- native species enquiry --------------------------------------------

; children: integrated species candidate, optional lens, alternatives,
; optional unknown, evidence, local path
(defn lwbs-question (species lens alternatives unknown evidence)
    (intern_node LWBS-QUESTION
        (list species lens alternatives unknown evidence (lwo-local-path))))
(defn lwbs-question? (cell) (lwo-category? cell LWBS-QUESTION))
(defn lwbs-question-species (question) (nth (node_children question) 0))
(defn lwbs-question-lens (question) (nth (node_children question) 1))
(defn lwbs-question-alternatives (question) (nth (node_children question) 2))
(defn lwbs-question-unknown (question) (nth (node_children question) 3))
(defn lwbs-question-evidence (question) (nth (node_children question) 4))
(defn lwbs-question-path (question) (nth (node_children question) 5))
(defn lwbs-question-valid? (question)
    (if (eq (lwbs-question? question) 0) 0
        (if (eq (lwbs-candidate?
                    (lwbs-question-species question)) 0) 0
            (if (and (not (node_eq (lwbs-question-lens question)
                                    (lwo-none)))
                     (eq (lwlc-lens?
                            (lwbs-question-lens question)) 0)) 0
                (if (eq (lwo-category?
                            (lwbs-question-alternatives question)
                            LWO-FIELD) 0) 0
                    (lwac-optional-unknown-valid?
                        (lwbs-question-unknown question)))))))

(defn lwbs-derivation (field question-attributions)
    (intern_node LWBS-DERIVATION
        (list field question-attributions (lwo-local-path))))
(defn lwbs-derivation? (cell) (lwo-category? cell LWBS-DERIVATION))
(defn lwbs-derivation-field (derivation) (nth (node_children derivation) 0))
(defn lwbs-derivation-question-attributions (derivation)
    (nth (node_children derivation) 1))
(defn lwbs-derivation-path (derivation) (nth (node_children derivation) 2))

; children: exact question/species, native member answer, receipts, signature,
; evidence, NODE ack, alternatives, unknowns, derivation, local path
(defn lwbs-answer
    (question species members receipts signature evidence ack alternatives
     unknowns derivation)
    (intern_node LWBS-ANSWER
        (list question species members receipts signature evidence ack
              alternatives unknowns derivation (lwo-local-path))))
(defn lwbs-answer? (cell) (lwo-category? cell LWBS-ANSWER))
(defn lwbs-answer-question (answer) (nth (node_children answer) 0))
(defn lwbs-answer-species (answer) (nth (node_children answer) 1))
(defn lwbs-answer-members (answer) (nth (node_children answer) 2))
(defn lwbs-answer-receipts (answer) (nth (node_children answer) 3))
(defn lwbs-answer-signature (answer) (nth (node_children answer) 4))
(defn lwbs-answer-evidence (answer) (nth (node_children answer) 5))
(defn lwbs-answer-ack (answer) (nth (node_children answer) 6))
(defn lwbs-answer-alternatives (answer) (nth (node_children answer) 7))
(defn lwbs-answer-unknowns (answer) (nth (node_children answer) 8))
(defn lwbs-answer-derivation (answer) (nth (node_children answer) 9))
(defn lwbs-answer-path (answer) (nth (node_children answer) 10))

(defn lwbs-answer-alternatives-for (field question)
    (lwac-field-union-items
        (lwo-field-items (lwbs-question-alternatives question))
        (lwbs-field-alternative-field field)))
(defn lwbs-answer-unknowns-for (field question)
    (do
        (let unknown (lwbs-question-unknown question))
        (if (node_eq unknown (lwo-none))
            (lwbs-field-unknown-field field)
            (lwo-field-add (lwbs-field-unknown-field field) unknown))))
(defn lwbs-answer-for (world question threshold)
    (if (or (eq (lwbs-question-valid? question) 0)
            (le threshold 0)) (lwo-none)
        (do
            (let species (lwbs-question-species question))
            (if (eq (lwbs-integrated-current? world species) 0) (lwo-none)
                (do
                    (let question-attributions
                        (lwo-active-attributions-for world question))
                    (if (lt (lwo-field-size question-attributions) threshold)
                        (lwo-none)
                        (do
                            (let field (lwo-emergent-shape species))
                            (let comparison
                                (lwbs-field-comparison field))
                            (let signature (oac-payload comparison))
                            (let members (lwbs-field-members field))
                            (lwbs-answer question species members
                                (lwbs-field-receipts field) signature
                                (lwbs-field-evidence field)
                                (oac-node members)
                                (lwbs-answer-alternatives-for field question)
                                (lwbs-answer-unknowns-for field question)
                                (lwbs-derivation field
                                    question-attributions)))))))))
(defn lwbs-answer-witnesses (world question)
    (lwac-field-union-items
        (lwo-field-items
            (lwo-active-attributions-for world question))
        (lwo-active-attributions-for world
            (lwbs-question-species question))))
(defn lwbs-answer-origin (question threshold)
    (intern_node LWBS-ANSWER-ORIGIN
        (list question (intern_trivial_int threshold) (lwo-local-path))))
(defn lwbs-answer-proposal (world question threshold)
    (do
        (let answer (lwbs-answer-for world question threshold))
        (if (node_eq answer (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwbs-answer-witnesses world question))
                (let count (lwo-field-size witnesses))
                (let origin (lwbs-answer-origin question threshold))
                (let candidate
                    (lwo-emergent answer witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwbs-answer-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwbs-answer? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwbs-answer-threshold (proposal)
    (node_value (nth (node_children (lwt-proposal-origin proposal)) 1)))
(defn lwbs-answer-candidate-current? (world candidate threshold)
    (if (eq (lwbs-answer-candidate? candidate) 0) 0
        (do
            (let answer (lwo-emergent-shape candidate))
            (let question (lwbs-answer-question answer))
            (let current (lwbs-answer-for world question threshold))
            (if (and (node_eq answer current)
                     (node_eq (lwo-emergent-witnesses candidate)
                        (lwbs-answer-witnesses world question))) 1 0))))
(defn lwbs-answer-integrated-current? (world candidate threshold)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwbs-answer-candidate-current?
                    world candidate threshold) 1)) 1 0))
(defn lwbs-answer-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwbs-answer-candidate-current? world
            (lwt-proposal-candidate proposal)
            (lwbs-answer-threshold proposal))))
(defn lwbs-answer-integrate (round proposal action)
    (if (eq (lwbs-answer-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
