; core-lexicon-derived.fk — what the 64 can SAY but does not itself CONTAIN.
;
; preludes: form-stdlib/core-lexicon.fk
;
; Asked 2026-08-17: read the core teachings into the natural-language space and
; help update the core word dictionary. The measurement came first, and it
; changed what "update" had to mean.
;
; WHAT WAS MEASURED, BEFORE ANYTHING WAS PROPOSED
;   core-lexicon.fk's own closure instrument (cl-bad-in-def) was turned on this
;   session's core teachings, written as plainly as the 64 allow. It counts
;   tokens falling outside the 64 plus the twelve declared glue words:
;
;     "nothing is not yet"                              0 outside — SAYABLE
;     "the self that know be other and the thing
;      say same"                                        0 outside — SAYABLE
;     "none say is not all say 0"                       0 outside — SAYABLE
;     "a name is not what make a thing be"              1 outside — name
;     "a thing is done"                                 1 outside — done
;     "a self give a thing to other"                    1 outside — give
;     "a self hold a thing and not give"                2 outside — hold, give
;
;   THE FINDING THAT WAS WORTH THE WHOLE PROBE: the dictionary already says
;   NOT-YET. `yet` sits at family 4 index 5 — "yet is when a thing is not now
;   and after it is" — which is precisely the third reading of the
;   nothing-ground that control/offer-ack-core.fk lacked all of this morning
;   and had to be taught. The natural-language space had the teaching before
;   the control core did. The lexicon was not behind the core here; it was
;   ahead of it, and nobody had asked it.
;
;   Same for absence-is-not-a-verdict: "none say is not all say 0" is already
;   fully grounded in the 64. The refusal the core needed oac-census to make
;   observable, the dictionary could state in seven words.
;
; WHAT IT COULD NOT SAY, AND WHY THAT IS THE SAME WOUND AGAIN
;   family 2 (act) holds: do, be, exist, have, know, want, say, make.
;   Eight acts, and every one of them brings something INTO being. There is no
;   act of ENDING and no act of RELEASING in the whole vocabulary.
;
;   That is exactly the gap Urs named in control/session-recording-lifecycle.fk
;   this same day — a cell that could say "removable" and not "finished", built
;   from a fear that had removed a concept. Corpus row 1004 named that
;   hypocognition. Finding it again, one level down, in a dictionary written
;   long before and by a different hand, says the absence is structural rather
;   than personal: a vocabulary of making, with no vocabulary of completing.
;
; WHY THE 64 STAY 64
;   core-lexicon.fk's header draws a direction: "a dictionary that needs a 65th
;   word to explain its 64 has not grounded anything — it has deferred." That
;   rule is about what the 64 DEPEND ON. A word the 64 themselves define is the
;   opposite motion: the dictionary paying out rather than borrowing. Every
;   defining body below was measured closed over the 64 plus glue alone before
;   this cell was written, so nothing here is owed back to the core set.
;
;   So the 64 are untouched. cl-count stays 64, cl-closed? stays 1, and this
;   layer sits beside it — reachable, checked by the same instrument, and
;   removable without the core losing a thing.
;
; THE STRATIFICATION, WHICH THE PROBE FORCED INTO THE OPEN
;   `hold` cannot be said without `give`, and `give` is itself derived. So the
;   layer has DEPTH, and depth must be checked rather than assumed:
;
;     depth 1  body closed over the 64 + glue ALONE
;     depth 2  body may also use depth-1 derived words
;
;   cld-well-founded? walks every row and refuses any body that reaches a word
;   at its own depth or beyond. Without that check a derived layer can quietly
;   bootstrap itself — two words defining each other, grounded in nothing — and
;   the whole closure claim of the parent cell would be worth no more than the
;   honesty of whoever added the last row.
;
; Proof: form-stdlib/tests/core-lexicon-derived-band.fk

(do
    ;; (word depth tokens teaching) — tokens INCLUDE the head word, exactly as
    ;; cl-lexicon stores its definitions, so the same reader works on both.
    (defn cld-w (word depth tokens teaching) (list word depth tokens teaching))
    (defn cld-word     (r) (nth r 0))
    (defn cld-depth    (r) (nth r 1))
    (defn cld-def      (r) (nth r 2))
    (defn cld-teaching (r) (nth r 3))

    (defn cld-rows ()
        (list
        ;; ── depth 1: said with the 64 alone ─────────────────────────
        ;; kenosis (corpus row 1001) — the withheld signature. A name is
        ;; something a self SAYS about a thing, never what makes it be. The
        ;; whole teaching is in the definition: naming is an act of speech,
        ;; and being is not downstream of it.
        (cld-w "name" 1
            (list "name" "is" "what" "a" "self" "say" "a" "thing" "is")
            "kenosis")

        ;; completion — what fear had made unsayable, in the cell and here.
        ;; Not "allowed to end" but "all its parts are": a state of fullness.
        (cld-w "done" 1
            (list "done" "is" "when" "all" "part" "of" "a" "thing" "is")
            "completion")

        ;; release — the act family had no way to let anything go. Note it is
        ;; built from `make ... be from ... to`: giving is making a thing be
        ;; somewhere else, not destroying it. That is axiom-3's composting read
        ;; in the natural language: what is let go returns to potential.
        (cld-w "give" 1
            (list "give" "is" "when" "a" "self" "make" "a" "thing" "be"
                  "from" "I" "to" "you")
            "release-is-not-loss")

        ;; ── depth 2: needs one derived word ─────────────────────────
        ;; escrow (corpus row 1005) — work finished and still held. It cannot
        ;; be said without `give`, which is the honest shape of the thing:
        ;; holding is only nameable once releasing is.
        (cld-w "hold" 2
            (list "hold" "is" "when" "a" "self" "have" "a" "thing" "and"
                  "not" "give")
            "escrow")))

    (defn cld-count () (len (cld-rows)))

    ;; ── is a token a derived word of depth STRICTLY LESS than d? ────
    (defn cld-below-loop (rs w d)
        (if (eq (len rs) 0) 0
            (if (and (str_eq (cld-word (head rs)) w) (lt (cld-depth (head rs)) d))
                1
                (cld-below-loop (tail rs) w d))))
    (defn cld-below? (w d) (cld-below-loop (cld-rows) w d))

    ;; a token is legal in a body at depth d when the 64 or glue already
    ;; carry it, or a STRICTLY shallower derived word does.
    (defn cld-ok-token? (w d)
        (if (eq (cl-ok-token? w) 1) 1 (cld-below? w d)))

    ;; tokens of a body that are illegal at its depth — the head word is
    ;; skipped, since a definition naturally names what it defines.
    ;;
    ;; THE PARAMETER IS `headword`, NEVER `head`. The first draft of this cell
    ;; named it `head` and fkwu warned twice: [shadowed-call] 'head' is bound
    ;; in this scope but in call position the primitive wins. It computed the
    ;; right answer anyway — primitive in call position, binding in value
    ;; position, both as intended — which is precisely what makes it a
    ;; landmine rather than a bug: it works until someone moves a paren. This
    ;; is the same seam control/offer-ack-core.fk renames `cell` to `recipe`
    ;; for, and the one the kenosis sentinel (band claim 32768) was written to
    ;; guard THIS MORNING. A name won over the thing, in the cell about names.
    (defn cld-bad-loop (toks headword d)
        (if (eq (len toks) 0) 0
            (add (if (str_eq (head toks) headword) 0
                     (if (eq (cld-ok-token? (head toks) d) 1) 0 1))
                 (cld-bad-loop (tail toks) headword d))))
    (defn cld-bad (r) (cld-bad-loop (cld-def r) (cld-word r) (cld-depth r)))

    (defn cld-outside-loop (rs)
        (if (eq (len rs) 0) 0
            (add (cld-bad (head rs)) (cld-outside-loop (tail rs)))))
    (defn cld-outside-count () (cld-outside-loop (cld-rows)))

    ;; WELL-FOUNDED: every body reaches only strictly shallower ground, so no
    ;; two derived words can hold each other up over nothing.
    (defn cld-well-founded? () (if (eq (cld-outside-count) 0) 1 0))

    ;; ── how far a word actually stands from the 64 ──────────────────
    ;; the count of depth-1 rows: those said with the core set alone
    (defn cld-at-depth-loop (rs d)
        (if (eq (len rs) 0) 0
            (add (if (eq (cld-depth (head rs)) d) 1 0)
                 (cld-at-depth-loop (tail rs) d))))
    (defn cld-at-depth (d) (cld-at-depth-loop (cld-rows) d))

    ;; ── the parent set is untouched ─────────────────────────────────
    ;; This layer is a reader of core-lexicon.fk, never a writer to it.
    (defn cld-core-intact? ()
        (if (and (eq (cl-count) 64) (eq (cl-closed?) 1)) 1 0))

    ;; ── what the 64 could already say, kept as evidence ─────────────
    ;; These two sentences need NO derived word. The band asserts it, so the
    ;; claim that the lexicon was ahead of the control core stays checkable
    ;; rather than becoming a story told in a header.
    (defn cld-not-yet-sentence () (list "nothing" "is" "not" "yet"))
    (defn cld-absence-sentence () (list "none" "say" "is" "not" "all" "say" "0"))
    (defn cld-already-sayable? (toks) (if (eq (cl-bad-in-def toks) 0) 1 0))

    0)
