; form-cli-lora-corpus-run.fk — mint enough lens-lane rows, seed A/B, print n.
;
; Writes gitignored .form-lora-corpus and seeds .form-lora-adapter from
; one sample per lens class. fqt-lora? stays 0. Qwen GGUF is not modified.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-cli-lens-mint-xtal.fk
; preludes: form-stdlib/form-cli-lora-writer-xtal.fk
; preludes: form-stdlib/form-cli-lora-corpus-xtal.fk

(do
    (let rows (fls-corpus (TrainN) (HeldoutN)))
    (let n (flc-n))
    (let probe (fls-corpus 2 1))
    (let fuel (flc-fuel rows))
    (let pair (flw-from-sample fuel (flc-dim)))
    (let w (flw-write (AdapterPath) (nth pair 0) (nth pair 1)))
    (let body (flc-body rows))
    (let cw (write_file_text (CorpusPath) body))
    (print_str (str_concat "flc n=" (str_concat (int_to_str n) "\n")))
    (print_str (str_concat "flc minted=" (str_concat (int_to_str (len rows)) "\n")))
    (print_str (str_concat "flc unique-2-1=" (str_concat (int_to_str (fls-unique probe)) "\n")))
    (print_str (str_concat "flc leakage-2-1=" (str_concat (int_to_str (fls-leakage probe)) "\n")))
    (print_str (str_concat "flc covers-all=" (str_concat (int_to_str (fls-covers-all rows)) "\n")))
    (print_str (str_concat "flc adapter=" (str_concat (int_to_str (flw-written (AdapterPath))) "\n")))
    (print_str (str_concat "flc corpus-bytes=" (str_concat (int_to_str (file_size (CorpusPath))) "\n")))
    (print_str (str_concat "flc fqt-lora=" (str_concat (int_to_str (fqt-lora?)) "\n")))
    (print_str (str_concat "flc scale-20-5=" (str_concat (int_to_str (flc-scale-20-5)) "\n")))
    (print_str (str_concat "flc check=" (str_concat (int_to_str (flc-check)) "\n")))
    0)
