//////////////////////////////////////////////////////////////////////
//
// native-model-dual-telemetry.bml — executable truth-separated rows.
//
// Authority: form-stdlib/bml/native-model-dual-telemetry.bml
// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelDualTelemetryAuthority {
        field NMDTAuthorityPath = "form/form-stdlib/bml/native-model-dual-telemetry.bml";
        field NMDTAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelDualTelemetry {
        field NMDTOwnerCorrelationSchema = "native-model-owner-correlation-v1";
        ref nmdt-authority = NativeModelDualTelemetryAuthority;
        thought nmdt-law = list("publication-is-not-access", "semantic-access-epochs-survive-heartbeats", "substate-is-derived", "provenance-is-separated", "owner-lifetime-is-correlated", "idle-cadence-waits-for-timed-ingress", "close-leaves-tombstone");

        def nmdt-access-epoch(epoch) = if lt(epoch, 0) then fgtm-absent() else fgtm-present(epoch);
        def nmdt-resident-sample(id, lifecycle, handle, readEpoch, writeEpoch) = fgtm-sample(id, fgtm-absent(), "model", "metal", id, "reasoning", "resident-model", fgtm-absent(), fgtm-absent(), lifecycle, nmdt-access-epoch(readEpoch), nmdt-access-epoch(writeEpoch), fgtm-absent(), fgtm-present(handle), "unknown", "physical-live", "model.carrier", list("memory", "model", "metal", "gpu", "query-lane"));
        def nmdt-weight-catalog(id, parent, bytes, readEpoch) = fgtm-sample(id, fgtm-present(parent), "weights", "disk", parent, "reasoning", "model-weights", fgtm-present(bytes), fgtm-absent(), "unknown", nmdt-access-epoch(readEpoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", "catalog", "gguf.catalog", list("memory", "model", "cache"));
        def nmdt-budget-sample(bytes) = fgtm-sample("budget.models.unified", fgtm-absent(), "budget", "unified", "models", "memory", "pressure-budget", fgtm-absent(), fgtm-present(bytes), "pinned", fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), "unknown", "declared", "model.fleet-policy", list("memory", "model", "health"));
        def nmdt-derived-substate(id, parent, kind, purpose, lifecycle, handle, readEpoch, writeEpoch, channels) = fgtm-sample(id, fgtm-present(parent), kind, "metal", parent, "reasoning", purpose, fgtm-absent(), fgtm-absent(), lifecycle, nmdt-access-epoch(readEpoch), nmdt-access-epoch(writeEpoch), fgtm-absent(), fgtm-present(handle), "unknown", "derived-window", "model.layout", channels);
        def nmdt-token-position(id, parent, position, lifecycle, handle, accessEpoch) = fgtm-sample(id, fgtm-present(parent), "token-position", "metal", parent, "reasoning", "context-position", fgtm-absent(), fgtm-present(position), lifecycle, nmdt-access-epoch(accessEpoch), nmdt-access-epoch(accessEpoch), fgtm-absent(), fgtm-present(handle), "unknown", "physical-live", "model.context-position", list("memory", "model", "metal", "gpu", "token", "tensor", "layer", "query-lane"));

        // The incarnation is deterministic from the Form-entry epoch.  The
        // publisher repeats it, so PID reuse cannot silently join two owners.
        def nmdt-owner-incarnation(startedEpoch) = str_concat("i", int_to_str(startedEpoch));
        def nmdt-owner-publisher(startedEpoch) = str_concat("models.dual-resident.", nmdt-owner-incarnation(startedEpoch));
        def nmdt-owner-correlation(publisher, pid, startedEpoch, incarnation, sequence, observedEpoch) = list(NMDTOwnerCorrelationSchema(), publisher, pid, startedEpoch, incarnation, sequence, observedEpoch);
        def nmdt-owner-publisher-of(correlation) = nth(correlation, 1);
        def nmdt-owner-pid(correlation) = nth(correlation, 2);
        def nmdt-owner-started(correlation) = nth(correlation, 3);
        def nmdt-owner-incarnation-of(correlation) = nth(correlation, 4);
        def nmdt-owner-sequence(correlation) = nth(correlation, 5);
        def nmdt-owner-observed(correlation) = nth(correlation, 6);
        def nmdt-owner-correlation?(correlation) = if nothing?(correlation) then 0 else if not(eq(len(correlation), 7)) then 0 else if not(str_eq(head(correlation), NMDTOwnerCorrelationSchema())) then 0 else if not(eq(fgtm-label?(nmdt-owner-publisher-of(correlation)), 1)) then 0 else if le(nmdt-owner-pid(correlation), 0) then 0 else if lt(nmdt-owner-started(correlation), 0) then 0 else if not(str_eq(nmdt-owner-incarnation-of(correlation), nmdt-owner-incarnation(nmdt-owner-started(correlation)))) then 0 else if not(str_eq(nmdt-owner-publisher-of(correlation), nmdt-owner-publisher(nmdt-owner-started(correlation)))) then 0 else if lt(nmdt-owner-sequence(correlation), 0) then 0 else if lt(nmdt-owner-observed(correlation), nmdt-owner-started(correlation)) then 0 else 1;
        def nmdt-owner-heartbeat-id(correlation) = str_concat("heartbeat.", str_concat(nmdt-owner-incarnation-of(correlation), str_concat(".s", int_to_str(nmdt-owner-sequence(correlation)))));
        def nmdt-owner-heartbeat-sample(correlation) = if not(eq(nmdt-owner-correlation?(correlation), 1)) then list("native-model-owner-heartbeat-invalid-v1") else fgtm-sample(nmdt-owner-heartbeat-id(correlation), fgtm-absent(), "owner-heartbeat", "form", nmdt-owner-publisher-of(correlation), "model-owner", "dual-model-owner", fgtm-absent(), fgtm-absent(), "active", fgtm-present(nmdt-owner-observed(correlation)), fgtm-present(nmdt-owner-started(correlation)), fgtm-absent(), fgtm-present(nmdt-owner-pid(correlation)), "never", "physical-live", "model.owner", list("process", "model", "health", "membrane"));

        // A state-bit row is an observation of the in-memory session at the
        // heartbeat epoch.  It does not advance the model's semantic access.
        def nmdt-model-state-lifecycle(enabled) = if eq(enabled, 1) then "active" else "idle";
        def nmdt-model-state-sample(id, parent, state, enabled, handle, observedEpoch) = fgtm-sample(id, fgtm-present(parent), "model-state", "metal", parent, "reasoning", state, fgtm-absent(), fgtm-absent(), nmdt-model-state-lifecycle(enabled), fgtm-present(observedEpoch), fgtm-present(observedEpoch), fgtm-absent(), fgtm-present(handle), "never", "physical-live", "model.session", list("memory", "model", "metal", "gpu", "health", "query-lane"));
        def nmdt-release-tombstone(id, closeResult, writeEpoch) = fgtm-sample(id, fgtm-absent(), "model", "metal", id, "reasoning", "resident-model", fgtm-absent(), fgtm-absent(), if eq(closeResult, 1) then "released" else "failed", fgtm-absent(), nmdt-access-epoch(writeEpoch), fgtm-absent(), fgtm-absent(), if eq(closeResult, 1) then "released" else "unknown", "physical-live", "model.carrier", list("memory", "model", "metal", "gpu", "query-lane"));
    }
    0;
}
