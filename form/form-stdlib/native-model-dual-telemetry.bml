//////////////////////////////////////////////////////////////////////
//
// native-model-dual-telemetry.bml — executable truth-separated rows.
//
// Authority: form-stdlib/bml/native-model-dual-telemetry.bml
// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelDualTelemetryAuthority {
        field NMDTAuthorityPath = "form/form-stdlib/bml/native-model-dual-telemetry.bml";
        field NMDTAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelDualTelemetry {
        ref nmdt-authority = NativeModelDualTelemetryAuthority;
        thought nmdt-law = list("publication-is-not-access", "substate-is-derived", "provenance-is-separated", "close-leaves-tombstone");

        def nmdt-resident-sample(id, lifecycle, handle) = fgtm-sample(id, fgtm-absent(), "model", "metal", id, "reasoning", "resident-model", fgtm-absent(), fgtm-absent(), lifecycle, fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-present(handle), "unknown", "physical-live", "model.carrier", list("memory", "model", "metal", "gpu", "query-lane"));
        def nmdt-weight-catalog(id, parent, bytes) = fgtm-sample(id, fgtm-present(parent), "weights", "disk", parent, "reasoning", "model-weights", fgtm-present(bytes), fgtm-absent(), "unknown", fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", "catalog", "gguf.catalog", list("memory", "model", "cache"));
        def nmdt-budget-sample(bytes) = fgtm-sample("budget.models.unified", fgtm-absent(), "budget", "unified", "models", "memory", "pressure-budget", fgtm-absent(), fgtm-present(bytes), "pinned", fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), "unknown", "declared", "model.fleet-policy", list("memory", "model", "health"));
        def nmdt-derived-substate(id, parent, kind, purpose, lifecycle, handle, channels) = fgtm-sample(id, fgtm-present(parent), kind, "metal", parent, "reasoning", purpose, fgtm-absent(), fgtm-absent(), lifecycle, fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-present(handle), "unknown", "derived-window", "model.layout", channels);
        def nmdt-release-tombstone(id, closeResult) = fgtm-sample(id, fgtm-absent(), "model", "metal", id, "reasoning", "resident-model", fgtm-absent(), fgtm-absent(), if eq(closeResult, 1) then "released" else "failed", fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), if eq(closeResult, 1) then "released" else "unknown", "physical-live", "model.carrier", list("memory", "model", "metal", "gpu", "query-lane"));
    }
    0;
}
