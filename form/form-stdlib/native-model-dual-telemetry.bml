//////////////////////////////////////////////////////////////////////
//
// native-model-dual-telemetry.bml — executable truth-separated rows.
//
// Authority: form-stdlib/bml/native-model-dual-telemetry.bml
// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/native-model-tensor-ledger.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelDualTelemetryAuthority {
        field NMDTAuthorityPath = "form/form-stdlib/bml/native-model-dual-telemetry.bml";
        field NMDTAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelDualTelemetry {
        field NMDTOwnerCorrelationSchema = "native-model-owner-correlation-v1";
        ref nmdt-authority = NativeModelDualTelemetryAuthority;
        thought nmdt-law = list("publication-is-not-access", "semantic-access-epochs-survive-heartbeats", "substate-is-derived", "callable-is-not-resident-pages", "catalog-is-not-open-artifact-stat", "open-stat-is-not-content-identity", "strong-identity-is-carried-not-profile-labeled", "mapped-materialized-and-catalog-are-separate", "owner-runtime-counters-include-observation-cost", "owner-lifetime-is-correlated", "stable-sample-identities", "unbound-nodeid-has-an-exact-door", "idle-cadence-waits-for-timed-ingress", "close-leaves-tombstone");

        def nmdt-access-epoch(epoch) = epoch < 0 ? fgtm-absent() : fgtm-present(epoch);
        def nmdt-state-clock(loadedEpoch, prefilledEpoch, activeEpoch) = list(loadedEpoch, prefilledEpoch, activeEpoch);
        def nmdt-state-loaded-epoch(clock) = clock[0];
        def nmdt-state-prefilled-epoch(clock) = clock[1];
        def nmdt-state-active-epoch(clock) = clock[2];
        def nmdt-state-active-at(clock, epoch) = nmdt-state-clock(nmdt-state-loaded-epoch(clock), nmdt-state-prefilled-epoch(clock), epoch);
        def nmdt-callable-sample(id, owner, lifecycle, handle, readEpoch, writeEpoch) = fgtm-sample(id, fgtm-absent(), "model", "metal", owner, "reasoning", "callable-model-context", fgtm-absent(), fgtm-absent(), lifecycle, nmdt-access-epoch(readEpoch), nmdt-access-epoch(writeEpoch), fgtm-absent(), fgtm-present(handle), "inactive-only", "physical-live", "model.carrier-handle", list("memory", "model", "metal", "gpu", "query-lane", "node-id-unbound"));
        // Compatibility for fixture callers.  This now reports only a callable
        // context; the handle never upgrades it to resident-page evidence.
        def nmdt-resident-sample(id, lifecycle, handle, readEpoch, writeEpoch) = nmdt-callable-sample(id, id, lifecycle, handle, readEpoch, writeEpoch);
        def nmdt-missing-extent-sample(id, parent, owner, kind, purpose, observedEpoch, door) = fgtm-sample(id, fgtm-present(parent), kind, "unified", owner, "memory", purpose, fgtm-absent(), fgtm-absent(), "unknown", nmdt-access-epoch(observedEpoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "inactive-only", "declared", door, list("memory", "model", "health", "node-id-unbound"));
        def nmdt-owner-counter-sample(id, kind, plane, owner, lane, purpose, value, observedEpoch, source, channels) = fgtm-sample(id, fgtm-absent(), kind, plane, owner, lane, purpose, fgtm-absent(), fgtm-present(value), "active", nmdt-access-epoch(observedEpoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "physical-live", source, append(channels, list("node-id-unbound")));
        def nmdt-owner-missing-sample(id, kind, plane, owner, lane, purpose, observedEpoch, door, channels) = fgtm-sample(id, fgtm-absent(), kind, plane, owner, lane, purpose, fgtm-absent(), fgtm-absent(), "unknown", nmdt-access-epoch(observedEpoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "declared", door, append(channels, list("node-id-unbound")));
        def nmdt-owner-nodeid-seam(owner, observedEpoch) = nmdt-owner-missing-sample("nodeid.owner.telemetry", "node-id-binding", "form", owner, "model-owner", "snapshot-row-nodeid-binding", observedEpoch, "model.owner.telemetry-nodeid-mint", list("process", "model", "health"));
        // The telemetry membrane's plane vocabulary is deliberately small.
        // A file-backed no-copy tensor view is a disk extent; an allocated
        // Metal buffer is unified memory.  More descriptive phrases belong in
        // kind/purpose, never in an invalid plane that makes publication fail.
        def nmdt-tensor-group-plane(group) = (String) nmtl-group-kind(group) == "mapped-tensors" ? "disk" : "unified";
        def nmdt-tensor-group-lifecycle(group) = (String) nmtl-group-kind(group) == "mapped-tensors" ? "mapped" : "resident";
        def nmdt-tensor-group-sample(group) = (Comparable) nmtl-group-valid?(group) == 1 ? fgtm-sample(nmtl-group-id(group), fgtm-present(nmtl-group-parent(group)), nmtl-group-kind(group), nmdt-tensor-group-plane(group), nmtl-group-owner(group), "memory", nmtl-group-kind(group), fgtm-present(nmtl-group-bytes(group)), fgtm-present(nmtl-group-handles(group)), nmdt-tensor-group-lifecycle(group), fgtm-present(nmtl-group-observed(group)), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", "physical-live", nmtl-group-source(group), append(nmtl-group-channels(group), list("node-id-unbound"))) : nmdt-owner-missing-sample(nmtl-group-id(group), nmtl-group-kind(group), nmdt-tensor-group-plane(group), nmtl-group-owner(group), "memory", "handle-byte-reconciliation-failed", nmtl-group-observed(group), "model.tensor-allocation-reconciliation", nmtl-group-channels(group));
        def nmdt-tensor-group-samples(groups) = (Comparable) len(groups) == 0 ? list() : cons(nmdt-tensor-group-sample(head(groups)), nmdt-tensor-group-samples(tail(groups)));
        def nmdt-tensor-reconcile-sample(id, parent, owner, plane, expected, observed, epoch, source, channels) = observed < 0 ? nmdt-owner-missing-sample(id, "tensor-reconciliation", plane, owner, "memory", "carrier-count-not-published", epoch, source, channels) : fgtm-sample(id, fgtm-present(parent), "tensor-reconciliation", plane, owner, "memory", (Comparable) expected == observed ? "reconciled" : "count-mismatch", fgtm-absent(), fgtm-present(observed), (Comparable) expected == observed ? "ready" : "failed", fgtm-present(epoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "derived-window", source, append(channels, list("node-id-unbound")));
        def nmdt-tensor-ledger-total-sample(groups, owner, epoch) = fgtm-sample("tensor.owner.ledger", fgtm-absent(), "tensor-ledger", "unified", owner, "memory", "all-buffer-handle-count", fgtm-absent(), fgtm-present(nmtl-groups-handles(groups)), "resident", fgtm-present(epoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", "physical-live", "native-model-tensor-ledger", list("process", "model", "memory", "tensor", "metal", "gpu", "health", "node-id-unbound"));
        def nmdt-tensor-mapped-total-sample(groups, owner, epoch) = fgtm-sample("tensor.owner.mapped", fgtm-absent(), "tensor-ledger", "disk", owner, "memory", "gguf-record-mapped-extents", fgtm-present(nmtl-groups-kind-bytes(groups, "mapped-tensors")), fgtm-present(nmtl-groups-kind-handles(groups, "mapped-tensors")), "mapped", fgtm-present(epoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", "physical-live", "native-model-tensor-ledger", list("process", "model", "memory", "tensor", "metal", "gpu", "health", "node-id-unbound"));
        def nmdt-tensor-allocated-total-sample(groups, owner, epoch) = fgtm-sample("tensor.owner.allocated", fgtm-absent(), "tensor-ledger", "unified", owner, "memory", "reusable-scratch-state-kv-extents", fgtm-present(nmtl-groups-allocated-bytes(groups)), fgtm-present(nmtl-groups-allocated-handles(groups)), "resident", fgtm-present(epoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", "physical-live", "native-model-tensor-ledger", list("process", "model", "memory", "tensor", "metal", "gpu", "health", "node-id-unbound"));
        def nmdt-tensor-reconcile-samples(groups, status, owner, epoch) {
            let expectedAll = nmtl-groups-handles(groups);
            let expectedMapped = nmtl-groups-kind-handles(groups, "mapped-tensors");
            let observedAll = nmdt-status-int(status, "buffers");
            let observedMapped = nmdt-status-int(status, "mmap_nocopy_buffers");
            list(
                nmdt-tensor-ledger-total-sample(groups, owner, epoch),
                nmdt-tensor-mapped-total-sample(groups, owner, epoch),
                nmdt-tensor-allocated-total-sample(groups, owner, epoch),
                nmdt-tensor-reconcile-sample("tensor.owner.buffer-reconciliation", "tensor.owner.ledger", owner, "unified", expectedAll, observedAll, epoch, "metal_status.buffers", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                nmdt-tensor-reconcile-sample("tensor.owner.mapped-reconciliation", "tensor.owner.mapped", owner, "disk", expectedMapped, observedMapped, epoch, "metal_status.mmap_nocopy_buffers", list("process", "model", "memory", "tensor", "metal", "gpu", "health")));
        }
        def nmdt-status-start(status, key) {
            let first = key ++ "=";
            let later = "\n" ++ first;
            let atFirst = str_find(status, first, 0);
            let atLater = str_find(status, later, 0);
            (Comparable) atFirst == 0 ? str_len(first) : atLater < 0 ? -1 : (atLater + str_len(later));
        }
        def nmdt-status-text-from(status, start) {
            let stop = str_find(status, "\n", start);
            stop < 0 ? substring(status, start, str_len(status)) : substring(status, start, stop);
        }
        def nmdt-status-int-found(status, start) {
            let value = nmdt-status-text-from(status, start);
            (Comparable) fgtm-uint-text?(value) == 1 ? str_to_int(value) : -1;
        }
        def nmdt-status-int(status, key) {
            let start = nmdt-status-start(status, key);
            start < 0 ? -1 : nmdt-status-int-found(status, start);
        }
        def nmdt-metal-counter(status, id, kind, lane, purpose, key, source, owner, epoch, channels) {
            let value = nmdt-status-int(status, key);
            value < 0 ? nmdt-owner-missing-sample(id, kind, "metal", owner, lane, purpose, epoch, source, channels) : nmdt-owner-counter-sample(id, kind, "metal", owner, lane, purpose, value, epoch, source, channels);
        }
        def nmdt-weight-catalog(id, parent, bytes, readEpoch) = fgtm-sample(id, fgtm-present(parent), "weights", "disk", parent, "reasoning", "model-weights", fgtm-present(bytes), fgtm-absent(), "unknown", nmdt-access-epoch(readEpoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", "catalog", "gguf.catalog", list("memory", "model", "cache"));
        def nmdt-open-artifact-sample-at(id, parent, owner, bytes, modified, handle, openEpoch, source, channels) = (bytes <= 0) || ((modified <= 0) || (handle <= 0)) ? nmdt-owner-missing-sample(id, "artifact-open-stat", "disk", owner, "memory", "open-time-file-stat-not-observed", openEpoch, source, channels) : fgtm-sample(id, fgtm-present(parent), "artifact-open-stat", "disk", owner, "memory", "open-time-file-stat", fgtm-present(bytes), fgtm-present(modified), "mapped", fgtm-present(openEpoch), fgtm-absent(), fgtm-absent(), fgtm-present(handle), "pressure-only", "physical-live", source, append(channels, list("node-id-unbound")));
        def nmdt-open-artifact-sample(id, parent, owner, path, handle, openEpoch, source, channels) {
            nmdt-open-artifact-sample-at(id, parent, owner, file_size(path), file_mtime(path), handle, openEpoch, source, channels);
        }
        // Strong identity is a separate wire sample: the kind physically
        // carries its strength and purpose physically carries its exact
        // inode/digest value.  The current owner has no carrier primitive
        // capable of supplying either value, so it never calls this door.
        def nmdt-open-artifact-identity-id(id) = id ++ ".identity";
        def nmdt-open-artifact-identity-kind(strength) = (String) strength == "inode" ? "artifact-open-inode" : (String) strength == "content-digest" ? "artifact-open-content-digest" : "artifact-open-identity-invalid";
        def nmdt-open-artifact-identity-strength(sample) = (String) fgtm-sample-kind(sample) == "artifact-open-inode" ? "inode" : (String) fgtm-sample-kind(sample) == "artifact-open-content-digest" ? "content-digest" : "invalid";
        def nmdt-open-artifact-identity-value(sample) = fgtm-sample-purpose(sample);
        def nmdt-open-artifact-identity-sample-at(id, parent, owner, strength, value, handle, openEpoch, source, channels) = (!((Comparable) fgtm-label?(value) == 1)) || ((handle <= 0) || ((!((String) strength == "inode")) && (!((String) strength == "content-digest")))) ? nmdt-owner-missing-sample(nmdt-open-artifact-identity-id(id), "artifact-open-identity", "disk", owner, "memory", "strong-open-time-identity-not-observed", openEpoch, source, channels) : fgtm-sample(nmdt-open-artifact-identity-id(id), fgtm-present(parent), nmdt-open-artifact-identity-kind(strength), "disk", owner, "memory", value, fgtm-absent(), fgtm-absent(), "mapped", fgtm-present(openEpoch), fgtm-absent(), fgtm-absent(), fgtm-present(handle), "pressure-only", "physical-live", source, append(channels, list("node-id-unbound")));
        def nmdt-budget-sample(bytes) = fgtm-sample("budget.models.unified", fgtm-absent(), "budget", "unified", "models", "memory", "pressure-budget", fgtm-absent(), fgtm-present(bytes), "pinned", fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "declared", "model.fleet-policy", list("memory", "model", "health"));
        def nmdt-derived-substate(id, parent, kind, purpose, lifecycle, handle, readEpoch, writeEpoch, channels) = fgtm-sample(id, fgtm-present(parent), kind, "metal", parent, "reasoning", purpose, fgtm-absent(), fgtm-absent(), lifecycle, nmdt-access-epoch(readEpoch), nmdt-access-epoch(writeEpoch), fgtm-absent(), fgtm-present(handle), "pinned", "derived-window", "model.layout", channels);
        def nmdt-token-position(id, parent, position, lifecycle, handle, accessEpoch) = fgtm-sample(id, fgtm-present(parent), "token-position", "metal", parent, "reasoning", "context-position", fgtm-absent(), fgtm-present(position), lifecycle, nmdt-access-epoch(accessEpoch), nmdt-access-epoch(accessEpoch), fgtm-absent(), fgtm-present(handle), "never", "physical-live", "model.context-position", list("memory", "model", "metal", "gpu", "token", "tensor", "layer", "query-lane"));

        // The incarnation is deterministic from the Form-entry epoch.  The
        // publisher repeats it, so PID reuse cannot silently join two owners.
        def nmdt-owner-incarnation(startedEpoch) = "i" ++ int_to_str(startedEpoch);
        def nmdt-owner-publisher(startedEpoch) = "models.dual-resident." ++ nmdt-owner-incarnation(startedEpoch);
        def nmdt-owner-correlation(publisher, pid, startedEpoch, incarnation, sequence, observedEpoch) = list(NMDTOwnerCorrelationSchema(), publisher, pid, startedEpoch, incarnation, sequence, observedEpoch);
        def nmdt-owner-publisher-of(correlation) = correlation[1];
        def nmdt-owner-pid(correlation) = correlation[2];
        def nmdt-owner-started(correlation) = correlation[3];
        def nmdt-owner-incarnation-of(correlation) = correlation[4];
        def nmdt-owner-sequence(correlation) = correlation[5];
        def nmdt-owner-observed(correlation) = correlation[6];
        def nmdt-owner-correlation?(correlation) = nothing?(correlation) ? 0 : !((Comparable) len(correlation) == 7) ? 0 : !((String) head(correlation) == NMDTOwnerCorrelationSchema()) ? 0 : !((Comparable) fgtm-label?(nmdt-owner-publisher-of(correlation)) == 1) ? 0 : nmdt-owner-pid(correlation) <= 0 ? 0 : nmdt-owner-started(correlation) < 0 ? 0 : !((String) nmdt-owner-incarnation-of(correlation) == nmdt-owner-incarnation(nmdt-owner-started(correlation))) ? 0 : !((String) nmdt-owner-publisher-of(correlation) == nmdt-owner-publisher(nmdt-owner-started(correlation))) ? 0 : nmdt-owner-sequence(correlation) < 0 ? 0 : nmdt-owner-observed(correlation) < nmdt-owner-started(correlation) ? 0 : 1;
        // Stable for this incarnation: cadence must not mint a new identifier
        // and interned string on every quarter-second snapshot.
        def nmdt-owner-heartbeat-id-from-incarnation(incarnation) = "heartbeat." ++ incarnation;
        def nmdt-owner-heartbeat-id(correlation) = nmdt-owner-heartbeat-id-from-incarnation(nmdt-owner-incarnation-of(correlation));
        // Capacity carries the owner's monotonic publication sequence.  It was
        // previously thrown away, which prevented a consumer from rebuilding
        // exact publisher provenance from the wire snapshot alone.
        def nmdt-owner-heartbeat-sample-at(correlation, heartbeatId) = !((Comparable) nmdt-owner-correlation?(correlation) == 1) ? list("native-model-owner-heartbeat-invalid-v1") : !((Comparable) fgtm-label?(heartbeatId) == 1) ? list("native-model-owner-heartbeat-invalid-v1") : fgtm-sample(heartbeatId, fgtm-absent(), "owner-heartbeat", "form", nmdt-owner-publisher-of(correlation), "model-owner", "dual-model-owner", fgtm-absent(), fgtm-present(nmdt-owner-sequence(correlation)), "active", fgtm-present(nmdt-owner-observed(correlation)), fgtm-present(nmdt-owner-started(correlation)), fgtm-absent(), fgtm-present(nmdt-owner-pid(correlation)), "never", "physical-live", "model.owner", list("process", "model", "health", "membrane"));
        def nmdt-owner-heartbeat-sample(correlation) = nmdt-owner-heartbeat-sample-at(correlation, nmdt-owner-heartbeat-id(correlation));

        // Each state-bit row retains the epoch when that bit last changed.
        // Heartbeats and unrelated bit transitions do not renew it.
        def nmdt-model-state-lifecycle(enabled) = (Comparable) enabled == 1 ? "active" : "idle";
        def nmdt-model-state-sample-owned(id, parent, owner, state, enabled, handle, observedEpoch) = fgtm-sample(id, fgtm-present(parent), "model-state", "metal", owner, "reasoning", state, fgtm-absent(), fgtm-absent(), nmdt-model-state-lifecycle(enabled), fgtm-present(observedEpoch), fgtm-present(observedEpoch), fgtm-absent(), fgtm-present(handle), "never", "physical-live", "model.session", list("memory", "model", "metal", "gpu", "health", "query-lane", "node-id-unbound"));
        def nmdt-model-state-sample(id, parent, state, enabled, handle, observedEpoch) = nmdt-model-state-sample-owned(id, parent, parent, state, enabled, handle, observedEpoch);
        def nmdt-release-tombstone(id, closeResult, writeEpoch) = fgtm-sample(id, fgtm-absent(), "model", "metal", id, "reasoning", "callable-model-context", fgtm-absent(), fgtm-absent(), (Comparable) closeResult == 1 ? "released" : "failed", fgtm-absent(), nmdt-access-epoch(writeEpoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", "model.carrier-handle", list("memory", "model", "metal", "gpu", "query-lane", "node-id-unbound"));
    }
    0;
}
