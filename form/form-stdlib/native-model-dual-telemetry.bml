//////////////////////////////////////////////////////////////////////
//
// native-model-dual-telemetry.bml — executable truth-separated rows.
//
// Authority: form-stdlib/bml/native-model-dual-telemetry.bml
// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/native-model-tensor-ledger.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelDualTelemetryAuthority {
        field NMDTAuthorityPath = "form/form-stdlib/bml/native-model-dual-telemetry.bml";
        field NMDTAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelDualTelemetry {
        field NMDTOwnerCorrelationSchema = "native-model-owner-correlation-v1";
        ref nmdt-authority = NativeModelDualTelemetryAuthority;
        thought nmdt-law = list("publication-is-not-access", "semantic-access-epochs-survive-heartbeats", "substate-is-derived", "callable-is-not-resident-pages", "mapped-materialized-and-catalog-are-separate", "owner-runtime-counters-include-observation-cost", "owner-lifetime-is-correlated", "stable-sample-identities", "unbound-nodeid-has-an-exact-door", "idle-cadence-waits-for-timed-ingress", "close-leaves-tombstone");

        def nmdt-access-epoch(epoch) = if lt(epoch, 0) then fgtm-absent() else fgtm-present(epoch);
        def nmdt-state-clock(loadedEpoch, prefilledEpoch, activeEpoch) = list(loadedEpoch, prefilledEpoch, activeEpoch);
        def nmdt-state-loaded-epoch(clock) = nth(clock, 0);
        def nmdt-state-prefilled-epoch(clock) = nth(clock, 1);
        def nmdt-state-active-epoch(clock) = nth(clock, 2);
        def nmdt-state-active-at(clock, epoch) = nmdt-state-clock(nmdt-state-loaded-epoch(clock), nmdt-state-prefilled-epoch(clock), epoch);
        def nmdt-callable-sample(id, owner, lifecycle, handle, readEpoch, writeEpoch) = fgtm-sample(id, fgtm-absent(), "model", "metal", owner, "reasoning", "callable-model-context", fgtm-absent(), fgtm-absent(), lifecycle, nmdt-access-epoch(readEpoch), nmdt-access-epoch(writeEpoch), fgtm-absent(), fgtm-present(handle), "inactive-only", "physical-live", "model.carrier-handle", list("memory", "model", "metal", "gpu", "query-lane", "node-id-unbound"));
        // Compatibility for fixture callers.  This now reports only a callable
        // context; the handle never upgrades it to resident-page evidence.
        def nmdt-resident-sample(id, lifecycle, handle, readEpoch, writeEpoch) = nmdt-callable-sample(id, id, lifecycle, handle, readEpoch, writeEpoch);
        def nmdt-missing-extent-sample(id, parent, owner, kind, purpose, observedEpoch, door) = fgtm-sample(id, fgtm-present(parent), kind, "unified", owner, "memory", purpose, fgtm-absent(), fgtm-absent(), "unknown", nmdt-access-epoch(observedEpoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "inactive-only", "declared", door, list("memory", "model", "health", "node-id-unbound"));
        def nmdt-owner-counter-sample(id, kind, plane, owner, lane, purpose, value, observedEpoch, source, channels) = fgtm-sample(id, fgtm-absent(), kind, plane, owner, lane, purpose, fgtm-absent(), fgtm-present(value), "active", nmdt-access-epoch(observedEpoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "physical-live", source, append(channels, list("node-id-unbound")));
        def nmdt-owner-missing-sample(id, kind, plane, owner, lane, purpose, observedEpoch, door, channels) = fgtm-sample(id, fgtm-absent(), kind, plane, owner, lane, purpose, fgtm-absent(), fgtm-absent(), "unknown", nmdt-access-epoch(observedEpoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "declared", door, append(channels, list("node-id-unbound")));
        def nmdt-owner-nodeid-seam(owner, observedEpoch) = nmdt-owner-missing-sample("nodeid.owner.telemetry", "node-id-binding", "form", owner, "model-owner", "snapshot-row-nodeid-binding", observedEpoch, "model.owner.telemetry-nodeid-mint", list("process", "model", "health"));
        // The telemetry membrane's plane vocabulary is deliberately small.
        // A file-backed no-copy tensor view is a disk extent; an allocated
        // Metal buffer is unified memory.  More descriptive phrases belong in
        // kind/purpose, never in an invalid plane that makes publication fail.
        def nmdt-tensor-group-plane(group) = if str_eq(nmtl-group-kind(group), "mapped-tensors") then "disk" else "unified";
        def nmdt-tensor-group-sample(group) = if eq(nmtl-group-valid?(group), 1) then fgtm-sample(nmtl-group-id(group), fgtm-present(nmtl-group-parent(group)), nmtl-group-kind(group), nmdt-tensor-group-plane(group), nmtl-group-owner(group), "memory", nmtl-group-kind(group), fgtm-present(nmtl-group-bytes(group)), fgtm-present(nmtl-group-handles(group)), "resident", fgtm-present(nmtl-group-observed(group)), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", "physical-live", nmtl-group-source(group), append(nmtl-group-channels(group), list("node-id-unbound"))) else nmdt-owner-missing-sample(nmtl-group-id(group), nmtl-group-kind(group), nmdt-tensor-group-plane(group), nmtl-group-owner(group), "memory", "handle-byte-reconciliation-failed", nmtl-group-observed(group), "model.tensor-allocation-reconciliation", nmtl-group-channels(group));
        def nmdt-tensor-group-samples(groups) = if eq(len(groups), 0) then list() else cons(nmdt-tensor-group-sample(head(groups)), nmdt-tensor-group-samples(tail(groups)));
        def nmdt-tensor-reconcile-sample(id, owner, expected, observed, epoch, source, channels) = fgtm-sample(id, fgtm-absent(), "tensor-reconciliation", "unified", owner, "memory", if eq(expected, observed) then "reconciled" else "count-mismatch", fgtm-absent(), fgtm-present(sub(observed, expected)), if eq(expected, observed) then "ready" else "failed", fgtm-present(epoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "physical-live", source, append(channels, list("node-id-unbound")));
        def nmdt-tensor-ledger-total-sample(groups, owner, epoch) = fgtm-sample("tensor.owner.ledger", fgtm-absent(), "tensor-ledger", "unified", owner, "memory", "mapped-view-plus-allocated-byte-extents", fgtm-present(nmtl-groups-bytes(groups)), fgtm-present(nmtl-groups-handles(groups)), "resident", fgtm-present(epoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", "physical-live", "native-model-tensor-ledger", list("process", "model", "memory", "tensor", "metal", "gpu", "health", "node-id-unbound"));
        def nmdt-tensor-reconcile-samples(groups, status, owner, epoch) {
            let expectedAll = nmtl-groups-handles(groups);
            let expectedMapped = nmtl-groups-kind-handles(groups, "mapped-tensors");
            let observedAll = nmdt-status-int(status, "buffers");
            let observedMapped = nmdt-status-int(status, "mmap_nocopy_buffers");
            list(
                nmdt-tensor-ledger-total-sample(groups, owner, epoch),
                nmdt-tensor-reconcile-sample("tensor.owner.buffer-count-delta", owner, expectedAll, observedAll, epoch, "native-model-tensor-ledger+metal_status.buffers", list("process", "model", "memory", "tensor", "metal", "gpu", "health")),
                nmdt-tensor-reconcile-sample("tensor.owner.mapped-count-delta", owner, expectedMapped, observedMapped, epoch, "native-model-tensor-ledger+metal_status.mmap_nocopy_buffers", list("process", "model", "memory", "tensor", "metal", "gpu", "health")));
        }
        def nmdt-status-start(status, key) {
            let first = str_concat(key, "=");
            let later = str_concat("\n", first);
            let atFirst = str_find(status, first, 0);
            let atLater = str_find(status, later, 0);
            if eq(atFirst, 0) then str_len(first) else if lt(atLater, 0) then -1 else add(atLater, str_len(later));
        }
        def nmdt-status-text-from(status, start) {
            let stop = str_find(status, "\n", start);
            if lt(stop, 0) then substring(status, start, str_len(status)) else substring(status, start, stop);
        }
        def nmdt-status-int-found(status, start) {
            let value = nmdt-status-text-from(status, start);
            if eq(fgtm-uint-text?(value), 1) then str_to_int(value) else -1;
        }
        def nmdt-status-int(status, key) {
            let start = nmdt-status-start(status, key);
            if lt(start, 0) then -1 else nmdt-status-int-found(status, start);
        }
        def nmdt-metal-counter(status, id, kind, lane, purpose, key, source, owner, epoch, channels) {
            let value = nmdt-status-int(status, key);
            if lt(value, 0) then nmdt-owner-missing-sample(id, kind, "metal", owner, lane, purpose, epoch, source, channels) else nmdt-owner-counter-sample(id, kind, "metal", owner, lane, purpose, value, epoch, source, channels);
        }
        def nmdt-weight-catalog(id, parent, bytes, readEpoch) = fgtm-sample(id, fgtm-present(parent), "weights", "disk", parent, "reasoning", "model-weights", fgtm-present(bytes), fgtm-absent(), "unknown", nmdt-access-epoch(readEpoch), fgtm-absent(), fgtm-absent(), fgtm-absent(), "pressure-only", "catalog", "gguf.catalog", list("memory", "model", "cache"));
        def nmdt-budget-sample(bytes) = fgtm-sample("budget.models.unified", fgtm-absent(), "budget", "unified", "models", "memory", "pressure-budget", fgtm-absent(), fgtm-present(bytes), "pinned", fgtm-absent(), fgtm-absent(), fgtm-absent(), fgtm-absent(), "never", "declared", "model.fleet-policy", list("memory", "model", "health"));
        def nmdt-derived-substate(id, parent, kind, purpose, lifecycle, handle, readEpoch, writeEpoch, channels) = fgtm-sample(id, fgtm-present(parent), kind, "metal", parent, "reasoning", purpose, fgtm-absent(), fgtm-absent(), lifecycle, nmdt-access-epoch(readEpoch), nmdt-access-epoch(writeEpoch), fgtm-absent(), fgtm-present(handle), "pinned", "derived-window", "model.layout", channels);
        def nmdt-token-position(id, parent, position, lifecycle, handle, accessEpoch) = fgtm-sample(id, fgtm-present(parent), "token-position", "metal", parent, "reasoning", "context-position", fgtm-absent(), fgtm-present(position), lifecycle, nmdt-access-epoch(accessEpoch), nmdt-access-epoch(accessEpoch), fgtm-absent(), fgtm-present(handle), "never", "physical-live", "model.context-position", list("memory", "model", "metal", "gpu", "token", "tensor", "layer", "query-lane"));

        // The incarnation is deterministic from the Form-entry epoch.  The
        // publisher repeats it, so PID reuse cannot silently join two owners.
        def nmdt-owner-incarnation(startedEpoch) = str_concat("i", int_to_str(startedEpoch));
        def nmdt-owner-publisher(startedEpoch) = str_concat("models.dual-resident.", nmdt-owner-incarnation(startedEpoch));
        def nmdt-owner-correlation(publisher, pid, startedEpoch, incarnation, sequence, observedEpoch) = list(NMDTOwnerCorrelationSchema(), publisher, pid, startedEpoch, incarnation, sequence, observedEpoch);
        def nmdt-owner-publisher-of(correlation) = nth(correlation, 1);
        def nmdt-owner-pid(correlation) = nth(correlation, 2);
        def nmdt-owner-started(correlation) = nth(correlation, 3);
        def nmdt-owner-incarnation-of(correlation) = nth(correlation, 4);
        def nmdt-owner-sequence(correlation) = nth(correlation, 5);
        def nmdt-owner-observed(correlation) = nth(correlation, 6);
        def nmdt-owner-correlation?(correlation) = if nothing?(correlation) then 0 else if not(eq(len(correlation), 7)) then 0 else if not(str_eq(head(correlation), NMDTOwnerCorrelationSchema())) then 0 else if not(eq(fgtm-label?(nmdt-owner-publisher-of(correlation)), 1)) then 0 else if le(nmdt-owner-pid(correlation), 0) then 0 else if lt(nmdt-owner-started(correlation), 0) then 0 else if not(str_eq(nmdt-owner-incarnation-of(correlation), nmdt-owner-incarnation(nmdt-owner-started(correlation)))) then 0 else if not(str_eq(nmdt-owner-publisher-of(correlation), nmdt-owner-publisher(nmdt-owner-started(correlation)))) then 0 else if lt(nmdt-owner-sequence(correlation), 0) then 0 else if lt(nmdt-owner-observed(correlation), nmdt-owner-started(correlation)) then 0 else 1;
        // Stable for this incarnation: cadence must not mint a new identifier
        // and interned string on every quarter-second snapshot.
        def nmdt-owner-heartbeat-id-from-incarnation(incarnation) = str_concat("heartbeat.", incarnation);
        def nmdt-owner-heartbeat-id(correlation) = nmdt-owner-heartbeat-id-from-incarnation(nmdt-owner-incarnation-of(correlation));
        // Capacity carries the owner's monotonic publication sequence.  It was
        // previously thrown away, which prevented a consumer from rebuilding
        // exact publisher provenance from the wire snapshot alone.
        def nmdt-owner-heartbeat-sample-at(correlation, heartbeatId) = if not(eq(nmdt-owner-correlation?(correlation), 1)) then list("native-model-owner-heartbeat-invalid-v1") else if not(eq(fgtm-label?(heartbeatId), 1)) then list("native-model-owner-heartbeat-invalid-v1") else fgtm-sample(heartbeatId, fgtm-absent(), "owner-heartbeat", "form", nmdt-owner-publisher-of(correlation), "model-owner", "dual-model-owner", fgtm-absent(), fgtm-present(nmdt-owner-sequence(correlation)), "active", fgtm-present(nmdt-owner-observed(correlation)), fgtm-present(nmdt-owner-started(correlation)), fgtm-absent(), fgtm-present(nmdt-owner-pid(correlation)), "never", "physical-live", "model.owner", list("process", "model", "health", "membrane"));
        def nmdt-owner-heartbeat-sample(correlation) = nmdt-owner-heartbeat-sample-at(correlation, nmdt-owner-heartbeat-id(correlation));

        // Each state-bit row retains the epoch when that bit last changed.
        // Heartbeats and unrelated bit transitions do not renew it.
        def nmdt-model-state-lifecycle(enabled) = if eq(enabled, 1) then "active" else "idle";
        def nmdt-model-state-sample-owned(id, parent, owner, state, enabled, handle, observedEpoch) = fgtm-sample(id, fgtm-present(parent), "model-state", "metal", owner, "reasoning", state, fgtm-absent(), fgtm-absent(), nmdt-model-state-lifecycle(enabled), fgtm-present(observedEpoch), fgtm-present(observedEpoch), fgtm-absent(), fgtm-present(handle), "never", "physical-live", "model.session", list("memory", "model", "metal", "gpu", "health", "query-lane", "node-id-unbound"));
        def nmdt-model-state-sample(id, parent, state, enabled, handle, observedEpoch) = nmdt-model-state-sample-owned(id, parent, parent, state, enabled, handle, observedEpoch);
        def nmdt-release-tombstone(id, closeResult, writeEpoch) = fgtm-sample(id, fgtm-absent(), "model", "metal", id, "reasoning", "callable-model-context", fgtm-absent(), fgtm-absent(), if eq(closeResult, 1) then "released" else "failed", fgtm-absent(), nmdt-access-epoch(writeEpoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", "model.carrier-handle", list("memory", "model", "metal", "gpu", "query-lane", "node-id-unbound"));
    }
    0;
}
