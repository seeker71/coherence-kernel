// form-cli-recipe-exec-cursor.fk — a bounded raw-byte cursor joining a
// decoded local-model stream to the Form recipe-execution token protocol.
//
// THE HONEST SEAM. This cell does not run a model, Metal, MLX, CPU emission,
// or a recipe. It receives already-decoded byte chunks. Once one complete,
// strict `<|form:recipe-exec|>` frame exists, it reuses `frex-parse` to recover
// the content-addressed request and offers that request exactly once through a
// generic `(executor ctx request)` function. A valid `frex-result` is rendered
// as one typed `<|form:recipe-observation|>` span for a caller to encode and
// prefill. The callback is the future carrier boundary; it is only scripted
// pure data in this cell's witness band.
//
// STREAMING IS THE MECHANISM. There is no tokenizer pre-step, flattened form,
// operations table, compiler subprocess, or jump table. Before an open mark,
// the cursor holds only the suffix long enough to recognize a mark split across
// chunks. After the mark, it holds from that mark through a bounded frame. An
// over-budget frame is named `over`, cleared, and never offered.
//
// TWO BYTE LANES. Every feed returns `(cursor model-bytes injected-bytes)`.
// `model-bytes` is exactly the chunk the model emitted, including control
// syntax. `injected-bytes` is only a validated typed observation and is never
// appended to model output. The cursor retains bounded counters and the last
// bounded injected span, not an unbounded transcript. A live owner can stream
// the two deltas to its output and prefill sinks without confusing authorship.
//
// DISTINCT SIGNALS. none, held, complete, and over are scan states. A typed
// result keeps status nothing/value/failure/timeout, value-present, and value
// separately, so integer 0 and integer 1 cannot collapse into absence. The
// callback's content-addressed trace carries choice, nothing, failure, timeout,
// cut, undo, refine, crystallize, dissolve, and release. Cursor-side refusal
// and held-frame timeout create the corresponding bounded lifecycle trace too.
//
// SINGLE OFFER. This cursor owns one execution-token crossing. Once a complete
// frame, refusal, over-budget frame, or held timeout terminates it, later model
// bytes still pass through the model lane but cannot call the executor again.
// A caller opens a fresh cursor for another crossing.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
// preludes: form-stdlib/form-recipe-exec-token.fk
//
section [form.bml] {
    // ── bounded byte recognition ─────────────────────────────────────
    def frxc-state-none() = "none";
    def frxc-state-held() = "held";
    def frxc-state-complete() = "complete";
    def frxc-state-over() = "over";
    def frxc-detect-cap() = str_len(frex-open()) - 1;
    def frxc-hold-cap() = frex-max-frame-bytes();
    def frxc-injection-cap() = frex-max-render-bytes();
    def frxc-max-offers() = 1;
    def frxc-clip-left(text, cap) = str_len(text) <= cap ? text : substring(text, str_len(text) - cap, str_len(text));
    // Before a mark, retain only a possible split prefix. Once found, retain
    // from it so the opener cannot fall out of the held window.
    def frxc-feed-window(window, chunk) = {
        let joined = str_concat(window, chunk);
        let at = str_find(joined, frex-open(), 0);
        at < 0 ? frxc-clip-left(joined, frxc-detect-cap()) : substring(joined, at, str_len(joined));
    };
    def frxc-close-at(window, open-at) = str_find(window, frex-close(), open-at + str_len(frex-open()));
    // Complete is decided by the extracted frame length, not by trailing model
    // prose in the same chunk. The frame alone crosses the parser.
    def frxc-scan(window) = {
        let open-at = str_find(window, frex-open(), 0);
        open-at < 0 ? frxc-state-none() : {
            let close-at = frxc-close-at(window, open-at);
            close-at >= 0 ? close-at + str_len(frex-close()) - open-at > frxc-hold-cap() ? frxc-state-over() : frxc-state-complete() : str_len(window) > frxc-hold-cap() ? frxc-state-over() : frxc-state-held();
        };
    };
    def frxc-frame(window) = {
        let open-at = str_find(window, frex-open(), 0);
        open-at < 0 ? "" : {
            let close-at = frxc-close-at(window, open-at);
            close-at < 0 ? "" : substring(window, open-at, close-at + str_len(frex-close()));
        };
    };
    // ── cursor and transfer shapes ───────────────────────────────────
    // cursor = (window scan terminal offered refused injections
    //           injected-byte-count model-byte-count model-chunk-count
    //           request result trace status reason carrier value present
    //           observation)
    //
    // `observation` is bounded by frxc-injection-cap. Model bytes are returned
    // as deltas and represented here only by counts.
    def frxc-cursor(window, scan, terminal, offered, refused, injections, injected-bytes, model-bytes, model-chunks, request, result, trace, status, reason, carrier, value, present, observation) = list(window, scan, terminal, offered, refused, injections, injected-bytes, model-bytes, model-chunks, request, result, trace, status, reason, carrier, value, present, observation);
    def frxc-window(c) = nth(c, 0);
    def frxc-scan-state(c) = nth(c, 1);
    def frxc-terminal(c) = nth(c, 2);
    def frxc-offered(c) = nth(c, 3);
    def frxc-refused(c) = nth(c, 4);
    def frxc-injections(c) = nth(c, 5);
    def frxc-injected-bytes(c) = nth(c, 6);
    def frxc-model-bytes(c) = nth(c, 7);
    def frxc-model-chunks(c) = nth(c, 8);
    def frxc-request(c) = nth(c, 9);
    def frxc-result(c) = nth(c, 10);
    def frxc-trace(c) = nth(c, 11);
    def frxc-status(c) = nth(c, 12);
    def frxc-reason(c) = nth(c, 13);
    def frxc-carrier(c) = nth(c, 14);
    def frxc-value(c) = nth(c, 15);
    def frxc-value-present?(c) = nth(c, 16);
    def frxc-observation(c) = nth(c, 17);
    // Pure join values for a resident model session. The request surface is
    // reconstructed from the strict parsed request, so it is canonical and
    // contains no surrounding model prose. The prefill value exists only after
    // the once-only injection was accepted.
    def frxc-completed-request-surface(c) = (Comparable) frex-request-ready?(frxc-request(c)) == 1 ? frex-surface(frex-request-recipe(frxc-request(c)), frex-request-input(frxc-request(c)), frex-request-carrier(frxc-request(c))) : "";
    def frxc-prefill-observation(c) = (Comparable) frxc-injections(c) == 1 ? frxc-observation(c) : "";
    def frxc-callback-calls(c) = frxc-offered(c);
    // raw-byte ledger = (model-bytes model-chunks injected-bytes injections
    //                    callback-calls held-bytes scan-state)
    def frxc-byte-ledger(c) = list(frxc-model-bytes(c), frxc-model-chunks(c), frxc-injected-bytes(c), frxc-injections(c), frxc-callback-calls(c), str_len(frxc-window(c)), frxc-scan-state(c));
    def frxc-ledger-model-bytes(l) = nth(l, 0);
    def frxc-ledger-model-chunks(l) = nth(l, 1);
    def frxc-ledger-injected-bytes(l) = nth(l, 2);
    def frxc-ledger-injections(l) = nth(l, 3);
    def frxc-ledger-callback-calls(l) = nth(l, 4);
    def frxc-ledger-held-bytes(l) = nth(l, 5);
    def frxc-ledger-scan-state(l) = nth(l, 6);
    def frxc-open?(c) = (String) frxc-terminal(c) == "open" ? 1 : 0;
    def frxc-model-executed?(c) = 0;
    def frxc-callback-observed-executed?(c) = nothing?(frxc-result(c)) ? 0 : frex-result-executed?(frxc-result(c));
    def frxc-callback-observed-code-generated?(c) = nothing?(frxc-result(c)) ? 0 : frex-result-native-code-generated?(frxc-result(c));
    def frxc-fresh() = frxc-cursor("", frxc-state-none(), "open", 0, 0, 0, 0, 0, 0, frex-nothing-request("unoffered"), nothing(), empty(), "nothing", "waiting", "", 0, 0, "");
    // transfer = (cursor exact-model-delta exact-injection-delta)
    def frxc-transfer(cursor, model-delta, injection-delta) = list(cursor, model-delta, injection-delta);
    def frxc-transfer-cursor(x) = nth(x, 0);
    def frxc-transfer-model(x) = nth(x, 1);
    def frxc-transfer-injected(x) = nth(x, 2);
    def frxc-streamed(c, window, scan, chunk) = frxc-cursor(window, scan, frxc-terminal(c), frxc-offered(c), frxc-refused(c), frxc-injections(c), frxc-injected-bytes(c), frxc-model-bytes(c) + str_len(chunk), frxc-model-chunks(c) + 1, frxc-request(c), frxc-result(c), frxc-trace(c), frxc-status(c), frxc-reason(c), frxc-carrier(c), frxc-value(c), frxc-value-present?(c), frxc-observation(c));
    // ── typed result validation ──────────────────────────────────────
    def frxc-result-status?(status) = (String) status == "nothing" || ((String) status == "value" || ((String) status == "failure" || (String) status == "timeout")) ? 1 : 0;
    def frxc-result-valid?(request, result) = nothing?(result) ? 0 : !((Comparable) len(result) == 13) ? 0 : !((Comparable) frxc-result-status?(frex-result-status(result)) == 1) ? 0 : !node_eq(frex-result-request(result), frex-request-token(request)) ? 0 : !node_eq(frex-result-recipe(result), frex-request-recipe(request)) ? 0 : !((Comparable) frex-result-value-present?(result) == ((String) frex-result-status(result) == "value" ? 1 : 0)) ? 0 : !((Comparable) frex-result-executed?(result) == 0 || (Comparable) frex-result-executed?(result) == 1) ? 0 : !((Comparable) frex-result-model-executed?(result) == 0) ? 0 : !((Comparable) frex-result-native-code-generated?(result) == 0 || (Comparable) frex-result-native-code-generated?(result) == 1) ? 0 : frex-result-attempts(result) < 0 || frex-result-attempts(result) > frex-max-attempts() ? 0 : node_eq(frex-result-observation(result), frex-observation-token-with-flags(frex-result-status(result), frex-result-reason(result), request, frex-result-carrier(result), frex-result-value(result), frex-result-value-present?(result), frex-result-trace(result), frex-result-executed?(result), frex-result-model-executed?(result), frex-result-native-code-generated?(result)));
    // Only one exact outer observation may enter. Callback-controlled reasons
    // cannot smuggle another recipe request or prematurely close the span.
    def frxc-observation-valid?(text) = {
        let n = str_len(text);
        let open-n = str_len(frex-observation-open());
        let close-n = str_len(frex-observation-close());
        let expected-close = n - close-n;
        let close-at = str_find(text, frex-observation-close(), open-n);
        let nested-observation = str_find(text, frex-observation-open(), open-n);
        (Comparable) n == 0 || n > frxc-injection-cap() ? 0 : !((Comparable) str_find(text, frex-observation-open(), 0) == 0) ? 0 : !((Comparable) close-at == expected-close) ? 0 : nested-observation >= 0 ? 0 : str_find(text, frex-open(), open-n) >= 0 ? 0 : str_find(text, frex-close(), open-n) >= 0 ? 0 : 1;
    };
    // ── lifecycle traces for cursor-side outcomes ────────────────────
    def frxc-add-event(trace, request, action, signal, attempt) = append(trace, list(frex-event(request, action, "cursor", signal, attempt)));
    def frxc-refusal-trace(request, reason) = {
        let a = frxc-add-event(empty(), request, "failure", reason, 0);
        let b = frxc-add-event(a, request, "undo", reason, 0);
        let d = frxc-add-event(b, request, "refine", "next-cursor", 0);
        let e = frxc-add-event(d, request, "cut", reason, 0);
        frxc-add-event(e, request, "release", "cursor-context", 0);
    };
    def frxc-timeout-trace(request, reason) = {
        let a = frxc-add-event(empty(), request, "timeout", reason, 0);
        let b = frxc-add-event(a, request, "cut", reason, 0);
        let d = frxc-add-event(b, request, "undo", reason, 0);
        let e = frxc-add-event(d, request, "refine", "next-cursor", 0);
        frxc-add-event(e, request, "release", "cursor-context", 0);
    };
    def frxc-terminal-state(c, scan, terminal, request, result, trace, status, reason, carrier, value, present, observation, offered-add, refused-add, injection-add) = frxc-cursor("", scan, terminal, frxc-offered(c) + offered-add, frxc-refused(c) + refused-add, frxc-injections(c) + injection-add, frxc-injected-bytes(c) + str_len(observation), frxc-model-bytes(c), frxc-model-chunks(c), request, result, trace, status, reason, carrier, value, present, observation);
    def frxc-refuse(c, scan, reason) = {
        let request = frex-nothing-request(reason);
        frxc-terminal-state(c, scan, "refused", request, nothing(), frxc-refusal-trace(request, reason), "failure", reason, "cursor", 0, 0, "", 0, 1, 0);
    };
    def frxc-over(c) = {
        let request = frex-nothing-request("frame-budget-exceeded");
        frxc-terminal-state(c, frxc-state-over(), "over", request, nothing(), frxc-refusal-trace(request, "frame-budget-exceeded"), "failure", "frame-budget-exceeded", "cursor", 0, 0, "", 0, 1, 0);
    };
    // ── one complete request crossing ────────────────────────────────
    def frxc-accept-result(c, request, result, observation) = frxc-terminal-state(c, frxc-state-complete(), "complete", request, result, frex-result-trace(result), frex-result-status(result), frex-result-reason(result), frex-result-carrier(result), frex-result-value(result), frex-result-value-present?(result), observation, 1, 0, 1);
    def frxc-offer-once(ctx, executor, c, frame) = {
        let request = frex-parse(frame);
        !((Comparable) frex-request-ready?(request) == 1) ? frxc-refuse(c, frxc-state-complete(), frex-request-reason(request)) : {
            let result = executor(ctx, request);
            !((Comparable) frxc-result-valid?(request, result) == 1) ? frxc-terminal-state(c, frxc-state-complete(), "refused", request, result, frxc-refusal-trace(request, "executor-result-invalid"), "failure", "executor-result-invalid", "cursor", 0, 0, "", 1, 1, 0) : {
                let observation = frex-render(result);
                !((Comparable) frxc-observation-valid?(observation) == 1) ? frxc-terminal-state(c, frxc-state-complete(), "refused", request, result, frxc-refusal-trace(request, "executor-observation-refused"), "failure", "executor-observation-refused", "cursor", 0, 0, "", 1, 1, 0) : frxc-accept-result(c, request, result, observation);
            };
        };
    };
    // Feed one arbitrary decoded byte chunk. The exact chunk returns on the
    // model lane even after this one-off cursor has terminated.
    def frxc-feed(ctx, executor, cursor, chunk) = !((Comparable) frxc-open?(cursor) == 1) ? frxc-transfer(frxc-streamed(cursor, frxc-window(cursor), frxc-scan-state(cursor), chunk), chunk, "") : {
        let window = frxc-feed-window(frxc-window(cursor), chunk);
        let scan = frxc-scan(window);
        let streamed = frxc-streamed(cursor, window, scan, chunk);
        (String) scan == frxc-state-complete() ? {
            let completed = frxc-offer-once(ctx, executor, streamed, frxc-frame(window));
            frxc-transfer(completed, chunk, frxc-observation(completed));
        } : (String) scan == frxc-state-over() ? frxc-transfer(frxc-over(streamed), chunk, "") : frxc-transfer(streamed, chunk, "");
    };
    // The owner names timeout only while a frame is genuinely held. No callback
    // runs and no fabricated carrier observation enters.
    def frxc-timeout(cursor) = (Comparable) frxc-open?(cursor) == 1 && (String) frxc-scan-state(cursor) == frxc-state-held() ? {
        let request = frex-nothing-request("held-frame-timeout");
        frxc-transfer(frxc-terminal-state(cursor, frxc-state-held(), "timeout", request, nothing(), frxc-timeout-trace(request, "held-frame-timeout"), "timeout", "held-frame-timeout", "cursor", 0, 0, "", 0, 0, 0), "", "");
    } : frxc-transfer(cursor, "", "");
    0;
}
