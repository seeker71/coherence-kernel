; living-world-profile-outcome.fk -- native answers reopen their own ground.
;
; Participants may address one exact current profile answer with an observed
; cell and any four-arm acknowledgment.  ONE confirms the shared output, ZERO
; may carry a different observed value as correction, NOTHING remains silence,
; and NODE retains alternatives or unresolved plurality.  Optional lens
; declaration, alternatives, unknown, timeout, observed time, and evidence are
; independent cells.  An expired default is retained but never becomes probe
; evidence.
;
; Every current outcome is classified into one plural cycle.  All answer and
; outcome witnesses govern its proposal.  An admitted cycle only describes
; exact probe successors.  Those probes must be independently re-offered and
; admitted through the existing hypothesis-placement membrane before a tissue
; can change.  No outcome edits a class, chooses a hypothesis, installs a
; correction, promotes a surface, or grants outward authority.
;
; The current executable Recipe bridge observes integer values.  Non-integer
; cells remain valid outcome evidence but produce no executable probe until a
; separately offered codec can carry them.
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-enquiry-profile.fk form-stdlib/living-world-enquiry-profile-voice.fk

(let LWPO-OUTCOME      (bp "LWPO-OUTCOME"))
(let LWPO-EVIDENCE     (bp "LWPO-EVIDENCE"))
(let LWPO-EVIDENCE-SET (bp "LWPO-EVIDENCE-SET"))
(let LWPO-CYCLE        (bp "LWPO-CYCLE"))
(let LWPO-DERIVATION   (bp "LWPO-DERIVATION"))
(let LWPO-UNOBSERVED   (bp "LWPO-UNOBSERVED"))
(let LWPO-CONFIRMED    (bp "LWPO-CONFIRMED"))
(let LWPO-CONTESTED    (bp "LWPO-CONTESTED"))
(let LWPO-CORRECTION   (bp "LWPO-CORRECTION"))
(let LWPO-SILENCE      (bp "LWPO-SILENCE"))
(let LWPO-ALTERNATIVE  (bp "LWPO-ALTERNATIVE"))
(let LWPO-UNRESOLVED   (bp "LWPO-UNRESOLVED"))
(let LWPO-ORIGIN       (bp "LWPO-ORIGIN"))

(defn lwpo-status (kind) (intern_node kind (empty)))
(defn lwpo-unobserved () (lwpo-status LWPO-UNOBSERVED))
(defn lwpo-confirmed () (lwpo-status LWPO-CONFIRMED))
(defn lwpo-contested () (lwpo-status LWPO-CONTESTED))
(defn lwpo-correction () (lwpo-status LWPO-CORRECTION))
(defn lwpo-silence () (lwpo-status LWPO-SILENCE))
(defn lwpo-alternative () (lwpo-status LWPO-ALTERNATIVE))
(defn lwpo-unresolved () (lwpo-status LWPO-UNRESOLVED))
(defn lwpo-unobserved? (cell) (lwo-category? cell LWPO-UNOBSERVED))
(defn lwpo-confirmed? (cell) (lwo-category? cell LWPO-CONFIRMED))
(defn lwpo-contested? (cell) (lwo-category? cell LWPO-CONTESTED))

; children: exact answer, optional observed cell, immediate ack, optional lens
; declaration, alternatives, optional unknown, optional timeout, observed time,
; evidence, local path
(defn lwpo-outcome
    (answer observed ack declaration alternatives unknown timeout observed-time
     evidence)
    (intern_node LWPO-OUTCOME
        (list answer observed ack declaration alternatives unknown timeout
              observed-time evidence (lwo-local-path))))
(defn lwpo-outcome? (cell) (lwo-category? cell LWPO-OUTCOME))
(defn lwpo-outcome-answer (outcome) (nth (node_children outcome) 0))
(defn lwpo-outcome-observed (outcome) (nth (node_children outcome) 1))
(defn lwpo-outcome-ack (outcome) (nth (node_children outcome) 2))
(defn lwpo-outcome-declaration (outcome) (nth (node_children outcome) 3))
(defn lwpo-outcome-alternatives (outcome) (nth (node_children outcome) 4))
(defn lwpo-outcome-unknown (outcome) (nth (node_children outcome) 5))
(defn lwpo-outcome-timeout (outcome) (nth (node_children outcome) 6))
(defn lwpo-outcome-observed-time (outcome) (nth (node_children outcome) 7))
(defn lwpo-outcome-offered-evidence (outcome) (nth (node_children outcome) 8))
(defn lwpo-outcome-path (outcome) (nth (node_children outcome) 9))

(defn lwpo-optional-declaration-valid? (declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-valid? declaration)))
(defn lwpo-optional-declaration-current? (world declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-current? world declaration)))
(defn lwpo-optional-timeout-valid? (timeout)
    (if (node_eq timeout (lwo-none)) 1
        (oac-timeout-valid? timeout)))
(defn lwpo-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwpo-answer-output (answer)
    (do
        (let immediate (lwepv-answer-immediate answer))
        (if (eq (oac-one? immediate) 1)
            (oac-payload immediate) (lwo-none))))

(defn lwpo-one-coherent? (outcome expected)
    (do
        (let observed (lwpo-outcome-observed outcome))
        (if (and (not (node_eq expected (lwo-none)))
                 (and (node_eq observed expected)
                      (node_eq
                        (oac-payload (lwpo-outcome-ack outcome)) observed)))
            1 0)))
(defn lwpo-zero-coherent? (outcome expected)
    (do
        (let observed (lwpo-outcome-observed outcome))
        (if (and (not (node_eq expected (lwo-none)))
                 (and (not (node_eq observed (lwo-none)))
                      (not (node_eq observed expected)))) 1 0)))
(defn lwpo-alternative-coherent? (outcome)
    (do
        (let alternative (oac-payload (lwpo-outcome-ack outcome)))
        (if (and (node_eq
                    (oac-alternative-reference alternative)
                    (lwpo-outcome-answer outcome))
                 (node_eq
                    (oac-alternative-offered alternative)
                    (lwpo-outcome-observed outcome))) 1 0)))
(defn lwpo-ack-coherent? (outcome)
    (do
        (let ack (lwpo-outcome-ack outcome))
        (let expected (lwpo-answer-output (lwpo-outcome-answer outcome)))
        (if (eq (oac-one? ack) 1)
            (lwpo-one-coherent? outcome expected)
            (if (eq (oac-zero? ack) 1)
                (lwpo-zero-coherent? outcome expected)
                (if (eq (oac-nothing? ack) 1)
                    (if (node_eq
                            (lwpo-outcome-observed outcome) (lwo-none)) 1 0)
                    (if (eq (oac-alternative-ack? ack) 1)
                        (lwpo-alternative-coherent? outcome)
                        (if (node_eq
                                (lwpo-outcome-observed outcome)
                                (lwo-none)) 1 0)))))))

(defn lwpo-outcome-valid? (outcome)
    (if (eq (lwpo-outcome? outcome) 0) 0
        (if (eq (lwepv-answer? (lwpo-outcome-answer outcome)) 0) 0
            (if (eq (oac-valid-ack? (lwpo-outcome-ack outcome)) 0) 0
                (if (eq (lwpo-optional-declaration-valid?
                            (lwpo-outcome-declaration outcome)) 0) 0
                    (if (eq (lwo-category?
                                (lwpo-outcome-alternatives outcome)
                                LWO-FIELD) 0) 0
                        (if (eq (lwpo-optional-unknown-valid?
                                    (lwpo-outcome-unknown outcome)) 0) 0
                            (if (eq (lwpo-optional-timeout-valid?
                                        (lwpo-outcome-timeout outcome)) 0) 0
                                (if (eq (lwepv-int-cell?
                                          (lwpo-outcome-observed-time outcome))
                                        0) 0
                                    (lwpo-ack-coherent? outcome))))))))))

(defn lwpo-outcome-current? (world outcome)
    (if (and (eq (lwpo-outcome-valid? outcome) 1)
             (and (eq (lwo-active? world outcome) 1)
                  (and (eq (lwepv-answer-current? world
                              (lwpo-outcome-answer outcome)) 1)
                       (eq (lwpo-optional-declaration-current? world
                              (lwpo-outcome-declaration outcome)) 1)))) 1 0))

(defn lwpo-time-state (outcome)
    (if (node_eq (lwpo-outcome-timeout outcome) (lwo-none)) (lwo-none)
        (oac-timeout-condense (lwpo-outcome-timeout outcome)
            (lwpo-outcome-observed-time outcome))))
(defn lwpo-effective-ack (outcome)
    (do
        (let immediate (lwpo-outcome-ack outcome))
        (let time-state (lwpo-time-state outcome))
        (if (eq (oac-nothing? immediate) 0) immediate
            (if (eq (oac-time-outcome? time-state) 1)
                (oac-time-outcome-ack time-state) immediate))))

; children: exact outcome, active attribution witnesses, time state, effective
; ack.  The immediate ack remains in the outcome and owns learning semantics.
(defn lwpo-evidence (outcome attributions)
    (intern_node LWPO-EVIDENCE
        (list outcome attributions (lwpo-time-state outcome)
              (lwpo-effective-ack outcome))))
(defn lwpo-evidence-outcome (evidence) (nth (node_children evidence) 0))
(defn lwpo-evidence-attributions (evidence) (nth (node_children evidence) 1))
(defn lwpo-evidence-time-state (evidence) (nth (node_children evidence) 2))
(defn lwpo-evidence-effective-ack (evidence) (nth (node_children evidence) 3))

; children: confirmations, corrections, silences, alternatives, unresolved
(defn lwpo-evidence-set
    (confirmations corrections silences alternatives unresolved)
    (intern_node LWPO-EVIDENCE-SET
        (list confirmations corrections silences alternatives unresolved)))
(defn lwpo-evidence-confirmations (set) (nth (node_children set) 0))
(defn lwpo-evidence-corrections (set) (nth (node_children set) 1))
(defn lwpo-evidence-silences (set) (nth (node_children set) 2))
(defn lwpo-evidence-alternatives (set) (nth (node_children set) 3))
(defn lwpo-evidence-unresolved (set) (nth (node_children set) 4))
(defn lwpo-empty-evidence-set ()
    (lwpo-evidence-set
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field)))

(defn lwpo-classify (evidence set)
    (do
        (let ack
            (lwpo-outcome-ack (lwpo-evidence-outcome evidence)))
        (if (eq (oac-one? ack) 1)
            (lwpo-evidence-set
                (lwo-field-add (lwpo-evidence-confirmations set) evidence)
                (lwpo-evidence-corrections set) (lwpo-evidence-silences set)
                (lwpo-evidence-alternatives set) (lwpo-evidence-unresolved set))
            (if (eq (oac-zero? ack) 1)
                (lwpo-evidence-set
                    (lwpo-evidence-confirmations set)
                    (lwo-field-add (lwpo-evidence-corrections set) evidence)
                    (lwpo-evidence-silences set)
                    (lwpo-evidence-alternatives set)
                    (lwpo-evidence-unresolved set))
                (if (eq (oac-nothing? ack) 1)
                    (lwpo-evidence-set
                        (lwpo-evidence-confirmations set)
                        (lwpo-evidence-corrections set)
                        (lwo-field-add (lwpo-evidence-silences set) evidence)
                        (lwpo-evidence-alternatives set)
                        (lwpo-evidence-unresolved set))
                    (if (eq (oac-alternative-ack? ack) 1)
                        (lwpo-evidence-set
                            (lwpo-evidence-confirmations set)
                            (lwpo-evidence-corrections set)
                            (lwpo-evidence-silences set)
                            (lwo-field-add
                                (lwpo-evidence-alternatives set) evidence)
                            (lwpo-evidence-unresolved set))
                        (lwpo-evidence-set
                            (lwpo-evidence-confirmations set)
                            (lwpo-evidence-corrections set)
                            (lwpo-evidence-silences set)
                            (lwpo-evidence-alternatives set)
                            (lwo-field-add
                                (lwpo-evidence-unresolved set) evidence))))))))

(defn lwpo-collect-items (world items answer set)
    (if (eq (len items) 0) set
        (do
            (let outcome (head items))
            (lwpo-collect-items world (tail items) answer
                (if (and (eq (lwpo-outcome-current? world outcome) 1)
                         (node_eq (lwpo-outcome-answer outcome) answer))
                    (lwpo-classify
                        (lwpo-evidence outcome
                            (lwo-active-attributions-for world outcome)) set)
                    set)))))
(defn lwpo-evidence-for (world answer)
    (lwpo-collect-items world
        (lwo-field-items (lwo-world-cells world)) answer
        (lwpo-empty-evidence-set)))

(defn lwpo-field-count (field) (lwo-field-size field))
(defn lwpo-state-for (set)
    (if (gt (add (lwpo-field-count (lwpo-evidence-corrections set))
                 (add (lwpo-field-count (lwpo-evidence-alternatives set))
                      (lwpo-field-count (lwpo-evidence-unresolved set)))) 0)
        (lwpo-contested)
        (if (gt (lwpo-field-count (lwpo-evidence-confirmations set)) 0)
            (lwpo-confirmed) (lwpo-unobserved))))

(defn lwpo-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwpo-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwpo-evidence-items (set)
    (append (lwo-field-items (lwpo-evidence-confirmations set))
        (append (lwo-field-items (lwpo-evidence-corrections set))
            (append (lwo-field-items (lwpo-evidence-silences set))
                (append (lwo-field-items (lwpo-evidence-alternatives set))
                    (lwo-field-items (lwpo-evidence-unresolved set)))))))
(defn lwpo-witnesses-items (world items witnesses)
    (if (eq (len items) 0) witnesses
        (do
            (let evidence (head items))
            (let outcome (lwpo-evidence-outcome evidence))
            (let with-outcome
                (lwpo-field-union-items
                    (lwo-field-items (lwpo-evidence-attributions evidence))
                    witnesses))
            (let declaration (lwpo-outcome-declaration outcome))
            (lwpo-witnesses-items world (tail items)
                (if (node_eq declaration (lwo-none)) with-outcome
                    (lwpo-field-union-items
                        (lwo-field-items
                            (lwo-active-attributions-for world declaration))
                        with-outcome))))))
(defn lwpo-witnesses (world answer set)
    (do
        (let request (lwepv-answer-request answer))
        (let class (lwepv-request-class request))
        (let with-class
            (lwpo-field-union-items
                (lwo-field-items (lwep-class-witnesses class))
                (lwo-empty-field)))
        (let with-request
            (lwpo-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world request)) with-class))
        (lwpo-witnesses-items world (lwpo-evidence-items set) with-request)))

(defn lwpo-outcome-kind (outcome)
    (do
        (let ack (lwpo-outcome-ack outcome))
        (if (eq (oac-one? ack) 1) (lwpo-confirmed)
            (if (eq (oac-zero? ack) 1) (lwpo-correction)
                (if (eq (oac-nothing? ack) 1) (lwpo-silence)
                    (if (eq (oac-alternative-ack? ack) 1)
                        (lwpo-alternative) (lwpo-unresolved)))))))

; ZERO is dissent relative to the old answer, but when it includes an exact
; observed integer the lower probe truthfully records ONE(observed).  The
; derivation retains both interfaces, so correction is never renamed consent.
(defn lwpo-probe-ack (outcome)
    (if (eq (oac-zero? (lwpo-outcome-ack outcome)) 1)
        (oac-one (lwpo-outcome-observed outcome))
        (lwpo-outcome-ack outcome)))
(defn lwpo-field-candidate-for-answer (answer)
    (lwhe-candidate-field
        (lwhe-space-candidate
            (lwhe-enquiry-space
                (lwep-class-enquiry
                    (lwepv-request-class
                        (lwepv-answer-request answer)))))))
(defn lwpo-probe-for-outcome (outcome)
    (do
        (let observed (lwpo-outcome-observed outcome))
        (if (and (not (node_eq observed (lwo-none)))
                 (eq (lwepv-int-cell? observed) 0)) (lwo-none)
            (lwph-probe
                (lwpo-field-candidate-for-answer
                    (lwpo-outcome-answer outcome))
                (lwepv-request-bindings
                    (lwepv-answer-request
                        (lwpo-outcome-answer outcome)))
                observed (lwpo-probe-ack outcome)
                (lwpo-outcome-alternatives outcome)
                (lwpo-outcome-unknown outcome) outcome))))

; children: exact evidence, classified kind, optional exact probe, local path
(defn lwpo-derivation (evidence)
    (do
        (let outcome (lwpo-evidence-outcome evidence))
        (intern_node LWPO-DERIVATION
            (list evidence (lwpo-outcome-kind outcome)
                  (lwpo-probe-for-outcome outcome) (lwo-local-path)))))
(defn lwpo-derivation? (cell) (lwo-category? cell LWPO-DERIVATION))
(defn lwpo-derivation-evidence (derivation) (nth (node_children derivation) 0))
(defn lwpo-derivation-kind (derivation) (nth (node_children derivation) 1))
(defn lwpo-derivation-probe (derivation) (nth (node_children derivation) 2))
(defn lwpo-derivations-items (items field)
    (if (eq (len items) 0) field
        (lwpo-derivations-items (tail items)
            (lwo-field-add field (lwpo-derivation (head items))))))

(defn lwpo-alternatives-items (items field)
    (if (eq (len items) 0) field
        (do
            (let outcome (lwpo-evidence-outcome (head items)))
            (lwpo-alternatives-items (tail items)
                (lwpo-field-union-items
                    (lwo-field-items (lwpo-outcome-alternatives outcome))
                    field)))))
(defn lwpo-unknowns-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown
                (lwpo-outcome-unknown
                    (lwpo-evidence-outcome (head items))))
            (lwpo-unknowns-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))

; children: exact answer, plural outcome evidence, state, alternatives,
; unknowns, exact probe derivations, witnesses, local path
(defn lwpo-cycle-cell
    (answer set state alternatives unknowns derivations witnesses)
    (intern_node LWPO-CYCLE
        (list answer set state alternatives unknowns derivations witnesses
              (lwo-local-path))))
(defn lwpo-cycle? (cell) (lwo-category? cell LWPO-CYCLE))
(defn lwpo-cycle-answer (cycle) (nth (node_children cycle) 0))
(defn lwpo-cycle-evidence (cycle) (nth (node_children cycle) 1))
(defn lwpo-cycle-state (cycle) (nth (node_children cycle) 2))
(defn lwpo-cycle-alternatives (cycle) (nth (node_children cycle) 3))
(defn lwpo-cycle-unknowns (cycle) (nth (node_children cycle) 4))
(defn lwpo-cycle-derivations (cycle) (nth (node_children cycle) 5))
(defn lwpo-cycle-witnesses (cycle) (nth (node_children cycle) 6))
(defn lwpo-cycle-path (cycle) (nth (node_children cycle) 7))

(defn lwpo-cycle-for (world answer)
    (if (eq (lwepv-answer-current? world answer) 0) (lwo-none)
        (do
            (let set (lwpo-evidence-for world answer))
            (let items (lwpo-evidence-items set))
            (let state (lwpo-state-for set))
            (lwpo-cycle-cell answer set state
                (lwpo-alternatives-items items (lwo-empty-field))
                (lwpo-unknowns-items items
                    (if (eq (lwpo-confirmed? state) 1) (lwo-empty-field)
                        (lwo-field (list (lwlc-unknown set)))))
                (lwpo-derivations-items items (lwo-empty-field))
                (lwpo-witnesses world answer set)))))

(defn lwpo-origin (answer)
    (intern_node LWPO-ORIGIN (list answer (lwo-local-path))))
(defn lwpo-proposal-for (world answer)
    (do
        (let cycle (lwpo-cycle-for world answer))
        (if (or (node_eq cycle (lwo-none))
                (eq (len (lwpo-evidence-items
                            (lwpo-cycle-evidence cycle))) 0))
            (lwo-none)
            (do
                (let witnesses (lwpo-cycle-witnesses cycle))
                (let count (lwo-field-size witnesses))
                (let origin (lwpo-origin answer))
                (let candidate
                    (lwo-emergent cycle witnesses
                        (intern_trivial_int
                            (len (lwpo-evidence-items
                                (lwpo-cycle-evidence cycle))))
                        (intern_trivial_int
                            (lwo-field-size
                                (lwpo-cycle-derivations cycle)))
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwpo-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwpo-cycle? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwpo-candidate-current? (world candidate)
    (if (eq (lwpo-candidate? candidate) 0) 0
        (do
            (let cycle (lwo-emergent-shape candidate))
            (let fresh (lwpo-proposal-for world (lwpo-cycle-answer cycle)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwpo-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwpo-candidate-current? world candidate) 1)) 1 0))
(defn lwpo-integrate (round proposal action)
    (if (eq (lwpo-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

(defn lwpo-probes-items (items probes)
    (if (eq (len items) 0) probes
        (do
            (let probe (lwpo-derivation-probe (head items)))
            (lwpo-probes-items (tail items)
                (if (node_eq probe (lwo-none)) probes
                    (lwo-field-add probes probe))))))
(defn lwpo-probe-successors (world candidate)
    (if (eq (lwpo-integrated-current? world candidate) 0) (lwo-empty-field)
        (lwpo-probes-items
            (lwo-field-items
                (lwpo-cycle-derivations
                    (lwo-emergent-shape candidate)))
            (lwo-empty-field))))

(defn lwpo-progress-target (proposal)
    (if (node_eq proposal (lwo-none)) "proposal:nothing"
        (do
            (let cycle
                (lwo-emergent-shape
                    (lwt-proposal-candidate proposal)))
            (lcfb-cat (list "evidence:"
                (int_to_str
                    (len (lwpo-evidence-items
                        (lwpo-cycle-evidence cycle))))
                ":derivations:"
                (int_to_str
                    (lwo-field-size (lwpo-cycle-derivations cycle)))
                ":witnesses:"
                (int_to_str
                    (lwo-field-size (lwpo-cycle-witnesses cycle)))))))
(defn lwpo-proposal-for-observed (world answer started ordinal)
    (do
        (let entered
            (lcfb-call-stream "living-world-profile-outcome"
                "outcomes" "enter" "form-native" "lwpo-proposal-for"
                "plural-answer-feedback" (mul ordinal 2) started
                "form/form-stdlib/living-world-profile-outcome.fk" 468 14))
        (let proposal (lwpo-proposal-for world answer))
        (let left
            (lcfb-call-stream "living-world-profile-outcome"
                "cycle" "modify" "form-native" "lwpo-proposal-for"
                (lwpo-progress-target proposal) (add (mul ordinal 2) 1)
                started
                "form/form-stdlib/living-world-profile-outcome.fk" 476 14))
        proposal))

; witnessed: 2026-08-09 -> 2147483647 native outcome-to-tissue cycle on fkwu
