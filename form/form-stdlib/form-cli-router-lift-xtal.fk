; form-cli-router-lift.fk — fcr-walk and fitness, authored in form.lift.
;
; Lift of form-cli-router.fk. Same names. Crystallize; the s-expr file
; still serves callers until they prelude the xtal. Edit this section.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-router-lift-band.fk
; witnessed: 2026-08-20 -> 255

(do (defn fcr-confidence-axis (passes attempts) (if (eq attempts 0) 0 (div (mul passes 100) attempts))) (defn fcr-weights () (list 2 2 1 1 6)) (defn fcr-backend (name sovereignty trust capability confidence) (list name sovereignty trust capability confidence)) (defn fcr-name (b) (nth b 0)) (defn fcr-sovereignty (b) (nth b 1)) (defn fcr-trust (b) (nth b 2)) (defn fcr-capability (b) (nth b 3)) (defn fcr-confidence (b) (nth b 4)) (defn fcr-backend-learned (name sovereignty trust capability passes attempts) (fcr-backend name sovereignty trust capability (fcr-confidence-axis passes attempts))) (defn fcr-fitness (b) (if (eq (fcr-capability b) 0) 0 (div (add (add (mul (nth (fcr-weights) 0) (fcr-sovereignty b)) (mul (nth (fcr-weights) 1) (fcr-trust b))) (add (mul (nth (fcr-weights) 2) (fcr-capability b)) (mul (nth (fcr-weights) 3) (fcr-confidence b)))) (nth (fcr-weights) 4)))) (defn fcr-route (form-native agent-cli) (if (ge (fcr-fitness form-native) (fcr-fitness agent-cli)) (fcr-name form-native) (fcr-name agent-cli))) (defn fcr-flips-local? (fn-before fn-after agent-cli) (if (str_eq (fcr-route fn-before agent-cli) "agent-cli") (if (str_eq (fcr-route fn-after agent-cli) "form-native") 1 0) 0)) (defn fcr-sovereign? (winner-name) (if (str_eq winner-name "form-native") 1 0)) (defn fcr-lane-native () 0) (defn fcr-lane-local () 1) (defn fcr-lane-remote () 2) (defn fcr-walk (native-hit local-ready) (if (eq native-hit 1) 0 (if (eq local-ready 1) 1 2))) 0)
