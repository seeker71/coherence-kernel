; jit-lower-self-crystallized.fk — one born structural specialization threaded
; through a complete recursive jit-lower flow.
;
; jit-self-crystallization.fk proved that live Form decisions can birth a
; structural NodeID, lower to native bytes, and answer a request carrying that
; exact identity.  This cell connects that organ to a real compiler caller:
; jit-lower's 80-entry body-shape surface is born once, then the same handle is
; carried through recursive sensing, substitution, rebuild, rule application,
; call inlining, and whole-program lowering.  No recursive node births a new
; specialization and no fixed function seat selects the route.
;
; Route provenance remains explicit in the result.  Darwin/fkwu says "native";
; a carrier absence may say "form" while returning the same shape value; an
; identity mismatch remains "refused" and exact (nothing), never a fallback.
;
; This is caller integration, not the final hot home.  jit_leaf_inram still
; reconstructs and scans the 1292-byte image for every call.  The O(1) resident
; NodeID -> executable handle belongs beneath this already-structural contract.
;
; preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/hati-os-kernel.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/jit-lower.fk form-stdlib/jit-self-crystallization.fk

(do
    ; Result = lowered-functions, retained-handle, births, route.
    (defn jlsc-result (lowered handle births route)
        (list lowered handle births route))
    (defn jlsc-lowered (r) (nth r 0))
    (defn jlsc-handle (r) (nth r 1))
    (defn jlsc-births (r) (nth r 2))
    (defn jlsc-route (r) (nth r 3))

    (defn jlsc-birth () (jssc-birth (jit-shape-table)))
    (defn jlsc-shape-route (handle tag)
        (if (ge tag 80) (list "form" 0)
            (jssc-route-at handle (jssc-handle-identity handle) tag)))
    (defn jlsc-shape (handle tag) (nth (jlsc-shape-route handle tag) 1))

    (defn jlsc-has-tag? (handle node wanted)
        (do (let tag (fk-tag node))
            (let shape (jlsc-shape handle tag))
            (if (eq tag wanted) 1
                (if (eq shape 1) (jlsc-has-tag? handle (fk-body node) wanted)
                (if (eq shape 2)
                    (if (eq (jlsc-has-tag? handle
                                (ms-child (fk-body node) 0) wanted) 1) 1
                        (jlsc-has-tag? handle
                            (ms-child (fk-body node) 1) wanted))
                (if (eq shape 3)
                    (if (eq (jlsc-has-tag? handle
                                (ms-child (fk-body node) 0) wanted) 1) 1
                        (if (eq (jlsc-has-tag? handle
                                    (ms-child (ms-child (fk-body node) 1) 0)
                                    wanted) 1) 1
                            (jlsc-has-tag? handle
                                (ms-child (ms-child (fk-body node) 1) 1)
                                wanted)))
                (if (eq shape 4)
                    (jlsc-has-tag? handle (ms-child (fk-body node) 1) wanted)
                    0)))))))

    (defn jlsc-pure? (handle node)
        (if (eq (jlsc-has-tag? handle node 13) 1) 0
        (if (eq (jlsc-has-tag? handle node 14) 1) 0
        (if (eq (jlsc-has-tag? handle node 15) 1) 0
        (if (eq (jlsc-has-tag? handle node 16) 1) 0 1)))))
    (defn jlsc-leaf-fn? (handle body)
        (if (eq (jlsc-has-tag? handle body 12) 1) 0
            (if (eq (jlsc-has-tag? handle body 7) 1) 0 1)))

    (defn jlsc-subst-arg (handle node expr)
        (do (let tag (fk-tag node))
            (let shape (jlsc-shape handle tag))
            (if (eq tag 2) expr
                (if (eq shape 1)
                    (fk-node tag (jlsc-subst-arg handle (fk-body node) expr))
                (if (eq shape 2)
                    (fk-node tag (ms-intern
                        (jlsc-subst-arg handle
                            (ms-child (fk-body node) 0) expr)
                        (jlsc-subst-arg handle
                            (ms-child (fk-body node) 1) expr)))
                (if (eq shape 3)
                    (fk-node tag (ms-intern
                        (jlsc-subst-arg handle
                            (ms-child (fk-body node) 0) expr)
                        (ms-intern
                            (jlsc-subst-arg handle
                                (ms-child (ms-child (fk-body node) 1) 0) expr)
                            (jlsc-subst-arg handle
                                (ms-child (ms-child (fk-body node) 1) 1) expr))))
                (if (eq shape 4)
                    (fk-node tag (ms-intern
                        (ms-child (fk-body node) 0)
                        (jlsc-subst-arg handle
                            (ms-child (fk-body node) 1) expr)))
                    node)))))))

    (defn jlsc-rule-inline (handle fns node)
        (if (eq (fk-tag node) 12)
            (do (let fidx (ms-value (ms-child (fk-body node) 0)))
                (let expr (ms-child (fk-body node) 1))
                (if (le (len fns) fidx) node
                    (do (let callee (nth fns fidx))
                        (if (and (eq (jlsc-leaf-fn? handle callee) 1)
                                 (eq (jlsc-pure? handle callee) 1))
                            (if (eq (jlsc-pure? handle expr) 1)
                                (jlsc-lower-node-in handle fns
                                    (jlsc-subst-arg handle callee expr))
                                node)
                            node))))
            node))

    (defn jlsc-rebuild (handle fns node tag shape)
        (if (eq shape 1)
            (fk-node tag (jlsc-lower-node-in handle fns (fk-body node)))
        (if (eq shape 2)
            (fk-node tag (ms-intern
                (jlsc-lower-node-in handle fns (ms-child (fk-body node) 0))
                (jlsc-lower-node-in handle fns (ms-child (fk-body node) 1))))
        (if (eq shape 3)
            (fk-node tag (ms-intern
                (jlsc-lower-node-in handle fns (ms-child (fk-body node) 0))
                (ms-intern
                    (jlsc-lower-node-in handle fns
                        (ms-child (ms-child (fk-body node) 1) 0))
                    (jlsc-lower-node-in handle fns
                        (ms-child (ms-child (fk-body node) 1) 1)))))
        (if (eq shape 4)
            (fk-node tag (ms-intern
                (ms-child (fk-body node) 0)
                (jlsc-lower-node-in handle fns
                    (ms-child (fk-body node) 1))))
            node)))))

    (defn jlsc-lower-node-in (handle fns node)
        (do (let tag (fk-tag node))
            (let shape (jlsc-shape handle tag))
            (jlsc-rule-inline handle fns
                (jit-rules (jlsc-rebuild handle fns node tag shape)))))

    (defn jlsc-lower-fns (handle fns rest)
        (if (eq (len rest) 0) (list)
            (cons (jlsc-lower-node-in handle fns (head rest))
                  (jlsc-lower-fns handle fns (tail rest)))))

    (defn jlsc-lower-program (fns)
        (do (let handle (jlsc-birth))
            (if (nothing? handle)
                (jlsc-result (nothing) (nothing) 0 "nothing")
                (do (let route (nth (jlsc-shape-route handle 0) 0))
                    (jlsc-result (jlsc-lower-fns handle fns fns)
                                 handle 1 route)))))
)
