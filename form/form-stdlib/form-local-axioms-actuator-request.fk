; form-local-axioms-actuator-request.fk -- exact NodeID execution request.
;
; A shared action category is not sufficient dispatch authority.  This request
; binds the action NodeID to one health identity and one selected local model.
; The production carrier may call the existing axioms physical recipe only when
; every field validates.  This is one exact branch, not a registry or ops table.
;
; preludes: form-stdlib/form-nodeid-mastery-cell-categories.fk
; Proven by: form-stdlib/tests/form-local-axioms-actuator-request-band.fk

(do
    (defn flar-schema () "form-local-axioms-actuator-request-v1")
    (defn flar-target () "axioms-resident-one-family-crossing")
    (defn flar-action () (fmcl-attempt-category))
    (defn flar-request (identity action path model-id)
        (list (flar-schema) identity action path model-id))
    (defn flar-identity (r) (nth r 1))
    (defn flar-action-of (r) (nth r 2))
    (defn flar-path (r) (nth r 3))
    (defn flar-model-id (r) (nth r 4))
    (defn flar-request-valid? (r)
        (if (nothing? r) 0
            (if (not (eq (len r) 5)) 0
                (if (not (str_eq (nth r 0) (flar-schema))) 0
                    (if (not (str_eq (flar-identity r) (flar-target))) 0
                        (if (not (node_eq (flar-action-of r)
                                         (flar-action))) 0
                            (if (le (str_len (flar-path r)) 0) 0
                                (if (le (str_len (flar-model-id r)) 0)
                                    0 1))))))))
    0)
