; form-cli-heed-fkqt.fk — the ONE cell that names the knowledge-query ABI.
;
; form-cli-heed-cursor.fk deliberately knows nothing about any knowledge
; substrate: its lookupf returns (status span reason) and that is all. This cell
; is the adapter that turns codex's typed form-knowledge-query-token ABI into
; that triple, so the cursor law and the ABI can land in either order and a
; second substrate needs a second adapter rather than a second cursor.
;
; WHAT CROSSES. fkqt-execute parses the surface, performs at most one native RAG
; lookup, and returns a typed result. fkqt-render renders it as the
; <|form:knowledge-observation|> envelope, carrying source-ref, content-ref,
; source-path, source-key, answer-key, score and confidence. That envelope is
; what the carrier prefills — a tool/observation role, clearly marked, never
; spliced into assistant prose. No cache row is dressed as model reasoning.
;
; THE GUARD. fkqt promises model-executed = 0 in every result. This adapter
; CHECKS it rather than trusting it: a result claiming a model executed the
; lookup is refused to `nothing` with reason model-executed-refused, and no span
; enters. The claim "no logit executed the lookup" is then enforced at the seam
; where it could actually be violated, not merely asserted in a comment.
;
; PENDING SEAM, stated plainly: as of 2026-08-24 13:5x WITA,
; form-stdlib/form-knowledge-query-token.fk is uncommitted in codex's worktree
; (/Users/ursmuff/.codex/worktrees/1dc9/coherence-kernel) and absent from
; origin/main and origin/codex/form-native-dialogue. This cell therefore does
; NOT preflight clean yet — its prelude names a file that has not landed. That
; is a pending seam, not a repair to route around: nothing else depends on this
; cell, form-cli-model-generate.fk carries fcmg-heed-lookup-nothing as its
; default, and the live lane is clean without it.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-cli-heed-cursor.fk
;
; Proven by: form-stdlib/tests/form-cli-heed-fkqt-band.fk (waits on the ABI)

(do
    (defn fhq-refused () (list "nothing" "" "model-executed-refused"))

    ; The adapter proper. ctx is unused — the substrate is the index, not the
    ; model — and it is accepted so the signature matches the cursor's lookupf.
    (defn fhq-of-result (r)
        (if (eq (fkqt-model-executed? r) 0)
            (list (fkqt-status r) (fkqt-render r) (fkqt-reason r))
            (fhq-refused)))

    (defn fhq-lookup (ctx surface local-ready)
        (fhq-of-result (fkqt-execute surface local-ready)))

    ; Same adapter against an explicit index, for a carrier that holds more than
    ; one knowledge substrate.
    (defn fhq-lookup-at (index-path ctx surface local-ready)
        (fhq-of-result (fkqt-execute-at index-path surface local-ready)))

    ; What a witness reads to confirm the seam is honest, independent of any run.
    (defn fhq-model-executed () 0)
    (defn fhq-open () (fkqt-open))
    (defn fhq-close () (fkqt-close))

    ; The two grammars must be the SAME grammar. If the heedmark marks and the
    ; ABI's envelope ever drift, the cursor would hold frames the ABI cannot
    ; parse and every lookup would answer nothing forever — a silent, total
    ; failure that no status would name. This is the check that makes it loud.
    (defn fhq-grammar-agrees ()
        (if (and (str_eq (HeedOpen) (fkqt-open))
                 (str_eq (HeedClose) (fkqt-close))) 1 0))

    0)
