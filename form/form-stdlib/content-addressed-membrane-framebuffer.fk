; content-addressed-membrane-framebuffer.fk — live offered observation and
; inquiry over content-addressed crossing compositions.
;
; Axiom 3: the framebuffer node composes the receipt identity bytes, so the
; event points back to the present shape rather than a granted label.
; Axiom 4: `camf-offer` is the interface through which observation makes the
; crossing real; node_source attributes where it was offered.
; Axiom 5: `camf-inquire` offers an identity + lane and acknowledges with a
; response node, an alternative node, or nothing.
;
; preludes: form-stdlib/core.fk form-stdlib/sha256.fk form-stdlib/native-model-evidence.fk form-stdlib/content-addressed-membrane.fk

(do
    (defn camf-tag () "content-addressed-membrane-framebuffer-v1")

    (defn camf-id-children-loop (id i)
        (if (ge i (str_len id)) (list)
            (cons (intern_trivial_int (str_byte_at id i))
                  (camf-id-children-loop id (add i 1)))))
    (defn camf-id-children (id) (camf-id-children-loop id 0))

    (defn camf-receipt-node (receipt)
        (intern_node
            (make_nodeid 1 2 1893 1)
            (camf-id-children (cam-id receipt))))

    ; offered = [tag receipt framebuffer-node alternative-node]
    (defn camf-offer (receipt source line col alternative)
        (if (eq (cam-witnessed? receipt) 0)
            (list (camf-tag) receipt (nothing) alternative)
            (do
                (let node (camf-receipt-node receipt))
                (let event (fb_record node source (add (mul line 65536) col)))
                (list (camf-tag) receipt event alternative))))

    (defn camf-receipt (offered) (nth offered 1))
    (defn camf-event (offered) (nth offered 2))
    (defn camf-alternative (offered) (nth offered 3))

    (defn camf-event-member? (needle events)
        (if (eq (len events) 0) 0
            (if (eq needle (head events)) 1
                (camf-event-member? needle (tail events)))))

    (defn camf-live? (offered)
        (if (nothing? (camf-event offered)) 0
            (camf-event-member? (camf-event offered) (framebuffer-events))))

    ; A matching content identity receives the requested lane value as a
    ; response node. An unknown lane acknowledges nothing. A mismatched
    ; identity receives the offered alternative node.
    ; result = [ack value query-event response-event]
    (defn camf-inquire (offered identity lane source line col)
        (do
            (let query-id
                (nmfe-sha256
                    (nmfe-fields (list identity lane (cam-id (camf-receipt offered))))))
            (let query-node
                (intern_node (make_nodeid 1 2 1894 1)
                    (camf-id-children query-id)))
            (let query-event
                (fb_record query-node source (add (mul line 65536) col)))
            (if (not (str_eq identity (cam-id (camf-receipt offered))))
                (list "node" (camf-alternative offered) query-event (nothing))
                (do
                    (let value (cam-inquire (camf-receipt offered) lane))
                    (if (nothing? value)
                        (list "nothing" (nothing) query-event (nothing))
                        (do
                            (let response-id
                                (nmfe-sha256 (nmfe-fields (list identity lane value))))
                            (let response-node
                                (intern_node (make_nodeid 1 2 1895 1)
                                    (camf-id-children response-id)))
                            (let response-event
                                (fb_record response-node source
                                    (add (mul line 65536) (add col 1))))
                            (list "node" value query-event response-event)))))))

    0)
