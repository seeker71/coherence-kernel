//////////////////////////////////////////////////////////////////////
//
// form-cli-ingest-exec.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-ingest-exec.bml
//
// Runs the three ingest cells. Observation is the integer the cell
// already returns. Phrase-copy stays a canary elsewhere.
//
// Proven by: form-stdlib/tests/form-cli-ingest-exec-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template ExecHit<TPath> {
        member path: TPath;
        member value: int;
        member observe: String;
    }

    class FormIngestExecAuthority {
        field IngestExecAuthorityPath = "form/form-stdlib/bml/form-cli-ingest-exec.bml";
        field IngestExecAuthorityKind = "high-bml-class-template-field";
    }

    class FormIngestExec<T> {
        field SameCells = 1;
        field DiffCells = 2;
        field DeepYes = 1;
        field DeepNo = 0;
        field NamedOnly = 0;
        field Lesson = 1;
        field Claim = 2;
        field CollapsePath = "ingest/equivalence-collapse.fk";
        field DepthPath = "ingest/knowledge-ingest.fk";
        field NboPath = "ingest/name-build-observe.fk";

        ref fie-authority = FormIngestExecAuthority;
        thought fie-pattern = list("native-return", "ec-cells2", "ki-deep", "nbo-enter");

        def fie-same() = ec-cells2(list(7), list(7));
        def fie-diff() = ec-cells2(list(7), list(9));
        def fie-deep() = ki-deep?(list(3, 0));
        def fie-shallow() = ki-deep?(list(1, 0));
        def fie-named() = nbo-enter(list(1, 0, 0));
        def fie-lesson() = nbo-enter(list(1, 1, 0));
        def fie-claim() = nbo-enter(list(1, 1, 1));

        def fie-collapse-observe() = str_concat("native ec-cells2 same=", str_concat(int_to_str(fie-same()), str_concat(" different=", int_to_str(fie-diff()))));
        def fie-depth-observe() = str_concat("native ki-deep? 3=", str_concat(int_to_str(fie-deep()), str_concat(" 1=", int_to_str(fie-shallow()))));
        def fie-nbo-observe() = str_concat("native nbo-enter named=", str_concat(int_to_str(fie-named()), str_concat(" lesson=", str_concat(int_to_str(fie-lesson()), str_concat(" claim=", int_to_str(fie-claim()))))));

        def fie-observe(path) = if str_eq(path, CollapsePath()) then fie-collapse-observe() else if str_eq(path, DepthPath()) then fie-depth-observe() else if str_eq(path, NboPath()) then fie-nbo-observe() else "";

        def fie-bit(ok, bit) = if ok then bit else 0;

        def fie-check() {
            let c0 = fie-bit(eq(fie-same(), SameCells()), 1);
            let c1 = fie-bit(eq(fie-diff(), DiffCells()), 2);
            let c2 = fie-bit(eq(fie-deep(), DeepYes()), 4);
            let c3 = fie-bit(eq(fie-shallow(), DeepNo()), 8);
            let c4 = fie-bit(and(eq(fie-named(), NamedOnly()), and(eq(fie-lesson(), Lesson()), eq(fie-claim(), Claim()))), 16);
            let c5 = fie-bit(ge(str_find(fie-collapse-observe(), "same=1", 0), 0), 32);
            let c6 = fie-bit(ge(str_find(fie-depth-observe(), "3=1", 0), 0), 64);
            let c7 = fie-bit(and(str_eq(fie-observe(CollapsePath()), fie-collapse-observe()), str_eq(fie-observe("other"), "")), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
