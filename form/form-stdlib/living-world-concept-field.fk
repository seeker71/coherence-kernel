; living-world-concept-field.fk -- admitted lenses can discover one another.
;
; A composable path emerges when the target skeleton of one active, steady
; recursive mapping is content-identical to the source skeleton of another.
; The organ does not name either endpoint or the bridge.  It retains both
; mappings, both uncertainty cells, every active holder, and the exact local
; path.  Composition is a proposal governed by all mapping holders; structural
; compatibility is evidence, never authority.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk

(let LWCX-CHAIN  (bp "LWCX-CHAIN"))
(let LWCX-ORIGIN (bp "LWCX-ORIGIN"))

(defn lwcx-composable? (world first-candidate second-candidate)
    (if (and (not (node_eq first-candidate second-candidate))
             (and (eq (lwrl-recursive-candidate? first-candidate) 1)
                  (and (eq (lwrl-recursive-candidate? second-candidate) 1)
                       (and (eq (lwrl-steady? world first-candidate) 1)
                            (and (eq (lwrl-steady? world second-candidate) 1)
                                 (node_eq
                                    (lwrr-signature-target-skeleton
                                        (lwrr-mapping-signature
                                            (lwo-emergent-shape
                                                first-candidate)))
                                    (lwrr-signature-source-skeleton
                                        (lwrr-mapping-signature
                                            (lwo-emergent-shape
                                                second-candidate))))))))) 1 0))

; children: first candidate, second candidate, first signature, second
; signature, source skeleton, bridge skeleton, target skeleton, first
; uncertainty, second uncertainty, local path
(defn lwcx-chain (first-candidate second-candidate)
    (do
        (let first-mapping (lwo-emergent-shape first-candidate))
        (let second-mapping (lwo-emergent-shape second-candidate))
        (let first-signature (lwrr-mapping-signature first-mapping))
        (let second-signature (lwrr-mapping-signature second-mapping))
        (intern_node LWCX-CHAIN
            (list first-candidate second-candidate
                  first-signature second-signature
                  (lwrr-signature-source-skeleton first-signature)
                  (lwrr-signature-target-skeleton first-signature)
                  (lwrr-signature-target-skeleton second-signature)
                  (lwrr-mapping-uncertainty first-mapping)
                  (lwrr-mapping-uncertainty second-mapping)
                  (lwo-local-path)))))
(defn lwcx-chain? (cell) (lwo-category? cell LWCX-CHAIN))
(defn lwcx-chain-first-candidate (chain) (nth (node_children chain) 0))
(defn lwcx-chain-second-candidate (chain) (nth (node_children chain) 1))
(defn lwcx-chain-first-signature (chain) (nth (node_children chain) 2))
(defn lwcx-chain-second-signature (chain) (nth (node_children chain) 3))
(defn lwcx-chain-source-skeleton (chain) (nth (node_children chain) 4))
(defn lwcx-chain-bridge-skeleton (chain) (nth (node_children chain) 5))
(defn lwcx-chain-target-skeleton (chain) (nth (node_children chain) 6))
(defn lwcx-chain-first-uncertainty (chain) (nth (node_children chain) 7))
(defn lwcx-chain-second-uncertainty (chain) (nth (node_children chain) 8))
(defn lwcx-chain-path (chain) (nth (node_children chain) 9))

(defn lwcx-chain-witnesses (world first-candidate second-candidate)
    (lwr-field-union-items
        (lwo-field-items
            (lwo-active-attributions-for world second-candidate))
        (lwo-active-attributions-for world first-candidate)))

(defn lwcx-origin (chain witnesses)
    (intern_node LWCX-ORIGIN (list chain witnesses)))

(defn lwcx-chain-proposal (world first-candidate second-candidate)
    (if (eq (lwcx-composable?
                world first-candidate second-candidate) 0)
        (lwo-none)
        (do
            (let chain (lwcx-chain first-candidate second-candidate))
            (let witnesses
                (lwcx-chain-witnesses
                    world first-candidate second-candidate))
            (let origin (lwcx-origin chain witnesses))
            (let candidate
                (lwo-emergent chain witnesses
                    (intern_trivial_int
                        (add (lwo-emergent-coherence first-candidate)
                             (lwo-emergent-coherence second-candidate)))
                    (intern_trivial_int 2)
                    (intern_trivial_int (lwo-field-size witnesses))
                    origin))
            (lwt-proposal candidate
                (lwt-sources-from-attributions
                    (lwo-field-items witnesses) (lwo-empty-field))
                origin))))

(defn lwcx-proposals-with-first (world first items acc)
    (if (eq (len items) 0) acc
        (do
            (let proposal
                (lwcx-chain-proposal world first (head items)))
            (lwcx-proposals-with-first world first (tail items)
                (if (node_eq proposal (lwo-none)) acc
                    (lwo-field-add acc proposal))))))

(defn lwcx-chain-proposals-items (world firsts all-items acc)
    (if (eq (len firsts) 0) acc
        (lwcx-chain-proposals-items world (tail firsts) all-items
            (lwcx-proposals-with-first
                world (head firsts) all-items acc))))

(defn lwcx-chain-proposals (world)
    (do
        (let items (lwo-field-items (lwo-world-cells world)))
        (lwcx-chain-proposals-items
            world items items (lwo-empty-field))))

(defn lwcx-chain-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwcx-chain? (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwcx-chain-steady? (world candidate)
    (if (eq (lwcx-chain-candidate? candidate) 0) 0
        (do
            (let chain (lwo-emergent-shape candidate))
            (if (and (eq (lwo-active? world candidate) 1)
                     (and (eq (lwo-emergent-ready? world candidate) 1)
                          (eq (lwcx-composable? world
                                (lwcx-chain-first-candidate chain)
                                (lwcx-chain-second-candidate chain)) 1))) 1 0))))

(defn lwcx-integrate-chain (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwcx-chain-candidate? candidate) 0)
            (lwt-round (lwt-round-world round) (lwt-round-proposals round)
                       (lwo-empty-field) round)
            (do
                (let chain (lwo-emergent-shape candidate))
                (if (eq (lwcx-composable? (lwt-round-world round)
                            (lwcx-chain-first-candidate chain)
                            (lwcx-chain-second-candidate chain)) 0)
                    (lwt-round (lwt-round-world round)
                               (lwt-round-proposals round)
                               (lwo-field-add (lwo-empty-field)
                                   (lwt-evaluate-proposal
                                       (lwt-round-world round) proposal))
                               round)
                    (lwt-integrate round proposal action))))))
