; form-agent-world-model.fk -- observed Form-agent attempts enter the one world model.
;
; A candidate is not a fact about the world.  This join accepts only candidate +
; coldjudge observation pairs whose identity and execution evidence agree through
; form-execution-verified-curriculum.  It preserves failed and plateauing attempts
; instead of requiring a green endpoint: those misses are exactly the world-state
; a revising agent needs.  An empty or unbound trajectory returns nothing.
;
; Each admitted attempt becomes an ordinary world-model entity:
;   kind        "agent-attempt"
;   embedding   outcome-code, surprise, preflight-clean, compile-exit, run-exit,
;               value-signal (a fixed six-component observation vector)
;   position    trajectory step, expected value, observed value
;   persistence 1 -- one witnessed attempt, never invented repetition
;   id          trajectory provenance + step index
;
; The guide is a pure choice offer for the resident agent.  It does not execute,
; mutate, or claim that local/native generation is infallible.  A wrong value asks
; for a value contrast; a syntax failure asks for the kernel diagnostic; silence,
; timeout and control outcomes remain separate.  The agent message is the existing
; form-agent-protocol tool-result shape, not another wire protocol.
;
; preludes: form-stdlib/form-execution-verified-curriculum.fk
; preludes: form-stdlib/world-model.fk form-stdlib/form-agent-protocol.fk
; Proven by: form-stdlib/tests/form-agent-world-model-band.fk
; witnessed: 2026-08-28 -> fkwu band 8191, exit 0

import "form-execution-verified-curriculum.fk"
import "world-model.fk"
import "form-agent-protocol.fk"

(do
    (defn fawm-candidate-shape? (c)
        (if (not (eq (len c) 6)) 0
            (if (str_eq (nth c 0) "form-execution-candidate-v1") 1 0)))
    (defn fawm-execution-shape? (e)
        (if (not (eq (len e) 4)) 0
            (if (str_eq (nth e 0) "form-coldjudge-execution-v1") 1 0)))
    (defn fawm-evidence-shape? (e)
        (if (not (eq (len e) 3)) 0
            (if (str_eq (nth e 0) "form-coldjudge-evidence-v1") 1 0)))
    (defn fawm-observation-shape? (o)
        (if (not (eq (len o) 7)) 0
            (if (not (str_eq (nth o 0) "form-coldjudge-observation-v1")) 0
                (if (eq (fawm-execution-shape? (nth o 5)) 0) 0
                    (fawm-evidence-shape? (nth o 6))))))
    (defn fawm-step-shape? (s)
        (if (not (eq (len s) 3)) 0
            (if (not (str_eq (nth s 0) "form-execution-trajectory-step-v1")) 0
                (if (eq (fawm-candidate-shape? (nth s 1)) 0) 0
                    (fawm-observation-shape? (nth s 2))))))
    (defn fawm-trajectory-shape? (t)
        (if (not (eq (len t) 4)) 0
            (if (str_eq (nth t 0) "form-execution-trajectory-v1") 1 0)))

    (defn fawm-step-observed? (family step)
        (if (eq (fawm-step-shape? step) 0) 0
            (do
                (let c (evfc-step-candidate step))
                (let o (evfc-step-observation step))
                (if (not (str_eq family (evfc-c-family c))) 0
                    (evfc-observation-valid? c o)))))
    (defn fawm-steps-observed? (family steps)
        (if (nil? steps) 0
            (if (eq (fawm-step-observed? family (head steps)) 0) 0
                (if (nil? (tail steps)) 1
                    (fawm-steps-observed? family (tail steps))))))
    (defn fawm-trajectory-observed? (trajectory)
        (if (eq (fawm-trajectory-shape? trajectory) 0) 0
            (fawm-steps-observed? (evfc-t-family trajectory)
                (evfc-t-steps trajectory))))

    (defn fawm-outcome-code (kind)
        (if (str_eq kind "syntax-failure") 1
        (if (str_eq kind "timeout") 2
        (if (str_eq kind "nothing") 3
        (if (str_eq kind "failure") 4
        (if (str_eq kind "green") 5
        (if (str_eq kind "choice") 6
        (if (str_eq kind "cut") 7
        (if (str_eq kind "undo") 8
        (if (str_eq kind "semantic-failure") 9 0))))))))))
    (defn fawm-surprised? (candidate observation)
        (if (eq (evfc-green? candidate observation) 1) 0 1))
    (defn fawm-preflight-clean? (observation)
        (if (str_eq (evfc-o-preflight observation) "clean") 1 0))
    (defn fawm-step-id (trajectory index)
        (str_concat (evfc-t-provenance trajectory)
            (str_concat ":" (int_to_str index))))
    (defn fawm-step-embedding (candidate observation)
        (do
            (let kind (evfc-observed-kind candidate observation))
            (list (fawm-outcome-code kind)
                (fawm-surprised? candidate observation)
                (fawm-preflight-clean? observation)
                (evfc-o-compile-exit observation)
                (evfc-o-run-exit observation)
                (evfc-value-signal? (evfc-o-signal observation)))))
    (defn fawm-step-position (candidate observation index)
        (list index (evfc-c-expected candidate) (evfc-o-value observation)))
    (defn fawm-step-entity (trajectory step index)
        (do
            (let c (evfc-step-candidate step))
            (let o (evfc-step-observation step))
            (wm-ent "agent-attempt" (fawm-step-embedding c o)
                (fawm-step-position c o index) 1
                (fawm-step-id trajectory index))))
    (defn fawm-step-entities (trajectory steps index)
        (if (nil? steps) (empty)
            (cons (fawm-step-entity trajectory (head steps) index)
                (fawm-step-entities trajectory (tail steps) (add index 1)))))

    (defn fawm-world (trajectory)
        (if (eq (fawm-trajectory-observed? trajectory) 0) (nothing)
            (fawm-step-entities trajectory (evfc-t-steps trajectory) 0)))
    (defn fawm-world-image (trajectory)
        (do
            (let world (fawm-world trajectory))
            (if (nothing? world) (nothing) (wm-model world))))
    (defn fawm-attempt-count (trajectory)
        (do
            (let world (fawm-world trajectory))
            (if (nothing? world) (nothing)
                (wm-orient-count world "agent-attempt"))))
    (defn fawm-surprise-count-go (steps total)
        (if (nil? steps) total
            (do
                (let c (evfc-step-candidate (head steps)))
                (let o (evfc-step-observation (head steps)))
                (fawm-surprise-count-go (tail steps)
                    (add total (fawm-surprised? c o))))))
    (defn fawm-surprise-count (trajectory)
        (if (eq (fawm-trajectory-observed? trajectory) 0) (nothing)
            (fawm-surprise-count-go (evfc-t-steps trajectory) 0)))
    (defn fawm-last-step (steps)
        (if (nil? (tail steps)) (head steps) (fawm-last-step (tail steps))))
    (defn fawm-last-kind (trajectory)
        (if (eq (fawm-trajectory-observed? trajectory) 0) (nothing)
            (do
                (let step (fawm-last-step (evfc-t-steps trajectory)))
                (evfc-observed-kind (evfc-step-candidate step)
                    (evfc-step-observation step)))))
    (defn fawm-action-for-kind (kind)
        (if (str_eq kind "green") "crystallize"
        (if (str_eq kind "semantic-failure") "revise-with-value-contrast"
        (if (str_eq kind "syntax-failure") "revise-with-diagnostic"
        (if (str_eq kind "timeout") "branch-or-reduce"
        (if (str_eq kind "nothing") "request-evidence"
        (if (str_eq kind "failure") "investigate"
        (if (str_eq kind "choice") "reobserve-control"
        (if (str_eq kind "cut") "reobserve-control"
        (if (str_eq kind "undo") "reobserve-control" "hold"))))))))))
    (defn fawm-next-action (trajectory)
        (do
            (let kind (fawm-last-kind trajectory))
            (if (nothing? kind) (nothing) (fawm-action-for-kind kind))))

    (defn fawm-guide (trajectory)
        (do
            (let world (fawm-world-image trajectory))
            (if (nothing? world) (nothing)
                (list "form-agent-world-model-guide-v1" world
                    (fawm-surprise-count trajectory)
                    (fawm-last-kind trajectory)
                    (fawm-next-action trajectory)))))
    (defn fawm-guide-world (guide) (nth guide 1))
    (defn fawm-guide-surprises (guide) (nth guide 2))
    (defn fawm-guide-kind (guide) (nth guide 3))
    (defn fawm-guide-action (guide) (nth guide 4))
    (defn fawm-agent-message (call-id trajectory)
        (do
            (let guide (fawm-guide trajectory))
            (if (nothing? guide) (nothing)
                (ap-msg "tool" (list
                    (ap-tool-result call-id "world-model-observe" guide))))))
    0)
