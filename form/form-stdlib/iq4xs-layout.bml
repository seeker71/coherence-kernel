//////////////////////////////////////////////////////////////////////
// IQ4_XS executable byte geometry. Authority: bml/iq4xs-layout.bml.
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class IQ4XSLayoutAuthority {
        field IQ4XSAuthorityPath = "form/form-stdlib/bml/iq4xs-layout.bml";
        field IQ4XSAuthorityKind = "high-bml-interface-class-const";
    }

    class IQ4XSLayout {
        field IQ4XSGGMLType = 23;
        field IQ4XSBlockElements = 256;
        field IQ4XSBlockBytes = 136;
        field IQ4XSScaleHighOffset = 2;
        field IQ4XSScaleLowOffset = 4;
        field IQ4XSQuantOffset = 8;
        field IQ4XSGroupsPerBlock = 8;
        field IQ4XSGroupElements = 32;
        field IQ4XSCodebookEntries = 16;
        field IQ4XSSIMDWidth = 32;
        field IQ4XSSlotRows = 4;

        ref iq4x-authority = IQ4XSLayoutAuthority;
        thought iq4x-pattern = list("type23", "256-elements", "136-bytes", "six-bit-group-scale", "nonlinear-nibble-codebook", "slot4-one-simdgroup");

        def iq4x-mod(x, n) = sub(x, mul(div(x, n), n));
        def iq4x-pow2(k) = if le(k, 0) then 1 else mul(2, iq4x-pow2(sub(k, 1)));
        def iq4x-u16(bytes, off) = add(nth(bytes, off), mul(256, nth(bytes, add(off, 1))));
        def iq4x-block-of(i) = div(i, IQ4XSBlockElements());
        def iq4x-within(i) = iq4x-mod(i, IQ4XSBlockElements());
        def iq4x-group(i) = div(iq4x-within(i), IQ4XSGroupElements());
        def iq4x-group-index(i) = iq4x-mod(iq4x-within(i), IQ4XSGroupElements());
        def iq4x-scale-code(bytes, base, group) = add(iq4x-mod(div(nth(bytes, add(add(base, IQ4XSScaleLowOffset()), div(group, 2))), iq4x-pow2(mul(4, iq4x-mod(group, 2)))), 16), mul(iq4x-mod(div(iq4x-u16(bytes, add(base, IQ4XSScaleHighOffset())), iq4x-pow2(mul(2, group))), 4), 16));
        def iq4x-quant-byte-offset(base, i) = add(add(base, IQ4XSQuantOffset()), add(mul(iq4x-group(i), 16), iq4x-mod(iq4x-group-index(i), 16)));
        def iq4x-quant-code(bytes, base, i) = if lt(iq4x-group-index(i), 16) then iq4x-mod(nth(bytes, iq4x-quant-byte-offset(base, i)), 16) else div(nth(bytes, iq4x-quant-byte-offset(base, i)), 16);
        def iq4x-slot-row0(threadIndex) = mul(div(threadIndex, IQ4XSSIMDWidth()), IQ4XSSlotRows());
        def iq4x-slot-threads(rows) = mul(div(add(rows, sub(IQ4XSSlotRows(), 1)), IQ4XSSlotRows()), IQ4XSSIMDWidth());
        def iq4x-slot-admissible(rows, cols) = if lt(rows, 1) then 0 else if eq(iq4x-mod(cols, IQ4XSBlockElements()), 0) then 1 else 0;
        def iq4x-within-block(i) = if lt(i, 0) then 0 else if lt(i, IQ4XSBlockElements()) then 1 else 0;
    }
    0;
}
