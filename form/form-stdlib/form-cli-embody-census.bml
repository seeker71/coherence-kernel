//////////////////////////////////////////////////////////////////////
//
// form-cli-embody-census.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-embody-census.bml
//
// Folds the witnessed mill counts into one picture. Arithmetic
// over stamps, not a new 27B fit.
//
// Proven by: form-stdlib/tests/form-cli-embody-census-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template CensusRow<TCount> {
        member proofN: TCount;
        member organs: TCount;
        member laneKinds: TCount;
    }

    class FormEmbodyCensusAuthority {
        field CensusAuthorityPath = "form/form-stdlib/bml/form-cli-embody-census.bml";
        field CensusAuthorityKind = "high-bml-class-template-field";
    }

    class FormEmbodyCensus<T> {
        field KnowledgeN = 24;
        field UniverseN = 32;
        field UniqueN = 36;
        field DomainN = 48;
        field OrganN = 48;
        field LaneN = 738;
        field LensN = 144;
        field PlannerN = 144;
        field BodySkills = 41;
        field LensSkills = 8;
        field PlannerSkills = 8;
        field Lanes = 9;
        field CorpusN = 1152;
        field NeedEvents = 95;
        field SessionPpm = 894153;
        field FqtLora = 0;
        field OverlayPairs = 45;

        ref fem-authority = FormEmbodyCensusAuthority;
        thought fem-pattern = list("sum", "organs", "lanes", "remaining");
        thought fem-mills = list("knowledge", "universe", "unique", "domain", "organ", "lane", "lens", "planner");

        def fem-proof-n() = add(KnowledgeN(), add(UniverseN(), add(UniqueN(), add(DomainN(), add(OrganN(), add(LaneN(), add(LensN(), PlannerN())))))));

        def fem-organs() = add(BodySkills(), add(LensSkills(), PlannerSkills()));

        def fem-lane-kinds() = mul(fem-organs(), Lanes());

        def fem-body-n() = add(UniverseN(), add(UniqueN(), add(DomainN(), OrganN())));

        def fem-fqt-lora() = FqtLora();

        def fem-bit(ok, bit) = if ok then bit else 0;

        def fem-check() {
            let c0 = fem-bit(eq(fem-proof-n(), 1214), 1);
            let c1 = fem-bit(eq(fem-organs(), 57), 2);
            let c2 = fem-bit(eq(fem-lane-kinds(), 513), 4);
            let c3 = fem-bit(eq(fem-body-n(), 164), 8);
            let c4 = fem-bit(eq(CorpusN(), 1152), 16);
            let c5 = fem-bit(eq(NeedEvents(), 95), 32);
            let c6 = fem-bit(eq(SessionPpm(), 894153), 64);
            let c7 = fem-bit(and(eq(FqtLora(), 0), eq(OverlayPairs(), 45)), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
