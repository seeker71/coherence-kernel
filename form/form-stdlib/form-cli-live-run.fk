; form-cli-live-run.fk — one door, no flags: input -> thoughts -> MLX/JIT/GPU.
;
; The add row from fle-input is translated on demand to CPU JIT and Metal.
; Max and vadd stay on MLX. Framebuffer records each input row as it runs.
;
; preludes: form-stdlib/form-asm.fk form-stdlib/metal-door.fk form-stdlib/form-cli-live-xtal.fk observe/bidirectional-framebuffer-channel.fk

(do
    (defn fle-bytes (xs)
        (if (eq (len xs) 0) ""
            (str_concat (byte_to_str (head xs)) (fle-bytes (tail xs)))))
    (defn fle-nl () (byte_to_str 10))
    (defn fle-msl ()
        (str_concat "#include <metal_stdlib>"
        (str_concat (fle-nl)
        (str_concat "using namespace metal;"
        (str_concat (fle-nl)
                    "kernel void form_live_add(device uint *a [[buffer(0)]], constant uint &b [[buffer(1)]], uint gid [[thread_position_in_grid]]) { if (gid == 0) a[0] = a[0] + b; }")))))
    (defn fle-fb (xs step)
        (if (eq (len xs) 0) 0
            (do
                (fb_record (intern_trivial_int step) "form-cli-live-run.fk" step)
                (fle-fb (tail xs) (add step 1)))))
    (print "form-cli executed live\n")
    (print "form-cli gen0=")
    (print (head (fle-progs (fle-input))))
    (print " gen1=")
    (print (head (tail (fle-progs (fle-input)))))
    (print " gen2=")
    (print (head (tail (tail (fle-progs (fle-input))))))
    (print "\nform-cli mlx-pulse=")
    (print (int_to_str (fle-pulse (fle-input))))
    (print " mlx0=")
    (print (int_to_str (mlx_run (head (fle-progs (fle-input))))))
    (print " mlx1=")
    (print (int_to_str (mlx_run (head (tail (fle-progs (fle-input)))))))
    (print " mlx2=")
    (print (int_to_str (mlx_run (head (tail (tail (fle-progs (fle-input))))))))
    (print " check=")
    (print (int_to_str (fle-check)))
    (print "\n")
    (let image
        (fa-image (list
            (fa-ldr 3 0 0)
            (fa-ldr-w 4 1 0)
            (fa-ldr-w 5 3 0)
            (fa-add-r 5 5 4)
            (fa-str-w 5 3 0)
            (fa-ret))))
    (let code (fle-bytes image))
    (let buffer (metal_buf_alloc 4))
    (metal_buf_write buffer 0 (md-le32 (fle-add-lhs)))
    (let pipeline (metal_pipeline code "form_cpu_jit"))
    (let enqueued (metal_enqueue pipeline (md-bind (list buffer) (list (fle-add-rhs))) 1))
    (let result (metal_buf_read buffer 0 4))
    (print "form-cli jit enqueue=")
    (print (int_to_str enqueued))
    (print " byte0=")
    (print (int_to_str (str_byte_at result 0)))
    (print "\n")
    (let gbuf (metal_buf_alloc 4))
    (metal_buf_write gbuf 0 (md-le32 (fle-add-lhs)))
    (let gpipe (metal_pipeline (fle-msl) "form_live_add"))
    (let genq (metal_enqueue gpipe (md-bind (list gbuf) (list (fle-add-rhs))) 1))
    (let gsync (metal_sync))
    (let gres (metal_buf_read gbuf 0 4))
    (print "form-cli gpu enqueue=")
    (print (int_to_str genq))
    (print " sync=")
    (print (int_to_str gsync))
    (print " byte0=")
    (print (int_to_str (str_byte_at gres 0)))
    (print "\n")
    (framebuffer-clear)
    (fle-fb (fle-input) 0)
    (print "form-cli fb-live=")
    (print (int_to_str (len (framebuffer-events))))
    (print " fb-action=")
    (print (int_to_str (bfc-payload (nth (bfc-round 1 (list 4 2) (list 4 2) (list 0 4) 0) 1))))
    (print " fb-events=")
    (print (int_to_str (len (framebuffer-events))))
    (print "\nform-cli mlx=\n")
    (print (mlx_status))
    (print "\nform-cli metal=\n")
    (print (metal_status))
    (print "\n")
    (metal_buf_free buffer)
    (metal_buf_free gbuf)
    0)
