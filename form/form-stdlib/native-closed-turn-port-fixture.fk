; native-closed-turn-port-fixture.fk -- Form-authored, closed typed turn-port
; fixture.
;
; This is an isolated native fixture, deliberately unwired from form-cli, fsh,
; the turn controller, adapters, build recipes, and the C seed. Form emits the
; carrier below. The standalone harness accepts four closed lifecycle verbs
; plus one canonical lowercase 64-hex exchange identity; the second of the
; five fixed lifecycle stages is internal, not a caller-selectable mode. It
; has no path, cwd, executable, environment, prompt, response, or
; extra-argument surface.
;
; The compile-time roots are required only so an owner-reviewed builder can bind
; them. The standalone test binds them beneath one temporary directory. They
; are not runtime inputs. The run verb forks one deterministic local fixture
; child; the internal native-capability stage records pending discovery without
; opening or using a resource. Neither branch invokes a shell, Codex, a local
; model, or the network.
;
; Raw fixture bytes live only in the 0700 private mailbox exchange. The seal
; verb first publishes a content-blind `closure-pending` witness by an
; exclusive atomic link. Only then does it close raw prompt/response files
; through held directory descriptors, and only after that does it atomically
; publish the `closed` witness. A failed pre-publication keeps raw untouched;
; a failure after pending publication keeps a recoverable pending receipt.
; The discard verb removes only the closed enum of known mailbox leaves and
; refuses an exchange containing anything else.
;
; The stdout records are newline key/value tokens deliberately readable by a
; future Form process port. No raw fixture byte is printed.
;
; Compile and exercise only through:
;   form/scripts/native_closed_turn_port_fixture_test.sh
;
; preludes: form-stdlib/core.fk

(do
    (defn fctp-headers ()
        "#ifndef FCTP_MAILBOX_ROOT\n#error FCTP_MAILBOX_ROOT_is_required\n#endif\n#ifndef FCTP_WITNESS_ROOT\n#error FCTP_WITNESS_ROOT_is_required\n#endif\n#ifndef O_NOFOLLOW\n#error O_NOFOLLOW_is_required\n#endif\n#ifndef O_DIRECTORY\n#error O_DIRECTORY_is_required\n#endif\n#ifndef AT_SYMLINK_NOFOLLOW\n#error AT_SYMLINK_NOFOLLOW_is_required\n#endif\n#ifndef AT_REMOVEDIR\n#error AT_REMOVEDIR_is_required\n#endif\n#include <dirent.h>\n#include <errno.h>\n#include <fcntl.h>\n#include <inttypes.h>\n#include <limits.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n#include <sys/stat.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n#include <unistd.h>\n\n#define FCTP_SCHEMA \"closed-typed-turn-port-fixture-v1\"\n#define FCTP_PRIVATE_DIR_MODE 0700\n#define FCTP_PRIVATE_FILE_MODE 0600\n#define FCTP_RAW_LIMIT 4096\n#define FCTP_WITNESS_LIMIT 1024\n\nenum fctp_operation { FCTP_OPEN = 1, FCTP_RUN = 3, FCTP_SEAL = 4, FCTP_DISCARD = 5 };\nenum fctp_lifecycle_stage { FCTP_STAGE_OPEN = 1, FCTP_STAGE_NATIVE_CAPABILITY = 2, FCTP_STAGE_RUN = 3, FCTP_STAGE_SEAL = 4, FCTP_STAGE_DISCARD = 5 };\nenum fctp_leaf { FCTP_PROMPT_RAW = 1, FCTP_RESPONSE_RAW = 2, FCTP_NATIVE_CAPABILITY_STAGE = 3, FCTP_RUN_STAGE = 4, FCTP_SEAL_PENDING_TEMP = 5, FCTP_SEAL_CLOSED_TEMP = 6 };\nenum fctp_witness_leaf { FCTP_WITNESS_PENDING = 1, FCTP_WITNESS_CLOSED = 2 };\nstruct fctp_scope { int mailbox_root; int witness_root; int mailbox; int witness; };\n\n")
    ; Feature macros must precede the first system header.  fctp-headers keeps
    ; its #error so a target without O_NOFOLLOW still refuses compilation.
    (defn fctp-feature-macros ()
        "#if defined(__APPLE__) && !defined(_DARWIN_C_SOURCE)\n#define _DARWIN_C_SOURCE 1\n#endif\n#if defined(__linux__) && !defined(_GNU_SOURCE)\n#define _GNU_SOURCE 1\n#endif\n#define _POSIX_C_SOURCE 200809L\n#include <fcntl.h>\n\n")
    (defn fctp-shape ()
        "static const char *fctp_leaf_name(enum fctp_leaf leaf) {\n    switch (leaf) {\n        case FCTP_PROMPT_RAW: return \"prompt.raw\";\n        case FCTP_RESPONSE_RAW: return \"response.raw\";\n        case FCTP_NATIVE_CAPABILITY_STAGE: return \"native-capability-stage.kv\";\n        case FCTP_RUN_STAGE: return \"run-stage.kv\";\n        case FCTP_SEAL_PENDING_TEMP: return \".seal-pending.tmp\";\n        case FCTP_SEAL_CLOSED_TEMP: return \".seal-closed.tmp\";\n        default: return 0;\n    }\n}\n\nstatic int fctp_leaf_of_name(const char *name) {\n    enum fctp_leaf leaf;\n    for (leaf = FCTP_PROMPT_RAW; leaf <= FCTP_SEAL_CLOSED_TEMP; leaf += 1) {\n        const char *known = fctp_leaf_name(leaf);\n        if (known != 0 && strcmp(name, known) == 0) return leaf;\n    }\n    return 0;\n}\n\nstatic const char *fctp_witness_leaf_name(enum fctp_witness_leaf leaf) {\n    switch (leaf) {\n        case FCTP_WITNESS_PENDING: return \"closure-pending.manifest.kv\";\n        case FCTP_WITNESS_CLOSED: return \"manifest.kv\";\n        default: return 0;\n    }\n}\n\nstatic int fctp_witness_leaf_of_name(const char *name) {\n    enum fctp_witness_leaf leaf;\n    for (leaf = FCTP_WITNESS_PENDING; leaf <= FCTP_WITNESS_CLOSED; leaf += 1) {\n        const char *known = fctp_witness_leaf_name(leaf);\n        if (known != 0 && strcmp(name, known) == 0) return leaf;\n    }\n    return 0;\n}\n\nstatic int fctp_operation_of(const char *text) {\n    if (strcmp(text, \"open\") == 0) return FCTP_OPEN;\n    if (strcmp(text, \"run\") == 0) return FCTP_RUN;\n    if (strcmp(text, \"seal\") == 0) return FCTP_SEAL;\n    if (strcmp(text, \"discard\") == 0) return FCTP_DISCARD;\n    return 0;\n}\n\nstatic int fctp_lower_hex(unsigned char byte) {\n    return (byte >= '0' && byte <= '9') || (byte >= 'a' && byte <= 'f');\n}\n\nstatic int fctp_exchange_id_ok(const char *exchange_id) {\n    size_t at;\n    for (at = 0; at < 64; at += 1) {\n        if (exchange_id[at] == 0 || !fctp_lower_hex((unsigned char)exchange_id[at])) return 0;\n    }\n    return exchange_id[64] == 0;\n}\n\nstatic const char *fctp_operation_name(int operation) {\n    switch (operation) {\n        case FCTP_OPEN: return \"open\";\n        case FCTP_RUN: return \"run\";\n        case FCTP_SEAL: return \"seal\";\n        case FCTP_DISCARD: return \"discard\";\n        default: return \"\";\n    }\n}\n\nstatic void fctp_token(const char *operation, const char *exchange_id, const char *decision, const char *raw_state) {\n    printf(\"schema=%s\\noperation=%s\\nexchange_id=%s\\ndecision=%s\\nraw_state=%s\\n\", FCTP_SCHEMA, operation, exchange_id, decision, raw_state);\n    fflush(stdout);\n}\n\n")
    ; `fctp-shape` is shared by the original argv fixture and the emitted-table
    ; library.  The three CLI transcript helpers live at two stable suffix
    ; boundaries in that shape.  Select them in Form rather than retaining
    ; dormant CLI-only C functions in the linked emitted-table library: that
    ; library is compiled with full -Wall -Wextra -Werror, not an unused-helper
    ; waiver.  The standalone argv fixture receives the helpers back below.
    (defn fctp-cli-operation-parser ()
        (do (let shape (fctp-shape))
            (let start (str_find shape "static int fctp_operation_of(" 0))
            (let stop (str_find shape "static int fctp_lower_hex(" start))
                (substring shape start stop)))
    (defn fctp-cli-render-support ()
        (do (let shape (fctp-shape))
            (let start (str_find shape "static const char *fctp_operation_name(" 0))
                (substring shape start (str_len shape))))
    (defn fctp-library-shape ()
        (do (let shape (fctp-shape))
            (let parser-start (str_find shape "static int fctp_operation_of(" 0))
            (let lower-start (str_find shape "static int fctp_lower_hex(" parser-start))
            (let render-start (str_find shape "static const char *fctp_operation_name(" lower-start))
                (str_concat (substring shape 0 parser-start)
                            (substring shape lower-start render-start))))
    (defn fctp-private-filesystem ()
        "static void fctp_close_fd(int *fd) {\n    if (*fd >= 0) {\n        while (close(*fd) < 0 && errno == EINTR) { }\n        *fd = -1;\n    }\n}\n\nstatic int fctp_secure_dir_fd(int fd) {\n    struct stat st;\n    if (fstat(fd, &st) < 0) return 0;\n    if (!S_ISDIR(st.st_mode) || st.st_uid != geteuid()) return 0;\n    return (st.st_mode & 0777) == FCTP_PRIVATE_DIR_MODE;\n}\n\nstatic int fctp_secure_regular_fd(int fd) {\n    struct stat st;\n    if (fstat(fd, &st) < 0) return 0;\n    if (!S_ISREG(st.st_mode) || st.st_uid != geteuid()) return 0;\n    return (st.st_mode & 0777) == FCTP_PRIVATE_FILE_MODE;\n}\n\nstatic int fctp_open_private_root(const char *path, int create, int *out) {\n    int fd;\n    if (create && mkdir(path, FCTP_PRIVATE_DIR_MODE) < 0 && errno != EEXIST) return 0;\n    fd = open(path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW);\n    if (fd < 0) return 0;\n    if (!fctp_secure_dir_fd(fd)) { fctp_close_fd(&fd); return 0; }\n    *out = fd;\n    return 1;\n}\n\nstatic int fctp_open_private_dir_at(int parent_fd, const char *name, int *out) {\n    int fd = openat(parent_fd, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW);\n    if (fd < 0) return 0;\n    if (!fctp_secure_dir_fd(fd)) { fctp_close_fd(&fd); return 0; }\n    *out = fd;\n    return 1;\n}\n\nstatic int fctp_open_or_create_private_dir_at(int parent_fd, const char *name, int *out, int *created) {\n    if (mkdirat(parent_fd, name, FCTP_PRIVATE_DIR_MODE) == 0) {\n        *created = 1;\n    } else {\n        if (errno != EEXIST) return 0;\n        *created = 0;\n    }\n    return fctp_open_private_dir_at(parent_fd, name, out);\n}\n\nstatic void fctp_scope_init(struct fctp_scope *scope) {\n    scope->mailbox_root = -1;\n    scope->witness_root = -1;\n    scope->mailbox = -1;\n    scope->witness = -1;\n}\n\nstatic void fctp_scope_close(struct fctp_scope *scope) {\n    fctp_close_fd(&scope->mailbox);\n    fctp_close_fd(&scope->witness);\n    fctp_close_fd(&scope->mailbox_root);\n    fctp_close_fd(&scope->witness_root);\n}\n\nstatic int fctp_open_scope(const char *exchange_id, int create, struct fctp_scope *scope, int *mailbox_created) {\n    int witness_created = 0;\n    fctp_scope_init(scope);\n    if (!fctp_open_private_root(FCTP_MAILBOX_ROOT, create, &scope->mailbox_root)) goto failed;\n    if (!fctp_open_private_root(FCTP_WITNESS_ROOT, create, &scope->witness_root)) goto failed;\n    if (create) {\n        if (!fctp_open_or_create_private_dir_at(scope->mailbox_root, exchange_id, &scope->mailbox, mailbox_created)) goto failed;\n        if (!fctp_open_or_create_private_dir_at(scope->witness_root, exchange_id, &scope->witness, &witness_created)) goto failed;\n    } else {\n        if (!fctp_open_private_dir_at(scope->mailbox_root, exchange_id, &scope->mailbox)) goto failed;\n        if (!fctp_open_private_dir_at(scope->witness_root, exchange_id, &scope->witness)) goto failed;\n        if (mailbox_created != 0) *mailbox_created = 0;\n    }\n    return 1;\nfailed:\n    fctp_scope_close(scope);\n    return 0;\n}\n\nstatic int fctp_leaf_state_at(int directory_fd, enum fctp_leaf leaf) {\n    const char *name = fctp_leaf_name(leaf);\n    struct stat st;\n    if (name == 0) return -1;\n    if (fstatat(directory_fd, name, &st, AT_SYMLINK_NOFOLLOW) < 0) return errno == ENOENT ? 0 : -1;\n    if (!S_ISREG(st.st_mode) || st.st_uid != geteuid() || (st.st_mode & 0777) != FCTP_PRIVATE_FILE_MODE) return -1;\n    return 1;\n}\n\nstatic int fctp_witness_leaf_state_at(int directory_fd, enum fctp_witness_leaf leaf) {\n    const char *name = fctp_witness_leaf_name(leaf);\n    struct stat st;\n    if (name == 0) return -1;\n    if (fstatat(directory_fd, name, &st, AT_SYMLINK_NOFOLLOW) < 0) return errno == ENOENT ? 0 : -1;\n    if (!S_ISREG(st.st_mode) || st.st_uid != geteuid() || (st.st_mode & 0777) != FCTP_PRIVATE_FILE_MODE) return -1;\n    return 1;\n}\n\nstatic int fctp_mailbox_has_only_closed_leaves(int mailbox_fd) {\n    int duplicate = dup(mailbox_fd);\n    DIR *directory;\n    int okay = 1;\n    if (duplicate < 0) return 0;\n    directory = fdopendir(duplicate);\n    if (directory == 0) { fctp_close_fd(&duplicate); return 0; }\n    for (;;) {\n        struct dirent *entry;\n        errno = 0;\n        entry = readdir(directory);\n        if (entry == 0) { if (errno != 0) okay = 0; break; }\n        if (strcmp(entry->d_name, \".\") == 0 || strcmp(entry->d_name, \"..\") == 0) continue;\n        if (fctp_leaf_of_name(entry->d_name) == 0) { okay = 0; break; }\n    }\n    if (closedir(directory) < 0) okay = 0;\n    return okay;\n}\n\nstatic int fctp_witness_has_only_closed_leaves(int witness_fd) {\n    int duplicate = dup(witness_fd);\n    DIR *directory;\n    int okay = 1;\n    if (duplicate < 0) return 0;\n    directory = fdopendir(duplicate);\n    if (directory == 0) { fctp_close_fd(&duplicate); return 0; }\n    for (;;) {\n        struct dirent *entry;\n        errno = 0;\n        entry = readdir(directory);\n        if (entry == 0) { if (errno != 0) okay = 0; break; }\n        if (strcmp(entry->d_name, \".\") == 0 || strcmp(entry->d_name, \"..\") == 0) continue;\n        if (fctp_witness_leaf_of_name(entry->d_name) == 0) { okay = 0; break; }\n    }\n    if (closedir(directory) < 0) okay = 0;\n    return okay;\n}\n\nstatic int fctp_write_all(int fd, const char *bytes, size_t count) {\n    size_t at = 0;\n    while (at < count) {\n        ssize_t wrote = write(fd, bytes + at, count - at);\n        if (wrote > 0) { at += (size_t)wrote; continue; }\n        if (wrote < 0 && errno == EINTR) continue;\n        return 0;\n    }\n    return 1;\n}\n\nstatic int fctp_write_new_leaf_at(int directory_fd, enum fctp_leaf leaf, const char *bytes, size_t count) {\n    const char *name = fctp_leaf_name(leaf);\n    int fd;\n    int okay = 1;\n    if (name == 0) return 0;\n    fd = openat(directory_fd, name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, FCTP_PRIVATE_FILE_MODE);\n    if (fd < 0) return 0;\n    if (fchmod(fd, FCTP_PRIVATE_FILE_MODE) < 0 || !fctp_secure_regular_fd(fd)) okay = 0;\n    if (okay && !fctp_write_all(fd, bytes, count)) okay = 0;\n    if (okay && fsync(fd) < 0) okay = 0;\n    if (!okay) (void)unlinkat(directory_fd, name, 0);\n    fctp_close_fd(&fd);\n    return okay;\n}\n\nstatic int fctp_remove_secure_leaf_at(int directory_fd, enum fctp_leaf leaf) {\n    const char *name = fctp_leaf_name(leaf);\n    int fd;\n    int okay;\n    if (name == 0) return 0;\n    fd = openat(directory_fd, name, O_RDONLY | O_NOFOLLOW);\n    if (fd < 0) return 0;\n    okay = fctp_secure_regular_fd(fd) && unlinkat(directory_fd, name, 0) == 0;\n    fctp_close_fd(&fd);\n    return okay;\n}\n\nstatic int fctp_remove_leaf_if_present_at(int directory_fd, enum fctp_leaf leaf) {\n    int state = fctp_leaf_state_at(directory_fd, leaf);\n    if (state == 0) return 1;\n    if (state < 0) return 0;\n    return fctp_remove_secure_leaf_at(directory_fd, leaf);\n}\n\nstatic int fctp_read_secure_leaf_at(int directory_fd, enum fctp_leaf leaf, char *out, size_t cap, size_t *used) {\n    const char *name = fctp_leaf_name(leaf);\n    int fd;\n    size_t at = 0;\n    if (cap == 0 || name == 0) return 0;\n    fd = openat(directory_fd, name, O_RDONLY | O_NOFOLLOW);\n    if (fd < 0 || !fctp_secure_regular_fd(fd)) { fctp_close_fd(&fd); return 0; }\n    for (;;) {\n        ssize_t got;\n        if (at == cap) { fctp_close_fd(&fd); return 0; }\n        got = read(fd, out + at, cap - at);\n        if (got > 0) { at += (size_t)got; continue; }\n        if (got == 0) break;\n        if (errno == EINTR) continue;\n        fctp_close_fd(&fd);\n        return 0;\n    }\n    fctp_close_fd(&fd);\n    *used = at;\n    return 1;\n}\n\nstatic int fctp_read_secure_witness_at(int directory_fd, enum fctp_witness_leaf leaf, char *out, size_t cap, size_t *used) {\n    const char *name = fctp_witness_leaf_name(leaf);\n    int fd;\n    size_t at = 0;\n    if (cap == 0 || name == 0) return 0;\n    fd = openat(directory_fd, name, O_RDONLY | O_NOFOLLOW);\n    if (fd < 0 || !fctp_secure_regular_fd(fd)) { fctp_close_fd(&fd); return 0; }\n    for (;;) {\n        ssize_t got;\n        if (at == cap) { fctp_close_fd(&fd); return 0; }\n        got = read(fd, out + at, cap - at);\n        if (got > 0) { at += (size_t)got; continue; }\n        if (got == 0) break;\n        if (errno == EINTR) continue;\n        fctp_close_fd(&fd);\n        return 0;\n    }\n    fctp_close_fd(&fd);\n    *used = at;\n    return 1;\n}\n\nstatic int fctp_publish_new_witness_at(int mailbox_fd, enum fctp_leaf source_leaf, int witness_fd, enum fctp_witness_leaf witness_leaf) {\n    const char *source_name = fctp_leaf_name(source_leaf);\n    const char *witness_name = fctp_witness_leaf_name(witness_leaf);\n    int source_fd;\n    int target_state;\n    int okay;\n    if (source_name == 0 || witness_name == 0) return 0;\n    source_fd = openat(mailbox_fd, source_name, O_RDONLY | O_NOFOLLOW);\n    if (source_fd < 0 || !fctp_secure_regular_fd(source_fd)) { fctp_close_fd(&source_fd); return 0; }\n    fctp_close_fd(&source_fd);\n    target_state = fctp_witness_leaf_state_at(witness_fd, witness_leaf);\n    if (target_state != 0) return 0;\n#if defined(FCTP_TEST_FAIL_PENDING_LINK) && FCTP_TEST_FAIL_PENDING_LINK\n    if (witness_leaf == FCTP_WITNESS_PENDING) { errno = EIO; return 0; }\n#endif\n    okay = linkat(mailbox_fd, source_name, witness_fd, witness_name, 0) == 0;\n    return okay;\n}\n\nstatic int fctp_remove_pending_witness_at(int witness_fd) {\n    const char *name = fctp_witness_leaf_name(FCTP_WITNESS_PENDING);\n    int fd;\n    int okay;\n    if (name == 0) return 0;\n    fd = openat(witness_fd, name, O_RDONLY | O_NOFOLLOW);\n    if (fd < 0 || !fctp_secure_regular_fd(fd)) { fctp_close_fd(&fd); return 0; }\n    okay = unlinkat(witness_fd, name, 0) == 0;\n    fctp_close_fd(&fd);\n    return okay;\n}\n\nstatic int fctp_pending_to_closed(const char *pending, size_t pending_count, char *closed, size_t closed_cap, size_t *closed_count) {\n    static const char pending_state[] = \"raw_state=closure-pending\\n\";\n    static const char closed_state[] = \"raw_state=closed\\n\";\n    size_t pending_state_count = sizeof(pending_state) - 1;\n    size_t closed_state_count = sizeof(closed_state) - 1;\n    size_t prefix_count;\n    if (pending_count < pending_state_count || pending_count - pending_state_count + closed_state_count > closed_cap) return 0;\n    prefix_count = pending_count - pending_state_count;\n    if (memcmp(pending + prefix_count, pending_state, pending_state_count) != 0) return 0;\n    memcpy(closed, pending, prefix_count);\n    memcpy(closed + prefix_count, closed_state, closed_state_count);\n    *closed_count = prefix_count + closed_state_count;\n    return 1;\n}\n\n")
    ; Compile-time-only harness fault injection.  It is absent from the normal
    ; carrier and has no runtime input: the temporary test build can force the
    ; *final* witness publication to fail after raw closure, proving pending
    ; receipt recovery without an external child or a timing race.
    (defn fctp-test-fault-hooks ()
        "#if defined(FCTP_TEST_FAIL_CLOSED_LINK) && FCTP_TEST_FAIL_CLOSED_LINK\nstatic int fctp_test_linkat(int olddirfd, const char *oldpath, int newdirfd, const char *newpath, int flags) {\n    if (strcmp(newpath, \"manifest.kv\") == 0) { errno = EIO; return -1; }\n    return linkat(olddirfd, oldpath, newdirfd, newpath, flags);\n}\n#define linkat fctp_test_linkat\n#endif\n\n")
    (defn fctp-fixture-child ()
        "static uint64_t fctp_fnv1a64(const char *bytes, size_t count) {\n    uint64_t value = UINT64_C(1469598103934665603);\n    size_t at;\n    for (at = 0; at < count; at += 1) {\n        value ^= (unsigned char)bytes[at];\n        value *= UINT64_C(1099511628211);\n    }\n    return value;\n}\n\nstatic int fctp_fixture_child(char *out, size_t cap, size_t *used) {\n    static const char response[] = \"FORM_CLOSED_TURN_FIXTURE_RESPONSE\\n\";\n    int stream[2] = { -1, -1 };\n    pid_t child;\n    int status = 125;\n    size_t at = 0;\n    if (sizeof(response) - 1 > cap || pipe(stream) < 0) return 0;\n    child = fork();\n    if (child < 0) { fctp_close_fd(&stream[0]); fctp_close_fd(&stream[1]); return 0; }\n    if (child == 0) {\n        int okay;\n        fctp_close_fd(&stream[0]);\n        okay = fctp_write_all(stream[1], response, sizeof(response) - 1);\n        fctp_close_fd(&stream[1]);\n        _exit(okay ? 0 : 125);\n    }\n    fctp_close_fd(&stream[1]);\n    for (;;) {\n        ssize_t got;\n        if (at == cap) { fctp_close_fd(&stream[0]); return 0; }\n        got = read(stream[0], out + at, cap - at);\n        if (got > 0) { at += (size_t)got; continue; }\n        if (got == 0) break;\n        if (errno == EINTR) continue;\n        fctp_close_fd(&stream[0]);\n        return 0;\n    }\n    fctp_close_fd(&stream[0]);\n    while (waitpid(child, &status, 0) < 0 && errno == EINTR) { }\n    if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) return 0;\n    *used = at;\n    return 1;\n}\n\n")
    (defn fctp-operations ()
        "static int fctp_open_exchange(const char *exchange_id, int *created) {\n    struct fctp_scope scope;\n    static const char prompt[] = \"FORM_CLOSED_TURN_FIXTURE_PROMPT\\n\";\n    int okay = 0;\n    if (!fctp_open_scope(exchange_id, 1, &scope, created)) return 0;\n    if (!fctp_mailbox_has_only_closed_leaves(scope.mailbox) || !fctp_witness_has_only_closed_leaves(scope.witness)) goto done;\n    if (*created) {\n        if (!fctp_write_new_leaf_at(scope.mailbox, FCTP_PROMPT_RAW, prompt, sizeof(prompt) - 1)) goto done;\n    } else if (fctp_leaf_state_at(scope.mailbox, FCTP_PROMPT_RAW) != 1) {\n        goto done;\n    }\n    okay = 1;\ndone:\n    fctp_scope_close(&scope);\n    return okay;\n}\n\nstatic int fctp_native_capability_exchange(const char *exchange_id) {\n    struct fctp_scope scope;\n    static const char stage[] = \"schema=closed-typed-turn-port-fixture-v1\\ncapability_stage=native-pending-discovery\\ndecision=diagnostic-refusal-no-native-attestation\\nraw_state=private\\n\";\n    int state;\n    int result = 0;\n    if (!fctp_open_scope(exchange_id, 0, &scope, 0)) return 0;\n    if (!fctp_mailbox_has_only_closed_leaves(scope.mailbox) || !fctp_witness_has_only_closed_leaves(scope.witness)) goto done;\n    if (fctp_leaf_state_at(scope.mailbox, FCTP_PROMPT_RAW) != 1) goto done;\n    if (fctp_leaf_state_at(scope.mailbox, FCTP_RESPONSE_RAW) != 0 || fctp_leaf_state_at(scope.mailbox, FCTP_RUN_STAGE) != 0) goto done;\n    if (fctp_leaf_state_at(scope.mailbox, FCTP_SEAL_PENDING_TEMP) != 0 || fctp_leaf_state_at(scope.mailbox, FCTP_SEAL_CLOSED_TEMP) != 0) goto done;\n    if (fctp_witness_leaf_state_at(scope.witness, FCTP_WITNESS_PENDING) != 0 || fctp_witness_leaf_state_at(scope.witness, FCTP_WITNESS_CLOSED) != 0) goto done;\n    state = fctp_leaf_state_at(scope.mailbox, FCTP_NATIVE_CAPABILITY_STAGE);\n    if (state < 0) goto done;\n    if (state == 1) { result = 2; goto done; }\n    result = fctp_write_new_leaf_at(scope.mailbox, FCTP_NATIVE_CAPABILITY_STAGE, stage, sizeof(stage) - 1) ? 1 : 0;\ndone:\n    fctp_scope_close(&scope);\n    return result;\n}\n\nstatic int fctp_run_exchange(const char *exchange_id) {\n    struct fctp_scope scope;\n    char response[FCTP_RAW_LIMIT];\n    char stage[256];\n    size_t used = 0;\n    uint64_t response_hash;\n    int stage_len;\n    int result = 0;\n    if (!fctp_open_scope(exchange_id, 0, &scope, 0)) return 0;\n    if (!fctp_mailbox_has_only_closed_leaves(scope.mailbox) || !fctp_witness_has_only_closed_leaves(scope.witness)) goto done;\n    if (fctp_leaf_state_at(scope.mailbox, FCTP_PROMPT_RAW) != 1) goto done;\n    if (fctp_leaf_state_at(scope.mailbox, FCTP_NATIVE_CAPABILITY_STAGE) != 1) goto done;\n    if (fctp_leaf_state_at(scope.mailbox, FCTP_RESPONSE_RAW) != 0 || fctp_leaf_state_at(scope.mailbox, FCTP_RUN_STAGE) != 0) { result = 2; goto done; }\n    if (fctp_leaf_state_at(scope.mailbox, FCTP_SEAL_PENDING_TEMP) != 0 || fctp_leaf_state_at(scope.mailbox, FCTP_SEAL_CLOSED_TEMP) != 0) goto done;\n    if (fctp_witness_leaf_state_at(scope.witness, FCTP_WITNESS_PENDING) != 0 || fctp_witness_leaf_state_at(scope.witness, FCTP_WITNESS_CLOSED) != 0) goto done;\n    if (!fctp_fixture_child(response, sizeof(response), &used)) goto done;\n    response_hash = fctp_fnv1a64(response, used);\n    if (!fctp_write_new_leaf_at(scope.mailbox, FCTP_RESPONSE_RAW, response, used)) goto done;\n    stage_len = snprintf(stage, sizeof(stage), \"schema=%s\\noperation=run\\nfixture_child=deterministic-no-network\\nexit_code=0\\nresponse_bytes=%zu\\nresponse_fnv1a64=%016\" PRIx64 \"\\nraw_state=private\\n\", FCTP_SCHEMA, used, response_hash);\n    if (stage_len < 0 || (size_t)stage_len >= sizeof(stage) || !fctp_write_new_leaf_at(scope.mailbox, FCTP_RUN_STAGE, stage, (size_t)stage_len)) goto done;\n    result = 1;\ndone:\n    fctp_scope_close(&scope);\n    return result;\n}\n\nstatic int fctp_publish_pending_witness(struct fctp_scope *scope, const char *exchange_id, char *pending, size_t pending_cap, size_t *pending_count) {\n    char response[FCTP_RAW_LIMIT];\n    size_t response_count = 0;\n    uint64_t response_hash;\n    int pending_len;\n    if (!fctp_read_secure_leaf_at(scope->mailbox, FCTP_RESPONSE_RAW, response, sizeof(response), &response_count)) return 0;\n    response_hash = fctp_fnv1a64(response, response_count);\n    pending_len = snprintf(pending, pending_cap, \"schema=%s\\nexchange_id=%s\\noperation=seal\\nfixture_child=deterministic-no-network\\nresponse_bytes=%zu\\nresponse_fnv1a64=%016\" PRIx64 \"\\nraw_state=closure-pending\\n\", FCTP_SCHEMA, exchange_id, response_count, response_hash);\n    if (pending_len < 0 || (size_t)pending_len >= pending_cap) return 0;\n    if (!fctp_write_new_leaf_at(scope->mailbox, FCTP_SEAL_PENDING_TEMP, pending, (size_t)pending_len)) return 0;\n    if (!fctp_publish_new_witness_at(scope->mailbox, FCTP_SEAL_PENDING_TEMP, scope->witness, FCTP_WITNESS_PENDING)) {\n        (void)fctp_remove_leaf_if_present_at(scope->mailbox, FCTP_SEAL_PENDING_TEMP);\n        return 0;\n    }\n    *pending_count = (size_t)pending_len;\n    return fctp_remove_secure_leaf_at(scope->mailbox, FCTP_SEAL_PENDING_TEMP) ? 1 : 2;\n}\n\nstatic int fctp_seal_exchange(const char *exchange_id) {\n    struct fctp_scope scope;\n    char pending[FCTP_WITNESS_LIMIT];\n    char closed[FCTP_WITNESS_LIMIT];\n    size_t pending_count = 0;\n    size_t closed_count = 0;\n    int prompt_state;\n    int response_state;\n    int run_state;\n    int native_capability_state;\n    int pending_state;\n    int closed_state;\n    int temporary_state;\n    int result = 0;\n    if (!fctp_open_scope(exchange_id, 0, &scope, 0)) return 0;\n    if (!fctp_mailbox_has_only_closed_leaves(scope.mailbox) || !fctp_witness_has_only_closed_leaves(scope.witness)) goto done;\n    prompt_state = fctp_leaf_state_at(scope.mailbox, FCTP_PROMPT_RAW);\n    response_state = fctp_leaf_state_at(scope.mailbox, FCTP_RESPONSE_RAW);\n    run_state = fctp_leaf_state_at(scope.mailbox, FCTP_RUN_STAGE);\n    native_capability_state = fctp_leaf_state_at(scope.mailbox, FCTP_NATIVE_CAPABILITY_STAGE);\n    pending_state = fctp_witness_leaf_state_at(scope.witness, FCTP_WITNESS_PENDING);\n    closed_state = fctp_witness_leaf_state_at(scope.witness, FCTP_WITNESS_CLOSED);\n    if (prompt_state < 0 || response_state < 0 || run_state != 1 || native_capability_state != 1 || pending_state < 0 || closed_state < 0) goto done;\n    if (closed_state == 1) {\n        result = prompt_state == 0 && response_state == 0 ? 3 : 0;\n        goto done;\n    }\n    temporary_state = fctp_leaf_state_at(scope.mailbox, FCTP_SEAL_PENDING_TEMP);\n    if (temporary_state < 0) goto done;\n    if (pending_state == 0) {\n        if (prompt_state != 1 || response_state != 1 || temporary_state != 0 || fctp_leaf_state_at(scope.mailbox, FCTP_SEAL_CLOSED_TEMP) != 0) { result = 2; goto done; }\n        result = fctp_publish_pending_witness(&scope, exchange_id, pending, sizeof(pending), &pending_count);\n        if (result == 0) { result = 5; goto done; }\n        if (result == 2) { result = 4; goto done; }\n    } else {\n        if (temporary_state == 1 && !fctp_remove_secure_leaf_at(scope.mailbox, FCTP_SEAL_PENDING_TEMP)) { result = 4; goto done; }\n        if (temporary_state != 0 && temporary_state != 1) goto done;\n        if (!fctp_read_secure_witness_at(scope.witness, FCTP_WITNESS_PENDING, pending, sizeof(pending), &pending_count)) { result = 4; goto done; }\n    }\n    prompt_state = fctp_leaf_state_at(scope.mailbox, FCTP_PROMPT_RAW);\n    response_state = fctp_leaf_state_at(scope.mailbox, FCTP_RESPONSE_RAW);\n    if (prompt_state < 0 || response_state < 0) { result = 4; goto done; }\n    if (prompt_state == 1 && !fctp_remove_secure_leaf_at(scope.mailbox, FCTP_PROMPT_RAW)) { result = 4; goto done; }\n    if (response_state == 1 && !fctp_remove_secure_leaf_at(scope.mailbox, FCTP_RESPONSE_RAW)) { result = 4; goto done; }\n    if (fctp_leaf_state_at(scope.mailbox, FCTP_PROMPT_RAW) != 0 || fctp_leaf_state_at(scope.mailbox, FCTP_RESPONSE_RAW) != 0) { result = 4; goto done; }\n    if (!fctp_pending_to_closed(pending, pending_count, closed, sizeof(closed), &closed_count)) { result = 4; goto done; }\n    temporary_state = fctp_leaf_state_at(scope.mailbox, FCTP_SEAL_CLOSED_TEMP);\n    if (temporary_state == 1 && !fctp_remove_secure_leaf_at(scope.mailbox, FCTP_SEAL_CLOSED_TEMP)) { result = 4; goto done; }\n    if (temporary_state < 0) { result = 4; goto done; }\n    if (!fctp_write_new_leaf_at(scope.mailbox, FCTP_SEAL_CLOSED_TEMP, closed, closed_count)) { result = 4; goto done; }\n    if (!fctp_publish_new_witness_at(scope.mailbox, FCTP_SEAL_CLOSED_TEMP, scope.witness, FCTP_WITNESS_CLOSED)) {\n        (void)fctp_remove_leaf_if_present_at(scope.mailbox, FCTP_SEAL_CLOSED_TEMP);\n        result = 4;\n        goto done;\n    }\n    if (!fctp_remove_secure_leaf_at(scope.mailbox, FCTP_SEAL_CLOSED_TEMP)) { result = 6; goto done; }\n    if (!fctp_remove_pending_witness_at(scope.witness)) { result = 6; goto done; }\n    result = 1;\ndone:\n    fctp_scope_close(&scope);\n    return result;\n}\n\nstatic int fctp_discard_exchange(const char *exchange_id, int *absent) {\n    struct fctp_scope scope;\n    enum fctp_leaf leaf;\n    int result = 0;\n    *absent = 0;\n    if (!fctp_open_scope(exchange_id, 0, &scope, 0)) return 0;\n    if (!fctp_mailbox_has_only_closed_leaves(scope.mailbox) || !fctp_witness_has_only_closed_leaves(scope.witness)) goto done;\n    for (leaf = FCTP_PROMPT_RAW; leaf <= FCTP_SEAL_CLOSED_TEMP; leaf += 1) {\n        if (!fctp_remove_leaf_if_present_at(scope.mailbox, leaf)) goto done;\n    }\n    result = unlinkat(scope.mailbox_root, exchange_id, AT_REMOVEDIR) == 0;\ndone:\n    fctp_scope_close(&scope);\n    return result;\n}\n\n")
    ; The emitted-table fixture links this narrow ABI as a separate Form-emitted
    ; translation unit.  It accepts bytes plus explicit lengths from the table
    ; walker—never an argv string and never `fk_cstr`—then returns only one
    ; fixed content-blind token.  The lifecycle helpers above remain private to
    ; this unit; neither this ABI nor the standalone fixture accepts a command,
    ; path, model, prompt, response, environment, or network target.
    (defn fctp-emitted-dispatch ()
        "static int fctp_emitted_token(const char **out, unsigned long *out_len, const char *text, unsigned long text_len) {\n    if (out == 0 || out_len == 0) return 0;\n    *out = text;\n    *out_len = text_len;\n    return 1;\n}\n\nint fctp_emitted_dispatch(const char *stage_bytes, unsigned long stage_length, const char *exchange_id_bytes, unsigned long exchange_id_length, const char **out_token, unsigned long *out_token_length) {\n    static const char refused[] = \"fctp-port-refused\";\n    static const char open_ok[] = \"fctp-opened-private\";\n    static const char open_existing[] = \"fctp-opened-existing\";\n    static const char native_capability_pending[] = \"fctp-native-capability-pending-discovery\";\n    static const char native_capability_repeat[] = \"fctp-native-capability-already-recorded\";\n    static const char run_ok[] = \"fctp-run-deterministic-complete\";\n    static const char run_repeat[] = \"fctp-run-already-recorded\";\n    static const char seal_ok[] = \"fctp-seal-closed\";\n    static const char seal_closed[] = \"fctp-seal-already-closed\";\n    static const char seal_pending[] = \"fctp-seal-pending-retry\";\n    static const char discard_ok[] = \"fctp-discarded-private\";\n    char exchange_id[65];\n    int lifecycle_stage = 0;\n    int result;\n    int created = 0;\n    int absent = 0;\n    if (out_token == 0 || out_token_length == 0) return 0;\n    if (stage_bytes == 0 || exchange_id_bytes == 0 || exchange_id_length != 64) return fctp_emitted_token(out_token, out_token_length, refused, sizeof(refused) - 1);\n    if (stage_length == 4 && memcmp(stage_bytes, \"open\", 4) == 0) lifecycle_stage = FCTP_STAGE_OPEN;\n    else if (stage_length == 17 && memcmp(stage_bytes, \"native-capability\", 17) == 0) lifecycle_stage = FCTP_STAGE_NATIVE_CAPABILITY;\n    else if (stage_length == 3 && memcmp(stage_bytes, \"run\", 3) == 0) lifecycle_stage = FCTP_STAGE_RUN;\n    else if (stage_length == 4 && memcmp(stage_bytes, \"seal\", 4) == 0) lifecycle_stage = FCTP_STAGE_SEAL;\n    else if (stage_length == 7 && memcmp(stage_bytes, \"discard\", 7) == 0) lifecycle_stage = FCTP_STAGE_DISCARD;\n    if (lifecycle_stage == 0) return fctp_emitted_token(out_token, out_token_length, refused, sizeof(refused) - 1);\n    memcpy(exchange_id, exchange_id_bytes, 64);\n    exchange_id[64] = 0;\n    if (!fctp_exchange_id_ok(exchange_id)) return fctp_emitted_token(out_token, out_token_length, refused, sizeof(refused) - 1);\n    if (lifecycle_stage == FCTP_STAGE_OPEN) {\n        if (!fctp_open_exchange(exchange_id, &created)) return fctp_emitted_token(out_token, out_token_length, refused, sizeof(refused) - 1);\n        return created ? fctp_emitted_token(out_token, out_token_length, open_ok, sizeof(open_ok) - 1) : fctp_emitted_token(out_token, out_token_length, open_existing, sizeof(open_existing) - 1);\n    }\n    if (lifecycle_stage == FCTP_STAGE_NATIVE_CAPABILITY) {\n        result = fctp_native_capability_exchange(exchange_id);\n        if (result == 0) return fctp_emitted_token(out_token, out_token_length, refused, sizeof(refused) - 1);\n        return result == 1 ? fctp_emitted_token(out_token, out_token_length, native_capability_pending, sizeof(native_capability_pending) - 1) : fctp_emitted_token(out_token, out_token_length, native_capability_repeat, sizeof(native_capability_repeat) - 1);\n    }\n    if (lifecycle_stage == FCTP_STAGE_RUN) {\n        result = fctp_run_exchange(exchange_id);\n        if (result == 0) return fctp_emitted_token(out_token, out_token_length, refused, sizeof(refused) - 1);\n        return result == 1 ? fctp_emitted_token(out_token, out_token_length, run_ok, sizeof(run_ok) - 1) : fctp_emitted_token(out_token, out_token_length, run_repeat, sizeof(run_repeat) - 1);\n    }\n    if (lifecycle_stage == FCTP_STAGE_SEAL) {\n        result = fctp_seal_exchange(exchange_id);\n        if (result == 1 || result == 6) return fctp_emitted_token(out_token, out_token_length, seal_ok, sizeof(seal_ok) - 1);\n        if (result == 3) return fctp_emitted_token(out_token, out_token_length, seal_closed, sizeof(seal_closed) - 1);\n        if (result == 4 || result == 5) return fctp_emitted_token(out_token, out_token_length, seal_pending, sizeof(seal_pending) - 1);\n        return fctp_emitted_token(out_token, out_token_length, refused, sizeof(refused) - 1);\n    }\n    result = fctp_discard_exchange(exchange_id, &absent);\n    if (!result) return fctp_emitted_token(out_token, out_token_length, refused, sizeof(refused) - 1);\n    return fctp_emitted_token(out_token, out_token_length, discard_ok, sizeof(discard_ok) - 1);\n}\n\n\n")
    (defn fctp-library-emit ()
        (str_concat (fctp-feature-macros)
        (str_concat (fctp-headers)
        (str_concat (fctp-library-shape)
        (str_concat (fctp-test-fault-hooks)
        (str_concat (fctp-private-filesystem)
        (str_concat (fctp-fixture-child)
        (str_concat (fctp-operations) (fctp-emitted-dispatch)))))))))
    (defn fctp-main ()
        "int main(int argc, char **argv) {\n    int operation;\n    const char *exchange_id;\n    int result;\n    int created = 0;\n    int absent = 0;\n\n    if (argc != 3) {\n        fctp_token(\"\", \"\", \"refused-closed-argv\", \"none\");\n        return 64;\n    }\n    operation = fctp_operation_of(argv[1]);\n    if (operation == 0) {\n        fctp_token(\"\", \"\", \"refused-invalid-operation\", \"none\");\n        return 64;\n    }\n    exchange_id = argv[2];\n    if (!fctp_exchange_id_ok(exchange_id)) {\n        fctp_token(fctp_operation_name(operation), \"\", \"refused-invalid-exchange-id\", \"none\");\n        return 64;\n    }\n\n    if (operation == FCTP_OPEN) {\n        if (!fctp_open_exchange(exchange_id, &created)) {\n            fctp_token(\"open\", exchange_id, \"refused-unsafe-mailbox-or-witness\", \"unknown\");\n            return 77;\n        }\n        result = fctp_native_capability_exchange(exchange_id);\n        if (result == 0) {\n            fctp_token(\"open\", exchange_id, \"refused-native-capability-stage\", \"unknown\");\n            return 77;\n        }\n        fctp_token(\"open\", exchange_id, created ? \"opened-private-mailbox\" : \"opened-existing-private-mailbox\", \"private\");\n        return 0;\n    }\n    if (operation == FCTP_RUN) {\n        result = fctp_run_exchange(exchange_id);\n        if (result == 0) {\n            fctp_token(\"run\", exchange_id, \"refused-unsafe-or-unopened-mailbox\", \"unknown\");\n            return 77;\n        }\n        if (result == 2) {\n            fctp_token(\"run\", exchange_id, \"refused-run-already-recorded\", \"private\");\n            return 73;\n        }\n        fctp_token(\"run\", exchange_id, \"fixture-run-complete\", \"private\");\n        return 0;\n    }\n    if (operation == FCTP_SEAL) {\n        result = fctp_seal_exchange(exchange_id);\n        if (result == 0) {\n            fctp_token(\"seal\", exchange_id, \"refused-unsafe-or-unpublishable-witness\", \"unknown\");\n            return 77;\n        }\n        if (result == 2) {\n            fctp_token(\"seal\", exchange_id, \"refused-missing-private-response\", \"private\");\n            return 73;\n        }\n        if (result == 3) {\n            fctp_token(\"seal\", exchange_id, \"sealed-already-closed\", \"closed\");\n            return 0;\n        }\n        if (result == 4) {\n            fctp_token(\"seal\", exchange_id, \"closure-pending-retry-required\", \"closure-pending\");\n            return 75;\n        }\n        if (result == 5) {\n            fctp_token(\"seal\", exchange_id, \"refused-pending-publication-raw-retained\", \"private\");\n            return 75;\n        }\n        if (result == 6) {\n            fctp_token(\"seal\", exchange_id, \"sealed-raw-closed-pending-retained\", \"closed\");\n            return 0;\n        }\n        fctp_token(\"seal\", exchange_id, \"sealed-raw-closed\", \"closed\");\n        return 0;\n    }\n    result = fctp_discard_exchange(exchange_id, &absent);\n    if (!result) {\n        fctp_token(\"discard\", exchange_id, \"refused-unsafe-or-nonempty-mailbox\", \"unknown\");\n        return 77;\n    }\n    fctp_token(\"discard\", exchange_id, absent ? \"discarded-absent-mailbox\" : \"discarded-private-mailbox\", \"closed\");\n    return 0;\n}\n\n")
    (defn fctp-emit ()
        (str_concat (fctp-library-emit)
        (str_concat (fctp-cli-operation-parser)
        (str_concat (fctp-cli-render-support) (fctp-main)))))
    (fctp-emit))
