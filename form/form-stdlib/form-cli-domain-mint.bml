//////////////////////////////////////////////////////////////////////
//
// form-cli-domain-mint.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-domain-mint.bml
//
// Mints Form-native rows from living domain cells. A domain word
// enters only if the 64 can say it. Cross-lane resonance is named
// as resonance, never as empirical identity.
//
// Proven by: form-stdlib/tests/form-cli-domain-mint-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SampleRow<TClass> {
        member split: String;
        member className: TClass;
        member situation: String;
        member sourceId: Object;
        member lessonId: Object;
        member transformId: Object;
    }

    class FormDomainMintAuthority {
        field MintAuthorityPath = "form/form-stdlib/bml/form-cli-domain-mint.bml";
        field MintAuthorityKind = "high-bml-class-template-field";
    }

    class FormDomainMint<T> {
        field MixA = 7;
        field MixB = 13;
        field NSkills = 12;
        field LoraWriter = 0;
        field SplitTrain = "train";
        field SplitHeldout = "heldout";

        ref fdm-authority = FormDomainMintAuthority;
        thought fdm-pattern = list("mint", "lesson-lineage", "source-overlap-visible", "overlay-fit", "lora-waits");
        thought fdm-skills = list("assemblage", "human-design", "gene-keys", "astrology", "physics", "chemistry", "biology", "quantum", "math", "logic", "shape-match", "time-direction");
        thought fdm-contexts = list("core lexicon", "guidance channel", "ephemeris stack", "rave mandala", "assemblage switch", "nearest-shape", "cross-domain lane", "offer-ack core");
        thought fdm-sources = list("form/form-stdlib/assemblage-point.fk", "form/form-stdlib/hd-mandala-wheel.fk", "form/form-stdlib/genekey-profile.fk", "form/form-stdlib/zodiac-channel.fk", "form/form-stdlib/core-lexicon-domains.fk", "form/form-stdlib/field-model-form.fk", "form/form-stdlib/backward-chaining.fk", "form/form-stdlib/nearest-shape.fk", "form/form-stdlib/celestial-pole-channel.fk", "form/form-stdlib/cross-domain-cornerstone.fk", "control/pattern-match.fk", "form/form-stdlib/guidance-channel.fk");

        def fdm-mix(i, n) = (((i * MixA()) + MixB()) % n);

        def fdm-assemblage-stems() = list("the assemblage point is the frame where perception locks reality into one shape", "the highest-success move and the most-alive move are not always the same", "learning which branch happens inside a point learning to move the point finds a move the current frame cannot see", "switch the frame by aliveness not by optimizing the branch by success");
        def fdm-hd-stems() = list("the rave mandala places 64 gates around the zodiac a date becomes a gate", "type is a kind of self authority is the way a self knows what to do", "gate 41 at 302 degrees is the Human Design New Year the canonical anchor", "Human Design gate and Gene Key and I Ching hexagram that share an address are one cell");
        def fdm-gk-stems() = list("shadow is when a self is less than it is gift is when a self gives what it is", "siddhi is when a self is same as all", "the hologenetic profile casts eleven spheres from a birth-moment", "the design moment is the sky about 88 days before birth");
        def fdm-astro-stems() = list("one sky two astrologies tropical and sidereal differ by the ayanamsa", "Aries and Mesha are one sign wearing two tongues they share an address", "sign house aspect transit are sayable from the 64 not imported jargon", "computable recipes are empirical names are documented tradition never cosmology");
        def fdm-physics-stems() = list("force is what make a thing do energy is what a thing have to do", "wave is when a thing do same again and again", "field is where a force is at all here and there", "resonance within empirical lanes is empirical-grade cross-lane is structural only");
        def fdm-chem-stems() = list("element is a kind of thing that is not many kind", "reaction is when many thing do and after are other", "bond is when many thing hold as one whole", "bond sits at depth 3 because holding needed giving first");
        def fdm-bio-stems() = list("life is when a thing do and make other like it", "grow is when a thing be more than it was before", "sense is when a self know what is out of it", "Levin bioelectric lens tissue state is voltage-pattern memory");
        def fdm-quantum-stems() = list("field-model-form models an LHY-stabilized self-bound droplet as domain data", "quantum vocabulary used as authority without a mechanism offered is a borrow not a proof", "the observer-effect borrow is named as borrow measurement disturbs the record", "computable astronomy stays empirical quantum names stay in their lane");
        def fdm-math-stems() = list("number is how many thing are set is many thing we know as one whole", "function is a way from one thing to other thing", "proof is a way to know whether a thing is 1", "angle sits deepest because it needs line which needs point");
        def fdm-logic-stems() = list("backward-chaining pulls from a goal forward-chaining pushes from axioms", "two engines one truth over the same facts and rules", "cyclic rules cannot loop forever because fuel decrements", "pattern-match is structural match by shape ctor and arity no-match is nothing");
        def fdm-shape-stems() = list("nearest-shape counts agreeing bins no subtraction no distance no float", "a prototype is a substrate cell its Blueprint NodeID is its vector shape", "learning is adding a prototype no weights no training loop", "pattern-match offers a cell to data clauses the first matching shape acknowledges");
        def fdm-time-stems() = list("when is computable a clock answers it exactly with zero learning", "Julian Day Number is the spine of every ephemeris", "the north star moves Thuban held it Polaris holds it Vega will", "timeout is nothing counted time-direction is the sky not the budget");

        def fdm-stems(class) = if ((String) class == "assemblage") then fdm-assemblage-stems() else if ((String) class == "human-design") then fdm-hd-stems() else if ((String) class == "gene-keys") then fdm-gk-stems() else if ((String) class == "astrology") then fdm-astro-stems() else if ((String) class == "physics") then fdm-physics-stems() else if ((String) class == "chemistry") then fdm-chem-stems() else if ((String) class == "biology") then fdm-bio-stems() else if ((String) class == "quantum") then fdm-quantum-stems() else if ((String) class == "math") then fdm-math-stems() else if ((String) class == "logic") then fdm-logic-stems() else if ((String) class == "shape-match") then fdm-shape-stems() else fdm-time-stems();

        def fdm-prefix(split) = if ((String) split == SplitTrain()) then "Observed " else "Boundary: observed ";

        def fdm-source-id() = fmls-source-id(str_concat(MintAuthorityPath(), "#lesson-lineage-v1"));

        def fdm-lesson-id(class, i) {
            let stems = fdm-stems(class);
            let stem = nth(stems, fdm-mix(i, len(stems)));
            fmls-lesson-id(str_concat(MintAuthorityPath(), "#lesson-lineage-v1"), class, stem);
        }

        def fdm-transform-id(class, i, split) {
            let ctxs = fdm-contexts();
            let ctx = nth(ctxs, fdm-mix(i, len(ctxs)));
            fmls-transform-id(split, ctx, fdm-prefix(split), i);
        }

        def fdm-situation(class, i, split) {
            let ctxs = fdm-contexts();
            let stems = fdm-stems(class);
            let ctx = nth(ctxs, fdm-mix(i, len(ctxs)));
            let stem = nth(stems, fdm-mix(i, len(stems)));
            str_concat(fdm-prefix(split), str_concat(ctx, str_concat(" ", str_concat(stem, str_concat(" case ", int_to_str(i))))));
        }

        def fdm-row(class, i, split) = fmls-row(split, class, fdm-situation(class, i, split), fdm-source-id(), fdm-lesson-id(class, i), fdm-transform-id(class, i, split));

        def fdm-class-rows(class, i, n, split, acc) = if ((Comparable) i == n) then acc else fdm-class-rows(class, (i + 1), n, split, cons(fdm-row(class, i, split), acc));

        def fdm-all-classes(names, tn, hn, acc) = if ((Comparable) len(names) == 0) then acc else fdm-all-classes(tail(names), tn, hn, fdm-class-rows(head(names), tn, (tn + hn), SplitHeldout(), fdm-class-rows(head(names), 0, tn, SplitTrain(), acc)));

        def fdm-corpus(tn, hn) = fdm-all-classes(fdm-skills(), tn, hn, tail(list("x")));

        def fdm-n(tn, hn) = (NSkills() * (tn + hn));

        def fdm-has-situation(rows, s) = if ((Comparable) len(rows) == 0) then 0 else if ((String) nth(head(rows), 2) == s) then 1 else fdm-has-situation(tail(rows), s);

        def fdm-train-only(rows, acc) = if ((Comparable) len(rows) == 0) then acc else if ((String) nth(head(rows), 0) == SplitTrain()) then fdm-train-only(tail(rows), cons(head(rows), acc)) else fdm-train-only(tail(rows), acc);

        def fdm-leakage-loop(all, rows) = if ((Comparable) len(rows) == 0) then 0 else ((if ((String) nth(head(rows), 0) == SplitHeldout()) then fdm-has-situation(fdm-train-only(all, tail(list("x"))), nth(head(rows), 2)) else 0) + fdm-leakage-loop(all, tail(rows)));

        def fdm-leakage(rows) = fdm-leakage-loop(rows, rows);

        def fdm-lesson-leakage(rows) = len(fmls-lesson-intersection(rows, SplitTrain(), SplitHeldout()));

        def fdm-lineage-signal(rows) = fmls-lesson-signal(rows, SplitTrain(), SplitHeldout());

        def fdm-unique-loop(rows, seen) = if ((Comparable) len(rows) == 0) then len(seen) else if ((Comparable) fdm-has-situation(seen, nth(head(rows), 2)) == 1) then fdm-unique-loop(tail(rows), seen) else fdm-unique-loop(tail(rows), cons(head(rows), seen));

        def fdm-unique(rows) = fdm-unique-loop(rows, tail(list("x")));

        def fdm-count-split(rows, split) = if ((Comparable) len(rows) == 0) then 0 else ((if ((String) nth(head(rows), 0) == split) then 1 else 0) + fdm-count-split(tail(rows), split));

        def fdm-lora-writer() = LoraWriter();

        def fdm-mix-diverse() = if ((Comparable) fdm-mix(0, 8) == fdm-mix(1, 8)) then 0 else 1;

        def fdm-predict(models, names, s) = nth(names, fqt-predict-index(models, s));

        def fdm-heldout-hit(models, names, row) = if ((String) nth(row, 0) == SplitHeldout()) then if ((String) fdm-predict(models, names, nth(row, 2)) == nth(row, 1)) then 1 else 0 else 0;

        def fdm-heldout-correct-loop(models, names, rows) = if ((Comparable) len(rows) == 0) then 0 else (fdm-heldout-hit(models, names, head(rows)) + fdm-heldout-correct-loop(models, names, tail(rows)));

        def fdm-heldout-correct(rows) {
            let names = fdm-skills();
            let models = fqt-fit(rows, names);
            fdm-heldout-correct-loop(models, names, rows);
        }

        def fdm-bit(ok, bit) = if ok then bit else 0;

        def fdm-check() {
            let rows = fdm-corpus(3, 1);
            let n = fdm-n(3, 1);
            let correct = fdm-heldout-correct(rows);
            let c0 = fdm-bit(((Comparable) n == 48), 1);
            let c1 = fdm-bit(((Comparable) fdm-mix-diverse() == 1), 2);
            let c2 = fdm-bit((((Comparable) fdm-leakage(rows) == 0) && ((Comparable) fdm-lesson-leakage(rows) == 0)), 4);
            let c3 = fdm-bit(((Comparable) fdm-unique(rows) == n), 8);
            let c4 = fdm-bit((((Comparable) fdm-count-split(rows, SplitTrain()) == 36) && ((Comparable) fdm-count-split(rows, SplitHeldout()) == 12)), 16);
            let c5 = fdm-bit((correct >= 9), 32);
            let c6 = fdm-bit(((Comparable) fdm-lora-writer() == 0), 64);
            let c7 = fdm-bit(((Comparable) fdm-n(5, 2) == 84), 128);
            (c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + c7)))))));
        }
    }
    0;
}
