; form-cli-crystallize.fk — new knowledge becomes ice, or it does not enter.
;
; Yes asked to show that we crystallize new knowledge. The doors already
; sit: knowledge-ingest (deep + fear-free freezes), name-build-observe
; (named + attempted + observed enters as a claim). This cell is the
; joint: a row may freeze only when both doors say so. Then a ledger
; holds it, and recall finds it. That is crystallization, shown.
;
; The new knowledge this sitting froze: anyone-door. Only ChatGPT is a
; free talk client. Cursor, Codex, Claude, Grok, Gemini have no free
; client. form-cli is the free body.
;
; Ice = 2. Liquid = 1. Compost = 0. Same numbers as ki-ingest.
;
; preludes: form-stdlib/core.fk form-stdlib/knowledge-ingest.fk ingest/name-build-observe.fk
; Proven by: form-stdlib/tests/form-cli-crystallize-band.fk
; witnessed: 2026-08-19 -> 1023

(do
    (defn fcx-ice () 2)
    (defn fcx-liquid () 1)
    (defn fcx-compost () 0)

    (defn fcx-row (surface root meaning gloss)
        (list surface root meaning gloss))
    (defn fcx-surface (r) (nth r 0))
    (defn fcx-root    (r) (nth r 1))
    (defn fcx-meaning (r) (nth r 2))
    (defn fcx-gloss   (r) (nth r 3))

    ; The new knowledge. Depth 5: the meaning survives another tongue.
    ; Fear 0: it does not contract. Claim: named, attempted, observed
    ; (anyone-door band 511).
    (defn fcx-anyone-row ()
        (fcx-row "anyone-door" "seat"
                 "only ChatGPT is a free talk client"
                 "Cursor Codex Claude Grok Gemini have no free client"))
    (defn fcx-anyone-unit () (list 5 0))
    (defn fcx-anyone-claim () (list 1 1 1))

    (defn fcx-may-freeze? (unit claim)
        (if (eq (ki-ingest unit) (fcx-ice))
            (if (eq (nbo-enter claim) 2) 1 0)
            0))

    (defn fcx-phase (unit claim)
        (if (eq (fcx-may-freeze? unit claim) 1) (fcx-ice)
            (ki-ingest unit)))

    (defn fcx-line (r unit claim)
        (str_concat (fcx-surface r)
        (str_concat "|"
        (str_concat (fcx-root r)
        (str_concat "|"
        (str_concat (fcx-meaning r)
        (str_concat "|"
        (str_concat (fcx-gloss r)
        (str_concat "|"
        (str_concat (int_to_str (ki-ingest unit))
        (str_concat "|" (int_to_str (nbo-enter claim)))))))))))))

    (defn fcx-empty () "")
    (defn fcx-hold (led line)
        (if (eq (str_len led) 0) line
            (str_concat led (str_concat "\n" line))))
    (defn fcx-has? (led surface)
        (if (ge (str_find led surface 0) 0) 1 0))

    ; Crystallize: freeze only when both doors open. Else the ledger
    ; is unchanged.
    (defn fcx-crystallize (led r unit claim)
        (if (eq (fcx-may-freeze? unit claim) 1)
            (fcx-hold led (fcx-line r unit claim))
            led))

    (defn fcx-anyone-before () (fcx-empty))
    (defn fcx-anyone-after ()
        (fcx-crystallize (fcx-anyone-before) (fcx-anyone-row)
                         (fcx-anyone-unit) (fcx-anyone-claim)))

    (defn fcx-path () ".form-crystallize-witness.tsv")

    (defn fcxk (cond bit) (if cond bit 0))
    (defn fcx-check ()
        (add (add (add (add (add (add (add (add (add
            (fcxk (eq (ki-ingest (fcx-anyone-unit)) (fcx-ice)) 1)
            (fcxk (eq (nbo-enter (fcx-anyone-claim)) 2) 2))
            (fcxk (eq (fcx-may-freeze? (fcx-anyone-unit) (fcx-anyone-claim)) 1) 4))
            (fcxk (eq (fcx-has? (fcx-anyone-before) "anyone-door") 0) 8))
            (fcxk (eq (fcx-has? (fcx-anyone-after) "anyone-door") 1) 16))
            (fcxk (eq (fcx-phase (list 1 0) (list 1 1 1)) (fcx-compost)) 32))
            (fcxk (eq (fcx-phase (list 5 1) (list 1 1 1)) (fcx-liquid)) 64))
            (fcxk (eq (fcx-crystallize (fcx-empty) (fcx-anyone-row)
                        (list 5 1) (fcx-anyone-claim)) (fcx-empty)) 128))
            (fcxk (ge (str_find (fcx-anyone-after) "only ChatGPT is a free talk client" 0) 0) 256))
            (fcxk (str_eq (fcx-surface (fcx-anyone-row)) "anyone-door") 512)))

    0)
