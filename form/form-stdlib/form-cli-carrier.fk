// form-cli-carrier.fk — admitted source identity and live nonce challenge.
//
import form-stdlib/core.fk;
import form-stdlib/str-byte-at.fk;
import form-stdlib/bml-source.fk;
import form-stdlib/hex.fk;
//
// Native startup stages its bound source identity (the body's fingerprint, 16 lowercase hex) through input_byte. A source
// invocation without that exact 16-byte frame remains unbound. The native image publication binds the identity to its held
// original sources. carrier-challenge folds every nonce byte in Form.
section [form.bml] {
    def fcc-schema() = "form-cli-carrier-v3";
    def fcc-source-byte?(b) = b >= 48 && b <= 57 || b >= 97 && b <= 102;
    def fcc-source-bytes(at, held) = (Comparable) at == 16 ? (Comparable) input_byte(at) == 0 ? held : "unbound-source" : fcc-source-byte?(input_byte(at)) ? fcc-source-bytes(at + 1, ((String) held + byte_to_str(input_byte(at)))) : "unbound-source";
    def fcc-source-id() = fcc-source-bytes(0, "");
    def fcc-build-id() = "coherence-kernel-fkwu-native-v2";
    def fcc-challenge-domain() = "form-cli-carrier-challenge-v2\n";
    def fcc-nonce-valid?(nonce) = (Comparable) len(nonce) == 64 && ((Comparable) hex-valid?(nonce) == 1 && (String) nonce == hex-encode(hex-decode(nonce))) ? 1 : 0;
    def fcc-challenge-digest(nonce) = bml-source-fingerprint((String) fcc-challenge-domain() + nonce);
    def fcc-carrier-id() = ("carrier-id|" + (fcc-schema() + ("|" + (fcc-source-id() + ("|" + fcc-build-id())))));
    // stdout: carrier-challenge-v2|<source-id>|<nonce>|<fingerprint>
    // fingerprint = the body's fingerprint of ASCII "form-cli-carrier-challenge-v2\n" + nonce ASCII.
    def fcc-carrier-challenge(nonce) = (Comparable) fcc-nonce-valid?(nonce) == 0 ? "carrier-challenge:error:invalid-nonce" : ("carrier-challenge-v2|" + (fcc-source-id() + ("|" + (nonce + ("|" + fcc-challenge-digest(nonce))))));
    0;
}
