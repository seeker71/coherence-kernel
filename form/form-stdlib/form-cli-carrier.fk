// form-cli-carrier.fk — admitted source identity and live nonce challenge.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
//
// Native startup stages its bound source digest through input_byte. A source
// invocation without that exact 64-byte lowercase hex frame remains unbound.
// The native image publication binds the digest to its held original sources.
// carrier-challenge hashes every nonce byte in Form.
section [form.bml] {
    def fcc-schema() = "form-cli-carrier-v2";
    def fcc-source-byte?(b) = b >= 48 && b <= 57 || b >= 97 && b <= 102;
    def fcc-source-bytes(at, held) = (Comparable) at == 64 ? (Comparable) input_byte(at) == 0 ? held : "unbound-source" : fcc-source-byte?(input_byte(at)) ? fcc-source-bytes(at + 1, str_concat(held, byte_to_str(input_byte(at)))) : "unbound-source";
    def fcc-source-stamp() = fcc-source-bytes(0, "");
    def fcc-build-id() = "coherence-kernel-fkwu-native-v2";
    def fcc-challenge-domain() = "form-cli-carrier-challenge-v1\n";
    def fcc-string-bytes-loop(s, i, out) = i >= str_len(s) ? out : fcc-string-bytes-loop(s, i + 1, append-1(out, str_byte_at(s, i)));
    def fcc-string-bytes(s) = fcc-string-bytes-loop(s, 0, empty());
    def fcc-nonce-valid?(nonce) = (Comparable) str_len(nonce) == 64 && ((Comparable) hex-valid?(nonce) == 1 && (String) nonce == hex-encode(hex-decode(nonce))) ? 1 : 0;
    def fcc-challenge-digest(nonce) = hex-encode(sha256(fcc-string-bytes(str_concat(fcc-challenge-domain(), nonce))));
    def fcc-carrier-id() = str_concat("carrier-id|", str_concat(fcc-schema(), str_concat("|", str_concat(fcc-source-stamp(), str_concat("|", fcc-build-id())))));
    // stdout: carrier-challenge-v1|<source-stamp>|<nonce>|<sha256>
    // digest = SHA256(ASCII "form-cli-carrier-challenge-v1\n" + nonce ASCII).
    def fcc-carrier-challenge(nonce) = (Comparable) fcc-nonce-valid?(nonce) == 0 ? "carrier-challenge:error:invalid-nonce" : str_concat("carrier-challenge-v1|", str_concat(fcc-source-stamp(), str_concat("|", str_concat(nonce, str_concat("|", fcc-challenge-digest(nonce))))));
    0;
}
