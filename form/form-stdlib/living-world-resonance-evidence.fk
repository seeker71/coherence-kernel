; living-world-resonance-evidence.fk -- support never erases exception.
;
; Gathers active structural correspondences within the same source/target
; category-and-arity domain.  Exact signature matches are support; every other
; signature remains a counterexample.  The resulting mapping carries a vector
; of distinct uncertainties rather than an authority-looking scalar.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk

(let LWR-EVIDENCE     (bp "LWR-EVIDENCE"))
(let LWR-EVIDENCE-SET (bp "LWR-EVIDENCE-SET"))
(let LWR-UNCERTAINTY  (bp "LWR-UNCERTAINTY"))
(let LWR-MAPPING      (bp "LWR-MAPPING"))

(defn lwr-evidence (correspondence signature attributions)
    (intern_node LWR-EVIDENCE (list correspondence signature attributions)))
(defn lwr-evidence-correspondence (evidence) (nth (node_children evidence) 0))
(defn lwr-evidence-signature (evidence) (nth (node_children evidence) 1))
(defn lwr-evidence-attributions (evidence) (nth (node_children evidence) 2))

(defn lwr-collect-evidence-items
    (world items seed-signature supports counterexamples)
    (if (eq (len items) 0)
        (intern_node LWR-EVIDENCE-SET (list supports counterexamples))
        (do
            (let cell (head items))
            (if (eq (lwr-correspondence-active? world cell) 1)
                (do
                    (let signature (lwr-signature-for cell))
                    (if (eq (lwr-signature-domain-eq?
                                signature seed-signature) 1)
                        (do
                            (let evidence
                                (lwr-evidence cell signature
                                    (lwo-active-attributions-for world cell)))
                            (if (node_eq signature seed-signature)
                                (lwr-collect-evidence-items world (tail items)
                                    seed-signature
                                    (lwo-field-add supports evidence)
                                    counterexamples)
                                (lwr-collect-evidence-items world (tail items)
                                    seed-signature supports
                                    (lwo-field-add counterexamples evidence))))
                        (lwr-collect-evidence-items world (tail items)
                            seed-signature supports counterexamples)))
                (lwr-collect-evidence-items world (tail items)
                    seed-signature supports counterexamples)))))

(defn lwr-evidence-set-for (world signature)
    (lwr-collect-evidence-items world
        (lwo-field-items (lwo-world-cells world)) signature
        (lwo-empty-field) (lwo-empty-field)))
(defn lwr-evidence-supports (evidence-set)
    (nth (node_children evidence-set) 0))
(defn lwr-evidence-counterexamples (evidence-set)
    (nth (node_children evidence-set) 1))

(defn lwr-field-union-items (items acc)
    (if (eq (len items) 0) acc
        (lwr-field-union-items (tail items)
            (lwo-field-add acc (head items)))))

(defn lwr-attributions-from-evidence-items (items acc)
    (if (eq (len items) 0) acc
        (lwr-attributions-from-evidence-items (tail items)
            (lwr-field-union-items
                (lwo-field-items
                    (lwr-evidence-attributions (head items))) acc))))

(defn lwr-evidence-witnesses (evidence-set)
    (do
        (let from-support
            (lwr-attributions-from-evidence-items
                (lwo-field-items (lwr-evidence-supports evidence-set))
                (lwo-empty-field)))
        (lwr-attributions-from-evidence-items
            (lwo-field-items (lwr-evidence-counterexamples evidence-set))
            from-support)))

; children: counterexample-count, ambiguous-target-count, unused-source-count
(defn lwr-uncertainty (counterexamples ambiguous unused-source)
    (intern_node LWR-UNCERTAINTY
        (list (intern_trivial_int counterexamples)
              (intern_trivial_int ambiguous)
              (intern_trivial_int unused-source))))
(defn lwr-uncertainty-counterexamples (uncertainty)
    (node_value (nth (node_children uncertainty) 0)))
(defn lwr-uncertainty-ambiguous (uncertainty)
    (node_value (nth (node_children uncertainty) 1)))
(defn lwr-uncertainty-unused-source (uncertainty)
    (node_value (nth (node_children uncertainty) 2)))

(defn lwr-mapping (signature supports counterexamples uncertainty)
    (intern_node LWR-MAPPING
        (list signature supports counterexamples uncertainty)))
(defn lwr-mapping? (cell) (lwo-category? cell LWR-MAPPING))
(defn lwr-mapping-signature (mapping) (nth (node_children mapping) 0))
(defn lwr-mapping-supports (mapping) (nth (node_children mapping) 1))
(defn lwr-mapping-counterexamples (mapping) (nth (node_children mapping) 2))
(defn lwr-mapping-uncertainty (mapping) (nth (node_children mapping) 3))

; --- exact local freshness without rebuilding the mapping ------------

; The admitted mapping already contains every correspondence in its domain
; and the exact active-attribution snapshot observed for each one.  Freshness
; therefore has two independent obligations: every retained snapshot is still
; exact, and no new active correspondence has entered the same domain.  This
; is equivalent to rebuilding lwr-evidence-set-for and comparing mappings, but
; does not reconstruct support, counterexample, uncertainty, and witness cells
; every time a downstream application asks whether its parent is current.
(defn lwr-evidence-item-current? (world evidence)
    (do
        (let correspondence
            (lwr-evidence-correspondence evidence))
        (if (eq (lwr-correspondence-active?
                    world correspondence) 0) 0
            (node_eq (lwr-evidence-attributions evidence)
                (lwo-active-attributions-for world correspondence)))))

(defn lwr-evidence-items-current? (world items)
    (if (eq (len items) 0) 1
        (if (eq (lwr-evidence-item-current?
                    world (head items)) 1)
            (lwr-evidence-items-current? world (tail items)) 0)))

(defn lwr-evidence-has-correspondence? (items correspondence)
    (if (eq (len items) 0) 0
        (if (node_eq
                (lwr-evidence-correspondence (head items)) correspondence) 1
            (lwr-evidence-has-correspondence?
                (tail items) correspondence))))

(defn lwr-mapping-has-correspondence? (mapping correspondence)
    (if (eq (lwr-evidence-has-correspondence?
                (lwo-field-items (lwr-mapping-supports mapping))
                correspondence) 1) 1
        (lwr-evidence-has-correspondence?
            (lwo-field-items (lwr-mapping-counterexamples mapping))
            correspondence)))

(defn lwr-no-new-domain-correspondence-items?
    (world items mapping signature)
    (if (eq (len items) 0) 1
        (do
            (let cell (head items))
            (if (eq (lwr-correspondence? cell) 0)
                (lwr-no-new-domain-correspondence-items?
                    world (tail items) mapping signature)
                (if (eq (lwr-correspondence-active? world cell) 0)
                    (lwr-no-new-domain-correspondence-items?
                        world (tail items) mapping signature)
                    (if (eq (lwr-signature-domain-eq?
                                (lwr-signature-for cell) signature) 0)
                        (lwr-no-new-domain-correspondence-items?
                            world (tail items) mapping signature)
                        (if (eq (lwr-mapping-has-correspondence?
                                    mapping cell) 1)
                            (lwr-no-new-domain-correspondence-items?
                                world (tail items) mapping signature)
                            0)))))))

(defn lwr-mapping-snapshot-current? (world mapping)
    (if (eq (lwr-evidence-items-current? world
                (lwo-field-items (lwr-mapping-supports mapping))) 0) 0
        (if (eq (lwr-evidence-items-current? world
                    (lwo-field-items
                        (lwr-mapping-counterexamples mapping))) 0) 0
            (lwr-no-new-domain-correspondence-items? world
                (lwo-field-items (lwo-world-cells world)) mapping
                (lwr-mapping-signature mapping)))))
