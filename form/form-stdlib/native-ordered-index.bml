// Persistent balanced index for runtime tables. Keys are byte-exact strings.
// Values 0 and 1 are present; only an absent node returns nothing.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NativeOrderedIndex {
  def noi-compare(a,b,i) = if (i >= str_len(a)) then if (i >= str_len(b)) then 0 else -1 else if (i >= str_len(b)) then 1 else if (str_byte_at(a,i) < str_byte_at(b,i)) then -1 else if (str_byte_at(a,i) > str_byte_at(b,i)) then 1 else noi-compare(a,b,(i + 1));
  def noi-height(t) = if nil?(t) then 0 else t[4];
  def noi-max(a,b) = if (a > b) then a else b;
  def noi-node(k,v,l,r) = [k,v,l,r,(1 + noi-max(noi-height(l),noi-height(r)))];
  def noi-left(t) {
   let r = t[3];
   noi-node(head(r),r[1],noi-node(head(t),t[1],t[2],r[2]),r[3]);
  }
  def noi-right(t) {
   let l = t[2];
   noi-node(head(l),l[1],l[2],noi-node(head(t),t[1],l[3],t[3]));
  }
  def noi-balance(t) {
   let l = t[2]; let r = t[3];
   if ((noi-height(l) - noi-height(r)) > 1) then noi-right(if (noi-height(l[2]) < noi-height(l[3])) then noi-node(head(t),t[1],noi-left(l),r) else t)
   else if ((noi-height(r) - noi-height(l)) > 1) then noi-left(if (noi-height(r[3]) < noi-height(r[2])) then noi-node(head(t),t[1],l,noi-right(r)) else t) else t;
  }
  def noi-put(t,k,v) = if nil?(t) then noi-node(k,v,[],[]) else noi-put-compared(t,k,v,noi-compare(k,head(t),0));
  def noi-put-compared(t,k,v,c) = if ((Comparable) c == 0) then noi-node(k,v,t[2],t[3]) else noi-balance(if (c < 0) then noi-node(head(t),t[1],noi-put(t[2],k,v),t[3]) else noi-node(head(t),t[1],t[2],noi-put(t[3],k,v)));
  def noi-get(t,k) = if nil?(t) then nothing() else noi-get-compared(t,k,noi-compare(k,head(t),0));
  def noi-get-compared(t,k,c) = if ((Comparable) c == 0) then t[1] else noi-get(if (c < 0) then t[2] else t[3],k);
  def noi-floor(t,k,prior) = if nil?(t) then prior else if (noi-compare(k,head(t),0) < 0) then noi-floor(t[2],k,prior) else noi-floor(t[3],k,t[1]);
 }
 0;
}
