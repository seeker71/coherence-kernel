// Persistent balanced index for runtime tables. Keys are byte-exact strings.
// Values 0 and 1 are present; only an absent node returns nothing.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NativeOrderedIndex {
  def noi-compare(a,b,i) = i >= str_len(a) ? (i >= str_len(b) ? 0 : -1) : i >= str_len(b) ? 1 : str_byte_at(a,i) < str_byte_at(b,i) ? -1 : str_byte_at(a,i) > str_byte_at(b,i) ? 1 : noi-compare(a,b,i + 1);
  def noi-height(t) = nil?(t) ? 0 : t[4];
  def noi-max(a,b) = a > b ? a : b;
  def noi-node(k,v,l,r) = list(k,v,l,r,1 + noi-max(noi-height(l),noi-height(r)));
  def noi-left(t) {
   let r = t[3];
   noi-node(head(r),r[1],noi-node(head(t),t[1],t[2],r[2]),r[3]);
  }
  def noi-right(t) {
   let l = t[2];
   noi-node(head(l),l[1],l[2],noi-node(head(t),t[1],l[3],t[3]));
  }
  def noi-balance(t) {
   let l = t[2]; let r = t[3];
   (noi-height(l) - noi-height(r)) > 1 ? noi-right(noi-height(l[2]) < noi-height(l[3]) ? noi-node(head(t),t[1],noi-left(l),r) : t)
   : (noi-height(r) - noi-height(l)) > 1 ? noi-left(noi-height(r[3]) < noi-height(r[2]) ? noi-node(head(t),t[1],l,noi-right(r)) : t) : t;
  }
  def noi-put(t,k,v) = nil?(t) ? noi-node(k,v,list(),list()) : noi-put-compared(t,k,v,noi-compare(k,head(t),0));
  def noi-put-compared(t,k,v,c) = (Comparable) c == 0 ? noi-node(k,v,t[2],t[3]) : noi-balance(c < 0 ? noi-node(head(t),t[1],noi-put(t[2],k,v),t[3]) : noi-node(head(t),t[1],t[2],noi-put(t[3],k,v)));
  def noi-get(t,k) = nil?(t) ? nothing() : noi-get-compared(t,k,noi-compare(k,head(t),0));
  def noi-get-compared(t,k,c) = (Comparable) c == 0 ? t[1] : noi-get(c < 0 ? t[2] : t[3],k);
  def noi-floor(t,k,prior) = nil?(t) ? prior : noi-compare(k,head(t),0) < 0 ? noi-floor(t[2],k,prior) : noi-floor(t[3],k,t[1]);
 }
 0;
}
