// Persistent balanced index for runtime tables. Keys are byte-exact strings.
// Values 0 and 1 are present; only an absent node returns nothing.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NativeOrderedIndex {
  def noi-compare(a,b,i) = if ge(i,str_len(a)) then if ge(i,str_len(b)) then 0 else -1 else if ge(i,str_len(b)) then 1 else if lt(str_byte_at(a,i),str_byte_at(b,i)) then -1 else if gt(str_byte_at(a,i),str_byte_at(b,i)) then 1 else noi-compare(a,b,add(i,1));
  def noi-height(t) = if nil?(t) then 0 else nth(t,4);
  def noi-max(a,b) = if gt(a,b) then a else b;
  def noi-node(k,v,l,r) = list(k,v,l,r,add(1,noi-max(noi-height(l),noi-height(r))));
  def noi-left(t) {
   let r = nth(t,3);
   noi-node(head(r),nth(r,1),noi-node(head(t),nth(t,1),nth(t,2),nth(r,2)),nth(r,3));
  }
  def noi-right(t) {
   let l = nth(t,2);
   noi-node(head(l),nth(l,1),nth(l,2),noi-node(head(t),nth(t,1),nth(l,3),nth(t,3)));
  }
  def noi-balance(t) {
   let l = nth(t,2); let r = nth(t,3);
   if gt(sub(noi-height(l),noi-height(r)),1) then noi-right(if lt(noi-height(nth(l,2)),noi-height(nth(l,3))) then noi-node(head(t),nth(t,1),noi-left(l),r) else t)
   else if gt(sub(noi-height(r),noi-height(l)),1) then noi-left(if lt(noi-height(nth(r,3)),noi-height(nth(r,2))) then noi-node(head(t),nth(t,1),l,noi-right(r)) else t) else t;
  }
  def noi-put(t,k,v) = if nil?(t) then noi-node(k,v,list(),list()) else noi-put-compared(t,k,v,noi-compare(k,head(t),0));
  def noi-put-compared(t,k,v,c) = if eq(c,0) then noi-node(k,v,nth(t,2),nth(t,3)) else noi-balance(if lt(c,0) then noi-node(head(t),nth(t,1),noi-put(nth(t,2),k,v),nth(t,3)) else noi-node(head(t),nth(t,1),nth(t,2),noi-put(nth(t,3),k,v)));
  def noi-get(t,k) = if nil?(t) then nothing() else noi-get-compared(t,k,noi-compare(k,head(t),0));
  def noi-get-compared(t,k,c) = if eq(c,0) then nth(t,1) else noi-get(if lt(c,0) then nth(t,2) else nth(t,3),k);
  def noi-floor(t,k,prior) = if nil?(t) then prior else if lt(noi-compare(k,head(t),0),0) then noi-floor(nth(t,2),k,prior) else noi-floor(nth(t,3),k,nth(t,1));
 }
 0;
}
