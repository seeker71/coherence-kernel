; living-world-composite-recipe.fk -- behavior composes a new Recipe surface.
;
; A recurrent blueprint may point at one current, integrated operation field
; and one explicitly chosen opaque bridge role.  For every compatible profile
; in the field, this organ nests that profile's already offered evaluator
; surface into the bridge role of the same carrier.  It imports no operation
; token and chooses no representative profile: every generated surface is
; trialed against the same recurrent, consented composite examples and grouped
; only by exact example/output behavior.
;
; The blueprint, bridge, codecs, examples, alternatives, unknown remainder,
; choice, timeout, and acknowledgements remain separately offered cells.
; Generated Recipes are proposal tissue scoped to the integrated composite
; field; they are not ordinary action offers and receive no authority outside
; that field.  Contradiction, silence, plurality, revocation, and history stay.
;
; witnessed: 2026-08-07 -> field/revocation bands 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk form-stdlib/living-world-operation-field.fk

(let LWOEC-BLUEPRINT  (bp "LWOEC-BLUEPRINT"))
(let LWOEC-EXAMPLE    (bp "LWOEC-EXAMPLE"))
(let LWOEC-SURFACE    (bp "LWOEC-SURFACE"))
(let LWOEC-TRIAL      (bp "LWOEC-TRIAL"))
(let LWOEC-PROFILE    (bp "LWOEC-PROFILE"))
(let LWOEC-CLASS      (bp "LWOEC-CLASS"))
(let LWOEC-FIELD      (bp "LWOEC-FIELD"))
(let LWOEC-ORIGIN     (bp "LWOEC-ORIGIN"))

(defn lwoec-union-items (items field)
    (if (eq (len items) 0) field
        (lwoec-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwoec-attributions (world cell field)
    (lwoec-union-items
        (lwo-field-items (lwo-active-attributions-for world cell)) field))
(defn lwoec-role-in-items? (items role)
    (if (eq (len items) 0) 0
        (if (node_eq (head items) role) 1
            (lwoec-role-in-items? (tail items) role))))

; --- offered structural composition blueprint -----------------------

; children: integrated operation field, chosen opaque bridge role, exact
;           codecs, alternatives, optional unknown/choice/timeout, evidence,
;           local path
(defn lwoec-blueprint
    (component bridge codecs alternatives unknown choice timeout evidence)
    (intern_node LWOEC-BLUEPRINT
        (list component bridge codecs alternatives unknown choice timeout
              evidence (lwo-local-path))))
(defn lwoec-blueprint? (cell) (lwo-category? cell LWOEC-BLUEPRINT))
(defn lwoec-blueprint-component (blueprint)
    (nth (node_children blueprint) 0))
(defn lwoec-blueprint-bridge (blueprint)
    (nth (node_children blueprint) 1))
(defn lwoec-blueprint-codecs (blueprint)
    (nth (node_children blueprint) 2))
(defn lwoec-blueprint-alternatives (blueprint)
    (nth (node_children blueprint) 3))
(defn lwoec-blueprint-unknown (blueprint)
    (nth (node_children blueprint) 4))
(defn lwoec-blueprint-choice (blueprint)
    (nth (node_children blueprint) 5))
(defn lwoec-blueprint-timeout (blueprint)
    (nth (node_children blueprint) 6))
(defn lwoec-blueprint-evidence (blueprint)
    (nth (node_children blueprint) 7))
(defn lwoec-blueprint-path (blueprint)
    (nth (node_children blueprint) 8))

; Shape-only coverage: currentness is observed separately with the world.
(defn lwoec-profiles-cover-bridge? (items bridge)
    (if (eq (len items) 0) 1
        (do
            (let carrier (lwoe-profile-carrier (head items)))
            (if (eq (lwoec-role-in-items?
                        (lwsr-role-items
                            (lwoe-carrier-roles carrier)) bridge) 1)
                (lwoec-profiles-cover-bridge? (tail items) bridge) 0))))
(defn lwoec-blueprint-valid? (blueprint)
    (if (eq (lwoec-blueprint? blueprint) 0) 0
        (do
            (let component (lwoec-blueprint-component blueprint))
            (if (eq (lwoe-candidate? component) 0) 0
                (do
                    (let field (lwo-emergent-shape component))
                    (let compatible (lwoe-field-compatible field))
                    (if (or (eq (lwsr-role-candidate?
                                    (lwoec-blueprint-bridge blueprint)) 0)
                            (or (eq (lwo-category?
                                      (lwoec-blueprint-codecs blueprint)
                                      LWO-FIELD) 0)
                                (or (eq (lwo-field-size compatible) 0)
                                    (or (eq (lwph-singular?
                                              (lwoe-field-status field)) 0)
                                        (eq (lwoec-profiles-cover-bridge?
                                              (lwo-field-items compatible)
                                              (lwoec-blueprint-bridge
                                                blueprint)) 0))))) 0
                        (if (eq (lwo-category?
                                  (lwoec-blueprint-alternatives blueprint)
                                  LWO-FIELD) 0) 0
                            (if (eq (lwph-optional-unknown-valid?
                                      (lwoec-blueprint-unknown blueprint)) 0) 0
                                (if (eq (lwlc-choice-valid?
                                          (lwoec-blueprint-choice
                                            blueprint)) 0) 0
                                    (lwac-optional-timeout-valid?
                                        (lwoec-blueprint-timeout
                                            blueprint)))))))))))

(defn lwoec-profile-dependencies-current?
    (world items bridge codecs enquiry)
    (if (eq (len items) 0) 1
        (do
            (let profile (head items))
            (let carrier (lwoe-profile-carrier profile))
            (let roles (lwsr-role-items (lwoe-carrier-roles carrier)))
            (if (and (eq (lwoe-carrier-current?
                             world carrier enquiry) 1)
                     (and (eq (lwoec-role-in-items? roles bridge) 1)
                          (eq (lwoe-codecs-current-for-roles?
                                world roles codecs (list)) 1)))
                (lwoec-profile-dependencies-current?
                    world (tail items) bridge codecs enquiry) 0))))
(defn lwoec-blueprint-current? (world blueprint threshold)
    (if (or (le threshold 0)
            (eq (lwoec-blueprint-valid? blueprint) 0)) 0
        (do
            (let component (lwoec-blueprint-component blueprint))
            (let field (lwo-emergent-shape component))
            (let enquiry (lwoe-field-enquiry field))
            (if (and (eq (lwoe-integrated-current?
                             world component) 1)
                     (and (eq (lwsr-role-integrated-current?
                                 world
                                 (lwoec-blueprint-bridge blueprint)) 1)
                          (and (eq (lwo-active? world blueprint) 1)
                               (and (ge (lwph-active-source-count
                                          world blueprint) threshold)
                                    (eq (lwoec-profile-dependencies-current?
                                          world
                                          (lwo-field-items
                                            (lwoe-field-compatible field))
                                          (lwoec-blueprint-bridge blueprint)
                                          (lwoec-blueprint-codecs blueprint)
                                          enquiry) 1))))) 1 0))))

; --- recurrent composite examples -----------------------------------

; children: exact blueprint, opaque-role values, optional observed integer,
;           ack, alternatives, optional unknown, evidence, local path
(defn lwoec-example
    (blueprint values observed ack alternatives unknown evidence)
    (intern_node LWOEC-EXAMPLE
        (list blueprint values observed ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwoec-example? (cell) (lwo-category? cell LWOEC-EXAMPLE))
(defn lwoec-example-blueprint (example) (nth (node_children example) 0))
(defn lwoec-example-values (example) (nth (node_children example) 1))
(defn lwoec-example-observed (example) (nth (node_children example) 2))
(defn lwoec-example-ack (example) (nth (node_children example) 3))
(defn lwoec-example-alternatives (example) (nth (node_children example) 4))
(defn lwoec-example-unknown (example) (nth (node_children example) 5))
(defn lwoec-example-evidence (example) (nth (node_children example) 6))
(defn lwoec-example-path (example) (nth (node_children example) 7))
(defn lwoec-example-valid? (example)
    (if (eq (lwoec-example? example) 0) 0
        (if (eq (lwoec-blueprint-valid?
                    (lwoec-example-blueprint example)) 0) 0
            (if (eq (lwo-category?
                        (lwoec-example-values example) LWO-FIELD) 0) 0
                (if (eq (lwoe-values-valid-items?
                            (lwo-field-items
                                (lwoec-example-values example))) 0) 0
                    (if (eq (lwoe-observed-valid?
                                (lwoec-example-observed example)) 0) 0
                        (if (eq (oac-valid-ack?
                                    (lwoec-example-ack example)) 0) 0
                            (if (eq (lwoe-example-ack-coherent?
                                      (lwoec-example-observed example)
                                      (lwoec-example-ack example)) 0) 0
                                (if (eq (lwo-category?
                                          (lwoec-example-alternatives example)
                                          LWO-FIELD) 0) 0
                                    (lwph-optional-unknown-valid?
                                        (lwoec-example-unknown
                                            example)))))))))))
; The caller has already witnessed this exact blueprint as valid/current in the
; same immutable world snapshot.  Keep all example-local validation and exact
; blueprint identity, but do not recursively revalidate the blueprint.
(defn lwoec-example-valid-under-blueprint? (example blueprint)
    (if (or (eq (lwoec-example? example) 0)
            (not (node_eq
                    (lwoec-example-blueprint example) blueprint))) 0
        (if (eq (lwo-category?
                    (lwoec-example-values example) LWO-FIELD) 0) 0
            (if (eq (lwoe-values-valid-items?
                        (lwo-field-items
                            (lwoec-example-values example))) 0) 0
                (if (eq (lwoe-observed-valid?
                            (lwoec-example-observed example)) 0) 0
                    (if (eq (oac-valid-ack?
                                (lwoec-example-ack example)) 0) 0
                        (if (eq (lwoe-example-ack-coherent?
                                  (lwoec-example-observed example)
                                  (lwoec-example-ack example)) 0) 0
                            (if (eq (lwo-category?
                                      (lwoec-example-alternatives example)
                                      LWO-FIELD) 0) 0
                                (lwph-optional-unknown-valid?
                                    (lwoec-example-unknown example))))))))))
(defn lwoec-values-complete-profiles? (items codecs values)
    (if (eq (len items) 0) 1
        (do
            (let carrier (lwoe-profile-carrier (head items)))
            (if (eq (lwsr-application-complete-items?
                        (lwsr-role-items (lwoe-carrier-roles carrier))
                        (list) codecs values) 1)
                (lwoec-values-complete-profiles?
                    (tail items) codecs values) 0))))
(defn lwoec-example-current? (world example blueprint threshold)
    (if (or (eq (lwoec-example-valid? example) 0)
            (not (node_eq
                    (lwoec-example-blueprint example) blueprint))) 0
        (do
            (let field
                (lwo-emergent-shape
                    (lwoec-blueprint-component blueprint)))
            (if (and (eq (lwoec-blueprint-current?
                             world blueprint threshold) 1)
                     (and (eq (lwo-active? world example) 1)
                          (and (ge (lwph-active-source-count
                                     world example) threshold)
                               (and (eq (lwoe-values-current-items?
                                          world
                                          (lwo-field-items
                                            (lwoec-example-values example))) 1)
                                    (eq (lwoec-values-complete-profiles?
                                          (lwo-field-items
                                            (lwoe-field-compatible field))
                                          (lwoec-blueprint-codecs blueprint)
                                          (lwoec-example-values example)) 1)))))
                1 0))))
(defn lwoec-example-current-under-current-blueprint?
    (world example blueprint threshold)
    (if (eq (lwoec-example-valid-under-blueprint?
                example blueprint) 0) 0
        (do
            (let field
                (lwo-emergent-shape
                    (lwoec-blueprint-component blueprint)))
            (if (and (eq (lwo-active? world example) 1)
                     (and (ge (lwph-active-source-count
                                world example) threshold)
                          (and (eq (lwoe-values-current-items?
                                     world
                                     (lwo-field-items
                                        (lwoec-example-values example))) 1)
                               (eq (lwoec-values-complete-profiles?
                                     (lwo-field-items
                                        (lwoe-field-compatible field))
                                     (lwoec-blueprint-codecs blueprint)
                                     (lwoec-example-values example)) 1))))
                1 0))))
(defn lwoec-collect-examples
    (world items blueprint threshold field)
    (if (eq (len items) 0) field
        (lwoec-collect-examples world (tail items) blueprint threshold
            (if (eq (lwoec-example-current?
                        world (head items) blueprint threshold) 1)
                (lwo-field-add field (head items)) field))))
(defn lwoec-examples-for (world blueprint threshold)
    (lwoec-collect-examples world
        (lwo-field-items (lwo-world-cells world)) blueprint threshold
        (lwo-empty-field)))
(defn lwoec-collect-examples-under-current-blueprint
    (world items blueprint threshold field)
    (if (eq (len items) 0) field
        (lwoec-collect-examples-under-current-blueprint
            world (tail items) blueprint threshold
            (if (eq (lwoec-example-current-under-current-blueprint?
                        world (head items) blueprint threshold) 1)
                (lwo-field-add field (head items)) field))))
(defn lwoec-examples-for-under-current-blueprint
    (world blueprint threshold)
    (lwoec-collect-examples-under-current-blueprint world
        (lwo-field-items (lwo-world-cells world)) blueprint threshold
        (lwo-empty-field)))

; --- generated surfaces and exact trials ----------------------------

(defn lwoec-source-role-items
    (items bridge codecs inner source)
    (if (eq (len items) 0) source
        (do
            (let role (head items))
            (let argument
                (if (node_eq role bridge) inner
                    (lwsr-codec-token
                        (lwsr-one-codec-for-role codecs role))))
            (lwoec-source-role-items (tail items) bridge codecs inner
                (str_concat source (str_concat " " argument))))))
(defn lwoec-source-for (blueprint component-profile)
    (do
        (let carrier (lwoe-profile-carrier component-profile))
        (let codecs (lwoec-blueprint-codecs blueprint))
        (let inner (lwoe-source-for carrier codecs))
        (str_concat
            (lwoec-source-role-items
                (lwsr-role-items (lwoe-carrier-roles carrier))
                (lwoec-blueprint-bridge blueprint) codecs inner
                (str_concat "("
                    (lwph-operator-token
                        (lwoe-carrier-operator carrier))))
            ")")))
(defn lwoec-recipe-for (blueprint component-profile)
    (lwre-recipe
        (lwoec-source-for blueprint component-profile)
        (lwre-bound-form-contract 256 blueprint) blueprint))

; children: exact blueprint, component behavior profile, generated Recipe,
;           local path
(defn lwoec-surface (blueprint component-profile recipe)
    (intern_node LWOEC-SURFACE
        (list blueprint component-profile recipe (lwo-local-path))))
(defn lwoec-surface? (cell) (lwo-category? cell LWOEC-SURFACE))
(defn lwoec-surface-blueprint (surface) (nth (node_children surface) 0))
(defn lwoec-surface-component-profile (surface)
    (nth (node_children surface) 1))
(defn lwoec-surface-recipe (surface) (nth (node_children surface) 2))
(defn lwoec-surface-path (surface) (nth (node_children surface) 3))
(defn lwoec-surface-for (blueprint component-profile)
    (lwoec-surface blueprint component-profile
        (lwoec-recipe-for blueprint component-profile)))
(defn lwoec-surface-valid? (surface)
    (if (eq (lwoec-surface? surface) 0) 0
        (if (eq (lwoec-blueprint-valid?
                    (lwoec-surface-blueprint surface)) 0) 0
            (if (eq (lwoe-profile?
                        (lwoec-surface-component-profile surface)) 0) 0
                (if (eq (lwre-recipe-valid?
                            (lwoec-surface-recipe surface)) 0) 0
                    (node_eq surface
                        (lwoec-surface-for
                            (lwoec-surface-blueprint surface)
                            (lwoec-surface-component-profile
                                surface))))))))

; children: generated surface, example, exact bindings/output/comparison,
;           state, local path
(defn lwoec-trial
    (surface example bindings output comparison state)
    (intern_node LWOEC-TRIAL
        (list surface example bindings output comparison state
              (lwo-local-path))))
(defn lwoec-trial? (cell) (lwo-category? cell LWOEC-TRIAL))
(defn lwoec-trial-surface (trial) (nth (node_children trial) 0))
(defn lwoec-trial-example (trial) (nth (node_children trial) 1))
(defn lwoec-trial-bindings (trial) (nth (node_children trial) 2))
(defn lwoec-trial-output (trial) (nth (node_children trial) 3))
(defn lwoec-trial-comparison (trial) (nth (node_children trial) 4))
(defn lwoec-trial-state (trial) (nth (node_children trial) 5))
(defn lwoec-trial-path (trial) (nth (node_children trial) 6))
(defn lwoec-trial-for (world surface example threshold)
    (if (eq (lwoec-surface-valid? surface) 0) (lwo-none)
        (do
            (let blueprint (lwoec-surface-blueprint surface))
            (let profile (lwoec-surface-component-profile surface))
            (let carrier (lwoe-profile-carrier profile))
            (if (or (eq (lwoec-blueprint-current?
                            world blueprint threshold) 0)
                    (eq (lwoec-example-current?
                            world example blueprint threshold) 0)) (lwo-none)
                (do
                    (let bindings
                        (lwoe-bindings-for carrier
                            (lwoec-blueprint-codecs blueprint)
                            (lwoec-example-values example)))
                    (let output
                        (intern_trivial_int
                            (lwre-evaluate-bound
                                (lwoec-surface-recipe surface) bindings)))
                    (let ack (lwoec-example-ack example))
                    (if (eq (oac-one? ack) 0)
                        (lwoec-trial surface example bindings output ack
                            (lwph-unresolved))
                        (do
                            (let observed (lwoec-example-observed example))
                            (if (node_eq output observed)
                                (lwoec-trial surface example bindings output
                                    (oac-one output) (lwph-consistent))
                                (lwoec-trial surface example bindings output
                                    (oac-alternative-ack
                                        observed output example)
                                    (lwph-divergent))))))))))
; This path accepts only examples admitted by
; lwoec-examples-for-under-current-blueprint in the same field construction.
; Exact surface/blueprint identity remains checked; no authority crosses to a
; different world snapshot or later round.
(defn lwoec-trial-for-current-example (surface example)
    (if (or (eq (lwoec-surface-valid? surface) 0)
            (not (node_eq
                    (lwoec-example-blueprint example)
                    (lwoec-surface-blueprint surface)))) (lwo-none)
        (do
            (let blueprint (lwoec-surface-blueprint surface))
            (let profile (lwoec-surface-component-profile surface))
            (let carrier (lwoe-profile-carrier profile))
            (let bindings
                (lwoe-bindings-for carrier
                    (lwoec-blueprint-codecs blueprint)
                    (lwoec-example-values example)))
            (let output
                (intern_trivial_int
                    (lwre-evaluate-bound
                        (lwoec-surface-recipe surface) bindings)))
            (let ack (lwoec-example-ack example))
            (if (eq (oac-one? ack) 0)
                (lwoec-trial surface example bindings output ack
                    (lwph-unresolved))
                (do
                    (let observed (lwoec-example-observed example))
                    (if (node_eq output observed)
                        (lwoec-trial surface example bindings output
                            (oac-one output) (lwph-consistent))
                        (lwoec-trial surface example bindings output
                            (oac-alternative-ack
                                observed output example)
                            (lwph-divergent))))))))
(defn lwoec-trials-for-items
    (world surface items threshold field)
    (if (eq (len items) 0) field
        (do
            (let trial
                (lwoec-trial-for world surface (head items) threshold))
            (lwoec-trials-for-items world surface (tail items) threshold
                (if (node_eq trial (lwo-none)) field
                    (lwo-field-add field trial))))))
(defn lwoec-trials-for-current-items (surface items field)
    (if (eq (len items) 0) field
        (do
            (let trial
                (lwoec-trial-for-current-example surface (head items)))
            (lwoec-trials-for-current-items surface (tail items)
                (if (node_eq trial (lwo-none)) field
                    (lwo-field-add field trial))))))
(defn lwoec-signature-items (items signature-items)
    (if (eq (len items) 0) signature-items
        (lwoec-signature-items (tail items)
            (append signature-items
                (list
                    (lwoe-signature-item
                        (lwoec-trial-example (head items))
                        (lwoec-trial-output (head items))))))))
(defn lwoec-trial-states
    (items any-consistent any-divergent any-unresolved)
    (if (eq (len items) 0)
        (if (eq any-divergent 1) (lwph-divergent)
            (if (and (eq any-consistent 1)
                     (eq any-unresolved 0))
                (lwph-consistent) (lwph-unresolved)))
        (do
            (let state (lwoec-trial-state (head items)))
            (lwoec-trial-states (tail items)
                (if (eq (lwph-consistent? state) 1) 1 any-consistent)
                (if (eq (lwph-divergent? state) 1) 1 any-divergent)
                (if (eq (lwph-unresolved? state) 1) 1 any-unresolved)))))

; children: generated surface, trials, exact signature, state, alternatives,
;           unknowns, local path
(defn lwoec-profile
    (surface trials signature state alternatives unknowns)
    (intern_node LWOEC-PROFILE
        (list surface trials signature state alternatives unknowns
              (lwo-local-path))))
(defn lwoec-profile? (cell) (lwo-category? cell LWOEC-PROFILE))
(defn lwoec-profile-surface (profile) (nth (node_children profile) 0))
(defn lwoec-profile-trials (profile) (nth (node_children profile) 1))
(defn lwoec-profile-signature (profile) (nth (node_children profile) 2))
(defn lwoec-profile-state (profile) (nth (node_children profile) 3))
(defn lwoec-profile-alternatives (profile) (nth (node_children profile) 4))
(defn lwoec-profile-unknowns (profile) (nth (node_children profile) 5))
(defn lwoec-profile-path (profile) (nth (node_children profile) 6))
(defn lwoec-example-alternatives-items (items field)
    (if (eq (len items) 0) field
        (lwoec-example-alternatives-items (tail items)
            (lwoec-union-items
                (lwo-field-items
                    (lwoec-example-alternatives (head items))) field))))
(defn lwoec-example-unknowns-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown (lwoec-example-unknown (head items)))
            (lwoec-example-unknowns-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))
(defn lwoec-profile-from-trials
    (blueprint component-profile examples surface trials)
    (if (not (eq (lwo-field-size trials)
                 (lwo-field-size examples))) (lwo-none)
        (do
            (let component-alternatives
                (lwoe-profile-alternatives component-profile))
            (let alternatives
                (lwo-field-add
                    (lwoec-union-items
                        (lwo-field-items component-alternatives)
                        (lwoec-example-alternatives-items
                            (lwo-field-items examples)
                            (lwoec-blueprint-alternatives blueprint)))
                    (lwoec-surface-recipe surface)))
            (let unknowns
                (lwoec-example-unknowns-items
                    (lwo-field-items examples)
                    (lwoec-union-items
                        (lwo-field-items
                            (lwoe-profile-unknowns component-profile))
                        (if (node_eq
                              (lwoec-blueprint-unknown blueprint)
                              (lwo-none))
                            (lwo-empty-field)
                            (lwo-field-add (lwo-empty-field)
                                (lwoec-blueprint-unknown blueprint))))))
            (lwoec-profile surface trials
                (lwoe-signature
                    (lwoec-signature-items
                        (lwo-field-items trials) (list)))
                (lwoec-trial-states
                    (lwo-field-items trials) 0 0 0)
                alternatives unknowns))))
(defn lwoec-profile-for
    (world blueprint component-profile examples threshold)
    (do
        (let surface (lwoec-surface-for blueprint component-profile))
        (let trials
            (lwoec-trials-for-items world surface
                (lwo-field-items examples) threshold (lwo-empty-field)))
        (lwoec-profile-from-trials blueprint component-profile examples
            surface trials)))
(defn lwoec-profile-for-current-examples
    (blueprint component-profile examples)
    (do
        (let surface (lwoec-surface-for blueprint component-profile))
        (let trials
            (lwoec-trials-for-current-items surface
                (lwo-field-items examples) (lwo-empty-field)))
        (lwoec-profile-from-trials blueprint component-profile examples
            surface trials)))
(defn lwoec-profiles-for-items
    (world blueprint component-items examples threshold field)
    (if (eq (len component-items) 0) field
        (do
            (let profile
                (lwoec-profile-for world blueprint
                    (head component-items) examples threshold))
            (lwoec-profiles-for-items world blueprint
                (tail component-items) examples threshold
                (if (node_eq profile (lwo-none)) field
                    (lwo-field-add field profile))))))
(defn lwoec-profiles-for-current-items
    (blueprint component-items examples field)
    (if (eq (len component-items) 0) field
        (do
            (let profile
                (lwoec-profile-for-current-examples blueprint
                    (head component-items) examples))
            (lwoec-profiles-for-current-items blueprint
                (tail component-items) examples
                (if (node_eq profile (lwo-none)) field
                    (lwo-field-add field profile))))))
(defn lwoec-filter-profiles (items state field)
    (if (eq (len items) 0) field
        (lwoec-filter-profiles (tail items) state
            (if (node_eq (lwoec-profile-state (head items)) state)
                (lwo-field-add field (head items)) field))))

; --- representative-free behavior classes --------------------------

(defn lwoec-signatures-for-profiles (items field)
    (if (eq (len items) 0) field
        (lwoec-signatures-for-profiles (tail items)
            (lwo-field-add field
                (lwoec-profile-signature (head items))))))
(defn lwoec-profiles-with-signature (items signature field)
    (if (eq (len items) 0) field
        (lwoec-profiles-with-signature (tail items) signature
            (if (node_eq
                    (lwoec-profile-signature (head items)) signature)
                (lwo-field-add field (head items)) field))))
(defn lwoec-class (signature profiles alternatives unknowns)
    (intern_node LWOEC-CLASS
        (list signature profiles alternatives unknowns (lwo-local-path))))
(defn lwoec-class? (cell) (lwo-category? cell LWOEC-CLASS))
(defn lwoec-class-signature (class) (nth (node_children class) 0))
(defn lwoec-class-profiles (class) (nth (node_children class) 1))
(defn lwoec-class-alternatives (class) (nth (node_children class) 2))
(defn lwoec-class-unknowns (class) (nth (node_children class) 3))
(defn lwoec-class-path (class) (nth (node_children class) 4))
(defn lwoec-profile-alternatives-items (items field)
    (if (eq (len items) 0) field
        (lwoec-profile-alternatives-items (tail items)
            (lwoec-union-items
                (lwo-field-items
                    (lwoec-profile-alternatives (head items))) field))))
(defn lwoec-profile-unknowns-items (items field)
    (if (eq (len items) 0) field
        (lwoec-profile-unknowns-items (tail items)
            (lwoec-union-items
                (lwo-field-items
                    (lwoec-profile-unknowns (head items))) field))))
(defn lwoec-classes-for-signatures
    (signatures profiles field)
    (if (eq (len signatures) 0) field
        (do
            (let signature (head signatures))
            (let members
                (lwoec-profiles-with-signature
                    profiles signature (lwo-empty-field)))
            (lwoec-classes-for-signatures (tail signatures) profiles
                (lwo-field-add field
                    (lwoec-class signature members
                        (lwoec-profile-alternatives-items
                            (lwo-field-items members) (lwo-empty-field))
                        (lwoec-profile-unknowns-items
                            (lwo-field-items members)
                            (lwo-empty-field))))))))

; --- exact field, proposal, and consent boundary --------------------

(defn lwoec-example-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let example (head items))
            (let with-example
                (lwoec-attributions world example field))
            (lwoec-example-witnesses-items world (tail items)
                (lwsr-codec-value-witnesses world
                    (lwo-field-items
                        (lwoec-example-values example)) with-example)))))
(defn lwoec-field-witnesses (world blueprint examples)
    (do
        (let component (lwoec-blueprint-component blueprint))
        (let component-field (lwo-emergent-shape component))
        (let with-field
            (lwoec-union-items
                (lwo-field-items
                    (lwoe-field-witness-field component-field))
                (lwo-empty-field)))
        (let with-component
            (lwoec-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world component))
                with-field))
        (let with-component-ground
            (lwoec-union-items
                (lwo-field-items (lwo-emergent-witnesses component))
                with-component))
        (let bridge (lwoec-blueprint-bridge blueprint))
        (let with-bridge
            (lwoec-union-items
                (lwo-field-items (lwo-emergent-witnesses bridge))
                with-component-ground))
        (let with-blueprint
            (lwoec-attributions world blueprint with-bridge))
        (let with-codecs
            (lwsr-codec-value-witnesses world
                (lwo-field-items
                    (lwoec-blueprint-codecs blueprint)) with-blueprint))
        (lwoec-example-witnesses-items world
            (lwo-field-items examples) with-codecs)))

; children: blueprint, examples, generated profiles, compatible,
;           contradicted, unresolved, classes, status, alternatives,
;           unknowns, witnesses, threshold, local path
(defn lwoec-field
    (blueprint examples profiles compatible contradicted unresolved classes
     status alternatives unknowns witnesses threshold)
    (intern_node LWOEC-FIELD
        (list blueprint examples profiles compatible contradicted unresolved
              classes status alternatives unknowns witnesses
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwoec-field? (cell) (lwo-category? cell LWOEC-FIELD))
(defn lwoec-field-blueprint (field) (nth (node_children field) 0))
(defn lwoec-field-examples (field) (nth (node_children field) 1))
(defn lwoec-field-profiles (field) (nth (node_children field) 2))
(defn lwoec-field-compatible (field) (nth (node_children field) 3))
(defn lwoec-field-contradicted (field) (nth (node_children field) 4))
(defn lwoec-field-unresolved (field) (nth (node_children field) 5))
(defn lwoec-field-classes (field) (nth (node_children field) 6))
(defn lwoec-field-status (field) (nth (node_children field) 7))
(defn lwoec-field-alternatives (field) (nth (node_children field) 8))
(defn lwoec-field-unknowns (field) (nth (node_children field) 9))
(defn lwoec-field-witness-field (field) (nth (node_children field) 10))
(defn lwoec-field-threshold (field)
    (node_value (nth (node_children field) 11)))
(defn lwoec-field-path (field) (nth (node_children field) 12))
(defn lwoec-field-for (world blueprint threshold)
    (if (eq (lwoec-blueprint-current?
                world blueprint threshold) 0) (lwo-none)
        (do
            (let component-field
                (lwo-emergent-shape
                    (lwoec-blueprint-component blueprint)))
            (let examples
                (lwoec-examples-for-under-current-blueprint
                    world blueprint threshold))
            (if (eq (lwo-field-size examples) 0) (lwo-none)
                (do
                    (let profiles
                        (lwoec-profiles-for-current-items blueprint
                            (lwo-field-items
                                (lwoe-field-compatible component-field))
                            examples (lwo-empty-field)))
                    (let compatible
                        (lwoec-filter-profiles
                            (lwo-field-items profiles)
                            (lwph-consistent) (lwo-empty-field)))
                    (let contradicted
                        (lwoec-filter-profiles
                            (lwo-field-items profiles)
                            (lwph-divergent) (lwo-empty-field)))
                    (let unresolved
                        (lwoec-filter-profiles
                            (lwo-field-items profiles)
                            (lwph-unresolved) (lwo-empty-field)))
                    (let signatures
                        (lwoec-signatures-for-profiles
                            (lwo-field-items compatible)
                            (lwo-empty-field)))
                    (let classes
                        (lwoec-classes-for-signatures
                            (lwo-field-items signatures)
                            (lwo-field-items compatible)
                            (lwo-empty-field)))
                    (let class-count (lwo-field-size classes))
                    (let profile-count (lwo-field-size profiles))
                    (let status
                        (if (eq profile-count 0) (lwph-open)
                            (if (gt class-count 1) (lwph-plural)
                                (if (eq class-count 1) (lwph-singular)
                                    (if (eq (lwo-field-size contradicted)
                                            profile-count)
                                        (lwph-refuted) (lwph-open))))))
                    (lwoec-field blueprint examples profiles compatible
                        contradicted unresolved classes status
                        (lwoec-profile-alternatives-items
                            (lwo-field-items profiles)
                            (lwoec-blueprint-alternatives blueprint))
                        (lwoec-profile-unknowns-items
                            (lwo-field-items profiles)
                            (if (node_eq
                                  (lwoec-blueprint-unknown blueprint)
                                  (lwo-none))
                                (lwo-empty-field)
                                (lwo-field-add (lwo-empty-field)
                                    (lwoec-blueprint-unknown blueprint))))
                        (lwoec-field-witnesses world blueprint examples)
                        threshold))))))

(defn lwoec-origin (blueprint threshold)
    (intern_node LWOEC-ORIGIN
        (list blueprint (intern_trivial_int threshold) (lwo-local-path))))
(defn lwoec-origin-blueprint (origin) (nth (node_children origin) 0))
(defn lwoec-origin-threshold (origin)
    (node_value (nth (node_children origin) 1)))
(defn lwoec-proposal (world blueprint threshold)
    (do
        (let field (lwoec-field-for world blueprint threshold))
        (if (or (node_eq field (lwo-none))
                (eq (lwo-field-size
                        (lwoec-field-profiles field)) 0)) (lwo-none)
            (do
                (let witnesses (lwoec-field-witness-field field))
                (let origin (lwoec-origin blueprint threshold))
                (let candidate
                    (lwo-emergent field witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int
                            (lwo-field-size
                                (lwoec-field-compatible field)))
                        (intern_trivial_int
                            (lwo-field-size
                                (lwoec-field-profiles field)))
                        origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwoec-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwoec-field?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwoec-candidate-current? (world candidate)
    (if (eq (lwoec-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwoec-proposal world
                    (lwoec-origin-blueprint origin)
                    (lwoec-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwoec-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwoec-candidate-current? world candidate) 1)) 1 0))
(defn lwoec-integrate (round proposal action)
    (if (eq (lwoec-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
