// Generic sequence operations. Existing carried-argument APIs adapt through
// lexical closures; tb-first preserves absence separately from empty rows.
import form-stdlib/core.fk;
section [form.bml] {
 class FormTable {
  def tb-first(rows,pred) = nil?(rows) ? nothing() : pred(rows[0]) ? rows[0] : tb-first(rows[1:],pred);
  def tb-find2(rows,pred2,a) = tb-first(rows,row => ((Comparable) pred2(row,a) == 1)) ?? [];
  def tb-any2?(rows,pred2,a) = any?(row => ((Comparable) pred2(row,a) == 1),rows);
  def tb-filter2(rows,pred2,a) = filter(row => ((Comparable) pred2(row,a) == 1),rows);
  def tb-fold(rows,f,acc) = foldl(f,acc,rows);
  def tb-fold3(rows,f3,a,acc) = foldl((acc,row) => f3(acc,row,a),acc,rows);
  def tb-map(rows,f) = map(f,rows);
  // The first equal maximum wins; each key is evaluated once.
  def tb-max-by-go(rows,keyf,best,bestrow) = nil?(rows) ? bestrow : {
   let row=rows[0]; let key=keyf(row);
   key > best ? tb-max-by-go(rows[1:],keyf,key,row) : tb-max-by-go(rows[1:],keyf,best,bestrow);
  };
  def tb-max-by(rows,keyf) = nil?(rows) ? [] : tb-max-by-go(rows[1:],keyf,keyf(rows[0]),rows[0]);
  def tb-join(rows,f,sep) = foldl((acc,row) => len(acc) == 0 ? f(row) : (acc + ((String) sep + f(row))),"",rows);
 }
 0;
}
