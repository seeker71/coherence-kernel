//////////////////////////////////////////////////////////////////////
//
// table.bml
//
// Executable BML. The TABLE ENGINE: generic walks over list-of-row
// tables, taking FUNCTIONS AS VALUES — find, filter, fold, map, any,
// max-by, join — so no surface hand-writes its own row recursion
// again. The dialect carries fn-values but not closures, so every
// higher-order door has a carried-argument twin (pred2/f3 taking an
// extra arg) — closure-free genericity. Registry finds, counsel
// walks, advice scans and their kin all speak these seven words.
//
// preludes: form-stdlib/core.fk
//
// Proven by: form-stdlib/tests/table-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormTable {
        thought table-pattern = list("rows-walk-one-way", "functions-are-values", "carried-arg-replaces-closure");

        def tb-find2(rows, pred2, a) = if eq(len(rows), 0) then list() else if eq(pred2(head(rows), a), 1) then head(rows) else tb-find2(tail(rows), pred2, a);
        def tb-any2?(rows, pred2, a) = if eq(len(tb-find2(rows, pred2, a)), 0) then 0 else 1;
        def tb-filter2-go(rows, pred2, a, acc) = if eq(len(rows), 0) then reverse(acc) else tb-filter2-go(tail(rows), pred2, a, if eq(pred2(head(rows), a), 1) then cons(head(rows), acc) else acc);
        def tb-filter2(rows, pred2, a) = tb-filter2-go(rows, pred2, a, list());
        def tb-fold(rows, f, acc) = if eq(len(rows), 0) then acc else tb-fold(tail(rows), f, f(acc, head(rows)));
        def tb-fold3(rows, f3, a, acc) = if eq(len(rows), 0) then acc else tb-fold3(tail(rows), f3, a, f3(acc, head(rows), a));
        def tb-map-go(rows, f, acc) = if eq(len(rows), 0) then reverse(acc) else tb-map-go(tail(rows), f, cons(f(head(rows)), acc));
        def tb-map(rows, f) = tb-map-go(rows, f, list());
        def tb-max-by-go(rows, keyf, best, bestrow) = if eq(len(rows), 0) then bestrow else if gt(keyf(head(rows)), best) then tb-max-by-go(tail(rows), keyf, keyf(head(rows)), head(rows)) else tb-max-by-go(tail(rows), keyf, best, bestrow);
        def tb-max-by(rows, keyf) = if eq(len(rows), 0) then list() else tb-max-by-go(tail(rows), keyf, keyf(head(rows)), head(rows));
        def tb-join-go(rows, f, sep, acc) = if eq(len(rows), 0) then acc else tb-join-go(tail(rows), f, sep, if eq(str_len(acc), 0) then f(head(rows)) else str_concat(acc, str_concat(sep, f(head(rows)))));
        def tb-join(rows, f, sep) = tb-join-go(rows, f, sep, "");
    }
    0;
}
