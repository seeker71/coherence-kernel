; living-world-lens-channel.fk -- source, lens, resonance, and return stay visible.
;
; A lens is declared as an exact payload with an offered shape. Blueprint,
; executable Recipe, and cell shapes have helpers, but the envelope remains
; open to later shapes. A stack may have no default, no layers, no alternatives,
; and no unknown remainder; none of those slots is compulsory. Alternatives
; remain possibilities rather than silently joining the applied layer chain.
;
; A pass preserves the pure source, the value arriving at this direction, every
; applied step, and the final result. Each step retains flow/change evidence and
; an optional open choice. A choice may itself have no primary, any number of
; alternatives, and an explicit unknowable remainder. Nothing is coerced into
; rejection, expiration, identity, or action.
;
; Recipe lenses have an executable extension in living-world-recipe-execution:
; an exact source Recipe runs dynamically through the Form-native
; form-eval-full body and binds its result beside before, flow, and changes.
; Opaque pre-interned Recipe NodeIDs still lack callable walk_recipe in the
; current source seed; that narrower carrier boundary remains named.
;
; Declarations and exchanges are ordinary living-world cells. Their source is
; recovered from active attribution, and revocation makes a pass non-current.
; This is the Form-native real-time field path; it performs no host or network
; I/O and places no remote oracle in the answer path.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk

(let LWLC-LENS             (bp "LWLC-LENS"))
(let LWLC-BLUEPRINT-SHAPE  (bp "LWLC-BLUEPRINT-SHAPE"))
(let LWLC-RECIPE-SHAPE     (bp "LWLC-RECIPE-SHAPE"))
(let LWLC-CELL-SHAPE       (bp "LWLC-CELL-SHAPE"))
(let LWLC-UNKNOWN          (bp "LWLC-UNKNOWN"))
(let LWLC-LAYERS           (bp "LWLC-LAYERS"))
(let LWLC-STACK            (bp "LWLC-STACK"))
(let LWLC-DECLARATION      (bp "LWLC-DECLARATION"))
(let LWLC-CHOICE           (bp "LWLC-CHOICE"))
(let LWLC-EXECUTION        (bp "LWLC-EXECUTION"))
(let LWLC-STEP             (bp "LWLC-STEP"))
(let LWLC-STEPS            (bp "LWLC-STEPS"))
(let LWLC-PASS             (bp "LWLC-PASS"))
(let LWLC-EXCHANGE         (bp "LWLC-EXCHANGE"))

(defn lwlc-blueprint-shape ()
    (intern_node LWLC-BLUEPRINT-SHAPE (empty)))
(defn lwlc-recipe-shape ()
    (intern_node LWLC-RECIPE-SHAPE (empty)))
(defn lwlc-cell-shape ()
    (intern_node LWLC-CELL-SHAPE (empty)))

; children: offered shape, exact lens payload, optional evidence, local path
(defn lwlc-lens (shape payload evidence)
    (intern_node LWLC-LENS
        (list shape payload evidence (lwo-local-path))))
(defn lwlc-lens? (cell) (lwo-category? cell LWLC-LENS))
(defn lwlc-lens-shape (lens) (nth (node_children lens) 0))
(defn lwlc-lens-payload (lens) (nth (node_children lens) 1))
(defn lwlc-lens-evidence (lens) (nth (node_children lens) 2))
(defn lwlc-lens-path (lens) (nth (node_children lens) 3))
(defn lwlc-recipe-lens? (lens)
    (if (and (eq (lwlc-lens? lens) 1)
             (node_eq (lwlc-lens-shape lens)
                      (lwlc-recipe-shape))) 1 0))

; Unknowable is inhabited without being made equal to absence.
(defn lwlc-unknown (evidence)
    (intern_node LWLC-UNKNOWN (list evidence (lwo-local-path))))
(defn lwlc-unknown? (cell) (lwo-category? cell LWLC-UNKNOWN))
(defn lwlc-unknown-evidence (cell) (nth (node_children cell) 0))

(defn lwlc-layers (items) (intern_node LWLC-LAYERS items))
(defn lwlc-layers? (cell) (lwo-category? cell LWLC-LAYERS))
(defn lwlc-layer-items (layers) (node_children layers))

(defn lwlc-all-lenses? (items)
    (if (eq (len items) 0) 1
        (if (eq (lwlc-lens? (head items)) 1)
            (lwlc-all-lenses? (tail items)) 0)))

; children: optional default, ordered applied layers, unapplied alternatives,
;           optional unknowable remainder, optional evidence, local path
(defn lwlc-stack (default-lens layers alternatives unknown evidence)
    (intern_node LWLC-STACK
        (list default-lens layers alternatives unknown evidence
              (lwo-local-path))))
(defn lwlc-stack? (cell) (lwo-category? cell LWLC-STACK))
(defn lwlc-stack-default (stack) (nth (node_children stack) 0))
(defn lwlc-stack-layers (stack) (nth (node_children stack) 1))
(defn lwlc-stack-alternatives (stack) (nth (node_children stack) 2))
(defn lwlc-stack-unknown (stack) (nth (node_children stack) 3))
(defn lwlc-stack-evidence (stack) (nth (node_children stack) 4))
(defn lwlc-stack-path (stack) (nth (node_children stack) 5))

(defn lwlc-stack-valid? (stack)
    (if (eq (lwlc-stack? stack) 0) 0
        (do
            (let default-lens (lwlc-stack-default stack))
            (let layers (lwlc-stack-layers stack))
            (let alternatives (lwlc-stack-alternatives stack))
            (let unknown (lwlc-stack-unknown stack))
            (if (and
                    (or (node_eq default-lens (lwo-none))
                        (eq (lwlc-lens? default-lens) 1))
                    (and (eq (lwlc-layers? layers) 1)
                         (and (eq (lwlc-all-lenses?
                                      (lwlc-layer-items layers)) 1)
                              (and (eq (lwo-category?
                                          alternatives LWO-FIELD) 1)
                                   (and (eq (lwlc-all-lenses?
                                            (lwo-field-items alternatives)) 1)
                                        (or (node_eq unknown (lwo-none))
                                            (eq (lwlc-unknown? unknown) 1))))))) 1 0))))

(defn lwlc-stack-applied-lenses (stack)
    (append
        (if (node_eq (lwlc-stack-default stack) (lwo-none))
            (list) (list (lwlc-stack-default stack)))
        (lwlc-layer-items (lwlc-stack-layers stack))))

; children: arbitrary direction cell, stack, optional evidence, local path
(defn lwlc-declaration (direction stack evidence)
    (intern_node LWLC-DECLARATION
        (list direction stack evidence (lwo-local-path))))
(defn lwlc-declaration? (cell) (lwo-category? cell LWLC-DECLARATION))
(defn lwlc-declaration-direction (declaration)
    (nth (node_children declaration) 0))
(defn lwlc-declaration-stack (declaration)
    (nth (node_children declaration) 1))
(defn lwlc-declaration-evidence (declaration)
    (nth (node_children declaration) 2))
(defn lwlc-declaration-path (declaration)
    (nth (node_children declaration) 3))
(defn lwlc-declaration-valid? (declaration)
    (if (and (eq (lwlc-declaration? declaration) 1)
             (eq (lwlc-stack-valid?
                    (lwlc-declaration-stack declaration)) 1)) 1 0))
(defn lwlc-declaration-current? (world declaration)
    (if (and (eq (lwlc-declaration-valid? declaration) 1)
             (eq (lwo-active? world declaration) 1)) 1 0))

; Actions are arbitrary offered cells. Primary, alternatives, and unknowable
; remainder are independently optional.
(defn lwlc-choice (primary alternatives unknown evidence)
    (intern_node LWLC-CHOICE
        (list primary alternatives unknown evidence (lwo-local-path))))
(defn lwlc-choice? (cell) (lwo-category? cell LWLC-CHOICE))
(defn lwlc-choice-primary (choice) (nth (node_children choice) 0))
(defn lwlc-choice-alternatives (choice) (nth (node_children choice) 1))
(defn lwlc-choice-unknown (choice) (nth (node_children choice) 2))
(defn lwlc-choice-evidence (choice) (nth (node_children choice) 3))
(defn lwlc-choice-path (choice) (nth (node_children choice) 4))
(defn lwlc-choice-valid? (choice)
    (if (node_eq choice (lwo-none)) 1
        (if (and (eq (lwlc-choice? choice) 1)
                 (and (eq (lwo-category?
                               (lwlc-choice-alternatives choice)
                               LWO-FIELD) 1)
                      (or (node_eq (lwlc-choice-unknown choice)
                                   (lwo-none))
                          (eq (lwlc-unknown?
                                (lwlc-choice-unknown choice)) 1)))) 1 0)))

; The presently executable floor is an integer-valued Recipe. The exact
; Recipe remains in the receipt; the direct native source witness supplies the
; observed result, never a remote evaluator.
(defn lwlc-execution (lens before result flow changes)
    (intern_node LWLC-EXECUTION
        (list lens before result flow changes (lwo-local-path))))
(defn lwlc-execution? (cell) (lwo-category? cell LWLC-EXECUTION))
(defn lwlc-execution-lens (execution) (nth (node_children execution) 0))
(defn lwlc-execution-before (execution) (nth (node_children execution) 1))
(defn lwlc-execution-result (execution) (nth (node_children execution) 2))
(defn lwlc-execution-flow (execution) (nth (node_children execution) 3))
(defn lwlc-execution-changes (execution) (nth (node_children execution) 4))
(defn lwlc-execution-path (execution) (nth (node_children execution) 5))

; children: before, lens, optional execution, result, flow, changes,
;           optional choice, optional evidence, local path
(defn lwlc-step (before lens execution result flow changes choice evidence)
    (intern_node LWLC-STEP
        (list before lens execution result flow changes choice evidence
              (lwo-local-path))))
(defn lwlc-step? (cell) (lwo-category? cell LWLC-STEP))
(defn lwlc-step-before (step) (nth (node_children step) 0))
(defn lwlc-step-lens (step) (nth (node_children step) 1))
(defn lwlc-step-execution (step) (nth (node_children step) 2))
(defn lwlc-step-result (step) (nth (node_children step) 3))
(defn lwlc-step-flow (step) (nth (node_children step) 4))
(defn lwlc-step-changes (step) (nth (node_children step) 5))
(defn lwlc-step-choice (step) (nth (node_children step) 6))
(defn lwlc-step-evidence (step) (nth (node_children step) 7))
(defn lwlc-step-path (step) (nth (node_children step) 8))

(defn lwlc-step-from-execution (execution choice evidence)
    (if (eq (lwlc-execution? execution) 0) (lwo-none)
        (lwlc-step
            (lwlc-execution-before execution)
            (lwlc-execution-lens execution)
            execution
            (lwlc-execution-result execution)
            (lwlc-execution-flow execution)
            (lwlc-execution-changes execution)
            choice evidence)))

(defn lwlc-step-valid? (step)
    (if (eq (lwlc-step? step) 0) 0
        (do
            (let lens (lwlc-step-lens step))
            (let execution (lwlc-step-execution step))
            (if (and (eq (lwlc-lens? lens) 1)
                     (eq (lwlc-choice-valid?
                            (lwlc-step-choice step)) 1))
                (if (eq (lwlc-recipe-lens? lens) 1)
                    (if (and (eq (lwlc-execution? execution) 1)
                             (and (node_eq
                                    (lwlc-execution-lens execution) lens)
                                  (and (node_eq
                                        (lwlc-execution-before execution)
                                        (lwlc-step-before step))
                                       (node_eq
                                        (lwlc-execution-result execution)
                                        (lwlc-step-result step))))) 1 0)
                    (if (node_eq execution (lwo-none)) 1 0))
                0))))

(defn lwlc-steps (items) (intern_node LWLC-STEPS items))
(defn lwlc-steps? (cell) (lwo-category? cell LWLC-STEPS))
(defn lwlc-step-items (steps) (node_children steps))

(defn lwlc-step-chain? (steps lenses before)
    (if (eq (len lenses) 0)
        (if (eq (len steps) 0) 1 0)
        (if (eq (len steps) 0) 0
            (do
                (let step (head steps))
                (if (and (eq (lwlc-step-valid? step) 1)
                         (and (node_eq (lwlc-step-before step) before)
                              (node_eq (lwlc-step-lens step)
                                       (head lenses))))
                    (lwlc-step-chain? (tail steps) (tail lenses)
                        (lwlc-step-result step)) 0)))))

(defn lwlc-final-result (steps before)
    (if (eq (len steps) 0) before
        (lwlc-final-result (tail steps)
            (lwlc-step-result (head steps)))))

; children: declaration, invariant pure source, arriving source for this
;           direction, exact steps, final result, optional evidence, local path
(defn lwlc-pass (declaration pure-source arriving steps result evidence)
    (intern_node LWLC-PASS
        (list declaration pure-source arriving steps result evidence
              (lwo-local-path))))
(defn lwlc-pass? (cell) (lwo-category? cell LWLC-PASS))
(defn lwlc-pass-declaration (pass) (nth (node_children pass) 0))
(defn lwlc-pass-pure-source (pass) (nth (node_children pass) 1))
(defn lwlc-pass-arriving (pass) (nth (node_children pass) 2))
(defn lwlc-pass-steps (pass) (nth (node_children pass) 3))
(defn lwlc-pass-result (pass) (nth (node_children pass) 4))
(defn lwlc-pass-evidence (pass) (nth (node_children pass) 5))
(defn lwlc-pass-path (pass) (nth (node_children pass) 6))

(defn lwlc-pass-valid? (pass)
    (if (eq (lwlc-pass? pass) 0) 0
        (do
            (let declaration (lwlc-pass-declaration pass))
            (let steps (lwlc-pass-steps pass))
            (if (and (eq (lwlc-declaration-valid? declaration) 1)
                     (eq (lwlc-steps? steps) 1))
                (do
                    (let items (lwlc-step-items steps))
                    (let lenses
                        (lwlc-stack-applied-lenses
                            (lwlc-declaration-stack declaration)))
                    (if (and (eq (lwlc-step-chain? items lenses
                                      (lwlc-pass-arriving pass)) 1)
                             (node_eq (lwlc-pass-result pass)
                                (lwlc-final-result items
                                    (lwlc-pass-arriving pass)))) 1 0))
                0))))

(defn lwlc-pass-current? (world pass)
    (if (and (eq (lwlc-pass-valid? pass) 1)
             (eq (lwlc-declaration-current? world
                    (lwlc-pass-declaration pass)) 1)) 1 0))

; Both directional passes are optional. Alternatives are retained without
; being selected; unknowable may coexist with either pass and every option.
(defn lwlc-exchange
    (pure-source outward return alternatives unknown evidence)
    (intern_node LWLC-EXCHANGE
        (list pure-source outward return alternatives unknown evidence
              (lwo-local-path))))
(defn lwlc-exchange? (cell) (lwo-category? cell LWLC-EXCHANGE))
(defn lwlc-exchange-pure-source (exchange) (nth (node_children exchange) 0))
(defn lwlc-exchange-outward (exchange) (nth (node_children exchange) 1))
(defn lwlc-exchange-return (exchange) (nth (node_children exchange) 2))
(defn lwlc-exchange-alternatives (exchange) (nth (node_children exchange) 3))
(defn lwlc-exchange-unknown (exchange) (nth (node_children exchange) 4))
(defn lwlc-exchange-evidence (exchange) (nth (node_children exchange) 5))
(defn lwlc-exchange-path (exchange) (nth (node_children exchange) 6))

(defn lwlc-optional-pass-valid? (pure-source pass)
    (if (node_eq pass (lwo-none)) 1
        (if (and (eq (lwlc-pass-valid? pass) 1)
                 (node_eq (lwlc-pass-pure-source pass)
                          pure-source)) 1 0)))

(defn lwlc-exchange-valid? (exchange)
    (if (eq (lwlc-exchange? exchange) 0) 0
        (do
            (let pure-source (lwlc-exchange-pure-source exchange))
            (if (and (eq (lwlc-optional-pass-valid? pure-source
                              (lwlc-exchange-outward exchange)) 1)
                     (and (eq (lwlc-optional-pass-valid? pure-source
                                   (lwlc-exchange-return exchange)) 1)
                          (and (eq (lwo-category?
                                      (lwlc-exchange-alternatives exchange)
                                      LWO-FIELD) 1)
                               (or (node_eq
                                    (lwlc-exchange-unknown exchange)
                                    (lwo-none))
                                   (eq (lwlc-unknown?
                                        (lwlc-exchange-unknown exchange))
                                       1))))) 1 0))))

(defn lwlc-optional-pass-current? (world pass)
    (if (node_eq pass (lwo-none)) 1
        (lwlc-pass-current? world pass)))

(defn lwlc-exchange-current? (world exchange)
    (if (and (eq (lwlc-exchange-valid? exchange) 1)
             (and (eq (lwlc-optional-pass-current? world
                          (lwlc-exchange-outward exchange)) 1)
                  (eq (lwlc-optional-pass-current? world
                          (lwlc-exchange-return exchange)) 1))) 1 0))

0
