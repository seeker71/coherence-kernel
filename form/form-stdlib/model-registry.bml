// Model paths and roles are data; GGUF supplies architecture. The lane table
// names current session support, while readiness reads the local artifacts.
// preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/form-cli-model-generate.fk

section [form.bml] {
    class FormModelRegistry {
        def mr-row(name, path, roles) = list(name, path, roles);
        def mr-name(r) = r[0];
        def mr-path(r) = r[1];
        def mr-roles(r) = r[2];
        // Sharded GGUF rows name the first (header) shard. Non-GGUF inputs
        // carry no GGUF architecture; a registry row alone is not admission.
        def mr-registry() = list(mr-row("qwen38-q8", "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf", "answer review"), mr-row("qwen38-q4", "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q4_K_M.gguf", "fast-answer review"), mr-row("katcoder", "/Users/ursmuff/models/katcoder/kat-coder-v2.5-dev-compact.gguf", "code"), mr-row("form-llama-q4", "/Users/ursmuff/models/form-llama-vital-ground-q4_k_m.gguf", "input lower"), mr-row("qwen38-flash-next-q2", mr-flash-next-prefix() ++ mr-shard-name(1, 3), "glass challenger"), mr-row("ds4flash", "/Users/ursmuff/models/ds4/ds4flash-v5mx-reap25-type40-mxfp8lt-dspark-v1.gguf", "teacher tokenizer"), mr-row("whisper-large-v3-turbo", "/Users/ursmuff/.cache/whisper.cpp/ggml-large-v3-turbo.bin", "speech-stt teacher"), mr-row("whisper-large-v3-turbo-safetensors", "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-large-v3-turbo/snapshots/a4aaeec0636e6fef84abdcbe3544cb2bf7e9f6fb", "native-speech-stt"), mr-row("whisper-tiny-fixture", "model/fixtures/whisper-tiny", "speech-fixture"), mr-row("llama32-3b", "/Users/ursmuff/.ollama/models/blobs/sha256-dde5aa3fc5ffc17176b5e8bdc82f587b24b2678c6c66101bf7da77af9f7ccdff", "champion metal-witness"), mr-row("llama32-1b", "/Users/ursmuff/.ollama/models/blobs/sha256-74701a8c35f6c8d9a4b91f3f3497643001d63e0c7a84e085bed452548fa88d45", "dense-witness"), mr-row("llama32-3b-mlx-4bit", "/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--Llama-3.2-3B-Instruct-4bit/snapshots/7f0dc925e0d0afb0322d96f9255cfddf2ba5636e", "train-base"));
        def mr-flash-next-prefix() = "/Users/ursmuff/models/qwen38-flash-next/UD-Q2_K_XL/Qwen3.8-Flash-Next-UD-Q2_K_XL-";
        def mr-pad5(n) = substring("00000" ++ int_to_str(n), str_len(int_to_str(n)), str_len(int_to_str(n)) + 5);
        def mr-shard-name(i, of) = mr-pad5(i) ++ "-of-" ++ mr-pad5(of) ++ ".gguf";
        def mr-shard-prefix(r) = substring(mr-path(r), 0, str_len(mr-path(r)) - str_len(mr-shard-name(1, 3)));

        def mr-none() = mr-row("", "", "");
        def mr-find(name) = tb-first(mr-registry(),r => (String) mr-name(r) == name) ?? mr-none();
        def mr-has-role?(r, role) = str_find(" " ++ mr-roles(r) ++ " ", " " ++ role ++ " ", 0) >= 0 ? 1 : 0;
        def mr-for-role(role) = tb-first(mr-registry(),r => mr-has-role?(r,role)) ?? mr-none();
        def mr-arch(r) = fcmg-arch(fcmg-src(mr-path(r)));

        // Wiredness is what the session door (fcmg-arch-door) says today:
        // qwen4exp is "unfinished on this door", deepseek4 is pointed at the
        // DS4 control stack (route / ds4-query) — both typed, neither wired.
        def mr-lane-rows() = list(list("qwen35", "q38", 1), list("qwen35moe", "qsx", 0), list("llama", "dth", 0), list("qwen4exp", "q4t", 0), list("deepseek4", "ds4-query", 0));
        def mr-lane-row(arch) = tb-first(mr-lane-rows(),r => (String) head(r) == arch) ?? list(arch,"unknown",0);
        def mr-lane-for(arch) = mr-lane-row(arch)[1];
        def mr-wired?(arch) = mr-lane-row(arch)[2];

        def mr-names() = tb-join(mr-registry(), mr-name, ",");

        // Admission reads the local artifact, seal, codec index and crystal.
        def mr-suffix-seal() = ".form-seal";
        def mr-suffix-tokfast() = ".form-tokfast-v2";
        def mr-suffix-crystal() = ".form-crystal";
        def mr-file?(p) = file_mtime(p) > 0 ? 1 : 0;
        def mr-side?(path, suffix) = mr-file?(path ++ suffix);
        def mr-ready-kv(k, v) = k ++ "=" ++ int_to_str(v);
        def mr-readiness(r) = mr-ready-kv("artifact", mr-file?(mr-path(r))) ++ " " ++ mr-ready-kv("seal", mr-side?(mr-path(r), mr-suffix-seal())) ++ " " ++ mr-ready-kv("tokfast", mr-side?(mr-path(r), mr-suffix-tokfast())) ++ " " ++ mr-ready-kv("crystal", mr-side?(mr-path(r), mr-suffix-crystal()));
    }
    0;
}
