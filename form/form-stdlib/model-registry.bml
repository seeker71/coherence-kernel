//////////////////////////////////////////////////////////////////////
//
// model-registry.bml
//
// Executable BML. The MODEL REGISTRY: every model the body can stand,
// as rows of data — name, artifact path, and the roles it serves. No
// consumer special-cases a model: the compare door opens by name, the
// session door admits by the lane table, the birth resolves its model
// by role when no path is handed in. What a row must never state is
// what the artifact already declares: the architecture is READ from
// the gguf itself (heldname — the held thing names itself), and
// the arch-to-lane table says which token-handle lane serves it and
// whether that lane is wired into the session door TODAY. An unwired
// lane is a typed refusal naming the missing door, never silence and
// never a lie.
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/form-cli-model-generate.fk
//
// Proven by: form-stdlib/tests/model-registry-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormModelRegistry {
        thought model-registry-pattern = list("models-are-rows", "arch-read-from-artifact", "lane-is-a-table", "unwired-is-typed", "no-special-casing");

        def mr-row(name, path, roles) = list(name, path, roles);
        def mr-name(r) = nth(r, 0);
        def mr-path(r) = nth(r, 1);
        def mr-roles(r) = nth(r, 2);
        def mr-registry() = list(mr-row("qwen38-q8", "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf", "answer review"), mr-row("qwen38-q4", "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q4_K_M.gguf", "fast-answer review"), mr-row("katcoder", "/Users/ursmuff/models/katcoder/kat-coder-v2.5-dev-compact.gguf", "code"), mr-row("form-llama-q4", "/Users/ursmuff/models/form-llama-vital-ground-q4_k_m.gguf", "input lower"));

        def mr-none() = mr-row("", "", "");
        // finds walk the generic table engine; predicates carry their
        // argument (fn-values without closures).
        def mr-name-is?(r, name) = if str_eq(mr-name(r), name) then 1 else 0;
        def mr-or-none(r) = if eq(len(r), 0) then mr-none() else r;
        def mr-find(name) = mr-or-none(tb-find2(mr-registry(), mr-name-is?, name));
        def mr-has-role?(r, role) = if ge(str_find(str_concat(" ", str_concat(mr-roles(r), " ")), str_concat(" ", str_concat(role, " ")), 0), 0) then 1 else 0;
        def mr-for-role(role) = mr-or-none(tb-find2(mr-registry(), mr-has-role?, role));
        def mr-arch(r) = fcmg-arch(fcmg-src(mr-path(r)));

        def mr-lane-rows() = list(list("qwen35", "q38", 1), list("qwen35moe", "qsx", 0), list("llama", "dth", 0));
        def mr-lane-go(rows, arch, want) = if eq(len(rows), 0) then if eq(want, 1) then "unknown" else 0 else if str_eq(nth(head(rows), 0), arch) then if eq(want, 1) then nth(head(rows), 1) else nth(head(rows), 2) else mr-lane-go(tail(rows), arch, want);
        def mr-lane-for(arch) = mr-lane-go(mr-lane-rows(), arch, 1);
        def mr-wired?(arch) = mr-lane-go(mr-lane-rows(), arch, 0);

        def mr-names() = tb-join(mr-registry(), mr-name, ",");

        // READINESS is witnessed, never declared: which treatments an
        // artifact can receive today is read off the disk beside it —
        // the seal, the tokenizer index, the crystal. A model missing a
        // sidecar is served by fallbacks whose quality is not the peer
        // lane's (witnessed 2026-09-01: the unindexed Q4 twin decoded
        // garbage through the scanner fallback); the readout makes that
        // fate visible before the admission, as data.
        def mr-suffix-seal() = ".form-seal";
        def mr-suffix-tokfast() = ".form-tokfast-v2";
        def mr-suffix-crystal() = ".form-crystal";
        def mr-file?(p) = if gt(file_mtime(p), 0) then 1 else 0;
        def mr-side?(path, suffix) = mr-file?(str_concat(path, suffix));
        def mr-ready-kv(k, v) = str_concat(k, str_concat("=", int_to_str(v)));
        def mr-readiness(r) = str_concat(mr-ready-kv("artifact", mr-file?(mr-path(r))), str_concat(" ", str_concat(mr-ready-kv("seal", mr-side?(mr-path(r), mr-suffix-seal())), str_concat(" ", str_concat(mr-ready-kv("tokfast", mr-side?(mr-path(r), mr-suffix-tokfast())), str_concat(" ", mr-ready-kv("crystal", mr-side?(mr-path(r), mr-suffix-crystal()))))))));
    }
    0;
}
