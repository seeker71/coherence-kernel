// channel-protocol-choice-floor.fk - shared floor for channel/interface/protocol choice.
//
// This recipe does not replace channel-interface, channel-flow, kernel-http,
// or choice-receipt. It names their current shared floor and
// the north star that asks BML/Form to expose the same shape as first-class
// grammar expressions with inspectable receipts.
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    def cpcf-record(kind, value) = [kind, value];
    def cpcf-record-kind(record) = record[0];
    def cpcf-record-value(record) = record[1];
    def cpcf-source(kind, path, proof, status) = [kind, path, proof, status];
    def cpcf-source-kind(source) = source[0];
    def cpcf-source-path(source) = source[1];
    def cpcf-source-proof(source) = source[2];
    def cpcf-source-status(source) = source[3];
    def cpcf-floor() = "channel/interface/protocol/dynamic-choice floor: a cell can offer an interface, a flow can be received by the receiver offer, kernel-http route choice crosses four-way, choice receipts keep trace-preserving success, fail and silence rows, and BML choiceReceipt routing metadata lowers into route-choice runtime across four-way and can select a real kernel route candidate.";
    def cpcf-north-star() = "north star: channel, interface, protocol, capability, route choice, receipt, and learning become first-class Form/BML grammar expressions that lower to native recipes, execute across supported lanes, and always return inspectable receipts before any route, protocol, model, or JIT choice is trusted.";
    def cpcf-next-step() = "next step: carry BML protocol/capability runtime lowering from route choice into model and protocol choices, and persist returned route-choice signatures where choices execute.";
    def cpcf-related-sources() = [cpcf-source("form-recipe", "form/form-stdlib/channel-interface.fk", "form/form-stdlib/tests/channel-flow-band.bml", "proven-four-way"), cpcf-source("form-recipe", "form/form-stdlib/channel-flow.fk", "form/form-stdlib/tests/channel-flow-band.bml", "proven-four-way"), cpcf-source("form-recipe", "form/form-stdlib/kernel-http.fk", "form/form-stdlib/tests/kernel-http-band.bml", "proven-four-way"), cpcf-source("form-recipe", "form/form-stdlib/choice-receipt.fk", "form/form-stdlib/tests/choice-receipt-band.fk", "proven-four-way"), cpcf-source("form-recipe", "form/form-stdlib/bml-route-choice-runtime.fk", "form/form-stdlib/tests/bml-route-choice-runtime-band.fk", "proven-four-way"), cpcf-source("bml-source", "form/form-stdlib/bml-source.fk", "form/form-stdlib/tests/bml-route-choice-runtime-band.fk", "proven-four-way"), cpcf-source("bml-grammar", "form/form-stdlib/bml.fk", "form/form-stdlib/tests/bml-generics-band.fk", "proven"), cpcf-source("bml-model", "form/form-stdlib/grammars/bml.fk", "form/form-stdlib/tests/bml-full-class-model-proof.fk", "proven")];
    def cpcf-proven-source-count(sources) = nil?(sources) ? 0 : ((String) cpcf-source-status(head(sources)) == "proven" || (String) cpcf-source-status(head(sources)) == "proven-four-way" ? 1 : 0) + cpcf-proven-source-count(tail(sources));
    def cpcf-source-find-kind(sources, kind) = nil?(sources) ? empty() : (String) cpcf-source-kind(head(sources)) == kind ? head(sources) : cpcf-source-find-kind(tail(sources), kind);
    def cpcf-source-find-path(sources, path) = nil?(sources) ? empty() : (String) cpcf-source-path(head(sources)) == path ? head(sources) : cpcf-source-find-path(tail(sources), path);
    def cpcf-source-find-proof(sources, proof) = nil?(sources) ? empty() : (String) cpcf-source-proof(head(sources)) == proof ? head(sources) : cpcf-source-find-proof(tail(sources), proof);
    def cpcf-validation-round(round, agent, focus, result) = ["validation-round", round, agent, focus, result];
    def cpcf-validation-round-round(round) = round[1];
    def cpcf-validation-round-agent(round) = round[2];
    def cpcf-validation-round-focus(round) = round[3];
    def cpcf-validation-round-result(round) = round[4];
    def cpcf-validation-rounds() = [cpcf-validation-round(1, "claude-cli", "proof floor and overclaim review", "soften unified protocol-plan and route/call wording; name three-kernel and fourth-arm gaps"), cpcf-validation-round(2, "gemini-cli", "component citations and next-step scope", "add branch-choice-order and tool-channel citations; narrow next step to one vertical BML slice"), cpcf-validation-round(3, "grok-cli", "recorded artifact and runtime gap review", "cite canonical .fk/.form/band records; name receipts-before-trust and production routing as not-yet-proven")];
    def cpcf-current-gaps() = ["BML protocol/capability rows lower through route-choice runtime; model and protocol runtime choice lowering remains open", "receipts-before-trust is an invariant, not yet carried through every runtime choice"];
    def cpcf-floor-recipe() = [cpcf-record("floor", cpcf-floor()), cpcf-record("north-star", cpcf-north-star()), cpcf-record("next-step", cpcf-next-step()), cpcf-record("related-sources", cpcf-related-sources()), cpcf-record("validation-rounds", cpcf-validation-rounds()), cpcf-record("current-gaps", cpcf-current-gaps())];
    0;
}
