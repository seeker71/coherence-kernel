// Discover host models from bounded GGUF/safetensors headers and tensor manifests.
// Walk files before subdirectories, retaining reverse discovery order and unique paths.
// Transient downloads and ledger-owned shards stay outside the selectable list.
// Missing files remain absent; a file lost between discovery and reading is reported.
// The caller supplies roots; existing sibling model homes join the same walk.
// preludes: form-stdlib/core.fk form-stdlib/gguf-meta.fk
section [form.bml] {
    def md-header-bytes() = 1048576;
    def md-join(dir, name) = str_concat(dir, str_concat("/", name));
    def md-magic() = "GGUF";
    def md-gguf?(path) = fs_is_dir(path) ? 0 : (String) read_file_slice(path, 0, 4) == md-magic() ? 1 : 0;
    def md-arch(src) = gmt-str(src, "general.architecture");
    def md-nlayer(src, arch) = {
        let n = gmt-u32(src, str_concat(arch, ".block_count"));
        (Comparable) n == gmt-absent() ? gmt-u32(src, str_concat(arch, ".vision.block_count")) : n;
    };
    def md-layers-str(src, arch) = {
        let n = md-nlayer(src, arch);
        (Comparable) n == gmt-absent() ? "(header declares no block_count)" : int_to_str(n);
    };
    def md-name(src) = {
        let n = gmt-str(src, "general.name");
        (String) n == "" ? "(header names no model)" : n;
    };
    def md-gone(path) = str_concat(path, "   (the file left between the look and the read — nothing to describe)");
    def md-gguf-describe(path) = {
        let src = read_file_slice(path, 0, md-header-bytes());
        nothing?(src) ? md-gone(path) : {
            let arch = md-arch(src);
            (String) arch == "" ? str_concat(path, "   (not a GGUF header this body can read — unfinished, not unsupported)") : str_concat(path, str_concat("   arch=", str_concat(arch, str_concat("  layers=", str_concat(md-layers-str(src, arch), str_concat("  name=", md-name(src)))))));
        };
    };
    def md-q() = "\"";
    def md-safetensors?(path) = fs_is_dir(path) ? 0 : {
        let w = read_file_slice(path, 0, 10);
        nothing?(w) ? 0 : str_len(w) < 10 ? 0 : (Comparable) str_byte_at(w, 8) == 123 && (Comparable) str_byte_at(w, 9) == 34 ? {
            let hlen = egg-u64(w, 0);
            hlen < 2 ? 0 : {
                let lastb = read_file_slice(path, 7 + hlen, 1);
                nothing?(lastb) ? 0 : (Comparable) str_len(lastb) == 1 ? (Comparable) str_byte_at(lastb, 0) == 125 || (Comparable) str_byte_at(lastb, 0) == 32 ? 1 : 0 : 0;
            };
        } : 0;
    };
    def md-match-at?(h, n, i, j, nlen) = j >= nlen ? 1 : (Comparable) str_byte_at(h, i + j) == str_byte_at(n, j) ? md-match-at?(h, n, i, j + 1, nlen) : 0;
    def md-find-loop(h, n, i, hstop, nlen) = i > hstop ? 0 - 1 : (Comparable) md-match-at?(h, n, i, 0, nlen) == 1 ? i : md-find-loop(h, n, i + 1, hstop, nlen);
    def md-find-bytes(h, n, from) = md-find-loop(h, n, from, str_len(h) - str_len(n), str_len(n));
    def md-digit?(b) = b >= 48 && b <= 57;
    def md-int-at(s, i, acc) = i >= str_len(s) ? acc : {
        let b = str_byte_at(s, i);
        md-digit?(b) ? md-int-at(s, i + 1, acc * 10 + (b - 48)) : acc;
    };
    def md-skip-digits(s, i) = i >= str_len(s) ? i : md-digit?(str_byte_at(s, i)) ? md-skip-digits(s, i + 1) : i;
    def md-st-needle() = str_concat(md-q(), str_concat("data_offsets", md-q()));
    def md-st-scan(hdr, from, count, maxend) = {
        let k = md-find-bytes(hdr, md-st-needle(), from);
        k < 0 ? list(count, maxend) : {
            let j = md-skip-digits(hdr, k + 16);
            let e = md-int-at(hdr, j + 1, 0);
            md-st-scan(hdr, j + 1, count + 1, e > maxend ? e : maxend);
        };
    };
    def md-st-config-hint(path) = {
        let cfg = read_file_slice(md-join(md-parent(path), "config.json"), 0, 262144);
        nothing?(cfg) ? "(no config.json beside it)" : {
            let k = md-find-bytes(cfg, str_concat(md-q(), str_concat("model_type", md-q())), 0);
            k < 0 ? "(config.json names no model_type)" : {
                let v1 = md-find-bytes(cfg, md-q(), k + 12);
                let v2 = v1 < 0 ? 0 - 1 : md-find-bytes(cfg, md-q(), v1 + 1);
                v2 < 0 ? "(config.json names no model_type)" : str_concat("config=", substring(cfg, v1 + 1, v2));
            };
        };
    };
    def md-st-describe(path) = {
        let head8 = read_file_slice(path, 0, 8);
        nothing?(head8) ? md-gone(path) : {
            let hlen = egg-u64(head8, 0);
            let hdr = read_file_slice(path, 8, hlen > md-header-bytes() ? md-header-bytes() : hlen);
            nothing?(hdr) ? md-gone(path) : str_len(hdr) < hlen ? str_concat(path, "   (safetensors header wider than this body's read window — unfinished, not unsupported)") : {
                let facts = md-st-scan(hdr, 0, 0, 0);
                str_concat(path, str_concat("   safetensors  tensors=", str_concat(int_to_str(nth(facts, 0)), str_concat("  bytes=", str_concat(int_to_str(8 + (hlen + nth(facts, 1))), str_concat("  ", md-st-config-hint(path)))))));
            };
        };
    };
    def md-manifest-needle() = str_concat(md-q(), str_concat("application/vnd.ollama.image.tensor", md-q()));
    def md-tensor-manifest?(path) = fs_is_dir(path) ? 0 : {
        let first = read_file_slice(path, 0, 1);
        (String) first == "{" ? {
            let src = read_file_slice(path, 0, md-header-bytes());
            nothing?(src) ? 0 : md-find-bytes(src, str_concat(md-q(), str_concat("schemaVersion", md-q())), 0) >= 0 ? md-find-bytes(src, md-manifest-needle(), 0) >= 0 ? 1 : 0 : 0;
        } : 0;
    };
    def md-mani-scan(src, from, count, total) = {
        let k = md-find-bytes(src, md-manifest-needle(), from);
        k < 0 ? list(count, total) : {
            let s = md-find-bytes(src, str_concat(md-q(), str_concat("size", md-q())), k);
            let v = s < 0 ? 0 : md-int-at(src, s + 7, 0);
            md-mani-scan(src, k + 1, count + 1, total + v);
        };
    };
    def md-mani-name(path) = str_concat(md-base(md-parent(path)), str_concat(":", md-base(path)));
    def md-manifest-describe(path) = {
        let src = read_file_slice(path, 0, md-header-bytes());
        nothing?(src) ? md-gone(path) : {
            let facts = md-mani-scan(src, 0, 0, 0);
            str_concat(path, str_concat("   tensor-manifest  model=", str_concat(md-mani-name(path), str_concat("  tensors=", str_concat(int_to_str(nth(facts, 0)), str_concat("  bytes=", int_to_str(nth(facts, 1))))))));
        };
    };
    def md-base(p) = {
        let k = md-last-slash(p, 0, 0 - 1);
        k < 0 ? p : substring(p, k + 1, str_len(p));
    };
    def md-starts-with?(s, pre) = str_len(s) < str_len(pre) ? 0 : (String) substring(s, 0, str_len(pre)) == pre ? 1 : 0;
    def md-hub-blob?(p) = (String) md-base(md-parent(p)) == "blobs" ? md-starts-with?(md-base(md-parent(md-parent(p))), "models--") : 0;
    def md-ledger-blob?(p) = (String) md-base(md-parent(p)) == "blobs" ? fs_is_dir(md-join(md-parent(md-parent(p)), "manifests")) : 0;
    def md-transient-file?(p) = md-find-bytes(p, ".incomplete", 0) >= 0 ? 1 : md-find-bytes(p, ".form-part", 0) >= 0 ? 1 : md-find-bytes(p, ".sparse-incomplete", 0) >= 0 ? 1 : 0;
    def md-model-file?(p) = fs_is_dir(p) ? 0 : (Comparable) md-transient-file?(p) == 1 ? 0 : (Comparable) md-hub-blob?(p) == 1 ? 0 : (Comparable) md-gguf?(p) == 1 ? 1 : (Comparable) md-safetensors?(p) == 1 ? (Comparable) md-ledger-blob?(p) == 1 ? 0 : 1 : md-tensor-manifest?(p);
    def md-describe(path) = (Comparable) md-gguf?(path) == 1 ? md-gguf-describe(path) : (Comparable) md-safetensors?(path) == 1 ? md-st-describe(path) : (Comparable) md-tensor-manifest?(path) == 1 ? md-manifest-describe(path) : str_concat(path, "   (not a model header this body can read — unfinished, not unsupported)");
    def md-path-in?(p, ps) = any?(candidate => (String) p == candidate, ps);
    def md-add(p, acc) = (Comparable) md-path-in?(p, acc) == 1 ? acc : cons(p, acc);
    def md-scan-files(dir, names, acc) = foldl((found, name) => {
        let path = md-join(dir, name);
        (Comparable) md-model-file?(path) == 1 ? md-add(path, found) : found;
    }, acc, names);
    def md-depth() = 4;
    def md-scan-dirs(root, names, acc, depth) = foldl((found, name) => {
        let child = md-join(root, name);
        fs_is_dir(child) ? md-walk(child, found, depth - 1) : found;
    }, acc, names);
    def md-walk(dir, acc, depth) = {
        let names = fs_list(dir);
        let here = md-scan-files(dir, names, acc);
        depth <= 0 ? here : md-scan-dirs(dir, names, here, depth);
    };
    def md-walk-roots(roots, acc) = foldl((found, root) => md-walk(root, found, md-depth()), acc, roots);
    def md-find-in(roots) = md-walk-roots(roots, list());
    def md-kin-suffixes() = list("/.ollama/models/blobs", "/.ollama/models/manifests", "/.cache/huggingface/hub", "/models");
    def md-last-slash(s, i, best) = i >= str_len(s) ? best : md-last-slash(s, i + 1, (Comparable) ord(char_at(s, i)) == 47 ? i : best);
    def md-parent(p) = {
        let k = md-last-slash(p, 0, 0 - 1);
        k < 0 ? p : substring(p, 0, k);
    };
    def md-kin-try(base, suffixes, root, acc) = foldl((found, suffix) => {
        let candidate = str_concat(base, suffix);
        (String) candidate == root ? found : fs_is_dir(candidate) ? md-add(candidate, found) : found;
    }, acc, suffixes);
    def md-kin-of(root) = md-kin-try(md-parent(root), md-kin-suffixes(), root, md-kin-try(root, md-kin-suffixes(), root, list()));
    def md-find(root) = md-find-in(cons(root, md-kin-of(root)));
    def md-report(paths, i) = (Comparable) len(paths) == 0 ? i : {
        print_str(str_concat("  [", str_concat(int_to_str(i), str_concat("] ", md-describe(head(paths))))));
        md-report(tail(paths), i + 1);
    };
    def md-list(root) = {
        print_str(str_concat("— models this body can see under ", str_concat(root, " and its kin —")));
        let found = md-find(root);
        let n = md-report(found, 0);
        print_str(str_concat("  ", str_concat(int_to_str(n), " found; choose one at runtime, none is compiled in")));
        n;
    };
    def md-list-in(roots) = {
        print_str(str_concat("— models this body can see under ", str_concat(int_to_str(len(roots)), " named roots —")));
        let found = md-find-in(roots);
        let n = md-report(found, 0);
        print_str(str_concat("  ", str_concat(int_to_str(n), " found; choose one at runtime, none is compiled in")));
        n;
    };
    0;
}
