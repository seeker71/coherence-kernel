//////////////////////////////////////////////////////////////////////
//
// form-glass-gift-frame.bml — a frame in process shared memory, offered
// as a gift: no latency, no filesystem poll, live data guaranteed.
//
// Authority: form-stdlib/bml/form-glass-gift-frame.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/crc32.fk form/form-stdlib/sovereignty-as-gift.fk
//
// The shape is sovereignty-as-gift (Urs, 2026-09-04): survive AND receive
// AND unique-offer. A publisher OFFERS its frame into shared memory and asks
// nothing back -- no ack, no reader required, no block. A reader RECEIVES
// when the frame stands and SURVIVES when it does not: an absent gift is
// named absent, never invented, and the reader keeps its own ground.
//
// Six seed doors carry the frame (shm_offer, shm_receive, shm_write,
// shm_read, shm_seq, shm_release): a 16-byte seqlock header ahead of the
// payload, so a reader never takes a torn frame; release unmaps and never
// unlinks, so the gift stays for the next receiver.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassGiftFrameAuthority {
        field GGFAuthorityPath = "form/form-stdlib/bml/form-glass-gift-frame.bml";
        field GGFAuthorityKind = "high-bml-interface-class-const";
    }

    class FormGlassGiftFrame {
        field GGFSchema = "form-glass-gift-frame-v1";
        field GGFNamePrefix = "/fg-";
        field GGFNameBound = 31;
        field GGFDefaultBytes = 1048576;
        ref ggf-authority = FormGlassGiftFrameAuthority;
        thought ggf-law = list("offered-not-demanded", "receive-open", "survive-without", "absent-says-absent", "never-torn", "release-never-unlinks", "name-within-the-host-bound");

        // --- the gift name: short, stable, collision-resistant --------------
        // POSIX shm names on this host hold 31 bytes; a publisher id is
        // longer and free-form, so the frame is named by the CRC-32 of the
        // publisher's bytes rendered as eight hex digits: "/fg-" + 8 = 12 bytes.
        def ggf-hex-digit(v) = v < 10 ? byte_to_str(48 + v) : byte_to_str(87 + v);
        def ggf-hex8-go(n, k, acc) = (Comparable) k == 0 ? acc : ggf-hex8-go(n / 16, k - 1, ggf-hex-digit(n - ((n / 16) * 16)) ++ acc);
        def ggf-hex8(n) = ggf-hex8-go(n, 8, "");
        def ggf-bytes-go(text, i, acc) = i < 0 ? acc : ggf-bytes-go(text, i - 1, cons(str_byte_at(text, i), acc));
        def ggf-bytes(text) = ggf-bytes-go(text, str_len(text) - 1, list());
        def ggf-name(publisher) = GGFNamePrefix() ++ ggf-hex8(crc32(ggf-bytes(publisher)));
        def ggf-name-within-bound?(name) = str_len(name) <= GGFNameBound() ? 1 : 0;

        // --- offer, give, receive, take ---------------------------------------
        def ggf-offer(publisher, bytes) = shm_offer(ggf-name(publisher), bytes);
        def ggf-give(handle, text) = nothing?(handle) ? nothing() : shm_write(handle, text);
        def ggf-receive(publisher) = shm_receive(ggf-name(publisher));
        def ggf-taken(handle) = nothing?(handle) ? nothing() : shm_read(handle);
        def ggf-seq(handle) = nothing?(handle) ? -1 : shm_seq(handle);
        def ggf-release(handle) = nothing?(handle) ? 0 : shm_release(handle);
        def ggf-offer-and-give(publisher, bytes, text) {
            let handle = ggf-offer(publisher, bytes);
            let seq = ggf-give(handle, text);
            let released = ggf-release(handle);
            nothing?(seq) ? list(GGFSchema(), "refused", publisher, ggf-name(publisher), -1) : list(GGFSchema(), "given", publisher, ggf-name(publisher), seq);
        }
        def ggf-given-seq(result) = result[4];
        def ggf-given?(result) = (String) result[1] == "given";

        // --- a reading: receive when it stands, survive when it does not ------
        // list(schema, carrier, text-or-nothing, seq, shape) where carrier is
        // "gift" or "absent" and shape is the sovereignty-as-gift six-tuple:
        // depend-to-live 0 (the reader lives either way), receive-open 1,
        // unique-offer 1, gift-received 0|1, vitality before/after.
        def ggf-reading(publisher) {
            let handle = ggf-receive(publisher);
            let text = ggf-taken(handle);
            let seq = ggf-seq(handle);
            let released = ggf-release(handle);
            let received = nothing?(text) ? 0 : 1;
            let shape = sag-shape(0, 1, 1, received, 1, (Comparable) received == 1 ? 2 : 1);
            list(GGFSchema(), (Comparable) received == 1 ? "gift" : "absent", text, seq, shape);
        }
        def ggf-reading-carrier(r) = r[1];
        def ggf-reading-text(r) = r[2];
        def ggf-reading-seq(r) = r[3];
        def ggf-reading-shape(r) = r[4];
        def ggf-reading-received?(r) = (String) ggf-reading-carrier(r) == "gift" ? 1 : 0;
        def ggf-reading-proven?(r) = sag-proven?(ggf-reading-shape(r));

        // --- kept handles: the name computed once, the frame opened once, held for a loop's life ---
        // A loop that meets the same frames every tick keeps one handle per (publisher, mode): mode
        // "take" is a receive (read-only), mode "give" an offer (read-write, sized by bytes). An absent
        // frame is held as a nothing handle and asked for again only when the caller says retry (the
        // loop's roster cadence); a standing handle is never reopened -- no door here unlinks a gift
        // frame, so a mapping cannot go stale while the loop lives. entry = list(publisher, name, handle, mode, bytes).
        def ggf-kept-empty() = list();
        def ggf-kept-publisher(e) = e[0];
        def ggf-kept-name(e) = e[1];
        def ggf-kept-handle-of(e) = e[2];
        def ggf-kept-mode(e) = e[3];
        def ggf-kept-bytes(e) = e[4];
        def ggf-kept-open(publisher, mode, bytes) {
            let name = ggf-name(publisher);
            let handle = (String) mode == "give" ? shm_offer(name, bytes) : shm_receive(name);
            list(publisher, name, handle, mode, bytes);
        }
        def ggf-kept-entry?(e, publisher, mode) = !((String) ggf-kept-publisher(e) == publisher) ? 0 : (String) ggf-kept-mode(e) == mode ? 1 : 0;
        def ggf-kept-find(kept, publisher, mode) = (Comparable) len(kept) == 0 ? list() : (Comparable) ggf-kept-entry?(head(kept), publisher, mode) == 1 ? head(kept) : ggf-kept-find(tail(kept), publisher, mode);
        def ggf-kept-without(kept, publisher, mode) = (Comparable) len(kept) == 0 ? list() : (Comparable) ggf-kept-entry?(head(kept), publisher, mode) == 1 ? ggf-kept-without(tail(kept), publisher, mode) : cons(head(kept), ggf-kept-without(tail(kept), publisher, mode));
        def ggf-kept-handle(kept, publisher, mode) {
            let entry = ggf-kept-find(kept, publisher, mode);
            (Comparable) len(entry) == 0 ? nothing() : ggf-kept-handle-of(entry);
        }
        def ggf-kept-name-for(kept, publisher, mode) {
            let entry = ggf-kept-find(kept, publisher, mode);
            (Comparable) len(entry) == 0 ? ggf-name(publisher) : ggf-kept-name(entry);
        }
        // ensure: an entry for (publisher, mode) stands after this; a missing one is opened now, an absent one is asked for again when retry is 1
        def ggf-kept-ensure(kept, publisher, mode, bytes, retry) {
            let entry = ggf-kept-find(kept, publisher, mode);
            (Comparable) len(entry) == 0 ? cons(ggf-kept-open(publisher, mode, bytes), kept) : ((Comparable) retry == 1) && nothing?(ggf-kept-handle-of(entry)) ? cons(ggf-kept-open(publisher, mode, bytes), ggf-kept-without(kept, publisher, mode)) : kept;
        }
        // wants = list of list(publisher, mode, bytes)
        def ggf-kept-ensure-all(kept, wants, retry) = (Comparable) len(wants) == 0 ? kept : ggf-kept-ensure-all(ggf-kept-ensure(kept, head(wants)[0], head(wants)[1], head(wants)[2], retry), tail(wants), retry);
        def ggf-kept-wanted?(wants, publisher, mode) = (Comparable) len(wants) == 0 ? 0 : ((String) head(wants)[0] == publisher) && ((String) head(wants)[1] == mode) ? 1 : ggf-kept-wanted?(tail(wants), publisher, mode);
        // prune: entries no want names any more are released and dropped
        def ggf-kept-prune(kept, wants) = (Comparable) len(kept) == 0 ? list() : (Comparable) ggf-kept-wanted?(wants, ggf-kept-publisher(head(kept)), ggf-kept-mode(head(kept))) == 1 ? cons(head(kept), ggf-kept-prune(tail(kept), wants)) : ggf-kept-prune-released(ggf-release(ggf-kept-handle-of(head(kept))), tail(kept), wants);
        def ggf-kept-prune-released(released, rest, wants) = ggf-kept-prune(rest, wants);
        def ggf-kept-handles(kept, publishers, mode) = (Comparable) len(publishers) == 0 ? list() : cons(ggf-kept-handle(kept, head(publishers), mode), ggf-kept-handles(kept, tail(publishers), mode));
        def ggf-kept-standing(kept) = (Comparable) len(kept) == 0 ? 0 : ((nothing?(ggf-kept-handle-of(head(kept))) ? 0 : 1) + ggf-kept-standing(tail(kept)));
        def ggf-kept-release-all(kept) = (Comparable) len(kept) == 0 ? 0 : (ggf-release(ggf-kept-handle-of(head(kept))) + ggf-kept-release-all(tail(kept)));
    }
    0;
}
