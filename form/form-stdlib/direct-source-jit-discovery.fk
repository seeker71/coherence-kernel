; direct-source-jit-discovery.fk -- discover an opt-in direct-source call site
; before it reaches the existing NodeID heat gate, then correlate and offer it.
;
; The evaluator's 256-tag heat window is a useful marginal but cannot say which
; function produced an opcode.  Growing the temporary seed with function
; counters would make that missing joint look like a fixed-table problem.  This
; cell instead threads a dynamic discovery value through a recursive Form call.
; A call site mints its structural identity from its meaning and the exact
; candidate program identity; every recursive arrival updates that identity's
; row.  The registry is ordinary Form data and has no capacity declaration.
;
; Discovery and action stay separate.  dsjd-observe-sum-down runs only the source
; recursive Form function.  It does not touch hg-gate.  Once its row is hot,
; dsjd-hot-choice returns every equally-hot candidate.  The caller cuts by
; structural function identity and dsjd-offer crosses the existing hg-request
; door.  hg-request keeps its own measured heat and its own crystallize/melt
; decision; discovery does not forge or transfer counts into that gate.
;
; Every offer also evaluates the exact candidate through jonb-eval and retains
; that tree-walker answer beside the selected route.  Native is therefore never its
; own oracle.  The immutable before-gate is retained in the receipt, so undo is
; a value projection rather than a compensating mutation.
;
; Signal vocabulary:
;   unknown selection / invalid input -> exact nothing
;   legitimate sum-down(0) / sum-down(1) -> 0 / 1
;   insufficient recursive fuel -> "timeout", value nothing, partial heat kept
;   tied hottest identities -> choice list; no implicit first winner
;   explicit selection -> cut by exact structural identity
;   offer receipt -> before/after gates, so undo restores the prior gate value
;
; This is the smallest direct-source discovery seam, not global evaluator
; introspection.  A direct-source function participates by threading the
; discovery value; arbitrary uninstrumented functions remain outside this
; observer until scannerless source/call-site instrumentation feeds the same
; structural protocol.
;
; preludes: form-stdlib/jit-heat-gate.fk

(do
    (defn dsjd-category () (make_nodeid 31 2 0 182))
    (defn dsjd-version () "direct-source-jit-discovery-v1")

    ; The measured recursive meaning is sum-down(n) = n + sum-down(n-1),
    ; sum-down(0) = 0.  Its lowerable candidate is the equivalent pure closed
    ; form n*(n+1)/2, represented in the gate's existing program vocabulary.
    (defn dsjd-sum-program ()
        (list (list 2)
              (list 1 1)
              (list 3 0 1)
              (list 5 0 2)
              (list 1 2)
              (list 8 3 4)))
    (defn dsjd-sum-root () 5)

    ; spec = function-id, candidate-id, program, root, epoch, meaning
    (defn dsjd-spec (epoch meaning program root)
        (do
            (let candidate (jonb-identity program root epoch))
            (let function-id
                (intern_node (dsjd-category)
                    (list (intern_trivial_string (dsjd-version))
                          (intern_trivial_string meaning)
                          candidate)))
            (list function-id candidate program root epoch meaning)))
    (defn dsjd-sum-spec (epoch)
        (dsjd-spec epoch "sum-down:n+sum-down(n-1);base=0"
                   (dsjd-sum-program) (dsjd-sum-root)))

    (defn dsjd-spec-function-id (spec) (nth spec 0))
    (defn dsjd-spec-candidate-id (spec) (nth spec 1))
    (defn dsjd-spec-program (spec) (nth spec 2))
    (defn dsjd-spec-root (spec) (nth spec 3))
    (defn dsjd-spec-epoch (spec) (nth spec 4))

    ; discovery = epoch, rows. row = spec, recursive-call count.
    (defn dsjd-discovery (epoch) (list epoch (empty)))
    (defn dsjd-epoch (discovery) (nth discovery 0))
    (defn dsjd-rows (discovery) (nth discovery 1))
    (defn dsjd-row-spec (row) (nth row 0))
    (defn dsjd-row-hits (row) (nth row 1))
    (defn dsjd-row-function-id (row)
        (dsjd-spec-function-id (dsjd-row-spec row)))

    (defn dsjd-find-row (rows function-id)
        (if (eq (len rows) 0) (nothing)
            (if (node_eq (dsjd-row-function-id (head rows)) function-id)
                (head rows)
                (dsjd-find-row (tail rows) function-id))))
    (defn dsjd-hits (discovery function-id)
        (do
            (let row (dsjd-find-row (dsjd-rows discovery) function-id))
            (if (nothing? row) (nothing) (dsjd-row-hits row))))

    (defn dsjd-bump-rows (rows spec)
        (if (eq (len rows) 0) (list (list spec 1))
            (if (node_eq (dsjd-row-function-id (head rows))
                         (dsjd-spec-function-id spec))
                (cons (list spec (add (dsjd-row-hits (head rows)) 1))
                      (tail rows))
                (cons (head rows) (dsjd-bump-rows (tail rows) spec)))))
    (defn dsjd-touch (discovery spec)
        (if (not (eq (dsjd-epoch discovery) (dsjd-spec-epoch spec)))
            (nothing)
            (list (dsjd-epoch discovery)
                  (dsjd-bump-rows (dsjd-rows discovery) spec))))

    ; result = value, discovery', status.  Fuel expires before the next call is
    ; counted.  Partial observed heat remains evidence and is not rolled back.
    (defn dsjd-result (value discovery status)
        (list value discovery status))
    (defn dsjd-result-value (result) (nth result 0))
    (defn dsjd-result-discovery (result) (nth result 1))
    (defn dsjd-result-status (result) (nth result 2))

    (defn dsjd-sum-down-go (spec discovery n fuel)
        (if (le fuel 0)
            (dsjd-result (nothing) discovery "timeout")
            (do
                (let seen (dsjd-touch discovery spec))
                (if (nothing? seen)
                    (dsjd-result (nothing) discovery "refused")
                    (if (eq n 0)
                        (dsjd-result 0 seen "done")
                        (do
                            (let below (dsjd-sum-down-go
                                spec seen (sub n 1) (sub fuel 1)))
                            (if (str_eq (dsjd-result-status below) "done")
                                (dsjd-result
                                    (add n (dsjd-result-value below))
                                    (dsjd-result-discovery below) "done")
                                below)))))))
    (defn dsjd-observe-sum-down (discovery n fuel)
        (if (lt n 0) (dsjd-result (nothing) discovery "refused")
            (dsjd-sum-down-go
                (dsjd-sum-spec (dsjd-epoch discovery)) discovery n fuel)))

    ; Hot discovery remains choice.  lowerability is re-observed from the
    ; candidate rows rather than trusted from a declared purity flag.
    (defn dsjd-hot? (row)
        (jd-crystallize? (dsjd-row-hits row)
            (hg-lowerable? (dsjd-spec-program (dsjd-row-spec row)))))
    (defn dsjd-hot-rows (rows)
        (if (eq (len rows) 0) (empty)
            (do
                (let rest (dsjd-hot-rows (tail rows)))
                (if (eq (dsjd-hot? (head rows)) 1)
                    (cons (head rows) rest) rest))))
    (defn dsjd-max-hits (rows maximum)
        (if (eq (len rows) 0) maximum
            (dsjd-max-hits (tail rows)
                (max2 maximum (dsjd-row-hits (head rows))))))
    (defn dsjd-at-hits (rows hits)
        (if (eq (len rows) 0) (empty)
            (do
                (let rest (dsjd-at-hits (tail rows) hits))
                (if (eq (dsjd-row-hits (head rows)) hits)
                    (cons (head rows) rest) rest))))
    (defn dsjd-hot-choice (discovery)
        (do
            (let hot (dsjd-hot-rows (dsjd-rows discovery)))
            (if (eq (len hot) 0) (empty)
                (dsjd-at-hits hot (dsjd-max-hits hot 0)))))

    ; Explicit cut: unknown is nothing.  No head-of-choice privilege exists.
    (defn dsjd-cut (choice function-id)
        (if (eq (len choice) 0) (nothing)
            (if (node_eq (dsjd-row-function-id (head choice)) function-id)
                (head choice)
                (dsjd-cut (tail choice) function-id))))

    ; offer receipt = value, route, before-gate, after-gate, born,
    ;                 function-id, candidate-id, tree-walker challenger, agreement
    (defn dsjd-offer (gate row argument)
        (if (nothing? row) (nothing)
            (do
                (let spec (dsjd-row-spec row))
                (let expected (jonb-identity
                    (dsjd-spec-program spec) (dsjd-spec-root spec)
                    (jonb-epoch (hg-reg gate))))
                (if (not (node_eq expected (dsjd-spec-candidate-id spec)))
                    (nothing)
                    (if (eq (dsjd-hot? row) 0) (nothing)
                        (do
                            (let walked (jonb-eval
                                (dsjd-spec-program spec)
                                (dsjd-spec-root spec) argument))
                            (let response (hg-request gate
                                (dsjd-spec-program spec)
                                (dsjd-spec-root spec) argument))
                            (list (nth response 0) (nth response 1)
                                  gate (nth response 2) (nth response 3)
                                  (dsjd-spec-function-id spec)
                                  (dsjd-spec-candidate-id spec)
                                  walked
                                  (value_eq (nth response 0) walked))))))))
    (defn dsjd-offer-after (receipt) (nth receipt 3))
    (defn dsjd-offer-born (receipt) (nth receipt 4))
    (defn dsjd-offer-agrees? (receipt) (nth receipt 8))
    (defn dsjd-undo (receipt)
        (if (nothing? receipt) (nothing) (nth receipt 2)))
)
