; form-cli-peer-grounded-weave-source-live-run.fk -- real plural current-source
; admission before Metal ownership.  The absent model makes the all-or-nothing
; source gate directly observable.
;
; preludes: form-stdlib/form-cli-peer-grounded-weave-answer.fk

(do
    (defn fcpagwl-line (key value)
        (print_str (str_concat key (str_concat "=" (str_concat value "\n")))))
    (let source-ctx (fcpalsa-live-source-context))
    (let result (fcpagw-run (fcms-none "weave-source-gate-no-model")
        "psci-schema + psci-source-schema :: What exact schemas do these definitions return?"
        source-ctx 1))
    (let evidence (fcpagw-source-evidence result))
    (fcpagwl-line "route" (fcpa-route (fcpagw-peer result)))
    (fcpagwl-line "source-signal"
        (if (nothing? evidence) "nothing" (fcpagw-evidence-signal evidence)))
    (fcpagwl-line "symbol-count"
        (if (nothing? evidence) "0"
            (int_to_str (len (fcpagw-evidence-symbol-results evidence)))))
    (fcpagwl-line "observation-count"
        (if (nothing? evidence) "0"
            (int_to_str (len (fcpagw-evidence-observations evidence)))))
    (fcpagwl-line "model-signal"
        (if (nothing? (fcpagw-direct-result result)) "not-entered"
            (fcpdaa-signal (fcpagw-direct-result result))))
    (fcpagwl-line "lookup-count" (int_to_str (fcpagw-lookup-count result)))
    (fcpagwl-line "callback-calls"
        (int_to_str (fcpa-callback-calls (fcpagw-peer result))))
    0)
