// channel-flow.fk — walk consented flow and name channel protocol shape.
//
// preludes: form-stdlib/core.fk form-stdlib/channel-interface.fk form-stdlib/kernel-http.fk
//
// A channel is not "HTTP plus adapters". It is a flow whose offered interfaces,
// invasions, receipts, OSI layers, phase counts, and application policy are all
// visible cells. The flow walker below freezes each request against the receiver's
// current offer. The BML channel profile below names HTTP as one L7 application
// policy carried by a seven-layer channel shape.
section [form.bml] {
    // --- utterance tags (an act is (list tag payload); a flow is a list of acts) ---
    def act-shift() = 0;
    // the other side shifts its offered interface — payload = new offer
    def act-request() = 1;
    // this side requests a mode — payload = a mode value
    def act-tag(a) = head(a);
    def act-payload(a) = head(tail(a));
    // --- walk: thread the other's current offer; count honored vs invasion (witnessed) ---
    // the receipt is (list honored invasion final-offer) — observable to all who witness.
    def cf-walk(flow, offer, honored, invasion) = (Comparable) len(flow) == 0 ? list(honored, invasion, offer) : (Comparable) act-tag(head(flow)) == act-shift() ? cf-walk(tail(flow), act-payload(head(flow)), honored, invasion) : ci-honors?(act-payload(head(flow)), offer) ? cf-walk(tail(flow), offer, honored + 1, invasion) : cf-walk(tail(flow), offer, honored, invasion + 1);
    // --- the surface: walk a flow from an initial offered interface ---
    def channel-flow(flow, initial-offer) = cf-walk(flow, initial-offer, 0, 0);
    // --- read the receipt ---
    def cf-honored(receipt) = head(receipt);
    def cf-invasions(receipt) = head(tail(receipt));
    def cf-final-offer(receipt) = head(tail(tail(receipt)));
    // --- bilateral: both sides offer, both request; each direction is gated by the receiver ---
    // A bilateral act is (list side tag payload); side: A=0, B=1.
    def side-a() = 0;
    def side-b() = 1;
    def bact-side(a) = head(a);
    def bact-tag(a) = head(tail(a));
    def bact-payload(a) = head(tail(tail(a)));
    // receipt = (list honored invasion offer-a offer-b) — totals across both directions.
    def cf-walk-bi(flow, offer-a, offer-b, honored, invasion) = (Comparable) len(flow) == 0 ? list(honored, invasion, offer-a, offer-b) : (Comparable) bact-side(head(flow)) == side-a() ?     // A acts: shift updates A's offer; request is gated by B's offer (A reaches B)
(Comparable) bact-tag(head(flow)) == act-shift() ? cf-walk-bi(tail(flow), bact-payload(head(flow)), offer-b, honored, invasion) : ci-honors?(bact-payload(head(flow)), offer-b) ? cf-walk-bi(tail(flow), offer-a, offer-b, honored + 1, invasion) : cf-walk-bi(tail(flow), offer-a, offer-b, honored, invasion + 1) :     // B acts: shift updates B's offer; request is gated by A's offer (B reaches A)
(Comparable) bact-tag(head(flow)) == act-shift() ? cf-walk-bi(tail(flow), offer-a, bact-payload(head(flow)), honored, invasion) : ci-honors?(bact-payload(head(flow)), offer-a) ? cf-walk-bi(tail(flow), offer-a, offer-b, honored + 1, invasion) : cf-walk-bi(tail(flow), offer-a, offer-b, honored, invasion + 1);
    def channel-flow-bilateral(flow, offer-a, offer-b) = cf-walk-bi(flow, offer-a, offer-b, 0, 0);
    def cf-bi-offer-a(receipt) = head(tail(tail(receipt)));
    def cf-bi-offer-b(receipt) = head(tail(tail(tail(receipt))));
    // Registered Blueprint coordinates from form/user-blueprint-registry.md.
    // These share one block with the helpers so the fourth-kernel flattener sees
    // the whole channel-flow function family together.
    // Functions, not file-scope lets: direct-source defn frames resolve names
    // through the shared function surface, while sibling lexical loaders also
    // accept the same calls.  The Blueprint coordinates remain unchanged.
    def cf-tag-channel-osi-layer() = 1702;
    def cf-tag-channel-flow() = 1703;
    def cf-bool-score(ok, score) = ok ? score : 0;
    def cf-tagged?(value, tag, arity) = (Comparable) len(value) == arity ? (Comparable) nth(value, 0) == tag : false;
    def cf-phase-gas() = "gas";
    def cf-phase-water() = "water";
    def cf-phase-ice() = "ice";
    def cf-phase-valid?(phase) = (String) phase == cf-phase-gas() || ((String) phase == cf-phase-water() || (String) phase == cf-phase-ice());
    def cf-layer-name-for-index(index) = (Comparable) index == 1 ? "physical" : (Comparable) index == 2 ? "data-link" : (Comparable) index == 3 ? "network" : (Comparable) index == 4 ? "transport" : (Comparable) index == 5 ? "session" : (Comparable) index == 6 ? "presentation" : (Comparable) index == 7 ? "application" : "";
    def cf-osi-layer(index, name, phase, carrier, policy, recipe) = list(cf-tag-channel-osi-layer(), index, name, phase, carrier, policy, recipe);
    def cf-osi-layer?(layer) = cf-tagged?(layer, cf-tag-channel-osi-layer(), 7);
    def cf-osi-layer-index(layer) = nth(layer, 1);
    def cf-osi-layer-name(layer) = nth(layer, 2);
    def cf-osi-layer-phase(layer) = nth(layer, 3);
    def cf-osi-layer-carrier(layer) = nth(layer, 4);
    def cf-osi-layer-policy(layer) = nth(layer, 5);
    def cf-osi-layer-recipe(layer) = nth(layer, 6);
    def cf-osi-layer-valid?(layer) = cf-osi-layer?(layer) ? cf-osi-layer-index(layer) >= 1 && cf-osi-layer-index(layer) <= 7 && ((String) cf-osi-layer-name(layer) == cf-layer-name-for-index(cf-osi-layer-index(layer)) && (cf-phase-valid?(cf-osi-layer-phase(layer)) && (str_len(cf-osi-layer-carrier(layer)) > 0 && (str_len(cf-osi-layer-policy(layer)) > 0 && str_len(cf-osi-layer-recipe(layer)) > 0)))) : false;
    def cf-channel-flow(carrier, protocol, layers, channel-policy) = list(cf-tag-channel-flow(), carrier, protocol, layers, channel-policy);
    def cf-channel-flow?(flow) = cf-tagged?(flow, cf-tag-channel-flow(), 5);
    def cf-flow-carrier(flow) = nth(flow, 1);
    def cf-flow-protocol(flow) = nth(flow, 2);
    def cf-flow-layers(flow) = nth(flow, 3);
    def cf-flow-channel-policy(flow) = nth(flow, 4);
    def cf-layers-valid?(layers) = nil?(layers) ? true : cf-osi-layer-valid?(head(layers)) ? cf-layers-valid?(tail(layers)) : false;
    def cf-layer-order-valid-from?(layers, expected) = nil?(layers) ? (Comparable) expected == 8 : (Comparable) cf-osi-layer-index(head(layers)) == expected ? cf-layer-order-valid-from?(tail(layers), expected + 1) : false;
    def cf-osi-complete?(flow) = cf-channel-flow?(flow) ? (Comparable) len(cf-flow-layers(flow)) == 7 && (cf-layers-valid?(cf-flow-layers(flow)) && cf-layer-order-valid-from?(cf-flow-layers(flow), 1)) : false;
    def cf-channel-flow-valid?(flow) = cf-channel-flow?(flow) ? str_len(cf-flow-carrier(flow)) > 0 && str_len(cf-flow-protocol(flow)) > 0 && cf-osi-complete?(flow) : false;
    def cf-layer-by-index-from(layers, index) = nil?(layers) ? empty() : (Comparable) cf-osi-layer-index(head(layers)) == index ? head(layers) : cf-layer-by-index-from(tail(layers), index);
    def cf-layer-by-index(flow, index) = cf-layer-by-index-from(cf-flow-layers(flow), index);
    def cf-flow-physical-layer(flow) = cf-layer-by-index(flow, 1);
    def cf-flow-data-link-layer(flow) = cf-layer-by-index(flow, 2);
    def cf-flow-network-layer(flow) = cf-layer-by-index(flow, 3);
    def cf-flow-transport-layer(flow) = cf-layer-by-index(flow, 4);
    def cf-flow-session-layer(flow) = cf-layer-by-index(flow, 5);
    def cf-flow-presentation-layer(flow) = cf-layer-by-index(flow, 6);
    def cf-flow-application-layer(flow) = cf-layer-by-index(flow, 7);
    def cf-layer-count-phase(layers, phase) = nil?(layers) ? 0 : ((String) cf-osi-layer-phase(head(layers)) == phase ? 1 : 0) + cf-layer-count-phase(tail(layers), phase);
    def cf-flow-gas-count(flow) = cf-layer-count-phase(cf-flow-layers(flow), cf-phase-gas());
    def cf-flow-water-count(flow) = cf-layer-count-phase(cf-flow-layers(flow), cf-phase-water());
    def cf-flow-ice-count(flow) = cf-layer-count-phase(cf-flow-layers(flow), cf-phase-ice());
    def cf-layer-phase-code(layer) = (String) cf-osi-layer-phase(layer) == cf-phase-ice() ? 3 : (String) cf-osi-layer-phase(layer) == cf-phase-water() ? 2 : (String) cf-osi-layer-phase(layer) == cf-phase-gas() ? 1 : 0;
    def cf-flow-phase-signature-from(layers) = nil?(layers) ? "" : str_concat(int_to_str(cf-layer-phase-code(head(layers))), cf-flow-phase-signature-from(tail(layers)));
    def cf-flow-phase-signature(flow) = cf-flow-phase-signature-from(cf-flow-layers(flow));
    // A handover changes the carrier flow while the session identity, admitted
    // cursor, acknowledgement, and typed signal remain visible.  It does not
    // enumerate media: Bluetooth, HTTP, TCP, UDP, NFC, audio, optical, or a
    // carrier born later are ordinary cf-channel-flow values authored in BML.
    // Application compatibility is structural, so a session cannot silently
    // cross into a different L7 contract just because both flows have 7 rows.
    def cf-media-handover-tag() = "cf-media-handover-v1";
    def cf-handover-signal-valid?(signal) = (String) signal == "value" || ((String) signal == "choice" || ((String) signal == "failure" || ((String) signal == "timeout" || ((String) signal == "nothing" || ((String) signal == "cut" || (String) signal == "undo")))));
    def cf-flow-application-compatible?(from-flow, to-flow) = cf-channel-flow-valid?(from-flow) && cf-channel-flow-valid?(to-flow) ? {
        let from-app = cf-flow-application-layer(from-flow);
        let to-app = cf-flow-application-layer(to-flow);
        (String) cf-flow-protocol(from-flow) == cf-flow-protocol(to-flow) && ((String) cf-osi-layer-policy(from-app) == cf-osi-layer-policy(to-app) && (String) cf-osi-layer-recipe(from-app) == cf-osi-layer-recipe(to-app));
    } : false;
    def cf-media-handover(from-flow, to-flow, session-node, cursor, ack, signal, reason) = list(cf-media-handover-tag(), from-flow, to-flow, session-node, cursor, ack, signal, reason);
    def cf-media-handover?(handover) = (Comparable) len(handover) == 8 ? (String) nth(handover, 0) == cf-media-handover-tag() : false;
    def cf-handover-from-flow(handover) = nth(handover, 1);
    def cf-handover-to-flow(handover) = nth(handover, 2);
    def cf-handover-session-node(handover) = nth(handover, 3);
    def cf-handover-cursor(handover) = nth(handover, 4);
    def cf-handover-ack(handover) = nth(handover, 5);
    def cf-handover-signal(handover) = nth(handover, 6);
    def cf-handover-reason(handover) = nth(handover, 7);
    def cf-media-handover-valid?(handover) = cf-media-handover?(handover) ? cf-flow-application-compatible?(cf-handover-from-flow(handover), cf-handover-to-flow(handover)) && (cf-handover-cursor(handover) >= 0 && (cf-handover-signal-valid?(cf-handover-signal(handover)) && str_len(cf-handover-reason(handover)) > 0)) : false;
    def cf-media-handover-selected?(handover) = cf-media-handover-valid?(handover) ? (String) cf-handover-signal(handover) == "value" : false;
    def cf-media-handover-active-flow(handover) = cf-media-handover-selected?(handover) ? cf-handover-to-flow(handover) : cf-handover-from-flow(handover);
    def cf-http-osi-layers() = list(cf-osi-layer(1, "physical", cf-phase-gas(), "tcp-socket", "socket-open", "socket-listen-accept-recv-send-close"), cf-osi-layer(2, "data-link", cf-phase-ice(), ".fkb-frame", "content-addressed-frame", "read-form-binary-write-form-binary"), cf-osi-layer(3, "network", cf-phase-water(), "nodeid-address", "blueprint-coordinate-routing", "route-by-blueprint"), cf-osi-layer(4, "transport", cf-phase-water(), "tcp", "delivery-policy", "recv-send-loop"), cf-osi-layer(5, "session", cf-phase-water(), "session-cell", "session-policy", "session-state"), cf-osi-layer(6, "presentation", cf-phase-ice(), "bmf-codec", "grammar-lens-policy", "parse-render-codec"), cf-osi-layer(7, "application", cf-phase-water(), "http/1.1", "kh-channel-policy", "kh-serve"));
    def cf-http-channel-flow() = cf-channel-flow("tcp", "http/1.1", cf-http-osi-layers(), kh-default-channel-policy());
    def cf-flow-http-policy-valid?(flow) = cf-channel-flow-valid?(flow) ? kh-channel-policy-valid?(cf-flow-channel-policy(flow)) : false;
    def cf-flow-allow-header(flow) = kh-policy-allow-header-value(cf-flow-channel-policy(flow));
    0;
}
