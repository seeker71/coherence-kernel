//////////////////////////////////////////////////////////////////////
//
// cell-channel-glass.bml
//
// Executable BML. THE CHANNEL ON GLASS: how a channel's durable spools
// become samples on the glass telemetry bus (so the living Form Glass
// shows every cell, edge, field and grammar under the `mesh` tag) and
// lanes for a terminal panel (term-graphics). Data, never paint: this
// surface names no color and no escape.
//
// A publisher per channel — `cell-channel.<name>` — and one for the
// mesh — `cell-mesh` — under the hearth's telemetry root (or any root
// the caller hands). Counts are read from the spools at the epoch of the
// publish, so their evidence is physical-live; a cell's standing is the
// host's own answer about its pid.
//
// preludes: form/form-stdlib/cell-channel.bml form/form-stdlib/term-graphics.bml
//
// Proven by: form-stdlib/tests/cell-channel-glass-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormCellChannelGlass {
        thought ccg-pattern = list("data-not-paint", "one-publisher-per-channel", "mesh-tag", "standing-is-the-host-answer");

        field CCGPublisherPrefix = "cell-channel.";
        field CCGMeshPublisher = "cell-mesh";
        field CCGLane = "channel";
        field CCGSource = "cell-channel.stat";
        field CCGActiveMs = 5000;

        def ccg-publisher(name) = str_concat(CCGPublisherPrefix(), name);
        def ccg-mesh-publisher() = CCGMeshPublisher();
        def ccg-tags() = list("all", "mesh", "network", "membrane");
        def ccg-present-if(v) = if gt(v, 0) then fgtm-present(v) else fgtm-absent();
        def ccg-recent?(lastms, epoch) = if le(sub(epoch, lastms), CCGActiveMs()) then 1 else 0;
        def ccg-cell-lifecycle(alive, lastms, epoch) = if eq(alive, 1) then if eq(ccg-recent?(lastms, epoch), 1) then "active" else "ready" else if gt(lastms, 0) then "released" else "idle";
        def ccg-cell-purpose(alive, pid) = if eq(alive, 1) then "standing" else if gt(pid, 0) then "down" else "unborn";
        def ccg-evidence(alive) = if eq(alive, 1) then "physical-live" else "derived-window";
        def ccg-cell-sample(name, cell, pid, frames, lastms, epoch) {
            let alive = hearth-alive(pid);
            fgtm-sample(cc-cat(list("cell.", name, ".", cell)), fgtm-present(str_concat("channel.", name)), "cell", "form", ccg-publisher(name), CCGLane(), ccg-cell-purpose(alive, pid), fgtm-absent(), fgtm-present(frames), ccg-cell-lifecycle(alive, lastms, epoch), ccg-present-if(lastms), fgtm-present(epoch), fgtm-absent(), ccg-present-if(pid), "never", ccg-evidence(alive), CCGSource(), ccg-tags());
        }
        def ccg-edge-sample(name, from, to, frames, lastms, epoch) = fgtm-sample(cc-cat(list("edge.", name, ".", from, "-", to)), fgtm-present(str_concat("channel.", name)), "channel-edge", "membrane", ccg-publisher(name), CCGLane(), if gt(frames, 0) then "frames-crossed" else "silent", fgtm-absent(), fgtm-present(frames), if eq(ccg-recent?(lastms, epoch), 1) then "active" else if gt(frames, 0) then "idle" else "allocated", ccg-present-if(lastms), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", CCGSource(), ccg-tags());
        def ccg-field-sample(name, pid, admitted, refused, lastms, epoch) {
            let alive = hearth-alive(pid);
            fgtm-sample(str_concat("field.", name), fgtm-present(str_concat("channel.", name)), "field-observer", "form", ccg-publisher(name), CCGLane(), cc-cat(list("admitted-", int_to_str(admitted), "-refused-", int_to_str(refused))), fgtm-absent(), fgtm-present(admitted), ccg-cell-lifecycle(alive, lastms, epoch), ccg-present-if(lastms), fgtm-present(epoch), fgtm-absent(), ccg-present-if(pid), "never", ccg-evidence(alive), CCGSource(), ccg-tags());
        }
        def ccg-grammar-sample(name, gid, amendments, epoch) = fgtm-sample(str_concat("grammar.", name), fgtm-present(str_concat("channel.", name)), "grammar", "form", ccg-publisher(name), CCGLane(), str_concat("id-", cc-short(gid)), fgtm-absent(), fgtm-present(amendments), "crystallized", fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", CCGSource(), ccg-tags());
        def ccg-channel-sample(name, s, epoch) = fgtm-sample(str_concat("channel.", name), fgtm-absent(), "channel", "membrane", ccg-publisher(name), CCGLane(), cc-cat(list("said-", int_to_str(cc-stat-said(s)), "-heard-", int_to_str(cc-stat-heard(s)))), fgtm-absent(), fgtm-present(add(cc-stat-a-frames(s), add(cc-stat-b-frames(s), cc-stat-field-frames(s)))), if eq(ccg-recent?(cc-stat-last-ms(s), epoch), 1) then "active" else "idle", ccg-present-if(cc-stat-last-ms(s)), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", CCGSource(), ccg-tags());

        def ccg-samples-of(root, name, s, epoch) {
            let a = cc-a(root, name);
            let b = cc-b(root, name);
            let lastA = cc-last-ms(cc-spool-frames(root, name, a));
            let lastB = cc-last-ms(cc-spool-frames(root, name, b));
            let lastF = cc-last-ms(cc-spool-frames(root, name, cc-field-name()));
            list(
                ccg-channel-sample(name, s, epoch),
                ccg-cell-sample(name, a, cc-stat-pid-a(s), cc-stat-a-frames(s), lastA, epoch),
                ccg-cell-sample(name, b, cc-stat-pid-b(s), cc-stat-b-frames(s), lastB, epoch),
                ccg-edge-sample(name, a, b, cc-stat-a-frames(s), lastA, epoch),
                ccg-edge-sample(name, b, a, cc-stat-b-frames(s), lastB, epoch),
                ccg-field-sample(name, cc-stat-pid-field(s), cc-stat-admitted(s), cc-stat-refused(s), lastF, epoch),
                ccg-grammar-sample(name, cc-stat-grammar-id(s), cc-stat-amendments(s), epoch)
            );
        }
        def ccg-samples(root, name, epoch) = ccg-samples-of(root, name, cc-stat(root, name), epoch);
        def ccg-publish-to(troot, root, name, epoch) = fgtm-publish-snapshot(troot, ccg-publisher(name), epoch, ccg-samples(root, name, epoch));
        def ccg-publish(root, name, epoch) = ccg-publish-to(hearth-telemetry-root(), root, name, epoch);
        def ccg-published?(p) = if and(ge(len(p), 2), str_eq(nth(p, 1), "published")) then 1 else 0;

        // ── the mesh: one sample per channel plus the count ──
        def ccg-mesh-sample(count, epoch) = fgtm-sample("mesh.channels", fgtm-absent(), "mesh", "membrane", ccg-mesh-publisher(), CCGLane(), if gt(count, 0) then "channels-standing" else "no-channel", fgtm-absent(), fgtm-present(count), if gt(count, 0) then "ready" else "idle", fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", CCGSource(), ccg-tags());
        def ccg-mesh-channel-samples(stats, epoch) = if eq(len(stats), 0) then list() else cons(ccg-channel-sample(cc-stat-name(head(stats)), head(stats), epoch), ccg-mesh-channel-samples(tail(stats), epoch));
        // the sibling lane (Grok's interned-symbol mesh, publisher form-cli.cell-mesh)
        // stands on the same bus; the mesh names it beside its own channels so
        // the glass shows one mesh with two lanes, not two meshes
        def ccg-sibling-publisher() = "form-cli.cell-mesh";
        def ccg-sibling-lane-sample(troot, epoch) {
            let current = if str_eq(fgtm-read-state-status(fgtm-read-current(troot, ccg-sibling-publisher())), "current") then 1 else 0;
            fgtm-sample("mesh.lane.form-cli-cell-mesh", fgtm-absent(), "mesh-lane", "membrane", ccg-mesh-publisher(), CCGLane(), if eq(current, 1) then "interned-symbol-lane-standing" else "interned-symbol-lane-absent", fgtm-absent(), fgtm-present(current), if eq(current, 1) then "ready" else "idle", fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", if eq(current, 1) then "physical-live" else "declared", ccg-sibling-publisher(), ccg-tags());
        }
        def ccg-mesh-samples-to(troot, root, epoch) {
            let stats = cc-mesh(root);
            cons(ccg-mesh-sample(len(stats), epoch), cons(ccg-sibling-lane-sample(troot, epoch), ccg-mesh-channel-samples(stats, epoch)));
        }
        def ccg-mesh-samples(root, epoch) = ccg-mesh-samples-to(hearth-telemetry-root(), root, epoch);
        def ccg-publish-each(troot, root, names, epoch) = if eq(len(names), 0) then 0 else add(ccg-published?(ccg-publish-to(troot, root, head(names), epoch)), ccg-publish-each(troot, root, tail(names), epoch));
        def ccg-publish-mesh-to(troot, root, epoch) {
            let each = ccg-publish-each(troot, root, cc-mesh-names(root), epoch);
            let mesh = fgtm-publish-snapshot(troot, ccg-mesh-publisher(), epoch, ccg-mesh-samples-to(troot, root, epoch));
            list("ccg-mesh-publish-v1", each, ccg-published?(mesh));
        }
        def ccg-publish-mesh(root, epoch) = ccg-publish-mesh-to(hearth-telemetry-root(), root, epoch);

        // ── lanes for a terminal panel (term-graphics renders them) ──
        def ccg-standing-word(alive) = if eq(alive, 1) then "standing" else "down";
        def ccg-age(lastms, nowms) = if le(lastms, 0) then sub(0, 1) else sub(nowms, lastms);
        def ccg-newest-go(frames, best) = if eq(len(frames), 0) then best else ccg-newest-go(tail(frames), if or(eq(len(best), 0), gt(cc-frame-ms(head(frames)), cc-frame-ms(best))) then head(frames) else best);
        def ccg-newest-frame(root, name) = ccg-newest-go(append(cc-spool-frames(root, name, cc-a(root, name)), append(cc-spool-frames(root, name, cc-b(root, name)), cc-spool-frames(root, name, cc-field-name()))), list());
        def ccg-clip(s, n) = if le(str_len(s), n) then s else str_concat(substring(s, 0, n), "...");
        def ccg-one-line(s) = ccg-one-line-go(s, 0, "");
        def ccg-one-line-go(s, i, acc) = if ge(i, str_len(s)) then acc else ccg-one-line-go(s, add(i, 1), str_concat(acc, if eq(str_byte_at(s, i), 10) then " " else byte_to_str(str_byte_at(s, i))));
        def ccg-frame-line(f) = if eq(len(f), 0) then "-" else cc-cat(list("#", int_to_str(cc-frame-turn(f)), " ", cc-frame-from(f), " ", cc-frame-kind(f), " ", ccg-clip(ccg-one-line(cc-frame-body(f)), 60)));
        def ccg-head-lane(root, name, s, nowms) {
            let aliveA = hearth-alive(cc-stat-pid-a(s));
            let aliveB = hearth-alive(cc-stat-pid-b(s));
            let aliveF = hearth-alive(cc-stat-pid-field(s));
            tg-lane("CHANNEL ", cc-cat(list(name, "  ", cc-a(root, name), "=", ccg-standing-word(aliveA), " ", cc-b(root, name), "=", ccg-standing-word(aliveB), " field=", ccg-standing-word(aliveF))), if eq(add(aliveA, add(aliveB, aliveF)), 3) then "good" else if eq(add(aliveA, add(aliveB, aliveF)), 0) then "dim" else "warn", ccg-age(cc-stat-last-ms(s), nowms));
        }
        def ccg-edge-lane(label, frames, lastms, nowms) = tg-lane(label, cc-cat(list(int_to_str(frames), " frames ", tg-ramp(if gt(frames, 8) then 8 else frames))), if gt(frames, 0) then "plain" else "dim", ccg-age(lastms, nowms));
        def ccg-grammar-lane(s) = tg-lane("grammar ", cc-cat(list("id=", cc-short(cc-stat-grammar-id(s)), " amendments=", int_to_str(cc-stat-amendments(s)), " eval-door=", cc-eval-door())), "plain", sub(0, 1));
        def ccg-field-lane(s) = tg-lane("field   ", cc-cat(list("admitted=", int_to_str(cc-stat-admitted(s)), " refused=", int_to_str(cc-stat-refused(s)), " said=", int_to_str(cc-stat-said(s)), " heard=", int_to_str(cc-stat-heard(s)))), if gt(cc-stat-refused(s), 0) then "warn" else "plain", sub(0, 1));
        def ccg-newest-lane(root, name, nowms) {
            let f = ccg-newest-frame(root, name);
            tg-lane("newest  ", ccg-frame-line(f), if eq(len(f), 0) then "dim" else if str_eq(cc-frame-kind(f), "refuse") then "warn" else "plain", if eq(len(f), 0) then sub(0, 1) else ccg-age(cc-frame-ms(f), nowms));
        }
        def ccg-lanes(root, name, nowms) {
            let s = cc-stat(root, name);
            let a = cc-a(root, name);
            let b = cc-b(root, name);
            list(
                ccg-head-lane(root, name, s, nowms),
                ccg-edge-lane(cc-cat(list(a, "->", b, "    ")), cc-stat-a-frames(s), cc-last-ms(cc-spool-frames(root, name, a)), nowms),
                ccg-edge-lane(cc-cat(list(b, "->", a, "    ")), cc-stat-b-frames(s), cc-last-ms(cc-spool-frames(root, name, b)), nowms),
                ccg-grammar-lane(s),
                ccg-field-lane(s),
                ccg-newest-lane(root, name, nowms)
            );
        }
        def ccg-mesh-head-lane(root, names, tick) = tg-lane("MESH    ", cc-cat(list("root=", root, " channels=", int_to_str(len(names)), " tick=", int_to_str(tick), " ", tg-shade(add(1, mod(tick, 4))))), if gt(len(names), 0) then "good" else "dim", sub(0, 1));
        def ccg-mesh-lanes-go(root, names, nowms) = if eq(len(names), 0) then list() else append(ccg-lanes(root, head(names), nowms), ccg-mesh-lanes-go(root, tail(names), nowms));
        def ccg-mesh-lanes(root, tick, nowms) {
            let names = cc-mesh-names(root);
            cons(ccg-mesh-head-lane(root, names, tick), ccg-mesh-lanes-go(root, names, nowms));
        }
        def ccg-frame(root, name, nowms) = tg-frame(ccg-lanes(root, name, nowms));
        def ccg-mesh-frame(root, tick, nowms) = tg-frame(ccg-mesh-lanes(root, tick, nowms));
    }
    0;
}
