// runtime-artifact-outcome.fk -- Layer 9c outcome observation face.
//
// This layer consumes Layer 9b `ras-selection` rows and synthetic future
// runner observation rows. It normalizes outcomes, but it does not load or walk
// `.fkb`, load or call `.dylib`, bind symbols, execute native bytes, generate
// real observations, run fallbacks, reselect retries, reverify proof/callable
// receipts, decide source-runner admission, or grow the C seed.
//
// Outcome matrix:
//   selected, no observation        -> pending-observation
//   selected + ok                   -> complete
//   selected + loader-missing/error -> fallback-available only if fallback exists
//   selected + hard status          -> investigate
//   selected + unknown status       -> investigate
//   action mismatch                 -> investigate
//   selector investigate/refused    -> propagate terminal status
//   malformed selection             -> refused
//   selected + malformed observation -> refused
//
// Hard statuses are oom-killed, killed, stalled, timeout, and wrong-value.
// `fallback-available` records a possible fallback; it is not fallback
// execution or proof that the fallback succeeded.
//
// preludes: form-stdlib/core.fk form-stdlib/runtime-artifact-selector.fk
section [form.bml] {
    def rao-feature(name, status) = ["runtime-artifact-outcome-feature", name, status];
    def rao-feature-name(f) = f[1];
    def rao-feature-status(f) = f[2];
    def runtime-artifact-outcome-manifest() = [rao-feature("outcome-face-not-execution", 1), rao-feature("consumes-ras-selection-only", 1), rao-feature("consumes-synthetic-observations-only", 1), rao-feature("total-outcome-row", 1), rao-feature("terminal-selection-propagates", 1), rao-feature("selected-pending-without-observation", 1), rao-feature("soft-failure-fallback-available-only", 1), rao-feature("hard-observation-investigates", 1), rao-feature("unknown-observation-investigates", 1), rao-feature("action-mismatch-investigates", 1), rao-feature("no-automatic-fallback-execution", 1), rao-feature("no-rap-plan-or-descriptor-consumption", 1), rao-feature("no-runtime-load-walk-call-exec", 1), rao-feature("no-seal-proof-callable-admission", 1), rao-feature("no-c-seed-growth-or-selector-install", 1), rao-feature("no-reselection-retry-or-real-observation-generation", 1)];
    def runtime-artifact-outcome-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) rao-feature-name(head(fs)) == name && (Comparable) rao-feature-status(head(fs)) == 1 ? 1 : runtime-artifact-outcome-manifest-has?(name, tail(fs));
    def rao-action-none() = "none";
    def rao-route-unknown() = "unknown-route";
    def rao-detail-none() = "";
    def rao-code-none() = 0;
    def rao-obs-none() = "none";
    def rao-obs-ok() = "ok";
    def rao-obs-loader-missing() = "loader-missing";
    def rao-obs-error() = "error";
    def rao-obs-oom-killed() = "oom-killed";
    def rao-obs-killed() = "killed";
    def rao-obs-stalled() = "stalled";
    def rao-obs-timeout() = "timeout";
    def rao-obs-wrong-value() = "wrong-value";
    def rao-status-complete() = "complete";
    def rao-status-fallback-available() = "fallback-available";
    def rao-status-investigate() = "investigate";
    def rao-status-refused() = "refused";
    def rao-status-pending-observation() = "pending-observation";
    def rao-reason-pending-observation() = "pending-observation";
    def rao-reason-observation-ok() = "observation-ok";
    def rao-reason-soft-failure-fallback-available() = "soft-failure-fallback-available";
    def rao-reason-soft-failure-no-fallback() = "soft-failure-no-fallback";
    def rao-reason-hard-observation-investigates() = "hard-observation-investigates";
    def rao-reason-unknown-observation-status() = "unknown-observation-status";
    def rao-reason-observation-action-mismatch() = "observation-action-mismatch";
    def rao-reason-selector-investigate() = "selector-investigate";
    def rao-reason-selector-refused() = "selector-refused";
    def rao-reason-terminal-observation-ignored() = "terminal-observation-ignored";
    def rao-reason-unknown-selection-status() = "unknown-selection-status";
    def rao-reason-malformed-selection() = "malformed-selection";
    def rao-reason-malformed-observation() = "malformed-observation";
    // observation = ("runtime-artifact-run-observation" action status detail code)
    def rao-run-observation(action, status, detail, code) = ["runtime-artifact-run-observation", action, status, detail, code];
    def rao-run-observation?(o) = (Comparable) len(o) == 5 ? (String) o[0] == "runtime-artifact-run-observation" : 0;
    def rao-observation-action(o) = o[1];
    def rao-observation-status(o) = o[2];
    def rao-observation-detail(o) = o[3];
    def rao-observation-code(o) = o[4];
    // outcome = ("runtime-artifact-outcome" route attempted fallback
    //            selection-status outcome-status observation-status
    //            selection-reason outcome-reason detail code)
    def rao-outcome(route, attempted, fallback, selection-status, outcome-status, observation-status, selection-reason, outcome-reason, detail, code) = ["runtime-artifact-outcome", route, attempted, fallback, selection-status, outcome-status, observation-status, selection-reason, outcome-reason, detail, code];
    def rao-outcome?(o) = (Comparable) len(o) == 11 ? (String) o[0] == "runtime-artifact-outcome" : 0;
    def rao-outcome-route(o) = o[1];
    def rao-outcome-attempted(o) = o[2];
    def rao-outcome-fallback(o) = o[3];
    def rao-outcome-selection-status(o) = o[4];
    def rao-outcome-status(o) = o[5];
    def rao-outcome-observation-status(o) = o[6];
    def rao-outcome-selection-reason(o) = o[7];
    def rao-outcome-reason(o) = o[8];
    def rao-outcome-detail(o) = o[9];
    def rao-outcome-code(o) = o[10];
    def rao-selection-row?(s) = (Comparable) len(s) == 8 ? (String) s[0] == "runtime-artifact-selection" : 0;
    def rao-selection-status-known?(s) = (String) ras-selection-status(s) == ras-status-selected() ? 1 : (String) ras-selection-status(s) == ras-status-investigate() ? 1 : (String) ras-selection-status(s) == ras-status-refused() ? 1 : 0;
    def rao-selection-readable?(s) = rao-selection-row?(s) ? rao-selection-status-known?(s) : 0;
    def rao-selection-selected?(s) = rao-selection-row?(s) ? (String) ras-selection-status(s) == ras-status-selected() : 0;
    def rao-selection-investigate?(s) = rao-selection-row?(s) ? (String) ras-selection-status(s) == ras-status-investigate() : 0;
    def rao-selection-refused?(s) = rao-selection-row?(s) ? (String) ras-selection-status(s) == ras-status-refused() : 0;
    def rao-fallback-present?(s) = (String) ras-selection-fallback(s) == rao-action-none() ? 0 : 1;
    def rao-hard-status?(status) = (String) status == rao-obs-oom-killed() ? 1 : (String) status == rao-obs-killed() ? 1 : (String) status == rao-obs-stalled() ? 1 : (String) status == rao-obs-timeout() ? 1 : (String) status == rao-obs-wrong-value() ? 1 : 0;
    def rao-soft-status?(status) = (String) status == rao-obs-loader-missing() ? 1 : (String) status == rao-obs-error() ? 1 : 0;
    def rao-refused-selection-row() = rao-outcome(rao-route-unknown(), rao-action-none(), rao-action-none(), ras-status-refused(), rao-status-refused(), rao-obs-none(), rao-reason-malformed-selection(), rao-reason-malformed-selection(), rao-detail-none(), rao-code-none());
    def rao-refused-observation-row(s) = rao-outcome(ras-selection-route(s), ras-selection-selected(s), ras-selection-fallback(s), ras-selection-status(s), rao-status-refused(), rao-obs-none(), ras-selection-reason(s), rao-reason-malformed-observation(), rao-detail-none(), rao-code-none());
    def rao-pending-row(s) = rao-outcome(ras-selection-route(s), ras-selection-selected(s), ras-selection-fallback(s), ras-selection-status(s), rao-status-pending-observation(), rao-obs-none(), ras-selection-reason(s), rao-reason-pending-observation(), rao-detail-none(), rao-code-none());
    def rao-terminal-row(s, reason, observation-status) = rao-outcome(ras-selection-route(s), ras-selection-selected(s), ras-selection-fallback(s), ras-selection-status(s), rao-selection-investigate?(s) ? rao-status-investigate() : rao-status-refused(), observation-status, ras-selection-reason(s), reason, rao-detail-none(), rao-code-none());
    def rao-complete-row(s, o) = rao-outcome(ras-selection-route(s), rao-observation-action(o), ras-selection-fallback(s), ras-selection-status(s), rao-status-complete(), rao-observation-status(o), ras-selection-reason(s), rao-reason-observation-ok(), rao-observation-detail(o), rao-observation-code(o));
    def rao-fallback-row(s, o) = rao-outcome(ras-selection-route(s), rao-observation-action(o), ras-selection-fallback(s), ras-selection-status(s), rao-status-fallback-available(), rao-observation-status(o), ras-selection-reason(s), rao-reason-soft-failure-fallback-available(), rao-observation-detail(o), rao-observation-code(o));
    def rao-investigate-row(s, o, reason) = rao-outcome(ras-selection-route(s), rao-observation-action(o), ras-selection-fallback(s), ras-selection-status(s), rao-status-investigate(), rao-observation-status(o), ras-selection-reason(s), reason, rao-observation-detail(o), rao-observation-code(o));
    def rao-investigate-selection-row(s, reason) = rao-outcome(ras-selection-route(s), ras-selection-selected(s), ras-selection-fallback(s), ras-selection-status(s), rao-status-investigate(), rao-obs-none(), ras-selection-reason(s), reason, rao-detail-none(), rao-code-none());
    def rao-outcome-from-selected-observation(s, o) = (Comparable) rao-run-observation?(o) == 1 ? (String) rao-observation-action(o) == ras-selection-selected(s) ? (String) rao-observation-status(o) == rao-obs-ok() ? rao-complete-row(s, o) : (Comparable) rao-hard-status?(rao-observation-status(o)) == 1 ? rao-investigate-row(s, o, rao-reason-hard-observation-investigates()) : (Comparable) rao-soft-status?(rao-observation-status(o)) == 1 ? (Comparable) rao-fallback-present?(s) == 1 ? rao-fallback-row(s, o) : rao-investigate-row(s, o, rao-reason-soft-failure-no-fallback()) : rao-investigate-row(s, o, rao-reason-unknown-observation-status()) : rao-investigate-row(s, o, rao-reason-observation-action-mismatch()) : rao-refused-observation-row(s);
    def rao-outcome-from-selection(s) = (Comparable) rao-selection-readable?(s) == 1 ? rao-selection-selected?(s) ? rao-pending-row(s) : rao-selection-investigate?(s) ? rao-terminal-row(s, rao-reason-selector-investigate(), rao-obs-none()) : rao-terminal-row(s, rao-reason-selector-refused(), rao-obs-none()) : (Comparable) rao-selection-row?(s) == 1 ? rao-investigate-selection-row(s, rao-reason-unknown-selection-status()) : rao-refused-selection-row();
    def rao-outcome-from-selection-observation(s, o) = (Comparable) rao-selection-readable?(s) == 1 ? rao-selection-selected?(s) ? rao-outcome-from-selected-observation(s, o) : (Comparable) rao-run-observation?(o) == 1 ? rao-terminal-row(s, rao-reason-terminal-observation-ignored(), rao-observation-status(o)) : rao-terminal-row(s, rao-reason-terminal-observation-ignored(), rao-obs-none()) : (Comparable) rao-selection-row?(s) == 1 ? rao-investigate-selection-row(s, rao-reason-unknown-selection-status()) : rao-refused-selection-row();
}
