// tool-channel.fk - native tool/channel catalog and planner.
//
// This file plans tool calls only. It never executes a host process, reads a
// file, sends HTTP, or invokes a kernel route. Cells and recipes discover
// protocols, providers, applets, and options here, then receive an explicit
// invocation plan. Wrong or missing capability returns tool/no-plan.
section [form.bml] {
    def tc-protocol(name, provider, capability, native, effect) = [name, provider, capability, native, effect];
    def tc-protocol-name(p) = p[0];
    def tc-protocol-provider(p) = p[1];
    def tc-protocol-capability(p) = p[2];
    def tc-protocol-native(p) = p[3];
    def tc-protocol-effect(p) = p[4];
    def tc-empty-protocol() = tc-protocol("", "", "", 0, "");
    def tc-protocols() = [tc-protocol("host:exec", "host", "cap.host.exec", 0, "process"), tc-protocol("host:process", "host", "cap.host.process", 1, "process-table"), tc-protocol("host:usage", "host", "cap.host.usage", 1, "resource-usage"), tc-protocol("host:file", "host", "cap.host.file", 0, "filesystem"), tc-protocol("gpu:compute", "accelerator", "cap.compute.gpu", 1, "parallel-compute"), tc-protocol("dsp:signal", "accelerator", "cap.compute.dsp", 1, "signal-kernel"), tc-protocol("metal:tensor", "accelerator", "cap.compute.metal", 1, "form-owned-metal-images"), tc-protocol("http:request", "http", "cap.http.request", 1, "network"), tc-protocol("kernel:call", "kernel", "cap.kernel.call", 1, "call"), tc-protocol("kernel:route", "kernel", "cap.kernel.route", 1, "route"), tc-protocol("hati.mesh:presence", "mesh", "cap.mesh.presence", 1, "organ-presence"), tc-protocol("stream:read", "stream", "cap.stream.read", 1, "stream"), tc-protocol("store:query", "store", "cap.store.query", 1, "store")];
    def tc-provider(name, protocol, capability) = [name, protocol, capability];
    def tc-provider-name(p) = p[0];
    def tc-provider-protocol(p) = p[1];
    def tc-provider-capability(p) = p[2];
    def tc-providers() = [tc-provider("host", "host:exec", "cap.host.exec"), tc-provider("process", "host:process", "cap.host.process"), tc-provider("usage", "host:usage", "cap.host.usage"), tc-provider("file", "host:file", "cap.host.file"), tc-provider("gpu", "gpu:compute", "cap.compute.gpu"), tc-provider("dsp", "dsp:signal", "cap.compute.dsp"), tc-provider("metal", "metal:tensor", "cap.compute.metal"), tc-provider("http", "http:request", "cap.http.request"), tc-provider("kernel", "kernel:call", "cap.kernel.call"), tc-provider("route", "kernel:route", "cap.kernel.route"), tc-provider("mesh", "hati.mesh:presence", "cap.mesh.presence"), tc-provider("stream", "stream:read", "cap.stream.read"), tc-provider("store", "store:query", "cap.store.query")];
    def tc-tool(name, protocol, capability, op, projection, input, output) = [name, protocol, capability, op, projection, input, output];
    def tc-tool-name(t) = t[0];
    def tc-tool-protocol(t) = t[1];
    def tc-tool-capability(t) = t[2];
    def tc-tool-op(t) = t[3];
    def tc-tool-projection(t) = t[4];
    def tc-tool-input(t) = t[5];
    def tc-tool-output(t) = t[6];
    def tc-empty-tool() = tc-tool("", "", "", "", "", "", "");
    def tc-agent-tool-names() = ["rg", "jq", "read", "cat", "head", "tail", "wc", "sort", "uniq", "tr", "cut", "awk", "sed", "edit", "write"];
    def tc-agent-tool-rows(names) = nil?(names) ? [] : cons(tc-tool(head(names), "kernel:call", "cap.kernel.call", head(names), "native", "resident-docs+argv+input", "tool-result+resident-docs"), tc-agent-tool-rows(tail(names)));
    def tc-tools() = append(list(tc-tool("exec", "host:exec", "cap.host.exec", "exec", "protocol", "argv", "stdout"), tc-tool("processes", "host:process", "cap.host.process", "process-snapshot", "host-resource", "selector", "process-rows"), tc-tool("usage", "host:usage", "cap.host.usage", "usage-sample", "host-resource", "sample-window", "usage-sample"), tc-tool("file", "host:file", "cap.host.file", "file", "protocol", "path", "bytes"), tc-tool("gpu-kernel", "gpu:compute", "cap.compute.gpu", "dispatch", "accelerator", "tensor-or-buffer", "compute-receipt"), tc-tool("dsp-kernel", "dsp:signal", "cap.compute.dsp", "dispatch", "accelerator", "pcm-or-signal-buffer", "signal-receipt"), tc-tool("metal-tensor", "metal:tensor", "cap.compute.metal", "dispatch", "accelerator", "metal-tensor", "tensor-receipt"), tc-tool("http", "http:request", "cap.http.request", "request", "protocol", "request", "response"), tc-tool("call", "kernel:call", "cap.kernel.call", "call", "protocol", "args", "value"), tc-tool("route", "kernel:route", "cap.kernel.route", "route", "protocol", "request", "response"), tc-tool("announce-organ", "hati.mesh:presence", "cap.mesh.presence", "announce", "protocol", "organ-presence", "receipt"), tc-tool("stream", "stream:read", "cap.stream.read", "read", "protocol", "cursor", "event"), tc-tool("query", "store:query", "cap.store.query", "query", "protocol", "selector", "rows"),     // Form-native zvec-grep: form-cli calls the BML organ directly over
    // resident Form rows. No filesystem, process, store, or network
    // protocol participates in execution.
tc-tool("zg", "kernel:call", "cap.kernel.call", "zvec-grep", "native", "resident-rows+route+query+limit", "ranked-resident-spans"), tc-tool("grep", "stream:read", "cap.stream.read", "grep", "shell-applet", "stream+needle", "matches"), tc-tool("find", "host:file", "cap.host.file", "find", "shell-applet", "root+pattern", "paths"), tc-tool("fields", "stream:read", "cap.stream.read", "fields", "shell-applet", "stream+field", "values"), tc-tool("group", "store:query", "cap.store.query", "group", "shell-applet", "rows+key", "groups"), tc-tool("words", "kernel:call", "cap.kernel.call", "words", "catalog", "none", "tools"), tc-tool("providers", "kernel:call", "cap.kernel.call", "providers", "catalog", "none", "providers"), tc-tool("queries", "kernel:call", "cap.kernel.call", "queries", "catalog", "none", "queries"), tc-tool("which", "kernel:call", "cap.kernel.call", "which", "catalog", "tool-name", "tool"), tc-tool("plan", "kernel:call", "cap.kernel.call", "plan", "catalog", "tool-name", "plan")), tc-agent-tool-rows(tc-agent-tool-names()));
    def tc-find-protocol(name, rows) = (Comparable) len(rows) == 0 ? tc-empty-protocol() : (String) tc-protocol-name(head(rows)) == name ? head(rows) : tc-find-protocol(name, tail(rows));
    def tc-protocol-by-name(name) = tc-find-protocol(name, tc-protocols());
    def tc-find-tool(name, rows) = (Comparable) len(rows) == 0 ? tc-empty-tool() : (String) tc-tool-name(head(rows)) == name ? head(rows) : tc-find-tool(name, tail(rows));
    def tc-which(name) = tc-find-tool(name, tc-tools());
    def tc-capability-matches?(expected, provided) = (String) expected == provided ? 1 : 0;
    def tc-protocol-carries?(protocol-name, capability) = tc-capability-matches?(tc-protocol-capability(tc-protocol-by-name(protocol-name)), capability);
    def tc-native-option?(tool-name) = tc-protocol-native(tc-protocol-by-name(tc-tool-protocol(tc-which(tool-name))));
    def tc-plan(status, tool, protocol, capability, op, witness) = [status, tool, protocol, capability, op, witness];
    def tc-plan-status(p) = p[0];
    def tc-plan-tool-name(p) = p[1];
    def tc-plan-protocol(p) = p[2];
    def tc-plan-capability(p) = p[3];
    def tc-plan-op(p) = p[4];
    def tc-plan-witness(p) = p[5];
    def tc-plan-tool-row(tool, capability) = (String) tc-tool-name(tool) == "" ? tc-plan("tool/no-plan", "", "", capability, "", "missing-tool") : (Comparable) tc-protocol-carries?(tc-tool-protocol(tool), capability) == 1 ? tc-plan("tool/plan", tc-tool-name(tool), tc-tool-protocol(tool), capability, tc-tool-op(tool), "capability-explicit") : tc-plan("tool/no-plan", tc-tool-name(tool), tc-tool-protocol(tool), capability, tc-tool-op(tool), "missing-capability");
    def tc-plan-tool(tool-name, capability) = tc-plan-tool-row(tc-which(tool-name), capability);
    def tc-plan-request(protocol-name, capability, op) = (Comparable) tc-protocol-carries?(protocol-name, capability) == 1 ? tc-plan("tool/plan", "", protocol-name, capability, op, "capability-explicit") : tc-plan("tool/no-plan", "", protocol-name, capability, op, "missing-capability");
    def tc-words() = tc-tools();
    def tc-provider-catalog() = tc-providers();
    def tc-query-catalog() = ["which", "plan", "words", "providers", "queries"];
    0;
}
