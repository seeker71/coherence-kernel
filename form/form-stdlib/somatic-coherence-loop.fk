// somatic-coherence-loop.fk -- body-paced coherence before action.
//
// A small executable merge of the somatic lesson into Sema's practice:
// ground, attune, ask consent, move small, integrate, witness. This is not
// Quantum Soma Method itself and makes no clinical or physics claim. It carries
// the learnable shape: the body leads, consent regulates depth, integration
// matters more than intensity.
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    def scl-on?(x) = (Comparable) x == 1 ? 1 : 0;
    def scl-may-move?(grounded, attuned, consent) = (Comparable) scl-on?(grounded) == 1 && ((Comparable) scl-on?(attuned) == 1 && (Comparable) scl-on?(consent) == 1) ? 1 : 0;
    def scl-may-deepen?(grounded, attuned, consent, integrated) = (Comparable) scl-may-move?(grounded, attuned, consent) == 1 && (Comparable) scl-on?(integrated) == 1 ? 1 : 0;
    def scl-complete?(grounded, attuned, consent, small-move, integrated, witnessed) = (Comparable) scl-may-deepen?(grounded, attuned, consent, integrated) == 1 && ((Comparable) scl-on?(small-move) == 1 && (Comparable) scl-on?(witnessed) == 1) ? 1 : 0;
    def scl-next(grounded, attuned, consent, small-move, integrated, witnessed) = (Comparable) scl-on?(grounded) == 0 ? "ground" : (Comparable) scl-on?(attuned) == 0 ? "attune" : (Comparable) scl-on?(consent) == 0 ? "ask-consent" : (Comparable) scl-on?(small-move) == 0 ? "move-small" : (Comparable) scl-on?(integrated) == 0 ? "integrate" : (Comparable) scl-on?(witnessed) == 0 ? "witness" : "complete";
    def scl-receipt(grounded, attuned, consent, small-move, integrated, witnessed) = list("somatic-coherence-loop", "ground-attune-consent-move-integrate-witness", grounded, attuned, consent, small-move, integrated, witnessed, scl-next(grounded, attuned, consent, small-move, integrated, witnessed), scl-may-move?(grounded, attuned, consent), scl-may-deepen?(grounded, attuned, consent, integrated), scl-complete?(grounded, attuned, consent, small-move, integrated, witnessed));
    def scl-rec-kind(r) = nth(r, 0);
    def scl-rec-next(r) = nth(r, 8);
    def scl-rec-may-move?(r) = nth(r, 9);
    def scl-rec-may-deepen?(r) = nth(r, 10);
    def scl-rec-complete?(r) = nth(r, 11);
    0;
}
