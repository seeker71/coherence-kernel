//////////////////////////////////////////////////////////////////////
// gguf-type-census.bml — the tensor types a GGUF file carries, read
// from its own header and held against what this body carves.
//
// A precision row that names a missing format is a claim about the
// files here as much as about the body: a format is owed only where a
// file on this disk carries it. This walks every tensor-info record of
// one file — the header window only, so an 85 GB file is read for its
// header and nothing else — and hands back each tensor's type.
//
// Read: the four storage types, and the fourteen quant formats that
// tests/quant-carve-census-band.fk mints on this Mac.
//
// RADIUS: the tensor-info table ends inside gtc-window for every file
// the registry named on 2026-09-10. A longer header is read past its
// bytes and the kernel stops loud; it cannot answer with a short count.
// preludes: form/form-stdlib/core.fk form/form-stdlib/str-byte-at.fk form/form-stdlib/equireach.fk form/form-stdlib/format-arith.fk form/form-stdlib/equireach-gguf.fk
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormGgufTypeCensus {
        def gtc-storage() = list(0, 1, 26, 30);
        def gtc-carved() = list(6, 8, 10, 11, 12, 13, 14, 16, 17, 18, 20, 23, 40, 41);
        def gtc-in?(t, xs) = if eq(len(xs), 0) then 0 else if eq(head(xs), t) then 1 else gtc-in?(t, tail(xs));
        def gtc-read?(t) = if eq(gtc-in?(t, gtc-storage()), 1) then 1 else gtc-in?(t, gtc-carved());

        def gtc-window() = 67108864;

        // every tensor's type, walking the table record by record
        def gtc-walk(src, off, remaining, acc) = if eq(remaining, 0) then acc else gtc-walk(src, egg-ti-next(src, off), sub(remaining, 1), cons(egg-ti-type(src, off), acc));

        // one file: list(state, types), state one of read / absent / not-gguf
        def gtc-file(path) = if gt(file_mtime(path), 0) then gtc-src(read_file_slice(path, 0, gtc-window())) else list("absent", list());
        def gtc-src(src) = if eq(egg-magic-ok?(src), 1) then list("read", gtc-walk(src, egg-tinfo-start(src), egg-tensor-count(src), list())) else list("not-gguf", list());

        def gtc-count(t, xs, n) = if eq(len(xs), 0) then n else gtc-count(t, tail(xs), if eq(head(xs), t) then add(n, 1) else n);
        def gtc-unread(xs, n) = if eq(len(xs), 0) then n else gtc-unread(tail(xs), if eq(gtc-read?(head(xs)), 1) then n else add(n, 1));

        // the distinct types, ascending
        def gtc-insert(t, xs) = if eq(len(xs), 0) then list(t) else if lt(t, head(xs)) then cons(t, xs) else cons(head(xs), gtc-insert(t, tail(xs)));
        def gtc-distinct(xs, seen) = if eq(len(xs), 0) then seen else gtc-distinct(tail(xs), if eq(gtc-in?(head(xs), seen), 1) then seen else gtc-insert(head(xs), seen));

        // "type:count", with ! where no carver reads the type
        def gtc-mark(t) = if eq(gtc-read?(t), 1) then "" else "!";
        def gtc-cell(t, types) = str_concat(int_to_str(t), str_concat(":", str_concat(int_to_str(gtc-count(t, types, 0)), gtc-mark(t))));
        def gtc-line(ds, types) = if eq(len(ds), 0) then "" else str_concat(" ", str_concat(gtc-cell(head(ds), types), gtc-line(tail(ds), types)));
    }
    0;
}
