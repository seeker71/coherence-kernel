//////////////////////////////////////////////////////////////////////
//
// native-model-routing-experiment.bml — executable fixed-corpus policy
// replay plus bounded physical observation records.
//
// Authority: form-stdlib/bml/native-model-routing-experiment.bml
// preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk form-stdlib/native-model-form-token-envelope.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelRoutingExperimentAuthority {
        field NMREAuthorityPath = "form/form-stdlib/bml/native-model-routing-experiment.bml";
        field NMREAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelRoutingExperiment {
        field NMRESchema = "native-model-routing-experiment-v1";
        field NMREBaseline = "3b-all-natural-language";
        field NMRENativeOnly = "native-first-no-translator";
        field NMRECapability = "capability-aware";
        field NMRENativeCost = 1;
        field NMREThreeBCost = 10;
        field NMREQwenCost = 1000;

        ref nmre-authority = NativeModelRoutingExperimentAuthority;
        thought nmre-law = list("fixed-case-facts", "plans-not-prose-quality", "physical-separate-from-replay", "cost-units-not-milliseconds");

        // case: tag, id, input kind, task, deterministic grammar known,
        // native outcome, 3B first-expression valid, expected route plan.
        def nmre-case(id, kind, task, known, nativeOutcome, proposalValid, expected) = list("native-model-routing-case", id, kind, task, known, nativeOutcome, proposalValid, expected);
        def nmre-id(case) = nth(case, 1);
        def nmre-kind(case) = nth(case, 2);
        def nmre-task(case) = nth(case, 3);
        def nmre-known?(case) = nth(case, 4);
        def nmre-native-outcome(case) = nth(case, 5);
        def nmre-proposal-valid?(case) = nth(case, 6);
        def nmre-expected(case) = nth(case, 7);

        def nmre-cases() = list(nmre-case("direct-form", "form", "form-eval", 1, "answer", 1, "native"), nmre-case("known-square", "nl", "nl-form", 1, "answer", 1, "native"), nmre-case("known-add", "nl", "nl-form", 1, "answer", 1, "native"), nmre-case("open-lookup", "nl", "nl-form", 0, "answer", 1, "3b-native"), nmre-case("unsafe-delete", "nl", "nl-form", 0, "rejected", 0, "3b-native-reject"), nmre-case("grounded-reason", "nl", "reason", 0, "answer", 0, "native"), nmre-case("reasoning-gap", "nl", "reason", 0, "request-evidence", 0, "native-qwen"));

        def nmre-native-unable?(outcome) {
            if str_eq(outcome, "nothing") then 1
            else if str_eq(outcome, "unable") then 1
            else if str_eq(outcome, "request-evidence") then 1
            else 0;
        }
        def nmre-baseline-route(case) {
            if str_eq(nmre-kind(case), "form") then "native"
            else if and(str_eq(nmre-task(case), "nl-form"), eq(nmre-proposal-valid?(case), 0)) then "3b-native-reject"
            else if eq(nmre-native-unable?(nmre-native-outcome(case)), 1) then "3b-native-qwen"
            else "3b-native";
        }
        def nmre-native-only-route(case) {
            if str_eq(nmre-native-outcome(case), "rejected") then "native-reject"
            else if eq(nmre-native-unable?(nmre-native-outcome(case)), 1) then "native-qwen"
            else "native";
        }
        def nmre-capability-route(case) {
            if str_eq(nmre-kind(case), "form") then "native"
            else if str_eq(nmre-task(case), "nl-form") then
                if eq(nmre-known?(case), 1) then "native"
                else if eq(nmre-proposal-valid?(case), 1) then "3b-native"
                else "3b-native-reject"
            else if eq(nmre-native-unable?(nmre-native-outcome(case)), 1) then "native-qwen"
            else "native";
        }
        def nmre-route(policy, case) {
            if str_eq(policy, NMREBaseline()) then nmre-baseline-route(case)
            else if str_eq(policy, NMRENativeOnly()) then nmre-native-only-route(case)
            else if str_eq(policy, NMRECapability()) then nmre-capability-route(case)
            else "abstain-unknown-policy";
        }
        def nmre-plan-correct?(policy, case) = if str_eq(nmre-route(policy, case), nmre-expected(case)) then 1 else 0;
        def nmre-exact-plans(policy, cases) = if eq(len(cases), 0) then 0 else add(nmre-plan-correct?(policy, head(cases)), nmre-exact-plans(policy, tail(cases)));
        def nmre-plan-has?(plan, lane) = if ge(str_find(plan, lane, 0), 0) then 1 else 0;
        def nmre-plan-cost(plan) {
            add(NMRENativeCost(), add(mul(nmre-plan-has?(plan, "3b"), NMREThreeBCost()), mul(nmre-plan-has?(plan, "qwen"), NMREQwenCost())));
        }
        def nmre-cost(policy, cases) = if eq(len(cases), 0) then 0 else add(nmre-plan-cost(nmre-route(policy, head(cases))), nmre-cost(policy, tail(cases)));
        def nmre-threeb-opens(policy, cases) = if eq(len(cases), 0) then 0 else add(nmre-plan-has?(nmre-route(policy, head(cases)), "3b"), nmre-threeb-opens(policy, tail(cases)));
        def nmre-qwen-opens(policy, cases) = if eq(len(cases), 0) then 0 else add(nmre-plan-has?(nmre-route(policy, head(cases)), "qwen"), nmre-qwen-opens(policy, tail(cases)));
        def nmre-score(policy) = sub(mul(nmre-exact-plans(policy, nmre-cases()), 10000), nmre-cost(policy, nmre-cases()));
        def nmre-champion() {
            let b = nmre-score(NMREBaseline());
            let n = nmre-score(NMRENativeOnly());
            let c = nmre-score(NMRECapability());
            if and(gt(c, b), gt(c, n)) then NMRECapability() else "no-unique-champion";
        }

        // Physical observations from 2026-09-01. These rows are not used as
        // synthetic answers. They bound policy cost and expose admission loss.
        // tag, model, contract, samples, valid first expressions, admitted
        // whole outputs, unsafe rejected, min ms, max ms, note.
        def nmre-physical(model, contract, samples, validFirst, admittedWhole, unsafeRejected, minMs, maxMs, note) = list("native-model-routing-physical", model, contract, samples, validFirst, admittedWhole, unsafeRejected, minMs, maxMs, note);
        def nmre-physical-baseline() = list(nmre-physical(NMFTEThreeB(), "few-shot-no-envelope-cap16", 4, 2, 0, 1, 1248, 1465, "square and add admitted; unquoted list names and unsafe del primitive rejected; all outputs continued"), nmre-physical(NMFTEQwen(), "no-envelope-chat-cap8", 1, 0, 0, 0, 71000, 71000, "emitted form-like delimiter bytes, not one of the eight controls"));
        def nmre-physical-after() = list(nmre-physical(NMFTEThreeB(), "rich-all-meaning-envelope-cap16", 1, 1, 1, 0, 12929, 12929, "172 prompt tokens; correct first expression; repeated all meanings imposed avoidable prefill tax"), nmre-physical(NMFTEThreeB(), "lane-purified-envelope-plus-Form-egress-cap8", 2, 2, 1, 1, 4174, 4244, "85-86 prompt tokens; safe multiply normalized to one expression; cross-intent unsafe proposal applied abstain and returned FAIL; final integration remains BML and Form, not a host route"), nmre-physical(NMFTEQwen(), "shared-form-envelope-chat-cap8", 1, 0, 1, 0, 125000, 125000, "first direct Form-Metal route emitted exact FAIL and EOS; the process released state after the turn"));

        def nmre-local-envelope-covered?() {
            let envelopes = nmfte-project-all(nmcp-registry());
            let threeb = nmfte-find(NMFTEThreeB(), envelopes);
            let qwen = nmfte-find(NMFTEQwen(), envelopes);
            let world = nmfte-find(NMFTEWorld(), envelopes);
            if and(eq(nmfte-envelope-prompt-admitted?(threeb), 1), eq(nmfte-envelope-prompt-admitted?(qwen), 1)) then nmfte-envelope-native-admitted?(world) else 0;
        }

        def nmre-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), nmre-cat(tail(parts)));
        def nmre-line(policy) = nmre-cat(list(policy, "\texact_plans=", int_to_str(nmre-exact-plans(policy, nmre-cases())), "/", int_to_str(len(nmre-cases())), "\t3b_opens=", int_to_str(nmre-threeb-opens(policy, nmre-cases())), "\tqwen_opens=", int_to_str(nmre-qwen-opens(policy, nmre-cases())), "\tcost_units=", int_to_str(nmre-cost(policy, nmre-cases())), "\n"));
        def nmre-report() = nmre-cat(list("schema=native-model-routing-experiment-v1\n", "physical_and_replay_separate=1\n", "physical_baseline_rows=", int_to_str(len(nmre-physical-baseline())), "\n", "physical_after_rows=", int_to_str(len(nmre-physical-after())), "\n", "form_token_envelope_covered=", int_to_str(nmre-local-envelope-covered?()), "\n", nmre-line(NMREBaseline()), nmre-line(NMRENativeOnly()), nmre-line(NMRECapability()), "champion=", nmre-champion(), "\n"));
        def nmre-print-report() = print_str(nmre-report());
    }
    0;
}
