//////////////////////////////////////////////////////////////////////
// IQ3_XXS (GGML type 18) layout authority for Flash-Next.
//////////////////////////////////////////////////////////////////////

package Form.native.quant;

import Form.kernel.*;
import Form.native.metal.*;

interface IIQ3XXSLayout [public, witness, reusable] {
   section [public] {
      const int GGMLType = 18;
      const int BlockElements = 256;
      const int BlockBytes = 98;
      const int QuantOffset = 2;
      const int QuantBytes = 64;
      const int AuxOffset = 66;
      const int AuxBytes = 32;
      const int GroupsPerBlock = 8;
      const int GroupElements = 32;
      const int GridEntries = 256;
      const int SIMDWidth = 32;
      const int SlotRows = 4;

      int GridIndex( Object bytes, int blockBase, int weightIndex ) [abstract];
      int SignIndex( Object bytes, int blockBase, int weightIndex ) [abstract];
      int ScaleCode( Object bytes, int blockBase, int weightIndex ) [abstract];
      bool WithinBlock( int weightIndex ) [abstract];
   }
}
class IQ3XXSLayout [public, reusable, teach, observable] : IIQ3XXSLayout {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/iq3xxs-layout.bml";
      const String Model = "Qwen3.8-Flash-Next UD-Q2_K_XL";
      int GridIndex( Object bytes, int blockBase, int weightIndex ) [abstract] {}
      int SignIndex( Object bytes, int blockBase, int weightIndex ) [abstract] {}
      int ScaleCode( Object bytes, int blockBase, int weightIndex ) [abstract] {}
      bool WithinBlock( int weightIndex ) [abstract] {}
   }
}
