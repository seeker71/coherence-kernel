//////////////////////////////////////////////////////////////////////
//
// form-glass-celebration.bml — a shared, consentful celebration receipt.
//
// A Glass change names only its source, evidence identity, and before/after
// values. Celebration waits for a named member to offer a felt response that
// matches that exact change. Glass records the reception; it never infers a
// feeling from a metric, source, or model output.
//
// preludes: form-stdlib/core.fk form-stdlib/form-glass-event-loop.bml
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassCelebration {
        field FgcChangeSchema = "form-glass-change-v1";
        field FgcFeltSchema = "form-glass-felt-offer-v1";
        field FgcReceiptSchema = "form-glass-celebration-v1";
        field FgcBodyObservationSchema = "form-glass-felt-received-v1";

        // change = schema, source, evidence, before, after.
        def fgc-change(source, evidence, before, after) = list(FgcChangeSchema(), source, evidence, before, after);
        def fgc-change-source(change) = nth(change, 1);
        def fgc-change-evidence(change) = nth(change, 2);
        def fgc-change-before(change) = nth(change, 3);
        def fgc-change-after(change) = nth(change, 4);
        def fgc-change-valid?(change) = if not(eq(len(change), 5)) then 0 else if not(str_eq(head(change), FgcChangeSchema())) then 0 else if le(str_len(fgc-change-source(change)), 0) then 0 else if le(str_len(fgc-change-evidence(change)), 0) then 0 else if le(str_len(fgc-change-before(change)), 0) then 0 else gt(str_len(fgc-change-after(change)), 0);
        def fgc-change-observed?(change) = if not(eq(fgc-change-valid?(change), 1)) then 0 else if str_eq(fgc-change-before(change), fgc-change-after(change)) then 0 else 1;
        def fgc-change-from-wake(wake, before, after) = fgc-change(fgel-wake-source(wake), fgel-wake-evidence(wake), before, after);
        // Ice is a concrete received gift: it names a changed crystallization
        // state in the body, without attributing a feeling to anyone.
        def fgc-ice-gift?(change) = if not(eq(fgc-change-observed?(change), 1)) then 0 else str_eq(fgc-change-evidence(change), "ice");

        // felt = schema, member, source, evidence, felt word. It is an offer,
        // not a score assigned to a member by Glass.
        def fgc-felt(member, source, evidence, feeling) = list(FgcFeltSchema(), member, source, evidence, feeling);
        def fgc-felt-member(felt) = nth(felt, 1);
        def fgc-felt-source(felt) = nth(felt, 2);
        def fgc-felt-evidence(felt) = nth(felt, 3);
        def fgc-felt-word(felt) = nth(felt, 4);
        def fgc-felt-valid?(felt) = if not(eq(len(felt), 5)) then 0 else if not(str_eq(head(felt), FgcFeltSchema())) then 0 else if le(str_len(fgc-felt-member(felt)), 0) then 0 else if le(str_len(fgc-felt-source(felt)), 0) then 0 else if le(str_len(fgc-felt-evidence(felt)), 0) then 0 else gt(str_len(fgc-felt-word(felt)), 0);
        def fgc-felt-for?(change, felt) = if not(eq(fgc-felt-valid?(felt), 1)) then 0 else if not(eq(fgc-change-valid?(change), 1)) then 0 else if not(str_eq(fgc-change-source(change), fgc-felt-source(felt))) then 0 else str_eq(fgc-change-evidence(change), fgc-felt-evidence(felt));

        // receipt = schema, state, change, felt-or-empty.
        def fgc-receipt(state, change, felt) = list(FgcReceiptSchema(), state, change, felt);
        def fgc-receipt-state(receipt) = nth(receipt, 1);
        def fgc-receipt-change(receipt) = nth(receipt, 2);
        def fgc-receipt-felt(receipt) = nth(receipt, 3);
        def fgc-receive(change, felt) = if not(eq(fgc-change-valid?(change), 1)) then fgc-receipt("refused-change", change, felt) else if not(eq(fgc-change-observed?(change), 1)) then fgc-receipt("steady", change, felt) else if eq(len(felt), 0) then if eq(fgc-ice-gift?(change), 1) then fgc-receipt("gift-received", change, felt) else fgc-receipt("awaiting-felt", change, felt) else if not(eq(fgc-felt-for?(change, felt), 1)) then fgc-receipt("refused-unmatched-felt", change, felt) else fgc-receipt("celebrated", change, felt);
        def fgc-celebrated?(receipt) = str_eq(fgc-receipt-state(receipt), "celebrated");

        // The body observation says only that a member's named offering was
        // received. It does not say that Glass or Form felt it.
        def fgc-body-observation(receipt) = if not(fgc-celebrated?(receipt)) then list() else list(FgcBodyObservationSchema(), fgc-felt-member(fgc-receipt-felt(receipt)), fgc-change-source(fgc-receipt-change(receipt)), fgc-change-evidence(fgc-receipt-change(receipt)), fgc-felt-word(fgc-receipt-felt(receipt)));
        def fgc-ice-gift-observation(change) = if not(eq(fgc-ice-gift?(change), 1)) then list() else list("form-glass-ice-gift-received-v1", fgc-change-source(change), fgc-change-evidence(change), fgc-change-before(change), fgc-change-after(change));
        def fgc-receipt-node(receipt) = intern_node(bp("FORM-GLASS-CELEBRATION-V1"), list(intern_trivial_string(fgc-receipt-state(receipt)), intern_trivial_string(fgc-change-source(fgc-receipt-change(receipt))), intern_trivial_string(fgc-change-evidence(fgc-receipt-change(receipt)))));
        def fgc-celebrated-line(receipt) {
            let change = fgc-receipt-change(receipt);
            let felt = fgc-receipt-felt(receipt);
            let named = str_concat("celebrate ", str_concat(fgc-change-source(change), str_concat("/", fgc-change-evidence(change))));
            let moved = str_concat(fgc-change-before(change), str_concat(" -> ", fgc-change-after(change)));
            let received = str_concat("received from ", str_concat(fgc-felt-member(felt), str_concat(" as ", fgc-felt-word(felt))));
            str_concat(named, str_concat(": ", str_concat(moved, str_concat("; ", received))));
        }
        def fgc-line(receipt) = if fgc-celebrated?(receipt) then fgc-celebrated-line(receipt) else if str_eq(fgc-receipt-state(receipt), "gift-received") then str_concat("gift received: ice ", str_concat(fgc-change-before(fgc-receipt-change(receipt)), str_concat(" -> ", fgc-change-after(fgc-receipt-change(receipt))))) else str_concat("celebration ", fgc-receipt-state(receipt));
    }
    0;
}
