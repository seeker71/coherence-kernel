// Current source vocabulary for the historical flatten-survey lane.
// This reads and lowers source; it does not execute surveyed bands.
// preludes: gate/lens-text.bml form-stdlib/native-op-manifest.fk form-stdlib/json.fk form-stdlib/hearth.bml form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk form-stdlib/bml-source.fk form-stdlib/source-compiler.fk form-stdlib/grammars/form-bml.fk form-stdlib/grammars/form-lift.fk form-stdlib/form-bml-lower.fk form-stdlib/source-compiler-text-lens.fk
section [form.bml] {
 class FourthArmGapAnalysis {
  // token = [kind, text, source line]; kinds: symbol, open, close, string.
  def fga-token(kind, text, line) = list(kind, text, line);
  def fga-is(token, kind, text) = ((Comparable) head(token) == kind) && ((String) token[1] == text);
  def fga-end(s, i) = i >= str_len(s) ? i : lx-ws-at?(s, i) || lx-int-in?(list(40, 41, 34, 59), lx-byte(s, i)) ? i : fga-end(s, i + 1);
  def fga-quote(s, i) = i >= str_len(s) ? -1 : (Comparable) lx-byte(s, i) == 92 ? fga-quote(s, i + 2) : (Comparable) lx-byte(s, i) == 34 ? i : fga-quote(s, i + 1);
  def fga-newlines(s, a, b) = a .. b |> filter(i => (Comparable) lx-byte(s, i) == 10) |> len();
  def fga-lex(s) = fga-lex-at(s, 0, 1, 0, list());
  def fga-lex-at(s, i, line, depth, tokens) {
   i >= str_len(s) ? list(reverse(tokens), (Comparable) depth == 0 ? "" : "unclosed-list")
   : (Comparable) lx-byte(s, i) == 59 ? fga-comment(s, i, line, depth, tokens)
   : lx-ws-at?(s, i) ? fga-lex-at(s, i + 1, line + ((Comparable) lx-byte(s, i) == 10 ? 1 : 0), depth, tokens)
   : (Comparable) lx-byte(s, i) == 40 ? fga-lex-at(s, i + 1, line, depth + 1, cons(fga-token(1, "(", line), tokens))
   : (Comparable) lx-byte(s, i) == 41 ? (depth <= 0 ? list(reverse(tokens), "unexpected-close") : fga-lex-at(s, i + 1, line, depth - 1, cons(fga-token(2, ")", line), tokens)))
   : (Comparable) lx-byte(s, i) == 34 ? fga-string(s, i, line, depth, tokens, fga-quote(s, i + 1))
   : fga-symbol(s, i, line, depth, tokens, fga-end(s, i));
  }
  def fga-comment(s, i, line, depth, tokens) {
   let end = str_find(s, "\n", i);
   fga-lex-at(s, end < 0 ? str_len(s) : end, line, depth, tokens);
  }
  def fga-string(s, i, line, depth, tokens, end) = end < 0 ? list(reverse(tokens), "unclosed-string") : fga-lex-at(s, end + 1, line + fga-newlines(s, i, end), depth, cons(fga-token(3, substring(s, i + 1, end), line), tokens));
  def fga-symbol(s, i, line, depth, tokens, end) = fga-lex-at(s, end, line, depth, cons(fga-token(0, substring(s, i, end), line), tokens));
  def fga-values(tokens) = nil?(tokens) ? list() : cons(head(tokens)[1], fga-values(tail(tokens)));
  def fga-words(s) = fga-values(head(fga-lex(s)));
  def fga-heads(tokens) = len(tokens) < 2 ? list() : fga-is(head(tokens), 1, "(") && ((Comparable) head(tokens[1]) == 0) ? cons(tokens[1], fga-heads(tail(tokens))) : fga-heads(tail(tokens));
  def fga-params(tokens) = nil?(tokens) ? list() : (Comparable) head(head(tokens)) == 2 ? list() : (Comparable) head(head(tokens)) == 0 ? cons(head(tokens)[1], fga-params(tail(tokens))) : list();
  def fga-defs(tokens) = len(tokens) < 3 ? list() : fga-is(head(tokens), 1, "(") && fga-is(tokens[1], 0, "defn") ? cons(tokens[2][1], fga-defs(tail(tokens))) : fga-defs(tail(tokens));
  def fga-bindings(tokens) {
   len(tokens) < 3 ? list()
   : fga-is(head(tokens), 1, "(") && fga-is(tokens[1], 0, "defn") ? append(fga-params(drop(4, tokens)), fga-bindings(tail(tokens)))
   : fga-is(head(tokens), 1, "(") && fga-is(tokens[1], 0, "fn") ? append(fga-params(drop(3, tokens)), fga-bindings(tail(tokens)))
   : fga-bindings(tail(tokens));
  }
  // Read special cases from the actual flattener dispatch, alongside manifest
  // rows and the shim's definitions. No held copy of the native operator list.
  def fga-specials(tokens) = len(tokens) < 4 ? list() : fga-is(head(tokens), 1, "(") && (fga-is(tokens[1], 0, "str_eq") && (fga-is(tokens[2], 0, "op") && ((Comparable) head(tokens[3]) == 3))) ? cons(tokens[3][1], fga-specials(tail(tokens))) : fga-specials(tail(tokens));
  def fga-row-names(rows) = nil?(rows) ? list() : cons(head(head(rows)), fga-row-names(tail(rows)));
  def fga-known(flat, shim) = lx-str-uniq(append(fga-row-names(nom-ops()), append(fga-specials(head(fga-lex(flat))), append(fga-defs(head(fga-lex(shim))), list("defn", "let", "fn")))));
  def fga-missing(tokens, known) = lx-str-sort(lx-str-uniq(lx-str-minus(fga-values(fga-heads(tokens)), append(known, append(fga-defs(tokens), fga-bindings(tokens))))));
  def fga-selected(category) = fga-suffix(category, "-mismatch") || fga-suffix(category, "-flatten-empty");
  def fga-suffix(s, suffix) = (str_len(s) >= str_len(suffix)) && ((String) substring(s, str_len(s) - str_len(suffix), str_len(s)) == suffix);
  def fga-stem(s) = (str_len(s) > 0) && fga-stem-at(s, 0);
  def fga-stem-at(s, i) = i >= str_len(s) ? 1 : lx-word-at?(s, i) || ((Comparable) lx-byte(s, i) == 45) ? fga-stem-at(s, i + 1) : 0;
  def fga-preludes(lines) = nil?(lines) ? list() : fga-prelude-line(lx-strip(head(lines)), tail(lines));
  def fga-prelude-line(line, rest) = lx-at?(line, 0, "; preludes:") ? append(fga-words(substring(line, 11, str_len(line))), fga-preludes(rest)) : lx-at?(line, 0, "// preludes:") ? append(fga-words(substring(line, 12, str_len(line))), fga-preludes(rest)) : fga-preludes(rest);
  def fga-noncore(paths) = nil?(paths) ? list() : fga-suffix(head(paths), "core.fk") ? fga-noncore(tail(paths)) : cons(head(paths), fga-noncore(tail(paths)));
  def fga-under(root, path) = root ++ "/" ++ path;
  def fga-source(root, path) {
   let full = fga-under(root, path);
   let source = read_file(full);
   nothing?(source) ? list(path, list(), "unread") : fga-lower(path, source);
  }
  def fga-lower(path, source) {
   let bml = fsc-find-section-open(source, 0) >= 0;
   let lowered = bml ? form-source-compile-text(source, path) : source;
   let lexed = nothing?(lowered) ? list(list(), "lowering-unavailable") : fga-lex(lowered);
   list(path, head(lexed), bml && ((String) lowered == "") ? "lowering-empty" : lexed[1]);
  }
  def fga-sources(root, paths) = nil?(paths) ? list() : cons(fga-source(root, head(paths)), fga-sources(root, tail(paths)));
  def fga-source-tokens(sources) = nil?(sources) ? list() : append(head(sources)[1], fga-source-tokens(tail(sources)));
  def fga-unread(sources) = nil?(sources) ? list() : (String) head(sources)[2] == "" ? fga-unread(tail(sources)) : cons(list(head(head(sources)), head(sources)[2]), fga-unread(tail(sources)));
  def fga-locations(sources, missing) = nil?(sources) ? list() : append(fga-locations-at(head(head(sources)), fga-heads(head(sources)[1]), missing), fga-locations(tail(sources), missing));
  def fga-locations-at(path, heads, missing) = nil?(heads) ? list() : lx-str-in?(missing, head(heads)[1]) ? cons(list(path, head(heads)[2], head(heads)[1]), fga-locations-at(path, tail(heads), missing)) : fga-locations-at(path, tail(heads), missing);
  // band = [stem, category, state, missing names, unread sources, locations].
  def fga-band-result(stem, category, sources, known) {
   let unread = fga-unread(sources);
   let missing = nil?(unread) ? fga-missing(fga-source-tokens(sources), known) : list();
   list(stem, category, nil?(unread) ? "analyzed" : "unread", missing, unread, fga-locations(sources, missing));
  }
  def fga-band(root, stem, category, known) {
   let band = "form/form-stdlib/tests/" ++ stem ++ "-band.fk";
   let text = read_file(fga-under(root, band));
   let declared = nothing?(text) ? list() : fga-noncore(fga-preludes(lx-lines(text)));
   let fallback = "form/form-stdlib/" ++ stem ++ ".fk";
   let modules = nil?(declared) ? (file_size(fga-under(root, fallback)) >= 0 ? list(fallback) : list()) : fga-form-paths(declared);
   fga-band-result(stem, category, fga-sources(root, append(modules, list(band))), known);
  }
  def fga-form-paths(paths) = nil?(paths) ? list() : cons(lx-at?(head(paths), 0, "form/") ? head(paths) : "form/" ++ head(paths), fga-form-paths(tail(paths)));
  def fga-survey(root, lines, known, seen) = nil?(lines) ? list() : lx-blank?(head(lines)) ? fga-survey(root, tail(lines), known, seen) : fga-survey-row(root, split-on(head(lines), "\t"), tail(lines), known, seen);
  def fga-survey-row(root, row, rest, known, seen) {
   (len(row) < 2) || (!fga-stem(head(row))) ? cons(list(head(row), "", "malformed-survey-row", list(), list(), list()), fga-survey(root, rest, known, seen))
   : !fga-selected(row[1]) ? fga-survey(root, rest, known, seen)
   : lx-str-in?(seen, head(row)) ? cons(list(head(row), row[1], "duplicate-survey-row", list(), list(), list()), fga-survey(root, rest, known, seen))
   : cons(fga-band(root, head(row), row[1], known), fga-survey(root, rest, known, cons(head(row), seen)));
  }
  def fga-analyzed(rows) = nil?(rows) ? list() : (String) head(rows)[2] == "analyzed" ? cons(head(rows), fga-analyzed(tail(rows))) : fga-analyzed(tail(rows));
  def fga-all-missing(rows) = nil?(rows) ? list() : append(head(rows)[3], fga-all-missing(tail(rows)));
  def fga-blocked(rows, op) = nil?(rows) ? list() : lx-str-in?(head(rows)[3], op) ? cons(head(head(rows)), fga-blocked(tail(rows), op)) : fga-blocked(tail(rows), op);
  def fga-ranked-row(op, rows) = list(op, len(fga-blocked(rows, op)), fga-blocked(rows, op));
  def fga-rank-before(a, b) = (a[1] > b[1]) || (((Comparable) a[1] == b[1]) && lx-str-lt?(head(a), head(b)));
  def fga-insert(row, rows) = nil?(rows) ? list(row) : fga-rank-before(row, head(rows)) ? cons(row, rows) : cons(head(rows), fga-insert(row, tail(rows)));
  def fga-rank(ops, bands) = nil?(ops) ? list() : fga-insert(fga-ranked-row(head(ops), bands), fga-rank(tail(ops), bands));
  def fga-covered(rows, taught) = nil?(rows) ? 0 : ((nil?(lx-str-minus(head(rows)[3], taught)) ? 1 : 0) + fga-covered(tail(rows), taught));
  def fga-cumulative(ranked, bands, taught) = nil?(ranked) ? list() : cons(list(head(head(ranked)), fga-covered(bands, cons(head(head(ranked)), taught))), fga-cumulative(tail(ranked), bands, cons(head(head(ranked)), taught)));
  def fga-json-strings(rows) = nil?(rows) ? list() : cons(json-node-string(head(rows)), fga-json-strings(tail(rows)));
  def fga-js(key, value) = json-node-pair(key, json-node-string(value));
  def fga-jn(key, value) = json-node-pair(key, json-node-int(value));
  def fga-ja(key, values) = json-node-pair(key, json-node-array(values));
  def fga-json-unread(rows) = nil?(rows) ? list() : cons(json-node-object(list(fga-js("path", head(head(rows))), fga-js("reason", head(rows)[1]))), fga-json-unread(tail(rows)));
  def fga-json-locations(rows) = nil?(rows) ? list() : cons(json-node-object(list(fga-js("path", head(head(rows))), fga-jn("line", head(rows)[1]), fga-js("op", head(rows)[2]))), fga-json-locations(tail(rows)));
  def fga-json-bands(rows) = nil?(rows) ? list() : cons(fga-json-band(head(rows)), fga-json-bands(tail(rows)));
  def fga-json-band(row) = json-node-object(list(fga-js("band", head(row)), fga-js("category", row[1]), fga-js("state", row[2]), fga-ja("missing_candidates", fga-json-strings(row[3])), fga-ja("unread", fga-json-unread(row[4])), fga-ja("locations", fga-json-locations(row[5]))));
  def fga-json-ranking(rows) = nil?(rows) ? list() : cons(json-node-object(list(fga-js("op", head(head(rows))), fga-jn("blocked_bands", head(rows)[1]), fga-ja("bands", fga-json-strings(head(rows)[2])))), fga-json-ranking(tail(rows)));
  def fga-json-cumulative(rows) = nil?(rows) ? list() : cons(json-node-object(list(fga-js("add_candidate", head(head(rows))), fga-jn("bands_in_vocabulary", head(rows)[1]))), fga-json-cumulative(tail(rows)));
  def fga-tsv(rows) = nil?(rows) ? "" : head(head(rows)) ++ "\t" ++ tb-join(head(rows)[3], identity, " ") ++ "\n" ++ fga-tsv(tail(rows));
  def fga-report(input, state, rows, started) {
   let analyzed = fga-analyzed(rows);
   let ranked = fga-rank(lx-str-uniq(fga-all-missing(analyzed)), analyzed);
   json-emit(json-node-object(list(fga-js("version", "fourth-arm-gap-v1"), fga-js("input", input), fga-js("state", state), fga-jn("observed_unix_ms", now_unix_ms()), fga-jn("elapsed_ms", host_monotonic_ms() - started), fga-js("scope", "historical flatten-survey vocabulary; current band plus declared non-core prelude slice; no band execution or semantic repair claim; parameter names are excluded across that slice"), fga-js("line_basis", "original Form source; in-memory lowered Form for BML"), fga-jn("analyzed", len(analyzed)), fga-jn("unread_or_invalid", len(rows) - len(analyzed)), fga-ja("bands", fga-json-bands(rows)), fga-ja("ranking", fga-json-ranking(ranked)), fga-ja("cumulative", fga-json-cumulative(fga-cumulative(take(40, ranked), analyzed, list()))))));
  }
  def fga-run-at(root, input, output, detail) {
   let started = host_monotonic_ms();
   let survey = read_file(input);
   let flat = read_file(fga-under(root, "form/form-stdlib/form-flatten.fk"));
   let shim = read_file(fga-under(root, "form/form-stdlib/fourth-shim.fk"));
   let vocabulary = nothing?(flat) || nothing?(shim) ? 0 : ((str_len(flat) > 0) && ((str_len(shim) > 0) && (((String) fga-lex(flat)[1] == "") && ((String) fga-lex(shim)[1] == ""))));
   let ready = (!nothing?(survey)) && vocabulary;
   let rows = ready ? fga-survey(root, lx-lines(survey), fga-known(flat, shim), list()) : list();
   let state = nothing?(survey) ? "survey-unavailable" : !ready ? "vocabulary-unavailable" : (Comparable) len(rows) == len(fga-analyzed(rows)) ? "observed-source-slice" : "partial-source-reading";
   let report = fga-report(input, state, rows, started) ++ "\n";
   let tsv = fga-tsv(fga-analyzed(rows));
   let wrote = write_file(output, report);
   let listed = write_file(detail, tsv);
   print("fourth-arm-gap state=" ++ state ++ " analyzed=" ++ int_to_str(len(fga-analyzed(rows))) ++ " unread-or-invalid=" ++ int_to_str(len(rows) - len(fga-analyzed(rows))));
   print(((Comparable) wrote == str_len(report) ? "reading=" : "reading-unwritten target=") ++ output);
   print(((Comparable) listed == str_len(tsv) ? "per-band=" : "per-band-unwritten target=") ++ detail);
   ((Comparable) wrote == str_len(report)) && ((Comparable) listed == str_len(tsv)) ? ((String) state == "observed-source-slice" ? 1 : 0) : -1;
  }
  def fga-run(input) {
   let made = fs_mkdir(HearthDir());
   fga-run-at(".", nothing?(input) || ((String) input == "") ? hearth-fourth-survey-input() : input, hearth-fourth-gap-report(), hearth-fourth-gap-detail());
  }
 }
 0;
}
