// Current source vocabulary for the historical flatten-survey lane.
// This reads and lowers source; it does not execute surveyed bands.
import gate/lens-text.bml;
import form-stdlib/native-op-manifest.fk;
import form-stdlib/json.fk;
import form-stdlib/hearth.bml;
import form-stdlib/form-ontology-bp.fk;
import form-stdlib/line-grammar.fk;
import form-stdlib/bmf-core.fk;
import form-stdlib/bmf-grammar.fk;
import form-stdlib/bml.fk;
import form-stdlib/bml-source.fk;
import form-stdlib/source-compiler.fk;
import form-stdlib/grammars/form-bml.fk;
import form-stdlib/grammars/form-lift.fk;
import form-stdlib/form-bml-lower.fk;
import form-stdlib/source-compiler-text-lens.fk;
section [form.bml] {
 class FourthArmGapAnalysis {
  // token = [kind, text, source line]; kinds: symbol, open, close, string.
  def fga-token(kind, text, line) = [kind, text, line];
  def fga-is(token, kind, text) = (((Comparable) token[0] == kind) && ((String) token[1] == text));
  def fga-end(s, i) = if (i >= len(s)) then i else if (lx-ws-at?(s, i) || lx-int-in?([40, 41, 34, 59], lx-byte(s, i))) then i else fga-end(s, (i + 1));
  def fga-quote(s, i) = if (i >= len(s)) then -1 else if ((Comparable) lx-byte(s, i) == 92) then fga-quote(s, (i + 2)) else if ((Comparable) lx-byte(s, i) == 34) then i else fga-quote(s, (i + 1));
  def fga-newlines(s, a, b) = if (a >= b) then 0 else ((if ((Comparable) lx-byte(s, a) == 10) then 1 else 0) + fga-newlines(s, (a + 1), b));
  def fga-lex(s) = fga-lex-at(s, 0, 1, 0, []);
  def fga-lex-at(s, i, line, depth, tokens) {
   if (i >= len(s)) then [reverse(tokens), if ((Comparable) depth == 0) then "" else "unclosed-list"]
   else if ((Comparable) lx-byte(s, i) == 59) then fga-comment(s, i, line, depth, tokens)
   else if lx-ws-at?(s, i) then fga-lex-at(s, (i + 1), (line + (if ((Comparable) lx-byte(s, i) == 10) then 1 else 0)), depth, tokens)
   else if ((Comparable) lx-byte(s, i) == 40) then fga-lex-at(s, (i + 1), line, (depth + 1), cons(fga-token(1, "(", line), tokens))
   else if ((Comparable) lx-byte(s, i) == 41) then if (depth <= 0) then [reverse(tokens), "unexpected-close"] else fga-lex-at(s, (i + 1), line, (depth - 1), cons(fga-token(2, ")", line), tokens))
   else if ((Comparable) lx-byte(s, i) == 34) then fga-string(s, i, line, depth, tokens, fga-quote(s, (i + 1)))
   else fga-symbol(s, i, line, depth, tokens, fga-end(s, i));
  }
  def fga-comment(s, i, line, depth, tokens) {
   let end = str_find(s, "\n", i);
   fga-lex-at(s, if (end < 0) then len(s) else end, line, depth, tokens);
  }
  def fga-string(s, i, line, depth, tokens, end) = if (end < 0) then [reverse(tokens), "unclosed-string"] else fga-lex-at(s, (end + 1), (line + fga-newlines(s, i, end)), depth, cons(fga-token(3, substring(s, (i + 1), end), line), tokens));
  def fga-symbol(s, i, line, depth, tokens, end) = fga-lex-at(s, end, line, depth, cons(fga-token(0, substring(s, i, end), line), tokens));
  def fga-values(tokens) = if nil?(tokens) then [] else cons(tokens[0][1], fga-values(tokens[1:]));
  def fga-words(s) = fga-values(fga-lex(s)[0]);
  def fga-heads(tokens) = if (len(tokens) < 2) then [] else if (fga-is(tokens[0], 1, "(") && ((Comparable) tokens[1][0] == 0)) then cons(tokens[1], fga-heads(tokens[1:])) else fga-heads(tokens[1:]);
  def fga-params(tokens) = if nil?(tokens) then [] else if ((Comparable) tokens[0][0] == 2) then [] else if ((Comparable) tokens[0][0] == 0) then cons(tokens[0][1], fga-params(tokens[1:])) else [];
  def fga-defs(tokens) = if (len(tokens) < 3) then [] else if (fga-is(tokens[0], 1, "(") && fga-is(tokens[1], 0, "defn")) then cons(tokens[2][1], fga-defs(tokens[1:])) else fga-defs(tokens[1:]);
  def fga-bindings(tokens) {
   if (len(tokens) < 3) then []
   else if (fga-is(tokens[0], 1, "(") && fga-is(tokens[1], 0, "defn")) then append(fga-params(drop(4, tokens)), fga-bindings(tokens[1:]))
   else if (fga-is(tokens[0], 1, "(") && fga-is(tokens[1], 0, "fn")) then append(fga-params(drop(3, tokens)), fga-bindings(tokens[1:]))
   else fga-bindings(tokens[1:]);
  }
  // Read special cases from the actual flattener dispatch, alongside manifest
  // rows and the shim's definitions. No held copy of the native operator list.
  def fga-specials(tokens) = if (len(tokens) < 4) then [] else if (fga-is(tokens[0], 1, "(") && (fga-is(tokens[1], 0, "str_eq") && (fga-is(tokens[2], 0, "op") && ((Comparable) tokens[3][0] == 3)))) then cons(tokens[3][1], fga-specials(tokens[1:])) else fga-specials(tokens[1:]);
  def fga-row-names(rows) = if nil?(rows) then [] else cons(rows[0][0], fga-row-names(rows[1:]));
  def fga-known(flat, shim) = lx-str-uniq(append(fga-row-names(nom-ops()), append(fga-specials(fga-lex(flat)[0]), append(fga-defs(fga-lex(shim)[0]), ["defn", "let", "fn"]))));
  def fga-missing(tokens, known) = lx-str-sort(lx-str-uniq(lx-str-minus(fga-values(fga-heads(tokens)), append(known, append(fga-defs(tokens), fga-bindings(tokens))))));
  def fga-selected(category) = (fga-suffix(category, "-mismatch") || fga-suffix(category, "-flatten-empty"));
  def fga-suffix(s, suffix) = ((len(s) >= len(suffix)) && ((String) substring(s, (len(s) - len(suffix)), len(s)) == suffix));
  def fga-stem(s) = ((len(s) > 0) && fga-stem-at(s, 0));
  def fga-stem-at(s, i) = if (i >= len(s)) then 1 else if (lx-word-at?(s, i) || ((Comparable) lx-byte(s, i) == 45)) then fga-stem-at(s, (i + 1)) else 0;
  def fga-preludes(lines) = if nil?(lines) then [] else fga-prelude-line(lx-strip(lines[0]), lines[1:]);
  def fga-prelude-line(line, rest) = if lx-at?(line, 0, "; preludes:") then append(fga-words(substring(line, 11, len(line))), fga-preludes(rest)) else if lx-at?(line, 0, "// preludes:") then append(fga-words(substring(line, 12, len(line))), fga-preludes(rest)) else fga-preludes(rest);
  def fga-noncore(paths) = if nil?(paths) then [] else if fga-suffix(paths[0], "core.fk") then fga-noncore(paths[1:]) else cons(paths[0], fga-noncore(paths[1:]));
  def fga-under(root, path) = (root + ("/" + path));
  def fga-source(root, path) {
   let full = fga-under(root, path);
   let source = read_file(full);
   if nothing?(source) then [path, [], "unread"] else fga-lower(path, source);
  }
  def fga-lower(path, source) {
   let bml = (fsc-find-section-open(source, 0) >= 0);
   let lowered = if bml then form-source-compile-text(source, path) else source;
   let lexed = if nothing?(lowered) then [[], "lowering-unavailable"] else fga-lex(lowered);
   [path, lexed[0], if (bml && ((String) lowered == "")) then "lowering-empty" else lexed[1]];
  }
  def fga-sources(root, paths) = if nil?(paths) then [] else cons(fga-source(root, paths[0]), fga-sources(root, paths[1:]));
  def fga-source-tokens(sources) = if nil?(sources) then [] else append(sources[0][1], fga-source-tokens(sources[1:]));
  def fga-unread(sources) = if nil?(sources) then [] else if ((String) sources[0][2] == "") then fga-unread(sources[1:]) else cons([sources[0][0], sources[0][2]], fga-unread(sources[1:]));
  def fga-locations(sources, missing) = if nil?(sources) then [] else append(fga-locations-at(sources[0][0], fga-heads(sources[0][1]), missing), fga-locations(sources[1:], missing));
  def fga-locations-at(path, heads, missing) = if nil?(heads) then [] else if lx-str-in?(missing, heads[0][1]) then cons([path, heads[0][2], heads[0][1]], fga-locations-at(path, heads[1:], missing)) else fga-locations-at(path, heads[1:], missing);
  // band = [stem, category, state, missing names, unread sources, locations].
  def fga-band-result(stem, category, sources, known) {
   let unread = fga-unread(sources);
   let missing = if nil?(unread) then fga-missing(fga-source-tokens(sources), known) else [];
   [stem, category, if nil?(unread) then "analyzed" else "unread", missing, unread, fga-locations(sources, missing)];
  }
  def fga-band(root, stem, category, known) {
   let band = ("form/form-stdlib/tests/" + (stem + "-band.fk"));
   let text = read_file(fga-under(root, band));
   let declared = if nothing?(text) then [] else fga-noncore(fga-preludes(lx-lines(text)));
   let fallback = ("form/form-stdlib/" + (stem + ".fk"));
   let modules = if nil?(declared) then if (file_size(fga-under(root, fallback)) >= 0) then [fallback] else [] else fga-form-paths(declared);
   fga-band-result(stem, category, fga-sources(root, append(modules, [band])), known);
  }
  def fga-form-paths(paths) = if nil?(paths) then [] else cons(if lx-at?(paths[0], 0, "form/") then paths[0] else ("form/" + paths[0]), fga-form-paths(paths[1:]));
  def fga-survey(root, lines, known, seen) = if nil?(lines) then [] else if lx-blank?(lines[0]) then fga-survey(root, lines[1:], known, seen) else fga-survey-row(root, split-on(lines[0], "\t"), lines[1:], known, seen);
  def fga-survey-row(root, row, rest, known, seen) {
   if ((len(row) < 2) || (!fga-stem(row[0]))) then cons([row[0], "", "malformed-survey-row", [], [], []], fga-survey(root, rest, known, seen))
   else if (!fga-selected(row[1])) then fga-survey(root, rest, known, seen)
   else if lx-str-in?(seen, row[0]) then cons([row[0], row[1], "duplicate-survey-row", [], [], []], fga-survey(root, rest, known, seen))
   else cons(fga-band(root, row[0], row[1], known), fga-survey(root, rest, known, cons(row[0], seen)));
  }
  def fga-analyzed(rows) = if nil?(rows) then [] else if ((String) rows[0][2] == "analyzed") then cons(rows[0], fga-analyzed(rows[1:])) else fga-analyzed(rows[1:]);
  def fga-all-missing(rows) = if nil?(rows) then [] else append(rows[0][3], fga-all-missing(rows[1:]));
  def fga-blocked(rows, op) = if nil?(rows) then [] else if lx-str-in?(rows[0][3], op) then cons(rows[0][0], fga-blocked(rows[1:], op)) else fga-blocked(rows[1:], op);
  def fga-ranked-row(op, rows) = [op, len(fga-blocked(rows, op)), fga-blocked(rows, op)];
  def fga-rank-before(a, b) = ((a[1] > b[1]) || (((Comparable) a[1] == b[1]) && lx-str-lt?(a[0], b[0])));
  def fga-insert(row, rows) = if nil?(rows) then [row] else if fga-rank-before(row, rows[0]) then cons(row, rows) else cons(rows[0], fga-insert(row, rows[1:]));
  def fga-rank(ops, bands) = if nil?(ops) then [] else fga-insert(fga-ranked-row(ops[0], bands), fga-rank(ops[1:], bands));
  def fga-covered(rows, taught) = if nil?(rows) then 0 else ((if nil?(lx-str-minus(rows[0][3], taught)) then 1 else 0) + fga-covered(rows[1:], taught));
  def fga-cumulative(ranked, bands, taught) = if nil?(ranked) then [] else cons([ranked[0][0], fga-covered(bands, cons(ranked[0][0], taught))], fga-cumulative(ranked[1:], bands, cons(ranked[0][0], taught)));
  def fga-json-strings(rows) = if nil?(rows) then [] else cons(json-node-string(rows[0]), fga-json-strings(rows[1:]));
  def fga-js(key, value) = json-node-pair(key, json-node-string(value));
  def fga-jn(key, value) = json-node-pair(key, json-node-int(value));
  def fga-ja(key, values) = json-node-pair(key, json-node-array(values));
  def fga-json-unread(rows) = if nil?(rows) then [] else cons(json-node-object([fga-js("path", rows[0][0]), fga-js("reason", rows[0][1])]), fga-json-unread(rows[1:]));
  def fga-json-locations(rows) = if nil?(rows) then [] else cons(json-node-object([fga-js("path", rows[0][0]), fga-jn("line", rows[0][1]), fga-js("op", rows[0][2])]), fga-json-locations(rows[1:]));
  def fga-json-bands(rows) = if nil?(rows) then [] else cons(fga-json-band(rows[0]), fga-json-bands(rows[1:]));
  def fga-json-band(row) = json-node-object([fga-js("band", row[0]), fga-js("category", row[1]), fga-js("state", row[2]), fga-ja("missing_candidates", fga-json-strings(row[3])), fga-ja("unread", fga-json-unread(row[4])), fga-ja("locations", fga-json-locations(row[5]))]);
  def fga-json-ranking(rows) = if nil?(rows) then [] else cons(json-node-object([fga-js("op", rows[0][0]), fga-jn("blocked_bands", rows[0][1]), fga-ja("bands", fga-json-strings(rows[0][2]))]), fga-json-ranking(rows[1:]));
  def fga-json-cumulative(rows) = if nil?(rows) then [] else cons(json-node-object([fga-js("add_candidate", rows[0][0]), fga-jn("bands_in_vocabulary", rows[0][1])]), fga-json-cumulative(rows[1:]));
  def fga-tsv(rows) = if nil?(rows) then "" else (rows[0][0] + ("\t" + (tb-join(rows[0][3], identity, " ") + ("\n" + fga-tsv(rows[1:])))));
  def fga-report(input, state, rows, started) {
   let analyzed = fga-analyzed(rows);
   let ranked = fga-rank(lx-str-uniq(fga-all-missing(analyzed)), analyzed);
   json-emit(json-node-object([fga-js("version", "fourth-arm-gap-v1"), fga-js("input", input), fga-js("state", state), fga-jn("observed_unix_ms", now_unix_ms()), fga-jn("elapsed_ms", (host_monotonic_ms() - started)), fga-js("scope", "historical flatten-survey vocabulary; current band plus declared non-core prelude slice; no band execution or semantic repair claim; parameter names are excluded across that slice"), fga-js("line_basis", "original Form source; in-memory lowered Form for BML"), fga-jn("analyzed", len(analyzed)), fga-jn("unread_or_invalid", (len(rows) - len(analyzed))), fga-ja("bands", fga-json-bands(rows)), fga-ja("ranking", fga-json-ranking(ranked)), fga-ja("cumulative", fga-json-cumulative(fga-cumulative(take(40, ranked), analyzed, [])))]));
  }
  def fga-run-at(root, input, output, detail) {
   let started = host_monotonic_ms();
   let survey = read_file(input);
   let flat = read_file(fga-under(root, "form/form-stdlib/form-flatten.fk"));
   let shim = read_file(fga-under(root, "form/form-stdlib/fourth-shim.fk"));
   let vocabulary = if (nothing?(flat) || nothing?(shim)) then 0 else ((len(flat) > 0) && ((len(shim) > 0) && (((String) fga-lex(flat)[1] == "") && ((String) fga-lex(shim)[1] == ""))));
   let ready = ((!nothing?(survey)) && vocabulary);
   let rows = if ready then fga-survey(root, lx-lines(survey), fga-known(flat, shim), []) else [];
   let state = if nothing?(survey) then "survey-unavailable" else if (!ready) then "vocabulary-unavailable" else if ((Comparable) len(rows) == len(fga-analyzed(rows))) then "observed-source-slice" else "partial-source-reading";
   let report = (fga-report(input, state, rows, started) + "\n");
   let tsv = fga-tsv(fga-analyzed(rows));
   let wrote = write_file(output, report);
   let listed = write_file(detail, tsv);
   print(("fourth-arm-gap state=" + (state + (" analyzed=" + (len(fga-analyzed(rows)).str() + (" unread-or-invalid=" + (len(rows) - len(fga-analyzed(rows))).str()))))));
   print(((String) (if ((Comparable) wrote == len(report)) then "reading=" else "reading-unwritten target=") + output));
   print(((String) (if ((Comparable) listed == len(tsv)) then "per-band=" else "per-band-unwritten target=") + detail));
   if (((Comparable) wrote == len(report)) && ((Comparable) listed == len(tsv))) then if ((String) state == "observed-source-slice") then 1 else 0 else -1;
  }
  def fga-run(input) {
   let made = fs_mkdir(HearthDir());
   fga-run-at(".", if (nothing?(input) || ((String) input == "")) then hearth-fourth-survey-input() else input, hearth-fourth-gap-report(), hearth-fourth-gap-detail());
  }
 }
 0;
}
