// Current source vocabulary for the historical flatten-survey lane.
// This reads and lowers source; it does not execute surveyed bands.
import gate/lens-text.bml;
import form-stdlib/native-op-manifest.fk;
import form-stdlib/json.fk;
import form-stdlib/hearth.bml;
import form-stdlib/form-ontology-bp.fk;
import form-stdlib/line-grammar.fk;
import form-stdlib/bmf-core.fk;
import form-stdlib/bmf-grammar.fk;
import form-stdlib/bml.fk;
import form-stdlib/bml-source.fk;
import form-stdlib/source-compiler.fk;
import form-stdlib/grammars/form-bml.fk;
import form-stdlib/grammars/form-lift.fk;
import form-stdlib/form-bml-lower.fk;
import form-stdlib/source-compiler-text-lens.fk;
section [form.bml] {
 class FourthArmGapAnalysis {
  // token = [kind, text, source line]; kinds: symbol, open, close, string.
  def fga-token(kind, text, line) = [kind, text, line];
  def fga-is(token, kind, text) = ((Comparable) token[0] == kind) && ((String) token[1] == text);
  def fga-end(s, i) = i >= len(s) ? i : lx-ws-at?(s, i) || lx-int-in?([40, 41, 34, 59], lx-byte(s, i)) ? i : fga-end(s, i + 1);
  def fga-quote(s, i) = i >= len(s) ? -1 : (Comparable) lx-byte(s, i) == 92 ? fga-quote(s, i + 2) : (Comparable) lx-byte(s, i) == 34 ? i : fga-quote(s, i + 1);
  def fga-newlines(s, a, b) = a >= b ? 0 : (((Comparable) lx-byte(s, a) == 10 ? 1 : 0) + fga-newlines(s, a + 1, b));
  def fga-lex(s) = fga-lex-at(s, 0, 1, 0, []);
  def fga-lex-at(s, i, line, depth, tokens) {
   i >= len(s) ? [reverse(tokens), (Comparable) depth == 0 ? "" : "unclosed-list"]
   : (Comparable) lx-byte(s, i) == 59 ? fga-comment(s, i, line, depth, tokens)
   : lx-ws-at?(s, i) ? fga-lex-at(s, i + 1, line + ((Comparable) lx-byte(s, i) == 10 ? 1 : 0), depth, tokens)
   : (Comparable) lx-byte(s, i) == 40 ? fga-lex-at(s, i + 1, line, depth + 1, cons(fga-token(1, "(", line), tokens))
   : (Comparable) lx-byte(s, i) == 41 ? (depth <= 0 ? [reverse(tokens), "unexpected-close"] : fga-lex-at(s, i + 1, line, depth - 1, cons(fga-token(2, ")", line), tokens)))
   : (Comparable) lx-byte(s, i) == 34 ? fga-string(s, i, line, depth, tokens, fga-quote(s, i + 1))
   : fga-symbol(s, i, line, depth, tokens, fga-end(s, i));
  }
  def fga-comment(s, i, line, depth, tokens) {
   let end = str_find(s, "\n", i);
   fga-lex-at(s, end < 0 ? len(s) : end, line, depth, tokens);
  }
  def fga-string(s, i, line, depth, tokens, end) = end < 0 ? [reverse(tokens), "unclosed-string"] : fga-lex-at(s, end + 1, line + fga-newlines(s, i, end), depth, cons(fga-token(3, substring(s, i + 1, end), line), tokens));
  def fga-symbol(s, i, line, depth, tokens, end) = fga-lex-at(s, end, line, depth, cons(fga-token(0, substring(s, i, end), line), tokens));
  def fga-values(tokens) = tokens |> map(token => token[1]);
  def fga-words(s) = fga-values(fga-lex(s)[0]);
  def fga-heads(tokens) = len(tokens) < 2 ? [] : fga-is(tokens[0], 1, "(") && ((Comparable) tokens[1][0] == 0) ? cons(tokens[1], fga-heads(tokens[1:])) : fga-heads(tokens[1:]);
  def fga-params(tokens) = nil?(tokens) ? [] : (Comparable) tokens[0][0] == 2 ? [] : (Comparable) tokens[0][0] == 0 ? cons(tokens[0][1], fga-params(tokens[1:])) : [];
  def fga-defs(tokens) = len(tokens) < 3 ? [] : fga-is(tokens[0], 1, "(") && fga-is(tokens[1], 0, "defn") ? cons(tokens[2][1], fga-defs(tokens[1:])) : fga-defs(tokens[1:]);
  def fga-bindings(tokens) {
   len(tokens) < 3 ? []
   : fga-is(tokens[0], 1, "(") && fga-is(tokens[1], 0, "defn") ? append(fga-params(drop(4, tokens)), fga-bindings(tokens[1:]))
   : fga-is(tokens[0], 1, "(") && fga-is(tokens[1], 0, "fn") ? append(fga-params(drop(3, tokens)), fga-bindings(tokens[1:]))
   : fga-bindings(tokens[1:]);
  }
  // Read special cases from the actual flattener dispatch, alongside manifest
  // rows and the shim's definitions. No held copy of the native operator list.
  def fga-specials(tokens) = len(tokens) < 4 ? [] : fga-is(tokens[0], 1, "(") && (fga-is(tokens[1], 0, "str_eq") && (fga-is(tokens[2], 0, "op") && ((Comparable) tokens[3][0] == 3))) ? cons(tokens[3][1], fga-specials(tokens[1:])) : fga-specials(tokens[1:]);
  def fga-row-names(rows) = rows |> map(row => row[0]);
  def fga-known(flat, shim) = lx-str-uniq(append(fga-row-names(nom-ops()), append(fga-specials(fga-lex(flat)[0]), append(fga-defs(fga-lex(shim)[0]), ["defn", "let", "fn"]))));
  def fga-missing(tokens, known) = lx-str-sort(lx-str-uniq(lx-str-minus(fga-values(fga-heads(tokens)), append(known, append(fga-defs(tokens), fga-bindings(tokens))))));
  def fga-selected(category) = fga-suffix(category, "-mismatch") || fga-suffix(category, "-flatten-empty");
  def fga-suffix(s, suffix) = (len(s) >= len(suffix)) && ((String) substring(s, len(s) - len(suffix), len(s)) == suffix);
  def fga-stem(s) = (len(s) > 0) && fga-stem-at(s, 0);
  def fga-stem-at(s, i) = i >= len(s) ? 1 : lx-word-at?(s, i) || ((Comparable) lx-byte(s, i) == 45) ? fga-stem-at(s, i + 1) : 0;
  def fga-preludes(lines) = nil?(lines) ? [] : fga-prelude-line(lx-strip(lines[0]), lines[1:]);
  def fga-prelude-line(line, rest) = lx-at?(line, 0, "; preludes:") ? append(fga-words(substring(line, 11, len(line))), fga-preludes(rest)) : lx-at?(line, 0, "// preludes:") ? append(fga-words(substring(line, 12, len(line))), fga-preludes(rest)) : fga-preludes(rest);
  def fga-noncore(paths) = nil?(paths) ? [] : fga-suffix(paths[0], "core.fk") ? fga-noncore(paths[1:]) : cons(paths[0], fga-noncore(paths[1:]));
  def fga-under(root, path) = root + ("/" + path);
  def fga-source(root, path) {
   let full = fga-under(root, path);
   let source = read_file(full);
   nothing?(source) ? [path, [], "unread"] : fga-lower(path, source);
  }
  def fga-lower(path, source) {
   let bml = fsc-find-section-open(source, 0) >= 0;
   let lowered = bml ? form-source-compile-text(source, path) : source;
   let lexed = nothing?(lowered) ? [[], "lowering-unavailable"] : fga-lex(lowered);
   [path, lexed[0], bml && ((String) lowered == "") ? "lowering-empty" : lexed[1]];
  }
  def fga-sources(root, paths) = paths |> map(path => fga-source(root, path));
  def fga-source-tokens(sources) = nil?(sources) ? [] : append(sources[0][1], fga-source-tokens(sources[1:]));
  def fga-unread(sources) = nil?(sources) ? [] : (String) sources[0][2] == "" ? fga-unread(sources[1:]) : cons([sources[0][0], sources[0][2]], fga-unread(sources[1:]));
  def fga-locations(sources, missing) = nil?(sources) ? [] : append(fga-locations-at(sources[0][0], fga-heads(sources[0][1]), missing), fga-locations(sources[1:], missing));
  def fga-locations-at(path, heads, missing) = nil?(heads) ? [] : lx-str-in?(missing, heads[0][1]) ? cons([path, heads[0][2], heads[0][1]], fga-locations-at(path, heads[1:], missing)) : fga-locations-at(path, heads[1:], missing);
  // band = [stem, category, state, missing names, unread sources, locations].
  def fga-band-result(stem, category, sources, known) {
   let unread = fga-unread(sources);
   let missing = nil?(unread) ? fga-missing(fga-source-tokens(sources), known) : [];
   [stem, category, nil?(unread) ? "analyzed" : "unread", missing, unread, fga-locations(sources, missing)];
  }
  def fga-band(root, stem, category, known) {
   let band = "form/form-stdlib/tests/" + (stem + "-band.fk");
   let text = read_file(fga-under(root, band));
   let declared = nothing?(text) ? [] : fga-noncore(fga-preludes(lx-lines(text)));
   let fallback = "form/form-stdlib/" + (stem + ".fk");
   let modules = nil?(declared) ? (file_size(fga-under(root, fallback)) >= 0 ? [fallback] : []) : fga-form-paths(declared);
   fga-band-result(stem, category, fga-sources(root, append(modules, [band])), known);
  }
  def fga-form-paths(paths) = paths |> map(path => lx-at?(path, 0, "form/") ? path : ("form/" + path));
  def fga-survey(root, lines, known, seen) = nil?(lines) ? [] : lx-blank?(lines[0]) ? fga-survey(root, lines[1:], known, seen) : fga-survey-row(root, split-on(lines[0], "\t"), lines[1:], known, seen);
  def fga-survey-row(root, row, rest, known, seen) {
   (len(row) < 2) || (!fga-stem(row[0])) ? cons([row[0], "", "malformed-survey-row", [], [], []], fga-survey(root, rest, known, seen))
   : !fga-selected(row[1]) ? fga-survey(root, rest, known, seen)
   : lx-str-in?(seen, row[0]) ? cons([row[0], row[1], "duplicate-survey-row", [], [], []], fga-survey(root, rest, known, seen))
   : cons(fga-band(root, row[0], row[1], known), fga-survey(root, rest, known, cons(row[0], seen)));
  }
  def fga-analyzed(rows) = nil?(rows) ? [] : (String) rows[0][2] == "analyzed" ? cons(rows[0], fga-analyzed(rows[1:])) : fga-analyzed(rows[1:]);
  def fga-all-missing(rows) = nil?(rows) ? [] : append(rows[0][3], fga-all-missing(rows[1:]));
  def fga-blocked(rows, op) = nil?(rows) ? [] : lx-str-in?(rows[0][3], op) ? cons(rows[0][0], fga-blocked(rows[1:], op)) : fga-blocked(rows[1:], op);
  def fga-ranked-row(op, rows) = [op, len(fga-blocked(rows, op)), fga-blocked(rows, op)];
  def fga-rank-before(a, b) = (a[1] > b[1]) || (((Comparable) a[1] == b[1]) && lx-str-lt?(a[0], b[0]));
  def fga-insert(row, rows) = nil?(rows) ? [row] : fga-rank-before(row, rows[0]) ? cons(row, rows) : cons(rows[0], fga-insert(row, rows[1:]));
  def fga-rank(ops, bands) = nil?(ops) ? [] : fga-insert(fga-ranked-row(ops[0], bands), fga-rank(ops[1:], bands));
  def fga-covered(rows, taught) = nil?(rows) ? 0 : ((nil?(lx-str-minus(rows[0][3], taught)) ? 1 : 0) + fga-covered(rows[1:], taught));
  def fga-cumulative(ranked, bands, taught) = nil?(ranked) ? [] : cons([ranked[0][0], fga-covered(bands, cons(ranked[0][0], taught))], fga-cumulative(ranked[1:], bands, cons(ranked[0][0], taught)));
  def fga-json-strings(rows) = rows |> map(json-node-string);
  def fga-js(key, value) = json-node-pair(key, json-node-string(value));
  def fga-jn(key, value) = json-node-pair(key, json-node-int(value));
  def fga-ja(key, values) = json-node-pair(key, json-node-array(values));
  def fga-json-unread(rows) = rows |> map(row => json-node-object([fga-js("path", row[0]), fga-js("reason", row[1])]));
  def fga-json-locations(rows) = rows |> map(row => json-node-object([fga-js("path", row[0]), fga-jn("line", row[1]), fga-js("op", row[2])]));
  def fga-json-bands(rows) = rows |> map(fga-json-band);
  def fga-json-band(row) = json-node-object([fga-js("band", row[0]), fga-js("category", row[1]), fga-js("state", row[2]), fga-ja("missing_candidates", fga-json-strings(row[3])), fga-ja("unread", fga-json-unread(row[4])), fga-ja("locations", fga-json-locations(row[5]))]);
  def fga-json-ranking(rows) = rows |> map(row => json-node-object([fga-js("op", row[0]), fga-jn("blocked_bands", row[1]), fga-ja("bands", fga-json-strings(row[2]))]));
  def fga-json-cumulative(rows) = rows |> map(row => json-node-object([fga-js("add_candidate", row[0]), fga-jn("bands_in_vocabulary", row[1])]));
  def fga-tsv(rows) = nil?(rows) ? "" : (rows[0][0] + ("\t" + (tb-join(rows[0][3], identity, " ") + ("\n" + fga-tsv(rows[1:])))));
  def fga-report(input, state, rows, started) {
   let analyzed = fga-analyzed(rows);
   let ranked = fga-rank(lx-str-uniq(fga-all-missing(analyzed)), analyzed);
   json-emit(json-node-object([fga-js("version", "fourth-arm-gap-v1"), fga-js("input", input), fga-js("state", state), fga-jn("observed_unix_ms", now_unix_ms()), fga-jn("elapsed_ms", host_monotonic_ms() - started), fga-js("scope", "historical flatten-survey vocabulary; current band plus declared non-core prelude slice; no band execution or semantic repair claim; parameter names are excluded across that slice"), fga-js("line_basis", "original Form source; in-memory lowered Form for BML"), fga-jn("analyzed", len(analyzed)), fga-jn("unread_or_invalid", len(rows) - len(analyzed)), fga-ja("bands", fga-json-bands(rows)), fga-ja("ranking", fga-json-ranking(ranked)), fga-ja("cumulative", fga-json-cumulative(fga-cumulative(take(40, ranked), analyzed, [])))]));
  }
  def fga-run-at(root, input, output, detail) {
   let started = host_monotonic_ms();
   let survey = read_file(input);
   let flat = read_file(fga-under(root, "form/form-stdlib/form-flatten.fk"));
   let shim = read_file(fga-under(root, "form/form-stdlib/fourth-shim.fk"));
   let vocabulary = nothing?(flat) || nothing?(shim) ? 0 : ((len(flat) > 0) && ((len(shim) > 0) && (((String) fga-lex(flat)[1] == "") && ((String) fga-lex(shim)[1] == ""))));
   let ready = (!nothing?(survey)) && vocabulary;
   let rows = ready ? fga-survey(root, lx-lines(survey), fga-known(flat, shim), []) : [];
   let state = nothing?(survey) ? "survey-unavailable" : !ready ? "vocabulary-unavailable" : (Comparable) len(rows) == len(fga-analyzed(rows)) ? "observed-source-slice" : "partial-source-reading";
   let report = fga-report(input, state, rows, started) + "\n";
   let tsv = fga-tsv(fga-analyzed(rows));
   let wrote = write_file(output, report);
   let listed = write_file(detail, tsv);
   print("fourth-arm-gap state=" + (state + (" analyzed=" + (len(fga-analyzed(rows)).str() + (" unread-or-invalid=" + (len(rows) - len(fga-analyzed(rows))).str())))));
   print((String) ((Comparable) wrote == len(report) ? "reading=" : "reading-unwritten target=") + output);
   print((String) ((Comparable) listed == len(tsv) ? "per-band=" : "per-band-unwritten target=") + detail);
   ((Comparable) wrote == len(report)) && ((Comparable) listed == len(tsv)) ? ((String) state == "observed-source-slice" ? 1 : 0) : -1;
  }
  def fga-run(input) {
   let made = fs_mkdir(HearthDir());
   fga-run-at(".", nothing?(input) || ((String) input == "") ? hearth-fourth-survey-input() : input, hearth-fourth-gap-report(), hearth-fourth-gap-detail());
  }
 }
 0;
}
