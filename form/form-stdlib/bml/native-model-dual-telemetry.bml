package Form.native.modeltelemetry;

import Form.kernel.*;
import Form.glass.telemetry.*;

interface INativeModelDualTelemetry [public, witness, resident] {
   section [public] {
      const String AccessRule = "publication is not access; semantic read and write epochs come from actual evaluation and survive later publisher heartbeats";
      const String SubstateRule = "expert and KV topology derived from a parent model handle is derived-window, never physical-live";
      const String ProvenanceRule = "callable carrier handles, catalog artifact bytes, mapped bytes, materialized bytes, declared pressure budget, and release observations occupy separate samples";
      const String AllocationRule = "a positive model carrier handle proves a callable context only; it never proves mapped-byte or materialized-page extent";
      const String RuntimeCounterRule = "owner runtime counters are scoped to the publishing fkwu process, carry their read epoch and work-impact purpose, and include the observation's own cost";
      const String NodeIDRule = "telemetry sample identity is stable per owner lifetime; until rows bind real NodeIDs, each snapshot carries model.owner.telemetry-nodeid-mint as the exact missing door";
      const String TombstoneRule = "a clean close atomically replaces the owner publication with released physical tombstones";
      const String OwnerCorrelationRule = "each owner heartbeat binds one publisher to its exact positive pid, Form-entry start epoch, incarnation, monotone publication sequence, and observation epoch";
      const String IdleCadenceRule = "the owner polls one atomic filesystem command ingress every 250 milliseconds but serializes state only at start, explicit status or heartbeat, and before or after real model work; external OS liveness owns idle cadence";
      const String EphemeralStringRule = "until kernel.ephemeral-render-string lands, every owner publication names that exact missing reclamation door and idle cadence performs no serialization";
      const String StateRule = "loaded, prefilled, and active retain independent last-transition epochs; context position, KV bytes, and expert bytes remain separate facts; unavailable byte extents are explicit absent fields";

      Object StateClock( Int loadedEpoch, Int prefilledEpoch, Int activeEpoch ) [abstract];
      Object StateClockActiveAt( Object clock, Int epoch ) [abstract];
      Object Callable( String id, String owner, String lifecycle, Int handle, Int readEpoch, Int writeEpoch ) [abstract];
      Object MissingExtent( String id, String parent, String owner, String kind, String purpose, Int observedEpoch, String door ) [abstract];
      Object OwnerCounter( String id, String kind, String plane, String owner, String lane, String purpose, Int value, Int observedEpoch, String source, Object channels ) [abstract];
      Object OwnerMissing( String id, String kind, String plane, String owner, String lane, String purpose, Int observedEpoch, String door, Object channels ) [abstract];
      Object OwnerNodeIDSeam( String owner, Int observedEpoch ) [abstract];
      Int StatusInt( String status, String key ) [abstract];
      Object MetalCounter( String status, String id, String kind, String lane, String purpose, String key, String source, String owner, Int epoch, Object channels ) [abstract];
      Object WeightCatalog( String id, String parent, Int bytes, Int readEpoch ) [abstract];
      Object DerivedSubstate( String id, String parent, String kind, String purpose, String lifecycle, Int handle, Int readEpoch, Int writeEpoch, Object channels ) [abstract];
      Object TokenPosition( String id, String parent, Int position, String lifecycle, Int handle, Int accessEpoch ) [abstract];
      Object OwnerCorrelation( String publisher, Int pid, Int startedEpoch, String incarnation, Int sequence, Int observedEpoch ) [abstract];
      Object OwnerHeartbeat( Object correlation ) [abstract];
      Object OwnerHeartbeatAt( Object correlation, String heartbeatId ) [abstract];
      Object ModelState( String id, String parent, String state, Int enabled, Int handle, Int observedEpoch ) [abstract];
      Object OwnerModelState( String id, String parent, String owner, String state, Int enabled, Int handle, Int observedEpoch ) [abstract];
      Object Budget( Int bytes ) [abstract];
      Object Released( String id, Int closeResult, Int writeEpoch ) [abstract];
   }
}

class NativeModelDualTelemetry [public, resident, observable, teach] : INativeModelDualTelemetry {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-dual-telemetry.bml";
      Object StateClock( Int loadedEpoch, Int prefilledEpoch, Int activeEpoch ) [abstract] {}
      Object StateClockActiveAt( Object clock, Int epoch ) [abstract] {}
      Object Callable( String id, String owner, String lifecycle, Int handle, Int readEpoch, Int writeEpoch ) [abstract] {}
      Object MissingExtent( String id, String parent, String owner, String kind, String purpose, Int observedEpoch, String door ) [abstract] {}
      Object OwnerCounter( String id, String kind, String plane, String owner, String lane, String purpose, Int value, Int observedEpoch, String source, Object channels ) [abstract] {}
      Object OwnerMissing( String id, String kind, String plane, String owner, String lane, String purpose, Int observedEpoch, String door, Object channels ) [abstract] {}
      Object OwnerNodeIDSeam( String owner, Int observedEpoch ) [abstract] {}
      Int StatusInt( String status, String key ) [abstract] {}
      Object MetalCounter( String status, String id, String kind, String lane, String purpose, String key, String source, String owner, Int epoch, Object channels ) [abstract] {}
      Object WeightCatalog( String id, String parent, Int bytes, Int readEpoch ) [abstract] {}
      Object DerivedSubstate( String id, String parent, String kind, String purpose, String lifecycle, Int handle, Int readEpoch, Int writeEpoch, Object channels ) [abstract] {}
      Object TokenPosition( String id, String parent, Int position, String lifecycle, Int handle, Int accessEpoch ) [abstract] {}
      Object OwnerCorrelation( String publisher, Int pid, Int startedEpoch, String incarnation, Int sequence, Int observedEpoch ) [abstract] {}
      Object OwnerHeartbeat( Object correlation ) [abstract] {}
      Object OwnerHeartbeatAt( Object correlation, String heartbeatId ) [abstract] {}
      Object ModelState( String id, String parent, String state, Int enabled, Int handle, Int observedEpoch ) [abstract] {}
      Object OwnerModelState( String id, String parent, String owner, String state, Int enabled, Int handle, Int observedEpoch ) [abstract] {}
      Object Budget( Int bytes ) [abstract] {}
      Object Released( String id, Int closeResult, Int writeEpoch ) [abstract] {}
   }
}
