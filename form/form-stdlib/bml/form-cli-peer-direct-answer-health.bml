// Completion belongs to the executing answer organ. Text presence and a
// terminal model stop are separate observations; partial words stay available.
// preludes: form-stdlib/form-cli-model-session.fk form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliPeerDirectAnswerHealth {
  def fcpdah-completion(stopped,pending) = if lt(pending,0) then "interrupted" else if stopped then "complete" else "partial";
  def fcpdah-state(session) = if not(fcms-live?(session)) then "interrupted" else fcpdah-completion(fcms-stopped?(session),fcms-pending(session));
  def fcpdah-resource(session) = if str_eq(fcpdah-state(session),"interrupted") then "model-execution" else if ge(fcms-pos(session),fcms-maxpos(session)) then "model-context-capacity" else "generation-capacity";
  def fcpdah-reading(session,tokens) {
   let state = fcpdah-state(session);
   let complete = str_eq(state,"complete");
   let evidence = json-node-object(list(oh-n("generated_tokens",tokens),oh-n("position",fcms-pos(session)),oh-n("max_positions",fcms-maxpos(session)),oh-n("pending",fcms-pending(session)),oh-n("stopped",fcms-stopped?(session))));
   oh-reading("native-direct-answer",int_to_str(host_pid()),"generation-completion",json-node-string("complete"),json-node-string(state),json-node-int(complete),if complete then list() else list(oh-need(fcpdah-resource(session),evidence)),list("request-evidence"),evidence);
  }
  def fcpdah-observe(session,tokens) = oh-voice(fcpdah-reading(session,tokens));
 }
}
