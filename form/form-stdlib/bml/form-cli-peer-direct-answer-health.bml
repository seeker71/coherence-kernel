// Completion belongs to the executing answer organ. Text presence and a
// terminal model stop are separate observations; partial words stay available.
// preludes: form-stdlib/form-cli-model-session.fk form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliPeerDirectAnswerHealth {
  def fcpdah-completion(stopped,pending) = pending < 0 ? "interrupted" : stopped ? "complete" : "partial";
  def fcpdah-state(session) = !fcms-live?(session) ? "interrupted" : fcpdah-completion(fcms-stopped?(session),fcms-pending(session));
  def fcpdah-resource(session) = (String) fcpdah-state(session) == "interrupted" ? "model-execution" : fcms-pos(session) >= fcms-maxpos(session) ? "model-context-capacity" : "generation-capacity";
  def fcpdah-reading(session,tokens) {
   let state = fcpdah-state(session);
   let complete = (String) state == "complete";
   let evidence = json-node-object(list(oh-n("generated_tokens",tokens),oh-n("position",fcms-pos(session)),oh-n("max_positions",fcms-maxpos(session)),oh-n("pending",fcms-pending(session)),oh-n("stopped",fcms-stopped?(session))));
   oh-reading("native-direct-answer",int_to_str(host_pid()),"generation-completion",json-node-string("complete"),json-node-string(state),json-node-int(complete),complete ? list() : list(oh-need(fcpdah-resource(session),evidence)),list("request-evidence"),evidence);
  }
  def fcpdah-observe(session,tokens) = oh-voice(fcpdah-reading(session,tokens));
 }
}
