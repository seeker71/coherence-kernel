//////////////////////////////////////////////////////////////////////
//
// form-cli-lora-cover.bml — high-grammar authority.
//
// Train the overlay on minted samples and measure how coverage
// moves with N. Session 99% is TargetLocalPpm, not a mill claim.
// Remaining remote events are counted. More mill samples of the
// same cartesian do not cover NL-planner remote. fqt-lora? stays 0.
//
// Executable: form-stdlib/form-cli-lora-cover.bml
// Proven by: form-stdlib/tests/form-cli-lora-cover-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.loracover;

import Form.kernel.*;
import Form.cli.flow.*;

interface ILoraCover [public, witness, reusable] {
   section [public] {
      const int TargetMostPpm = 950000;
      const int TargetLocalPpm = 990000;
      const int ThisNative = 414;
      const int ThisLocal = 473;
      const int ThisRemote = 105;
      const int FqtLora = 0;
      const String TrustRule = "measure the curve; do not invent remaining N";

      int Ppm( int nCorrect, int nHeldout ) [abstract];
      int NeedEvents() [abstract];
      int LoraWriterReady() [abstract];
   }
}

template CoverRow<TCount> [public, reusable] {
   section [public] {
      TCount TrainN() [get];
      TCount Correct() [get];
      TCount Heldout() [get];
      TCount Ppm() [get];
   }
}

class FormLoraCover [public, reusable, teach] : ILoraCover {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-lora-cover.bml";

      int Ppm( int nCorrect, int nHeldout ) [abstract] {}
      int NeedEvents() [abstract] {}
      int LoraWriterReady() [abstract] {}
   }
}

class FormLoraCoverSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-lora-cover-self";
      const String Pattern = "sweep-n heldout-ppm remaining-honest fqt-lora-stays-0";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
