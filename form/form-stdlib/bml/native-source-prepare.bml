// Proof-carrier text preparation. The running fkwu owns compiler admission.
// No independent compiler key, historical source cache, or raw BML fallback.
// preludes: form-stdlib/json.fk form-stdlib/source-compiler.fk form-stdlib/source-compiler-text-lens.fk form-stdlib/form-fs.fk gate/lens-text.bml
section [form.bml] {
 class NativeSourcePrepare {
  def nsp-words(s) = nsp-words-at(s, 0, list());
  def nsp-words-at(s, i, words) {
   let start = lx-skip-ws(s, i);
   start >= str_len(s) ? reverse(words) : nsp-word(s, start, nsp-word-end(s, start), words);
  }
  def nsp-word-end(s, i) = i >= str_len(s) ? i : lx-ws-at?(s, i) ? i : nsp-word-end(s, i + 1);
  def nsp-word(s, start, end, words) = nsp-words-at(s, end, cons(substring(s, start, end), words));
  def nsp-resolve(owner, token) = bml-source-resolve(owner, token);
  def nsp-dependencies(owner, tokens) {
   nil?(tokens) ? "" : nsp-dependency(owner, head(tokens), tail(tokens));
  }
  def nsp-dependency(owner, token, rest) {
   let path = nsp-resolve(owner, token);
   let more = nsp-dependencies(owner, rest);
   nothing?(path) || nothing?(more) ? nothing() : nsp-directive(path, more);
  }
  def nsp-directive(path, more) {
   (String) fs-path-extension(path) == ".bml" ?
    (!((Comparable) len(nsp-words(path)) == 1) ? nothing() : ("; pre" ++ "ludes: ") ++ path ++ "\n" ++ more)
   : "import " ++ json-emit(json-node-string(path)) ++ "\n" ++ more;
  }
  def nsp-carried(owner, lines) = nil?(lines) ? "" : nsp-carry-line(owner, lx-strip(head(lines)), tail(lines));
  def nsp-carry-line(owner, line, rest) {
   let isPrelude = lx-at?(line, 0, "// preludes:") || lx-at?(line, 0, "; preludes:");
   let here = isPrelude ? nsp-dependencies(owner, nsp-words(substring(line, lx-at?(line, 0, "//") ? 12 : 11, str_len(line)))) : nsp-import(owner, line);
   let more = nsp-carried(owner, rest);
   nothing?(here) || nothing?(more) ? nothing() : here ++ more;
  }
  def nsp-import(owner, line) {
   let end = (String) substring(line, str_len(line) - 1, str_len(line)) == ";" ? (str_len(line) - 1) : str_len(line);
   !lx-at?(line, 0, "import ") ? "" : nsp-import-path(owner, json-string-value(parse-json("source-import", lx-strip(substring(line, 7, end)))));
  }
  def nsp-import-path(owner, path) = nothing?(path) ? nothing() : nsp-dependency(owner, path, list());
  def nsp-lower(owner, source) {
   let carried = nsp-carried(owner, lx-lines(source));
   let lowered = form-source-compile-text(source, owner);
   nothing?(carried) || (nothing?(lowered) || ((String) lowered == "")) ? nothing() : carried ++ lowered;
  }
  // [selected path, result]. Plain source stays at its own path so relative
  // imports retain their owner. Only BML needs a temporary proof input.
  def nsp-prepare(sourcePath, temporaryPath) {
   let source = read_file(sourcePath);
   nothing?(source) ? list("source-unavailable", 0)
   : fsc-find-section-open(source, 0) < 0 ? list(sourcePath, 1)
   : (String) sourcePath == temporaryPath ? list("temporary-path-is-source", 0)
   : nsp-publish(temporaryPath, nsp-lower(sourcePath, source));
  }
  def nsp-publish(path, lowered) {
   nothing?(lowered) ? list("lowering-unavailable", 0) : nsp-write(path, lowered);
  }
  def nsp-write(path, lowered) {
   let wrote = write_file(path, lowered);
   ((Comparable) wrote == str_len(lowered)) && ((String) read_file(path) == lowered) ? list(path, 1) : list("proof-input-write-failed", 0);
  }
 }
 0;
}
