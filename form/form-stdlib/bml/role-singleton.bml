// role-singleton.bml — one live process of a role, by the process table and nothing else.
//
// Six copies of the glass stack ran at once on 2026-10-08, each started by a launcher that never retired the one before: six machine
// producers asking the host's accelerator for its mean since the previous query (a gauge consumed by the reading: one reader keeps the windows
// whole, six read each other's and the GPU "utilization" flipped between 0 and 100), eighteen frame producers doing the same sensing into the same
// shared-memory frames, 5 GB resident, a process each. A role is a door (the file an fkwu runs); a role has ONE live process. The process table is the
// truth, so there is no lock file to go stale and no heartbeat to miss: a process of the role yields when another live process of the same door
// is its elder (an earlier start, then the lower pid), and the elder never yields to a younger. A younger that is already running finds its
// elder at its next check and ends; one that starts beside a standing elder ends at its first check. Two started in the same millisecond
// both read the table once both have appeared: exactly one is the elder of the other, so exactly one survives.
//
//   rs-door?(row, door)     the row is `./fkwu <path>` with the path ending in the door (exactly two words: a `--check`, an editor or a band that
//                           names the door as an argument is not the role)
//   rs-elders(door)         the pids of the live processes of the door that are my elders (not me, not a younger)
//   rs-yield?(door)         1 when there is any: the caller ends. 0 when I am the role.
//   rs-census(door)         every live process of the door, me included: [pid start] rows, elder first (the "who is the role" question)
// preflight-exec: forbidden
section [form.bml] {
 class RoleSingleton {
  def rs-ends?(path, door) = (Comparable) len(path) >= len(door) && (String) substring(path, len(path) - len(door), len(path)) == door;
  def rs-door?(row, door) = ((String) value_kind(row) == "list") && ((Comparable) len(row[4]) == 2) && rs-ends?(row[4][1], door);
  def rs-elder?(row, me) = (row[5] < me[5]) || ((row[5] == me[5]) && (row[0] < me[0]));
  def rs-live?(row) = (Comparable) host_alive(row[0]) == 1;
  // host_processes answers light rows ([pid ... ppid]); the full row (argv, start) is host_process(pid), as the lease reads it
  def rs-rows(door) = filter(r => rs-door?(r, door) && rs-live?(r), map(l => host_process(l[0]), host_processes("fkwu")));
  def rs-me() = host_process(host_pid());
  // the relation, for any process `me` (a process row) among `rows`: the pids of my elders
  def rs-elders-of(me, rows) = (String) value_kind(me) != "list" ? [] : map(r => r[0], filter(r => (Comparable) r[0] != me[0] && rs-elder?(r, me), rows));
  def rs-elders(door) = rs-elders-of(rs-me(), rs-rows(door));
  def rs-yield?(door) = (Comparable) len(rs-elders(door)) > 0;
  def rs-census(door) = map(r => [r[0], r[5]], rs-sorted(rs-rows(door)));
  def rs-sorted(rows) = (Comparable) len(rows) < 2 ? rows : rs-insert(rows[0], rs-sorted(rows[1:]));
  def rs-insert(r, sorted) = nil?(sorted) ? [r] : (rs-elder?(r, sorted[0]) ? cons(r, sorted) : cons(sorted[0], rs-insert(r, sorted[1:])));
 }
}
