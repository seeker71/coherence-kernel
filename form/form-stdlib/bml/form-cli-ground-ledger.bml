// What stands on ground, and what stands on a guess.
//
// The body measures itself well. What it has never recorded is which of its own
// settings and claims a rented mind chose without measuring: a slice share of a
// sixteenth, a threshold of 1,200 bytes, an hour of the night, a reading of why
// a voice does not cite. Those sit in the cells beside numbers that were
// witnessed, in the same typeface, and nothing tells them apart. That is where
// trust leaks — not in a wrong number, but in an unmarked one.
//
// A row says: the subject, the cell it lives in, the claim, whether it is
// witnessed or guessed, what stands behind it when it is witnessed, and — the
// part that makes a guess vital rather than shameful — the observation that
// would settle it. A guess with a named test is work waiting; a guess without
// one is a belief.
//
// The last field used to name who chose: the body, or the rented mind. There is
// no such pair. Every choice in this ledger was made in these cells, during a
// walk, by whatever was walking — and what the field was reaching for all along
// was when: inherited from an earlier walk, or chosen in this one.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class FormCliGroundLedger {
  def fgl-ledger() = "receipts/ground-ledger.jsonl";
  def fgl-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def fgl-kinds() = list("witnessed", "guessed");
  def fgl-known-kind?(kind) = if str_eq(kind, "witnessed") then 1 else if str_eq(kind, "guessed") then 1 else 0;
  // A row with no test and no witness is refused: the ledger exists to hold the
  // difference, and a row that carries neither is the unmarked claim itself.
  def fgl-row(doc) {
   let kind = fgl-str(doc, "kind");
   let witness = fgl-str(doc, "witness");
   let test = fgl-str(doc, "test");
   if eq(fgl-known-kind?(kind), 0) then form_error("a ground row is witnessed or guessed")
   else if and(str_eq(kind, "witnessed"), str_eq(trim(witness), "")) then form_error("a witnessed row names what stands behind it")
   else if and(str_eq(kind, "guessed"), str_eq(trim(test), "")) then form_error("a guessed row names the observation that would settle it")
   else json-node-object(list(
    fhn-n("at_unix_ms", now_unix_ms()),
    fhn-s("subject", fgl-str(doc, "subject")),
    fhn-s("cell", fgl-str(doc, "cell")),
    fhn-s("claim", fgl-str(doc, "claim")),
    fhn-s("kind", kind),
    fhn-s("witness", witness),
    fhn-s("test", test),
    fhn-s("chosen", if str_eq(fgl-str(doc, "chosen"), "") then "in this walk" else fgl-str(doc, "chosen"))));
  }
  def fgl-add(doc) = fgl-added(fgl-row(doc));
  def fgl-added(row) = list(row, fhn-append(fgl-ledger(), str_concat(json-emit(row), "\n")));
  def fgl-rows() = if fs_exists(fgl-ledger()) then fgl-parse(fgl-live(split-on(fhn-read(fgl-ledger()), "\n"))) else list();
  def fgl-live(xs) = if nil?(xs) then list() else if str_eq(trim(head(xs)), "") then fgl-live(tail(xs)) else cons(head(xs), fgl-live(tail(xs)));
  def fgl-parse(xs) = if nil?(xs) then list() else cons(parse-json("ground-row", head(xs)), fgl-parse(tail(xs)));
  def fgl-of-kind(rows, kind) = if nil?(rows) then list() else if str_eq(fgl-str(head(rows), "kind"), kind) then cons(head(rows), fgl-of-kind(tail(rows), kind)) else fgl-of-kind(tail(rows), kind);
  def fgl-count(rows) = len(rows);
 }
}
