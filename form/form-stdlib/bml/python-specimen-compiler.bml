// Form prepares an independent Python grammar proof for the Rust sibling.
// Parsing, lifting and emission remain the existing Form compiler's meaning.
// This proof lane does not establish direct fkwu compiler execution.
// preludes: form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/bml.fk form-stdlib/bml-source.fk form-stdlib/source-compiler.fk form-stdlib/grammars/form-bml.fk form-stdlib/grammars/form-lift.fk form-stdlib/form-bml-lower.fk form-stdlib/source-compiler-text-lens.fk form-stdlib/bml/form-cli-heal-native-process.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 class PythonSpecimenCompiler {
  def psc-suffix(text, suffix) = and(ge(str_len(text), str_len(suffix)), str_eq(substring(text, sub(str_len(text), str_len(suffix)), str_len(text)), suffix));
  def psc-absolute(root, path) = if eq(str_byte_at(path, 0), 47) then path else fhn-at(root, path);
  def psc-cat(parts) = if nil?(parts) then "" else str_concat(head(parts), psc-cat(tail(parts)));
  def psc-roots() = list("form-stdlib/core.fk", "form-stdlib/json.fk", "form-stdlib/cache.fk", "form-stdlib/form-ontology-loader.fk", "form-stdlib/line-grammar.fk", "form-stdlib/bmf-core.fk", "form-stdlib/bmf-grammar.fk", "form-stdlib/bml.fk", "form-stdlib/engine.fk", "form-stdlib/compiler.fk", "form-stdlib/source-compiler.fk", "form-stdlib/grammars/python-bmf.fk", "form-stdlib/python-bmf-eval.fk", "form-stdlib/python-bmf-lift.fk", "form-stdlib/grammars/python-bmf-compiler.fk");
  def psc-prelude-line(line) = not(nothing?(bml-source-prelude-line(line)));
  def psc-comment(line, quoted) = if and(not(quoted), psc-prelude-line(line)) then "; dependencies prepared by Form" else line;
  def psc-next-quote(line, quoted) = bml-source-quote-state(line, 0, quoted, 1);
  def psc-lines(lines, quoted) = if nil?(lines) then "" else str_concat(psc-comment(head(lines), quoted), str_concat("\n", psc-lines(tail(lines), psc-next-quote(head(lines), quoted))));
  def psc-deps(payloads) = if nil?(payloads) then list() else append(psc-tokens(split-on(trim(head(payloads)), " ")), psc-deps(tail(payloads)));
  def psc-tokens(tokens) = if nil?(tokens) then list() else if str_eq(head(tokens), "") then psc-tokens(tail(tokens)) else if or(psc-suffix(head(tokens), ".fk"), psc-suffix(head(tokens), ".bml")) then cons(head(tokens), psc-tokens(tail(tokens))) else list();
  def psc-resolve(root, owner, name) = if ge(file_size(fhn-at(root, str_concat("form/", name))), 0) then fhn-at(root, str_concat("form/", name)) else if ge(file_size(psc-absolute(root, name)), 0) then psc-absolute(root, name) else fhn-at(fs-path-dirname(owner), name);
  def psc-visit-many(state, owner, paths) = if nil?(paths) then 0 else psc-visit-next(state, owner, head(paths), tail(paths));
  def psc-visit-next(state, owner, name, rest) {
   psc-visit(state, psc-resolve(record_get(state, "root"), owner, name));
   psc-visit-many(state, owner, rest);
  }
  def psc-visit(state, path) = if fhn-member(record_get(state, "seen"), path) then 0 else psc-visit-source(state, path);
  def psc-visit-source(state, path) {
   if lt(file_size(path), 0) then form_error(str_concat("missing Form compiler dependency: ", path)) else 0;
   record_set(state, "seen", cons(path, record_get(state, "seen")));
   let source = read_file(path);
   psc-visit-many(state, path, psc-deps(bml-source-preludes-kind(source, lt(fsc-find-section-open(source, 0), 0))));
   let prepared = psc-lines(split-on(form-source-compile-text(source, path), "\n"), 0);
   record_set(state, "parts", cons(prepared, record_get(state, "parts")));
   0;
  }
  def psc-authority(root) {
   let state = record_new(0, "root", root, "seen", list(), "parts", list());
   psc-visit-many(state, fhn-at(root, "form/source.fk"), psc-roots());
   psc-cat(reverse(record_get(state, "parts")));
  }
  def psc-write(path, bytes) = if and(eq(write_file(path, bytes), str_len(bytes)), str_eq(read_file(path), bytes)) then path else form_error(str_concat("Form proof write refused: ", path));
  def psc-stage(job, stage, cwd, argv) {
   let status = fhn-run-start(job, stage, 120, cwd, "/dev/null", argv);
   let diagnostics = fhn-read(fhn-stage-path(job, stage, ".err"));
   if gt(str_len(diagnostics), 0) then print_str(diagnostics) else 0;
   if str_eq(status, "0") then 1 else form_error(str_concat("Form proof stage refused: ", stage));
  }
  def psc-compile(root, job, source) {
   let out = fhn-at(job, "specimen.fk");
   let driver = psc-cat(list(psc-authority(root), "\n(py-compile-file ", fsc-q(source), " ", fsc-q(out), ")\n"));
   let unit = psc-write(fhn-at(job, "compiler-proof.fk"), driver);
   psc-stage(job, "compile", fhn-at(root, "form"), list(fhn-at(root, "form/form-kernel-rust/target/release/form-kernel-rust"), unit));
   if le(file_size(out), 0) then form_error("Form compiler produced no source") else out;
  }
  def psc-request() {
   let line = read_line();
   if nothing?(line) then form_error("one JSON request is required") else 0;
   if not(jwa-valid(line)) then form_error("request JSON refused") else 0;
   let request = parse-json("specimen-request", line);
   if and(eq(node_type(json-object-get(request, "source")), 2), gt(str_len(fhn-string(request, "source")), 0)) then request else form_error("source must be a nonempty string");
  }
  def psc-home() {
   let request = psc-request();
   let root = fhn-root();
   let source = psc-absolute(root, fhn-string(request, "source"));
   let target = fhn-string(request, "output");
   if or(not(psc-suffix(source, ".py")), or(lt(file_size(source), 0), not(eq(node_type(json-object-get(request, "output")), 2)))) then form_error("source .py and output .fk paths are required") else 0;
   if not(psc-suffix(target, ".fk")) then form_error("output must end in .fk") else 0;
   let job = fhn-unique(host_temp_dir(), "form-python-specimen-", 0);
   if str_eq(job, "") then form_error("cannot retain compiler evidence") else 0;
   print_str(str_concat("process-evidence=", job));
   let result = psc-compile(root, job, source);
   let out = psc-absolute(root, target);
   let staging = str_concat(out, str_concat(".form-", int_to_str(host_pid())));
   psc-write(staging, read_file(result));
   if not(eq(fs_rename(staging, out), 0)) then form_error("compiled source publication refused") else 0;
   print_str(json-emit-precise(json-node-object(list(fhn-s("source", source), fhn-s("output", out), fhn-s("evidence", job), fhn-n("bytes", file_size(out))))));
   1;
  }
 }
 0;
}
