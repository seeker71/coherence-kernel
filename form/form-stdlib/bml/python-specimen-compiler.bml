// The current fkwu process parses, lifts and emits the Python input specimen.
// Compilation publishes a complete native source file after successful emission.
// preludes: form-stdlib/grammars/python-bmf-compiler.fk form-stdlib/bml/form-cli-heal-native-process.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 class PythonSpecimenCompiler {
  def psc-suffix(text, suffix) = ((str_len(text) >= str_len(suffix)) && ((String) substring(text, (str_len(text) - str_len(suffix)), str_len(text)) == suffix));
  def psc-absolute(root, path) = if ((Comparable) str_byte_at(path, 0) == 47) then path else fhn-at(root, path);
  def psc-cat(parts) = if nil?(parts) then "" else str_concat(head(parts), psc-cat(tail(parts)));
  def psc-write(path, bytes) = if (((Comparable) write_file(path, bytes) == str_len(bytes)) && ((String) read_file(path) == bytes)) then path else form_error(str_concat("Form proof write refused: ", path));
  def psc-release-launch(job,stage) {
   let process = parse-json("native-compiler-process",fhn-read(fhn-stage-path(job,stage,".process.json")));
   let settled = (((String) fhn-string(process,"state") == "finished") && ((String) fhn-string(json-object-get(process,"cleanup"),"state") == "released"));
   if (!settled) then form_error("native compiler process remains owned") else if ((Comparable) fs_remove(fhn-stage-path(job,stage,".launch.sh")) != 0) then form_error("native compiler launch release refused") else 1;
  }
  def psc-stage(job, stage, cwd, argv) {
   let status = fhn-run-start(job, stage, 120, cwd, "/dev/null", argv);
   psc-release-launch(job,stage);
   let diagnostics = fhn-read(fhn-stage-path(job, stage, ".err"));
   if (str_len(diagnostics) > 0) then print_str(diagnostics) else 0;
   if ((String) status == "0") then 1 else form_error(str_concat("Form proof stage refused: ", stage));
  }
  def psc-compile(root, job, source) {
   let out = fhn-at(job, "specimen.fk");
   pch-observe("compile","admitted",-1);
   py-compile-file(source,out);
   if (file_size(out) <= 0) then pch-refuse("Form compiler produced no source") else 0;
   psc-write(fhn-at(job,"compilation.json"),json-emit-precise(json-node-object(list(fhn-s("state","ready"),fhn-s("compiler","fkwu-in-process"),fhn-n("pid",host_pid()),fhn-s("source",source),fhn-s("output",out),fhn-n("bytes",file_size(out))))));
   pch-observe("compile","ready",1);
   out;
  }
  def psc-publication-refuse(job,stage,reason) {
   let cleanup = if (file_size(stage) < 0) then "not-created" else if (((Comparable) fs_remove(stage) == 0) && (file_size(stage) < 0)) then "released" else "release-refused";
   psc-write(fhn-at(job,"publication.json"),json-emit-precise(json-node-object(list(fhn-s("state","refused"),fhn-s("reason",reason),fhn-s("owned-stage",stage),fhn-s("cleanup",cleanup)))));
   pch-refuse-release(reason,cleanup);
  }
  def psc-request() {
   let line = read_line();
   if nothing?(line) then pch-refuse("one JSON request is required") else 0;
   if (!jwa-valid(line)) then pch-refuse("request JSON refused") else 0;
   let request = parse-json("specimen-request", line);
   if (((Comparable) node_type(json-object-get(request, "source")) == 2) && (str_len(fhn-string(request, "source")) > 0)) then request else pch-refuse("source must be a nonempty string");
  }
  def psc-home() {
   let request = psc-request();
   let root = fhn-root();
   let source = psc-absolute(root, fhn-string(request, "source"));
   let target = fhn-string(request, "output");
   if ((!psc-suffix(source, ".py")) || ((file_size(source) < 0) || (!((Comparable) node_type(json-object-get(request, "output")) == 2)))) then pch-refuse("source .py and output .fk paths are required") else 0;
   if (!psc-suffix(target, ".fk")) then pch-refuse("output must end in .fk") else 0;
   let job = fhn-unique(host_temp_dir(), "form-python-specimen-", 0);
   if ((String) job == "") then pch-refuse("cannot retain compiler evidence") else 0;
   print_str(str_concat("process-evidence=", job));
   let result = psc-compile(root, job, source);
   let out = psc-absolute(root, target);
   let staging = str_concat(out, str_concat(".form-", int_to_str(host_pid())));
   if (file_size(staging) >= 0) then pch-refuse("publication staging path already exists") else 0;
   let bytes = read_file(result);
   if (!(((Comparable) write_file(staging,bytes) == str_len(bytes)) && ((String) read_file(staging) == bytes))) then psc-publication-refuse(job,staging,"compiled source staging write refused") else 0;
   if (!((Comparable) fs_rename(staging, out) == 0)) then psc-publication-refuse(job,staging,"compiled source publication refused") else 0;
   pch-observe("publication","ready",1);
   print_str(json-emit-precise(json-node-object(list(fhn-s("source", source), fhn-s("output", out), fhn-s("evidence", job), fhn-n("bytes", file_size(out))))));
   1;
  }
 }
 0;
}
