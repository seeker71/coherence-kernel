//////////////////////////////////////////////////////////////////////
// form-glass-observation-v2.bml -- typed truth and provenance spine.
//
// A number is never the authority for how it was obtained.  Truth variant,
// carrier provenance, process lifetime, observation sequence, semantic kind,
// and access subtype travel together.  A missing carrier names its missing
// door; it never publishes a plausible zero.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk

section [form.bml] {
    class FormGlassObservationV2 {
        field TruthTag = "glass-truth-v2";
        field LifetimeTag = "glass-process-lifetime-v2";
        field ProvenanceTag = "glass-provenance-v2";
        field ModelIdentityTag = "glass-model-identity-v2";
        field ObservationTag = "glass-observation-v2";
        field QueueCountersTag = "glass-queue-counters-v2";
        field QueueTransitionTag = "glass-queue-transition-v2";
        field QueueSnapshotTag = "glass-queue-snapshot-v2";

        thought fgov2-law = list("measured-zero-is-a-value", "absence-unavailability-staleness-and-error-are-distinct", "publisher-process-lifetime-and-sequence-travel-together", "model-identity-is-not-a-routing-role", "missing-carrier-names-a-door-never-a-number");

        def fgov2-member?(value, values) = if eq(len(values), 0) then 0 else if str_eq(value, head(values)) then 1 else fgov2-member?(value, tail(values));
        def fgov2-text?(value) = if nothing?(value) then 0 else gt(str_len(value), 0);
        def fgov2-truth-kinds() = list("measured", "absent", "unavailable", "stale", "error");
        def fgov2-evidence-kinds() = list("physical-live", "derived-window", "catalog", "declared");
        def fgov2-subject-kinds() = list("cell", "blueprint", "recipe", "tensor", "memory", "cache", "model", "queue", "jit", "metal", "mlx", "process");
        def fgov2-memory-planes() = list("form", "cpu", "gpu", "metal", "mlx", "unified", "disk", "network", "membrane", "unknown");
        def fgov2-access-vocabulary() = list("none", "read", "write", "read-write", "node-id", "nothing", "choice", "fail", "cut", "undo", "timeout", "eval", "store", "release", "melt", "crystallize", "open", "interface", "protocol", "offer", "ask", "broadcast", "mesh", "satsang");
        def fgov2-queue-states() = list("none", "enqueued", "waiting", "admitted", "running", "completed", "failed", "timedout", "cancelled", "rejected");
        def fgov2-recipe-states() = list("source", "eligible", "compiling", "crystallized", "meltable", "failed");

        // Every truth variant has one stable nine-cell shape:
        // tag, kind, value, reason, missing-door, stage, code, retryable,
        // last-observed-epoch.  Fields outside a variant are `nothing`.
        def fgov2-truth(kind, value, reason, door, stage, code, retryable, lastObservedEpoch) = list(TruthTag(), kind, value, reason, door, stage, code, retryable, lastObservedEpoch);
        def fgov2-measured(value) = if nothing?(value) then fgov2-error("truth", "measured-nothing", 0) else fgov2-truth("measured", value, nothing(), nothing(), nothing(), nothing(), nothing(), nothing());
        def fgov2-absent(reason) = fgov2-truth("absent", nothing(), reason, nothing(), nothing(), nothing(), nothing(), nothing());
        def fgov2-unavailable(reason, missingDoor) = fgov2-truth("unavailable", nothing(), reason, missingDoor, nothing(), nothing(), nothing(), nothing());
        def fgov2-stale(lastValue, lastObservedEpoch, reason) = if nothing?(lastValue) then fgov2-error("truth", "stale-without-value", 0) else fgov2-truth("stale", lastValue, reason, nothing(), nothing(), nothing(), nothing(), lastObservedEpoch);
        def fgov2-error(stage, code, retryable) = fgov2-truth("error", nothing(), nothing(), nothing(), stage, code, retryable, nothing());
        def fgov2-truth-kind(value) = nth(value, 1);
        def fgov2-truth-value(value) = nth(value, 2);
        def fgov2-truth-reason(value) = nth(value, 3);
        def fgov2-truth-door(value) = nth(value, 4);
        def fgov2-truth-stage(value) = nth(value, 5);
        def fgov2-truth-code(value) = nth(value, 6);
        def fgov2-truth-retryable(value) = nth(value, 7);
        def fgov2-truth-last-observed(value) = nth(value, 8);
        def fgov2-measured-shape?(value) = if nothing?(fgov2-truth-value(value)) then 0 else if not(nothing?(fgov2-truth-reason(value))) then 0 else if not(nothing?(fgov2-truth-door(value))) then 0 else if not(nothing?(fgov2-truth-stage(value))) then 0 else if not(nothing?(fgov2-truth-code(value))) then 0 else if not(nothing?(fgov2-truth-retryable(value))) then 0 else nothing?(fgov2-truth-last-observed(value));
        def fgov2-absent-shape?(value) = if not(nothing?(fgov2-truth-value(value))) then 0 else if eq(fgov2-text?(fgov2-truth-reason(value)), 0) then 0 else if not(nothing?(fgov2-truth-door(value))) then 0 else if not(nothing?(fgov2-truth-stage(value))) then 0 else if not(nothing?(fgov2-truth-code(value))) then 0 else if not(nothing?(fgov2-truth-retryable(value))) then 0 else nothing?(fgov2-truth-last-observed(value));
        def fgov2-unavailable-shape?(value) = if not(nothing?(fgov2-truth-value(value))) then 0 else if eq(fgov2-text?(fgov2-truth-reason(value)), 0) then 0 else if eq(fgov2-text?(fgov2-truth-door(value)), 0) then 0 else if not(nothing?(fgov2-truth-stage(value))) then 0 else if not(nothing?(fgov2-truth-code(value))) then 0 else if not(nothing?(fgov2-truth-retryable(value))) then 0 else nothing?(fgov2-truth-last-observed(value));
        def fgov2-stale-shape?(value) = if nothing?(fgov2-truth-value(value)) then 0 else if eq(fgov2-text?(fgov2-truth-reason(value)), 0) then 0 else if not(nothing?(fgov2-truth-door(value))) then 0 else if not(nothing?(fgov2-truth-stage(value))) then 0 else if not(nothing?(fgov2-truth-code(value))) then 0 else if not(nothing?(fgov2-truth-retryable(value))) then 0 else if nothing?(fgov2-truth-last-observed(value)) then 0 else ge(fgov2-truth-last-observed(value), 0);
        def fgov2-error-shape?(value) = if not(nothing?(fgov2-truth-value(value))) then 0 else if not(nothing?(fgov2-truth-reason(value))) then 0 else if not(nothing?(fgov2-truth-door(value))) then 0 else if eq(fgov2-text?(fgov2-truth-stage(value)), 0) then 0 else if nothing?(fgov2-truth-code(value)) then 0 else if not(nothing?(fgov2-truth-last-observed(value))) then 0 else if or(eq(fgov2-truth-retryable(value), 0), eq(fgov2-truth-retryable(value), 1)) then 1 else 0;
        def fgov2-truth?(value) = if nothing?(value) then 0 else if not(eq(len(value), 9)) then 0 else if not(str_eq(nth(value, 0), TruthTag())) then 0 else if eq(fgov2-member?(fgov2-truth-kind(value), fgov2-truth-kinds()), 0) then 0 else if str_eq(fgov2-truth-kind(value), "measured") then fgov2-measured-shape?(value) else if str_eq(fgov2-truth-kind(value), "absent") then fgov2-absent-shape?(value) else if str_eq(fgov2-truth-kind(value), "unavailable") then fgov2-unavailable-shape?(value) else if str_eq(fgov2-truth-kind(value), "stale") then fgov2-stale-shape?(value) else fgov2-error-shape?(value);
        def fgov2-measured?(value) = if eq(fgov2-truth?(value), 0) then 0 else str_eq(fgov2-truth-kind(value), "measured");
        def fgov2-absent?(value) = if eq(fgov2-truth?(value), 0) then 0 else str_eq(fgov2-truth-kind(value), "absent");
        def fgov2-unavailable?(value) = if eq(fgov2-truth?(value), 0) then 0 else str_eq(fgov2-truth-kind(value), "unavailable");
        def fgov2-stale?(value) = if eq(fgov2-truth?(value), 0) then 0 else str_eq(fgov2-truth-kind(value), "stale");
        def fgov2-error?(value) = if eq(fgov2-truth?(value), 0) then 0 else str_eq(fgov2-truth-kind(value), "error");
        def fgov2-numeric-truth?(value) = if eq(fgov2-truth?(value), 0) then 0 else if eq(fgov2-measured?(value), 1) then ge(fgov2-truth-value(value), 0) else if eq(fgov2-stale?(value), 1) then ge(fgov2-truth-value(value), 0) else 1;

        // Process lifetime is not PID alone: a process restart creates a new
        // incarnation even if the operating system later recycles the PID.
        def fgov2-process-lifetime(pid, startedEpoch, incarnation) = list(LifetimeTag(), pid, startedEpoch, incarnation);
        def fgov2-lifetime-pid(value) = nth(value, 1);
        def fgov2-lifetime-started(value) = nth(value, 2);
        def fgov2-lifetime-incarnation(value) = nth(value, 3);
        def fgov2-process-lifetime?(value) = if nothing?(value) then 0 else if not(eq(len(value), 4)) then 0 else if not(str_eq(nth(value, 0), LifetimeTag())) then 0 else if le(fgov2-lifetime-pid(value), 0) then 0 else if lt(fgov2-lifetime-started(value), 0) then 0 else fgov2-text?(fgov2-lifetime-incarnation(value));
        def fgov2-lifetime-truth?(value) = if eq(fgov2-truth?(value), 0) then 0 else if eq(fgov2-measured?(value), 1) then fgov2-process-lifetime?(fgov2-truth-value(value)) else if eq(fgov2-stale?(value), 1) then fgov2-process-lifetime?(fgov2-truth-value(value)) else 1;

        def fgov2-provenance(evidence, publisher, lifetimeTruth, sequenceTruth, observedEpochTruth, sourceDoor) = list(ProvenanceTag(), evidence, publisher, lifetimeTruth, sequenceTruth, observedEpochTruth, sourceDoor);
        def fgov2-provenance-evidence(value) = nth(value, 1);
        def fgov2-provenance-publisher(value) = nth(value, 2);
        def fgov2-provenance-lifetime(value) = nth(value, 3);
        def fgov2-provenance-sequence(value) = nth(value, 4);
        def fgov2-provenance-observed(value) = nth(value, 5);
        def fgov2-provenance-source(value) = nth(value, 6);
        def fgov2-provenance?(value) = if nothing?(value) then 0 else if not(eq(len(value), 7)) then 0 else if not(str_eq(nth(value, 0), ProvenanceTag())) then 0 else if eq(fgov2-member?(fgov2-provenance-evidence(value), fgov2-evidence-kinds()), 0) then 0 else if eq(fgov2-text?(fgov2-provenance-publisher(value)), 0) then 0 else if eq(fgov2-lifetime-truth?(fgov2-provenance-lifetime(value)), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-provenance-sequence(value)), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-provenance-observed(value)), 0) then 0 else fgov2-text?(fgov2-provenance-source(value));

        // Identity comes from model metadata and content lineage.  Runtime
        // roles are carried by the model observation, never substituted for
        // canonical id or display name.
        def fgov2-model-identity(canonicalId, displayName, family, quantization, format, shardDigest, metadataSource, sourceDigest) = list(ModelIdentityTag(), canonicalId, displayName, family, quantization, format, shardDigest, metadataSource, sourceDigest);
        def fgov2-model-canonical(value) = nth(value, 1);
        def fgov2-model-display(value) = nth(value, 2);
        def fgov2-model-family(value) = nth(value, 3);
        def fgov2-model-quantization(value) = nth(value, 4);
        def fgov2-model-format(value) = nth(value, 5);
        def fgov2-model-shard-digest(value) = nth(value, 6);
        def fgov2-model-metadata-source(value) = nth(value, 7);
        def fgov2-model-source-digest(value) = nth(value, 8);
        def fgov2-model-identity?(value) = if nothing?(value) then 0 else if not(eq(len(value), 9)) then 0 else if not(str_eq(nth(value, 0), ModelIdentityTag())) then 0 else if eq(fgov2-text?(fgov2-model-canonical(value)), 0) then 0 else if eq(fgov2-text?(fgov2-model-display(value)), 0) then 0 else if eq(fgov2-text?(fgov2-model-family(value)), 0) then 0 else if eq(fgov2-text?(fgov2-model-quantization(value)), 0) then 0 else if eq(fgov2-text?(fgov2-model-format(value)), 0) then 0 else if eq(fgov2-text?(fgov2-model-shard-digest(value)), 0) then 0 else if eq(fgov2-text?(fgov2-model-metadata-source(value)), 0) then 0 else fgov2-text?(fgov2-model-source-digest(value));
        def fgov2-model-identity-truth?(value) = if eq(fgov2-truth?(value), 0) then 0 else if eq(fgov2-measured?(value), 1) then fgov2-model-identity?(fgov2-truth-value(value)) else if eq(fgov2-stale?(value), 1) then fgov2-model-identity?(fgov2-truth-value(value)) else 1;
        def fgov2-roles?(roles) = if eq(len(roles), 0) then 1 else if eq(fgov2-text?(head(roles)), 0) then 0 else fgov2-roles?(tail(roles));

        // The generic observation is the join point the renderer consumes.
        // State and measurement are separate truths: for example, a model can
        // be measured resident while its allocated bytes remain unavailable.
        def fgov2-observation(id, kind, subtype, stateTruth, measurementTruth, unit, plane, accessSubtype, parentTruth, identityTruth, roles, provenance) = list(ObservationTag(), id, kind, subtype, stateTruth, measurementTruth, unit, plane, accessSubtype, parentTruth, identityTruth, roles, provenance);
        def fgov2-observation-id(value) = nth(value, 1);
        def fgov2-observation-kind(value) = nth(value, 2);
        def fgov2-observation-subtype(value) = nth(value, 3);
        def fgov2-observation-state(value) = nth(value, 4);
        def fgov2-observation-measurement(value) = nth(value, 5);
        def fgov2-observation-unit(value) = nth(value, 6);
        def fgov2-observation-plane(value) = nth(value, 7);
        def fgov2-observation-access(value) = nth(value, 8);
        def fgov2-observation-parent(value) = nth(value, 9);
        def fgov2-observation-identity(value) = nth(value, 10);
        def fgov2-observation-roles(value) = nth(value, 11);
        def fgov2-observation-provenance(value) = nth(value, 12);
        def fgov2-observation?(value) = if nothing?(value) then 0 else if not(eq(len(value), 13)) then 0 else if not(str_eq(nth(value, 0), ObservationTag())) then 0 else if eq(fgov2-text?(fgov2-observation-id(value)), 0) then 0 else if eq(fgov2-member?(fgov2-observation-kind(value), fgov2-subject-kinds()), 0) then 0 else if eq(fgov2-text?(fgov2-observation-subtype(value)), 0) then 0 else if eq(fgov2-truth?(fgov2-observation-state(value)), 0) then 0 else if eq(fgov2-truth?(fgov2-observation-measurement(value)), 0) then 0 else if eq(fgov2-text?(fgov2-observation-unit(value)), 0) then 0 else if eq(fgov2-member?(fgov2-observation-plane(value), fgov2-memory-planes()), 0) then 0 else if eq(fgov2-member?(fgov2-observation-access(value), fgov2-access-vocabulary()), 0) then 0 else if eq(fgov2-truth?(fgov2-observation-parent(value)), 0) then 0 else if eq(fgov2-model-identity-truth?(fgov2-observation-identity(value)), 0) then 0 else if eq(fgov2-roles?(fgov2-observation-roles(value)), 0) then 0 else fgov2-provenance?(fgov2-observation-provenance(value));
        def fgov2-structure-observation(id, kind, subtype, stateTruth, measurementTruth, unit, plane, accessSubtype, parentTruth, provenance) = fgov2-observation(id, kind, subtype, stateTruth, measurementTruth, unit, plane, accessSubtype, parentTruth, fgov2-absent("not-a-model"), list(), provenance);
        def fgov2-model-observation(id, identityTruth, roles, lifecycleTruth, bytesTruth, provenance) = fgov2-observation(id, "model", "resident-model", lifecycleTruth, bytesTruth, "bytes", "unified", "eval", fgov2-absent("root-model"), identityTruth, roles, provenance);
        def fgov2-carrier-seam(id, kind, subtype, unit, plane, accessSubtype, reason, missingDoor, provenance) {
            let unavailable = fgov2-unavailable(reason, missingDoor);
            fgov2-structure-observation(id, kind, subtype, unavailable, unavailable, unit, plane, accessSubtype, fgov2-absent("no-observed-parent"), provenance);
        }

        // What the current kernel can establish is measured; what it cannot
        // establish remains a typed seam.  The seams are part of the result,
        // not comments a renderer must rediscover.
        def fgov2-current-structure-observations(provenance) = list(fgov2-structure-observation("cells.interned.count", "cell", "interned-count", fgov2-measured("resident"), fgov2-measured(kernel_stat(4)), "cells", "form", "node-id", fgov2-absent("aggregate"), provenance), fgov2-carrier-seam("cells.allocation.bytes", "cell", "allocation-bytes", "bytes", "form", "store", "per-cell-allocation-not-exposed", "kernel.cell-byte-ledger", provenance), fgov2-carrier-seam("blueprints.count", "blueprint", "interned-count", "blueprints", "form", "open", "blueprint-count-not-exposed", "kernel.blueprint-count", provenance), fgov2-carrier-seam("blueprints.allocation.bytes", "blueprint", "allocation-bytes", "bytes", "form", "store", "blueprint-allocation-not-exposed", "kernel.blueprint-byte-ledger", provenance), fgov2-carrier-seam("recipes.count", "recipe", "interned-count", "recipes", "form", "eval", "recipe-count-not-exposed", "kernel.recipe-count", provenance), fgov2-carrier-seam("recipes.allocation.bytes", "recipe", "allocation-bytes", "bytes", "form", "store", "recipe-allocation-not-exposed", "kernel.recipe-byte-ledger", provenance), fgov2-carrier-seam("tensors.allocation.bytes", "tensor", "allocation-bytes", "bytes", "unified", "read-write", "tensor-allocation-not-exposed", "tensor.allocation-ledger", provenance), fgov2-structure-observation("memory.arena.cons", "memory", "arena-cons-count", fgov2-measured("resident"), fgov2-measured(kernel_stat(6)), "cons", "form", "store", fgov2-absent("aggregate"), provenance), fgov2-carrier-seam("memory.arena.bytes", "memory", "arena-allocation-bytes", "bytes", "form", "store", "arena-bytes-not-exposed", "kernel.arena-byte-ledger", provenance));

        def fgov2-recipe-observation(id, recipeState, accessSubtype, heatTruth, provenance) = if eq(fgov2-member?(recipeState, fgov2-recipe-states()), 0) then fgov2-structure-observation(id, "recipe", "jit-state", fgov2-error("recipe-state", "unrecognized", 0), heatTruth, "calls", "form", accessSubtype, fgov2-absent("no-observed-parent"), provenance) else fgov2-structure-observation(id, "recipe", "jit-state", fgov2-measured(recipeState), heatTruth, "calls", "form", accessSubtype, fgov2-absent("no-observed-parent"), provenance);
        def fgov2-jit-counter(id, subtype, tag, accessSubtype, provenance) = fgov2-structure-observation(id, "jit", subtype, fgov2-measured("counter"), fgov2-measured(kernel_stat(add(100, tag))), "calls", "form", accessSubtype, fgov2-absent("aggregate"), provenance);
        def fgov2-current-jit-observations(provenance) = list(fgov2-jit-counter("jit.compile.dispatch", "compile-dispatch", 83, "crystallize", provenance), fgov2-jit-counter("jit.leaf.inram", "leaf-inram-dispatch", 146, "eval", provenance), fgov2-jit-counter("jit.arm64.dispatch", "arm64-dispatch", 215, "eval", provenance));

        // Queue history is a transition stream plus monotonic counters.  A
        // measured zero depth is different from an unavailable oldest age.
        def fgov2-queue-counters(depth, inFlight, entered, started, completed, failed, timedOut, cancelled) = list(QueueCountersTag(), depth, inFlight, entered, started, completed, failed, timedOut, cancelled);
        def fgov2-queue-depth(value) = nth(value, 1);
        def fgov2-queue-in-flight(value) = nth(value, 2);
        def fgov2-queue-entered(value) = nth(value, 3);
        def fgov2-queue-started(value) = nth(value, 4);
        def fgov2-queue-completed(value) = nth(value, 5);
        def fgov2-queue-failed(value) = nth(value, 6);
        def fgov2-queue-timed-out(value) = nth(value, 7);
        def fgov2-queue-cancelled(value) = nth(value, 8);
        def fgov2-queue-counters?(value) = if nothing?(value) then 0 else if not(eq(len(value), 9)) then 0 else if not(str_eq(nth(value, 0), QueueCountersTag())) then 0 else if eq(fgov2-numeric-truth?(fgov2-queue-depth(value)), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-queue-in-flight(value)), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-queue-entered(value)), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-queue-started(value)), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-queue-completed(value)), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-queue-failed(value)), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-queue-timed-out(value)), 0) then 0 else fgov2-numeric-truth?(fgov2-queue-cancelled(value));
        def fgov2-queue-transition(queueId, requestId, fromState, toState, eventEpochTruth, sequenceTruth, provenance) = list(QueueTransitionTag(), queueId, requestId, fromState, toState, eventEpochTruth, sequenceTruth, provenance);
        def fgov2-transition-queue(value) = nth(value, 1);
        def fgov2-transition-request(value) = nth(value, 2);
        def fgov2-transition-from(value) = nth(value, 3);
        def fgov2-transition-to(value) = nth(value, 4);
        def fgov2-transition-epoch(value) = nth(value, 5);
        def fgov2-transition-sequence(value) = nth(value, 6);
        def fgov2-transition-provenance(value) = nth(value, 7);
        def fgov2-queue-transition?(value) = if nothing?(value) then 0 else if not(eq(len(value), 8)) then 0 else if not(str_eq(nth(value, 0), QueueTransitionTag())) then 0 else if eq(fgov2-text?(fgov2-transition-queue(value)), 0) then 0 else if eq(fgov2-text?(fgov2-transition-request(value)), 0) then 0 else if eq(fgov2-member?(fgov2-transition-from(value), fgov2-queue-states()), 0) then 0 else if eq(fgov2-member?(fgov2-transition-to(value), fgov2-queue-states()), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-transition-epoch(value)), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-transition-sequence(value)), 0) then 0 else fgov2-provenance?(fgov2-transition-provenance(value));
        def fgov2-transition-truth?(value) = if eq(fgov2-truth?(value), 0) then 0 else if eq(fgov2-measured?(value), 1) then fgov2-queue-transition?(fgov2-truth-value(value)) else if eq(fgov2-stale?(value), 1) then fgov2-queue-transition?(fgov2-truth-value(value)) else 1;
        def fgov2-queue-snapshot(queueId, counters, oldestAgeTruth, latestTransitionTruth, provenance) = list(QueueSnapshotTag(), queueId, counters, oldestAgeTruth, latestTransitionTruth, provenance);
        def fgov2-queue-snapshot-id(value) = nth(value, 1);
        def fgov2-queue-snapshot-counters(value) = nth(value, 2);
        def fgov2-queue-snapshot-oldest(value) = nth(value, 3);
        def fgov2-queue-snapshot-latest(value) = nth(value, 4);
        def fgov2-queue-snapshot-provenance(value) = nth(value, 5);
        def fgov2-queue-snapshot?(value) = if nothing?(value) then 0 else if not(eq(len(value), 6)) then 0 else if not(str_eq(nth(value, 0), QueueSnapshotTag())) then 0 else if eq(fgov2-text?(fgov2-queue-snapshot-id(value)), 0) then 0 else if eq(fgov2-queue-counters?(fgov2-queue-snapshot-counters(value)), 0) then 0 else if eq(fgov2-numeric-truth?(fgov2-queue-snapshot-oldest(value)), 0) then 0 else if eq(fgov2-transition-truth?(fgov2-queue-snapshot-latest(value)), 0) then 0 else fgov2-provenance?(fgov2-queue-snapshot-provenance(value));

        // metal_status is the carrier canary.  Missing keys are unavailable;
        // malformed keys are parse errors; the integer zero is measured.
        def fgov2-status-start-from(status, prefix, from) {
            let at = str_find(status, prefix, from);
            if lt(at, 0) then -1 else if or(eq(at, 0), eq(str_byte_at(status, sub(at, 1)), 10)) then add(at, str_len(prefix)) else fgov2-status-start-from(status, prefix, add(at, 1));
        }
        def fgov2-status-start(status, key) {
            let prefix = str_concat(key, "=");
            fgov2-status-start-from(status, prefix, 0);
        }
        def fgov2-status-text-found(status, start) {
            let stop = str_find(status, "\n", start);
            if lt(stop, 0) then substring(status, start, str_len(status)) else substring(status, start, stop);
        }
        def fgov2-status-text(status, key) {
            let start = fgov2-status-start(status, key);
            if lt(start, 0) then nothing() else fgov2-status-text-found(status, start);
        }
        def fgov2-uint-bytes?(text, index) = if ge(index, str_len(text)) then 1 else if and(ge(str_byte_at(text, index), 48), le(str_byte_at(text, index), 57)) then fgov2-uint-bytes?(text, add(index, 1)) else 0;
        def fgov2-uint-text?(text) = if nothing?(text) then 0 else if eq(str_len(text), 0) then 0 else if eq(fgov2-uint-bytes?(text, 0), 0) then 0 else str_eq(int_to_str(str_to_int(text)), text);
        def fgov2-metal-linked?(status) {
            let linked = fgov2-status-text(status, "metal_linked");
            if nothing?(linked) then 0 else str_eq(linked, "true");
        }
        def fgov2-status-number-truth(status, key) {
            let text = fgov2-status-text(status, key);
            if eq(fgov2-metal-linked?(status), 0) then fgov2-unavailable("metal-carrier-not-linked", "metal_status.metal_linked") else if nothing?(text) then fgov2-unavailable("metal-field-not-exposed", str_concat("metal_status.", key)) else if eq(fgov2-uint-text?(text), 0) then fgov2-error("metal-status-parse", str_concat("noncanonical-uint:", key), 0) else fgov2-measured(str_to_int(text));
        }
        def fgov2-metal-number-observation(status, id, subtype, key, unit, accessSubtype, provenance) = fgov2-structure-observation(id, "metal", subtype, if eq(fgov2-metal-linked?(status), 1) then fgov2-measured("live") else fgov2-unavailable("metal-carrier-not-linked", "metal_status.metal_linked"), fgov2-status-number-truth(status, key), unit, "metal", accessSubtype, fgov2-absent("current-process-carrier"), provenance);
        def fgov2-metal-batch-truth(status) {
            let batch = fgov2-status-text(status, "batch");
            if eq(fgov2-metal-linked?(status), 0) then fgov2-unavailable("metal-carrier-not-linked", "metal_status.metal_linked") else if nothing?(batch) then fgov2-unavailable("metal-field-not-exposed", "metal_status.batch") else if or(str_eq(batch, "none"), or(str_eq(batch, "serial"), str_eq(batch, "concurrent"))) then fgov2-measured(batch) else fgov2-error("metal-status-parse", "batch-enum", 0);
        }
        def fgov2-metal-batch-observation(status, provenance) = fgov2-structure-observation("metal.batch.mode", "metal", "batch-mode", if eq(fgov2-metal-linked?(status), 1) then fgov2-measured("live") else fgov2-unavailable("metal-carrier-not-linked", "metal_status.metal_linked"), fgov2-metal-batch-truth(status), "state", "metal", "eval", fgov2-absent("current-process-carrier"), provenance);
        def fgov2-metal-observations(status, provenance) = list(fgov2-metal-number-observation(status, "metal.pending", "pending-dispatches", "pending", "dispatches", "eval", provenance), fgov2-metal-batch-observation(status, provenance), fgov2-metal-number-observation(status, "metal.in-flight", "submitted-batches", "in_flight", "batches", "eval", provenance), fgov2-metal-number-observation(status, "metal.buffers.active", "active-buffer-handles", "buffers", "handles", "read-write", provenance), fgov2-metal-number-observation(status, "metal.buffer-slots", "buffer-table-slots", "buffer_slots", "slots", "store", provenance), fgov2-metal-number-observation(status, "metal.free-slots", "reusable-buffer-slots", "free_slots", "slots", "release", provenance), fgov2-metal-number-observation(status, "metal.buffers.mapped", "mmap-no-copy-buffers", "mmap_nocopy_buffers", "handles", "open", provenance), fgov2-metal-number-observation(status, "metal.pipelines", "compiled-pipelines", "pipelines", "pipelines", "crystallize", provenance), fgov2-metal-number-observation(status, "metal.dispatch.total", "dispatch-total", "total_dispatch", "dispatches", "eval", provenance), fgov2-metal-number-observation(status, "metal.sync.total", "sync-total", "total_sync", "syncs", "eval", provenance), fgov2-metal-number-observation(status, "metal.cpu-jit.dispatch", "cpu-jit-dispatch-total", "cpu_jit_dispatch", "dispatches", "eval", provenance), fgov2-metal-number-observation(status, "metal.cpu-jit.busy", "cpu-jit-busy-total", "cpu_jit_busy_us_total", "microseconds", "eval", provenance), fgov2-metal-number-observation(status, "metal.gpu.busy", "gpu-device-busy-total", "gpu_busy_us_total", "microseconds", "eval", provenance));
        def fgov2-current-metal-observations(provenance) = fgov2-metal-observations(metal_status(), provenance);
        def fgov2-observations-valid?(values) = if eq(len(values), 0) then 1 else if eq(fgov2-observation?(head(values)), 0) then 0 else fgov2-observations-valid?(tail(values));
    }
    0;
}
