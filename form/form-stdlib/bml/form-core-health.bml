// The core reads advertised organ flows and keeps their native cursors between
// calls. This is observed scope, not a claim that undiscovered organs are well.
// preludes: form-stdlib/bml/form-core-health-values.bml form-stdlib/bml/organ-health-discovery.bml
section [form.bml] {
 class FormCoreHealth {
  def ohc-open() = record_new(0,"streams",list());
  def ohc-live(owner) = if record_get(owner,"closed") then form_error("core health reader is closed") else owner;
  def ohc-close-streams(streams) = if nil?(streams) then 0 else { ohs-close(head(streams)); ohc-close-streams(tail(streams)); };
  def ohc-close(owner) { ohc-close-streams(record_get(owner,"streams")); record_set(owner,"streams",list()); record_set(owner,"closed",1); 1; }
  def ohc-absolute(root,path) = ohd-path(root,path);
  def ohc-source(root,path) = json-node-object(list(oh-s("root",root),oh-s("source",ohc-absolute(root,path)),oh-s("publisher","caller"),oh-s("incarnation","caller-owned-append-only-source"),json-node-pair("capabilities",json-node-array(list()))));
  def ohc-sources(root,paths) = if nil?(paths) then list() else cons(ohc-source(root,head(paths)),ohc-sources(root,tail(paths)));
  def ohc-stream(owner,source) {
   ohc-live(owner);
   let path = oh-str(source,"source");
   let reader = ohc-find-stream(record_get(owner,"streams"),path);
   if nothing?(reader) then ohc-stream-open(owner,path) else reader;
  }
  def ohc-find-stream(streams,path) = if nil?(streams) then nothing() else if str_eq(ohs-path(head(streams)),path) then head(streams) else ohc-find-stream(tail(streams),path);
  def ohc-stream-open(owner,path) {
   ohc-live(owner);
   let reader = ohs-open(path,"append-only-source"); record_set(reader,"publishers",list()); record_set(reader,"seen",0);
   record_set(owner,"streams",cons(reader,record_get(owner,"streams"))); reader;
  }
  def ohc-publisher(rows,name) = if nil?(rows) then nothing() else if str_eq(head(head(rows)),name) then nth(head(rows),1) else ohc-publisher(tail(rows),name);
  def ohc-publishers(rows,name,generation) = if nil?(rows) then list(list(name,generation)) else if str_eq(head(head(rows)),name) then cons(list(name,generation),tail(rows)) else cons(head(rows),ohc-publishers(tail(rows),name,generation));
  def ohc-sync(owner,sources) = if nil?(sources) then 0 else { ohc-sync-source(ohc-stream(owner,head(sources)),head(sources)); ohc-sync(owner,tail(sources)); };
  def ohc-sync-source(stream,source) {
   ohs-live(stream);
   let publishers = record_get(stream,"publishers"); let publisher = oh-str(source,"publisher");
   let generation = if json-object-has?(source,"generation") then oh-str(source,"generation") else "caller-owned-append-only-source";
   let prior = ohc-publisher(publishers,publisher);
   let reset = if not(nothing?(prior)) then not(str_eq(prior,generation)) else and(record_get(stream,"seen"),not(oh-has(oh-values(json-array-elements(oh-get(source,"capabilities"))),ohd-shared-append-capability())));
   if reset then ohs-restart(stream,generation) else 0;
   record_set(stream,"publishers",ohc-publishers(publishers,publisher,generation)); record_set(stream,"seen",1); 0;
  }
  def ohc-source-report(reader,source) = jv-materialize(ohcv-source-report(reader,source));
  def ohc-poll(owner,sources,budget,seen) = ohc-poll-with(owner,sources,budget,seen,ohc-source-report);
  def ohc-poll-with(owner,sources,budget,seen,report) = if nil?(sources) then list() else if oh-has(seen,oh-str(head(sources),"source")) then ohc-poll-with(owner,tail(sources),budget,seen,report) else cons(report(ohs-update(ohc-stream(owner,head(sources)),budget),head(sources)),ohc-poll-with(owner,tail(sources),budget,cons(oh-str(head(sources),"source"),seen),report));
  def ohc-needs(row) = json-array-elements(oh-get(row,"needs"));
  def ohc-attend(row) = oh-unease(row);
  def ohc-row(source,row) = jv-materialize(ohcv-row(jv-node(source),jv-node(row)));
  def ohc-current(source,rows) = jv-materialize-items(ohcv-current(jv-node(source),jv-wrap(rows)));
  def ohc-readings(sources) = jv-materialize-items(ohcv-readings(jv-wrap(sources)));
  def ohc-attention(rows,pain) = jv-materialize-items(ohcv-attention(jv-wrap(rows),pain));
  def ohc-capabilities(rows) = jv-materialize-items(ohcv-capabilities(jv-wrap(rows)));
  def ohc-bytes(sources) = ohcv-bytes(jv-wrap(sources));
  def ohc-source-needs(sources) = jv-materialize-items(ohcv-source-needs(jv-wrap(sources)));
  def ohc-read(owner,root,discovery,budget) = ohc-read-at(owner,root,discovery,budget,host_monotonic_ms());
  def ohc-read-at(owner,root,discovery,budget,started) = jv-materialize(ohc-view-read-at(owner,root,discovery,budget,started));
  def ohc-read-with(owner,root,discovery,budget,started,project) = ohc-read-through(owner,root,discovery,budget,started,ohc-source-report,project);
  def ohc-read-through(owner,root,discovery,budget,started,report,project) {
   ohc-live(owner);
   ohc-sync(owner,json-array-elements(oh-get(discovery,"sources")));
   let sources = ohc-poll-with(owner,json-array-elements(oh-get(discovery,"sources")),budget,list(),report);
   project(root,discovery,sources,started);
  }
  def ohc-view(root,discovery,sources,started) = ohcv-project(root,jv-node(discovery),sources,started);
  def ohc-project(root,discovery,sources,started) = jv-materialize(ohc-view(root,discovery,jv-wrap(sources),started));
  def ohc-view-read-at(owner,root,discovery,budget,started) = ohc-read-through(owner,root,discovery,budget,started,ohcv-source-report,ohc-view);
  def ohc-string-paths(nodes) = if nil?(nodes) then 1 else and(and(eq(node_type(head(nodes)),2),not(nothing?(ohd-path(host_cwd(),json-string-value(head(nodes)))))),ohc-string-paths(tail(nodes)));
  def ohc-request-valid(request) = and(node_eq(node_category(request),JSON-OBJECT()),and(if json-object-has?(request,"sources") then and(oh-array(request,"sources"),ohc-string-paths(json-array-elements(oh-get(request,"sources")))) else 1,if json-object-has?(request,"budget_bytes") then and(eq(node_type(oh-get(request,"budget_bytes")),1),gt(json-int-value(oh-get(request,"budget_bytes")),0)) else 1));
  def ohc-explicit(root,request) {
   let paths = oh-values(json-array-elements(oh-get(request,"sources")));
   let sources = ohc-sources(root,paths);
   json-node-object(list(oh-s("coverage","caller-specified-sources"),json-node-pair("sources",json-node-array(sources)),json-node-pair("diagnostics",json-node-array(list()))));
  }
  def ohc-view-request-at(owner,request) = ohc-request-through(owner,request,ohcv-source-report,ohc-view);
  def ohc-request-at(owner,request) = jv-materialize(ohc-view-request-at(owner,request));
  def ohc-request-with(owner,request,project) = ohc-request-through(owner,request,ohc-source-report,project);
  def ohc-request-through(owner,request,report,project) {
   let started = host_monotonic_ms();
   let root = host_cwd();
   let discovery = if json-object-has?(request,"sources") then ohc-explicit(root,request) else ohd-discover(root);
   ohc-read-through(owner,root,discovery,if json-object-has?(request,"budget_bytes") then json-int-value(oh-get(request,"budget_bytes")) else 65536,started,report,project);
  }
  def ohc-command(arg) { let owner = ohc-open(); let text = ohc-command-at(owner,arg); ohc-close(owner); text; }
  def ohc-command-at(owner,arg) = if or(str_eq(arg,""),str_eq(arg,"status")) then jv-emit(ohc-view-request-at(owner,json-node-object(list()))) else if str_eq(arg,"help") then "health [status|JSON]: live advertised organ observations, offered responses, needed local resources and observation age. JSON may name sources and a positive budget_bytes per source; the resident REPL retains native cursors and consumes only new complete events. No model or remote call. Coverage is explicit; absent evidence is not health." else if not(jwa-valid(arg)) then "health refused: expected status or JSON with sources and budget_bytes" else ohc-command-request(owner,parse-json("core-health-request",arg));
  def ohc-command-request(owner,request) = if not(ohc-request-valid(request)) then "health refused: sources must be valid lexical paths without NUL or parent traversal; budget_bytes must be a positive integer" else jv-emit(ohc-view-request-at(owner,request));
 }
 0;
}
