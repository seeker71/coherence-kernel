// Prepare the retained comparison review through native source reading.
// Keep task text separate from its JSON source document, avoiding nested packets.
// preludes: form-stdlib/bml/form-cli-native-compare.bml form-stdlib/bml/form-cli-response-synthesis.bml
section [form.bml] {
 class FormComparisonReview {
  def fcr-need(ok,why) = if ok then 1 else form_error(why);
  def fcr-original-review() = "receipts/artifacts/2026-09-20-native-review-packet.json";
  def fcr-draft-ground() = "receipts/artifacts/2026-09-20-sectioned-context-packet.json";
  def fcr-packet(path) {
   let text = read_file(path);
   fcr-need(faj-valid(text),"comparison packet is not valid JSON");
   let packet = fcap-string(parse-json(path,text),"packet");
   fcr-need(ge(str_find(packet,"\n\n{",0),0),"comparison packet has no source document boundary");
   packet;
  }
  def fcr-body(packet) = parse-json("comparison-source",substring(packet,add(str_find(packet,"\n\n{",0),2),str_len(packet)));
  def fcr-goal(packet) = str_concat(substring(packet,0,str_find(packet,"\n\n{",0))," The supplied comparison.json contains original_enquiry, evidence and candidate_answer.");
  def fcr-between(text,start,end) {
   let a = str_find(text,start,0); let b = str_find(text,end,0);
   fcr-need(and(ge(a,0),gt(b,a)),"comparison primary-source section unavailable");
   substring(text,a,b);
  }
  def fcr-history-wanted(label) = or(str_eq(label,"walks"),or(str_eq(label,"quality"),or(str_eq(label,"trust"),str_eq(label,"sovereignty"))));
  def fcr-history(rows) = if nil?(rows) then list() else if fcr-history-wanted(fcap-string(head(rows),"label")) then cons(head(rows),fcr-history(tail(rows))) else fcr-history(tail(rows));
  def fcr-grounded(domain) {
   let evidence = json-object-get(domain,"evidence");
   let prior = json-object-get(evidence,"historical_author_observations");
   let original = fnc-guided-text();
   let expanded = fcr-between(original,"## A seam the run opened","## What this points at");
   let excerpt = oh-set(prior,"text",json-node-string(expanded));
   let draftSource = fcr-body(fcr-packet(fcr-draft-ground()));
   let historical = json-node-object(list(nsm-s("path",fcr-draft-ground()),nsm-s("scope","Exact selected sections from the candidate's earlier grounding, supplied to establish what it had seen. They are historical source claims, not fresh measurements or independently verified conclusions. Other sections remain outside this review. Absence from a supplied subset does not establish fabrication."),json-node-pair("source_sections",json-node-array(fcr-history(node_children(json-object-get(draftSource,"source_sections")))))));
   let restored = oh-set(oh-set(evidence,"historical_author_observations",excerpt),"candidate_historical_grounding",historical);
   oh-set(domain,"evidence",restored);
  }
  def fcr-request(domain,goal) {
   let document = json-node-object(list(nsm-s("id","comparison"),nsm-s("path","comparison.json"),nsm-s("text",json-emit(domain))));
   let sourceCheck = json-node-object(list(nsm-s("tool","jq"),json-node-pair("arguments",json-node-array(list(json-node-string("-r"),json-node-string(".original_enquiry"),json-node-string("comparison.json")))),nsm-s("stdout",str_concat(fcap-string(domain,"original_enquiry"),"\n"))));
   let reportChecks = parse-json("shape-checks","[{\"tool\":\"jq\",\"arguments\":[\".answer | type\"],\"stdout\":\"\\\"string\\\"\\n\"},{\"tool\":\"jq\",\"arguments\":[\".findings | type\"],\"stdout\":\"\\\"array\\\"\\n\"}]");
   json-node-object(list(nsm-s("mode","review"),nsm-n("evaluation",1),nsm-s("goal",goal),json-node-pair("documents",json-node-array(list(document))),json-node-pair("writable",json-node-array(list())),json-node-pair("checks",json-node-array(list(sourceCheck))),json-node-pair("report_checks",reportChecks)));
  }
  def fcr-manifest(domain,goal) = json-node-object(list(nsm-s("session","comparison-source-restored-2026-09-20"),json-node-pair("cases",json-node-array(list(json-node-object(list(nsm-s("id","comparison-review"),json-node-pair("request",fcr-request(domain,goal))))))),json-node-pair("provider",parse-json("provider","{\"allowed\":true,\"interface\":\"codex-exec\",\"max_processes\":1,\"seconds\":180}"))));
  // Fresh composition needs the current evidence, not a previous answer to edit.
  // Preserve selected source values exactly; no replacement answer is supplied.
  def fcr-fresh-domain(domain) {
   let e = json-object-get(domain,"evidence");
   json-node-object(list(json-node-pair("original_enquiry",json-object-get(domain,"original_enquiry")),json-node-pair("evidence",json-node-object(list(json-node-pair("route_usage",json-object-get(e,"route_usage")),json-node-pair("output_artifacts",json-object-get(e,"output_artifacts")),json-node-pair("historical_author_observations",json-object-get(e,"historical_author_observations")),json-node-pair("native_concepts",json-object-get(e,"native_concepts")),json-node-pair("coverage",json-object-get(e,"coverage")))))));
  }
  def fcr-fresh-packet(domain) = str_concat("Write a complete, fresh answer to original_enquiry from the supplied evidence. Return JSON with one answer string. Cover the nine requested axes in about 500 words, with a useful practical conclusion. Keep the enquiry's direct and guided routes distinct; other recorded routes provide additional context. Preserve measurement units and coverage, attribute the source author's qualitative observations, and distinguish your inferences from measurements. Cite actual supplied paths beside factual claims. Bring the meanings of the supplied concepts into the comparison. Keep limits local to the claims they affect, and give a clear way forward. No tools or file access are available in this generation.\n\n",json-emit(fcr-fresh-domain(domain)));
 }
}
