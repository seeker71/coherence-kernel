// band-sweep.bml — every Form band answers on fkwu, the one runtime: enumerated, run in this process with a deadline each, judged.
//
// A band runs by its own path through cell_run (docs/in-process-cells.md): one call per workload answers the unit's value, what it
// printed, the diagnostics it voiced and the name of a stop, in this process, with no child to begin and no text to read back. It
// is judged by that record, the first `Verdict n` its head declares and its row in form/band-verdicts.txt. The workloads, in order:
//   form/form-samples/*.fk                      each a self-contained file;
//   form/form-stdlib/tests/*.fk and *-band.bml  core.fk, then the band; a band named after a module (tests/line-grammar.fk
//                                               has form-stdlib/line-grammar.fk) loads that module between them. A -child,
//                                               -fixture or -run file is a door its band spawns or reads: its band carries it
//                                               and it is never swept alone;
//   every tracked or new */tests/*-band.fk and *-band.bml of another home (observe, cognition, control, gate, grammars,
//   learn, model, plugin, form/native/metal), run alone by its own path; a path that starts with `.` is not swept.
// A workload of several files runs through a root: one `; preludes:` line naming them in order, each spelled from the repo
// root, written once under form/form-stdlib/.cache/workloads/ by a name of the text's hash (the text is compared on every
// use, so a collision rewrites the root and never lends another workload's), so the unit's image is reused across runs and
// rebuilt when a closure file moves.
//
// SHARDS, not a pool: the work is a list, and {"shard":i,"of":n} takes the workloads whose enumeration index is i mod n. The body
// begins nothing: an operator, launchd or the OS starts the n sweeps, one per shard, and each reads the same tree. Workloads run one
// after another in this process, the preludes the bands share staying resident between legs.
//
// A leg is cell_run(unit, 0, ceiling_s * 1000, nothing()). A leg that outlives the ceiling (1800 s) comes back stopped "deadline"
// with what it had printed; its band fails naming the band, and the sweep moves on. A passing workload leaves nothing behind; a
// failing one writes what it printed and said under .hearth/ (fk, fk.err, fk.why, fk.deadline) and that path is the evidence it
// prints. What a deadline cannot end: a unit inside a crystallized hot leaf, a blocking host call, fk_die (docs/in-process-cells.md).
//
// The judgment of one band: the deadline, a stop or a compile error (what a spawned run showed as exit 1), a compile or binding
// diagnostic in the record, the head pin, the registered verdict, each in that order, and the first that holds is the reason it
// failed. What a band's head and the manifest say is read in process by observe/band-head.bml. A band whose head says
// `; PROOF LEVEL: FKWU-STAGED` and `; STAGED CARRIER: <path>` runs when that carrier stands, else it is pending, named every
// run and never green. A band with neither pin runs clean or fails; its answer is shown, not judged.
//
// THE SEAL: a verdict belongs to the tree it was read from. The run stamps the tree (HEAD and git's status) when it starts
// and again when it ends, and a stamp that moved voids the reading: it prints `band-sweep: VOID READING` with both stamps and
// ends in an error, neither a pass nor a failure. Its radius, said plainly: a tree that moved and moved back passes unseen.
//
// Output lines, one per workload in enumeration order as soon as the leg ends:
//   `  ✓  <label>  → <answer> (its pin)` | `  ·  <label>  → <answer> (ran clean; no pin to answer)`
//   `  ✗  <label>  fkwu: <why>` then `      evidence=<legs>` | `  ⧗  <label>  staged — carrier absent ...`
// then the summary; the door ends in an error when any workload failed. The door is gate/band-sweep-run.bml.
// A process of the body that dies by a signal (SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT) is no longer silent: the seed writes its fatal-signal
// row to stderr and to .hearth/fatal-signal.jsonl at the moment of death (the cell it was running, the Form frames, the C chain), and the
// next sweep prints those findings before its first leg (bsw-prior-deaths: the last 24 hours, one per signal and innermost frame). A leg that
// stops on its stack (a stack-depth: the walker's wall, the collector's depth law) is a stopped leg named with its frames, not "exit 1".
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/value-operators.bml form-stdlib/bml/order.bml form-stdlib/bml/host-child.bml form-stdlib/bml/fatal-signal.bml form-stdlib/bml/door-options.bml form-stdlib/bml/host-walk-sync.bml observe/band-head.bml
section [form.bml] {
 class BandSweep {
  def bsw-manifest() = "form/band-verdicts.txt";
  def bsw-cache() = "form/form-stdlib/.cache/workloads";
  def bsw-ceiling-s() = 1800;
  def bsw-ends?(s, suffix) = len(s) >= len(suffix) && (String) substring(s, len(s) - len(suffix), len(s)) == suffix;
  def bsw-starts?(s, prefix) = len(s) >= len(prefix) && (String) substring(s, 0, len(prefix)) == prefix;
  def bsw-has?(s, part) = str_find(s, part, 0) >= 0;
  def bsw-join(xs, sep) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ sep ++ bsw-join(xs[1:], sep);
  def bsw-base(path) = nil?(split-on(path, "/")) ? path : split-on(path, "/")[len(split-on(path, "/")) - 1];
  def bsw-stem(path) = bsw-ends?(bsw-base(path), ".fk") ? substring(bsw-base(path), 0, len(bsw-base(path)) - 3) : bsw-ends?(bsw-base(path), ".bml") ? substring(bsw-base(path), 0, len(bsw-base(path)) - 4) : bsw-base(path);
  def bsw-pad(s, w) = len(s) >= w ? s : s ++ bsw-pad-spaces(w - len(s));
  def bsw-pad-spaces(k) = k <= 0 ? "" : " " ++ bsw-pad-spaces(k - 1);
  // ---- the options: stdin is one JSON object, every key optional
  //   {"list":1}  name the workloads, run nothing     {"match":"glass|landing"}  the workloads whose label holds any alternative
  //   {"files":["form-stdlib/core.fk","x.fk"]}  one workload of exactly these files (a path as given, else under form/)
  //   {"ceiling_s":1800} a leg's deadline   {"shard":2,"of":8} every 8th workload, from the third
  //   {"gates":0} the caller has just read the drift gates (the land cadence, a shard after the first): they are not run again here;
  //   a cell's deadline bounds the cells it calls, so a caller that wants the gates here gives its own cell their whole budget
  def bsw-opt-has?(doc, key) = json-object-has?(doc, key);
  def bsw-opt-str(doc, key, fallback) = bsw-opt-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : fallback;
  def bsw-opt-int(doc, key, fallback) = bsw-opt-has?(doc, key) ? (json-int-value(json-object-get(doc, key)) ?? fallback) : fallback;
  def bsw-opt-files(doc) = bsw-opt-has?(doc, "files") ? json-array-elements(json-object-get(doc, "files")) |> map(n => json-string-value(n)) : [];
  def bsw-spec() = [["list", "int"], ["match", "str"], ["files", "strs"], ["ceiling_s", "int"], ["shard", "int"], ["of", "int"], ["gates", "int"]];
  def bsw-doc(text) = dop-doc("band-sweep", text, bsw-spec());
  // the door's input, one line at a time as a cell's stdin arrives (a cell's stdin is a value; read_line draws from it, from fd 0 otherwise)
  def bsw-stdin-lines(acc) {
   let l = read_line();
   nothing?(l) ? reverse(acc) : bsw-stdin-lines(cons(l, acc));
  }
  def bsw-stdin() = bsw-join(bsw-stdin-lines([]), "\n");
  // ---- shards: the workloads whose enumeration index is shard mod of
  def bsw-of(doc) = bsw-opt-int(doc, "of", 1);
  def bsw-shard(doc) = bsw-opt-int(doc, "shard", 0);
  def bsw-shard-why(doc) = bsw-of(doc) < 1 ? "of is the number of shards, 1 or more" : bsw-shard(doc) < 0 || bsw-shard(doc) >= bsw-of(doc) ? "shard is 0 up to (of - 1): this is shard " ++ bsw-shard(doc).str() ++ " of " ++ bsw-of(doc).str() : "";
  def bsw-indexed(ws, i) = nil?(ws) ? [] : cons([i, ws[0]], bsw-indexed(ws[1:], i + 1));
  def bsw-mine(ws, doc) = bsw-indexed(ws, 0) |> filter(p => p[0] % bsw-of(doc) == bsw-shard(doc)) |> map(p => p[1]);
  // ---- enumeration: a workload is [label, files], every file spelled from the repo root
  def bsw-names(dir) = sort-strings(fs_list(dir) ?? []);
  def bsw-samples() = bsw-names("form/form-samples") |> filter(n => bsw-ends?(n, ".fk")) |> map(n => [n, ["form/form-samples/" ++ n]]);
  def bsw-door-stem?(stem) = bsw-ends?(stem, "-child") || bsw-ends?(stem, "-fixture") || bsw-ends?(stem, "-run");
  def bsw-stdlib-band?(n) = bsw-ends?(n, ".fk") || bsw-ends?(n, "-band.bml");
  def bsw-stdlib-names() {
   let names = bsw-names("form/form-stdlib/tests");
   append(filter(n => bsw-ends?(n, ".fk"), names), filter(n => bsw-ends?(n, "-band.bml"), names));
  }
  def bsw-stdlib-one(n) {
   let f = "form/form-stdlib/tests/" ++ n;
   let module = "form/form-stdlib/" ++ bsw-stem(n) ++ ".fk";
   (Comparable) file_size(module) >= 0 && (String) module != f ? ["stdlib/" ++ n, ["form/form-stdlib/core.fk", module, f]] : ["stdlib/" ++ n, ["form/form-stdlib/core.fk", f]];
  }
  def bsw-stdlib() = bsw-stdlib-names() |> filter(n => !bsw-door-stem?(bsw-stem(n))) |> map(n => bsw-stdlib-one(n));
  // a tracked band deleted in the working tree is skipped, never a stop
  def bsw-other?(p) = len(p) > 0 && str_byte_at(p, 0) != 46 && !bsw-starts?(p, "form/form-stdlib/tests/") && (Comparable) file_size(p) >= 0;
  def bsw-others() = sort-strings(split-on(hch-read(["git", "ls-files", "--cached", "--others", "--exclude-standard", "--", "*/tests/*-band.fk", "*/tests/*-band.bml"]), "\n") |> filter(p => bsw-other?(p))) |> map(p => [p, [p]]);
  def bsw-all() = append(bsw-samples(), append(bsw-stdlib(), bsw-others()));
  def bsw-alt-match?(label, alts) = nil?(alts) ? false : (len(alts[0]) > 0 && bsw-has?(label, alts[0])) || bsw-alt-match?(label, alts[1:]);
  def bsw-select(all, match) = len(match) == 0 ? all : filter(w => bsw-alt-match?(w[0], split-on(match, "|")), all);
  // one explicit workload, every file spelled from the repo root: a path under form/ (as the sweep always took them, and as the
  // file doors read a bare name) becomes form/<path>, any other stands as given
  def bsw-root-path(p) = !bsw-starts?(p, "form/") && (Comparable) file_size("form/" ++ p) >= 0 ? "form/" ++ p : p;
  def bsw-explicit(files) = [bsw-join(map(f => bsw-base(f), files), "+"), map(f => bsw-root-path(f), files)];
  def bsw-missing(files) = filter(f => (Comparable) file_size(bsw-root-path(f)) < 0, files);
  def bsw-workloads(doc) {
   let files = bsw-opt-files(doc);
   nil?(files) ? bsw-select(bsw-all(), bsw-opt-str(doc, "match", "")) : [bsw-explicit(files)];
  }
  // ---- what a band's head and the manifest say (read in process)
  def bsw-band-of(w) = w[1][len(w[1]) - 1];
  def bsw-text(path) = read_file(path) ?? "";
  // what must read before any judgment: the registered verdicts and every band file of the workloads. A file that does not read would
  // be judged as one holding no pin ("answered every pin"), so the door refuses by name instead; "" when all read.
  def bsw-unread-why(path) = nothing?(read_file(path)) ? path ++ " does not read" : len(trim(read_file(path) ?? "")) == 0 ? path ++ " is empty" : "";
  def bsw-first-why(whys) = foldl((acc, w) => len(acc) > 0 ? acc : w, "", whys);
  def bsw-preflight-why(manifest, ws) {
   let m = bsw-unread-why(manifest);
   len(m) > 0 ? "the registered verdicts are unreadable, so every pin would be dropped: " ++ m
   : bsw-first-why(map(w => nothing?(read_file(bsw-band-of(w))) ? "the band " ++ bsw-band-of(w) ++ " does not read" : "", ws));
  }
  // a selection that holds no workload is a refusal, never a green sweep of nothing
  def bsw-selection-why(ws, doc) = nil?(ws) ? "the selection holds no workload (" ++ bsw-describe-selection(doc) ++ "); {\"list\":1} names the workloads that exist" : "";
  def bsw-describe-selection(doc) = bsw-opt-has?(doc, "match") ? "match \"" ++ bsw-opt-str(doc, "match", "") ++ "\"" : "no band stands in the tree";
  def bsw-level(w) = bh-level(bsw-text(bsw-band-of(w)));
  def bsw-carrier(w) = bh-carrier(bsw-text(bsw-band-of(w)));
  def bsw-door(w) = bh-door(bsw-text(bsw-band-of(w)));
  def bsw-head-pin(w) = bh-pin(bsw-text(bsw-band-of(w)));
  // a registered verdict applies to a canonical band only: the workload's last file under form-stdlib/tests/
  def bsw-canonical?(w) = bsw-starts?(bsw-band-of(w), "form/form-stdlib/tests/");
  def bsw-stem-of(w) {
   let stem = bsw-stem(bsw-band-of(w));
   let manifest = bsw-text(bsw-manifest());
   !bsw-canonical?(w) || len(manifest) == 0 ? "" : len(bh-row-name(manifest, stem)) > 0 ? stem : (bsw-ends?(stem, "-band") ? (len(bh-row-name(manifest, substring(stem, 0, len(stem) - 5))) > 0 ? substring(stem, 0, len(stem) - 5) : "") : "");
  }
  def bsw-digits?(s) = len(s) > 0 && scan_run(s, 0, 1) == len(s);
  def bsw-reg-pin(w) {
   let stem = bsw-stem-of(w);
   let pin = len(stem) == 0 ? "" : bh-row-pin(bsw-text(bsw-manifest()), stem);
   bsw-digits?(pin) ? pin : "";
  }
  // ---- the list: label, files, staged, pin, row
  def bsw-list-line(w) = w[0] ++ "\t" ++ bsw-join(w[1], " ") ++ "\tstaged=" ++ ((String) bsw-level(w) == "FKWU-STAGED" ? "yes" : "no") ++ "\tpin=" ++ (len(bsw-head-pin(w)) > 0 ? bsw-head-pin(w) : "-") ++ "\trow=" ++ (len(bsw-reg-pin(w)) > 0 ? bsw-reg-pin(w) : "-");
  def bsw-list(ws) = foldl((acc, w) => print_str(bsw-list-line(w)), 0, ws);
  // ---- the unit one workload runs: a single file as itself, several through a content-keyed root
  def bsw-root-text(files) = "; preludes: " ++ bsw-join(files, " ");
  def bsw-hash(text, i, h, m, k) = i >= len(text) ? h : bsw-hash(text, i + 1, (h * k + str_byte_at(text, i) + 1) % m, m, k);
  def bsw-key(text) = bsw-hash(text, 0, 7, 1000000007, 31).str() ++ "-" ++ bsw-hash(text, 0, 11, 998244353, 131).str();
  def bsw-unit(w) {
   let files = w[1];
   let text = bsw-root-text(files);
   let path = bsw-cache() ++ "/" ++ bsw-key(text) ++ "-" ++ bsw-stem(files[len(files) - 1]) ++ ".fk";
   nil?(files[1:]) ? files[0] : bsw-root-held(path, text);
  }
  def bsw-root-held(path, text) {
   let made = hch-mkdirs(bsw-cache());
   let held = (String) (read_file(path) ?? "") == text ++ "\n";
   let wrote = held ? 0 : write_file(path, text ++ "\n");
   path;
  }
  // ---- reading a leg's record: {value, out, diag, stopped, errors, resident, ms, cpu_us}
  def bsw-stopped(r) = record_get(r, "stopped");
  def bsw-over?(r) = !nothing?(bsw-stopped(r)) && (String) record_get(bsw-stopped(r), "kind") == "deadline";
  // what a spawned run showed as exit 1: it stopped, or it compiled with errors
  def bsw-rc(r) = !nothing?(bsw-stopped(r)) || (Comparable) record_get(r, "errors") > 0 ? 1 : 0;
  def bsw-flaw?(g) = (String) record_get(g, "observed") == "compile-error" || (String) record_get(g, "observed") == "binding-missing";
  def bsw-flaws(r) = len(filter(g => bsw-flaw?(g), record_get(r, "diag")));
  def bsw-render(v) = (String) value_kind(v) == "int" ? v.str() : (String) value_kind(v) == "string" ? v : value_str(v);
  def bsw-last-line(out) = hch-tail-line(out);
  // the answer is the value as the program prints its last line; a unit that stopped printed no value, and its answer is the last line it did print
  def bsw-answer(r) = nothing?(bsw-stopped(r)) ? bsw-render(record_get(r, "value")) : bsw-last-line(record_get(r, "out"));
  def bsw-field(g, key) = (String) value_kind(record_get(g, key)) == "string" ? record_get(g, key) : "";
  def bsw-diag-line(g) = "form-organ health " ++ bsw-field(g, "organ") ++ " " ++ bsw-field(g, "aspect") ++ " " ++ bsw-field(g, "observed") ++ ": " ++ bsw-field(g, "detail");
  // a stop reads as its kind and its message; a stack-depth stop carries the frames the walker (or the collector) named, set under it
  def bsw-stop-line(r) = nothing?(bsw-stopped(r)) ? [] : append(["stopped " ++ bsw-field(bsw-stopped(r), "kind") ++ ": " ++ bsw-field(bsw-stopped(r), "message")], fsg-stack-depth?(bsw-stopped(r)) ? map(f => "    frame: " ++ f, take(6, fsg-stopped-frames(bsw-stopped(r)))) : []);
  // a leg that stopped is its stop, never "exit 1": the kind and the message are the reason (a stack-depth's frames are in its evidence)
  def bsw-stop-why(r) = "stopped " ++ bsw-field(bsw-stopped(r), "kind") ++ ": " ++ bsw-first-line(bsw-field(bsw-stopped(r), "message"));
  def bsw-first-line(s) = str_find(s, byte_to_str(10), 0) < 0 ? s : substring(s, 0, str_find(s, byte_to_str(10), 0));
  // the findings of any process of this body that died by a signal in the last 24 hours (the seed's fatal-signal rows: the signal, the cell it was running, its frames)
  def bsw-prior-deaths() = foldl((acc, l) => print_str("  " ++ l), 0, fsg-review-lines(fsg-path(), now_unix_ms()));
  // what the unit said: its diagnostic rows, then how it stopped
  def bsw-diag-text(r) = bsw-join(append(map(g => bsw-diag-line(g), record_get(r, "diag")), bsw-stop-line(r)), "\n");
  // ---- judgment: [kind, text] with kind ok-pinned, ok-unpinned, staged, fail or fail-deadline
  def bsw-why(over, rc, diags, answered, head-pin, reg-pin, deadline) {
   over ? "ended at the deadline: " ++ deadline
   : nothing?(rc) ? "birth refused: no exit arrived"
   : (Comparable) rc != 0 ? "exit " ++ rc.str()
   : diags > 0 ? diags.str() ++ " diagnostic line(s) on stderr"
   : len(head-pin) > 0 && (String) answered != head-pin ? "answered " ++ (len(answered) > 0 ? answered : "<nothing>") ++ ", its head pins " ++ head-pin
   : len(reg-pin) > 0 && (String) answered != reg-pin ? "answered " ++ (len(answered) > 0 ? answered : "<nothing>") ++ ", the manifest registers " ++ reg-pin
   : "";
  }
  def bsw-hearth() = ".hearth";
  def bsw-deadline-text(r, ceiling-s) = "ended after " ++ ((Comparable) record_get(r, "ms") / 1000).str() ++ "s: deadline " ++ ceiling-s.str() ++ "s (the ceiling)";
  def bsw-legs-path(idx) = bsw-hearth() ++ "/band-sweep." ++ host_pid().str() ++ "." ++ idx.str();
  // the evidence of a failing workload: what it printed, what it said, why, and the deadline it met; the path is what is printed
  def bsw-keep(r, idx, why, ceiling-s) {
   let legs = bsw-legs-path(idx);
   let made = hch-mkdirs(legs);
   let a = write_file(legs ++ "/fk", (String) record_get(r, "out") ++ bsw-render(record_get(r, "value")) ++ "\n");
   let b = write_file(legs ++ "/fk.err", bsw-diag-text(r) ++ "\n");
   let c = write_file(legs ++ "/fk.why", why ++ "\n");
   let d = bsw-over?(r) ? write_file(legs ++ "/fk.deadline", bsw-deadline-text(r, ceiling-s) ++ "\n") : 0;
   legs;
  }
  def bsw-failed(w, r, idx, why, ceiling-s) = [bsw-over?(r) ? "fail-deadline" : "fail", "  ✗  " ++ bsw-pad(w[0], 30) ++ "  fkwu: " ++ why ++ "\n      evidence=" ++ bsw-keep(r, idx, why, ceiling-s)];
  def bsw-passed(w, answered, pinned) = pinned ? ["ok-pinned", "  ✓  " ++ bsw-pad(w[0], 30) ++ "  → " ++ answered ++ " (its pin)"]
   : ["ok-unpinned", "  ·  " ++ bsw-pad(w[0], 30) ++ "  → " ++ (len(answered) > 0 ? answered : "<nothing>") ++ " (ran clean; no pin to answer)"];
  def bsw-judge(w, r, idx, ceiling-s) {
   let answered = bsw-answer(r);
   let over = bsw-over?(r);
   let why0 = bsw-why(over, over ? nothing() : bsw-rc(r), bsw-flaws(r), answered, bsw-head-pin(w), bsw-reg-pin(w), over ? bsw-deadline-text(r, ceiling-s) : "");
   let why = bsw-starts?(why0, "exit ") && !nothing?(bsw-stopped(r)) ? bsw-stop-why(r) : why0;
   len(why) > 0 ? bsw-failed(w, r, idx, why, ceiling-s) : bsw-passed(w, answered, len(bsw-head-pin(w)) > 0 || len(bsw-reg-pin(w)) > 0);
  }
  // a staged band whose carrier is absent is pending, never green, and runs no leg
  def bsw-pending?(w) = (String) bsw-level(w) == "FKWU-STAGED" && (len(bsw-carrier(w)) == 0 || (Comparable) file_size(bsw-carrier(w)) < 0);
  def bsw-pending(w) {
   let door = bsw-door(w);
   ["staged", "  ⧗  " ++ bsw-pad(w[0], 30) ++ "  staged — carrier absent in this checkout" ++ (len(door) > 0 ? " (" ++ door ++ " builds it)" : "") ++ "; pending, not witnessed"];
  }
  // one workload: a staged band whose carrier is absent runs nothing; any other is one call
  def bsw-leg(w, idx, ceiling-s) = bsw-pending?(w) ? bsw-pending(w) : bsw-judge(w, cell_run(bsw-unit(w), 0, ceiling-s * 1000, nothing()), idx, ceiling-s);
  // ---- tallies: [pinned, unpinned, staged, failed, the labels that met the deadline, the printed blocks newest first]
  def bsw-tally-zero() = [0, 0, 0, 0, "", []];
  def bsw-tally(t, kind, label, text) = (String) kind == "ok-pinned" ? [t[0] + 1, t[1], t[2], t[3], t[4], cons(text, t[5])]
   : (String) kind == "ok-unpinned" ? [t[0], t[1] + 1, t[2], t[3], t[4], cons(text, t[5])]
   : (String) kind == "staged" ? [t[0], t[1], t[2] + 1, t[3], t[4], cons(text, t[5])]
   : (String) kind == "fail-deadline" ? [t[0], t[1], t[2], t[3] + 1, len(t[4]) > 0 ? t[4] ++ " " ++ label : label, cons(text, t[5])]
   : [t[0], t[1], t[2], t[3] + 1, t[4], cons(text, t[5])];
  // ---- the run: one after another, each result printed as it lands
  def bsw-loop(ws, idx, ceiling-s, tally) {
   nil?(ws) ? tally : bsw-loop-one(ws, idx, ceiling-s, tally, bsw-leg(ws[0], idx, ceiling-s));
  }
  def bsw-loop-one(ws, idx, ceiling-s, tally, r) {
   let said = print_str(r[1]);
   bsw-loop(ws[1:], idx + 1, ceiling-s, bsw-tally(tally, r[0], ws[0][0], r[1]));
  }
  def bsw-run(ws, ceiling-s) = bsw-loop(ws, 0, ceiling-s, bsw-tally-zero());
  // ---- the seal
  def bsw-stamp() = hch-read(["git", "rev-parse", "HEAD"]) ++ ":" ++ hch-read(["git", "status", "--porcelain=v1"]);
  def bsw-void-lines(start, end) = ["band-sweep: VOID READING — the tree moved while this run was in flight.", "              start " ++ start, "              end   " ++ end, "              This run's verdict describes a tree that is no longer here. It is neither a pass nor a failure. Re-run on the settled tree."];
  // ---- the summary
  def bsw-summary(t) {
   let ok = t[0] + t[1];
   let staged = t[2] > 0 ? ["  staged lanes pending: " ++ t[2].str() ++ " band(s) need an absent host carrier — not witnessed"] : [];
   let deadlines = len(t[4]) > 0 ? ["  deadlines met: " ++ t[4] ++ " — each leg named came back stopped at its deadline; its evidence is kept"] : [];
   let last = t[3] == 0 ? ["  " ++ ok.str() ++ " ok, 0 failed — fkwu answered every pin it was asked."] : ["  " ++ ok.str() ++ " ok, " ++ t[3].str() ++ " failed — inspect the stops and retained evidence."];
   append(["", "  fkwu: " ++ t[0].str() ++ " band(s) answered their pins; " ++ t[1].str() ++ " ran clean with no pin to answer"], append(staged, append(deadlines, last)));
  }
  def bsw-print(lines) = foldl((acc, l) => print_str(l), 0, lines);
  // ---- the gates that stand before the first leg: each is a cell and holds when it holds and answers 1; its words are printed
  def bsw-gate-text(r) = (String) record_get(r, "out") ++ (nothing?(bsw-stopped(r)) ? bsw-render(record_get(r, "value")) : "");
  def bsw-gate(path) {
   let r = cell_run(path, 0, 1800000, nothing());
   let said = print_str(trim(bsw-gate-text(r)));
   let dbg = print_str("DBG " ++ path ++ " stopped=" ++ (nothing?(bsw-stopped(r)) ? "" : (String) bsw-render(record_get(bsw-stopped(r), "kind")) ++ "|" ++ (String) bsw-render(record_get(bsw-stopped(r), "message")) ++ "|" ++ (String) bsw-render(record_get(bsw-stopped(r), "unit")) ++ "|" ++ (String) bsw-render(record_get(bsw-stopped(r), "recipe"))) ++ " err=" ++ (String) record_get(r, "err") ++ " errors=" ++ (String) bsw-render(record_get(r, "errors")) ++ " value=" ++ (String) bsw-render(record_get(r, "value")) ++ " diag=" ++ (String) bsw-render(record_get(r, "diag")));
   nothing?(bsw-stopped(r)) && (Comparable) record_get(r, "errors") == 0 && (String) bsw-render(record_get(r, "value")) == "1" ? 1 : 0;
  }
  def bsw-gates() {
   let structural = bsw-gate("gate/structural-gate-run.fk");
   structural != 1 ? form_error("band-sweep: the structural gate refused an unclassified shell, python or other non-Form file") : bsw-start-gate();
  }
  def bsw-start-gate() = bsw-gate("gate/validation-start-run.fk") != 1 ? form_error("band-sweep: native validation-start needs attention") : 1;
  // the seed and the carrier, built when stale; "build=fresh", "build=0" (built), or the compiler's exit. The C compiler is the one external
  // tool the seed needs to be BUILT, begun by argv in host-walk-sync (the product is made beside itself and renamed over)
  def bsw-darwin?() = (String) host_os() == "Darwin";
  def bsw-built?(word) = bsw-ends?(word, "=fresh") || bsw-ends?(word, "=0");
  def bsw-seed() {
   let built = hw-build();
   let said = print_str("  runtime fkwu: " ++ built);
   bsw-built?(built) ? 1 : form_error("band-sweep: the seed did not build (" ++ built ++ "): cc -O2 -o fkwu runtime/fkwu-uni.c");
  }
  def bsw-carrier-built() {
   let wanted = bsw-darwin?() && (Comparable) file_size("form/native/metal/fk-metal-carrier.m") >= 0;
   let built = wanted ? hw-carrier() : "carrier=absent";
   let said = wanted ? print_str("  metal carrier: " ++ built) : 0;
   !wanted || bsw-built?(built) ? 1 : form_error("band-sweep: the carrier did not build (" ++ built ++ ")");
  }
  def bsw-void(start, end) {
   let shown = bsw-print(bsw-void-lines(start, end));
   form_error("band-sweep: void reading");
  }
  def bsw-missing-files(missing) {
   let a = print_str("  ✗  input file(s) not found — this is a missing file, not a failing band.");
   let b = print_str("      input paths are read as given, else under form/ (e.g. form-stdlib/core.fk):");
   let c = foldl((acc, f) => print_str("        " ++ f), 0, missing);
   form_error("band-sweep: input file(s) not found");
  }
  // ---- the whole sweep: gates, seed, carrier, the seal around the legs, the summary
  def bsw-sweep(doc, ws) {
   let ceiling-s = bsw-opt-int(doc, "ceiling_s", bsw-ceiling-s());
   let gated = bsw-opt-int(doc, "gates", 1) == 0 ? print_str("  gates: skipped — the caller read them") : bsw-gates();
   let seeded = bsw-seed();
   let carried = bsw-carrier-built();
   let died = bsw-prior-deaths();
   let start = bsw-stamp();
   let tally = bsw-run(bsw-mine(ws, doc), ceiling-s);
   let end = bsw-stamp();
   let shown = bsw-print(bsw-summary(tally));
   (String) start != (String) end ? bsw-void(start, end) : tally[3] > 0 ? form_error("band-sweep: " ++ tally[3].str() ++ " workload(s) failed") : 0;
  }
  // ---- the door: a request that does not read is refused by name before any leg
  def bsw-request(doc) {
   let files = bsw-opt-files(doc);
   let missing = bsw-missing(files);
   let ws = !nil?(missing) ? [] : bsw-workloads(doc);
   let why = !nil?(missing) ? "" : bsw-first-why([bsw-shard-why(doc), bsw-selection-why(ws, doc), bsw-preflight-why(bsw-manifest(), ws)]);
   !nil?(missing) ? bsw-missing-files(missing) : len(why) > 0 ? dop-refuse("band-sweep", why) : bsw-opt-int(doc, "list", 0) == 1 ? bsw-list(bsw-mine(ws, doc)) : bsw-sweep(doc, ws);
  }
 }
}
