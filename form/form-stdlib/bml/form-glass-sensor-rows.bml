//////////////////////////////////////////////////////////////////////
//
// bml/form-glass-sensor-rows.bml — the sensor rows' interface contract.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassSensorRowsContract {
      const String Schema = "form-glass-sensor-rows-v1";
      const String CadenceRule = "a sensor process gathers every row that forks or scans the filesystem -- host, process, owner, storage, queue, governor -- at its own cadence and gives each sensor's rows into its own gift frame; the glass frame path never forks and never scans";
      const String SeqRule = "the glass asks a frame's sequence first and re-reads the frame only when the sequence moved; an unmoved frame costs one word";
      const String CellRule = "the frame holds list(schema, sensor, epoch, rows) as the seed's own node words: node_gift_write gives it, node_gift_read takes it, no text wire and no parser stand between, and a received row is the same cell the sensor built (axiom 3: the same category over the same children is the same cell)";
      const String AbsentRule = "a sensor that is not standing is one row that names its door and its absence; nothing is invented in its place";
      const String WitnessRule = "every row set taken from a frame carries the frame own witness row, frame.<sensor>: the shared-memory name and the sequence the rows were taken at, so any number on the glass can say which frame it read and when";
      const String ShapeRule = "rows are the observer's own fgo-metric shape, so a received row is indistinguishable from a locally observed one except for the source it names";
    }
    0;
}
