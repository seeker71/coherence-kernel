// Pure policy and text behavior; the model band exercises the same close door.
// preludes: form/form-stdlib/bml/ear-acoustic-review.bml
section [form.bml] {
 class EarAcousticReviewBand {
  def eabp-h(text, lang, lp, nsp) = list(lang, text, 0, 0, 0, 0, list(), nsp, "", lp, 1000);
  def eabp-fold(rows, bit, acc) = if eq(len(rows), 0) then acc else eabp-fold(tail(rows), mul(bit, 2), add(acc, if head(rows) then bit else 0));
  def eabp-run() {
   let first = eabp-h("one phrase", "en", -1617, 604);
   let good = eabp-h("one phrase", "en", -1460, 436);
   let same = eac-select(first, good, 123);
   let bad = eac-select(first, eabp-h("different", "en", -10, 10), 123);
   // No model state is supplied: these must not enter the acoustic path.
   let fast = eac-close(list(), list(), 0, 0, 64, 1000, good);
   let blank = eac-close(list(), list(), 0, 0, 64, 1000, list());
   let absent = eac-close(list(), list(), 0, 0, 64, 1000, first);
   eabp-fold(list(
    eq(el-trust-line(), -1500),
    eac-needs?(first),
    eq(eac-needs?(good), 0),
    and(str_eq(nth(same, 1), "confirmed"), eq(nth(head(same), 9), -1460)),
    and(str_eq(nth(bad, 1), "disagreed"), eq(nth(head(bad), 9), -1617)),
    eq(eac-credible?(head(eac-select(first, eabp-h("one phrase", "fa", -10, 10), 0))), 0),
    str_eq(nth(eac-select(first, eabp-h("one phrase", "en", -1501, 10), 0), 1), "uncertain"),
    eq(eac-credible?(eabp-h("one phrase", "en", -10, 751)), 0),
    eac-credible?(eabp-h("one phrase", "en", -1500, 750)),
    and(str_eq(nth(fast, 1), ""), eq(nth(fast, 2), 0)),
    and(eq(len(head(blank)), 0), eq(nth(blank, 2), 0)),
    str_eq(nth(absent, 1), "no-audio"),
    str_eq(el-detag("[music (soft)] hello ♪ ♫"), "hello"),
    eq(el-has-words(el-detag("[BLANK_AUDIO] (music) ♪ …")), 0),
    and(el-has-words("سلام"), el-has-words("olá")),
    str_eq(el-unloop("go go go again"), "go …"),
    str_eq(el-unloop("we listen we listen again"), "we listen …"),
    str_eq(el-unloop("very very quiet"), "very very quiet"),
    str_eq(el-join(eac-phrase(list("old!new", "er"), 109, 104)), "new er"),
    eq(len(eac-phrase(list("old", "new"), 106, 106)), 0),
    str_eq(el-join(eac-phrase(list("first", "last"), 109, 90)), "first last")
   ), 1, 0);
  }
 }
}
