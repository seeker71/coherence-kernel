// Q4_K/Q6_K decode reuses each superblock's scales while preserving the
// serial descending row fold. One partition writes the output directly;
// no reduction, temporary buffer, or extra dispatch is introduced.
// preludes: form-stdlib/qk-matvec-lane.fk form-stdlib/metal-door.fk
section [form.bml] {
 class Qwen38DecodeQuant {
  def q38dq-index(type) = (Comparable) type == 12 ? 57 : (Comparable) type == 14 ? 58 : -1;
  def q38dq-msl() = qml-hoist-msl("form_qwen_q4k_decode_f32","q4k","144") ++ qml-hoist-msl("form_qwen_q6k_decode_f32","q6k","210");
  def q38dq-pipes(msl) = list(metal_pipeline(msl,"form_qwen_q4k_decode_f32"),metal_pipeline(msl,"form_qwen_q6k_decode_f32"));
  def q38dq-enqueue(ps,type,weight,x,y,rows,cols,barrier) =
   metal_enqueue(ps[q38dq-index(type)],md-bind16(list(weight,x,y),list(rows,cols,1),256,0,0,barrier),rows);
 }
 0;
}
