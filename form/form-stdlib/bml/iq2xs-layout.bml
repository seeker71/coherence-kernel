//////////////////////////////////////////////////////////////////////
//
// iq2xs-layout.bml — high-grammar authority for GGML type 17.
//
// Qwen3.8-Flash-Next UD-Q2_K_XL does not store its 94 two-bit
// tensors as Q2_K. They are IQ2_XS: 256 weights in 74 bytes, with
// 32 packed u16 grid/sign words and eight nibble-paired scales.
// This authority owns that address geometry and the refusal at the
// first byte/index outside it. The trained grid is fixed data and is
// lowered separately until BML can carry large constant tables.
//
// Executable: form-stdlib/iq2xs-layout.bml
// Proven by: form-stdlib/tests/iq2xs-layout-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.native.quant;

import Form.kernel.*;
import Form.native.metal.*;

interface IIQ2XSLayout [public, witness, reusable] {
   section [public] {
      const int GGMLType = 17;
      const int BlockElements = 256;
      const int BlockBytes = 74;
      const int ScaleOffset = 66;
      const int ScaleBytes = 8;
      const int QuantWords = 32;
      const int GridEntries = 512;
      const int GridWidth = 8;
      const int SignEntries = 128;
      const int SIMDWidth = 32;
      const int SlotRows = 4;
      const int GroupsPerBlock = 8;
      const int GroupElements = 32;

      int QuantWordOffset( int blockBase, int weightIndex ) [abstract];
      int ScaleByteOffset( int blockBase, int weightIndex ) [abstract];
      int GridIndex( int packedWord ) [abstract];
      int SignIndex( int packedWord ) [abstract];
      int SlotRow0( int threadIndex ) [abstract];
      int SlotBlock( int groupIndex ) [abstract];
      int SlotGroupInBlock( int groupIndex ) [abstract];
      int SlotThreadCount( int rows ) [abstract];
      bool WithinBlock( int weightIndex ) [abstract];
   }
}

class IQ2XSLayout [public, reusable, teach, observable] : IIQ2XSLayout {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/iq2xs-layout.bml";
      const String Model = "Qwen3.8-Flash-Next UD-Q2_K_XL";

      int QuantWordOffset( int blockBase, int weightIndex ) [abstract] {}
      int ScaleByteOffset( int blockBase, int weightIndex ) [abstract] {}
      int GridIndex( int packedWord ) [abstract] {}
      int SignIndex( int packedWord ) [abstract] {}
      int SlotRow0( int threadIndex ) [abstract] {}
      int SlotBlock( int groupIndex ) [abstract] {}
      int SlotGroupInBlock( int groupIndex ) [abstract] {}
      int SlotThreadCount( int rows ) [abstract] {}
      bool WithinBlock( int weightIndex ) [abstract] {}
   }
}

class IQ2XSLayoutSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "iq2xs-layout-self";
      const String Pattern = "type17 256-elements 74-bytes qword-grid-sign nibble-scale bounded-refusal";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
