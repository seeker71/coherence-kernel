// Ordinary generation carries a complete-answer allowance. A caller may
// select a smaller or larger allowance; the model carrier owns capacity.
// preludes: form-stdlib/bml/form-cli-generate-reasoning.bml
section [form.bml] {
 class FormCliGenerateCommand {
  field DefaultAnswerTokens = 2048;
  def fgc-default-tokens() = DefaultAnswerTokens();
  def fgc-help() = str_concat("generate [--tokens N] [--reasoning N] [--words MIN:MAX] [--sample SEED] <prompt> — local generation; default ",str_concat(int_to_str(fgc-default-tokens())," answer tokens. --reasoning enables native affine recipe birth/choice/Metal execution and reserves a final answer stage. --words counts whitespace-delimited words and offers one correction in the same model session. --sample selects seeded Qwen3.8 direct-answer sampling (temperature 0.7, top-k 20, top-p 0.8, presence penalty 1.5); seed 1..2147483646, without --reasoning. Use --prompt-file PATH last to read the complete enquiry and source context from a file, preserving its bytes.\n"));
  // request = answer allowance, original prompt, diagnostic, reasoning allowance,
  // word minimum, word maximum (0 disables the word requirement).
  // Invalid input reaches
  // no model admission. The prompt after the option keeps its exact bytes.
  def fgc-seed(request) = if (len(request) > 6) then request[6] else 0;
  def fgc-request(arg) {
   let request = fgc-parse(arg,fgc-default-tokens(),0,0,0,0,0);
   if ((fgc-seed(request) > 0) && (request[3] > 0)) then fgc-invalid("generate --sample currently serves direct answers; use it without --reasoning.\n") else request;
  }
  def fgc-invalid(message) = [0,"",message,0,0,0];
  def fgc-parse(arg,answer,reasoning,tokensSeen,reasoningSeen,lower,upper) {
   if ((Comparable) str_find(arg,"--tokens ",0) == 0) then fgc-option(substring(arg,9,str_len(arg)),"--tokens",answer,reasoning,tokensSeen,reasoningSeen,lower,upper)
   else if ((Comparable) str_find(arg,"--reasoning ",0) == 0) then fgc-option(substring(arg,12,str_len(arg)),"--reasoning",answer,reasoning,tokensSeen,reasoningSeen,lower,upper)
   else if ((Comparable) str_find(arg,"--words ",0) == 0) then fgc-words(substring(arg,8,str_len(arg)),answer,reasoning,tokensSeen,reasoningSeen,upper)
   else if ((Comparable) str_find(arg,"--sample ",0) == 0) then fgc-sample(substring(arg,9,str_len(arg)),answer,reasoning,tokensSeen,reasoningSeen,lower,upper)
   else if ((String) arg == "--sample") then fgc-invalid(fgc-help())
   else if ((Comparable) str_find(arg,"--prompt-file ",0) == 0) then fgc-file(trim(substring(arg,14,str_len(arg))),answer,reasoning,lower,upper)
   else if (((String) trim(arg) == "") || (((String) arg == "--prompt-file") || (((String) arg == "--words") || (((String) arg == "--tokens") || ((String) arg == "--reasoning"))))) then fgc-invalid(fgc-help())
   else [answer,arg,"",reasoning,lower,upper];
  }
  def fgc-sample(rest,answer,reasoning,tokensSeen,reasoningSeen,lower,upper) {
   let at = str_find(rest," ",0);
   if (at <= 0) then fgc-invalid("generate --sample needs a seed from 1 through 2147483646 and a prompt.\n") else {
    let text = substring(rest,0,at); let seed = str_to_int(text);
    if (!(fcsam-seed-valid(seed) && ((String) text == int_to_str(seed)))) then fgc-invalid("generate --sample needs a seed from 1 through 2147483646.\n") else {
     let request = fgc-parse(substring(rest,(at + 1),str_len(rest)),answer,reasoning,tokensSeen,reasoningSeen,lower,upper);
     if (str_len(request[2]) > 0) then request else if (fgc-seed(request) > 0) then fgc-invalid("generate repeats --sample.\n") else append(request,[seed]);
    };
   };
  }
  def fgc-option(rest,option,answer,reasoning,tokensSeen,reasoningSeen,lower,upper) {
   let at = str_find(rest," ",0);
   if (at <= 0) then fgc-invalid(fgc-help()) else {
    let text = substring(rest,0,at); let count = str_to_int(text);
    let prompt = substring(rest,(at + 1),str_len(rest));
    let isTokens = ((String) option == "--tokens");
    let repeated = if isTokens then tokensSeen else reasoningSeen;
    if (!((count > 0) && ((String) text == int_to_str(count)))) then fgc-invalid(str_concat("generate ",str_concat(option," needs a positive whole number.\n")))
    else if repeated then fgc-invalid(str_concat("generate repeats ",str_concat(option,".\n")))
    else fgc-parse(prompt,if isTokens then count else answer,if isTokens then reasoning else count,if isTokens then 1 else tokensSeen,if isTokens then reasoningSeen else 1,lower,upper);
   };
  }
  def fgc-words(rest,answer,reasoning,tokensSeen,reasoningSeen,previous) {
   let at = str_find(rest," ",0); let colon = str_find(rest,":",0);
   if ((previous > 0) || ((at <= 0) || ((colon <= 0) || (colon >= (at - 1))))) then fgc-invalid("generate --words needs one MIN:MAX range and a prompt.\n") else {
    let lowText = substring(rest,0,colon); let highText = substring(rest,(colon + 1),at);
    let lower = str_to_int(lowText); let upper = str_to_int(highText);
    if (!((lower > 0) && ((upper >= lower) && (((String) lowText == int_to_str(lower)) && ((String) highText == int_to_str(upper)))))) then fgc-invalid("generate --words needs positive whole MIN:MAX with MIN <= MAX.\n") else fgc-parse(substring(rest,(at + 1),str_len(rest)),answer,reasoning,tokensSeen,reasoningSeen,lower,upper);
   };
  }
  def fgc-file(path,answer,reasoning,lower,upper) {
   let size = file_size(path);
   if (size <= 0) then fgc-invalid("generate --prompt-file requires a readable, nonempty file.\n")
   else fgc-file-value(read_file(path),size,answer,reasoning,lower,upper);
  }
  def fgc-file-value(text,size,answer,reasoning,lower,upper) = if (!((String) value_kind(text) == "string")) then fgc-invalid("generate --prompt-file could not read the enquiry.\n") else if (!((Comparable) str_len(text) == size)) then fgc-invalid("generate --prompt-file read size changed; inspect the file before generation.\n") else if ((String) trim(text) == "") then fgc-invalid("generate --prompt-file requires an enquiry.\n") else [answer,text,"",reasoning,lower,upper];
  def fgc-run(resident,path,arg) = fgc-run-request(resident,path,fgc-request(arg));
  def fgc-has-word-range(request) = if (len(request) > 5) then (request[5] > 0) else 0;
  def fgc-run-request(resident,path,request) = if (str_len(request[2]) > 0) then [request[2],resident] else if (fgc-seed(request) > 0) then fgcr-run-sampled(resident,path,request[1],head(request),request[4],request[5],fgc-seed(request)) else if fgc-has-word-range(request) then fgcr-run-bounded(resident,path,request[1],request[3],head(request),request[4],request[5]) else if (request[3] > 0) then fgcr-run(resident,path,request[1],request[3],head(request)) else fcmg-generate-resident(resident,path,request[1],head(request));
 }
 0;
}
