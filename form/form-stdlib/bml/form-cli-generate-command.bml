// Ordinary generation carries a complete-answer allowance. A caller may
// select a smaller or larger allowance; the model carrier owns capacity.
// preludes: form-stdlib/form-cli-model-generate.fk
section [form.bml] {
 class FormCliGenerateCommand {
  field DefaultAnswerTokens = 2048;
  def fgc-default-tokens() = DefaultAnswerTokens();
  def fgc-help() = str_concat("generate [--tokens N] <prompt> — local generation; default ",str_concat(int_to_str(fgc-default-tokens())," generated tokens, ending earlier when the model finishes.\n"));
  // request = allowance, original prompt, diagnostic. Invalid input reaches
  // no model admission. The prompt after the option keeps its exact bytes.
  def fgc-request(arg) = if eq(str_find(arg,"--tokens ",0),0) then fgc-option(substring(arg,9,str_len(arg))) else if or(str_eq(trim(arg),""),str_eq(arg,"--tokens")) then list(0,"",fgc-help()) else list(fgc-default-tokens(),arg,"");
  def fgc-option(rest) {
   let at = str_find(rest," ",0);
   if le(at,0) then list(0,"",fgc-help()) else {
    let text = substring(rest,0,at); let count = str_to_int(text);
    let prompt = substring(rest,add(at,1),str_len(rest));
    if not(and(gt(count,0),str_eq(text,int_to_str(count)))) then list(0,"","generate --tokens needs a positive whole number.\n")
    else if str_eq(trim(prompt),"") then list(0,"",fgc-help()) else list(count,prompt,"");
   };
  }
  def fgc-run(resident,path,arg) = fgc-run-request(resident,path,fgc-request(arg));
  def fgc-run-request(resident,path,request) = if gt(str_len(nth(request,2)),0) then list(nth(request,2),resident) else fcmg-generate-resident(resident,path,nth(request,1),head(request));
 }
 0;
}
