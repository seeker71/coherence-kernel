// Ordinary generation carries a complete-answer allowance. A caller may
// select a smaller or larger allowance; the model carrier owns capacity.
// preludes: form-stdlib/bml/form-cli-generate-reasoning.bml
section [form.bml] {
 class FormCliGenerateCommand {
  field DefaultAnswerTokens = 2048;
  def fgc-default-tokens() = DefaultAnswerTokens();
  def fgc-help() = "generate [--tokens N] [--reasoning N] [--words MIN:MAX] [--sample SEED] <prompt> — local generation; default " ++ int_to_str(fgc-default-tokens()) ++ " answer tokens. --reasoning enables native affine recipe birth/choice/Metal execution and reserves a final answer stage. --words counts whitespace-delimited words and offers one correction in the same model session. --sample selects seeded Qwen3.8 direct-answer sampling (temperature 0.7, top-k 20, top-p 0.8, presence penalty 1.5); seed 1..2147483646, without --reasoning. Use --prompt-file PATH last to read the complete enquiry and source context from a file, preserving its bytes.\n";
  // request = answer allowance, original prompt, diagnostic, reasoning allowance,
  // word minimum, word maximum (0 disables the word requirement).
  // Invalid input reaches
  // no model admission. The prompt after the option keeps its exact bytes.
  def fgc-seed(request) = len(request) > 6 ? request[6] : 0;
  def fgc-request(arg) {
   let request = fgc-parse(arg,fgc-default-tokens(),0,0,0,0,0);
   (fgc-seed(request) > 0) && (request[3] > 0) ? fgc-invalid("generate --sample currently serves direct answers; use it without --reasoning.\n") : request;
  }
  def fgc-invalid(message) = list(0,"",message,0,0,0);
  def fgc-parse(arg,answer,reasoning,tokensSeen,reasoningSeen,lower,upper) {
   (Comparable) str_find(arg,"--tokens ",0) == 0 ? fgc-option(substring(arg,9,str_len(arg)),"--tokens",answer,reasoning,tokensSeen,reasoningSeen,lower,upper)
   : (Comparable) str_find(arg,"--reasoning ",0) == 0 ? fgc-option(substring(arg,12,str_len(arg)),"--reasoning",answer,reasoning,tokensSeen,reasoningSeen,lower,upper)
   : (Comparable) str_find(arg,"--words ",0) == 0 ? fgc-words(substring(arg,8,str_len(arg)),answer,reasoning,tokensSeen,reasoningSeen,upper)
   : (Comparable) str_find(arg,"--sample ",0) == 0 ? fgc-sample(substring(arg,9,str_len(arg)),answer,reasoning,tokensSeen,reasoningSeen,lower,upper)
   : (String) arg == "--sample" ? fgc-invalid(fgc-help())
   : (Comparable) str_find(arg,"--prompt-file ",0) == 0 ? fgc-file(trim(substring(arg,14,str_len(arg))),answer,reasoning,lower,upper)
   : ((String) trim(arg) == "") || (((String) arg == "--prompt-file") || (((String) arg == "--words") || (((String) arg == "--tokens") || ((String) arg == "--reasoning")))) ? fgc-invalid(fgc-help())
   : list(answer,arg,"",reasoning,lower,upper);
  }
  def fgc-sample(rest,answer,reasoning,tokensSeen,reasoningSeen,lower,upper) {
   let at = str_find(rest," ",0);
   at <= 0 ? fgc-invalid("generate --sample needs a seed from 1 through 2147483646 and a prompt.\n") : {
    let text = substring(rest,0,at); let seed = str_to_int(text);
    !(fcsam-seed-valid(seed) && ((String) text == int_to_str(seed))) ? fgc-invalid("generate --sample needs a seed from 1 through 2147483646.\n") : {
     let request = fgc-parse(substring(rest,at + 1,str_len(rest)),answer,reasoning,tokensSeen,reasoningSeen,lower,upper);
     str_len(request[2]) > 0 ? request : fgc-seed(request) > 0 ? fgc-invalid("generate repeats --sample.\n") : append(request,list(seed));
    };
   };
  }
  def fgc-option(rest,option,answer,reasoning,tokensSeen,reasoningSeen,lower,upper) {
   let at = str_find(rest," ",0);
   at <= 0 ? fgc-invalid(fgc-help()) : {
    let text = substring(rest,0,at); let count = str_to_int(text);
    let prompt = substring(rest,at + 1,str_len(rest));
    let isTokens = (String) option == "--tokens";
    let repeated = isTokens ? tokensSeen : reasoningSeen;
    !((count > 0) && ((String) text == int_to_str(count))) ? fgc-invalid("generate " ++ option ++ " needs a positive whole number.\n")
    : repeated ? fgc-invalid("generate repeats " ++ option ++ ".\n")
    : fgc-parse(prompt,isTokens ? count : answer,isTokens ? reasoning : count,isTokens ? 1 : tokensSeen,isTokens ? reasoningSeen : 1,lower,upper);
   };
  }
  def fgc-words(rest,answer,reasoning,tokensSeen,reasoningSeen,previous) {
   let at = str_find(rest," ",0); let colon = str_find(rest,":",0);
   (previous > 0) || ((at <= 0) || ((colon <= 0) || (colon >= (at - 1)))) ? fgc-invalid("generate --words needs one MIN:MAX range and a prompt.\n") : {
    let lowText = substring(rest,0,colon); let highText = substring(rest,colon + 1,at);
    let lower = str_to_int(lowText); let upper = str_to_int(highText);
    !((lower > 0) && ((upper >= lower) && (((String) lowText == int_to_str(lower)) && ((String) highText == int_to_str(upper))))) ? fgc-invalid("generate --words needs positive whole MIN:MAX with MIN <= MAX.\n") : fgc-parse(substring(rest,at + 1,str_len(rest)),answer,reasoning,tokensSeen,reasoningSeen,lower,upper);
   };
  }
  def fgc-file(path,answer,reasoning,lower,upper) {
   let size = file_size(path);
   size <= 0 ? fgc-invalid("generate --prompt-file requires a readable, nonempty file.\n")
   : fgc-file-value(read_file(path),size,answer,reasoning,lower,upper);
  }
  def fgc-file-value(text,size,answer,reasoning,lower,upper) = !((String) value_kind(text) == "string") ? fgc-invalid("generate --prompt-file could not read the enquiry.\n") : !((Comparable) str_len(text) == size) ? fgc-invalid("generate --prompt-file read size changed; inspect the file before generation.\n") : (String) trim(text) == "" ? fgc-invalid("generate --prompt-file requires an enquiry.\n") : list(answer,text,"",reasoning,lower,upper);
  def fgc-run(resident,path,arg) = fgc-run-request(resident,path,fgc-request(arg));
  def fgc-has-word-range(request) = len(request) > 5 ? (request[5] > 0) : 0;
  def fgc-run-request(resident,path,request) = str_len(request[2]) > 0 ? list(request[2],resident) : fgc-seed(request) > 0 ? fgcr-run-sampled(resident,path,request[1],head(request),request[4],request[5],fgc-seed(request)) : fgc-has-word-range(request) ? fgcr-run-bounded(resident,path,request[1],request[3],head(request),request[4],request[5]) : request[3] > 0 ? fgcr-run(resident,path,request[1],request[3],head(request)) : fcmg-generate-resident(resident,path,request[1],head(request));
 }
 0;
}
