// Ordinary generation carries a complete-answer allowance. A caller may
// select a smaller or larger allowance; the model carrier owns capacity.
// preludes: form-stdlib/bml/form-cli-generate-reasoning.bml
section [form.bml] {
 class FormCliGenerateCommand {
  field DefaultAnswerTokens = 2048;
  def fgc-default-tokens() = DefaultAnswerTokens();
  def fgc-help() = str_concat("generate [--tokens N] [--reasoning N] <prompt> — local generation; default ",str_concat(int_to_str(fgc-default-tokens())," answer tokens. --reasoning opens a separate initial stage and reserves the answer allowance.\n"));
  // request = answer allowance, original prompt, diagnostic, reasoning allowance.
  // Invalid input reaches
  // no model admission. The prompt after the option keeps its exact bytes.
  def fgc-request(arg) = fgc-parse(arg,fgc-default-tokens(),0,0,0);
  def fgc-parse(arg,answer,reasoning,tokensSeen,reasoningSeen) {
   if eq(str_find(arg,"--tokens ",0),0) then fgc-option(substring(arg,9,str_len(arg)),"--tokens",answer,reasoning,tokensSeen,reasoningSeen)
   else if eq(str_find(arg,"--reasoning ",0),0) then fgc-option(substring(arg,12,str_len(arg)),"--reasoning",answer,reasoning,tokensSeen,reasoningSeen)
   else if or(str_eq(trim(arg),""),or(str_eq(arg,"--tokens"),str_eq(arg,"--reasoning"))) then list(0,"",fgc-help(),0)
   else list(answer,arg,"",reasoning);
  }
  def fgc-option(rest,option,answer,reasoning,tokensSeen,reasoningSeen) {
   let at = str_find(rest," ",0);
   if le(at,0) then list(0,"",fgc-help(),0) else {
    let text = substring(rest,0,at); let count = str_to_int(text);
    let prompt = substring(rest,add(at,1),str_len(rest));
    let isTokens = str_eq(option,"--tokens");
    let repeated = if isTokens then tokensSeen else reasoningSeen;
    if not(and(gt(count,0),str_eq(text,int_to_str(count)))) then list(0,"",str_concat("generate ",str_concat(option," needs a positive whole number.\n")),0)
    else if repeated then list(0,"",str_concat("generate repeats ",str_concat(option,".\n")),0)
    else fgc-parse(prompt,if isTokens then count else answer,if isTokens then reasoning else count,if isTokens then 1 else tokensSeen,if isTokens then reasoningSeen else 1);
   };
  }
  def fgc-run(resident,path,arg) = fgc-run-request(resident,path,fgc-request(arg));
  def fgc-run-request(resident,path,request) = if gt(str_len(nth(request,2)),0) then list(nth(request,2),resident) else if gt(nth(request,3),0) then fgcr-run(resident,path,nth(request,1),nth(request,3),head(request)) else fcmg-generate-resident(resident,path,nth(request,1),head(request));
 }
 0;
}
