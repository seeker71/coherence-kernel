// Translation meanings are Form values: complete labels, bounded batches,
// exact query bytes, segment ordering, explicit row splits and cell cleaning.
// Resource limits are caller policy; a label is never truncated to fit them.
// preludes: form-stdlib/bml/formbin-codec.bml form-stdlib/bml/json-wire-admission.bml form-stdlib/url-encode.fk
section [form.bml] {
 class ConceptTranslation {
  def ctr-ok(value) = list(1,"",value);
  def ctr-bad(reason) = list(0,reason,list());
  def ctr-good(result) = eq(head(result),1);
  def ctr-value(result) = nth(result,2);
  def ctr-reason(result) = nth(result,1);
  def ctr-positive(value) = and(str_eq(value_kind(value),"int"),gt(value,0));
  def ctr-plain(text) = and(str_eq(value_kind(text),"string"),and(fbc-utf8(text,0),ctr-no-control(text,0)));
  def ctr-no-control(text,at) = if eq(at,str_len(text)) then 1 else and(ge(str_byte_at(text,at),32),and(ne(str_byte_at(text,at),127),ctr-no-control(text,add(at,1))));
  def ctr-label(text) = and(ctr-plain(text),gt(str_len(trim(text)),0));
  def ctr-labels(values) = if nil?(values) then 1 else and(ctr-label(head(values)),ctr-labels(tail(values)));
  // Source batching counts UTF-16 units, including two for supplementary code
  // points. UTF-8 bytes are validated before this traversal.
  def ctr-units(text,at,total) = if eq(at,str_len(text)) then total else ctr-unit(text,at,total,str_byte_at(text,at));
  def ctr-unit(text,at,total,byte) = ctr-units(text,add(at,if lt(byte,128) then 1 else if lt(byte,224) then 2 else if lt(byte,240) then 3 else 4),add(total,if ge(byte,240) then 2 else 1));
  def ctr-batches(values,maxRows,maxUnits) = if not(and(fbc-list?(values),and(ctr-positive(maxRows),ctr-positive(maxUnits)))) then ctr-bad("positive batching policy and label list required") else if not(ctr-labels(values)) then ctr-bad("nonempty UTF-8 labels without control bytes required") else ctr-ok(ctr-batch(values,maxRows,maxUnits,list(),0,0,list()));
  def ctr-batch(values,maxRows,maxUnits,current,rows,units,out) = if nil?(values) then reverse(if eq(rows,0) then out else cons(reverse(current),out)) else ctr-batch-next(values,maxRows,maxUnits,current,rows,units,out,add(ctr-units(head(values),0,0),1));
  def ctr-batch-next(values,maxRows,maxUnits,current,rows,units,out,width) = if and(gt(rows,0),or(ge(rows,maxRows),gt(add(units,width),maxUnits))) then ctr-batch(values,maxRows,maxUnits,list(),0,0,cons(reverse(current),out)) else ctr-batch(tail(values),maxRows,maxUnits,cons(head(values),current),add(rows,1),add(units,width),out);
  def ctr-join(values,separator,bins,first) = if nil?(values) then fbc-finish(bins,"") else ctr-join(tail(values),separator,fbc-put(bins,if first then head(values) else str_concat(separator,head(values))),0);
  // application/x-www-form-urlencoded, the source URLSearchParams contract.
  def ctr-query-byte(byte) = if eq(byte,32) then "+" else if or(eq(byte,42),and(url-unreserved?(byte),ne(byte,126))) then byte_to_str(byte) else url-byte-to-escape(byte);
  def ctr-query(text,at,bins) = if eq(at,str_len(text)) then fbc-finish(bins,"") else ctr-query(text,add(at,1),fbc-put(bins,ctr-query-byte(str_byte_at(text,at))));
  def ctr-target(target) = and(ctr-label(target),ctr-target-bytes(target,0));
  def ctr-target-bytes(text,at) = if eq(at,str_len(text)) then 1 else and(or(eq(str_byte_at(text,at),45),or(and(ge(str_byte_at(text,at),65),le(str_byte_at(text,at),90)),and(ge(str_byte_at(text,at),97),le(str_byte_at(text,at),122)))),ctr-target-bytes(text,add(at,1)));
  def ctr-query-for(values,target) = if not(and(fbc-list?(values),and(gt(len(values),0),and(ctr-labels(values),ctr-target(target))))) then ctr-bad("complete labels and language target required") else ctr-ok(str_concat("client=gtx&sl=en&tl=",str_concat(ctr-query(target,0,list()),str_concat("&dt=t&q=",ctr-query(ctr-join(values,"\n",list(),1),0,list())))));
  def ctr-array(node) = node_eq(node_category(node),JSON-ARRAY());
  def ctr-payload(bytes) = if not(and(str_eq(value_kind(bytes),"string"),and(fbc-utf8(bytes,0),jwa-valid(bytes)))) then ctr-bad("complete UTF-8 translation JSON required") else ctr-payload-node(parse-json("concept-translation",bytes));
  def ctr-payload-node(node) = if not(ctr-array(node)) then ctr-bad("translation response array required") else if nil?(json-array-elements(node)) then ctr-bad("translation segment array missing") else ctr-segment-array(head(json-array-elements(node)));
  def ctr-segment-array(node) = if not(ctr-array(node)) then ctr-bad("translation segments must be an array") else ctr-segments(json-array-elements(node),list());
  def ctr-segments(nodes,bins) = if nil?(nodes) then ctr-ok(ctr-without-cr(fbc-finish(bins,""),0,0,list())) else ctr-segment(head(nodes),tail(nodes),bins);
  def ctr-segment(node,rest,bins) = if not(ctr-array(node)) then ctr-bad("translation segment must be an array") else if nil?(json-array-elements(node)) then ctr-segments(rest,bins) else ctr-segment-text(head(json-array-elements(node)),rest,bins);
  def ctr-segment-text(node,rest,bins) = if node_eq(node_category(node),JSON-NULL()) then ctr-segments(rest,bins) else if not(eq(node_type(node),2)) then ctr-bad("translation segment text must be a string or null") else ctr-segment-bytes(json-string-value(node),rest,bins);
  def ctr-translation-bytes(text,at) = if eq(at,str_len(text)) then 1 else and(or(or(eq(str_byte_at(text,at),9),or(eq(str_byte_at(text,at),10),eq(str_byte_at(text,at),13))),and(ge(str_byte_at(text,at),32),ne(str_byte_at(text,at),127))),ctr-translation-bytes(text,add(at,1)));
  def ctr-translation-text(text) = and(str_eq(value_kind(text),"string"),and(fbc-utf8(text,0),ctr-translation-bytes(text,0)));
  def ctr-segment-bytes(text,rest,bins) = if not(ctr-translation-text(text)) then ctr-bad("translation text contains malformed UTF-8 or control bytes") else ctr-segments(rest,fbc-put(bins,text));
  def ctr-without-cr(text,at,start,bins) = if eq(at,str_len(text)) then fbc-finish(fbc-put(bins,substring(text,start,at)),"") else if eq(str_byte_at(text,at),13) then ctr-without-cr(text,add(at,1),add(at,1),fbc-put(bins,substring(text,start,at))) else ctr-without-cr(text,add(at,1),start,bins);
  def ctr-lines(text,at,start,rows) = if eq(at,str_len(text)) then reverse(cons(substring(text,start,at),rows)) else if eq(str_byte_at(text,at),10) then ctr-lines(text,add(at,1),add(at,1),cons(substring(text,start,at),rows)) else ctr-lines(text,add(at,1),start,rows);
  def ctr-response(bytes,expected) = if not(ctr-positive(expected)) then ctr-bad("positive expected translation row count required") else ctr-response-value(ctr-payload(bytes),expected);
  def ctr-response-value(result,expected) = if not(ctr-good(result)) then result else ctr-response-rows(ctr-lines(ctr-value(result),0,0,list()),expected);
  def ctr-response-rows(rows,expected) = if eq(len(rows),expected) then ctr-ok(list("complete",rows)) else if eq(expected,1) then ctr-bad("one source row produced a different row count") else ctr-ok(list("split",div(expected,2),len(rows)));
  def ctr-cell(text,at,start,gap,bins) = if eq(at,str_len(text)) then fbc-finish(fbc-put(bins,substring(text,start,at)),"") else ctr-cell-byte(text,at,start,gap,bins,str_byte_at(text,at));
  def ctr-cell-byte(text,at,start,gap,bins,byte) = if or(eq(byte,9),or(eq(byte,10),eq(byte,13))) then ctr-cell(text,add(at,1),add(at,1),1,if gap then bins else fbc-put(fbc-put(bins,substring(text,start,at))," ")) else ctr-cell(text,add(at,1),start,0,bins);
  def ctr-cells(rows,requireNonempty,out) = if nil?(rows) then ctr-ok(reverse(out)) else if not(ctr-translation-text(head(rows))) then ctr-bad("complete UTF-8 translation cell required") else ctr-cell-next(ctr-cell(head(rows),0,0,0,list()),tail(rows),requireNonempty,out);
  def ctr-cell-next(value,rest,requireNonempty,out) = if and(requireNonempty,eq(str_len(trim(value)),0)) then ctr-bad("nonempty translation coverage required") else ctr-cells(rest,requireNonempty,cons(value,out));
 }
 0;
}
