// The walk forwards the caller's whole deadline. Historical durations, other
// processes and host memory are observations, not a forecast of whether the
// next operation can run. Native session admission owns the actual allocation,
// resource wait, release and next choice; the existing checkpoint owns a turn
// when its caller's window ends.
import form-stdlib/bml/host-walk-text.bml;
import form-stdlib/bml/host-walk-floor.bml;
import form-stdlib/bml/memory-governor.bml;
section [form.bml] {
 class HostWalkWindow {

  def hw-left(until, now) = until > now ? until - now : 0;
  def hw-room-at(until, now, floor) {
   let left = hw-left(until, now);
   [left > 0, "[walk-window] " ++ hw-minutes(left) ++ " left; " ++ (left > 0 ? "the caller's window remains open" : "the caller's window ended") ++ "; " ++ floor[1] ++ (nothing?(floor[0]) ? "" : ": " ++ hw-minutes(floor[0]))];
  }
  def hw-room(until) = hw-room-at(until, host_monotonic_ms(), hw-option-floor());
  // Process activity names what is running elsewhere. It cannot establish
  // current device ownership or the capacity a new session needs.
  def hw-walk-doors() = ["observe/movement-run.bml", "observe/native-turn-run.bml", "observe/form-cli-code-run.fk", "observe/prompt-draft-run.bml", "observe/draft-native-reading-run.bml", "observe/lora-lift-run.bml", "observe/local-plan-run.bml", "observe/prompt-lookup-run.bml", "observe/native-session-learning-run.fk", "observe/form-cli-session-home-embody-run.fk", "observe/offline-exam-run.bml", "observe/self-distill-run.bml", "observe/self-review-run.bml"];
  def hw-door-in(arg, doors) = nil?(doors) ? "" : hw-ends?(arg, doors[0]) ? doors[0] : hw-door-in(arg, doors[1:]);
  def hw-door-of(argv) = (String) value_kind(argv) != "list" ? "" : len(argv) < 2 ? "" : (String) value_kind(argv[1]) != "string" ? "" : hw-door-in(argv[1], hw-walk-doors());
  def hw-walk-row?(row, here) = (String) value_kind(row) != "list" ? false : len(row) < 5 ? false : (String) value_kind(row[3]) != "string" ? false : (String) row[3] == "" ? false : (String) row[3] == here ? false : (String) hw-door-of(row[4]) != "" ? true : false;
  def hw-elsewhere-of(rows, here) = nil?(rows) ? [] : hw-walk-row?(rows[0], here) ? cons(rows[0], hw-elsewhere-of(rows[1:], here)) : hw-elsewhere-of(rows[1:], here);
  def hw-here() {
   let me = host_process(host_pid());
   (String) value_kind(me) != "list" ? host_cwd() : len(me) < 4 ? host_cwd() : me[3];
  }
  def hw-process-rows(pids) = nil?(pids) ? [] : cons(host_process(pids[0][0]), hw-process-rows(pids[1:]));
  def hw-elsewhere(here) {
   let pids = host_processes("fkwu*");
   (String) value_kind(pids) != "list" ? [] : hw-elsewhere-of(hw-process-rows(pids), here);
  }
  def hw-walk-name(row) = hw-door-of(row[4]) ++ " (pid " ++ row[0].str() ++ ") in " ++ row[3];
  def hw-walk-names(rows) = nil?(rows) ? "" : hw-walk-name(rows[0]) ++ (nil?(rows[1:]) ? "" : ", " ++ hw-walk-names(rows[1:]));
  def hw-activity-of(others) = nil?(others) ? "" : "[walk-activity] " ++ hw-walk-names(others) ++ "; native admission observes current ownership and allocation";
  def hw-activity-with(look) = hw-activity-of(look(hw-here()));
  def hw-activity() = hw-activity-with(hw-elsewhere);
  // Retain the actual memory reading without inventing a quota from its ratios.
  def hw-stored(vm) = len(vm) >= 18 ? vm[17] * vm[0] : mg-compressor(vm);
  def hw-memory-room-of(own, vm) = [true,"[walk-memory] footprint " ++ (value_kind(own)=="int" && own>0 ? mg-gib-text(own) : "unobserved") ++ (mg-vm-ok?(vm) ? "; available " ++ mg-gib-text(mg-available(vm)) ++ "; compressed " ++ mg-gib-text(hw-stored(vm)) : "; host memory unobserved") ++ "; native admission owns the requested allocation"];
  def hw-memory-room() = hw-memory-room-of(kernel_stat(91), mg-sense());
  def hw-ready(until) {
   let said = hw-say(hw-activity());
   let mem = hw-say(hw-memory-room()[1]);
   hw-room(until);
  }
 }
}
