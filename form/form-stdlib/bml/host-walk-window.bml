// host-walk-window.bml — a walk's turns share the caller's window and GPU.
//
// The window: a walk's turns live inside it (hw-turns, host-walk-turns.bml). Each turn reads the window's end on stdin
// as its wall deadline, {"turns":24,"deadline_ms":<the window's end on host_monotonic_ms>}; the host's monotonic clock
// is one clock for every process on this host, so the turn reads the same deadline its walk set, starts no option the
// time left cannot hold, and stops its lane at the deadline. A turn begins only while the time left holds one
// option, as long as the median real option of the voice it opens on the checkout's own ledger (hw-room), and only after the host's
// other checkouts let the one GPU go: a turn waits, inside its window, while a walk door or the session learner
// runs in another checkout (hw-yield). Actual voice admission reserves its own
// model and packet geometry; the walk does not estimate another memory allowance.
// What it holds: the room over the option floor (hw-room; the floor itself is host-walk-floor.bml), the walk doors of other checkouts and the
// yield to them (hw-walk-doors, hw-yield), and hw-ready. The planner owns its
// registry voice chain and retains actual resource refusals in its continuation.
// What it needs: host-walk-text.bml (hw-field, hw-minutes, hw-ends?, hw-say), memory-governor.bml (mg-*) and
// model-registry.bml (mr-find, mr-path: the fast-answer weight file).
import form-stdlib/bml/host-walk-text.bml;
import form-stdlib/bml/host-walk-floor.bml;
import form-stdlib/bml/memory-governor.bml;
import form-stdlib/model-registry.bml;
section [form.bml] {
 class HostWalkWindow {

  def hw-left(until, now) = until > now ? until - now : 0;
  // The window keeps room for what learns: the turns and the planner end this long before the window does, so the reading,
  // the rows, the lift, the proof and the register never meet a window the turns spent.
  def hw-learn-room-ms() = 1800000;
  def hw-turns-until(until) = until - hw-learn-room-ms();
  def hw-fastest-fits?(left, floor) = len(floor) > 2 && left >= floor[2];
  def hw-room-need(until, now, floor) {
   let left = hw-left(until, now);
   let half = left / 2;
   let clamped = floor[0] > half && half > 0;
   let note = clamped ? floor[1] ++ "; clamped to half the window" : floor[1];
   let ms = clamped ? half : floor[0];
   len(floor) > 2 ? [ms, note, floor[2]] : [ms, note];
  }
  def hw-room-at(until, now, floor) {
   let need = hw-room-need(until, now, floor);
   let left = hw-left(until, now);
   let shortOfFastest = need[0] < floor[0] && len(floor) > 2 && left < floor[2];
   let held = left >= need[0] && !shortOfFastest ? [true, "[walk-window] " ++ hw-minutes(left) ++ " left holds an option of " ++ hw-minutes(need[0]) ++ " (" ++ need[1] ++ ")"] : hw-fastest-fits?(left, floor) ? [true, "[walk-window] " ++ hw-minutes(left) ++ " left is short of the median option of " ++ hw-minutes(floor[0]) ++ " (" ++ floor[1] ++ ") and holds the fastest measured, " ++ hw-minutes(floor[2]) ++ "; the window's end keeps the option's checkpoint"] : [false, "[walk-window] " ++ hw-minutes(left) ++ " left cannot hold an option of " ++ hw-minutes(need[0]) ++ " (" ++ need[1] ++ "): no turn starts"];
   held;
  }
  def hw-room(until) = hw-room-at(until, host_monotonic_ms(), hw-option-floor());
  // the walk doors of the host's other checkouts, the local planner (observe/local-plan-run.bml, which opens a plan
  // voice), the prompt-lookup run (observe/prompt-lookup-run.bml, which opens Qwen sessions to time them), and the
  // session learner that trains on the GPU (its worker and the session door that hands it a teaching and waits for
  // it to settle): one model on the one GPU at a time
  def hw-walk-doors() = ["observe/movement-run.bml", "observe/native-turn-run.bml", "observe/form-cli-code-run.fk", "observe/prompt-draft-run.bml", "observe/draft-native-reading-run.bml", "observe/lora-lift-run.bml", "observe/local-plan-run.bml", "observe/prompt-lookup-run.bml", "observe/native-session-learning-run.fk", "observe/form-cli-session-home-embody-run.fk", "observe/offline-exam-run.bml", "observe/self-distill-run.bml", "observe/self-review-run.bml", "observe/scheduled-walk.bml", "observe/day-turn.bml"];
  def hw-door-in(arg, doors) = nil?(doors) ? "" : hw-ends?(arg, doors[0]) ? doors[0] : hw-door-in(arg, doors[1:]);
  def hw-door-of(argv) = (String) value_kind(argv) != "list" ? "" : len(argv) < 2 ? "" : (String) value_kind(argv[1]) != "string" ? "" : hw-door-in(argv[1], hw-walk-doors());
  def hw-walk-row?(row, here) = (String) value_kind(row) != "list" ? false : len(row) < 5 ? false : (String) value_kind(row[3]) != "string" ? false : (String) row[3] == "" ? false : (String) row[3] == here ? false : (String) hw-door-of(row[4]) != "" ? true : false;
  def hw-elsewhere-of(rows, here) = nil?(rows) ? [] : hw-walk-row?(rows[0], here) ? cons(rows[0], hw-elsewhere-of(rows[1:], here)) : hw-elsewhere-of(rows[1:], here);
  def hw-here() {
   let me = host_process(host_pid());
   (String) value_kind(me) != "list" ? host_cwd() : len(me) < 4 ? host_cwd() : me[3];
  }
  def hw-process-rows(pids) = nil?(pids) ? [] : cons(host_process(pids[0][0]), hw-process-rows(pids[1:]));
  def hw-elsewhere(here) {
   let pids = host_processes("fkwu*");
   (String) value_kind(pids) != "list" ? [] : hw-elsewhere-of(hw-process-rows(pids), here);
  }
  def hw-walk-name(row) = hw-door-of(row[4]) ++ " (pid " ++ row[0].str() ++ ") in " ++ row[3];
  def hw-walk-names(rows) = nil?(rows) ? "" : hw-walk-name(rows[0]) ++ (nil?(rows[1:]) ? "" : ", " ++ hw-walk-names(rows[1:]));
  // look(here) answers the host's walk rows in other checkouts; the wait rests a minute between looks, and ends
  // when none walks or when the window no longer holds an option
  def hw-yield-poll-ms() = 60000;
  def hw-yield(until) = hw-yield-with(until, hw-elsewhere, hw-option-floor(), hw-yield-poll-ms());
  def hw-yield-now(until) = hw-yield-with(until, hw-elsewhere, hw-option-floor(), hw-yield-poll-ms());
  def hw-yield-floor(until) = hw-yield-with(until, hw-elsewhere, hw-option-floor(), hw-yield-poll-ms());
  def hw-yield-with(until, look, floor, poll) = hw-yield-from(until, host_monotonic_ms(), look, floor, hw-here(), look(hw-here()), "", poll);
  def hw-yield-from(until, began, look, floor, here, others, named, poll) {
   let room = hw-room-at(until, host_monotonic_ms(), floor);
   nil?(others) ? hw-yielded(began, named)
   : !room[0] ? "[walk-yield] " ++ hw-walk-names(others) ++ " still walks, and the window no longer holds an option"
   : hw-yield-rest(until, began, look, floor, here, (String) named == "" ? hw-walk-names(others) : named, poll);
  }
  def hw-yield-rest(until, began, look, floor, here, named, poll) {
   let rested = host_sleep_ms(poll);
   hw-yield-from(until, began, look, floor, here, look(here), named, poll);
  }
  def hw-yielded(began, named) = (String) named == "" ? "" : "[walk-yield] waited " ++ hw-minutes(host_monotonic_ms() - began) ++ " for " ++ named ++ " to end: one model on the GPU at a time";
  def hw-ready(until) {
   let said = hw-say(hw-yield(until));
    hw-room(until);
  }
 }
}
