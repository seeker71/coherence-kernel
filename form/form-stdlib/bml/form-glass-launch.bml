package Form.glass.launch;

import Form.kernel.*;
import Form.glass.startup.*;

interface IFormGlassLaunch [public, witness, resident, cache, jit, map] {
   section [public] {
      const String Schema = "form-glass-launch-v2";
      const Int AttentionMilliseconds = 5000;
      const String DependencyRule = "the compact manifest joins each unit's content-derived source-hash row and stat hints for watching; both current and changed hints defer compilation to the demanded live door whose fkwu loader rejects missing, stale, or foreign images";
      const String CacheRule = "admission preserves every executable fkb, symbol image and matching bml.lowfk memo; the demanded loader validates its own source and compiler identity and generates only the requested stale or missing unit; caches are never tree truth";
      const String AttentionRule = "before dependency observation begins, the startup view paints its physical carrier frame; admission reports its elapsed time and watcher choice without eager refresh processes or bulk image deletion";
      const String FailureRule = "the source-hash manifest is durable admission state, not proof of a successful compile; an absent runner image must still compile and any compiler failure stops the alias before Glass starts";
      const String SupervisorRule = "Form persists running, selfmolt, or abstain and owns the restart choice; its native supervisor serves the live view and sensors, relaunches when the body requests it, and ends every owned carrier on abstention";

      Object Launch() [abstract];
   }
}

class FormGlassLaunch [public, resident, observable, cache, jit, map] : IFormGlassLaunch {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-launch.bml";
      const String DigestPath = FormHearth.HearthDir + "/form-glass-dependency.manifest";
      const String RunnerPath = "observe/form-glass-live-run.fk";
      Object Launch() [abstract] {}
   }
}
