package Form.glass.launch;

import Form.kernel.*;
import Form.glass.startup.*;

interface IFormGlassLaunch [public, witness, resident, cache, jit, map] {
   section [public] {
      const String Schema = "form-glass-launch-v2";
      const Int AttentionMilliseconds = 5000;
      const String DependencyRule = "the compact manifest joins each unit's content-derived source-hash row; changed identity refreshes bounded units before the final identity is persisted, while unchanged identity defers child dispatch to the demanded live door whose fkwu loader still rejects missing, stale, or foreign images";
      const String CacheRule = "only executable fkb and symbol consumers are released; matching bml.lowfk lowering memos remain eligible for immediate recompilation and are never treated as tree truth";
      const String AttentionRule = "before dependency validation begins, the startup view paints its physical carrier frame; changed units name JIT CHECK, elapsed JIT MAP, and the five-second close-attention boundary, while unchanged units spawn no eager refresh process";
      const String FailureRule = "the source-hash manifest is durable admission state, not proof of a successful compile; an absent runner image must still compile and any compiler failure stops the alias before Glass starts";
      const String SupervisorRule = "Form persists running, selfmolt, or abstain and returns the restart choice; the zsh carrier only preserves the foreground TTY, relaunches when Form answers one, and stops on signal or Form abstention";

      Object Launch() [abstract];
   }
}

class FormGlassLaunch [public, resident, observable, cache, jit, map] : IFormGlassLaunch {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-launch.bml";
      const String DigestPath = FormHearth.HearthDir + "/form-glass-dependency.manifest";
      const String RunnerPath = "observe/form-glass-live-run.fk";
      Object Launch() [abstract] {}
   }
}
