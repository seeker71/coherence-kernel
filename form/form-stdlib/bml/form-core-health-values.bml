// Core observation projections remain ordinary Form values until a caller
// explicitly asks for primary nodes. Health and care share these meanings.
// preludes: form-stdlib/bml/organ-health-stream.bml
section [form.bml] {
 class FormCoreHealthValues {
  def ohcv-source-report(reader,source) = jv-set(ohs-view(reader),"declaration",jv-node(source));
  def ohcv-row(source,row) = jv-overlay(row,list(jv-pair("source",jv-get(source,"source")),jv-pair("source_state",jv-get(source,"state"))));
  def ohcv-current(source,rows) = rows |> map(row => ohcv-row(source,row));
  def ohcv-readings(sources) = nil?(sources) ? list() : append(ohcv-current(head(sources),jv-items(jv-get(head(sources),"current"))),ohcv-readings(tail(sources)));
  def ohcv-attention(rows,pain) = nil?(rows) ? list() : ohv-unease(head(rows)) && ((Comparable) ohv-pain(head(rows)) == pain) ? cons(head(rows),ohcv-attention(tail(rows),pain)) : ohcv-attention(tail(rows),pain);
  def ohcv-capabilities(rows) = rows |> map(row => jv-object(list(jv-s("organ",jv-str(row,"organ")),jv-s("flow",jv-str(row,"flow")),jv-s("aspect",jv-str(row,"aspect")),jv-pair("offered_responses",jv-get(row,"offers")),jv-pair("needed_resources",jv-get(row,"needs")),jv-pair("health",jv-get(row,"health")),jv-pair("observation_age_ms",jv-get(row,"observation_age_ms")),jv-pair("source",jv-get(row,"source")),jv-pair("source_state",jv-get(row,"source_state")),jv-s("scope","offered-by-observed-organ;execution-owned-by-organ"))));
  def ohcv-bytes(sources) = nil?(sources) ? 0 : (jv-str(head(sources),"read_bytes") + ohcv-bytes(tail(sources)));
  def ohcv-source-needs(sources) = nil?(sources) ? list() : ((String) jv-str(head(sources),"state") == "caught-up") && (len(jv-items(jv-get(head(sources),"current"))) > 0) ? ohcv-source-needs(tail(sources)) : cons(jv-object(list(jv-s("source",jv-str(head(sources),"source")),jv-s("state",jv-str(head(sources),"state")),jv-s("resource",(String) jv-str(head(sources),"state") == "backlog" ? "local-reader-work" : (String) jv-str(head(sources),"state") == "awaiting-complete-record" ? "complete-event" : (String) jv-str(head(sources),"state") == "caught-up" ? "organ-observation" : "readable-organ-evidence"))),ohcv-source-needs(tail(sources)));
  def ohcv-project(root,discovery,sources,started) {
   let rows = ohcv-readings(sources);
   let attention = append(ohcv-attention(rows,1),ohcv-attention(rows,0));
   jv-object(list(jv-s("schema","form-core-health-v1"),jv-s("root",root),jv-s("coverage",jv-str(discovery,"coverage")),jv-s("health_basis","latest-complete-organ-observations;age-and-source-state-retained"),jv-pair("discovery",discovery),jv-pair("sources",jv-array(sources)),jv-pair("organs",jv-array(ohcv-capabilities(rows))),jv-pair("attention",jv-array(attention)),jv-pair("source_needs",jv-array(ohcv-source-needs(sources))),jv-n("read_bytes",ohcv-bytes(sources)),jv-n("elapsed_ms",host_monotonic_ms() - started),jv-n("model_calls",0),jv-n("remote_calls",0),jv-s("crossing_scope","this health read;native shared-memory discovery and local file deltas"),jv-s("next","offer local resources to the asking organ;apply only owned responses;re-observe before claiming recovery")));
  }
 }
 0;
}
