// Core observation projections remain ordinary Form values until a caller
// explicitly asks for primary nodes. Health and care share these meanings.
import form-stdlib/bml/organ-health-stream.bml;
section [form.bml] {
 class FormCoreHealthValues {
  def ohcv-source-report(reader,source) = jv-set(ohs-view(reader),"declaration",jv-node(source));
  def ohcv-row(source,row) = jv-overlay(row,[jv-pair("source",jv-get(source,"source")),jv-pair("source_state",jv-get(source,"state"))]);
  def ohcv-current(source,rows) = rows |> map(row => ohcv-row(source,row));
  def ohcv-readings(sources) = if nil?(sources) then [] else append(ohcv-current(sources[0],jv-items(jv-get(sources[0],"current"))),ohcv-readings(sources[1:]));
  def ohcv-attention(rows,pain) = if nil?(rows) then [] else if (ohv-unease(rows[0]) && ((Comparable) ohv-pain(rows[0]) == pain)) then cons(rows[0],ohcv-attention(rows[1:],pain)) else ohcv-attention(rows[1:],pain);
  def ohcv-capabilities(rows) = rows |> map(row => jv-object([jv-s("organ",jv-str(row,"organ")),jv-s("flow",jv-str(row,"flow")),jv-s("aspect",jv-str(row,"aspect")),jv-pair("offered_responses",jv-get(row,"offers")),jv-pair("needed_resources",jv-get(row,"needs")),jv-pair("health",jv-get(row,"health")),jv-pair("observation_age_ms",jv-get(row,"observation_age_ms")),jv-pair("source",jv-get(row,"source")),jv-pair("source_state",jv-get(row,"source_state")),jv-s("scope","offered-by-observed-organ;execution-owned-by-organ")]));
  def ohcv-bytes(sources) = if nil?(sources) then 0 else (jv-str(sources[0],"read_bytes") + ohcv-bytes(sources[1:]));
  def ohcv-source-needs(sources) = if nil?(sources) then [] else if (((String) jv-str(sources[0],"state") == "caught-up") && (len(jv-items(jv-get(sources[0],"current"))) > 0)) then ohcv-source-needs(sources[1:]) else cons(jv-object([jv-s("source",jv-str(sources[0],"source")),jv-s("state",jv-str(sources[0],"state")),jv-s("resource",if ((String) jv-str(sources[0],"state") == "backlog") then "local-reader-work" else if ((String) jv-str(sources[0],"state") == "awaiting-complete-record") then "complete-event" else if ((String) jv-str(sources[0],"state") == "caught-up") then "organ-observation" else "readable-organ-evidence")]),ohcv-source-needs(sources[1:]));
  def ohcv-project(root,discovery,sources,started) {
   let rows = ohcv-readings(sources);
   let attention = append(ohcv-attention(rows,1),ohcv-attention(rows,0));
   jv-object([jv-s("schema","form-core-health-v1"),jv-s("root",root),jv-s("coverage",jv-str(discovery,"coverage")),jv-s("health_basis","latest-complete-organ-observations;age-and-source-state-retained"),jv-pair("discovery",discovery),jv-pair("sources",jv-array(sources)),jv-pair("organs",jv-array(ohcv-capabilities(rows))),jv-pair("attention",jv-array(attention)),jv-pair("source_needs",jv-array(ohcv-source-needs(sources))),jv-n("read_bytes",ohcv-bytes(sources)),jv-n("elapsed_ms",(host_monotonic_ms() - started)),jv-n("model_calls",0),jv-n("remote_calls",0),jv-s("crossing_scope","this health read;native shared-memory discovery and local file deltas"),jv-s("next","offer local resources to the asking organ;apply only owned responses;re-observe before claiming recovery")]);
  }
 }
 0;
}
