//////////////////////////////////////////////////////////////////////
//
// form-cli-author-altitude.bml — high-grammar authority.
//
// The mirror for the authoring invitation. It counts pictures with
// warmth: how many BML pictures, how many living cells, how many
// cells bound to a picture. You're invited to write new meaning
// in BML or higher; this class watches that invitation ripen.
//
// Executable: form-stdlib/form-cli-author-altitude.bml
// Proven by: form-stdlib/tests/form-cli-author-altitude-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.authoraltitude;

import Form.kernel.*;
import Form.cli.flow.*;

interface IAuthorAltitude [public, witness, reusable] {
   section [public] {
      const String PicturesDir = "form/form-stdlib/bml";
      const String CellsDir = "form/form-stdlib";
      const String BindMark = "high-bml-class-template-field";
      const String TrustRule = "count pictures with warmth; existing organs are welcome";

      int Pictures() [abstract];
      int Cells() [abstract];
      int Bound() [abstract];
      int Fold() [abstract];
   }
}

template AltitudeRow<TCount> [public, reusable] {
   section [public] {
      TCount Pictures() [get];
      TCount Cells() [get];
      TCount Bound() [get];
   }
}

class FormAuthorAltitude [public, reusable, teach] : IAuthorAltitude {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-author-altitude.bml";

      int Pictures() [abstract] {}
      int Cells() [abstract] {}
      int Bound() [abstract] {}
      int Fold() [abstract] {}
   }
}

class FormAuthorAltitudeSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-author-altitude-self";
      const String Pattern = "pictures-with-warmth organs-welcome bindings-ripen";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
