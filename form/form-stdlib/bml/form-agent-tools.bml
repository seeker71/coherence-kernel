            fat-fail(nil?(errors) ? "bml-syntax-refused; original documents preserved" : "bml-syntax-refused: " + node_value(node_children(errors[-1])[0]),docs);
        }
        // Current declarations answer library questions; the caller's execution
        // checks establish whether its program imports and uses them correctly.
        def fat-api-paths() = ["form/form-stdlib/core.fk","form/form-stdlib/line-grammar.fk","form/form-stdlib/bml/string-join.bml"];
        def fat-api-surface(text,row) {
            let prefix=str-join-with(split-on(text,"\n")[0:row[2] - 1],"\n");
            let cursor=cur-advance(cursor-str(text),len(prefix) + (row[2] > 1 ? 1 : 0));
            fat-api-surface-at(text,row,cursor,row[1]=="form");
        }
        def fat-api-surface-at(text,row,cursor,raw) {
            let token=sa-next(cursor,raw);
            let declared=raw && token[0]=="(" ? sa-next(token[2],true) : token;
            let named=sa-next(declared[2],raw);
            if cur-eof?(cursor) then nothing()
            else if declared[0]!=(raw ? "defn" : "def") || named[0]!=row[0] then fat-api-surface-at(text,row,token[2],raw)
            else { let header=sa-header(named[2],raw,[]);
             if nothing?(header) then nothing() else {
                let body=sa-body(header[0],raw,header[1],0,0,"",raw ? ")" : nil?(header[1]) ? ";" : "}");
                [substring(text,token[1],cur-pos(header[0])),substring(text,token[1],body[0])];
             };
            };
        }
        def fat-api-reading(path,text,prior,current) = nothing?(text) ? nothing() : {
            let cached=record_has(prior,path) ? record_get(prior,path) : [];
