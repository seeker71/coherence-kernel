        def fat-command(docs, command, input) = if (!fat-text?(command)) then fat-fail("invalid-command-value", docs) else fat-command-argv(docs, input, fat-argv(command));
        def fat-command-argv(docs, input, parsed) = if (!((String) parsed[1] == "")) then fat-fail(parsed[1], docs) else if nil?(parsed[0]) then fat-fail("missing-tool", docs) else fat-call(docs, parsed[0][0], parsed[0][1:], input);
