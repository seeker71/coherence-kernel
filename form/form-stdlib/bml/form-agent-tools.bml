            record_set(current,path,reading);
            reading;
        };
        def fat-source-catalog(docs,paths) {
            let prior=record_has(fat-api-held,"current") ? record_get(fat-api-held,"current") : record_new(0);
            let current=record_new(0);
            let floor=nil?(paths) || any?(doc=>fat-fk-path?(doc[1]) || fat-ar-bml-surface?(doc[2]),docs) ? fat-api-paths() : [];
            let roots=append(docs |> map(doc=>[doc[1],doc[2],0]),floor |> map(path=>[path,nothing(),1]));
            let observed=fat-source-providers(roots,prior,current,[],0,paths);
