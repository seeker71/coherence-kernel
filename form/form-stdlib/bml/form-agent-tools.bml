                let paths=parsed[1] != "" || input != "" || fat-has(far-get(parsed[0],"paths",[]),"-") ? [] : far-get(parsed[0],"paths",[]);
                fat-source(docs,paths,sources=>fat-with-docs(far-parsed-input(sources,input,parsed),docs));
            }
