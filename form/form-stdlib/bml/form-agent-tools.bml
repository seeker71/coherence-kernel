            let span=fat-read-span(doc[2],str_to_int(args[1]),str_to_int(args[2]),len(args)>=4 ? args[3] : "lines");
            fat-utf8-boundary?(doc[2],span[0]) && fat-utf8-boundary?(doc[2],span[1]) ? fat-ok(substring(doc[2],span[0],span[1]),docs) : fat-fail("read-byte-range-splits-utf8",docs);
        }; });
        def fat-read-span(text,offset,count,unit) = unit=="bytes" ? { let start=min2(len(text),offset - 1); [start,start + min2(len(text) - start,count)]; } : {
            let start=fat-line-at(text,0,offset - 1);
            [start,fat-line-at(text,start,count)];
        };
        def fat-utf8-boundary?(text,at) = at>=len(text) || !(str_byte_at(text,at)>=128 && str_byte_at(text,at)<192);
        def fat-read-result(docs, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-ok(r[0], docs);
        // balance: a document's open-minus-close count of parens and of braces, "parens braces\n"; an edit that leaves
        // a form open reads a count its source did not, so a caller's check can hold the count the source had
        def fat-balance(docs, args, input) = len(args)>1 ? fat-fail("balance-needs-at-most-one-path",docs) : fat-input(docs,args,input,r=>fat-balance-result(docs,r));
        def fat-balance-result(docs, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-ok(fat-balance-text(r[0]), docs);
        def fat-balance-text(text) = (fat-balance-count(text, 0, len(text), FatByteOpen(), FatByteClose(), 0).str() + (" " + (fat-balance-count(text, 0, len(text), FatByteBraceOpen(), FatByteBraceClose(), 0).str() + "\n")));
        def fat-balance-count(text, i, n, open, close, d) = if (i >= n) then d else fat-balance-count(text, (i + 1), n, open, close, if ((Comparable) str_byte_at(text, i) == open) then (d + 1) else if ((Comparable) str_byte_at(text, i) == close) then (d - 1) else d);
        // arity: every call in a Form source whose head fkwu answers itself, read against the argument count the
        // reader demands (form-stdlib/fkwu-op-arity.fk, generated from runtime/fkwu-optable.h); one line per call
        // that would not compile, "" when every call is whole. Strings and ; comments are read as themselves, and a
        // defn's parameter list (a fn or lambda's too) is a list of names, never a call.
        def fat-arity(docs, args, input) = len(args)>1 ? fat-fail("arity-needs-at-most-one-path",docs) : len(args)==1 && !fat-fk-path?(args[0]) ? fat-fail("arity-reads-fk-sources",docs) : fat-input(docs,args,input,r=>fat-arity-result(docs,r));
        def fat-fk-path?(p) = ((len(p) > len(fat-fk-suffix())) && ((String) substring(p, (len(p) - len(fat-fk-suffix())), len(p)) == fat-fk-suffix()));
        // a source carrying a section [ block on a line of its own is BML surface, whatever its extension (the kernel
        // lowers it through the BML lane); rehearse-bml reads it, arity declines it
