            };
        };
        def fat-api-declaration(row) = json-node-object([json-node-pair("path",json-node-string(row[1])),json-node-pair("line",json-node-int(row[2])),json-node-pair("source_sha256",json-node-string(row[3])),json-node-pair("declaration",json-node-string(row[4])),json-node-pair("definition",json-node-string(row[5]))]);
        def fat-api-related(providers,current,name) {
            let dash=str_find(name,"-",0); let underscore=str_find(name,"_",0);
            let prefix=substring(name,0,min2(dash<0 ? len(name) : dash,underscore<0 ? len(name) : underscore));
