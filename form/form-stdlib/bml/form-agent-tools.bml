        def fat-bml-syntax(docs,args,input) = len(args)>1 ? fat-fail("bml-syntax-needs-at-most-one-path",docs) : fat-input(docs,args,input,r=>fat-bml-syntax-input(docs,r));
        def fat-bml-syntax-input(docs,r) = r[1] != "" ? fat-fail(r[1],docs) : fsc-find-section-open(r[0],0) < 0 ? fat-fail("bml-syntax-needs-executable-section",docs) : {
          kernel_stat(0); let start=kernel_stat(13);
          try {
            let parsed=form-source-compile-loop(r[0],"resident",0,nothing());
