            else if ((String) tool == "balance") then fat-balance(docs, args, input)
            else if ((String) tool == "arity") then fat-arity(docs, args, input)
            else if ((String) tool == "bml-syntax") then fat-bml-syntax(docs, args, input)
            else if ((String) tool == "bml-api") then fat-bml-api(docs,args,input)
