            let started=host_monotonic_ms(); let flow=host_pid().str();
            let reading=oh-reading("native-source",flow,"catalog",json-node-int(1),json-node-int(0),json-node-int(0),[oh-need("declared-source",json-node-string("requested source is outside resident documents"))],["resolve-imports"],json-node-object([oh-n("resident_documents",len(docs))]));
            oh-frame(reading);
            let observed=fat-source-catalog(docs,paths);
            let sources=append(docs,observed[0] |> filter(source=>!nothing?(source[1]) && nil?(fat-find-doc(docs,source[0]))) |> map(source=>[source[0],source[0],source[1]]));
            oh-frame(oh-set(oh-applied(reading,"resolve-imports",json-node-object([oh-n("source_reads",observed[1])])),"elapsed_ms",json-node-int(host_monotonic_ms() - started)));
            let available=all?(path=>far-path-present(sources,path),paths);
            oh-frame(oh-reading("native-source",flow,"catalog",json-node-int(1),json-node-int(available),json-node-int(available),available ? [] : [oh-need("source",json-node-string("requested source is absent from resident documents and their declared imports"))],[],json-node-object([oh-n("source_reads",observed[1])])));
            let result=fat-with-docs(consume(sources),docs);
