// The resident coding-agent workload, directly callable from form-cli.
// Existing sh-bi helpers below are pure Form functions. No shell AST is parsed
// or executed, and the file-reading sh-bi-cat branch is never called.
// preludes: form-stdlib/core.fk form-stdlib/tool-channel.fk form-stdlib/native-edit.fk form-stdlib/shell-exec.fk form-stdlib/bml/form-agent-search.bml form-stdlib/bml/form-agent-json-query.bml
// preludes: form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/fkwu-op-arity.fk
section [form.bml] {
    class FormAgentTools {
        field FatByteTab = 9;
        field FatByteLf = 10;
        field FatByteCr = 13;
        field FatByteSpace = 32;
        field FatByteQuote = 34;
        field FatByteOpen = 40;
        field FatByteClose = 41;
        field FatByteDash = 45;
        field FatByteSemi = 59;
        field FatByteSlash = 92;
        field FatByteBracket = 91;
        field FatByteN = 110;
        field FatByteR = 114;
        field FatByteT = 116;
        field FatByteBraceOpen = 123;
        field FatByteBraceClose = 125;
        field FatHeadTailLines = 10;
        field FatAwkLastField = 9;
        def fat-fk-suffix() = ".fk";
        def fat-bml-open() = "section [";
        def fat-tools() = append(tc-agent-tool-names(), ["balance", "arity"]);
        def fat-tool?(name) = fat-has(fat-tools(), name);
        def fat-input(docs, paths, input) = if nil?(paths) then [input, ""] else fat-input-files(docs, paths, "");
        def fat-input-files(docs, paths, out) = if nil?(paths) then [out, ""] else fat-input-doc(docs, paths, out, fat-find-doc(docs, head(paths)));
        def fat-input-doc(docs, paths, out, doc) = if nil?(doc) then ["", "resident-document-not-found"] else fat-input-files(docs, tail(paths), str_concat(out, doc[2]));
        def fat-call(docs, tool, args, input) =
            if ((len(docs) > FatMaxDocuments()) || ((len(args) > FatMaxArguments()) || ((str_len(input) > FatMaxBytes()) || ((fat-text-bytes(args, 0) > FatMaxBytes()) || (fat-doc-bytes(docs, 0) > FatMaxBytes()))))) then fat-fail("resident-input-limit", docs)
            else if (!(fat-text?(input) && (fat-text?(tool) && fat-docs-valid(docs, [])))) then fat-fail("invalid-resident-values", docs)
            else if (!fat-tool?(tool)) then fat-fail("unsupported-tool", docs)
            else fat-bounded(fat-dispatch(docs, tool, args, input), docs);
        def fat-bounded(result, docs) = if (str_len(fat-out(result)) > FatMaxBytes()) then fat-fail("output-limit", docs) else if ((len(fat-documents(result)) > FatMaxDocuments()) || (fat-doc-bytes(fat-documents(result), 0) > FatMaxBytes())) then fat-fail("resident-output-limit", docs) else if (!fat-docs-valid(fat-documents(result), [])) then fat-fail("invalid-resident-output", docs) else result;
        def fat-with-docs(result, docs) = fat-result(fat-exit(result), fat-out(result), fat-error(result), docs);
        def fat-dispatch(docs, tool, args, input) = if ((String) tool == "rg") then fat-with-docs(far-run-input(docs, args, input), docs)
            else if ((String) tool == "jq") then fat-jq(docs, args, input)
            else if ((String) tool == "edit") then fat-edit(docs, args)
            else if ((String) tool == "write") then fat-write(docs, args, input)
            else if (((String) tool == "read") || ((String) tool == "cat")) then fat-read(docs, args, input)
            else if (((String) tool == "head") || ((String) tool == "tail")) then fat-window(docs, tool, args, input, "lines", FatHeadTailLines())
            else if ((String) tool == "sed") then fat-sed(docs, args, input)
            else if ((String) tool == "tr") then fat-tr(docs, args, input)
            else if ((String) tool == "cut") then fat-cut(docs, args, input)
            else if ((String) tool == "awk") then fat-awk(docs, args, input)
            else if ((String) tool == "balance") then fat-balance(docs, args, input)
            else if ((String) tool == "arity") then fat-arity(docs, args, input)
            else fat-text-options(docs, tool, args, input, []);
        def fat-command(docs, command, input) = if (!fat-text?(command)) then fat-fail("invalid-command-value", docs) else if (str_len(command) > FatMaxBytes()) then fat-fail("command-limit", docs) else fat-command-argv(docs, input, fat-argv(command));
        def fat-command-argv(docs, input, parsed) = if (!((String) parsed[1] == "")) then fat-fail(parsed[1], docs) else if nil?(head(parsed)) then fat-fail("missing-tool", docs) else fat-call(docs, head(head(parsed)), tail(head(parsed)), input);
        def fat-read(docs, args, input) = fat-read-result(docs, fat-input(docs, args, input));
        def fat-read-result(docs, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-ok(head(r), docs);
        // balance: a document's open-minus-close count of parens and of braces, "parens braces\n"; an edit that leaves
        // a form open reads a count its source did not, so a caller's check can hold the count the source had
        def fat-balance(docs, args, input) = if (len(args) > 1) then fat-fail("balance-needs-at-most-one-path", docs) else fat-balance-result(docs, fat-input(docs, args, input));
        def fat-balance-result(docs, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-ok(fat-balance-text(head(r)), docs);
        def fat-balance-text(text) = str_concat(int_to_str(fat-balance-count(text, 0, str_len(text), FatByteOpen(), FatByteClose(), 0)), str_concat(" ", str_concat(int_to_str(fat-balance-count(text, 0, str_len(text), FatByteBraceOpen(), FatByteBraceClose(), 0)), "\n")));
        def fat-balance-count(text, i, n, open, close, d) = if (i >= n) then d else fat-balance-count(text, (i + 1), n, open, close, if ((Comparable) str_byte_at(text, i) == open) then (d + 1) else if ((Comparable) str_byte_at(text, i) == close) then (d - 1) else d);
        // arity: every call in a Form source whose head fkwu answers itself, read against the argument count the
        // reader demands (form-stdlib/fkwu-op-arity.fk, generated from runtime/fkwu-optable.h); one line per call
        // that would not compile, "" when every call is whole. Strings and ; comments are read as themselves, and a
        // defn's parameter list (a fn or lambda's too) is a list of names, never a call.
        def fat-arity(docs, args, input) = if (len(args) > 1) then fat-fail("arity-needs-at-most-one-path", docs) else if (((Comparable) len(args) == 1) && (!fat-fk-path?(head(args)))) then fat-fail("arity-reads-fk-sources", docs) else fat-arity-result(docs, fat-input(docs, args, input));
        def fat-fk-path?(p) = ((str_len(p) > str_len(fat-fk-suffix())) && ((String) substring(p, (str_len(p) - str_len(fat-fk-suffix())), str_len(p)) == fat-fk-suffix()));
        // a source carrying a section [ block on a line of its own is BML surface, whatever its extension (the kernel
        // lowers it through the BML lane); rehearse-bml reads it, arity declines it
        def fat-arity-result(docs, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else if fat-ar-bml-surface?(head(r)) then fat-fail("arity-reads-direct-source-not-bml-surface", docs) else fat-ok(fat-ar-text(head(r)), docs);
        def fat-ar-bml-surface?(t) = (((str_len(t) >= str_len(fat-bml-open())) && ((String) substring(t, 0, str_len(fat-bml-open())) == fat-bml-open())) || (str_find(t, str_concat("\n", fat-bml-open()), 0) >= 0));
        def fat-ar-text(t) = fat-ar-lines(t, reverse(fat-ar-forms(t, 0, str_len(t), [])[1]));
        def fat-ar-lines(t, found) = if nil?(found) then "" else str_concat(fat-ar-line-of(t, head(found)), fat-ar-lines(t, tail(found)));
        def fat-ar-line-of(t, f) = str_concat("line ", str_concat(int_to_str(fat-ar-line(t, 0, f[0], 1)), str_concat(": (", str_concat(f[1], str_concat(" ...) takes ", str_concat(int_to_str(f[2]), str_concat(", given ", str_concat(int_to_str(f[3]), "\n"))))))));
        def fat-ar-line(t, i, stop, line) = if (i >= stop) then line else fat-ar-line(t, (i + 1), stop, if ((Comparable) str_byte_at(t, i) == FatByteLf()) then (line + 1) else line);
        def fat-ar-space?(b) = (((Comparable) b == FatByteSpace()) || (((Comparable) b == FatByteTab()) || (((Comparable) b == FatByteLf()) || ((Comparable) b == FatByteCr()))));
        def fat-ar-delim?(b) = (fat-ar-space?(b) || (((Comparable) b == FatByteOpen()) || (((Comparable) b == FatByteClose()) || (((Comparable) b == FatByteSemi()) || ((Comparable) b == FatByteQuote())))));
        def fat-ar-eol(t, i, n) = if ((i >= n) || ((Comparable) str_byte_at(t, i) == FatByteLf())) then i else fat-ar-eol(t, (i + 1), n);
        def fat-ar-ws(t, i, n) = if (i >= n) then n else if fat-ar-space?(str_byte_at(t, i)) then fat-ar-ws(t, (i + 1), n) else if ((Comparable) str_byte_at(t, i) == FatByteSemi()) then fat-ar-ws(t, fat-ar-eol(t, i, n), n) else i;
        def fat-ar-atom-end(t, i, n) = if ((i >= n) || fat-ar-delim?(str_byte_at(t, i))) then i else fat-ar-atom-end(t, (i + 1), n);
        def fat-ar-str-end(t, i, n) = if (i >= n) then n else if ((Comparable) str_byte_at(t, i) == FatByteSlash()) then fat-ar-str-end(t, (i + 2), n) else if ((Comparable) str_byte_at(t, i) == FatByteQuote()) then (i + 1) else fat-ar-str-end(t, (i + 1), n);
        // the top level: every form in turn; answers (list end findings)
        def fat-ar-forms(t, i, n, acc) = fat-ar-forms-at(t, fat-ar-ws(t, i, n), n, acc);
        def fat-ar-forms-at(t, j, n, acc) = if (j >= n) then [n, acc] else fat-ar-forms-next(t, fat-ar-form(t, j, n, acc, 0), n);
        def fat-ar-forms-next(t, r, n) = fat-ar-forms(t, head(r), n, r[1]);
        // one form at i; quiet reads a list of names without checking it; answers (list end findings)
        def fat-ar-form(t, i, n, acc, quiet) = if ((Comparable) str_byte_at(t, i) == FatByteOpen()) then fat-ar-list(t, fat-ar-ws(t, (i + 1), n), n, acc, i, quiet) else if ((Comparable) str_byte_at(t, i) == FatByteQuote()) then [fat-ar-str-end(t, (i + 1), n), acc] else if ((Comparable) str_byte_at(t, i) == FatByteClose()) then [(i + 1), acc] else [fat-ar-atom-end(t, i, n), acc];
        def fat-ar-list(t, j, n, acc, open, quiet) = if (j >= n) then [n, acc] else if ((Comparable) str_byte_at(t, j) == FatByteClose()) then [(j + 1), acc] else if (((Comparable) str_byte_at(t, j) == FatByteOpen()) || ((Comparable) str_byte_at(t, j) == FatByteQuote())) then fat-ar-args-from(t, fat-ar-form(t, j, n, acc, quiet), n, "", open, quiet) else fat-ar-headed(t, substring(t, j, fat-ar-atom-end(t, j, n)), fat-ar-args(t, fat-ar-atom-end(t, j, n), n, acc, 0, quiet, substring(t, j, fat-ar-atom-end(t, j, n))), open, quiet);
        def fat-ar-args-from(t, r, n, name, open, quiet) = fat-ar-close(fat-ar-args(t, head(r), n, r[1], 0, quiet, name));
        def fat-ar-close(r) = [head(r), r[1]];
        // a call with a head: its arguments read, then its count held to the table
        // a negative arity in the table is a variadic head (list, append ...): any count stands
        def fat-ar-headed(t, name, r, open, quiet) = if (((Comparable) quiet == 1) || (nothing?(fkwu-op-arity(name)) || ((fkwu-op-arity(name) < 0) || ((Comparable) fkwu-op-arity(name) == r[2])))) then [head(r), r[1]] else [head(r), cons([open, name, fkwu-op-arity(name), r[2]], r[1])];
        def fat-ar-names?(name, count) = ((((String) name == "defn") && ((Comparable) count == 1)) || ((((String) name == "fn") || ((String) name == "lambda")) && ((Comparable) count == 0)));
        // the arguments of one list; answers (list end findings count)
        def fat-ar-args(t, i, n, acc, count, quiet, name) = fat-ar-args-at(t, fat-ar-ws(t, i, n), n, acc, count, quiet, name);
        def fat-ar-args-at(t, j, n, acc, count, quiet, name) = if (j >= n) then [n, acc, count] else if ((Comparable) str_byte_at(t, j) == FatByteClose()) then [(j + 1), acc, count] else fat-ar-args-next(t, fat-ar-form(t, j, n, acc, if fat-ar-names?(name, count) then 1 else quiet), n, count, quiet, name);
        def fat-ar-args-next(t, r, n, count, quiet, name) = fat-ar-args(t, head(r), n, r[1], (count + 1), quiet, name);
        def fat-edit-guidance() = "Existing documents require edit: arguments [path,exact unique old text,new text]. For several focused changes, use [path,old1,new1,old2,new2,...]; literal replacements run in order, each old text must match exactly once at its step, and any failure rolls back the whole call. Guard a literal batch with [path,resident_sha256,old1,new1,old2,new2,...]; the hash checks the initial document once before the same atomic edits. For a whole-document replacement use [path,\"sha256\",expected resident_sha256,new whole-document text]. The shorter [path,resident_sha256,new whole-document text] also works when the hash has no literal match and equals the current document identity. Literal matches keep their text-edit meaning. Obtain resident_sha256 from the current document, successful mutation result, read, cat or guard_evidence. An edit changes that identity; use the new resident_sha256 for the next edit. write only creates an absent path; it cannot overwrite an existing document. ";
        def fat-document-sha(doc) = hex-encode(sha256-stream-string(doc[2]));
        def fat-sha-bytes?(text,at) = if (at >= str_len(text)) then 1 else ((str_find(hex-alphabet(),substring(text,at,(at + 1)),0) >= 0) && fat-sha-bytes?(text,(at + 1)));
        def fat-sha?(text) = (((Comparable) str_len(text) == 64) && fat-sha-bytes?(text,0));
        def fat-edit-batch?(args) = ((len(args) >= 5) && ((Comparable) (len(args) % 2) == 1));
        def fat-edit-guarded-batch?(args) = (len(args) >= 4) && ((len(args) % 2) == 0) && fat-sha?(args[1]);
        def fat-edit(docs, args) = if fat-edit-guarded-batch?(args) then fat-edit-guarded(docs,head(args),args[1],doc => fat-edit-batch(docs,docs,head(args),fat-drop(args,2),1)) else if ((Comparable) len(args) == 4) then fat-edit-sha(docs,args) else if fat-edit-batch?(args) then fat-edit-batch(docs,docs,head(args),tail(args),1) else if (!((Comparable) len(args) == 3)) then fat-fail("edit-needs-path-old-new", docs) else if ((String) args[1] == "") then fat-fail("empty-edit-pattern", docs) else fat-edit-doc(docs, args, fat-find-doc(docs, head(args)));
        // Intermediate documents stay local to this call. A later failure
        // returns the original set, including when an earlier step succeeded.
        def fat-edit-batch(original,docs,path,pairs,step) = if nil?(pairs) then
            if ((Value) original == docs) then fat-fail("edit-unchanged: old and new text are identical; no source changed",original) else fat-ok("edited\n",docs)
            else {
                let result = fat-edit-literal(docs,[path,head(pairs),pairs[1]],fat-find-doc(docs,path));
                if ((Comparable) fat-exit(result) == 0) then fat-edit-batch(original,fat-documents(result),path,fat-drop(pairs,2),(step + 1))
                else fat-result(fat-exit(result),json-emit(json-node-object([json-node-pair("failed_edit",json-node-int(step)),json-node-pair("documents_changed",json-node-int(0)),json-node-pair("scope",json-node-string("The numbered literal replacement failed against the intermediate text; all replacements in this call were rolled back."))])),fat-error(result),original);
            };
        def fat-edit-literal(docs,args,doc) = if ((String) args[1] == "") then fat-fail("empty-edit-pattern",docs)
            else if nil?(doc) then fat-fail("resident-document-not-found",docs)
            else {
                let count = ne-count(doc[2],args[1]);
                if ((Comparable) count == 0) then fat-fail("edit-not-found",docs) else fat-edit-count(docs,args,doc,count);
            };
        def fat-edit-guarded(docs,path,digest,apply) = !fat-sha?(digest) ? fat-fail("edit-invalid-sha256",docs) : {
            let doc=fat-find-doc(docs,path);
            nil?(doc) ? fat-fail("resident-document-not-found",docs) : ((String) digest != fat-document-sha(doc)) ? fat-fail("edit-sha256-mismatch",docs) : apply(doc);
        };
        def fat-edit-sha(docs,args) = ((String) args[1] != "sha256") ? fat-fail("edit-needs-path-sha256-digest-new-text",docs) : fat-edit-guarded(docs,head(args),args[2],doc => ((String) doc[2] == args[3]) ? fat-fail("edit-unchanged: old and new text are identical; no source changed",docs) : fat-ok("edited\n",fat-put-doc(docs,[head(doc),doc[1],args[3]])));
        def fat-edit-doc(docs, args, doc) = if nil?(doc) then fat-fail("resident-document-not-found", docs) else fat-edit-count(docs, args, doc, ne-count(doc[2], args[1]));
        def fat-edit-count(docs, args, doc, count) = if ((Comparable) count == 0) then fat-edit-identity(docs,args,doc) else if (!((Comparable) count == 1)) then fat-fail("edit-ambiguous", docs) else if ((String) args[1] == args[2]) then fat-fail("edit-unchanged: old and new text are identical; no source changed",docs) else fat-ok("edited\n", fat-put-doc(docs, [doc[0], doc[1], ne-replace-first(doc[2], args[1], args[2])]));
        // A missing literal may name the complete current document instead.
        // Existing literal matches and ambiguous edits retain their meaning.
        def fat-edit-identity(docs,args,doc) = if (!(fat-sha?(args[1]) && ((String) args[1] == fat-document-sha(doc)))) then fat-fail("edit-not-found",docs) else fat-edit-sha(docs,[head(args),"sha256",args[1],args[2]]);
        def fat-write(docs, args, input) = if (!(((Comparable) len(args) == 1) || ((Comparable) len(args) == 2))) then fat-fail("write-needs-new-path-and-text", docs) else if ((String) head(args) == "") then fat-fail("empty-document-path", docs) else if (!nil?(fat-find-doc(docs, head(args)))) then fat-fail("document-exists-use-guarded-edit", docs) else fat-ok("created\n", append(docs, [[str_concat("resident:", head(args)), head(args), if ((Comparable) len(args) == 2) then args[1] else input]]));

        // Private tool evidence, derived from the same resident documents the
        // guard inspected. Error codes and mutation authority stay unchanged.
        def fat-guard-prefix(a,b,at) = if ((at >= str_len(a)) || (at >= str_len(b))) then at else if (!((Comparable) fat-char(a,at) == fat-char(b,at))) then at else fat-guard-prefix(a,b,(at + 1));
        def fat-guard-byte(text,at) = if (at >= str_len(text)) then json-node-null() else json-node-int(fat-char(text,at));
        def fat-guard-comparison(source,old) {
            let at = fat-guard-prefix(source,old,0);
            let start = fat-max(0,(at - 32));
            json-node-object([json-node-pair("scope",json-node-string("old argument compared with the whole resident document at equal byte offsets; no approximate match or edit")),json-node-pair("first_difference_byte",if ((String) source == old) then json-node-null() else json-node-int(at)),json-node-pair("old_byte",fat-guard-byte(old,at)),json-node-pair("resident_byte",fat-guard-byte(source,at)),json-node-pair("context_start_byte",json-node-int(start)),json-node-pair("old_context",json-node-string(substring(old,start,fat-min(str_len(old),(at + 48))))),json-node-pair("resident_context",json-node-string(substring(source,start,fat-min(str_len(source),(at + 48)))))]);
        }
        def fat-guard-evidence(docs,tool,args,result) = if (nil?(args) || (!fat-has(["edit-not-found","edit-ambiguous","document-exists-use-guarded-edit","edit-sha256-mismatch"],fat-error(result)))) then nothing() else {
            let doc = fat-find-doc(docs,head(args));
            if (nil?(doc) || (!((((String) tool == "edit") && (((Comparable) len(args) == 3) || (((Comparable) len(args) == 4) || fat-edit-guarded-batch?(args)))) || ((String) tool == "write")))) then nothing() else {
                let source = doc[2];
                let base = [json-node-pair("scope",json-node-string("caller-supplied resident documents; tools do not write the filesystem")),json-node-pair("path",json-node-string(doc[1])),json-node-pair("documents_changed",json-node-int((!((Value) docs == fat-documents(result))))),json-node-pair("resident_bytes",json-node-int(str_len(source))),json-node-pair("resident_sha256",json-node-string(fat-document-sha(doc))),json-node-pair("next",json-node-string(fat-edit-guidance()))];
                json-node-object(append(base,if ((String) tool == "write") then [] else if (fat-edit-guarded-batch?(args) || ((Comparable) len(args) == 4)) then [json-node-pair("expected_sha256",json-node-string(args[if fat-edit-guarded-batch?(args) then 1 else 2]))] else [json-node-pair("exact_matches",json-node-int(ne-count(source,args[1]))),json-node-pair("old_bytes",json-node-int(str_len(args[1]))),json-node-pair("whole_document_comparison",fat-guard-comparison(source,args[1]))]));
            };
        };

        def fat-window(docs, tool, args, input, unit, amount) = if nil?(args) then fat-window-input(docs, tool, unit, amount, [input, ""]) else if fat-has(["-n", "-c"], head(args)) then if ((len(args) < 2) || (!fat-natural(args[1]))) then fat-fail("window-needs-nonnegative-count", docs) else fat-window(docs, tool, fat-drop(args, 2), input, if ((String) head(args) == "-c") then "bytes" else "lines", str_to_int(args[1])) else if fat-starts(head(args), "-") then fat-fail("unsupported-window-option", docs) else fat-window-input(docs, tool, unit, amount, fat-input(docs, args, input));
        def fat-window-input(docs, tool, unit, amount, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else if ((String) unit == "bytes") then fat-ok(if ((String) tool == "head") then substring(head(r), 0, fat-min(amount, str_len(head(r)))) else substring(head(r), fat-max(0, (str_len(head(r)) - amount)), str_len(head(r))), docs) else fat-ok(fat-line-window(head(r), if ((String) tool == "head") then 0 else fat-max(0, (len(sh-lines(head(r))) - amount)), amount), docs);
        def fat-line-window(s, start, count) = fat-window-join(fat-take(fat-drop(sh-lines(s), start), count), ((str_len(s) > 0) && ((Comparable) fat-char(s, (str_len(s) - 1)) == FatByteLf())), ((start + count) >= len(sh-lines(s))));
        def fat-window-join(lines, finalNewline, reachesEnd) = if nil?(lines) then "" else str_concat(fat-join(lines, "\n"), if (finalNewline || (!reachesEnd)) then "\n" else "");
        def fat-sed(docs, args, input) = if (len(args) < 2) then fat-fail("sed-supports-only-numeric-print-range", docs) else if (!((String) head(args) == "-n")) then fat-fail("sed-supports-only-numeric-print-range", docs) else if (!fat-ends(args[1], "p")) then fat-fail("sed-supports-only-numeric-print-range", docs) else fat-sed-range(docs, fat-drop(args, 2), input, split-on(substring(args[1], 0, (str_len(args[1]) - 1)), ","));
        def fat-sed-range(docs, paths, input, range) = if ((!(((Comparable) len(range) == 1) || ((Comparable) len(range) == 2))) || (!fat-natural(head(range)))) then fat-fail("invalid-print-range", docs) else if (((Comparable) len(range) == 2) && (!fat-natural(range[1]))) then fat-fail("invalid-print-range", docs) else fat-sed-ready(docs, str_to_int(head(range)), if ((Comparable) len(range) == 2) then str_to_int(range[1]) else str_to_int(head(range)), fat-input(docs, paths, input));
        def fat-sed-ready(docs, first, last, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else if ((first <= 0) || (last < first)) then fat-fail("invalid-print-range", docs) else fat-ok(fat-line-window(head(r), (first - 1), ((last - first) + 1)), docs);
        def fat-text-options(docs, tool, args, input, flags) = if nil?(args) then fat-text-ready(docs, tool, flags, [input, ""]) else if fat-starts(head(args), "-") then if fat-valid-text-flag(tool, head(args)) then fat-text-options(docs, tool, tail(args), input, cons(head(args), flags)) else fat-fail("unsupported-text-option", docs) else fat-text-ready(docs, tool, flags, fat-input(docs, args, input));
        def fat-valid-text-flag(tool, flag) = if ((String) tool == "wc") then fat-has(["-l", "-w", "-c", "-lw", "-lc", "-wc", "-lwc"], flag) else if ((String) tool == "sort") then fat-has(["-r", "-u", "-n", "-rn", "-nr", "-ru", "-ur", "-nu", "-un", "-nru"], flag) else if ((String) tool == "uniq") then fat-has(["-c", "-d", "-u"], flag) else 0;
        def fat-flag(flags, letter) = (str_find(fat-join(flags, ""), letter, 0) >= 0);
        def fat-text-ready(docs, tool, flags, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else if ((String) tool == "wc") then fat-ok(str_concat(fat-join(fat-counts(head(r), flags), " "), "\n"), docs) else if ((String) tool == "sort") then fat-sort-ready(docs, sh-lines(head(r)), flags) else fat-ok(fat-uniq-lines(sh-lines(head(r)), flags), docs);
        def fat-sort-ready(docs, lines, flags) = if (len(lines) > FatMaxSortItems()) then fat-fail("sort-item-limit", docs) else if (fat-flag(flags, "n") && (!fat-numeric-lines(lines))) then fat-fail("numeric-sort-needs-number-lines", docs) else fat-ok(sh-join-nl(fat-sort-lines(lines, flags)), docs);
        def fat-numeric-lines(lines) = if nil?(lines) then 1 else (faj-valid-end(fat-trim(head(lines)), faj-number(fat-trim(head(lines)), 0)) && fat-numeric-lines(tail(lines)));
        def fat-counts(s, flags) = append(if (nil?(flags) || fat-flag(flags, "l")) then [int_to_str(ne-count(s, "\n"))] else [], append(if (nil?(flags) || fat-flag(flags, "w")) then [int_to_str(sh-count-words(s))] else [], if (nil?(flags) || fat-flag(flags, "c")) then [int_to_str(str_len(s))] else []));
        def fat-num-insert(x, xs) = if nil?(xs) then [x] else if (str_to_float(x) <= str_to_float(head(xs))) then cons(x, xs) else cons(head(xs), fat-num-insert(x, tail(xs)));
        def fat-num-sort(xs) = if nil?(xs) then [] else fat-num-insert(head(xs), fat-num-sort(tail(xs)));
        def fat-sort-lines(lines, flags) = fat-sort-final(if fat-flag(flags, "n") then fat-num-sort(lines) else sh-sort(lines), flags);
        def fat-sort-final(lines, flags) = if fat-flag(flags, "r") then fat-reverse(fat-sort-unique(lines, flags)) else fat-sort-unique(lines, flags);
        def fat-sort-unique(lines, flags) = if (!fat-flag(flags, "u")) then lines else if fat-flag(flags, "n") then fat-num-unique(lines) else sh-uniq(lines);
        def fat-num-unique(lines) = if nil?(lines) then [] else cons(head(lines), fat-num-unique(fat-num-drop(tail(lines), str_to_float(head(lines)))));
        def fat-num-drop(lines, n) = if nil?(lines) then lines else if ((Comparable) str_to_float(head(lines)) == n) then fat-num-drop(tail(lines), n) else lines;
        def fat-uniq-lines(lines, flags) = if nil?(lines) then "" else fat-uniq-group(tail(lines), head(lines), 1, flags);
        def fat-uniq-group(rest, line, count, flags) = if nil?(rest) then fat-uniq-emit(line, count, flags) else if ((String) head(rest) == line) then fat-uniq-group(tail(rest), line, (count + 1), flags) else str_concat(fat-uniq-emit(line, count, flags), fat-uniq-lines(rest, flags));
        def fat-uniq-emit(line, count, flags) = if ((fat-flag(flags, "d") && ((Comparable) count == 1)) || (fat-flag(flags, "u") && (count > 1))) then "" else str_concat(if fat-flag(flags, "c") then str_concat(int_to_str(count), " ") else "", str_concat(line, "\n"));
        def fat-tr(docs, args, input) = if (!((Comparable) len(args) == 2)) then fat-fail("tr-needs-two-literal-sets", docs) else fat-tr-sets(docs, input, ((String) head(args) == "-d"), if ((String) head(args) == "-d") then ["", ""] else fat-tr-set(head(args), 0, ""), fat-tr-set(args[1], 0, ""));
        def fat-tr-set(s, i, out) = if (i >= str_len(s)) then [out, ""] else if ((Comparable) fat-char(s, i) == FatByteSlash()) then fat-tr-escape(s, i, out) else if (((Comparable) fat-char(s, i) == FatByteDash()) || ((Comparable) fat-char(s, i) == FatByteBracket())) then ["", "tr-ranges-not-supported"] else fat-tr-set(s, (i + 1), str_concat(out, byte_to_str(fat-char(s, i))));
        def fat-tr-escape(s, i, out) = if (!fat-has(["n", "r", "t", "\\"], byte_to_str(fat-char(s, (i + 1))))) then ["", "unsupported-tr-escape"] else fat-tr-set(s, (i + 2), str_concat(out, byte_to_str(if ((Comparable) fat-char(s, (i + 1)) == FatByteN()) then FatByteLf() else if ((Comparable) fat-char(s, (i + 1)) == FatByteR()) then FatByteCr() else if ((Comparable) fat-char(s, (i + 1)) == FatByteT()) then FatByteTab() else FatByteSlash())));
        def fat-tr-sets(docs, input, remove, from, to) = if (!((String) from[1] == "")) then fat-fail(from[1], docs) else if (!((String) to[1] == "")) then fat-fail(to[1], docs) else if remove then fat-ok(fat-delete-chars(input, head(to), 0), docs) else if (!((Comparable) str_len(head(from)) == str_len(head(to)))) then fat-fail("tr-supports-equal-length-literal-sets", docs) else fat-ok(sh-tr-str(input, head(from), head(to)), docs);
        def fat-delete-chars(s, chars, i) = if (i >= str_len(s)) then "" else str_concat(if (str_find(chars, byte_to_str(fat-char(s, i)), 0) >= 0) then "" else byte_to_str(fat-char(s, i)), fat-delete-chars(s, chars, (i + 1)));
        def fat-cut(docs, args, input) = if ((len(args) < 4) || ((!((String) head(args) == "-d")) || (!((String) args[2] == "-f")))) then fat-fail("cut-needs-d-delimiter-f-field", docs) else if ((!((Comparable) str_len(args[1]) == 1)) || (!fat-natural(args[3]))) then fat-fail("invalid-cut-field", docs) else if (str_to_int(args[3]) <= 0) then fat-fail("invalid-cut-field", docs) else fat-cut-ready(docs, args[1], str_to_int(args[3]), fat-input(docs, fat-drop(args, 4), input));
        def fat-cut-ready(docs, delimiter, field, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-ok(fat-cut-lines(sh-lines(head(r)), delimiter, field), docs);
        def fat-cut-lines(lines, delimiter, field) = if nil?(lines) then "" else str_concat(fat-cut-line(head(lines), delimiter, field), str_concat("\n", fat-cut-lines(tail(lines), delimiter, field)));
        def fat-cut-line(line, delimiter, field) = if (str_find(line, delimiter, 0) < 0) then line else if (len(split-on(line, delimiter)) < field) then "" else split-on(line, delimiter)[(field - 1)];
        def fat-awk-valid(program) = fat-awk-print(program, 0);
        def fat-awk-print(program, field) = if (field > FatAwkLastField()) then 0 else if ((String) fat-trim(program) == str_concat("{print $", str_concat(int_to_str(field), "}"))) then 1 else fat-awk-print(program, (field + 1));
        def fat-awk(docs, args, input) = if nil?(args) then fat-fail("awk-needs-program", docs) else if (!fat-awk-valid(head(args))) then fat-fail("awk-supports-single-field-print", docs) else fat-awk-ready(docs, head(args), fat-input(docs, tail(args), input));
        def fat-awk-ready(docs, program, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-ok(head(sh-bi-awk([program], head(r))), docs);

        def fat-jq(docs, args, input) = fat-jq-args(docs, args, input, []);
        def fat-jq-args(docs, args, input, options) = if nil?(args) then fat-fail("jq-needs-filter", docs) else if (((String) head(args) == "--arg") || ((String) head(args) == "--argjson")) then fat-jq-bind(docs, args, input, options) else if fat-starts(head(args), "-") then fat-jq-flags(docs, args, input, options, 1) else fat-jq-compiled(docs, options, tail(args), input, faj-compile(head(args)));
        def fat-jq-flags(docs, args, input, options, i) = if (i >= str_len(head(args))) then if ((Comparable) i == 1) then fat-fail("unsupported-jq-option", docs) else fat-jq-args(docs, tail(args), input, options) else if fat-has(["r", "c", "e", "s", "n"], byte_to_str(fat-char(head(args), i))) then fat-jq-flags(docs, args, input, far-set(options, byte_to_str(fat-char(head(args), i)), 1), (i + 1)) else fat-fail("unsupported-jq-option", docs);
        def fat-jq-bind(docs, args, input, options) = if (len(args) < 3) then fat-fail("jq-binding-needs-name-value", docs) else if (!faj-name(args[1])) then fat-fail("invalid-jq-variable-name", docs) else if (((String) head(args) == "--argjson") && (!faj-valid(args[2]))) then fat-fail("invalid-json-binding", docs) else fat-jq-args(docs, fat-drop(args, 3), input, far-push(options, "vars", [args[1], if ((String) head(args) == "--argjson") then faj-json("resident-variable", args[2]) else intern_trivial_string(args[2])]));
        def fat-jq-compiled(docs, options, paths, input, compiled) = if (!((String) compiled[1] == "")) then fat-fail(compiled[1], docs) else if (!faj-bound(head(compiled), far-get(options, "vars", []))) then fat-fail("unbound-variable", docs) else fat-jq-input(docs, options, head(compiled), if far-get(options, "n", 0) then ["null", ""] else if nil?(paths) then [input, ""] else fat-json-files(docs, paths, ""));
        def fat-json-files(docs, paths, out) = if nil?(paths) then [out, ""] else fat-json-file(docs, paths, out, fat-find-doc(docs, head(paths)));
        def fat-json-file(docs, paths, out, doc) = if nil?(doc) then ["", "resident-document-not-found"] else fat-json-files(docs, tail(paths), str_concat(out, str_concat(doc[2], "\n")));
        def fat-jq-input(docs, options, ast, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-jq-parsed(docs, options, ast, fat-json-stream(head(r), 0, []));
        def fat-json-stream(s, at, out) = if (fat-skip(s, at) >= str_len(s)) then faj-values(fat-reverse(out)) else fat-json-value(s, fat-skip(s, at), out, faj-end(s, at, 0));
        def fat-json-value(s, start, out, end) = if (end <= start) then faj-bad("invalid-json-input") else if ((end < str_len(s)) && (!fat-ws(fat-char(s, end)))) then faj-bad("invalid-json-input") else fat-json-stream(s, end, cons(faj-json("resident-json-input", substring(s, start, end)), out));
        def fat-jq-parsed(docs, options, ast, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-jq-evaluated(docs, options, faj-each(ast, if far-get(options, "s", 0) then [faj-array(head(r))] else head(r), far-get(options, "vars", [])));
        def fat-jq-evaluated(docs, options, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-result(if far-get(options, "e", 0) then if nil?(head(r)) then 4 else if faj-truth(head(fat-reverse(head(r)))) then 0 else 1 else 0, faj-render(head(r), far-get(options, "r", 0)), "", docs);
    }
}
