                if nothing?(reading) then 0 else record_set(current,path,append(reading[0:4],[dependencies]));
                fat-source-providers(append(rest,dependencies),prior,current,append(found,[source]),reads+pending[2],paths);
            };
        };
        def fat-api-source(path,text,names,prior,current) = nothing?(text) ? [] : {
            let reading=fat-api-reading(path,text,prior,current);
            let definitions=reading[2] ?? sa-cached-file(path,text)[4];
            record_set(current,path,append([text,reading[1],definitions,reading[3]],reading[4:]));
            let matches=definitions |> filter(row => fat-has(names,row[0]));
