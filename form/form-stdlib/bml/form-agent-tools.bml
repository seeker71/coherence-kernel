// The resident coding-agent workload, directly callable from form-cli.
// Existing sh-bi helpers below are pure Form functions. No shell AST is parsed
// or executed, and the file-reading sh-bi-cat branch is never called.
import form-stdlib/core.fk;
import form-stdlib/tool-channel.fk;
import form-stdlib/native-edit.fk;
import form-stdlib/shell-exec.fk;
import form-stdlib/bml/form-agent-search.bml;
import form-stdlib/bml/form-agent-grep.bml;
import form-stdlib/bml/form-agent-json-query.bml;
import form-stdlib/bml/form-agent-edit-ladder.bml;
import form-stdlib/sha256.fk;
import form-stdlib/hex.fk;
