import form-stdlib/source-compiler.fk;
import form-stdlib/bml/source-abstraction.bml;
import form-stdlib/organ-health.bml;
section [form.bml] {
    class FormAgentTools {
        field FatByteTab = 9;
        field FatByteLf = 10;
        field FatByteCr = 13;
        field FatByteSpace = 32;
        field FatByteQuote = 34;
        field FatByteOpen = 40;
        field FatByteClose = 41;
        field FatByteDash = 45;
        field FatByteSemi = 59;
        field FatByteSlash = 92;
        field FatByteBracket = 91;
        field FatByteN = 110;
        field FatByteR = 114;
        field FatByteT = 116;
        field FatByteBraceOpen = 123;
        field FatByteBraceClose = 125;
        field FatHeadTailLines = 10;
        def fat-fk-suffix() = ".fk";
        def fat-tools() = append(tc-agent-tool-names(), ["balance", "arity", "bml-syntax", "bml-api"]);
        def fat-tool?(name) = fat-has(fat-tools(), name);
        def fat-readonly(name) = fat-tool?(name) && !fat-has(["edit","write"],name);
        def fat-input(docs, paths, input, consume) = nil?(paths) ? consume([input, ""]) : fat-source(docs,paths,sources=>consume(fat-input-files(sources,paths,"")));
        def fat-input-files(docs, paths, out) = if nil?(paths) then [out, ""] else fat-input-doc(docs, paths, out, fat-find-doc(docs, paths[0]));
        def fat-input-doc(docs, paths, out, doc) = if nil?(doc) then ["", "resident-document-not-found"] else fat-input-files(docs, paths[1:], ((String) out + doc[2]));
        def fat-call(docs, tool, args, input) {
            let started=host_monotonic_ms();
            let result=if (!(fat-text?(input) && fat-text?(tool) && value_kind(args)=="list" && all?(fat-text?,args) && fat-docs-valid(docs, []))) then fat-fail("invalid-resident-values", docs)
            else if (!fat-tool?(tool)) then fat-fail("unsupported-tool", docs)
