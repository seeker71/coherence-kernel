        def fat-source-route(path,paths,prior,seen) = fat-has(paths,path) ? 1 : fat-has(seen,path) || !record_has(prior,path) ? 0 : {
            let reading=record_get(prior,path);
            len(reading)<5 ? 0 : any?(source=>fat-source-route(source[0],paths,prior,cons(path,seen)),reading[4]);
        };
        def fat-source-providers(todo,prior,current,found,reads,paths) = nil?(todo) || fat-source-complete(found,paths) ? [found,reads] : {
            let requested=nil?(paths) ? [] : todo |> filter(source=>fat-source-route(source[0],paths,prior,[]));
            let pending=nil?(requested) ? todo[0] : requested[0]; let path=pending[0];
            let rest=path==todo[0][0] ? todo[1:] : todo |> filter(source=>source[0] != path);
