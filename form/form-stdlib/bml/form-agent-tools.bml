// The resident coding-agent workload, directly callable from form-cli.
// Existing sh-bi helpers below are pure Form functions. No shell AST is parsed
// or executed, and the file-reading sh-bi-cat branch is never called.
// preludes: form-stdlib/core.fk form-stdlib/tool-channel.fk form-stdlib/native-edit.fk form-stdlib/shell-exec.fk form-stdlib/bml/form-agent-search.bml form-stdlib/bml/form-agent-json-query.bml
section [form.bml] {
    class FormAgentTools {
        def fat-tools() = tc-agent-tool-names();
        def fat-tool?(name) = fat-has(fat-tools(), name);
        def fat-input(docs, paths, input) = if nil?(paths) then list(input, "") else fat-input-files(docs, paths, "");
        def fat-input-files(docs, paths, out) = if nil?(paths) then list(out, "") else fat-input-doc(docs, paths, out, fat-find-doc(docs, head(paths)));
        def fat-input-doc(docs, paths, out, doc) = if nil?(doc) then list("", "resident-document-not-found") else fat-input-files(docs, tail(paths), str_concat(out, nth(doc, 2)));
        def fat-call(docs, tool, args, input) =
            if or(gt(len(docs), FatMaxDocuments()), or(gt(len(args), FatMaxArguments()), or(gt(str_len(input), FatMaxBytes()), or(gt(fat-text-bytes(args, 0), FatMaxBytes()), gt(fat-doc-bytes(docs, 0), FatMaxBytes()))))) then fat-fail("resident-input-limit", docs)
            else if not(and(fat-text?(input), and(fat-text?(tool), fat-docs-valid(docs, list())))) then fat-fail("invalid-resident-values", docs)
            else if not(fat-tool?(tool)) then fat-fail("unsupported-tool", docs)
            else fat-bounded(fat-dispatch(docs, tool, args, input), docs);
        def fat-bounded(result, docs) = if gt(str_len(fat-out(result)), FatMaxBytes()) then fat-fail("output-limit", docs) else if or(gt(len(fat-documents(result)), FatMaxDocuments()), gt(fat-doc-bytes(fat-documents(result), 0), FatMaxBytes())) then fat-fail("resident-output-limit", docs) else if not(fat-docs-valid(fat-documents(result), list())) then fat-fail("invalid-resident-output", docs) else result;
        def fat-with-docs(result, docs) = fat-result(fat-exit(result), fat-out(result), fat-error(result), docs);
        def fat-dispatch(docs, tool, args, input) = if str_eq(tool, "rg") then fat-with-docs(far-run-input(docs, args, input), docs)
            else if str_eq(tool, "jq") then fat-jq(docs, args, input)
            else if str_eq(tool, "edit") then fat-edit(docs, args)
            else if str_eq(tool, "write") then fat-write(docs, args, input)
            else if or(str_eq(tool, "read"), str_eq(tool, "cat")) then fat-read(docs, args, input)
            else if or(str_eq(tool, "head"), str_eq(tool, "tail")) then fat-window(docs, tool, args, input, "lines", 10)
            else if str_eq(tool, "sed") then fat-sed(docs, args, input)
            else if str_eq(tool, "tr") then fat-tr(docs, args, input)
            else if str_eq(tool, "cut") then fat-cut(docs, args, input)
            else if str_eq(tool, "awk") then fat-awk(docs, args, input)
            else fat-text-options(docs, tool, args, input, list());
        def fat-command(docs, command, input) = if not(fat-text?(command)) then fat-fail("invalid-command-value", docs) else if gt(str_len(command), FatMaxBytes()) then fat-fail("command-limit", docs) else fat-command-argv(docs, input, fat-argv(command));
        def fat-command-argv(docs, input, parsed) = if not(str_eq(nth(parsed, 1), "")) then fat-fail(nth(parsed, 1), docs) else if nil?(head(parsed)) then fat-fail("missing-tool", docs) else fat-call(docs, head(head(parsed)), tail(head(parsed)), input);
        def fat-read(docs, args, input) = fat-read-result(docs, fat-input(docs, args, input));
        def fat-read-result(docs, r) = if not(str_eq(nth(r, 1), "")) then fat-fail(nth(r, 1), docs) else fat-ok(head(r), docs);
        def fat-edit(docs, args) = if not(eq(len(args), 3)) then fat-fail("edit-needs-path-old-new", docs) else if str_eq(nth(args, 1), "") then fat-fail("empty-edit-pattern", docs) else fat-edit-doc(docs, args, fat-find-doc(docs, head(args)));
        def fat-edit-doc(docs, args, doc) = if nil?(doc) then fat-fail("resident-document-not-found", docs) else fat-edit-count(docs, args, doc, ne-count(nth(doc, 2), nth(args, 1)));
        def fat-edit-count(docs, args, doc, count) = if eq(count, 0) then fat-fail("edit-not-found", docs) else if not(eq(count, 1)) then fat-fail("edit-ambiguous", docs) else fat-ok("edited\n", fat-put-doc(docs, list(nth(doc, 0), nth(doc, 1), ne-replace-first(nth(doc, 2), nth(args, 1), nth(args, 2)))));
        def fat-write(docs, args, input) = if not(or(eq(len(args), 1), eq(len(args), 2))) then fat-fail("write-needs-new-path-and-text", docs) else if str_eq(head(args), "") then fat-fail("empty-document-path", docs) else if not(nil?(fat-find-doc(docs, head(args)))) then fat-fail("document-exists-use-guarded-edit", docs) else fat-ok("created\n", append(docs, list(list(str_concat("resident:", head(args)), head(args), if eq(len(args), 2) then nth(args, 1) else input))));

        def fat-window(docs, tool, args, input, unit, amount) = if nil?(args) then fat-window-input(docs, tool, unit, amount, list(input, "")) else if fat-has(list("-n", "-c"), head(args)) then if or(lt(len(args), 2), not(fat-natural(nth(args, 1)))) then fat-fail("window-needs-nonnegative-count", docs) else fat-window(docs, tool, fat-drop(args, 2), input, if str_eq(head(args), "-c") then "bytes" else "lines", str_to_int(nth(args, 1))) else if fat-starts(head(args), "-") then fat-fail("unsupported-window-option", docs) else fat-window-input(docs, tool, unit, amount, fat-input(docs, args, input));
        def fat-window-input(docs, tool, unit, amount, r) = if not(str_eq(nth(r, 1), "")) then fat-fail(nth(r, 1), docs) else if str_eq(unit, "bytes") then fat-ok(if str_eq(tool, "head") then substring(head(r), 0, fat-min(amount, str_len(head(r)))) else substring(head(r), fat-max(0, sub(str_len(head(r)), amount)), str_len(head(r))), docs) else fat-ok(fat-line-window(head(r), if str_eq(tool, "head") then 0 else fat-max(0, sub(len(sh-lines(head(r))), amount)), amount), docs);
        def fat-line-window(s, start, count) = fat-window-join(fat-take(fat-drop(sh-lines(s), start), count), and(gt(str_len(s), 0), eq(fat-char(s, sub(str_len(s), 1)), 10)), ge(add(start, count), len(sh-lines(s))));
        def fat-window-join(lines, finalNewline, reachesEnd) = if nil?(lines) then "" else str_concat(fat-join(lines, "\n"), if or(finalNewline, not(reachesEnd)) then "\n" else "");
        def fat-sed(docs, args, input) = if lt(len(args), 2) then fat-fail("sed-supports-only-numeric-print-range", docs) else if not(str_eq(head(args), "-n")) then fat-fail("sed-supports-only-numeric-print-range", docs) else if not(fat-ends(nth(args, 1), "p")) then fat-fail("sed-supports-only-numeric-print-range", docs) else fat-sed-range(docs, fat-drop(args, 2), input, split-on(substring(nth(args, 1), 0, sub(str_len(nth(args, 1)), 1)), ","));
        def fat-sed-range(docs, paths, input, range) = if or(not(or(eq(len(range), 1), eq(len(range), 2))), not(fat-natural(head(range)))) then fat-fail("invalid-print-range", docs) else if and(eq(len(range), 2), not(fat-natural(nth(range, 1)))) then fat-fail("invalid-print-range", docs) else fat-sed-ready(docs, str_to_int(head(range)), if eq(len(range), 2) then str_to_int(nth(range, 1)) else str_to_int(head(range)), fat-input(docs, paths, input));
        def fat-sed-ready(docs, first, last, r) = if not(str_eq(nth(r, 1), "")) then fat-fail(nth(r, 1), docs) else if or(le(first, 0), lt(last, first)) then fat-fail("invalid-print-range", docs) else fat-ok(fat-line-window(head(r), sub(first, 1), add(sub(last, first), 1)), docs);
        def fat-text-options(docs, tool, args, input, flags) = if nil?(args) then fat-text-ready(docs, tool, flags, list(input, "")) else if fat-starts(head(args), "-") then if fat-valid-text-flag(tool, head(args)) then fat-text-options(docs, tool, tail(args), input, cons(head(args), flags)) else fat-fail("unsupported-text-option", docs) else fat-text-ready(docs, tool, flags, fat-input(docs, args, input));
        def fat-valid-text-flag(tool, flag) = if str_eq(tool, "wc") then fat-has(list("-l", "-w", "-c", "-lw", "-lc", "-wc", "-lwc"), flag) else if str_eq(tool, "sort") then fat-has(list("-r", "-u", "-n", "-rn", "-nr", "-ru", "-ur", "-nu", "-un", "-nru"), flag) else if str_eq(tool, "uniq") then fat-has(list("-c", "-d", "-u"), flag) else 0;
        def fat-flag(flags, letter) = ge(str_find(fat-join(flags, ""), letter, 0), 0);
        def fat-text-ready(docs, tool, flags, r) = if not(str_eq(nth(r, 1), "")) then fat-fail(nth(r, 1), docs) else if str_eq(tool, "wc") then fat-ok(str_concat(fat-join(fat-counts(head(r), flags), " "), "\n"), docs) else if str_eq(tool, "sort") then fat-sort-ready(docs, sh-lines(head(r)), flags) else fat-ok(fat-uniq-lines(sh-lines(head(r)), flags), docs);
        def fat-sort-ready(docs, lines, flags) = if gt(len(lines), FatMaxSortItems()) then fat-fail("sort-item-limit", docs) else if and(fat-flag(flags, "n"), not(fat-numeric-lines(lines))) then fat-fail("numeric-sort-needs-number-lines", docs) else fat-ok(sh-join-nl(fat-sort-lines(lines, flags)), docs);
        def fat-numeric-lines(lines) = if nil?(lines) then 1 else and(faj-valid-end(fat-trim(head(lines)), faj-number(fat-trim(head(lines)), 0)), fat-numeric-lines(tail(lines)));
        def fat-counts(s, flags) = append(if or(nil?(flags), fat-flag(flags, "l")) then list(int_to_str(ne-count(s, "\n"))) else list(), append(if or(nil?(flags), fat-flag(flags, "w")) then list(int_to_str(sh-count-words(s))) else list(), if or(nil?(flags), fat-flag(flags, "c")) then list(int_to_str(str_len(s))) else list()));
        def fat-num-insert(x, xs) = if nil?(xs) then list(x) else if le(str_to_float(x), str_to_float(head(xs))) then cons(x, xs) else cons(head(xs), fat-num-insert(x, tail(xs)));
        def fat-num-sort(xs) = if nil?(xs) then list() else fat-num-insert(head(xs), fat-num-sort(tail(xs)));
        def fat-sort-lines(lines, flags) = fat-sort-final(if fat-flag(flags, "n") then fat-num-sort(lines) else sh-sort(lines), flags);
        def fat-sort-final(lines, flags) = if fat-flag(flags, "r") then fat-reverse(fat-sort-unique(lines, flags)) else fat-sort-unique(lines, flags);
        def fat-sort-unique(lines, flags) = if not(fat-flag(flags, "u")) then lines else if fat-flag(flags, "n") then fat-num-unique(lines) else sh-uniq(lines);
        def fat-num-unique(lines) = if nil?(lines) then list() else cons(head(lines), fat-num-unique(fat-num-drop(tail(lines), str_to_float(head(lines)))));
        def fat-num-drop(lines, n) = if nil?(lines) then lines else if eq(str_to_float(head(lines)), n) then fat-num-drop(tail(lines), n) else lines;
        def fat-uniq-lines(lines, flags) = if nil?(lines) then "" else fat-uniq-group(tail(lines), head(lines), 1, flags);
        def fat-uniq-group(rest, line, count, flags) = if nil?(rest) then fat-uniq-emit(line, count, flags) else if str_eq(head(rest), line) then fat-uniq-group(tail(rest), line, add(count, 1), flags) else str_concat(fat-uniq-emit(line, count, flags), fat-uniq-lines(rest, flags));
        def fat-uniq-emit(line, count, flags) = if or(and(fat-flag(flags, "d"), eq(count, 1)), and(fat-flag(flags, "u"), gt(count, 1))) then "" else str_concat(if fat-flag(flags, "c") then str_concat(int_to_str(count), " ") else "", str_concat(line, "\n"));
        def fat-tr(docs, args, input) = if not(eq(len(args), 2)) then fat-fail("tr-needs-two-literal-sets", docs) else fat-tr-sets(docs, input, str_eq(head(args), "-d"), if str_eq(head(args), "-d") then list("", "") else fat-tr-set(head(args), 0, ""), fat-tr-set(nth(args, 1), 0, ""));
        def fat-tr-set(s, i, out) = if ge(i, str_len(s)) then list(out, "") else if eq(fat-char(s, i), 92) then fat-tr-escape(s, i, out) else if or(eq(fat-char(s, i), 45), eq(fat-char(s, i), 91)) then list("", "tr-ranges-not-supported") else fat-tr-set(s, add(i, 1), str_concat(out, byte_to_str(fat-char(s, i))));
        def fat-tr-escape(s, i, out) = if not(fat-has(list("n", "r", "t", "\\"), byte_to_str(fat-char(s, add(i, 1))))) then list("", "unsupported-tr-escape") else fat-tr-set(s, add(i, 2), str_concat(out, byte_to_str(if eq(fat-char(s, add(i, 1)), 110) then 10 else if eq(fat-char(s, add(i, 1)), 114) then 13 else if eq(fat-char(s, add(i, 1)), 116) then 9 else 92)));
        def fat-tr-sets(docs, input, remove, from, to) = if not(str_eq(nth(from, 1), "")) then fat-fail(nth(from, 1), docs) else if not(str_eq(nth(to, 1), "")) then fat-fail(nth(to, 1), docs) else if remove then fat-ok(fat-delete-chars(input, head(to), 0), docs) else if not(eq(str_len(head(from)), str_len(head(to)))) then fat-fail("tr-supports-equal-length-literal-sets", docs) else fat-ok(sh-tr-str(input, head(from), head(to)), docs);
        def fat-delete-chars(s, chars, i) = if ge(i, str_len(s)) then "" else str_concat(if ge(str_find(chars, byte_to_str(fat-char(s, i)), 0), 0) then "" else byte_to_str(fat-char(s, i)), fat-delete-chars(s, chars, add(i, 1)));
        def fat-cut(docs, args, input) = if or(lt(len(args), 4), or(not(str_eq(head(args), "-d")), not(str_eq(nth(args, 2), "-f")))) then fat-fail("cut-needs-d-delimiter-f-field", docs) else if or(not(eq(str_len(nth(args, 1)), 1)), not(fat-natural(nth(args, 3)))) then fat-fail("invalid-cut-field", docs) else if le(str_to_int(nth(args, 3)), 0) then fat-fail("invalid-cut-field", docs) else fat-cut-ready(docs, nth(args, 1), str_to_int(nth(args, 3)), fat-input(docs, fat-drop(args, 4), input));
        def fat-cut-ready(docs, delimiter, field, r) = if not(str_eq(nth(r, 1), "")) then fat-fail(nth(r, 1), docs) else fat-ok(fat-cut-lines(sh-lines(head(r)), delimiter, field), docs);
        def fat-cut-lines(lines, delimiter, field) = if nil?(lines) then "" else str_concat(fat-cut-line(head(lines), delimiter, field), str_concat("\n", fat-cut-lines(tail(lines), delimiter, field)));
        def fat-cut-line(line, delimiter, field) = if lt(str_find(line, delimiter, 0), 0) then line else if lt(len(split-on(line, delimiter)), field) then "" else nth(split-on(line, delimiter), sub(field, 1));
        def fat-awk-valid(program) = fat-awk-print(program, 0);
        def fat-awk-print(program, field) = if gt(field, 9) then 0 else if str_eq(fat-trim(program), str_concat("{print $", str_concat(int_to_str(field), "}"))) then 1 else fat-awk-print(program, add(field, 1));
        def fat-awk(docs, args, input) = if nil?(args) then fat-fail("awk-needs-program", docs) else if not(fat-awk-valid(head(args))) then fat-fail("awk-supports-single-field-print", docs) else fat-awk-ready(docs, head(args), fat-input(docs, tail(args), input));
        def fat-awk-ready(docs, program, r) = if not(str_eq(nth(r, 1), "")) then fat-fail(nth(r, 1), docs) else fat-ok(head(sh-bi-awk(list(program), head(r))), docs);

        def fat-jq(docs, args, input) = fat-jq-args(docs, args, input, list());
        def fat-jq-args(docs, args, input, options) = if nil?(args) then fat-fail("jq-needs-filter", docs) else if or(str_eq(head(args), "--arg"), str_eq(head(args), "--argjson")) then fat-jq-bind(docs, args, input, options) else if fat-starts(head(args), "-") then fat-jq-flags(docs, args, input, options, 1) else fat-jq-compiled(docs, options, tail(args), input, faj-compile(head(args)));
        def fat-jq-flags(docs, args, input, options, i) = if ge(i, str_len(head(args))) then if eq(i, 1) then fat-fail("unsupported-jq-option", docs) else fat-jq-args(docs, tail(args), input, options) else if fat-has(list("r", "c", "e", "s", "n"), byte_to_str(fat-char(head(args), i))) then fat-jq-flags(docs, args, input, far-set(options, byte_to_str(fat-char(head(args), i)), 1), add(i, 1)) else fat-fail("unsupported-jq-option", docs);
        def fat-jq-bind(docs, args, input, options) = if lt(len(args), 3) then fat-fail("jq-binding-needs-name-value", docs) else if not(faj-name(nth(args, 1))) then fat-fail("invalid-jq-variable-name", docs) else if and(str_eq(head(args), "--argjson"), not(faj-valid(nth(args, 2)))) then fat-fail("invalid-json-binding", docs) else fat-jq-args(docs, fat-drop(args, 3), input, far-push(options, "vars", list(nth(args, 1), if str_eq(head(args), "--argjson") then faj-json("resident-variable", nth(args, 2)) else intern_trivial_string(nth(args, 2)))));
        def fat-jq-compiled(docs, options, paths, input, compiled) = if not(str_eq(nth(compiled, 1), "")) then fat-fail(nth(compiled, 1), docs) else if not(faj-bound(head(compiled), far-get(options, "vars", list()))) then fat-fail("unbound-variable", docs) else fat-jq-input(docs, options, head(compiled), if far-get(options, "n", 0) then list("null", "") else if nil?(paths) then list(input, "") else fat-json-files(docs, paths, ""));
        def fat-json-files(docs, paths, out) = if nil?(paths) then list(out, "") else fat-json-file(docs, paths, out, fat-find-doc(docs, head(paths)));
        def fat-json-file(docs, paths, out, doc) = if nil?(doc) then list("", "resident-document-not-found") else fat-json-files(docs, tail(paths), str_concat(out, str_concat(nth(doc, 2), "\n")));
        def fat-jq-input(docs, options, ast, r) = if not(str_eq(nth(r, 1), "")) then fat-fail(nth(r, 1), docs) else fat-jq-parsed(docs, options, ast, fat-json-stream(head(r), 0, list()));
        def fat-json-stream(s, at, out) = if ge(fat-skip(s, at), str_len(s)) then faj-values(fat-reverse(out)) else fat-json-value(s, fat-skip(s, at), out, faj-end(s, at, 0));
        def fat-json-value(s, start, out, end) = if le(end, start) then faj-bad("invalid-json-input") else if and(lt(end, str_len(s)), not(fat-ws(fat-char(s, end)))) then faj-bad("invalid-json-input") else fat-json-stream(s, end, cons(faj-json("resident-json-input", substring(s, start, end)), out));
        def fat-jq-parsed(docs, options, ast, r) = if not(str_eq(nth(r, 1), "")) then fat-fail(nth(r, 1), docs) else fat-jq-evaluated(docs, options, faj-each(ast, if far-get(options, "s", 0) then list(faj-array(head(r))) else head(r), far-get(options, "vars", list())));
        def fat-jq-evaluated(docs, options, r) = if not(str_eq(nth(r, 1), "")) then fat-fail(nth(r, 1), docs) else fat-result(if far-get(options, "e", 0) then if nil?(head(r)) then 4 else if faj-truth(head(fat-reverse(head(r)))) then 0 else 1 else 0, faj-render(head(r), far-get(options, "r", 0)), "", docs);
    }
}
