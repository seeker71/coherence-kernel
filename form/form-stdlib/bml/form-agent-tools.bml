// The resident coding-agent workload, directly callable from form-cli.
// Existing sh-bi helpers below are pure Form functions. No shell AST is parsed
// or executed, and the file-reading sh-bi-cat branch is never called.
// preludes: form-stdlib/core.fk form-stdlib/tool-channel.fk form-stdlib/native-edit.fk form-stdlib/shell-exec.fk form-stdlib/bml/form-agent-search.bml form-stdlib/bml/form-agent-json-query.bml
// preludes: form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/fkwu-op-arity.fk
section [form.bml] {
    class FormAgentTools {
        field FatByteTab = 9;
        field FatByteLf = 10;
        field FatByteCr = 13;
        field FatByteSpace = 32;
        field FatByteQuote = 34;
        field FatByteOpen = 40;
        field FatByteClose = 41;
        field FatByteDash = 45;
        field FatByteSemi = 59;
        field FatByteSlash = 92;
        field FatByteBracket = 91;
        field FatByteN = 110;
        field FatByteR = 114;
        field FatByteT = 116;
        field FatByteBraceOpen = 123;
        field FatByteBraceClose = 125;
        field FatHeadTailLines = 10;
        field FatAwkLastField = 9;
        def fat-fk-suffix() = ".fk";
        def fat-bml-open() = "section [";
        def fat-tools() = append(tc-agent-tool-names(), list("balance", "arity"));
        def fat-tool?(name) = fat-has(fat-tools(), name);
        def fat-input(docs, paths, input) = nil?(paths) ? list(input, "") : fat-input-files(docs, paths, "");
        def fat-input-files(docs, paths, out) = nil?(paths) ? list(out, "") : fat-input-doc(docs, paths, out, fat-find-doc(docs, head(paths)));
        def fat-input-doc(docs, paths, out, doc) = nil?(doc) ? list("", "resident-document-not-found") : fat-input-files(docs, tail(paths), out ++ doc[2]);
        def fat-call(docs, tool, args, input) =
            (len(docs) > FatMaxDocuments()) || ((len(args) > FatMaxArguments()) || ((str_len(input) > FatMaxBytes()) || ((fat-text-bytes(args, 0) > FatMaxBytes()) || (fat-doc-bytes(docs, 0) > FatMaxBytes())))) ? fat-fail("resident-input-limit", docs)
            : !(fat-text?(input) && (fat-text?(tool) && fat-docs-valid(docs, list()))) ? fat-fail("invalid-resident-values", docs)
            : !fat-tool?(tool) ? fat-fail("unsupported-tool", docs)
            : fat-bounded(fat-dispatch(docs, tool, args, input), docs);
        def fat-bounded(result, docs) = str_len(fat-out(result)) > FatMaxBytes() ? fat-fail("output-limit", docs) : (len(fat-documents(result)) > FatMaxDocuments()) || (fat-doc-bytes(fat-documents(result), 0) > FatMaxBytes()) ? fat-fail("resident-output-limit", docs) : !fat-docs-valid(fat-documents(result), list()) ? fat-fail("invalid-resident-output", docs) : result;
        def fat-with-docs(result, docs) = fat-result(fat-exit(result), fat-out(result), fat-error(result), docs);
        def fat-dispatch(docs, tool, args, input) = (String) tool == "rg" ? fat-with-docs(far-run-input(docs, args, input), docs)
            : (String) tool == "jq" ? fat-jq(docs, args, input)
            : (String) tool == "edit" ? fat-edit(docs, args)
            : (String) tool == "write" ? fat-write(docs, args, input)
            : ((String) tool == "read") || ((String) tool == "cat") ? fat-read(docs, args, input)
            : ((String) tool == "head") || ((String) tool == "tail") ? fat-window(docs, tool, args, input, "lines", FatHeadTailLines())
            : (String) tool == "sed" ? fat-sed(docs, args, input)
            : (String) tool == "tr" ? fat-tr(docs, args, input)
            : (String) tool == "cut" ? fat-cut(docs, args, input)
            : (String) tool == "awk" ? fat-awk(docs, args, input)
            : (String) tool == "balance" ? fat-balance(docs, args, input)
            : (String) tool == "arity" ? fat-arity(docs, args, input)
            : fat-text-options(docs, tool, args, input, list());
        def fat-command(docs, command, input) = !fat-text?(command) ? fat-fail("invalid-command-value", docs) : str_len(command) > FatMaxBytes() ? fat-fail("command-limit", docs) : fat-command-argv(docs, input, fat-argv(command));
        def fat-command-argv(docs, input, parsed) = !((String) parsed[1] == "") ? fat-fail(parsed[1], docs) : nil?(head(parsed)) ? fat-fail("missing-tool", docs) : fat-call(docs, head(head(parsed)), tail(head(parsed)), input);
        def fat-read(docs, args, input) = fat-read-result(docs, fat-input(docs, args, input));
        def fat-read-result(docs, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : fat-ok(head(r), docs);
        // balance: a document's open-minus-close count of parens and of braces, "parens braces\n"; an edit that leaves
        // a form open reads a count its source did not, so a caller's check can hold the count the source had
        def fat-balance(docs, args, input) = len(args) > 1 ? fat-fail("balance-needs-at-most-one-path", docs) : fat-balance-result(docs, fat-input(docs, args, input));
        def fat-balance-result(docs, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : fat-ok(fat-balance-text(head(r)), docs);
        def fat-balance-text(text) = int_to_str(fat-balance-count(text, 0, str_len(text), FatByteOpen(), FatByteClose(), 0)) ++ " " ++ int_to_str(fat-balance-count(text, 0, str_len(text), FatByteBraceOpen(), FatByteBraceClose(), 0)) ++ "\n";
        def fat-balance-count(text, i, n, open, close, d) = i >= n ? d : fat-balance-count(text, i + 1, n, open, close, (Comparable) str_byte_at(text, i) == open ? (d + 1) : (Comparable) str_byte_at(text, i) == close ? (d - 1) : d);
        // arity: every call in a Form source whose head fkwu answers itself, read against the argument count the
        // reader demands (form-stdlib/fkwu-op-arity.fk, generated from runtime/fkwu-optable.h); one line per call
        // that would not compile, "" when every call is whole. Strings and ; comments are read as themselves, and a
        // defn's parameter list (a fn or lambda's too) is a list of names, never a call.
        def fat-arity(docs, args, input) = len(args) > 1 ? fat-fail("arity-needs-at-most-one-path", docs) : ((Comparable) len(args) == 1) && (!fat-fk-path?(head(args))) ? fat-fail("arity-reads-fk-sources", docs) : fat-arity-result(docs, fat-input(docs, args, input));
        def fat-fk-path?(p) = (str_len(p) > str_len(fat-fk-suffix())) && ((String) substring(p, str_len(p) - str_len(fat-fk-suffix()), str_len(p)) == fat-fk-suffix());
        // a source carrying a section [ block on a line of its own is BML surface, whatever its extension (the kernel
        // lowers it through the BML lane); rehearse-bml reads it, arity declines it
        def fat-arity-result(docs, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : fat-ar-bml-surface?(head(r)) ? fat-fail("arity-reads-direct-source-not-bml-surface", docs) : fat-ok(fat-ar-text(head(r)), docs);
        def fat-ar-bml-surface?(t) = ((str_len(t) >= str_len(fat-bml-open())) && ((String) substring(t, 0, str_len(fat-bml-open())) == fat-bml-open())) || (str_find(t, "\n" ++ fat-bml-open(), 0) >= 0);
        def fat-ar-text(t) = fat-ar-lines(t, reverse(fat-ar-forms(t, 0, str_len(t), list())[1]));
        def fat-ar-lines(t, found) = nil?(found) ? "" : fat-ar-line-of(t, head(found)) ++ fat-ar-lines(t, tail(found));
        def fat-ar-line-of(t, f) = "line " ++ int_to_str(fat-ar-line(t, 0, f[0], 1)) ++ ": (" ++ f[1] ++ " ...) takes " ++ int_to_str(f[2]) ++ ", given " ++ int_to_str(f[3]) ++ "\n";
        def fat-ar-line(t, i, stop, line) = i >= stop ? line : fat-ar-line(t, i + 1, stop, (Comparable) str_byte_at(t, i) == FatByteLf() ? (line + 1) : line);
        def fat-ar-space?(b) = ((Comparable) b == FatByteSpace()) || (((Comparable) b == FatByteTab()) || (((Comparable) b == FatByteLf()) || ((Comparable) b == FatByteCr())));
        def fat-ar-delim?(b) = fat-ar-space?(b) || (((Comparable) b == FatByteOpen()) || (((Comparable) b == FatByteClose()) || (((Comparable) b == FatByteSemi()) || ((Comparable) b == FatByteQuote()))));
        def fat-ar-eol(t, i, n) = (i >= n) || ((Comparable) str_byte_at(t, i) == FatByteLf()) ? i : fat-ar-eol(t, i + 1, n);
        def fat-ar-ws(t, i, n) = i >= n ? n : fat-ar-space?(str_byte_at(t, i)) ? fat-ar-ws(t, i + 1, n) : (Comparable) str_byte_at(t, i) == FatByteSemi() ? fat-ar-ws(t, fat-ar-eol(t, i, n), n) : i;
        def fat-ar-atom-end(t, i, n) = (i >= n) || fat-ar-delim?(str_byte_at(t, i)) ? i : fat-ar-atom-end(t, i + 1, n);
        def fat-ar-str-end(t, i, n) = i >= n ? n : (Comparable) str_byte_at(t, i) == FatByteSlash() ? fat-ar-str-end(t, i + 2, n) : (Comparable) str_byte_at(t, i) == FatByteQuote() ? (i + 1) : fat-ar-str-end(t, i + 1, n);
        // the top level: every form in turn; answers (list end findings)
        def fat-ar-forms(t, i, n, acc) = fat-ar-forms-at(t, fat-ar-ws(t, i, n), n, acc);
        def fat-ar-forms-at(t, j, n, acc) = j >= n ? list(n, acc) : fat-ar-forms-next(t, fat-ar-form(t, j, n, acc, 0), n);
        def fat-ar-forms-next(t, r, n) = fat-ar-forms(t, head(r), n, r[1]);
        // one form at i; quiet reads a list of names without checking it; answers (list end findings)
        def fat-ar-form(t, i, n, acc, quiet) = (Comparable) str_byte_at(t, i) == FatByteOpen() ? fat-ar-list(t, fat-ar-ws(t, i + 1, n), n, acc, i, quiet) : (Comparable) str_byte_at(t, i) == FatByteQuote() ? list(fat-ar-str-end(t, i + 1, n), acc) : (Comparable) str_byte_at(t, i) == FatByteClose() ? list(i + 1, acc) : list(fat-ar-atom-end(t, i, n), acc);
        def fat-ar-list(t, j, n, acc, open, quiet) = j >= n ? list(n, acc) : (Comparable) str_byte_at(t, j) == FatByteClose() ? list(j + 1, acc) : ((Comparable) str_byte_at(t, j) == FatByteOpen()) || ((Comparable) str_byte_at(t, j) == FatByteQuote()) ? fat-ar-args-from(t, fat-ar-form(t, j, n, acc, quiet), n, "", open, quiet) : fat-ar-headed(t, substring(t, j, fat-ar-atom-end(t, j, n)), fat-ar-args(t, fat-ar-atom-end(t, j, n), n, acc, 0, quiet, substring(t, j, fat-ar-atom-end(t, j, n))), open, quiet);
        def fat-ar-args-from(t, r, n, name, open, quiet) = fat-ar-close(fat-ar-args(t, head(r), n, r[1], 0, quiet, name));
        def fat-ar-close(r) = list(head(r), r[1]);
        // a call with a head: its arguments read, then its count held to the table
        // a negative arity in the table is a variadic head (list, append ...): any count stands
        def fat-ar-headed(t, name, r, open, quiet) = ((Comparable) quiet == 1) || (nothing?(fkwu-op-arity(name)) || ((fkwu-op-arity(name) < 0) || ((Comparable) fkwu-op-arity(name) == r[2]))) ? list(head(r), r[1]) : list(head(r), cons(list(open, name, fkwu-op-arity(name), r[2]), r[1]));
        def fat-ar-names?(name, count) = (((String) name == "defn") && ((Comparable) count == 1)) || ((((String) name == "fn") || ((String) name == "lambda")) && ((Comparable) count == 0));
        // the arguments of one list; answers (list end findings count)
        def fat-ar-args(t, i, n, acc, count, quiet, name) = fat-ar-args-at(t, fat-ar-ws(t, i, n), n, acc, count, quiet, name);
        def fat-ar-args-at(t, j, n, acc, count, quiet, name) = j >= n ? list(n, acc, count) : (Comparable) str_byte_at(t, j) == FatByteClose() ? list(j + 1, acc, count) : fat-ar-args-next(t, fat-ar-form(t, j, n, acc, fat-ar-names?(name, count) ? 1 : quiet), n, count, quiet, name);
        def fat-ar-args-next(t, r, n, count, quiet, name) = fat-ar-args(t, head(r), n, r[1], count + 1, quiet, name);
        def fat-edit-guidance() = "Existing documents require edit: arguments [path,exact unique old text,new text]. For several focused changes, use [path,old1,new1,old2,new2,...]; literal replacements run in order, each old text must match exactly once at its step, and any failure rolls back the whole call. Guard a literal batch with [path,resident_sha256,old1,new1,old2,new2,...]; the hash checks the initial document once before the same atomic edits. For a whole-document replacement use [path,\"sha256\",expected resident_sha256,new whole-document text]. The shorter [path,resident_sha256,new whole-document text] also works when the hash has no literal match and equals the current document identity. Literal matches keep their text-edit meaning. Obtain resident_sha256 from the current document, successful mutation result, read, cat or guard_evidence. An edit changes that identity; use the new resident_sha256 for the next edit. write only creates an absent path; it cannot overwrite an existing document. ";
        def fat-document-sha(doc) = hex-encode(sha256-stream-string(doc[2]));
        def fat-sha-bytes?(text,at) = at >= str_len(text) ? 1 : ((str_find(hex-alphabet(),substring(text,at,at + 1),0) >= 0) && fat-sha-bytes?(text,at + 1));
        def fat-sha?(text) = ((Comparable) str_len(text) == 64) && fat-sha-bytes?(text,0);
        def fat-edit-batch?(args) = (len(args) >= 5) && ((Comparable) (len(args) % 2) == 1);
        def fat-edit-guarded-batch?(args) = (len(args) >= 4) && ((len(args) % 2) == 0) && fat-sha?(args[1]);
        def fat-edit(docs, args) = fat-edit-guarded-batch?(args) ? fat-edit-guarded(docs,head(args),args[1],doc => fat-edit-batch(docs,docs,head(args),fat-drop(args,2),1)) : (Comparable) len(args) == 4 ? fat-edit-sha(docs,args) : fat-edit-batch?(args) ? fat-edit-batch(docs,docs,head(args),tail(args),1) : !((Comparable) len(args) == 3) ? fat-fail("edit-needs-path-old-new", docs) : (String) args[1] == "" ? fat-fail("empty-edit-pattern", docs) : fat-edit-doc(docs, args, fat-find-doc(docs, head(args)));
        // Intermediate documents stay local to this call. A later failure
        // returns the original set, including when an earlier step succeeded.
        def fat-edit-batch(original,docs,path,pairs,step) = nil?(pairs) ?
            ((Value) original == docs ? fat-fail("edit-unchanged: old and new text are identical; no source changed",original) : fat-ok("edited\n",docs))
            : {
                let result = fat-edit-literal(docs,list(path,head(pairs),pairs[1]),fat-find-doc(docs,path));
                (Comparable) fat-exit(result) == 0 ? fat-edit-batch(original,fat-documents(result),path,fat-drop(pairs,2),step + 1)
                : fat-result(fat-exit(result),json-emit(json-node-object(list(json-node-pair("failed_edit",json-node-int(step)),json-node-pair("documents_changed",json-node-int(0)),json-node-pair("scope",json-node-string("The numbered literal replacement failed against the intermediate text; all replacements in this call were rolled back."))))),fat-error(result),original);
            };
        def fat-edit-literal(docs,args,doc) = (String) args[1] == "" ? fat-fail("empty-edit-pattern",docs)
            : nil?(doc) ? fat-fail("resident-document-not-found",docs)
            : {
                let count = ne-count(doc[2],args[1]);
                (Comparable) count == 0 ? fat-fail("edit-not-found",docs) : fat-edit-count(docs,args,doc,count);
            };
        def fat-edit-guarded(docs,path,digest,apply) = !fat-sha?(digest) ? fat-fail("edit-invalid-sha256",docs) : {
            let doc=fat-find-doc(docs,path);
            nil?(doc) ? fat-fail("resident-document-not-found",docs) : ((String) digest != fat-document-sha(doc)) ? fat-fail("edit-sha256-mismatch",docs) : apply(doc);
        };
        def fat-edit-sha(docs,args) = ((String) args[1] != "sha256") ? fat-fail("edit-needs-path-sha256-digest-new-text",docs) : fat-edit-guarded(docs,head(args),args[2],doc => ((String) doc[2] == args[3]) ? fat-fail("edit-unchanged: old and new text are identical; no source changed",docs) : fat-ok("edited\n",fat-put-doc(docs,list(head(doc),doc[1],args[3]))));
        def fat-edit-doc(docs, args, doc) = nil?(doc) ? fat-fail("resident-document-not-found", docs) : fat-edit-count(docs, args, doc, ne-count(doc[2], args[1]));
        def fat-edit-count(docs, args, doc, count) = (Comparable) count == 0 ? fat-edit-identity(docs,args,doc) : !((Comparable) count == 1) ? fat-fail("edit-ambiguous", docs) : (String) args[1] == args[2] ? fat-fail("edit-unchanged: old and new text are identical; no source changed",docs) : fat-ok("edited\n", fat-put-doc(docs, list(doc[0], doc[1], ne-replace-first(doc[2], args[1], args[2]))));
        // A missing literal may name the complete current document instead.
        // Existing literal matches and ambiguous edits retain their meaning.
        def fat-edit-identity(docs,args,doc) = !(fat-sha?(args[1]) && ((String) args[1] == fat-document-sha(doc))) ? fat-fail("edit-not-found",docs) : fat-edit-sha(docs,list(head(args),"sha256",args[1],args[2]));
        def fat-write(docs, args, input) = !(((Comparable) len(args) == 1) || ((Comparable) len(args) == 2)) ? fat-fail("write-needs-new-path-and-text", docs) : (String) head(args) == "" ? fat-fail("empty-document-path", docs) : !nil?(fat-find-doc(docs, head(args))) ? fat-fail("document-exists-use-guarded-edit", docs) : fat-ok("created\n", append(docs, list(list("resident:" ++ head(args), head(args), (Comparable) len(args) == 2 ? args[1] : input))));

        // Private tool evidence, derived from the same resident documents the
        // guard inspected. Error codes and mutation authority stay unchanged.
        def fat-guard-prefix(a,b,at) = (at >= str_len(a)) || (at >= str_len(b)) ? at : !((Comparable) fat-char(a,at) == fat-char(b,at)) ? at : fat-guard-prefix(a,b,at + 1);
        def fat-guard-byte(text,at) = at >= str_len(text) ? json-node-null() : json-node-int(fat-char(text,at));
        def fat-guard-comparison(source,old) {
            let at = fat-guard-prefix(source,old,0);
            let start = fat-max(0,at - 32);
            json-node-object(list(json-node-pair("scope",json-node-string("old argument compared with the whole resident document at equal byte offsets; no approximate match or edit")),json-node-pair("first_difference_byte",(String) source == old ? json-node-null() : json-node-int(at)),json-node-pair("old_byte",fat-guard-byte(old,at)),json-node-pair("resident_byte",fat-guard-byte(source,at)),json-node-pair("context_start_byte",json-node-int(start)),json-node-pair("old_context",json-node-string(substring(old,start,fat-min(str_len(old),at + 48)))),json-node-pair("resident_context",json-node-string(substring(source,start,fat-min(str_len(source),at + 48))))));
        }
        def fat-guard-evidence(docs,tool,args,result) = nil?(args) || (!fat-has(list("edit-not-found","edit-ambiguous","document-exists-use-guarded-edit","edit-sha256-mismatch"),fat-error(result))) ? nothing() : {
            let doc = fat-find-doc(docs,head(args));
            nil?(doc) || (!((((String) tool == "edit") && (((Comparable) len(args) == 3) || (((Comparable) len(args) == 4) || fat-edit-guarded-batch?(args)))) || ((String) tool == "write"))) ? nothing() : {
                let source = doc[2];
                let base = list(json-node-pair("scope",json-node-string("caller-supplied resident documents; tools do not write the filesystem")),json-node-pair("path",json-node-string(doc[1])),json-node-pair("documents_changed",json-node-int(!((Value) docs == fat-documents(result)))),json-node-pair("resident_bytes",json-node-int(str_len(source))),json-node-pair("resident_sha256",json-node-string(fat-document-sha(doc))),json-node-pair("next",json-node-string(fat-edit-guidance())));
                json-node-object(append(base,(String) tool == "write" ? list() : fat-edit-guarded-batch?(args) || ((Comparable) len(args) == 4) ? list(json-node-pair("expected_sha256",json-node-string(args[fat-edit-guarded-batch?(args) ? 1 : 2]))) : list(json-node-pair("exact_matches",json-node-int(ne-count(source,args[1]))),json-node-pair("old_bytes",json-node-int(str_len(args[1]))),json-node-pair("whole_document_comparison",fat-guard-comparison(source,args[1])))));
            };
        };

        def fat-window(docs, tool, args, input, unit, amount) = nil?(args) ? fat-window-input(docs, tool, unit, amount, list(input, "")) : fat-has(list("-n", "-c"), head(args)) ? ((len(args) < 2) || (!fat-natural(args[1])) ? fat-fail("window-needs-nonnegative-count", docs) : fat-window(docs, tool, fat-drop(args, 2), input, (String) head(args) == "-c" ? "bytes" : "lines", str_to_int(args[1]))) : fat-starts(head(args), "-") ? fat-fail("unsupported-window-option", docs) : fat-window-input(docs, tool, unit, amount, fat-input(docs, args, input));
        def fat-window-input(docs, tool, unit, amount, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : (String) unit == "bytes" ? fat-ok((String) tool == "head" ? substring(head(r), 0, fat-min(amount, str_len(head(r)))) : substring(head(r), fat-max(0, str_len(head(r)) - amount), str_len(head(r))), docs) : fat-ok(fat-line-window(head(r), (String) tool == "head" ? 0 : fat-max(0, len(sh-lines(head(r))) - amount), amount), docs);
        def fat-line-window(s, start, count) = fat-window-join(fat-take(fat-drop(sh-lines(s), start), count), (str_len(s) > 0) && ((Comparable) fat-char(s, str_len(s) - 1) == FatByteLf()), (start + count) >= len(sh-lines(s)));
        def fat-window-join(lines, finalNewline, reachesEnd) = nil?(lines) ? "" : fat-join(lines, "\n") ++ (finalNewline || (!reachesEnd) ? "\n" : "");
        def fat-sed(docs, args, input) = len(args) < 2 ? fat-fail("sed-supports-only-numeric-print-range", docs) : !((String) head(args) == "-n") ? fat-fail("sed-supports-only-numeric-print-range", docs) : !fat-ends(args[1], "p") ? fat-fail("sed-supports-only-numeric-print-range", docs) : fat-sed-range(docs, fat-drop(args, 2), input, split-on(substring(args[1], 0, str_len(args[1]) - 1), ","));
        def fat-sed-range(docs, paths, input, range) = (!(((Comparable) len(range) == 1) || ((Comparable) len(range) == 2))) || (!fat-natural(head(range))) ? fat-fail("invalid-print-range", docs) : ((Comparable) len(range) == 2) && (!fat-natural(range[1])) ? fat-fail("invalid-print-range", docs) : fat-sed-ready(docs, str_to_int(head(range)), (Comparable) len(range) == 2 ? str_to_int(range[1]) : str_to_int(head(range)), fat-input(docs, paths, input));
        def fat-sed-ready(docs, first, last, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : (first <= 0) || (last < first) ? fat-fail("invalid-print-range", docs) : fat-ok(fat-line-window(head(r), first - 1, (last - first) + 1), docs);
        def fat-text-options(docs, tool, args, input, flags) = nil?(args) ? fat-text-ready(docs, tool, flags, list(input, "")) : fat-starts(head(args), "-") ? (fat-valid-text-flag(tool, head(args)) ? fat-text-options(docs, tool, tail(args), input, cons(head(args), flags)) : fat-fail("unsupported-text-option", docs)) : fat-text-ready(docs, tool, flags, fat-input(docs, args, input));
        def fat-valid-text-flag(tool, flag) = (String) tool == "wc" ? fat-has(list("-l", "-w", "-c", "-lw", "-lc", "-wc", "-lwc"), flag) : (String) tool == "sort" ? fat-has(list("-r", "-u", "-n", "-rn", "-nr", "-ru", "-ur", "-nu", "-un", "-nru"), flag) : (String) tool == "uniq" ? fat-has(list("-c", "-d", "-u"), flag) : 0;
        def fat-flag(flags, letter) = str_find(fat-join(flags, ""), letter, 0) >= 0;
        def fat-text-ready(docs, tool, flags, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : (String) tool == "wc" ? fat-ok(fat-join(fat-counts(head(r), flags), " ") ++ "\n", docs) : (String) tool == "sort" ? fat-sort-ready(docs, sh-lines(head(r)), flags) : fat-ok(fat-uniq-lines(sh-lines(head(r)), flags), docs);
        def fat-sort-ready(docs, lines, flags) = len(lines) > FatMaxSortItems() ? fat-fail("sort-item-limit", docs) : fat-flag(flags, "n") && (!fat-numeric-lines(lines)) ? fat-fail("numeric-sort-needs-number-lines", docs) : fat-ok(sh-join-nl(fat-sort-lines(lines, flags)), docs);
        def fat-numeric-lines(lines) = nil?(lines) ? 1 : (faj-valid-end(fat-trim(head(lines)), faj-number(fat-trim(head(lines)), 0)) && fat-numeric-lines(tail(lines)));
        def fat-counts(s, flags) = append(nil?(flags) || fat-flag(flags, "l") ? list(int_to_str(ne-count(s, "\n"))) : list(), append(nil?(flags) || fat-flag(flags, "w") ? list(int_to_str(sh-count-words(s))) : list(), nil?(flags) || fat-flag(flags, "c") ? list(int_to_str(str_len(s))) : list()));
        def fat-num-insert(x, xs) = nil?(xs) ? list(x) : str_to_float(x) <= str_to_float(head(xs)) ? cons(x, xs) : cons(head(xs), fat-num-insert(x, tail(xs)));
        def fat-num-sort(xs) = nil?(xs) ? list() : fat-num-insert(head(xs), fat-num-sort(tail(xs)));
        def fat-sort-lines(lines, flags) = fat-sort-final(fat-flag(flags, "n") ? fat-num-sort(lines) : sh-sort(lines), flags);
        def fat-sort-final(lines, flags) = fat-flag(flags, "r") ? fat-reverse(fat-sort-unique(lines, flags)) : fat-sort-unique(lines, flags);
        def fat-sort-unique(lines, flags) = !fat-flag(flags, "u") ? lines : fat-flag(flags, "n") ? fat-num-unique(lines) : sh-uniq(lines);
        def fat-num-unique(lines) = nil?(lines) ? list() : cons(head(lines), fat-num-unique(fat-num-drop(tail(lines), str_to_float(head(lines)))));
        def fat-num-drop(lines, n) = nil?(lines) ? lines : (Comparable) str_to_float(head(lines)) == n ? fat-num-drop(tail(lines), n) : lines;
        def fat-uniq-lines(lines, flags) = nil?(lines) ? "" : fat-uniq-group(tail(lines), head(lines), 1, flags);
        def fat-uniq-group(rest, line, count, flags) = nil?(rest) ? fat-uniq-emit(line, count, flags) : (String) head(rest) == line ? fat-uniq-group(tail(rest), line, count + 1, flags) : fat-uniq-emit(line, count, flags) ++ fat-uniq-lines(rest, flags);
        def fat-uniq-emit(line, count, flags) = (fat-flag(flags, "d") && ((Comparable) count == 1)) || (fat-flag(flags, "u") && (count > 1)) ? "" : (fat-flag(flags, "c") ? int_to_str(count) ++ " " : "") ++ line ++ "\n";
        def fat-tr(docs, args, input) = !((Comparable) len(args) == 2) ? fat-fail("tr-needs-two-literal-sets", docs) : fat-tr-sets(docs, input, (String) head(args) == "-d", (String) head(args) == "-d" ? list("", "") : fat-tr-set(head(args), 0, ""), fat-tr-set(args[1], 0, ""));
        def fat-tr-set(s, i, out) = i >= str_len(s) ? list(out, "") : (Comparable) fat-char(s, i) == FatByteSlash() ? fat-tr-escape(s, i, out) : ((Comparable) fat-char(s, i) == FatByteDash()) || ((Comparable) fat-char(s, i) == FatByteBracket()) ? list("", "tr-ranges-not-supported") : fat-tr-set(s, i + 1, out ++ byte_to_str(fat-char(s, i)));
        def fat-tr-escape(s, i, out) = !fat-has(list("n", "r", "t", "\\"), byte_to_str(fat-char(s, i + 1))) ? list("", "unsupported-tr-escape") : fat-tr-set(s, i + 2, out ++ byte_to_str((Comparable) fat-char(s, i + 1) == FatByteN() ? FatByteLf() : (Comparable) fat-char(s, i + 1) == FatByteR() ? FatByteCr() : (Comparable) fat-char(s, i + 1) == FatByteT() ? FatByteTab() : FatByteSlash()));
        def fat-tr-sets(docs, input, remove, from, to) = !((String) from[1] == "") ? fat-fail(from[1], docs) : !((String) to[1] == "") ? fat-fail(to[1], docs) : remove ? fat-ok(fat-delete-chars(input, head(to), 0), docs) : !((Comparable) str_len(head(from)) == str_len(head(to))) ? fat-fail("tr-supports-equal-length-literal-sets", docs) : fat-ok(sh-tr-str(input, head(from), head(to)), docs);
        def fat-delete-chars(s, chars, i) = i >= str_len(s) ? "" : (str_find(chars, byte_to_str(fat-char(s, i)), 0) >= 0 ? "" : byte_to_str(fat-char(s, i))) ++ fat-delete-chars(s, chars, i + 1);
        def fat-cut(docs, args, input) = (len(args) < 4) || ((!((String) head(args) == "-d")) || (!((String) args[2] == "-f"))) ? fat-fail("cut-needs-d-delimiter-f-field", docs) : (!((Comparable) str_len(args[1]) == 1)) || (!fat-natural(args[3])) ? fat-fail("invalid-cut-field", docs) : str_to_int(args[3]) <= 0 ? fat-fail("invalid-cut-field", docs) : fat-cut-ready(docs, args[1], str_to_int(args[3]), fat-input(docs, fat-drop(args, 4), input));
        def fat-cut-ready(docs, delimiter, field, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : fat-ok(fat-cut-lines(sh-lines(head(r)), delimiter, field), docs);
        def fat-cut-lines(lines, delimiter, field) = nil?(lines) ? "" : fat-cut-line(head(lines), delimiter, field) ++ "\n" ++ fat-cut-lines(tail(lines), delimiter, field);
        def fat-cut-line(line, delimiter, field) = str_find(line, delimiter, 0) < 0 ? line : len(split-on(line, delimiter)) < field ? "" : split-on(line, delimiter)[field - 1];
        def fat-awk-valid(program) = fat-awk-print(program, 0);
        def fat-awk-print(program, field) = field > FatAwkLastField() ? 0 : (String) fat-trim(program) == ("{print $" ++ int_to_str(field) ++ "}") ? 1 : fat-awk-print(program, field + 1);
        def fat-awk(docs, args, input) = nil?(args) ? fat-fail("awk-needs-program", docs) : !fat-awk-valid(head(args)) ? fat-fail("awk-supports-single-field-print", docs) : fat-awk-ready(docs, head(args), fat-input(docs, tail(args), input));
        def fat-awk-ready(docs, program, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : fat-ok(head(sh-bi-awk(list(program), head(r))), docs);

        def fat-jq(docs, args, input) = fat-jq-args(docs, args, input, list());
        def fat-jq-args(docs, args, input, options) = nil?(args) ? fat-fail("jq-needs-filter", docs) : ((String) head(args) == "--arg") || ((String) head(args) == "--argjson") ? fat-jq-bind(docs, args, input, options) : fat-starts(head(args), "-") ? fat-jq-flags(docs, args, input, options, 1) : fat-jq-compiled(docs, options, tail(args), input, faj-compile(head(args)));
        def fat-jq-flags(docs, args, input, options, i) = i >= str_len(head(args)) ? ((Comparable) i == 1 ? fat-fail("unsupported-jq-option", docs) : fat-jq-args(docs, tail(args), input, options)) : fat-has(list("r", "c", "e", "s", "n"), byte_to_str(fat-char(head(args), i))) ? fat-jq-flags(docs, args, input, far-set(options, byte_to_str(fat-char(head(args), i)), 1), i + 1) : fat-fail("unsupported-jq-option", docs);
        def fat-jq-bind(docs, args, input, options) = len(args) < 3 ? fat-fail("jq-binding-needs-name-value", docs) : !faj-name(args[1]) ? fat-fail("invalid-jq-variable-name", docs) : ((String) head(args) == "--argjson") && (!faj-valid(args[2])) ? fat-fail("invalid-json-binding", docs) : fat-jq-args(docs, fat-drop(args, 3), input, far-push(options, "vars", list(args[1], (String) head(args) == "--argjson" ? faj-json("resident-variable", args[2]) : intern_trivial_string(args[2]))));
        def fat-jq-compiled(docs, options, paths, input, compiled) = !((String) compiled[1] == "") ? fat-fail(compiled[1], docs) : !faj-bound(head(compiled), far-get(options, "vars", list())) ? fat-fail("unbound-variable", docs) : fat-jq-input(docs, options, head(compiled), far-get(options, "n", 0) ? list("null", "") : nil?(paths) ? list(input, "") : fat-json-files(docs, paths, ""));
        def fat-json-files(docs, paths, out) = nil?(paths) ? list(out, "") : fat-json-file(docs, paths, out, fat-find-doc(docs, head(paths)));
        def fat-json-file(docs, paths, out, doc) = nil?(doc) ? list("", "resident-document-not-found") : fat-json-files(docs, tail(paths), out ++ doc[2] ++ "\n");
        def fat-jq-input(docs, options, ast, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : fat-jq-parsed(docs, options, ast, fat-json-stream(head(r), 0, list()));
        def fat-json-stream(s, at, out) = fat-skip(s, at) >= str_len(s) ? faj-values(fat-reverse(out)) : fat-json-value(s, fat-skip(s, at), out, faj-end(s, at, 0));
        def fat-json-value(s, start, out, end) = end <= start ? faj-bad("invalid-json-input") : (end < str_len(s)) && (!fat-ws(fat-char(s, end))) ? faj-bad("invalid-json-input") : fat-json-stream(s, end, cons(faj-json("resident-json-input", substring(s, start, end)), out));
        def fat-jq-parsed(docs, options, ast, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : fat-jq-evaluated(docs, options, faj-each(ast, far-get(options, "s", 0) ? list(faj-array(head(r))) : head(r), far-get(options, "vars", list())));
        def fat-jq-evaluated(docs, options, r) = !((String) r[1] == "") ? fat-fail(r[1], docs) : fat-result(far-get(options, "e", 0) ? (nil?(head(r)) ? 4 : faj-truth(head(fat-reverse(head(r)))) ? 0 : 1) : 0, faj-render(head(r), far-get(options, "r", 0)), "", docs);
    }
}
