        def fat-tr-escape(s, i, out) = if (!fat-has(["n", "r", "t", "\\"], byte_to_str(fat-char(s, (i + 1))))) then ["", "unsupported-tr-escape"] else fat-tr-set(s, (i + 2), ((String) out + byte_to_str(if ((Comparable) fat-char(s, (i + 1)) == FatByteN()) then FatByteLf() else if ((Comparable) fat-char(s, (i + 1)) == FatByteR()) then FatByteCr() else if ((Comparable) fat-char(s, (i + 1)) == FatByteT()) then FatByteTab() else FatByteSlash())));
        def fat-tr-sets(docs, input, remove, from, to) = if (!((String) from[1] == "")) then fat-fail(from[1], docs) else if (!((String) to[1] == "")) then fat-fail(to[1], docs) else if remove then fat-ok(fat-delete-chars(input, to[0], 0), docs) else if (!((Comparable) len(from[0]) == len(to[0]))) then fat-fail("tr-supports-equal-length-literal-sets", docs) else fat-ok(sh-tr-str(input, from[0], to[0]), docs);
        def fat-delete-chars(s, chars, i) = if (i >= len(s)) then "" else ((String) (if (str_find(chars, byte_to_str(fat-char(s, i)), 0) >= 0) then "" else byte_to_str(fat-char(s, i))) + fat-delete-chars(s, chars, (i + 1)));
        def fat-cut(docs,args,input) = len(args)<4 || args[0]!="-d" || args[2]!="-f" ? fat-fail("cut-needs-d-delimiter-f-field",docs) : len(args[1])!=1 || !fat-natural(args[3]) || str_to_int(args[3])<=0 ? fat-fail("invalid-cut-field",docs) : fat-input(docs,args[4:],input,r=>fat-cut-ready(docs,args[1],str_to_int(args[3]),r));
        def fat-cut-ready(docs, delimiter, field, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-ok(fat-cut-lines(sh-lines(r[0]), delimiter, field), docs);
        def fat-cut-lines(lines, delimiter, field) = if nil?(lines) then "" else (fat-cut-line(lines[0], delimiter, field) + ("\n" + fat-cut-lines(lines[1:], delimiter, field)));
        def fat-cut-line(line, delimiter, field) = str_find(line,delimiter,0)<0 ? line : { let fields=split-on(line,delimiter); field>len(fields) ? "" : fields[field - 1]; };
        def fat-awk-field(program) {
            let text=fat-trim(program); let prefix="{print $";
            let field=fat-starts(text,prefix) && fat-ends(text,"}") ? substring(text,len(prefix),len(text) - 1) : "";
            fat-natural(field) ? str_to_int(field) : nothing();
        }
        def fat-awk(docs,args,input) = nil?(args) ? fat-fail("awk-needs-program",docs) : {
            let field=fat-awk-field(args[0]);
            nothing?(field) ? fat-fail("awk-supports-single-field-print",docs) : fat-input(docs,args[1:],input,r=>fat-awk-ready(docs,field,r));
        };
        def fat-awk-ready(docs, field, r) = r[1]!="" ? fat-fail(r[1],docs) : fat-ok(sh-join-nl(sh-lines(r[0]) |> map(line=>sh-awk-field(line,field))),docs);

        def fat-jq(docs, args, input) = fat-jq-args(docs, args, input, []);
        def fat-jq-args(docs, args, input, options) = if nil?(args) then fat-fail("jq-needs-filter", docs) else if (((String) args[0] == "--arg") || ((String) args[0] == "--argjson")) then fat-jq-bind(docs, args, input, options) else if fat-starts(args[0], "-") then fat-jq-flags(docs, args, input, options, 1) else fat-jq-compiled(docs, options, args[1:], input, faj-compile(args[0]));
        def fat-jq-flags(docs, args, input, options, i) = if (i >= len(args[0])) then if ((Comparable) i == 1) then fat-fail("unsupported-jq-option", docs) else fat-jq-args(docs, args[1:], input, options) else if fat-has(["r", "c", "e", "s", "n"], byte_to_str(fat-char(args[0], i))) then fat-jq-flags(docs, args, input, far-set(options, byte_to_str(fat-char(args[0], i)), 1), (i + 1)) else fat-fail("unsupported-jq-option", docs);
        // json-serves: a jq expression the caller wrote. text: --argjson is that expression's own text binding; a name and a string stay cells.
        def fat-jq-bind(docs, args, input, options) = if (len(args) < 3) then fat-fail("jq-binding-needs-name-value", docs) else if (!faj-name(args[1])) then fat-fail("invalid-jq-variable-name", docs) else if (((String) args[0] == "--argjson") && (!faj-valid(args[2]))) then fat-fail("invalid-json-binding", docs) else fat-jq-args(docs, fat-drop(args, 3), input, far-push(options, "vars", [args[1], if ((String) args[0] == "--argjson") then faj-json("resident-variable", args[2]) else intern_trivial_string(args[2])]));
        def fat-jq-compiled(docs,options,paths,input,compiled) = compiled[1] != "" ? fat-fail(compiled[1],docs) : !faj-bound(compiled[0],far-get(options,"vars",[])) ? fat-fail("unbound-variable",docs) : far-get(options,"n",0) ? fat-jq-input(docs,options,compiled[0],["null",""]) : nil?(paths) ? fat-jq-input(docs,options,compiled[0],[input,""]) : fat-source(docs,paths,sources=>fat-jq-input(docs,options,compiled[0],fat-json-files(sources,paths,"")));
        def fat-json-files(docs, paths, out) = if nil?(paths) then [out, ""] else fat-json-file(docs, paths, out, fat-find-doc(docs, paths[0]));
        def fat-json-file(docs, paths, out, doc) = if nil?(doc) then ["", "resident-document-not-found"] else fat-json-files(docs, paths[1:], (out + (doc[2] + "\n")));
        def fat-jq-input(docs, options, ast, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-jq-parsed(docs, options, ast, fat-json-stream(r[0], 0, []));
        def fat-json-stream(s, at, out) = if (fat-skip(s, at) >= len(s)) then faj-values(fat-reverse(out)) else fat-json-value(s, fat-skip(s, at), out, faj-end(s, at, 0));
        // json-serves: a jq program whose input is text. text: the input language is JSON, so the value is admitted once from those bytes.
        def fat-json-value(s, start, out, end) = if (end <= start) then faj-bad("invalid-json-input") else if ((end < len(s)) && (!fat-ws(fat-char(s, end)))) then faj-bad("invalid-json-input") else fat-json-stream(s, end, cons(faj-json("resident-json-input", substring(s, start, end)), out));
        def fat-jq-parsed(docs, options, ast, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-jq-evaluated(docs, options, faj-each(ast, if far-get(options, "s", 0) then [faj-array(r[0])] else r[0], far-get(options, "vars", [])));
        def fat-jq-evaluated(docs, options, r) = if (!((String) r[1] == "")) then fat-fail(r[1], docs) else fat-with-value(fat-result(if far-get(options, "e", 0) then if nil?(r[0]) then 4 else if faj-truth(fat-reverse(r[0])[0]) then 0 else 1 else 0, [r[0], far-get(options, "r", 0), "\n"], "", docs),faj-array(r[0]));
    }
    let fat-api-held=record_new(0);
}
