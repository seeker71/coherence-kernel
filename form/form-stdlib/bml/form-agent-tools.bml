        };
        def fat-checked(result,docs) = fat-output?(result[2]) && (fat-text?(result[2]) || fat-has-value?(result)) && fat-docs-valid(fat-documents(result), []) ? result : fat-fail("invalid-resident-output", docs);
        def fat-with-docs(result, docs) = append(result[0:4], cons(docs, result[5:]));
        def fat-dispatch(docs, tool, args, input) = if ((String) tool == "rg") then {
