//////////////////////////////////////////////////////////////////////
//
// form-cli-flow.bml
//
// High-grammar BML authority for the form-cli flow: named constants,
// abstract reusable shapes, templates, generics, class methods, and
// the Form primitives choice / cut / restore as methods of one organ.
//
// This file is the picture. The executable lowering that fkwu compiles
// and walks lives beside it at form-stdlib/form-cli-flow.bml
// (generic class FormCliFlow<T>, fields as named constants, methods
// hoisted bare — the FileIO<T> door).
//
// Lineage:
//   thesis Cut.bml / Rule.bml / BMF.bml  (package, class, const, Primitive)
//   kernel-core.bml                      (interface, class, const, Array<T>)
//   form-fs.bml                          (abstract reusable Path / IFormFilesystem)
//   host-kernel-interface.bml            (template<THandle,TValue> interface)
//   file-io.bml                          (class FileIO<T> that actually runs)
//   api.bml RouteCell<TRequest,TResponse> (template + class specialization)
//
// form.lift infix (`a + b`, `allow f() = ...`) is a cursor dialect, not
// this grammar. A census that counted form.lift as high BML was the
// costume. This file is the correction.
//
// Proven by: form-stdlib/tests/form-cli-flow-bml-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.flow;

import Form.kernel.*;
import BMF.primitive.*;

enum Grain [public] {
   COMPOST,
   LIQUID,
   ICE
}

enum WalkLane [public] {
   NATIVE,
   LOCAL,
   REMOTE
}

interface IChoiceWalk [public, witness, reusable] {
   section [public] {
      const int Nothing = -1;
      const int LaneNative = 0;
      const int LaneLocal = 1;
      const int LaneRemote = 2;

      int Ready( int nFlag, int nLane ) [abstract];
      int Choice( int nFirst, int nRest ) [abstract];
      int Cut( int nCapability, int nScore ) [abstract];
      int Restore( int nCheckpoint ) [abstract];
      int Walk( int nNativeHit, int nLocalReady ) [abstract];
   }
}

interface IIngest [public, witness, reusable] {
   section [public] {
      const int DepthFloor = 3;
      const int Compost = 0;
      const int Liquid = 1;
      const int Ice = 2;

      int Ingest( int nDepth, int nFear ) [abstract];
   }
}

template<Object THit, Object TReady> interface IWalkCell [public, reusable] {
   section [public] {
      THit Native() [get];
      TReady Local() [get];
      THit Remote() [get];
   }
}

template BackendCell<TName> [public, reusable] {
   section [private] {
      TName m_hName;
      int m_nSovereignty;
      int m_nTrust;
      int m_nCapability;
      int m_nConfidence;
   }

   section [public] {
      TName Name() [get];
      int Sovereignty() [get];
      int Trust() [get];
      int Capability() [get];
      int Confidence() [get];
   }
}

template IngestCell<TUnit> [public, reusable] {
   section [public] {
      TUnit Depth() [get];
      TUnit Fear() [get];
      int Ingest() [abstract];
   }
}

class WalkCut [public] : Primitive {
   section [public] {
      String AsString() { return "#primitive(cut)"; }
      String AsCreateString() { return "Form.cli.flow.WalkCut()"; }

      int Apply( int nCapability, int nScore ) {
         if ( nCapability == 0 ) return 0;
         return nScore;
      }
   }
}

class FormCliRouter [public, value, reusable, flow] : IChoiceWalk {
   section [private] {
      BackendCell<String>[] m_hBackends;
   }

   section [public] {
      const int WeightSovereignty = 2;
      const int WeightTrust = 2;
      const int WeightCapability = 1;
      const int WeightConfidence = 1;
      const int WeightDivisor = 6;
      const String NameNative = "form-native";
      const String NameAgent = "agent-cli";

      FormCliRouter() {
         m_hBackends = Array<BackendCell<String>>();
      }

      int Ready( int nFlag, int nLane ) [abstract] {}
      int Choice( int nFirst, int nRest ) [abstract] {}
      int Cut( int nCapability, int nScore ) [abstract] {}
      int Restore( int nCheckpoint ) [abstract] {}
      int Walk( int nNativeHit, int nLocalReady ) [abstract] {}

      int Score( BackendCell<String> hBackend ) [abstract];
      int Fitness( BackendCell<String> hBackend ) [abstract];
      String Route( BackendCell<String> hNative, BackendCell<String> hAgent ) [abstract];
      bool FlipsLocal( BackendCell<String> hBefore, BackendCell<String> hAfter, BackendCell<String> hAgent ) [abstract];
   }
}

class KnowledgeIngest [public, value, reusable, flow] : IIngest {
   section [public] {
      const int DepthFloor = 3;
      const int Compost = 0;
      const int Liquid = 1;
      const int Ice = 2;

      KnowledgeIngest() {}

      int Ingest( int nDepth, int nFear ) [abstract] {}
   }
}

class FormCliFlowSelf [public, selfHosting, flow, observable] {
   section [public] {
      const String CoreName = "form-cli-flow-self";
      const String Pattern = "named-const template generic class-method choice-cut-restore";
      const String ExecutablePath = "form/form-stdlib/form-cli-flow.bml";
      const String TrustRule = "weights and grains are named fields, never magic numbers in the methods";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
