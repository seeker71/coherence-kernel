// A source-backed answer through the native voice, with caller checks outside it.
// preludes: form-stdlib/bml/form-cli-response-shared.bml form-stdlib/bml/form-cli-native-voice.bml
section [form.bml] {
 class FormCliResponseVoice {
  def frsv-path(member) = json-object-has?(member,"response_path") ? fcap-string(member,"response_path") : "agent";
  def frsv-request-valid(request) {
   let queries = json-object-get(request,"source_queries");
   let noQueries = (!json-object-has?(request,"source_queries")) || (fat-wire-array?(queries) && nil?(node_children(queries)));
   let limit = fcnv-number(request,"max_reply_tokens",fcnv-limit());
   let context = fcnv-number(request,"context",fcnv-context());
   ((String) fcaq-mode(request) == "review") && (((String) fcaq-document-context(request) == "full") && (noQueries && fcnv-allowance-valid(context,limit)));
  }
  def frsv-member-valid(member) = (String) frsv-path(member) == "agent" ? 1 : (String) frsv-path(member) == "voice" ? frsv-request-valid(json-object-get(member,"request")) : 0;
  def frsv-packet(request) = fcap-string(request,"goal") ++ "\n\nSupplied sources:\n" ++ json-emit(json-object-get(request,"documents"));
  def frsv-result(request,voice,source) {
   let answered = ((Comparable) head(source) == 1) && (((String) voice[0] == "answered") && (((Comparable) voice[5] == 1) && ((Comparable) voice[6] == 1)));
   let report = answered ? voice[1] : "";
   let state = !((Comparable) voice[6] == 1) ? "release-incomplete" : answered ? "complete" : "attention";
   let fields = list(nsm-s("schema","form-native-response-voice-v1"),nsm-s("mode","review"),nsm-s("status",state),nsm-s("reason",(Comparable) head(source) == 1 ? voice[7] : source[1]),nsm-s("report",report),nsm-s("report_source",answered ? "native-voice" : "none"),nsm-n("turns",voice[3] > 0 ? 1 : 0),nsm-n("tool_calls",0),nsm-n("repair_attempts",0),nsm-n("check_runs",0),nsm-n("generated_ids",voice[3]),nsm-n("injected_ids",0),nsm-n("release_ok",voice[6]),nsm-n("source_checks_prechecked",head(source)),json-node-pair("documents",json-object-get(request,"documents")));
   let detail = list(json-node-pair("generation",fcnv-metadata(voice)),nsm-s("profile",fcnv-profile()),nsm-s("unaccepted_response",answered ? "" : voice[8]),nsm-s("execution_scope","one native generation; full supplied sources; no model tools, agent stages, reasoning reserve or training; session rechecks original source/report assertions"));
   json-emit(json-node-object(append(fields,detail)));
  }
  def frsv-run(request) {
   !(frsh-request-valid(request) && frsv-request-valid(request)) ? form_error("native voice requires a read-only evaluation with full documents, no source queries and a valid generation allowance") : {
    let source = fcaq-check(node_children(json-object-get(request,"checks")),fat-wire-value(fat-wire-documents(request)));
    let voice = (Comparable) head(source) == 1 ? fcnv-ask(frsv-packet(request),request) : fcnv-none("not-asked","","source-check-failed");
    frsv-result(request,voice,source);
   };
  }
  def frsv-result-path-valid(row,result) = (String) frsv-path(row) == "voice" ? ((String) fcap-string(result,"schema") == "form-native-response-voice-v1") : (((String) frsv-path(row) == "agent") && (!((String) fcap-string(result,"schema") == "form-native-response-voice-v1")));
 }
 0;
}
