   let tail = if eq(width,64) then "if(s==0u) return v; return (v>>s)|(ulong(p[b+8ul])<<(64u-s)); }\n" else if eq(bytes,8) then str-join-with(list("v>>=s; if(s>",int_to_str(sub(64,width)),"u) v|=ulong(p[b+8ul])<<(64u-s); return v&((1ul<<",int_to_str(width),"u)-1ul); }\n"),"") else str-join-with(list(if eq(mod(width,8),1) then "" else str-join-with(list("if(s>",int_to_str(sub(mul(bytes,8),width)),"u) v|=ulong(p[b+",int_to_str(bytes),"ul])<<",int_to_str(mul(bytes,8)),"u; "),""),"return (v>>s)&((1ul<<",int_to_str(width),"u)-1ul); }\n"),"");
   str_concat(prefix,tail);
