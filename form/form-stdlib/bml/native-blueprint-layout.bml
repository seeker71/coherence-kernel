  def nbl-valid?(layout) = if (!((String) value_kind(layout) == "list")) then 0 else if (!((Comparable) len(layout) == 4)) then 0 else if (!((String) head(layout) == "native-blueprint-layout-v1")) then 0 else if (!(nbl-int?(nbl-bits(layout)) && nbl-int?(nbl-count(layout)))) then 0 else if ((nbl-bits(layout) <= 0) || (nbl-count(layout) <= 0)) then 0 else if (!((String) value_kind(nbl-fields(layout)) == "list")) then 0 else if (nil?(nbl-fields(layout)) || (!((Comparable) nbl-count(layout) == len(nbl-fields(layout))))) then 0 else nbl-valid-fields(nbl-fields(layout),0,list(),nbl-bits(layout));
  def nbl-valid-fields(fields,offset,names,bits) = if nil?(fields) then ((Comparable) offset == bits) else {
   let field = head(fields);
   if (!((String) value_kind(field) == "list")) then 0 else if (!((Comparable) len(field) == 4)) then 0 else nbl-valid-field(fields,field,offset,names,bits);
  };
  def nbl-valid-field(fields,field,offset,names,bits) {
   let name = nth(field,0); let width = nth(field,2);
   if (!(((String) value_kind(name) == "string") && (nbl-int?(width) && nbl-int?(nth(field,1))))) then 0 else if (((Comparable) str_len(name) == 0) || (nbl-seen(names,name) || ((width < 1) || (width > 64)))) then 0 else if (!nbl-format?(width,nth(field,3))) then 0 else if ((!((Comparable) nth(field,1) == offset)) || (offset > (4611686018427387903 - width))) then 0 else nbl-valid-fields(tail(fields),(offset + width),cons(name,names),bits);
  }
  def nbl-cmp-x(rn,rm) = fa-asm(3942645791,list(32,65536),list(rn,rm));
  def nbl-immediate(rd,value) = list(fa-movz-x(rd,(value % 65536)),fa-movk-x(rd,((value / 65536) % 65536),1),fa-movk-x(rd,((value / 4294967296) % 65536),2),fa-movk-x(rd,(value / 281474976710656),3));
