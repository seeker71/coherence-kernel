  };
  def nbl-msl-value(field,stride) = if and(eq(nth(field,2),64),and(eq(mod(stride,64),0),eq(mod(nth(field,1),64),0))) then str-join-with(list("reinterpret_cast<device const ulong *>(p)[ulong(row)*",int_to_str(div(stride,64)),"ul+",int_to_str(div(nth(field,1),64)),"ul]"),"") else str-join-with(list("nbl_w",int_to_str(nth(field,2)),"(p,ulong(row)*",int_to_str(stride),"ul+",int_to_str(nth(field,1)),"ul)"),"");
  def nbl-msl-rows(fields,index,total,stride,out,numeric) = if nil?(fields) then out else {
   let field = head(fields);
   let value = nbl-msl-value(field,stride);
   let converted = if and(numeric,not(str_eq(nth(field,3),"raw"))) then str_concat("ulong(as_type<uint>(",str_concat(nbf-msl(nth(field,3),value),"))")) else value;
   let line = str-join-with(list("o[ulong(row)*",int_to_str(total),"ul+",int_to_str(index),"ul]=",converted,";\n"),"");
   nbl-msl-rows(tail(fields),add(index,1),total,stride,str_concat(out,line),numeric);
