   };
  }
  def nbl-pack-region(owner,raw,count,payload,allocated,region) {
   let result = if ((Comparable) count == 0) then 0 else nbl-call(owner,list(0,raw,npd-span(region,0,allocated),count));
   if (!((Comparable) result == count)) then { npd-region-close(region); nbl-unease(owner,"field-width","bits-representable-by-blueprint"); } else {
    record_set(region,"node-storage-generation",1); record_new(0,"kind","native-blueprint-run","owner",owner,"region",region,"count",count,"payload-bytes",payload,"allocated-bytes",allocated,"readers",0,"retired",0);
   };
  }
  def nbl-held?(run) = if (!record?(run)) then 0 else if (!((String) record_get(run,"kind") == "native-blueprint-run")) then 0 else (nbl-active(record_get(run,"owner")) && ((Comparable) record_get(record_get(run,"region"),"active") == 1));
  def nbl-run?(run) = if (!nbl-held?(run)) then 0 else ((Comparable) record_get(run,"retired") == 0);
