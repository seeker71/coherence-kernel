  }
  def nbl-word-field?(field,stride) = (((Comparable) nth(field,2) == 64) && (((Comparable) (nth(field,1) % 8) == 0) && ((Comparable) (stride % 8) == 0)));
  def nbl-native-word(mode) = if ((Comparable) mode == 0) then list(fa-ldr(7,16,0),nfm-ubfx(8,6,3,63),fa-add-x-r(10,1,8),nns-str(7,10,0),fa-add-x-imm(16,16,8),fa-add-x-imm(6,6,64),fa-sub-x-imm(2,2,8)) else list(nfm-ubfx(8,6,3,63),fa-add-x-r(10,1,8),fa-ldr(7,10,0),nns-str(7,4,0),fa-add-x-imm(4,4,8),fa-add-x-imm(6,6,64));
