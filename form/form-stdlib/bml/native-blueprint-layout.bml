   record_set(run,"readers",(record_get(run,"readers") + 1)); record_new(0,"kind","native-blueprint-reader","run",run,"active",1);
  };
  def nbl-reader?(reader) = if (!record?(reader)) then 0 else if (!((String) record_get(reader,"kind") == "native-blueprint-reader")) then 0 else (((Comparable) record_get(reader,"active") == 1) && nbl-held?(record_get(reader,"run")));
