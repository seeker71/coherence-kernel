  def nbl-msl(layout) = nbl-msl-mode(layout,0);
  // Metal numeric slots carry fp32 bits in the low half of a u64 output slot.
  def nbl-msl-numeric(layout) = nbl-msl-mode(layout,1);
  def nbl-msl-mode(layout,numeric) = if not(nbl-valid?(layout)) then nothing() else mj-source(str_concat(str_concat(nbl-msl-widths(nbl-fields(layout),list(),""),if numeric then nbf-msl-helpers() else ""),str_concat("kernel void nbl_project(device const uchar *p [[buffer(0)]], device ulong *o [[buffer(1)]], uint row [[thread_position_in_grid]]) {\n",str_concat(nbl-msl-rows(nbl-fields(layout),0,nbl-count(layout),nbl-bits(layout),"",numeric),"}\n"))));
 }
