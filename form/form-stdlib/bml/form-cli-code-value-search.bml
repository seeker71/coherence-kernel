// The coding policy supplies writable admission and the same source checker
// used by verify. This bridge cannot accept a checker or command from a model.
// Return [resident-tool-result, actual-check-count].
// preludes: form-stdlib/bml/form-agent-tool-wire.bml form-stdlib/bml/form-bml-value-search.bml
section [form.bml] {
 class FormCliCodeValueSearch {
  def fcbvs-guidance() = "The native rehearse-bml tool takes arguments=[path] and empty input, with at most " ++ int_to_str(fbvs-limit()) ++ " caller checks. An optional second argument is a smaller positive decimal check budget. In implement it searches single bare-value wrappers using unary calls already present in that BML source, running the caller's unchanged source checks for each candidate. Only a passing candidate changes the writable document. It retains failed attempts and source hashes. This is a bounded repair family; it does not establish general correctness. ";
  def fcbvs-check(contract,source) {
   let [_, doc, checker] = contract;
   let callback = head(checker);
   callback(checker[1],fat-put-doc(head(contract),list(head(doc),doc[1],source)));
  }
  def fcbvs-rows(rows) = nil?(rows) ? list() : {
   let r = head(rows);
   cons(json-node-object(list(json-node-pair("start_byte",json-node-int(head(r))),json-node-pair("end_byte",json-node-int(r[1])),json-node-pair("wrapper",json-node-string(r[2])),json-node-pair("passed",json-node-int(r[3])),json-node-pair("observation",json-node-string(r[4])),json-node-pair("source_sha256",json-node-string(r[5])))),fcbvs-rows(tail(rows)));
  };
  def fcbvs-call(docs,args,input,checker) = !((((Comparable) len(args) == 1) || ((Comparable) len(args) == 2)) && ((String) input == "")) ? list(fat-fail("rehearse-bml-needs-path-optional-check-budget-and-empty-input",docs),0) : (Comparable) len(args) == 1 ? fcbvs-doc(docs,fat-find-doc(docs,head(args)),fbvs-limit(),checker) : !(fat-natural(args[1]) && (str_len(args[1]) <= str_len(int_to_str(fbvs-limit())))) ? list(fat-fail("rehearse-bml-check-budget-outside-range",docs),0) : fcbvs-doc(docs,fat-find-doc(docs,head(args)),str_to_int(args[1]),checker);
  def fcbvs-doc(docs,doc,budget,checker) = nil?(doc) ? list(fat-fail("resident-document-not-found",docs),0) : {
   let before = doc[2];
   let searched = fbvs-search(before,fcbvs-check,list(docs,doc,checker),budget);
   let [status, after, attempts] = searched;
   let passed = ((String) status == "repaired") || ((String) status == "unchanged");
   let observation = json-node-object(list(json-node-pair("method",json-node-string("native-bml-value-search")),json-node-pair("status",json-node-string(status)),json-node-pair("checks_run",json-node-int(len(attempts))),json-node-pair("before_sha256",json-node-string(hex-encode(sha256-stream-string(before)))),json-node-pair("after_sha256",json-node-string(hex-encode(sha256-stream-string(after)))),json-node-pair("attempts",json-node-array(fcbvs-rows(attempts))),json-node-pair("scope",json-node-string("single value wrapper; caller checks passed only when status is repaired or unchanged; review the resulting change"))));
   let next = passed ? fat-put-doc(docs,list(head(doc),doc[1],after)) : docs;
   list(fat-bounded(fat-result(passed ? 0 : 2,json-emit(observation),passed ? "" : searched[3],next),docs),len(attempts));
  };
 }
 0;
}
