// The coding policy supplies writable admission and the same source checker
// used by verify. This bridge cannot accept a checker or command from a model.
// Return [resident-tool-result, actual-check-count].
// preludes: form-stdlib/bml/form-agent-tool-wire.bml form-stdlib/bml/form-bml-value-search.bml
section [form.bml] {
 class FormCliCodeValueSearch {
  def fcbvs-guidance() = str_concat("The native rehearse-bml tool takes arguments=[path] and empty input, with at most ",str_concat(int_to_str(fbvs-limit())," caller checks. An optional second argument is a smaller positive decimal check budget. In implement it searches single bare-value wrappers using unary calls already present in that BML source, running the caller's unchanged source checks for each candidate. Only a passing candidate changes the writable document. It retains failed attempts and source hashes. This is a bounded repair family; it does not establish general correctness. "));
  def fcbvs-check(contract,source) {
   let doc = nth(contract,1);
   let checker = nth(contract,2);
   let callback = head(checker);
   callback(nth(checker,1),fat-put-doc(head(contract),list(head(doc),nth(doc,1),source)));
  }
  def fcbvs-rows(rows) = if nil?(rows) then list() else {
   let r = head(rows);
   cons(json-node-object(list(json-node-pair("start_byte",json-node-int(head(r))),json-node-pair("end_byte",json-node-int(nth(r,1))),json-node-pair("wrapper",json-node-string(nth(r,2))),json-node-pair("passed",json-node-int(nth(r,3))),json-node-pair("observation",json-node-string(nth(r,4))),json-node-pair("source_sha256",json-node-string(nth(r,5))))),fcbvs-rows(tail(rows)));
  };
  def fcbvs-call(docs,args,input,checker) = if not(and(or(eq(len(args),1),eq(len(args),2)),str_eq(input,""))) then list(fat-fail("rehearse-bml-needs-path-optional-check-budget-and-empty-input",docs),0) else if eq(len(args),1) then fcbvs-doc(docs,fat-find-doc(docs,head(args)),fbvs-limit(),checker) else if not(and(fat-natural(nth(args,1)),le(str_len(nth(args,1)),str_len(int_to_str(fbvs-limit()))))) then list(fat-fail("rehearse-bml-check-budget-outside-range",docs),0) else fcbvs-doc(docs,fat-find-doc(docs,head(args)),str_to_int(nth(args,1)),checker);
  def fcbvs-doc(docs,doc,budget,checker) = if nil?(doc) then list(fat-fail("resident-document-not-found",docs),0) else {
   let before = nth(doc,2);
   let searched = fbvs-search(before,fcbvs-check,list(docs,doc,checker),budget);
   let status = head(searched); let after = nth(searched,1); let attempts = nth(searched,2);
   let passed = or(str_eq(status,"repaired"),str_eq(status,"unchanged"));
   let observation = json-node-object(list(json-node-pair("method",json-node-string("native-bml-value-search")),json-node-pair("status",json-node-string(status)),json-node-pair("checks_run",json-node-int(len(attempts))),json-node-pair("before_sha256",json-node-string(hex-encode(sha256-stream-string(before)))),json-node-pair("after_sha256",json-node-string(hex-encode(sha256-stream-string(after)))),json-node-pair("attempts",json-node-array(fcbvs-rows(attempts))),json-node-pair("scope",json-node-string("single value wrapper; caller checks passed only when status is repaired or unchanged; review the resulting change"))));
   let next = if passed then fat-put-doc(docs,list(head(doc),nth(doc,1),after)) else docs;
   list(fat-bounded(fat-result(if passed then 0 else 2,json-emit(observation),if passed then "" else nth(searched,3),next),docs),len(attempts));
  };
 }
 0;
}
