// The coding policy supplies writable admission and the same source checker
// used by verify. This bridge cannot accept a checker or command from a model.
// Return [resident-tool-result, actual-check-count].
import form-stdlib/bml/form-agent-tool-wire.bml;
import form-stdlib/bml/form-bml-value-search.bml;
section [form.bml] {
 class FormCliCodeValueSearch {
  def fcbvs-guidance() = "The native rehearse-bml tool takes arguments=[path] and empty input. It observes the source's actual candidate frontier. An optional second argument supplies a caller-owned positive check allowance. Each candidate runs the caller's unchanged source checks, and only a passing candidate changes the document. Failed attempts and source hashes remain available; this repair family does not establish general correctness. ";
  def fcbvs-check(contract,source) {
   let doc = contract[1];
   let checker = contract[2];
   let callback = checker[0];
   callback(checker[1],fat-put-doc(contract[0],[doc[0],doc[1],source]));
  }
  def fcbvs-rows(rows) = if nil?(rows) then [] else {
   let r = rows[0];
   cons(json-node-object([json-node-pair("start_byte",json-node-int(r[0])),json-node-pair("end_byte",json-node-int(r[1])),json-node-pair("wrapper",json-node-string(r[2])),json-node-pair("passed",json-node-int(r[3])),json-node-pair("observation",json-node-string(r[4])),json-node-pair("source_sha256",json-node-string(r[5]))]),fcbvs-rows(rows[1:]));
  };
  def fcbvs-call(docs,args,input,checker) = if (!((((Comparable) len(args) == 1) || ((Comparable) len(args) == 2)) && ((String) input == ""))) then [fat-fail("rehearse-bml-needs-path-optional-check-budget-and-empty-input",docs),0] else if ((Comparable) len(args) == 1) then fcbvs-doc(docs,fat-find-doc(docs,args[0]),nothing(),checker) else if (!fat-natural(args[1]) || str_to_int(args[1])<=0 || str_to_int(args[1]).str()!=args[1]) then [fat-fail("rehearse-bml-check-budget-not-positive-native-integer",docs),0] else fcbvs-doc(docs,fat-find-doc(docs,args[0]),str_to_int(args[1]),checker);
  def fcbvs-doc(docs,doc,budget,checker) = if nil?(doc) then [fat-fail("resident-document-not-found",docs),0] else {
   let before = doc[2];
   let searched = fbvs-search(before,fcbvs-check,[docs,doc,checker],budget);
   let status = searched[0]; let after = searched[1]; let attempts = searched[2];
   let passed = (((String) status == "repaired") || ((String) status == "unchanged"));
   let observation = json-node-object([json-node-pair("method",json-node-string("native-bml-value-search")),json-node-pair("status",json-node-string(status)),json-node-pair("checks_run",json-node-int(len(attempts))),json-node-pair("before_sha256",json-node-string(hex-encode(sha256-stream-string(before)))),json-node-pair("after_sha256",json-node-string(hex-encode(sha256-stream-string(after)))),json-node-pair("attempts",json-node-array(fcbvs-rows(attempts))),json-node-pair("scope",json-node-string("add or remove one unary call; caller checks passed only when status is repaired or unchanged; review the resulting change"))]);
   let next = if passed then fat-put-doc(docs,[doc[0],doc[1],after]) else docs;
   [fat-checked(fat-with-value(fat-result(if passed then 0 else 2,[[observation],0,""],if passed then "" else searched[3],next),observation),docs),len(attempts)];
  };
 }
 0;
}
