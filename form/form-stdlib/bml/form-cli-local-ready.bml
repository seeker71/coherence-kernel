//////////////////////////////////////////////////////////////////////
//
// form-cli-local-ready.bml — high-grammar authority for the local
// teach flywheel. Public diagnostic marks, never prompt text.
//
// Remote share on a Grok session is turn_started, not a local-fail
// tally. Local-ready is the overlay that keeps a named Form repair
// on this machine: native then local then remote.
//
// Executable lowering: form-stdlib/form-cli-local-ready.bml
//
// Proven by: form-stdlib/tests/form-cli-local-ready-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.localready;

import Form.kernel.*;
import Form.cli.flow.*;

enum ReadyLane [public] {
   NATIVE,
   LOCAL,
   REMOTE
}

interface ILocalReady [public, witness, reusable] {
   section [public] {
      const String UnbalancedMark = "unbalanced-source";
      const String UnresolvedMark = "unresolved-call";
      const String CachedMark = "cached image was compiled with errors";
      const String UnusableMark = "unusable .fkb";
      const String StaleMark = "stale .fkb";
      const String TimeoutMark = "timeout";
      const String HostLs = "ls";
      const String HostRg = "rg";
      const String CtrlUndo = "undo";
      const String CtrlCut = "cut";
      const String CtrlStop = "stop";
      const String CtrlTimeout = "timeout";
      const String CtrlNothing = "nothing";

      String ShapeOf( String strPublic ) [abstract];
      String Control( String strShape ) [abstract];
      int Ready( String strShape ) [abstract];
      int Walk( int nNativeHit, String strShape ) [abstract];
   }
}

template MissCell<TMark> [public, reusable] {
   section [public] {
      TMark Mark() [get];
      String Control() [get];
      int Ready() [abstract];
   }
}

class FormLocalReady [public, reusable, teach] : ILocalReady {
   section [public] {
      const String TrustRule = "public diagnostics only; prompt and answer stay off the page";
      const String ExecutablePath = "form/form-stdlib/form-cli-local-ready.bml";

      String ShapeOf( String strPublic ) [abstract] {}
      String Control( String strShape ) [abstract] {}
      int Ready( String strShape ) [abstract] {}
      int Walk( int nNativeHit, String strShape ) [abstract] {}
   }
}

class FormLocalReadySelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-local-ready-self";
      const String Pattern = "named-const template generic class-method flywheel-local-ready";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
