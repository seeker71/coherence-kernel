// One Form-emitted CPU SHA admission for a file, with caller-visible evidence. The file's whole blocks are walked in
// spans mapped for their run, then its last 0..63 bytes and the padding (native/metal/sha256-arm64-jit.fk, through the
// seed's door for Form-emitted CPU images). No handle is held after the digest, so nothing is left to release.
import native/metal/sha256-arm64-jit.fk;
section [form.bml] {
 class Sha256Owned {
  def sho-file(path) {
   let owner = sho-owner();
   let size = file_size(path);
   if (size < 0) then sho-refuse(owner,"file-absent") else sho-settle(owner,path,size,saj-file-digest-any-tail(path,size));
  }
  def sho-owner() = record_new(0,"digest","","reason","unobserved");
  def sho-refuse(owner,reason) = record_set(owner,"reason",reason);
  def sho-accept(owner,digest) {
   let reason = record_set(owner,"reason","ready");
   record_set(owner,"digest",digest);
  }
  def sho-settle(owner,path,size,digest) = if (!((Comparable) file_size(path) == size)) then sho-refuse(owner,"file-size-changed") else if (!((Comparable) len(digest) == 32)) then sho-refuse(owner,"digest-refused") else sho-accept(owner,digest);
 }
 0;
}
