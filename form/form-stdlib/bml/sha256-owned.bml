// One Form-emitted CPU SHA admission, with caller-visible release evidence.
// Input pages are mapped; only the last 0..63 bytes and padding are copied.
// preludes: native/metal/sha256-arm64-jit.fk form-stdlib/bml/metal-jit.bml
section [form.bml] {
 class Sha256Owned {
  def sho-free(handles,held) = nil?(handles) ? reverse(held) : sho-free-next(handles,held,head(handles) > 0 ? metal_buf_free(head(handles)) : 1);
  def sho-free-next(handles,held,rc) = sho-free(tail(handles),(Comparable) rc == 1 ? held : cons(head(handles),held));
  def sho-close(owner) {
   let held = sho-free(record_get(owner,"buffers"),list());
   let freed = record_get(owner,"pipeline") > 0 ? mj-release-handle(record_get(owner,"pipeline")) : 1;
   let buffers = record_set(owner,"buffers",held);
   let pipeline = (Comparable) freed == 1 ? record_set(owner,"pipeline",0) : owner;
   nil?(held) && ((Comparable) freed == 1);
  }
  def sho-file(path) {
   let owner = sho-owner();
   let size = file_size(path);
   size < 0 ? sho-refuse(owner,"file-absent") : sho-open(owner,path,size);
  }
  def sho-owner() = record_new(0,"buffers",list(),"pipeline",0,"digest","","reason","unobserved");
  def sho-refuse(owner,reason) = record_set(owner,"reason",reason);
  def sho-open(owner,path,size) = sho-read(owner,path,size,read_file_slice(path,size - (size % 64),size % 64));
  def sho-read(owner,path,size,tail) = nothing?(tail) ? sho-refuse(owner,"tail-read-refused") : !((Comparable) str_len(tail) == (size % 64)) ? sho-refuse(owner,"tail-read-short") : !((Comparable) file_size(path) == size) ? sho-refuse(owner,"file-size-changed") : sho-admit(owner,path,size,tail);
  def sho-admit(owner,path,size,tail) {
   let version = mj-memory(saj-code(),"form_cpu_jit");
   let pipeline = record_set(owner,"pipeline",mj-handle(version));
   let prefix = size - (size % 64);
   let message = sho-message(path,prefix);
   let padding = saj-padding-string(tail,size);
   let state = metal_buf_alloc(32); let rounds = metal_buf_alloc(256); let pad = metal_buf_alloc(str_len(padding));
   let buffers = record_set(owner,"buffers",list(message,state,rounds,pad));
   let ready = (mj-handle(version) > 0) && ((state > 0) && ((rounds > 0) && ((pad > 0) && (((Comparable) prefix == 0) || (message > 0)))));
   let digest = sho-admitted-digest(ready,mj-handle(version),message,state,rounds,pad,prefix,padding);
   sho-settle(owner,path,size,digest);
  }
  def sho-settle(owner,path,size,digest) {
   let closed = sho-close(owner);
   !closed ? sho-refuse(owner,"release-refused") : !((Comparable) file_size(path) == size) ? sho-refuse(owner,"file-size-changed") : !((Comparable) str_len(digest) == 32) ? sho-refuse(owner,"digest-refused") : sho-accept(owner,digest);
  }
  def sho-accept(owner,digest) {
   let reason = record_set(owner,"reason","ready");
   record_set(owner,"digest",digest);
  }
  def sho-message(path,prefix) = prefix > 0 ? metal_buf_from_file(path,0,prefix) : 0;
  def sho-admitted-digest(ready,pipeline,message,state,rounds,pad,prefix,padding) = ready ? sho-digest(pipeline,message,state,rounds,pad,prefix,padding) : "";
  def sho-digest(pipeline,message,state,rounds,pad,prefix,padding) {
   let sw = metal_buf_write(state,0,saj-initial-state-bytes());
   let rw = metal_buf_write(rounds,0,saj-round-constant-bytes());
   let pw = metal_buf_write(pad,0,padding);
   ((Comparable) sw == 32) && (((Comparable) rw == 256) && ((Comparable) pw == str_len(padding))) ? sho-compress(pipeline,message,state,rounds,pad,prefix,padding) : "";
  }
  def sho-compress(pipeline,message,state,rounds,pad,prefix,padding) {
   let first = sho-prefix(pipeline,message,state,rounds,prefix);
   let last = sho-last(first,pipeline,pad,state,rounds,padding);
   let raw = saj-read-state(last,state);
   (Comparable) str_len(raw) == 32 ? saj-state-digest(raw) : "";
  }
  def sho-prefix(pipeline,message,state,rounds,prefix) = prefix > 0 ? metal_enqueue(pipeline,md-bind(list(message,state,rounds),list(prefix / 64)),1) : 1;
  def sho-last(first,pipeline,pad,state,rounds,padding) = (Comparable) first == 1 ? metal_enqueue(pipeline,md-bind(list(pad,state,rounds),list(str_len(padding) / 64)),1) : 0;
 }
 0;
}
