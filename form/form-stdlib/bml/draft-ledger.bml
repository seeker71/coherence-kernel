// draft-ledger.bml — the one reader and writer of receipts/draft-ledger.jsonl's rows: a draft, its two readers, one reading row.
//
// A draft is an id whose rows carry a path (observe/prompt-draft-run.bml lands one each time it drafts). A redraft is the same draft
// at its latest path row, and a path row reads "pending", so a redraft is pending again. A path row whose voice spoke no text (voice
// neither answered nor incomplete, or generated 0: ten such rows stand from before the drafter stopped writing them) is no draft:
// no reader lists it, and its prompt stays open to the drafter (dl-drafts, dl-unspoken).
// A reading row is at_unix_ms, draft, reading, note, then what its reader adds after them (dl-reading-row, dl-land).
// Two readers read beside each other, and neither moves the other's list: our readings of record (observe/draft-reading-run.bml: a
// row with no reader, or a reader other than native-voice) and the body's own (observe/draft-native-reading-run.bml: reader
// native-voice). dl-of-record and dl-of-native are each reader's view of the ledger: every path row and that reader's readings. In a
// view, the latest row naming a draft is its reading there (dl-reading), and a draft is pending while that row is its path row.
// PROOF: form-stdlib/tests/draft-native-reading-band.bml (claims second-reader, one-row, unspoken).
import form-stdlib/bml/form-cli-heal-native-report.bml;
import form-stdlib/meaning-codes.bml;
section [form.bml] {
 class DraftLedger {
  def dl-ledger() = "receipts/draft-ledger.jsonl";
  def dl-native() = "native-voice";
  def dl-words() = ["accepted", "revised", "rejected"];
  def dl-word?(w) = any?(x => (String) x == w, dl-words());
  def dl-id(r) = fhn-text(r, "draft");
  def dl-path?(r) = (Comparable) len(fhn-text(r, "path")) > 0;
  def dl-native?(r) = (String) fhn-text(r, "reader") == dl-native();
  def dl-rows(path) = file_size(path) < 1 ? [] : map(x => parse-json("draft-row", x), filter(x => (Comparable) len(trim(x)) != 0, split-on(fhn-read(path), "\n")));
  // ---- each reader's view of the ledger
  def dl-of-record(rows) = filter(r => dl-path?(r) || !dl-native?(r), rows);
  def dl-of-native(rows) = filter(r => dl-path?(r) || dl-native?(r), rows);
  // ---- the drafts: each id's latest path row, at that row's place; a row whose voice spoke no text is no draft
  def dl-spoke?(r) = (fhn-count(r, "generated") > 0) && (((String) fhn-text(r, "voice") == "answered") || ((String) fhn-text(r, "voice") == "incomplete"));
  def dl-later?(id, rows) = nil?(rows) ? false : ((String) dl-id(rows[0]) == id) && dl-path?(rows[0]) ? true : dl-later?(id, rows[1:]);
  def dl-current(rows) = nil?(rows) ? [] : dl-path?(rows[0]) && !dl-later?(dl-id(rows[0]), rows[1:]) ? cons(rows[0], dl-current(rows[1:])) : dl-current(rows[1:]);
  // two packets reach the prompt capture as if we had typed them, each waking a session: the presence heartbeat's (~/.coherence-presence/wake.prompt.md) and a side session's
  // hand-off brief, which another mind wrote (the harness opens it with dl-handoff-mark). A draft of either is no draft of our words: no reader lists it, no row teaches it (their
  // rows run 10 to 16 KB, past any lift's max_chars), and the drafter leaves them out. So too a draft whose file holds no words at all (25 stand from before the drafter left
  // empty prompts out): it answers nothing and no row can carry it. A file without the drafter's marks is left for each reader to name
  def dl-wake-mark() = "You are Sema — the ";
  def dl-handoff-mark() = "Background (from the session that started this one):";
  def dl-starts?(words, mark) = (len(words) >= len(mark)) && ((String) substring(words, 0, len(mark)) == mark);
  def dl-wake-words?(words) = dl-starts?(words, dl-wake-mark()) || dl-starts?(words, dl-handoff-mark());
  def dl-asked-mark() = "# The person asked\n\n";
  def dl-answered-mark() = "\n\n# The body's draft\n\n";
  def dl-no-words?(words) = ((Comparable) len(words) == 0) || dl-wake-words?(words);
  def dl-no-words-before?(text, b) = (b >= len(dl-asked-mark())) && dl-no-words?(trim(substring(text, len(dl-asked-mark()), b)));
  def dl-no-words-file?(text) = dl-starts?(text, dl-asked-mark()) && dl-no-words-before?(text, str_find(text, dl-answered-mark(), 0));
  def dl-drafts(rows) = filter(r => dl-spoke?(r) && !dl-no-words-file?(read_file(fhn-text(r, "path")) ?? ""), dl-current(rows));
  def dl-unspoken(rows) = filter(r => !dl-spoke?(r), dl-current(rows));
  def dl-latest-path(id, rows) = foldl((acc, r) => ((String) dl-id(r) == id) && dl-path?(r) ? r : acc, nothing(), rows);
  // ---- the reading of a draft within a view
  def dl-reading(id, rows) = foldl((acc, r) => (String) dl-id(r) == id ? fhn-text(r, "reading") : acc, "", rows);
  def dl-note(id, reading, rows) = foldl((acc, r) => ((String) dl-id(r) == id) && ((String) fhn-text(r, "reading") == reading) ? fhn-text(r, "note") : acc, "", rows);
  def dl-latest-row(id, rows) = foldl((acc, r) => (String) dl-id(r) == id ? r : acc, nothing(), rows);
  def dl-pending(rows) = filter(d => (String) dl-reading(dl-id(d), rows) == "pending", dl-drafts(rows));
  // the body's reading of a draft becomes a trainer row only where we did not read it: what we accepted is a row already, what we rejected is never taught
  def dl-teaches?(id, ours) = !dl-word?(dl-reading(id, ours));
  // a native reading row whose word is the voice's own: no covenant predicate failed, so the voice was asked and this is what it said
  def dl-voice-read?(row) = !nothing?(row) && json-object-has?(row, "predicates_failed") && nil?(json-array-elements(json-object-get(row, "predicates_failed")));
  // ---- one reading row, whoever reads: the reader's own fields follow the shared four
  def dl-reading-row(id, reading, note, after) = json-node-object(append([fhn-n("at_unix_ms", now_unix_ms()), fhn-s("draft", id), fhn-s("reading", reading), fhn-s("note", note)], after));
  def dl-land(ledger, id, reading, note, after) = fhn-append(ledger, json-emit(dl-reading-row(id, reading, note, after)) ++ "\n");
 }
}
