// self-steer.bml — the register steers: each row it reads open, whose `next` names a band, becomes an offer the next movement can take.
//
// It reads the gaps file and the register's last row, no model and no network. A row that is not closed and whose `next` names a band (a path holding "-band")
// is offered: as a queue row when that band stands, so a band can witness the gap's closing, and as a finding when it does not. It writes one row to
// receipts/self-steer-ledger.jsonl (at_unix_ms, the register row it read, open, offered, queue, finding, share_pm, offers) and no other file: the queue
// (learn/native-turn-queue.jsonl) is written by whoever takes an offer, under that band's witness.
// A register with no open row offers nothing and reads 1000 pm. An absent register or gaps file is refused by name.
//   ss-run(opts)   the door: stdin options gaps, register, ledger, root (the directory a band path stands under)
// PROOF: form-stdlib/tests/offline-voice-gaps-band.bml, claim steer.
import form-stdlib/bml/offline-voice-gaps.bml;
section [form.bml] {
 class SelfSteer {
  def ss-door() = "self-steer";
  def ss-ledger() = "receipts/self-steer-ledger.jsonl";
  def ss-spec() = [["gaps", "str"], ["register", "str"], ["ledger", "str"], ["root", "str"]];
  def ss-opts() = dop-doc(ss-door(), stdin-text(), ss-spec());
  def ss-gap-of(gaps, id) = foldl((found, g) => (String) fcgp-str(g, "id") == id ? g : found, nothing(), gaps);
  def ss-band(gap) = nothing?(gap) ? "" : fcgp-str(fcgp-obj(gap, "next"), "band");
  def ss-names-band?(gap) = ep-has?(ss-band(gap), "-band");
  def ss-offer(gap, verdict, opts) {
   let band = ss-band(gap);
   let kind = (Comparable) host_path_exists(ovg-under(opts, band)) == 1 ? "queue" : "finding";
   let said = print_str("[self-steer] offer " ++ kind ++ " " ++ fcgp-str(gap, "id") ++ " (" ++ verdict ++ "): " ++ band ++ ": " ++ fcgp-str(fcgp-obj(gap, "next"), "step"));
   json-node-object([fhn-s("gap", fcgp-str(gap, "id")), fhn-s("kind", kind), fhn-s("verdict", verdict), fhn-s("band", band), fhn-s("step", fcgp-str(fcgp-obj(gap, "next"), "step"))]);
  }
  def ss-count(offers, kind) = len(filter(o => (String) fcgp-str(o, "kind") == kind, offers));
  def ss-pm(offered, open) = (Comparable) open == 0 ? 1000 : ovg-pm(offered, open);
  def ss-read(gaps, row, opts, ledgerPath) {
   let open = filter(v => (String) fcgp-str(v, "verdict") != "closed", json-array-elements(json-object-get(row, "verdicts")));
   let named = filter(v => ss-names-band?(ss-gap-of(gaps, fcgp-str(v, "id"))), open);
   let offers = map(v => ss-offer(ss-gap-of(gaps, fcgp-str(v, "id")), fcgp-str(v, "verdict"), opts), named);
   let kept = fhn-append(ledgerPath, json-emit(json-node-object([fhn-n("at_unix_ms", now_unix_ms()), fhn-n("register_at", fcgp-num(row, "at_unix_ms") ?? 0), fhn-n("open", len(open)), fhn-n("offered", len(offers)), fhn-n("queue", ss-count(offers, "queue")), fhn-n("finding", ss-count(offers, "finding")), fhn-n("share_pm", ss-pm(len(offers), len(open))), json-node-pair("offers", json-node-array(offers))])) ++ "\n");
   "[self-steer] " ++ len(offers).str() ++ " of " ++ len(open).str() ++ " open row(s) offered: " ++ ss-count(offers, "queue").str() ++ " queue, " ++ ss-count(offers, "finding").str() ++ " finding, " ++ ss-pm(len(offers), len(open)).str() ++ " pm; " ++ ledgerPath ++ " " ++ kept;
  }
  def ss-run(opts) {
   let gapsPath = ovg-or(fcgp-str(opts, "gaps"), ovg-gaps());
   let regPath = ovg-or(fcgp-str(opts, "register"), ovg-register());
   let rows = (Comparable) host_path_exists(regPath) == 1 ? fcgp-rows(regPath) : [];
   (Comparable) host_path_exists(gapsPath) != 1 ? dop-refuse(ss-door(), "no gaps file at " ++ gapsPath)
   : nil?(rows) ? dop-refuse(ss-door(), "no register row in " ++ regPath)
   : ss-read(fcgp-rows(gapsPath), rows[-1], opts, ovg-or(fcgp-str(opts, "ledger"), ss-ledger()));
  }
 }
}
