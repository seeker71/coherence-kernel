// Read-only Darwin ARM64 primary identity admission from published node handles.
// No counter scan: the shared high-water mark includes unfinished reservations.
// No shared writes, namespace replacement, or collector reference copying.
// preludes: form-stdlib/bml/native-identity-directory.bml
section [form.bml] {
 class NativePrimaryIdentity {
  def npi-image() = nns-image(npd-cat(list(npd-route(0,"open"),npd-route(1,"stat"),npd-route(2,"map"),npd-route(3,"pid"),list(fa-movz-x(0,22),npd-branch(14,"negate")),
   list(npd-label("open"),fa-add-x-imm(0,1,0),fa-movz-x(1,0),fa-movz-x(2,0)),npd-sys(266),
   list(npd-label("stat")),npd-shift2(),npd-sys(339),
   list(npd-label("map"),fa-add-x-imm(4,1,0),fa-add-x-imm(1,2,0),fa-movz-x(0,0),fa-movz-x(2,1),fa-movz-x(3,1),fa-movz-x(5,0)),npd-sys(197),
   list(npd-label("pid")),npd-sys(20),
   list(npd-label("syscall"),fa-movk-x-16(16,512),fa-svc(128),npd-branch(3,"return"),npd-label("negate"),nns-reg(3405774848,0,31,0),npd-label("return"),fa-ret()))));
  def npi-active(owner) = if (!record?(owner)) then 0 else (((String) record_get(owner,"kind") == "native-primary-identity") && (((Comparable) record_get(owner,"pid") == host_pid()) && ((Comparable) record_get(owner,"active") == 1)));
  def npi-call(owner,args) = if (!npi-active(owner)) then nothing() else {
   let result = jit_leaf_inram(record_get(owner,"request"),args); if (!nothing?(result)) then record_set(owner,"code-live",1) else 0; record_set(owner,"calls",(record_get(owner,"calls") + 1)); result;
  };
  def npi-open() {
   let memory = npd-open(); let owner = record_new(0,"kind","native-primary-identity","pid",host_pid(),"active",1,"memory",memory,"fds",list(),"calls",0,"code-live",0,"flow",noc-open(),"imported",0);
   let image = npi-image(); let identity = intern_node(make_nodeid(31,2,0,207),list(intern_trivial_string("native-primary-identity-darwin-v1"),intern_trivial_string(record_get(owner,"flow")),intern_trivial_string(nfm-bytes-list(image,""))));
   record_set(owner,"identity",identity); record_set(owner,"request",list(0,identity,image));
   if ((Comparable) npi-call(owner,list(3)) == host_pid()) then owner else { npi-close(owner); nothing(); };
  }
  def npi-unease(owner,aspect,result) {
   let row = oh-reading("native-primary-identity",record_get(owner,"flow"),aspect,json-node-string("published-shared-node-identities"),json-node-object(list(oh-n("native_result",result),oh-n("imported",record_get(owner,"imported")),oh-n("calls",record_get(owner,"calls")))),json-node-null(),list(oh-need("current-shared-field-evidence",json-node-null())),list("retain-directory","revise-handles","release-mappings"),json-node-null()); record_set(owner,"last-reading",row); oh-voice(row); nothing();
  }
  def npi-fd-close(owner,held) = if (!((Comparable) record_get(held,"active") == 1)) then 0 else {
   let status = npd-file-close(record_get(owner,"memory"),record_get(held,"fd")); if ((Comparable) status == 0) then record_set(held,"active",0) else 0; status;
  };
  def npi-map(owner,letter,bytes) = if (!npi-active(owner)) then nothing() else if (!(((String) letter == "h") || ((String) letter == "n"))) then nothing() else if (!(nbl-int?(bytes) && (bytes > 0))) then nothing() else {
   let fd = npi-call(owner,list(0,npd-cpath(str_concat("/fg-field2-",letter))));
   if (nothing?(fd) || (fd < 0)) then npi-unease(owner,"shared-open",if nothing?(fd) then -1 else fd) else {
    let held = record_new(0,"fd",fd,"active",1); record_set(owner,"fds",cons(held,record_get(owner,"fds")));
    let stat = npd-region(record_get(owner,"memory"),144);
    if nothing?(stat) then { npi-fd-close(owner,held); npi-unease(owner,"stat-allocation",0); } else {
     let status = npi-call(owner,list(1,fd,npd-span(stat,0,144)));
     let extent = if (((Comparable) status == 0) && ((Comparable) npd-peek(stat,103,1) == 0)) then npd-peek(stat,96,7) else 0;
     let pointer = if (((Comparable) status == 0) && (extent >= bytes)) then npi-call(owner,list(2,fd,bytes)) else -22;
     let mapped = if ((!nothing?(pointer)) && (pointer > 0)) then npd-region-ready(record_get(owner,"memory"),pointer,bytes) else nothing();
     let closed = npi-fd-close(owner,held); let released = npd-region-close(stat);
     if nothing?(mapped) then npi-unease(owner,"shared-map",if nothing?(pointer) then -1 else pointer) else {
      record_set(mapped,"node-storage-generation",1); record_set(mapped,"read-only-shared",1); record_set(mapped,"object-size",extent);
      if (((Comparable) closed == 0) && ((Comparable) released == 0)) then mapped else { npd-region-close(mapped); npi-unease(owner,"map-admission-release",closed); };
     };
    };
   };
  };
  def npi-home?() { let live = kernel_live(host_pid()); if (len(live) < 35) then 0 else (((Comparable) nth(live,22) == 2) && (((Comparable) nth(live,34) == 2) && ((Comparable) kernel_stat(63) == 8))); }
  def npi-slot(node) = if (!((String) value_kind(node) == "node_id")) then nothing() else {
   let raw = cell_ref(node); if (!(nbl-int?(raw) && ((raw < 0) && ((Comparable) ((0 - raw) % 2) == 1)))) then nothing() else (((0 - raw) - 1) / 2);
  };
  def npi-insert(slots,slot) = if nil?(slots) then list(slot) else if ((Comparable) head(slots) == slot) then slots else if (slot < head(slots)) then cons(slot,slots) else cons(head(slots),npi-insert(tail(slots),slot));
  def npi-slots(nodes,held) = if nil?(nodes) then held else {
   let slot = npi-slot(head(nodes)); if nothing?(slot) then nothing() else if (slot <= 0) then nothing() else npi-slots(tail(nodes),npi-insert(held,slot));
  };
  def npi-ranges(slots,first,end,held) = if nil?(slots) then reverse(cons(list(first,(end - first)),held)) else if ((Comparable) head(slots) == end) then npi-ranges(tail(slots),first,(end + 1),held) else npi-ranges(tail(slots),head(slots),(head(slots) + 1),cons(list(first,(end - first)),held));
  def npi-ranges-admitted?(directory,ranges) = if nil?(ranges) then 1 else (ndi-admit?(directory,head(head(ranges)),nth(head(ranges),1)) && npi-ranges-admitted?(directory,tail(ranges)));
  def npi-prepare(directory,source,ranges,held) = if nil?(ranges) then reverse(held) else {
   let range = head(ranges); let first = head(range); let count = nth(range,1);
   let block = nns-build-span(record_get(directory,"storage"),source,(first * 8),count); let segment = ndi-segment(directory,first,block);
   if nothing?(segment) then { npi-release-prepared(directory,held); nothing(); } else { record_set(directory,"owned-segments",cons(segment,record_get(directory,"owned-segments"))); npi-prepare(directory,source,tail(ranges),cons(segment,held)); };
  };
  def npi-release-prepared(directory,segments) = if nil?(segments) then 0 else { if ((Comparable) record_get(head(segments),"refs") == 0) then ndi-segment-release(directory,head(segments)) else 0; npi-release-prepared(directory,tail(segments)); };
  def npi-merge(segments,held) = if nil?(segments) then held else npi-merge(tail(segments),ndi-insert(held,head(segments)));
  def npi-import(owner,directory,nodes) = if (!(npi-active(owner) && ndi-active(directory))) then nothing() else if (!((String) value_kind(nodes) == "list")) then nothing() else if nil?(nodes) then 0 else if (!npi-home?()) then npi-unease(owner,"field-home",0) else {
   let slots = npi-slots(nodes,list());
   if nothing?(slots) then npi-unease(owner,"published-handles",0) else {
    let ranges = npi-ranges(tail(slots),head(slots),(head(slots) + 1),list());
    if (!npi-ranges-admitted?(directory,ranges)) then npi-unease(owner,"directory-ranges",0) else npi-import-slots(owner,directory,slots,ranges);
   };
  };
  def npi-import-slots(owner,directory,slots,ranges) {
   let header = npi-map(owner,"h",32);
   if nothing?(header) then nothing() else {
    let valid = (((String) nfm-bytes-list(npd-bytes(header,16,8),"") == str_concat("DLEIF",nfm-low(0,3))) && (((Comparable) npd-peek(header,24,7) == 2) && ((Comparable) npd-peek(header,31,1) == 0)));
    let releasedHeader = npd-region-close(header);
    if (!(valid && ((Comparable) releasedHeader == 0))) then npi-unease(owner,"field-version",0) else {
     let last = head(reverse(slots)); let source = npi-map(owner,"n",((last + 1) * 8));
     if nothing?(source) then nothing() else {
      let prepared = npi-prepare(directory,source,ranges,list()); let released = npd-region-close(source);
      if nothing?(prepared) then nothing() else if (!((Comparable) released == 0)) then { npi-release-prepared(directory,prepared); npi-unease(owner,"source-retirement",released); } else {
       let publication = ndi-publish(directory,npi-merge(prepared,ndi-current-segments(directory)));
       if nothing?(publication) then { npi-release-prepared(directory,prepared); nothing(); } else { record_set(directory,"segments",append(prepared,record_get(directory,"segments"))); record_set(owner,"imported",(record_get(owner,"imported") + len(slots))); len(slots); };
      };
     };
    };
   };
  }
  def npi-close-fds(owner,fds) = if nil?(fds) then 1 else { let status = npi-fd-close(owner,head(fds)); (((Comparable) status == 0) && npi-close-fds(owner,tail(fds))); };
  def npi-close-regions(regions) = if nil?(regions) then 1 else { let status = npd-region-close(head(regions)); (((Comparable) status == 0) && npi-close-regions(tail(regions))); };
  def npi-close(owner) = if (!record?(owner)) then 0 else if (!((String) record_get(owner,"kind") == "native-primary-identity")) then 0 else if (((Comparable) record_get(owner,"active") == 0) || (!((Comparable) record_get(owner,"pid") == host_pid()))) then 0 else {
   record_set(owner,"active",2); let fds = npi-close-fds(owner,record_get(owner,"fds")); let regions = npi-close-regions(record_get(record_get(owner,"memory"),"regions"));
   if (!(fds && regions)) then npi-unease(owner,"retirement",0) else {
    let code = if ((Comparable) record_get(owner,"code-live") == 1) then jit_leaf_inram(list(1,record_get(owner,"identity"),list()),0) else 1;
    if (!((Comparable) code == 1)) then npi-unease(owner,"code-retirement",0) else { record_set(owner,"code-live",0); let memory = npd-close(record_get(owner,"memory")); if ((Comparable) memory == 1) then record_set(owner,"active",0) else 0; memory; };
   };
  };
 }
 0;
}
