// Publish a new plan through its acquired descriptor. Existing destinations,
// including source aliases, refuse atomically before any byte is written.
// preludes: form/form-stdlib/bml/dsv4-oracle-execution.bml form-stdlib/bml/native-pty-darwin.bml
section [form.bml] {
 class Dsv4ViewPublication {
  def dtvp-image() {
   let rows = npd-cat(list(list(fa-movz-x(1,2561),fa-movk-x-16(1,256),fa-movz-x(2,384)),npd-sys(5),list(npd-label("syscall"),fa-movk-x-16(16,512),fa-svc(128),npd-branch(3,"return"),fa-asm(3405774848,list(1,32,65536),list(0,31,0)),npd-label("return"),fa-ret())));
   fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
  }
  def dtvp-active(p) = and(record?(p),and(str_eq(record_get(p,"kind"),"new-tensor-view-publication"),eq(record_get(p,"pid"),host_pid())));
  def dtvp-open(path,text) {
   let owner = npd-open(); let image = dtvp-image();
   let identity = intern_node(make_nodeid(31,2,0,194),cons(intern_trivial_string("new-view-plan-darwin-arm64-v1"),cons(intern_trivial_int(owner),npd-nodes(image))));
   let fd = jit_leaf_inram(list(0,identity,image),list(npd-cpath(path)));
   record_new(0,"kind","new-tensor-view-publication","pid",host_pid(),"owner",owner,"identity",identity,"code-state",if nothing?(fd) then 0 else 1,"code-released",0,"path",path,"text",text,"fd",fd,"fd-live",dfo-natural(fd),"acquired",dfo-natural(fd),"open-result",fd,"written",0,"write-result",nothing(),"descriptor-close",if dfo-natural(fd) then nothing() else 0,"owner-released",0,"ready",0,"abandoned",0,"disposition",if dfo-natural(fd) then "owned output pending" else "destination not acquired");
  }
  def dtvp-retire-code(p) = if eq(record_get(p,"code-state"),2) then 1 else dtvp-retired-code(p,jit_leaf_inram(list(1,record_get(p,"identity"),list()),0));
  def dtvp-retired-code(p,status) {
   let ok = if eq(record_get(p,"code-state"),0) then eq(status,0) else eq(status,1);
   if ok then record_set(p,"code-state",2) else 0; record_set(p,"code-released",ok); ok;
  }
  def dtvp-write(p) = if eq(record_get(p,"written"),str_len(record_get(p,"text"))) then 1 else dtvp-write-next(p,npd-write(record_get(p,"owner"),record_get(p,"fd"),substring(record_get(p,"text"),record_get(p,"written"),str_len(record_get(p,"text")))));
  def dtvp-write-next(p,wrote) {
   record_set(p,"write-result",wrote);
   if and(dfo-positive(wrote),le(wrote,sub(str_len(record_get(p,"text")),record_get(p,"written")))) then dtvp-written(p,wrote) else 0;
  }
  def dtvp-written(p,wrote) {
   record_set(p,"written",add(record_get(p,"written"),wrote)); dtvp-write(p);
  }
  def dtvp-close-fd(p) = if eq(record_get(p,"fd-live"),0) then 1 else dtvp-closed-fd(p,npd-native(record_get(p,"owner"),list(4,record_get(p,"fd"))));
  def dtvp-closed-fd(p,status) {
   record_set(p,"descriptor-close",status); if eq(status,0) then record_set(p,"fd-live",0) else 0; eq(status,0);
  }
  def dtvp-settle(p) {
   let code = dtvp-retire-code(p); let fd = dtvp-close-fd(p);
   let memory = if and(code,fd) then if eq(record_get(p,"owner-released"),1) then 1 else npd-close(record_get(p,"owner")) else nothing();
   if eq(memory,1) then record_set(p,"owner-released",1) else 0;
   let settled = and(code,and(fd,eq(record_get(p,"owner-released"),1)));
   let complete = and(eq(record_get(p,"acquired"),1),and(eq(record_get(p,"abandoned"),0),eq(record_get(p,"written"),str_len(record_get(p,"text")))));
   record_set(p,"ready",and(settled,complete));
   record_set(p,"disposition",if not(settled) then "resource retirement pending" else if complete then "complete new output" else if eq(record_get(p,"acquired"),1) then "closed partial output retained at path" else "destination not acquired"); p;
  }
  def dtvp-retry(p) = if not(dtvp-active(p)) then nothing() else if eq(record_get(p,"ready"),1) then p else if or(eq(record_get(p,"abandoned"),1),eq(record_get(p,"acquired"),0)) then dtvp-settle(p) else if not(dtvp-retire-code(p)) then p else if eq(record_get(p,"written"),str_len(record_get(p,"text"))) then dtvp-settle(p) else if eq(record_get(p,"fd-live"),0) then p else if dtvp-write(p) then dtvp-settle(p) else p;
  def dtvp-abandon(p) {
   if not(dtvp-active(p)) then nothing() else if eq(record_get(p,"ready"),1) then p else dtvp-abandon-owned(p);
  }
  def dtvp-abandon-owned(p) {
   record_set(p,"abandoned",1); dtvp-settle(p);
  }
  def dtvp-new(path,text) = dtvp-retry(dtvp-open(path,text));
 }
 0;
}
