// Caller-selected final-response reserve for the initial reasoning stage.
// The existing controller owns actions, checks, continuation and release.
// preludes: form-stdlib/bml/form-cli-code-reasoning.bml form-stdlib/bml/form-cli-reasoning-budget.bml
section [form.bml] {
 class FormCliCodeAnswerReserve {
  def fcacr-reserved-help() = str_concat(fcacr-help()," Optional reasoning_tokens opens bounded reasoning on every reply, including repairs and context renewal. It uses the same positive limit as initial_reasoning_tokens; select one of these fields. reasoning_tokens requires reasoning_answer_tokens. Optional reasoning_answer_tokens requires either reasoning field and reserves a separate final-response stage if the reasoning stage has no complete answer. max_reply_tokens caps each stage separately. The native controller records its stage transition, retains both generations privately, and acts only on a complete answer. An already complete final response goes to the ordinary reply parser and checks, including when its JSON is invalid; JSON validity alone does not open this reserve. Omitting both reasoning fields retains ordinary generation.");
  def fcacr-reserved-answer(result) = fcac-reasoned-answer(result);
  def fcacr-reserved-admit(model,state,checker,context,turns,initial,answer) = if fcap-done(state) then list(state,1,0,0,0) else if not(and(fcacr-limit-valid(initial),fcacr-limit-valid(answer))) then list(fcap-terminal(state,"reasoning-reserve-limit-refused"),1,0,0,0) else if not(fcac-model-ready(model)) then list(fcap-terminal(state,"native-qwen-artifact-seal-tokenizer-or-lane-unavailable"),1,0,0,0) else fcacr-reserved-open(model,fcap-begin-context(state),checker,context,turns,initial,answer,now_unix_ms());
  def fcacr-reserved-open(model,state,checker,context,turns,initial,answer,started) {
   let session = fcms-open-with-profile(mr-path(mr-find(model)),fcac-bootstrap-budget(state,turns),context,"knowledge-query-reasoning");
   let result = if not(fcms-live?(session)) then fcac-finish(session,fcap-terminal(state,fcms-reason(session)),started) else if not(str_eq(fcms-reason(session),"opened-live-cursor")) then fcac-finish(session,fcap-terminal(state,"initial-reasoning-requires-live-tokenizer-cursor"),started) else fcacr-reserved-first(session,state,checker,turns,initial,answer,started);
   fcac-finish-contexts(result,checker,turns,started,fcap-turns(state),list(0,0,0),1);
  }
  def fcacr-reserved-first(session,state,checker,turns,initial,answer,started) = fcac-reasoned(session,state,checker,turns,initial,answer,started);
 }
 0;
}
