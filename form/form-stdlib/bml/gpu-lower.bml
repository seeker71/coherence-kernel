// gpu-lower.bml — a Form body's own nodes lowered to a Metal kernel, in Form.
// The lane reads a defn through kernel_ast: its row, its body node, each node's four words, a
// literal's text. Every loop over list parameters with numeric state lowers: a one-thread kernel
// walks the body exactly as the walker does (lets, nested ifs, any exit, any fold, a self call as
// a parallel assignment). On top of that walk, four parallel kinds are recognised and take the
// whole device: a reduce whose fold is add, mul, max or min (told apart by evaluating the fold on
// sample pairs with the evaluator below); a map (cons onto the accumulator); a filter (a cons
// under a condition, by threadgroup compaction); and an any/all (constant exits, an or over
// flags). Callees become device functions; a callee's own tail loop becomes a while; a call
// through a defn-valued parameter lowers through a binding (slot, defn name). What stays outside:
// strings and nested lists in the element, a callee that reads a list, recursion that is not a
// fold. Those are named, not declined silently.
// A program is admitted through mj-memory, so its identity is the sha256 of the emitted source
// and the device; one call is one enqueue, and the wait comes only at gl-read.
// preludes: form-stdlib/core.fk form-stdlib/metal-door.fk form-stdlib/bml/metal-jit.bml form-stdlib/bml/string-join.bml
section [form.bml] {
    class GpuLower {
        // ---- the door to this process's program ----
        def gl-pid() = host_pid();
        def gl-node(k) = kernel_ast(gl-pid(), k);
        // a node word that names no node: nothing, or kernel_ast's own negative word for an absent child. It is read
        // here, once; every walk below asks gl-absent?, and the tag of no node is nothing
        def gl-absent?(k) = nothing?(k) ? 1 : (k < 0);
        def gl-tag(k) = gl-absent?(k) ? nothing() : gl-node(k)[0];
        def gl-a(k) = gl-node(k)[1];
        def gl-b(k) = gl-node(k)[2];
        def gl-c(k) = gl-node(k)[3];
        def gl-str(k) = kernel_ast(gl-pid(), list("str", k));
        def gl-fn-count() = kernel_ast(gl-pid(), -1)[2];
        def gl-row(j) = kernel_ast(gl-pid(), list("defn", j));
        def gl-row-name(row) = kernel_ast(gl-pid(), list("src", row[0], row[1]));
        def gl-row-idx(row) = row[2];
        def gl-row-body(row) = row[3];
        def gl-find-onto(name, j, n) = j >= n ? nothing() : gl-find-at(name, j, n, gl-row(j));
        def gl-find-at(name, j, n, row) = nothing?(row) ? gl-find-onto(name, j + 1, n) : (String) gl-row-name(row) == name ? row : gl-find-onto(name, j + 1, n);
        def gl-find(name) = gl-find-onto(name, 0, gl-fn-count());
        def gl-callee-row(idx) = gl-callee-onto(idx, 0, gl-fn-count());
        def gl-callee-onto(idx, j, n) = j >= n ? nothing() : gl-callee-at(idx, j, n, gl-row(j));
        def gl-callee-at(idx, j, n, row) = nothing?(row) ? gl-callee-onto(idx, j + 1, n) : (Comparable) gl-row-idx(row) == idx ? row : gl-callee-onto(idx, j + 1, n);
        def gl-name-of(idx) {
            let row = gl-callee-row(idx);
            nothing?(row) ? "" : gl-row-name(row);
        }
        def gl-unwrap(k) = (Comparable) gl-tag(k) == 111 ? gl-unwrap(gl-b(k)) : (Comparable) gl-tag(k) == 194 ? gl-unwrap(gl-b(k)) : k;
        def gl-param?(k) = (Comparable) gl-tag(k) == 110;
        def gl-slot(k) = gl-a(gl-a(k));
        def gl-call?(k) = ((Comparable) gl-tag(k) == 241) || ((Comparable) gl-tag(k) == 12);
        def gl-args-onto(cell, acc) = gl-absent?(cell) ? reverse(acc) : gl-args-onto(gl-b(cell), cons(gl-a(cell), acc));
        def gl-args(k) = (Comparable) gl-tag(k) == 12 ? list(gl-b(k)) : gl-args-onto(gl-b(k), list());
        def gl-self?(k, idx) = gl-call?(k) && ((Comparable) gl-a(k) == idx);
        def gl-arity(row) = gl-arity-of(gl-unwrap(gl-row-body(row)), gl-row-idx(row));
        // the arity read off the self call, or off how many parameter slots the body reaches
        def gl-arity-of(body, idx) {
            let self = gl-find-self(body, idx);
            nothing?(self) ? gl-slot-span(body) : len(gl-args(self));
        }
        // the first self call under a node, or nothing when the node never calls itself
        def gl-find-self(k, idx) = gl-absent?(k) ? nothing() : gl-self?(k, idx) ? k : gl-find-self-kids(gl-kids(k), idx);
        def gl-find-self-kids(ks, idx) = nil?(ks) ? nothing() : (gl-find-self(head(ks), idx) ?? gl-find-self-kids(tail(ks), idx));
        // how many parameter slots a node reaches: its highest slot plus one, 0 when it reads none
        def gl-slot-span(k) = gl-absent?(k) ? 0 : gl-param?(k) ? (gl-slot(k) + 1) : gl-slot-span-kids(gl-kids(k), 0);
        def gl-slot-span-kids(ks, m) = nil?(ks) ? m : gl-slot-span-kids(tail(ks), gl-larger(gl-slot-span(head(ks)), m));
        def gl-larger(a, b) = a > b ? a : b;
        // the child nodes of a node, by tag: literals and parameters carry values, not children
        def gl-kids(k) {
            let t = gl-tag(k);
            ((Comparable) t == 1) || (((Comparable) t == 24) || (((Comparable) t == 53) || (((Comparable) t == 110) || ((Comparable) t == 137)))) ? list() : (Comparable) t == 109 ? list(gl-b(k), gl-c(k)) : (Comparable) t == 111 ? list(gl-b(k)) : (Comparable) t == 6 ? list(gl-a(k), gl-b(k), gl-c(k)) : (Comparable) t == 241 ? gl-args(k) : (Comparable) t == 12 ? list(gl-b(k)) : (Comparable) t == 244 ? cons(gl-a(k), gl-args-onto(gl-b(k), list())) : gl-unary?(t) ? list(gl-a(k)) : gl-binary?(t) ? list(gl-a(k), gl-b(k)) : list();
        }
        def gl-unary?(t) = ((Comparable) t == 20) || (((Comparable) t == 21) || (((Comparable) t == 22) || (((Comparable) t == 72) || (((Comparable) t == 81) || (((Comparable) t == 89) || (((Comparable) t == 90) || (((Comparable) t == 54) || ((Comparable) t == 138))))))));
        def gl-binary?(t) = ((Comparable) t == 3) || (((Comparable) t == 4) || (((Comparable) t == 42) || (((Comparable) t == 10) || (((Comparable) t == 11) || (((Comparable) t == 5) || (((Comparable) t == 102) || (((Comparable) t == 103) || (((Comparable) t == 70) || (((Comparable) t == 71) || (((Comparable) t == 195) || ((Comparable) t == 19)))))))))));
        def gl-uses-slot?(k, s) = gl-absent?(k) ? 0 : gl-param?(k) && ((Comparable) gl-slot(k) == s) ? 1 : gl-uses-slot-kids?(gl-kids(k), s);
        def gl-uses-slot-kids?(ks, s) = nil?(ks) ? 0 : (Comparable) gl-uses-slot?(head(ks), s) == 1 ? 1 : gl-uses-slot-kids?(tail(ks), s);
        def gl-has-self?(k, idx) = nothing?(gl-find-self(k, idx)) ? 0 : 1;

        // ---- results: list(1, value) or list(0, reason) ----
        def gl-ok(v) = list(1, v);
        def gl-no(why) = list(0, why);
        def gl-ok?(r) = (Comparable) r[0] == 1;
        def gl-val(r) = r[1];

        // ---- context: idx, list slots, env (slot -> text), depth, bindings (slot -> defn name), mode ----
        // mode "par": a head reads p<slot>[i]; mode "seq": p<slot>[i<slot>]; mode "fn": inside a device function
        def gl-ctx(idx, lists, env, depth, bindings, mode) = list(idx, lists, env, depth, bindings, mode);
        def gl-ctx-idx(c) = c[0];
        def gl-ctx-lists(c) = c[1];
        def gl-ctx-env(c) = c[2];
        def gl-ctx-depth(c) = c[3];
        def gl-ctx-bind(c) = c[4];
        def gl-ctx-mode(c) = c[5];
        def gl-with-env(c, env) = list(c[0], c[1], env, c[3], c[4], c[5]);
        def gl-env-get(env, slot) = nil?(env) ? nothing() : (Comparable) head(env)[0] == slot ? head(env)[1] : gl-env-get(tail(env), slot);
        def gl-env-put(env, slot, text) = cons(list(slot, text), env);
        def gl-list-slot?(lists, s) = nil?(lists) ? 0 : (Comparable) head(lists) == s ? 1 : gl-list-slot?(tail(lists), s);

        // ---- the element expression to MSL text ----
        def gl-num-text(s) = str_find(s, ".", 0) < 0 ? (str_find(s, "e", 0) < 0 ? s ++ ".0f" : s ++ "f") : s ++ "f";
        def gl-bin(op, k, c) {
            let x = gl-expr(gl-a(k), c);
            let y = gl-ok?(x) ? gl-expr(gl-b(k), c) : x;
            gl-ok?(y) ? gl-ok("(" ++ gl-val(x) ++ op ++ gl-val(y) ++ ")") : gl-ok?(x) ? y : x;
        }
        def gl-fn1(name, k, c) {
            let x = gl-expr(gl-a(k), c);
            gl-ok?(x) ? gl-ok(name ++ "(" ++ gl-val(x) ++ ")") : x;
        }
        def gl-fn2(name, k, c) {
            let x = gl-expr(gl-a(k), c);
            let y = gl-ok?(x) ? gl-expr(gl-b(k), c) : x;
            gl-ok?(y) ? gl-ok(name ++ "(" ++ gl-val(x) ++ ", " ++ gl-val(y) ++ ")") : gl-ok?(x) ? y : x;
        }
        def gl-head(k, c) {
            let o = gl-a(k);
            gl-param?(o) && gl-list-slot?(gl-ctx-lists(c), gl-slot(o)) ? gl-ok((String) gl-ctx-mode(c) == "seq" ? "p" ++ int_to_str(gl-slot(o)) ++ "[i" ++ int_to_str(gl-slot(o)) ++ "]" : "p" ++ int_to_str(gl-slot(o)) ++ "[i]") : gl-no("head of something that is not a list parameter");
        }
        def gl-param-text(k, c) {
            let bound = gl-env-get(gl-ctx-env(c), gl-slot(k));
            nothing?(bound) ? (gl-list-slot?(gl-ctx-lists(c), gl-slot(k)) ? gl-no("a list used as a value") : gl-ok("c" ++ int_to_str(gl-slot(k)))) : gl-ok(bound);
        }
        // a condition: compares and the truth of a number
        def gl-cond(k, c) {
            let t = gl-tag(k);
            gl-nil-call?(k) ? ((String) gl-ctx-mode(c) == "seq" ? gl-nil-cond(gl-nil-slot(k)) : gl-no("nil? inside an element: the exits carry it")) : (Comparable) t == 5 ? gl-bin(" <= ", k, c) : (Comparable) t == 103 ? gl-bin(" < ", k, c) : (Comparable) t == 102 ? gl-bin(" == ", k, c) : (Comparable) t == 70 ? gl-cond2(" && ", k, c) : (Comparable) t == 71 ? gl-cond2(" || ", k, c) : (Comparable) t == 72 ? gl-not(k, c) : (Comparable) t == 138 ? gl-ok("false") : gl-truth(k, c);
        }
        // a walk's end test: the cursor of the list parameter nil? asks about has reached n
        def gl-nil-cond(s) = nothing?(s) ? gl-no("nil? of something that is not a list parameter") : gl-ok("(i" ++ int_to_str(s) ++ " >= n)");
        def gl-cond2(op, k, c) {
            let x = gl-cond(gl-a(k), c);
            let y = gl-ok?(x) ? gl-cond(gl-b(k), c) : x;
            gl-ok?(y) ? gl-ok("(" ++ gl-val(x) ++ op ++ gl-val(y) ++ ")") : gl-ok?(x) ? y : x;
        }
        def gl-not(k, c) {
            let x = gl-cond(gl-a(k), c);
            gl-ok?(x) ? gl-ok("(!" ++ gl-val(x) ++ ")") : x;
        }
        def gl-truth(k, c) {
            let x = gl-expr(k, c);
            gl-ok?(x) ? gl-ok("(" ++ gl-val(x) ++ " != 0.0f)") : x;
        }
        def gl-if-expr(k, c) {
            let cond = gl-cond(gl-a(k), c);
            let a = gl-ok?(cond) ? gl-expr(gl-b(k), c) : cond;
            let b = gl-ok?(a) ? gl-expr(gl-c(k), c) : a;
            gl-ok?(b) ? gl-ok("(" ++ gl-val(cond) ++ " ? " ++ gl-val(a) ++ " : " ++ gl-val(b) ++ ")") : gl-ok?(a) ? b : gl-ok?(cond) ? a : cond;
        }
        // a compare as a value: 1.0f or 0.0f
        def gl-cmp-value(k, c) {
            let x = gl-cond(k, c);
            gl-ok?(x) ? gl-ok("(" ++ gl-val(x) ++ " ? 1.0f : 0.0f)") : x;
        }
        def gl-expr(k, c) {
            let t = gl-tag(k);
            nothing?(t) ? gl-no("no node where an expression stands") : (Comparable) t == 1 ? gl-ok(int_to_str(gl-a(k)) ++ ".0f") : (Comparable) t == 53 ? gl-ok(gl-num-text(gl-str(gl-a(k)))) : (Comparable) t == 3 ? gl-bin(" + ", k, c) : (Comparable) t == 4 ? gl-bin(" - ", k, c) : (Comparable) t == 42 ? gl-bin(" * ", k, c) : (Comparable) t == 10 ? gl-bin(" / ", k, c) : (Comparable) t == 11 ? gl-fn2("fmod", k, c) : (Comparable) t == 81 ? gl-fn1("sqrt", k, c) : (Comparable) t == 89 ? gl-fn1("exp", k, c) : (Comparable) t == 90 ? gl-fn1("log", k, c) : (Comparable) t == 195 ? gl-fn2("pow", k, c) : (Comparable) t == 54 ? gl-fn1("trunc", k, c) : (Comparable) t == 20 ? gl-head(k, c) : (Comparable) t == 110 ? gl-param-text(k, c) : (Comparable) t == 6 ? gl-if-expr(k, c) : ((Comparable) t == 5) || (((Comparable) t == 102) || (((Comparable) t == 103) || (((Comparable) t == 70) || (((Comparable) t == 71) || (((Comparable) t == 72) || ((Comparable) t == 138)))))) ? gl-cmp-value(k, c) : (Comparable) t == 109 ? gl-no("a let inside an expression; write it as its own step") : gl-call?(k) ? ((Comparable) gl-a(k) == gl-ctx-idx(c) ? gl-no("the self call inside an expression") : gl-call-text(gl-a(k), gl-args(k), c)) : (Comparable) t == 244 ? gl-bound-call(k, c) : (Comparable) t == 21 ? gl-no("a list used as a value") : (Comparable) t == 24 ? gl-no("a string in the element") : (Comparable) t == 19 ? gl-no("a list built in the element") : gl-no("no arm for node tag " ++ int_to_str(t));
        }
        def gl-call-text(callee, args, c) {
            let texts = gl-exprs(args, c, list());
            gl-ok?(texts) ? gl-ok("f" ++ int_to_str(callee) ++ "(" ++ str-join-with(gl-val(texts), ", ") ++ ")") : texts;
        }
        def gl-exprs(ks, c, acc) = nil?(ks) ? gl-ok(reverse(acc)) : gl-exprs-at(ks, c, acc, gl-expr(head(ks), c));
        def gl-exprs-at(ks, c, acc, r) = gl-ok?(r) ? gl-exprs(tail(ks), c, cons(gl-val(r), acc)) : r;
        def gl-bound-call(k, c) {
            let f = gl-a(k);
            let name = gl-param?(f) ? gl-env-get(gl-ctx-bind(c), gl-slot(f)) : nothing();
            let row = nothing?(name) ? nothing() : gl-find(name);
            nothing?(name) ? gl-no("a call through a defn-valued parameter needs a binding (slot, defn name)") : nothing?(row) ? gl-no("no defn named " ++ name) : gl-call-text(gl-row-idx(row), gl-args-onto(gl-b(k), list()), c);
        }

        // ---- callees as device functions ----
        // every callee reachable from a body, transitively, each once, callees before callers
        // the callee a node calls, or nothing when it calls none (or calls through a parameter with no binding)
        def gl-callee-of(k, c) = gl-call?(k) ? gl-a(k) : (Comparable) gl-tag(k) == 244 ? gl-bound-idx(k, c) : nothing();
        def gl-bound-idx(k, c) {
            let f = gl-a(k);
            let name = gl-param?(f) ? gl-env-get(gl-ctx-bind(c), gl-slot(f)) : nothing();
            let row = nothing?(name) ? nothing() : gl-find(name);
            nothing?(row) ? nothing() : gl-row-idx(row);
        }
        // seen: list of (callee idx, arity), the arity read off the call site's argument count
        def gl-in?(xs, x) = nil?(xs) ? 0 : (Comparable) head(xs)[0] == x ? 1 : gl-in?(tail(xs), x);
        def gl-call-arity(k, c) = gl-call?(k) ? len(gl-args(k)) : (Comparable) gl-tag(k) == 244 ? len(gl-args-onto(gl-b(k), list())) : 0;
        def gl-collect(k, c, seen) {
            let callee = gl-callee-of(k, c);
            let structural = nothing?(callee) ? 1 : (String) gl-name-of(callee) == "nil?" ? 1 : 0;
            let seen2 = ((Comparable) structural == 0) && ((!((Comparable) callee == gl-ctx-idx(c))) && ((Comparable) gl-in?(seen, callee) == 0)) ? gl-collect(gl-unwrap(gl-row-body(gl-callee-row(callee))), gl-ctx(callee, list(), list(), 0, gl-ctx-bind(c), "fn"), cons(list(callee, gl-call-arity(k, c)), seen)) : seen;
            gl-collect-kids(gl-kids(k), c, seen2);
        }
        def gl-collect-kids(ks, c, seen) = nil?(ks) ? seen : gl-collect-kids(tail(ks), c, gl-collect(head(ks), c, seen));
        def gl-fn-params(n, k, acc) = k >= n ? reverse(acc) : gl-fn-params(n, k + 1, cons("float a" ++ int_to_str(k), acc));
        def gl-fn-env(n, k, acc) = k >= n ? acc : gl-fn-env(n, k + 1, gl-env-put(acc, k, "a" ++ int_to_str(k)));
        def gl-fn-proto(pair) = "static float f" ++ int_to_str(pair[0]) ++ "(" ++ str-join-with(gl-fn-params(pair[1], 0, list()), ", ") ++ ");";
        def gl-fn-text(pair, bindings) {
            let idx = pair[0];
            let row = gl-callee-row(idx);
            let n = pair[1];
            let body = gl-unwrap(gl-row-body(row));
            let c = gl-ctx(idx, list(), gl-fn-env(n, 0, list()), 0, bindings, "fn");
            let loop = gl-has-self?(body, idx);
            let stmts = gl-stmt(body, c, loop ? "        " : "    ");
            gl-ok?(stmts) ? gl-ok(str-join-with(list("static float f" ++ int_to_str(idx) ++ "(" ++ str-join-with(gl-fn-params(n, 0, list()), ", ") ++ ") {", loop ? "    while (true) {" : "", gl-val(stmts), loop ? "    }" : "", "}"), gl-nl())) : stmts;
        }
        // statements: lets bind, ifs branch, a self tail call reassigns and continues, anything else returns
        def gl-stmt(k, c, ind) {
            let t = gl-tag(k);
            (Comparable) t == 109 ? gl-let-stmt(k, c, ind) : (Comparable) t == 6 ? gl-if-stmt(k, c, ind) : gl-self?(k, gl-ctx-idx(c)) ? gl-self-stmt(k, c, ind) : gl-return-stmt(k, c, ind);
        }
        def gl-let-stmt(k, c, ind) {
            let slot = gl-a(gl-a(k));
            let v = gl-expr(gl-b(k), c);
            let rest = gl-ok?(v) ? gl-stmt(gl-c(k), gl-with-env(c, gl-env-put(gl-ctx-env(c), slot, "l" ++ int_to_str(slot))), ind) : v;
            gl-ok?(rest) ? gl-ok(ind ++ "float l" ++ int_to_str(slot) ++ " = " ++ gl-val(v) ++ ";" ++ gl-nl() ++ gl-val(rest)) : rest;
        }
        def gl-if-stmt(k, c, ind) {
            let cond = gl-cond(gl-a(k), c);
            let a = gl-ok?(cond) ? gl-stmt(gl-b(k), c, ind ++ "    ") : cond;
            let b = gl-ok?(a) ? gl-stmt(gl-c(k), c, ind ++ "    ") : a;
            gl-ok?(b) ? gl-ok(str-join-with(list(ind ++ "if " ++ gl-val(cond) ++ " {", gl-val(a), ind ++ "} else {", gl-val(b), ind ++ "}"), gl-nl())) : gl-ok?(a) ? b : gl-ok?(cond) ? a : cond;
        }
        def gl-return-stmt(k, c, ind) {
            let v = gl-expr(k, c);
            gl-ok?(v) ? gl-ok(ind ++ "return " ++ gl-val(v) ++ ";") : v;
        }
        // a self tail call in a device function: every argument into a temporary, then all at once
        def gl-self-stmt(k, c, ind) {
            let texts = gl-exprs(gl-args(k), c, list());
            gl-ok?(texts) ? gl-ok(gl-temps(gl-val(texts), 0, ind, "") ++ gl-assigns(len(gl-val(texts)), 0, ind, "") ++ ind ++ "continue;") : texts;
        }
        def gl-temps(ts, k, ind, acc) = nil?(ts) ? acc : gl-temps(tail(ts), k + 1, ind, acc ++ ind ++ "float t" ++ int_to_str(k) ++ " = " ++ head(ts) ++ ";" ++ gl-nl());
        def gl-assigns(n, k, ind, acc) = k >= n ? acc : gl-assigns(n, k + 1, ind, acc ++ ind ++ "a" ++ int_to_str(k) ++ " = t" ++ int_to_str(k) ++ ";" ++ gl-nl());
        def gl-fn-protos(idxs, acc) = nil?(idxs) ? reverse(acc) : gl-fn-protos(tail(idxs), cons(gl-fn-proto(head(idxs)), acc));
        def gl-fn-texts(idxs, bindings, acc) = nil?(idxs) ? gl-ok(reverse(acc)) : gl-fn-texts-at(idxs, bindings, acc, gl-fn-text(head(idxs), bindings));
        def gl-fn-texts-at(idxs, bindings, acc, r) = gl-ok?(r) ? gl-fn-texts(tail(idxs), bindings, cons(gl-val(r), acc)) : r;

        // ---- the evaluator over the same nodes, for telling folds apart ----
        // env: slot -> number; a head of a list parameter reads elem; a call through a bound parameter
        // runs the bound defn; answers nothing for anything else
        def gl-eval(k, env, elem, depth, bind) {
            let t = gl-tag(k);
            depth > 12 ? nothing() : (Comparable) t == 1 ? (gl-a(k) + 0.0) : (Comparable) t == 53 ? str_to_float(gl-str(gl-a(k))) : (Comparable) t == 110 ? gl-env-get(env, gl-slot(k)) : (Comparable) t == 20 ? elem : (Comparable) t == 6 ? gl-eval-if(k, env, elem, depth, bind) : (Comparable) t == 109 ? gl-eval-let(k, env, elem, depth, bind) : gl-call?(k) ? gl-eval-call(gl-a(k), gl-args(k), env, elem, depth, bind) : (Comparable) t == 244 ? gl-eval-bound(k, env, elem, depth, bind) : gl-unary?(t) ? gl-eval1(t, gl-eval(gl-a(k), env, elem, depth, bind)) : gl-binary?(t) ? gl-eval2(t, gl-eval(gl-a(k), env, elem, depth, bind), gl-eval(gl-b(k), env, elem, depth, bind)) : nothing();
        }
        def gl-eval-if(k, env, elem, depth, bind) {
            let cnd = gl-eval(gl-a(k), env, elem, depth, bind);
            nothing?(cnd) ? nothing() : (Comparable) cnd == 0.0 ? gl-eval(gl-c(k), env, elem, depth, bind) : gl-eval(gl-b(k), env, elem, depth, bind);
        }
        def gl-eval-let(k, env, elem, depth, bind) {
            let v = gl-eval(gl-b(k), env, elem, depth, bind);
            nothing?(v) ? nothing() : gl-eval(gl-c(k), gl-env-put(env, gl-a(gl-a(k)), v), elem, depth, bind);
        }
        def gl-eval-call(callee, args, env, elem, depth, bind) {
            let row = gl-callee-row(callee);
            let vals = gl-eval-args(args, env, elem, depth, bind, list());
            nothing?(row) || nothing?(vals) ? nothing() : gl-eval(gl-unwrap(gl-row-body(row)), gl-fn-env-vals(vals, 0, list()), elem, depth + 1, bind);
