        def gl-drop-bound(scalars, bindings) = if nil?(scalars) then list() else if nothing?(gl-env-get(bindings, head(scalars))) then cons(head(scalars), gl-drop-bound(tail(scalars), bindings)) else gl-drop-bound(tail(scalars), bindings);
        // every list tailed and every scalar passed through in a self call
        def gl-self-args-ok?(args, slot, lists, acc) = if nil?(args) then 1 else if eq(slot, acc) then gl-self-args-ok?(tail(args), add(slot, 1), lists, acc) else if gl-list-slot?(lists, slot) then if and(eq(gl-tag(head(args)), 21), and(gl-param?(gl-a(head(args))), eq(gl-slot(gl-a(head(args))), slot))) then gl-self-args-ok?(tail(args), add(slot, 1), lists, acc) else 0 else if and(gl-param?(head(args)), eq(gl-slot(head(args)), slot)) then gl-self-args-ok?(tail(args), add(slot, 1), lists, acc) else 0;
