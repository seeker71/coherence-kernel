        def gl-exits-acc-at(exits, acc, ans) = if not(gl-param?(ans)) then -2 else if lt(acc, 0) then gl-exits-acc(tail(exits), gl-slot(ans)) else if eq(acc, gl-slot(ans)) then gl-exits-acc(tail(exits), acc) else -2;
        def gl-constant?(k) = or(eq(gl-tag(k), 1), eq(gl-tag(k), 53));
