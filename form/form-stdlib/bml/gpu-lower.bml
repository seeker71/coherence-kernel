        def gl-lets-use?(lets, s) = if nil?(lets) then 0 else if eq(gl-uses-slot?(nth(head(lets), 2), s), 1) then 1 else gl-lets-use?(tail(lets), s);
        def gl-scalars(arity, lists, acc, s, out) = if ge(s, arity) then reverse(out) else gl-scalars(arity, lists, acc, add(s, 1), if or(eq(s, acc), gl-list-slot?(lists, s)) then out else cons(s, out));
