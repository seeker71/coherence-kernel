// gpu-lower.bml — a Form body's own nodes lowered to a Metal kernel, in Form.
// The lane reads a defn through kernel_ast: its row, its body node, each node's four words, a
// literal's text. A body in the reduce-onto shape -- ifs that exit on nil? of a list parameter
// answering the accumulator, ending in the self call that tails every list and folds one
// element expression into the accumulator with add -- becomes one kernel: a threadgroup strides
// the buffers, every thread folds its share, simd_sum and a threadgroup pass fold the rest.
// One-expression callees inline (vo-f). Anything else declines and says why.
// A program is admitted through mj-memory, so its identity is the sha256 of the emitted source
// and the device; one call is one enqueue, and the wait comes only at gl-read.
// preludes: form-stdlib/core.fk form-stdlib/metal-door.fk form-stdlib/bml/metal-jit.bml form-stdlib/bml/string-join.bml
section [form.bml] {
    class GpuLower {
        // ---- the door to this process's program ----
        def gl-pid() = host_pid();
        def gl-node(k) = kernel_ast(gl-pid(), k);
        def gl-tag(k) = nth(gl-node(k), 0);
        def gl-a(k) = nth(gl-node(k), 1);
        def gl-b(k) = nth(gl-node(k), 2);
        def gl-c(k) = nth(gl-node(k), 3);
        def gl-str(k) = kernel_ast(gl-pid(), list("str", k));
        def gl-fn-count() = nth(kernel_ast(gl-pid(), -1), 2);
        def gl-row(j) = kernel_ast(gl-pid(), list("defn", j));
        def gl-row-name(row) = kernel_ast(gl-pid(), list("src", nth(row, 0), nth(row, 1)));
        def gl-row-idx(row) = nth(row, 2);
        def gl-row-body(row) = nth(row, 3);
        def gl-find-onto(name, j, n) = if ge(j, n) then nothing() else gl-find-at(name, j, n, gl-row(j));
        def gl-find-at(name, j, n, row) = if nothing?(row) then gl-find-onto(name, add(j, 1), n) else if str_eq(gl-row-name(row), name) then row else gl-find-onto(name, add(j, 1), n);
        def gl-find(name) = gl-find-onto(name, 0, gl-fn-count());
        def gl-name-onto(idx, j, n) = if ge(j, n) then "" else gl-name-at(idx, j, n, gl-row(j));
        def gl-name-at(idx, j, n, row) = if nothing?(row) then gl-name-onto(idx, add(j, 1), n) else if eq(gl-row-idx(row), idx) then gl-row-name(row) else gl-name-onto(idx, add(j, 1), n);
        def gl-name-of(idx) = gl-name-onto(idx, 0, gl-fn-count());
        def gl-unwrap(k) = if eq(gl-tag(k), 111) then gl-unwrap(gl-b(k)) else if eq(gl-tag(k), 194) then gl-unwrap(gl-b(k)) else k;
        def gl-param?(k) = eq(gl-tag(k), 110);
        def gl-slot(k) = gl-a(gl-a(k));
        def gl-args-onto(cell, acc) = if lt(cell, 0) then reverse(acc) else gl-args-onto(gl-b(cell), cons(gl-a(cell), acc));
        def gl-args(k) = if eq(gl-tag(k), 12) then list(gl-b(k)) else gl-args-onto(gl-b(k), list());

        // ---- results: list(1, value) or list(0, reason) ----
        def gl-ok(v) = list(1, v);
        def gl-no(why) = list(0, why);
        def gl-ok?(r) = eq(nth(r, 0), 1);
        def gl-val(r) = nth(r, 1);

        // ---- an environment of slot -> MSL text, for inlined callees ----
        def gl-env-get(env, slot) = if nil?(env) then nothing() else if eq(nth(head(env), 0), slot) then nth(head(env), 1) else gl-env-get(tail(env), slot);
        def gl-env-zip(slots, texts, acc) = if nil?(slots) then acc else gl-env-zip(tail(slots), tail(texts), cons(list(head(slots), head(texts)), acc));

        // ---- the element expression ----
        def gl-num-text(s) = if lt(str_find(s, ".", 0), 0) then if lt(str_find(s, "e", 0), 0) then str_concat(s, ".0f") else str_concat(s, "f") else str_concat(s, "f");
        def gl-bin(op, k, idx, lists, env, depth) {
            let x = gl-expr(gl-a(k), idx, lists, env, depth);
            let y = if gl-ok?(x) then gl-expr(gl-b(k), idx, lists, env, depth) else x;
            if gl-ok?(y) then gl-ok(str_concat("(", str_concat(gl-val(x), str_concat(op, str_concat(gl-val(y), ")"))))) else if gl-ok?(x) then y else x;
        }
        def gl-list-slot?(lists, s) = if nil?(lists) then 0 else if eq(head(lists), s) then 1 else gl-list-slot?(tail(lists), s);
        def gl-head(k, idx, lists, env, depth) {
            let o = gl-a(k);
            let bound = if gl-param?(o) then gl-env-get(env, gl-slot(o)) else nothing();
            if nothing?(bound) then if and(gl-param?(o), gl-list-slot?(lists, gl-slot(o))) then gl-ok(str_concat("p", str_concat(int_to_str(gl-slot(o)), "[i]"))) else gl-no("head of something that is not a list parameter") else gl-ok(bound);
        }
        def gl-inline(k, idx, lists, env, depth) {
            let callee = gl-a(k);
            let row = gl-callee-row(callee, 0, gl-fn-count());
            let body = if nothing?(row) then -1 else gl-unwrap(gl-row-body(row));
            let args = gl-args(k);
            let texts = gl-exprs(args, idx, lists, env, depth, list());
            if ge(depth, 4) then gl-no("callee nesting past four") else if nothing?(row) then gl-no("callee without a row") else if or(eq(gl-tag(body), 6), or(eq(gl-tag(body), 109), eq(gl-tag(body), 241))) then gl-no(str_concat("callee is not one expression: ", gl-row-name(row))) else if gl-ok?(texts) then gl-expr(body, idx, lists, gl-env-zip(gl-slots(len(args), list()), gl-val(texts), list()), add(depth, 1)) else texts;
        }
        def gl-callee-row(idx, j, n) = if ge(j, n) then nothing() else gl-callee-at(idx, j, n, gl-row(j));
        def gl-callee-at(idx, j, n, row) = if nothing?(row) then gl-callee-row(idx, add(j, 1), n) else if eq(gl-row-idx(row), idx) then row else gl-callee-row(idx, add(j, 1), n);
        def gl-slots(n, acc) = if eq(n, 0) then acc else gl-slots(sub(n, 1), cons(sub(n, 1), acc));
        def gl-exprs(ks, idx, lists, env, depth, acc) = if nil?(ks) then gl-ok(reverse(acc)) else gl-exprs-at(ks, idx, lists, env, depth, acc, gl-expr(head(ks), idx, lists, env, depth));
        def gl-exprs-at(ks, idx, lists, env, depth, acc, r) = if gl-ok?(r) then gl-exprs(tail(ks), idx, lists, env, depth, cons(gl-val(r), acc)) else r;
        def gl-expr(k, idx, lists, env, depth) {
            let t = gl-tag(k);
            if eq(t, 1) then gl-ok(str_concat(int_to_str(gl-a(k)), ".0f")) else if eq(t, 53) then gl-ok(gl-num-text(gl-str(gl-a(k)))) else if eq(t, 3) then gl-bin(" + ", k, idx, lists, env, depth) else if eq(t, 4) then gl-bin(" - ", k, idx, lists, env, depth) else if eq(t, 42) then gl-bin(" * ", k, idx, lists, env, depth) else if eq(t, 10) then gl-bin(" / ", k, idx, lists, env, depth) else if eq(t, 20) then gl-head(k, idx, lists, env, depth) else if eq(t, 110) then gl-param-text(k, lists, env) else if or(eq(t, 241), eq(t, 12)) then if eq(gl-a(k), idx) then gl-no("the self call inside the element expression") else gl-inline(k, idx, lists, env, depth) else gl-no(str_concat("no arm for node tag ", int_to_str(t)));
        }
        def gl-param-text(k, lists, env) {
            let bound = gl-env-get(env, gl-slot(k));
            if nothing?(bound) then if gl-list-slot?(lists, gl-slot(k)) then gl-no("a list used as a value") else gl-no("a scalar parameter in the element expression") else gl-ok(bound);
        }

        // ---- the shape: ifs exiting on nil? of a list parameter, then the self call ----
        def gl-nil-call?(k) = and(or(eq(gl-tag(k), 241), eq(gl-tag(k), 12)), str_eq(gl-name-of(gl-a(k)), "nil?"));
        def gl-nil-slot(k) {
            let args = gl-args(k);
            if and(eq(len(args), 1), gl-param?(head(args))) then gl-slot(head(args)) else -1;
        }
        // walk: list(1, lists, acc-slot, self-node) or list(0, reason)
        def gl-shape(k, idx, lists, acc) {
            let t = gl-tag(k);
            if eq(t, 6) then gl-shape-if(k, idx, lists, acc) else if and(or(eq(t, 241), eq(t, 12)), eq(gl-a(k), idx)) then if lt(acc, 0) then gl-no("a self call before any exit") else list(1, reverse(lists), acc, k) else gl-no(str_concat("not a reduce shape at node tag ", int_to_str(t)));
        }
        def gl-shape-if(k, idx, lists, acc) {
            let cond = gl-a(k);
            let thn = gl-b(k);
            let slot = if gl-nil-call?(cond) then gl-nil-slot(cond) else -1;
            let acc2 = if gl-param?(thn) then gl-slot(thn) else -1;
            if lt(slot, 0) then gl-no("an exit that is not nil? of a list parameter") else if lt(acc2, 0) then gl-no("an exit answering something other than the accumulator") else if and(ge(acc, 0), not(eq(acc, acc2))) then gl-no("two accumulators") else gl-shape(gl-c(k), idx, cons(slot, lists), acc2);
        }
        def gl-self-args-ok?(args, slot, lists, acc) = if nil?(args) then 1 else if eq(slot, acc) then gl-self-args-ok?(tail(args), add(slot, 1), lists, acc) else if gl-list-slot?(lists, slot) then if and(eq(gl-tag(head(args)), 21), and(gl-param?(gl-a(head(args))), eq(gl-slot(gl-a(head(args))), slot))) then gl-self-args-ok?(tail(args), add(slot, 1), lists, acc) else 0 else 0;
        def gl-fold-node(args, slot, acc) = if eq(slot, acc) then head(args) else gl-fold-node(tail(args), add(slot, 1), acc);
        def gl-element(fold, idx, lists, acc) {
            let x = gl-a(fold);
            let y = gl-b(fold);
            let side = if and(gl-param?(x), eq(gl-slot(x), acc)) then y else if and(gl-param?(y), eq(gl-slot(y), acc)) then x else -1;
            if not(eq(gl-tag(fold), 3)) then gl-no("the accumulator folds with something other than add") else if lt(side, 0) then gl-no("the fold does not name the accumulator") else gl-expr(side, idx, lists, list(), 0);
        }

        // ---- the kernel text ----
        def gl-nl() = byte_to_str(10);
        def gl-buffers(lists, j, acc) = if nil?(lists) then reverse(acc) else gl-buffers(tail(lists), add(j, 1), cons(str_concat("device const float *p", str_concat(int_to_str(head(lists)), str_concat(" [[buffer(", str_concat(int_to_str(j), ")]], ")))), acc));
        def gl-source(lists, elem) {
            let nb = len(lists);
            let sig = str_concat(str-join(gl-buffers(lists, 0, list())), str_concat("device float *out [[buffer(", str_concat(int_to_str(nb), str_concat(")]], constant uint &n [[buffer(", str_concat(int_to_str(add(nb, 1)), str_concat(")]], constant float &init [[buffer(", str_concat(int_to_str(add(nb, 2)), ")]], uint tid [[thread_position_in_threadgroup]], uint tpg [[threads_per_threadgroup]], uint sid [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]")))))));
            str-join-with(list("#pragma clang fp contract(off)", "#include <metal_stdlib>", "using namespace metal;", str_concat("kernel void form_reduce(", str_concat(sig, ") {")), "    threadgroup float part[32];", "    float acc = 0.0f;", str_concat("    for (uint i = tid; i < n; i += tpg) { acc = (acc + ", str_concat(elem, "); }")), "    acc = simd_sum(acc);", "    if (lane == 0) { part[sid] = acc; }", "    threadgroup_barrier(mem_flags::mem_threadgroup);", "    if (tid == 0) { float s = init; uint g = (tpg + 31u) / 32u; for (uint k = 0; k < g; k++) { s = (s + part[k]); } out[0] = s; }", "}", ""), gl-nl());
        }

        // ---- lowering a named defn: list(1, msl, lists, acc-slot) or list(0, reason) ----
        def gl-lower(name) {
            let row = gl-find(name);
            if nothing?(row) then gl-no(str_concat("no defn named ", name)) else gl-lower-row(row);
        }
        def gl-lower-row(row) {
            let idx = gl-row-idx(row);
            let body = gl-unwrap(gl-row-body(row));
            let shape = gl-shape(body, idx, list(), -1);
            if gl-ok?(shape) then gl-lower-shape(idx, nth(shape, 1), nth(shape, 2), nth(shape, 3)) else shape;
        }
        def gl-lower-shape(idx, lists, acc, self) {
            let args = gl-args(self);
            let elem = if eq(gl-self-args-ok?(args, 0, lists, acc), 1) then gl-element(gl-fold-node(args, 0, acc), idx, lists, acc) else gl-no("the self call does not tail every list and keep the accumulator");
            if gl-ok?(elem) then list(1, gl-source(lists, gl-val(elem)), lists, acc) else elem;
        }

        // ---- a program: lowered, admitted; list(1, version, lists, msl) or list(0, reason) ----
        def gl-program(name) {
            let low = gl-lower(name);
            if gl-ok?(low) then gl-admit(nth(low, 1), nth(low, 2)) else low;
        }
        def gl-admit(msl, lists) {
            let version = mj-memory(msl, "form_reduce");
            if nothing?(version) then gl-no(str_concat("metal refused the program: ", metal_status())) else list(1, version, lists, msl);
        }
        def gl-identity(prog) = nth(nth(prog, 1), 1);

        // ---- data: floats to a resident buffer (the door packs a list once, in C), and back ----
        def gl-f32-buf(xs) {
            let h = metal_buf_alloc(mul(4, len(xs)));
            let wrote = metal_buf_write(h, 0, xs);
            h;
        }
        def gl-u32(s) = add(str_byte_at(s, 0), add(mul(str_byte_at(s, 1), 256), add(mul(str_byte_at(s, 2), 65536), mul(str_byte_at(s, 3), 16777216))));
        def gl-f32-of(w) {
            let sign = if ge(w, 2147483648) then 1 else 0;
            let body = if eq(sign, 1) then sub(w, 2147483648) else w;
            let e = div(body, 8388608);
            let m = mod(body, 8388608);
            let mag = if eq(e, 0) then mul(add(m, 0.0), fq-pow2(-149)) else mul(add(1.0, div(add(m, 0.0), 8388608.0)), fq-pow2(sub(e, 127)));
            if eq(sign, 1) then sub(0.0, mag) else mag;
        }

        // ---- one call: one enqueue, nothing waited; the pending answer is the out buffer ----
        def gl-run(prog, bufs, n, init) {
            let out = metal_buf_alloc(4);
            let bind = md-bind16(append(bufs, list(out)), list(n, md-f32-bits(init)), 1024, 0, 1, 0);
            let enq = mj-enqueue(nth(prog, 1), bind, 1);
            if eq(enq, 1) then out else gl-no(str_concat("enqueue refused: ", metal_status()));
        }
        def gl-read(out) = gl-f32-of(gl-u32(metal_buf_read(out, 0, 4)));

        // ---- a counter out of metal_status ----
        def gl-count(key) {
            let s = metal_status();
            let at = str_find(s, str_concat(key, "="), 0);
            if lt(at, 0) then -1 else gl-count-at(s, add(at, add(str_len(key), 1)), 0);
        }
        def gl-count-at(s, i, acc) = if ge(i, str_len(s)) then acc else if and(ge(str_byte_at(s, i), 48), le(str_byte_at(s, i), 57)) then gl-count-at(s, add(i, 1), add(mul(acc, 10), sub(str_byte_at(s, i), 48))) else acc;
    }
}
