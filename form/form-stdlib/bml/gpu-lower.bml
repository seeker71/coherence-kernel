        def gl-pair-env(pos, a, e) = if eq(pos, 0) then gl-env-put(gl-env-put(list(), 0, a), 1, e) else gl-env-put(gl-env-put(list(), 1, a), 0, e);
        def gl-classify(r1, r2, r3) = if or(nothing?(r1), or(nothing?(r2), nothing?(r3))) then "general" else if and(eq(r1, 8.0), and(eq(r2, 8.0), eq(r3, 4.5))) then "add" else if and(eq(r1, 15.0), and(eq(r2, 15.0), eq(r3, 2.0))) then "mul" else if and(eq(r1, 5.0), and(eq(r2, 5.0), eq(r3, 4.0))) then "max" else if and(eq(r1, 3.0), and(eq(r2, 3.0), eq(r3, 0.5))) then "min" else "general";
