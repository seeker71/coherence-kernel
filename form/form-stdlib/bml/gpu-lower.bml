// gpu-lower.bml — a Form body's own nodes lowered to a Metal kernel, in Form.
// The lane reads a defn through kernel_ast: its row, its body node, each node's four words, a
// literal's text. Every loop over list parameters with numeric state lowers: a one-thread kernel
// walks the body exactly as the walker does (lets, nested ifs, any exit, any fold, a self call as
// a parallel assignment). On top of that walk, four parallel kinds are recognised and take the
// whole device: a reduce whose fold is add, mul, max or min (told apart by evaluating the fold on
// sample pairs with the evaluator below); a map (cons onto the accumulator); a filter (a cons
// under a condition, by threadgroup compaction); and an any/all (constant exits, an or over
// flags). Callees become device functions; a callee's own tail loop becomes a while; a call
// through a defn-valued parameter lowers through a binding (slot, defn name). What stays outside:
// strings and nested lists in the element, a callee that reads a list, recursion that is not a
// fold. Those are named, not declined silently.
// A program is admitted through mj-memory, so its identity is the sha256 of the emitted source
// and the device; one call is one enqueue, and the wait comes only at gl-read.
// preludes: form-stdlib/core.fk form-stdlib/metal-door.fk form-stdlib/bml/metal-jit.bml form-stdlib/bml/string-join.bml
section [form.bml] {
    class GpuLower {
        // ---- the door to this process's program ----
        def gl-pid() = host_pid();
        def gl-node(k) = kernel_ast(gl-pid(), k);
        def gl-tag(k) = if nothing?(k) then -1 else if lt(k, 0) then -1 else nth(gl-node(k), 0);
        def gl-a(k) = nth(gl-node(k), 1);
        def gl-b(k) = nth(gl-node(k), 2);
        def gl-c(k) = nth(gl-node(k), 3);
        def gl-str(k) = kernel_ast(gl-pid(), list("str", k));
        def gl-fn-count() = nth(kernel_ast(gl-pid(), -1), 2);
        def gl-row(j) = kernel_ast(gl-pid(), list("defn", j));
        def gl-row-name(row) = kernel_ast(gl-pid(), list("src", nth(row, 0), nth(row, 1)));
        def gl-row-idx(row) = nth(row, 2);
        def gl-row-body(row) = nth(row, 3);
        def gl-find-onto(name, j, n) = if ge(j, n) then nothing() else gl-find-at(name, j, n, gl-row(j));
        def gl-find-at(name, j, n, row) = if nothing?(row) then gl-find-onto(name, add(j, 1), n) else if str_eq(gl-row-name(row), name) then row else gl-find-onto(name, add(j, 1), n);
        def gl-find(name) = gl-find-onto(name, 0, gl-fn-count());
        def gl-callee-row(idx) = gl-callee-onto(idx, 0, gl-fn-count());
        def gl-callee-onto(idx, j, n) = if ge(j, n) then nothing() else gl-callee-at(idx, j, n, gl-row(j));
        def gl-callee-at(idx, j, n, row) = if nothing?(row) then gl-callee-onto(idx, add(j, 1), n) else if eq(gl-row-idx(row), idx) then row else gl-callee-onto(idx, add(j, 1), n);
        def gl-name-of(idx) {
            let row = gl-callee-row(idx);
            if nothing?(row) then "" else gl-row-name(row);
        }
        def gl-unwrap(k) = if eq(gl-tag(k), 111) then gl-unwrap(gl-b(k)) else if eq(gl-tag(k), 194) then gl-unwrap(gl-b(k)) else k;
        def gl-param?(k) = eq(gl-tag(k), 110);
        def gl-slot(k) = gl-a(gl-a(k));
        def gl-call?(k) = or(eq(gl-tag(k), 241), eq(gl-tag(k), 12));
        def gl-args-onto(cell, acc) = if lt(cell, 0) then reverse(acc) else gl-args-onto(gl-b(cell), cons(gl-a(cell), acc));
        def gl-args(k) = if eq(gl-tag(k), 12) then list(gl-b(k)) else gl-args-onto(gl-b(k), list());
        def gl-self?(k, idx) = and(gl-call?(k), eq(gl-a(k), idx));
        def gl-arity(row) = gl-arity-of(gl-unwrap(gl-row-body(row)), gl-row-idx(row));
        // the arity read off the self call, or off the highest parameter slot seen plus one
        def gl-arity-of(body, idx) {
            let self = gl-find-self(body, idx);
            if lt(self, 0) then add(gl-max-slot(body), 1) else len(gl-args(self));
        }
        def gl-find-self(k, idx) = if lt(k, 0) then -1 else if gl-self?(k, idx) then k else gl-find-self-kids(gl-kids(k), idx);
        def gl-find-self-kids(ks, idx) = if nil?(ks) then -1 else if ge(gl-find-self(head(ks), idx), 0) then gl-find-self(head(ks), idx) else gl-find-self-kids(tail(ks), idx);
        def gl-max-slot(k) = if lt(k, 0) then -1 else if gl-param?(k) then gl-slot(k) else gl-max-slot-kids(gl-kids(k), -1);
        def gl-max-slot-kids(ks, m) = if nil?(ks) then m else gl-max-slot-kids(tail(ks), if gt(gl-max-slot(head(ks)), m) then gl-max-slot(head(ks)) else m);
        // the child nodes of a node, by tag: literals and parameters carry values, not children
        def gl-kids(k) {
            let t = gl-tag(k);
            if or(eq(t, 1), or(eq(t, 24), or(eq(t, 53), or(eq(t, 110), eq(t, 137))))) then list() else if eq(t, 109) then list(gl-b(k), gl-c(k)) else if eq(t, 111) then list(gl-b(k)) else if eq(t, 6) then list(gl-a(k), gl-b(k), gl-c(k)) else if eq(t, 241) then gl-args(k) else if eq(t, 12) then list(gl-b(k)) else if eq(t, 244) then cons(gl-a(k), gl-args-onto(gl-b(k), list())) else if gl-unary?(t) then list(gl-a(k)) else if gl-binary?(t) then list(gl-a(k), gl-b(k)) else list();
        }
        def gl-unary?(t) = or(eq(t, 20), or(eq(t, 21), or(eq(t, 22), or(eq(t, 72), or(eq(t, 81), or(eq(t, 89), or(eq(t, 90), or(eq(t, 54), eq(t, 138)))))))));
        def gl-binary?(t) = or(eq(t, 3), or(eq(t, 4), or(eq(t, 42), or(eq(t, 10), or(eq(t, 11), or(eq(t, 5), or(eq(t, 102), or(eq(t, 103), or(eq(t, 70), or(eq(t, 71), or(eq(t, 195), eq(t, 19))))))))))));
        def gl-uses-slot?(k, s) = if lt(k, 0) then 0 else if and(gl-param?(k), eq(gl-slot(k), s)) then 1 else gl-uses-slot-kids?(gl-kids(k), s);
        def gl-uses-slot-kids?(ks, s) = if nil?(ks) then 0 else if eq(gl-uses-slot?(head(ks), s), 1) then 1 else gl-uses-slot-kids?(tail(ks), s);
        def gl-has-self?(k, idx) = ge(gl-find-self(k, idx), 0);

        // ---- results: list(1, value) or list(0, reason) ----
        def gl-ok(v) = list(1, v);
        def gl-no(why) = list(0, why);
        def gl-ok?(r) = eq(nth(r, 0), 1);
        def gl-val(r) = nth(r, 1);

        // ---- context: idx, list slots, env (slot -> text), depth, bindings (slot -> defn name), mode ----
        // mode "par": a head reads p<slot>[i]; mode "seq": p<slot>[i<slot>]; mode "fn": inside a device function
        def gl-ctx(idx, lists, env, depth, bindings, mode) = list(idx, lists, env, depth, bindings, mode);
        def gl-ctx-idx(c) = nth(c, 0);
        def gl-ctx-lists(c) = nth(c, 1);
        def gl-ctx-env(c) = nth(c, 2);
        def gl-ctx-depth(c) = nth(c, 3);
        def gl-ctx-bind(c) = nth(c, 4);
        def gl-ctx-mode(c) = nth(c, 5);
        def gl-with-env(c, env) = list(nth(c, 0), nth(c, 1), env, nth(c, 3), nth(c, 4), nth(c, 5));
        def gl-env-get(env, slot) = if nil?(env) then nothing() else if eq(nth(head(env), 0), slot) then nth(head(env), 1) else gl-env-get(tail(env), slot);
        def gl-env-put(env, slot, text) = cons(list(slot, text), env);
        def gl-list-slot?(lists, s) = if nil?(lists) then 0 else if eq(head(lists), s) then 1 else gl-list-slot?(tail(lists), s);

        // ---- the element expression to MSL text ----
        def gl-num-text(s) = if lt(str_find(s, ".", 0), 0) then if lt(str_find(s, "e", 0), 0) then str_concat(s, ".0f") else str_concat(s, "f") else str_concat(s, "f");
        def gl-bin(op, k, c) {
            let x = gl-expr(gl-a(k), c);
            let y = if gl-ok?(x) then gl-expr(gl-b(k), c) else x;
            if gl-ok?(y) then gl-ok(str_concat("(", str_concat(gl-val(x), str_concat(op, str_concat(gl-val(y), ")"))))) else if gl-ok?(x) then y else x;
        }
        def gl-fn1(name, k, c) {
            let x = gl-expr(gl-a(k), c);
            if gl-ok?(x) then gl-ok(str_concat(name, str_concat("(", str_concat(gl-val(x), ")")))) else x;
        }
        def gl-fn2(name, k, c) {
            let x = gl-expr(gl-a(k), c);
            let y = if gl-ok?(x) then gl-expr(gl-b(k), c) else x;
            if gl-ok?(y) then gl-ok(str_concat(name, str_concat("(", str_concat(gl-val(x), str_concat(", ", str_concat(gl-val(y), ")")))))) else if gl-ok?(x) then y else x;
        }
        def gl-head(k, c) {
            let o = gl-a(k);
            if and(gl-param?(o), gl-list-slot?(gl-ctx-lists(c), gl-slot(o))) then gl-ok(if str_eq(gl-ctx-mode(c), "seq") then str_concat("p", str_concat(int_to_str(gl-slot(o)), str_concat("[i", str_concat(int_to_str(gl-slot(o)), "]")))) else str_concat("p", str_concat(int_to_str(gl-slot(o)), "[i]"))) else gl-no("head of something that is not a list parameter");
        }
        def gl-param-text(k, c) {
            let bound = gl-env-get(gl-ctx-env(c), gl-slot(k));
            if nothing?(bound) then if gl-list-slot?(gl-ctx-lists(c), gl-slot(k)) then gl-no("a list used as a value") else gl-ok(str_concat("c", int_to_str(gl-slot(k)))) else gl-ok(bound);
        }
        // a condition: compares and the truth of a number
        def gl-cond(k, c) {
            let t = gl-tag(k);
            if gl-nil-call?(k) then if str_eq(gl-ctx-mode(c), "seq") then gl-ok(str_concat("(i", str_concat(int_to_str(gl-nil-slot(k)), " >= n)"))) else gl-no("nil? inside an element: the exits carry it") else if eq(t, 5) then gl-bin(" <= ", k, c) else if eq(t, 103) then gl-bin(" < ", k, c) else if eq(t, 102) then gl-bin(" == ", k, c) else if eq(t, 70) then gl-cond2(" && ", k, c) else if eq(t, 71) then gl-cond2(" || ", k, c) else if eq(t, 72) then gl-not(k, c) else if eq(t, 138) then gl-ok("false") else gl-truth(k, c);
        }
        def gl-cond2(op, k, c) {
            let x = gl-cond(gl-a(k), c);
            let y = if gl-ok?(x) then gl-cond(gl-b(k), c) else x;
            if gl-ok?(y) then gl-ok(str_concat("(", str_concat(gl-val(x), str_concat(op, str_concat(gl-val(y), ")"))))) else if gl-ok?(x) then y else x;
        }
        def gl-not(k, c) {
            let x = gl-cond(gl-a(k), c);
            if gl-ok?(x) then gl-ok(str_concat("(!", str_concat(gl-val(x), ")"))) else x;
        }
        def gl-truth(k, c) {
            let x = gl-expr(k, c);
            if gl-ok?(x) then gl-ok(str_concat("(", str_concat(gl-val(x), " != 0.0f)"))) else x;
        }
        def gl-if-expr(k, c) {
            let cond = gl-cond(gl-a(k), c);
            let a = if gl-ok?(cond) then gl-expr(gl-b(k), c) else cond;
            let b = if gl-ok?(a) then gl-expr(gl-c(k), c) else a;
            if gl-ok?(b) then gl-ok(str_concat("(", str_concat(gl-val(cond), str_concat(" ? ", str_concat(gl-val(a), str_concat(" : ", str_concat(gl-val(b), ")"))))))) else if gl-ok?(a) then b else if gl-ok?(cond) then a else cond;
        }
        // a compare as a value: 1.0f or 0.0f
        def gl-cmp-value(k, c) {
            let x = gl-cond(k, c);
            if gl-ok?(x) then gl-ok(str_concat("(", str_concat(gl-val(x), " ? 1.0f : 0.0f)"))) else x;
        }
        def gl-expr(k, c) {
            let t = gl-tag(k);
            if eq(t, 1) then gl-ok(str_concat(int_to_str(gl-a(k)), ".0f")) else if eq(t, 53) then gl-ok(gl-num-text(gl-str(gl-a(k)))) else if eq(t, 3) then gl-bin(" + ", k, c) else if eq(t, 4) then gl-bin(" - ", k, c) else if eq(t, 42) then gl-bin(" * ", k, c) else if eq(t, 10) then gl-bin(" / ", k, c) else if eq(t, 11) then gl-fn2("fmod", k, c) else if eq(t, 81) then gl-fn1("sqrt", k, c) else if eq(t, 89) then gl-fn1("exp", k, c) else if eq(t, 90) then gl-fn1("log", k, c) else if eq(t, 195) then gl-fn2("pow", k, c) else if eq(t, 54) then gl-fn1("trunc", k, c) else if eq(t, 20) then gl-head(k, c) else if eq(t, 110) then gl-param-text(k, c) else if eq(t, 6) then gl-if-expr(k, c) else if or(eq(t, 5), or(eq(t, 102), or(eq(t, 103), or(eq(t, 70), or(eq(t, 71), or(eq(t, 72), eq(t, 138))))))) then gl-cmp-value(k, c) else if eq(t, 109) then gl-no("a let inside an expression; write it as its own step") else if gl-call?(k) then if eq(gl-a(k), gl-ctx-idx(c)) then gl-no("the self call inside an expression") else gl-call-text(gl-a(k), gl-args(k), c) else if eq(t, 244) then gl-bound-call(k, c) else if eq(t, 21) then gl-no("a list used as a value") else if eq(t, 24) then gl-no("a string in the element") else if eq(t, 19) then gl-no("a list built in the element") else gl-no(str_concat("no arm for node tag ", int_to_str(t)));
        }
        def gl-call-text(callee, args, c) {
            let texts = gl-exprs(args, c, list());
            if gl-ok?(texts) then gl-ok(str_concat("f", str_concat(int_to_str(callee), str_concat("(", str_concat(str-join-with(gl-val(texts), ", "), ")"))))) else texts;
        }
        def gl-exprs(ks, c, acc) = if nil?(ks) then gl-ok(reverse(acc)) else gl-exprs-at(ks, c, acc, gl-expr(head(ks), c));
        def gl-exprs-at(ks, c, acc, r) = if gl-ok?(r) then gl-exprs(tail(ks), c, cons(gl-val(r), acc)) else r;
        def gl-bound-call(k, c) {
            let f = gl-a(k);
            let name = if gl-param?(f) then gl-env-get(gl-ctx-bind(c), gl-slot(f)) else nothing();
            let row = if nothing?(name) then nothing() else gl-find(name);
            if nothing?(name) then gl-no("a call through a defn-valued parameter needs a binding (slot, defn name)") else if nothing?(row) then gl-no(str_concat("no defn named ", name)) else gl-call-text(gl-row-idx(row), gl-args-onto(gl-b(k), list()), c);
        }

        // ---- callees as device functions ----
        // every callee reachable from a body, transitively, each once, callees before callers
        def gl-callee-of(k, c) = if gl-call?(k) then gl-a(k) else if eq(gl-tag(k), 244) then gl-bound-idx(k, c) else -1;
        def gl-bound-idx(k, c) {
            let f = gl-a(k);
            let name = if gl-param?(f) then gl-env-get(gl-ctx-bind(c), gl-slot(f)) else nothing();
            let row = if nothing?(name) then nothing() else gl-find(name);
            if nothing?(row) then -1 else gl-row-idx(row);
        }
        // seen: list of (callee idx, arity), the arity read off the call site's argument count
        def gl-in?(xs, x) = if nil?(xs) then 0 else if eq(nth(head(xs), 0), x) then 1 else gl-in?(tail(xs), x);
        def gl-call-arity(k, c) = if gl-call?(k) then len(gl-args(k)) else if eq(gl-tag(k), 244) then len(gl-args-onto(gl-b(k), list())) else 0;
        def gl-collect(k, c, seen) {
            let callee = gl-callee-of(k, c);
            let structural = if lt(callee, 0) then 1 else if str_eq(gl-name-of(callee), "nil?") then 1 else 0;
            let seen2 = if and(eq(structural, 0), and(not(eq(callee, gl-ctx-idx(c))), eq(gl-in?(seen, callee), 0))) then gl-collect(gl-unwrap(gl-row-body(gl-callee-row(callee))), gl-ctx(callee, list(), list(), 0, gl-ctx-bind(c), "fn"), cons(list(callee, gl-call-arity(k, c)), seen)) else seen;
            gl-collect-kids(gl-kids(k), c, seen2);
        }
        def gl-collect-kids(ks, c, seen) = if nil?(ks) then seen else gl-collect-kids(tail(ks), c, gl-collect(head(ks), c, seen));
        def gl-fn-params(n, k, acc) = if ge(k, n) then reverse(acc) else gl-fn-params(n, add(k, 1), cons(str_concat("float a", int_to_str(k)), acc));
        def gl-fn-env(n, k, acc) = if ge(k, n) then acc else gl-fn-env(n, add(k, 1), gl-env-put(acc, k, str_concat("a", int_to_str(k))));
        def gl-fn-proto(pair) = str_concat("static float f", str_concat(int_to_str(nth(pair, 0)), str_concat("(", str_concat(str-join-with(gl-fn-params(nth(pair, 1), 0, list()), ", "), ");"))));
        def gl-fn-text(pair, bindings) {
            let idx = nth(pair, 0);
            let row = gl-callee-row(idx);
            let n = nth(pair, 1);
            let body = gl-unwrap(gl-row-body(row));
            let c = gl-ctx(idx, list(), gl-fn-env(n, 0, list()), 0, bindings, "fn");
            let loop = gl-has-self?(body, idx);
            let stmts = gl-stmt(body, c, if loop then "        " else "    ");
            if gl-ok?(stmts) then gl-ok(str-join-with(list(str_concat("static float f", str_concat(int_to_str(idx), str_concat("(", str_concat(str-join-with(gl-fn-params(n, 0, list()), ", "), ") {")))), if loop then "    while (true) {" else "", gl-val(stmts), if loop then "    }" else "", "}"), gl-nl())) else stmts;
        }
        // statements: lets bind, ifs branch, a self tail call reassigns and continues, anything else returns
        def gl-stmt(k, c, ind) {
            let t = gl-tag(k);
            if eq(t, 109) then gl-let-stmt(k, c, ind) else if eq(t, 6) then gl-if-stmt(k, c, ind) else if gl-self?(k, gl-ctx-idx(c)) then gl-self-stmt(k, c, ind) else gl-return-stmt(k, c, ind);
        }
        def gl-let-stmt(k, c, ind) {
            let slot = gl-a(gl-a(k));
            let v = gl-expr(gl-b(k), c);
            let rest = if gl-ok?(v) then gl-stmt(gl-c(k), gl-with-env(c, gl-env-put(gl-ctx-env(c), slot, str_concat("l", int_to_str(slot)))), ind) else v;
            if gl-ok?(rest) then gl-ok(str_concat(ind, str_concat("float l", str_concat(int_to_str(slot), str_concat(" = ", str_concat(gl-val(v), str_concat(";", str_concat(gl-nl(), gl-val(rest))))))))) else rest;
        }
        def gl-if-stmt(k, c, ind) {
            let cond = gl-cond(gl-a(k), c);
            let a = if gl-ok?(cond) then gl-stmt(gl-b(k), c, str_concat(ind, "    ")) else cond;
            let b = if gl-ok?(a) then gl-stmt(gl-c(k), c, str_concat(ind, "    ")) else a;
            if gl-ok?(b) then gl-ok(str-join-with(list(str_concat(ind, str_concat("if ", str_concat(gl-val(cond), " {"))), gl-val(a), str_concat(ind, "} else {"), gl-val(b), str_concat(ind, "}")), gl-nl())) else if gl-ok?(a) then b else if gl-ok?(cond) then a else cond;
        }
        def gl-return-stmt(k, c, ind) {
            let v = gl-expr(k, c);
            if gl-ok?(v) then gl-ok(str_concat(ind, str_concat("return ", str_concat(gl-val(v), ";")))) else v;
        }
        // a self tail call in a device function: every argument into a temporary, then all at once
        def gl-self-stmt(k, c, ind) {
            let texts = gl-exprs(gl-args(k), c, list());
            if gl-ok?(texts) then gl-ok(str_concat(gl-temps(gl-val(texts), 0, ind, ""), str_concat(gl-assigns(len(gl-val(texts)), 0, ind, ""), str_concat(ind, "continue;")))) else texts;
        }
        def gl-temps(ts, k, ind, acc) = if nil?(ts) then acc else gl-temps(tail(ts), add(k, 1), ind, str_concat(acc, str_concat(ind, str_concat("float t", str_concat(int_to_str(k), str_concat(" = ", str_concat(head(ts), str_concat(";", gl-nl()))))))));
        def gl-assigns(n, k, ind, acc) = if ge(k, n) then acc else gl-assigns(n, add(k, 1), ind, str_concat(acc, str_concat(ind, str_concat("a", str_concat(int_to_str(k), str_concat(" = t", str_concat(int_to_str(k), str_concat(";", gl-nl()))))))));
        def gl-fn-protos(idxs, acc) = if nil?(idxs) then reverse(acc) else gl-fn-protos(tail(idxs), cons(gl-fn-proto(head(idxs)), acc));
        def gl-fn-texts(idxs, bindings, acc) = if nil?(idxs) then gl-ok(reverse(acc)) else gl-fn-texts-at(idxs, bindings, acc, gl-fn-text(head(idxs), bindings));
        def gl-fn-texts-at(idxs, bindings, acc, r) = if gl-ok?(r) then gl-fn-texts(tail(idxs), bindings, cons(gl-val(r), acc)) else r;

        // ---- the evaluator over the same nodes, for telling folds apart ----
        // env: slot -> number; a head of a list parameter reads elem; a call through a bound parameter
        // runs the bound defn; answers nothing for anything else
        def gl-eval(k, env, elem, depth, bind) {
            let t = gl-tag(k);
            if gt(depth, 12) then nothing() else if eq(t, 1) then add(gl-a(k), 0.0) else if eq(t, 53) then str_to_float(gl-str(gl-a(k))) else if eq(t, 110) then gl-env-get(env, gl-slot(k)) else if eq(t, 20) then elem else if eq(t, 6) then gl-eval-if(k, env, elem, depth, bind) else if eq(t, 109) then gl-eval-let(k, env, elem, depth, bind) else if gl-call?(k) then gl-eval-call(gl-a(k), gl-args(k), env, elem, depth, bind) else if eq(t, 244) then gl-eval-bound(k, env, elem, depth, bind) else if gl-unary?(t) then gl-eval1(t, gl-eval(gl-a(k), env, elem, depth, bind)) else if gl-binary?(t) then gl-eval2(t, gl-eval(gl-a(k), env, elem, depth, bind), gl-eval(gl-b(k), env, elem, depth, bind)) else nothing();
        }
        def gl-eval-if(k, env, elem, depth, bind) {
            let cnd = gl-eval(gl-a(k), env, elem, depth, bind);
            if nothing?(cnd) then nothing() else if eq(cnd, 0.0) then gl-eval(gl-c(k), env, elem, depth, bind) else gl-eval(gl-b(k), env, elem, depth, bind);
        }
        def gl-eval-let(k, env, elem, depth, bind) {
