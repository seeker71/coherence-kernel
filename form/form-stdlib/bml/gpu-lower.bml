        def gl-op-join(kind, a, b) = if str_eq(kind, "add") then str_concat("(", str_concat(a, str_concat(" + ", str_concat(b, ")")))) else if str_eq(kind, "mul") then str_concat("(", str_concat(a, str_concat(" * ", str_concat(b, ")")))) else if str_eq(kind, "max") then str_concat("max(", str_concat(a, str_concat(", ", str_concat(b, ")")))) else str_concat("min(", str_concat(a, str_concat(", ", str_concat(b, ")"))));
        // lets as statements at an indent, binding l<slot> in the context as they go
        def gl-lets-text(lets, c, ind, acc) = if nil?(lets) then gl-ok(list(acc, c)) else gl-lets-text-at(lets, c, ind, acc, gl-expr(nth(head(lets), 2), c));
        def gl-lets-text-at(lets, c, ind, acc, v) = if gl-ok?(v) then gl-lets-text(tail(lets), gl-with-env(c, gl-env-put(gl-ctx-env(c), nth(head(lets), 1), str_concat("l", int_to_str(nth(head(lets), 1))))), ind, str_concat(acc, str_concat(ind, str_concat("float l", str_concat(int_to_str(nth(head(lets), 1)), str_concat(" = ", str_concat(gl-val(v), str_concat(";", gl-nl())))))))) else v;
        // a parallel reduce: every thread folds its stride with the op, simd and threadgroup passes join, tid 0 folds init in
        // base: the accumulator's start -- the caller's init for a tail loop, the body's own base for a right fold
        def gl-source-reduce(funcs, lists, scalars, lets, elem, op, base) = str-join-with(list(gl-prelude(funcs), str_concat("kernel void form_reduce(", str_concat(gl-head-text(lists, scalars, gl-tg-args()), ") {")), "    threadgroup float part[32];", str_concat("    float acc = ", str_concat(gl-op-id(op), ";")), "    for (uint i = tid; i < n; i += tpg) {", lets, str_concat("        acc = ", str_concat(gl-op-join(op, "acc", elem), ";")), "    }", str_concat("    acc = ", str_concat(gl-op-simd(op), "(acc);")), "    if (lane == 0) { part[sid] = acc; }", "    threadgroup_barrier(mem_flags::mem_threadgroup);", str_concat("    if (tid == 0) { float s = ", str_concat(base, str_concat("; uint g = (tpg + 31u) / 32u; for (uint k = 0; k < g; k++) { s = ", str_concat(gl-op-join(op, "s", "part[k]"), "; } out[0] = s; }")))), "}", ""), gl-nl());
        def gl-source-map(funcs, lists, scalars, lets, elem) = str-join-with(list(gl-prelude(funcs), str_concat("kernel void form_map(", str_concat(gl-head-text(lists, scalars, "uint i [[thread_position_in_grid]]"), ") {")), "    if (i < n) {", lets, str_concat("        out[i] = ", str_concat(elem, ";")), "    }", "}", ""), gl-nl());
        // a filter: one threadgroup, each thread a chunk; count, exclusive prefix, scatter; out[0] holds the count
        def gl-source-filter(funcs, lists, scalars, lets, cond, elem) = str-join-with(list(gl-prelude(funcs), str_concat("kernel void form_filter(", str_concat(gl-head-text(lists, scalars, gl-tg-args()), ") {")), "    threadgroup uint counts[1024];", "    uint chunk = (n + tpg - 1u) / tpg;", "    uint lo = tid * chunk;", "    uint hi = min(lo + chunk, n);", "    uint cnt = 0u;", "    for (uint i = lo; i < hi; i++) {", lets, str_concat("        if ", str_concat(cond, " { cnt++; }")), "    }", "    counts[tid] = cnt;", "    threadgroup_barrier(mem_flags::mem_threadgroup);", "    if (tid == 0) { uint run = 0u; for (uint k = 0; k < tpg; k++) { uint ck = counts[k]; counts[k] = run; run += ck; } out[0] = (float)run; }", "    threadgroup_barrier(mem_flags::mem_threadgroup);", "    uint at = 1u + counts[tid];", "    for (uint i = lo; i < hi; i++) {", lets, str_concat("        if ", str_concat(cond, str_concat(" { out[at] = ", str_concat(elem, "; at++; }")))), "    }", "}", ""), gl-nl());
        // any/all: an or over flags, then the constant the walk would have answered
        def gl-source-any(funcs, lists, scalars, lets, cond, hit, miss) = str-join-with(list(gl-prelude(funcs), str_concat("kernel void form_any(", str_concat(gl-head-text(lists, scalars, gl-tg-args()), ") {")), "    threadgroup float part[32];", "    float acc = 0.0f;", "    for (uint i = tid; i < n; i += tpg) {", lets, str_concat("        if ", str_concat(cond, " { acc = 1.0f; }")), "    }", "    acc = simd_max(acc);", "    if (lane == 0) { part[sid] = acc; }", "    threadgroup_barrier(mem_flags::mem_threadgroup);", str_concat("    if (tid == 0) { float s = 0.0f; uint g = (tpg + 31u) / 32u; for (uint k = 0; k < g; k++) { s = max(s, part[k]); } out[0] = (s > 0.5f) ? ", str_concat(hit, str_concat(" : ", str_concat(miss, "; }")))), "}", ""), gl-nl());
        // the right fold from the end on one thread: acc = F(element, acc), i from n-1 down
        def gl-source-rfold(funcs, lists, scalars, lets, fold, inittext) = str-join-with(list(gl-prelude(funcs), str_concat("kernel void form_seq(", str_concat(gl-head-text(lists, scalars, "uint tid [[thread_position_in_grid]]"), ") {")), "    if (tid != 0u) { return; }", str_concat("    float acc = ", str_concat(inittext, ";")), "    for (uint j = n; j > 0u; j--) {", "        uint i = j - 1u;", lets, str_concat("        acc = ", str_concat(fold, ";")), "    }", "    out[0] = acc;", "}", ""), gl-nl());
        // the walk itself on one thread: cursors for lists, locals for every other parameter
        // locals: every non-list slot; the accumulator starts from init, the others from their constants
        def gl-source-seq(funcs, lists, scalars, body, acc) = str-join-with(list(gl-prelude(funcs), str_concat("kernel void form_seq(", str_concat(gl-head-text(lists, gl-without(scalars, acc), "uint tid [[thread_position_in_grid]]"), ") {")), "    if (tid != 0u) { return; }", gl-cursors(lists, ""), gl-locals(scalars, acc, ""), "    uint k = 0u;", "    while (true) {", body, "    }", "}", ""), gl-nl());
        def gl-cursors(lists, acc) = if nil?(lists) then acc else gl-cursors(tail(lists), str_concat(acc, str_concat("    uint i", str_concat(int_to_str(head(lists)), str_concat(" = 0u;", gl-nl())))));
        def gl-locals(scalars, acc, text) = if nil?(scalars) then text else gl-locals(tail(scalars), acc, str_concat(text, str_concat("    float v", str_concat(int_to_str(head(scalars)), str_concat(" = ", str_concat(if eq(head(scalars), acc) then "init" else str_concat("c", int_to_str(head(scalars))), str_concat(";", gl-nl())))))));
        def gl-without(xs, x) = if nil?(xs) then list() else if eq(head(xs), x) then gl-without(tail(xs), x) else cons(head(xs), gl-without(tail(xs), x));

        // ---- lowering a named defn: list(1, msl, lists, acc, kind, scalars) or list(0, reason) ----
        def gl-lower(name) = gl-lower-bound(name, list());
        def gl-lower-bound(name, bindings) {
            let row = gl-find(name);
            if nothing?(row) then gl-no(str_concat("no defn named ", name)) else gl-lower-row(row, bindings);
        }
        def gl-lower-row(row, bindings) {
            let idx = gl-row-idx(row);
            let body = gl-unwrap(gl-row-body(row));
            let chain = gl-chain(body, idx, list(), list());
            let arity = gl-arity(row);
            let callees = gl-collect(body, gl-ctx(idx, list(), list(), 0, bindings, "par"), list());
            let funcs = gl-fn-texts(reverse(callees), bindings, list());
            if not(gl-ok?(chain)) then chain else if not(gl-ok?(funcs)) then funcs else if nil?(nth(chain, 1)) then gl-no("no list parameter is tested with nil?: nothing for the device to stride") else gl-lower-chain(idx, arity, nth(chain, 1), nth(chain, 2), nth(chain, 3), append(gl-fn-protos(reverse(callees), list()), gl-val(funcs)), bindings);
        }
        def gl-lower-chain(idx, arity, lists, items, step, funcs, bindings) {
            let lets = gl-items-lets(items);
            let exits = gl-items-exits(items);
            let acc = gl-exits-acc(exits, -1);
            let early = gl-early-exits(exits);
            let scalars = gl-drop-bound(gl-scalars(arity, lists, if lt(acc, 0) then -1 else acc, 0, list()), bindings);
            let c = gl-ctx(idx, lists, list(), 0, bindings, "par");
            if and(not(gl-self?(step, idx)), and(not(eq(gl-tag(step), 6)), gl-has-self?(step, idx))) then gl-lower-nontail(idx, arity, lists, scalars, lets, exits, step, funcs, bindings, c) else if and(ge(acc, 0), and(nil?(early), eq(gl-lets-use?(lets, acc), 0))) then gl-lower-tail(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings, c) else if and(lt(acc, 0), and(eq(gl-exits-constant?(exits), 1), and(eq(len(early), 1), gl-self?(step, idx)))) then gl-lower-any(idx, arity, lists, scalars, lets, exits, early, step, funcs, bindings, c) else gl-lower-seq(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings);
        }
        // the tail shapes: map, filter, a reduce whose fold joins, else the walk
        def gl-lower-tail(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings, c) {
            let lt2 = gl-lets-text(lets, c, "        ", "");
            if not(gl-ok?(lt2)) then lt2 else if eq(gl-tag(step), 6) then gl-lower-choice(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings, gl-val(lt2)) else gl-lower-fold(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings, gl-val(lt2));
        }
        def gl-lower-fold(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings, lt2) {
            let c = nth(lt2, 1);
            let ltext = nth(lt2, 0);
            let args = gl-args(step);
            let fold = gl-fold-node(args, 0, acc);
            let plain = gl-self-args-ok?(args, 0, lists, acc);
            let kind = if eq(plain, 0) then "walk" else if and(eq(gl-tag(fold), 19), gl-acc?(gl-b(fold), acc)) then "map" else if gl-cons-choice?(fold, acc) then "filter" else gl-fold-op(fold, acc, bindings);
            if or(str_eq(kind, "walk"), str_eq(kind, "general")) then gl-lower-seq(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings) else if str_eq(kind, "map") then gl-finish("map", gl-expr(gl-a(fold), c), lists, acc, scalars, funcs, ltext, "") else if str_eq(kind, "filter") then gl-finish-filter(fold, acc, lists, scalars, funcs, ltext, c) else gl-finish(kind, gl-expr(gl-fold-elem(fold, acc), c), lists, acc, scalars, funcs, ltext, "");
        }
        // (if C (cons E acc) acc), either way round: a filter inside the accumulator argument
        def gl-cons-choice?(fold, acc) = and(eq(gl-tag(fold), 6), or(and(gl-cons-onto?(gl-b(fold), acc), gl-acc?(gl-c(fold), acc)), and(gl-acc?(gl-b(fold), acc), gl-cons-onto?(gl-c(fold), acc))));
        def gl-cons-onto?(k, acc) = and(eq(gl-tag(k), 19), gl-acc?(gl-b(k), acc));
        def gl-finish-filter(fold, acc, lists, scalars, funcs, ltext, c) {
            let keep-then = gl-cons-onto?(gl-b(fold), acc);
            let cond = gl-cond(gl-a(fold), c);
            let condtext = if keep-then then cond else if gl-ok?(cond) then gl-ok(str_concat("(!", str_concat(gl-val(cond), ")"))) else cond;
            let elem = if gl-ok?(condtext) then gl-expr(gl-a(if keep-then then gl-b(fold) else gl-c(fold)), c) else condtext;
            if gl-ok?(elem) then list(1, gl-source-filter(funcs, lists, scalars, ltext, gl-val(condtext), gl-val(elem)), lists, acc, "filter", scalars) else elem;
        }
        // an if choosing between two self calls: a filter when one keeps and one conses, else the walk
        def gl-lower-choice(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings, lt2) {
            let c = nth(lt2, 1);
            let tf = gl-fold-node(gl-args(gl-b(step)), 0, acc);
            let ef = gl-fold-node(gl-args(gl-c(step)), 0, acc);
            let keep-then = gl-cons-onto?(tf, acc);
            let keep-else = gl-cons-onto?(ef, acc);
            let plain = and(gl-self-args-ok?(gl-args(gl-b(step)), 0, lists, acc), gl-self-args-ok?(gl-args(gl-c(step)), 0, lists, acc));
            let cond = gl-cond(gl-a(step), c);
            let condtext = if keep-then then cond else if gl-ok?(cond) then gl-ok(str_concat("(!", str_concat(gl-val(cond), ")"))) else cond;
            let elem = if gl-ok?(condtext) then gl-expr(gl-a(if keep-then then tf else ef), c) else condtext;
            if or(eq(plain, 0), not(or(and(keep-then, gl-acc?(ef, acc)), and(keep-else, gl-acc?(tf, acc))))) then gl-lower-seq(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings) else if gl-ok?(elem) then list(1, gl-source-filter(funcs, lists, scalars, nth(lt2, 0), gl-val(condtext), gl-val(elem)), lists, acc, "filter", scalars) else elem;
        }
        def gl-finish(kind, elem, lists, acc, scalars, funcs, ltext, unused) = if gl-ok?(elem) then list(1, if str_eq(kind, "map") then gl-source-map(funcs, lists, scalars, ltext, gl-val(elem)) else gl-source-reduce(funcs, lists, scalars, ltext, gl-val(elem), kind, "init"), lists, acc, if str_eq(kind, "map") then "map" else "reduce", scalars) else elem;
        def gl-lower-any(idx, arity, lists, scalars, lets, exits, early, step, funcs, bindings, c) {
            let lt2 = gl-lets-text(lets, c, "        ", "");
            let c2 = if gl-ok?(lt2) then nth(gl-val(lt2), 1) else c;
            let e = head(early);
            let cond = gl-cond(nth(e, 1), c2);
            let condtext = if eq(nth(e, 3), 0) then cond else if gl-ok?(cond) then gl-ok(str_concat("(!", str_concat(gl-val(cond), ")"))) else cond;
            let hit = gl-expr(nth(e, 2), c2);
            let miss = gl-expr(nth(head(exits), 2), c2);
            if not(gl-ok?(lt2)) then lt2 else if not(gl-ok?(condtext)) then condtext else if not(gl-ok?(hit)) then hit else if not(gl-ok?(miss)) then miss else if eq(gl-self-args-ok?(gl-args(step), 0, lists, -1), 0) then gl-lower-seq(idx, arity, lists, -1, scalars, lets, exits, step, funcs, bindings) else list(1, gl-source-any(funcs, lists, scalars, nth(gl-val(lt2), 0), gl-val(condtext), gl-val(hit), gl-val(miss)), lists, -1, "any", scalars);
        }
        // (if (nil? xs) INIT (op E (self (tail xs)))): the fold seen from the right; joins run parallel, the rest walk from the end
        def gl-lower-nontail(idx, arity, lists, scalars, lets, exits, step, funcs, bindings, c) {
            let lt2 = gl-lets-text(lets, c, "        ", "");
            let c2 = if gl-ok?(lt2) then nth(gl-val(lt2), 1) else c;
            let selfa = gl-self?(gl-a(step), idx);
            let selfb = gl-self?(gl-b(step), idx);
            let t = gl-tag(step);
            let kind = if not(gl-binary?(t)) then "general" else if not(or(selfa, selfb)) then "general" else if eq(t, 3) then "add" else if eq(t, 42) then "mul" else "general";
            let elem = if or(selfa, selfb) then gl-expr(if selfa then gl-b(step) else gl-a(step), c2) else gl-no("recursion that is not a fold: the self call is not one operand of the answer");
            let inittext = if nil?(exits) then gl-no("a fold with no base") else gl-expr(nth(head(exits), 2), c2);
            let folded = if str_eq(kind, "general") then gl-rfold-text(step, idx, c2) else gl-ok("");
            if not(gl-ok?(lt2)) then lt2 else if not(gl-ok?(elem)) then elem else if not(gl-ok?(inittext)) then inittext else if not(gl-ok?(folded)) then folded else if str_eq(kind, "general") then list(1, gl-source-rfold(funcs, lists, scalars, nth(gl-val(lt2), 0), gl-val(folded), gl-val(inittext)), lists, -1, "seq", scalars) else list(1, gl-source-reduce(funcs, lists, scalars, nth(gl-val(lt2), 0), gl-val(elem), kind, gl-val(inittext)), lists, -1, "reduce", scalars);
        }
        // the fold expression with the self call read as acc
        def gl-rfold-text(step, idx, c) {
            let x = if gl-self?(gl-a(step), idx) then gl-ok("acc") else gl-expr(gl-a(step), c);
            let y = if gl-self?(gl-b(step), idx) then gl-ok("acc") else gl-expr(gl-b(step), c);
            let t = gl-tag(step);
            let op = if eq(t, 3) then " + " else if eq(t, 4) then " - " else if eq(t, 42) then " * " else if eq(t, 10) then " / " else "";
            if not(gl-ok?(x)) then x else if not(gl-ok?(y)) then y else if eq(str_len(op), 0) then gl-no(str_concat("a right fold through node tag ", int_to_str(t))) else gl-ok(str_concat("(", str_concat(gl-val(x), str_concat(op, str_concat(gl-val(y), ")")))));
        }

        // ---- the walk on one thread: items and the step as statements over cursors and locals ----
        def gl-lower-seq(idx, arity, lists, acc, scalars2, lets, exits, step, funcs, bindings) {
            let scalars = gl-seq-scalars(arity, lists, 0, list());
            let env = gl-seq-env(arity, lists, 0, list());
            let c = gl-ctx(idx, lists, env, 0, bindings, "seq");
            let listacc = if lt(acc, 0) then 0 else gl-has-tag?(step, 19);
            let body = gl-seq-items(gl-seq-order(lets, exits), c, lists, acc, listacc, step, "        ");
            if gl-ok?(body) then list(1, gl-source-seq(funcs, lists, gl-drop-bound(scalars, bindings), gl-val(body), acc), lists, acc, "seq", gl-without(gl-drop-bound(scalars, bindings), acc)) else body;
        }
        def gl-seq-scalars(arity, lists, s, out) = if ge(s, arity) then reverse(out) else gl-seq-scalars(arity, lists, add(s, 1), if gl-list-slot?(lists, s) then out else cons(s, out));
        def gl-seq-env(arity, lists, s, env) = if ge(s, arity) then env else gl-seq-env(arity, lists, add(s, 1), if gl-list-slot?(lists, s) then env else gl-env-put(env, s, str_concat("v", int_to_str(s))));
        // items in source order: lets and exits interleaved as the chain met them
        def gl-seq-order(lets, exits) = gl-seq-merge(lets, exits);
        def gl-seq-merge(lets, exits) = if nil?(lets) then exits else if nil?(exits) then lets else if lt(gl-item-node(head(lets)), gl-item-node(head(exits))) then cons(head(lets), gl-seq-merge(tail(lets), exits)) else cons(head(exits), gl-seq-merge(lets, tail(exits)));
        def gl-item-node(x) = if str_eq(nth(x, 0), "let") then nth(x, 2) else nth(x, 1);
        def gl-seq-items(items, c, lists, acc, listacc, step, ind) = if nil?(items) then gl-seq-step(step, c, lists, acc, listacc, ind) else if str_eq(nth(head(items), 0), "let") then gl-seq-let(items, c, lists, acc, listacc, step, ind) else gl-seq-exit(items, c, lists, acc, listacc, step, ind);
        def gl-seq-let(items, c, lists, acc, listacc, step, ind) {
            let x = head(items);
            let v = gl-expr(nth(x, 2), c);
            let rest = if gl-ok?(v) then gl-seq-items(tail(items), gl-with-env(c, gl-env-put(gl-ctx-env(c), nth(x, 1), str_concat("l", int_to_str(nth(x, 1))))), lists, acc, listacc, step, ind) else v;
            if gl-ok?(rest) then gl-ok(str_concat(ind, str_concat("float l", str_concat(int_to_str(nth(x, 1)), str_concat(" = ", str_concat(gl-val(v), str_concat(";", str_concat(gl-nl(), gl-val(rest))))))))) else rest;
        }
        def gl-seq-exit(items, c, lists, acc, listacc, step, ind) {
            let x = head(items);
            let cond = gl-cond(nth(x, 1), c);
            let condtext = if eq(nth(x, 3), 0) then cond else if gl-ok?(cond) then gl-ok(str_concat("(!", str_concat(gl-val(cond), ")"))) else cond;
            let ans = gl-seq-answer(nth(x, 2), c, acc, listacc);
            let rest = if and(gl-ok?(condtext), gl-ok?(ans)) then gl-seq-items(tail(items), c, lists, acc, listacc, step, ind) else if gl-ok?(condtext) then ans else condtext;
            if gl-ok?(rest) then gl-ok(str_concat(ind, str_concat("if ", str_concat(gl-val(condtext), str_concat(" { ", str_concat(gl-val(ans), str_concat(" return; }", str_concat(gl-nl(), gl-val(rest))))))))) else rest;
        }
        def gl-seq-answer(k, c, acc, listacc) = if and(eq(listacc, 1), gl-acc?(k, acc)) then gl-ok("out[0] = (float)k;") else gl-seq-answer-at(gl-expr(k, c));
        def gl-seq-answer-at(v) = if gl-ok?(v) then gl-ok(str_concat("out[0] = ", str_concat(gl-val(v), ";"))) else v;
        def gl-seq-step(step, c, lists, acc, listacc, ind) {
            let t = gl-tag(step);
            if eq(t, 6) then gl-seq-choice(step, c, lists, acc, listacc, ind) else gl-seq-self(step, c, lists, acc, listacc, ind);
        }
        def gl-seq-choice(step, c, lists, acc, listacc, ind) {
            let cond = gl-cond(gl-a(step), c);
            let a = if gl-ok?(cond) then gl-seq-self(gl-b(step), c, lists, acc, listacc, str_concat(ind, "    ")) else cond;
            let b = if gl-ok?(a) then gl-seq-self(gl-c(step), c, lists, acc, listacc, str_concat(ind, "    ")) else a;
            if gl-ok?(b) then gl-ok(str-join-with(list(str_concat(ind, str_concat("if ", str_concat(gl-val(cond), " {"))), gl-val(a), str_concat(ind, "} else {"), gl-val(b), str_concat(ind, "}")), gl-nl())) else if gl-ok?(a) then b else if gl-ok?(cond) then a else cond;
        }
        // the self call: every argument computed first, then cursors advance and locals take their new values
        def gl-seq-self(step, c, lists, acc, listacc, ind) {
            let args = gl-args(step);
            let pre = gl-seq-args(args, 0, c, lists, acc, listacc, ind, "", "");
            if gl-ok?(pre) then gl-ok(str_concat(nth(gl-val(pre), 0), str_concat(nth(gl-val(pre), 1), str_concat(ind, "continue;")))) else pre;
        }
        // answers list(computations, assignments)
        def gl-seq-args(args, s, c, lists, acc, listacc, ind, comp, asg) = if nil?(args) then gl-ok(list(comp, asg)) else if gl-list-slot?(lists, s) then gl-seq-arg-list(args, s, c, lists, acc, listacc, ind, comp, asg) else if and(eq(s, acc), eq(listacc, 1)) then gl-seq-arg-cons(args, s, c, lists, acc, listacc, ind, comp, asg) else gl-seq-arg-scalar(args, s, c, lists, acc, listacc, ind, comp, asg);
        def gl-seq-arg-list(args, s, c, lists, acc, listacc, ind, comp, asg) = if and(eq(gl-tag(head(args)), 21), and(gl-param?(gl-a(head(args))), eq(gl-slot(gl-a(head(args))), s))) then gl-seq-args(tail(args), add(s, 1), c, lists, acc, listacc, ind, comp, str_concat(asg, str_concat(ind, str_concat("i", str_concat(int_to_str(s), str_concat(" = i", str_concat(int_to_str(s), str_concat(" + 1u;", gl-nl())))))))) else if and(gl-param?(head(args)), eq(gl-slot(head(args)), s)) then gl-seq-args(tail(args), add(s, 1), c, lists, acc, listacc, ind, comp, asg) else gl-no("a list argument that is neither the list nor its tail");
        def gl-seq-arg-cons(args, s, c, lists, acc, listacc, ind, comp, asg) {
            let k = head(args);
            let w = gl-seq-write(k, c, acc, ind);
            if gl-ok?(w) then gl-seq-args(tail(args), add(s, 1), c, lists, acc, listacc, ind, str_concat(comp, gl-val(w)), asg) else w;
        }
        // the accumulator argument of a list-building walk: a cons writes, a choice writes under its condition
        def gl-seq-write(k, c, acc, ind) {
            let t = gl-tag(k);
            if gl-acc?(k, acc) then gl-ok("") else if eq(t, 19) then gl-seq-write-cons(k, c, acc, ind) else if eq(t, 6) then gl-seq-write-choice(k, c, acc, ind) else gl-no("a list accumulator changed other than by cons");
        }
        def gl-seq-write-cons(k, c, acc, ind) {
            let e = gl-expr(gl-a(k), c);
            if and(gl-ok?(e), gl-acc?(gl-b(k), acc)) then gl-ok(str_concat(ind, str_concat("out[1u + k] = ", str_concat(gl-val(e), str_concat("; k = k + 1u;", gl-nl()))))) else if gl-ok?(e) then gl-no("a cons onto something other than the accumulator") else e;
        }
        def gl-seq-write-choice(k, c, acc, ind) {
            let cond = gl-cond(gl-a(k), c);
            let a = if gl-ok?(cond) then gl-seq-write(gl-b(k), c, acc, str_concat(ind, "    ")) else cond;
            let b = if gl-ok?(a) then gl-seq-write(gl-c(k), c, acc, str_concat(ind, "    ")) else a;
            if gl-ok?(b) then gl-ok(str_concat(ind, str_concat("if ", str_concat(gl-val(cond), str_concat(" {", str_concat(gl-nl(), str_concat(gl-val(a), str_concat(ind, str_concat("} else {", str_concat(gl-nl(), str_concat(gl-val(b), str_concat(ind, str_concat("}", gl-nl()))))))))))))) else if gl-ok?(a) then b else if gl-ok?(cond) then a else cond;
        }
        def gl-seq-arg-scalar(args, s, c, lists, acc, listacc, ind, comp, asg) {
            let e = gl-expr(head(args), c);
            if gl-ok?(e) then gl-seq-args(tail(args), add(s, 1), c, lists, acc, listacc, ind, str_concat(comp, str_concat(ind, str_concat("float t", str_concat(int_to_str(s), str_concat(" = ", str_concat(gl-val(e), str_concat(";", gl-nl()))))))), str_concat(asg, str_concat(ind, str_concat("v", str_concat(int_to_str(s), str_concat(" = t", str_concat(int_to_str(s), str_concat(";", gl-nl())))))))) else e;
        }

        // ---- a program: lowered, admitted; list(1, version, lists, msl, kind, scalars) or list(0, reason) ----
        def gl-program(name) = gl-program-bound(name, list());
        def gl-program-bound(name, bindings) {
            let low = gl-lower-bound(name, bindings);
            if gl-ok?(low) then gl-admit(nth(low, 1), nth(low, 2), nth(low, 4), nth(low, 5)) else low;
        }
        def gl-kind(low) = nth(low, 4);
        def gl-entry(kind) = if str_eq(kind, "map") then "form_map" else if str_eq(kind, "filter") then "form_filter" else if str_eq(kind, "any") then "form_any" else if str_eq(kind, "seq") then "form_seq" else "form_reduce";
        def gl-admit(msl, lists, kind, scalars) {
            let version = mj-memory(msl, gl-entry(kind));
            if nothing?(version) then gl-no(str_concat("metal declined the program: ", metal_status())) else list(1, version, lists, msl, kind, scalars);
        }
        def gl-identity(prog) = nth(nth(prog, 1), 1);

        // ---- data: floats to a resident buffer (the door packs a list once, in C), and back ----
        def gl-f32-buf(xs) {
            let h = metal_buf_alloc(mul(4, len(xs)));
            let wrote = metal_buf_write(h, 0, xs);
            h;
        }
        def gl-u32(s) = add(str_byte_at(s, 0), add(mul(str_byte_at(s, 1), 256), add(mul(str_byte_at(s, 2), 65536), mul(str_byte_at(s, 3), 16777216))));
        def gl-u32-at(s, i) = add(str_byte_at(s, i), add(mul(str_byte_at(s, add(i, 1)), 256), add(mul(str_byte_at(s, add(i, 2)), 65536), mul(str_byte_at(s, add(i, 3)), 16777216))));
        def gl-f32-of(w) {
            let sign = if ge(w, 2147483648) then 1 else 0;
            let body = if eq(sign, 1) then sub(w, 2147483648) else w;
            let e = div(body, 8388608);
            let m = mod(body, 8388608);
            let mag = if eq(e, 0) then mul(add(m, 0.0), fq-pow2(-149)) else mul(add(1.0, div(add(m, 0.0), 8388608.0)), fq-pow2(sub(e, 127)));
            if eq(sign, 1) then sub(0.0, mag) else mag;
        }

        // ---- one call: one enqueue, nothing waited; the pending answer is the out buffer ----
        // scalars ride as constants in slot order after n and init; a map and a filter answer n floats (a filter's count at out[0])
        def gl-bits-onto(xs, acc) = if nil?(xs) then reverse(acc) else gl-bits-onto(tail(xs), cons(md-f32-bits(head(xs)), acc));
        def gl-run(prog, bufs, n, init, scalars) {
            let kind = nth(prog, 4);
            let wide = or(str_eq(kind, "map"), or(str_eq(kind, "filter"), str_eq(kind, "seq")));
            let group = or(str_eq(kind, "reduce"), or(str_eq(kind, "filter"), str_eq(kind, "any")));
            let out = metal_buf_alloc(if wide then mul(4, add(n, 1)) else 4);
            let consts = cons(n, cons(md-f32-bits(init), gl-bits-onto(scalars, list())));
            let bind = if group then md-bind16(append(bufs, list(out)), consts, 1024, 0, 1, 0) else md-bind(append(bufs, list(out)), consts);
            let enq = mj-enqueue(nth(prog, 1), bind, if group then 1 else if str_eq(kind, "seq") then 1 else n);
            if eq(enq, 1) then out else gl-no(str_concat("enqueue declined: ", metal_status()));
        }
        def gl-read(out) = gl-f32-of(gl-u32(metal_buf_read(out, 0, 4)));
        // the first n floats of a resident buffer, decoded here from one read
        def gl-read-n(out, n) = gl-floats-onto(metal_buf_read(out, 0, mul(4, n)), 0, n, list());
        def gl-floats-onto(s, i, n, acc) = if ge(i, n) then reverse(acc) else gl-floats-onto(s, add(i, 1), n, cons(gl-f32-of(gl-u32-at(s, mul(4, i))), acc));
        // a filter's answer: the count at out[0], then that many floats
        def gl-read-filter(out) {
            let cnt = float_to_int(gl-read(out));
            gl-floats-onto(metal_buf_read(out, 4, mul(4, cnt)), 0, cnt, list());
        }

        // ---- a counter out of metal_status ----
        def gl-count(key) {
            let s = metal_status();
            let at = str_find(s, str_concat(key, "="), 0);
            if lt(at, 0) then -1 else gl-count-at(s, add(at, add(str_len(key), 1)), 0);
        }
        def gl-count-at(s, i, acc) = if ge(i, str_len(s)) then acc else if and(ge(str_byte_at(s, i), 48), le(str_byte_at(s, i), 57)) then gl-count-at(s, add(i, 1), add(mul(acc, 10), sub(str_byte_at(s, i), 48))) else acc;
    }
}
