            let cond = gl-cond(gl-a(fold), c);
            let condtext = keep-then ? cond : gl-ok?(cond) ? gl-ok("(!" ++ gl-val(cond) ++ ")") : cond;
            let elem = gl-ok?(condtext) ? gl-expr(gl-a(keep-then ? gl-b(fold) : gl-c(fold)), c) : condtext;
            gl-ok?(elem) ? list(1, gl-source-filter(funcs, lists, scalars, ltext, gl-val(condtext), gl-val(elem)), lists, acc, "filter", scalars) : elem;
        }
        // an if choosing between two self calls: a filter when one keeps and one conses, else the walk
        def gl-lower-choice(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings, lt2) {
            let c = lt2[1];
            let tf = gl-fold-node(gl-args(gl-b(step)), 0, acc);
            let ef = gl-fold-node(gl-args(gl-c(step)), 0, acc);
            let keep-then = gl-cons-onto?(tf, acc);
            let keep-else = gl-cons-onto?(ef, acc);
            let plain = gl-self-args-ok?(gl-args(gl-b(step)), 0, lists, acc) && gl-self-args-ok?(gl-args(gl-c(step)), 0, lists, acc);
            let cond = gl-cond(gl-a(step), c);
            let condtext = keep-then ? cond : gl-ok?(cond) ? gl-ok("(!" ++ gl-val(cond) ++ ")") : cond;
            let elem = gl-ok?(condtext) ? gl-expr(gl-a(keep-then ? tf : ef), c) : condtext;
            ((Comparable) plain == 0) || (!((keep-then && gl-acc?(ef, acc)) || (keep-else && gl-acc?(tf, acc)))) ? gl-lower-seq(idx, arity, lists, acc, scalars, lets, exits, step, funcs, bindings) : gl-ok?(elem) ? list(1, gl-source-filter(funcs, lists, scalars, lt2[0], gl-val(condtext), gl-val(elem)), lists, acc, "filter", scalars) : elem;
        }
        def gl-finish(kind, elem, lists, acc, scalars, funcs, ltext, unused) = gl-ok?(elem) ? list(1, (String) kind == "map" ? gl-source-map(funcs, lists, scalars, ltext, gl-val(elem)) : gl-source-reduce(funcs, lists, scalars, ltext, gl-val(elem), kind, "init"), lists, acc, (String) kind == "map" ? "map" : "reduce", scalars) : elem;
        def gl-lower-any(idx, arity, lists, scalars, lets, exits, early, step, funcs, bindings, c) {
            let lt2 = gl-lets-text(lets, c, "        ", "");
            let c2 = gl-ok?(lt2) ? gl-val(lt2)[1] : c;
            let e = head(early);
            let cond = gl-cond(e[1], c2);
            let condtext = (Comparable) e[3] == 0 ? cond : gl-ok?(cond) ? gl-ok("(!" ++ gl-val(cond) ++ ")") : cond;
            let hit = gl-expr(e[2], c2);
            let miss = gl-expr(head(exits)[2], c2);
            !gl-ok?(lt2) ? lt2 : !gl-ok?(condtext) ? condtext : !gl-ok?(hit) ? hit : !gl-ok?(miss) ? miss : (Comparable) gl-self-args-ok?(gl-args(step), 0, lists, nothing()) == 0 ? gl-lower-seq(idx, arity, lists, nothing(), scalars, lets, exits, step, funcs, bindings) : list(1, gl-source-any(funcs, lists, scalars, gl-val(lt2)[0], gl-val(condtext), gl-val(hit), gl-val(miss)), lists, nothing(), "any", scalars);
        }
        // (if (nil? xs) INIT (op E (self (tail xs)))): the fold seen from the right; joins run parallel, the rest walk from the end
        def gl-lower-nontail(idx, arity, lists, scalars, lets, exits, step, funcs, bindings, c) {
            let lt2 = gl-lets-text(lets, c, "        ", "");
            let c2 = gl-ok?(lt2) ? gl-val(lt2)[1] : c;
            let selfa = gl-self?(gl-a(step), idx);
            let selfb = gl-self?(gl-b(step), idx);
            let t = gl-tag(step);
            let kind = !gl-binary?(t) ? "general" : !(selfa || selfb) ? "general" : (Comparable) t == 3 ? "add" : (Comparable) t == 42 ? "mul" : "general";
            let elem = selfa || selfb ? gl-expr(selfa ? gl-b(step) : gl-a(step), c2) : gl-no("recursion that is not a fold: the self call is not one operand of the answer");
            let inittext = nil?(exits) ? gl-no("a fold with no base") : gl-expr(head(exits)[2], c2);
            let folded = (String) kind == "general" ? gl-rfold-text(step, idx, c2) : gl-ok("");
            !gl-ok?(lt2) ? lt2 : !gl-ok?(elem) ? elem : !gl-ok?(inittext) ? inittext : !gl-ok?(folded) ? folded : (String) kind == "general" ? list(1, gl-source-rfold(funcs, lists, scalars, gl-val(lt2)[0], gl-val(folded), gl-val(inittext)), lists, nothing(), "seq", scalars) : list(1, gl-source-reduce(funcs, lists, scalars, gl-val(lt2)[0], gl-val(elem), kind, gl-val(inittext)), lists, nothing(), "reduce", scalars);
        }
        // the fold expression with the self call read as acc
        def gl-rfold-text(step, idx, c) {
            let x = gl-self?(gl-a(step), idx) ? gl-ok("acc") : gl-expr(gl-a(step), c);
            let y = gl-self?(gl-b(step), idx) ? gl-ok("acc") : gl-expr(gl-b(step), c);
            let t = gl-tag(step);
            let op = (Comparable) t == 3 ? " + " : (Comparable) t == 4 ? " - " : (Comparable) t == 42 ? " * " : (Comparable) t == 10 ? " / " : "";
            !gl-ok?(x) ? x : !gl-ok?(y) ? y : (Comparable) str_len(op) == 0 ? gl-no("a right fold through node tag " ++ int_to_str(t)) : gl-ok("(" ++ gl-val(x) ++ op ++ gl-val(y) ++ ")");
        }

        // ---- the walk on one thread: items and the step as statements over cursors and locals ----
        def gl-lower-seq(idx, arity, lists, acc, scalars2, lets, exits, step, funcs, bindings) {
            let scalars = gl-seq-scalars(arity, lists, 0, list());
            let env = gl-seq-env(arity, lists, 0, list());
            let c = gl-ctx(idx, lists, env, 0, bindings, "seq");
            let listacc = nothing?(acc) ? 0 : gl-has-tag?(step, 19);
            let body = gl-seq-items(gl-seq-order(lets, exits), c, lists, acc, listacc, step, "        ");
            gl-ok?(body) ? list(1, gl-source-seq(funcs, lists, gl-drop-bound(scalars, bindings), gl-val(body), acc), lists, acc, "seq", gl-without(gl-drop-bound(scalars, bindings), acc)) : body;
        }
        def gl-seq-scalars(arity, lists, s, out) = s >= arity ? reverse(out) : gl-seq-scalars(arity, lists, s + 1, gl-list-slot?(lists, s) ? out : cons(s, out));
        def gl-seq-env(arity, lists, s, env) = s >= arity ? env : gl-seq-env(arity, lists, s + 1, gl-list-slot?(lists, s) ? env : gl-env-put(env, s, "v" ++ int_to_str(s)));
        // items in source order: lets and exits interleaved as the chain met them
        def gl-seq-order(lets, exits) = gl-seq-merge(lets, exits);
        def gl-seq-merge(lets, exits) = nil?(lets) ? exits : nil?(exits) ? lets : gl-item-node(head(lets)) < gl-item-node(head(exits)) ? cons(head(lets), gl-seq-merge(tail(lets), exits)) : cons(head(exits), gl-seq-merge(lets, tail(exits)));
        def gl-item-node(x) = (String) x[0] == "let" ? x[2] : x[1];
        def gl-seq-items(items, c, lists, acc, listacc, step, ind) = nil?(items) ? gl-seq-step(step, c, lists, acc, listacc, ind) : (String) head(items)[0] == "let" ? gl-seq-let(items, c, lists, acc, listacc, step, ind) : gl-seq-exit(items, c, lists, acc, listacc, step, ind);
        def gl-seq-let(items, c, lists, acc, listacc, step, ind) {
            let x = head(items);
            let v = gl-expr(x[2], c);
            let rest = gl-ok?(v) ? gl-seq-items(tail(items), gl-with-env(c, gl-env-put(gl-ctx-env(c), x[1], "l" ++ int_to_str(x[1]))), lists, acc, listacc, step, ind) : v;
            gl-ok?(rest) ? gl-ok(ind ++ "float l" ++ int_to_str(x[1]) ++ " = " ++ gl-val(v) ++ ";" ++ gl-nl() ++ gl-val(rest)) : rest;
        }
        def gl-seq-exit(items, c, lists, acc, listacc, step, ind) {
            let x = head(items);
            let cond = gl-cond(x[1], c);
            let condtext = (Comparable) x[3] == 0 ? cond : gl-ok?(cond) ? gl-ok("(!" ++ gl-val(cond) ++ ")") : cond;
            let ans = gl-seq-answer(x[2], c, acc, listacc);
            let rest = gl-ok?(condtext) && gl-ok?(ans) ? gl-seq-items(tail(items), c, lists, acc, listacc, step, ind) : gl-ok?(condtext) ? ans : condtext;
            gl-ok?(rest) ? gl-ok(ind ++ "if " ++ gl-val(condtext) ++ " { " ++ gl-val(ans) ++ " return; }" ++ gl-nl() ++ gl-val(rest)) : rest;
        }
        def gl-seq-answer(k, c, acc, listacc) = ((Comparable) listacc == 1) && gl-acc?(k, acc) ? gl-ok("out[0] = (float)k;") : gl-seq-answer-at(gl-expr(k, c));
        def gl-seq-answer-at(v) = gl-ok?(v) ? gl-ok("out[0] = " ++ gl-val(v) ++ ";") : v;
        def gl-seq-step(step, c, lists, acc, listacc, ind) {
            let t = gl-tag(step);
            (Comparable) t == 6 ? gl-seq-choice(step, c, lists, acc, listacc, ind) : gl-seq-self(step, c, lists, acc, listacc, ind);
        }
        def gl-seq-choice(step, c, lists, acc, listacc, ind) {
            let cond = gl-cond(gl-a(step), c);
            let a = gl-ok?(cond) ? gl-seq-self(gl-b(step), c, lists, acc, listacc, ind ++ "    ") : cond;
            let b = gl-ok?(a) ? gl-seq-self(gl-c(step), c, lists, acc, listacc, ind ++ "    ") : a;
            gl-ok?(b) ? gl-ok(str-join-with(list(ind ++ "if " ++ gl-val(cond) ++ " {", gl-val(a), ind ++ "} else {", gl-val(b), ind ++ "}"), gl-nl())) : gl-ok?(a) ? b : gl-ok?(cond) ? a : cond;
        }
        // the self call: every argument computed first, then cursors advance and locals take their new values
        def gl-seq-self(step, c, lists, acc, listacc, ind) {
            let args = gl-args(step);
            let pre = gl-seq-args(args, 0, c, lists, acc, listacc, ind, "", "");
            gl-ok?(pre) ? gl-ok(gl-val(pre)[0] ++ gl-val(pre)[1] ++ ind ++ "continue;") : pre;
        }
        // answers list(computations, assignments)
        def gl-seq-args(args, s, c, lists, acc, listacc, ind, comp, asg) = nil?(args) ? gl-ok(list(comp, asg)) : gl-list-slot?(lists, s) ? gl-seq-arg-list(args, s, c, lists, acc, listacc, ind, comp, asg) : ((Comparable) s == acc) && ((Comparable) listacc == 1) ? gl-seq-arg-cons(args, s, c, lists, acc, listacc, ind, comp, asg) : gl-seq-arg-scalar(args, s, c, lists, acc, listacc, ind, comp, asg);
        def gl-seq-arg-list(args, s, c, lists, acc, listacc, ind, comp, asg) = ((Comparable) gl-tag(head(args)) == 21) && (gl-param?(gl-a(head(args))) && ((Comparable) gl-slot(gl-a(head(args))) == s)) ? gl-seq-args(tail(args), s + 1, c, lists, acc, listacc, ind, comp, asg ++ ind ++ "i" ++ int_to_str(s) ++ " = i" ++ int_to_str(s) ++ " + 1u;" ++ gl-nl()) : gl-param?(head(args)) && ((Comparable) gl-slot(head(args)) == s) ? gl-seq-args(tail(args), s + 1, c, lists, acc, listacc, ind, comp, asg) : gl-no("a list argument that is neither the list nor its tail");
        def gl-seq-arg-cons(args, s, c, lists, acc, listacc, ind, comp, asg) {
            let k = head(args);
            let w = gl-seq-write(k, c, acc, ind);
            gl-ok?(w) ? gl-seq-args(tail(args), s + 1, c, lists, acc, listacc, ind, comp ++ gl-val(w), asg) : w;
        }
        // the accumulator argument of a list-building walk: a cons writes, a choice writes under its condition
        def gl-seq-write(k, c, acc, ind) {
            let t = gl-tag(k);
            gl-acc?(k, acc) ? gl-ok("") : (Comparable) t == 19 ? gl-seq-write-cons(k, c, acc, ind) : (Comparable) t == 6 ? gl-seq-write-choice(k, c, acc, ind) : gl-no("a list accumulator changed other than by cons");
        }
        def gl-seq-write-cons(k, c, acc, ind) {
            let e = gl-expr(gl-a(k), c);
            gl-ok?(e) && gl-acc?(gl-b(k), acc) ? gl-ok(ind ++ "out[1u + k] = " ++ gl-val(e) ++ "; k = k + 1u;" ++ gl-nl()) : gl-ok?(e) ? gl-no("a cons onto something other than the accumulator") : e;
        }
        def gl-seq-write-choice(k, c, acc, ind) {
            let cond = gl-cond(gl-a(k), c);
            let a = gl-ok?(cond) ? gl-seq-write(gl-b(k), c, acc, ind ++ "    ") : cond;
            let b = gl-ok?(a) ? gl-seq-write(gl-c(k), c, acc, ind ++ "    ") : a;
            gl-ok?(b) ? gl-ok(ind ++ "if " ++ gl-val(cond) ++ " {" ++ gl-nl() ++ gl-val(a) ++ ind ++ "} else {" ++ gl-nl() ++ gl-val(b) ++ ind ++ "}" ++ gl-nl()) : gl-ok?(a) ? b : gl-ok?(cond) ? a : cond;
        }
        def gl-seq-arg-scalar(args, s, c, lists, acc, listacc, ind, comp, asg) {
            let e = gl-expr(head(args), c);
            gl-ok?(e) ? gl-seq-args(tail(args), s + 1, c, lists, acc, listacc, ind, comp ++ ind ++ "float t" ++ int_to_str(s) ++ " = " ++ gl-val(e) ++ ";" ++ gl-nl(), asg ++ ind ++ "v" ++ int_to_str(s) ++ " = t" ++ int_to_str(s) ++ ";" ++ gl-nl()) : e;
        }

        // ---- a program: lowered, admitted; list(1, version, lists, msl, kind, scalars) or list(0, reason) ----
        def gl-program(name) = gl-program-bound(name, list());
        def gl-program-bound(name, bindings) {
            let low = gl-lower-bound(name, bindings);
            gl-ok?(low) ? gl-admit(low[1], low[2], low[4], low[5]) : low;
        }
        def gl-kind(low) = low[4];
        def gl-entry(kind) = (String) kind == "map" ? "form_map" : (String) kind == "filter" ? "form_filter" : (String) kind == "any" ? "form_any" : (String) kind == "seq" ? "form_seq" : "form_reduce";
        def gl-admit(msl, lists, kind, scalars) {
            let version = mj-memory(msl, gl-entry(kind));
            nothing?(version) ? gl-no("metal declined the program: " ++ metal_status()) : list(1, version, lists, msl, kind, scalars);
        }
        def gl-identity(prog) = prog[1][1];

        // ---- data: floats to a resident buffer (the door packs a list once, in C), and back ----
        def gl-f32-buf(xs) {
            let h = metal_buf_alloc(4 * len(xs));
            let wrote = metal_buf_write(h, 0, xs);
            h;
        }
        def gl-u32(s) = str_byte_at(s, 0) + ((str_byte_at(s, 1) * 256) + ((str_byte_at(s, 2) * 65536) + (str_byte_at(s, 3) * 16777216)));
        def gl-u32-at(s, i) = str_byte_at(s, i) + ((str_byte_at(s, i + 1) * 256) + ((str_byte_at(s, i + 2) * 65536) + (str_byte_at(s, i + 3) * 16777216)));
        def gl-f32-of(w) {
            let sign = w >= 2147483648 ? 1 : 0;
            let body = (Comparable) sign == 1 ? (w - 2147483648) : w;
            let e = body / 8388608;
            let m = body % 8388608;
            let mag = (Comparable) e == 0 ? ((m + 0.0) * fq-pow2(-149)) : ((1.0 + ((m + 0.0) / 8388608.0)) * fq-pow2(e - 127));
            (Comparable) sign == 1 ? (0.0 - mag) : mag;
        }

        // ---- one call: one enqueue, nothing waited; the pending answer is the out buffer ----
        // scalars ride as constants in slot order after n and init; a map and a filter answer n floats (a filter's count at out[0])
        def gl-bits-onto(xs, acc) = nil?(xs) ? reverse(acc) : gl-bits-onto(tail(xs), cons(md-f32-bits(head(xs)), acc));
        def gl-run(prog, bufs, n, init, scalars) {
            let kind = prog[4];
            let wide = ((String) kind == "map") || (((String) kind == "filter") || ((String) kind == "seq"));
            let group = ((String) kind == "reduce") || (((String) kind == "filter") || ((String) kind == "any"));
            let out = metal_buf_alloc(wide ? (4 * (n + 1)) : 4);
            let consts = cons(n, cons(md-f32-bits(init), gl-bits-onto(scalars, list())));
            let bind = group ? md-bind16(append(bufs, list(out)), consts, 1024, 0, 1, 0) : md-bind(append(bufs, list(out)), consts);
            let enq = mj-enqueue(prog[1], bind, group ? 1 : (String) kind == "seq" ? 1 : n);
            (Comparable) enq == 1 ? out : nothing();
        }
        // a call whose enqueue was declined answers nothing (metal_status names why, at last_error), and so does its read
        def gl-read(out) = nothing?(out) ? nothing() : gl-f32-of(gl-u32(metal_buf_read(out, 0, 4)));
        // the first n floats of a resident buffer, decoded here from one read
        def gl-read-n(out, n) = nothing?(out) ? nothing() : gl-floats(metal_buf_read(out, 0, 4 * n), n);
        def gl-floats(s, n) = 0 .. n |> map(i => gl-f32-of(gl-u32-at(s, 4 * i)));
        // a filter's answer: the count at out[0], then that many floats
        def gl-read-filter(out) = nothing?(out) ? nothing() : gl-read-kept(out, float_to_int(gl-read(out)));
        def gl-read-kept(out, cnt) = gl-floats(metal_buf_read(out, 4, 4 * cnt), cnt);

        // ---- a counter out of metal_status: nothing when the status does not carry it (a carrier not loaded names no counter) ----
        def gl-count(key) {
            let s = metal_status();
            let at = str_find(s, key ++ "=", 0);
            at < 0 ? nothing() : gl-count-at(s, at + (str_len(key) + 1), 0);
        }
        def gl-count-at(s, i, acc) = i >= str_len(s) ? acc : (str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57) ? gl-count-at(s, i + 1, (acc * 10) + (str_byte_at(s, i) - 48)) : acc;
    }
}
