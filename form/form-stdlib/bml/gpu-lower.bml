            let thn = gl-b(k);
            let els = gl-c(k);
            let lists2 = if gl-nil-call?(cond) then gl-add-list(lists, gl-nil-slot(cond)) else lists;
            let ts = gl-has-self?(thn, idx);
            let es = gl-has-self?(els, idx);
            if and(eq(ts, 0), es) then gl-chain(els, idx, lists2, cons(list("exit", cond, thn, 0), items)) else if and(ts, eq(es, 0)) then gl-chain(thn, idx, lists2, cons(list("exit", cond, els, 1), items)) else if and(ts, es) then list(1, lists2, reverse(items), k) else gl-no("no loop: the body never calls itself");
        }
        def gl-items-lets(items) = if nil?(items) then list() else if str_eq(nth(head(items), 0), "let") then cons(head(items), gl-items-lets(tail(items))) else gl-items-lets(tail(items));
        def gl-items-exits(items) = if nil?(items) then list() else if str_eq(nth(head(items), 0), "exit") then cons(head(items), gl-items-exits(tail(items))) else gl-items-exits(tail(items));
        def gl-nil-exit?(x) = and(gl-nil-call?(nth(x, 1)), eq(nth(x, 3), 0));
        def gl-early-exits(exits) = if nil?(exits) then list() else if gl-nil-exit?(head(exits)) then gl-early-exits(tail(exits)) else cons(head(exits), gl-early-exits(tail(exits)));
