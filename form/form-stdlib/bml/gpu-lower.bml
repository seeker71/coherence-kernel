        // ---- kernel texts ----
        def gl-nl() = byte_to_str(10);
        def gl-buffers(lists, j, acc) = if nil?(lists) then reverse(acc) else gl-buffers(tail(lists), add(j, 1), cons(str_concat("device const float *p", str_concat(int_to_str(head(lists)), str_concat(" [[buffer(", str_concat(int_to_str(j), ")]], ")))), acc));
        def gl-consts(scalars, j, acc) = if nil?(scalars) then reverse(acc) else gl-consts(tail(scalars), add(j, 1), cons(str_concat("constant float &c", str_concat(int_to_str(head(scalars)), str_concat(" [[buffer(", str_concat(int_to_str(j), ")]], ")))), acc));
        def gl-head-text(lists, scalars, extra) = str_concat(str-join(gl-buffers(lists, 0, list())), str_concat("device float *out [[buffer(", str_concat(int_to_str(len(lists)), str_concat(")]], constant uint &n [[buffer(", str_concat(int_to_str(add(len(lists), 1)), str_concat(")]], constant float &init [[buffer(", str_concat(int_to_str(add(len(lists), 2)), str_concat(")]], ", str_concat(str-join(gl-consts(scalars, add(len(lists), 3), list())), extra)))))))));
        def gl-prelude(funcs) = str-join-with(append(list("#pragma clang fp contract(off)", "#include <metal_stdlib>", "using namespace metal;"), funcs), gl-nl());
        def gl-tg-args() = "uint tid [[thread_position_in_threadgroup]], uint tpg [[threads_per_threadgroup]], uint sid [[simdgroup_index_in_threadgroup]], uint lane [[thread_index_in_simdgroup]]";
        def gl-op-id(kind) = if str_eq(kind, "add") then "0.0f" else if str_eq(kind, "mul") then "1.0f" else if str_eq(kind, "max") then "-INFINITY" else "INFINITY";
