            if nothing?(v) then nothing() else gl-eval(gl-c(k), gl-env-put(env, gl-a(gl-a(k)), v), elem, depth, bind);
        }
        def gl-eval-call(callee, args, env, elem, depth, bind) {
            let row = gl-callee-row(callee);
            let vals = gl-eval-args(args, env, elem, depth, bind, list());
            if or(nothing?(row), nothing?(vals)) then nothing() else gl-eval(gl-unwrap(gl-row-body(row)), gl-fn-env-vals(vals, 0, list()), elem, add(depth, 1), bind);
        }
        def gl-eval-bound(k, env, elem, depth, bind) {
            let f = gl-a(k);
            let name = if gl-param?(f) then gl-env-get(bind, gl-slot(f)) else nothing();
            let row = if nothing?(name) then nothing() else gl-find(name);
            if nothing?(row) then nothing() else gl-eval-call(gl-row-idx(row), gl-args-onto(gl-b(k), list()), env, elem, depth, bind);
        }
        def gl-eval-args(ks, env, elem, depth, bind, acc) = if nil?(ks) then reverse(acc) else gl-eval-args-at(ks, env, elem, depth, bind, acc, gl-eval(head(ks), env, elem, depth, bind));
        def gl-eval-args-at(ks, env, elem, depth, bind, acc, v) = if nothing?(v) then nothing() else gl-eval-args(tail(ks), env, elem, depth, bind, cons(v, acc));
        def gl-fn-env-vals(vals, k, acc) = if nil?(vals) then acc else gl-fn-env-vals(tail(vals), add(k, 1), gl-env-put(acc, k, head(vals)));
        def gl-eval1(t, x) = if nothing?(x) then nothing() else if eq(t, 81) then math_sqrt(x) else if eq(t, 89) then math_exp(x) else if eq(t, 90) then math_log(x) else if eq(t, 54) then add(float_to_int(x), 0.0) else if eq(t, 72) then if eq(x, 0.0) then 1.0 else 0.0 else if eq(t, 138) then 0.0 else nothing();
        def gl-eval2(t, x, y) = if or(nothing?(x), nothing?(y)) then nothing() else if eq(t, 3) then add(x, y) else if eq(t, 4) then sub(x, y) else if eq(t, 42) then mul(x, y) else if eq(t, 10) then div(x, y) else if eq(t, 11) then sub(x, mul(y, add(float_to_int(div(x, y)), 0.0))) else if eq(t, 5) then if le(x, y) then 1.0 else 0.0 else if eq(t, 103) then if lt(x, y) then 1.0 else 0.0 else if eq(t, 102) then if eq(x, y) then 1.0 else 0.0 else if eq(t, 70) then if and(not(eq(x, 0.0)), not(eq(y, 0.0))) then 1.0 else 0.0 else if eq(t, 71) then if or(not(eq(x, 0.0)), not(eq(y, 0.0))) then 1.0 else 0.0 else if eq(t, 195) then math_pow(x, y) else nothing();
        // the fold's operator: add or mul with the accumulator as a direct operand read off the node; a
