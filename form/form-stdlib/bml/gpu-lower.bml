            let args = if gl-call?(fold) then gl-args(fold) else if eq(t, 244) then gl-args-onto(gl-b(fold), list()) else list();
            let callee = if gl-call?(fold) then gl-a(fold) else if eq(t, 244) then gl-bound-idx(fold, gl-ctx(0, list(), list(), 0, bind, "par")) else -1;
            if and(eq(t, 3), direct) then "add" else if and(eq(t, 42), direct) then "mul" else if and(ge(callee, 0), and(eq(len(args), 2), or(gl-acc?(nth(args, 0), acc), gl-acc?(nth(args, 1), acc)))) then gl-callee-kind(callee, if gl-acc?(nth(args, 0), acc) then 0 else 1, bind) else gl-fold-kind(fold, acc, bind);
        }
        def gl-callee-kind(callee, pos, bind) {
            let body = gl-unwrap(gl-row-body(gl-callee-row(callee)));
            let r1 = gl-eval(body, gl-pair-env(pos, 3.0, 5.0), 0.0, 1, bind);
            let r2 = gl-eval(body, gl-pair-env(pos, 5.0, 3.0), 0.0, 1, bind);
