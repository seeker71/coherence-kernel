//////////////////////////////////////////////////////////////////////
// parse.bml — the body's one reading door: text becomes a value, or a cell.
//
// Urs, 2026-10-02, meeting `parse_int` where the body's word is str_to_int: "stdlib and BML shall know how to
// parse any primitive and any cell of any type." The natives already read (str_to_int, str_to_float, the JSON
// reader in json.fk, the cell reader in cell-serialize.fk), but each reads whatever it is handed and each caller
// guarded it with its own digit walk (host-walk.bml hw-number, json-view-parse.bml, form-cli-heal.bml ...).
// Here the guard is said once, and a reading that did not arrive is nothing(), never 0 and never -1
// (axiom 1; teachings/surprise-is-a-choice-point.md).
//
//   parse-int(text)               "42" "-7" "+3"              -> int, or nothing()
//   parse-float(text)             "3.5" "-1e-3" "2E+4" "7"    -> float, or nothing()
//   parse-number(text)            an int when it reads as one, else a float, else nothing()
//   parse-bool(text)              "true" "false"              -> 1 / 0, or nothing()
//   parse-as(kind,text,registry)  kind: int float number bool string json cell
//   parse-any(text,registry)      nothing, bool, number, JSON document, cell, else the text itself
//
// And the other way, so a value can be stored or streamed and read back the same:
//
//   encode(value,registry)        any value -> typed JSON text (int, float, string, nothing, list, cell)
//   decode(text,registry)         that text -> the same value; a cell to the same NodeID
//   encode-lines / decode-lines   a list of values <-> newline-delimited rows (a ledger, a stream)
//   convert(value,kind,registry)  between kinds: string int float bool list cell text any
//
// A cell is read through the Blueprint registry (wire-registry.fk): the same name and children mint the same
// NodeID, so a cell parsed here is the cell that was written (axiom 3). Whitespace around a scalar is not part
// of it. Every reader answers the same way for text that is not its kind: nothing().
//////////////////////////////////////////////////////////////////////
// preludes: form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/wire-registry.fk form-stdlib/cell-serialize.fk
section [form.bml] {
 class FormParse {
  // ---- the digit walk, once ----------------------------------------------------
  def pr-digit?(b) = (b >= 48) && (b <= 57);
  def pr-digits-end(s, i) = (i < len(s)) && pr-digit?(str_byte_at(s, i)) ? pr-digits-end(s, i + 1) : i;
  def pr-sign-end(s) = (len(s) > 0) && ((str_byte_at(s, 0) == 45) || (str_byte_at(s, 0) == 43)) ? 1 : 0;
  def pr-unsigned(s) = pr-sign-end(s) == 1 ? substring(s, 1, len(s)) : s;
  def pr-neg?(s) = (len(s) > 0) && (str_byte_at(s, 0) == 45);

  // ---- int ---------------------------------------------------------------------
  def pr-int?(t) = (len(t) > pr-sign-end(t)) && (pr-digits-end(t, pr-sign-end(t)) == len(t));
  def parse-int(text) {
   let t = trim(text);
   pr-int?(t) ? (pr-neg?(t) ? str_to_int(t) : str_to_int(pr-unsigned(t))) : nothing();
  }

  // ---- float: [sign] digits [. digits] [e|E [sign] digits] -----------------------
  def pr-frac-end(s, i) = (i < len(s)) && (str_byte_at(s, i) == 46) ? pr-digits-end(s, i + 1) : i;
  def pr-exp-digits(s, i) {
   let j = (i < len(s)) && ((str_byte_at(s, i) == 45) || (str_byte_at(s, i) == 43)) ? i + 1 : i;
   let k = pr-digits-end(s, j);
   k > j ? k : i - 1;
  }
  def pr-exp-end(s, i) = (i < len(s)) && ((str_byte_at(s, i) == 101) || (str_byte_at(s, i) == 69)) ? pr-exp-digits(s, i + 1) : i;
  def pr-float-end(s) = pr-exp-end(s, pr-frac-end(s, pr-digits-end(s, pr-sign-end(s))));
  def pr-float?(t) = (pr-digits-end(t, pr-sign-end(t)) > pr-sign-end(t)) && (pr-float-end(t) == len(t));
  def parse-float(text) {
   let t = trim(text);
   pr-float?(t) ? str_to_float(t) : nothing();
  }

  // ---- number and bool ---------------------------------------------------------
  def parse-number(text) {
   let t = trim(text);
   pr-int?(t) ? parse-int(t) : parse-float(t);
  }
  def parse-bool(text) {
   let t = trim(text);
   ((String) t == "true") || ((String) t == "True") || ((String) t == "TRUE") ? 1 : ((String) t == "false") || ((String) t == "False") || ((String) t == "FALSE") ? 0 : nothing();
  }
  def pr-nothing?(t) = ((String) t == "nothing") || ((String) t == "null");

  // ---- the two structured readers ------------------------------------------------
  def pr-json(text) = parse-json("parse", text);
  def pr-cell(text, registry) = json-to-cell(text, registry);
  def pr-structured?(t) = (len(t) > 0) && ((str_byte_at(t, 0) == 123) || (str_byte_at(t, 0) == 91));

  // ---- by kind -----------------------------------------------------------------
  def parse-as(kind, text, registry) {
   (String) kind == "int" ? parse-int(text) :
   (String) kind == "float" ? parse-float(text) :
   (String) kind == "number" ? parse-number(text) :
   (String) kind == "bool" ? parse-bool(text) :
   (String) kind == "string" ? text :
   (String) kind == "json" ? pr-json(text) :
   (String) kind == "cell" ? pr-cell(text, registry) : nothing();
  }

  // ---- by shape: the reader finds the kind ---------------------------------------
  def parse-any(text, registry) {
   let t = trim(text);
   pr-nothing?(t) ? nothing() :
   !nothing?(parse-bool(t)) ? parse-bool(t) :
   !nothing?(parse-number(t)) ? parse-number(t) :
   pr-structured?(t) ? pr-cell(t, registry) : text;
  }

  // ---- storage and streaming: one text for any value, and back ---------------------
  // encode(v) writes a value as typed JSON text: ints and floats as numbers (a float keeps its point, so 7.0 does
  // not come back as 7), strings quoted and escaped (a row never holds a raw newline), nothing as null, a list as
  // an array, a cell as its Blueprint object. decode(text) reads that text back to the same kind, and a cell to
  // the same NodeID. decode(encode(v)) is v for every kind; a JSONL ledger is encode-lines / decode-lines.
  def pr-float-text(v) {
   let t = value_str(v);
   json-number-float?(t) ? t : (t ++ ".0");
  }
  def pr-join(xs, sep) = nil?(xs) ? "" : (nil?(xs[1:]) ? xs[0] : (xs[0] ++ sep ++ pr-join(xs[1:], sep)));
  def encode(v, registry) {
   nothing?(v) ? "null" :
   (String) value_kind(v) == "int" ? value_str(v) :
   (String) value_kind(v) == "float" ? pr-float-text(v) :
   (String) value_kind(v) == "string" ? json-quote-string(v) :
   (String) value_kind(v) == "list" ? ("[" ++ pr-join(v |> map(x => encode(x, registry)), ",") ++ "]") :
   (String) value_kind(v) == "node_id" ? cell-to-json(v, registry) : "null";
  }
  // elements of "[a,b,[c]]": split on the commas at depth 0, outside strings
  def pr-scan(s, i, start, depth, inq, esc, acc) {
   i >= len(s) ? wr-reverse(cons(substring(s, start, len(s)), acc)) : pr-scan-byte(s, i, str_byte_at(s, i), start, depth, inq, esc, acc);
  }
  def pr-scan-byte(s, i, b, start, depth, inq, esc, acc) {
   inq == 1 ? (esc == 1 ? pr-scan(s, i + 1, start, depth, 1, 0, acc) : (b == 92 ? pr-scan(s, i + 1, start, depth, 1, 1, acc) : (b == 34 ? pr-scan(s, i + 1, start, depth, 0, 0, acc) : pr-scan(s, i + 1, start, depth, 1, 0, acc)))) :
   b == 34 ? pr-scan(s, i + 1, start, depth, 1, 0, acc) :
   ((b == 91) || (b == 123)) ? pr-scan(s, i + 1, start, depth + 1, 0, 0, acc) :
   ((b == 93) || (b == 125)) ? pr-scan(s, i + 1, start, depth - 1, 0, 0, acc) :
   ((b == 44) && (depth == 0)) ? pr-scan(s, i + 1, i + 1, depth, 0, 0, cons(substring(s, start, i), acc)) : pr-scan(s, i + 1, start, depth, 0, 0, acc);
  }
  def pr-list-text?(t) = (len(t) >= 2) && (str_byte_at(t, 0) == 91) && (str_byte_at(t, len(t) - 1) == 93);
  def pr-unwrap(c) = (String) value_kind(c) != "node_id" ? c : (wr-null?(c) ? nothing() : ((Comparable) node_level(c) == 1 ? node_value(c) : c));
  def decode(text, registry) {
   let t = trim(text);
   len(t) == 0 ? nothing() :
   pr-list-text?(t) ? (len(trim(substring(t, 1, len(t) - 1))) == 0 ? [] : (pr-scan(substring(t, 1, len(t) - 1), 0, 0, 0, 0, 0, []) |> map(x => decode(x, registry)))) :
   pr-unwrap(pr-cell(t, registry));
  }
  def encode-lines(values, registry) = nil?(values) ? "" : (encode(values[0], registry) ++ "\n" ++ encode-lines(values[1:], registry));
  def pr-lines(xs) = nil?(xs) ? [] : (len(trim(xs[0])) == 0 ? pr-lines(xs[1:]) : cons(xs[0], pr-lines(xs[1:])));
  def decode-lines(text, registry) = pr-lines(split-on(text, "\n")) |> map(x => decode(x, registry));

  // ---- between kinds -------------------------------------------------------------
  // convert(value, kind, registry): kind is string int float bool list cell text any. A reading that cannot
  // arrive is nothing(); nothing converts to nothing. "text" is the storage form (encode); "any" reads a string
  // by its shape (decode); every other kind reads a string as that kind.
  def pr-as-string(v, registry) = (String) value_kind(v) == "string" ? v : (((String) value_kind(v) == "int") || ((String) value_kind(v) == "float") ? value_str(v) : encode(v, registry));
  def pr-as-int(v) = (String) value_kind(v) == "int" ? v : ((String) value_kind(v) == "float" ? float_to_int(v) : ((String) value_kind(v) == "string" ? parse-int(v) : nothing()));
  def pr-as-float(v) = (String) value_kind(v) == "float" ? v : ((String) value_kind(v) == "int" ? v + 0.0 : ((String) value_kind(v) == "string" ? parse-float(v) : nothing()));
  def pr-as-bool(v) = (String) value_kind(v) == "int" ? ((v != 0) ? 1 : 0) : ((String) value_kind(v) == "float" ? ((v != 0.0) ? 1 : 0) : ((String) value_kind(v) == "string" ? parse-bool(v) : nothing()));
  def convert(v, kind, registry) {
   nothing?(v) ? nothing() :
   (String) kind == "string" ? pr-as-string(v, registry) :
   (String) kind == "int" ? pr-as-int(v) :
   (String) kind == "float" ? pr-as-float(v) :
   (String) kind == "bool" ? pr-as-bool(v) :
   (String) kind == "text" ? encode(v, registry) :
   (String) kind == "list" ? ((String) value_kind(v) == "list" ? v : ((String) value_kind(v) == "string" ? decode(v, registry) : nothing())) :
   (String) kind == "cell" ? ((String) value_kind(v) == "node_id" ? v : ((String) value_kind(v) == "string" ? pr-cell(v, registry) : nothing())) :
   (String) kind == "any" ? ((String) value_kind(v) == "string" ? decode(v, registry) : v) : nothing();
  }
 }
 0;
}
