// Explicit source repair, separate from compiler acceptance. No evaluation or IO.
// Reuse the compiler's lexical boundaries; retain original bytes through inserts.
// Result: [ok, candidate, edits, reason]. Edits: [operator,start,end,arity].
// Only unqualified and/or calls inside section [form.bml] are candidates.
// preludes: form-stdlib/source-compiler.fk
section [form.bml] {
 class FormBmlBooleanRepair {
  def fbr-token(t) = head(t);
  def fbr-at(ts,i) = i >= len(ts) ? "" : fbr-token(ts[i]);
  def fbr-quote(s,i,q) = i >= str_len(s) ? -1 : (Comparable) str_byte_at(s,i) == 92 ? fbr-quote(s,i + 2,q) : (Comparable) str_byte_at(s,i) == q ? (i + 1) : fbr-quote(s,i + 1,q);
  def fbr-lex(s,i,out) {
   let p = fsc-bml-skip-trivia(s,i,str_len(s));
   p >= str_len(s) ? list(1,reverse(out),"") : fsc-find-string-at?(s,"/*",p,0) ? list(0,list(),"block-comment-outside-repair-lane") : {
    let b = str_byte_at(s,p);
    let after = ((Comparable) b == 34) || ((Comparable) b == 39) ? fbr-quote(s,p + 1,b) : fsc-bml-token-after(s,p,str_len(s));
    after <= p ? list(0,list(),"unterminated-quoted-source") : fbr-lex(s,after,cons(list(substring(s,p,after),p,after),out));
   };
  }
  def fbr-op(t) = ((String) t == "and") || ((String) t == "or");
  def fbr-closer(t) = (String) t == "(" ? ")" : (String) t == "{" ? "}" : (String) t == "[" ? "]" : "";
  def fbr-closing(t) = ((String) t == ")") || (((String) t == "}") || ((String) t == "]"));
  def fbr-bad(reason) = list(0,0,list(),list(),reason);
  def fbr-good(next,inserts,edits) = list(1,next,inserts,edits,"");
  def fbr-repeat(text,n) = n <= 0 ? "" : text ++ fbr-repeat(text,n - 1);
  def fbr-prefixes(op,commas) = nil?(commas) ? list() : nil?(tail(commas)) ? list() : cons(list(head(commas),op ++ "("),fbr-prefixes(op,tail(commas)));
  def fbr-close(ts,i,op,start,hasValue,commas,inserts,edits) = (String) op == "" ? fbr-good(i + 1,inserts,edits) : !hasValue ? fbr-bad("empty-boolean-argument") : len(commas) < 2 ? fbr-good(i + 1,inserts,edits) : {
   let row = ts[i];
   let changes = append(fbr-prefixes(op,reverse(commas)),list(list(row[1],fbr-repeat(")",len(commas) - 1))));
   fbr-good(i + 1,append(inserts,changes),cons(list(op,start,row[2],len(commas) + 1),edits));
  };
  // The recursive result carries the next unread token and every insertion.
  // Stop tokens are validated before a candidate can be returned.
  def fbr-walk(ts,i,stop,active,op,start,depth,previous,hasValue,commas,inserts,edits) = depth > 128 ? fbr-bad("source-nesting-limit") : i >= len(ts) ? ((String) stop == "" ? fbr-good(i,inserts,edits) : fbr-bad("unclosed-source-group")) : {
   let token = fbr-at(ts,i);
   fbr-closing(token) ? ((String) token == stop ? fbr-close(ts,i,op,start,hasValue,commas,inserts,edits) : fbr-bad("mismatched-source-group")) : active && (((String) token == "do") && (!(((String) fbr-at(ts,i + 1) == "{") || ((String) fbr-at(ts,i + 1) == "(")))) ? fbr-bad("unbraced-do-outside-repair-lane") : active && (fbr-op(token) && (((String) previous == "def") || ((String) previous == "fn"))) ? fbr-bad("boolean-name-declaration") : ((Comparable) depth == 0) && ((String) token == "section") ? fbr-section(ts,i,stop,depth,commas,inserts,edits) : active && (fbr-op(token) && ((!(((String) previous == ".") || ((String) previous == "::"))) && ((String) fbr-at(ts,i + 1) == "("))) ? {
    let child = fbr-walk(ts,i + 2,")",active,token,ts[i][1],depth + 1,"",0,list(),inserts,edits);
    fbr-resume(child,ts,stop,active,op,start,depth,token,commas);
   } : !((String) fbr-closer(token) == "") ? {
    let child = fbr-walk(ts,i + 1,fbr-closer(token),active,"",0,depth + 1,"",0,list(),inserts,edits);
    fbr-resume(child,ts,stop,active,op,start,depth,token,commas);
   } : (String) token == "," ? ((!((String) op == "")) && (!hasValue) ? fbr-bad("empty-boolean-argument") : fbr-walk(ts,i + 1,stop,active,op,start,depth,token,0,cons(ts[i][2],commas),inserts,edits)) : fbr-walk(ts,i + 1,stop,active,op,start,depth,token,1,commas,inserts,edits);
  };
  def fbr-resume(child,ts,stop,active,op,start,depth,previous,commas) = !head(child) ? child : fbr-walk(ts,child[1],stop,active,op,start,depth,previous,1,commas,child[2],child[3]);
  def fbr-section(ts,i,stop,depth,commas,inserts,edits) = !(((String) fbr-at(ts,i + 1) == "[") && (((String) fbr-at(ts,i + 3) == "]") && ((String) fbr-at(ts,i + 4) == "{"))) ? fbr-bad("section-header-outside-repair-lane") : {
   let child = fbr-walk(ts,i + 5,"}",(String) fbr-at(ts,i + 2) == "form.bml","",0,depth + 1,"",0,list(),inserts,edits);
   fbr-resume(child,ts,stop,0,"",0,depth,"section",commas);
  };
  def fbr-insert(row,rows) = nil?(rows) ? list(row) : head(row) < head(head(rows)) ? cons(row,rows) : cons(head(rows),fbr-insert(row,tail(rows)));
  def fbr-sort(rows,out) = nil?(rows) ? out : fbr-sort(tail(rows),fbr-insert(head(rows),out));
  def fbr-apply(s,rows,at) = nil?(rows) ? substring(s,at,str_len(s)) : substring(s,at,head(head(rows))) ++ head(rows)[1] ++ fbr-apply(s,tail(rows),head(head(rows)));
  def fbr-repair(source) = !((String) value_kind(source) == "string") ? list(0,"",list(),"source-must-be-text") : str_len(source) > 262144 ? list(0,source,list(),"source-byte-limit") : {
   let lexed = fbr-lex(source,0,list());
   !head(lexed) ? list(0,source,list(),lexed[2]) : {
    let parsed = fbr-walk(lexed[1],0,"",0,"",0,0,"",0,list(),list(),list());
    !head(parsed) ? list(0,source,list(),parsed[4]) : list(1,fbr-apply(source,fbr-sort(parsed[2],list()),0),reverse(parsed[3]),nil?(parsed[3]) ? "unchanged" : "binary-boolean-calls-inserted;compile-and-behavior-checks-still-required");
   };
  };
 }
 0;
}
