//////////////////////////////////////////////////////////////////////
// bml-demand-jit-glass.bml -- gas/water/ice projection of one real JIT step.
// No source text or computed answer crosses the telemetry membrane.
//////////////////////////////////////////////////////////////////////

// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/term-graphics.bml form/form-stdlib/hearth.bml

section [form.bml] {
    class BmlDemandJitGlass [public, observable] {
        def BDJGRoot() = hearth-telemetry-root();
        field BDJGPublisher = "jit.bml-demand";
        field BDJGOwner = "jit.bml-demand";
        field BDJGSource = "bml-demand-jit";

        def bdjg-channels() = list("jit", "core", "framebuffer", "glass", "health", "control");
        def bdjg-sample(id, parent, kind, plane, purpose, bytes, capacity, lifecycle, epoch, evictability) = fgtm-sample(id, parent, kind, plane, BDJGOwner(), "cpu-jit", purpose, bytes, capacity, lifecycle, fgtm-present(epoch), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), evictability, "physical-live", BDJGSource(), bdjg-channels());
        def bdjg-stage(step) = bdj-step-stage(step);
        def bdjg-step-faulted?(step) = bdj-state-faulted?(bdj-step-state(step));
        def bdjg-stage-field(field) = (Comparable) bdj-field-present?(field) == 1 ? fgtm-present(bdj-field-value(field)) : fgtm-absent();
        def bdjg-stage-epoch-field(field) = (Comparable) bdj-field-present?(field) == 1 ? fgtm-present(bdj-field-value(field) * 1000) : fgtm-absent();
        def bdjg-request-sample(epoch, firstMs) = bdjg-sample("jit.bml-demand.request", fgtm-absent(), "event", "form", "first-answer-gas", fgtm-absent(), fgtm-present(firstMs), "released", epoch, "released");
        def bdjg-specialization-requested?(first) = (String) bdj-receipt-status(first) == "form-ready-specialization-pending";
        def bdjg-pending-lifecycle(step) = (Comparable) bdjg-step-faulted?(step) == 1 ? "failed" : (Comparable) bdj-step-installed(step) == 1 ? "released" : "ready";
        def bdjg-pending-sample(epoch, step) = bdjg-sample("jit.bml-demand.pending", fgtm-present("jit.bml-demand.request"), "recipe", "form", bdj-step-status(step), fgtm-absent(), fgtm-present(BDJMaxRows()), bdjg-pending-lifecycle(step), epoch, (Comparable) bdj-step-installed(step) == 1 ? "released" : "pressure-only");
        def bdjg-inspect-sample(epoch, step) = bdjg-sample("jit.bml-demand.inspect", fgtm-present("jit.bml-demand.pending"), "jit-stage", "disk", bdj-stage-cache-disposition(bdjg-stage(step)), fgtm-absent(), fgtm-present(bdj-stage-inspect-ms(bdjg-stage(step))), (Comparable) bdjg-step-faulted?(step) == 1 ? "failed" : "ready", epoch, "released");
        def bdjg-cache-age-purpose(step) = (Comparable) bdj-field-present?(bdj-stage-cache-age(bdjg-stage(step))) == 1 ? "cache-age-ms" : bdj-field-reason(bdj-stage-cache-age(bdjg-stage(step)));
        def bdjg-cache-age-lifecycle(step) = (Comparable) bdjg-step-faulted?(step) == 1 ? "failed" : (Comparable) bdj-field-present?(bdj-stage-cache-age(bdjg-stage(step))) == 1 ? "ready" : "released";
        // Reading happens at the snapshot epoch; the artifact's filesystem
        // mtime is its write epoch.  Keeping those directions exact lets the
        // common Glass r=/w= age columns distinguish recent inspection from
        // old disk ice without making either one an invented zero.
        def bdjg-cache-age-sample(epoch, step) = fgtm-sample("jit.bml-demand.cache-age", fgtm-present("jit.bml-demand.inspect"), "cache-age", "disk", BDJGOwner(), "cpu-jit", bdjg-cache-age-purpose(step), fgtm-absent(), bdjg-stage-field(bdj-stage-cache-age(bdjg-stage(step))), bdjg-cache-age-lifecycle(step), fgtm-present(epoch), bdjg-stage-epoch-field(bdj-stage-cache-mtime(bdjg-stage(step))), fgtm-absent(), fgtm-absent(), (Comparable) bdj-field-present?(bdj-stage-cache-age(bdjg-stage(step))) == 1 ? "policy-ranked" : "released", "physical-live", BDJGSource(), bdjg-channels());
        def bdjg-materialize-sample(epoch, step) = bdjg-sample("jit.bml-demand.materialize", fgtm-present("jit.bml-demand.inspect"), "jit-stage", "cpu", bdj-stage-materialize-action(bdjg-stage(step)), fgtm-absent(), fgtm-present(bdj-stage-materialize-ms(bdjg-stage(step))), (Comparable) bdjg-step-faulted?(step) == 1 ? "failed" : "ready", epoch, "pressure-only");
        def bdjg-disk-ready?(step) = (String) bdj-step-disk-action(step) == "published" ? 1 : (String) bdj-step-disk-action(step) == "reused-disk" ? 1 : 0;
        def bdjg-disk-lifecycle(step) = (Comparable) bdjg-disk-ready?(step) == 1 ? "ready" : (String) bdj-step-disk-action(step) == "withheld-source-missing" ? "released" : "failed";
        def bdjg-disk-sample(epoch, step, cacheBytes) = bdjg-sample("jit.bml-demand.disk", fgtm-present("jit.bml-demand.page"), "cache", "disk", bdj-step-disk-action(step), ((Comparable) bdjg-disk-ready?(step) == 1) && (!nothing?(cacheBytes)) ? fgtm-present(cacheBytes) : fgtm-absent(), fgtm-present(bdj-stage-publish-ms(bdjg-stage(step))), bdjg-disk-lifecycle(step), epoch, "policy-ranked");
        def bdjg-cache-only?(step) = ((String) bdj-stage-materialize-action(bdjg-stage(step)) == "retained-image") || ((String) bdj-step-status(step) == "cache-care-waiting");
        def bdjg-page-lifecycle(step) = bdjg-cache-only?(step) ? "released" : (Comparable) bdj-step-installed(step) == 1 ? "resident" : "failed";
        def bdjg-page-sample(epoch, step) = bdjg-sample("jit.bml-demand.page", fgtm-present("jit.bml-demand.materialize"), "cell", "cpu", bdjg-cache-only?(step) ? "not-observed" : "install-challenge-ms", fgtm-absent(), bdjg-cache-only?(step) ? fgtm-absent() : fgtm-present(bdj-stage-install-challenge-ms(bdjg-stage(step))), bdjg-page-lifecycle(step), epoch, "pressure-only");
        def bdjg-total-sample(epoch, step) = bdjg-sample("jit.bml-demand.total", fgtm-present("jit.bml-demand.disk"), "jit-stage", "form", bdj-step-status(step), fgtm-absent(), fgtm-present(bdj-stage-total-ms(bdjg-stage(step))), (Comparable) bdjg-step-faulted?(step) == 1 ? "failed" : "ready", epoch, "released");
        def bdjg-attention-purpose(step) = (String) bdj-step-attention(step) == "immediate" ? "immediate-fault-attention" : (String) bdj-step-attention(step) == "over" ? "over-5s-close-attention" : "within-5s";
        def bdjg-attention-sample(epoch, step) = bdjg-sample("jit.bml-demand.unattributed", fgtm-present("jit.bml-demand.total"), "jit-stage", "form", bdjg-attention-purpose(step), fgtm-absent(), fgtm-present(bdj-stage-unattributed-ms(bdjg-stage(step))), (Comparable) bdjg-step-faulted?(step) == 1 ? "failed" : "ready", epoch, "released");
        def bdjg-frontier-sample(epoch, step) = fgtm-sample("jit.bml-demand.frontier.full-program-call", fgtm-present("jit.bml-demand.unattributed"), bdj-stage-full-call-state(bdjg-stage(step)), "membrane", BDJGOwner(), "cpu-jit", bdj-stage-full-call-door(bdjg-stage(step)), fgtm-absent(), fgtm-absent(), "released", fgtm-present(epoch), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "released", "declared", BDJGSource(), bdjg-channels());
        def bdjg-fault-sample(step) {
            let fault = bdj-state-fault(bdj-step-state(step));
            fgtm-sample(bdj-fault-key(fault), fgtm-present("jit.bml-demand.total"), "diagnostic-control", "form", bdj-fault-publisher(fault), "cpu-jit", bdj-fault-cause(fault), fgtm-absent(), fgtm-present(bdj-fault-priority(fault)), "failed", fgtm-present(bdj-fault-observed(fault)), fgtm-present(bdj-fault-observed(fault)), fgtm-present(bdj-fault-priority(fault)), fgtm-absent(), "never", "physical-live", BDJGSource(), bdjg-channels());
        }
        def bdjg-healed?(step) {
            bdj-healed?(bdj-state-last-control(bdj-step-state(step)));
        }
        def bdjg-healed-sample(step) {
            let healed = bdj-state-last-control(bdj-step-state(step));
            fgtm-sample("jit.bml-demand.healed", fgtm-present(bdj-healed-fault-key(healed)), "jit-healed", "form", bdj-healed-publisher(healed), "cpu-jit", bdj-healed-cause(healed), fgtm-absent(), fgtm-present(bdj-healed-priority(healed)), "ready", fgtm-present(bdj-healed-snapshot-epoch(healed)), fgtm-present(bdj-healed-observed(healed)), fgtm-present(bdj-healed-priority(healed)), fgtm-absent(), "released", "physical-live", bdj-healed-evidence(healed), bdjg-channels());
        }
        def bdjg-care-sample(care) {
            let fault = bdj-care-fault(care);
            fgtm-sample(bdj-fault-key(fault), fgtm-present("jit.bml-demand.disk"), "cache-care", "disk", bdj-fault-publisher(fault), "cpu-jit", bdj-fault-cause(fault), fgtm-absent(), fgtm-absent(), "failed", fgtm-present(bdj-fault-observed(fault)), fgtm-present(json-int-value(oh-get(bdj-care-observation(care), "at_ms"))), fgtm-absent(), fgtm-absent(), "never", "physical-live", BDJGSource(), bdjg-channels());
        }
        def bdjg-care-samples(cares) = (Comparable) len(cares) == 0 ? list() : cons(bdjg-care-sample(head(cares)), bdjg-care-samples(tail(cares)));
        def bdjg-cache-repaired-samples(step) {
            let healed = bdj-state-cache-healed(bdj-step-state(step));
            nothing?(healed) ? list() : list(fgtm-sample("jit.bml-demand.cache-repaired", fgtm-present(bdj-healed-fault-key(healed)), "cache-repaired", "disk", bdj-healed-publisher(healed), "cpu-jit", bdj-healed-cause(healed), fgtm-absent(), fgtm-absent(), "ready", fgtm-present(bdj-healed-snapshot-epoch(healed)), fgtm-present(bdj-healed-observed(healed)), fgtm-absent(), fgtm-absent(), "released", "physical-live", BDJGSource(), bdjg-channels()));
        }
        def bdjg-base-samples(epoch, firstMs, step, cacheBytes) = list(bdjg-request-sample(epoch, firstMs), bdjg-pending-sample(epoch, step), bdjg-inspect-sample(epoch, step), bdjg-cache-age-sample(epoch, step), bdjg-materialize-sample(epoch, step), bdjg-page-sample(epoch, step), bdjg-disk-sample(epoch, step, cacheBytes), bdjg-total-sample(epoch, step), bdjg-attention-sample(epoch, step), bdjg-frontier-sample(epoch, step));
        def bdjg-control-samples(step) = append(append((Comparable) bdj-state-faulted?(bdj-step-state(step)) == 1 ? list(bdjg-fault-sample(step)) : list(), (Comparable) bdjg-healed?(step) == 1 ? list(bdjg-healed-sample(step)) : list()), append(bdjg-care-samples(bdj-state-care(bdj-step-state(step))), bdjg-cache-repaired-samples(step)));
        def bdjg-samples(epoch, firstMs, first, step, cacheBytes) = append((Comparable) bdjg-specialization-requested?(first) == 1 ? bdjg-base-samples(epoch, firstMs, step, cacheBytes) : list(bdjg-request-sample(epoch, firstMs)), bdjg-control-samples(step));
        def bdjg-publish-at(root, publisher, epoch, firstMs, first, step, cacheBytes) = fgtm-publish-snapshot(root, publisher, epoch, bdjg-samples(epoch, firstMs, first, step, cacheBytes));
        def bdjg-publish(epoch, firstMs, first, step, cacheBytes) = bdjg-publish-at(BDJGRoot(), BDJGPublisher(), epoch, firstMs, first, step, cacheBytes);
        def bdjg-scoped-id(scope, id) = scope ++ substring(id, 14, str_len(id));
        def bdjg-scoped-parent(scope, parent) = (Comparable) fgtm-field-present?(parent) == 0 ? fgtm-absent() : fgtm-present(bdjg-scoped-id(scope, fgtm-field-value(parent)));
        def bdjg-scoped-sample(scope, sample) = fgtm-carry-cell(sample, bdjg-scoped-sample-fields(scope, sample));
        def bdjg-scoped-sample-fields(scope, sample) = fgtm-sample(bdjg-scoped-id(scope, fgtm-sample-id(sample)), bdjg-scoped-parent(scope, fgtm-sample-parent(sample)), fgtm-sample-kind(sample), fgtm-sample-plane(sample), fgtm-sample-owner(sample), fgtm-sample-lane(sample), fgtm-sample-purpose(sample), fgtm-sample-bytes(sample), fgtm-sample-capacity(sample), fgtm-sample-lifecycle(sample), fgtm-sample-read-epoch(sample), fgtm-sample-write-epoch(sample), fgtm-sample-heat(sample), fgtm-sample-handle(sample), fgtm-sample-evictability(sample), fgtm-sample-evidence(sample), fgtm-sample-source(sample), fgtm-sample-channels(sample));
        def bdjg-scoped-samples(scope, samples) = (Comparable) len(samples) == 0 ? list() : cons(bdjg-scoped-sample(scope, head(samples)), bdjg-scoped-samples(scope, tail(samples)));
        // Comparison prefixes are display scope, never control identity. The
        // newest control-bearing step contributes its exact unmodified fault or
        // heal row so Glass's stop-the-line consumer and producer share one key.
        def bdjg-comparison-controls(step, reuseStep) {
            let reuseControls = bdjg-control-samples(reuseStep);
            len(reuseControls) > 0 ? reuseControls : bdjg-control-samples(step);
        }
        def bdjg-comparison-samples(epoch, firstMs, first, step, buildBytes, reuseFirstMs, reuseFirst, reuseStep, reuseBytes) = append(bdjg-scoped-samples("jit.bml-demand.first", bdjg-base-samples(epoch, firstMs, step, buildBytes)), append(bdjg-scoped-samples("jit.bml-demand.reuse", bdjg-base-samples(epoch, reuseFirstMs, reuseStep, reuseBytes)), bdjg-comparison-controls(step, reuseStep)));
        def bdjg-publish-comparison-at(root, publisher, epoch, firstMs, first, step, buildBytes, reuseFirstMs, reuseFirst, reuseStep, reuseBytes) = fgtm-publish-snapshot(root, publisher, epoch, bdjg-comparison-samples(epoch, firstMs, first, step, buildBytes, reuseFirstMs, reuseFirst, reuseStep, reuseBytes));
        def bdjg-publish-comparison(epoch, firstMs, first, step, buildBytes, reuseFirstMs, reuseFirst, reuseStep, reuseBytes) = bdjg-publish-comparison-at(BDJGRoot(), BDJGPublisher(), epoch, firstMs, first, step, buildBytes, reuseFirstMs, reuseFirst, reuseStep, reuseBytes);
        def bdjg-publish-status(result) = len(result) < 2 ? "malformed" : result[1];

        // A bounded Glass projection of the same snapshot.  It is deliberately
        // separate from the global Atlas layout so this organ does not invent
        // renderer state or compete for its row budget.
        def bdjg-find-sample(samples, id) = (Comparable) len(samples) == 0 ? nothing() : (String) fgtm-sample-id(head(samples)) == id ? head(samples) : bdjg-find-sample(tail(samples), id);
        def bdjg-find-kind(samples, kind) = (Comparable) len(samples) == 0 ? nothing() : (String) fgtm-sample-kind(head(samples)) == kind ? head(samples) : bdjg-find-kind(tail(samples), kind);
        def bdjg-find-kind-prefix(samples, kind, prefix) = (Comparable) len(samples) == 0 ? nothing() : ((String) fgtm-sample-kind(head(samples)) == kind) && ((Comparable) str_find(fgtm-sample-id(head(samples)), prefix, 0) == 0) ? head(samples) : bdjg-find-kind-prefix(tail(samples), kind, prefix);
        def bdjg-duration-field(field) = (Comparable) fgtm-field-present?(field) == 0 ? "absent" : (Comparable) fgtm-field-value(field) == 0 ? "<1ms" : tg-dur(fgtm-field-value(field));
        def bdjg-bytes-field(field) = (Comparable) fgtm-field-present?(field) == 1 ? int_to_str(fgtm-field-value(field)) ++ "B" : "absent";
        def bdjg-snapshot-age(nowMs, snapshot) = nowMs < fgtm-snapshot-epoch(snapshot) ? 0 : (nowMs - fgtm-snapshot-epoch(snapshot));
        def bdjg-stage-value(sample) = nothing?(sample) ? "sample-absent" : fgtm-sample-purpose(sample) ++ "  dt=" ++ bdjg-duration-field(fgtm-sample-capacity(sample));
        def bdjg-stage-lane(label, sample, age) = nothing?(sample) ? tg-lane(label, "sample-absent", "warn", age) : tg-lane(label, bdjg-stage-value(sample), (String) fgtm-sample-lifecycle(sample) == "failed" ? "bad" : "good", age);
        def bdjg-cache-lane(label, sample, age) = nothing?(sample) ? tg-lane(label, "sample-absent", "warn", age) : tg-lane(label, fgtm-sample-purpose(sample) ++ "  age=" ++ bdjg-duration-field(fgtm-sample-capacity(sample)), (String) fgtm-sample-lifecycle(sample) == "failed" ? "bad" : (Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1 ? "good" : "warn", age);
        def bdjg-disk-lane(label, sample, age) = nothing?(sample) ? tg-lane(label, "sample-absent", "warn", age) : tg-lane(label, fgtm-sample-purpose(sample) ++ "  bytes=" ++ bdjg-bytes-field(fgtm-sample-bytes(sample)) ++ " dt=" ++ bdjg-duration-field(fgtm-sample-capacity(sample)), (String) fgtm-sample-lifecycle(sample) == "ready" ? "good" : "bad", age);
        def bdjg-door-lane(label, sample, age) = nothing?(sample) ? tg-lane(label, "sample-absent", "warn", age) : tg-lane(label, fgtm-sample-purpose(sample) ++ "  " ++ fgtm-sample-kind(sample), "warn", age);
        def bdjg-control-sample?(sample, kind) = !((String) fgtm-sample-kind(sample) == kind) ? 0 : !((String) fgtm-sample-owner(sample) == BDJGPublisher()) ? 0 : !((String) fgtm-sample-source(sample) == BDJGSource()) ? 0 : !((String) fgtm-sample-evidence(sample) == "physical-live") ? 0 : 1;
        def bdjg-find-control(samples, kind) = (Comparable) len(samples) == 0 ? nothing() : (Comparable) bdjg-control-sample?(head(samples), kind) == 1 ? head(samples) : bdjg-find-control(tail(samples), kind);
        def bdjg-control-lanes(samples, age) {
            let fault = bdjg-find-control(samples, "diagnostic-control");
            let healed = bdjg-find-control(samples, "jit-healed");
            append(append(nothing?(fault) ? list() : list(tg-lane("live  !! FAULT     ", "HEALING   " ++ fgtm-sample-purpose(fault) ++ " priority=" ++ int_to_str(fgtm-field-value(fgtm-sample-heat(fault))), "bad", age)), nothing?(healed) ? list() : list(tg-lane("live  + HEALED    ", fgtm-sample-purpose(healed) ++ " priority=" ++ int_to_str(fgtm-field-value(fgtm-sample-heat(healed))), "good", age))), bdjg-cache-care-lanes(samples, age));
        }
        def bdjg-cache-care-lanes(samples, age) = (Comparable) len(samples) == 0 ? list() : append(bdjg-control-sample?(head(samples), "cache-care") ? list(tg-lane("live  ~ CACHE CARE ", fgtm-sample-purpose(head(samples)), "warn", age)) : bdjg-control-sample?(head(samples), "cache-repaired") ? list(tg-lane("live  + CACHE READY", fgtm-sample-purpose(head(samples)), "good", age)) : list(), bdjg-cache-care-lanes(tail(samples), age));
        def bdjg-scope-lanes(scope, samples, age) = list(
            bdjg-stage-lane(scope ++ " I inspect      ", bdjg-find-sample(samples, "jit.bml-demand." ++ scope ++ ".inspect"), age),
            bdjg-cache-lane(scope ++ " A artifact     ", bdjg-find-sample(samples, "jit.bml-demand." ++ scope ++ ".cache-age"), age),
            bdjg-stage-lane(scope ++ " C materialize  ", bdjg-find-sample(samples, "jit.bml-demand." ++ scope ++ ".materialize"), age),
            bdjg-stage-lane(scope ++ " R install/test ", bdjg-find-sample(samples, "jit.bml-demand." ++ scope ++ ".page"), age),
            bdjg-disk-lane(scope ++ " P disk         ", bdjg-find-sample(samples, "jit.bml-demand." ++ scope ++ ".disk"), age),
            bdjg-stage-lane(scope ++ " T total        ", bdjg-find-sample(samples, "jit.bml-demand." ++ scope ++ ".total"), age),
            bdjg-stage-lane(scope ++ " U unattributed ", bdjg-find-sample(samples, "jit.bml-demand." ++ scope ++ ".unattributed"), age),
            bdjg-door-lane(scope ++ " ! frontier     ", bdjg-find-sample(samples, "jit.bml-demand." ++ scope ++ ".frontier.full-program-call"), age));
        def bdjg-live-lanes(samples, age) = list(
            bdjg-stage-lane("live  I inspect      ", bdjg-find-sample(samples, "jit.bml-demand.inspect"), age),
            bdjg-cache-lane("live  A artifact     ", bdjg-find-sample(samples, "jit.bml-demand.cache-age"), age),
            bdjg-stage-lane("live  C materialize  ", bdjg-find-sample(samples, "jit.bml-demand.materialize"), age),
            bdjg-stage-lane("live  R install/test ", bdjg-find-sample(samples, "jit.bml-demand.page"), age),
            bdjg-disk-lane("live  P disk         ", bdjg-find-sample(samples, "jit.bml-demand.disk"), age),
            bdjg-stage-lane("live  T total        ", bdjg-find-sample(samples, "jit.bml-demand.total"), age),
            bdjg-stage-lane("live  U unattributed ", bdjg-find-sample(samples, "jit.bml-demand.unattributed"), age),
            bdjg-door-lane("live  ! frontier     ", bdjg-find-sample(samples, "jit.bml-demand.frontier.full-program-call"), age));
        def bdjg-stage-lanes(samples, age) = nothing?(bdjg-find-sample(samples, "jit.bml-demand.first.request")) ? bdjg-live-lanes(samples, age) : append(bdjg-scope-lanes("first", samples, age), bdjg-scope-lanes("reuse", samples, age));
        def bdjg-render-snapshot(nowMs, snapshot) {
            let samples = fgtm-snapshot-samples(snapshot);
            let age = bdjg-snapshot-age(nowMs, snapshot);
            tg-frame(append(list(tg-lane("FORM GLASS JIT  ", "publisher=" ++ fgtm-snapshot-publisher(snapshot) ++ " nodes=" ++ int_to_str(len(samples)), "plain", age)), append(bdjg-control-lanes(samples, age), bdjg-stage-lanes(samples, age))));
        }
        def bdjg-render-reading(nowMs, reading) = (String) fgtm-read-state-status(reading) == "current" ? bdjg-render-snapshot(nowMs, fgtm-field-value(fgtm-read-state-value(reading))) : tg-frame(list(tg-lane("FORM GLASS JIT  ", "snapshot=" ++ fgtm-read-state-status(reading), "warn", -1)));
        def bdjg-render-current() = bdjg-render-reading(now_unix_ms(), fgtm-read-current(BDJGRoot(), BDJGPublisher()));
    }
    0;
}
