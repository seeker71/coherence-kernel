//////////////////////////////////////////////////////////////////////
//
// zvec-grep.bml — zg retrieval over values already resident in Form.
//
// Upstream retrieval shape:
//   https://github.com/zvec-ai/zvec-grep
//   observed commit 81a80f478f2d3ec76556cd3c993d0d064cc9580a
//   Apache-2.0
//
// zg unifies exact grep, BM25, vector recall, and reciprocal-rank fusion.
// This organ carries that shape into the form-cli process. Its corpus is a
// list of Form values supplied by the caller; it does not discover paths,
// read files, open a store, invoke a process, or reach a network. BM25 is
// computed here, rag-embed/rag-retrieve supply the semantic vector, and RRF
// retains upstream's k=60.
//
// A memory document is (node-id source-lens text). A hit keeps both identity
// and source lens, but every byte used for scoring and evidence comes from the
// held text value. The form-cli binds its resident tool catalog to this organ
// in form-cli.fk.
//
// Honest floor: bounded query-time indexing over the resident rows offered by
// the caller. There is no host workspace scan, persistent zvec index,
// tree-sitter entity extraction, regex engine, watcher, daemon, shell face,
// external runner, model download, or remote embedding.
//
// preludes: form-stdlib/core.fk form-stdlib/rag-embed.fk form-stdlib/rag-retrieve.fk
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormNativeZvecGrep {
        field ZgSchema = "form-native-zvec-grep-v2";
        field ZgUpstream = "https://github.com/zvec-ai/zvec-grep";
        field ZgUpstreamCommit = "81a80f478f2d3ec76556cd3c993d0d064cc9580a";
        field ZgLicense = "Apache-2.0";

        field ZgRouteRg = "rg";
        field ZgRouteFts = "fts";
        field ZgRouteVector = "vector";
        field ZgRouteHybrid = "hybrid";
        field ZgMatchedBoth = "fts+vector";

        field ZgStatusHit = "hit";
        field ZgStatusMiss = "miss";
        field ZgStatusNothing = "nothing";
        field ZgResident = "resident";

        field ZgDefaultLimit = 7;
        field ZgMaxLimit = 50;
        field ZgMaxQueryBytes = 512;
        field ZgMaxDocumentBytes = 65536;
        field ZgExcerptBefore = 128;
        field ZgExcerptLimit = 768;
        field ZgRrfK = 60;
        field ZgRecallFloor = 50;
        field ZgRecallCeiling = 200;

        thought zg-pattern = list("resident-form-values", "rg+bm25+vector", "rrf-k60", "nodeid-source-lens", "zero-membrane-crossings");

        def zg-min(a, b) = a < b ? a : b;
        def zg-max(a, b) = a > b ? a : b;
        def zg-float(n) = n + 0.0;
        def zg-half() = str_to_float("0.5");
        def zg-bm25-k1() = str_to_float("1.2");
        def zg-bm25-b() = str_to_float("0.75");
        def zg-reverse-go(xs, out) = nil?(xs) ? out : zg-reverse-go(tail(xs), cons(head(xs), out));
        def zg-reverse(xs) = zg-reverse-go(xs, list());

        def zg-lower-byte(b) = (b >= 65) && (b <= 90) ? (b + 32) : b;
        def zg-ci-at?(hay, needle, h, n) = n >= str_len(needle) ? 1 : h >= str_len(hay) ? 0 : !((Comparable) zg-lower-byte(str_byte_at(hay, h)) == zg-lower-byte(str_byte_at(needle, n))) ? 0 : zg-ci-at?(hay, needle, h + 1, n + 1);
        def zg-find-ci-go(hay, needle, at) = (at + str_len(needle)) > str_len(hay) ? -1 : (Comparable) zg-ci-at?(hay, needle, at, 0) == 1 ? at : zg-find-ci-go(hay, needle, at + 1);
        def zg-find-ci(hay, needle) = (Comparable) str_len(needle) == 0 ? 0 : zg-find-ci-go(hay, needle, 0);
        def zg-str-less-go(a, b, at, stop) = at >= stop ? (str_len(a) < str_len(b) ? 1 : 0) : str_byte_at(a, at) < str_byte_at(b, at) ? 1 : str_byte_at(a, at) > str_byte_at(b, at) ? 0 : zg-str-less-go(a, b, at + 1, stop);
        def zg-str-less?(a, b) = zg-str-less-go(a, b, 0, zg-min(str_len(a), str_len(b)));

        def zg-string-in?(value, rows) = nil?(rows) ? 0 : (String) value == head(rows) ? 1 : zg-string-in?(value, tail(rows));
        def zg-unique-go(words, seen) = nil?(words) ? zg-reverse(seen) : (Comparable) zg-string-in?(head(words), seen) == 1 ? zg-unique-go(tail(words), seen) : zg-unique-go(tail(words), cons(head(words), seen));
        def zg-unique-words(text) = zg-unique-go(re-words(text), list());
        def zg-count-word(word, words) = nil?(words) ? 0 : (((String) word == head(words) ? 1 : 0) + zg-count-word(word, tail(words)));
        def zg-term-frequencies(terms, words) = terms |> map(term => zg-count-word(term, words));
        def zg-df-add(dfs, tfs) = nil?(dfs) ? list() : cons(head(dfs) + (head(tfs) > 0 ? 1 : 0), zg-df-add(tail(dfs), tail(tfs)));
        def zg-zeros(n) = n <= 0 ? list() : cons(0, zg-zeros(n - 1));

        def zg-mode-valid?(mode) = (String) mode == ZgRouteRg() ? 1 : (String) mode == ZgRouteFts() ? 1 : (String) mode == ZgRouteVector() ? 1 : (String) mode == ZgRouteHybrid() ? 1 : 0;
        def zg-needs-fts?(mode) = (String) mode == ZgRouteFts() ? 1 : (String) mode == ZgRouteHybrid() ? 1 : 0;
        def zg-needs-vector?(mode) = (String) mode == ZgRouteVector() ? 1 : (String) mode == ZgRouteHybrid() ? 1 : 0;
        def zg-query-valid?(query) = (Comparable) str_len(query) == 0 ? 0 : str_len(query) > ZgMaxQueryBytes() ? 0 : 1;
        def zg-limit(limit) = limit <= 0 ? ZgDefaultLimit() : zg-min(limit, ZgMaxLimit());

        // Memory document = stable node identity, source lens, held text.
        def zg-memory-doc(nodeId, lens, text) = list(nodeId, lens, text);
        def zg-memory-doc-node(doc) = doc[0];
        def zg-memory-doc-lens(doc) = doc[1];
        def zg-memory-doc-text(doc) = doc[2];
        def zg-memory-doc-valid?(doc) = !((Comparable) len(doc) == 3) ? 0 : (Comparable) str_len(zg-memory-doc-node(doc)) == 0 ? 0 : (Comparable) str_len(zg-memory-doc-lens(doc)) == 0 ? 0 : str_len(zg-memory-doc-text(doc)) > ZgMaxDocumentBytes() ? 0 : 1;

        // Indexed document = memory document, word count, query-term
        // frequencies, exact offset, first lexical offset, vector overlap.
        def zg-doc(memory, wordCount, termFreqs, exactOffset, evidenceOffset, vectorScore) = list(memory, wordCount, termFreqs, exactOffset, evidenceOffset, vectorScore);
        def zg-doc-memory(doc) = doc[0];
        def zg-doc-node(doc) = zg-memory-doc-node(zg-doc-memory(doc));
        def zg-doc-lens(doc) = zg-memory-doc-lens(zg-doc-memory(doc));
        def zg-doc-text(doc) = zg-memory-doc-text(zg-doc-memory(doc));
        def zg-doc-word-count(doc) = doc[1];
        def zg-doc-term-freqs(doc) = doc[2];
        def zg-doc-exact-offset(doc) = doc[3];
        def zg-doc-evidence-offset(doc) = doc[4];
        def zg-doc-vector-score(doc) = doc[5];

        def zg-first-offset-step(text, terms, best) {
            let found = zg-find-ci(text, head(terms));
            let next = found < 0 ? best : best < 0 ? found : zg-min(best, found);
            zg-first-offset-go(text, tail(terms), next);
        }
        def zg-first-offset-go(text, terms, best) = nil?(terms) ? best : zg-first-offset-step(text, terms, best);
        def zg-first-offset(text, query, terms) {
            let exact = zg-find-ci(text, query);
            exact >= 0 ? exact : zg-first-offset-go(text, terms, -1);
        }

        // Scan = indexed documents, per-term document frequencies, total
        // words, offered rows, admitted rows, skipped malformed/oversize rows.
        def zg-scan(docs, dfs, totalWords, offered, admitted, skipped) = list(docs, dfs, totalWords, offered, admitted, skipped);
        def zg-scan-docs(scan) = scan[0];
        def zg-scan-dfs(scan) = scan[1];
        def zg-scan-total-words(scan) = scan[2];
        def zg-scan-offered(scan) = scan[3];
        def zg-scan-admitted(scan) = scan[4];
        def zg-scan-skipped(scan) = scan[5];

        def zg-index-memory(route, memory, query, terms, queryVec) {
            let text = zg-memory-doc-text(memory);
            let words = (Comparable) zg-needs-fts?(route) == 1 ? re-words(text) : list();
            let tfs = (Comparable) zg-needs-fts?(route) == 1 ? zg-term-frequencies(terms, words) : zg-zeros(len(terms));
            let exact = zg-find-ci(text, query);
            let evidence = zg-first-offset(text, query, terms);
            let vectorScore = (Comparable) zg-needs-vector?(route) == 1 ? rag-overlap-score(queryVec, rag-entry(zg-memory-doc-node(memory), re-semantic-vec(text))) : 0;
            zg-doc(memory, len(words), tfs, exact, evidence, vectorScore);
        }
        def zg-scan-row(route, rows, query, terms, queryVec, docs, dfs, totalWords, offered, admitted, skipped) {
            let memory = head(rows);
            (Comparable) zg-memory-doc-valid?(memory) == 0 ? zg-scan-rows(route, tail(rows), query, terms, queryVec, docs, dfs, totalWords, offered + 1, admitted, skipped + 1) : zg-scan-admit(route, tail(rows), memory, query, terms, queryVec, docs, dfs, totalWords, offered, admitted, skipped);
        }
        def zg-scan-admit(route, restRows, memory, query, terms, queryVec, docs, dfs, totalWords, offered, admitted, skipped) {
            let doc = zg-index-memory(route, memory, query, terms, queryVec);
            zg-scan-rows(route, restRows, query, terms, queryVec, cons(doc, docs), zg-df-add(dfs, zg-doc-term-freqs(doc)), totalWords + zg-doc-word-count(doc), offered + 1, admitted + 1, skipped);
        }
        def zg-scan-rows(route, rows, query, terms, queryVec, docs, dfs, totalWords, offered, admitted, skipped) = nil?(rows) ? zg-scan(zg-reverse(docs), dfs, totalWords, offered, admitted, skipped) : zg-scan-row(route, rows, query, terms, queryVec, docs, dfs, totalWords, offered, admitted, skipped);
        def zg-scan-memory(memories, route, query, terms) {
            let queryVec = (Comparable) zg-needs-vector?(route) == 1 ? re-semantic-vec(query) : list();
            zg-scan-rows(route, memories, query, terms, queryVec, list(), zg-zeros(len(terms)), 0, 0, 0, 0);
        }

        def zg-bm25-idf(docCount, df) = math_log(zg-float(1) + (((zg-float(docCount) - zg-float(df)) + zg-half()) / (zg-float(df) + zg-half())));
        def zg-bm25-positive(tf, df, docCount, docLength, averageLength) {
            let tfFloat = zg-float(tf);
            let lengthNorm = (zg-float(1) - zg-bm25-b()) + (zg-bm25-b() * (zg-float(docLength) / averageLength));
            let numerator = tfFloat * (zg-bm25-k1() + zg-float(1));
            let denominator = tfFloat + (zg-bm25-k1() * lengthNorm);
            zg-bm25-idf(docCount, df) * (numerator / denominator);
        }
        def zg-bm25-term(tf, df, docCount, docLength, averageLength) = tf <= 0 ? zg-float(0) : zg-bm25-positive(tf, df, docCount, docLength, averageLength);
        def zg-bm25-sum(tfs, dfs, docCount, docLength, averageLength, score) = nil?(tfs) ? score : zg-bm25-sum(tail(tfs), tail(dfs), docCount, docLength, averageLength, score + zg-bm25-term(head(tfs), head(dfs), docCount, docLength, averageLength));
        def zg-bm25-ready(doc, scan, docCount) {
            let averageLength = zg-float(zg-scan-total-words(scan)) / zg-float(docCount);
            zg-bm25-sum(zg-doc-term-freqs(doc), zg-scan-dfs(scan), docCount, zg-doc-word-count(doc), averageLength, zg-float(0));
        }
        def zg-bm25(doc, scan) {
            let docCount = len(zg-scan-docs(scan));
            (docCount <= 0) || (zg-scan-total-words(scan) <= 0) ? zg-float(0) : zg-bm25-ready(doc, scan, docCount);
        }

        // Candidate = indexed document, score, matched-by, fts rank, vector rank.
        def zg-candidate(doc, score, matchedBy, ftsRank, vectorRank) = list(doc, score, matchedBy, ftsRank, vectorRank);
        def zg-candidate-doc(candidate) = candidate[0];
        def zg-candidate-score(candidate) = candidate[1];
        def zg-candidate-matched-by(candidate) = candidate[2];
        def zg-candidate-fts-rank(candidate) = candidate[3];
        def zg-candidate-vector-rank(candidate) = candidate[4];
        def zg-candidate-node(candidate) = zg-doc-node(zg-candidate-doc(candidate));

        def zg-route-score(doc, route, scan) = (String) route == ZgRouteRg() ? (zg-doc-exact-offset(doc) >= 0 ? zg-float(1) : zg-float(0)) : (String) route == ZgRouteFts() ? zg-bm25(doc, scan) : (String) route == ZgRouteVector() ? zg-float(zg-doc-vector-score(doc)) : zg-float(0);
        def zg-candidates-row(rows, route, scan) {
            let score = zg-route-score(head(rows), route, scan);
            let rest = zg-candidates(tail(rows), route, scan);
            score > zg-float(0) ? cons(zg-candidate(head(rows), score, route, 0, 0), rest) : rest;
        }
        def zg-candidates(rows, route, scan) = nil?(rows) ? list() : zg-candidates-row(rows, route, scan);
        def zg-candidate-better?(candidate, best) = zg-candidate-score(candidate) > zg-candidate-score(best) ? 1 : zg-candidate-score(candidate) < zg-candidate-score(best) ? 0 : zg-str-less?(zg-candidate-node(candidate), zg-candidate-node(best));
        def zg-best-candidate(rows, best) = nil?(rows) ? best : (Comparable) len(best) == 0 ? zg-best-candidate(tail(rows), head(rows)) : (Comparable) zg-candidate-better?(head(rows), best) == 1 ? zg-best-candidate(tail(rows), head(rows)) : zg-best-candidate(tail(rows), best);
        def zg-remove-candidate(nodeId, rows) = nil?(rows) ? list() : (String) nodeId == zg-candidate-node(head(rows)) ? tail(rows) : cons(head(rows), zg-remove-candidate(nodeId, tail(rows)));
        def zg-top-step(rows, limit, out) {
            let best = zg-best-candidate(rows, list());
            zg-top-go(zg-remove-candidate(zg-candidate-node(best), rows), limit - 1, cons(best, out));
        }
        def zg-top-go(rows, limit, out) = (limit <= 0) || nil?(rows) ? zg-reverse(out) : zg-top-step(rows, limit, out);
        def zg-top(rows, limit) = zg-top-go(rows, limit, list());

        def zg-rank-of(nodeId, rows, rank) = nil?(rows) ? 0 : (String) nodeId == zg-candidate-node(head(rows)) ? rank : zg-rank-of(nodeId, tail(rows), rank + 1);
        def zg-doc-in?(nodeId, docs) = nil?(docs) ? 0 : (String) nodeId == zg-doc-node(head(docs)) ? 1 : zg-doc-in?(nodeId, tail(docs));
        def zg-union-docs(rows, docs) = nil?(rows) ? docs : (Comparable) zg-doc-in?(zg-candidate-node(head(rows)), docs) == 1 ? zg-union-docs(tail(rows), docs) : zg-union-docs(tail(rows), cons(zg-candidate-doc(head(rows)), docs));
        def zg-rrf-part(rank) = rank <= 0 ? zg-float(0) : (zg-float(1000000) / zg-float(ZgRrfK() + rank));
        def zg-hybrid-candidate-row(docs, ftsRows, vectorRows) {
            let nodeId = zg-doc-node(head(docs));
            let ftsRank = zg-rank-of(nodeId, ftsRows, 1);
            let vectorRank = zg-rank-of(nodeId, vectorRows, 1);
            let score = zg-rrf-part(ftsRank) + zg-rrf-part(vectorRank);
            let matched = (ftsRank > 0) && (vectorRank > 0) ? ZgMatchedBoth() : ftsRank > 0 ? ZgRouteFts() : ZgRouteVector();
            cons(zg-candidate(head(docs), score, matched, ftsRank, vectorRank), zg-hybrid-candidates(tail(docs), ftsRows, vectorRows));
        }
        def zg-hybrid-candidates(docs, ftsRows, vectorRows) = nil?(docs) ? list() : zg-hybrid-candidate-row(docs, ftsRows, vectorRows);
        def zg-recall-depth(limit) = zg-min(ZgRecallCeiling(), zg-max(ZgRecallFloor(), limit * 5));
        def zg-ranked-hybrid(scan, limit) {
            let docs = zg-scan-docs(scan);
            let depth = zg-recall-depth(limit);
            let ftsRows = zg-top(zg-candidates(docs, ZgRouteFts(), scan), depth);
            let vectorRows = zg-top(zg-candidates(docs, ZgRouteVector(), scan), depth);
            let union = zg-union-docs(vectorRows, zg-union-docs(ftsRows, list()));
            zg-top(zg-hybrid-candidates(union, ftsRows, vectorRows), limit);
        }
        def zg-ranked(scan, route, limit) = !((String) route == ZgRouteHybrid()) ? zg-top(zg-candidates(zg-scan-docs(scan), route, scan), limit) : zg-ranked-hybrid(scan, limit);

        def zg-line-column-go(text, i, stop, line, column) = i >= stop ? list(line, column) : (Comparable) str_byte_at(text, i) == 10 ? zg-line-column-go(text, i + 1, stop, line + 1, 1) : zg-line-column-go(text, i + 1, stop, line, column + 1);
        def zg-line-column(text, offset) = offset < 0 ? list(1, 1) : zg-line-column-go(text, 0, offset, 1, 1);
        def zg-evidence-start(offset) = offset < 0 ? 0 : zg-max(0, offset - ZgExcerptBefore());
        def zg-hit(nodeId, lens, line, column, excerpt, score, matchedBy, rank, ftsRank, vectorRank, offset) = list(nodeId, lens, line, column, excerpt, score, matchedBy, rank, ftsRank, vectorRank, ZgResident(), offset);
        def zg-hit-node(hit) = hit[0];
        def zg-hit-lens(hit) = hit[1];
        def zg-hit-line(hit) = hit[2];
        def zg-hit-column(hit) = hit[3];
        def zg-hit-excerpt(hit) = hit[4];
        def zg-hit-score(hit) = hit[5];
        def zg-hit-matched-by(hit) = hit[6];
        def zg-hit-rank(hit) = hit[7];
        def zg-hit-fts-rank(hit) = hit[8];
        def zg-hit-vector-rank(hit) = hit[9];
        def zg-hit-status(hit) = hit[10];
        def zg-hit-offset(hit) = hit[11];

        def zg-materialize-hit(route, candidate, rank) {
            let doc = zg-candidate-doc(candidate);
            let text = zg-doc-text(doc);
            let offset = (String) route == ZgRouteRg() ? zg-doc-exact-offset(doc) : zg-doc-evidence-offset(doc);
            let lc = zg-line-column(text, offset);
            let start = zg-evidence-start(offset);
            let end = zg-min(str_len(text), start + ZgExcerptLimit());
            let ftsRank = (String) route == ZgRouteFts() ? rank : zg-candidate-fts-rank(candidate);
            let vectorRank = (String) route == ZgRouteVector() ? rank : zg-candidate-vector-rank(candidate);
            zg-hit(zg-doc-node(doc), zg-doc-lens(doc), lc[0], lc[1], substring(text, start, end), zg-candidate-score(candidate), zg-candidate-matched-by(candidate), rank, ftsRank, vectorRank, offset);
        }
        def zg-materialize(route, candidates, rank) = nil?(candidates) ? list() : cons(zg-materialize-hit(route, head(candidates), rank), zg-materialize(route, tail(candidates), rank + 1));

        // Result = schema, status, reason, route, query, hits, offered,
        // admitted, skipped, membrane crossings, local-model runs.
        def zg-result(status, reason, route, query, hits, offered, admitted, skipped) = list(ZgSchema(), status, reason, route, query, hits, offered, admitted, skipped, 0, 0);
        def zg-result-schema(result) = result[0];
        def zg-status(result) = result[1];
        def zg-reason(result) = result[2];
        def zg-route(result) = result[3];
        def zg-query-text(result) = result[4];
        def zg-hits(result) = result[5];
        def zg-offered-count(result) = result[6];
        def zg-admitted-count(result) = result[7];
        def zg-skipped-count(result) = result[8];
        def zg-membrane-crossings(result) = result[9];
        def zg-local-model-runs(result) = result[10];

        def zg-query-indexed(memories, route, query, limit, terms) {
            let scan = zg-scan-memory(memories, route, query, terms);
            let hits = zg-materialize(route, zg-ranked(scan, route, limit), 1);
            let status = nil?(hits) ? ZgStatusMiss() : ZgStatusHit();
            let reason = nil?(hits) ? "no-resident-value-match" : "resident-value-match";
            zg-result(status, reason, route, query, hits, zg-scan-offered(scan), zg-scan-admitted(scan), zg-scan-skipped(scan));
        }
        def zg-query-ready(memories, route, query, limit) {
            let terms = zg-unique-words(query);
            (!((String) route == ZgRouteRg())) && ((Comparable) len(terms) == 0) ? zg-result(ZgStatusNothing(), "query-has-no-search-terms", route, query, list(), len(memories), 0, len(memories)) : zg-query-indexed(memories, route, query, limit, terms);
        }
        def zg-query-memory(memories, route, query, requestedLimit) {
            let limit = zg-limit(requestedLimit);
            (Comparable) zg-mode-valid?(route) == 0 ? zg-result(ZgStatusNothing(), "invalid-route", route, query, list(), len(memories), 0, len(memories)) : (Comparable) zg-query-valid?(query) == 0 ? zg-result(ZgStatusNothing(), "invalid-query", route, query, list(), len(memories), 0, len(memories)) : zg-query-ready(memories, route, query, limit);
        }

        def zg-command-route(arg) {
            let first = str_find(arg, " ", 0) < 0 ? arg : substring(arg, 0, str_find(arg, " ", 0));
            (Comparable) zg-mode-valid?(first) == 1 ? first : ZgRouteHybrid();
        }
        def zg-command-query(arg) {
            let split = str_find(arg, " ", 0);
            let first = split < 0 ? arg : substring(arg, 0, split);
            ((Comparable) zg-mode-valid?(first) == 1) && (split >= 0) ? substring(arg, split + 1, str_len(arg)) : ((Comparable) zg-mode-valid?(first) == 1) && (split < 0) ? "" : arg;
        }
        def zg-command(memories, arg) = zg-query-memory(memories, zg-command-route(arg), zg-command-query(arg), ZgDefaultLimit());

        def zg-render-hit(hit) {
            let location = zg-hit-lens(hit) ++ ":" ++ int_to_str(zg-hit-line(hit)) ++ ":" ++ int_to_str(zg-hit-column(hit));
            let label = " [node=" ++ zg-hit-node(hit) ++ " by=" ++ zg-hit-matched-by(hit) ++ " rank=" ++ int_to_str(zg-hit-rank(hit)) ++ "]\n";
            location ++ label ++ zg-hit-excerpt(hit) ++ "\n";
        }
        def zg-render-hits(hits) = nil?(hits) ? "" : zg-render-hit(head(hits)) ++ zg-render-hits(tail(hits));
        def zg-render(result) {
            let head0 = "zg-native status=" ++ zg-status(result) ++ " route=" ++ zg-route(result);
            let head1 = head0 ++ " hits=" ++ int_to_str(len(zg-hits(result)));
            let head2 = head1 ++ " offered=" ++ int_to_str(zg-offered-count(result));
            let head3 = head2 ++ " admitted=" ++ int_to_str(zg-admitted-count(result));
            let head4 = head3 ++ " skipped=" ++ int_to_str(zg-skipped-count(result));
            let head5 = head4 ++ " crossings=" ++ int_to_str(zg-membrane-crossings(result));
            head5 ++ "\n" ++ zg-render-hits(zg-hits(result));
        }
    }
    0;
}
