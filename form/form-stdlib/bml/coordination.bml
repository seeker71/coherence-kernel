// coordination.bml — who began a movement or a turn: the host's own schedule or a session, and whether a rented mind
// coordinated it. observe/movement-run.bml and observe/native-turn-run.bml both read their rows through this rule, and
// form-stdlib/tests/coordination-band.bml runs the turn's door and compares its rows with the rule, bare and named. A
// table that did not answer, with no session named, reads "unread" and rented_mind 1.
//
// The coordinator is read from the host's own process table, never declared: the first ancestor that is neither the
// body nor a shell (crd-glue). A scheduled walk is launchd -> fkwu scheduled-walk -> sh -> fkwu movement, and reading
// only the direct parent named the shell and called three unattended walks (2026-09-23..25) a session with a rented mind.
// The table alone cannot see a session that began the work detached: under nohup the launcher ends and the kernel is
// reparented to launchd. A native turn so begun read host-schedule on 2026-10-28, and on 2026-10-29 the movement
// "walk-here 2026-10-29" a session began read coordinated_by host-schedule, coordinator /sbin/launchd, rented_mind 0
// (receipts/crossings-ledger.jsonl row 150). The caller's own "session" key is the truth of who began it, and the word
// can only add rent: a named session reads "session" and rented_mind 1 under any parent; only the keeper (launchd) with no
// session named reads "host-schedule" and rented_mind 0. The coordinator path stays what the table read.
//
//   crd-coordinator()           the coordinator's executable path, read from the table now ("" when the table did not
//                               answer); a door reads it once, at its start, before a detached launcher can end
//   crd-coordinator-in(t, me)   the same climb over a table t (pid -> row, [] for a pid it does not hold) from the row me
//   crd-kept?(opts, exe)        the keeper began it and opts names no session
//   crd-by(opts, exe)           "host-schedule" when kept; "unread" when no session is named and no coordinator was read;
//                               "session" otherwise
//   crd-rented(opts, exe)       0 when kept, else 1
//   crd-who(opts, exe)          the row's three pairs: coordinated_by, coordinator, rented_mind
//   crd-dependence(opts, exe)   "none" (a known no) when kept, else "" (unmeasured)
//   crd-session(opts)           the session pair as the caller gave it, or none when it named none
//
// A row is [pid ppid exe cwd argv start-ms withheld state] (host_process); the climb reads ppid and exe only.
// What it needs: form-stdlib/json.fk (the request's keys and the row's pairs; core's any?).
import form-stdlib/json.fk;
section [form.bml] {
 class Coordination {
  def crd-row-of(value) = (String) value_kind(value) == "list" ? value : [];
  def crd-host-row(pid) = crd-row-of(host_process(pid));
  def crd-parent-in(table, me) = len(me) < 2 ? [] : table(me[1]);
  def crd-exe(row) = len(row) < 3 ? "" : row[2];
  def crd-tail(path, i) = i <= 0 ? path : (Comparable) str_byte_at(path, i - 1) == 47 ? substring(path, i, len(path)) : crd-tail(path, i - 1);
  def crd-base(path) = (String) path == "" ? "" : crd-tail(path, len(path));
  def crd-keeper?(exe) = (String) crd-base(exe) == "launchd";
  // the body and the shells a launch passes through: never a coordinator of their own
  def crd-glue() = ["fkwu", "sh", "zsh", "bash", "form-run"];
  def crd-glue-base?(base) = any?(g => (String) base == g, crd-glue());
  def crd-glue?(exe) = crd-glue-base?(crd-base(exe));
  def crd-climb-in(table, row, hops) = (len(row) < 3) || (hops <= 0) ? row : crd-glue?(crd-exe(row)) ? crd-climb-in(table, crd-parent-in(table, row), hops - 1) : row;
  def crd-coordinator-in(table, me) = crd-exe(crd-climb-in(table, crd-parent-in(table, me), 8));
  def crd-coordinator() = crd-coordinator-in(crd-host-row, crd-host-row(host_pid()));
  def crd-named?(opts) = json-object-has?(opts, "session");
  def crd-kept?(opts, exe) = crd-keeper?(exe) && !crd-named?(opts);
  def crd-by(opts, exe) = crd-kept?(opts, exe) ? "host-schedule" : (!crd-named?(opts) && ((String) exe == "")) ? "unread" : "session";
  def crd-rented(opts, exe) = crd-kept?(opts, exe) ? 0 : 1;
  def crd-who(opts, exe) = [json-node-pair("coordinated_by", json-node-string(crd-by(opts, exe))), json-node-pair("coordinator", json-node-string(exe)), json-node-pair("rented_mind", json-node-int(crd-rented(opts, exe)))];
  def crd-dependence(opts, exe) = crd-kept?(opts, exe) ? "none" : "";
  def crd-session(opts) = crd-named?(opts) ? [json-node-pair("session", json-object-get(opts, "session"))] : [];
 }
}
