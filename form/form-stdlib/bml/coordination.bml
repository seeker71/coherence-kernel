// coordination.bml — who began a movement or a turn: the host's own schedule, the person, a session, or a line no one
// can name, and whether a rented mind coordinated it. observe/movement-run.bml and observe/native-turn-run.bml read their
// rows through this rule, local-run.bml's lrun-session reads every ledger's "session" through it, and
// form-stdlib/tests/coordination-band.bml runs the turn's door and compares its rows with the rule, bare and named.
//
// THE RULE. Who began it is read from the host's own process table, never declared, climbing this process's ancestor
// line past the glue (crd-glue: the body, the shells, and the wrappers that run what they are given):
//   a rented agent (claude, codex) anywhere in the line   session    rented_mind 1   (lrun-session: its argv id, else rented:<host>)
//   the line ends at the keeper (launchd), and the row the keeper began is a job the body names (crd-job-name: the walk's
//   launcher, <WorkingDirectory>/launch/fkwu on <WorkingDirectory>/launch/walk-launch.fk, or a resident door a
//   docs/launchd plist begins as ./fkwu <door>)            host-schedule   rented_mind 0   session ""
//   a coordinator past the glue that is neither the keeper nor a rented agent: a terminal, its login, tmux
//                                                         person     rented_mind 0   session ""
//   the line ends at the keeper under no job the body names: a kernel begun under nohup, its launcher ended and the
//   kernel reparented, whoever began it                   detached   rented_mind unknown (null)   session "detached"
//   no coordinator read, or a shell the climb stopped in  unread     rented_mind 1   session "unread"
// So "" is a positive reading: the walk's job or the person, each seen in the table. The caller's own "session" key can
// only add rent: a named session reads "session" and rented_mind 1 under any line. The coordinator path stays what the
// table read; the job the keeper began rides beside it.
//
//   crd-rented-row()            the nearest rented agent's own row in this process's ancestor line ([] when none
//                               stands): its pid, exe, cwd and argv, the ground of local-run.bml's lrun-session
//   crd-coordinator()           [the coordinator's executable path ("" when the table did not answer), the job the keeper
//                               began ("" when none the body names)], read from the table now; a door reads it once, at
//                               its start, before a detached launcher can end. A bare path reads as a coordinator with no job.
//   crd-coordinator-in(t, me)   the same climb over a table t (pid -> row, [] for a pid it does not hold) from the row me
//   crd-job-name(row)           the name the body gives the job that row is: "walk-launch", the resident door, or ""
//   crd-kept?(opts, c)          the keeper began a job the body names and opts names no session
//   crd-by(opts, c)             host-schedule | person | detached | unread | session, per the rule
//   crd-rented(opts, c)         0 when kept or the person's, nothing() when detached, else 1
//   crd-who(opts, c)            the row's three pairs: coordinated_by, coordinator, rented_mind
//   crd-dependence(opts, c)     "none" (a known no) when no rented mind coordinated, else "" (unmeasured)
//   crd-session(opts)           the session pair as the caller gave it, or none when it named none
//   crd-line-word-in(t, me)     the session word of a line no rented agent stands in: "", "detached" or "unread"
//
// A row is [pid ppid exe cwd argv start-ms withheld state] (host_process); argv holds argv[0].
// What it needs: form-stdlib/json.fk (the request's keys and the row's pairs; core's any?).
import form-stdlib/json.fk;
section [form.bml] {
 class Coordination {
  def crd-row-of(value) = (String) value_kind(value) == "list" ? value : [];
  def crd-host-row(pid) = crd-row-of(host_process(pid));
  def crd-parent-in(table, me) = len(me) < 2 ? [] : table(me[1]);
  def crd-exe(row) = len(row) < 3 ? "" : row[2];
  def crd-cwd(row) = len(row) < 4 ? "" : row[3];
  def crd-argv(row) = (len(row) > 4) && ((String) value_kind(row[4]) == "list") ? row[4] : [];
  def crd-tail(path, i) = i <= 0 ? path : (Comparable) str_byte_at(path, i - 1) == 47 ? substring(path, i, len(path)) : crd-tail(path, i - 1);
  def crd-base(path) = (String) path == "" ? "" : crd-tail(path, len(path));
  def crd-keeper?(exe) = (String) crd-base(exe) == "launchd";
  def crd-glue() = ["fkwu", "sh", "zsh", "bash", "form-run", "timeout", "sandbox-exec", "env"];
  def crd-glue-base?(base) = any?(g => (String) base == g, crd-glue());
  def crd-glue?(exe) = crd-glue-base?(crd-base(exe));
  def crd-climb-in(table, row, hops) = (len(row) < 3) || (hops <= 0) ? row : crd-glue?(crd-exe(row)) ? crd-climb-in(table, crd-parent-in(table, row), hops - 1) : row;
  def crd-rented-hosts() = ["claude", "codex"];
  def crd-rented-host?(exe) = any?(h => (String) crd-base(exe) == h, crd-rented-hosts());
  def crd-rented-in(table, row, hops) = (len(row) < 3) || (hops <= 0) ? [] : crd-rented-host?(crd-exe(row)) ? row : crd-rented-in(table, crd-parent-in(table, row), hops - 1);
  def crd-rented-row-in(table, me) = crd-rented-in(table, crd-parent-in(table, me), 16);
  def crd-rented-row() = crd-rented-row-in(crd-host-row, crd-host-row(host_pid()));
  // the jobs the body names (docs/launchd): the walk's pinned launcher, and the resident doors a plist begins as ./fkwu <door>
  def crd-resident-doors() = ["observe/form-find-run.fk", "observe/voice-track-worker-run.fk"];
  def crd-launcher?(row) {
   let a = crd-argv(row);
   let d = crd-cwd(row);
   (len(a) >= 3) && ((String) d != "") && ((String) a[0] == d ++ "/launch/fkwu") && ((String) a[1] == d ++ "/launch/walk-launch.fk") && ((String) crd-exe(row) == a[0]);
  }
  def crd-resident?(row) {
   let a = crd-argv(row);
   (len(a) == 2) && ((String) crd-cwd(row) != "") && ((String) a[0] == "./fkwu") && ((String) crd-exe(row) == crd-cwd(row) ++ "/fkwu") && any?(d => (String) a[1] == d, crd-resident-doors());
  }
  def crd-job-name(row) = crd-launcher?(row) ? "walk-launch" : crd-resident?(row) ? crd-argv(row)[1] : "";
  // the row of the line the keeper began, from me upward, read for the name the body gives it
  def crd-job-in(table, row, hops) = (len(row) < 3) || (hops <= 0) ? "" : crd-keeper?(crd-exe(crd-parent-in(table, row))) ? crd-job-name(row) : crd-job-in(table, crd-parent-in(table, row), hops - 1);
  def crd-reading(exe, job) = [exe, job];
  def crd-exe-of(c) = (String) value_kind(c) == "list" ? c[0] : c;
  def crd-job-of(c) = (String) value_kind(c) == "list" ? c[1] : "";
  def crd-coordinator-in(table, me) {
   let r = crd-rented-row-in(table, me);
   let row = len(r) >= 3 ? r : crd-climb-in(table, crd-parent-in(table, me), 8);
   crd-reading(crd-exe(row), crd-keeper?(crd-exe(row)) ? crd-job-in(table, me, 16) : "");
  }
  def crd-coordinator() = crd-coordinator-in(crd-host-row, crd-host-row(host_pid()));
  def crd-named?(opts) = json-object-has?(opts, "session");
  def crd-kept?(opts, c) = crd-keeper?(crd-exe-of(c)) && ((String) crd-job-of(c) != "") && !crd-named?(opts);
  def crd-detached?(opts, c) = crd-keeper?(crd-exe-of(c)) && ((String) crd-job-of(c) == "") && !crd-named?(opts);
  def crd-person?(opts, c) { let exe = crd-exe-of(c); !crd-named?(opts) && ((String) exe != "") && !crd-keeper?(exe) && !crd-rented-host?(exe) && !crd-glue?(exe); }
  def crd-free?(opts, c) = crd-kept?(opts, c) || crd-person?(opts, c);
  def crd-by(opts, c) = crd-kept?(opts, c) ? "host-schedule" : crd-detached?(opts, c) ? "detached" : crd-person?(opts, c) ? "person" : (!crd-named?(opts) && (((String) crd-exe-of(c) == "") || crd-glue?(crd-exe-of(c)))) ? "unread" : "session";
  def crd-rented(opts, c) = crd-free?(opts, c) ? 0 : crd-detached?(opts, c) ? nothing() : 1;
  def crd-who(opts, c) = [json-node-pair("coordinated_by", json-node-string(crd-by(opts, c))), json-node-pair("coordinator", json-node-string(crd-exe-of(c))), json-node-pair("rented_mind", json-node-int(crd-rented(opts, c)))];
  def crd-dependence(opts, c) = crd-free?(opts, c) ? "none" : "";
  def crd-session(opts) = crd-named?(opts) ? [json-node-pair("session", json-object-get(opts, "session"))] : [];
  def crd-line-word-in(table, me) { let by = crd-by(json-node-object([]), crd-coordinator-in(table, me)); (String) by == "host-schedule" || (String) by == "person" ? "" : by; }
 }
}
