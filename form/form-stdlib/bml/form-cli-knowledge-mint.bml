//////////////////////////////////////////////////////////////////////
//
// form-cli-knowledge-mint.bml — high-grammar authority.
//
// Form knowledge into the local LLM is a measured path, not a 27B
// gradient. The body already owns the LoRA identity (lora-adapter.fk)
// and refused to LoRA Qwen Q8_0 because "fine-tune" sounded like
// weights. Samples are the missing fuel: this body can mint as many
// as needed, combinatorially diverse, train/heldout, leakage 0.
//
// Overlay fit is the hand the local model already wears. A per-arch
// A/B tensor writer stays named until heldout lift, leakage 0, and
// axiom-4 (no fabricate) are witnessed.
//
// Executable: form-stdlib/form-cli-knowledge-mint.bml
// Proven by: form-stdlib/tests/form-cli-knowledge-mint-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.knowledgemint;

import Form.kernel.*;
import Form.cli.flow.*;

enum SampleSplit [public] {
   TRAIN,
   HELDOUT
}

interface IKnowledgeMint [public, witness, reusable] {
   section [public] {
      const int MixA = 7;
      const int MixB = 13;
      const int NControls = 6;
      const int LoraWriter = 0;
      const String TrustRule = "mint from Form; measure heldout; LoRA tensors wait on lift";

      int Mix( int nI, int nMod ) [abstract];
      String Situation( String strClass, int nI, String strSplit ) [abstract];
      int Leakage( Object hRows ) [abstract];
      int Unique( Object hRows ) [abstract];
      int LoraWriterReady() [abstract];
   }
}

template SampleRow<TClass> [public, reusable] {
   section [public] {
      String Split() [get];
      TClass Class() [get];
      String Situation() [get];
   }
}

class FormKnowledgeMint [public, reusable, teach] : IKnowledgeMint {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-knowledge-mint.bml";

      int Mix( int nI, int nMod ) [abstract] {}
      String Situation( String strClass, int nI, String strSplit ) [abstract] {}
      int Leakage( Object hRows ) [abstract] {}
      int Unique( Object hRows ) [abstract] {}
      int LoraWriterReady() [abstract] {}
   }
}

class FormKnowledgeMintSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-knowledge-mint-self";
      const String Pattern = "combinatorial-mint heldout-leakage-0 overlay-fit lora-identity-waits";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
