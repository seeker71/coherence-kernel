// Complete bounded work in the existing turn collector and report its cost.
// Token cost and tool-event reconciliation have separate evidence. The same
// collector and source-boundary witness supply both; no token parser is added.
// preludes: form-stdlib/bml/form-cli-turn-evidence-cursor.bml
section [form.bml] {
 class FormCliTurnCost {
  def ftc-max-steps() = 8;
  def ftc-attention-ms() = 5000;
  def ftc-ready(result) = ((String) result == "turn-evidence-refresh=observed\n");
  def ftc-progress(result) = (((Comparable) str_find(result,"turn-evidence-refresh=progress",0) == 0) || (((Comparable) str_find(result,"turn-evidence-refresh=locating-start",0) == 0) || ((Comparable) str_find(result,"turn-evidence-refresh=discovering",0) == 0)));
  def ftc-refresh(path,left,started) {
   let result = fctel-refresh-once(path);
   if (ftc-progress(result) && ((left > 1) && ((now_unix_ms() - started) < ftc-attention-ms()))) then ftc-refresh(path,(left - 1),started) else result;
  }
  def ftc-number(ok,value) = if ok then json-node-int(value) else json-node-null();
  def ftc-token-evidence-valid(evidence) = (fcte-carrier-present?(evidence) && (((String) head(evidence) == fcte-tag-current()) && (fcte-provenance-shape?(evidence) && (fcte-time-valid?(evidence) && (fcte-token-valid?(evidence) && (((Comparable) fcte-source-ok?(evidence) == 1) && ((Comparable) fcte-complete(evidence) == 1)))))));
  def ftc-candidate-result(result) = ((String) result == "turn-evidence-refresh=unreconciled\n");
  def ftc-read-bound(path) {
   let started = now_unix_ms();
   let refreshed = if ((String) path == "") then "turn-evidence-refresh=unavailable reason=no-explicit-binding\n" else if (!((String) path == fctel-bound-path())) then "turn-evidence-refresh=unavailable reason=explicit-binding-mismatch\n" else ftc-refresh(path,ftc-max-steps(),started);
   let stored = read_file(if ftc-candidate-result(refreshed) then fctel-candidate-row-path() else fctel-observed-row-path());
   let raw = if nothing?(stored) then "" else stored;
   let evidence = fcte-parse(raw);
   let eligible = ((ftc-ready(refreshed) || ftc-candidate-result(refreshed)) && (ftc-token-evidence-valid(evidence) && ((String) path == fctel-bound-path())));
   let ok = if eligible then fctec-codex-source-reconciled?(evidence,path) else 0;
   json-node-object(list(json-node-pair("schema",json-node-string("form-completed-turn-cost-v2")),json-node-pair("status",json-node-string(if ok then "observed" else "pending-or-unavailable")),json-node-pair("scope",json-node-string("selected completed coordinating turn; current open turn and separate provider subprocesses excluded")),json-node-pair("collector_result",json-node-string(trim(refreshed))),json-node-pair("refresh_elapsed_ms",json-node-int((now_unix_ms() - started))),json-node-pair("max_refresh_steps",json-node-int(ftc-max-steps())),json-node-pair("between_steps_attention_ms",json-node-int(ftc-attention-ms())),
    json-node-pair("reconciliation_scope",json-node-string("Provider-call token quantities plus carrier identity, source coordinates, timestamps and completion. Tool-event reconciliation remains separate; this cost reading grants no contribution share.")),json-node-pair("full_turn_reconciled",ftc-number(ok,if ok then fcte-valid?(evidence) else 0)),json-node-pair("tool_counts_reconciled",ftc-number(ok,if ok then fcte-tool-valid?(evidence) else 0)),json-node-pair("tool_calls",ftc-number(ok,if ok then fcte-tool-calls(evidence) else 0)),json-node-pair("tool_output_events",ftc-number(ok,if ok then fcte-tool-outputs(evidence) else 0)),
    json-node-pair("thread_id",if ok then json-node-string(fcte-thread-id(evidence)) else json-node-null()),json-node-pair("turn_id",if ok then json-node-string(fcte-turn-id(evidence)) else json-node-null()),json-node-pair("model_provider",if ok then json-node-string(fcte-model-provider(evidence)) else json-node-null()),json-node-pair("model",if ok then json-node-string(fcte-model(evidence)) else json-node-null()),
    json-node-pair("started_ms",ftc-number(ok,if ok then fcte-started-ms(evidence) else 0)),json-node-pair("ended_ms",ftc-number(ok,if ok then fcte-ended-ms(evidence) else 0)),
    json-node-pair("model_calls",ftc-number(ok,if ok then fcte-model-calls(evidence) else 0)),json-node-pair("input_tokens",ftc-number(ok,if ok then fcte-input-tokens(evidence) else 0)),json-node-pair("cached_input_tokens",ftc-number(ok,if ok then fcte-cached-input-tokens(evidence) else 0)),json-node-pair("uncached_input_tokens",ftc-number(ok,if ok then fcte-uncached-input-tokens(evidence) else 0)),json-node-pair("cache_write_input_tokens",ftc-number(ok,if ok then fcte-cache-write-input-tokens(evidence) else 0)),
    json-node-pair("output_tokens",ftc-number(ok,if ok then fcte-output-tokens(evidence) else 0)),json-node-pair("reasoning_output_tokens",ftc-number(ok,if ok then fcte-reasoning-output-tokens(evidence) else 0)),json-node-pair("unattributed_tokens",ftc-number(ok,if ok then fcte-unattributed-tokens(evidence) else 0)),json-node-pair("total_tokens",ftc-number(ok,if ok then fcte-total-tokens(evidence) else 0)),
    json-node-pair("basis",json-node-string(frte-quantity-rule())),json-node-pair("quality",json-node-string("not-established-by-cost"))));
  }
  def ftc-read() = ftc-read-bound(fctel-bound-path());
 }
 0;
}
