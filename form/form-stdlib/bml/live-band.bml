// live-band.bml — a band whose claims are live readings, and whose failed claims are backtrack points.
//
// A band has read its claims after the fact: it ran, folded them into one number, and a gate or a turn
// read the number. Here each claim is observed as it lands, inside attempt so a stop is an observation
// and not an exit, and spoken at once as a reading in the organ-health language on stderr (stdout keeps
// the band's verdict): the claim's expectation, what it observed, its health, and the repairs it offers.
// A claim that does not hold is a backtrack point, not a zero. The band offers its repairs through the
// body's own oac-backtrack-walk: each repair acts on the claim's context and is spoken as applied, and
// the claim is observed again in the context the repair made, the walk carrying what every earlier
// repair saw. A repair that cannot act answers nothing and earns no retry, so an unchanged failure is
// never tried twice. The verdict folds the claims that hold, at first reading or after a repair; a
// repaired claim says so in its readings.
//
// lb-claim(name, bit, want, run): run(ctx) answers the observation, which holds when it equals want.
// lb-repair(name, act): act(ctx) answers the context to observe again in, or nothing when it cannot act.
// lb-run(band, ctx, claims, repairs) answers the verdict. A runner that has already taken a claim's
// first observation (a gate row read in its own child) settles it with lb-settle, which answers
// whether it held and which repair made it hold.
// preludes: form-stdlib/organ-health.bml control/choice-lane-core.fk form-stdlib/meaning-codes.bml
section [form.bml] {
 class LiveBand {
  def lb-claim(name, bit, want, run) = list(name, bit, want, run);
  def lb-repair(name, act) = list(name, act);
  def lb-name(x) = nth(x, 0);
  def lb-bit(claim) = nth(claim, 1);
  def lb-want(claim) = nth(claim, 2);
  def lb-call(f, ctx) = f(ctx);
  def lb-names(xs) = if nil?(xs) then list() else cons(lb-name(head(xs)), lb-names(tail(xs)));

  // what a reading can carry of a Form value
  def lb-json(v) = if nothing?(v) then json-node-null() else if str_eq(value_kind(v), "int") then json-node-int(v) else if str_eq(value_kind(v), "string") then json-node-string(v) else json-node-string(value_str(v));
  def lb-holds?(claim, observed) = if nothing?(observed) then nothing?(lb-want(claim)) else if nothing?(lb-want(claim)) then false else value_eq(observed, lb-want(claim));

  // a reading spoken the moment it is taken, on stderr, where a runner hears it while the band runs
  def lb-say(row) {
   let line = mc-cat(list("form-organ health ", json-emit-precise(row), "\n"));
   let wrote = sbt-append("/dev/stderr", line);
   row;
  }
  def lb-reading(band, claim, attempt-n, observed, ok, offers) = oh-reading-with-id(
   mc-cat(list(band, ":", lb-name(claim), ":", int_to_str(attempt-n), ":", int_to_str(now_unix_ms()))),
   "band", band, lb-name(claim), lb-json(lb-want(claim)), lb-json(observed), json-node-int(if ok then 1 else 0),
   if ok then list() else list(oh-need("claim", json-node-string(lb-name(claim)))),
   offers,
   json-node-object(list(oh-n("bit", lb-bit(claim)), oh-n("attempt", attempt-n))));

  // one claim: observed inside attempt, so a stop is an observation and not an exit
  def lb-observe(claim, ctx) = attempt(lb-call(nth(claim, 3), ctx));
  // An observation already taken is spoken and settled: when it does not hold, the repairs are walked.
  // Answers (list held repaired-by): held 1 or 0, and the repair that made it hold ("" at first reading).
  def lb-settle(band, claim, repairs, ctx, observed) {
   let ok = lb-holds?(claim, observed);
   let reading = lb-say(lb-reading(band, claim, 1, observed, ok, if ok then list() else lb-names(repairs)));
   if ok then list(1, "") else lb-walked(oac-backtrack-walk(lb-options(len(repairs)), list(band, claim, ctx, repairs, reading), list()));
  }
  def lb-claim-verdict(band, claim, repairs, ctx) = if (nth(lb-settle(band, claim, repairs, ctx, lb-observe(claim, ctx)), 0) == 1) then lb-bit(claim) else 0;
  def lb-options(n) = if (n <= 0) then list() else cons(lb-repair-option, lb-options((n - 1)));
  def lb-walked(w) = if (oac-one?(oac-backtrack-ack(w)) == 1) then list(1, node_value(oac-payload(oac-backtrack-ack(w)))) else list(0, "");

  // Each option takes the next repair: every declined option leaves one finding, so the memory's
  // length is the index of the repair this option offers.
  def lb-repair-option(offered) {
   let args = oac-option-args(offered);
   let memory = oac-option-memory(offered);
   let band = nth(args, 0);
   let claim = nth(args, 1);
   let repair = nth(nth(args, 3), len(memory));
   let next = attempt(lb-call(nth(repair, 1), nth(args, 2)));
   let applied = lb-say(oh-applied(nth(args, 4), lb-name(repair), json-node-string(if nothing?(next) then "could not act" else "acted")));
   if nothing?(next) then oac-node(intern_trivial_string(mc-cat(list(lb-name(repair), ": could not act"))))
   else lb-after(band, claim, repair, next, (len(memory) + 2));
  }
  def lb-after(band, claim, repair, ctx, attempt-n) {
   let observed = lb-observe(claim, ctx);
   let ok = lb-holds?(claim, observed);
   let reading = lb-say(lb-reading(band, claim, attempt-n, observed, ok, list()));
   if ok then oac-one(intern_trivial_string(lb-name(repair)))
   else oac-node(intern_trivial_string(mc-cat(list(lb-name(repair), ": observed ", if nothing?(observed) then "nothing" else value_str(observed)))));
  }

  def lb-fold(band, claims, repairs, ctx) = if nil?(claims) then 0 else (lb-claim-verdict(band, head(claims), repairs, ctx) + lb-fold(band, tail(claims), repairs, ctx));
  def lb-run(band, ctx, claims, repairs) = lb-fold(band, claims, repairs, ctx);
 }
}
