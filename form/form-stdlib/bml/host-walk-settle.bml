// host-walk-settle.bml — what the branch says and records when it followed main through conflicts the body settles.
//
// A branch that follows main meets conflicts in two kinds of file the body knows: a river (rows that each carry their
// moment, joined by union) and a page it draws from its ledgers (it takes main's side). The rounds that settle them are
// the reunion's (fcr-rounds-in, form-stdlib/bml/form-cli-reunion.bml, the one authority the landing shares); this part
// holds the walk's side of it: what the sync says ("healed: <paths>", then "redrawn: <pages>" or why the redraw stopped)
// and the redraw's record in the branch. The pages are remade from the ledgers as they stand after the rebase, and the
// remade page becomes one new small commit on the branch, never an amend: a commit the branch already pushed, or one a
// landing carried, keeps its hash, so the push that follows (a lease on the branch) and the later fast-forward of main
// both stay valid. A page that already reads as main drew it adds no commit.
// What it holds: the readers of the sync's line (hw-conflicted?, hw-held-turns: a walk whose branch could not follow main
// takes no turn), the healed lines (hw-healed-lines) and the redraw's commit (hw-redrawn-in).
// What it needs: host-child.bml (every git step and the redraw are argv children) and form-cli-reunion.bml (fcr-drawn,
// fcr-redraw-in, fcr-touches?).
import form-stdlib/bml/host-child.bml;
import form-stdlib/bml/form-cli-reunion.bml;
section [form.bml] {
 class HostWalkSettle {
  // The sync's reading: a line names "conflict:" with files after it only when git named an unmerged file the body does
  // not know; a sync that settled its conflicts reads "healed:" and sync=0, and takes its turns.
  def hw-conflicted?(sync) = nothing?(sync) ? false : any?(line => {
   let marker = "conflict:";
   let at = str_find(line, marker, 0);
   at >= 0 && trim(substring(line, at + len(marker), len(line))) != "";
  }, split-on(sync, "\n"));
  def hw-held-turns(sync) {
   let refusal = "rebase-refused:";
   let detail = hw-conflicted?(sync) ? str-join-with(
    split-on(sync, "\n") |> filter(hw-conflicted?) |> map(line => {
     let marker = "conflict:";
     let at = str_find(line, marker, 0);
     trim(substring(line, at + len(marker), len(line)));
    }), ", ") : {
     let text = str-join-with(split-on(sync, "\n") |> map(trim), "; ");
     str_find(text, refusal, 0) == 0 ? text : refusal + " " + text;
    };
   print_str("[walk] no turn starts: the branch could not follow main (" + detail + ")");
   0;
  }
  def hw-settle-subject() = "The walk followed main: the drawn page remade from the joined ledgers";
  // "healed: <paths>" always, then what the redraw did when a drawn page was among them (neither holds "conflict:")
  def hw-healed-lines(done, redrawn) = nil?(done) ? "" : (String) redrawn == "" ? "healed: " ++ fcr-with(done, " ") : "healed: " ++ fcr-with(done, " ") ++ "\n" ++ redrawn;
  def hw-redrawn-in(io, dir, redraw, done) = fcr-touches?(done) ? hw-redrawn-staged(io, dir, fcr-redraw-in(io, dir, redraw)) : "";
  // a redraw that stopped leaves the page as main drew it: what it half wrote is returned, so no dirty page waits for the next sync
  def hw-restore-in(io, dir) = hch-git-in(io, dir, "sync-redraw-restore", append(["checkout", "HEAD", "--"], fcr-drawn()));
  def hw-redrawn-stopped(io, dir, why, restored) = "redraw stopped: " ++ why;
  def hw-redrawn-staged(io, dir, stopped) = (String) stopped != "" ? hw-redrawn-stopped(io, dir, stopped, hw-restore-in(io, dir)) : hw-redrawn-changed(io, dir, hch-git-in(io, dir, "sync-redraw-diff", append(["diff", "--cached", "--quiet", "--"], fcr-drawn())));
  def hw-redrawn-changed(io, dir, same) = hch-ok?(same) ? "redrawn: " ++ fcr-with(fcr-drawn(), " ") ++ " already as main drew it" : hw-redrawn-committed(io, dir, hch-git-in(io, dir, "sync-redraw-commit", append(["-c", "user.name=Claude", "-c", "user.email=noreply@anthropic.com", "commit", "-q", "-m", hw-settle-subject(), "--"], fcr-drawn())));
  def hw-redrawn-committed(io, dir, run) = hch-ok?(run) ? "redrawn: " ++ fcr-with(fcr-drawn(), " ") : hw-redrawn-stopped(io, dir, "commit exit=" ++ hch-status-text(run), hw-restore-in(io, dir));
 }
}
