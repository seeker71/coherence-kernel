// Executing organs own care. Transient projection stays in collector-visible
// Form values; only the node-returning API admits it to primary cells.
import form-stdlib/bml/form-core-health.bml;
import form-stdlib/organ-care.bml;
import form-stdlib/bml/json-view.bml;
section [form.bml] {
 class FormCoreCare {
  def occ-source-report(reader,source) = ohcv-source-report(reader,source);
  def occ-current(source,rows) = ohcv-current(source,rows);
  def occ-readings(sources) = ohcv-readings(sources);
  def occ-bytes(sources) = ohcv-bytes(sources);
  def occ-source-needs(sources) = ohcv-source-needs(sources);
  def occ-unease(rows) = append(occ-unease-with-pain(rows,1),occ-unease-with-pain(rows,0));
  def occ-unease-with-pain(rows,pain) = ohcv-attention(rows,pain);
  def occ-identity(row) = [jv-pair("organ",jv-get(row,"organ")),jv-pair("flow",jv-get(row,"flow")),jv-pair("aspect",jv-get(row,"aspect")),jv-pair("signal",jv-get(row,"id")),jv-pair("observation_age_ms",jv-get(row,"observation_age_ms"))];
  def occ-needed(row,needs) = if nil?(needs) then [] else cons(jv-object(append(occ-identity(row),[jv-pair("need",needs[0]),jv-pair("offered_responses",jv-get(row,"offers"))])),occ-needed(row,needs[1:]));
  def occ-needs(rows) = if nil?(rows) then [] else append(occ-needed(rows[0],jv-items(jv-get(rows[0],"needs"))),occ-needs(rows[1:]));
  def occ-supply(row,state,delivery) = jv-object(append(occ-identity(row),[jv-s("observation_state",state),jv-pair("care_of",if ((String) state == "awaiting-organ-observation") then jv-get(row,"id") else jv-get(row,"care_of")),jv-pair("need",jv-get(row,"care_need")),jv-pair("responder",jv-get(row,"responder")),jv-pair("delivery",delivery)]));
  def occ-deliveries(rows) = if nil?(rows) then [] else if (((String) jv-str(rows[0],"stage") == "applied") && jv-has(rows[0],"responder")) then cons(occ-supply(rows[0],"awaiting-organ-observation",jv-get(rows[0],"result")),occ-deliveries(rows[1:])) else if (((String) jv-str(rows[0],"stage") == "observe") && jv-has(rows[0],"care_delivery")) then cons(occ-supply(rows[0],"organ-reobserved",jv-get(rows[0],"care_delivery")),occ-deliveries(rows[1:])) else occ-deliveries(rows[1:]);
  def occ-directed(rows) = if nil?(rows) then [] else if (jv-has(rows[0],"attention") || ((len(jv-str(rows[0],"selected")) > 0) || jv-has(rows[0],"responder"))) then cons(rows[0],occ-directed(rows[1:])) else occ-directed(rows[1:]);
  def occ-view(root,discovery,sources,started) {
   let signals = occ-readings(sources);
   jv-object([jv-s("schema","form-core-care-v1"),jv-s("basis","signals-from-executing-organs;care-at-signal-arrival"),jv-s("root",root),jv-pair("coverage",jv-node(oh-get(discovery,"coverage"))),jv-pair("discovery",jv-node(discovery)),jv-pair("sources",jv-array(sources)),jv-pair("signals",jv-array(signals)),jv-pair("unease",jv-array(occ-unease(signals))),jv-pair("directed_attention",jv-array(occ-directed(signals))),jv-pair("needed_resources",jv-array(occ-needs(signals))),jv-pair("supply_outcomes",jv-array(occ-deliveries(signals))),jv-pair("observation_gaps",jv-array(occ-source-needs(sources))),jv-n("read_bytes",occ-bytes(sources)),jv-n("elapsed_ms",(host_monotonic_ms() - started)),jv-n("model_calls",0),jv-n("remote_calls",0),jv-s("crossing_scope","this view;native discovery and new local event bytes"),jv-s("care_scope","running organs supply trusted native provider and observation callbacks;the view supplies no actuator")]);
  }
  def occ-view-request-at(owner,request) = ohc-request-through(owner,request,occ-source-report,occ-view);
  def occ-request-at(owner,request) = jv-materialize(occ-view-request-at(owner,request));
  def occ-command(arg) { let owner = ohc-open(); let text = occ-command-at(owner,arg); ohc-close(owner); text; }
  def occ-command-at(owner,arg) = if (((String) arg == "") || ((String) arg == "status")) then jv-emit(occ-view-request-at(owner,json-node-object([]))) else if ((String) arg == "help") then "care [status|JSON]: organ-emitted unease, directed attention, needed resources and supply outcomes. Running organs send signals directly to the native care organ; providers supply resources and the asking organ observes what changed. Supply awaiting observation remains distinct from the organ's fresh reading. This view reads their current exchange, with retained cursors, without initiating tests or a model call. JSON may select sources and a positive budget_bytes per source. Missing signals remain unknown." else if (!jwa-valid(arg)) then "care refused: expected status or JSON with sources and budget_bytes" else occ-command-request(owner,parse-json("core-care-request",arg));
  def occ-command-request(owner,request) = if (!ohc-request-valid(request)) then "care refused: sources must be valid lexical paths without NUL or parent traversal; budget_bytes must be a positive integer" else jv-emit(occ-view-request-at(owner,request));
 }
 0;
}
