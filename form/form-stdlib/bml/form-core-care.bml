// A view of organ-emitted unease, directed attention and resource supply outcomes.
// Care happens when executing organs send signals to organ-care.bml.
// This reader holds delivery evidence and uncertainty without initiating tests.
// preludes: form-stdlib/bml/form-core-health.bml form-stdlib/organ-care.bml
section [form.bml] {
 class FormCoreCare {
  def occ-unease(rows) = append(occ-unease-with-pain(rows,1),occ-unease-with-pain(rows,0));
  def occ-unease-with-pain(rows,pain) = if nil?(rows) then list() else if and(oc-unease(head(rows)),eq(oh-pain(head(rows)),pain)) then cons(head(rows),occ-unease-with-pain(tail(rows),pain)) else occ-unease-with-pain(tail(rows),pain);
  def occ-identity(row) = list(oh-s("organ",oh-str(row,"organ")),oh-s("flow",oh-str(row,"flow")),oh-s("aspect",oh-str(row,"aspect")),oh-s("signal",oh-str(row,"id")),json-node-pair("observation_age_ms",oh-get(row,"observation_age_ms")));
  def occ-needed(row,needs) = if nil?(needs) then list() else cons(json-node-object(append(occ-identity(row),list(json-node-pair("need",head(needs)),json-node-pair("offered_responses",oh-get(row,"offers"))))),occ-needed(row,tail(needs)));
  def occ-needs(rows) = if nil?(rows) then list() else append(occ-needed(head(rows),ohc-needs(head(rows))),occ-needs(tail(rows)));
  def occ-supply(row,state,delivery) = json-node-object(append(occ-identity(row),list(oh-s("observation_state",state),json-node-pair("care_of",if str_eq(state,"awaiting-organ-observation") then oh-get(row,"id") else oh-get(row,"care_of")),json-node-pair("need",oh-get(row,"care_need")),json-node-pair("responder",oh-get(row,"responder")),json-node-pair("delivery",delivery))));
  def occ-deliveries(rows) = if nil?(rows) then list() else if and(str_eq(oh-str(head(rows),"stage"),"applied"),json-object-has?(head(rows),"responder")) then cons(occ-supply(head(rows),"awaiting-organ-observation",oh-get(head(rows),"result")),occ-deliveries(tail(rows))) else if and(str_eq(oh-str(head(rows),"stage"),"observe"),json-object-has?(head(rows),"care_delivery")) then cons(occ-supply(head(rows),"organ-reobserved",oh-get(head(rows),"care_delivery")),occ-deliveries(tail(rows))) else occ-deliveries(tail(rows));
  def occ-directed(rows) = if nil?(rows) then list() else if or(json-object-has?(head(rows),"attention"),or(gt(str_len(oh-str(head(rows),"selected")),0),json-object-has?(head(rows),"responder"))) then cons(head(rows),occ-directed(tail(rows))) else occ-directed(tail(rows));
  def occ-project(root,discovery,sources,started) {
   let signals = ohc-readings(sources);
   json-node-object(list(oh-s("schema","form-core-care-v1"),oh-s("basis","signals-from-executing-organs;care-at-signal-arrival"),oh-s("root",root),json-node-pair("coverage",oh-get(discovery,"coverage")),json-node-pair("discovery",discovery),json-node-pair("sources",json-node-array(sources)),json-node-pair("signals",json-node-array(signals)),json-node-pair("unease",json-node-array(occ-unease(signals))),json-node-pair("directed_attention",json-node-array(occ-directed(signals))),json-node-pair("needed_resources",json-node-array(occ-needs(signals))),json-node-pair("supply_outcomes",json-node-array(occ-deliveries(signals))),json-node-pair("observation_gaps",json-node-array(ohc-source-needs(sources))),oh-n("read_bytes",ohc-bytes(sources)),oh-n("elapsed_ms",sub(host_monotonic_ms(),started)),oh-n("model_calls",0),oh-n("remote_calls",0),oh-s("crossing_scope","this view;native discovery and new local event bytes"),oh-s("care_scope","running organs supply trusted native provider and observation callbacks;the view supplies no actuator")));
  }
  def occ-request-at(owner,request) = ohc-request-with(owner,request,occ-project);
  def occ-command(arg) = occ-command-at(ohc-open(),arg);
  def occ-command-at(owner,arg) = if or(str_eq(arg,""),str_eq(arg,"status")) then json-emit-precise(occ-request-at(owner,json-node-object(list()))) else if str_eq(arg,"help") then "care [status|JSON]: organ-emitted unease, directed attention, needed resources and supply outcomes. Running organs send signals directly to the native care organ; providers supply resources and the asking organ observes what changed. Supply awaiting observation remains distinct from the organ's fresh reading. This view reads their current exchange, with retained cursors, without initiating tests or a model call. JSON may select sources and a positive budget_bytes per source. Missing signals remain unknown." else if not(jwa-valid(arg)) then "care refused: expected status or JSON with sources and budget_bytes" else occ-command-request(owner,parse-json("core-care-request",arg));
  def occ-command-request(owner,request) = if not(ohc-request-valid(request)) then "care refused: sources must be valid lexical paths without NUL or parent traversal; budget_bytes must be a positive integer" else json-emit-precise(occ-request-at(owner,request));
 }
 0;
}
