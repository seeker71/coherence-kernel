// Executing organs own care. Transient projection stays in collector-visible
// Form values; only the node-returning API admits it to primary cells.
// preludes: form-stdlib/bml/form-core-health.bml form-stdlib/organ-care.bml form-stdlib/bml/json-view.bml
section [form.bml] {
 class FormCoreCare {
  def occ-source-report(reader,source) = ohcv-source-report(reader,source);
  def occ-current(source,rows) = ohcv-current(source,rows);
  def occ-readings(sources) = ohcv-readings(sources);
  def occ-bytes(sources) = ohcv-bytes(sources);
  def occ-source-needs(sources) = ohcv-source-needs(sources);
  def occ-unease(rows) = append(occ-unease-with-pain(rows,1),occ-unease-with-pain(rows,0));
  def occ-unease-with-pain(rows,pain) = ohcv-attention(rows,pain);
  def occ-identity(row) = list(jv-pair("organ",jv-get(row,"organ")),jv-pair("flow",jv-get(row,"flow")),jv-pair("aspect",jv-get(row,"aspect")),jv-pair("signal",jv-get(row,"id")),jv-pair("observation_age_ms",jv-get(row,"observation_age_ms")));
  def occ-needed(row,needs) = if nil?(needs) then list() else cons(jv-object(append(occ-identity(row),list(jv-pair("need",head(needs)),jv-pair("offered_responses",jv-get(row,"offers"))))),occ-needed(row,tail(needs)));
  def occ-needs(rows) = if nil?(rows) then list() else append(occ-needed(head(rows),jv-items(jv-get(head(rows),"needs"))),occ-needs(tail(rows)));
  def occ-supply(row,state,delivery) = jv-object(append(occ-identity(row),list(jv-s("observation_state",state),jv-pair("care_of",if str_eq(state,"awaiting-organ-observation") then jv-get(row,"id") else jv-get(row,"care_of")),jv-pair("need",jv-get(row,"care_need")),jv-pair("responder",jv-get(row,"responder")),jv-pair("delivery",delivery))));
  def occ-deliveries(rows) = if nil?(rows) then list() else if and(str_eq(jv-str(head(rows),"stage"),"applied"),jv-has(head(rows),"responder")) then cons(occ-supply(head(rows),"awaiting-organ-observation",jv-get(head(rows),"result")),occ-deliveries(tail(rows))) else if and(str_eq(jv-str(head(rows),"stage"),"observe"),jv-has(head(rows),"care_delivery")) then cons(occ-supply(head(rows),"organ-reobserved",jv-get(head(rows),"care_delivery")),occ-deliveries(tail(rows))) else occ-deliveries(tail(rows));
  def occ-directed(rows) = if nil?(rows) then list() else if or(jv-has(head(rows),"attention"),or(gt(str_len(jv-str(head(rows),"selected")),0),jv-has(head(rows),"responder"))) then cons(head(rows),occ-directed(tail(rows))) else occ-directed(tail(rows));
  def occ-view(root,discovery,sources,started) {
   let signals = occ-readings(sources);
   jv-object(list(jv-s("schema","form-core-care-v1"),jv-s("basis","signals-from-executing-organs;care-at-signal-arrival"),jv-s("root",root),jv-pair("coverage",jv-node(oh-get(discovery,"coverage"))),jv-pair("discovery",jv-node(discovery)),jv-pair("sources",jv-array(sources)),jv-pair("signals",jv-array(signals)),jv-pair("unease",jv-array(occ-unease(signals))),jv-pair("directed_attention",jv-array(occ-directed(signals))),jv-pair("needed_resources",jv-array(occ-needs(signals))),jv-pair("supply_outcomes",jv-array(occ-deliveries(signals))),jv-pair("observation_gaps",jv-array(occ-source-needs(sources))),jv-n("read_bytes",occ-bytes(sources)),jv-n("elapsed_ms",sub(host_monotonic_ms(),started)),jv-n("model_calls",0),jv-n("remote_calls",0),jv-s("crossing_scope","this view;native discovery and new local event bytes"),jv-s("care_scope","running organs supply trusted native provider and observation callbacks;the view supplies no actuator")));
  }
  def occ-view-request-at(owner,request) = ohc-request-through(owner,request,occ-source-report,occ-view);
  def occ-request-at(owner,request) = jv-materialize(occ-view-request-at(owner,request));
  def occ-command(arg) = occ-command-at(ohc-open(),arg);
  def occ-command-at(owner,arg) = if or(str_eq(arg,""),str_eq(arg,"status")) then jv-emit(occ-view-request-at(owner,json-node-object(list()))) else if str_eq(arg,"help") then "care [status|JSON]: organ-emitted unease, directed attention, needed resources and supply outcomes. Running organs send signals directly to the native care organ; providers supply resources and the asking organ observes what changed. Supply awaiting observation remains distinct from the organ's fresh reading. This view reads their current exchange, with retained cursors, without initiating tests or a model call. JSON may select sources and a positive budget_bytes per source. Missing signals remain unknown." else if not(jwa-valid(arg)) then "care refused: expected status or JSON with sources and budget_bytes" else occ-command-request(owner,parse-json("core-care-request",arg));
  def occ-command-request(owner,request) = if not(ohc-request-valid(request)) then "care refused: sources must be valid lexical paths without NUL or parent traversal; budget_bytes must be a positive integer" else jv-emit(occ-view-request-at(owner,request));
 }
 0;
}
