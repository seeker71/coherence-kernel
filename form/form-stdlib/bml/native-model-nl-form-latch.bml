//////////////////////////////////////////////////////////////////////
//
// native-model-nl-form-latch.bml — high-grammar authority for the 3B
// completion latch that proposes Form tokens and primitives.
//
// A model proposal is data, never executable authority. Native validation
// admits one bounded expression or rejects it and keeps the deterministic
// Form translator in control.
//
// Executable: form-stdlib/native-model-nl-form-latch.bml
// Proven by: form-stdlib/tests/native-model-nl-form-latch-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.native.nlform;

import Form.kernel.*;
import Form.native.modelglass.*;

interface INativeNLFormLatch [public, witness, reusable] {
   section [public] {
      const String Schema = "native-nl-form-latch-v1";
      const String Model = "base.llama32-3b-metal";
      const String Mode = "few-shot-completion";
      const String Exemplar = "Natural language: the square of 5 / Form: (mul 5 5)";
      const String AllowedPrimitives = "mul,add,sub,list,lookup";
      const String AllowedArguments = "unquoted numeric atoms or bounded double-quoted strings; no nested calls, apostrophes, controls, or unresolved names";
      const String AdmissionRule = "proposal is inert text until native shape and primitive validation pass";
      const String NormalizationRule = "only the first bounded expression is considered; every continuation byte is discarded before admission";
      const String SemanticBindingRule = "the admitted primitive head must match a known natural-language intent family; unknown or cross-intent proposals abstain";
      const String RejectionRule = "invalid proposal returns to deterministic native translation; it never executes and never unlocks Qwen";

      String Prompt( String strNaturalLanguage ) [abstract];
      bool ProposalValid( String strProposal ) [abstract];
      String NormalizeFirstExpression( String strModelOutput ) [abstract];
      String NormalizeForIntent( String strNaturalLanguage, String strModelOutput ) [abstract];
   }
}

class NativeNLFormLatch [public, reusable, flow, teach, observable] : INativeNLFormLatch {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-nl-form-latch.bml";
      const int MaxNaturalLanguageBytes = 512;
      const int MaxProposalBytes = 256;

      String Prompt( String strNaturalLanguage ) [abstract] {}
      bool ProposalValid( String strProposal ) [abstract] {}
      String NormalizeFirstExpression( String strModelOutput ) [abstract] {}
      String NormalizeForIntent( String strNaturalLanguage, String strModelOutput ) [abstract] {}
   }
}
