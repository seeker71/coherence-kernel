package Form.cli.speakerhome;

import Form.kernel.*;
import Form.cli.flow.*;

interface ISpeakerHome [public, witness, reusable] {
   section [public] {
      const int NeedEvents = 95;
      const int FqtLora = 0;
      const int NativeVoice = 0;
      const String TrustRule = "speaker is planner overlay; native NL voice still pending";

      String Next( String strSit ) [abstract];
      int Act( String strMove ) [abstract];
      String Prompt( String strSit ) [abstract];
      int Home() [abstract];
   }
}

template SpeakerTurn<TMove> [public, reusable] {
   section [public] {
      TMove Move() [get];
      int Act() [get];
      String Prompt() [get];
   }
}

class FormSpeakerHome [public, reusable, teach] : ISpeakerHome {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-speaker-home.bml";

      String Next( String strSit ) [abstract] {}
      int Act( String strMove ) [abstract] {}
      String Prompt( String strSit ) [abstract] {}
      int Home() [abstract] {}
   }
}

class FormSpeakerHomeSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-speaker-home-self";
      const String Pattern = "planner-overlay speaker-line generate-door fqt-lora-stays-0";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
