package Form.native.modelsymbols;

import Form.kernel.*;
import Form.native.models.*;
import Form.native.modeltokens.*;
import Form.native.modelactions.*;

interface INativeModelSymbolStream [public, witness, reusable] {
   section [public] {
      const String Schema = "native-model-symbol-stream-v1";
      const String PurificationRule = "a query receives compact vocabulary names plus descriptions only for symbols selected by its lane";
      const String EmbodimentRule = "each selected symbol carries its canonical word, witnessed substrate, native route, Node-ID requirement, interface, protocol, and admission state";
      const String AssemblageRule = "the selected frame is the most alive of two explicit success-aliveness candidates; this operational selector is not a metaphysical claim";
      const String StreamingRule = "the core framebuffer feed carries symbol identities, lane, counts, and state but never private prompt or answer content";
      const String LocalCoverageRule = "every local registry row receives a typed feed projection even when its runtime or modality permits assignment but not prompt execution";

      String QueryLane( String strRole ) [abstract];
      String PurifiedPrefix( String strModelId, String strRole ) [abstract];
      String Wrap( String strModelId, String strRole, String strPrompt ) [abstract];
      int StreamToFramebuffer( String strModelId, String strRole ) [abstract];
   }
}

class NativeModelSymbolStream [public, reusable, flow, teach, observable] : INativeModelSymbolStream {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-symbol-stream.bml";
      const String Channel = "core-channel/native-model-symbol-feed";
      const String Interface = "native-model-form";
      const String Protocol = "form-agent-protocol/Hermes-tool-call";

      String QueryLane( String strRole ) [abstract] {}
      String PurifiedPrefix( String strModelId, String strRole ) [abstract] {}
      String Wrap( String strModelId, String strRole, String strPrompt ) [abstract] {}
      int StreamToFramebuffer( String strModelId, String strRole ) [abstract] {}
   }
}
