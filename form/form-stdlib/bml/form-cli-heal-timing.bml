// Elapsed wall intervals between observed events; no nested-span double count.
// preludes: form-stdlib/json.fk form-stdlib/core.fk
section [form.bml] {
    class FormCliHealTiming {
        def fhwt-valid(events, previous, end) = nil?(events) ? 1 : (((head(events)[1] >= previous) && (head(events)[1] <= end)) && fhwt-valid(tail(events), head(events)[1], end));
        def fhwt-span(name, start, end) = list(name, start, end, end - start);
        def fhwt-walk(events, end) = nil?(events) ? list() : cons(fhwt-span(head(head(events)), head(events)[1], nil?(tail(events)) ? end : head(tail(events))[1]), fhwt-walk(tail(events), end));
        def fhwt-spans(events, end) = (end >= 0) && fhwt-valid(events, 0, end) ? fhwt-walk(cons(list("process-launch", 0), events), end) : list();
        def fhwt-total(spans) = nil?(spans) ? 0 : (head(spans)[3] + fhwt-total(tail(spans)));
        def fhwt-prefix(name, prefix) = (Comparable) str_find(name, prefix, 0) == 0;
        def fhwt-family(name) = fhwt-prefix(name, "model-prefill-positions-") || ((String) name == "model-session-prefill-begin") ? "prefill" : fhwt-prefix(name, "model-session-decode-") || ((String) name == "model-session-open-prefill-complete") ? "decode" : fhwt-prefix(name, "model-session-seal-") ? "seal" : fhwt-prefix(name, "model-session-prompt-") || (fhwt-prefix(name, "model-session-header-") || fhwt-prefix(name, "model-session-tokenizer-")) ? "tokenization-and-header" : fhwt-prefix(name, "process-termination") || ((String) name == "process-reaped") ? "termination" : fhwt-prefix(name, "process-") ? "process-before-stage-events" : fhwt-prefix(name, "model-") ? "model-admission" : "other-observed-stages";
        def fhwt-family-ms(spans, family) = nil?(spans) ? 0 : (((String) fhwt-family(head(head(spans))) == family ? head(spans)[3] : 0) + fhwt-family-ms(tail(spans), family));
        def fhwt-families() = list("process-before-stage-events", "seal", "tokenization-and-header", "model-admission", "prefill", "decode", "termination", "other-observed-stages");
        def fhwt-json-families(spans, names) = nil?(names) ? list() : cons(json-node-array(list(json-node-string(head(names)), json-node-int(fhwt-family-ms(spans, head(names))))), fhwt-json-families(spans, tail(names)));
        def fhwt-event(node) = list(json-string-value(head(json-array-elements(node))), json-int-value(json-array-elements(node)[1]));
        def fhwt-events(nodes) = nil?(nodes) ? list() : cons(fhwt-event(head(nodes)), fhwt-events(tail(nodes)));
        def fhwt-json-span(row) = json-node-array(list(json-node-string(head(row)), json-node-int(row[1]), json-node-int(row[2]), json-node-int(row[3])));
        def fhwt-json-spans(rows) = nil?(rows) ? list() : cons(fhwt-json-span(head(rows)), fhwt-json-spans(tail(rows)));
        def fhwt-report(doc) {
            let end = json-int-value(json-object-get(doc, "elapsed_ms"));
            let spans = fhwt-spans(fhwt-events(json-array-elements(json-object-get(doc, "events"))), end);
            json-emit(json-node-object(list(json-node-pair("elapsed_ms", json-node-int(end)), json-node-pair("accounted_ms", json-node-int(fhwt-total(spans))), json-node-pair("valid", json-node-int(!nil?(spans))), json-node-pair("families", json-node-array(fhwt-json-families(spans, fhwt-families()))), json-node-pair("spans", json-node-array(fhwt-json-spans(spans))))));
        }
    }
    0;
}
