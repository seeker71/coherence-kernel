// Elapsed wall intervals between observed events; no nested-span double count.
// preludes: form-stdlib/json.fk form-stdlib/core.fk
section [form.bml] {
    class FormCliHealTiming {
        def fhwt-valid(events, previous, end) = if nil?(events) then 1 else (((nth(head(events), 1) >= previous) && (nth(head(events), 1) <= end)) && fhwt-valid(tail(events), nth(head(events), 1), end));
        def fhwt-span(name, start, end) = list(name, start, end, (end - start));
        def fhwt-walk(events, end) = if nil?(events) then list() else cons(fhwt-span(head(head(events)), nth(head(events), 1), if nil?(tail(events)) then end else nth(head(tail(events)), 1)), fhwt-walk(tail(events), end));
        def fhwt-spans(events, end) = if ((end >= 0) && fhwt-valid(events, 0, end)) then fhwt-walk(cons(list("process-launch", 0), events), end) else list();
        def fhwt-total(spans) = if nil?(spans) then 0 else (nth(head(spans), 3) + fhwt-total(tail(spans)));
        def fhwt-prefix(name, prefix) = ((Comparable) str_find(name, prefix, 0) == 0);
        def fhwt-family(name) = if (fhwt-prefix(name, "model-prefill-positions-") || ((String) name == "model-session-prefill-begin")) then "prefill" else if (fhwt-prefix(name, "model-session-decode-") || ((String) name == "model-session-open-prefill-complete")) then "decode" else if fhwt-prefix(name, "model-session-seal-") then "seal" else if (fhwt-prefix(name, "model-session-prompt-") || (fhwt-prefix(name, "model-session-header-") || fhwt-prefix(name, "model-session-tokenizer-"))) then "tokenization-and-header" else if (fhwt-prefix(name, "process-termination") || ((String) name == "process-reaped")) then "termination" else if fhwt-prefix(name, "process-") then "process-before-stage-events" else if fhwt-prefix(name, "model-") then "model-admission" else "other-observed-stages";
        def fhwt-family-ms(spans, family) = if nil?(spans) then 0 else ((if ((String) fhwt-family(head(head(spans))) == family) then nth(head(spans), 3) else 0) + fhwt-family-ms(tail(spans), family));
        def fhwt-families() = list("process-before-stage-events", "seal", "tokenization-and-header", "model-admission", "prefill", "decode", "termination", "other-observed-stages");
        def fhwt-json-families(spans, names) = if nil?(names) then list() else cons(json-node-array(list(json-node-string(head(names)), json-node-int(fhwt-family-ms(spans, head(names))))), fhwt-json-families(spans, tail(names)));
        def fhwt-event(node) = list(json-string-value(head(json-array-elements(node))), json-int-value(nth(json-array-elements(node), 1)));
        def fhwt-events(nodes) = if nil?(nodes) then list() else cons(fhwt-event(head(nodes)), fhwt-events(tail(nodes)));
        def fhwt-json-span(row) = json-node-array(list(json-node-string(head(row)), json-node-int(nth(row, 1)), json-node-int(nth(row, 2)), json-node-int(nth(row, 3))));
        def fhwt-json-spans(rows) = if nil?(rows) then list() else cons(fhwt-json-span(head(rows)), fhwt-json-spans(tail(rows)));
        def fhwt-report(doc) {
            let end = json-int-value(json-object-get(doc, "elapsed_ms"));
            let spans = fhwt-spans(fhwt-events(json-array-elements(json-object-get(doc, "events"))), end);
            json-emit(json-node-object(list(json-node-pair("elapsed_ms", json-node-int(end)), json-node-pair("accounted_ms", json-node-int(fhwt-total(spans))), json-node-pair("valid", json-node-int((!nil?(spans)))), json-node-pair("families", json-node-array(fhwt-json-families(spans, fhwt-families()))), json-node-pair("spans", json-node-array(fhwt-json-spans(spans))))));
        }
    }
    0;
}
