// flow-reactor.bml — the flow's reflex: a stage that reads discomfort is answered with the smallest repair for that kind, and the flow goes on.
//
// The flow door (observe/flow-run.bml) writes a discomfort cell into the signal frame (flow-signal.bml) when a stage meets something it
// cannot take as it stands: a compile refusal, an unresolved name, a call with the wrong count, a case that failed only by how a value
// prints, a server that stopped beating. The door hands the stage, what the stage said and what it holds to fre-react, which answers
// ONE reading and never stops the flow:
//   ["det",  text, why]   Form knows the repair and applies it itself, with no voice:
//                           "// preludes: ..."   the band or file names the files that define the names the compiler could not find
//                           "n<TAB>printed"      each failed case's expected, rewritten to what the reference printed
//                           "retry"              the server stopped beating: send the same ask again, once
//   ["ask",  text, why]   one small scoped ask through the spool: text is the packet for the broken piece alone (the compiler's words,
//                         the names that stand, the counts a call stands with) and the voice answers only the changed lines
//   ["pass", "",   why]   Form has no repair for this reading: the stage's partial result goes forward as it is
// A deterministic repair outranks an ask, an ask outranks a pass, and nothing here reads or writes a file of its own (the defs table the
// planner keeps is read through the planner's own door). The door emits a "fix" cell for a det or ask repair and resumes at the same stage;
// two repairs that do not soothe the stage make it a "part" cell and the flow carries the partial forward.
// preludes: form-stdlib/bml/form-cli-local-plan.bml
section [form.bml] {
 class FlowReactor {
  // what the stage holds: own = the names the writable files define, skip = the files the band already loads,
  // ref = the reference text the plan wrote, cases = [[index, printed, expected], ...] of the cases that failed
  def fre-ctx(own, skip, ref, cases) = record_new(0, "own", own, "skip", skip, "ref", ref, "cases", cases);
  def fre-det(text, why) = ["det", text, why];
  def fre-ask(text, why) = ["ask", text, why];
  def fre-pass(why) = ["pass", "", why];
  // a prelude in the header's spelling: the repo path without its form/ root
  def fre-prelude-path(p) = flp-starts?(p, "form/") ? substring(p, 5, len(p)) : p;
  // the first file that defines each unresolved name and is not loaded yet, once each
  def fre-fresh-definers(said, skip) {
   let names = flp-unresolved-names(said);
   nil?(names) ? [] : {
    let table = flp-defs-table();
    foldl((acc, n) => foldl((a, f) => flp-has?(a, f) ? a : append(a, [f]), acc, take(1, flp-definers(n, table, skip))), [], names);
   };
  }
  def fre-printed-rows(cases) = nil?(cases) ? [] : filter(r => flp-print-same?(r[1], r[2]), cases);
  def fre-printed-text(rows) = flp-join(map(r => mc-cat([r[0].str(), "\t", r[1]]), rows), "\n");
  def fre-stray?(said) = str_find(said, "stray ')'", 0) >= 0;
  def fre-scoped(block) = mc-cat(["Repair only what the compiler could not take; keep every other line exactly as it is, and answer only the lines you change.", block]);
  def fre-react(stage, said, ctx) {
   let files = fre-fresh-definers(said, record_get(ctx, "skip"));
   let printed = fre-printed-rows(record_get(ctx, "cases"));
   let arity = flp-arity-block(record_get(ctx, "ref"));
   let unresolved = flp-unresolved-block(said, record_get(ctx, "own"));
   (String) stage == "serve" ? fre-det("retry", "stall") :
   !nil?(files) ? fre-det(mc-cat(["// preludes: ", flp-join(map(fre-prelude-path, files), " ")]), mc-cat(["prelude:", flp-join(files, ",")])) :
   !nil?(printed) ? fre-det(fre-printed-text(printed), mc-cat(["printed:", len(printed).str()])) :
   len(arity) > 0 ? fre-ask(fre-scoped(arity), "arity") :
   len(unresolved) > 0 ? fre-ask(fre-scoped(unresolved), "unresolved") :
   fre-stray?(said) ? fre-ask(fre-scoped("\nA call or a bracket in your reply does not close; find it and write it whole."), "stray") :
   fre-pass("unread");
  }
 }
 0;
}
