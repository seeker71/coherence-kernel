// Bounded line-pattern matching for resident coding tools.
// Literals, . ^ $ |, classes/ranges, ASCII \d \w \s \b and ? * +.
// Groups, counted repetition, lookaround, backreferences and Unicode classes
// are explicitly outside this profile. The evaluator carries a work budget.
// preludes: form-stdlib/core.fk form-stdlib/bml/form-agent-tool-values.bml form-stdlib/bml/zvec-grep.bml
section [form.bml] {
    class FormAgentPattern {
        // Token: kind, payload, minimum, maximum (-1 means unbounded).
        def fap-token(kind, text) = list(kind, text, 1, 1);
        def fap-compile(s) = if (str_len(s) > FatMaxPattern()) then list(list(), "pattern-limit") else fap-parse(s, 0, list(), list());
        def fap-parse(s, i, tokens, branches) = if (i >= str_len(s)) then list(fat-reverse(cons(fat-reverse(tokens), branches)), "") else fap-parse-at(s, i, tokens, branches);
        def fap-parse-at(s, i, tokens, branches) {
            let c = fat-char(s, i);
            if ((Comparable) c == 124) then fap-parse(s, (i + 1), list(), cons(fat-reverse(tokens), branches))
            else if (((Comparable) c == 40) || (((Comparable) c == 41) || (((Comparable) c == 123) || (((Comparable) c == 125) || (((Comparable) c == 42) || (((Comparable) c == 43) || ((Comparable) c == 63))))))) then list(list(), "unsupported-pattern-syntax")
            else if ((Comparable) c == 91) then fap-class(s, i, tokens, branches)
            else if ((Comparable) c == 92) then fap-escape(s, i, tokens, branches)
            else fap-add(s, (i + 1), fap-token(if ((Comparable) c == 46) then 1 else if ((Comparable) c == 94) then 6 else if ((Comparable) c == 36) then 7 else 0, byte_to_str(c)), tokens, branches);
        }
        def fap-class(s, i, tokens, branches) {
            let end = str_find(s, "]", (i + 1));
            if (end < 0) then list(list(), "unclosed-character-class")
            else if (((Comparable) end == (i + 1)) || (((Comparable) fat-char(s, (i + 1)) == 94) && ((Comparable) end == (i + 2)))) then list(list(), "empty-character-class")
            else if (str_find(substring(s, (i + 1), end), "\\", 0) >= 0) then list(list(), "class-escape-not-supported")
            else if (!fap-class-valid(s, if ((Comparable) fat-char(s, (i + 1)) == 94) then (i + 2) else (i + 1), end)) then list(list(), "invalid-character-range")
            else fap-add(s, (end + 1), fap-token(2, substring(s, (i + 1), end)), tokens, branches);
        }
        def fap-class-valid(s, i, end) = if (i >= end) then 1 else if (((i + 2) < end) && ((Comparable) fat-char(s, (i + 1)) == 45)) then ((fat-char(s, i) <= fat-char(s, (i + 2))) && fap-class-valid(s, (i + 3), end)) else fap-class-valid(s, (i + 1), end);
        def fap-escape(s, i, tokens, branches) {
            let c = fat-char(s, (i + 1));
            if ((Comparable) c == 0) then list(list(), "trailing-pattern-escape")
            else if (fat-digit(c) || (((c >= 65) && (c <= 90)) || (((c >= 97) && (c <= 122)) && (!(((Comparable) c == 100) || (((Comparable) c == 119) || (((Comparable) c == 115) || (((Comparable) c == 98) || (((Comparable) c == 110) || ((Comparable) c == 116)))))))))) then list(list(), "unsupported-pattern-escape")
            else fap-add(s, (i + 2), fap-token(if ((Comparable) c == 100) then 3 else if ((Comparable) c == 119) then 4 else if ((Comparable) c == 115) then 5 else if ((Comparable) c == 98) then 8 else 0, byte_to_str(if ((Comparable) c == 110) then 10 else if ((Comparable) c == 116) then 9 else c)), tokens, branches);
        }
        def fap-add(s, next, token, tokens, branches) {
            let q = fat-char(s, next);
            let quantified = (((Comparable) q == 42) || (((Comparable) q == 43) || ((Comparable) q == 63)));
            if (quantified && (nth(token, 0) >= 6)) then list(list(), "quantified-anchor")
            else fap-parse(s, if quantified then (next + 1) else next,
                cons(if quantified then list(nth(token, 0), nth(token, 1), if ((Comparable) q == 43) then 1 else 0, if ((Comparable) q == 63) then 1 else -1) else token, tokens), branches);
        }
        def fap-word(c) = (fat-digit(c) || (((c >= 65) && (c <= 90)) || (((c >= 97) && (c <= 122)) || ((Comparable) c == 95))));
        def fap-fold(c, ic) = if ic then zg-lower-byte(c) else c;
        def fap-class-has(s, i, c, ic) = if (i >= str_len(s)) then 0 else if (((i + 2) < str_len(s)) && ((Comparable) fat-char(s, (i + 1)) == 45)) then if ((fap-fold(c, ic) >= fap-fold(fat-char(s, i), ic)) && (fap-fold(c, ic) <= fap-fold(fat-char(s, (i + 2)), ic))) then 1 else fap-class-has(s, (i + 3), c, ic) else if ((Comparable) fap-fold(c, ic) == fap-fold(fat-char(s, i), ic)) then 1 else fap-class-has(s, (i + 1), c, ic);
        def fap-class-match(s, c, ic) = if ((Comparable) fat-char(s, 0) == 94) then (!fap-class-has(s, 1, c, ic)) else fap-class-has(s, 0, c, ic);
        def fap-atom(token, s, pos, ic) {
            let kind = nth(token, 0);
            let c = fat-char(s, pos);
            if (pos >= str_len(s)) then 0
            else if ((Comparable) kind == 0) then ((Comparable) fap-fold(c, ic) == fap-fold(fat-char(nth(token, 1), 0), ic))
            else if ((Comparable) kind == 1) then 1
            else if ((Comparable) kind == 2) then fap-class-match(nth(token, 1), c, ic)
            else if ((Comparable) kind == 3) then fat-digit(c)
            else if ((Comparable) kind == 4) then fap-word(c)
            else if ((Comparable) kind == 5) then fat-ws(c)
            else if ((Comparable) kind == 9) then (!((Comparable) c == 47)) else 0;
        }
        def fap-anchor(kind, s, pos) = if ((Comparable) kind == 6) then ((Comparable) pos == 0) else if ((Comparable) kind == 7) then ((Comparable) pos == str_len(s)) else (!((Comparable) fap-word(fat-char(s, (pos - 1))) == fap-word(fat-char(s, pos))));
        // Match result is (end-position or -1, fuel-left).
        def fap-seq(tokens, s, pos, ic, fuel) = if (fuel <= 0) then list(-1, 0) else if nil?(tokens) then list(pos, (fuel - 1)) else fap-seq-at(tokens, s, pos, ic, (fuel - 1));
        def fap-seq-at(tokens, s, pos, ic, fuel) {
            let token = head(tokens);
            let kind = nth(token, 0);
            if ((kind >= 6) && (kind <= 8)) then if fap-anchor(kind, s, pos) then fap-seq(tail(tokens), s, pos, ic, fuel) else list(-1, fuel)
            else fap-consumed(tokens, s, pos, ic, fap-consume(token, s, pos, ic, nth(token, 3), fuel));
        }
        def fap-consume(token, s, pos, ic, remaining, fuel) = if (fuel <= 0) then list(pos, 0) else if (((Comparable) remaining == 0) || (!fap-atom(token, s, pos, ic))) then list(pos, (fuel - 1)) else fap-consume(token, s, (pos + 1), ic, if (remaining < 0) then -1 else (remaining - 1), (fuel - 1));
        def fap-consumed(tokens, s, pos, ic, span) = if ((head(span) - pos) < nth(head(tokens), 2)) then list(-1, nth(span, 1)) else fap-rest(tail(tokens), s, (pos + nth(head(tokens), 2)), head(span), ic, nth(span, 1));
        def fap-rest(tokens, s, minimum, pos, ic, fuel) = if ((pos < minimum) || (fuel <= 0)) then list(-1, fat-max(0, fuel)) else fap-rest-result(tokens, s, minimum, pos, ic, fap-seq(tokens, s, pos, ic, fuel));
        def fap-rest-result(tokens, s, minimum, pos, ic, result) = if (head(result) >= 0) then result else fap-rest(tokens, s, minimum, (pos - 1), ic, nth(result, 1));
        def fap-branches(branches, s, pos, ic, fuel) = if (nil?(branches) || (fuel <= 0)) then list(-1, fat-max(0, fuel)) else fap-branch-result(branches, s, pos, ic, fap-seq(head(branches), s, pos, ic, fuel));
        def fap-branch-result(branches, s, pos, ic, result) = if (head(result) >= 0) then result else fap-branches(tail(branches), s, pos, ic, nth(result, 1));
        def fap-word-branches(branches) = if nil?(branches) then list() else cons(cons(fap-token(8, ""), append(head(branches), list(fap-token(8, "")))), fap-word-branches(tail(branches)));
        def fap-search(branches, s, ic, whole) = fap-search-at(if whole then fap-word-branches(branches) else branches, s, 0, ic, 0, FatMatchFuel());
        def fap-search-at(branches, s, pos, ic, whole, fuel) = if ((pos > str_len(s)) || (fuel <= 0)) then list(-1, -1, fat-max(0, fuel)) else fap-search-result(branches, s, pos, ic, whole, fap-branches(branches, s, pos, ic, fuel));
        def fap-search-result(branches, s, pos, ic, whole, r) = if ((head(r) >= 0) && (if whole then ((!fap-word(fat-char(s, (pos - 1)))) && (!fap-word(fat-char(s, head(r))))) else 1)) then list(pos, head(r), nth(r, 1)) else fap-search-at(branches, s, (pos + 1), ic, whole, nth(r, 1));

        // Glob matching is anchored; * does not consume '/', ** does.
        def fap-glob-tokens(s, i, out) = if (i >= str_len(s)) then append(fat-reverse(out), list(fap-token(7, ""))) else if ((Comparable) fat-char(s, i) == 42) then fap-glob-tokens(s, if ((Comparable) fat-char(s, (i + 1)) == 42) then (i + 2) else (i + 1), cons(list(if ((Comparable) fat-char(s, (i + 1)) == 42) then 1 else 9, "", 0, -1), out)) else if ((Comparable) fat-char(s, i) == 63) then fap-glob-tokens(s, (i + 1), cons(fap-token(9, ""), out)) else fap-glob-tokens(s, (i + 1), cons(fap-token(0, byte_to_str(fat-char(s, i))), out));
        def fap-basename(s) = head(fat-reverse(split-on(s, "/")));
        // -1 is exhaustion, distinct from a completed non-match (0).
        def fap-glob(pattern, path) = if fat-starts(pattern, "**/") then fap-glob-prefix(pattern, path, fap-glob(substring(pattern, 3, str_len(pattern)), path)) else fap-glob-full(pattern, path);
        def fap-glob-prefix(pattern, path, short) = if (!((Comparable) short == 0)) then short else fap-glob-full(pattern, path);
        def fap-glob-full(pattern, path) = fap-glob-result(fap-seq(fap-glob-tokens(pattern, 0, list(fap-token(6, ""))), if (str_find(pattern, "/", 0) < 0) then fap-basename(path) else path, 0, 0, FatMatchFuel()));
        def fap-glob-result(r) = if (nth(r, 1) <= 0) then -1 else if (head(r) >= 0) then 1 else 0;
    }
}
