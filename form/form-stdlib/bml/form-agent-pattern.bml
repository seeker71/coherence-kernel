// Bounded line-pattern matching for resident coding tools.
// Literals, . ^ $ |, classes/ranges, ASCII \d \w \s \b and ? * +.
// Groups, counted repetition, lookaround, backreferences and Unicode classes
// are explicitly outside this profile. The evaluator carries a work budget.
// preludes: form-stdlib/core.fk form-stdlib/bml/form-agent-tool-values.bml form-stdlib/bml/zvec-grep.bml
section [form.bml] {
    class FormAgentPattern {
        // Token: kind, payload, minimum, maximum (-1 means unbounded).
        def fap-token(kind, text) = list(kind, text, 1, 1);
        def fap-compile(s) = str_len(s) > FatMaxPattern() ? list(list(), "pattern-limit") : fap-parse(s, 0, list(), list());
        def fap-parse(s, i, tokens, branches) = i >= str_len(s) ? list(fat-reverse(cons(fat-reverse(tokens), branches)), "") : fap-parse-at(s, i, tokens, branches);
        def fap-parse-at(s, i, tokens, branches) {
            let c = fat-char(s, i);
            (Comparable) c == 124 ? fap-parse(s, i + 1, list(), cons(fat-reverse(tokens), branches))
            : ((Comparable) c == 40) || (((Comparable) c == 41) || (((Comparable) c == 123) || (((Comparable) c == 125) || (((Comparable) c == 42) || (((Comparable) c == 43) || ((Comparable) c == 63)))))) ? list(list(), "unsupported-pattern-syntax")
            : (Comparable) c == 91 ? fap-class(s, i, tokens, branches)
            : (Comparable) c == 92 ? fap-escape(s, i, tokens, branches)
            : fap-add(s, i + 1, fap-token((Comparable) c == 46 ? 1 : (Comparable) c == 94 ? 6 : (Comparable) c == 36 ? 7 : 0, byte_to_str(c)), tokens, branches);
        }
        def fap-class(s, i, tokens, branches) {
            let end = str_find(s, "]", i + 1);
            end < 0 ? list(list(), "unclosed-character-class")
            : ((Comparable) end == (i + 1)) || (((Comparable) fat-char(s, i + 1) == 94) && ((Comparable) end == (i + 2))) ? list(list(), "empty-character-class")
            : str_find(substring(s, i + 1, end), "\\", 0) >= 0 ? list(list(), "class-escape-not-supported")
            : !fap-class-valid(s, (Comparable) fat-char(s, i + 1) == 94 ? (i + 2) : (i + 1), end) ? list(list(), "invalid-character-range")
            : fap-add(s, end + 1, fap-token(2, substring(s, i + 1, end)), tokens, branches);
        }
        def fap-class-valid(s, i, end) = i >= end ? 1 : ((i + 2) < end) && ((Comparable) fat-char(s, i + 1) == 45) ? ((fat-char(s, i) <= fat-char(s, i + 2)) && fap-class-valid(s, i + 3, end)) : fap-class-valid(s, i + 1, end);
        def fap-escape(s, i, tokens, branches) {
            let c = fat-char(s, i + 1);
            (Comparable) c == 0 ? list(list(), "trailing-pattern-escape")
            : fat-digit(c) || (((c >= 65) && (c <= 90)) || (((c >= 97) && (c <= 122)) && (!(((Comparable) c == 100) || (((Comparable) c == 119) || (((Comparable) c == 115) || (((Comparable) c == 98) || (((Comparable) c == 110) || ((Comparable) c == 116))))))))) ? list(list(), "unsupported-pattern-escape")
            : fap-add(s, i + 2, fap-token((Comparable) c == 100 ? 3 : (Comparable) c == 119 ? 4 : (Comparable) c == 115 ? 5 : (Comparable) c == 98 ? 8 : 0, byte_to_str((Comparable) c == 110 ? 10 : (Comparable) c == 116 ? 9 : c)), tokens, branches);
        }
        def fap-add(s, next, token, tokens, branches) {
            let q = fat-char(s, next);
            let quantified = ((Comparable) q == 42) || (((Comparable) q == 43) || ((Comparable) q == 63));
            quantified && (token[0] >= 6) ? list(list(), "quantified-anchor")
            : fap-parse(s, quantified ? (next + 1) : next,
                cons(quantified ? list(token[0], token[1], (Comparable) q == 43 ? 1 : 0, (Comparable) q == 63 ? 1 : -1) : token, tokens), branches);
        }
        def fap-word(c) = fat-digit(c) || (((c >= 65) && (c <= 90)) || (((c >= 97) && (c <= 122)) || ((Comparable) c == 95)));
        def fap-fold(c, ic) = ic ? zg-lower-byte(c) : c;
        def fap-class-has(s, i, c, ic) = i >= str_len(s) ? 0 : ((i + 2) < str_len(s)) && ((Comparable) fat-char(s, i + 1) == 45) ? ((fap-fold(c, ic) >= fap-fold(fat-char(s, i), ic)) && (fap-fold(c, ic) <= fap-fold(fat-char(s, i + 2), ic)) ? 1 : fap-class-has(s, i + 3, c, ic)) : (Comparable) fap-fold(c, ic) == fap-fold(fat-char(s, i), ic) ? 1 : fap-class-has(s, i + 1, c, ic);
        def fap-class-match(s, c, ic) = (Comparable) fat-char(s, 0) == 94 ? (!fap-class-has(s, 1, c, ic)) : fap-class-has(s, 0, c, ic);
        def fap-atom(token, s, pos, ic) {
            let kind = token[0];
            let c = fat-char(s, pos);
            pos >= str_len(s) ? 0
            : (Comparable) kind == 0 ? ((Comparable) fap-fold(c, ic) == fap-fold(fat-char(token[1], 0), ic))
            : (Comparable) kind == 1 ? 1
            : (Comparable) kind == 2 ? fap-class-match(token[1], c, ic)
            : (Comparable) kind == 3 ? fat-digit(c)
            : (Comparable) kind == 4 ? fap-word(c)
            : (Comparable) kind == 5 ? fat-ws(c)
            : (Comparable) kind == 9 ? (!((Comparable) c == 47)) : 0;
        }
        def fap-anchor(kind, s, pos) = (Comparable) kind == 6 ? ((Comparable) pos == 0) : (Comparable) kind == 7 ? ((Comparable) pos == str_len(s)) : (!((Comparable) fap-word(fat-char(s, pos - 1)) == fap-word(fat-char(s, pos))));
        // Match result is (end-position or -1, fuel-left).
        def fap-seq(tokens, s, pos, ic, fuel) = fuel <= 0 ? list(-1, 0) : nil?(tokens) ? list(pos, fuel - 1) : fap-seq-at(tokens, s, pos, ic, fuel - 1);
        def fap-seq-at(tokens, s, pos, ic, fuel) {
            let token = head(tokens);
            let kind = token[0];
            (kind >= 6) && (kind <= 8) ? (fap-anchor(kind, s, pos) ? fap-seq(tail(tokens), s, pos, ic, fuel) : list(-1, fuel))
            : fap-consumed(tokens, s, pos, ic, fap-consume(token, s, pos, ic, token[3], fuel));
        }
        def fap-consume(token, s, pos, ic, remaining, fuel) = fuel <= 0 ? list(pos, 0) : ((Comparable) remaining == 0) || (!fap-atom(token, s, pos, ic)) ? list(pos, fuel - 1) : fap-consume(token, s, pos + 1, ic, remaining < 0 ? -1 : (remaining - 1), fuel - 1);
        def fap-consumed(tokens, s, pos, ic, span) = (head(span) - pos) < head(tokens)[2] ? list(-1, span[1]) : fap-rest(tail(tokens), s, pos + head(tokens)[2], head(span), ic, span[1]);
        def fap-rest(tokens, s, minimum, pos, ic, fuel) = (pos < minimum) || (fuel <= 0) ? list(-1, fat-max(0, fuel)) : fap-rest-result(tokens, s, minimum, pos, ic, fap-seq(tokens, s, pos, ic, fuel));
        def fap-rest-result(tokens, s, minimum, pos, ic, result) = head(result) >= 0 ? result : fap-rest(tokens, s, minimum, pos - 1, ic, result[1]);
        def fap-branches(branches, s, pos, ic, fuel) = nil?(branches) || (fuel <= 0) ? list(-1, fat-max(0, fuel)) : fap-branch-result(branches, s, pos, ic, fap-seq(head(branches), s, pos, ic, fuel));
        def fap-branch-result(branches, s, pos, ic, result) = head(result) >= 0 ? result : fap-branches(tail(branches), s, pos, ic, result[1]);
        def fap-word-branches(branches) = nil?(branches) ? list() : cons(cons(fap-token(8, ""), append(head(branches), list(fap-token(8, "")))), fap-word-branches(tail(branches)));
        def fap-search(branches, s, ic, whole) = fap-search-at(whole ? fap-word-branches(branches) : branches, s, 0, ic, 0, FatMatchFuel());
        def fap-search-at(branches, s, pos, ic, whole, fuel) = (pos > str_len(s)) || (fuel <= 0) ? list(-1, -1, fat-max(0, fuel)) : fap-search-result(branches, s, pos, ic, whole, fap-branches(branches, s, pos, ic, fuel));
        def fap-search-result(branches, s, pos, ic, whole, r) = (head(r) >= 0) && (whole ? ((!fap-word(fat-char(s, pos - 1))) && (!fap-word(fat-char(s, head(r))))) : 1) ? list(pos, head(r), r[1]) : fap-search-at(branches, s, pos + 1, ic, whole, r[1]);

        // Glob matching is anchored; * does not consume '/', ** does.
        def fap-glob-tokens(s, i, out) = i >= str_len(s) ? append(fat-reverse(out), list(fap-token(7, ""))) : (Comparable) fat-char(s, i) == 42 ? fap-glob-tokens(s, (Comparable) fat-char(s, i + 1) == 42 ? (i + 2) : (i + 1), cons(list((Comparable) fat-char(s, i + 1) == 42 ? 1 : 9, "", 0, -1), out)) : (Comparable) fat-char(s, i) == 63 ? fap-glob-tokens(s, i + 1, cons(fap-token(9, ""), out)) : fap-glob-tokens(s, i + 1, cons(fap-token(0, byte_to_str(fat-char(s, i))), out));
        def fap-basename(s) = head(fat-reverse(split-on(s, "/")));
        // -1 is exhaustion, distinct from a completed non-match (0).
        def fap-glob(pattern, path) = fat-starts(pattern, "**/") ? fap-glob-prefix(pattern, path, fap-glob(substring(pattern, 3, str_len(pattern)), path)) : fap-glob-full(pattern, path);
        def fap-glob-prefix(pattern, path, short) = !((Comparable) short == 0) ? short : fap-glob-full(pattern, path);
        def fap-glob-full(pattern, path) = fap-glob-result(fap-seq(fap-glob-tokens(pattern, 0, list(fap-token(6, ""))), str_find(pattern, "/", 0) < 0 ? fap-basename(path) : path, 0, 0, FatMatchFuel()));
        def fap-glob-result(r) = r[1] <= 0 ? -1 : head(r) >= 0 ? 1 : 0;
    }
}
