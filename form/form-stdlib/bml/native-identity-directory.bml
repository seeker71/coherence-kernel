// Sparse stable row handles over adaptive, immutable u64 identity segments.
// Form serializes publication. Each native reader retains one exact generation.
// Raw semantic words never enter a tagged result or a collector root slot.
// preludes: form-stdlib/bml/native-node-accessor.bml
section [form.bml] {
 class NativeIdentityDirectory {
  def ndi-br(rn) = fa-asm(3592355840,list(32),list(rn));
  def ndi-image() {
   let rows = npd-cat(list(list(nra-address(8,"directory"),nns-str(8,0,0),nra-address(8,"word"),nns-str(8,0,1),fa-movz-x(0,1),fa-ret(),
    // x0 directory view, x1 stable row, x2 field (identity is field zero).
    npd-label("directory"),fa-cmp-x(2,0),npd-branch(1,"missing"),fa-ldr(3,0,0),fa-cmp-x(3,1),npd-branch(1,"missing"),
    fa-ldr(3,0,1),fa-ldr(7,0,2),fa-movz-x(4,0),npd-label("search"),nbl-cmp-x(4,3),npd-branch(2,"missing"),
    fa-add-x-r(5,4,3),nfm-ubfx(5,5,1,63),fa-lsl-x-imm(6,5,5),fa-add-x-r(6,7,6),fa-ldr(8,6,0),
    nbl-cmp-x(1,8),npd-branch(3,"left"),nns-reg(3405774848,10,1,8),fa-ldr(9,6,1),nbl-cmp-x(10,9),npd-branch(3,"found"),
    fa-add-x-imm(4,5,1),npd-branch(14,"search"),npd-label("left"),fa-add-x-imm(3,5,0),npd-branch(14,"search"),
    npd-label("found"),fa-add-x-imm(1,10,0),fa-ldr(16,6,2),fa-ldr(0,6,3),ndi-br(16),
    // x0 segment descriptor [active,count,width,data], x1 local row, x2 field.
    npd-label("word"),fa-cmp-x(2,0),npd-branch(1,"missing"),fa-ldr(3,0,0),fa-cmp-x(3,1),npd-branch(1,"missing"),fa-ldr(3,0,1),nbl-cmp-x(1,3),npd-branch(2,"missing"),
    fa-ldr(14,0,2),nns-mul(6,1,14),fa-ldr(1,0,3),fa-ldr(15,1,0),fa-cmp-x(14,0),npd-branch(0,"constant"),fa-add-x-imm(1,1,8)),nns-address(),
    list(fa-ldr(11,10,0),nns-lsr(7,11,9),fa-add-x-r(13,9,14),fa-cmp-x(13,64),npd-branch(9,"mask"),
    fa-movz-x(13,64),nns-reg(3405774848,13,13,9),fa-ldr(12,10,1),nns-lsl(12,12,13),nns-or(7,7,12),npd-label("mask"),fa-cmp-x(14,64),npd-branch(0,"value"),
    fa-movz-x(13,64),nns-reg(3405774848,13,13,14),nns-lsl(7,7,13),nns-lsr(7,7,13),npd-label("value"),nns-xor(0,7,15),fa-movz-x(1,1),fa-ret(),
    npd-label("constant"),fa-add-x-imm(0,15,0),fa-movz-x(1,1),fa-ret(),npd-label("missing"),fa-movz-x(0,0),fa-movz-x(1,0),fa-ret())));
   fa-image(nra-emit(rows,npd-labels(rows,0,list()),0));
  }
  def ndi-active(owner) = if not(record?(owner)) then 0 else and(str_eq(record_get(owner,"kind"),"native-identity-directory"),and(eq(record_get(owner,"pid"),host_pid()),eq(record_get(owner,"active"),1)));
  def ndi-memory(owner) = record_get(record_get(owner,"carrier"),"memory");
  def ndi-private(owner,bytes) { let region = npd-region(ndi-memory(owner),bytes); if not(nothing?(region)) then record_set(region,"native-accessor-private",1) else 0; region; }
  def ndi-write(owner,region,raw) = nra-call(record_get(owner,"carrier"),list(1,raw,npd-span(region,0,str_len(raw))));
  def ndi-current-segments(owner) = if nothing?(record_get(owner,"current")) then list() else record_get(record_get(owner,"current"),"segments");
  def ndi-storage-state(owner) {
   let storage = record_get(owner,"storage"); let regions = record_get(record_get(storage,"memory"),"regions");
   json-node-object(list(oh-n("payload_requested_bytes",nra-mapped-bytes(regions,0)),oh-n("native_calls",record_get(storage,"calls"))));
  }
  def ndi-state(owner) = json-node-object(list(oh-n("generation",record_get(owner,"generation")),oh-n("segments",len(ndi-current-segments(owner))),oh-n("readers",nra-live-views(record_get(owner,"readers"))),json-node-pair("native",nra-state(record_get(owner,"carrier"))),json-node-pair("storage",ndi-storage-state(owner))));
  def ndi-unease(owner,aspect,need) {
   let row = oh-reading("native-identity-directory",record_get(owner,"flow"),aspect,json-node-string(need),ndi-state(owner),json-node-null(),list(oh-need(need,json-node-null())),list("retain-generation","release-reader","revise-range"),json-node-null()); record_set(owner,"last-reading",row); oh-voice(row); nothing();
  }
  def ndi-open() {
   let carrier = nra-open(); if not(nra-active(carrier)) then nothing() else ndi-open-carrier(carrier);
  }
  def ndi-open-carrier(carrier) {
   let owner = record_new(0,"kind","native-identity-directory","pid",host_pid(),"active",1,"carrier",carrier,"storage",nns-open(),"current",nothing(),"generation",0,"generations",list(),"readers",list(),"segments",list(),"owned-segments",list(),"flow",noc-open(),"code-live",0);
   let image = ndi-image(); let identity = intern_node(make_nodeid(31,2,0,206),list(intern_trivial_string("native-identity-directory-v1"),intern_trivial_string(record_get(owner,"flow")),intern_trivial_string(nfm-bytes-list(image,""))));
   record_set(owner,"identity",identity); record_set(owner,"image",image);
   let exports = ndi-private(owner,16); let root = ndi-private(owner,32); record_set(owner,"root",root);
   if or(nothing?(exports),nothing?(root)) then { ndi-close(owner); nothing(); } else {
    let admitted = jit_leaf_inram(list(0,identity,image),list(npd-span(exports,0,16))); if eq(admitted,1) then record_set(owner,"code-live",1) else 0;
    if not(and(eq(admitted,1),and(eq(npd-peek(exports,7,1),0),eq(npd-peek(exports,15,1),0)))) then { ndi-close(owner); nothing(); } else {
     record_set(owner,"entry",npd-peek(exports,0,7)); record_set(owner,"word-entry",npd-peek(exports,8,7)); owner;
    };
   };
  }
  def ndi-range?(first,count) = if not(and(nbl-int?(first),nbl-int?(count))) then 0 else and(ge(first,0),and(gt(count,0),le(count,sub(4611686018427387903,first))));
  def ndi-overlap(segments,first,count) = if nil?(segments) then 0 else {
   let segment = head(segments); let at = record_get(segment,"first"); let size = record_get(segment,"count");
   if and(lt(first,add(at,size)),lt(at,add(first,count))) then 1 else ndi-overlap(tail(segments),first,count);
  };
  def ndi-insert(segments,segment) = if nil?(segments) then list(segment) else if lt(record_get(segment,"first"),record_get(head(segments),"first")) then cons(segment,segments) else cons(head(segments),ndi-insert(tail(segments),segment));
  def ndi-segment(owner,first,block) = if nothing?(block) then nothing() else {
   let slot = nns-created(record_get(owner,"storage"),block); let reader = nns-acquire(slot); nns-slot-close(slot);
   let descriptor = ndi-private(owner,32);
   if nothing?(descriptor) then { nns-release(reader); nothing(); } else {
    let raw = str-join-with(list(nfm-low(1,8),nfm-low(record_get(block,"count"),8),nfm-low(record_get(block,"width"),8),nfm-low(npd-span(record_get(block,"region"),0,record_get(block,"bytes")),8)),"");
    if not(eq(ndi-write(owner,descriptor,raw),32)) then { npd-region-close(descriptor); nns-release(reader); nothing(); } else record_new(0,"first",first,"count",record_get(block,"count"),"reader",reader,"descriptor",descriptor,"refs",0,"active",1);
   };
  };
  def ndi-segment-release(owner,segment) = if not(eq(record_get(segment,"active"),1)) then 0 else {
   let descriptor = record_get(segment,"descriptor");
   if not(eq(ndi-write(owner,descriptor,nfm-low(0,8)),8)) then ndi-unease(owner,"segment-retirement","invalidated-segment") else {
    let reader = record_get(segment,"reader"); nns-release(reader); let released = nns-collect(record_get(reader,"block")); let closed = if eq(released,0) then npd-region-close(descriptor) else -1;
    if and(eq(released,0),eq(closed,0)) then { record_set(segment,"active",0); 0; } else ndi-unease(owner,"segment-retirement","released-segment-mappings");
   };
  };
  def ndi-ref(segments,delta) = if nil?(segments) then 0 else { let segment = head(segments); record_set(segment,"refs",add(record_get(segment,"refs"),delta)); ndi-ref(tail(segments),delta); };
  def ndi-unref(owner,segments) = if nil?(segments) then 0 else {
   let segment = head(segments); record_set(segment,"refs",sub(record_get(segment,"refs"),1)); if eq(record_get(segment,"refs"),0) then ndi-segment-release(owner,segment) else 0; ndi-unref(owner,tail(segments));
  };
  def ndi-table(owner,segments) = if nil?(segments) then "" else {
   let segment = head(segments); str_concat(str-join-with(list(nfm-low(record_get(segment,"first"),8),nfm-low(record_get(segment,"count"),8),nfm-low(record_get(owner,"word-entry"),8),nfm-low(npd-span(record_get(segment,"descriptor"),0,32),8)),""),ndi-table(owner,tail(segments)));
  };
  def ndi-header(generation) = str-join-with(list(nfm-low(1,8),nfm-low(len(record_get(generation,"segments")),8),nfm-low(npd-span(record_get(generation,"table"),0,record_get(record_get(generation,"table"),"bytes")),8),nfm-low(record_get(generation,"number"),8)),"");
  def ndi-collect(owner,generation) = if not(and(eq(record_get(generation,"retired"),1),and(eq(record_get(generation,"readers"),0),eq(record_get(generation,"active"),1)))) then 0 else {
   if not(eq(npd-region-close(record_get(generation,"table")),0)) then ndi-unease(owner,"generation-retirement","released-directory-table") else { record_set(generation,"active",0); ndi-unref(owner,record_get(generation,"segments")); 0; };
  };
  def ndi-publish(owner,segments) {
   let raw = ndi-table(owner,segments); let table = ndi-private(owner,max2(1,str_len(raw)));
   if nothing?(table) then ndi-unease(owner,"publication","owned-directory-table") else if not(eq(ndi-write(owner,table,raw),str_len(raw))) then { npd-region-close(table); ndi-unease(owner,"publication","complete-directory-table"); } else {
    let generation = record_new(0,"number",add(record_get(owner,"generation"),1),"segments",segments,"table",table,"readers",0,"retired",0,"active",1); record_set(owner,"generations",cons(generation,record_get(owner,"generations")));
    ndi-ref(segments,1);
    if not(eq(ndi-write(owner,record_get(owner,"root"),ndi-header(generation)),32)) then { record_set(generation,"retired",1); ndi-collect(owner,generation); ndi-unease(owner,"publication","complete-directory-root"); } else {
     let previous = record_get(owner,"current"); record_set(owner,"current",generation); record_set(owner,"generation",record_get(generation,"number"));
     if not(nothing?(previous)) then { record_set(previous,"retired",1); ndi-collect(owner,previous); } else 0; record_get(generation,"number");
    };
   };
  }
  def ndi-add-built(owner,first,block) {
   let segment = ndi-segment(owner,first,block);
   if nothing?(segment) then nothing() else {
    record_set(owner,"owned-segments",cons(segment,record_get(owner,"owned-segments")));
    let published = ndi-publish(owner,ndi-insert(ndi-current-segments(owner),segment));
    if nothing?(published) then if eq(record_get(segment,"refs"),0) then ndi-segment-release(owner,segment) else 0 else record_set(owner,"segments",cons(segment,record_get(owner,"segments"))); published;
   };
  }
  def ndi-admit?(owner,first,count) = if not(ndi-active(owner)) then 0 else if not(ndi-range?(first,count)) then 0 else not(ndi-overlap(record_get(owner,"segments"),first,count));
  def ndi-append(owner,first,raw) = if not(ndi-active(owner)) then nothing() else if not(nns-bytes?(raw)) then ndi-unease(owner,"input","complete-u64-identities") else {
   let count = div(str_len(raw),8);
   if not(ndi-admit?(owner,first,count)) then ndi-unease(owner,"range","nonoverlapping-positive-range") else ndi-add-built(owner,first,nns-build(record_get(owner,"storage"),raw));
  };
  def ndi-append-span(owner,first,source,offset,count) = if not(ndi-admit?(owner,first,count)) then nothing() else ndi-add-built(owner,first,nns-build-span(record_get(owner,"storage"),source,offset,count));
  def ndi-find(segments,first) = if nil?(segments) then nothing() else if eq(record_get(head(segments),"first"),first) then head(segments) else ndi-find(tail(segments),first);
  def ndi-without(segments,first) = if nil?(segments) then list() else if eq(record_get(head(segments),"first"),first) then tail(segments) else cons(head(segments),ndi-without(tail(segments),first));
  // Removed ranges stay reserved for this owner lifetime. Reusing a row for a
  // different identity needs an explicit handle-generation ABI.
  def ndi-remove(owner,first) = if not(ndi-active(owner)) then nothing() else if not(nbl-int?(first)) then nothing() else if nothing?(ndi-find(ndi-current-segments(owner),first)) then nothing() else ndi-publish(owner,ndi-without(ndi-current-segments(owner),first));
  def ndi-acquire(owner) = if not(ndi-active(owner)) then nothing() else if nothing?(record_get(owner,"current")) then nothing() else {
   let generation = record_get(owner,"current"); let descriptor = ndi-private(owner,32);
   if nothing?(descriptor) then ndi-unease(owner,"reader","owned-reader-descriptor") else if not(eq(ndi-write(owner,descriptor,ndi-header(generation)),32)) then { npd-region-close(descriptor); nothing(); } else {
    record_set(generation,"readers",add(record_get(generation,"readers"),1)); let reader = record_new(0,"kind","native-identity-reader","owner",owner,"generation",generation,"descriptor",descriptor,"active",1);
    record_set(owner,"readers",cons(reader,record_get(owner,"readers"))); reader;
   };
  };
  def ndi-reader?(reader) = if not(record?(reader)) then 0 else if not(str_eq(record_get(reader,"kind"),"native-identity-reader")) then 0 else and(eq(record_get(reader,"active"),1),ndi-active(record_get(reader,"owner")));
  def ndi-project-at(owner,descriptor,queries,output,offset) = if not(ndi-active(owner)) then nothing() else if not(str_eq(value_kind(queries),"string")) then nothing() else if not(eq(mod(str_len(queries),16),0)) then nothing() else if and(record?(output),record_has(output,"native-accessor-private")) then nothing() else {
   let pointer = npd-owned-span(ndi-memory(owner),output,offset,div(str_len(queries),2));
   if nothing?(pointer) then ndi-unease(owner,"output","owned-u64-results") else nra-call(record_get(owner,"carrier"),list(2,record_get(owner,"entry"),descriptor,queries,pointer));
  };
  def ndi-project(reader,queries,output,offset) = if not(ndi-reader?(reader)) then nothing() else ndi-project-at(record_get(reader,"owner"),npd-span(record_get(reader,"descriptor"),0,32),queries,output,offset);
  def ndi-project-current(owner,queries,output,offset) = if not(ndi-active(owner)) then nothing() else ndi-project-at(owner,npd-span(record_get(owner,"root"),0,32),queries,output,offset);
  def ndi-release(reader) = if not(ndi-reader?(reader)) then 0 else {
   let owner = record_get(reader,"owner"); let generation = record_get(reader,"generation");
   if not(eq(ndi-write(owner,record_get(reader,"descriptor"),nfm-low(0,8)),8)) then ndi-unease(owner,"reader-retirement","invalidated-reader") else { record_set(reader,"active",0); record_set(generation,"readers",sub(record_get(generation,"readers"),1)); ndi-collect(owner,generation); };
  };
  def ndi-close-generations(owner,generations) = if nil?(generations) then 0 else { ndi-collect(owner,head(generations)); ndi-close-generations(owner,tail(generations)); };
  def ndi-close-segments(owner,segments) = if nil?(segments) then 0 else { let segment = head(segments); if eq(record_get(segment,"refs"),0) then ndi-segment-release(owner,segment) else 0; ndi-close-segments(owner,tail(segments)); };
  def ndi-close(owner) = if not(record?(owner)) then 0 else if not(str_eq(record_get(owner,"kind"),"native-identity-directory")) then 0 else if or(not(eq(record_get(owner,"pid"),host_pid())),eq(record_get(owner,"active"),0)) then 0 else if gt(nra-live-views(record_get(owner,"readers")),0) then ndi-unease(owner,"retirement","released-directory-readers") else if not(nra-outputs-closed(record_get(ndi-memory(owner),"regions"))) then ndi-unease(owner,"retirement","released-output-regions") else {
   record_set(owner,"active",2); let root = record_get(owner,"root"); if not(nothing?(root)) then ndi-write(owner,root,nfm-low(0,8)) else 0;
   let current = record_get(owner,"current"); if not(nothing?(current)) then { record_set(current,"retired",1); ndi-collect(owner,current); } else 0;
   ndi-close-generations(owner,record_get(owner,"generations")); ndi-close-segments(owner,record_get(owner,"owned-segments"));
   let released = if eq(record_get(owner,"code-live"),1) then jit_leaf_inram(list(1,record_get(owner,"identity"),list()),0) else 1;
   if not(eq(released,1)) then ndi-unease(owner,"code-retirement","released-directory-code") else {
    record_set(owner,"code-live",0); let storage = if nns-active(record_get(owner,"storage")) then nns-close(record_get(owner,"storage")) else 1;
    if not(eq(storage,1)) then ndi-unease(owner,"storage-retirement","released-identity-storage") else { let carrier = nra-close(record_get(owner,"carrier")); if eq(carrier,1) then record_set(owner,"active",0) else 0; carrier; };
   };
  };
 }
 0;
}
