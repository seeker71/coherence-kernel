package Form.cli.embodycensus;

import Form.kernel.*;
import Form.cli.flow.*;

interface IEmbodyCensus [public, witness, reusable] {
   section [public] {
      const int KnowledgeN = 24;
      const int UniverseN = 32;
      const int UniqueN = 36;
      const int DomainN = 48;
      const int OrganN = 48;
      const int LaneN = 738;
      const int LensN = 144;
      const int PlannerN = 144;
      const int BodySkills = 41;
      const int LensSkills = 8;
      const int PlannerSkills = 8;
      const int Lanes = 9;
      const int CorpusN = 1152;
      const int NeedEvents = 95;
      const int SessionPpm = 894153;
      const int FqtLora = 0;
      const String TrustRule = "sum witnessed mills; do not invent a larger mind";

      int ProofN() [abstract];
      int Organs() [abstract];
      int LaneKinds() [abstract];
   }
}

template CensusRow<TCount> [public, reusable] {
   section [public] {
      TCount ProofN() [get];
      TCount Organs() [get];
      TCount LaneKinds() [get];
   }
}

class FormEmbodyCensus [public, reusable, teach] : IEmbodyCensus {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-embody-census.bml";

      int ProofN() [abstract] {}
      int Organs() [abstract] {}
      int LaneKinds() [abstract] {}
   }
}

class FormEmbodyCensusSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-embody-census-self";
      const String Pattern = "sum-witnessed-mills one-picture fqt-lora-stays-0";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
