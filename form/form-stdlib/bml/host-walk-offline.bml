// host-walk-offline.bml — a git step that failed names itself, and no route to the remote is a state of this body.
//
// A body that walks on its own machine may have no network (2026-10-30: configd read no route from 18:35 to 20:37, the
// 19:00 day turn's fetch ended 128, and the log kept "sync=128" with no word of why). A step that failed answers its name,
// its exit and the first line it said (hw-step-named, "fetch:128 (fatal: unable to access ...)"; the "To <url>" line a push
// opens with says no why and is passed over). A failure whose own words say the remote could not be reached reads offline
// (hw-offline?): the walk goes on over the tree as it stands, a landing stands on the branch (form-cli-landing.bml), and
// the carry pushes it next time (host-walk-carry.bml). Any other failure is not offline: it stays a failure, named.
// What it holds: the words (hw-offline-words), the readers (hw-offline?, hw-offline-text?, hw-offline-in?), a step's name
// (hw-first-said, hw-step-named), and what the walk's line says of the state (hw-offline-said).
// What it needs: host-walk-text.bml (hw-starts?) and host-child.bml (the run's reading; a step's output holds its stderr).
import form-stdlib/bml/host-walk-text.bml;
import form-stdlib/bml/host-child.bml;
section [form.bml] {
 class HostWalkOffline {
  def hw-offline-words() = ["Could not resolve host", "Could not resolve proxy", "Couldn't resolve host", "Temporary failure in name resolution", "Name or service not known", "nodename nor servname", "Failed to connect", "Couldn't connect to server", "Could not connect to", "Network is unreachable", "No route to host", "Connection timed out", "Operation timed out", "Connection refused", "Connection reset by peer"];
  def hw-offline-text?(text) = hch-any-in?(text ?? "", hw-offline-words());
  def hw-offline?(run) = !hch-ok?(run) && hw-offline-text?(hch-said(run));
  // the state as a text says it: the line hw-offline-said stands on, read back by the carry
  def hw-offline-mark() = "offline:";
  def hw-offline-in?(text) = any?(line => hw-starts?(line, hw-offline-mark()), split-on((String) value_kind(text) == "string" ? text : "", "\n"));
  def hw-offline-said() = hw-offline-mark() ++ " no route to origin; the walk goes on over the tree as it stands, lands locally, and the carry pushes next time";
  // a clip never splits a code point: it backs off a continuation byte
  def hw-said-limit() = 240;
  def hw-clip-at(s, n) = n > 0 && (Comparable) str_byte_at(s, n) >= 128 && (Comparable) str_byte_at(s, n) < 192 ? hw-clip-at(s, n - 1) : substring(s, 0, n);
  def hw-said-clip(s) = len(s) <= hw-said-limit() ? s : hw-clip-at(s, hw-said-limit()) ++ "...";
  def hw-said-line?(line) = (Comparable) len(trim(line)) > 0 && !hw-starts?(trim(line), "To ");
  def hw-first-of(lines) = nil?(lines) ? "" : hw-said-line?(lines[0]) ? hw-said-clip(trim(lines[0])) : hw-first-of(lines[1:]);
  def hw-first-said(text) = hw-first-of(hch-lines(text));
  def hw-step-said(run) = hw-first-said(hch-said(run));
  def hw-step-named(step, run) = step ++ ":" ++ hch-status-text(run) ++ ((String) hw-step-said(run) == "" ? "" : " (" ++ hw-step-said(run) ++ ")");
 }
}
