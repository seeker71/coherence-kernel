//////////////////////////////////////////////////////////////////////
// order.bml — the body's one order over text, and the sort that rests on it.
//
// lt/gt read only numbers ("only numbers have an order"), and no sort lived in the stdlib, so a canonical
// composite (a map whose pairs must meet in one order to be one cell, a set) had no way to say which pair comes
// first. The order here is byte order: str-compare reads two strings byte by byte, a shorter string that is a
// prefix of a longer one comes first, and the same two strings always answer the same way on every kernel.
//
//   str-compare(a,b)        -1, 0 or 1
//   str-lt?(a,b)            a comes before b
//   sort-strings(xs)        the strings in byte order (stable; equal strings keep their order)
//   sort-keyed(rows)        rows of [key, ...] in the byte order of their keys (stable)
//   dedupe-sorted(xs)       a sorted list of strings with repeats removed
//////////////////////////////////////////////////////////////////////
section [form.bml] {
 class FormOrder {
  def ord-cmp(a, b, i) {
   i >= len(a) ? (i >= len(b) ? 0 : 0 - 1) :
   i >= len(b) ? 1 :
   str_byte_at(a, i) < str_byte_at(b, i) ? 0 - 1 :
   str_byte_at(a, i) > str_byte_at(b, i) ? 1 : ord-cmp(a, b, i + 1);
  }
  def str-compare(a, b) = ord-cmp(a, b, 0);
  def str-lt?(a, b) = str-compare(a, b) < 0;

  def ord-take(xs, n) = (n <= 0) || nil?(xs) ? [] : cons(xs[0], ord-take(xs[1:], n - 1));
  def ord-drop(xs, n) = (n <= 0) || nil?(xs) ? xs : ord-drop(xs[1:], n - 1);
  // merge two key-sorted lists; the left list wins a tie, which is what keeps the sort stable
  def ord-merge(a, b) {
   nil?(a) ? b :
   nil?(b) ? a :
   str-compare(b[0][0], a[0][0]) < 0 ? cons(b[0], ord-merge(a, b[1:])) : cons(a[0], ord-merge(a[1:], b));
  }
  def sort-keyed(rows) {
   len(rows) <= 1 ? rows : ord-merge(sort-keyed(ord-take(rows, len(rows) / 2)), sort-keyed(ord-drop(rows, len(rows) / 2)));
  }
  def sort-strings(xs) = sort-keyed(xs |> map(x => [x])) |> map(r => r[0]);
  def dedupe-sorted(xs) = nil?(xs) ? [] : (nil?(xs[1:]) ? xs : ((String) xs[0] == (String) xs[1] ? dedupe-sorted(xs[1:]) : cons(xs[0], dedupe-sorted(xs[1:]))));
 }
 0;
}
