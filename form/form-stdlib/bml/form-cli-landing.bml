// The landing: what a movement writes, gates and carries to origin.
// one native call closes a movement: witness, gates, commit, push.
//
// stdin: one JSON object
//   {"witness":"<a command to run and show, or empty>",
//    "paths":["file", ...], "subject":"<commit subject>", "body":"<commit body>",
//    "restart":"origin/main" (optional), "main":1 (optional: the landed commit also fast-forwards main)}
// The witness runs first, its output is shown, and its exit is read: a named
// witness that does not exit 0, or whose launch vanished, lands nothing. The
// drift gates run next as a child fkwu; a refused gate lands nothing. Then host git adds each named
// path that is present, or tracked and gone (a path that is neither is named and left unstaged, since
// one unmatched pathspec would stage nothing), commits with exactly subject, blank line, body, and pushes the
// current branch to its own name on origin; the push answers with its own
// exit, so a commit that did not reach origin reads held, never landed. Every crossing to a child process
// happens inside this call's census window and is printed at the end, so what
// left the body is counted, never hidden. The message file lives under
// .form-heal, which git forgets.
// preflight-exec: forbidden
import form-stdlib/bml/form-cli-reunion.bml;
import form-stdlib/bml/form-cli-heal-native-report.bml;
import form-stdlib/meaning-codes.bml;
import observe/form-membrane-runtime-census.fk;
import form-stdlib/bml/string-join.bml;
section [form.bml] {
 class Land {
  def ld-source() = "observe/land-run.bml";
  def ld-message-path() = ".form-heal/land-message.txt";
  def ld-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def ld-int(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : 0;
  def ld-paths(doc) = json-object-has?(doc, "paths") ? oh-values(json-array-elements(json-object-get(doc, "paths"))) : [];
  def ld-quote(s) = "'" ++ str-join-with(split-on(s, "'"), "'\\''") ++ "'";
  def ld-quoted(paths) = paths |> map(ld-quote);
  // git add stages nothing at all when one named path matches no file (fatal: pathspec did not match), so a path is
  // added when it is present, or tracked and gone (its removal is staged); any other is named and left unstaged
  def ld-has?(xs, x) = nil?(xs) ? false : ((String) xs[0] == x) || ld-has?(xs[1:], x);
  def ld-absent(paths) = filter(p => file_size(p) < 0, paths);
  def ld-tracked(absent) = nil?(absent) ? [] : filter(p => (Comparable) len(p) > 0, split-on(trim(host-exec("git ls-files -- " ++ str-join-with(ld-quoted(absent), " ") ++ " 2>/dev/null", "") ?? ""), "\n"));
  def ld-addable(paths) = append(filter(p => file_size(p) >= 0, paths), ld-tracked(ld-absent(paths)));
  def ld-unstaged(paths, addable) = filter(p => !ld-has?(addable, p), ld-absent(paths));
  def ld-unstaged-line(left) = nil?(left) ? "" : "[paths] neither present nor tracked, left unstaged: " ++ str-join-with(left, " ") ++ "\n";
  def ld-tail(text, n) = len(text) <= n ? text : substring(text, len(text) - n, len(text));
  def ld-planes(planes, rows) = nil?(planes) ? "" : "  " ++ planes[0] ++ "=" ++ fmrc-delta-plane-total(rows, planes[0]).str() ++ "\n" ++ ld-planes(planes[1:], rows);
  def ld-plane-names() = ["stdio", "filesystem", "local-process", "network-address-unknown", "mesh"];
  // optional "files": [{"path","text"}] are written whole and "append":
  // [{"path","text"}] are appended, natively, before the witness runs; so a
  // small movement needs no host write at all.
  def ld-nodes(doc, key) = json-object-has?(doc, key) ? json-array-elements(json-object-get(doc, key)) : [];
  def ld-write-all(nodes) { nil?(nodes) ? 0 : ld-write-one(nodes[0], nodes[1:]); }
  def ld-write-one(node, rest) { let w = write_file_text(ld-str(node, "path"), ld-str(node, "text")); 1 + ld-write-all(rest); }
  def ld-append-all(nodes) { nil?(nodes) ? 0 : ld-append-one(nodes[0], nodes[1:]); }
  def ld-append-one(node, rest) { let a = fhn-append(ld-str(node, "path"), ld-str(node, "text")); 1 + ld-append-all(rest); }
  // optional "edits": [{"path","old","new"}] replace one exact occurrence of
  // old with new; an old that is absent or not unique is a miss, and a miss
  // holds the landing. Optional "restart": "origin/main" first fetches main,
  // restarts the current branch on it (keeping uncommitted work), and pushes
  // the restarted branch with force-with-lease: the move after a merge.
  def ld-edit-all(nodes, misses) { nil?(nodes) ? misses : ld-edit-all(nodes[1:], misses + ld-edit-one(nodes[0])); }
  def ld-edit-one(node) {
   let path = ld-str(node, "path");
   let old = ld-str(node, "old");
   let text = fhn-read(path);
   let at = str_find(text, old, 0);
   let again = at < 0 ? -1 : str_find(text, old, at + 1);
   (at < 0) || ((again >= 0) || ((String) old == "")) ? 1 : ld-edit-write(path, text, at, old, ld-str(node, "new"));
  }
  def ld-edit-write(path, text, at, old, new) {
   let w = write_file_text(path, substring(text, 0, at) ++ new ++ substring(text, at + len(old), len(text)));
   0;
  }
  def ld-restart(base) = (String) base == "" ? "" : host-exec("git fetch origin main 2>&1 | tail -1 && git checkout -B \"$(git rev-parse --abbrev-ref HEAD)\" " ++ base ++ " 2>&1 | tail -1 && git push --force-with-lease -u origin HEAD 2>&1 | tail -1", "");
  // A landing that is held says so as a reading with the reason it was held and
  // what would carry it: the hold is a signal into the body, not a silent stop.
  // A push refused for want of a fast-forward is not a reason to hold: origin
  // holds commits this checkout does not, and the body can go and get them. The
  // reunion rebases onto origin, settles its own ledgers as the union of both
  // banks, redraws what is drawn from them, and pushes the new ground. This is
  // not the failed push repeated — that push could not have succeeded, and the
  // ground under this one is different.
  def ld-behind?(pushed) = str_find(pushed, "fast-forward", 0) >= 0;
  def ld-redraw() = "./fkwu observe/rent-ladder-page-run.bml </dev/null >/dev/null 2>&1";
  def ld-draws() = ["docs/rent-ladder.html"];
  def ld-reunion(pushed) = !ld-behind?(pushed) ? [pushed, "not-asked"] : ld-reunited(fcr-reunion(ld-redraw(), ld-draws()));
  def ld-reunited(r) = (String) r[0] == "joined" ? [ld-push-line(r[2]), "joined"] : ["[push] exit=1 the rows did not join", r[1]];
  def ld-push-line(out) = str_find(out, "[ok] exit=0", 0) >= 0 ? "[push] exit=0 after the reunion" : "[push] exit=1 " ++ trim(out);
  def ld-organ() = "landing";
  def ld-gates-ok(status, output) = ((String) status == "0") && (str_find(output, " refused=0 ", 0) >= 0);
  def ld-gates() {
   let root = fhn-root();
   (String) root == "" ? ["refused:gate-root", "", ""] : ld-gates-open(root);
  }
  def ld-gates-open(root) {
   let spool = fhn-at(root, ".form-heal");
   let made = fs_mkdir(spool);
   let job = fhn-unique(spool, "landing-gates-");
   nothing?(job) ? ["refused:gate-evidence", "", ""] : ld-gates-run(root, job);
  }
  def ld-gates-run(root, job) {
   let saved = fhn-write-json(fhn-at(job, "snapshot.json"), json-node-object([fhn-s("root", root)]));
   let status = fhn-run(job, "gates", 0, "root", "/dev/null", ["./fkwu", "gate/drift-gates-run.bml"]);
   let output = (String) fhn-read(fhn-stage-path(job, "gates", ".out")) + fhn-read(fhn-stage-path(job, "gates", ".err"));
   [status, output, job];
  }
  // The witness: the named command runs in its own subshell with its stderr
  // folded in, and its exit is the last line it leaves (the carrier shape of
  // gate/drift-gates.bml dg-wrap). The exit is read after the LAST mark, so a
  // witness that prints the mark itself cannot answer for its own exit. No
  // witness named reads [shown "", exit nothing] and holds nothing; a named
  // witness whose launch vanished (host-exec answers nothing) has no exit, and
  // an exit that did not arrive is never a pass.
  def ld-witness-mark() = "[witness] exit=";
  def ld-witness-wrap(witness) = "( " ++ witness ++ " ) 2>&1; printf '\\n" ++ ld-witness-mark() ++ "%s\\n' $?";
  def ld-rfind(s, needle, from, last) {
   let i = str_find(s, needle, from);
   i < 0 ? last : ld-rfind(s, needle, i + 1, i);
  }
  def ld-digit?(c) = (ord(c) >= 48) && (ord(c) <= 57);
  def ld-digits(s, i, acc, seen) = i >= len(s) ? (seen > 0 ? acc : nothing()) : ld-digit?(char_at(s, i)) ? ld-digits(s, i + 1, (acc * 10) + (ord(char_at(s, i)) - 48), 1) : (seen > 0 ? acc : nothing());
  def ld-witness-rc(out) {
   let at = ld-rfind(out, ld-witness-mark(), 0, 0 - 1);
   at < 0 ? nothing() : ld-digits(out, at + len(ld-witness-mark()), 0, 0);
  }
  def ld-witness-read(out) = nothing?(out) ? ["[witness] the launch vanished: no exit arrived", nothing()] : [out, ld-witness-rc(out)];
  def ld-witness-run(witness) = (String) witness == "" ? ["", nothing()] : ld-witness-read(host-exec(ld-witness-wrap(witness), ""));
  def ld-witness-ok?(witness, rc) = ((String) witness == "") || ((!nothing?(rc)) && ((Comparable) rc == 0));
  def ld-witness-said(rc) = nothing?(rc) ? "no exit arrived" : "exit " ++ rc.str();
  def ld-held-why(witnessOk, green, misses, paths, subject, ready, commitOk, pushOk) = ready && (commitOk && pushOk) ? "landed" : ready && commitOk ? "push-did-not-reach-origin" : ready ? "the-commit-did-not-take" : !witnessOk ? "the-witness-refused" : !green ? "a-gate-refused" : misses > 0 ? "an-edit-found-no-place" : nil?(paths) ? "no-paths" : (String) subject == "" ? "no-subject" : "held";
  def ld-landing-line(why, witnessRc) = (String) why == "landed" ? "landed" : (String) why == "push-did-not-reach-origin" ? "held: the push did not reach origin" : (String) why == "the-commit-did-not-take" ? "held: the commit did not take" : (String) why == "the-witness-refused" ? "held: the witness refused (" ++ ld-witness-said(witnessRc) ++ ")" : (String) why == "a-gate-refused" ? "held: a gate refused" : (String) why == "an-edit-found-no-place" ? "held: an edit missed" : "held: no paths or no subject";
  def ld-health(subject, why, landed) = oh-reading(ld-organ(), (String) subject == "" ? "landing" : subject, "origin", json-node-string("landed"), json-node-string(why), json-node-int(landed ? 1 : 0), landed ? [] : [oh-need(why, json-node-string(ld-message-path()))], ["retry-push", "heal-the-tree", "name-the-paths"], oh-reference(ld-message-path()));
  // Answers list(report, readings): the landing's own report text and the health
  // it spoke. A caller already inside a census window lands without a child
  // kernel; git is the crossing the landing needs.
  def ld-land(request) {
   let restarted = ld-restart(ld-str(request, "restart"));
   let written = ld-write-all(ld-nodes(request, "files"));
   let appendedFiles = ld-append-all(ld-nodes(request, "append"));
   let misses = ld-edit-all(ld-nodes(request, "edits"), 0);
   let witness = ld-str(request, "witness");
   let paths = ld-paths(request);
   let subject = ld-str(request, "subject");
   let witnessRun = ld-witness-run(witness);
   let witnessOut = witnessRun[0];
   let witnessRc = witnessRun[1];
   let witnessOk = ld-witness-ok?(witness, witnessRc);
   let gateRun = ld-gates();
   let gateStatus = gateRun[0];
   let gates = gateRun[1];
   let green = ld-gates-ok(gateStatus, gates);
   let ready = witnessOk && (green && (((Comparable) misses == 0) && ((!nil?(paths)) && (!((String) subject == "")))));
   // the message lives under .form-heal, which a fresh checkout does not have yet: make it before writing
   let spool = fs_mkdir(".form-heal");
   let saved0 = write_file_text(ld-message-path(), subject ++ "\n\n" ++ ld-str(request, "body") ++ "\n");
   let saved = saved0 ?? 0;
   let addable = ready ? ld-addable(paths) : [];
   let added = ready ? ld-unstaged-line(ld-unstaged(paths, addable)) ++ (nil?(addable) ? "" : host-exec("git add " ++ str-join-with(ld-quoted(addable), " ") ++ " 2>&1", "") ?? "") : "";
   let committed0 = ready ? host-exec("out=$(git -c user.name=Claude -c user.email=noreply@anthropic.com commit -q -F " ++ ld-message-path() ++ " 2>&1); code=$?; printf '[commit] exit=%s %s\\n' \"$code\" \"$(git log --oneline -1)\"", "") : "";
   let committed = committed0 ?? "";
   let commitOk = str_find(committed, "[commit] exit=0", 0) >= 0;
   // the push answers with its own exit: a commit that did not reach origin is held, never landed
   let pushed0 = commitOk ? host-exec("out=$(git push -u origin HEAD 2>&1); code=$?; printf '[push] exit=%s %s\\n' \"$code\" \"$(printf '%s' \"$out\" | tail -n 1)\"", "") : "";
   let pushed = pushed0 ?? "";
   let pushFirst = str_find(pushed, "[push] exit=0", 0) >= 0;
   let rejoined = pushFirst ? [pushed, "not-asked"] : ld-reunion(pushed);
   let pushed2 = rejoined[0];
   let reunion = rejoined[1];
   let pushOk = str_find(pushed2, "[push] exit=0", 0) >= 0;
   // optional "main": 1 carries a landed commit onto main as a fast-forward, so a landing no session watches still
   // reaches main; a main that moved meanwhile answers non-fast-forward, and the branch landing stands
   let mained0 = pushOk && ((Comparable) ld-int(request, "main") == 1) ? host-exec("out=$(git push origin HEAD:main 2>&1); code=$?; printf '[main] exit=%s %s\\n' \"$code\" \"$(printf '%s' \"$out\" | tail -n 1)\"", "") : "";
   let mained = mained0 ?? "";
   let why = ld-held-why(witnessOk, green, misses, paths, subject, ready, commitOk, pushOk);
   let readings = oh-voice-all([ld-health(subject, why, ready && (commitOk && pushOk))]);
   [((String) witness == "" ? "" : "[witness] " ++ witness ++ "\n" ++ witnessOut ++ "\n") ++ ((String) restarted == "" ? "" : "[restart] " ++ restarted ++ "\n") ++ "[files] written=" ++ written.str() ++ " appended=" ++ appendedFiles.str() ++ " edit-misses=" ++ misses.str() ++ "\n" ++ "[gates] exit=" ++ gateStatus ++ " evidence=" ++ gateRun[2] ++ "\n" ++ ld-tail(gates, 120) ++ "\n" ++ "[landing] " ++ ld-landing-line(why, witnessRc) ++ "\n" ++ (ready ? added ++ committed ++ "\n" ++ pushed2 ++ "\n" ++ ((String) reunion == "not-asked" ? "" : "[reunion] " ++ reunion ++ "\n") ++ mained : ""), readings];
  }
  def ld-run() {
   let window = fmrc-open("land", "witness gates commit push", ld-source(), 1, 1);
   let report = ld-land(parse-json("land-request", read_line()))[0];
   let result = fmrc-close(window, str_find(report, "[landing] landed", 0) >= 0 ? "landed" : "held", ld-source(), 2, 1);
   let rows = fmrc-result-deltas(result);
   print_str(report ++ "[crossings of this call] census-status=" ++ fmrc-result-status(result) ++ " dispatches=" ++ fmrc-delta-total(rows).str() ++ "\n" ++ ld-planes(ld-plane-names(), rows));
  }
 }
}
