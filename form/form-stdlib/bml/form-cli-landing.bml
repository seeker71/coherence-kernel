// The landing: what a movement writes, gates and carries to origin.
// one native call closes a movement: witness, gates, commit, push.
//
// stdin: one JSON object
//   {"witness":"<a command to run and show, or empty>",
//    "paths":["file", ...], "subject":"<commit subject>", "body":"<commit body>",
//    "restart":"origin/main" (optional), "main":1 (optional: the landed commit also fast-forwards main)}
// The witness runs first and its output is shown. The drift gates run next as
// a child fkwu; a refused gate lands nothing. Then host git adds the named
// paths, commits with exactly subject, blank line, body, and pushes the
// current branch to its own name on origin; the push answers with its own
// exit, so a commit that did not reach origin reads held, never landed. Every crossing to a child process
// happens inside this call's census window and is printed at the end, so what
// left the body is counted, never hidden. The message file lives under
// .form-heal, which git forgets.
// preflight-exec: forbidden
// preludes: form-stdlib/bml/form-cli-reunion.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml observe/form-membrane-runtime-census.fk
section [form.bml] {
 class Land {
  def ld-source() = "observe/land-run.bml";
  def ld-message-path() = ".form-heal/land-message.txt";
  def ld-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def ld-int(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : 0;
  def ld-paths(doc) = json-object-has?(doc, "paths") ? oh-values(json-array-elements(json-object-get(doc, "paths"))) : list();
  def ld-join(parts, sep) = nil?(parts) ? "" : nil?(tail(parts)) ? head(parts) : (head(parts) ++ sep ++ ld-join(tail(parts), sep));
  def ld-quote(s) = "'" ++ ld-join(split-on(s, "'"), "'\\''") ++ "'";
  def ld-quoted(paths) = nil?(paths) ? list() : cons(ld-quote(head(paths)), ld-quoted(tail(paths)));
  def ld-tail(text, n) = str_len(text) <= n ? text : substring(text, str_len(text) - n, str_len(text));
  def ld-planes(planes, rows) = nil?(planes) ? "" : ("  " ++ head(planes) ++ "=" ++ int_to_str(fmrc-delta-plane-total(rows, head(planes))) ++ "\n" ++ ld-planes(tail(planes), rows));
  def ld-plane-names() = list("stdio", "filesystem", "local-process", "network-address-unknown", "mesh");
  // optional "files": [{"path","text"}] are written whole and "append":
  // [{"path","text"}] are appended, natively, before the witness runs; so a
  // small movement needs no host write at all.
  def ld-nodes(doc, key) = json-object-has?(doc, key) ? json-array-elements(json-object-get(doc, key)) : list();
  def ld-write-all(nodes) { nil?(nodes) ? 0 : ld-write-one(head(nodes), tail(nodes)); }
  def ld-write-one(node, rest) { let w = write_file_text(ld-str(node, "path"), ld-str(node, "text")); 1 + ld-write-all(rest); }
  def ld-append-all(nodes) { nil?(nodes) ? 0 : ld-append-one(head(nodes), tail(nodes)); }
  def ld-append-one(node, rest) { let a = fhn-append(ld-str(node, "path"), ld-str(node, "text")); 1 + ld-append-all(rest); }
  // optional "edits": [{"path","old","new"}] replace one exact occurrence of
  // old with new; an old that is absent or not unique is a miss, and a miss
  // holds the landing. Optional "restart": "origin/main" first fetches main,
  // restarts the current branch on it (keeping uncommitted work), and pushes
  // the restarted branch with force-with-lease: the move after a merge.
  def ld-edit-all(nodes, misses) { nil?(nodes) ? misses : ld-edit-all(tail(nodes), misses + ld-edit-one(head(nodes))); }
  def ld-edit-one(node) {
   let path = ld-str(node, "path");
   let old = ld-str(node, "old");
   let text = fhn-read(path);
   let at = str_find(text, old, 0);
   let again = at < 0 ? -1 : str_find(text, old, at + 1);
   (at < 0) || ((again >= 0) || ((String) old == "")) ? 1 : ld-edit-write(path, text, at, old, ld-str(node, "new"));
  }
  def ld-edit-write(path, text, at, old, new) {
   let w = write_file_text(path, substring(text, 0, at) ++ new ++ substring(text, at + str_len(old), str_len(text)));
   0;
  }
  def ld-restart(base) = (String) base == "" ? "" : host-exec("git fetch origin main 2>&1 | tail -1 && git checkout -B \"$(git rev-parse --abbrev-ref HEAD)\" " ++ base ++ " 2>&1 | tail -1 && git push --force-with-lease -u origin HEAD 2>&1 | tail -1", "");
  // A landing that is held says so as a reading with the reason it was held and
  // what would carry it: the hold is a signal into the body, not a silent stop.
  // A push refused for want of a fast-forward is not a reason to hold: origin
  // holds commits this checkout does not, and the body can go and get them. The
  // reunion rebases onto origin, settles its own ledgers as the union of both
  // banks, redraws what is drawn from them, and pushes the new ground. This is
  // not the failed push repeated — that push could not have succeeded, and the
  // ground under this one is different.
  def ld-behind?(pushed) = str_find(pushed, "fast-forward", 0) >= 0;
  def ld-redraw() = "./fkwu observe/rent-ladder-page-run.bml </dev/null >/dev/null 2>&1";
  def ld-draws() = list("docs/rent-ladder.html");
  def ld-reunion(pushed) = !ld-behind?(pushed) ? list(pushed, "not-asked") : ld-reunited(fcr-reunion(ld-redraw(), ld-draws()));
  def ld-reunited(r) = (String) r[0] == "joined" ? list(ld-push-line(r[2]), "joined") : list("[push] exit=1 the rows did not join", r[1]);
  def ld-push-line(out) = str_find(out, "[ok] exit=0", 0) >= 0 ? "[push] exit=0 after the reunion" : ("[push] exit=1 " ++ trim(out));
  def ld-organ() = "landing";
  def ld-gates-ok(status, output) = ((String) status == "0") && (str_find(output, " refused=0 ", 0) >= 0);
  def ld-gates() {
   let root = fhn-root();
   (String) root == "" ? list("refused:gate-root", "", "") : ld-gates-open(root);
  }
  def ld-gates-open(root) {
   let spool = fhn-at(root, ".form-heal");
   let made = fs_mkdir(spool);
   let job = fhn-unique(spool, "landing-gates-");
   nothing?(job) ? list("refused:gate-evidence", "", "") : ld-gates-run(root, job);
  }
  def ld-gates-run(root, job) {
   let saved = fhn-write-json(fhn-at(job, "snapshot.json"), json-node-object(list(fhn-s("root", root))));
   let status = fhn-run(job, "gates", 0, "root", "/dev/null", list("./fkwu", "gate/drift-gates-run.bml"));
   let output = fhn-read(fhn-stage-path(job, "gates", ".out")) ++ fhn-read(fhn-stage-path(job, "gates", ".err"));
   list(status, output, job);
  }
  def ld-held-why(green, misses, paths, subject, ready, commitOk, pushOk) = ready && (commitOk && pushOk) ? "landed" : ready && commitOk ? "push-did-not-reach-origin" : ready ? "the-commit-did-not-take" : !green ? "a-gate-refused" : misses > 0 ? "an-edit-found-no-place" : nil?(paths) ? "no-paths" : (String) subject == "" ? "no-subject" : "held";
  def ld-health(subject, why, landed) = oh-reading(ld-organ(), (String) subject == "" ? "landing" : subject, "origin", json-node-string("landed"), json-node-string(why), json-node-int(landed ? 1 : 0), landed ? list() : list(oh-need(why, json-node-string(ld-message-path()))), list("retry-push", "heal-the-tree", "name-the-paths"), oh-reference(ld-message-path()));
  // Answers list(report, readings): the landing's own report text and the health
  // it spoke. A caller already inside a census window lands without a child
  // kernel; git is the crossing the landing needs.
  def ld-land(request) {
   let restarted = ld-restart(ld-str(request, "restart"));
   let written = ld-write-all(ld-nodes(request, "files"));
   let appendedFiles = ld-append-all(ld-nodes(request, "append"));
   let misses = ld-edit-all(ld-nodes(request, "edits"), 0);
   let witness = ld-str(request, "witness");
   let paths = ld-paths(request);
   let subject = ld-str(request, "subject");
   let witnessOut0 = (String) witness == "" ? "" : host-exec(witness ++ " 2>&1", "");
   let witnessOut = witnessOut0 ?? "";
   let gateRun = ld-gates();
   let [gateStatus, gates] = gateRun;
   let green = ld-gates-ok(gateStatus, gates);
   let ready = green && (((Comparable) misses == 0) && ((!nil?(paths)) && (!((String) subject == ""))));
   // the message lives under .form-heal, which a fresh checkout does not have yet: make it before writing
   let spool = fs_mkdir(".form-heal");
   let saved0 = write_file_text(ld-message-path(), subject ++ "\n\n" ++ ld-str(request, "body") ++ "\n");
   let saved = saved0 ?? 0;
   let added = ready ? host-exec("git add " ++ ld-join(ld-quoted(paths), " ") ++ " 2>&1", "") : "";
   let committed0 = ready ? host-exec("out=$(git -c user.name=Claude -c user.email=noreply@anthropic.com commit -q -F " ++ ld-message-path() ++ " 2>&1); code=$?; printf '[commit] exit=%s %s\\n' \"$code\" \"$(git log --oneline -1)\"", "") : "";
   let committed = committed0 ?? "";
   let commitOk = str_find(committed, "[commit] exit=0", 0) >= 0;
   // the push answers with its own exit: a commit that did not reach origin is held, never landed
   let pushed0 = commitOk ? host-exec("out=$(git push -u origin HEAD 2>&1); code=$?; printf '[push] exit=%s %s\\n' \"$code\" \"$(printf '%s' \"$out\" | tail -n 1)\"", "") : "";
   let pushed = pushed0 ?? "";
   let pushFirst = str_find(pushed, "[push] exit=0", 0) >= 0;
   let rejoined = pushFirst ? list(pushed, "not-asked") : ld-reunion(pushed);
   let [pushed2, reunion] = rejoined;
   let pushOk = str_find(pushed2, "[push] exit=0", 0) >= 0;
   // optional "main": 1 carries a landed commit onto main as a fast-forward, so a landing no session watches still
   // reaches main; a main that moved meanwhile answers non-fast-forward, and the branch landing stands
   let mained0 = pushOk && ((Comparable) ld-int(request, "main") == 1) ? host-exec("out=$(git push origin HEAD:main 2>&1); code=$?; printf '[main] exit=%s %s\\n' \"$code\" \"$(printf '%s' \"$out\" | tail -n 1)\"", "") : "";
   let mained = mained0 ?? "";
   let why = ld-held-why(green, misses, paths, subject, ready, commitOk, pushOk);
   let readings = oh-voice-all(list(ld-health(subject, why, ready && (commitOk && pushOk))));
   list(((String) witnessOut == "" ? "" : ("[witness] " ++ witness ++ "\n" ++ witnessOut ++ "\n")) ++ ((String) restarted == "" ? "" : ("[restart] " ++ restarted ++ "\n")) ++ "[files] written=" ++ int_to_str(written) ++ " appended=" ++ int_to_str(appendedFiles) ++ " edit-misses=" ++ int_to_str(misses) ++ "\n" ++ "[gates] exit=" ++ gateStatus ++ " evidence=" ++ gateRun[2] ++ "\n" ++ ld-tail(gates, 120) ++ "\n" ++ "[landing] " ++ (ready && (commitOk && pushOk) ? "landed" : ready && commitOk ? "held: the push did not reach origin" : ready ? "held: the commit did not take" : !green ? "held: a gate refused" : misses > 0 ? "held: an edit missed" : "held: no paths or no subject") ++ "\n" ++ (ready ? (added ++ committed ++ "\n" ++ pushed2 ++ "\n" ++ ((String) reunion == "not-asked" ? "" : ("[reunion] " ++ reunion ++ "\n")) ++ mained) : ""), readings);
  }
  def ld-run() {
   let window = fmrc-open("land", "witness gates commit push", ld-source(), 1, 1);
   let report = head(ld-land(parse-json("land-request", read_line())));
   let result = fmrc-close(window, str_find(report, "[landing] landed", 0) >= 0 ? "landed" : "held", ld-source(), 2, 1);
   let rows = fmrc-result-deltas(result);
   print_str(report ++ "[crossings of this call] census-status=" ++ fmrc-result-status(result) ++ " dispatches=" ++ int_to_str(fmrc-delta-total(rows)) ++ "\n" ++ ld-planes(ld-plane-names(), rows));
  }
 }
}
