// host-walk-self.bml — after the register, the night asks the voice about itself: one frontier word from a finding (observe/self-distill-run.bml) and, at its cadence, the pinned review cases (observe/self-review-run.bml).
// Each is a child through host-child.bml under its own bound and never past the window; the movement that lands what they wrote comes after. Yields to the host's other GPU doors first, as a reading does. Night only.
// PROOF: form-stdlib/tests/host-walk-learn-band.bml (its place in the night, the requests, the refusals, the bound); a safe start skips each (hw-safe-skips?, host-walk-began.bml).
import form-stdlib/bml/host-walk-learn.bml;
section [form.bml] {
 class HostWalkSelf {
  def hw-distill-door() = "observe/self-distill-run.bml";
  def hw-review-door() = "observe/self-review-run.bml";
  def hw-distill-bound-ms() = 600000;
  def hw-review-bound-ms() = 1500000;
  // the earlier of the step's own bound and the window's end
  def hw-self-until(until, now, bound) = until < now + bound ? until : now + bound;
  def hw-self-request(until) = json-emit(json-node-object([fhn-n("until_ms", until)])) ++ "\n";
  def hw-distill-at(io, door, until) { let by = hw-self-until(until, host_monotonic_ms(), hw-distill-bound-ms()); hw-learn-door(io, "distill", door, hw-self-request(by), by, run => hw-learn-lines("distill", run, ["[self-distill] "])); }
  def hw-review-at(io, door, until) { let by = hw-self-until(until, host_monotonic_ms(), hw-review-bound-ms()); hw-learn-door(io, "review", door, hw-self-request(by), by, run => hw-learn-lines("review", run, ["[self-review] reads", "[self-review] cadence", "[self-review] the window"])); }
  def hw-distill(until) {
   let said = hw-say(hw-yield(until));
   hw-distill-at(hch-dir(), hw-distill-door(), until);
  }
  def hw-self-review(until) {
   let said = hw-say(hw-yield(until));
   hw-review-at(hch-dir(), hw-review-door(), until);
  }
 }
}
