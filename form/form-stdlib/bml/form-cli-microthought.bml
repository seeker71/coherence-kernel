// Native source/node access and model-authored numeric recipes run between predictions
// in the same KV stream. Form observations remain distinct from model output.
// The owner retains recipes, RAM pipelines, scalar/vector buffers and node refs.
// Control bytes are model output; returned values and lifecycle events are Form evidence.
// Affine recipes born here run on Metal; every other verb of form-token-grammar.bml (eval,
// knowledge-query, node-*, BML recipes) runs in the owner's token session, in the same stream.
// A choice may name both: each address runs on the carrier that holds it, in order.
import form-stdlib/bml/form-token-grammar.bml;
import form-stdlib/form-recipe-birth-token.fk;
import form-stdlib/form-cli-recipe-exec-session.fk;
import form-stdlib/bml/metal-jit.bml;
import control/offer-ack-core.fk;
import observe/framebuffer-runtime-observation.fk;
import form-stdlib/line-grammar.fk;
import form-stdlib/bml/form-cli-reasoning-budget.bml;
import form-stdlib/form-cli-nodeid-knowledge-session.fk;
import form-stdlib/form-nodeid-knowledge-routed-query.fk;
import form-stdlib/bml/form-cli-bml-recipe.bml;
section [form.bml] {
 class FormCliMicrothought {
  def fmc-open(reserve) = fmc-lane-tokens(fmc-open-with-knowledge(reserve,fknsc-public-context(fhcs-default-root(),fknq-default-artifact(),1,fknq-max-frame-bytes()),fknqr-public-strict-executor));
  // The reasoning lane's controls build in the lanes' workspace (the reasoning lineage, or the
  // lineage the coding lane bound), counted per owner; an owner opened directly keeps its own.
  def fmc-lane-tokens(owner) {
   record_set(owner,"tokens",ftv-session-in(ftv-ws(ftg-lane-session("reasoning"))));
   owner;
  }
  def fmc-open-with-knowledge(reserve,context,executor) = record_new(0,"recipes",record_new(0),"pipelines",mj-thought-table(),"addresses",[],"buffer",0,"vectors",[0,0,0],"pending",0,"uncertain",0,"answer-reserve",0,"yield-session",nothing(),"frames",[],"injections",[],"injected",[],"window","","reserve",reserve,"crossings",0,"executions",0,"admissions",0,"reuses",0,"knowledge-context",context,"knowledge-executor",executor,"knowledge-lookups",0,"tokens",ftv-session(),"released",0,"last",["nothing","unrequested",0,0,""],"events",[],"trace",("microthought:" + host_pid().str()));
  def fmc-get(owner,key) = record_get(owner,key);
  def fmc-set(owner,key,value) = record_set(owner,key,value);
  def fmc-add(owner,key) = fmc-set(owner,key,fmc-get(owner,key) + 1);
  def fmc-stage(owner,stage,before,units,outcome) = fbro-stage-observed-stream(fmc-get(owner,"trace"),stage,"decode","native-microthought","same-kv","model-request","local",before,fbro-snapshot(),"units",units,outcome,"form/form-stdlib/bml/form-cli-microthought.bml",1,1);
  def fmc-record(owner,result) {
   fmc-set(owner,"last",result);
   fmc-set(owner,"events",cons(result,fmc-get(owner,"events")));
   result;
  }
  def fmc-result(owner,status,reason,value,present,address) = fmc-record(owner,[status,reason,value,present,address]);
  def fmc-render(result) = len(result) > 5 ? result[5] : ((result[0] == "ready" ? ("recipe=" + result[4]) : result[0] == "value" ? ("value=" + result[2].str()) : (result[0] + ("=" + result[1]))) + ";");
  def fmc-knowledge(owner,frame) {
   let before = fbro-snapshot();
   let transfer = fknsc-feed(fmc-get(owner,"knowledge-context"),fmc-get(owner,"knowledge-executor"),fknsc-fresh(),frame);
   let cursor = fknsc-transfer-cursor(transfer);
   fmc-set(owner,"knowledge-lookups",fmc-get(owner,"knowledge-lookups") + fknsc-lookup-count(cursor));
   let result = fmc-record(owner,[fknsc-status(cursor),fknsc-reason(cursor),0,0,"",fknsc-transfer-injected(transfer)]);
   fmc-stage(owner,"substrate-lookup",before,fknsc-lookup-count(cursor),result[0]); result;
  }
  def fmc-birth(owner,frame,payload) {
   if str_find(payload,"bml-f32;expr=",0) == 0 then {
    let before = fbro-snapshot(); let recipe = fmr-parse(substring(payload,len("bml-f32;expr="),len(payload)));
    let ready = !nothing?(recipe); let address = ready ? frex-node-coordinate(recipe) : "";
    if ready then fmc-set(fmc-get(owner,"recipes"),address,recipe) else 0;
    let result = fmc-result(owner,ready ? "ready" : "nothing",ready ? "bml-recipe-born" : "bml-expression-unsupported-or-incomplete",0,0,address);
    fmc-stage(owner,"bml-recipe-birth",before,len(payload),result[0]); result;
   } else fmc-affine-birth(owner,frame);
  }
  def fmc-affine-birth(owner,frame) {
   let before = fbro-snapshot(); let born = frbt-parse-stream(frame);
   let ready = frbt-result-status(born) == "ready";
   let address = ready ? frex-node-coordinate(frbt-result-recipe(born)) : "";
   if ready then fmc-set(fmc-get(owner,"recipes"),address,frbt-result-recipe(born)) else 0;
   let result = fmc-result(owner,ready ? "ready" : frbt-result-status(born),frbt-result-reason(born),0,0,address);
   fmc-stage(owner,"recipe-birth",before,len(frame),result[0]); result;
  }
  def fmc-pipeline(owner,recipe,address) {
   let table = fmc-get(owner,"pipelines"); let found = mj-thought-recall(table,address);
   if (found > 0) then { fmc-add(owner,"reuses"); found; } else {
    let before = fbro-snapshot(); let vector = fmr-recipe?(recipe); let source = vector ? fmr-msl(recipe) : frexl-msl(recipe);
    let admitted = mj-thought(table,address,source,vector ? fmr-kernel() : frexl-kernel-name(),0,"");
    let handle = nothing?(admitted) ? 0 : mj-thought-recall(table,address);
    if (handle > 0) then { fmc-add(owner,"admissions"); fmc-set(owner,"addresses",cons(address,fmc-get(owner,"addresses"))); } else 0;
    fmc-stage(owner,"metal-jit",before,len(source),handle > 0 ? "admitted" : "refused"); handle;
   };
  }
  def fmc-buffer(owner) {
   let held = fmc-get(owner,"buffer");
   if (held > 0) then held else { let fresh = metal_buf_alloc(4); if (fresh > 0) then fmc-set(owner,"buffer",fresh) else 0; fresh; };
  }
  def fmc-execute(owner,recipe,input,carrier,address) {
   let expected = frexl-recipe-expected(recipe,input);
   if (!frexl-i32?(input) || !frexl-i32?(expected)) then fmc-result(owner,"nothing","signed-i32-overflow",0,0,address)
   else if (!(carrier == "auto" || carrier == "metal")) then fmc-result(owner,"nothing","carrier-unavailable",0,0,address)
   else {
    let pipeline = fmc-pipeline(owner,recipe,address);
    if (pipeline <= 0) then fmc-result(owner,"failure","metal-admission",0,0,address) else {
     let before = fbro-snapshot(); let buffer = fmc-buffer(owner);
     let wrote = buffer > 0 ? metal_buf_write(buffer,0,frexl-i32-bytes(input)) : 0;
     let enqueued = wrote == 4 ? metal_enqueue(pipeline,md-bind([buffer],[]),1) : 0;
     if (enqueued == 1) then fmc-set(owner,"pending",1) else 0;
     let synced = enqueued == 1 ? metal_sync() : 0;
     if (synced > 0) then fmc-set(owner,"pending",0) else if (enqueued == 1) then fmc-set(owner,"uncertain",1) else 0;
     let bytes = synced > 0 ? metal_buf_read(buffer,0,4) : "";
     let present = len(bytes) == 4; let value = present ? frexl-i32-at(bytes,0) : 0;
     let good = present && value == expected;
     let reason = buffer <= 0 ? "buffer-admission" : wrote != 4 ? "buffer-write" : enqueued != 1 ? "enqueue" : synced <= 0 ? "synchronize" : !present ? "buffer-read" : !good ? "value-mismatch" : "metal-value";
     if good then fmc-add(owner,"executions") else 0;
     let result = fmc-result(owner,good ? "value" : "failure",reason,value,present,address);
     fmc-stage(owner,"metal-execute",before,4,result[0]); result;
    };
   };
  }
  // One alternative of a request. An address this owner admitted runs on Metal; any other
  // address runs in the owner's token session (a BML recipe, or nothing=unknown-recipe), so a
  // choice tries every address in order whichever carrier holds it.
  def fmc-attempt(owner,address,fields) {
   let recipes = fmc-get(owner,"recipes");
   fmc-set(owner,"last",["nothing","execution-unobserved",0,0,address]);
   let result = !record_has(recipes,address) ? fmc-token-at(owner,"recipe-exec",address + fields,address) : fmc-get(owner,"uncertain") ? fmc-result(owner,"failure","execution-state-unresolved",0,0,address) : {
    fmc-invoke(owner,record_get(recipes,address),address,split-on(fields,";"));
   };
   (result[0] == "value" || result[0] == "observed") ? result : nothing;
  }
  def fmc-invoke(owner,recipe,address,fields) {
   if (len(fields) != 3 || fields[0] != "") then fmc-result(owner,"nothing","field-shape",0,0,address) else {
    let inputField = fields[1]; let carrierField = fields[2];
    if (str_find(inputField,"input=",0) != 0 || str_find(carrierField,"carrier=",0) != 0) then fmc-result(owner,"nothing","request-fields",0,0,address) else {
     let input = substring(inputField,6,len(inputField)); let carrier = substring(carrierField,8,len(carrierField));
     fmr-recipe?(recipe) ? fmc-vector(owner,recipe,address,input,carrier) : !frex-input-text?(input) ? fmc-result(owner,"nothing","input-integer",0,0,address) : !frex-carrier?(carrier) ? fmc-result(owner,"nothing","carrier-choice",0,0,address) : fmc-execute(owner,recipe,str_to_int(input),carrier,address);
    };
   };
  }
  def fmc-vector(owner,recipe,address,input,carrier) {
   let parsed = fmr-inputs(input); let values = nothing?(parsed) ? [] : parsed[0];
   if nothing?(parsed) then fmc-result(owner,"nothing","bml-input-numbers",0,0,address)
   else if !(carrier == "auto" || carrier == "metal") then fmc-result(owner,"nothing","carrier-unavailable",0,0,address)
   else {
    let pipeline = fmc-pipeline(owner,recipe,address); let before = fbro-snapshot(); let buffers = pipeline > 0 ? fmr-buffers(owner,len(values)) : nothing;
    let wrote = nothing?(buffers) ? 0 : metal_buf_write(buffers[0],0,values);
    let enqueued = wrote == len(values) * fmr-word-bytes() ? metal_enqueue(pipeline,md-bind(buffers[0:2],[]),len(values)) : 0;
    if enqueued == 1 then fmc-set(owner,"pending",1) else 0;
    let synced = enqueued == 1 ? metal_sync() : 0;
    if synced > 0 then fmc-set(owner,"pending",0) else if enqueued == 1 then fmc-set(owner,"uncertain",1) else 0;
    let raw = synced > 0 ? metal_buf_read(buffers[1],0,len(values) * fmr-word-bytes()) : "";
    let finite = len(raw) == len(values) * fmr-word-bytes() && qlt-finite-bytes?(raw,0,len(values));
    let result = finite ? {
     let observed = fmr-read(raw,0,len(values),[]);
     let answer = fmc-value-node(parsed[1] ? observed : observed[0]);
     let text = ftv-value-result(json-emit-precise(answer));
     let arrived = ftg-result-kind(text) == "value";
     fmc-add(owner,"executions"); fmc-record(owner,[arrived ? "value" : "nothing",arrived ? "bml-metal-value" : ftg-result-body(text),parsed[1] ? observed : observed[0],1,address,text]);
    } : fmc-result(owner,"failure",pipeline <= 0 ? "metal-admission" : nothing?(buffers) ? "vector-buffer-admission" : enqueued != 1 ? "vector-enqueue" : synced <= 0 ? "synchronize" : "nonfinite-or-incomplete-vector",0,0,address);
    fmc-stage(owner,"bml-metal-execute",before,len(values),result[0]); result;
   };
  }
  def fmc-request(owner,kind,payload) {
   let split = str_find(payload,";",0);
   if (split < 1) then fmc-result(owner,"nothing","request-fields",0,0,"") else {
    let addresses = fmc-addresses(payload); let fields = substring(payload,split,len(payload));
    if (kind == "recipe-exec" && len(addresses) != 1) then fmc-result(owner,"nothing","exec-requires-one-recipe",0,0,"") else {
     let before = fbro-snapshot();
     let selected = choice(addresses |> map(address => ignored => fmc-attempt(owner,address,fields)),0);
     let result = nothing?(selected) ? fmc-get(owner,"last") : selected;
     fmc-stage(owner,"choice",before,len(addresses),result[0]); result;
    };
   };
  }
  def fmc-action(owner,kind,frame,payload) = fmc-get(owner,"released") ? fmc-result(owner,"nothing","microthought-owner-released",0,0,"") : kind == "nodeid-knowledge-query" ? fmc-knowledge(owner,frame) : !fmc-metal?(owner,kind,payload) ? fmc-token(owner,kind,payload) : kind == "recipe-birth" ? fmc-birth(owner,frame,payload) : fmc-request(owner,kind,payload);
  def fmc-addresses(payload) {
   let split = str_find(payload,";",0);
   split < 1 ? [] : map(a => trim(a),split-on(substring(payload,0,split),","));
  }
  // The owner's request path carries affine births and any request naming an address this owner
  // admitted; fmc-attempt routes each of its addresses to the carrier that holds it.
  def fmc-metal?(owner,kind,payload) {
   let addresses = fmc-addresses(payload);
   if kind == "recipe-birth" then ftv-starts?(payload,"affine-i32;") || ftv-starts?(payload,"bml-f32;expr=")
   else if (kind == "recipe-exec") || (kind == "choice") then any?(a => record_has(fmc-get(owner,"recipes"),a),addresses)
   else 0;
  }
  def fmc-token(owner,kind,payload) = fmc-token-at(owner,kind,payload,"");
  def fmc-token-at(owner,kind,payload,address) {
   let before = fbro-snapshot();
   let text = ftg-observe-with(fmc-get(owner,"tokens"),kind,payload);
   let status = ftg-result-kind(text);
   let arrived = oh-has(["value","recipe","node"],status);
   let value = record_get(fmc-get(owner,"tokens"),"observed");
   if arrived && (kind == "recipe-exec" || kind == "choice") then fmc-add(owner,"executions") else 0;
   let result = fmc-record(owner,[arrived ? (!nothing?(value) ? "value" : "observed") : "nothing",ftg-result-body(text),value,arrived,address,text]);
   fmc-stage(owner,"form-token",before,len(payload),result[0]);
   result;
  }
  // The shared stream window (ftg-window) keeps an opening-prefix suffix until a control
  // starts. One complete control per model chunk keeps an observation from splitting a model ID.
  // Every crossing keeps a frame ("" when the control outgrew the reserve unclosed), an
  // injection and an injected flag, so the three pair by index; fmc-inject sets the flag.
  def fmc-feed(owner,cursor,chunk) {
   let w = ftg-window(fmc-get(owner,"window"),chunk,fmc-get(owner,"reserve"));
   fmc-set(owner,"window",w[0]);
   let observed = w[1] == "held" ? "" : {
    let result = w[1] == "too-long" ? fmc-result(owner,"nothing","control-exceeds-observation-reserve",0,0,"") : w[1] == "multiple" ? fmc-result(owner,"nothing","multiple-controls-in-one-model-id",0,0,"") : fmc-action(owner,w[2],w[3],w[4]);
    fmc-set(owner,"frames",cons(w[3],fmc-get(owner,"frames")));
    fmc-add(owner,"crossings");
    let text = fmc-render(result);
    fmc-set(owner,"injections",cons(text,fmc-get(owner,"injections")));
    fmc-set(owner,"injected",cons(0,fmc-get(owner,"injected")));
    text;
   };
   [cursor,chunk,observed];
  }
  def fmc-observe(owner,stage,phase,cursor,generated) {
   if (phase == "begin") then fmc-set(owner,stage,fbro-snapshot()) else if (phase == "end" && record_has(owner,stage)) then fmc-stage(owner,stage,fmc-get(owner,stage),generated,"returned") else 0;
  }
  def fmc-release(owner) {
   let before = fbro-snapshot(); let buffer = fmc-get(owner,"buffer");
   let synchronized = fmc-get(owner,"pending") ? metal_sync() > 0 : 1;
   if synchronized then fmc-set(owner,"pending",0) else 0;
   let freed = synchronized && buffer > 0 ? metal_buf_free(buffer) : buffer <= 0;
   if freed then fmc-set(owner,"buffer",0) else 0;
   let results = synchronized ? fmc-get(owner,"addresses") |> map(address => mj-thought-recall(fmc-get(owner,"pipelines"),address) <= 0 ? 1 : mj-thought-release(fmc-get(owner,"pipelines"),address)) : [0];
   let vectorsFreed = synchronized ? fmr-free(owner) : 0;
   let complete = freed && vectorsFreed && all?(x => x == 1,results);
   if complete && !fmc-get(owner,"released") then { fmc-set(owner,"form-token-calls",record_get(fmc-get(owner,"tokens"),"calls")); fmc-set(owner,"form-token-refusals",record_get(fmc-get(owner,"tokens"),"refusals")); fmc-set(owner,"recipe-usage",record_get(fmc-get(owner,"tokens"),"recipe-usage")); } else 0;
   fmc-set(owner,"yield-session",nothing());
   if complete then { fmc-set(owner,"knowledge-context",nothing()); fmc-set(owner,"knowledge-executor",nothing()); fmc-set(owner,"tokens",nothing()); } else 0;
   fmc-set(owner,"released",complete); fmc-stage(owner,"release",before,len(results),complete ? "released" : "incomplete"); complete;
  }
  // the newest crossing's flag reads whether its observation entered the stream
  def fmc-inject(owner,session,text) {
   let resumed = fmc-inject-ids(owner,session,text);
   let flags = fmc-get(owner,"injected");
   if !nil?(flags) then fmc-set(owner,"injected",cons(fcms-live?(resumed) ? 1 : 0,flags[1:])) else 0;
   resumed;
  }
  def fmc-inject-ids(owner,session,text) {
   let ids = fcms-inline-bml-observation-ids(session,ftg-envelope(text));
   if nothing?(ids) then fcms-refuse(session,"microthought-model-codec-unavailable") else if fmc-get(owner,"uncertain") then fcms-refuse(session,"microthought-execution-unresolved") else if (fcms-pos(session) + len(ids) + fmc-get(owner,"answer-reserve") >= fcms-maxpos(session)) then {
    fmc-set(owner,"yield-session",session);
    fcms-refuse(session,"microthought-observation-reserve-exhausted");
   } else fcms-observe-ids(session,ids,"microthought-observation-refused");
  }
  def fmc-generate-owned(owner,session,budget) {
   fmc-set(owner,"yield-session",nothing());
   let moved = frxs-run-protocol-with-injector(session,budget,0,owner,fmc-feed,(stage,phase,cursor,generated) => fmc-observe(owner,stage,phase,cursor,generated),(s,text) => fmc-inject(owner,s,text));
   // A reserve yield committed no observation IDs. Hand the exact retained
   // session to the final-stage controller; execution evidence stays owned.
   let held = fmc-get(owner,"yield-session");
   let last = nothing?(held) ? frxs-session(moved) : held;
   fcms-generation(((String) frxs-before-text(moved) + frxs-after-text(moved)),append(frxs-before-ids(moved),frxs-after-ids(moved)),last);
  }
  def fmc-reason(owner,session,reasoning,answer) {
   if !frbg-valid-session(session) then frbg-refuse(session,frbg-empty(session),"reasoning-session-unavailable") else {
    let crystal = qsx-load(fcms-path(session)); let closing = crystal[0] == 1 ? crystal[4] : -1;
    let finalRoom = fcms-maxpos(session) - fcms-pos(session) - 2 * reasoning;
    fmc-set(owner,"answer-reserve",finalRoom > answer ? finalRoom : answer);
    if (closing < 0 || !frbg-reserve-fits(session,reasoning,answer)) then frbg-refuse(session,frbg-empty(session),"reasoning-and-answer-reserves-do-not-fit") else {
     let first = fmc-generate-owned(owner,session,reasoning); let last = fcms-generation-session(first);
     // The final stage can still request native work. Its new assistant turn
     // retires any unfinished frame from the closed reasoning turn.
     fmc-set(owner,"window",""); fmc-set(owner,"answer-reserve",0);
     if (fmc-get(owner,"crossings") > 0 && frbg-valid-session(last)) then frbg-finalize(first,reasoning,answer,(s,n)=>fmc-generate-owned(owner,s,n),frbg-bridge,"")
     else frbg-after(first,reasoning,answer,closing,fcms-generate,frbg-bridge,frbg-decode);
    };
   };
  }
  def fmc-value-node(value) = value_kind(value) == "null" ? json-node-null() : value_kind(value) == "list" ? json-node-array(value |> map(fmc-value-node)) : value_kind(value) == "float" ? json-precise-float(value) : value_kind(value) == "string" ? json-node-string(value) : value_kind(value) == "node_id" ? json-node-string(ftv-coord(value)) : value_kind(value) == "record" ? json-node-null() : json-node-int(value);
  def fmc-event-evidence(row) = json-node-object(append([oh-s("status",row[0]),oh-s("reason",row[1]),json-node-pair("value",row[3] && row[0] != "observed" ? fmc-value-node(row[2]) : json-node-null()),oh-n("present",row[3]),oh-s("recipe",row[4])],len(row) > 5 ? [oh-s("source_observation",row[5])] : []));
  def fmc-recipe-usage(owner) {
   let usage = fmc-get(owner,"released") ? fmc-get(owner,"recipe-usage") : record_get(fmc-get(owner,"tokens"),"recipe-usage");
   json-node-array(record_keys(usage) |> map(address => { let row = record_get(usage,address); json-node-object([oh-s("recipe",address),oh-n("calls",row[0]),oh-n("returned",row[1]),oh-n("inclusive_ms",row[2])]); }));
  }
  def fmc-evidence(owner) {
   let events = json-node-array(map(fmc-event-evidence,reverse(fmc-get(owner,"events"))));
   let usage = fmc-recipe-usage(owner);
   json-node-object([oh-n("crossings",fmc-get(owner,"crossings")),oh-n("executions",fmc-get(owner,"executions")),oh-n("knowledge_lookups",fmc-get(owner,"knowledge-lookups")),oh-n("jit_admissions",fmc-get(owner,"admissions")),oh-n("jit_reuses",fmc-get(owner,"reuses")),oh-n("release_ok",fmc-get(owner,"released")),oh-n("form_token_calls",fmc-get(owner,"released") ? fmc-get(owner,"form-token-calls") : record_get(fmc-get(owner,"tokens"),"calls")),oh-n("form_token_refusals",fmc-get(owner,"released") ? fmc-get(owner,"form-token-refusals") : record_get(fmc-get(owner,"tokens"),"refusals")),json-node-pair("form_recipe_usage",usage),oh-s("carrier","form;ram-metal-jit"),oh-s("recipe_scope","form-bml;affine-signed-i32;bml-numeric-f32-map"),json-node-pair("controls",json-node-array(map(json-node-string,reverse(fmc-get(owner,"frames"))))),json-node-pair("observations",events)]);
  }
  def fmc-teaching() = "During reasoning prefer Form's current source evidence over guessing. Write <|form:nodeid-knowledge-query|>concept=exact-key<|/form:nodeid-knowledge-query|> for an existing concept route. Form returns an attributed current-source observation; absence, ambiguity and stale evidence remain distinct and are not answers. " + (ftg-teaching() + " Numeric f32 BML recipes run on Metal: <|form:recipe-birth|>bml-f32;expr=x * x + 2<|/form:recipe-birth|>, then <|form:recipe-exec|>@address;input=3;carrier=metal<|/form:recipe-exec|>. Input may be a nonempty numeric JSON array for one parallel map. Expressions support x, arithmetic, comparisons, ? :, math_sqrt/exp/log/pow and min2/max2. Affine signed-i32 recipes also run on Metal: affine-i32;mul=3;add=7. A choice can mix owned Form and Metal recipes; each address runs on the carrier that holds it. Overflow and nonfinite results supply no answer. End with the answer to the enquiry.");
 }
 0;
}
