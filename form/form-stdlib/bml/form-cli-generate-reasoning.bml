// Response composition preserves shared Form meaning and the complete enquiry.
// Private stage evidence and public completion are separate. This door owns
// its session and releases the previous residence before opening another.
// preludes: form-stdlib/bml/form-cli-answer-length.bml form-stdlib/hearth.bml form-stdlib/bml/form-cli-microthought.bml
section [form.bml] {
 class FormCliGenerateReasoning {
  def fgcr-reserve(src,reasoning,answer) = (reasoning + answer) + (3 + (len(fcms-tool-tail-ids(src,"")) + str_len(frbg-observation(reasoning,reasoning,answer))));
  // The observation is encoded as its own text segment: its byte length is
  // an upper bound on BPE IDs. Three slots cover pending, close and end room.
  def fgcr-directory(base,index) {
   let path = base ++ ((Comparable) index == 0 ? "" : "-" ++ int_to_str(index));
   fs-exists?(path) ? fgcr-directory(base,index + 1) : { fs-mkdir(path); path; };
  }
  def fgcr-keep(root,name,text) {
   let path = root ++ "/" ++ name; let wrote = write_file(path,text);
   ((Comparable) wrote == str_len(text)) && ((String) read_file(path) == text);
  }
  def fgcr-generation-evidence(g) = json-node-object(list(oh-s("schema","form-native-generation-evidence-v1"),json-node-pair("ids",json-node-array(oh-ints(fcms-generation-ids(g)))),oh-s("text",fcms-generation-text(g)),oh-n("position",fcms-pos(fcms-generation-session(g))),oh-n("pending",fcms-pending(fcms-generation-session(g))),oh-n("stopped",fcms-stopped?(fcms-generation-session(g))),oh-s("status",fcms-status(fcms-generation-session(g)))));
  def fgcr-run(resident,path,prompt,reasoning,answer) = fgcr-run-bounded(resident,path,prompt,reasoning,answer,0,0);
  def fgcr-run-bounded(resident,path,prompt,reasoning,answer,lower,upper) {
   (String) path == "" ? fcmg-generate-resident(resident,path,prompt,answer)
   : !fcmr-release-ok?(resident) ? list("generation refused: previous model release incomplete\n",fcmr-none())
   : fgcr-open-bounded(path,prompt,reasoning,answer,lower,upper,host_monotonic_ms());
  }
  def fgcr-open(path,prompt,reasoning,answer,started) = fgcr-open-bounded(path,prompt,reasoning,answer,0,0,started);
  def fgcr-initial(session,reasoning,answer) = reasoning > 0 ? frbg-generate(session,reasoning,answer) : {
   let first = fcms-generate(session,answer); let last = fcms-generation-session(first);
   frbg-result(last,first,frbg-empty(last),fcms-generation-text(first),"direct-final","",frbg-stopped(last),!frbg-valid-session(last) ? fcms-reason(last) : frbg-stopped(last) ? "complete" : "generation-incomplete");
  };
  def fgcr-result-reason(result,measured) = !measured[8] ? (!measured[7] ? frbg-reason(result) : !frbg-valid-session(head(measured)) ? fcms-reason(head(measured)) : "length-revision-incomplete") : !measured[6] ? "answer-word-range-not-met" : "complete";
  def fgcr-response-prompt(prompt) = fqt-meaning-prefix() ++ "Answer the current enquiry from the supplied context. Follow its requested format and length. Runtime feedback can ask for a revision.\n" ++ prompt;
  def fgcr-profile(reasoning) = reasoning > 0 ? "response-reasoning" : "response";
  def fgcr-input-text(prompt,answer,lower,upper) {
   let enquiry = upper > 0 ? prompt ++ "\n\n" ++ fal-requirement(lower,upper) : prompt;
   fgcr-response-prompt(enquiry) ++ "\n" ++ fhm-caller-budget-text(answer);
  }
  def fgcr-open-bounded(path,prompt,reasoning,answer,lower,upper,started) {
   fgcr-open-sampled(path,prompt,reasoning,answer,lower,upper,started,0);
  }
  def fgcr-run-sampled(resident,path,prompt,answer,lower,upper,seed) {
   (String) path == "" ? list("generation needs a selected model\n",resident)
   : !fcmr-release-ok?(resident) ? list("generation refused: previous model release incomplete\n",fcmr-none())
   : fgcr-open-sampled(path,prompt,0,answer,lower,upper,host_monotonic_ms(),seed);
  }
  def fgcr-open-sampled(path,prompt,reasoning,answer,lower,upper,started,seed) {
   let text = fgcr-input-text(reasoning > 0 ? (fmc-teaching() ++ "\n" ++ prompt) : prompt,answer,lower,upper);
   let reserve = fgcr-reserve(fcmg-src(path),reasoning,answer) + fal-reserve(fcmg-src(path),lower,upper,answer) + reasoning;
   let profile = fgcr-profile(reasoning);
   let opened = fcms-open-reserved(path,text,reserve,profile);
   let session = (seed > 0) && fcms-live?(opened) ? {
    let owner = fcsam-open(fcms-ctx(opened)[2][19],seed);
    let owned = fcsam-with-owner(opened,owner);
    fcsam-live(owner) ? owned : fcms-refuse(owned,"sampling-admission-failed");
   } : opened;
   fgcr-compose(session,path,profile,reasoning,answer,lower,upper,started);
  }
  def fgcr-sampling(session) {
   let owner = fcsam-owner(session);
   nil?(owner) ? json-node-object(list(oh-s("mode","greedy"))) : json-node-object(list(oh-s("mode","qwen38-direct-seeded-v1"),oh-n("seed",owner[3]),oh-n("rng_state",owner[4]),oh-n("draws",owner[5]),oh-n("top_k",fcsam-top-k()),json-node-pair("temperature",make_float64(fcsam-temperature())),json-node-pair("top_p",make_float64(fcsam-top-p())),json-node-pair("presence_penalty",make_float64(fcsam-presence())),oh-s("penalty_scope","current generation output IDs; reset at each answer or revision"),json-node-pair("diagnostics",fgcr-sampling-diagnostics(owner))));
  }
  def fgcr-sampling-diagnostics(owner) {
   let stats = fcsam-stats(owner);
   json-node-object(list(oh-n("non_argmax_draws",head(stats)),oh-n("singleton_nucleus_draws",stats[1]),oh-n("nucleus_candidates_total",stats[2]),json-node-pair("top_k_peak_probability_sum",make_float64(stats[3])),oh-s("scope","cumulative draws including stop tokens; peak probability conditional on top-k before nucleus; no semantic confidence")));
  }
  // Takes ownership of an already admitted session, including an explicitly
  // selected learned adapter. The same controller, retention and release apply.
  def fgcr-compose(session,path,profile,reasoning,answer,lower,upper,started) {
   let thought = reasoning > 0 ? fmc-open(fcms-maxpos(session)) : nothing();
   let result = reasoning > 0 ? fmc-reason(thought,session,reasoning,answer) : fgcr-initial(session,reasoning,answer);
   let measured = fal-check(result,lower,upper,answer); let last = head(measured); let returned = measured[1];
   let thoughtReleased = nothing?(thought) ? 1 : fmc-release(thought);
   let released = fcms-release-ok?(last) && thoughtReleased;
   fs-mkdir(hearth-response-sessions()); fs-mkdir(hearth-generate-replies());
   let root = fgcr-directory(hearth-generate-replies() ++ "/" ++ int_to_str(host_pid()) ++ "-" ++ int_to_str(now_unix_ms()),0);
   let firstKept = fgcr-keep(root,"initial.txt",fcms-generation-text(frbg-first(result)));
   let finalKept = fgcr-keep(root,"final.txt",fcms-generation-text(frbg-final(result)));
   let noticeKept = fgcr-keep(root,"controller.txt",frbg-notice(result));
   let answerKept = fgcr-keep(root,"answer.txt",returned);
   let priorKept = fgcr-keep(root,"before-length-check.txt",frbg-answer(result));
   let correctionKept = fgcr-keep(root,"length-revision.txt",fcms-generation-text(measured[2]));
   let feedbackKept = fgcr-keep(root,"length-feedback.txt",measured[3]);
   let sequenceKept = fgcr-keep(root,"generation.json",json-emit(json-node-object(list(oh-s("schema","form-native-generation-evidence-v1"),json-node-pair("initial",fgcr-generation-evidence(frbg-first(result))),json-node-pair("final",fgcr-generation-evidence(frbg-final(result))),json-node-pair("length_revision",fgcr-generation-evidence(measured[2]))))));
   let thoughtKept = nothing?(thought) ? 1 : fgcr-keep(root,"microthought.json",json-emit(json-node-object(list(json-node-pair("execution",fmc-evidence(thought)),json-node-pair("controls",json-node-array(map(json-node-string,reverse(fmc-get(thought,"frames"))))),json-node-pair("injections",json-node-array(map(json-node-string,reverse(fmc-get(thought,"injections")))))))));
   let retained = thoughtKept && ((firstKept && finalKept) && ((noticeKept && answerKept) && (priorKept && (correctionKept && (feedbackKept && sequenceKept)))));
   let complete = measured[8]; let rangePassed = measured[6];
   let detail = json-node-object(list(
    oh-s("model",path),oh-s("profile",profile),json-node-pair("microthought",nothing?(thought) ? json-node-null() : fmc-evidence(thought)),json-node-pair("sampling",fgcr-sampling(last)),json-node-pair("sampling_before_length_check",fgcr-sampling(frbg-session(result))),oh-s("adapter_path",fcmd-path(fcmd-carrier(last))),oh-s("adapter_ab_sha256",fcmd-digest(fcmd-carrier(last))),oh-n("reasoning_allowance",reasoning),oh-n("answer_allowance",answer),oh-n("context",fcms-maxpos(last)),oh-n("prompt_ids",fcms-prompt-ids(last)),
    oh-n("initial_generated_ids",len(fcms-generation-ids(frbg-first(result)))),oh-n("final_generated_ids",len(fcms-generation-ids(frbg-final(result)))),oh-n("length_revision_generated_ids",len(fcms-generation-ids(measured[2]))),oh-n("injected_ids",fcms-injected-ids(last)),
    oh-n("complete",complete),oh-s("reason",fgcr-result-reason(result,measured)),oh-s("answer_origin",measured[7] ? "length-revision" : frbg-origin(result)),
    oh-n("word_minimum",lower),oh-n("word_maximum",upper),oh-n("initial_words",measured[4]),oh-n("final_words",measured[5]),oh-n("word_range_checked",upper > 0),oh-n("word_range_passed",rangePassed),oh-n("length_revisions",measured[7]),oh-s("length_revision_change",fal-change(result,measured)),
    oh-n("release_ok",released),oh-n("retained",retained),oh-n("elapsed_ms",host_monotonic_ms() - started),oh-n("provider_calls",0),oh-s("private_evidence",root)));
   let reportKept = fgcr-keep(root,"report.json",json-emit(detail));
   let healthy = rangePassed && (complete && (released && (retained && reportKept)));
   let reading = oh-reading("native-generation",root,"bounded-response",json-node-int(1),json-node-int(healthy),json-node-int(healthy),healthy ? list() : list(oh-need("inspect-generation-evidence",detail)),list("inspect-retained-evidence"),detail);
   oh-voice(reading);
   list("form-native-generation " ++ json-emit(detail) ++ "\ntext:\n" ++ returned,fcmr-none(),detail);
  }
 }
 0;
}
