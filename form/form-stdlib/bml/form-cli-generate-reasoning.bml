    def fgcr-run-ordinary(resident,path,prompt,answer) = path=="" ? ["generation needs a selected model\n",resident] : !fcmr-release-ok?(resident) ? ["generation refused: previous model release incomplete\n",resident] : fgcr-open-ordinary(path,prompt,answer,host_monotonic_ms());
  def fgcr-source-observation(source,payload) = fgcr-source-found(source,payload)[1];
  def fgcr-source-found(source,payload) {
