    let evidence=json-emit(json-node-object([json-node-pair("literal_offers",fmc-value-node(thoughts)),json-node-pair("source_queries",fmc-value-node(reverse(record_get(controls,"knowledge-evidence")))),json-node-pair("control_frames",fmc-value-node(reverse(record_get(cursor,"frames")))),json-node-pair("control_injected",fmc-value-node(reverse(record_get(cursor,"injected"))))]));
     frbg-result(last,first,frbg-empty(last),fgcr-ordinary-prose(s,fcms-generation-text(first)),"direct-final",evidence,frbg-stopped(last),!frbg-valid-session(last) ? fcms-reason(last) : frbg-stopped(last) ? "complete" : "generation-incomplete");
   };
