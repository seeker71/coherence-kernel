// Response composition preserves shared Form meaning and the complete enquiry.
// Private stage evidence and public completion are separate. This door owns
// its session and releases the previous residence before opening another.
import form-stdlib/bml/form-cli-answer-length.bml;
import form-stdlib/hearth.bml;
import form-stdlib/bml/form-cli-microthought.bml;
import form-stdlib/bml/form-cli-native-voice.bml;
section [form.bml] {
 class FormCliGenerateReasoning {
   def fgcr-work() = record_get(ftg-session(),"generation-continuation");
   def fgcr-retain(session) {
