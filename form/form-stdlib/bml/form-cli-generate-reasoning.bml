  def fgcr-response-prompt(prompt) = (fqt-meaning-prefix() + ("Answer the current enquiry from the supplied context. Follow its requested format and length. Runtime feedback can ask for a revision.\n" + prompt));
  def fgcr-profile(reasoning) = if (reasoning > 0) then "response-reasoning" else "response";
  def fgcr-input-text(prompt,answer,lower,upper) {
