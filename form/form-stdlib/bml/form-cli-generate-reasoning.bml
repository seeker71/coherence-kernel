   let thoughtKept = nothing?(thought) ? 1 : fgcr-keep(root,"microthought.json",json-emit(json-node-object([json-node-pair("execution",fmc-evidence(thought)),json-node-pair("controls",json-node-array(map(json-node-string,reverse(fmc-get(thought,"frames"))))),json-node-pair("injections",json-node-array(map(json-node-string,reverse(fmc-get(thought,"injections")))))])));
