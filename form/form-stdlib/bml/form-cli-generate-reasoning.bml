   }
  def fgcr-reserve(src,reasoning,answer) = frbg-allowance-sum([reasoning,answer,3,len(fcmo-tool-tail-ids(src,"")),len(frbg-observation(reasoning,reasoning,answer))]);
  // The observation is encoded as its own text segment: its byte length is
  // an upper bound on BPE IDs. Three slots cover pending, close and end room.
  def fgcr-directory(base,index) {
   let path = ((String) base + (if ((Comparable) index == 0) then "" else ("-" + index.str())));
   if fs-exists?(path) then fgcr-directory(base,(index + 1)) else { fs-mkdir(path); path; };
  }
  def fgcr-keep(root,name,text) {
