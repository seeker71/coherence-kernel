    let needed=fcmg-id-count(lists,0)+lg-gap-default()*(len(lists) - 1)+1;
    let owner=fcms-ensure-room(session,needed);
    if !fcms-live?(owner) then owner else {
     let ctx=fcms-ctx(owner);
     let offered=fcmg-offer-stream(ctx[0],ctx[1],ctx[2],ctx[3],fcms-sts(owner),ctx[4],ctx[5],ctx[6],lists,fcms-pos(owner),lg-gap-default(),fcmo-stops(owner),[],0,0);
     let moved=fcms-with-stream(owner,offered[1],offered[0],0,fcms-generated-ids(owner)+len(offered[2]) - offered[3],fcms-injected-ids(owner)+offered[3],fcms-observations(owner)+offered[4]);
     offered[0]<0 ? fcms-refuse(moved,"literal-offer-prefill-refused") : moved;
    };
   };
  }
   def fgcr-ordinary-prompt(arch,prompt,answer) = (arch=="deepseek4" ? fgcr-response-prompt(prompt) : fcmg-teach(prompt))+"\n"+fhm-answer-budget-text(answer);
   def fgcr-ordinary-prose(session,text) = fcms-ds4?(session) ? text : ftg-prose(text);
    def fgcr-open-ordinary(path,prompt,answer,started) = fgcr-request(["ordinary",path,prompt,0,answer,0,0,0,""],work=>fgcr-open-ordinary-owned(path,prompt,answer,started));
    def fgcr-open-ordinary-owned(path,prompt,answer,started) {
     let text=fgcr-ordinary-prompt(fcmg-arch(fcmg-src(path)),prompt,answer);
     let opened=fgcr-open-retained(path,text,answer,"full");
   let thoughts=fcms-ds4?(opened) ? [] : lg-think-all(text);
   let session=fgcr-offer-literals(opened,thoughts);
   let controls=ftv-session();let source=fcsa-infer(prompt);
   record_set(controls,"knowledge-evidence",[]);
   record_set(controls,"knowledge-query",payload=>{
    let found=fgcr-source-found(source,payload);
    record_set(controls,"knowledge-evidence",cons([ftg-render("knowledge-query",payload),found[0][0],found[0][2],len(found[1])>0],record_get(controls,"knowledge-evidence")));
    found[1];
   });
   let cursor=ftg-pulsing(ftg-intercept-with(nothing(),controls));
    record_set(cursor,"generation-owner",fgcr-work());
   let initial=(s,reasoning,answer)=>{
