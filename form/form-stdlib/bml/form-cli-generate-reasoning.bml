     else {
      let work=record_new(0,"request",request,"continuation","generation:"+noc-open(),"phase","pending","lifetime",nothing(),"session",nothing(),"generation",nothing(),"result",nothing(),"assessment",nothing(),"thought",nothing(),"evidence","","resumed",0);
      record_set(work,"path",request[1]);record_set(work,"profile",request[0]=="ordinary" ? "full" : fgcr-profile(request[3]));record_set(work,"reasoning",request[3]);record_set(work,"answer",request[4]);record_set(work,"lower",request[5]);record_set(work,"upper",request[6]);record_set(work,"started",host_monotonic_ms());
      record_set(ftg-session(),"generation-continuation",work);
