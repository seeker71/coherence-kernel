     let first=record_get(work,"reasoning-generation");let initial=value_kind(first)=="list" ? first : generated;
      let unavailable=record?(progress) && record_get(progress,"text-available")==0;
      let result=value_kind(held)=="list" ? held : frbg-result(fcms-generation-session(generated),reasoning ? initial : generated,reasoning && finalStarted ? generated : frbg-empty(session),reasoning && !finalStarted ? "" : fgcr-ordinary-prose(session,fcms-generation-text(generated)),finalStarted ? "interrupted-final-stage" : "interrupted-generation","",reasoning && !finalStarted ? 0 : complete,unavailable ? "generation-text-unavailable" : "generation-interrupted");
