   def fgcr-run-selected(resident,path,prompt,reasoning,answer,lower,upper,seed,adapter) = path == "" ? ["generation needs a selected model\n",resident] : !fcmr-release-ok?(resident) ? ["generation refused: previous model release incomplete\n",resident] : fgcr-open-selected(path,prompt,reasoning,answer,lower,upper,host_monotonic_ms(),seed,adapter);
