// Response composition preserves shared Form meaning and the complete enquiry.
// Private stage evidence and public completion are separate. This door owns
// its session and releases the previous residence before opening another.
// preludes: form-stdlib/bml/form-cli-answer-length.bml form-stdlib/hearth.bml
section [form.bml] {
 class FormCliGenerateReasoning {
  def fgcr-reserve(src,reasoning,answer) = add(add(reasoning,answer),add(3,add(len(fcms-tool-tail-ids(src,"")),str_len(frbg-observation(reasoning,reasoning,answer)))));
  // The observation is encoded as its own text segment: its byte length is
  // an upper bound on BPE IDs. Three slots cover pending, close and end room.
  def fgcr-directory(base,index) {
   let path = str_concat(base,if eq(index,0) then "" else str_concat("-",int_to_str(index)));
   if fs-exists?(path) then fgcr-directory(base,add(index,1)) else { fs-mkdir(path); path; };
  }
  def fgcr-keep(root,name,text) {
   let path = str_concat(root,str_concat("/",name)); let wrote = write_file(path,text);
   and(eq(wrote,str_len(text)),str_eq(read_file(path),text));
  }
  def fgcr-generation-evidence(g) = json-node-object(list(oh-s("schema","form-native-generation-evidence-v1"),json-node-pair("ids",json-node-array(oh-ints(fcms-generation-ids(g)))),oh-s("text",fcms-generation-text(g)),oh-n("position",fcms-pos(fcms-generation-session(g))),oh-n("pending",fcms-pending(fcms-generation-session(g))),oh-n("stopped",fcms-stopped?(fcms-generation-session(g))),oh-s("status",fcms-status(fcms-generation-session(g)))));
  def fgcr-run(resident,path,prompt,reasoning,answer) = fgcr-run-bounded(resident,path,prompt,reasoning,answer,0,0);
  def fgcr-run-bounded(resident,path,prompt,reasoning,answer,lower,upper) {
   if str_eq(path,"") then fcmg-generate-resident(resident,path,prompt,answer)
   else if not(fcmr-release-ok?(resident)) then list("generation refused: previous model release incomplete\n",fcmr-none())
   else fgcr-open-bounded(path,prompt,reasoning,answer,lower,upper,host_monotonic_ms());
  }
  def fgcr-open(path,prompt,reasoning,answer,started) = fgcr-open-bounded(path,prompt,reasoning,answer,0,0,started);
  def fgcr-initial(session,reasoning,answer) = if gt(reasoning,0) then frbg-generate(session,reasoning,answer) else {
   let first = fcms-generate(session,answer); let last = fcms-generation-session(first);
   frbg-result(last,first,frbg-empty(last),fcms-generation-text(first),"direct-final","",frbg-stopped(last),if not(frbg-valid-session(last)) then fcms-reason(last) else if frbg-stopped(last) then "complete" else "generation-incomplete");
  };
  def fgcr-result-reason(result,measured) = if not(nth(measured,8)) then if not(nth(measured,7)) then frbg-reason(result) else if not(frbg-valid-session(head(measured))) then fcms-reason(head(measured)) else "length-revision-incomplete" else if not(nth(measured,6)) then "answer-word-range-not-met" else "complete";
  def fgcr-response-prompt(prompt) = str_concat(fqt-meaning-prefix(),str_concat("Answer the current enquiry from the supplied context. Follow its requested format and length. Runtime feedback can ask for a revision.\n",prompt));
  def fgcr-profile(reasoning) = if gt(reasoning,0) then "response-reasoning" else "response";
  def fgcr-input-text(prompt,answer,lower,upper) {
   let enquiry = if gt(upper,0) then str_concat(prompt,str_concat("\n\n",fal-requirement(lower,upper))) else prompt;
   str_concat(fgcr-response-prompt(enquiry),str_concat("\n",fhm-caller-budget-text(answer)));
  }
  def fgcr-open-bounded(path,prompt,reasoning,answer,lower,upper,started) {
   fgcr-open-sampled(path,prompt,reasoning,answer,lower,upper,started,0);
  }
  def fgcr-run-sampled(resident,path,prompt,answer,lower,upper,seed) {
   if str_eq(path,"") then list("generation needs a selected model\n",resident)
   else if not(fcmr-release-ok?(resident)) then list("generation refused: previous model release incomplete\n",fcmr-none())
   else fgcr-open-sampled(path,prompt,0,answer,lower,upper,host_monotonic_ms(),seed);
  }
  def fgcr-open-sampled(path,prompt,reasoning,answer,lower,upper,started,seed) {
   let text = fgcr-input-text(prompt,answer,lower,upper);
   let reserve = add(fgcr-reserve(fcmg-src(path),reasoning,answer),fal-reserve(fcmg-src(path),lower,upper,answer));
   let profile = fgcr-profile(reasoning);
   let opened = fcms-open-reserved(path,text,reserve,profile);
   let session = if and(gt(seed,0),fcms-live?(opened)) then {
    let owner = fcsam-open(nth(nth(fcms-ctx(opened),2),19),seed);
    let owned = fcsam-with-owner(opened,owner);
    if fcsam-live(owner) then owned else fcms-refuse(owned,"sampling-admission-failed");
   } else opened;
   fgcr-compose(session,path,profile,reasoning,answer,lower,upper,started);
  }
  def fgcr-sampling(session) {
   let owner = fcsam-owner(session);
   if nil?(owner) then json-node-object(list(oh-s("mode","greedy"))) else json-node-object(list(oh-s("mode","qwen38-direct-seeded-v1"),oh-n("seed",nth(owner,3)),oh-n("rng_state",nth(owner,4)),oh-n("draws",nth(owner,5)),oh-n("top_k",fcsam-top-k()),json-node-pair("temperature",make_float64(fcsam-temperature())),json-node-pair("top_p",make_float64(fcsam-top-p())),json-node-pair("presence_penalty",make_float64(fcsam-presence())),oh-s("penalty_scope","current generation output IDs; reset at each answer or revision")));
  }
  // Takes ownership of an already admitted session, including an explicitly
  // selected learned adapter. The same controller, retention and release apply.
  def fgcr-compose(session,path,profile,reasoning,answer,lower,upper,started) {
   let result = fgcr-initial(session,reasoning,answer);
   let measured = fal-check(result,lower,upper,answer); let last = head(measured); let returned = nth(measured,1);
   let released = fcms-release-ok?(last);
   fs-mkdir(hearth-response-sessions()); fs-mkdir(hearth-generate-replies());
   let root = fgcr-directory(str_concat(hearth-generate-replies(),str_concat("/",str_concat(int_to_str(host_pid()),str_concat("-",int_to_str(now_unix_ms()))))),0);
   let firstKept = fgcr-keep(root,"initial.txt",fcms-generation-text(frbg-first(result)));
   let finalKept = fgcr-keep(root,"final.txt",fcms-generation-text(frbg-final(result)));
   let noticeKept = fgcr-keep(root,"controller.txt",frbg-notice(result));
   let answerKept = fgcr-keep(root,"answer.txt",returned);
   let priorKept = fgcr-keep(root,"before-length-check.txt",frbg-answer(result));
   let correctionKept = fgcr-keep(root,"length-revision.txt",fcms-generation-text(nth(measured,2)));
   let feedbackKept = fgcr-keep(root,"length-feedback.txt",nth(measured,3));
   let sequenceKept = fgcr-keep(root,"generation.json",json-emit(json-node-object(list(oh-s("schema","form-native-generation-evidence-v1"),json-node-pair("initial",fgcr-generation-evidence(frbg-first(result))),json-node-pair("final",fgcr-generation-evidence(frbg-final(result))),json-node-pair("length_revision",fgcr-generation-evidence(nth(measured,2)))))));
   let retained = and(and(firstKept,finalKept),and(and(noticeKept,answerKept),and(priorKept,and(correctionKept,and(feedbackKept,sequenceKept)))));
   let complete = nth(measured,8); let rangePassed = nth(measured,6);
   let detail = json-node-object(list(
    oh-s("model",path),oh-s("profile",profile),json-node-pair("sampling",fgcr-sampling(last)),oh-s("adapter_path",fcmd-path(fcmd-carrier(last))),oh-s("adapter_ab_sha256",fcmd-digest(fcmd-carrier(last))),oh-n("reasoning_allowance",reasoning),oh-n("answer_allowance",answer),oh-n("context",fcms-maxpos(last)),oh-n("prompt_ids",fcms-prompt-ids(last)),
    oh-n("initial_generated_ids",len(fcms-generation-ids(frbg-first(result)))),oh-n("final_generated_ids",len(fcms-generation-ids(frbg-final(result)))),oh-n("length_revision_generated_ids",len(fcms-generation-ids(nth(measured,2)))),oh-n("injected_ids",fcms-injected-ids(last)),
    oh-n("complete",complete),oh-s("reason",fgcr-result-reason(result,measured)),oh-s("answer_origin",if nth(measured,7) then "length-revision" else frbg-origin(result)),
    oh-n("word_minimum",lower),oh-n("word_maximum",upper),oh-n("initial_words",nth(measured,4)),oh-n("final_words",nth(measured,5)),oh-n("word_range_checked",gt(upper,0)),oh-n("word_range_passed",rangePassed),oh-n("length_revisions",nth(measured,7)),
    oh-n("release_ok",released),oh-n("retained",retained),oh-n("elapsed_ms",sub(host_monotonic_ms(),started)),oh-n("provider_calls",0),oh-s("private_evidence",root)));
   let reportKept = fgcr-keep(root,"report.json",json-emit(detail));
   let healthy = and(rangePassed,and(complete,and(released,and(retained,reportKept))));
   let reading = oh-reading("native-generation",root,"bounded-response",json-node-int(1),json-node-int(healthy),json-node-int(healthy),if healthy then list() else list(oh-need("inspect-generation-evidence",detail)),list("inspect-retained-evidence"),detail);
   oh-voice(reading);
   list(str_concat("form-native-generation ",str_concat(json-emit(detail),str_concat("\ntext:\n",returned))),fcmr-none(),detail);
  }
 }
 0;
}
