  }
  def fgcr-run-sampled(resident,path,prompt,answer,lower,upper,seed) {
   if ((String) path == "") then ["generation needs a selected model\n",resident]
    else if (!fcmr-release-ok?(resident)) then ["generation refused: previous model release incomplete\n",resident]
   else fgcr-open-sampled(path,prompt,0,answer,lower,upper,host_monotonic_ms(),seed);
