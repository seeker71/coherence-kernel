   (((Comparable) wrote == len(text)) && ((String) read_file(path) == text));
  }
  def fgcr-generation-evidence(g) = json-node-object([oh-s("schema","form-native-generation-evidence-v1"),json-node-pair("ids",json-node-array(oh-ints(fcms-generation-ids(g)))),oh-s("text",fcms-generation-text(g)),oh-n("position",fcms-pos(fcms-generation-session(g))),oh-n("pending",fcms-pending(fcms-generation-session(g))),oh-n("stopped",fcms-stopped?(fcms-generation-session(g))),oh-s("status",fcms-status(fcms-generation-session(g)))]);
   def fgcr-length-evidence(attempt) = json-node-object([json-node-pair("generation",fgcr-generation-evidence(attempt[0])),oh-s("feedback",attempt[1]),oh-n("before_words",attempt[2]),oh-n("after_words",attempt[3]),oh-n("complete",attempt[4]),oh-s("ending",attempt[5])]);
   def fgcr-length-tokens(attempts) = nil?(attempts) ? 0 : len(fcms-generation-ids(attempts[0][0]))+fgcr-length-tokens(attempts[1:]);
  def fgcr-run(resident,path,prompt,reasoning,answer) = fgcr-run-bounded(resident,path,prompt,reasoning,answer,0,0);
   // Ordinary generation retains the lane's profile, native literal offers
