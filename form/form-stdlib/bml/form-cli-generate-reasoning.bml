   if released then record_set(ftg-session(),"generation-model",nothing()) else 0;
    if released && retained && reportKept then record_set(work,"phase","complete") else record_set(work,"phase","release-pending");
   let healthy = (rangePassed && (complete && (released && (retained && reportKept))));
   let reading = oh-reading("native-generation",root,"bounded-response",json-node-int(1),json-node-int(healthy),json-node-int(healthy),if healthy then [] else [oh-need("inspect-generation-evidence",detail)],["inspect-retained-evidence"],detail);
   oh-voice(reading);
    [("form-native-generation " + (json-emit(detail) + ("\ntext:\n" + returned))),released ? fcmr-none() : last,detail];
  }
 }
 0;
}
