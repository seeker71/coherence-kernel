    [found,fgcr-source-result(found)];
  }
   def fgcr-source-result(found) = found[0]=="hit" || found[0]=="miss" ? found[1] : ftv-nothing("source-query-"+found[2]);
  def fgcr-offer-literals(session,thoughts) {
