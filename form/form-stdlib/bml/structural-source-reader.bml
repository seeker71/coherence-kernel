// A single owned OS inventory exposes traversal errors and exact NUL-separated
// paths. Form owns root admission, classification and the resulting audit.
// fs_list's empty result cannot distinguish a denied directory from an empty one.
// preludes: form-stdlib/bml/native-source-inventory.bml
section [form.bml] {
 class StructuralSourceReader {
  def sga-root(path) = if eq(str_len(path),0) then form_error("structural audit root is empty") else if or(str_eq(path,"."),or(str_eq(substring(path,0,1),"/"),str_eq(substring(path,0,2),"./"))) then path else str_concat("./",path);
  def sga-capture(root,skipA,skipB) = nsi-capture(list("find","-L",sga-root(root),"(","-name",skipA,"-o","-name",skipB,")","-prune","-o","!","-type","d","-print0"));
  def sga-read(root,skipA,skipB) {
   let captured = sga-capture(root,skipA,skipB);
   if not(eq(fs_is_dir(root),1)) then nsi-refuse(captured,"directory-root") else sga-read-complete(nsi-require-nuls(captured));
  }
  def sga-read-complete(captured) = split-on(nsi-text(captured),byte_to_str(0));
 }
 0;
}
