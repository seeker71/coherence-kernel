// The structural gate's reading of a tree: every file that stands in it, by one owned OS inventory with exact NUL-separated paths.
// Form owns root admission, classification and the resulting audit.
// fs_list's empty result cannot distinguish a denied directory from an empty one.
// What stands in the tree is what git says it holds: the tracked files and the untracked files git does not ignore
// (`git ls-files -z --cached --others --exclude-standard`), the files that exist. A cache that git ignores (form/.cache, the built
// images) is not tree content and is not listed; a new file that is not ignored is listed before it lands. A root git cannot read
// (not a repository) is listed whole by `find`, nothing set aside: nothing git does not ignore is ever skipped.
// Two names are never walked: .git (packed history) and .claude (the agents' worktrees: whole sibling checkouts, audited by their own gates).
import form-stdlib/bml/native-source-inventory.bml;
section [form.bml] {
 class StructuralSourceReader {
  def sga-root(path) = if ((Comparable) len(path) == 0) then form_error("structural audit root is empty") else if (((String) path == ".") || (((String) substring(path,0,1) == "/") || ((String) substring(path,0,2) == "./"))) then path else ("./" + path);
  def sga-capture(root,skipA,skipB) = nsi-capture(["find","-L",sga-root(root),"(","-name",skipA,"-o","-name",skipB,")","-prune","-o","!","-type","d","-print0"]);
  def sga-ends?(s,suffix) = ((len(s) >= len(suffix)) && ((String) substring(s,(len(s) - len(suffix)),len(s)) == suffix));
  def sga-starts?(s,prefix) = ((len(s) >= len(prefix)) && ((String) substring(s,0,len(prefix)) == prefix));
  // a listed entry under a name that is never walked, at any depth
  def sga-skipped?(entry,skipA,skipB) = (sga-starts?(entry,(skipA + "/")) || (sga-starts?(entry,(skipB + "/")) || ((str_find(entry,("/" + (skipA + "/")),0) >= 0) || (str_find(entry,("/" + (skipB + "/")),0) >= 0))));
  def sga-joined(root,entry) = if ((String) root == ".") then ("./" + entry) else (root + ("/" + entry));
  def sga-stands?(root,entry) = ((len(entry) > 0) && ((Comparable) file_size(sga-joined(root,entry)) >= 0));
  // git's listing of the tree, the paths relative to the root; nothing when git cannot read the root
  def sga-listing(root) {
   let captured = nsi-capture(["git","-C",sga-root(root),"ls-files","-z","--cached","--others","--exclude-standard"]);
   if nsi-admitted?(captured) then split-on(nsi-text(captured),byte_to_str(0)) else nothing();
  }
  def sga-from-git(root,entries,skipA,skipB) = map(e => sga-joined(root,e),filter(e => (sga-stands?(root,e) && (!sga-skipped?(e,skipA,skipB))),entries));
  def sga-read(root,skipA,skipB) = if (!((Comparable) fs_is_dir(root) == 1)) then nsi-refuse(sga-capture(root,skipA,skipB),"directory-root") else sga-read-listed(root,skipA,skipB,sga-listing(root));
  def sga-read-listed(root,skipA,skipB,listed) = if nothing?(listed) then sga-read-find(root,skipA,skipB) else sga-from-git(root,listed,skipA,skipB);
  def sga-read-find(root,skipA,skipB) = filter(p => (len(p) > 0),split-on(nsi-text(nsi-require-nuls(sga-capture(root,skipA,skipB))),byte_to_str(0)));
 }
 0;
}
