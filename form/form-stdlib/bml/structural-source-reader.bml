// A single owned OS inventory exposes traversal errors and exact NUL-separated
// paths. Form owns root admission, classification and the resulting audit.
// fs_list's empty result cannot distinguish a denied directory from an empty one.
// Git's own reading of what the checkout ignores sets aside every shell or
// Python path under an ignored directory or named as an ignored file, so a
// cache such as form/.cache never reaches the audit. A root git cannot read
// sets nothing aside: nothing git does not ignore is ever skipped.
// preludes: form-stdlib/bml/native-source-inventory.bml
section [form.bml] {
 class StructuralSourceReader {
  def sga-root(path) = (Comparable) str_len(path) == 0 ? form_error("structural audit root is empty") : ((String) path == ".") || (((String) substring(path,0,1) == "/") || ((String) substring(path,0,2) == "./")) ? path : "./" ++ path;
  def sga-capture(root,skipA,skipB) = nsi-capture(list("find","-L",sga-root(root),"(","-name",skipA,"-o","-name",skipB,")","-prune","-o","!","-type","d","-print0"));
  def sga-ignored(root) {
   let captured = nsi-capture(list("git","-C",sga-root(root),"ls-files","-z","--others","--ignored","--exclude-standard","--directory"));
   nsi-admitted?(captured) ? sga-ignored-entries(split-on(nsi-text(captured),byte_to_str(0)),list()) : list();
  }
  def sga-ends?(s,suffix) = (str_len(s) >= str_len(suffix)) && ((String) substring(s,str_len(s) - str_len(suffix),str_len(s)) == suffix);
  def sga-script?(path) = sga-ends?(path,".sh") || sga-ends?(path,".py");
  def sga-ignored-entry?(entry) = (str_len(entry) > 0) && (sga-ends?(entry,"/") || sga-script?(entry));
  def sga-ignored-entries(entries,acc) = nil?(entries) ? acc : sga-ignored-entry?(head(entries)) ? sga-ignored-entries(tail(entries),cons(head(entries),acc)) : sga-ignored-entries(tail(entries),acc);
  // find prints each path with the root in front; git answers relative to the root
  def sga-relative(root,path) = (str_len(path) > (str_len(root) + 1)) && ((String) substring(path,0,str_len(root) + 1) == (root ++ "/")) ? substring(path,str_len(root) + 1,str_len(path)) : path;
  def sga-under?(rel,entry) = sga-ends?(entry,"/") ? ((str_len(rel) >= str_len(entry)) && ((String) substring(rel,0,str_len(entry)) == entry)) : ((String) rel == entry);
  def sga-set-aside?(rel,ignored) = nil?(ignored) ? 0 : sga-under?(rel,head(ignored)) ? 1 : sga-set-aside?(rel,tail(ignored));
  def sga-keep(paths,root,ignored,acc) = nil?(paths) ? reverse(acc) : sga-script?(head(paths)) && sga-set-aside?(sga-relative(root,head(paths)),ignored) ? sga-keep(tail(paths),root,ignored,acc) : sga-keep(tail(paths),root,ignored,cons(head(paths),acc));
  def sga-read(root,skipA,skipB) {
   let captured = sga-capture(root,skipA,skipB);
   !((Comparable) fs_is_dir(root) == 1) ? nsi-refuse(captured,"directory-root") : sga-read-complete(nsi-require-nuls(captured),sga-root(root));
  }
  def sga-read-complete(captured,root) = sga-keep(split-on(nsi-text(captured),byte_to_str(0)),root,sga-ignored(root),list());
 }
 0;
}
