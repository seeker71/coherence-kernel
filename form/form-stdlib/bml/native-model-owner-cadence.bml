package Form.native.modelownercadence;

import Form.kernel.*;
import Form.glass.telemetry.*;

interface INativeModelOwnerCadence [public, witness, resident] {
   section [public] {
      const String SeparationRule = "OS process-liveness is a current observation distinct from the last in-process model readiness observation; it never renews model access, readiness, or context age";
      const String CorrelationRule = "the observer publisher carries its exact pid, Form-entry start, incarnation, sequence, and observation epoch; the OS target carries exact pid plus lifetime signature, while a last-observed model publisher is bound only when its own snapshot heartbeat names the same publisher, pid, and start";
      const String FailureRule = "missing, duplicate, dead, recycled, malformed, or temporally impossible ownership remains fail-closed";
      const String CadenceRule = "the liveness observer and future owner target four hertz through the existing Form host-exec sleep and native filesystem primitives; physical witnesses report actual cadence";
      const String IdentityRule = "owner and observer heartbeat sample ids are stable for one incarnation; cadence sequence remains a numeric correlation field and never enters a newly minted per-frame id";

      Object Correlation( String observerPublisher, Int observerPid, Int observerStarted, String observerIncarnation, Int sequence, Int observed, String targetPublisher, Int targetPid, Int targetPublisherStarted, Int targetSnapshotEpoch, Int targetProcessStartFloor, String targetLifetimeSignature, String snapshotOwnerPublisher, Int snapshotOwnerPid, Int snapshotOwnerStarted, String snapshotHeartbeatId, String targetBinding ) [abstract];
      Object LivenessSample( Object correlation, Int alive ) [abstract];
      Object Publish( String root, Object correlation, Int alive ) [abstract];
      Object PollCommand( String publisher ) [abstract];
      Object OfferCommand( String publisher, String command ) [abstract];
   }
}

class NativeModelOwnerCadence [public, resident, observable, teach] : INativeModelOwnerCadence {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-owner-cadence.bml";

      Object Correlation( String observerPublisher, Int observerPid, Int observerStarted, String observerIncarnation, Int sequence, Int observed, String targetPublisher, Int targetPid, Int targetPublisherStarted, Int targetSnapshotEpoch, Int targetProcessStartFloor, String targetLifetimeSignature, String snapshotOwnerPublisher, Int snapshotOwnerPid, Int snapshotOwnerStarted, String snapshotHeartbeatId, String targetBinding ) [abstract] {}
      Object LivenessSample( Object correlation, Int alive ) [abstract] {}
      Object Publish( String root, Object correlation, Int alive ) [abstract] {}
      Object PollCommand( String publisher ) [abstract] {}
      Object OfferCommand( String publisher, String command ) [abstract] {}
   }
}
