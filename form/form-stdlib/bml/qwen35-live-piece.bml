// One exact BPE piece in a caller-owned model epoch. Repeated pieces reuse
// their IDs; execution counters describe work performed on this use only.
import form-stdlib/qwen35-tokenizer.fk;
import form-stdlib/qwen35-tokfast-v2-live-reader.fk;
section [form.bml] {
 class QwenLivePiece {
  def qtlc-bpe-result(status,syms,merges,probes,reason) = ["qtlc-bpe",status,syms,merges,probes,reason];
  def qtlc-bpe-status(r) = r[1];
  def qtlc-bpe-syms(r) = r[2];
  def qtlc-bpe-merges(r) = r[3];
  def qtlc-bpe-probes(r) = r[4];
  def qtlc-bpe(index,syms) = qtlc-bpe-loop(index,syms,0,0);
  def qtlc-bpe-loop(index,syms,merges,probes) {
   if (len(syms) < 2) then qtlc-bpe-result("ok",syms,merges,probes,"terminal") else {
    let selected = qtf2r-best(index,syms,0,0,0,0,0); let next = probes + selected[4];
    selected[0] != "ok" ? qtlc-bpe-result(selected[0],[],merges,next,"merge-lookup-refused") : !selected[3] ? qtlc-bpe-result("ok",syms,merges,next,"no-merge") : qtlc-bpe-loop(index,tkz-apply(syms,selected[1]),merges + 1,next);
   };
  }
  def qtlc-ids-result(status,ids,probes,reason) = ["qtlc-ids",status,ids,probes,reason];
  def qtlc-ids-status(r) = r[1];
  def qtlc-ids-values(r) = r[2];
  def qtlc-ids-probes(r) = r[3];
  def qtlc-symbol-ids(index,syms,acc,probes) {
   if nil?(syms) then qtlc-ids-result("ok",acc,probes,"exact") else {
    let found = qtf2r-find(index,"vocab",syms[0],[],0,index[3],0); let next = probes + found[3];
    found[2] != 1 ? qtlc-ids-result(found[0],[],next,"vocab-lookup-refused") : qtlc-symbol-ids(index,syms[1:],append(acc,[found[1]]),next);
   };
  }
  // piece = status, ids, merges performed, probes performed, reason.
  def qtlc-piece-compute(index,text) {
   let bpe = qtlc-bpe(index,tkz-syms(text,0,len(text)));
   let ids = qtlc-bpe-status(bpe) == "ok" ? qtlc-symbol-ids(index,qtlc-bpe-syms(bpe),[],0) : qtlc-ids-result(qtlc-bpe-status(bpe),[],0,"merge-lookup-refused");
   [qtlc-ids-status(ids),qtlc-ids-values(ids),qtlc-bpe-merges(bpe),qtlc-bpe-probes(bpe) + qtlc-ids-probes(ids),ids[4]];
  }
  def qtlc-piece-index(index) = index[0] == "current" && len(index) == 11 ? append(index,[reuse-open(record_get(index[10],"epoch"),index,qtlc-piece-compute,result => result[0] == "ok")]) : index;
  def qtlc-piece(index,text) {
   if (len(index) <= 11) then qtlc-piece-compute(index,text) else {
    let owner = index[11]; let hits = record_get(owner,"hits"); let result = reuse-call(owner,text);
    nothing?(result) ? ["failure",[],0,0,"piece-owner-released"] : record_get(owner,"hits") > hits ? [result[0],result[1],0,0,"reused"] : result;
   };
  }
  def qtlc-release-index(index) {
   let pieces = len(index) > 11 ? reuse-release(index[11]) : 1;
   let rows = qtf2r-release(index); pieces && rows;
  }
 }
}
