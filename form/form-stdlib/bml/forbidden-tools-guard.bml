// forbidden-tools-guard.bml — Claude Code's PreToolUse hook input, read; the refusal, written.
//
// The repo does not use sed, awk, perl or python (CLAUDE.md, AGENTS.md). This organ is the reading behind the door
// observe/forbidden-tools-guard.bml: hkg-verdict(text) takes the hook's JSON (one object with tool_name and
// tool_input.command) and answers either "" (nothing to say) or one line of JSON that refuses the call:
//   {"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"..."}}
// A refusal needs all of: tool_name is Bash or Monitor (the two tools that take a shell command), a command string arrived of
// at most 200000 bytes, and form-stdlib/bml/command-words.bml reads a forbidden command word in it. A reading that did not arrive (empty or garbled text, no command field, a string cut
// short) answers "": the guard fails open and says nothing; it never blocks work on its own failure.
//
// The JSON is read in place, by bytes, as far as the two fields need: a value is skipped by its shape (a string to its
// closing quote, an object or array to its closing bracket) and the command string is unescaped (\n \t \" \\ \uXXXX;
// a code point above 127 reads as ?). parse-json is not used: it mints a node into the shared field for every value,
// and this runs before every Bash call.
// preludes: form-stdlib/core.fk form-stdlib/bml/command-words.bml
section [form.bml] {
 class ForbiddenToolsGuard {
  def hkg-b(s, n, i) = i >= 0 && i < n ? str_byte_at(s, i) : -1;
  def hkg-ws(s, i) = scan_run(s, i, 0);
  // the closing quote of the string whose first byte is at i, or -1 when the text ends first
  def hkg-qend(s, n, i) {
   let j = scan_run(s, i, 4);
   j >= n ? -1 : str_byte_at(s, j) == 34 ? j : hkg-qend(s, n, j + 2);
  }
  def hkg-after(e) = e < 0 ? -1 : e + 1;
  def hkg-delim?(b) = b == 44 || b == 125 || b == 93 || b == 32 || b == 10 || b == 13 || b == 9;
  def hkg-scalar(s, n, i) = i >= n ? n : hkg-delim?(str_byte_at(s, i)) ? i : hkg-scalar(s, n, i + 1);
  def hkg-nest-q(s, n, e, d) = e < 0 ? -1 : hkg-nest(s, n, e + 1, d);
  def hkg-nest(s, n, i, d) {
   let b = hkg-b(s, n, i);
   b < 0 ? -1
   : b == 34 ? hkg-nest-q(s, n, hkg-qend(s, n, i + 1), d)
   : b == 123 || b == 91 ? hkg-nest(s, n, i + 1, d + 1)
   : b == 125 || b == 93 ? (d == 1 ? i + 1 : hkg-nest(s, n, i + 1, d - 1))
   : hkg-nest(s, n, i + 1, d);
  }
  // the index just past the value that starts at i, or -1
  def hkg-skip(s, n, i) {
   let b = hkg-b(s, n, i);
   b == 34 ? hkg-after(hkg-qend(s, n, i + 1))
   : b == 123 || b == 91 ? hkg-nest(s, n, i + 1, 1)
   : b < 0 ? -1
   : hkg-scalar(s, n, i);
  }
  // the first byte of the value of `key` in the object that opens at i, or -1
  def hkg-get(s, n, i, key) {
   let j = hkg-ws(s, i);
   hkg-b(s, n, j) == 123 ? hkg-pairs(s, n, hkg-ws(s, j + 1), key) : -1;
  }
  def hkg-pairs(s, n, i, key) {
   let e = hkg-b(s, n, i) == 34 ? hkg-qend(s, n, i + 1) : -1;
   let c = e < 0 ? -1 : hkg-ws(s, e + 1);
   let v = c >= 0 && hkg-b(s, n, c) == 58 ? hkg-ws(s, c + 1) : -1;
   v < 0 ? -1 : (String) substring(s, i + 1, e) == key ? v : hkg-next(s, n, hkg-skip(s, n, v), key);
  }
  def hkg-next(s, n, after, key) {
   let d = after < 0 ? -1 : hkg-ws(s, after);
   d >= 0 && hkg-b(s, n, d) == 44 ? hkg-pairs(s, n, hkg-ws(s, d + 1), key) : -1;
  }
  // a string value, unescaped, or nothing
  def hkg-hexv(b) = b >= 48 && b <= 57 ? b - 48 : b >= 97 && b <= 102 ? b - 87 : b >= 65 && b <= 70 ? b - 55 : 0;
  def hkg-hex4(t, i) = hkg-hexv(str_byte_at(t, i)) * 4096 + hkg-hexv(str_byte_at(t, i + 1)) * 256 + hkg-hexv(str_byte_at(t, i + 2)) * 16 + hkg-hexv(str_byte_at(t, i + 3));
  def hkg-esc(c) = c == 110 ? byte_to_str(10) : c == 116 ? byte_to_str(9) : c == 114 ? byte_to_str(13) : c == 98 ? byte_to_str(8) : c == 102 ? byte_to_str(12) : byte_to_str(c);
  def hkg-cp(cp) = cp < 128 ? byte_to_str(cp) : "?";
  def hkg-unescape(t) = hkg-unesc(t, 0, len(t), []);
  def hkg-unesc(t, i, n, acc) {
   let j = scan_run(t, i, 4);
   let a = j > i ? cons(substring(t, i, j), acc) : acc;
   j >= n ? str-spans(reverse(a)) : hkg-escape(t, j, n, a);
  }
  def hkg-escape(t, j, n, a) {
   let c = hkg-b(t, n, j + 1);
   c == 117 && j + 6 <= n ? hkg-unesc(t, j + 6, n, cons(hkg-cp(hkg-hex4(t, j + 2)), a))
   : c < 0 ? str-spans(reverse(cons("\\", a)))
   : hkg-unesc(t, j + 2, n, cons(hkg-esc(c), a));
  }
  def hkg-text(s, n, v) {
   let e = hkg-b(s, n, v) == 34 ? hkg-qend(s, n, v + 1) : -1;
   e < 0 ? nothing() : hkg-unescape(substring(s, v + 1, e));
  }
  def hkg-field(s, n, i, key) {
   let v = hkg-get(s, n, i, key);
   v < 0 ? nothing() : hkg-text(s, n, v);
  }
  // the command of a Bash or Monitor call (both carry a shell command in tool_input.command), or nothing
  def hkg-tool?(name) = (String) name == "Bash" || (String) name == "Monitor";
  def hkg-command(text) {
   let n = len(text);
   let name = hkg-field(text, n, 0, "tool_name");
   let ti = nothing?(name) ? -1 : hkg-tool?(name) ? hkg-get(text, n, 0, "tool_input") : -1;
   let cv = ti < 0 ? -1 : hkg-get(text, n, ti, "command");
   cv < 0 ? nothing() : hkg-text(text, n, cv);
  }

  // ---- the refusal
  def hkg-uniq(xs, acc) = nil?(xs) ? reverse(acc) : cw-in?(acc, xs[0]) ? hkg-uniq(xs[1:], acc) : hkg-uniq(xs[1:], cons(xs[0], acc));
  def hkg-join(xs, sep) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : xs[0] ++ sep ++ hkg-join(xs[1:], sep);
  def hkg-reason(names) = "sed/awk/perl/python is not used here (this command runs: " ++ hkg-join(names, ", ") ++ "): edit with the Edit tool, read with the Read tool, search with Grep or git grep, probe and count with ./fkwu cells and BML (docs/form-native-agent-tools.md); a missing internal tool is written into the body, not borrowed.";
  def hkg-deny(reason) = "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"" ++ reason ++ "\"}}";
  def hkg-line(names) = nil?(names) ? "" : hkg-deny(hkg-reason(hkg-uniq(names, [])));
  // a command over hkg-cap bytes passes unread: a reading that long is not an agent's command, and the walk's cost grows with it
  def hkg-cap() = 200000;
  def hkg-verdict(text) {
   let cmd = hkg-command(text);
   nothing?(cmd) || len(cmd) > hkg-cap() ? "" : hkg-line(cw-forbidden(cw-words(cmd)));
  }
  // the door's allow path: stdout is closed, so the answer fkwu prints for every program is lost and nothing arrives
  def hkg-quiet() {
   let closed = file_close(1);
   "";
  }
  def hkg-answer(text) {
   let line = hkg-verdict(text);
   len(line) > 0 ? line : hkg-quiet();
  }
 }
}
