// Independent sine/cosine policy for the numerical oracle. The observed
// |theta|<=8 arithmetic stays stable; larger finite angles use a derived
// pi/2 interval. This policy does not claim correctly rounded host trig.
// preludes: form/form-stdlib/bml/native-angle.bml form-stdlib/bml/dsv4-numeric-reference.bml
section [form.bml] {
 class Dsv4Angle {
  def dsa-pair(owner,x) = if le(abs(x),8.0) then list(dnr-sin(x),dnr-cos(x)) else dsa-large(owner,x);
  def dsa-large(owner,x) {
   let prior = if record_has(owner,"angle-context") then record_get(owner,"angle-context") else nothing();
   let ctx = if nothing?(prior) then na-context(64) else prior;
   if nothing?(prior) then record_set(owner,"angle-context",ctx) else 0;
   na-pair(na-reduce(ctx,x));
  }
 }
 0;
}
