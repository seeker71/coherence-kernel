// Replace existing report values atomically. Model text chooses every edit;
// this carrier proves addressing and retention, never semantic correctness.
// preludes: form-stdlib/bml/form-agent-tool-wire.bml form-stdlib/sha256.fk form-stdlib/hex.fk
section [form.bml] {
 class FormCliReportAmend {
  def fcra-id(text) = hex-encode(sha256-stream-string(text));
  def fcra-unique(pairs,seen) = nil?(pairs) ? 1 : fat-has(seen,json-pair-key(head(pairs))) ? 0 : (fcra-unambiguous(json-pair-value(head(pairs))) && fcra-unique(tail(pairs),cons(json-pair-key(head(pairs)),seen)));
  def fcra-items(xs) = nil?(xs) ? 1 : (fcra-unambiguous(head(xs)) && fcra-items(tail(xs)));
  def fcra-unambiguous(n) = fat-wire-object?(n) ? fcra-unique(json-object-pairs(n),list()) : fat-wire-array?(n) ? fcra-items(node_children(n)) : 1;
  def fcra-fail(note) = list(0,json-node-null(),note);
  def fcra-ok(n) = list(1,n,"");
  def fcra-changed(before,result) = !head(result) ? result : faj-equal(before,result[1]) ? fcra-fail("amendment leaves the report values unchanged; make a concrete correction to the retained failed report") : result;
  def fcra-index(n,size) = !((String) faj-type(n) == "number") ? 0 : !((String) value_kind(node_value(n)) == "int") ? 0 : ((node_value(n) >= 0) && (node_value(n) < size));
  def fcra-replace(n,path,value) = nil?(path) ? fcra-ok(value) : fat-wire-object?(n) ? (!fat-wire-string?(head(path)) ? fcra-fail("object path needs a string key") : !json-object-has?(n,node_value(head(path))) ? fcra-fail("replacement key is absent") : fcra-object(n,path,value,fcra-replace(json-object-get(n,node_value(head(path))),tail(path),value))) : fat-wire-array?(n) ? (!fcra-index(head(path),len(node_children(n))) ? fcra-fail("array path needs an existing integer index") : fcra-array(n,path,fcra-replace(node_children(n)[node_value(head(path))],tail(path),value))) : fcra-fail("replacement path crosses a scalar");
  def fcra-object(n,path,value,result) = !head(result) ? result : fcra-ok(json-node-object(faj-put-pair(json-object-pairs(n),json-node-pair(node_value(head(path)),result[1]))));
  def fcra-array(n,path,result) = !head(result) ? result : fcra-ok(json-node-array(append(append(fat-take(node_children(n),node_value(head(path))),list(result[1])),fat-drop(node_children(n),node_value(head(path)) + 1))));
  def fcra-select(n,path) = nil?(path) ? fcra-ok(n) : fat-wire-object?(n) ? (!fat-wire-string?(head(path)) ? fcra-fail("object path needs a string key") : !json-object-has?(n,node_value(head(path))) ? fcra-fail("replacement key is absent") : fcra-select(json-object-get(n,node_value(head(path))),tail(path))) : fat-wire-array?(n) ? (!fcra-index(head(path),len(node_children(n))) ? fcra-fail("array path needs an existing integer index") : fcra-select(node_children(n)[node_value(head(path))],tail(path))) : fcra-fail("replacement path crosses a scalar");
  def fcra-text-value(value,old,new) = !fat-wire-string?(value) ? fcra-fail("text edit path needs a string value") : (String) old == "" ? fcra-fail("text edit old text is empty") : (String) old == new ? fcra-fail("text edit leaves its value unchanged") : {
   let text = node_value(value); let at = str_find(text,old,0);
   at < 0 ? fcra-fail("text edit old text is absent") : str_find(text,old,at + 1) >= 0 ? fcra-fail("text edit old text is ambiguous") : fcra-ok(json-node-string(ne-replace-first(text,old,new)));
  };
  def fcra-text(n,path,old,new) {
   let selected = fcra-select(n,path);
   !head(selected) ? selected : {
    let edited = fcra-text-value(selected[1],old,new);
    !head(edited) ? edited : fcra-replace(n,path,edited[1]);
   };
  };
  def fcra-prefix(a,b) = nil?(a) ? 1 : nil?(b) ? 0 : (node_eq(head(a),head(b)) && fcra-prefix(tail(a),tail(b)));
  def fcra-overlap(path,seen) = nil?(seen) ? 0 : ((fcra-prefix(path,head(seen)) || fcra-prefix(head(seen),path)) || fcra-overlap(path,tail(seen)));
  def fcra-edits(n,rows,seen) = fcra-edits-as(n,rows,seen,0);
  def fcra-edits-as(n,rows,seen,textOnly) = nil?(rows) ? fcra-ok(n) : {
   let row = head(rows);
   let path = json-object-get(row,"path");
   let shape = fat-wire-object?(row) && (fat-wire-array?(path) && (textOnly ? (((Comparable) len(json-object-pairs(row)) == 3) && (fat-wire-string?(json-object-get(row,"old")) && fat-wire-string?(json-object-get(row,"new")))) : (((Comparable) len(json-object-pairs(row)) == 2) && json-object-has?(row,"value"))));
   !shape ? fcra-fail(textOnly ? "each text edit needs only path, string old and string new" : "each replacement needs only path and value") : nil?(node_children(path)) || (len(node_children(path)) > 32) ? fcra-fail("replacement path needs 1 to 32 segments") : fcra-overlap(node_children(path),seen) ? fcra-fail("replacement paths overlap") : {
    let edited = textOnly ? fcra-text(n,node_children(path),node_value(json-object-get(row,"old")),node_value(json-object-get(row,"new"))) : fcra-replace(n,node_children(path),json-object-get(row,"value"));
    !head(edited) ? edited : fcra-edits-as(edited[1],tail(rows),cons(node_children(path),seen),textOnly);
   };
  };
  // Result [available, candidate JSON node, diagnostic]. All failures leave the
  // caller's retained bytes intact. Array insertion/deletion is not this door.
  def fcra-apply(text,message) = !faj-valid(text) ? fcra-fail("retained report is not JSON") : !(fat-wire-object?(message) && fcra-unambiguous(message)) ? fcra-fail("amendment must be an unambiguous object") : !(((Comparable) len(json-object-pairs(message)) == 1) && json-object-has?(message,"report_amend")) ? fcra-fail("report_amend must be the only message key") : {
   let report = parse-json("retained-report",text);
   let amendment = json-object-get(message,"report_amend");
   let base = json-object-get(amendment,"base");
   let textOnly = json-object-has?(amendment,"text_edits");
   let edits = json-object-get(amendment,textOnly ? "text_edits" : "replacements");
   !(fat-wire-object?(report) && fcra-unambiguous(report)) ? fcra-fail("retained report must be an unambiguous object") : !(fat-wire-object?(amendment) && ((Comparable) len(json-object-pairs(amendment)) == 2)) ? fcra-fail("report_amend needs base and either replacements or text_edits") : !(fat-wire-string?(base) && ((String) node_value(base) == fcra-id(text))) ? fcra-fail("amendment base does not match the retained report bytes") : !fat-wire-array?(edits) ? fcra-fail("amendment edits must be an array") : nil?(node_children(edits)) || (len(node_children(edits)) > 32) ? fcra-fail("amendment needs 1 to 32 edits") : fcra-changed(report,fcra-edits-as(report,node_children(edits),list(),textOnly));
  };
 }
 0;
}
