// Existing Form authorities emit in one fkwu process. No generated source.
// preludes: form/native/metal/dsv4-stack-real.fk form/form-stdlib/bml/dsv4-oracle-input.bml form/form-stdlib/bml/metal-fp32-compensated.bml form/form-stdlib/bml/dsv4-proof-metadata.bml form/form-stdlib/bml/dsv4-proof-output.bml
section [form.bml] {
 class Dsv4ProofEmission {
  def dse-catalog() = list(
   list("dsv4-embed-msl","form_dsv4_embed_f16",dsv4-embed-source,"dsv4emb"),
   list("dsv4-mla-unit","form_mla_rmsnorm_f32",mla-msl-unit,"dsv4mla"),
   list("dsv4-mx8-matvec-msl","form_dsv4_mx8_matvec",dsv4-mx8-matvec-source,"dsv4mx8"),
   list("dsv4-mla-core-msl","form_dsv4_mx8_matvec_grouped",dsv4-mla-core-source,"dsv4core"),
   list("dsv4-hc-unit","form_hc_split_f32",hc-msl-unit,"dsv4hc"),
   list("dsv4-mx4-matvec-msl","form_dsv4_mx4_matvec",dsv4-mx4-matvec-source,"dsv4mx4"),
   list("dsv4-iq2-matvec-msl","form_dsv4_iq2_matvec",dsv4-iq2-matvec-source,"dsv4iq2"),
   list("dsv4-router-f16-msl","form_dsv4_router_f16",dsv4-router-f16-source,"dsv4rt"),
   list("dsv4-ffn-unit","form_dsv4_hash_weights",dsv4-ffn-source,"dsv4ffn"),
   list("dsv4-stack-ffn-unit","form_dsv4_topk_weights",dsv4-stack-ffn-source,"dsv4stkffn"),
   list("dsv4-stack-kv-unit","form_dkv_append_f32",dsv4-stack-kv-source,"dsv4stkkv"));
  def dse-find(name,rows) = if nil?(rows) then nothing() else if str_eq(name,head(head(rows))) then head(rows) else dse-find(name,tail(rows));
  def dse-fields(fields) = if not(and(fbc-list?(fields),and(eq(len(fields),5),dqi-strings(fields)))) then dqi-refused("five complete text fields required") else if not(and(str_eq(head(fields),"DSE1"),str_eq(nth(fields,4),"END"))) then dqi-refused("proof emission framing") else dse-typed(nth(fields,1),nth(fields,2),nth(fields,3));
  def dse-detail(subject,detail) = or(str_eq(detail,""),or(and(str_eq(subject,"dsv4-hc-unit"),str_eq(detail,"hc-precision")),and(str_eq(subject,"dsv4-mla-core-msl"),str_eq(detail,"core-precision"))));
  def dse-typed(operation,subject,detail) = if str_eq(operation,"shader") then if or(not(dse-detail(subject,detail)),nothing?(dse-find(subject,dse-catalog()))) then dqi-refused("unknown shader or unexpected detail") else dse-ready(operation,subject,detail) else if not(or(str_eq(operation,"manifest"),str_eq(operation,"array"))) then dqi-refused("unknown proof emission operation") else if not(dqi-path(subject)) then dqi-refused("nonempty NUL-free model path required") else if str_eq(operation,"manifest") then if str_eq(detail,"") then dse-ready(operation,subject,detail) else dqi-refused("manifest detail must be empty") else if dqi-path(detail) then dse-ready(operation,subject,detail) else dqi-refused("nonempty NUL-free metadata array key required");
  def dse-ready(operation,subject,detail) = record_new(0,"ready",1,"reason","complete native proof emission request","operation",operation,"subject",subject,"detail",detail);
  def dse-nul(fields) = if not(and(eq(len(fields),6),str_eq(nth(fields,5),""))) then dqi-refused("five NUL-terminated fields required") else dse-fields(dnr-take(fields,5));
  def dse-json(bytes) = if not(and(fbc-utf8(bytes,0),jwa-valid(bytes))) then dqi-refused("complete framed UTF8 JSON required") else dse-json-node(parse-json("proof-emission",bytes));
  def dse-json-node(node) = if not(node_eq(node_category(node),JSON-ARRAY())) then dqi-refused("framed emission request must be an array") else dse-fields(dsi-json-fields(json-array-elements(node),list()));
  def dse-framed(bytes,size) = if or(lt(size,0),not(eq(size,sub(str_len(bytes),8)))) then dqi-refused("exactly one complete length-framed request required") else dse-json(substring(bytes,8,str_len(bytes)));
  def dse-parse(bytes) = if eq(str_find(bytes,str_concat("DSE1",byte_to_str(0)),0),0) then dse-nul(split-on(dsi-without-final-lf(bytes),byte_to_str(0))) else dse-framed(bytes,npp-frame-size(bytes));
  def dse-reading(request,aspect,ok) = oh-reading("dsv4-proof-emission",str_concat("emission-",str_concat(int_to_str(host_pid()),str_concat("-",int_to_str(now_unix_ms())))),aspect,json-node-int(1),json-node-int(ok),json-node-int(ok),list(),list("continue","abstain"),json-node-object(list(oh-s("reason",record_get(request,"reason")),oh-s("operation",if record_has(request,"operation") then record_get(request,"operation") else "unadmitted"))));
  def dse-admit(request) {
   let ok = eq(record_get(request,"ready"),1); let row = dse-reading(request,"request-admission",ok); oh-voice(row); let response = oh-response(row,if ok then "continue" else "abstain"); oh-voice(response); let selected = oh-select(row,response,"abstain"); oh-voice(oh-applied(row,selected,json-node-string(if ok then "native authority selected" else "no output emitted")));
   dfo-require(and(ok,str_eq(selected,"continue")),record_get(request,"reason")); request;
  }
  def dse-shader(row) {
   let source = nth(row,2); dso-write(str_concat("MSL\n",str_concat(source(),"\nEND\n")));
  }
  def dse-precision(detail) {
   let hc = str_eq(detail,"hc-precision"); let text = str_concat(if hc then hc-msl-unit() else dsv4-mla-core-source(),str_concat("\n",if hc then mfc-hc-fragment() else mfc-core-fragment()));
   dso-write(str_concat("MSL\n",str_concat(text,"END\n")));
  }
  def dse-dispatch(request) = if str_eq(record_get(request,"operation"),"shader") then if str_eq(record_get(request,"detail"),"") then dse-shader(dse-find(record_get(request,"subject"),dse-catalog())) else dse-precision(record_get(request,"detail")) else dse-metadata(request,dsm-open(record_get(request,"subject")));
  def dse-metadata(request,r) = dso-write(if str_eq(record_get(request,"operation"),"manifest") then dsm-manifest(r) else dsm-array(r,record_get(request,"detail")));
  def dse-run(request) {
   dse-admit(request); dse-dispatch(request);
  }
 }
 0;
}
