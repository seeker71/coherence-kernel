// Shared repair outcome grammar. The production healer offers each round to
// native session LoRA; the separate Qwen activation-space witness uses this
// grammar as an explicitly different experimental objective.
import form-stdlib/bml/form-cli-heal-policy.bml;
import form-stdlib/json.fk;
import form-stdlib/model-registry.bml;
section [form.bml] {
    class FormCliHealLearning {
        def fhl-message(role, text) = json-node-object([json-node-pair("role", json-node-string(role)), json-node-pair("content", json-node-string(text))]);
        def fhl-row(route, outcome, observation) = json-emit(json-node-object([json-node-pair("messages", json-node-array([fhl-message("user", ("Report the observed Form repair round for route " + route)), fhl-message("assistant", fh-cat(["Observed outcome: ", outcome, ".\n", observation]))]))]));
        def fhl-outcome(result) = if ((Comparable) result == 1) then "verified-repair" else if ((Comparable) result == -1) then "refused-input-change" else "unresolved";
        // This is a neural adapter update under an activation-space objective.
        // Serving promotion requires independent repair evaluation.
        def fhl-state(evaluation, enabled) = if evaluation then "evaluation-excluded" else if enabled then "training-required" else "learner-not-enabled";
    }
    0;
}
