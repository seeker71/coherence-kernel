// Each non-evaluation model/check round teaches its observed outcome locally.
// A failed proposal is an observed failure, never a positive repair target.
// The local MLX learner has its own base and adapter; it is not Qwen's head.
// preludes: form-stdlib/bml/form-cli-heal-policy.bml form-stdlib/json.fk form-stdlib/model-registry.bml
section [form.bml] {
    class FormCliHealLearning {
        field HealLearnerConfig = ".form-heal/learning-enabled";
        field HealLearnerModel = "llama32-3b-mlx-4bit";
        field HealLearnerPython = "/Users/ursmuff/.mlx-venv/bin/python";
        field HealLearnerSeed = "form/form-stdlib/adapters/llama-3.2-3b-voice";
        field HealLearnerValidation = "model/fixtures/form-bml-exec-finetune/valid.jsonl";
        field HealLearnerSeconds = 0;
        def fhl-message(role, text) = json-node-object(list(json-node-pair("role", json-node-string(role)), json-node-pair("content", json-node-string(text))));
        def fhl-row(route, outcome, observation) = json-emit(json-node-object(list(json-node-pair("messages", json-node-array(list(fhl-message("user", str_concat("Report the observed Form repair round for route ", route)), fhl-message("assistant", fh-cat(list("Observed outcome: ", outcome, ".\n", observation)))))))));
        def fhl-outcome(result) = if eq(result, 1) then "verified-repair" else if eq(result, -1) then "refused-input-change" else "unresolved";
        def fhl-command(model, data, candidate, parent) = list("env", "HF_HUB_OFFLINE=1", "TRANSFORMERS_OFFLINE=1", "TOKENIZERS_PARALLELISM=false", HealLearnerPython(), "-u", "-m", "mlx_lm", "lora", "--model", model, "--config", str_concat(HealLearnerSeed(), "/adapter_config.json"), "--train", "--data", data, "--adapter-path", candidate, "--resume-adapter-file", parent, "--iters", "1", "--batch-size", "1", "--learning-rate", "0.00001", "--optimizer", "sgd", "--mask-prompt", "--max-seq-length", "2048", "--steps-per-report", "1", "--steps-per-eval", "1", "--val-batches", "-1", "--save-every", "1", "--test", "--test-batches", "-1");
        // This is outcome distillation and a neural weight update. Automatic
        // serving promotion still requires an independent repair evaluation.
        def fhl-state(evaluation, enabled) = if evaluation then "evaluation-excluded" else if enabled then "training-required" else "learner-not-enabled";
    }
    0;
}
