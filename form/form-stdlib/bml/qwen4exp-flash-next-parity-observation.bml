//////////////////////////////////////////////////////////////////////
// qwen4exp-flash-next-parity-observation.bml -- what the 90% claim can say.
//
// Full-model rates below are prior physical, same-host, exact-artifact
// measurements.  Today's bounded re-observation does not open another 79 GB
// context while a resident owner stands and no serving schedule changed.
// The free-page pool, swap, and system memory-pressure reading remain separate
// observations. Model-free Metal fixtures are useful JIT readiness evidence,
// never substituted for end-to-end token throughput.
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class Qwen4ExpFlashNextParityObservation [public, observable] {
        field Q4PModel = "Qwen3.8-Flash-Next UD-Q2_K_XL";
        field Q4PHost = "Apple M4 Max 128 GB unified";
        field Q4PArtifactBytes = 78869128864;
        field Q4PDecodeOracle = 26580;
        field Q4PDecodeFloor = 23922;
        field Q4PDecodeForm = 12188;
        field Q4PPrefillOracle = 318830;
        field Q4PPrefillFloor = 286947;
        field Q4PPrefillForm = 12340;
        field Q4PDecodeSampleTokens = 64;
        field Q4PPrefillOracleTokens = 5632;
        field Q4PPrefillFormTokens = 64;
        field Q4PFreePagePoolMiB = 1391;
        field Q4PMemoryPressureFreePercent = 93;
        field Q4PPhysicalSwapUsedMiB = 3223;
        field Q4PResidentOwner = 1;
        field Q4PPerformanceChangeSinceRate = 0;
        field Q4PQuantFixtureFirstMs = 5430;
        field Q4PGraphFixtureFirstMs = 6170;
        field Q4PQuantFixtureReuseMs = 130;
        field Q4PGraphFixtureReuseMs = 410;
        field Q4PSourceReceipt = "receipts-2026-08-31-qwen38-native-voice";

        def q4p-percent-x1000(rate, oracle) = if le(oracle, 0) then nothing() else div(mul(rate, 100000), oracle);
        def q4p-gap(floor, actual) = if ge(actual, floor) then 0 else sub(floor, actual);
        def q4p-accepted(actual, floor) = if ge(actual, floor) then 1 else 0;
        def q4p-decode-comparability() = "comparable-same-host-artifact-64-token-window";
        def q4p-prefill-comparability() = "threshold-only-sample-length-mismatch";
        def q4p-user-m5-comparability() = "incomparable-host-context-and-speculative-decode";
        def q4p-rerun-decision(residentOwner, performanceChanged) = if not(eq(performanceChanged, 1)) then "withheld-no-performance-change" else if eq(residentOwner, 1) then "needs-quiet-owner-window" else "admissible";
        def q4p-observed-rerun-decision() = q4p-rerun-decision(Q4PResidentOwner(), Q4PPerformanceChangeSinceRate());
        def q4p-observed-status() = if and(eq(q4p-accepted(Q4PDecodeForm(), Q4PDecodeFloor()), 1), eq(q4p-accepted(Q4PPrefillForm(), Q4PPrefillFloor()), 1)) then "within-10-percent-proven" else "performance-gate-failed";
        def q4p-jit-readiness-status() = if and(le(Q4PQuantFixtureReuseMs(), 5000), le(Q4PGraphFixtureReuseMs(), 5000)) then "reuse-within-attention" else "reuse-over-attention";
        def q4p-end-to-end-moved-by-this-lane() = 0;
    }
    0;
}
