// Read-only model mapping admitted by a Form-emitted Darwin ARM64 syscall leaf.
// No input byte crosses the boxed string pool when a numerical leaf borrows it.
// preludes: form-stdlib/bml/native-fp64-matrix.bml
section [form.bml] {
 class Dsv4FileMap {
  def dqf-image() {
   let rows = list(fa-add-x-imm(4,0,0),fa-add-x-imm(5,2,0),fa-movz-x(0,0),fa-movz-x(2,1),fa-movz-x(3,2),fa-movz-x(16,197),fa-movk-x-16(16,512),fa-svc(128),npd-branch(3,"done"),fa-asm(3405774848,list(1,32,65536),list(0,31,0)),npd-label("done"),fa-ret());
   fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
  }
  def dqf-open(path) {
   if not(str_eq(value_kind(path),"string")) then nothing() else if ge(str_find(path,byte_to_str(0),0),0) then nothing() else dqf-open-extent(path,file_size(path));
  }
  def dqf-open-extent(path,extent) = if not(and(str_eq(value_kind(extent),"int"),gt(extent,0))) then nothing() else dqf-admit(dqf-owner(path,extent));
  def dqf-owner(path,extent) {
   let memory = npd-open(); let image = dqf-image();
   let owner = record_new(0,"kind","read-only-model-map","pid",host_pid(),"path",path,"extent",extent,"active",1,"ready",0,"memory",memory,"code-live",0,"fd",-1,"region",nothing(),"memory-closed",0,"failure","");
   let identity = intern_node(make_nodeid(31,2,0,183),cons(intern_trivial_string("form-readonly-file-map-v1"),cons(intern_trivial_int(owner),npd-nodes(image)))); record_set(owner,"identity",identity); record_set(owner,"request",list(0,identity,image));
   owner;
  }
  def dqf-kind(owner) = and(record?(owner),and(str_eq(record_get(owner,"kind"),"read-only-model-map"),eq(record_get(owner,"pid"),host_pid())));
  def dqf-ready(owner) = if not(dqf-kind(owner)) then 0 else and(eq(record_get(owner,"active"),1),and(eq(record_get(owner,"ready"),1),npd-active(record_get(owner,"memory"))));
  def dqf-admit(owner) {
   let fd = npd-file-open(record_get(owner,"memory"),record_get(owner,"path"),0);
   if or(nothing?(fd),lt(fd,0)) then dqf-fail(owner,"read-only file descriptor admission") else dqf-admit-fd(owner,fd);
  }
  def dqf-admit-fd(owner,fd) {
   record_set(owner,"fd",fd); let pointer = jit_leaf_inram(record_get(owner,"request"),list(fd,record_get(owner,"extent"),0));
   if not(nothing?(pointer)) then record_set(owner,"code-live",1) else 0;
   if or(nothing?(pointer),le(pointer,0)) then dqf-fail(owner,"read-only file mapping admission") else dqf-admit-map(owner,pointer);
  }
  def dqf-admit-map(owner,pointer) {
   let region = npd-region-ready(record_get(owner,"memory"),pointer,record_get(owner,"extent")); record_set(region,"read-only",1); record_set(owner,"region",region);
   let descriptor = dqf-close-fd(owner);
   if not(eq(descriptor,1)) then dqf-fail(owner,"mapped input descriptor release") else if not(eq(file_size(record_get(owner,"path")),record_get(owner,"extent"))) then dqf-fail(owner,"mapped source extent changed during admission") else dqf-admitted(owner);
  }
  def dqf-admitted(owner) {
   record_set(owner,"ready",1); owner;
  }
  def dqf-fail(owner,reason) {
   record_set(owner,"failure",reason); let closed = dqf-close(owner); record_set(owner,"admission-released",closed); owner;
  }
  def dqf-span(owner,offset,bytes) = if not(dqf-ready(owner)) then nothing() else if not(eq(file_size(record_get(owner,"path")),record_get(owner,"extent"))) then nothing() else npd-owned-span(record_get(owner,"memory"),record_get(owner,"region"),offset,bytes);
  def dqf-close(owner) {
   if nothing?(owner) then 1 else if not(dqf-kind(owner)) then nothing() else if eq(record_get(owner,"active"),0) then 1 else dqf-close-owned(owner);
  }
  def dqf-close-fd(owner) {
   let fd = record_get(owner,"fd"); let closed = if eq(fd,-1) then 0 else npd-file-close(record_get(owner,"memory"),fd);
   if eq(closed,0) then record_set(owner,"fd",-1) else 0; if eq(closed,0) then 1 else nothing();
  }
  def dqf-close-code(owner) {
   let state = record_get(owner,"code-live"); let closed = if eq(state,2) then 2 else jit_leaf_inram(list(1,record_get(owner,"identity"),list()),0);
   if eq(closed,state) then record_set(owner,"code-live",2) else 0; if eq(closed,state) then 1 else nothing();
  }
  def dqf-close-owned(owner) {
   record_set(owner,"ready",0); let descriptor = dqf-close-fd(owner); let region = npd-region-close(record_get(owner,"region")); let code = dqf-close-code(owner);
   let memory = if not(and(eq(descriptor,1),eq(region,0))) then nothing() else if eq(record_get(owner,"memory-closed"),1) then 1 else npd-close(record_get(owner,"memory"));
   if eq(memory,1) then record_set(owner,"memory-closed",1) else 0;
   if and(eq(code,1),eq(memory,1)) then dqf-closed(owner) else nothing();
  }
  def dqf-closed(owner) {
   record_set(owner,"active",0); 1;
  }
 }
 0;
}
