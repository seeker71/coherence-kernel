package Form.glass.observer;

import Form.kernel.*;
import Form.native.*;

interface IFormGlassObserver [public, witness, reusable] {
   section [public] {
      const String Schema = "form-glass-observer-v2";
      const String TruthRule = "every metric carries physical-live, derived-window, catalog, declared, or unavailable evidence";
      const String PresenceRule = "presence is explicit; absent never becomes zero and a missing text field never becomes a present empty string";
      const String MissingDoorRule = "every unavailable metric carries one exact missing observation door in its source field plus a separate reason; generic missing-carrier buckets are forbidden";
      const String SemanticZeroRule = "measured zero names its scope and meaning as empty, drained, idle, or quiet; a nonexistent timestamp is none-empty rather than Unix epoch zero";
      const String FramebufferCounterRule = "framebuffer-events is the live current-process root list and now fills visible roots, attributed, entered, accepted, and last-index; rejected remains unavailable on kernel_stat:11 because refused roots never enter that list; kernel_stat 9 through 14 stay named table-walker doors rather than silent zeros";
      const String NodeIDRule = "metric and telemetry selector strings are never presented as NodeIDs; every local metric field is bound to one stable interned Glass NodeID carrying only owner scope, domain, semantic id, value kind, unit, plane, and channel; values, presence, timestamps, sequence, evidence, lifecycle, labels, notes, and impact remain outside identity; external source-nodeid remains unbound at telemetry.nodeid-owner-binding unless the framebuffer row carries its source node object";
      const String ValueEventRule = "a reading is a melt-managed form-glass-value-event-v2 record containing the stable field NodeID, observed epoch, sequence, typed value, truth, source, and impact; age is derived as frame epoch minus observed epoch and is never part of field or event identity";
      const String StatusRule = "carrier status fields match only at byte zero or immediately after newline; a key embedded inside a longer key is not an observation";
      const String PlaneRule = "kernel arena, unified GPU, mapped file, disk cache, OS memory, logical estimate, and unknown remain distinct planes";
      const String ProcessScopeRule = "kernel_stat, framebuffer, Metal, and MLX observations belong to the current fkwu process; the fixed ps observer may additionally name bounded numeric metrics for every visible fkwu PID";
      const String ProcessInventoryRule = "exact-name /usr/bin/pgrep discovers bounded fkwu PID digits; one fixed-schema /bin/ps call per validated PID emits at most 32 processes as RSS bytes, CPU tenths-percent, and elapsed seconds";
      const String ProcessPrivacyRule = "the observer never acquires a whole process table: other-process comm never enters Form, observed fkwu comm is discarded before row construction, and command arguments are neither requested nor emitted";
      const String ProcessCommandRule = "a ps command is constructed only after a nonzero canonical decimal PID of at most 10 digits passes the numeric ceiling; no shell substitution or caller text enters the command";
      const Int MaxProcessCount = 32;
      const Int MaxPidListBytes = 2048;
      const Int MaxPidDigits = 10;
      const String StorageRule = "fkb, sym, dylib, model, and source bytes are a storage catalog and never impersonate resident memory";
      const String SpecializationRule = "fkb, sym, and dylib rows are optional acceleration artifacts; absence leaves source as the dispatch candidate but proves neither demand nor an after-start JIT installer";
      const String SpecializationEvidenceRule = "Glass exposes artifact presence, root compatibility, and source-or-image dispatch candidacy separately; it never infers loader acceptance, names source admission as whole-unit-blocking, and leaves dependency-digest completeness as a loader seam";
      const String HeatRule = "primitive heat is read from per-tag live dispatch counters; known evaluator tags project their runtime names and only unmapped tags retain explicit tag-N form; recipe heat requires source-attributed events or a publisher";
      const String HostRule = "Darwin memory pressure may cross the existing host-exec port but is labeled host-port and cannot establish Metal working-set bytes";
      const String UnknownRule = "blueprint bytes, per-cell bytes, Metal allocation bytes, page residency, and cross-process handles remain unavailable until their exact named carriers publish them";
      const String PrivacyRule = "telemetry carries ids, state, counters, provenance, and controls; never prompt or answer bytes";

      Object Snapshot( String sRoot ) [abstract];
      Object Storage( String sRoot ) [abstract];
      Object PrimitiveHeat() [abstract];
      Object Processes( String sFixedPsTable ) [abstract];
      Object LiveProcesses() [abstract];
   }
}

class FormGlassObserver [public, resident, flow, observable, teach] : IFormGlassObserver {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-observer.bml";
      const String EventCategory = "FORM-GLASS-OBSERVATION-V1";

      Object Snapshot( String sRoot ) [abstract] {}
      Object Storage( String sRoot ) [abstract] {}
      Object PrimitiveHeat() [abstract] {}
      Object Processes( String sFixedPsTable ) [abstract] {}
      Object LiveProcesses() [abstract] {}
   }
}
