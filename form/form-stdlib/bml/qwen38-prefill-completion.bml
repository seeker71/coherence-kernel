// Completion belongs to the executing prefill slice. Positions advance only
// after the carrier settles its work; refusal leaves the owning session intact.
// preludes: form-stdlib/bml/qwen38-open-observation.bml form-stdlib/hearth.bml form-stdlib/organ-health.bml
section [form.bml] {
 class Qwen38PrefillCompletion {
  def q38pc-wait-policy() {
   let live = metal_live();
   // Preserve an existing caller deadline. Sessions without one receive the
   // body's deadline for this carrier lifetime, including subsequent release.
   if and(ge(len(live),14),lt(nth(live,13),0)) then metal_deadline(hearth-metal-deadline-ms()) else 0;
  }
  def q38pc-stage(pos,phase) = q38oo-stage(str_concat("model-prefill-positions-",str_concat(int_to_str(pos),str_concat("-",phase))),8388623);
  def q38pc-settled(live) = if lt(len(live),15) then 0 else and(eq(nth(live,5),0),and(eq(nth(live,6),0),eq(nth(live,14),0)));
  def q38pc-frame(status) = if ge(str_find(status,"wait_frame=timeout\n",0),0) then "timeout" else if ge(str_find(status,"wait_frame=error\n",0),0) then "error" else if ge(str_find(status,"wait_frame=completed\n",0),0) then "completed" else if ge(str_find(status,"wait_frame=released\n",0),0) then "released" else "unobserved";
  def q38pc-sync(pos,count) {
   q38pc-stage(pos,"sync-begin");
   let drained = metal_sync();
   let frame = q38pc-frame(metal_status());
   let live = metal_live();
   let complete = and(gt(drained,0),and(q38pc-settled(live),or(str_eq(frame,"completed"),str_eq(frame,"released"))));
   if complete then 1 else q38pc-refuse(pos,count,drained,frame,live);
  }
  def q38pc-refuse(pos,count,drained,frame,live) {
   let evidence = json-node-object(list(oh-n("completed_positions",pos),oh-n("slice_positions",count),oh-n("drained_dispatches",drained),oh-s("wait_frame",frame),json-node-pair("carrier",json-node-array(oh-ints(live)))));
   let reading = oh-reading("qwen-prefill","native-model-session","slice-completion",json-node-int(1),json-node-int(0),json-node-int(0),list(oh-need("settled-gpu-work",evidence)),list("stop-prefill"),evidence);
   oh-voice(reading);
   let response = oh-response(reading,"stop-prefill");
   oh-voice(response);
   let action = oh-select(reading,response,"");
   q38pc-stage(pos,"refused");
   oh-voice(oh-applied(reading,action,json-node-object(list(oh-n("next_slice_admitted",0),oh-n("prediction_accepted",0)))));
   0;
  }
  def q38pc-head-bytes?(bytes) = if nothing?(bytes) then 0 else if not(str_eq(value_kind(bytes),"string")) then 0 else eq(str_len(bytes),4);
 }
}
