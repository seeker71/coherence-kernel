// A physical JSONL row can exceed the normal collector slice. Keep its bytes
// intact: continue in small reads, admit one whole row, or refuse at a named cap.
section [form.bml] {
 class FormTurnRowWindow {
  def fctr-row-limit(normal) = normal * 4;
  def fctr-read-bytes() = 65536;
  // end >= 0: complete row; -2: continue; -1: bounded refusal.
  def fctr-piece(cursor,body,chunk,limit) {
   let next = chunk ?? "";
   let newline = str_find(next,"\n",0);
   let used = newline < 0 ? str_len(next) : (newline + 1);
   let width = str_len(body) + used;
   ((Comparable) str_len(next) == 0) || (width > limit) ? list(-1,"")
   : list(newline < 0 ? -2 : (cursor + width),body ++ substring(next,0,used));
  }
  def fctr-extend(path,cursor,end,body,limit) {
   let offset = cursor + str_len(body);
   let room = limit - str_len(body);
   let left = end - offset;
   let width = left < fctr-read-bytes() ? left : fctr-read-bytes();
   left <= 0 ? list(offset,body)
   : room <= 0 ? list(-1,"")
   : fctr-next(path,cursor,end,limit,fctr-piece(cursor,body,read_file_slice(path,offset,room < width ? room : width),limit));
  }
  def fctr-next(path,cursor,end,limit,piece) = (Comparable) head(piece) == -2 ? fctr-extend(path,cursor,end,piece[1],limit) : piece;
 }
 0;
}
