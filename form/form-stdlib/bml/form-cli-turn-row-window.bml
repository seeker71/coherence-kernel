// A physical JSONL row can exceed the normal collector slice. Keep its bytes
// intact: continue in small reads, admit one whole row, or refuse at a named cap.
section [form.bml] {
 class FormTurnRowWindow {
  def fctr-row-limit(normal) = mul(normal,4);
  def fctr-read-bytes() = 65536;
  // end >= 0: complete row; -2: continue; -1: bounded refusal.
  def fctr-piece(cursor,body,chunk,limit) {
   let next = if nothing?(chunk) then "" else chunk;
   let newline = str_find(next,"\n",0);
   let used = if lt(newline,0) then str_len(next) else add(newline,1);
   let width = add(str_len(body),used);
   if or(eq(str_len(next),0),gt(width,limit)) then list(-1,"")
   else list(if lt(newline,0) then -2 else add(cursor,width),str_concat(body,substring(next,0,used)));
  }
  def fctr-extend(path,cursor,end,body,limit) {
   let offset = add(cursor,str_len(body));
   let room = sub(limit,str_len(body));
   let left = sub(end,offset);
   let width = if lt(left,fctr-read-bytes()) then left else fctr-read-bytes();
   if le(left,0) then list(offset,body)
   else if le(room,0) then list(-1,"")
   else fctr-next(path,cursor,end,limit,fctr-piece(cursor,body,read_file_slice(path,offset,if lt(room,width) then room else width),limit));
  }
  def fctr-next(path,cursor,end,limit,piece) = if eq(head(piece),-2) then fctr-extend(path,cursor,end,nth(piece,1),limit) else piece;
 }
 0;
}
