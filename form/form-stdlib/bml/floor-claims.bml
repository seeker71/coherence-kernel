// floor-claims.bml — the lines of CURRENT_FLOOR.md that name the command which reads a figure, read as text.
//
// CURRENT_FLOOR.md says "Every line names the command that reads it", and a line of the shape  ./fkwu <cell> [arguments] -> <value>  is one such
// claim. door-link-health checks the page's paths but not its numbers, so nothing re-reads those figures (frq-7b3ab4de4ca80c5a). This file holds
// the pure readers of one line, the first pieces of the door that runs each cheap command and counts the figures that drifted.
section [form.bml] {
 class FloorClaims {
  def fc-line-marker() = "./fkwu ";
  def fc-cell(line) { let at = str_find(line, "./fkwu ", 0); let ws = at < 0 ? [] : split-on(substring(line, at + 7, len(line)), " "); len(ws) == 0 ? "" : ws[0]; }
 }
}
