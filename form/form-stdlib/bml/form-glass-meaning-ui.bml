// The live transcript observer's contract; validation languages never enter it.
class FormGlassMeaningUIContract [public, contract] {
    section [class, public] {
      const String Schema = "form-glass-transcripts-v1";
      const String RosterRule = "natural-language names share the native tongue catalog; first four shortcuts follow its defaults, not programming languages";
      const String SelectionRule = "1-4 toggle English, Portuguese, Persian and Indonesian; 0 clears; l accepts natural-language codes joined by +, all shows published languages; selection affects display only";
      const String RuntimeRule = "paint already-decoded native ear metric rows; never read source files, run validation walkers, translate text, start a model or open a microphone in the render loop";
      const String TranscriptRule = "original speech recognition and local translations carry distinct kinds and their own source stamps; translations may trail the current original and are not quality claims";
      const String AbsenceRule = "absent or silent publishers and missing selected languages remain explicit; no source-code samples or generated placeholders stand in for transcripts";
    }
}
