//////////////////////////////////////////////////////////////////////
//
// bml/form-glass-meaning-ui.bml — the meaning view's interface contract.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassMeaningUIContract {
      const String Schema = "form-glass-meaning-ui-v1";
      const String RosterRule = "the roster is the four dialects that carry BMF categories in the reviewed table -- GO, PY, RS, TS; a fifth dialect enters the view only when its categories enter that table";
      const String SelectionRule = "zero to four dialects are selected at once and the selection is the view filter, so it travels through the existing correlated control offer and opens no second state channel; keys 1 2 3 4 toggle one dialect and 0 clears to zero";
      const String SamplingRule = "nothing in this view is a fixture; each frame reads a bounded window of the real grammar and a bounded window of that language's real source in this tree, and the window's first partial line is dropped before anything is read from it";
      const String ProbeRule = "rules and emitters occupy one region of a grammar, so a single window often holds neither: the probe steps forward window by window with wrap, bounded, and takes the first window carrying the needle rather than reporting absent from one unlucky landing";
      const String MeaningRule = "the meaning of a sampled construct is the category its own emitter interns, and the category's NodeID is read by name from the dialect table with that door named beside it";
      const String AbsenceRule = "a sample that is not found says UNAVAILABLE with its door and reason and is never replaced with a plausible one";
    }
    0;
}
