package Form.cli.universemint;

import Form.kernel.*;
import Form.cli.flow.*;

enum SampleSplit [public] {
   TRAIN,
   HELDOUT
}

interface IUniverseMint [public, witness, reusable] {
   section [public] {
      const int MixA = 7;
      const int MixB = 13;
      const int NSkills = 8;
      const int LoraWriter = 0;
      const String TrustRule = "mint from Form cells; measure heldout; LoRA tensors wait on lift";

      int Mix( int nI, int nMod ) [abstract];
      String Situation( String strClass, int nI, String strSplit ) [abstract];
      int Leakage( Object hRows ) [abstract];
      int Unique( Object hRows ) [abstract];
      int LoraWriterReady() [abstract];
   }
}

template SampleRow<TClass> [public, reusable] {
   section [public] {
      String Split() [get];
      TClass Class() [get];
      String Situation() [get];
   }
}

class FormUniverseMint [public, reusable, teach] : IUniverseMint {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-universe-mint.bml";

      int Mix( int nI, int nMod ) [abstract] {}
      String Situation( String strClass, int nI, String strSplit ) [abstract] {}
      int Leakage( Object hRows ) [abstract] {}
      int Unique( Object hRows ) [abstract] {}
      int LoraWriterReady() [abstract] {}
   }
}

class FormUniverseMintSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-universe-mint-self";
      const String Pattern = "combinatorial-mint heldout-leakage-0 overlay-fit lora-identity-waits";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
