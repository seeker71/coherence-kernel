// One repetition boundary shared by BMF matching and cooperative BML work.
// The caller owns its checkpoint. Only a progressing match offers another pass.
// An absent maximum means unbounded; zero remains an actual empty allowance.
section [form.bml] {
 class BmfRepeat {
  def bmr-at-limit(maximum,count) = if nothing?(maximum) then false else (count >= maximum);
  def bmr-action(maximum,count,matched,advanced) = if bmr-at-limit(maximum,count) then "limit" else if !matched then "end" else if !advanced then "stalled" else "next";
  def bmr-enough(minimum,count) = (count >= minimum);
 }
 0;
}
