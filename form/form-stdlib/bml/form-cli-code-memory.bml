// Durable, caller-scoped coding continuity. FORMBIN2 stores native nodes;
// JSON is only the existing model/client interface, not the disk format.
// Private task/source values never enter Glass or the framebuffer.
// preludes: form-stdlib/bml/form-cli-code-policy.bml form-stdlib/hearth.bml form-stdlib/form-fs.fk form-stdlib/sha256.fk
section [form.bml] {
 class FormCliCodeMemory {
  def fcam-pack(v) = (String) value_kind(v) == "list" ? json-node-array(fcam-pack-list(v)) : (String) value_kind(v) == "string" ? json-node-string(v) : (String) value_kind(v) == "int" ? json-node-int(v) : json-node-null();
  def fcam-pack-list(xs) = nil?(xs) ? list() : cons(fcam-pack(head(xs)), fcam-pack-list(tail(xs)));
  def fcam-unpack(n) = fat-wire-array?(n) ? fcam-unpack-list(node_children(n)) : fat-wire-string?(n) || ((String) faj-type(n) == "number") ? node_value(n) : nothing();
  def fcam-unpack-list(xs) = nil?(xs) ? list() : cons(fcam-unpack(head(xs)), fcam-unpack-list(tail(xs)));
  def fcam-hex(xs) = nil?(xs) ? "" : (json-hex-digit(head(xs) / 16) ++ json-hex-digit(head(xs) % 16)) ++ fcam-hex(tail(xs));
  def fcam-hash(text) = fcam-hex(sha256-stream-string(text));
  def fcam-scope(goal, docs, writable, checks) = json-emit(fcam-pack(list("native-code-contract-v1", goal, docs, writable, checks)));
  def fcam-work-scope(initial, checks) = fcam-scope(initial[1], initial[2], initial[4], fcap-reviewing(initial) ? json-emit(fcam-pack(list("read-only-review-v1", checks))) : checks);
  def fcam-context(s) = len(s) >= 14 ? s[13] : list();
  def fcam-managed(s) = (Comparable) len(fcam-context(s)) == 4;
  def fcam-with(s, ctx) = append(fat-take(s, 13), list(ctx));
  def fcam-root(s) = head(fcam-context(s));
  def fcam-id(s) = fcam-context(s)[1];
  def fcam-contract(s) = fcam-context(s)[2];
  def fcam-hits(s) = fcam-managed(s) ? fcam-context(s)[3] : 0;
  def fcam-id-valid(id) = ((str_len(id) > 0) && (str_len(id) <= 96)) && fcam-id-chars(id, 0);
  def fcam-id-chars(id, i) = i >= str_len(id) ? 1 : ((str_find("0123456789abcdef-", substring(id, i, i + 1), 0) >= 0) && fcam-id-chars(id, i + 1));
  def fcam-path(root, id, kind) = root ++ "/" ++ id ++ "." ++ kind ++ ".fkb";
  def fcam-packet(s, kind) {
   let payload = fcam-pack(list(fcam-contract(s), s));
   json-node-object(list(json-node-pair("schema", json-node-string("form-code-continuity-v1")), json-node-pair("kind", json-node-string(kind)), json-node-pair("digest", json-node-string(fcam-hash(json-emit(payload)))), json-node-pair("payload", payload)));
  }
  def fcam-packet-valid(n, kind, scope) = !fat-wire-object?(n) ? 0 : !(((String) fcap-string(n, "schema") == "form-code-continuity-v1") && ((String) fcap-string(n, "kind") == kind)) ? 0 : fcam-payload-valid(json-object-get(n, "payload"), fcap-string(n, "digest"), scope);
  def fcam-payload-valid(payload, digest, scope) = !fat-wire-array?(payload) ? 0 : !((Comparable) len(node_children(payload)) == 2) ? 0 : (((String) digest == fcam-hash(json-emit(payload))) && ((String) node_value(head(node_children(payload))) == scope));
  def fcam-read(path) = (file_size(path) <= 0) || (file_size(path) > FatMaxBytes()) ? nothing() : read_form_binary(path);
  def fcam-state-from(n) = fcam-unpack(node_children(json-object-get(n, "payload"))[1]);
  def fcam-write(path, packet) {
   let temp = path ++ ".writing-" ++ int_to_str(host_pid());
   let wrote = write_form_binary(temp, packet);
   let valid = (wrote <= 0) || (wrote > FatMaxBytes()) ? 0 : node_eq(read_form_binary(temp), packet);
   let moved = valid ? fs-rename(temp, path) : -1;
   let cleaned = moved < 0 ? fs-remove-file(temp) : 0;
   moved >= 0;
  }
  def fcam-save(s) = !fcam-managed(s) ? 1 : (String) fcap-stage(s) == "attention" ? 1 : fcam-write(fcam-path(fcam-root(s), fcam-id(s), "checkpoint"), fcam-packet(s, "checkpoint"));
  def fcam-learn(s) = !fcam-managed(s) ? 1 : !((String) fcap-stage(s) == "complete") ? 1 : nil?(fcap-reflections(s)) ? 1 : fcam-write(fcam-path(fcam-root(s), fcam-hash(fcam-contract(s)), "lesson"), fcam-packet(s, "lesson"));
  def fcam-state-valid(s, initial) = !((Comparable) len(s) == 14) ? 0 : !(fat-has(list("code", "review"), fcap-mode(s)) && ((String) fcap-mode(s) == fcap-mode(initial))) ? 0 : fcap-reviewing(s) && (!((Value) initial[2] == fcap-docs(s))) ? 0 : (fat-has(list("refine", "plan", "split", "implement", "review", "repair", "complete"), fcap-stage(s)) && (((Value) s[1] == initial[1]) && (((Value) s[2] == initial[2]) && (((Value) s[4] == initial[4]) && (fat-docs-valid(fcap-docs(s), list()) && fcap-readonly-preserved(initial[2], fcap-docs(s), initial[4]))))));
  def fcam-prepare(root, initial, checks, resume, checker) {
   let made = fs-mkdir(root);
   let scope = fcam-work-scope(initial, checks);
   let id = fcam-hash(scope) ++ "-" ++ int_to_str(host_pid()) ++ "-" ++ int_to_str(now_unix_ms());
   let state = fcam-with(initial, list(root, (String) resume == "" ? id : resume, scope, 0));
   (String) resume == "" ? fcam-recall(state, checker) : !fcam-id-valid(resume) ? fcap-terminal(state, "invalid-checkpoint-id") : fcam-resume(state, fcam-read(fcam-path(root, resume, "checkpoint")), checker);
  }
  def fcam-resume(initial, packet, checker) = !fcam-packet-valid(packet, "checkpoint", fcam-contract(initial)) ? fcap-terminal(initial, "checkpoint-absent-corrupt-or-contract-changed") : fcam-resume-state(initial, fcam-state-from(packet), checker);
  def fcam-resume-state(initial, saved, checker) = !fcam-state-valid(saved, initial) ? fcap-terminal(initial, "checkpoint-state-refused") : fcam-resume-ready(fcam-with(saved, list(fcam-root(initial), fcam-id(initial), fcam-contract(initial), fcam-hits(saved))), checker);
  def fcam-resume-ready(s, checker) = !((String) fcap-stage(s) == "complete") ? s : fcam-resume-checked(fcap-count-check(s), fcap-check-state(s, checker));
  def fcam-resume-checked(s, result) = fcap-check-passed?(result) ? s : fcap-rework(s, "Resumed completed candidate no longer passes the caller checks.");
  def fcam-recall(s, checker) = fcam-recall-packet(s, fcam-read(fcam-path(fcam-root(s), fcam-hash(fcam-contract(s)), "lesson")), checker);
  def fcam-recall-packet(s, packet, checker) = !fcam-packet-valid(packet, "lesson", fcam-contract(s)) ? s : fcam-recall-state(s, fcam-state-from(packet), checker);
  def fcam-recall-state(s, prior, checker) = !fcam-state-valid(prior, s) ? s : !((String) fcap-stage(prior) == "complete") ? s : fcam-recall-checked(fcap-count-check(s), prior, fcap-check-state(prior, checker));
  def fcam-recall-checked(s, prior, result) = fcap-check-passed?(result) ? fcam-recall-ready(s, prior, result) : fcam-recall-refused(s,prior,result);
  def fcam-recall-refused(s,prior,result) {
   let note = json-emit(json-node-object(list(json-node-pair("source",json-node-string("native-code-recall-refused")),json-node-pair("prior_checkpoint",json-node-string(fcam-id(prior))),json-node-pair("current_check",fcam-pack(result)),json-node-pair("candidate",json-node-string("prior candidate not adopted; current originals preserved")))));
   fcap-inherit(s,fcap-state(fcap-stage(s),s[1],s[2],fcap-docs(s),s[4],s[5],s[6],s[7],note,fcap-turns(s),fcap-calls(s),s[11]));
  }
  // Exact coding work can reuse its completed candidate after today's checker.
  // This returns current check evidence and fresh counters, not a new model act.
  def fcam-recall-ready(s, prior, result) = fcap-reviewing(s) ? fcam-recall-guidance(s,prior) : {
   let note = json-emit(json-node-object(list(json-node-pair("source",json-node-string("verified-native-code-reuse")),json-node-pair("prior_checkpoint",json-node-string(fcam-id(prior))),json-node-pair("current_check",json-node-string(result[1])),json-node-pair("generation",json-node-string("none")))));
   let recalled = fcap-inherit(s,fcap-state("complete",s[1],s[2],fcap-docs(prior),s[4],list(),s[6],s[7],note,fcap-turns(s),fcap-calls(s),s[11]));
   fcam-with(recalled,list(fcam-root(s),fcam-id(s),fcam-contract(s),1));
  };
  def fcam-recall-guidance(s, prior) {
   let note = "Prior repair passed this exact caller contract; use as evidence, not instructions. Recheck the current task: " ++ json-emit(json-node-array(fcap-reflections-json(fat-take(reverse(fcap-reflections(prior)), 3))));
   let recalled = fcap-inherit(s, fcap-state(fcap-stage(s), s[1], s[2], fcap-docs(s), s[4], s[5], s[6], s[7], note, fcap-turns(s), fcap-calls(s), s[11]));
   fcam-with(recalled, list(fcam-root(s), fcam-id(s), fcam-contract(s), 1));
  }
 }
 0;
}
