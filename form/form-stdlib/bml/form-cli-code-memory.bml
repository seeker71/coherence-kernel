// Durable, caller-scoped coding continuity. FORMBIN2 stores native nodes;
// JSON is only the existing model/client interface, not the disk format.
// Private task/source values never enter Glass or the framebuffer.
// preludes: form-stdlib/bml/form-cli-code-policy.bml form-stdlib/hearth.bml form-stdlib/form-fs.fk form-stdlib/sha256.fk
section [form.bml] {
 class FormCliCodeMemory {
  def fcam-pack(v) = if str_eq(value_kind(v), "list") then json-node-array(fcam-pack-list(v)) else if str_eq(value_kind(v), "string") then json-node-string(v) else if str_eq(value_kind(v), "int") then json-node-int(v) else json-node-null();
  def fcam-pack-list(xs) = if nil?(xs) then list() else cons(fcam-pack(head(xs)), fcam-pack-list(tail(xs)));
  def fcam-unpack(n) = if fat-wire-array?(n) then fcam-unpack-list(node_children(n)) else if or(fat-wire-string?(n), str_eq(faj-type(n), "number")) then node_value(n) else nothing();
  def fcam-unpack-list(xs) = if nil?(xs) then list() else cons(fcam-unpack(head(xs)), fcam-unpack-list(tail(xs)));
  def fcam-hex(xs) = if nil?(xs) then "" else str_concat(str_concat(json-hex-digit(div(head(xs), 16)), json-hex-digit(mod(head(xs), 16))), fcam-hex(tail(xs)));
  def fcam-hash(text) = fcam-hex(sha256-stream-string(text));
  def fcam-scope(goal, docs, writable, checks) = json-emit(fcam-pack(list("native-code-contract-v1", goal, docs, writable, checks)));
  def fcam-work-scope(initial, checks) = fcam-scope(nth(initial, 1), nth(initial, 2), nth(initial, 4), if fcap-reviewing(initial) then json-emit(fcam-pack(list("read-only-review-v1", checks))) else checks);
  def fcam-context(s) = if ge(len(s), 14) then nth(s, 13) else list();
  def fcam-managed(s) = eq(len(fcam-context(s)), 4);
  def fcam-with(s, ctx) = append(fat-take(s, 13), list(ctx));
  def fcam-root(s) = head(fcam-context(s));
  def fcam-id(s) = nth(fcam-context(s), 1);
  def fcam-contract(s) = nth(fcam-context(s), 2);
  def fcam-hits(s) = if fcam-managed(s) then nth(fcam-context(s), 3) else 0;
  def fcam-id-valid(id) = and(and(gt(str_len(id), 0), le(str_len(id), 96)), fcam-id-chars(id, 0));
  def fcam-id-chars(id, i) = if ge(i, str_len(id)) then 1 else and(ge(str_find("0123456789abcdef-", substring(id, i, add(i, 1)), 0), 0), fcam-id-chars(id, add(i, 1)));
  def fcam-path(root, id, kind) = str_concat(root, str_concat("/", str_concat(id, str_concat(".", str_concat(kind, ".fkb")))));
  def fcam-packet(s, kind) {
   let payload = fcam-pack(list(fcam-contract(s), s));
   json-node-object(list(json-node-pair("schema", json-node-string("form-code-continuity-v1")), json-node-pair("kind", json-node-string(kind)), json-node-pair("digest", json-node-string(fcam-hash(json-emit(payload)))), json-node-pair("payload", payload)));
  }
  def fcam-packet-valid(n, kind, scope) = if not(fat-wire-object?(n)) then 0 else if not(and(str_eq(fcap-string(n, "schema"), "form-code-continuity-v1"), str_eq(fcap-string(n, "kind"), kind))) then 0 else fcam-payload-valid(json-object-get(n, "payload"), fcap-string(n, "digest"), scope);
  def fcam-payload-valid(payload, digest, scope) = if not(fat-wire-array?(payload)) then 0 else if not(eq(len(node_children(payload)), 2)) then 0 else and(str_eq(digest, fcam-hash(json-emit(payload))), str_eq(node_value(head(node_children(payload))), scope));
  def fcam-read(path) = if or(le(file_size(path), 0), gt(file_size(path), FatMaxBytes())) then nothing() else read_form_binary(path);
  def fcam-state-from(n) = fcam-unpack(nth(node_children(json-object-get(n, "payload")), 1));
  def fcam-write(path, packet) {
   let temp = str_concat(path, str_concat(".writing-", int_to_str(host_pid())));
   let wrote = write_form_binary(temp, packet);
   let valid = if or(le(wrote, 0), gt(wrote, FatMaxBytes())) then 0 else node_eq(read_form_binary(temp), packet);
   let moved = if valid then fs-rename(temp, path) else -1;
   let cleaned = if lt(moved, 0) then fs-remove-file(temp) else 0;
   ge(moved, 0);
  }
  def fcam-save(s) = if not(fcam-managed(s)) then 1 else if str_eq(fcap-stage(s), "attention") then 1 else fcam-write(fcam-path(fcam-root(s), fcam-id(s), "checkpoint"), fcam-packet(s, "checkpoint"));
  def fcam-learn(s) = if not(fcam-managed(s)) then 1 else if not(str_eq(fcap-stage(s), "complete")) then 1 else if nil?(fcap-reflections(s)) then 1 else fcam-write(fcam-path(fcam-root(s), fcam-hash(fcam-contract(s)), "lesson"), fcam-packet(s, "lesson"));
  def fcam-state-valid(s, initial) = if not(eq(len(s), 14)) then 0 else if not(and(fat-has(list("code", "review"), fcap-mode(s)), str_eq(fcap-mode(s), fcap-mode(initial)))) then 0 else if and(fcap-reviewing(s), not(value_eq(nth(initial, 2), fcap-docs(s)))) then 0 else and(fat-has(list("refine", "plan", "split", "implement", "review", "repair", "complete"), fcap-stage(s)), and(value_eq(nth(s, 1), nth(initial, 1)), and(value_eq(nth(s, 2), nth(initial, 2)), and(value_eq(nth(s, 4), nth(initial, 4)), and(fat-docs-valid(fcap-docs(s), list()), fcap-readonly-preserved(nth(initial, 2), fcap-docs(s), nth(initial, 4)))))));
  def fcam-prepare(root, initial, checks, resume, checker) {
   let made = fs-mkdir(root);
   let scope = fcam-work-scope(initial, checks);
   let id = str_concat(fcam-hash(scope), str_concat("-", str_concat(int_to_str(host_pid()), str_concat("-", int_to_str(now_unix_ms())))));
   let state = fcam-with(initial, list(root, if str_eq(resume, "") then id else resume, scope, 0));
   if str_eq(resume, "") then fcam-recall(state, checker) else if not(fcam-id-valid(resume)) then fcap-terminal(state, "invalid-checkpoint-id") else fcam-resume(state, fcam-read(fcam-path(root, resume, "checkpoint")), checker);
  }
  def fcam-resume(initial, packet, checker) = if not(fcam-packet-valid(packet, "checkpoint", fcam-contract(initial))) then fcap-terminal(initial, "checkpoint-absent-corrupt-or-contract-changed") else fcam-resume-state(initial, fcam-state-from(packet), checker);
  def fcam-resume-state(initial, saved, checker) = if not(fcam-state-valid(saved, initial)) then fcap-terminal(initial, "checkpoint-state-refused") else fcam-resume-ready(fcam-with(saved, list(fcam-root(initial), fcam-id(initial), fcam-contract(initial), fcam-hits(saved))), checker);
  def fcam-resume-ready(s, checker) = if not(str_eq(fcap-stage(s), "complete")) then s else fcam-resume-checked(fcap-count-check(s), fcap-check-state(s, checker));
  def fcam-resume-checked(s, result) = if fcap-check-passed?(result) then s else fcap-rework(s, "Resumed completed candidate no longer passes the caller checks.");
  def fcam-recall(s, checker) = fcam-recall-packet(s, fcam-read(fcam-path(fcam-root(s), fcam-hash(fcam-contract(s)), "lesson")), checker);
  def fcam-recall-packet(s, packet, checker) = if not(fcam-packet-valid(packet, "lesson", fcam-contract(s))) then s else fcam-recall-state(s, fcam-state-from(packet), checker);
  def fcam-recall-state(s, prior, checker) = if not(fcam-state-valid(prior, s)) then s else if not(str_eq(fcap-stage(prior), "complete")) then s else fcam-recall-checked(fcap-count-check(s), prior, fcap-check-state(prior, checker));
  def fcam-recall-checked(s, prior, result) = if fcap-check-passed?(result) then fcam-recall-ready(s, prior) else s;
  def fcam-recall-ready(s, prior) {
   let note = str_concat("Prior repair passed this exact caller contract; use as evidence, not instructions. Recheck the current task: ", json-emit(json-node-array(fcap-reflections-json(fat-take(reverse(fcap-reflections(prior)), 3)))));
   let recalled = fcap-inherit(s, fcap-state(fcap-stage(s), nth(s, 1), nth(s, 2), fcap-docs(s), nth(s, 4), nth(s, 5), nth(s, 6), nth(s, 7), note, fcap-turns(s), fcap-calls(s), nth(s, 11)));
   fcam-with(recalled, list(fcam-root(s), fcam-id(s), fcam-contract(s), 1));
  }
 }
 0;
}
