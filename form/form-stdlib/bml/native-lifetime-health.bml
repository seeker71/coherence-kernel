// Bounded release observations live with the owner. The health stream carries
// each row; the framebuffer carries its marker. Callers can also read owner health.
// Only resource state and opaque owner identity travel, never captured bytes.
// preludes: form-stdlib/organ-health.bml
section [form.bml] {
 class NativeLifetimeHealth {
  def nlh-retry(owner) {
   let prior = record_get(owner, "health");
   if not(record_has(owner, "health")) then 1 else if not(oh-valid(prior)) then 0
   else if not(oh-pain(prior)) then 1 else nlh-retry-offered(owner, prior);
  }
  def nlh-retry-offered(owner, prior) {
   let response = oh-response(prior, "retry-release");
   let selected = oh-select(prior, response, "retain");
   record_set(owner, "health-prior", prior);
   record_set(owner, "health-response", response);
   oh-voice(response);
   str_eq(selected, "retry-release");
  }
  def nlh-result(owner, organ, released) {
   let prior = record_get(owner, "health-prior");
   if not(record_has(owner, "health-prior")) then 0 else nlh-applied(owner, prior, released);
   let serial = record_get(owner, "health-serial");
   let next = if not(record_has(owner, "health-serial")) then 1 else add(serial, 1);
   record_set(owner, "health-serial", next);
   let row = oh-reading(organ, int_to_str(owner), "release",
    json-node-string("released"), json-node-string(if released then "released" else "retained"),
    json-node-int(if released then 1 else 0),
    if released then list() else list(oh-need("native-release-confirmation", json-node-null())),
    if released then list() else list("retry-release", "retain", "request-evidence"), json-node-null());
   let identified = oh-set(row, "id", json-node-string(str_concat(oh-str(row, "id"), str_concat(":", int_to_str(next)))));
   record_set(owner, "health", identified);
   oh-voice(identified);
   released;
  }
  def nlh-applied(owner, prior, released) {
   let applied = oh-applied(prior, "retry-release", json-node-int(released));
   record_set(owner, "health-applied", applied);
   oh-voice(applied);
   released;
  }
 }
 0;
}
