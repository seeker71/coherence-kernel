package Form.native.modelactions;

import Form.kernel.*;
import Form.native.models.*;
import Form.native.modeltokens.*;

interface INativeModelFormActionProtocol [public, witness, reusable] {
   section [public] {
      const String Schema = "native-model-form-action-protocol-v1";
      const String FullyEnabledRule = "enabled means vocabulary assigned, proposal encoded, route known, and native gate present; it never means unconstrained model actuation";
      const String AdmissionRule = "every proposal is an offer; effectful routes also require Node-ID, interface, and protocol before native admission";
      const String ExecutionRule = "a local model proposes an inert Hermes-compatible tool call; Form validates and executes through the witnessed substrate";
      const String HealingRule = "unknown words, unavailable models, missing contracts, and missing Node-IDs return a typed healing signal with a next action";
      const String AliasRule = "crystalize is accepted at ingress and canonicalized to crystallize";
      const int NativeWordCount = 20;

      bool Admit( String strModelId, String strWord, String strNodeId, String strInterface, String strProtocol, int nOffered ) [abstract];
      String Route( String strWord ) [abstract];
      String CanonicalToolName( String strWord ) [abstract];
      String HealingSignal( String strModelId, String strWord ) [abstract];
   }
}

class NativeModelFormActionProtocol [public, reusable, flow, teach, observable] : INativeModelFormActionProtocol {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-form-action-protocol.bml";
      const String WireProtocol = "form-agent-protocol/Hermes-tool-call";
      const String NativeAuthority = "Form-validator-world-evaluator";

      bool Admit( String strModelId, String strWord, String strNodeId, String strInterface, String strProtocol, int nOffered ) [abstract] {}
      String Route( String strWord ) [abstract] {}
      String CanonicalToolName( String strWord ) [abstract] {}
      String HealingSignal( String strModelId, String strWord ) [abstract] {}
   }
}
