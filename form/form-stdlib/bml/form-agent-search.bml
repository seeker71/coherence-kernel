// rg-shaped resident source search. No path is opened or inventoried.
// preludes: form-stdlib/core.fk form-stdlib/shell-exec.fk form-stdlib/bml/form-agent-pattern.bml
section [form.bml] {
    class FormAgentSearch {
        def far-get(options, key, fallback) = if nil?(options) then fallback else if ((String) head(head(options)) == key) then head(options)[1] else far-get(tail(options), key, fallback);
        def far-set(options, key, value) = cons([key, value], options);
        def far-push(options, key, value) = far-set(options, key, cons(value, far-get(options, key, [])));
        def far-parse(args, options, positional) = if nil?(args) then [options, ""] else far-parse-at(args, options, positional);
        def far-parse-at(args, options, positional) {
            let arg = head(args);
            if ((!positional) && ((String) arg == "--")) then far-parse(tail(args), options, 1)
            else if (((String) arg == "-") && (!nil?(far-get(options, "patterns", [])))) then far-parse(tail(args), far-push(options, "paths", arg), positional)
            else if ((!positional) && fat-has(["-e", "--regexp", "-g", "--glob", "-m", "--max-count", "-A", "-B", "-C"], arg)) then far-option-value(args, options)
            else if ((!positional) && ((String) arg == "--files")) then far-parse(tail(args), far-set(options, "mode", "files"), 0)
            else if ((!positional) && fat-has(["--no-heading", "--line-buffered", "--color=never"], arg)) then far-parse(tail(args), options, 0)
            else if ((!positional) && fat-has(["--ignore-case", "--fixed-strings", "--line-number", "--files-with-matches", "--count", "--quiet", "--word-regexp", "--invert-match", "--column"], arg)) then far-long(args, options)
            else if ((!positional) && fat-starts(arg, "-")) then far-short(args, options, arg, 1)
            else if (nil?(far-get(options, "patterns", [])) && (!((String) far-get(options, "mode", "lines") == "files"))) then far-parse(tail(args), far-push(options, "patterns", arg), positional)
            else far-parse(tail(args), far-push(options, "paths", arg), positional);
        }
        def far-long(args, options) {
            let arg = head(args);
            if ((String) arg == "--column") then far-parse(tail(args), far-set(far-set(options, "column", 1), "number", 1), 0)
            else far-parse(cons(if ((String) arg == "--ignore-case") then "-i" else if ((String) arg == "--fixed-strings") then "-F" else if ((String) arg == "--line-number") then "-n" else if ((String) arg == "--files-with-matches") then "-l" else if ((String) arg == "--count") then "-c" else if ((String) arg == "--quiet") then "-q" else if ((String) arg == "--word-regexp") then "-w" else "-v", tail(args)), options, 0);
        }
        def far-short(args, options, flags, i) = if (i >= str_len(flags)) then if ((Comparable) i == 1) then [options, "unsupported-rg-option"] else far-parse(tail(args), options, 0) else far-short-at(args, options, flags, i, byte_to_str(fat-char(flags, i)));
        def far-short-at(args, options, flags, i, flag) = if fat-has(["i", "F", "n", "w", "v", "S"], flag) then far-short(args, far-set(options, if ((String) flag == "i") then "ic" else if ((String) flag == "F") then "fixed" else if ((String) flag == "n") then "number" else if ((String) flag == "w") then "word" else if ((String) flag == "S") then "smart" else "invert", 1), flags, (i + 1)) else if fat-has(["l", "c", "q"], flag) then far-short(args, far-set(options, "mode", if ((String) flag == "l") then "names" else if ((String) flag == "c") then "count" else "quiet"), flags, (i + 1)) else [options, "unsupported-rg-option"];
        def far-option-value(args, options) = if nil?(tail(args)) then [options, "missing-rg-option-value"] else far-option-ready(head(args), args[1], fat-drop(args, 2), options);
        def far-option-ready(key, value, rest, options) = if (((String) key == "-e") || ((String) key == "--regexp")) then far-parse(rest, far-push(options, "patterns", value), 0) else if (((String) key == "-g") || ((String) key == "--glob")) then if (str_len(value) > FatMaxPattern()) then [options, "glob-limit"] else if (((String) value == "") || (((String) value == "!") || far-unsupported-glob(value, 0))) then [options, "unsupported-glob-syntax"] else far-parse(rest, far-push(options, "globs", value), 0) else if (!fat-natural(value)) then [options, "invalid-rg-number"] else far-option-number(key, str_to_int(value), rest, options);
        def far-unsupported-glob(s, i) = if (i >= str_len(s)) then 0 else if (str_find("[]{}\\", byte_to_str(fat-char(s, i)), 0) >= 0) then 1 else far-unsupported-glob(s, (i + 1));
        def far-option-number(key, value, rest, options) = if ((String) key == "-C") then far-parse(rest, far-set(far-set(options, "before", value), "after", value), 0) else far-parse(rest, far-set(options, if ((String) key == "-A") then "after" else if ((String) key == "-B") then "before" else "max", value), 0);
        def far-literal-tokens(s, i) = if (i >= str_len(s)) then [] else cons(fap-token(0, byte_to_str(fat-char(s, i))), far-literal-tokens(s, (i + 1)));
        def far-patterns(patterns, fixed, out) = if nil?(patterns) then [out, ""] else if (str_len(head(patterns)) > FatMaxPattern()) then [[], "pattern-limit"] else far-pattern-next(patterns, fixed, out, if fixed then [[far-literal-tokens(head(patterns), 0)], ""] else fap-compile(head(patterns)));
        def far-pattern-next(patterns, fixed, out, r) = if (!((String) r[1] == "")) then r else far-patterns(tail(patterns), fixed, append(out, head(r)));
        def far-uppercase(s, i) = if (i >= str_len(s)) then 0 else if ((fat-char(s, i) >= 65) && (fat-char(s, i) <= 90)) then 1 else far-uppercase(s, (i + 1));
        def far-ic(options) = if far-get(options, "ic", 0) then 1 else if far-get(options, "smart", 0) then (!far-uppercase(fat-join(far-get(options, "patterns", []), ""), 0)) else 0;
        def far-paths(paths, path) = if nil?(paths) then 1 else far-path-any(paths, path);
        def far-path-any(paths, path) = if nil?(paths) then 0 else if (((String) head(paths) == ".") || ((((String) head(paths) == "-") && ((String) path == "<stdin>")) || (((String) head(paths) == path) || fat-starts(path, str_concat(head(paths), "/"))))) then 1 else far-path-any(tail(paths), path);
        // A requested source outside the resident catalog is missing evidence.
        // Keep it distinct from an available source containing no match.
        def far-path-present(docs, path) = if (nil?(docs) || ((String) path == "")) then 0 else if far-path-any([path], head(docs)[1]) then 1 else far-path-present(tail(docs), path);
        def far-missing-path(docs, paths) = if nil?(paths) then [] else if far-path-present(docs, head(paths)) then far-missing-path(docs, tail(paths)) else [head(paths)];
        def far-positive(globs) = if nil?(globs) then 0 else if (!fat-starts(head(globs), "!")) then 1 else far-positive(tail(globs));
        // Options are newest first; the last matching glob wins.
        def far-globs(globs, path, fallback) = if nil?(globs) then fallback else far-glob-next(globs, path, fallback, fap-glob(if fat-starts(head(globs), "!") then substring(head(globs), 1, str_len(head(globs))) else head(globs), path));
        def far-glob-next(globs, path, fallback, match) = if (match < 0) then -1 else if match then (!fat-starts(head(globs), "!")) else far-globs(tail(globs), path, fallback);
        def far-admit(options, path) = if (!far-paths(far-get(options, "paths", []), path)) then 0 else far-globs(far-get(options, "globs", []), path, (!far-positive(far-get(options, "globs", []))));
        // Scan rows: line number, text, match start, selected. It retains context
        // once, so overlapping -A/-B/-C windows never duplicate output lines.
        def far-lines(lines, patterns, options, number, count, rows) = if nil?(lines) then [fat-reverse(rows), count, ""] else if (count >= far-get(options, "max", FatMaxBytes())) then far-lines(tail(lines), patterns, options, (number + 1), count, cons([number, head(lines), -1, 0], rows)) else far-line-result(lines, patterns, options, number, count, rows, fap-search(patterns, head(lines), far-ic(options), far-get(options, "word", 0)));
        def far-line-result(lines, patterns, options, number, count, rows, match) = if (match[2] <= 0) then [[], 0, "pattern-work-limit"] else far-line-picked(lines, patterns, options, number, count, rows, head(match), if far-get(options, "invert", 0) then (head(match) < 0) else (head(match) >= 0));
        def far-line-picked(lines, patterns, options, number, count, rows, pos, hit) = far-lines(tail(lines), patterns, options, (number + 1), if hit then (count + 1) else count, cons([number, head(lines), pos, hit], rows));
        def far-hit-numbers(rows) = if nil?(rows) then [] else if head(rows)[3] then cons(head(head(rows)), far-hit-numbers(tail(rows))) else far-hit-numbers(tail(rows));
        def far-near(hits, number, before, after) = if nil?(hits) then 0 else if ((number >= (head(hits) - before)) && (number <= (head(hits) + after))) then 1 else far-near(tail(hits), number, before, after);
        def far-format(row, path, options) {
            let sep = if row[3] then ":" else "-";
            str_concat(path, str_concat(sep, str_concat(if far-get(options, "number", 0) then str_concat(int_to_str(head(row)), sep) else "", str_concat(if (far-get(options, "column", 0) && row[3]) then str_concat(int_to_str((fat-max(0, row[2]) + 1)), sep) else "", str_concat(row[1], "\n")))));
        }
        def far-render(rows, hits, path, options, previous) = if nil?(rows) then "" else if far-near(hits, head(head(rows)), far-get(options, "before", 0), far-get(options, "after", 0)) then str_concat(if ((previous > 0) && ((head(head(rows)) > (previous + 1)) && ((far-get(options, "before", 0) + far-get(options, "after", 0)) > 0))) then "--\n" else "", str_concat(far-format(head(rows), path, options), far-render(tail(rows), hits, path, options, head(head(rows))))) else far-render(tail(rows), hits, path, options, previous);
        def far-run(docs, args) = far-parsed(docs, far-parse(args, [], 0));
        def far-run-input(docs, args, input) = far-parsed-input(docs, input, far-parse(args, [], 0));
        def far-parsed-input(docs, input, parsed) = far-parsed(if ((str_len(input) > 0) || fat-has(far-get(head(parsed), "paths", []), "-")) then [["stdin", "<stdin>", input]] else docs, parsed);
        def far-parsed(docs, parsed) = if (!((String) parsed[1] == "")) then fat-fail(parsed[1], docs) else if (nil?(far-get(head(parsed), "patterns", [])) && (!((String) far-get(head(parsed), "mode", "lines") == "files"))) then fat-fail("rg-needs-pattern", docs) else far-compiled(docs, head(parsed), far-patterns(far-get(head(parsed), "patterns", []), far-get(head(parsed), "fixed", 0), []));
        def far-compiled(docs, options, compiled) = if (!((String) compiled[1] == "")) then fat-fail(compiled[1], docs) else far-sources(docs, options, head(compiled), far-missing-path(docs, far-get(options, "paths", [])));
        def far-sources(docs, options, patterns, missing) = if (!nil?(missing)) then fat-fail(str_concat("resident-search-path-not-found: ", str_concat(head(missing), "; search reads only supplied documents; request the missing source from the caller")), docs) else far-docs(docs, docs, options, patterns, "", 0);
        def far-docs(rest, docs, options, patterns, out, hits) = if nil?(rest) then fat-result(if (hits > 0) then 0 else 1, out, "", docs) else far-doc-admitted(rest, docs, options, patterns, out, hits, far-admit(options, head(rest)[1]));
        def far-doc-admitted(rest, docs, options, patterns, out, hits, admitted) = if (admitted < 0) then fat-fail("glob-work-limit", docs) else if (!admitted) then far-docs(tail(rest), docs, options, patterns, out, hits) else if ((String) far-get(options, "mode", "lines") == "files") then far-docs(tail(rest), docs, options, patterns, str_concat(out, str_concat(head(rest)[1], "\n")), (hits + 1)) else far-doc-scan(rest, docs, options, patterns, out, hits, far-lines(sh-lines(head(rest)[2]), patterns, options, 1, 0, []));
        def far-doc-scan(rest, docs, options, patterns, out, hits, scan) = if (!((String) scan[2] == "")) then fat-fail(scan[2], docs) else far-docs(tail(rest), docs, options, patterns, str_concat(out, if ((Comparable) scan[1] == 0) then "" else far-doc-output(head(rest)[1], options, scan)), (hits + scan[1]));
        def far-doc-output(path, options, scan) = if ((String) far-get(options, "mode", "lines") == "quiet") then "" else if ((String) far-get(options, "mode", "lines") == "names") then str_concat(path, "\n") else if ((String) far-get(options, "mode", "lines") == "count") then str_concat(path, str_concat(":", str_concat(int_to_str(scan[1]), "\n"))) else far-render(head(scan), far-hit-numbers(head(scan)), path, options, 0);
    }
}
