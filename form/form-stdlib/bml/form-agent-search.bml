// rg-shaped resident source search. No path is opened or inventoried.
// Output follows ripgrep's filename rule, the dialect every coding voice was
// taught: one explicit file, or the held input alone, prints no source path;
// several paths, a directory prefix or the whole resident corpus print it.
// -H/--with-filename and -I/--no-filename choose; the last one given wins.
// -l and --files print paths, as ripgrep's do.
import form-stdlib/core.fk;
import form-stdlib/shell-exec.fk;
import form-stdlib/bml/form-agent-pattern.bml;
section [form.bml] {
    class FormAgentSearch {
        def far-get(options, key, fallback) = if nil?(options) then fallback else if ((String) options[0][0] == key) then options[0][1] else far-get(options[1:], key, fallback);
        def far-set(options, key, value) = cons([key, value], options);
        def far-push(options, key, value) = far-set(options, key, cons(value, far-get(options, key, [])));
        def far-parse(args, options, positional) = if nil?(args) then [options, ""] else far-parse-at(args, options, positional);
        def far-parse-at(args, options, positional) {
            let arg = args[0];
            if ((!positional) && ((String) arg == "--")) then far-parse(args[1:], options, 1)
            else if (((String) arg == "-") && (!nil?(far-get(options, "patterns", [])))) then far-parse(args[1:], far-push(options, "paths", arg), positional)
            else if ((!positional) && fat-has(["-e", "--regexp", "-g", "--glob", "-m", "--max-count", "-A", "-B", "-C"], arg)) then far-option-value(args, options)
            else if ((!positional) && ((String) arg == "--files")) then far-parse(args[1:], far-set(options, "mode", "files"), 0)
            else if ((!positional) && fat-has(["--no-heading", "--line-buffered", "--color=never"], arg)) then far-parse(args[1:], options, 0)
            else if ((!positional) && fat-has(["--ignore-case", "--fixed-strings", "--line-number", "--files-with-matches", "--count", "--quiet", "--word-regexp", "--invert-match", "--column", "--with-filename", "--no-filename"], arg)) then far-long(args, options)
            else if ((!positional) && fat-starts(arg, "-")) then far-short(args, options, arg, 1)
            else if (nil?(far-get(options, "patterns", [])) && (!((String) far-get(options, "mode", "lines") == "files"))) then far-parse(args[1:], far-push(options, "patterns", arg), positional)
            else far-parse(args[1:], far-push(options, "paths", arg), positional);
        }
        def far-long(args, options) {
            let arg = args[0];
            if ((String) arg == "--column") then far-parse(args[1:], far-set(far-set(options, "column", 1), "number", 1), 0)
            else far-parse(cons(if ((String) arg == "--ignore-case") then "-i" else if ((String) arg == "--fixed-strings") then "-F" else if ((String) arg == "--line-number") then "-n" else if ((String) arg == "--files-with-matches") then "-l" else if ((String) arg == "--count") then "-c" else if ((String) arg == "--quiet") then "-q" else if ((String) arg == "--word-regexp") then "-w" else if ((String) arg == "--with-filename") then "-H" else if ((String) arg == "--no-filename") then "-I" else "-v", args[1:]), options, 0);
        }
        def far-short(args, options, flags, i) = if (i >= len(flags)) then if ((Comparable) i == 1) then [options, "unsupported-rg-option"] else far-parse(args[1:], options, 0) else far-short-at(args, options, flags, i, byte_to_str(fat-char(flags, i)));
        def far-short-at(args, options, flags, i, flag) = if fat-has(["i", "F", "n", "w", "v", "S"], flag) then far-short(args, far-set(options, if ((String) flag == "i") then "ic" else if ((String) flag == "F") then "fixed" else if ((String) flag == "n") then "number" else if ((String) flag == "w") then "word" else if ((String) flag == "S") then "smart" else "invert", 1), flags, (i + 1)) else if fat-has(["l", "c", "q"], flag) then far-short(args, far-set(options, "mode", if ((String) flag == "l") then "names" else if ((String) flag == "c") then "count" else "quiet"), flags, (i + 1)) else if fat-has(["H", "I"], flag) then far-short(args, far-set(options, "filename", if ((String) flag == "H") then 1 else 0), flags, (i + 1)) else [options, "unsupported-rg-option"];
        def far-option-value(args, options) = if nil?(args[1:]) then [options, "missing-rg-option-value"] else far-option-ready(args[0], args[1], fat-drop(args, 2), options);
        def far-option-ready(key, value, rest, options) = if (((String) key == "-e") || ((String) key == "--regexp")) then far-parse(rest, far-push(options, "patterns", value), 0) else if (((String) key == "-g") || ((String) key == "--glob")) then if (((String) value == "") || (((String) value == "!") || far-unsupported-glob(value, 0))) then [options, "unsupported-glob-syntax"] else far-parse(rest, far-push(options, "globs", value), 0) else if (!fat-natural(value)) then [options, "invalid-rg-number"] else far-option-number(key, str_to_int(value), rest, options);
        def far-unsupported-glob(s, i) = if (i >= len(s)) then 0 else if (str_find("[]{}\\", byte_to_str(fat-char(s, i)), 0) >= 0) then 1 else far-unsupported-glob(s, (i + 1));
        def far-option-number(key, value, rest, options) = if ((String) key == "-C") then far-parse(rest, far-set(far-set(options, "before", value), "after", value), 0) else far-parse(rest, far-set(options, if ((String) key == "-A") then "after" else if ((String) key == "-B") then "before" else "max", value), 0);
        def far-literal-tokens(s, i) = if (i >= len(s)) then [] else cons(fap-token(0, byte_to_str(fat-char(s, i))), far-literal-tokens(s, (i + 1)));
        def far-patterns(patterns, fixed, out) = if nil?(patterns) then [out, ""] else far-pattern-next(patterns, fixed, out, if fixed then [[far-literal-tokens(patterns[0], 0)], ""] else fap-compile(patterns[0]));
        def far-pattern-next(patterns, fixed, out, r) = if (!((String) r[1] == "")) then r else far-patterns(patterns[1:], fixed, append(out, r[0]));
        def far-uppercase(s, i) = if (i >= len(s)) then 0 else if ((fat-char(s, i) >= 65) && (fat-char(s, i) <= 90)) then 1 else far-uppercase(s, (i + 1));
        def far-ic(options) = if far-get(options, "ic", 0) then 1 else if far-get(options, "smart", 0) then (!far-uppercase(fat-join(far-get(options, "patterns", []), ""), 0)) else 0;
        def far-paths(paths, path) = if nil?(paths) then 1 else far-path-any(paths, path);
        def far-path-any(paths, path) = if nil?(paths) then 0 else if (((String) paths[0] == ".") || ((((String) paths[0] == "-") && ((String) path == "<stdin>")) || (((String) paths[0] == path) || fat-starts(path, (paths[0] + "/"))))) then 1 else far-path-any(paths[1:], path);
        // A requested source outside the resident catalog is missing evidence.
        // Keep it distinct from an available source containing no match.
        def far-path-present(docs, path) = if (nil?(docs) || ((String) path == "")) then 0 else if far-path-any([path], docs[0][1]) then 1 else far-path-present(docs[1:], path);
        def far-missing-path(docs, paths) = if nil?(paths) then [] else if far-path-present(docs, paths[0]) then far-missing-path(docs, paths[1:]) else [paths[0]];
        def far-positive(globs) = if nil?(globs) then 0 else if (!fat-starts(globs[0], "!")) then 1 else far-positive(globs[1:]);
        // Options are newest first; the last matching glob wins.
        def far-globs(globs, path, fallback) = if nil?(globs) then fallback else far-glob-next(globs, path, fallback, fap-glob(if fat-starts(globs[0], "!") then substring(globs[0], 1, len(globs[0])) else globs[0], path));
        def far-glob-next(globs, path, fallback, match) = if match then (!fat-starts(globs[0], "!")) else far-globs(globs[1:], path, fallback);
        def far-admit(options, path) = if (!far-paths(far-get(options, "paths", []), path)) then 0 else far-globs(far-get(options, "globs", []), path, (!far-positive(far-get(options, "globs", []))));
        // Scan rows: line number, text, match start, selected. It retains context
        // once, so overlapping -A/-B/-C windows never duplicate output lines.
        def far-lines(lines, patterns, options, number, count, rows) = if nil?(lines) then [fat-reverse(rows), count, ""] else if (count >= far-get(options, "max", FatMaxBytes())) then far-lines(lines[1:], patterns, options, (number + 1), count, cons([number, lines[0], -1, 0], rows)) else far-line-result(lines, patterns, options, number, count, rows, fap-search-program(patterns, lines[0], far-ic(options)));
        def far-line-result(lines, patterns, options, number, count, rows, match) = far-line-picked(lines, patterns, options, number, count, rows, match[0], if far-get(options, "invert", 0) then (match[0] < 0) else (match[0] >= 0));
        def far-line-picked(lines, patterns, options, number, count, rows, pos, hit) = far-lines(lines[1:], patterns, options, (number + 1), if hit then (count + 1) else count, cons([number, lines[0], pos, hit], rows));
        def far-hit-numbers(rows) = if nil?(rows) then [] else if rows[0][3] then cons(rows[0][0], far-hit-numbers(rows[1:])) else far-hit-numbers(rows[1:]);
        def far-near(hits, number, before, after) = if nil?(hits) then 0 else if ((number >= (hits[0] - before)) && (number <= (hits[0] + after))) then 1 else far-near(hits[1:], number, before, after);
        def far-prefix(path, sep, options) = if far-get(options, "with-filename", 1) then (path + sep) else "";
        def far-format(row, path, options) {
            let sep = if row[3] then ":" else "-";
            ((String) far-prefix(path, sep, options) + ((if far-get(options, "number", 0) then (row[0].str() + sep) else "") + ((if (far-get(options, "column", 0) && row[3]) then ((fat-max(0, row[2]) + 1).str() + sep) else "") + (row[1] + "\n"))));
        }
        def far-render(rows, hits, path, options, previous) = if nil?(rows) then "" else if far-near(hits, rows[0][0], far-get(options, "before", 0), far-get(options, "after", 0)) then ((if ((previous > 0) && ((rows[0][0] > (previous + 1)) && ((far-get(options, "before", 0) + far-get(options, "after", 0)) > 0))) then "--\n" else "") + ((String) far-format(rows[0], path, options) + far-render(rows[1:], hits, path, options, rows[0][0]))) else far-render(rows[1:], hits, path, options, previous);
        def far-run(docs, args) = far-parsed(docs, far-parse(args, [], 0));
        def far-run-input(docs, args, input) = far-parsed-input(docs, input, far-parse(args, [], 0));
        def far-parsed-input(docs, input, parsed) = if ((len(input) > 0) || fat-has(far-get(parsed[0], "paths", []), "-")) then far-parsed([["stdin", "<stdin>", input]], [far-set(parsed[0], "stdin", 1), parsed[1]]) else far-parsed(docs, parsed);
        def far-parsed(docs, parsed) = if (!((String) parsed[1] == "")) then fat-fail(parsed[1], docs) else if (nil?(far-get(parsed[0], "patterns", [])) && (!((String) far-get(parsed[0], "mode", "lines") == "files"))) then fat-fail("rg-needs-pattern", docs) else far-compiled(docs, parsed[0], far-patterns(far-get(parsed[0], "patterns", []), far-get(parsed[0], "fixed", 0), []));
        def far-compiled(docs, options, compiled) = if (!((String) compiled[1] == "")) then fat-fail(compiled[1], docs) else far-sources(docs, options, compiled[0], far-missing-path(docs, far-get(options, "paths", [])));
        def far-sources(docs, options, patterns, missing) = if (!nil?(missing)) then fat-fail(("resident-search-path-not-found: " + (missing[0] + "; source absent from the admitted catalog")), docs) else far-docs(docs, docs, far-set(options, "with-filename", far-with-filename(docs, options)), fap-prepare(patterns, far-get(options, "word", 0)), "", 0);
        // One file: a single path argument that is "-" or names exactly one
        // resident document by its whole path, or no path over the held input.
        // A directory prefix, ".", several paths or the resident corpus are not.
        def far-admitted-by(docs, path) = if nil?(docs) then [] else if far-path-any([path], docs[0][1]) then cons(docs[0][1], far-admitted-by(docs[1:], path)) else far-admitted-by(docs[1:], path);
        def far-file-exact(docs, path) {
            let admitted = far-admitted-by(docs, path);
            ((!nil?(admitted)) && (nil?(admitted[1:]) && ((String) admitted[0] == path)));
        }
        def far-one-file(docs, options) {
            let paths = far-get(options, "paths", []);
            if nil?(paths) then far-get(options, "stdin", 0) else if (!nil?(paths[1:])) then 0 else if ((String) paths[0] == "-") then 1 else far-file-exact(docs, paths[0]);
        }
        def far-with-filename(docs, options) = if (far-get(options, "filename", 2) < 2) then far-get(options, "filename", 2) else (!far-one-file(docs, options));
        def far-docs(rest, docs, options, patterns, out, hits) = if nil?(rest) then fat-result(if (hits > 0) then 0 else 1, out, "", docs) else far-doc-admitted(rest, docs, options, patterns, out, hits, far-admit(options, rest[0][1]));
        def far-doc-admitted(rest, docs, options, patterns, out, hits, admitted) = if (!admitted) then far-docs(rest[1:], docs, options, patterns, out, hits) else if ((String) far-get(options, "mode", "lines") == "files") then far-docs(rest[1:], docs, options, patterns, (out + (rest[0][1] + "\n")), (hits + 1)) else far-doc-scan(rest, docs, options, patterns, out, hits, far-lines(sh-lines(rest[0][2]), patterns, options, 1, 0, []));
        def far-doc-scan(rest, docs, options, patterns, out, hits, scan) = if (!((String) scan[2] == "")) then fat-fail(scan[2], docs) else far-docs(rest[1:], docs, options, patterns, ((String) out + (if ((Comparable) scan[1] == 0) then "" else far-doc-output(rest[0][1], options, scan))), (hits + scan[1]));
        def far-doc-output(path, options, scan) = if ((String) far-get(options, "mode", "lines") == "quiet") then "" else if ((String) far-get(options, "mode", "lines") == "names") then (path + "\n") else if ((String) far-get(options, "mode", "lines") == "count") then ((String) far-prefix(path, ":", options) + (scan[1].str() + "\n")) else far-render(scan[0], far-hit-numbers(scan[0]), path, options, 0);
    }
}
