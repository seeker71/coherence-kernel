// rg-shaped resident source search. No path is opened or inventoried.
// preludes: form-stdlib/core.fk form-stdlib/shell-exec.fk form-stdlib/bml/form-agent-pattern.bml
section [form.bml] {
    class FormAgentSearch {
        def far-get(options, key, fallback) = nil?(options) ? fallback : (String) head(head(options)) == key ? head(options)[1] : far-get(tail(options), key, fallback);
        def far-set(options, key, value) = cons(list(key, value), options);
        def far-push(options, key, value) = far-set(options, key, cons(value, far-get(options, key, list())));
        def far-parse(args, options, positional) = nil?(args) ? list(options, "") : far-parse-at(args, options, positional);
        def far-parse-at(args, options, positional) {
            let arg = head(args);
            (!positional) && ((String) arg == "--") ? far-parse(tail(args), options, 1)
            : ((String) arg == "-") && (!nil?(far-get(options, "patterns", list()))) ? far-parse(tail(args), far-push(options, "paths", arg), positional)
            : (!positional) && fat-has(list("-e", "--regexp", "-g", "--glob", "-m", "--max-count", "-A", "-B", "-C"), arg) ? far-option-value(args, options)
            : (!positional) && ((String) arg == "--files") ? far-parse(tail(args), far-set(options, "mode", "files"), 0)
            : (!positional) && fat-has(list("--no-heading", "--line-buffered", "--color=never"), arg) ? far-parse(tail(args), options, 0)
            : (!positional) && fat-has(list("--ignore-case", "--fixed-strings", "--line-number", "--files-with-matches", "--count", "--quiet", "--word-regexp", "--invert-match", "--column"), arg) ? far-long(args, options)
            : (!positional) && fat-starts(arg, "-") ? far-short(args, options, arg, 1)
            : nil?(far-get(options, "patterns", list())) && (!((String) far-get(options, "mode", "lines") == "files")) ? far-parse(tail(args), far-push(options, "patterns", arg), positional)
            : far-parse(tail(args), far-push(options, "paths", arg), positional);
        }
        def far-long(args, options) {
            let arg = head(args);
            (String) arg == "--column" ? far-parse(tail(args), far-set(far-set(options, "column", 1), "number", 1), 0)
            : far-parse(cons((String) arg == "--ignore-case" ? "-i" : (String) arg == "--fixed-strings" ? "-F" : (String) arg == "--line-number" ? "-n" : (String) arg == "--files-with-matches" ? "-l" : (String) arg == "--count" ? "-c" : (String) arg == "--quiet" ? "-q" : (String) arg == "--word-regexp" ? "-w" : "-v", tail(args)), options, 0);
        }
        def far-short(args, options, flags, i) = i >= str_len(flags) ? ((Comparable) i == 1 ? list(options, "unsupported-rg-option") : far-parse(tail(args), options, 0)) : far-short-at(args, options, flags, i, byte_to_str(fat-char(flags, i)));
        def far-short-at(args, options, flags, i, flag) = fat-has(list("i", "F", "n", "w", "v", "S"), flag) ? far-short(args, far-set(options, (String) flag == "i" ? "ic" : (String) flag == "F" ? "fixed" : (String) flag == "n" ? "number" : (String) flag == "w" ? "word" : (String) flag == "S" ? "smart" : "invert", 1), flags, i + 1) : fat-has(list("l", "c", "q"), flag) ? far-short(args, far-set(options, "mode", (String) flag == "l" ? "names" : (String) flag == "c" ? "count" : "quiet"), flags, i + 1) : list(options, "unsupported-rg-option");
        def far-option-value(args, options) = nil?(tail(args)) ? list(options, "missing-rg-option-value") : far-option-ready(head(args), args[1], fat-drop(args, 2), options);
        def far-option-ready(key, value, rest, options) = ((String) key == "-e") || ((String) key == "--regexp") ? far-parse(rest, far-push(options, "patterns", value), 0) : ((String) key == "-g") || ((String) key == "--glob") ? (str_len(value) > FatMaxPattern() ? list(options, "glob-limit") : ((String) value == "") || (((String) value == "!") || far-unsupported-glob(value, 0)) ? list(options, "unsupported-glob-syntax") : far-parse(rest, far-push(options, "globs", value), 0)) : !fat-natural(value) ? list(options, "invalid-rg-number") : far-option-number(key, str_to_int(value), rest, options);
        def far-unsupported-glob(s, i) = i >= str_len(s) ? 0 : str_find("[]{}\\", byte_to_str(fat-char(s, i)), 0) >= 0 ? 1 : far-unsupported-glob(s, i + 1);
        def far-option-number(key, value, rest, options) = (String) key == "-C" ? far-parse(rest, far-set(far-set(options, "before", value), "after", value), 0) : far-parse(rest, far-set(options, (String) key == "-A" ? "after" : (String) key == "-B" ? "before" : "max", value), 0);
        def far-literal-tokens(s, i) = i >= str_len(s) ? list() : cons(fap-token(0, byte_to_str(fat-char(s, i))), far-literal-tokens(s, i + 1));
        def far-patterns(patterns, fixed, out) = nil?(patterns) ? list(out, "") : str_len(head(patterns)) > FatMaxPattern() ? list(list(), "pattern-limit") : far-pattern-next(patterns, fixed, out, fixed ? list(list(far-literal-tokens(head(patterns), 0)), "") : fap-compile(head(patterns)));
        def far-pattern-next(patterns, fixed, out, r) = !((String) r[1] == "") ? r : far-patterns(tail(patterns), fixed, append(out, head(r)));
        def far-uppercase(s, i) = i >= str_len(s) ? 0 : (fat-char(s, i) >= 65) && (fat-char(s, i) <= 90) ? 1 : far-uppercase(s, i + 1);
        def far-ic(options) = far-get(options, "ic", 0) ? 1 : far-get(options, "smart", 0) ? (!far-uppercase(fat-join(far-get(options, "patterns", list()), ""), 0)) : 0;
        def far-paths(paths, path) = nil?(paths) ? 1 : far-path-any(paths, path);
        def far-path-any(paths, path) = nil?(paths) ? 0 : ((String) head(paths) == ".") || ((((String) head(paths) == "-") && ((String) path == "<stdin>")) || (((String) head(paths) == path) || fat-starts(path, head(paths) ++ "/"))) ? 1 : far-path-any(tail(paths), path);
        // A requested source outside the resident catalog is missing evidence.
        // Keep it distinct from an available source containing no match.
        def far-path-present(docs, path) = nil?(docs) || ((String) path == "") ? 0 : far-path-any(list(path), head(docs)[1]) ? 1 : far-path-present(tail(docs), path);
        def far-missing-path(docs, paths) = nil?(paths) ? list() : far-path-present(docs, head(paths)) ? far-missing-path(docs, tail(paths)) : list(head(paths));
        def far-positive(globs) = nil?(globs) ? 0 : !fat-starts(head(globs), "!") ? 1 : far-positive(tail(globs));
        // Options are newest first; the last matching glob wins.
        def far-globs(globs, path, fallback) = nil?(globs) ? fallback : far-glob-next(globs, path, fallback, fap-glob(fat-starts(head(globs), "!") ? substring(head(globs), 1, str_len(head(globs))) : head(globs), path));
        def far-glob-next(globs, path, fallback, match) = (match < 0) ? -1 : (match) ? (!fat-starts(head(globs), "!")) : far-globs(tail(globs), path, fallback);
        def far-admit(options, path) = !far-paths(far-get(options, "paths", list()), path) ? 0 : far-globs(far-get(options, "globs", list()), path, !far-positive(far-get(options, "globs", list())));
        // Scan rows: line number, text, match start, selected. It retains context
        // once, so overlapping -A/-B/-C windows never duplicate output lines.
        def far-lines(lines, patterns, options, number, count, rows) = nil?(lines) ? list(fat-reverse(rows), count, "") : count >= far-get(options, "max", FatMaxBytes()) ? far-lines(tail(lines), patterns, options, number + 1, count, cons(list(number, head(lines), -1, 0), rows)) : far-line-result(lines, patterns, options, number, count, rows, fap-search(patterns, head(lines), far-ic(options), far-get(options, "word", 0)));
        def far-line-result(lines, patterns, options, number, count, rows, match) = nth(match, 2) <= 0 ? list(list(), 0, "pattern-work-limit") : far-line-picked(lines, patterns, options, number, count, rows, head(match), far-get(options, "invert", 0) ? (head(match) < 0) : (head(match) >= 0));
        def far-line-picked(lines, patterns, options, number, count, rows, pos, hit) = far-lines(tail(lines), patterns, options, number + 1, hit ? (count + 1) : count, cons(list(number, head(lines), pos, hit), rows));
        def far-hit-numbers(rows) = nil?(rows) ? list() : head(rows)[3] ? cons(head(head(rows)), far-hit-numbers(tail(rows))) : far-hit-numbers(tail(rows));
        def far-near(hits, number, before, after) = nil?(hits) ? 0 : (number >= (head(hits) - before)) && (number <= (head(hits) + after)) ? 1 : far-near(tail(hits), number, before, after);
        def far-format(row, path, options) {
            let sep = row[3] ? ":" : "-";
            path ++ sep ++ (far-get(options, "number", 0) ? int_to_str(head(row)) ++ sep : "") ++ (far-get(options, "column", 0) && row[3] ? int_to_str(fat-max(0, row[2]) + 1) ++ sep : "") ++ row[1] ++ "\n";
        }
        def far-render(rows, hits, path, options, previous) = nil?(rows) ? "" : far-near(hits, head(head(rows)), far-get(options, "before", 0), far-get(options, "after", 0)) ? ((previous > 0) && ((head(head(rows)) > (previous + 1)) && ((far-get(options, "before", 0) + far-get(options, "after", 0)) > 0)) ? "--\n" : "") ++ far-format(head(rows), path, options) ++ far-render(tail(rows), hits, path, options, head(head(rows))) : far-render(tail(rows), hits, path, options, previous);
        def far-run(docs, args) = far-parsed(docs, far-parse(args, list(), 0));
        def far-run-input(docs, args, input) = far-parsed-input(docs, input, far-parse(args, list(), 0));
        def far-parsed-input(docs, input, parsed) = far-parsed((str_len(input) > 0) || fat-has(far-get(head(parsed), "paths", list()), "-") ? list(list("stdin", "<stdin>", input)) : docs, parsed);
        def far-parsed(docs, parsed) = !((String) parsed[1] == "") ? fat-fail(parsed[1], docs) : nil?(far-get(head(parsed), "patterns", list())) && (!((String) far-get(head(parsed), "mode", "lines") == "files")) ? fat-fail("rg-needs-pattern", docs) : far-compiled(docs, head(parsed), far-patterns(far-get(head(parsed), "patterns", list()), far-get(head(parsed), "fixed", 0), list()));
        def far-compiled(docs, options, compiled) = !((String) compiled[1] == "") ? fat-fail(compiled[1], docs) : far-sources(docs, options, head(compiled), far-missing-path(docs, far-get(options, "paths", list())));
        def far-sources(docs, options, patterns, missing) = !nil?(missing) ? fat-fail("resident-search-path-not-found: " ++ head(missing) ++ "; search reads only supplied documents; request the missing source from the caller", docs) : far-docs(docs, docs, options, patterns, "", 0);
        def far-docs(rest, docs, options, patterns, out, hits) = nil?(rest) ? fat-result(hits > 0 ? 0 : 1, out, "", docs) : far-doc-admitted(rest, docs, options, patterns, out, hits, far-admit(options, head(rest)[1]));
        def far-doc-admitted(rest, docs, options, patterns, out, hits, admitted) = admitted < 0 ? fat-fail("glob-work-limit", docs) : !admitted ? far-docs(tail(rest), docs, options, patterns, out, hits) : (String) far-get(options, "mode", "lines") == "files" ? far-docs(tail(rest), docs, options, patterns, out ++ head(rest)[1] ++ "\n", hits + 1) : far-doc-scan(rest, docs, options, patterns, out, hits, far-lines(sh-lines(head(rest)[2]), patterns, options, 1, 0, list()));
        def far-doc-scan(rest, docs, options, patterns, out, hits, scan) = !((String) scan[2] == "") ? fat-fail(scan[2], docs) : far-docs(tail(rest), docs, options, patterns, out ++ ((Comparable) scan[1] == 0 ? "" : far-doc-output(head(rest)[1], options, scan)), hits + scan[1]);
        def far-doc-output(path, options, scan) = (String) far-get(options, "mode", "lines") == "quiet" ? "" : (String) far-get(options, "mode", "lines") == "names" ? path ++ "\n" : (String) far-get(options, "mode", "lines") == "count" ? path ++ ":" ++ int_to_str(scan[1]) ++ "\n" : far-render(head(scan), far-hit-numbers(head(scan)), path, options, 0);
    }
}
