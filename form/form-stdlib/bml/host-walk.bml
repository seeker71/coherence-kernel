// host-walk.bml — the steps a walk the host's own schedule begins shares with every other such walk.
//
// A launchd door runs from the walk checkout, a worktree that keeps its own branch because main is checked out
// elsewhere. It follows main: hw-sync rebases the branch onto origin/main (a commit a previous landing could not
// carry to main rides along and lands with the next one) and realigns the branch on origin; the landing asks
// "main": 1 so the landed commit fast-forwards main with no session carrying it. hw-build and hw-carrier rebuild
// the kernel and the Metal carrier into fresh inodes when their sources are newer. hw-native-turn is one engineering
// turn by the body's own loop (observe/native-turn-run.bml over learn/native-turn-queue.jsonl); hw-paths names what
// a landing carries for it: the ledgers and every writable file of the queue.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class HostWalk {
  def hw-line(text) = trim(if nothing?(text) then "" else text);
  def hw-branch() = hw-line(host-exec("git rev-parse --abbrev-ref HEAD", ""));
  def hw-day() = hw-line(host-exec("date +%F", ""));
  def hw-hhmm() = str_to_int(hw-line(host-exec("date +%H%M", "")));
  def hw-sync(branch) = hw-line(host-exec(mc-cat(list("git fetch -q origin main ", branch, " && { git rebase -q origin/main || { git rebase --abort; false; }; } && git push -q --force-with-lease origin HEAD:", branch, "; echo sync=$?")), ""));
  def hw-build() = hw-line(host-exec("if [ fkwu -nt runtime/fkwu-uni.c ]; then echo build=fresh; else cc -O2 -o fkwu.next runtime/fkwu-uni.c && mv fkwu.next fkwu; echo build=$?; fi", ""));
  def hw-carrier() = hw-line(host-exec("if [ form/native/metal/fk-metal-carrier.dylib -nt form/native/metal/fk-metal-carrier.m ]; then echo carrier=fresh; else cc -O2 -dynamiclib -o form/native/metal/fk-metal-carrier.dylib form/native/metal/fk-metal-carrier.m -framework Metal -framework Foundation -fobjc-arc; echo carrier=$?; fi", ""));
  def hw-native-turn(turns) = hw-line(host-exec("./fkwu observe/native-turn-run.bml 2>&1 | grep -F '[native-turn] ' | tail -1", mc-cat(list("{\"turns\":", int_to_str(turns), "}\n"))));
  // a turn line carries its row; a queue with no open gap answers without one
  def hw-turned?(line) = (str_find(line, "\"gap\":", 0) >= 0);
  def hw-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def hw-writable(nodes) = if nil?(nodes) then list() else cons(head(nodes), hw-writable(tail(nodes)));
  def hw-queue-paths(lines) = if nil?(lines) then list() else if ((Comparable) str_len(trim(head(lines))) == 0) then hw-queue-paths(tail(lines)) else append(hw-writable(json-array-elements(json-object-get(parse-json("queue-row", head(lines)), "writable"))), hw-queue-paths(tail(lines)));
  def hw-paths() = cons(json-node-string("receipts/draft-ledger.jsonl"), cons(json-node-string("receipts/native-turn-ledger.jsonl"), if (file_size("learn/native-turn-queue.jsonl") < 1) then list() else hw-queue-paths(split-on(fhn-read("learn/native-turn-queue.jsonl"), "\n"))));
  def hw-movement(request) = host-exec("./fkwu observe/movement-run.bml 2>&1", mc-cat(list(json-emit(request), "\n")));
 }
}
