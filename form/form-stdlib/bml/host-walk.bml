// host-walk.bml — the steps a walk the host's own schedule begins shares with every other such walk.
//
// This file holds no definition: it imports the parts below, in dependency order, so every `import
// form-stdlib/bml/host-walk.bml` and every `// preludes:` line that names it still reads the whole walk. Each part is
// a file the local lane can read whole, and read twice, inside its window (form-stdlib/tests/host-walk-band.bml, claim
// "part-size", keeps every part under 12000 bytes; claim "split" pins the name of every definition the parts hold, never
// its body, so a definition the lane edits moves no fixture).
//
//   host-walk-text.bml     the plain readers every part shares: lines, numbers, key=<digits> fields, JSON row keys
//   host-walk-clock.bml    the day and the hour from the host's own zone, with no child (hw-day, hw-hhmm)
//   host-walk-lock.bml     one walk at a time holds the checkout (hw-claim-at, hw-release)
//   host-walk-began.bml    the slot stamp: a retry slot finds the night begun (hw-begin), and the lens of the hours since a walk began
//   host-walk-settle.bml   what the sync says and records: its readers (hw-conflicted?, hw-held-turns), the conflicts it settled (hw-healed-lines, hw-redrawn-in)
//   host-walk-sync.bml     the branch follows main (hw-sync); the kernel and the carrier rebuild (hw-build)
//   host-walk-window.bml   the window's room, the yield to other checkouts' GPU doors, the memory a turn waits for (hw-ready)
//   host-walk-turn.bml     one turn: its child, its plan, its lines, its review (hw-native-turn, hw-turn-lines)
//   host-walk-turns.bml    a turn's row read in Form (idle, unknown, memory-low) and the window's turns loop (hw-turns)
//   host-walk-publish.bml  a candidate in the tracked tree, published inside one door and healed after a kill (hw-with-published)
//   host-walk-carry.bml    what a landing carries and the carry of one that stood on the branch (hw-paths, hw-carry)
//   host-walk-evidence.bml what a first slot that never began left behind, read as text: launchctl, diagnostic reports, the log
//   host-walk-class.bml    what became of the first slot (hr-stamp-state) and the class of why it did not begin (hr-classify)
//   host-walk-retry.bml    the informed retry, pure: the schedule's slots, the plan a class allows, the ladder (hr-plan, hr-ladder)
//   host-walk-record.bml   the retry's intent and outcome rows, their baseline, and the lens line (hr-row, hr-lens-line)
//   host-walk-attempt.bml  the retry's effects: the evidence read through argv doors, and one attempt (hr-attempt, hr-retry)
//
// The child door every part begins its steps through is host-child.bml: an argv, a stdin file, one out file, the exit
// read from the host, a deadline. A launchd door runs from the walk checkout, one walk at a time (host-walk-lock.bml);
// the day-turn and the scheduled walk (observe/day-turn.bml, observe/scheduled-walk.bml) are its two callers, and the
// planner, the movement and the native turn import it for the names they share (hw-with-published, hw-walk-doors).
//
// The five imports below are what a caller has always received through this file (the heal-native report's JSON and
// file readers, the meaning codes, the live flows, the child door and the memory governor); the parts import only
// what each one uses.
import form-stdlib/bml/form-cli-heal-native-report.bml;
import form-stdlib/meaning-codes.bml;
import form-stdlib/bml/live.bml;
import form-stdlib/bml/host-child.bml;
import form-stdlib/bml/memory-governor.bml;
import form-stdlib/bml/host-walk-text.bml;
import form-stdlib/bml/host-walk-clock.bml;
import form-stdlib/bml/host-walk-lock.bml;
import form-stdlib/bml/host-walk-began.bml;
import form-stdlib/bml/host-walk-settle.bml;
import form-stdlib/bml/host-walk-sync.bml;
import form-stdlib/bml/host-walk-window.bml;
import form-stdlib/bml/host-walk-turn.bml;
import form-stdlib/bml/host-walk-turns.bml;
import form-stdlib/bml/host-walk-publish.bml;
import form-stdlib/bml/host-walk-carry.bml;
import form-stdlib/bml/host-walk-evidence.bml;
import form-stdlib/bml/host-walk-class.bml;
import form-stdlib/bml/host-walk-retry.bml;
import form-stdlib/bml/host-walk-record.bml;
import form-stdlib/bml/host-walk-attempt.bml;
