// The voice walk: the body's own composition spoken by its own model session,
// retained as evidence and rowed in the rent ledger.
//
// The walk is a call, not a process: a caller that already holds a census
// window runs it inside that window, so the voice costs no child kernel and
// the composition never travels through a pipe. No model server, no provider.
// preludes: form-stdlib/bml/form-cli-native-compare.bml form-stdlib/bml/form-cli-native-voice.bml
// preludes: form-stdlib/bml/string-join.bml
section [form.bml] {
 class FormCliVoiceWalk {
  def nvw-ledger() = "receipts/rent-ledger.jsonl";
  def nvw-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def nvw-packet(composition) = mc-cat([
   read_file(fnc-enquiry()), "\n\n",
   "[The body's own measured answer follows. Every number in it is a row the body wrote.]\n",
   composition, "\n",
   "This turn has no tools and no file access; everything usable is in this message. Speak the comparison above in plain sentences, axis by axis in the order given, using its numbers and ledger rows, and say only what the composition states: add no judgment of your own, and where an axis carries no number or verdict, say so. Cite a receipt by its key in square brackets, as [R1], exactly as the key stands beside its path above; never write a path yourself. After the answer, say plainly what the material does not establish and what remains pending.\n"]);
  def nvw-row(options, job, packet, answer, floor, oracle, groundingMs, oracleMs) = json-node-object([
   fhn-n("at_unix_ms", now_unix_ms()),
   fhn-s("movement", if json-object-has?(options, "movement") then nvw-str(options, "movement") else "native-voice"),
   fhn-s("enquiry", fnc-enquiry()),
   fhn-s("source", if ((String) oracle[0] == "answered") then "fkwu-model-session" else "none"),
   json-node-pair("native_generation", fcnv-metadata(oracle)),
   fhn-s("oracle", oracle[0]),
   fhn-n("rent_tokens", 0),
   fhn-n("oracle_tokens_evaluated", oracle[2]),
   fhn-n("oracle_tokens_predicted", oracle[3]),
   fhn-s("oracle_model", oracle[4]),
   fhn-n("receipts_in_packet", fnc-receipt-limit()),
   fhn-n("packet_bytes", str_len(packet)),
   fhn-n("answer_bytes", str_len(answer)),
   fhn-n("answer_axes", floor[0]),
   fhn-n("answer_receipts_cited", floor[1]),
   fhn-n("answer_receipts_existing", floor[2]),
   fhn-n("answer_limits", floor[3]),
   fhn-n("grounding_ms", groundingMs),
   fhn-n("oracle_ms", oracleMs),
   fhn-n("provider_ms", 0),
   fhn-s("answer", fhn-at(job, "answer.md")),
   fhn-s("evidence", job)]);
  // The walk speaks its own state as it goes: a session that did not answer is
  // a live reading with what it needs and what it offers, not a silent zero.
  def nvw-organ() = "native-voice";
  def nvw-flow(options) = if json-object-has?(options, "movement") then nvw-str(options, "movement") else "native-voice";
  def nvw-lane(options) = if json-object-has?(options, "lane") then nvw-str(options, "lane") else "registry-weights";
  def nvw-answered?(oracle) = ((String) oracle[0] == "answered");
  def nvw-needs(oracle, job) = if nvw-answered?(oracle) then [] else [oh-need(oracle[7], json-node-string(job))];
  def nvw-reading(options, oracle, job) = oh-reading(nvw-organ(), nvw-flow(options), str_concat("model-session:", nvw-lane(options)), json-node-string("answered"), json-node-string(oracle[0]), json-node-int(if nvw-answered?(oracle) then 1 else 0), nvw-needs(oracle, job), ["registry-weights", "smaller-allowance", "inspect-native-evidence"], oh-reference(fhn-at(job, "answer.md")));
  // The one remedy the walk can apply itself: drop the adapter lane and let the
  // registry weights answer, observed in its own right. This is a choice, not a
  // retry — the adapter lane declines before it computes anything, by asking the
  // chunker whether any slice of the packet fits the device — so what follows a
  // decline is the walk's first inference and nothing is ever spent twice.
  def nvw-without-lane(options) = json-node-object(oh-without(json-object-pairs(options), "lane"));
  def nvw-heal(options, packet, job, oracle, reading) = if (nvw-answered?(oracle) || (!((String) nvw-lane(options) == "lora"))) then [oracle, [reading]] else nvw-healed(options, job, reading, fcnv-ask(packet, nvw-without-lane(options)));
  def nvw-healed(options, job, reading, second) = [second, [reading, oh-applied(reading, "registry-weights", json-node-string(second[0])), nvw-reading(nvw-without-lane(options), second, job)]];
  def nvw-keep(job, readings) = if nil?(readings) then 0 else nvw-keep(job, nvw-kept(oh-emit(fhn-at(job, "events.jsonl"), head(readings)), tail(readings)));
  def nvw-kept(emitted, rest) = rest;
  // A key the voice wrote is resolved against the keys the packet gave it. One it
  // did not give back is not quietly dropped: an unknown key is a citation of
  // something the body never handed over, and it is counted as its own kind.
  def nvw-key-mark() = "--- [R";
  def nvw-pairs(text) = nvw-pairs-from(text, 0, []);
  def nvw-pairs-from(text, from, acc) {
   let at = str_find(text, nvw-key-mark(), from);
   if (at < 0) then acc else nvw-pairs-at(text, at, acc, str_find(text, "] ", at));
  }
  def nvw-pairs-at(text, at, acc, close) {
   if (close < 0) then acc else nvw-pairs-keep(text, at, acc, close, str_find(text, " ", (close + 2)));
  }
  def nvw-pairs-keep(text, at, acc, close, stop) {
   let key = substring(text, (at + 4), (close + 1));
   let path = substring(text, (close + 2), if (stop < 0) then str_len(text) else stop);
   nvw-pairs-from(text, (close + 2), cons([key, trim(path)], acc));
  }
  def nvw-swap(text, needle, replacement) = str-join-with(split-on(text, needle), replacement);
  def nvw-expand(text, pairs) = if nil?(pairs) then text else nvw-expand(nvw-swap(text, head(pairs)[0], head(pairs)[1]), tail(pairs));
  def nvw-used(text, pairs) = if nil?(pairs) then 0 else ((if (str_find(text, head(pairs)[0], 0) >= 0) then 1 else 0) + nvw-used(text, tail(pairs)));
  def nvw-unknown(text, from, acc) {
   let at = str_find(text, "[R", from);
   if (at < 0) then acc else nvw-unknown(text, (at + 2), (acc + 1));
  }
  def nvw-row-keys(row, offered, used, unknown) = json-node-object(append(json-object-pairs(row), [fhn-n("citation_keys_offered", offered), fhn-n("citation_keys_used", used), fhn-n("citation_keys_unknown", unknown)]));
  // Answers list(row, job, appended, readings): the ledger row, its evidence
  // directory, what the append wrote, and the health readings the walk spoke.
  def nvw-walk(options) {
   let started = now_unix_ms();
   let spool = fhn-at(fhn-root(), ".form-heal");
   let made = fs_mkdir(spool);
   let job = fhn-unique(spool, "native-voice-", 0);
   let composition = if json-object-has?(options, "composition") then nvw-str(options, "composition") else fnc-compose();
   let packet = nvw-packet(composition);
   let wrotePacket = write_file_text(fhn-at(job, "packet.txt"), packet);
   let grounded = now_unix_ms();
   let first = fcnv-ask(packet, options);
   let healed = nvw-heal(options, packet, job, first, nvw-reading(options, first, job));
   let oracle = healed[0];
   let readings = oh-voice-all(healed[1]);
   let retained = fcnv-retain(job, oracle);
   let kept = nvw-keep(job, readings);
   let spoken = now_unix_ms();
   let raw = oracle[1];
   let pairs = nvw-pairs(packet);
   let keysUsed = nvw-used(raw, pairs);
   let answer = nvw-expand(raw, pairs);
   let keysUnknown = nvw-unknown(answer, 0, 0);
   let wroteRaw = write_file_text(fhn-at(job, "answer-raw.md"), raw);
   let wroteAnswer = write_file_text(fhn-at(job, "answer.md"), answer);
   let floor = apc-floor(answer);
   let row = nvw-row-keys(nvw-row(options, job, packet, answer, floor, oracle, (grounded - started), (spoken - grounded)), len(pairs), keysUsed, keysUnknown);
   let appended = fhn-append(nvw-ledger(), str_concat(json-emit(row), "\n"));
   [row, job, appended, readings];
  }
 }
}
