//////////////////////////////////////////////////////////////////////
// form-cli-peer-direct-answer-bridge.bml -- the caller-owned bridge from
// a policy-selected direct-answer action to the existing local Form/Metal
// action.  It owns no model session, path, task identity, or durable append.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-peer-direct-answer-action.fk form-stdlib/form-cli-peer-stream-ingress.fk form-stdlib/bml/form-cli-remote-token-evidence.bml

section [form.bml] {
    class FormCliPeerDirectAnswerBridge {
        field DirectAnswerBridgeRoute = "direct-answer";

        def fcpdab-route() = DirectAnswerBridgeRoute();
        def fcpdab-peer-result(stream, task_node, direct) {
            let peer = fcpdaa-peer(direct);
            let candidate = fcpsi-peer-result(stream, task_node, fcpa-response(peer), 0, nothing());
            list(fcpsi-result-state(candidate), peer, candidate);
        }
        def fcpdab-run-peer-task(stream, session, task_node, task, budget) {
            let direct = fcpdaa-run(session, fcpsi-task-kind(task), fcpsi-task-text(task), budget);
            fcpdab-peer-result(stream, task_node, direct);
        }
        def fcpdab-run-peer(stream, session, task_node, budget) {
            let task = fcpsi-find-task(fcpsi-tasks(stream), task_node);
            nothing?(task) ? list(stream, nothing(), fcpsi-result(stream, "nothing", 0, nothing(), "task-node-absent", nothing())) : fcpdab-run-peer-task(stream, session, task_node, task, budget);
        }

        // The direct action has no provider crossing.  Preserve that observed
        // zero as a typed receipt, distinct from a missing comparison
        // baseline (`nothing`).  The durable frame contains no task or answer
        // bytes and is later joined by the turnwheel's single append.
        // A recognized exact goal gets the stable BML node shared with a
        // later provider receipt. Other direct tasks retain their caller-born
        // transport node and are never silently folded into this comparison.
        def fcpdab-receipt-node(task) = fcpdag-exact-embodied-goal?(fcpsi-task-text(task)) ? fcpdag-embodied-goal-node() : fcpsi-task-node(task);
        def fcpdab-receipt-goal(task) = fcpdag-exact-embodied-goal?(fcpsi-task-text(task)) ? "embodied-v1" : "task-local";
        def fcpdab-local-token-receipt(task, peer) = !((String) fcpa-route(peer) == fcpdab-route()) ? nothing() : frte-receipt(fcpdab-receipt-node(task), 1, frte-local-direct-source(), 0, 0);
        def fcpdab-token-field(name, value) = "\n" ++ name ++ "=" ++ value;
        def fcpdab-token-frame(task, peer) {
            let local = fcpdab-local-token-receipt(task, peer);
            nothing?(local) ? "" : "<|form:remote-token-comparison|>" ++ fcpdab-token-field("goal", fcpdab-receipt-goal(task)) ++ fcpdab-token-field("source", frte-receipt-source(local)) ++ fcpdab-token-field("provider-calls", int_to_str(frte-receipt-provider-calls(local))) ++ fcpdab-token-field("remote-tokens", int_to_str(frte-receipt-remote-tokens(local))) ++ fcpdab-token-field("ratio-bps", "nothing") ++ fcpdab-token-field("under-ten-percent", "nothing") ++ fcpdab-token-field("reason", "provider-baseline-absent") ++ "\n<|/form:remote-token-comparison|>";
        }
    }
    0;
}
