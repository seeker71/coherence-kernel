//////////////////////////////////////////////////////////////////////
//
// qwen4exp-flash-next-state.bml — resident sequence/substate contract.
//
// One slot owns its Metal KV, recurrent GDN/conv, PLE history, position,
// token history, and predecessor tokens.  Exact and extending prefixes reuse
// that state; a divergent prefix resets and reevaluates instead of reading a
// state belonging to different tokens.
//
//////////////////////////////////////////////////////////////////////

package Form.native.qwen4exp;

import Form.kernel.*;
import Form.native.metal.*;

interface IQwen4ExpFlashNextState [public, witness, reusable] {
   section [public] {
      const String Schema = "qwen4exp-resident-state-v1";
      const String LookupRule = "exact-or-extending-prefix-reuses; divergence-resets";
      const String PrefillRule = "ingest-all-but-final; evaluate-final-once";
      const String ResidencyRule = "physical residence requires positive mmap-backed embedding and scratch Metal handles";
      const String Substates = "position,tokens,ple-history,conv,gdn,key,value";
      const String Ownership = "one-slot-one-token-prefix";
      const int Layers = 48;
      const int StartPredecessor = 248046;

      bool PrefixMatches( int nResident, int nIncoming ) [abstract];
      int Lookup( int nLayer, String strSubstate ) [abstract];
      int Ingest( int nToken ) [abstract];
      int Evaluate( int nToken ) [abstract];
   }
}

class Qwen4ExpFlashNextState [public, reusable, flow, observable] : IQwen4ExpFlashNextState {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/qwen4exp-flash-next-state.bml";
      const String Model = "Qwen3.8-Flash-Next UD-Q2_K_XL";

      bool PrefixMatches( int nResident, int nIncoming ) [abstract] {}
      int Lookup( int nLayer, String strSubstate ) [abstract] {}
      int Ingest( int nToken ) [abstract] {}
      int Evaluate( int nToken ) [abstract] {}
   }
}
