// def-window.bml — a source file read through its definitions, by structure and never by a count of characters.
//
// A voice reading a file needs the definitions a task is about, whole, and the vocabulary of the rest (every definition's name and parameters, so it copies names and arities and invents none). Cutting a file
// at a byte count loses the end of a definition or a definition the task needs; a window at a fixed indent runs a definition into the rest of the file (measured 2026-11-14: a marker for two spaces of indent made every
// named definition of an eight-space file run to its end, a packet of 117574 bytes). So the file is read by line and indent: a definition line is one whose first word is "def" (BML) or "(defn" (Form), and a definition
// runs to the next definition line at the same indent or less.
//
// fdw-window(text, names, lines): when none of `names` (and none of the definitions that hold `lines`, 1-based line numbers) is a definition of the file, the whole text; else the file's head before its first definition,
// each named definition whole, however long, then the name and parameters of every definition. Each info is [line index, indent, name, name and parameters].
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/bml/string-join.bml
section [form.bml] {
 class DefWindow {
  def fdw-lead(l, i) = i < len(l) && (str_byte_at(l, i) == 32 || str_byte_at(l, i) == 9) ? fdw-lead(l, i + 1) : i;
  def fdw-name-end(s, i) = i >= len(s) || str_byte_at(s, i) == 40 || str_byte_at(s, i) == 32 || str_byte_at(s, i) == 10 || str_byte_at(s, i) == 123 || str_byte_at(s, i) == 61 ? i : fdw-name-end(s, i + 1);
  def fdw-sig-of(rest) {
   let e = str_find(rest, ")", 0);
   e < 0 ? rest : substring(rest, 0, e + 1);
  }
  def fdw-info(l, idx) {
   let i = fdw-lead(l, 0);
   let rest = substring(l, i, len(l));
   let kind = str_find(rest, "def ", 0) == 0 ? 4 : str_find(rest, "(defn ", 0) == 0 ? 6 : 0;
   kind == 0 ? nothing() : [idx, i, substring(rest, kind, fdw-name-end(rest, kind)), fdw-sig-of(rest)];
  }
  def fdw-add(x, acc) = nothing?(x) ? acc : cons(x, acc);
  def fdw-rev(xs, acc) = len(xs) == 0 ? acc : fdw-rev(xs[1:], cons(xs[0], acc));
  def fdw-infos(L) = fdw-rev(foldl((acc, i) => fdw-add(fdw-info(L[i], i), acc), [], range(0, len(L))), []);
  def fdw-named(infos, name) = len(infos) == 0 ? nothing() : infos[0][2] == name ? infos[0] : fdw-named(infos[1:], name);
  def fdw-end(infos, hit, n) = len(infos) == 0 ? n : infos[0][0] > hit[0] && infos[0][1] <= hit[1] ? infos[0][0] : fdw-end(infos[1:], hit, n);
  def fdw-region-of(L, infos, name) {
   let hit = fdw-named(infos, name);
   nothing?(hit) ? "" : str-join-with(take(fdw-end(infos, hit, len(L)) - hit[0], L[hit[0]:]), "\n");
  }
  def fdw-header-of(L, infos) = len(infos) == 0 ? str-join-with(L, "\n") : str-join-with(take(infos[0][0], L), "\n");
  // the definition that holds a 1-based line: the last definition line at or before it
  def fdw-name-at(infos, line) = foldl((best, x) => x[0] + 1 <= line ? x[2] : best, "", infos);
  def fdw-uniq(xs) = foldl((acc, x) => len(x) == 0 || len(filter(y => y == x, acc)) > 0 ? acc : append(acc, [x]), [], xs);
  def fdw-regions(L, infos, names) = filter(r => len(r) > 0, map(n => fdw-region-of(L, infos, n), fdw-uniq(names)));
  def fdw-held?(text, names) {
   let L = split-on(text, "\n");
   len(fdw-regions(L, fdw-infos(L), names)) > 0;
  }
  def fdw-sigs-of(text) = map(x => x[3], fdw-infos(split-on(text, "\n")));
  def fdw-window(text, names, lines) {
   let L = split-on(text, "\n");
   let infos = fdw-infos(L);
   let all = append(names, map(n => fdw-name-at(infos, n), lines));
   let regions = fdw-regions(L, infos, all);
   len(regions) == 0 ? text : fdw-header-of(L, infos) ++ "\n// ... (the definitions the task names follow, then every definition's name and parameters) ...\n" ++ str-join-with(regions, "\n\n") ++ "\n\n// the definitions of this file, name and parameters:\n" ++ str-join-with(map(x => x[3], infos), "\n") ++ "\n";
  }
 }
}
