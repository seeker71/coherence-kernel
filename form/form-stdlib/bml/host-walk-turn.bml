// host-walk-turn.bml — one turn: its child, its plan, its lines and its review.
//
// hw-native-turn is one engineering turn by the body's own loop (observe/native-turn-run.bml over
// learn/native-turn-queue.jsonl). No step the walk itself begins is a shell line (the movement it begins lands through
// form-cli-landing.bml, which keeps two shell crossings of its own, named there). The turn, the plan and the review are
// cells called in this process (hch-cell-in of form-stdlib/bml/host-child.bml: cell_run, no child and no exit to read;
// their stdin is a value, their text what they printed, a stop and a deadline are named). The git steps are argv
// children of the same door. The whole of what each said stays under .hearth/walk-io/<step>.{in,out,err,exit}, and the
// run before it under <step>.prev.* (turn, plan, review, gates, movement, build, carrier, push, sync-*), so a turn, a
// review or a gate that failed leaves its evidence for the findings feeder, and a failed turn can be replayed by hand
// with the very options it read. Every such step carries a deadline (a cell's budget ends it; a child is stopped with
// its lineage), so a hung step no longer holds the walk's lock: a turn or a plan half an hour past its
// window's end (hw-backstop-ms), the review, the gates, the movement, the drafts and the page two hours after they
// began (hch-step-backstop-ms), a git step half an hour (hch-git-backstop-ms). A plan the door stopped is named in
// the walk's log ([local-plan:stopped]), as a turn it stopped is ([native-turn:silent]).
// What it holds: the turn's options and child (hw-turn-options, hw-turn-run-of), the plan for a queue with no open
// gap (hw-plan, hw-turn-planned), what a turn said read in Form (hw-turn-lines, hw-turned?), and the local-flow review
// that follows a turn that ran a gap (hw-review).
// What it needs: host-walk-text.bml (hw-line, hw-starts?, hw-say) and host-child.bml (hch-cell-in, hch-cell, hch-said).
import form-stdlib/bml/host-walk-text.bml;
import form-stdlib/bml/host-child.bml;
section [form.bml] {
 class HostWalkTurn {
  // the options a turn reads on stdin: its turn budget, and its wall deadline on the host's monotonic clock
  def hw-turn-options(turns, deadline) = json-emit(json-node-object([fhn-n("turns", turns), fhn-n("deadline_ms", deadline)]));
  // A child that hangs would hold the walk's lock for good and cost the next window its turns: a turn and a plan
  // hear the window's end and stop their own lanes there, so a turn or plan still running hw-backstop-ms after
  // that is hung, and the child door stops it (its output to that point stays in .hearth/walk-io).
  def hw-backstop-ms() = 1800000;
  // hw-turn-run-of(io, cell, ...) is the one place a turn is called: the cell runs in this process (hch-cell-in), its
  // stdin is the options, its deadline the window's end plus the backstop. The cell is a seam so a band can call a stub
  // in the turn's place and read that the deadline reaches the door (form-stdlib/tests/host-walk-band.bml, claim "spawn").
  def hw-turn-cell() = "observe/native-turn-run.bml";
  def hw-turn-run-of(io, cell, turns, deadline) = hch-cell-in(io, "turn", cell, hw-turn-options(turns, deadline) ++ "\n", deadline + hw-backstop-ms());
  def hw-turn-run(turns, deadline) = hw-turn-run-of(hch-dir(), hw-turn-cell(), turns, deadline);
  def hw-turn-once(turns, deadline) = hw-reviewed(hw-turn-lines(hch-said(hw-turn-run(turns, deadline))));
  // A queue with no open gap is planned inside the same window: the local planner (observe/local-plan-run.bml) takes
  // the next pending request in learn/local-requests.jsonl, a local voice writes it as a band-first gap, and Form
  // verifies it before it is queued. Its options are the planner's attempts, each opened only while the window
  // (until_ms) still holds one. A plan that queued a gap is turned at once. A plan that ended moot (its request was
  // already healed, so the walk spent one option and most of the window is unspent) is said, and the planner is asked
  // for the next request, at most hw-plan-most() planner walks for a turn that found no gap; the planner reads
  // until_ms and opens no model once the window cannot hold an option, so the asks never pass the window. Any other
  // outcome is said and the turn's own "no open gap" stands. No rented token plans or turns.
  def hw-plan-options(deadline) = json-emit(json-node-object([fhn-n("next", 1), fhn-n("until_ms", deadline)]));
  // the planner's last row, and the child door's last line ("[host-child] ...", which says the plan was stopped or
  // never born) after it: a plan stopped at its backstop after it queued its gap is not silent in the walk's log
  def hw-plan-line(out) = hw-plan-join(hw-plan-keep(split-on(out ?? "", "\n"), ""), hw-plan-child(split-on(out ?? "", "\n"), ""));
  def hw-plan-child(lines, last) = nil?(lines) ? last : hw-plan-child(lines[1:], hw-starts?(lines[0], "[host-child] ") ? trim(lines[0]) : last);
  def hw-plan-join(planner, child) = (String) child == "" ? planner : (String) planner == "" ? trim(child) : planner ++ "\n" ++ trim(child);
  def hw-plan-keep(lines, last) = nil?(lines) ? last : hw-plan-keep(lines[1:], hw-starts?(lines[0], "[local-plan") && !hw-starts?(lines[0], "[local-plan:voice]") ? trim(lines[0]) : last);
  def hw-plan-most() = 4;
  def hw-plan-cell() = "observe/local-plan-run.bml";
  def hw-plan-run-of(io, cell, deadline) = hch-cell-in(io, "plan", cell, hw-plan-options(deadline) ++ "\n", deadline + hw-backstop-ms());
  // A plan the door stopped at its backstop leaves the door's own line ("[host-child] deadline: ..."), which
  // hw-plan-line keeps beside the planner's row, so the walk's log would not say only "no open gap". A plan stopped
  // before it queued is named "[local-plan:stopped] deadline: ...". A plan that had queued its gap before it hung
  // keeps its result line, with the door's line after it, so the turn that follows still lands it and the log says
  // the plan was stopped.
  def hw-plan-answer(run) = hw-plan-or-stopped(run, hw-plan-line(hch-said(run)));
  def hw-plan-or-stopped(run, line) = nothing?(run[0]) && ((String) run[2] != "") && !hw-planned?(line) ? "[local-plan:stopped] " ++ run[2] : line;
  def hw-plan(deadline) = hw-plan-answer(hw-plan-run-of(hch-dir(), hw-plan-cell(), deadline));
  def hw-no-gap?(turn) = str_find(turn ?? "", "[native-turn] no open gap", 0) >= 0;
  def hw-planned?(line) = hw-starts?(line, "[local-plan:result] ") && str_find(line, "\"status\":\"queued\"", 0) >= 0;
  def hw-native-turn(turns, deadline) = hw-turn-planned(hw-turn-once(turns, deadline), deadline, hw-plan, () => hw-turn-once(turns, deadline));
  // plan(deadline) answers the planner's last line; again() takes the turn once more. A queued plan's line follows
  // the second turn's lines, so its landing carries the plan even when that turn ran no gap (hw-turn-taken). A moot
  // result is said and the planner asked again (hw-plan-next), the nth planner walk of this turn being n.
  def hw-turn-planned(turn, deadline, plan, again) = hw-no-gap?(turn) ? hw-plan-next(plan(deadline), deadline, plan, turn, again, 1) : turn;
  def hw-moot?(line) = hw-starts?(line, "[local-plan:result] ") && str_find(line, "\"status\":\"moot\"", 0) >= 0;
  def hw-plan-next(planned, deadline, plan, turn, again, n) = hw-moot?(planned) && n < hw-plan-most() ? hw-plan-moot(planned, deadline, plan, turn, again, n) : hw-after-plan(planned, turn, again);
  def hw-plan-moot(planned, deadline, plan, turn, again, n) {
   let said = hw-say(planned);
   hw-plan-next(plan(deadline), deadline, plan, turn, again, n + 1);
  }
  def hw-after-plan(planned, turn, again) {
   let said = hw-planned?(planned) ? 0 : hw-say(planned);
   hw-planned?(planned) ? again() ++ "\n" ++ planned : turn;
  }
  def hw-planned-in?(turn) = !nil?(filter(l => hw-planned?(l), split-on(turn ?? "", "\n")));
  // what a turn said, read in Form: its last row ([native-turn] ...) and its walk's verdict ([native-turn:walk] ...);
  // a turn that said neither is named by its own last line that is not an organ-health reading, so a turn door
  // that failed is never silent
  def hw-turn-lines(out) = hw-turn-keep(split-on(out ?? "", "\n"), "", "", "");
  def hw-spoken?(line) = (Comparable) len(trim(line)) > 0 && !hw-starts?(line, "form-organ health ");
  def hw-turn-keep(lines, row, walk, last) = nil?(lines) ? hw-turn-join(row, walk, last) : hw-turn-keep(lines[1:], hw-starts?(lines[0], "[native-turn] ") ? trim(lines[0]) : row, hw-starts?(lines[0], "[native-turn:walk] ") ? trim(lines[0]) : walk, hw-spoken?(lines[0]) ? trim(lines[0]) : last);
  def hw-turn-join(row, walk, last) = (String) walk == "" && (String) row == "" ? hw-turn-silent(last) : (String) walk == "" ? row : (String) row == "" ? walk : row ++ "\n" ++ walk;
  def hw-turn-silent(last) = (String) last == "" ? "" : "[native-turn:silent] the turn printed no row; its last line: " ++ substring(last, 0, len(last) > 300 ? 300 : len(last));
  // a turn that ran a gap is followed by the local-flow review (observe/local-flow-review.bml): its row lands with
  // the turn, and its next line is spoken beside the turn's. A turn that ran none lands nothing, so it is not
  // reviewed: its review row would stand in the tracked tree with no landing to carry it, and the turn's own line
  // already says why it ran none.
  def hw-review() = hw-line(hch-cell-line(hch-cell("review", "observe/local-flow-review.bml", "", hch-by(hch-step-backstop-ms()))));
  def hw-reviewed(turn) = hw-reviewed-by(turn, hw-review);
  def hw-reviewed-by(turn, review) {
   let said = hw-turned?(turn) ? hw-say(review()) : 0;
   turn;
  }
  // a turn line carries its row; a queue with no open gap, a gap already full and a silent turn answer without one
  def hw-turned?(line) = hw-starts?(line, "[native-turn] {") && str_find(line, "\"gap\":", 0) >= 0;
 }
}
