// form-find.bml — the body's source tree, indexed and resident: one question, one table lookup.
//
// Urs, 2026-10-04: "you run many non-form tools through form-run, how come you are not using form-cli and make the types of queries
// form native with indexes and other ways to improve the lookup and improve the integration".
//
// WHAT HOLDS. A resident service (observe/form-find-run.fk, run by launchd as DATA: docs/launchd/earth.hati.form-find.plist; the body
// never starts it) holds the source tree in memory: the file table (source-tree.bml's walk, every .gitignore honoured), each file's
// identity (size, mtime, inode: host_file_identity) and, for text under 2 MiB with no NUL, its bytes; a DEFINITION index (`def`,
// `defn`, `class`, `field`, `thought` names with their offsets); the IMPORT edges (`import` lines and `preludes:` headers); the BAND
// headers (`; Expected:` / `; Verdict`); a lazily built TRIGRAM posting set (trigram -> the files holding it, built the first time
// a search needs that trigram and kept; a literal search then reads only the files its trigram names; a literal's own posting is kept
// beside the trigrams', 400 keys at most). There is no watcher: every query first stats each file (about 15 ms for 2,100 files) and
// lists again each directory whose mtime moved, so a file that changed is read again and only that one. A search with no case-exact
// literal to narrow it (-i, -v, a pattern of classes alone) must name PATH operands: the grep engine reads every line of every file
// it is given, and a file whose lines exhaust its per-line work budget (pattern-work-limit) is skipped and named on stderr, not fatal.
//
// THE WIRE. The request is the agent wire's JSON ({"command": "...", "input": "...", "documents": [...]}); the answer is the wire's
// JSON (schema form-agent-tool-wire-v1). Commands:
//   find [-i -F -w -x -v -l -c -m N] PATTERN [PATH...]   indexed search, ERE (grep -E) or -F; rows as `rg -n`: path:line:text
//   defs NAME...          where NAME is defined (def defn class field thought): path:line:text
//   callers NAME          the lines that use NAME as a whole name, definitions left out: path:line:text
//   bands [NAME]          the band files (a `; Expected:` or `; Verdict` header) that name NAME: path expected= verdict= mentions=
//   imports UNIT          what UNIT imports (`<UNIT> -> raw`) and who imports it (`<UNIT> <- path:line:text`)
//   rows FILE [FIELD[=VALUE]]   a .jsonl census or ledger as a keyed table (a `.hearth/*.jsonl` too): the rows holding FIELD=VALUE
//   status | refresh      the index's size and counters | a refresh now
//   read cat head tail sed wc jq grep rg   the wire's own tools over the indexed files the command names (never a host file)
//   path [--ids|--text|--rows|--count] EXPR   a verb another unit teaches through fnd-ext-add: form-path.bml's XPath-shaped query over the files' nodes
// Anything else is a named refusal (unknown-command, form-find-reads-only for edit and write), never a host fallback. A request that
// carries its own documents goes to the wire untouched.
//
// THE TRANSPORT. A spool directory (FORM_FIND_SPOOL, default /tmp/form-find/<UID or USER>): the client writes ask.<n>.json with a plain
// shell redirect, the service answers ans.<n>.json (written as a .part and renamed, so a reader never sees half an answer) and removes
// the ask. The service looks every 20 ms for 10 s after the last ask and every 100 ms after that, and writes status.json as its beat.
// A fifo bell was the other option the body proves (spool-bell-transport.fk); it is not used because a plain redirect into a fifo with
// no reader BLOCKS the agent's shell, and a polled directory never does.
//
// fnd-serve(s, request) answers one request in process: it is what the service calls, what the band calls, and what the cold door
// (observe/form-find-ask.bml, service absent) calls after opening an index of its own.
// preludes: form-stdlib/core.fk form-stdlib/sort.fk form-stdlib/json.fk form-stdlib/bml/source-tree.bml form-stdlib/bml/form-agent-grep.bml form-stdlib/bml/form-agent-tool-wire.bml
import form-stdlib/core.fk;
import form-stdlib/sort.fk;
import form-stdlib/json.fk;
import form-stdlib/bml/source-tree.bml;
import form-stdlib/bml/form-agent-grep.bml;
import form-stdlib/bml/form-agent-tool-wire.bml;
section [form.bml] {
 class FormFind {
  // ---- constants -----------------------------------------------------------------------------------------------------
  def fnd-max-held() = 2097152;
  def fnd-max-out() = 1048576;
  def fnd-q() = byte_to_str(34);
  def fnd-nul() = byte_to_str(0);
  def fnd-sep() = byte_to_str(1);

  // ---- a map of any size: 509 records, the key's hash picks one (one record alone turns O(n) per key past a few thousand) ----
  def fnd-hash(k, i, n, h) = i >= n ? h : fnd-hash(k, i + 1, n, (h * 31 + str_byte_at(k, i)) % 1000003);
  def fnd-slot(k) = "s" ++ (fnd-hash(k, 0, len(k), 7) % 509).str();
  def fnd-map() = fnd-map-fill(record_new(0), 0);
  def fnd-map-fill(m, i) = i >= 509 ? m : fnd-map-next(m, i, record_set(m, "s" ++ i.str(), record_new(0)));
  def fnd-map-next(m, i, z) = fnd-map-fill(m, i + 1);
  def fnd-mset(m, k, v) = record_set(record_get(m, fnd-slot(k)), k, v);
  def fnd-mhas?(m, k) = record_has(record_get(m, fnd-slot(k)), k);
  def fnd-mget(m, k, fallback) = fnd-mhas?(m, k) ? record_get(record_get(m, fnd-slot(k)), k) : fallback;

  // ---- state: one record -----------------------------------------------------------------------------------------------
  def fnd-new(base) {
   let s = record_new(0);
   let a = record_set(s, "base", base);
   let b = record_set(s, "files", fnd-map());
   let c = record_set(s, "byid", fnd-map());
   let d = record_set(s, "dirs", fnd-map());
   let e = record_set(s, "defs", fnd-map());
   let f = record_set(s, "imps", fnd-map());
   let g = record_set(s, "tri", fnd-map());
   let h = record_set(s, "rowtabs", fnd-map());
   let i = record_set(s, "bases", fnd-map());
   let j = record_set(s, "c", record_new(0));
   let k = record_set(s, "held", []);
   let l = record_set(s, "rels", []);
   let m = record_set(s, "dirlist", []);
   let n = record_set(s, "trilist", []);
   let o = record_set(s, "heldrev", []);
   let p = record_set(s, "building", 0);
   let q = record_set(s, "nextid", 0);
   let r = record_set(s, "maxheld", fnd-max-held());
   let t = record_set(s, "ext", []);
   s;
  }
  def fnd-c(s, key) = record_get(record_get(s, "c"), key);
  def fnd-cset(s, key, v) = record_set(record_get(s, "c"), key, v);
  def fnd-bump(s, key, n) = fnd-cset(s, key, fnd-c(s, key) + n);
  def fnd-base(s) = record_get(s, "base");
  def fnd-abs(s, rel) = (String) fnd-base(s) == "" ? rel : fnd-base(s) ++ "/" ++ rel;
  def fnd-rel(s, p) = (String) fnd-base(s) == "" ? p : substring(p, len(fnd-base(s)) + 1, len(p));
  def fnd-dir-path(s, dir) = (String) dir == "" ? "." : dir;
  def fnd-next-id(s) {
   let id = record_get(s, "nextid");
   let z = record_set(s, "nextid", id + 1);
   id;
  }
  def fnd-read(s, abs) {
   let z = fnd-bump(s, "reads", 1);
   read_file(abs) ?? "";
  }

  // ---- bytes -------------------------------------------------------------------------------------------------------------
  def fnd-ident?(b) = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 45 || b == 63 || b == 33 || b == 42 || b == 60 || b == 62 || b == 47 || b == 43;
  def fnd-extra?(b) = b == 63 || b == 33 || b == 42 || b == 60 || b == 62 || b == 47 || b == 43;
  def fnd-name-end(t, i) {
   let e = scan_run(t, i, 3);
   (e < len(t) && fnd-extra?(str_byte_at(t, e))) ? fnd-name-end(t, e + 1) : e;
  }
  def fnd-line-start(t, p) = p <= 0 ? 0 : str_byte_at(t, p - 1) == 10 ? p : fnd-line-start(t, p - 1);
  def fnd-line-at(t, ls) = substring(t, ls, scan_run(t, ls, 5));
  def fnd-nl(t, i, stop, acc) = i >= stop ? acc : fnd-nl(t, i + 1, stop, str_byte_at(t, i) == 10 ? acc + 1 : acc);
  def fnd-ctx?(t, p) = p <= 0 ? true : fnd-ctx-back(t, p - 1);
  def fnd-ctx-back(t, i) = str_byte_at(t, i) == 10 ? true : (str_byte_at(t, i) == 32 || str_byte_at(t, i) == 9 || str_byte_at(t, i) == 40) ? (i == 0 ? true : fnd-ctx-back(t, i - 1)) : false;
  def fnd-comment-prefix?(t, p) = fnd-cp(t, fnd-line-start(t, p), p, 0);
  def fnd-cp(t, i, p, mark) = i >= p ? mark > 0 : fnd-cp-byte(t, i, p, mark, str_byte_at(t, i));
  def fnd-cp-byte(t, i, p, mark, b) = (b == 59 || b == 47) ? fnd-cp(t, i + 1, p, 1) : (b == 32 || b == 9) ? fnd-cp(t, i + 1, p, mark) : false;
  def fnd-bound?(t, p, n) = (p == 0 || !fnd-ident?(str_byte_at(t, p - 1))) && (p + n >= len(t) || !fnd-ident?(str_byte_at(t, p + n)));
  def fnd-padz(s, w) = len(s) >= w ? s : fnd-padz("0" ++ s, w);
  def fnd-pad(n, w) = fnd-padz(n.str(), w);
  def fnd-starts?(s, p) = len(s) >= len(p) && (String) substring(s, 0, len(p)) == p;
  def fnd-ends?(s, t) = len(s) >= len(t) && (String) substring(s, len(s) - len(t), len(s)) == t;
  def fnd-last-slash(s, i) = i < 0 ? 0 - 1 : str_byte_at(s, i) == 47 ? i : fnd-last-slash(s, i - 1);
  def fnd-basename(s) = substring(s, fnd-last-slash(s, len(s) - 1) + 1, len(s));
  def fnd-has?(xs, x) = nil?(xs) ? false : (String) xs[0] == x ? true : fnd-has?(xs[1:], x);
  def fnd-has-int?(xs, x) = nil?(xs) ? false : (Comparable) xs[0] == x ? true : fnd-has-int?(xs[1:], x);
  def fnd-count-lines(t, name, from, acc) {
   let p = str_find(t, name, from);
   p < 0 ? acc : fnd-count-lines(t, name, scan_run(t, p, 5) + 1, acc + 1);
  }

  // ---- the index of one file: definitions, imports, band headers ------------------------------------------------------------
  def fnd-source?(rel) = fnd-ends?(rel, ".fk") || fnd-ends?(rel, ".bml") || fnd-ends?(rel, ".form");
  def fnd-anchor-kinds() = [["def ", "def"], ["defn ", "defn"], ["class ", "class"], ["field ", "field"], ["thought ", "thought"]];
  def fnd-def-add(s, name, entry) {
   let defs = record_get(s, "defs");
   let z = fnd-bump(s, "defs", 1);
   fnd-mset(defs, name, cons(entry, fnd-mget(defs, name, [])));
  }
  def fnd-defs-of(s, id, text) = foldl((acc, k) => fnd-defs-anchor(s, id, text, k[0], k[1], 0, acc), [], fnd-anchor-kinds());
  def fnd-defs-anchor(s, id, text, anchor, kind, from, acc) = str_find(text, anchor, from) < 0 ? acc : fnd-defs-hit(s, id, text, anchor, kind, str_find(text, anchor, from), acc);
  def fnd-defs-hit(s, id, text, anchor, kind, p, acc) {
   let ns = p + len(anchor);
   let ne = fnd-name-end(text, ns);
   let ok = fnd-ctx?(text, p) && ne > ns;
   let name = ok ? substring(text, ns, ne) : "";
   let z = ok ? fnd-def-add(s, name, [id, ns, kind]) : 0;
   fnd-defs-anchor(s, id, text, anchor, kind, ns, ok ? cons(name, acc) : acc);
  }
  // imports: `import X;` lines and `preludes: a b c` headers; an edge is [basename, raw, offset of the line's anchor]
  def fnd-imp-add(s, id, edge) {
   let imps = record_get(s, "imps");
   let z = fnd-bump(s, "imps", 1);
   fnd-mset(imps, edge[0], cons([id, edge[1], edge[2]], fnd-mget(imps, edge[0], [])));
  }
  def fnd-tok-end(t, i) = (i >= len(t) || str_byte_at(t, i) == 32 || str_byte_at(t, i) == 9 || str_byte_at(t, i) == 10 || str_byte_at(t, i) == 13 || str_byte_at(t, i) == 59 || str_byte_at(t, i) == 44 || str_byte_at(t, i) == 41) ? i : fnd-tok-end(t, i + 1);
  def fnd-imps-of(s, id, text) = fnd-imp-lines(s, id, text, "preludes:", 1, 0, fnd-imp-lines(s, id, text, "import ", 0, 0, []));
  def fnd-imp-lines(s, id, text, anchor, kind, from, acc) = str_find(text, anchor, from) < 0 ? acc : fnd-imp-hit(s, id, text, anchor, kind, str_find(text, anchor, from), acc);
  def fnd-imp-hit(s, id, text, anchor, kind, p, acc) {
   let lend = scan_run(text, p, 5);
   let ok = kind == 0 ? fnd-ctx?(text, p) : fnd-comment-prefix?(text, p);
   let edges = ok ? (kind == 0 ? fnd-imp-one(text, p + len(anchor), p, []) : fnd-imp-many(text, p + len(anchor), lend, p, [])) : [];
   let z = fnd-imp-register(s, id, edges);
   fnd-imp-lines(s, id, text, anchor, kind, lend, append(acc, edges));
  }
  def fnd-imp-one(text, i, off, acc) {
   let e = fnd-tok-end(text, i);
   e > i ? [[fnd-basename(substring(text, i, e)), substring(text, i, e), off]] : [];
  }
  def fnd-imp-many(text, i, lend, off, acc) {
   let st = scan_run(text, i, 0);
   let e = fnd-tok-end(text, st);
   (st >= lend || e <= st) ? reverse(acc) : fnd-imp-many(text, e, lend, off, cons([fnd-basename(substring(text, st, e)), substring(text, st, e), off], acc));
  }
  def fnd-imp-register(s, id, edges) = nil?(edges) ? 0 : fnd-imp-register-next(s, id, edges, fnd-imp-add(s, id, edges[0]));
  def fnd-imp-register-next(s, id, edges, z) = fnd-imp-register(s, id, edges[1:]);
  // band headers: `; Expected: N` and `; Verdict N` (a `//` comment too): [expected, verdict] or [] when the file has neither
  def fnd-band-find(t, word, from) = str_find(t, word, from) < 0 ? 0 - 1 : fnd-comment-prefix?(t, str_find(t, word, from)) ? str_find(t, word, from) : fnd-band-find(t, word, str_find(t, word, from) + len(word));
  def fnd-after-digits(t, i) = substring(t, scan_run(t, i, 0), scan_run(t, scan_run(t, i, 0), 1));
  def fnd-band-of(text) {
   let e = fnd-band-find(text, "Expected:", 0);
   let v = fnd-band-find(text, "Verdict", 0);
   (e < 0 && v < 0) ? [] : [e < 0 ? "" : fnd-after-digits(text, e + 9), v < 0 ? "" : fnd-after-digits(text, v + 7)];
  }
  def fnd-index(s, id, rel, text) = fnd-source?(rel) ? [fnd-defs-of(s, id, text), fnd-imps-of(s, id, text), fnd-band-of(text)] : [[], [], []];
  def fnd-unindex(s, id, e) {
   let defs = record_get(s, "defs");
   let imps = record_get(s, "imps");
   let z1 = fnd-def-drop(defs, id, e[6]);
   let z2 = fnd-imp-drop(imps, id, e[7]);
   0;
  }
  def fnd-def-drop(defs, id, names) = nil?(names) ? 0 : fnd-def-drop-next(defs, id, names, fnd-mset(defs, names[0], filter(en => (Comparable) en[0] != id, fnd-mget(defs, names[0], []))));
  def fnd-def-drop-next(defs, id, names, z) = fnd-def-drop(defs, id, names[1:]);
  def fnd-imp-drop(imps, id, edges) = nil?(edges) ? 0 : fnd-imp-drop-next(imps, id, edges, fnd-mset(imps, edges[0][0], filter(en => (Comparable) en[0] != id, fnd-mget(imps, edges[0][0], []))));
  def fnd-imp-drop-next(imps, id, edges, z) = fnd-imp-drop(imps, id, edges[1:]);

  // ---- one file in the table: [id, size, mtime, ino, held, text, def names, import edges, band] -----------------------------
  def fnd-load(s, id, rel, ident) {
   let wants = ident[0] <= record_get(s, "maxheld");
   let text = wants ? fnd-read(s, fnd-abs(s, rel)) : "";
   let held = (wants && str_find(text, fnd-nul(), 0) < 0) ? 1 : 0;
   let kept = held == 1 ? text : "";
   let ix = held == 1 ? fnd-index(s, id, rel, kept) : [[], [], []];
   [id, ident[0], ident[1], ident[2], held, kept, ix[0], ix[1], ix[2]];
  }
  def fnd-held-add(s, id, rel, e) = e[4] == 0 ? 0 : (Comparable) record_get(s, "building") == 1 ? record_set(s, "heldrev", cons([id, rel, e[5], e[8]], record_get(s, "heldrev"))) : record_set(s, "held", fnd-held-insert(record_get(s, "held"), [id, rel, e[5], e[8]], []));
  def fnd-held-insert(held, h, before) = nil?(held) ? append(reverse(before), [h]) : sort-str-le?(h[1], held[0][1]) ? append(reverse(before), cons(h, held)) : fnd-held-insert(held[1:], h, cons(held[0], before));
  def fnd-add(s, abs) = fnd-add-ident(s, fnd-rel(s, abs), host_file_identity(abs));
  def fnd-add-ident(s, rel, ident) = (String) value_kind(ident) != "list" ? 0 : fnd-add-entry(s, rel, fnd-next-id(s), ident);
  def fnd-add-entry(s, rel, id, ident) {
   let e = fnd-load(s, id, rel, ident);
   let z1 = fnd-mset(record_get(s, "files"), rel, e);
   let z2 = fnd-mset(record_get(s, "byid"), id.str(), rel);
   let z3 = record_set(s, "rels", cons(rel, record_get(s, "rels")));
   let z4 = fnd-bases-add(s, rel);
   let z5 = fnd-held-add(s, id, rel, e);
   let z6 = (Comparable) record_get(s, "building") == 1 ? 0 : fnd-post-update(s, id, "", e[4] == 1 ? e[5] : "", e[4] == 1);
   let z6b = (Comparable) record_get(s, "building") == 1 ? 0 : fnd-cset(s, "reordered", 1);
   let z7 = fnd-bump(s, "files", 1);
   let z8 = fnd-bump(s, "heldfiles", e[4]);
   let z9 = fnd-bump(s, "bytes", e[4] == 1 ? len(e[5]) : 0);
   let z10 = fnd-bump(s, "bands", nil?(e[8]) ? 0 : 1);
   0;
  }
  def fnd-bases-add(s, rel) {
   let bases = record_get(s, "bases");
   fnd-mset(bases, fnd-basename(rel), cons(rel, fnd-mget(bases, fnd-basename(rel), [])));
  }
  def fnd-bases-drop(s, rel) {
   let bases = record_get(s, "bases");
   fnd-mset(bases, fnd-basename(rel), filter(r => (String) r != rel, fnd-mget(bases, fnd-basename(rel), [])));
  }
  def fnd-entry(s, rel) = fnd-mget(record_get(s, "files"), rel, []);
  def fnd-text-of(s, id) = fnd-entry(s, fnd-mget(record_get(s, "byid"), id.str(), ""))[5];

  // ---- the walk: source-tree.bml's rules, the files and directories kept as tables ---------------------------------------------
  def fnd-dir-note(s, dir, names) {
   let ident = host_file_identity(fnd-dir-path(s, dir));
   let dirs = record_get(s, "dirs");
   let fresh = !fnd-mhas?(dirs, dir);
   let z = fresh ? record_set(s, "dirlist", cons(dir, record_get(s, "dirlist"))) : 0;
   fnd-mset(dirs, dir, [(String) value_kind(ident) == "list" ? ident[1] : 0, names]);
  }
  def fnd-walk(s, dir, rules, depth) {
   let names = fs_list(fnd-dir-path(s, dir));
   (nothing?(names) || depth > 40) ? 0 : fnd-walk-dir(s, dir, stw-with-nested(dir, rules, names), depth, names);
  }
  def fnd-walk-dir(s, dir, rules, depth, names) {
   let z = fnd-dir-note(s, dir, names);
   fnd-walk-keys(s, dir, rules, depth, sort-strs(names |> map(n => stw-key(dir, n))));
  }
  def fnd-walk-keys(s, dir, rules, depth, keys) = nil?(keys) ? 0 : fnd-walk-next(s, dir, rules, depth, keys, fnd-walk-entry(s, dir, rules, depth, keys[0]));
  def fnd-walk-next(s, dir, rules, depth, keys, z) = fnd-walk-keys(s, dir, rules, depth, keys[1:]);
  def fnd-walk-entry(s, dir, rules, depth, key) {
   let isdir = stw-ends?(key, "/");
   let name = isdir ? substring(key, 0, len(key) - 1) : key;
   let path = stw-path(dir, name);
   (stw-has?(stw-never(), name) || stw-ign(rules, path, name, isdir)) ? 0 : isdir ? fnd-walk(s, path, rules, depth + 1) : fnd-add(s, path);
  }
  def fnd-build(s) {
   let t0 = host_monotonic_ms();
   let z0 = record_set(s, "building", 1);
   let z1 = record_set(s, "heldrev", []);
   let z2 = fnd-walk(s, fnd-base(s), [], 0);
   let z3 = record_set(s, "held", reverse(record_get(s, "heldrev")));
   let z4 = record_set(s, "heldrev", []);
   let z5 = record_set(s, "building", 0);
   let z5b = fnd-stats-rebuild(s);
   let z6 = fnd-cset(s, "build_ms", host_monotonic_ms() - t0);
   s;
  }
  // one row per file for the refresh: [rel, path on disk, size, mtime, inode]
  def fnd-stats-rebuild(s) = record_set(s, "stats", record_get(s, "rels") |> map(rel => fnd-stat-of(s, rel)));
  def fnd-stat-of(s, rel) = fnd-stat-row(s, rel, fnd-entry(s, rel));
  def fnd-stat-row(s, rel, e) = nil?(e) ? [rel, fnd-abs(s, rel), 0 - 1, 0 - 1, 0 - 1] : [rel, fnd-abs(s, rel), e[1], e[2], e[3]];
  def fnd-open(base) = fnd-build(fnd-new(base));

  // ---- the trigram postings: built the first time a search needs a trigram, kept, kept right when a file changes ---------------
  def fnd-posting(s, t) {
   let tri = record_get(s, "tri");
   fnd-mhas?(tri, t) ? fnd-mget(tri, t, []) : fnd-posting-build(s, t, tri);
  }
  def fnd-posting-build(s, t, tri) {
   let ids = record_get(s, "held") |> filter(h => str_find(h[2], t, 0) >= 0) |> map(h => h[0]);
   let z1 = fnd-posting-keep(s, t, ids);
