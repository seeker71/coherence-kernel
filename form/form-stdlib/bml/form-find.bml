   : fnd-find-files(s, o, args, cands[1:], append(acc, got[1]), bytes + foldl((a, r) => a + len(r) + 1, 0, got[1]), skipped);
  def fnd-find-note(truncated, skipped) = (truncated == 1 ? "truncated: output-limit " ++ fnd-max-out().str() ++ " bytes; add paths or a longer pattern. " : "") ++ (nil?(skipped) ? "" : "skipped " ++ len(skipped).str() ++ " file(s) whose lines exhaust the engine's work budget (pattern-work-limit): " ++ fat-join(skipped, " "));
  def fnd-find-done(rows, truncated, skipped) = nil?(rows) ? [1, "", fnd-find-note(truncated, skipped)] : [0, fat-join(rows, "\n") ++ "\n", fnd-find-note(truncated, skipped)];

  // ---- defs, callers, bands, imports -----------------------------------------------------------------------------------------------------------
  def fnd-def-row(s, en) {
   let rel = fnd-mget(record_get(s, "byid"), en[0].str(), "");
   let text = fnd-text-of(s, en[0]);
   let ls = fnd-line-start(text, en[1]);
   [rel ++ fnd-sep() ++ fnd-pad(en[1], 9), rel ++ ":" ++ (1 + fnd-nl(text, 0, ls, 0)).str() ++ ":" ++ fnd-line-at(text, ls)];
  }
  def fnd-defs(s, names) = nil?(names) ? fnd-refuse("defs: defs-needs-a-name") : fnd-ok(fnd-sorted(foldl((acc, n) => append(acc, fnd-mget(record_get(s, "defs"), n, []) |> map(en => fnd-def-row(s, en))), [], names)));
  def fnd-callers(s, name) = (String) name == "" ? fnd-refuse("callers: callers-needs-a-name") : fnd-ok(fnd-callers-rows(s, name, fnd-cands(s, [name], [])));
  def fnd-callers-rows(s, name, cands) = foldl((acc, h) => append(acc, fnd-file-callers(s, name, h)), [], cands);
  def fnd-def-offs(s, name, id) = fnd-mget(record_get(s, "defs"), name, []) |> filter(en => (Comparable) en[0] == id) |> map(en => en[1]);
  def fnd-file-callers(s, name, h) = reverse(fnd-occ(h[1], h[2], name, fnd-def-offs(s, name, h[0]), 0, 0, 1, 0 - 1, []));
  def fnd-occ(rel, t, name, defoffs, from, cpos, cline, lastls, acc) = str_find(t, name, from) < 0 ? acc : fnd-occ-hit(rel, t, name, defoffs, cpos, cline, lastls, acc, str_find(t, name, from));
  def fnd-occ-hit(rel, t, name, defoffs, cpos, cline, lastls, acc, p) {
   let valid = fnd-bound?(t, p, len(name)) && !fnd-has-int?(defoffs, p);
   let ls = fnd-line-start(t, p);
   let line = cline + fnd-nl(t, cpos, p, 0);
   let take = valid && ls != lastls;
   fnd-occ(rel, t, name, defoffs, p + len(name), p, line, valid ? ls : lastls, take ? cons(rel ++ ":" ++ line.str() ++ ":" ++ fnd-line-at(t, ls), acc) : acc);
  }
  def fnd-band-row(h, name) = h[1] ++ " expected=" ++ h[3][0] ++ " verdict=" ++ h[3][1] ++ ((String) name == "" ? "" : " mentions=" ++ fnd-count-lines(h[2], name, 0, 0).str());
  def fnd-bands(s, names) {
   let name = nil?(names) ? "" : names[0];
   let named = (String) name == "" ? (record_get(s, "held") |> filter(h => !nil?(h[3]))) : (fnd-cands(s, [name], []) |> filter(h => !nil?(h[3])));
   fnd-ok(named |> map(h => fnd-band-row(h, name)));
  }
  def fnd-resolve(s, x) = !nil?(fnd-entry(s, x)) ? [x] : !nil?(fnd-entry(s, "form/" ++ x)) ? ["form/" ++ x] : (fnd-mget(record_get(s, "bases"), fnd-basename(x), []) |> filter(r => fnd-ends?(r, "/" ++ x) || (String) r == x));
  def fnd-raw-of?(raw, p) = (String) p == raw || (String) p == "form/" ++ raw || fnd-ends?(p, "/" ++ raw);
  def fnd-imp-row(s, p, en) {
   let rel = fnd-mget(record_get(s, "byid"), en[0].str(), "");
   let text = fnd-text-of(s, en[0]);
   let ls = fnd-line-start(text, en[2]);
   [rel ++ fnd-sep() ++ fnd-pad(en[2], 9), p ++ " <- " ++ rel ++ ":" ++ (1 + fnd-nl(text, 0, ls, 0)).str() ++ ":" ++ fnd-line-at(text, ls)];
  }
  def fnd-imports-of(s, p) = fnd-entry(s, p)[7] |> map(e => p ++ " -> " ++ e[1]);
  def fnd-imported-by(s, p) = fnd-sorted(fnd-mget(record_get(s, "imps"), fnd-basename(p), []) |> filter(en => fnd-raw-of?(en[1], p)) |> map(en => fnd-imp-row(s, p, en)));
  def fnd-imports(s, names) = nil?(names) ? fnd-refuse("imports: imports-needs-a-unit") : fnd-ok(foldl((acc, p) => append(acc, append(fnd-imports-of(s, p), fnd-imported-by(s, p))), [], fnd-resolve(s, names[0])));

  // ---- rows: a .jsonl census or ledger as a keyed table; a table is built the first time a field is asked and read again when the file moves ------
  def fnd-str-end(t, i) {
   let j = scan_run(t, i, 4);
   j >= len(t) ? len(t) : str_byte_at(t, j) == 34 ? j + 1 : fnd-str-end(t, j + 2);
  }
  def fnd-lit-end(t, i) = (i >= len(t) || str_byte_at(t, i) == 44 || str_byte_at(t, i) == 125 || str_byte_at(t, i) == 93 || str_byte_at(t, i) == 32 || str_byte_at(t, i) == 10 || str_byte_at(t, i) == 13 || str_byte_at(t, i) == 9) ? i : fnd-lit-end(t, i + 1);
  def fnd-skip-nest(t, i, depth) = i >= len(t) ? len(t) : fnd-nest-byte(t, i, depth, str_byte_at(t, i));
  def fnd-nest-byte(t, i, depth, b) = b == 34 ? fnd-skip-nest(t, fnd-str-end(t, i + 1), depth) : (b == 91 || b == 123) ? fnd-skip-nest(t, i + 1, depth + 1) : (b == 93 || b == 125) ? (depth == 1 ? i + 1 : fnd-skip-nest(t, i + 1, depth - 1)) : fnd-skip-nest(t, i + 1, depth);
  def fnd-skip-value(t, i) = i >= len(t) ? i : str_byte_at(t, i) == 34 ? fnd-str-end(t, i + 1) : (str_byte_at(t, i) == 91 || str_byte_at(t, i) == 123) ? fnd-skip-nest(t, i + 1, 1) : fnd-lit-end(t, i);
  def fnd-pairs(t) {
   let st = scan_run(t, 0, 0);
   (st < len(t) && str_byte_at(t, st) == 123) ? fnd-pairs-from(t, st + 1, []) : [];
  }
  def fnd-pairs-from(t, i, acc) {
   let j = scan_run(t, i, 0);
   (j >= len(t) || str_byte_at(t, j) != 34) ? reverse(acc) : fnd-pair-key(t, j + 1, acc);
  }
  def fnd-pair-key(t, ks, acc) {
   let ke = fnd-str-end(t, ks);
   let key = substring(t, ks, ke - 1);
   let vs = scan_run(t, scan_run(t, ke, 0) + 1, 0);
   let ve = fnd-skip-value(t, vs);
   let after = scan_run(t, ve, 0);
   let acc2 = cons([key, substring(t, vs, ve)], acc);
   (after < len(t) && str_byte_at(t, after) == 44) ? fnd-pairs-from(t, after + 1, acc2) : reverse(acc2);
  }
  def fnd-pair-get(pairs, key) = nil?(pairs) ? "" : (String) pairs[0][0] == key ? pairs[0][1] : fnd-pair-get(pairs[1:], key);
  def fnd-array-items(raw, from, acc) = str_find(raw, fnd-q(), from) < 0 ? reverse(acc) : fnd-array-item(raw, str_find(raw, fnd-q(), from), acc);
  def fnd-array-item(raw, p, acc) = fnd-array-items(raw, fnd-str-end(raw, p + 1), cons(substring(raw, p + 1, fnd-str-end(raw, p + 1) - 1), acc));
  def fnd-value-items(raw) = len(raw) == 0 ? [] : str_byte_at(raw, 0) == 34 ? [substring(raw, 1, len(raw) - 1)] : str_byte_at(raw, 0) == 91 ? fnd-array-items(raw, 1, []) : [raw];
  def fnd-rowtab(s, path) {
   let tabs = record_get(s, "rowtabs");
   let ident = host_file_identity(fnd-abs(s, path));
   let held = fnd-mget(tabs, path, []);
   (String) value_kind(ident) != "list" ? [] : (!nil?(held) && fnd-same-ident?([0, held[0][0], held[0][1], held[0][2]], ident)) ? held : fnd-rowtab-load(s, path, tabs, ident);
  }
  def fnd-rowtab-load(s, path, tabs, ident) {
   let text = fnd-read(s, fnd-abs(s, path));
   let lines = fag-lines(text);
   let lm = fnd-map();
   let z1 = fnd-lines-fill(lm, lines, 1);
   let entry = [[ident[0], ident[1], ident[2]], lm, len(lines), record_new(0), lines];
   let z2 = fnd-mset(tabs, path, entry);
   entry;
  }
  def fnd-lines-fill(lm, lines, i) = nil?(lines) ? 0 : fnd-lines-next(lm, lines, i, fnd-mset(lm, i.str(), lines[0]));
  def fnd-lines-next(lm, lines, i, z) = fnd-lines-fill(lm, lines[1:], i + 1);
  // the table of one field: value -> the line numbers holding it (newest first), and the values in the order first met
  def fnd-field-tab(entry, field) {
   let ft = entry[3];
   record_has(ft, field) ? record_get(ft, field) : fnd-field-build(entry, field, ft);
  }
  def fnd-field-build(entry, field, ft) {
   let tab = fnd-map();
   let keys = record_new(0);
   let z0 = record_set(keys, "list", []);
   let z1 = fnd-field-lines(tab, keys, field, entry[4], 1);
   let built = [tab, record_get(keys, "list")];
   let z2 = record_set(ft, field, built);
   built;
  }
  def fnd-field-lines(tab, keys, field, lines, i) = nil?(lines) ? 0 : fnd-field-next(tab, keys, field, lines, i, fnd-field-add(tab, keys, i, fnd-value-items(fnd-pair-get(fnd-pairs(lines[0]), field))));
  def fnd-field-next(tab, keys, field, lines, i, z) = fnd-field-lines(tab, keys, field, lines[1:], i + 1);
  def fnd-field-add(tab, keys, i, items) = nil?(items) ? 0 : fnd-field-add-next(tab, keys, i, items, fnd-field-one(tab, keys, i, items[0]));
  def fnd-field-add-next(tab, keys, i, items, z) = fnd-field-add(tab, keys, i, items[1:]);
  def fnd-field-one(tab, keys, i, item) {
   let seen = fnd-mhas?(tab, item);
   let z = seen ? 0 : record_set(keys, "list", cons(item, record_get(keys, "list")));
   fnd-mset(tab, item, cons(i, fnd-mget(tab, item, [])));
  }
  def fnd-rows(s, args) = nil?(args) ? fnd-refuse("rows: rows-needs-a-file") : fnd-rows-table(s, args[0], nil?(args[1:]) ? "" : args[1], fnd-rowtab(s, args[0]));
  def fnd-rows-table(s, path, spec, entry) = nil?(entry) ? [2, "", "rows: no such file: " ++ path] : (String) spec == "" ? [0, entry[2].str() ++ " rows\n", ""] : fnd-rows-spec(entry, spec, str_find(spec, "=", 0));
  def fnd-rows-spec(entry, spec, eq) = eq < 0 ? fnd-rows-values(fnd-field-tab(entry, spec), spec) : fnd-rows-match(entry, fnd-field-tab(entry, substring(spec, 0, eq)), substring(spec, eq + 1, len(spec)));
  def fnd-rows-values(tabkeys, field) = [0, fat-join(sort-strs(tabkeys[1]) |> map(v => v ++ "\t" ++ len(fnd-mget(tabkeys[0], v, [])).str()), "\n") ++ "\n", ""];
  def fnd-rows-match(entry, tabkeys, value) = fnd-ok(reverse(fnd-mget(tabkeys[0], value, [])) |> map(i => fnd-mget(entry[1], i.str(), "")));

  // ---- status ----------------------------------------------------------------------------------------------------------------------------------------
  def fnd-tri-entries(s) = foldl((a, t) => a + len(fnd-mget(record_get(s, "tri"), t, [])), 0, record_get(s, "trilist"));
  def fnd-status-text(s) = "files=" ++ fnd-c(s, "files").str() ++ " held=" ++ fnd-c(s, "heldfiles").str() ++ " bytes=" ++ fnd-c(s, "bytes").str() ++ " defs=" ++ fnd-c(s, "defs").str() ++ " imports=" ++ fnd-c(s, "imps").str() ++ " bands=" ++ fnd-c(s, "bands").str() ++ " trigrams=" ++ len(record_get(s, "trilist")).str() ++ " postings=" ++ fnd-tri-entries(s).str() ++ " reads=" ++ fnd-c(s, "reads").str() ++ " build_ms=" ++ fnd-c(s, "build_ms").str() ++ " refresh_ms=" ++ fnd-c(s, "refresh_ms").str() ++ " changed=" ++ fnd-c(s, "refresh_changed").str() ++ "\n";

  // ---- the memory: the notes kept for this body are files with a frontmatter (name, description, type); they are asked like the rest of the tree
  //   memory WORDS...   the notes whose name, description or first lines hold every word: file, type, name — description
  //   memory --index    the index derived from the notes: the newest thirty with their hook, the rest as links, newest first
  //   memory --write    the same index written as MEMORY.md in the notes' directory, so the index is never kept by hand
  def fnd-mem-env(name) = (String) value_kind(host_getenv(name)) == "string" ? host_getenv(name) : "";
  def fnd-mem-dir() = len(fnd-mem-env("FORM_MEMORY_DIR")) > 0 ? fnd-mem-env("FORM_MEMORY_DIR") : fnd-mem-env("HOME") ++ "/.claude/projects/-Users-ursmuff-source-coherence-kernel/memory";
  def fnd-mem-starts?(s, p) = len(s) >= len(p) && (String) substring(s, 0, len(p)) == p;
  def fnd-mem-ends?(s, x) = len(s) >= len(x) && (String) substring(s, len(s) - len(x), len(s)) == x;
  def fnd-mem-lower-byte(b) = byte_to_str(b >= 65 && b <= 90 ? b + 32 : b);
  def fnd-mem-lower(s) = str-spans(map(i => fnd-mem-lower-byte(str_byte_at(s, i)), range(0, len(s))));
  def fnd-mem-key(lines, key) = nil?(lines) ? "" : fnd-mem-starts?(lines[0], key) ? trim(substring(lines[0], len(key), len(lines[0]))) : fnd-mem-key(lines[1:], key);
  def fnd-mem-unq(s) = len(s) >= 2 && (String) substring(s, 0, 1) == "\"" && (String) substring(s, len(s) - 1, len(s)) == "\"" ? substring(s, 1, len(s) - 1) : s;
  def fnd-mem-names() = filter(n => fnd-mem-ends?(n, ".md") && (String) n != "MEMORY.md", fs_list(fnd-mem-dir()) ?? []);
  def fnd-mem-entry(name) {
   let path = fnd-mem-dir() ++ "/" ++ name;
   let head = take(40, split-on(read_file(path) ?? "", "\n"));
   [name, fnd-mem-unq(fnd-mem-key(head, "name:")), fnd-mem-unq(fnd-mem-key(head, "description:")), fnd-mem-key(head, "  type:"), fnd-mem-lower(fat-join(head, "\n")), (host_file_identity(path) ?? [0, 0])[1]];
  }
  def fnd-mem-hit?(e, words) = all?(w => str_find(e[4], fnd-mem-lower(w), 0) >= 0, words);
  def fnd-mem-row(e) = e[0] ++ "\t" ++ e[3] ++ "\t" ++ e[1] ++ " — " ++ e[2];
  def fnd-mem-zeros(k) = k <= 0 ? "" : "0" ++ fnd-mem-zeros(k - 1);
  def fnd-mem-stamp(e) = fnd-mem-zeros(14 - len(e[5].str())) ++ e[5].str() ++ "|" ++ e[0];
  def fnd-mem-newest(es) = reverse(sort-strs(map(e => fnd-mem-stamp(e), es))) |> map(k => fnd-mem-by-name(es, substring(k, 15, len(k))));
  def fnd-mem-by-name(es, name) = nil?(es) ? [] : (String) es[0][0] == name ? es[0] : fnd-mem-by-name(es[1:], name);
  def fnd-mem-safe(s, k) = k > 0 && str_byte_at(s, k) >= 128 && str_byte_at(s, k) < 192 ? fnd-mem-safe(s, k - 1) : k;
  def fnd-mem-cut(s, n) = len(s) <= n ? s : substring(s, 0, fnd-mem-safe(s, n)) ++ "…";
  def fnd-mem-link(e) = "[" ++ e[1] ++ "](" ++ e[0] ++ ")";
  def fnd-mem-full(e) = "- " ++ fnd-mem-link(e) ++ " — " ++ fnd-mem-cut(e[2], 60);
  def fnd-mem-group(es) = "- " ++ fat-join(map(e => fnd-mem-link(e), es), " · ");
  def fnd-mem-chunks(xs, n) = nil?(xs) ? [] : cons(take(n, xs), fnd-mem-chunks(xs[n:], n));
  def fnd-mem-index(es) {
   let ordered = fnd-mem-newest(es);
   fat-join(append(map(e => fnd-mem-full(e), take(30, ordered)), map(g => fnd-mem-group(g), fnd-mem-chunks(ordered[30:], 6))), "\n") ++ "\n";
  }
  def fnd-mem-write(es) {
   let text = fnd-mem-index(es);
   let written = write_file_text(fnd-mem-dir() ++ "/MEMORY.md", text);
   [0, len(text).str() ++ " bytes, " ++ len(es).str() ++ " notes\n", ""];
  }
  // self-indexing: a service beat or any query looks at the notes with one stat each, and rewrites the index only when a note is newer than it,
  // a note is gone or added (the links no longer count the notes), or the index is absent; nobody has to remember to regenerate it
  def fnd-mem-mtime(name) = (host_file_identity(fnd-mem-dir() ++ "/" ++ name) ?? [0, 0])[1];
  def fnd-mem-newest-mtime(names) = foldl((acc, n) => fnd-mem-mtime(n) > acc ? fnd-mem-mtime(n) : acc, 0, names);
  def fnd-mem-links(text) = len(split-on(text, "](")) - 1;
  def fnd-mem-stale?(names) {
   let index = fnd-mem-dir() ++ "/MEMORY.md";
   let at = (host_file_identity(index) ?? [0, 0])[1];
   at == 0 || fnd-mem-newest-mtime(names) > at || fnd-mem-links(read_file(index) ?? "") != len(names);
  }
  def fnd-mem-sync() {
   let names = fnd-mem-names();
   (len(names) > 0 && fnd-mem-stale?(names)) ? fnd-mem-write(map(n => fnd-mem-entry(n), names))[1] : "";
  }
  def fnd-mem-verb(s, argv, input) {
   let flags = filter(w => fnd-mem-starts?(w, "--"), argv[1:]);
   let terms = filter(w => !fnd-mem-starts?(w, "--"), argv[1:]);
   let es = map(n => fnd-mem-entry(n), fnd-mem-names());
   let hits = filter(e => fnd-mem-hit?(e, terms), es);
   fnd-has?(flags, "--write") ? fnd-mem-write(es) : fnd-has?(flags, "--index") ? [0, fnd-mem-index(es), ""] : nil?(hits) ? [1, "", ""] : [0, fat-join(map(e => fnd-mem-row(e), hits), "\n") ++ "\n", ""];
  }

  // ---- the wire in, the wire out -----------------------------------------------------------------------------------------------------------------------
  def fnd-reply(r) = fat-wire-render(fat-result(r[0], r[1], r[2], []));
  def fnd-verbs() = ["find", "defs", "callers", "bands", "imports", "rows", "status", "refresh"];
  def fnd-tools() = ["read", "cat", "head", "tail", "sed", "wc", "jq", "grep", "rg"];
  def fnd-serve(s, request) = !fat-text?(request) ? fat-wire-refusal("wire-request-needs-text") : len(request) > FatMaxBytes() ? fat-wire-refusal("wire-request-limit") : !faj-valid(request) ? fat-wire-refusal("invalid-wire-json") : fnd-serve-node(s, request, faj-json("form-agent-tool-wire", request));
  def fnd-serve-node(s, request, node) = !fat-wire-object?(node) ? fat-wire-refusal("wire-request-needs-object") : fnd-serve-command(s, request, node, fat-wire-required-string(node, "command"));
  def fnd-serve-command(s, request, node, command) = !((String) fat-wire-error(command) == "") ? fat-wire-refusal(fat-wire-error(command)) : fnd-serve-input(s, request, node, fat-wire-value(command), fat-wire-field-string(node, "input", ""));
  def fnd-serve-input(s, request, node, command, input) = !((String) fat-wire-error(input) == "") ? fat-wire-refusal(fat-wire-error(input)) : fnd-serve-argv(s, request, node, command, fat-wire-value(input), fat-argv(command));
  def fnd-serve-argv(s, request, node, command, input, parsed) = (String) parsed[1] != "" ? fat-wire-refusal(parsed[1]) : nil?(parsed[0]) ? fat-wire-refusal("missing-tool") : fnd-serve-verb(s, request, node, command, input, parsed[0]);
  def fnd-serve-verb(s, request, node, command, input, argv) {
   let own = fnd-has?(fnd-verbs(), argv[0]) || fnd-ext?(s, argv[0]);
   let docs = fat-wire-documents(node);
   (!own && (String) fat-wire-error(docs) == "" && !nil?(fat-wire-value(docs))) ? fat-wire-call(request) : fnd-serve-fresh(s, command, input, argv, own);
  }
  def fnd-serve-fresh(s, command, input, argv, own) {
   let changed = fnd-refresh(s);
   let indexed = fnd-mem-sync();
   fnd-reply(own ? fnd-verb(s, argv, changed, input) : fnd-tool(s, command, input, argv));
  }
  // a verb another unit teaches the service (form-path.bml's `path`): s holds [name, handler] rows, handler(s, argv, input) answers [exit, stdout, stderr]
  def fnd-ext?(s, name) = !nil?(fnd-ext-row(record_get(s, "ext"), name));
  def fnd-ext-row(rows, name) = nil?(rows) ? [] : (String) rows[0][0] == name ? rows[0] : fnd-ext-row(rows[1:], name);
  def fnd-ext-add(s, name, handler) = record_set(s, "ext", cons([name, handler], record_get(s, "ext")));
  def fnd-ext-call(s, argv, input) = fnd-ext-run(fnd-ext-row(record_get(s, "ext"), argv[0]), s, argv, input);
  def fnd-ext-run(row, s, argv, input) = row[1](s, argv, input);
  def fnd-verb(s, argv, changed, input) = fnd-ext?(s, argv[0]) ? fnd-ext-call(s, argv, input)
   : (String) argv[0] == "find" ? fnd-find(s, argv)
   : (String) argv[0] == "defs" ? fnd-defs(s, argv[1:])
   : (String) argv[0] == "callers" ? fnd-callers(s, nil?(argv[1:]) ? "" : argv[1])
   : (String) argv[0] == "bands" ? fnd-bands(s, argv[1:])
   : (String) argv[0] == "imports" ? fnd-imports(s, argv[1:])
   : (String) argv[0] == "rows" ? fnd-rows(s, argv[1:])
   : (String) argv[0] == "status" ? [0, fnd-status-text(s), ""]
   : [0, "refreshed: " ++ changed.str() ++ " changes\n", ""];
  def fnd-tool(s, command, input, argv) = (String) argv[0] == "edit" || (String) argv[0] == "write" ? fnd-refuse("form-find-reads-only: edit and write belong to the edit tool")
   : !fnd-has?(fnd-tools(), argv[0]) ? fnd-refuse("unknown-command: " ++ argv[0] ++ "; form-find answers find defs callers bands imports rows status refresh, and read cat head tail sed wc jq grep rg over indexed files")
   : fnd-tool-docs(s, command, input, argv, argv[1:] |> filter(a => !fnd-starts?(a, "-")) |> map(a => fnd-entry(s, a)) |> filter(e => !nil?(e) && e[4] == 1));
  def fnd-tool-docs(s, command, input, argv, ents) = ((String) argv[0] == "rg" || (String) argv[0] == "grep") && nil?(ents) ? fnd-refuse("use find PATTERN [PATH...]: rg and grep over the whole tree are find; name an indexed file to search one")
   : fnd-tool-run(command, input, ents |> map(e => ["resident:" ++ fnd-rel-of(s, e), fnd-rel-of(s, e), e[5]]));
  def fnd-rel-of(s, e) = fnd-mget(record_get(s, "byid"), e[0].str(), "");
  def fnd-tool-run(command, input, docs) {
   let r = fat-command(docs, command, input);
   [fat-exit(r), fat-out(r), fat-error(r)];
  }
  // the cold door: a service that is absent still answers, from an index of this process's own
  def fnd-cold(request) = fnd-serve(fnd-open(""), request);

  // ---- the spool: ask.<n>.json in, ans.<n>.json out ----------------------------------------------------------------------------------------------------------
  def fnd-spool() = host_getenv("FORM_FIND_SPOOL") ?? ("/tmp/form-find/" ++ (host_getenv("UID") ?? (host_getenv("USER") ?? "default")));
  def fnd-ask?(n) = fnd-starts?(n, "ask.") && fnd-ends?(n, ".json");
  def fnd-ans-name(n) = "ans." ++ substring(n, 4, len(n) - 5) ++ ".json";
  def fnd-mkdirs(dir) {
   let cut = fnd-last-slash(dir, len(dir) - 1);
   let z = cut > 0 ? host_mkdir_mode(substring(dir, 0, cut), 493) : 0;
   host_mkdir_mode(dir, 448);
  }
  def fnd-poll(s, dir) {
   let names = fs_list(dir);
   let asks = (String) value_kind(names) == "list" ? sort-strs(filter(n => fnd-ask?(n), names)) : [];
   fnd-poll-each(s, dir, asks, 0);
  }
  def fnd-poll-each(s, dir, asks, served) = nil?(asks) ? served : fnd-poll-next(s, dir, asks, served, fnd-poll-one(s, dir, asks[0]));
  def fnd-poll-next(s, dir, asks, served, did) = fnd-poll-each(s, dir, asks[1:], served + did);
  // an ask still being written (empty or not yet valid JSON, younger than 400 ms) is left for the next look
  def fnd-poll-one(s, dir, n) {
   let path = dir ++ "/" ++ n;
   let text = read_file(path) ?? "";
   let ident = host_file_identity(path);
   let age = (String) value_kind(ident) == "list" ? now_unix_ms() - ident[1] : 1000000;
   ((len(text) == 0 || !faj-valid(text)) && age < 400) ? 0 : fnd-answer(s, dir, n, path, text);
  }
  def fnd-answer(s, dir, n, path, text) {
   let resp = fnd-serve(s, text);
   let ans = dir ++ "/" ++ fnd-ans-name(n);
   let z1 = write_file_text(ans ++ ".part", resp);
   let z2 = fs_rename(ans ++ ".part", ans);
   let z3 = host_path_remove(path);
   1;
  }
  def fnd-status-json(s) = json-emit(json-node-object([json-node-pair("service", json-node-string("form-find")), json-node-pair("pid", json-node-int(host_pid())), json-node-pair("beat_ms", json-node-int(now_unix_ms())), json-node-pair("status", json-node-string(fnd-status-text(s)))]));
  def fnd-beat(s, dir) = write_file_text(dir ++ "/status.json", fnd-status-json(s));
  // the loop: look, answer what is there, rest. busy (an ask within 10 s) rests 20 ms, idle 100 ms. A `stop` file ends it (launchd then starts the next).
  def fnd-loop(s, dir, busy_at, beat_at) {
   let served = fnd-poll(s, dir);
   let now = host_monotonic_ms();
   let busy = served > 0 ? now : busy_at;
   let due = now - beat_at > 2000;
   let z1 = due ? fnd-beat(s, dir) : 0;
   let z3 = due ? fnd-mem-sync() : "";
   let stop = (Comparable) host_path_exists(dir ++ "/stop") == 1;
   let z2 = stop ? host_path_remove(dir ++ "/stop") : host_sleep_ms(now - busy < 10000 ? 20 : 100);
   stop ? 0 : fnd-loop(s, dir, busy, due ? now : beat_at);
  }
  def fnd-run() {
   let dir = fnd-spool();
   let z1 = fnd-mkdirs(dir);
   let s = fnd-open("");
   let z2 = fnd-beat(s, dir);
   fnd-loop(s, dir, host_monotonic_ms(), host_monotonic_ms());
  }
 }
 0;
}
