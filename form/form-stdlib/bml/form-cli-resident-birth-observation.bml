//////////////////////////////////////////////////////////////////////
// form-cli-resident-birth-observation.bml -- one typed projection of
// public resident birth lines. It accepts already-observed server text;
// it neither opens a model nor reads a path itself.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/hearth-glass.bml

section [form.bml] {
    class FormCliResidentBirthObservation {
        field Tag = "form-cli-resident-birth-v1";
        field CacheKey = "program-image-cache";
        field SourceContextKey = "source-context-ms";
        field NativeProgramKey = "native-program-ms";
        field ResidentSetupKey = "resident-setup-ms";
        field PrefillKey = "admit-prefill-ms";

        def fcrbo-tag() = Tag();
        def fcrbo-cache-key() = CacheKey();
        def fcrbo-source-context-key() = SourceContextKey();
        def fcrbo-native-program-key() = NativeProgramKey();
        def fcrbo-resident-setup-key() = ResidentSetupKey();
        def fcrbo-prefill-key() = PrefillKey();
        def fcrbo-text(out, key) {
            let value = gl-word-field-last(out, key);
            if str_eq(value, "") then nothing() else value;
        }
        def fcrbo-int(out, key) {
            let value = fcrbo-text(out, key);
            if nothing?(value) then nothing() else str_to_int(value);
        }
        def fcrbo-snapshot(out) = list(fcrbo-tag(), fcrbo-text(out, fcrbo-cache-key()), fcrbo-int(out, fcrbo-source-context-key()), fcrbo-int(out, fcrbo-native-program-key()), fcrbo-int(out, fcrbo-resident-setup-key()), fcrbo-int(out, fcrbo-prefill-key()));
        def fcrbo-snapshot?(snapshot) = if nothing?(snapshot) then 0 else if not(eq(len(snapshot), 6)) then 0 else str_eq(nth(snapshot, 0), fcrbo-tag());
        def fcrbo-cache(snapshot) = nth(snapshot, 1);
        def fcrbo-source-context-ms(snapshot) = nth(snapshot, 2);
        def fcrbo-native-program-ms(snapshot) = nth(snapshot, 3);
        def fcrbo-resident-setup-ms(snapshot) = nth(snapshot, 4);
        def fcrbo-prefill-ms(snapshot) = nth(snapshot, 5);
        def fcrbo-display-text(value) = if nothing?(value) then "nothing" else value;
        def fcrbo-display-int(value) = if nothing?(value) then "nothing" else int_to_str(value);
    }
    0;
}
