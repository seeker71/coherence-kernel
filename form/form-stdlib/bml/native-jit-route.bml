// Native compilation authority and an executable machine-code witness.
// preludes: form-stdlib/core.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk
section [form.bml] {
 class NativeJitRoute {
  def njr-owner() = "Form";
  def njr-door() = "./fkwu <file.fk|file.bml>";
  def njr-emitter() = "form/form-stdlib/form-lower.fk";
  def njr-demand() = "form/form-stdlib/form-cli-jit.bml";
  // f(n) = n * 3 + 7. The Form emitter creates the bytes; the carrier
  // only maps and calls them. This probe does not claim other functions
  // acquired a compiled entry: their result assertions stand separately.
  def njr-image() = lo-compile-fn([[1, 7], [2], [1, 3], [5, 1, 2], [3, 3, 0]], 4);
  def njr-probe() = ((Comparable) jit_leaf_inram(njr-image(), 5) == 22);
 }
 0;
}
