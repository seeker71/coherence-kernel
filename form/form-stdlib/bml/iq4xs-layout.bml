//////////////////////////////////////////////////////////////////////
// IQ4_XS (GGML type 23) layout authority.
//////////////////////////////////////////////////////////////////////

package Form.native.quant;

import Form.kernel.*;
import Form.native.metal.*;

interface IIQ4XSLayout [public, witness, reusable] {
   section [public] {
      const int GGMLType = 23;
      const int BlockElements = 256;
      const int BlockBytes = 136;
      const int ScaleHighOffset = 2;
      const int ScaleLowOffset = 4;
      const int QuantOffset = 8;
      const int GroupsPerBlock = 8;
      const int GroupElements = 32;
      const int CodebookEntries = 16;
      const int SIMDWidth = 32;
      const int SlotRows = 4;

      int ScaleCode( Object bytes, int blockBase, int group ) [abstract];
      int QuantCode( Object bytes, int blockBase, int weightIndex ) [abstract];
      int SlotThreadCount( int rows ) [abstract];
      bool WithinBlock( int weightIndex ) [abstract];
   }
}

class IQ4XSLayout [public, reusable, teach, observable] : IIQ4XSLayout {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/iq4xs-layout.bml";
      const String Model = "Qwen3.8-Flash-Next UD-Q2_K_XL";
      int ScaleCode( Object bytes, int blockBase, int group ) [abstract] {}
      int QuantCode( Object bytes, int blockBase, int weightIndex ) [abstract] {}
      int SlotThreadCount( int rows ) [abstract] {}
      bool WithinBlock( int weightIndex ) [abstract] {}
   }
}
