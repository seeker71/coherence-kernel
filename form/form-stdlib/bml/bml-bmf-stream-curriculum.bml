//////////////////////////////////////////////////////////////////////
//
// High-grammar authority for the local BML/BMF streaming curriculum.
// This is held out from the metric/alarm/route training families.
//
// Executable companion:
//   form/form-stdlib/bml-bmf-stream-curriculum.bml
//
//////////////////////////////////////////////////////////////////////

package Form.learning.stream;

import Form.kernel.*;
import BMF.cursor.*;

interface IStreamCurriculum [public, witness] {
    Object Grammar() [get];
    Object Program() [get];
    Object Feed( String source );
    int RetainedBound() [get];
}

class StreamCurriculum<TGrammar> [public, teach, reusable] : IStreamCurriculum {
    section [public] {
        const int CaptureBound = 8;
        const String CursorRoute = "scannerless-byte-fold-no-tokenizer";
        const String CompletionLaw = "continue-until-suffix-incomplete-on-final-prefix";
        const String NothingLaw = "unsupported-grammar-is-nothing-never-zero-or-one";
        const String ScaleLaw = "fixed-state-plus-two-bounded-captures-source-history-not-retained";

        Object Grammar() [abstract] {}
        Object Program() [abstract] {}
        Object Feed( String source ) [abstract] {}
        int RetainedBound() [abstract] {}
    }
}

class StreamCurriculumSelf [public, selfHosting, observable] {
    section [public] {
        bool Executable() [witness] { return true; }
        bool Scannerless() [witness] { return true; }
        bool TokenizerPrestep() [witness] { return false; }
    }
}
