// A retained native reader for an append-only organ flow. Only complete JSONL
// records become observations. A caller owns the reader and its work budget.
import form-stdlib/organ-health.bml;
import form-stdlib/bml/json-view-parse.bml;
import form-stdlib/bml/json-view-cache.bml;
import form-stdlib/keyed-map.fk;
section [form.bml] {
 class OrganHealthStream {
  def ohs-open(path,generation) {
   let owner = record_new(0,"path",path);
   record_set(owner,"identity",noc-open()); record_set(owner,"diagnostic_sequence",0);
   ohs-restart(owner,generation);
  }
  def ohs-live(owner) = if ((Value) record_get(owner,"state") == "closed") then form_error("organ reader is closed") else owner;
  def ohs-clear-fields(owner,keys) = if nil?(keys) then 0 else { record_set(owner,keys[0],0); ohs-clear-fields(owner,keys[1:]); };
  def ohs-close-cache(owner) {
   let cache=record_get(owner,"checkpoint_context"); if value_kind(cache) == "record" then jvc-close(cache) else 0;
   record_set(owner,"checkpoint_context",nothing);
  }
  def ohs-close(owner) {
   ohs-close-cache(owner);
   ohs-clear-fields(owner,record_keys(owner)); record_set(owner,"state","closed"); 1;
  }
  // A stream owns one mutable reader across publisher generations. Releasing
  // these references lets obsolete working values reach the current collector;
  // already returned reports hold their own immutable event values. Reader
  // identity and diagnostic sequence outlive publisher generations.
  def ohs-restart(owner,generation) {
   ohs-live(owner);
   record_set(owner,"generation",generation); record_set(owner,"offset",0);
   record_set(owner,"pending",""); ohs-clear-current(owner);
   record_set(owner,"state","unobserved"); record_set(owner,"read_bytes",0);
   record_set(owner,"invalid_records",0); record_set(owner,"extent",0);
   owner;
  }
   def ohs-path(owner) = record_get(owner,"path");
   def ohs-chunk-bytes() = 65536;
   // The publisher's append-only generation remains the authority. A native
   // checkpoint keeps its reduced current state and unfinished record together.
   // Fields stay in the reclaimable view lane. The immutable byte snapshot and
   // its index need no primary node admission or fixed artifact-size ceiling.
   // Source anchors must still match. Rewriting earlier bytes is a publisher
   // generation change, just as it is for an already open append-only reader.
   def ohs-anchor(path,offset,tail) = read_file_slice(path,tail ? max2(0,offset - ohs-chunk-bytes()) : 0,min2(offset,ohs-chunk-bytes()));
   def ohs-checkpoint(owner,path) {
    ohs-publish-current(owner); let offset = record_get(owner,"offset");
    let head = ohs-anchor(ohs-path(owner),offset,0); let tail = ohs-anchor(ohs-path(owner),offset,1);
    if nothing?(head) || nothing?(tail) || file_size(ohs-path(owner)) < offset then nothing else {
     let rows = record_get(owner,"current");
     let stage = path + ".writing-" + host_pid().str();
     let header = jv-object([jv-s("schema","organ-health-checkpoint-v2"),jv-s("source",ohs-path(owner)),jv-s("generation",record_get(owner,"generation")),jv-n("offset",offset),jv-s("pending",record_get(owner,"pending")),jv-n("invalid_records",record_get(owner,"invalid_records")),jv-s("head",head),jv-s("tail",tail),jv-n("current_count",len(rows))]);
     let text = jvc-pack(cons(header,rows));
     let wrote = write_file(stage,text);
     wrote >= 0 && file_size(stage) == len(text) && fs-rename(stage,path) == 0 ? len(text) : { fs_remove(stage); nothing; };
    };
   }
   def ohs-open-cached(path,generation,checkpoint) {
    let owner = ohs-open(path,generation);
    file_size(checkpoint) > 0 ? ohs-restore(owner,checkpoint) : owner;
   }
   def ohs-restore(owner,path) {
    let cache = jvc-open(read_file(path));
    let restored = nothing?(cache) || nil?(cache[0]) ? 0 : try ohs-restore-index(owner,cache) catch 0;
    if !restored then {
     if !nothing?(cache) then jvc-close(cache[1]) else 0;
     ohs-restart(owner,record_get(owner,"generation"));
     ohs-diagnostic(owner,"checkpoint-admission","indexed observations bound to the current source",jv-string("checkpoint or source binding changed; renew from source"));
    } else 0;
    owner;
   }
   def ohs-restore-index(owner,cache) {
    let header = cache[0][0]; let rows = cache[0][1:];
    let offset = jv-value(jv-get(header,"offset")); let invalid = jv-value(jv-get(header,"invalid_records"));
    let shape = ohv-str(header,"schema") == "organ-health-checkpoint-v2" && jv-kind(jv-get(header,"pending")) == 3 && value_kind(invalid) == "int" && invalid >= 0 && jv-kind(jv-get(header,"head")) == 3 && jv-kind(jv-get(header,"tail")) == 3;
    let complete = jv-kind(jv-get(header,"current_count")) == 4 && jv-value(jv-get(header,"current_count")) == len(rows) && all?(ohv-valid,rows);
    let same = shape && complete && ohv-str(header,"source") == ohs-path(owner) && ohv-str(header,"generation") == record_get(owner,"generation") && value_kind(offset) == "int" && offset >= 0 && file_size(ohs-path(owner)) >= offset;
    if same && ohv-str(header,"head") == ohs-anchor(ohs-path(owner),offset,0) && ohv-str(header,"tail") == ohs-anchor(ohs-path(owner),offset,1) then {
     record_set(owner,"offset",offset); record_set(owner,"pending",ohv-str(header,"pending")); record_set(owner,"invalid_records",invalid);
     ohs-index-rows(owner,rows); ohs-publish-current(owner); record_set(owner,"state","checkpoint-restored");
     record_set(owner,"checkpoint_context",cache[1]);
     record_get(owner,"current_count") == len(rows);
    } else 0;
   }
  def ohs-smaller(a,b) = if (a <= b) then a else b;
  def ohs-identity(owner) {
   record_set(owner,"diagnostic_sequence",(record_get(owner,"diagnostic_sequence") + 1));
   (record_get(owner,"identity") + (":diagnostic:" + record_get(owner,"diagnostic_sequence").str()));
  }
  def ohs-correlation(row,owner) = ohv-correlation(ohs-identity(owner),row);
  def ohs-clear-current(owner) {
   ohs-close-cache(owner);
   record_set(owner,"current",[]); record_set(owner,"current_index",km-new(1));
   record_set(owner,"current_keys",[]); record_set(owner,"current_count",0);
   record_set(owner,"current_capacity",km-arity()); record_set(owner,"current_dirty",0); owner;
  }
  // The existing reducer owns observation and control meaning. Give it the
  // one matching prior observation; the exact-key map owns lookup and order.
  def ohs-current(owner,row) {
   let key = km-key-of-string(ohv-key(row));
   let prior = km-get(record_get(owner,"current_index"),key,jv-null());
   let rows = ohv-current-through([row],if ((Comparable) jv-kind(prior) == 8) then [] else [prior],ohs-correlation,owner);
   ohs-index-rows(owner,rows);
  }
  def ohs-index-rows(owner,rows) = if nil?(rows) then owner else { ohs-index-row(owner,rows[0]); ohs-index-rows(owner,rows[1:]); };
  def ohs-reindex(keys,old,index) = if nil?(keys) then index else ohs-reindex(keys[1:],old,km-put(index,keys[0],km-get(old,keys[0],jv-null())));
  def ohs-index-row(owner,row) {
   let key = km-key-of-string(ohv-key(row)); let index = record_get(owner,"current_index");
   let fresh = (!km-has?(index,key)); let count = record_get(owner,"current_count");
   let grow = (fresh && (count >= record_get(owner,"current_capacity")));
   let ready = if grow then ohs-reindex(record_get(owner,"current_keys"),index,km-for((count + 1))) else index;
   if grow then record_set(owner,"current_capacity",(record_get(owner,"current_capacity") * km-arity())) else 0;
   if fresh then { record_set(owner,"current_keys",cons(key,record_get(owner,"current_keys"))); record_set(owner,"current_count",(count + 1)); } else 0;
   record_set(owner,"current_index",km-put(ready,key,row));
   record_set(owner,"current_dirty",1);
  }
  def ohs-index-values(keys,index,rows) = if nil?(keys) then rows else ohs-index-values(keys[1:],index,cons(km-get(index,keys[0],jv-null()),rows));
  def ohs-publish-current(owner) {
   if record_get(owner,"current_dirty") then {
    record_set(owner,"current",ohs-index-values(record_get(owner,"current_keys"),record_get(owner,"current_index"),[]));
    record_set(owner,"current_dirty",0);
   } else owner;
  }
  def ohs-diagnostic(owner,aspect,expected,observed) {
   let row = ohv-reading-with-id(ohs-identity(owner),"organ-health-reader",ohs-path(owner),aspect,jv-string(expected),observed,jv-int(0),[ohv-need("complete-organ-evidence",ohv-reference(ohs-path(owner)))],["request-evidence","defer"],ohv-reference(ohs-path(owner)));
   ohs-current(owner,row);
   ohv-frame(row);
  }
  def ohs-poll(owner,budget) { ohs-update(owner,budget); ohs-report(owner); }
  // Consume once; the caller chooses the representation of its report.
  def ohs-update(owner,budget) {
   ohs-live(owner);
   if (budget <= 0) then form_error("organ reading needs a positive byte work budget") else ohs-poll-size(owner,budget,file_size(ohs-path(owner)));
   ohs-publish-current(owner);
  }
  def ohs-poll-size(owner,budget,size) {
   record_set(owner,"read_bytes",0);
   record_set(owner,"extent",size);
   if (size < 0) then ohs-unavailable(owner,"absent-or-unreadable") else if (size < record_get(owner,"offset")) then ohs-reset(owner,budget,size) else ohs-read(owner,budget,size);
  }
  def ohs-unavailable(owner,state) {
   record_set(owner,"state",state);
   owner;
  }
  def ohs-reset(owner,budget,size) {
   record_set(owner,"offset",0); record_set(owner,"pending",""); ohs-clear-current(owner);
   ohs-diagnostic(owner,"source-reset","append-only source generation",jv-int(size));
   ohs-read(owner,budget,size);
  }
  def ohs-read(owner,budget,extent) {
   let offset = record_get(owner,"offset");
    if (offset >= extent) then ohs-settled(owner,"caught-up") else if (budget <= 0) then ohs-settled(owner,"backlog") else ohs-chunk(owner,budget,extent,read_file_slice(ohs-path(owner),offset,ohs-smaller(ohs-chunk-bytes(),ohs-smaller(budget,(extent - offset)))));
  }
  def ohs-chunk(owner,budget,extent,chunk) {
   if (nothing?(chunk) || ((Comparable) len(chunk) == 0)) then ohs-unavailable(owner,"read-refused") else ohs-chunk-read(owner,budget,extent,chunk);
  }
  def ohs-chunk-read(owner,budget,extent,chunk) {
   let text = ((String) record_get(owner,"pending") + chunk);
   let parts = reverse(split-on(text,"\n"));
   record_set(owner,"offset",(record_get(owner,"offset") + len(chunk)));
   record_set(owner,"read_bytes",(record_get(owner,"read_bytes") + len(chunk)));
   record_set(owner,"pending",parts[0]);
   ohs-lines(owner,reverse(parts[1:]));
   ohs-read(owner,(budget - len(chunk)),extent);
  }
  def ohs-lines(owner,lines) = if nil?(lines) then 0 else { ohs-line(owner,lines[0]); ohs-lines(owner,lines[1:]); };
  def ohs-line(owner,line) {
   if ((String) trim(line) == "") then 0 else if (!jwa-valid(line)) then ohs-invalid(owner,"complete JSON record",jv-int(len(line))) else ohs-row(owner,jvp-admitted(line));
  }
  def ohs-invalid(owner,expected,observed) {
   record_set(owner,"invalid_records",(record_get(owner,"invalid_records") + 1));
   ohs-diagnostic(owner,"event-admission",expected,observed);
  }
  def ohs-row(owner,record) {
    let row = ohv-extract(record);
    if ((Comparable) jv-kind(row) == 8) then 0 else if (!ohv-valid(row)) then ohs-invalid(owner,"complete organ observation",jv-null()) else ohs-current(owner,row);
  }
  def ohs-settled(owner,state) {
   record_set(owner,"state",if (((String) state == "caught-up") && (len(record_get(owner,"pending")) > 0)) then "awaiting-complete-record" else state);
   owner;
  }
  def ohs-view(owner) = jv-object([jv-s("source",ohs-path(owner)),jv-s("generation",record_get(owner,"generation")),jv-s("state",record_get(owner,"state")),jv-n("offset",record_get(owner,"offset")),jv-n("extent",record_get(owner,"extent")),jv-n("read_bytes",record_get(owner,"read_bytes")),jv-n("pending_bytes",len(record_get(owner,"pending"))),jv-n("invalid_records",record_get(owner,"invalid_records")),jv-pair("current",jv-array(ohv-age(record_get(owner,"current"),now_unix_ms())))]);
  def ohs-report(owner) = jv-materialize(ohs-view(owner));
 }
 0;
}
