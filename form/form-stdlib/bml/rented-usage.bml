// Complete Codex cumulative samples. Reasoning is included in output;
// cached input is included in input. The projection owns no primary nodes.
import form-stdlib/bml/json-view-parse.bml;
import form-stdlib/line-grammar.fk;
section [form.bml] {
 class RentedUsage {
  def ru-keys() = ["input_tokens","cached_input_tokens","output_tokens","reasoning_output_tokens","total_tokens"];
  def ru-zero() = ru-keys() |> map(key => 0);
  def ru-valid(values) = len(values) == len(ru-keys()) && all?(n => value_kind(n) == "int" && n >= 0,values) && values[1] <= values[0] && values[3] <= values[2] && values[4] == values[0] + values[2];
  def ru-values(view) = ru-keys() |> map(key => jv-has(view,key) && jv-kind(jv-get(view,key)) == 4 ? jv-str(view,key) : nothing);
  def ru-object(values) = jv-object(0 .. len(ru-keys()) |> map(i => jv-n(ru-keys()[i],values[i])));
  def ru-sample(row) {
   let payload=jv-get(row,"payload"); let usage=jv-get(jv-get(payload,"info"),"total_token_usage");
   let values=ru-values(usage); let stamp=jv-get(row,"timestamp");
   jv-str(row,"type") == "event_msg" && jv-str(payload,"type") == "token_count" && jv-kind(stamp) == 3 && len(jv-value(stamp)) > 0 && ru-valid(values) ? [jv-value(stamp),values] : nothing;
  }
  def ru-line(line) = jwa-valid(line) ? ru-sample(jvp-admitted(line)) : nothing;
  def ru-time-before(a,b,i) = i >= len(a) ? i < len(b) : i >= len(b) ? 0 : str_byte_at(a,i) == str_byte_at(b,i) ? ru-time-before(a,b,i + 1) : str_byte_at(a,i) < str_byte_at(b,i);
  def ru-window() = 2097152;
  def ru-codex?(path) {
   let text=read_file_slice(path,0,min2(file_size(path),65536));
   nothing?(text) ? 0 : { let end=str_find(text,"\n",0); end < 0 ? 0 : { let line=substring(text,0,end); jwa-valid(line) && jv-str(jvp-admitted(line),"type") == "session_meta"; }; };
  }
  def ru-read(path) {
   let size=file_size(path); let start=max2(0,size - ru-window());
   let text=size > 0 ? read_file_slice(path,start,size - start) : nothing;
   nothing?(text) || len(text) != size - start ? nothing : {
    let lines=split-on(text,"\n"); let complete=take(len(lines) - 1,lines);
    let rows=(start > 0 ? complete[1:] : complete) |> filter(line => str_find(line,"\"total_token_usage\"",0) >= 0);
    nil?(rows) ? nothing : ru-line(rows[-1]);
   };
  }
  def ru-delta(before,after) = !ru-valid(before) || !ru-valid(after) || any?(i => after[i] < before[i],0 .. len(before)) ? nothing : {
   let delta=0 .. len(before) |> map(i => after[i] - before[i]);
   ru-valid(delta) ? delta : nothing;
  };
  def ru-add(a,b) = 0 .. len(a) |> map(i => a[i] + b[i]);
 }
}
