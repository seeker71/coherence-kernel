// host-walk-record.bml — the retry's rows in .hearth/walk-retry.jsonl, the baseline they give the next retry, and the lens line.
//
// One retry writes two rows with one retry_id: an INTENT row before any child begins (phase "intent": the slot, the class and
// why, the evidence paths, the launchd line and its `runs`, the plan) and an OUTCOME row at the end (phase "outcome": what
// was changed, each attempt with its outcome word and what it saw, the outcome). A crash inside the door, a kill of the retry
// job itself or of a long child leaves the intent row, and the lens reads it as "in progress or interrupted: no outcome row".
// Each row carries launchctl's `runs` (omitted when it did not read): the last row of a job is the baseline the next retry
// compares launchctl's `last exit reason` against, so a reason left from an earlier run is not read as this slot's.
// What it needs: host-walk-text.bml, host-walk-began.bml (hw-clock-text, hw-gap-day), host-walk-evidence.bml (the launchd
// line), host-walk-class.bml (the class row) and host-walk-retry.bml (the plan, the slot's text).
import form-stdlib/bml/host-walk-text.bml;
import form-stdlib/bml/host-walk-began.bml;
import form-stdlib/bml/host-walk-evidence.bml;
import form-stdlib/bml/host-walk-class.bml;
import form-stdlib/bml/host-walk-retry.bml;
import form-stdlib/bml/host-child.bml;
section [form.bml] {
 class HostWalkRecord {
  def hr-attempt-node(a) = json-node-object([fhn-s("how", a[0]), fhn-n("nap_ms", a[1]), fhn-s("outcome", a[2]), fhn-s("saw", a[3])]);
  // launchctl's `runs` at this retry, the baseline of the next one (omitted when it did not read)
  def hr-runs-fields(launchd) {
   let runs = parse-int(hr-launchd-runs(launchd));
   nothing?(runs) ? [] : [fhn-n("launchd_runs", runs)];
  }
  // one retry writes two rows with one retry_id: an intent row before any child begins, an outcome row at the end
  def hr-row(id, at, phase, slot, c, launchd, kept, seen, outcome) = json-node-object(append([fhn-n("retry_id", id), fhn-s("phase", phase), fhn-n("at_unix_ms", at), fhn-s("door", slot[0]), fhn-s("label", slot[1]), fhn-s("slot", hr-hhmm-text(slot)), fhn-s("class", hr-class(c)), fhn-s("why", hr-why(c)), json-node-pair("evidence", json-node-array(map(p => json-node-string(p), append(hr-paths(c), kept)))), fhn-s("launchd", hr-launchd-line(launchd)), fhn-s("changed", hr-changed(hr-class(c))), json-node-pair("attempts", json-node-array(map(a => hr-attempt-node(a), seen))), fhn-s("outcome", outcome)], hr-runs-fields(launchd)));
  def hr-intent-text(class) = nil?(hr-plan(class)) ? "intent: nothing to heal" : "intent: " ++ hch-join(map(s => s[0], hr-plan(class)), ", ");
  // the last retry row of a job: its launchctl runs, the baseline the next retry compares its exit reason against
  def hr-baseline(text, label) = hw-field(hr-last-of(filter(l => hw-has?(l, "\"label\":\"" ++ label ++ "\"") && hw-has?(l, "\"launchd_runs\":"), split-on(text ?? "", "\n"))), "\"launchd_runs\":");
  def hr-record-path() = ".hearth/walk-retry.jsonl";
  def hr-record(path, row) = fhn-append(path, json-emit(row) ++ "\n");
  def hr-last-row-text(path) = hr-last-of(filter(l => (Comparable) len(l) > 0, split-on(read_file(path) ?? "", "\n")));
  def hr-last-of(rows) = nil?(rows) ? "" : rows[len(rows) - 1];
  // the latest row across the record files read (the walk checkout's, and this checkout's when it is another)
  def hr-row-at(text) = hw-field(text, "\"at_unix_ms\":") ?? 0;
  def hr-latest-row(paths) = foldl((best, p) => hr-row-at(hr-last-row-text(p)) > hr-row-at(best) ? hr-last-row-text(p) : best, "", paths);
  def hr-word-of(outcome) = substring(outcome, 0, str_find(outcome, ":", 0) < 0 ? len(outcome) : str_find(outcome, ":", 0));
  def hr-last-how(attempts) = nil?(attempts) ? "" : hw-row-str(attempts[len(attempts) - 1], "how");
  def hr-lens-of(row, now, zone) = hr-lens-says(row, now, zone, json-array-elements(hw-row-node(row, "attempts")));
  def hr-lens-says(row, now, zone, attempts) = "walk retry " ++ hw-clock-text(zone, hw-row-int(row, "at_unix_ms")) ++ " " ++ hw-gap-day(zone, now, hw-row-int(row, "at_unix_ms")) ++ ": " ++ hw-row-str(row, "class") ++ " -> " ++ ((String) hw-row-str(row, "phase") == "intent" ? "in progress or interrupted: no outcome row" : nil?(attempts) ? "nothing to heal" : hr-last-how(attempts) ++ ": " ++ hr-word-of(hw-row-str(row, "outcome")));
  // a record that does not read is no line, never a stop
  def hr-lens-line(text, now, zone) = (String) text == "" ? "" : try hr-lens-of(parse-json("walk-retry", text), now, zone) else "";
 }
}
