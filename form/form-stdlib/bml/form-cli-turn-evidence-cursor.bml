//////////////////////////////////////////////////////////////////////
//
// form-cli-turn-evidence-cursor.bml — scannerless, cursor-owned discovery
// for a completed local evidence row.
//
// The rollout stays private.  This cell moves only byte coordinates, task
// identifiers, and the existing collector's typed status; prompt and answer
// text never leave the reader.  It carries its own durable cursor so a live
// Form turnwheel can re-enter one bounded slice without a shell loop or an
// unbounded evaluator stack.
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-turn-evidence-live.fk

section [form.bml] {
    class FormCliTurnEvidenceCursor {
        field Rule = "scannerless-backward-cursor-yields-a-durable-next-slice";
        field PrivacyRule = "only-coordinates-turn-id-and-status-leave-the-reader";
        field NoTargetRule = "empty-target-selects-the-nearest-completed-turn-without-emitting-its-content";
        field ProgressPrefix = "turn-evidence-refresh=progress";
        field CollectorRule = "typed-prefix-selects-rows-output-span-stays-coordinate-owned";
        field StaleExpiryRule = "latestness-disproved-expires-current-row-before-next-cursor-step";
        field OneMovementRule = "one-invocation-owns-one-bounded-evidence-movement";
        field PhaseResumeRule = "physically-valid-progress-or-start-resumes-before-any-terminal-rediscovery";
        field ValidationRangeRule = "each-persisted-append-snapshot-resumes-to-its-checked-floor-before-growth-rolls-forward";
        field ProcessingBytes = 2097152;
        field AttentionMs = 5000;
        field LatestTag = "form-cli-turn-evidence-latest-v1";
        field ValidationLegacyTag = "turn-evidence-latest-validation-v1";
        field ValidationTag = "turn-evidence-latest-validation-v2";

        def fctec-rule() = Rule();
        def fctec-privacy-rule() = PrivacyRule();
        def fctec-no-target-rule() = NoTargetRule();
        def fctec-progress-prefix() = ProgressPrefix();
        def fctec-collector-rule() = CollectorRule();
        def fctec-stale-expiry-rule() = StaleExpiryRule();
        def fctec-one-movement-rule() = OneMovementRule();
        def fctec-phase-resume-rule() = PhaseResumeRule();
        def fctec-validation-range-rule() = ValidationRangeRule();
        def fctec-processing-bytes() = ProcessingBytes();
        def fctec-attention-ms() = AttentionMs();
        def fctec-attention-state(elapsed) = if le(elapsed, fctec-attention-ms()) then "within" else "over";
        def fctec-invocation-action(valid, validating, staleExpired) = if eq(valid, 1) then "already-observed" else if eq(validating, 1) then "validating-latest" else if eq(staleExpired, 1) then "expired-stale-current-row" else "advance";
        def fctec-invocation-status(action) = str_concat("turn-evidence-refresh=", action);
        def fctec-progress?(status) = if ge(str_find(status, fctec-progress-prefix(), 0), 0) then 1 else 0;

        // result = found? absolute-event-offset window-end.  `found?=0` and
        // `offset=-1` are a whole answer, distinct from the numeric offset 0.
        def fctec-result(found, at, end) = list("form-cli-turn-evidence-cursor-v1", found, at, end);
        def fctec-found?(result) = nth(result, 1);
        def fctec-at(result) = nth(result, 2);
        def fctec-end(result) = nth(result, 3);
        def fctec-result?(result) = if nothing?(result) then 0 else if not(eq(len(result), 4)) then 0 else str_eq(nth(result, 0), "form-cli-turn-evidence-cursor-v1");

        // Latest-complete validation is a separate append-range cursor.  A
        // collector cursor may be targeting an older selected turn, so it can
        // never certify latestness for a cached percentage.
        def fctec-latest-result(status, next, found, size) = list(LatestTag(), status, next, found, size);
        def fctec-latest-status(result) = nth(result, 1);
        def fctec-latest-next(result) = nth(result, 2);
        def fctec-latest-found(result) = nth(result, 3);
        def fctec-latest-size(result) = nth(result, 4);
        def fctec-latest?(result) = eq(fctec-latest-status(result), 1);
        def fctec-latest-progress?(result) = eq(fctec-latest-status(result), 2);

        def fctec-expire-stale(rowPath, validationPath) {
            let validationCleared = write_file_text(validationPath, "");
            let rowCleared = write_file_text(rowPath, "");
            list("turn-evidence-stale-expiry-v1", validationCleared, rowCleared);
        }
        def fctec-expire-current-stale() = fctec-expire-stale(fctel-observed-row-path(), fctel-latest-validation-path());

        // status: 0 stale/error, 1 this frozen range is clear, 2 bounded
        // validation is in motion.  A terminal at or above `floor` is newer;
        // a terminal below it belongs to an already checked generation.
        def fctec-latest-range-step(path, floor, end, size) {
            let found = fctec-seek(path, "", end);
            if eq(fctec-found?(found), 1) then
                if ge(fctec-at(found), floor) then fctec-latest-result(0, fctec-end(found), fctec-at(found), size)
                else fctec-latest-result(1, floor, -1, size)
            else if le(fctec-end(found), floor) then fctec-latest-result(1, floor, -1, size)
            else fctec-latest-result(2, fctec-end(found), -1, size);
        }
        def fctec-latest-step(path, carrier_size, complete_at, end) {
            let size = file_size(path);
            if lt(size, carrier_size) then fctec-latest-result(0, 0, -1, size)
            else if eq(size, carrier_size) then fctec-latest-result(1, size, complete_at, size)
            else fctec-latest-range-step(path, carrier_size, end, size);
        }

        def fctec-read-validation() = if gt(file_size(fctel-latest-validation-path()), 0) then split-on(fctel-trim-end(read_file(fctel-latest-validation-path())), "|") else list();
        // v2 appends the checked floor without moving any v1 field.  A valid
        // v1 row migrates with floor=carrier, preserving its already consumed
        // cursor instead of restarting the private scan.
        def fctec-validation-shape?(parts) = if and(eq(len(parts), 10), str_eq(nth(parts, 0), ValidationTag())) then 1 else if and(eq(len(parts), 9), str_eq(nth(parts, 0), ValidationLegacyTag())) then 1 else 0;
        def fctec-validation-floor(parts, e) = if and(eq(len(parts), 10), str_eq(nth(parts, 0), ValidationTag())) then str_to_int(nth(parts, 9)) else fcte-carrier-size(e);
        def fctec-validation-snapshot(parts, e, size) = if eq(fctec-validation-matches?(parts, e, size), 1) then str_to_int(nth(parts, 5)) else size;
        def fctec-validation-row(e, path, snapshot, cursor, floor) = fctel-join(list(ValidationTag(), "|", fcte-thread-id(e), "|", fcte-turn-id(e), "|", int_to_str(fcte-carrier-size(e)), "|", int_to_str(fcte-complete-at(e)), "|", int_to_str(snapshot), "|", int_to_str(cursor), "|", fcte-model-provider(e), "|", fcte-model(e), "|", int_to_str(floor)));
        def fctec-validation-range-valid?(parts, e, size) {
            let carrier = fcte-carrier-size(e);
            let snapshot = str_to_int(nth(parts, 5));
            let cursor = str_to_int(nth(parts, 6));
            let floor = fctec-validation-floor(parts, e);
            if lt(floor, carrier) then 0 else if gt(floor, snapshot) then 0 else if gt(snapshot, size) then 0 else if le(cursor, floor) then 0 else if gt(cursor, snapshot) then 0 else 1;
        }
        def fctec-validation-matches?(parts, e, size) = if not(eq(fctec-validation-shape?(parts), 1)) then 0 else if not(str_eq(nth(parts, 1), fcte-thread-id(e))) then 0 else if not(str_eq(nth(parts, 2), fcte-turn-id(e))) then 0 else if not(eq(str_to_int(nth(parts, 3)), fcte-carrier-size(e))) then 0 else if not(eq(str_to_int(nth(parts, 4)), fcte-complete-at(e))) then 0 else if not(eq(fctec-validation-range-valid?(parts, e, size), 1)) then 0 else if not(str_eq(nth(parts, 7), fcte-model-provider(e))) then 0 else if not(str_eq(nth(parts, 8), fcte-model(e))) then 0 else 1;
        def fctec-validation-cursor(parts, e, size) = if eq(fctec-validation-matches?(parts, e, size), 1) then str_to_int(nth(parts, 6)) else size;
        def fctec-validation-keep(e, path, snapshot, floor, step) {
            let kept = write_file_text(fctel-latest-validation-path(), fctec-validation-row(e, path, snapshot, fctec-latest-next(step), floor));
            step;
        }
        def fctec-validation-clear(step) {
            let cleared = write_file_text(fctel-latest-validation-path(), "");
            step;
        }
        def fctec-validation-roll-forward(e, path, snapshot, current) {
            let rolled = write_file_text(fctel-latest-validation-path(), fctec-validation-row(e, path, current, current, snapshot));
            fctec-latest-result(2, current, -1, current);
        }
        def fctec-validation-finish-clear(e, path, snapshot, step) {
            let current = file_size(path);
            if lt(current, snapshot) then fctec-validation-clear(fctec-latest-result(0, 0, -1, current))
            else if gt(current, snapshot) then fctec-validation-roll-forward(e, path, snapshot, current)
            else fctec-validation-clear(step);
        }
        def fctec-validation-finish(e, path, snapshot, floor, step) {
            if eq(fctec-latest-progress?(step), 1) then fctec-validation-keep(e, path, snapshot, floor, step)
            else if eq(fctec-latest?(step), 0) then fctec-validation-clear(step)
            else fctec-validation-finish-clear(e, path, snapshot, step);
        }
        def fctec-validation-continue(e, path, snapshot, floor, cursor) = fctec-validation-finish(e, path, snapshot, floor, fctec-latest-range-step(path, floor, cursor, snapshot));
        def fctec-advance-latest(e, path) {
            let size = file_size(path);
            let prior = fctec-read-validation();
            let matched = fctec-validation-matches?(prior, e, size);
            let snapshot = fctec-validation-snapshot(prior, e, size);
            let cursor = fctec-validation-cursor(prior, e, size);
            let floor = if eq(matched, 1) then fctec-validation-floor(prior, e) else fcte-carrier-size(e);
            if lt(size, fcte-carrier-size(e)) then fctec-validation-finish(e, path, snapshot, floor, fctec-latest-result(0, 0, -1, size))
            else if eq(size, fcte-carrier-size(e)) then fctec-validation-finish(e, path, snapshot, floor, fctec-latest-result(1, size, fcte-complete-at(e), size))
            else fctec-validation-continue(e, path, snapshot, floor, cursor);
        }

        // One invocation reads one aligned bounded 2 MiB slice. A miss returns the
        // next durable byte cursor; it never recursively consumes the rollout.
        def fctec-seek(path, target, end) {
            let window = fctel-discovery-window(path, end);
            let base = nth(window, 0);
            let body = nth(window, 1);
            let start = nth(window, 2);
            let found = fctel-find-last-terminal-line(body, target, 0, -1);
            if ge(found, 0) then fctec-result(1, add(base, found), end) else fctec-result(0, -1, start);
        }

        def fctec-turn-id-at(path, at) = if lt(at, 0) then "" else fctel-json-payload-string(read_file_slice(path, at, 512), "turn_id");
        def fctec-codex-source-reconciled?(e, path) {
            let size = file_size(path);
            let meta = fctel-first-line(read_file_slice(path, 0, fctel-min(size, 1048576)));
            let start_prefix = read_file_slice(path, fcte-start-at(e), 4096);
            let complete_prefix = read_file_slice(path, fcte-complete-at(e), 4096);
            let c1 = and(eq(fcte-provenance-shape?(e), 1), ge(size, fcte-carrier-size(e)));
            let c2 = str_eq(fctec-turn-id-at(path, fcte-complete-at(e)), fcte-turn-id(e));
            let c3 = str_eq(fctel-session-meta-thread-id(meta), fcte-thread-id(e));
            let c4 = str_eq(fctel-session-meta-provider(meta), fcte-model-provider(e));
            let c5 = eq(fctel-line-event?(start_prefix, "task_started", fcte-turn-id(e)), 1);
            let c6 = eq(fctel-terminal-line?(complete_prefix, fcte-turn-id(e)), 1);
            let c7 = eq(fctel-timestamp-ms(start_prefix), fcte-started-ms(e));
            let c8 = eq(fctel-timestamp-ms(complete_prefix), fcte-ended-ms(e));
            if and(c1, and(c2, and(c3, and(c4, and(c5, and(c6, and(c7, c8))))))) then 1 else 0;
        }
        def fctec-start-cursor(path, size) = fctel-discovery-cursor(fctel-read-discovery(), path, size);
        def fctec-start-size(path, size) = fctel-discovery-size(fctel-read-discovery(), path, size);

        // Land the one discovered coordinate back into the existing collector
        // before asking it to parse the selected task.  The collector selects
        // typed rows from a bounded 2 MiB window; output size and @form receipt
        // are read from coordinates and a 512-byte tail. Validation and the
        // durable observed-row ABI remain unchanged.
        def fctec-refresh-no-complete() {
            write_file_text(fctel-discovery-path(), "");
            write_file_text(fctel-candidate-row-path(), "");
            "turn-evidence-refresh=withheld no-complete-turn";
        }
        def fctec-refresh-discovering(path, size, cursor) {
            let progressCleared = write_file_text(fctel-progress-path(), "");
            let startCleared = write_file_text(fctel-start-discovery-path(), "");
            write_file_text(fctel-candidate-row-path(), "");
            write_file_text(fctel-discovery-path(), fctel-discovery-row(path, size, cursor));
            str_concat("turn-evidence-refresh=discovering cursor=", str_concat(int_to_str(cursor), str_concat("/", int_to_str(size))));
        }
        def fctec-refresh-missing-turn() {
            write_file_text(fctel-candidate-row-path(), "");
            "turn-evidence-refresh=withheld missing-turn-id";
        }
        // Exactly one bounded collector slice per invocation.  `progress` is
        // not a failure: its on-disk cursor is the continuation owned by this
        // BML authority and can be scheduled as a later resident row.
        def fctec-refresh-selected(path, size, found, turn) {
            write_file_text(fctel-discovery-path(), "");
            fctel-refresh-coordinate-once(path, size, fctec-at(found), turn);
        }
        def fctec-refresh-found(path, size, found) {
            let turn = fctec-turn-id-at(path, fctec-at(found));
            if str_eq(turn, "") then fctec-refresh-missing-turn() else fctec-refresh-selected(path, size, found, turn);
        }
        def fctec-refresh-nonempty(path, size, target) {
            let snapshot = fctec-start-size(path, size);
            let found = fctec-seek(path, target, fctec-start-cursor(path, size));
            if eq(fctec-found?(found), 1) then fctec-refresh-found(path, snapshot, found) else if eq(fctec-end(found), 0) then fctec-refresh-no-complete() else fctec-refresh-discovering(path, snapshot, fctec-end(found));
        }

        // A selected turn already owns its terminal coordinate in the start
        // row, and a collecting turn owns all three coordinates in progress.
        // Re-searching the append tail for that same terminal made two phases
        // coexist and paid the same backward slices again.  These pure
        // predicates keep phase choice testable without touching the live
        // spool; their effectful doors clear the superseded discovery row
        // before continuing exactly one bounded movement.
        def fctec-phase-action(path, size, progress, start) =
            if eq(fctel-progress-active?(progress, start, path, size), 1) then "resume-progress"
            else if eq(fctel-start-discovery-active?(start, path, size), 1) then "resume-start"
            else "discover";
        def fctec-clear-discovery-candidate() {
            let discoveryCleared = write_file_text(fctel-discovery-path(), "");
            let candidateCleared = write_file_text(fctel-candidate-row-path(), "");
            1;
        }
        def fctec-resume-progress(path, progress) {
            let cleared = fctec-clear-discovery-candidate();
            fctel-collect-once(path, str_to_int(nth(progress, 1)),
                str_to_int(nth(progress, 4)), nth(progress, 2),
                str_to_int(nth(progress, 3)));
        }
        def fctec-resume-start(path, start) {
            let cleared = fctec-clear-discovery-candidate();
            fctel-refresh-coordinate-once(path, str_to_int(nth(start, 1)),
                str_to_int(nth(start, 3)), nth(start, 2));
        }
        def fctec-stale-selected-turn(progress, start) =
            if eq(len(start), 8) then nth(start, 2)
            else if eq(len(progress), 28) then nth(progress, 2)
            else "";
        def fctec-clear-stale-target(progress, start) {
            let staleTurn = fctec-stale-selected-turn(progress, start);
            let target = if gt(file_size(fctel-target-turn-path()), 0) then fctel-trim-end(read_file(fctel-target-turn-path())) else "";
            if and(not(str_eq(staleTurn, "")), str_eq(staleTurn, target)) then write_file_text(fctel-target-turn-path(), "") else 1;
        }
        def fctec-reset-stale-phase(progress, start) {
            let targetCleared = fctec-clear-stale-target(progress, start);
            let progressCleared = write_file_text(fctel-progress-path(), "");
            let startCleared = write_file_text(fctel-start-discovery-path(), "");
            1;
        }
        def fctec-refresh-discover(path, size, progress, start) {
            let reset = fctec-reset-stale-phase(progress, start);
            let target = if gt(file_size(fctel-target-turn-path()), 0) then fctel-trim-end(read_file(fctel-target-turn-path())) else "";
            fctec-refresh-nonempty(path, size, target);
        }
        def fctec-refresh(path) {
            let size = file_size(path);
            let progress = fctel-read-progress();
            let start = fctel-read-start-discovery();
            let action = fctec-phase-action(path, size, progress, start);
            if le(size, 0) then "turn-evidence-refresh=withheld"
            else if str_eq(action, "resume-progress") then fctec-resume-progress(path, progress)
            else if str_eq(action, "resume-start") then fctec-resume-start(path, start)
            else fctec-refresh-discover(path, size, progress, start);
        }

        def fctec-refresh-bound() {
            let path = fctel-bound-path();
            if str_eq(path, "") then "turn-evidence-refresh=withheld" else fctec-refresh(path);
        }
    }
    0;
}
