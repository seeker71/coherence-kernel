// qwen-last-block-wear.bml — a voice lane that names an adapter wears it: the pair the last block trained, on the block's ffn_down.
//
// Intent: the adapter the ladder exported (qwen-last-block-train.bml, qlbt-export: F32 safetensors blk.L.ffn_down.weight.lora_a [ff, r] and
// .lora_b [r, d] beside adapter_config.json) is read back by name and admitted into a worn context. The context is the opened one with
//   slot 1  the record's three handles appended, so q38-close frees and counts them with the rest;
//   slot 3  the adapted layer table (qlh-rr-table): the block's FFN activation goes through A and B, scaled, and lands on the residual
//           (the hook, q38-wear-recs in qwen35-dense-token-handle.fk), on the decode, the plan and the span prefill alike;
//   slot 11 the wear's identity, ["qwen-wear-v1", directory, sha256, scale, record, layer], read by q38-ctx-wear.
// Every forward of the q38 lane reads the context's layers and wears it by construction (the speculative blocks in qwen35-dense-spec.fk and qwen35-dense-dflash.fk dispatch their own records and
// carry no hook; a worn session opens plain, so none runs there), and a context opened with no wear has
// none of this: its stream is the one it always was. Because L is the block the head reads next, the pair reaches the head and nothing else:
// the block's own KV rows and every earlier layer's state are written before it, and stay the base model's.
// This door also holds the reading rules of an adapter directory, one definition the judge (qwen-last-block-judge.bml) and the lane share:
// qlbj-present-why (the file, then its config), qlbj-config / qlbj-config-why, qlbj-pair-why (the header against the block's geometry),
// qlbj-pair-bytes (A and B by the header's spans). Refused by name: any of those, a layer other than the one the head reads next, a pair
// with a word that is not finite, a table the record cannot hold.
// Inputs: an open Qwen context and [directory, scale or nothing (the config's)]. Effects: three device allocations, owned by the worn context.
// Stdin: none. Owner: form-stdlib/bml. No weight is written; the mapped GGUF is read as it was.
import form-stdlib/qwen-lora-head.fk;
import form-stdlib/json.fk;
import form-stdlib/sha256.fk;
import form-stdlib/hex.fk;
import form-stdlib/bml/json-wire-admission.bml;
import form-stdlib/bml/door-options.bml;
section [form.bml] {
 class QwenLastBlockWear {
  def qlbj-st(dir) = dir ++ "/adapters.safetensors";
  def qlbj-cfg(dir) = dir ++ "/adapter_config.json";
  // the block the head reads next: the only block whose output reaches output_norm directly (rung 3's L)
  def qlbj-last-block(geo) = geo[21] - 1;
  def qlbj-slot() = "ffn_down";
  // ── JSON read strictly: a document is nothing unless its text is one well-formed object; a field of another kind is nothing ──
  def qlbj-json(name, text) {
   let t = trim(text);
   len(t) == 0 ? nothing() : !jwa-valid(t) ? nothing() : (Comparable) str_byte_at(t, 0) != 123 ? nothing() : parse-json(name, t);
  }
  def qlbj-object?(n) = node_eq(node_category(n), JSON-OBJECT());
  def qlbj-array?(n) = node_eq(node_category(n), JSON-ARRAY());
  def qlbj-real?(n) = dop-int-node?(n) ? true : (Comparable) node_level(n) == 1 && ((Comparable) node_type(n) == 6 || (Comparable) node_type(n) == 7);
  def qlbj-node(doc, key) = nothing?(doc) ? nothing() : !qlbj-object?(doc) ? nothing() : json-object-has?(doc, key) ? json-object-get(doc, key) : nothing();
  def qlbj-int-of(n) = nothing?(n) ? nothing() : dop-int-node?(n) ? json-int-value(n) : nothing();
  def qlbj-real-of(n) = nothing?(n) ? nothing() : qlbj-real?(n) ? node_value(n) + 0.0 : nothing();
  def qlbj-str-of(n) = nothing?(n) ? nothing() : dop-str-node?(n) ? json-string-value(n) : nothing();
  def qlbj-all(xs) = any?(x => nothing?(x), xs) ? nothing() : xs;
  def qlbj-list-of(n, read) = nothing?(n) ? nothing() : !qlbj-array?(n) ? nothing() : qlbj-all(map(e => read(e), json-array-elements(n)));
  def qlbj-int(doc, key) = qlbj-int-of(qlbj-node(doc, key));
  def qlbj-real(doc, key) = qlbj-real-of(qlbj-node(doc, key));
  def qlbj-str(doc, key) = qlbj-str-of(qlbj-node(doc, key));
  def qlbj-ints(doc, key) = qlbj-list-of(qlbj-node(doc, key), e => qlbj-int-of(e));
  def qlbj-strs(doc, key) = qlbj-list-of(qlbj-node(doc, key), e => qlbj-str-of(e));
  def qlbj-pos?(x) = nothing?(x) ? false : x > 0;
  def qlbj-is?(x, v) = nothing?(x) ? false : (Comparable) x == v;
  def qlbj-some?(xs) = nothing?(xs) ? false : len(xs) > 0;
  def qlbj-one?(xs) = nothing?(xs) ? false : len(xs) == 1;
  def qlbj-only?(xs, s) = !qlbj-one?(xs) ? false : (String) xs[0] == s;
  def qlbj-nums(xs) = "[" ++ str-join-with(map(x => x.str(), xs), ", ") ++ "]";
  // ── the adapter directory: the file and its config first, before any geometry is known ──
  def qlbj-present-why(who, dir) = file_size(qlbj-st(dir)) < 0 ? who ++ " adapter " ++ qlbj-st(dir) ++ " is absent"
   : file_size(qlbj-cfg(dir)) < 0 ? who ++ " adapter config " ++ qlbj-cfg(dir) ++ " is absent" : "";
  // adapter_config.json as the judge reads it (each field nothing when it does not read in its kind)
  def qlbj-config(dir) = qlbj-config-of(qlbj-json("adapter-config", read_file(qlbj-cfg(dir)) ?? ""));
  def qlbj-config-of(doc) = record_new(0, "doc", doc, "model", qlbj-str(doc, "model"), "rank", qlbj-int(qlbj-node(doc, "lora_parameters"), "rank"), "scale", qlbj-real(qlbj-node(doc, "lora_parameters"), "scale"), "layers", qlbj-ints(doc, "layers"), "targets", qlbj-strs(doc, "targets"), "data", qlbj-str(doc, "data"), "rows", qlbj-ints(doc, "rows"), "cap", qlbj-int(doc, "ids_cap"), "mask", qlbj-int(doc, "mask_prompt"), "steps", qlbj-int(doc, "trained_native_steps"), "batch", qlbj-int(doc, "batch_size"), "mean0", qlbj-real(doc, "mean_loss_step0"), "mean20", qlbj-real(doc, "mean_loss_step20"), "rejected_rows", qlbj-ints(doc, "rejected_rows"));
  def qlbj-layer(c) = record_get(c, "layers")[0];
  // why a config does not stand for one pair on ffn_down, trained prompt-masked on named lines ("" when it does)
  def qlbj-config-why(who, dir, c) {
   let at = who ++ " adapter config " ++ qlbj-cfg(dir);
   nothing?(record_get(c, "doc")) ? at ++ " does not read as one JSON object"
   : nothing?(record_get(c, "model")) ? at ++ " names no model"
   : !qlbj-pos?(record_get(c, "rank")) ? at ++ ": lora_parameters.rank is not a positive integer"
   : nothing?(record_get(c, "scale")) ? at ++ ": lora_parameters.scale is not a number"
   : !qlbj-one?(record_get(c, "layers")) ? at ++ ": layers is not one block index"
   : !qlbj-only?(record_get(c, "targets"), qlbj-slot()) ? at ++ ": targets is not [\"" ++ qlbj-slot() ++ "\"], the one slot the judge carries"
   : nothing?(record_get(c, "data")) ? at ++ " names no training data"
   : !qlbj-some?(record_get(c, "rows")) ? at ++ ": rows names no trained line"
   : !qlbj-pos?(record_get(c, "cap")) ? at ++ ": ids_cap is not a positive integer"
   : !qlbj-is?(record_get(c, "mask"), 1) ? at ++ ": mask_prompt is not 1; the judge reads the prompt-masked loss the trainer descended"
   : "";
  }
  // ── the header against the block: one JSON object naming exactly the pair, F32, [ff, r] at 0 and [r, d] right after, whole ──
  // one tensor entry: [dtype, shape, begin, end], or nothing when it does not read
  def qlbj-tensor(h, name) = qlbj-tensor-of(qlbj-node(h, name));
  def qlbj-tensor-of(t) = nothing?(t) ? nothing() : !qlbj-object?(t) ? nothing() : qlbj-tensor-read(qlbj-str(t, "dtype"), qlbj-ints(t, "shape"), qlbj-ints(t, "data_offsets"));
  def qlbj-tensor-read(dt, shape, offs) = nothing?(dt) || nothing?(shape) || nothing?(offs) ? nothing() : len(offs) != 2 ? nothing() : [dt, shape, offs[0], offs[1]];
  def qlbj-names(h) = filter(k => !((String) k == "__metadata__"), json-object-keys(h));
  def qlbj-header(path) = qlbj-json("adapter-header", la-header(path));
  def qlbj-pair-why(who, dir, L, ff, r, d) = qlbj-header-why(who ++ " adapter " ++ qlbj-st(dir), qlbj-st(dir), qlbj-header(qlbj-st(dir)), qlh-rr-name(L, qlbj-slot(), "a"), qlh-rr-name(L, qlbj-slot(), "b"), ff, r, d);
  def qlbj-header-why(at, path, h, an, bn, ff, r, d) = nothing?(h) ? at ++ ": the safetensors header does not read as one JSON object"
   : (Comparable) la-whole?(path) != 1 ? at ++ ": header and tensor spans do not cover the file's " ++ file_size(path).str() ++ " bytes"
   : qlbj-tensors-why(at, h, an, bn, ff, r, d);
  def qlbj-tensors-why(at, h, an, bn, ff, r, d) {
   let a = qlbj-tensor(h, an);
   let b = qlbj-tensor(h, bn);
   let names = qlbj-names(h);
   nothing?(a) ? at ++ " carries no tensor " ++ an ++ " (it names " ++ str-join-with(names, ", ") ++ ")"
   : nothing?(b) ? at ++ " carries no tensor " ++ bn ++ " (it names " ++ str-join-with(names, ", ") ++ ")"
   : len(names) != 2 ? at ++ " carries " ++ len(names).str() ++ " tensors; the judge reads the one pair " ++ an ++ ", " ++ bn
   : len(qlbj-span-why(at, an, a, ff, r, 0)) > 0 ? qlbj-span-why(at, an, a, ff, r, 0)
   : qlbj-span-why(at, bn, b, r, d, ff * r * 4);
  }
  def qlbj-shape?(s, rows, cols) = len(s) != 2 ? false : (Comparable) s[0] == rows && (Comparable) s[1] == cols;
  def qlbj-span-why(at, name, t, rows, cols, begin) = !((String) t[0] == "F32") ? at ++ ": " ++ name ++ " is " ++ t[0] ++ "; the pair is F32"
   : !qlbj-shape?(t[1], rows, cols) ? at ++ ": " ++ name ++ " has shape " ++ qlbj-nums(t[1]) ++ "; the block's pair wants " ++ qlbj-nums([rows, cols])
   : (Comparable) t[2] != begin || (Comparable) t[3] != begin + rows * cols * 4 ? at ++ ": " ++ name ++ " spans [" ++ t[2].str() ++ ", " ++ t[3].str() ++ "); its place is [" ++ begin.str() ++ ", " ++ (begin + rows * cols * 4).str() ++ ")"
   : "";
  // A and B as the file holds them, by the header's spans: [a bytes, b bytes] ("" for a span that does not read whole)
  def qlbj-pair-bytes(dir, L) {
   let path = qlbj-st(dir);
   let h = qlbj-header(path);
   let off = 8 + la-header-len(path);
   [qlbj-span-bytes(path, off, qlbj-tensor(h, qlh-rr-name(L, qlbj-slot(), "a"))), qlbj-span-bytes(path, off, qlbj-tensor(h, qlh-rr-name(L, qlbj-slot(), "b")))];
  }
  def qlbj-span-bytes(path, off, t) = nothing?(t) ? "" : qlbj-whole(read_file_slice(path, off + t[2], t[3] - t[2]) ?? "", t[3] - t[2]);
  def qlbj-whole(s, n) = len(s) == n ? s : "";
  // ── the wear: why a directory does not stand on this context's geometry ("" when it does) ──
  def qlwe-why(dir, geo) = len(qlbj-present-why("worn", dir)) > 0 ? qlbj-present-why("worn", dir) : qlwe-config-stand(dir, qlbj-config(dir), geo);
  def qlwe-config-stand(dir, c, geo) = len(qlbj-config-why("worn", dir, c)) > 0 ? qlbj-config-why("worn", dir, c)
   : (Comparable) qlbj-layer(c) != qlbj-last-block(geo) ? "worn adapter config " ++ qlbj-cfg(dir) ++ ": layer " ++ qlbj-layer(c).str() ++ "; the lane wears the block the head reads next, " ++ qlbj-last-block(geo).str()
   : qlbj-pair-why("worn", dir, qlbj-layer(c), geo[10], record_get(c, "rank"), geo[0]);
  // the bytes the wear holds beside the context, for the memory lease: the pair as the file holds it, and u at the context's span
  def qlwe-own-bytes(wear, span) = nothing?(wear) ? 0 : qlwe-own-of(wear[0], qlbj-config(wear[0]), span);
   def qlwe-own-of(dir, c, span) = !qlbj-pos?(record_get(c, "rank")) ? 0 : sum(map(len,qlbj-pair-bytes(dir,qlbj-layer(c)))) + record_get(c, "rank") * span * 4;
  // the records by layer: this record on L, nothing elsewhere
  def qlwe-records(rec, L, nL) = map(l => (Comparable) l == L ? [rec] : [], range(0, nL));
  def qlwe-ctx(ctx, table, rec, info) = [ctx[0], append(ctx[1], [rec[3], rec[4], rec[5]]), ctx[2], table, ctx[4], ctx[5], ctx[6], ctx[7], ctx[8], ctx[9], ctx[10], info];
   // ["worn", context] or ["refused", why]. The native session supplies its
   // retained allocator and keeps partial allocations for its release boundary.
   def qlwe-open(ctx,wear) = qlwe-open-by(ctx,wear,metal_buf_alloc,qlwe-refuse);
   def qlwe-open-by(ctx, wear,allocate,refuse) = len(qlwe-why(wear[0], ctx[2])) > 0 ? ["refused", qlwe-why(wear[0], ctx[2])] : qlwe-open-read-by(ctx, wear[0], qlbj-config(wear[0]), wear[1],allocate,refuse);
   def qlwe-open-read(ctx,dir,c,scaleOver) = qlwe-open-read-by(ctx,dir,c,scaleOver,metal_buf_alloc,qlwe-refuse);
   def qlwe-open-read-by(ctx, dir, c, scaleOver,allocate,refuse) {
   let geo = ctx[2];
   let L = qlbj-layer(c);
   let r = record_get(c, "rank");
   let scale = nothing?(scaleOver) ? record_get(c, "scale") : scaleOver;
   let ab = qlbj-pair-bytes(dir, L);
    // Validate the exact supplied bytes before device allocation. This removes
    // a temporary GPU counter and its independent release from admission.
    !qlh-finite-bytes?(ab[0],0,geo[10]*r) || !qlh-finite-bytes?(ab[1],0,r*geo[0]) ? ["refused","worn adapter "+qlbj-st(dir)+" carries non-finite words"] : {
     let rec = qlh-rr-open-by(4, ab[0], ab[1], geo[10], r, geo[0], scale, q38-ctx-span(ctx),allocate);
     !qlh-rr-valid?(rec) ? refuse(rec,"worn adapter " ++ qlbj-st(dir) ++ ": the pair did not open on the device") : qlwe-admit-by(ctx,dir,L,scale,rec,0,refuse);
    };
  }
   def qlwe-admit(ctx,dir,L,scale,rec,bad) = qlwe-admit-by(ctx,dir,L,scale,rec,bad,qlwe-refuse);
   def qlwe-admit-by(ctx, dir, L, scale, rec, bad,refuse) = nothing?(bad) ? refuse(rec, "worn adapter " ++ qlbj-st(dir) ++ ": the device's finite count did not arrive")
    : bad > 0 ? refuse(rec, "worn adapter " ++ qlbj-st(dir) ++ " carries " ++ bad.str() ++ " words that are not finite")
    : qlwe-tabled-by(ctx, dir, L, scale, rec, qlh-rr-table(ctx[3], qlwe-records(rec, L, ctx[2][21]), ctx[2][22], q38-ctx-span(ctx)),refuse);
   def qlwe-tabled(ctx,dir,L,scale,rec,table) = qlwe-tabled-by(ctx,dir,L,scale,rec,table,qlwe-refuse);
   def qlwe-tabled-by(ctx, dir, L, scale, rec, table,refuse) = nothing?(table) ? refuse(rec, "worn adapter " ++ qlbj-st(dir) ++ ": the layer table refused the record (" ++ qlh-rr-refusal(qlwe-records(rec, L, ctx[2][21]), ctx[2][22], q38-ctx-span(ctx)) ++ ")")
   : ["worn", qlwe-ctx(ctx, table, rec, ["qwen-wear-v1", dir, hex-encode(sha256-stream-string(read_file(qlbj-st(dir)) ?? "")), scale, rec, L])];
  def qlwe-refuse(rec, why) {
   let settled = metal_sync();
   let freed = qlh-rr-close(rec);
   ["refused", why];
  }
  // a wear taken off a context the caller keeps open (a band reading one context bare and worn): the record's handles, given back
  def qlwe-take-off(worn) = nil?(q38-ctx-wear(worn)) ? 0 : qlh-rr-close(q38-ctx-wear(worn)[4]);
  // what a session reads of the wear it carries: the directory, or "" when it wears nothing
  def qlwe-dir-of(ctx) = nil?(q38-ctx-wear(ctx)) ? "" : q38-ctx-wear(ctx)[1];
  def qlwe-sha-of(ctx) = nil?(q38-ctx-wear(ctx)) ? "" : q38-ctx-wear(ctx)[2];
  def qlwe-scale-of(ctx) = nil?(q38-ctx-wear(ctx)) ? nothing() : q38-ctx-wear(ctx)[3];
 }
 0;
}
