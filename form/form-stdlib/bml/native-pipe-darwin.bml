// Darwin ARM64 owned pipe descriptors and poll arrays, emitted by Form in RAM.
// CLOEXEC belongs to every original endpoint. Only parent's endpoints become
// nonblocking; child stdio is duplicated by the existing argv spawn carrier.
// preludes: form-stdlib/bml/native-pty-darwin.bml form-stdlib/bml/formbin-codec.bml form-stdlib/organ-health.bml
section [form.bml] {
