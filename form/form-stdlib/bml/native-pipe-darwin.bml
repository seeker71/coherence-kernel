    list(npd-label("copy"),fa-add-x-imm(0,3,0),npd-label("copy-loop"),fa-cmp-x(3,0),npd-branch(0,"return"),fa-ldrb(8,2,0),fa-strb(8,1,0),fa-add-x-imm(1,1,1),fa-add-x-imm(2,2,1),fa-sub-x-imm(3,3,1),npd-branch(14,"copy-loop")),
    list(npd-label("syscall"),fa-movk-x-16(16,512),fa-svc(128),npd-branch(3,"return"),npd-label("negate"),fa-asm(3405774848,list(1,32,65536),list(0,31,0)),npd-label("return"),fa-ret())));
