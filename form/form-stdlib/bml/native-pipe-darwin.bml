  def npp-pump-admitted(owner,millis) {
   let entries = npp-wait-entries(owner,record_get(owner,"processes"),list());
   let status = if nil?(entries) then 0 else npp-poll(owner,entries,millis);
   if lt(status,0) then if eq(status,-4) then 0 else npp-refuse(owner,"process array poll") else npp-step-jobs(owner,record_get(owner,"processes"));
  }
  def npp-done(owner,job) = and(eq(record_get(job,"reaped"),1),and(not(npp-live-end(owner,record_get(job,"stdout-end"))),not(npp-live-end(owner,record_get(job,"stderr-end")))));
  def npp-close-job-ends(owner,job) = npp-close-ends(owner,list(record_get(job,"input"),record_get(job,"stdout-end"),record_get(job,"stderr-end")));
  def npp-settle(owner,jobs) {
   if nil?(jobs) then 1 else npp-settle-rest(owner,tail(jobs),npp-stop(owner,head(jobs)));
  }
  def npp-settle-rest(owner,jobs,first) {
   let rest = npp-settle(owner,jobs); and(first,rest);
  }
  def npp-stop(owner,job) {
   npp-close-end(owner,record_get(job,"input"));
   if eq(record_get(job,"reaped"),0) then npd-signal(record_get(owner,"memory"),record_get(job,"pid"),15) else 0;
   npp-stop-wait(owner,job,host_monotonic_ms(),0);
  }
  def npp-stop-wait(owner,job,start,killed) {
   npp-read-step(owner,job,"stdout"); npp-read-step(owner,job,"stderr"); let reaped = npp-reap(owner,job);
   if and(reaped,npp-done(owner,job)) then npp-stop-closed(owner,job) else if gt(sub(host_monotonic_ms(),start),3000) then 0 else npp-stop-continue(owner,job,start,killed);
  }
  def npp-stop-continue(owner,job,start,killed) {
   let next = if and(eq(record_get(job,"reaped"),0),and(eq(killed,0),gt(sub(host_monotonic_ms(),start),250))) then npd-signal(record_get(owner,"memory"),record_get(job,"pid"),9) else -1;
   let entries = npp-wait-entries(owner,list(job),list()); if nil?(entries) then 0 else npp-poll(owner,entries,5);
   npp-stop-wait(owner,job,start,if eq(next,0) then 1 else killed);
  }
  def npp-stop-closed(owner,job) {
   let closed = npp-close-job-ends(owner,job); record_set(job,"closed",closed); closed;
  }
  // Eight little-endian length bytes frame binary payloads without line limits.
  // Lengths are admitted in the actual positive tagged integer domain.
  def npp-frame(bytes) = if not(str_eq(value_kind(bytes),"string")) then nothing() else str_concat(npp-u32-text(str_len(bytes),8),bytes);
  def npp-frame-size(bytes) = if not(str_eq(value_kind(bytes),"string")) then -2 else if lt(str_len(bytes),8) then -1 else npp-frame-size-at(bytes,7,0);
  def npp-frame-size-at(bytes,at,total) {
   if lt(at,0) then total else npp-frame-size-byte(bytes,at,total,str-byte-at(bytes,at));
  }
  def npp-frame-size-byte(bytes,at,total,byte) {
   if gt(total,div(sub(4611686018427387903,byte),256)) then -2 else npp-frame-size-at(bytes,sub(at,1),add(mul(total,256),byte));
  }
  def npp-close-borrowed(owner) = npp-close-borrowed-rows(reverse(record_get(owner,"ends")));
  def npp-close-borrowed-rows(ends) {
   if nil?(ends) then 1 else npp-close-borrowed-rest(tail(ends),if and(eq(record_get(head(ends),"borrowed"),1),eq(record_get(head(ends),"active"),1)) then eq(npp-close-result(head(ends),file_close(record_get(head(ends),"fd"))),0) else 1);
  }
  def npp-close-borrowed-rest(rest,first) {
   let others = npp-close-borrowed-rows(rest); and(first,others);
  }
  def npp-health(owner,row) = if record_has(owner,"diagnostic-path") then npp-health-at(record_get(owner,"diagnostic-path"),row) else oh-voice(row);
  def npp-health-at(path,row) {
   let bytes = str_concat("form-organ health ",str_concat(json-emit-precise(row),"\n"));
   let written = sbt-append-count(path,bytes); oh-frame(row);
   // A refused diagnostic write cannot prevent resource settlement.
   and(not(nothing?(written)),eq(written,str_len(bytes)));
  }
  def npp-refuse(owner,aspect) {
   let flow = str_concat(int_to_str(owner),str_concat("-",int_to_str(record_get(owner,"calls"))));
   let row = oh-reading("native-pipe",flow,aspect,json-node-int(1),json-node-int(0),json-node-int(0),list(),list("release-owned-pipes","retain"),json-node-null());
   npp-health(owner,row); let response = oh-response(row,"release-owned-pipes"); npp-health(owner,response);
   let closed = npp-close(owner); npp-health(owner,oh-applied(row,oh-select(row,response,"retain"),json-node-int(closed)));
   npp-health(owner,oh-reading("native-pipe",flow,"owned-resource-release",json-node-int(1),json-node-int(closed),json-node-int(closed),list(),list("retain"),json-node-null()));
   let inherited = npp-close-borrowed(owner);
   form_error("native pipe refusal; owned cleanup observed");
  }
 }
 0;
}
