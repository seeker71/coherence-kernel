// A recycled stream returns to its captured token boundary while keeping
// lifetime counters and the current session's owned adapter.
// preludes: form-stdlib/form-cli-model-session.fk form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliPeerRecycle {
  def fcprc-floor(session,spare) = [spare,fcms-pos(session),fcms-pending(session),fcms-stopped?(session)];
  def fcprc-boundary(session) = [fcms-pos(session),fcms-pending(session),fcms-stopped?(session)];
  def fcprc-boundary-json(boundary) = json-node-array([json-node-int(boundary[0]),json-node-int(boundary[1]),json-node-int(boundary[2])]);
  def fcprc-restore-stream(session,floor) = fcms-with-stream(session,floor[1],floor[2],floor[3],fcms-generated-ids(session),fcms-injected-ids(session),fcms-observations(session));
  def fcprc-reading(session,floor) {
   let expected = [floor[1],floor[2],floor[3]];
   let actual = fcprc-boundary(session);
   let evidence = json-node-object([oh-n("position",fcms-pos(session)),oh-n("pending",fcms-pending(session)),oh-n("stopped",fcms-stopped?(session))]);
   let same = ((Value) expected == actual);
   oh-reading("hearth-resident",int_to_str(host_pid()),"recycled-stream-boundary",fcprc-boundary-json(expected),fcprc-boundary-json(actual),json-node-int(same),if same then [] else [oh-need("captured-stream-boundary",evidence)],["request-evidence"],evidence);
  }
 }
}
