// A recycled stream returns to its captured token boundary while keeping
// lifetime counters and the current session's owned adapter.
// preludes: form-stdlib/form-cli-model-session.fk form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliPeerRecycle {
  def fcprc-floor(session,spare) = list(spare,fcms-pos(session),fcms-pending(session),fcms-stopped?(session));
  def fcprc-boundary(session) = list(fcms-pos(session),fcms-pending(session),fcms-stopped?(session));
  def fcprc-boundary-json(boundary) = json-node-array(list(json-node-int(nth(boundary,0)),json-node-int(nth(boundary,1)),json-node-int(nth(boundary,2))));
  def fcprc-restore-stream(session,floor) = fcms-with-stream(session,nth(floor,1),nth(floor,2),nth(floor,3),fcms-generated-ids(session),fcms-injected-ids(session),fcms-observations(session));
  def fcprc-reading(session,floor) {
   let expected = list(nth(floor,1),nth(floor,2),nth(floor,3));
   let actual = fcprc-boundary(session);
   let evidence = json-node-object(list(oh-n("position",fcms-pos(session)),oh-n("pending",fcms-pending(session)),oh-n("stopped",fcms-stopped?(session))));
   let same = value_eq(expected,actual);
   oh-reading("hearth-resident",int_to_str(host_pid()),"recycled-stream-boundary",fcprc-boundary-json(expected),fcprc-boundary-json(actual),json-node-int(same),if same then list() else list(oh-need("captured-stream-boundary",evidence)),list("request-evidence"),evidence);
  }
 }
}
