// Complete JSON syntax admission with container continuations in Form data.
// The shared JSON lexer owns string escapes and numeric syntax. The stack
// here replaces recursive container descent; no fixed nesting cap is added.
// preludes: form-stdlib/bml/form-agent-json-query.bml
section [form.bml] {
 class JsonWireAdmission {
  def jwa-push(task, rest) = list(task, rest);
  def jwa-rest(tasks) = tasks[1];
  // task kinds: value, object key, array element, container delimiter.
  def jwa-valid(text) = jwa-loop(text, 0, jwa-push(list(0, 0), list()));
  def jwa-loop(s, at, tasks) {
   let p = fat-skip(s, at);
   nil?(tasks) ? ((Comparable) p == str_len(s))
   : p >= str_len(s) ? 0
   : jwa-task(s, p, head(tasks), jwa-rest(tasks));
  }
  def jwa-task(s, p, task, rest) {
   (Comparable) head(task) == 0 ? jwa-value(s, p, rest, fat-char(s, p))
   : (Comparable) head(task) == 1 ? jwa-object(s, p, rest, task[1])
   : (Comparable) head(task) == 2 ? (task[1] && ((Comparable) fat-char(s, p) == 93) ? jwa-loop(s, p + 1, rest) : jwa-loop(s, p, jwa-push(list(0, 0), jwa-push(list(3, 93), rest))))
   : (Comparable) fat-char(s, p) == task[1] ? jwa-loop(s, p + 1, rest)
   : (Comparable) fat-char(s, p) == 44 ? jwa-loop(s, p + 1, jwa-push(list((Comparable) task[1] == 125 ? 1 : 2, 0), rest))
   : 0;
  }
  def jwa-value(s, p, rest, c) {
   (Comparable) c == 123 ? jwa-loop(s, p + 1, jwa-push(list(1, 1), rest))
   : (Comparable) c == 91 ? jwa-loop(s, p + 1, jwa-push(list(2, 1), rest))
   : (Comparable) c == 34 ? jwa-after(s, faj-string(s, p + 1), rest)
   : ((Comparable) c == 45) || fat-digit(c) ? jwa-after(s, faj-number(s, p), rest)
   : (String) substring(s, p, p + 4) == "true" ? jwa-loop(s, p + 4, rest)
   : (String) substring(s, p, p + 5) == "false" ? jwa-loop(s, p + 5, rest)
   : (String) substring(s, p, p + 4) == "null" ? jwa-loop(s, p + 4, rest)
   : 0;
  }
  def jwa-after(s, end, rest) = end < 0 ? 0 : jwa-loop(s, end, rest);
  def jwa-object(s, p, rest, emptyAllowed) = emptyAllowed && ((Comparable) fat-char(s, p) == 125) ? jwa-loop(s, p + 1, rest) : (Comparable) fat-char(s, p) == 34 ? jwa-colon(s, faj-string(s, p + 1), rest) : 0;
  def jwa-colon(s, end, rest) = end < 0 ? 0 : (Comparable) fat-char(s, fat-skip(s, end)) == 58 ? jwa-loop(s, fat-skip(s, end) + 1, jwa-push(list(0, 0), jwa-push(list(3, 125), rest))) : 0;
 }
 0;
}
