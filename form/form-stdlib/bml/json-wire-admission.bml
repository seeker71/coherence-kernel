// Complete JSON syntax admission with container continuations in Form data.
// The shared JSON lexer owns string escapes and numeric syntax. The stack
// here replaces recursive container descent; no fixed nesting cap is added.
// preludes: form-stdlib/bml/form-agent-json-query.bml
section [form.bml] {
 class JsonWireAdmission {
  def jwa-push(task, rest) = list(task, rest);
  def jwa-rest(tasks) = nth(tasks, 1);
  // task kinds: value, object key, array element, container delimiter.
  def jwa-valid(text) = jwa-loop(text, 0, jwa-push(list(0, 0), list()));
  def jwa-loop(s, at, tasks) {
   let p = fat-skip(s, at);
   if nil?(tasks) then eq(p, str_len(s))
   else if ge(p, str_len(s)) then 0
   else jwa-task(s, p, head(tasks), jwa-rest(tasks));
  }
  def jwa-task(s, p, task, rest) {
   if eq(head(task), 0) then jwa-value(s, p, rest, fat-char(s, p))
   else if eq(head(task), 1) then jwa-object(s, p, rest, nth(task, 1))
   else if eq(head(task), 2) then if and(nth(task, 1), eq(fat-char(s, p), 93)) then jwa-loop(s, add(p, 1), rest) else jwa-loop(s, p, jwa-push(list(0, 0), jwa-push(list(3, 93), rest)))
   else if eq(fat-char(s, p), nth(task, 1)) then jwa-loop(s, add(p, 1), rest)
   else if eq(fat-char(s, p), 44) then jwa-loop(s, add(p, 1), jwa-push(list(if eq(nth(task, 1), 125) then 1 else 2, 0), rest))
   else 0;
  }
  def jwa-value(s, p, rest, c) {
   if eq(c, 123) then jwa-loop(s, add(p, 1), jwa-push(list(1, 1), rest))
   else if eq(c, 91) then jwa-loop(s, add(p, 1), jwa-push(list(2, 1), rest))
   else if eq(c, 34) then jwa-after(s, faj-string(s, add(p, 1)), rest)
   else if or(eq(c, 45), fat-digit(c)) then jwa-after(s, faj-number(s, p), rest)
   else if str_eq(substring(s, p, add(p, 4)), "true") then jwa-loop(s, add(p, 4), rest)
   else if str_eq(substring(s, p, add(p, 5)), "false") then jwa-loop(s, add(p, 5), rest)
   else if str_eq(substring(s, p, add(p, 4)), "null") then jwa-loop(s, add(p, 4), rest)
   else 0;
  }
  def jwa-after(s, end, rest) = if lt(end, 0) then 0 else jwa-loop(s, end, rest);
  def jwa-object(s, p, rest, emptyAllowed) = if and(emptyAllowed, eq(fat-char(s, p), 125)) then jwa-loop(s, add(p, 1), rest) else if eq(fat-char(s, p), 34) then jwa-colon(s, faj-string(s, add(p, 1)), rest) else 0;
  def jwa-colon(s, end, rest) = if lt(end, 0) then 0 else if eq(fat-char(s, fat-skip(s, end)), 58) then jwa-loop(s, add(fat-skip(s, end), 1), jwa-push(list(0, 0), jwa-push(list(3, 125), rest))) else 0;
 }
 0;
}
