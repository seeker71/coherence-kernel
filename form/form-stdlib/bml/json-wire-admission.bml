// Complete JSON syntax admission with container continuations in Form data.
// The shared JSON lexer owns string escapes and numeric syntax. The stack
// here replaces recursive container descent; no fixed nesting cap is added.
// preludes: form-stdlib/bml/form-agent-json-query.bml
section [form.bml] {
 class JsonWireAdmission {
  def jwa-push(task, rest) = [task, rest];
  def jwa-rest(tasks) = tasks[1];
  // task kinds: value, object key, array element, container delimiter.
  def jwa-valid(text) = jwa-loop(text, 0, jwa-push([0, 0], []));
  def jwa-loop(s, at, tasks) {
   let p = fat-skip(s, at);
   if nil?(tasks) then ((Comparable) p == str_len(s))
   else if (p >= str_len(s)) then 0
   else jwa-task(s, p, head(tasks), jwa-rest(tasks));
  }
  def jwa-task(s, p, task, rest) {
   if ((Comparable) head(task) == 0) then jwa-value(s, p, rest, fat-char(s, p))
   else if ((Comparable) head(task) == 1) then jwa-object(s, p, rest, task[1])
   else if ((Comparable) head(task) == 2) then if (task[1] && ((Comparable) fat-char(s, p) == 93)) then jwa-loop(s, (p + 1), rest) else jwa-loop(s, p, jwa-push([0, 0], jwa-push([3, 93], rest)))
   else if ((Comparable) fat-char(s, p) == task[1]) then jwa-loop(s, (p + 1), rest)
   else if ((Comparable) fat-char(s, p) == 44) then jwa-loop(s, (p + 1), jwa-push([if ((Comparable) task[1] == 125) then 1 else 2, 0], rest))
   else 0;
  }
  def jwa-value(s, p, rest, c) {
   if ((Comparable) c == 123) then jwa-loop(s, (p + 1), jwa-push([1, 1], rest))
   else if ((Comparable) c == 91) then jwa-loop(s, (p + 1), jwa-push([2, 1], rest))
   else if ((Comparable) c == 34) then jwa-after(s, faj-string(s, (p + 1)), rest)
   else if (((Comparable) c == 45) || fat-digit(c)) then jwa-after(s, faj-number(s, p), rest)
   else if ((String) substring(s, p, (p + 4)) == "true") then jwa-loop(s, (p + 4), rest)
   else if ((String) substring(s, p, (p + 5)) == "false") then jwa-loop(s, (p + 5), rest)
   else if ((String) substring(s, p, (p + 4)) == "null") then jwa-loop(s, (p + 4), rest)
   else 0;
  }
  def jwa-after(s, end, rest) = if (end < 0) then 0 else jwa-loop(s, end, rest);
  def jwa-object(s, p, rest, emptyAllowed) = if (emptyAllowed && ((Comparable) fat-char(s, p) == 125)) then jwa-loop(s, (p + 1), rest) else if ((Comparable) fat-char(s, p) == 34) then jwa-colon(s, faj-string(s, (p + 1)), rest) else 0;
  def jwa-colon(s, end, rest) = if (end < 0) then 0 else if ((Comparable) fat-char(s, fat-skip(s, end)) == 58) then jwa-loop(s, (fat-skip(s, end) + 1), jwa-push([0, 0], jwa-push([3, 125], rest))) else 0;
 }
 0;
}
