// Native literal normalization under caller-owned boolean result types.
// The original checker must recheck every proposed report; no decision is inferred.
// preludes: form-stdlib/bml/form-cli-code-policy.bml form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliBooleanReport {
  def fcbr-literal(value) = if (!((String) faj-type(value) == "string")) then [0,value] else {
   let text = node_value(value);
   if fat-has(["true","yes"],text) then [1,intern_trivial_bool(true)] else if fat-has(["false","no"],text) then [1,intern_trivial_bool(false)] else [0,value];
  };
  def fcbr-key(row) {
   let args = fcap-array(row,"arguments");
   let expected = fcap-string(row,"stdout");
   if (!(((String) fcap-string(row,"tool") == "jq") && (((Comparable) len(args) == 1) && faj-valid(expected)))) then "" else if (!((String) faj-type(faj-json("result-type",expected)) == "boolean")) then "" else {
    let compiled = faj-compile(head(args));
    let ast = head(compiled);
    if (!(((String) compiled[1] == "") && ((String) head(ast) == "path"))) then "" else {
     let parts = ast[1];
     if (!(((Comparable) len(parts) == 1) && ((String) head(head(parts)) == "key"))) then "" else head(parts)[1];
    };
   };
  }
  def fcbr-unique(pairs,seen) = if nil?(pairs) then 1 else if fat-has(seen,json-pair-key(head(pairs))) then 0 else fcbr-unique(tail(pairs),cons(json-pair-key(head(pairs)),seen));
  def fcbr-rows(rows,report,changed) = if nil?(rows) then [report,reverse(changed)] else {
   let key = fcbr-key(head(rows));
   let value = json-object-get(report,key);
   let normalized = if ((String) key == "") then [0,value] else fcbr-literal(value);
   if (!head(normalized)) then fcbr-rows(tail(rows),report,changed) else fcbr-rows(tail(rows),oh-set(report,key,normalized[1]),cons(key,changed));
  };
  def fcbr-propose(checks,text) {
   let report = if faj-valid(text) then parse-json("boolean-report",text) else json-node-null();
   if (!(fat-wire-object?(report) && fcbr-unique(node_children(report),[]))) then [0,text,"native-boolean-literals","report is not an unambiguous JSON object"] else {
    let proposed = fcbr-rows(checks,report,[]);
    let changed = proposed[1];
    let evidence = json-node-object([json-node-pair("scope",json-node-string("Exact yes/no/true/false string literals in fields whose caller check expects a JSON boolean. Expected truth values are not used. All original checks still apply.")),json-node-pair("changed_fields",json-node-array(fcap-string-json(changed)))]);
    [if nil?(changed) then 0 else 1,if nil?(changed) then text else json-emit(head(proposed)),"native-boolean-literals",json-emit(evidence)];
   };
  }
  def fcbr-repair(checks,subject) = fcbr-propose(checks,subject[1]);
 }
 0;
}
