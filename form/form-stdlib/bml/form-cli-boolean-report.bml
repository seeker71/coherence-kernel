// Native literal normalization under caller-owned boolean result types.
// The original checker must recheck every proposed report; no decision is inferred.
// preludes: form-stdlib/bml/form-cli-code-policy.bml form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliBooleanReport {
  def fcbr-literal(value) = !((String) faj-type(value) == "string") ? list(0,value) : {
   let text = node_value(value);
   fat-has(list("true","yes"),text) ? list(1,intern_trivial_bool(true)) : fat-has(list("false","no"),text) ? list(1,intern_trivial_bool(false)) : list(0,value);
  };
  def fcbr-key(row) {
   let args = fcap-array(row,"arguments");
   let expected = fcap-string(row,"stdout");
   !(((String) fcap-string(row,"tool") == "jq") && (((Comparable) len(args) == 1) && faj-valid(expected))) ? "" : !((String) faj-type(faj-json("result-type",expected)) == "boolean") ? "" : {
    let compiled = faj-compile(head(args));
    let ast = head(compiled);
    !(((String) compiled[1] == "") && ((String) head(ast) == "path")) ? "" : {
     let parts = ast[1];
     !(((Comparable) len(parts) == 1) && ((String) head(head(parts)) == "key")) ? "" : head(parts)[1];
    };
   };
  }
  def fcbr-unique(pairs,seen) = nil?(pairs) ? 1 : fat-has(seen,json-pair-key(head(pairs))) ? 0 : fcbr-unique(tail(pairs),cons(json-pair-key(head(pairs)),seen));
  def fcbr-rows(rows,report,changed) = nil?(rows) ? list(report,reverse(changed)) : {
   let key = fcbr-key(head(rows));
   let value = json-object-get(report,key);
   let normalized = (String) key == "" ? list(0,value) : fcbr-literal(value);
   !head(normalized) ? fcbr-rows(tail(rows),report,changed) : fcbr-rows(tail(rows),oh-set(report,key,normalized[1]),cons(key,changed));
  };
  def fcbr-propose(checks,text) {
   let report = faj-valid(text) ? parse-json("boolean-report",text) : json-node-null();
   !(fat-wire-object?(report) && fcbr-unique(node_children(report),list())) ? list(0,text,"native-boolean-literals","report is not an unambiguous JSON object") : {
    let proposed = fcbr-rows(checks,report,list());
    let changed = proposed[1];
    let evidence = json-node-object(list(json-node-pair("scope",json-node-string("Exact yes/no/true/false string literals in fields whose caller check expects a JSON boolean. Expected truth values are not used. All original checks still apply.")),json-node-pair("changed_fields",json-node-array(fcap-string-json(changed)))));
    list(nil?(changed) ? 0 : 1,nil?(changed) ? text : json-emit(head(proposed)),"native-boolean-literals",json-emit(evidence));
   };
  }
  def fcbr-repair(checks,subject) = fcbr-propose(checks,subject[1]);
 }
 0;
}
