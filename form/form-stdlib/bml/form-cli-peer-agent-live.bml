//////////////////////////////////////////////////////////////////////
// form-cli-peer-agent-live.bml -- high-grammar owner of the long-lived
// local peer. The historical .fk path is only the one-line entry door.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-peer-native-dispatch.bml form-stdlib/bml/form-cli-peer-live-framebuffer.bml

section [form.bml] {
    class FormCliPeerAgentLive {
        field LifetimeRule = "one-local-model-and-kv-residence-serves-many-lines-until-release";
        field NativeRule = "caller-owned-bml-program-loads-before-model-open-and-runs-before-model-observation";
        field EntryRule = "stdin-is-the-live-carrier-not-an-http-or-host-exec-boundary";
        field ResidentBmlPath = "form/form-stdlib/bml/form-cli-peer-agent-live.bml";
        field BirthRule = "cache-source-context-native-program-and-prefill-are-separate-observable-stages";

        def fcpal-lifetime-rule() = LifetimeRule();
        def fcpal-native-rule() = NativeRule();
        def fcpal-entry-rule() = EntryRule();
        def fcpal-resident-bml-path() = ResidentBmlPath();
        def fcpal-resident-cache-path() = str_concat(fcpal-resident-bml-path(), ".fkb");
        def fcpal-birth-rule() = BirthRule();
        def fcpal-resident-cache-state() {
            let source = file_mtime(fcpal-resident-bml-path());
            let cache = file_mtime(fcpal-resident-cache-path());
            if lt(source, 0) then "missing" else if lt(cache, 0) then "cold" else if ge(cache, source) then "ready" else "stale";
        }
        // snapshot = cache-state source-context-ms native-program-ms setup-ms.
        // Each numeric zero is an observed duration, never the no-snapshot
        // value `nothing`.
        def fcpal-birth-snapshot(cache, sourceContextMs, nativeProgramMs, setupMs) = list("form-cli-peer-birth-v1", cache, sourceContextMs, nativeProgramMs, setupMs);
        def fcpal-birth-snapshot?(snapshot) = if nothing?(snapshot) then 0 else if not(eq(len(snapshot), 5)) then 0 else str_eq(nth(snapshot, 0), "form-cli-peer-birth-v1");
        def fcpal-birth-cache(snapshot) = nth(snapshot, 1);
        def fcpal-birth-source-context-ms(snapshot) = nth(snapshot, 2);
        def fcpal-birth-native-program-ms(snapshot) = nth(snapshot, 3);
        def fcpal-birth-setup-ms(snapshot) = nth(snapshot, 4);
        def fcpal-line(name, value) = print_str(str_concat("form-peer ", str_concat(name, str_concat("=", str_concat(value, "\n")))));
        def fcpal-int(name, value) = fcpal-line(name, int_to_str(value));
        def fcpal-birth-report(snapshot) {
            fcpal-line("program-image-cache", fcpal-birth-cache(snapshot));
            fcpal-int("source-context-ms", fcpal-birth-source-context-ms(snapshot));
            fcpal-int("native-program-ms", fcpal-birth-native-program-ms(snapshot));
            fcpal-int("resident-setup-ms", fcpal-birth-setup-ms(snapshot));
            0;
        }

        def fcpal-report(turn, result) {
            fcpal-int("turn", turn);
            fcpal-line("signal", fcpa-signal(fcpa-session(result)));
            fcpal-int("elapsed-ms", fcpa-elapsed-ms(result));
            fcpal-int("contribution", fcpa-contribution(result));
            fcpal-line("route", fcpa-route(result));
            fcpal-int("callback-calls", fcpa-callback-calls(result));
            fcpal-line("tool-status", fcpa-tool-status(result));
            fcpal-int("value-present", fcpa-value-present?(result));
            fcpal-int("value", fcpa-value(result));
            fcpal-line("response-begin", "");
            print_str(fcpa-response(result));
            print_str("\n");
            fcpal-line("response-end", "");
            fcpal-line("ready", "1");
            0;
        }

        def fcpal-release(session, accepted) {
            let released = fcms-release-ok?(session);
            let releaseFrame = fcplf-record(0, "release", int_to_str(released));
            fcpal-int("accepted-contributions", accepted);
            fcpal-int("release-ok", released);
            released;
        }
        def fcpal-handle(session, source_ctx, native_program, turn, accepted, line) {
            let task_frame = fcplf-record(turn, "task-begin", "ready");
            let result = fcpn-run-task(session, source_ctx, native_program, turn, line);
            let terminal_frame = fcplf-record(turn, "task-terminal", fcpa-signal(fcpa-session(result)));
            fcpal-report(turn, result);
            fcpal-loop(fcpa-session(result), source_ctx, native_program, add(turn, 1), add(accepted, fcpa-contribution(result)));
        }
        def fcpal-loop(session, source_ctx, native_program, turn, accepted) {
            let line = read_line();
            if or(nothing?(line), or(str_eq(line, "release"), str_eq(line, "quit"))) then fcpal-release(session, accepted) else fcpal-handle(session, source_ctx, native_program, turn, accepted, line);
        }

        def fcpal-opened(path) = if or(nothing?(path), str_eq(path, "")) then fcms-none("model-path-absent") else fcms-open-resident-agent(path, fcpa-bootstrap());
        def fcpal-unavailable(opened) {
            fcpal-line("signal", fcpa-signal(opened));
            fcpal-line("reason", fcms-reason(opened));
            fcpal-int("release-ok", fcms-release-ok?(opened));
            0;
        }
        def fcpal-live(opened, source_ctx, native_program, started) {
            let boot = fcms-generate(opened, 24);
            let resident = fcms-generation-session(boot);
            let prefill_frame = fcplf-record(0, "prefill-ready", "ready");
            fcpal-int("admit-prefill-ms", sub(now_unix_ms(), started));
            fcpal-line("bootstrap", fcms-generation-text(boot));
            fcpal-line("ready", "1");
            fcpal-loop(resident, source_ctx, native_program, 1, 0);
        }
        def fcpal-run() {
            let path = read_line();
            let setupStarted = now_unix_ms();
            let cacheFrame = fcplf-record(0, "resident-cache", fcpal-resident-cache-state());
            let sourceContextStarted = now_unix_ms();
            let source_ctx = fcpalsa-live-source-context();
            let sourceContextMs = sub(now_unix_ms(), sourceContextStarted);
            let sourceContextFrame = fcplf-record(0, "source-context-ready", int_to_str(sourceContextMs));
            let nativeProgramStarted = now_unix_ms();
            let native_program = fcrnp-load(frpce-empty());
            let nativeProgramMs = sub(now_unix_ms(), nativeProgramStarted);
            let nativeProgramFrame = fcplf-record(0, "native-program-ready", int_to_str(nativeProgramMs));
            let birth = fcpal-birth-snapshot(fcpal-resident-cache-state(), sourceContextMs, nativeProgramMs, sub(now_unix_ms(), setupStarted));
            let birthFrame = fcplf-record(0, "resident-setup", fcpal-birth-cache(birth));
            let reported = fcpal-birth-report(birth);
            let started = now_unix_ms();
            let opened = fcpal-opened(path);
            if not(eq(fcms-live?(opened), 1)) then fcpal-unavailable(opened) else fcpal-live(opened, source_ctx, native_program, started);
        }
    }
    0;
}
