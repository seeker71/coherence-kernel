// Native counter accounting; logical occupancy is not allocator residence.
// These widths describe tracked columns, not RSS or all process allocations.
// preludes: form/form-stdlib/core.fk
section [form.bml] {
    class GlassMemoryAccounting {
        // nkind/ncat/nkids/nval/nid/source[4]/hash = ten native words.
        field CellColumnBytes = 80;
        field BlueprintColumnBytes = 8;
        // fn/ar/symbol[2]/index/heat/fbox/unbox/native/mint = 10 words.
        field RecipeColumnBytes = 80;
        field ConsColumnBytes = 16;
        def fgma-cell-bytes(count) = mul(count, CellColumnBytes());
        def fgma-blueprint-bytes(count) = mul(count, BlueprintColumnBytes());
        def fgma-recipe-bytes(count) = mul(count, RecipeColumnBytes());
        def fgma-cons-bytes(count) = mul(count, ConsColumnBytes());
        def fgma-snapshot() = list(kernel_stat(4), kernel_stat(43), kernel_stat(6), kernel_stat(19), kernel_stat(21));
    }
    0;
}
