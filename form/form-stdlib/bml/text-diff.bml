// text-diff.bml — the changed region between two texts, read in Form.
//
// td-diff(old, new, context, cap) answers one hunk: the common head and tail are kept aside, the lines between
// them are the change. The hunk opens with "@@ -<line>,<old count> +<line>,<new count> @@", carries up to
// `context` unchanged lines on each side (" "), the removed lines ("-") and the added lines ("+"), at most
// td-side-cap() of each, and is cut to `cap` bytes. Two equal texts answer "". A lane's candidate usually changes
// one region; a candidate that changes several reads as one hunk spanning them, which still shows every change.
// preludes: form-stdlib/line-grammar.fk form-stdlib/meaning-codes.bml
section [form.bml] {
 class TextDiff {
  def td-side-cap() = 80;
  def td-min(x, y) = if (x < y) then x else y;
  def td-max(x, y) = if (x > y) then x else y;
  def td-prefix(a, b, i, na, nb) = if ((i >= na) || (i >= nb)) then i else if ((String) nth(a, i) == nth(b, i)) then td-prefix(a, b, (i + 1), na, nb) else i;
  def td-suffix(a, b, s, na, nb, p) = if (((p + s) >= na) || ((p + s) >= nb)) then s else if ((String) nth(a, ((na - 1) - s)) == nth(b, ((nb - 1) - s))) then td-suffix(a, b, (s + 1), na, nb, p) else s;
  def td-mark(xs, i, j, mark) = if (i >= j) then "" else mc-cat(list(mark, nth(xs, i), "\n", td-mark(xs, (i + 1), j, mark)));
  def td-cut(text, cap) = if (str_len(text) <= cap) then text else substring(text, 0, cap);
  def td-hunk(a, b, na, nb, p, s, context) {
   let oldEnd = (na - s);
   let newEnd = (nb - s);
   let lead = td-max(0, (p - context));
   let trail = td-min(na, (oldEnd + context));
   let header = mc-cat(list("@@ -", int_to_str((p + 1)), ",", int_to_str((oldEnd - p)), " +", int_to_str((p + 1)), ",", int_to_str((newEnd - p)), " @@\n"));
   mc-cat(list(header, td-mark(a, lead, p, " "), td-mark(a, p, td-min(oldEnd, (p + td-side-cap())), "-"), td-mark(b, p, td-min(newEnd, (p + td-side-cap())), "+"), td-mark(a, oldEnd, trail, " ")));
  }
  def td-diff(old, new, context, cap) {
   let a = split-on(old, "\n");
   let b = split-on(new, "\n");
   let na = len(a);
   let nb = len(b);
   let p = td-prefix(a, b, 0, na, nb);
   let s = td-suffix(a, b, 0, na, nb, p);
   if (((Comparable) p == na) && ((Comparable) p == nb)) then "" else td-cut(td-hunk(a, b, na, nb, p, s, context), cap);
  }
 }
}
