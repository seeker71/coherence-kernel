package Form.cli.ingestexec;

import Form.kernel.*;
import Form.cli.flow.*;

enum NativeKind [public] {
   CELLS,
   DEPTH,
   ENTER
}

interface IIngestExec [public, witness, reusable] {
   section [public] {
      const int SameCells = 1;
      const int DiffCells = 2;
      const int DeepYes = 1;
      const int DeepNo = 0;
      const int NamedOnly = 0;
      const int Lesson = 1;
      const int Claim = 2;
      const String CollapsePath = "ingest/equivalence-collapse.fk";
      const String DepthPath = "ingest/knowledge-ingest.fk";
      const String NboPath = "ingest/name-build-observe.fk";

      int Same() [abstract];
      int Diff() [abstract];
      int Deep() [abstract];
      int Shallow() [abstract];
      String Observe( String strPath ) [abstract];
   }
}

template ExecHit<TPath> [public, reusable] {
   section [public] {
      TPath Path() [get];
      int Value() [get];
      String Observe() [get];
   }
}

class FormIngestExec [public, reusable, teach] : IIngestExec {
   section [public] {
      const String TrustRule = "run the ingest cells; observation is the native return";
      const String ExecutablePath = "form/form-stdlib/form-cli-ingest-exec.bml";

      int Same() [abstract] {}
      int Diff() [abstract] {}
      int Deep() [abstract] {}
      int Shallow() [abstract] {}
      String Observe( String strPath ) [abstract] {}
   }
}

class FormIngestExecSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-ingest-exec-self";
      const String Pattern = "native-return ec-cells2 ki-deep nbo-enter no-qwen";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
