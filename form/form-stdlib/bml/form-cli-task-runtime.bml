// form-cli-task-runtime.bml — the runtime a task rides: one sentence in, a finished task out.
//
// Eight organs, each a reading the live doors call:
//   fctrt-intake            a sentence becomes a contract: the paths it names, the band whose prelude names one
//                           of them, or, among bands that only share a barrel, the larger verdict, and the model
//   fctrt-act               a lane reason becomes [class, spend, next, end]. spend 0 and end 1 tried nothing
//                           (fctrt-untried?): the seat, a memory refusal, a memory return. model-idle spends
//                           nothing and names voice, so the same walk continues on the next local model with the
//                           finding and the documents. A red band spends the attempt and stays in repair.
//   fctrt-claim / commit    one writer holds the session. A second writer cannot claim, and cannot commit a tool
//                           result. The file door is fctrt-claim-file / fctrt-commit-file.
//   fctrt-neighbor-paths    the bands whose prelude names a changed file, or a barrel that imports it. Publish
//                           waits until each of those reads its own verdict (fctrt-holds).
//   fctrt-hollowed          a neighbour band whose code the candidate moved holds when main's text under the candidate's
//                           source and the candidate's text under main's source read the same claims short; both lanes
//                           read it through fctrt-cross-under (in the window) and fctrt-cross-reasons (on main)
//   the voice row of fctrt-act("local-stall") is how the next model receives the same task
//   fctrt-clock             tokens are progress. A seat or a memory ending is a seat. No tokens past the local
//                           idle bound is a stall. A short silence is idle.
// What it needs: the host's files (fs_list, read_file, file_size, fs_mkdir, write_file_text) for the tree and the
// writer door. The readings above are pure over the texts and rows a caller hands in.
// preludes: form-stdlib/line-grammar.fk form-stdlib/bml/parse.bml
section [form.bml] {
 class FormCliTaskRuntime {
  def fctrt-idle-ms() = 300000;
  def fctrt-starts?(s, p) = ((String) value_kind(s) == "string") && ((Comparable) len(s) >= len(p)) && ((String) substring(s, 0, len(p)) == p);
  def fctrt-ends?(s, p) = ((String) value_kind(s) == "string") && ((Comparable) len(s) >= len(p)) && ((String) substring(s, len(s) - len(p), len(s)) == p);
  def fctrt-n(v) = nothing?(v) ? 0 : v;
  def fctrt-body-path(path) = fctrt-starts?(path, "form/") ? substring(path, 5, len(path)) : path;

  // ── intake ──
  def fctrt-path?(token) = (str_find(token, "/", 0) >= 0) && (fctrt-ends?(token, ".bml") || fctrt-ends?(token, ".fk") || fctrt-ends?(token, ".md") || fctrt-ends?(token, ".form"));
  def fctrt-trim-token(s) = fctrt-trim-end(fctrt-trim-start(s));
  def fctrt-trim-start(s) = (fctrt-starts?(s, "\"") || fctrt-starts?(s, "'") || fctrt-starts?(s, "(") || fctrt-starts?(s, ",")) ? fctrt-trim-start(substring(s, 1, len(s))) : s;
  def fctrt-trim-end(s) = (len(s) > 0 && (fctrt-ends?(s, "\"") || fctrt-ends?(s, "'") || fctrt-ends?(s, ")") || fctrt-ends?(s, ",") || fctrt-ends?(s, ".") || fctrt-ends?(s, ";"))) ? fctrt-trim-end(substring(s, 0, len(s) - 1)) : s;
  def fctrt-paths(sentence) = filter(t => fctrt-path?(t), map(t => fctrt-trim-token(t), split-on(sentence ?? "", " ")));
  def fctrt-prelude(text) {
   let source=text ?? "";let marker=str_find(source,"preludes:",0);let newline=str_byte_at("\n",0);
   marker<0 ? "" : {
    let start=foldl((begin,index)=>str_byte_at(source,index)==newline ? index+1 : begin,0,0 .. marker);
    let end=str_find(source,"\n",marker);
    substring(source,start,end<0 ? len(source) : end);
   };
  }
  def fctrt-band?(path) = str_find(path, "/tests/", 0) >= 0 || fctrt-starts?(path, "tests/");
  def fctrt-imports?(text, path) = str_find(text, "import " ++ fctrt-body-path(path), 0) >= 0;
  def fctrt-any?(paths, f) = nil?(paths) ? 0 : (f(paths[0]) ? 1 : fctrt-any?(paths[1:], f));
  def fctrt-barrel?(entry, changed) = (!fctrt-band?(entry[0])) && (fctrt-any?(changed, p => fctrt-imports?(entry[1], p)) == 1);
  def fctrt-barrels(entries, changed) = filter(e => fctrt-barrel?(e, changed), entries);
  def fctrt-mentions?(text, path) = ((String) path != "") && (str_find(text, fctrt-body-path(path), 0) >= 0);
  def fctrt-mentions-any?(text, paths) = fctrt-any?(paths, p => fctrt-mentions?(text, p)) == 1;
  def fctrt-neighbor?(entry, changed, barrels, primary) = fctrt-band?(entry[0]) && ((String) entry[0] != primary) && (fctrt-mentions-any?(fctrt-prelude(entry[1]), changed) || fctrt-mentions-any?(fctrt-prelude(entry[1]), map(b => b[0], barrels)));
  def fctrt-neighbor-paths(entries, changed, primary) {
   let barrels=fctrt-barrels(entries,changed);
   map(e=>e[0],filter(e=>fctrt-neighbor?(e,changed,barrels,primary),entries));
  }
  def fctrt-owned(paths,primary) = foldl((owned,path)=>any?(p=>p==path,owned) ? owned : owned+[path],paths,fctrt-neighbor-paths(fctrt-read-tree(),paths,primary));
  def fctrt-verdict-at(text, at) = at < 0 ? 0 : fctrt-verdict-digits(text, at + 10, "");
  def fctrt-verdict-digits(text, i, out) = (i >= len(text) || !(((Comparable) str_byte_at(text, i) >= 48) && ((Comparable) str_byte_at(text, i) <= 57))) ? (out == "" ? 0 : parse-int(out)) : fctrt-verdict-digits(text, i + 1, out ++ substring(text, i, i + 1));
  def fctrt-verdict(text) = fctrt-verdict-at(text, str_find(text ?? "", "; Verdict ", 0));
  def fctrt-band-score(entry, changed, barrelPaths) = fctrt-mentions-any?(fctrt-prelude(entry[1]), changed) ? 2 : (fctrt-mentions-any?(fctrt-prelude(entry[1]), barrelPaths) ? 1 : 0);
  def fctrt-band-row(entry, changed, barrelPaths) = [fctrt-band-score(entry, changed, barrelPaths), fctrt-verdict(entry[1]), entry[0]];
  def fctrt-prefer?(a, b) = ((Comparable) a[0] > b[0]) || (((Comparable) a[0] == b[0]) && ((Comparable) a[1] > b[1]));
  def fctrt-best-row(rows, best) = nil?(rows) ? best : (fctrt-prefer?(rows[0], best) ? fctrt-best-row(rows[1:], rows[0]) : fctrt-best-row(rows[1:], best));
  def fctrt-chosen(rows) {
   let best = fctrt-best-row(rows[1:], rows[0]);
   [best[2], best[1]];
  }
  def fctrt-band-for(entries, changed) {
   let barrelPaths = map(b => b[0], fctrt-barrels(entries, changed));
   let rows = filter(r => (Comparable) r[0] > 0, map(e => fctrt-band-row(e, changed, barrelPaths), filter(e => fctrt-band?(e[0]), entries)));
   nil?(rows) ? ["", 0] : fctrt-chosen(rows);
  }
  // [goal, writable paths, band, full, model, next]. next is run, needs-files, or needs-band.
  def fctrt-intake(sentence, entries, model) {
   let paths = fctrt-paths(sentence);
   let band = nil?(paths) ? ["", 0] : fctrt-band-for(entries, paths);
   let next = nil?(paths) ? "needs-files" : ((String) band[0] == "" || (Comparable) band[1] == 0) ? "needs-band" : "run";
   [sentence ?? "", paths, band[0], band[1], model ?? "", next];
  }
  def fctrt-source?(name) = fctrt-ends?(name, ".bml") || fctrt-ends?(name, ".fk");
  def fctrt-read-dir(dir) = map(name => {
   let path=dir+"/"+name;let source=read_file(path);
   let observed=fb_record([path,nothing?(source) ? nothing() : len(source)],"native-source-read",0);
   [path,source];
  },filter(name=>fctrt-source?(name),fs_list(dir) ?? []));
  def fctrt-read-tree() = append(fctrt-read-dir("form/form-stdlib/tests"), fctrt-read-dir("form/form-stdlib/bml"));

  // ── failure table ──
  // [class, spend, next, end]
  def fctrt-act(reason) {
   let r = (String) value_kind(reason) == "string" ? reason : "";
   fctrt-starts?(r, "model-queued:") ? ["seat-busy", 0, "wait", 1] :
   ((String) r == "host-memory-low") ? ["memory-low", 0, "resume", 1] :
   fctrt-starts?(r, "host-memory-held:") ? ["admission-refused", 0, "wait", 1] :
   fctrt-starts?(r, "native-context-renewal-") ? ["context-overflow", 1, "stop", 1] :
   (fctrt-starts?(r, "prompt-context-window-refused") || fctrt-starts?(r, "prompt-caller-capacity-refused")) ? ["context-overflow", 0, "compress", 0] :
   fctrt-starts?(r, "local-stall") ? ["model-idle", 0, "voice", 0] :
   fctrt-starts?(r, "truncated") ? ["truncated-tool", 0, "recover", 0] :
   fctrt-starts?(r, "malformed") ? ["malformed-action", 0, "repair", 0] :
   fctrt-starts?(r, "edit-miss") ? ["edit-miss", 0, "repair", 0] :
   ["red-band", 1, "repair", 0];
  }
  def fctrt-untried?(reason) = (fctrt-act(reason)[1] == 0) && (fctrt-act(reason)[3] == 1);

  // ── one writer ──
  def fctrt-note(session, writer, tool, n) = [session, writer, tool, n];
  def fctrt-blank() = ["", "", "", 0];
  def fctrt-claim(note, writer) = ((String) note[1] == "" || (String) note[1] == writer) ? [1, fctrt-note(note[0], writer, note[2], note[3])] : [0, note];
  def fctrt-commit(note, writer, tool) = (String) note[1] != writer ? [0, note] : [1, fctrt-note(note[0], writer, tool, note[3] + 1)];
  def fctrt-note-text(note) = note[0] ++ "\n" ++ note[1] ++ "\n" ++ note[2] ++ "\n" ++ note[3].str() ++ "\n";
  def fctrt-note-read(text) {
   let lines = split-on(text ?? "", "\n");
   (Comparable) len(lines) < 4 ? fctrt-blank() : fctrt-note(lines[0], lines[1], lines[2], parse-int(lines[3]) ?? 0);
  }
  def fctrt-writer-path(root, session) = root ++ "/" ++ session ++ "/writer.txt";
  def fctrt-claim-file(root, session, writer) {
   let dir = root ++ "/" ++ session;
   let made = fs_mkdir(dir);
   let path = fctrt-writer-path(root, session);
   let claimed = fctrt-claim(fctrt-note-read(read_file(path) ?? ""), writer);
   claimed[0] == 1 ? [1, write_file_text(path, fctrt-note-text(fctrt-note(session, writer, claimed[1][2], claimed[1][3])))] : [0, claimed[1]];
  }
  def fctrt-commit-file(root, session, writer, tool) {
   let path = fctrt-writer-path(root, session);
   let committed = fctrt-commit(fctrt-note-read(read_file(path) ?? ""), writer, tool);
   committed[0] == 1 ? [1, write_file_text(path, fctrt-note-text(fctrt-note(session, writer, tool, committed[1][3])))] : [0, committed[1]];
  }

  // ── acceptance ──
  def fctrt-held?(row) = (!nothing?(row[0])) && ((Comparable) row[0] == row[1]);
  def fctrt-holds(rows) = nil?(rows) ? 1 : (fctrt-held?(rows[0]) ? fctrt-holds(rows[1:]) : 0);

  // ── a neighbour band the candidate moved ──
  // The rule. For an owned band whose code the candidate moved, a is main's text read under the candidate's source and c
  // the candidate's text read under main's source. An alignment the change owes misses the same claims both ways, and
  // is owed only where main's text reads short of its verdict under the candidate: it holds when c == a < verdict. A
  // stub or a claim true under any source reads more under main than main's text reads under the candidate, or moves a
  // band the change left whole (neighbor-hollowed); a text that needs a name only the candidate defines reads nothing
  // under main (neighbor-unread). "" holds; a reason names the path and both readings.
  def fctrt-word(v) = nothing?(v) ? "nothing" : v.str();
  def fctrt-hollowed(path, verdict, a, c) = nothing?(c) ? "neighbor-unread: " ++ path ++ " A " ++ fctrt-word(a) ++ " C nothing"
   : (nothing?(a) || !((Comparable) a == c) || (Comparable) a >= verdict) ? "neighbor-hollowed: " ++ path ++ " A " ++ fctrt-word(a) ++ " C " ++ c.str() ++ " verdict " ++ verdict.str() : "";
  // A text's code: its bytes with whitespace runs and comments (// to the line's end, a ; that begins its line) read as
  // one space, its strings whole. An edit to a band's prose moves none of its code, and pays no reading.
  def fctrt-code(text) = str-join(reverse(fctrt-code-go(text ?? "", 0, 0, [])));
  def fctrt-code-go(t, s, i, out) = i >= len(t) ? cons(substring(t, s, i), out) : fctrt-code-at(t, s, i, out, str_byte_at(t, i));
  def fctrt-code-at(t, s, i, out, b) = b == 34 ? fctrt-code-go(t, s, fctrt-str-end(t, i + 1), out)
   : fctrt-trivia?(t, i, b) ? fctrt-code-past(t, s, i, out, fctrt-trivia-end(t, i)) : fctrt-code-go(t, s, i + 1, out);
  def fctrt-code-past(t, s, i, out, e) = fctrt-code-go(t, e, e, cons(" ", cons(substring(t, s, i), out)));
  def fctrt-str-end(t, i) {
   let j = scan_run(t, i, 4);
   j >= len(t) ? len(t) : str_byte_at(t, j) == 34 ? j + 1 : fctrt-str-end(t, j + 2);
  }
  def fctrt-first-on-line?(t, j) = j < 0 ? true : str_byte_at(t, j) == 10 ? true : (str_byte_at(t, j) == 32 || str_byte_at(t, j) == 9) ? fctrt-first-on-line?(t, j - 1) : false;
  def fctrt-comment?(t, i, b) = (b == 47 && i + 1 < len(t) && str_byte_at(t, i + 1) == 47) || (b == 59 && fctrt-first-on-line?(t, i - 1));
  def fctrt-trivia?(t, i, b) = b == 32 || b == 9 || b == 10 || b == 13 || fctrt-comment?(t, i, b);
  def fctrt-trivia-end(t, i) {
   let j = scan_run(t, i, 0);
   j < len(t) && fctrt-comment?(t, j, str_byte_at(t, j)) ? fctrt-trivia-end(t, scan_run(t, j, 5)) : j;
  }
  def fctrt-moved?(main, cand) = !nothing?(main) && !nothing?(cand) && (String) main != cand && (String) fctrt-code(main) != fctrt-code(cand);
  // a text read through the caller's band reader, read(path, verdict), at a path of its own in a directory of its own
  // under dir; the directory leaves after the read, with what the run compiled beside the text
  def fctrt-read-text(dir, tag, path, text, verdict, read) {
   let parts = split-on(path, "/");
   let home = dir ++ "/cross-" ++ tag ++ "-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
   let made = fs_mkdir(dir) + fs_mkdir(home);
   let at = home ++ "/" ++ parts[len(parts) - 1];
   let wrote = write_file_text(at, text);
   let value = read(at, verdict);
   let gone = host_dir_rmdir(home);
   value;
  }
  // The rule's two readings, one on each side of the candidate's window. Inside it, while the candidate stands: each owned
  // band other than the primary whose code the candidate moved, as [path, verdict, a, candidate's text]; mains are
  // [path, main's text]. Outside it, on main's source: the reasons those bands leave.
  def fctrt-cross-under(dir, mains, primary, read) = mains |> filter(m => fctrt-band?(m[0]) && (String) m[0] != primary && fctrt-moved?(m[1], read_file(m[0])))
   |> map(m => [m[0], fctrt-verdict(m[1]), fctrt-read-text(dir, "a", m[0], m[1], fctrt-verdict(m[1]), read), read_file(m[0])]);
  def fctrt-cross-reasons(dir, crossed, read) = crossed |> map(x => fctrt-hollowed(x[0], x[1], x[2], fctrt-read-text(dir, "c", x[0], x[3], x[1], read))) |> filter(r => (String) r != "");

  // ── local clock ──
  // progress, seat, stall, idle
  def fctrt-clock(generated, injected, wall, reason) {
   let act = fctrt-act(reason);
   (act[0] == "seat-busy" || act[0] == "admission-refused" || act[0] == "memory-low") ? "seat" :
   (fctrt-n(generated) > 0 || fctrt-n(injected) > 0) ? "progress" :
   fctrt-n(wall) >= fctrt-idle-ms() ? "stall" : "idle";
  }
 }
 0;
}
