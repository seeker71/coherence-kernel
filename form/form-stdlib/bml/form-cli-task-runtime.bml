// form-cli-task-runtime.bml — the runtime a task rides: one sentence in, a finished task out.
//
// Eight organs, each a reading the live doors call:
//   fctrt-intake            a sentence becomes a contract: the paths it names, the band whose prelude names one
//                           of them, or, among bands that only share a barrel, the larger verdict, and the model
//   fctrt-act               a lane reason becomes [class, spend, next, end]. spend 0 and end 1 tried nothing
//                           (fctrt-untried?): the seat, a memory refusal, a memory return. model-idle spends
//                           nothing and names voice, so the same walk continues on the next local model with the
//                           finding and the documents. A red band spends the attempt and stays in repair. A lane
//                           whose own machinery broke before its reply (fctrt-broke?) spends the attempt and ends
//                           the walk, since the next rung would meet the same lane. No candidate stood under the
//                           band, so the ladder reads it as judging nothing, the review as no lane result
//                           (local-flow-reading.bml) and the floor as no option (host-walk-floor.bml).
//   fctrt-claim / commit    one writer holds the session. A second writer cannot claim, and cannot commit a tool
//                           result. The file door is fctrt-claim-file / fctrt-commit-file.
//   fctrt-neighbor-paths    the bands whose preludes (every load directive line) name a changed file, or a barrel that
//                           imports it. Publish waits until each of those reads its own verdict (fctrt-holds).
//   fctrt-crossed           a band whose code the candidate moved (fctrt-code: what its loader and judge read) holds when
//                           the candidate's text under main's source reads main's claims as main's text holds them under
//                           both sources, and the change owed the move; both lanes read it through fctrt-cross-under (in
//                           the window) and fctrt-cross-reasons (on main), with a memo the lane keeps for its turn
//   the voice row of fctrt-act("local-stall") is how the next model receives the same task
//   fctrt-clock             tokens are progress. A seat or a memory ending is a seat. No tokens past the local
//                           idle bound is a stall. A short silence is idle.
// What it needs: the host's files (fs_list, read_file, file_size, fs_mkdir, write_file_text) for the tree and the
// writer door. The readings above are pure over the texts and rows a caller hands in.
// preludes: form-stdlib/line-grammar.fk form-stdlib/bml/parse.bml
section [form.bml] {
 class FormCliTaskRuntime {
  def fctrt-idle-ms() = 300000;
  def fctrt-starts?(s, p) = ((String) value_kind(s) == "string") && ((Comparable) len(s) >= len(p)) && ((String) substring(s, 0, len(p)) == p);
  def fctrt-ends?(s, p) = ((String) value_kind(s) == "string") && ((Comparable) len(s) >= len(p)) && ((String) substring(s, len(s) - len(p), len(s)) == p);
  def fctrt-n(v) = nothing?(v) ? 0 : v;
  def fctrt-body-path(path) = fctrt-starts?(path, "form/") ? substring(path, 5, len(path)) : path;

  // ── intake ──
  def fctrt-path?(token) = (str_find(token, "/", 0) >= 0) && (fctrt-ends?(token, ".bml") || fctrt-ends?(token, ".fk") || fctrt-ends?(token, ".md") || fctrt-ends?(token, ".form"));
  def fctrt-trim-token(s) = fctrt-trim-end(fctrt-trim-start(s));
  def fctrt-trim-start(s) = (fctrt-starts?(s, "\"") || fctrt-starts?(s, "'") || fctrt-starts?(s, "(") || fctrt-starts?(s, ",")) ? fctrt-trim-start(substring(s, 1, len(s))) : s;
  def fctrt-trim-end(s) = (len(s) > 0 && (fctrt-ends?(s, "\"") || fctrt-ends?(s, "'") || fctrt-ends?(s, ")") || fctrt-ends?(s, ",") || fctrt-ends?(s, ".") || fctrt-ends?(s, ";"))) ? fctrt-trim-end(substring(s, 0, len(s) - 1)) : s;
  def fctrt-paths(sentence) = filter(t => fctrt-path?(t), map(t => fctrt-trim-token(t), split-on(sentence ?? "", " ")));
  // A band's prelude: every line its loader reads as a load directive, joined. bml-source-prelude-line takes a // or ;
  // comment line whose words begin with preludes:, in the head or deep in the body; the kernel's collector
  // (fk_src_collect_preludes) takes the words after a line's ; in Form, preludes: and the import word both. A line a
  // preludes list carries on to with a \ belongs to it.
  def fctrt-prelude(text) {
   let t = text ?? "";
   let form = !fctrt-lowers?(t, 0);
   str-join(reverse(foldl((held, line) => fctrt-prelude-step(held, line, form), [[], false], split-on(t, "\n"))[0]));
  }
  def fctrt-prelude-step(held, line, form) {
   let keep = held[1] || fctrt-load-line?(line, form);
   [keep ? cons(line ++ "\n", held[0]) : held[0], keep && fctrt-ends?(trim(line), "\\")];
  }
  def fctrt-load-line?(line, form) {
   let t = trim(line);
   let semi = form ? str_find(t, ";", 0) : (fctrt-starts?(t, ";") ? 0 : -1);
   let at = fctrt-starts?(t, "//") ? 2 : (semi >= 0 ? semi + 1 : -1);
   let p = at < 0 ? "" : trim(substring(t, at, len(t)));
   at >= 0 && (fctrt-starts?(p, "preludes:") || (form && fctrt-import-at?(p, 0)));
  }
  // a text lowers through the BML floor when a line begins with `section [` (fk_unit_lowers); any other text is Form
  def fctrt-lowers?(t, i) {
   let at = str_find(t, "section [", i);
   at < 0 ? false : fctrt-first-on-line?(t, at - 1) ? true : fctrt-lowers?(t, at + 9);
  }
  def fctrt-lower(b) = (b >= 65 && b <= 90) ? b + 32 : b;
  def fctrt-ci-at?(t, p, w, k) = k >= len(w) ? true : (p + k < len(t) && fctrt-lower(str_byte_at(t, p + k)) == str_byte_at(w, k) && fctrt-ci-at?(t, p, w, k + 1));
  // the loader's import word (fk_src_word_at_ci): any case, then a space, a tab, a colon, a quote or the line's end
  def fctrt-import-at?(t, p) = fctrt-ci-at?(t, p, "import", 0) && (p + 6 >= len(t) || any?(c => str_byte_at(t, p + 6) == c, [32, 9, 58, 34, 10, 13]));
  def fctrt-band?(path) = str_find(path, "/tests/", 0) >= 0 || fctrt-starts?(path, "tests/");
  def fctrt-imports?(text, path) = str_find(text, "import " ++ fctrt-body-path(path), 0) >= 0;
  def fctrt-any?(paths, f) = nil?(paths) ? 0 : (f(paths[0]) ? 1 : fctrt-any?(paths[1:], f));
  def fctrt-barrel?(entry, changed) = (!fctrt-band?(entry[0])) && (fctrt-any?(changed, p => fctrt-imports?(entry[1], p)) == 1);
  def fctrt-barrels(entries, changed) = filter(e => fctrt-barrel?(e, changed), entries);
  def fctrt-mentions?(text, path) = ((String) path != "") && (str_find(text, fctrt-body-path(path), 0) >= 0);
  def fctrt-mentions-any?(text, paths) = fctrt-any?(paths, p => fctrt-mentions?(text, p)) == 1;
  def fctrt-neighbor?(entry, changed, barrels, primary) = fctrt-band?(entry[0]) && ((String) entry[0] != primary) && (fctrt-mentions-any?(fctrt-prelude(entry[1]), changed) || fctrt-mentions-any?(fctrt-prelude(entry[1]), map(b => b[0], barrels)));
  def fctrt-neighbor-paths(entries, changed, primary) {
   let barrels=fctrt-barrels(entries,changed);
   map(e=>e[0],filter(e=>fctrt-neighbor?(e,changed,barrels,primary),entries));
  }
  def fctrt-owned(paths,primary) = foldl((owned,path)=>any?(p=>p==path,owned) ? owned : owned+[path],paths,fctrt-neighbor-paths(fctrt-read-tree(),paths,primary));
  def fctrt-verdict-at(text, at, w) = at < 0 ? 0 : fctrt-verdict-digits(text, at + w, "");
  def fctrt-verdict-digits(text, i, out) = (i >= len(text) || !(((Comparable) str_byte_at(text, i) >= 48) && ((Comparable) str_byte_at(text, i) <= 57))) ? (out == "" ? 0 : parse-int(out)) : fctrt-verdict-digits(text, i + 1, out ++ substring(text, i, i + 1));
  // a band's pin, on a ; line or a // line, whichever comes first
  def fctrt-verdict(text) {
   let t = text ?? "";
   let semi = str_find(t, "; Verdict ", 0);
   let slash = str_find(t, "// Verdict ", 0);
   (slash < 0 || (semi >= 0 && semi < slash)) ? fctrt-verdict-at(t, semi, 10) : fctrt-verdict-at(t, slash, 11);
  }
  def fctrt-band-score(entry, changed, barrelPaths) = fctrt-mentions-any?(fctrt-prelude(entry[1]), changed) ? 2 : (fctrt-mentions-any?(fctrt-prelude(entry[1]), barrelPaths) ? 1 : 0);
  def fctrt-band-row(entry, changed, barrelPaths) = [fctrt-band-score(entry, changed, barrelPaths), fctrt-verdict(entry[1]), entry[0]];
  def fctrt-prefer?(a, b) = ((Comparable) a[0] > b[0]) || (((Comparable) a[0] == b[0]) && ((Comparable) a[1] > b[1]));
  def fctrt-best-row(rows, best) = nil?(rows) ? best : (fctrt-prefer?(rows[0], best) ? fctrt-best-row(rows[1:], rows[0]) : fctrt-best-row(rows[1:], best));
  def fctrt-chosen(rows) {
   let best = fctrt-best-row(rows[1:], rows[0]);
   [best[2], best[1]];
  }
  def fctrt-band-for(entries, changed) {
   let barrelPaths = map(b => b[0], fctrt-barrels(entries, changed));
   let rows = filter(r => (Comparable) r[0] > 0, map(e => fctrt-band-row(e, changed, barrelPaths), filter(e => fctrt-band?(e[0]), entries)));
   nil?(rows) ? ["", 0] : fctrt-chosen(rows);
  }
  // [goal, writable paths, band, full, model, next]. next is run, needs-files, or needs-band.
  def fctrt-intake(sentence, entries, model) {
   let paths = fctrt-paths(sentence);
   let band = nil?(paths) ? ["", 0] : fctrt-band-for(entries, paths);
   let next = nil?(paths) ? "needs-files" : ((String) band[0] == "" || (Comparable) band[1] == 0) ? "needs-band" : "run";
   [sentence ?? "", paths, band[0], band[1], model ?? "", next];
  }
  def fctrt-source?(name) = fctrt-ends?(name, ".bml") || fctrt-ends?(name, ".fk");
  def fctrt-read-dir(dir) = map(name => {
   let path=dir+"/"+name;let source=read_file(path);
   let observed=fb_record([path,nothing?(source) ? nothing() : len(source)],"native-source-read",0);
   [path,source];
  },filter(name=>fctrt-source?(name),fs_list(dir) ?? []));
  def fctrt-read-tree() = append(fctrt-read-dir("form/form-stdlib/tests"), fctrt-read-dir("form/form-stdlib/bml"));

  // ── failure table ──
  // [class, spend, next, end]. A renewal's ending (fcac-renewal-ending: native-context-renewal- and the renewal's own
  // reason, form-cli-model-renew.bml) is read by that reason: a prompt the window or the reply reserve cannot hold is the
  // gap's size (context-overflow); a second state the host had no room for is the host's (admission-refused), and its row
  // stays the history whose checkpoint the resume way takes; every other is the lane's own machinery (fctrt-broke?).
  def fctrt-renewal() = "native-context-renewal-";
  def fctrt-renewal-of(r) = fctrt-starts?(r, fctrt-renewal()) ? substring(r, len(fctrt-renewal()), len(r)) : nothing();
  def fctrt-room?(renewal) = fctrt-starts?(renewal, "prompt-context-window-refused") || fctrt-starts?(renewal, "prompt-caller-capacity-refused") || fctrt-starts?(renewal, "host-memory-held:");
  // A lane whose own machinery broke before its reply, named where the coding lane writes it: its generation broke
  // (generation-incomplete: the decoder lost its pending prediction, or the stream ended short of both its end and its
  // budget: fcac-incomplete and the reasoning stages, form-cli-code-live.bml), its model would not release
  // (native-model-release-incomplete, fcac-settled), or a renewal's own machinery refused (the device would not settle, a
  // stream would not allocate, prefill or release, the session or the prompt's tokens would not read). A reply that ran
  // past its budget or echoed its observation is the approach's outcome (fcac-recover-incomplete feeds it back to the
  // next reply), never the machinery's.
  def fctrt-broke?(reason) {
   let r = (String) value_kind(reason) == "string" ? reason : "";
   let renewal = fctrt-renewal-of(r);
   str_find(r, "generation-incomplete", 0) >= 0 || (String) r == "native-model-release-incomplete" || (!nothing?(renewal) && !fctrt-room?(renewal));
  }
  def fctrt-act(reason) {
   let r = (String) value_kind(reason) == "string" ? reason : "";
   fctrt-starts?(r, "model-queued:") ? ["seat-busy", 0, "wait", 1] :
   ((String) r == "host-memory-low") ? ["memory-low", 0, "resume", 1] :
   fctrt-starts?(r, "host-memory-held:") ? ["admission-refused", 0, "wait", 1] :
   fctrt-starts?(r, fctrt-renewal() ++ "host-memory-held:") ? ["admission-refused", 1, "stop", 1] :
   fctrt-broke?(r) ? ["broke", 1, "stop", 1] :
   fctrt-starts?(r, fctrt-renewal()) ? ["context-overflow", 1, "stop", 1] :
   (fctrt-starts?(r, "prompt-context-window-refused") || fctrt-starts?(r, "prompt-caller-capacity-refused")) ? ["context-overflow", 0, "compress", 0] :
   fctrt-starts?(r, "local-stall") ? ["model-idle", 0, "voice", 0] :
   fctrt-starts?(r, "truncated") ? ["truncated-tool", 0, "recover", 0] :
   fctrt-starts?(r, "malformed") ? ["malformed-action", 0, "repair", 0] :
   fctrt-starts?(r, "edit-miss") ? ["edit-miss", 0, "repair", 0] :
   ["red-band", 1, "repair", 0];
  }
  def fctrt-untried?(reason) = (fctrt-act(reason)[1] == 0) && (fctrt-act(reason)[3] == 1);

  // ── one writer ──
  def fctrt-note(session, writer, tool, n) = [session, writer, tool, n];
  def fctrt-blank() = ["", "", "", 0];
  def fctrt-claim(note, writer) = ((String) note[1] == "" || (String) note[1] == writer) ? [1, fctrt-note(note[0], writer, note[2], note[3])] : [0, note];
  def fctrt-commit(note, writer, tool) = (String) note[1] != writer ? [0, note] : [1, fctrt-note(note[0], writer, tool, note[3] + 1)];
  def fctrt-note-text(note) = note[0] ++ "\n" ++ note[1] ++ "\n" ++ note[2] ++ "\n" ++ note[3].str() ++ "\n";
  def fctrt-note-read(text) {
   let lines = split-on(text ?? "", "\n");
   (Comparable) len(lines) < 4 ? fctrt-blank() : fctrt-note(lines[0], lines[1], lines[2], parse-int(lines[3]) ?? 0);
  }
  def fctrt-writer-path(root, session) = root ++ "/" ++ session ++ "/writer.txt";
  def fctrt-claim-file(root, session, writer) {
   let dir = root ++ "/" ++ session;
   let made = fs_mkdir(dir);
   let path = fctrt-writer-path(root, session);
   let claimed = fctrt-claim(fctrt-note-read(read_file(path) ?? ""), writer);
   claimed[0] == 1 ? [1, write_file_text(path, fctrt-note-text(fctrt-note(session, writer, claimed[1][2], claimed[1][3])))] : [0, claimed[1]];
  }
  def fctrt-commit-file(root, session, writer, tool) {
   let path = fctrt-writer-path(root, session);
   let committed = fctrt-commit(fctrt-note-read(read_file(path) ?? ""), writer, tool);
   committed[0] == 1 ? [1, write_file_text(path, fctrt-note-text(fctrt-note(session, writer, tool, committed[1][3])))] : [0, committed[1]];
  }

  // ── acceptance ──
  def fctrt-held?(row) = (!nothing?(row[0])) && ((Comparable) row[0] == row[1]);
  def fctrt-holds(rows) = nil?(rows) ? 1 : (fctrt-held?(rows[0]) ? fctrt-holds(rows[1:]) : 0);

  // ── a neighbour band the candidate moved ──
  // The rule, said once for both lanes. A band reads its claims one bit each: its pin (main's Verdict) is all ones below
  // some bit. For an owned band whose code the candidate moved, b is main's text read under main's source, a main's text
  // under the candidate's source, c the candidate's text under main's source and d the candidate's text under its own.
  // An alignment the change owes leaves main's claims reading the same claims both ways (the claims of c that main's pin
  // names are the claims a and b both hold), and is owed only when a claim main's text held on main fails under the
  // candidate, or when the candidate adds a claim the change makes true (one past the pin that d holds and c does not).
  // A stub, a claim made true under any source, or a broken claim made vacuous reads neighbor-hollowed; a move the
  // change did not owe (a stub of a band it left whole, or of a band that waits short for its own gap) reads
  // neighbor-whole; a text that reads nothing on a side reads neighbor-unread; a pin that is not one bit per claim (a
  // count) reads its claims together, so a moved one is neighbor-uncounted and is read no further. "" holds.
  def fctrt-word(v) = nothing?(v) ? "nothing" : v.str();
  def fctrt-ones?(v) = !nothing?(v) && (Comparable) v > 0 && band(v, v + 1) == 0;
  def fctrt-past(r, v) = r - band(r, v);
  def fctrt-adds?(v, c, d) = !nothing?(d) && (Comparable) (fctrt-past(d, v) - band(fctrt-past(d, v), fctrt-past(c, v))) > 0;
  def fctrt-abc(a, b, c) = " A " ++ fctrt-word(a) ++ " B " ++ fctrt-word(b) ++ " C " ++ fctrt-word(c);
  def fctrt-crossed(path, v, b, a, c, d) = !fctrt-ones?(v) ? "neighbor-uncounted: " ++ path ++ " pin " ++ fctrt-word(v)
   : (nothing?(a) || nothing?(b) || nothing?(c)) ? "neighbor-unread: " ++ path ++ fctrt-abc(a, b, c)
   : !((Comparable) band(c, v) == band(a, b)) ? "neighbor-hollowed: " ++ path ++ fctrt-abc(a, b, c) ++ " verdict " ++ v.str()
   : ((Comparable) band(a, b) == b && !fctrt-adds?(v, c, d)) ? "neighbor-whole: " ++ path ++ fctrt-abc(a, b, c) : "";
  // what the next option hears, in both lanes, when a moved band does not hold
  def fctrt-cross-note(reasons) = nil?(reasons) ? "" : "Neighbor bands the candidate moved, read crosswise (A: main's text under the candidate's source; B: main's text under main's source; C: the candidate's text under main's source): " ++ str-join(fctrt-commas(reasons)) ++ ". A moved band holds when C reads main's claims as A and B both hold them, and the change owes the move: a claim main's text held fails under the candidate, or the candidate adds a claim the change makes true. Keep each band's claims; align only an expectation the change replaces; leave a band the change left whole as main has it.";
  def fctrt-commas(xs) = nil?(xs) ? [] : cons(xs[0], nil?(xs[1:]) ? [] : cons(", ", fctrt-commas(xs[1:])));
  // A text's code: its bytes with whitespace runs and comments read as one space, its edges trimmed, its strings whole.
  // Which bytes are comment is the reader's: a text that lowers takes // and /* */ as comments, and a ; that begins its
  // line; any other text is Form, where a ; outside a string begins a comment and // is code (a//b is a name). A line
  // comment whose words begin with a head the body reads is code, kept to its line's end (its quotes open no string, as
  // they open none for its reader): the loader's preludes: and, in Form, its import word; the contract's Verdict;
  // preflight-exec:; the sweep's PROOF LEVEL and STAGED CARRIER (the heads frq-directive? keeps); and a comment line a
  // preludes list carries on to with a \. An edit to a band's prose moves none of its code, and pays no reading.
  def fctrt-code(text) = trim(str-join(reverse(fctrt-code-go(text ?? "", fctrt-lowers?(text ?? "", 0), 0, 0, []))));
  def fctrt-code-go(t, m, s, i, out) = i >= len(t) ? cons(substring(t, s, i), out) : fctrt-code-at(t, m, s, i, out, str_byte_at(t, i));
  def fctrt-code-at(t, m, s, i, out, b) = b == 34 ? fctrt-code-go(t, m, s, fctrt-str-end(t, i + 1), out)
   : fctrt-trivia?(t, m, i, b) ? fctrt-code-past(t, m, s, i, out, fctrt-trivia-end(t, m, i))
   : fctrt-mark(t, m, i, b) > 0 ? fctrt-code-go(t, m, s, scan_run(t, i, 5), out) : fctrt-code-go(t, m, s, i + 1, out);
  def fctrt-code-past(t, m, s, i, out, e) = fctrt-code-go(t, m, e, e, cons(" ", cons(substring(t, s, i), out)));
  def fctrt-str-end(t, i) {
   let j = scan_run(t, i, 4);
   j >= len(t) ? len(t) : str_byte_at(t, j) == 34 ? j + 1 : fctrt-str-end(t, j + 2);
  }
  def fctrt-first-on-line?(t, j) = j < 0 ? true : str_byte_at(t, j) == 10 ? true : (str_byte_at(t, j) == 32 || str_byte_at(t, j) == 9) ? fctrt-first-on-line?(t, j - 1) : false;
  // the width of the comment marker that begins at i in mode m (true: the text lowers), 0 when none does
  def fctrt-mark(t, m, i, b) = m ? ((b == 47 && i + 1 < len(t) && (str_byte_at(t, i + 1) == 47 || str_byte_at(t, i + 1) == 42)) ? 2 : (b == 59 && fctrt-first-on-line?(t, i - 1)) ? 1 : 0) : (b == 59 ? 1 : 0);
  def fctrt-heads() = ["preludes:", "Verdict", "preflight-exec:", "PROOF LEVEL", "STAGED CARRIER"];
  def fctrt-blank-end(t, j) = (j < len(t) && (str_byte_at(t, j) == 32 || str_byte_at(t, j) == 9)) ? fctrt-blank-end(t, j + 1) : j;
  def fctrt-at?(t, p, w) = p + len(w) <= len(t) && (String) substring(t, p, p + len(w)) == w;
  def fctrt-directive?(t, m, p) = any?(h => fctrt-at?(t, p, h), fctrt-heads()) || (!m && fctrt-import-at?(t, p));
  // a comment line a preludes list carries on to: the line before it ends in a \ (fk_src_prelude_backslash_token)
  def fctrt-line-start(t, j) = j < 0 ? 0 : str_byte_at(t, j) == 10 ? j + 1 : fctrt-line-start(t, j - 1);
  def fctrt-solid-before(t, j) = j < 0 ? -1 : (str_byte_at(t, j) == 32 || str_byte_at(t, j) == 9 || str_byte_at(t, j) == 13) ? fctrt-solid-before(t, j - 1) : j;
  def fctrt-carried?(t, i) {
   let start = fctrt-line-start(t, i - 1);
   let k = fctrt-solid-before(t, start - 2);
   start > 0 && k >= 0 && str_byte_at(t, k) == 92;
  }
  def fctrt-block?(t, m, i, b) = m && b == 47 && i + 1 < len(t) && str_byte_at(t, i + 1) == 42;
  def fctrt-kept?(t, m, i, b) = !fctrt-block?(t, m, i, b) && (fctrt-directive?(t, m, fctrt-blank-end(t, i + fctrt-mark(t, m, i, b))) || fctrt-carried?(t, i));
  def fctrt-comment?(t, m, i, b) = fctrt-mark(t, m, i, b) > 0 && !fctrt-kept?(t, m, i, b);
  def fctrt-trivia?(t, m, i, b) = b == 32 || b == 9 || b == 10 || b == 13 || fctrt-comment?(t, m, i, b);
  def fctrt-comment-end(t, m, i) {
   let close = str_find(t, "*/", i + 2);
   fctrt-block?(t, m, i, str_byte_at(t, i)) ? (close < 0 ? len(t) : close + 2) : scan_run(t, i, 5);
  }
  def fctrt-trivia-end(t, m, i) {
   let j = scan_run(t, i, 0);
   (j < len(t) && fctrt-comment?(t, m, j, str_byte_at(t, j))) ? fctrt-trivia-end(t, m, fctrt-comment-end(t, m, j)) : j;
  }
  def fctrt-moved?(main, cand) = !nothing?(main) && !nothing?(cand) && (String) main != cand && (String) fctrt-code(main) != fctrt-code(cand);
  // ── a rename the change makes ──
  // The names a text defines, in order (BML's def NAME, Form's (defn NAME and (def NAME). A change renames when the names
  // main's sources define and the candidate's no longer do are as many as the names only the candidate's define; they
  // pair in order. A text read across the rename has each whole name of a pair [old, new] as its other side.
  def fctrt-name-byte?(b) = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 45;
  def fctrt-name-end(t, i) {
   let j = scan_run(t, i, 3);
   (j < len(t) && (str_byte_at(t, j) == 63 || str_byte_at(t, j) == 33)) ? j + 1 : j;
  }
  def fctrt-def-lead?(t, at) = at == 0 || any?(c => str_byte_at(t, at - 1) == c, [32, 9, 10, 13, 40, 123]);
  def fctrt-def-at(t, i) {
   let a = str_find(t, "def ", i);
   let n = str_find(t, "defn ", i);
   let at = a < 0 ? n : ((n < 0 || a < n) ? a : n);
   at < 0 ? [-1, -1] : fctrt-def-lead?(t, at) ? fctrt-def-name(t, scan_run(t, at + (at == n ? 5 : 4), 0), at + 1) : fctrt-def-at(t, at + 1);
  }
  def fctrt-def-name(t, s, next) = fctrt-name-end(t, s) > s ? [s, fctrt-name-end(t, s)] : fctrt-def-at(t, next);
  def fctrt-defs(text) = fctrt-defs-go(text ?? "", 0, []);
  def fctrt-defs-go(t, i, out) {
   let at = fctrt-def-at(t, i);
   at[0] < 0 ? reverse(out) : fctrt-defs-go(t, at[1], cons(substring(t, at[0], at[1]), out));
  }
  def fctrt-has?(xs, x) = any?(y => (String) y == x, xs);
  def fctrt-zip(xs, ys) = (nil?(xs) || nil?(ys)) ? [] : cons([xs[0], ys[0]], fctrt-zip(xs[1:], ys[1:]));
  // pairs are [main's text, candidate's text] of the change's sources
  def fctrt-renames(pairs) {
   let olds = foldl((all, p) => append(all, fctrt-defs(p[0])), [], pairs);
   let news = foldl((all, p) => append(all, fctrt-defs(p[1])), [], pairs);
   let gone = filter(n => !fctrt-has?(news, n), olds);
   let made = filter(n => !fctrt-has?(olds, n), news);
   (!nil?(gone) && (Comparable) len(gone) == len(made)) ? fctrt-zip(gone, made) : [];
  }
  // to 1: each old name becomes its new one; to 0: each new name its old one. A word after a / or before a . is a path's
  // segment or a file's name (a preludes or import line naming the source by its stem), never a call, and stays.
  def fctrt-renamed(text, renames, to) = (nil?(renames) || nothing?(text)) ? text : str-join(reverse(fctrt-ren-go(text, renames, to, 0, 0, [])));
  def fctrt-ren-go(t, rs, to, s, i, out) = i >= len(t) ? cons(substring(t, s, i), out)
   : fctrt-name-byte?(str_byte_at(t, i)) ? fctrt-ren-word(t, rs, to, s, i, out, fctrt-name-end(t, i)) : fctrt-ren-go(t, rs, to, s, i + 1, out);
  def fctrt-path-word?(t, i, e) = (i > 0 && str_byte_at(t, i - 1) == 47) || (e < len(t) && str_byte_at(t, e) == 46);
  def fctrt-ren-word(t, rs, to, s, i, out, e) {
   let word = substring(t, i, e);
   let hit = fctrt-path-word?(t, i, e) ? [] : filter(r => (String) r[1 - to] == word, rs);
   nil?(hit) ? fctrt-ren-go(t, rs, to, s, e, out) : fctrt-ren-go(t, rs, to, e, e, cons(hit[0][to], cons(substring(t, s, i), out)));
  }
  // ── the rule's readings ──
  // A reading kept for the lane's turn: memo is the record the lane keeps (fctrt-memo-new), or nothing; the same key reads
  // once. A baseline (b) keys on the band's path and main's text, so every reader of the turn shares it.
  def fctrt-memo-new() = record_new(0, "rows", []);
  def fctrt-memo-of(rec) = ((String) value_kind(rec) == "record" && (String) value_kind(record_get(rec, "memo")) == "record") ? record_get(rec, "memo") : nothing();
  def fctrt-memo(memo, key, f) = (String) value_kind(memo) != "record" ? f() : fctrt-memo-hit(memo, key, f, filter(r => (String) r[0] == key, record_get(memo, "rows")));
  def fctrt-memo-hit(memo, key, f, hit) = !nil?(hit) ? hit[0][1] : fctrt-memo-keep(memo, key, f());
  def fctrt-memo-keep(memo, key, v) {
   let kept = record_set(memo, "rows", cons([key, v], record_get(memo, "rows")));
   v;
  }
  def fctrt-baseline(memo, path, text, read, verdict) = fctrt-memo(memo, "b\n" ++ path ++ "\n" ++ (text ?? ""), () => read(path, verdict));
  def fctrt-pairs(paths, texts) = nil?(paths) ? [] : cons([paths[0], nil?(texts) ? nothing() : texts[0]], fctrt-pairs(paths[1:], nil?(texts) ? [] : texts[1:]));
  def fctrt-d(rows, path) = nil?(rows) ? nothing() : ((String) rows[0][0] == path ? rows[0][1] : fctrt-d(rows[1:], path));
  // a text read through the caller's band reader, read(path, verdict), at a path of its own in a directory of its own
  // under dir; the directory leaves after the read, with what the run compiled beside the text
  def fctrt-read-text(dir, tag, path, text, verdict, read) {
   let parts = split-on(path, "/");
   let home = dir ++ "/cross-" ++ tag ++ "-" ++ host_pid().str() ++ "-" ++ now_unix_ms().str();
   let made = fs_mkdir(dir) + fs_mkdir(home);
   let at = home ++ "/" ++ parts[len(parts) - 1];
   let wrote = write_file_text(at, text);
   let value = read(at, verdict);
   let gone = host_dir_rmdir(home);
   value;
  }
  // The rule's readings, one side of the candidate's window each. Inside it, while the candidate stands: mains are
  // [path, main's text] for every path the candidate may write, d the lane's own readings [path, value] of its bands under
  // the candidate. Each owned band other than the primary whose code the candidate moved becomes [path, pin, a,
  // candidate's text, d, how, renames, main's text]; how is "uncounted" (read no further), "follows" (main's text across
  // the change's renames is the candidate's code: it holds unread) or "cross" (a, main's text across the renames under the
  // candidate's source). Outside it, on main's source: b and c, and the reasons the moved bands leave.
  def fctrt-cross-under(dir, mains, primary, read, d, memo) {
   let renames = fctrt-renames(map(m => [m[1] ?? "", read_file(m[0]) ?? ""], filter(m => !fctrt-band?(m[0]), mains)));
   let under = str-join(map(m => (read_file(m[0]) ?? "") ++ "\n", mains));
   mains |> filter(m => fctrt-band?(m[0]) && (String) m[0] != primary && fctrt-moved?(m[1], read_file(m[0])))
    |> map(m => fctrt-cross-row(dir, m, read_file(m[0]), fctrt-verdict(m[1]), renames, read, fctrt-d(d, m[0]), memo, under));
  }
  def fctrt-cross-row(dir, m, text, pin, renames, read, d, memo, under) {
   let mainText = fctrt-renamed(m[1], renames, 1);
   let how = !fctrt-ones?(pin) ? "uncounted" : ((String) fctrt-code(mainText) == fctrt-code(text) ? "follows" : "cross");
   let a = (String) how == "cross" ? fctrt-memo(memo, "a\n" ++ m[0] ++ "\n" ++ mainText ++ "\n" ++ under, () => fctrt-read-text(dir, "a", m[0], mainText, pin, read)) : nothing();
   [m[0], pin, a, text, d, how, renames, m[1]];
  }
  def fctrt-cross-reasons(dir, crossed, read, memo) = crossed |> map(x => fctrt-cross-reason(dir, x, read, memo)) |> filter(r => (String) r != "");
  def fctrt-cross-reason(dir, x, read, memo) = (String) x[5] == "follows" ? "" : (String) x[5] == "uncounted" ? fctrt-crossed(x[0], x[1], nothing(), nothing(), nothing(), x[4]) : fctrt-cross-read(dir, x, read, memo, fctrt-renamed(x[3], x[6], 0));
  def fctrt-cross-read(dir, x, read, memo, candText) {
   let b = fctrt-baseline(memo, x[0], x[7], read, x[1]);
   let c = fctrt-memo(memo, "c\n" ++ x[0] ++ "\n" ++ candText, () => fctrt-read-text(dir, "c", x[0], candText, x[1], read));
   fctrt-crossed(x[0], x[1], b, x[2], c, x[4]);
  }

  // ── local clock ──
  // progress, seat, stall, idle
  def fctrt-clock(generated, injected, wall, reason) {
   let act = fctrt-act(reason);
   (act[0] == "seat-busy" || act[0] == "admission-refused" || act[0] == "memory-low") ? "seat" :
   (fctrt-n(generated) > 0 || fctrt-n(injected) > 0) ? "progress" :
   fctrt-n(wall) >= fctrt-idle-ms() ? "stall" : "idle";
  }
 }
 0;
}
