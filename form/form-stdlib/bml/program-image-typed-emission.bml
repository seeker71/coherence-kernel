//////////////////////////////////////////////////////////////////////
//
// program-image-typed-emission.bml — typed Program Image table rendering.
//
// A program image is born as a NodeID grammar: counts, roots, rows, and byte
// cells are explicit TYPED-LITERAL-INT children. Rendering therefore follows
// an already-proven structure and never discovers a raw host-value kind.
//
// preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk form-stdlib/program-image-fkb.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class ProgramImageTypedEmission [public, native, reusable] {
        field Version = "program-image-typed-emission-v1";
        field Invariant = "typed-nodeid-before-render";
        field IntBlueprint = "TYPED-LITERAL-INT";
        field StringBlueprint = "TYPED-LITERAL-STRING";
        field EnvelopeBlueprint = "PROGRAM-IMAGE-TYPED-ENVELOPE";
        field TableBlueprint = "PROGRAM-IMAGE-TYPED-TABLE";
        field RootsBlueprint = "PROGRAM-IMAGE-TYPED-FN-ROOTS";
        field RowsBlueprint = "PROGRAM-IMAGE-TYPED-NODE-ROWS";
        field RowBlueprint = "PROGRAM-IMAGE-TYPED-NODE-ROW";
        field StringsBlueprint = "PROGRAM-IMAGE-TYPED-STRING-ROWS";
        field StringRowBlueprint = "PROGRAM-IMAGE-TYPED-STRING-ROW";
        field NarrowIntegerLeaf = 1;
        field WideIntegerLeaf = 5;
        field StringLeaf = 2;
        field RowArity = 4;
        field TableArity = 6;
        field EnvelopeArity = 9;
        field ByteFloor = 0;
        field ByteCeiling = 255;
        field ReadySeal = 1;
        thought pattern = list("typed-leaves", "structural-validation", "numeric-render", "no-raw-kind-reflection");

        def pitte-int-bp() = bp(IntBlueprint());
        def pitte-string-bp() = bp(StringBlueprint());
        def pitte-envelope-bp() = bp(EnvelopeBlueprint());
        def pitte-table-bp() = bp(TableBlueprint());
        def pitte-roots-bp() = bp(RootsBlueprint());
        def pitte-rows-bp() = bp(RowsBlueprint());
        def pitte-row-bp() = bp(RowBlueprint());
        def pitte-strings-bp() = bp(StringsBlueprint());
        def pitte-string-row-bp() = bp(StringRowBlueprint());

        def pitte-int(value) = intern_node(pitte-int-bp(), list(intern_trivial_int(value)));
        def pitte-string(value) = intern_node(pitte-string-bp(), list(intern_trivial_string(value)));
        def pitte-int-child?(node) = if eq(node_type(node), NarrowIntegerLeaf()) then 1 else if eq(node_type(node), WideIntegerLeaf()) then 1 else 0;
        def pitte-string-child?(node) = if eq(node_type(node), StringLeaf()) then 1 else 0;
        def pitte-int?(node) = if node_eq(node_category(node), pitte-int-bp()) then if eq(len(node_children(node)), 1) then pitte-int-child?(head(node_children(node))) else 0 else 0;
        def pitte-string?(node) = if node_eq(node_category(node), pitte-string-bp()) then if eq(len(node_children(node)), 1) then pitte-string-child?(head(node_children(node))) else 0 else 0;
        def pitte-int-value(node) = if pitte-int?(node) then node_value(head(node_children(node))) else 0;
        def pitte-string-value(node) = if pitte-string?(node) then node_value(head(node_children(node))) else "";

        def pitte-int-nodes(values) = if nil?(values) then empty else cons(pitte-int(head(values)), pitte-int-nodes(tail(values)));
        def pitte-roots(values) = intern_node(pitte-roots-bp(), pitte-int-nodes(values));
        def pitte-row(tag, a, b, c) = intern_node(pitte-row-bp(), list(pitte-int(tag), pitte-int(a), pitte-int(b), pitte-int(c)));
        def pitte-rows(values) = intern_node(pitte-rows-bp(), values);
        def pitte-string-row(values) = intern_node(pitte-string-row-bp(), pitte-int-nodes(values));
        def pitte-strings(values) = intern_node(pitte-strings-bp(), values);
        def pitte-table(roots, rows, strings) = intern_node(pitte-table-bp(), list(pitte-int(len(node_children(roots))), roots, pitte-int(len(node_children(rows))), rows, pitte-int(len(node_children(strings))), strings));
        def pitte-table-node(nf, roots, nr, rows, ns, strings) = intern_node(pitte-table-bp(), list(nf, roots, nr, rows, ns, strings));

        def pitte-int-nodes-valid?(nodes) = if nil?(nodes) then 1 else if pitte-int?(head(nodes)) then pitte-int-nodes-valid?(tail(nodes)) else 0;
        def pitte-row-valid?(row) = if node_eq(node_category(row), pitte-row-bp()) then if eq(len(node_children(row)), RowArity()) then pitte-int-nodes-valid?(node_children(row)) else 0 else 0;
        def pitte-rows-valid?(rows) = if nil?(rows) then 1 else if pitte-row-valid?(head(rows)) then pitte-rows-valid?(tail(rows)) else 0;
        def pitte-string-row-valid?(row) = if node_eq(node_category(row), pitte-string-row-bp()) then pitte-byte-nodes-valid?(node_children(row)) else 0;
        def pitte-byte-nodes-valid?(nodes) = if nil?(nodes) then 1 else if pitte-int?(head(nodes)) then if ge(pitte-int-value(head(nodes)), ByteFloor()) then if le(pitte-int-value(head(nodes)), ByteCeiling()) then pitte-byte-nodes-valid?(tail(nodes)) else 0 else 0 else 0;
        def pitte-strings-valid?(rows) = if nil?(rows) then 1 else if pitte-string-row-valid?(head(rows)) then pitte-strings-valid?(tail(rows)) else 0;
        def pitte-table-shape?(table) = if node_eq(node_category(table), pitte-table-bp()) then eq(len(node_children(table)), TableArity()) else 0;
        def pitte-table-values-valid?(table) {
            let children = node_children(table);
            let nf = nth(children, 0);
            let roots = nth(children, 1);
            let nr = nth(children, 2);
            let rows = nth(children, 3);
            let ns = nth(children, 4);
            let strings = nth(children, 5);
            if pitte-int?(nf) then if node_eq(node_category(roots), pitte-roots-bp()) then if pitte-int?(nr) then if node_eq(node_category(rows), pitte-rows-bp()) then if pitte-int?(ns) then if node_eq(node_category(strings), pitte-strings-bp()) then if pitte-int-nodes-valid?(node_children(roots)) then if pitte-rows-valid?(node_children(rows)) then if pitte-strings-valid?(node_children(strings)) then if eq(pitte-int-value(nf), len(node_children(roots))) then if eq(pitte-int-value(nr), len(node_children(rows))) then eq(pitte-int-value(ns), len(node_children(strings))) else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0;
        }
        def pitte-table-valid?(table) = if pitte-table-shape?(table) then pitte-table-values-valid?(table) else 0;

        def pitte-rows-nodes(rows) = if nil?(rows) then empty else append(node_children(head(rows)), pitte-rows-nodes(tail(rows)));
        def pitte-string-nodes(row) = cons(pitte-int(len(node_children(row))), node_children(row));
        def pitte-strings-nodes(rows) = if nil?(rows) then empty else append(pitte-string-nodes(head(rows)), pitte-strings-nodes(tail(rows)));
        def pitte-number-nodes(table) {
            let children = node_children(table);
            append(list(nth(children, 0)), append(node_children(nth(children, 1)), append(list(nth(children, 2)), append(pitte-rows-nodes(node_children(nth(children, 3))), append(list(nth(children, 4)), pitte-strings-nodes(node_children(nth(children, 5))))))));
        }
        def pitte-render-nodes(nodes) = if nil?(nodes) then "\n" else if nil?(tail(nodes)) then str_concat(int_to_str(pitte-int-value(head(nodes))), "\n") else str_concat(int_to_str(pitte-int-value(head(nodes))), str_concat(" ", pitte-render-nodes(tail(nodes))));
        def pitte-table-text(table) = if pitte-table-valid?(table) then pitte-render-nodes(pitte-number-nodes(table)) else "";

        // The raw PIF is an executor compatibility image, born only after the
        // typed envelope has proved its own structure. It is never an input to
        // this authority and never the place where a value kind is inferred.
        def pitte-envelope(sourcePath, sourceHash, sourceMtime, artifactPath, contentHash, artifactMtime, seal, table) = intern_node(pitte-envelope-bp(), list(pitte-string(pif-version()), pitte-string(sourcePath), pitte-string(sourceHash), pitte-int(sourceMtime), pitte-string(artifactPath), pitte-string(contentHash), pitte-int(artifactMtime), pitte-int(seal), table));
        def pitte-envelope-node(version, sourcePath, sourceHash, sourceMtime, artifactPath, contentHash, artifactMtime, seal, table) = intern_node(pitte-envelope-bp(), list(version, sourcePath, sourceHash, sourceMtime, artifactPath, contentHash, artifactMtime, seal, table));
        def pitte-envelope-shape?(envelope) = if node_eq(node_category(envelope), pitte-envelope-bp()) then eq(len(node_children(envelope)), EnvelopeArity()) else 0;
        def pitte-nonempty-string-node?(node) = if pitte-string?(node) then gt(str_len(pitte-string-value(node)), 0) else 0;
        def pitte-positive-int-node?(node) = if pitte-int?(node) then gt(pitte-int-value(node), 0) else 0;
        def pitte-ready-seal-node?(node) = if pitte-int?(node) then eq(pitte-int-value(node), ReadySeal()) else 0;
        def pitte-envelope-valid?(envelope) {
            let children = node_children(envelope);
            let version = nth(children, 0);
            let sourcePath = nth(children, 1);
            let sourceHash = nth(children, 2);
            let sourceMtime = nth(children, 3);
            let artifactPath = nth(children, 4);
            let contentHash = nth(children, 5);
            let artifactMtime = nth(children, 6);
            let seal = nth(children, 7);
            let table = nth(children, 8);
            if pitte-envelope-shape?(envelope) then if pitte-string?(version) then if str_eq(pitte-string-value(version), pif-version()) then if pitte-nonempty-string-node?(sourcePath) then if pitte-nonempty-string-node?(sourceHash) then if pitte-positive-int-node?(sourceMtime) then if pitte-nonempty-string-node?(artifactPath) then if pitte-nonempty-string-node?(contentHash) then if pitte-positive-int-node?(artifactMtime) then if pitte-ready-seal-node?(seal) then pitte-table-valid?(table) else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0;
        }
        def pitte-envelope-table(envelope) = if pitte-envelope-shape?(envelope) then nth(node_children(envelope), 8) else empty;
        def pitte-int-values(nodes) = if nil?(nodes) then empty else cons(pitte-int-value(head(nodes)), pitte-int-values(tail(nodes)));
        def pitte-row-values(rows) = if nil?(rows) then empty else cons(pitte-int-values(node_children(head(rows))), pitte-row-values(tail(rows)));
        def pitte-string-values(rows) = if nil?(rows) then empty else cons(pitte-int-values(node_children(head(rows))), pitte-string-values(tail(rows)));
        def pitte-raw-table(table) {
            let children = node_children(table);
            pif-table-image-from-parts(pitte-int-values(node_children(nth(children, 1))), pitte-row-values(node_children(nth(children, 3))), pitte-string-values(node_children(nth(children, 5))));
        }
        def pitte-raw-envelope-ready(envelope) {
            let children = node_children(envelope);
            pif-envelope(pitte-string-value(nth(children, 1)), pitte-string-value(nth(children, 2)), pitte-int-value(nth(children, 3)), pitte-string-value(nth(children, 4)), pitte-string-value(nth(children, 5)), pitte-int-value(nth(children, 6)), pitte-int-value(nth(children, 7)), pitte-raw-table(nth(children, 8)));
        }
        def pitte-raw-envelope(envelope) = if pitte-envelope-valid?(envelope) then pitte-raw-envelope-ready(envelope) else nothing();
        def pitte-envelope-table-text(envelope) = if pitte-envelope-valid?(envelope) then pitte-table-text(pitte-envelope-table(envelope)) else nothing();
        def pitte-version() = Version();
        def pitte-invariant() = Invariant();
    }
    0;
}
