// Prefill reads each matrix with its declared GGUF quantization and output pitch.
// Q8 keeps its existing slot. Appended slots preserve every current consumer.
import form-stdlib/qk-matmul-batch.fk;
section [form.bml] {
 class Qwen38PrefillQuant {
  def q38pq-index(type) = match type { 8 => 55, 12 => 52, 14 => 53, 0 => 54, _ => -1 };
  def q38pq-f32-helpers() = "static inline float2 q38f32_inv(device const uchar* qb, uint b) { return float2(((device const float*)qb)[b / 4u], 0.0f); } static inline float q38f32_wi(device const uchar* qb, uint b, int i, float2 inv) { return inv.x; } ";
  // Q4_K and Q6_K hold slots 52/53 under their kernel names; their tile decodes its weights one sub-block
  // a K step (qmb-q4k-mma / qmb-q6k-mma) and answers the per-weight attestant (qmb-quant-mma) byte for byte.
  def q38pq-k-mma-msl() = qmb-q4k-mma("form_q4k_matmul_mma_f32") + qmb-q6k-mma("form_q6k_matmul_mma_f32");
  def q38pq-msl() = qml-msl-splits() + q38pq-f32-helpers() + qmb-batch-msl-n("form_qwen_f32_matmul_batch","q38f32","4","1") + qmb-q80-batch-tg() + qmb-q80-mma() + q38pq-k-mma-msl();
  def q38pq-k-mma-index(type) = type==12 || type==14 ? q38pq-index(type) : -1;
  // A K-quant row is whole 256-weight superblocks by format, and the tile strides a row by cols / 256 of them, so a
  // view whose cols is not a multiple of 256 would read its neighbour's superblocks: q38-mv-batch-y refuses it aloud
  // with this text before anything is enqueued (qwen38-prefill-quant-band, bit 128); "" when the row is whole.
  def q38pq-whole-refusal(type, cols) = ((type==12 || type==14) && cols % 256 != 0) ? "qwen prefill: a K-quant matrix row is whole 256-weight superblocks; type " + int_to_str(type) + " cols " + int_to_str(cols) + " is not a multiple of 256" : "";
  // the fourth is Q8_0's shared-activation twin (qk-matmul-batch.fk): the batched kernel's bytes with
  // each activation tile read once per eight rows. The fifth is its matrix-unit twin, the one the lane
  // dispatches for Q8_0 (q38-mv-batch-y): 32 x 32 tiles through simdgroup_multiply_accumulate, within
  // the lane's named bound of the batched sum.
  def q38pq-pipes(msl) = [metal_pipeline(msl, "form_q4k_matmul_mma_f32"), metal_pipeline(msl, "form_q6k_matmul_mma_f32"), metal_pipeline(msl, "form_qwen_f32_matmul_batch"), metal_pipeline(msl, "form_q8_0_matmul_batch_tg_f32"), metal_pipeline(msl, "form_q8_0_matmul_mma_f32")];
  def q38pq-mma-index() = 56;
 }
 0;
}
