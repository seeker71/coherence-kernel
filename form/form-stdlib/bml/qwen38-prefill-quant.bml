// Prefill reads each matrix with its declared GGUF quantization and output pitch.
// Q8 keeps its existing slot. Appended slots preserve every current consumer.
// preludes: form-stdlib/qk-matmul-batch.fk
section [form.bml] {
 class Qwen38PrefillQuant {
  def q38pq-index(type) = if eq(type, 8) then 31 else if eq(type, 12) then 52 else if eq(type, 14) then 53 else if eq(type, 0) then 54 else -1;
  def q38pq-f32-helpers() = "static inline float2 q38f32_inv(device const uchar* qb, uint b) { return float2(((device const float*)qb)[b / 4u], 0.0f); } static inline float q38f32_wi(device const uchar* qb, uint b, int i, float2 inv) { return inv.x; } ";
  def q38pq-msl() = str_concat(qml-msl-splits(), str_concat(qmb-msl-appendix(), str_concat(q38pq-f32-helpers(), qmb-batch-msl-n("form_qwen_f32_matmul_batch", "q38f32", "4", "1"))));
  def q38pq-pipes(msl) = list(metal_pipeline(msl, "form_q4k_matmul_batch_f32"), metal_pipeline(msl, "form_q6k_matmul_batch_f32"), metal_pipeline(msl, "form_qwen_f32_matmul_batch"));
 }
 0;
}
