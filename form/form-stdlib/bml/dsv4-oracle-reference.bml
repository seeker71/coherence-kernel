// Independent GGUF, quantization and fp64 reference recipes.
// Recipe source: ds4-engine/ds4.c; no production MLA/HC/MoE recipe imports.
// preludes: form-stdlib/core.fk form-stdlib/bml/formbin-codec.bml form-stdlib/bml/dsv4-numeric-reference.bml form/form-stdlib/bml/dsv4-oracle-tables.bml form/form-stdlib/bml/dsv4-oracle-angle.bml
section [form.bml] {
 class Dsv4FileOracle {
  def dfo-require(ok,reason) = if ok then 1 else form_error(str_concat("DSV4 oracle: ",reason));
  def dfo-min(a,b) = if lt(a,b) then a else b;
  def dfo-max(a,b) = if gt(a,b) then a else b;
  def dfo-natural(n) = and(str_eq(value_kind(n),"int"),ge(n,0));
  def dfo-positive(n) = and(dfo-natural(n),gt(n,0));
  def dfo-product(a,b) = if not(and(dfo-natural(a),dfo-natural(b))) then nothing() else if eq(a,0) then 0 else if gt(b,div(4611686018427387903,a)) then nothing() else mul(a,b);
  def dfo-sum(a,b) = if not(and(dfo-natural(a),dfo-natural(b))) then nothing() else if gt(b,sub(4611686018427387903,a)) then nothing() else add(a,b);
  def dfo-size(n) {
   dfo-require(not(nothing?(n)),"inexact or overflowing extent"); n;
  }
  def dfo-positive-dims(xs) = if nil?(xs) then 1 else and(dfo-positive(head(xs)),dfo-positive-dims(tail(xs)));
  def dfo-dim-cells(xs,n) = if nil?(xs) then n else dfo-dim-cells(tail(xs),dfo-size(dfo-product(n,head(xs))));
  def dfo-pow-positive(x,n,acc) = if eq(n,0) then acc else dfo-pow-positive(mul(x,x),div(n,2),if eq(mod(n,2),1) then mul(acc,x) else acc);
  def dfo-pow2(n) = if lt(n,0) then dfo-pow-positive(0.5,sub(0,n),1.0) else dfo-pow-positive(2.0,n,1.0);
  def dfo-reader(path) {
   let size = file_size(path);
   dfo-require(ge(size,24),"missing or truncated GGUF header");
   record_new(0,"path",path,"extent",size,"start",0,"bytes","","meta",record_new(0),"tensors",record_new(0),"tensor-names",list(),"matrix-mx8",dfo-ref-mx8,"matrix-f16",dfo-ref-f16,"matrix-expert",dfo-ref-expert,"matrix-out-a",dfo-ref-out-a);
  }
  def dfo-span(r,at,n) {
   dfo-require(and(dfo-natural(at),and(dfo-natural(n),and(le(at,record_get(r,"extent")),le(n,sub(record_get(r,"extent"),at))))),"file span exceeds observed extent");
   if and(ge(at,record_get(r,"start")),le(add(at,n),add(record_get(r,"start"),str_len(record_get(r,"bytes"))))) then record_get(r,"bytes")
   else dfo-window(r,at,n);
  }
  def dfo-window(r,at,n) {
   let extent = record_get(r,"extent");
   let amount = dfo-min(sub(extent,at),dfo-max(n,65536));
   let bytes = read_file_slice(record_get(r,"path"),at,amount);
   dfo-require(and(eq(file_size(record_get(r,"path")),extent),and(not(nothing?(bytes)),eq(str_len(bytes),amount))),"incomplete or changed file read");
   record_set(r,"start",at); record_set(r,"bytes",bytes); bytes;
  }
  def dfo-bytes(r,at,n) {
   let src = dfo-span(r,at,n); let local = sub(at,record_get(r,"start")); substring(src,local,add(local,n));
  }
  def dfo-le(src,at,n) = if eq(n,0) then 0 else add(str_byte_at(src,at),mul(256,dfo-le(src,add(at,1),sub(n,1))));
  def dfo-uint(r,at,n) {
   let src = dfo-span(r,at,n); let local = sub(at,record_get(r,"start")); if eq(n,8) then dfo-require(lt(str_byte_at(src,add(local,7)),64),"unsigned extent exceeds native exact integer domain") else 1; dfo-le(src,local,n);
  }
  def dfo-string-end(r,at) {
   let size = dfo-uint(r,at,8); dfo-require(le(size,sub(record_get(r,"extent"),add(at,8))),"truncated string extent"); add(add(at,8),size);
  }
  def dfo-string(r,at) {
   let end = dfo-string-end(r,at); let value = dfo-bytes(r,add(at,8),sub(end,add(at,8))); dfo-require(fbc-utf8(value,0),"invalid UTF8 name"); value;
  }
  def dfo-width(t) = if or(eq(t,0),or(eq(t,1),eq(t,7))) then 1 else if or(eq(t,2),eq(t,3)) then 2 else if or(eq(t,4),or(eq(t,5),eq(t,6))) then 4 else if or(eq(t,10),or(eq(t,11),eq(t,12))) then 8 else 0;
  def dfo-value-end(r,at,t) = if eq(t,8) then dfo-string-end(r,at) else if eq(t,9) then dfo-array-end(r,add(at,12),dfo-uint(r,at,4),dfo-uint(r,add(at,4),8)) else dfo-fixed-end(r,at,dfo-width(t),1);
  def dfo-fixed-end(r,at,width,count) {
   dfo-require(gt(width,0),"unknown GGUF metadata value type"); dfo-require(le(count,div(sub(record_get(r,"extent"),at),width)),"truncated metadata extent"); add(at,mul(width,count));
  }
  def dfo-array-end(r,at,t,count) = if gt(dfo-width(t),0) then dfo-fixed-end(r,at,dfo-width(t),count) else if not(or(eq(t,8),eq(t,9))) then form_error("unknown GGUF array value type") else if eq(count,0) then at else dfo-array-end(r,dfo-value-end(r,at,t),t,sub(count,1));
  def dfo-metadata(r,at,left) = if eq(left,0) then at else dfo-metadata-next(r,at,left);
  def dfo-metadata-next(r,at,left) {
    let key = dfo-string(r,at); let next = dfo-string-end(r,at); let t = dfo-uint(r,next,4); let value = add(next,4); let end = dfo-value-end(r,value,t);
    dfo-require(not(record_has(record_get(r,"meta"),key)),"duplicate metadata key");
    record_set(record_get(r,"meta"),key,list(t,value,end));
    dfo-metadata(r,end,sub(left,1));
  }
  def dfo-dims(r,at,n,acc) = if eq(n,0) then reverse(acc) else dfo-dim-next(r,at,n,acc,dfo-uint(r,at,8));
  def dfo-dim-next(r,at,n,acc,value) {
   dfo-require(dfo-positive(value),"tensor dimension must be an exact positive integer"); dfo-dims(r,add(at,8),sub(n,1),cons(value,acc));
  }
  def dfo-tensor-table(r,at,left) = if eq(left,0) then at else dfo-tensor-next(r,at,left);
  def dfo-tensor-next(r,at,left) {
    let key = dfo-string(r,at); let next = dfo-string-end(r,at); let nd = dfo-uint(r,next,4); let start = add(next,4);
    dfo-require(and(gt(nd,0),le(nd,div(sub(record_get(r,"extent"),start),8))),"invalid tensor dimension extent");
    let dims = dfo-dims(r,start,nd,list()); let cells = dfo-dim-cells(dims,1); let tt = dfo-size(dfo-sum(start,dfo-product(nd,8))); let ty = dfo-uint(r,tt,4); let rel = dfo-uint(r,add(tt,4),8);
    dfo-require(not(record_has(record_get(r,"tensors"),key)),"duplicate tensor name");
    record_set(record_get(r,"tensors"),key,list(ty,dims,rel));
    record_set(r,"tensor-names",cons(key,record_get(r,"tensor-names")));
    dfo-tensor-table(r,add(tt,12),sub(left,1));
  }
  def dfo-open(path) {
   let r = dfo-reader(path);
   dfo-require(str_eq(dfo-bytes(r,0,4),"GGUF"),"bad GGUF magic");
   dfo-require(eq(dfo-uint(r,4,4),3),"GGUF version must be3");
   let nt = dfo-uint(r,8,8); let nk = dfo-uint(r,16,8);
   let ti = dfo-metadata(r,24,nk); let end = dfo-tensor-table(r,ti,nt);
   let alignment = if record_has(record_get(r,"meta"),"general.alignment") then dfo-meta(r,"general.alignment") else 32;
   dfo-require(and(dfo-positive(alignment),and(dfo-metadata-kind(r,"general.alignment","integer"),le(alignment,sub(record_get(r,"extent"),end)))),"invalid GGUF alignment");
   record_set(r,"data",mul(div(dfo-size(dfo-sum(end,sub(alignment,1))),alignment),alignment)); record_set(r,"tensor-count",nt); record_set(r,"metadata-count",nk); record_set(r,"tensor-names",reverse(record_get(r,"tensor-names"))); r;
  }
  def dfo-float-fields(sign,exponent,mantissa,bias,mantBits,maxExp) = mul(sign,if eq(exponent,0) then mul(mul(1.0,mantissa),dfo-pow2(sub(sub(1,bias),mantBits))) else if eq(exponent,maxExp) then if eq(mantissa,0) then div(1.0,0.0) else div(0.0,0.0) else mul(add(1.0,div(mul(1.0,mantissa),dfo-pow2(mantBits))),dfo-pow2(sub(exponent,bias))));
  def dfo-f16(bits) = dfo-float-fields(if ge(bits,32768) then -1.0 else 1.0,mod(div(bits,1024),32),mod(bits,1024),15,10,31);
  def dfo-f32(bits) = dfo-float-fields(if ge(bits,2147483648) then -1.0 else 1.0,mod(div(bits,8388608),256),mod(bits,8388608),127,23,255);
  def dfo-f64(src) {
   let lo = dfo-le(src,0,4); let hi = dfo-le(src,4,4); dfo-float-fields(if ge(hi,2147483648) then -1.0 else 1.0,mod(div(hi,1048576),2048),add(lo,mul(mod(hi,1048576),4294967296)),1023,52,2047);
  }
  def dfo-signed(value,bits) = if ge(value,dfo-pow2(sub(bits,1))) then sub(value,trunc(dfo-pow2(bits))) else value;
  def dfo-value(r,at,t) = if eq(t,8) then dfo-string(r,at) else if eq(t,9) then dfo-array(r,add(at,12),dfo-uint(r,at,4),dfo-uint(r,add(at,4),8),list()) else if eq(t,6) then dfo-f32(dfo-uint(r,at,4)) else if eq(t,12) then dfo-f64(dfo-bytes(r,at,8)) else if or(eq(t,10),eq(t,11)) then dfo-wide64(dfo-bytes(r,at,8),eq(t,11)) else if or(eq(t,1),or(eq(t,3),eq(t,5))) then dfo-signed(dfo-uint(r,at,dfo-width(t)),mul(8,dfo-width(t))) else dfo-uint(r,at,dfo-width(t));
  def dfo-wide64(raw,signed) {
   let lo = dfo-le(raw,0,4); let hi = dfo-le(raw,4,4);
   if lt(hi,1073741824) then add(lo,mul(hi,4294967296)) else if and(signed,ge(hi,3221225472)) then add(lo,mul(sub(hi,4294967296),4294967296)) else record_new(0,"kind",if signed then "gguf-i64" else "gguf-u64","raw",raw,"lo",lo,"hi",hi);
  }
  def dfo-array(r,at,t,n,acc) = if eq(n,0) then reverse(acc) else dfo-array(r,dfo-value-end(r,at,t),t,sub(n,1),cons(dfo-value(r,at,t),acc));
  def dfo-meta(r,key) {
   dfo-require(record_has(record_get(r,"meta"),key),str_concat("missing metadata: ",key)); let row = record_get(record_get(r,"meta"),key); dfo-value(r,nth(row,1),head(row));
  }
  def dfo-tensor(r,key) {
   dfo-require(record_has(record_get(r,"tensors"),key),str_concat("missing tensor: ",key)); record_get(record_get(r,"tensors"),key);
  }
  def dfo-abs(r,tensor) = dfo-size(dfo-sum(record_get(r,"data"),nth(tensor,2)));
  def dfo-floats(src,ty,i,n,acc) = if eq(i,n) then reverse(acc) else dfo-floats(src,ty,add(i,1),n,cons(if eq(ty,1) then dfo-f16(dfo-le(src,mul(i,2),2)) else dfo-f32(dfo-le(src,mul(i,4),4)),acc));
  def dfo-plain(r,key,row) {
   let t = dfo-tensor(r,key); let ty = head(t); let width = head(nth(t,1)); let size = if eq(ty,1) then 2 else 4;
   dfo-require(and(or(eq(ty,0),eq(ty,1)),and(le(len(nth(t,1)),2),and(str_eq(value_kind(row),"int"),and(ge(row,0),lt(row,if eq(len(nth(t,1)),1) then 1 else nth(nth(t,1),1)))))),"plain tensor type or row extent");
   dfo-require(dfo-positive-dims(nth(t,1)),"plain tensor dimensions"); let stride = dfo-size(dfo-product(width,size));
   dfo-floats(dfo-bytes(r,dfo-size(dfo-sum(dfo-abs(r,t),dfo-product(row,stride))),stride),ty,0,width,list());
  }
  def dfo-e4m3(b) {
   let a = mod(b,128); let e = div(a,8); let m = mod(a,8); mul(if ge(b,128) then -1.0 else 1.0,if eq(e,0) then mul(m,0.001953125) else mul(add(1.0,mul(m,0.125)),dfo-pow2(sub(e,7))));
  }
  def dfo-mx8-group(data,at,x,left,sum) = if eq(left,0) then list(sum,x) else dfo-mx8-group(data,add(at,1),tail(x),sub(left,1),add(sum,mul(dfo-e4m3(str_byte_at(data,at)),head(x))));
  def dfo-mx8-groups(data,scales,at,x,group,n,sum) = if eq(group,n) then sum else dfo-mx8-next(data,scales,at,group,n,sum,dfo-mx8-group(data,at,x,32,0.0));
  def dfo-mx8-next(data,scales,at,group,n,sum,part) = dfo-mx8-groups(data,scales,add(at,32),nth(part,1),add(group,1),n,add(sum,mul(head(part),dfo-pow2(sub(str_byte_at(scales,group),127)))));
  def dfo-mx8-row(r,key,row,x) {
   let t = dfo-tensor(r,key); let dims = nth(t,1); let cols = head(dims); let rows = nth(dims,1); let at = dfo-abs(r,t);
   dfo-require(and(eq(head(t),41),and(eq(mod(cols,32),0),and(eq(len(x),cols),and(ge(row,0),lt(row,rows))))),"MXFP8 row geometry mismatch");
   let data = dfo-bytes(r,add(at,mul(row,cols)),cols); let scales = dfo-bytes(r,add(add(at,mul(rows,cols)),mul(row,div(cols,32))),div(cols,32));
   dfo-mx8-groups(data,scales,0,x,0,div(cols,32),0.0);
  }
  // Matrices hold their two complete planes once. Row traversal never reloads
  // overlapping windows or reconstructs a dequantized matrix.
  def dfo-plane-groups(data,scales,at,x,group,end,sum) = if eq(group,end) then sum else dfo-plane-next(data,scales,at,group,end,sum,dfo-mx8-group(data,at,x,32,0.0));
  def dfo-plane-next(data,scales,at,group,end,sum,part) = dfo-plane-groups(data,scales,add(at,32),nth(part,1),add(group,1),end,add(sum,mul(head(part),dfo-pow2(sub(str_byte_at(scales,group),127)))));
  def dfo-mx8-rows(data,scales,cols,row,rows,x,acc) = if eq(row,rows) then reverse(acc) else dfo-mx8-rows(data,scales,cols,add(row,1),rows,x,cons(dfo-plane-groups(data,scales,mul(row,cols),x,mul(row,div(cols,32)),mul(add(row,1),div(cols,32)),0.0),acc));
  def dfo-mx8(r,key,x) {
   let run = record_get(r,"matrix-mx8"); run(r,key,x);
  }
  def dfo-ref-mx8(r,key,x) {
   let t = dfo-tensor(r,key); let dims = nth(t,1); let cols = head(dims); let rows = nth(dims,1); let at = dfo-abs(r,t); let cells = mul(rows,cols);
   dfo-require(and(eq(head(t),41),and(eq(mod(cols,32),0),eq(len(x),cols))),str_concat("MXFP8 matrix geometry: ",key));
   let data = dfo-bytes(r,at,cells); let scales = dfo-bytes(r,add(at,cells),div(cells,32));
   dfo-mx8-rows(data,scales,cols,0,rows,x,list());
  }
  def dfo-f16-dot(src,at,x,sum) = if nil?(x) then sum else dfo-f16-dot(src,add(at,2),tail(x),add(sum,mul(dfo-f16(dfo-le(src,at,2)),head(x))));
  def dfo-f16-rows(src,cols,row,rows,x,acc) = if eq(row,rows) then reverse(acc) else dfo-f16-rows(src,cols,add(row,1),rows,x,cons(dfo-f16-dot(src,mul(mul(row,cols),2),x,0.0),acc));
  def dfo-f16-matrix(r,key,x) {
   let run = record_get(r,"matrix-f16"); run(r,key,x);
  }
  def dfo-ref-f16(r,key,x) {
   let t = dfo-tensor(r,key); let dims = nth(t,1); let cols = head(dims); let rows = nth(dims,1);
   dfo-require(and(eq(head(t),1),eq(len(x),cols)),str_concat("F16 matrix geometry: ",key));
   dfo-f16-rows(dfo-bytes(r,dfo-abs(r,t),mul(mul(cols,rows),2)),cols,0,rows,x,list());
  }
  def dfo-e2m1(b) {
   let e = mod(div(b,2),4); let m = mod(b,2);
   mul(if ge(b,8) then -1.0 else 1.0,if eq(e,0) then mul(m,0.5) else mul(dfo-pow2(sub(e,1)),add(1.0,mul(m,0.5))));
  }
  def dfo-mx4-group(data,at,x,left,even,odd) = if eq(left,0) then list(add(even,odd),x) else dfo-mx4-group(data,add(at,1),tail(tail(x)),sub(left,1),add(even,mul(dfo-e2m1(mod(str_byte_at(data,at),16)),head(x))),add(odd,mul(dfo-e2m1(div(str_byte_at(data,at),16)),nth(x,1))));
  def dfo-mx4-groups(data,scales,at,x,group,end,sum) = if eq(group,end) then sum else dfo-mx4-next(data,scales,at,group,end,sum,dfo-mx4-group(data,at,x,16,0.0,0.0));
  def dfo-mx4-next(data,scales,at,group,end,sum,part) = dfo-mx4-groups(data,scales,add(at,16),nth(part,1),add(group,1),end,add(sum,mul(head(part),dfo-pow2(sub(str_byte_at(scales,group),127)))));
  def dfo-mx4-rows(data,scales,cols,row,rows,x,acc) = if eq(row,rows) then reverse(acc) else dfo-mx4-rows(data,scales,cols,add(row,1),rows,x,cons(dfo-mx4-groups(data,scales,mul(row,div(cols,2)),x,mul(row,div(cols,32)),mul(add(row,1),div(cols,32)),0.0),acc));
  def dfo-mx4(r,t,expert,x) {
   let dims = nth(t,1); let cols = head(dims); let rows = nth(dims,1); let cells = mul(rows,cols); let stride = add(div(cells,2),div(cells,32)); let at = add(dfo-abs(r,t),mul(expert,stride));
   dfo-require(and(eq(mod(cols,32),0),eq(len(x),cols)),"MXFP4 expert geometry");
   let data = dfo-bytes(r,at,div(cells,2)); let scales = dfo-bytes(r,add(at,div(cells,2)),div(cells,32));
   dfo-mx4-rows(data,scales,cols,0,rows,x,list());
  }
  def dfo-grid-byte(grid,gi,j) {
   let at = add(mul(gi,16),mul(sub(7,j),2));
   add(mul(hex-digit-value(str_byte_at(grid,at)),16),hex-digit-value(str_byte_at(grid,add(at,1))));
  }
  def dfo-iq-dot8(grid,gi,sign,x,j,sum) = if eq(j,8) then list(sum,x) else dfo-iq-dot8(grid,gi,div(sign,2),tail(x),add(j,1),add(sum,mul(mul(if eq(mod(sign,2),0) then 1.0 else -1.0,dfo-grid-byte(grid,gi,j)),head(x))));
  def dfo-iq-group(data,at,aux,grid,signs,x,j,sum) = if eq(j,4) then list(sum,x) else dfo-iq-group-next(data,at,aux,grid,signs,j,sum,dfo-iq-dot8(grid,str_byte_at(data,add(at,j)),nth(signs,mod(aux,128)),x,0,0.0));
  def dfo-iq-group-next(data,at,aux,grid,signs,j,sum,part) = dfo-iq-group(data,at,div(aux,128),grid,signs,nth(part,1),add(j,1),add(sum,head(part)));
  def dfo-iq-groups(data,at,d,grid,signs,x,j,sum) = if eq(j,8) then list(sum,x) else dfo-iq-group-scaled(data,at,d,grid,signs,x,j,sum,dfo-le(data,add(at,4),4));
  def dfo-iq-group-scaled(data,at,d,grid,signs,x,j,sum,aux) = dfo-iq-groups-next(data,at,d,grid,signs,j,sum,mul(mul(0.125,d),add(mul(2,div(aux,268435456)),1)),dfo-iq-group(data,at,aux,grid,signs,x,0,0.0));
  def dfo-iq-groups-next(data,at,d,grid,signs,j,sum,scale,part) = dfo-iq-groups(data,add(at,8),d,grid,signs,nth(part,1),add(j,1),add(sum,mul(scale,head(part))));
  def dfo-iq-blocks(data,at,x,left,grid,signs,sum) = if eq(left,0) then sum else dfo-iq-block-next(data,at,left,grid,signs,dfo-iq-groups(data,add(at,2),dfo-f16(dfo-le(data,at,2)),grid,signs,x,0,sum));
  def dfo-iq-block-next(data,at,left,grid,signs,part) = dfo-iq-blocks(data,add(at,66),nth(part,1),sub(left,1),grid,signs,head(part));
  def dfo-iq-rows(data,cols,row,rows,x,grid,signs,acc) = if eq(row,rows) then reverse(acc) else dfo-iq-rows(data,cols,add(row,1),rows,x,grid,signs,cons(dfo-iq-blocks(data,mul(mul(row,div(cols,256)),66),x,div(cols,256),grid,signs,0.0),acc));
  def dfo-iq2(r,t,expert,x) {
   let dims = nth(t,1); let cols = head(dims); let rows = nth(dims,1); let stride = mul(mul(rows,div(cols,256)),66);
   dfo-require(and(eq(mod(cols,256),0),eq(len(x),cols)),"IQ2_XXS expert geometry");
   dfo-iq-rows(dfo-bytes(r,add(dfo-abs(r,t),mul(expert,stride)),stride),cols,0,rows,x,dfo-iq-grid-hex(),dfo-iq-signs(),list());
  }
  def dfo-expert-matrix(r,key,expert,x) {
   let run = record_get(r,"matrix-expert"); run(r,key,expert,x);
  }
  def dfo-ref-expert(r,key,expert,x) {
