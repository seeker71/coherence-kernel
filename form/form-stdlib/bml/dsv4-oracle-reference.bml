  }
  def dfo-grid-byte(grid,gi,j) {
   let at = ((gi * 16) + ((7 - j) * 2));
   ((hex-digit-value(str_byte_at(grid,at)) * 16) + hex-digit-value(str_byte_at(grid,(at + 1))));
  }
  def dfo-iq-dot8(grid,gi,sign,x,j,sum) = if ((Comparable) j == 8) then list(sum,x) else dfo-iq-dot8(grid,gi,(sign / 2),tail(x),(j + 1),(sum + (((if ((Comparable) (sign % 2) == 0) then 1.0 else -1.0) * dfo-grid-byte(grid,gi,j)) * head(x))));
  def dfo-iq-group(data,at,aux,grid,signs,x,j,sum) = if ((Comparable) j == 4) then list(sum,x) else dfo-iq-group-next(data,at,aux,grid,signs,j,sum,dfo-iq-dot8(grid,str_byte_at(data,(at + j)),nth(signs,(aux % 128)),x,0,0.0));
  def dfo-iq-group-next(data,at,aux,grid,signs,j,sum,part) = dfo-iq-group(data,at,(aux / 128),grid,signs,nth(part,1),(j + 1),(sum + head(part)));
  def dfo-iq-groups(data,at,d,grid,signs,x,j,sum) = if ((Comparable) j == 8) then list(sum,x) else dfo-iq-group-scaled(data,at,d,grid,signs,x,j,sum,dfo-le(data,(at + 4),4));
  def dfo-iq-group-scaled(data,at,d,grid,signs,x,j,sum,aux) = dfo-iq-groups-next(data,at,d,grid,signs,j,sum,((0.125 * d) * ((2 * (aux / 268435456)) + 1)),dfo-iq-group(data,at,aux,grid,signs,x,0,0.0));
  def dfo-iq-groups-next(data,at,d,grid,signs,j,sum,scale,part) = dfo-iq-groups(data,(at + 8),d,grid,signs,nth(part,1),(j + 1),(sum + (scale * head(part))));
  def dfo-iq-blocks(data,at,x,left,grid,signs,sum) = if ((Comparable) left == 0) then sum else dfo-iq-block-next(data,at,left,grid,signs,dfo-iq-groups(data,(at + 2),dfo-f16(dfo-le(data,at,2)),grid,signs,x,0,sum));
  def dfo-iq-block-next(data,at,left,grid,signs,part) = dfo-iq-blocks(data,(at + 66),nth(part,1),(left - 1),grid,signs,head(part));
  def dfo-iq-rows(data,cols,row,rows,x,grid,signs,acc) = if ((Comparable) row == rows) then reverse(acc) else dfo-iq-rows(data,cols,(row + 1),rows,x,grid,signs,cons(dfo-iq-blocks(data,((row * (cols / 256)) * 66),x,(cols / 256),grid,signs,0.0),acc));
  def dfo-iq2(r,t,expert,x) {
   let dims = nth(t,1); let cols = head(dims); let rows = nth(dims,1); let stride = ((rows * (cols / 256)) * 66);
   dfo-require((((Comparable) (cols % 256) == 0) && ((Comparable) len(x) == cols)),"IQ2_XXS expert geometry");
   dfo-iq-rows(dfo-bytes(r,(dfo-abs(r,t) + (expert * stride)),stride),cols,0,rows,x,dfo-iq-grid-hex(),dfo-iq-signs(),list());
  }
  def dfo-expert-matrix(r,key,expert,x) {
   let run = record_get(r,"matrix-expert"); run(r,key,expert,x);
  }
  def dfo-ref-expert(r,key,expert,x) {
   let t = dfo-tensor(r,key);
   dfo-require((((Comparable) len(nth(t,1)) == 3) && ((expert >= 0) && (expert < nth(nth(t,1),2)))),"expert outside tensor stack");
   if ((Comparable) head(t) == 40) then dfo-mx4(r,t,expert,x) else if ((Comparable) head(t) == 16) then dfo-iq2(r,t,expert,x) else form_error(str_concat("DSV4 oracle: unsupported expert type for ",key));
  }
  def dfo-round-even(x) {
   let low = floor(x); let part = (x - (1.0 * low));
