   dfo-rope-factor-loop(owner,nrot,(i + 2),(theta * step),step,scale,ext,mscale,low,high,sign,cons(list((nth(pair,1) * mscale),((head(pair) * mscale) * sign)),acc));
  }
  def dfo-rope-pairs(x,factors) = if nil?(factors) then list() else cons(((head(x) * head(head(factors))) - (nth(x,1) * nth(head(factors),1))),cons(((head(x) * nth(head(factors),1)) + (nth(x,1) * head(head(factors)))),dfo-rope-pairs(dnr-drop(x,2),tail(factors))));
  def dfo-rope-heads(x,hd,nrot,factors) = if nil?(x) then list() else dnr-cat(dnr-take(x,(hd - nrot)),dnr-cat(dfo-rope-pairs(dnr-take(dnr-drop(x,(hd - nrot)),nrot),factors),dfo-rope-heads(dnr-drop(x,hd),hd,nrot,factors)));
  def dfo-weighted-streams(x,weights,e,out) = if nil?(weights) then out else dfo-weighted-streams(dnr-drop(x,e),tail(weights),e,dnr-add(out,dnr-scale(dnr-take(x,e),head(weights))));
  def dfo-hc-pre(r,p,kind,resid,g) {
   let n = record_get(g,"hc"); let e = record_get(g,"e"); let stem = str_concat(p,str_concat("hc_",kind));
   let flat = dnr-rms(resid,record_get(g,"eps")); let mix = dfo-f16-matrix(r,str_concat(stem,"_fn.weight"),flat);
   let split = dnr-hc-split(mix,dfo-plain(r,str_concat(stem,"_scale.weight"),0),dfo-plain(r,str_concat(stem,"_base.weight"),0),n,record_get(g,"iterations"),record_get(g,"hc-eps"));
   record_new(0,"flat",flat,"mix",mix,"post",dnr-slice(split,n,n),"comb",dnr-drop(split,(2 * n)),"cur",dfo-weighted-streams(resid,dnr-take(split,n),e,dnr-fill(e,0.0)));
  }
  def dfo-hc-post-weights(comb,n,dst,src) = if ((Comparable) src == n) then list() else cons(nth(comb,(dst + (src * n))),dfo-hc-post-weights(comb,n,dst,(src + 1)));
  def dfo-hc-post-loop(block,resid,post,comb,n,e,dst) = if ((Comparable) dst == n) then list() else dnr-cat(dfo-weighted-streams(resid,dfo-hc-post-weights(comb,n,dst,0),e,dnr-scale(block,nth(post,dst))),dfo-hc-post-loop(block,resid,post,comb,n,e,(dst + 1)));
  def dfo-hc-post(block,resid,pre,g) = dfo-hc-post-loop(block,resid,record_get(pre,"post"),record_get(pre,"comb"),record_get(g,"hc"),record_get(g,"e"),0);
  def dfo-out-a-rows(data,scales,cols,row,end,x,acc) = if ((Comparable) row == end) then reverse(acc) else dfo-out-a-rows(data,scales,cols,(row + 1),end,x,cons(dfo-plane-groups(data,scales,(row * cols),x,(row * (cols / 32)),((row + 1) * (cols / 32)),0.0),acc));
  def dfo-out-a-groups(data,scales,cols,rank,group,groups,x) = if ((Comparable) group == groups) then list() else dnr-cat(dfo-out-a-rows(data,scales,cols,(group * rank),((group + 1) * rank),dnr-take(x,cols),list()),dfo-out-a-groups(data,scales,cols,rank,(group + 1),groups,dnr-drop(x,cols)));
  def dfo-out-a(r,key,x,g) {
   let run = record_get(r,"matrix-out-a"); run(r,key,x,g);
  }
  def dfo-ref-out-a(r,key,x,g) {
   let t = dfo-tensor(r,key); let cols = head(nth(t,1)); let rows = nth(nth(t,1),1); let groups = record_get(g,"ng"); let rank = record_get(g,"rank"); let cells = (cols * rows); let at = dfo-abs(r,t);
   dfo-require((((Comparable) head(t) == 41) && (((Comparable) rows == (groups * rank)) && ((Comparable) len(x) == (groups * cols)))),"grouped output factor geometry");
   let data = dfo-bytes(r,at,cells); let scales = dfo-bytes(r,(at + cells),(cells / 32));
   dfo-out-a-groups(data,scales,cols,rank,0,groups,x);
  }
  def dfo-mla(r,p,x,g,il,pos,history) {
   let rope = dfo-rope-params(r,il); let hd = record_get(g,"hd"); let nrot = record_get(g,"nrot"); let eps = record_get(g,"eps");
   let xn = dnr-rms-weight(x,dfo-plain(r,str_concat(p,"attn_norm.weight"),0),eps);
   let qlatn = dnr-rms-weight(dfo-mx8(r,str_concat(p,"attn_q_a.weight"),xn),dfo-plain(r,str_concat(p,"attn_q_a_norm.weight"),0),eps);
   let qpre = dfo-mx8(r,str_concat(p,"attn_q_b.weight"),qlatn); let qhr = dnr-head-rms(qpre,hd,eps);
   let kvnorm = dnr-rms-weight(dfo-mx8(r,str_concat(p,"attn_kv.weight"),xn),dfo-plain(r,str_concat(p,"attn_kv_a_norm.weight"),0),eps);
   let forward = dfo-rope-factors(rope,nrot,pos,0); let q = dfo-rope-heads(qhr,hd,nrot,forward); let kvroped = dfo-rope-heads(kvnorm,hd,nrot,forward); let kv = dfo-kv-round(kvroped,hd,nrot); let rows = dnr-cat(history,list(kv));
   let attended = dnr-heads(q,rows,hd,(1.0 / math_sqrt((1.0 * hd))),dfo-plain(r,str_concat(p,"attn_sinks.weight"),0));
   let heads = dfo-rope-heads(attended,hd,nrot,dfo-rope-factors(rope,nrot,pos,1)); let low = dfo-out-a(r,str_concat(p,"attn_output_a.weight"),heads,g); let out = dfo-mx8(r,str_concat(p,"attn_output_b.weight"),low);
   record_new(0,"xn",xn,"qlatn",qlatn,"q_preheadrms",qpre,"q_headrms",qhr,"q",q,"kv_norm",kvnorm,"kv_roped",kvroped,"kv",kv,"heads_attn",attended,"heads",heads,"low",low,"attn_out",out,"rope",rope,"history",rows);
  }
  def dfo-log1p(x) = if ((Comparable) (1.0 + x) == 1.0) then x else (math_log((1.0 + x)) * (x / ((1.0 + x) - 1.0)));
  def dfo-softplus(x) = if (x > 20.0) then x else if (x < -20.0) then math_exp(x) else dfo-log1p(math_exp(x));
  def dfo-probs(x) = if nil?(x) then list() else cons(math_sqrt(dfo-softplus(head(x))),dfo-probs(tail(x)));
  def dfo-i32-values(bytes,i,n,acc) = if ((Comparable) i == n) then reverse(acc) else dfo-i32-values(bytes,(i + 1),n,cons(dfo-signed(dfo-le(bytes,(i * 4),4),32),acc));
  def dfo-i32-row(r,key,row) {
   let t = dfo-tensor(r,key); let dims = nth(t,1); let n = head(dims);
   dfo-require((((Comparable) head(t) == 26) && (((Comparable) len(dims) == 2) && ((row >= 0) && (row < nth(dims,1))))),"hash routing I32 row geometry");
   dfo-i32-values(dfo-bytes(r,(dfo-abs(r,t) + ((row * n) * 4)),(n * 4)),0,n,list());
  }
  def dfo-ids-valid(ids,limit) = if nil?(ids) then 1 else (((head(ids) >= 0) && (head(ids) < limit)) && dfo-ids-valid(tail(ids),limit));
  def dfo-route(r,p,probs,token) {
   let used = dfo-meta(r,"deepseek4.expert_used_count"); let hashed = record_has(record_get(r,"tensors"),str_concat(p,"ffn_gate_tid2eid.weight"));
   let ids = if hashed then dfo-i32-row(r,str_concat(p,"ffn_gate_tid2eid.weight"),token) else dnr-top(dnr-add(probs,dfo-plain(r,str_concat(p,"exp_probs_b.bias"),0)),used);
   let count = nth(nth(dfo-tensor(r,str_concat(p,"ffn_gate_exps.weight")),1),2);
   dfo-require((((Comparable) len(ids) == used) && (dfo-ids-valid(ids,count) && dfo-ids-valid(ids,len(probs)))),"router selected an unavailable expert");
   let raw = dnr-gather(probs,ids); let weights = dnr-router-weights(raw,dfo-max(dnr-sum(raw),0.00006103515625),dfo-meta(r,"deepseek4.expert_weights_scale"));
   record_new(0,"selected",ids,"expert_w",weights,"regime",if hashed then "hash" else "topk","n_exp_stack",count);
  }
  def dfo-experts(r,p,x,ids,weights,limit,out,rows) = if nil?(ids) then list(out,reverse(rows)) else dfo-expert-next(r,p,x,ids,weights,limit,out,rows);
  def dfo-expert-next(r,p,x,ids,weights,limit,out,rows) {
   let expert = head(ids); let gate = dfo-expert-matrix(r,str_concat(p,"ffn_gate_exps.weight"),expert,x); let up = dfo-expert-matrix(r,str_concat(p,"ffn_up_exps.weight"),expert,x);
   let mid = dnr-mid(gate,up,head(weights),limit); let down = dfo-expert-matrix(r,str_concat(p,"ffn_down_exps.weight"),expert,mid);
   dfo-experts(r,p,x,tail(ids),tail(weights),limit,dnr-add(out,down),cons(list(expert,gate,up,mid,down),rows));
  }
  def dfo-ffn(r,p,resid,g,token,il) {
   let limits = dfo-meta(r,"deepseek4.swiglu_clamp_exp"); dfo-require((il < len(limits)),"layer missing SwiGLU clamp"); let limit = nth(limits,il);
   let pre = dfo-hc-pre(r,p,"ffn",resid,g); let norm = dnr-rms-weight(record_get(pre,"cur"),dfo-plain(r,str_concat(p,"ffn_norm.weight"),0),record_get(g,"eps"));
   let logits = dfo-f16-matrix(r,str_concat(p,"ffn_gate_inp.weight"),norm); let probs = dfo-probs(logits); let route = dfo-route(r,p,probs,token);
   let experts = dfo-experts(r,p,norm,record_get(route,"selected"),record_get(route,"expert_w"),limit,dnr-fill(record_get(g,"e"),0.0),list());
   let sg = dfo-mx8(r,str_concat(p,"ffn_gate_shexp.weight"),norm); let su = dfo-mx8(r,str_concat(p,"ffn_up_shexp.weight"),norm); let smid = dnr-mid(sg,su,1.0,limit); let shared = dfo-mx8(r,str_concat(p,"ffn_down_shexp.weight"),smid); let ffn = dnr-add(head(experts),shared); let out = dfo-hc-post(ffn,resid,pre,g);
   record_new(0,"ffn_flat",record_get(pre,"flat"),"ffn_mix",record_get(pre,"mix"),"ffn_post_w",record_get(pre,"post"),"ffn_comb",record_get(pre,"comb"),"ffn_cur",record_get(pre,"cur"),"ffn_norm",norm,"router_logits",logits,"router_probs",probs,"selected",record_get(route,"selected"),"expert_w",record_get(route,"expert_w"),"regime",record_get(route,"regime"),"n_exp_stack",record_get(route,"n_exp_stack"),"clamp",limit,"moe",head(experts),"per_expert",nth(experts,1),"shared",shared,"sh_gate",sg,"sh_up",su,"sh_mid",smid,"ffn_out",ffn,"out_hc",out);
  }
  def dfo-attention-half(r,p,resid,g,il,pos,history) {
   let pre = dfo-hc-pre(r,p,"attn",resid,g); let mla = dfo-mla(r,p,record_get(pre,"cur"),g,il,pos,history);
   record_set(mla,"hc_flat",record_get(pre,"flat")); record_set(mla,"hc_mix",record_get(pre,"mix")); record_set(mla,"hc_post_w",record_get(pre,"post")); record_set(mla,"hc_comb",record_get(pre,"comb")); record_set(mla,"hc_cur",record_get(pre,"cur")); record_set(mla,"hc_resid",resid); record_set(mla,"after_attn_hc",dfo-hc-post(record_get(mla,"attn_out"),resid,pre,g)); mla;
  }
 }
 0;
}
