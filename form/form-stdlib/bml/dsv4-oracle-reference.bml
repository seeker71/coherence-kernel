// Independent GGUF, quantization and fp64 reference recipes.
// Recipe source: ds4-engine/ds4.c; no production MLA/HC/MoE recipe imports.
// preludes: form-stdlib/core.fk form-stdlib/bml/formbin-codec.bml form-stdlib/bml/dsv4-numeric-reference.bml form/form-stdlib/bml/dsv4-oracle-tables.bml form/form-stdlib/bml/dsv4-oracle-angle.bml
section [form.bml] {
 class Dsv4FileOracle {
  def dfo-require(ok,reason) = if ok then 1 else form_error(str_concat("DSV4 oracle: ",reason));
  def dfo-min(a,b) = if (a < b) then a else b;
  def dfo-max(a,b) = if (a > b) then a else b;
  def dfo-natural(n) = (((String) value_kind(n) == "int") && (n >= 0));
  def dfo-positive(n) = (dfo-natural(n) && (n > 0));
  def dfo-product(a,b) = if (!(dfo-natural(a) && dfo-natural(b))) then nothing() else if ((Comparable) a == 0) then 0 else if (b > (4611686018427387903 / a)) then nothing() else (a * b);
  def dfo-sum(a,b) = if (!(dfo-natural(a) && dfo-natural(b))) then nothing() else if (b > (4611686018427387903 - a)) then nothing() else (a + b);
  def dfo-size(n) {
   dfo-require((!nothing?(n)),"inexact or overflowing extent"); n;
  }
  def dfo-positive-dims(xs) = if nil?(xs) then 1 else (dfo-positive(head(xs)) && dfo-positive-dims(tail(xs)));
  def dfo-dim-cells(xs,n) = if nil?(xs) then n else dfo-dim-cells(tail(xs),dfo-size(dfo-product(n,head(xs))));
  def dfo-pow-positive(x,n,acc) = if ((Comparable) n == 0) then acc else dfo-pow-positive((x * x),(n / 2),if ((Comparable) (n % 2) == 1) then (acc * x) else acc);
  def dfo-pow2(n) = if (n < 0) then dfo-pow-positive(0.5,(0 - n),1.0) else dfo-pow-positive(2.0,n,1.0);
  def dfo-reader(path) {
   let size = file_size(path);
   dfo-require((size >= 24),"missing or truncated GGUF header");
   record_new(0,"path",path,"extent",size,"start",0,"bytes","","meta",record_new(0),"tensors",record_new(0),"tensor-names",list(),"matrix-mx8",dfo-ref-mx8,"matrix-f16",dfo-ref-f16,"matrix-expert",dfo-ref-expert,"matrix-out-a",dfo-ref-out-a);
  }
  def dfo-span(r,at,n) {
   dfo-require((dfo-natural(at) && (dfo-natural(n) && ((at <= record_get(r,"extent")) && (n <= (record_get(r,"extent") - at))))),"file span exceeds observed extent");
   if ((at >= record_get(r,"start")) && ((at + n) <= (record_get(r,"start") + str_len(record_get(r,"bytes"))))) then record_get(r,"bytes")
   else dfo-window(r,at,n);
  }
  def dfo-window(r,at,n) {
   let extent = record_get(r,"extent");
   let amount = dfo-min((extent - at),dfo-max(n,65536));
   let bytes = read_file_slice(record_get(r,"path"),at,amount);
   dfo-require((((Comparable) file_size(record_get(r,"path")) == extent) && ((!nothing?(bytes)) && ((Comparable) str_len(bytes) == amount))),"incomplete or changed file read");
   record_set(r,"start",at); record_set(r,"bytes",bytes); bytes;
  }
  def dfo-bytes(r,at,n) {
   let src = dfo-span(r,at,n); let local = (at - record_get(r,"start")); substring(src,local,(local + n));
  }
  def dfo-le(src,at,n) = if ((Comparable) n == 0) then 0 else (str_byte_at(src,at) + (256 * dfo-le(src,(at + 1),(n - 1))));
  def dfo-uint(r,at,n) {
   let src = dfo-span(r,at,n); let local = (at - record_get(r,"start")); if ((Comparable) n == 8) then dfo-require((str_byte_at(src,(local + 7)) < 64),"unsigned extent exceeds native exact integer domain") else 1; dfo-le(src,local,n);
  }
  def dfo-string-end(r,at) {
   let size = dfo-uint(r,at,8); dfo-require((size <= (record_get(r,"extent") - (at + 8))),"truncated string extent"); ((at + 8) + size);
  }
  def dfo-string(r,at) {
   let end = dfo-string-end(r,at); let value = dfo-bytes(r,(at + 8),(end - (at + 8))); dfo-require(fbc-utf8(value,0),"invalid UTF8 name"); value;
  }
  def dfo-width(t) = if (((Comparable) t == 0) || (((Comparable) t == 1) || ((Comparable) t == 7))) then 1 else if (((Comparable) t == 2) || ((Comparable) t == 3)) then 2 else if (((Comparable) t == 4) || (((Comparable) t == 5) || ((Comparable) t == 6))) then 4 else if (((Comparable) t == 10) || (((Comparable) t == 11) || ((Comparable) t == 12))) then 8 else 0;
  def dfo-value-end(r,at,t) = if ((Comparable) t == 8) then dfo-string-end(r,at) else if ((Comparable) t == 9) then dfo-array-end(r,(at + 12),dfo-uint(r,at,4),dfo-uint(r,(at + 4),8)) else dfo-fixed-end(r,at,dfo-width(t),1);
  def dfo-fixed-end(r,at,width,count) {
   dfo-require((width > 0),"unknown GGUF metadata value type"); dfo-require((count <= ((record_get(r,"extent") - at) / width)),"truncated metadata extent"); (at + (width * count));
  }
  def dfo-array-end(r,at,t,count) = if (dfo-width(t) > 0) then dfo-fixed-end(r,at,dfo-width(t),count) else if (!(((Comparable) t == 8) || ((Comparable) t == 9))) then form_error("unknown GGUF array value type") else if ((Comparable) count == 0) then at else dfo-array-end(r,dfo-value-end(r,at,t),t,(count - 1));
  def dfo-metadata(r,at,left) = if ((Comparable) left == 0) then at else dfo-metadata-next(r,at,left);
  def dfo-metadata-next(r,at,left) {
    let key = dfo-string(r,at); let next = dfo-string-end(r,at); let t = dfo-uint(r,next,4); let value = (next + 4); let end = dfo-value-end(r,value,t);
    dfo-require((!record_has(record_get(r,"meta"),key)),"duplicate metadata key");
    record_set(record_get(r,"meta"),key,list(t,value,end));
    dfo-metadata(r,end,(left - 1));
  }
  def dfo-dims(r,at,n,acc) = if ((Comparable) n == 0) then reverse(acc) else dfo-dim-next(r,at,n,acc,dfo-uint(r,at,8));
  def dfo-dim-next(r,at,n,acc,value) {
   dfo-require(dfo-positive(value),"tensor dimension must be an exact positive integer"); dfo-dims(r,(at + 8),(n - 1),cons(value,acc));
  }
  def dfo-tensor-table(r,at,left) = if ((Comparable) left == 0) then at else dfo-tensor-next(r,at,left);
  def dfo-tensor-next(r,at,left) {
    let key = dfo-string(r,at); let next = dfo-string-end(r,at); let nd = dfo-uint(r,next,4); let start = (next + 4);
    dfo-require(((nd > 0) && (nd <= ((record_get(r,"extent") - start) / 8))),"invalid tensor dimension extent");
    let dims = dfo-dims(r,start,nd,list()); let cells = dfo-dim-cells(dims,1); let tt = dfo-size(dfo-sum(start,dfo-product(nd,8))); let ty = dfo-uint(r,tt,4); let rel = dfo-uint(r,(tt + 4),8);
    dfo-require((!record_has(record_get(r,"tensors"),key)),"duplicate tensor name");
    record_set(record_get(r,"tensors"),key,list(ty,dims,rel));
    record_set(r,"tensor-names",cons(key,record_get(r,"tensor-names")));
    dfo-tensor-table(r,(tt + 12),(left - 1));
  }
  def dfo-open(path) {
   let r = dfo-reader(path);
   dfo-require(((String) dfo-bytes(r,0,4) == "GGUF"),"bad GGUF magic");
   dfo-require(((Comparable) dfo-uint(r,4,4) == 3),"GGUF version must be3");
   let nt = dfo-uint(r,8,8); let nk = dfo-uint(r,16,8);
   let ti = dfo-metadata(r,24,nk); let end = dfo-tensor-table(r,ti,nt);
   let alignment = if record_has(record_get(r,"meta"),"general.alignment") then dfo-meta(r,"general.alignment") else 32;
   dfo-require((dfo-positive(alignment) && (dfo-metadata-kind(r,"general.alignment","integer") && (alignment <= (record_get(r,"extent") - end)))),"invalid GGUF alignment");
   record_set(r,"data",((dfo-size(dfo-sum(end,(alignment - 1))) / alignment) * alignment)); record_set(r,"tensor-count",nt); record_set(r,"metadata-count",nk); record_set(r,"tensor-names",reverse(record_get(r,"tensor-names"))); r;
  }
  def dfo-float-fields(sign,exponent,mantissa,bias,mantBits,maxExp) = (sign * (if ((Comparable) exponent == 0) then ((1.0 * mantissa) * dfo-pow2(((1 - bias) - mantBits))) else if ((Comparable) exponent == maxExp) then if ((Comparable) mantissa == 0) then (1.0 / 0.0) else (0.0 / 0.0) else ((1.0 + ((1.0 * mantissa) / dfo-pow2(mantBits))) * dfo-pow2((exponent - bias)))));
  def dfo-f16(bits) = dfo-float-fields(if (bits >= 32768) then -1.0 else 1.0,((bits / 1024) % 32),(bits % 1024),15,10,31);
  def dfo-f32(bits) = dfo-float-fields(if (bits >= 2147483648) then -1.0 else 1.0,((bits / 8388608) % 256),(bits % 8388608),127,23,255);
  def dfo-f64(src) {
   let lo = dfo-le(src,0,4); let hi = dfo-le(src,4,4); dfo-float-fields(if (hi >= 2147483648) then -1.0 else 1.0,((hi / 1048576) % 2048),(lo + ((hi % 1048576) * 4294967296)),1023,52,2047);
  }
  def dfo-signed(value,bits) = if (value >= dfo-pow2((bits - 1))) then (value - trunc(dfo-pow2(bits))) else value;
  def dfo-value(r,at,t) = if ((Comparable) t == 8) then dfo-string(r,at) else if ((Comparable) t == 9) then dfo-array(r,(at + 12),dfo-uint(r,at,4),dfo-uint(r,(at + 4),8),list()) else if ((Comparable) t == 6) then dfo-f32(dfo-uint(r,at,4)) else if ((Comparable) t == 12) then dfo-f64(dfo-bytes(r,at,8)) else if (((Comparable) t == 10) || ((Comparable) t == 11)) then dfo-wide64(dfo-bytes(r,at,8),((Comparable) t == 11)) else if (((Comparable) t == 1) || (((Comparable) t == 3) || ((Comparable) t == 5))) then dfo-signed(dfo-uint(r,at,dfo-width(t)),(8 * dfo-width(t))) else dfo-uint(r,at,dfo-width(t));
  def dfo-wide64(raw,signed) {
   let lo = dfo-le(raw,0,4); let hi = dfo-le(raw,4,4);
   if (hi < 1073741824) then (lo + (hi * 4294967296)) else if (signed && (hi >= 3221225472)) then (lo + ((hi - 4294967296) * 4294967296)) else record_new(0,"kind",if signed then "gguf-i64" else "gguf-u64","raw",raw,"lo",lo,"hi",hi);
  }
  def dfo-array(r,at,t,n,acc) = if ((Comparable) n == 0) then reverse(acc) else dfo-array(r,dfo-value-end(r,at,t),t,(n - 1),cons(dfo-value(r,at,t),acc));
  def dfo-meta(r,key) {
   dfo-require(record_has(record_get(r,"meta"),key),str_concat("missing metadata: ",key)); let row = record_get(record_get(r,"meta"),key); dfo-value(r,nth(row,1),head(row));
  }
  def dfo-tensor(r,key) {
   dfo-require(record_has(record_get(r,"tensors"),key),str_concat("missing tensor: ",key)); record_get(record_get(r,"tensors"),key);
  }
  def dfo-abs(r,tensor) = dfo-size(dfo-sum(record_get(r,"data"),nth(tensor,2)));
  def dfo-floats(src,ty,i,n,acc) = if ((Comparable) i == n) then reverse(acc) else dfo-floats(src,ty,(i + 1),n,cons(if ((Comparable) ty == 1) then dfo-f16(dfo-le(src,(i * 2),2)) else dfo-f32(dfo-le(src,(i * 4),4)),acc));
  def dfo-plain(r,key,row) {
   let t = dfo-tensor(r,key); let ty = head(t); let width = head(nth(t,1)); let size = if ((Comparable) ty == 1) then 2 else 4;
   dfo-require(((((Comparable) ty == 0) || ((Comparable) ty == 1)) && ((len(nth(t,1)) <= 2) && (((String) value_kind(row) == "int") && ((row >= 0) && (row < (if ((Comparable) len(nth(t,1)) == 1) then 1 else nth(nth(t,1),1))))))),"plain tensor type or row extent");
   dfo-require(dfo-positive-dims(nth(t,1)),"plain tensor dimensions"); let stride = dfo-size(dfo-product(width,size));
   dfo-floats(dfo-bytes(r,dfo-size(dfo-sum(dfo-abs(r,t),dfo-product(row,stride))),stride),ty,0,width,list());
  }
  def dfo-e4m3(b) {
   let a = (b % 128); let e = (a / 8); let m = (a % 8); ((if (b >= 128) then -1.0 else 1.0) * (if ((Comparable) e == 0) then (m * 0.001953125) else ((1.0 + (m * 0.125)) * dfo-pow2((e - 7)))));
  }
  def dfo-mx8-group(data,at,x,left,sum) = if ((Comparable) left == 0) then list(sum,x) else dfo-mx8-group(data,(at + 1),tail(x),(left - 1),(sum + (dfo-e4m3(str_byte_at(data,at)) * head(x))));
  def dfo-mx8-groups(data,scales,at,x,group,n,sum) = if ((Comparable) group == n) then sum else dfo-mx8-next(data,scales,at,group,n,sum,dfo-mx8-group(data,at,x,32,0.0));
  def dfo-mx8-next(data,scales,at,group,n,sum,part) = dfo-mx8-groups(data,scales,(at + 32),nth(part,1),(group + 1),n,(sum + (head(part) * dfo-pow2((str_byte_at(scales,group) - 127)))));
  def dfo-mx8-row(r,key,row,x) {
   let t = dfo-tensor(r,key); let dims = nth(t,1); let cols = head(dims); let rows = nth(dims,1); let at = dfo-abs(r,t);
   dfo-require((((Comparable) head(t) == 41) && (((Comparable) (cols % 32) == 0) && (((Comparable) len(x) == cols) && ((row >= 0) && (row < rows))))),"MXFP8 row geometry mismatch");
   let data = dfo-bytes(r,(at + (row * cols)),cols); let scales = dfo-bytes(r,((at + (rows * cols)) + (row * (cols / 32))),(cols / 32));
   dfo-mx8-groups(data,scales,0,x,0,(cols / 32),0.0);
  }
  // Matrices hold their two complete planes once. Row traversal never reloads
  // overlapping windows or reconstructs a dequantized matrix.
  def dfo-plane-groups(data,scales,at,x,group,end,sum) = if ((Comparable) group == end) then sum else dfo-plane-next(data,scales,at,group,end,sum,dfo-mx8-group(data,at,x,32,0.0));
  def dfo-plane-next(data,scales,at,group,end,sum,part) = dfo-plane-groups(data,scales,(at + 32),nth(part,1),(group + 1),end,(sum + (head(part) * dfo-pow2((str_byte_at(scales,group) - 127)))));
  def dfo-mx8-rows(data,scales,cols,row,rows,x,acc) = if ((Comparable) row == rows) then reverse(acc) else dfo-mx8-rows(data,scales,cols,(row + 1),rows,x,cons(dfo-plane-groups(data,scales,(row * cols),x,(row * (cols / 32)),((row + 1) * (cols / 32)),0.0),acc));
  def dfo-mx8(r,key,x) {
   let run = record_get(r,"matrix-mx8"); run(r,key,x);
  }
  def dfo-ref-mx8(r,key,x) {
   let t = dfo-tensor(r,key); let dims = nth(t,1); let cols = head(dims); let rows = nth(dims,1); let at = dfo-abs(r,t); let cells = (rows * cols);
   dfo-require((((Comparable) head(t) == 41) && (((Comparable) (cols % 32) == 0) && ((Comparable) len(x) == cols))),str_concat("MXFP8 matrix geometry: ",key));
   let data = dfo-bytes(r,at,cells); let scales = dfo-bytes(r,(at + cells),(cells / 32));
   dfo-mx8-rows(data,scales,cols,0,rows,x,list());
  }
  def dfo-f16-dot(src,at,x,sum) = if nil?(x) then sum else dfo-f16-dot(src,(at + 2),tail(x),(sum + (dfo-f16(dfo-le(src,at,2)) * head(x))));
  def dfo-f16-rows(src,cols,row,rows,x,acc) = if ((Comparable) row == rows) then reverse(acc) else dfo-f16-rows(src,cols,(row + 1),rows,x,cons(dfo-f16-dot(src,((row * cols) * 2),x,0.0),acc));
  def dfo-f16-matrix(r,key,x) {
   let run = record_get(r,"matrix-f16"); run(r,key,x);
  }
  def dfo-ref-f16(r,key,x) {
   let t = dfo-tensor(r,key); let dims = nth(t,1); let cols = head(dims); let rows = nth(dims,1);
   dfo-require((((Comparable) head(t) == 1) && ((Comparable) len(x) == cols)),str_concat("F16 matrix geometry: ",key));
   dfo-f16-rows(dfo-bytes(r,dfo-abs(r,t),((cols * rows) * 2)),cols,0,rows,x,list());
  }
  def dfo-e2m1(b) {
   let e = ((b / 2) % 4); let m = (b % 2);
   ((if (b >= 8) then -1.0 else 1.0) * (if ((Comparable) e == 0) then (m * 0.5) else (dfo-pow2((e - 1)) * (1.0 + (m * 0.5)))));
  }
  def dfo-mx4-group(data,at,x,left,even,odd) = if ((Comparable) left == 0) then list((even + odd),x) else dfo-mx4-group(data,(at + 1),tail(tail(x)),(left - 1),(even + (dfo-e2m1((str_byte_at(data,at) % 16)) * head(x))),(odd + (dfo-e2m1((str_byte_at(data,at) / 16)) * nth(x,1))));
  def dfo-mx4-groups(data,scales,at,x,group,end,sum) = if ((Comparable) group == end) then sum else dfo-mx4-next(data,scales,at,group,end,sum,dfo-mx4-group(data,at,x,16,0.0,0.0));
  def dfo-mx4-next(data,scales,at,group,end,sum,part) = dfo-mx4-groups(data,scales,(at + 16),nth(part,1),(group + 1),end,(sum + (head(part) * dfo-pow2((str_byte_at(scales,group) - 127)))));
  def dfo-mx4-rows(data,scales,cols,row,rows,x,acc) = if ((Comparable) row == rows) then reverse(acc) else dfo-mx4-rows(data,scales,cols,(row + 1),rows,x,cons(dfo-mx4-groups(data,scales,(row * (cols / 2)),x,(row * (cols / 32)),((row + 1) * (cols / 32)),0.0),acc));
  def dfo-mx4(r,t,expert,x) {
   let dims = nth(t,1); let cols = head(dims); let rows = nth(dims,1); let cells = (rows * cols); let stride = ((cells / 2) + (cells / 32)); let at = (dfo-abs(r,t) + (expert * stride));
