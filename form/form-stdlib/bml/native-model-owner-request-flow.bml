package Form.model.ownerrequestflow;

import Form.kernel.*;
import Form.model.tokenflow.*;

interface INativeModelOwnerRequestFlow [public, witness, physical, interactive] {
   section [public] {
      const String Schema = "native-model-owner-request-flow-v1";
      const String RequestRule = "the form-cli model-flow verb discovers and exactly binds the standing dual-model owner, publishes its metadata-only request before atomically offering qwen-step, then polls the owner publication at 250ms until physical token position advances or sixty seconds expires";
      const String EvidenceRule = "request, token position, owner snapshot, and Glass receipt are physical-live; layer boundary, tensor extent, expert-router execution, Metal handle, and duration are explicitly derived from the owner command window plus the same Form graph and tensor ledger used by evaluation; the measured duration is named owner-command.position-window and never mislabeled as device-only pipeline time";
      const String PrivacyRule = "the flow carries ids, positions, extents, stages, handles, duration, and evidence only; prompt and decoded token bytes never cross the telemetry membrane";
      const String CadenceRule = "the active request is published before command offer; after owner completion the eight-stage chain is published atomically with completed lifecycle, preserving per-event epochs without artificial sleeps or post-completion animation";
      const String CategoryRule = "every event preserves the producer CELL id and physically carries category 1.2.99.1703, family 1.2.99, explicit cell role, and stage type across the membrane";
      const String ResidentRule = "the request touches the resident Qwen context in place and never releases or reloads Qwen or the parallel 3B context";
      const String SelectionRule = "model-flow is the explicit reasoning-lane observation verb: exact current-owner binding plus the canonical Qwen model and token-position ids select Qwen; absence or ambiguity refuses before command publication";

      Object Run( String exactOwnerPublisher ) [abstract];
      Object RunCurrent() [abstract];
   }
}

class NativeModelOwnerRequestFlow [public, resident, observable] : INativeModelOwnerRequestFlow {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-owner-request-flow.bml";
      Object Run( String exactOwnerPublisher ) [abstract] {}
      Object RunCurrent() [abstract] {}
   }
}
