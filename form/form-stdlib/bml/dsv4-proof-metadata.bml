// Complete checked GGUF metadata with the existing manifest stream contract.
// preludes: form-stdlib/gguf-manifest.fk form/form-stdlib/bml/dsv4-oracle-execution.bml
section [form.bml] {
 class Dsv4ProofMetadata {
  def dsm-block(t) = if (((Comparable) t == 8) || (((Comparable) t == 20) || (((Comparable) t == 40) || ((Comparable) t == 41)))) then 32 else if (((Comparable) t == 10) || (((Comparable) t == 12) || (((Comparable) t == 13) || (((Comparable) t == 14) || (((Comparable) t == 16) || (((Comparable) t == 17) || (((Comparable) t == 18) || ((Comparable) t == 23)))))))) then 256 else 1;
  def dsm-dim(dims,at) = if (at < len(dims)) then nth(dims,at) else 1;
  def dsm-shape(r,names) = if nil?(names) then 1 else dsm-tensor(r,names,dfo-tensor(r,head(names)));
  def dsm-tensor(r,names,t) {
   let dims = nth(t,1); let ty = head(t); dfo-require((len(dims) <= 4),"manifest supports up to four tensor dimensions");
   let nel = dfo-size(dfo-product(head(dims),dsm-dim(dims,1))); let slices = dfo-size(dfo-product(dsm-dim(dims,2),dsm-dim(dims,3)));
   dfo-require(gm-priced?(ty),"unpriced tensor type"); let block = dsm-block(ty);
   dfo-require(((Comparable) (nel % block) == 0),"incomplete priced tensor block");
   let perSlice = dfo-size(dfo-product((nel / block),gm-slice-bytes(ty,block))); let bytes = dfo-size(dfo-product(slices,perSlice)); let absolute = dfo-abs(r,t);
   dfo-require(((absolute <= record_get(r,"extent")) && (bytes <= (record_get(r,"extent") - absolute))),"manifest tensor exceeds complete file extent");
   dsm-shape(r,tail(names));
  }
  def dsm-open(path) {
   let r = dfo-reader(path); dfo-require(((String) dfo-bytes(r,0,4) == "GGUF"),"bad GGUF magic"); dfo-require(((Comparable) dfo-uint(r,4,4) == 3),"GGUF version must be3");
   let nt = dfo-uint(r,8,8); let nk = dfo-uint(r,16,8); let extent = record_get(r,"extent");
   dfo-require(((nt <= ((extent - 24) / 32)) && (nk <= ((extent - 24) / 13))),"GGUF count exceeds minimum complete rows");
   let ti = dfo-metadata(r,24,nk); let end = dfo-tensor-table(r,ti,nt);
   let alignment = if record_has(record_get(r,"meta"),"general.alignment") then dfo-meta(r,"general.alignment") else gm-alignment();
   dfo-require((dfo-positive(alignment) && dfo-metadata-kind(r,"general.alignment","integer")),"invalid GGUF alignment");
   let base = dfo-size(dfo-product((dfo-size(dfo-sum(end,(alignment - 1))) / alignment),alignment)); dfo-require((base <= extent),"incomplete GGUF header padding");
   record_set(r,"data",base); record_set(r,"tensor-names",reverse(record_get(r,"tensor-names"))); record_set(r,"tensor-count",nt); record_set(r,"metadata-count",nk); record_set(r,"tinfo-start",ti); record_set(r,"tinfo-end",end);
   dsm-shape(r,record_get(r,"tensor-names"));
   let header = dfo-bytes(r,0,end); dfo-require((((Comparable) str_len(header) == end) && ((Comparable) file_size(path) == extent)),"complete saved header and stable extent"); dsm-snapshot(r,header,nt,nk,ti,end,base);
  }
  def dsm-snapshot(r,header,nt,nk,ti,end,base) {
   let extent = record_get(r,"extent"); record_set(r,"bytes",header); record_set(r,"start",0); record_set(r,"extent",end); record_set(r,"meta",record_new(0)); record_set(r,"tensors",record_new(0)); record_set(r,"tensor-names",list());
   dfo-require((((String) dfo-bytes(r,0,4) == "GGUF") && (((Comparable) dfo-uint(r,4,4) == 3) && (((Comparable) dfo-uint(r,8,8) == nt) && ((Comparable) dfo-uint(r,16,8) == nk)))),"saved header identity changed");
   let savedTi = dfo-metadata(r,24,nk); let savedEnd = dfo-tensor-table(r,savedTi,nt);
   dfo-require((((Comparable) savedTi == ti) && ((Comparable) savedEnd == end)),"saved header directory extent changed");
   let alignment = if record_has(record_get(r,"meta"),"general.alignment") then dfo-meta(r,"general.alignment") else gm-alignment();
   dfo-require((dfo-positive(alignment) && dfo-metadata-kind(r,"general.alignment","integer")),"saved header alignment type");
   dfo-require(((Comparable) dfo-size(dfo-product((dfo-size(dfo-sum(end,(alignment - 1))) / alignment),alignment)) == base),"saved header alignment changed");
   record_set(r,"extent",extent); record_set(r,"tensor-names",reverse(record_get(r,"tensor-names"))); dsm-shape(r,record_get(r,"tensor-names")); record_set(r,"header",header); r;
  }
  // Two 32-bit limbs retain the complete unsigned wire magnitude, including
  // signed metadata whose manifest representation explicitly carries `u`.
  def dsm-u64(hi,lo,out) = if (((Comparable) hi == 0) && ((Comparable) lo == 0)) then if ((String) out == "") then "0" else out else dsm-u64-step(hi,(((hi % 10) * 4294967296) + lo),out);
  def dsm-u64-step(hi,low,out) = dsm-u64((hi / 10),(low / 10),str_concat(byte_to_str((48 + (low % 10))),out));
  def dsm-unsigned(src,at,width) = if ((Comparable) width == 8) then dsm-u64(dfo-le(src,(at + 4),4),dfo-le(src,at,4),"") else int_to_str(dfo-le(src,at,width));
  def dsm-line-bytes(text,at,token) = if ((Comparable) at == str_len(text)) then 1 else if (((Comparable) str_byte_at(text,at) == 0) || (((Comparable) str_byte_at(text,at) == 10) || (((Comparable) str_byte_at(text,at) == 13) || (token && ((str_byte_at(text,at) <= 32) || ((Comparable) str_byte_at(text,at) == 127)))))) then 0 else dsm-line-bytes(text,(at + 1),token);
  def dsm-line-field(text,token) {
   dfo-require((fbc-utf8(text,0) && (((!token) || (str_len(text) > 0)) && dsm-line-bytes(text,0,token))),"metadata field cannot be represented by the complete line stream"); text;
  }
  def dsm-float(v) {
   dfo-require(dfo-finite(v),"nonfinite manifest numeric value"); if ((Comparable) v == 0.0) then if ((1.0 / v) < 0.0) then "-0" else "0" else dsm-float-exact(v,jpf-exact(abs(v)));
  }
  def dsm-float-exact(v,exact) = str_concat(if (v < 0.0) then "-" else "",dsm-shortest(abs(v),head(exact),nth(exact,1),1));
  def dsm-shortest(v,digits,e,n) = dsm-shortest-pair(v,digits,e,n,jpf-round(digits,n,e));
  def dsm-shortest-pair(v,digits,e,n,pair) = if ((Comparable) str_to_float(jpf-render(head(pair),nth(pair,1))) == v) then dsm-float-layout(head(pair),nth(pair,1)) else if (n < 17) then dsm-shortest(v,digits,e,(n + 1)) else form_error("shortest manifest float unavailable");
  def dsm-float-layout(digits,e) = if ((e < -4) || (e >= 6)) then dsm-exponent(fstr-trim-trailing-zeros(digits),e) else jpf-render(digits,e);
  def dsm-exponent(digits,e) = str_concat(substring(digits,0,1),str_concat(if (str_len(digits) > 1) then str_concat(".",substring(digits,1,str_len(digits))) else "",str_concat("e",str_concat(if (e < 0) then "-" else "+",fstr-pad-left(int_to_str(abs(e)),2)))));
  def dsm-string-value(text) {
   dfo-require(fbc-utf8(text,0),"invalid UTF8 metadata string"); if dsm-line-bytes(text,0,0) then str_concat("  KVSTR ",text) else str_concat("  KVSTRJSON ",json-quote-string(text));
  }
  def dsm-kv-value(src,off) {
   let t = gmt-vtype(src,off); let at = gmt-valoff(src,off);
   if ((Comparable) gm-intish?(t) == 1) then str_concat("  KVINT u ",dsm-unsigned(src,at,egg-vtype-size(t))) else if ((Comparable) t == 9) then str_concat("  KVARR ",str_concat(int_to_str(gmt-arr-etype(src,off)),str_concat(" ",int_to_str(gmt-arr-count(src,off))))) else if ((Comparable) t == 8) then dsm-string-value(substring(src,(at + 8),((at + 8) + egg-u64(src,at)))) else if ((Comparable) t == 6) then str_concat("  KVF32\n",dsm-float(dfo-f32(dfo-le(src,at,4)))) else if ((Comparable) t == 12) then str_concat("  KVF64\n",dsm-float(dfo-f64(substring(src,at,(at + 8))))) else form_error("unsupported manifest scalar type");
  }
  def dsm-kvs(src,at,left,index,bins) = if ((Comparable) left == 0) then fbc-finish(bins,"") else dsm-kv-next(src,at,left,index,bins);
  def dsm-kv-next(src,at,left,index,bins) {
   dsm-line-field(gm-key(src,at),1); let row = str_concat(gm-kv-head(src,at,index),str_concat("\n",str_concat(dsm-kv-value(src,at),"\n"))); dsm-kvs(src,egg-kv-next(src,at),(left - 1),(index + 1),fbc-put(bins,row));
  }
  def dsm-ints(values) = if nil?(values) then "" else str_concat(int_to_str(head(values)),if nil?(tail(values)) then "" else str_concat(" ",dsm-ints(tail(values))));
  def dsm-trows(r,names,bins) = if nil?(names) then fbc-finish(bins,"") else dsm-trow(r,head(names),tail(names),bins);
  def dsm-trow(r,name,rest,bins) {
   dsm-line-field(name,1); let t = dfo-tensor(r,name); let dims = nth(t,1); let nel = (head(dims) * dsm-dim(dims,1)); let slices = (dsm-dim(dims,2) * dsm-dim(dims,3));
   let row = str_concat("T ",str_concat(name,str_concat(" ",str_concat(dsm-ints(list(head(t),len(dims),head(dims),dsm-dim(dims,1),dsm-dim(dims,2),dfo-abs(r,t),nel,slices,(slices * gm-slice-bytes(head(t),nel)))),"\n")))); dsm-trows(r,rest,fbc-put(bins,row));
  }
  def dsm-manifest(r) {
   let src = record_get(r,"header"); let head = str_concat("MAGICOK 1\nVERSION 3\nNTENSORS ",str_concat(int_to_str(record_get(r,"tensor-count")),str_concat("\nNKV ",str_concat(int_to_str(record_get(r,"metadata-count")),"\n"))));
   let meta = dsm-kvs(src,24,record_get(r,"metadata-count"),0,list()); let table = str_concat("TINFOSTART ",str_concat(int_to_str(record_get(r,"tinfo-start")),str_concat("\nTINFOEND ",str_concat(int_to_str(record_get(r,"tinfo-end")),str_concat("\nDATABASE ",str_concat(int_to_str(record_get(r,"data")),"\n"))))));
   str_concat(head,str_concat(meta,str_concat(table,str_concat(dsm-trows(r,record_get(r,"tensor-names"),list()),"END\n"))));
  }
  def dsm-array-values(src,at,t,index,n,bins) = if ((Comparable) index == n) then fbc-finish(bins,"") else dsm-array-next(src,at,t,index,n,bins);
  def dsm-array-next(src,at,t,index,n,bins) {
   let value = if ((Comparable) t == 6) then str_concat("  A\n",dsm-float(dfo-f32(dfo-le(src,at,4)))) else str_concat("  A u ",dsm-unsigned(src,at,egg-vtype-size(t)));
   dsm-array-values(src,(at + egg-vtype-size(t)),t,(index + 1),n,fbc-put(bins,str_concat(value,"\n")));
  }
  def dsm-array(r,key) {
   dsm-line-field(key,1); let src = record_get(r,"header"); let off = gmt-find(src,key);
   if ((Comparable) off == gmt-absent()) then dsm-array-message("ABSENT ",key) else if (!((Comparable) gmt-vtype(src,off) == 9)) then dsm-array-message("NOTARRAY ",key) else dsm-array-present(src,off,key);
  }
  def dsm-array-message(prefix,key) {
   str_concat(prefix,str_concat(key,"\n"));
  }
  def dsm-array-present(src,off,key) {
    let t = gmt-arr-etype(src,off); let n = gmt-arr-count(src,off); dfo-require((((Comparable) gm-intish?(t) == 1) || ((Comparable) t == 6)),"requested array element type has no manifest value representation");
    let values = dsm-array-values(src,gmt-arr-first(src,off),t,0,n,list());
    let header = str_concat("ARR ",str_concat(key,str_concat(" ",str_concat(int_to_str(t),str_concat(" ",str_concat(int_to_str(n),"\n"))))));
    str_concat(header,str_concat(values,"END\n"));
  }
 }
 0;
}
