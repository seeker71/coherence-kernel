//////////////////////////////////////////////////////////////////////
//
// vector-ops.bml — dot_product, magnitude and vector_cosine, at home in Form.
//
// A vector is a list of numbers, each read as a float. dot_product walks both
// lists in step and stops at the shorter one; magnitude is the square root of
// a vector's sum of squares; vector_cosine answers 0 when either norm is 0 and
// otherwise the dot over the product of the two norms. math_sqrt is the body's
// fk_sqrt_d, so the bits are the ones the kernel's own square root gives.
//
// preludes: form-stdlib/core.fk
//
section [form.bml] {
    class VectorOps {
        def vo-f(x) = x + 0.0;
        def vo-dot-onto(a, b, acc) = nil?(a) ? acc : nil?(b) ? acc : vo-dot-onto(tail(a), tail(b), acc + (vo-f(head(a)) * vo-f(head(b))));
        def vo-sq-onto(v, acc) = nil?(v) ? acc : vo-sq-onto(tail(v), acc + (vo-f(head(v)) * vo-f(head(v))));
        // a tensor argument takes the GPU lane through gpu-dispatch; a list walks here
        def dot_product(a, b) = gd-tensor?(a) ? gd-call("vo-dot-onto", list(), list(a, b), 0.0, list()) : vo-dot-onto(a, b, 0.0);
        def vo-scale-onto(v, k, acc) = nil?(v) ? acc : vo-scale-onto(tail(v), k, cons(vo-f(head(v)) * k, acc));
        def vector_scale(v, k) = gd-tensor?(v) ? gd-call("vo-scale-onto", list(), list(v), 0.0, list(k)) : reverse(vo-scale-onto(v, k, list()));
        def magnitude(v) = math_sqrt(vo-sq-onto(v, 0.0));
        def vector_cosine(a, b) {
            let ma = magnitude(a);
            let mb = magnitude(b);
            (Comparable) ma == 0.0 ? 0.0 : (Comparable) mb == 0.0 ? 0.0 : (dot_product(a, b) / (ma * mb));
        }
    }
}
