// body-fingerprint.bml — the body's one content identity: FNV-1a over 64 bits (bml-source-fingerprint, the fingerprint every
// compiler cache is keyed by), as 16 hex digits. A digest is as strong as the parties who check it, and these identities are
// checked by the body alone: what they must see is that the bytes changed. A string or a file is folded by the CPU through a
// Form-emitted image run in the seed's door for CPU images (jit_cpu_run), byte for byte the fold the Form recipe answers; a
// host where no image runs folds with the Form recipe itself.
//
// The image's ABI (the door calls fn(bufs, consts, 1)): x0 = [the message, the fold's 8 state bytes (little endian), written
// back], x1 = [the byte count]. A file is folded in spans of 1 GiB, each mapped for its run.
import form-stdlib/core.fk;
import form-stdlib/form-asm.fk;
import form-stdlib/bml-source.fk;
import form-stdlib/hex.fk;
section [form.bml] {
 class BodyFingerprint {
  // ---- the image: h = (h ^ byte) * 0x100000001b3 for every byte, the state loaded first and stored last
  def bfp-instructions() = [fa-ldr(3, 0, 0), fa-ldr(4, 0, 1), fa-ldr-w(5, 1, 0), fa-ldr(7, 4, 0), fa-movz-x(8, 435), fa-movk-x(8, 256, 2), fa-cmp-x(5, 0), fa-bcond(0, 8),
   fa-ldrb(9, 3, 0), fa-add-x-imm(3, 3, 1), fa-eor-x(7, 7, 9), fa-mul-x(7, 7, 8), fa-sub-x-imm(5, 5, 1), fa-cmp-x(5, 0), fa-bcond(1, 0 - 6),
   fa-str-x(7, 4, 0), fa-ret()];
  def bfp-bytes(bytes) = nil?(bytes) ? "" : byte_to_str(bytes[0]) + bfp-bytes(bytes[1:]);
  // the fold's 64 bits as 8 little-endian bytes from its two 32-bit halves; the offset basis cbf29ce484222325 to begin
  def bfp-le32(w) = byte_to_str(w % 256) + (byte_to_str(w / 256 % 256) + (byte_to_str(w / 65536 % 256) + byte_to_str(w / 16777216 % 256)));
  def bfp-initial() = bfp-le32(2216829733) + bfp-le32(3421674724);
  // the state as 16 hex, high byte first (the order bml-source-fingerprint writes)
  def bfp-hex(state) = bfp-hex-from(state, 7, "");
  def bfp-hex-from(state, i, acc) = i < 0 ? acc : bfp-hex-from(state, i - 1, acc + hex-byte-to-pair(str_byte_at(state, i)));
  def bfp-hex-of(state) = (Comparable) len(state) == 8 ? bfp-hex(state) : nothing();
  // one run over n bytes of the message (a string where it lies, or ["file", path, offset, length])
  def bfp-run(message, state, n) = (Comparable) n == 0 ? state : bfp-written(jit_cpu_run([bfp-image, [message, [state]], [n]]));
  def bfp-written(answer) = nothing?(answer) ? "" : answer[0];
  // the lane, witnessed in this process: "a" folds to af63dc4c8601ec8c through the door
  def bfp-witness() = (String) (bfp-hex-of(bfp-run("a", bfp-initial(), 1)) ?? "") == "af63dc4c8601ec8c";

  // ---- a string's identity
  def bfp-text(text) = bfp-lane ? (bfp-hex-of(bfp-run(text, bfp-initial(), len(text))) ?? bml-source-fingerprint(text)) : bml-source-fingerprint(text);
  // ---- a file's identity, nothing when there is no file
  def bfp-chunk() = 1073741824;
  def bfp-span(size, off) = size - off < bfp-chunk() ? size - off : bfp-chunk();
  def bfp-file(path) {
   let size = file_size(path);
   size < 0 ? nothing() : bfp-lane ? bfp-file-walk(path, size, 0, bfp-initial()) : bml-source-fingerprint(read_file(path) ?? "");
  }
  def bfp-file-walk(path, size, off, state) = off >= size ? bfp-hex-of(state) : !((Comparable) len(state) == 8) ? nothing() : bfp-file-walk(path, size, off + bfp-span(size, off), bfp-run(["file", path, off, bfp-span(size, off)], state, bfp-span(size, off)));
  // an identity is 16 lowercase hex digits
  def bfp-valid?(id) = (String) value_kind(id) == "string" && (Comparable) len(id) == 16 && bfp-hex-run?(id, 0);
  def bfp-hex-run?(s, i) = i >= len(s) ? true : bfp-hex-char?(str_byte_at(s, i)) && bfp-hex-run?(s, i + 1);
  def bfp-hex-char?(b) = (b >= 48 && b <= 57) || (b >= 97 && b <= 102);
 }
 // made once when the unit loads: the image's bytes, and whether this process runs it
 let bfp-image = bfp-bytes(fa-image(bfp-instructions()));
 let bfp-lane = bfp-witness();
 0;
}
