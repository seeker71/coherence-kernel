//////////////////////////////////////////////////////////////////////
// wall-census.bml — the body looks for the walls it invented.
//
// Urs, 2026-09-10: "that wall is not real, it just needs attention,
// like all other wall we have invented and then taking as fact instead
// of question."
//
// The same day, a gaps table carried `W' v — a transposed matvec |
// nothing, for any quantisation or f32. This is the wall.` It had never
// been attempted. It took an afternoon and it turned out to be the EASY
// direction on this hardware. The same file said "Q8_0 — no carver
// anywhere in the body" while q8-0-msl.fk held eleven Q8_0 kernels
// and its band answered 1023 (corpus row 1422 walltest).
//
// So the question this lens asks of a limit is not "is it true" — it
// cannot know that. It asks the one thing that separates a measurement
// from a sentence, and it is the same question as row 1414: DOES IT
// CARRY A WITNESS? A limit beside a band, a verdict, a receipt, a date
// or a number is something someone ran. A limit alone on a line is
// something someone wrote, and it will be quoted, and inherited, and
// treated as ground by every hand that comes after.
//
// It is not a ban and it is not a claim of falsehood. Plenty of
// witnessed limits are real, and some unwitnessed ones will be too.
// It marks the ones nobody has pushed, so a body can choose.
// preludes: form/form-stdlib/core.fk form/form-stdlib/str-byte-at.fk form/form-stdlib/form-fs.fk form/form-stdlib/bml/copy-census.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormWallCensus {
        // Two tiers, because this body uses "cannot" mostly in the GOOD sense — "a paren cannot
        // rearrange them", "an argmax cannot see one" — which is a proof that something cannot go
        // WRONG, the opposite of a wall. A first run without this split reported 47 unwitnessed
        // limits in form/native and almost all of them were that. Strong marks are the ones that
        // can only mean "this body does not have it".
        def wln-strong() = list("⬜", "⛔", "no way to", "does not exist", "not attempted",
                                "nothing anywhere", "nothing in the body", "nothing on the device",
                                "not possible", "the wall", "no carver", "impossible");
        def wln-weak() = list("cannot", "blocked");
        def wln-marks() = wln-strong();
        // and the shapes a witness wears
        def wln-witness() = list("-band", "verdict", "receipts/", "witnessed", "measured", " ms", "GB/s",
                                 "corpus row", "Expected:", "probed", "20260", "2026-0");

        def wln-any?(s, ws) {
            if eq(len(ws), 0) then 0
            else if ge(str_find(s, head(ws), 0), 0) then 1
            else wln-any?(s, tail(ws));
        }
        def wln-claim?(s) = wln-any?(s, wln-strong());
        def wln-soft?(s) = wln-any?(s, wln-weak());
        def wln-witnessed?(s) = wln-any?(s, wln-witness());

        // lines, without building one string per byte
        def wln-eol(s, i, n) = if ge(i, n) then i else if eq(str_byte_at(s, i), 10) then i else wln-eol(s, add(i, 1), n);
        def wln-lines(s, i, n, acc) {
            if ge(i, n) then acc else wln-line-at(s, i, n, wln-eol(s, i, n), acc);
        }
        def wln-line-at(s, i, n, e, acc) {
            wln-lines(s, add(e, 1), n, cons(substring(s, i, e), acc));
        }

        // a claim's witness may sit on the line itself or on the one under it — a table row
        // often carries the mark and the evidence in different cells
        def wln-scan(ls, path, acc) {
            if eq(len(ls), 0) then acc else wln-scan-one(head(ls), tail(ls), path, acc);
        }
        def wln-scan-one(l, rest, path, acc) {
            let near = if eq(len(rest), 0) then l else str_concat(l, head(rest));
            wln-scan(rest, path, if eq(wln-claim?(l), 1) then cons(list(path, l, wln-witnessed?(near)), acc) else acc);
        }
        // wln-lines conses, so its list runs BACKWARDS through the file. Scanned as it came, "the line
        // under a claim" was the line ABOVE it — a witness split across a table row was being looked
        // for in the wrong row, and a witness above a claim was being credited to it. Found writing
        // this lens's own band (bit 4 holds the direction), not by running it.
        def wln-file(path) {
            let s = read_file(path);
            if nothing?(s) then list() else wln-scan(reverse(wln-lines(s, 0, str_len(s), list())), path, list());
        }
        def wln-walk(paths, acc) = if eq(len(paths), 0) then acc else wln-walk(tail(paths), cpc-cat(wln-file(head(paths)), acc));

        // The walls live in the DOCS. A first run reached only .fk and .bml — borrowing the copy
        // census's walker, which has no reason to read prose — and found three limits in a
        // directory whose own registry file carries thirty-five. An organ that looks for written
        // claims must read where claims are written.
        def wln-ext-ok?(p) {
            let n = str_len(p);
            if and(ge(n, 3), str_eq(substring(p, sub(n, 3), n), ".md")) then 1 else cpc-ext-ok?(p);
        }
        def wln-files(dir, acc) = wln-files-go(dir, fs_list(dir), acc);
        def wln-files-go(dir, names, acc) {
            if eq(len(names), 0) then acc else wln-files-one(dir, head(names), tail(names), acc);
        }
        def wln-files-one(dir, name, rest, acc) {
            let p = cpc-join(dir, name);
            let acc2 = if eq(cpc-skip?(name), 1) then acc
                       else if eq(fs_is_dir(p), 1) then wln-files(p, acc)
                       else if eq(wln-ext-ok?(p), 1) then cons(p, acc) else acc;
            wln-files-go(dir, rest, acc2);
        }

        def wln-r-path(r) = nth(r, 0);
        def wln-r-line(r) = nth(r, 1);
        def wln-r-wit(r) = nth(r, 2);
        def wln-bare(rs, acc) = if eq(len(rs), 0) then acc else wln-bare(tail(rs), if eq(wln-r-wit(head(rs)), 0) then cons(head(rs), acc) else acc);
        def wln-count-wit(rs) = if eq(len(rs), 0) then 0 else add(wln-r-wit(head(rs)), wln-count-wit(tail(rs)));

        def wln-line-text(r) = str_concat("  ", str_concat(wln-r-path(r), str_concat("   ", cpc-clip(trim(wln-r-line(r)), 118))));
        def wln-say(rs, k) {
            if or(eq(len(rs), 0), le(k, 0)) then 0 else wln-say-one(head(rs), tail(rs), k);
        }
        def wln-say-one(r, rest, k) {
            print_str(wln-line-text(r));
            wln-say(rest, sub(k, 1));
        }
    }
    0;
}
