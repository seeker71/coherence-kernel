// Restore source bytes when a quotation differs only in ASCII whitespace.
// Pure: callers supply source, quotation and byte limit. No source is edited.
// Membership does not establish the truth of an interpretation or its context.
// preludes: form-stdlib/bml/form-agent-tool-values.bml
section [form.bml] {
 class FormCliQuoteEvidence {
  // Each normalized byte retains its original source-byte position.
  def fcqe-fold(s,i,end,space,text,positions) = if ge(i,end) then list(text,fat-reverse(positions)) else if fat-ws(fat-char(s,i)) then if space then fcqe-fold(s,add(i,1),end,1,text,positions) else fcqe-fold(s,add(i,1),end,1,str_concat(text," "),cons(i,positions)) else fcqe-fold(s,add(i,1),end,0,str_concat(text,substring(s,i,add(i,1))),cons(i,positions));
  def fcqe-normalized(s) = fcqe-fold(s,fat-skip(s,0),fat-rtrim(s,str_len(s)),0,"",list());
  def fcqe-miss(reason) = list(0,"",-1,-1,reason);
  def fcqe-found(source,start,end,kind) = list(1,substring(source,start,end),start,end,kind);
  def fcqe-normal-match(source,view,quote) {
   let at = str_find(head(view),quote,0);
   if lt(at,0) then fcqe-miss("text-differs") else if ge(str_find(head(view),quote,add(at,1)),0) then fcqe-miss("ambiguous-whitespace-match") else fcqe-found(source,nth(nth(view,1),at),add(nth(nth(view,1),sub(add(at,str_len(quote)),1)),1),"source-whitespace-restored");
  }
  def fcqe-restore(source,quote,maxBytes) = if or(le(maxBytes,0),or(gt(str_len(source),maxBytes),gt(str_len(quote),maxBytes))) then fcqe-miss("byte-limit") else if eq(str_len(fat-trim(quote)),0) then fcqe-miss("empty-quotation") else {
   let at = str_find(source,quote,0);
   if ge(at,0) then fcqe-found(source,at,add(at,str_len(quote)),"exact") else fcqe-normal-match(source,fcqe-normalized(source),head(fcqe-normalized(quote)));
  };
 }
 0;
}
