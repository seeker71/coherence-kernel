  def ohd-frame-shape(frame) = !((String) value_kind(frame) == "list") ? 0 : (Comparable) len(frame) != 8 ? 0 : (((String) head(frame) == "organ-health-discovery-v1") && (ohd-text(frame[1]) && (ohd-text(frame[2]) && ((ohd-int(frame[3]) && (frame[3] > 0)) && (ohd-text(frame[4]) && (ohd-int(frame[5]) && (ohd-int(frame[6]) && ohd-rows-valid(frame[7],list()))))))));
