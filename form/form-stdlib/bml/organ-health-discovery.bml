// Lifecycle declarations carry only event-source references and capability names.
// An explicit owner holds one shared frame per declared root. Register at
// source creation; renew after truncation; retire when the source is no longer
// offered. Unchanged explicit-owner registration performs no shared-memory
// operation. The three-argument lifecycle API rehydrates its process-birth frame
// on each call, so allocator compaction cannot discard its registry state.
// It skips publication when unchanged; no registration runs per health event.
// Discovery covers currently advertised sources, not every organ. The existing
// roster has 511 slots and evicts its least recently registered name. Frames
// outlive their writers; PID existence is an observation, not process identity.
// Paths are absolute lexical names: dot/duplicate separators normalize, parent
// traversal refuses, and symlink/inode equivalence is not claimed. Cooperative
// publishers own their records; the shared roster is not an isolation boundary.
// shm_release acknowledges a live handle after invoking unmap; its current
// carrier does not return the platform unmap result. Any refused acknowledgement
// keeps the handle in the returned result/diagnostic for explicit release retry.
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/line-grammar.fk form-stdlib/form-glass-gift-frame.bml form-stdlib/bml/native-owner-clock.bml
section [form.bml] {
 class OrganHealthDiscovery {
  def ohd-shared-append-capability() = "append-only-shared-source";
  def ohd-owner() = ohd-owner-page(kernel_live(host_pid()));
  def ohd-owner-page(page) = if lt(len(page),3) then nothing() else if not(and(eq(nth(page,1),host_pid()),and(ohd-int(nth(page,2)),gt(nth(page,2),0)))) then nothing() else record_new(0,"kind","organ-health-discovery","pid",host_pid(),"incarnation",str_concat(int_to_str(nth(page,2)),"-default"),"counter",0,"roots",record_new(0),"rootnames",list(),"publications",0,"unsettled",list());
  def ohd-s(key,value) = json-node-pair(key,json-node-string(value));
