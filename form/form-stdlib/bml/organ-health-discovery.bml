  def ohd-int-nodes(xs) = if nil?(xs) then list() else cons(json-node-int(head(xs)),ohd-int-nodes(tail(xs)));
  def ohd-result(ok,state,reason,source,rootState,row) = json-node-object(list(ohd-n("ok",ok),ohd-s("state",state),ohd-s("reason",reason),ohd-s("source",source),ohd-s("publisher",if record?(rootState) then record_get(rootState,"publisher") else ""),ohd-s("generation",if nothing?(row) then "" else nth(row,1)),ohd-n("sequence",if record?(rootState) then record_get(rootState,"sequence") else 0),ohd-n("roster_slot",if record?(rootState) then record_get(rootState,"slot") else -1),ohd-n("stream_count",if record?(rootState) then len(record_get(rootState,"rows")) else 0),ohd-n("handle_owner_pid",host_pid()),json-node-pair("unsettled_handles",json-node-array(ohd-int-nodes(if record?(rootState) then record_get(rootState,"unsettled") else list())))));
  def ohd-refused(reason,source) = ohd-result(0,"refused",reason,if str_eq(value_kind(source),"string") then source else "",nothing(),nothing());
  def ohd-register(root,source,capabilities) = ohd-register-with(ohd-owner(),root,source,capabilities);
  def ohd-register-with(owner,root,source,capabilities) = ohd-change(owner,root,source,capabilities,0);
  def ohd-renew(root,source,capabilities) = ohd-change(ohd-owner(),root,source,capabilities,1);
  def ohd-renew-with(owner,root,source,capabilities) = ohd-change(owner,root,source,capabilities,1);
  def ohd-change(owner,root,source,capabilities,renew) = if nothing?(owner) then ohd-refused("process-birth-unavailable",source) else if not(ohd-valid(owner)) then ohd-refused("owner",source) else if not(ohd-string-list(capabilities)) then ohd-refused("capabilities",source) else ohd-change-root(owner,ohd-path(host_cwd(),root),source,ohd-unique(capabilities,list()),renew);
  def ohd-change-root(owner,root,source,caps,renew) = if nothing?(root) then ohd-refused("root-path",source) else ohd-change-path(owner,root,ohd-path(root,source),caps,renew);
  def ohd-change-path(owner,root,path,caps,renew) = if nothing?(path) then ohd-refused("source-path","") else ohd-change-held(owner,ohd-root-owner(owner,root),path,caps,renew);
  def ohd-change-held(owner,state,path,caps,renew) {
   let prior = ohd-find(record_get(state,"rows"),path);
   let same = if nothing?(prior) then 0 else and(eq(renew,0),value_eq(nth(prior,2),caps));
   if not(str_eq(record_get(state,"refusal"),"")) then ohd-result(0,"refused",record_get(state,"refusal"),path,state,prior) else if and(same,eq(record_get(state,"published"),1)) then ohd-result(1,"unchanged","",path,state,prior) else ohd-change-row(owner,state,path,caps,prior,same);
  }
  def ohd-change-row(owner,state,path,caps,prior,same) {
   let row = if same then prior else list(path,str_concat(record_get(state,"publisher"),str_concat(":",int_to_str(add(record_get(state,"revision"),1)))),caps);
