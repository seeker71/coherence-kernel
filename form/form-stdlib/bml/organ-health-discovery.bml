  def ohd-diagnostic(state,publisher,reason) = ohd-diagnostic-held(state,publisher,reason,list());
  def ohd-diagnostic-held(state,publisher,reason,handles) = json-node-object(list(ohd-s("state",state),ohd-s("publisher",publisher),ohd-s("reason",reason),ohd-n("handle_owner_pid",host_pid()),json-node-pair("unsettled_handles",json-node-array(ohd-int-nodes(handles)))));
  def ohd-source(frame,row,alive) = json-node-object(list(ohd-s("root",nth(frame,2)),ohd-s("source",head(row)),ohd-s("publisher",nth(frame,1)),ohd-n("pid",nth(frame,3)),ohd-n("publisher_pid_exists",alive),ohd-s("incarnation",nth(frame,4)),ohd-s("generation",nth(row,1)),ohd-n("advertised_at_ms",nth(frame,6)),json-node-pair("capabilities",json-node-array(ohd-strings(nth(row,2))))));
  def ohd-sources(frame,rows,alive) = if nil?(rows) then list() else cons(ohd-source(frame,head(rows),alive),ohd-sources(frame,tail(rows),alive));
  def ohd-read-advertisement(root,publisher) {
   let taken = ohd-take(publisher); let frame = nth(taken,1);
