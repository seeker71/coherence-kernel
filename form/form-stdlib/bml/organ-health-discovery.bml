  def ohd-frame-shape(frame) = if not(str_eq(value_kind(frame),"list")) then 0 else if ne(len(frame),8) then 0 else and(str_eq(head(frame),"organ-health-discovery-v1"),and(ohd-text(nth(frame,1)),and(ohd-text(nth(frame,2)),and(and(ohd-int(nth(frame,3)),gt(nth(frame,3),0)),and(ohd-text(nth(frame,4)),and(ohd-int(nth(frame,5)),and(ohd-int(nth(frame,6)),ohd-rows-valid(nth(frame,7),list()))))))));
  def ohd-rows-valid(rows,seen) = if not(str_eq(value_kind(rows),"list")) then 0 else if nil?(rows) then 1 else if not(ohd-row-valid(head(rows))) then 0 else if ohd-has(seen,head(head(rows))) then 0 else ohd-rows-valid(tail(rows),cons(head(head(rows)),seen));
  def ohd-row-valid(row) = if not(str_eq(value_kind(row),"list")) then 0 else if ne(len(row),3) then 0 else and(ohd-text(head(row)),and(eq(str_byte_at(head(row),0),47),and(ohd-text(nth(row,1)),ohd-string-list(nth(row,2)))));
  def ohd-frame-bound(frame) = if not(ohd-frame-shape(frame)) then 0 else if not(str_eq(nth(frame,2),ohd-path("/",nth(frame,2)))) then 0 else if not(str_eq(nth(frame,1),str_concat(ohd-prefix(nth(frame,2)),str_concat(int_to_str(nth(frame,3)),str_concat(":",nth(frame,4)))))) then 0 else ohd-rows-bound(nth(frame,7),nth(frame,1));
  def ohd-rows-bound(rows,publisher) = if nil?(rows) then 1 else and(str_eq(head(head(rows)),ohd-path("/",head(head(rows)))),and(eq(str_find(nth(head(rows),1),str_concat(publisher,":"),0),0),ohd-rows-bound(tail(rows),publisher)));
  def ohd-same-owner(frame,owner,state) = if not(ohd-frame-bound(frame)) then 0 else and(str_eq(nth(frame,1),record_get(state,"publisher")),and(str_eq(nth(frame,2),record_get(state,"root")),and(eq(nth(frame,3),record_get(owner,"pid")),str_eq(nth(frame,4),record_get(owner,"incarnation")))));
  def ohd-publish(owner,state,path,row) {
   let prior = ohd-take(record_get(state,"publisher"));
   let available = or(str_eq(head(prior),"absent"),and(str_eq(head(prior),"unreadable"),eq(nth(prior,2),0)));
   if not(eq(nth(prior,3),1)) then ohd-result(0,"refused","mapping-release",path,ohd-state-refusal(state,"mapping-release",list(nth(prior,4))),row) else if not(or(available,ohd-same-owner(nth(prior,1),owner,state))) then ohd-result(0,"refused","frame-identity-collision-or-unreadable",path,state,row) else ohd-publish-new(owner,state,path,row);
