   state;
  }
  def ohd-find(rows,path) = nil?(rows) ? nothing() : (String) head(head(rows)) == path ? head(rows) : ohd-find(tail(rows),path);
  def ohd-without(rows,path) = nil?(rows) ? list() : (String) head(head(rows)) == path ? ohd-without(tail(rows),path) : cons(head(rows),ohd-without(tail(rows),path));
