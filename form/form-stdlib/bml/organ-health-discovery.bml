  def ohd-frame(owner,state) = list("organ-health-discovery-v1",record_get(state,"publisher"),record_get(state,"root"),record_get(owner,"pid"),record_get(owner,"incarnation"),record_get(state,"revision"),now_unix_ms(),record_get(state,"rows"));
  // This flat string/int/list frame uses the existing cell carrier. Its exact
  // carrier byte size is calculated before mapping, without a fixed stream cap.
  def ohd-wire-size(value) = if str_eq(value_kind(value),"string") then if gt(str_len(value),4294967295) then -1 else add(5,str_len(value)) else if str_eq(value_kind(value),"int") then 9 else if str_eq(value_kind(value),"list") then if ge(len(value),100000000) then -1 else ohd-wire-list(value,6) else -1;
