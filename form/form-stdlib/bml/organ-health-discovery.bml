  def ohd-wire-size(value) = (String) value_kind(value) == "string" ? (str_len(value) > 4294967295 ? -1 : (5 + str_len(value))) : (String) value_kind(value) == "int" ? 9 : (String) value_kind(value) == "list" ? (len(value) >= 100000000 ? -1 : ohd-wire-list(value,6)) : -1;
  def ohd-wire-list(rows,size) = nil?(rows) ? size : ohd-wire-next(tail(rows),size,ohd-wire-size(head(rows)));
  def ohd-wire-next(rows,size,n) = (n < 0) || (n > (4611686018427387887 - size)) ? -1 : ohd-wire-list(rows,size + n);
  def ohd-take(publisher) {
