  def ohd-retire(root,source) = ohd-retire-with(ohd-owner(),root,source);
  def ohd-retire-with(owner,root,source) = if not(ohd-valid(owner)) then ohd-refused("owner",source) else ohd-retire-root(owner,ohd-path(host_cwd(),root),source);
  def ohd-retire-root(owner,root,source) = if nothing?(root) then ohd-refused("root-path",source) else ohd-retire-path(owner,root,ohd-path(root,source));
  def ohd-retire-path(owner,root,path) = if nothing?(path) then ohd-refused("source-path","") else ohd-retire-state(owner,ohd-root-owner(owner,root),path);
