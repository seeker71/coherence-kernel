  def ohd-scan(root,rows,sources,diagnostics) = nil?(rows) ? list(sources,diagnostics) : !((Comparable) str_find(head(head(rows)),ohd-prefix(root),0) == 0) ? ohd-scan(root,tail(rows),sources,diagnostics) : ohd-scan-read(root,tail(rows),sources,diagnostics,ohd-read-advertisement(root,head(head(rows))));
