  def ohd-get(row,key) = json-object-get(row,key);
  def ohd-str(row,key) = json-string-value(ohd-get(row,key));
  def ohd-num(row,key) = json-int-value(ohd-get(row,key));
  def ohd-text(value) = if not(str_eq(value_kind(value),"string")) then 0 else and(gt(str_len(value),0),lt(str_find(value,byte_to_str(0),0),0));
  def ohd-int(value) = and(str_eq(value_kind(value),"int"),ge(value,0));
  def ohd-has(xs,x) = if nil?(xs) then 0 else or(str_eq(head(xs),x),ohd-has(tail(xs),x));
  def ohd-string-list(xs) = if not(str_eq(value_kind(xs),"list")) then 0 else if nil?(xs) then 1 else and(ohd-text(head(xs)),ohd-string-list(tail(xs)));
  def ohd-strings(xs) = if nil?(xs) then list() else cons(json-node-string(head(xs)),ohd-strings(tail(xs)));
  def ohd-unique(xs,seen) = if nil?(xs) then reverse(seen) else ohd-unique(tail(xs),if ohd-has(seen,head(xs)) then seen else cons(head(xs),seen));
  def ohd-path-parts(parts,held) = if nil?(parts) then reverse(held) else if str_eq(head(parts),"..") then nothing() else if or(str_eq(head(parts),""),str_eq(head(parts),".")) then ohd-path-parts(tail(parts),held) else ohd-path-parts(tail(parts),cons(head(parts),held));
  def ohd-path-join(parts) = if nil?(parts) then "" else str_concat("/",str_concat(head(parts),ohd-path-join(tail(parts))));
  def ohd-path(base,path) = if not(and(ohd-text(base),ohd-text(path))) then nothing() else ohd-path-ready(ohd-path-parts(split-on(if eq(str_byte_at(path,0),47) then path else str_concat(base,str_concat("/",path)),"/"),list()));
  def ohd-path-ready(parts) = if nothing?(parts) then nothing() else if nil?(parts) then "/" else ohd-path-size(ohd-path-join(parts));
  def ohd-path-size(path) = if ge(str_len(path),4096) then nothing() else path;
  def ohd-valid(owner) = if not(record?(owner)) then 0 else and(str_eq(record_get(owner,"kind"),"organ-health-discovery"),eq(record_get(owner,"pid"),host_pid()));
  def ohd-next(owner) {
   if ge(record_get(owner,"counter"),4611686018427387903) then form_error("discovery owner generation exhausted") else 0;
   let count = add(record_get(owner,"counter"),1);
   record_set(owner,"counter",count);
   count;
  }
  def ohd-open() {
   let owner = ohd-owner();
   if nothing?(owner) then nothing() else ohd-open-owned(owner);
  }
  def ohd-open-owned(owner) {
   // The existing construction counter advances for every new record and
