  }
  def ohd-state-refusal(state,reason,handles) {
   record_set(state,"refusal",reason); record_set(state,"unsettled",handles);
   state;
  }
  def ohd-root-restored(state,frame,sequence) {
   record_set(state,"rows",nth(frame,7)); record_set(state,"revision",nth(frame,5));
