   let allocation = noc-sequence();
   record_set(owner,"incarnation",str_concat(record_get(owner,"incarnation"),str_concat("-owned-allocation-",fstr-int-to-str(allocation))));
   owner;
  }
  def ohd-release(handle) = ggf-release(handle);
  def ohd-release-pending(handles) = ohd-release-list(handles);
  def ohd-release-list(handles) = if nil?(handles) then list() else if eq(ggf-release(head(handles)),1) then ohd-release-list(tail(handles)) else cons(head(handles),ohd-release-list(tail(handles)));
  def ohd-prefix(root) = str_concat("ohd1:",str_concat(ggf-hex8(crc32(ggf-bytes(root))),":"));
  def ohd-publisher(owner,root) = str_concat(ohd-prefix(root),str_concat(int_to_str(record_get(owner,"pid")),str_concat(":",record_get(owner,"incarnation"))));
  def ohd-root-owner(owner,root) {
   let roots = record_get(owner,"roots");
