  def ohd-refused(reason,source) = ohd-result(0,"refused",reason,(String) value_kind(source) == "string" ? source : "",nothing(),nothing());
  def ohd-register(root,source,capabilities) = ohd-register-with(ohd-owner(),root,source,capabilities);
