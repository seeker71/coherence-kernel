  def ohd-change(owner,root,source,capabilities,renew) = nothing?(owner) ? ohd-refused("process-birth-unavailable",source) : !ohd-valid(owner) ? ohd-refused("owner",source) : !ohd-string-list(capabilities) ? ohd-refused("capabilities",source) : ohd-change-root(owner,ohd-path(host_cwd(),root),source,ohd-unique(capabilities,list()),renew);
  def ohd-change-root(owner,root,source,caps,renew) = nothing?(root) ? ohd-refused("root-path",source) : ohd-change-path(owner,root,ohd-path(root,source),caps,renew);
  def ohd-change-path(owner,root,path,caps,renew) = nothing?(path) ? ohd-refused("source-path","") : ohd-change-held(owner,ohd-root-owner(owner,root),path,caps,renew);
  def ohd-change-held(owner,state,path,caps,renew) {
