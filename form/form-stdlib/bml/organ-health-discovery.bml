  }
  def ohd-scan(root,rows,sources,diagnostics) = if nil?(rows) then list(sources,diagnostics) else if not(eq(str_find(head(head(rows)),ohd-prefix(root),0),0)) then ohd-scan(root,tail(rows),sources,diagnostics) else ohd-scan-read(root,tail(rows),sources,diagnostics,ohd-read-advertisement(root,head(head(rows))));
  def ohd-scan-read(root,rows,sources,diagnostics,read) = ohd-scan(root,rows,append(sources,head(read)),append(diagnostics,nth(read,1)));
