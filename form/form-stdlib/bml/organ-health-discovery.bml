   !((Comparable) prior[3] == 1) ? ohd-result(0,"refused","mapping-release",path,ohd-state-refusal(state,"mapping-release",list(prior[4])),row) : !(available || ohd-same-owner(prior[1],owner,state)) ? ohd-result(0,"refused","frame-identity-collision-or-unreadable",path,state,row) : ohd-publish-new(owner,state,path,row);
