  def ohd-text(value) = !((String) value_kind(value) == "string") ? 0 : ((str_len(value) > 0) && (str_find(value,byte_to_str(0),0) < 0));
  def ohd-int(value) = ((String) value_kind(value) == "int") && (value >= 0);
  def ohd-has(xs,x) = nil?(xs) ? 0 : (((String) head(xs) == x) || ohd-has(tail(xs),x));
  def ohd-string-list(xs) = !((String) value_kind(xs) == "list") ? 0 : nil?(xs) ? 1 : (ohd-text(head(xs)) && ohd-string-list(tail(xs)));
  def ohd-strings(xs) = xs |> map(json-node-string);
  def ohd-unique(xs,seen) = nil?(xs) ? reverse(seen) : ohd-unique(tail(xs),ohd-has(seen,head(xs)) ? seen : cons(head(xs),seen));
  def ohd-path-parts(parts,held) = nil?(parts) ? reverse(held) : (String) head(parts) == ".." ? nothing() : ((String) head(parts) == "") || ((String) head(parts) == ".") ? ohd-path-parts(tail(parts),held) : ohd-path-parts(tail(parts),cons(head(parts),held));
  def ohd-path-join(parts) = nil?(parts) ? "" : "/" ++ head(parts) ++ ohd-path-join(tail(parts));
  def ohd-path(base,path) = !(ohd-text(base) && ohd-text(path)) ? nothing() : ohd-path-ready(ohd-path-parts(split-on((Comparable) str_byte_at(path,0) == 47 ? path : base ++ "/" ++ path,"/"),list()));
  def ohd-path-ready(parts) = nothing?(parts) ? nothing() : nil?(parts) ? "/" : ohd-path-size(ohd-path-join(parts));
  def ohd-path-size(path) = str_len(path) >= 4096 ? nothing() : path;
  def ohd-valid(owner) = !record?(owner) ? 0 : (((String) record_get(owner,"kind") == "organ-health-discovery") && ((Comparable) record_get(owner,"pid") == host_pid()));
  def ohd-next(owner) {
   record_get(owner,"counter") >= 4611686018427387903 ? form_error("discovery owner generation exhausted") : 0;
   let count = record_get(owner,"counter") + 1;
   record_set(owner,"counter",count);
   count;
  }
  def ohd-open() {
   let owner = ohd-owner();
