// Form emits exact-order fp64 MXFP8 matrix code into owned RAM.
// Inputs are immutable borrowed byte spans. Outputs are owned anonymous maps.
// Products and reductions never enter the bootstrap's boxed-float pool.
// preludes: form-stdlib/bml/native-fp64-bytes.bml form-stdlib/bml/native-pty-darwin.bml form-stdlib/organ-health.bml
section [form.bml] {
 class NativeFp64Matrix {
  def nfm-ubfx(rd,rn,first,last) = fa-asm(3544186880,list(1,32,65536,1024),list(rd,rn,first,last));
  def nfm-mx8-image() {
   let rows = list(
    fa-add-x-imm(17,7,0),fa-movz-x(16,1014),fa-lsl-x-imm(16,16,52),fa-fmov-d-x(6,16),
    npd-label("row"),fa-cmp-x(7,0),npd-branch(0,"done"),fa-fmov-d-x(4,31),fa-add-x-imm(9,4,0),nfm-ubfx(10,5,8,63),
    npd-label("group"),fa-fmov-d-x(0,31),fa-movz-x(11,32),
    npd-label("element"),fa-ldrb(12,0,0),fa-add-x-imm(0,0,1),nfm-ubfx(13,12,3,6),nfm-ubfx(14,12,0,2),nfm-ubfx(15,12,7,7),fa-lsl-x-imm(15,15,63),fa-cmp-x(13,0),npd-branch(0,"subnormal"),
    fa-add-x-imm(13,13,1016),fa-lsl-x-imm(13,13,52),fa-lsl-x-imm(14,14,49),fa-add-x-r(14,14,13),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),npd-branch(14,"multiply"),
    npd-label("subnormal"),fa-scvtf(1,14),fa-fmul(1,1,6),fa-fmov-x-d(14,1),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),
    npd-label("multiply"),fa-ldr-d(2,9,0),fa-add-x-imm(9,9,8),fa-fmul(1,1,2),fa-fadd(0,0,1),fa-sub-x-imm(11,11,1),fa-cmp-x(11,0),npd-branch(1,"element"),
    fa-ldrb(13,2,0),fa-add-x-imm(2,2,1),fa-add-x-imm(13,13,896),fa-lsl-x-imm(13,13,52),fa-fmov-d-x(3,13),fa-fmul(0,0,3),fa-fadd(4,4,0),fa-sub-x-imm(10,10,1),fa-cmp-x(10,0),npd-branch(1,"group"),
    fa-str-d(4,6,0),fa-add-x-imm(6,6,8),fa-sub-x-imm(7,7,1),npd-branch(14,"row"),npd-label("done"),fa-add-x-imm(0,17,0),fa-ret());
   fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
  }
  def nfm-open() {
   let memory = npd-open(); let image = nfm-mx8-image(); let owner = record_new(0,"kind","native-fp64-matrix","pid",host_pid(),"active",1,"code-live",0,"memory",memory,"image",image);
   let identity = intern_node(make_nodeid(31,2,0,181),cons(intern_trivial_string("native-mx8-fp64-ordered-v1"),cons(intern_trivial_int(owner),npd-nodes(image))));
   record_set(owner,"identity",identity); record_set(owner,"request",list(0,identity,image)); owner;
  }
  def nfm-bytes-list(xs,out) = if nil?(xs) then out else nfm-bytes-list(tail(xs),str_concat(out,byte_to_str(head(xs))));
  def nfm-active(owner) = and(record?(owner),and(str_eq(record_get(owner,"kind"),"native-fp64-matrix"),and(eq(record_get(owner,"pid"),host_pid()),and(eq(record_get(owner,"active"),1),npd-active(record_get(owner,"memory"))))));
  def nfm-finite(x) = and(or(str_eq(value_kind(x),"float"),str_eq(value_kind(x),"int")),eq(sub(x,x),0.0));
  def nfm-finite-list(xs) = if nil?(xs) then 1 else and(nfm-finite(head(xs)),nfm-finite-list(tail(xs)));
  def nfm-f64-image(x) = if eq(x,0.0) then nfm-fields(0,0,if lt(div(1.0,x),0.0) then 1 else 0) else nfm-f64-nonzero(x,nfb-exponent(abs(x)));
  def nfm-f64-nonzero(x,e) = if lt(e,-1022) then nfm-fields(trunc(div(abs(x),nfb-pow2(-1074))),0,if lt(x,0.0) then 1 else 0) else nfm-fields(trunc(mul(sub(div(abs(x),nfb-pow2(e)),1.0),4503599627370496.0)),add(e,1023),if lt(x,0.0) then 1 else 0);
  def nfm-fields(mant,exp,sign) = str_concat(nfm-low(mant,6),str_concat(byte_to_str(add(mod(div(mant,281474976710656),16),mul(mod(exp,16),16))),byte_to_str(add(div(exp,16),mul(sign,128)))));
  def nfm-low(value,count) = if eq(count,0) then "" else str_concat(byte_to_str(mod(value,256)),nfm-low(div(value,256),sub(count,1)));
  def nfm-pack(xs,bins) = if nil?(xs) then fbc-finish(bins,"") else if not(nfm-finite(head(xs))) then form_error("RAM fp64 input is not finite") else nfm-pack(tail(xs),fbc-put(bins,nfm-f64-image(head(xs))));
  def nfm-vector(xs) = record_new(0,"kind","native-finite-fp64","bytes",nfm-pack(xs,list()),"count",len(xs));
  def nfm-vector-good(x) = and(record?(x),and(str_eq(record_get(x,"kind"),"native-finite-fp64"),and(str_eq(value_kind(record_get(x,"count")),"int"),eq(str_len(record_get(x,"bytes")),mul(record_get(x,"count"),8)))));
  def nfm-output(owner,rows) = if and(nfm-active(owner),and(str_eq(value_kind(rows),"int"),and(gt(rows,0),le(rows,576460752303423487)))) then npd-region(record_get(owner,"memory"),mul(rows,8)) else nothing();
  def nfm-output-raw(region,at,rows,bins) = if eq(rows,0) then fbc-finish(bins,"") else nfm-output-raw(region,add(at,8),sub(rows,1),fbc-put(bins,nfm-bytes-list(npd-bytes(region,at,8),"")));
  def nfm-read-output(region,at,rows,acc) = if eq(rows,0) then reverse(acc) else nfm-read-output(region,add(at,8),sub(rows,1),cons(nfb-f64(nfm-bytes-list(npd-bytes(region,at,8),"")),acc));
  def nfm-mx8-run(owner,data,scales,x,rows,region) = if not(and(nfm-active(owner),and(nfm-vector-good(x),and(str_eq(value_kind(rows),"int"),gt(rows,0))))) then nothing() else nfm-mx8-admitted(owner,data,scales,x,rows,region,record_get(x,"count"));
  def nfm-mx8-admitted(owner,data,scales,x,rows,region,cols) {
   let shape = and(gt(cols,0),and(eq(mod(cols,32),0),and(eq(mod(str_len(data),cols),0),and(eq(div(str_len(data),cols),rows),eq(str_len(scales),div(str_len(data),32))))));
   let pointer = if and(shape,le(rows,576460752303423487)) then npd-owned-span(record_get(owner,"memory"),region,0,mul(rows,8)) else nothing();
   if nothing?(pointer) then nothing() else nfm-mx8-execute(owner,data,scales,record_get(x,"bytes"),rows,pointer);
  }
  def nfm-mx8-execute(owner,data,scales,packed,rows,pointer) {
   let result = jit_leaf_inram(record_get(owner,"request"),list(data,scales,packed,pointer,rows)); if eq(result,rows) then record_set(owner,"code-live",1) else 0; result;
  }
  def nfm-mx8(owner,data,scales,x,rows) {
   let packed = nfm-vector(x); let region = nfm-output(owner,rows); nfb-require(not(nothing?(region)),"RAM output allocation refused");
   let executed = nfm-mx8-run(owner,data,scales,packed,rows,region);
   let out = if eq(executed,rows) then nfm-read-output(region,0,rows,list()) else list(); let released = npd-region-close(region);
   nfb-require(and(eq(executed,rows),and(eq(released,0),nfm-finite-list(out))),"RAM MXFP8 execution, finite result or release refused"); out;
  }
  def nfm-close(owner) = if not(nfm-active(owner)) then 0 else if not(npd-regions-closed(record_get(record_get(owner,"memory"),"regions"))) then nothing() else nfm-close-code(owner);
  def nfm-close-code(owner) {
   let state = record_get(owner,"code-live");
   let released = if eq(state,2) then 1 else jit_leaf_inram(list(1,record_get(owner,"identity"),list()),0);
   if or(and(eq(state,0),eq(released,0)),and(not(eq(state,0)),eq(released,1))) then nfm-close-memory(owner) else nothing();
  }
  def nfm-close-memory(owner) {
   record_set(owner,"code-live",2); let memory = npd-close(record_get(owner,"memory"));
   if eq(memory,1) then record_set(owner,"active",0) else 0; if eq(memory,1) then 1 else nothing();
  }
  def nfm-observe(job,aspect,ok,details,evidencePath) {
   let evidence = oh-set(oh-reference(evidencePath),"measurement",json-node-object(details));
   let reading = oh-reading("native-fp64-matrix",job,aspect,json-node-int(1),json-node-int(ok),json-node-int(ok),if ok then list() else list(oh-need("native-matrix-evidence",evidence)),list("continue","retain"),evidence);
   oh-voice(reading); let response = oh-response(reading,if ok then "continue" else "retain"); oh-voice(response);
   let selected = oh-select(reading,response,"retain"); oh-voice(oh-applied(reading,selected,evidence));
   nfb-require(and(ok,str_eq(selected,"continue")),str_concat("observation refused: ",aspect)); 1;
  }
 }
 0;
}
