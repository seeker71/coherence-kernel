//////////////////////////////////////////////////////////////////////
// direct-source-jit-discovery.bml -- observable, caller-owned admission
// from recursively observed Form work to a retained native page.
//
// A source caller contributes its meaning, a candidate scalar program, and
// an epoch as ordinary values.  Discovery only observes recursive arrivals;
// it neither reads ambient source nor manufactures an execution authority.
// When a candidate is hot, all equally hot rows remain a choice.  A caller
// cuts by the structural function NodeID and offers that exact candidate to
// the existing heat gate.  The Form evaluator stays beside every offer as a
// challenger, while the gate owns birth, reuse, cooling, and release.
//
// The result preserves the distinction the body needs to steer honestly:
// nothing is absence/refusal, 0 and 1 are valid computed values, timeout
// retains partial observation, and ties are never silently resolved.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/jit-heat-gate.fk

section [form.bml] {
    class FormDirectSourceJitDiscovery [public, observable, jit] {
        thought source-jit-pattern = list("meaning-epoch", "structural-nodeid", "observe", "choice", "cut", "offer", "cold-challenger", "undo", "release");

        def dsjd-category() = make_nodeid(31, 2, 0, 182);
        // The implementation moved upward, not the candidate's meaning:
        // retain v1 so an already-held discovery state keeps its NodeID.
        def dsjd-version() = "direct-source-jit-discovery-v1";

        // Candidate program for sum-down(n) = n + sum-down(n - 1), base 0.
        // It is an offered example of the generic protocol, not a privileged
        // function seat and not a table of evaluator functions.
        def dsjd-sum-program() = list(list(2), list(1, 1), list(3, 0, 1), list(5, 0, 2), list(1, 2), list(8, 3, 4));
        def dsjd-sum-root() = 5;

        // spec = function-id, candidate-id, program, root, epoch, meaning.
        def dsjd-spec(epoch, meaning, program, root) {
            let candidate = jonb-identity(program, root, epoch);
            let function_id = intern_node(dsjd-category(), list(intern_trivial_string(dsjd-version()), intern_trivial_string(meaning), candidate));
            list(function_id, candidate, program, root, epoch, meaning);
        }
        def dsjd-sum-spec(epoch) = dsjd-spec(epoch, "sum-down:n+sum-down(n-1);base=0", dsjd-sum-program(), dsjd-sum-root());
        def dsjd-spec-function-id(spec) = nth(spec, 0);
        def dsjd-spec-candidate-id(spec) = nth(spec, 1);
        def dsjd-spec-program(spec) = nth(spec, 2);
        def dsjd-spec-root(spec) = nth(spec, 3);
        def dsjd-spec-epoch(spec) = nth(spec, 4);

        // discovery = epoch, rows; row = spec, recursive-call-count.
        def dsjd-discovery(epoch) = list(epoch, list());
        def dsjd-epoch(discovery) = nth(discovery, 0);
        def dsjd-rows(discovery) = nth(discovery, 1);
        def dsjd-row-spec(row) = nth(row, 0);
        def dsjd-row-hits(row) = nth(row, 1);
        def dsjd-row-function-id(row) = dsjd-spec-function-id(dsjd-row-spec(row));
        def dsjd-find-row(rows, function_id) = if eq(len(rows), 0) then nothing() else if node_eq(dsjd-row-function-id(head(rows)), function_id) then head(rows) else dsjd-find-row(tail(rows), function_id);
        def dsjd-hits(discovery, function_id) {
            let row = dsjd-find-row(dsjd-rows(discovery), function_id);
            if nothing?(row) then nothing() else dsjd-row-hits(row);
        }
        def dsjd-bump-rows(rows, spec) = if eq(len(rows), 0) then list(list(spec, 1)) else if node_eq(dsjd-row-function-id(head(rows)), dsjd-spec-function-id(spec)) then cons(list(spec, add(dsjd-row-hits(head(rows)), 1)), tail(rows)) else cons(head(rows), dsjd-bump-rows(tail(rows), spec));
        def dsjd-touch(discovery, spec) = if not(eq(dsjd-epoch(discovery), dsjd-spec-epoch(spec))) then nothing() else list(dsjd-epoch(discovery), dsjd-bump-rows(dsjd-rows(discovery), spec));

        // result = value, discovery, status.  Timeout keeps observation.
        def dsjd-result(value, discovery, status) = list(value, discovery, status);
        def dsjd-result-value(result) = nth(result, 0);
        def dsjd-result-discovery(result) = nth(result, 1);
        def dsjd-result-status(result) = nth(result, 2);
        def dsjd-sum-down-go(spec, discovery, n, fuel) = if le(fuel, 0) then dsjd-result(nothing(), discovery, "timeout") else dsjd-sum-down-touch(spec, discovery, n, fuel);
        def dsjd-sum-down-touch(spec, discovery, n, fuel) {
            let seen = dsjd-touch(discovery, spec);
            if nothing?(seen) then dsjd-result(nothing(), discovery, "refused") else if eq(n, 0) then dsjd-result(0, seen, "done") else dsjd-sum-down-recur(spec, seen, n, fuel);
        }
        def dsjd-sum-down-recur(spec, seen, n, fuel) {
            let below = dsjd-sum-down-go(spec, seen, sub(n, 1), sub(fuel, 1));
            if str_eq(dsjd-result-status(below), "done") then dsjd-result(add(n, dsjd-result-value(below)), dsjd-result-discovery(below), "done") else below;
        }
        def dsjd-observe-sum-down(discovery, n, fuel) = if lt(n, 0) then dsjd-result(nothing(), discovery, "refused") else dsjd-sum-down-go(dsjd-sum-spec(dsjd-epoch(discovery)), discovery, n, fuel);

        // Heat is recomputed from the candidate, never transferred as a claim.
        def dsjd-hot?(row) = jd-crystallize?(dsjd-row-hits(row), hg-lowerable?(dsjd-spec-program(dsjd-row-spec(row))));
        def dsjd-hot-rows(rows) = if eq(len(rows), 0) then list() else dsjd-hot-rows-include(head(rows), dsjd-hot-rows(tail(rows)));
        def dsjd-hot-rows-include(row, rest) = if eq(dsjd-hot?(row), 1) then cons(row, rest) else rest;
        def dsjd-max-hits(rows, maximum) = if eq(len(rows), 0) then maximum else dsjd-max-hits(tail(rows), max2(maximum, dsjd-row-hits(head(rows))));
        def dsjd-at-hits(rows, hits) = if eq(len(rows), 0) then list() else dsjd-at-hits-include(head(rows), dsjd-at-hits(tail(rows), hits), hits);
        def dsjd-at-hits-include(row, rest, hits) = if eq(dsjd-row-hits(row), hits) then cons(row, rest) else rest;
        def dsjd-hot-choice(discovery) {
            let hot = dsjd-hot-rows(dsjd-rows(discovery));
            if eq(len(hot), 0) then list() else dsjd-at-hits(hot, dsjd-max-hits(hot, 0));
        }

        // Explicit cut: unknown selection is exactly nothing.
        def dsjd-cut(choice, function_id) = if eq(len(choice), 0) then nothing() else if node_eq(dsjd-row-function-id(head(choice)), function_id) then head(choice) else dsjd-cut(tail(choice), function_id);

        // receipt = value, route, gate-before, gate-after, born,
        //           function-id, candidate-id, cold-challenger, agreement.
        def dsjd-offer(gate, row, argument) = if nothing?(row) then nothing() else dsjd-offer-row(gate, row, argument);
        def dsjd-offer-row(gate, row, argument) {
            let spec = dsjd-row-spec(row);
            let expected = jonb-identity(dsjd-spec-program(spec), dsjd-spec-root(spec), jonb-epoch(hg-reg(gate)));
            if not(node_eq(expected, dsjd-spec-candidate-id(spec))) then nothing() else if eq(dsjd-hot?(row), 0) then nothing() else dsjd-offer-hot(gate, spec, argument);
        }
        def dsjd-offer-hot(gate, spec, argument) {
            let cold = jonb-eval(dsjd-spec-program(spec), dsjd-spec-root(spec), argument);
            let response = hg-request(gate, dsjd-spec-program(spec), dsjd-spec-root(spec), argument);
            list(nth(response, 0), nth(response, 1), gate, nth(response, 2), nth(response, 3), dsjd-spec-function-id(spec), dsjd-spec-candidate-id(spec), cold, value_eq(nth(response, 0), cold));
        }
        def dsjd-offer-after(receipt) = nth(receipt, 3);
        def dsjd-offer-born(receipt) = nth(receipt, 4);
        def dsjd-offer-agrees?(receipt) = nth(receipt, 8);
        def dsjd-undo(receipt) = if nothing?(receipt) then nothing() else nth(receipt, 2);
    }
    0;
}
