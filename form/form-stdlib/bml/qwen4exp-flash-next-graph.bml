//////////////////////////////////////////////////////////////////////
//
// qwen4exp-flash-next-graph.bml — architecture authority for the
// downloaded Qwen3.8 Flash Next preview artifact.
//
// This names execution order and geometry. llama.cpp is a numerical
// oracle only; no function or server from it inhabits this graph.
//
//////////////////////////////////////////////////////////////////////

package Form.native.qwen4exp;

import Form.kernel.*;
import Form.native.metal.*;

interface IQwen4ExpFlashNextGraph [public, witness, reusable] {
   section [public] {
      const int Layers = 48;
      const int Width = 2560;
      const int HyperStreams = 4;
      const int HyperWidth = 10240;
      const int HyperLowRank = 320;
      const int FullAttentionInterval = 4;
      const int FullAttentionHeads = 24;
      const int KVHeads = 2;
      const int HeadWidth = 256;
      const int RopeWidth = 64;
      const int GDNInner = 6144;
      const int GDNKeyHeads = 16;
      const int GDNValueHeads = 48;
      const int GDNStateWidth = 128;
      const int Experts = 512;
      const int SelectedExperts = 10;
      const int ExpertWidth = 640;
      const int IndexerHeads = 4;
      const int IndexerHeadWidth = 128;
      const int IndexerTopK = 2048;
      const int PLELayer = 1;
      const int PLENgram = 3;
      const int PLEHeadsPerNgram = 8;
      const int PLEHeads = 16;
      const int PLEHeadWidth = 160;
      const int PLEConvKernel = 4;
      const int PLEHistory = 9;
      const int NativeContext = 262144;
      const int TargetContext = 358400;
      const String Runtime = "form-native-metal-jit";
      const String ExternalRuntime = "none";

      bool IsFullAttention( int layer ) [abstract];
      bool IsPLE( int layer ) [abstract];
      int QSAWidth( int kvTokens, int compressionRatio ) [abstract];
      int ExpertBase( int expert, int rows, int columns ) [abstract];
   }
}

class Qwen4ExpFlashNextGraph [public, reusable, observable] : IQwen4ExpFlashNextGraph {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/qwen4exp-flash-next-graph.bml";
      const String Model = "Qwen3.8-Flash-Next UD-Q2_K_XL";

      bool IsFullAttention( int layer ) [abstract] {}
      bool IsPLE( int layer ) [abstract] {}
      int QSAWidth( int kvTokens, int compressionRatio ) [abstract] {}
      int ExpertBase( int expert, int rows, int columns ) [abstract] {}
   }
}
