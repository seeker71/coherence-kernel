// Existing byte-list filesystem doors, carried above the host byte string.
import form-stdlib/core.fk;
import form-stdlib/bml/string-join.bml;
section [form.bml] {
 def read_file_bytes(path) {
  let text=host_file_read_text(path);
  nothing?(text) ? nothing() : range(0,len(text)) |> map(i=>str_byte_at(text,i));
 }
 def write_file_bytes(path,bytes) = value_kind(bytes) != "list" || !all?(byte=>value_kind(byte)=="int" && byte>=0 && byte<=255,bytes) ? nothing() : host_file_write_text(path,str-join-with(map(byte_to_str,bytes),""));
}
