  nil?(ids) ? kas-node(state,18,0,0,0) : {
   let head=kas-raw(record_get(state,"pid"),["syntax-node",ids[0]]);
    head[0]!="name" ? kas-node(state,244,kas-expr(state,ids[0],env),kas-chain(state,ids[1:],env),0) : {
    let name=head[1]; let args=ids[1:];
     !nothing?(kas-env(env,name)) ? kas-node(state,244,kas-expr(state,ids[0],env),kas-chain(state,args,env),0) : name=="do" ? kas-sequence(state,args,env) : name=="list" ? kas-list(state,args,env) : name=="lambda" ? {
      let index=kas-lambda-register(state,node,record_get(state,"active_owner"),record_get(state,"active_fn"),map(binding=>binding[0],env));
      let captures=record_get(record_get(record_get(state,"functions"),index.str()),"captures");
      let chain=foldl((rest,capture)=>kas-node(state,242,kas-node(state,110,kas-int(state,kas-env(env,capture)),0,0),rest,0),-1,reverse(captures));
      kas-node(state,243,index,chain,0);
     } : name=="let" && len(args)>=2 ? {
      let binding=kas-raw(record_get(state,"pid"),["syntax-node",args[0]])[1];let value=kas-expr(state,args[1],env);let slot=kas-slot(state);
      kas-node(state,109,kas-int(state,slot),value,len(args)>2 ? kas-sequence(state,args[2:],cons([binding,slot],env)) : kas-node(state,110,kas-int(state,slot),0,0));
     } : name=="if" && len(args)==3 ? kas-node(state,6,kas-expr(state,args[0],env),kas-expr(state,args[1],env),kas-expr(state,args[2],env)) : {
     let op=kas-raw(record_get(state,"pid"),["syntax-operation",name]);
     let callee=kas-lookup(state,node[3],name);
      !nothing?(op) && (op[0]==64 || op[0]==239) ? kas-node(state,op[0],kas-list(state,args,env),0,0) : !nothing?(op) && (!nil?(op[4]) || (op[0]>0 && len(args)<=3)) ? {
      let lowered=map(arg=>kas-expr(state,arg,env),args);
      !nil?(op[4]) ? kas-rewrite(state,op[4],lowered,[]) : kas-node(state,op[0],len(lowered)>0 ? lowered[0] : 0,len(lowered)>1 ? lowered[1] : 0,len(lowered)>2 ? lowered[2] : 0);
      } : !nothing?(callee) ? kas-node(state,241,callee,kas-chain(state,args,env),0) : kas-unavailable(state,node,env,op,callee);
