   },record_get(catalog,"units")));copy;
  }
 def kas-query(pid,query) {
  let state=kas-state(pid);
  nothing?(state) ? nothing() : value_kind(query)=="int" ? query<0 ? [record_get(state,"next"),len(record_get(state,"source")),record_get(state,"header")[1],record_get(state,"header")[1]+1,0,0,0,0,0,""] : record_get(record_get(state,"nodes"),query.str()) : value_kind(query)!="list" || nil?(query) ? nothing() :
   query[0]=="defn" ? kas-row(state,query[1]) :
