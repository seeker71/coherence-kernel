 }
 def kas-row(state,j) {
  let rows=record_get(state,"rows"); let key=j.str(); let held=record_get(rows,key);
  nothing?(held) ? {
    let entry=record_get(record_get(state,"functions"),(j+1).str());
    nothing?(entry) ? nothing() : {
     let raw=record_get(entry,"raw");let previousOwner=record_get(state,"active_owner");let previousFn=record_get(state,"active_fn");
     record_set(state,"active_owner",raw[5]);record_set(state,"active_fn",j+1);
     let params=append(raw[1],record_get(entry,"captures")); let env=map(i=>[params[i],i],range(0,len(params)));
    record_set(state,"slot",len(params));
    let body=kas-expr(state,raw[2],env);
     let slots=record_get(state,"slot");
     let framed=kas-node(state,111,kas-int(state,slots > 0 ? slots - 1 : 0),body,0);
    let bodySource=kas-raw(record_get(state,"pid"),["syntax-node",raw[2]]);
     let sourceKey=raw[5].str()+":"+bodySource[3]; let heldBase=record_get(record_get(state,"sources"),sourceKey);
    let base=nothing?(heldBase) ? {
     let source=record_get(state,"source");
     let admitted=kas-raw(record_get(state,"pid"),["syntax-source",raw[2]]);
     record_set(state,"source",source+admitted); record_set(record_get(state,"sources"),sourceKey,len(source)); len(source);
    } : heldBase;
    let at=base+raw[4];
    let named=substring(record_get(state,"source"),at,at+len(raw[0]));
    let actual=named==raw[0] ? at : {let source=record_get(state,"source"); record_set(state,"source",source+raw[0]); len(source);};
     let row=[actual,len(raw[0]),j+1,framed]; record_set(rows,key,row);
     record_set(state,"active_owner",previousOwner);record_set(state,"active_fn",previousFn);row;
   };
  } : held;
 }
  def kas-index(state,requested)=value_kind(requested)=="int" ? record_has(record_get(state,"functions"),requested.str()) ? requested : nothing() :
   value_kind(requested)=="string" ? record_get(record_get(state,"names"),requested) : kas-callable-index(state,requested);
 def kas-function(state,requested) {
  let index=kas-index(state,requested);
   nothing?(index) ? nothing() : {let entry=record_get(record_get(state,"functions"),index.str());nil?(record_get(entry,"captures")) ? [kas-row(state,index - 1)[3],len(record_get(entry,"raw")[1])] : nothing();};
 }
 def kas-source-hash(row) {
  let key=row[2].str(); let held=record_get(kas-source-hashes,key);
  nothing?(held) ? {let fingerprint=bml-source-fingerprint(row[1]); record_set(kas-source-hashes,key,fingerprint); fingerprint;} : held;
 }
 // Length-framed values preserve names and source paths without delimiter guesses.
 def kas-wire(value)=value_kind(value)=="list" ? "l"+len(value).str()+":"+str-join-with(map(kas-wire,value),"") : value_kind(value)=="string" ? "s"+len(value).str()+":"+value : value_kind(value)=="int" ? "i"+value.str()+";" : form_error("source admission contains an unsupported identity field");
 def kas-admission-visit(pid,owner,graph) {
  owner==0 ? -1 : {
   let key=owner.str(); let seen=record_get(record_get(graph,"seen"),key);
   !nothing?(seen) ? seen : {
    let index=record_get(graph,"next"); record_set(graph,"next",index+1);
    record_set(record_get(graph,"seen"),key,index);
    let raw=kas-raw(pid,["syntax-program",owner]);
    nothing?(raw) ? form_error("admitted source owner is unavailable") : {
     let sources=map(row=>[row[0],len(row[1]),kas-source-hash(row)],raw[2]);
     let bindings=map(row=>[row[0],kas-admission-visit(pid,row[1],graph),row[2],row[3]],raw[3]);
     let parent=kas-admission-visit(pid,raw[4],graph);
     record_set(record_get(graph,"members"),index.str(),[raw[1],sources,bindings,parent]); index;
    };
   };
  };
 }
 def kas-identity(state,requested) {
   let selected=value_kind(requested)=="string" || value_kind(requested)=="int" ? kas-index(state,requested) : requested;
   (value_kind(requested)=="string" || value_kind(requested)=="int") && nothing?(selected) ? nothing() : {
   let pid=record_get(state,"pid"); let owner=value_kind(selected)=="int" ? record_get(record_get(record_get(state,"functions"),selected.str()),"raw")[5] : kas-raw(pid,["syntax-owner",selected]);
   kas-owner-identity(state,owner);
   };
  }
  def kas-owner-identity(state,owner) {
  nothing?(owner) ? nothing() : {
  let key="identity:"+owner.str(); let held=record_get(state,key);
  !nothing?(held) ? held : {
   let graph=record_new(0,"next",0,"seen",record_new(0),"members",record_new(0));
    let pid=record_get(state,"pid");kas-admission-visit(pid,owner,graph);
   let members=map(i=>record_get(record_get(graph,"members"),i.str()),range(0,record_get(graph,"next")));
   let identity=[kas-raw(pid,["syntax-builder"]),"fk-unit-v4|form-surface-v1|"+bml-source-fingerprint(kas-wire(members))];
   record_set(state,key,identity); identity;
    }; };
  }
  def kas-function-meta(state,requested) {
   let index=kas-index(state,requested);
   nothing?(index) ? nothing() : {
    let entry=record_get(record_get(state,"functions"),index.str());let raw=record_get(entry,"raw");
    [kas-row(state,index - 1)[3],len(raw[1]),len(record_get(entry,"captures")),record_get(entry,"parent"),kas-owner-identity(state,raw[5])];
   };
  }
  def kas-top-expression(state,id) {
   let node=kas-raw(record_get(state,"pid"),["syntax-node",id]);let head=kas-head(state,node);
   head=="defn" ? -1 : head=="do" ? kas-top-sequence(state,node[2][1:]) : head=="let" && len(node[2])==3 ? {
    let name=kas-raw(record_get(state,"pid"),["syntax-node",node[2][1]])[1];
    kas-initializer(state,[node[2][2],record_get(state,"active_owner"),node[3],name]);
   } : kas-expr(state,id,[]);
  }
  def kas-top-sequence(state,ids) = foldl((prior,id)=>{
   let next=kas-top-expression(state,id);next<0 ? prior : prior<0 ? next : kas-node(state,69,prior,next,0);
  },-1,ids);
  def kas-export-names(state,roots,outer) = foldl((names,id)=>{
   let node=kas-raw(record_get(state,"pid"),["syntax-node",id]);let head=kas-head(state,node);
   head=="defn" ? append(names,[kas-raw(record_get(state,"pid"),["syntax-node",node[2][1]])[1]]) : head=="do" && outer ? append(names,kas-export-names(state,node[2][1:],0)) : names;
  },[],roots);
  def kas-catalog-visit(state,owner,graph) {
   let seen=record_get(graph,"seen");let key=owner.str();
   record_has(seen,key) ? 0 : {
    record_set(seen,key,1);kas-prepare-program(state,owner);let raw=kas-program(state,owner);
    map(edge=>kas-catalog-visit(state,edge[3],graph),raw[6]);
    record_set(graph,"order",append(record_get(graph,"order"),[owner]));0;
   };
  }
  def kas-catalog-sources(state,order) {
   let owners=record_new(0);let sources=record_new(0);
   map(owner=>map(source=>{
    let key=source[2].str();
    if !record_has(sources,key) then {record_set(sources,key,source);record_set(owners,key,owner);} else 0;
   },kas-program(state,owner)[2]),order);
   map(source=>[record_get(owners,source[2].str()),source],kas-source-order(map(key=>record_get(sources,key),record_keys(sources))));
  }
  def kas-catalog(state,requested) {
   let index=kas-index(state,requested);
   nothing?(index) ? nothing() : {
    let entry=record_get(record_get(state,"functions"),index.str());let owner=record_get(entry,"raw")[5];let key="catalog:"+owner.str();let held=record_get(state,key);
    !nothing?(held) ? kas-catalog-copy(held) : {
     let graph=record_new(0,"seen",record_new(0),"order",[]);kas-catalog-visit(state,owner,graph);
     let order=record_get(graph,"order");let sources=kas-catalog-sources(state,order);let exports=record_new(0,"rows",[]);let constants=record_new(0,"rows",[]);let contexts=record_new(0,"rows",[]);
     let previousOwner=record_get(state,"active_owner");let previousFn=record_get(state,"active_fn");
     let units=map(at=>{
      let unitOwner=sources[at][0];let source=sources[at][1];let unit=source[2];let raw=kas-program(state,unitOwner);record_set(state,"active_owner",unitOwner);record_set(state,"active_fn",-1);
       // An admitted empty unit retains its source identity and imports, but
