       let sourcePath=nil?(source[3]) ? source[0] : kas-raw(record_get(state,"pid"),["syntax-node",source[3][0]])[3];
      let sequence=kas-top-sequence(state,source[3]);
       map(name=>{let fn=kas-lookup-owner(state,unitOwner,sourcePath,name);let descriptor=record_get(record_get(record_get(state,"functions"),fn.str()),"raw");
       record_set(exports,"rows",append(record_get(exports,"rows"),[[name,fn,len(descriptor[1]),unit]]));
      },kas-export-names(state,source[3],1));
      let globals=record_get(state,"globals");map(name=>{let row=record_get(globals,name);
        row[1]==unitOwner && row[2]==sourcePath ? record_set(constants,"rows",append(record_get(constants,"rows"),[[row[3],kas-initializer(state,row),unit]])) : 0;
      },record_keys(globals));
      raw[4]>0 ? record_set(contexts,"rows",append(record_get(contexts,"rows"),[[unit,kas-owner-identity(state,raw[4])]])) : 0;
      let members=map(row=>row[2],raw[2]);
