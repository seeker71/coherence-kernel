 def kas-node(state,tag,a,b,c) {
  let id=record_get(state,"next"); record_set(state,"next",id+1);
  record_set(record_get(state,"nodes"),id.str(),[tag,a,b,c]); id;
 }
 def kas-int(state,value)=kas-node(state,1,value,0,0);
 def kas-slot(state) { let slot=record_get(state,"slot"); record_set(state,"slot",slot+1); slot; }
 def kas-env(env,name)=nil?(env) ? nothing() : env[0][0]==name ? env[0][1] : kas-env(env[1:],name);
 def kas-text(state,text) {
  let source=record_get(state,"source"); let at=len(source);
   // An empty literal still owns a distinct pool coordinate. The separator is
