     record_set(record_get(state,"names"),row[0],j+1);
     record_set(record_get(state,"owned"),body[3]+"\n"+row[0],j+1);
      record_set(record_get(state,"functions"),(j+1).str(),record_new(0,"raw",row,"parent",-1,"captures",[]));
      record_set(record_get(state,"function_ids"),kas-function-key(row),j+1);
    });
    record_set(kas-surfaces,key,state); state;
   } : held;
  };
 }
  def kas-function-key(raw)=raw[5].str()+":"+raw[2].str();
  def kas-program(state,owner) {
   let programs=record_get(state,"programs");let key=owner.str();
   !record_has(programs,key) ? {let raw=kas-raw(record_get(state,"pid"),["syntax-program",owner]);record_set(programs,key,raw);raw;} : record_get(programs,key);
  }
  def kas-register(state,raw,parent,captures) {
