    head=="do" ? kas-global-declarations(state,owner,node[2][1:]) : head=="let" && len(node[2])==3 ? {
     let name=kas-raw(record_get(state,"pid"),["syntax-node",node[2][1]])[1];let row=[node[2][2],owner,node[3],name];
     record_set(record_get(state,"globals"),owner.str()+":"+node[3]+"\n"+name,row);
