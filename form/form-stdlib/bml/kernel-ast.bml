// The source view owns lexical slots and the legacy node projection in Form.
// kernel_ast's syntax-* readings transport the admitted parser objects only.
import form-stdlib/core.fk;
import form-stdlib/bml-source.fk;
import form-stdlib/bml/string-join.bml;
import form-stdlib/bml/json-view.bml;
section [form.bml] {
 let kas-surfaces=record_new(0);
 let kas-source-hashes=record_new(0);
 def kas-raw(pid,query)=kernel_ast(pid,query);
  // Counts are measured at actual Form body entry. Selection and the legacy
  // text surface belong here, beside the source metadata they describe.
  def kas-hot-sort(rows,key) = len(rows)<2 ? rows : {
   let pivot=rows[len(rows)/2][key];
   append(kas-hot-sort(filter(row=>row[key]>pivot,rows),key),append(filter(row=>row[key]==pivot,rows),kas-hot-sort(filter(row=>row[key]<pivot,rows),key)));
  };
  def kas-hot-rows(n,key) = value_kind(n)!="int" ? nothing() : n<=0 ? [] : take(n,kas-hot-sort(filter(row=>row[key]>0,kas-raw(host_pid(),["syntax-heat",0])),key));
  def kernel_hot_rows(n) = kas-hot-rows(n,0);
  def kernel_box_rows(n) = kas-hot-rows(n,5);
  def kernel_hot(n) = str-join-with(map(row=>row[0].str()+"|"+row[1]+"|"+row[2]+"|"+row[3].str()+"|"+row[4].str()+"\n",kernel_hot_rows(n)),"");
  // The rewrite has no retained asynchronous/foreign heat sampler. Absence is
  // distinct from an observed empty ranking in the current process.
  def kernel_page_hot(pid,n) = pid != host_pid() || n==0 ? nothing() : kas-hot-rows(n<0 ? 0 - n : n,n<0 ? 9 : 0);
  def kernel_page_box(pid,n) = pid != host_pid() ? nothing() : kas-hot-rows(n<0 ? 0 - n : n,n<0 ? 8 : 5);
 // Binding admission is a source operation. The seed supplies syntax and applies
 // the resulting unresolved sites; it does not carry a second lexical grammar.
 def kas-check-node(state,id) {
  let nodes=record_get(state,"nodes"); let key=id.str(); let held=record_get(nodes,key);
  nothing?(held) ? {let node=kas-raw(record_get(state,"pid"),["syntax-node",id]);record_set(nodes,key,node);node;} : held;
 }
 def kas-check-head(state,node)=node[0]=="group" && len(node[2])>0 ? kas-check-node(state,node[2][0])[1] : nothing();
 def kas-check-globals(state,ids) {
  map(id=>{
   let node=kas-check-node(state,id); let head=kas-check-head(state,node);
   head=="do" ? kas-check-globals(state,node[2][1:]) : head=="let" && len(node[2])==3 ? record_set(record_get(state,"names"),kas-check-node(state,node[2][1])[1],1) : 0;
  },ids); 0;
 }
 def kas-check-known(state,name,env) {
   name=="true" || name=="false" || record_has(record_get(state,"names"),name) ? 1 : {
   let operations=record_get(state,"operations"); let held=record_get(operations,name);
    let known=nothing?(held) ? {let observed=kas-raw(record_get(state,"pid"),["syntax-declared-operation",name]);record_set(operations,name,observed);observed;} : held;
    // Positive global/operation membership is indexed. A negative operation
    // observation still permits a lexical binding in this exact scope.
    known==1 || !nothing?(kas-env(env,name));
  };
 }
 def kas-check-missing(state,id,node,name,refuse) {
  let missing=record_get(state,"missing");
  record_has(missing,id.str()) ? 0 : {
   let detail="unresolved binding: "+name;
   let source=kas-raw(record_get(state,"pid"),["syntax-source",id]);
   let line=1+len(filter(i=>char_at(source,i)=="\n",range(0,node[4]))); let at=now_unix_ms();
   let diagnostic=record_new(0,"organ","fkwu-compiler","aspect","diagnostic","stage","observe","observed","binding-missing","detail",detail,"path",node[3],"name",name,"line",line,"health",0,"at_ms",at);
   let text="form-organ health "+jv-emit(jv-object([jv-s("organ","fkwu-compiler"),jv-s("aspect","diagnostic"),jv-s("stage","observe"),jv-s("observed","binding-missing"),jv-s("detail",detail),jv-s("path",node[3]),jv-s("name",name),jv-n("line",line),jv-n("health",0),jv-n("at_ms",at)]))+"\n";
   record_set(missing,id.str(),[id,diagnostic,text,refuse]);
  };
 }
 def kas-check-sequence(state,ids,env) {
  nil?(ids) ? 0 : {
   kas-check-expression(state,ids[0],env);
   let next=kas-check-bound(state,ids[0],env);
   kas-check-sequence(state,ids[1:],next);
  };
 }
 // BML destructuring lowers to a do of ordinary unscoped lets. A do forwards
 // those bindings to the following statement just as the executing scope does;
 // scoped lets and conditional alternatives keep their own environments.
 def kas-check-bound(state,id,env) {
  let node=kas-check-node(state,id); let head=kas-check-head(state,node);
  head=="do" ? foldl((scope,child)=>kas-check-bound(state,child,scope),env,node[2][1:]) :
  (head=="let" && len(node[2])==3) || (head=="defn" && len(node[2])==4) ? cons([kas-check-node(state,node[2][1])[1],1],env) : env;
 }
 def kas-check-expression(state,id,env) {
  let node=kas-check-node(state,id);
  node[0]=="name" ? (kas-check-known(state,node[1],env) ? 0 : kas-check-missing(state,id,node,node[1],1)) : node[0]!="group" || nil?(node[2]) ? 0 : {
   let ids=node[2]; let head=kas-check-head(state,node);
   head=="defn" && len(ids)==4 ? {
    let name=kas-check-node(state,ids[1])[1]; let params=kas-check-node(state,ids[2])[2];
    kas-check-expression(state,ids[3],append(map(p=>[kas-check-node(state,p)[1],1],params),cons([name,1],env)));
   } : head=="lambda" && len(ids)==3 ? {
    let params=kas-check-node(state,ids[1])[2]; kas-check-expression(state,ids[2],append(map(p=>[kas-check-node(state,p)[1],1],params),env));
   } : head=="let" && len(ids)>=3 ? {
    kas-check-expression(state,ids[2],env);
    len(ids)>3 ? kas-check-sequence(state,ids[3:],cons([kas-check-node(state,ids[1])[1],1],env)) : 0;
   } : head=="do" ? kas-check-sequence(state,ids[1:],env) : {
    let named=kas-check-node(state,ids[0])[0]=="name";
    named && !kas-check-known(state,head,env) ? kas-check-missing(state,id,node,head,0) : {
     named ? 0 : kas-check-expression(state,ids[0],env);
     map(child=>kas-check-expression(state,child,env),ids[1:]); 0;
    };
   };
  };
 }
 def kas-check(pid) {
  let state=record_new(0,"pid",pid,"nodes",record_new(0),"names",record_new(0),"operations",record_new(0),"missing",record_new(0));
  let units=kas-raw(pid,["syntax-all-roots"]); let header=kas-raw(pid,["syntax-header"]);
  map(i=>record_set(record_get(state,"names"),kas-raw(pid,["syntax-function",i])[0],1),range(0,header[1]));
  map(unit=>kas-check-globals(state,unit[1]),units);
  // An imported incarnation retains its first admission's lexical outcome.
  // A later caller's names cannot heal or invalidate that owner's syntax.
  map(unit=>nothing?(unit[2]) ? kas-check-sequence(state,unit[1],[]) : map(row=>record_set(record_get(state,"missing"),row[0].str(),row),unit[2]),units);
  let missing=record_get(state,"missing"); map(key=>record_get(missing,key),record_keys(missing));
 }
 def kas-state(pid) {
  let header=kas-raw(pid,["syntax-header"]);
  nothing?(header) ? nothing() : {
   let key=pid.str()+":"+header[0].str();
   let held=record_get(kas-surfaces,key);
   nothing?(held) ? {
     let state=record_new(0,"pid",pid,"header",header,"nodes",record_new(0),"rows",record_new(0),"strings",record_new(0),"source","","sources",record_new(0),"next",1,"slot",0,"names",record_new(0),"owned",record_new(0),"functions",record_new(0),"function_ids",record_new(0),"next_function",header[1]+1,"programs",record_new(0),"prepared",record_new(0),"globals",record_new(0),"global_names",record_new(0),"initializers",record_new(0),"active_owner",header[0],"active_fn",-1);
    range(0,header[1]) |> map(j=>{
     let row=kas-raw(pid,["syntax-function",j]);
