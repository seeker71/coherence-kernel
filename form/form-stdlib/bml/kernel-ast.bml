     record_set(state,key,catalog);kas-catalog-copy(catalog);
    };
   };
 }
  def kas-catalog-copy(catalog) {
   let copy=record_new(0);map(key=>record_set(copy,key,record_get(catalog,key)),record_keys(catalog));
   record_set(copy,"units",map(unit=>{
