   },ids);0;
  }
  def kas-prepare-program(state,owner) {
   let key=owner.str();let prepared=record_get(state,"prepared");
   record_has(prepared,key) ? 1 : {
    record_set(prepared,key,1);let raw=kas-program(state,owner);
