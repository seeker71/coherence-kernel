// The reunion: the body goes and gets what origin gained while it was walking.
//
// A landing whose push is refused is not blocked. Origin holds rows this
// checkout has not seen, and this checkout holds rows origin has not; both are
// true, and joining them is ordinary. A hand did this six times on 2026-09-22
// and it never varied.
//
// The body recognises a river by reading it, not by where it lives: if every
// line on both banks is a row carrying the moment it was written, then the two
// banks are one river and the union is simply all of it, each row once, in the
// order the rows happened. A caller says what it can draw again — a page made
// from the rows is not worth merging, it is remade once the rows agree.
//
// And when the body meets a kind it has not learned, it does not refuse. It
// looks, keeps both banks where they can be read, says what it saw and what it
// could do, and lets go of the attempt so the checkout stands clean. An
// unlearned kind is unfinished work, and the next reunion can know it.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/meaning-codes.bml
section [form.bml] {
 class FormCliReunion {
  def fcr-mine() = "<<<<<<<";
  def fcr-theirs() = ">>>>>>>";
  def fcr-split() = "=======";
  // A row is a line that says when it was written. A river is a file whose every
  // live line is one — both banks of it, markers aside. The body reads the file to
  // know this; nothing depends on where the file sits or what it is called.
  def fcr-row?(line) = and(and(gt(str_len(line), 0), eq(str_byte_at(line, 0), 123)), ge(str_find(line, "\"at_unix_ms\":", 0), 0));
  def fcr-all-rows?(xs) = if nil?(xs) then 1 else if eq(fcr-row?(head(xs)), 1) then fcr-all-rows?(tail(xs)) else 0;
  def fcr-river?(path) = fcr-river-of(if gt(file_size(path), 0) then fhn-read(path) else "");
  def fcr-river-of(text) = if str_eq(trim(text), "") then 0 else fcr-all-rows?(fcr-without-marks(fcr-live(split-on(text, "\n"))));
  def fcr-among?(paths, path) = if nil?(paths) then 0 else if str_eq(trim(head(paths)), path) then 1 else fcr-among?(tail(paths), path);
  def fcr-known?(path, drawn) = or(fcr-river?(path), fcr-among?(drawn, path));
  // ── the union of two banks of rows ──
  def fcr-live(xs) = if nil?(xs) then list() else if str_eq(trim(head(xs)), "") then fcr-live(tail(xs)) else cons(head(xs), fcr-live(tail(xs)));
  def fcr-marked?(line, mark) = eq(str_find(line, mark, 0), 0);
  def fcr-any-mark?(line) = or(fcr-marked?(line, fcr-mine()), or(fcr-marked?(line, fcr-theirs()), fcr-marked?(line, fcr-split())));
  def fcr-without-marks(xs) = if nil?(xs) then list() else if fcr-any-mark?(head(xs)) then fcr-without-marks(tail(xs)) else cons(head(xs), fcr-without-marks(tail(xs)));
  def fcr-digit?(b) = and(ge(b, 48), le(b, 57));
  def fcr-digits(text, i, acc) = if and(lt(i, str_len(text)), fcr-digit?(str_byte_at(text, i))) then fcr-digits(text, add(i, 1), add(mul(acc, 10), sub(str_byte_at(text, i), 48))) else acc;
  def fcr-when(line) { let at = str_find(line, "\"at_unix_ms\":", 0); if lt(at, 0) then 0 else fcr-digits(line, add(at, 13), 0); }
  def fcr-seen?(xs, line) = if nil?(xs) then 0 else if str_eq(head(xs), line) then 1 else fcr-seen?(tail(xs), line);
  def fcr-once(xs, kept) = if nil?(xs) then kept else fcr-once(tail(xs), if eq(fcr-seen?(kept, head(xs)), 1) then kept else append(kept, list(head(xs))));
  def fcr-insert(row, sorted) = if nil?(sorted) then list(row) else if le(fcr-when(row), fcr-when(head(sorted))) then cons(row, sorted) else cons(head(sorted), fcr-insert(row, tail(sorted)));
  def fcr-order(xs, sorted) = if nil?(xs) then sorted else fcr-order(tail(xs), fcr-insert(head(xs), sorted));
  def fcr-join(xs) = if nil?(xs) then "" else mc-cat(list(head(xs), "\n", fcr-join(tail(xs))));
  // Both banks, each row once, in the order the rows were written.
  def fcr-union(text) = fcr-join(fcr-order(fcr-once(fcr-without-marks(fcr-live(split-on(text, "\n"))), list()), list()));
  def fcr-settle-ledger(path) = write_file_text(path, fcr-union(fhn-read(path)));
  // ── the walk ──
  def fcr-run(cmd) = fcr-said(host-exec(cmd, ""));
  def fcr-said(out) = if nothing?(out) then "" else out;
  def fcr-ok?(out) = ge(str_find(out, "[ok] exit=0", 0), 0);
  def fcr-exit(cmd) = fcr-run(mc-cat(list("out=$(", cmd, " 2>&1); code=$?; printf '[ok] exit=%s %s\\n' \"$code\" \"$(printf '%s' \"$out\" | tail -n 1)\"")));
  def fcr-conflicts() = fcr-live(split-on(trim(fcr-run("git diff --name-only --diff-filter=U 2>/dev/null")), "\n"));
  def fcr-unlearned(paths, drawn) = if nil?(paths) then list() else if fcr-known?(trim(head(paths)), drawn) then fcr-unlearned(tail(paths), drawn) else cons(trim(head(paths)), fcr-unlearned(tail(paths), drawn));
  def fcr-redraws?(paths, drawn) = if nil?(paths) then 0 else if fcr-among?(drawn, trim(head(paths))) then 1 else fcr-redraws?(tail(paths), drawn);
  def fcr-settle(path) = if fcr-river?(path) then fcr-settle-then(path, fcr-settle-ledger(path)) else fcr-settle-then(path, fcr-run(mc-cat(list("git checkout --theirs ", path, " 2>/dev/null"))));
  def fcr-settle-then(path, settled) = fcr-run(mc-cat(list("git add ", path, " 2>/dev/null")));
  def fcr-settle-all(paths) = if nil?(paths) then 0 else fcr-settle-all-next(tail(paths), fcr-settle(trim(head(paths))));
  def fcr-settle-all-next(rest, done) = fcr-settle-all(rest);
  // Each round: settle what the body may settle, or stop at the wall and undo
  // the rebase, so a checkout is never left standing in a half-joined state.
  def fcr-rounds(round, redraw, drawn) {
   let conflicts = fcr-conflicts();
   if nil?(conflicts) then list("joined", "", drawn)
   else if ge(round, 8) then fcr-unlearned-kind("the same conflict came back eight times", conflicts)
   else fcr-round-at(round, redraw, drawn, conflicts, fcr-unlearned(conflicts, redraw));
  }
  def fcr-round-at(round, redraw, drawn, conflicts, unlearned) {
   if not(nil?(unlearned)) then fcr-unlearned-kind(head(unlearned), conflicts)
   else fcr-round-go(round, redraw, or(eq(drawn, 1), eq(fcr-redraws?(conflicts, redraw), 1)), fcr-settle-all(conflicts));
  }
  def fcr-round-go(round, redraw, drawn, settled) = fcr-rounds-after(round, redraw, drawn, fcr-exit("git -c core.editor=true rebase --continue"));
  def fcr-rounds-after(round, redraw, drawn, out) = fcr-rounds(add(round, 1), redraw, if drawn then 1 else 0);
  def fcr-wall(path, drawn) = fcr-wall-undone(path, fcr-run("git rebase --abort 2>/dev/null"));
  def fcr-wall-undone(path, undone) = list("wall", path, 0);
  // A kind the body has not learned. Not a refusal: both banks are kept where a
  // person or a later door can read them, the attempt is let go so the checkout
  // stands clean, and what was seen is said with what could be done about it.
  def fcr-keep() = fhn-at(fhn-at(fhn-root(), ".form-heal"), "reunion-unlearned");
  def fcr-keep-banks(paths) = fcr-keep-go(paths, fs_mkdir(fcr-keep()));
  def fcr-keep-go(paths, made) = if nil?(paths) then 0 else fcr-keep-next(tail(paths), fcr-keep-one(trim(head(paths))));
  def fcr-keep-next(rest, kept) = fcr-keep-go(rest, 0);
  def fcr-flat(path) = fcr-with(split-on(path, "/"), "_");
  def fcr-with(parts, sep) = if nil?(parts) then "" else if nil?(tail(parts)) then head(parts) else mc-cat(list(head(parts), sep, fcr-with(tail(parts), sep)));
  def fcr-keep-one(path) = write_file_text(fhn-at(fcr-keep(), fcr-flat(path)), if gt(file_size(path), 0) then fhn-read(path) else "");
  def fcr-unlearned-kind(path, conflicts) = fcr-unlearned-said(path, fcr-keep-banks(conflicts), fcr-run("git rebase --abort 2>/dev/null"));
  def fcr-unlearned-said(path, kept, released) = list("unlearned", path, 0);
  // The reunion itself: bring origin in, join, redraw what is drawn, push once
  // on the new ground. The push that follows is not the push that failed.
  def fcr-reunion(redraw, drawn) {
   let fetched = fcr-exit("git fetch origin main");
   let rebased = fcr-exit("git rebase origin/main");
   let joined = if fcr-ok?(rebased) then list("joined", "", 0) else fcr-rounds(0, drawn, 0);
   if not(str_eq(nth(joined, 0), "joined")) then list("unlearned", mc-cat(list("a kind the body has not learned yet, both banks kept at ", fcr-keep(), ": ", nth(joined, 1))), "")
   else fcr-reunion-drawn(redraw, nth(joined, 2));
  }
  def fcr-reunion-drawn(redraw, drawn) {
   let drew = if and(eq(drawn, 1), gt(str_len(redraw), 0)) then fcr-redraw(redraw) else "";
   list("joined", "", fcr-exit("git push -u origin HEAD"));
  }
  def fcr-redraw(redraw) = fcr-redrawn(fcr-run(redraw), fcr-run("git add docs/rent-ladder.html 2>/dev/null"));
  def fcr-redrawn(drew, added) = fcr-run("git -c user.name=Claude -c user.email=noreply@anthropic.com commit -q --amend --no-edit 2>&1 | tail -1");
 }
}
