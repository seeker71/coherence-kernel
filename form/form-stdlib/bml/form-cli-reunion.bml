// The reunion: the body goes and gets what origin gained while it was walking.
//
// A landing whose push is refused is not blocked. Origin holds rows this
// checkout has not seen, and this checkout holds rows origin has not; both are
// true, and joining them is ordinary. A hand did this six times on 2026-09-22
// and it never varied.
//
// The body recognises a river by reading it, not by where it lives: if every
// line on both banks is a row carrying the moment it was written, then the two
// banks are one river and the union is simply all of it, each row once, in the
// order the rows happened. A caller says what it can draw again — a page made
// from the rows is not worth merging, it is remade once the rows agree.
//
// And when the body meets a kind it has not learned, it does not refuse. It
// looks, keeps both banks where they can be read, says what it saw and what it
// could do, and lets go of the attempt so the checkout stands clean. An
// unlearned kind is unfinished work, and the next reunion can know it.
import form-stdlib/bml/form-cli-heal-native-report.bml;
import form-stdlib/meaning-codes.bml;
section [form.bml] {
 class FormCliReunion {
  def fcr-mine() = "<<<<<<<";
  def fcr-theirs() = ">>>>>>>";
  def fcr-split() = "=======";
  // A row is a line that says when it was written. A river is a file whose every
  // live line is one — both banks of it, markers aside. The body reads the file to
  // know this; nothing depends on where the file sits or what it is called.
  def fcr-row?(line) = ((len(line) > 0) && ((Comparable) str_byte_at(line, 0) == 123)) && (str_find(line, "\"at_unix_ms\":", 0) >= 0);
  def fcr-all-rows?(xs) = nil?(xs) ? 1 : (Comparable) fcr-row?(xs[0]) == 1 ? fcr-all-rows?(xs[1:]) : 0;
  def fcr-river?(path) = fcr-river-of(file_size(path) > 0 ? fhn-read(path) : "");
  def fcr-river-of(text) = (String) trim(text) == "" ? 0 : fcr-all-rows?(fcr-without-marks(fcr-live(split-on(text, "\n"))));
  def fcr-among?(paths, path) = nil?(paths) ? 0 : (String) trim(paths[0]) == path ? 1 : fcr-among?(paths[1:], path);
  def fcr-known?(path, drawn) = fcr-river?(path) || fcr-among?(drawn, path);
  // ── the union of two banks of rows ──
  def fcr-live(xs) = nil?(xs) ? [] : (String) trim(xs[0]) == "" ? fcr-live(xs[1:]) : cons(xs[0], fcr-live(xs[1:]));
  def fcr-marked?(line, mark) = (Comparable) str_find(line, mark, 0) == 0;
  def fcr-any-mark?(line) = fcr-marked?(line, fcr-mine()) || (fcr-marked?(line, fcr-theirs()) || fcr-marked?(line, fcr-split()));
  def fcr-without-marks(xs) = nil?(xs) ? [] : fcr-any-mark?(xs[0]) ? fcr-without-marks(xs[1:]) : cons(xs[0], fcr-without-marks(xs[1:]));
  def fcr-digit?(b) = (b >= 48) && (b <= 57);
  def fcr-digits(text, i, acc) = (i < len(text)) && fcr-digit?(str_byte_at(text, i)) ? fcr-digits(text, i + 1, (acc * 10) + (str_byte_at(text, i) - 48)) : acc;
  def fcr-when(line) { let at = str_find(line, "\"at_unix_ms\":", 0); at < 0 ? 0 : fcr-digits(line, at + 13, 0); }
  def fcr-seen?(xs, line) = nil?(xs) ? 0 : (String) xs[0] == line ? 1 : fcr-seen?(xs[1:], line);
  def fcr-once(xs, kept) = nil?(xs) ? kept : fcr-once(xs[1:], (Comparable) fcr-seen?(kept, xs[0]) == 1 ? kept : append(kept, [xs[0]]));
  def fcr-insert(row, sorted) = nil?(sorted) ? [row] : fcr-when(row) <= fcr-when(sorted[0]) ? cons(row, sorted) : cons(sorted[0], fcr-insert(row, sorted[1:]));
  def fcr-order(xs, sorted) = nil?(xs) ? sorted : fcr-order(xs[1:], fcr-insert(xs[0], sorted));
  def fcr-join(xs) = nil?(xs) ? "" : xs[0] ++ "\n" ++ fcr-join(xs[1:]);
  // Both banks, each row once, in the order the rows were written.
  def fcr-union(text) = fcr-join(fcr-order(fcr-once(fcr-without-marks(fcr-live(split-on(text, "\n"))), []), []));
  def fcr-settle-ledger(path) = write_file_text(path, fcr-union(fhn-read(path)));
  // ── the walk ──
  def fcr-run(cmd) = fcr-said(host-exec(cmd, ""));
  def fcr-said(out) = out ?? "";
  def fcr-ok?(out) = str_find(out, "[ok] exit=0", 0) >= 0;
  def fcr-exit(cmd) = fcr-run("out=$(" ++ cmd ++ " 2>&1); code=$?; printf '[ok] exit=%s %s\\n' \"$code\" \"$(printf '%s' \"$out\" | tail -n 1)\"");
  def fcr-conflicts() = fcr-live(split-on(trim(fcr-run("git diff --name-only --diff-filter=U 2>/dev/null")), "\n"));
  def fcr-unlearned(paths, drawn) = nil?(paths) ? [] : fcr-known?(trim(paths[0]), drawn) ? fcr-unlearned(paths[1:], drawn) : cons(trim(paths[0]), fcr-unlearned(paths[1:], drawn));
  def fcr-redraws?(paths, drawn) = nil?(paths) ? 0 : fcr-among?(drawn, trim(paths[0])) ? 1 : fcr-redraws?(paths[1:], drawn);
  def fcr-settle(path) = fcr-river?(path) ? fcr-settle-then(path, fcr-settle-ledger(path)) : fcr-settle-then(path, fcr-run("git checkout --theirs " ++ path ++ " 2>/dev/null"));
  def fcr-settle-then(path, settled) = fcr-run("git add " ++ path ++ " 2>/dev/null");
  def fcr-settle-all(paths) = nil?(paths) ? 0 : fcr-settle-all-next(paths[1:], fcr-settle(trim(paths[0])));
  def fcr-settle-all-next(rest, done) = fcr-settle-all(rest);
  // Each round: settle what the body may settle, or stop at the wall and undo
  // the rebase, so a checkout is never left standing in a half-joined state.
  def fcr-rounds(round, redraw, drawn) {
   let conflicts = fcr-conflicts();
   nil?(conflicts) ? ["joined", "", drawn]
   : round >= 8 ? fcr-unlearned-kind("the same conflict came back eight times", conflicts)
   : fcr-round-at(round, redraw, drawn, conflicts, fcr-unlearned(conflicts, redraw));
  }
  def fcr-round-at(round, redraw, drawn, conflicts, unlearned) {
   !nil?(unlearned) ? fcr-unlearned-kind(unlearned[0], conflicts)
   : fcr-round-go(round, redraw, ((Comparable) drawn == 1) || ((Comparable) fcr-redraws?(conflicts, redraw) == 1), fcr-settle-all(conflicts));
  }
  def fcr-round-go(round, redraw, drawn, settled) = fcr-rounds-after(round, redraw, drawn, fcr-exit("git -c core.editor=true rebase --continue"));
  def fcr-rounds-after(round, redraw, drawn, out) = fcr-rounds(round + 1, redraw, drawn ? 1 : 0);
  def fcr-wall(path, drawn) = fcr-wall-undone(path, fcr-run("git rebase --abort 2>/dev/null"));
  def fcr-wall-undone(path, undone) = ["wall", path, 0];
  // A kind the body has not learned. Not a refusal: both banks are kept where a
  // person or a later door can read them, the attempt is let go so the checkout
  // stands clean, and what was seen is said with what could be done about it.
  def fcr-keep() = fhn-at(fhn-at(fhn-root(), ".form-heal"), "reunion-unlearned");
  def fcr-keep-banks(paths) = fcr-keep-go(paths, fs_mkdir(fcr-keep()));
  def fcr-keep-go(paths, made) = nil?(paths) ? 0 : fcr-keep-next(paths[1:], fcr-keep-one(trim(paths[0])));
  def fcr-keep-next(rest, kept) = fcr-keep-go(rest, 0);
  def fcr-flat(path) = fcr-with(split-on(path, "/"), "_");
  def fcr-with(parts, sep) = nil?(parts) ? "" : nil?(parts[1:]) ? parts[0] : parts[0] ++ sep ++ fcr-with(parts[1:], sep);
  def fcr-keep-one(path) = write_file_text(fhn-at(fcr-keep(), fcr-flat(path)), file_size(path) > 0 ? fhn-read(path) : "");
  def fcr-unlearned-kind(path, conflicts) = fcr-unlearned-said(path, fcr-keep-banks(conflicts), fcr-run("git rebase --abort 2>/dev/null"));
  def fcr-unlearned-said(path, kept, released) = ["unlearned", path, 0];
  // The reunion itself: bring origin in, join, redraw what is drawn, push once
  // on the new ground. The push that follows is not the push that failed.
  def fcr-reunion(redraw, drawn) {
   let fetched = fcr-exit("git fetch origin main");
   let rebased = fcr-exit("git rebase origin/main");
   let joined = fcr-ok?(rebased) ? ["joined", "", 0] : fcr-rounds(0, drawn, 0);
   !((String) joined[0] == "joined") ? ["unlearned", "a kind the body has not learned yet, both banks kept at " ++ fcr-keep() ++ ": " ++ joined[1], ""]
   : fcr-reunion-drawn(redraw, joined[2]);
  }
  def fcr-reunion-drawn(redraw, drawn) {
   let drew = ((Comparable) drawn == 1) && (len(redraw) > 0) ? fcr-redraw(redraw) : "";
   ["joined", "", fcr-exit("git push -u origin HEAD")];
  }
  def fcr-redraw(redraw) = fcr-redrawn(fcr-run(redraw), fcr-run("git add docs/rent-ladder.html 2>/dev/null"));
  def fcr-redrawn(drew, added) = fcr-run("git -c user.name=Claude -c user.email=noreply@anthropic.com commit -q --amend --no-edit 2>&1 | tail -1");
 }
}
