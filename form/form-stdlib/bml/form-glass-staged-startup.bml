package Form.glass.startup;

import Form.kernel.*;

interface IFormGlassStagedStartup [public, witness, reusable] {
   section [public] {
      const String Schema = "form-glass-staged-startup-v1";
      const String FirstFrameRule = "the bootstrap frame reads only bounded current-process and file metadata and must appear within the data-carried sixty-second budget";
      const String AttentionRule = "at five seconds an unfinished admission becomes close-attention work: identify its exact stage, process load, cache candidate, JIT key, map, and missing door before continuing";
      const String DemandRule = "startup is the bounded resident bootstrap; atlas is the default full image and overview memory flow and recipes share that admitted image";
      const String CacheRule = "the runnable runner fkb is at most an mtime and age candidate until the fkwu loader validates its source identity; the lowfk lowering memo is separately keyed by raw BML bytes and recursive floor digest; missing stale and expired candidates compile on demand";
      const String RamRule = "one immutable startup snapshot is retained and reused for bootstrap projections without repeating its physical reads";
      const String HonestSeam = "the current runtime exposes no generic in-process full program-image call; the staged cell names that missing door and does not claim the full dashboard was invoked";

      Object Observe() [abstract];
      Object Route( String view, Object snapshot ) [abstract];
      String Render( Object snapshot ) [abstract];
   }
}

class FormGlassStagedStartup [public, resident, observable, flow, teach] : IFormGlassStagedStartup {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-staged-startup.bml";
      const String FullGlassPath = "observe/form-glass-live-run.fk";
      const String FullGlassImagePath = "observe/form-glass-live-run.fkb";
      const int FirstFrameBudgetMilliseconds = 60000;
      const int AttentionMilliseconds = 5000;
      const int DiskCandidateExpiryMilliseconds = 86400000;

      Object Observe() [abstract] {}
      Object Route( String view, Object snapshot ) [abstract] {}
      String Render( Object snapshot ) [abstract] {}
   }
}
