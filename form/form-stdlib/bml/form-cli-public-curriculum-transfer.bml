//////////////////////////////////////////////////////////////////////
//
// form-cli-public-curriculum-transfer.bml — a small, public, BML-owned
// teaching context for a sealed local evaluation turn.
//
// This is in-context adaptation, not a weight update: the curriculum is
// public Form teaching; the held-out question is supplied only after the
// profile is formed; no expected answer is ever admitted here.
//
// preludes: form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormCliPublicCurriculumTransfer {
        field TransferTag = "form-cli-public-curriculum-transfer-v1";
        field TransferKind = "public-bml-context";
        field PublicProfile = "Form is the native language of recipes, cells, and the walker. BML is executable authority that lowers into Form. A live BMF cursor folds raw bytes across chunk boundaries without a tokenizer pre-step. choice accepts the first non-nothing acknowledgement, cut commits and prunes, undo restores its checkpoint, timeout leaves alternatives untried, nothing is distinct from 0 and 1. Reply only with the requested Form fact or expression. Do not claim a source lookup, remote answer, or weight update.";
        field QuestionPrefix = "Question: ";

        def fcpt-tag() = TransferTag();
        def fcpt-kind() = TransferKind();
        def fcpt-profile() = PublicProfile();
        def fcpt-question-prefix() = QuestionPrefix();
        def fcpt-profile-bytes() = str_len(PublicProfile());
        def fcpt-prompt(question) = if nothing?(question) then nothing() else if eq(str_len(question), 0) then nothing() else str_concat(PublicProfile(), str_concat("\n", str_concat(QuestionPrefix(), question)));
    }
    0;
}
