// A bounded voice in the current fkwu process, using registry weights as data.
// No model server, provider, training or generated tool execution.
// preludes: form-stdlib/form-cli-model-session.fk form-stdlib/organ-health.bml form-stdlib/native-llama-voice.bml
section [form.bml] {
 class FormCliNativeVoice {
  def fcnv-default-model() = mr-name(mr-for-role("answer"));
  def fcnv-limit() = 1536;
  def fcnv-context() = 12288;
  def fcnv-profile() = "knowledge-query";
  def fcnv-allowance-valid(context,limit) = (!((String) value_kind(context) == "int")) || (!((String) value_kind(limit) == "int")) ? 0 : ((limit > 0) && ((limit <= 8192) && (context > limit)));
  // Result: status, accepted text, prompt IDs, generated IDs, artifact path,
  // completion, release, reason, raw generation text, original generated IDs,
  // adapter path when the voice wore one.
  def fcnv-none(status,path,reason) = list(status,"",0,0,path,0,1,reason,"",list(),"");
  def fcnv-not-asked() = fcnv-none("not-asked","","caller-selected-no-local-generation");
  def fcnv-read(generation,released,path) {
   let session = fcms-generation-session(generation);
   let raw = fcms-generation-text(generation);
   let complete = fcms-live?(session) && (fcms-stopped?(session) && fcms-pending?(session));
   let status = !released ? "release-incomplete" : !fcms-live?(session) ? "unavailable" : !complete ? "incomplete" : (String) trim(raw) == "" ? "empty" : "answered";
   let reason = (String) status == "unavailable" ? fcms-reason(session) : status;
   list(status,(String) status == "answered" ? raw : "",fcms-prompt-ids(session),len(fcms-generation-ids(generation)),path,complete,released,reason,raw,fcms-generation-ids(generation),"");
  }
  def fcnv-run(packet,path,context,limit) {
   (!((String) value_kind(context) == "int")) || (!((String) value_kind(limit) == "int")) ? fcnv-none("unavailable",path,"integer-context-and-token-allowance-required")
   : !fcnv-allowance-valid(context,limit) ? fcnv-none("unavailable",path,"positive-token-allowance-up-to-8192-with-larger-context-required")
   : ((String) path == "") || (!mr-file?(path)) ? fcnv-none("unavailable",path,"registry-model-artifact-absent")
   : {
    let session = fcms-open-with-profile(path,packet,context,fcnv-profile());
    let generated = fcms-generate(session,limit);
    let released = fcms-release-ok?(fcms-generation-session(generated));
    fcnv-read(generated,released,path);
   };
  }
  def fcnv-number(request,key,fallback) = !json-object-has?(request,key) ? fallback : {
   let node = json-object-get(request,key); let value = json-int-value(node);
   ((String) value_kind(value) == "int") && node_eq(node,json-node-int(value)) ? value : 0;
  };
  def fcnv-adapter-default() = "form/form-stdlib/adapters/llama-3.2-3b-voice";
  def fcnv-lora-ready?(base,adapter) = (file_size(base ++ "/model.safetensors") > 0) && (file_size(adapter ++ "/adapters.safetensors") > 0);
  def fcnv-lora-read(base,adapter,promptIds,spoken,released) {
   let [text, why] = spoken;
   let status = (String) trim(text) == "" ? "empty" : "answered";
   list(status,(String) status == "answered" ? text : "",promptIds,spoken[2],base,(String) why == "" ? 1 : 0,released,(String) why == "" ? status : why,text,list(),adapter);
  }
  // The lane is chosen before it is spent, never tried and repeated. Opening the
  // weights and counting the packet's IDs costs a memory map; a forward pass costs
  // minutes. So the chunker is asked first whether any slice of this packet fits
  // the device at all — the same question it would answer during the prefill —
  // and a lane that cannot carry says so before a single token is computed. What
  // follows a refusal is then the first inference of the walk, not a second.
  def fcnv-lora-spoken(base,adapter,packet,limit) {
   let session = nlg-open-at(base,adapter,"");
   let promptIds = len(nlt-chat(session[1],packet));
   let slice = nlg-chunk(head(session),promptIds,0);
   slice <= 0 ? fcnv-lora-declined(base,adapter,promptIds,nlg-close(session)) : fcnv-lora-spoken-at(base,adapter,packet,limit,session,promptIds);
  }
  def fcnv-lora-declined(base,adapter,promptIds,closed) = list("unavailable","",promptIds,0,base,0,nothing?(closed) ? 0 : 1,"no-slice-of-this-packet-fits-the-device","",list(),adapter);
  def fcnv-lora-spoken-at(base,adapter,packet,limit,session,promptIds) {
   let spoken = nlg-ask(session,packet,limit,"","","");
   let closed = nlg-close(session);
   fcnv-lora-read(base,adapter,promptIds,spoken,nothing?(closed) ? 0 : 1);
  }

  def fcnv-lora(packet,adapter,limit) {
   let base = nlg-base();
   !fcnv-lora-ready?(base,adapter) ? fcnv-none("unavailable",base,"native-weights-or-adapter-absent")
   : (limit <= 0) || (limit > 8192) ? fcnv-none("unavailable",base,"positive-token-allowance-up-to-8192-required")
   : fcnv-lora-spoken(base,adapter,packet,limit);
  }
  def fcnv-lane(request) = json-object-has?(request,"lane") ? json-string-value(json-object-get(request,"lane")) : "";
  def fcnv-adapter(request) = json-object-has?(request,"adapter") ? json-string-value(json-object-get(request,"adapter")) : fcnv-adapter-default();
  def fcnv-ask(packet,request) {
   (String) fcnv-lane(request) == "lora" ? fcnv-lora(packet,fcnv-adapter(request),fcnv-number(request,"max_reply_tokens",fcnv-limit())) : {
    let model = json-object-has?(request,"model") ? json-string-value(json-object-get(request,"model")) : fcnv-default-model();
    fcnv-run(packet,mr-path(mr-find(model)),fcnv-number(request,"context",fcnv-context()),fcnv-number(request,"max_reply_tokens",fcnv-limit()));
   };
  }
  def fcnv-metadata(result) = json-node-object(list(oh-s("source","fkwu-model-session"),oh-s("lane",(String) result[10] == "" ? "registry-weights" : "native-metal-lora"),oh-s("adapter",result[10]),oh-s("status",result[0]),oh-s("model_path",result[4]),oh-n("prompt_ids",result[2]),oh-n("generated_ids",result[3]),oh-n("complete",result[5]),oh-n("release_ok",result[6]),oh-s("reason",result[7]),oh-n("model_server_calls",0),oh-n("provider_calls",0)));
  def fcnv-retain(job,result) {
   let metadata = job ++ "/native-generation.json";
   let raw = write_file_text(job ++ "/native-generation.txt",result[8]);
   let ids = write_file_text(job ++ "/native-generation-ids.json",json-emit(json-node-array(oh-ints(result[9]))));
   let saved = write_file_text(metadata,json-emit(fcnv-metadata(result)));
   let answered = (String) result[0] == "answered";
   oh-emit(job ++ "/events.jsonl",oh-reading("native-voice",job,"completed-and-released",json-node-int(1),json-node-int(answered),json-node-int(answered),answered ? list() : list(oh-need(result[7],json-node-string(metadata))),list("inspect-native-evidence","revise-request"),oh-reference(metadata)));
  }
 }
}
