// A voice in the current fkwu process, using registry weights as data.
// No model server, provider, training or generated tool execution.
import form-stdlib/form-cli-model-session.fk;
import form-stdlib/organ-health.bml;
import form-stdlib/native-llama-voice.bml;
import form-stdlib/bml/form-token-grammar.bml;
import form-stdlib/bml/reply-envelope.bml;
import form-stdlib/bml/local-run.bml;
import form-stdlib/bml/qwen38-open-observation.bml;
import form-stdlib/bml/model-admission.bml;
import form-stdlib/metal-carrier.bml;
import form-stdlib/bml/form-cli-guide-packet.bml;
section [form.bml] {
 class FormCliNativeVoice {
  def fcnv-default-model() = mr-name(mr-for-role("answer"));
  def fcnv-limit() = 1536;
  def fcnv-profile() = "knowledge-query";
  // the reply's room: the door's limit, or a reply_budget above it, so a walk the budget bounds ends at its budget and never at a position the session refuses
  def fcnv-room(budget) = nothing?(budget) ? fcnv-limit() : max2(budget,fcnv-limit());
  def fcnv-open-by(open,packet,path,context) = fcnv-open-room(open,packet,path,context,nothing());
  def fcnv-open-room(open,packet,path,context,budget) = open(fcsp-open-plain,path,packet,context ?? 0,fcnv-profile(),nothing?(context) ? fcnv-room(budget) : 0);
  def fcnv-allowance-valid(context,limit) = value_kind(limit)=="int" && limit > 0 && (nothing?(context) || value_kind(context)=="int" && context > 0);
  // Result: status, accepted text, prompt IDs, generated IDs, artifact path,
  // completion, release, reason, raw generation text, original generated IDs,
  // adapter path when the voice wore one; then, when a lane ran its clocks,
  // the prefill and the decode in ms (fcnv-clocked). A result with no clocks
  // reads both as 0: no rate is inferred from it. After them, when the session
  // read its own admission and open (fcnv-admitted), those two in ms, each
  // nothing() where the session did not stamp them.
  def fcnv-none(status,path,reason) = [status,"",0,0,path,0,1,reason,"",[],""];
  def fcnv-clocked(result,prefillMs,decodeMs) = append(result,[prefillMs,decodeMs]);
  def fcnv-prefill-ms(result) = len(result) > 12 ? result[11] : 0;
  def fcnv-decode-ms(result) = len(result) > 12 ? result[12] : 0;
  def fcnv-admitted(result,admissionMs,openMs) = append(result,[admissionMs,openMs]);
  def fcnv-admission-ms(result) = len(result) > 14 ? result[13] : nothing();
  def fcnv-open-ms(result) = len(result) > 14 ? result[14] : nothing();
  def fcnv-not-asked() = fcnv-none("not-asked","","caller-selected-no-local-generation");
  def fcnv-read(generation,released,path) {
   let session = fcms-generation-session(generation);
   let raw = fcms-generation-text(generation);
   let complete = (fcms-live?(session) && (fcms-stopped?(session) && fcms-pending?(session)));
   let status = if (!released) then "release-incomplete" else if (!fcms-live?(session)) then "unavailable" else if (!complete) then "incomplete" else if ((String) trim(raw) == "") then "empty" else "answered";
   let reason = if ((String) status == "unavailable") then fcms-reason(session) else status;
   [status,if ((String) status == "answered") then raw else "",fcms-prompt-ids(session),len(fcms-generation-ids(generation)),path,complete,released,reason,raw,fcms-generation-ids(generation),qlwe-dir-of(fcms-ctx(session))];
  }
  // wear: nothing, or the adapter a request names on this lane, [directory, scale or nothing (the config's)]: the session wears it on every forward
  // (form-cli-model-session.fk, fcms-open-worn-by) and the result names it. A request that names none opens the door it always opened.
  def fcnv-run(packet,path,context,limit) = fcnv-run-wearing(packet,path,context,limit,nothing());
  def fcnv-run-wearing(packet,path,context,limit,wear) = fcnv-run-bounded(packet,path,context,limit,wear,nothing());
  // budget: nothing is the open generation it always was; an integer ends the walk there, and the result reads incomplete with the raw text kept (a reading's own bound)
  def fcnv-run-bounded(packet,path,context,limit,wear,budget) = fcnv-run-held(packet,path,context,limit,wear,budget,nothing());
  // envelope: nothing, or a reply grammar's name ("local-plan", reply-envelope.bml) that holds each id the walk commits
  def fcnv-run-held(packet,path,context,limit,wear,budget,envelope) {
   if (!nothing?(wear) && len(fcnv-wear-why(wear)) > 0) then fcnv-none("unavailable",path,"adapter-wear-refused: " ++ fcnv-wear-why(wear))
   else if ((!nothing?(context) && !((String) value_kind(context) == "int")) || (!((String) value_kind(limit) == "int"))) then fcnv-none("unavailable",path,"integer-context-and-token-allowance-required")
   else if (!fcnv-allowance-valid(context,limit)) then fcnv-none("unavailable",path,"positive-progress-interval-and-initial-context-required")
   else if (((String) path == "") || (!mr-file?(path))) then fcnv-none("unavailable",path,"registry-model-artifact-absent")
   else {
    // The open carries admission, weights, context and the prompt's prefill in one call, and the session keeps each
    // stage's instant on its own record (form-cli-model-session.fk, the session's clock): the door reads the ask's
    // clocks back from it (fcms-clock-read) after the release, so prefill_ms is the prefill alone and decode_ms the
    // decode steps alone, with the admission wait and the open as their own spans.
    // This cursor walks one token at a time. Choose its plain owner at open so
    // admission and prefill never carry an unused drafter or its hidden states.
    let session = fcnv-open-room(nothing?(wear) ? fcms-open-sized-by : fcms-open-worn-by(wear),packet,path,context,budget);
    let cursor = ftg-pulsing(ftg-intercept-with(512,ftg-next-reply()));
    record_set(cursor,"next-progress",limit);
    record_set(cursor,"observer",(stage,phase,c,generated) => fcnv-progress(cursor,limit,stage,phase,generated));
    let held = fcnv-envelope-hold(cursor,session,envelope);
    // Decode is the generate call. The note is a stamp, not a peer line.
    // Prefill stamps are the session's own begin and ready.
    let _decode-begin = q38oo-note("voice-decode-begin", 0);
    let generated = ftg-generate-with(cursor,session,budget,"voice");
    let reading = fcnv-envelope-close(cursor);
    let _decode-ready = q38oo-note("voice-decode-ready", 0);
    let ended = fcms-generation-session(generated);
    let released = fcms-release-ok?(ended);
    let clocks = fcms-clock-read(ended);
    // fcms-clock-read sets each of its four keys, nothing() where the session did not stamp the span
    fcnv-enveloped(fcnv-admitted(fcnv-clocked(fcnv-read(generated,released,path),record_get(clocks,"prefill_ms") ?? 0,record_get(clocks,"decode_ms") ?? 0),record_get(clocks,"admission_ms"),record_get(clocks,"open_ms")),reading);
   };
  }
  // A held ask's result carries the envelope's reading after its clocks: [mode, swaps, ends, cut, candidate ms], cut ""
  // when the reply closed inside its envelope, else where the hold ended it ("<tag>" or "candidates-unavailable").
  def fcnv-enveloped(result,reading) = nothing?(reading) ? result : append(result,[reading]);
  def fcnv-envelope-of(result) = len(result) > 15 ? result[15] : nothing();
  // The envelope holds the walk where it is made. Each id the greedy forward predicts is read against the grammar;
  // an id that leaves the envelope, or a stop inside a block, is exchanged for the first of the device's top-k
  // candidates over the logits the forward left that keeps the reply inside it (the sampler's buffers, opened on the
  // first exchange, presence penalty 0, so its first candidate is the greedy one). The prefill's first prediction and
  // the first after an observation are held the same way (frxs-held). When none of the candidates holds, the reply
  // ends with the assistant close, and the cursor names where: the block it cut, or that the candidates did not answer.
  def fcnv-envelope(request) = json-object-has?(request,"envelope") ? json-string-value(json-object-get(request,"envelope")) : nothing();
  def fcnv-envelope-broken() = ["broken","","",[],"",0,[],0,0];
  def fcnv-envelope-stop(s) = c => (Comparable) q38-stop?(c,fcmo-stops(s)) == 1;
  def fcnv-envelope-text(s) = c => fcmo-token-text(s,c);
  def fcnv-envelope-hold(cursor,session,envelope) = nothing?(envelope) || !((String) envelope == "local-plan") || !((Comparable) fcms-live?(session) == 1) || fcms-ds4?(session) ? 0 : {
   let held = fcnv-envelope-start(cursor);
   record_set(cursor,"hold",(s,id) => fcnv-envelope-held(cursor,s,id));
  };
  def fcnv-envelope-start(cursor) {
   record_set(cursor,"envelope",renv-start());
   record_set(cursor,"envelope-swaps",0);
   record_set(cursor,"envelope-ends",0);
   record_set(cursor,"envelope-cut","");
   record_set(cursor,"envelope-ms",0);
   record_set(cursor,"envelope-owner",[]);
   cursor;
  }
  def fcnv-envelope-held(cursor,s,id) = fcnv-envelope-held-by(cursor,id,fcnv-envelope-text(s),fcnv-envelope-stop(s),() => fcnv-envelope-found(cursor,s),fcmo-end-id(s));
  // the device's top-k ids over the logits the forward left, best first; [] when the sampler's buffers do not answer
  def fcnv-envelope-found(cursor,s) {
   let began = host_monotonic_ms();
   let found = fcsam-candidates(fcnv-envelope-owner(cursor,s),fcms-ctx(s)[1][28],0.0);
   let spent = record_set(cursor,"envelope-ms",record_get(cursor,"envelope-ms") + host_monotonic_ms() - began);
   nil?(found) ? [] : found[1];
  }
  // the hold's own decision, over a token's text, its stop reading, the candidates (asked only on a refusal) and the close id
  def fcnv-envelope-held-by(cursor,id,text,stop?,found,close) {
   let st = record_get(cursor,"envelope");
   let next = id < 0 || (String) renv-mode(st) == "broken" ? st : renv-take(st,id,text,stop?);
   !nothing?(next) ? fcnv-envelope-took(cursor,next,id) : fcnv-envelope-swap(cursor,st,text,stop?,found(),close);
  }
  def fcnv-envelope-took(cursor,next,id) { record_set(cursor,"envelope",next); id; }
  def fcnv-envelope-count(cursor,key) = record_set(cursor,key,record_get(cursor,key) + 1);
  // the close ends the reply where no candidate holds: whole when a stop may end it there, else cut at the block
  def fcnv-envelope-swap(cursor,st,text,stop?,ids,close) {
   let pick = renv-pick(st,ids,text,stop?);
   if nothing?(pick) then {
    fcnv-envelope-count(cursor,"envelope-ends");
    record_set(cursor,"envelope-cut",renv-stop-ok?(st) ? "" : nil?(ids) ? "candidates-unavailable" : mc-cat(["<",(String) renv-mode(st) == "out" ? "between" : st[1],">"]));
    fcnv-envelope-took(cursor,fcnv-envelope-broken(),close);
   }
   else { fcnv-envelope-count(cursor,"envelope-swaps"); fcnv-envelope-took(cursor,renv-take(st,pick,text,stop?),pick); };
  }
  // a cursor held from the envelope's start, for a walk whose session the caller scripts
  def fcnv-envelope-cursor() = fcnv-envelope-start(record_new(0));
  def fcnv-envelope-owner(cursor,s) = !nil?(record_get(cursor,"envelope-owner")) ? record_get(cursor,"envelope-owner") : {
   let owner = fcsam-open(fcms-ctx(s)[2][19],1729);
   let cleared = fcsam-reset(owner);
   record_set(cursor,"envelope-owner",owner);
   owner;
  };
  // the envelope's reading, [mode, swaps, ends, cut, candidate ms], printed once; nothing() for an ask it did not hold
  def fcnv-envelope-reading(cursor) = [renv-mode(record_get(cursor,"envelope")),record_get(cursor,"envelope-swaps"),record_get(cursor,"envelope-ends"),record_get(cursor,"envelope-cut"),record_get(cursor,"envelope-ms")];
  def fcnv-envelope-close(cursor) = !((String) value_kind(record_get(cursor,"hold")) == "closure") ? nothing() : {
   let owner = record_get(cursor,"envelope-owner");
   let closed = nil?(owner) ? 0 : fcsam-close(owner);
   let r = fcnv-envelope-reading(cursor);
   let said = print_str(mc-cat(["[native-voice:envelope] mode=",r[0]," swaps=",r[1].str()," ends=",r[2].str()," cut=",len(r[3]) == 0 ? "none" : r[3]," candidate_ms=",r[4].str()]));
   r;
  };
  // The compatibility field max_reply_tokens now asks for a progress signal.
  // Crossing it does not end a reply or open another model/session.
  def fcnv-progress(cursor,interval,stage,phase,generated) {
   if stage=="model-stream" && phase=="progress" && generated >= record_get(cursor,"next-progress") then {
    let signal=oh-voice(oh-reading("native-voice",host_pid().str(),"generation-progress",json-node-int(record_get(cursor,"next-progress")),json-node-int(generated),json-node-null(),[],["continue"],json-node-object([oh-n("provider_calls",0),oh-s("continuity","same-cursor-and-kv")])));
    record_set(cursor,"next-progress",max2(generated+interval,record_get(cursor,"next-progress")*2));
   } else 0;
   0;
  }
  def fcnv-number(request,key,fallback) = if (!json-object-has?(request,key)) then fallback else {
   let node = json-object-get(request,key); let value = json-int-value(node);
   if (((String) value_kind(value) == "int") && node_eq(node,json-node-int(value))) then value else 0;
  };
  def fcnv-adapter-default() = "form/form-stdlib/adapters/llama-3.2-3b-voice";
  def fcnv-lora-ready?(base,adapter) = ((file_size((base + "/model.safetensors")) > 0) && (file_size((adapter + "/adapters.safetensors")) > 0));
  def fcnv-lora-read(base,adapter,promptIds,spoken,released) {
   let text = spoken[0];
   let why = spoken[1];
   let complete = (String) why == "";
   let status = !released ? "release-incomplete" : !complete ? "incomplete" : (String) trim(text) == "" ? "empty" : "answered";
   [status,status == "answered" ? text : "",promptIds,spoken[2],base,complete,released,!released || complete ? status : why,text,[],adapter];
  }
  // The lane is chosen before it is spent, never tried and repeated. Opening the
  // weights and counting the packet's IDs costs a memory map; a forward pass costs
  // minutes. So the chunker is asked first whether any slice of this packet fits
  // the device at all — the same question it would answer during the prefill —
  // and a lane that cannot carry says so before a single token is computed. What
  // follows a refusal is then the first inference of the walk, not a second.
  def fcnv-lora-spoken(base,adapter,packet,limit) {
   let session = nlg-open-at(base,adapter,"");
   let promptIds = len(nlt-chat(session[1],packet));
   let slice = nlg-chunk(session[0],promptIds,0);
   if (slice <= 0) then fcnv-lora-declined(base,adapter,promptIds,nlg-close(session)) else fcnv-lora-spoken-at(base,adapter,packet,limit,session,promptIds);
  }
  def fcnv-lora-declined(base,adapter,promptIds,closed) = ["unavailable","",promptIds,0,base,0,if nothing?(closed) then 0 else 1,"no-slice-of-this-packet-fits-the-device","",[],adapter];
  // The LoRA lane stamps its own stages (nlg-event: one "prefill" row per chunk, one "decode" row per step, each with its
  // wall_ms) into this process's event file; the door reads them back as values and sums each stage.
  def fcnv-lora-events() = ".hearth/voice-lora-" ++ host_pid().str() ++ ".events.jsonl";
  def fcnv-stage-ms(rows,stage) = foldl((total,row) => total + ((String) fcgp-str(row,"stage") == stage ? (fcgp-num(row,"wall_ms") ?? 0) : 0),0,rows);
  def fcnv-lora-spoken-at(base,adapter,packet,limit,session,promptIds) {
   let events = fcnv-lora-events();
   let cleared = write_file_text(events,"");
   let spoken = nlg-ask(session,packet,limit,"","",events);
   let closed = nlg-close(session);
   let rows = fcgp-rows(events);
   fcnv-clocked(fcnv-lora-read(base,adapter,promptIds,spoken,if nothing?(closed) then 0 else 1),fcnv-stage-ms(rows,"prefill"),fcnv-stage-ms(rows,"decode"));
  }

  def fcnv-lora(packet,adapter,limit) {
   let base = nlg-base();
   if (!fcnv-lora-ready?(base,adapter)) then fcnv-none("unavailable",base,"native-weights-or-adapter-absent")
   else if ((limit <= 0) || (limit > 8192)) then fcnv-none("unavailable",base,"positive-token-allowance-up-to-8192-required")
   else fcnv-lora-spoken(base,adapter,packet,limit);
  }
  def fcnv-lane(request) = if json-object-has?(request,"lane") then json-string-value(json-object-get(request,"lane")) else "";
  def fcnv-adapter(request) = if json-object-has?(request,"adapter") then json-string-value(json-object-get(request,"adapter")) else fcnv-adapter-default();
  // Every ask is recorded where it is made (local-run.bml): one LocalRun row with the door's wall clock and the lane's
  // prefill and decode clocks, and one QueryCoverageRow (kind from the request's own "enquiry" when it names one, else
  // from the packet's opening paragraph; source fkwu-model-session; the lane; answered or not; rent 0), unless the request
  // names "enquiry_kind" measurement (an alignment or wear arm): that lands no coverage row. The result is the voice's, unchanged. The registry-weights lane queues for its weights at the one place every session opens
  // (fcms-open-sized, model-admission.bml); the LoRA lane opens its own small model here, so it queues at this door.
  // Not admitted within the wait (adm-wait-ms, ten minutes unless FORM_MODEL_ADMISSION_WAIT_MS says otherwise) an ask
  // answers unavailable and names why; that reason is the row's.
  def fcnv-interactive?(request) = json-object-has?(request,"interactive") && node_eq(json-object-get(request,"interactive"),json-node-bool(true));
  def fcnv-ask(packet,request) {
   let asked = host_monotonic_ms();
   let result = fcnv-interactive?(request) ? gpu-lease-with-interactive(() => fcnv-carrier-ready(packet,request)) : fcnv-carrier-ready(packet,request);
   fcnv-recorded(packet,request,result,host_monotonic_ms() - asked);
  }
  def fcnv-carrier-ready(packet,request) {
   let home = fs-mkdir(".hearth");
   let admission = mca-admit(".hearth/voice-carrier.log",".hearth/voice-carrier.err");
   admission[0] == "standing" || admission[0] == "admitted" ? fcnv-ask-lane(packet,request) : fcnv-none("unavailable","","metal-carrier-" ++ admission[0] ++ ";exit=" ++ admission[1].str() ++ ";evidence=" ++ admission[2]);
  }
  // Admission accounts for the opened weight file and releases the same key.
  def fcnv-lora-weights() = nlg-base() ++ "/model.safetensors";
  def fcnv-ask-lane(packet,request) = if ((String) fcnv-lane(request) == "lora") then fcnv-lora-admitted(packet,request,adm-admit("fcnv-lora",fcnv-lora-weights(),adm-wait-ms())) else fcnv-ask-run(packet,request);
  def fcnv-lora-admitted(packet,request,claim) = if (claim[0] == 1) then fcnv-lora-held(packet,request,claim[2]) else fcnv-none("unavailable",nlg-base(),("model-queued: " ++ claim[1]));
  def fcnv-lora-held(packet,request,ticket) {
   defer adm-drop(fcnv-lora-weights());
   let freed = adm-loaded(ticket);
   fcnv-ask-run(packet,request);
  }
  def fcnv-enquiry(packet,request) = json-object-has?(request,"enquiry") ? json-string-value(json-object-get(request,"enquiry")) : qc-enquiry-of(packet);
  def fcnv-recorded(packet,request,result,wallMs) = fcnv-recorded-at(lrun-ledger(),qc-ledger(),packet,request,result,wallMs);
  def fcnv-named-kind(request) = json-object-has?(request,"enquiry_kind") ? json-string-value(json-object-get(request,"enquiry_kind")) : "";
  def fcnv-recorded-at(runPath,coveragePath,packet,request,result,wallMs) {
   let kind = qc-kind-named(fcnv-enquiry(packet,request),fcnv-named-kind(request));
   let kept = local-run-record-kinded-at(runPath,result,wallMs,fcnv-prefill-ms(result),fcnv-decode-ms(result),fcnv-admission-ms(result),fcnv-open-ms(result),qc-traffic?(kind) ? nothing() : kind);
   let covered = qc-record-at(coveragePath,kind,"fkwu-model-session",lrun-lane(result),result[4],(String) result[0] == "answered" ? 1 : 0,0,wallMs);
   result;
  }
  def fcnv-ask-run(packet,request) {
   if ((String) fcnv-lane(request) == "lora") then fcnv-lora(packet,fcnv-adapter(request),fcnv-number(request,"max_reply_tokens",fcnv-limit())) else {
    let model = if json-object-has?(request,"model") then json-string-value(json-object-get(request,"model")) else fcnv-default-model();
    fcnv-run-held(packet,mr-path(mr-find(model)),fcnv-number(request,"context",nothing()),fcnv-number(request,"max_reply_tokens",fcnv-limit()),fcnv-wear(request,model),fcnv-budget(request),fcnv-envelope(request));
   };
  }
  // "reply_budget": the ids one reply may spend, where its walk ends; absent, the generation is open
  def fcnv-budget(request) = json-object-has?(request,"reply_budget") ? fcnv-number(request,"reply_budget",0) : nothing();
  // the wear a registry-weights request names: "adapter" (a directory; "" is the bare lane named out loud), and "adapter_scale" when it reads a number (absent: the adapter config's
  // scale). A request that names none reads the wear registry (learn/voice-wear-registry.jsonl, absent today: the bare lane, as it always was).
  def fcnv-wear(request,model) = json-object-has?(request,"adapter") ? ((String) fcnv-adapter(request) == "" ? nothing() : [fcnv-adapter(request),qlbj-real(request,"adapter_scale")]) : fcnv-wear-registered(fcnv-wear-registry(),model);
  def fcnv-wear-registry() = "learn/voice-wear-registry.jsonl";
  // the registry's last row for this model decides: {"model":"qwen38-q8","adapter":"<dir>","adapter_sha256":"<hex>","wear":1}; wear 0 or no row is the bare lane. A row that says wear 1 carries the bytes
  // its decision read: the wear is [directory, nothing, digest], and the run refuses by name a directory absent or unnamed, and one whose bytes read otherwise (fcnv-wear-why).
  def fcnv-wear-registered(path,model) = file_size(path) < 1 ? nothing() : fcnv-wear-of(filter(row => (String) qlbj-str(row,"model") == model,fcnv-wear-rows(path)));
  def fcnv-wear-rows(path) = filter(row => !nothing?(row),map(line => qlbj-json("voice-wear-row",line),split-on(read_file(path) ?? "","\n")));
  def fcnv-wear-of(rows) = nil?(rows) ? nothing() : qlbj-is?(qlbj-int(rows[-1],"wear"),1) ? [qlbj-str(rows[-1],"adapter") ?? "",nothing(),qlbj-str(rows[-1],"adapter_sha256") ?? ""] : nothing();
  def fcnv-wear-why(wear) = len(qlbj-present-why("worn",wear[0])) > 0 ? qlbj-present-why("worn",wear[0]) : len(wear) > 2 ? fcnv-wear-digest-why(wear[0],wear[2],hex-encode(sha256-stream-string(read_file(qlbj-st(wear[0])) ?? ""))) : "";
  def fcnv-wear-digest-why(dir,want,read) = (String) want == read ? "" : "worn adapter " ++ qlbj-st(dir) ++ " reads sha256 " ++ read ++ "; the registry row witnessed \"" ++ want ++ "\"";
  def fcnv-metadata(result) = json-node-object([oh-s("source","fkwu-model-session"),oh-s("lane",if ((String) result[10] == "") then "registry-weights" else "native-metal-lora"),oh-s("adapter",result[10]),oh-s("status",result[0]),oh-s("model_path",result[4]),oh-n("prompt_ids",result[2]),oh-n("generated_ids",result[3]),oh-n("complete",result[5]),oh-n("release_ok",result[6]),oh-s("reason",result[7]),oh-n("model_server_calls",0),oh-n("provider_calls",0)]);
  def fcnv-retain(job,result) {
   let metadata = (job + "/native-generation.json");
   let raw = write_file_text((job + "/native-generation.txt"),result[8]);
   let ids = write_file_text((job + "/native-generation-ids.json"),json-emit(json-node-array(oh-ints(result[9]))));
   let saved = write_file_text(metadata,json-emit(fcnv-metadata(result)));
   let answered = ((String) result[0] == "answered");
   oh-emit((job + "/events.jsonl"),oh-reading("native-voice",job,"completed-and-released",json-node-int(1),json-node-int(answered),json-node-int(answered),if answered then [] else [oh-need(result[7],json-node-string(metadata))],["inspect-native-evidence","revise-request"],oh-reference(metadata)));
  }
 }
}
