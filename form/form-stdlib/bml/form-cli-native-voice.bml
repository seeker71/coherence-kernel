// A voice in the current fkwu process, using registry weights as data.
// No model server, provider or training. The Form token cursor executes native controls in this process.
import form-stdlib/form-cli-model-session.fk;
import form-stdlib/organ-health.bml;
import form-stdlib/native-llama-voice.bml;
import form-stdlib/bml/form-token-grammar.bml;
import form-stdlib/bml/reply-envelope.bml;
import form-stdlib/bml/local-run.bml;
import form-stdlib/bml/qwen38-open-observation.bml;
import form-stdlib/bml/model-admission.bml;
import form-stdlib/metal-carrier.bml;
import form-stdlib/bml/form-cli-guide-packet.bml;
import form-stdlib/bml/native-owner-clock.bml;
section [form.bml] {
 let FCNV-ONE-SHOT=record_new(0,"current",nothing(),"continuations",record_new(0),"sequence",0);
 class FormCliNativeVoice {
  def fcnv-default-model() = mr-name(mr-for-role("answer"));
  def fcnv-limit() = 1536;
  def fcnv-profile() = "knowledge-query";
  // the reply's room: the door's limit, or a reply_budget above it, so a walk the budget bounds ends at its budget and never at a position the session refuses
  def fcnv-room(budget) = nothing?(budget) ? fcnv-limit() : max2(budget,fcnv-limit());
  def fcnv-open-by(open,packet,path,context) = fcnv-open-room(open,packet,path,context,nothing());
   def fcnv-open-room(open,packet,path,context,budget) = open(fcsp-open-plain-retaining,path,packet,context ?? 0,fcnv-profile(),nothing?(context) ? fcnv-room(budget) : 0);
  def fcnv-allowance-valid(context,limit) = value_kind(limit)=="int" && limit > 0 && (nothing?(context) || value_kind(context)=="int" && context > 0);
  // Result: status, accepted text, prompt IDs, generated IDs, artifact path,
  // completion, release, reason, raw generation text, original generated IDs,
  // adapter path when the voice wore one; then, when a lane ran its clocks,
  // the prefill and the decode in ms (fcnv-clocked). A result with no clocks
  // reads both as 0: no rate is inferred from it. After them, when the session
  // read its own admission and open (fcnv-admitted), those two in ms, each
  // nothing() where the session did not stamp them.
  def fcnv-none(status,path,reason) = [status,"",0,0,path,0,status == "release-incomplete" ? 0 : 1,reason,"",[],""];
  def fcnv-clocked(result,prefillMs,decodeMs) = append(result,[prefillMs,decodeMs]);
  def fcnv-prefill-ms(result) = len(result) > 12 ? result[11] : 0;
  def fcnv-decode-ms(result) = len(result) > 12 ? result[12] : 0;
  def fcnv-admitted(result,admissionMs,openMs) = append(result,[admissionMs,openMs]);
  def fcnv-admission-ms(result) = len(result) > 14 ? result[13] : nothing();
  def fcnv-open-ms(result) = len(result) > 14 ? result[14] : nothing();
  def fcnv-not-asked() = fcnv-none("not-asked","","caller-selected-no-local-generation");
  def fcnv-read(generation,released,path) = fcnv-read-owned(generation,released,path,0);
  def fcnv-read-owned(generation,released,path,retained) {
   let session = fcms-generation-session(generation);
   let raw = fcms-generation-text(generation);
   let prose = ftg-prose(raw);
   let unfinished = ftg-unfinished?(prose);
   // Decoder completion is retained independently: EOS inside an open control
   // still leaves the answer incomplete, with the precise reason and raw trace.
   let complete = (fcms-live?(session) && (fcms-stopped?(session) && fcms-pending?(session)));
   let choiceNeeded=fcms-reason(session)==ftg-choice-needed();
   let status = if (!released && !retained) then "release-incomplete" else if choiceNeeded then "incomplete" else if (!fcms-live?(session)) then "unavailable" else if (!complete || unfinished) then "incomplete" else if ((String) trim(prose) == "") then "empty" else "answered";
   let reason = if ((String) status == "unavailable" || choiceNeeded) then fcms-reason(session) else if (status=="incomplete" && unfinished) then "unfinished-native-control" else status;
   [status,if ((String) status == "answered") then prose else "",fcms-prompt-ids(session),len(fcms-generation-ids(generation)),path,complete,released,reason,raw,fcms-generation-ids(generation),qlwe-dir-of(fcms-ctx(session))];
  }
  // wear: nothing, or the adapter a request names on this lane, [directory, scale or nothing (the config's)]: the session wears it on every forward
  // (form-cli-model-session.fk, fcms-open-worn-by) and the result names it. A request that names none opens the door it always opened.
  def fcnv-run(packet,path,context,limit) = fcnv-run-wearing(packet,path,context,limit,nothing());
  def fcnv-run-wearing(packet,path,context,limit,wear) = fcnv-run-bounded(packet,path,context,limit,wear,nothing());
  // budget: nothing is the open generation it always was; an integer ends the walk there, and the result reads incomplete with the raw text kept (a reading's own bound)
  def fcnv-run-bounded(packet,path,context,limit,wear,budget) = fcnv-run-held(packet,path,context,limit,wear,budget,nothing());
  // envelope: nothing, or a reply grammar's name ("local-plan", reply-envelope.bml) that holds each id the walk commits
  def fcnv-run-held(packet,path,context,limit,wear,budget,envelope) {
   if (!nothing?(wear) && len(fcnv-wear-why(wear)) > 0) then fcnv-none("unavailable",path,"adapter-wear-refused: " ++ fcnv-wear-why(wear))
   else if ((!nothing?(context) && !((String) value_kind(context) == "int")) || (!((String) value_kind(limit) == "int"))) then fcnv-none("unavailable",path,"integer-context-and-token-allowance-required")
   else if (!fcnv-allowance-valid(context,limit)) then fcnv-none("unavailable",path,"positive-progress-interval-and-initial-context-required")
   else if (((String) path == "") || (!mr-file?(path))) then fcnv-none("unavailable",path,"registry-model-artifact-absent")
   else {
    // The open carries admission, weights, context and the prompt's prefill in one call, and the session keeps each
    // stage's instant on its own record (form-cli-model-session.fk, the session's clock): the door reads the ask's
    // clocks back from it (fcms-clock-read) after the release, so prefill_ms is the prefill alone and decode_ms the
    // decode steps alone, with the admission wait and the open as their own spans.
    // This cursor walks one token at a time. Choose its plain owner at open so
    // admission and prefill never carry an unused drafter or its hidden states.
     fcnv-owned-call(FCNV-ONE-SHOT,[packet,path,context,limit,wear,budget,envelope],()=>fcnv-open-room(fcms-retained-opener(wear,s=>record_set(record_get(FCNV-ONE-SHOT,"current"),"session",s)),packet,path,context,budget),(session,owner)=>{
    // Decode is the generate call. The note is a stamp, not a peer line.
    // Prefill stamps are the session's own begin and ready.
    let _decode-begin = q38oo-note("voice-decode-begin", 0);
    let heard = fcnv-generate-owned(session,limit,budget,envelope,owner);
    let generated = heard[0];
    let ended = fcms-generation-session(generated);
     record_set(owner,"session",ended);record_set(owner,"generation",generated);record_set(owner,"envelope",heard[1]);
     let _decode-ready = q38oo-note("voice-decode-ready", 0);
    // fcms-clock-read sets each of its four keys, nothing() where the session did not stamp the span
     released=>{let clocks=fcms-clock-read(ended);fcnv-enveloped(fcnv-admitted(fcnv-clocked(fcnv-read(generated,released,path),record_get(clocks,"prefill_ms") ?? 0,record_get(clocks,"decode_ms") ?? 0),record_get(clocks,"admission_ms"),record_get(clocks,"open_ms")),heard[1]);};
     },fcnv-residence-close);
   };
  }
  // The one cursor every native ask decodes through, the opened ask's and the resident turn's: the progress signal at
  // each interval, and, when the request names an envelope, the hold (fcnv-envelope-hold). It answers the generation
  // and the envelope's reading, nothing() for an ask the envelope did not hold.
  def fcnv-generate(session,limit,budget) = fcnv-generate-held(session,limit,budget,nothing())[0];
  def fcnv-generate-held(session,limit,budget,envelope) = fcnv-generate-owned(session,limit,budget,envelope,nothing());
  def fcnv-generate-owned(session,limit,budget,envelope,owner) {
   let cursor = ftg-pulsing(ftg-intercept-with(512,ftg-next-reply()));
   record_set(cursor,"generation-owner",owner);
   record_set(cursor,"next-progress",limit);
   record_set(cursor,"observer",(stage,phase,c,generated) => fcnv-progress(cursor,limit,stage,phase,generated));
   let held = fcnv-envelope-hold(cursor,session,envelope);
   let generated = ftg-generate-with(cursor,session,budget,"voice");
    if record?(owner) then {record_set(owner,"generation",generated);record_set(owner,"session",fcms-generation-session(generated));} else 0;
   [generated,fcnv-envelope-close(cursor)];
  }
  // After its clocks a result names its ownership and the prefix ids it reused (fcnv-metadata): an opened ask's is
  // released or release-incomplete with none reused, a resident turn's is its own (fcnv-resident-turn). A held ask's
  // result carries the envelope's reading after those two: [mode, swaps, ends, cut, candidate ms], cut "" when the
  // reply closed inside its envelope, else where the hold ended it ("<tag>" or "candidates-unavailable").
  def fcnv-ownership(result) = len(result) > 15 ? result[15] : result[6] ? "released" : "release-incomplete";
  def fcnv-reused-ids(result) = len(result) > 16 ? result[16] : 0;
  def fcnv-enveloped(result,reading) = nothing?(reading) ? result : append(take(15,result),[fcnv-ownership(result),fcnv-reused-ids(result),reading]);
  def fcnv-envelope-of(result) = len(result) > 17 ? result[17] : nothing();
  // The envelope holds the walk where it is made. Each id the greedy forward predicts is read against the grammar;
  // an id that leaves the envelope, or a stop inside a block, is exchanged for the first of the device's top-k
  // candidates over the logits the forward left that keeps the reply inside it (the sampler's buffers, opened on the
  // first exchange, presence penalty 0, so its first candidate is the greedy one). The prefill's first prediction and
  // the first after an observation are held the same way (frxs-held). When none of the candidates holds, the reply
  // ends with the assistant close, and the cursor names where: the block it cut, or that the candidates did not answer.
  def fcnv-envelope(request) = json-object-has?(request,"envelope") ? json-string-value(json-object-get(request,"envelope")) : nothing();
  def fcnv-envelope-broken() = ["broken","","",[],"",0,[],0,0];
  def fcnv-envelope-stop(s) = c => (Comparable) q38-stop?(c,fcmo-stops(s)) == 1;
  def fcnv-envelope-text(s) = c => fcmo-token-text(s,c);
  def fcnv-envelope-hold(cursor,session,envelope) = nothing?(envelope) || !((String) envelope == "local-plan") || !((Comparable) fcms-live?(session) == 1) || fcms-ds4?(session) ? 0 : {
   let held = fcnv-envelope-start(cursor);
   record_set(cursor,"hold",(s,id) => fcnv-envelope-held(cursor,s,id));
  };
  def fcnv-envelope-start(cursor) {
   record_set(cursor,"envelope",renv-start());
   record_set(cursor,"envelope-swaps",0);
   record_set(cursor,"envelope-ends",0);
   record_set(cursor,"envelope-cut","");
   record_set(cursor,"envelope-ms",0);
   record_set(cursor,"envelope-owner",[]);
   cursor;
  }
  def fcnv-envelope-held(cursor,s,id) = fcnv-envelope-held-by(cursor,id,fcnv-envelope-text(s),fcnv-envelope-stop(s),() => fcnv-envelope-found(cursor,s),fcmo-end-id(s));
  // the device's top-k ids over the logits the forward left, best first; [] when the sampler's buffers do not answer
  def fcnv-envelope-found(cursor,s) {
   let began = host_monotonic_ms();
   let found = fcsam-candidates(fcnv-envelope-owner(cursor,s),fcms-ctx(s)[1][28],0.0);
   let spent = record_set(cursor,"envelope-ms",record_get(cursor,"envelope-ms") + host_monotonic_ms() - began);
   nil?(found) ? [] : found[1];
  }
  // the hold's own decision, over a token's text, its stop reading, the candidates (asked only on a refusal) and the close id
  def fcnv-envelope-held-by(cursor,id,text,stop?,found,close) {
   let st = record_get(cursor,"envelope");
   let next = id < 0 || (String) renv-mode(st) == "broken" ? st : renv-take(st,id,text,stop?);
   !nothing?(next) ? fcnv-envelope-took(cursor,next,id) : fcnv-envelope-swap(cursor,st,text,stop?,found(),close);
  }
  def fcnv-envelope-took(cursor,next,id) { record_set(cursor,"envelope",next); id; }
  def fcnv-envelope-count(cursor,key) = record_set(cursor,key,record_get(cursor,key) + 1);
  // the close ends the reply where no candidate holds: whole when a stop may end it there, else cut at the block
  def fcnv-envelope-swap(cursor,st,text,stop?,ids,close) {
   let pick = renv-pick(st,ids,text,stop?);
   if nothing?(pick) then {
    fcnv-envelope-count(cursor,"envelope-ends");
    record_set(cursor,"envelope-cut",renv-stop-ok?(st) ? "" : nil?(ids) ? "candidates-unavailable" : mc-cat(["<",(String) renv-mode(st) == "out" ? "between" : st[1],">"]));
    fcnv-envelope-took(cursor,fcnv-envelope-broken(),close);
   }
   else { fcnv-envelope-count(cursor,"envelope-swaps"); fcnv-envelope-took(cursor,renv-take(st,pick,text,stop?),pick); };
  }
  // a cursor held from the envelope's start, for a walk whose session the caller scripts
  def fcnv-envelope-cursor() = fcnv-envelope-start(record_new(0));
  def fcnv-envelope-owner(cursor,s) = !nil?(record_get(cursor,"envelope-owner")) ? record_get(cursor,"envelope-owner") : {
    let vocab=fcms-ctx(s)[2][19];let need=fcsam-private-bytes(vocab);
     let ledger=fcms-release-ledger(s);
     let reservation=fcms-reservation(ledger,mg-lease-retaining("native voice envelope",fcms-path(s),0,need,token=>fcms-retain-reservation(ledger,token)),[["envelope",need]]);
    !record_get(reservation,"ready") ? [] : {
     let pending=fcms-retain-owned-release(s,[],record_get(reservation,"parts"));
     record_set(cursor,"envelope-release",pending);
     let owner=fcsam-open-by(vocab,1729,bytes=>q38x-alloc(pending,bytes));
     record_set(cursor,"envelope-owner",owner);
     let acknowledged=fcsam-live(owner) && fcms-reservation-ack(reservation,["envelope"]);
     acknowledged ? {fcsam-reset(owner);owner;} : {fcms-pending-release(pending);[];};
    };
  };
  // the envelope's reading, [mode, swaps, ends, cut, candidate ms], printed once; nothing() for an ask it did not hold
  def fcnv-envelope-reading(cursor) = [renv-mode(record_get(cursor,"envelope")),record_get(cursor,"envelope-swaps"),record_get(cursor,"envelope-ends"),record_get(cursor,"envelope-cut"),record_get(cursor,"envelope-ms")];
  def fcnv-envelope-close(cursor) = !((String) value_kind(record_get(cursor,"hold")) == "closure") ? nothing() : {
    let r = fcnv-envelope-reading(cursor);
    let generationOwner=record_get(cursor,"generation-owner");
    if record?(generationOwner) then record_set(generationOwner,"envelope",r) else 0;
    let owner = record_get(cursor,"envelope-release");
    let closed = !record?(owner) ? 1 : fcms-pending-release(owner);
   let said = print_str(mc-cat(["[native-voice:envelope] mode=",r[0]," swaps=",r[1].str()," ends=",r[2].str()," cut=",len(r[3]) == 0 ? "none" : r[3]," candidate_ms=",r[4].str()]));
   r;
  };
  // The caller owns this residence and closes it at EOF/stop. It retains an
  // exact guidance checkpoint and an optional retrieved-context checkpoint.
  // The live buffers also
  // hold the last turn until overwritten or closed; only the checkpoint is
  // restored. Each request supplies its complete packet and explicit history.
   def fcnv-residence() = record_new(0,"session",nothing(),"spare",[],"prefix",[],"context-spare",[],"context-prefix",[],"key",nothing(),"close-failed",0,"checkpoint-owners",record_new(0));
   // This admitted module owns one active ask and every unresolved release.
   // Public result tuples carry a correlation key, never live device handles.
   def fcnv-continuation(result) = len(result)>18 ? result[18] : "";
   def fcnv-continued(result,key) = key=="" ? result : {
    let timed=len(result)>12 ? result : fcnv-clocked(result,0,0);
    let admitted=len(timed)>14 ? timed : fcnv-admitted(timed,nothing(),nothing());
    append(append(take(15,admitted),[fcnv-ownership(result),fcnv-reused-ids(result),fcnv-envelope-of(result),key]),len(result)>19 ? result[19:] : []);
   };
   def fcnv-resumed?(result) = len(result)>20 && result[20]==1;
   def fcnv-resumed(result) = append(append(take(19,result),[len(result)>19 ? result[19] : nothing()]),[1]);
   def fcnv-current-usage(result) = fcnv-resumed?(result) ? append(append(take(2,result),[0,0]),result[4:]) : result;
   def fcnv-active?(owner) = record_get(owner,"phase")=="active" && nps-file-status(record_get(owner,"lifetime")) != [0,0];
   def fcnv-lifetime(owner) {
    let root="/tmp/form-native-voice-lifetime";host_dir_mkdir(root);
    let path=root+"/"+record_get(owner,"continuation");let lease=nps-file-open(path,1);
    record_set(owner,"lifetime-path",path);
    value_kind(lease)=="list" ? {record_set(owner,"lifetime",lease);1;} : {record_set(owner,"lifetime-refusal",lease);form_error("native voice lifetime unavailable");};
   }
   def fcnv-lifetime-close(owner) {
    let lease=record_get(owner,"lifetime");let released=nps-file-release(lease);
    released==1 ? {let path=record_get(owner,"lifetime-path");nothing?(path) ? 0 : host_path_remove(path);1;} : 0;
   }
   def fcnv-owned-close(owner,close) {
    let dependency=record_get(owner,"blocked-owner");
    let resources=try {record?(dependency) ? record_get(dependency,"phase")=="complete" || (!fcnv-active?(dependency) && fcnv-owned-close(dependency,close)) : close(owner);} catch 0;
    let released=resources && fcnv-lifetime-close(owner);
    record_set(owner,"phase",released ? "complete" : "release-pending");
    let result=(record_get(owner,"project"))(released);
    let continued=fcnv-continued(result,record_get(owner,"continuation"));
    record_set(owner,"result",append(take(19,continued),[(record_get(owner,"project"))(1)]));
    released;
   }
   def fcnv-resume-release-by(state,key,close) {
    let continuations=record_get(state,"continuations");let owner=record_get(continuations,key);
    !record?(owner) ? nothing() : fcnv-active?(owner) ? fcnv-continued(fcnv-none("release-incomplete",record_get(owner,"request")[1],"native-voice-in-progress"),key) : {
     let released=record_get(owner,"phase")=="complete" || fcnv-owned-close(owner,close);
     let result=record_get(owner,"result");
     fcnv-resumed(result);
    };
   }
   def fcnv-resume-release(key) = fcnv-resume-release-by(FCNV-ONE-SHOT,key,fcnv-residence-close);
   def fcnv-owner-ended-by(key,alive,process) {
    let parts=split-on(key,":");let versioned=len(parts)==4 && parts[0]=="v1";
    let pid=parse-int(parts[versioned ? 1 : 0]);
    nothing?(pid) || pid<=0 ? nothing() : noc-process-ended-by([pid,versioned ? parse-int(parts[2]) : nothing()],alive,process);
   }
   def fcnv-resume-retained(key,result) {
    let local=fcnv-resume-release(key);
    !nothing?(local) ? local : value_kind(result)=="list" && fcnv-continuation(result)==key && fcnv-resumed?(result) && result[6]==1 ? result : fcnv-owner-ended-by(key,pid=>host_alive(pid),pid=>host_process(pid))!=1 ? nothing() : {
     let projected=value_kind(result)=="list" && len(result)>19 && fcnv-continuation(result)==key ? result[19] : nothing();
     value_kind(projected)!="list" ? fcnv-resumed(fcnv-continued(fcnv-none("unavailable","","native-voice-owner-ended-result-unavailable"),key)) : fcnv-resumed(fcnv-continued(projected,key));
    };
   }
   def fcnv-ack-release(result) {
    let continuations=record_get(FCNV-ONE-SHOT,"continuations");let key=fcnv-continuation(result);let owner=record_get(continuations,key);
    record?(owner) && record_get(owner,"phase")=="complete" && value_eq(take(20,record_get(owner,"result")),take(20,result)) ? {record_set(continuations,key,nothing());1;} : 0;
   }
   def fcnv-next-continuation(state) {
    let n=record_get(state,"sequence")+1;record_set(state,"sequence",n);
    "v1:"+noc-open();
   }
   def fcnv-blocked-call(state,request,prior,active) {
    let key=fcnv-next-continuation(state);
    let project=released=>fcnv-none(released ? "unavailable" : "release-incomplete",request[1],released ? "prior-native-release-completed" : active ? "native-voice-in-progress" : "previous-native-voice-release-incomplete");
    let result=fcnv-continued(project(0),key);
    let owner=record_new(0,"phase","release-pending","request",request,"continuation",key,"blocked-owner",prior,"project",project,"result",result);
    record_set(record_get(state,"continuations"),key,owner);result;
   }
   def fcnv-owned-call(state,request,open,run,close) {
    let prior=record_get(state,"current");
    let active=record?(prior) && fcnv-active?(prior);
    let pending=record?(prior) && record_get(prior,"phase") != "complete";
    let ready=!record?(prior) || record_get(prior,"phase")=="complete" || (!active && fcnv-owned-close(prior,close));
    !ready ? fcnv-blocked-call(state,request,prior,active) : pending && value_eq(record_get(prior,"request"),request) ? fcnv-resumed(record_get(prior,"result")) : {
     let owner=fcnv-residence();let key=fcnv-next-continuation(state);
     record_set(state,"current",owner);
     record_set(owner,"phase","active");record_set(owner,"request",request);record_set(owner,"continuation",key);
     record_set(owner,"project",released=>fcnv-stopped-result(owner,released,request[1]));
     record_set(record_get(state,"continuations"),key,owner);
     let result=try {
      fcnv-lifetime(owner);
      let session=open();record_set(owner,"session",session);
      let project=run(session,owner);record_set(owner,"project",project);
      fcnv-owned-close(owner,close);
      record_get(owner,"result");
     } catch {
      fcnv-owned-close(owner,close);record_get(owner,"result");
     };
     record_get(owner,"phase")=="complete" ? record_set(record_get(state,"continuations"),key,nothing()) : 0;
     result;
    };
   }
   def fcnv-stopped-result(owner,released,path) {
    let generation=record_get(owner,"generation");
    value_kind(generation)!="list" ? fcnv-none(released ? "unavailable" : "release-incomplete",path,"native-voice-stopped") : {
     let session=fcms-generation-session(generation);let clocks=fcms-clock-read(session);
      let result=fcnv-read(generation,released,path);
      fcnv-enveloped(fcnv-admitted(fcnv-clocked(result,record_get(clocks,"prefill_ms") ?? 0,record_get(clocks,"decode_ms") ?? 0),record_get(clocks,"admission_ms"),record_get(clocks,"open_ms")),record_get(owner,"envelope"));
    };
   }
  def fcnv-common(a,b,n) = n >= len(a) || n >= len(b) || a[n] != b[n] ? n : fcnv-common(a,b,n+1);
  def fcnv-prefix-fits?(prefix,ids) = !nothing?(ids) && len(prefix) > 0 && len(prefix) < len(ids) && take(len(prefix),ids) == prefix;
  def fcnv-residence-close(owner) {
   let session=record_get(owner,"session");
    let checkpoints=record_get(owner,"checkpoint-owners") ?? record_new(0);
    let outcomes=map(key=>{
     let held=record_get(checkpoints,key);
     q38x-close(held);
     let token=record_get(held,"reservation");
     let released=q38x-owned(held)==0 && (!record?(token) || mg-reservation-release(token));
     if released then record_set(owner,key,[]) else 0;released;
    },record_keys(checkpoints));
    let closed=nothing?(session) || fcms-release-ok?(session);
    let ok=all?(done=>done,outcomes) && closed;
    ok ? {
     record_set(owner,"session",nothing()); record_set(owner,"spare",[]);
