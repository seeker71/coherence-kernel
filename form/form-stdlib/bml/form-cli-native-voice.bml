  def fcnv-metadata(result) = json-node-object([oh-s("source","fkwu-model-session"),oh-s("lane",if ((String) result[10] == "") then "registry-weights" else "native-metal-lora"),oh-s("adapter",result[10]),oh-s("status",result[0]),oh-s("model_path",result[4]),oh-n("prompt_ids",result[2]),oh-n("generated_ids",result[3]),oh-n("complete",result[5]),oh-n("release_ok",result[6]),oh-s("ownership",fcnv-ownership(result)),oh-n("reused_prefix_ids",fcnv-reused-ids(result)),oh-s("continuation",fcnv-continuation(result)),oh-n("release_resumed",fcnv-resumed?(result) ? 1 : 0),oh-n("current_prompt_ids",fcnv-current-usage(result)[2]),oh-n("current_generated_ids",fcnv-current-usage(result)[3]),oh-s("reason",result[7]),oh-n("model_server_calls",0),oh-n("provider_calls",0)]);
