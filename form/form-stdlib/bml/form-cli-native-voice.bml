// A voice in the current fkwu process, using registry weights as data.
// No model server, provider, training or generated tool execution.
import form-stdlib/form-cli-model-session.fk;
import form-stdlib/organ-health.bml;
import form-stdlib/native-llama-voice.bml;
import form-stdlib/bml/form-token-grammar.bml;
import form-stdlib/bml/local-run.bml;
import form-stdlib/bml/qwen38-open-observation.bml;
import form-stdlib/bml/model-admission.bml;
import form-stdlib/metal-carrier.bml;
import form-stdlib/bml/form-cli-guide-packet.bml;
section [form.bml] {
 class FormCliNativeVoice {
  def fcnv-default-model() = mr-name(mr-for-role("answer"));
  def fcnv-limit() = 1536;
  def fcnv-profile() = "knowledge-query";
  def fcnv-allowance-valid(context,limit) = value_kind(limit)=="int" && limit > 0 && (nothing?(context) || value_kind(context)=="int" && context > 0);
  // Result: status, accepted text, prompt IDs, generated IDs, artifact path,
  // completion, release, reason, raw generation text, original generated IDs,
  // adapter path when the voice wore one; then, when a lane ran its clocks,
  // the prefill and the decode in ms (fcnv-clocked). A result with no clocks
  // reads both as 0: no rate is inferred from it. After them, when the session
  // read its own admission and open (fcnv-admitted), those two in ms, each
  // nothing() where the session did not stamp them.
  def fcnv-none(status,path,reason) = [status,"",0,0,path,0,1,reason,"",[],""];
  def fcnv-clocked(result,prefillMs,decodeMs) = append(result,[prefillMs,decodeMs]);
  def fcnv-prefill-ms(result) = len(result) > 12 ? result[11] : 0;
  def fcnv-decode-ms(result) = len(result) > 12 ? result[12] : 0;
  def fcnv-admitted(result,admissionMs,openMs) = append(result,[admissionMs,openMs]);
  def fcnv-admission-ms(result) = len(result) > 14 ? result[13] : nothing();
  def fcnv-open-ms(result) = len(result) > 14 ? result[14] : nothing();
  def fcnv-not-asked() = fcnv-none("not-asked","","caller-selected-no-local-generation");
  def fcnv-read(generation,released,path) {
   let session = fcms-generation-session(generation);
   let raw = fcms-generation-text(generation);
   let complete = (fcms-live?(session) && (fcms-stopped?(session) && fcms-pending?(session)));
   let status = if (!released) then "release-incomplete" else if (!fcms-live?(session)) then "unavailable" else if (!complete) then "incomplete" else if ((String) trim(raw) == "") then "empty" else "answered";
   let reason = if ((String) status == "unavailable") then fcms-reason(session) else status;
   [status,if ((String) status == "answered") then raw else "",fcms-prompt-ids(session),len(fcms-generation-ids(generation)),path,complete,released,reason,raw,fcms-generation-ids(generation),""];
  }
  def fcnv-run(packet,path,context,limit) {
   if ((!nothing?(context) && !((String) value_kind(context) == "int")) || (!((String) value_kind(limit) == "int"))) then fcnv-none("unavailable",path,"integer-context-and-token-allowance-required")
   else if (!fcnv-allowance-valid(context,limit)) then fcnv-none("unavailable",path,"positive-progress-interval-and-initial-context-required")
   else if (((String) path == "") || (!mr-file?(path))) then fcnv-none("unavailable",path,"registry-model-artifact-absent")
   else {
    // The open carries admission, weights, context and the prompt's prefill in one call, and the session keeps each
    // stage's instant on its own record (form-cli-model-session.fk, the session's clock): the door reads the ask's
    // clocks back from it (fcms-clock-read) after the release, so prefill_ms is the prefill alone and decode_ms the
    // decode steps alone, with the admission wait and the open as their own spans.
    let session = nothing?(context) ? fcms-open-reserved(path,packet,fcnv-limit(),fcnv-profile()) : fcms-open-with-profile(path,packet,context,fcnv-profile());
    // This cursor walks one token at a time. Its unused speculative buffers
    // are released before decoding; the coding quantum keeps its own drafter.
    let spare = fcsp-owned(session);
    let retired = fcsp-close(session);
    let returned = spare > 0 && spare==retired ? mg-lease-return(record_get(fcsp-owner(session),"lease-bytes") ?? 0) : 0;
    let cursor = ftg-pulsing(ftg-intercept-with(512,ftg-next-reply()));
    record_set(cursor,"next-progress",limit);
    record_set(cursor,"observer",(stage,phase,c,generated) => fcnv-progress(cursor,limit,stage,phase,generated));
    // Decode is the generate call. The note is a stamp, not a peer line.
    // Prefill stamps are the session's own begin and ready.
    let _decode-begin = q38oo-note("voice-decode-begin", 0);
    let generated = ftg-generate-with(cursor,session,nothing(),"voice");
    let _decode-ready = q38oo-note("voice-decode-ready", 0);
    let ended = fcms-generation-session(generated);
    let released = fcms-release-ok?(ended);
    let clocks = fcms-clock-read(ended);
    fcnv-admitted(fcnv-clocked(fcnv-read(generated,released && spare==retired,path),record_get(clocks,"prefill_ms") ?? 0,record_get(clocks,"decode_ms") ?? 0),record_get(clocks,"admission_ms"),record_get(clocks,"open_ms"));
   };
  }
  // The compatibility field max_reply_tokens now asks for a progress signal.
  // Crossing it does not end a reply or open another model/session.
  def fcnv-progress(cursor,interval,stage,phase,generated) {
   if stage=="model-stream" && phase=="progress" && generated >= record_get(cursor,"next-progress") then {
    let signal=oh-voice(oh-reading("native-voice",host_pid().str(),"generation-progress",json-node-int(record_get(cursor,"next-progress")),json-node-int(generated),json-node-null(),[],["continue"],json-node-object([oh-n("provider_calls",0),oh-s("continuity","same-cursor-and-kv")])));
    record_set(cursor,"next-progress",max2(generated+interval,record_get(cursor,"next-progress")*2));
   } else 0;
   0;
  }
  def fcnv-number(request,key,fallback) = if (!json-object-has?(request,key)) then fallback else {
   let node = json-object-get(request,key); let value = json-int-value(node);
   if (((String) value_kind(value) == "int") && node_eq(node,json-node-int(value))) then value else 0;
  };
  def fcnv-adapter-default() = "form/form-stdlib/adapters/llama-3.2-3b-voice";
  def fcnv-lora-ready?(base,adapter) = ((file_size((base + "/model.safetensors")) > 0) && (file_size((adapter + "/adapters.safetensors")) > 0));
  def fcnv-lora-read(base,adapter,promptIds,spoken,released) {
   let text = spoken[0];
   let why = spoken[1];
   let status = if ((String) trim(text) == "") then "empty" else "answered";
   [status,if ((String) status == "answered") then text else "",promptIds,spoken[2],base,if ((String) why == "") then 1 else 0,released,if ((String) why == "") then status else why,text,[],adapter];
  }
  // The lane is chosen before it is spent, never tried and repeated. Opening the
  // weights and counting the packet's IDs costs a memory map; a forward pass costs
  // minutes. So the chunker is asked first whether any slice of this packet fits
  // the device at all — the same question it would answer during the prefill —
  // and a lane that cannot carry says so before a single token is computed. What
  // follows a refusal is then the first inference of the walk, not a second.
  def fcnv-lora-spoken(base,adapter,packet,limit) {
   let session = nlg-open-at(base,adapter,"");
   let promptIds = len(nlt-chat(session[1],packet));
   let slice = nlg-chunk(session[0],promptIds,0);
   if (slice <= 0) then fcnv-lora-declined(base,adapter,promptIds,nlg-close(session)) else fcnv-lora-spoken-at(base,adapter,packet,limit,session,promptIds);
  }
  def fcnv-lora-declined(base,adapter,promptIds,closed) = ["unavailable","",promptIds,0,base,0,if nothing?(closed) then 0 else 1,"no-slice-of-this-packet-fits-the-device","",[],adapter];
  // The LoRA lane stamps its own stages (nlg-event: one "prefill" row per chunk, one "decode" row per step, each with its
  // wall_ms) into this process's event file; the door reads them back as values and sums each stage.
  def fcnv-lora-events() = ".hearth/voice-lora-" ++ host_pid().str() ++ ".events.jsonl";
  def fcnv-stage-ms(rows,stage) = foldl((total,row) => total + ((String) fcgp-str(row,"stage") == stage ? (fcgp-num(row,"wall_ms") ?? 0) : 0),0,rows);
  def fcnv-lora-spoken-at(base,adapter,packet,limit,session,promptIds) {
   let events = fcnv-lora-events();
   let cleared = write_file_text(events,"");
   let spoken = nlg-ask(session,packet,limit,"","",events);
   let closed = nlg-close(session);
   let rows = fcgp-rows(events);
   fcnv-clocked(fcnv-lora-read(base,adapter,promptIds,spoken,if nothing?(closed) then 0 else 1),fcnv-stage-ms(rows,"prefill"),fcnv-stage-ms(rows,"decode"));
  }

  def fcnv-lora(packet,adapter,limit) {
   let base = nlg-base();
   if (!fcnv-lora-ready?(base,adapter)) then fcnv-none("unavailable",base,"native-weights-or-adapter-absent")
   else if ((limit <= 0) || (limit > 8192)) then fcnv-none("unavailable",base,"positive-token-allowance-up-to-8192-required")
   else fcnv-lora-spoken(base,adapter,packet,limit);
  }
  def fcnv-lane(request) = if json-object-has?(request,"lane") then json-string-value(json-object-get(request,"lane")) else "";
  def fcnv-adapter(request) = if json-object-has?(request,"adapter") then json-string-value(json-object-get(request,"adapter")) else fcnv-adapter-default();
  // Every ask is recorded where it is made (local-run.bml): one LocalRun row with the door's wall clock and the lane's
  // prefill and decode clocks, and one QueryCoverageRow (kind from the request's own "enquiry" when it names one, else
  // from the packet's opening paragraph; source fkwu-model-session; the lane; answered or not; rent 0). The result is the
  // voice's, unchanged. The registry-weights lane queues for its weights at the one place every session opens
  // (fcms-open-sized, model-admission.bml); the LoRA lane opens its own small model here, so it queues at this door.
  // Not admitted within the wait (adm-wait-ms, ten minutes unless FORM_MODEL_ADMISSION_WAIT_MS says otherwise) an ask
  // answers unavailable and names why; that reason is the row's.
  def fcnv-ask(packet,request) {
   let asked = host_monotonic_ms();
   let result = fcnv-carrier-ready(packet,request);
   fcnv-recorded(packet,request,result,host_monotonic_ms() - asked);
  }
  def fcnv-carrier-ready(packet,request) {
   let home = fs-mkdir(".hearth");
   let admission = mca-admit(".hearth/voice-carrier.log",".hearth/voice-carrier.err");
   admission[0] == "standing" || admission[0] == "admitted" ? fcnv-ask-lane(packet,request) : fcnv-none("unavailable","","metal-carrier-" ++ admission[0] ++ ";exit=" ++ admission[1].str() ++ ";evidence=" ++ admission[2]);
  }
  def fcnv-ask-lane(packet,request) = if ((String) fcnv-lane(request) == "lora") then fcnv-lora-admitted(packet,request,adm-admit("fcnv-lora",nlg-base(),adm-wait-ms())) else fcnv-ask-run(packet,request);
  def fcnv-lora-admitted(packet,request,claim) = if (claim[0] == 1) then fcnv-lora-held(packet,request,claim[2]) else fcnv-none("unavailable",nlg-base(),("model-queued: " ++ claim[1]));
  def fcnv-lora-held(packet,request,ticket) {
   defer adm-drop(nlg-base());
   let freed = adm-loaded(ticket);
   fcnv-ask-run(packet,request);
  }
  def fcnv-enquiry(packet,request) = json-object-has?(request,"enquiry") ? json-string-value(json-object-get(request,"enquiry")) : qc-enquiry-of(packet);
  def fcnv-recorded(packet,request,result,wallMs) = fcnv-recorded-at(lrun-ledger(),qc-ledger(),packet,request,result,wallMs);
  def fcnv-recorded-at(runPath,coveragePath,packet,request,result,wallMs) {
   let kept = local-run-record-clocked-at(runPath,result,wallMs,fcnv-prefill-ms(result),fcnv-decode-ms(result),fcnv-admission-ms(result),fcnv-open-ms(result));
   let covered = qc-record-at(coveragePath,qc-kind(fcnv-enquiry(packet,request)),"fkwu-model-session",lrun-lane(result),result[4],(String) result[0] == "answered" ? 1 : 0,0,wallMs);
   result;
  }
  def fcnv-ask-run(packet,request) {
   if ((String) fcnv-lane(request) == "lora") then fcnv-lora(packet,fcnv-adapter(request),fcnv-number(request,"max_reply_tokens",fcnv-limit())) else {
    let model = if json-object-has?(request,"model") then json-string-value(json-object-get(request,"model")) else fcnv-default-model();
    fcnv-run(packet,mr-path(mr-find(model)),fcnv-number(request,"context",nothing()),fcnv-number(request,"max_reply_tokens",fcnv-limit()));
   };
  }
  def fcnv-metadata(result) = json-node-object([oh-s("source","fkwu-model-session"),oh-s("lane",if ((String) result[10] == "") then "registry-weights" else "native-metal-lora"),oh-s("adapter",result[10]),oh-s("status",result[0]),oh-s("model_path",result[4]),oh-n("prompt_ids",result[2]),oh-n("generated_ids",result[3]),oh-n("complete",result[5]),oh-n("release_ok",result[6]),oh-s("reason",result[7]),oh-n("model_server_calls",0),oh-n("provider_calls",0)]);
  def fcnv-retain(job,result) {
   let metadata = (job + "/native-generation.json");
   let raw = write_file_text((job + "/native-generation.txt"),result[8]);
   let ids = write_file_text((job + "/native-generation-ids.json"),json-emit(json-node-array(oh-ints(result[9]))));
   let saved = write_file_text(metadata,json-emit(fcnv-metadata(result)));
   let answered = ((String) result[0] == "answered");
   oh-emit((job + "/events.jsonl"),oh-reading("native-voice",job,"completed-and-released",json-node-int(1),json-node-int(answered),json-node-int(answered),if answered then [] else [oh-need(result[7],json-node-string(metadata))],["inspect-native-evidence","revise-request"],oh-reference(metadata)));
  }
 }
}
