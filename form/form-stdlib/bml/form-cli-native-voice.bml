  def fcnv-recorded(packet,request,result,wallMs) = fcnv-recorded-at(lrun-ledger(),qc-ledger(),packet,request,result,wallMs);
  def fcnv-named-kind(request) = json-object-has?(request,"enquiry_kind") ? json-string-value(json-object-get(request,"enquiry_kind")) : "";
  def fcnv-recorded-at(runPath,coveragePath,packet,request,result,wallMs) {
