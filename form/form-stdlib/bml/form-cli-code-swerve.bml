// form-cli-code-swerve.bml — the coding lane meets a repeat by changing what it does next.
//
// A reply decodes greedy when its observation is new. When the same content was already decoded (in
// this attempt, or by any earlier rung of the same contract), the reply decodes seeded instead:
// a greedy decode of content it has already seen would replay the same bytes. Content is what the model
// is shown about the work (stage, mode, the note's counterexample, the failure evidence, the pending
// tasks, the documents and the replan flag); the counters and reply budget that change every turn are
// left out, since they left greedy output identical. The seed is 1 + (the first 7 hex digits of
// sha256(content + count)) mod 2147483646, count the earlier decodes of that content, so a replay gives
// the same seed and each further repeat a new one. The sampler is the session's own
// (form-cli-model-sampling.bml), opened for that one reply, its presence set cleared once, and closed
// and detached when the reply ends; the session's release still closes whatever it owns.
//
// A repeated context admits its sampler at the executing boundary. Failed admission or reset retains
// the partial owner for session release and emits its cause; it does not replay the same greedy reply.
// The physical witness reads seeded IDs, determinism, release and native submission independently.
//
// At the reply boundary, fcsw-step steps a node. A tool call is the cell. A JSON tool reply is not read.
// The turn after a call is the stillstreak window: at 2 the observation names the
// repeat and carries the edit ladder's nearest_span, at 3 the policy's own no-progress route asks for a
// new plan (once: when the policy's own repeat count already took that route in this turn, the guard
// does not take it again), at 4 the attempt ends with its candidate retained. Each crossing speaks an
// organ-health reading 'tool-progress'. Every reply's decode, tool call and check opens and closes a
// stage on the bus. A reply decoded in a context that has observed nothing yet (the first reply after
// admission, renewal or a resumed checkpoint) counts a new context: the window's span opens anew, and the
// policy's own count of the same call in a row restarts. That is sight regained, and it holds only where sight
// was given: an observation that never entered a context (refused or bounded: fcac-focus-observation) marks the
// record unsighted, and the next context's first reply is not fresh sight, since the call's bytes were never seen
// by the context that ended. It keeps the context and the policy's count, so the same call over the same result
// is the same experiment across the renewal (the day option's three identical 16187-prompt contexts read as one
// span). The mark clears as soon as a context has observed anything.
//
// The record lives in coding memory slot 25 and survives moves, renewal and checkpoints:
// [window repairs decodes greedy seeded seeds stillstreak-max crossings seed-refusals contexts seeds-held unsighted].
// A managed run also appends each decode to <code-memory>/<contract hash>.swerve, so a fresh rung of the
// same contract knows what was already decoded; an evaluation run writes no file. The form-code line
// carries greedy_replies, seeded_replies, seeds, seed_refusals and contexts. Slot 10 retains earlier
// seeds-held counts for checkpoint compatibility; new replies have no source switch holding a seed.
import form-stdlib/bml/form-cli-code-memory.bml;
import form-stdlib/bml/form-cli-code-session.bml;
import form-stdlib/bml/form-cli-code-turn-guard.bml;
import form-stdlib/bml/form-cli-task-runtime.bml;
import form-stdlib/organ-health.bml;
import form-stdlib/spool-bell-transport.fk;
section [form.bml] {
 class FormCliCodeSwerve {
  field SwerveSlot = 25;
  field SwerveKeep = 64;
  field SwerveSeedsKept = 32;
  field SwerveCrossingsKept = 16;
  def fcsw-put(xs, i, v) = append(take(i, xs), cons(v, drop(i + 1, xs)));
  def fcsw-last(n, xs) = drop(max2(0, len(xs) - n), xs);

  // ── the record ──────────────────────────────────────────────────────────
  def fcsw-empty() = [[], [], [], 0, 0, [], 0, [], 0, 0, 0, 0, ""];
  // a record written by an earlier shape reads its missing fields at their defaults
  def fcsw-full(slot) = len(slot) >= len(fcsw-empty()) ? slot : append(slot, drop(len(slot), fcsw-empty()));
  def fcsw-slot(s) = fcsw-full(len(fcap-memory(s)) > SwerveSlot() ? fcap-memory(s)[SwerveSlot()] : fcsw-empty());
  // slots 23 and 24 keep their own defaults when an earlier writer never reached them
  def fcsw-padded(s) = len(fcap-memory(s)) >= SwerveSlot() ? s : fcsw-pad(fcap-with-reasoning(s, fcap-reasoning(s)));
  def fcsw-pad(p) = fcap-with-memory(p, append(fat-take(fcap-memory(p), 23), [fcap-source-repair-open(p), fcap-caller-feedback(p)]));
  def fcsw-with-slot(s, slot) {
   let p = fcsw-padded(s);
   fcap-with-memory(p, append(fat-take(fcap-memory(p), SwerveSlot()), [slot]));
  }
  def fcsw-with-note(s, note) = fcap-inherit(s, fcap-state(fcap-stage(s), s[1], s[2], fcap-docs(s), s[4], s[5], s[6], s[7], note, fcap-turns(s), fcap-calls(s), s[11]));
  def fcsw-flow(s) = fcam-managed(s) ? fcam-id(s) : "code." ++ host_pid().str();

  // ── the decode ──────────────────────────────────────────────────────────
  def fcsw-pending(s) = filter(x => value_kind(x) == "string", s[5]);
  // json-serves: the swerve row, including a later process that reads it. text: the digest is canonical bytes, so the same content matches without sharing a node.
  def fcsw-content(s) = fcctg-sha(json-emit(json-node-array([json-node-string(fcap-stage(s)), json-node-string(fcap-mode(s)), json-node-string(fcap-counterexample(fcap-note(s))),
   json-node-string(fcctg-sha(fcap-evidence(s))), json-node-array(fcctg-strings(fcsw-pending(s))), json-node-string(fcctg-docs-digest(fcap-docs(s))), json-node-int(fcap-repeat(s) ? 1 : 0)])));
  def fcsw-path(s) = fcam-root(s) ++ "/" ++ fcam-hash(fcam-contract(s)) ++ ".swerve";
  def fcsw-disk(s) = split-on(read_file(fcsw-path(s)) ?? "", "\n") |> filter(line => len(line) > 0);
  def fcsw-count(s, content) = fcam-managed(s) ? len(filter(line => fat-starts(line, content), fcsw-disk(s))) : len(filter(d => d[0] == content, fcsw-slot(s)[2]));
  def fcsw-hex(t, i, n, acc) = i >= n ? acc : fcsw-hex(t, i + 1, n, acc * 16 + str_find("0123456789abcdef", substring(t, i, i + 1), 0));
  def fcsw-seed(content, count) = 1 + fcsw-hex(fcctg-sha(content ++ count.str()), 0, 7, 0) % 2147483646;
  // [content count seed]: seed 0 decodes greedy
  def fcsw-decision(s) {
   let content = fcsw-content(s);
   let count = fcsw-count(s, content);
   [content, count, count > 0 ? fcsw-seed(content, count) : 0];
  }
  def fcsw-append(path, text) = (Comparable) sbt-append-count(path, text) == len(text) ? 1 : 0;
  def fcsw-record(s, content, seed, refused) {
   let slot = fcsw-slot(s);
   let written = fcam-managed(s) ? fcsw-append(fcsw-path(s), content ++ " " ++ seed.str() ++ "\n") : 0;
   fcsw-with-slot(s, [slot[0], slot[1], fcsw-last(SwerveKeep(), append(slot[2], [[content, seed]])), slot[3] + (seed > 0 ? 0 : 1), slot[4] + (seed > 0 ? 1 : 0),
     seed > 0 ? fcsw-last(SwerveSeedsKept(), append(slot[5], [seed])) : slot[5], slot[6], slot[7], slot[8] + refused, slot[9], slot[10], slot[11]]);
  }
  def fcsw-bump(s, i) = fcsw-with-slot(s, fcsw-put(fcsw-slot(s), i, fcsw-slot(s)[i] + 1));
  // A reply decoded in a context that has observed nothing yet is that context's first: a new span opens, and
  // the policy's own repeat count (the same call a third time in a row) restarts with it, its call kept, since
  // the context's first re-read gives it back its sight.
  // A context that has observed nothing is fresh sight unless the record is unsighted (the call whose observation
  // never entered a context is still the same experiment): then it keeps its context and count. A context that has
  // observed something clears the mark.
  def fcsw-in-context(session, state) = (Comparable) fcms-observations(session) == 0 ? (fcsw-unsighted(state) == 1 ? state : fcsw-sighted(fcsw-bump(state, 9))) : fcsw-sighted-now(state);
  def fcsw-sighted(s) = fcap-with-memory(s, append(fat-take(fcap-memory(s), 5), [[fcap-tool-history(s)[0], 0]]));
  def fcsw-context(s) = fcsw-slot(s)[9];
  def fcsw-unsighted(s) = fcsw-slot(s)[11];
  def fcsw-mark-unsighted(s) = fcsw-with-slot(s, fcsw-put(fcsw-slot(s), 11, 1));
  def fcsw-sighted-now(s) = fcsw-unsighted(s) == 1 ? fcsw-with-slot(s, fcsw-put(fcsw-slot(s), 11, 0)) : s;
  def fcsw-sampler(session, seed) = fcsam-open(fcms-ctx(session)[2][19], seed);
  // the reply's sampler closes before the session goes on; an incomplete close refuses the session
  def fcsw-release(session) {
   let owner = fcsam-owner(session);
   let expected = fcsam-owned(owner);
   let closed = fcsam-close(owner);
   if (Comparable) closed == expected then fcsam-with-owner(session, []) else {
    oh-voice(oh-reading("native-coding","code." + host_pid().str(),"sampler-release",json-node-int(expected),json-node-int(closed),json-node-int(0),[oh-need("sampler-release",json-node-object([oh-n("expected",expected),oh-n("released",closed)]))],["retain-owner"],json-node-object([oh-s("cause","sampling-release-incomplete")])));
    fcms-refuse(session, "sampling-release-incomplete");
   };
  }
  // A partial sampler stays owned by a refused session until its normal release. No decode runs from
  // that refusal. The admission port lets the same boundary be observed without admitting a model.
  def fcsw-reply(session, state, checker, turns, started, stops, decode, generated) = fcsw-reply-with(session, fcsw-in-context(session, state), checker, turns, started, stops, decode, generated, fcsw-sampler);
  def fcsw-reply-with(session, state, checker, turns, started, stops, decode, generated, sampler) {
   let decided = fcsw-decision(state);
   let seeds = decided[2] > 0;
   let owner = seeds ? sampler(session, decided[2]) : [];
   let admitted = seeds && fcsam-live(owner);
   let reset = admitted ? fcsam-reset(owner) : 0;
   let sampled = admitted && (Comparable) reset == 1;
   let owned = seeds ? fcsam-with-owner(session, owner) : session;
   let reason = !admitted ? "sampling-admission-failed" : "sampling-reset-failed";
   let ready = seeds && !sampled ? fcms-refuse(owned, reason) : owned;
   let recorded = seeds && !sampled ? fcsw-bump(state, 8) : fcsw-record(state, decided[0], sampled ? decided[2] : 0, 0);
   if seeds && !sampled then oh-voice(oh-reading("native-coding",fcsw-flow(state),"sampler-admission",json-node-int(1),json-node-int(0),json-node-int(0),[oh-need("local-sampler",json-node-object([oh-s("cause",reason),oh-n("seed",decided[2]),oh-n("owned_buffers",fcsam-owned(owner))]))],["retain-owner-and-release"],json-node-object([oh-s("cause",reason),oh-n("actions_executed",0)]))) else 0;
   let open = fcacs-stage-open("code.decode", sampled ? "seeded" : "greedy");
   let generation = fcms-live?(ready) ? decode(ready, recorded, started, stops, []) : fcms-generation("", [], ready);
   let after = fcms-generation-session(generation);
   let released = sampled ? fcsw-release(after) : after;
   let closed = fcacs-stage-close(open, !fcms-live?(released) ? fcms-reason(released) : fcms-stopped?(after) ? "ok" : "unstopped", len(fcms-generation-ids(generation)), decided[0]);
   generated(fcms-generation(fcms-generation-text(generation), fcms-generation-ids(generation), released), recorded, checker, turns, started);
  }

  // ── the reply boundary ──────────────────────────────────────────────────
  def fcsw-tool-names() = append(fat-tools(), ["help", "verify", "repair-bml", "rehearse-bml", "lift-bml"]);
  def fcsw-step(state, raw, checker) = fcap-done(state) ? state : fcap-node-address?(raw) ? fcsw-node-step(state,fcap-address-node(raw),checker) : fcap-revise(state, "No native action or reply cell was submitted. Use a complete Form tool call or an observed action/reply coordinate. No tool ran from this reply; original documents and checks remain unchanged.");
  def fcsw-node-step(state,node,checker) {
   if nothing?(node) then fcap-revise(state,"Native address did not resolve. Use an observed cell or return a complete native action/reply control.") else {
    let kids = node_children(node);
    let category = ftw-cat-name(node_category(node));
    if category == "form-code-action" && len(kids) == 3 then {
     let tool = ftw-decode(kids[0]);
     let open = tool == "" ? nothing() : fcacs-stage-open("code.tool", tool);
     fcsw-observed-step(state, fcap-act(state, tool, ftw-decode(kids[1]), ftw-decode(kids[2]), fcsw-staged-checker(checker)), [], open);
    } else {
     let fields = fcap-cell-fields(node);
     if nothing?(fields) then fcap-note-at(state, fcap-stage(state), "Native data observed: " + ftw-coord(node) + ". Continue the current task with this evidence; submit an action or role reply cell.") else if fcap-has-field(fields, "tool") then {
      let tool = fcap-field-string(fields, "tool");
      let args = fcap-field(fields, "arguments");
      let input = fcap-field(fields, "input");
      let open = tool == "" ? nothing() : fcacs-stage-open("code.tool", tool);
      fcsw-observed-step(state, fcap-act(state, tool, nothing?(args) ? [] : args, nothing?(input) ? "" : input, fcsw-staged-checker(checker)), [], open);
     } else if fcap-has-field(fields, "report_amend") then fcsw-observed-step(state, fcap-amend(state, json-node-object([json-node-pair("report_amend", fcap-native-value(fcap-field(fields, "report_amend")))]), fcsw-staged-checker(checker)), [], nothing()) else fcsw-observed-step(state, fcap-reply(state, fields, fcsw-staged-checker(checker)), [], nothing());
    };
   };
  }
  def fcsw-word(err) = err == "" ? "ok" : str_find(err, ":", 0) > 0 ? substring(err, 0, str_find(err, ":", 0)) : err;
  def fcsw-signature(s) = fcap-tool-history(s)[0];
  def fcsw-observed-step(state,next,rows,open) {
   let observed = fcap-calls(next) > fcap-calls(state) && len(fcsw-signature(next)) == 6;
    // Text signatures carry a digest and byte count. Native views carry their
    // shared coordinate and zero emitted stdout bytes, without rendering.
   let entry = observed ? fcctg-entry(fcsw-signature(next)[0], fcsw-signature(next)[1], fcsw-signature(next)[2], fcsw-signature(next)[3], fcap-signature-out(fcsw-signature(next)), fcsw-signature(next)[5], fcap-docs(next), fcsw-context(next)) : [];
   let closed = fcacs-stage-close(open, observed ? fcsw-word(fcsw-signature(next)[5]) : "refused", observed ? fcap-signature-bytes(fcsw-signature(next)) : 0, observed ? entry[1] : 0);
   let guarded = observed ? fcsw-guard(next, entry) : next;
   nil?(rows) ? guarded : fcsw-noted-repairs(guarded, rows);
  }
  def fcsw-armed(slot) = len(slot) > 12 ? slot[12] : "";
  def fcsw-arm-compression(s) {
   let slot = fcsw-slot(s);
   let window = slot[0];
   let digest = nil?(window) ? "" : fctrt-triple(window[-1][0], window[-1][1]);
   (String) digest == "" ? s : fcsw-with-slot(s, fcsw-put(fcsw-slot(s), 12, digest));
  }
  def fcsw-guard(next, entry) {
   let slot = fcsw-slot(next);
   let prior = fcctg-stillstreak(slot[0]);
   let window = fcctg-push(slot[0], entry);
   let streak = fcctg-stillstreak(window);
   let tracked = fcsw-with-slot(next, fcsw-put(fcsw-put(slot, 0, window), 6, max2(slot[6], streak)));
   let compact = fctrt-compact(fcsw-armed(slot), fctrt-triple(entry[0], entry[1]));
   let action = compact == "end" ? "compact" : fcctg-action(prior, streak);
   action == "" ? tracked : fcsw-crossed(tracked, streak, action);
  }
  def fcsw-crossed(s, streak, action) {
   let detail = json-node-object([oh-n("stillstreak", streak), oh-s("action", action), oh-n("turn", fcap-turns(s)), oh-n("context", fcsw-context(s)), oh-s("scope", "native tool calls whose call and result already stood since the last document change in this model context; 2 swerves, 3 replans, 4 ends the attempt with its candidate retained")]);
   let reading = oh-reading("native-coding", fcsw-flow(s), "tool-progress", json-node-int(1), json-node-int(0), json-node-int(0), [oh-need("changed-approach", detail)], ["swerve", "replan", "end"], detail);
   let said = oh-voice(reading);
   let acted = action == "swerve" ? fcsw-swerved(s, streak) : action == "replan" ? fcsw-replanned(s) : action == "compact" ? fcap-terminal(s, "compaction-loop;candidate-retained") : fcap-terminal(s, "stillstreak;candidate-retained");
   let applied = oh-voice(oh-applied(reading, action, json-node-object([oh-s("stage", fcap-stage(acted)), oh-s("reason", fcap-done(acted) ? fcap-note(acted) : "")])));
   let slot = fcsw-slot(acted);
   fcsw-with-slot(acted, fcsw-put(slot, 7, fcsw-last(SwerveCrossingsKept(), append(slot[7], [[fcap-turns(acted), streak, action]]))));
  }
  def fcsw-swerved(s, streak) = fcsw-with-note(s, fcctg-swerve-note(streak, fcsw-signature(s)[0], fcsw-nearest(s), fcctg-returns(fcsw-slot(s)[0])) ++ fcap-note(s));
  // the policy's own count rule (the same call a third time in a row) already took the no-progress route in
  // this turn; the guard's replan is then that same route, taken once
  def fcsw-replanned(s) = fcap-tool-history(s)[1] >= 3 ? s : fcap-no-progress(s);
  // the edit ladder's nearest_span, from the note's or the retained failure's guard evidence
  def fcsw-nearest(s) {
   let near = fcsw-nearest-in(fcap-note(s));
   nothing?(near) ? fcsw-nearest-in(fcap-evidence(s)) : near;
  }
  // json-serves: the model note. text: nearest_span rides in the sentence the model already reads.
  def fcsw-nearest-in(text) {
   let at = str_find(text, "{", 0);
   let raw = at < 0 ? "" : substring(text, at, len(text));
   let obj = faj-valid(raw) ? parse-json("swerve-evidence", raw) : json-node-object([]);
   let guard = fat-wire-object?(obj) && json-object-has?(obj, "guard_evidence") ? json-object-get(obj, "guard_evidence") : json-node-object([]);
   fat-wire-object?(guard) && json-object-has?(guard, "nearest_span") ? json-object-get(guard, "nearest_span") : nothing();
  }
  // json-serves: the model note. text: the repair rows were retained as the bytes the note already speaks.
  def fcsw-noted-repairs(s, rows) {
   let slot = fcsw-slot(s);
   let kept = fcsw-with-slot(s, fcsw-put(slot, 1, fcsw-last(SwerveKeep(), append(slot[1], rows))));
   let observation = faj-valid(fcap-note(kept)) ? parse-json("tool-observation", fcap-note(kept)) : json-node-string(fcap-note(kept));
   fcap-done(kept) ? kept : fcsw-with-note(kept, json-emit(json-node-object([json-node-pair("native_tool_repairs", json-node-array(rows |> map(r => parse-json("tool-repair", r)))), json-node-pair("observation", observation)])));
  }
  // checks open and close their own stages; the caller's callbacks are called exactly as before
  def fcsw-staged-checker(checker) = len(checker) >= 4 ? append([fcsw-check-stage(checker[0], "caller"), checker[1], fcsw-check-stage(checker[2], "source"), checker[3]], drop(4, checker))
   : len(checker) >= 2 ? append([fcsw-check-stage(checker[0], "source"), checker[1]], drop(2, checker)) : checker;
  def fcsw-check-stage(callback, key) = (contract, subject) => fcsw-checked(callback, contract, subject, key);
  def fcsw-checked(callback, contract, subject, key) {
   let open = fcacs-stage-open("code.check", key);
   let result = callback(contract, subject);
   let closed = fcacs-stage-close(open, fcsw-check-word(result), 1, fcsw-check-digest(result));
   result;
  }
  def fcsw-check-word(result) = !fcap-check-shape?(result) ? "malformed" : (Value) result[0] == 1 ? "ok" : "refused";
  def fcsw-check-digest(result) = fcap-check-shape?(result) ? fcctg-sha(node_value(fcctg-assertion-core(json-node-string(result[1])))) : 0;

  // ── what the lane says ──────────────────────────────────────────────────
  def fcsw-telemetry-pairs(s) {
   let slot = fcsw-slot(s);
   [json-node-pair("greedy_replies", json-node-int(slot[3])), json-node-pair("seeded_replies", json-node-int(slot[4])), json-node-pair("seeds", json-node-array(slot[5] |> map(json-node-int))),
    json-node-pair("seed_refusals", json-node-int(slot[8])), json-node-pair("stillstreak", json-node-int(fcctg-stillstreak(slot[0]))), json-node-pair("stillstreak_max", json-node-int(slot[6])),
    json-node-pair("tool_repairs", json-node-int(len(slot[1]))), json-node-pair("seeds_held", json-node-int(slot[10])), json-node-pair("contexts", json-node-int(slot[9]))];
  }
  // the deliverable reserve: when the replies left are no more than the completion protocol needs
  def fcsw-reserve?(s, remaining, minimum) = !fcap-reviewing(s) && !fcap-done(s) && remaining > 0 && remaining <= minimum;
  def fcsw-finish-now() = "Finish now: the remaining replies equal the minimum completion protocol. Return task=done for the implemented task, then the review verdict with concrete findings; a further read or verify leaves no reply for the deliverable. All caller checks still apply.";
  def fcsw-coding-instruction(s, remaining, minimum, ordinary) = fcsw-reserve?(s, remaining, minimum) ? fcsw-finish-now() : ordinary;

 }
 0;
}
