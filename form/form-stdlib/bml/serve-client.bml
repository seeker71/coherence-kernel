// serve-client.bml — the asking side of the resident serving loop (observe/qwen-serve-run.bml): is a server standing, put a request in its spool, wait for its reply.
//
// The spool is a directory (default /tmp/form-serve, one for the whole machine as the GPU lease is): a client writes its request into tmp/ and renames it into
// req/<id>.json (whole or absent); the server claims it (req -> work), reads it in chunks with every other live sequence, and writes reply/<id>.json the same way.
// A server STANDS when its status.json names a pid that is alive and is the same process (host_process's start time matches) and no stop file asks it to
// end. A caller that finds none runs a session of its own and names why (svc-reason); a caller that finds one never opens its own model, because the server
// holds the GPU lease for its whole life and a second Metal client would wait on it for ever.
//
// Waiting is never cut: a reply is waited for as long as the server lives (wait_ms 0), and a server that dies while the request waits is named (server-gone) so
// the caller can run its own session. Pressure slows a reply, it never truncates it.
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/serve-sched.bml
section [form.bml] {
 class ServeClient {
  def svc-default-dir() = "/tmp/form-serve";
  def svc-status-path(dir) = dir ++ "/status.json";
  def svc-readable(path) {
   let t = read_file(path);
   nothing?(t) ? "" : t;
  }
  // answers ["standing", status doc] or ["absent", reason]
  def svc-standing(dir) {
   let text = svc-readable(svc-status-path(dir));
   len(trim(text)) == 0 ? ["absent", "no status file at " ++ svc-status-path(dir)] : svc-standing-doc(dir, try parse-json("serve-status", trim(text)) catch nothing());
  }
  def svc-standing-doc(dir, doc) = nothing?(doc) ? ["absent", "status file unreadable"] : svc-standing-row(dir, doc, host_process(json-int-value(json-object-get(doc, "pid"))));
  def svc-standing-row(dir, doc, row) = (String) value_kind(row) != "list" ? ["absent", "the server's process is gone (pid " ++ json-int-value(json-object-get(doc, "pid")).str() ++ ")"] : row[5] != json-int-value(json-object-get(doc, "start")) ? ["absent", "the server's pid was reused"] : (Comparable) file_size(dir ++ "/stop") >= 0 ? ["absent", "the server is stopping"] : ["standing", doc];
  def svc-reason(st) = st[1];
  // ── a request ──
  def svc-spec-json(prompt, lens, chat, max, stops, prio, who) = svc-spec-json-drawn(prompt, lens, chat, max, stops, prio, who, 0, 0);
  // a request that draws its tokens: temperature in thousandths (0 keeps greedy) and a seed (one seed and one prompt always draw the same text)
  def svc-spec-json-drawn(prompt, lens, chat, max, stops, prio, who, tmilli, seed) = json-emit(json-node-object(append(append(append([svs-s("prompt", prompt), svs-n("chat", chat), svs-n("max_tokens", max), svs-n("priority", prio), svs-s("who", who)], len(lens) > 0 ? [svs-s("lens", lens)] : []), len(stops) > 0 ? [json-node-pair("stop", json-node-array(map(t => json-node-string(t), stops)))] : []), tmilli > 0 ? [svs-n("temperature_milli", tmilli), svs-n("seed", seed)] : [])));
  // the request is written whole into tmp/ and renamed into req/; answers the id
  def svc-submit(dir, tag, text) {
   let id = host_pid().str() ++ "-" ++ now_unix_ms().str() ++ "-" ++ tag;
   let made = host_dir_mkdir(dir) + host_dir_mkdir(dir ++ "/tmp") + host_dir_mkdir(dir ++ "/req") + host_dir_mkdir(dir ++ "/reply");
   let w = write_file(dir ++ "/tmp/" ++ id ++ ".req", text);
   let r = w < 0 ? -1 : host_path_rename(dir ++ "/tmp/" ++ id ++ ".req", dir ++ "/req/" ++ id ++ ".json");
   r == 0 ? id : "";
  }
  // waits for the reply of id; answers ["answered", doc] or ["unserved", reason]. The server is looked at every 5 s: a dead one ends the wait by name.
  def svc-wait(dir, id, wait_ms) = svc-wait-go(dir, id, wait_ms, host_monotonic_ms(), host_monotonic_ms());
  def svc-wait-go(dir, id, wait_ms, began, looked) {
   let path = dir ++ "/reply/" ++ id ++ ".json";
   let text = svc-readable(path);
   len(trim(text)) > 0 ? svc-take(path, text) : wait_ms > 0 && host_monotonic_ms() - began > wait_ms ? ["unserved", "wait-ended after " ++ wait_ms.str() ++ " ms; the request still stands in the spool as " ++ id] : host_monotonic_ms() - looked > 5000 ? svc-look(dir, id, wait_ms, began) : svc-nap(dir, id, wait_ms, began, looked);
  }
  def svc-take(path, text) {
   let doc = parse-json("serve-reply", trim(text));
   let gone = host_path_remove(path);
   ["answered", doc];
  }
  def svc-look(dir, id, wait_ms, began) = (String) svc-standing(dir)[0] == "standing" ? svc-wait-go(dir, id, wait_ms, began, host_monotonic_ms()) : svc-after-gone(dir, id, svc-standing(dir));
  // a server that ended may have written the reply as its last act: one more reading before the wait is called gone
  def svc-after-gone(dir, id, st) {
   let text = svc-readable(dir ++ "/reply/" ++ id ++ ".json");
   len(trim(text)) > 0 ? svc-take(dir ++ "/reply/" ++ id ++ ".json", text) : ["unserved", "server-gone: " ++ st[1]];
  }
  def svc-nap(dir, id, wait_ms, began, looked) {
   let slept = host_sleep_ms(100);
   svc-wait-go(dir, id, wait_ms, began, looked);
  }
  // ── reading a reply ──
  def svc-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def svc-int(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : 0;
  def svc-answered?(doc) = (String) svc-str(doc, "status") == "stop" || (String) svc-str(doc, "status") == "stop-string" || (String) svc-str(doc, "status") == "length";
  // ── the planner's door: a packet asked of the server, answered in the native voice's shape (form-cli-native-voice fcnv-none / fcnv-clocked / fcnv-admitted) ──
  // nothing when no server stands (the caller asks its own session, the reason printed); else [status, text, prompt_ids, generated_ids, model, complete, released, reason,
  // partial, envelope, "", prefill_ms, decode_ms, queue_ms, 0]. The server decodes greedily with no grammar hook, so the planner's envelope is not applied: the planner's
  // own parse and verdict read the reply, as they read every reply.
  def svc-voice(packet, limit, who) = svc-voice-at(svc-default-dir(), packet, limit, who, 0, 0);
  // the same ask with its tokens drawn at a temperature (thousandths) from a seed: a retry that must not repeat the greedy reply it was refused for
  def svc-voice-drawn(packet, limit, who, tmilli, seed) = svc-voice-at(svc-default-dir(), packet, limit, who, tmilli, seed);
  def svc-voice-at(dir, packet, limit, who, tmilli, seed) {
   let st = svc-standing(dir);
   (String) st[0] != "standing" ? svc-voice-said("no server stands (" ++ st[1] ++ ")") : svc-voice-ask(dir, packet, limit, who, tmilli, seed);
  }
  def svc-voice-said(why) {
   let said = print_str("[serve] " ++ why ++ "; the caller's own session answers\n");
   nothing();
  }
  def svc-voice-ask(dir, packet, limit, who, tmilli, seed) {
   let id = svc-submit(dir, "v", svc-spec-json-drawn(packet, "", 1, limit, [], 0, who, tmilli, seed));
   let r = len(id) == 0 ? ["unserved", "the spool refused the request file"] : svc-wait(dir, id, 0);
   (String) r[0] == "answered" ? svc-voice-of(r[1]) : svc-voice-down(r[1]);
  }
  def svc-voice-down(reason) = svc-voice-said("unserved (" ++ reason ++ ")");
  def svc-voice-of(doc) = svc-answered?(doc) ? [ "answered", svc-str(doc, "text"), svc-int(doc, "prompt_ids"), svc-int(doc, "generated_ids"), "serve:qwen3.8-27b", 1, 1, "", "", [], "", svc-int(doc, "prefill_ms"), svc-int(doc, "decode_ms"), svc-int(doc, "queue_ms"), 0] : ["unavailable", "", svc-int(doc, "prompt_ids"), svc-int(doc, "generated_ids"), "serve:qwen3.8-27b", 0, 1, "serve-" ++ svc-str(doc, "status") ++ (len(svc-str(doc, "reason")) > 0 ? ":" ++ svc-str(doc, "reason") : ""), svc-str(doc, "text"), [], "", svc-int(doc, "prefill_ms"), svc-int(doc, "decode_ms"), svc-int(doc, "queue_ms"), 0];
 }
 0;
}
