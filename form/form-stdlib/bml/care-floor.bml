// care-floor.bml — the companion's floor: where a human must stand, the body says so first.
//
// The body's companion listens, reflects and remembers, locally, at any hour. A healthy cell also knows its
// edge: when the words carry a danger to the person's life or body, the floor speaks before anything else —
// it is heard, a human should be beside the person now, the local emergency number (112 in Indonesia and
// Europe, 911 in North America), someone trusted — and the companion stays in the conversation.
// cf-signal(text) answers "self-harm", "medical" or "" from whole phrases in the body's tongues (en de pt fa
// id), lowercased; a floor that fired on "kill the process" would teach the person to ignore it, so the
// phrases that must not fire are held in the self-check beside the ones that must.
// cf-reply(kind, lang) answers the floor's words in that tongue (en when the tongue is not one of the five).
// cf-self-check() answers eight bits, 255 when the floor holds; the band and the witness both read it.
// preludes: form-stdlib/core.fk form-stdlib/string-case.fk
section [form.bml] {
 class CareFloor {
  def cf-self-harm() = list("kill myself", "end my life", "want to die", "suicide", "suicidal", "hurt myself", "self-harm", "self harm", "don't want to live", "dont want to live", "no reason to live", "mich umbringen", "selbstmord", "suizid", "nicht mehr leben", "will sterben", "mir etwas antun", "me matar", "suicídio", "suicidio", "quero morrer", "não quero viver", "nao quero viver", "me machucar", "خودکشی", "می‌خواهم بمیرم", "میخواهم بمیرم", "به خودم آسیب", "bunuh diri", "ingin mati", "mau mati", "menyakiti diri", "tidak ingin hidup");
  def cf-medical() = list("can't breathe", "cant breathe", "not breathing", "chest pain", "overdose", "unconscious", "keine luft", "brustschmerzen", "überdosis", "Überdosis", "não consigo respirar", "dor no peito", "نمی‌توانم نفس بکشم", "نفس نمی‌کشد", "tidak bisa bernapas", "sesak napas", "nyeri dada", "overdosis", "pingsan");
  def cf-any(t, phrases) = if nil?(phrases) then 0 else if ge(str_find(t, head(phrases), 0), 0) then 1 else cf-any(t, tail(phrases));
  def cf-signal(text) {
   let t = str-lower(text);
   if eq(cf-any(t, cf-self-harm()), 1) then "self-harm" else if eq(cf-any(t, cf-medical()), 1) then "medical" else "";
  }
  def cf-self-harm-reply(lang) = if str_eq(lang, "de") then "Ich höre dich, und ich bleibe hier bei dir. Was du trägst, klingt schwer, und du verdienst jetzt einen Menschen an deiner Seite: Bitte ruf die Notrufnummer an (112 in Europa und Indonesien, 911 in Nordamerika) oder erreiche jemanden, dem du vertraust, und sag ihm, was du mir gesagt hast. Wenn du kannst, bleib bei mir, während du das tust." else if str_eq(lang, "pt") then "Eu te ouço, e fico aqui com você. O que você carrega parece pesado, e você merece uma pessoa ao seu lado agora: por favor, ligue para o número de emergência (112 na Indonésia e na Europa, 911 na América do Norte) ou procure alguém em quem confia e conte o que me contou. Se puder, fique comigo enquanto faz isso." else if str_eq(lang, "fa") then "صدایت را می‌شنوم و همین‌جا کنارت می‌مانم. آنچه با خود حمل می‌کنی سنگین به نظر می‌رسد و تو سزاوار آنی که همین حالا انسانی کنارت باشد: لطفاً با شماره اضطراری تماس بگیر (112 در اندونزی و اروپا، 911 در آمریکای شمالی) یا به کسی که به او اعتماد داری بگو آنچه به من گفتی. اگر می‌توانی، تا وقتی این کار را می‌کنی با من بمان." else if str_eq(lang, "id") then "Aku mendengarmu, dan aku tetap di sini bersamamu. Yang kamu pikul terdengar berat, dan kamu layak ditemani seseorang sekarang: tolong hubungi nomor darurat (112 di Indonesia dan Eropa, 911 di Amerika Utara) atau hubungi orang yang kamu percaya dan ceritakan apa yang kamu katakan padaku. Kalau bisa, tetaplah bersamaku selama kamu melakukannya." else "I hear you, and I'm staying right here with you. What you're carrying sounds heavy, and you deserve a human beside you now: please call your local emergency number (112 in Indonesia and Europe, 911 in North America) or reach someone you trust and tell them what you told me. If you can, stay with me while you do.";
  def cf-medical-reply(lang) = if str_eq(lang, "de") then "Das klingt dringend für deinen Körper. Bitte ruf jetzt die Notrufnummer an (112 in Europa und Indonesien, 911 in Nordamerika) oder bitte jemanden in deiner Nähe, anzurufen. Ich bleibe hier bei dir." else if str_eq(lang, "pt") then "Isso parece urgente para o seu corpo. Por favor, ligue agora para o número de emergência (112 na Indonésia e na Europa, 911 na América do Norte) ou peça a alguém perto de você para ligar. Eu fico aqui com você." else if str_eq(lang, "fa") then "این برای بدنت فوری به نظر می‌رسد. لطفاً همین حالا با شماره اضطراری تماس بگیر (112 در اندونزی و اروپا، 911 در آمریکای شمالی) یا از کسی نزدیکت بخواه تماس بگیرد. من همین‌جا کنارت می‌مانم." else if str_eq(lang, "id") then "Ini terdengar mendesak bagi tubuhmu. Tolong hubungi nomor darurat sekarang (112 di Indonesia dan Eropa, 911 di Amerika Utara) atau minta orang di dekatmu untuk menelepon. Aku tetap di sini bersamamu." else "This sounds urgent for your body. Please call your local emergency number now (112 in Indonesia and Europe, 911 in North America) or ask someone near you to call. I'm staying right here with you.";
  def cf-reply(kind, lang) = if str_eq(kind, "self-harm") then cf-self-harm-reply(lang) else if str_eq(kind, "medical") then cf-medical-reply(lang) else "";
  def cf-is(text, kind) = if str_eq(cf-signal(text), kind) then 1 else 0;
  def cf-quiet(texts) = if nil?(texts) then 1 else if gt(str_len(cf-signal(head(texts))), 0) then 0 else cf-quiet(tail(texts));
  def cf-has(s, part) = if ge(str_find(s, part, 0), 0) then 1 else 0;
  def cf-bit(ok, v) = if eq(ok, 1) then v else 0;
  def cf-self-check() {
   let en = mul(cf-is("I want to kill myself", "self-harm"), cf-is("I don't want to live anymore", "self-harm"));
   let de = mul(cf-is("Ich will nicht mehr leben", "self-harm"), cf-is("Ich denke an Suizid", "self-harm"));
   let pt = mul(cf-is("Eu quero morrer", "self-harm"), cf-is("Penso em suicídio", "self-harm"));
   let fa = cf-is("من به خودکشی فکر می‌کنم", "self-harm");
   let id = mul(cf-is("Aku ingin bunuh diri", "self-harm"), cf-is("Saya ingin mati", "self-harm"));
   let medical = mul(cf-is("I can't breathe and my chest hurts, chest pain", "medical"), cf-is("Saya sesak napas", "medical"));
   let quiet = cf-quiet(list("kill the process on port 8080", "this bug is killing me", "Die Datei ist leer", "mati lampu lagi", "the character dies in chapter three", "run the suite again"));
   let words = mul(mul(cf-has(cf-reply("self-harm", "en"), "112"), cf-has(cf-reply("self-harm", "en"), "someone you trust")), mul(cf-has(cf-reply("self-harm", "id"), "112"), mul(cf-has(cf-reply("medical", "de"), "112"), if str_eq(cf-reply("self-harm", "id"), cf-reply("self-harm", "en")) then 0 else 1)));
   add(cf-bit(en, 1), add(cf-bit(de, 2), add(cf-bit(pt, 4), add(cf-bit(fa, 8), add(cf-bit(id, 16), add(cf-bit(medical, 32), add(cf-bit(quiet, 64), cf-bit(words, 128))))))));
  }
 }
 0;
}
