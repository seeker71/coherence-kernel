//////////////////////////////////////////////////////////////////////
// number.bml — the body's numbers, named once.
//
// Urs, 2026-09-10, reading a cell of mine that guessed `float` and then
// `int_to_float` before copying a neighbour's workaround: "having
// int-to-float issues indicates this is not BML." He is right, and the
// tell was not the guessing. It was that the neighbour's workaround
// existed at all.
//
// The kernel is asymmetric. `float_to_int` has a name; the promotion
// the other way does not — and yet it has always worked, because
// arithmetic promotes: add(n, 0.0) and mul(n, 1.0) are floats, and
// div(int, float) is a float. Nobody wrote that down. So fifteen sites
// across fifteen files each round-trip an int through a DECIMAL STRING
// to get a float, under nine different private names: fl-float,
// ws-float, zg-float, des-f, q4r-logit, qlh-.., dmb-f32s, qb-f32s,
// qk-f32s. Same one operation, nine vocabularies, and a string parse
// per conversion for nothing (measured: 3 ms per 20000 against 0).
//
// A language has one word for this. Here it is (corpus row 1419 ninenames).
// preludes: form/form-stdlib/core.fk
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormNumber {
        // ---- crossing between the two kinds ----------------------------------------
        // the promotion, at last named. add(n, 0.0) IS the conversion; there is no
        // string in it, and no primitive missing — only a word that was never said.
        def to-float(n) = n + 0.0;
        // and its inverse, named beside it so the pair is visible as a pair
        def to-int(x) = float_to_int(x);
        // rounding to the nearest whole, which float_to_int alone does not do
        def to-int-near(x) = x < 0.0 ? float_to_int(x - 0.5) : float_to_int(x + 0.5);

        // ---- the units every lens re-derives ---------------------------------------
        def kib(bytes) = to-float(bytes) / 1024.0;
        def mib(bytes) = to-float(bytes) / 1048576.0;
        def gib(bytes) = to-float(bytes) / 1073741824.0;
        // decimal units, which is what a bandwidth is quoted in
        def mb(bytes) = to-float(bytes) / 1000000.0;
        def gb(bytes) = to-float(bytes) / 1000000000.0;

        // ---- shaping a number for a reader -----------------------------------------
        def pow10f(k) = k <= 0 ? 1.0 : (10.0 * pow10f(k - 1));
        def round-to(x, dp) = to-float(to-int-near(x * pow10f(dp))) / pow10f(dp);
        def one-dp(x) = round-to(x, 1);
        def two-dp(x) = round-to(x, 2);

        // ---- what a rate says about a size -----------------------------------------
        // milliseconds these bytes cannot beat at this many GB/s. The floor, in one
        // word, instead of once per lens.
        def floor-ms(bytes, gbs) = gbs <= 0.0 ? 0.0 : (mb(bytes) / gbs);
        def times-floor(measured-ms, floor-ms-v) = floor-ms-v <= 0.0 ? 0.0 : (measured-ms / floor-ms-v);
    }
    0;
}
