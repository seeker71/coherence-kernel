// transmute.bml — an event from the world arrives; the body reads which of its own ideas the event serves, and its
// own voice tells the event from there, with the source kept whole and the lift measured.
//
// TRANSMUTATION IS NOT A WORD SWAP. The first slice (2026-10-19 afternoon) lifted control words by the purify grammar
// and the voice rendered a BBC passage faithfully — words lifted 0, register 0 -> 0. Urs: go deeper; have the
// transmutation be how an event is serving the ideas of us. So the organ now reads an event in layers, each the
// body's own move:
//   what happened        the facts, names and numbers, attributed to the source, kept whole
//   what it asks for     the need under the pressure, in the words the event itself gives (lc-when-the-pressure-comes,
//                        move 2: naming the underlying need; the observer first, move 1: what is here)
//   which ideas it serves the field's ideas and concepts the event calls, is evidence for, or questions — the body reads
//                        the seeds natively first (the resonance below), and the voice reasons over what the body chose
//   the gift             what the event has not yet unwrapped (move 3), where a person standing in it could meet the field
//   the lift             the same event told from trust — the fact unchanged, the direction toward aliveness — in the
//                        sentences each surface would carry (stream, board, encyclopedia, thread)
// The operator beneath them (move 5) is the choice of frequency, angle and focus at the moment the pressure discharges;
// the reading chooses them in the open, and the person's reading of the result is what teaches the body.
//
// THE SEEDS. The field's ideas live in the parent body (Coherence-Network: ideas/INDEX.md rows, docs/vision-kb/INDEX.md
// concept lines with their Hz). The organ reads those index lines as they are — no second copy — into seeds
// [id, hz, essence, kind]. Resonance is the body's own structural read: the words an event and a seed share, stopwords
// aside; the resonant seeds are what the voice sees, so the native read grounds the rented-shaped reasoning
// (form-cli-grounded-synthesis.bml's pattern: bounded's rent with guided's ground, here at rent 0).
//
// THE VOICE'S CLAIMS ARE CHECKED. It names the ideas it serves by id in brackets; only ids the seeds hold enter the
// ledger as ideas served. A name the field does not hold is a counterfeit and is dropped, as the covenant says.
//
// Honest floor: the register is counted over the purify grammar's seed words by word boundary (the grammar growing from
// what arrives is a filed request); resonance is word overlap, a structural read, until the concept resonance kernel
// is native; the felt frequency of an event is the person's reading. PROOF: form-stdlib/tests/transmute-band.bml.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/word-frequency-purify.fk cognition/dialogue-covenant.fk form-stdlib/bml/order.bml
section [form.bml] {
 class Transmute {
  // ── the purify grammar: the control register, counted and lifted ──────────────────────────────────────────────
  def tm-rows() = wfp-rows();
  def tm-lb(b) = b >= 65 && b <= 90 ? b + 32 : b;
  def tm-letter?(b) = (b >= 97 && b <= 122) || (b >= 65 && b <= 90);
  def tm-lower-go(s, i, n, out) = i >= n ? out : tm-lower-go(s, i + 1, n, out ++ byte_to_str(tm-lb(str_byte_at(s, i))));
  def tm-lower(s) = tm-lower-go(s, 0, len(s), "");
  def tm-free?(t, at, wlen) = (at == 0 || !tm-letter?(str_byte_at(t, at - 1))) && (at + wlen >= len(t) || !tm-letter?(str_byte_at(t, at + wlen)));
  def tm-count-go(t, w, from, acc) {
   let at = str_find(t, w, from);
   at < 0 ? acc : tm-count-go(t, w, at + len(w), acc + (tm-free?(t, at, len(w)) ? 1 : 0));
  }
  def tm-count(text, word) = tm-count-go(tm-lower(text), word, 0, 0);
  def tm-lifts(text) = filter(r => tm-count(text, wfp-word(r)) > 0, tm-rows());
  def tm-register(text) = foldl((a, r) => a + tm-count(text, wfp-word(r)), 0, tm-rows());
  def tm-lift-line(r) = "  " ++ wfp-word(r) ++ " — common: " ++ wfp-common(r) ++ " — here: " ++ wfp-purified(r) ++ "\n";
  def tm-lift-lines(rs) = foldl((a, r) => a ++ tm-lift-line(r), "", rs);
  // ── the seeds: the field's ideas and concepts, read from the parent's own index lines ──────────────────────────
  def tm-seed(id, hz, essence, kind) = [id, hz, essence, kind];
  def tm-sid(s) = s[0];
  def tm-shz(s) = s[1];
  def tm-sessence(s) = s[2];
  def tm-skind(s) = s[3];
  def tm-lines(text) = filter(l => len(l) > 0, split-on(text ?? "", "\n"));
  def tm-between(s, from, to, start) {
   let a = str_find(s, from, start);
   let b = a < 0 ? -1 : str_find(s, to, a + len(from));
   a < 0 || b < 0 ? "" : substring(s, a + len(from), b);
  }
  def tm-int(s) = tm-int-go(s, 0, 0);
  def tm-int-go(s, i, acc) = i >= len(s) ? acc : (str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57) ? tm-int-go(s, i + 1, acc * 10 + (str_byte_at(s, i) - 48)) : acc;
  // a concept line: `- **[The Pulse](concepts/lc-pulse.md)** — 432 Hz — the cell and the field thrive | \`status: seed\``,
  // or without an Hz: `- [Name](concepts/lc-x.md) — the essence`. Offsets are bytes: the dash is three of them.
  def tm-concept-line?(l) = str_find(l, "](concepts/", 0) >= 0;
  def tm-concept-seed(l) {
   let id = tm-between(l, "](concepts/", ".md", 0);
   let linkEnd = str_find(l, ")", str_find(l, "](concepts/", 0));
   let d1 = str_find(l, " — ", linkEnd);
   let rest = d1 < 0 ? "" : substring(l, d1 + len(" — "), len(l));
   let hzAt = str_find(rest, " Hz — ", 0);
   let hzOnly = hzAt < 0 && len(rest) >= 3 && (String) substring(rest, len(rest) - 3, len(rest)) == " Hz";
   let hz = hzAt >= 0 ? tm-int(trim(substring(rest, 0, hzAt))) : hzOnly ? tm-int(trim(rest)) : 0;
   let body = hzAt >= 0 ? substring(rest, hzAt + len(" Hz — "), len(rest)) : hzOnly ? "" : rest;
   let cut = str_find(body, " | ", 0);
   tm-seed(id, hz, tm-short(trim(cut < 0 ? body : substring(body, 0, cut))), "concept");
  }
  // an essence is a seed, not a page: the first 240 bytes, cut at a space so no character is torn
  def tm-short(s) = len(s) <= 240 ? s : tm-short-at(s, 240);
  def tm-short-at(s, at) = at <= 0 ? substring(s, 0, 240) : (Comparable) str_byte_at(s, at) == 32 ? substring(s, 0, at) : tm-short-at(s, at - 1);
  // an idea row: `| [Light Hub Membrane](light-hub-membrane.md) | surfaces | impl | 1 | Service board, light identity |`
  def tm-idea-row?(l) = str_find(l, "| [", 0) == 0;
  def tm-idea-seed(l) {
   let id = tm-between(l, "](", ".md", 0);
   let cells = map(c => trim(c), split-on(l, "|"));
   tm-seed(id, 0, tm-short(len(cells) > 5 ? cells[5] : ""), "idea");
  }
  def tm-concept-seeds(text) = map(l => tm-concept-seed(l), filter(l => tm-concept-line?(l), tm-lines(text)));
  def tm-idea-seeds(text) = map(l => tm-idea-seed(l), filter(l => tm-idea-row?(l), tm-lines(text)));
  def tm-seeds-at(ideasPath, conceptsPath) = append((Comparable) len(ideasPath) == 0 || (Comparable) fs_exists(ideasPath) == 0 ? [] : tm-idea-seeds(read_file(ideasPath)), (Comparable) len(conceptsPath) == 0 || (Comparable) fs_exists(conceptsPath) == 0 ? [] : tm-concept-seeds(read_file(conceptsPath)));
  // ── resonance: the words an event and a seed share — the body's structural read, before any voice ───────────
  def tm-stop() = ["the", "and", "that", "with", "from", "this", "after", "over", "into", "their", "they", "have", "been", "were", "writes", "says", "said", "about", "which", "while", "also", "more", "than", "when", "what", "will", "would", "could", "your", "ours", "between", "through", "where", "there", "these", "those", "under", "being", "into", "each", "other", "field", "cell"];
  def tm-in?(x, xs) = nil?(xs) ? false : (String) xs[0] == x ? true : tm-in?(x, xs[1:]);
  def tm-words-go(t, i, n, cur, out) = i >= n ? (len(cur) >= 4 && !tm-in?(cur, tm-stop()) ? cons(cur, out) : out) : tm-letter?(str_byte_at(t, i)) ? tm-words-go(t, i + 1, n, cur ++ byte_to_str(tm-lb(str_byte_at(t, i))), out) : tm-words-go(t, i + 1, n, "", len(cur) >= 4 && !tm-in?(cur, tm-stop()) ? cons(cur, out) : out);
  def tm-words(t) = tm-uniq(tm-words-go(t, 0, len(t), "", []), []);
  def tm-uniq(xs, out) = nil?(xs) ? out : tm-in?(xs[0], out) ? tm-uniq(xs[1:], out) : tm-uniq(xs[1:], cons(xs[0], out));
  // a seed's words are its essence's and its id's (lc-economy -> economy)
  def tm-seed-words(s) = tm-words(tm-sessence(s) ++ " " ++ tm-sid(s));
  def tm-overlap(a, b) = foldl((n, w) => n + (tm-in?(w, b) ? 1 : 0), 0, a);
  def tm-key(n) = tm-zeros(6 - len(n.str())) ++ n.str();
  def tm-zeros(k) = k <= 0 ? "" : "0" ++ tm-zeros(k - 1);
  // [overlap, seed] for every seed sharing at least one word, strongest first
  def tm-resonance(seeds, passage) {
   let ws = tm-words(passage);
   let scored = filter(p => p[0] > 0, map(s => [tm-overlap(ws, tm-seed-words(s)), s], seeds));
   reverse(map(r => r[1], sort-keyed(map(p => [tm-key(p[0]) ++ tm-sid(p[1]), p], scored))));
  }
  def tm-take(xs, n) = n <= 0 || nil?(xs) ? [] : cons(xs[0], tm-take(xs[1:], n - 1));
  def tm-seed-line(s) = "  [" ++ tm-sid(s) ++ "]" ++ (tm-shz(s) > 0 ? " (" ++ tm-shz(s).str() ++ " Hz)" : " (idea)") ++ " " ++ tm-sessence(s) ++ "\n";
  def tm-seed-lines(ss) = foldl((a, s) => a ++ tm-seed-line(s), "", ss);
  def tm-resonant-lines(rs) = foldl((a, p) => a ++ "  " ++ p[0].str() ++ "  [" ++ tm-sid(p[1]) ++ "] " ++ tm-sessence(p[1]) ++ "\n", "", rs);
  // what the voice sees: every idea seed, and the most resonant concept seeds the body chose
  def tm-shown(seeds, resonant, n) = append(filter(s => (String) tm-skind(s) == "idea", seeds), tm-take(map(p => p[1], filter(p => (String) tm-skind(p[1]) == "concept", resonant)), n));
  // ── the ideas the voice names, checked against the seeds ──────────────────────────────────────────────────────
  def tm-served(answer, seeds) = filter(s => str_find(answer, "[" ++ tm-sid(s) ++ "]", 0) >= 0, seeds);
  // ── the packets ───────────────────────────────────────────────────────────────────────────────────────────────
  def tm-packet(source, passage, lifts) = dc-card-core() ++ "\nYou transmute a passage from the world into this field's language. Keep every fact, name and number exactly as given, and attribute what the source says to the source" ++ ((Comparable) len(source) == 0 ? "" : " (" ++ source ++ ")") ++ ". Where the passage names what is absent or what must be, name the path that is offered and who chooses. Hedge every interior you did not observe. Speak toward trust and aliveness, in plain words, the same length or shorter, with no narration of your own moves." ++ ((Comparable) len(lifts) == 0 ? "" : "\n\nThe words to lift, with the usage this field gives them:\n" ++ tm-lift-lines(lifts)) ++ "\nThe passage:\n" ++ passage ++ "\n\nThe transmutation:";
  def tm-event-packet(source, passage, lifts, shown) = dc-card-core() ++ "\nAn event arrived from the world. Read it as this field reads pressure — the observer first, then the need, then the gift — and tell how the event is serving the ideas this field holds. Write five short layers, each with its heading on its own line:\n\nWhat happened — the facts, names and numbers exactly as given, attributed to the source" ++ ((Comparable) len(source) == 0 ? "" : " (" ++ source ++ ")") ++ ".\n\nWhat it is asking for — the need under the pressure, named once, in words the event itself gives; what the event shows, never what anyone in it feels.\n\nWhich ideas it serves — from the field's ideas below, name two or three by their id in square brackets exactly as written, and for each say in one sentence whether the event is evidence for it, a call to it, or a question to it, and how.\n\nThe gift — what this event has not yet unwrapped: what becomes possible if those ideas answered it, and one door where a person standing in the event could meet the field.\n\nThe lift — the same event told from trust: the fact unchanged, the direction toward aliveness, in four sentences — one a stream would carry, one a board would pin, one an encyclopedia would keep as evidence on the idea's page, one that opens a thread with a question.\n\nHedge every interior you did not observe; keep the people in the event theirs; plain words; no narration of your own moves; name no idea that is not in the list." ++ ((Comparable) len(lifts) == 0 ? "" : "\n\nWords in the event to lift, with the usage this field gives them:\n" ++ tm-lift-lines(lifts)) ++ "\n\nThe field's ideas (id, Hz where it has one, essence):\n" ++ tm-seed-lines(shown) ++ "\nThe event:\n" ++ passage ++ "\n\nThe reading:";
 }
 0;
}
