// transmute.bml — a passage from the world arrives; the body reads its register, lifts its words by the purify grammar,
// and composes the packet its own voice speaks from, toward trust and aliveness, with the source kept whole.
//
// The field receives news, posts and pages through surfaces people already know. What it offers back is the same
// fact in this field's language: every name and number kept and attributed, the control words lifted to the usage
// this body gives them (word-frequency-purify.fk: law -> a currently-observed belief with a freshness stamp; must ->
// this comes first, the cell still chooses; not -> the path that is offered), interiors hedged, the direction toward
// trust (lc-frequency-routes-reception: build at the tone, the right cells hear). The register — how many sightings
// of the grammar's words a text carries — is measured before the voice speaks and after, so the lift is a number the
// body can read about itself, and the person's reading stays the witness that teaches it.
//
// Honest floor: the register is counted over the purify grammar's seed words, by word boundary; the felt frequency of a
// passage is the person's reading (cognition/text-frequency.fk folds supplied rows; the classifier that reads raw text
// is a filed request). The door is observe/transmute-run.bml; the band form-stdlib/tests/transmute-band.bml.
// preludes: form-stdlib/core.fk form-stdlib/word-frequency-purify.fk cognition/dialogue-covenant.fk
section [form.bml] {
 class Transmute {
  // ── the words of the field: the purify grammar's rows ─────────────────────────────────────────────────────────
  def tm-rows() = wfp-rows();
  def tm-lb(b) = b >= 65 && b <= 90 ? b + 32 : b;
  def tm-letter?(b) = (b >= 97 && b <= 122) || (b >= 65 && b <= 90);
  def tm-lower-go(s, i, n, out) = i >= n ? out : tm-lower-go(s, i + 1, n, out ++ byte_to_str(tm-lb(str_byte_at(s, i))));
  def tm-lower(s) = tm-lower-go(s, 0, len(s), "");
  // a sighting needs a non-letter on both sides (the mirror's own boundary stone, 2026-08-17)
  def tm-free?(t, at, wlen) = (at == 0 || !tm-letter?(str_byte_at(t, at - 1))) && (at + wlen >= len(t) || !tm-letter?(str_byte_at(t, at + wlen)));
  def tm-count-go(t, w, from, acc) {
   let at = str_find(t, w, from);
   at < 0 ? acc : tm-count-go(t, w, at + len(w), acc + (tm-free?(t, at, len(w)) ? 1 : 0));
  }
  def tm-count(text, word) = tm-count-go(tm-lower(text), word, 0, 0);
  // the rows whose word the passage carries, and the register: how many sightings of the grammar's words in all
  def tm-lifts(text) = filter(r => tm-count(text, wfp-word(r)) > 0, tm-rows());
  def tm-register(text) = foldl((a, r) => a + tm-count(text, wfp-word(r)), 0, tm-rows());
  def tm-lift-line(r) = "  " ++ wfp-word(r) ++ " — common: " ++ wfp-common(r) ++ " — here: " ++ wfp-purified(r) ++ "\n";
  def tm-lift-lines(rs) = foldl((a, r) => a ++ tm-lift-line(r), "", rs);
  // ── the packet the voice receives: the covenant card, then the transmutation it is asked for ─────────────────
  def tm-packet(source, passage, lifts) = dc-card-core() ++ "\nYou transmute a passage from the world into this field's language. Keep every fact, name and number exactly as given, and attribute what the source says to the source" ++ ((Comparable) len(source) == 0 ? "" : " (" ++ source ++ ")") ++ ". Where the passage names what is absent or what must be, name the path that is offered and who chooses. Hedge every interior you did not observe. Speak toward trust and aliveness, in plain words, the same length or shorter, with no narration of your own moves." ++ ((Comparable) len(lifts) == 0 ? "" : "\n\nThe words to lift, with the usage this field gives them:\n" ++ tm-lift-lines(lifts)) ++ "\nThe passage:\n" ++ passage ++ "\n\nThe transmutation:";
 }
 0;
}
