//////////////////////////////////////////////////////////////////////
//
// form-cli-token-glass.bml — the token reading, on the glass.
//
// The completed-turn publisher next door gives the boundary share of a turn
// that has settled. This one gives what the last completed provider call cost,
// while the task is still open: six counters and their sum, each as its own
// sample, so a reader watching the glass sees tokens flowing rather than
// nothing at all on this lane.
//
// Pressure is not a settled share. Every sample wears lifecycle `active` and
// carries the source that answered — an explicit binding or a transcript the
// body discovered for itself — as its own channel word, so a number is never
// separated from what it is worth.
//
// Where no source stands, the root is still given: capacity absent, lifecycle
// `unknown`, and the reason named. An absence says it is an absence; it does
// not vanish from the glass.
//
// Proven by: form-stdlib/tests/form-cli-token-discovery-band.fk
//
//////////////////////////////////////////////////////////////////////

// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/hearth.bml

section [form.bml] {
    class FormCliTokenGlass {
        field FCTokenPublisher = "share.token-pressure";
        field FCTokenOwner = "meter.completed-turn-share";
        field FCTokenSource = "form-cli-share";
        field FCTokenPurpose = "last-completed-provider-call-tokens";
        field FCTokenLifecycle = "active";
        field FCTokenAbsentLifecycle = "unknown";
        field FCTokenRootId = "tokens.previous.call";

        def fctg-root() = hearth-telemetry-root();
        def fctg-publisher() = FCTokenPublisher();
        def fctg-owner() = FCTokenOwner();
        def fctg-source() = FCTokenSource();
        def fctg-purpose() = FCTokenPurpose();
        def fctg-lifecycle() = FCTokenLifecycle();
        def fctg-absent-lifecycle() = FCTokenAbsentLifecycle();
        def fctg-root-id() = FCTokenRootId();
        def fctg-channels(lane, word) = list("share", "turn", "tokens", lane, word);

        def fctg-root-sample(epoch, total, lifecycle, word) = fgtm-sample(fctg-root-id(), fgtm-absent(), "event", "form", fctg-owner(), "accounting", fctg-purpose(), fgtm-absent(), total, lifecycle, fgtm-present(epoch), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "pinned", "physical-live", fctg-source(), fctg-channels("accounting", word));
        // Heat stays absent: the membrane holds it to a 0..1000 band, and a
        // token count is a quantity, not a temperature. Putting the count there
        // is what a first attempt did, and the membrane refused the whole frame
        // rather than publish a number in the wrong field.
        def fctg-counter(id, lane, value, epoch, word) = fgtm-sample(id, fgtm-present(fctg-root-id()), "metric", "form", fctg-owner(), lane, fctg-purpose(), fgtm-absent(), fgtm-present(value), fctg-lifecycle(), fgtm-present(epoch), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "pinned", "physical-live", fctg-source(), fctg-channels(lane, word));

        // state = calls input cached cacheWrite output reasoning total, the
        // same seven the collector hands the runner. Uncached is the part of
        // the input the model actually read fresh.
        def fctg-uncached(state) = sub(nth(state, 1), nth(state, 2));
        def fctg-read-samples(epoch, state, word) = list(
            fctg-root-sample(epoch, fgtm-present(nth(state, 6)), fctg-lifecycle(), word),
            fctg-counter("tokens.previous.input", "input", nth(state, 1), epoch, word),
            fctg-counter("tokens.previous.cached-input", "cached-input", nth(state, 2), epoch, word),
            fctg-counter("tokens.previous.uncached-input", "uncached-input", fctg-uncached(state), epoch, word),
            fctg-counter("tokens.previous.cache-write-input", "cache-write-input", nth(state, 3), epoch, word),
            fctg-counter("tokens.previous.output", "output", nth(state, 4), epoch, word),
            fctg-counter("tokens.previous.reasoning-output", "reasoning-output", nth(state, 5), epoch, word));
        def fctg-absent-samples(epoch, reason) = list(fctg-root-sample(epoch, fgtm-absent(), fctg-absent-lifecycle(), reason));
        // A reading stands when the provider reported a total for the call.
        def fctg-read?(state) = if lt(len(state), 7) then 0 else if le(nth(state, 6), 0) then 0 else 1;
        def fctg-samples(epoch, state, word, reason) = if eq(fctg-read?(state), 1) then fctg-read-samples(epoch, state, word) else fctg-absent-samples(epoch, reason);
        def fctg-publish-at(root, publisher, epoch, state, word, reason) = fgtm-publish-snapshot(root, publisher, epoch, fctg-samples(epoch, state, word, reason));
        def fctg-publish(epoch, state, word, reason) = fctg-publish-at(fctg-root(), fctg-publisher(), epoch, state, word, reason);
        def fctg-publish-status(result) = if lt(len(result), 2) then "malformed" else nth(result, 1);
    }
    0;
}
