//////////////////////////////////////////////////////////////////////
//
// form-cli-one-turn.bml — high-grammar authority for one local turn.
//
// The biggest gap is not 10% remote share. It is 107 rented turns
// where one local walk should have finished the request. Native then
// local. Remote reviews at most once. Further remotes are leak.
//
// Executable lowering: form-stdlib/form-cli-one-turn.bml
// Proven by: form-stdlib/tests/form-cli-one-turn-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.oneturn;

import Form.kernel.*;
import Form.cli.flow.*;
import Form.cli.localready.*;

enum TurnNext [public] {
   LOCAL,
   REMOTE,
   STOP,
   NOTHING
}

interface IOneTurn [public, witness, reusable] {
   section [public] {
      const int OneTurn = 1;
      const int RemoteReviewCap = 1;
      const int LaneNative = 0;
      const int LaneLocal = 1;
      const int LaneRemote = 2;
      const int NextLocal = 0;
      const int NextRemote = 1;
      const int NextStop = 2;
      const int NextNothing = 3;

      int Resolved( int nLane ) [abstract];
      int Walk( int nNativeHit, String strShape ) [abstract];
      int Next( int nTurnsUsed, int nResolved ) [abstract];
      int LeakOneRequest( int nRemoteTurns ) [abstract];
   }
}

template RequestBudget<TTurn> [public, reusable] {
   section [public] {
      TTurn LocalFirst() [get];
      TTurn RemoteReview() [get];
      int Cap() [get];
   }
}

class FormOneTurn [public, reusable, flow] : IOneTurn {
   section [public] {
      const String TrustRule = "one local turn finishes the request; remote reviews at most once";
      const String ExecutablePath = "form/form-stdlib/form-cli-one-turn.bml";

      int Resolved( int nLane ) [abstract] {}
      int Walk( int nNativeHit, String strShape ) [abstract] {}
      int Next( int nTurnsUsed, int nResolved ) [abstract] {}
      int LeakOneRequest( int nRemoteTurns ) [abstract] {}
   }
}

class FormOneTurnSelf [public, selfHosting, flow, observable] {
   section [public] {
      const String CoreName = "form-cli-one-turn-self";
      const String Pattern = "named-const one-local-turn remote-review-once leak";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
