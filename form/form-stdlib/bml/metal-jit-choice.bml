// Several witnessed policy sets can coexist. A choice names its domain and
// epoch explicitly; an expired or failed witness cannot select a live program.
// This is executable policy over GPU results, with freshness supplied by the
// existing belief lifecycle. The caller defines the comparison's domain.
// preludes: form-stdlib/bml/metal-jit.bml observe/belief-freshness.fk
section [form.bml] {
 class MetalJitChoice {
  def mjc-witness(id, domain, version, date, expected, observed) = list(domain, version, bf-belief(id, if and(gt(mj-handle(version), 0), str_eq(expected, observed)) then 1 else 0, date));
  def mjc-choose(policy, domain, epoch) = if and(str_eq(head(policy), domain), bf-law?(nth(policy, 2), epoch)) then nth(policy, 1) else nothing();
  def mjc-rewitness(policy, date, expected, observed) = list(head(policy), nth(policy, 1), bf-rewitness(nth(policy, 2), date, if str_eq(expected, observed) then 1 else 0));
 }
 0;
}
