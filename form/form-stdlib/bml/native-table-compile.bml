// Native bootstrap table generation. Sources, the string pool and the lowered
// program stay in RAM; the caller receives one table for artifact publication.
// NTC2 stdin: count, authored/read module pairs, then entry authored/read.
// The count/path legacy frame remains accepted. Entry is always emitted last.
// preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/hati-os-kernel.fk form-stdlib/form-parse.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/host-effect-grammar.fk form-stdlib/form-flatten.fk form-stdlib/form-table-text.fk form-stdlib/fkc-table-serialize.fk form-stdlib/bml/native-table-sources.bml
section [form.bml] {
 class NativeTableCompile {
  def ntc-line() {
   let line = read_line();
   if nothing?(line) then nts-refuse("incomplete-request", "") else line;
  }
  def ntc-count(text) = if eq(str_len(text), 0) then nts-refuse("empty-count", "") else ntc-count-at(text, 0, 0);
  def ntc-count-at(text, at, count) {
   if eq(at, str_len(text)) then count else {
    let digit = sub(str_byte_at(text, at), 48);
    if or(or(lt(digit, 0), gt(digit, 9)), gt(count, div(sub(4611686018427387903, digit), 10))) then nts-refuse("invalid-count", text)
    else ntc-count-at(text, add(at, 1), add(mul(count, 10), digit));
   }
  }
  def ntc-pair(version) {
   let owner = ntc-line();
   list(owner, if version then ntc-line() else owner);
  }
  def ntc-read-modules(count, version, rows) = if le(count, 0) then reverse(rows) else ntc-read-modules(sub(count, 1), version, cons(ntc-pair(version), rows));
  def ntc-table(modules, entry) {
   let pool = flt-band-sources-pool(modules, entry);
   fks-table-file(flt-band-sources-fns2(modules, entry, pool), pool);
  }
  def ntc-run() {
   let first = read_line();
   if or(nothing?(first), eq(str_len(first), 0)) then nothing()
   else ntc-request(first, str_eq(first, "NTC2"));
  }
  def ntc-request(first, version) {
   let count = ntc-count(if version then ntc-line() else first);
   let modules = ntc-read-modules(count, version, list());
   let entry = ntc-pair(version);
   if not(nothing?(read_line())) then nts-refuse("trailing-request", "") else ntc-path-table(modules, entry);
  }
  def ntc-lowered(rows) = if nil?(rows) then list() else cons(nth(head(rows), 3), ntc-lowered(tail(rows)));
  def ntc-path-table(modules, entry) {
   let held = nts-assemble(modules, entry);
   let texts = ntc-lowered(held);
   let table = ntc-table(take(sub(len(texts), 1), texts), nth(texts, sub(len(texts), 1)));
   nts-held(held);
   table;
  }
 }
 ntc-run();
}
