// Native bootstrap table generation. Sources, the string pool and the lowered
// program stay in RAM; the caller receives one table for artifact publication.
// stdin: module count, module paths in order, then the entry source path.
// preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/hati-os-kernel.fk form-stdlib/form-parse.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/host-effect-grammar.fk form-stdlib/form-flatten.fk form-stdlib/form-table-text.fk form-stdlib/fkc-table-serialize.fk
section [form.bml] {
 class NativeTableCompile {
  def ntc-read-modules(count, rows) = if le(count, 0) then reverse(rows) else ntc-read-modules(sub(count, 1), cons(read_file(read_line()), rows));
  def ntc-table(modules, entry) {
   let pool = flt-band-sources-pool(modules, entry);
   fks-table-file(flt-band-sources-fns2(modules, entry, pool), pool);
  }
  def ntc-run() {
   let count = read_line();
   if or(nothing?(count), eq(str_len(count), 0)) then nothing()
   else ntc-entry(ntc-read-modules(str_to_int(count), list()));
  }
  def ntc-entry(modules) = ntc-table(modules, read_file(read_line()));
 }
 ntc-run();
}
