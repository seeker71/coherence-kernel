// The native curriculum runs in one disposable body, with isolated memory.
// Candidate checks keep their own explicit deadlines; the coordinator follows
// progress rather than imposing a second deadline on the whole curriculum.
// preludes: form-stdlib/bml/form-cli-heal-eval-policy.bml form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class FormCliHealNativeEvaluation {
  def fne-body-names(names) = names |> filter(name => fhn-member(list(".fk", ".bml", ".c"), fs-path-extension(name)));
  def fne-selected(rows, id) = (String) id == "" ? rows : list(fhe-find(rows, id));
  def fhn-evaluate(fields) {
   let root = fhn-root();
   let job = fhn-unique(fhn-at(root, ".form-heal"), "eval-native-");
   nothing?(job) ? form_error("native evaluation evidence directory unavailable") : 0;
   let made = fs_mkdir(fhn-at(job, "work"));
   let snapshot = fhn-write-json(fhn-at(job, "snapshot.json"), json-node-object(list(fhn-s("root", root))));
   let mode = (Comparable) len(fields) == 4 ? "native" : "deterministic";
   let model = (Comparable) len(fields) == 4 ? fields[2] : "";
   let id = (Comparable) len(fields) == 4 ? fields[3] : "";
   let memory = fhn-hash(fhn-at(root, ".form-heal/learned.tsv"));
   let entered = print_str("evaluation-report=" ++ job ++ "\n");
   let curriculum = write_file(fhn-at(job, "curriculum.json"), fhe-manifest());
   let inventory = fhn-shell(fhn-at(job, "inventory.sh"), fh-cat(list("git ls-files -z --cached --others --exclude-standard > ", fh-quote(fhn-at(job, "inventory.nul")), "\n")));
   let names = append(fne-body-names(fhn-clean-names(split-on(fhn-read(fhn-at(job, "inventory.nul")), byte_to_str(0)), list())), list("fkwu", ".gitignore"));
   let lines = write_file(fhn-at(job, "names.txt"), fhn-lines(names));
   let nuls = write_file(fhn-at(job, "names.nul"), fhn-nuls(names));
   !(((Comparable) inventory == 0) && (fhn-names-valid(names, root) && fhn-no-links(job, root, fhn-at(job, "names.txt")))) ? "evaluation-refused:body-inventory" : fne-copy(job, root, mode, model, fne-selected(fhe-cases(), id), memory);
  }
  def fne-copy(job, root, mode, model, rows, memory) {
   let archive = fhn-command(list("/usr/bin/tar", "-c", "-f", fhn-at(job, "body.tar"), "-C", root, "--null", "-T", fhn-at(job, "names.nul")));
   let copied = (Comparable) archive == 0 ? fhn-command(list("/usr/bin/tar", "-x", "-p", "-f", fhn-at(job, "body.tar"), "-C", fhn-at(job, "work"))) : 1;
   let init = (Comparable) copied == 0 ? fhn-command(list("git", "-C", fhn-at(job, "work"), "init", "-q")) : 1;
   !((Comparable) init == 0) ? "evaluation-refused:body-copy" : fne-finish(job, root, mode, model, memory, fne-cases(job, rows, mode, model, list()));
  }
  def fne-cases(job, rows, mode, model, results) = nil?(rows) ? reverse(results) : fne-case(job, head(rows), tail(rows), mode, model, results);
  def fne-case(job, row, remaining, mode, model, results) {
   let id = head(row);
   let target = write_file(fhn-at(job, "work/" ++ HealEvalTarget()), row[4]);
   let checker = write_file(fhn-at(job, "work/" ++ HealEvalChecker()), row[5]);
   let caseDir = fhn-at(job, id);
   let made = fs_mkdir(caseDir);
   let original = write_file(fhn-at(caseDir, "original.fk"), row[4]);
   let band = write_file(fhn-at(caseDir, "checker.fk"), row[5]);
   let input = fhn-at(caseDir, "input");
   let wrote = write_file(input, fh-cat(list(id, "\n", mode, "\n", model, "\n")));
   let stage = "case-" ++ id;
   let status = fhn-run(job, stage, 0, "work", input, list("./fkwu", "observe/form-cli-heal-eval-case.bml"));
   let output = fhn-read(fhn-stage-path(job, stage, ".out"));
   let evidence = fhn-field(split-on(output, "\n"), "evaluation-evidence=");
   let owned = (String) fs-path-dirname(evidence) == fhn-at(job, "work/.form-heal");
   let result = owned ? json-array-elements(fhn-json(fhn-at(evidence, "evaluation-result.json"))) : list();
   let matched = ((Comparable) len(result) == 8) && (((String) json-string-value(head(result)) == id) && (((String) json-string-value(result[1]) == row[1]) && ((String) json-string-value(result[2]) == row[2])));
   let memoryClean = file_size(fhn-at(job, "work/.form-heal/learned.tsv")) < 0;
   let outcome = ((String) status == "0") && (matched && memoryClean) ? json-string-value(result[3]) : "incomplete";
   let copy = owned ? fhn-command(list("/bin/cp", "-R", evidence, fhn-at(caseDir, "evidence"))) : 1;
   let archivedReport = (Comparable) copy == 0 ? fhn-report(fhn-at(caseDir, "evidence")) : "";
   let record = json-node-object(list(fhn-s("id", id), fhn-s("split", row[1]), fhn-s("family", row[2]), fhn-s("outcome", outcome), fhn-s("mode", mode), fhn-s("model", model), fhn-s("status", status), fhn-s("original_sha256", fhn-hash(fhn-at(caseDir, "original.fk"))), fhn-s("checker_sha256", fhn-hash(fhn-at(caseDir, "checker.fk"))), fhn-s("source_after_sha256", fhn-hash(fhn-at(job, "work/" ++ HealEvalTarget()))), fhn-n("evidence_copy_status", copy)));
   let saved = fhn-write-json(fhn-at(caseDir, "observation.json"), record);
   let notice = print_str(fh-cat(list(id, " split=", row[1], " outcome=", outcome, "\n")));
   !fhn-member(list("repaired", "unresolved", "preserved"), outcome) ? reverse(cons(record, results)) : fne-cases(job, remaining, mode, model, cons(record, results));
  }
  def fne-count(rows, outcome) = nil?(rows) ? 0 : (((String) fhn-string(head(rows), "outcome") == outcome ? 1 : 0) + fne-count(tail(rows), outcome));
  def fne-valid(rows) = nil?(rows) ? 1 : (fhn-member(list("repaired", "unresolved", "preserved"), fhn-string(head(rows), "outcome")) && (((Comparable) fhn-number(head(rows), "evidence_copy_status") == 0) && fne-valid(tail(rows))));
  def fne-finish(job, root, mode, model, memory, results) {
   let unchanged = (String) memory == fhn-hash(fhn-at(root, ".form-heal/learned.tsv"));
   let valid = unchanged && fne-valid(results);
   let state = valid ? "measured" : "incomplete";
   let summary = fhn-write-json(fhn-at(job, "summary.json"), json-node-object(list(fhn-s("version", HealEvalVersion()), fhn-s("status", state), fhn-s("mode", mode), fhn-s("model", model), fhn-s("training", "none"), fhn-n("remote_calls", 0), fhn-n("repair_memory_unchanged", unchanged), fhn-n("repaired", fne-count(results, "repaired")), fhn-n("unresolved", fne-count(results, "unresolved")), fhn-n("preserved", fne-count(results, "preserved")), fhn-s("curriculum_sha256", fhn-hash(fhn-at(job, "curriculum.json"))), fhn-s("snapshot_sha256", fhn-hash(fhn-at(job, "body.tar"))), fhn-s("scope", "candidate-generation-and-real-checks;retrieval-excluded;no-pretraining-exposure-claim"), fhn-a("cases", results))));
   let report = fhn-report(job);
   let released = valid ? fhn-command(list("/bin/rm", "-rf", "--", fhn-at(job, "work"), fhn-at(job, "body.tar"))) : 1;
   fh-cat(list("heal evaluation ", state, "; repaired=", int_to_str(fne-count(results, "repaired")), "; unresolved=", int_to_str(fne-count(results, "unresolved")), "; preserved=", int_to_str(fne-count(results, "preserved")), "; training=none; remote=0\nevaluation-report=", job, "\n"));
  }
 }
 0;
}
