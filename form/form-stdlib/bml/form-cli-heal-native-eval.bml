// The native curriculum runs in one disposable body, with isolated memory.
// Candidate checks keep their own explicit deadlines; the coordinator follows
// progress rather than imposing a second deadline on the whole curriculum.
// preludes: form-stdlib/bml/form-cli-heal-eval-policy.bml form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class FormCliHealNativeEvaluation {
  def fne-body-names(names) = if nil?(names) then list() else if fhn-member(list(".fk", ".bml", ".c"), fs-path-extension(head(names))) then cons(head(names), fne-body-names(tail(names))) else fne-body-names(tail(names));
  def fne-selected(rows, id) = if str_eq(id, "") then rows else list(fhe-find(rows, id));
  def fhn-evaluate(fields) {
   let root = fhn-root();
   let job = fhn-unique(fhn-at(root, ".form-heal"), "eval-native-", 0);
   let made = fs_mkdir(fhn-at(job, "work"));
   let snapshot = fhn-write-json(fhn-at(job, "snapshot.json"), json-node-object(list(fhn-s("root", root))));
   let mode = if eq(len(fields), 4) then "native" else "deterministic";
   let model = if eq(len(fields), 4) then nth(fields, 2) else "";
   let id = if eq(len(fields), 4) then nth(fields, 3) else "";
   let memory = fhn-hash(fhn-at(root, ".form-heal/learned.tsv"));
   let entered = print_str(str_concat("evaluation-report=", str_concat(job, "\n")));
   let curriculum = write_file(fhn-at(job, "curriculum.json"), fhe-manifest());
   let inventory = fhn-shell(fhn-at(job, "inventory.sh"), fh-cat(list("git ls-files -z --cached --others --exclude-standard > ", fh-quote(fhn-at(job, "inventory.nul")), "\n")));
   let names = append(fne-body-names(fhn-clean-names(split-on(fhn-read(fhn-at(job, "inventory.nul")), byte_to_str(0)), list())), list("fkwu", ".gitignore"));
   let lines = write_file(fhn-at(job, "names.txt"), fhn-lines(names));
   let nuls = write_file(fhn-at(job, "names.nul"), fhn-nuls(names));
   if not(and(eq(inventory, 0), and(fhn-names-valid(names, root), fhn-no-links(job, root, fhn-at(job, "names.txt"))))) then "evaluation-refused:body-inventory" else fne-copy(job, root, mode, model, fne-selected(fhe-cases(), id), memory);
  }
  def fne-copy(job, root, mode, model, rows, memory) {
   let archive = fhn-command(list("/usr/bin/tar", "-c", "-f", fhn-at(job, "body.tar"), "-C", root, "--null", "-T", fhn-at(job, "names.nul")));
   let copied = if eq(archive, 0) then fhn-command(list("/usr/bin/tar", "-x", "-p", "-f", fhn-at(job, "body.tar"), "-C", fhn-at(job, "work"))) else 1;
   let init = if eq(copied, 0) then fhn-command(list("git", "-C", fhn-at(job, "work"), "init", "-q")) else 1;
   if not(eq(init, 0)) then "evaluation-refused:body-copy" else fne-finish(job, root, mode, model, memory, fne-cases(job, rows, mode, model, list()));
  }
  def fne-cases(job, rows, mode, model, results) = if nil?(rows) then reverse(results) else fne-case(job, head(rows), tail(rows), mode, model, results);
  def fne-case(job, row, remaining, mode, model, results) {
   let id = head(row);
   let target = write_file(fhn-at(job, str_concat("work/", HealEvalTarget())), nth(row, 4));
   let checker = write_file(fhn-at(job, str_concat("work/", HealEvalChecker())), nth(row, 5));
   let caseDir = fhn-at(job, id);
   let made = fs_mkdir(caseDir);
   let original = write_file(fhn-at(caseDir, "original.fk"), nth(row, 4));
   let band = write_file(fhn-at(caseDir, "checker.fk"), nth(row, 5));
   let input = fhn-at(caseDir, "input");
   let wrote = write_file(input, fh-cat(list(id, "\n", mode, "\n", model, "\n")));
   let stage = str_concat("case-", id);
   let status = fhn-run(job, stage, 0, "work", input, list("./fkwu", "observe/form-cli-heal-eval-case.bml"));
   let output = fhn-read(fhn-stage-path(job, stage, ".out"));
   let evidence = fhn-field(split-on(output, "\n"), "evaluation-evidence=");
   let owned = str_eq(fs-path-dirname(evidence), fhn-at(job, "work/.form-heal"));
   let result = if owned then json-array-elements(fhn-json(fhn-at(evidence, "evaluation-result.json"))) else list();
   let matched = and(eq(len(result), 8), and(str_eq(json-string-value(head(result)), id), and(str_eq(json-string-value(nth(result, 1)), nth(row, 1)), str_eq(json-string-value(nth(result, 2)), nth(row, 2)))));
   let memoryClean = lt(file_size(fhn-at(job, "work/.form-heal/learned.tsv")), 0);
   let outcome = if and(str_eq(status, "0"), and(matched, memoryClean)) then json-string-value(nth(result, 3)) else "incomplete";
   let copy = if owned then fhn-command(list("/bin/cp", "-R", evidence, fhn-at(caseDir, "evidence"))) else 1;
   let archivedReport = if eq(copy, 0) then fhn-report(fhn-at(caseDir, "evidence")) else "";
   let record = json-node-object(list(fhn-s("id", id), fhn-s("split", nth(row, 1)), fhn-s("family", nth(row, 2)), fhn-s("outcome", outcome), fhn-s("mode", mode), fhn-s("model", model), fhn-s("status", status), fhn-s("original_sha256", fhn-hash(fhn-at(caseDir, "original.fk"))), fhn-s("checker_sha256", fhn-hash(fhn-at(caseDir, "checker.fk"))), fhn-s("source_after_sha256", fhn-hash(fhn-at(job, str_concat("work/", HealEvalTarget())))), fhn-n("evidence_copy_status", copy)));
   let saved = fhn-write-json(fhn-at(caseDir, "observation.json"), record);
   let notice = print_str(fh-cat(list(id, " split=", nth(row, 1), " outcome=", outcome, "\n")));
   if not(fhn-member(list("repaired", "unresolved", "preserved"), outcome)) then reverse(cons(record, results)) else fne-cases(job, remaining, mode, model, cons(record, results));
  }
  def fne-count(rows, outcome) = if nil?(rows) then 0 else add(if str_eq(fhn-string(head(rows), "outcome"), outcome) then 1 else 0, fne-count(tail(rows), outcome));
  def fne-valid(rows) = if nil?(rows) then 1 else and(fhn-member(list("repaired", "unresolved", "preserved"), fhn-string(head(rows), "outcome")), and(eq(fhn-number(head(rows), "evidence_copy_status"), 0), fne-valid(tail(rows))));
  def fne-finish(job, root, mode, model, memory, results) {
   let unchanged = str_eq(memory, fhn-hash(fhn-at(root, ".form-heal/learned.tsv")));
   let valid = and(unchanged, fne-valid(results));
   let state = if valid then "measured" else "incomplete";
   let summary = fhn-write-json(fhn-at(job, "summary.json"), json-node-object(list(fhn-s("version", HealEvalVersion()), fhn-s("status", state), fhn-s("mode", mode), fhn-s("model", model), fhn-s("training", "none"), fhn-n("remote_calls", 0), fhn-n("repair_memory_unchanged", unchanged), fhn-n("repaired", fne-count(results, "repaired")), fhn-n("unresolved", fne-count(results, "unresolved")), fhn-n("preserved", fne-count(results, "preserved")), fhn-s("curriculum_sha256", fhn-hash(fhn-at(job, "curriculum.json"))), fhn-s("snapshot_sha256", fhn-hash(fhn-at(job, "body.tar"))), fhn-s("scope", "candidate-generation-and-real-checks;retrieval-excluded;no-pretraining-exposure-claim"), fhn-a("cases", results))));
   let report = fhn-report(job);
   let released = if valid then fhn-command(list("/bin/rm", "-rf", "--", fhn-at(job, "work"), fhn-at(job, "body.tar"))) else 1;
   fh-cat(list("heal evaluation ", state, "; repaired=", int_to_str(fne-count(results, "repaired")), "; unresolved=", int_to_str(fne-count(results, "unresolved")), "; preserved=", int_to_str(fne-count(results, "preserved")), "; training=none; remote=0\nevaluation-report=", job, "\n"));
  }
 }
 0;
}
