//////////////////////////////////////////////////////////////////////
//
// form-cli-resident-turnwheel.bml — high-grammar authority for a living
// scannerless Form resident. This is the language the local model can learn
// to speak about its own row without a tokenizer pre-step or a host API.
//
// Native lowering: form-stdlib/form-cli-resident-turnwheel-native-bml.fk
//
// The compiler reads these declarations once when a resident is born, forms
// NodeID-addressed decision images, and lets the existing in-RAM Form JIT
// retain them.  There is no emitted source-shaped `*-xtal.fk` mirror.
// Proven by: form-stdlib/tests/form-cli-resident-turnwheel-bml-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.resident;

import Form.kernel.*;
import BMF.primitive.*;

interface IResidentTurnStage [public, observable, reusable] {
   Object Id() [get];
   String Phase() [get];
   String Signal() [get];
   int Gas() [get];
   int Tokens() [get];
}

interface IResidentTurnwheel [public, witness, reusable] {
   int Terminal( String strSignal ) [abstract];
   int Runnable( String strSignal, int nGas ) [abstract];
   int PhaseRunnable( String strPhase ) [abstract];
   int StopCarries( int nStopped ) [abstract];
}

interface IResidentTurnwheelNative [public, witness, reusable] {
   int TerminalCode( int nSignalCode ) [abstract];
   int PhaseRunnableCode( int nPhaseCode ) [abstract];
   int StopCarriesCode( int nStopped ) [abstract];
}

class FormCliResidentTurnwheel<T> [public, resident, bml, observable] : IResidentTurnwheel, IResidentTurnwheelNative {
   section [public] {
      const String AuthorityPath = "form/form-stdlib/bml/form-cli-resident-turnwheel.bml";
      const String NativeCompilerPath = "form/form-stdlib/form-cli-resident-turnwheel-native-bml.fk";
      const String CursorRoute = "scannerless-byte-fold-no-tokenizer";
      const String FrameRule = "id-phase-signal-gas-tokens-no-prompt-or-answer-bytes";
      const String PresenceRule = "nothing-is-not-zero-or-one";
      const String PhasePrefillError = "prefill-error";
      const String JitRule = "every admitted route is a NodeID program image";
      const String HotSwapRule = "new epoch for new rows; pinned old epoch for live rows";
      const String StopRule = "terminal row and carried session agree";

      // The source declares the decision alphabet.  `live` and `undo` are
      // intentionally the two nonterminal codes; every other declared signal
      // is terminal.  That compact shape lowers to a native equality/branch
      // image without turning nothing, 0, or 1 into the same state.
      const String SignalLive = "live";
      const String SignalUndo = "undo";
      const String SignalReturned = "returned";
      const String SignalDone = "done";
      const String SignalNothing = "nothing";
      const String SignalChoice = "choice";
      const String SignalCut = "cut";
      const String SignalTimeout = "timeout";
      const String SignalFailure = "failure";
      const String SignalRefused = "refused";
      const String SignalRelease = "release";

      const int SignalLiveCode = 0;
      const int SignalUndoCode = 1;
      const int SignalReturnedCode = 2;
      const int SignalDoneCode = 3;
      const int SignalNothingCode = 4;
      const int SignalChoiceCode = 5;
      const int SignalCutCode = 6;
      const int SignalTimeoutCode = 7;
      const int SignalFailureCode = 8;
      const int SignalRefusedCode = 9;
      const int SignalReleaseCode = 10;

      const String PhaseProgram = "program";
      const String PhasePrefill = "prefill";
      const String PhaseModel = "model";
      const String PhaseReturned = "returned";

      const int PhaseInactiveCode = 0;
      const int PhaseProgramCode = 1;
      const int PhasePrefillCode = 2;
      const int PhaseModelCode = 3;
      const int PhaseReturnedCode = 0;
      const int PhasePrefillErrorCode = 0;

      const int TerminalFalseCode = 0;
      const int TerminalTrueCode = 1;
      const int StopNotCarriedCode = 0;
      const int StopCarriedCode = 1;

      FormCliResidentTurnwheel() {}

      int Terminal( String strSignal ) [abstract] {}
      int Runnable( String strSignal, int nGas ) [abstract] {}
      int PhaseRunnable( String strPhase ) [abstract] {}
      int StopCarries( int nStopped ) [abstract] {}

      int TerminalCode( int nSignalCode ) [native, cached, jit] {}
      int PhaseRunnableCode( int nPhaseCode ) [native, cached, jit] {}
      int StopCarriesCode( int nStopped ) [native, cached, jit] {}
   }
}

class FormCliResidentTurnwheelSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-resident-turnwheel";
      const String Pattern = "BML-stage scannerless-cursor NodeID-JIT pinned-epoch stop-carried";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
