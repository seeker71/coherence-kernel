// CPU SHA over caller-held bytes: the CPU's own SHA-256 instructions (the compressor form/native/metal/sha256-arm64-jit.fk
// writes) run through the seed's one door for Form-emitted CPU images (jit_cpu_run). A string's whole blocks are compressed
// where the string lies, then its padding: no Metal carrier, no buffer, no copy of the message.
import form-stdlib/bml/sha256-owned.bml;
import form-stdlib/hex.fk;
section [form.bml] {
 class Sha256OwnedBytes {
  def sob-hex(raw,at) = if (at >= len(raw)) then "" else ((String) hex-byte-to-pair(str_byte_at(raw,at)) + sob-hex(raw,(at + 1)));
  // The lane, witnessed in this process: the empty message's digest as FIPS 180-4 states it, run through the door.
  def sob-context() = sob-observed(sob-digest(""));
  def sob-observed(digest) = record_new(0,"kind","sha256-cpu-image-context","pid",host_pid(),"probe",digest);
  def sob-empty-digest() = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
  def sob-context-ready(context) = if (!record?(context)) then 0 else (((String) record_get(context,"kind") == "sha256-cpu-image-context") && (((Comparable) record_get(context,"pid") == host_pid()) && ((String) sob-hex(record_get(context,"probe"),0) == sob-empty-digest())));
  def sob-hash(text) = if (!((String) value_kind(text) == "string")) then sho-refuse(sho-owner(),"bytes-required") else sob-hash-in(sob-context(),text);
  def sob-hash-in(context,text) = if (!((String) value_kind(text) == "string")) then sho-refuse(sho-owner(),"bytes-required") else if (!sob-context-ready(context)) then sho-refuse(sho-owner(),"host-isa-unobserved") else sob-settle(sho-owner(),sob-digest(text));
  def sob-settle(owner,digest) = if (!((Comparable) len(digest) == 32)) then sho-refuse(owner,"digest-refused") else sho-accept(owner,digest);
  // the string's whole blocks compressed where it lies, then the padding of its last 0..63 bytes
  def sob-digest(text) {
   let size = len(text);
   let prefix = (size - (size % 64));
   let state = saj-compress(text,saj-initial-state-bytes(),(prefix / 64));
   if ((Comparable) len(state) == 32) then saj-final-padded(state,saj-padding-string(substring(text,prefix,size),size)) else "";
  }
 }
 0;
}
