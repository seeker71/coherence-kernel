//////////////////////////////////////////////////////////////////////
//
// native-model-glass.bml — authority for the live model glass.
//
// The glass reports runtime state, never inventory. A GGUF on disk is not
// loaded, a tokenizer pass is not a prefill, and a selected fallback is not
// active until its evaluator actually starts. Frames carry model ids and
// counters only; prompt and answer bytes stay outside the framebuffer.
//
// Executable: form-stdlib/native-model-glass.bml
// Proven by: form-stdlib/tests/native-model-glass-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.native.modelglass;

import Form.kernel.*;
import Form.native.models.*;

interface INativeModelGlass [public, witness, reusable] {
   section [public] {
      const String Schema = "native-model-glass-v1";
      const String CarrierSchema = "native-model-carrier-v1";
      const String IngressModel = "base.llama32-3b-metal";
      const String NativeWorldModel = "world.entity-state";
      const String ReasoningFallback = "challenger.qwen38-flash-next-q2-metal";
      const String RouteRule = "known Form grammar -> native; unknown NL-to-Form -> 3B proposal then native; reasoning -> native; Qwen only after explicit native inability";
      const String NativeResponseRule = "native-cognition response route=0/action=0/ack=present answers; route=1/action=4 requests Qwen evidence; every other shape abstains";
      const String LoadedRule = "artifact presence never implies loaded";
      const String PrefillRule = "prefilled means prompt tokens were admitted to this live model state";
      const String ActiveRule = "at most one model is active in a sequential route";
      const String LifecycleRule = "model state is loading, resident, prefill, reasoning, active, idle, or released; cache temperature is never a model lifecycle";
      const String ParallelResidenceRule = "multiple physical model handles may remain loaded and prefilled while at most one dependent route stage is active";
      const String PrivacyRule = "frames contain ids,state,counters,reasons; never prompt or answer bytes";
      const String PhysicalRule = "physical frames require a positive live carrier handle; release requires the same prior handle and a successful close return";
      const String ReplayRule = "route rehearsals never emit FORM-MODEL-CARRIER-V1";

      bool StateValid( int nLoaded, int nPrefilled, int nActive ) [abstract];
      bool FallbackAllowed( String strNativeOutcome ) [abstract];
      String NativeOutcome( int nAction, int nRoute ) [abstract];
      String IngressRoute( String strInputKind, String strTask, int nKnownGrammar ) [abstract];
      int ActiveCount() [abstract];
   }
}

class NativeModelGlass [public, reusable, flow, teach, observable] : INativeModelGlass {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-glass.bml";
      const String EventCategory = "FORM-MODEL-GLASS-V1";
      const String CarrierEventCategory = "FORM-MODEL-CARRIER-V1";
      const String ThreeBRole = "nl-to-form-proposer";
      const String NativeRole = "form-validator-world-evaluator";
      const String QwenRole = "reasoning-fallback";

      bool StateValid( int nLoaded, int nPrefilled, int nActive ) [abstract] {}
      bool FallbackAllowed( String strNativeOutcome ) [abstract] {}
      String NativeOutcome( int nAction, int nRoute ) [abstract] {}
      String IngressRoute( String strInputKind, String strTask, int nKnownGrammar ) [abstract] {}
      int ActiveCount() [abstract] {}
   }
}
