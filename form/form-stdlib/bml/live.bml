// Execute, signal, choose care and re-observe in the same context.
// live-do answers (held observed-value repaired-by). A repair's meets(value,ctx)
// selects it; act(ctx) supplies the next context or nothing when it cannot act.
// The native choice walk retains each finding. stderr carries owned readings;
// the framebuffer carries public operational metadata and correlation.
import form-stdlib/organ-health.bml;
import control/choice-lane-core.fk;
import form-stdlib/meaning-codes.bml;
section [form.bml] {
 class Live {
  def live-repair(name, meets, act) = [name, meets, act];
  def live-stopped(value, ctx) = nothing?(value);
  def live-call(f, ctx) = f(ctx);
  def live-call2(f, a, b) = f(a, b);
  def live-names(xs) = map(repair => repair[0],xs);
  def live-offered(repairs, value, ctx) = filter(repair => live-call2(repair[1],value,ctx),repairs);

  // what a reading can carry of a Form value
  def live-json(v) {
   let kind: String = value_kind(v);
   nothing?(v) ? json-node-null() : kind == "int" ? json-node-int(v)
   : kind == "string" ? json-node-string(v) : json-node-string(v.str());
  }
  // a reading spoken the moment it is taken, on stderr, where whoever runs the flow hears it
  def live-say(row) {
   oh-frame(row);
   let line = "form-organ health " ++ json-emit-precise(row) ++ "\n";
   let wrote = sbt-append("/dev/stderr", line);
   row;
  }
  def live-reading(flow, step, n, value, held, offers, elapsed) {
   let row = oh-reading(
   "live", flow, step, json-node-string("holds"), live-json(value), json-node-int(held ? 1 : 0),
   held ? [] : [oh-need("step", json-node-string(step))],
   offers,
   json-node-object([oh-n("attempt", n)]));
   oh-set(oh-set(row,"surprise",json-node-int(held ? 0 : 1)),"elapsed_ms",json-node-int(elapsed));
  }

  def live-try(run, ctx) = try live-call(run, ctx) catch fail;
  def live-do(flow, step, ctx, run, holds, repairs) {
   let started = host_monotonic_ms();
   let value = live-try(run, ctx);
   let elapsed = host_monotonic_ms() - started;
   let held = live-call2(holds, value, ctx);
   let offered = held ? [] : live-offered(repairs, value, ctx);
   let reading = live-say(live-reading(flow, step, 1, value, held, live-names(offered),elapsed));
   held ? [1, value, ""] : live-care([flow, step, ctx, run, holds, offered, reading],value);
  }
  def live-care(args,value) {
   let result = record_new(0,"value",value);
   let walked = oac-backtrack-walk(live-options(len(args[5])),append(args,[result]),[]);
   live-walked(walked,record_get(result,"value"));
  }
  def live-options(n) = n <= 0 ? [] : cons(live-option, live-options(n - 1));
  def live-walked(w, value) = oac-one?(oac-backtrack-ack(w)) == 1 ? [1, value, node_value(oac-payload(oac-backtrack-ack(w)))] : [0, value, ""];

  // Each option takes the next offered repair: every declined option leaves one finding, so the memory's
  // length is the index of the repair this option offers.
  def live-option(offered) {
   let args = oac-option-args(offered);
   let memory = oac-option-memory(offered);
   let repair = args[5][len(memory)];
   let next = try live-call(repair[2], args[2]) catch fail;
   let applied = live-say(oh-applied(args[6], repair[0], json-node-string(nothing?(next) ? "could not act" : "acted")));
   nothing?(next) ? oac-node(intern_trivial_string(repair[0] ++ ": could not act"))
   : live-again(args, repair, next, len(memory) + 2);
  }
  def live-again(args, repair, ctx, n) {
   let started = host_monotonic_ms();
   let value = live-try(args[3], ctx);
   let elapsed = host_monotonic_ms() - started;
   let held = live-call2(args[4], value, ctx);
   let reading = live-say(oh-set(live-reading(args[0], args[1], n, value, held, [],elapsed),"care_of",oh-get(args[6],"id")));
   held ? { record_set(args[7],"value",value); oac-one(intern_trivial_string(repair[0])); }
   : oac-node(intern_trivial_string(repair[0] ++ ": answered " ++ (nothing?(value) ? "nothing" : value.str())));
  }

  // claims (name bit want run) folded into one number, each a live step over ctx: it holds when it
  // answers its want
  def live-is(value, claim) = nothing?(value) ? nothing?(claim[2]) : nothing?(claim[2]) ? false : ((Value) value == claim[2]);
  def live-claim-run(claim) = live-call(claim[3], claim[4]);
  def live-held-bit(claim) = (Comparable) live-do(claim[5], claim[0], claim, live-claim-run, live-is, [])[0] == 1 ? claim[1] : 0;
  def live-claims(flow, ctx, claims) = nil?(claims) ? 0 : (live-held-bit([claims[0][0], claims[0][1], claims[0][2], claims[0][3], ctx, flow]) + live-claims(flow, ctx, claims[1:]));
 }
}
