// A source-grounded enquiry for the existing indexed edit carrier.
// Model judgments remain observations to assess, not carrier guarantees.
// preludes: form-stdlib/bml/form-cli-review-edits.bml
section [form.bml] {
 class FormCliReviewEnquiry {
  def fcrq-prompt(goal,documents,text,fields) {
   let packet = fcre-packet(text,fields);
   if not(head(packet)) then packet else {
    let body = json-node-object(list(
     json-node-pair("original_enquiry",json-node-string(goal)),
     json-node-pair("source_documents",documents),
     json-node-pair("original_report",parse-json("original-report",text)),
     json-node-pair("review_packet",nth(packet,1))));
    fcra-ok(str_concat("Review every indexed span against the original enquiry and source documents. Preserve accurate text and useful requested action. Distinguish what the evidence establishes from inference, unsupported claims, style issues and missing action. Return only {\"base\":<the supplied base>,\"edits\":[...]}. Include every span in its original order. Each edit has exactly id (integer), status (supported, inference, unsupported, style or action-gap), action (keep, remove or replace), and a nonempty reason. A replacement also has text containing the complete replacement for that span, including any needed trailing space or newline. Other actions have no text field. Keep supported spans when they serve the enquiry; repair unsupported claims and complete the requested action using only the supplied evidence. Form will apply these edits to the original report and preserve all other fields. Its structural checks do not establish the correctness of your judgments.\n",json-emit(body)));
   };
  }
 }
 0;
}
