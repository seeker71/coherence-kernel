  // ── the body's functions, run by the body's own runtime ──────────────
  // A function the body defines is run on the unit that defines it: a child fkwu runs a small
  // door unit (the carrier, the home unit, one call), which the runtime keeps compiled by its text
  // under the checkout's own .hearth/form-tokens/doors. The child's stdin is /dev/null; it reads
  // its arguments as one recipe tree from a ticket named after its own pid, writes its answer
  // ([1, value] or [0, reason]) as one, and what it prints is the call's printed text.
  // Time is a backtrack point, not a fence: the call is one alternative raced against the
  // control's deadline. A child still running when the deadline comes is stopped (host_kill, then
  // KILL) and reaped, and the call answers body-call-timeout; every file a call made is removed on
  // every path.
  // A name's homes are the library units that define it, read off the disk once per process. A run
  // door (a unit named -run) is not a library, nor is a unit whose section ends in a top-level call:
  // importing it runs that call (a stdin door, a compile). A name only such units define answers
  // runs-on-import.
  def ftw-home-roots() = [["form/form-stdlib", "form-stdlib/"], ["control", "control/"], ["cognition", "cognition/"]];
  def ftw-home-skips() = ["tests", ".cache", "seedbank", "node_modules", "target"];
  // [library homes, homes that run on import]
  def ftw-homes-of(name) {
   let homes = record_get(FTW-HELD, "homes");
   let held = ftw-get(homes, name);
   if !nothing?(held) then held else ftw-homes-hold(homes, name, ftw-homes-scan(name));
  }
  def ftw-homes(name) = ftw-homes-of(name)[0];
  def ftw-import-homes(name) = ftw-homes-of(name)[1];
  def ftw-homes-hold(homes, name, found) {
   record_set(homes, name, found);
   found;
  }
  def ftw-homes-scan(name) {
   let found = ftw-name-like?(name) ? append(ftw-homes-with(".bml", ["def " ++ name ++ "("]), ftw-homes-with(".fk", ["def " ++ name ++ "(", "(defn " ++ name ++ " "])) : [];
   [map(f => f[0], filter(f => f[1] == 0, found)), map(f => f[0], filter(f => f[1] == 1, found))];
  }
  def ftw-name-like?(name) = (len(name) > 0) && (str_find(name, " ", 0) < 0) && (str_find(name, "(", 0) < 0) && (str_find(name, "$", 0) < 0);
  def ftw-homes-with(suffix, needles) = foldl((acc, root) => append(acc, ftw-homes-under(root, suffix, needles)), [], ftw-home-roots());
  // [home, 1 when the unit runs on import] per unit under root that defines the name
  def ftw-homes-under(root, suffix, needles) {
   let rows = fs_is_dir(root[0]) == 1 ? (source_inventory(root[0], suffix, ftw-home-skips()) ?? []) : [];
   let defining = filter(r => !ftw-run-door?(r[0]) && ftw-defines?(root[0] ++ "/" ++ r[0], needles), rows);
   map(r => [root[1] ++ r[0], ftw-runs-on-import?(read_file(root[0] ++ "/" ++ r[0]) ?? "") ? 1 : 0], defining);
  }
  def ftw-defines?(path, needles) {
   let text = read_file(path) ?? "";
   any?(n => str_find(text, n, 0) >= 0, needles);
  }
  def ftw-run-door?(rel) = ftw-ends?(rel, "-run.bml") || ftw-ends?(rel, "-run.fk");
  // A section that ends in a top-level call runs it on import: its last statement before the
  // closing brace is a call (a name, then its arguments), and the line before it closes a statement.
  def ftw-runs-on-import?(text) {
   let lines = filter(l => len(l) > 0, map(l => trim(l), split-on(text, byte_to_str(10))));
   let n = len(lines);
   (n >= 3) && (lines[n - 1] == "}") && ftw-call-line?(lines[n - 2]) && (ftw-ends?(lines[n - 3], "}") || ftw-ends?(lines[n - 3], ";"));
  }
  def ftw-call-line?(line) {
   let open = str_find(line, "(", 0);
   (open > 0) && ftw-ends?(line, ");") && ftw-name-head?(substring(line, 0, open)) && !ftw-starts?(line, "def ") && !ftw-starts?(line, "let ");
  }
  def ftw-name-head?(text) = (str_byte_at(text, 0) >= 97) && (str_byte_at(text, 0) <= 122) && all?(i => ftw-name-byte?(str_byte_at(text, i)), range(0, len(text)));
  def ftw-name-byte?(b) = ((b >= 97) && (b <= 122)) || ((b >= 48) && (b <= 57)) || (b == 45) || (b == 95) || (b == 63) || (b == 33);
  // the carriers a door unit imports: the workspace alone for plain values; the verbs when a
  // walker function crosses (form-token-verbs.bml wraps it as a native function there)
  def ftw-lean-carrier() = "form-stdlib/bml/form-token-workspace.bml";
  def ftw-fkwu() = fs_exists(host_cwd() ++ "/fkwu") == 1 ? host_cwd() ++ "/fkwu" : "fkwu";
  // the checkout's own door units: a unit's identity is its path, so each checkout compiles its own
  def ftw-doors-dir() = host_cwd() ++ "/.hearth/form-tokens/doors";
  def ftw-hash(text) = ftw-hash-at(text, 0, len(text), 5381, 7);
  def ftw-hash-at(text, i, n, a, b) = i >= n ? a.str() ++ "-" ++ b.str() : ftw-hash-at(text, i + 1, n, ((a * 33) + str_byte_at(text, i)) % 2147483647, ((b * 131) + str_byte_at(text, i)) % 1000000007);
  def ftw-arg-list(arity) = str-join-with(map(i => "vals[" ++ i.str() ++ "]", range(0, arity)), ", ");
  def ftw-serve-name(carrier) = carrier == ftw-lean-carrier() ? "ftw-serve-at" : "ftv-serve-at";
  // a native has no home to import: its unit is the carrier and the call (ftw-native-call)
  def ftw-unit-text(home, name, arity, carrier, dir) = "import " ++ carrier ++ ";\n" ++ (home == "" ? "" : "import " ++ home ++ ";\n") ++ "section [form.bml] {\n " ++ ftw-serve-name(carrier) ++ "(\"" ++ dir ++ "\", vals => " ++ name ++ "(" ++ ftw-arg-list(arity) ++ "));\n}\n";
  // the units a checkout keeps compiled: the newest ftw-doors-kept() (an image weighs 1 to 23 MB);
  // an older one leaves with its image, its lowering and its symbols when a new one is written
  def ftw-doors-kept() = 8;
  // A unit is evicted by use: one in use is touched (its modification time moves, its bytes stay),
  // so the oldest is the one used longest ago. A unit is written whole to a fresh name and renamed
  // into place, so a child that starts on it never reads half of it.
  def ftw-door-unit(dir, text) {
   let unit = dir ++ "/door-" ++ ftw-hash(text) ++ ".bml";
   let used = (read_file(unit) ?? "") == text ? ftw-door-touch(unit) : ftw-door-write(dir, unit, text);
   unit;
  }
  def ftw-door-touch(unit) = fs_truncate(unit, file_size(unit));
  def ftw-door-write(dir, unit, text) {
   let units = map(n => dir ++ "/" ++ n, filter(n => ftw-starts?(n, "door-") && ftw-ends?(n, ".bml"), fs_list(dir) ?? []));
   let pruned = ftw-doors-prune(units, len(units) - (ftw-doors-kept() - 1));
   let part = unit ++ ".w" ++ host_pid().str();
   let wrote = write_file(part, text);
   fs_rename(part, unit);
  }
  def ftw-doors-prune(units, extra) = (extra <= 0) || nil?(units) ? 0 : ftw-doors-prune-oldest(units, extra, foldl((old, u) => file_mtime(u) < file_mtime(old) ? u : old, units[0], units));
  def ftw-doors-prune-oldest(units, extra, oldest) {
   let gone = map(s => file_size(oldest ++ s) >= 0 ? fs_remove(oldest ++ s) : 0, ["", ".fkb", ".lowfk", ".sym"]);
   ftw-doors-prune(filter(u => u != oldest, units), extra - 1);
  }
  // [1, value, printed] when the body's own run answered; [0, reason, printed] when none of the
  // name's homes did by the deadline (host_monotonic_ms)
  def ftw-body-call(name, vals, carrier, deadline) {
   let homes = ftw-homes(name);
   if !nil?(homes) then ftw-body-call-homes(name, vals, carrier, homes, deadline)
   else if !nil?(ftw-import-homes(name)) then [0, "runs-on-import:" ++ name, ""]
   else [0, "unknown-name:" ++ name, ""];
  }
  // each home is an alternative, offered in order; one whose run does not answer fails, and the
  // next is tried; when none answers, the last reason stands
  def ftw-body-call-homes(name, vals, carrier, homes, deadline) {
   let last = record_new(0, "why", "body-call-unanswered:" ++ name, "printed", "");
   let alts = map(home => args => ftw-body-alt(name, vals, carrier, home, deadline, last), homes);
   let picked = try oac-choice(alts, 0) catch nothing();
   nothing?(picked) ? [0, record_get(last, "why"), record_get(last, "printed")] : picked;
  }
  // A native that waits on the network (http_get, tls_request, sock_request) runs the same way, in a
  // child on a unit of just the call: [1, value, printed] or [0, reason, printed]. A reason that
  // names the deadline is door-timeout:<name>.
  def ftw-native-call(name, vals, deadline) = ftw-door-reason(name, ftw-body-call-homes(name, vals, ftw-lean-carrier(), [""], deadline));
  def ftw-door-reason(name, answer) = answer[0] == 1 ? answer : [0, ftw-starts?(answer[1], "body-call-timeout") ? "door-timeout:" ++ name : answer[1], answer[2]];
  def ftw-body-alt(name, vals, carrier, home, deadline, last) {
   let answer = host_monotonic_ms() >= deadline ? [0, "body-call-timeout", ""] : ftw-body-run(name, vals, carrier, home, deadline);
   answer[0] == 1 ? answer : ftw-body-failed(last, answer[1] ++ ":" ++ name, answer[2]);
  }
  def ftw-body-failed(last, why, printed) {
   record_set(last, "why", why);
   record_set(last, "printed", printed);
   fail;
  }
  def ftw-body-run(name, vals, carrier, home, deadline) {
   let dir = ftw-doors-dir();
   let made = ftw-mkdirs(dir);
   let unit = ftw-door-unit(dir, ftw-unit-text(home, name, len(vals), carrier, dir));
   let said = dir ++ "/said-" ++ host_pid().str() ++ "-" ++ ftw-next-seq().str() ++ ".txt";
   let pid = host_spawn_at([ftw-fkwu(), unit], ["/dev/null", said, "/dev/null"]);
   let answer = nothing?(pid) || (pid <= 0) ? [0, "body-call-unborn", ""] : ftw-body-child(dir, pid, vals, said, deadline);
   let gone = file_size(said) >= 0 ? fs_remove(said) : 0;
   answer;
  }
  def ftw-ticket(dir, pid) = dir ++ "/call-" ++ pid.str();
  def ftw-body-child(dir, pid, vals, said, deadline) {
   let stem = ftw-ticket(dir, pid);
   let held = record_set(FTW-HELD, "child", pid);
   let sent = write_form_binary(stem ++ ".in.part", ftw-encode(vals));
   let moved = fs_rename(stem ++ ".in.part", stem ++ ".in.fkb");
   let ended = ftw-wait-child(pid, deadline);
   let status = ended == 1 ? host_wait(pid) : ftw-stop-child(pid);
   let answer = ended == 1 ? ftw-said(stem ++ ".out.fkb") : [0, "body-call-timeout"];
   let printed = ended == 1 ? ftw-all-but-last-line(read_file(said) ?? "") : (read_file(said) ?? "");
   let gone = map(s => file_size(stem ++ s) >= 0 ? fs_remove(stem ++ s) : 0, [".in.part", ".in.fkb", ".out.part", ".out.fkb"]);
   [answer[0], answer[1], printed];
  }
  // the pid the last body call ran in
  def ftw-last-child() = ftw-get(FTW-HELD, "child") ?? 0;
  // 1 once the child is gone (an ended child that is not yet reaped reads gone), 0 at the deadline
  def ftw-wait-child(pid, deadline) = host_alive(pid) != 1 ? 1 : host_monotonic_ms() >= deadline ? 0 : ftw-wait-child-again(pid, deadline);
  def ftw-wait-child-again(pid, deadline) {
   host_sleep_ms(ftw-poll-ms(deadline));
   ftw-wait-child(pid, deadline);
  }
  def ftw-poll-ms(deadline) = (deadline - host_monotonic_ms()) < 20 ? 2 : 10;
  // stopped and reaped: TERM, two seconds, then KILL
  def ftw-stop-child(pid) {
   let asked = host_kill(pid);
   let ended = ftw-wait-child(pid, host_monotonic_ms() + 2000);
   let forced = ended == 1 ? 0 : host_wait(host_spawn_quiet(["/bin/kill", "-KILL", pid.str()]));
   host_wait(pid);
  }
  // A process run to its end by the deadline (host_capture and host-exec in a control): it reads
  // nothing from this process's stdin (/dev/null, or the input it was given, from a file) and speaks
  // into a file read back, so neither of the lane's channels reaches it. [1, its stdout] when it
  // ended, [0, ""] when the deadline came first (it is stopped and reaped, ftw-stop-child: only the
  // process itself, so a shell pipeline's other members finish by themselves), [-1, ""] when it
  // could not be run. A binary that is absent ends with nothing said, as a capture reads it.
  def ftw-run-process(argv, input, deadline) {
   let dir = ftw-doors-dir();
   let made = ftw-mkdirs(dir);
   let stem = dir ++ "/run-" ++ host_pid().str() ++ "-" ++ ftw-next-seq().str();
   let fed = len(input) > 0 ? write_file(stem ++ ".in", input) : 0;
   let pid = host_spawn_at(argv, [len(input) > 0 ? stem ++ ".in" : "/dev/null", stem ++ ".out", ""]);
   let answer = pid > 0 ? ftw-run-ended(pid, stem, deadline) : pid == -4 ? [1, ""] : [-1, ""];
   let gone = map(s => file_size(stem ++ s) >= 0 ? fs_remove(stem ++ s) : 0, [".in", ".out"]);
   answer;
  }
  def ftw-run-ended(pid, stem, deadline) {
   let ended = ftw-wait-child(pid, deadline);
   let status = ended == 1 ? host_wait(pid) : ftw-stop-child(pid);
   [ended, read_file(stem ++ ".out") ?? ""];
  }
  def ftw-said(out) {
   let back = file_size(out) > 0 ? (try ftw-decode(read_form_binary(out)) catch nothing()) : nothing();
   if nothing?(back) then [0, "body-call-unanswered"]
   else if value_kind(back) != "list" then [0, "body-call-unanswered"]
   else if back[0] == 1 then [1, back[1]]
   else [0, back[1]];
  }
  // the child prints its section's value last; what it printed before that is the call's
  def ftw-all-but-last-line(text) {
   let body = ftw-ends?(text, byte_to_str(10)) ? substring(text, 0, len(text) - 1) : text;
   let cut = ftw-last-newline(body, 0, -1);
   cut < 0 ? "" : substring(body, 0, cut);
  }
  def ftw-last-newline(text, from, last) {
   let at = str_find(text, byte_to_str(10), from);
   at < 0 ? last : ftw-last-newline(text, at + 1, at);
  }
  // The child's side: the ticket named after its own pid (the parent writes it just after the
  // birth), the arguments decoded (and wrapped), the call, and the answer encoded.
  def ftw-ticket-patience-ms() = 10000;
  def ftw-serve-at(dir, f) = ftw-serve-with(dir, f, vals => vals);
  def ftw-serve-with(dir, f, wrap) {
   let stem = ftw-ticket(dir, host_pid());
   let came = ftw-wait-file(stem ++ ".in.fkb", host_monotonic_ms() + ftw-ticket-patience-ms());
   let held = came == 1 ? (try [f(wrap(ftw-decode(read_form_binary(stem ++ ".in.fkb"))))] catch nothing()) : nothing();
   let answer = came != 1 ? [0, "body-call-unasked"] : nothing?(held) ? [0, "body-call-stopped"] : [1, held[0]];
   let wrote = write_form_binary(stem ++ ".out.part", ftw-encode(answer));
   let moved = fs_rename(stem ++ ".out.part", stem ++ ".out.fkb");
   0;
  }
  def ftw-wait-file(path, deadline) = file_size(path) > 0 ? 1 : host_monotonic_ms() >= deadline ? 0 : ftw-wait-file-again(path, deadline);
  def ftw-wait-file-again(path, deadline) {
   host_sleep_ms(2);
   ftw-wait-file(path, deadline);
  }
 }
 0;
}
