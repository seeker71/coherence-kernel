   ["read_file", 1, v => read_file(v[0])], ["host_dir_list", 1, v => host_dir_list(v[0])], ["fs_list", 1, v => fs_list(v[0])],
   ["host_path_is_dir", 1, v => host_path_is_dir(v[0])], ["fs_is_dir", 1, v => fs_is_dir(v[0])], ["metal_buf_alloc", 1, v => metal_buf_alloc(v[0])],
   ["metal_buf_free", 1, v => metal_buf_free(v[0])], ["metal_fence_wait", 1, v => metal_fence_wait(v[0])], ["metal_deadline", 1, v => metal_deadline(v[0])],
   ["sense_mic_name", 1, v => sense_mic_name(v[0])], ["sense_cam_name", 1, v => sense_cam_name(v[0])], ["sense_mic_health", 1, v => sense_mic_health(v[0])],
   ["sense_cam_health", 1, v => sense_cam_health(v[0])], ["sense_cam_grab", 1, v => sense_cam_grab(v[0])], ["sense_publish", 1, v => sense_publish(v[0])],
   ["mesh_serve", 1, v => mesh_serve(v[0])], ["mesh_announce", 1, v => mesh_announce(v[0])], ["mesh_discover", 1, v => mesh_discover(v[0])],
   ["mesh_registry", 1, v => mesh_registry(v[0])], ["sense_mic_capture", 1, v => sense_mic_capture(v[0])], ["sense_cam_luma", 1, v => sense_cam_luma(v[0])],
   ["sense_audio_loopback", 1, v => sense_audio_loopback(v[0])], ["form_error", 1, v => form_error(v[0])], ["file_open", 1, v => file_open(v[0])],
   ["file_close", 1, v => file_close(v[0])], ["socket_listen", 1, v => socket_listen(v[0])], ["socket_port", 1, v => socket_port(v[0])],
   ["socket_accept", 1, v => socket_accept(v[0])], ["socket_close", 1, v => socket_close(v[0])], ["host_file_mtime", 1, v => host_file_mtime(v[0])], ["file_mtime", 1, v => file_mtime(v[0])],
   ["record?", 1, v => record?(v[0])], ["record_keys", 1, v => record_keys(v[0])], ["record_blueprint", 1, v => record_blueprint(v[0])],
   ["bnot_u32", 1, v => bnot_u32(v[0])], ["float_value", 1, v => float_value(v[0])], ["make_float32", 1, v => make_float32(v[0])],
   ["make_float64", 1, v => make_float64(v[0])], ["recipe_to_bytes", 1, v => recipe_to_bytes(v[0])], ["bytes_to_recipe", 1, v => bytes_to_recipe(v[0])],
   ["read_form_binary", 1, v => read_form_binary(v[0])], ["sense_speaker_name", 1, v => sense_speaker_name(v[0])], ["sense_speaker_health", 1, v => sense_speaker_health(v[0])],
   ["sense_speaker_play", 1, v => sense_speaker_play(v[0])], ["sense_speaker_stream_start_at", 1, v => sense_speaker_stream_start_at(v[0])],
   ["sense_speaker_stream_write", 1, v => sense_speaker_stream_write(v[0])], ["host_alive", 1, v => host_alive(v[0])], ["fs_mkfifo", 1, v => fs_mkfifo(v[0])],
   ["kernel_roster_adopt", 1, v => kernel_roster_adopt(v[0])], ["kernel_roster_forget", 1, v => kernel_roster_forget(v[0])],
   ["kernel_page_bury", 1, v => kernel_page_bury(v[0])], ["host_process", 1, v => host_process(v[0])], ["kernel_page_ended", 1, v => kernel_page_ended(v[0])],
   ["read_file_bytes", 1, v => read_file_bytes(v[0])], ["str_len", 1, v => str_len(v[0])], ["byte_to_str", 1, v => byte_to_str(v[0])]];
  def ftw-doors-2() = [
   ["str_eq", 2, v => str_eq(v[0], v[1])], ["str_byte_at", 2, v => str_byte_at(v[0], v[1])], ["intern_node", 2, v => intern_node(v[0], v[1])],
   ["value_eq", 2, v => value_eq(v[0], v[1])], ["round_ndigits", 2, v => round_ndigits(v[0], v[1])], ["math_pow", 2, v => math_pow(v[0], v[1])],
   ["float_leaf", 2, v => float_leaf(v[0], v[1])], ["host_path_rename", 2, v => host_path_rename(v[0], v[1])], ["fs_rename", 2, v => fs_rename(v[0], v[1])],
   ["host_file_append_bytes", 2, v => host_file_append_bytes(v[0], v[1])], ["file_append_bytes", 2, v => file_append_bytes(v[0], v[1])],
   ["shm_offer", 2, v => shm_offer(v[0], v[1])], ["shm_write", 2, v => shm_write(v[0], v[1])], ["fs_truncate", 2, v => fs_truncate(v[0], v[1])],
   ["cell_value", 2, v => cell_value(v[0], v[1])], ["kernel_page_hot", 2, v => kernel_page_hot(v[0], v[1])], ["kernel_page_box", 2, v => kernel_page_box(v[0], v[1])],
   ["node_gift_write", 2, v => node_gift_write(v[0], v[1])], ["kernel_ast", 2, v => kernel_ast(v[0], v[1])], ["host_file_write_text", 2, v => host_file_write_text(v[0], v[1])],
   ["write_file", 2, v => write_file(v[0], v[1])], ["write_file_text", 2, v => write_file_text(v[0], v[1])], ["cuda_matvec_f32", 2, v => cuda_matvec_f32(v[0], v[1])],
   ["sense_mic_stream_read", 2, v => sense_mic_stream_read(v[0], v[1])], ["sense_wav_loopback", 2, v => sense_wav_loopback(v[0], v[1])],
   ["file_read", 2, v => file_read(v[0], v[1])], ["host-exec", 2, v => host-exec(v[0], v[1])], ["socket_connect", 2, v => socket_connect(v[0], v[1])],
   ["socket_send", 2, v => socket_send(v[0], v[1])], ["socket_recv", 2, v => socket_recv(v[0], v[1])], ["record_get", 2, v => record_get(v[0], v[1])], ["_get", 2, v => _get(v[0], v[1])],
   ["record_has", 2, v => record_has(v[0], v[1])], ["method_has", 2, v => method_has(v[0], v[1])], ["band", 2, v => band(v[0], v[1])], ["bor", 2, v => bor(v[0], v[1])],
   ["bxor", 2, v => bxor(v[0], v[1])], ["shl_u32", 2, v => shl_u32(v[0], v[1])], ["shr_u32", 2, v => shr_u32(v[0], v[1])], ["rotr_u32", 2, v => rotr_u32(v[0], v[1])],
   ["add_u32", 2, v => add_u32(v[0], v[1])], ["write_form_binary", 2, v => write_form_binary(v[0], v[1])], ["sense_speaker_play_at", 2, v => sense_speaker_play_at(v[0], v[1])],
   ["host_spawn_at", 2, v => host_spawn_at(v[0], v[1])], ["write_file_bytes", 2, v => write_file_bytes(v[0], v[1])], ["jit_leaf_inram", 2, v => jit_leaf_inram(v[0], v[1])],
   ["metal_pipeline", 2, v => metal_pipeline(v[0], v[1])]];
  def ftw-doors-3() = [
   ["fb_record", 3, v => fb_record(v[0], v[1], v[2])], ["host_file_read_slice", 3, v => host_file_read_slice(v[0], v[1], v[2])],
   ["read_file_slice", 3, v => read_file_slice(v[0], v[1], v[2])], ["cell_field", 3, v => cell_field(v[0], v[1], v[2])],
   ["host_source_inventory", 3, v => host_source_inventory(v[0], v[1], v[2])], ["source_inventory", 3, v => source_inventory(v[0], v[1], v[2])],
   ["metal_matvec_f32", 3, v => metal_matvec_f32(v[0], v[1], v[2])], ["metal_buf_from_file", 3, v => metal_buf_from_file(v[0], v[1], v[2])],
   ["metal_buf_write", 3, v => metal_buf_write(v[0], v[1], v[2])], ["metal_enqueue", 3, v => metal_enqueue(v[0], v[1], v[2])],
   ["metal_buf_read", 3, v => metal_buf_read(v[0], v[1], v[2])], ["jit_arm64_u32_leaf", 3, v => jit_arm64_u32_leaf(v[0], v[1], v[2])],
   ["http_get", 3, v => http_get(v[0], v[1], v[2])], ["sock_request", 3, v => sock_request(v[0], v[1], v[2])], ["tls_request", 3, v => tls_request(v[0], v[1], v[2])],
   ["scan_run", 3, v => scan_run(v[0], v[1], v[2])], ["record_set", 3, v => record_set(v[0], v[1], v[2])],
   ["make_nodeid", 4, v => make_nodeid(v[0], v[1], v[2], v[3])]];

  // ── the body's functions, run by the body's own runtime ──────────────
  // A function the body defines is run on the unit that defines it: a child fkwu compiles a small
  // door unit (the carrier, the home unit, one call), which the runtime keeps compiled by its
  // text, reads its arguments as one recipe tree and writes its answer as one. A name's homes are
  // every library unit that defines it, read off the disk once per process; a run door (a unit
  // whose name ends in -run) is not a library, since importing it would run it.
  def ftw-home-roots() = [["form/form-stdlib", "form-stdlib/"], ["control", "control/"], ["cognition", "cognition/"]];
  def ftw-home-skips() = ["tests", ".cache", "seedbank", "node_modules", "target"];
  def ftw-homes(name) {
   let homes = record_get(FTW-HELD, "homes");
   let held = ftw-get(homes, name);
   if !nothing?(held) then held else ftw-homes-hold(homes, name, ftw-homes-scan(name));
  }
  def ftw-homes-hold(homes, name, found) {
   record_set(homes, name, found);
   found;
  }
  def ftw-homes-scan(name) = ftw-name-like?(name) ? append(ftw-homes-with(".bml", ["def " ++ name ++ "("]), ftw-homes-with(".fk", ["def " ++ name ++ "(", "(defn " ++ name ++ " "])) : [];
  def ftw-name-like?(name) = (len(name) > 0) && (str_find(name, " ", 0) < 0) && (str_find(name, "(", 0) < 0) && (str_find(name, "$", 0) < 0);
  def ftw-homes-with(suffix, needles) = foldl((acc, root) => append(acc, ftw-homes-under(root, suffix, needles)), [], ftw-home-roots());
  def ftw-homes-under(root, suffix, needles) {
   let rows = fs_is_dir(root[0]) == 1 ? (source_inventory(root[0], suffix, ftw-home-skips()) ?? []) : [];
   map(r => root[1] ++ r[0], filter(r => ftw-library?(r[0]) && ftw-defines?(root[0] ++ "/" ++ r[0], needles), rows));
  }
  def ftw-defines?(path, needles) {
   let text = read_file(path) ?? "";
   any?(n => str_find(text, n, 0) >= 0, needles);
  }
  def ftw-library?(rel) = !(ftw-ends?(rel, "-run.bml") || ftw-ends?(rel, "-run.fk"));
  // the carriers a door unit imports: the workspace alone for plain values; the verbs when a
  // walker function crosses (form-token-verbs.bml wraps it as a native function there)
  def ftw-lean-carrier() = "form-stdlib/bml/form-token-workspace.bml";
  def ftw-fkwu() = fs_exists(host_cwd() ++ "/fkwu") == 1 ? host_cwd() ++ "/fkwu" : "fkwu";
  def ftw-doors-dir() = temp_dir() ++ "/form-token-doors";
  def ftw-hash(text) = ftw-hash-at(text, 0, len(text), 5381, 7);
  def ftw-hash-at(text, i, n, a, b) = i >= n ? a.str() ++ "-" ++ b.str() : ftw-hash-at(text, i + 1, n, ((a * 33) + str_byte_at(text, i)) % 2147483647, ((b * 131) + str_byte_at(text, i)) % 1000000007);
  def ftw-arg-list(arity) = str-join-with(map(i => "vals[" ++ i.str() ++ "]", range(0, arity)), ", ");
  def ftw-serve-name(carrier) = carrier == ftw-lean-carrier() ? "ftw-serve" : "ftv-serve";
  def ftw-unit-text(home, name, arity, carrier) = "import " ++ carrier ++ ";\nimport " ++ home ++ ";\nsection [form.bml] {\n " ++ ftw-serve-name(carrier) ++ "(vals => " ++ name ++ "(" ++ ftw-arg-list(arity) ++ "));\n}\n";
  // [1, value] when the body's own run answered, [0, reason] when none of the name's homes did
  def ftw-body-call(name, vals, carrier) {
   let homes = ftw-homes(name);
   if nil?(homes) then [0, "unknown-name:" ++ name] else ftw-body-call-homes(name, vals, carrier, homes);
  }
  // each home is an alternative, offered in order; one whose run does not answer fails, and the
  // next is tried; when none answers, the last reason stands
  def ftw-body-call-homes(name, vals, carrier, homes) {
   let last = record_new(0, "why", "body-call-unanswered:" ++ name);
   let alts = map(home => args => ftw-body-alt(name, vals, carrier, home, last), homes);
   let picked = try oac-choice(alts, 0) catch nothing();
   nothing?(picked) ? [0, record_get(last, "why")] : picked;
  }
  def ftw-body-alt(name, vals, carrier, home, last) {
   let answer = ftw-body-run(name, vals, carrier, home);
   answer[0] == 1 ? answer : ftw-body-failed(last, answer[1] ++ ":" ++ name);
  }
  def ftw-body-failed(last, why) {
   record_set(last, "why", why);
   fail;
  }
  def ftw-body-run(name, vals, carrier, home) {
   let dir = ftw-doors-dir();
   let made = fs_is_dir(dir) == 1 ? 0 : fs_mkdir(dir);
   let text = ftw-unit-text(home, name, len(vals), carrier);
   let unit = dir ++ "/door-" ++ ftw-hash(text) ++ ".bml";
   let wrote = (read_file(unit) ?? "") == text ? 0 : write_file(unit, text);
   let stem = dir ++ "/call-" ++ host_pid().str() ++ "-" ++ ftw-next-seq().str();
   let sent = write_form_binary(stem ++ ".in.fkb", ftw-encode(vals));
   let said = host-exec("'" ++ ftw-fkwu() ++ "' '" ++ unit ++ "' 2>/dev/null", stem ++ ".in.fkb\n" ++ stem ++ ".out.fkb\n") ?? "";
   let answer = ftw-said(said, stem ++ ".out.fkb");
   let gone = [fs_remove(stem ++ ".in.fkb"), file_size(stem ++ ".out.fkb") >= 0 ? fs_remove(stem ++ ".out.fkb") : 0];
   answer;
  }
  def ftw-said(said, out) {
   if str_find(said, "ftw-served ok", 0) >= 0 then [1, ftw-decode(read_form_binary(out))]
   else if str_find(said, "ftw-served stopped", 0) >= 0 then [0, "body-call-stopped"]
   else [0, "body-call-unanswered"];
  }
  // the child's side: the two transfer paths on stdin, the arguments decoded (and wrapped), the
  // call, the answer encoded, and the last line saying which
  def ftw-serve(f) = ftw-serve-with(f, vals => vals);
  def ftw-serve-with(f, wrap) {
   let argsPath = trim(read_line() ?? "");
   let outPath = trim(read_line() ?? "");
   let vals = wrap(ftw-decode(read_form_binary(argsPath)));
   let held = try [f(vals)] catch nothing();
   if nothing?(held) then print_str("ftw-served stopped") else ftw-served(outPath, held[0]);
  }
  def ftw-served(outPath, value) {
   write_form_binary(outPath, ftw-encode(value));
   print_str("ftw-served ok");
  }
 }
 0;
}
