   if !nothing?(held) then held else ftw-doors-hold(append(ftw-doors-0(), append(ftw-doors-1(), append(ftw-doors-2(), ftw-doors-3()))));
  }
  def ftw-doors-hold(rows) {
   let table = record_new(0);
   let filled = map(r => record_set(table, r[0], r), rows);
   record_set(FTW-HELD, "doors", table);
   table;
  }
  def ftw-door?(name) = record_has(ftw-doors(), name);
  def ftw-door-arity(name) = record_get(ftw-doors(), name)[1];
  def ftw-door-call(name, vals) {
   let row = record_get(ftw-doors(), name);
   let f = row[2];
   f(vals);
  }
  def ftw-door-names() = record_keys(ftw-doors());
