// form-token-workspace.bml — the living workspace the in-stream verbs build in.
//
// Every control a voice writes (form-token-verbs.bml) reads and writes one workspace. It has four
// scopes, read through one chain, nearest first:
//   local    this reply
//   request  this request: every reply that answers it
//   lineage  the previous and next requests of the same conversation or task lineage: what they
//            wrote to their request scopes, and what was written to the lineage itself
//   global   the body's whole substrate: the named cells written to it, every node in the host
//            field by its address, the body's doors (every native the runtime carries, ftw-doors)
//            and every function the body defines (run by the body's own runtime on the unit that
//            defines it, ftw-body-call)
// Whatever a control makes (a born recipe, a made node, an eval's value, a def or a let) is kept
// as a named cell through form-stdlib/persistence.fk in its scope's domain: its name, the domain,
// a provenance blueprint (kind, request, reply, control ordinal, the address it was spoken as) and
// the value itself as a recipe tree (ftw-encode). The same value is the same tree by composition
// identity, so a cell read back re-collapses to the same NodeIDs. The local scope lives with its
// reply, in memory; a lineage's request and lineage scopes share one store file, the global scope
// has its own:
//   <root>/lineage-<lineage>.fkb   form-token/request/<request>, form-token/lineage/<lineage>
//   <root>/global.fkb              form-token/global
// A store is held newest first with an index by name and by spoken address, read again only when
// its file changed, and written whole through a fresh file renamed over it, by one process at a
// time (the store's .lock directory, ftw-lock-take: every lane writes the global store). A workspace with no
// root keeps every store in memory (a band, a trace replay); its global scope is then the
// substrate and what it wrote itself.
//
// Addresses. A composite's address (@p.l.t.i) is its cell in the host field, which every kernel on
// the host shares while the field lives, so node_at reaches it from any process; a cell also keeps
// the address its value was spoken as, so an address a voice copied from an observation still
// reaches the value after the field moved.
//
// Reuse. Each control is numbered (ftw-begin); a lookup that lands on what an earlier control of
// this request made, or on what an earlier request made, is marked (ftw-touched) and the crossing
// ledger keeps the mark per crossing (form-token-grammar.bml).
import form-stdlib/core.fk;
import form-stdlib/line-grammar.fk;
import form-stdlib/persistence.fk;
import form-stdlib/form-recipe-exec-token.fk;
import form-stdlib/bml/string-join.bml;
import control/offer-ack-core.fk;
section [form.bml] {
 let FTW-ROOT-CATEGORY = make_nodeid(31, 2, 0, 224);
 let FTW-HELD = record_new(0, "seq", 0, "cats", record_new(0), "homes", record_new(0));
 class FormTokenWorkspace {
  def ftw-scopes() = ["local", "request", "lineage", "global"];
  def ftw-scope?(s) = any?(x => x == s, ftw-scopes());
  // a name a control gives lands here unless its control names a scope
  def ftw-default-scope() = "request";
  def ftw-starts?(s, p) = len(s) >= len(p) ? substring(s, 0, len(p)) == p : 0;
  def ftw-ends?(s, t) = len(s) >= len(t) ? substring(s, len(s) - len(t), len(s)) == t : 0;
  def ftw-distinct(xs, out) = nil?(xs) ? reverse(out) : any?(x => x == xs[0], out) ? ftw-distinct(xs[1:], out) : ftw-distinct(xs[1:], cons(xs[0], out));
  def ftw-coord(node) = frex-node-coordinate(node);
  // a key a record does not hold reads nothing (fkwu's record_get answers 0 for it)
  def ftw-get(r, key) = record_has(r, key) ? record_get(r, key) : nothing();

  // ── identities ───────────────────────────────────────────────────────
  def ftw-next-seq() {
   let n = record_get(FTW-HELD, "seq") + 1;
   record_set(FTW-HELD, "seq", n);
   n;
  }
  def ftw-fresh-id(prefix) = prefix ++ now_unix_ms().str() ++ "-" ++ host_pid().str() ++ "-" ++ ftw-next-seq().str();
  // an id names a file: a byte outside a-z A-Z 0-9 - _ . reads as -
  def ftw-id-byte(b) = ((b >= 97) && (b <= 122)) || ((b >= 65) && (b <= 90)) || ((b >= 48) && (b <= 57)) || (b == 45) || (b == 95) || (b == 46) ? b : 45;
  def ftw-safe(id) = str-join(map(i => byte_to_str(ftw-id-byte(str_byte_at(id, i))), range(0, len(id))));
  def ftw-make(root, lineage, request) = record_new(0, "root", root, "lineage", lineage, "request", request, "reply", ftw-fresh-id("rp-"), "stores", record_new(0), "checked", record_new(0), "missed", record_new(0), "ordinal", 0, "touched", "", "decoded", record_new(0));
  // A workspace under root (a directory; "" keeps it in memory). The caller passes the request's
  // lineage id; a request with none starts its own lineage, keyed by its own id.
  def ftw-open(root, lineage, request) {
   let rq = len(request) > 0 ? ftw-safe(request) : ftw-fresh-id("rq-");
   ftw-make(root, len(lineage) > 0 ? ftw-safe(lineage) : rq, rq);
  }
  def ftw-ephemeral() = ftw-open("", "", "");
  // the lanes' workspace, under the working directory
  def ftw-hearth-root() = ".hearth/form-tokens/workspace";
  def ftw-root(ws) = record_get(ws, "root");
  def ftw-lineage(ws) = record_get(ws, "lineage");
  def ftw-request(ws) = record_get(ws, "request");
  def ftw-reply(ws) = record_get(ws, "reply");
  def ftw-ordinal(ws) = record_get(ws, "ordinal");
  def ftw-persistent?(ws) = len(ftw-root(ws)) > 0;
  // the next reply to the same request: its local scope starts empty
  def ftw-next-reply(ws) {
   record_set(ws, "reply", ftw-fresh-id("rp-"));
   record_set(ws, "ordinal", 0);
   record_set(record_get(ws, "stores"), "local", nothing());
   ws;
  }

  // ── domains and stores ───────────────────────────────────────────────
  def ftw-domain(ws, scope) {
   if scope == "global" then "form-token/global"
   else if scope == "lineage" then "form-token/lineage/" ++ ftw-lineage(ws)
   else if scope == "request" then "form-token/request/" ++ ftw-request(ws)
   else "form-token/local/" ++ ftw-request(ws) ++ "/" ++ ftw-reply(ws);
  }
  def ftw-store-key(ws, scope) = scope == "local" ? "local" : scope == "global" ? "global" : "lineage-" ++ ftw-lineage(ws);
  def ftw-in-memory?(ws, key) = !ftw-persistent?(ws) || (key == "local");
  def ftw-store-path(ws, key) = ftw-root(ws) ++ "/" ++ key ++ ".fkb";
  // a file read once per change: its size and mtime stamp the cells held from it
  def ftw-stamp(path) {
   let size = file_size(path);
   size < 1 ? "" : size.str() ++ ":" ++ value_str(file_mtime(path));
  }
  // A store as held: [stamp, cells newest first, index]. The index lists a store's cells newest
  // first under n:<name> and under a:<the address the value was spoken as>, so a lookup reads only
  // the cells of its own name.
  def ftw-held-empty() = ["", [], record_new(0)];
  def ftw-held(ws, key) = ftw-in-memory?(ws, key) ? (ftw-get(record_get(ws, "stores"), key) ?? ftw-hold-store(ws, key, ftw-held-empty())) : ftw-file-held(ws, key, ftw-store-path(ws, key));
  def ftw-cells(ws, key) = ftw-held(ws, key)[1];
  def ftw-index(ws, key) = ftw-held(ws, key)[2];
  def ftw-indexed(ws, key, entry) = ftw-get(ftw-index(ws, key), entry) ?? [];
  // A file is asked for its stamp at most once per ftw-check-ms: a lookup inside one control reads
  // the store it already holds, and what another process wrote is read by the next control.
  def ftw-check-ms() = 250;
  def ftw-file-held(ws, key, path) {
   let held = ftw-get(record_get(ws, "stores"), key);
   let at = ftw-get(record_get(ws, "checked"), key);
   if !nothing?(held) && !nothing?(at) && ((host_monotonic_ms() - at) < ftw-check-ms()) then held
   else ftw-file-read(ws, key, path, held, ftw-stamp(path));
  }
  def ftw-file-read(ws, key, path, held, stamp) {
   let checked = record_set(record_get(ws, "checked"), key, host_monotonic_ms());
   if len(stamp) == 0 then ftw-hold-store(ws, key, ftw-held-empty())
   else if !nothing?(held) && (held[0] == stamp) then held
   else ftw-hold-store(ws, key, ftw-held-of(stamp, reverse(map(m => channel-msg-payload(m), channel-read(path)))));
  }
  def ftw-hold-store(ws, key, held) {
   record_set(record_get(ws, "stores"), key, held);
   held;
  }
  def ftw-held-of(stamp, cells) {
   let index = record_new(0);
   let filled = foldl((acc, c) => ftw-index-add(index, c), 0, reverse(cells));
   [stamp, cells, index];
  }
  def ftw-index-add(index, c) {
   ftw-index-put(index, "n:" ++ cell-name(c), c);
   ftw-index-put(index, "a:" ++ ftw-cell-spoken(c), c);
   0;
  }
  def ftw-index-put(index, entry, c) = record_set(index, entry, cons(c, ftw-get(index, entry) ?? []));
  def ftw-held-add(held, stamp, cell) {
   let added = ftw-index-add(held[2], cell);
   [stamp, cons(cell, held[1]), held[2]];
  }
  def ftw-join-path(made, part) = made == "" ? (part == "" ? "/" : part) : made == "/" ? "/" ++ part : made ++ "/" ++ part;
  def ftw-mkdir-step(made, part) {
   let next = ftw-join-path(made, part);
   if (len(part) > 0) && (fs_is_dir(next) != 1) then fs_mkdir(next) else 0;
   next;
  }
  // every directory of path, one level at a time
  def ftw-mkdirs(path) = foldl((made, part) => ftw-mkdir-step(made, part), "", split-on(path, "/"));
  def ftw-store-write(ws, key, cell) {
   record_set(ws, "missed", record_new(0));
   if ftw-in-memory?(ws, key) then ftw-hold-store(ws, key, ftw-held-add(ftw-held(ws, key), "", cell)) else ftw-file-write(ws, key, cell);
   cell;
  }
  // The store is read fresh (a cell another process wrote meanwhile is kept), the cell added, and
  // the whole store written to a fresh file renamed over the old one; what was written is held, so
  // no write reads the file back. One process at a time does that for a store: it holds
  // <store>.lock (a directory only one maker makes, ftw-lock-take) from the read to the rename, and
  // a stop releases it too (defer).
  def ftw-file-write(ws, key, cell) {
   let path = ftw-store-path(ws, key);
   let made = ftw-mkdirs(ftw-root(ws));
   let lock = path ++ ".lock";
   let taken = ftw-lock-take(lock, host_monotonic_ms() + ftw-lock-patience-ms(), 0);
   defer ftw-lock-release(lock);
   let fresh = ftw-file-read(ws, key, path, ftw-get(record_get(ws, "stores"), key), ftw-stamp(path));
   let held = ftw-held-add(fresh, "", cell);
   let part = path ++ ".w" ++ host_pid().str();
   let wrote = write_form_binary(part, intern_node(CHANNEL-V0, reverse(map(c => channel-message(c), held[1]))));
   let moved = fs_rename(part, path);
   let checked = record_set(record_get(ws, "checked"), key, host_monotonic_ms());
   ftw-hold-store(ws, key, [ftw-stamp(path), held[1], held[2]]);
   0;
  }
  // ── one writer at a time ─────────────────────────────────────────────
  // The lock is a directory (one level, which only one maker makes) holding its holder's
  // owner file: "pid=<pid> at=<unix ms>". A waiter backs off (host_sleep_ms, doubling to a cap)
  // and tries again. A lock whose holder is gone (host_alive), or has held it longer than the
  // patience, or a wait that has used the patience, is taken over through a mark inside the lock
  // that only one taker can make (<lock>/took-<holder>), while the lock still names that holder;
  // a mark older than the patience (a taker that ended) is removed. A lock is released only by
  // the pid it names, so a holder that was taken over from never removes the taker's lock.
  def ftw-lock-patience-ms() = 10000;
  def ftw-lock-owner-path(lock) = lock ++ "/owner";
  def ftw-lock-owner(lock) = read_file(ftw-lock-owner-path(lock)) ?? "";
  def ftw-lock-text() = "pid=" ++ host_pid().str() ++ " at=" ++ now_unix_ms().str();
  def ftw-lock-field(text, key) {
   let at = str_find(text, key, 0);
   at < 0 ? nothing() : ftw-lock-digits(text, at + len(key), at + len(key));
  }
  def ftw-lock-digits(text, from, i) = (i < len(text)) && (str_byte_at(text, i) >= 48) && (str_byte_at(text, i) <= 57) ? ftw-lock-digits(text, from, i + 1) : i > from ? str_to_int(substring(text, from, i)) : nothing();
  def ftw-lock-take(lock, deadline, tries) = fs_mkdir(lock) == 1 ? ftw-lock-own(lock) : ftw-lock-found(lock, deadline, tries, ftw-lock-owner(lock));
  def ftw-lock-own(lock) {
   write_file_text(ftw-lock-owner-path(lock), ftw-lock-text());
   1;
  }
  def ftw-lock-found(lock, deadline, tries, text) = ftw-lock-stale?(lock, deadline, text) ? ftw-lock-takeover(lock, deadline, tries, text) : ftw-lock-again(lock, deadline, tries);
  def ftw-lock-again(lock, deadline, tries) {
   host_sleep_ms(ftw-lock-backoff(tries));
   ftw-lock-take(lock, deadline, tries + 1);
  }
  // 1, 2, 4 ... 32 ms
  def ftw-lock-backoff(tries) = tries >= 5 ? 32 : [1, 2, 4, 8, 16][tries];
  // the holder is gone, or has held it longer than the patience (an owner not yet written reads
  // the lock's own age), or this wait has used its patience
  def ftw-lock-stale?(lock, deadline, text) {
   let pid = ftw-lock-field(text, "pid=");
   let at = ftw-lock-field(text, " at=");
   if host_monotonic_ms() >= deadline then 1
   else if nothing?(pid) || nothing?(at) then ((now_unix_ms() / 1000) - file_mtime(lock)) * 1000 > ftw-lock-patience-ms() / 5
   else host_alive(pid) != 1 || ((now_unix_ms() - at) > ftw-lock-patience-ms());
  }
  def ftw-lock-takeover(lock, deadline, tries, text) {
   let pid = ftw-lock-field(text, "pid=");
   let mark = lock ++ "/took-" ++ (nothing?(pid) ? "unowned" : pid.str());
   if (fs_mkdir(mark) == 1) && (ftw-lock-owner(lock) == text) then ftw-lock-own(lock)
   else ftw-lock-unmark(lock, mark, deadline, tries);
  }
  def ftw-lock-unmark(lock, mark, deadline, tries) {
   if ((now_unix_ms() / 1000) - file_mtime(mark)) * 1000 > ftw-lock-patience-ms() then host_dir_rmdir(mark) else 0;
   ftw-lock-again(lock, deadline, tries);
  }
  def ftw-lock-release(lock) {
   let holder = ftw-lock-field(ftw-lock-owner(lock), "pid=");
   !nothing?(holder) && (holder == host_pid()) ? host_dir_rmdir(lock) : 0;
  }

  // ── cells ────────────────────────────────────────────────────────────
  // provenance: [kind, request, reply, ordinal, the address the value was spoken as]
  def ftw-provenance(ws, kind, spoken) = intern_node(ftw-cat("ftw-made"), [intern_trivial_string(kind), intern_trivial_string(ftw-request(ws)), intern_trivial_string(ftw-reply(ws)), intern_trivial_int(ftw-ordinal(ws)), intern_trivial_string(spoken)]);
  def ftw-cell-field(c, k) = node_value(node_children(cell-blueprint(c))[k]);
  def ftw-cell-kind(c) = ftw-cell-field(c, 0);
  def ftw-cell-request(c) = ftw-cell-field(c, 1);
  def ftw-cell-reply(c) = ftw-cell-field(c, 2);
  def ftw-cell-ordinal(c) = ftw-cell-field(c, 3);
  def ftw-cell-spoken(c) = ftw-cell-field(c, 4);
  // a node value is spoken as its own address; any other value as its recipe tree's
  def ftw-spoken(value, node) = value_kind(value) == "node_id" ? ftw-coord(value) : ftw-coord(node);
  // Persist value under name in scope. kind is value, node, recipe or fn. Answers the value's
  // recipe tree.
  def ftw-put(ws, scope, name, kind, value) {
   let node = ftw-encode(value);
   let cell = make-cell-recipe(name, ftw-domain(ws, scope), ftw-provenance(ws, kind, ftw-spoken(value, node)), node);
   ftw-store-write(ws, ftw-store-key(ws, scope), cell);
   node;
  }
  def ftw-visible?(ws, scope, c) {
   let d = cell-domain(c);
   if scope == "local" then d == ftw-domain(ws, "local")
   else if scope == "request" then d == ftw-domain(ws, "request")
   else if scope == "lineage" then (d == ftw-domain(ws, "lineage")) || (ftw-starts?(d, "form-token/request/") && (d != ftw-domain(ws, "request")))
   else d == "form-token/global";
  }
  def ftw-visible-any?(ws, c) = any?(s => ftw-visible?(ws, s, c), ftw-scopes());
  def ftw-newest(cells, pred) = nil?(cells) ? nothing() : pred(cells[0]) ? cells[0] : ftw-newest(cells[1:], pred);
  // the newest cell of name scope sees, or nothing
  def ftw-find(ws, scope, name) = ftw-newest(ftw-indexed(ws, ftw-store-key(ws, scope), "n:" ++ name), c => ftw-visible?(ws, scope, c));
  // [cell, scope] through the chain local -> request -> lineage -> global, or nothing
  def ftw-resolve(ws, name) = ftw-resolve-in(ws, ftw-scopes(), name);
  def ftw-resolve-in(ws, scopes, name) = nil?(scopes) ? nothing() : ftw-resolve-at(ws, scopes, name, ftw-find(ws, scopes[0], name));
  def ftw-resolve-at(ws, scopes, name, hit) = nothing?(hit) ? ftw-resolve-in(ws, scopes[1:], name) : [hit, scopes[0]];
  // [value, kind, scope] for a name the chain holds, or nothing; the lookup marks its touch. A name
  // no store's index holds (a walker word the voice never made) is answered from the three
  // indexes alone.
  def ftw-lookup(ws, name) {
   let hit = ftw-missed?(ws, name) ? nothing() : ftw-held-anywhere?(ws, "n:" ++ name) ? ftw-resolve(ws, name) : ftw-miss(ws, name);
   if nothing?(hit) then nothing() else ftw-lookup-hit(ws, hit[0], hit[1]);
  }
  // a miss is remembered as long as a file's stamp is (ftw-check-ms), and forgotten at every write
  def ftw-missed?(ws, name) {
   let at = ftw-get(record_get(ws, "missed"), name);
   !nothing?(at) && ((host_monotonic_ms() - at) < ftw-check-ms());
  }
  def ftw-miss(ws, name) {
   record_set(record_get(ws, "missed"), name, host_monotonic_ms());
   nothing();
  }
  def ftw-held-anywhere?(ws, entry) = record_has(ftw-index(ws, "local"), entry) || record_has(ftw-index(ws, ftw-store-key(ws, "lineage")), entry) || record_has(ftw-index(ws, "global"), entry);
  def ftw-lookup-hit(ws, cell, scope) {
   ftw-touch-cell(ws, cell);
   [ftw-decoded(ws, cell-ctor(cell)), ftw-cell-kind(cell), scope];
  }
  // a tree decodes once per workspace; the same tree is the same value
  def ftw-decoded(ws, node) {
   let held = ftw-get(record_get(ws, "decoded"), ftw-coord(node));
   if !nothing?(held) then held[0] else ftw-decoded-hold(ws, node, ftw-decode(node));
  }
  def ftw-decoded-hold(ws, node, value) {
   record_set(record_get(ws, "decoded"), ftw-coord(node), [value]);
   value;
  }
  // the names a scope sees, nearest and newest first; "" reads every scope
  def ftw-names-in(ws, scope) = map(c => cell-name(c), filter(c => ftw-visible?(ws, scope, c), ftw-cells(ws, ftw-store-key(ws, scope))));
  def ftw-names(ws, scope) = ftw-distinct(scope == "" ? foldl((acc, s) => append(acc, ftw-names-in(ws, s)), [], ftw-scopes()) : ftw-names-in(ws, scope), []);

  // ── reuse ────────────────────────────────────────────────────────────
  // a control begins: the next ordinal, nothing touched yet
  def ftw-begin(ws) {
   record_set(ws, "ordinal", ftw-ordinal(ws) + 1);
   record_set(ws, "touched", "");
   0;
  }
  // "request" when the control touched what an earlier request made, "control" when it touched
  // what an earlier control of this request made, else ""
  def ftw-touched(ws) = record_get(ws, "touched");
  def ftw-touch-cell(ws, c) = ftw-touch(ws, ftw-cell-request(c), ftw-cell-reply(c), ftw-cell-ordinal(c));
  def ftw-touch(ws, request, reply, ordinal) {
   let earlier = request != ftw-request(ws) ? "request" : ((reply != ftw-reply(ws)) || (ordinal < ftw-ordinal(ws))) ? "control" : "";
   if (earlier == "request") || ((earlier == "control") && (ftw-touched(ws) == "")) then record_set(ws, "touched", earlier) else 0;
   0;
  }

  // ── addresses ────────────────────────────────────────────────────────
  // The node at an address: what a visible cell was spoken as at that address, first, since a
  // field that was reset may hold another composition there now; else an integer or boolean leaf
  // from the address itself, or a composite from the host field (node_at, its whole coordinate
  // checked). A cell that holds it marks the touch.
  def ftw-node-at(ws, coord) {
   let parts = frex-coordinate-parts(coord);
   let cell = nothing?(parts) ? nothing() : ftw-cell-at(ws, coord);
   if !nothing?(cell) then ftw-touch-cell(ws, cell) else 0;
   if !nothing?(cell) then ftw-cell-node(ws, cell)
   else if nothing?(parts) then nothing()
   else ftw-field-node(coord, parts);
  }
  def ftw-field-node(coord, parts) {
   if (parts[0] == 1) && (parts[1] == 1) && (parts[2] == 1) then ftw-same(coord, intern_trivial_int(parts[3]))
   else if (parts[0] == 1) && (parts[1] == 1) && (parts[2] == 3) && (parts[3] <= 1) then ftw-same(coord, intern_trivial_bool(parts[3]))
   else if parts[3] >= 1 then ftw-same(coord, node_at(parts[3]))
   else nothing();
  }
  def ftw-same(coord, node) = nothing?(node) ? nothing() : ftw-coord(node) == coord ? node : nothing();
  // the newest visible cell spoken at coord: this reply's, then this lineage's, then the global one
  def ftw-cell-at(ws, coord) {
   let entry = "a:" ++ coord;
   let mine = ftw-newest(ftw-indexed(ws, "local", entry), c => ftw-visible-any?(ws, c)) ?? ftw-newest(ftw-indexed(ws, ftw-store-key(ws, "request"), entry), c => ftw-visible-any?(ws, c));
   mine ?? ftw-newest(ftw-indexed(ws, "global", entry), c => 1);
  }
  // a cell's value as a node: the node it holds, or its recipe tree
  def ftw-cell-node(ws, c) {
   let value = ftw-decoded(ws, cell-ctor(c));
   value_kind(value) == "node_id" ? value : cell-ctor(c);
  }

  // ── values as recipe trees ───────────────────────────────────────────
  // ints, floats and texts are their own leaves; a list, a record, nothing and a node held as a
  // value are composites under ftw-* categories, so decoding knows each apart. A runtime closure
  // has no tree: it encodes as opaque and decodes as nothing.
  def ftw-cat(name) {
   let cats = record_get(FTW-HELD, "cats");
   let held = ftw-get(cats, name);
   if !nothing?(held) then held else ftw-cat-hold(cats, name, intern_node(FTW-ROOT-CATEGORY, [intern_trivial_string(name)]));
  }
  def ftw-cat-hold(cats, name, node) {
   record_set(cats, name, node);
   node;
  }
  def ftw-leaf?(node) = (node_level(node) == 1) && nil?(node_children(node));
  def ftw-cat-name(cat) = ftw-leaf?(cat) ? "" : nil?(node_children(cat)) ? "" : !node_eq(node_category(cat), FTW-ROOT-CATEGORY) ? "" : node_type(node_children(cat)[0]) == 2 ? node_value(node_children(cat)[0]) : "";
  def ftw-encode(v) {
   let kind = value_kind(v);
   if kind == "null" then intern_node(ftw-cat("ftw-nothing"), [])
   else if kind == "int" then intern_trivial_int(v)
   else if kind == "float" then intern_trivial_float(value_str(v))
   else if kind == "string" then intern_trivial_string(v)
   else if kind == "list" then intern_node(ftw-cat("ftw-list"), map(x => ftw-encode(x), v))
   else if kind == "node_id" then intern_node(ftw-cat("ftw-node"), [v])
   else if kind == "record" then intern_node(ftw-cat("ftw-record"), ftw-encode-pairs(v, record_keys(v)))
   else intern_node(ftw-cat("ftw-opaque"), [intern_trivial_string(kind)]);
  }
  // a key is encoded by its own kind, so a record keyed by numbers keeps its keys as numbers
  def ftw-encode-pairs(r, keys) = nil?(keys) ? [] : cons(ftw-encode(keys[0]), cons(ftw-encode(record_get(r, keys[0])), ftw-encode-pairs(r, keys[1:])));
  def ftw-decode(node) {
   let name = ftw-leaf?(node) ? "" : ftw-cat-name(node_category(node));
   let kids = node_children(node);
   if ftw-leaf?(node) then node_value(node)
   else if name == "ftw-nothing" then nothing()
   else if name == "ftw-list" then map(k => ftw-decode(k), kids)
   else if name == "ftw-node" then kids[0]
   else if name == "ftw-record" then ftw-decode-pairs(record_new(0), kids)
   else if name == "ftw-opaque" then nothing()
   else node;
  }
  def ftw-decode-pairs(r, kids) {
   if len(kids) < 2 then r else {
    record_set(r, ftw-decode(kids[0]), ftw-decode(kids[1]));
    ftw-decode-pairs(r, kids[2:]);
   };
  }

  // ── the doors: every native the runtime carries, by name ─────────────
  // [name, arity, fn over the argument list]. A door acts in this process: a file, a process, the
  // clock, the field, a record, Metal, a sense, the network.
  def ftw-doors() {
