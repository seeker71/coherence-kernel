//////////////////////////////////////////////////////////////////////
//
// form-cli-bml-cache.bml — the cache is high-grammar BML itself.
//
// A BML lane may acquire a native `.bml.fkb` specialization.  The source
// remains runnable when that optional artifact is absent, but absence alone
// never proves that an after-start JIT installer exists.  The current source
// path is admitted as one synchronous unit.  Nothing recursively materializes
// historical `*-compile.fk` companions and no source-shaped mirror is emitted.
//
// Proven by: form-stdlib/tests/form-cli-bml-cache-band.fk
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk form-stdlib/language-template.fk

section [form.bml] {
    template NativeCacheRow<TPath> {
        member source: TPath;
        member native: TPath;
        member freshness: int;
    }

    class FormBmlCacheAuthority {
        field CacheAuthorityPath = "form/form-stdlib/bml/form-cli-bml-cache.bml";
        field CacheAuthorityKind = "high-bml-section-native-cache";
        field CacheRule = "source-runs-optional-specialization-no-mirror-no-sweep";
        field DemandRule = "artifact-absence-does-not-prove-demand-or-jit";
    }

    class FormBmlCache<T> {
        field CacheSource = "form/form-stdlib/bml/form-cli-bml-cache.bml";
        field NativeSuffix = ".fkb";
        field CacheScope = "self-only-optional-specialization";
        field PresenceRule = "nothing-is-not-zero-or-one";
        field AvailabilityRule = "source-is-runnable-without-a-preexisting-specialization";

        ref bce-authority = FormBmlCacheAuthority;
        thought bce-pattern = list("high-bml", "native-fkb", "self-only", "dispatch-candidate", "no-source-mirror");

        def bce-source-path() = CacheSource();
        def bce-native-suffix() = NativeSuffix();
        def bce-native-of(source) = str_concat(source, bce-native-suffix());
        def bce-source-present?() = if ge(file_mtime(bce-source-path()), 0) then 1 else 0;
        def bce-native-fresh?() {
            let source_mtime = file_mtime(bce-source-path());
            let native_mtime = file_mtime(bce-native-of(bce-source-path()));
            if lt(source_mtime, 0) then 0 else if lt(native_mtime, 0) then 0 else if ge(native_mtime, source_mtime) then 1 else 0;
        }

        def bce-runnable?() = bce-source-present?();
        def bce-artifact-present?() = if ge(file_mtime(bce-native-of(bce-source-path())), 0) then 1 else 0;
        def bce-specialized?() = bce-native-fresh?();
        def bce-specialization-candidate?() = if and(eq(bce-runnable?(), 1), eq(bce-specialized?(), 0)) then 1 else 0;
        def bce-dispatch-candidate() = if eq(bce-specialized?(), 1) then "image" else if eq(bce-runnable?(), 1) then "source" else "unavailable";
        def bce-source-admission() = "whole-unit-synchronous";
        def bce-artifact-state() = if eq(bce-artifact-present?(), 1) then "present" else "absent";
        def bce-root-compatibility() = if eq(bce-runnable?(), 0) then "source-missing" else if eq(bce-artifact-present?(), 0) then "absent" else if eq(bce-specialized?(), 1) then "current" else "stale";
        def bce-readiness-gate?() = 0;

        // Compatibility name, bounded meaning: the source is available to
        // demand. It never scans or materializes unrelated recipes, and it
        // never turns an optional acceleration artifact into a readiness gate.
        def bce-ensure-all() = bce-runnable?();
        def bce-catalog-state() = bce-root-compatibility();
        def bce-bounded?() = if str_eq(CacheScope(), "self-only-optional-specialization") then 1 else 0;
        def bce-catalog-state-valid?() = if str_eq(bce-catalog-state(), "current") then 1 else if str_eq(bce-catalog-state(), "stale") then 1 else if str_eq(bce-catalog-state(), "absent") then 1 else 0;
        def bce-bit(ok, bit) = if ok then bit else 0;
        def bce-check() {
            let c0 = bce-bit(eq(bce-source-present?(), 1), 1);
            let c1 = bce-bit(str_eq(bce-native-of("a.bml"), "a.bml.fkb"), 2);
            let c2 = bce-bit(eq(bce-catalog-state-valid?(), 1), 4);
            let c3 = bce-bit(eq(bce-ensure-all(), 1), 8);
            let c4 = bce-bit(eq(bce-bounded?(), 1), 16);
            let c5 = bce-bit(str_eq(PresenceRule(), "nothing-is-not-zero-or-one"), 32);
            add(c0, add(c1, add(c2, add(c3, add(c4, c5)))));
        }
    }
    0;
}
