package Form.cli.bmlcache;

import Form.kernel.*;
import Form.cli.flow.*;
import Form.cli.onebody.*;

interface IBmlCache [public, witness, reusable] {
   section [public] {
      const String IceDir = "form/form-stdlib";
      const String TrustRule = "floor=high-bml-cached-native; xtal=wrong-shape; ice is BML; native cache is the seat";

      int Fresh( String strIce, String strXtal ) [abstract];
      int EnsureOne( String strIce ) [abstract];
      int EnsureAll() [abstract];
   }
}

template CacheRow<TPath> [public, reusable] {
   section [public] {
      TPath Ice() [get];
      TPath Xtal() [get];
      int Fresh() [get];
   }
}

class FormBmlCache [public, reusable, teach] : IBmlCache {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-bml-cache.bml";
      int Fresh( String strIce, String strXtal ) [abstract] {}
      int EnsureOne( String strIce ) [abstract] {}
      int EnsureAll() [abstract] {}
   }
}

class FormBmlCacheSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-bml-cache-self";
      const String Pattern = "one-ice disposable-xtal cache-miss-compiles";
      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
