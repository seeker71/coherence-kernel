// Column geometry regressions use the same semantic rows as the live renderer.
// preludes: form/form-stdlib/form-glass-live-ui.bml
section [form.bml] {
    class FormGlassColumnAlignmentBand {
        def fgcab-line(text, id) = list(ftc-segment(text, fgd-neutral(220), "none", id, list("fixture"), "declared"));
        def fgcab-width(line) = if eq(len(line), 0) then 0 else add(ftc-text-width(ftc-segment-text(head(line))), fgcab-width(tail(line)));
        def fgcab-offset(line, id, at) = if eq(len(line), 0) then -1 else if str_eq(ftc-segment-node-id(head(line)), id) then at else fgcab-offset(tail(line), id, add(at, ftc-text-width(ftc-segment-text(head(line)))));
        def fgcab-row(left, right, index, width) = fgd-wide-row(left, right, index, width, 3, 12);
        def fgcab-check(left, index, width) {
            let row = fgcab-row(left, list(fgcab-line("right", "fixture.right")), index, width);
            and(eq(fgcab-offset(row, "layout.gap", 0), width), le(fgcab-width(row), add(width, 15)));
        }
        def fgcab-frame-rows(lines, width) = if eq(len(lines), 0) then 1 else and(if ge(fgcab-offset(head(lines), "layout.gap", 0), 0) then eq(fgcab-offset(head(lines), "layout.gap", 0), width) else 1, fgcab-frame-rows(tail(lines), width));
        def fgcab-frame(view, width) {
            let regions = ftc-measured-split(width, 40, 3, ftc-measure(40, 80), ftc-measure(36, 80));
            let frame = fgd-live-segment-frame(width, 40, 1000, 4, 1, view, "all", "all", "none", 0, list(), list(), list(), "fixture", list(), list(), "fixture");
            fgcab-frame-rows(fgd-segment-frame-lines(frame), ftc-region-width(head(regions)));
        }
        def fgcab-bit(ok, bit) = if ok then bit else 0;
        def fgcab-run() {
            let one = fgcab-line("short", "fixture.left");
            let multiple = append(one, fgcab-line(ftc-byte-text(list(32, 43, 49)), "fixture.value"));
            let row = fgcab-row(list(multiple), list(fgcab-line("right", "fixture.right")), 0, 20);
            let narrow = fgcab-row(list(fgcab-line("0123456789012345678901234", "fixture.left")), list(fgcab-line("right", "fixture.right")), 0, 20);
            let longRight = fgcab-row(list(one), list(fgcab-line("01234567890123456789", "fixture.right")), 0, 20);
            sum(list(
                fgcab-bit(fgcab-check(list(one), 0, 20), 1),
                fgcab-bit(fgcab-check(list(fgcab-line("", "fixture.left")), 0, 20), 2),
                fgcab-bit(fgcab-check(list(), 0, 20), 4),
                fgcab-bit(fgcab-check(list(one), 1, 20), 8),
                fgcab-bit(fgcab-check(list(fgcab-line("01234567890123456789", "fixture.left")), 0, 20), 16),
                fgcab-bit(eq(fgcab-offset(narrow, "fixture.right", 0), 23), 32),
                fgcab-bit(eq(fgcab-offset(row, "fixture.right", 0), 23), 64),
                fgcab-bit(and(eq(fgcab-width(longRight), 35), and(eq(len(ftcb-screen-diff(list(row), list(row))), 0), and(str_eq(ftc-segment-node-id(head(row)), "fixture.left"), str_eq(ftc-segment-evidence(nth(row, 1)), "declared")))), 128),
                fgcab-bit(fgcab-frame("help", 80), 256),
                fgcab-bit(fgcab-frame("overview", 132), 512),
                fgcab-bit(fgcab-frame("memory", 101), 1024),
                fgcab-bit(fgcab-frame("recipes", 160), 2048)
            ));
        }
    }
    0;
}
