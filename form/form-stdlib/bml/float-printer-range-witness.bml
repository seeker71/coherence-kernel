// Observe finite display formatting and real nonfinite refusal.
// Exact binary64 serialization belongs to json-precise, not this six-place display.
// preludes: form-stdlib/core.fk form-stdlib/bml/native-source-inventory.bml form-stdlib/bml/formbin-codec.bml
section [form.bml] {
 class FloatPrinterRangeWitness {
  def fprw-check(state,aspect,ok,evidence) {
   let flow = int_to_str(record_get(state,"checks"));
   let row = oh-reading("float-display",flow,aspect,json-node-int(1),json-node-int(if ok then 1 else 0),json-node-int(if ok then 1 else 0),if ok then list() else list(oh-need("finite-value-preserving-display",json-node-string(evidence))),list("repair","retain"),json-node-string(evidence));
   oh-voice(row); record_set(state,"checks",add(record_get(state,"checks"),1));
   if ok then 1 else fprw-refuse(row);
  }
  def fprw-refuse(row) {
   let response = oh-response(row,"repair");
   oh-voice(response);
   oh-voice(oh-applied(row,oh-select(row,response,"retain"),oh-get(row,"evidence")));
   form_error("float display range witness refused");
  }
  def fprw-values(state,rows) = if nil?(rows) then 1 else fprw-value(state,head(rows),tail(rows));
  def fprw-value(state,row,rest) {
   let actual = float_to_str(str_to_float(head(row))); fprw-check(state,"finite-range",str_eq(actual,nth(row,1)),str_concat(head(row),str_concat(" -> ",actual))); fprw-values(state,rest);
  }
  def fprw-put(state,path,text) {
   let written = write_file(path,text); let read = fbc-read-exact(path,0);
   fprw-check(state,"owned-child-source",and(eq(written,str_len(text)),and(fbc-good(read),str_eq(fbc-value(read),text))),path); 1;
  }
  def fprw-nonfinite(state,job,text) {
   let path = nsi-path(job,str_concat("nonfinite-",str_concat(int_to_str(record_get(state,"checks")),".fk")));
   fprw-put(state,path,str_concat("; preludes: form-stdlib/core.fk\n(float_to_str (str_to_float \"",str_concat(text,"\"))\n")));
   let capture = nsi-capture(list("./fkwu",path)); let errors = fbc-read-exact(nsi-path(nsi-evidence(capture),"stderr"),0);
   fprw-check(state,"nonfinite-refusal",and(eq(nsi-status(capture),1),and(fbc-good(errors),ge(str_find(fbc-value(errors),"float_to_str requires a finite value",0),0))),nsi-evidence(capture)); 1;
  }
  def fprw-forced(state,job) {
   let path = nsi-path(job,"forced-refusal.fk");
   fprw-put(state,path,"; preludes: form-stdlib/bml/float-printer-range-witness.bml\n(fprw-check (record_new 0 \"checks\" 0) \"forced-refusal\" 0 \"refusal itself must terminate\")\n");
   let capture = nsi-capture(list("./fkwu",path));
   let errors = fbc-read-exact(nsi-path(nsi-evidence(capture),"stderr"),0);
   fprw-check(state,"witness-refusal-exit",and(eq(nsi-status(capture),1),and(fbc-good(errors),ge(str_find(fbc-value(errors),"float display range witness refused",0),0))),nsi-evidence(capture));
   1;
  }
  def fprw-run() {
   let state = record_new(0,"checks",0);
   fprw-check(state,"integer-caller",and(str_eq(float_to_str(8000000000000),"8000000000000"),str_eq(float_to_str(-8000000000000),"-8000000000000")),"integer arguments retain their whole values");
   fprw-check(state,"integer-extrema",and(str_eq(float_to_str(str_to_int("4611686018427387903")),"4611686018427387903"),str_eq(float_to_str(str_to_int("-4611686018427387904")),"-4611686018427387904")),"complete tagged integer domain delegates to integer display");
   fprw-values(state,list(list("0","0"),list("-0","0"),list("0.000001","0.000001"),list("4.9406564584124654e-324","0"),list("2.2250738585072014e-308","0"),list("1.5","1.5"),list("1211.166382","1211.166382"),list("2.9999999","3"),list("-2.9999999","-3"),list("4000000000000.25","4000000000000.25"),list("8000000000000.25","8000000000000.25"),list("-8000000000000.25","-8000000000000.25"),list("4611686018427.5","4611686018427.5"),list("4503599627370495.5","4503599627370495.5"),list("4503599627370496","4503599627370496"),list("4611686018427387392","4611686018427387392"),list("4611686018427387904","4.611686e18"),list("8000000000000000000","8e18"),list("-8000000000000000000","-8e18"),list("1e20","1e20"),list("1e300","1e300"),list("9.9999999e299","1e300"),list("1.7976931348623157e308","1.797693e308"),list("-1.7976931348623157e308","-1.797693e308")));
   let job = nsi-job(); fprw-nonfinite(state,job,"1e309"); fprw-nonfinite(state,job,"-1e309"); fprw-nonfinite(state,job,"nan"); fprw-forced(state,job);
   print(list("float-display-range",record_get(state,"checks"),"evidence",job)); 1;
  }
 }
 0;
}
