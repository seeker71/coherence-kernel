//////////////////////////////////////////////////////////////////////
// form-cli-peer-direct-answer-envelope.bml -- scannerless separation of a
// direct task's caller-owned body from its response/control envelope.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-peer-agent.fk

section [form.bml] {
    class FormCliPeerDirectAnswerEnvelope {
        field Route = "direct-answer";
        field Response = "\nresponse=";

        def fcpdae-route() = Route();
        def fcpdae-response-mark() = Response();
        def fcpdae-response-at(frame, task-start) = str_find(frame, fcpdae-response-mark(), task-start);
        def fcpdae-response-inside?(frame, task-start, close-at) = and(ge(fcpdae-response-at(frame, task-start), task-start), lt(fcpdae-response-at(frame, task-start), close-at));
        def fcpdae-task-end(kind, frame, task-start, close-at) = if not(str_eq(kind, fcpdae-route())) then close-at else if fcpdae-response-inside?(frame, task-start, close-at) then fcpdae-response-at(frame, task-start) else close-at;
    }
    0;
}
