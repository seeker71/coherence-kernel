//////////////////////////////////////////////////////////////////////
// form-cli-peer-direct-answer-envelope.bml -- scannerless separation of a
// direct task's caller-owned body from its response/control envelope.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-peer-agent.fk

section [form.bml] {
    class FormCliPeerDirectAnswerEnvelope {
        field DirectAnswerEnvelopeRoute = "direct-answer";
        field DirectAnswerEnvelopeResponse = "\nresponse=";

        def fcpdae-route() = DirectAnswerEnvelopeRoute();
        def fcpdae-response-mark() = DirectAnswerEnvelopeResponse();
        def fcpdae-response-at(frame, task-start) = str_find(frame, fcpdae-response-mark(), task-start);
        def fcpdae-response-inside?(frame, task-start, close-at) = (fcpdae-response-at(frame, task-start) >= task-start) && (fcpdae-response-at(frame, task-start) < close-at);
        def fcpdae-task-end(kind, frame, task-start, close-at) = !((String) kind == fcpdae-route()) ? close-at : fcpdae-response-inside?(frame, task-start, close-at) ? fcpdae-response-at(frame, task-start) : close-at;
    }
    0;
}
