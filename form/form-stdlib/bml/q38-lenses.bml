// q38-lenses.bml — the local model's parallel reasoning as one call: one prefix, N lenses, one weight pass per step, the model's own
// judgement of which lens it is surest of.
//
// The prefix text is tokenized by the body's tokenizer and prefilled once on a single stream (the batched path); one Form-written
// copy kernel forks its state into one arena slot per lens (q38m-fork-all); each lens text continues from the prefix length, all
// streams in one pass over the weights per step (q38m-generate-scored); the head's log-sum-exp kernel reads each stream's surprise at
// its greedy token. A door calls qlz-run and then chooses: by what the lens said (a validator of its own) and by how sure the
// model was of it. Nothing leaves the machine; the lease, the prefill rows (span 64) and the arena are the caller's to size.
// preludes: form-stdlib/core.fk form-stdlib/bml/q38-multi.bml form-stdlib/bml/form-cli-code-live.bml native/metal/qwen35-dense-token-handle.fk native/metal/qwen35-dense-spec.fk
section [form.bml] {
 class Q38Lenses {
  def qlz-file() = "/Users/ursmuff/models/qwen38-27b/Qwen3.8-27B-Q8_0.gguf";
  // the model opened for lenses: prefill rows 64, positions for prefix + lens + generation (maxpos)
  def qlz-open(maxpos) = q38-open-span(qlz-file(), maxpos, 64);
  def qlz-tok-go(cur, left, acc) {
   let one = qtlc-next(cur);
   if (qtlc-next-present?(one) && left > 0) then qlz-tok-go(qtlc-next-cursor(one), left - 1, cons(qtlc-next-value(one), acc)) else reverse(acc);
  }
  def qlz-tokenize(ctx, text) = qlz-tok-go(qtlc-open(ctx[9], qsx-seal-line(ctx[9]), [qtlc-text-segment(text)]), 100000, []);
  def qlz-detok(ctx, ids) = foldl((a, id) => a ++ fcmo-decode-id(ctx[7], id), "", ids);
  def qlz-prefill(ctx, sts, ids) = len(ids) <= 64 ? q38-prefill-span-batched(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], ids, 0) : q38-prefill-span-sliced(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], ids, 0, 64);
  // answers [texts, micro-nats a token, prefix ids, milliseconds [prefill, fork, generate]]
  def qlz-run(ctx, prefixText, lensTexts, gen) = qlz-run-ids(ctx, qlz-tokenize(ctx, prefixText), map(t => qlz-tokenize(ctx, t), lensTexts), gen);
  // A chat turn, for a voice that answers as an assistant: the prefix opens the user turn; a lens finishes it (its task text), closes it
  // and opens the assistant's with an EMPTY think block (so the voice answers instead of reasoning on until the tokens run out), then
  // the lens's opening text. The special tokens are ids from the model's crystal (ims, ime, the user / assistant / newline sequences,
  // think start and end), the way the coding session builds its own turns.
  def qlz-seg-ids(ctx, segments) = qlz-tok-go(qtlc-open(ctx[9], qsx-seal-line(ctx[9]), segments), 100000, []);
  def qlz-chat-prefix(ctx, text) {
   let c = qsx-load(ctx[9]);
   qlz-seg-ids(ctx, [qtlc-id-segment([c[1]]), qtlc-id-segment(c[5]), qtlc-id-segment(c[6]), qtlc-text-segment(text)]);
  }
  def qlz-chat-lens(ctx, task, opening) {
   let c = qsx-load(ctx[9]);
   qlz-seg-ids(ctx, [qtlc-text-segment(task), qtlc-id-segment([c[2]]), qtlc-id-segment(c[6]), qtlc-id-segment([c[1]]), qtlc-id-segment(c[7]), qtlc-id-segment(c[6]), qtlc-id-segment([c[3]]), qtlc-text-segment("\n\n"), qtlc-id-segment([c[4]]), qtlc-text-segment("\n\n"), qtlc-text-segment(opening)]);
  }
  def qlz-run-ids(ctx, prefix, lenses, gen) {
   let n = len(lenses);
   let qs0 = q38s-pipes(q38s-msl());
   let sx = q38s-open(ctx, 8, 8);
   let mp = q38m-pipes(q38m-msl());
   let posb = metal_buf_alloc(64);
   let lpb = metal_buf_alloc(64);
   let arena = q38m-new-arena(ctx[2], n, bytes => metal_buf_alloc(bytes));
   let sts = q38-new-state(ctx[2]);
   let t0 = host_monotonic_ms();
   let pre = qlz-prefill(ctx, sts, prefix);
   let t1 = host_monotonic_ms();
   let forked = q38m-fork-all(ctx, mp[5], sts, arena, n, len(prefix));
   let t2 = host_monotonic_ms();
   let scored = q38m-generate-scored(ctx, qs0, mp, arena, sx, posb, lenses, gen, len(prefix), lpb);
   let t3 = host_monotonic_ms();
   let texts = map(o => qlz-detok(ctx, o), scored[0]);
   // everything this call allocated goes back (a door that opens the model again in this process — the planner — must not carry it)
   let freed = q38-free-state(sts) + q38-free-state(arena) + q38s-close(sx) + q38-free-handle(posb) + q38-free-handle(lpb);
   [texts, map(x => x / gen, scored[1]), prefix, [t1 - t0, t2 - t1, t3 - t2]];
  }
  // the model's context closed: its weights and layers returned, so a later open in this process starts from nothing
  def qlz-close(ctx) = q38-close(ctx, []);
 }
 0;
}
