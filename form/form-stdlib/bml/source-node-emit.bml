// source-node-emit.bml — a recipe becomes code nodes, with no text between: the first node-emitting step of docs/bml-direct-nodes-jit.md.
//
// The grammar's templates already intern recipe nodes (bmf-grammar.fk gx-build) and fbl-lower rebuilds them as source-compiler recipes
// (fsc-rec-*); fsc-source-emit-recipe then prints Form text for the C parser to read back. This walker is the sibling of that printer: it reads
// the same recipe and asks the kernel for the same rows the parser would have made, through jit_node ["node" t c1 c2 c3], ["defn" name arity]
// and ["body" idx node] (runtime/fkwu-uni.c, fk_jit_node). It takes on what the parser did that the printer never had to: slots for names,
// the literal that wraps every slot number, the argument cells of a call built right to left, the function table.
//
// What it carries now, each as the text route builds it: an int or string leaf (tag 1, tag 24), a name bound by a parameter (tag 110 over the
// slot's literal), a call to a kernel op named in flt-ops (tag from the table, its arity checked), a call to a registered function (tag 241 over
// the tag-242 cells, the arity read from the kernel), a defn (the name registered, the slots reserved, tag 111 over a body that needs more than
// slot 0, the body bound). What it does not carry yet it REFUSES BY NAME (form_error says the category or leaf): do, let, if, match, a float
// or bool leaf, a call through a bound name, a name that is neither bound nor a function. Nothing is guessed and nothing is dropped.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/source-compiler.fk form-stdlib/form-flatten.fk
section [form.bml] {
 class SourceNodeEmit {
  def sne-node(t, a, b, c) = jit_node(["node", t, a, b, c]);
  def sne-refuse(what) = form_error("source-node-emit: " ++ what);
  def sne-lit(v) = sne-node(1, v, 0, 0);
  def sne-slot-of(scope, name) = len(scope) == 0 ? -1 : scope[0][0] == name ? scope[0][1] : sne-slot-of(scope[1:], name);
  def sne-op-row(ops, name) = len(ops) == 0 ? nothing() : ops[0][0] == name ? ops[0] : sne-op-row(ops[1:], name);
  def sne-leaf(r) {
   let kind = node_type(r);
   kind == 2 ? sne-node(24, node_value(r), 0, 0) : (kind == 1 || kind == 5) ? sne-lit(node_value(r)) : sne-refuse("a leaf of node_type " ++ kind.str() ++ " is not carried yet");
  }
  def sne-ident(kids, scope) {
   let name = node_value(kids[0]);
   let slot = sne-slot-of(scope, name);
   slot < 0 ? sne-refuse("the name " ++ name ++ " is neither bound here nor carried as a value yet") : sne-node(110, sne-lit(slot), 0, 0);
  }
  def sne-chain(args) = len(args) == 0 ? -1 : sne-node(242, args[0], sne-chain(args[1:]), 0);
  def sne-op(row, args) = len(args) != row[1] ? sne-refuse("the op " ++ row[0] ++ " reads " ++ row[1].str() ++ " arguments and was given " ++ len(args).str()) : row[1] > 3 ? sne-refuse("the op " ++ row[0] ++ " reads more than three") : sne-node(row[2], len(args) > 0 ? args[0] : 0, len(args) > 1 ? args[1] : 0, len(args) > 2 ? args[2] : 0);
  def sne-fn-call(name, args) {
   let idx = jit_node(["lookup", name]);
   nothing?(idx) ? sne-refuse("a call to " ++ name ++ ": neither a kernel op nor a function this process holds") : jit_node(["arity", idx]) != len(args) ? sne-refuse("the function " ++ name ++ " reads " ++ jit_node(["arity", idx]).str() ++ " arguments and was given " ++ len(args).str()) : sne-node(241, idx, sne-chain(args), 0);
  }
  def sne-call(name, args, scope) {
   let row = sne-op-row(flt-ops(), name);
   sne-slot-of(scope, name) >= 0 ? sne-refuse("a call through the bound name " ++ name ++ " is not carried yet") : !nothing?(row) ? sne-op(row, args) : sne-fn-call(name, args);
  }
  def sne-args(kids, scope) = map(k => sne-emit(k, scope), kids);
  def sne-emit(r, scope) {
   let kids = node_children(r);
   let cat = node_category(r);
   let prim = fsc-source-primitive-name(cat);
   (len(kids) == 0 && node_level(r) == 1) ? sne-leaf(r)
   : node_eq(cat, fsc-rec-IDENT-CAT) ? sne-ident(kids, scope)
   : node_eq(cat, fsc-rec-FNCALL-CAT) ? sne-call(node_value(node_children(kids[0])[0]), sne-args(kids[1:], scope), scope)
   : node_eq(cat, fsc-rec-FNDEF-CAT) ? sne-refuse("a defn nested in an expression is not carried")
   : prim != "" ? sne-call(prim, sne-args(kids, scope), scope)
   : sne-refuse("the recipe category " ++ node_category(r).str() ++ " (do, let, if, match) is not carried yet");
  }
  def sne-slots(names, i) = len(names) == 0 ? [] : cons([names[0], i], sne-slots(names[1:], i + 1));
  def sne-param-names(r) = map(p => node_value(p), node_children(r));
  // a defn recipe: the function registered, its parameters on slots 0..n-1, a body that reads slot 0 only when it has one parameter and no let
  // (the parser's frame reserve: tag 111 over the body when the highest slot is above 0), the body bound. Answers the function index.
  def sne-defn(kids) {
   let name = node_value(kids[0]);
   let params = sne-param-names(kids[1]);
   let idx = jit_node(["defn", name, len(params)]);
   let body = sne-emit(kids[2], sne-slots(params, 0));
   let top = len(params) > 1 ? len(params) - 1 : 0;
   jit_node(["body", idx, top > 0 ? sne-node(111, sne-lit(top), body, 0) : body]);
  }
  def sne-emit-recipe(r) = node_eq(node_category(r), fsc-rec-FNDEF-CAT) ? sne-defn(node_children(r)) : sne-emit(r, []);
 }
}
