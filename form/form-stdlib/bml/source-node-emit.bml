// source-node-emit.bml — a recipe becomes code nodes, with no text between: the node-emitting step of docs/bml-direct-nodes-jit.md.
//
// The grammar's templates already intern recipe nodes (bmf-grammar.fk gx-build) and fbl-lower rebuilds them as source-compiler recipes
// (fsc-rec-*); fsc-source-emit-recipe then prints Form text for the C parser to read back. This walker is the sibling of that printer: it reads
// the same recipe and asks the kernel for the same rows the parser would have made, through jit_node ["node" t c1 c2 c3], ["defn" name arity],
// ["body" idx node], ["lookup" name] and ["arity" idx] (runtime/fkwu-uni.c, fk_jit_node). It takes on what the parser did that the printer never
// had to: slots for names (a counter that only grows through one defn, as fk_maxslot does), the literal that wraps every slot number, the argument
// cells of a call built right to left, the function table.
//
// What it carries, each as the text route builds it: an int or string leaf (tag 1, tag 24); a name bound by a parameter or a let (tag 110 over the
// slot's literal); a call to a kernel op named in flt-ops (the tag from the table, its arity checked); a call to a compare or logic op, a rewrite row
// of runtime/fkwu-optable.h, instantiated from its RPN program (sne-rewrites below mirrors those rows; the band reads the header and says when they
// drift); a call to a registered function, itself included (tag 241 over the tag-242 cells, the arity read from the kernel); do (tag 69, the first
// form's value dropped, the rest answered); a let in a do (tag 109 over the rest of the do, the do answering the bound value when nothing follows);
// if (tag 6); defn (the name registered, the parameters on slots 0..n-1, tag 111 over a body whose frame needs more than slot 0, the body bound).
// What it does not carry yet it REFUSES BY NAME (form_error says the category or leaf): match, a nested defn, a float or bool leaf, a call through
// a bound name that is no op, a name that is neither bound nor a function. Nothing is guessed and nothing is dropped.
// Every emit answers [node, slots]: the node id and the highest slot the defn has taken so far.
// preflight-exec: forbidden
// preludes: form-stdlib/core.fk form-stdlib/source-compiler.fk form-stdlib/form-flatten.fk
section [form.bml] {
 class SourceNodeEmit {
  // the rewrite rows of runtime/fkwu-optable.h: [name, arity, RPN program]; opcode 0 ARG i, 1 LIT v, 2 NODE tag count (children precede it)
  def sne-rewrites() = [["gt", 2, [0,0,0,1,2,5,2,1,0,1,1,2,6,3]], ["ge", 2, [0,1,0,0,2,5,2]], ["lt", 2, [0,0,0,1,2,103,2]], ["eq", 2, [0,0,0,1,2,102,2]], ["and", 2, [0,0,0,1,1,1,1,0,2,6,3,1,0,2,6,3]], ["or", 2, [0,0,1,1,0,1,1,1,1,0,2,6,3,2,6,3]], ["not", 1, [0,0,1,0,1,1,2,6,3]], ["ne", 2, [0,0,0,1,2,102,2,1,0,1,1,2,6,3]], ["abs", 1, [1,0,0,0,2,5,2,0,0,1,0,0,0,2,4,2,2,6,3]]];
  def sne-node(t, a, b, c) = jit_node(["node", t, a, b, c]);
  def sne-refuse(what) = form_error("source-node-emit: " ++ what);
  def sne-lit(v) = sne-node(1, v, 0, 0);
  def sne-slot-of(scope, name) = len(scope) == 0 ? -1 : scope[0][0] == name ? scope[0][1] : sne-slot-of(scope[1:], name);
  def sne-row(rows, name) = len(rows) == 0 ? nothing() : rows[0][0] == name ? rows[0] : sne-row(rows[1:], name);
  def sne-leaf(r, ms) {
   let kind = node_type(r);
   kind == 2 ? [sne-node(24, node_value(r), 0, 0), ms] : (kind == 1 || kind == 5) ? [sne-lit(node_value(r)), ms] : sne-refuse("a leaf of node_type " ++ kind.str() ++ " is not carried yet");
  }
  def sne-ident(kids, scope, ms) {
   let name = node_value(kids[0]);
   let slot = sne-slot-of(scope, name);
   slot < 0 ? sne-refuse("the name " ++ name ++ " is neither bound here nor carried as a value yet") : [sne-node(110, sne-lit(slot), 0, 0), ms];
  }
  def sne-chain(args) = len(args) == 0 ? -1 : sne-node(242, args[0], sne-chain(args[1:]), 0);
  def sne-pad(args, i) = len(args) > i ? args[i] : 0;
  def sne-op(row, args) = len(args) != row[1] ? sne-refuse("the op " ++ row[0] ++ " reads " ++ row[1].str() ++ " arguments and was given " ++ len(args).str()) : row[1] > 3 ? sne-refuse("the op " ++ row[0] ++ " reads more than three") : sne-node(row[2], sne-pad(args, 0), sne-pad(args, 1), sne-pad(args, 2));
  // a rewrite row's program, run once left to right over a stack (top first): ARG pushes an argument, LIT a literal node, NODE pops count children
  def sne-take(stack, n) = n == 0 ? [] : cons(stack[0], sne-take(stack[1:], n - 1));
  def sne-drop(stack, n) = n == 0 ? stack : sne-drop(stack[1:], n - 1);
  def sne-rw-step(prog, k, args, stack) {
   let op = prog[k];
   op == 0 ? sne-rw-run(prog, k + 2, args, cons(args[prog[k + 1]], stack))
   : op == 1 ? sne-rw-run(prog, k + 2, args, cons(sne-lit(prog[k + 1]), stack))
   : sne-rw-node(prog, k, args, stack, sne-rev(sne-take(stack, prog[k + 2]), []));
  }
  def sne-rev(xs, acc) = len(xs) == 0 ? acc : sne-rev(xs[1:], cons(xs[0], acc));
  def sne-rw-node(prog, k, args, stack, kids) = sne-rw-run(prog, k + 3, args, cons(sne-node(prog[k + 1], sne-pad(kids, 0), sne-pad(kids, 1), sne-pad(kids, 2)), sne-drop(stack, prog[k + 2])));
  def sne-rw-run(prog, k, args, stack) = k >= len(prog) ? stack[0] : sne-rw-step(prog, k, args, stack);
  def sne-rewrite(row, args) = len(args) != row[1] ? sne-refuse("the op " ++ row[0] ++ " reads " ++ row[1].str() ++ " arguments and was given " ++ len(args).str()) : sne-rw-run(row[2], 0, args, []);
  def sne-fn-call(name, args) {
   let idx = jit_node(["lookup", name]);
   nothing?(idx) ? sne-refuse("a call to " ++ name ++ ": neither a kernel op nor a function this process holds") : jit_node(["arity", idx]) != len(args) ? sne-refuse("the function " ++ name ++ " reads " ++ jit_node(["arity", idx]).str() ++ " arguments and was given " ++ len(args).str()) : sne-node(241, idx, sne-chain(args), 0);
  }
  // the parser consults the op and rewrite rows before a bound name, so a bound name that is also an op still reads as the op
  def sne-call(name, args, scope) {
   let op = sne-row(flt-ops(), name);
   let rw = sne-row(sne-rewrites(), name);
   !nothing?(op) ? sne-op(op, args) : !nothing?(rw) ? sne-rewrite(rw, args) : sne-slot-of(scope, name) >= 0 ? sne-refuse("a call through the bound name " ++ name ++ " is not carried yet") : sne-fn-call(name, args);
  }
  // the arguments left to right, the slot counter carried through: [nodes, slots]
  def sne-args(kids, scope, ms) = len(kids) == 0 ? [[], ms] : sne-args-more(sne-emit(kids[0], scope, ms), kids[1:], scope);
  def sne-args-more(first, rest, scope) {
   let more = sne-args(rest, scope, first[1]);
   [cons(first[0], more[0]), more[1]];
  }
  def sne-call-form(name, kids, scope, ms) {
   let a = sne-args(kids, scope, ms);
   [sne-call(name, a[0], scope), a[1]];
  }
  def sne-if(kids, scope, ms) {
   let c = sne-emit(kids[0], scope, ms);
   let y = sne-emit(kids[1], scope, c[1]);
   let n = sne-emit(kids[2], scope, y[1]);
   [sne-node(6, c[0], y[0], n[0]), n[1]];
  }
  def sne-let-kid?(r) = node_eq(node_category(r), fsc-rec-LET-CAT);
  // a do: forms in order, the first value dropped (tag 69); a let binds the rest of the do on the next slot (tag 109), the do answering the bound value when nothing follows
  def sne-do(kids, scope, ms) {
   len(kids) == 0 ? [sne-lit(0), ms] : sne-let-kid?(kids[0]) ? sne-do-let(node_children(kids[0]), kids[1:], scope, ms) : sne-do-form(sne-emit(kids[0], scope, ms), kids[1:], scope);
  }
  def sne-do-form(first, rest, scope) = len(rest) == 0 ? first : sne-do-join(first, sne-do(rest, scope, first[1]));
  def sne-do-join(first, r) = [sne-node(69, first[0], r[0], 0), r[1]];
  def sne-do-let(lk, rest, scope, ms) {
   let v = sne-emit(lk[1], scope, ms);
   let slot = v[1] + 1;
   let r = len(rest) == 0 ? [sne-node(110, sne-lit(slot), 0, 0), slot] : sne-do(rest, cons([node_value(lk[0]), slot], scope), slot);
   [sne-node(109, sne-lit(slot), v[0], r[0]), r[1]];
  }
  def sne-emit(r, scope, ms) {
   let kids = node_children(r);
   let cat = node_category(r);
   let prim = fsc-source-primitive-name(cat);
   (len(kids) == 0 && node_level(r) == 1) ? sne-leaf(r, ms)
   : node_eq(cat, fsc-rec-IDENT-CAT) ? sne-ident(kids, scope, ms)
   : node_eq(cat, fsc-rec-FNCALL-CAT) ? sne-call-form(node_value(node_children(kids[0])[0]), kids[1:], scope, ms)
   : node_eq(cat, fsc-rec-DO-CAT) ? sne-do(kids, scope, ms)
   : node_eq(cat, fsc-rec-LET-CAT) ? sne-do-let(kids, [], scope, ms)
   : node_eq(cat, fsc-rec-IF3-CAT) ? sne-if(kids, scope, ms)
   : node_eq(cat, fsc-rec-FNDEF-CAT) ? sne-refuse("a defn nested in an expression is not carried")
   : node_eq(cat, fsc-rec-MATCH-CAT) ? sne-refuse("match is not carried yet")
   : prim != "" ? sne-call-form(prim, kids, scope, ms)
   : sne-refuse("the recipe category " ++ value_str(node_category(r)) ++ " is not carried yet");
  }
  def sne-slots(names, i) = len(names) == 0 ? [] : cons([names[0], i], sne-slots(names[1:], i + 1));
  def sne-param-names(r) = map(p => node_value(p), node_children(r));
  // a defn recipe: the function registered first (so it can call itself), its parameters on slots 0..n-1, the body walked with the slot counter at the
  // highest parameter slot, tag 111 over the body when the frame needs more than slot 0, the body bound. Answers the function index.
  def sne-defn(kids) {
   let name = node_value(kids[0]);
   let params = sne-param-names(kids[1]);
   let idx = jit_node(["defn", name, len(params)]);
   let body = sne-emit(kids[2], sne-slots(params, 0), len(params) > 1 ? len(params) - 1 : 0);
   jit_node(["body", idx, body[1] > 0 ? sne-node(111, sne-lit(body[1]), body[0], 0) : body[0]]);
  }
  def sne-emit-recipe(r) = node_eq(node_category(r), fsc-rec-FNDEF-CAT) ? sne-defn(node_children(r)) : sne-emit(r, [], 0)[0];
 }
}
