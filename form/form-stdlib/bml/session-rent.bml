// session-rent.bml — one rented session's spend beside the local tokens that served it.
// Rented: every billed request in the session's transcript and its subagents' transcripts,
// read once per requestId (input, cache write, cache read, output). sr-files names that set; the
// turn meter and the flow meter read the same set, so the three agree on one session.
// Local: the voice's drafts for the same session (receipts/draft-ledger.jsonl, keyed by session id)
// and the coding lane's IDs from the native-turn rows that session began (their "session" field),
// read where turns run: this checkout and the walk checkout launchd turns in (sr-turn-rows). While
// no turn row names a session, the lane columns read null.
// The share is the walk's measure: local generated / (local generated + rented output), in parts
// per million, over what is known; injected IDs are reported beside it.
import form-stdlib/form-cli-movement.bml;
import form-stdlib/form-fs.fk;
import form-stdlib/bml/form-cli-guide-packet.bml;
section [form.bml] {
    def sr-fields() = ["input_tokens","cache_creation_input_tokens","cache_read_input_tokens","output_tokens"];
    def sr-field(text, usageAt, rowEnd, name) {
        let mark = rtm-mark(name);
        let at = str_find(text, mark, usageAt);
        (at < 0) || (at >= rowEnd) ? 0 : max2(0, fmv-field-int(text, at + len(mark), 0, 0));
    }
    def sr-add(acc, text, usageAt, rowEnd) = [acc[0] + sr-field(text, usageAt, rowEnd, "input_tokens"),
        acc[1] + sr-field(text, usageAt, rowEnd, "cache_creation_input_tokens"),
        acc[2] + sr-field(text, usageAt, rowEnd, "cache_read_input_tokens"),
        acc[3] + sr-field(text, usageAt, rowEnd, "output_tokens"), acc[4] + 1];
    // rtm-scan-go's walk, summing four fields per fresh request instead of one
    def sr-scan-go(text, from, acc, seen) {
        let usageAt = str_find(text, rtm-usage-mark(), from);
        let rowEnd = usageAt < 0 ? 0 - 1 : str_find(text, "\n", usageAt);
        let reqId = rowEnd < 0 ? "" : rtm-row-request(text, usageAt, rowEnd);
        let fresh = (String) reqId != "" && str_find(seen, rtm-seen-key(reqId), 0) < 0;
        usageAt < 0 ? [acc, rtm-rest-at(text, from), seen] :
         rowEnd < 0 ? [acc, usageAt, seen] :
         sr-scan-go(text, rowEnd + 1, fresh ? sr-add(acc, text, usageAt, rowEnd) : acc, fresh ? seen ++ reqId ++ "," : seen);
    }
    def sr-file-go(path, size, off, acc, seen, chunk) {
        let slice = off >= size ? "" : read_file_slice(path, off, min2(chunk, size - off));
        let scanned = sr-scan-go(slice, 0, acc, seen);
        let resumeAt = scanned[1];
        let more = (off + len(slice)) < size && len(slice) > 0;
        more && (Comparable) resumeAt == 0 ? sr-file-go(path, size, off, acc, seen, chunk * 2) :
         more && resumeAt > 0 ? sr-file-go(path, size, off + resumeAt, scanned[0], scanned[2], chunk) :
         [scanned[0], scanned[2]];
    }
    def sr-jsonl?(name) = len(name) > 6 && (String) substring(name, len(name) - 6, len(name)) == ".jsonl";
    // every transcript under a directory, depth first
    def sr-tree(dir) = (Comparable) fs_is_dir(dir) != 1 ? [] :
        fs_list(dir) |> map(name => dir ++ "/" ++ name) |> sr-tree-rows;
    def sr-tree-rows(paths) = nil?(paths) ? [] :
        append((Comparable) fs_is_dir(paths[0]) == 1 ? sr-tree(paths[0]) : sr-jsonl?(paths[0]) ? [paths[0]] : [], sr-tree-rows(paths[1:]));
    def sr-files(main) = cons(main, sr-tree(substring(main, 0, len(main) - 6) ++ "/subagents"));
    def sr-rented(files, acc, seen) = nil?(files) ? acc : {
        let read = sr-file-go(files[0], file_size(files[0]), 0, acc, seen, rtm-chunk());
        sr-rented(files[1:], read[0], read[1]);
    };
    // local: the voice's drafts written for this session
    def sr-local(session, rows, drafts, generated) = nil?(rows) ? [drafts, generated] : {
        let row = rows[0];
        let mine = str_find(row, "\"session\":\"" ++ session ++ "\"", 0) >= 0;
        let at = str_find(row, "\"generated\":", 0);
        let g = mine && at >= 0 ? max2(0, fmv-field-int(row, at + 12, 0, 0)) : 0;
        sr-local(session, rows[1:], mine ? drafts + 1 : drafts, generated + g);
    };
    def sr-session(main) {
        let base = substring(main, fs-last-slash(main) + 1, len(main));
        substring(base, 0, len(base) - 6);
    }
    // ── where turns run: this checkout, and the walk checkout the day-turn schedule names ──
    def sr-turn-ledger() = "receipts/native-turn-ledger.jsonl";
    def sr-day-turn-plist() = "docs/launchd/earth.hati.day-turn.plist";
    def sr-plist-dir(text) {
        let key = str_find(text, "<key>WorkingDirectory</key>", 0);
        let open = key < 0 ? 0 - 1 : str_find(text, "<string>", key);
        let close = open < 0 ? 0 - 1 : str_find(text, "</string>", open);
        close < 0 ? "" : substring(text, open + 8, close);
    }
    def sr-walk-dir() = file_size(sr-day-turn-plist()) < 1 ? "" : sr-plist-dir(read_file(sr-day-turn-plist()));
    // "" is this checkout; the walk checkout joins when it is another directory that exists
    def sr-checkouts() {
        let walk = sr-walk-dir();
        (String) walk == "" || (String) walk == host_cwd() || (Comparable) fs_is_dir(walk) != 1 ? [""] : ["", walk];
    }
    def sr-ledger-at(dir) = (String) dir == "" ? sr-turn-ledger() : dir ++ "/" ++ sr-turn-ledger();
    def sr-tagged(dir, row) = json-node-object(append(json-object-pairs(row), [fhn-s("checkout", dir)]));
    def sr-key(row) = fcgp-show(fcgp-num(row, "at_unix_ms")) ++ "|" ++ fcgp-str(row, "gap") ++ "|" ++ fcgp-show(fcgp-num(row, "option"));
    def sr-at(row) = fcgp-num(row, "at_unix_ms") ?? 0;
    def sr-merge(a, b) = nil?(a) ? b : nil?(b) ? a : sr-at(b[0]) < sr-at(a[0]) ? cons(b[0], sr-merge(a, b[1:])) : cons(a[0], sr-merge(a[1:], b));
    def sr-fresh(held, rows) {
        let keys = map(r => sr-key(r), held);
        filter(r => !fcgp-member?(keys, sr-key(r)), rows);
    }
    // every checkout's rows, each tagged with its checkout, one row per at_unix_ms+gap+option, in time order;
    // the first checkout named keeps a row both hold
    def sr-turn-rows-from(dirs) = foldl((held, dir) => sr-merge(held, sr-fresh(held, map(row => sr-tagged(dir, row), fcgp-rows(sr-ledger-at(dir))))), [], dirs);
    def sr-turn-rows() = sr-turn-rows-from(sr-checkouts());
    // the coding lane's options a session began: [options, generated, injected]. A turn row names its session only
    // when the session that began it said so ({"session":...} on native-turn-run's stdin); while no row in the set
    // names any session, which options a session began is unknown, and the reading is nothing, never 0.
    def sr-lane-known?(rows) = any?(r => fcgp-present?(r, "session"), rows);
    def sr-lane(session, rows) = !sr-lane-known?(rows) ? nothing() : sr-lane-of(fcgp-of(rows, "session", session));
    def sr-lane-of(mine) = [len(mine), fcgp-known(mine, "local_generated_ids"), fcgp-known(mine, "local_injected_ids")];
    def sr-lane-field(lane, i) = nothing?(lane) ? "null" : int_to_str(lane[i]);
    // the share over what is known: with the lane unknown it counts the drafts alone, a lower bound
    // one session measured: its id, the transcripts it spans, what it rented, and the local tokens that served it
    def sr-measure(main, draftLedger, turnRows) {
        let files = sr-files(main);
        let session = sr-session(main);
        [session, files, sr-rented(files, [0, 0, 0, 0, 0], rtm-seen-none()),
         sr-local(session, file_size(draftLedger) < 1 ? [] : split-on(read_file(draftLedger), "\n"), 0, 0),
         sr-lane(session, turnRows)];
    }
    def sr-row-with(main, draftLedger, turnRows) {
        let measured = sr-measure(main, draftLedger, turnRows);
        let files = measured[1];
        let rented = measured[2];
        let session = measured[0];
        let local = measured[3];
        let lane = measured[4];
        let generated = local[1] + (nothing?(lane) ? 0 : lane[1]);
        let share = (generated + rented[3]) == 0 ? 0 : (generated * 1000000) / (generated + rented[3]);
        str-join(["{\"at_unix_ms\":", int_to_str(now_unix_ms()), ",\"session\":\"", session,
            "\",\"rented\":{\"requests\":", int_to_str(rented[4]), ",\"input\":", int_to_str(rented[0]),
            ",\"cache_write\":", int_to_str(rented[1]), ",\"cache_read\":", int_to_str(rented[2]),
            ",\"output\":", int_to_str(rented[3]), ",\"transcripts\":", int_to_str(len(files)),
            "},\"local\":{\"drafts\":", int_to_str(local[0]), ",\"generated\":", int_to_str(local[1]),
            ",\"lane_options\":", sr-lane-field(lane, 0), ",\"lane_generated\":", sr-lane-field(lane, 1),
            ",\"lane_injected\":", sr-lane-field(lane, 2),
            "},\"local_share_ppm\":", int_to_str(share), "}"]);
    }
    def sr-row(main, draftLedger) = sr-row-with(main, draftLedger, sr-turn-rows());
}
