//////////////////////////////////////////////////////////////////////
//
// qwen4exp-split-gguf.bml — authority for one logical model carried
// by three GGUF files.
//
// The metadata shard is not a tensor source.  A tensor record always
// carries the concrete data shard, path, local GGUF record offset,
// type, data base, tensor offset, absolute byte offset and byte count.
// That record is exactly sufficient for metal_buf_from_file; no shard
// may be guessed from a logical offset.
//
//////////////////////////////////////////////////////////////////////

package Form.native.qwen4exp;

import Form.kernel.*;
import Form.native.metal.*;

interface IQwen4ExpSplitGGUF [public, witness, reusable] {
   section [public] {
      const int SplitCount = 3;
      const int MetadataShard = 1;
      const int FirstDataShard = 2;
      const int LastDataShard = 3;
      const int MetadataTensorCount = 0;
      const int Shard2TensorCount = 503;
      const int Shard3TensorCount = 721;
      const int TotalTensorCount = 1224;
      const int Alignment = 32;
      const String MappingDoor = "metal_buf_from_file";
      const String RuntimeDependency = "none";

      int SelectShard( int shard2RecordOffset, int shard3RecordOffset ) [abstract];
      bool TensorRecordComplete( Object tensorRecord ) [abstract];
   }
}

class Qwen4ExpSplitGGUF [public, reusable, observable] : IQwen4ExpSplitGGUF {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/qwen4exp-split-gguf.bml";
      const String Model = "Qwen3.8-Flash-Next UD-Q2_K_XL";

      int SelectShard( int shard2RecordOffset, int shard3RecordOffset ) [abstract] {}
      bool TensorRecordComplete( Object tensorRecord ) [abstract] {}
   }
}
