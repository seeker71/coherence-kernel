// fatal-signal-attend.bml — the immune system hears what the seed wrote when a process died by a signal.
//
// The seed appends one organ-health row to .hearth/fatal-signal.jsonl at the moment of death (fatal-signal.bml says what it holds).
// A row that stays in a file attends nobody. This unit hands each retained group (the last 24 hours, one group per signal and
// innermost frame, at most fsg-cap() of them) to the same care every other organ reading takes:
//   - the original row is spoken as `form-organ health {...}` on stderr and enters the framebuffer as an organ-frame-v1 (oh-frame:
//     health 0, the need fatal-signal, the offers request-evidence and revise), exactly as live.bml speaks a step;
//   - oc-hear (organ-care.bml) reads its declared need and answers the attention it deserves: no provider claims a fatal signal
//     (the process is gone; the repair is code), so the state is "unclaimed" and an `organ-attention` row is spoken beside it, the
//     reading the next flow's care and the local-flow-review show.
// fsga-attend(path, now) prints the findings as lines (fsg-review-lines) and speaks the rows; it answers how many groups were heard.
// Nothing here begins a program.
import form-stdlib/organ-care.bml;
import form-stdlib/bml/fatal-signal.bml;
section [form.bml] {
 class FatalSignalAttend {
  def fsga-say(row) {
   let frame = oh-frame(row);
   let wrote = sbt-append("/dev/stderr", "form-organ health " ++ json-emit-precise(row) ++ "\n");
   row;
  }
  def fsga-emit(context, stage, row) = fsga-say(row);
  def fsga-observe(context, reading, delivery) = reading;
  def fsga-row-of(line) = parse-json("organ-health-flow", line);
  def fsga-hear-row(row) {
   let said = fsga-say(row);
   oc-hear(0, row, [], fsga-emit, fsga-observe);
   1;
  }
  def fsga-hear-one(g) {
   let row = fsga-row-of((String) g[0][8]);
   oh-valid(row) ? fsga-hear-row(row) : 0;
  }
  def fsga-hear-all(groups) = foldl((acc, g) => acc + fsga-hear-one(g), 0, groups);
  def fsga-print(lines) = foldl((acc, l) => print_str(l), 0, lines);
  def fsga-attend(path, now) {
   let groups = fsg-groups(path, now);
   let shown = fsga-print(fsg-review-lines(path, now));
   fsga-hear-all(take(fsg-cap(), groups));
  }
 }
}
