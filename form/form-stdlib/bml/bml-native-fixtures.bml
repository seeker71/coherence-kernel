// The BML native compiler's fixture door: observe/bml-native-run.bml runs it,
// and validate reads it through tests/bml-native-fixtures.fk. Each source declares
// its own answer in its head, "Answer: N"; an answer that holds a space is
// quoted. "Units: a.bml b.bml" names the units a source links, files beside it.
// Where the reader stopped short, its own mark answers source/unread and the
// compiler organ says where, so no partial program runs. Its imports heal
// live before it runs; a run whose answer is a refusal is voiced
// by the compiler organ where it runs, and an answer that is not the one the
// source declares is voiced here. A row names its fixture, never the directory
// it was read from, so every kernel reads the same rows from its own working
// directory. It names no preludes of its own: the file that carries it names
// the native compiler's chain first, and a .bml that named those .fk sources
// would hand the section-bearing ones to the walkers unlowered.
section [form.bml] {
 class BmlNativeRun {
  def bnr-fixture-dirs() = ["form-stdlib/tests/fixtures","form/form-stdlib/tests/fixtures"];
  def bnr-dir-of(dirs) = if nil?(dirs) then "" else if fs_is_dir(dirs[0]) then dirs[0] else bnr-dir-of(dirs[1:]);
  def bnr-fixtures-dir() = bnr-dir-of(bnr-fixture-dirs());
  def bnr-after(text,marker) = if (str_find(text,marker,0) < 0) then "" else substring(text,(str_find(text,marker,0) + len(marker)),len(text));
  def bnr-stop?(c) = (((Comparable) c == 32) || (((Comparable) c == 10) || (((Comparable) c == 44) || (((Comparable) c == 13) || ((Comparable) c == 9)))));
  def bnr-token-end(s,i,n) = if (i >= n) then n else if bnr-stop?(str_byte_at(s,i)) then i else bnr-token-end(s,(i + 1),n);
  def bnr-token(s) = substring(s,0,bnr-token-end(s,0,len(s)));
  def bnr-trim-dot(t) = if ((len(t) > 0) && ((Comparable) str_byte_at(t,(len(t) - 1)) == 46)) then substring(t,0,(len(t) - 1)) else t;
  def bnr-unquote(t) = if ((len(t) >= 2) && ((Comparable) str_byte_at(t,0) == 34)) then substring(t,1,(len(t) - 1)) else t;
  def bnr-quote-end(s,i,n) = if (i >= n) then n else if ((Comparable) str_byte_at(s,i) == 34) then i else bnr-quote-end(s,(i + 1),n);
  def bnr-quoted(raw) = substring(raw,1,bnr-quote-end(raw,1,len(raw)));
  def bnr-clean(raw) = if ((len(raw) > 0) && ((Comparable) str_byte_at(raw,0) == 34)) then bnr-quoted(raw) else bnr-unquote(bnr-trim-dot(bnr-token(raw)));
  def bnr-declared(text) {
   let raw = bnr-after(text,"Answer: ");
   if ((Comparable) len(raw) == 0) then "" else bnr-clean(raw);
  }

  def bnr-line-end(s,i,n) = if (i >= n) then n else if ((Comparable) str_byte_at(s,i) == 10) then i else bnr-line-end(s,(i + 1),n);
  def bnr-line(raw) = substring(raw,0,bnr-line-end(raw,0,len(raw)));
  def bnr-slash(s,i) = if (i < 0) then -1 else if ((Comparable) str_byte_at(s,i) == 47) then i else bnr-slash(s,(i - 1));
  def bnr-name(path) = substring(path,(bnr-slash(path,(len(path) - 1)) + 1),len(path));
  def bnr-beside(path,name) = if (bnr-slash(path,(len(path) - 1)) < 0) then name else ((String) substring(path,0,(bnr-slash(path,(len(path) - 1)) + 1)) + name);
  def bnr-unit-nodes(path,names) = if nil?(names) then [] else if ((Comparable) len(names[0]) == 0) then bnr-unit-nodes(path,names[1:]) else cons(bml-source-exec-parse-node(bml-source-file-parse-executable(bnr-beside(path,names[0]))),bnr-unit-nodes(path,names[1:]));
  def bnr-units(path) {
   let raw = bnr-after(read_file(path),"Units: ");
   if ((Comparable) len(raw) == 0) then [] else bnr-unit-nodes(path,split-on(bnr-line(raw)," "));
  }

  // the run's readings carry the fixture's name, the same on every kernel;
  // where the reader stopped short, the reader's own mark says so in the run
  def bnr-value(path) {
   let node = bml-source-exec-parse-node(bml-source-file-parse-executable(path));
   let healed = bml-scope-heal-imports(node,bnr-units(path),empty());
   bml-run-unit-value-at(bnr-name(path),node,healed[0]);
  }
  def bnr-row(state,path,detail) = (state + (" " + (bnr-name(path) + (" " + detail))));
  def bnr-run(path) {
   let declared = bnr-declared(read_file(path));
   if ((Comparable) len(declared) == 0) then "" else bnr-judge(path,declared,bnr-value(path).str());
  }
  def bnr-judge(path,declared,got) = if ((String) got == declared) then bnr-row("ok",path,got) else bnr-differs(path,declared,got);
  def bnr-differs(path,declared,got) {
   oh-voice(bch-reading("fixture",declared,got,[oh-need("declared-answer",json-node-string(bnr-name(path)))],["request-evidence","revise"],bnr-name(path)));
   bnr-row("differs",path,(got + (" declared " + declared)));
  }

  def bnr-stdin-paths(acc) {
   let line = read_line();
   if (nothing?(line) || ((String) line == "")) then reverse-list(acc) else bnr-stdin-paths(cons(line,acc));
  }
  def bnr-fixture?(name) = (((Comparable) str_find(name,"bml-",0) == 0) && (str_find(name,".bml",0) > 0));
  def bnr-fixture-paths(dir,names) = if nil?(names) then [] else if bnr-fixture?(names[0]) then cons((dir + ("/" + names[0])),bnr-fixture-paths(dir,names[1:])) else bnr-fixture-paths(dir,names[1:]);
  def bnr-fixtures() = bnr-fixture-paths(bnr-fixtures-dir(),fs_list(bnr-fixtures-dir()));
  def bnr-rows(paths) = if nil?(paths) then [] else bnr-rows-then(bnr-run(paths[0]),paths[1:]);
  def bnr-rows-then(row,rest) = if ((Comparable) len(row) == 0) then bnr-rows(rest) else cons(row,bnr-rows(rest));
  def bnr-say(rows) = if nil?(rows) then 0 else bnr-say-then(print(rows[0]),rows[1:]);
  def bnr-say-then(said,rest) = bnr-say(rest);
  def bnr-count(rows,state) = if nil?(rows) then 0 else ((if ((Comparable) str_find(rows[0],(state + " "),0) == 0) then 1 else 0) + bnr-count(rows[1:],state));
  def bnr-tally(rows) = (bnr-count(rows,"ok").str() + (" ok of " + len(rows).str()));

  // the door: stdin paths, or every fixture that declares an answer
  def bnr-main() {
   let given = bnr-stdin-paths([]);
   let paths = if nil?(given) then bnr-fixtures() else given;
   let rows = bnr-rows(paths);
   bnr-say(rows);
   bnr-tally(rows);
  }
  // four-way: every fixture, its rows and tally said, the ok count answered
  def bnr-fixtures-main() {
   let rows = bnr-rows(bnr-fixtures());
   bnr-say(rows);
   print(bnr-tally(rows));
   bnr-count(rows,"ok");
  }
 }
 0;
}
