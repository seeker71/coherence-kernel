// The BML native compiler's fixture door: observe/bml-native-run.bml runs it,
// and validate reads it through tests/bml-native-fixtures.fk. Each source declares
// its own answer in its head, "Answer: N"; an answer that holds a space is
// quoted. "Units: a.bml b.bml" names the units a source links, files beside it.
// Where the reader stopped short, its own mark answers source/unread and the
// compiler organ says where, so no partial program runs. Its imports heal
// live before it runs; a run whose answer is a refusal is voiced
// by the compiler organ where it runs, and an answer that is not the one the
// source declares is voiced here. A row names its fixture, never the directory
// it was read from, so every kernel reads the same rows from its own working
// directory. It names no preludes of its own: the file that carries it names
// the native compiler's chain first, and a .bml that named those .fk sources
// would hand the section-bearing ones to the walkers unlowered.
section [form.bml] {
 class BmlNativeRun {
  def bnr-fixture-dirs() = list("form-stdlib/tests/fixtures","form/form-stdlib/tests/fixtures");
  def bnr-dir-of(dirs) = nil?(dirs) ? "" : fs_is_dir(head(dirs)) ? head(dirs) : bnr-dir-of(tail(dirs));
  def bnr-fixtures-dir() = bnr-dir-of(bnr-fixture-dirs());
  def bnr-after(text,marker) = str_find(text,marker,0) < 0 ? "" : substring(text,str_find(text,marker,0) + str_len(marker),str_len(text));
  def bnr-stop?(c) = ((Comparable) c == 32) || (((Comparable) c == 10) || (((Comparable) c == 44) || (((Comparable) c == 13) || ((Comparable) c == 9))));
  def bnr-token-end(s,i,n) = i >= n ? n : bnr-stop?(str_byte_at(s,i)) ? i : bnr-token-end(s,i + 1,n);
  def bnr-token(s) = substring(s,0,bnr-token-end(s,0,str_len(s)));
  def bnr-trim-dot(t) = (str_len(t) > 0) && ((Comparable) str_byte_at(t,str_len(t) - 1) == 46) ? substring(t,0,str_len(t) - 1) : t;
  def bnr-unquote(t) = (str_len(t) >= 2) && ((Comparable) str_byte_at(t,0) == 34) ? substring(t,1,str_len(t) - 1) : t;
  def bnr-quote-end(s,i,n) = i >= n ? n : (Comparable) str_byte_at(s,i) == 34 ? i : bnr-quote-end(s,i + 1,n);
  def bnr-quoted(raw) = substring(raw,1,bnr-quote-end(raw,1,str_len(raw)));
  def bnr-clean(raw) = (str_len(raw) > 0) && ((Comparable) str_byte_at(raw,0) == 34) ? bnr-quoted(raw) : bnr-unquote(bnr-trim-dot(bnr-token(raw)));
  def bnr-declared(text) {
   let raw = bnr-after(text,"Answer: ");
   (Comparable) str_len(raw) == 0 ? "" : bnr-clean(raw);
  }

  def bnr-line-end(s,i,n) = i >= n ? n : (Comparable) str_byte_at(s,i) == 10 ? i : bnr-line-end(s,i + 1,n);
  def bnr-line(raw) = substring(raw,0,bnr-line-end(raw,0,str_len(raw)));
  def bnr-slash(s,i) = i < 0 ? -1 : (Comparable) str_byte_at(s,i) == 47 ? i : bnr-slash(s,i - 1);
  def bnr-name(path) = substring(path,bnr-slash(path,str_len(path) - 1) + 1,str_len(path));
  def bnr-beside(path,name) = bnr-slash(path,str_len(path) - 1) < 0 ? name : substring(path,0,bnr-slash(path,str_len(path) - 1) + 1) ++ name;
  def bnr-unit-nodes(path,names) = nil?(names) ? list() : (Comparable) str_len(head(names)) == 0 ? bnr-unit-nodes(path,tail(names)) : cons(bml-source-exec-parse-node(bml-source-file-parse-executable(bnr-beside(path,head(names)))),bnr-unit-nodes(path,tail(names)));
  def bnr-units(path) {
   let raw = bnr-after(read_file(path),"Units: ");
   (Comparable) str_len(raw) == 0 ? list() : bnr-unit-nodes(path,split-on(bnr-line(raw)," "));
  }

  // the run's readings carry the fixture's name, the same on every kernel;
  // where the reader stopped short, the reader's own mark says so in the run
  def bnr-value(path) {
   let node = bml-source-exec-parse-node(bml-source-file-parse-executable(path));
   let healed = bml-scope-heal-imports(node,bnr-units(path),empty());
   bml-run-unit-value-at(bnr-name(path),node,healed[0]);
  }
  def bnr-row(state,path,detail) = state ++ " " ++ bnr-name(path) ++ " " ++ detail;
  def bnr-run(path) {
   let declared = bnr-declared(read_file(path));
   (Comparable) str_len(declared) == 0 ? "" : bnr-judge(path,declared,value_str(bnr-value(path)));
  }
  def bnr-judge(path,declared,got) = (String) got == declared ? bnr-row("ok",path,got) : bnr-differs(path,declared,got);
  def bnr-differs(path,declared,got) {
   oh-voice(bch-reading("fixture",declared,got,list(oh-need("declared-answer",json-node-string(bnr-name(path)))),list("request-evidence","revise"),bnr-name(path)));
   bnr-row("differs",path,got ++ " declared " ++ declared);
  }

  def bnr-stdin-paths(acc) {
   let line = read_line();
   nothing?(line) || ((String) line == "") ? reverse-list(acc) : bnr-stdin-paths(cons(line,acc));
  }
  def bnr-fixture?(name) = ((Comparable) str_find(name,"bml-",0) == 0) && (str_find(name,".bml",0) > 0);
  def bnr-fixture-paths(dir,names) = nil?(names) ? list() : bnr-fixture?(head(names)) ? cons(dir ++ "/" ++ head(names),bnr-fixture-paths(dir,tail(names))) : bnr-fixture-paths(dir,tail(names));
  def bnr-fixtures() = bnr-fixture-paths(bnr-fixtures-dir(),fs_list(bnr-fixtures-dir()));
  def bnr-rows(paths) = nil?(paths) ? list() : bnr-rows-then(bnr-run(head(paths)),tail(paths));
  def bnr-rows-then(row,rest) = (Comparable) str_len(row) == 0 ? bnr-rows(rest) : cons(row,bnr-rows(rest));
  def bnr-say(rows) = nil?(rows) ? 0 : bnr-say-then(print(head(rows)),tail(rows));
  def bnr-say-then(said,rest) = bnr-say(rest);
  def bnr-count(rows,state) = nil?(rows) ? 0 : (((Comparable) str_find(head(rows),state ++ " ",0) == 0 ? 1 : 0) + bnr-count(tail(rows),state));
  def bnr-tally(rows) = int_to_str(bnr-count(rows,"ok")) ++ " ok of " ++ int_to_str(len(rows));

  // the door: stdin paths, or every fixture that declares an answer
  def bnr-main() {
   let given = bnr-stdin-paths(list());
   let paths = nil?(given) ? bnr-fixtures() : given;
   let rows = bnr-rows(paths);
   bnr-say(rows);
   bnr-tally(rows);
  }
  // four-way: every fixture, its rows and tally said, the ok count answered
  def bnr-fixtures-main() {
   let rows = bnr-rows(bnr-fixtures());
   bnr-say(rows);
   print(bnr-tally(rows));
   bnr-count(rows,"ok");
  }
 }
 0;
}
