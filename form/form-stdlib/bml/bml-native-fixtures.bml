// The BML native compiler's fixture door: observe/bml-native-run.bml runs it,
// and validate reads it through tests/bml-native-fixtures.fk. Each source declares
// its own answer in its head, "Answer: N"; an answer that holds a space is
// quoted. "Units: a.bml b.bml" names the units a source links, files beside it.
// Where the reader stopped short, its own mark answers source/unread and the
// compiler organ says where, so no partial program runs. Its imports heal
// live before it runs; a run whose answer is a refusal is voiced
// by the compiler organ where it runs, and an answer that is not the one the
// source declares is voiced here. A row names its fixture, never the directory
// it was read from, so every kernel reads the same rows from its own working
// directory. It names no preludes of its own: the file that carries it names
// the native compiler's chain first, and a .bml that named those .fk sources
// would hand the section-bearing ones to the walkers unlowered.
section [form.bml] {
 class BmlNativeRun {
  def bnr-fixture-dirs() = list("form-stdlib/tests/fixtures","form/form-stdlib/tests/fixtures");
  def bnr-dir-of(dirs) = if nil?(dirs) then "" else if fs_is_dir(head(dirs)) then head(dirs) else bnr-dir-of(tail(dirs));
  def bnr-fixtures-dir() = bnr-dir-of(bnr-fixture-dirs());
  def bnr-after(text,marker) = if lt(str_find(text,marker,0),0) then "" else substring(text,add(str_find(text,marker,0),str_len(marker)),str_len(text));
  def bnr-stop?(c) = or(eq(c,32),or(eq(c,10),or(eq(c,44),or(eq(c,13),eq(c,9)))));
  def bnr-token-end(s,i,n) = if ge(i,n) then n else if bnr-stop?(str_byte_at(s,i)) then i else bnr-token-end(s,add(i,1),n);
  def bnr-token(s) = substring(s,0,bnr-token-end(s,0,str_len(s)));
  def bnr-trim-dot(t) = if and(gt(str_len(t),0),eq(str_byte_at(t,sub(str_len(t),1)),46)) then substring(t,0,sub(str_len(t),1)) else t;
  def bnr-unquote(t) = if and(ge(str_len(t),2),eq(str_byte_at(t,0),34)) then substring(t,1,sub(str_len(t),1)) else t;
  def bnr-quote-end(s,i,n) = if ge(i,n) then n else if eq(str_byte_at(s,i),34) then i else bnr-quote-end(s,add(i,1),n);
  def bnr-quoted(raw) = substring(raw,1,bnr-quote-end(raw,1,str_len(raw)));
  def bnr-clean(raw) = if and(gt(str_len(raw),0),eq(str_byte_at(raw,0),34)) then bnr-quoted(raw) else bnr-unquote(bnr-trim-dot(bnr-token(raw)));
  def bnr-declared(text) {
   let raw = bnr-after(text,"Answer: ");
   if eq(str_len(raw),0) then "" else bnr-clean(raw);
  }

  def bnr-line-end(s,i,n) = if ge(i,n) then n else if eq(str_byte_at(s,i),10) then i else bnr-line-end(s,add(i,1),n);
  def bnr-line(raw) = substring(raw,0,bnr-line-end(raw,0,str_len(raw)));
  def bnr-slash(s,i) = if lt(i,0) then -1 else if eq(str_byte_at(s,i),47) then i else bnr-slash(s,sub(i,1));
  def bnr-name(path) = substring(path,add(bnr-slash(path,sub(str_len(path),1)),1),str_len(path));
  def bnr-beside(path,name) = if lt(bnr-slash(path,sub(str_len(path),1)),0) then name else str_concat(substring(path,0,add(bnr-slash(path,sub(str_len(path),1)),1)),name);
  def bnr-unit-nodes(path,names) = if nil?(names) then list() else if eq(str_len(head(names)),0) then bnr-unit-nodes(path,tail(names)) else cons(bml-source-exec-parse-node(bml-source-file-parse-executable(bnr-beside(path,head(names)))),bnr-unit-nodes(path,tail(names)));
  def bnr-units(path) {
   let raw = bnr-after(read_file(path),"Units: ");
   if eq(str_len(raw),0) then list() else bnr-unit-nodes(path,split-on(bnr-line(raw)," "));
  }

  // the run's readings carry the fixture's name, the same on every kernel;
  // where the reader stopped short, the reader's own mark says so in the run
  def bnr-value(path) {
   let node = bml-source-exec-parse-node(bml-source-file-parse-executable(path));
   let healed = bml-scope-heal-imports(node,bnr-units(path),empty());
   bml-run-unit-value-at(bnr-name(path),node,nth(healed,0));
  }
  def bnr-row(state,path,detail) = str_concat(state,str_concat(" ",str_concat(bnr-name(path),str_concat(" ",detail))));
  def bnr-run(path) {
   let declared = bnr-declared(read_file(path));
   if eq(str_len(declared),0) then "" else bnr-judge(path,declared,value_str(bnr-value(path)));
  }
  def bnr-judge(path,declared,got) = if str_eq(got,declared) then bnr-row("ok",path,got) else bnr-differs(path,declared,got);
  def bnr-differs(path,declared,got) {
   oh-voice(bch-reading("fixture",declared,got,list(oh-need("declared-answer",json-node-string(bnr-name(path)))),list("request-evidence","revise"),bnr-name(path)));
   bnr-row("differs",path,str_concat(got,str_concat(" declared ",declared)));
  }

  def bnr-stdin-paths(acc) {
   let line = read_line();
   if or(nothing?(line),str_eq(line,"")) then reverse-list(acc) else bnr-stdin-paths(cons(line,acc));
  }
  def bnr-fixture?(name) = and(eq(str_find(name,"bml-",0),0),gt(str_find(name,".bml",0),0));
  def bnr-fixture-paths(dir,names) = if nil?(names) then list() else if bnr-fixture?(head(names)) then cons(str_concat(dir,str_concat("/",head(names))),bnr-fixture-paths(dir,tail(names))) else bnr-fixture-paths(dir,tail(names));
  def bnr-fixtures() = bnr-fixture-paths(bnr-fixtures-dir(),fs_list(bnr-fixtures-dir()));
  def bnr-rows(paths) = if nil?(paths) then list() else bnr-rows-then(bnr-run(head(paths)),tail(paths));
  def bnr-rows-then(row,rest) = if eq(str_len(row),0) then bnr-rows(rest) else cons(row,bnr-rows(rest));
  def bnr-say(rows) = if nil?(rows) then 0 else bnr-say-then(print(head(rows)),tail(rows));
  def bnr-say-then(said,rest) = bnr-say(rest);
  def bnr-count(rows,state) = if nil?(rows) then 0 else add(if eq(str_find(head(rows),str_concat(state," "),0),0) then 1 else 0,bnr-count(tail(rows),state));
  def bnr-tally(rows) = str_concat(int_to_str(bnr-count(rows,"ok")),str_concat(" ok of ",int_to_str(len(rows))));

  // the door: stdin paths, or every fixture that declares an answer
  def bnr-main() {
   let given = bnr-stdin-paths(list());
   let paths = if nil?(given) then bnr-fixtures() else given;
   let rows = bnr-rows(paths);
   bnr-say(rows);
   bnr-tally(rows);
  }
  // four-way: every fixture, its rows and tally said, the ok count answered
  def bnr-fixtures-main() {
   let rows = bnr-rows(bnr-fixtures());
   bnr-say(rows);
   print(bnr-tally(rows));
   bnr-count(rows,"ok");
  }
 }
 0;
}
