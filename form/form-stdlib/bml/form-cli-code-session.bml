// Coding continuations reuse the sealed tokenizer index, not vocabulary scans.
// Existing fcms pending-ID and KV ownership contracts remain authoritative.
// preludes: form-stdlib/form-cli-model-session.fk
section [form.bml] {
 class FormCliCodeSession {
  def fcacs-stops(s, crystal) = list(gmt-u32(fcms-src(s), "tokenizer.ggml.eos_token_id"), crystal[2]);
  def fcacs-segments(pending, stopped, text, crystal) = list(qtlc-id-segment(fcms-crossing-prefix-ids(pending, stopped, crystal[2], 1)), qtlc-id-segment(crystal[6]), qtlc-id-segment(list(crystal[1])), qtlc-text-segment("tool\n"), qtlc-text-segment(text), qtlc-id-segment(list(crystal[2])), qtlc-id-segment(crystal[6]), qtlc-id-segment(list(crystal[1])), qtlc-id-segment(crystal[7]), qtlc-id-segment(list(crystal[3])), qtlc-id-segment(crystal[8]), qtlc-id-segment(list(crystal[4])), qtlc-id-segment(crystal[8]));
  def fcacs-segments-profile(pending,stopped,text,crystal,reasoning) {
   let ordinary = fcacs-segments(pending,stopped,text,crystal);
   reasoning ? append(take(10,ordinary),list(qtlc-id-segment(crystal[6]))) : ordinary;
  }
  def fcacs-ids(s, text, crystal) = fcacs-ids-profile(s,text,crystal,0);
  def fcacs-ids-profile(s,text,crystal,reasoning) = fcmg-live-ids-go(qtlc-open(fcms-path(s),qsx-seal-line(fcms-path(s)),fcacs-segments-profile(fcms-pending(s),q38-stop?(fcms-pending(s),fcacs-stops(s,crystal)),text,crystal,reasoning)),list());
  def fcacs-refuse(s, reason) = fcms-refuse(s,reason);
  def fcacs-observe(s, text) = fcacs-observe-profile(s,text,0);
  def fcacs-observe-profile(s,text,reasoning) {
   let crystal = qsx-load(fcms-path(s));
   !((Comparable) head(crystal) == 1) ? fcacs-refuse(s, "coding-tokenizer-crystal-unavailable") : fcacs-observed(s, fcacs-ids-profile(s,text,crystal,reasoning));
  }
  def fcacs-observed(s, walked) = !((String) head(walked) == "done") ? fcacs-refuse(s, "coding-tokenizer-index-refused") : nil?(walked[2]) ? fcacs-refuse(s,"coding-observation-empty") : fcms-observe-ids(s, reverse(walked[2]), "coding-observation-context-capacity");
  def fcacs-next(s, stops) {
   let pending = fcms-forward(s,fcms-pending(s),fcms-pos(s));
   fcms-with-stream(s, fcms-pos(s) + 1, pending, pending < 0 ? 1 : q38-stop?(pending, stops), fcms-generated-ids(s), fcms-injected-ids(s), fcms-observations(s));
  }
  def fcacs-quantum(s, stops, width) {
   // The coding owner publishes one real progress frame per quantum. Avoid
   // restarting the generic 1/2/4/8 pulse series for every coding chunk.
   let walked = fcms-walk(s, fcms-pending(s), fcms-pos(s), width, stops, list(), width + 1, 1, 0);
   let ids = head(walked);
   fcms-generation("", ids, fcms-with-stream(s, walked[2], walked[1], walked[3], fcms-generated-ids(s) + len(ids), fcms-injected-ids(s), fcms-observations(s)));
  }
 }
 0;
}
