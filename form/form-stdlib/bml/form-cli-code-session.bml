// Coding continuations reuse the sealed tokenizer index, not vocabulary scans.
// Existing fcms pending-ID and KV ownership contracts remain authoritative.
// preludes: form-stdlib/form-cli-model-session.fk
section [form.bml] {
 class FormCliCodeSession {
  def fcacs-stops(s, crystal) = list(gmt-u32(fcms-src(s), "tokenizer.ggml.eos_token_id"), nth(crystal, 2));
  def fcacs-segments(pending, stopped, text, crystal) = list(qtlc-id-segment(fcms-crossing-prefix-ids(pending, stopped, nth(crystal, 2), 1)), qtlc-id-segment(nth(crystal, 6)), qtlc-id-segment(list(nth(crystal, 1))), qtlc-text-segment("tool\n"), qtlc-text-segment(text), qtlc-id-segment(list(nth(crystal, 2))), qtlc-id-segment(nth(crystal, 6)), qtlc-id-segment(list(nth(crystal, 1))), qtlc-id-segment(nth(crystal, 7)), qtlc-id-segment(list(nth(crystal, 3))), qtlc-id-segment(nth(crystal, 8)), qtlc-id-segment(list(nth(crystal, 4))), qtlc-id-segment(nth(crystal, 8)));
  def fcacs-ids(s, text, crystal) = fcmg-live-ids-go(qtlc-open(fcms-path(s), qsx-seal-line(fcms-path(s)), fcacs-segments(fcms-pending(s), q38-stop?(fcms-pending(s), fcacs-stops(s, crystal)), text, crystal)), list());
  def fcacs-refuse(s, reason) = fcms-session("nothing", reason, fcms-path(s), fcms-src(s), fcms-ctx(s), fcms-sts(s), fcms-maxpos(s), fcms-pos(s), fcms-pending(s), fcms-stopped?(s), fcms-prompt-ids(s), fcms-generated-ids(s), fcms-injected-ids(s), fcms-observations(s));
  def fcacs-observe(s, text) {
   let crystal = qsx-load(fcms-path(s));
   if not(eq(head(crystal), 1)) then fcacs-refuse(s, "coding-tokenizer-crystal-unavailable") else fcacs-observed(s, fcacs-ids(s, text, crystal));
  }
  def fcacs-observed(s, walked) = if not(str_eq(head(walked), "done")) then fcacs-refuse(s, "coding-tokenizer-index-refused") else fcms-observe-ids(s, reverse(nth(walked, 2)), "coding-observation-context-capacity");
  def fcacs-next(s, stops) {
   let ctx = fcms-ctx(s);
   let pending = q38-forward(nth(ctx, 0), nth(ctx, 1), nth(ctx, 2), nth(ctx, 3), fcms-sts(s), nth(ctx, 4), nth(ctx, 5), nth(ctx, 6), fcms-pending(s), fcms-pos(s));
   fcms-with-stream(s, add(fcms-pos(s), 1), pending, if lt(pending, 0) then 1 else q38-stop?(pending, stops), fcms-generated-ids(s), fcms-injected-ids(s), fcms-observations(s));
  }
  def fcacs-quantum(s, stops, width) {
   // The coding owner publishes one real progress frame per quantum. Avoid
   // restarting the generic 1/2/4/8 pulse series for every 32-token chunk.
   let walked = fcms-walk(s, fcms-pending(s), fcms-pos(s), width, stops, list(), add(width, 1), 1, 0);
   let ids = head(walked);
   fcms-generation("", ids, fcms-with-stream(s, nth(walked, 2), nth(walked, 1), nth(walked, 3), add(fcms-generated-ids(s), len(ids)), fcms-injected-ids(s), fcms-observations(s)));
  }
 }
 0;
}
