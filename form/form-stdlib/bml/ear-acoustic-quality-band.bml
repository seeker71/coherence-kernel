// Model evidence from public committed PCM and deterministic noise only.
// The live close door is called, not a test-only approximation of its policy.
// preludes: form/form-stdlib/bml/ear-quiet-quality-band.bml form/form-stdlib/bml/ear-acoustic-review.bml
section [form.bml] {
 class EarAcousticQualityBand {
  def eaqb-row(st, pcm, divisor) {
   let quiet = eqq-attenuate(pcm, 0, str_len(pcm), divisor);
   let parts = eqq-chunks(quiet, 0, list());
   let gain = elp-window-gain(eqq-state(parts, elp-born(), 0));
   let cap = add(8, div(str_len(quiet), 2000));
   let te = enw-encode-parts-gain(st, parts, ELWindowBytes(), gain);
   let first = eac-pack(st, enw-transcribe-from2(st, te, 300, cap, -1, list()), 0, 0, gain);
   let result = eac-close(st, parts, str_len(quiet), 0, cap, gain, first);
   let shown = print(list("divisor/open-exact/before-commit/after-commit/review/firstLP/reviewLP/reviewMs", divisor, str_eq(nth(first, 1), "Okay, let's try the guitar."), eac-credible?(first), eac-credible?(head(result)), nth(result, 1), nth(first, 9), nth(result, 4), nth(result, 2)));
   list(first, result);
  }
  def eaqb-run() {
   let snap = str_concat("/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/snapshots/", trim(en-text(read_file("/Users/ursmuff/.cache/huggingface/hub/models--mlx-community--whisper-tiny/refs/main"))));
   let st = enw-open(str_concat(snap, "/weights.npz"), enw-tokenizer-path());
   let bytes = en-text(read_file("form/form-stdlib/tests/fixtures/ear-okay-2s.wav"));
   let pcm = substring(bytes, 44, str_len(bytes));
   let original = eaqb-row(st, pcm, 1);
   let quiet4 = eaqb-row(st, pcm, 4);
   let quiet16 = eaqb-row(st, pcm, 16);
   // Stale PCM cannot leak through the trailing silence or past the window.
   let marked = metal_buf_write(enw-b(st, 0), ELWindowBytes(), "GUARD");
   let parts = eqq-chunks(pcm, 0, list());
   let enc = eac-encode(st, parts, 1000);
   let edge = en-text(metal_buf_read(enw-b(st, 0), sub(ELWindowBytes(), 8), 13));
   let tailClean = str_eq(edge, str_concat(enw-zeros(byte_to_str(0), 8), "GUARD"));
   let noise = enw-dbl(eqq-noise(0, 1600, 42, ""), 64000);
   let noiseRow = eaqb-row(st, noise, 1);
   let challenge = eac-close(st, eqq-chunks(noise, 0, list()), str_len(noise), 0, 64, 1000, head(original));
   let silence = eaqb-row(st, enw-zeros(byte_to_str(0), 64000), 1);
   // A straddling prefix belongs to an earlier segment and is never reviewed.
   let prefixed = cons(str_concat("OLD!", head(parts)), tail(parts));
   let cropped = eac-close(st, prefixed, add(4, str_len(pcm)), 4, 64, nth(head(original), 10), head(original));
   let report = print(list("tail-guard/segment-crop-confirmed/noise-challenge", tailClean, str_eq(nth(cropped, 1), "confirmed"), nth(challenge, 1)));
   eqq-fold(list(
    eq(eac-credible?(head(original)), 0),
    str_eq(nth(nth(original, 1), 1), "confirmed"),
    and(eac-credible?(head(nth(original, 1))), str_eq(nth(head(nth(original, 1)), 1), "Okay, let's try the guitar.")),
    eq(eac-credible?(head(nth(quiet4, 1))), 0),
    eq(eac-credible?(head(nth(quiet16, 1))), 0),
    eq(eac-credible?(head(nth(noiseRow, 1))), 0),
    eq(eac-credible?(head(nth(silence, 1))), 0),
    tailClean,
    and(str_eq(nth(cropped, 1), "confirmed"), str_eq(nth(head(cropped), 1), "Okay, let's try the guitar.")),
    and(eq(eac-credible?(head(challenge)), 0), eq(str_eq(nth(challenge, 1), "confirmed"), 0))
   ), 1, 0);
  }
 }
}
