// Independent scalar meaning for MXFP8 ordered binary64 matrix products.
// E4M3 and E8M0 are evaluated arithmetically; no ISA emitter or matrix recipe
// is imported. Reductions preserve element, group and row order without FMA.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NativeFp64Reference {
  def nfr-power(x,n,acc) = if ((Comparable) n == 0) then acc else nfr-power((x * x),(n / 2),if ((Comparable) (n % 2) == 1) then (acc * x) else acc);
  def nfr-pow2(n) = if (n < 0) then nfr-power(0.5,(0 - n),1.0) else nfr-power(2.0,n,1.0);
  def nfr-e4m3(byte) {
   let magnitude = (byte % 128); let exponent = (magnitude / 8); let mantissa = (magnitude % 8);
   ((if (byte >= 128) then -1.0 else 1.0) * (if ((Comparable) exponent == 0) then (mantissa * 0.001953125) else ((1.0 + (mantissa * 0.125)) * nfr-pow2((exponent - 7)))));
  }
  def nfr-group(data,at,x,left,sum) = if ((Comparable) left == 0) then list(sum,x) else nfr-group(data,(at + 1),tail(x),(left - 1),(sum + (nfr-e4m3(str_byte_at(data,at)) * head(x))));
  def nfr-groups(data,scales,at,x,group,end,sum) = if ((Comparable) group == end) then sum else nfr-next(data,scales,at,group,end,sum,nfr-group(data,at,x,32,0.0));
  def nfr-next(data,scales,at,group,end,sum,part) = nfr-groups(data,scales,(at + 32),nth(part,1),(group + 1),end,(sum + (head(part) * nfr-pow2((str_byte_at(scales,group) - 127)))));
  def nfr-rows(data,scales,cols,row,rows,x,acc) = if ((Comparable) row == rows) then reverse(acc) else nfr-rows(data,scales,cols,(row + 1),rows,x,cons(nfr-groups(data,scales,(row * cols),x,(row * (cols / 32)),((row + 1) * (cols / 32)),0.0),acc));
 }
 0;
}
