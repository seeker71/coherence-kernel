// Independent scalar meaning for MXFP8 ordered binary64 matrix products.
// E4M3 and E8M0 are evaluated arithmetically; no ISA emitter or matrix recipe
// is imported. Reductions preserve element, group and row order without FMA.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NativeFp64Reference {
  def nfr-power(x,n,acc) = if eq(n,0) then acc else nfr-power(mul(x,x),div(n,2),if eq(mod(n,2),1) then mul(acc,x) else acc);
  def nfr-pow2(n) = if lt(n,0) then nfr-power(0.5,sub(0,n),1.0) else nfr-power(2.0,n,1.0);
  def nfr-e4m3(byte) {
   let magnitude = mod(byte,128); let exponent = div(magnitude,8); let mantissa = mod(magnitude,8);
   mul(if ge(byte,128) then -1.0 else 1.0,if eq(exponent,0) then mul(mantissa,0.001953125) else mul(add(1.0,mul(mantissa,0.125)),nfr-pow2(sub(exponent,7))));
  }
  def nfr-group(data,at,x,left,sum) = if eq(left,0) then list(sum,x) else nfr-group(data,add(at,1),tail(x),sub(left,1),add(sum,mul(nfr-e4m3(str_byte_at(data,at)),head(x))));
  def nfr-groups(data,scales,at,x,group,end,sum) = if eq(group,end) then sum else nfr-next(data,scales,at,group,end,sum,nfr-group(data,at,x,32,0.0));
  def nfr-next(data,scales,at,group,end,sum,part) = nfr-groups(data,scales,add(at,32),nth(part,1),add(group,1),end,add(sum,mul(head(part),nfr-pow2(sub(str_byte_at(scales,group),127)))));
  def nfr-rows(data,scales,cols,row,rows,x,acc) = if eq(row,rows) then reverse(acc) else nfr-rows(data,scales,cols,add(row,1),rows,x,cons(nfr-groups(data,scales,mul(row,cols),x,mul(row,div(cols,32)),mul(add(row,1),div(cols,32)),0.0),acc));
 }
 0;
}
