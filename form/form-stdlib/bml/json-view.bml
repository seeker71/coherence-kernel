// Reclaimable JSON projections. Every leaf carries its representation tag;
// primary nodes are borrowed unchanged, never confused with execution values.
// Lists and strings stay visible to the current collector through ordinary
// Form roots. The collector and boxed floating-point pool remain seed-backed.
import form-stdlib/json-precise.bml;
section [form.bml] {
 class JsonView {
  def jv-node(node) = [0,node];
  def jv-object(pairs) = [1,pairs];
  def jv-array(items) = [2,items];
  def jv-string(text) = if json-node-null-value?(text) then jv-null() else [3,text];
  def jv-int(number) = if json-node-null-value?(number) then jv-null() else [4,number];
  def jv-float(number) = [6,number];
  def jv-bool(value) = [7,(!(!value))];
  def jv-null() = [8];
  def jv-kind(view) = if ((Comparable) view[0] == 0) then jv-node-kind(view[1]) else if ((Comparable) view[0] == 5) then 1 else view[0];
  def jv-node-kind(node) = if node_eq(node_category(node),JSON-OBJECT()) then 1 else if node_eq(node_category(node),JSON-ARRAY()) then 2 else if node_eq(node_category(node),JSON-NULL()) then 8 else if ((Comparable) node_type(node) == 2) then 3 else if ((Comparable) node_type(node) == 1) then 4 else if ((Comparable) node_type(node) == 7) then 6 else if ((Comparable) node_type(node) == 3) then 7 else 9;
  def jv-pair(key,value) = [key,value];
  def jv-s(key,text) = jv-pair(key,jv-string(text));
  def jv-n(key,number) = jv-pair(key,jv-int(number));
  def jv-overlay(view,pairs) = [5,view,pairs];
  def jv-base(view) = if ((Comparable) view[0] == 0) then view[1] else if ((Comparable) view[0] == 5) then jv-base(view[1]) else form_error("JSON view has no borrowed node base");
  def jv-wrap(nodes) = if nil?(nodes) then [] else cons(jv-node(nodes[0]),jv-wrap(nodes[1:]));
  def jv-wrap-pairs(pairs) = if nil?(pairs) then [] else cons(jv-pair(json-pair-key(pairs[0]),jv-node(json-pair-value(pairs[0]))),jv-wrap-pairs(pairs[1:]));
  def jv-find(pairs,key) = if nil?(pairs) then [] else if ((String) pairs[0][0] == key) then pairs[0] else jv-find(pairs[1:],key);
  def jv-without(pairs,replacements) = if nil?(pairs) then [] else if (!nil?(jv-find(replacements,pairs[0][0]))) then jv-without(pairs[1:],replacements) else cons(pairs[0],jv-without(pairs[1:],replacements));
  def jv-pairs(view) = if ((Comparable) view[0] == 0) then jv-wrap-pairs(json-object-pairs(view[1])) else if ((Comparable) view[0] == 1) then view[1] else if ((Comparable) view[0] == 5) then append(jv-without(jv-pairs(view[1]),view[2]),view[2]) else form_error("JSON view is not an object");
  def jv-field(view,key) = if (!((Comparable) jv-kind(view) == 1)) then [] else if ((Comparable) view[0] == 5) then jv-overlay-field(view,key,jv-find(view[2],key)) else jv-find(jv-pairs(view),key);
  def jv-overlay-field(view,key,pair) = if nil?(pair) then jv-field(view[1],key) else pair;
  def jv-has(view,key) = (!nil?(jv-field(view,key)));
  def jv-get(view,key) = jv-field-value(jv-field(view,key));
  def jv-field-value(pair) = if nil?(pair) then jv-string("") else pair[1];
  def jv-value(view) = if ((Comparable) view[0] == 0) then node_value(view[1]) else if (((Comparable) view[0] == 3) || (((Comparable) view[0] == 4) || (((Comparable) view[0] == 6) || ((Comparable) view[0] == 7)))) then view[1] else nothing();
  def jv-str(view,key) = jv-value(jv-get(view,key));
  def jv-items(view) = if ((Comparable) view[0] == 0) then jv-wrap(json-array-elements(view[1])) else if ((Comparable) view[0] == 2) then view[1] else [];
  // Current-state updates copy the surviving pairs, not an overlay chain of
  // obsolete revisions. Returned snapshots keep their independent references.
  def jv-set(view,key,value) = jv-object(append(jv-without(jv-pairs(view),[jv-pair(key,value)]),[jv-pair(key,value)]));
  def jv-remove(view,key) = jv-object(jv-without(jv-pairs(view),[jv-pair(key,jv-null())]));
  def jv-equal-items(a,b) = if nil?(a) then nil?(b) else if nil?(b) then 0 else (jv-equal(a[0],b[0]) && jv-equal-items(a[1:],b[1:]));
  def jv-equal-pairs(a,b) = if nil?(a) then nil?(b) else if nil?(b) then 0 else (((String) a[0][0] == b[0][0]) && (jv-equal(a[0][1],b[0][1]) && jv-equal-pairs(a[1:],b[1:])));
  def jv-equal(a,b) = if (((Comparable) a[0] == 0) && ((Comparable) b[0] == 0)) then node_eq(a[1],b[1]) else if (!((Comparable) jv-kind(a) == jv-kind(b))) then 0 else if ((Comparable) jv-kind(a) == 1) then jv-equal-pairs(jv-pairs(a),jv-pairs(b)) else if ((Comparable) jv-kind(a) == 2) then jv-equal-items(jv-items(a),jv-items(b)) else if ((Comparable) jv-kind(a) == 8) then 1 else if ((Comparable) jv-kind(a) == 3) then ((String) jv-value(a) == jv-value(b)) else ((Value) jv-value(a) == jv-value(b));
  def jv-emit-text(parts) = if nil?(parts) then "" else if nil?(parts[1:]) then parts[0] else jv-emit-text-split(parts,(len(parts) / 2));
  def jv-emit-text-split(parts,half) = ((String) jv-emit-text(take(half,parts)) + jv-emit-text(drop(half,parts)));
  def jv-emit-item-parts(items) = if nil?(items) then [] else cons(jv-emit(items[0]),if nil?(items[1:]) then [] else cons(",",jv-emit-item-parts(items[1:])));
  def jv-emit-items(items) = jv-emit-text(jv-emit-item-parts(items));
  def jv-emit-pair-parts(pairs) = if nil?(pairs) then [] else cons(json-quote-string(pairs[0][0]),cons(":",cons(jv-emit(pairs[0][1]),if nil?(pairs[1:]) then [] else cons(",",jv-emit-pair-parts(pairs[1:])))));
  def jv-emit-pairs(pairs) = jv-emit-text(jv-emit-pair-parts(pairs));
  def jv-emit(view) = if ((Comparable) view[0] == 0) then json-emit-precise(view[1]) else if (((Comparable) view[0] == 1) || ((Comparable) view[0] == 5)) then ("{" + (jv-emit-pairs(jv-pairs(view)) + "}")) else if ((Comparable) view[0] == 2) then ("[" + (jv-emit-items(view[1]) + "]")) else if ((Comparable) view[0] == 3) then json-quote-string(view[1]) else if ((Comparable) view[0] == 4) then view[1].str() else if ((Comparable) view[0] == 6) then float-precise-str(view[1]) else if ((Comparable) view[0] == 7) then if view[1] then "true" else "false" else if ((Comparable) view[0] == 8) then "null" else form_error("unknown JSON view kind");
  // Explicit admission into content identity, only for callers asking for nodes.
  def jv-materialize-items(items) = if nil?(items) then [] else cons(jv-materialize(items[0]),jv-materialize-items(items[1:]));
  def jv-materialize-pairs(pairs) = if nil?(pairs) then [] else cons(json-node-pair(pairs[0][0],jv-materialize(pairs[0][1])),jv-materialize-pairs(pairs[1:]));
  def jv-materialize(view) = if ((Comparable) view[0] == 0) then view[1] else if (((Comparable) view[0] == 1) || ((Comparable) view[0] == 5)) then json-node-object(jv-materialize-pairs(jv-pairs(view))) else if ((Comparable) view[0] == 2) then json-node-array(jv-materialize-items(view[1])) else if ((Comparable) view[0] == 3) then json-node-string(view[1]) else if ((Comparable) view[0] == 4) then json-node-int(view[1]) else if ((Comparable) view[0] == 6) then make_float64(view[1]) else if ((Comparable) view[0] == 7) then json-node-bool(view[1]) else if ((Comparable) view[0] == 8) then json-node-null() else form_error("unknown JSON view kind");
 }
 0;
}
