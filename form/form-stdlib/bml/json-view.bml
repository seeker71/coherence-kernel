// Reclaimable JSON projections. Every leaf carries its representation tag;
// primary nodes are borrowed unchanged, never confused with execution values.
// Lists and strings stay visible to the current collector through ordinary
// Form roots. The collector and boxed floating-point pool remain seed-backed.
// preludes: form-stdlib/json-precise.bml
section [form.bml] {
 class JsonView {
  def jv-node(node) = list(0,node);
  def jv-object(pairs) = list(1,pairs);
  def jv-array(items) = list(2,items);
  def jv-string(text) = json-node-null-value?(text) ? jv-null() : list(3,text);
  def jv-int(number) = json-node-null-value?(number) ? jv-null() : list(4,number);
  def jv-float(number) = list(6,number);
  def jv-bool(value) = list(7,!(!value));
  def jv-null() = list(8);
  def jv-kind(view) = (Comparable) head(view) == 0 ? jv-node-kind(view[1]) : (Comparable) head(view) == 5 ? 1 : head(view);
  def jv-node-kind(node) = node_eq(node_category(node),JSON-OBJECT()) ? 1 : node_eq(node_category(node),JSON-ARRAY()) ? 2 : node_eq(node_category(node),JSON-NULL()) ? 8 : (Comparable) node_type(node) == 2 ? 3 : (Comparable) node_type(node) == 1 ? 4 : (Comparable) node_type(node) == 7 ? 6 : (Comparable) node_type(node) == 3 ? 7 : 9;
  def jv-pair(key,value) = list(key,value);
  def jv-s(key,text) = jv-pair(key,jv-string(text));
  def jv-n(key,number) = jv-pair(key,jv-int(number));
  def jv-overlay(view,pairs) = list(5,view,pairs);
  def jv-base(view) = (Comparable) head(view) == 0 ? view[1] : (Comparable) head(view) == 5 ? jv-base(view[1]) : form_error("JSON view has no borrowed node base");
  def jv-wrap(nodes) = nodes |> map(jv-node);
  def jv-wrap-pairs(pairs) = pairs |> map(pair => jv-pair(json-pair-key(pair),jv-node(json-pair-value(pair))));
  def jv-find(pairs,key) = nil?(pairs) ? list() : (String) head(head(pairs)) == key ? head(pairs) : jv-find(tail(pairs),key);
  def jv-without(pairs,replacements) = nil?(pairs) ? list() : !nil?(jv-find(replacements,head(head(pairs)))) ? jv-without(tail(pairs),replacements) : cons(head(pairs),jv-without(tail(pairs),replacements));
  def jv-pairs(view) = match head(view) { 0 => jv-wrap-pairs(json-object-pairs(view[1])), 1 => view[1], 5 => append(jv-without(jv-pairs(view[1]),view[2]),view[2]), _ => form_error("JSON view is not an object") };
  def jv-field(view,key) = !((Comparable) jv-kind(view) == 1) ? list() : (Comparable) head(view) == 5 ? jv-overlay-field(view,key,jv-find(view[2],key)) : jv-find(jv-pairs(view),key);
  def jv-overlay-field(view,key,pair) = nil?(pair) ? jv-field(view[1],key) : pair;
  def jv-has(view,key) = !nil?(jv-field(view,key));
  def jv-get(view,key) = jv-field-value(jv-field(view,key));
  def jv-field-value(pair) = nil?(pair) ? jv-string("") : pair[1];
  def jv-value(view) = match head(view) { 0 => node_value(view[1]), 3 | 4 | 6 | 7 => view[1], _ => nothing() };
  def jv-str(view,key) = jv-value(jv-get(view,key));
  def jv-items(view) = (Comparable) head(view) == 0 ? jv-wrap(json-array-elements(view[1])) : (Comparable) head(view) == 2 ? view[1] : list();
  // Current-state updates copy the surviving pairs, not an overlay chain of
  // obsolete revisions. Returned snapshots keep their independent references.
  def jv-set(view,key,value) = jv-object(append(jv-without(jv-pairs(view),list(jv-pair(key,value))),list(jv-pair(key,value))));
  def jv-remove(view,key) = jv-object(jv-without(jv-pairs(view),list(jv-pair(key,jv-null()))));
  def jv-equal-items(a,b) = nil?(a) ? nil?(b) : nil?(b) ? 0 : (jv-equal(head(a),head(b)) && jv-equal-items(tail(a),tail(b)));
  def jv-equal-pairs(a,b) = nil?(a) ? nil?(b) : nil?(b) ? 0 : (((String) head(head(a)) == head(head(b))) && (jv-equal(head(a)[1],head(b)[1]) && jv-equal-pairs(tail(a),tail(b))));
  def jv-equal(a,b) = ((Comparable) head(a) == 0) && ((Comparable) head(b) == 0) ? node_eq(a[1],b[1]) : !((Comparable) jv-kind(a) == jv-kind(b)) ? 0 : (Comparable) jv-kind(a) == 1 ? jv-equal-pairs(jv-pairs(a),jv-pairs(b)) : (Comparable) jv-kind(a) == 2 ? jv-equal-items(jv-items(a),jv-items(b)) : (Comparable) jv-kind(a) == 8 ? 1 : (Comparable) jv-kind(a) == 3 ? ((String) jv-value(a) == jv-value(b)) : ((Value) jv-value(a) == jv-value(b));
  def jv-emit-text(parts) = nil?(parts) ? "" : nil?(tail(parts)) ? head(parts) : jv-emit-text-split(parts,len(parts) / 2);
  def jv-emit-text-split(parts,half) = jv-emit-text(take(half,parts)) ++ jv-emit-text(drop(half,parts));
  def jv-emit-item-parts(items) = nil?(items) ? list() : cons(jv-emit(head(items)),nil?(tail(items)) ? list() : cons(",",jv-emit-item-parts(tail(items))));
  def jv-emit-items(items) = jv-emit-text(jv-emit-item-parts(items));
  def jv-emit-pair-parts(pairs) = nil?(pairs) ? list() : cons(json-quote-string(head(head(pairs))),cons(":",cons(jv-emit(head(pairs)[1]),nil?(tail(pairs)) ? list() : cons(",",jv-emit-pair-parts(tail(pairs))))));
  def jv-emit-pairs(pairs) = jv-emit-text(jv-emit-pair-parts(pairs));
  def jv-emit(view) = match head(view) { 0 => json-emit-precise(view[1]), 1 | 5 => "{" ++ jv-emit-pairs(jv-pairs(view)) ++ "}", 2 => "[" ++ jv-emit-items(view[1]) ++ "]", 3 => json-quote-string(view[1]), 4 => int_to_str(view[1]), 6 => float-precise-str(view[1]), 7 => (view[1] ? "true" : "false"), 8 => "null", _ => form_error("unknown JSON view kind") };
  // Explicit admission into content identity, only for callers asking for nodes.
  def jv-materialize-items(items) = items |> map(jv-materialize);
  def jv-materialize-pairs(pairs) = pairs |> map(pair => json-node-pair(head(pair),jv-materialize(pair[1])));
  def jv-materialize(view) = match head(view) { 0 => view[1], 1 | 5 => json-node-object(jv-materialize-pairs(jv-pairs(view))), 2 => json-node-array(jv-materialize-items(view[1])), 3 => json-node-string(view[1]), 4 => json-node-int(view[1]), 6 => make_float64(view[1]), 7 => json-node-bool(view[1]), 8 => json-node-null(), _ => form_error("unknown JSON view kind") };
 }
 0;
}
