// Reclaimable JSON projections. Every leaf carries its representation tag;
// primary nodes are borrowed unchanged, never confused with execution values.
// Lists and strings stay visible to the current collector through ordinary
// Form roots. The collector and boxed floating-point pool remain seed-backed.
// preludes: form-stdlib/json-precise.bml
section [form.bml] {
 class JsonView {
  def jv-node(node) = [0,node];
  def jv-object(pairs) = [1,pairs];
  def jv-array(items) = [2,items];
  def jv-string(text) = if json-node-null-value?(text) then jv-null() else [3,text];
  def jv-int(number) = if json-node-null-value?(number) then jv-null() else [4,number];
  def jv-float(number) = [6,number];
  def jv-bool(value) = [7,(!(!value))];
  def jv-null() = [8];
  def jv-kind(view) = if ((Comparable) head(view) == 0) then jv-node-kind(view[1]) else if ((Comparable) head(view) == 5) then 1 else head(view);
  def jv-node-kind(node) = if node_eq(node_category(node),JSON-OBJECT()) then 1 else if node_eq(node_category(node),JSON-ARRAY()) then 2 else if node_eq(node_category(node),JSON-NULL()) then 8 else if ((Comparable) node_type(node) == 2) then 3 else if ((Comparable) node_type(node) == 1) then 4 else if ((Comparable) node_type(node) == 7) then 6 else if ((Comparable) node_type(node) == 3) then 7 else 9;
  def jv-pair(key,value) = [key,value];
  def jv-s(key,text) = jv-pair(key,jv-string(text));
  def jv-n(key,number) = jv-pair(key,jv-int(number));
  def jv-overlay(view,pairs) = list(5,view,pairs);
  def jv-base(view) = (Comparable) head(view) == 0 ? view[1] : (Comparable) head(view) == 5 ? jv-base(view[1]) : form_error("JSON view has no borrowed node base");
  def jv-wrap(nodes) = nodes |> map(jv-node);
  def jv-wrap-pairs(pairs) = pairs |> map(pair => jv-pair(json-pair-key(pair),jv-node(json-pair-value(pair))));
  def jv-find(pairs,key) = nil?(pairs) ? list() : (String) head(head(pairs)) == key ? head(pairs) : jv-find(tail(pairs),key);
  def jv-without(pairs,replacements) = nil?(pairs) ? list() : !nil?(jv-find(replacements,head(head(pairs)))) ? jv-without(tail(pairs),replacements) : cons(head(pairs),jv-without(tail(pairs),replacements));
  def jv-pairs(view) = match head(view) { 0 => jv-wrap-pairs(json-object-pairs(view[1])), 1 => view[1], 5 => append(jv-without(jv-pairs(view[1]),view[2]),view[2]), _ => form_error("JSON view is not an object") };
  def jv-field(view,key) = !((Comparable) jv-kind(view) == 1) ? list() : (Comparable) head(view) == 5 ? jv-overlay-field(view,key,jv-find(view[2],key)) : jv-find(jv-pairs(view),key);
  def jv-overlay-field(view,key,pair) = nil?(pair) ? jv-field(view[1],key) : pair;
  def jv-has(view,key) = !nil?(jv-field(view,key));
  def jv-get(view,key) = jv-field-value(jv-field(view,key));
  def jv-field-value(pair) = if nil?(pair) then jv-string("") else pair[1];
  def jv-value(view) = if ((Comparable) head(view) == 0) then node_value(view[1]) else if (((Comparable) head(view) == 3) || (((Comparable) head(view) == 4) || (((Comparable) head(view) == 6) || ((Comparable) head(view) == 7)))) then view[1] else nothing();
  def jv-str(view,key) = jv-value(jv-get(view,key));
  def jv-items(view) = if ((Comparable) head(view) == 0) then jv-wrap(json-array-elements(view[1])) else if ((Comparable) head(view) == 2) then view[1] else [];
  // Current-state updates copy the surviving pairs, not an overlay chain of
  // obsolete revisions. Returned snapshots keep their independent references.
  def jv-set(view,key,value) = jv-object(append(jv-without(jv-pairs(view),[jv-pair(key,value)]),[jv-pair(key,value)]));
  def jv-remove(view,key) = jv-object(jv-without(jv-pairs(view),[jv-pair(key,jv-null())]));
  def jv-equal-items(a,b) = if nil?(a) then nil?(b) else if nil?(b) then 0 else (jv-equal(head(a),head(b)) && jv-equal-items(tail(a),tail(b)));
  def jv-equal-pairs(a,b) = if nil?(a) then nil?(b) else if nil?(b) then 0 else (((String) head(head(a)) == head(head(b))) && (jv-equal(head(a)[1],head(b)[1]) && jv-equal-pairs(tail(a),tail(b))));
  def jv-equal(a,b) = if (((Comparable) head(a) == 0) && ((Comparable) head(b) == 0)) then node_eq(a[1],b[1]) else if (!((Comparable) jv-kind(a) == jv-kind(b))) then 0 else if ((Comparable) jv-kind(a) == 1) then jv-equal-pairs(jv-pairs(a),jv-pairs(b)) else if ((Comparable) jv-kind(a) == 2) then jv-equal-items(jv-items(a),jv-items(b)) else if ((Comparable) jv-kind(a) == 8) then 1 else if ((Comparable) jv-kind(a) == 3) then ((String) jv-value(a) == jv-value(b)) else ((Value) jv-value(a) == jv-value(b));
  def jv-emit-text(parts) = if nil?(parts) then "" else if nil?(tail(parts)) then head(parts) else jv-emit-text-split(parts,(len(parts) / 2));
  def jv-emit-text-split(parts,half) = str_concat(jv-emit-text(take(half,parts)),jv-emit-text(drop(half,parts)));
  def jv-emit-item-parts(items) = if nil?(items) then [] else cons(jv-emit(head(items)),if nil?(tail(items)) then [] else cons(",",jv-emit-item-parts(tail(items))));
  def jv-emit-items(items) = jv-emit-text(jv-emit-item-parts(items));
  def jv-emit-pair-parts(pairs) = if nil?(pairs) then [] else cons(json-quote-string(head(head(pairs))),cons(":",cons(jv-emit(head(pairs)[1]),if nil?(tail(pairs)) then [] else cons(",",jv-emit-pair-parts(tail(pairs))))));
  def jv-emit-pairs(pairs) = jv-emit-text(jv-emit-pair-parts(pairs));
  def jv-emit(view) = if ((Comparable) head(view) == 0) then json-emit-precise(view[1]) else if (((Comparable) head(view) == 1) || ((Comparable) head(view) == 5)) then str_concat("{",str_concat(jv-emit-pairs(jv-pairs(view)),"}")) else if ((Comparable) head(view) == 2) then str_concat("[",str_concat(jv-emit-items(view[1]),"]")) else if ((Comparable) head(view) == 3) then json-quote-string(view[1]) else if ((Comparable) head(view) == 4) then int_to_str(view[1]) else if ((Comparable) head(view) == 6) then float-precise-str(view[1]) else if ((Comparable) head(view) == 7) then if view[1] then "true" else "false" else if ((Comparable) head(view) == 8) then "null" else form_error("unknown JSON view kind");
  // Explicit admission into content identity, only for callers asking for nodes.
  def jv-materialize-items(items) = items |> map(jv-materialize);
  def jv-materialize-pairs(pairs) = pairs |> map(pair => json-node-pair(head(pair),jv-materialize(pair[1])));
  def jv-materialize(view) = match head(view) { 0 => view[1], 1 | 5 => json-node-object(jv-materialize-pairs(jv-pairs(view))), 2 => json-node-array(jv-materialize-items(view[1])), 3 => json-node-string(view[1]), 4 => json-node-int(view[1]), 6 => make_float64(view[1]), 7 => json-node-bool(view[1]), 8 => json-node-null(), _ => form_error("unknown JSON view kind") };
 }
 0;
}
