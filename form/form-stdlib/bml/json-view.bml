// Reclaimable JSON projections. Every leaf carries its representation tag;
// primary nodes are borrowed unchanged, never confused with execution values.
// Lists and strings stay visible to the current collector through ordinary
// Form roots. The collector and boxed floating-point pool remain seed-backed.
// preludes: form-stdlib/json-precise.bml
section [form.bml] {
 class JsonView {
  def jv-node(node) = list(0,node);
  def jv-object(pairs) = list(1,pairs);
  def jv-array(items) = list(2,items);
  def jv-string(text) = if json-node-null-value?(text) then jv-null() else list(3,text);
  def jv-int(number) = if json-node-null-value?(number) then jv-null() else list(4,number);
  def jv-float(number) = list(6,number);
  def jv-bool(value) = list(7,not(not(value)));
  def jv-null() = list(8);
  def jv-kind(view) = if eq(head(view),0) then jv-node-kind(nth(view,1)) else if eq(head(view),5) then 1 else head(view);
  def jv-node-kind(node) = if node_eq(node_category(node),JSON-OBJECT()) then 1 else if node_eq(node_category(node),JSON-ARRAY()) then 2 else if node_eq(node_category(node),JSON-NULL()) then 8 else if eq(node_type(node),2) then 3 else if eq(node_type(node),1) then 4 else if eq(node_type(node),7) then 6 else if eq(node_type(node),3) then 7 else 9;
  def jv-pair(key,value) = list(key,value);
  def jv-s(key,text) = jv-pair(key,jv-string(text));
  def jv-n(key,number) = jv-pair(key,jv-int(number));
  def jv-overlay(view,pairs) = list(5,view,pairs);
  def jv-base(view) = if eq(head(view),0) then nth(view,1) else if eq(head(view),5) then jv-base(nth(view,1)) else form_error("JSON view has no borrowed node base");
  def jv-wrap(nodes) = if nil?(nodes) then list() else cons(jv-node(head(nodes)),jv-wrap(tail(nodes)));
  def jv-wrap-pairs(pairs) = if nil?(pairs) then list() else cons(jv-pair(json-pair-key(head(pairs)),jv-node(json-pair-value(head(pairs)))),jv-wrap-pairs(tail(pairs)));
  def jv-find(pairs,key) = if nil?(pairs) then list() else if str_eq(head(head(pairs)),key) then head(pairs) else jv-find(tail(pairs),key);
  def jv-without(pairs,replacements) = if nil?(pairs) then list() else if not(nil?(jv-find(replacements,head(head(pairs))))) then jv-without(tail(pairs),replacements) else cons(head(pairs),jv-without(tail(pairs),replacements));
  def jv-pairs(view) = if eq(head(view),0) then jv-wrap-pairs(json-object-pairs(nth(view,1))) else if eq(head(view),1) then nth(view,1) else if eq(head(view),5) then append(jv-without(jv-pairs(nth(view,1)),nth(view,2)),nth(view,2)) else form_error("JSON view is not an object");
  def jv-field(view,key) = if not(eq(jv-kind(view),1)) then list() else if eq(head(view),5) then jv-overlay-field(view,key,jv-find(nth(view,2),key)) else jv-find(jv-pairs(view),key);
  def jv-overlay-field(view,key,pair) = if nil?(pair) then jv-field(nth(view,1),key) else pair;
  def jv-has(view,key) = not(nil?(jv-field(view,key)));
  def jv-get(view,key) = jv-field-value(jv-field(view,key));
  def jv-field-value(pair) = if nil?(pair) then jv-string("") else nth(pair,1);
  def jv-value(view) = if eq(head(view),0) then node_value(nth(view,1)) else if or(eq(head(view),3),or(eq(head(view),4),or(eq(head(view),6),eq(head(view),7)))) then nth(view,1) else nothing();
  def jv-str(view,key) = jv-value(jv-get(view,key));
  def jv-items(view) = if eq(head(view),0) then jv-wrap(json-array-elements(nth(view,1))) else if eq(head(view),2) then nth(view,1) else list();
  // Current-state updates copy the surviving pairs, not an overlay chain of
  // obsolete revisions. Returned snapshots keep their independent references.
  def jv-set(view,key,value) = jv-object(append(jv-without(jv-pairs(view),list(jv-pair(key,value))),list(jv-pair(key,value))));
  def jv-remove(view,key) = jv-object(jv-without(jv-pairs(view),list(jv-pair(key,jv-null()))));
  def jv-equal-items(a,b) = if nil?(a) then nil?(b) else if nil?(b) then 0 else and(jv-equal(head(a),head(b)),jv-equal-items(tail(a),tail(b)));
  def jv-equal-pairs(a,b) = if nil?(a) then nil?(b) else if nil?(b) then 0 else and(str_eq(head(head(a)),head(head(b))),and(jv-equal(nth(head(a),1),nth(head(b),1)),jv-equal-pairs(tail(a),tail(b))));
  def jv-equal(a,b) = if and(eq(head(a),0),eq(head(b),0)) then node_eq(nth(a,1),nth(b,1)) else if not(eq(jv-kind(a),jv-kind(b))) then 0 else if eq(jv-kind(a),1) then jv-equal-pairs(jv-pairs(a),jv-pairs(b)) else if eq(jv-kind(a),2) then jv-equal-items(jv-items(a),jv-items(b)) else if eq(jv-kind(a),8) then 1 else if eq(jv-kind(a),3) then str_eq(jv-value(a),jv-value(b)) else value_eq(jv-value(a),jv-value(b));
  def jv-emit-items(items) = if nil?(items) then "" else str_concat(jv-emit(head(items)),if nil?(tail(items)) then "" else str_concat(",",jv-emit-items(tail(items))));
  def jv-emit-pairs(pairs) = if nil?(pairs) then "" else str_concat(json-quote-string(head(head(pairs))),str_concat(":",str_concat(jv-emit(nth(head(pairs),1)),if nil?(tail(pairs)) then "" else str_concat(",",jv-emit-pairs(tail(pairs))))));
  def jv-emit(view) = if eq(head(view),0) then json-emit-precise(nth(view,1)) else if or(eq(head(view),1),eq(head(view),5)) then str_concat("{",str_concat(jv-emit-pairs(jv-pairs(view)),"}")) else if eq(head(view),2) then str_concat("[",str_concat(jv-emit-items(nth(view,1)),"]")) else if eq(head(view),3) then json-quote-string(nth(view,1)) else if eq(head(view),4) then int_to_str(nth(view,1)) else if eq(head(view),6) then float-precise-str(nth(view,1)) else if eq(head(view),7) then if nth(view,1) then "true" else "false" else if eq(head(view),8) then "null" else form_error("unknown JSON view kind");
  // Explicit admission into content identity, only for callers asking for nodes.
  def jv-materialize-items(items) = if nil?(items) then list() else cons(jv-materialize(head(items)),jv-materialize-items(tail(items)));
  def jv-materialize-pairs(pairs) = if nil?(pairs) then list() else cons(json-node-pair(head(head(pairs)),jv-materialize(nth(head(pairs),1))),jv-materialize-pairs(tail(pairs)));
  def jv-materialize(view) = if eq(head(view),0) then nth(view,1) else if or(eq(head(view),1),eq(head(view),5)) then json-node-object(jv-materialize-pairs(jv-pairs(view))) else if eq(head(view),2) then json-node-array(jv-materialize-items(nth(view,1))) else if eq(head(view),3) then json-node-string(nth(view,1)) else if eq(head(view),4) then json-node-int(nth(view,1)) else if eq(head(view),6) then make_float64(nth(view,1)) else if eq(head(view),7) then json-node-bool(nth(view,1)) else if eq(head(view),8) then json-node-null() else form_error("unknown JSON view kind");
 }
 0;
}
