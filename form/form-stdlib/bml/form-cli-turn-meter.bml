// What each turn of the conversation cost, read by the body from the rented
// mind's own transcript.
//
// The flow meter sums a whole session. A sum cannot say which asking was
// expensive, so it cannot be argued with and it cannot be aimed at. This reads
// the transcript exchange by exchange: a turn opens at a person's own message
// — a tool result is not one — and every provider message that follows belongs
// to it, counted once per message id, since a message spans one row per content
// block and each row repeats the same usage.
//
// Cache reads are separated from the rest throughout: they are the cheapest
// tokens and the largest number, and a total that hides them flatters nothing.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class FormCliTurnMeter {
  def ftm-has?(line, key) = str_find(line, key, 0) >= 0;
  def ftm-assistant?(line) = ftm-has?(line, "\"type\":\"assistant\"");
  def ftm-user?(line) = ftm-has?(line, "\"type\":\"user\"");
  def ftm-tool-result?(line) = ftm-has?(line, "\"type\":\"tool_result\"");
  // A person's own asking, and nothing else: a tool result arrives as a user row,
  // and so do the host's reminders and the notices a background task leaves. Those
  // are the session talking to itself. Only what a person typed opens a turn.
  def ftm-content-at(line) = str_find(line, "\"content\":\"", 0);
  def ftm-content(line) = ftm-content-of(line, ftm-content-at(line));
  def ftm-content-of(line, at) = at < 0 ? "" : substring(line, at + 11, ftm-string-end(line, at + 11));
  def ftm-starts?(text, mark) = (Comparable) str_find(text, mark, 0) == 0;
  def ftm-person?(text) = (!((String) trim(text) == "")) && ((!ftm-starts?(text, "<system-reminder>")) && (!ftm-starts?(text, "<task-notification>")));
  def ftm-asking?(line) = (ftm-user?(line) && (!ftm-tool-result?(line))) && ftm-person?(ftm-content(line));
  def ftm-digit?(ch) = (ch >= 48) && (ch <= 57);
  def ftm-digits(text, i, acc) = (i < str_len(text)) && ftm-digit?(str_byte_at(text, i)) ? ftm-digits(text, i + 1, (acc * 10) + (str_byte_at(text, i) - 48)) : acc;
  def ftm-int-after(text, key, from) { let at = str_find(text, key, from); at < 0 ? 0 : ftm-digits(text, at + str_len(key), 0); }
  def ftm-string-end(line, from) = (from >= str_len(line)) || ((Comparable) str_byte_at(line, from) == 34) ? from : ftm-string-end(line, from + ((Comparable) str_byte_at(line, from) == 92 ? 2 : 1));
  def ftm-message-id(line) { let at = str_find(line, "\"id\":\"msg_", 0); (at < 0) || (at > 600) ? "" : substring(line, at + 6, ftm-string-end(line, at + 6)); }
  def ftm-opening(line) = ftm-cut(ftm-content(line));
  def ftm-cut(text) = str_len(text) > 72 ? substring(text, 0, 72) ++ "…" : text;
  // a turn: opening, provider messages, input, cache write, cache read, output
  def ftm-open(opening) = list(opening, 0, 0, 0, 0, 0);
  def ftm-add(turn, line) = list(turn[0], turn[1] + 1,
   turn[2] + ftm-int-after(line, "\"input_tokens\":", str_find(line, "\"usage\":{", 0)),
   turn[3] + ftm-int-after(line, "\"cache_creation_input_tokens\":", str_find(line, "\"usage\":{", 0)),
   turn[4] + ftm-int-after(line, "\"cache_read_input_tokens\":", str_find(line, "\"usage\":{", 0)),
   turn[5] + ftm-int-after(line, "\"output_tokens\":", str_find(line, "\"usage\":{", 0)));
  def ftm-spoken?(turn) = turn[1] > 0;
  def ftm-close(turns, turn) = ftm-spoken?(turn) ? cons(turn, turns) : turns;
  def ftm-walk(lines, turns, turn, lastId) {
   nil?(lines) ? ftm-close(turns, turn) : ftm-walk-line(tail(lines), turns, turn, lastId, head(lines));
  }
  def ftm-walk-line(rest, turns, turn, lastId, line) {
   ftm-asking?(line) ? ftm-walk(rest, ftm-close(turns, turn), ftm-open(ftm-opening(line)), lastId)
   : !ftm-assistant?(line) ? ftm-walk(rest, turns, turn, lastId)
   : ftm-walk-fresh(rest, turns, turn, lastId, line, ftm-message-id(line));
  }
  def ftm-walk-fresh(rest, turns, turn, lastId, line, id) {
   ((String) id == "") || ((String) id == lastId) ? ftm-walk(rest, turns, turn, lastId) : ftm-walk(rest, turns, ftm-add(turn, line), id);
  }
  def ftm-turns(text) = ftm-reverse(ftm-walk(split-on(text, "\n"), list(), ftm-open(""), ""), list());
  def ftm-reverse(xs, acc) = nil?(xs) ? acc : ftm-reverse(tail(xs), cons(head(xs), acc));
  def ftm-uncached(turn) = (turn[2] + turn[3]) + turn[5];
  def ftm-total(turn) = ftm-uncached(turn) + turn[4];
  def ftm-row(turn, i) = json-node-object(list(
   fhn-n("turn", i),
   fhn-s("asking", turn[0]),
   fhn-n("provider_messages", turn[1]),
   fhn-n("input", turn[2]),
   fhn-n("cache_write", turn[3]),
   fhn-n("cache_read", turn[4]),
   fhn-n("output", turn[5]),
   fhn-n("uncached", ftm-uncached(turn)),
   fhn-n("total", ftm-total(turn))));
  def ftm-rows(turns, i) = nil?(turns) ? list() : cons(ftm-row(head(turns), i), ftm-rows(tail(turns), i + 1));
  def ftm-sum(turns, f) = nil?(turns) ? 0 : (f(head(turns)) + ftm-sum(tail(turns), f));
  def ftm-reading(path) {
   let text = file_size(path) > 0 ? fhn-read(path) : "";
   let turns = ftm-turns(text);
   json-node-object(list(
    fhn-s("transcript", path),
    fhn-n("turns", len(turns)),
    fhn-n("uncached", ftm-sum(turns, ftm-uncached)),
    fhn-n("total", ftm-sum(turns, ftm-total)),
    json-node-pair("per_turn", json-node-array(ftm-rows(turns, 1)))));
  }
 }
}
