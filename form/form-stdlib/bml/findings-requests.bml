  }
  def frq-git-pickaxe-at(head, needle, path) = fhn-capture(["git", "log", "-1", "--format=%H", "-S", needle, head, "--", path]);
  def frq-git-pickaxe(needle, path) = frq-git-pickaxe-at("HEAD", needle, path);
  def frq-git-exists?(rev, path) = frq-git-ok?(["git", "cat-file", "-e", rev ++ ":" ++ path]);
