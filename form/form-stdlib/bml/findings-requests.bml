  def frq-line-start(t, i) = if (i <= 0) then 0 else if ((Comparable) str_byte_at(t, (i - 1)) == 10) then i else frq-line-start(t, (i - 1));
  def frq-lines-code?(t, s, e, marks) = if (s >= e) then false else if frq-code-line?(substring(t, s, frq-line-end(t, s)), marks) then true else frq-lines-code?(t, (frq-line-end(t, s) + 1), e, marks);
