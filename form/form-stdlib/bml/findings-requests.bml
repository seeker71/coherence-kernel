  def frq-name-files(row, g) = if ((String) frq-text(row, "status") == "statement") then frq-put(row, "files", json-node-array(map(f => json-node-string(f), frq-named-files(frq-text(row, "problem"), g)))) else row;
  // ── the pass: every row read again; [rows, readings, fixborns found] ──
  def frq-drop(o, k) = json-node-object(filter(p => !((String) json-pair-key(p) == k), json-object-pairs(o)));
  def frq-pass-row(was, reviews, g) {
