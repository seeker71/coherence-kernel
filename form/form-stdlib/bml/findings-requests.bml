  // ── moot: a band the planner kept reads full on today's files and below full under each stub ──
  def frq-with-moot(rows, id, node) = map(r => if (((String) frq-text(r, "id") == id) && frq-has(["pending", "moved"], frq-text(r, "status"))) then frq-restatus(frq-put(r, "moot", node)) else r, rows);
