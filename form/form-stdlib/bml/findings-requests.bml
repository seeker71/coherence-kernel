  def frq-closed-whole?(r) = if (!((String) frq-text(r, "status") == "closed")) then true else (frq-hex?(frq-text(r, "closed_by")) && frq-some?(frq-text(frq-get(r, "witness"), "needle")) && frq-hex?(frq-text(r, "reviewed")));
  def frq-whole?(r) = ((String) frq-text(r, "id") == frq-id(frq-text(r, "origin"), frq-list(r, "where"), frq-text(r, "problem"))) && ((String) frq-text(r, "status") == frq-status-of(r)) && frq-closed-whole?(r);
