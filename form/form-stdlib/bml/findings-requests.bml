  // ── git, asked by argv only: the reader the door gives the gate ──
  def frq-scratch() = temp_dir() ++ "/frq-git-" ++ host_pid().str();
  // a child's stdout lands in a fresh file (host_capture holds one megabyte; a runtime file is larger)
  def frq-run-out(argv, out) {
   let made = host_dir_mkdir(frq-scratch());
   let gone = host_path_remove(out);
   let pid = host_spawn_at(argv, ["/dev/null", out, "/dev/null"]);
   if (pid <= 0) then -1 else host_wait(pid);
  }
  def frq-git-ok?(argv) = (Comparable) fhn-command(argv) == 0;
  def frq-git-commit?(c) = if frq-hex?(c) then frq-git-ok?(["git", "cat-file", "-e", c ++ "^{commit}"]) else false;
  def frq-git-ancestor?(a, b) = frq-git-ok?(["git", "merge-base", "--is-ancestor", a, b]);
  def frq-git-related?(head, c) = frq-some?(fhn-capture(["git", "merge-base", c, head]));
  def frq-git-blob(rev, path) {
