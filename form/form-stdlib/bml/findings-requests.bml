  def frq-head-of(head, rev) = if ((String) rev == "HEAD") then head else rev;
  def frq-git-at(head) = [frq-git-commit?, (a, b) => frq-git-ancestor?(frq-head-of(head, a), frq-head-of(head, b)), c => frq-git-related?(head, c), (rev, path) => frq-git-blob(frq-head-of(head, rev), path), (needle, path) => frq-git-pickaxe-at(head, needle, path), frq-git-full, frq-git-band, (seen, path) => frq-git-hunks(seen, head, path), (rev, path) => frq-git-exists?(frq-head-of(head, rev), path)];
  def frq-git() = frq-git-at("HEAD");
  // the tip of a unit's commits: the listed commit every other listed commit is an ancestor of
  def frq-git-tip(hashes) {
   let real = frq-unique(filter(frq-git-commit?, hashes), []);
   let tips = filter(h => all?(o => frq-git-ancestor?(o, h), real), real);
   if ((Comparable) len(tips) == 1) then tips[0] else "";
  }
  def frq-unique(xs, seen) = if nil?(xs) then [] else if frq-has(seen, xs[0]) then frq-unique(xs[1:], seen) else cons(xs[0], frq-unique(xs[1:], cons(xs[0], seen)));
  def frq-git-done() = host_dir_rmdir(frq-scratch());
 }
 0;
}
