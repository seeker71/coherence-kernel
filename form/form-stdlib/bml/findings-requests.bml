  def frq-directive?(rest) = any?(d => frq-at?(rest, 0, d), ["PROOF LEVEL", "Verdict", "preludes:", "STAGED CARRIER", "preflight-exec:"]);
  def frq-mark-of(line, marks) = foldl((m, k) => if (frq-some?(m) || (!frq-at?(line, 0, k))) then m else k, "", marks);
  def frq-code-line?(line, marks) {
