  // a band witness: the band runs on fkwu and its verdict carries the bit
  def frq-pow2?(b) = if ((Comparable) b == 1) then true else if ((b < 2) || ((Comparable) (b % 2) == 1)) then false else frq-pow2?((b / 2));
  def frq-band-holds?(w, g) {
