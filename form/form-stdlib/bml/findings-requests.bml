  def frq-witness-node(w) = json-node-object(append([fhn-s("path", frq-text(w, "path")), fhn-s("needle", frq-text(w, "needle")), fhn-n("present", frq-int(w, "present", 1))], if frq-some?(frq-text(w, "band")) then [fhn-s("band", frq-text(w, "band")), fhn-n("bit", frq-int(w, "bit", 0))] else []));
  def frq-put(o, k, v) = if json-object-has?(o, k) then json-node-object(map(p => if ((String) json-pair-key(p) == k) then json-node-pair(k, v) else p, json-object-pairs(o))) else json-node-object(append(json-object-pairs(o), [json-node-pair(k, v)]));
  def frq-note(c) = if frq-some?(frq-text(c, "note")) then json-node-string(frq-text(c, "note")) else json-node-null();
  def frq-closed(row, c, w, commit, seen) = frq-put(frq-put(frq-put(frq-put(frq-put(row, "status", json-node-string("closed")), "closed_by", json-node-string(substring(commit, 0, 9))), "witness", frq-witness-node(w)), "reviewed", json-node-string(seen)), "closed_note", frq-note(c));
  def frq-closure-of(closures, id) = if nil?(closures) then nothing() else if ((String) frq-text(closures[0], "id") == id) then closures[0] else frq-closure-of(closures[1:], id);
