  def frq-fix-node(m, needle, got) = json-node-object([fhn-s("commit", frq-text(got[0], "closed_by")), fhn-s("path", m[1]), fhn-s("needle", needle), fhn-s("span", frq-span-text(m[3])), fhn-s("seen", frq-text(got[0], "reviewed"))]);
  def frq-fix-in(row, m, needles, reviews, g) {
