// Observed call order for the caller-bound expression lane. Each binding runs
// once. Its implementation is opaque: this trace names expression call sites,
// not calls inside a supplied callback or effects inferred from its name.
// preludes: form-stdlib/bml/form-cli-review-execution.bml
section [form.bml] {
 class FormCliReviewTrace {
  // [ordinary execution result, names of bindings actually invoked]
  def fcre-trace-run(prepared,args,bindings) {
   let detail = fcre-trace-detail(prepared,args,bindings);
   list(head(detail),fcre-trace-names(nth(detail,1)));
  }
  def fcre-trace-names(rows) = if nil?(rows) then list() else cons(head(head(rows)),fcre-trace-names(tail(rows)));
  // Each event is [binding name, evaluated arguments, execution result].
  // Retained values stay with the caller; no trace is emitted to the framebuffer.
  def fcre-trace-detail(prepared,args,bindings) = if not(head(prepared)) then list(prepared,list()) else if not(value_eq(nth(nth(prepared,1),2),bindings)) then list(fcre-no("proposal-binding-contract-changed"),list()) else if not(eq(len(args),len(head(nth(prepared,1))))) then list(fcre-no("proposal-call-arity-mismatch"),list()) else fcre-trace-eval(nth(nth(prepared,1),1),fcre-env(head(nth(prepared,1)),args),bindings);
  def fcre-trace-eval(n,env,bindings) = if or(fcre-literal(n),fbl-is?(n,"ident")) then list(fcre-eval(n,env,bindings),list()) else if fbl-is?(n,"if") then fcre-trace-if(node_children(n),env,bindings,fcre-trace-eval(head(node_children(n)),env,bindings)) else fcre-trace-call(fcre-find(bindings,fcre-call-name(n)),fcre-trace-args(tail(node_children(n)),env,bindings));
  def fcre-trace-if(kids,env,bindings,condition) = if not(head(head(condition))) then condition else fcre-trace-join(condition,fcre-trace-eval(if nth(head(condition),1) then nth(kids,1) else nth(kids,2),env,bindings));
  def fcre-trace-join(before,after) = list(head(after),append(nth(before,1),nth(after,1)));
  def fcre-trace-args(ns,env,bindings) = if nil?(ns) then list(fcre-ok(list()),list()) else fcre-trace-arg-next(ns,env,bindings,fcre-trace-eval(head(ns),env,bindings));
  def fcre-trace-arg-next(ns,env,bindings,value) = if not(head(head(value))) then value else fcre-trace-arg-tail(value,fcre-trace-args(tail(ns),env,bindings));
  def fcre-trace-arg-tail(value,rest) = list(if not(head(head(rest))) then head(rest) else fcre-ok(cons(nth(head(value),1),nth(head(rest),1))),append(nth(value,1),nth(rest,1)));
  def fcre-trace-call(binding,args) = if not(head(head(args))) then args else {
   let result = fcre-call(binding,head(args));
   list(result,append(nth(args,1),list(list(head(binding),nth(head(args),1),result))));
  };
 }
 0;
}
