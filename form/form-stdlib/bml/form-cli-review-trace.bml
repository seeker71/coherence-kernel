// Observed call order for the caller-bound expression lane. Each binding runs
// once. Its implementation is opaque: this trace names expression call sites,
// not calls inside a supplied callback or effects inferred from its name.
// preludes: form-stdlib/bml/form-cli-review-execution.bml
section [form.bml] {
 class FormCliReviewTrace {
  // [ordinary execution result, names of bindings actually invoked]
  def fcrt-run(prepared,args,bindings) = if not(head(prepared)) then list(prepared,list()) else if not(value_eq(nth(nth(prepared,1),2),bindings)) then list(fcre-no("proposal-binding-contract-changed"),list()) else if not(eq(len(args),len(head(nth(prepared,1))))) then list(fcre-no("proposal-call-arity-mismatch"),list()) else fcrt-eval(nth(nth(prepared,1),1),fcre-env(head(nth(prepared,1)),args),bindings);
  def fcrt-eval(n,env,bindings) = if or(fcre-literal(n),fbl-is?(n,"ident")) then list(fcre-eval(n,env,bindings),list()) else if fbl-is?(n,"if") then fcrt-if(node_children(n),env,bindings,fcrt-eval(head(node_children(n)),env,bindings)) else fcrt-call(fcre-find(bindings,fcre-call-name(n)),fcrt-args(tail(node_children(n)),env,bindings));
  def fcrt-if(kids,env,bindings,condition) = if not(head(head(condition))) then condition else fcrt-join(condition,fcrt-eval(if nth(head(condition),1) then nth(kids,1) else nth(kids,2),env,bindings));
  def fcrt-join(before,after) = list(head(after),append(nth(before,1),nth(after,1)));
  def fcrt-args(ns,env,bindings) = if nil?(ns) then list(fcre-ok(list()),list()) else fcrt-arg-next(ns,env,bindings,fcrt-eval(head(ns),env,bindings));
  def fcrt-arg-next(ns,env,bindings,value) = if not(head(head(value))) then value else fcrt-arg-tail(value,fcrt-args(tail(ns),env,bindings));
  def fcrt-arg-tail(value,rest) = list(if not(head(head(rest))) then head(rest) else fcre-ok(cons(nth(head(value),1),nth(head(rest),1))),append(nth(value,1),nth(rest,1)));
  def fcrt-call(binding,args) = if not(head(head(args))) then args else {
   let result = fcre-call(binding,head(args));
   list(result,append(nth(args,1),list(head(binding))));
  };
 }
 0;
}
