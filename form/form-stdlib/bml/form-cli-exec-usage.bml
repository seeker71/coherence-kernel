// Read codex exec --json's owned stdout, never prose or nested tool content.
// Each turn.completed carries the turn's aggregate usage; it is counted once
// after a turn.started. This is a different carrier from rollout token_count.
// Whole-stream totals stay unknown on missing, failed or incomplete evidence.
// Retain a separately scoped completed prefix before the first invalid event.
// preludes: form-stdlib/bml/form-cli-remote-token-evidence.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 class FormCliExecUsage {
  def feu-chunk() = 65536;
  def feu-row-limit() = 2097152;
  // thread, open, started, completed, invalid, input, cached, output,
  // cache-write and reasoning (the last two may be nothing).
  def feu-empty() = list("",0,0,0,0,0,0,0,0,0);
  def feu-state(s, thread, opened, started, completed, invalid, input, cached, output, writes, reasoning) = list(thread,opened,started,completed,invalid,input,cached,output,writes,reasoning);
  def feu-bad(s) = !((Comparable) s[4] == 0) ? s : feu-state(s,s[0],s[1],s[2],s[3],1,s[5],s[6],s[7],s[8],s[9]);
  def feu-unreadable(s) = feu-state(s,s[0],s[1],s[2],s[3],2,s[5],s[6],s[7],s[8],s[9]);
  def feu-optional(u,key) = frte-json-nonnegative-int-field?(u,key) ? json-int-value(json-object-get(u,key)) : nothing();
  def feu-optional-valid(u,key) = json-object-has?(u,key) ? frte-json-nonnegative-int-field?(u,key) : 1;
  def feu-plus(a,b) = nothing?(a) || nothing?(b) ? nothing() : (a + b);
  def feu-valid-usage(u) = frte-json-nonnegative-int-field?(u,"input_tokens") && (frte-json-nonnegative-int-field?(u,"cached_input_tokens") && (frte-json-nonnegative-int-field?(u,"output_tokens") && (feu-optional-valid(u,"cache_write_input_tokens") && (feu-optional-valid(u,"reasoning_output_tokens") && ((json-int-value(json-object-get(u,"cached_input_tokens")) <= json-int-value(json-object-get(u,"input_tokens"))) && (json-object-has?(u,"reasoning_output_tokens") ? (json-int-value(json-object-get(u,"reasoning_output_tokens")) <= json-int-value(json-object-get(u,"output_tokens"))) : 1))))));
  def feu-completed(s,u) = (!((Comparable) s[1] == 1)) || (!feu-valid-usage(u)) ? feu-bad(s) : feu-state(s,s[0],0,s[2],s[3] + 1,s[4],s[5] + json-int-value(json-object-get(u,"input_tokens")),s[6] + json-int-value(json-object-get(u,"cached_input_tokens")),s[7] + json-int-value(json-object-get(u,"output_tokens")),feu-plus(s[8],feu-optional(u,"cache_write_input_tokens")),feu-plus(s[9],feu-optional(u,"reasoning_output_tokens")));
  def feu-event(s,row) {
   let kind = frte-json-string-field(row,"type");
   !((Comparable) s[4] == 0) ? s
   : (String) kind == "thread.started" ? ((!((String) s[0] == "")) || ((String) frte-json-string-field(row,"thread_id") == "") ? feu-bad(s) : feu-state(s,frte-json-string-field(row,"thread_id"),s[1],s[2],s[3],s[4],s[5],s[6],s[7],s[8],s[9]))
   : (String) kind == "turn.started" ? (((String) s[0] == "") || ((Comparable) s[1] == 1) ? feu-bad(s) : feu-state(s,s[0],1,s[2] + 1,s[3],s[4],s[5],s[6],s[7],s[8],s[9]))
   : (String) kind == "turn.completed" ? feu-completed(s,frte-json-object-field(row,"usage"))
   : ((String) kind == "turn.failed") || ((String) kind == "error") ? feu-bad(s)
   : (String) kind == "" ? feu-bad(s) : s;
  }
  def feu-line(s,line) = (String) trim(line) == "" ? s : (str_len(line) > feu-row-limit()) || (!jwa-valid(line)) ? feu-bad(s) : feu-event(s,parse-json("codex-exec-event",line));
  def feu-lines(s,text,at) {
   let end = str_find(text,"\n",at);
   end < 0 ? list(s,substring(text,at,str_len(text))) : feu-lines(feu-line(s,substring(text,at,end)),text,end + 1);
  }
  def feu-scan(text) {
   let read = feu-lines(feu-empty(),text,0);
   (String) read[1] == "" ? head(read) : feu-bad(head(read));
  }
  def feu-file(path,size,offset,pending,s) {
   offset >= size ? (!((Comparable) file_size(path) == size) ? feu-unreadable(s) : !((String) pending == "") ? feu-bad(s) : s)
   : feu-slice(path,size,offset,pending,s,read_file_slice(path,offset,feu-chunk() < (size - offset) ? feu-chunk() : (size - offset)));
  }
  def feu-slice(path,size,offset,pending,s,bytes) {
   nothing?(bytes) || ((Comparable) str_len(bytes) == 0) ? feu-unreadable(s) : feu-next(path,size,offset + str_len(bytes),feu-lines(s,pending ++ bytes,0));
  }
  def feu-next(path,size,offset,read) = str_len(read[1]) > feu-row-limit() ? feu-bad(head(read)) : feu-file(path,size,offset,read[1],head(read));
  def feu-complete(s) = (!((String) s[0] == "")) && (((Comparable) s[1] == 0) && (((Comparable) s[4] == 0) && ((s[3] > 0) && ((Comparable) s[2] == s[3]))));
  def feu-number(value) = nothing?(value) ? json-node-null() : json-node-int(value);
  def feu-quantity(s,index) = feu-complete(s) ? feu-number(s[index]) : json-node-null();
  def feu-prefix-observed(s) = (s[4] < 2) && ((!((String) s[0] == "")) && (s[3] > 0));
  def feu-prefix-quantity(s,index) = feu-prefix-observed(s) ? feu-number(s[index]) : json-node-null();
  def feu-prefix-report(s) = json-node-object(list(json-node-pair("status",json-node-string(feu-prefix-observed(s) ? "observed" : "unknown")),json-node-pair("scope",json-node-string("validated completed turns before the first invalid or failed event;excludes any unfinished turn and later events")),json-node-pair("completed_turns",json-node-int(s[3])),json-node-pair("unobserved_remainder",json-node-int(!feu-complete(s))),json-node-pair("input_tokens",feu-prefix-quantity(s,5)),json-node-pair("cached_input_tokens",feu-prefix-quantity(s,6)),json-node-pair("output_tokens",feu-prefix-quantity(s,7)),json-node-pair("cache_write_input_tokens",feu-prefix-quantity(s,8)),json-node-pair("reasoning_output_tokens",feu-prefix-quantity(s,9)),json-node-pair("input_plus_output_tokens",feu-prefix-observed(s) ? json-node-int(s[5] + s[7]) : json-node-null())));
  def feu-report(path,size,s) = json-node-object(list(json-node-pair("schema",json-node-string("form-codex-exec-usage-v1")),json-node-pair("source",json-node-string(path)),json-node-pair("source_bytes",json-node-int(size)),json-node-pair("basis",json-node-string("codex-exec-json;sum-completed-turn-usage")),json-node-pair("status",json-node-string(feu-complete(s) ? "observed" : "incomplete-or-invalid")),json-node-pair("thread_id",json-node-string(s[0])),json-node-pair("started_turns",json-node-int(s[2])),json-node-pair("completed_turns",json-node-int(s[3])),json-node-pair("input_tokens",feu-quantity(s,5)),json-node-pair("cached_input_tokens",feu-quantity(s,6)),json-node-pair("output_tokens",feu-quantity(s,7)),json-node-pair("cache_write_input_tokens",feu-quantity(s,8)),json-node-pair("reasoning_output_tokens",feu-quantity(s,9)),json-node-pair("input_plus_output_tokens",feu-complete(s) ? json-node-int(s[5] + s[7]) : json-node-null()),json-node-pair("completed_prefix_usage",feu-prefix-report(s)),json-node-pair("quality",json-node-string("not-assessed-by-usage-reader"))));
  def feu-read(path) {
   let size = nothing?(path) ? -1 : file_size(path);
   let state = size <= 0 ? feu-bad(feu-empty()) : feu-file(path,size,0,"",feu-empty());
   feu-report(path ?? "",size,state);
  }
 }
 0;
}
