// ontology-emit.bml - what form-stdlib/form-ontology.json generates, emitted in Form.
//
//   dialects          -> the whole text of form-stdlib/dialect-categories.fk
//   engine_constants  -> the two row lets form-stdlib/engine-constants.fk carries
//
// The JSON holds every coordinate; this unit names no number. Dialects emit
// in the byte order of their keys, categories in the order the JSON lists
// them. Door: form/form-stdlib/ontology-emit-run.fk; a scratch copy of its
// output compared with cmp against the carried file folds emitted == carried.
//
import form-stdlib/core.fk;
import form-stdlib/json.fk;

section [form.bml] {
    class OntologyEmit {
        thought ontology-emit-pattern = ["the-json-holds-the-coordinates", "emitted-equals-carried", "keys-in-byte-order"];

        def oe-json-path() = "form/form-stdlib/form-ontology.json";
        def oe-dialect-path() = "form/form-stdlib/dialect-categories.fk";
        def oe-engine-path() = "form/form-stdlib/engine-constants.fk";
        def oe-nl() = byte_to_str(10);
        def oe-quote(s) = (byte_to_str(34) + ((String) s + byte_to_str(34)));
        def oe-root() = parse-json(oe-json-path(), read_file(oe-json-path()));
        def oe-field(obj, key) = json-object-get(obj, key);
        def oe-text(obj, key) = json-string-value(json-object-get(obj, key));
        def oe-number(obj, key) = json-int-value(json-object-get(obj, key));
        def oe-lines(parts) = if ((Comparable) len(parts) == 0) then "" else (parts[0] + ((String) oe-nl() + oe-lines(parts[1:])));
        def oe-join(parts, sep) = if ((Comparable) len(parts) == 0) then "" else if ((Comparable) len(parts[1:]) == 0) then parts[0] else (parts[0] + ((String) sep + oe-join(parts[1:], sep)));

        // byte order of two keys: 1 when a sorts before b
        def oe-before(a, b, i) {
            if (i >= len(b)) then 0
            else if (i >= len(a)) then 1
            else if (str_byte_at(a, i) < str_byte_at(b, i)) then 1
            else if (str_byte_at(a, i) > str_byte_at(b, i)) then 0
            else oe-before(a, b, (i + 1));
        }
        def oe-insert(x, sorted) = if ((Comparable) len(sorted) == 0) then [x] else if ((Comparable) oe-before(x, sorted[0], 0) == 1) then cons(x, sorted) else cons(sorted[0], oe-insert(x, sorted[1:]));
        def oe-sort(xs) = if ((Comparable) len(xs) == 0) then [] else oe-insert(xs[0], oe-sort(xs[1:]));

        // ---- dialect categories: one section per dialect, one let per category ----
        def oe-dialects(root) = oe-field(root, "dialects");
        def oe-dialect-keys(root) = oe-sort(json-object-keys(oe-dialects(root)));
        def oe-categories(d) = json-array-elements(oe-field(d, "categories"));
        def oe-row(d, c) = [(oe-text(d, "name_prefix") + ("-" + oe-text(c, "name"))), oe-number(d, "category_type"), oe-number(c, "inst")];
        def oe-rows-in(d, cs) = if ((Comparable) len(cs) == 0) then [] else cons(oe-row(d, cs[0]), oe-rows-in(d, cs[1:]));
        def oe-rows-of(dialects, keys) = if ((Comparable) len(keys) == 0) then [] else append(oe-rows-in(oe-field(dialects, keys[0]), oe-categories(oe-field(dialects, keys[0]))), oe-rows-of(dialects, keys[1:]));
        def oe-dialect-rows(root) = oe-rows-of(oe-dialects(root), oe-dialect-keys(root));
        def oe-prefixes-of(dialects, keys) = if ((Comparable) len(keys) == 0) then [] else cons((oe-text(oe-field(dialects, keys[0]), "name_prefix") + "-"), oe-prefixes-of(dialects, keys[1:]));
        def oe-dialect-prefixes(root) = oe-prefixes-of(oe-dialects(root), oe-dialect-keys(root));
        def oe-let(row) = ("(let " + (row[0] + (" (intern_trivial_int " + (row[2].str() + "))"))));
        def oe-lets(rows) = if ((Comparable) len(rows) == 0) then [] else cons(oe-let(rows[0]), oe-lets(rows[1:]));
        def oe-section-head(key, d) = ("; " + (key + (" (" + (oe-text(d, "name_prefix") + (") category_type=" + oe-number(d, "category_type").str())))));
        def oe-section(key, d) = cons(oe-section-head(key, d), oe-lets(oe-rows-in(d, oe-categories(d))));
        def oe-sections(dialects, keys) = if ((Comparable) len(keys) == 0) then [] else if ((Comparable) len(keys[1:]) == 0) then oe-section(keys[0], oe-field(dialects, keys[0])) else append(oe-section(keys[0], oe-field(dialects, keys[0])), cons("", oe-sections(dialects, keys[1:])));
        def oe-dialect-header() = [
            "; dialect-categories.fk - generated from form-stdlib/form-ontology.json by form-stdlib/bml/ontology-emit.bml",
            "; per grammar headers (e.g. typescript-bmf.fk): load as prelude before grammars that reference *-BMF-* / BML-AST-* etc.",
            "; values are the 'inst' (with category_type in make_nodeid 1 2 <type> <inst>); intern_trivial_int holds the local id used by intern_node in grammar rules.",
            "; regenerate: ./fkwu form/form-stdlib/ontology-emit-run.fk -- a scratch copy compared with cmp folds emitted == carried.",
            ""];
        def oe-dialect-text(root) = oe-lines(append(oe-dialect-header(), oe-sections(oe-dialects(root), oe-dialect-keys(root))));

        // ---- engine constants: the two row lets engine-constants.fk carries ----
        def oe-entry-name(fam, e) = oe-quote((oe-text(fam, "name_prefix") + ("-" + oe-text(e, "name"))));
        def oe-factory-row(fam, e) = ("(list " + (oe-entry-name(fam, e) + (" " + (oe-quote(oe-text(fam, "factory")) + (" " + (oe-number(e, "value").str() + ")"))))));
        def oe-string-row(fam, e) = ("(list " + (oe-entry-name(fam, e) + (" " + (oe-quote(oe-text(e, "value")) + ")"))));
        def oe-factory?(fam) = if json-object-has?(fam, "factory") then 1 else 0;
        def oe-entry-row(fam, e) = if ((Comparable) oe-factory?(fam) == 1) then oe-factory-row(fam, e) else oe-string-row(fam, e);
        def oe-entry-rows(fam, es) = if ((Comparable) len(es) == 0) then [] else cons(oe-entry-row(fam, es[0]), oe-entry-rows(fam, es[1:]));
        def oe-family-entries(fam) = json-array-elements(oe-field(fam, "entries"));
        def oe-family-rows(families, keys, factory) {
            if ((Comparable) len(keys) == 0) then []
            else if ((Comparable) oe-factory?(oe-field(families, keys[0])) == factory) then append(oe-entry-rows(oe-field(families, keys[0]), oe-family-entries(oe-field(families, keys[0]))), oe-family-rows(families, keys[1:], factory))
            else oe-family-rows(families, keys[1:], factory);
        }

        def oe-engine-let(name, rows) = [("(let " + name), ("    (list " + (oe-join(rows, " ") + "))"))];
        def oe-engine-block(root) {
            let families = oe-field(root, "engine_constants");
            let keys = json-object-keys(families);
            oe-lines(append(oe-engine-let("FOL-ENGINE-FACTORY-ROWS", oe-family-rows(families, keys, 1)), cons("", oe-engine-let("FOL-ENGINE-STRING-ROWS", oe-family-rows(families, keys, 0)))));
        }
    }
}
