// native-turn-manifest.bml — the definitions a gap came to move, read from its goal's "Definition manifest: " line.
//
// A part of the ladder small enough for the local lane to read whole. It needs ntl-first-line (native-turn-ladder.bml).
section [form.bml] {
 class NativeTurnManifest {
  def ntl-manifest-mark() = "\nDefinition manifest: ";
  def ntl-manifest-of(goal) {
   let at = str_find(goal, ntl-manifest-mark(), 0);
   let line = at < 0 ? "" : ntl-first-line(substring(goal, at + len(ntl-manifest-mark()), len(goal)));
   let pieces = split-on(str-join-with(split-on(line, ","), " "), " ");
   at < 0 ? [] : filter(name => (Comparable) len(name) > 0, map(name => trim(name), pieces));
  }
 }
}
