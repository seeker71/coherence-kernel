// Read completed training rows, correlate each with its actual row-start, and
// offer their immutable numeric cells. Timing excludes admission and preparation.
import form-stdlib/bml/form-token-verbs.bml;
import form-stdlib/organ-health.bml;
section [form.bml] {
 class TrainingObservations {
  def tro-number(row, key) {
   let value = oh-get(row, key);
   nothing?(value) || !ftv-num?(node_value(value)) ? nothing() : node_value(value);
  }
  def tro-row(row, starts) {
   let matches = starts |> filter(start => tro-number(start, "pid") == tro-number(row, "pid") && tro-number(start, "line") == tro-number(row, "line") && tro-number(start, "at_ms") <= tro-number(row, "at_ms"));
   let start = nil?(matches) ? nothing() : matches[-1];
   let fields = [tro-number(row, "input_tokens"), tro-number(row, "forward_ms"), tro-number(row, "backward_ms"), nothing?(start) ? nothing() : tro-number(start, "whole_tape_estimated_bytes")];
   any?(value => nothing?(value), fields) ? nothing() : [fields[0], (fields[1] + fields[2]) / 1000.0, fields[3]];
  }
  def tro-read(path) {
   let source = read_file(path);
   nothing?(source) ? nothing() : {
    let events = split-on(source, "\n") |> filter(line => len(trim(line)) > 0) |> map(line => parse-json(path, line));
    let starts = events |> filter(row => oh-str(row, "stage") == "row-start");
    let rows = events |> filter(row => oh-str(row, "stage") == "row") |> map(row => tro-row(row, starts));
    nil?(rows) || any?(value => nothing?(value), rows) ? nothing() : rows;
   };
  }
  def tro-cell(value) = ftv-list?(value) ? intern_node(intern_node(FTV-CATEGORY-ROOT, [intern_trivial_string("list")]), map(tro-cell, value)) : ftv-int?(value) ? intern_trivial_int(value) : make_float64(value);
  def tro-offer(path) {
   let rows = try tro-read(path) catch nothing();
   let data = nothing?(rows) ? nothing() : tro-cell(rows);
   let observed = json-node-object([oh-s("path", path), oh-n("rows", nothing?(rows) ? 0 : len(rows)), oh-s("node", nothing?(data) ? "" : ftv-coord(data)), oh-s("memory_scope", "estimated additional bytes; not measured peak")]);
   oh-voice(oh-reading("training-observations", path, "completed-rows", json-node-string("completed rows with correlated starts"), observed, json-node-int(!nothing?(data)), nothing?(data) ? [oh-need("completed-training-events", json-node-string(path))] : [], ["offer-current-events"], observed));
   nothing?(data) ? nothing() : [rows, data, observed];
  }
 }
 0;
}
