// The interval schedules the next observation, not the lifetime of the work.
// Explicit caller deadlines remain a separate transport contract.
// preludes: form-stdlib/json.fk observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 class FormCliHealDynamic {
  def fhd-min(a, b) = if lt(a, b) then a else b;
  def fhd-max(a, b) = if gt(a, b) then a else b;
  def fhd-action(control, quiet, gap) = if str_eq(control, "stop") then "stop" else if lt(quiet, mul(3, gap)) then "continue" else "inspect";
  def fhd-next(quiet, gap) = fhd-min(30000, fhd-max(1000, if lt(quiet, mul(3, gap)) then mul(3, gap) else mul(2, fhd-max(quiet, gap))));
  def fhd-report(doc) {
   let id = json-int-value(json-object-get(doc, "id"));
   let quiet = json-int-value(json-object-get(doc, "quiet_ms"));
   let gap = fhd-max(1, json-int-value(json-object-get(doc, "progress_gap_ms")));
   let action = fhd-action(json-string-value(json-object-get(doc, "control")), quiet, gap);
   let outbound = bfc-envelope(0, id, 0, list(quiet, gap), 0);
   let sent = bfc-record-out(outbound, quiet);
   let inbound = bfc-control(outbound, if str_eq(action, "stop") then 3 else if str_eq(action, "inspect") then 2 else 1);
   let received = bfc-record-in(inbound, bfc-payload(inbound));
   json-emit(json-node-object(list(json-node-pair("id", json-node-int(id)), json-node-pair("action", json-node-string(action)), json-node-pair("next_observation_ms", json-node-int(fhd-next(quiet, gap))), json-node-pair("correlated", json-node-int(eq(bfc-exchange(outbound), bfc-exchange(inbound)))))));
  }
 }
 0;
}
