// The interval schedules the next observation, not the lifetime of the work.
// Explicit caller deadlines remain a separate transport contract.
// preludes: form-stdlib/json.fk observe/bidirectional-framebuffer-channel.fk form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliHealDynamic {
  def fhd-min(a, b) = a < b ? a : b;
  def fhd-max(a, b) = a > b ? a : b;
  def fhd-action(control, quiet, gap) = (String) control == "stop" ? "stop" : quiet < (3 * gap) ? "continue" : "inspect";
  def fhd-next(quiet, gap) = fhd-min(30000, fhd-max(1000, quiet < (3 * gap) ? (3 * gap) : (2 * fhd-max(quiet, gap))));
  def fhd-report(doc) {
   let id = json-int-value(json-object-get(doc, "id"));
   let quiet = json-int-value(json-object-get(doc, "quiet_ms"));
   let gap = fhd-max(1, json-int-value(json-object-get(doc, "progress_gap_ms")));
   let action = fhd-action(json-string-value(json-object-get(doc, "control")), quiet, gap);
   let outbound = bfc-envelope(0, id, 0, list(quiet, gap), 0);
   let sent = bfc-record-out(outbound, quiet);
   let inbound = bfc-control(outbound, (String) action == "stop" ? 3 : (String) action == "inspect" ? 4 : 0);
   let received = bfc-record-in(inbound, bfc-payload(inbound));
   json-emit(json-node-object(list(json-node-pair("id", json-node-int(id)), json-node-pair("action", json-node-string(action)), json-node-pair("next_observation_ms", json-node-int(fhd-next(quiet, gap))), json-node-pair("correlated", json-node-int((Comparable) bfc-exchange(outbound) == bfc-exchange(inbound))))));
  }
 }
 0;
}
