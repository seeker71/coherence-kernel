// Fixed bulk stream child. No source or request file is generated per call.
// preludes: form/form-stdlib/bml/native-pipe-darwin.bml
section [form.bml] {
 class NativePipeChild {
  def nppc-write(owner,end,bytes,at) {
   if ge(at,str_len(bytes)) then 1 else nppc-wrote(owner,end,bytes,at,npp-write-at(owner,end,bytes,at));
  }
  def nppc-wrote(owner,end,bytes,at,status) {
   if gt(status,0) then nppc-write(owner,end,bytes,add(at,status)) else if eq(status,-4) then nppc-write(owner,end,bytes,at) else npp-refuse(owner,"child stream write");
  }
  def nppc-state() = record_new(0,"header","","expected",-1,"received",0,"bins",list());
  def nppc-empty(state) = and(eq(record_get(state,"expected"),-1),eq(str_len(record_get(state,"header")),0));
  def nppc-loop(owner,input,output,errors,state,handler) {
   let result = npp-read(owner,input,1000);
   if str_eq(head(result),"eof") then if nppc-empty(state) then nppc-finish(owner) else npp-refuse(owner,"incomplete framed request") else if str_eq(head(result),"error") then if eq(nth(result,1),-4) then nppc-loop(owner,input,output,errors,state,handler) else npp-refuse(owner,"child bulk read") else nppc-next(owner,input,output,errors,state,result,handler);
  }
  def nppc-next(owner,input,output,errors,state,result,handler) {
   if str_eq(head(result),"bytes") then nppc-chunk(owner,output,errors,state,handler,nth(result,1)) else 0;
   nppc-loop(owner,input,output,errors,state,handler);
  }
  def nppc-chunk(owner,output,errors,state,handler,bytes) {
   if eq(record_get(state,"expected"),-1) then if eq(str_len(bytes),0) then 1 else nppc-header(owner,output,errors,state,handler,bytes) else nppc-payload(owner,output,errors,state,handler,bytes);
  }
  def nppc-header(owner,output,errors,state,handler,bytes) {
   let header = record_get(state,"header"); let take = min2(sub(8,str_len(header)),str_len(bytes));
   let next = str_concat(header,substring(bytes,0,take)); record_set(state,"header",next);
   if lt(str_len(next),8) then 1 else nppc-header-ready(owner,output,errors,state,handler,substring(bytes,take,str_len(bytes)),npp-frame-size(next));
  }
  def nppc-header-ready(owner,output,errors,state,handler,rest,size) {
   if lt(size,0) then npp-refuse(owner,"framed length overflow") else 0;
   record_set(state,"header",""); record_set(state,"expected",size); record_set(state,"received",0); record_set(state,"bins",list());
   nppc-chunk(owner,output,errors,state,handler,rest);
  }
  def nppc-payload(owner,output,errors,state,handler,bytes) {
   let remaining = sub(record_get(state,"expected"),record_get(state,"received")); let take = min2(remaining,str_len(bytes));
   if gt(take,0) then record_set(state,"bins",fbc-put(record_get(state,"bins"),substring(bytes,0,take))) else 0;
   record_set(state,"received",add(record_get(state,"received"),take));
   if lt(take,remaining) then 1 else nppc-deliver(owner,output,errors,state,handler,substring(bytes,take,str_len(bytes)));
  }
  def nppc-deliver(owner,output,errors,state,handler,rest) {
   let payload = fbc-finish(record_get(state,"bins"),""); record_set(state,"bins",list()); record_set(state,"expected",-1); record_set(state,"received",0);
   handler(owner,output,errors,payload); nppc-chunk(owner,output,errors,state,handler,rest);
  }
  def nppc-echo-frame(owner,output,errors,payload) {
   let bytes = npp-frame(payload);
   nppc-write(owner,output,bytes,0); nppc-write(owner,errors,bytes,0);
  }
  def nppc-run() = nppc-run-with(nppc-echo-frame);
  def nppc-finish(owner) {
   let owned = npp-close(owner); let inherited = if owned then npp-close-borrowed(owner) else 0;
   if and(owned,inherited) then 1 else form_error("worker resource retirement refused");
  }
  def nppc-run-with(handler) {
   let owner = npp-open(); let input = npp-borrow-end(owner,0,"read"); let output = npp-borrow-end(owner,1,"write"); let errors = npp-borrow-end(owner,2,"write");
   record_set(owner,"diagnostic-path","/dev/fd/2");
   let flags = list(npp-fcntl(owner,input,3,0),npp-fcntl(owner,output,3,0),npp-fcntl(owner,errors,3,0));
   if or(npp-flag(head(flags),4),or(npp-flag(nth(flags,1),4),npp-flag(nth(flags,2),4))) then npp-refuse(owner,"child stdio must stay blocking") else 0;
   nppc-loop(owner,input,output,errors,nppc-state(),handler);
  }
 }
 0;
}
