//////////////////////////////////////////////////////////////////////
//
// qwen4exp-flash-next-generate.bml — native token/response contract.
//
// Prompt bytes are tokenized from the GGUF, prompt tokens advance the same
// resident state evaluator used by decode, generated ids feed themselves back,
// EOS stops, and text is decoded from that same artifact.  No server or model
// runtime sits between the Form schedule and Metal.
//
//////////////////////////////////////////////////////////////////////

package Form.native.qwen4exp;

import Form.kernel.*;
import Form.native.metal.*;

interface IQwen4ExpFlashNextGenerate [public, witness, reusable] {
   section [public] {
      const String Schema = "qwen4exp-native-generation-v1";
      const String Runtime = "fkwu-form-metal-jit";
      const String ExternalRuntime = "none";
      const String Server = "none";
      const String Flow = "gguf-tokenize,prefix-evaluate,resident-decode,eos-stop,gguf-decode";
      const int Eos = 248046;

      int Generate( String strPrompt, int nBudget ) [abstract];
      bool Stop( int nToken ) [abstract];
   }
}
class Qwen4ExpFlashNextGenerate [public, reusable, flow, observable] : IQwen4ExpFlashNextGenerate {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/qwen4exp-flash-next-generate.bml";
      const String Model = "Qwen3.8-Flash-Next UD-Q2_K_XL";

      int Generate( String strPrompt, int nBudget ) [abstract] {}
      bool Stop( int nToken ) [abstract] {}
   }
}
