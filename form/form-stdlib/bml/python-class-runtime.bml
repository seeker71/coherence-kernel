// Form-owned flat instance fields and child-first inherited construction.
section [form.bml] {
 class PythonNativeClassRuntime {
  def _py_native_nil(xs) = eq(len(xs),0);
  def _py_native_key(value,key) = if str_eq(value-kind(value),"string") then str_eq(value,key) else 0;
  def _py_native_instance(value) = and(str_eq(value-kind(value),"list"),and(ge(len(value),2),_py_native_key(head(value),"__class__")));
  def _py_native_append(value,item) = if not(str_eq(value-kind(value),"list")) then form_error("native append receiver is not a list") else _py_native_join(value,list(item));
  def _py_native_len(value) = if str_eq(value-kind(value),"string") then str_len(value) else if str_eq(value-kind(value),"list") then if and(gt(len(value),0),_py_native_key(head(value),"__dict__")) then div(sub(len(value),1),2) else len(value) else 0;
  def _py_native_attr(self,key) = if not(str_eq(value-kind(self),"list")) then form_error("native attribute receiver is not a record") else _py_native_fields(self,key);
  def _py_native_fields(fields,key) = if or(_py_native_nil(fields),_py_native_nil(tail(fields))) then form_error("native record field not found") else if _py_native_key(head(fields),key) then head(tail(fields)) else _py_native_fields(tail(tail(fields)),key);
  def _py_native_has(fields,key) = if or(_py_native_nil(fields),_py_native_nil(tail(fields))) then 0 else if _py_native_key(head(fields),key) then 1 else _py_native_has(tail(tail(fields)),key);
  def _py_native_join(left,right) = if _py_native_nil(left) then right else cons(head(left),_py_native_join(tail(left),right));
  def _py_native_merge(child,parent) = if not(and(str_eq(value-kind(child),"list"),str_eq(value-kind(parent),"list"))) then form_error("native inherited fields require records") else _py_native_merge_fields(child,parent);
  def _py_native_merge_fields(child,parent) {
   if or(_py_native_nil(parent),_py_native_nil(tail(parent))) then child else _py_native_merge_pair(child,head(parent),head(tail(parent)),tail(tail(parent)));
  }
  def _py_native_merge_pair(child,key,value,rest) {
   let skip = if not(str_eq(value-kind(key),"string")) then 1 else or(str_eq(key,"__class__"),or(str_eq(key,"__base__"),_py_native_has(child,key)));
   _py_native_merge_fields(if skip then child else _py_native_join(child,list(key,value)),rest);
  }
 }
 0;
}
