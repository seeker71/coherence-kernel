// Form-owned flat instance fields and child-first inherited construction.
section [form.bml] {
 class PythonNativeClassRuntime {
  def _py_native_nil(xs) = ((Comparable) len(xs) == 0);
  def _py_native_key(value,key) = if ((String) value-kind(value) == "string") then ((String) value == key) else 0;
  def _py_native_instance(value) = (((String) value-kind(value) == "list") && ((len(value) >= 2) && _py_native_key(head(value),"__class__")));
  def _py_native_append(value,item) = if (!((String) value-kind(value) == "list")) then form_error("native append receiver is not a list") else _py_native_join(value,list(item));
  def _py_native_len(value) = if ((String) value-kind(value) == "string") then str_len(value) else if ((String) value-kind(value) == "list") then if ((len(value) > 0) && _py_native_key(head(value),"__dict__")) then ((len(value) - 1) / 2) else len(value) else 0;
  def _py_native_attr(self,key) = if (!((String) value-kind(self) == "list")) then form_error("native attribute receiver is not a record") else _py_native_fields(self,key);
  def _py_native_fields(fields,key) = if (_py_native_nil(fields) || _py_native_nil(tail(fields))) then form_error("native record field not found") else if _py_native_key(head(fields),key) then head(tail(fields)) else _py_native_fields(tail(tail(fields)),key);
  def _py_native_has(fields,key) = if (_py_native_nil(fields) || _py_native_nil(tail(fields))) then 0 else if _py_native_key(head(fields),key) then 1 else _py_native_has(tail(tail(fields)),key);
  def _py_native_join(left,right) = if _py_native_nil(left) then right else cons(head(left),_py_native_join(tail(left),right));
  def _py_native_merge(child,parent) = if (!(((String) value-kind(child) == "list") && ((String) value-kind(parent) == "list"))) then form_error("native inherited fields require records") else _py_native_merge_fields(child,parent);
  def _py_native_merge_fields(child,parent) {
   if (_py_native_nil(parent) || _py_native_nil(tail(parent))) then child else _py_native_merge_pair(child,head(parent),head(tail(parent)),tail(tail(parent)));
  }
  def _py_native_merge_pair(child,key,value,rest) {
   let skip = if (!((String) value-kind(key) == "string")) then 1 else (((String) key == "__class__") || (((String) key == "__base__") || _py_native_has(child,key)));
   _py_native_merge_fields(if skip then child else _py_native_join(child,list(key,value)),rest);
  }
 }
 0;
}
