  def hw-carried-writers() = [
   ["receipts/draft-ledger.jsonl", "observe/prompt-draft-run.bml", "fhn-append(ledger, ", hw-row-line()],
   ["receipts/draft-ledger.jsonl", "form/form-stdlib/bml/draft-ledger.bml", "fhn-append(ledger, ", hw-row-line()],
   ["receipts/native-turn-ledger.jsonl", "observe/native-turn-run.bml", "fhn-append(nt-ledger-path(opts), ", hw-row-line()],
   ["receipts/local-flow-review.jsonl", "form/form-stdlib/bml/local-flow-reading.bml", "fhn-append(lfr-ledger(), ", hw-row-line()],
   ["receipts/draft-readings-ledger.jsonl", "observe/draft-readings-to-rows.bml", "fhn-append(receipt, ", hw-row-line()],
   ["receipts/lora-promotion-ledger.jsonl", "observe/lora-lift-run.bml", "fhn-append(ledger, ", hw-row-line()],
   ["receipts/lora-promotion-ledger.jsonl", "observe/qwen-last-block-lift-run.bml", "fhn-append(qlbl-ledger(), ", hw-row-line()],
   ["receipts/exit-proof-ledger.jsonl", "form/form-stdlib/bml/exit-proof.bml", "let row = lrun-row-line(ep-row(", ""],
   ["receipts/offline-voice-gap-register.jsonl", "form/form-stdlib/bml/offline-voice-gaps.bml", "fhn-append(regPath, ", hw-row-line()],
   ["receipts/local-run-ledger.jsonl", "form/form-stdlib/bml/local-run.bml", "ledger-append(path, ", ""],
   ["receipts/query-coverage-ledger.jsonl", "form/form-stdlib/bml/local-run.bml", "ledger-append(path, ", ""],
   ["receipts/session-rent-ledger.jsonl", "form/form-stdlib/bml/session-progress.bml", "ledger-append(sp-ledger(), ", ""],
   ["receipts/self-steer-ledger.jsonl", "form/form-stdlib/bml/self-steer.bml", "fhn-append(ledgerPath, ", hw-row-line()],
   ["receipts/walk-heal-ledger.jsonl", "form/form-stdlib/bml/host-walk-heal.bml", "fhn-append(path, ", hw-row-line()],
   ["receipts/offline-exam-ledger.jsonl", "form/form-stdlib/bml/offline-exam.bml", "fhn-append(ctx[3], ", hw-row-line()],
   ["receipts/alignment-ledger.jsonl", "observe/alignment-read-run.bml", "ledger-append(ar-ledger(), ", ""],
   ["receipts/alignment-axis-ledger.jsonl", "observe/alignment-read-run.bml", "ledger-append(ar-axis-ledger(), ", ""],
   ["receipts/alignment-answers", "form/form-stdlib/bml/offline-exam.bml", "lrun-row-line(oex-answer-row(", ""],
   ["receipts/self-distill-ledger.jsonl", "form/form-stdlib/bml/self-distill.bml", "fhn-append(sd-ledger(opts), ", hw-row-line()],
   ["receipts/self-review-ledger.jsonl", "form/form-stdlib/bml/self-review.bml", "fhn-append(sr-ledger(opts), ", hw-row-line()],
   ["learn/distillation-native-candidates.jsonl", "form/form-stdlib/bml/self-distill.bml", "fhn-append(sd-candidates(opts), ", hw-row-line()],
