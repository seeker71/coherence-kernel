// host-walk-writers.bml — who writes each ledger a landing carries, read by form-stdlib/tests/host-walk-learn-band.bml.
section [form.bml] {
 class HostWalkWriters {
  // who writes each ledger a landing carries, and the sink every row of it passes: [ledger, unit, sink, what follows the sink]. The landing is public, so each row reads the host's home as ~ (ledger.bml lrun-home-free); a typed row passes ledger-append, which routes every row itself. PROOF: form-stdlib/tests/host-walk-learn-band.bml claim home-free
