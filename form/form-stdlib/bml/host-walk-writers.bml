   ["receipts/rent-ledger.jsonl", "form/form-stdlib/bml/provider-turn.bml", "fhn-append(ledger, ", hw-row-line()],
   ["receipts/rent-ledger.jsonl", "form/form-stdlib/bml/form-cli-grounded-synthesis.bml", "fhn-append(path, ", hw-row-line()],
