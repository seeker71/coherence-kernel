// A local Form HTTP peer with observable connection/request counts.
// The configured behavior is the specimen: echo, framing, reuse, stale close,
// or an accepted request that never replies before the router's deadline.
// preludes: form-stdlib/bml/router-proof-io.bml
section [form.bml] {
 class RouterProofFixture {
  def rpf-request(link) {
   let headBytes = rp-until(link, "\r\n\r\n");
   nothing?(headBytes) ? nothing() : rpf-request-head(link, split-on(headBytes, "\r\n"));
  }
  def rpf-request-head(link, lines) {
   let parts = split-on(head(lines), " ");
   let headers = rp-header-pairs(tail(lines));
   let body = rp-take(link, str_to_int(rp-header(headers, "content-length")));
   nothing?(body) ? nothing() : list(head(parts), parts[1], headers, body);
  }
  def rpf-headers-json(headers) = nil?(headers) ? list() : cons(fhn-s(head(head(headers)), head(headers)[1]), rpf-headers-json(tail(headers)));
  def rpf-echo(request) = json-emit-precise(json-node-object(list(fhn-s("method", head(request)), fhn-s("path", request[1]), fhn-s("body", request[3]), json-node-pair("received_headers", json-node-object(rpf-headers-json(request[2]))))));
  def rpf-response(status, contentType, headers, body, connection) = rp-cat(list("HTTP/1.1 ", int_to_str(status), " ", (Comparable) status == 404 ? "Not Found" : "OK", "\r\nContent-Type: ", contentType, "\r\nContent-Length: ", int_to_str(str_len(body)), "\r\nConnection: ", connection, "\r\n", headers, "\r\n", body));
  def rpf-stream-body(path) = (String) path == "/stream/big" ? rp-binary(16777216) : (String) path == "/stream/chunked" ? rp-binary(2304000) : (String) path == "/stream/unframed" ? rp-binary(1280000) : rp-cat(list("before-", "0\r\n\r\n", "-after-", rp-repeat("x", 100000), "-end"));
  def rpf-send-chunks(link, body, offset) = offset >= str_len(body) ? rp-send(link, "0\r\n\r\n") : rpf-send-chunk(link, body, offset, (str_len(body) - offset) > 65536 ? 65536 : (str_len(body) - offset));
  def rpf-send-chunk(link, body, offset, count) {
   let piece = substring(body, offset, offset + count);
   let sent = rp-send(link, rp-cat(list(rp-hex-text(count), "\r\n", piece, "\r\n")));
   sent < 0 ? sent : rpf-send-chunks(link, body, offset + count);
  }
  def rpf-stream(link, path) {
   let body = rpf-stream-body(path);
   let chunked = ((String) path == "/stream/chunked") || ((String) path == "/stream/chunked-trap");
   let closeFramed = (String) path == "/stream/unframed";
   let headBytes = rp-cat(list("HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nConnection: close\r\n", chunked ? "Transfer-Encoding: chunked\r\n" : closeFramed ? "" : rp-cat(list("Content-Length: ", int_to_str(str_len(body)), "\r\n")), "\r\n"));
   let sent = rp-send(link, headBytes);
   sent < 0 ? sent : chunked ? rpf-send-chunks(link, body, 0) : rp-send(link, body);
  }
  def rpf-sample(state) {
   let published = rp-publish(rp-path(record_get(state, "job"), "counts.json"), json-node-object(list(fhn-n("connections", record_get(state, "connections")), fhn-n("requests", record_get(state, "requests")))));
   (Comparable) published == 0 ? 0 : form_error("native fixture count publication refused");
  }
  def rpf-serve(state, link, count) {
   let request = rpf-request(link);
   nothing?(request) ? 0 : rpf-answer(state, link, count, request);
  }
  def rpf-answer(state, link, count, request) {
   record_set(state, "requests", record_get(state, "requests") + 1);
   rpf-sample(state);
   let mode = record_get(state, "mode");
   (String) mode == "hung" ? rpf-hold() : rpf-answer-live(state, link, count, request, mode);
  }
  def rpf-hold() {
   host_sleep_ms(60000);
   rpf-hold();
  }
  def rpf-answer-live(state, link, count, request, mode) {
   let path = request[1];
   (Comparable) str_find(path, "/framing/", 0) == 0 ? rpf-framing-specimen(link, path) : rpf-answer-route(state, link, count, request, mode, path);
  }
  def rpf-framing-specimen(link, path) = rp-send(link, (String) path == "/framing/truncated" ? "HTTP/1.1 200 OK\r\nContent-Length: 8\r\nConnection: close\r\n\r\nabc" : "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nabcXX0\r\n\r\n");
  def rpf-answer-route(state, link, count, request, mode, path) {
   let streaming = (Comparable) str_find(path, "/stream/", 0) == 0;
   let keep = ((String) mode == "keep") || ((String) mode == "stale");
   let echo = (Comparable) str_find(path, "/echo/", 0) == 0;
   let missing = (String) path == "/upstream-missing";
   let body = (String) path == "/relay/body" ? request[3] : echo ? rpf-echo(request) : missing ? "upstream missing" : (String) path == "/api/items" ? rp-cat(list("UPSTREAM method=", head(request), " path=", path)) : rp-cat(list("UPSTREAM path=", path));
   let extra = echo ? "Set-Cookie: echosession=xyz789; Path=/; HttpOnly\r\nCache-Control: no-store\r\nX-Echo-Custom: relayed-ok\r\nTransfer-Encoding: chunked-but-not-really\r\n" : "X-Form-Native-Invitation: upstream-owned\r\n";
   let sent = streaming ? rpf-stream(link, path) : rp-send(link, rpf-response(missing ? 404 : 200, echo ? "application/json" : "text/plain", extra, body, keep ? "keep-alive" : "close"));
   (sent < 0) || (streaming || ((!keep) || (((String) mode == "stale") && ((count + 1) >= 3)))) ? 0 : rpf-serve(state, link, count + 1);
  }
  def rpf-accept(state, listener) {
   let socket = socket_accept(listener);
   socket < 1 ? form_error("native fixture accept refused") : rpf-accepted(state, listener, rp-link(socket));
  }
  def rpf-accepted(state, listener, link) {
   record_set(state, "connections", record_get(state, "connections") + 1);
   rpf-sample(state);
   rpf-serve(state, link, 0);
   rp-close(link);
   rpf-accept(state, listener);
  }
  def rpf-run() {
   let config = parse-json("router-fixture", read_line());
   let job = fhn-string(config, "job");
   let state = record_new(0, "job", job, "mode", fhn-string(config, "mode"), "connections", 0, "requests", 0);
   let listener = socket_listen(0);
   listener < 1 ? form_error("native fixture listener unavailable") : 0;
   rpf-sample(state);
   write_file(rp-path(job, "port"), int_to_str(socket_port(listener)));
   rpf-accept(state, listener);
  }
 }
 0;
}
