// string-lines.bml — the line around a byte index and the leading ASCII run of a
// string, at home in BML over the byte waist (str_byte_at, str_find, substring).
import form-stdlib/core.fk;
section [form.bml] {
    // the first byte of the line holding byte i
    def strl-line-start(s, i) = i <= 0 ? 0 : (Comparable) str_byte_at(s, i - 1) == 10 ? i : strl-line-start(s, i - 1);
    def strl-line-end(s, i) {
        let nl = str_find(s, "\n", i);
        nl < 0 ? str_len(s) : nl;
    }
    def strl-line-cut(s, a, b) = b > a && (Comparable) str_byte_at(s, b - 1) == 13 ? substring(s, a, b - 1) : substring(s, a, b);
    // the whole line holding byte index idx, a trailing CR trimmed; an index
    // outside the string answers nothing (an absent line is not an empty line)
    def strl-line-at(s, idx) = idx < 0 || idx > str_len(s) ? nothing() : strl-line-cut(s, strl-line-start(s, idx), strl-line-end(s, idx));
    def strl-ascii-end(s, i, n) = i < n && (Comparable) str_byte_at(s, i) < 128 ? strl-ascii-end(s, i + 1, n) : i;
    // the longest leading run of bytes below 128
    def strl-ascii-prefix(s) = substring(s, 0, strl-ascii-end(s, 0, str_len(s)));
}
