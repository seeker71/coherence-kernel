// offline-exam.bml — the body's exam with the network denied: five query kinds asked through their real doors and the alignment sets, every ask under sandbox-exec with (deny network*).
//
// The denial is observed, never declared. The door holds a port open on loopback and dials it itself (outside the profile, the control); a witness begun under the same profile file dials it before each
// kind's ask and each set (observe/offline-exam-witness-run.bml). network_denied reads 1 only when the control connected and the witness was refused; otherwise no ask is made and the row says so.
// On a host that is not Darwin the door refuses by name, and no row lands. Fetch and landing stand outside the denial: this door only reads and asks.
//
// model/fixtures/offline-exam/exam.jsonl holds one exam per kind: its door's ask, its floor_ms (the time left that begins it) and cap_ms (the most it may take), and its keys, read from the body at grading:
//   {"path","holds"[,"cites":0][,"line":1][,"leads":"<text>"][,"says":[..]]}   the file stands and holds that text (a key gone from the body fails by name), the answer names the path (cites 0: need not), names it as path:<the line that text stands on today>:, names it right after <text>, and says each word
//   {"returned":"<doc>"}                         the code lane's result: status complete, released, the voice generated, and that document returned as the exam's `after`
//   {"band_open":"<id>","target":"<file>","right":"<file>"}  the plan's result: the queue row names the request, the planner read its option verified with the voice's own ids, its band exits 0 and reads below its full today, and the same band over the right function reads full (fkwu ran both, no model)
// What graded 1 establishes, kind by kind: structural, the definition's true line; lookup, the right file ranked first and its line quoted; prose, the line's two words said back, which is vocabulary and can be negated; code, the exact document, from the voice;
// plan, a band the voice wrote tells a wrong function from a right one. A key establishes only what it checks.
// fkwu grades; no model opens. A row: at_unix_ms, session ("" when the schedule asked), network_denied, kind, exam, answered, graded, rent_tokens 0, wall_ms, status, failed
// (receipts/offline-exam-ledger.jsonl; failed names keys, never words). Answers stay under .hearth/offline-exam; a planted lane's under its planted folder.
// A kind the time left cannot hold lands no row and is named unread; a set is read by observe/alignment-read-run.bml with until_ms and names the scenarios it left. The sets are rotated by the day, so a slow night's last set is another night's first.
//
// Every child stands inside the profile. The asker it names is the exam (session "offline-exam"), so its asks are no row of the schedule's or the person's in the local-run and coverage ledgers; structural is asked cold (FORM_FIND_COLD), since the form-find service answers from outside any profile.
// The plan exam takes a fixture request and a scratch queue, its option's row carries its id (the register's self-plan row reads past it), and its bands leave when graded.
// PROOF: form-stdlib/tests/offline-exam-band.bml.
import form-stdlib/bml/exit-proof.bml;
import form-stdlib/bml/local-run.bml;
import form-stdlib/bml/form-agent-tools.bml;
import form-stdlib/bml/form-agent-json-query.bml;
import form-stdlib/model-registry.bml;
import form-stdlib/string-case.fk;
section [form.bml] {
 class OfflineExam {
  def oex-door() = "offline-exam";
  def oex-exams() = "model/fixtures/offline-exam/exam.jsonl";
  def oex-ledger() = "receipts/offline-exam-ledger.jsonl";
  def oex-home() = ".hearth/offline-exam";
  def oex-sets-dir() = "model/fixtures/alignment";
  def oex-witness-door() = "observe/offline-exam-witness-run.bml";
  def oex-ask-door() = "observe/offline-exam-ask-run.bml";
  def oex-find-door() = "observe/form-find-ask.bml";
  def oex-cli-door() = "form/form-stdlib/form-cli-repl.fk";
  def oex-code-door() = "observe/form-cli-code-run.fk";
  def oex-plan-door() = "observe/local-plan-run.bml";
  def oex-read-door() = "observe/alignment-read-run.bml";
  def oex-profile-text() = "(version 1)\n(allow default)\n(deny network*)\n";
  def oex-say(line) = print_str("[offline-exam] " ++ line);
  def oex-spec() = [["until_ms", "int"], ["kinds", "str"], ["sets", "str"], ["answers", "str"], ["ledger", "str"], ["profile", "str"], ["host", "str"]];
  def oex-opts() = dop-doc(oex-door(), stdin-text(), oex-spec());
  def oex-or(v, dflt) = (String) v == "" ? dflt : v;
  def oex-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  // ---- the keys: read from the body at grading ---------------------------------------------------------------------
  def oex-holds?(path, text) = (Comparable) host_path_exists(path) == 1 && oex-has?(fhn-read(path), text);
  def oex-low(s) = str-lower(s);
  def oex-says-why(key, low) = foldl((acc, w) => (String) acc != "" ? acc : oex-has?(low, oex-low(w)) ? "" : "says:" ++ w, "", ovg-key-words(key));
  def ovg-key-words(key) = fcgp-present?(key, "says") ? map(n => json-string-value(n), json-array-elements(json-object-get(key, "says"))) : [];
  // the 1-based line of a path that first holds the text, read from the body at grading
  def oex-line-no(path, text) = foldl((acc, l) => (Comparable) acc[1] > 0 ? acc : oex-has?(l, text) ? [acc[0], acc[0]] : [acc[0] + 1, 0], [1, 0], split-on(fhn-read(path), "\n"))[1];
  def oex-path-why(key, low) {
   let path = fcgp-str(key, "path");
   !oex-holds?(path, fcgp-str(key, "holds")) ? "key-gone:" ++ path
   : (Comparable) (fcgp-num(key, "cites") ?? 1) == 1 && !oex-has?(low, oex-low(path)) ? "names:" ++ path
   : (Comparable) (fcgp-num(key, "line") ?? 0) == 1 && !oex-has?(low, oex-low(path) ++ ":" ++ oex-line-no(path, fcgp-str(key, "holds")).str() ++ ":") ? "line:" ++ path
   : fcgp-present?(key, "leads") && !oex-has?(low, oex-low(fcgp-str(key, "leads") ++ path)) ? "leads:" ++ path
   : oex-says-why(key, low);
  }
  // the code lane's result line, its one document
  def oex-json-of(answer) = (Comparable) len(trim(answer)) > 0 && faj-valid(trim(answer)) ? parse-json("offline-exam-answer", trim(answer)) : json-node-object([]);
  def oex-returned(result, doc) = foldl((found, d) => (String) fcgp-str(d, "path") == doc ? fcgp-str(d, "text") : found, nothing(), fcgp-present?(result, "documents") ? json-array-elements(json-object-get(result, "documents")) : []);
  def oex-returned-why(exam, key, answer) {
   let r = oex-json-of(answer);
   let doc = fcgp-str(key, "returned");
   let text = oex-returned(r, doc);
   (String) fcgp-str(r, "status") != "complete" ? "status:" ++ oex-or(fcgp-str(r, "status"), "none")
   : (Comparable) (fcgp-num(r, "release_ok") ?? 0) != 1 ? "not-released"
   : (fcgp-num(r, "generated_ids") ?? 0) <= 0 ? "voice-silent"
   : nothing?(text) ? "no-document:" ++ doc
   : (String) text != fcgp-str(exam, "after") ? "document-differs:" ++ doc
   : "";
  }
  // "request=<id> band=<path> full=<n> today=<n> exit=<n> verdict=<word> ids=<n> right=<n>"; a field absent reads ""
  def oex-field(answer, name) {
   let words = filter(w => ep-starts?(w, name ++ "="), split-on(answer, " "));
   nil?(words) ? "" : substring(words[0], len(name) + 1, len(words[0]));
  }
  def oex-digits?(s) = (Comparable) len(s) > 0 && all?(i => str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57, range(0, len(s)));
  def oex-band-why(key, answer) {
   let band = trim(oex-field(answer, "band"));
   let full = trim(oex-field(answer, "full"));
   let today = trim(oex-field(answer, "today"));
   (String) trim(oex-field(answer, "request")) != fcgp-str(key, "band_open") ? "request-differs"
   : (String) band == "" || (Comparable) host_path_exists(band) != 1 ? "no-band"
   : !oex-digits?(full) || !oex-digits?(today) ? "band-unread"
   : str_to_int(today) >= str_to_int(full) ? "band-not-open:" ++ today ++ "/" ++ full
   : (String) trim(oex-field(answer, "exit")) != "0" ? "band-exit:" ++ oex-or(trim(oex-field(answer, "exit")), "none")
   : (String) trim(oex-field(answer, "verdict")) != "verified" ? "plan-not-verified:" ++ oex-or(trim(oex-field(answer, "verdict")), "none")
   : !oex-digits?(trim(oex-field(answer, "ids"))) || (Comparable) str_to_int(trim(oex-field(answer, "ids"))) == 0 ? "voice-silent"
   : (String) trim(oex-field(answer, "right")) != full ? "band-not-turned:" ++ oex-or(trim(oex-field(answer, "right")), "none") ++ "/" ++ full
   : "";
  }
  def oex-key-why(exam, key, answer) = fcgp-present?(key, "returned") ? oex-returned-why(exam, key, answer) : fcgp-present?(key, "band_open") ? oex-band-why(key, answer) : oex-path-why(key, oex-low(answer));
  def oex-keys(exam) = fcgp-present?(exam, "keys") ? json-array-elements(json-object-get(exam, "keys")) : [];
  // the names of the keys an answer misses; an exam with no key reads no-key, never passed
  def oex-failed(exam, answer) = nil?(oex-keys(exam)) ? ["no-key"] : filter(w => (String) w != "", map(k => oex-key-why(exam, k, answer), oex-keys(exam)));
  // ---- the row ---------------------------------------------------------------------------------------------------
  def oex-row(exam, denied, answered, failed, wall, status) = json-node-object([fhn-n("at_unix_ms", now_unix_ms()), fhn-s("session", lrun-session()), fhn-n("network_denied", denied), fhn-s("kind", fcgp-str(exam, "kind")), fhn-s("exam", fcgp-str(exam, "id")), fhn-n("answered", answered ? 1 : 0), fhn-n("graded", answered && nil?(failed) ? 1 : 0), fhn-n("rent_tokens", 0), fhn-n("wall_ms", wall), fhn-s("status", status), fhn-s("failed", str-join-with(failed, ","))]);
  // ---- under the profile --------------------------------------------------------------------------------------
  def oex-denied(profile, door) = ["env", "CLAUDE_CODE_SESSION_ID=offline-exam", "FORM_FIND_COLD=1", "sandbox-exec", "-f", profile, "./fkwu", door];
  def oex-control(port) = socket_connect("127.0.0.1", port) >= 0;
  // [1 or 0, what it read]
  def oex-witness(ctx, step) {
   let run = hch-run-in(ctx[0], "witness-" ++ step, oex-denied(ctx[1], oex-witness-door()), ctx[2].str() ++ "\n", hch-by(120000));
   let control = oex-control(ctx[2]);
   !control ? [0, "the control could not dial its own port"]
   : hch-ok?(run) && oex-has?(run[1], "[witness] refused") ? [1, "refused"]
   : [0, oex-has?(run[1], "[witness] connected") ? "the witness connected" : "the witness did not read (exit " ++ hch-status-text(run) ++ ")"];
  }
  def oex-text(run) = trim(hch-said(run));
  def oex-ran(run) = hch-ok?(run) ? "answered" : "exit " ++ hch-status-text(run) ++ ((String) run[2] == "" ? "" : " " ++ run[2]);
  def oex-spoke(run) = (String) oex-ran(run) == "answered" && (Comparable) len(oex-text(run)) == 0 ? "empty" : oex-ran(run);
  // ---- each kind through its own door: [status, answer] --------------------------------------------------------
  def oex-ask-structural(ctx, exam, until) { let run = hch-run-in(ctx[0], "structural", oex-denied(ctx[1], oex-find-door()), fcgp-str(exam, "ask") ++ "\n", until); [oex-spoke(run), oex-text(run)]; }
  def oex-ask-lookup(ctx, exam, until) { let run = hch-run-in(ctx[0], "lookup", oex-denied(ctx[1], oex-cli-door()), "ask " ++ fcgp-str(exam, "ask") ++ "\nquit\n", until); [oex-spoke(run), oex-text(run)]; }
  def oex-line-of(path, text) = foldl((found, l) => (String) found == "" && oex-has?(l, text) ? trim(l) : found, "", split-on((Comparable) host_path_exists(path) == 1 ? fhn-read(path) : "", "\n"));
  def oex-packet(exam) {
   let g = fcgp-obj(exam, "ground");
   "Line of " ++ fcgp-str(g, "path") ++ ": " ++ oex-line-of(fcgp-str(g, "path"), fcgp-str(g, "holds")) ++ "\n\n" ++ fcgp-str(exam, "ask");
  }
  def oex-ask-prose(ctx, exam, until) {
   let out = ctx[0] ++ "/prose.answer";
   let cleared = host_path_remove(out);
   let run = hch-run-in(ctx[0], "prose", oex-denied(ctx[1], oex-ask-door()), json-emit(json-node-object([fhn-s("packet", oex-packet(exam)), fhn-s("enquiry", fcgp-str(exam, "ask")), fhn-s("out", out), fhn-n("reply_budget", 256)])) ++ "\n", until);
   let said = read_file(out) ?? "";
   let at = str_find(said, "\n", 0);
   at < 0 ? [(String) oex-ran(run) == "answered" ? "no-answer-file" : oex-ran(run), ""] : [substring(said, 0, at), trim(substring(said, at + 1, len(said)))];
  }
  def oex-code-check(exam) {
   let doc = fcgp-str(exam, "doc");
   let tail = ["-n", "1", doc];
   json-node-object([fhn-s("tool", "tail"), json-node-pair("arguments", json-node-array(map(a => json-node-string(a), tail))), fhn-s("stdout", fat-out(fat-call([[doc, doc, fcgp-str(exam, "after")]], "tail", tail, "")))]);
  }
  def oex-code-voice() = mr-chain-names("write-code")[0];
  def oex-code-request(exam) = json-node-object([fhn-s("goal", fcgp-str(exam, "goal")), json-node-pair("documents", json-node-array([json-node-object([fhn-s("id", fcgp-str(exam, "doc")), fhn-s("path", fcgp-str(exam, "doc")), fhn-s("text", fcgp-str(exam, "before"))])])), json-node-pair("writable", json-node-array([json-node-string(fcgp-str(exam, "doc"))])), json-node-pair("checks", json-node-array([oex-code-check(exam)])), fhn-s("model", oex-code-voice()), fhn-n("context", 8192), fhn-n("turns", 8), fhn-s("document_context", "full"), fhn-s("code_entry", "direct"), fhn-n("weight_training", 0)]);
  def oex-code-line(text) = foldl((found, l) => oex-has?(l, "\"schema\":\"form-native-code-v1\"") ? trim(l) : found, "", split-on(text, "\n"));
  def oex-ask-code(ctx, exam, until) {
   let req = ctx[0] ++ "/code.request.json";
   let wrote = write_file_text(req, json-emit(oex-code-request(exam)));
   let run = hch-run-in(ctx[0], "code", oex-denied(ctx[1], oex-code-door()), "@" ++ req ++ "\n", until);
   let line = oex-code-line(run[1]);
   [(String) line == "" ? oex-ran(run) : (String) fcgp-str(oex-json-of(line), "status") == "complete" ? "answered" : "status " ++ fcgp-str(oex-json-of(line), "status") ++ " " ++ fcgp-str(oex-json-of(line), "reason"), line];
  }
  def oex-plan-queue(ctx) = ctx[0] ++ "/plan-queue.jsonl";
  def oex-plan-request(ctx, exam, until) = json-node-object(append(json-object-pairs(fcgp-obj(exam, "request")), [fhn-s("queue", oex-plan-queue(ctx)), fhn-n("fresh", 1), fhn-n("attempts", 2), fhn-n("until_ms", until)]));
  def oex-plan-row(ctx, id) = foldl((found, r) => (String) fcgp-str(r, "request") == id ? r : found, nothing(), ep-text-rows(oex-plan-queue(ctx)));
  def oex-last-number(text) = foldl((found, l) => oex-digits?(trim(l)) ? trim(l) : found, "", split-on(text, "\n"));
  def oex-ask-plan(ctx, exam, until) {
   let cleared = host_path_remove(oex-plan-queue(ctx));
   let id = fcgp-str(fcgp-obj(exam, "request"), "id");
   let began = now_unix_ms();
   let run = hch-run-in(ctx[0], "plan", oex-denied(ctx[1], oex-plan-door()), json-emit(oex-plan-request(ctx, exam, until)) ++ "\n", until + 60000);
   let row = oex-plan-row(ctx, id);
   nothing?(row) ? [(String) oex-ran(run) == "answered" ? "no-queue-row" : oex-ran(run), ""] : oex-plan-read(ctx, row, id, exam, began);
  }
  // the planner's own row of this ask: its verdict and the ids the voice generated
  def oex-plan-option(id, began) = foldl((found, r) => (String) fcgp-str(r, "request") == id && (fcgp-num(r, "at_unix_ms") ?? 0) >= began ? r : found, json-node-object([]), ep-text-rows(flp-plan-ledger()));
  def flp-plan-ledger() = ".hearth/local-plans/ledger.jsonl";
  // the same band over the right function, named by the key and held in the body: what it reads when the wrong function is gone
  def oex-band-right(ctx, band, key) {
   let path = ctx[0] ++ "/plan-right-band.bml";
   let wrote = write_file_text(path, str-join-with(split-on(fhn-read(band), fcgp-str(key, "target")), fcgp-str(key, "right")));
   let run = hch-run-in(ctx[0], "plan-right", oex-denied(ctx[1], path), "", hch-by(600000));
   let gone = oex-band-gone(path);
   hch-ok?(run) ? oex-last-number(run[1]) : "";
  }
  def oex-band-gone(path) = foldl((acc, ext) => host_path_remove(path ++ ext), 0, ["", ".discovery.fkb", ".fkb", ".lowfk", ".sym"]);
  // the band the plan landed, read by fkwu under the same profile: its exit and number today, and over the right function
  def oex-plan-read(ctx, row, id, exam, began) {
   let band = fcgp-str(row, "band");
   let run = hch-run-in(ctx[0], "plan-band", oex-denied(ctx[1], band), "", hch-by(600000));
   let option = oex-plan-option(id, began);
   ["answered", "request=" ++ id ++ " band=" ++ band ++ " full=" ++ (fcgp-num(row, "full") ?? 0).str() ++ " today=" ++ oex-last-number(run[1]) ++ " exit=" ++ hch-status-text(run) ++ " verdict=" ++ fcgp-str(option, "verdict") ++ " ids=" ++ (fcgp-num(option, "local_generated_ids") ?? 0).str() ++ " right=" ++ oex-band-right(ctx, band, oex-keys(exam)[0])];
  }
  def oex-ask-of(kind) = (String) kind == "structural" ? oex-ask-structural : (String) kind == "lookup" ? oex-ask-lookup : (String) kind == "prose" ? oex-ask-prose : (String) kind == "code" ? oex-ask-code : oex-ask-plan;
  // the planted lane: the answers file stands in for the door; no model, and the witness still runs
  def oex-planted(path, kind) = foldl((found, r) => (String) fcgp-str(r, "kind") == kind ? [fcgp-str(r, "status"), fcgp-str(r, "answer")] : found, ["no-answer-row", ""], ep-text-rows(path));
  // a plan's band leaves with its grading; the band lives under the planner's own scratch
  def oex-after-plan(answer) {
   let band = trim(oex-field(answer, "band"));
   ep-starts?(band, flp-witnesses-prefix()) ? oex-band-gone(band) : 0;
  }
  def flp-witnesses-prefix() = ".hearth/local-plans/witnesses/";
  // ---- the time left: until nothing is a hand's run, each kind bounded by its cap alone ------------------------
  def oex-left(until) = nothing?(until) ? nothing() : until - host_monotonic_ms();
  def oex-holds-floor?(until, floor) = nothing?(until) ? true : oex-left(until) >= floor;
  def oex-kind-until(until, cap) = nothing?(until) || host_monotonic_ms() + cap < until ? host_monotonic_ms() + cap : until;
  // ---- one kind ----------------------------------------------------------------------------------------------
  def oex-exam-at(ctx, exam, opts, until) {
   let kind = fcgp-str(exam, "kind");
   let floor = fcgp-num(exam, "floor_ms") ?? 0;
   oex-holds-floor?(until, floor) ? oex-exam-one(ctx, exam, opts, kind, oex-kind-until(until, fcgp-num(exam, "cap_ms") ?? 600000)) : oex-unread(kind, oex-left(until), floor);
  }
  def oex-unread(kind, left, floor) {
   let said = oex-say(kind ++ ": unread this night: " ++ hw-minutes(left) ++ " left cannot hold its floor of " ++ hw-minutes(floor) ++ "; no row");
   nothing();
  }
  def oex-exam-one(ctx, exam, opts, kind, until) {
   let w = oex-witness(ctx, kind);
   (Comparable) w[0] == 1 ? oex-exam-denied(ctx, exam, opts, kind, until) : oex-landed(exam, ctx, 0, false, ["no-ask:" ++ w[1]], 0, "not-asked", "");
  }
  def oex-exam-denied(ctx, exam, opts, kind, until) {
   let t0 = host_monotonic_ms();
   let v = (String) fcgp-str(opts, "answers") != "" ? oex-planted(fcgp-str(opts, "answers"), kind) : oex-ask-of(kind)(ctx, exam, until);
   let answered = (String) v[0] == "answered";
   let failed = answered ? oex-failed(exam, v[1]) : [];
   oex-landed(exam, ctx, 1, answered, failed, host_monotonic_ms() - t0, v[0], v[1]);
  }
  def oex-landed(exam, ctx, denied, answered, failed, wall, status, answer) {
   let kept = write_file_text(ctx[0] ++ "/" ++ fcgp-str(exam, "kind") ++ ".last", answer);
   let row = oex-row(exam, denied, answered, failed, wall, status);
   let appended = fhn-append(ctx[3], lrun-row-line(row) ++ "\n");
   let said = oex-say(fcgp-str(exam, "kind") ++ ": network_denied " ++ denied.str() ++ " answered " ++ (answered ? "1" : "0") ++ " graded " ++ (answered && nil?(failed) ? "1" : "0") ++ " wall_ms " ++ wall.str() ++ " status " ++ status ++ (nil?(failed) ? "" : " failed " ++ str-join-with(failed, ",")));
   let gone = (String) fcgp-str(exam, "kind") == "plan" ? oex-after-plan(answer) : 0;
   row;
  }
  // ---- the sets: read under the profile, rotated by the day -------------------------------------------------------
  def oex-set-names() = filter(n => ep-starts?(n, "scenarios") && str_find(n, ".jsonl", 0) > 0, fs_list(oex-sets-dir()) ?? []);
  def oex-rotate(xs, n) { let k = nil?(xs) ? 0 : n % len(xs); append(xs[k:], take(k, xs)); }
  def oex-sets(opts) {
   let named = fcgp-str(opts, "sets");
   (String) named == "none" ? [] : (String) named != "" ? map(s => trim(s), split-on(named, ",")) : map(n => oex-sets-dir() ++ "/" ++ n, oex-rotate(oex-set-names(), now_unix_ms() / 86400000));
  }
  def oex-set-request(set, port, until) = json-emit(json-node-object(append([fhn-s("fixtures", set), fhn-s("prompt_variant", "exam"), fhn-n("reply_budget", 256), fhn-n("witness_port", port)], nothing?(until) ? [] : [fhn-n("until_ms", until)]))) ++ "\n";
  def oex-set-one(ctx, set, until) {
   let w = oex-witness(ctx, "set");
   (Comparable) w[0] != 1 ? oex-say(set ++ ": no reading: " ++ w[1]) : oex-set-read(ctx, set, until);
  }
  def oex-set-read(ctx, set, until) {
   let run = hch-run-in(ctx[0], "set", oex-denied(ctx[1], oex-read-door()), oex-set-request(set, ctx[2], until), nothing?(until) ? hch-by(7200000) : until + 600000);
   oex-say(set ++ ": exit " ++ hch-status-text(run) ++ "\n" ++ hch-with(run[1], ["[alignment] mode=", "[alignment] unread", "[alignment-axis]"]));
  }
  def oex-set-at(ctx, set, until, floor) = oex-holds-floor?(until, floor) ? oex-set-one(ctx, set, until) : oex-say(set ++ ": unread this night: " ++ hw-minutes(oex-left(until)) ++ " left");
  // ---- the door ----------------------------------------------------------------------------------------------------
  def oex-profile(opts, home) {
   let named = fcgp-str(opts, "profile");
   let path = home ++ "/deny-network.sb";
   (String) named != "" ? named : oex-profile-put(path);
  }
  def oex-profile-put(path) {
   let w = write_file_text(path, oex-profile-text());
   path;
  }
  def oex-host(opts) = oex-or(fcgp-str(opts, "host"), host_os());
  def oex-chosen(opts) {
   let want = fcgp-str(opts, "kinds");
   let rows = ep-text-rows(oex-exams());
   (String) want == "" ? rows : filter(r => any?(k => (String) trim(k) == fcgp-str(r, "kind"), split-on(want, ",")), rows);
  }
  def oex-run(opts) {
   let host = oex-host(opts);
   (String) host != "Darwin" ? dop-refuse(oex-door(), "this host (" ++ host ++ ") carries no sandbox-exec, so no ask can be read with the network denied; no row")
   : (String) fcgp-str(opts, "answers") != "" && (String) fcgp-str(opts, "ledger") == "" ? dop-refuse(oex-door(), "planted answers name their own ledger; no row")
   : oex-walk(opts);
  }
  def oex-walk(opts) {
   let home = (String) fcgp-str(opts, "answers") != "" ? oex-home() ++ "/planted" : oex-home();
   let made = hch-mkdirs(home);
   let held = socket_listen(0);
   let port = socket_port(held);
   let ctx = [home, oex-profile(opts, home), port, oex-or(fcgp-str(opts, "ledger"), oex-ledger())];
   let until = fcgp-num(opts, "until_ms");
   let rows = filter(r => !nothing?(r), map(e => oex-exam-at(ctx, e, opts, until), oex-chosen(opts)));
   let sets = oex-sets(opts);
   let read = map(s => oex-set-at(ctx, s, until, 60000), sets);
   let denied = len(filter(r => (Comparable) fcgp-num(r, "network_denied") == 1, rows));
   let graded = len(filter(r => (Comparable) fcgp-num(r, "graded") == 1, rows));
   let summary = "[offline-exam] summary: kinds " ++ len(rows).str() ++ " read, " ++ denied.str() ++ " denied, " ++ graded.str() ++ " graded; sets " ++ len(sets).str() ++ " begun; ledger " ++ ctx[3];
   print_str(summary);
  }
 }
}
