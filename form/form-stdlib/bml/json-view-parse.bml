// Strict wire admission and the shared JSON parser, constructing owned values.
// No event leaf or container enters primary content identity during this parse.
// preludes: form-stdlib/bml/json-view.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 class JsonViewParse {
  def jvp-build(kind,payload,source) = if str_eq(kind,"STRING") then jv-string(payload) else if str_eq(kind,"NUMBER") then if json-number-float?(payload) then jv-float(str_to_float(payload)) else jv-int(str_to_int(payload)) else if str_eq(kind,"BOOL") then jv-bool(payload) else if str_eq(kind,"NULL") then jv-null() else if str_eq(kind,"ARRAY") then jv-array(payload) else if str_eq(kind,"PAIR") then jv-pair(jv-value(head(payload)),nth(payload,1)) else jv-object(payload);
  // Only callers that have admitted this complete wire record use this door.
  def jvp-admitted(text) = json-pair-r(json-parse-with(0,text,0,"",list(),jvp-build));
  def jvp-parse(text) = if jwa-valid(text) then jvp-admitted(text) else form_error("JSON view needs one complete JSON value");
 }
 0;
}
