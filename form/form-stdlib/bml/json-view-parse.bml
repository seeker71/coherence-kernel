// Strict wire admission and the shared JSON parser, constructing owned values.
// No event leaf or container enters primary content identity during this parse.
// preludes: form-stdlib/bml/json-view.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 class JsonViewParse {
  def jvp-build(kind,payload,source) = (String) kind == "STRING" ? jv-string(payload) : (String) kind == "NUMBER" ? (json-number-float?(payload) ? jv-float(str_to_float(payload)) : jv-int(str_to_int(payload))) : (String) kind == "BOOL" ? jv-bool(payload) : (String) kind == "NULL" ? jv-null() : (String) kind == "ARRAY" ? jv-array(payload) : (String) kind == "PAIR" ? jv-pair(jv-value(head(payload)),payload[1]) : jv-object(payload);
  // Only callers that have admitted this complete wire record use this door.
  def jvp-admitted(text) = json-pair-r(json-parse-with(0,text,0,"",list(),jvp-build));
  def jvp-parse(text) = jwa-valid(text) ? jvp-admitted(text) : form_error("JSON view needs one complete JSON value");
 }
 0;
}
