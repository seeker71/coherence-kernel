// qwen-lora-projection.bml — an in-image local Form projection.
// The adapter is a Form value; no side file, process, network, or base rewrite.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class QwenLoraProjection {
  field Schema = "qwen-lora-projection-v1";
  def qlp-projection(base, identity, projection, a, b) = list(Schema(), base, identity, projection, a, b);
  def qlp-base(x) = nth(x, 1); def qlp-a(x) = nth(x, 4); def qlp-b(x) = nth(x, 5);
  def qlp-valid?(x) = if not(eq(len(x), 6)) then 0 else if not(str_eq(head(x), Schema())) then 0 else if le(str_len(qlp-base(x)), 0) then 0 else if le(str_len(nth(x, 2)), 0) then 0 else if le(str_len(nth(x, 3)), 0) then 0 else eq(len(qlp-a(x)), len(qlp-b(x)));
  def qlp-dot(a, b) = if eq(len(a), 0) then 0 else add(mul(head(a), head(b)), qlp-dot(tail(a), tail(b)));
  def qlp-scale(v, n) = if eq(len(v), 0) then list() else cons(mul(head(v), n), qlp-scale(tail(v), n));
  def qlp-add(a, b) = if eq(len(a), 0) then list() else cons(add(head(a), head(b)), qlp-add(tail(a), tail(b)));
  def qlp-receive(base, projection, feature) = if not(qlp-valid?(projection)) then list("refused", "invalid-projection") else if not(str_eq(base, qlp-base(projection))) then list("refused", "base-mismatch") else if not(eq(len(feature), len(qlp-a(projection)))) then list("refused", "shape-mismatch") else list("received", qlp-add(feature, qlp-scale(qlp-b(projection), qlp-dot(qlp-a(projection), feature))));
 }
 0;
}
