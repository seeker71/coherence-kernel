//////////////////////////////////////////////////////////////////////
// form-cli-peer-hearth-telemetry-action.bml -- caller-born hearth facts
// without a model turn.
//
// This action is a native answer floor for the monitor topology itself.
// It does not inspect task prose, advance Qwen/KV, open a filesystem root,
// or accept a path.  Its dynamic facts come only from the born hearth paths.
// The turnwheel owns the one durable append; the resident's Form stage stream
// and the glass remain the live evidence.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-peer-stream-ingress.fk form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/bml/form-cli-resident-birth-observation.bml

section [form.bml] {
    class FormCliPeerHearthTelemetryAction {
        field Route = "hearth-telemetry";
        field Carrier = "form-native-hearth";
        field RouteLine = "route: caller-born hearth-telemetry returns canonical monitor topology before any model turn.";
        field AuthorityLine = "authority: policy selects this born action, task bytes choose neither a root nor a model session.";
        field LiveLine = "live event: resident Form phase lines enter server.out, the glass projects them as live flight data.";
        field DurableLine = "durable result: the turnwheel performs one reply-spool append before seen/session promotion.";
        field NextLine = "next stone: let local language extend this fixed grounded snapshot only when language is useful.";

        def fcphta-route() = Route();
        def fcphta-carrier() = Carrier();
        def fcphta-read(path) {
            let content = read_file(path);
            if nothing?(content) then "" else content;
        }
        def fcphta-present-text(text) = if le(str_len(text), 0) then nothing() else text;
        def fcphta-display(value) = if nothing?(value) then "nothing" else value;
        def fcphta-snapshot-version() = "form-cli-hearth-snapshot-v2";
        def fcphta-snapshot(board, task_bytes, reply_bytes, reply, out) = list(fcphta-snapshot-version(), fcphta-present-text(gl-word-field(board, "pid")), fcphta-present-text(gl-line-field(board, "capabilities")), task_bytes, reply_bytes, gl-count-of(reply, "turn"), gl-newest(gl-collect(reply, "elapsed-ms")), fcphta-present-text(gl-word-field-last(reply, "route")), gl-direct-flight-phase(out), fcrbo-snapshot(out));
        def fcphta-live-snapshot() {
            let board = fcphta-read(hearth-board());
            let reply = fcphta-read(hearth-reply());
            let out = fcphta-read(hearth-out());
            fcphta-snapshot(board, file_size(hearth-task()), file_size(hearth-reply()), reply, out);
        }
        def fcphta-empty-snapshot() = fcphta-snapshot("", 0, 0, "", "");
        def fcphta-snapshot?(snapshot) = if nothing?(snapshot) then 0 else if not(eq(len(snapshot), 10)) then 0 else if not(fcrbo-snapshot?(nth(snapshot, 9))) then 0 else str_eq(nth(snapshot, 0), fcphta-snapshot-version());
        def fcphta-snapshot-pid(snapshot) = nth(snapshot, 1);
        def fcphta-snapshot-capabilities(snapshot) = nth(snapshot, 2);
        def fcphta-snapshot-task-bytes(snapshot) = nth(snapshot, 3);
        def fcphta-snapshot-reply-bytes(snapshot) = nth(snapshot, 4);
        def fcphta-snapshot-served(snapshot) = nth(snapshot, 5);
        def fcphta-snapshot-last-ms(snapshot) = nth(snapshot, 6);
        def fcphta-snapshot-last-route(snapshot) = nth(snapshot, 7);
        def fcphta-snapshot-flight(snapshot) = nth(snapshot, 8);
        def fcphta-snapshot-birth(snapshot) = nth(snapshot, 9);
        def fcphta-fact(name, value) = str_concat(name, str_concat("=", fcphta-display(value)));
        def fcphta-join-facts(facts) = if eq(len(facts), 0) then "" else if eq(len(tail(facts)), 0) then head(facts) else str_concat(head(facts), str_concat(" ", fcphta-join-facts(tail(facts))));
        def fcphta-join-lines(lines) = if eq(len(lines), 0) then "" else if eq(len(tail(lines)), 0) then head(lines) else str_concat(head(lines), str_concat(byte_to_str(10), fcphta-join-lines(tail(lines))));
        def fcphta-fact-line(snapshot) = str_concat("facts: ", fcphta-join-facts(list(fcphta-fact("board-pid", fcphta-snapshot-pid(snapshot)), fcphta-fact("capabilities", fcphta-snapshot-capabilities(snapshot)), fcphta-fact("task-bytes", int_to_str(fcphta-snapshot-task-bytes(snapshot))), fcphta-fact("reply-bytes", int_to_str(fcphta-snapshot-reply-bytes(snapshot))), fcphta-fact("served-turns", int_to_str(fcphta-snapshot-served(snapshot))), fcphta-fact("last-elapsed-ms", int_to_str(fcphta-snapshot-last-ms(snapshot))), fcphta-fact("last-route", fcphta-snapshot-last-route(snapshot)), fcphta-fact("live-flight", fcphta-snapshot-flight(snapshot)), fcphta-fact("birth-cache", fcrbo-display-text(fcrbo-cache(fcphta-snapshot-birth(snapshot)))), fcphta-fact("birth-source-context-ms", fcrbo-display-int(fcrbo-source-context-ms(fcphta-snapshot-birth(snapshot)))), fcphta-fact("birth-native-program-ms", fcrbo-display-int(fcrbo-native-program-ms(fcphta-snapshot-birth(snapshot)))), fcphta-fact("birth-resident-setup-ms", fcrbo-display-int(fcrbo-resident-setup-ms(fcphta-snapshot-birth(snapshot)))), fcphta-fact("birth-prefill-ms", fcrbo-display-int(fcrbo-prefill-ms(fcphta-snapshot-birth(snapshot)))))));
        def fcphta-response(snapshot) = fcphta-join-lines(list(RouteLine(), AuthorityLine(), LiveLine(), DurableLine(), fcphta-fact-line(snapshot), NextLine()));
        def fcphta-version() = "form-cli-peer-hearth-telemetry-v2";
        def fcphta-result(session, snapshot, response, signal, reason) = list(fcphta-version(), session, snapshot, response, signal, reason);
        def fcphta-session(result) = nth(result, 1);
        def fcphta-snapshot-of(result) = nth(result, 2);
        def fcphta-response-of(result) = nth(result, 3);
        def fcphta-signal(result) = nth(result, 4);
        def fcphta-reason(result) = nth(result, 5);
        def fcphta-result?(result) = if nothing?(result) then 0 else if not(eq(len(result), 6)) then 0 else if not(fcphta-snapshot?(fcphta-snapshot-of(result))) then 0 else str_eq(nth(result, 0), fcphta-version());
        def fcphta-kind?(kind) = str_eq(kind, fcphta-route());
        def fcphta-refused(session, reason) = fcphta-result(session, fcphta-empty-snapshot(), "", "choice", reason);
        def fcphta-run(session, task_kind, task_text) {
            let snapshot = fcphta-live-snapshot();
            if not(fcphta-kind?(task_kind)) then fcphta-refused(session, "hearth-telemetry-requires-hearth-telemetry-task") else if or(nothing?(task_text), le(str_len(task_text), 0)) then fcphta-refused(session, "hearth-telemetry-requires-nonempty-task") else fcphta-result(session, snapshot, fcphta-response(snapshot), "value", "fixed-hearth-snapshot");
        }
        def fcphta-peer(result) = fcpa-result-full(fcphta-session(result), result, fcphta-response-of(result), 0, 0, fcphta-route(), 0, if str_eq(fcphta-signal(result), "value") then "value;model=0;lookup=0;event-stream=1" else "choice;model=0;lookup=0;event-stream=0", fcphta-carrier(), 0, nothing(), 0, 0, if str_eq(fcphta-signal(result), "value") then "observe,release" else "choice,release", 0);
        def fcphta-run-peer-task(stream, session, task_node, task) {
            let result = fcphta-run(session, fcpsi-task-kind(task), fcpsi-task-text(task));
            let peer = fcphta-peer(result);
            let candidate = fcpsi-peer-result(stream, task_node, fcpa-response(peer), 0, nothing());
            list(fcpsi-result-state(candidate), peer, candidate);
        }
        def fcphta-run-peer(stream, session, task_node) {
            let task = fcpsi-find-task(fcpsi-tasks(stream), task_node);
            if nothing?(task) then list(stream, nothing(), fcpsi-result(stream, "nothing", 0, nothing(), "task-node-absent", nothing())) else fcphta-run-peer-task(stream, session, task_node, task);
        }
    }
    0;
}
