//////////////////////////////////////////////////////////////////////
// form-cli-peer-hearth-telemetry-action.bml -- caller-born hearth facts
// without a model turn.
//
// This action is a native answer floor for the monitor topology itself.
// It does not inspect task prose, advance Qwen/KV, open a filesystem root,
// or accept a path.  Its dynamic facts come only from the born hearth paths.
// The turnwheel owns the one durable append; the resident's Form stage stream
// and the glass remain the live evidence.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-peer-stream-ingress.fk form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/bml/form-cli-resident-birth-observation.bml

section [form.bml] {
    class FormCliPeerHearthTelemetryAction {
        field HearthTelemetryRoute = "hearth-telemetry";
        field HearthTelemetryCarrier = "form-native-hearth";
        field HearthTelemetryRouteLine = "route: caller-born hearth-telemetry returns canonical monitor topology before any model turn.";
        field HearthTelemetryAuthorityLine = "authority: policy selects this born action, task bytes choose neither a root nor a model session.";
        field HearthTelemetryLiveLine = "live event: resident Form phase lines enter server.out, the glass projects them as live flight data.";
        field HearthTelemetryDurableLine = "durable result: the turnwheel performs one reply-spool append before seen/session promotion.";
        field HearthTelemetryNextLine = "next stone: let local language extend this fixed grounded snapshot only when language is useful.";

        def fcphta-route() = HearthTelemetryRoute();
        def fcphta-carrier() = HearthTelemetryCarrier();
        def fcphta-read(path) {
            let content = read_file(path);
            content ?? "";
        }
        def fcphta-present-text(text) = str_len(text) <= 0 ? nothing() : text;
        def fcphta-display(value) = value ?? "nothing";
        def fcphta-snapshot-version() = "form-cli-hearth-snapshot-v2";
        def fcphta-snapshot(board, task_bytes, reply_bytes, reply, out) = list(fcphta-snapshot-version(), fcphta-present-text(gl-word-field(board, "pid")), fcphta-present-text(gl-line-field(board, "capabilities")), task_bytes, reply_bytes, gl-count-of(reply, "turn"), gl-newest(gl-collect(reply, "elapsed-ms")), fcphta-present-text(gl-word-field-last(reply, "route")), gl-flight-phase-now(out), fcrbo-snapshot(out));
        def fcphta-live-snapshot() {
            let board = fcphta-read(hearth-board());
            let reply = fcphta-read(hearth-reply());
            let out = fcphta-read(hearth-out());
            fcphta-snapshot(board, file_size(hearth-task()), file_size(hearth-reply()), reply, out);
        }
        def fcphta-empty-snapshot() = fcphta-snapshot("", 0, 0, "", "");
        def fcphta-snapshot?(snapshot) = nothing?(snapshot) ? 0 : !((Comparable) len(snapshot) == 10) ? 0 : !fcrbo-snapshot?(snapshot[9]) ? 0 : ((String) snapshot[0] == fcphta-snapshot-version());
        def fcphta-snapshot-pid(snapshot) = snapshot[1];
        def fcphta-snapshot-capabilities(snapshot) = snapshot[2];
        def fcphta-snapshot-task-bytes(snapshot) = snapshot[3];
        def fcphta-snapshot-reply-bytes(snapshot) = snapshot[4];
        def fcphta-snapshot-served(snapshot) = snapshot[5];
        def fcphta-snapshot-last-ms(snapshot) = snapshot[6];
        def fcphta-snapshot-last-route(snapshot) = snapshot[7];
        def fcphta-snapshot-flight(snapshot) = snapshot[8];
        def fcphta-snapshot-birth(snapshot) = snapshot[9];
        def fcphta-fact(name, value) = name ++ "=" ++ fcphta-display(value);
        def fcphta-join-facts(facts) = (Comparable) len(facts) == 0 ? "" : (Comparable) len(tail(facts)) == 0 ? head(facts) : head(facts) ++ " " ++ fcphta-join-facts(tail(facts));
        def fcphta-join-lines(lines) = (Comparable) len(lines) == 0 ? "" : (Comparable) len(tail(lines)) == 0 ? head(lines) : head(lines) ++ byte_to_str(10) ++ fcphta-join-lines(tail(lines));
        def fcphta-fact-line(snapshot) = "facts: " ++ fcphta-join-facts(list(fcphta-fact("board-pid", fcphta-snapshot-pid(snapshot)), fcphta-fact("capabilities", fcphta-snapshot-capabilities(snapshot)), fcphta-fact("task-bytes", int_to_str(fcphta-snapshot-task-bytes(snapshot))), fcphta-fact("reply-bytes", int_to_str(fcphta-snapshot-reply-bytes(snapshot))), fcphta-fact("served-turns", int_to_str(fcphta-snapshot-served(snapshot))), fcphta-fact("last-elapsed-ms", int_to_str(fcphta-snapshot-last-ms(snapshot))), fcphta-fact("last-route", fcphta-snapshot-last-route(snapshot)), fcphta-fact("live-flight", fcphta-snapshot-flight(snapshot)), fcphta-fact("birth-cache", fcrbo-display-text(fcrbo-cache(fcphta-snapshot-birth(snapshot)))), fcphta-fact("birth-source-context-ms", fcrbo-display-int(fcrbo-source-context-ms(fcphta-snapshot-birth(snapshot)))), fcphta-fact("birth-native-program-ms", fcrbo-display-int(fcrbo-native-program-ms(fcphta-snapshot-birth(snapshot)))), fcphta-fact("birth-resident-setup-ms", fcrbo-display-int(fcrbo-resident-setup-ms(fcphta-snapshot-birth(snapshot)))), fcphta-fact("birth-prefill-ms", fcrbo-display-int(fcrbo-prefill-ms(fcphta-snapshot-birth(snapshot))))));
        def fcphta-response(snapshot) = fcphta-join-lines(list(HearthTelemetryRouteLine(), HearthTelemetryAuthorityLine(), HearthTelemetryLiveLine(), HearthTelemetryDurableLine(), fcphta-fact-line(snapshot), HearthTelemetryNextLine()));
        def fcphta-version() = "form-cli-peer-hearth-telemetry-v2";
        def fcphta-result(session, snapshot, response, signal, reason) = list(fcphta-version(), session, snapshot, response, signal, reason);
        def fcphta-session(result) = result[1];
        def fcphta-snapshot-of(result) = result[2];
        def fcphta-response-of(result) = result[3];
        def fcphta-signal(result) = result[4];
        def fcphta-reason(result) = result[5];
        def fcphta-result?(result) = nothing?(result) ? 0 : !((Comparable) len(result) == 6) ? 0 : !fcphta-snapshot?(fcphta-snapshot-of(result)) ? 0 : ((String) result[0] == fcphta-version());
        def fcphta-kind?(kind) = (String) kind == fcphta-route();
        def fcphta-refused(session, reason) = fcphta-result(session, fcphta-empty-snapshot(), "", "choice", reason);
        def fcphta-run(session, task_kind, task_text) {
            let snapshot = fcphta-live-snapshot();
            !fcphta-kind?(task_kind) ? fcphta-refused(session, "hearth-telemetry-requires-hearth-telemetry-task") : nothing?(task_text) || (str_len(task_text) <= 0) ? fcphta-refused(session, "hearth-telemetry-requires-nonempty-task") : fcphta-result(session, snapshot, fcphta-response(snapshot), "value", "fixed-hearth-snapshot");
        }
        def fcphta-peer(result) = fcpa-result-full(fcphta-session(result), result, fcphta-response-of(result), 0, 0, fcphta-route(), 0, (String) fcphta-signal(result) == "value" ? "value;model=0;lookup=0;event-stream=1" : "choice;model=0;lookup=0;event-stream=0", fcphta-carrier(), 0, nothing(), 0, 0, (String) fcphta-signal(result) == "value" ? "observe,release" : "choice,release", 0);
        def fcphta-run-peer-task(stream, session, task_node, task) {
            let result = fcphta-run(session, fcpsi-task-kind(task), fcpsi-task-text(task));
            let peer = fcphta-peer(result);
            let candidate = fcpsi-peer-result(stream, task_node, fcpa-response(peer), 0, nothing());
            list(fcpsi-result-state(candidate), peer, candidate);
        }
        def fcphta-run-peer(stream, session, task_node) {
            let task = fcpsi-find-task(fcpsi-tasks(stream), task_node);
            nothing?(task) ? list(stream, nothing(), fcpsi-result(stream, "nothing", 0, nothing(), "task-node-absent", nothing())) : fcphta-run-peer-task(stream, session, task_node, task);
        }
    }
    0;
}
