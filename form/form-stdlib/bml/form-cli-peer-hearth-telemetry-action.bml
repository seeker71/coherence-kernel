//////////////////////////////////////////////////////////////////////
// form-cli-peer-hearth-telemetry-action.bml -- caller-born hearth facts
// without a model turn.
//
// This action is a native answer floor for the monitor topology itself.
// It does not inspect task prose, advance Qwen/KV, open a filesystem root,
// or claim a dynamic metric.  The turnwheel owns the one durable append;
// the resident's Form stage stream and the glass remain the live evidence.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-peer-stream-ingress.fk

section [form.bml] {
    class FormCliPeerHearthTelemetryAction {
        field Route = "hearth-telemetry";
        field Carrier = "form-native-hearth";
        field RouteLine = "route: caller-born hearth-telemetry returns canonical monitor topology before any model turn.";
        field AuthorityLine = "authority: policy selects this born action; task bytes choose neither a root nor a model session.";
        field LiveLine = "live event: resident Form phase lines enter server.out; the glass projects them as live flight data.";
        field DurableLine = "durable result: the turnwheel performs one reply-spool append before seen/session promotion.";
        field NextLine = "next stone: join dynamic telemetry facts beside this canonical floor, then let local language extend grounded evidence.";

        def fcphta-route() = Route();
        def fcphta-carrier() = Carrier();
        def fcphta-response() = str_concat(RouteLine(), str_concat(byte_to_str(10), str_concat(AuthorityLine(), str_concat(byte_to_str(10), str_concat(LiveLine(), str_concat(byte_to_str(10), str_concat(DurableLine(), str_concat(byte_to_str(10), NextLine()))))))));
        def fcphta-version() = "form-cli-peer-hearth-telemetry-v1";
        def fcphta-result(session, response, signal, reason) = list(fcphta-version(), session, response, signal, reason);
        def fcphta-session(result) = nth(result, 1);
        def fcphta-response-of(result) = nth(result, 2);
        def fcphta-signal(result) = nth(result, 3);
        def fcphta-reason(result) = nth(result, 4);
        def fcphta-result?(result) = if nothing?(result) then 0 else if not(eq(len(result), 5)) then 0 else str_eq(nth(result, 0), fcphta-version());
        def fcphta-kind?(kind) = str_eq(kind, fcphta-route());
        def fcphta-refused(session, reason) = fcphta-result(session, "", "choice", reason);
        def fcphta-run(session, task_kind, task_text) = if not(fcphta-kind?(task_kind)) then fcphta-refused(session, "hearth-telemetry-requires-hearth-telemetry-task") else if or(nothing?(task_text), le(str_len(task_text), 0)) then fcphta-refused(session, "hearth-telemetry-requires-nonempty-task") else fcphta-result(session, fcphta-response(), "value", "canonical-hearth-topology");
        def fcphta-peer(result) = fcpa-result-full(fcphta-session(result), result, fcphta-response-of(result), 0, 0, fcphta-route(), 0, if str_eq(fcphta-signal(result), "value") then "value;model=0;lookup=0;event-stream=1" else "choice;model=0;lookup=0;event-stream=0", fcphta-carrier(), 0, nothing, 0, 0, if str_eq(fcphta-signal(result), "value") then "observe,release" else "choice,release", 0);
        def fcphta-run-peer-task(stream, session, task_node, task) {
            let result = fcphta-run(session, fcpsi-task-kind(task), fcpsi-task-text(task));
            let peer = fcphta-peer(result);
            let candidate = fcpsi-peer-result(stream, task_node, fcpa-response(peer), 0, nothing);
            list(fcpsi-result-state(candidate), peer, candidate);
        }
        def fcphta-run-peer(stream, session, task_node) {
            let task = fcpsi-find-task(fcpsi-tasks(stream), task_node);
            if nothing?(task) then list(stream, nothing, fcpsi-result(stream, "nothing", 0, nothing, "task-node-absent", nothing)) else fcphta-run-peer-task(stream, session, task_node, task);
        }
    }
    0;
}
