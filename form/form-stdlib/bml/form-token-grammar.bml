// form-token-grammar.bml — the one table of in-stream Form controls.
//
// A model writes <|form:VERB|>PAYLOAD<|/form:VERB|>; when the stream closes the control, Form
// runs the verb (form-token-verbs.bml) and answers in the same stream
// with <|form:observation|>RESULT<|/form:observation|>. RESULT is value=<v>; recipe=@<p.l.t.i>;
// node=@<p.l.t.i>; or nothing=<reason>;. A refusal is an observation, never a stop.
//
// The opening bytes of recipe-birth, recipe-exec and knowledge-query are the ones
// form-recipe-birth-token.fk, form-recipe-exec-token.fk and form-knowledge-query-token.fk read;
// nodeid-knowledge-query stays with the microthought owner, which holds its source context.
//
// Any local decode loop carries the verbs in one of two shapes. A token walk passes ftg-feed and
// ftg-inject to frxs-run-protocol-with-injector (form-cli-recipe-exec-session.fk), as
// ftg-generate does for the voice: the observation follows the closing ID. A quantum walk asks
// ftg-quantum-next where it would forward its pending ID, as the coding lane does: the
// observation follows at the end of the quantum the control closed in. Both commit the pending
// ID once and prefill the observation into the same KV stream (fcms-inline-bml-observation-ids).
import form-stdlib/bml/form-token-verbs.bml;
import form-stdlib/form-cli-recipe-exec-session.fk;
import form-stdlib/json.fk;
import form-stdlib/hearth.bml;
section [form.bml] {
 let FTG-DEFAULT = ftv-session();
 class FormTokenGrammar {
  def ftg-verbs() = ["recipe-birth", "recipe-exec", "choice", "eval", "knowledge-query", "node-get", "node-make", "node-select"];
  def ftg-stream-verbs() = append(ftg-verbs(), ["nodeid-knowledge-query"]);
  def ftg-verb?(verb) = any?(v => v == verb, ftg-stream-verbs());
  def ftg-open(verb) = "<|form:" ++ verb ++ "|>";
  def ftg-close(verb) = "<|/form:" ++ verb ++ "|>";
  def ftg-render(verb, payload) = ftg-open(verb) ++ payload ++ ftg-close(verb);
  def ftg-observation-open() = "<|form:observation|>";
  def ftg-observation-close() = "<|/form:observation|>";
  def ftg-observation(result) = ftg-observation-open() ++ result ++ ftg-observation-close();
  // a source observation already carries its own envelope (nodeid-knowledge-query)
  def ftg-envelope(text) = ftv-starts?(text, "<|form:") ? text : ftg-observation(text);
  def ftg-result-kind(result) = ftv-starts?(result, "value=") ? "value" : ftv-starts?(result, "recipe=") ? "recipe" : ftv-starts?(result, "node=") ? "node" : ftv-starts?(result, "nothing=") ? "nothing" : "";
  def ftg-result-body(result) {
   let at = str_find(result, "=", 0);
   let end = ftv-ends?(result, ";") ? len(result) - 1 : len(result);
   at < 0 ? "" : substring(result, at + 1, end);
  }
  def ftg-session() = FTG-DEFAULT;
  def ftg-session-fresh() = ftv-session();

  // ── running a verb ───────────────────────────────────────────────────
  def ftg-observe(verb, payload) = ftg-observe-with(FTG-DEFAULT, verb, payload);
  def ftg-observe-with(session, verb, payload) {
   let held = try [ftg-dispatch(session, verb, payload)] catch [ftv-nothing("verb-stopped")];
   ftg-count(session, verb, payload, held[0]);
   held[0];
  }
  def ftg-dispatch(session, verb, payload) {
   if verb == "eval" then ftv-eval(session, payload)
   else if verb == "knowledge-query" then ftv-knowledge(session, payload)
   else if verb == "node-get" then ftv-node-get(session, payload)
   else if verb == "node-make" then ftv-node-make(session, payload)
   else if verb == "node-select" then ftv-node-select(session, payload)
   else if verb == "recipe-birth" then ftv-recipe-birth(session, payload)
   else if verb == "recipe-exec" then ftv-recipe-exec(session, payload)
   else if verb == "choice" then ftv-choice(session, payload)
   else if verb == "nodeid-knowledge-query" then ftv-nothing("knowledge-context-unavailable")
   else if verb == "observation" then ftv-nothing("observations-come-from-form")
   else ftv-nothing("unknown-verb:" ++ ftv-cap(verb));
  }
  def ftg-count(session, verb, payload, result) {
   record_set(session, "calls", record_get(session, "calls") + 1);
   if ftg-result-kind(result) == "nothing" then record_set(session, "refusals", record_get(session, "refusals") + 1) else 0;
   record_set(session, "events", take(64, cons([verb, payload, result], record_get(session, "events"))));
   0;
  }

  // ── reading controls out of text ─────────────────────────────────────
  // every complete control of a known verb, in order: [verb, payload, start, end]
  def ftg-scan(text) = ftg-scan-from(text, 0, [], 0);
  // every complete <|form:NAME|>...<|/form:NAME|>, known verb or not, so a lane can answer an
  // unknown verb with its nothing instead of passing over it
  def ftg-scan-any(text) = ftg-scan-from(text, 0, [], 1);
  def ftg-name?(verb) = (len(verb) > 0) && (len(verb) <= 40) && (str_find(verb, "<", 0) < 0);
  def ftg-scan-from(text, from, out, any) {
   let at = str_find(text, "<|form:", from);
   if at < 0 then reverse(out) else ftg-scan-at(text, at, out, any);
  }
  // an opening that is not wanted, or never closes, is passed over and the scan reads on
  def ftg-scan-at(text, at, out, any) {
   let verbEnd = str_find(text, "|>", at + 7);
   let verb = verbEnd < 0 ? "" : substring(text, at + 7, verbEnd);
   let wanted = any == 1 ? ftg-name?(verb) : ftg-verb?(verb);
   let close = (verbEnd < 0) || !wanted ? -1 : str_find(text, ftg-close(verb), verbEnd + 2);
   if verbEnd < 0 then reverse(out)
   else if close < 0 then ftg-scan-from(text, at + 7, out, any)
   else ftg-scan-from(text, close + len(ftg-close(verb)), cons([verb, substring(text, verbEnd + 2, close), at, close + len(ftg-close(verb))], out), any);
  }
  // every <|/form:NAME|> close in text, in order: [verb, "", start, end]
  def ftg-closes(text, from, out) {
   let at = str_find(text, "<|/form:", from);
   let end = at < 0 ? -1 : str_find(text, "|>", at + 8);
   if (at < 0) || (end < 0) then reverse(out) else ftg-closes(text, end + 2, cons([substring(text, at + 8, end), "", at, end + 2], out));
  }

  // ── the stream window ────────────────────────────────────────────────
  // One step over a decoded chunk: [window, status, verb, frame, payload]. Until a control
  // starts only an opening-prefix suffix is kept. status is held, control, too-long (the open
  // control outgrew the reserve) or multiple (a second control opened in the same chunk).
  def ftg-window(window, chunk, reserve) {
   let prefix = "<|form:";
   let joined = window ++ chunk;
   let at = str_find(joined, prefix, 0);
   let held = at < 0 ? substring(joined, len(joined) >= len(prefix) ? len(joined) - len(prefix) + 1 : 0, len(joined)) : substring(joined, at, len(joined));
   let verbEnd = str_find(held, "|>", len(prefix));
   let verb = verbEnd < 0 ? "" : substring(held, len(prefix), verbEnd);
   let close = "<|/form:" ++ verb ++ "|>";
   let end = verbEnd < 0 ? -1 : str_find(held, close, verbEnd + 2);
   let tooLong = len(held) > reserve;
   let frame = end < 0 ? "" : substring(held, 0, end + len(close));
   if (at < 0) || ((end < 0) && !tooLong) then [held, "held", verb, "", ""]
   else if tooLong then ["", "too-long", verb, frame, ""]
   else if str_find(substring(held, end + len(close), len(held)), prefix, 0) >= 0 then ["", "multiple", verb, frame, ""]
   else ["", "control", verb, frame, substring(held, verbEnd + 2, end)];
  }

  // ── the token-walk interceptor ───────────────────────────────────────
  // Each crossing keeps its frame, its RESULT and an injected flag, paired by index; the flag
  // turns 1 only when the session resumed live after the observation (ftg-inject). fed counts
  // the IDs the walk decoded; a pulsing interceptor publishes fcms-generate's decode checkpoints
  // at the same counts, 1, 2, 4, 8 and on.
  def ftg-intercept(reserve) = ftg-intercept-with(reserve, ftv-session());
  def ftg-intercept-with(reserve, session) = record_new(0, "window", "", "reserve", reserve, "session", session, "crossings", 0, "frames", [], "results", [], "injected", [], "fed", 0, "pulse", 0);
  def ftg-pulsing(icpt) {
   record_set(icpt, "pulse", 1);
   icpt;
  }
  def ftg-power-of-two?(n) = n < 1 ? 0 : n == 1 ? 1 : (n % 2) == 1 ? 0 : ftg-power-of-two?(n / 2);
  def ftg-checkpoint?(icpt) = (record_get(icpt, "pulse") == 1) && ftg-power-of-two?(record_get(icpt, "fed"));
  def ftg-feed(icpt, cursor, chunk) {
   record_set(icpt, "fed", record_get(icpt, "fed") + 1);
   if ftg-checkpoint?(icpt) then fcms-decode-pulse(record_get(icpt, "fed")) else 0;
   let w = ftg-window(record_get(icpt, "window"), chunk, record_get(icpt, "reserve"));
   record_set(icpt, "window", w[0]);
   let result = ftg-window-result(record_get(icpt, "session"), w);
   if len(result) > 0 then ftg-note(icpt, w[3], result) else 0;
   [cursor, chunk, result];
  }
  def ftg-window-result(session, w) = w[1] == "held" ? "" : w[1] == "too-long" ? ftv-nothing("control-exceeds-observation-reserve") : w[1] == "multiple" ? ftv-nothing("multiple-controls-in-one-model-id") : ftg-observe-with(session, w[2], w[4]);
  def ftg-note(icpt, frame, result) {
   record_set(icpt, "crossings", record_get(icpt, "crossings") + 1);
   record_set(icpt, "frames", cons(frame, record_get(icpt, "frames")));
   record_set(icpt, "results", cons(result, record_get(icpt, "results")));
   record_set(icpt, "injected", cons(0, record_get(icpt, "injected")));
   0;
  }
  // The pending ID is committed once, then the observation; the session answers the first
  // prediction after it. No room for the observation ends the reply with its reason. The
  // newest crossing's flag reads whether the observation entered the stream.
  def ftg-inject(icpt, session, text) {
   let resumed = ftg-inject-ids(session, text);
   let flags = record_get(icpt, "injected");
   if !nil?(flags) then record_set(icpt, "injected", cons(fcms-live?(resumed) ? 1 : 0, flags[1:])) else 0;
   resumed;
  }
  def ftg-inject-ids(session, text) {
   let ids = fcms-inline-bml-observation-ids(session, ftg-envelope(text));
   if nothing?(ids) then fcms-refuse(session, "form-token-codec-unavailable")
   else if (fcms-pos(session) + len(ids)) >= fcms-maxpos(session) then fcms-refuse(session, "form-token-observation-reserve-exhausted")
   else fcms-observe-ids(session, ids, "form-token-observation-refused");
  }
  // fcms-generate with the verbs carried: model text and IDs only in the generation; what Form
  // answered stays in the crossing ledger. A sampled session keeps its own walk.
  def ftg-generate(session, budget) = !nil?(fcsam-owner(session)) ? fcms-generate(session, budget) : ftg-generate-with(ftg-pulsing(ftg-intercept(512)), session, budget, "voice");
  def ftg-generate-with(icpt, session, budget, lane) {
   let moved = frxs-run-protocol-with-injector(session, budget, 0, icpt, ftg-feed, frxs-observe-none, (s, text) => ftg-inject(icpt, s, text));
   let ids = append(frxs-before-ids(moved), frxs-after-ids(moved));
   ftg-retain(lane, reverse(record_get(icpt, "frames")), reverse(record_get(icpt, "results")), reverse(record_get(icpt, "injected")));
   fcms-generation(ftdb-text(fcms-src(session), ids), ids, frxs-session(moved));
  }

  // ── the quantum-walk hook ────────────────────────────────────────────
  // A walk that decodes a few IDs at a time asks here instead of forwarding its pending ID.
  // A control whose close fell in the newest quantum is answered and its observation prefilled
  // at the quantum's end, so up to width-1 IDs the voice wrote after the close precede it;
  // otherwise nextf forwards as before. The window is the last ftg-quantum-window IDs. As in the
  // token window, an unknown verb answers its nothing, and a close whose opening fell out of the
  // window answers nothing=control-exceeds-window.
  def ftg-quantum-window() = 96;
  def ftg-quantum-next(session, stops, before, ids, nextf) {
   let fresh = ftg-quantum-controls(session, before, ids);
   nil?(fresh) ? nextf(session, stops) : ftg-quantum-answer(session, stops, fresh, nextf);
  }
  def ftg-quantum-controls(session, before, ids) {
   let n = len(before);
   let base = n > ftg-quantum-window() ? n - ftg-quantum-window() : 0;
   let tail = drop(base, ids);
   ftg-quantum-items(tkz-decode-text(fcms-src(session), take(n - base, tail)), tkz-decode-text(fcms-src(session), tail), base > 0);
  }
  // the controls of text whose close falls after the head (the text already answered)
  def ftg-fresh-controls(headText, text) = filter(c => c[3] > len(headText), ftg-scan-any(text));
  // fresh closes before the window's first complete control, whose opening the window cut
  def ftg-orphan-closes(headText, text) {
   let found = ftg-scan-any(text);
   let first = nil?(found) ? len(text) + 1 : found[0][2];
   filter(c => (c[3] > len(headText)) && (c[2] < first), ftg-closes(text, 0, []));
  }
  // [verb, payload, frame, answer]: answer is "" for a control Form runs, or the nothing it is
  def ftg-quantum-items(headText, text, cut) {
   let orphans = cut ? map(c => [c[0], "", ftg-close(c[0]), ftv-nothing("control-exceeds-window")], ftg-orphan-closes(headText, text)) : [];
   append(orphans, map(c => [c[0], c[1], ftg-render(c[0], c[1]), ""], ftg-fresh-controls(headText, text)));
  }
  // A coding reply is one JSON object, so a control inside one of its strings carries JSON
  // escapes; the payload Form reads is the string's value.
  def ftg-json-unescape(text) = ftg-unescape-at(text, 0, len(text), "");
  def ftg-unescape-at(text, i, n, out) = i >= n ? out : (str_byte_at(text, i) == 92) && (i + 1 < n) ? ftg-unescape-at(text, i + 2, n, out ++ ftg-escaped(substring(text, i + 1, i + 2))) : ftg-unescape-at(text, i + 1, n, out ++ substring(text, i, i + 1));
  def ftg-escaped(c) = c == "n" ? byte_to_str(10) : c == "t" ? byte_to_str(9) : c;
  // Without room the stream goes on unanswered: nothing touched KV, so nextf forwards as before.
  // The ledger's flag is what happened: 1 only when the observation entered and the session
  // resumed live. The stdout line names verbs and byte counts, never the control bytes, so a
  // reader of the lane's transcript counts the voice's controls once, in the reply.
  def ftg-quantum-answer(session, stops, items, nextf) {
   let results = map(c => len(c[3]) > 0 ? c[3] : ftg-observe-with(FTG-DEFAULT, c[0], ftg-json-unescape(c[1])), items);
   let ids = fcms-inline-bml-observation-ids(session, ftv-join(map(r => ftg-observation(r), results), byte_to_str(10)));
   let room = nothing?(ids) ? 0 : (fcms-pos(session) + len(ids) + 2) < fcms-maxpos(session);
   let resumed = room ? fcms-observe-ids(session, ids, "form-token-observation-refused") : nextf(session, stops);
   let injected = (room && fcms-live?(resumed)) ? 1 : 0;
   print_str("form-token-crossing " ++ json-emit(ftg-crossing-line("code", items, results, injected)));
   ftg-retain("code", map(c => c[2], items), results, map(c => injected, items));
   resumed;
  }
  def ftg-crossing-line(lane, items, results, injected) = json-node-object([json-node-pair("lane", json-node-string(lane)), json-node-pair("verbs", json-node-array(map(c => json-node-string(c[0]), items))), json-node-pair("control_bytes", json-node-array(map(c => json-node-int(len(c[2])), items))), json-node-pair("results", json-node-array(map(r => json-node-string(ftg-ledger-result(r)), results))), json-node-pair("injected", json-node-int(injected))]);

  // ── the crossing ledger ──────────────────────────────────────────────
  // One row per reply that crossed, in HearthDir(): the controls the voice wrote (model bytes),
  // the RESULT bodies Form answered, the envelope each answer came in, and per crossing whether
  // its observation entered the stream. A source observation (nodeid-knowledge-query) keeps its
  // body and names its envelope in sources, so no result carries an opening and a reader never
  // counts Form's words as the voice's. Every lane writes here: voice, code and reasoning.
  def ftg-ledger-dir() = HearthDir() ++ "/form-tokens";
  def ftg-ledger() = ftg-ledger-dir() ++ "/crossings.jsonl";
  def ftg-source-kind(text) = ftv-starts?(text, "<|form:") && (str_find(text, "|>", 7) > 7) ? substring(text, 7, str_find(text, "|>", 7)) : "observation";
  def ftg-ledger-result(text) {
   let open = str_find(text, "|>", 7);
   let close = ftv-last-index(text, "<|/form:");
   ftv-starts?(text, "<|form:") && (open > 7) && (close > open) ? substring(text, open + 2, close) : text;
  }
  // flags paired with n crossings: a crossing whose injection was never asked reads 0
  def ftg-pad(flags, n) = n <= 0 ? [] : cons(nil?(flags) ? 0 : flags[0], ftg-pad(nil?(flags) ? [] : flags[1:], n - 1));
  def ftg-crossing-row(lane, frames, results, injected) = json-node-object([json-node-pair("at_unix_ms", json-node-int(now_unix_ms())), json-node-pair("lane", json-node-string(lane)), json-node-pair("controls", json-node-array(map(f => json-node-string(f), frames))), json-node-pair("results", json-node-array(map(r => json-node-string(ftg-ledger-result(r)), results))), json-node-pair("sources", json-node-array(map(r => json-node-string(ftg-source-kind(r)), results))), json-node-pair("injected", json-node-array(map(f => json-node-int(f == 1 ? 1 : 0), ftg-pad(injected, len(frames)))))]);
  def ftg-retain(lane, frames, results, injected) {
   if nil?(frames) then 0 else {
    fs_mkdir(HearthDir());
    fs_mkdir(ftg-ledger-dir());
    sbt-append-count(ftg-ledger(), json-emit(ftg-crossing-row(lane, frames, results, injected)) ++ byte_to_str(10));
   };
  }

  // ── teaching ─────────────────────────────────────────────────────────
  def ftg-bml-teaching() = " BML names can contain hyphens. Space infix and conditional operators, as in c * c - e * e and flag ? yes : no. unknown-name identifies a missing binding; inspect spelling and operator spacing before changing numerical inputs.";
  def ftg-teaching() = "Form answers controls inside your stream. Write <|form:VERB|>PAYLOAD<|/form:VERB|> and stop there: before your next token Form adds <|form:observation|>RESULT<|/form:observation|>, where RESULT is value=...; recipe=@...; node=@...; or nothing=reason;. A nothing is evidence, not an answer. eval runs one pure BML expression: <|form:eval|>17 * 23 + 4<|/form:eval|> or <|form:eval|>[1,2,3] |> map(x => x * x) |> sum<|/form:eval|>; files, processes and host doors answer nothing. knowledge-query reads this body's sources: <|form:knowledge-query|>microthought codec<|/form:knowledge-query|>. node-make interns a node from a category and children: <|form:node-make|>pair;3,4<|/form:node-make|>. node-get reads one: <|form:node-get|>@p.l.t.i<|/form:node-get|> answers value=[kind, value, [children]];. node-select answers the first candidate n whose predicate holds: <|form:node-select|>kids(n)[0] > 3;@p.l.t.i,@p.l.t.i<|/form:node-select|>. recipe-birth also takes a BML function: <|form:recipe-birth|>bml;x => x * x + 1<|/form:recipe-birth|>, run with <|form:recipe-exec|>@p.l.t.i;input=5;carrier=auto<|/form:recipe-exec|>. choice tries recipes in order: <|form:choice|>@first,@next;input=5;carrier=auto<|/form:choice|>; an absent result continues to the next alternative in this stream. Copy addresses exactly from observations. One control at a time; prefer Form's observation to a guess, then answer the enquiry." + ftg-bml-teaching();
  // The coding lane's reply is one JSON object; its controls live inside a JSON string value.
  def ftg-coding-teaching() = "Form also answers controls you write inside a JSON string value of your reply. Close the control and pause: within your next few tokens Form adds the observation, so <|form:eval|>17 * 23 + 4<|/form:eval|> is followed by <|form:observation|>value=395;<|/form:observation|>, which you read but never copy into the JSON. Keep a control short; one too long to read back whole answers nothing. Verbs: eval (one pure BML expression; files, processes and host doors answer nothing), knowledge-query (this body's sources), node-make, node-get, node-select, recipe-birth, recipe-exec and choice. Escape quotes inside a payload as JSON requires. Ask Form for arithmetic and lookups instead of guessing; the reply stays one JSON object." + ftg-bml-teaching();
 }
 0;
}
