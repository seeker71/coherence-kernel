//////////////////////////////////////////////////////////////////////
//
// source-scan.bml — one byte scanner for any tongue, named by a lexicon.
//
// A lexicon is (source-lexicon keywords properties keyword-kind
// property-kind name-kind int-kind float-kind string-kind char-kind
// op-kind ops line-comment block-open block-close). source-scan-file reads
// a file and answers its token cells in order. Whitespace and comments
// pass. "..." and '...' decode \\ \' \" \n \t \r \0 and keep every other
// escaped byte. Digits read 0x hex, 0b binary, decimal, and a float with an
// optional exponent. A name takes the keyword, property or name kind. Any
// other byte starts the first op the lexicon lists there, or stands alone.
//
// preludes: form-stdlib/engine.fk
//
section [form.bml] {
    class SourceScan {
        def ssc-byte(s, i, n) = if (i < n) then str_byte_at(s, i) else -1;
        def ssc-has?(xs, v) = if nil?(xs) then 0 else if ((String) head(xs) == v) then 1 else ssc-has?(tail(xs), v);
        def ssc-at?(s, i, n, part) = if ((Comparable) str_len(part) == 0) then 0 else if ((i + str_len(part)) > n) then 0 else if ((String) substring(s, i, (i + str_len(part))) == part) then 1 else 0;
        def ssc-space?(c) = (((Comparable) c == 32) || (((Comparable) c == 9) || (((Comparable) c == 10) || ((Comparable) c == 13))));
        def ssc-digit?(c) = ((c >= 48) && (c <= 57));
        def ssc-hex?(c) = (ssc-digit?(c) || (((c >= 97) && (c <= 102)) || ((c >= 65) && (c <= 70))));
        def ssc-bin?(c) = (((Comparable) c == 48) || ((Comparable) c == 49));
        def ssc-name-start?(c) = (((c >= 97) && (c <= 122)) || (((c >= 65) && (c <= 90)) || ((Comparable) c == 95)));
        def ssc-name-char?(c) = (ssc-name-start?(c) || ssc-digit?(c));

        def ssc-line-end(s, i, n) = if (i >= n) then n else if ((Comparable) str_byte_at(s, i) == 10) then i else ssc-line-end(s, (i + 1), n);
        def ssc-skip-block(s, close, n, lex) = if (close < 0) then n else ssc-skip(s, (close + str_len(nth(lex, 14))), n, lex);
        def ssc-skip(s, i, n, lex) {
            let c = ssc-byte(s, i, n);
            if (i >= n) then n
            else if ssc-space?(c) then ssc-skip(s, (i + 1), n, lex)
            else if ((Comparable) ssc-at?(s, i, n, nth(lex, 12)) == 1) then ssc-skip(s, ssc-line-end(s, (i + str_len(nth(lex, 12))), n), n, lex)
            else if ((str_len(nth(lex, 14)) > 0) && ((Comparable) ssc-at?(s, i, n, nth(lex, 13)) == 1)) then ssc-skip-block(s, str_find(s, nth(lex, 14), (i + str_len(nth(lex, 13)))), n, lex)
            else i;
        }

        def ssc-escape(b) = if ((Comparable) b == 110) then byte_to_str(10) else if ((Comparable) b == 116) then byte_to_str(9) else if ((Comparable) b == 114) then byte_to_str(13) else if ((Comparable) b == 48) then byte_to_str(0) else byte_to_str(b);
        // A plain run takes its first byte and ends at the closing quote or a
        // backslash. Both are single bytes, so a run is one whole slice on
        // every kernel, and a longer character inside it never splits.
        def ssc-run-end(s, j, n, q) = ssc-run-scan(s, (j + 1), n, q);
        def ssc-run-scan(s, j, n, q) {
            let c = ssc-byte(s, j, n);
            if (j >= n) then n else if (((Comparable) c == q) || ((Comparable) c == 92)) then j else ssc-run-scan(s, (j + 1), n, q);
        }
        // continuation bytes (128-191) travel with the byte that opens them
        def ssc-char-end(s, j, n) {
            let c = ssc-byte(s, j, n);
            if ((c >= 128) && (c <= 191)) then ssc-char-end(s, (j + 1), n) else j;
        }
        def ssc-escaped-end(s, j, n) = if (str_byte_at(s, (j + 1)) < 128) then (j + 2) else ssc-char-end(s, (j + 2), n);
        def ssc-escaped(s, j, n) = if (str_byte_at(s, (j + 1)) < 128) then ssc-escape(str_byte_at(s, (j + 1))) else substring(s, (j + 1), ssc-escaped-end(s, j, n));
        def ssc-quoted(s, j, n, q, acc) {
            let c = ssc-byte(s, j, n);
            if (j >= n) then list(acc, j)
            else if (((Comparable) c == 92) && ((j + 1) < n)) then ssc-quoted(s, ssc-escaped-end(s, j, n), n, q, str_concat(acc, ssc-escaped(s, j, n)))
            else if ((Comparable) c == q) then list(acc, (j + 1))
            else ssc-quoted-from(s, j, ssc-run-end(s, j, n, q), n, q, acc);
        }
        def ssc-quoted-from(s, j, e, n, q, acc) = ssc-quoted(s, e, n, q, str_concat(acc, substring(s, j, e)));

        def ssc-run-digits(s, j, n) = if ssc-digit?(ssc-byte(s, j, n)) then ssc-run-digits(s, (j + 1), n) else j;
        def ssc-run-hex(s, j, n) = if ssc-hex?(ssc-byte(s, j, n)) then ssc-run-hex(s, (j + 1), n) else j;
        def ssc-run-bin(s, j, n) = if ssc-bin?(ssc-byte(s, j, n)) then ssc-run-bin(s, (j + 1), n) else j;
        def ssc-exponent(s, j, n) {
            let e = ssc-byte(s, j, n);
            let sign = ssc-byte(s, (j + 1), n);
            let k = if (((Comparable) sign == 43) || ((Comparable) sign == 45)) then (j + 2) else (j + 1);
            if (!(((Comparable) e == 101) || ((Comparable) e == 69))) then j
            else if ssc-digit?(ssc-byte(s, k, n)) then ssc-run-digits(s, (k + 1), n)
            else j;
        }
        def ssc-number(s, i, n, lex) {
            let c = ssc-byte(s, i, n);
            let nb = ssc-byte(s, (i + 1), n);
            let d = ssc-run-digits(s, (i + 1), n);
            if (((Comparable) c == 48) && (((Comparable) nb == 120) || ((Comparable) nb == 88))) then list(nth(lex, 6), ssc-run-hex(s, (i + 2), n))
            else if (((Comparable) c == 48) && (((Comparable) nb == 98) || ((Comparable) nb == 66))) then list(nth(lex, 6), ssc-run-bin(s, (i + 2), n))
            else if (((Comparable) ssc-byte(s, d, n) == 46) && ssc-digit?(ssc-byte(s, (d + 1), n))) then list(nth(lex, 7), ssc-exponent(s, ssc-run-digits(s, (d + 1), n), n))
            else list(nth(lex, 6), d);
        }

        def ssc-run-name(s, j, n) = if ssc-name-char?(ssc-byte(s, j, n)) then ssc-run-name(s, (j + 1), n) else j;
        def ssc-name-kind(lex, v) = if ((Comparable) ssc-has?(nth(lex, 1), v) == 1) then nth(lex, 3) else if ((Comparable) ssc-has?(nth(lex, 2), v) == 1) then nth(lex, 4) else nth(lex, 5);
        // a byte no op starts stands alone, a longer character with its continuation bytes
        def ssc-op(s, i, n, ops) = if nil?(ops) then substring(s, i, ssc-char-end(s, (i + 1), n)) else if ((Comparable) ssc-at?(s, i, n, head(ops)) == 1) then head(ops) else ssc-op(s, i, n, tail(ops));

        def ssc-quote-token(s, i, n, lex, acc, q, kind) {
            let r = ssc-quoted(s, (i + 1), n, q, "");
            ssc-loop(s, nth(r, 1), n, lex, cons(bmf-atom(kind, nth(r, 0)), acc));
        }
        def ssc-number-token(s, i, n, lex, acc, r) = ssc-loop(s, nth(r, 1), n, lex, cons(bmf-atom(nth(r, 0), substring(s, i, nth(r, 1))), acc));
        def ssc-name-token(s, i, n, lex, acc, e) = ssc-loop(s, e, n, lex, cons(bmf-atom(ssc-name-kind(lex, substring(s, i, e)), substring(s, i, e)), acc));
        def ssc-op-token(s, i, n, lex, acc, op) = ssc-loop(s, (i + str_len(op)), n, lex, cons(bmf-atom(nth(lex, 10), op), acc));
        def ssc-token(s, i, n, lex, acc) {
            let c = str_byte_at(s, i);
            if ((Comparable) c == 34) then ssc-quote-token(s, i, n, lex, acc, 34, nth(lex, 8))
            else if ((Comparable) c == 39) then ssc-quote-token(s, i, n, lex, acc, 39, nth(lex, 9))
            else if ssc-digit?(c) then ssc-number-token(s, i, n, lex, acc, ssc-number(s, i, n, lex))
            else if ssc-name-start?(c) then ssc-name-token(s, i, n, lex, acc, ssc-run-name(s, (i + 1), n))
            else ssc-op-token(s, i, n, lex, acc, ssc-op(s, i, n, nth(lex, 11)));
        }
        def ssc-loop(s, i, n, lex, acc) {
            let at = ssc-skip(s, i, n, lex);
            if (at >= n) then reverse-list(acc) else ssc-token(s, at, n, lex, acc);
        }

        def source-scan-text(s, lex) = if ((String) nth(lex, 0) == "source-lexicon") then ssc-loop(s, 0, str_len(s), lex, empty()) else form_error("source-scan: the lexicon is not a (source-lexicon ...)");
        def source-scan-file(path, lex) {
            let text = read_file(path);
            if nothing?(text) then form_error(str_concat("source-scan: cannot read ", path)) else source-scan-text(text, lex);
        }
    }
}
