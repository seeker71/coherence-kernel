//////////////////////////////////////////////////////////////////////
//
// source-scan.bml — one byte scanner for any tongue, named by a lexicon.
//
// A lexicon is (source-lexicon keywords properties keyword-kind
// property-kind name-kind int-kind float-kind string-kind char-kind
// op-kind ops line-comment block-open block-close). source-scan-file reads
// a file and answers its token cells in order. Whitespace and comments
// pass. "..." and '...' decode \\ \' \" \n \t \r \0 and keep every other
// escaped byte. Digits read 0x hex, 0b binary, decimal, and a float with an
// optional exponent. A name takes the keyword, property or name kind. Any
// other byte starts the first op the lexicon lists there, or stands alone.
//
// preludes: form-stdlib/engine.fk
//
section [form.bml] {
    class SourceScan {
        def ssc-byte(s, i, n) = i < n ? str_byte_at(s, i) : -1;
        def ssc-has?(xs, v) = nil?(xs) ? 0 : (String) head(xs) == v ? 1 : ssc-has?(tail(xs), v);
        def ssc-at?(s, i, n, part) = (Comparable) str_len(part) == 0 ? 0 : (i + str_len(part)) > n ? 0 : (String) substring(s, i, i + str_len(part)) == part ? 1 : 0;
        def ssc-space?(c) = ((Comparable) c == 32) || (((Comparable) c == 9) || (((Comparable) c == 10) || ((Comparable) c == 13)));
        def ssc-digit?(c) = (c >= 48) && (c <= 57);
        def ssc-hex?(c) = ssc-digit?(c) || (((c >= 97) && (c <= 102)) || ((c >= 65) && (c <= 70)));
        def ssc-bin?(c) = ((Comparable) c == 48) || ((Comparable) c == 49);
        def ssc-name-start?(c) = ((c >= 97) && (c <= 122)) || (((c >= 65) && (c <= 90)) || ((Comparable) c == 95));
        def ssc-name-char?(c) = ssc-name-start?(c) || ssc-digit?(c);

        def ssc-line-end(s, i, n) = i >= n ? n : (Comparable) str_byte_at(s, i) == 10 ? i : ssc-line-end(s, i + 1, n);
        def ssc-skip-block(s, close, n, lex) = close < 0 ? n : ssc-skip(s, close + str_len(lex[14]), n, lex);
        def ssc-skip(s, i, n, lex) {
            let c = ssc-byte(s, i, n);
            i >= n ? n
            : ssc-space?(c) ? ssc-skip(s, i + 1, n, lex)
            : (Comparable) ssc-at?(s, i, n, lex[12]) == 1 ? ssc-skip(s, ssc-line-end(s, i + str_len(lex[12]), n), n, lex)
            : (str_len(lex[14]) > 0) && ((Comparable) ssc-at?(s, i, n, lex[13]) == 1) ? ssc-skip-block(s, str_find(s, lex[14], i + str_len(lex[13])), n, lex)
            : i;
        }

        def ssc-escape(b) = (Comparable) b == 110 ? byte_to_str(10) : (Comparable) b == 116 ? byte_to_str(9) : (Comparable) b == 114 ? byte_to_str(13) : (Comparable) b == 48 ? byte_to_str(0) : byte_to_str(b);
        // A plain run takes its first byte and ends at the closing quote or a
        // backslash. Both are single bytes, so a run is one whole slice on
        // every kernel, and a longer character inside it never splits.
        def ssc-run-end(s, j, n, q) = ssc-run-scan(s, j + 1, n, q);
        def ssc-run-scan(s, j, n, q) {
            let c = ssc-byte(s, j, n);
            j >= n ? n : ((Comparable) c == q) || ((Comparable) c == 92) ? j : ssc-run-scan(s, j + 1, n, q);
        }
        // continuation bytes (128-191) travel with the byte that opens them
        def ssc-char-end(s, j, n) {
            let c = ssc-byte(s, j, n);
            (c >= 128) && (c <= 191) ? ssc-char-end(s, j + 1, n) : j;
        }
        def ssc-escaped-end(s, j, n) = str_byte_at(s, j + 1) < 128 ? (j + 2) : ssc-char-end(s, j + 2, n);
        def ssc-escaped(s, j, n) = str_byte_at(s, j + 1) < 128 ? ssc-escape(str_byte_at(s, j + 1)) : substring(s, j + 1, ssc-escaped-end(s, j, n));
        def ssc-quoted(s, j, n, q, acc) {
            let c = ssc-byte(s, j, n);
            j >= n ? list(acc, j)
            : ((Comparable) c == 92) && ((j + 1) < n) ? ssc-quoted(s, ssc-escaped-end(s, j, n), n, q, acc ++ ssc-escaped(s, j, n))
            : (Comparable) c == q ? list(acc, j + 1)
            : ssc-quoted-from(s, j, ssc-run-end(s, j, n, q), n, q, acc);
        }
        def ssc-quoted-from(s, j, e, n, q, acc) = ssc-quoted(s, e, n, q, acc ++ substring(s, j, e));

        def ssc-run-digits(s, j, n) = ssc-digit?(ssc-byte(s, j, n)) ? ssc-run-digits(s, j + 1, n) : j;
        def ssc-run-hex(s, j, n) = ssc-hex?(ssc-byte(s, j, n)) ? ssc-run-hex(s, j + 1, n) : j;
        def ssc-run-bin(s, j, n) = ssc-bin?(ssc-byte(s, j, n)) ? ssc-run-bin(s, j + 1, n) : j;
        def ssc-exponent(s, j, n) {
            let e = ssc-byte(s, j, n);
            let sign = ssc-byte(s, j + 1, n);
            let k = ((Comparable) sign == 43) || ((Comparable) sign == 45) ? (j + 2) : (j + 1);
            !(((Comparable) e == 101) || ((Comparable) e == 69)) ? j
            : ssc-digit?(ssc-byte(s, k, n)) ? ssc-run-digits(s, k + 1, n)
            : j;
        }
        def ssc-number(s, i, n, lex) {
            let c = ssc-byte(s, i, n);
            let nb = ssc-byte(s, i + 1, n);
            let d = ssc-run-digits(s, i + 1, n);
            ((Comparable) c == 48) && (((Comparable) nb == 120) || ((Comparable) nb == 88)) ? list(lex[6], ssc-run-hex(s, i + 2, n))
            : ((Comparable) c == 48) && (((Comparable) nb == 98) || ((Comparable) nb == 66)) ? list(lex[6], ssc-run-bin(s, i + 2, n))
            : ((Comparable) ssc-byte(s, d, n) == 46) && ssc-digit?(ssc-byte(s, d + 1, n)) ? list(lex[7], ssc-exponent(s, ssc-run-digits(s, d + 1, n), n))
            : list(lex[6], d);
        }

        def ssc-run-name(s, j, n) = ssc-name-char?(ssc-byte(s, j, n)) ? ssc-run-name(s, j + 1, n) : j;
        def ssc-name-kind(lex, v) = (Comparable) ssc-has?(lex[1], v) == 1 ? lex[3] : (Comparable) ssc-has?(lex[2], v) == 1 ? lex[4] : lex[5];
        // a byte no op starts stands alone, a longer character with its continuation bytes
        def ssc-op(s, i, n, ops) = nil?(ops) ? substring(s, i, ssc-char-end(s, i + 1, n)) : (Comparable) ssc-at?(s, i, n, head(ops)) == 1 ? head(ops) : ssc-op(s, i, n, tail(ops));

        def ssc-quote-token(s, i, n, lex, acc, q, kind) {
            let r = ssc-quoted(s, i + 1, n, q, "");
            ssc-loop(s, r[1], n, lex, cons(bmf-atom(kind, r[0]), acc));
        }
        def ssc-number-token(s, i, n, lex, acc, r) = ssc-loop(s, r[1], n, lex, cons(bmf-atom(r[0], substring(s, i, r[1])), acc));
        def ssc-name-token(s, i, n, lex, acc, e) = ssc-loop(s, e, n, lex, cons(bmf-atom(ssc-name-kind(lex, substring(s, i, e)), substring(s, i, e)), acc));
        def ssc-op-token(s, i, n, lex, acc, op) = ssc-loop(s, i + str_len(op), n, lex, cons(bmf-atom(lex[10], op), acc));
        def ssc-token(s, i, n, lex, acc) {
            let c = str_byte_at(s, i);
            (Comparable) c == 34 ? ssc-quote-token(s, i, n, lex, acc, 34, lex[8])
            : (Comparable) c == 39 ? ssc-quote-token(s, i, n, lex, acc, 39, lex[9])
            : ssc-digit?(c) ? ssc-number-token(s, i, n, lex, acc, ssc-number(s, i, n, lex))
            : ssc-name-start?(c) ? ssc-name-token(s, i, n, lex, acc, ssc-run-name(s, i + 1, n))
            : ssc-op-token(s, i, n, lex, acc, ssc-op(s, i, n, lex[11]));
        }
        def ssc-loop(s, i, n, lex, acc) {
            let at = ssc-skip(s, i, n, lex);
            at >= n ? reverse-list(acc) : ssc-token(s, at, n, lex, acc);
        }

        def source-scan-text(s, lex) = (String) lex[0] == "source-lexicon" ? ssc-loop(s, 0, str_len(s), lex, empty()) : form_error("source-scan: the lexicon is not a (source-lexicon ...)");
        def source-scan-file(path, lex) {
            let text = read_file(path);
            nothing?(text) ? form_error("source-scan: cannot read " ++ path) : source-scan-text(text, lex);
        }
    }
}
