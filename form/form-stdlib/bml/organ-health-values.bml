// One observation/correlation reducer over JSON values. Node-facing APIs wrap
// immutable nodes and explicitly materialize the result; retained readers keep
// values rooted only by their current state and deliberately held snapshots.
// preludes: form-stdlib/bml/json-view.bml form-stdlib/bml/native-owner-clock.bml
section [form.bml] {
 class OrganHealthValues {
  def ohv-str(row,key) = (Comparable) jv-kind(jv-get(row,key)) == 3 ? jv-str(row,key) : "";
  def ohv-has(values,value) = nil?(values) ? 0 : (((String) head(values) == value) || ohv-has(tail(values),value));
  def ohv-text(row,key) = ((Comparable) jv-kind(jv-get(row,key)) == 3) && (str_len(ohv-str(row,key)) > 0);
  def ohv-is-int(value,number) = ((Comparable) jv-kind(value) == 4) && ((Comparable) jv-value(value) == number);
  def ohv-health(value) = ((Comparable) jv-kind(value) == 8) || (ohv-is-int(value,0) || ohv-is-int(value,1));
  def ohv-array(row,key) = (Comparable) jv-kind(jv-get(row,key)) == 2;
  def ohv-valid(row) = ((String) ohv-str(row,"schema") == "organ-health-v1") && (ohv-text(row,"id") && (ohv-text(row,"organ") && (ohv-text(row,"flow") && (ohv-text(row,"aspect") && (ohv-has(list("observe","response","applied"),ohv-str(row,"stage")) && (jv-has(row,"expected") && (jv-has(row,"observed") && (ohv-health(jv-get(row,"health")) && (ohv-array(row,"needs") && ohv-array(row,"offers"))))))))));
  def ohv-pain(row) = ohv-is-int(jv-get(row,"health"),0);
  def ohv-unease(row) = ohv-valid(row) && (ohv-pain(row) || (((Comparable) jv-kind(jv-get(row,"health")) == 8) || ((!nil?(jv-items(jv-get(row,"needs")))) || ohv-is-int(jv-get(row,"surprise"),1))));
  def ohv-extract(row) = (String) ohv-str(row,"schema") == "organ-health-v1" ? row : jv-has(row,"health") ? jv-get(row,"health") : jv-null();
  def ohv-key(row) = jv-emit(jv-array(list(jv-get(row,"organ"),jv-get(row,"flow"),jv-get(row,"aspect"))));
  def ohv-replace(rows,row) = nil?(rows) ? list(row) : (String) ohv-key(head(rows)) == ohv-key(row) ? cons(row,tail(rows)) : cons(head(rows),ohv-replace(tail(rows),row));
  def ohv-observed(row) = jv-has(row,"observed_at_ms") ? row : jv-set(row,"observed_at_ms",jv-get(row,"at_ms"));
  def ohv-find(rows,row) = nil?(rows) ? jv-null() : (String) ohv-key(head(rows)) == ohv-key(row) ? head(rows) : ohv-find(tail(rows),row);
  def ohv-strings(values) = nil?(values) ? list() : cons(jv-string(head(values)),ohv-strings(tail(values)));
  def ohv-values(views) = nil?(views) ? list() : cons(jv-value(head(views)),ohv-values(tail(views)));
  def ohv-need(resource,detail) = jv-object(list(jv-s("resource",resource),jv-pair("detail",detail)));
  def ohv-reference(path) = jv-object(list(jv-s("path",path),jv-n("bytes",file_size(path)),jv-n("observed_unix_ms",now_unix_ms())));
  def ohv-reading(organ,flow,aspect,expected,observed,health,needs,offers,evidence) = ohv-reading-with-id(noc-open() ++ ":" ++ flow ++ ":" ++ aspect,organ,flow,aspect,expected,observed,health,needs,offers,evidence);
  def ohv-reading-with-id(id,organ,flow,aspect,expected,observed,health,needs,offers,evidence) {
   (String) id == "" ? form_error("organ health reading identity is empty") : 0;
   let at = now_unix_ms();
   jv-object(list(jv-s("schema","organ-health-v1"),jv-s("id",id),jv-s("organ",organ),jv-s("flow",flow),jv-s("aspect",aspect),jv-s("stage","observe"),jv-pair("expected",expected),jv-pair("observed",observed),jv-pair("health",health),jv-n("surprise",!jv-equal(expected,observed)),jv-pair("needs",jv-array(needs)),jv-pair("offers",jv-array(ohv-strings(offers))),jv-s("selected",""),jv-pair("evidence",evidence),jv-n("observed_at_ms",at),jv-n("at_ms",at)));
  }
  // Public operational metadata only. Values, need details, evidence and action
  // results stay with the owning organ; frame identity correlates their care.
  def ohv-frame-view(row) {
   def resource(need) = jv-get(need,"resource");
   let attention = jv-get(row,"attention");
   let fields = map(key => jv-pair(key,jv-get(row,key)),list("id","organ","flow","aspect","stage","health","surprise",
    "offers","selected","at_ms","observed_at_ms","elapsed_ms","care_of","responder"));
   jv-object(append(fields,list(
    jv-s("schema","organ-frame-v1"),
    jv-pair("needs",jv-array(map(resource,jv-items(jv-get(row,"needs"))))),
    jv-pair("attention",jv-object(list(
     jv-pair("state",jv-get(attention,"state")),
     jv-pair("provider",jv-get(attention,"provider")),
     jv-pair("resource",resource(jv-get(attention,"need")))))))));
  }
  def ohv-frame(row) = fb_record(jv-materialize(ohv-frame-view(row)),"organ-health.bml",ohv-pain(row) ? 1 : 0);
  def ohv-attentions(rows,attention) = nil?(rows) ? list(attention) : jv-equal(jv-get(head(rows),"need"),jv-get(attention,"need")) ? cons(attention,tail(rows)) : cons(head(rows),ohv-attentions(tail(rows),attention));
  def ohv-attention-reading(held,row) {
   let prior = ohv-find(held,row); let bound = ohv-valid(prior) && ((String) ohv-str(prior,"id") == ohv-str(row,"id"));
   !bound ? held : ohv-replace(held,jv-set(jv-set(prior,"attention",jv-get(row,"attention")),"attentions",jv-array(ohv-attentions(ohv-array(prior,"attentions") ? jv-items(jv-get(prior,"attentions")) : list(),jv-get(row,"attention")))));
  }
  def ohv-control-metadata(held,row) {
   let clean = jv-has(row,"care_need") ? jv-remove(held,"care_delivery") : held;
   let responder = jv-has(row,"responder") ? jv-set(clean,"responder",jv-get(row,"responder")) : clean;
   let need = jv-has(row,"care_need") ? jv-set(responder,"care_need",jv-get(row,"care_need")) : responder;
   jv-has(row,"care_of") ? jv-set(need,"care_of",jv-get(row,"care_of")) : need;
  }
  def ohv-offered(values,action) = nil?(values) ? 0 : ((((Comparable) jv-kind(head(values)) == 3) && ((String) jv-value(head(values)) == action)) || ohv-offered(tail(values),action));
  def ohv-correlation(id,row) = ohv-reading-with-id(id,"health-flow",ohv-str(row,"flow"),"control-correlation",jv-string("response bound to an observed offer"),jv-string(ohv-str(row,"id")),jv-int(0),list(ohv-need("correlated-observation",jv-get(row,"evidence"))),list("request-evidence","defer"),jv-get(row,"evidence"));
  def ohv-correlation-owned(row,context) = ohv-correlation(noc-open() ++ ":" ++ ohv-str(row,"flow") ++ ":control-correlation",row);
  def ohv-control-reading(held,row) = ohv-control-through(held,row,ohv-correlation-owned,nothing());
  def ohv-control-through(held,row,diagnostic,context) {
   let prior = ohv-find(held,row);
   let bound = ohv-valid(prior) && (((String) ohv-str(prior,"id") == ohv-str(row,"id")) && ohv-offered(jv-items(jv-get(prior,"offers")),ohv-str(row,"selected")));
   bound ? ohv-replace(held,ohv-control-metadata(jv-set(jv-set(jv-set(jv-set(prior,"stage",jv-get(row,"stage")),"selected",jv-get(row,"selected")),"result",jv-get(row,"result")),"at_ms",jv-get(row,"at_ms")),row)) : ohv-replace(held,diagnostic(row,context));
  }
  def ohv-one(row,held,diagnostic,context) = !ohv-valid(row) ? held : (String) ohv-str(row,"stage") == "observe" ? (jv-has(row,"attention") ? ohv-attention-reading(held,row) : ohv-replace(held,ohv-observed(row))) : ohv-control-through(held,row,diagnostic,context);
  def ohv-current(rows,held) = ohv-current-through(rows,held,ohv-correlation-owned,nothing());
  def ohv-current-through(rows,held,diagnostic,context) = nil?(rows) ? held : ohv-current-through(tail(rows),ohv-one(ohv-extract(head(rows)),held,diagnostic,context),diagnostic,context);
  def ohv-age(rows,now) = nil?(rows) ? list() : cons(jv-overlay(head(rows),list(jv-pair("observation_age_ms",jv-has(head(rows),"observed_at_ms") ? jv-int(now - jv-value(jv-get(head(rows),"observed_at_ms"))) : jv-null()))),ohv-age(tail(rows),now));
 }
 0;
}
