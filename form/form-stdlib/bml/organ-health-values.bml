// One observation/correlation reducer over JSON values. Node-facing APIs wrap
// immutable nodes and explicitly materialize the result; retained readers keep
// values rooted only by their current state and deliberately held snapshots.
// preludes: form-stdlib/bml/json-view.bml form-stdlib/bml/native-owner-clock.bml
section [form.bml] {
 class OrganHealthValues {
  def ohv-str(row,key) = if ((Comparable) jv-kind(jv-get(row,key)) == 3) then jv-str(row,key) else "";
  def ohv-has(values,value) = any?((item: String) => item == value,values);
  def ohv-text(row,key) = (((Comparable) jv-kind(jv-get(row,key)) == 3) && (str_len(ohv-str(row,key)) > 0));
  def ohv-is-int(value,number) = (((Comparable) jv-kind(value) == 4) && ((Comparable) jv-value(value) == number));
  def ohv-health(value) = (((Comparable) jv-kind(value) == 8) || (ohv-is-int(value,0) || ohv-is-int(value,1)));
  def ohv-array(row,key) = ((Comparable) jv-kind(jv-get(row,key)) == 2);
  def ohv-valid(row) = (((String) ohv-str(row,"schema") == "organ-health-v1") && (ohv-text(row,"id") && (ohv-text(row,"organ") && (ohv-text(row,"flow") && (ohv-text(row,"aspect") && (ohv-has(["observe","response","applied"],ohv-str(row,"stage")) && (jv-has(row,"expected") && (jv-has(row,"observed") && (ohv-health(jv-get(row,"health")) && (ohv-array(row,"needs") && ohv-array(row,"offers")))))))))));
  def ohv-pain(row) = ohv-is-int(jv-get(row,"health"),0);
  def ohv-unease(row) = (ohv-valid(row) && (ohv-pain(row) || (((Comparable) jv-kind(jv-get(row,"health")) == 8) || ((!nil?(jv-items(jv-get(row,"needs")))) || ohv-is-int(jv-get(row,"surprise"),1)))));
  def ohv-extract(row) = if ((String) ohv-str(row,"schema") == "organ-health-v1") then row else if jv-has(row,"health") then jv-get(row,"health") else jv-null();
  def ohv-key(row) = jv-emit(jv-array([jv-get(row,"organ"),jv-get(row,"flow"),jv-get(row,"aspect")]));
  def ohv-replace(rows,row) = if nil?(rows) then [row] else if ((String) ohv-key(head(rows)) == ohv-key(row)) then cons(row,tail(rows)) else cons(head(rows),ohv-replace(tail(rows),row));
  def ohv-observed(row) = if jv-has(row,"observed_at_ms") then row else jv-set(row,"observed_at_ms",jv-get(row,"at_ms"));
  def ohv-find(rows,row) = if nil?(rows) then jv-null() else if ((String) ohv-key(head(rows)) == ohv-key(row)) then head(rows) else ohv-find(tail(rows),row);
  def ohv-strings(values) = if nil?(values) then [] else cons(jv-string(head(values)),ohv-strings(tail(values)));
  def ohv-values(views) = if nil?(views) then [] else cons(jv-value(head(views)),ohv-values(tail(views)));
  def ohv-need(resource,detail) = jv-object([jv-s("resource",resource),jv-pair("detail",detail)]);
  def ohv-reference(path) = jv-object([jv-s("path",path),jv-n("bytes",file_size(path)),jv-n("observed_unix_ms",now_unix_ms())]);
  def ohv-reading(organ,flow,aspect,expected,observed,health,needs,offers,evidence) = ohv-reading-with-id(str_concat(noc-open(),str_concat(":",str_concat(flow,str_concat(":",aspect)))),organ,flow,aspect,expected,observed,health,needs,offers,evidence);
  def ohv-reading-with-id(id,organ,flow,aspect,expected,observed,health,needs,offers,evidence) {
   if ((String) id == "") then form_error("organ health reading identity is empty") else 0;
   let at = now_unix_ms();
   jv-object([jv-s("schema","organ-health-v1"),jv-s("id",id),jv-s("organ",organ),jv-s("flow",flow),jv-s("aspect",aspect),jv-s("stage","observe"),jv-pair("expected",expected),jv-pair("observed",observed),jv-pair("health",health),jv-n("surprise",(!jv-equal(expected,observed))),jv-pair("needs",jv-array(needs)),jv-pair("offers",jv-array(ohv-strings(offers))),jv-s("selected",""),jv-pair("evidence",evidence),jv-n("observed_at_ms",at),jv-n("at_ms",at)]);
  }
  // Public operational metadata only. Values, need details, evidence and action
  // results stay with the owning organ; frame identity correlates their care.
  def ohv-frame-view(row) {
   def field(key) = jv-pair(key,jv-get(row,key));
   def resource(need) = jv-get(need,"resource");
   let attention = jv-get(row,"attention");
   let fields = map(field,["id","organ","flow","aspect","stage","health","surprise",
    "offers","selected","at_ms","observed_at_ms","elapsed_ms","care_of","responder"]);
   jv-object(append(fields,[
    jv-s("schema","organ-frame-v1"),
    jv-pair("needs",jv-array(map(resource,jv-items(jv-get(row,"needs"))))),
    jv-pair("attention",jv-object([
     jv-pair("state",jv-get(attention,"state")),
     jv-pair("provider",jv-get(attention,"provider")),
     jv-pair("resource",resource(jv-get(attention,"need")))]))]));
  }
  def ohv-frame(row) = fb_record(jv-materialize(ohv-frame-view(row)),"organ-health.bml",if ohv-pain(row) then 1 else 0);
  def ohv-attentions(rows,attention) = if nil?(rows) then [attention] else if jv-equal(jv-get(head(rows),"need"),jv-get(attention,"need")) then cons(attention,tail(rows)) else cons(head(rows),ohv-attentions(tail(rows),attention));
  def ohv-attention-reading(held,row) {
   let prior = ohv-find(held,row); let bound = (ohv-valid(prior) && ((String) ohv-str(prior,"id") == ohv-str(row,"id")));
   if (!bound) then held else ohv-replace(held,jv-set(jv-set(prior,"attention",jv-get(row,"attention")),"attentions",jv-array(ohv-attentions(if ohv-array(prior,"attentions") then jv-items(jv-get(prior,"attentions")) else [],jv-get(row,"attention")))));
  }
  def ohv-control-metadata(held,row) {
   let clean = if jv-has(row,"care_need") then jv-remove(held,"care_delivery") else held;
   let responder = if jv-has(row,"responder") then jv-set(clean,"responder",jv-get(row,"responder")) else clean;
   let need = if jv-has(row,"care_need") then jv-set(responder,"care_need",jv-get(row,"care_need")) else responder;
   if jv-has(row,"care_of") then jv-set(need,"care_of",jv-get(row,"care_of")) else need;
  }
  def ohv-offered(values,action) = if nil?(values) then 0 else ((((Comparable) jv-kind(head(values)) == 3) && ((String) jv-value(head(values)) == action)) || ohv-offered(tail(values),action));
  def ohv-correlation(id,row) = ohv-reading-with-id(id,"health-flow",ohv-str(row,"flow"),"control-correlation",jv-string("response bound to an observed offer"),jv-string(ohv-str(row,"id")),jv-int(0),[ohv-need("correlated-observation",jv-get(row,"evidence"))],["request-evidence","defer"],jv-get(row,"evidence"));
  def ohv-correlation-owned(row,context) = ohv-correlation(str_concat(noc-open(),str_concat(":",str_concat(ohv-str(row,"flow"),":control-correlation"))),row);
  def ohv-control-reading(held,row) = ohv-control-through(held,row,ohv-correlation-owned,nothing());
  def ohv-control-through(held,row,diagnostic,context) {
   let prior = ohv-find(held,row);
   let bound = (ohv-valid(prior) && (((String) ohv-str(prior,"id") == ohv-str(row,"id")) && ohv-offered(jv-items(jv-get(prior,"offers")),ohv-str(row,"selected"))));
   if bound then ohv-replace(held,ohv-control-metadata(jv-set(jv-set(jv-set(jv-set(prior,"stage",jv-get(row,"stage")),"selected",jv-get(row,"selected")),"result",jv-get(row,"result")),"at_ms",jv-get(row,"at_ms")),row)) else ohv-replace(held,diagnostic(row,context));
  }
  def ohv-one(row,held,diagnostic,context) = if (!ohv-valid(row)) then held else if ((String) ohv-str(row,"stage") == "observe") then if jv-has(row,"attention") then ohv-attention-reading(held,row) else ohv-replace(held,ohv-observed(row)) else ohv-control-through(held,row,diagnostic,context);
  def ohv-current(rows,held) = ohv-current-through(rows,held,ohv-correlation-owned,nothing());
  def ohv-current-through(rows,held,diagnostic,context) = if nil?(rows) then held else ohv-current-through(tail(rows),ohv-one(ohv-extract(head(rows)),held,diagnostic,context),diagnostic,context);
  def ohv-age(rows,now) = if nil?(rows) then [] else cons(jv-overlay(head(rows),[jv-pair("observation_age_ms",if jv-has(head(rows),"observed_at_ms") then jv-int((now - jv-value(jv-get(head(rows),"observed_at_ms")))) else jv-null())]),ohv-age(tail(rows),now));
 }
 0;
}
