// The deterministic build keeps one native process through its downstream owners.
// preludes: form-stdlib/bml/concept-substantive-builder.bml form-stdlib/bml/concept-roundtrip-builder.bml form-stdlib/bml/concept-human-reindex.bml
section [form.bml] {
 class ConceptSubstantiveWorkflow {
  def csbw-run(root,engine) {
   let admitted = csb-root(root);
   let artifacts = csb-run(admitted,engine);
   let materialized = cmm-run(admitted,engine);
   let roundtrip = crb-run(admitted,engine);
   let corpus = chr-run(admitted,engine);
   let state = cmm-state(admitted,engine);
   csb-check(state,"complete-downstream-publication",and(eq(artifacts,9),and(eq(materialized,1),and(eq(roundtrip,1),eq(corpus,1)))));
   print_str(json-emit-precise(json-node-object(list(oh-s("schema","form-substantive-build-v1"),oh-n("stableIds",111),oh-n("aliases",111),oh-n("definitions",111),oh-n("attributedCells",1443),oh-n("directArtifacts",artifacts),oh-s("acquisition","held-evidence"),oh-s("translations","machine-translated-unreviewed")))));
   1;
  }
  def csbw-request(text) {
   if not(jwa-valid(text)) then csa-input-refused("complete substantive build JSON required") else 0;
   let request = parse-json("concept-substantive-build-request",text);
   if not(node_eq(node_category(request),JSON-OBJECT())) then csa-input-refused("substantive build object required") else 0;
   if not(csa-request-fields(json-object-pairs(request),list())) then csa-input-refused("unique root/hash string fields required") else 0;
   csbw-run(if json-object-has?(request,"root") then json-string-value(json-object-get(request,"root")) else ".",if json-object-has?(request,"hash") then json-string-value(json-object-get(request,"hash")) else "form-sha256");
  }
  def csbw-home() {
   let text = read_line();
   if or(nothing?(text),str_eq(text,"")) then csbw-run(".","form-sha256") else csbw-request(text);
  }
 }
 0;
}
