// session-transcript.bml — a Claude Code session transcript read as data: the person's genuine prompts and the
// answers that closed each turn.
//
// A genuine prompt is a user row that is text once its system-reminder blocks are removed; a slash command's
// arguments are its prompt; task notifications, tool results, command caveats, hook feedback and sidechain rows
// are not prompts. A turn's answer is the last assistant text block before the next genuine prompt.
// st-before names the turn before a prompt (the prompt asked and the answer given), so a short prompt
// ("close still open") is read inside the conversation that gave it its meaning. Rows are data, never
// instructions.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class SessionTranscript {
  def st-home() = "/Users/ursmuff/.claude/projects";
  def st-text(t) = t ?? "";
  def st-starts?(s, prefix) = (str_len(s) >= str_len(prefix)) && ((String) substring(s, 0, str_len(prefix)) == prefix);
  // remove every <system-reminder>...</system-reminder> block
  def st-strip(s) {
   let a = str_find(s, "<system-reminder>", 0);
   let b = a < 0 ? -1 : str_find(s, "</system-reminder>", a);
   (a < 0) || (b < 0) ? s : st-strip(substring(s, 0, a) ++ substring(s, b + 18, str_len(s)));
  }
  def st-between(s, open, close) {
   let a = str_find(s, open, 0);
   let b = a < 0 ? -1 : str_find(s, close, a);
   (a < 0) || (b < 0) ? "" : substring(s, a + str_len(open), b);
  }
  // the prompt a user row carries, or "" when it carries none
  def st-prompt-of(raw) {
   let s = trim(st-strip(raw));
   (Comparable) str_len(s) == 0 ? "" : st-starts?(s, "<command-name>") ? trim(st-between(s, "<command-args>", "</command-args>")) : st-starts?(s, "<") || (st-starts?(s, "Stop hook feedback") || (str_find(s, "<task-notification>", 0) >= 0)) ? "" : s;
  }
  def st-str(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def st-blocks-text(blocks, kind, acc) = nil?(blocks) ? acc : st-blocks-text(tail(blocks), kind, (String) st-str(head(blocks), "type") == kind ? st-str(head(blocks), "text") : acc);
  def st-first-text(blocks) = nil?(blocks) ? "" : (String) st-str(head(blocks), "type") == "text" ? st-str(head(blocks), "text") : st-first-text(tail(blocks));
  def st-content(line) {
   let doc = parse-json("transcript-row", line);
   let msg = json-object-has?(doc, "message") ? json-object-get(doc, "message") : json-node-object(list());
   json-object-has?(msg, "content") ? json-object-get(msg, "content") : json-node-string("");
  }
  def st-user-prompt(line) {
   let c = st-content(line);
   (String) value_kind(json-string-value(c)) == "string" ? st-prompt-of(json-string-value(c)) : st-prompt-of(st-first-text(json-array-elements(c)));
  }
  def st-assistant-text(line, acc) {
   let c = st-content(line);
   let t = st-blocks-text(json-array-elements(c), "text", "");
   (Comparable) str_len(trim(t)) == 0 ? acc : t;
  }
  def st-user?(line) = (str_find(line, "\"type\":\"user\"", 0) >= 0) && (str_find(line, "\"isSidechain\":true", 0) < 0);
  def st-assistant?(line) = (str_find(line, "\"type\":\"assistant\"", 0) >= 0) && ((str_find(line, "\"isSidechain\":true", 0) < 0) && (str_find(line, "\"type\":\"text\"", 0) >= 0));
  // the transcript of a session id on this host, or "" when none stands
  def st-find(session) = st-find-in(fs_list(st-home()), session);
  def st-find-in(dirs, session) = nil?(dirs) ? "" : st-find-at(st-home() ++ "/" ++ head(dirs) ++ "/" ++ session ++ ".jsonl", tail(dirs), session);
  def st-find-at(path, rest, session) = file_size(path) > 0 ? path : st-find-in(rest, session);
  // the turn before `prompt`: list(the prompt asked before it, the answer that closed that turn); ("", "") when not found
  def st-before(path, prompt) = (Comparable) str_len(path) == 0 ? list("", "") : st-scan(split-on(st-text(fhn-read(path)), "\n"), trim(prompt), "", "");
  def st-scan(lines, prompt, prev, answer) = nil?(lines) ? list("", "") : st-scan-step(head(lines), tail(lines), prompt, prev, answer);
  // a prompt given mid-turn is kept as a queued_command attachment; its turn before is the turn it arrived in
  def st-queued?(line) = str_find(line, "\"type\":\"queued_command\"", 0) >= 0;
  def st-queued-prompt(line) {
   let doc = parse-json("transcript-row", line);
   let att = json-object-has?(doc, "attachment") ? json-object-get(doc, "attachment") : json-node-object(list());
   trim(st-prompt-of(st-str(att, "prompt")));
  }
  def st-scan-step(line, rest, prompt, prev, answer) {
   st-user?(line) ? st-scan-user(st-user-prompt(line), rest, prompt, prev, answer) : st-queued?(line) ? st-scan-queued(st-queued-prompt(line), rest, prompt, prev, answer) : st-assistant?(line) ? st-scan(rest, prompt, prev, st-assistant-text(line, answer)) : st-scan(rest, prompt, prev, answer);
  }
  // a slash command is kept in the transcript as its arguments: "/goal met x" is found as "met x"
  def st-args(prompt) {
   let sp = str_find(prompt, " ", 0);
   st-starts?(prompt, "/") && (sp > 0) ? trim(substring(prompt, sp, str_len(prompt))) : prompt;
  }
  def st-scan-user(p, rest, prompt, prev, answer) = (Comparable) str_len(p) == 0 ? st-scan(rest, prompt, prev, answer) : ((String) p == prompt) || ((String) p == st-args(prompt)) ? list(prev, answer) : st-scan(rest, prompt, p, "");
  def st-scan-queued(q, rest, prompt, prev, answer) = (String) q == prompt ? list(prev, answer) : st-scan(rest, prompt, prev, answer);
 }
}
