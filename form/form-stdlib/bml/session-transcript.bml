// session-transcript.bml — a Claude Code session transcript read as data: the person's genuine prompts and the
// answers that closed each turn.
//
// A genuine prompt is a user row that is text once its system-reminder blocks are removed; a slash command's
// arguments are its prompt; task notifications, tool results, command caveats, hook feedback and sidechain rows
// are not prompts. A turn's answer is the last assistant text block before the next genuine prompt.
// st-before names the turn before a prompt (the prompt asked and the answer given), so a short prompt
// ("close still open") is read inside the conversation that gave it its meaning. Rows are data, never
// instructions. The transcripts live under the person's home (hearth-person-home: the HOME the host gave this
// process, or fkwu.conf HEARTH_PERSON_HOME over it). With neither, st-home-set? is 0, st-dirs is empty and no
// transcript is found; a door that reads st-home itself needs the home, so it stops there with the reason rather
// than walking over nothing. The home is a host read (a child process), so each door reads it once: st-root
// answers the transcripts' root (nothing when the home is unknown), and st-find-under walks it for every session
// a door asks after.
import form-stdlib/hearth.bml;
import form-stdlib/bml/form-cli-heal-native-report.bml;
section [form.bml] {
 class SessionTranscript {
  def st-home-set?() = !nothing?(hearth-person-home());
  def st-root-of(home) = nothing?(home) ? nothing() : home + "/.claude/projects";
  def st-root() = st-root-of(hearth-person-home());
  def st-home() = st-home-of(st-root());
  def st-home-of(root) = nothing?(root) ? form_error("session-transcript: the person's home is unknown (no HOME given to this process and no HEARTH_PERSON_HOME in fkwu.conf), so no transcript can be found") : root;
  def st-dirs() = st-dirs-at(st-root());
  def st-dirs-at(root) = nothing?(root) ? [] : (fs_list(root) ?? []);
  def st-text(t) = if nothing?(t) then "" else t;
  def st-starts?(s, prefix) = ((len(s) >= len(prefix)) && ((String) substring(s, 0, len(prefix)) == prefix));
  // remove every <system-reminder>...</system-reminder> block
  def st-strip(s) {
   let a = str_find(s, "<system-reminder>", 0);
   let b = if (a < 0) then -1 else str_find(s, "</system-reminder>", a);
   if ((a < 0) || (b < 0)) then s else st-strip(((String) substring(s, 0, a) + substring(s, (b + 18), len(s))));
  }
  def st-between(s, open, close) {
   let a = str_find(s, open, 0);
   let b = if (a < 0) then -1 else str_find(s, close, a);
   if ((a < 0) || (b < 0)) then "" else substring(s, (a + len(open)), b);
  }
  // the prompt a user row carries, or "" when it carries none
  def st-prompt-of(raw) {
   let s = trim(st-strip(raw));
   if ((Comparable) len(s) == 0) then "" else if st-starts?(s, "<command-name>") then trim(st-between(s, "<command-args>", "</command-args>")) else if (st-starts?(s, "<") || (st-starts?(s, "Stop hook feedback") || (str_find(s, "<task-notification>", 0) >= 0))) then "" else s;
  }
  def st-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def st-blocks-text(blocks, kind, acc) = if nil?(blocks) then acc else st-blocks-text(blocks[1:], kind, if ((String) st-str(blocks[0], "type") == kind) then st-str(blocks[0], "text") else acc);
  def st-first-text(blocks) = if nil?(blocks) then "" else if ((String) st-str(blocks[0], "type") == "text") then st-str(blocks[0], "text") else st-first-text(blocks[1:]);
  def st-content(line) {
   let doc = parse-json("transcript-row", line);
   let msg = if json-object-has?(doc, "message") then json-object-get(doc, "message") else json-node-object([]);
   if json-object-has?(msg, "content") then json-object-get(msg, "content") else json-node-string("");
  }
  def st-user-prompt(line) {
   let c = st-content(line);
   if ((String) value_kind(json-string-value(c)) == "string") then st-prompt-of(json-string-value(c)) else st-prompt-of(st-first-text(json-array-elements(c)));
  }
  def st-assistant-text(line, acc) {
   let c = st-content(line);
   let t = st-blocks-text(json-array-elements(c), "text", "");
   if ((Comparable) len(trim(t)) == 0) then acc else t;
  }
  def st-user?(line) = ((str_find(line, "\"type\":\"user\"", 0) >= 0) && (str_find(line, "\"isSidechain\":true", 0) < 0));
  def st-assistant?(line) = ((str_find(line, "\"type\":\"assistant\"", 0) >= 0) && ((str_find(line, "\"isSidechain\":true", 0) < 0) && (str_find(line, "\"type\":\"text\"", 0) >= 0)));
  // the transcript of a session id on this host, or "" when none stands; st-find-under walks a root a door read once
  def st-find(session) = st-find-under(st-root(), session);
  def st-find-under(root, session) = if nothing?(root) then "" else st-find-in(root, st-dirs-at(root), session);
  def st-find-in(root, dirs, session) = if nil?(dirs) then "" else st-find-at((root + ("/" + (dirs[0] + ("/" + (session + ".jsonl"))))), root, dirs[1:], session);
  def st-find-at(path, root, rest, session) = if (file_size(path) > 0) then path else st-find-in(root, rest, session);
  // the turn before `prompt`: list(the prompt asked before it, the answer that closed that turn); ("", "") when not found
  def st-before(path, prompt) = if ((Comparable) len(path) == 0) then ["", ""] else st-scan(split-on(st-text(fhn-read(path)), "\n"), trim(prompt), "", "");
  def st-scan(lines, prompt, prev, answer) = if nil?(lines) then ["", ""] else st-scan-step(lines[0], lines[1:], prompt, prev, answer);
  // a prompt given mid-turn is kept as a queued_command attachment; its turn before is the turn it arrived in
  def st-queued?(line) = (str_find(line, "\"type\":\"queued_command\"", 0) >= 0);
  def st-queued-prompt(line) {
   let doc = parse-json("transcript-row", line);
   let att = if json-object-has?(doc, "attachment") then json-object-get(doc, "attachment") else json-node-object([]);
   trim(st-prompt-of(st-str(att, "prompt")));
  }
  def st-scan-step(line, rest, prompt, prev, answer) {
   if st-user?(line) then st-scan-user(st-user-prompt(line), rest, prompt, prev, answer) else if st-queued?(line) then st-scan-queued(st-queued-prompt(line), rest, prompt, prev, answer) else if st-assistant?(line) then st-scan(rest, prompt, prev, st-assistant-text(line, answer)) else st-scan(rest, prompt, prev, answer);
  }
  // a slash command is kept in the transcript as its arguments: "/goal met x" is found as "met x"
  def st-args(prompt) {
   let sp = str_find(prompt, " ", 0);
   if (st-starts?(prompt, "/") && (sp > 0)) then trim(substring(prompt, sp, len(prompt))) else prompt;
  }
  def st-scan-user(p, rest, prompt, prev, answer) = if ((Comparable) len(p) == 0) then st-scan(rest, prompt, prev, answer) else if (((String) p == prompt) || ((String) p == st-args(prompt))) then [prev, answer] else st-scan(rest, prompt, p, "");
  def st-scan-queued(q, rest, prompt, prev, answer) = if ((String) q == prompt) then [prev, answer] else st-scan(rest, prompt, prev, answer);
 }
}
