// band-claims.bml — which claims of a band are red, read from its own comment head.
//
// A band's head names its verdict bits one per claim:
//   ; Verdict 15 when every claim lands:
//   ;   1   the first claim, which may run on
//   ;       onto a continuation line (indented deeper)
//   ;   2   the second claim
// A claim row is a head line whose first word after the `;` is a power of two (a bit) at a shallow indent; a line indented
// deeper continues the claim above it. A reading of the band is a sum of the bits whose claims landed, so a claim is red
// exactly when its bit is absent from the reading. The row of a ledger that says "band_after 33030143 of 33554431" carries
// the red bits as a number and nothing else; this names them, so a lane (or a person) reads WHICH claim is short without
// opening the band. Pure over the band's text: bc-claims(text) is [[bit, text], ...] and bc-red(text, reading) the rows
// whose bit the reading lacks. The head runs to the first line that is code (band-head.bml's bh-head).
// preludes: form-stdlib/core.fk gate/lens-text.bml observe/band-head.bml
section [form.bml] {
    class BandClaims {
        // spaces after the leading `;` run of a head line, and what follows them
        def bc-semis(l, i) = i < len(l) && str_byte_at(l, i) == 59 ? bc-semis(l, i + 1) : i;
        def bc-spaces(l, i) = i < len(l) && str_byte_at(l, i) == 32 ? bc-spaces(l, i + 1) : i;
        def bc-indent(l) = bc-spaces(l, bc-semis(l, 0)) - bc-semis(l, 0);
        def bc-body(l) = substring(l, bc-spaces(l, bc-semis(l, 0)), len(l));
        // the digit run at the start of s: its end
        def bc-digit-end(s, i) = i < len(s) && str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57 ? bc-digit-end(s, i + 1) : i;
        def bc-int-of(s, i, end, acc) = i >= end ? acc : bc-int-of(s, i + 1, end, acc * 10 + (str_byte_at(s, i) - 48));
        // n is a power of two when halving reaches 1 with no remainder
        def bc-pow2?(n) = n < 1 ? false : n == 1 ? true : n % 2 != 0 ? false : bc-pow2?(n / 2);
        // [bit, text] when the head line opens a claim, else []
        def bc-open(l) {
            let body = bc-body(l);
            let e = bc-digit-end(body, 0);
            e > 0 && e < len(body) && str_byte_at(body, e) == 32 && bc-indent(l) <= 4 && bc-pow2?(bc-int-of(body, 0, e, 0)) ? [bc-int-of(body, 0, e, 0), trim(substring(body, e, len(body)))] : [];
        }
        def bc-cont?(l) = bc-indent(l) > 4 && len(trim(bc-body(l))) > 0;
        // fold the head lines into claims, continuing the newest
        def bc-fold(ls, acc) {
            if (len(ls) == 0) then reverse(acc)
            else if (len(bc-open(ls[0])) == 2) then bc-fold(ls[1:], cons(bc-open(ls[0]), acc))
            else if (bc-cont?(ls[0]) && len(acc) > 0) then bc-fold(ls[1:], cons([acc[0][0], acc[0][1] ++ " " ++ trim(bc-body(ls[0]))], acc[1:]))
            else bc-fold(ls[1:], acc);
        }
        def bc-claims(text) = bc-fold(bh-head(text), []);
        // a reading has a bit when its quotient by the bit is odd
        def bc-has?(reading, bit) = (reading / bit) % 2 == 1;
        def bc-red(text, reading) = filter(c => !bc-has?(reading, c[0]), bc-claims(text));
        def bc-green(text, reading) = filter(c => bc-has?(reading, c[0]), bc-claims(text));
    }
}
