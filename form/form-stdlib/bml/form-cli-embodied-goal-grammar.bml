//////////////////////////////////////////////////////////////////////
// form-cli-embodied-goal-grammar.bml -- scannerless intent lowering for
// the Form-cli local-reasoning movement.
//
// This is a grammar, not a function-seat table: recurring meaning is admitted
// by independently visible anchors, lowered to a compact answer shape, and
// otherwise stays the caller's original direct text. The local model sees one
// direct-user observation; no remote prompt construction is involved.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk

section [form.bml] {
    class FormCliEmbodiedGoalGrammar {
        field Route = "local-form-cli-first";
        field AnswerShape = "route; BML; cache/JIT; evidence; next gap";
        field Fail = "<FAIL>";
        field Stop = "<STOP>";

        def fcpdag-route() = Route();
        def fcpdag-answer-shape() = AnswerShape();
        def fcpdag-has?(text, needle) = if ge(str_find(text, needle, 0), 0) then 1 else 0;
        def fcpdag-embodied-goal?(text) = if eq(fcpdag-has?(text, "10% of normal token"), 0) then 0 else if eq(fcpdag-has?(text, "form-cli"), 0) then 0 else if eq(fcpdag-has?(text, "BML"), 0) then 0 else if eq(fcpdag-has?(text, "framebuffer"), 0) then 0 else if eq(fcpdag-has?(text, "metal"), 0) then 0 else 1;
        def fcpdag-lowered-observation() = "Answer in five compact clauses: route; BML; cache/JIT; evidence; next gap. Use local Form-cli first. State BML authority, cache and Metal/JIT execution, and framebuffer evidence. Do not claim a remote-token ratio unless a comparable provider receipt is present. Name one concrete local next gap.";
        def fcpdag-observation(text) = if eq(fcpdag-embodied-goal?(text), 1) then fcpdag-lowered-observation() else text;
        def fcpdag-lane(text) = if eq(fcpdag-embodied-goal?(text), 1) then "embodied-goal-bml-direct-user" else "direct-user";
        // Controls remain protocol signals even when thought markup wraps
        // them. `<FAIL>` refuses an answer; `<STOP>` is ordinary completion
        // when the answer grammar is already whole.
        def fcpdag-failure-control?(response) = if ge(str_find(response, Fail(), 0), 0) then 1 else 0;
        def fcpdag-stop-control?(response) = if ge(str_find(response, Stop(), 0), 0) then 1 else 0;
        def fcpdag-terminal-control?(response) = if or(eq(fcpdag-failure-control?(response), 1), eq(fcpdag-stop-control?(response), 1)) then 1 else 0;
        def fcpdag-answer-shaped?(response) = if eq(fcpdag-has?(response, "route:"), 0) then 0 else if eq(fcpdag-has?(response, "BML:"), 0) then 0 else if eq(fcpdag-has?(response, "cache/JIT:"), 0) then 0 else if eq(fcpdag-has?(response, "evidence:"), 0) then 0 else if eq(fcpdag-has?(response, "next gap:"), 0) then 0 else 1;
        def fcpdag-answer-surface(response) {
            let start = str_find(response, "route:", 0);
            let stop = str_find(response, Stop(), if lt(start, 0) then 0 else start);
            if lt(start, 0) then response else substring(response, start, if lt(stop, 0) then str_len(response) else stop);
        }
    }
    0;
}
