//////////////////////////////////////////////////////////////////////
// form-cli-embodied-goal-grammar.bml -- scannerless intent lowering for
// the Form-cli local-reasoning movement.
//
// This is a grammar, not a function-seat table: recurring meaning is admitted
// by independently visible anchors, lowered to a compact answer shape, and
// otherwise stays the caller's original direct text. The local model sees one
// direct-user observation; no remote prompt construction is involved.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk

section [form.bml] {
    class FormCliEmbodiedGoalGrammar {
        field Route = "local-form-cli-first";
        field AnswerShape = "route; BML; cache/JIT; evidence; next gap";
        field Fail = "<FAIL>";
        field Stop = "<STOP>";
        field EmbodiedGoalPrompt = "show me that you can use 10% of normal token to get the same prompt done through form-cli. use BML for new code, use cache, use metal, use JIT, dissolve limits, place missing stones, use framebuffer, measure observe optimize, avoid external tools, minimize membrane crossing, use substrate knowledge of hyper fast knowing, prefer embodied knowing over thinking and reasoning, invent new grammar, lift low level to high level knowing";
        field CompressionTag = "form-cli-embodied-goal-compression-v1";

        def fcpdag-route() = Route();
        def fcpdag-answer-shape() = AnswerShape();
        def fcpdag-embodied-goal-prompt() = EmbodiedGoalPrompt();
        def fcpdag-compression-tag() = CompressionTag();
        def fcpdag-has?(text, needle) = if ge(str_find(text, needle, 0), 0) then 1 else 0;
        def fcpdag-embodied-goal?(text) = if eq(fcpdag-has?(text, "10% of normal token"), 0) then 0 else if eq(fcpdag-has?(text, "form-cli"), 0) then 0 else if eq(fcpdag-has?(text, "BML"), 0) then 0 else if eq(fcpdag-has?(text, "framebuffer"), 0) then 0 else if eq(fcpdag-has?(text, "metal"), 0) then 0 else 1;
        def fcpdag-hearth-monitor?(text) = if eq(fcpdag-has?(text, "hearth"), 0) then 0 else if eq(fcpdag-has?(text, "direct-answer"), 0) then 0 else if eq(fcpdag-has?(text, "reply-spool"), 0) then 0 else 1;
        def fcpdag-lowered-observation() = "Answer in five compact clauses: route; BML; cache/JIT; evidence; next gap. Use local Form-cli first. State BML authority, cache and Metal/JIT execution, and framebuffer evidence. Do not claim a remote-token ratio unless a comparable provider receipt is present. Name one concrete local next gap.";
        def fcpdag-hearth-monitor-observation() = "Answer in five compact clauses: route; BML; cache/JIT; evidence; next gap. Native hearth telemetry: direct phase events are Form-only; caller-owned transport keeps one reply append; events hold no task or answer bytes.";
        def fcpdag-observation(text) = if eq(fcpdag-hearth-monitor?(text), 1) then fcpdag-hearth-monitor-observation() else if eq(fcpdag-embodied-goal?(text), 1) then fcpdag-lowered-observation() else text;
        def fcpdag-lane(text) = if eq(fcpdag-hearth-monitor?(text), 1) then "hearth-monitor-bml-direct-user" else if eq(fcpdag-embodied-goal?(text), 1) then "embodied-goal-bml-direct-user" else "direct-user";
        // Compression is typed evidence, not an instruction to count absence
        // as zero.  Byte and token quantities are supplied by the caller's
        // own artifact reader; this grammar owns their semantic relationship.
        def fcpdag-compression(original, lowered, originalIds, loweredIds) = list(fcpdag-compression-tag(), fcpdag-lane(original), str_len(original), str_len(lowered), originalIds, loweredIds);
        def fcpdag-compression?(value) = if nothing?(value) then 0 else if not(eq(len(value), 6)) then 0 else str_eq(nth(value, 0), fcpdag-compression-tag());
        def fcpdag-compression-lane(value) = nth(value, 1);
        def fcpdag-original-bytes(value) = nth(value, 2);
        def fcpdag-lowered-bytes(value) = nth(value, 3);
        def fcpdag-original-ids(value) = nth(value, 4);
        def fcpdag-lowered-ids(value) = nth(value, 5);
        def fcpdag-bytes-saved(value) = sub(fcpdag-original-bytes(value), fcpdag-lowered-bytes(value));
        def fcpdag-ids-saved(value) = if or(nothing?(fcpdag-original-ids(value)), nothing?(fcpdag-lowered-ids(value))) then nothing() else sub(fcpdag-original-ids(value), fcpdag-lowered-ids(value));
        def fcpdag-byte-reduction-bps(value) = if le(fcpdag-original-bytes(value), 0) then nothing() else div(mul(fcpdag-bytes-saved(value), 10000), fcpdag-original-bytes(value));
        def fcpdag-id-reduction-bps(value) = if or(nothing?(fcpdag-original-ids(value)), nothing?(fcpdag-lowered-ids(value))) then nothing() else if le(fcpdag-original-ids(value), 0) then nothing() else div(mul(fcpdag-ids-saved(value), 10000), fcpdag-original-ids(value));
        // Controls remain protocol signals even when thought markup wraps
        // them. `<FAIL>` refuses an answer; `<STOP>` is ordinary completion
        // when the answer grammar is already whole.
        def fcpdag-failure-control?(response) = if ge(str_find(response, Fail(), 0), 0) then 1 else 0;
        def fcpdag-stop-control?(response) = if ge(str_find(response, Stop(), 0), 0) then 1 else 0;
        def fcpdag-terminal-control?(response) = if or(eq(fcpdag-failure-control?(response), 1), eq(fcpdag-stop-control?(response), 1)) then 1 else 0;
        def fcpdag-answer-shaped?(response) = if eq(fcpdag-has?(response, "route:"), 0) then 0 else if eq(fcpdag-has?(response, "BML:"), 0) then 0 else if eq(fcpdag-has?(response, "cache/JIT:"), 0) then 0 else if eq(fcpdag-has?(response, "evidence:"), 0) then 0 else if eq(fcpdag-has?(response, "next gap:"), 0) then 0 else 1;
        def fcpdag-answer-surface(response) {
            let start = str_find(response, "route:", 0);
            let stop = str_find(response, Stop(), if lt(start, 0) then 0 else start);
            if lt(start, 0) then response else substring(response, start, if lt(stop, 0) then str_len(response) else stop);
        }
    }
    0;
}
