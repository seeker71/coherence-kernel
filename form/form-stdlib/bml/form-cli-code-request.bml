  def fcaq-managed(obj, docs) {
   let checker = fcaq-live-checker(obj);
   let state = fcaq-prepare(obj, docs, checker, hearth-code-memory());
   let saved = fcap-done(state) ? 1 : fcam-save(state);
   let evaluation = fcaq-evaluation(obj);
   let proposed = saved && (!(fcap-reviewing(state) || (evaluation || json-object-has?(obj,"model")))) ? nsc-propose(hearth-session-learning(),state,checker) : list(state,0);
   let model = json-object-has?(obj,"model") ? fcap-string(obj,"model") : "qwen38-q8";
   let limit = fcaq-number(obj,"initial_reasoning_tokens",0);
   let answerReserve = fcaq-number(obj,"reasoning_answer_tokens",0);
   let result = !saved ? list(fcap-terminal(state,"checkpoint-write-refused"),1,0,0,0) : (String) fcap-stage(head(proposed)) == "complete" ? nsc-finish(proposed) : (answerReserve > 0) && (limit > 0) ? fcacr-reserved-admit(model,head(proposed),checker,fcaq-number(obj,"context",8192),fcap-turns(state) + fcaq-number(obj,"turns",64),limit,answerReserve) : limit > 0 ? fcacr-admit(model,head(proposed),checker,fcaq-number(obj,"context",8192),fcap-turns(state) + fcaq-number(obj,"turns",64),limit) : fcac-admit(model,head(proposed),checker,fcaq-number(obj,"context",8192),fcap-turns(state) + fcaq-number(obj,"turns",64));
   let learned = fcaq-observe(obj,hearth-session-learning(),result,checker);
   let publicResult = oh-set(oh-set(parse-json("code-result",fcaq-result(append(result,list(learned)))),"requested_initial_reasoning_tokens",json-node-int(limit)),"requested_reasoning_answer_tokens",json-node-int(answerReserve));
   json-emit(oh-set(oh-set(publicResult,"evaluation",json-node-int(evaluation)),"weight_training_excluded",json-node-int(fcaq-training-excluded(obj))));
  }
  def fcaq-help() = "code <JSON object>: local Qwen over caller-provided resident documents. Fields: goal, documents [{id,path,text}], writable [path], checks [{tool,arguments,input,stdout}], optional model, context, turns, resume, evaluation, weight_training, review_entry, code_entry. code_entry=staged is the default; code_entry=direct begins implementing the caller's supplied task and retains review, source checks, repair and replanning. Entry selects fresh state; resume retains its saved phase. mode=review requires writable=[] and nonempty report_checks; their native tools receive the report on stdin with no document access. review_entry=staged is the default; review_entry=direct preserves read-only documents, source/report checks and repair. Review returns report and preserves all documents. verify runs caller-owned source checks, with no model-supplied commands. evaluation=1 starts fresh without recall, resume, checkpoint writes or LoRA proposals and excludes its answers from weight training. Ordinary coding retains verified continuity and can use its checked session LoRA proposal. weight_training=0 excludes this request's answer from gradients while retaining ordinary continuity and existing learned proposals; omitted or 1 preserves the ordinary training policy. Evaluation and review answers remain excluded for either value. Review reports are retained as assessment experience, never implementation targets. See docs/form-native-coding.md." ++ fcacr-reserved-help();
  def fcaq-feedback-help() = " Coding resume may add feedback={id,text}, two nonempty strings describing a caller-observed failure. It reopens repair under the unchanged contract. Reuse the stable id only for identical delivery retries; new observations use new ids. Applied events persist as caller_feedback. Evaluated response repair keeps weight_training=0.";
  def fcaq-from-file(path) = (file_size(path) <= 0) || (file_size(path) > FatMaxBytes()) ? fcaq-refused("request-file-unavailable-or-oversized") : fcaq-call(read_file(path));
  def fcaq-command(arg) = nothing?(arg) || (((String) arg == "") || ((String) arg == "help")) ? (fcaq-help() ++ fcaq-feedback-help()) ++ " Coding and review document_context=catalog keep source text available through tools. Optional source_queries=[{tool,arguments}] admits actual read-only query observations before generation; no input or stdout fields. Full documents and original checks remain unchanged. Coding may set native_rehearsal_checks=0..64 to allow bounded native BML repair after an unchanged edit or failed implementation verify with one eligible writable BML document; default 0. Native attempts, remaining allowance and original failed actions are returned separately from model calls. Large requests: code @request.json reads the complete native file; the standalone stdin door accepts the same @path." : fat-starts(arg,"@") ? fcaq-from-file(substring(arg,1,str_len(arg))) : fcaq-call(arg);
 }
 0;
}
