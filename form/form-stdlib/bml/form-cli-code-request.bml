// Agent-shaped JSON door. Checks are caller-owned read-only native tool calls;
// applications may instead supply a richer in-process callback to fcac-run.
// preludes: form-stdlib/bml/form-cli-code-live.bml form-stdlib/bml/form-cli-code-definition.bml form-stdlib/bml/native-session-code.bml
section [form.bml] {
 class FormCliCodeRequest {
  def fcaq-number(obj, key, fallback) = if not(json-object-has?(obj, key)) then fallback else if not(str_eq(faj-type(json-object-get(obj, key)), "number")) then 0 else if not(str_eq(json-emit(json-object-get(obj, key)), int_to_str(json-int-value(json-object-get(obj, key))))) then 0 else json-int-value(json-object-get(obj, key));
  def fcaq-check-valid(row) = if not(fat-wire-object?(row)) then 0 else if str_eq(fcap-string(row, "kind"), "definition") then fcad-check-valid(row) else and(fcap-readonly(fcap-string(row, "tool")), and(fcap-string-array(json-object-get(row, "arguments")), and(fat-wire-string?(json-object-get(row, "stdout")), if json-object-has?(row, "exit") then and(fcad-int(json-object-get(row, "exit")), eq(fcaq-number(row, "exit", 0), 0)) else 1)));
  def fcaq-checks-valid(rows) = if nil?(rows) then 1 else and(fcaq-check-valid(head(rows)), fcaq-checks-valid(tail(rows)));
  def fcaq-check(rows, docs) = if nil?(rows) then list(1, "All caller-owned native assertions passed. This proves these assertions only, not arbitrary program behavior.") else if str_eq(fcap-string(head(rows), "kind"), "definition") then fcaq-definition-next(rows, docs, fcad-check(head(rows), docs)) else fcaq-check-row(rows, docs, fat-call(docs, fcap-string(head(rows), "tool"), fcap-array(head(rows), "arguments"), fcap-string(head(rows), "input")));
  def fcaq-definition-next(rows, docs, result) = if eq(head(result), 1) then fcaq-check(tail(rows), docs) else result;
  def fcaq-check-row(rows, docs, result) = if and(eq(fat-exit(result), 0), and(str_eq(fat-error(result), ""), str_eq(fat-out(result), fcap-string(head(rows), "stdout")))) then fcaq-check(tail(rows), docs) else list(0, str_concat("Failed caller assertion: ", str_concat(json-emit(head(rows)), str_concat(" actual=", fat-wire-render(result)))));
  def fcaq-request-valid(obj) = if not(fat-wire-object?(obj)) then 0 else and(gt(str_len(fcap-string(obj, "goal")), 0), and(fcap-string-array(json-object-get(obj, "writable")), and(fat-wire-array?(json-object-get(obj, "checks")), and(gt(len(node_children(json-object-get(obj, "checks"))), 0), fcaq-checks-valid(node_children(json-object-get(obj, "checks")))))));
  def fcaq-result-core(result) {
   let state = head(result);
   json-emit(json-node-object(list(json-node-pair("schema", json-node-string("form-native-code-v1")), json-node-pair("status", json-node-string(if eq(nth(result, 1), 1) then fcap-stage(state) else "release-incomplete")), json-node-pair("reason", json-node-string(fcap-note(state))), json-node-pair("turns", json-node-int(fcap-turns(state))), json-node-pair("tool_calls", json-node-int(fcap-calls(state))), json-node-pair("completed_tasks", json-node-int(nth(state, 11))), json-node-pair("repair_attempts", json-node-int(fcap-failures(state))), json-node-pair("check_runs", json-node-int(fcap-checks(state))), json-node-pair("repair_notes", json-node-array(fcap-reflections-json(fcap-reflections(state)))), json-node-pair("learning_basis", json-node-string(if fcam-managed(state) then "verified-contract-scoped-memory;not-weight-training" else "within-run-reflection;not-weight-training")), json-node-pair("checkpoint_id", json-node-string(if fcam-managed(state) then fcam-id(state) else "")), json-node-pair("lessons_recalled", json-node-int(fcam-hits(state))), json-node-pair("release_ok", json-node-int(nth(result, 1))), json-node-pair("generated_ids", json-node-int(nth(result, 2))), json-node-pair("injected_ids", json-node-int(nth(result, 3))), json-node-pair("observations", json-node-int(nth(result, 4))), json-node-pair("documents", fat-wire-documents-node(fcap-docs(state))), json-node-pair("persistence", json-node-string("native-continuity-cache;caller-owns-source-file-publication")))));
  }
  def fcaq-result(result) {
   let original = parse-json("code-result",fcaq-result-core(result));
   let learning = if gt(len(result),5) then nth(result,5) else list("not-recorded","no-session-owner");
   json-emit(json-node-object(append(json-object-pairs(original),list(nsm-s("session_learning_example",head(learning)),nsm-s("session_learning_worker",nth(learning,1)),nsm-s("session_learning_status","inspect-session-status;queued-is-not-trained")))));
  }
  def fcaq-refused(reason) = json-emit(json-node-object(list(json-node-pair("status", json-node-string("attention")), json-node-pair("reason", json-node-string(reason)))));
  def fcaq-call(raw) = if or(gt(str_len(raw), FatMaxBytes()), not(faj-valid(raw))) then fcaq-refused("invalid-or-oversized-request-json") else fcaq-decoded(faj-json("native-code-request", raw));
  def fcaq-decoded(obj) = if not(fcaq-request-valid(obj)) then fcaq-refused("goal,writable,documents,and-nonempty-readonly-checks-required") else fcaq-docs(obj, fat-wire-documents(obj));
  def fcaq-docs(obj, docs) = if not(str_eq(fat-wire-error(docs), "")) then fcaq-refused(fat-wire-error(docs)) else if or(le(fcaq-number(obj, "context", 8192), 0), le(fcaq-number(obj, "turns", 64), 0)) then fcaq-refused("positive-context-and-turns-required") else if and(json-object-has?(obj, "resume"), not(fat-wire-string?(json-object-get(obj, "resume")))) then fcaq-refused("resume-must-be-checkpoint-id") else fcaq-managed(obj, fat-wire-value(docs));
  def fcaq-managed(obj, docs) {
   let checker = list(fcaq-check, node_children(json-object-get(obj, "checks")));
   let initial = fcap-open(fcap-string(obj, "goal"), docs, fcap-array(obj, "writable"));
   let state = fcam-prepare(hearth-code-memory(), initial, json-emit(json-object-get(obj, "checks")), fcap-string(obj, "resume"), checker);
   let saved = if fcap-done(state) then 1 else fcam-save(state);
   let evaluation = eq(nsm-num(obj,"evaluation"),1);
   let proposed = if and(saved,not(or(evaluation,json-object-has?(obj,"model")))) then nsc-propose(hearth-session-learning(),state,checker) else list(state,0);
   let result = if not(saved) then list(fcap-terminal(state,"checkpoint-write-refused"),1,0,0,0) else if str_eq(fcap-stage(head(proposed)),"complete") then nsc-finish(proposed) else fcac-admit(if json-object-has?(obj,"model") then fcap-string(obj,"model") else "qwen38-q8",head(proposed),checker,fcaq-number(obj,"context",8192),add(fcap-turns(state),fcaq-number(obj,"turns",64)));
   let learned = nsc-observe(hearth-session-learning(),result,checker,evaluation);
   fcaq-result(append(result,list(learned)));
  }
  def fcaq-help() = "code <JSON object>: caller-checked session LoRA proposal, then local Qwen refine/plan/split/implement/review/check over caller-provided resident documents. Fields: goal, documents [{id,path,text}], writable [path], checks [{tool,arguments,input,stdout}], optional model, context, turns, resume (checkpoint_id), evaluation (1 excludes session learning). Verified repair lessons are recalled for the exact caller contract; native checkpoints retain task state between admissions. Results return document values. Checked outcomes feed the shared native Llama LoRA learner; session status reports actual updates and serving decisions. See docs/form-native-coding.md.";
  def fcaq-command(arg) = if or(str_eq(arg, ""), str_eq(arg, "help")) then fcaq-help() else fcaq-call(arg);
 }
 0;
}
