  }
  def fcaq-help() = str_concat("code <JSON object>: local Qwen over caller-provided resident documents. Fields: goal, documents [{id,path,text}], writable [path], checks [{tool,arguments,input,stdout}], optional model, context, turns, resume, evaluation, review_entry, code_entry. code_entry=staged is the default; code_entry=direct begins implementing the caller's supplied task and retains review, source checks, repair and replanning. Entry selects fresh state; resume retains its saved phase. mode=review requires writable=[] and nonempty report_checks; their native tools receive the report on stdin with no document access. review_entry=staged is the default; review_entry=direct preserves read-only documents, source/report checks and repair. Review returns report and preserves all documents. verify runs caller-owned source checks, with no model-supplied commands. evaluation=1 starts fresh without recall, resume, checkpoint writes or LoRA proposals and excludes its answers from weight training. Ordinary coding retains verified continuity and can use its checked session LoRA proposal. Review reports are retained as assessment experience, never implementation targets. See docs/form-native-coding.md.",fcacr-reserved-help());
  def fcaq-from-file(path) = if or(le(file_size(path),0),gt(file_size(path),FatMaxBytes())) then fcaq-refused("request-file-unavailable-or-oversized") else fcaq-call(read_file(path));
  def fcaq-command(arg) = if or(nothing?(arg),or(str_eq(arg, ""), str_eq(arg, "help"))) then str_concat(fcaq-help()," Review document_context=catalog keeps source text available through tools. Optional source_queries=[{tool,arguments}] admits actual read-only query observations before generation; no input or stdout fields. Full documents and original checks remain unchanged. Coding may set native_rehearsal_checks=0..64 to allow bounded native BML repair after an unchanged edit or failed implementation verify with one eligible writable BML document; default 0. Native attempts, remaining allowance and original failed actions are returned separately from model calls. Large requests: code @request.json reads the complete native file; the standalone stdin door accepts the same @path.") else if fat-starts(arg,"@") then fcaq-from-file(substring(arg,1,str_len(arg))) else fcaq-call(arg);
 }
 0;
}
