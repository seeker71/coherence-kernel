// Execute a caller-selected Form unit through the owned native process organ.
import form-stdlib/bml/form-cli-heal-native-process.bml;
section [form.bml] {
 class FormCliRun {
  def fclr-help() = "run <relative .fk|.bml>: execute a selected Form unit with native process ownership, live signals, retained stdout/stderr and observed release. The existing progress-aware supervisor carries it without a wall-time deadline. The response keeps compact outcomes and references to full evidence.";
  def fclr-command(path) = !fhn-relative(path) || !fs-exists?(path) ? "run refused: name an existing relative Form source" : !(fs-path-extension(path) == ".fk" || fs-path-extension(path) == ".bml") ? "run refused: Form source required" : fclr-root(fhn-root(),path);
  def fclr-root(root,path) {
   let spool=fhn-at(root,".form-heal");
   fs_mkdir(spool);
   fclr-job(fhn-unique(spool,"run-native-"),root,path);
  }
  def fclr-job(job,root,path) = nothing?(job) ? "run refused: native process owner unavailable" : {
   fhn-write-json(fhn-at(job,"snapshot.json"),json-node-object([fhn-s("root",root),fhn-s("target",path),fhn-s("carrier","native-form-process-v1")]));
   fclr-result(job,path,fhn-run(job,"run",0,"root","-",["./fkwu",path]));
  };
  def fclr-outcome(row) = json-node-object(["state","status","reason","elapsed_ms","returncode","cleanup","output_drains"] |> map(key=>json-node-pair(key,json-object-has?(row,key) ? json-object-get(row,key) : json-node-null())));
  def fclr-result(job,path,status) = json-emit(json-node-object([fhn-s("schema","form-cli-run-v1"),fhn-s("source",path),fhn-s("status",status),fhn-s("evidence",job),json-node-pair("outcome",fclr-outcome(fhn-json(fhn-stage-path(job,"run",".process.json")))),json-node-pair("process",oh-reference(fhn-stage-path(job,"run",".process.json"))),json-node-pair("stdout",oh-reference(fhn-stage-path(job,"run",".out"))),json-node-pair("stderr",oh-reference(fhn-stage-path(job,"run",".err")))]));
 }
}
