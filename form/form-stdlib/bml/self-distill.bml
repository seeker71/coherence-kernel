// self-distill.bml — the voice's own frontier row: one question from a finding the body already holds, one word, judged before it lands.
//
// A finding is a sentence the body wrote about itself in a public ledger, never the person's words: an exit-proof wall (receipts/exit-proof-ledger.jsonl), a turn's refusal
// (receipts/native-turn-ledger.jsonl), an open row of the register (receipts/offline-voice-gap-register.jsonl). The findings no attempt has asked come first; when every one was asked the oldest asks again.
// The voice answers two lines, WORD and WHY, and sd-judge reads them. A candidate is admitted only when each of these holds, and a poor answer is refused by the first it fails:
//   no-word          WORD is one lowercase word of 4 to 24 letters
//   not-fresh        the word stands nowhere in learn/homecoming-distillation-corpus.fk, by fkwu's own search for it and its capital (a word inside a word counts, as grep reads it)
//   already-offered  no earlier candidate wears it
//   echo             the finding does not hold it: a word the finding used names nothing new
//   not-a-word       the host's word list holds it (/usr/share/dict/words): a coined word cannot be told from noise without a second reader; a list that does not read refuses as no-lexicon
//   no-why           WHY runs at least 6 words
//   why-untethered   WHY shares at least 2 long words with the finding: an answer about nothing in particular teaches nothing
// An admitted row lands in learn/distillation-native-candidates.jsonl: the coordinator's rented rows never write there, so a band counts the two apart and the corpus's field code keeps reading rented rows alone.
// Every attempt lands one row in receipts/self-distill-ledger.jsonl: admitted, refused with its name and the voice's words, or held with the lane's reason. Both files are public and hold no word of the person's.
// PROOF: form-stdlib/tests/self-distill-band.bml; learn/tests/homecoming-distillation-corpus-band.fk reads the native gate beside the rented one.
import form-stdlib/bml/form-cli-native-voice.bml;
import form-stdlib/bml/form-cli-guide-packet.bml;
import form-stdlib/bml/door-options.bml;
import form-stdlib/bml/host-walk-clock.bml;
import form-stdlib/bml/stdin-source.bml;
section [form.bml] {
 class SelfDistill {
  def sd-door() = "self-distill";
  def sd-source() = "native-voice";
  def sd-spec() = [["candidates", "str"], ["ledger", "str"], ["corpus", "str"], ["lexicon", "str"], ["proof", "str"], ["turns", "str"], ["register", "str"], ["reply", "str"], ["until_ms", "int"]];
  def sd-opt(opts, key, dflt) = (String) fcgp-str(opts, key) == "" ? dflt : fcgp-str(opts, key);
  def sd-candidates(opts) = sd-opt(opts, "candidates", "learn/distillation-native-candidates.jsonl");
  def sd-ledger(opts) = sd-opt(opts, "ledger", "receipts/self-distill-ledger.jsonl");
  def sd-corpus(opts) = sd-opt(opts, "corpus", "learn/homecoming-distillation-corpus.fk");
  def sd-lexicon(opts) = sd-opt(opts, "lexicon", "/usr/share/dict/words");
  def sd-has?(hay, needle) = str_find(hay, needle, 0) >= 0;
  def sd-rows(path) = (Comparable) host_path_exists(path) == 1 ? fcgp-rows(path) : [];
  // ---- the words
  def sd-lower-byte(b) = (b >= 65) && (b <= 90) ? b + 32 : b;
  def sd-lower-from(s, i, acc) = i >= len(s) ? str-join(reverse(acc)) : sd-lower-from(s, i + 1, cons(byte_to_str(sd-lower-byte(str_byte_at(s, i))), acc));
  def sd-lower(text) = sd-lower-from(text, 0, []);
  def sd-capital(w) = byte_to_str(str_byte_at(w, 0) - 32) ++ substring(w, 1, len(w));
  def sd-letter?(b) = (b >= 97) && (b <= 122);
  def sd-letters?(w, i) = i >= len(w) ? true : sd-letter?(str_byte_at(w, i)) && sd-letters?(w, i + 1);
  def sd-word?(w) = (len(w) >= 4) && (len(w) <= 24) && sd-letters?(w, 0);
  // the lowered words of a text: letters kept, any other byte a break
  def sd-tokens-from(s, i, at, acc) = i >= len(s) ? reverse(at < i ? cons(substring(s, at, i), acc) : acc) : sd-letter?(str_byte_at(s, i)) ? sd-tokens-from(s, i + 1, at, acc) : sd-tokens-from(s, i + 1, i + 1, at < i ? cons(substring(s, at, i), acc) : acc);
  def sd-tokens(text) = sd-tokens-from(sd-lower(text), 0, 0, []);
  def sd-long-words(text) = filter(w => len(w) >= 5, sd-tokens(text));
  def sd-distinct(xs) = foldl((acc, x) => any?(y => (String) y == x, acc) ? acc : append(acc, [x]), [], xs);
  def sd-take(n, xs) = n <= 0 || nil?(xs) ? [] : cons(xs[0], sd-take(n - 1, xs[1:]));
  def sd-clip(text, n) = len(text) <= n ? text : substring(text, 0, n);
  // ---- the findings: [where, words]
  def sd-wall-of(row, name) = (String) fcgp-str(row, name) == "wall" ? [["exit-proof " ++ name, fcgp-str(row, name ++ "_reading")]] : [];
  def sd-walls(rows) = nil?(rows) ? [] : foldl((acc, n) => append(acc, sd-wall-of(rows[-1], n)), [], ["E1", "E2", "E3", "E4", "E5", "E6"]);
  def sd-refusal-of(row) = len(fcgp-str(row, "publish_refused")) >= 20 ? [["turn " ++ fcgp-str(row, "gap"), fcgp-str(row, "publish_refused")]] : len(fcgp-str(row, "lane_reason")) >= 20 ? [["turn " ++ fcgp-str(row, "gap"), fcgp-str(row, "lane_reason")]] : [];
  def sd-refusals(rows) = foldl((acc, r) => append(acc, sd-refusal-of(r)), [], reverse(sd-tail(rows, 40)));
  def sd-tail(xs, n) = len(xs) <= n ? xs : xs[len(xs) - n:];
  def sd-open-of(v) = (String) fcgp-str(v, "verdict") == "open" ? [["register " ++ fcgp-str(v, "id"), fcgp-str(v, "observation")]] : [];
  def sd-opens(rows) = nil?(rows) || !fcgp-present?(rows[-1], "verdicts") ? [] : foldl((acc, v) => append(acc, sd-open-of(v)), [], json-array-elements(json-object-get(rows[-1], "verdicts")));
  def sd-findings(opts) = map(f => [f[0], sd-clip(lrun-home-free(f[1]), 480)], filter(f => len(sd-long-words(f[1])) >= 5, append(append(sd-walls(sd-rows(sd-opt(opts, "proof", "receipts/exit-proof-ledger.jsonl"))), sd-refusals(sd-rows(sd-opt(opts, "turns", "receipts/native-turn-ledger.jsonl")))), sd-opens(sd-rows(sd-opt(opts, "register", "receipts/offline-voice-gap-register.jsonl"))))));
  def sd-asked-at(f, attempts) = foldl((at, r) => (String) fcgp-str(r, "finding") == f[1] ? (fcgp-num(r, "at_unix_ms") ?? 0) : at, 0, attempts);
  // the first finding no attempt asked, else the one asked longest ago
  def sd-pick(findings, attempts) = nil?(findings) ? nothing() : foldl((best, f) => sd-asked-at(f, attempts) < sd-asked-at(best, attempts) ? f : best, findings[0], findings[1:]);
  // ---- the ask
  def sd-packet(f) = "A finding this body wrote about itself:\n\n" ++ f[1] ++ "\n\nName the kind of thing this finding is, with an uncommon English word it does not use: common words are already taken. The word names its shape; it does not restate it. Answer in exactly two lines:\nWORD: <five lowercase words, the most fitting first, commas between>\nWHY: <one sentence saying how the first word fits this finding, naming what the finding says>";
  def sd-question(f) = append(["what", "one", "word", "names", "this", "finding"], sd-take(18, sd-tokens(f[1])));
  def sd-line-after(text, mark) = foldl((found, l) => (String) found == "" && (len(trim(l)) >= len(mark)) && ((String) sd-lower(substring(trim(l), 0, len(mark))) == sd-lower(mark)) ? trim(substring(trim(l), len(mark), len(trim(l)))) : found, "", split-on(text, "\n"));
  def sd-words-of(reply) = map(w => trim(w), split-on(sd-lower(sd-line-after(reply, "WORD:")), ","));
  // the first offered word whose own tests hold, else the first offered: its name is what the attempt was refused by. A WHY speaks of the first word, so a later word is asked its own (sd-why-for)
  def sd-word-pick(words, finding, corpus, offered, lexicon) = foldl((best, w) => (String) sd-word-judge(best, finding, corpus, offered, lexicon) == "" ? best : (String) sd-word-judge(w, finding, corpus, offered, lexicon) == "" ? w : best, words[0], words[1:]);
  def sd-why-packet(f, word) = "A finding this body wrote about itself:\n\n" ++ f[1] ++ "\n\nThe word " ++ word ++ " names its shape. Answer in exactly one line:\nWHY: <one sentence saying how " ++ word ++ " fits this finding, naming what the finding says>";
  def sd-ask-why(f, word) { let v = fcnv-ask(sd-why-packet(f, word), json-node-object([fhn-n("max_reply_tokens", 96), fhn-n("reply_budget", 128), fhn-s("enquiry_kind", qc-measurement()), fhn-s("enquiry", "why one word fits a finding")])); (String) v[0] == "answered" ? sd-why-of(trim(v[1])) : ""; }
  def sd-why-for(f, word, first, why, opts) = (String) word == first || (String) fcgp-str(opts, "reply") != "" ? why : sd-ask-why(f, word);
  def sd-why-of(reply) = sd-line-after(reply, "WHY:");
  // ---- the judge: the name of what the answer fails, "" when it holds
  def sd-shared(why, finding) { let mine = sd-long-words(finding); len(filter(w => any?(m => (String) m == w, mine), sd-distinct(sd-long-words(why)))); }
  def sd-judge(word, why, finding, corpus, offered, lexicon) { let n = sd-word-judge(word, finding, corpus, offered, lexicon); (String) n != "" ? n : len(sd-tokens(why)) < 6 ? "no-why" : sd-shared(why, finding) < 2 ? "why-untethered" : ""; }
  def sd-word-judge(word, finding, corpus, offered, lexicon) =
   !sd-word?(word) ? "no-word"
   : sd-has?(corpus, word) || sd-has?(corpus, sd-capital(word)) ? "not-fresh"
   : any?(r => (String) fcgp-str(r, "fresh") == word, offered) ? "already-offered"
   : sd-has?(sd-lower(finding), word) ? "echo"
   : nothing?(lexicon) ? "no-lexicon"
   : !sd-has?("\n" ++ lexicon ++ "\n", "\n" ++ word ++ "\n") ? "not-a-word"
   : "";
  // ---- the rows
  def sd-date() = parse-int(str-join(split-on(hw-day-in(hw-zone-ms(), now_unix_ms()), "-"))) ?? 0;
  def sd-candidate(f, word, why, v) = json-node-object([fhn-n("at_unix_ms", now_unix_ms()), fhn-n("date", sd-date()), json-node-pair("q", json-node-array(map(w => json-node-string(w), sd-question(f)))), fhn-s("a", word), fhn-s("fresh", word), fhn-s("src", sd-source()), fhn-s("verdict", "admitted"), fhn-s("why", why), fhn-s("where", f[0]), fhn-s("finding", f[1]), fhn-s("model", v[4]), fhn-n("generated_ids", v[3]), fhn-s("session", lrun-session())]);
  def sd-attempt(f, verdict, name, said, v) = json-node-object([fhn-n("at_unix_ms", now_unix_ms()), fhn-s("verdict", verdict), fhn-s("refused", name), fhn-s("where", f[0]), fhn-s("finding", f[1]), fhn-s("said", sd-clip(said, 480)), fhn-s("model", v[4]), fhn-n("generated_ids", v[3]), fhn-s("session", lrun-session())]);
  def sd-say(line) { let p = print_str("[self-distill] " ++ line); line; }
  // ---- the voice: a band's stand-in reply opens no model
  def sd-voice(f, opts) = (String) fcgp-str(opts, "reply") != "" ? ["answered", fcgp-str(opts, "reply"), 0, 1, "stand-in", 0, 1, "", "", [], ""] : fcnv-ask(sd-packet(f), json-node-object([fhn-n("max_reply_tokens", 96), fhn-n("reply_budget", 128), fhn-s("enquiry_kind", qc-measurement()), fhn-s("enquiry", "one word for a finding")]));
  def sd-window-ms() = 180000;
  def sd-window-why(opts) = nothing?(fcgp-num(opts, "until_ms")) || (fcgp-num(opts, "until_ms") - host_monotonic_ms() >= sd-window-ms()) ? "" : "the window cannot hold an ask: no finding was asked";
  def sd-land(f, v, opts) = (String) v[0] != "answered" ? sd-held(f, v, opts) : sd-judged(f, v, trim(v[1]), opts);
  def sd-held(f, v, opts) {
   let kept = fhn-append(sd-ledger(opts), lrun-row-line(sd-attempt(f, "held", "", v[7], v)) ++ "\n");
   sd-say("held: the voice ended " ++ v[0] ++ " (" ++ lrun-home-free(v[7]) ++ ") on " ++ f[0]);
  }
  def sd-judged(f, v, reply, opts) {
   let firstWhy = sd-why-of(reply);
   let corpus = read_file(sd-corpus(opts)) ?? "";
   let offered = sd-rows(sd-candidates(opts));
   let lexicon = read_file(sd-lexicon(opts));
   let words = sd-words-of(reply);
   let word = sd-word-pick(words, f[1], corpus, offered, lexicon);
   let why = (String) sd-word-judge(word, f[1], corpus, offered, lexicon) == "" ? sd-why-for(f, word, words[0], firstWhy, opts) : firstWhy;
   let name = sd-judge(word, why, f[1], corpus, offered, lexicon);
   let kept = fhn-append(sd-ledger(opts), lrun-row-line(sd-attempt(f, (String) name == "" ? "admitted" : "refused", name, reply ++ "\nJUDGED: " ++ word ++ "\nITS WHY: " ++ why, v)) ++ "\n");
   (String) name == "" ? sd-admitted(f, word, why, v, opts) : sd-say("refused by name " ++ name ++ ": the voice said \"" ++ word ++ ": " ++ sd-clip(lrun-home-free(why), 200) ++ "\" on " ++ f[0]);
  }
  def sd-admitted(f, word, why, v, opts) {
   let kept = fhn-append(sd-candidates(opts), lrun-row-line(sd-candidate(f, word, why, v)) ++ "\n");
   sd-say("admitted " ++ word ++ " from " ++ f[0] ++ " to " ++ sd-candidates(opts) ++ " (" ++ kept ++ "): " ++ sd-clip(why, 200));
  }
  def sd-run(opts) {
   let f = sd-pick(sd-findings(opts), sd-rows(sd-ledger(opts)));
   let why = sd-window-why(opts);
   nothing?(f) ? sd-say("no finding stands: no voice was asked") : (String) why != "" ? sd-say(why) : sd-land(f, sd-voice(f, opts), opts);
  }
 }
 0;
}
