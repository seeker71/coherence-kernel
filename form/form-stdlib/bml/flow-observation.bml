// Same-process windows. Counts are dispatch entries, never a time estimate;
// native inlining/loop iterations and child kernels have separate coverage.
import form-stdlib/bml/source-abstraction.bml;
section [form.bml] {
 class FlowObservation {
  def fo-snapshot() {
   kernel_stat(0);
   let page = kernel_live(host_pid());
   [host_monotonic_ms(),host_cpu_us(),page[5],kernel_page_hot(host_pid(),page[27]),kernel_stat(13)];
  }
  def fo-key(row) = str-join([row[2],":",row[3].str(),":",row[4].str(),":",row[1]]);
  def fo-same-unit(a,b) = bml-source-absolute(a) == bml-source-absolute(b);
  def fo-definitions(files) = foldl((out,file) => append(map(d => append([file[0],file[1],file[3]],d),file[4]),out),[],files);
  // Cached merged units can name their enclosing unit. Recover only observed
  // names, from the live definition offsets and exact admitted module bytes.
  def fo-origins(rows) {
   let defs=fo-definitions(sa-read(sa-path("source.fkb")));
   let index=foldl((m,d) => record_set(m,d[3],cons(d,record_has(m,d[3]) ? record_get(m,d[3]) : [])),record_new(0),defs);
   let needed=rows |> filter(row => record_has(index,row[1]) && len(record_get(index,row[1])) > 1 && len(filter(d => fo-same-unit(d[0],row[2]),record_get(index,row[1]))) != 1);
   nil?(needed) ? [] : {
    let names=foldl((m,row) => record_set(m,row[1],1),record_new(0),needed);
    let pid=host_pid(); let header=kernel_ast(pid,-1);
    let source=kernel_ast(pid,["src",0,header[1]]);
    let slots=0 .. header[2] |> map(i => kernel_ast(pid,["defn",i])) |> map(slot => [kernel_ast(pid,["src",slot[0],slot[1]]),slot[0]]) |> filter(slot => record_has(names,slot[0]));
    let positions=foldl((held,line) => [record_set(held[0],held[2].str(),held[1]),held[1] + len(line) + 1,held[2] + 1],[record_new(0),0,1],split-on(source,"\n"))[0];
    let modules=record_new(0);
    needed |> map(row => {
     let offset=record_has(positions,row[3].str()) ? record_get(positions,row[3].str()) + row[4] - 1 : nothing;
     let observed=filter(slot => slot[0] == row[1] && slot[1] == offset,slots);
     let matched=record_get(index,row[1]) |> filter(d => {
      !record_has(modules,d[0]) ? record_set(modules,d[0],read_file(d[0])) : 0;
      let text=record_get(modules,d[0]); let at=str_find(source,text,0);
      len(text) > 0 && at >= 0 && any?(slot => slot[1] >= at && slot[1] < at + len(text),observed);
     });
     len(matched) == 1 ? [fo-key(row),matched[0][0],matched[0][1],matched[0][5]] : [];
    }) |> filter(origin => !nil?(origin));
   };
  }
  def fo-index(rows) = foldl((index,row) => record_set(index,fo-key(row),row),record_new(0),rows);
  def fo-deltas(before,after) {
   let index = fo-index(before);
   filter(row => row[0] > 0 || row[9] > 0,map(row => {
    let base = record_has(index,fo-key(row)) ? record_get(index,fo-key(row)) : [0,"","",0,0,0,0,0,0,0];
    [row[0] - base[0],row[1],row[2],row[3],row[4],row[5] - base[5],row[6] - base[6],row[7],row[8] - base[8],row[9] - base[9]];
   },after));
  }
  def fo-file(lane,owner) = sa-path("run-" + (bml-source-fingerprint(lane + (":" + owner)) + ".fkb"));
  // The admitted catalog travels with the run; current-source joins compare
  // these fingerprints, rather than assigning old heat to replacement code.
  def fo-open(lane,owner) {
   sa-prepare();
   let sources = map(row => [row[0],row[1]],sa-read(sa-path("source.fkb")));
   let path = fo-file(lane,owner);
   let old = sa-read(path);
   !nil?(old) && old[0] == "complete" ? sa-write(path + ".previous",old) : "";
   sa-write(path,["open",lane,owner,now_unix_ms(),sources]);
   [path,lane,owner,now_unix_ms(),sources,fo-snapshot()];
  }
  def fo-close(window) {
   let end = fo-snapshot(); let start = window[5];
   let roots = framebuffer-events(); let count = end[4] - start[4];
   let frames = filter(n => node_value(node_category(n)) == "bml-discovery-ms",drop(max2(0,len(roots) - count),roots));
   let timings = map(n => map(child => node_value(child),node_children(n)),frames);
   let rows = fo-deltas(start[3],end[3]);
   let recovery=host_monotonic_ms(); let origins=fo-origins(rows);
   let report = ["complete",window[1],window[2],window[3],window[4],end[0] - start[0],end[1] - start[1],end[2] - start[2],rows,timings,count,len(roots),["live-origins-v1",host_monotonic_ms() - recovery,origins]];
   sa-write(window[0],report);
   fb_record(intern_node(intern_trivial_string("abstraction-flow"),[intern_trivial_string(window[1]),intern_trivial_string(window[2]),intern_trivial_int(report[5]),intern_trivial_int(report[7])]),window[2],0);
   report;
  }
  def fo-measure(lane,owner,work) {
   let window = fo-open(lane,owner); let answer = work(); fo-close(window); answer;
  }
 }
}
