// Memory admission compares requested bytes, including pending leases, with the
// host's observed available memory. Wired pages and compression are live signals,
// never percentage quotas. Missing readings retain their failure.
// Shared model keys are charged once; a process owns its KV and scratch charge.
// Lease operations serialize observation and publication, retain owner identity,
// release at session close, and reclaim observed dead owners. Named allocation
// parts carry pending bytes until physical observation or explicit retirement.
// Caller deadlines remain caller data; elapsed time never settles a promise.
// Current witness: form-stdlib/tests/memory-governor-band.bml.
import form-stdlib/json.fk;
import form-stdlib/bml/dir-lock.bml;
import form-stdlib/bml/native-posix.bml;
import form-stdlib/bml/json-view-parse.bml;
section [form.bml] {
 class MemoryGovernor {
  def mg-gib() = 1073741824;
  def mg-max(a, b) = a > b ? a : b;
  def mg-pct(mem, p) = (mem / 100) * p;
  // host_vm_stat(): [page, memsize, free, active, inactive, wired, speculative, purgeable, compressor, pageins,
  // pageouts, compressions, decompressions, swapins, swapouts, external, internal], pages except the first two
  def mg-sense() {
   let vm=host_vm_stat();
   fb_record(vm,"memory-governor",0);
   vm;
  }
  def mg-vm-ok?(vm) = ((String) value_kind(vm) == "list") && (len(vm) >= 17) && (vm[0] > 0) && (vm[1] > 0);
  def mg-bytes(vm, k) = vm[k] * vm[0];
  def mg-mem(vm) = vm[1];
  def mg-wired(vm) = mg-bytes(vm, 5);
  def mg-compressor(vm) = mg-bytes(vm, 8);
  // Mach includes speculative_count in free_count; count those pages once.
  def mg-available(vm) = mg-bytes(vm, 2) + mg-bytes(vm, 7) + mg-bytes(vm, 15);
  // tenths of a GiB, said with one decimal
  def mg-gib-text(b) = ((b * 10) / mg-gib() / 10).str() ++ "." ++ (((b * 10) / mg-gib()) - (((b * 10) / mg-gib() / 10) * 10)).str() ++ " GiB";
  // [granted 1 or 0, reason, available, wired, mem]; reason is room, memory-unreadable, invalid-request or capacity
  def mg-verdict(vm, need) {
   let ok = mg-vm-ok?(vm);
   let mem = ok ? mg-mem(vm) : 0;
   let wired = ok ? mg-wired(vm) : 0;
   let avail = ok ? mg-available(vm) : 0;
   let why = !ok ? "memory-unreadable" : !mg-lease-bytes?(need) ? "invalid-request" : need > avail ? "capacity" : "room";
   [why == "room" ? 1 : 0, why, avail, wired, mem];
  }
  def mg-granted?(v) = v[0] == 1;
  def mg-low?(vm) = mg-vm-ok?(vm) && mg-available(vm) <= 0;
  def mg-ask(need) = mg-verdict(mg-sense(), need);
  // the reasons a lane's end names when the machine, not the work, ended it
  def mg-low-reason() = "host-memory-low";
  def mg-held-reason() = "host-memory-held:";
  def mg-memory-held?(reason) = ((String) value_kind(reason) == "string") && (len(reason) >= len(mg-held-reason())) && ((String) substring(reason, 0, len(mg-held-reason())) == mg-held-reason());
  def mg-memory-ending?(reason) = ((String) value_kind(reason) == "string") && (((String) reason == mg-low-reason()) || mg-memory-held?(reason));
  def mg-status-line(vm) = !mg-vm-ok?(vm) ? "[memory] unreadable: host_vm_stat answered nothing; no heavy open is granted" : "[memory] machine " ++ mg-gib-text(mg-mem(vm)) ++ ", available " ++ mg-gib-text(mg-available(vm)) ++ ", wired " ++ mg-gib-text(mg-wired(vm)) ++ ", compressor " ++ mg-gib-text(mg-compressor(vm)) ++ (mg-low?(vm) ? ", LOW: no available memory" : ", room");
  def mg-line(who, need, v) = "[memory] " ++ (mg-granted?(v) ? "granted" : "held") ++ " " ++ who ++ " needs " ++ (mg-lease-bytes?(need) ? mg-gib-text(need) : "unknown bytes") ++ ": " ++ v[1] ++ " (available " ++ mg-gib-text(v[2]) ++ ", wired " ++ mg-gib-text(v[3]) ++ " of " ++ mg-gib-text(v[4]) ++ ")";
  // Ask again until granted or the caller's time arrives. nothing keeps the
  // resource continuation open. sense() answers a
  // reading and sleep(ms) rests, so a band scripts both; now() is the clock.
  def mg-nap-first() = 10000;
  def mg-nap-most() = 60000;
  def mg-wait-with(who, need, until, sense, sleep, now, nap) = mg-wait-ask(who, need, until, () => mg-verdict(sense(), need), sleep, now, nap);
  // ask() answers a verdict (a bare reading's, or a lease's); a lease's verdict carries what it charged
  def mg-wait-ask(who, need, until, ask, sleep, now, nap) {
   let v = !nothing?(until) && now()>=until ? [0,"caller-deadline",0,0,0] : ask();
    (mg-granted?(v) || !nothing?(mg-reservation-of(v)) || (!nothing?(until) && now() >= until)) ? v : mg-wait-rest(who, need, until, ask, sleep, now, nap, v);
  }
  def mg-need-of(v, need) = len(v) > 5 ? v[5] : need;
  def mg-wait-rest(who, need, until, ask, sleep, now, nap, v) {
   let told = (nap == mg-nap-first()) ? print_str(mg-line(who, mg-need-of(v, need), v) ++ "; waiting for it to fall") : 0;
   let remaining=nothing?(until) ? nap : until - now();
   let rested = remaining>0 ? sleep(remaining<nap ? remaining : nap) : 0;
   !nothing?(until) && now()>=until ? v : mg-wait-ask(who, need, until, ask, sleep, now, (nap * 2) > mg-nap-most() ? mg-nap-most() : (nap * 2));
  }
  def mg-rest(ms) = host_sleep_ms(ms);
  def mg-now() = host_monotonic_ms();
  def mg-wait(who, need, until) = mg-wait-with(who, need, until, () => mg-sense(), ms => mg-rest(ms), () => mg-now(), mg-nap-first());

   // Reservations live until allocation observation or explicit release.
   def mg-lease-dir() = "/private/tmp/form-memory-leases";
   def mg-lease-patience-ms() = 10000;
   def mg-lease-lock(dir) = dir+"/lock";
   def mg-lease-int?(n) = value_kind(n)=="int";
   def mg-lease-bytes?(n) = mg-lease-int?(n) && n>=0;
   def mg-lease-row-ok?(r) = value_kind(r)=="list" && len(r)>=8 && mg-lease-int?(r[0]) && r[0]>0 && value_kind(r[1])=="string" && value_kind(r[2])=="string" && mg-lease-bytes?(r[3]) && mg-lease-bytes?(r[4]) && mg-lease-int?(r[5]) && r[5]>=0 && mg-lease-bytes?(r[6]) && mg-lease-int?(r[7]) && r[7]>=0;
   def mg-lease-file?(name) = len(name)>6 && substring(name,len(name)-6,len(name))==".lease";
   def mg-lease-live?(row) = dl-holds?(row[0],row[5]);
   def mg-lease-view(dir) {
    let names=host_dir_list(dir);
    value_kind(names)!="list" ? [] : filter(row=>!nothing?(row) && mg-lease-live?(row)!=false,map(name=>mg-reservation-read-text(read_file(dir+"/"+name)),filter(mg-lease-file?,names)));
   }
   def mg-lease-busy(vm) = [0,"lease-lock-busy",mg-vm-ok?(vm) ? mg-available(vm) : 0,mg-vm-ok?(vm) ? mg-wired(vm) : 0,mg-vm-ok?(vm) ? mg-mem(vm) : 0,0,0,nothing()];
   def mg-lease-at(dir,pid,who,key,shared,own,sense,now) = mg-lease-at-wait(mg-lease-patience-ms(),dir,pid,who,key,shared,own,sense,now);
   def mg-lease-at-wait(patience,dir,pid,who,key,shared,own,sense,now) {
    host_dir_mkdir(dir);
    host_path_is_dir(dir)!=1 ? mg-reservation-held(mg-verdict(sense(),0),"lease-dir-unavailable",0,0) : mg-lease-locked(patience,dir,pid,who,key,shared,own,sense,now);
   }
  // One grant owns one immutable identity. Named allocation parts keep pending
  // promises distinct from observed physical allocations and from siblings in
  // the same process. No elapsed time acknowledges or releases a part.
  def mg-reservation-schema() = "memory-reservation-v2";
  def mg-reservation-parts(row) = len(row)>10 ? row[10] : [["legacy",row[4],row[4]]];
  def mg-reservation-id(row) = len(row)>8 ? row[8] : row[0].str()+".legacy";
  def mg-reservation-shared-pending(row) = len(row)>9 ? row[9] : row[3];
  def mg-reservation-own-pending(row) = sum(map(part=>part[2],mg-reservation-parts(row)));
  def mg-reservation-part-valid?(part) = value_kind(part)=="list" && len(part)==3 && value_kind(part[0])=="string" && len(part[0])>0 && mg-lease-bytes?(part[1]) && mg-lease-bytes?(part[2]) && part[2]<=part[1];
  def mg-reservation-parts-valid?(parts) {
   let seen=record_new(0);
   value_kind(parts)=="list" && all?(part=>!mg-reservation-part-valid?(part) ? 0 : record_has(seen,part[0]) ? 0 : {record_set(seen,part[0],1);1;},parts);
  }
  def mg-reservation-row-valid?(row) = mg-lease-row-ok?(row) && value_kind(row[8])=="string" && len(row[8])>0 && mg-lease-bytes?(row[9]) && row[9]<=row[3] && mg-reservation-parts-valid?(row[10]) && sum(map(part=>part[1],row[10]))==row[4];
  def mg-reservation-part-view(part) = jv-array([jv-string(part[0]),jv-int(part[1]),jv-int(part[2])]);
  def mg-reservation-text(row) = jv-emit(jv-object([
   jv-s("schema",mg-reservation-schema()),jv-s("id",row[8]),jv-n("pid",row[0]),jv-s("who",row[1]),jv-s("key",row[2]),jv-n("shared",row[3]),jv-n("own",row[4]),jv-n("granted_unix_ms",row[5]),jv-n("shared_pending",row[9]),jv-pair("parts",jv-array(map(mg-reservation-part-view,row[10])))]))+"\n";
  def mg-reservation-read-view(view) {
   let base=[jv-str(view,"pid"),jv-str(view,"who"),jv-str(view,"key"),jv-str(view,"shared"),jv-str(view,jv-has(view,"own") ? "own" : "private"),jv-str(view,"granted_unix_ms"),0,0];
   !jv-has(view,"schema") ? (mg-lease-row-ok?(base) ? base : nothing()) : jv-str(view,"schema")!=mg-reservation-schema() ? nothing() : {
    let parts=map(part=>map(jv-value,jv-items(part)),jv-items(jv-get(view,"parts")));
    let row=append(base,[jv-str(view,"id"),jv-str(view,"shared_pending"),parts]);
    mg-reservation-row-valid?(row) ? row : nothing();
   };
  }
  def mg-reservation-read-text(text) = value_kind(text)!="string" ? nothing() : try mg-reservation-read-view(jvp-parse(text)) catch nothing();
  def mg-reservation-absent?(path) {
   let opened=nps-file-open(path,0);
   value_kind(opened)=="int" ? opened == -2 : nothing?(opened) ? 0 : {nps-file-settle(opened);0;};
  }
  def mg-reservation-snapshot(dir) {
   let rows=record_new(0,"rows",[],"unreadable",[]);
   let names=host_dir_list(dir);
   if value_kind(names)!="list" then record_set(rows,"unreadable",[dir]) else filter(mg-lease-file?,names) |> map(name=>{
    let path=dir+"/"+name;let row=mg-reservation-read-text(read_file(path));
    nothing?(row) ? record_set(rows,"unreadable",append(record_get(rows,"unreadable"),[path]))
     : mg-lease-live?(row)==false ? host_path_remove(path)
     : record_set(rows,"rows",append(record_get(rows,"rows"),[row]));
   });rows;
  }
  def mg-reservation-shared-count(rows) {
   let keys=record_new(0);
    filter(row=>row[2]!="",rows) |> map(row=>{
    let held=record_get(keys,row[2]) ?? [0,0];
    record_set(keys,row[2],[mg-max(held[0],row[3]),mg-max(held[1],row[3]-mg-reservation-shared-pending(row))]);
   });
    // An absent identity cannot establish shared storage, including for retained
    // legacy rows. Keep each such promise independent without rewriting it.
    sum(map(mg-reservation-shared-pending,filter(row=>row[2]=="",rows)))+sum(map(key=>{let held=record_get(keys,key);held[0]-held[1];},record_keys(keys)));
  }
  def mg-reservation-pending(rows) = sum(map(mg-reservation-own-pending,rows))+mg-reservation-shared-count(rows);
  def mg-reservation-new(pid,who,key,shared,own,at,id) = [pid,who,key,key=="" ? 0 : shared,own+(key=="" ? shared : 0),at,0,0,id,key=="" ? 0 : shared,[["allocation",own+(key=="" ? shared : 0),own+(key=="" ? shared : 0)]]];
  def mg-reservation-write(path,expected,row,lock,owner) {
   let text=mg-reservation-text(row);let part=path+".part";
   let publication=record_new(0,"path",path,"expected",expected,"candidate",text,"temporary",part,"phase","prepared","published",0,"released",0,"observed",0);
   record_set(owner,"publication",publication);
   !dl-owned?(lock) ? 0 : {
    let wrote=write_file(part,text);
    record_set(publication,"phase","written");record_set(publication,"wrote",wrote);
    wrote != len(text) || read_file(part)!=text ? 0 : {
     let result=host_path_rename(part,record_new(0,"path",path,"expected",expected));
     record_set(publication,"phase","commit-observed");record_set(publication,"guard",result);
     if record?(result) then {
      record_set(publication,"published",record_get(result,"published"));record_set(publication,"released",record_get(result,"released"));
      if record_get(result,"published")==1 then record_set(owner,"owns",1) else 0;
     } else 0;
     let observed=read_file(path)==text;record_set(publication,"observed",observed);
     record?(result) && record_get(result,"published")==1 && record_get(result,"released")==1 && observed;
    };
   };
  }
   def mg-reservation-publication-settle(token) {
    let publication=record_get(token,"publication");
     let operation=record_get(token,"lock-operation");
     record?(operation) && record_get(operation,"released")!=1 && !dl-settle-operation(operation) ? 0 : !record?(publication) ? 1 : {
     let guard=record_get(publication,"guard");
     let settled=record?(guard) ? nps-publication-release(guard) : record_get(publication,"phase")!="commit-observed";
     if settled then record_set(publication,"released",1) else 0;settled;
    };
   }
   def mg-reservation-token(dir,row) = record_new(0,"dir",dir,"path",dir+"/"+row[8]+".lease","id",row[8],"pid",row[0],"owns",0,"released",0);
  def mg-reservation-grant-of(v,need,pending,token) = [v[0],v[1],v[2],v[3],v[4],need,pending,token];
  def mg-reservation-held(v,reason,need,pending) = [0,reason,v[2],v[3],v[4],need,pending,nothing()];
   def mg-reservation-expired?(operation) = !nothing?(record_get(operation,"until")) && mg-now()>=record_get(operation,"until");
   def mg-reservation-judge(dir,lock,pid,who,key,shared,own,sense,clock,operation) = mg-reservation-expired?(operation) ? mg-reservation-held(mg-verdict(nothing(),0),"caller-deadline",0,0) : !mg-lease-bytes?(shared) || !mg-lease-bytes?(own) || value_kind(key)!="string" ? mg-reservation-held(mg-verdict(sense(),0),"invalid-request",0,0) : mg-reservation-judge-valid(dir,lock,pid,who,key,shared,own,sense,clock,operation);
   def mg-reservation-judge-valid(dir,lock,pid,who,key,shared,own,sense,clock,operation) {
   let snapshot=mg-reservation-snapshot(dir);let vm=sense();let at=clock();
   let id=pid.str()+"."+at.str()+"."+lock[1][0].str();
   let row=mg-reservation-new(pid,who,key,shared,own,at,id);
   let rows=record_get(snapshot,"rows");let pending=mg-reservation-pending(rows);
   let need=mg-reservation-pending(append(rows,[row]));let verdict=mg-verdict(vm,need);
    record_set(operation,"verdict",verdict);
   !nil?(record_get(snapshot,"unreadable")) ? mg-reservation-held(verdict,"lease-observation-unavailable",need,pending)
   : !mg-reservation-row-valid?(row) ? mg-reservation-held(verdict,"invalid-request",need,pending)
   : !mg-granted?(verdict) ? mg-reservation-grant-of(verdict,need,pending,nothing()) : {
    let token=mg-reservation-token(dir,row);let path=record_get(token,"path");
      record_set(operation,"token",token);record_set(token,"lock-operation",record_get(operation,"scope"));
      if value_kind(record_get(operation,"retain"))=="closure" then (record_get(operation,"retain"))(token) else 0;
    !mg-reservation-absent?(path) ? mg-reservation-held(verdict,"lease-identity-already-present",need,pending)
      : mg-reservation-expired?(operation) ? append(take(7,mg-reservation-held(verdict,"caller-deadline",need,pending)),[token])
      : !mg-reservation-write(path,nothing(),row,lock,token) ? append(take(7,mg-reservation-held(verdict,"lease-publication-incomplete",need,pending)),[token])
     : mg-reservation-grant-of(verdict,need,pending,token);
   };
  }
  def mg-reservation-of(grant) = len(grant)>7 ? grant[7] : nothing();
   def mg-reservation-change(token,change) = !record?(token) || record_get(token,"owns")!=1 || record_get(token,"released")==1 || !mg-reservation-publication-settle(token) ? 0 : {
    let operation=record_new(0);record_set(token,"lock-operation",operation);
    let result=try dl-with-lock-owned(mg-lease-lock(record_get(token,"dir")),mg-lease-patience-ms(),lock=>{
    let path=record_get(token,"path");let raw=read_file(path);let row=mg-reservation-read-text(raw);
    nothing?(row) || len(row)<11 || row[8]!=record_get(token,"id") || row[0]!=record_get(token,"pid") ? 0 : {
     let next=change(row);
     nothing?(next) || !mg-reservation-row-valid?(next) ? 0 : next==row ? 1 : mg-reservation-write(path,raw,next,lock,token);
    };
    },operation) catch 0;result==1 && record_get(operation,"released")==1;
  }
  def mg-reservation-with-parts(row,parts) = append(take(4,row),append([sum(map(part=>part[1],parts))],append(row[5:10],[parts])));
  def mg-reservation-partition(token,parts) = value_kind(parts)!="list" || !all?(part=>value_kind(part)=="list" && len(part)==2 && value_kind(part[0])=="string" && mg-lease-bytes?(part[1]),parts) ? 0 : !mg-reservation-parts-valid?(map(part=>[part[0],part[1],part[1]],parts)) ? 0 : mg-reservation-change(token,row=>{
   let proposed=map(part=>[part[0],part[1],part[1]],parts);
   map(part=>take(2,part),row[10])==parts ? row : len(row[10])!=1 || row[10][0][0]!="allocation" || row[10][0][1]!=row[10][0][2] || sum(map(part=>part[1],proposed))!=row[4] ? nothing() : mg-reservation-with-parts(row,proposed);
  });
  def mg-reservation-part(token,name) = record_new(0,"reservation",token,"part",name,"released",0);
  def mg-reservation-ack(part,bytes) = !record?(part) || record_get(part,"released")==1 || !mg-lease-bytes?(bytes) ? 0 : mg-reservation-change(record_get(part,"reservation"),row=>{
   let name=record_get(part,"part");let matches=filter(p=>p[0]==name,row[10]);
   len(matches)!=1 || bytes>matches[0][1] ? nothing() : mg-reservation-with-parts(row,map(p=>p[0]!=name ? p : [p[0],p[1],min2(p[2],p[1]-bytes)],row[10]));
  });
  def mg-reservation-ack-shared(token) = mg-reservation-change(token,row=>append(take(9,row),[0,row[10]]));
  def mg-reservation-retire(part) = !record?(part) ? 0 : record_get(part,"released")==1 || record_get(record_get(part,"reservation"),"released")==1 ? 1 : {
   let done=mg-reservation-change(record_get(part,"reservation"),row=>{
    let name=record_get(part,"part");
    !any?(p=>p[0]==name,row[10]) ? nothing() : mg-reservation-with-parts(row,map(p=>p[0]!=name ? p : [name,0,0],row[10]));
   });
   if done then record_set(part,"released",1) else 0;done;
  }
   def mg-reservation-release(token) = !record?(token) ? 0 : record_get(token,"released")==1 ? 1 : !mg-reservation-publication-settle(token) ? 0 : {
    let operation=record_new(0);record_set(token,"lock-operation",operation);
    let result=try dl-with-lock-owned(mg-lease-lock(record_get(token,"dir")),mg-lease-patience-ms(),lock=>{
    let path=record_get(token,"path");let raw=read_file(path);let row=mg-reservation-read-text(raw);
     let absent=nothing?(raw) && mg-reservation-absent?(path);
     let mine=record_get(token,"owns")==1 && !nothing?(row) && len(row)>10 && row[8]==record_get(token,"id") && row[0]==record_get(token,"pid");
     let removed=dl-owned?(lock) && (absent || mine && (host_path_remove(path)==0 || mg-reservation-absent?(path)));
     let part=path+".part";
     removed && (mg-reservation-absent?(part) || host_path_remove(part)==0 || mg-reservation-absent?(part));
    },operation) catch 0;
    let released=result==1 && record_get(operation,"released")==1;
    if released then record_set(token,"released",1) else 0;released;
  }
    def mg-lease-locked(patience,dir,pid,who,key,shared,own,sense,now) = mg-lease-locked-until(patience,dir,pid,who,key,shared,own,sense,now,nothing());
    def mg-lease-locked-until(patience,dir,pid,who,key,shared,own,sense,now,until) = mg-lease-locked-retaining(patience,dir,pid,who,key,shared,own,sense,now,until,nothing());
    def mg-lease-locked-retaining(patience,dir,pid,who,key,shared,own,sense,now,until,retain) {
     let scope=record_new(0);let operation=record_new(0,"scope",scope,"until",until,"retain",retain);
     if value_kind(retain)=="closure" then {
      let pending=mg-reservation-token(dir,mg-reservation-new(pid,who,"",0,0,0,"lock."+pid.str()+"."+host_monotonic_ms().str()));
      record_set(pending,"lock-operation",scope);record_set(operation,"token",pending);retain(pending);
     } else 0;
     let result=try dl-with-lock-owned(mg-lease-lock(dir),patience,owner=>{
      let grant=mg-reservation-judge(dir,owner,pid,who,key,shared,own,sense,now,operation);
      grant;
     },scope) catch nothing();
     record_get(scope,"released")==1 && !nothing?(result) ? result : {
      let held=mg-reservation-held(record_get(operation,"verdict") ?? mg-verdict(nothing(),0),"lease-operation-incomplete",0,0);
      let token=record_get(operation,"token");let lease=record_get(scope,"lease");
      let retained=record?(token) ? token : value_kind(lease)=="list" && record_get(scope,"released")!=1 ? mg-reservation-token(dir,mg-reservation-new(pid,who,"",0,0,0,"lock."+pid.str()+"."+lease[0].str())) : nothing();
      if record?(retained) then record_set(retained,"lock-operation",scope) else 0;
      nothing?(result) && nothing?(retained) && record_get(scope,"released")==1 ? mg-lease-busy(nothing()) : append(take(7,held),[retained]);
     };
   }
   def mg-lease(who,key,shared,own) = mg-lease-at(mg-lease-dir(),host_pid(),who,key,shared,own,mg-sense,now_unix_ms);
    def mg-lease-retaining(who,key,shared,own,retain) {
     let dir=mg-lease-dir();host_dir_mkdir(dir);
     host_path_is_dir(dir)!=1 ? mg-reservation-held(mg-verdict(mg-sense(),0),"lease-dir-unavailable",0,0) : mg-lease-locked-retaining(mg-lease-patience-ms(),dir,host_pid(),who,key,shared,own,mg-sense,now_unix_ms,nothing(),retain);
    }
   def mg-lease-wait-with(who,key,shared,own,until,ask,sleep,now) = mg-wait-ask(who,shared+own,until,ask,sleep,now,mg-nap-first());
    def mg-lease-until(who,key,shared,own,until) {
     let remaining=nothing?(until) ? nothing() : until - mg-now();let dir=mg-lease-dir();
     !nothing?(remaining) && remaining<=0 ? mg-reservation-held(mg-verdict(nothing(),0),"caller-deadline",0,0) : {
      host_dir_mkdir(dir);
      host_path_is_dir(dir)!=1 ? mg-reservation-held(mg-verdict(nothing(),0),"lease-dir-unavailable",0,0) : mg-lease-locked-until(nothing?(remaining) || remaining>mg-lease-patience-ms() ? mg-lease-patience-ms() : remaining,dir,host_pid(),who,key,shared,own,mg-sense,now_unix_ms,until);
     };
    }
    def mg-lease-wait(who,key,shared,own,until) = mg-lease-wait-with(who,key,shared,own,until,()=>mg-lease-until(who,key,shared,own,until),mg-rest,mg-now);
   // Old zero-argument callers can close exactly one observed claim. Multiple
   // claims require their owned token; no PID-wide deletion or byte subtraction.
   def mg-release-at(dir,pid) {
    let snapshot=dl-with-lock(mg-lease-lock(dir),mg-lease-patience-ms(),lock=>mg-reservation-snapshot(dir));
    !record?(snapshot) || !nil?(record_get(snapshot,"unreadable")) ? -1 : {
     let rows=filter(row=>row[0]==pid,record_get(snapshot,"rows"));
     nil?(rows) ? 0 : len(rows)!=1 || len(rows[0])<11 ? -1 : {
      let token=mg-reservation-token(dir,rows[0]);record_set(token,"owns",1);
      mg-reservation-release(token) ? 0 : -1;
     };
    };
   }
   def mg-release() = mg-release-at(mg-lease-dir(),host_pid());
   def mg-lease-read-state(dir) {
    let names=host_dir_list(dir);let state=record_new(0,"rows",[],"unreadable",[]);
    if value_kind(names)!="list" then record_set(state,"unreadable",[dir]) else map(name=>{
     let path=dir+"/"+name;let row=mg-reservation-read-text(read_file(path));
     nothing?(row) ? record_set(state,"unreadable",append(record_get(state,"unreadable"),[path])) : mg-lease-live?(row)==false ? 0 : record_set(state,"rows",append(record_get(state,"rows"),[row]));
    },filter(mg-lease-file?,names));state;
   }
   def mg-lease-ask-read-at(dir,need,vm,now) {
    let state=mg-lease-read-state(dir);let pending=mg-reservation-pending(record_get(state,"rows"));
    let verdict=mg-verdict(vm,need+pending);
    !nil?(record_get(state,"unreadable")) ? mg-reservation-held(verdict,"lease-observation-unavailable",need+pending,pending) : mg-reservation-grant-of(verdict,need+pending,pending,nothing());
   }
   def mg-lease-ask-read(dir,need) = mg-lease-ask-read-at(dir,need,mg-sense(),now_unix_ms());
   def mg-lease-wait-read(dir,who,need,until) = mg-wait-ask(who,need,until,()=>mg-lease-ask-read(dir,need),mg-rest,mg-now,mg-nap-first());
   def mg-lease-note(v) = len(v)>6 && v[6]>0 ? "; retained reservations still count "+mg-gib-text(v[6])+" as pending" : "";
   def mg-lease-age-s(row,now) = (now - row[5])/1000;
   def mg-lease-state(row,now) = mg-reservation-own-pending(row)+mg-reservation-shared-pending(row)>0 ? "pending" : "allocation-observed";
   def mg-lease-line(row,now) = "[memory] lease pid "+row[0].str()+" "+row[1]+" key "+(row[2]=="" ? "none" : row[2])+" shared "+mg-gib-text(row[3])+" own "+mg-gib-text(row[4])+" age "+mg-lease-age-s(row,now).str()+" s "+mg-lease-state(row,now);
   def mg-lease-lines(rows,now) = map(row=>mg-lease-line(row,now),rows);
  }
  0;
}
