// Prompt-only admission to the existing native planner and coding walk.
import form-stdlib/bml/host-child.bml;
import form-stdlib/bml/form-agent-tool-wire.bml;
import form-stdlib/bml/form-cli-check-witness.bml;
import form-stdlib/sha256.fk;
import form-stdlib/hex.fk;
import control/offer-ack-core.fk;
import form-stdlib/bml/rented-work.bml;
section [form.bml] {
 class FormCliTask {
  def fct-string(obj,key) = fat-wire-string?(json-object-get(obj,key)) ? json-string-value(json-object-get(obj,key)) : "";
  def fct-pair(key,value) = json-node-pair(key,json-node-string(value));
  def fct-trim-path(word) = len(word)==0 ? word : str_find("`\"'([{",substring(word,0,1),0)>=0 ? fct-trim-path(substring(word,1,len(word))) : str_find("`\"')]}.,;:",substring(word,len(word)-1,len(word)),0)>=0 ? fct-trim-path(substring(word,0,len(word)-1)) : word;
  def fct-path?(path) = len(path)>0 && !fat-has(split-on(path,"/"),"..") && !fat-starts(path,"/") && file_size(path)>=0 && fs_is_dir(path)!=1;
  def fct-words(goal) = foldl((parts,separator) => foldl((words,part) => append(words,split-on(part,separator)),[],parts),[goal],[" ","\t","\r","\n"]);
  def fct-paths(goal) = foldl((paths,word) => { let path=fct-trim-path(word); fct-path?(path) && !fat-has(paths,path) ? append(paths,[path]) : paths; },[],fct-words(goal));
  def fct-id(goal) = "task-" + substring(hex-encode(sha256-stream-string(goal)),0,16);
  def fct-request(goal,paths) = json-node-object([fct-pair("id",fct-id(goal)),fct-pair("title",goal),fct-pair("problem",goal),fct-pair("needs",goal),fct-pair("where",paths[0]),json-node-pair("files",json-node-array(paths |> map(json-node-string))),fct-pair("evidence","Caller supplied the task only. Source, contract, implementation and verification belong to the native flow.")]);
  def fct-queued(id) = foldl((held,line) => {
   let row=len(trim(line))==0 ? json-node-object([]) : parse-json("task-queue-row",line);
   fct-string(row,"request")==id ? row : held;
  },json-node-object([]),split-on(read_file("learn/native-turn-queue.jsonl") ?? "","\n"));
  def fct-plan-row(gap) = foldl((held,line) => {
   let row=len(trim(line))==0 ? json-node-object([]) : parse-json("task-plan-row",line);
   fct-string(row,"request")==fct-string(gap,"request") && fct-string(row,"plan_id")==fct-string(gap,"id") && fct-string(row,"verdict")=="verified" ? row : held;
  },json-node-object([]),split-on(read_file(".hearth/local-plans/ledger.jsonl") ?? "","\n"));
  def fct-plan-candidate(gap) {
   let row=fct-plan-row(gap); let scratch=fct-string(row,"scratch");
   scratch=="" ? "" : {
    let paths=json-array-elements(json-object-get(gap,"writable")) |> map(json-string-value);
    len(paths)!=1 ? "" : fct-plan-candidate-at(gap,".hearth/local-plans/scratch/" + scratch,paths[0]);
   };
  }
  def fct-plan-candidate-at(gap,root,path) {
   let candidate=root + "/reference/" + path;
   let original=root + "/today/" + path;
   let band=fct-string(gap,"band");
   let docs=[[path,path,read_file(candidate) ?? ""]] + (json-array-elements(json-object-get(gap,"sources")) |> map(json-string-value) |> map(p=>[p,p,read_file(p) ?? ""]));
   let checks=json-array-elements(json-object-get(gap,"checks"));
   file_size(candidate)>=0 && read_file(original)==read_file(path) && read_file(root + "/reference/" + band)==read_file(band) && !any?(check=>!fccw-eval(check,docs)[0],checks) ? candidate : "";
  }
  // Native callers keep complete planning and execution cell records, including
  // its typed value, diagnostics and stop. Rendering belongs to the terminal.
  def fct-report(id,stage,owner,why,plan,execution) {
   let kind="form-native-task-v1";
   let metadata=json-node-object([fct-pair("schema",kind),fct-pair("task",id),fct-pair("stage",stage),fct-pair("trace_owner",owner),fct-pair("reason",why)]);
   let report=intern_node(bp(kind),[metadata,plan,execution]);
   fb_record(report,"form-cli-task.bml",42);
   report;
  }
  def fct-render-cell(execution) {
   if nothing?(execution) then json-node-null() else {
    let value=record_get(execution,"value");
    let walk=value_kind(value)=="node_id" && node_eq(node_category(value),bp("native-turn-result"));
    let parts=walk ? node_children(value) : [];
    let outcome=walk ? (oac-one?(parts[2]) ? oac-payload(parts[2]) : nothing()) : value;
    let findings=walk ? oac-payload(parts[3]) : [];
    let shown=nothing?(outcome) ? json-node-null() : value_kind(outcome)=="node_id" ? outcome : value_kind(outcome)=="int" ? json-node-int(outcome) : json-node-string(cs-value-text(outcome));
    json-node-object([fct-pair("reason",hch-cell-why(execution)),json-node-pair("errors",json-node-int(record_get(execution,"errors"))),json-node-pair("result",shown),json-node-pair("findings",json-node-array(findings |> map(m=>json-node-object([fct-pair("finding",m[0]),fct-pair("checkpoint",m[1]),json-node-pair("ends_walk",json-node-bool(m[2])),fct-pair("kind",m[4]),fct-pair("rung",len(m)>5 ? m[5] : "")]))))]);
   };
  }
  def fct-render(report) {
   let parts=node_children(report);
   let publication=len(parts) > 3 ? record_get(parts[3],"value") : nothing();
   let metadata=!nothing?(publication) && value_kind(publication) == "node_id" && node_eq(node_category(publication),bp("form-native-publication-v1")) ? node_children(publication)[0] : json-node-null();
   json-emit(json-node-object(json-object-pairs(parts[0])+[json-node-pair("plan",fct-render-cell(parts[1])),json-node-pair("execution",fct-render-cell(parts[2])),json-node-pair("publication",metadata)]));
  }
  def fct-completed(gap,io) {
   let id=fct-string(gap,"id");
   let rows=filter(line=>len(trim(line))>0,split-on(read_file("receipts/native-turn-ledger.jsonl") ?? "","\n")) |> map(line=>parse-json("owned-publication",line));
   let published=id != "" && any?(row=>fct-string(row,"gap")==id && json-int-value(json-object-get(row,"published"))==1 && json-int-value(json-object-get(row,"band_green"))==1,rows);
   !published ? false : {
    let band=hch-cell-observe(io,"completion",cell_call(fct-string(gap,"band"),nothing(),nothing()));
    let paths=json-array-elements(json-object-get(gap,"writable")) + json-array-elements(json-object-get(gap,"sources"));
    let docs=paths |> map(json-string-value) |> map(path=>[path,path,read_file(path) ?? ""]);
    let checks=json-array-elements(json-object-get(gap,"checks"));
    hch-cell-status(band)==0 && record_get(band,"value")==json-int-value(json-object-get(gap,"full")) && !any?(check=>!fccw-eval(check,docs)[0],checks);
   };
  }
  def fct-command(request) {
   let text=value_kind(request) == "string";
   let raw=text ? request : fct-string(request,"goal");
   let resume=text ? "" : fct-string(request,"resume");
   let publish=text ? fat-starts(raw,"--publish ") : json-object-has?(request,"publication");
   let goal=text && publish ? substring(raw,len("--publish "),len(raw)) : raw;
   let paths=fct-paths(goal);
   let result=resume != "" ? fct-resume(resume) : len(trim(goal))==0 || nil?(paths) ? fct-report(fct-id(goal),"attention","","Name the task and its existing repository file in the prompt; Form owns source discovery and checks.",nothing(),nothing()) : fct-run(goal,paths);
   publish && fct-string(node_children(result)[0],"stage") == "completed" ? fct-publish(goal,result,text ? json-node-object([]) : json-object-get(request,"publication")) : result;
  }
  def fct-resume(id) {
   let gap=fct-queued(id); let io=".hearth/tasks/" + id;
   fct-string(gap,"id") == "" ? fct-report(id,"attention",io,"The requested task has no retained native queue entry.",nothing(),nothing()) : fct-completed(gap,io) ? fct-report(id,"completed",io,"Published work and original checks still hold.",nothing(),nothing()) : {
    let turn=hch-cell-observe(io,"turn",cell_call("observe/native-turn-run.bml",json-node-object([json-node-pair("gap",gap),fct-pair("session",id)]),nothing()));
    fct-report(id,fct-completed(gap,io) ? "completed" : "attention",io,hch-cell-why(turn),nothing(),turn);
   };
  }
  def fct-publish(goal,result,publication) {
   let parts=node_children(result); let id=fct-string(parts[0],"task"); let gap=fct-queued(id);
   let session=fct-string(publication,"rented_session");
   let work=session == "" ? nothing() : rw-read(session);
   let meter=nothing?(work) ? nothing() : rw-close(rw-save(rw-step(work,ru-read(work[2]),"work")));
   let extra=json-array-elements(json-object-get(publication,"paths"));
   let body=fct-string(publication,"body");
   let request=json-node-object([fct-pair("owner",id),fct-pair("subject",fct-string(publication,"subject") == "" ? "Form task " + id : fct-string(publication,"subject")),fct-pair("body",body != "" ? body : goal == "" ? fct-string(gap,"goal") : goal),json-node-pair("paths",json-node-array(json-array-elements(json-object-get(gap,"writable")) + extra + (session == "" ? [] : [json-node-string(rw-ledger())]))),json-node-pair("task",gap),json-node-pair("main",json-node-int(1)),json-node-pair("rented_usage",nothing?(meter) ? json-node-null() : jv-materialize(rw-measure(meter)))]);
   let landed=hch-cell-observe(id,"publication",cell_call("observe/land-run.bml",request,nothing()));
   let receipt=record_get(landed,"value");
   let native=value_kind(receipt) == "node_id" && node_eq(node_category(receipt),bp("form-native-publication-v1"));
   let done=hch-cell-status(landed) == 0 && native && fct-string(node_children(receipt)[0],"stage") == "published" && fct-completed(gap,fct-string(parts[0],"trace_owner"));
   let report=fct-report(id,done ? "completed" : "attention",fct-string(parts[0],"trace_owner"),native ? fct-string(node_children(receipt)[0],"reason") : hch-cell-why(landed),parts[1],parts[2]);
   intern_node(bp("form-native-task-v1"),node_children(report) + [landed]);
  }
  def fct-run(goal,paths) {
   let id=fct-id(goal); let io=".hearth/tasks/" + id;
   fct-completed(fct-queued(id),io) ? fct-report(id,"completed",io,"Published work and original checks still hold.",nothing(),nothing()) : fct-plan-run(goal,paths,id,io);
  }
  def fct-plan-run(goal,paths,id,io) {
   let plan=hch-cell-observe(io,"plan",cell_call("observe/local-plan-run.bml",fct-request(goal,paths),nothing()));
   let queued=record_get(plan,"value"); let gap=nothing?(queued) ? "" : fct-string(queued,"id");
   let why=hch-cell-why(plan);
   fct-completed(queued,io) ? fct-report(id,"completed",io,"Published work and original checks still hold.",plan,nothing()) : hch-cell-status(plan)!=0 || gap=="" ? fct-report(id,"attention",io,why=="" ? "Local planner has not verified a queued task; the plan carries its outcome and latest finding." : why,plan,nothing()) : {
    let turn=hch-cell-observe(io,"turn",cell_call("observe/native-turn-run.bml",json-node-object([json-node-pair("gap",queued),fct-pair("session",id)]),nothing()));
    fct-report(id,fct-completed(queued,io) ? "completed" : "attention",io,hch-cell-why(turn),plan,turn);
   };
  }
 }
}
