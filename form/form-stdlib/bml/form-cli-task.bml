// Prompt-only admission to native coding, owned observations and publication.
import form-stdlib/bml/host-child.bml;
import form-stdlib/bml/form-agent-tool-wire.bml;
import form-stdlib/bml/form-cli-check-witness.bml;
import form-stdlib/sha256.fk;
import form-stdlib/hex.fk;
import control/offer-ack-core.fk;
import form-stdlib/bml/rented-work.bml;
import form-stdlib/bml/form-cli-local-plan.bml;
import form-stdlib/bml/form-cli-task-runtime.bml;
import form-stdlib/bml/form-cli-code-request.bml;
section [form.bml] {
 class FormCliTask {
  def fct-string(obj,key) = fat-wire-string?(json-object-get(obj,key)) ? json-string-value(json-object-get(obj,key)) : "";
  def fct-pair(key,value) = json-node-pair(key,json-node-string(value));
  def fct-trim-path(word) = len(word)==0 ? word : str_find("`\"'([{",substring(word,0,1),0)>=0 ? fct-trim-path(substring(word,1,len(word))) : str_find("`\"')]}.,;:",substring(word,len(word)-1,len(word)),0)>=0 ? fct-trim-path(substring(word,0,len(word)-1)) : word;
  def fct-path?(path) = len(path)>0 && !fat-has(split-on(path,"/"),"..") && !fat-starts(path,"/") && file_size(path)>=0 && fs_is_dir(path)!=1;
  def fct-words(goal) = foldl((parts,separator) => foldl((words,part) => append(words,split-on(part,separator)),[],parts),[goal],[" ","\t","\r","\n"]);
  def fct-paths(goal) = foldl((paths,word) => { let path=fct-trim-path(word); fct-path?(path) && !fat-has(paths,path) ? append(paths,[path]) : paths; },[],fct-words(goal));
  def fct-id(goal) = "task-" + substring(hex-encode(sha256-stream-string(goal)),0,16);
  def fct-request(goal,paths) = json-node-object([fct-pair("id",fct-id(goal)),fct-pair("title",goal),fct-pair("problem",goal),fct-pair("needs",goal),fct-pair("where",paths[0]),json-node-pair("files",json-node-array(paths |> map(json-node-string))),fct-pair("evidence","Caller supplied the task only. Source, contract, implementation and verification belong to the native flow.")]);
  def fct-queued(id) = foldl((held,line) => {
   let row=len(trim(line))==0 ? json-node-object([]) : parse-json("task-queue-row",line);
   fct-string(row,"request")==id ? row : held;
  },json-node-object([]),split-on(read_file("learn/native-turn-queue.jsonl") ?? "","\n"));
  def fct-plan-row(gap) = foldl((held,line) => {
   let row=len(trim(line))==0 ? json-node-object([]) : parse-json("task-plan-row",line);
   fct-string(row,"request")==fct-string(gap,"request") && fct-string(row,"plan_id")==fct-string(gap,"id") && fct-string(row,"verdict")=="verified" ? row : held;
  },json-node-object([]),split-on(read_file(".hearth/local-plans/ledger.jsonl") ?? "","\n"));
  def fct-plan-candidate(gap) {
   let row=fct-plan-row(gap);
   let referencePath=fct-string(gap,"plan_reference_reply");
   let retained=referencePath != "" ? referencePath : fct-string(row,"reference_reply") != "" ? fct-string(row,"reference_reply") : fct-string(row,"reply");
   let parsed=flp-parse(read_file(retained) ?? "");
   parsed[0]!="" ? nothing() : {
    let plan=parsed[2];let paths=json-array-elements(json-object-get(gap,"writable")) |> map(json-string-value);
    let owned=flp-p-writable(plan)==paths && flp-p-defs(plan)==flp-defs-of(gap,paths) && flp-p-band(plan)==fct-string(gap,"band") && flp-p-full(plan)==json-int-value(json-object-get(gap,"full")) && value_eq(flp-p-checks(plan),json-object-get(gap,"checks")) && flp-p-text(plan)==read_file(fct-string(gap,"band"));
    !owned ? nothing() : {
     let texts=paths |> map(path=>[path,flp-standing(plan,path,(text,definition,bml)=>flp-ref-def(text,definition,bml,flp-p-reference(plan)))]);
     any?(pair=>nothing?(pair[1]),texts) ? nothing() : json-node-array(texts |> map(pair=>json-node-object([fct-pair("path",pair[0]),fct-pair("text",pair[1]),fct-pair("reference",flp-p-reference(plan))])));
    };
   };
  }
  // Native callers keep complete planning and execution cell records, including
  // its typed value, diagnostics and stop. Rendering belongs to the terminal.
  def fct-report(id,stage,owner,why,plan,execution) {
   let kind="form-native-task-v1";
   let metadata=json-node-object([fct-pair("schema",kind),fct-pair("task",id),fct-pair("stage",stage),fct-pair("trace_owner",owner),fct-pair("reason",why)]);
   let report=intern_node(bp(kind),[metadata,plan,execution]);
   fb_record(report,"form-cli-task.bml",42);
   report;
  }
  def fct-render-cell(execution) {
   if nothing?(execution) then json-node-null() else if value_kind(execution)=="node_id" then json-node-object(filter(pair=>fat-has(["schema","status","reason","checkpoint_id","turns","tool_calls","repair_attempts","check_runs","generated_ids","injected_ids","release_ok"],json-pair-key(pair)),json-object-pairs(execution))) else {
    let value=record_get(execution,"value");
    let walk=value_kind(value)=="node_id" && node_eq(node_category(value),bp("native-turn-result"));
    let parts=walk ? node_children(value) : [];
    let outcome=walk ? (oac-one?(parts[2]) ? oac-payload(parts[2]) : nothing()) : value;
    let findings=walk ? oac-payload(parts[3]) : [];
    let shown=nothing?(outcome) ? json-node-null() : value_kind(outcome)=="node_id" ? outcome : value_kind(outcome)=="int" ? json-node-int(outcome) : json-node-string(cs-value-text(outcome));
    json-node-object([fct-pair("reason",hch-cell-why(execution)),json-node-pair("errors",json-node-int(record_get(execution,"errors"))),json-node-pair("result",shown),json-node-pair("findings",json-node-array(findings |> map(m=>json-node-object([fct-pair("finding",m[0]),fct-pair("checkpoint",m[1]),json-node-pair("ends_walk",json-node-bool(m[2])),fct-pair("kind",m[4]),fct-pair("rung",len(m)>5 ? m[5] : "")]))))]);
   };
  }
  def fct-render(report) {
   let parts=node_children(report);
   let publication=len(parts) > 3 ? record_get(parts[3],"value") : nothing();
   let metadata=!nothing?(publication) && value_kind(publication) == "node_id" && node_eq(node_category(publication),bp("form-native-publication-v1")) ? node_children(publication)[0] : json-node-null();
   json-emit(json-node-object(json-object-pairs(parts[0])+[json-node-pair("plan",fct-render-cell(parts[1])),json-node-pair("execution",fct-render-cell(parts[2])),json-node-pair("publication",metadata)]));
  }
  def fct-completed(gap,io) {
   if fct-string(gap,"entry")=="direct-code" then fct-code-completed(gap,io) else {
   let id=fct-string(gap,"id");
   let rows=filter(line=>len(trim(line))>0,split-on(read_file("receipts/native-turn-ledger.jsonl") ?? "","\n")) |> map(line=>parse-json("owned-publication",line));
   let published=id != "" && any?(row=>fct-string(row,"gap")==id && json-int-value(json-object-get(row,"published"))>0 && json-int-value(json-object-get(row,"band_green"))==1,rows);
   !published ? false : {
    let band=hch-cell-observe(io,"completion",cell_call(fct-string(gap,"band"),nothing(),nothing()));
    let paths=json-array-elements(json-object-get(gap,"writable")) + json-array-elements(json-object-get(gap,"sources"));
    let docs=paths |> map(json-string-value) |> map(path=>[path,path,read_file(path) ?? ""]);
    let checks=json-array-elements(json-object-get(gap,"checks"));
    hch-cell-status(band)==0 && record_get(band,"value")==json-int-value(json-object-get(gap,"full")) && !any?(check=>!fccw-eval(check,docs)[0],checks);
   };
   };
  }
  def fct-command(request) {
   let text=value_kind(request) == "string";
   let raw=text ? request : fct-string(request,"goal");
   let resume=text ? "" : fct-string(request,"resume");
   let publish=text ? fat-starts(raw,"--publish ") : json-object-has?(request,"publication");
   let goal=text && publish ? substring(raw,len("--publish "),len(raw)) : raw;
   let paths=fct-paths(goal);
   let result=resume != "" ? fct-resume(resume) : len(trim(goal))==0 || nil?(paths) ? fct-report(fct-id(goal),"attention","","Name the task and its existing repository file in the prompt; Form owns source discovery and checks.",nothing(),nothing()) : fct-run(goal,paths);
   publish && fct-string(node_children(result)[0],"stage") == "completed" ? fct-publish(goal,result,text ? json-node-object([]) : json-object-get(request,"publication")) : result;
  }
  def fct-resume(id) {
   let gap=fct-queued(id); let io=".hearth/tasks/" + id;
   fct-string(gap,"id") == "" ? fct-report(id,"attention",io,"The requested task has no retained native queue entry.",nothing(),nothing()) : fct-string(gap,"entry")=="direct-code" ? fct-code-run(gap,io) : fct-completed(gap,io) ? fct-report(id,"completed",io,"Published work and original checks still hold.",nothing(),nothing()) : {
    let turn=hch-cell-observe(io,"turn",cell_call("observe/native-turn-run.bml",json-node-object([json-node-pair("gap",gap),fct-pair("session",id)]),nothing()));
    fct-report(id,fct-completed(gap,io) ? "completed" : "attention",io,hch-cell-why(turn),nothing(),turn);
   };
  }
  def fct-publish(goal,result,publication) {
   let parts=node_children(result); let id=fct-string(parts[0],"task"); let gap=fct-queued(id);
   let session=fct-string(publication,"rented_session");
   let work=session == "" ? nothing() : rw-read(session);
   let meter=nothing?(work) ? nothing() : rw-close(rw-save(rw-step(work,ru-read(work[2]),"work")));
   let band=fct-string(gap,"band");
   let owned=fctrt-owned(json-array-elements(json-object-get(gap,"writable")) |> map(json-string-value),band);
   let extra=(fat-starts(band,".hearth/") ? [] : [json-node-string(band)]) + json-array-elements(json-object-get(publication,"paths"));
   let body=fct-string(publication,"body");
   let request=json-node-object([fct-pair("owner",id),fct-pair("subject",fct-string(publication,"subject") == "" ? "Form task " + id : fct-string(publication,"subject")),fct-pair("body",body != "" ? body : goal == "" ? fct-string(gap,"goal") : goal),json-node-pair("paths",json-node-array((owned |> map(json-node-string)) + extra + (session == "" ? [] : [json-node-string(rw-ledger())]))),json-node-pair("task",gap),json-node-pair("main",json-node-int(1)),json-node-pair("rented_usage",nothing?(meter) ? json-node-null() : jv-materialize(rw-measure(meter)))]);
   let landed=hch-cell-observe(id,"publication",cell_call("observe/land-run.bml",request,nothing()));
   let receipt=record_get(landed,"value");
   let native=value_kind(receipt) == "node_id" && node_eq(node_category(receipt),bp("form-native-publication-v1"));
   let done=hch-cell-status(landed) == 0 && native && fct-string(node_children(receipt)[0],"stage") == "published" && fct-completed(gap,fct-string(parts[0],"trace_owner"));
   let report=fct-report(id,done ? "completed" : "attention",fct-string(parts[0],"trace_owner"),native ? fct-string(node_children(receipt)[0],"reason") : hch-cell-why(landed),parts[1],parts[2]);
   intern_node(bp("form-native-task-v1"),node_children(report) + [landed]);
  }
  def fct-run(goal,paths) {
   let id=fct-id(goal); let io=".hearth/tasks/" + id;
   let queued=fct-queued(id);
   fct-string(queued,"id")!="" ? fct-resume(id) : fct-start(goal,paths,id,io);
  }
  def fct-code-path(io,kind) = io+"/code-"+kind+".fkb";
  def fct-code-keep(path,value) = write_form_binary(path,value)>0 && node_eq(read_form_binary(path),value) ? value : form_error("native-task-continuity-write-refused");
  def fct-code-docs(result) = fat-wire-value(fat-wire-documents(result));
  def fct-code-ready?(result) = fct-string(result,"status")=="complete" && json-int-value(json-object-get(result,"release_ok"))==1;
  def fct-code-readings(gap,io) = json-array-elements(json-object-get(gap,"observations")) |> map(contract=>{
   let path=fct-string(contract,"path");let minimum=json-int-value(json-object-get(contract,"full"));
   let expected=fctrt-verdict(read_file(path));
   let reading=hch-cell-observe(io,"code-check",cell_call(path,nothing(),nothing()));
   let row=[path,minimum,expected,record_get(reading,"value"),hch-cell-status(reading),record_get(reading,"err")];
   fb_record(row,"task-source-observation",0);row;
  });
  def fct-code-holds?(rows) = !nil?(rows) && all?(row=>row[2]>=row[1] && row[2]>0 && row[3]==row[2] && row[4]==0,rows);
  def fct-code-check(context,docs) {
   let gap=record_get(context,"gap");let paths=flp-strs(gap,"writable");let checkpoint=record_get(context,"checkpoint");
   let candidate=paths |> map(path=>{let doc=fat-find-doc(docs,path);nil?(doc) ? nothing() : doc[2];});
   let changed=any?(path=>{let current=fat-find-doc(docs,path);let original=fat-find-doc(record_get(context,"originals"),path);!nil?(current) && !nil?(original) && current[2]!=original[2];},flp-strs(gap,"source_paths"));
   any?(value=>nothing?(value),candidate) ? [0,"An owned source document did not arrive."] : !changed ? [0,"The requested implementation has not changed its owned source. Read its native declarations and implement the original task; keep the owning observations."] : !hw-all-same?(paths,checkpoint) ? [0,"Owned source moved during this retained task; preserve its candidate and obtain current source."] : {
    let window=hw-with-published(record_get(context,"io"),paths,checkpoint,hw-over(candidate,checkpoint),()=>fct-code-readings(gap,record_get(context,"io")));
    let held=window[1] && window[2]=="" && !nothing?(window[0]) && fct-code-holds?(window[0]);
    [held,held ? "The implementation and original owning observations hold; source restoration completed." : "Native implementation observation or restoration remains open: "+window.str()];
   };
  }
  def fct-code-completed(gap,io) {
   let result=file_size(fct-code-path(io,"result"))>0 ? read_form_binary(fct-code-path(io,"result")) : json-node-object([]);
   !fct-code-ready?(result) ? false : {
    let docs=fct-code-docs(result);
    all?(path=>{let doc=fat-find-doc(docs,path);!nil?(doc) && read_file(path)==doc[2];},flp-strs(gap,"writable")) && fct-code-holds?(fct-code-readings(gap,io));
   };
  }
  def fct-code-run(gap,io) {
   let id=fct-string(gap,"id");
   let healed=hw-heal-publishes(io);
   !nil?(healed[1]) ? fct-report(id,"attention",io,hch-join(healed[1],"\n"),nothing(),nothing()) : fct-code-completed(gap,io) ? fct-report(id,"completed",io,"Native implementation and owning observations hold.",nothing(),read_form_binary(fct-code-path(io,"result"))) : {
    let request=read_form_binary(fct-code-path(io,"request"));let docs=fat-wire-value(fcaq-documents(request));let paths=flp-strs(gap,"writable");
    let admitted=paths |> map(path=>fat-find-doc(docs,path)[2]);
    !hw-all-same?(paths,admitted) ? fct-report(id,"attention",io,"Retained source differs from the current tree; keep the candidate and reconcile the changed source with its owner before installation.",nothing(),nothing()) : {
    let prior=file_size(fct-code-path(io,"result"))>0 ? read_form_binary(fct-code-path(io,"result")) : json-node-object([]);
    let checkpoint=fct-string(prior,"checkpoint_id");
    let offered=checkpoint=="" ? request : oh-set(request,"resume",json-node-string(checkpoint));
    let context=record_new(0,"gap",gap,"io",io,"originals",docs,"checkpoint",hw-tree(paths));
    let result=fct-code-keep(fct-code-path(io,"result"),fcaq-managed-with(offered,docs,[fct-code-check,context]));
    let accepted=fct-code-ready?(result) && hw-all-same?(paths,record_get(context,"checkpoint"));
    let candidate=fct-code-docs(result);
    let installed=accepted ? hw-install(io,paths,record_get(context,"checkpoint"),paths |> map(path=>{let doc=fat-find-doc(candidate,path);nil?(doc) ? nothing() : doc[2];})) : [false,true,""];
    let complete=installed[0] && all?(path=>{let doc=fat-find-doc(candidate,path);!nil?(doc) && read_file(path)==doc[2];},paths);
    let current=complete ? oh-set(gap,"full",json-node-int(fctrt-verdict(read_file(fct-string(gap,"band"))))) : gap;
    if complete then fhn-append(flp-queue(),json-emit(current)+"\n") else 0;
    fct-report(id,complete ? "completed" : "attention",io,complete ? "Native implementation verified, released and installed." : installed[2]!="" ? installed[2] : fct-string(result,"reason"),nothing(),result);
    };
   };
  }
  def fct-start(goal,paths,id,io) {
   let band=fctrt-band-for(fctrt-read-tree(),paths);
   band[0]=="" || band[1]<=0 ? fct-report(id,"attention",io,"The named source needs an owning native observation for this task.",nothing(),nothing()) : {
    let owned=fctrt-owned(paths,band[0]);
    let writable=fat-has(owned,band[0]) ? owned : owned+[band[0]];
    let sources=flp-callers(fct-request(goal,paths)) |> map(row=>row[0]) |> filter(path=>!fat-has(writable,path));
    let documents=(writable+sources) |> map(path=>[path,path,read_file(path)]);
    any?(doc=>nothing?(doc[2]),documents) ? fct-report(id,"attention",io,"A named source did not arrive; retain the task with its source owner.",nothing(),nothing()) : {
     let observations=( [band[0]] + (writable |> filter(path=>fctrt-band?(path) && path != band[0])) ) |> map(path=>json-node-object([fct-pair("path",path),json-node-pair("full",json-node-int(fctrt-verdict(read_file(path))))]));
     let names=flp-focus(fct-request(goal,paths));
     let request=json-node-object([fct-pair("goal",goal),fct-pair("code_entry","direct"),fct-pair("document_context","catalog"),json-node-pair("writable",flp-json-strings(writable)),json-node-pair("documents",fat-wire-documents-node(documents)),json-node-pair("checks",json-node-array([])),json-node-pair("source_queries",json-node-array([json-node-object([fct-pair("tool","bml-api"),json-node-pair("arguments",flp-json-strings(names))])]))]);
     let gap=json-node-object([fct-pair("id",id),fct-pair("request",id),fct-pair("entry","direct-code"),fct-pair("goal",goal),fct-pair("band",band[0]),json-node-pair("full",json-node-int(band[1])),json-node-pair("writable",flp-json-strings(writable)),json-node-pair("source_paths",flp-json-strings(paths)),json-node-pair("sources",flp-json-strings(sources)),json-node-pair("checks",json-node-array([])),json-node-pair("observations",json-node-array(observations))]);
     fs_mkdir(io);fct-code-keep(fct-code-path(io,"request"),request);fhn-append(flp-queue(),json-emit(gap)+"\n");
     fct-code-run(gap,io);
    };
   };
  }
 }
}
