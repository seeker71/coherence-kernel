// bml-form-lower.bml — the BML native compiler's run step on fkwu itself.
//
// A parsed, linked BML unit lowers into Form defns. Each method is one defn over
// its own parameters. Each mutable local is one Form name per assignment, found
// through the slot key grammars/bml.fk's scope reading gives its binding. A
// construct that carries locals out of it answers them as one tuple beside its
// value. The run's shared state -- the control mode, the returned and thrown
// values, FAILED and the field journal -- lives in one record the program owns.
// fkwu compiles the defns, runs them on its own evaluator and JIT, and prints
// one answer line; no recipe walker reads the program.
//
// The scope, the overload choice and the class layout are grammars/bml.fk's own
// readings; this unit reads them and writes Form.
//
// preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
section [form.bml] {
 class BmlFormLower {

  // ── Form text ─────────────────────────────────────────────────────────
  def bfk-q() = byte_to_str(34);
  def bfk-join(xs) = if nil?(xs) then "" else if nil?(tail(xs)) then head(xs) else str_concat(head(xs), str_concat(" ", bfk-join(tail(xs))));
  def bfk-form(xs) = str_concat("(", str_concat(bfk-join(xs), ")"));
  def bfk-f1(h, a) = bfk-form(list(h, a));
  def bfk-f2(h, a, b) = bfk-form(list(h, a, b));
  def bfk-f3(h, a, b, c) = bfk-form(list(h, a, b, c));
  def bfk-let(v, e) = bfk-f2("let", v, e);
  def bfk-do(items, last) = if nil?(items) then last else bfk-form(cons("do", append(items, list(last))));
  def bfk-int(n) = int_to_str(n);
  def bfk-special?(c) = or(eq(c, 34), or(eq(c, 92), or(eq(c, 10), or(eq(c, 9), eq(c, 13)))));
  def bfk-plain?(s, i, n) = if ge(i, n) then true else if bfk-special?(str_byte_at(s, i)) then false else bfk-plain?(s, add(i, 1), n);
  def bfk-esc-byte(c) = if eq(c, 34) then "\\\"" else if eq(c, 92) then "\\\\" else if eq(c, 10) then "\\n" else if eq(c, 9) then "\\t" else if eq(c, 13) then "\\r" else byte_to_str(c);
  def bfk-esc(s, i, n) = if ge(i, n) then "" else str_concat(bfk-esc-byte(str_byte_at(s, i)), bfk-esc(s, add(i, 1), n));
  def bfk-str(s) = str_concat(bfk-q(), str_concat(if bfk-plain?(s, 0, str_len(s)) then s else bfk-esc(s, 0, str_len(s)), bfk-q()));
  def bfk-if(c, t, e) = bfk-f3("if", c, t, e);

  // ── the run's state: one record the program owns ───────────────────────
  // m the control mode, v a returned value, t a thrown value, f FAILED,
  // j the field journal, c its count, d how many snapshots are open
  def bfk-cell(k) = bfk-form(list("record_get", "BFK", bfk-str(k)));
  def bfk-cell-set(k, e) = bfk-form(list("record_set", "BFK", bfk-str(k), e));
  def bfk-unfailed() = bfk-f2("le", bfk-cell("f"), "0");
  def bfk-mode-ok() = bfk-f2("le", bfk-cell("m"), "0");
  def bfk-mode-is(m) = bfk-f2("eq", bfk-cell("m"), bfk-int(m));
  def bfk-set-mode(m) = bfk-cell-set("m", bfk-int(m));

  // ── the lowering's own state ───────────────────────────────────────────
  def bfk-cx() {
   let cx = record_new(0);
   record_set(cx, "n", 0);
   record_set(cx, "defs", empty);
   record_set(cx, "needs", empty);
   cx;
  }
  def bfk-fresh(cx, stem) = bfk-fresh-at(cx, stem, add(record_get(cx, "n"), 1));
  def bfk-fresh-at(cx, stem, n) {
   record_set(cx, "n", n);
   str_concat(stem, int_to_str(n));
  }
  def bfk-add-def(cx, text) = record_set(cx, "defs", cons(text, record_get(cx, "defs")));
  // a need the lowering meets is voiced where it is met and withholds the program
  def bfk-need-add(cx, reason) {
   record_set(cx, "needs", append(record_get(cx, "needs"), list(reason)));
   "0";
  }
  def bfk-need(cx, reason) = bfk-need-add(cx, bml-voice-then(bml-refusal-reading("form-lowering", reason), reason));
  def bfk-need-name(cx, reason, name) = bfk-need-add(cx, bml-voice-then(bml-name-reading("form-lowering", reason, name), reason));

  // ── names: a binding's slot key -> the Form name holding its value now ─
  def bfk-vm-get(vm, key) = if nil?(vm) then "" else if str_eq(head(head(vm)), key) then nth(head(vm), 1) else bfk-vm-get(tail(vm), key);
  def bfk-vm-put(vm, key, v) = cons(list(key, v), vm);
  def bfk-vm-or0(vm, key) = if str_eq(bfk-vm-get(vm, key), "") then "0" else bfk-vm-get(vm, key);
  def bfk-vm-has?(vm, key) = not(str_eq(bfk-vm-get(vm, key), ""));
  def bfk-vm-vars(vm, keys) = if nil?(keys) then empty else cons(bfk-vm-or0(vm, head(keys)), bfk-vm-vars(vm, tail(keys)));
  def bfk-vm-keys(vm, seen) = if nil?(vm) then reverse-list(seen) else if fsc-string-list-contains?(seen, head(head(vm))) then bfk-vm-keys(tail(vm), seen) else bfk-vm-keys(tail(vm), cons(head(head(vm)), seen));
  def bfk-top(vm) = bfk-vm-or0(vm, "__top");

  // A statement lowers to (items vm value): the let forms it adds, the names
  // after it, and the Form text of its value.
  def bfk-r(items, vm, val) = list(items, vm, val);
  def bfk-r-items(r) = nth(r, 0);
  def bfk-r-vm(r) = nth(r, 1);
  def bfk-r-val(r) = nth(r, 2);
  def bfk-r-expr(r) = bfk-do(bfk-r-items(r), bfk-r-val(r));
  def bfk-value-stmt(cx, expr, vm) {
   let v = bfk-fresh(cx, "v");
   bfk-r(list(bfk-let(v, expr)), vm, v);
  }

  // The names a construct carries out: every slot its env-after names, and
  // the standing value and the snapshot stack while the body keeps them.
  def bfk-out-keys(env-after, vm) = append(bml-bnml-snapshot-keys(env-after, empty), bfk-extra-keys(vm));
  def bfk-extra-keys(vm) = append(if bfk-vm-has?(vm, "__top") then list("__top") else empty, if bfk-vm-has?(vm, "__marks") then list("__marks") else empty);
  def bfk-tuple(val, vm, keys) = if nil?(keys) then val else bfk-form(cons("list", cons(val, bfk-vm-vars(vm, keys))));
  def bfk-untuple(cx, expr, keys, vm) = if nil?(keys) then bfk-value-stmt(cx, expr, vm) else bfk-untuple-many(cx, expr, keys, vm);
  def bfk-untuple-many(cx, expr, keys, vm) {
   let r = bfk-fresh(cx, "r");
   let val = bfk-fresh(cx, "v");
   let rest = bfk-untuple-keys(cx, r, keys, 1, vm, empty);
   bfk-r(cons(bfk-let(r, expr), cons(bfk-let(val, bfk-f2("nth", r, "0")), bfk-r-items(rest))), bfk-r-vm(rest), val);
  }
  def bfk-untuple-keys(cx, r, keys, i, vm, items) = if nil?(keys) then bfk-r(reverse-list(items), vm, "0") else bfk-untuple-key(cx, r, keys, i, vm, items, bfk-fresh(cx, "v"));
  def bfk-untuple-key(cx, r, keys, i, vm, items, v) = bfk-untuple-keys(cx, r, tail(keys), add(i, 1), bfk-vm-put(vm, head(keys), v), cons(bfk-let(v, bfk-f2("nth", r, bfk-int(i))), items));

  // ── blocks ──────────────────────────────────────────────────────────────
  // grammars/bml.fk's nodes-in-env: a list that bears control runs as a
  // control body, any other list statement by statement
  def bfk-nodes(cx, nodes, env, vm, outk) = if bml-ctl-function-entry?(nodes, env) then bfk-ctl-function(cx, nodes, env, vm, outk) else bfk-plain(cx, nodes, env, vm, outk, "0");

  // a statement that may stop guards the ones after it; a stopped list
  // answers the value it stood on
  def bfk-plain(cx, nodes, env, vm, outk, val) = if nil?(nodes) then bfk-tuple(val, vm, outk) else bfk-plain-then(cx, nodes, env, bfk-stmt(cx, head(nodes), env, vm), outk);
  def bfk-plain-then(cx, nodes, env, r, outk) {
   let rest = bfk-plain(cx, tail(nodes), bml-local-env-after-node(head(nodes), env), bfk-r-vm(r), outk, bfk-r-val(r));
   let stops = if nil?(tail(nodes)) then false else if bml-bnml-may-stop?(head(nodes), env) then bfk-can-fail?(cx, head(nodes), env) else false;
   bfk-do(bfk-r-items(r), if stops then bfk-if(bfk-unfailed(), rest, bfk-tuple(bfk-top(bfk-r-vm(r)), bfk-r-vm(r), outk)) else rest);
  }

  // ── statements ──────────────────────────────────────────────────────────
  def bfk-stmt(cx, node, env, vm) = if bml-ctl-expr-node?(node) then bfk-value-stmt(cx, bfk-reserved(cx, node, env, vm), vm) else if bml-ctl-statement-node?(node) then bfk-lone-control(cx, node, env, vm) else bfk-stmt-core(cx, node, env, vm);
  def bfk-lone-control(cx, node, env, vm) = if bml-ctl-env-active?(env) then bfk-value-stmt(cx, bfk-need(cx, "control/nested"), vm) else bfk-sub(cx, list(node), env, vm, bfk-out-keys(bml-local-env-after-node(node, env), vm));
  def bfk-sub(cx, nodes, env, vm, keys) = bfk-untuple(cx, bfk-nodes(cx, nodes, env, vm, keys), keys, vm);

  def bfk-stmt-core(cx, node, env, vm) {
   let cat = node_category(node);
   if node_eq(cat, BML-AST-CALL) then bfk-call-stmt(cx, node, env, vm) else if node_eq(cat, BML-AST-BLOCK) then bfk-sub(cx, node_children(node), env, vm, bfk-out-keys(bml-local-env-after-node(node, env), vm)) else if node_eq(cat, BML-AST-CONST) then bfk-const-stmt(cx, node, env, vm) else if node_eq(cat, BML-AST-CHOOSE) then bfk-choose-stmt(cx, node, env, vm) else if node_eq(cat, BML-AST-FAIL) then bfk-fail-stmt(cx, env, vm) else if node_eq(cat, BML-AST-SAVE) then bfk-save-stmt(cx, env, vm) else if node_eq(cat, BML-AST-RESTORE) then bfk-restore-stmt(cx, env, vm) else if node_eq(cat, BML-AST-DISCARD) then bfk-discard-stmt(cx, env, vm) else if node_eq(cat, BML-AST-CUT) then bfk-cut-stmt(env, vm) else bfk-value-stmt(cx, bfk-expr-core(cx, node, env, vm), vm);
  }

  def bfk-call-stmt(cx, node, env, vm) = if bfk-class-shaped?(node, env) then bfk-value-stmt(cx, bfk-class-call(cx, node, env, vm), vm) else if bml-bnml-top-node?(node) then bfk-top-stmt(cx, node, env, vm) else if bml-bnml-declare-node?(node) then bfk-store(cx, bml-bnml-new-key(bml-bnml-target-name(node), env), bml-bnml-value(node), env, vm) else if bml-bnml-assign-node?(node) then bfk-store(cx, bml-bnml-assign-key(node, env), bml-bnml-value(node), env, vm) else bfk-value-stmt(cx, bfk-call-expr(cx, node, env, vm), vm);

  // a store answers the value it stored
  def bfk-store(cx, key, value-node, env, vm) {
   let v = bfk-fresh(cx, "v");
   bfk-r(list(bfk-let(v, bfk-expr(cx, value-node, env, vm))), bfk-vm-put(vm, key, v), v);
  }

  // a statement's value becomes the standing value only if it ran to the end
  // a statement that cannot fail stands on its own value: no FAILED to ask,
  // and no second name for the value it already has
  def bfk-top-stmt(cx, node, env, vm) = bfk-top-keep(cx, bfk-stmt(cx, head(bml-call-args(node)), env, vm), bfk-can-fail?(cx, head(bml-call-args(node)), env));
  def bfk-top-keep(cx, r, fails) = if fails then bfk-top-held(cx, r) else bfk-r(bfk-r-items(r), bfk-vm-put(bfk-r-vm(r), "__top", bfk-r-val(r)), bfk-r-val(r));
  def bfk-top-held(cx, r) {
   let t = bfk-fresh(cx, "t");
   bfk-r(append(bfk-r-items(r), list(bfk-let(t, bfk-if(bfk-unfailed(), bfk-r-val(r), bfk-top(bfk-r-vm(r)))))), bfk-vm-put(bfk-r-vm(r), "__top", t), t);
  }

  def bfk-const-stmt(cx, node, env, vm) = if bml-bnml-reads-mutable?(bml-local-const-value(node), env) then bfk-store(cx, bml-bnml-new-key(bml-local-const-name(node), env), bml-local-const-value(node), env, vm) else bfk-value-stmt(cx, bfk-expr(cx, bml-local-const-value(node), env, vm), vm);

  // a choose no branch of which assigns or fails partway runs its first branch that is not a bare fail
  def bfk-choose-stmt(cx, node, env, vm) = if bml-bnml-choose-tracks?(node) then bfk-choose-track(cx, node, env, vm) else bfk-choose-first(cx, node_children(node), env, vm);
  def bfk-choose-first(cx, branches, env, vm) = if nil?(branches) then bfk-value-stmt(cx, "0", vm) else if bml-hati-node-fail?(head(branches)) then bfk-choose-first(cx, tail(branches), env, vm) else bfk-stmt(cx, head(branches), env, vm);

  // ── expressions ─────────────────────────────────────────────────────────
  def bfk-expr(cx, node, env, vm) = if bml-ctl-expr-node?(node) then bfk-reserved(cx, node, env, vm) else if bml-ctl-statement-node?(node) then bfk-r-val(bfk-lone-control(cx, node, env, vm)) else bfk-expr-core(cx, node, env, vm);
  def bfk-exprs(cx, nodes, env, vm) = if nil?(nodes) then empty else cons(bfk-expr(cx, head(nodes), env, vm), bfk-exprs(cx, tail(nodes), env, vm));

  def bfk-expr-core(cx, node, env, vm) {
   let cat = node_category(node);
   if node_eq(cat, BML-AST-INT) then bfk-int(node_value(bml-node-child(node, 0))) else if node_eq(cat, BML-AST-FLOAT) then bfk-f2("mul", bfk-int(bml-hati-float-micros(bml-node-child(node, 0))), bml-hati-float-scale-literal()) else if node_eq(cat, BML-AST-STRING) then bfk-str(node_value(bml-node-child(node, 0))) else if node_eq(cat, BML-AST-CHAR) then bfk-str(node_value(bml-node-child(node, 0))) else if node_eq(cat, BML-AST-ARRAY) then bfk-form(cons("list", bfk-exprs(cx, node_children(node), env, vm))) else if node_eq(cat, BML-AST-ADD) then bfk-f2("add", bfk-expr(cx, bml-node-child(node, 0), env, vm), bfk-expr(cx, bml-node-child(node, 1), env, vm)) else if node_eq(cat, BML-AST-CONST) then bfk-expr(cx, bml-local-const-value(node), env, vm) else if node_eq(cat, BML-AST-NAME) then bfk-name(cx, node, env, vm) else if node_eq(cat, BML-AST-CALL) then bfk-call-expr(cx, node, env, vm) else if node_eq(cat, BML-AST-RETURN) then bfk-expr(cx, bml-node-child(node, 0), env, vm) else if node_eq(cat, BML-AST-BLOCK) then bfk-nodes(cx, node_children(node), env, vm, empty) else if node_eq(cat, BML-AST-METHOD) then bfk-need(cx, "form/nested-method") else if bfk-stmt-only?(cat) then bfk-r-expr(bfk-stmt-core(cx, node, env, vm)) else "0";
  }
  def bfk-stmt-only?(cat) = or(node_eq(cat, BML-AST-CHOOSE), or(node_eq(cat, BML-AST-FAIL), or(node_eq(cat, BML-AST-SAVE), or(node_eq(cat, BML-AST-RESTORE), node_eq(cat, BML-AST-DISCARD)))));

  // the operators BML's own rules name; each answers 1 or 0 where it compares
  def bfk-reserved(cx, node, env, vm) = if bml-ctl-thrown-node?(node) then bfk-cell("t") else if bml-ctl-with-access?(node) then bfk-with-access(cx, node, env, vm) else if bml-ctl-known-op?(node) then bfk-op(bml-ctl-op-rule-of(node), bfk-exprs(cx, bml-call-args(node), env, vm)) else bfk-need(cx, "op/unknown");
  def bfk-op(rule, args) = if nil?(tail(args)) then bfk-op1(rule, head(args)) else bfk-op2(rule, head(args), nth(args, 1));
  def bfk-op1(rule, a) = if str_eq(rule, "op-not") then bfk-if(bfk-f2("eq", a, "0"), "1", "0") else bfk-f2("sub", "0", a);
  def bfk-op2(rule, a, b) = if str_eq(rule, "op-lt") then bfk-f2("lt", a, b) else if str_eq(rule, "op-le") then bfk-f2("le", a, b) else if str_eq(rule, "op-gt") then bfk-f2("gt", a, b) else if str_eq(rule, "op-ge") then bfk-f2("ge", a, b) else if str_eq(rule, "op-eq") then bfk-if(bfk-f2("value_eq", a, b), "1", "0") else if str_eq(rule, "op-ne") then bfk-if(bfk-f2("value_eq", a, b), "0", "1") else if str_eq(rule, "op-and") then bfk-if(bfk-f2("eq", a, "0"), "0", bfk-if(bfk-f2("eq", b, "0"), "0", "1")) else if str_eq(rule, "op-or") then bfk-if(bfk-f2("eq", a, "0"), bfk-if(bfk-f2("eq", b, "0"), "0", "1"), "1") else if str_eq(rule, "op-sub") then bfk-f2("sub", a, b) else bfk-f2("mul", a, b);

  def bfk-name(cx, node, env, vm) = if bml-hati-receiver-name?(bml-local-name(node), env) then bfk-class-name(cx, node, env, vm) else bfk-name-binding(cx, node, env, vm, bml-local-lookup(env, bml-local-name(node)));
  def bfk-name-binding(cx, node, env, vm, binding) = if bml-bnml-binding?(binding) then bfk-vm-or0(vm, bml-local-binding-key(binding)) else if nil?(binding) then bfk-need-name(cx, "name/unbound", bml-local-name(node)) else if bml-hati-arg-node?(bml-local-binding-value(binding)) then bfk-vm-or0(vm, "@a") else if bml-hati-method-ref?(bml-local-binding-value(binding)) then bfk-need(cx, "name/method") else bfk-expr(cx, bml-local-binding-value(binding), bml-local-binding-env(binding), vm);

  def bfk-call-expr(cx, node, env, vm) = if bfk-class-shaped?(node, env) then bfk-class-call(cx, node, env, vm) else if bml-bnml-top-node?(node) then bfk-expr(cx, head(bml-call-args(node)), env, vm) else if or(bml-bnml-declare-node?(node), bml-bnml-assign-node?(node)) then bfk-need(cx, "form/store-in-expression") else if bml-index-node?(node) then bfk-f2("nth", bfk-expr(cx, bml-index-target(node), env, vm), bfk-expr(cx, bml-index-at(node), env, vm)) else if bml-list-set-node?(node) then bfk-f3("bfk-list-set", bfk-expr(cx, bml-index-target(node), env, vm), bfk-expr(cx, bml-index-at(node), env, vm), bfk-expr(cx, bml-list-set-value(node), env, vm)) else if bml-hati-arg-node?(node) then bfk-vm-or0(vm, "@a") else if bml-hati-arg-at-node?(node) then bfk-vm-or0(vm, str_concat("@a", int_to_str(bml-hati-arg-at-index(node)))) else bfk-free-call(cx, node, env, vm, bml-local-lookup(env, bml-call-name(node)));

  def bfk-free-call(cx, node, env, vm, binding) = if nil?(binding) then bfk-need-name(cx, bml-scope-unbound-call-reason(env, bml-call-name(node)), bml-call-name(node)) else if bml-hati-method-ref?(bml-local-binding-value(binding)) then bfk-chosen-call(cx, node, env, vm, bml-hati-free-call-choice(env, bml-call-name(node), bml-call-args(node))) else bfk-need(cx, "call/not-method");
  def bfk-chosen-call(cx, node, env, vm, choice) = if bml-hati-choice-ok?(choice) then bfk-ref-call(cx, node, env, vm, bml-local-binding-value(bml-hati-choice-value(choice))) else bfk-need(cx, bml-hati-choice-value(choice));
  def bfk-ref-call(cx, node, env, vm, ref) = bfk-form(cons(bfk-fn-name(bml-hati-method-ref-index(ref)), bfk-call-args(cx, node, env, vm, bml-hati-method-ref-arity(ref))));
  def bfk-call-args(cx, node, env, vm, arity) = if eq(arity, 0) then empty else if eq(arity, 1) then list(bfk-expr(cx, head(bml-call-args(node)), env, vm)) else bfk-exprs(cx, bml-call-args(node), env, vm);
  def bfk-fn-name(index) = str_concat("m", int_to_str(index));

  // ── control ─────────────────────────────────────────────────────────────
  // grammars/bml.fk's control lowering, over value names: a transfer sets
  // the mode, the statements after one that may change it run while it is
  // 0, a loop is one tail-recursive defn over the names in scope, and the
  // epilogue turns RETURN into the function's value and hands THROW outward.
  def bfk-mode-in(modes) = if nil?(modes) then "0" else bfk-if(bfk-mode-is(head(modes)), "1", bfk-mode-in(tail(modes)));
  def bfk-mode-zero() = bfk-f2("eq", bfk-cell("m"), "0");

  // a body that keeps the value it stands on writes it at each plain
  // statement, and a failure that stopped the body answers it
  def bfk-ctl-function(cx, nodes, env, vm, outk) {
   let standing = bml-bnml-keeps-standing?(nodes, env);
   let keys = if standing then bfk-with-key(outk, "__top") else outk;
   let r = bfk-untuple(cx, bfk-ctl-stmts(cx, nodes, bml-ctl-env-standing(bml-ctl-env-active(env), standing), vm, keys, bml-ctl-ctx(empty), "0"), keys, vm);
   let e = bfk-fresh(cx, "v");
   bfk-do(append(bfk-r-items(r), list(bfk-let(e, bfk-epilogue(standing, bfk-r-vm(r))))), bfk-tuple(e, bfk-r-vm(r), outk));
  }
  def bfk-with-key(keys, key) = if fsc-string-list-contains?(keys, key) then keys else append(keys, list(key));
  def bfk-epilogue(standing, vm) = if standing then bfk-if(bfk-unfailed(), bfk-epi(), bfk-do(list(bfk-set-mode(0)), bfk-top(vm))) else bfk-epi();
  def bfk-epi() = bfk-if(bfk-mode-is(bml-ctl-return-mode(0)), bfk-do(list(bfk-set-mode(0)), bfk-cell("v")), bfk-if(bfk-mode-is(bml-ctl-throw-mode(0)), bfk-cell("t"), "0"));

  // a statement that cannot change the mode needs no guard after it: it holds
  // no transfer, no fail, and no call but to a quiet method
  def bfk-mode-quiet?(cx, node, env) = if bml-bnml-fails-inside?(node) then false else if bfk-holds-transfer?(node) then false else bfk-quiet-calls?(cx, node, env);
  // a statement that can set FAILED: it holds a fail or a call a failure can come back through
  def bfk-can-fail?(cx, node, env) = if bml-bnml-fails-inside?(node) then true else not(bfk-quiet-calls?(cx, node, env));

  // ── a callee's reach ────────────────────────────────────────────────────
  // A method is quiet when it can never throw or fail: it holds no throw and
  // no fail, and every call it makes is a free call whose every candidate is
  // quiet. A return never leaves its callee; the callee's epilogue takes it.
  // A class call is not read here yet, so it counts as one that can.
  def bfk-fn-rows(methods, env, index) = if nil?(methods) then empty else cons(list(index, head(methods), env), bfk-fn-rows(tail(methods), env, add(index, 1)));
  def bfk-linked-rows(link, units, symbols, index) = if nil?(units) then empty else append(bfk-fn-rows(bml-scope-unit-methods(head(units)), bml-scope-unit-env-with(link, head(units), symbols, "hati"), index), bfk-linked-rows(link, tail(units), symbols, add(index, len(bml-scope-unit-methods(head(units))))));
  def bfk-fn-row(rows, index) = if nil?(rows) then empty else if eq(head(head(rows)), index) then head(rows) else bfk-fn-row(tail(rows), index);
  def bfk-quiet-fn?(cx, index) = bfk-quiet-memo(cx, index, record_get(cx, str_concat("q", int_to_str(index))));
  def bfk-quiet-memo(cx, index, held) = if eq(held, 1) then true else if eq(held, 3) then true else if eq(held, 2) then false else bfk-quiet-row(cx, index, bfk-fn-row(record_get(cx, "fns"), index));
  def bfk-quiet-row(cx, index, row) = if nil?(row) then false else bfk-quiet-analyze(cx, index, row);
  def bfk-quiet-analyze(cx, index, row) {
   record_set(cx, str_concat("q", int_to_str(index)), 3);
   let quiet = bfk-quiet-body?(cx, bml-method-node-body(nth(row, 1)), bml-hati-method-param-env(nth(row, 1), nth(row, 2)));
   record_set(cx, str_concat("q", int_to_str(index)), if quiet then 1 else 2);
   quiet;
  }
  def bfk-quiet-body?(cx, node, env) = if bml-bnml-fails-inside?(node) then false else if bfk-holds-throw?(node) then false else bfk-quiet-calls?(cx, node, env);
  def bfk-holds-throw?(node) = if eq(len(node_children(node)), 0) then false else if node_eq(node_category(node), BML-AST-THROW) then true else if node_eq(node_category(node), BML-AST-METHOD) then false else bfk-any-throw?(node_children(node));
  def bfk-any-throw?(nodes) = if nil?(nodes) then false else if bfk-holds-throw?(head(nodes)) then true else bfk-any-throw?(tail(nodes));
  def bfk-quiet-calls?(cx, node, env) = if eq(len(node_children(node)), 0) then true else if bml-bnml-user-call?(node) then bfk-quiet-call-then?(cx, node, env, bfk-quiet-call?(cx, node, env)) else if node_eq(node_category(node), BML-AST-METHOD) then true else bfk-all-quiet-calls?(cx, node_children(node), env);
  def bfk-quiet-call-then?(cx, node, env, quiet) = if quiet then bfk-all-quiet-calls?(cx, node_children(node), env) else false;
  def bfk-all-quiet-calls?(cx, nodes, env) = if nil?(nodes) then true else if bfk-quiet-calls?(cx, head(nodes), env) then bfk-all-quiet-calls?(cx, tail(nodes), env) else false;
  def bfk-quiet-call?(cx, node, env) = if bml-hati-class-call?(node) then false else if bfk-class-shaped?(node, env) then false else bfk-quiet-candidates?(cx, append(bfk-callee-indices(env, bml-call-name(node)), bfk-callee-indices(env, bml-scope-resolve-name(env, bml-call-name(node)))));
  def bfk-quiet-candidates?(cx, indices) = if nil?(indices) then false else bfk-all-quiet-fns?(cx, indices);
  def bfk-all-quiet-fns?(cx, indices) = if nil?(indices) then true else if bfk-quiet-fn?(cx, head(indices)) then bfk-all-quiet-fns?(cx, tail(indices)) else false;
  def bfk-callee-indices(env, name) = if nil?(env) then empty else if bfk-method-named?(head(env), name) then cons(bml-hati-method-ref-index(bml-local-binding-value(head(env))), bfk-callee-indices(tail(env), name)) else bfk-callee-indices(tail(env), name);
  def bfk-method-named?(binding, name) = if str_eq(bml-local-binding-name(binding), name) then bml-hati-method-ref?(bml-local-binding-value(binding)) else false;
  def bfk-holds-transfer?(node) = if eq(len(node_children(node)), 0) then false else if bml-ctl-effect-node?(node) then true else if node_eq(node_category(node), BML-AST-METHOD) then false else bfk-any-transfer?(node_children(node));
  def bfk-any-transfer?(nodes) = if nil?(nodes) then false else if bfk-holds-transfer?(head(nodes)) then true else bfk-any-transfer?(tail(nodes));

  // statements of a control body; a guarded-out rest answers 0
  def bfk-ctl-stmts(cx, nodes, env, vm, outk, ctx, val) = if nil?(nodes) then bfk-tuple(val, vm, outk) else bfk-ctl-then(cx, nodes, env, outk, ctx, bfk-ctl-stmt(cx, head(nodes), env, vm, ctx));
  def bfk-ctl-then(cx, nodes, env, outk, ctx, r) {
   let rest = bfk-ctl-stmts(cx, tail(nodes), bml-ctl-env-after(head(nodes), env), bfk-r-vm(r), outk, ctx, bfk-r-val(r));
   let stop = bfk-tuple("0", bfk-r-vm(r), outk);
   let stops = if bml-bnml-may-stop?(head(nodes), env) then bfk-can-fail?(cx, head(nodes), env) else false;
   let held = if stops then bfk-if(bfk-unfailed(), rest, stop) else rest;
   bfk-do(bfk-r-items(r), if nil?(tail(nodes)) then rest else if and(bfk-mode-quiet?(cx, head(nodes), env), not(stops)) then rest else bfk-if(bfk-mode-ok(), held, stop));
  }
  def bfk-ctl-block(cx, node, env, vm, outk, ctx) = bfk-ctl-stmts(cx, if node_eq(node_category(node), BML-AST-BLOCK) then node_children(node) else list(node), env, vm, outk, ctx, "0");

  // a parameter the statement assigns becomes a frame local just before it
  def bfk-ctl-stmt(cx, node, env, vm, ctx) = bfk-ctl-promote(cx, bml-ctl-promoted(node, env), node, env, vm, ctx, empty);
  def bfk-ctl-promote(cx, promos, node, env, vm, ctx, items) = if nil?(promos) then bfk-r-prefix(items, bfk-ctl-stmt-in(cx, node, env, vm, ctx)) else bfk-ctl-promote-one(cx, promos, node, env, ctx, items, bfk-ctl-stmt-in(cx, head(promos), env, vm, ctx));
  def bfk-ctl-promote-one(cx, promos, node, env, ctx, items, r) = bfk-ctl-promote(cx, tail(promos), node, bml-ctl-env-after(head(promos), env), bfk-r-vm(r), ctx, append(items, bfk-r-items(r)));
  def bfk-r-prefix(items, r) = bfk-r(append(items, bfk-r-items(r)), bfk-r-vm(r), bfk-r-val(r));

  def bfk-ctl-stmt-in(cx, node, env, vm, ctx) = if nil?(node_children(node)) then bfk-ctl-standing(cx, node, env, vm) else bfk-ctl-shape(cx, node, env, vm, ctx, bfk-edge(node, env));
  def bfk-edge(node, env) = if bml-ctl-statement-node?(node) then bml-bnml-edge-check("control", node, env) else 0;
  def bfk-ctl-shape(cx, node, env, vm, ctx, _heard) {
   let cat = node_category(node);
   if node_eq(cat, BML-AST-BLOCK) then bfk-ctl-compound(cx, node, env, vm, ctx) else if node_eq(cat, BML-AST-IF) then bfk-ctl-if(cx, node, env, vm, ctx) else if bml-ctl-while-node?(node) then bfk-ctl-loop-pick(cx, node, bml-ctl-while-parts(node), env, vm, ctx) else if node_eq(cat, BML-AST-FOR) then bfk-ctl-loop-pick(cx, node, bml-ctl-for-parts(node), env, vm, ctx) else if bml-ctl-switch-node?(node) then bfk-ctl-switch(cx, node, env, vm, ctx) else if bml-ctl-effect-node?(node) then bfk-ctl-effect(cx, bml-ctl-node-effect(node), env, vm, ctx) else if node_eq(cat, BML-AST-TRY) then bfk-ctl-try(cx, node, env, vm, ctx) else if node_eq(cat, BML-AST-WITH) then bfk-ctl-compound(cx, node, env, vm, ctx) else if node_eq(cat, BML-AST-METHOD) then bfk-value-stmt(cx, bfk-need(cx, "control/nested-method"), vm) else bfk-ctl-standing(cx, node, env, vm);
  }
  def bfk-ctl-standing(cx, node, env, vm) = bfk-stmt(cx, if bml-ctl-standing?(env) then bml-bnml-top-rewrite(node) else node, env, vm);

  // a block (or a with) runs its statements; what it assigns rides out
  def bfk-ctl-compound(cx, node, env, vm, ctx) {
   let outk = bfk-out-keys(bml-ctl-env-after(node, env), vm);
   bfk-untuple(cx, bfk-ctl-stmts(cx, node_children(node), env, vm, outk, ctx, "0"), outk, vm);
  }

  // BML's truth: a condition holds when its value is not 0
  def bfk-cond(cx, node, env, vm) = if bfk-compare?(node) then bfk-reserved(cx, node, env, vm) else bfk-f2("ne", bfk-expr(cx, node, env, vm), "0");
  def bfk-compare?(node) = if bml-ctl-op-node?(node) then fsc-string-list-contains?(list("op-lt", "op-le", "op-gt", "op-ge"), bml-ctl-op-rule-of(node)) else false;

  def bfk-ctl-if(cx, node, env, vm, ctx) {
   let outk = bfk-out-keys(bml-ctl-env-after(node, env), vm);
   let test = bfk-cond(cx, bml-node-child(node, 0), env, vm);
   let yes = bfk-ctl-block(cx, bml-node-child(node, 1), env, vm, outk, ctx);
   let no = bfk-ctl-block(cx, bml-ctl-child-or-block(node, 2), env, vm, outk, ctx);
   let hold = not(bfk-mode-quiet?(cx, bml-node-child(node, 0), env));
   bfk-untuple(cx, bfk-if(test, bfk-ctl-guard(hold, yes, vm, outk), bfk-ctl-guard(hold, no, vm, outk)), outk, vm);
  }
  def bfk-ctl-guard(hold, text, vm, outk) = if hold then bfk-if(bfk-mode-ok(), text, bfk-tuple("0", vm, outk)) else text;

  // init; one defn over every name in scope: while the test holds, the body,
  // then the step on the modes a loop takes its next pass after; exit
  // consumes this target's own break
  def bfk-local-keys(keys) = if nil?(keys) then empty else if eq(str_find(head(keys), "@", 0), 0) then bfk-local-keys(tail(keys)) else cons(head(keys), bfk-local-keys(tail(keys)));
  def bfk-fresh-names(cx, keys) = if nil?(keys) then empty else cons(bfk-fresh(cx, "p"), bfk-fresh-names(cx, tail(keys)));
  def bfk-vm-bind(vm, keys, names) = if nil?(keys) then vm else bfk-vm-bind(bfk-vm-put(vm, head(keys), head(names)), tail(keys), tail(names));
  def bfk-ctl-loop(cx, node, parts, env, vm, ctx) {
   let id = bml-ctl-next-id(ctx);
   let init = bfk-ctl-stmt(cx, bml-ctl-loop-init(parts), env, vm, ctx);
   let inner-env = bml-ctl-env-after(bml-ctl-loop-init(parts), env);
   let inner-ctx = bml-ctl-ctx-push(ctx, "loop", bml-ctl-loop-label(parts), id);
   let keys = bfk-vm-keys(bfk-r-vm(init), empty);
   let names = bfk-fresh-names(cx, keys);
   let w = bfk-fresh(cx, "w");
   let vm-in = bfk-vm-bind(bfk-r-vm(init), keys, names);
   let stops = if bml-bnml-may-stop?(bml-ctl-loop-body(parts), env) then bfk-can-fail?(cx, bml-ctl-loop-body(parts), env) else false;
   let test = bfk-cond(cx, bml-ctl-loop-test(parts), inner-env, vm-in);
   let body = bfk-untuple(cx, bfk-ctl-block(cx, bml-ctl-loop-body(parts), inner-env, vm-in, bfk-local-keys(keys), inner-ctx), bfk-local-keys(keys), vm-in);
   let step = bfk-ctl-stmt(cx, bml-ctl-loop-update(parts), inner-env, bfk-r-vm(body), inner-ctx);
   let exit = bfk-form(cons("list", cons("0", names)));
   let again = bfk-form(cons(w, bfk-vm-vars(bfk-r-vm(step), keys)));
   let cond = bfk-unfailed-guard(stops, bfk-if(bfk-mode-zero(), bfk-if(test, bfk-mode-zero(), "0"), "0"));
   let next = bfk-unfailed-guard(stops, bfk-mode-in(bml-ctl-running-modes(id)));
   let pass = bfk-do(bfk-r-items(body), bfk-if(next, bfk-do(cons(bfk-set-mode(0), bfk-r-items(step)), again), bfk-form(cons("list", cons("0", bfk-vm-vars(bfk-r-vm(body), keys))))));
   bfk-add-def(cx, bfk-form(list("defn", w, bfk-form(names), bfk-if(cond, pass, exit))));
   let after = bfk-untuple(cx, bfk-form(cons(w, bfk-vm-vars(bfk-r-vm(init), keys))), keys, bfk-r-vm(init));
   bfk-r(append(bfk-r-items(init), append(bfk-r-items(after), list(bfk-ctl-exit(id)))), bfk-r-vm(after), "0");
  }
  def bfk-unfailed-guard(stops, text) = if stops then bfk-if(bfk-unfailed(), text, "0") else text;

  // ── loops the loop lane can take ────────────────────────────────────────
  // A loop that holds no call that can carry a transfer back, no fail, no
  // return or throw, and no statement but lets, ifs, blocks and its own break
  // and continue needs no mode: break is its exit, the end of a pass and
  // continue are its self tail call. Its defn takes only the names the loop
  // reads or assigns and answers the one name it carries out: the chain of
  // lets and compares ending in a self tail call that fkwu's loop lane
  // crystallizes. Any other loop keeps the mode.
  def bfk-ctl-loop-pick(cx, node, parts, env, vm, ctx) = if bfk-pure-loop?(cx, node, parts, env) then bfk-pl-loop(cx, node, parts, env, vm, ctx) else bfk-ctl-loop(cx, node, parts, env, vm, ctx);
  def bfk-pure-loop?(cx, node, parts, env) = if not(bfk-quiet-calls?(cx, node, env)) then false else if bml-bnml-fails-inside?(node) then false else if gt(bfk-if-count(node), 4) then false else if bfk-holds-control?(bml-ctl-loop-test(parts)) then false else bfk-pl-all-ok?(append(bfk-stmts-of(bml-ctl-loop-body(parts)), bfk-stmts-of(bml-ctl-loop-update(parts))), list(bml-ctl-loop-label(parts)));
  // an if that becomes selects copies nothing, so only the others count
  def bfk-if-count(node) = add(if node_eq(node_category(node), BML-AST-IF) then if gt(len(node_children(node)), 0) then if bfk-plain-branches?(node) then 0 else 1 else 0 else 0, bfk-if-count-list(node_children(node)));
  def bfk-plain-branches?(node) = bfk-select-if?(node, empty);

  // ── an if that becomes selects ──────────────────────────────────────────
  // An if in a mode-free loop whose branches only assign plain values (no
  // call, no index, no field) keeps the pass one chain: each branch is read
  // as the values it leaves on each name, and every name the branches leave
  // differently takes one select, (if test then-value else-value). Only the
  // taken side of each select runs.
  def bfk-select-if?(node, env) = if bfk-holds-any-call?(bml-node-child(node, 0)) then false else if bfk-assigns-only?(bfk-stmts-of(bml-node-child(node, 1)), env) then bfk-assigns-only?(bfk-stmts-of(bml-ctl-child-or-block(node, 2)), env) else false;
  def bfk-assigns-only?(nodes, env) = if nil?(nodes) then true else if bfk-assign-only?(head(nodes), env) then bfk-assigns-only?(tail(nodes), env) else false;
  def bfk-assign-only?(node, env) = if node_eq(node_category(node), BML-AST-BLOCK) then bfk-assigns-only?(node_children(node), env) else if or(bml-bnml-declare-node?(node), bml-bnml-assign-node?(node)) then bfk-plain-store?(node, env) else false;
  def bfk-plain-store?(node, env) = if bfk-holds-any-call?(bml-bnml-value(node)) then false else if nil?(env) then true else if bml-hati-field-assign?(node, env) then false else not(bml-hati-dotted-assign?(node, env));
  def bfk-holds-any-call?(node) = if eq(len(node_children(node)), 0) then false else if bml-bnml-user-call?(node) then true else if bml-hati-class-call?(node) then true else if bml-index-node?(node) then true else if bml-list-set-node?(node) then true else if bfk-holds-control?(node) then true else bfk-any-any-call?(node_children(node));
  def bfk-any-any-call?(nodes) = if nil?(nodes) then false else if bfk-holds-any-call?(head(nodes)) then true else bfk-any-any-call?(tail(nodes));
  def bfk-sel-vm(cx, nodes, env, vm) = if nil?(nodes) then vm else bfk-sel-vm(cx, tail(nodes), bml-ctl-env-after(head(nodes), env), bfk-sel-one(cx, head(nodes), env, vm));
  def bfk-sel-one(cx, node, env, vm) = if node_eq(node_category(node), BML-AST-BLOCK) then bfk-sel-vm(cx, node_children(node), env, vm) else bfk-sel-top(env, bfk-vm-put(vm, bfk-sel-key(node, env), bfk-expr(cx, bml-bnml-value(node), env, vm)), bfk-sel-key(node, env));
  def bfk-sel-top(env, vm, key) = if bml-ctl-standing?(env) then bfk-vm-put(vm, "__top", bfk-vm-or0(vm, key)) else vm;
  def bfk-sel-key(node, env) = if bml-bnml-declare-node?(node) then bml-bnml-new-key(bml-bnml-target-name(node), env) else bml-bnml-assign-key(node, env);
  def bfk-pl-select(cx, node, rest, env, vm, li, kont) {
   let yes = bfk-sel-vm(cx, bfk-stmts-of(bml-node-child(node, 1)), env, vm);
   let no = bfk-sel-vm(cx, bfk-stmts-of(bml-ctl-child-or-block(node, 2)), env, vm);
   let swapped = bfk-int-eq?(bml-node-child(node, 0), env, "op-ne");
   let test = bfk-sel-test(cx, bml-node-child(node, 0), env, vm);
   let r = bfk-sel-binds(cx, bfk-out-keys(bml-ctl-env-after(node, env), vm), test, if swapped then no else yes, if swapped then yes else no, vm, empty);
   bfk-do(bfk-r-items(r), bfk-pl-seq(cx, rest, bml-ctl-env-after(node, env), bfk-r-vm(r), li, kont));
  }
  def bfk-sel-test(cx, test, env, vm) = if bfk-int-eq?(test, env, "op-ne") then bfk-eq-text(cx, test, env, vm) else if bfk-int-eq?(test, env, "op-eq") then bfk-eq-text(cx, test, env, vm) else bfk-cond(cx, test, env, vm);
  def bfk-sel-binds(cx, keys, test, yes, no, vm, items) = if nil?(keys) then bfk-r(reverse-list(items), vm, "0") else if str_eq(bfk-vm-or0(yes, head(keys)), bfk-vm-or0(no, head(keys))) then bfk-sel-binds(cx, tail(keys), test, yes, no, bfk-vm-put(vm, head(keys), bfk-vm-or0(yes, head(keys))), items) else bfk-sel-bind(cx, keys, test, yes, no, vm, items, bfk-fresh(cx, "v"));
  def bfk-sel-bind(cx, keys, test, yes, no, vm, items, v) = bfk-sel-binds(cx, tail(keys), test, yes, no, bfk-vm-put(vm, head(keys), v), cons(bfk-let(v, bfk-if(test, bfk-vm-or0(yes, head(keys)), bfk-vm-or0(no, head(keys)))), items));
  def bfk-if-count-list(nodes) = if nil?(nodes) then 0 else add(bfk-if-count(head(nodes)), bfk-if-count-list(tail(nodes)));
  def bfk-pl-all-ok?(nodes, label) = if nil?(nodes) then true else if bfk-pl-ok?(head(nodes), label) then bfk-pl-all-ok?(tail(nodes), label) else false;
  def bfk-pl-ok?(node, label) = if nil?(node_children(node)) then true else bfk-pl-ok-shape?(node, node_category(node), label);
  def bfk-pl-ok-shape?(node, cat, label) = if node_eq(cat, BML-AST-BLOCK) then bfk-pl-all-ok?(node_children(node), label) else if node_eq(cat, BML-AST-IF) then bfk-pl-if-ok?(node, label) else if or(node_eq(cat, BML-AST-BREAK), node_eq(cat, BML-AST-CONTINUE)) then bfk-own-label?(bml-local-name(node), label) else if bml-ctl-while-node?(node) then bfk-nested-ok?(bml-ctl-while-parts(node), label) else if node_eq(cat, BML-AST-FOR) then bfk-nested-ok?(bml-ctl-for-parts(node), label) else if or(node_eq(cat, BML-AST-RETURN), node_eq(cat, BML-AST-THROW)) then not(bfk-holds-control?(bml-node-child(node, 0))) else if node_eq(cat, BML-AST-WHILE) then false else if node_eq(cat, BML-AST-METHOD) then false else not(bfk-holds-control?(node));
  def bfk-pl-if-ok?(node, label) = if bfk-holds-control?(bml-node-child(node, 0)) then false else if bfk-pl-all-ok?(bfk-stmts-of(bml-node-child(node, 1)), label) then bfk-pl-all-ok?(bfk-stmts-of(bml-ctl-child-or-block(node, 2)), label) else false;
  // labels: the mode-free loops a break or continue here may name, innermost first
  def bfk-own-label?(name, labels) = if str_eq(name, "") then true else fsc-string-list-contains?(labels, name);
  // a loop inside a mode-free loop stays mode-free when it is one itself and
  // its breaks and continues reach only itself or a mode-free loop around it
  def bfk-nested-ok?(parts, labels) = if bfk-holds-control?(bml-ctl-loop-test(parts)) then false else if bfk-pl-ok?(bml-ctl-loop-init(parts), cons(bml-ctl-loop-label(parts), labels)) then bfk-pl-all-ok?(append(bfk-stmts-of(bml-ctl-loop-body(parts)), bfk-stmts-of(bml-ctl-loop-update(parts))), cons(bml-ctl-loop-label(parts), labels)) else false;
  def bfk-holds-control?(node) = if nil?(node_children(node)) then false else if bml-ctl-statement-node?(node) then true else if bml-ctl-effect-node?(node) then true else if bfk-stmt-only?(node_category(node)) then true else bfk-any-control?(node_children(node));
  def bfk-any-control?(nodes) = if nil?(nodes) then false else if bfk-holds-control?(head(nodes)) then true else bfk-any-control?(tail(nodes));

  // the names a loop reads or assigns, as the keys its body reaches them by;
  // a const is read through the names its value reads
  def bfk-names-in(node, acc) = if bml-hati-class-call?(node) then bfk-names-in-list(node_children(node), cons("this", acc)) else if bml-name-node?(node) then cons(bfk-name-head(bml-local-name(node)), cons(bml-local-name(node), acc)) else if or(bml-bnml-declare-node?(node), bml-bnml-assign-node?(node)) then bfk-names-in-list(node_children(node), cons(bfk-name-head(bml-bnml-target-name(node)), cons(bml-bnml-target-name(node), acc))) else bfk-names-in-list(node_children(node), acc);
  def bfk-names-in-list(nodes, acc) = if nil?(nodes) then acc else bfk-names-in-list(tail(nodes), bfk-names-in(head(nodes), acc));
  def bfk-name-head(name) = if lt(str_find(name, ".", 0), 0) then name else substring(name, 0, str_find(name, ".", 0));
  def bfk-loop-keys(names, env, vm, acc, depth) = if nil?(names) then acc else bfk-loop-keys(tail(names), env, vm, bfk-key-binding(bml-local-lookup(env, head(names)), vm, acc, depth), depth);
  def bfk-key-binding(binding, vm, acc, depth) = if nil?(binding) then acc else if bml-bnml-binding?(binding) then bfk-key-add(bml-local-binding-key(binding), vm, acc) else bfk-key-value(bml-local-binding-value(binding), binding, vm, acc, depth);
  def bfk-key-value(value, binding, vm, acc, depth) = if bml-hati-arg-node?(value) then bfk-key-add("@a", vm, acc) else if bml-hati-arg-at-node?(value) then bfk-key-add(str_concat("@a", int_to_str(bml-hati-arg-at-index(value))), vm, acc) else if bml-hati-class-call?(value) then bfk-key-add("@pack", vm, acc) else if bml-hati-method-ref?(value) then acc else if gt(depth, 8) then acc else bfk-loop-keys(bfk-names-in(value, empty), bml-local-binding-env(binding), vm, acc, add(depth, 1));
  def bfk-key-add(key, vm, acc) = if fsc-string-list-contains?(acc, key) then acc else if bfk-vm-has?(vm, key) then append(acc, list(key)) else acc;
  def bfk-carried(names, env, outk, acc) = if nil?(names) then acc else bfk-carried(tail(names), env, outk, bfk-carried-one(bml-local-lookup(env, head(names)), outk, acc));
  def bfk-carried-one(binding, outk, acc) = if not(bml-bnml-binding?(binding)) then acc else if not(fsc-string-list-contains?(outk, bml-local-binding-key(binding))) then acc else if fsc-string-list-contains?(acc, bml-local-binding-key(binding)) then acc else append(acc, list(bml-local-binding-key(binding)));

  // li: (defn-name keys carried update-statements inner-env crossing)
  // A loop that holds a return or a throw carries it out as a value: every
  // exit answers (status value carried...), status 0 for a plain exit and the
  // transfer's own mode for the rest, and the mode is set once after the
  // loop, never read on a pass.
  // A labeled break or continue that names a mode-free loop around this one
  // leaves it with that loop's own code, a negative status no mode takes:
  // break -(2 id + 1), continue -(2 id + 2). The named loop consumes its code.
  def bfk-next-id(cx) = bfk-next-id-at(cx, add(record_get(cx, "n"), 1));
  def bfk-next-id-at(cx, n) {
   record_set(cx, "n", n);
   n;
  }
  def bfk-break-code(id) = sub(0, add(mul(2, id), 1));
  def bfk-continue-code(id) = sub(0, add(mul(2, id), 2));
  def bfk-jump-code(kind, id) = if str_eq(kind, "break") then bfk-break-code(id) else bfk-continue-code(id);
  def bfk-outer-id(stack, name) = if nil?(stack) then -1 else if str_eq(head(head(stack)), name) then nth(head(stack), 1) else bfk-outer-id(tail(stack), name);
  def bfk-own-target?(li, name) = if str_eq(name, "") then true else str_eq(name, nth(li, 7));
  def bfk-pl-jump(cx, li, vm, name, kind) = if bfk-own-target?(li, name) then bfk-pl-own-jump(cx, li, vm, kind) else bfk-pl-cross-exit(li, vm, bfk-int(bfk-jump-code(kind, bfk-outer-id(nth(li, 8), name))), "0");
  def bfk-pl-own-jump(cx, li, vm, kind) = if str_eq(kind, "break") then bfk-pl-exit(li, vm) else bfk-pl-next(cx, li, vm);
  // a loop crosses its edge when it holds a return, a throw, or a labeled
  // break or continue naming a loop outside it
  def bfk-cross-label?(node, own) = if eq(len(node_children(node)), 0) then false else if or(node_eq(node_category(node), BML-AST-BREAK), node_eq(node_category(node), BML-AST-CONTINUE)) then not(bfk-own-label?(bml-local-name(node), own)) else if bml-ctl-while-node?(node) then bfk-any-cross-label?(node_children(node), cons(bml-ctl-loop-label(bml-ctl-while-parts(node)), own)) else if node_eq(node_category(node), BML-AST-FOR) then bfk-any-cross-label?(node_children(node), cons(bml-ctl-loop-label(bml-ctl-for-parts(node)), own)) else if node_eq(node_category(node), BML-AST-METHOD) then false else bfk-any-cross-label?(node_children(node), own);
  def bfk-any-cross-label?(nodes, own) = if nil?(nodes) then false else if bfk-cross-label?(head(nodes), own) then true else bfk-any-cross-label?(tail(nodes), own);

  // (init call carried crossing)
  def bfk-pl-build(cx, node, parts, env, vm, ctx, outer) {
   let init = bfk-ctl-stmt(cx, bml-ctl-loop-init(parts), env, vm, ctx);
   let inner-env = bml-ctl-env-after(bml-ctl-loop-init(parts), env);
   let keys = bfk-with-top(env, bfk-r-vm(init), bfk-loop-keys(bfk-names-in(node, empty), inner-env, bfk-r-vm(init), empty, 0));
   let carried = bfk-with-top(env, bfk-r-vm(init), bfk-carried(bml-ctl-assigned-names(node), inner-env, bfk-out-keys(bml-ctl-env-after(node, env), bfk-r-vm(init)), empty));
   let names = bfk-fresh-names(cx, keys);
   let w = bfk-fresh(cx, "w");
   let vm-in = bfk-vm-bind(bfk-r-vm(init), keys, names);
   let crossing = if bfk-crosses?(node) then true else bfk-cross-label?(node, list(bml-ctl-loop-label(parts)));
   let li = list(w, keys, carried, bfk-stmts-of(bml-ctl-loop-update(parts)), inner-env, crossing, bfk-next-id(cx), bml-ctl-loop-label(parts), outer);
   let pass = bfk-pl-seq(cx, bfk-stmts-of(bml-ctl-loop-body(parts)), inner-env, vm-in, li, list("next"));
   bfk-add-def(cx, bfk-form(list("defn", w, bfk-form(names), bfk-pl-test(cx, bml-ctl-loop-test(parts), inner-env, vm-in, pass, bfk-pl-exit(li, vm-in)))));
   list(init, bfk-form(cons(w, bfk-vm-vars(bfk-r-vm(init), keys))), carried, crossing);
  }
  def bfk-pl-loop(cx, node, parts, env, vm, ctx) = bfk-pl-finish(cx, bfk-pl-build(cx, node, parts, env, vm, ctx, empty));
  def bfk-pl-finish(cx, b) = if nth(b, 3) then bfk-pl-cross-finish(b, bfk-pl-status(cx, nth(b, 1), nth(b, 2), bfk-r-vm(nth(b, 0)))) else bfk-pl-plain-finish(nth(b, 0), bfk-pl-after(cx, nth(b, 1), nth(b, 2), bfk-r-vm(nth(b, 0))));
  def bfk-pl-plain-finish(init, after) = bfk-r(append(bfk-r-items(init), bfk-r-items(after)), bfk-r-vm(after), "0");
  // (items vm status value): a crossing loop's answer taken apart
  def bfk-pl-status(cx, call, carried, vm) {
   let r = bfk-fresh(cx, "r");
   let st = bfk-fresh(cx, "s");
   let rv = bfk-fresh(cx, "v");
   let rest = bfk-untuple-keys(cx, r, carried, 2, vm, empty);
   list(append(list(bfk-let(r, call), bfk-let(st, bfk-f2("nth", r, "0")), bfk-let(rv, bfk-f2("nth", r, "1"))), bfk-r-items(rest)), bfk-r-vm(rest), st, rv);
  }
  // the transfer a loop carried out is set as the control lowering sets one
  def bfk-pl-cross-finish(b, u) = bfk-r(append(bfk-r-items(nth(b, 0)), append(nth(u, 0), list(bfk-pl-set-cross(nth(u, 2), nth(u, 3))))), nth(u, 1), "0");
  def bfk-pl-set-cross(st, rv) = bfk-if(bfk-f2("eq", st, "0"), "0", bfk-if(bfk-f2("eq", st, bfk-int(bml-ctl-return-mode(0))), bfk-do(list(bfk-cell-set("v", rv)), bfk-cell-set("m", st)), bfk-do(list(bfk-cell-set("t", rv)), bfk-cell-set("m", st))));
  // a loop inside a mode-free loop: one that carries a transfer out makes
  // the outer pass leave with it
  def bfk-pl-inner(cx, node, parts, rest, env, vm, li, kont) = bfk-pl-inner-with(cx, bfk-pl-build(cx, node, parts, env, vm, bml-ctl-ctx(empty), cons(list(nth(li, 7), nth(li, 6)), nth(li, 8))), rest, bml-ctl-env-after(node, env), li, kont);
  def bfk-pl-inner-with(cx, b, rest, env2, li, kont) = if nth(b, 3) then bfk-pl-inner-cross(cx, b, bfk-pl-status(cx, nth(b, 1), nth(b, 2), bfk-r-vm(nth(b, 0))), rest, env2, li, kont) else bfk-pl-then(cx, bfk-pl-plain-finish(nth(b, 0), bfk-pl-after(cx, nth(b, 1), nth(b, 2), bfk-r-vm(nth(b, 0)))), rest, env2, li, kont);
  // this loop takes its own break and continue codes; any other status goes on out
  def bfk-pl-inner-cross(cx, b, u, rest, env2, li, kont) = bfk-do(append(bfk-r-items(nth(b, 0)), nth(u, 0)), bfk-if(bfk-f2("eq", nth(u, 2), "0"), bfk-pl-seq(cx, rest, env2, nth(u, 1), li, kont), bfk-if(bfk-f2("eq", nth(u, 2), bfk-int(bfk-break-code(nth(li, 6)))), bfk-pl-exit(li, nth(u, 1)), bfk-if(bfk-f2("eq", nth(u, 2), bfk-int(bfk-continue-code(nth(li, 6)))), bfk-pl-next(cx, li, nth(u, 1)), bfk-pl-pass-on(li, nth(u, 1), nth(u, 2), nth(u, 3))))));
  def bfk-pl-pass-on(li, vm, st, rv) = if nth(li, 5) then bfk-pl-cross-exit(li, vm, st, rv) else bfk-pl-exit(li, vm);
  def bfk-pl-cross(cx, node, mode, env, vm, li) = bfk-pl-cross-exit(li, vm, bfk-int(mode), bfk-expr(cx, bml-node-child(node, 0), env, vm));
  def bfk-pl-cross-exit(li, vm, st, rv) = bfk-form(cons("list", cons(st, cons(rv, bfk-vm-vars(vm, nth(li, 2))))));
  def bfk-crosses?(node) = if bfk-holds-throw?(node) then true else bfk-holds-return?(node);
  def bfk-holds-return?(node) = if eq(len(node_children(node)), 0) then false else if node_eq(node_category(node), BML-AST-RETURN) then true else if node_eq(node_category(node), BML-AST-METHOD) then false else bfk-any-return?(node_children(node));
  def bfk-any-return?(nodes) = if nil?(nodes) then false else if bfk-holds-return?(head(nodes)) then true else bfk-any-return?(tail(nodes));
  def bfk-pl-test(cx, test, env, vm, pass, exit) = if bfk-true-literal?(test) then pass else bfk-pl-if(cx, test, env, vm, pass, exit);
  def bfk-true-literal?(node) = if not(node_eq(node_category(node), BML-AST-INT)) then false else if eq(len(node_children(node)), 0) then false else not(eq(node_value(bml-node-child(node, 0)), 0));
  // an if over BML's truth; a compare of two ints stays a compare
  def bfk-pl-if(cx, test, env, vm, yes, no) = if bfk-int-eq?(test, env, "op-ne") then bfk-if(bfk-eq-text(cx, test, env, vm), no, yes) else if bfk-int-eq?(test, env, "op-eq") then bfk-if(bfk-eq-text(cx, test, env, vm), yes, no) else bfk-if(bfk-cond(cx, test, env, vm), yes, no);
  def bfk-int-eq?(node, env, rule) = if not(bml-ctl-op-node?(node)) then false else if str_eq(bml-ctl-op-rule-of(node), rule) then bfk-ints?(bml-call-args(node), env) else false;
  def bfk-ints?(nodes, env) = if nil?(nodes) then true else if bfk-int-typed?(head(nodes), env) then bfk-ints?(tail(nodes), env) else false;
  // an int by what the compiler sees: an int literal, a name typed int, or +, -, * and unary - over ints
  def bfk-int-typed?(node, env) = if node_eq(node_category(node), BML-AST-INT) then gt(len(node_children(node)), 0) else if node_eq(node_category(node), BML-AST-ADD) then bfk-ints?(node_children(node), env) else if bml-ctl-op-node?(node) then bfk-int-op?(node, env) else str_eq(bml-hati-static-type(node, env), "int");
  def bfk-int-op?(node, env) = if fsc-string-list-contains?(list("op-sub", "op-mul", "op-neg"), bml-ctl-op-rule-of(node)) then bfk-ints?(bml-call-args(node), env) else false;
  def bfk-eq-text(cx, node, env, vm) = bfk-form(cons("eq", bfk-exprs(cx, bml-call-args(node), env, vm)));
  def bfk-pl-seq(cx, nodes, env, vm, li, kont) = if nil?(nodes) then bfk-pl-kont(cx, kont, vm, li) else bfk-pl-node(cx, head(nodes), tail(nodes), env, vm, li, kont);
  def bfk-pl-node(cx, node, rest, env, vm, li, kont) = if nil?(node_children(node)) then bfk-pl-plain(cx, node, rest, env, vm, li, kont) else bfk-pl-shape(cx, node, node_category(node), rest, env, vm, li, kont);
  def bfk-pl-shape(cx, node, cat, rest, env, vm, li, kont) = if node_eq(cat, BML-AST-BLOCK) then bfk-pl-seq(cx, node_children(node), env, vm, li, list("rest", rest, bml-ctl-env-after(node, env), kont)) else if node_eq(cat, BML-AST-IF) then if bfk-select-if?(node, env) then bfk-pl-select(cx, node, rest, env, vm, li, kont) else bfk-pl-if(cx, bml-node-child(node, 0), env, vm, bfk-pl-seq(cx, bfk-stmts-of(bml-node-child(node, 1)), env, vm, li, list("rest", rest, bml-ctl-env-after(node, env), kont)), bfk-pl-seq(cx, bfk-stmts-of(bml-ctl-child-or-block(node, 2)), env, vm, li, list("rest", rest, bml-ctl-env-after(node, env), kont))) else if node_eq(cat, BML-AST-BREAK) then bfk-pl-jump(cx, li, vm, bml-local-name(node), "break") else if node_eq(cat, BML-AST-CONTINUE) then bfk-pl-jump(cx, li, vm, bml-local-name(node), "continue") else if node_eq(cat, BML-AST-RETURN) then bfk-pl-cross(cx, node, bml-ctl-return-mode(0), env, vm, li) else if node_eq(cat, BML-AST-THROW) then bfk-pl-cross(cx, node, bml-ctl-throw-mode(0), env, vm, li) else if bml-ctl-while-node?(node) then bfk-pl-inner(cx, node, bml-ctl-while-parts(node), rest, env, vm, li, kont) else if node_eq(cat, BML-AST-FOR) then bfk-pl-inner(cx, node, bml-ctl-for-parts(node), rest, env, vm, li, kont) else bfk-pl-plain(cx, node, rest, env, vm, li, kont);
  // in a standing body a plain statement writes the value it stands on, which the loop carries out
  def bfk-pl-plain(cx, node, rest, env, vm, li, kont) = bfk-pl-then(cx, bfk-stmt(cx, if bml-ctl-standing?(env) then bml-bnml-top-rewrite(node) else node, env, vm), rest, bml-ctl-env-after(node, env), li, kont);
  def bfk-with-top(env, vm, keys) = if bml-ctl-standing?(env) then if bfk-vm-has?(vm, "__top") then bfk-with-key(keys, "__top") else keys else keys;
  def bfk-pl-then(cx, r, rest, env, li, kont) = bfk-do(bfk-r-items(r), bfk-pl-seq(cx, rest, env, bfk-r-vm(r), li, kont));
  def bfk-pl-kont(cx, kont, vm, li) = if str_eq(head(kont), "rest") then bfk-pl-seq(cx, nth(kont, 1), nth(kont, 2), vm, li, nth(kont, 3)) else if str_eq(head(kont), "next") then bfk-pl-next(cx, li, vm) else bfk-pl-call(li, vm);
  def bfk-pl-next(cx, li, vm) = bfk-pl-seq(cx, nth(li, 3), nth(li, 4), vm, li, list("call"));
  def bfk-pl-call(li, vm) = bfk-form(cons(nth(li, 0), bfk-vm-vars(vm, nth(li, 1))));
  def bfk-pl-exit(li, vm) = if nth(li, 5) then bfk-pl-cross-exit(li, vm, "0", "0") else if nil?(nth(li, 2)) then "0" else if nil?(tail(nth(li, 2))) then bfk-vm-or0(vm, head(nth(li, 2))) else bfk-form(cons("list", cons("0", bfk-vm-vars(vm, nth(li, 2)))));
  def bfk-pl-after(cx, call, carried, vm) = if nil?(carried) then bfk-value-stmt(cx, call, vm) else if nil?(tail(carried)) then bfk-pl-one(cx, call, head(carried), vm) else bfk-untuple(cx, call, carried, vm);
  def bfk-pl-one(cx, call, key, vm) {
   let v = bfk-fresh(cx, "v");
   bfk-r(list(bfk-let(v, call)), bfk-vm-put(vm, key, v), v);
  }
  def bfk-ctl-exit(id) = if nil?(bml-ctl-stopping-modes(id)) then "0" else bfk-if(bfk-mode-in(bml-ctl-stopping-modes(id)), bfk-set-mode(0), "0");

  // switch and select read as statements over the two locals the node
  // declares; a break ends them
  def bfk-ctl-switch(cx, node, env, vm, ctx) {
   let id = bml-ctl-next-id(ctx);
   let outk = bfk-out-keys(bml-ctl-env-after(node, env), vm);
   let r = bfk-untuple(cx, bfk-ctl-stmts(cx, bml-ctl-switch-statements(node), env, vm, outk, bml-ctl-ctx-push(ctx, "switch", bml-ctl-switch-label(node), id), "0"), outk, vm);
   bfk-r(append(bfk-r-items(r), list(bfk-ctl-exit(id))), bfk-r-vm(r), "0");
  }

  // break and continue set the mode their target reads; throw and return
  // hold their value and set the mode when none is set
  def bfk-ctl-effect(cx, effect, env, vm, ctx) = if bml-ctl-targeted-kind?(bnsc-effect-kind(effect)) then bfk-ctl-jump(cx, effect, bml-ctl-effect-target(effect, ctx), vm) else bfk-ctl-transfer(cx, effect, env, vm);
  def bfk-ctl-jump(cx, effect, target, vm) = if lt(target, 0) then bfk-value-stmt(cx, bfk-need(cx, bml-ctl-jump-reason(effect)), vm) else bfk-r(list(bfk-set-mode(bml-ctl-effect-mode(effect, target))), vm, "0");
  def bfk-ctl-transfer(cx, effect, env, vm) {
   let v = bfk-fresh(cx, "v");
   let cell = if str_eq(bnsc-effect-kind(effect), "throw") then "t" else "v";
   bfk-r(list(bfk-let(v, bfk-expr(cx, bnsc-effect-value(effect), env, vm)), bfk-cell-set(cell, v), bfk-if(bfk-mode-zero(), bfk-set-mode(bml-ctl-effect-mode(effect, 0)), "0")), vm, v);
  }

  // try: the body, then, on the mode a catch takes, the catch's local from
  // the thrown value and the handler
  def bfk-ctl-try(cx, node, env, vm, ctx) {
   let outk = bfk-out-keys(bml-ctl-env-after(node, env), vm);
   let body = bfk-ctl-stmt(cx, bml-node-child(node, 0), env, vm, ctx);
   let decl = bfk-ctl-stmt(cx, bml-ctl-try-decl(node), env, bfk-r-vm(body), ctx);
   let handler = bfk-ctl-stmt(cx, bml-node-child(node, 1), bml-local-env-after-node(bml-ctl-try-decl(node), env), bfk-r-vm(decl), ctx);
   let caught = bfk-do(cons(bfk-set-mode(0), append(bfk-r-items(decl), bfk-r-items(handler))), bfk-tuple(bfk-r-val(handler), bfk-r-vm(handler), outk));
   bfk-untuple(cx, bfk-do(bfk-r-items(body), bfk-if(bfk-mode-is(bml-ctl-catch-mode(0)), caught, bfk-tuple("0", bfk-r-vm(body), outk))), outk, vm);
  }

  // with( e ): .self is the base the node declares
  def bfk-with-access(cx, node, env, vm) = if not(bml-ctl-with-bound?(env)) then bfk-need(cx, "with/no-base") else if bml-ctl-with-self-node?(node) then bfk-expr(cx, bml-ctl-with-base-node(0), env, vm) else bfk-class-with(cx, node, env, vm);

  // ── choose, fail and the snapshot ───────────────────────────────────────
  // A fail sets FAILED and the statements after it stand down. A choose whose
  // branches assign or fail partway runs each branch from the names it was
  // entered with, FAILED clear: the first branch that ends unfailed hands back
  // the incoming flag and answers, and a branch that failed undoes the field
  // sets the journal kept since the choose opened it, so the next branch meets
  // the state the choose met. If every branch fails the choose fails and its
  // body stops at the value it stood on. save pushes the names in scope, the
  // standing value and the journal count; restore writes them back and undoes
  // the journal to that count; discard drops the newest. A field lives in its
  // record, outside every frame: while a snapshot is open a field set journals
  // the value it replaces.
  def bfk-fail-stmt(cx, env, vm) = bfk-r(list(bfk-cell-set("f", "1")), vm, if or(bml-bnml-choosing?(env), bml-bnml-env-fallible?(env)) then bfk-top(vm) else "0");

  def bfk-journal-open() = bfk-cell-set("d", bfk-f2("add", bfk-cell("d"), "1"));
  def bfk-journal-close() = bfk-do(list(bfk-cell-set("d", bfk-f2("sub", bfk-cell("d"), "1"))), bfk-if(bfk-f2("le", bfk-cell("d"), "0"), bfk-do(list(bfk-cell-set("j", "(list)")), bfk-cell-set("c", "0")), "0"));
  def bfk-journal-undo(saved) = bfk-f1("bfk-undo", bfk-f2("sub", bfk-cell("c"), saved));

  // statements in order, their items gathered: (items vm value)
  def bfk-seq-items(cx, nodes, env, vm) = bfk-seq-items-at(cx, nodes, env, bfk-r(empty, vm, "0"));
  def bfk-seq-items-at(cx, nodes, env, acc) = if nil?(nodes) then acc else bfk-seq-items-at(cx, tail(nodes), bml-local-env-after-node(head(nodes), env), bfk-r-prefix(bfk-r-items(acc), bfk-stmt(cx, head(nodes), env, bfk-r-vm(acc))));
  def bfk-stmts-of(node) = if node_eq(node_category(node), BML-AST-BLOCK) then node_children(node) else list(node);

  def bfk-choose-track(cx, node, env, vm) {
   let promos = bml-bnml-choose-promotions(node, env);
   let inner-env = bml-bnml-fold-env(promos, env);
   let heard = bml-bnml-edge-check("choose", node, inner-env);
   let told = bml-bch-all-fail(node_children(node));
   let pr = bfk-seq-items(cx, promos, env, vm);
   let outk = bfk-out-keys(inner-env, bfk-r-vm(pr));
   let fin = bfk-fresh(cx, "f");
   let jc = bfk-fresh(cx, "c");
   let kin = bfk-fresh(cx, "k");
   let r = bfk-untuple(cx, bfk-branches(cx, node_children(node), bml-bnml-choosing(inner-env), bfk-r-vm(pr), outk, list(fin, jc, kin)), outk, bfk-r-vm(pr));
   bfk-r(append(bfk-r-items(pr), append(list(bfk-let(fin, bfk-cell("f")), bfk-let(jc, bfk-cell("c")), bfk-let(kin, bfk-cell("k")), bfk-journal-open()), bfk-r-items(r))), bfk-r-vm(r), bfk-r-val(r));
  }
  // held: (incoming FAILED, journal count, incoming commit). A choose that
  // answers hands both flags back. A branch that failed after its cut fails
  // the whole choose: the branches after it are discarded, as a failure after
  // every branch fails it.
  def bfk-choose-fails(vm0, outk, held) = bfk-do(list(bfk-cell-set("f", "1"), bfk-journal-close(), bfk-cell-set("k", nth(held, 2))), bfk-tuple(bfk-top(vm0), vm0, outk));
  def bfk-branches(cx, branches, env, vm0, outk, held) = if nil?(branches) then bfk-choose-fails(vm0, outk, held) else bfk-branch(cx, branches, env, vm0, outk, held, bfk-fresh(cx, "b"));
  def bfk-branch(cx, branches, env, vm0, outk, held, b) = bfk-do(list(bfk-cell-set("f", "0"), bfk-cell-set("k", "0"), bfk-let(b, bfk-nodes(cx, bfk-stmts-of(head(branches)), env, vm0, outk))), bfk-if(bfk-unfailed(), bfk-do(list(bfk-cell-set("f", nth(held, 0)), bfk-journal-close(), bfk-cell-set("k", nth(held, 2))), b), bfk-do(list(bfk-journal-undo(nth(held, 1))), bfk-if(bfk-f2("le", bfk-cell("k"), "0"), bfk-branches(cx, tail(branches), env, vm0, outk, held), bfk-choose-fails(vm0, outk, held)))));

  // A cut commits the choose around it to this branch: a failure after it in
  // the branch fails the whole choose, one before it still falls through, and
  // its scope is its own choose (form-stdlib/engine.fk's cut-aware sequence
  // and choice). Outside any choose it commits nothing. Like the marks, it
  // answers the value its body stands on.
  def bfk-cut-stmt(env, vm) = bfk-r(if bml-bnml-choosing?(env) then list(bfk-cell-set("k", "1")) else empty, vm, bfk-top(vm));
  // the table lowering names cut as a need it cannot meet; this lowering meets it
  def bfk-without(reasons, reason) = if nil?(reasons) then empty else if str_eq(head(reasons), reason) then bfk-without(tail(reasons), reason) else cons(head(reasons), bfk-without(tail(reasons), reason));

  def bfk-vm-marks(vm) = if bfk-vm-has?(vm, "__marks") then bfk-vm-get(vm, "__marks") else "(list)";
  def bfk-save-stmt(cx, env, vm) {
   let s = bfk-fresh(cx, "s");
   let m = bfk-fresh(cx, "k");
   let snap = bfk-form(cons("list", append(bfk-vm-vars(vm, bml-bnml-snapshot-keys(env, empty)), list(bfk-top(vm), bfk-cell("c")))));
   bfk-r(list(bfk-let(s, snap), bfk-let(m, bfk-f2("cons", s, bfk-vm-marks(vm))), bfk-journal-open()), bfk-vm-put(vm, "__marks", m), bfk-top(vm));
  }
  def bfk-restore-stmt(cx, env, vm) = bfk-restore-at(cx, bml-bnml-active-mark(env, 0), vm);
  def bfk-restore-at(cx, mark, vm) = if nil?(mark) then bfk-value-stmt(cx, "0", vm) else bfk-restore-keys(cx, append(bml-bnml-snapshot-keys(bml-local-binding-env(mark), empty), list("__top")), vm);
  def bfk-restore-keys(cx, keys, vm) {
   let s = bfk-fresh(cx, "s");
   let m = bfk-fresh(cx, "k");
   let back = bfk-untuple-keys(cx, s, keys, 0, vm, empty);
   bfk-r(cons(bfk-let(s, bfk-f1("head", bfk-vm-marks(vm))), append(bfk-r-items(back), list(bfk-journal-undo(bfk-f2("nth", s, bfk-int(len(keys)))), bfk-let(m, bfk-f1("tail", bfk-vm-marks(vm))), bfk-journal-close()))), bfk-vm-put(bfk-r-vm(back), "__marks", m), bfk-top(bfk-r-vm(back)));
  }
  def bfk-discard-stmt(cx, env, vm) {
   let m = bfk-fresh(cx, "k");
   bfk-r(list(bfk-let(m, bfk-f1("tail", bfk-vm-marks(vm))), bfk-journal-close()), bfk-vm-put(vm, "__marks", m), bfk-top(vm));
  }

  // ── classes ─────────────────────────────────────────────────────────────
  // A record is a Form record carrying bmlClass, bmlClassId and every field.
  // A member is one defn over the packed (self a0 a1 ...) list the layout's
  // calls pass; a method table reads self's class id and hands the same list
  // to the member that answers it. Which member a call reaches, which
  // constructor a new runs, which field a path names: the layout's own choice.
  def bfk-pack(vm) = bfk-vm-or0(vm, "@pack");
  def bfk-self(vm) = bfk-f1("head", bfk-pack(vm));
  def bfk-class-shaped?(node, env) = if bml-hati-class-call?(node) then true else if bml-hati-field-assign?(node, env) then true else if bml-hati-dotted-assign?(node, env) then true else if bml-hati-receiver-name?(bml-call-name(node), env) then true else bml-hati-member-call?(bml-call-name(node), env);
  def bfk-class-call(cx, node, env, vm) = if bml-hati-class-call?(node) then bfk-class-marker(cx, node, bml-call-name(node), env, vm) else if bml-hati-field-assign?(node, env) then bfk-this-field-store(cx, bml-bnml-target-name(node), bml-bnml-value(node), env, vm) else if bml-hati-dotted-assign?(node, env) then bfk-path-store(cx, bml-hati-dotted-split(bml-bnml-target-name(node)), bml-bnml-value(node), env, vm) else if bml-hati-receiver-name?(bml-call-name(node), env) then bfk-path-invoke(cx, bml-hati-dotted-split(bml-call-name(node)), bml-call-args(node), env, vm) else bfk-invoke(cx, bml-ast-name("this"), bml-call-name(node), bml-call-args(node), env, vm);
  def bfk-class-name(cx, node, env, vm) = bfk-path-read(cx, bml-hati-dotted-split(bml-local-name(node)), env, vm);
  def bfk-class-with(cx, node, env, vm) = if bml-ctl-with-member-node?(node) then bfk-field-read(cx, bml-ctl-with-base-node(0), bml-ctl-with-member-name(node), env, vm) else bfk-expr(cx, bml-ctl-with-call-of(node), env, vm);

  def bfk-class-marker(cx, node, name, env, vm) = if or(str_eq(name, "__hati_self"), str_eq(name, "__hati_super")) then bfk-self(vm) else if str_eq(name, "__hati_param") then bfk-f2("nth", bfk-pack(vm), bfk-int(add(bml-hati-marker-int(node, 0), 1))) else if str_eq(name, "__hati_field") then bfk-this-field-read(cx, bml-hati-marker-str(node, 0), env, vm) else if str_eq(name, "__hati_field_get") then bfk-this-field-read(cx, node_value(bml-node-child(head(bml-call-args(node)), 0)), env, vm) else if str_eq(name, "__hati_field_set") then bfk-this-field-store(cx, node_value(bml-node-child(head(bml-call-args(node)), 0)), nth(bml-call-args(node), 1), env, vm) else if str_eq(name, "__hati_new") then bfk-new(cx, bml-hati-env-layout(env), bml-hati-marker-str(node, 0), tail(bml-call-args(node)), env, vm) else if str_eq(name, "__hati_invoke") then bfk-invoke(cx, bml-hati-marker-arg(node, 0), bml-hati-marker-str(node, 1), drop(2, bml-call-args(node)), env, vm) else if str_eq(name, "__hati_get") then bfk-field-read(cx, bml-hati-marker-arg(node, 0), bml-hati-marker-str(node, 1), env, vm) else if str_eq(name, "__hati_set") then bfk-field-store(cx, bml-hati-marker-arg(node, 0), bml-hati-marker-str(node, 1), bml-hati-marker-arg(node, 2), env, vm) else if str_eq(name, "__hati_forward_get") then bfk-f2("record_get", bfk-expr(cx, bml-hati-marker-arg(node, 0), env, vm), bfk-str(bml-hati-recv-field-key(env, bml-hati-marker-arg(node, 0), bml-hati-marker-str(node, 1)))) else if str_eq(name, "__hati_new_outer") then bfk-new-outer(cx, node, env, vm) else if str_eq(name, "__hati_class_get") then bfk-static-get(cx, node, env, vm) else if str_eq(name, "__hati_class_set") then bfk-static-set(cx, node, env, vm) else if str_eq(name, "__hati_self_ctor") then bfk-ctor-chain(cx, "self", bml-call-args(node), env, vm) else if str_eq(name, "__hati_super_ctor") then bfk-ctor-chain(cx, "super", bml-call-args(node), env, vm) else bfk-need(cx, bfk-marker-need(node, name));
  def bfk-marker-need(node, name) = if str_eq(name, "__hati_member") then "name/method" else if str_eq(name, "__hati_ctor") then "name/constructor" else if str_eq(name, "__hati_abstract") then "method/abstract" else if str_eq(name, "__hati_unread") then bml-voice-then(bml-unread-reading(bml-hati-marker-str(node, 0)), "source/unread") else if str_eq(name, "__hati_denied") then bml-hati-denied-reason(node) else "method/body-unparsed";

  // fields: a field of a class the layout knows, or of an owner it cannot see;
  // a primitive has none. A set under an open snapshot journals the value it
  // replaces, and answers 0 as the table's record set does.
  def bfk-field-read(cx, recv-node, field, env, vm) = if bml-hati-field-readable?(env, recv-node, field) then bfk-f2("record_get", bfk-expr(cx, recv-node, env, vm), bfk-str(bml-hati-recv-field-key(env, recv-node, field))) else if bml-hati-get-method?(env, recv-node, field) then bfk-invoke(cx, recv-node, field, empty, env, vm) else bfk-need(cx, bml-hati-field-miss(env, recv-node, field));
  def bfk-field-store(cx, recv-node, field, value-node, env, vm) = if not(bml-hati-field-writable?(env, recv-node, field, value-node)) then bfk-need(cx, bml-hati-store-miss(env, recv-node, field, value-node)) else if ge(bml-hati-strict-runtime-id(env, recv-node, field, value-node), 0) then bfk-set-strict(bfk-fresh(cx, "o"), bfk-fresh(cx, "v"), bfk-expr(cx, recv-node, env, vm), bfk-str(bml-hati-recv-field-key(env, recv-node, field)), bfk-expr(cx, value-node, env, vm), bml-hati-strict-runtime-id(env, recv-node, field, value-node), str_concat(bml-hati-static-type(recv-node, env), str_concat(".", field))) else bfk-set-field(bfk-fresh(cx, "o"), bfk-expr(cx, recv-node, env, vm), bfk-str(bml-hati-recv-field-key(env, recv-node, field)), bfk-expr(cx, value-node, env, vm));
  def bfk-set-field(o, recv, key, value) = bfk-do(list(bfk-let(o, recv), bfk-f2("bfk-jot", o, key), bfk-f3("record_set", o, key, value)), "0");
  // a strict field's store, checked when it runs (thesis line 666): a value
  // of a derived class is not stored, and the run answers the trap
  def bfk-set-strict(o, v, recv, key, value, id, at) = bfk-do(list(bfk-let(o, recv), bfk-let(v, value), bfk-if(bfk-f2("bfk-strict-ok", v, bfk-int(id)), bfk-do(list(bfk-f2("bfk-jot", o, key)), bfk-f3("record_set", o, key, v)), bfk-f1("bfk-strict-trap", bfk-str(at)))), "0");
  def bfk-this-field-read(cx, field, env, vm) = if bml-hati-has-receiver?(env) then bfk-field-read(cx, bml-ast-name("this"), field, env, vm) else bfk-need(cx, "field/no-receiver");
  def bfk-this-field-store(cx, field, value-node, env, vm) = if bml-hati-has-receiver?(env) then bfk-field-store(cx, bml-ast-name("this"), field, value-node, env, vm) else bfk-need(cx, "field/no-receiver");
  def bfk-path-read(cx, split, env, vm) = bfk-field-read(cx, bml-ast-name(head(split)), nth(split, 1), env, vm);
  def bfk-path-store(cx, split, value-node, env, vm) = bfk-field-store(cx, bml-ast-name(head(split)), nth(split, 1), value-node, env, vm);
  def bfk-path-invoke(cx, split, args, env, vm) = bfk-invoke(cx, bml-ast-name(head(split)), nth(split, 1), args, env, vm);

  // recv.member(args): the layout's choice, a direct member or its method
  // table; super.member starts at the base and is direct
  def bfk-invoke(cx, recv-node, member, args, env, vm) = bfk-invoke-with(cx, recv-node, member, args, env, vm, bfk-invoke-choice(recv-node, member, args, env));
  def bfk-invoke-choice(recv-node, member, args, env) = if bml-hati-super-receiver?(recv-node, env) then bml-hati-super-choice(bml-hati-env-layout(env), bml-hati-name-type(bml-local-name(recv-node), env), member, bml-hati-static-types(args, env)) else bml-hati-invoke-choice(bml-hati-env-layout(env), bml-hati-static-type(recv-node, env), member, bml-hati-static-types(args, env));
  def bfk-invoke-with(cx, recv-node, member, args, env, vm, choice) = if bml-hati-choice-ok?(choice) then bfk-member-call(cx, bml-hati-choice-value(choice), recv-node, args, env, vm) else if gt(str_len(bml-hati-delegate-via(env, recv-node, member, args)), 0) then bfk-invoke(cx, bml-hati-forward-get(recv-node, bml-hati-delegate-via(env, recv-node, member, args)), member, args, env, vm) else bfk-after(cx, bml-hati-voice-refusal("receiver", bml-hati-choice-value(choice), str_concat(bml-hati-static-type(recv-node, env), str_concat(".", member))), cons(recv-node, args), env, vm);
  def bfk-member-call(cx, fn, recv-node, args, env, vm) = bfk-f1(bfk-fn-name(fn), bfk-form(cons("list", bfk-exprs(cx, cons(recv-node, args), env, vm))));
  // a call the layout cannot give still lowers what it carries, so a need
  // nested in its receiver or arguments is named beside its own
  def bfk-after(cx, reason, nodes, env, vm) = bfk-after-then(bfk-exprs(cx, nodes, env, vm), bfk-need(cx, reason));
  def bfk-after-then(_carried, text) = text;

  // new C(args): one record with the class's id and its fields, each at its
  // key and set to its literal initializer (or 0), each class's init member
  // over it base first, then the constructor the layout picks over it
  def bfk-new(cx, layout, class-type, args, env, vm) = if nil?(bml-hati-layout-class(layout, class-type)) then bfk-after(cx, bfk-unknown-class(layout, class-type), args, env, vm) else if bml-hati-class-abstract?(layout, class-type) then bfk-need(cx, bml-hati-voice-refusal("construction", "new/abstract-class", class-type)) else if not(bml-hati-fields-init-ok?(bml-hati-class-fields-all(layout, class-type))) then bfk-need(cx, bml-hati-voice-refusal("construction", "field/init", class-type)) else bfk-new-ctor(cx, layout, bml-hati-layout-class(layout, class-type), args, env, vm, bml-hati-ctor-choice(layout, class-type, bml-hati-static-types(args, env)));
  def bfk-unknown-class(layout, class-type) = if bml-hati-template-named?(layout, bml-hati-type-base(class-type)) then bml-hati-voice-refusal("specialization", "template/unspecialized", class-type) else bml-hati-voice-refusal("construction", "new/unknown-class", class-type);
  def bfk-new-ctor(cx, layout, entry, args, env, vm, choice) = if not(bml-hati-choice-ok?(choice)) then bfk-need(cx, bml-hati-voice-refusal("construction", bml-hati-choice-value(choice), bml-hati-class-name(entry))) else if lt(bml-hati-choice-value(choice), 0) then bfk-initialized(cx, layout, entry, env, vm) else bfk-f1(bfk-fn-name(bml-hati-choice-value(choice)), bfk-form(cons("list", cons(bfk-initialized(cx, layout, entry, env, vm), bfk-exprs(cx, args, env, vm)))));
  def bfk-instance(cx, layout, entry, env, vm) = bfk-f2("bfk-obj", "(record_new 0)", bfk-form(cons("list", append(list(bfk-row("bmlClass", bfk-str(bml-hati-class-name(entry))), bfk-row("bmlClassId", bfk-int(bml-hati-class-id(entry)))), bfk-field-rows(cx, bml-hati-field-rows(bml-hati-class-fields-all(layout, bml-hati-class-name(entry))), bml-hati-class-init-env(env, bml-hati-class-name(entry)), vm)))));
  def bfk-initialized(cx, layout, entry, env, vm) = bfk-init-over(bml-hati-init-fns(layout, bml-hati-class-name(entry)), bfk-instance(cx, layout, entry, env, vm));
  def bfk-init-over(fns, rec) = if nil?(fns) then rec else bfk-init-over(tail(fns), bfk-f1(bfk-fn-name(head(fns)), bfk-form(list("list", rec))));
  // new of an inner class inside its outer class's code: the record, its
  // hidden field set to the outer instance, this (thesis line 654)
  def bfk-new-outer(cx, node, env, vm) = bfk-new-outer-at(bfk-fresh(cx, "r"), bfk-expr(cx, bml-hati-marker-arg(node, 0), env, vm), bfk-str(bml-hati-field-key(bml-hati-env-layout(env), bml-hati-marker-str(bml-hati-marker-arg(node, 0), 0), "__outer")), vm);
  def bfk-new-outer-at(r, made, key, vm) = bfk-do(list(bfk-let(r, made), bfk-f3("record_set", r, key, bfk-self(vm))), r);
  // a class field: one slot per class in the program's state; its initializer
  // runs at the first read, and a set marks it set
  def bfk-static-key(node) = str_concat("class:", str_concat(bml-hati-marker-str(node, 0), str_concat(".", bml-hati-marker-str(node, 1))));
  def bfk-static-flag(node) = str_concat("class?", bfk-static-key(node));
  def bfk-static-get(cx, node, env, vm) = bfk-if(bfk-f2("eq", bfk-cell(bfk-static-flag(node)), "1"), bfk-cell(bfk-static-key(node)), bfk-do(list(bfk-cell-set(bfk-static-key(node), bfk-expr(cx, bml-hati-marker-arg(node, 3), env, vm)), bfk-cell-set(bfk-static-flag(node), "1")), bfk-cell(bfk-static-key(node))));
  def bfk-static-set(cx, node, env, vm) = bfk-do(list(bfk-cell-set(bfk-static-key(node), bfk-expr(cx, bml-hati-marker-arg(node, 2), env, vm)), bfk-cell-set(bfk-static-flag(node), "1")), "0");
  def bfk-row(key, value) = bfk-f2("list", bfk-str(key), value);
  def bfk-field-rows(cx, rows, env, vm) = if nil?(rows) then empty else cons(bfk-row(head(head(rows)), bfk-expr(cx, nth(head(rows), 1), env, vm)), bfk-field-rows(cx, tail(rows), env, vm));

  // self(args) runs another constructor of this class on the same record;
  // super(args) runs one of the base class's
  def bfk-ctor-chain(cx, which, args, env, vm) = bfk-ctor-chain-at(cx, which, args, env, vm, bml-local-lookup-direct(env, "__hati_ctor"));
  def bfk-ctor-chain-at(cx, which, args, env, vm, binding) = if nil?(binding) then bfk-need(cx, "ctor/outside-constructor") else bfk-ctor-target(cx, bml-hati-env-layout(env), bfk-chain-class(bml-hati-env-layout(env), which, bml-hati-marker-str(bml-local-binding-value(binding), 0)), args, env, vm);
  def bfk-chain-class(layout, which, class-name) = if str_eq(which, "self") then class-name else bml-hati-class-base-name(layout, class-name);
  def bfk-ctor-target(cx, layout, target, args, env, vm) = if nil?(bml-hati-layout-class(layout, target)) then bfk-need(cx, "super/no-base") else bfk-ctor-call(cx, bml-hati-ctor-choice(layout, target, bml-hati-static-types(args, env)), args, env, vm);
  def bfk-ctor-call(cx, choice, args, env, vm) = if not(bml-hati-choice-ok?(choice)) then bfk-need(cx, bml-hati-choice-value(choice)) else if lt(bml-hati-choice-value(choice), 0) then bfk-self(vm) else bfk-member-call(cx, bml-hati-choice-value(choice), bml-ast-name("this"), args, env, vm);

  // every member of every class and interface, each in its owner's env,
  // then the method tables and the trap
  def bfk-decls(cx, layout, env, homes) = append(bfk-owners(cx, layout, append(bml-hati-layout-classes(layout), bml-hati-layout-ifaces(layout)), env, homes), append(bfk-stubs(layout, bml-hati-layout-stubs(layout)), bfk-trap(layout)));
  def bfk-owners(cx, layout, owners, env, homes) = if nil?(owners) then empty else append(bfk-members(cx, layout, nth(head(owners), 1), nth(head(owners), if str_eq(head(head(owners)), "bml-hati-class") then 5 else 3), bml-hati-owner-env(homes, nth(head(owners), 1), env)), bfk-owners(cx, layout, tail(owners), env, homes));
  def bfk-members(cx, layout, owner, members, base-env) = if nil?(members) then empty else if lt(bml-hati-member-fn(head(members)), 0) then bfk-members(cx, layout, owner, tail(members), base-env) else cons(bfk-member(cx, layout, owner, head(members), base-env), bfk-members(cx, layout, owner, tail(members), base-env));
  def bfk-member(cx, layout, owner, member, base-env) {
   let env = bml-hati-member-env(layout, owner, member, base-env);
   let body = bml-method-node-body(bml-hati-member-node(member));
   let heard = bfk-need-all(cx, bfk-without(bml-hati-unsupported-node-in(body, env), "cut"));
   let text = bfk-body-text(cx, bml-bnml-top-body-node-in(body, env), env, bfk-frame-vm(list(body), env, bfk-vm-put(empty, "@pack", "a0")));
   bfk-form(list("defn", bfk-fn-name(bml-hati-member-fn(member)), "(a0)", if str_eq(bml-hati-member-kind(member), "ctor") then bfk-do(list(text), "(head a0)") else text));
  }
  def bfk-need-all(cx, reasons) = if nil?(reasons) then 0 else bfk-need-all-then(cx, bfk-need-add(cx, head(reasons)), tail(reasons));
  def bfk-need-all-then(cx, _added, rest) = bfk-need-all(cx, rest);
  def bfk-stubs(layout, stubs) = if nil?(stubs) then empty else cons(bfk-stub(layout, head(stubs)), bfk-stubs(layout, tail(stubs)));
  def bfk-stub(layout, stub) = bfk-form(list("defn", bfk-fn-name(nth(stub, 1)), "(a0)", bfk-do(list(bfk-let("k", bfk-f2("record_get", "(head a0)", bfk-str("bmlClassId")))), bfk-disp(nth(stub, 2), 0, bml-hati-layout-trap(layout)))));
  def bfk-disp(table, k, trap) = if nil?(table) then bfk-trap-call(trap) else bfk-if(bfk-f2("eq", "k", bfk-int(k)), bfk-f1(bfk-fn-name(if lt(head(table), 0) then trap else head(table)), "a0"), bfk-disp(tail(table), add(k, 1), trap));
  def bfk-trap-call(trap) = if lt(trap, 0) then "0" else bfk-f1(bfk-fn-name(trap), "a0");
  def bfk-trap(layout) = if lt(bml-hati-layout-trap(layout), 0) then empty else list(bfk-form(list("defn", bfk-fn-name(bml-hati-layout-trap(layout)), "(a0)", bfk-str(bml-hati-trap-text()))));

  // ── methods and the program ─────────────────────────────────────────────
  def bfk-params(n, i) = if ge(i, n) then empty else cons(str_concat("a", int_to_str(i)), bfk-params(n, add(i, 1)));
  def bfk-param-vm(params, i, vm) = if nil?(params) then vm else bfk-param-vm(tail(params), add(i, 1), bfk-vm-put(vm, str_concat("@a", int_to_str(i)), head(params)));
  def bfk-arg-vm(params) = if eq(len(params), 1) then bfk-vm-put(empty, "@a", head(params)) else bfk-param-vm(params, 0, empty);

  // a body that keeps the value it stands on starts it at 0; one that takes
  // snapshots starts an empty stack of them
  def bfk-frame-vm(nodes, env, vm) = bfk-marks-vm(nodes, if bml-bnml-keeps-standing?(nodes, env) then bfk-vm-put(vm, "__top", "0") else vm);
  def bfk-marks-vm(nodes, vm) = if bml-bnml-any-snapshots?(nodes) then bfk-vm-put(vm, "__marks", "(list)") else vm;

  def bfk-body-text(cx, node, env, vm) = if node_eq(node_category(node), BML-AST-BLOCK) then bfk-nodes(cx, node_children(node), env, vm, empty) else bfk-r-expr(bfk-stmt(cx, node, env, vm));

  def bfk-method(cx, node, env, index) {
   let body-env = bml-hati-method-param-env(node, env);
   let params = bfk-params(len(bml-method-node-parameters(node)), 0);
   let body = bml-method-node-body(node);
   let vm = bfk-frame-vm(list(body), body-env, bfk-arg-vm(params));
   bfk-form(list("defn", bfk-fn-name(index), bfk-form(params), bfk-body-text(cx, bml-bnml-top-body-node-in(body, body-env), body-env, vm)));
  }
  def bfk-methods(cx, methods, env, index) = if nil?(methods) then empty else cons(bfk-method(cx, head(methods), env, index), bfk-methods(cx, tail(methods), env, add(index, 1)));
  def bfk-linked(cx, link, units, symbols, index) = if nil?(units) then empty else append(bfk-methods(cx, bml-scope-unit-methods(head(units)), bml-scope-unit-env-with(link, head(units), symbols, "hati"), index), bfk-linked(cx, link, tail(units), symbols, add(index, len(bml-scope-unit-methods(head(units))))));
  def bfk-main(cx, nodes, env) = bfk-form(list("defn", "m0", "()", bfk-nodes(cx, bml-bnml-top-body-in(nodes, env), env, bfk-frame-vm(nodes, env, empty), empty)));

  // the runtime the program carries: its state, the journal's undo, element
  // assignment, and the answer line the run reads back
  def bfk-state() = bfk-let("BFK", "(record_new 0)");
  def bfk-inits() = list(bfk-cell-set("m", "0"), bfk-cell-set("v", "0"), bfk-cell-set("t", "0"), bfk-cell-set("f", "0"), bfk-cell-set("j", "(list)"), bfk-cell-set("c", "0"), bfk-cell-set("d", "0"), bfk-cell-set("k", "0"));
  def bfk-undo-def() = bfk-form(list("defn", "bfk-undo", "(n)", bfk-if("(le n 0)", "0", bfk-do(list(bfk-let("e", bfk-f1("head", bfk-cell("j"))), bfk-form(list("record_set", "(nth e 0)", "(nth e 1)", "(nth e 2)")), bfk-cell-set("j", bfk-f1("tail", bfk-cell("j"))), bfk-cell-set("c", bfk-f2("sub", bfk-cell("c"), "1"))), "(bfk-undo (sub n 1))"))));
  def bfk-list-set-def() = bfk-form(list("defn", "bfk-list-set", "(xs at v)", bfk-if("(eq (len xs) 0)", "xs", bfk-if("(eq at 0)", "(cons v (tail xs))", "(cons (head xs) (bfk-list-set (tail xs) (sub at 1) v))"))));
  def bfk-jot-def() = bfk-form(list("defn", "bfk-jot", "(o k)", bfk-if(bfk-f2("le", bfk-cell("d"), "0"), "0", bfk-do(list(bfk-cell-set("j", bfk-f2("cons", "(list o k (record_get o k))", bfk-cell("j"))), bfk-cell-set("c", bfk-f2("add", bfk-cell("c"), "1"))), "0"))));
  def bfk-obj-def() = bfk-form(list("defn", "bfk-obj", "(o rows)", bfk-if("(eq (len rows) 0)", "o", bfk-do(list("(record_set o (head (head rows)) (nth (head rows) 1))"), "(bfk-obj o (tail rows))"))));
  def bfk-tab() = bfk-str(byte_to_str(9));
  def bfk-out-def() = bfk-form(list("defn", "bfk-out", "(v)", bfk-f2("str_concat", bfk-str("@bfk "), bfk-f2("str_concat", "(value_kind v)", bfk-f2("str_concat", bfk-tab(), bfk-f2("str_concat", bfk-if(bfk-unfailed(), bfk-str("0"), bfk-str("1")), bfk-f2("str_concat", bfk-tab(), "(value_str v)")))))));
  def bfk-program(cx, texts) = bfk-form(cons("do", cons(bfk-state(), append(bfk-inits(), append(list(bfk-undo-def(), bfk-list-set-def(), bfk-jot-def(), bfk-obj-def(), bfk-out-def(), bfk-strict-ok-def(), bfk-strict-trap-def(), bfk-answer-def()), append(reverse-list(record_get(cx, "defs")), append(texts, list("(bfk-out (bfk-answer (m0)))"))))))));
  // a strict store's check, its trap, and the answer a trap replaces
  def bfk-strict-ok-def() = bfk-form(list("defn", "bfk-strict-ok", "(v id)", bfk-if(bfk-f2("eq", "(value_kind v)", bfk-str("record")), bfk-f2("eq", bfk-f2("record_get", "v", bfk-str("bmlClassId")), "id"), "1")));
  def bfk-strict-trap-def() = bfk-form(list("defn", "bfk-strict-trap", "(at)", bfk-do(list(bfk-cell-set("trap", bfk-f2("str_concat", bfk-str("BML-HATI-TRAP field/strict "), "at")), bfk-cell-set("f", "1")), "0")));
  def bfk-answer-def() = bfk-form(list("defn", "bfk-answer", "(v)", bfk-if(bfk-f2("eq", bfk-cell("trap"), "0"), "v", bfk-cell("trap"))));

  // (text reasons): the program and the needs against it, read over the same
  // link, env, layout and refusal passes the table lowering reads
  def bfk-block(node) = if node_eq(node_category(node), BML-AST-BLOCK) then node else bml-ast-block(list(node));
  def bfk-compile-linked(node, units) = bfk-compile-link(bml-scope-link(bfk-block(node), units));
  def bfk-compile-link(link) {
   let main = bml-scope-link-main(link);
   let methods = bml-scope-unit-methods(main);
   let main-nodes = bml-scope-unit-mains(main);
   let symbols = bml-scope-lane-symbols(link, "hati");
   let others = tail(bml-scope-link-linked(link));
   let layout = bml-hati-unit-layout(bml-scope-layout-nodes(link), add(1, add(len(methods), bml-scope-units-method-count(others))));
   let homes = bml-scope-type-homes(link, others, symbols, layout, bml-hati-type-decls(bml-scope-unit-all-nodes(main)));
   let unit-env = bml-hati-env-with-layout(bml-scope-unit-env-with(link, main, symbols, "hati"), layout);
   // a field initializer lowers where its class lives: this unit, or the linked unit that declares the class
   let env = cons(bml-local-binding(bml-hati-class-homes-key(), list(unit-env, homes), unit-env), unit-env);
   let passes = bfk-without(append(bml-scope-link-reasons(link), append(bml-hati-unsupported-nodes-in-env(main-nodes, env), append(bml-hati-unsupported-methods-in(methods, env), bml-scope-linked-unsupported(link, others, symbols)))), "cut");
   let cx = bfk-cx();
   record_set(cx, "fns", append(bfk-fn-rows(methods, env, 1), bfk-linked-rows(link, others, symbols, add(1, len(methods)))));
   let main-text = bfk-main(cx, main-nodes, env);
   let method-texts = bfk-methods(cx, methods, env, 1);
   let other-texts = bfk-linked(cx, link, others, symbols, add(1, len(methods)));
   let decl-texts = bfk-decls(cx, layout, env, homes);
   let reasons = bml-hati-reasons-merge(append(passes, bml-hati-layout-reasons(layout)), record_get(cx, "needs"));
   list(bfk-program(cx, cons(main-text, append(method-texts, append(other-texts, decl-texts)))), reasons);
  }

  // ── the run: fkwu itself compiles and runs the program ──────────────────
  def bfk-dir(d) = if eq(str_len(d), 0) then "/tmp/" else if eq(str_byte_at(d, sub(str_len(d), 1)), 47) then d else str_concat(d, "/");
  def bfk-scratch(ext) = str_concat(bfk-dir(host_temp_dir()), str_concat("bfk-run-", str_concat(int_to_str(host_pid()), ext)));
  def bfk-run-text(text, where) {
   let src = bfk-scratch(".fk");
   let out = bfk-scratch(".out");
   let err = bfk-scratch(".err");
   write_file_text(src, text);
   let pid = host_spawn_at(list("./fkwu", src), list("/dev/null", out, err));
   let budget = bfk-budget(where);
   let ended = bfk-watch(pid, host_monotonic_ms(), 1, where, budget, if lt(budget, bfk-long-ms()) then budget else bfk-long-ms());
   host_wait(pid);
   let said = read_file(out);
   let heard = read_file(err);
   bfk-clear(list(src, out, err, bfk-scratch(".fkb"), bfk-scratch(".sym")));
   if str_eq(ended, "stop") then list(str_concat(bml-hati-refusal-prefix(0), "run/budget"), false) else bfk-decode(said, heard);
  }
  // ── a run that goes on ──────────────────────────────────────────────────
  // The run is read from outside while it runs, through fkwu's own
  // diagnostics. A run that ends within its time says nothing. One that goes
  // past it raises a reading naming the unit, how long it has run and its
  // hottest defns (a loop is one, by name), offering more time or a stop.
  // The budget is that care offer, not a wall: a source that declares
  // "Budget: N" (ms) in its head is given more time while N holds, and the
  // organ stops a run only when no more time is on offer. A stopped run
  // answers run/budget.
  def bfk-long-ms() = 2000;
  def bfk-budget(where) = if bfk-source?(where) then bfk-budget-at(read_file(where), str_find(read_file(where), "Budget: ", 0)) else bfk-long-ms();
  def bfk-source?(where) = if lt(str_len(where), 5) then false else if str_eq(substring(where, sub(str_len(where), 4), str_len(where)), ".bml") then eq(fs_exists(where), 1) else false;
  def bfk-budget-at(text, at) = if lt(at, 0) then bfk-long-ms() else bfk-budget-digits(text, add(at, 8), 0, 0);
  def bfk-budget-digits(s, i, acc, seen) = if ge(i, str_len(s)) then bfk-budget-read(acc, seen) else if bfk-digit?(str_byte_at(s, i)) then bfk-budget-digits(s, add(i, 1), add(mul(acc, 10), sub(str_byte_at(s, i), 48)), add(seen, 1)) else bfk-budget-read(acc, seen);
  def bfk-digit?(c) = if lt(c, 48) then false else le(c, 57);
  def bfk-budget-read(acc, seen) = if gt(seen, 0) then acc else bfk-long-ms();

  // "ran" when the child ended by itself, "stop" when the organ stopped it
  def bfk-watch(pid, t0, step, where, budget, next) = if eq(host_alive(pid), 1) then bfk-watch-at(pid, t0, step, where, budget, next, sub(host_monotonic_ms(), t0)) else "ran";
  def bfk-watch-at(pid, t0, step, where, budget, next, ms) = if lt(ms, next) then bfk-watch-on(pid, t0, step, where, budget, next, host_sleep_ms(step)) else bfk-watch-care(pid, t0, where, budget, ms, bfk-run-care(bfk-run-reading(where, ms, budget, value_str(kernel_page_hot(pid, 3))), if lt(ms, budget) then "extend" else "stop", pid, budget));
  def bfk-watch-on(pid, t0, step, where, budget, next, _slept) = bfk-watch(pid, t0, if lt(step, 50) then add(step, step) else 50, where, budget, next);
  def bfk-watch-care(pid, t0, where, budget, ms, chosen) = if str_eq(chosen, "stop") then "stop" else bfk-watch(pid, t0, 1, where, budget, budget);
  def bfk-run-reading(where, ms, budget, hot) = bch-reading("run", str_concat("an answer within ", str_concat(int_to_str(budget), " ms")), str_concat("running ", str_concat(int_to_str(ms), str_concat(" ms, hot: ", hot))), list(oh-need("time", json-node-object(list(oh-s("unit", where), oh-n("ran_ms", ms), oh-n("budget_ms", budget), oh-s("hot", hot))))), list("extend", "stop"), where);
  // the organ answers its own reading: more time while the budget holds,
  // else a stop; the care it applied is voiced with its result
  def bfk-run-care(reading, selected, pid, budget) {
   let response = oh-response(reading, selected);
   let chosen = oh-select(reading, response, "stop");
   let done = if str_eq(chosen, "stop") then host_kill(pid) else 0;
   oh-voice(reading);
   oh-voice(response);
   oh-voice(oh-applied(reading, chosen, json-node-object(list(oh-s("run", if str_eq(chosen, "stop") then "stopped" else "extended"), oh-n("budget_ms", budget)))));
   chosen;
  }
  def bfk-clear(paths) = if nil?(paths) then 0 else bfk-clear-then(fs_remove(head(paths)), tail(paths));
  def bfk-clear-then(_gone, rest) = bfk-clear(rest);

  // the answer line: "@bfk <kind>\t<unheld 0|1>\t<value>"
  def bfk-marker() = "@bfk ";
  def bfk-line-marker(out, from) = bfk-line-marker-at(out, str_find(out, bfk-marker(), from));
  def bfk-line-marker-at(out, at) = if lt(at, 0) then -1 else if eq(at, 0) then at else if eq(str_byte_at(out, sub(at, 1)), 10) then at else bfk-line-marker(out, add(at, 1));
  def bfk-trim-end(out) = if eq(str_len(out), 0) then 0 else if eq(str_byte_at(out, sub(str_len(out), 1)), 10) then sub(str_len(out), 1) else str_len(out);
  def bfk-decode(out, err) = bfk-decode-at(out, err, bfk-line-marker(out, 0));
  def bfk-decode-at(out, err, at) = if lt(at, 0) then list(bfk-died(out, err), false) else bfk-decode-line(substring(out, add(at, str_len(bfk-marker())), bfk-trim-end(out)));
  def bfk-decode-line(line) {
   let t1 = str_find(line, byte_to_str(9), 0);
   let t2 = str_find(line, byte_to_str(9), add(t1, 1));
   list(bfk-typed(substring(line, 0, t1), substring(line, add(t2, 1), str_len(line))), str_eq(substring(line, add(t1, 1), t2), "1"));
  }
  def bfk-typed(kind, text) = if str_eq(kind, "int") then str_to_int(text) else if str_eq(kind, "float") then str_to_float(text) else if str_eq(kind, "null") then nothing() else text;

  // a program fkwu could not run to its answer says so where it ran
  def bfk-last-line(text) = substring(text, add(bfk-nl-before(text, sub(bfk-trim-end(text), 1)), 1), bfk-trim-end(text));
  def bfk-nl-before(s, i) = if lt(i, 0) then -1 else if eq(str_byte_at(s, i), 10) then i else bfk-nl-before(s, sub(i, 1));
  // the child's first error line when it has one, else its last line
  def bfk-first-error(err) = bfk-first-error-at(err, str_find(err, "error:", 0));
  def bfk-first-error-at(err, at) = if lt(at, 0) then "" else substring(err, add(bfk-nl-before(err, at), 1), bfk-line-stop(err, at));
  def bfk-line-stop(s, i) = if ge(i, str_len(s)) then i else if eq(str_byte_at(s, i), 10) then i else bfk-line-stop(s, add(i, 1));
  def bfk-died(out, err) {
   let said = if eq(str_len(bfk-first-error(err)), 0) then bfk-last-line(str_concat(out, err)) else bfk-first-error(err);
   oh-voice(bch-reading("run", "value", str_concat("died:", said), list(oh-need("runtime", json-node-string(said))), list("abstain", "request-evidence"), "form-run"));
   str_concat("BML-FORM-DIED ", said);
  }

  def bfk-run-linked-at(where, node, units) = bml-run-heard(where, "form", bfk-outcome(bfk-compile-linked(node, units), where));
  def bfk-outcome(image, where) = bfk-outcome-with(nth(image, 0), bch-admit("form-image", nth(image, 1)), where);
  def bfk-outcome-with(text, reasons, where) = if nil?(reasons) then bfk-run-text(text, where) else list(str_concat(bml-hati-refusal-prefix(0), bml-hati-unsupported-reasons-text(reasons)), false);

  // One source on the native path. Its imports and Units: are cared for
  // once, the linked units run on fkwu itself, and an answer the lowering
  // could not give says so where it ran. where names the unit a run's
  // readings carry: a door passes its path.
  def bml-run-unit-value(node, units) = bml-run-unit-value-at("unit", node, units);
  def bml-run-unit-value-at(where, node, units) = bch-ran("form", bfk-run-linked-at(where, node, bml-scope-care-imports(node, units)));
 }
 0;
}
