// bml-form-lower.bml — the BML native compiler's run step on fkwu itself.
//
// A parsed, linked BML unit lowers into Form defns. Each method is one defn over
// its own parameters. Each mutable local is one Form name per assignment, found
// through the slot key grammars/bml.fk's scope reading gives its binding. A
// construct that carries locals out of it answers them as one tuple beside its
// value. The run's shared state -- the control mode, the returned and thrown
// values, FAILED and the field journal -- lives in one record the program owns.
// fkwu compiles the defns, runs them on its own evaluator and JIT, and prints
// one answer line; no recipe walker reads the program.
//
// The scope, the overload choice and the class layout are grammars/bml.fk's own
// readings; this unit reads them and writes Form.
//
// preludes: form-stdlib/core.fk form-stdlib/minimal-surface.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/engine.fk form-stdlib/compiler.fk form-stdlib/source-compiler.fk form-stdlib/hati-os-kernel.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/grammars/bml.fk
section [form.bml] {
 class BmlFormLower {

  // ── Form text ─────────────────────────────────────────────────────────
  def bfk-q() = byte_to_str(34);
  def bfk-join(xs) = nil?(xs) ? "" : nil?(tail(xs)) ? head(xs) : head(xs) ++ " " ++ bfk-join(tail(xs));
  def bfk-form(xs) = "(" ++ bfk-join(xs) ++ ")";
  def bfk-f1(h, a) = bfk-form(list(h, a));
  def bfk-f2(h, a, b) = bfk-form(list(h, a, b));
  def bfk-f3(h, a, b, c) = bfk-form(list(h, a, b, c));
  def bfk-let(v, e) = bfk-f2("let", v, e);
  def bfk-do(items, last) = nil?(items) ? last : bfk-form(cons("do", append(items, list(last))));
  def bfk-int(n) = int_to_str(n);
  def bfk-special?(c) = ((Comparable) c == 34) || (((Comparable) c == 92) || (((Comparable) c == 10) || (((Comparable) c == 9) || ((Comparable) c == 13))));
  def bfk-plain?(s, i, n) = i >= n ? true : bfk-special?(str_byte_at(s, i)) ? false : bfk-plain?(s, i + 1, n);
  def bfk-esc-byte(c) = (Comparable) c == 34 ? "\\\"" : (Comparable) c == 92 ? "\\\\" : (Comparable) c == 10 ? "\\n" : (Comparable) c == 9 ? "\\t" : (Comparable) c == 13 ? "\\r" : byte_to_str(c);
  def bfk-esc(s, i, n) = i >= n ? "" : bfk-esc-byte(str_byte_at(s, i)) ++ bfk-esc(s, i + 1, n);
  def bfk-str(s) = bfk-q() ++ (bfk-plain?(s, 0, str_len(s)) ? s : bfk-esc(s, 0, str_len(s))) ++ bfk-q();
  def bfk-if(c, t, e) = bfk-f3("if", c, t, e);
  def bfk-plus(cx, node, env, vm) {
   let l = bfk-expr(cx, bml-node-child(node, 0), env, vm);
   let r = bfk-expr(cx, bml-node-child(node, 1), env, vm);
   let text = bfk-f2("eq", bfk-f1("value_kind", "__bml_r"), bfk-str("string"));
   let nums = bfk-f2("add", "__bml_l", "__bml_r");
   let joined = bfk-f2("str_concat", "__bml_l", "__bml_r");
   let pick = bfk-if(bfk-f2("eq", bfk-f1("value_kind", "__bml_l"), bfk-str("string")), bfk-if(text, joined, nums), nums);
   bfk-f3("let", "__bml_l", l, bfk-f3("let", "__bml_r", r, pick));
  }

  // ── the run's state: one record the program owns ───────────────────────
  // m the control mode, v a returned value, t a thrown value, f FAILED,
  // j the field journal, c its count, d how many snapshots are open
  def bfk-cell(k) = bfk-form(list("record_get", "BFK", bfk-str(k)));
  def bfk-cell-set(k, e) = bfk-form(list("record_set", "BFK", bfk-str(k), e));
  def bfk-unfailed() = bfk-f2("le", bfk-cell("f"), "0");
  def bfk-mode-ok() = bfk-f2("le", bfk-cell("m"), "0");
  def bfk-mode-is(m) = bfk-f2("eq", bfk-cell("m"), bfk-int(m));
  def bfk-set-mode(m) = bfk-cell-set("m", bfk-int(m));

  // ── the lowering's own state ───────────────────────────────────────────
  def bfk-cx() {
   let cx = record_new(0);
   record_set(cx, "n", 0);
   record_set(cx, "defs", empty);
   record_set(cx, "needs", empty);
   cx;
  }
  def bfk-fresh(cx, stem) = bfk-fresh-at(cx, stem, record_get(cx, "n") + 1);
  def bfk-fresh-at(cx, stem, n) {
   record_set(cx, "n", n);
   stem ++ int_to_str(n);
  }
  def bfk-add-def(cx, text) = record_set(cx, "defs", cons(text, record_get(cx, "defs")));
  // a need the lowering meets is voiced where it is met and withholds the program
  def bfk-need-add(cx, reason) {
   record_set(cx, "needs", append(record_get(cx, "needs"), list(reason)));
   "0";
  }
  def bfk-need(cx, reason) = bfk-need-add(cx, bml-voice-then(bml-refusal-reading("form-lowering", reason), reason));
  def bfk-need-name(cx, reason, name) = bfk-need-add(cx, bml-voice-then(bml-name-reading("form-lowering", reason, name), reason));

  // ── names: a binding's slot key -> the Form name holding its value now ─
  def bfk-vm-get(vm, key) = nil?(vm) ? "" : (String) head(head(vm)) == key ? head(vm)[1] : bfk-vm-get(tail(vm), key);
  def bfk-vm-put(vm, key, v) = cons(list(key, v), vm);
  def bfk-vm-or0(vm, key) = (String) bfk-vm-get(vm, key) == "" ? "0" : bfk-vm-get(vm, key);
  def bfk-vm-has?(vm, key) = !((String) bfk-vm-get(vm, key) == "");
  def bfk-vm-vars(vm, keys) = nil?(keys) ? empty : cons(bfk-vm-or0(vm, head(keys)), bfk-vm-vars(vm, tail(keys)));
  def bfk-vm-keys(vm, seen) = nil?(vm) ? reverse-list(seen) : fsc-string-list-contains?(seen, head(head(vm))) ? bfk-vm-keys(tail(vm), seen) : bfk-vm-keys(tail(vm), cons(head(head(vm)), seen));
  def bfk-top(vm) = bfk-vm-or0(vm, "__top");

  // A statement lowers to (items vm value): the let forms it adds, the names
  // after it, and the Form text of its value.
  def bfk-r(items, vm, val) = list(items, vm, val);
  def bfk-r-items(r) = r[0];
  def bfk-r-vm(r) = r[1];
  def bfk-r-val(r) = r[2];
  def bfk-r-expr(r) = bfk-do(bfk-r-items(r), bfk-r-val(r));
  def bfk-value-stmt(cx, expr, vm) {
   let v = bfk-fresh(cx, "v");
   bfk-r(list(bfk-let(v, expr)), vm, v);
  }

  // The names a construct carries out: every slot its env-after names, and
  // the standing value and the snapshot stack while the body keeps them.
  def bfk-out-keys(env-after, vm) = append(bml-bnml-snapshot-keys(env-after, empty), bfk-extra-keys(vm));
  def bfk-extra-keys(vm) = append(bfk-vm-has?(vm, "__top") ? list("__top") : empty, bfk-vm-has?(vm, "__marks") ? list("__marks") : empty);
  def bfk-tuple(val, vm, keys) = nil?(keys) ? val : bfk-form(cons("list", cons(val, bfk-vm-vars(vm, keys))));
  def bfk-untuple(cx, expr, keys, vm) = nil?(keys) ? bfk-value-stmt(cx, expr, vm) : bfk-untuple-many(cx, expr, keys, vm);
  def bfk-untuple-many(cx, expr, keys, vm) {
   let r = bfk-fresh(cx, "r");
   let val = bfk-fresh(cx, "v");
   let rest = bfk-untuple-keys(cx, r, keys, 1, vm, empty);
   bfk-r(cons(bfk-let(r, expr), cons(bfk-let(val, bfk-f2("nth", r, "0")), bfk-r-items(rest))), bfk-r-vm(rest), val);
  }
  def bfk-untuple-keys(cx, r, keys, i, vm, items) = nil?(keys) ? bfk-r(reverse-list(items), vm, "0") : bfk-untuple-key(cx, r, keys, i, vm, items, bfk-fresh(cx, "v"));
  def bfk-untuple-key(cx, r, keys, i, vm, items, v) = bfk-untuple-keys(cx, r, tail(keys), i + 1, bfk-vm-put(vm, head(keys), v), cons(bfk-let(v, bfk-f2("nth", r, bfk-int(i))), items));

  // ── blocks ──────────────────────────────────────────────────────────────
  // grammars/bml.fk's nodes-in-env: a list that bears control runs as a
  // control body, any other list statement by statement
  def bfk-nodes(cx, nodes, env, vm, outk) = bml-ctl-function-entry?(nodes, env) ? bfk-ctl-function(cx, nodes, env, vm, outk) : bfk-plain(cx, nodes, env, vm, outk, "0");

  // a statement that may stop guards the ones after it; a stopped list
  // answers the value it stood on
  def bfk-plain(cx, nodes, env, vm, outk, val) = nil?(nodes) ? bfk-tuple(val, vm, outk) : bfk-plain-then(cx, nodes, env, bfk-stmt(cx, head(nodes), env, vm), outk);
  def bfk-plain-then(cx, nodes, env, r, outk) {
   let rest = bfk-plain(cx, tail(nodes), bml-local-env-after-node(head(nodes), env), bfk-r-vm(r), outk, bfk-r-val(r));
   let stops = nil?(tail(nodes)) ? false : bml-bnml-may-stop?(head(nodes), env) ? bfk-can-fail?(cx, head(nodes), env) : false;
   bfk-do(bfk-r-items(r), stops ? bfk-if(bfk-unfailed(), rest, bfk-tuple(bfk-top(bfk-r-vm(r)), bfk-r-vm(r), outk)) : rest);
  }

  // ── statements ──────────────────────────────────────────────────────────
  def bfk-stmt(cx, node, env, vm) = bml-ctl-expr-node?(node) ? bfk-value-stmt(cx, bfk-reserved(cx, node, env, vm), vm) : bml-ctl-statement-node?(node) ? bfk-lone-control(cx, node, env, vm) : bfk-stmt-core(cx, node, env, vm);
  def bfk-lone-control(cx, node, env, vm) = bml-ctl-env-active?(env) ? bfk-value-stmt(cx, bfk-need(cx, "control/nested"), vm) : bfk-sub(cx, list(node), env, vm, bfk-out-keys(bml-local-env-after-node(node, env), vm));
  def bfk-sub(cx, nodes, env, vm, keys) = bfk-untuple(cx, bfk-nodes(cx, nodes, env, vm, keys), keys, vm);

  def bfk-stmt-core(cx, node, env, vm) {
   let cat = node_category(node);
   node_eq(cat, BML-AST-CALL) ? bfk-call-stmt(cx, node, env, vm) : node_eq(cat, BML-AST-BLOCK) ? bfk-sub(cx, node_children(node), env, vm, bfk-out-keys(bml-local-env-after-node(node, env), vm)) : node_eq(cat, BML-AST-CONST) ? bfk-const-stmt(cx, node, env, vm) : node_eq(cat, BML-AST-CHOOSE) ? bfk-choose-stmt(cx, node, env, vm) : node_eq(cat, BML-AST-FAIL) ? bfk-fail-stmt(cx, env, vm) : node_eq(cat, BML-AST-SAVE) ? bfk-save-stmt(cx, env, vm) : node_eq(cat, BML-AST-RESTORE) ? bfk-restore-stmt(cx, env, vm) : node_eq(cat, BML-AST-DISCARD) ? bfk-discard-stmt(cx, env, vm) : node_eq(cat, BML-AST-CUT) ? bfk-cut-stmt(env, vm) : bfk-value-stmt(cx, bfk-expr-core(cx, node, env, vm), vm);
  }

  def bfk-call-stmt(cx, node, env, vm) = bfk-class-shaped?(node, env) ? bfk-value-stmt(cx, bfk-class-call(cx, node, env, vm), vm) : bml-bnml-top-node?(node) ? bfk-top-stmt(cx, node, env, vm) : bml-bnml-declare-node?(node) ? bfk-store(cx, bml-bnml-new-key(bml-bnml-target-name(node), env), bml-bnml-value(node), env, vm) : bml-bnml-assign-node?(node) ? bfk-store(cx, bml-bnml-assign-key(node, env), bml-bnml-value(node), env, vm) : bfk-value-stmt(cx, bfk-call-expr(cx, node, env, vm), vm);

  // a store answers the value it stored
  def bfk-store(cx, key, value-node, env, vm) {
   let v = bfk-fresh(cx, "v");
   bfk-r(list(bfk-let(v, bfk-expr(cx, value-node, env, vm))), bfk-vm-put(vm, key, v), v);
  }

  // a statement's value becomes the standing value only if it ran to the end
  // a statement that cannot fail stands on its own value: no FAILED to ask,
  // and no second name for the value it already has
  def bfk-top-stmt(cx, node, env, vm) = bfk-top-keep(cx, bfk-stmt(cx, head(bml-call-args(node)), env, vm), bfk-can-fail?(cx, head(bml-call-args(node)), env));
  def bfk-top-keep(cx, r, fails) = fails ? bfk-top-held(cx, r) : bfk-r(bfk-r-items(r), bfk-vm-put(bfk-r-vm(r), "__top", bfk-r-val(r)), bfk-r-val(r));
  def bfk-top-held(cx, r) {
   let t = bfk-fresh(cx, "t");
   bfk-r(append(bfk-r-items(r), list(bfk-let(t, bfk-if(bfk-unfailed(), bfk-r-val(r), bfk-top(bfk-r-vm(r)))))), bfk-vm-put(bfk-r-vm(r), "__top", t), t);
  }

  def bfk-const-stmt(cx, node, env, vm) = bml-bnml-reads-mutable?(bml-local-const-value(node), env) ? bfk-store(cx, bml-bnml-new-key(bml-local-const-name(node), env), bml-local-const-value(node), env, vm) : bfk-value-stmt(cx, bfk-expr(cx, bml-local-const-value(node), env, vm), vm);

  // a choose no branch of which assigns or fails partway runs its first branch that is not a bare fail
  def bfk-choose-stmt(cx, node, env, vm) = bml-bnml-choose-tracks?(node) ? bfk-choose-track(cx, node, env, vm) : bfk-choose-first(cx, node_children(node), env, vm);
  def bfk-choose-first(cx, branches, env, vm) = nil?(branches) ? bfk-value-stmt(cx, "0", vm) : bml-hati-node-fail?(head(branches)) ? bfk-choose-first(cx, tail(branches), env, vm) : bfk-stmt(cx, head(branches), env, vm);

  // ── expressions ─────────────────────────────────────────────────────────
  def bfk-expr(cx, node, env, vm) = bml-ctl-expr-node?(node) ? bfk-reserved(cx, node, env, vm) : bml-ctl-statement-node?(node) ? bfk-r-val(bfk-lone-control(cx, node, env, vm)) : bfk-expr-core(cx, node, env, vm);
  def bfk-exprs(cx, nodes, env, vm) = nil?(nodes) ? empty : cons(bfk-expr(cx, head(nodes), env, vm), bfk-exprs(cx, tail(nodes), env, vm));

  def bfk-expr-core(cx, node, env, vm) {
   let cat = node_category(node);
   node_eq(cat, BML-AST-INT) ? bfk-int(node_value(bml-node-child(node, 0))) : node_eq(cat, BML-AST-FLOAT) ? bfk-f2("mul", bfk-int(bml-hati-float-micros(bml-node-child(node, 0))), bml-hati-float-scale-literal()) : node_eq(cat, BML-AST-STRING) ? bfk-str(node_value(bml-node-child(node, 0))) : node_eq(cat, BML-AST-CHAR) ? bfk-str(node_value(bml-node-child(node, 0))) : node_eq(cat, BML-AST-ARRAY) ? bfk-form(cons("list", bfk-exprs(cx, node_children(node), env, vm))) : node_eq(cat, BML-AST-ADD) ? bfk-plus(cx, node, env, vm) : node_eq(cat, BML-AST-CONST) ? bfk-expr(cx, bml-local-const-value(node), env, vm) : node_eq(cat, BML-AST-NAME) ? bfk-name(cx, node, env, vm) : node_eq(cat, BML-AST-CALL) ? bfk-call-expr(cx, node, env, vm) : node_eq(cat, BML-AST-RETURN) ? bfk-expr(cx, bml-node-child(node, 0), env, vm) : node_eq(cat, BML-AST-BLOCK) ? bfk-nodes(cx, node_children(node), env, vm, empty) : node_eq(cat, BML-AST-METHOD) ? bfk-need(cx, "form/nested-method") : bfk-stmt-only?(cat) ? bfk-r-expr(bfk-stmt-core(cx, node, env, vm)) : "0";
  }
  def bfk-stmt-only?(cat) = node_eq(cat, BML-AST-CHOOSE) || (node_eq(cat, BML-AST-FAIL) || (node_eq(cat, BML-AST-SAVE) || (node_eq(cat, BML-AST-RESTORE) || node_eq(cat, BML-AST-DISCARD))));

  // the operators BML's own rules name; each answers 1 or 0 where it compares
  def bfk-reserved(cx, node, env, vm) = bml-ctl-thrown-node?(node) ? bfk-cell("t") : bml-ctl-with-access?(node) ? bfk-with-access(cx, node, env, vm) : bml-ctl-known-op?(node) ? bfk-op(bml-ctl-op-rule-of(node), bfk-exprs(cx, bml-call-args(node), env, vm)) : bfk-need(cx, "op/unknown");
  def bfk-op(rule, args) = nil?(tail(args)) ? bfk-op1(rule, head(args)) : bfk-op2(rule, head(args), args[1]);
  def bfk-op1(rule, a) = (String) rule == "op-not" ? bfk-if(bfk-f2("eq", a, "0"), "1", "0") : bfk-f2("sub", "0", a);
  def bfk-op2(rule, a, b) = (String) rule == "op-lt" ? bfk-f2("lt", a, b) : (String) rule == "op-le" ? bfk-f2("le", a, b) : (String) rule == "op-gt" ? bfk-f2("gt", a, b) : (String) rule == "op-ge" ? bfk-f2("ge", a, b) : (String) rule == "op-eq" ? bfk-if(bfk-f2("value_eq", a, b), "1", "0") : (String) rule == "op-ne" ? bfk-if(bfk-f2("value_eq", a, b), "0", "1") : (String) rule == "op-and" ? bfk-if(bfk-f2("eq", a, "0"), "0", bfk-if(bfk-f2("eq", b, "0"), "0", "1")) : (String) rule == "op-or" ? bfk-if(bfk-f2("eq", a, "0"), bfk-if(bfk-f2("eq", b, "0"), "0", "1"), "1") : (String) rule == "op-sub" ? bfk-f2("sub", a, b) : bfk-f2("mul", a, b);

  def bfk-name(cx, node, env, vm) = bml-hati-receiver-name?(bml-local-name(node), env) ? bfk-class-name(cx, node, env, vm) : bfk-name-binding(cx, node, env, vm, bml-local-lookup(env, bml-local-name(node)));
  def bfk-name-binding(cx, node, env, vm, binding) = bml-bnml-binding?(binding) ? bfk-vm-or0(vm, bml-local-binding-key(binding)) : nil?(binding) ? bfk-need-name(cx, "name/unbound", bml-local-name(node)) : bml-hati-arg-node?(bml-local-binding-value(binding)) ? bfk-vm-or0(vm, "@a") : bml-hati-method-ref?(bml-local-binding-value(binding)) ? bfk-need(cx, "name/method") : bfk-expr(cx, bml-local-binding-value(binding), bml-local-binding-env(binding), vm);

  def bfk-call-expr(cx, node, env, vm) = bfk-class-shaped?(node, env) ? bfk-class-call(cx, node, env, vm) : bml-bnml-top-node?(node) ? bfk-expr(cx, head(bml-call-args(node)), env, vm) : bml-bnml-declare-node?(node) || bml-bnml-assign-node?(node) ? bfk-need(cx, "form/store-in-expression") : bml-index-node?(node) ? bfk-f2("nth", bfk-expr(cx, bml-index-target(node), env, vm), bfk-expr(cx, bml-index-at(node), env, vm)) : bml-list-set-node?(node) ? bfk-f3("bfk-list-set", bfk-expr(cx, bml-index-target(node), env, vm), bfk-expr(cx, bml-index-at(node), env, vm), bfk-expr(cx, bml-list-set-value(node), env, vm)) : bml-hati-arg-node?(node) ? bfk-vm-or0(vm, "@a") : bml-hati-arg-at-node?(node) ? bfk-vm-or0(vm, "@a" ++ int_to_str(bml-hati-arg-at-index(node))) : bfk-free-call(cx, node, env, vm, bml-local-lookup(env, bml-call-name(node)));

  def bfk-free-call(cx, node, env, vm, binding) = nil?(binding) ? bfk-need-name(cx, bml-scope-unbound-call-reason(env, bml-call-name(node)), bml-call-name(node)) : bml-hati-method-ref?(bml-local-binding-value(binding)) ? bfk-chosen-call(cx, node, env, vm, bml-hati-free-call-choice(env, bml-call-name(node), bml-call-args(node))) : bfk-need(cx, "call/not-method");
  def bfk-chosen-call(cx, node, env, vm, choice) = bml-hati-choice-ok?(choice) ? bfk-ref-call(cx, node, env, vm, bml-local-binding-value(bml-hati-choice-value(choice))) : bfk-need(cx, bml-hati-choice-value(choice));
  def bfk-ref-call(cx, node, env, vm, ref) = bfk-form(cons(bfk-fn-name(bml-hati-method-ref-index(ref)), bfk-call-args(cx, node, env, vm, bml-hati-method-ref-arity(ref))));
  def bfk-call-args(cx, node, env, vm, arity) = (Comparable) arity == 0 ? empty : (Comparable) arity == 1 ? list(bfk-expr(cx, head(bml-call-args(node)), env, vm)) : bfk-exprs(cx, bml-call-args(node), env, vm);
  def bfk-fn-name(index) = "m" ++ int_to_str(index);

  // ── control ─────────────────────────────────────────────────────────────
  // grammars/bml.fk's control lowering, over value names: a transfer sets
  // the mode, the statements after one that may change it run while it is
  // 0, a loop is one tail-recursive defn over the names in scope, and the
  // epilogue turns RETURN into the function's value and hands THROW outward.
  def bfk-mode-in(modes) = nil?(modes) ? "0" : bfk-if(bfk-mode-is(head(modes)), "1", bfk-mode-in(tail(modes)));
  def bfk-mode-zero() = bfk-f2("eq", bfk-cell("m"), "0");

  // a body that keeps the value it stands on writes it at each plain
  // statement, and a failure that stopped the body answers it
  def bfk-ctl-function(cx, nodes, env, vm, outk) {
   let standing = bml-bnml-keeps-standing?(nodes, env);
   let keys = standing ? bfk-with-key(outk, "__top") : outk;
   let r = bfk-untuple(cx, bfk-ctl-stmts(cx, nodes, bml-ctl-env-standing(bml-ctl-env-active(env), standing), vm, keys, bml-ctl-ctx(empty), "0"), keys, vm);
   let e = bfk-fresh(cx, "v");
   bfk-do(append(bfk-r-items(r), list(bfk-let(e, bfk-epilogue(standing, bfk-r-vm(r))))), bfk-tuple(e, bfk-r-vm(r), outk));
  }
  def bfk-with-key(keys, key) = fsc-string-list-contains?(keys, key) ? keys : append(keys, list(key));
  def bfk-epilogue(standing, vm) = standing ? bfk-if(bfk-unfailed(), bfk-epi(), bfk-do(list(bfk-set-mode(0)), bfk-top(vm))) : bfk-epi();
  def bfk-epi() = bfk-if(bfk-mode-is(bml-ctl-return-mode(0)), bfk-do(list(bfk-set-mode(0)), bfk-cell("v")), bfk-if(bfk-mode-is(bml-ctl-throw-mode(0)), bfk-cell("t"), "0"));

  // a statement that cannot change the mode needs no guard after it: it holds
  // no transfer, no fail, and no call but to a quiet method
  def bfk-mode-quiet?(cx, node, env) = bml-bnml-fails-inside?(node) ? false : bfk-holds-transfer?(node) ? false : bfk-quiet-calls?(cx, node, env);
  // a statement that can set FAILED: it holds a fail or a call a failure can come back through
  def bfk-can-fail?(cx, node, env) = bml-bnml-fails-inside?(node) ? true : (!bfk-quiet-calls?(cx, node, env));

  // ── a callee's reach ────────────────────────────────────────────────────
  // A method is quiet when it can never throw or fail: it holds no throw and
  // no fail, and every call it makes is a free call whose every candidate is
  // quiet. A return never leaves its callee; the callee's epilogue takes it.
  // A class call is not read here yet, so it counts as one that can.
  def bfk-fn-rows(methods, env, index) = nil?(methods) ? empty : cons(list(index, head(methods), env), bfk-fn-rows(tail(methods), env, index + 1));
  def bfk-linked-rows(link, units, symbols, index) = nil?(units) ? empty : append(bfk-fn-rows(bml-scope-unit-methods(head(units)), bml-scope-unit-env-with(link, head(units), symbols, "hati"), index), bfk-linked-rows(link, tail(units), symbols, index + len(bml-scope-unit-methods(head(units)))));
  def bfk-fn-row(rows, index) = nil?(rows) ? empty : (Comparable) head(head(rows)) == index ? head(rows) : bfk-fn-row(tail(rows), index);
  def bfk-quiet-fn?(cx, index) = bfk-quiet-memo(cx, index, record_get(cx, "q" ++ int_to_str(index)));
  def bfk-quiet-memo(cx, index, held) = (Comparable) held == 1 ? true : (Comparable) held == 3 ? true : (Comparable) held == 2 ? false : bfk-quiet-row(cx, index, bfk-fn-row(record_get(cx, "fns"), index));
  def bfk-quiet-row(cx, index, row) = nil?(row) ? false : bfk-quiet-analyze(cx, index, row);
  def bfk-quiet-analyze(cx, index, row) {
   record_set(cx, "q" ++ int_to_str(index), 3);
   let quiet = bfk-quiet-body?(cx, bml-method-node-body(row[1]), bml-hati-method-param-env(row[1], row[2]));
   record_set(cx, "q" ++ int_to_str(index), quiet ? 1 : 2);
   quiet;
  }
  def bfk-quiet-body?(cx, node, env) = bml-bnml-fails-inside?(node) ? false : bfk-holds-throw?(node) ? false : bfk-quiet-calls?(cx, node, env);
  def bfk-holds-throw?(node) = (Comparable) len(node_children(node)) == 0 ? false : node_eq(node_category(node), BML-AST-THROW) ? true : node_eq(node_category(node), BML-AST-METHOD) ? false : bfk-any-throw?(node_children(node));
  def bfk-any-throw?(nodes) = nil?(nodes) ? false : bfk-holds-throw?(head(nodes)) ? true : bfk-any-throw?(tail(nodes));
  def bfk-quiet-calls?(cx, node, env) = (Comparable) len(node_children(node)) == 0 ? true : bml-bnml-user-call?(node) ? bfk-quiet-call-then?(cx, node, env, bfk-quiet-call?(cx, node, env)) : node_eq(node_category(node), BML-AST-METHOD) ? true : bfk-all-quiet-calls?(cx, node_children(node), env);
  def bfk-quiet-call-then?(cx, node, env, quiet) = quiet ? bfk-all-quiet-calls?(cx, node_children(node), env) : false;
  def bfk-all-quiet-calls?(cx, nodes, env) = nil?(nodes) ? true : bfk-quiet-calls?(cx, head(nodes), env) ? bfk-all-quiet-calls?(cx, tail(nodes), env) : false;
  def bfk-quiet-call?(cx, node, env) = bml-hati-class-call?(node) ? false : bfk-class-shaped?(node, env) ? false : bfk-quiet-candidates?(cx, append(bfk-callee-indices(env, bml-call-name(node)), bfk-callee-indices(env, bml-scope-resolve-name(env, bml-call-name(node)))));
  def bfk-quiet-candidates?(cx, indices) = nil?(indices) ? false : bfk-all-quiet-fns?(cx, indices);
  def bfk-all-quiet-fns?(cx, indices) = nil?(indices) ? true : bfk-quiet-fn?(cx, head(indices)) ? bfk-all-quiet-fns?(cx, tail(indices)) : false;
  def bfk-callee-indices(env, name) = nil?(env) ? empty : bfk-method-named?(head(env), name) ? cons(bml-hati-method-ref-index(bml-local-binding-value(head(env))), bfk-callee-indices(tail(env), name)) : bfk-callee-indices(tail(env), name);
  def bfk-method-named?(binding, name) = (String) bml-local-binding-name(binding) == name ? bml-hati-method-ref?(bml-local-binding-value(binding)) : false;
  def bfk-holds-transfer?(node) = (Comparable) len(node_children(node)) == 0 ? false : bml-ctl-effect-node?(node) ? true : node_eq(node_category(node), BML-AST-METHOD) ? false : bfk-any-transfer?(node_children(node));
  def bfk-any-transfer?(nodes) = nil?(nodes) ? false : bfk-holds-transfer?(head(nodes)) ? true : bfk-any-transfer?(tail(nodes));

  // statements of a control body; a guarded-out rest answers 0
  def bfk-ctl-stmts(cx, nodes, env, vm, outk, ctx, val) = nil?(nodes) ? bfk-tuple(val, vm, outk) : bfk-ctl-then(cx, nodes, env, outk, ctx, bfk-ctl-stmt(cx, head(nodes), env, vm, ctx));
  def bfk-ctl-then(cx, nodes, env, outk, ctx, r) {
   let rest = bfk-ctl-stmts(cx, tail(nodes), bml-ctl-env-after(head(nodes), env), bfk-r-vm(r), outk, ctx, bfk-r-val(r));
   let stop = bfk-tuple("0", bfk-r-vm(r), outk);
   let stops = bml-bnml-may-stop?(head(nodes), env) ? bfk-can-fail?(cx, head(nodes), env) : false;
   let held = stops ? bfk-if(bfk-unfailed(), rest, stop) : rest;
   bfk-do(bfk-r-items(r), nil?(tail(nodes)) ? rest : bfk-mode-quiet?(cx, head(nodes), env) && (!stops) ? rest : bfk-if(bfk-mode-ok(), held, stop));
  }
  def bfk-ctl-block(cx, node, env, vm, outk, ctx) = bfk-ctl-stmts(cx, node_eq(node_category(node), BML-AST-BLOCK) ? node_children(node) : list(node), env, vm, outk, ctx, "0");

  // a parameter the statement assigns becomes a frame local just before it
  def bfk-ctl-stmt(cx, node, env, vm, ctx) = bfk-ctl-promote(cx, bml-ctl-promoted(node, env), node, env, vm, ctx, empty);
  def bfk-ctl-promote(cx, promos, node, env, vm, ctx, items) = nil?(promos) ? bfk-r-prefix(items, bfk-ctl-stmt-in(cx, node, env, vm, ctx)) : bfk-ctl-promote-one(cx, promos, node, env, ctx, items, bfk-ctl-stmt-in(cx, head(promos), env, vm, ctx));
  def bfk-ctl-promote-one(cx, promos, node, env, ctx, items, r) = bfk-ctl-promote(cx, tail(promos), node, bml-ctl-env-after(head(promos), env), bfk-r-vm(r), ctx, append(items, bfk-r-items(r)));
  def bfk-r-prefix(items, r) = bfk-r(append(items, bfk-r-items(r)), bfk-r-vm(r), bfk-r-val(r));

  def bfk-ctl-stmt-in(cx, node, env, vm, ctx) = nil?(node_children(node)) ? bfk-ctl-standing(cx, node, env, vm) : bfk-ctl-shape(cx, node, env, vm, ctx, bfk-edge(node, env));
  def bfk-edge(node, env) = bml-ctl-statement-node?(node) ? bml-bnml-edge-check("control", node, env) : 0;
  def bfk-ctl-shape(cx, node, env, vm, ctx, _heard) {
   let cat = node_category(node);
   node_eq(cat, BML-AST-BLOCK) ? bfk-ctl-compound(cx, node, env, vm, ctx) : node_eq(cat, BML-AST-IF) ? bfk-ctl-if(cx, node, env, vm, ctx) : bml-ctl-while-node?(node) ? bfk-ctl-loop-pick(cx, node, bml-ctl-while-parts(node), env, vm, ctx) : node_eq(cat, BML-AST-FOR) ? bfk-ctl-loop-pick(cx, node, bml-ctl-for-parts(node), env, vm, ctx) : bml-ctl-switch-node?(node) ? bfk-ctl-switch(cx, node, env, vm, ctx) : bml-ctl-effect-node?(node) ? bfk-ctl-effect(cx, bml-ctl-node-effect(node), env, vm, ctx) : node_eq(cat, BML-AST-TRY) ? bfk-ctl-try(cx, node, env, vm, ctx) : node_eq(cat, BML-AST-WITH) ? bfk-ctl-compound(cx, node, env, vm, ctx) : node_eq(cat, BML-AST-METHOD) ? bfk-value-stmt(cx, bfk-need(cx, "control/nested-method"), vm) : bfk-ctl-standing(cx, node, env, vm);
  }
  def bfk-ctl-standing(cx, node, env, vm) = bfk-stmt(cx, bml-ctl-standing?(env) ? bml-bnml-top-rewrite(node) : node, env, vm);

  // a block (or a with) runs its statements; what it assigns rides out
  def bfk-ctl-compound(cx, node, env, vm, ctx) {
   let outk = bfk-out-keys(bml-ctl-env-after(node, env), vm);
   bfk-untuple(cx, bfk-ctl-stmts(cx, node_children(node), env, vm, outk, ctx, "0"), outk, vm);
  }

  // BML's truth: a condition holds when its value is not 0
  def bfk-cond(cx, node, env, vm) = bfk-compare?(node) ? bfk-reserved(cx, node, env, vm) : bfk-f2("ne", bfk-expr(cx, node, env, vm), "0");
  def bfk-compare?(node) = bml-ctl-op-node?(node) ? fsc-string-list-contains?(list("op-lt", "op-le", "op-gt", "op-ge"), bml-ctl-op-rule-of(node)) : false;

  def bfk-ctl-if(cx, node, env, vm, ctx) {
   let outk = bfk-out-keys(bml-ctl-env-after(node, env), vm);
   let test = bfk-cond(cx, bml-node-child(node, 0), env, vm);
   let yes = bfk-ctl-block(cx, bml-node-child(node, 1), env, vm, outk, ctx);
   let no = bfk-ctl-block(cx, bml-ctl-child-or-block(node, 2), env, vm, outk, ctx);
   let hold = !bfk-mode-quiet?(cx, bml-node-child(node, 0), env);
   bfk-untuple(cx, bfk-if(test, bfk-ctl-guard(hold, yes, vm, outk), bfk-ctl-guard(hold, no, vm, outk)), outk, vm);
  }
  def bfk-ctl-guard(hold, text, vm, outk) = hold ? bfk-if(bfk-mode-ok(), text, bfk-tuple("0", vm, outk)) : text;

  // init; one defn over every name in scope: while the test holds, the body,
  // then the step on the modes a loop takes its next pass after; exit
  // consumes this target's own break
  def bfk-local-keys(keys) = nil?(keys) ? empty : (Comparable) str_find(head(keys), "@", 0) == 0 ? bfk-local-keys(tail(keys)) : cons(head(keys), bfk-local-keys(tail(keys)));
  def bfk-fresh-names(cx, keys) = nil?(keys) ? empty : cons(bfk-fresh(cx, "p"), bfk-fresh-names(cx, tail(keys)));
  def bfk-vm-bind(vm, keys, names) = nil?(keys) ? vm : bfk-vm-bind(bfk-vm-put(vm, head(keys), head(names)), tail(keys), tail(names));
  def bfk-ctl-loop(cx, node, parts, env, vm, ctx) {
   let id = bml-ctl-next-id(ctx);
   let init = bfk-ctl-stmt(cx, bml-ctl-loop-init(parts), env, vm, ctx);
   let inner-env = bml-ctl-env-after(bml-ctl-loop-init(parts), env);
   let inner-ctx = bml-ctl-ctx-push(ctx, "loop", bml-ctl-loop-label(parts), id);
   let keys = bfk-vm-keys(bfk-r-vm(init), empty);
   let names = bfk-fresh-names(cx, keys);
   let w = bfk-fresh(cx, "w");
   let vm-in = bfk-vm-bind(bfk-r-vm(init), keys, names);
   let stops = bml-bnml-may-stop?(bml-ctl-loop-body(parts), env) ? bfk-can-fail?(cx, bml-ctl-loop-body(parts), env) : false;
   let test = bfk-cond(cx, bml-ctl-loop-test(parts), inner-env, vm-in);
   let body = bfk-untuple(cx, bfk-ctl-block(cx, bml-ctl-loop-body(parts), inner-env, vm-in, bfk-local-keys(keys), inner-ctx), bfk-local-keys(keys), vm-in);
   let step = bfk-ctl-stmt(cx, bml-ctl-loop-update(parts), inner-env, bfk-r-vm(body), inner-ctx);
   let exit = bfk-form(cons("list", cons("0", names)));
   let again = bfk-form(cons(w, bfk-vm-vars(bfk-r-vm(step), keys)));
   let cond = bfk-unfailed-guard(stops, bfk-if(bfk-mode-zero(), bfk-if(test, bfk-mode-zero(), "0"), "0"));
   let next = bfk-unfailed-guard(stops, bfk-mode-in(bml-ctl-running-modes(id)));
   let pass = bfk-do(bfk-r-items(body), bfk-if(next, bfk-do(cons(bfk-set-mode(0), bfk-r-items(step)), again), bfk-form(cons("list", cons("0", bfk-vm-vars(bfk-r-vm(body), keys))))));
   bfk-add-def(cx, bfk-form(list("defn", w, bfk-form(names), bfk-if(cond, pass, exit))));
   let after = bfk-untuple(cx, bfk-form(cons(w, bfk-vm-vars(bfk-r-vm(init), keys))), keys, bfk-r-vm(init));
   bfk-r(append(bfk-r-items(init), append(bfk-r-items(after), list(bfk-ctl-exit(id)))), bfk-r-vm(after), "0");
  }
  def bfk-unfailed-guard(stops, text) = stops ? bfk-if(bfk-unfailed(), text, "0") : text;

  // ── loops the loop lane can take ────────────────────────────────────────
  // A loop that holds no call that can carry a transfer back, no fail, no
  // return or throw, and no statement but lets, ifs, blocks and its own break
  // and continue needs no mode: break is its exit, the end of a pass and
  // continue are its self tail call. Its defn takes only the names the loop
  // reads or assigns and answers the one name it carries out: the chain of
  // lets and compares ending in a self tail call that fkwu's loop lane
  // crystallizes. Any other loop keeps the mode.
  def bfk-ctl-loop-pick(cx, node, parts, env, vm, ctx) = bfk-pure-loop?(cx, node, parts, env) ? bfk-pl-loop(cx, node, parts, env, vm, ctx) : bfk-ctl-loop(cx, node, parts, env, vm, ctx);
  def bfk-pure-loop?(cx, node, parts, env) = !bfk-quiet-calls?(cx, node, env) ? false : bml-bnml-fails-inside?(node) ? false : bfk-if-count(node) > 4 ? false : bfk-holds-control?(bml-ctl-loop-test(parts)) ? false : bfk-pl-all-ok?(append(bfk-stmts-of(bml-ctl-loop-body(parts)), bfk-stmts-of(bml-ctl-loop-update(parts))), list(bml-ctl-loop-label(parts)));
  // an if that becomes selects copies nothing, so only the others count
  def bfk-if-count(node) = (node_eq(node_category(node), BML-AST-IF) ? (len(node_children(node)) > 0 ? (bfk-plain-branches?(node) ? 0 : 1) : 0) : 0) + bfk-if-count-list(node_children(node));
  def bfk-plain-branches?(node) = bfk-select-if?(node, empty);

  // ── an if that becomes selects ──────────────────────────────────────────
  // An if in a mode-free loop whose branches only assign plain values (no
  // call, no index, no field) keeps the pass one chain: each branch is read
  // as the values it leaves on each name, and every name the branches leave
  // differently takes one select, (if test then-value else-value). Only the
  // taken side of each select runs.
  def bfk-select-if?(node, env) = bfk-holds-any-call?(bml-node-child(node, 0)) ? false : bfk-assigns-only?(bfk-stmts-of(bml-node-child(node, 1)), env) ? bfk-assigns-only?(bfk-stmts-of(bml-ctl-child-or-block(node, 2)), env) : false;
  def bfk-assigns-only?(nodes, env) = nil?(nodes) ? true : bfk-assign-only?(head(nodes), env) ? bfk-assigns-only?(tail(nodes), env) : false;
  def bfk-assign-only?(node, env) = node_eq(node_category(node), BML-AST-BLOCK) ? bfk-assigns-only?(node_children(node), env) : bml-bnml-declare-node?(node) || bml-bnml-assign-node?(node) ? bfk-plain-store?(node, env) : false;
  def bfk-plain-store?(node, env) = bfk-holds-any-call?(bml-bnml-value(node)) ? false : nil?(env) ? true : bml-hati-field-assign?(node, env) ? false : (!bml-hati-dotted-assign?(node, env));
  def bfk-holds-any-call?(node) = (Comparable) len(node_children(node)) == 0 ? false : bml-bnml-user-call?(node) ? true : bml-hati-class-call?(node) ? true : bml-index-node?(node) ? true : bml-list-set-node?(node) ? true : bfk-holds-control?(node) ? true : bfk-any-any-call?(node_children(node));
  def bfk-any-any-call?(nodes) = nil?(nodes) ? false : bfk-holds-any-call?(head(nodes)) ? true : bfk-any-any-call?(tail(nodes));
  def bfk-sel-vm(cx, nodes, env, vm) = nil?(nodes) ? vm : bfk-sel-vm(cx, tail(nodes), bml-ctl-env-after(head(nodes), env), bfk-sel-one(cx, head(nodes), env, vm));
  def bfk-sel-one(cx, node, env, vm) = node_eq(node_category(node), BML-AST-BLOCK) ? bfk-sel-vm(cx, node_children(node), env, vm) : bfk-sel-top(env, bfk-vm-put(vm, bfk-sel-key(node, env), bfk-expr(cx, bml-bnml-value(node), env, vm)), bfk-sel-key(node, env));
  def bfk-sel-top(env, vm, key) = bml-ctl-standing?(env) ? bfk-vm-put(vm, "__top", bfk-vm-or0(vm, key)) : vm;
  def bfk-sel-key(node, env) = bml-bnml-declare-node?(node) ? bml-bnml-new-key(bml-bnml-target-name(node), env) : bml-bnml-assign-key(node, env);
  def bfk-pl-select(cx, node, rest, env, vm, li, kont) {
   let yes = bfk-sel-vm(cx, bfk-stmts-of(bml-node-child(node, 1)), env, vm);
   let no = bfk-sel-vm(cx, bfk-stmts-of(bml-ctl-child-or-block(node, 2)), env, vm);
   let swapped = bfk-int-eq?(bml-node-child(node, 0), env, "op-ne");
   let test = bfk-sel-test(cx, bml-node-child(node, 0), env, vm);
   let r = bfk-sel-binds(cx, bfk-out-keys(bml-ctl-env-after(node, env), vm), test, swapped ? no : yes, swapped ? yes : no, vm, empty);
   bfk-do(bfk-r-items(r), bfk-pl-seq(cx, rest, bml-ctl-env-after(node, env), bfk-r-vm(r), li, kont));
  }
  def bfk-sel-test(cx, test, env, vm) = bfk-int-eq?(test, env, "op-ne") ? bfk-eq-text(cx, test, env, vm) : bfk-int-eq?(test, env, "op-eq") ? bfk-eq-text(cx, test, env, vm) : bfk-cond(cx, test, env, vm);
  def bfk-sel-binds(cx, keys, test, yes, no, vm, items) = nil?(keys) ? bfk-r(reverse-list(items), vm, "0") : (String) bfk-vm-or0(yes, head(keys)) == bfk-vm-or0(no, head(keys)) ? bfk-sel-binds(cx, tail(keys), test, yes, no, bfk-vm-put(vm, head(keys), bfk-vm-or0(yes, head(keys))), items) : bfk-sel-bind(cx, keys, test, yes, no, vm, items, bfk-fresh(cx, "v"));
  def bfk-sel-bind(cx, keys, test, yes, no, vm, items, v) = bfk-sel-binds(cx, tail(keys), test, yes, no, bfk-vm-put(vm, head(keys), v), cons(bfk-let(v, bfk-if(test, bfk-vm-or0(yes, head(keys)), bfk-vm-or0(no, head(keys)))), items));
  def bfk-if-count-list(nodes) = nil?(nodes) ? 0 : (bfk-if-count(head(nodes)) + bfk-if-count-list(tail(nodes)));
  def bfk-pl-all-ok?(nodes, label) = nil?(nodes) ? true : bfk-pl-ok?(head(nodes), label) ? bfk-pl-all-ok?(tail(nodes), label) : false;
  def bfk-pl-ok?(node, label) = nil?(node_children(node)) ? true : bfk-pl-ok-shape?(node, node_category(node), label);
  def bfk-pl-ok-shape?(node, cat, label) = node_eq(cat, BML-AST-BLOCK) ? bfk-pl-all-ok?(node_children(node), label) : node_eq(cat, BML-AST-IF) ? bfk-pl-if-ok?(node, label) : node_eq(cat, BML-AST-BREAK) || node_eq(cat, BML-AST-CONTINUE) ? bfk-own-label?(bml-local-name(node), label) : bml-ctl-while-node?(node) ? bfk-nested-ok?(bml-ctl-while-parts(node), label) : node_eq(cat, BML-AST-FOR) ? bfk-nested-ok?(bml-ctl-for-parts(node), label) : node_eq(cat, BML-AST-RETURN) || node_eq(cat, BML-AST-THROW) ? (!bfk-holds-control?(bml-node-child(node, 0))) : node_eq(cat, BML-AST-WHILE) ? false : node_eq(cat, BML-AST-METHOD) ? false : (!bfk-holds-control?(node));
  def bfk-pl-if-ok?(node, label) = bfk-holds-control?(bml-node-child(node, 0)) ? false : bfk-pl-all-ok?(bfk-stmts-of(bml-node-child(node, 1)), label) ? bfk-pl-all-ok?(bfk-stmts-of(bml-ctl-child-or-block(node, 2)), label) : false;
  // labels: the mode-free loops a break or continue here may name, innermost first
  def bfk-own-label?(name, labels) = (String) name == "" ? true : fsc-string-list-contains?(labels, name);
  // a loop inside a mode-free loop stays mode-free when it is one itself and
  // its breaks and continues reach only itself or a mode-free loop around it
  def bfk-nested-ok?(parts, labels) = bfk-holds-control?(bml-ctl-loop-test(parts)) ? false : bfk-pl-ok?(bml-ctl-loop-init(parts), cons(bml-ctl-loop-label(parts), labels)) ? bfk-pl-all-ok?(append(bfk-stmts-of(bml-ctl-loop-body(parts)), bfk-stmts-of(bml-ctl-loop-update(parts))), cons(bml-ctl-loop-label(parts), labels)) : false;
  def bfk-holds-control?(node) = nil?(node_children(node)) ? false : bml-ctl-statement-node?(node) ? true : bml-ctl-effect-node?(node) ? true : bfk-stmt-only?(node_category(node)) ? true : bfk-any-control?(node_children(node));
  def bfk-any-control?(nodes) = nil?(nodes) ? false : bfk-holds-control?(head(nodes)) ? true : bfk-any-control?(tail(nodes));

  // the names a loop reads or assigns, as the keys its body reaches them by;
  // a const is read through the names its value reads
  def bfk-names-in(node, acc) = bml-hati-class-call?(node) ? bfk-names-in-list(node_children(node), cons("this", acc)) : bml-name-node?(node) ? cons(bfk-name-head(bml-local-name(node)), cons(bml-local-name(node), acc)) : bml-bnml-declare-node?(node) || bml-bnml-assign-node?(node) ? bfk-names-in-list(node_children(node), cons(bfk-name-head(bml-bnml-target-name(node)), cons(bml-bnml-target-name(node), acc))) : bfk-names-in-list(node_children(node), acc);
  def bfk-names-in-list(nodes, acc) = nil?(nodes) ? acc : bfk-names-in-list(tail(nodes), bfk-names-in(head(nodes), acc));
  def bfk-name-head(name) = str_find(name, ".", 0) < 0 ? name : substring(name, 0, str_find(name, ".", 0));
  def bfk-loop-keys(names, env, vm, acc, depth) = nil?(names) ? acc : bfk-loop-keys(tail(names), env, vm, bfk-key-binding(bml-local-lookup(env, head(names)), vm, acc, depth), depth);
  def bfk-key-binding(binding, vm, acc, depth) = nil?(binding) ? acc : bml-bnml-binding?(binding) ? bfk-key-add(bml-local-binding-key(binding), vm, acc) : bfk-key-value(bml-local-binding-value(binding), binding, vm, acc, depth);
  def bfk-key-value(value, binding, vm, acc, depth) = bml-hati-arg-node?(value) ? bfk-key-add("@a", vm, acc) : bml-hati-arg-at-node?(value) ? bfk-key-add("@a" ++ int_to_str(bml-hati-arg-at-index(value)), vm, acc) : bml-hati-class-call?(value) ? bfk-key-add("@pack", vm, acc) : bml-hati-method-ref?(value) ? acc : depth > 8 ? acc : bfk-loop-keys(bfk-names-in(value, empty), bml-local-binding-env(binding), vm, acc, depth + 1);
  def bfk-key-add(key, vm, acc) = fsc-string-list-contains?(acc, key) ? acc : bfk-vm-has?(vm, key) ? append(acc, list(key)) : acc;
  def bfk-carried(names, env, outk, acc) = nil?(names) ? acc : bfk-carried(tail(names), env, outk, bfk-carried-one(bml-local-lookup(env, head(names)), outk, acc));
  def bfk-carried-one(binding, outk, acc) = !bml-bnml-binding?(binding) ? acc : !fsc-string-list-contains?(outk, bml-local-binding-key(binding)) ? acc : fsc-string-list-contains?(acc, bml-local-binding-key(binding)) ? acc : append(acc, list(bml-local-binding-key(binding)));

  // li: (defn-name keys carried update-statements inner-env crossing)
  // A loop that holds a return or a throw carries it out as a value: every
  // exit answers (status value carried...), status 0 for a plain exit and the
  // transfer's own mode for the rest, and the mode is set once after the
  // loop, never read on a pass.
  // A labeled break or continue that names a mode-free loop around this one
  // leaves it with that loop's own code, a negative status no mode takes:
  // break -(2 id + 1), continue -(2 id + 2). The named loop consumes its code.
  def bfk-next-id(cx) = bfk-next-id-at(cx, record_get(cx, "n") + 1);
  def bfk-next-id-at(cx, n) {
   record_set(cx, "n", n);
   n;
  }
  def bfk-break-code(id) = 0 - ((2 * id) + 1);
  def bfk-continue-code(id) = 0 - ((2 * id) + 2);
  def bfk-jump-code(kind, id) = (String) kind == "break" ? bfk-break-code(id) : bfk-continue-code(id);
  def bfk-outer-id(stack, name) = nil?(stack) ? -1 : (String) head(head(stack)) == name ? head(stack)[1] : bfk-outer-id(tail(stack), name);
  def bfk-own-target?(li, name) = (String) name == "" ? true : ((String) name == li[7]);
  def bfk-pl-jump(cx, li, vm, name, kind) = bfk-own-target?(li, name) ? bfk-pl-own-jump(cx, li, vm, kind) : bfk-pl-cross-exit(li, vm, bfk-int(bfk-jump-code(kind, bfk-outer-id(li[8], name))), "0");
  def bfk-pl-own-jump(cx, li, vm, kind) = (String) kind == "break" ? bfk-pl-exit(li, vm) : bfk-pl-next(cx, li, vm);
  // a loop crosses its edge when it holds a return, a throw, or a labeled
  // break or continue naming a loop outside it
  def bfk-cross-label?(node, own) = (Comparable) len(node_children(node)) == 0 ? false : node_eq(node_category(node), BML-AST-BREAK) || node_eq(node_category(node), BML-AST-CONTINUE) ? (!bfk-own-label?(bml-local-name(node), own)) : bml-ctl-while-node?(node) ? bfk-any-cross-label?(node_children(node), cons(bml-ctl-loop-label(bml-ctl-while-parts(node)), own)) : node_eq(node_category(node), BML-AST-FOR) ? bfk-any-cross-label?(node_children(node), cons(bml-ctl-loop-label(bml-ctl-for-parts(node)), own)) : node_eq(node_category(node), BML-AST-METHOD) ? false : bfk-any-cross-label?(node_children(node), own);
  def bfk-any-cross-label?(nodes, own) = nil?(nodes) ? false : bfk-cross-label?(head(nodes), own) ? true : bfk-any-cross-label?(tail(nodes), own);

  // (init call carried crossing)
  def bfk-pl-build(cx, node, parts, env, vm, ctx, outer) {
   let init = bfk-ctl-stmt(cx, bml-ctl-loop-init(parts), env, vm, ctx);
   let inner-env = bml-ctl-env-after(bml-ctl-loop-init(parts), env);
   let keys = bfk-with-top(env, bfk-r-vm(init), bfk-loop-keys(bfk-names-in(node, empty), inner-env, bfk-r-vm(init), empty, 0));
   let carried = bfk-with-top(env, bfk-r-vm(init), bfk-carried(bml-ctl-assigned-names(node), inner-env, bfk-out-keys(bml-ctl-env-after(node, env), bfk-r-vm(init)), empty));
   let names = bfk-fresh-names(cx, keys);
   let w = bfk-fresh(cx, "w");
   let vm-in = bfk-vm-bind(bfk-r-vm(init), keys, names);
   let crossing = bfk-crosses?(node) ? true : bfk-cross-label?(node, list(bml-ctl-loop-label(parts)));
   let li = list(w, keys, carried, bfk-stmts-of(bml-ctl-loop-update(parts)), inner-env, crossing, bfk-next-id(cx), bml-ctl-loop-label(parts), outer);
   let pass = bfk-pl-seq(cx, bfk-stmts-of(bml-ctl-loop-body(parts)), inner-env, vm-in, li, list("next"));
   bfk-add-def(cx, bfk-form(list("defn", w, bfk-form(names), bfk-pl-test(cx, bml-ctl-loop-test(parts), inner-env, vm-in, pass, bfk-pl-exit(li, vm-in)))));
   list(init, bfk-form(cons(w, bfk-vm-vars(bfk-r-vm(init), keys))), carried, crossing);
  }
  def bfk-pl-loop(cx, node, parts, env, vm, ctx) = bfk-pl-finish(cx, bfk-pl-build(cx, node, parts, env, vm, ctx, empty));
  def bfk-pl-finish(cx, b) = b[3] ? bfk-pl-cross-finish(b, bfk-pl-status(cx, b[1], b[2], bfk-r-vm(b[0]))) : bfk-pl-plain-finish(b[0], bfk-pl-after(cx, b[1], b[2], bfk-r-vm(b[0])));
  def bfk-pl-plain-finish(init, after) = bfk-r(append(bfk-r-items(init), bfk-r-items(after)), bfk-r-vm(after), "0");
  // (items vm status value): a crossing loop's answer taken apart
  def bfk-pl-status(cx, call, carried, vm) {
   let r = bfk-fresh(cx, "r");
   let st = bfk-fresh(cx, "s");
   let rv = bfk-fresh(cx, "v");
   let rest = bfk-untuple-keys(cx, r, carried, 2, vm, empty);
   list(append(list(bfk-let(r, call), bfk-let(st, bfk-f2("nth", r, "0")), bfk-let(rv, bfk-f2("nth", r, "1"))), bfk-r-items(rest)), bfk-r-vm(rest), st, rv);
  }
  // the transfer a loop carried out is set as the control lowering sets one
  def bfk-pl-cross-finish(b, u) = bfk-r(append(bfk-r-items(b[0]), append(u[0], list(bfk-pl-set-cross(u[2], u[3])))), u[1], "0");
  def bfk-pl-set-cross(st, rv) = bfk-if(bfk-f2("eq", st, "0"), "0", bfk-if(bfk-f2("eq", st, bfk-int(bml-ctl-return-mode(0))), bfk-do(list(bfk-cell-set("v", rv)), bfk-cell-set("m", st)), bfk-do(list(bfk-cell-set("t", rv)), bfk-cell-set("m", st))));
  // a loop inside a mode-free loop: one that carries a transfer out makes
  // the outer pass leave with it
  def bfk-pl-inner(cx, node, parts, rest, env, vm, li, kont) = bfk-pl-inner-with(cx, bfk-pl-build(cx, node, parts, env, vm, bml-ctl-ctx(empty), cons(list(li[7], li[6]), li[8])), rest, bml-ctl-env-after(node, env), li, kont);
  def bfk-pl-inner-with(cx, b, rest, env2, li, kont) = b[3] ? bfk-pl-inner-cross(cx, b, bfk-pl-status(cx, b[1], b[2], bfk-r-vm(b[0])), rest, env2, li, kont) : bfk-pl-then(cx, bfk-pl-plain-finish(b[0], bfk-pl-after(cx, b[1], b[2], bfk-r-vm(b[0]))), rest, env2, li, kont);
  // this loop takes its own break and continue codes; any other status goes on out
  def bfk-pl-inner-cross(cx, b, u, rest, env2, li, kont) = bfk-do(append(bfk-r-items(b[0]), u[0]), bfk-if(bfk-f2("eq", u[2], "0"), bfk-pl-seq(cx, rest, env2, u[1], li, kont), bfk-if(bfk-f2("eq", u[2], bfk-int(bfk-break-code(li[6]))), bfk-pl-exit(li, u[1]), bfk-if(bfk-f2("eq", u[2], bfk-int(bfk-continue-code(li[6]))), bfk-pl-next(cx, li, u[1]), bfk-pl-pass-on(li, u[1], u[2], u[3])))));
  def bfk-pl-pass-on(li, vm, st, rv) = li[5] ? bfk-pl-cross-exit(li, vm, st, rv) : bfk-pl-exit(li, vm);
  def bfk-pl-cross(cx, node, mode, env, vm, li) = bfk-pl-cross-exit(li, vm, bfk-int(mode), bfk-expr(cx, bml-node-child(node, 0), env, vm));
  def bfk-pl-cross-exit(li, vm, st, rv) = bfk-form(cons("list", cons(st, cons(rv, bfk-vm-vars(vm, li[2])))));
  def bfk-crosses?(node) = bfk-holds-throw?(node) ? true : bfk-holds-return?(node);
  def bfk-holds-return?(node) = (Comparable) len(node_children(node)) == 0 ? false : node_eq(node_category(node), BML-AST-RETURN) ? true : node_eq(node_category(node), BML-AST-METHOD) ? false : bfk-any-return?(node_children(node));
  def bfk-any-return?(nodes) = nil?(nodes) ? false : bfk-holds-return?(head(nodes)) ? true : bfk-any-return?(tail(nodes));
  def bfk-pl-test(cx, test, env, vm, pass, exit) = bfk-true-literal?(test) ? pass : bfk-pl-if(cx, test, env, vm, pass, exit);
  def bfk-true-literal?(node) = !node_eq(node_category(node), BML-AST-INT) ? false : (Comparable) len(node_children(node)) == 0 ? false : (!((Comparable) node_value(bml-node-child(node, 0)) == 0));
  // an if over BML's truth; a compare of two ints stays a compare
  def bfk-pl-if(cx, test, env, vm, yes, no) = bfk-int-eq?(test, env, "op-ne") ? bfk-if(bfk-eq-text(cx, test, env, vm), no, yes) : bfk-int-eq?(test, env, "op-eq") ? bfk-if(bfk-eq-text(cx, test, env, vm), yes, no) : bfk-if(bfk-cond(cx, test, env, vm), yes, no);
  def bfk-int-eq?(node, env, rule) = !bml-ctl-op-node?(node) ? false : (String) bml-ctl-op-rule-of(node) == rule ? bfk-ints?(bml-call-args(node), env) : false;
  def bfk-ints?(nodes, env) = nil?(nodes) ? true : bfk-int-typed?(head(nodes), env) ? bfk-ints?(tail(nodes), env) : false;
  // an int by what the compiler sees: an int literal, a name typed int, or +, -, * and unary - over ints
  def bfk-int-typed?(node, env) = node_eq(node_category(node), BML-AST-INT) ? (len(node_children(node)) > 0) : node_eq(node_category(node), BML-AST-ADD) ? bfk-ints?(node_children(node), env) : bml-ctl-op-node?(node) ? bfk-int-op?(node, env) : ((String) bml-hati-static-type(node, env) == "int");
  def bfk-int-op?(node, env) = fsc-string-list-contains?(list("op-sub", "op-mul", "op-neg"), bml-ctl-op-rule-of(node)) ? bfk-ints?(bml-call-args(node), env) : false;
  def bfk-eq-text(cx, node, env, vm) = bfk-form(cons("eq", bfk-exprs(cx, bml-call-args(node), env, vm)));
  def bfk-pl-seq(cx, nodes, env, vm, li, kont) = nil?(nodes) ? bfk-pl-kont(cx, kont, vm, li) : bfk-pl-node(cx, head(nodes), tail(nodes), env, vm, li, kont);
  def bfk-pl-node(cx, node, rest, env, vm, li, kont) = nil?(node_children(node)) ? bfk-pl-plain(cx, node, rest, env, vm, li, kont) : bfk-pl-shape(cx, node, node_category(node), rest, env, vm, li, kont);
  def bfk-pl-shape(cx, node, cat, rest, env, vm, li, kont) = node_eq(cat, BML-AST-BLOCK) ? bfk-pl-seq(cx, node_children(node), env, vm, li, list("rest", rest, bml-ctl-env-after(node, env), kont)) : node_eq(cat, BML-AST-IF) ? (bfk-select-if?(node, env) ? bfk-pl-select(cx, node, rest, env, vm, li, kont) : bfk-pl-if(cx, bml-node-child(node, 0), env, vm, bfk-pl-seq(cx, bfk-stmts-of(bml-node-child(node, 1)), env, vm, li, list("rest", rest, bml-ctl-env-after(node, env), kont)), bfk-pl-seq(cx, bfk-stmts-of(bml-ctl-child-or-block(node, 2)), env, vm, li, list("rest", rest, bml-ctl-env-after(node, env), kont)))) : node_eq(cat, BML-AST-BREAK) ? bfk-pl-jump(cx, li, vm, bml-local-name(node), "break") : node_eq(cat, BML-AST-CONTINUE) ? bfk-pl-jump(cx, li, vm, bml-local-name(node), "continue") : node_eq(cat, BML-AST-RETURN) ? bfk-pl-cross(cx, node, bml-ctl-return-mode(0), env, vm, li) : node_eq(cat, BML-AST-THROW) ? bfk-pl-cross(cx, node, bml-ctl-throw-mode(0), env, vm, li) : bml-ctl-while-node?(node) ? bfk-pl-inner(cx, node, bml-ctl-while-parts(node), rest, env, vm, li, kont) : node_eq(cat, BML-AST-FOR) ? bfk-pl-inner(cx, node, bml-ctl-for-parts(node), rest, env, vm, li, kont) : bfk-pl-plain(cx, node, rest, env, vm, li, kont);
  // in a standing body a plain statement writes the value it stands on, which the loop carries out
  def bfk-pl-plain(cx, node, rest, env, vm, li, kont) = bfk-pl-then(cx, bfk-stmt(cx, bml-ctl-standing?(env) ? bml-bnml-top-rewrite(node) : node, env, vm), rest, bml-ctl-env-after(node, env), li, kont);
  def bfk-with-top(env, vm, keys) = bml-ctl-standing?(env) ? (bfk-vm-has?(vm, "__top") ? bfk-with-key(keys, "__top") : keys) : keys;
  def bfk-pl-then(cx, r, rest, env, li, kont) = bfk-do(bfk-r-items(r), bfk-pl-seq(cx, rest, env, bfk-r-vm(r), li, kont));
  def bfk-pl-kont(cx, kont, vm, li) = (String) head(kont) == "rest" ? bfk-pl-seq(cx, kont[1], kont[2], vm, li, kont[3]) : (String) head(kont) == "next" ? bfk-pl-next(cx, li, vm) : bfk-pl-call(li, vm);
  def bfk-pl-next(cx, li, vm) = bfk-pl-seq(cx, li[3], li[4], vm, li, list("call"));
  def bfk-pl-call(li, vm) = bfk-form(cons(li[0], bfk-vm-vars(vm, li[1])));
  def bfk-pl-exit(li, vm) = li[5] ? bfk-pl-cross-exit(li, vm, "0", "0") : nil?(li[2]) ? "0" : nil?(tail(li[2])) ? bfk-vm-or0(vm, head(li[2])) : bfk-form(cons("list", cons("0", bfk-vm-vars(vm, li[2]))));
  def bfk-pl-after(cx, call, carried, vm) = nil?(carried) ? bfk-value-stmt(cx, call, vm) : nil?(tail(carried)) ? bfk-pl-one(cx, call, head(carried), vm) : bfk-untuple(cx, call, carried, vm);
  def bfk-pl-one(cx, call, key, vm) {
   let v = bfk-fresh(cx, "v");
   bfk-r(list(bfk-let(v, call)), bfk-vm-put(vm, key, v), v);
  }
  def bfk-ctl-exit(id) = nil?(bml-ctl-stopping-modes(id)) ? "0" : bfk-if(bfk-mode-in(bml-ctl-stopping-modes(id)), bfk-set-mode(0), "0");

  // switch and select read as statements over the two locals the node
  // declares; a break ends them
  def bfk-ctl-switch(cx, node, env, vm, ctx) {
   let id = bml-ctl-next-id(ctx);
   let outk = bfk-out-keys(bml-ctl-env-after(node, env), vm);
   let r = bfk-untuple(cx, bfk-ctl-stmts(cx, bml-ctl-switch-statements(node), env, vm, outk, bml-ctl-ctx-push(ctx, "switch", bml-ctl-switch-label(node), id), "0"), outk, vm);
   bfk-r(append(bfk-r-items(r), list(bfk-ctl-exit(id))), bfk-r-vm(r), "0");
  }

  // break and continue set the mode their target reads; throw and return
  // hold their value and set the mode when none is set
  def bfk-ctl-effect(cx, effect, env, vm, ctx) = bml-ctl-targeted-kind?(bnsc-effect-kind(effect)) ? bfk-ctl-jump(cx, effect, bml-ctl-effect-target(effect, ctx), vm) : bfk-ctl-transfer(cx, effect, env, vm);
  def bfk-ctl-jump(cx, effect, target, vm) = target < 0 ? bfk-value-stmt(cx, bfk-need(cx, bml-ctl-jump-reason(effect)), vm) : bfk-r(list(bfk-set-mode(bml-ctl-effect-mode(effect, target))), vm, "0");
  def bfk-ctl-transfer(cx, effect, env, vm) {
   let v = bfk-fresh(cx, "v");
   let cell = (String) bnsc-effect-kind(effect) == "throw" ? "t" : "v";
   bfk-r(list(bfk-let(v, bfk-expr(cx, bnsc-effect-value(effect), env, vm)), bfk-cell-set(cell, v), bfk-if(bfk-mode-zero(), bfk-set-mode(bml-ctl-effect-mode(effect, 0)), "0")), vm, v);
  }

  // try: the body, then, on the mode a catch takes, the catch's local from
  // the thrown value and the handler
  def bfk-ctl-try(cx, node, env, vm, ctx) {
   let outk = bfk-out-keys(bml-ctl-env-after(node, env), vm);
   let body = bfk-ctl-stmt(cx, bml-node-child(node, 0), env, vm, ctx);
   let decl = bfk-ctl-stmt(cx, bml-ctl-try-decl(node), env, bfk-r-vm(body), ctx);
   let handler = bfk-ctl-stmt(cx, bml-node-child(node, 1), bml-local-env-after-node(bml-ctl-try-decl(node), env), bfk-r-vm(decl), ctx);
   let caught = bfk-do(cons(bfk-set-mode(0), append(bfk-r-items(decl), bfk-r-items(handler))), bfk-tuple(bfk-r-val(handler), bfk-r-vm(handler), outk));
   bfk-untuple(cx, bfk-do(bfk-r-items(body), bfk-if(bfk-mode-is(bml-ctl-catch-mode(0)), caught, bfk-tuple("0", bfk-r-vm(body), outk))), outk, vm);
  }

  // with( e ): .self is the base the node declares
  def bfk-with-access(cx, node, env, vm) = !bml-ctl-with-bound?(env) ? bfk-need(cx, "with/no-base") : bml-ctl-with-self-node?(node) ? bfk-expr(cx, bml-ctl-with-base-node(0), env, vm) : bfk-class-with(cx, node, env, vm);

  // ── choose, fail and the snapshot ───────────────────────────────────────
  // A fail sets FAILED and the statements after it stand down. A choose whose
  // branches assign or fail partway runs each branch from the names it was
  // entered with, FAILED clear: the first branch that ends unfailed hands back
  // the incoming flag and answers, and a branch that failed undoes the field
  // sets the journal kept since the choose opened it, so the next branch meets
  // the state the choose met. If every branch fails the choose fails and its
  // body stops at the value it stood on. save pushes the names in scope, the
  // standing value and the journal count; restore writes them back and undoes
  // the journal to that count; discard drops the newest. A field lives in its
  // record, outside every frame: while a snapshot is open a field set journals
  // the value it replaces.
  def bfk-fail-stmt(cx, env, vm) = bfk-r(list(bfk-cell-set("f", "1")), vm, bml-bnml-choosing?(env) || bml-bnml-env-fallible?(env) ? bfk-top(vm) : "0");

  def bfk-journal-open() = bfk-cell-set("d", bfk-f2("add", bfk-cell("d"), "1"));
  def bfk-journal-close() = bfk-do(list(bfk-cell-set("d", bfk-f2("sub", bfk-cell("d"), "1"))), bfk-if(bfk-f2("le", bfk-cell("d"), "0"), bfk-do(list(bfk-cell-set("j", "(list)")), bfk-cell-set("c", "0")), "0"));
  def bfk-journal-undo(saved) = bfk-f1("bfk-undo", bfk-f2("sub", bfk-cell("c"), saved));

  // statements in order, their items gathered: (items vm value)
  def bfk-seq-items(cx, nodes, env, vm) = bfk-seq-items-at(cx, nodes, env, bfk-r(empty, vm, "0"));
  def bfk-seq-items-at(cx, nodes, env, acc) = nil?(nodes) ? acc : bfk-seq-items-at(cx, tail(nodes), bml-local-env-after-node(head(nodes), env), bfk-r-prefix(bfk-r-items(acc), bfk-stmt(cx, head(nodes), env, bfk-r-vm(acc))));
  def bfk-stmts-of(node) = node_eq(node_category(node), BML-AST-BLOCK) ? node_children(node) : list(node);

  def bfk-choose-track(cx, node, env, vm) {
   let promos = bml-bnml-choose-promotions(node, env);
   let inner-env = bml-bnml-fold-env(promos, env);
   let heard = bml-bnml-edge-check("choose", node, inner-env);
   let told = bml-bch-all-fail(node_children(node));
   let pr = bfk-seq-items(cx, promos, env, vm);
   let outk = bfk-out-keys(inner-env, bfk-r-vm(pr));
   let fin = bfk-fresh(cx, "f");
   let jc = bfk-fresh(cx, "c");
   let kin = bfk-fresh(cx, "k");
   let r = bfk-untuple(cx, bfk-branches(cx, node_children(node), bml-bnml-choosing(inner-env), bfk-r-vm(pr), outk, list(fin, jc, kin)), outk, bfk-r-vm(pr));
   bfk-r(append(bfk-r-items(pr), append(list(bfk-let(fin, bfk-cell("f")), bfk-let(jc, bfk-cell("c")), bfk-let(kin, bfk-cell("k")), bfk-journal-open()), bfk-r-items(r))), bfk-r-vm(r), bfk-r-val(r));
  }
  // held: (incoming FAILED, journal count, incoming commit). A choose that
  // answers hands both flags back. A branch that failed after its cut fails
  // the whole choose: the branches after it are discarded, as a failure after
  // every branch fails it.
  def bfk-choose-fails(vm0, outk, held) = bfk-do(list(bfk-cell-set("f", "1"), bfk-journal-close(), bfk-cell-set("k", held[2])), bfk-tuple(bfk-top(vm0), vm0, outk));
  def bfk-branches(cx, branches, env, vm0, outk, held) = nil?(branches) ? bfk-choose-fails(vm0, outk, held) : bfk-branch(cx, branches, env, vm0, outk, held, bfk-fresh(cx, "b"));
  def bfk-branch(cx, branches, env, vm0, outk, held, b) = bfk-do(list(bfk-cell-set("f", "0"), bfk-cell-set("k", "0"), bfk-let(b, bfk-nodes(cx, bfk-stmts-of(head(branches)), env, vm0, outk))), bfk-if(bfk-unfailed(), bfk-do(list(bfk-cell-set("f", held[0]), bfk-journal-close(), bfk-cell-set("k", held[2])), b), bfk-do(list(bfk-journal-undo(held[1])), bfk-if(bfk-f2("le", bfk-cell("k"), "0"), bfk-branches(cx, tail(branches), env, vm0, outk, held), bfk-choose-fails(vm0, outk, held)))));

  // A cut commits the choose around it to this branch: a failure after it in
  // the branch fails the whole choose, one before it still falls through, and
  // its scope is its own choose (form-stdlib/engine.fk's cut-aware sequence
  // and choice). Outside any choose it commits nothing. Like the marks, it
  // answers the value its body stands on.
  def bfk-cut-stmt(env, vm) = bfk-r(bml-bnml-choosing?(env) ? list(bfk-cell-set("k", "1")) : empty, vm, bfk-top(vm));
  // the table lowering names cut as a need it cannot meet; this lowering meets it
  def bfk-without(reasons, reason) = nil?(reasons) ? empty : (String) head(reasons) == reason ? bfk-without(tail(reasons), reason) : cons(head(reasons), bfk-without(tail(reasons), reason));

  def bfk-vm-marks(vm) = bfk-vm-has?(vm, "__marks") ? bfk-vm-get(vm, "__marks") : "(list)";
  def bfk-save-stmt(cx, env, vm) {
   let s = bfk-fresh(cx, "s");
   let m = bfk-fresh(cx, "k");
   let snap = bfk-form(cons("list", append(bfk-vm-vars(vm, bml-bnml-snapshot-keys(env, empty)), list(bfk-top(vm), bfk-cell("c")))));
   bfk-r(list(bfk-let(s, snap), bfk-let(m, bfk-f2("cons", s, bfk-vm-marks(vm))), bfk-journal-open()), bfk-vm-put(vm, "__marks", m), bfk-top(vm));
  }
  def bfk-restore-stmt(cx, env, vm) = bfk-restore-at(cx, bml-bnml-active-mark(env, 0), vm);
  def bfk-restore-at(cx, mark, vm) = nil?(mark) ? bfk-value-stmt(cx, "0", vm) : bfk-restore-keys(cx, append(bml-bnml-snapshot-keys(bml-local-binding-env(mark), empty), list("__top")), vm);
  def bfk-restore-keys(cx, keys, vm) {
   let s = bfk-fresh(cx, "s");
   let m = bfk-fresh(cx, "k");
   let back = bfk-untuple-keys(cx, s, keys, 0, vm, empty);
   bfk-r(cons(bfk-let(s, bfk-f1("head", bfk-vm-marks(vm))), append(bfk-r-items(back), list(bfk-journal-undo(bfk-f2("nth", s, bfk-int(len(keys)))), bfk-let(m, bfk-f1("tail", bfk-vm-marks(vm))), bfk-journal-close()))), bfk-vm-put(bfk-r-vm(back), "__marks", m), bfk-top(bfk-r-vm(back)));
  }
  def bfk-discard-stmt(cx, env, vm) {
   let m = bfk-fresh(cx, "k");
   bfk-r(list(bfk-let(m, bfk-f1("tail", bfk-vm-marks(vm))), bfk-journal-close()), bfk-vm-put(vm, "__marks", m), bfk-top(vm));
  }

  // ── classes ─────────────────────────────────────────────────────────────
  // A record is a Form record carrying bmlClass, bmlClassId and every field.
  // A member is one defn over the packed (self a0 a1 ...) list the layout's
  // calls pass; a method table reads self's class id and hands the same list
  // to the member that answers it. Which member a call reaches, which
  // constructor a new runs, which field a path names: the layout's own choice.
  def bfk-pack(vm) = bfk-vm-or0(vm, "@pack");
  def bfk-self(vm) = bfk-f1("head", bfk-pack(vm));
  def bfk-class-shaped?(node, env) = bml-hati-class-call?(node) ? true : bml-hati-field-assign?(node, env) ? true : bml-hati-dotted-assign?(node, env) ? true : bml-hati-receiver-name?(bml-call-name(node), env) ? true : bml-hati-member-call?(bml-call-name(node), env);
  def bfk-class-call(cx, node, env, vm) = bml-hati-class-call?(node) ? bfk-class-marker(cx, node, bml-call-name(node), env, vm) : bml-hati-field-assign?(node, env) ? bfk-this-field-store(cx, bml-bnml-target-name(node), bml-bnml-value(node), env, vm) : bml-hati-dotted-assign?(node, env) ? bfk-path-store(cx, bml-hati-dotted-split(bml-bnml-target-name(node)), bml-bnml-value(node), env, vm) : bml-hati-receiver-name?(bml-call-name(node), env) ? bfk-path-invoke(cx, bml-hati-dotted-split(bml-call-name(node)), bml-call-args(node), env, vm) : bfk-invoke(cx, bml-ast-name("this"), bml-call-name(node), bml-call-args(node), env, vm);
  def bfk-class-name(cx, node, env, vm) = bfk-path-read(cx, bml-hati-dotted-split(bml-local-name(node)), env, vm);
  def bfk-class-with(cx, node, env, vm) = bml-ctl-with-member-node?(node) ? bfk-field-read(cx, bml-ctl-with-base-node(0), bml-ctl-with-member-name(node), env, vm) : bfk-expr(cx, bml-ctl-with-call-of(node), env, vm);

  def bfk-class-marker(cx, node, name, env, vm) = ((String) name == "__hati_self") || ((String) name == "__hati_super") ? bfk-self(vm) : (String) name == "__hati_param" ? bfk-f2("nth", bfk-pack(vm), bfk-int(bml-hati-marker-int(node, 0) + 1)) : (String) name == "__hati_field" ? bfk-this-field-read(cx, bml-hati-marker-str(node, 0), env, vm) : (String) name == "__hati_field_get" ? bfk-this-field-read(cx, node_value(bml-node-child(head(bml-call-args(node)), 0)), env, vm) : (String) name == "__hati_field_set" ? bfk-this-field-store(cx, node_value(bml-node-child(head(bml-call-args(node)), 0)), bml-call-args(node)[1], env, vm) : (String) name == "__hati_new" ? bfk-new(cx, bml-hati-env-layout(env), bml-hati-marker-str(node, 0), tail(bml-call-args(node)), env, vm) : (String) name == "__hati_invoke" ? bfk-invoke(cx, bml-hati-marker-arg(node, 0), bml-hati-marker-str(node, 1), drop(2, bml-call-args(node)), env, vm) : (String) name == "__hati_get" ? bfk-field-read(cx, bml-hati-marker-arg(node, 0), bml-hati-marker-str(node, 1), env, vm) : (String) name == "__hati_set" ? bfk-field-store(cx, bml-hati-marker-arg(node, 0), bml-hati-marker-str(node, 1), bml-hati-marker-arg(node, 2), env, vm) : (String) name == "__hati_forward_get" ? bfk-f2("record_get", bfk-expr(cx, bml-hati-marker-arg(node, 0), env, vm), bfk-str(bml-hati-recv-field-key(env, bml-hati-marker-arg(node, 0), bml-hati-marker-str(node, 1)))) : (String) name == "__hati_new_outer" ? bfk-new-outer(cx, node, env, vm) : (String) name == "__hati_class_get" ? bfk-static-get(cx, node, env, vm) : (String) name == "__hati_class_set" ? bfk-static-set(cx, node, env, vm) : (String) name == "__hati_self_ctor" ? bfk-ctor-chain(cx, "self", bml-call-args(node), env, vm) : (String) name == "__hati_super_ctor" ? bfk-ctor-chain(cx, "super", bml-call-args(node), env, vm) : bfk-need(cx, bfk-marker-need(node, name));
  def bfk-marker-need(node, name) = (String) name == "__hati_member" ? "name/method" : (String) name == "__hati_ctor" ? "name/constructor" : (String) name == "__hati_abstract" ? "method/abstract" : (String) name == "__hati_unread" ? bml-voice-then(bml-unread-reading(bml-hati-marker-str(node, 0)), "source/unread") : (String) name == "__hati_denied" ? bml-hati-denied-reason(node) : "method/body-unparsed";

  // fields: a field of a class the layout knows, or of an owner it cannot see;
  // a primitive has none. A set under an open snapshot journals the value it
  // replaces, and answers 0 as the table's record set does.
  def bfk-field-read(cx, recv-node, field, env, vm) = bml-hati-field-readable?(env, recv-node, field) ? bfk-f2("record_get", bfk-expr(cx, recv-node, env, vm), bfk-str(bml-hati-recv-field-key(env, recv-node, field))) : bml-hati-get-method?(env, recv-node, field) ? bfk-invoke(cx, recv-node, field, empty, env, vm) : bfk-need(cx, bml-hati-field-miss(env, recv-node, field));
  def bfk-field-store(cx, recv-node, field, value-node, env, vm) = !bml-hati-field-writable?(env, recv-node, field, value-node) ? bfk-need(cx, bml-hati-store-miss(env, recv-node, field, value-node)) : bml-hati-strict-runtime-id(env, recv-node, field, value-node) >= 0 ? bfk-set-strict(bfk-fresh(cx, "o"), bfk-fresh(cx, "v"), bfk-expr(cx, recv-node, env, vm), bfk-str(bml-hati-recv-field-key(env, recv-node, field)), bfk-expr(cx, value-node, env, vm), bml-hati-strict-runtime-id(env, recv-node, field, value-node), bml-hati-static-type(recv-node, env) ++ "." ++ field) : bfk-set-field(bfk-fresh(cx, "o"), bfk-expr(cx, recv-node, env, vm), bfk-str(bml-hati-recv-field-key(env, recv-node, field)), bfk-expr(cx, value-node, env, vm));
  def bfk-set-field(o, recv, key, value) = bfk-do(list(bfk-let(o, recv), bfk-f2("bfk-jot", o, key), bfk-f3("record_set", o, key, value)), "0");
  // a strict field's store, checked when it runs (thesis line 666): a value
  // of a derived class is not stored, and the run answers the trap
  def bfk-set-strict(o, v, recv, key, value, id, at) = bfk-do(list(bfk-let(o, recv), bfk-let(v, value), bfk-if(bfk-f2("bfk-strict-ok", v, bfk-int(id)), bfk-do(list(bfk-f2("bfk-jot", o, key)), bfk-f3("record_set", o, key, v)), bfk-f1("bfk-strict-trap", bfk-str(at)))), "0");
  def bfk-this-field-read(cx, field, env, vm) = bml-hati-has-receiver?(env) ? bfk-field-read(cx, bml-ast-name("this"), field, env, vm) : bfk-need(cx, "field/no-receiver");
  def bfk-this-field-store(cx, field, value-node, env, vm) = bml-hati-has-receiver?(env) ? bfk-field-store(cx, bml-ast-name("this"), field, value-node, env, vm) : bfk-need(cx, "field/no-receiver");
  def bfk-path-read(cx, split, env, vm) = bfk-field-read(cx, bml-ast-name(head(split)), split[1], env, vm);
  def bfk-path-store(cx, split, value-node, env, vm) = bfk-field-store(cx, bml-ast-name(head(split)), split[1], value-node, env, vm);
  def bfk-path-invoke(cx, split, args, env, vm) = bfk-invoke(cx, bml-ast-name(head(split)), split[1], args, env, vm);

  // recv.member(args): the layout's choice, a direct member or its method
  // table; super.member starts at the base and is direct
  def bfk-invoke(cx, recv-node, member, args, env, vm) = bfk-invoke-with(cx, recv-node, member, args, env, vm, bfk-invoke-choice(recv-node, member, args, env));
  def bfk-invoke-choice(recv-node, member, args, env) = bml-hati-super-receiver?(recv-node, env) ? bml-hati-super-choice(bml-hati-env-layout(env), bml-hati-name-type(bml-local-name(recv-node), env), member, bml-hati-static-types(args, env)) : bml-hati-invoke-choice(bml-hati-env-layout(env), bml-hati-static-type(recv-node, env), member, bml-hati-static-types(args, env));
  def bfk-invoke-with(cx, recv-node, member, args, env, vm, choice) = bml-hati-choice-ok?(choice) ? bfk-member-call(cx, bml-hati-choice-value(choice), recv-node, args, env, vm) : str_len(bml-hati-delegate-via(env, recv-node, member, args)) > 0 ? bfk-invoke(cx, bml-hati-forward-get(recv-node, bml-hati-delegate-via(env, recv-node, member, args)), member, args, env, vm) : bfk-after(cx, bml-hati-voice-refusal("receiver", bml-hati-choice-value(choice), bml-hati-static-type(recv-node, env) ++ "." ++ member), cons(recv-node, args), env, vm);
  def bfk-member-call(cx, fn, recv-node, args, env, vm) = bfk-f1(bfk-fn-name(fn), bfk-form(cons("list", bfk-exprs(cx, cons(recv-node, args), env, vm))));
  // a call the layout cannot give still lowers what it carries, so a need
  // nested in its receiver or arguments is named beside its own
  def bfk-after(cx, reason, nodes, env, vm) = bfk-after-then(bfk-exprs(cx, nodes, env, vm), bfk-need(cx, reason));
  def bfk-after-then(_carried, text) = text;

  // new C(args): one record with the class's id and its fields, each at its
  // key and set to its literal initializer (or 0), each class's init member
  // over it base first, then the constructor the layout picks over it
  def bfk-new(cx, layout, class-type, args, env, vm) = nil?(bml-hati-layout-class(layout, class-type)) ? bfk-after(cx, bfk-unknown-class(layout, class-type), args, env, vm) : bml-hati-class-abstract?(layout, class-type) ? bfk-need(cx, bml-hati-voice-refusal("construction", "new/abstract-class", class-type)) : !bml-hati-fields-init-ok?(bml-hati-class-fields-all(layout, class-type)) ? bfk-need(cx, bml-hati-voice-refusal("construction", "field/init", class-type)) : bfk-new-ctor(cx, layout, bml-hati-layout-class(layout, class-type), args, env, vm, bml-hati-ctor-choice(layout, class-type, bml-hati-static-types(args, env)));
  def bfk-unknown-class(layout, class-type) = bml-hati-template-named?(layout, bml-hati-type-base(class-type)) ? bml-hati-voice-refusal("specialization", "template/unspecialized", class-type) : bml-hati-voice-refusal("construction", "new/unknown-class", class-type);
  def bfk-new-ctor(cx, layout, entry, args, env, vm, choice) = !bml-hati-choice-ok?(choice) ? bfk-need(cx, bml-hati-voice-refusal("construction", bml-hati-choice-value(choice), bml-hati-class-name(entry))) : bml-hati-choice-value(choice) < 0 ? bfk-initialized(cx, layout, entry, env, vm) : bfk-f1(bfk-fn-name(bml-hati-choice-value(choice)), bfk-form(cons("list", cons(bfk-initialized(cx, layout, entry, env, vm), bfk-exprs(cx, args, env, vm)))));
  def bfk-instance(cx, layout, entry, env, vm) = bfk-f2("bfk-obj", "(record_new 0)", bfk-form(cons("list", append(list(bfk-row("bmlClass", bfk-str(bml-hati-class-name(entry))), bfk-row("bmlClassId", bfk-int(bml-hati-class-id(entry)))), bfk-field-rows(cx, bml-hati-field-rows(bml-hati-class-fields-all(layout, bml-hati-class-name(entry))), bml-hati-class-init-env(env, bml-hati-class-name(entry)), vm)))));
  def bfk-initialized(cx, layout, entry, env, vm) = bfk-init-over(bml-hati-init-fns(layout, bml-hati-class-name(entry)), bfk-instance(cx, layout, entry, env, vm));
  def bfk-init-over(fns, rec) = nil?(fns) ? rec : bfk-init-over(tail(fns), bfk-f1(bfk-fn-name(head(fns)), bfk-form(list("list", rec))));
  // new of an inner class inside its outer class's code: the record, its
  // hidden field set to the outer instance, this (thesis line 654)
  def bfk-new-outer(cx, node, env, vm) = bfk-new-outer-at(bfk-fresh(cx, "r"), bfk-expr(cx, bml-hati-marker-arg(node, 0), env, vm), bfk-str(bml-hati-field-key(bml-hati-env-layout(env), bml-hati-marker-str(bml-hati-marker-arg(node, 0), 0), "__outer")), vm);
  def bfk-new-outer-at(r, made, key, vm) = bfk-do(list(bfk-let(r, made), bfk-f3("record_set", r, key, bfk-self(vm))), r);
  // a class field: one slot per class in the program's state; its initializer
  // runs at the first read, and a set marks it set
  def bfk-static-key(node) = "class:" ++ bml-hati-marker-str(node, 0) ++ "." ++ bml-hati-marker-str(node, 1);
  def bfk-static-flag(node) = "class?" ++ bfk-static-key(node);
  def bfk-static-get(cx, node, env, vm) = bfk-if(bfk-f2("eq", bfk-cell(bfk-static-flag(node)), "1"), bfk-cell(bfk-static-key(node)), bfk-do(list(bfk-cell-set(bfk-static-key(node), bfk-expr(cx, bml-hati-marker-arg(node, 3), env, vm)), bfk-cell-set(bfk-static-flag(node), "1")), bfk-cell(bfk-static-key(node))));
  def bfk-static-set(cx, node, env, vm) = bfk-do(list(bfk-cell-set(bfk-static-key(node), bfk-expr(cx, bml-hati-marker-arg(node, 2), env, vm)), bfk-cell-set(bfk-static-flag(node), "1")), "0");
  def bfk-row(key, value) = bfk-f2("list", bfk-str(key), value);
  def bfk-field-rows(cx, rows, env, vm) = nil?(rows) ? empty : cons(bfk-row(head(head(rows)), bfk-expr(cx, head(rows)[1], env, vm)), bfk-field-rows(cx, tail(rows), env, vm));

  // self(args) runs another constructor of this class on the same record;
  // super(args) runs one of the base class's
  def bfk-ctor-chain(cx, which, args, env, vm) = bfk-ctor-chain-at(cx, which, args, env, vm, bml-local-lookup-direct(env, "__hati_ctor"));
  def bfk-ctor-chain-at(cx, which, args, env, vm, binding) = nil?(binding) ? bfk-need(cx, "ctor/outside-constructor") : bfk-ctor-target(cx, bml-hati-env-layout(env), bfk-chain-class(bml-hati-env-layout(env), which, bml-hati-marker-str(bml-local-binding-value(binding), 0)), args, env, vm);
  def bfk-chain-class(layout, which, class-name) = (String) which == "self" ? class-name : bml-hati-class-base-name(layout, class-name);
  def bfk-ctor-target(cx, layout, target, args, env, vm) = nil?(bml-hati-layout-class(layout, target)) ? bfk-need(cx, "super/no-base") : bfk-ctor-call(cx, bml-hati-ctor-choice(layout, target, bml-hati-static-types(args, env)), args, env, vm);
  def bfk-ctor-call(cx, choice, args, env, vm) = !bml-hati-choice-ok?(choice) ? bfk-need(cx, bml-hati-choice-value(choice)) : bml-hati-choice-value(choice) < 0 ? bfk-self(vm) : bfk-member-call(cx, bml-hati-choice-value(choice), bml-ast-name("this"), args, env, vm);

  // every member of every class and interface, each in its owner's env,
  // then the method tables and the trap
  def bfk-decls(cx, layout, env, homes) = append(bfk-owners(cx, layout, append(bml-hati-layout-classes(layout), bml-hati-layout-ifaces(layout)), env, homes), append(bfk-stubs(layout, bml-hati-layout-stubs(layout)), bfk-trap(layout)));
  def bfk-owners(cx, layout, owners, env, homes) = nil?(owners) ? empty : append(bfk-members(cx, layout, head(owners)[1], head(owners)[(String) head(head(owners)) == "bml-hati-class" ? 5 : 3], bml-hati-owner-env(homes, head(owners)[1], env)), bfk-owners(cx, layout, tail(owners), env, homes));
  def bfk-members(cx, layout, owner, members, base-env) = nil?(members) ? empty : bml-hati-member-fn(head(members)) < 0 ? bfk-members(cx, layout, owner, tail(members), base-env) : cons(bfk-member(cx, layout, owner, head(members), base-env), bfk-members(cx, layout, owner, tail(members), base-env));
  def bfk-member(cx, layout, owner, member, base-env) {
   let env = bml-hati-member-env(layout, owner, member, base-env);
   let body = bml-method-node-body(bml-hati-member-node(member));
   let heard = bfk-need-all(cx, bfk-without(bml-hati-unsupported-node-in(body, env), "cut"));
   let text = bfk-body-text(cx, bml-bnml-top-body-node-in(body, env), env, bfk-frame-vm(list(body), env, bfk-vm-put(empty, "@pack", "a0")));
   bfk-form(list("defn", bfk-fn-name(bml-hati-member-fn(member)), "(a0)", (String) bml-hati-member-kind(member) == "ctor" ? bfk-do(list(text), "(head a0)") : text));
  }
  def bfk-need-all(cx, reasons) = nil?(reasons) ? 0 : bfk-need-all-then(cx, bfk-need-add(cx, head(reasons)), tail(reasons));
  def bfk-need-all-then(cx, _added, rest) = bfk-need-all(cx, rest);
  def bfk-stubs(layout, stubs) = nil?(stubs) ? empty : cons(bfk-stub(layout, head(stubs)), bfk-stubs(layout, tail(stubs)));
  def bfk-stub(layout, stub) = bfk-form(list("defn", bfk-fn-name(stub[1]), "(a0)", bfk-do(list(bfk-let("k", bfk-f2("record_get", "(head a0)", bfk-str("bmlClassId")))), bfk-disp(stub[2], 0, bml-hati-layout-trap(layout)))));
  def bfk-disp(table, k, trap) = nil?(table) ? bfk-trap-call(trap) : bfk-if(bfk-f2("eq", "k", bfk-int(k)), bfk-f1(bfk-fn-name(head(table) < 0 ? trap : head(table)), "a0"), bfk-disp(tail(table), k + 1, trap));
  def bfk-trap-call(trap) = trap < 0 ? "0" : bfk-f1(bfk-fn-name(trap), "a0");
  def bfk-trap(layout) = bml-hati-layout-trap(layout) < 0 ? empty : list(bfk-form(list("defn", bfk-fn-name(bml-hati-layout-trap(layout)), "(a0)", bfk-str(bml-hati-trap-text()))));

  // ── methods and the program ─────────────────────────────────────────────
  def bfk-params(n, i) = i >= n ? empty : cons("a" ++ int_to_str(i), bfk-params(n, i + 1));
  def bfk-param-vm(params, i, vm) = nil?(params) ? vm : bfk-param-vm(tail(params), i + 1, bfk-vm-put(vm, "@a" ++ int_to_str(i), head(params)));
  def bfk-arg-vm(params) = (Comparable) len(params) == 1 ? bfk-vm-put(empty, "@a", head(params)) : bfk-param-vm(params, 0, empty);

  // a body that keeps the value it stands on starts it at 0; one that takes
  // snapshots starts an empty stack of them
  def bfk-frame-vm(nodes, env, vm) = bfk-marks-vm(nodes, bml-bnml-keeps-standing?(nodes, env) ? bfk-vm-put(vm, "__top", "0") : vm);
  def bfk-marks-vm(nodes, vm) = bml-bnml-any-snapshots?(nodes) ? bfk-vm-put(vm, "__marks", "(list)") : vm;

  def bfk-body-text(cx, node, env, vm) = node_eq(node_category(node), BML-AST-BLOCK) ? bfk-nodes(cx, node_children(node), env, vm, empty) : bfk-r-expr(bfk-stmt(cx, node, env, vm));

  def bfk-method(cx, node, env, index) {
   let body-env = bml-hati-method-param-env(node, env);
   let params = bfk-params(len(bml-method-node-parameters(node)), 0);
   let body = bml-method-node-body(node);
   let vm = bfk-frame-vm(list(body), body-env, bfk-arg-vm(params));
   bfk-form(list("defn", bfk-fn-name(index), bfk-form(params), bfk-body-text(cx, bml-bnml-top-body-node-in(body, body-env), body-env, vm)));
  }
  def bfk-methods(cx, methods, env, index) = nil?(methods) ? empty : cons(bfk-method(cx, head(methods), env, index), bfk-methods(cx, tail(methods), env, index + 1));
  def bfk-linked(cx, link, units, symbols, index) = nil?(units) ? empty : append(bfk-methods(cx, bml-scope-unit-methods(head(units)), bml-scope-unit-env-with(link, head(units), symbols, "hati"), index), bfk-linked(cx, link, tail(units), symbols, index + len(bml-scope-unit-methods(head(units)))));
  def bfk-main(cx, nodes, env) = bfk-form(list("defn", "m0", "()", bfk-nodes(cx, bml-bnml-top-body-in(nodes, env), env, bfk-frame-vm(nodes, env, empty), empty)));

  // the runtime the program carries: its state, the journal's undo, element
  // assignment, and the answer line the run reads back
  def bfk-state() = bfk-let("BFK", "(record_new 0)");
  def bfk-inits() = list(bfk-cell-set("m", "0"), bfk-cell-set("v", "0"), bfk-cell-set("t", "0"), bfk-cell-set("f", "0"), bfk-cell-set("j", "(list)"), bfk-cell-set("c", "0"), bfk-cell-set("d", "0"), bfk-cell-set("k", "0"));
  def bfk-undo-def() = bfk-form(list("defn", "bfk-undo", "(n)", bfk-if("(le n 0)", "0", bfk-do(list(bfk-let("e", bfk-f1("head", bfk-cell("j"))), bfk-form(list("record_set", "(nth e 0)", "(nth e 1)", "(nth e 2)")), bfk-cell-set("j", bfk-f1("tail", bfk-cell("j"))), bfk-cell-set("c", bfk-f2("sub", bfk-cell("c"), "1"))), "(bfk-undo (sub n 1))"))));
  def bfk-list-set-def() = bfk-form(list("defn", "bfk-list-set", "(xs at v)", bfk-if("(eq (len xs) 0)", "xs", bfk-if("(eq at 0)", "(cons v (tail xs))", "(cons (head xs) (bfk-list-set (tail xs) (sub at 1) v))"))));
  def bfk-jot-def() = bfk-form(list("defn", "bfk-jot", "(o k)", bfk-if(bfk-f2("le", bfk-cell("d"), "0"), "0", bfk-do(list(bfk-cell-set("j", bfk-f2("cons", "(list o k (record_get o k))", bfk-cell("j"))), bfk-cell-set("c", bfk-f2("add", bfk-cell("c"), "1"))), "0"))));
  def bfk-obj-def() = bfk-form(list("defn", "bfk-obj", "(o rows)", bfk-if("(eq (len rows) 0)", "o", bfk-do(list("(record_set o (head (head rows)) (nth (head rows) 1))"), "(bfk-obj o (tail rows))"))));
  def bfk-tab() = bfk-str(byte_to_str(9));
  def bfk-out-def() = bfk-form(list("defn", "bfk-out", "(v)", bfk-f2("str_concat", bfk-str("@bfk "), bfk-f2("str_concat", "(value_kind v)", bfk-f2("str_concat", bfk-tab(), bfk-f2("str_concat", bfk-if(bfk-unfailed(), bfk-str("0"), bfk-str("1")), bfk-f2("str_concat", bfk-tab(), "(value_str v)")))))));
  def bfk-program(cx, texts) = bfk-form(cons("do", cons(bfk-state(), append(bfk-inits(), append(list(bfk-undo-def(), bfk-list-set-def(), bfk-jot-def(), bfk-obj-def(), bfk-out-def(), bfk-strict-ok-def(), bfk-strict-trap-def(), bfk-answer-def()), append(reverse-list(record_get(cx, "defs")), append(texts, list("(bfk-out (bfk-answer (m0)))"))))))));
  // a strict store's check, its trap, and the answer a trap replaces
  def bfk-strict-ok-def() = bfk-form(list("defn", "bfk-strict-ok", "(v id)", bfk-if(bfk-f2("eq", "(value_kind v)", bfk-str("record")), bfk-f2("eq", bfk-f2("record_get", "v", bfk-str("bmlClassId")), "id"), "1")));
  def bfk-strict-trap-def() = bfk-form(list("defn", "bfk-strict-trap", "(at)", bfk-do(list(bfk-cell-set("trap", bfk-f2("str_concat", bfk-str("BML-HATI-TRAP field/strict "), "at")), bfk-cell-set("f", "1")), "0")));
  def bfk-answer-def() = bfk-form(list("defn", "bfk-answer", "(v)", bfk-if(bfk-f2("eq", bfk-cell("trap"), "0"), "v", bfk-cell("trap"))));

  // (text reasons): the program and the needs against it, read over the same
  // link, env, layout and refusal passes the table lowering reads
  def bfk-block(node) = node_eq(node_category(node), BML-AST-BLOCK) ? node : bml-ast-block(list(node));
  def bfk-compile-linked(node, units) = bfk-compile-link(bml-scope-link(bfk-block(node), units));
  def bfk-compile-link(link) {
   let main = bml-scope-link-main(link);
   let methods = bml-scope-unit-methods(main);
   let main-nodes = bml-scope-unit-mains(main);
   let symbols = bml-scope-lane-symbols(link, "hati");
   let others = tail(bml-scope-link-linked(link));
   let layout = bml-hati-unit-layout(bml-scope-layout-nodes(link), 1 + (len(methods) + bml-scope-units-method-count(others)));
   let homes = bml-scope-type-homes(link, others, symbols, layout, bml-hati-type-decls(bml-scope-unit-all-nodes(main)));
   let unit-env = bml-hati-env-with-layout(bml-scope-unit-env-with(link, main, symbols, "hati"), layout);
   // a field initializer lowers where its class lives: this unit, or the linked unit that declares the class
   let env = cons(bml-local-binding(bml-hati-class-homes-key(), list(unit-env, homes), unit-env), unit-env);
   let passes = bfk-without(append(bml-scope-link-reasons(link), append(bml-hati-unsupported-nodes-in-env(main-nodes, env), append(bml-hati-unsupported-methods-in(methods, env), bml-scope-linked-unsupported(link, others, symbols)))), "cut");
   let cx = bfk-cx();
   record_set(cx, "fns", append(bfk-fn-rows(methods, env, 1), bfk-linked-rows(link, others, symbols, 1 + len(methods))));
   let main-text = bfk-main(cx, main-nodes, env);
   let method-texts = bfk-methods(cx, methods, env, 1);
   let other-texts = bfk-linked(cx, link, others, symbols, 1 + len(methods));
   let decl-texts = bfk-decls(cx, layout, env, homes);
   let reasons = bml-hati-reasons-merge(append(passes, bml-hati-layout-reasons(layout)), record_get(cx, "needs"));
   list(bfk-program(cx, cons(main-text, append(method-texts, append(other-texts, decl-texts)))), reasons);
  }

  // ── the run: fkwu itself compiles and runs the program ──────────────────
  def bfk-dir(d) = (Comparable) str_len(d) == 0 ? "/tmp/" : (Comparable) str_byte_at(d, str_len(d) - 1) == 47 ? d : d ++ "/";
  def bfk-scratch(ext) = bfk-dir(host_temp_dir()) ++ "bfk-run-" ++ int_to_str(host_pid()) ++ ext;
  def bfk-run-text(text, where) {
   let src = bfk-scratch(".fk");
   let out = bfk-scratch(".out");
   let err = bfk-scratch(".err");
   write_file_text(src, text);
   let pid = host_spawn_at(list("./fkwu", src), list("/dev/null", out, err));
   let budget = bfk-budget(where);
   let ended = bfk-watch(pid, host_monotonic_ms(), 1, where, budget, budget < bfk-long-ms() ? budget : bfk-long-ms());
   host_wait(pid);
   let said = read_file(out);
   let heard = read_file(err);
   bfk-clear(list(src, out, err, bfk-scratch(".fkb"), bfk-scratch(".sym")));
   (String) ended == "stop" ? list(bml-hati-refusal-prefix(0) ++ "run/budget", false) : bfk-decode(said, heard);
  }
  // ── a run that goes on ──────────────────────────────────────────────────
  // The run is read from outside while it runs, through fkwu's own
  // diagnostics. A run that ends within its time says nothing. One that goes
  // past it raises a reading naming the unit, how long it has run and its
  // hottest defns (a loop is one, by name), offering more time or a stop.
  // The budget is that care offer, not a wall: a source that declares
  // "Budget: N" (ms) in its head is given more time while N holds, and the
  // organ stops a run only when no more time is on offer. A stopped run
  // answers run/budget.
  def bfk-long-ms() = 2000;
  def bfk-budget(where) = bfk-source?(where) ? bfk-budget-at(read_file(where), str_find(read_file(where), "Budget: ", 0)) : bfk-long-ms();
  def bfk-source?(where) = str_len(where) < 5 ? false : (String) substring(where, str_len(where) - 4, str_len(where)) == ".bml" ? ((Comparable) fs_exists(where) == 1) : false;
  def bfk-budget-at(text, at) = at < 0 ? bfk-long-ms() : bfk-budget-digits(text, at + 8, 0, 0);
  def bfk-budget-digits(s, i, acc, seen) = i >= str_len(s) ? bfk-budget-read(acc, seen) : bfk-digit?(str_byte_at(s, i)) ? bfk-budget-digits(s, i + 1, (acc * 10) + (str_byte_at(s, i) - 48), seen + 1) : bfk-budget-read(acc, seen);
  def bfk-digit?(c) = c < 48 ? false : (c <= 57);
  def bfk-budget-read(acc, seen) = seen > 0 ? acc : bfk-long-ms();

  // "ran" when the child ended by itself, "stop" when the organ stopped it
  def bfk-watch(pid, t0, step, where, budget, next) = (Comparable) host_alive(pid) == 1 ? bfk-watch-at(pid, t0, step, where, budget, next, host_monotonic_ms() - t0) : "ran";
  def bfk-watch-at(pid, t0, step, where, budget, next, ms) = ms < next ? bfk-watch-on(pid, t0, step, where, budget, next, host_sleep_ms(step)) : bfk-watch-care(pid, t0, where, budget, ms, bfk-run-care(bfk-run-reading(where, ms, budget, value_str(kernel_page_hot(pid, 3))), ms < budget ? "extend" : "stop", pid, budget));
  def bfk-watch-on(pid, t0, step, where, budget, next, _slept) = bfk-watch(pid, t0, step < 50 ? (step + step) : 50, where, budget, next);
  def bfk-watch-care(pid, t0, where, budget, ms, chosen) = (String) chosen == "stop" ? "stop" : bfk-watch(pid, t0, 1, where, budget, budget);
  def bfk-run-reading(where, ms, budget, hot) = bch-reading("run", "an answer within " ++ int_to_str(budget) ++ " ms", "running " ++ int_to_str(ms) ++ " ms, hot: " ++ hot, list(oh-need("time", json-node-object(list(oh-s("unit", where), oh-n("ran_ms", ms), oh-n("budget_ms", budget), oh-s("hot", hot))))), list("extend", "stop"), where);
  // the organ answers its own reading: more time while the budget holds,
  // else a stop; the care it applied is voiced with its result
  def bfk-run-care(reading, selected, pid, budget) {
   let response = oh-response(reading, selected);
   let chosen = oh-select(reading, response, "stop");
   let done = (String) chosen == "stop" ? host_kill(pid) : 0;
   oh-voice(reading);
   oh-voice(response);
   oh-voice(oh-applied(reading, chosen, json-node-object(list(oh-s("run", (String) chosen == "stop" ? "stopped" : "extended"), oh-n("budget_ms", budget)))));
   chosen;
  }
  def bfk-clear(paths) = nil?(paths) ? 0 : bfk-clear-then(fs_remove(head(paths)), tail(paths));
  def bfk-clear-then(_gone, rest) = bfk-clear(rest);

  // the answer line: "@bfk <kind>\t<unheld 0|1>\t<value>"
  def bfk-marker() = "@bfk ";
  def bfk-line-marker(out, from) = bfk-line-marker-at(out, str_find(out, bfk-marker(), from));
  def bfk-line-marker-at(out, at) = at < 0 ? -1 : (Comparable) at == 0 ? at : (Comparable) str_byte_at(out, at - 1) == 10 ? at : bfk-line-marker(out, at + 1);
  def bfk-trim-end(out) = (Comparable) str_len(out) == 0 ? 0 : (Comparable) str_byte_at(out, str_len(out) - 1) == 10 ? (str_len(out) - 1) : str_len(out);
  def bfk-decode(out, err) = bfk-decode-at(out, err, bfk-line-marker(out, 0));
  def bfk-decode-at(out, err, at) = at < 0 ? list(bfk-died(out, err), false) : bfk-decode-line(substring(out, at + str_len(bfk-marker()), bfk-trim-end(out)));
  def bfk-decode-line(line) {
   let t1 = str_find(line, byte_to_str(9), 0);
   let t2 = str_find(line, byte_to_str(9), t1 + 1);
   list(bfk-typed(substring(line, 0, t1), substring(line, t2 + 1, str_len(line))), (String) substring(line, t1 + 1, t2) == "1");
  }
  def bfk-typed(kind, text) = (String) kind == "int" ? str_to_int(text) : (String) kind == "float" ? str_to_float(text) : (String) kind == "null" ? nothing() : text;

  // a program fkwu could not run to its answer says so where it ran
  def bfk-last-line(text) = substring(text, bfk-nl-before(text, bfk-trim-end(text) - 1) + 1, bfk-trim-end(text));
  def bfk-nl-before(s, i) = i < 0 ? -1 : (Comparable) str_byte_at(s, i) == 10 ? i : bfk-nl-before(s, i - 1);
  // the child's first error line when it has one, else its last line
  def bfk-first-error(err) = bfk-first-error-at(err, str_find(err, "error:", 0));
  def bfk-first-error-at(err, at) = at < 0 ? "" : substring(err, bfk-nl-before(err, at) + 1, bfk-line-stop(err, at));
  def bfk-line-stop(s, i) = i >= str_len(s) ? i : (Comparable) str_byte_at(s, i) == 10 ? i : bfk-line-stop(s, i + 1);
  def bfk-died(out, err) {
   let said = (Comparable) str_len(bfk-first-error(err)) == 0 ? bfk-last-line(out ++ err) : bfk-first-error(err);
   oh-voice(bch-reading("run", "value", "died:" ++ said, list(oh-need("runtime", json-node-string(said))), list("abstain", "request-evidence"), "form-run"));
   "BML-FORM-DIED " ++ said;
  }

  def bfk-run-linked-at(where, node, units) = bml-run-heard(where, "form", bfk-outcome(bfk-compile-linked(node, units), where));
  def bfk-outcome(image, where) = bfk-outcome-with(image[0], bch-admit("form-image", image[1]), where);
  def bfk-outcome-with(text, reasons, where) = nil?(reasons) ? bfk-run-text(text, where) : list(bml-hati-refusal-prefix(0) ++ bml-hati-unsupported-reasons-text(reasons), false);

  // One source on the native path. Its imports and Units: are cared for
  // once, the linked units run on fkwu itself, and an answer the lowering
  // could not give says so where it ran. where names the unit a run's
  // readings carry: a door passes its path.
  def bml-run-unit-value(node, units) = bml-run-unit-value-at("unit", node, units);
  def bml-run-unit-value-at(where, node, units) = bch-ran("form", bfk-run-linked-at(where, node, bml-scope-care-imports(node, units)));
 }
 0;
}
