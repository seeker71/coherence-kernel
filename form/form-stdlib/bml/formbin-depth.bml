// FORMBIN2 traversal and attention. Continuations live in data, independent
// of the host call stack. A checkpoint changes the next slice, never validity.
// preludes: form-stdlib/core.fk observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 class FormbinDepth {
  def fbd-max(a, b) = a > b ? a : b;
  // Linked pairs keep pushes constant-size on array-list proof carriers too.
  def fbd-push(value, rest) = list(value, rest);
  def fbd-rest(stack) = stack[1];
  // state: cursor, frames, nodes, peak-depth, mode, error, depth.
  // mode: 0 read node, 1 complete child, 2 complete root, 3 malformed.
  // frame: composite byte offset, original child count, children remaining;
  // -1 remaining means the category has just been requested.
  def fbd-state(p, frames, nodes, peak, mode, error, depth) = list(p, frames, nodes, peak, mode, error, depth);
  def fbd-start(p) = fbd-state(p, list(), 0, 0, 0, "", 0);
  def fbd-initial-attention() = list(256, 32, 50);
  def fbd-u32(s, p) = (str_byte_at(s, p) * 16777216) + ((str_byte_at(s, p + 1) * 65536) + ((str_byte_at(s, p + 2) * 256) + str_byte_at(s, p + 3)));
  def fbd-error(st, reason) = fbd-state(st[0], st[1], st[2], st[3], 3, "form binary: " ++ reason, st[6]);
  def fbd-slice(source, state, quantum) = fbd-loop(source, state, fbd-max(1, quantum), list());
  def fbd-loop(source, st, left, rows) {
   (left <= 0) || (st[4] >= 2) ? list(st, rows)
   : (Comparable) st[4] == 1 ? fbd-complete(source, st, left, rows)
   : fbd-node(source, st, left, rows);
  }
  def fbd-node(source, st, left, rows) {
   let p = st[0];
   st[2] >= 1000000 ? list(fbd-error(st, "maximum node count exceeded"), rows)
   : (p + 4) > str_len(source) ? list(fbd-error(st, "truncated u32"), rows)
   : fbd-tag(source, st, left, rows, fbd-u32(source, p));
  }
  def fbd-tag(source, st, left, rows, tag) {
   let p = st[0];
   let depth = st[6];
   let peak = fbd-max(depth, st[3]);
   (Comparable) tag == 1 ? fbd-loop(source, fbd-state(p + 4, fbd-push(list(p, -1, -1), st[1]), st[2] + 1, peak, 0, "", depth + 1), left - 1, rows)
   : ((Comparable) tag == 0) || (((Comparable) tag == 2) || ((Comparable) tag == 3)) ? fbd-leaf(source, st, left, rows, tag, (Comparable) tag == 0 ? 20 : 12, peak)
   : list(fbd-error(st, "unknown node tag " ++ int_to_str(tag)), rows);
  }
  def fbd-leaf(source, st, left, rows, tag, size, peak) {
   let p = st[0];
   (p + size) > str_len(source) ? list(fbd-error(st, (Comparable) tag == 0 ? "truncated u32" : (Comparable) tag == 2 ? "truncated float64" : "truncated int64"), rows)
   : fbd-loop(source, fbd-state(p + size, st[1], st[2] + 1, peak, 1, "", st[6]), left - 1, fbd-push(list(tag, p, 0), rows));
  }
  def fbd-complete(source, st, left, rows) {
   nil?(st[1]) ?
    ((Comparable) st[0] == str_len(source) ? list(fbd-state(st[0], list(), st[2], st[3], 2, "", 0), rows)
    : list(fbd-error(st, "trailing bytes"), rows))
   : fbd-parent(source, st, left, rows, head(st[1]));
  }
  def fbd-parent(source, st, left, rows, frame) {
   (Comparable) frame[2] == -1 ?
    ((st[0] + 4) > str_len(source) ? list(fbd-error(st, "truncated u32"), rows)
    : fbd-count(source, st, left, rows, frame, fbd-u32(source, st[0])))
   : (Comparable) frame[2] == 1 ? fbd-close(source, st, left, rows, frame)
   : fbd-loop(source, fbd-state(st[0], fbd-push(list(head(frame), frame[1], frame[2] - 1), fbd-rest(st[1])), st[2], st[3], 0, "", st[6]), left - 1, rows);
  }
  def fbd-count(source, st, left, rows, frame, count) {
   let next = fbd-state(st[0] + 4, st[1], st[2], st[3], 0, "", st[6]);
   count > 262144 ? list(fbd-error(st, "maximum child count exceeded"), rows)
   : (Comparable) count == 0 ? fbd-close(source, next, left, rows, list(head(frame), 0, 0))
   : fbd-loop(source, fbd-state(next[0], fbd-push(list(head(frame), count, count), fbd-rest(st[1])), st[2], st[3], 0, "", st[6]), left - 1, rows);
  }
  def fbd-close(source, st, left, rows, frame) = fbd-loop(source, fbd-state(st[0], fbd-rest(st[1]), st[2], st[3], 1, "", st[6] - 1), left - 1, fbd-push(list(1, head(frame), frame[1]), rows));
  // Observations: peak, watermark, quantum, slice-ms, attention-ms, GC cycles.
  // Decision: attention level, action, next watermark, next quantum.
  // action 0 continue, 1 yield with smaller slice, 2 grow slice.
  def fbd-attend(peak, watermark, quantum, elapsed, attentionMs, collections) {
   let crossed = peak >= watermark;
   // Collection is a signal to watch. Shrinking a fast slice on every GC
   // creates its own pressure through extra observations and continuations.
   let pressured = elapsed > attentionMs;
   let action = pressured ? 1 : (elapsed * 4) < attentionMs ? 2 : 0;
   let nextQuantum = (Comparable) action == 1 ? fbd-max(1, quantum / 2) : (Comparable) action == 2 ? (quantum * 2) : quantum;
   list(pressured ? 2 : crossed || (collections > 0) ? 1 : 0, action, crossed ? ((peak + 1) * 2) : watermark, nextQuantum);
  }
  def fbd-control-row(values, exchange, round) {
   let outbound = bfc-envelope(0, exchange, 0, values, "retain-continuation");
   let observed = bfc-record-out(outbound, round * 2);
   let decision = fbd-attend(values[0], values[1], values[2], values[3], values[4], values[5]);
   let inbound = bfc-envelope(1, exchange, 1, decision, "retain-continuation");
   let selected = bfc-record-in(inbound, (round * 2) + 1);
   ((Comparable) bfc-direction(inbound) == 1) && ((Comparable) bfc-exchange(outbound) == bfc-exchange(inbound)) ? bfc-payload(inbound) : list(2, 0, values[1], values[2]);
  }
 }
 0;
}
