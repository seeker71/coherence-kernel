// retry.bml — a wait that ends by the clock, and an attempt that tries again, said once.
//
// wait-until(ready, deadline, every) polls a lambda: 1 when it answers true, 0 when the monotonic deadline
// arrives first. retry-first(count, every, once) calls once(i) for i = 0.. and answers the first reading that is
// not nothing; a stop inside an attempt is an attempt that answered nothing (voiced as a stop record), and
// `count` spent answers nothing. `every` is the pause between tries in milliseconds; 0 pauses never.
// section [form.bml] { wait-until(() => file_size(path) > 0, host_monotonic_ms() + 3000, 10); }
// preludes:
section [form.bml] {
 class Retry {
  def wait-until(ready, deadline, every) = ready() ? 1 : host_monotonic_ms() >= deadline ? 0 : wait-until-again(ready, deadline, every);
  def wait-until-again(ready, deadline, every) {
   host_sleep_ms(every);
   wait-until(ready, deadline, every);
  }
  def retry-first(count, every, once) = retry-first-from(0, count, every, once);
  def retry-first-from(i, count, every, once) = i >= count ? nothing() : choice { once(i); retry-first-after(i, count, every, once) };
  def retry-first-after(i, count, every, once) {
   every > 0 && i + 1 < count ? host_sleep_ms(every) : 0;
   retry-first-from(i + 1, count, every, once);
  }
 }
}
