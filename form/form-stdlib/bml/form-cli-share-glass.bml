//////////////////////////////////////////////////////////////////////
//
// form-cli-share-glass.bml — publish completed-turn share only after
// every boundary count has reconciled.
//
// A reading that has not reconciled is GIVEN with its state, never withheld:
// the counts the receipt carries stand as they are, the percentages wear
// lifecycle measuring and the failing check as their own channel word, and
// the frame is stamped this epoch so a stale reading reads silent by age.
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-turn-evidence.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/hearth.bml

section [form.bml] {
    class FormCliShareGlass {
        field FCSharePublisher = "share.completed-turn";
        field FCShareOwner = "meter.completed-turn-share";
        field FCShareSource = "form-cli-share";

        def fcsg-root() = hearth-telemetry-root();
        def fcsg-publisher() = FCSharePublisher();
        def fcsg-owner() = FCShareOwner();
        def fcsg-source() = FCShareSource();
        def fcsg-channels(lane) = list("share", "turn", "evidence", lane);
        // the reading's state travels as its own channel word: a reader sees the number and what it is worth in one row
        def fcsg-reason-channels(lane, reason) = list("share", "turn", "evidence", lane, reason);
        // which check has not reconciled yet -- named, so the row says why rather than hiding the number
        def fcsg-reason(evidence) = (Comparable) fcte-carrier-present?(evidence) == 0 ? "carrier-absent" : !((Comparable) fcte-complete(evidence) == 1) ? "turn-open" : (Comparable) fcte-time-valid?(evidence) == 0 ? "time-unreconciled" : (Comparable) fcte-token-valid?(evidence) == 0 ? "tokens-unreconciled" : (Comparable) fcte-tool-valid?(evidence) == 0 ? "tools-unreconciled" : (Comparable) fcte-form-valid?(evidence) == 0 ? "form-unreconciled" : (Comparable) fcte-lanes-valid?(evidence) == 0 ? "lanes-unreconciled" : (Comparable) fcte-source-ok?(evidence) == 0 ? "source-unreconciled" : "provenance-unreconciled";

        def fcsg-observed-root(epoch, total) = fcsg-root-sample(epoch, total, "ready", "reconciled");
        def fcsg-root-sample(epoch, total, lifecycle, reason) = fgtm-sample("share.previous.completed", fgtm-absent(), "event", "form", fcsg-owner(), "accounting", "boundary-event-share", fgtm-absent(), fgtm-present(total), lifecycle, fgtm-present(epoch), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "pinned", "physical-live", fcsg-source(), fcsg-reason-channels("accounting", reason));

        def fcsg-percent(id, lane, value, epoch) = fcsg-percent-sample(id, lane, value, epoch, "ready", "reconciled");
        def fcsg-percent-sample(id, lane, value, epoch, lifecycle, reason) = fgtm-sample(id, fgtm-present("share.previous.completed"), "metric", "form", fcsg-owner(), lane, "boundary-event-percent", fgtm-absent(), fgtm-present(value), lifecycle, fgtm-present(epoch), fgtm-present(epoch), fgtm-present(value), fgtm-absent(), "pinned", "physical-live", fcsg-source(), fcsg-reason-channels(lane, reason));

        def fcsg-observed-samples(epoch, shares, total) = list(fcsg-observed-root(epoch, total), fcsg-percent("share.previous.native", "native", shares[0], epoch), fcsg-percent("share.previous.local", "local", shares[1], epoch), fcsg-percent("share.previous.remote", "remote", shares[2], epoch));

        // Missing carrier fields are absent values, never zero counts or percentages.
        def fcsg-absent-sample(epoch, id, parent, kind, lane, purpose) = fgtm-sample(id, parent, kind, "form", fcsg-owner(), lane, purpose, fgtm-absent(), fgtm-absent(), "unknown", fgtm-present(epoch), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "pinned", "declared", fcsg-source(), fcsg-reason-channels(lane, "carrier-absent"));
        def fcsg-absent-samples(epoch) = list(fcsg-absent-sample(epoch, "share.previous.completed", fgtm-absent(), "event", "accounting", "boundary-event-share"), fcsg-absent-sample(epoch, "share.previous.native", fgtm-present("share.previous.completed"), "metric", "native", "boundary-event-percent"), fcsg-absent-sample(epoch, "share.previous.local", fgtm-present("share.previous.completed"), "metric", "local", "boundary-event-percent"), fcsg-absent-sample(epoch, "share.previous.remote", fgtm-present("share.previous.completed"), "metric", "remote", "boundary-event-percent"));
        // A present but unreconciled carrier retains its own counts and reason.
        def fcsg-unreconciled-samples(epoch, evidence) = (Comparable) fcte-carrier-present?(evidence) == 0 ? fcsg-absent-samples(epoch) : fcsg-unreconciled-with(epoch, fcte-boundary-share(evidence), fcte-total-events(evidence), fcsg-reason(evidence));
        // the membrane's own lifecycle words: a turn still settling is active, a turn whose carrier never arrived is unknown
        def fcsg-unreconciled-life(reason) = (String) reason == "carrier-absent" ? "unknown" : "active";
        def fcsg-unreconciled-with(epoch, shares, total, reason) = fcsg-unreconciled-rows(epoch, shares, total, reason, fcsg-unreconciled-life(reason));
        def fcsg-unreconciled-rows(epoch, shares, total, reason, life) = list(fcsg-root-sample(epoch, total, life, reason), fcsg-percent-sample("share.previous.native", "native", shares[0], epoch, life, reason), fcsg-percent-sample("share.previous.local", "local", shares[1], epoch, life, reason), fcsg-percent-sample("share.previous.remote", "remote", shares[2], epoch, life, reason));

        // The membrane-facing door accepts evidence, never percentages.  A
        // caller cannot accidentally publish an unvalidated boundary share.
        def fcsg-samples-for-evidence(epoch, evidence) = (Comparable) fcte-valid?(evidence) == 1 ? fcsg-observed-samples(epoch, fcte-boundary-share(evidence), fcte-total-events(evidence)) : fcsg-unreconciled-samples(epoch, evidence);
        def fcsg-publish-evidence-at(root, publisher, epoch, evidence) = fgtm-publish-snapshot(root, publisher, epoch, fcsg-samples-for-evidence(epoch, evidence));
        def fcsg-publish-evidence(epoch, evidence) = fcsg-publish-evidence-at(fcsg-root(), fcsg-publisher(), epoch, evidence);

        def fcsg-publish-status(result) = len(result) < 2 ? "malformed" : result[1];
    }
    0;
}
