//////////////////////////////////////////////////////////////////////
//
// form-cli-share-glass.bml — publish completed-turn share only after
// every boundary count has reconciled.
//
// A reading that has not reconciled is GIVEN with its state, never withheld:
// the counts the receipt carries stand as they are, the percentages wear
// lifecycle measuring and the failing check as their own channel word, and
// the frame is stamped this epoch so a stale reading reads silent by age.
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-turn-evidence.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/hearth.bml

section [form.bml] {
    class FormCliShareGlass {
        field FCSharePublisher = "share.completed-turn";
        field FCShareOwner = "meter.completed-turn-share";
        field FCShareSource = "form-cli-share";

        def fcsg-root() = hearth-telemetry-root();
        def fcsg-publisher() = FCSharePublisher();
        def fcsg-owner() = FCShareOwner();
        def fcsg-source() = FCShareSource();
        def fcsg-channels(lane) = list("share", "turn", "evidence", lane);
        // the reading's state travels as its own channel word: a reader sees the number and what it is worth in one row
        def fcsg-reason-channels(lane, reason) = list("share", "turn", "evidence", lane, reason);
        // which check has not reconciled yet -- named, so the row says why rather than hiding the number
        def fcsg-reason(evidence) = if eq(fcte-carrier-present?(evidence), 0) then "carrier-absent" else if not(eq(fcte-complete(evidence), 1)) then "turn-open" else if eq(fcte-time-valid?(evidence), 0) then "time-unreconciled" else if eq(fcte-token-valid?(evidence), 0) then "tokens-unreconciled" else if eq(fcte-tool-valid?(evidence), 0) then "tools-unreconciled" else if eq(fcte-form-valid?(evidence), 0) then "form-unreconciled" else if eq(fcte-lanes-valid?(evidence), 0) then "lanes-unreconciled" else if eq(fcte-source-ok?(evidence), 0) then "source-unreconciled" else "provenance-unreconciled";

        def fcsg-observed-root(epoch, total) = fcsg-root-sample(epoch, total, "ready", "reconciled");
        def fcsg-root-sample(epoch, total, lifecycle, reason) = fgtm-sample("share.previous.completed", fgtm-absent(), "event", "form", fcsg-owner(), "accounting", "boundary-event-share", fgtm-absent(), fgtm-present(total), lifecycle, fgtm-present(epoch), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "pinned", "physical-live", fcsg-source(), fcsg-reason-channels("accounting", reason));

        def fcsg-percent(id, lane, value, epoch) = fcsg-percent-sample(id, lane, value, epoch, "ready", "reconciled");
        def fcsg-percent-sample(id, lane, value, epoch, lifecycle, reason) = fgtm-sample(id, fgtm-present("share.previous.completed"), "metric", "form", fcsg-owner(), lane, "boundary-event-percent", fgtm-absent(), fgtm-present(value), lifecycle, fgtm-present(epoch), fgtm-present(epoch), fgtm-present(value), fgtm-absent(), "pinned", "physical-live", fcsg-source(), fcsg-reason-channels(lane, reason));

        def fcsg-observed-samples(epoch, shares, total) = list(fcsg-observed-root(epoch, total), fcsg-percent("share.previous.native", "native", nth(shares, 0), epoch), fcsg-percent("share.previous.local", "local", nth(shares, 1), epoch), fcsg-percent("share.previous.remote", "remote", nth(shares, 2), epoch));

        // an unreconciled turn gives every count it holds, wearing lifecycle measuring and its reason
        def fcsg-unreconciled-samples(epoch, evidence) = fcsg-unreconciled-with(epoch, fcte-boundary-share(evidence), fcte-total-events(evidence), fcsg-reason(evidence));
        // the membrane's own lifecycle words: a turn still settling is active, a turn whose carrier never arrived is unknown
        def fcsg-unreconciled-life(reason) = if str_eq(reason, "carrier-absent") then "unknown" else "active";
        def fcsg-unreconciled-with(epoch, shares, total, reason) = fcsg-unreconciled-rows(epoch, shares, total, reason, fcsg-unreconciled-life(reason));
        def fcsg-unreconciled-rows(epoch, shares, total, reason, life) = list(fcsg-root-sample(epoch, total, life, reason), fcsg-percent-sample("share.previous.native", "native", nth(shares, 0), epoch, life, reason), fcsg-percent-sample("share.previous.local", "local", nth(shares, 1), epoch, life, reason), fcsg-percent-sample("share.previous.remote", "remote", nth(shares, 2), epoch, life, reason));

        // The membrane-facing door accepts evidence, never percentages.  A
        // caller cannot accidentally publish an unvalidated boundary share.
        def fcsg-samples-for-evidence(epoch, evidence) = if eq(fcte-valid?(evidence), 1) then fcsg-observed-samples(epoch, fcte-boundary-share(evidence), fcte-total-events(evidence)) else fcsg-unreconciled-samples(epoch, evidence);
        def fcsg-publish-evidence-at(root, publisher, epoch, evidence) = fgtm-publish-snapshot(root, publisher, epoch, fcsg-samples-for-evidence(epoch, evidence));
        def fcsg-publish-evidence(epoch, evidence) = fcsg-publish-evidence-at(fcsg-root(), fcsg-publisher(), epoch, evidence);

        def fcsg-publish-status(result) = if lt(len(result), 2) then "malformed" else nth(result, 1);
    }
    0;
}
