//////////////////////////////////////////////////////////////////////
//
// form-cli-share-glass.bml — publish completed-turn share only after
// every boundary count has reconciled.
//
// A measuring or failed reading replaces the previous percentages with one
// explicit withheld node. Glass therefore cannot retain an older percentage
// as though it described the next completed turn.
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-turn-evidence.fk
// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml

section [form.bml] {
    class FormCliShareGlass {
        field Root = "/tmp/form-glass-telemetry";
        field Publisher = "share.completed-turn";
        field Owner = "meter.completed-turn-share";
        field Source = "form-cli-share";

        def fcsg-root() = Root();
        def fcsg-publisher() = Publisher();
        def fcsg-owner() = Owner();
        def fcsg-source() = Source();
        def fcsg-channels(lane) = list("share", "turn", "evidence", lane);

        def fcsg-observed-root(epoch, total) = fgtm-sample("share.previous.completed", fgtm-absent(), "event", "form", fcsg-owner(), "accounting", "boundary-event-share", fgtm-absent(), fgtm-present(total), "ready", fgtm-present(epoch), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "pinned", "physical-live", fcsg-source(), fcsg-channels("accounting"));

        def fcsg-percent(id, lane, value, epoch) = fgtm-sample(id, fgtm-present("share.previous.completed"), "metric", "form", fcsg-owner(), lane, "boundary-event-percent", fgtm-absent(), fgtm-present(value), "ready", fgtm-present(epoch), fgtm-present(epoch), fgtm-present(value), fgtm-absent(), "pinned", "physical-live", fcsg-source(), fcsg-channels(lane));

        def fcsg-observed-samples(epoch, shares, total) = list(fcsg-observed-root(epoch, total), fcsg-percent("share.previous.native", "native", nth(shares, 0), epoch), fcsg-percent("share.previous.local", "local", nth(shares, 1), epoch), fcsg-percent("share.previous.remote", "remote", nth(shares, 2), epoch));

        def fcsg-withheld-samples(epoch) = list(fgtm-sample("share.previous.withheld", fgtm-absent(), "event", "form", fcsg-owner(), "accounting", "measurement-withheld", fgtm-absent(), fgtm-absent(), "unknown", fgtm-present(epoch), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "pinned", "physical-live", fcsg-source(), fcsg-channels("accounting")));

        // The membrane-facing door accepts evidence, never percentages.  A
        // caller cannot accidentally publish an unvalidated boundary share.
        def fcsg-samples-for-evidence(epoch, evidence) = if eq(fcte-valid?(evidence), 1) then fcsg-observed-samples(epoch, fcte-boundary-share(evidence), fcte-total-events(evidence)) else fcsg-withheld-samples(epoch);
        def fcsg-publish-evidence-at(root, publisher, epoch, evidence) = fgtm-publish-snapshot(root, publisher, epoch, fcsg-samples-for-evidence(epoch, evidence));
        def fcsg-publish-evidence(epoch, evidence) = fcsg-publish-evidence-at(fcsg-root(), fcsg-publisher(), epoch, evidence);

        def fcsg-publish-status(result) = if lt(len(result), 2) then "malformed" else nth(result, 1);
    }
    0;
}
