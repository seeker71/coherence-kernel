   record_set(owner,"identity",identity); record_set(owner,"request",list(0,identity,image));
   let pid = nve-call(owner,list(0));
   if ((Comparable) pid == host_pid()) then nve-open-queue(owner) else nve-note(owner,"native-admission","PID observation disagreed");
