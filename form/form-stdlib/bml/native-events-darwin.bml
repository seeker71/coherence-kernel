  }
  // BMF Repeat's checkpoint rule, carried by the existing ready queue.
  // A body returns a value to finish, or nve-repeat-next(cursor) to advance.
  // Stops enter the same local care path; retry schedules after unwinding.
  def nve-repeat(owner,receiver,context,cursor,options) {
   let watch = nve-post(owner,nve-repeat-receive,context,options);
   nothing?(watch) ? nothing() : {
