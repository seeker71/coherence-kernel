  def nve-registration-count(watches) = nil?(watches) ? 0 : record_get(head(watches),"registered") + nve-registration-count(tail(watches));
  def nve-retain(owner,event,binding,memory) {
   let watch = nve-event-watch(event);
   nothing?(record_get(watch,"continuation")) ? record_set(owner,"pending",cons(watch,nve-pending(owner))) : 0;
