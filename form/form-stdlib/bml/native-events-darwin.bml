  }
  def nve-queue(owner,event,binding,memory) {
   let watch = nve-retain(owner,event,binding,memory); nve-pause(owner,watch);
   let live = nve-live(owner,watch); record_set(watch,"next-binding",nothing()); record_set(watch,"queued",live);
   !live ? { nve-observe-continuation(owner,watch,"subscription-released-before-yield",0,record_get(watch,"reading")); 0; } : {
    (!record_get(watch,"caring") && !nothing?(record_get(watch,"reading"))) ? nve-observe-continuation(owner,watch,"continuation-yielded",0,record_get(watch,"reading")) : 0;
    let revision = record_get(watch,"revision") + 1; record_set(watch,"revision",revision);
    record_set(owner,"ready-back",cons(list(watch,revision),record_get(owner,"ready-back"))); 1;
   };
  }
  def nve-ready-head(owner) {
   !nve-active(owner) ? nothing() : {
    nil?(record_get(owner,"ready-front")) ? { record_set(owner,"ready-front",reverse(record_get(owner,"ready-back"))); record_set(owner,"ready-back",list()); } : 0;
    let front = record_get(owner,"ready-front");
    nil?(front) ? nothing() : {
     let ticket = head(front); let watch = head(ticket);
     (nve-live(owner,watch) && record_get(watch,"queued") && (record_get(watch,"revision") == ticket[1]) && !nothing?(record_get(watch,"continuation"))) ? watch : { record_set(owner,"ready-front",tail(front)); nve-ready-head(owner); };
    };
