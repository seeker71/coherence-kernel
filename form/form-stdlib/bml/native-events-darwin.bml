  def nve-repeat-next(cursor) = record_new(0,"kind","native-repeat-next","cursor",cursor);
  def nve-repeat-next?(value) = if ((String) value_kind(value) == "record") then ((Value) record_get(value,"kind") == "native-repeat-next") else false;
