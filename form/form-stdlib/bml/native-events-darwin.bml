  def nve-event-watch(event) = head(event);
  def nve-event-flags(event) = nth(event,1);
  def nve-event-notes(event) = nth(event,2);
  def nve-event-error(event) = nth(event,3);
  def nve-event-data(event) = nth(event,4);
  def nve-bit(value,bit) = ((Comparable) ((value / bit) % 2) == 1);
  // A subscription carries its own receiving context. Wait reads the complete
  // batch before any receiver changes registrations or releases resources.
  def nve-bind(owner,watch,receiver,context) {
   if !nve-live(owner,watch) then 0 else { record_set(watch,"receiver",receiver); record_set(watch,"context",context); 1; };
  }
  def nve-dispatch(owner,events) {
   if nil?(events) then 1 else {
    let event = head(events); let watch = nve-event-watch(event);
    if !nve-live(owner,watch) then 0 else if record_has(watch,"receiver") then {
     record_set(owner,"callbacks",(record_get(owner,"callbacks") + 1));
