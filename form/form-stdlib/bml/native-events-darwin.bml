  }
  def nve-run(owner,slices) {
   !nve-ready(owner) ? nothing() : !nve-nonnegative(slices) || nve-turn-active(owner) ? nve-note(owner,"slice-grant","needs nonnegative slices outside an active turn") : {
    record_set(owner,"dispatching",1); let ran = nve-run-ready(owner,slices); record_set(owner,"dispatching",0); ran;
