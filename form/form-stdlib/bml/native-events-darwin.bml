   nothing?(repeat) ? oac-nothing() : (String) bmr-action(nothing(),record_get(repeat,"passes"),1,!((Value) cursor == record_get(repeat,"cursor"))) != "next" ? oac-node(intern_trivial_string("repeat retry needs a changed checkpoint"))
   : nve-repeat-yield(owner,event,cursor) ? oac-one(intern_trivial_int(1)) : oac-nothing();
