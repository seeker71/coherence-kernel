  def nve-take(owner) {
   let events = reverse(record_get(owner,"unhandled")); record_set(owner,"unhandled",list()); events;
  }
  def nve-turn(owner,millis) {
   let events = nve-wait(owner,millis);
   if nothing?(events) then nothing() else { nve-dispatch(owner,events); len(events); };
  }
  def nve-close-watches(owner,watches) {
   if nil?(watches) then 1 else {
    let first = nve-unwatch(owner,head(watches)); let rest = nve-close-watches(owner,tail(watches)); first && rest;
   };
  }
  def nve-close-regions(regions) {
   if nil?(regions) then 1 else {
