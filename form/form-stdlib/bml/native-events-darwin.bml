  }
  def nve-forget-continuation(owner,watch) {
   record_set(owner,"pending",nve-forget(nve-pending(owner),watch)); record_set(watch,"continuation",nothing()); record_set(watch,"queued",0); record_set(watch,"next-binding",nothing()); 1;
  }
  def nve-deliver(owner,event,binding,memory) {
