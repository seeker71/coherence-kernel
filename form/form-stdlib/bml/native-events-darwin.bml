   };
  }
  def nve-repeat-next(cursor) = record_new(0,"kind","native-repeat-next","cursor",cursor);
  def nve-repeat-next?(value) = (String) value_kind(value) == "record" ? ((Value) record_get(value,"kind") == "native-repeat-next") : false;
  def nve-repeat-enter(event,binding) {
   len(binding) > 3 ? record_set(record_get(nve-event-watch(event),"repeat"),"cursor",binding[3]) : 0;
  }
  def nve-repeat-receive(context,event) {
   let repeat = record_get(nve-event-watch(event),"repeat"); let receiver = record_get(repeat,"receiver");
   record_set(repeat,"attempts",record_get(repeat,"attempts") + 1);
