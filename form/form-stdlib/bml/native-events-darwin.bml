  def nve-release-code(owner) {
   let state = record_get(owner,"code-live");
   if ((Comparable) state == 2) then 1 else {
    let status = jit_leaf_inram(list(1,record_get(owner,"identity"),list()),0);
    if (((Comparable) status == 1) || (((Comparable) state == 0) && ((Comparable) status == 0))) then { record_set(owner,"code-live",2); 1; } else 0;
   };
  }
 }
