   nve-repeat-next?(result) ? {
    let cursor = record_get(result,"cursor");
    let action = bmr-action(nothing(),record_get(repeat,"passes"),1,!((Value) cursor == record_get(repeat,"cursor")));
    (String) action == "next" ? {
     record_set(repeat,"passes",record_get(repeat,"passes") + 1); nve-repeat-yield(record_get(nve-event-watch(event),"owner"),event,cursor);
