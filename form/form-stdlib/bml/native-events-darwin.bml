  }
  def nve-take(owner) {
   let events = reverse(record_get(owner,"unhandled")); record_set(owner,"unhandled",list()); events;
  }
  def nve-turn(owner,millis) = nve-turn-slices(owner,millis,1);
  def nve-turn-slices(owner,millis,slices) = !nve-nonnegative(millis) ? nve-note(owner,"wait","expected nonnegative milliseconds") : !nve-nonnegative(slices) ? nve-note(owner,"slice-grant","expected nonnegative slices") : nve-turn-ready(owner,millis,slices);
