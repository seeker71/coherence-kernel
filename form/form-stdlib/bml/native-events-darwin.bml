// Owned Darwin ARM64 event queues, emitted by Form in RAM. SDK kevent64_s
// is 48 bytes; tokens name registrations and are never recycled by an owner.
// Callbacks run in the receiving Form context after the complete batch is read.
// preludes: form-stdlib/bml/native-pty-darwin.bml form-stdlib/organ-health.bml
section [form.bml] {
 class NativeEventsDarwin {
  def nve-image() {
   let rows = npd-cat(list(
    npd-route(0,"pid"),npd-route(1,"queue"),npd-route(2,"events"),npd-route(3,"copy"),npd-route(4,"fcntl"),
    list(fa-movz-x(0,22),npd-branch(14,"negate")),
    list(npd-label("pid")),npd-sys(20),list(npd-label("queue")),npd-sys(362),
    list(npd-label("events")),npd-shift3(),list(fa-add-x-imm(3,4,0),fa-add-x-imm(4,5,0),fa-add-x-imm(5,6,0),fa-add-x-imm(6,7,0)),npd-sys(369),
    list(npd-label("fcntl")),npd-shift3(),npd-sys(92),
    list(npd-label("copy"),fa-add-x-imm(0,3,0),npd-label("copy-loop"),fa-cmp-x(3,0),npd-branch(0,"return"),fa-ldrb(8,2,0),fa-strb(8,1,0),fa-add-x-imm(1,1,1),fa-add-x-imm(2,2,1),fa-sub-x-imm(3,3,1),npd-branch(14,"copy-loop")),
    list(npd-label("syscall"),fa-movk-x-16(16,512),fa-svc(128),npd-branch(3,"return"),npd-label("negate"),fa-asm(3405774848,list(1,32,65536),list(0,31,0)),npd-label("return"),fa-ret())));
   fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
  }
  def nve-active(owner) = record?(owner) && ((String) record_get(owner,"kind") == "native-event-owner") && ((Comparable) record_get(owner,"pid") == host_pid()) && record_get(owner,"active");
  def nve-ready(owner) = nve-active(owner) && (record_get(owner,"queue") >= 0) && !nothing?(record_get(owner,"buffer"));
  def nve-call(owner,args) {
   if !nve-active(owner) then nothing() else {
    record_set(owner,"calls",(record_get(owner,"calls") + 1));
    jit_leaf_inram(record_get(owner,"request"),args);
   };
  }
  def nve-note(owner,aspect,result) {
   let flow = str_concat(int_to_str(record_get(owner,"pid")),str_concat(":",str_concat(int_to_str(owner),str_concat(":",int_to_str(record_get(owner,"id"))))));
   let row = oh-reading("native-events",flow,aspect,json-node-string("available"),json-node-string(result),json-node-int(0),list(oh-need("host-event-resource",json-node-string(aspect))),list("observe-resource","release"),json-node-null());
   record_set(owner,"reading",row); oh-frame(row); nothing();
  }
  def nve-open() {
   let memory = npd-open();
   let owner = record_new(0,"kind","native-event-owner","id",host_monotonic_ms(),"pid",host_pid(),"active",1,"memory",memory,"buffer",nothing(),"queue",-1,"next",0,"watches",list(),"calls",0,"waits",0,"delivered",0,"callbacks",0,"unhandled",list(),"reading",nothing(),"code-live",0);
   let image = nve-image();
