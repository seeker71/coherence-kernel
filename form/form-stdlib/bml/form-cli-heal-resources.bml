// Pure resource planning: every eligible artifact has its own completion row.
// witnessed: 2026-09-07 -> 8191, four kernels
// preludes: form-stdlib/bml/form-cli-heal-policy.bml
section [form.bml] {
    class FormCliHealResources {
        def fhr-token(text, word) = fh-has(fh-cat(list(" ", text, " ")), fh-cat(list(" ", word, " ")));
        def fhr-repair-role(roles) = fhr-token(roles, "answer") || (fhr-token(roles, "fast-answer") || fhr-token(roles, "code"));
        def fhr-member(xs, value) = nil?(xs) ? 0 : (String) head(xs) == value ? 1 : fhr-member(tail(xs), value);
        def fhr-empty(row) = ((String) fh-trim(row) == "") || ((String) fh-trim(row) == "0");
        def fhr-bit(ready, key) = !((Comparable) fhr-token(ready, key ++ "=0") == fhr-token(ready, key ++ "=1"));
        def fhr-readiness-valid(ready) = fhr-bit(ready, "artifact") && (fhr-bit(ready, "native") && (fhr-bit(ready, "seal") && fhr-bit(ready, "tokfast")));
        def fhr-fields-valid(fields) = !((Comparable) len(fields) == 4) ? 0 : ((!((String) head(fields) == "")) && ((!((String) fields[1] == "")) && ((!((String) fields[2] == "")) && fhr-readiness-valid(fields[3]))));
        def fhr-valid(rows) = fhr-valid-go(rows, list(), 0);
        def fhr-valid-go(rows, names, count) = nil?(rows) ? (count > 0) : fhr-empty(head(rows)) ? fhr-valid-go(tail(rows), names, count) : fhr-valid-row(rows, names, count, split-on(head(rows), "\t"));
        def fhr-valid-row(rows, names, count, fields) = !fhr-fields-valid(fields) ? 0 : fhr-member(names, head(fields)) ? 0 : fhr-valid-go(tail(rows), cons(head(fields), names), count + 1);
        def fhr-reason(fields) = !fhr-fields-valid(fields) ? "malformed-inventory" : !fhr-repair-role(fields[2]) ? "role-not-repair" : fhr-readiness(fields[3]);
        def fhr-readiness(ready) = !fhr-token(ready, "artifact=1") ? "artifact-absent" : !fhr-token(ready, "native=1") ? "lane-unavailable" : !fhr-token(ready, "seal=1") ? "seal-absent" : !fhr-token(ready, "tokfast=1") ? "tokenizer-index-absent" : "eligible";
        // Plan row: registry name, artifact path, eligibility reason, stage id.
        // Registry order is retained; aliases of an eligible path share one try.
        def fhr-plan(rows) = fhr-plan-go(rows, list(), 0);
        def fhr-plan-go(rows, paths, index) = nil?(rows) ? list() : fhr-empty(head(rows)) ? fhr-plan-go(tail(rows), paths, index) : fhr-plan-row(rows, paths, index, split-on(head(rows), "\t"));
        def fhr-plan-row(rows, paths, index, fields) = !fhr-fields-valid(fields) ? cons(list("", "", "malformed-inventory", ""), fhr-plan-go(tail(rows), paths, index)) : fhr-plan-reason(rows, paths, index, fields, fhr-reason(fields));
        def fhr-plan-reason(rows, paths, index, fields, reason) {
            let eligible = ((String) reason == "eligible") && (!fhr-member(paths, fields[1]));
            let why = ((String) reason == "eligible") && (!eligible) ? "duplicate-artifact" : reason;
            let stage = eligible ? "native-model-" ++ int_to_str(index) : "";
            cons(list(head(fields), fields[1], why, stage), fhr-plan-go(tail(rows), eligible ? cons(fields[1], paths) : paths, eligible ? (index + 1) : index));
        }
        def fhr-eligible(plan) = nil?(plan) ? list() : (String) head(plan)[2] == "eligible" ? cons(head(plan), fhr-eligible(tail(plan))) : fhr-eligible(tail(plan));
        def fhr-plan-text(plan) = nil?(plan) ? "" : fh-cat(list(head(head(plan)), "\t", head(plan)[1], "\t", head(plan)[2], "\t", head(plan)[3], "\n", fhr-plan-text(tail(plan))));
        def fhr-completion(row) = row[3] ++ "-complete";
        def fhr-completed(log, row) = fh-has("\n" ++ log, fh-cat(list("\n", fhr-completion(row), "\tmodel=", head(row), ";result=")));
        def fhr-pending(plan, log) = nil?(plan) ? 0 : ((((String) head(plan)[2] == "eligible") && (!fhr-completed(log, head(plan))) ? 1 : 0) + fhr-pending(tail(plan), log));
        def fhr-model(plan, name) = nil?(plan) ? "" : ((String) head(plan)[2] == "eligible") && ((String) head(head(plan)) == name) ? name : fhr-model(tail(plan), name);
    }
    0;
}
