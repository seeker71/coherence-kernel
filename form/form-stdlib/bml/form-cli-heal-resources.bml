// Pure resource planning: every eligible artifact has its own completion row.
// witnessed: 2026-09-07 -> 8191
import form-stdlib/bml/form-cli-heal-policy.bml;
section [form.bml] {
    class FormCliHealResources {
        def fhr-token(text, word) = fh-has(fh-cat([" ", text, " "]), fh-cat([" ", word, " "]));
        def fhr-repair-role(roles) = (fhr-token(roles, "answer") || (fhr-token(roles, "fast-answer") || fhr-token(roles, "code")));
        def fhr-member(xs, value) = if nil?(xs) then 0 else if ((String) xs[0] == value) then 1 else fhr-member(xs[1:], value);
        def fhr-empty(row) = (((String) fh-trim(row) == "") || ((String) fh-trim(row) == "0"));
        def fhr-bit(ready, key) = (!((Comparable) fhr-token(ready, (key + "=0")) == fhr-token(ready, (key + "=1"))));
        def fhr-readiness-valid(ready) = (fhr-bit(ready, "artifact") && (fhr-bit(ready, "native") && (fhr-bit(ready, "seal") && fhr-bit(ready, "tokfast"))));
        def fhr-fields-valid(fields) = if (!((Comparable) len(fields) == 4)) then 0 else ((!((String) fields[0] == "")) && ((!((String) fields[1] == "")) && ((!((String) fields[2] == "")) && fhr-readiness-valid(fields[3]))));
        def fhr-valid(rows) = fhr-valid-go(rows, [], 0);
        def fhr-valid-go(rows, names, count) = if nil?(rows) then (count > 0) else if fhr-empty(rows[0]) then fhr-valid-go(rows[1:], names, count) else fhr-valid-row(rows, names, count, split-on(rows[0], "\t"));
        def fhr-valid-row(rows, names, count, fields) = if (!fhr-fields-valid(fields)) then 0 else if fhr-member(names, fields[0]) then 0 else fhr-valid-go(rows[1:], cons(fields[0], names), (count + 1));
        def fhr-reason(fields) = if (!fhr-fields-valid(fields)) then "malformed-inventory" else if (!fhr-repair-role(fields[2])) then "role-not-repair" else fhr-readiness(fields[3]);
        def fhr-readiness(ready) = if (!fhr-token(ready, "artifact=1")) then "artifact-absent" else if (!fhr-token(ready, "native=1")) then "lane-unavailable" else if (!fhr-token(ready, "seal=1")) then "seal-absent" else if (!fhr-token(ready, "tokfast=1")) then "tokenizer-index-absent" else "eligible";
        // Plan row: registry name, artifact path, eligibility reason, stage id.
        // Registry order is retained; aliases of an eligible path share one try.
        def fhr-plan(rows) = fhr-plan-go(rows, [], 0);
        def fhr-plan-go(rows, paths, index) = if nil?(rows) then [] else if fhr-empty(rows[0]) then fhr-plan-go(rows[1:], paths, index) else fhr-plan-row(rows, paths, index, split-on(rows[0], "\t"));
        def fhr-plan-row(rows, paths, index, fields) = if (!fhr-fields-valid(fields)) then cons(["", "", "malformed-inventory", ""], fhr-plan-go(rows[1:], paths, index)) else fhr-plan-reason(rows, paths, index, fields, fhr-reason(fields));
        def fhr-plan-reason(rows, paths, index, fields, reason) {
            let eligible = (((String) reason == "eligible") && (!fhr-member(paths, fields[1])));
            let why = if (((String) reason == "eligible") && (!eligible)) then "duplicate-artifact" else reason;
            let stage = if eligible then ("native-model-" + index.str()) else "";
            cons([fields[0], fields[1], why, stage], fhr-plan-go(rows[1:], if eligible then cons(fields[1], paths) else paths, if eligible then (index + 1) else index));
        }
        def fhr-eligible(plan) = if nil?(plan) then [] else if ((String) plan[0][2] == "eligible") then cons(plan[0], fhr-eligible(plan[1:])) else fhr-eligible(plan[1:]);
        def fhr-plan-text(plan) = if nil?(plan) then "" else fh-cat([plan[0][0], "\t", plan[0][1], "\t", plan[0][2], "\t", plan[0][3], "\n", fhr-plan-text(plan[1:])]);
        def fhr-completion(row) = (row[3] + "-complete");
        def fhr-completed(log, row) = fh-has(("\n" + log), fh-cat(["\n", fhr-completion(row), "\tmodel=", row[0], ";result="]));
        def fhr-pending(plan, log) = if nil?(plan) then 0 else ((if (((String) plan[0][2] == "eligible") && (!fhr-completed(log, plan[0]))) then 1 else 0) + fhr-pending(plan[1:], log));
        def fhr-model(plan, name) = if nil?(plan) then "" else if (((String) plan[0][2] == "eligible") && ((String) plan[0][0] == name)) then name else fhr-model(plan[1:], name);
    }
    0;
}
