// Pure resource planning: every eligible artifact has its own completion row.
// witnessed: 2026-09-07 -> 8191, four kernels
// preludes: form-stdlib/bml/form-cli-heal-policy.bml
section [form.bml] {
    class FormCliHealResources {
        def fhr-token(text, word) = fh-has(fh-cat(list(" ", text, " ")), fh-cat(list(" ", word, " ")));
        def fhr-repair-role(roles) = (fhr-token(roles, "answer") || (fhr-token(roles, "fast-answer") || fhr-token(roles, "code")));
        def fhr-member(xs, value) = if nil?(xs) then 0 else if ((String) head(xs) == value) then 1 else fhr-member(tail(xs), value);
        def fhr-empty(row) = (((String) fh-trim(row) == "") || ((String) fh-trim(row) == "0"));
        def fhr-bit(ready, key) = (!((Comparable) fhr-token(ready, str_concat(key, "=0")) == fhr-token(ready, str_concat(key, "=1"))));
        def fhr-readiness-valid(ready) = (fhr-bit(ready, "artifact") && (fhr-bit(ready, "native") && (fhr-bit(ready, "seal") && fhr-bit(ready, "tokfast"))));
        def fhr-fields-valid(fields) = if (!((Comparable) len(fields) == 4)) then 0 else ((!((String) head(fields) == "")) && ((!((String) nth(fields, 1) == "")) && ((!((String) nth(fields, 2) == "")) && fhr-readiness-valid(nth(fields, 3)))));
        def fhr-valid(rows) = fhr-valid-go(rows, list(), 0);
        def fhr-valid-go(rows, names, count) = if nil?(rows) then (count > 0) else if fhr-empty(head(rows)) then fhr-valid-go(tail(rows), names, count) else fhr-valid-row(rows, names, count, split-on(head(rows), "\t"));
        def fhr-valid-row(rows, names, count, fields) = if (!fhr-fields-valid(fields)) then 0 else if fhr-member(names, head(fields)) then 0 else fhr-valid-go(tail(rows), cons(head(fields), names), (count + 1));
        def fhr-reason(fields) = if (!fhr-fields-valid(fields)) then "malformed-inventory" else if (!fhr-repair-role(nth(fields, 2))) then "role-not-repair" else fhr-readiness(nth(fields, 3));
        def fhr-readiness(ready) = if (!fhr-token(ready, "artifact=1")) then "artifact-absent" else if (!fhr-token(ready, "native=1")) then "lane-unavailable" else if (!fhr-token(ready, "seal=1")) then "seal-absent" else if (!fhr-token(ready, "tokfast=1")) then "tokenizer-index-absent" else "eligible";
        // Plan row: registry name, artifact path, eligibility reason, stage id.
        // Registry order is retained; aliases of an eligible path share one try.
        def fhr-plan(rows) = fhr-plan-go(rows, list(), 0);
        def fhr-plan-go(rows, paths, index) = if nil?(rows) then list() else if fhr-empty(head(rows)) then fhr-plan-go(tail(rows), paths, index) else fhr-plan-row(rows, paths, index, split-on(head(rows), "\t"));
        def fhr-plan-row(rows, paths, index, fields) = if (!fhr-fields-valid(fields)) then cons(list("", "", "malformed-inventory", ""), fhr-plan-go(tail(rows), paths, index)) else fhr-plan-reason(rows, paths, index, fields, fhr-reason(fields));
        def fhr-plan-reason(rows, paths, index, fields, reason) {
            let eligible = (((String) reason == "eligible") && (!fhr-member(paths, nth(fields, 1))));
            let why = if (((String) reason == "eligible") && (!eligible)) then "duplicate-artifact" else reason;
            let stage = if eligible then str_concat("native-model-", int_to_str(index)) else "";
            cons(list(head(fields), nth(fields, 1), why, stage), fhr-plan-go(tail(rows), if eligible then cons(nth(fields, 1), paths) else paths, if eligible then (index + 1) else index));
        }
        def fhr-eligible(plan) = if nil?(plan) then list() else if ((String) nth(head(plan), 2) == "eligible") then cons(head(plan), fhr-eligible(tail(plan))) else fhr-eligible(tail(plan));
        def fhr-plan-text(plan) = if nil?(plan) then "" else fh-cat(list(head(head(plan)), "\t", nth(head(plan), 1), "\t", nth(head(plan), 2), "\t", nth(head(plan), 3), "\n", fhr-plan-text(tail(plan))));
        def fhr-completion(row) = str_concat(nth(row, 3), "-complete");
        def fhr-completed(log, row) = fh-has(str_concat("\n", log), fh-cat(list("\n", fhr-completion(row), "\tmodel=", head(row), ";result=")));
        def fhr-pending(plan, log) = if nil?(plan) then 0 else ((if (((String) nth(head(plan), 2) == "eligible") && (!fhr-completed(log, head(plan)))) then 1 else 0) + fhr-pending(tail(plan), log));
        def fhr-model(plan, name) = if nil?(plan) then "" else if (((String) nth(head(plan), 2) == "eligible") && ((String) head(head(plan)) == name)) then name else fhr-model(tail(plan), name);
    }
    0;
}
