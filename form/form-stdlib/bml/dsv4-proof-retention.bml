// Preserve a completed proof directory before its caller removes that directory.
// Form owns the request, the physical directory admission, the ustar archive (tar-ustar.bml writes it; no program runs), the new
// archive's exclusive publication and its readback. The capture record of the writing stays private beside the evidence.
// The caller owns the source directory and the archive's subsequent lifetime.
// preludes: form-stdlib/bml/native-source-inventory.bml form-stdlib/bml/dsv4-oracle-input.bml form-stdlib/bml/dsv4-view-publication.bml form-stdlib/bml/tar-ustar.bml
section [form.bml] {
 class Dsv4ProofRetention {
  def dpa-parse(bytes) {
   let fields = split-on(dsi-without-final-lf(bytes),byte_to_str(0));
   if (!((Comparable) len(fields) == 5)) then dqi-refused("four NUL-terminated archive fields required") else if (!(((String) head(fields) == "DPA1") && (((String) nth(fields,3) == "END") && ((String) nth(fields,4) == "")))) then dqi-refused("complete archive framing required") else if (!(dqi-path(nth(fields,1)) && dqi-path(nth(fields,2)))) then dqi-refused("nonempty source directory and new archive paths required") else record_new(0,"ready",1,"reason","complete proof archive request","source",nth(fields,1),"destination",nth(fields,2));
  }
  def dpa-observe(id,aspect,ok,evidence) {
   let row = oh-reading("dsv4-proof-retention",id,aspect,json-node-int(1),json-node-int(ok),json-node-int(ok),list(),list("continue","request-evidence"),evidence);
   oh-voice(row); let response = oh-response(row,if ok then "continue" else "request-evidence"); oh-voice(response);
   let action = oh-select(row,response,"request-evidence"); oh-voice(oh-applied(row,action,evidence)); ok;
  }
  def dpa-operating-path(path) = if ((String) substring(path,0,1) == "/") then path else str_concat("./",path);
  // Form reads the complete physical path of a directory (realpath: every link resolved) and decides containment.
  def dpa-directory(path) {
   let physical = host_realpath(dpa-operating-path(path));
   let ready = ((String) value_kind(physical) == "string") && ((str_len(physical) > 1) || ((String) physical == "/")) && ((String) substring(physical,0,1) == "/") && ((Comparable) fs_is_dir(physical) == 1);
   record_new(0,"ready",if ready then 1 else 0,"path",if ready then physical else "","capture","");
  }
  def dpa-within(path,directory) = (((String) directory == "/") || (((String) path == directory) || ((Comparable) str_find(path,str_concat(directory,"/"),0) == 0)));
  def dpa-refused(reason) {
   dpa-observe(str_concat("archive-admission-",int_to_str(host_pid())),"complete-archive-admission",0,json-node-string(reason));
   record_new(0,"ready",0,"reason",reason,"capture","","child-exit",-1);
  }
  def dpa-retain(source,destination) = if (!(dqi-path(source) && dqi-path(destination))) then dpa-refused("complete NUL-free source and archive paths required") else dpa-directories(source,destination);
  def dpa-directories(source,destination) {
   let parent = dpa-directory(fs-path-dirname(destination)); let input = dpa-directory(source); let captures = dpa-directory(".hearth");
   if (!((Comparable) record_get(parent,"ready") == 1)) then dpa-directory-refused(parent) else if (!((Comparable) record_get(input,"ready") == 1)) then dpa-directory-refused(input) else if (!((Comparable) record_get(captures,"ready") == 1)) then dpa-directory-refused(captures) else dpa-directories-admitted(record_get(input,"path"),record_get(parent,"path"),record_get(captures,"path"),destination);
  }
  def dpa-directory-refused(directory) {
   let refused = dpa-refused("complete physical directory admission refused; OS capture retained"); record_set(refused,"capture",record_get(directory,"capture")); refused;
  }
  def dpa-directories-admitted(input,parent,captures,destination) = if (dpa-within(parent,input) || dpa-within(captures,input)) then dpa-refused("archive and capture directories must remain outside the source directory") else dpa-capture(input,fs-path-join(parent,fs-path-basename(destination)));
  // The private evidence directory of one writing: owner-only, new (a name that stands is never reused).
  def dpa-job() {
   let made = fs_mkdir(".hearth");
   dpa-job-try(0);
  }
  def dpa-job-try(attempt) {
   let path = str_concat(".hearth/proof-archive-",str_concat(int_to_str(host_pid()),str_concat("-",str_concat(int_to_str(host_monotonic_ms()),str_concat("-",int_to_str(attempt))))));
   if ((Comparable) host_mkdir_mode(path,448) == 1) then path else if (attempt >= 32) then form_error("proof archive cannot create its private evidence directory") else dpa-job-try(attempt + 1);
  }
  // The capture shape is the one the publication below reads: accepted bytes, exit (0: the writer ran to its end), the archive, the evidence path.
  def dpa-capture(source,destination) {
   let job = dpa-job(); let made = ust-tree(source);
   let complete = (((String) made[0] == "") && (str_len(made[1]) > 0));
   let report = json-emit-precise(json-node-object(list(oh-s("schema","proof-archive-capture-v1"),oh-s("writer","form-ustar"),oh-n("entries",made[2]),oh-n("bytes",str_len(made[1])),oh-n("complete",if complete then 1 else 0),oh-s("reason",made[0]),oh-n("observed_at_ms",now_unix_ms()))));
   if ((Comparable) write_file(nsi-path(job,"capture.json"),report) != str_len(report)) then form_error("proof archive cannot retain capture status") else dpa-captured(job,complete,made,destination);
  }
  def dpa-captured(job,complete,made,destination) {
   let captured = list(complete,if complete then 0 else -1,made[1],job);
   dpa-observe(job,"complete-archive-capture",complete,oh-reference(nsi-path(job,"capture.json")));
   if (!complete) then record_new(0,"ready",0,"reason","archive command or complete stream refused","capture",job,"child-exit",nsi-status(captured)) else dpa-publish(captured,destination);
  }
  def dpa-publish(captured,destination) {
   let published = dtvp-new(destination,nsi-text(captured)); let job = nsi-evidence(captured);
   let held = if ((Comparable) record_get(published,"ready") == 1) then fbc-read-exact(destination,0) else nothing();
   let ready = if nothing?(held) then 0 else (fbc-good(held) && ((String) fbc-value(held) == nsi-text(captured)));
   dpa-observe(job,"exclusive-archive-publication",ready,json-node-object(list(oh-s("archive",destination),oh-n("bytes",str_len(nsi-text(captured))),oh-n("ready",ready),oh-s("disposition",record_get(published,"disposition")))));
   record_new(0,"ready",ready,"reason",if ready then "complete new archive and settled publication" else "archive publication or readback refused","capture",job,"child-exit",nsi-status(captured),"publication",published,"archive",destination,"bytes",str_len(nsi-text(captured)));
  }
  def dpa-run(request) {
   dfo-require(((Comparable) record_get(request,"ready") == 1),record_get(request,"reason"));
   let result = dpa-retain(record_get(request,"source"),record_get(request,"destination"));
   dfo-require(((Comparable) record_get(result,"ready") == 1),record_get(result,"reason")); 1;
  }
 }
 0;
}
