// Artifact comparison and the separate human symbol/source lens.
// preludes: form-stdlib/bml/formbin-codec.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 class FormbinArtifacts {
  def fba-s(key, value) = json-node-pair(key, json-node-string(value));
  def fba-n(key, value) = json-node-pair(key, json-node-int(value));
  def fba-b(key, value) = json-node-pair(key, json-node-bool(value));
  def fba-diff(source, target) = fba-diff-readings(source, target, fbc-read-exact(source, fbc-max-bytes()), fbc-read-exact(target, fbc-max-bytes()));
  def fba-diff-readings(source, target, a, b) = if (!fbc-good(a)) then a else if (!fbc-good(b)) then b else fba-diff-read(source, target, fbc-value(a), fbc-value(b));
  def fba-diff-read(source, target, a, b) = fba-diff-loaded(source, target, fbc-decode(a), fbc-decode(b), ((String) a == b));
  def fba-diff-loaded(source, target, a, b, byteEqual) {
   if (!fbc-good(a)) then fbc-fail(str_concat(source, str_concat(": ", fbc-error(a))))
   else if (!fbc-good(b)) then fbc-fail(str_concat(target, str_concat(": ", fbc-error(b))))
   else fba-diff-structure(source, target, a, b, fbc-structural(fbc-value(a)), fbc-structural(fbc-value(b)), byteEqual);
  }
  def fba-diff-structure(source, target, a, b, sa, sb, byteEqual) = fbc-ok(json-node-object(list(
   fba-s("schema", "formbin2-structural-diff-v2"), fba-s("structural_encoding", "formbin2-value-tree-v1"),
   fba-s("source", source), fba-s("target", target),
   fba-n("source_node_count", nth(a, 3)), fba-n("target_node_count", nth(b, 3)),
   fba-s("source_structural_sha256", fbc-hash(sa)), fba-s("target_structural_sha256", fbc-hash(sb)),
   fba-b("structurally_equal", ((String) sa == sb)), fba-b("byte_equal", byteEqual)
  )), 0, 0);
  def fba-diff-json(source, target) = fba-diff-render(fba-diff(source, target));
  def fba-diff-render(result) = if fbc-good(result) then json-emit(fbc-value(result)) else json-emit(json-node-object(list(fba-s("schema", "formbin2-structural-diff-v2"), fba-s("status", "refused"), fba-s("error", fbc-error(result)))));
  def fba-nodeid(pkg, level, type, inst) = if (fbc-u32?(pkg) && (fbc-u32?(level) && (fbc-u32?(type) && fbc-u32?(inst)))) then list(pkg, level, type, inst) else nothing();
  def fba-nodeid-text(n) = if nothing?(n) then nothing() else str_concat("@", str_concat(int_to_str(head(n)), str_concat(".", str_concat(int_to_str(nth(n, 1)), str_concat(".", str_concat(int_to_str(nth(n, 2)), str_concat(".", int_to_str(nth(n, 3)))))))));
  def fba-digits(s, p) = if (p >= str_len(s)) then 1 else if ((str_byte_at(s, p) >= 48) && (str_byte_at(s, p) <= 57)) then fba-digits(s, (p + 1)) else 0;
  def fba-coordinate(s) = if (((Comparable) str_len(s) == 0) || (str_len(s) > 10)) then nothing() else if fba-digits(s, 0) then if fbc-u32?(str_to_int(s)) then str_to_int(s) else nothing() else nothing();
  def fba-nodeid-parse(s) = fba-nodeid-scan(s, if ((String) substring(s, 0, 1) == "@") then 1 else 0, if ((String) substring(s, 0, 1) == "@") then 1 else 0, list());
  def fba-nodeid-scan(s, start, p, parts) = if (p >= str_len(s)) then fba-nodeid-parts(reverse(cons(substring(s, start, p), parts))) else if ((Comparable) str_byte_at(s, p) == 46) then fba-nodeid-scan(s, (p + 1), (p + 1), cons(substring(s, start, p), parts)) else fba-nodeid-scan(s, start, (p + 1), parts);
  def fba-nodeid-parts(parts) = if (!((Comparable) len(parts) == 4)) then nothing() else fba-nodeid-checked(fba-coordinate(head(parts)), fba-coordinate(nth(parts, 1)), fba-coordinate(nth(parts, 2)), fba-coordinate(nth(parts, 3)));
  def fba-nodeid-checked(a, b, c, d) = if (nothing?(a) || (nothing?(b) || (nothing?(c) || nothing?(d)))) then nothing() else fba-nodeid(a, b, c, d);
  def fba-span(path, startOffset, endOffset, startLine, startCol, endLine, endCol) = json-node-object(list(fba-s("path", path), fba-n("start_offset", startOffset), fba-n("end_offset", endOffset), fba-n("start_line", startLine), fba-n("start_col", startCol), fba-n("end_line", endLine), fba-n("end_col", endCol)));
  def fba-lens-entry(nodeid, symbol, span) = json-node-pair(fba-nodeid-text(nodeid), json-node-object(list(fba-s("symbol", symbol), json-node-pair("span", span))));
  def fba-lens-symbol(lens, nodeid) = fba-lens-field(lens, nodeid, "symbol");
  def fba-lens-span(lens, nodeid) = fba-lens-field(lens, nodeid, "span");
  def fba-lens-field(lens, nodeid, key) {
   let name = fba-nodeid-text(nodeid);
   if nothing?(name) then nothing() else if (!json-object-has?(lens, name)) then nothing()
   else fba-present-field(json-object-get(lens, name), key);
  }
  def fba-present-field(node, key) = if json-object-has?(node, key) then json-object-get(node, key) else nothing();
  def fba-lens-load(path) = if (!((Comparable) fs_exists(path) == 1)) then fbc-ok(json-node-object(list()), 0, 0) else fba-lens-read(path, fbc-read-exact(path, 0));
  def fba-lens-read(path, reading) = if fbc-good(reading) then fba-lens-parse(path, fbc-value(reading)) else reading;
  def fba-lens-parse(path, text) {
   if nothing?(text) then fbc-fail("unreadable source lens")
   else if (!(fbc-utf8(text, 0) && jwa-valid(text))) then fbc-fail("invalid source lens JSON")
   else fba-lens-parsed(faj-json(path, text));
  }
  def fba-lens-parsed(node) = if node_eq(node_category(node), JSON-OBJECT()) then fbc-ok(node, 0, 0) else fbc-fail("source lens must be a JSON object");
  def fba-lens-write(path, lens) = if (!node_eq(node_category(lens), JSON-OBJECT())) then fbc-fail("source lens must be a JSON object") else fba-lens-written(path, json-emit(lens));
  def fba-lens-written(path, text) = if ((Comparable) write_file(path, text) == str_len(text)) then fbc-ok(text, 0, 0) else fbc-fail("source lens write incomplete");
  def fba-lens-path(path) = fba-lens-extension(path, (str_len(path) - 1));
  def fba-lens-extension(path, p) = if (p < 0) then str_concat(path, ".fkl") else if ((Comparable) str_byte_at(path, p) == 47) then str_concat(path, ".fkl") else if ((Comparable) str_byte_at(path, p) == 46) then if (((Comparable) p == 0) || ((Comparable) str_byte_at(path, (p - 1)) == 47)) then str_concat(path, ".fkl") else str_concat(substring(path, 0, p), ".fkl") else fba-lens-extension(path, (p - 1));
  def fba-ensure-parent(path) = fba-parent-prefix(path, 0);
  def fba-parent-prefix(path, p) = if (p >= str_len(path)) then 1 else if ((p > 0) && ((Comparable) str_byte_at(path, p) == 47)) then if ((Comparable) fs_exists(substring(path, 0, p)) == 1) then fba-parent-prefix(path, (p + 1)) else if ((Comparable) host_dir_mkdir(substring(path, 0, p)) == 1) then fba-parent-prefix(path, (p + 1)) else 0 else fba-parent-prefix(path, (p + 1));
 }
 0;
}
