// Compiler input specimens: effects, values, name resolution and complete refusal.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class BmlStatementAdmissionFixtures {
  def bsaf-wrap(body) = str_concat("// preludes: form-stdlib/core.fk\nsection [form.bml] {\n",str_concat(body,"\n}\n"));
  // Each row holds name, complete body, exact stdout, actual exit and required diagnostic.
  def bsaf-cases() = list(
   list("inline-let-tail","class Example {\n def example() { let unused = 1; print_str(\"A\"); print_str(\"B\"); 9; }\n}\nexample();","A\nB\n9\n",0,""),
   list("inline-no-let-tail","class Example {\n def example() { print_str(\"A\"); print_str(\"B\"); 9; }\n}\nexample();","A\nB\n9\n",0,""),
   list("ordinary-block-multiple-statements","class Example {\n def example() {\n let unused = 1; print_str(\"A\"); print_str(\"B\"); 9;\n }\n}\nexample();","A\nB\n9\n",0,""),
   list("top-level-inline-let","def example() { let unused = 1; print_str(\"A\"); print_str(\"B\"); 9; }\nexample();","A\nB\n9\n",0,""),
   list("nested-do-end-selected","class Example {\n def example(x) = if x then do print_str(\"A\"); print_str(\"B\"); 9; end else 7;\n}\nexample(1);","A\nB\n9\n",0,""),
   list("nested-do-end-unselected","class Example {\n def example(x) = if x then do form_error(\"unselected branch executed\"); 9; end else 7;\n}\nexample(0);","7\n",0,""),
   list("nested-do-brace-selected","class Example {\n def example(x) = if x then do { print_str(\"A\"); if 0 then form_error(\"unselected nested branch\") else 0; print_str(\"B\"); 9; } else 7;\n}\nexample(1);","A\nB\n9\n",0,""),
   list("standalone-do-binding","class Example {\n def example() {\n let x = do { print_str(\"A\"); 3; };\n add(x,6);\n }\n}\nexample();","A\n9\n",0,""),
   list("quoted-punctuation","class Example {\n def example() {\n print_str(\"A;{B}//\\\"C\"); 9;\n }\n}\nexample();","A;{B}//\"C\n9\n",0,""),
   list("whole-line-comment-punctuation","class Example {\n def example() {\n // punctuation ; } quote \" is commentary\n print_str(\"A\"); 9;\n }\n}\nexample();","A\n9\n",0,""),
   list("inline-opener-comment","class Example {\n def example() { // punctuation ; } quote \" is commentary\n print_str(\"A\"); 9;\n }\n}\nexample();","A\n9\n",0,""),
   list("multiline-call-comment","class Example {\n def example() {\n let x = add(1, // punctuation ; } is commentary\n 8);\n x;\n }\n}\nexample();","9\n",0,""),
   list("failure-after-printed-number","class Example {\n def example() { let unused = 1; print(9); form_error(\"deliberate later refusal\"); print_str(\"UNREACHED\"); 0; }\n}\nexample();","9\n",1,"deliberate later refusal"),
   list("malformed-empty-body","class Example {\n def example() = ;\n}\nprint_str(\"UNREACHED\"); example();","",2,"empty"),
   list("same-line-class-and-method-suffix","class First { def first() { 4; } } class Second { def second() { add(first(),5); } } second();","9\n",0,""),
   list("method-literal-is-not-name-source","class Kit { def example() { \"ref shadow = Absent(); class Phantom {\"; 42; } } example();","42\n",0,""),
   list("same-line-ref-after-method-refuses","class Kit { def example() { 42; } ref missing = Absent(); } print_str(\"UNREACHED\"); example();","",2,"Absent"),
   list("top-level-do-brace","do { print_str(\"A\"); if 0 then form_error(\"unselected top-level\") else 0; print_str(\"B\"); 9; };","A\nB\n9\n",0,""),
   list("top-level-do-end","do print_str(\"A\"); print_str(\"B\"); 9; end;","A\nB\n9\n",0,""),
   list("do-end-first-parenthesized-statement","def example() = do (print(1)); 42; end; example();","1\n42\n",0,""),
   list("immediate-parenthesized-do-call","do(print(1),42);","1\n42\n",0,""),
   list("unclosed-class-body","class Example { def example() { 9; } print_str(\"UNREACHED\");","",2,"unclosed form.bml body"),
   list("mismatched-call-delimiter","class Example { def example() { add(1,2]; 9; } } print_str(\"UNREACHED\"); example();","",2,"mismatched form.bml delimiter"),
   list("unconsumed-call-suffix","class Example { def example() = add(1,2) add(3,4); } print_str(\"UNREACHED\"); example();","",2,"call requires one complete expression"),
   list("unconsumed-string-suffix","class Example { def example() = \"hello\" 9; } print_str(\"UNREACHED\"); example();","",2,"unconsumed form.bml string suffix"),
   list("unconsumed-do-suffix","class Example { def example() = do { 1; } 9; } print_str(\"UNREACHED\"); example();","",2,"unconsumed form.bml do suffix"),
   list("unknown-class-member-after-method","class Example { def example() { 9; } forgotten(); } print_str(\"UNREACHED\"); example();","",2,"unrecognized form.bml class member")
  );
  def bsaf-full-cases() = list(
   list("same-line-section-suffix","// preludes: form-stdlib/core.fk\nsection [form.bml] { def first() { 4; } } section [form.bml] { add(first(),5); }\n","9\n",0,""),
   list("same-line-names-and-refs","// preludes: form-stdlib/core.fk form-stdlib/tests/bml-import-ref-fixture.bml\nsection [form.bml] {\nimport Num; class Seed { field seed-value = 41; } class Kit { ref seed = Seed(); ref external = Num(); def example() { 42; } } list(example(),seed-value(),imported-value(),str_eq(nth(external(),1),\"Num\"),str_eq(nth(seed(),1),\"Seed\"));\n}\n","[42, 41, 13, 1, 1]\n",0,""),
   list("raw-form-prefix-and-suffix","// preludes: form-stdlib/core.fk\n(do (print_str \"P\") 42) ; raw Form comment ) }\nsection [form.bml] { def example() { 9; } }\n(do (print_str \"S\") (example)) ; raw Form comment ) }\n","P\nS\n9\n",0,""),
   list("custom-bmf-do-end-rule-data","// preludes: form-stdlib/compiler.fk form-stdlib/bmf-grammar.fk\n(defn review-op (value) (p-lit value))\n(defn review-kw (value) (p-lit value))\n(defn review-ref (value) (p-ref value))\n(defn review-emit (value) value)\nsection [review.bmf] {\n ; punctuation } ( \" in a whole-line rule comment\n do ::= \"}\" => review-emit;\n end ::= do => review-emit;\n}\n(let review-rules (bmf-section-rules (form-section-object review-bmf-second)))\n(let first-rule (head review-rules))\n(let second-rule (nth review-rules 1))\n(list (len review-rules) (head first-rule) (head second-rule) (head (nth first-rule 1)) (nth (nth first-rule 1) 1) (head (nth second-rule 1)) (nth (nth second-rule 1) 1))\n","[2, do, end, sequence, [lit, }], sequence, [ref, do]]\n",0,"")
  );
 }
 0;
}
