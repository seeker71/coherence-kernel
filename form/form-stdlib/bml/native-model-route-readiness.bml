package Form.native.modelroutereadiness;

import Form.kernel.*;
import Form.glass.telemetry.*;

interface INativeModelRouteReadiness [public, witness, resident] {
   section [public] {
      const String Schema = "native-model-route-readiness-v2";
      const String SeparationRule = "an open file, mapped bytes, a live process, and a last-observed positive context handle are separate from a currently usable route";
      const String FreshRule = "route freshness comes from lease-current OS process liveness with exact PID and process-start binding; an aged owner state snapshot remains usable only while that same owner lifetime is current";
      const String GlassJoinRule = "the live Glass sample join requires a lease-current physical OS-liveness row and an owner state stamp with matching PID and process-start fields, then owner-scoped model, loaded, and prefilled rows with one matching positive context handle; state timestamps remain their real last changes rather than heartbeat renewals";
      const String EvidenceRule = "current liveness plus retained owner state is derived-window readiness, not a fresh model invocation or physical page-residency claim";
      const String ParallelRule = "parallel-ready means both contexts are independently callable while retained in one owner; it does not claim simultaneous dependent Metal dispatch";
      const String MissingRule = "stale, unbound, heartbeat-free, malformed, or handle-inconsistent evidence returns typed unavailable rather than zero and carries one exact missing observation door separate from its reason";

      Object Fact( String id, Int present, Int value, String evidence, Int observedEpoch, String reason, String missingDoor ) [abstract];
      Object ModelRoute( Object snapshot, Int ownerAlive, String ownerBinding, Int nowEpoch, String modelId ) [abstract];
      Object ModelRouteFromCurrentSamples( Object samples, Int nowEpoch, String modelId ) [abstract];
      Object ParallelRoute( Object qwenFact, Object threebFact, Int observedEpoch ) [abstract];
   }
}

class NativeModelRouteReadiness [public, resident, observable, teach] : INativeModelRouteReadiness {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-route-readiness.bml";
      Object Fact( String id, Int present, Int value, String evidence, Int observedEpoch, String reason, String missingDoor ) [abstract] {}
      Object ModelRoute( Object snapshot, Int ownerAlive, String ownerBinding, Int nowEpoch, String modelId ) [abstract] {}
      Object ModelRouteFromCurrentSamples( Object samples, Int nowEpoch, String modelId ) [abstract] {}
      Object ParallelRoute( Object qwenFact, Object threebFact, Int observedEpoch ) [abstract] {}
   }
}
