// The manifest owns the generated flt-ops slice. Form writes and checks it.
// preludes: gate/lens-text.bml form-stdlib/native-op-manifest.fk form-stdlib/json.fk
section [form.bml] {
 class NativeOpEmitter {
  field NativeOpSlicePath = "form/form-stdlib/form-flatten.fk";
  def noe-end(s, i, depth, quoted, comment) = i >= str_len(s) ? -1 : noe-byte(s, i, depth, quoted, comment, str_byte_at(s, i));
  def noe-byte(s, i, depth, quoted, comment, b) = comment ? noe-end(s, i + 1, depth, 0, !((Comparable) b == 10)) : quoted ? ((Comparable) b == 92 ? noe-end(s, i + 2, depth, 1, 0) : noe-end(s, i + 1, depth, !((Comparable) b == 34), 0)) : (Comparable) b == 59 ? noe-end(s, i + 1, depth, 0, 1) : (Comparable) b == 34 ? noe-end(s, i + 1, depth, 1, 0) : (Comparable) b == 40 ? noe-end(s, i + 1, depth + 1, 0, 0) : (Comparable) b == 41 ? ((Comparable) depth == 1 ? (i + 1) : noe-end(s, i + 1, depth - 1, 0, 0)) : noe-end(s, i + 1, depth, 0, 0);
  def noe-valid(rows) = nil?(rows) ? 1 : ((head(rows)[1] >= 0) && ((head(rows)[2] >= 0) && noe-valid(tail(rows))));
  def noe-row(row) = "        (list " ++ json-emit(json-node-string(head(row))) ++ " " ++ fstr-int-to-str(row[1]) ++ " " ++ fstr-int-to-str(row[2]) ++ ")\n";
  def noe-rows(rows) = nil?(rows) ? "" : noe-row(head(rows)) ++ noe-rows(tail(rows));
  def noe-block(rows) = "(defn flt-ops ()\n    ; GENERATED from native-op-manifest.fk by native-op-emitter.bml\n    (list\n" ++ noe-rows(rows) ++ "    ))";
  def noe-replace(text, rows) {
   let start = str_find(text, "\n(defn flt-ops ()", 0);
   let at = (Comparable) str_find(text, "(defn flt-ops ()", 0) == 0 ? 0 : start < 0 ? -1 : (start + 1);
   let end = at < 0 ? -1 : noe-end(text, at, 0, 0, 0);
   (!noe-valid(rows)) || (end < 0) ? nothing() : substring(text, 0, at) ++ noe-block(rows) ++ substring(text, end, str_len(text));
  }
  def noe-check-command(command) {
   let out = lx-sh(command);
   let lines = lx-lines(out[1]);
   ((Comparable) head(out) == 0) && ((len(lines) > 0) && ((String) lines[len(lines) - 1] == "1"));
  }
  def noe-check() = noe-check-command("./fkwu gate/flt-ops-gen.bml");
  def noe-write() {
   let original = read_file(NativeOpSlicePath());
   let next = nothing?(original) ? nothing() : noe-replace(original, nom-ops());
   nothing?(next) ? "native-op-emitter needs a complete manifest and slice" : (String) original == next ? "native-op-emitter already current" : noe-publish(original, next);
  }
  def noe-publish(original, next) {
   let stage = NativeOpSlicePath() ++ ".staged-" ++ int_to_str(host_pid());
   let wrote = write_file(stage, next);
   (!((Comparable) wrote == str_len(next))) || (!((String) read_file(NativeOpSlicePath()) == original)) ? "native-op-emitter source changed; proposal retained" : noe-observe(stage, original);
  }
  def noe-observe(stage, original) = noe-observe-at(NativeOpSlicePath(), stage, original, "./fkwu gate/flt-ops-gen.bml");
  def noe-observe-at(path, stage, original, command) {
   let renamed = fs_rename(stage, path);
   !((Comparable) renamed == 0) ? "native-op-emitter publication failed" : noe-check-command(command) ? "native-op-emitter wrote and checked the manifest slice" : noe-restore-at(path, original);
  }
  def noe-restore-at(path, original) {
   let restored = write_file(path, original);
   ((Comparable) restored == str_len(original)) && ((String) read_file(path) == original) ? "native-op-emitter check failed; original restored" : "native-op-emitter check and restoration need attention";
  }
 }
 0;
}
