// The manifest owns the generated flt-ops slice. Form writes and checks it.
import form-stdlib/native-op-manifest.fk;
import form-stdlib/json.fk;
section [form.bml] {
 class NativeOpEmitter {
  field NativeOpSlicePath = "form/form-stdlib/form-flatten.fk";
  def noe-end(s, i, depth, quoted, comment) = if (i >= len(s)) then -1 else noe-byte(s, i, depth, quoted, comment, str_byte_at(s, i));
  def noe-byte(s, i, depth, quoted, comment, b) = if comment then noe-end(s, (i + 1), depth, 0, (!((Comparable) b == 10))) else if quoted then if ((Comparable) b == 92) then noe-end(s, (i + 2), depth, 1, 0) else noe-end(s, (i + 1), depth, (!((Comparable) b == 34)), 0) else if ((Comparable) b == 59) then noe-end(s, (i + 1), depth, 0, 1) else if ((Comparable) b == 34) then noe-end(s, (i + 1), depth, 1, 0) else if ((Comparable) b == 40) then noe-end(s, (i + 1), (depth + 1), 0, 0) else if ((Comparable) b == 41) then if ((Comparable) depth == 1) then (i + 1) else noe-end(s, (i + 1), (depth - 1), 0, 0) else noe-end(s, (i + 1), depth, 0, 0);
  def noe-valid(rows) = if nil?(rows) then 1 else ((rows[0][1] >= 0) && ((rows[0][2] >= 0) && noe-valid(rows[1:])));
  def noe-row(row) = ("        (list " + (json-emit(json-node-string(row[0])) + (" " + (fstr-int-to-str(row[1]) + (" " + (fstr-int-to-str(row[2]) + ")\n"))))));
  def noe-rows(rows) = if nil?(rows) then "" else ((String) noe-row(rows[0]) + noe-rows(rows[1:]));
  def noe-block(rows) = ("(defn flt-ops ()\n    ; GENERATED from native-op-manifest.fk by native-op-emitter.bml\n    (list\n" + (noe-rows(rows) + "    ))"));
  def noe-replace(text, rows) {
   let start = str_find(text, "\n(defn flt-ops ()", 0);
   let at = if ((Comparable) str_find(text, "(defn flt-ops ()", 0) == 0) then 0 else if (start < 0) then -1 else (start + 1);
   let end = if (at < 0) then -1 else noe-end(text, at, 0, 0, 0);
   if ((!noe-valid(rows)) || (end < 0)) then nothing() else (substring(text, 0, at) + ((String) noe-block(rows) + substring(text, end, len(text))));
  }
  // The check is a cell called in this process (cell_run): the gate answers 1 as its value, and it counts only when the
  // cell ran to its end with no compile error and no stop. Nothing is begun and no line of text is read back.
  def noe-check-cell(path) {
   let r = cell_run(path, 0, nothing(), nothing());
   !nothing?(r) && nothing?(record_get(r, "stopped")) && ((Comparable) record_get(r, "errors") == 0) && ((Comparable) record_get(r, "value") == 1);
  }
  def noe-check() = noe-check-cell("gate/flt-ops-gen.bml");
  def noe-write() {
   let original = read_file(NativeOpSlicePath());
   let next = if nothing?(original) then nothing() else noe-replace(original, nom-ops());
   if nothing?(next) then "native-op-emitter needs a complete manifest and slice" else if ((String) original == next) then "native-op-emitter already current" else noe-publish(original, next);
  }
  def noe-publish(original, next) {
   let stage = (NativeOpSlicePath() + (".staged-" + host_pid().str()));
   let wrote = write_file(stage, next);
   if ((!((Comparable) wrote == len(next))) || (!((String) read_file(NativeOpSlicePath()) == original))) then "native-op-emitter source changed; proposal retained" else noe-observe(stage, original);
  }
  def noe-observe(stage, original) = noe-observe-at(NativeOpSlicePath(), stage, original, "gate/flt-ops-gen.bml");
  def noe-observe-at(path, stage, original, cell) {
   let renamed = fs_rename(stage, path);
   if (!((Comparable) renamed == 0)) then "native-op-emitter publication failed" else if noe-check-cell(cell) then "native-op-emitter wrote and checked the manifest slice" else noe-restore-at(path, original);
  }
  def noe-restore-at(path, original) {
   let restored = write_file(path, original);
   if (((Comparable) restored == len(original)) && ((String) read_file(path) == original)) then "native-op-emitter check failed; original restored" else "native-op-emitter check and restoration need attention";
  }
 }
 0;
}
