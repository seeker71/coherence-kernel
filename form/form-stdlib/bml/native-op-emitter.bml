// The manifest owns the generated flt-ops slice. Form writes and checks it.
// preludes: gate/lens-text.bml form-stdlib/native-op-manifest.fk form-stdlib/json.fk
section [form.bml] {
 class NativeOpEmitter {
  field NativeOpSlicePath = "form/form-stdlib/form-flatten.fk";
  def noe-end(s, i, depth, quoted, comment) = if ge(i, str_len(s)) then -1 else noe-byte(s, i, depth, quoted, comment, str_byte_at(s, i));
  def noe-byte(s, i, depth, quoted, comment, b) = if comment then noe-end(s, add(i, 1), depth, 0, not(eq(b, 10))) else if quoted then if eq(b, 92) then noe-end(s, add(i, 2), depth, 1, 0) else noe-end(s, add(i, 1), depth, not(eq(b, 34)), 0) else if eq(b, 59) then noe-end(s, add(i, 1), depth, 0, 1) else if eq(b, 34) then noe-end(s, add(i, 1), depth, 1, 0) else if eq(b, 40) then noe-end(s, add(i, 1), add(depth, 1), 0, 0) else if eq(b, 41) then if eq(depth, 1) then add(i, 1) else noe-end(s, add(i, 1), sub(depth, 1), 0, 0) else noe-end(s, add(i, 1), depth, 0, 0);
  def noe-valid(rows) = if nil?(rows) then 1 else and(ge(nth(head(rows), 1), 0), and(ge(nth(head(rows), 2), 0), noe-valid(tail(rows))));
  def noe-row(row) = str_concat("        (list ", str_concat(json-emit(json-node-string(head(row))), str_concat(" ", str_concat(int_to_str(nth(row, 1)), str_concat(" ", str_concat(int_to_str(nth(row, 2)), ")\n"))))));
  def noe-rows(rows) = if nil?(rows) then "" else str_concat(noe-row(head(rows)), noe-rows(tail(rows)));
  def noe-block(rows) = str_concat("(defn flt-ops ()\n    ; GENERATED from native-op-manifest.fk by native-op-emitter.bml\n    (list\n", str_concat(noe-rows(rows), "    ))"));
  def noe-replace(text, rows) {
   let start = str_find(text, "\n(defn flt-ops ()", 0);
   let at = if eq(str_find(text, "(defn flt-ops ()", 0), 0) then 0 else if lt(start, 0) then -1 else add(start, 1);
   let end = if lt(at, 0) then -1 else noe-end(text, at, 0, 0, 0);
   if or(not(noe-valid(rows)), lt(end, 0)) then nothing() else str_concat(substring(text, 0, at), str_concat(noe-block(rows), substring(text, end, str_len(text))));
  }
  def noe-check-command(command) {
   let out = lx-sh(command);
   let lines = lx-lines(nth(out, 1));
   and(eq(head(out), 0), and(gt(len(lines), 0), str_eq(nth(lines, sub(len(lines), 1)), "1")));
  }
  def noe-check() = noe-check-command("./fkwu gate/flt-ops-gen.bml");
  def noe-write() {
   let original = read_file(NativeOpSlicePath());
   let next = if nothing?(original) then nothing() else noe-replace(original, nom-ops());
   if nothing?(next) then "native-op-emitter needs a complete manifest and slice" else if str_eq(original, next) then "native-op-emitter already current" else noe-publish(original, next);
  }
  def noe-publish(original, next) {
   let stage = str_concat(NativeOpSlicePath(), str_concat(".staged-", int_to_str(host_pid())));
   let wrote = write_file(stage, next);
   if or(not(eq(wrote, str_len(next))), not(str_eq(read_file(NativeOpSlicePath()), original))) then "native-op-emitter source changed; proposal retained" else noe-observe(stage, original);
  }
  def noe-observe(stage, original) = noe-observe-at(NativeOpSlicePath(), stage, original, "./fkwu gate/flt-ops-gen.bml");
  def noe-observe-at(path, stage, original, command) {
   let renamed = fs_rename(stage, path);
   if not(eq(renamed, 0)) then "native-op-emitter publication failed" else if noe-check-command(command) then "native-op-emitter wrote and checked the manifest slice" else noe-restore-at(path, original);
  }
  def noe-restore-at(path, original) {
   let restored = write_file(path, original);
   if and(eq(restored, str_len(original)), str_eq(read_file(path), original)) then "native-op-emitter check failed; original restored" else "native-op-emitter check and restoration need attention";
  }
 }
 0;
}
