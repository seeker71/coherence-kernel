// Complete held-byte Wiktionary interpretation. No transport or publication.
// The matching rules preserve the active substantive refresh selector.
// preludes: form/form-stdlib/bml/concept-translation.bml
section [form.bml] {
 class ConceptWiktionaryMeaning {
  def cwm-width(text,at) = if (str_byte_at(text,at) < 128) then 1 else if (str_byte_at(text,at) < 224) then 2 else if (str_byte_at(text,at) < 240) then 3 else 4;
  def cwm-code(text,at) = cwm-code-width(text,at,cwm-width(text,at));
  def cwm-cont(text,at,offset) = (str_byte_at(text,(at + offset)) - 128);
  def cwm-code-width(text,at,width) {
   let byte = str_byte_at(text,at);
   if ((Comparable) width == 1) then byte else if ((Comparable) width == 2) then (((byte - 192) * 64) + cwm-cont(text,at,1)) else if ((Comparable) width == 3) then (((byte - 224) * 4096) + ((cwm-cont(text,at,1) * 64) + cwm-cont(text,at,2))) else (((byte - 240) * 262144) + ((cwm-cont(text,at,1) * 4096) + ((cwm-cont(text,at,2) * 64) + cwm-cont(text,at,3))));
  }
  // ECMAScript whitespace includes Unicode spaces and line terminators.
  def cwm-space(code) = (((code >= 9) && (code <= 13)) || (((code >= 8192) && (code <= 8202)) || cwm-member-code(code,list(32,160,5760,8232,8233,8239,8287,12288,65279))));
  def cwm-skip(text,at) = if (at >= str_len(text)) then at else if cwm-space(cwm-code(text,at)) then cwm-skip(text,(at + cwm-width(text,at))) else at;
  def cwm-last(text,at,last) = if (at >= str_len(text)) then last else cwm-last(text,(at + cwm-width(text,at)),if cwm-space(cwm-code(text,at)) then last else (at + cwm-width(text,at)));
  def cwm-trim(text) = cwm-trim-span(text,cwm-skip(text,0),cwm-last(text,0,0));
  def cwm-trim-span(text,start,end) = if (start >= end) then "" else substring(text,start,end);
  def cwm-lower(text,at,bins) = if ((Comparable) at == str_len(text)) then fbc-finish(bins,"") else cwm-lower(text,(at + 1),fbc-put(bins,byte_to_str(if ((str_byte_at(text,at) >= 65) && (str_byte_at(text,at) <= 90)) then (str_byte_at(text,at) + 32) else str_byte_at(text,at))));
  def cwm-prefix(text,at,value) = (((at + str_len(value)) <= str_len(text)) && ((String) substring(text,at,(at + str_len(value))) == value));
  def cwm-member(value,values) = if nil?(values) then 0 else (((String) value == head(values)) || cwm-member(value,tail(values)));
  def cwm-valid(text) = (((String) value_kind(text) == "string") && fbc-utf8(text,0));
  def cwm-english(text) = if (!cwm-valid(text)) then ctr-bad("complete UTF-8 Wiktionary source required") else ctr-ok(cwm-english-find(text,0));
  def cwm-english-find(text,at) = if (at >= str_len(text)) then "" else if ((((Comparable) at == 0) || ((Comparable) str_byte_at(text,(at - 1)) == 10)) && cwm-prefix(text,at,"==English==")) then cwm-english-space(text,(at + 11),-1,(at + 1)) else cwm-english-find(text,(at + 1));
  def cwm-english-space(text,at,lastLf,retry) = if (at >= str_len(text)) then cwm-english-start(text,lastLf,retry) else if cwm-space(cwm-code(text,at)) then cwm-english-space(text,(at + cwm-width(text,at)),if ((Comparable) str_byte_at(text,at) == 10) then at else lastLf,retry) else cwm-english-start(text,lastLf,retry);
  def cwm-english-start(text,lastLf,retry) = if (lastLf < 0) then cwm-english-find(text,retry) else cwm-english-end(text,(lastLf + 1),(lastLf + 1));
  def cwm-english-end(text,start,at) = if (at >= str_len(text)) then substring(text,start,str_len(text)) else if (cwm-prefix(text,at,"\n==") && (((at + 3) < str_len(text)) && ((Comparable) str_byte_at(text,(at + 3)) != 61))) then substring(text,start,at) else cwm-english-end(text,start,(at + 1));
  def cwm-equals(text,at) = if ((at < str_len(text)) && ((Comparable) str_byte_at(text,at) == 61)) then cwm-equals(text,(at + 1)) else at;
  def cwm-name-end(text,at) = if ((at >= str_len(text)) || ((Comparable) str_byte_at(text,at) == 61)) then at else cwm-name-end(text,(at + 1));
  def cwm-heading(line) = cwm-heading-open(line,cwm-equals(line,0));
  def cwm-heading-open(line,count) = if ((count < 3) || (count > 6)) then nothing() else cwm-heading-name(line,count,count);
  def cwm-heading-name(line,count,start) = cwm-heading-close(line,count,start,cwm-name-end(line,start));
  def cwm-heading-close(line,count,start,end) = if (((Comparable) start == end) || ((Comparable) (cwm-equals(line,end) - end) != count)) then nothing() else if ((Comparable) cwm-skip(line,(end + count)) != str_len(line)) then nothing() else cwm-trim(substring(line,start,end));
  def cwm-section(name) = if cwm-member(cwm-lower(name,0,list()),list("noun","verb","adjective","adverb","interjection","preposition","determiner","conjunction","pronoun","numeral","particle")) then name else "";
  def cwm-dot(text,at) = if (at >= str_len(text)) then 1 else if cwm-member-code(cwm-code(text,at),list(10,13,8232,8233)) then 0 else cwm-dot(text,(at + cwm-width(text,at)));
  def cwm-member-code(value,values) = if nil?(values) then 0 else (((Comparable) value == head(values)) || cwm-member-code(value,tail(values)));
  def cwm-definition(line) = if (((Comparable) str_len(line) == 0) || ((Comparable) str_byte_at(line,0) != 35)) then nothing() else if ((str_len(line) > 1) && cwm-member-code(str_byte_at(line,1),list(35,42,58))) then nothing() else cwm-definition-text(cwm-trim(substring(line,1,str_len(line))));
  def cwm-definition-text(text) = if ((str_len(text) > 0) && cwm-dot(text,0)) then text else nothing();
  def cwm-word(code) = (((code >= 48) && (code <= 57)) || (((code >= 65) && (code <= 90)) || (((code >= 97) && (code <= 122)) || ((Comparable) code == 95))));
  def cwm-inflection-names() = list("third-person","plural of","past of","simple past","present participle","comparative of","superlative of","alternative form of","alternative spelling of","misspelling of","obsolete spelling of","inflection of","form of");
  def cwm-inflection-at(text,at,names) = if nil?(names) then 0 else if cwm-prefix(text,at,head(names)) then cwm-inflection-boundary(text,(at + str_len(head(names)))) else cwm-inflection-at(text,at,tail(names));
  def cwm-inflection-boundary(text,at) = (((Comparable) at == str_len(text)) || (!cwm-word(str_byte_at(text,at))));
  def cwm-inflection-open(text,at) = if cwm-prefix(text,at,"en-") then cwm-inflection-at(text,(at + 3),cwm-inflection-names()) else cwm-inflection-at(text,at,cwm-inflection-names());
  def cwm-inflection-scan(text,at) = if (at >= str_len(text)) then 0 else if (cwm-prefix(text,at,"{{") && cwm-inflection-open(text,cwm-skip(text,(at + 2)))) then 1 else cwm-inflection-scan(text,(at + 1));
  def cwm-inflection(text) = cwm-inflection-scan(cwm-lower(text,0,list()),0);
  def cwm-template(text,at) = if (!cwm-prefix(text,at,"{{")) then at else cwm-template-close(text,at,str_find(text,"}",(at + 2)));
  def cwm-template-close(text,at,end) = if ((end > (at + 2)) && cwm-prefix(text,end,"}}")) then (end + 2) else at;
  def cwm-discard(code) = (cwm-space(code) || cwm-member-code(code,list(46,39,34,40,41,44,59,58,33,63,45)));
  def cwm-substance(text,at,total) = if (at >= str_len(text)) then total else cwm-substance-template(text,at,total,cwm-template(text,at));
  def cwm-substance-template(text,at,total,end) = if (end > at) then cwm-substance(text,end,total) else if (cwm-prefix(text,at,"[[") || cwm-prefix(text,at,"]]")) then cwm-substance(text,(at + 2),total) else cwm-substance(text,(at + cwm-width(text,at)),(total + (if cwm-discard(cwm-code(text,at)) then 0 else ctr-units(substring(text,at,(at + cwm-width(text,at))),0,0))));
  def cwm-line-end(text,at) = if ((at >= str_len(text)) || ((Comparable) str_byte_at(text,at) == 10)) then at else cwm-line-end(text,(at + 1));
  def cwm-meaning(text) = if (!cwm-valid(text)) then ctr-bad("complete UTF-8 English section required") else ctr-ok(cwm-lines(text,0,""));
  def cwm-lines(text,at,section) = if (at >= str_len(text)) then nothing() else cwm-line(text,at,cwm-line-end(text,at),section);
  def cwm-line(text,at,end,section) = cwm-line-heading(text,end,section,substring(text,at,end),cwm-heading(substring(text,at,end)));
  def cwm-line-heading(text,end,section,line,heading) = if (!nothing?(heading)) then cwm-lines(text,(end + 1),cwm-section(heading)) else if ((String) section == "") then cwm-lines(text,(end + 1),section) else cwm-line-definition(text,end,section,cwm-definition(line));
  def cwm-line-definition(text,end,section,definition) = if nothing?(definition) then cwm-lines(text,(end + 1),section) else if (cwm-inflection(definition) || (cwm-substance(definition,0,0) < 4)) then cwm-lines(text,(end + 1),section) else list(section,definition);
  def cwm-source(text) = cwm-source-result(cwm-english(text));
  def cwm-source-result(result) = if (!ctr-good(result)) then result else cwm-meaning(ctr-value(result));
 }
 0;
}
