// Complete held-byte Wiktionary interpretation. No transport or publication.
// The matching rules preserve the active substantive refresh selector.
// preludes: form/form-stdlib/bml/concept-translation.bml
section [form.bml] {
 class ConceptWiktionaryMeaning {
  def cwm-width(text,at) = if lt(str_byte_at(text,at),128) then 1 else if lt(str_byte_at(text,at),224) then 2 else if lt(str_byte_at(text,at),240) then 3 else 4;
  def cwm-code(text,at) = cwm-code-width(text,at,cwm-width(text,at));
  def cwm-cont(text,at,offset) = sub(str_byte_at(text,add(at,offset)),128);
  def cwm-code-width(text,at,width) {
   let byte = str_byte_at(text,at);
   if eq(width,1) then byte else if eq(width,2) then add(mul(sub(byte,192),64),cwm-cont(text,at,1)) else if eq(width,3) then add(mul(sub(byte,224),4096),add(mul(cwm-cont(text,at,1),64),cwm-cont(text,at,2))) else add(mul(sub(byte,240),262144),add(mul(cwm-cont(text,at,1),4096),add(mul(cwm-cont(text,at,2),64),cwm-cont(text,at,3))));
  }
  // ECMAScript whitespace includes Unicode spaces and line terminators.
  def cwm-space(code) = or(and(ge(code,9),le(code,13)),or(and(ge(code,8192),le(code,8202)),cwm-member-code(code,list(32,160,5760,8232,8233,8239,8287,12288,65279))));
  def cwm-skip(text,at) = if ge(at,str_len(text)) then at else if cwm-space(cwm-code(text,at)) then cwm-skip(text,add(at,cwm-width(text,at))) else at;
  def cwm-last(text,at,last) = if ge(at,str_len(text)) then last else cwm-last(text,add(at,cwm-width(text,at)),if cwm-space(cwm-code(text,at)) then last else add(at,cwm-width(text,at)));
  def cwm-trim(text) = cwm-trim-span(text,cwm-skip(text,0),cwm-last(text,0,0));
  def cwm-trim-span(text,start,end) = if ge(start,end) then "" else substring(text,start,end);
  def cwm-lower(text,at,bins) = if eq(at,str_len(text)) then fbc-finish(bins,"") else cwm-lower(text,add(at,1),fbc-put(bins,byte_to_str(if and(ge(str_byte_at(text,at),65),le(str_byte_at(text,at),90)) then add(str_byte_at(text,at),32) else str_byte_at(text,at))));
  def cwm-prefix(text,at,value) = and(le(add(at,str_len(value)),str_len(text)),str_eq(substring(text,at,add(at,str_len(value))),value));
  def cwm-member(value,values) = if nil?(values) then 0 else or(str_eq(value,head(values)),cwm-member(value,tail(values)));
  def cwm-valid(text) = and(str_eq(value_kind(text),"string"),fbc-utf8(text,0));
  def cwm-english(text) = if not(cwm-valid(text)) then ctr-bad("complete UTF-8 Wiktionary source required") else ctr-ok(cwm-english-find(text,0));
  def cwm-english-find(text,at) = if ge(at,str_len(text)) then "" else if and(or(eq(at,0),eq(str_byte_at(text,sub(at,1)),10)),cwm-prefix(text,at,"==English==")) then cwm-english-space(text,add(at,11),-1,add(at,1)) else cwm-english-find(text,add(at,1));
  def cwm-english-space(text,at,lastLf,retry) = if ge(at,str_len(text)) then cwm-english-start(text,lastLf,retry) else if cwm-space(cwm-code(text,at)) then cwm-english-space(text,add(at,cwm-width(text,at)),if eq(str_byte_at(text,at),10) then at else lastLf,retry) else cwm-english-start(text,lastLf,retry);
  def cwm-english-start(text,lastLf,retry) = if lt(lastLf,0) then cwm-english-find(text,retry) else cwm-english-end(text,add(lastLf,1),add(lastLf,1));
  def cwm-english-end(text,start,at) = if ge(at,str_len(text)) then substring(text,start,str_len(text)) else if and(cwm-prefix(text,at,"\n=="),and(lt(add(at,3),str_len(text)),ne(str_byte_at(text,add(at,3)),61))) then substring(text,start,at) else cwm-english-end(text,start,add(at,1));
  def cwm-equals(text,at) = if and(lt(at,str_len(text)),eq(str_byte_at(text,at),61)) then cwm-equals(text,add(at,1)) else at;
  def cwm-name-end(text,at) = if or(ge(at,str_len(text)),eq(str_byte_at(text,at),61)) then at else cwm-name-end(text,add(at,1));
  def cwm-heading(line) = cwm-heading-open(line,cwm-equals(line,0));
  def cwm-heading-open(line,count) = if or(lt(count,3),gt(count,6)) then nothing() else cwm-heading-name(line,count,count);
  def cwm-heading-name(line,count,start) = cwm-heading-close(line,count,start,cwm-name-end(line,start));
  def cwm-heading-close(line,count,start,end) = if or(eq(start,end),ne(sub(cwm-equals(line,end),end),count)) then nothing() else if ne(cwm-skip(line,add(end,count)),str_len(line)) then nothing() else cwm-trim(substring(line,start,end));
  def cwm-section(name) = if cwm-member(cwm-lower(name,0,list()),list("noun","verb","adjective","adverb","interjection","preposition","determiner","conjunction","pronoun","numeral","particle")) then name else "";
  def cwm-dot(text,at) = if ge(at,str_len(text)) then 1 else if cwm-member-code(cwm-code(text,at),list(10,13,8232,8233)) then 0 else cwm-dot(text,add(at,cwm-width(text,at)));
  def cwm-member-code(value,values) = if nil?(values) then 0 else or(eq(value,head(values)),cwm-member-code(value,tail(values)));
  def cwm-definition(line) = if or(eq(str_len(line),0),ne(str_byte_at(line,0),35)) then nothing() else if and(gt(str_len(line),1),cwm-member-code(str_byte_at(line,1),list(35,42,58))) then nothing() else cwm-definition-text(cwm-trim(substring(line,1,str_len(line))));
  def cwm-definition-text(text) = if and(gt(str_len(text),0),cwm-dot(text,0)) then text else nothing();
  def cwm-word(code) = or(and(ge(code,48),le(code,57)),or(and(ge(code,65),le(code,90)),or(and(ge(code,97),le(code,122)),eq(code,95))));
  def cwm-inflection-names() = list("third-person","plural of","past of","simple past","present participle","comparative of","superlative of","alternative form of","alternative spelling of","misspelling of","obsolete spelling of","inflection of","form of");
  def cwm-inflection-at(text,at,names) = if nil?(names) then 0 else if cwm-prefix(text,at,head(names)) then cwm-inflection-boundary(text,add(at,str_len(head(names)))) else cwm-inflection-at(text,at,tail(names));
  def cwm-inflection-boundary(text,at) = or(eq(at,str_len(text)),not(cwm-word(str_byte_at(text,at))));
  def cwm-inflection-open(text,at) = if cwm-prefix(text,at,"en-") then cwm-inflection-at(text,add(at,3),cwm-inflection-names()) else cwm-inflection-at(text,at,cwm-inflection-names());
  def cwm-inflection-scan(text,at) = if ge(at,str_len(text)) then 0 else if and(cwm-prefix(text,at,"{{"),cwm-inflection-open(text,cwm-skip(text,add(at,2)))) then 1 else cwm-inflection-scan(text,add(at,1));
  def cwm-inflection(text) = cwm-inflection-scan(cwm-lower(text,0,list()),0);
  def cwm-template(text,at) = if not(cwm-prefix(text,at,"{{")) then at else cwm-template-close(text,at,str_find(text,"}",add(at,2)));
  def cwm-template-close(text,at,end) = if and(gt(end,add(at,2)),cwm-prefix(text,end,"}}")) then add(end,2) else at;
  def cwm-discard(code) = or(cwm-space(code),cwm-member-code(code,list(46,39,34,40,41,44,59,58,33,63,45)));
  def cwm-substance(text,at,total) = if ge(at,str_len(text)) then total else cwm-substance-template(text,at,total,cwm-template(text,at));
  def cwm-substance-template(text,at,total,end) = if gt(end,at) then cwm-substance(text,end,total) else if or(cwm-prefix(text,at,"[["),cwm-prefix(text,at,"]]")) then cwm-substance(text,add(at,2),total) else cwm-substance(text,add(at,cwm-width(text,at)),add(total,if cwm-discard(cwm-code(text,at)) then 0 else ctr-units(substring(text,at,add(at,cwm-width(text,at))),0,0)));
  def cwm-line-end(text,at) = if or(ge(at,str_len(text)),eq(str_byte_at(text,at),10)) then at else cwm-line-end(text,add(at,1));
  def cwm-meaning(text) = if not(cwm-valid(text)) then ctr-bad("complete UTF-8 English section required") else ctr-ok(cwm-lines(text,0,""));
  def cwm-lines(text,at,section) = if ge(at,str_len(text)) then nothing() else cwm-line(text,at,cwm-line-end(text,at),section);
  def cwm-line(text,at,end,section) = cwm-line-heading(text,end,section,substring(text,at,end),cwm-heading(substring(text,at,end)));
  def cwm-line-heading(text,end,section,line,heading) = if not(nothing?(heading)) then cwm-lines(text,add(end,1),cwm-section(heading)) else if str_eq(section,"") then cwm-lines(text,add(end,1),section) else cwm-line-definition(text,end,section,cwm-definition(line));
  def cwm-line-definition(text,end,section,definition) = if nothing?(definition) then cwm-lines(text,add(end,1),section) else if or(cwm-inflection(definition),lt(cwm-substance(definition,0,0),4)) then cwm-lines(text,add(end,1),section) else list(section,definition);
  def cwm-source(text) = cwm-source-result(cwm-english(text));
  def cwm-source-result(result) = if not(ctr-good(result)) then result else cwm-meaning(ctr-value(result));
 }
 0;
}
