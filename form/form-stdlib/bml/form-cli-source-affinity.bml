// A path mentioned in a prompt is a hint. An explicitly supplied source is
// a binding. Preserve that distinction through the generation context.
// preludes: form-stdlib/form-cli-heed-current-source.fk
section [form.bml] {
 class FormCliSourceAffinity {
  def fcsa-unique-go(text,at,found) {
   let start = fhcs-path-skip(text,at);
   start >= str_len(text) ? found : {
    let end = fhcs-path-end(text,start);
    let candidate = substring(text,start,end);
    !fhcs-relative-source-path?(candidate) ? fcsa-unique-go(text,end + 1,found)
    : ((String) found == "") || ((String) found == candidate) ? fcsa-unique-go(text,end + 1,candidate)
    : "";
   };
  }
  def fcsa-infer(prompt) = list("prompt-hint",fcsa-unique-go(prompt,0,""));
  def fcsa-hinted(source) = !((String) value_kind(source) == "list") ? 0 : (Comparable) len(source) != 2 ? 0 : (((String) source[0] == "prompt-hint") && ((String) value_kind(source[1]) == "string"));
  def fcsa-path(source) = (String) value_kind(source) == "string" ? source : fcsa-hinted(source) ? source[1] : "";
  def fcsa-bound(source) = ((String) value_kind(source) == "string") && fhcs-relative-source-path?(fcsa-path(source));
  def fcsa-lookup(ctx,surface,ready,source) = fcsa-bound(source) ? fhcs-lookup-bound(ctx,surface,ready,fcsa-path(source)) : fhcs-lookup-hinted(ctx,surface,ready,fcsa-path(source));
 }
 0;
}
