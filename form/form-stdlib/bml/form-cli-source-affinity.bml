// A path mentioned in a prompt is a hint. An explicitly supplied source is
// a binding. Preserve that distinction through the generation context.
// preludes: form-stdlib/form-cli-heed-current-source.fk
section [form.bml] {
 class FormCliSourceAffinity {
  def fcsa-unique-go(text,at,found) {
   let start = fhcs-path-skip(text,at);
   if ge(start,str_len(text)) then found else {
    let end = fhcs-path-end(text,start);
    let candidate = substring(text,start,end);
    if not(fhcs-relative-source-path?(candidate)) then fcsa-unique-go(text,add(end,1),found)
    else if or(str_eq(found,""),str_eq(found,candidate)) then fcsa-unique-go(text,add(end,1),candidate)
    else "";
   };
  }
  def fcsa-infer(prompt) = list("prompt-hint",fcsa-unique-go(prompt,0,""));
  def fcsa-hinted(source) = if not(str_eq(value_kind(source),"list")) then 0 else if ne(len(source),2) then 0 else and(str_eq(nth(source,0),"prompt-hint"),str_eq(value_kind(nth(source,1)),"string"));
  def fcsa-path(source) = if str_eq(value_kind(source),"string") then source else if fcsa-hinted(source) then nth(source,1) else "";
  def fcsa-bound(source) = and(str_eq(value_kind(source),"string"),fhcs-relative-source-path?(fcsa-path(source)));
  def fcsa-lookup(ctx,surface,ready,source) = if fcsa-bound(source) then fhcs-lookup-bound(ctx,surface,ready,fcsa-path(source)) else fhcs-lookup-hinted(ctx,surface,ready,fcsa-path(source));
 }
 0;
}
