// Teaching shared by the resident overlay and its public curriculum.
// Form graph semantics: model/form-neutral-token-space.fk, meaning-codes.bml.
// Model encoding/decoding: qwen35-tokenizer.fk, form-cli-model-session.fk.
// Scannerless parsing: bml-bmf-stream-curriculum.bml.
section [form.bml] {
 class FormCliQwenMeaning {
  def fqt-symbol-meaning() = "In Form's symbolic graph, a token denotes a semantic symbol whose witnessed language surfaces are labels. Qwen's model vocabulary token IDs are a separate representation: its GGUF tokenizer encodes prompt bytes and its decoder predicts output token IDs. A Form symbol lookup does not replace that model prediction.";
  def fqt-parser-meaning() = "A Form/BMF live streaming cursor folds raw grammar bytes across chunk boundaries with no tokenizer pre-step for that parser. Qwen's GGUF tokenizer still encodes the model input. Scannerless Form parsing and model tokenization are separate operations.";
  def fqt-surface-meaning() = "Explicit Form graph and codebook lookups return witnessed language surfaces and retain alternate senses or missing codes. A short codebook symbol anchor has narrower scope than kernel cell identity. Natural-language answers in this Qwen lane are generated by the model; tools and supplied sources can ground their meaning and wording.";
  def fqt-response-evidence-meaning() = "Ground descriptions of model behavior in the supplied implementation or observed runs. Describe intended practice as teaching and unmeasured comparisons as illustrative. Use concrete inputs and outputs from current source for examples. Address the complete enquiry and distinguish statements about the model from metaphors.";
  def fqt-meaning-prefix() {
   let symbols = str_concat(fqt-symbol-meaning()," ");
   let parser = str_concat(fqt-parser-meaning()," ");
   let surface = str_concat(fqt-surface-meaning()," ");
   str_concat(symbols,str_concat(parser,str_concat(surface,str_concat(fqt-response-evidence-meaning()," "))));
  }
 }
}
