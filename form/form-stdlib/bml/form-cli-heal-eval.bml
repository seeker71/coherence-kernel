// Runs only in a disposable evaluation repository made by the host carrier.
// preludes: form-stdlib/bml/form-cli-heal.bml
section [form.bml] {
    class FormCliHealEvaluationCase {
        def fhe-native(job, row, model) {
            let request = fh-write(job, "inventory.request", "inventory\n");
            let status = fh-run(job, "inventory", 30, "root", fh-path(job, "inventory.request"), list("./fkwu", "observe/form-cli-heal-model-run.bml"));
            let rows = split-on(fh-out(job, "inventory"), "\n");
            let valid = and(str_eq(status, "0"), and(le(file_size(fh-path(job, "inventory.out")), HealMaxSource()), fhr-valid(rows)));
            let eligible = if valid then fhr-model(fhr-plan(rows), model) else "";
            let admitted = fh-log(job, "evaluation-native-admission", if str_eq(eligible, "") then "unavailable" else eligible);
            let evidence = fh-write(job, "evidence.txt", fh-cat(list("Evaluation-only case; repair memory and retrieval are excluded. Checker contract: ", nth(row, 6), "\nChecker:\n", nth(row, 5), "\nBaseline stdout:\n", fh-out(job, "baseline"), "\nBaseline stderr:\n", fh-errors(job, "baseline"))));
            let reply = if str_eq(eligible, "") then "" else fh-model(job, "base", eligible, "", "eval-model", list(eligible), "explicit-single-model-evaluation;other-models-and-remote-excluded");
            fh-try(job, HealEvalTarget(), HealEvalChecker(), nth(row, 6), 10, fh-proposal(nth(row, 4), reply), "eval-model", 400);
        }
        def fhe-attempt(job, row, mode, model) = if str_eq(mode, "deterministic") then fh-try-list(job, HealEvalTarget(), HealEvalChecker(), nth(row, 6), 10, fh-candidates(nth(row, 4)), 0) else fhe-native(job, row, model);
        def fhe-result(job, row, mode, model, baseline) {
            let valid = fhe-baseline-admissible(nth(row, 3), fh-status(job, "baseline"), and(str_eq(fh-trim(fh-errors(job, "baseline")), ""), fh-has(fh-out(job, "baseline-preflight"), "chain         clean")));
            let result = if or(not(valid), or(baseline, str_eq(nth(row, 3), "control"))) then 0 else fhe-attempt(job, row, mode, model);
            let unchanged = str_eq(fh-read(HealEvalTarget()), nth(row, 4));
            let outcome = if valid then fhe-outcome(nth(row, 3), baseline, result, unchanged) else "invalid-case";
            let id = now_unix_ms();
            let action = str_concat("finish-evaluation:", outcome);
            let selected = fh-choice(job, "evaluation-outcome", id, "selected", list(action), action, "single-case-contract;no-retry-or-budget-extension", "awaiting-evidence-and-release");
            let saved = fh-write(job, "evaluation-result.json", json-emit(json-node-array(fhe-strings(list(head(row), nth(row, 1), nth(row, 2), outcome, mode, model, int_to_str(baseline), int_to_str(unchanged))))));
            let releasing = fh-stage(job, "healing-snapshot-release-begin");
            let released = fh-host(list("finish", job));
            let releaseDone = fh-stage(job, "healing-snapshot-release-ready");
            let logged = fh-log(job, "snapshot-release", released);
            let applied = fh-choice(job, "evaluation-outcome", id, "applied", list(action), action, "result-saved;snapshot-released", str_concat("source-unchanged=", int_to_str(unchanged)));
            print_str(fh-report(job));
            print_str(str_concat("evaluation-evidence=", job));
        }
        def fhe-run(row, mode, model) {
            let preparing = fh-stage-line("healing-snapshot-begin");
            let job = fh-host(list("prepare", HealEvalTarget(), HealEvalChecker()));
            let prepared = fh-stage-line("healing-snapshot-ready");
            if or(str_eq(job, ""), fh-has(job, "refused:")) then print_str(str_concat("evaluation-refused=", job)) else fhe-prepared(job, row, mode, model);
        }
        def fhe-prepared(job, row, mode, model) {
            let marked = fh-write(job, "evaluation-only", HealEvalVersion());
            let contract = fh-write(job, "contract", fh-cat(list(HealEvalChecker(), " stdout=", nth(row, 6), " exit=0; evaluation-only\n")));
            if not(fh-ground(job)) then print_str(str_concat("evaluation-refused=bootstrap;", job)) else fhe-result(job, row, mode, model, fh-test(job, "baseline", HealEvalChecker(), nth(row, 6), 10));
        }
        def fhe-main() {
            let entered = fh-stage-line("healing-case-ready");
            let id = read_line();
            let mode = read_line();
            let model = read_line();
            let row = fhe-find(fhe-cases(), id);
            if not(eq(len(row), 7)) then print_str("evaluation-refused=unknown-case") else if not(and(str_eq(fh-read(HealEvalTarget()), nth(row, 4)), str_eq(fh-read(HealEvalChecker()), nth(row, 5)))) then print_str("evaluation-refused=case-bytes") else fhe-run(row, mode, model);
        }
    }
    0;
}
