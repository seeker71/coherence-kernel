// Runs only in a disposable evaluation repository made by the host carrier.
// preludes: form-stdlib/bml/form-cli-heal.bml
section [form.bml] {
    class FormCliHealEvaluationCase {
        def fhe-native(job, row, model) {
            let request = fh-write(job, "inventory.request", "inventory\n");
            let status = fh-run(job, "inventory", 30, "root", fh-path(job, "inventory.request"), list("./fkwu", "observe/form-cli-heal-model-run.bml"));
            let rows = split-on(fh-out(job, "inventory"), "\n");
            let valid = ((String) status == "0") && ((file_size(fh-path(job, "inventory.out")) <= HealMaxSource()) && fhr-valid(rows));
            let eligible = valid ? fhr-model(fhr-plan(rows), model) : "";
            let admitted = fh-log(job, "evaluation-native-admission", (String) eligible == "" ? "unavailable" : eligible);
            let evidence = fh-write(job, "evidence.txt", fh-cat(list("Evaluation-only case; repair memory and retrieval are excluded. Checker contract: ", row[6], "\nChecker:\n", row[5], "\nBaseline stdout:\n", fh-out(job, "baseline"), "\nBaseline stderr:\n", fh-errors(job, "baseline"))));
            let reply = (String) eligible == "" ? "" : fh-model(job, "base", eligible, "", "eval-model", list(eligible), "explicit-single-model-evaluation;other-models-and-remote-excluded");
            fh-try(job, HealEvalTarget(), HealEvalChecker(), row[6], 10, fh-proposal(row[4], reply), "eval-model", 400);
        }
        def fhe-attempt(job, row, mode, model) = (String) mode == "deterministic" ? fh-try-list(job, HealEvalTarget(), HealEvalChecker(), row[6], 10, fh-candidates(row[4]), 0) : fhe-native(job, row, model);
        def fhe-result(job, row, mode, model, baseline) {
            let valid = fhe-baseline-admissible(row[3], fh-status(job, "baseline"), ((String) fh-trim(fh-errors(job, "baseline")) == "") && fh-has(fh-out(job, "baseline-preflight"), "chain         clean"));
            let result = (!valid) || (baseline || ((String) row[3] == "control")) ? 0 : fhe-attempt(job, row, mode, model);
            let unchanged = (String) fh-read(HealEvalTarget()) == row[4];
            let outcome = valid ? fhe-outcome(row[3], baseline, result, unchanged) : "invalid-case";
            let id = now_unix_ms();
            let action = "finish-evaluation:" ++ outcome;
            let selected = fh-choice(job, "evaluation-outcome", id, "selected", list(action), action, "single-case-contract;no-retry-or-budget-extension", "awaiting-evidence-and-release");
            let saved = fh-write(job, "evaluation-result.json", json-emit(json-node-array(fhe-strings(list(head(row), row[1], row[2], outcome, mode, model, int_to_str(baseline), int_to_str(unchanged))))));
            let releasing = fh-stage(job, "healing-snapshot-release-begin");
            let released = fh-host(list("finish", job));
            let releaseDone = fh-stage(job, "healing-snapshot-release-ready");
            let logged = fh-log(job, "snapshot-release", released);
            let applied = fh-choice(job, "evaluation-outcome", id, "applied", list(action), action, "result-saved;snapshot-released", "source-unchanged=" ++ int_to_str(unchanged));
            print_str(fh-report(job));
            print_str("evaluation-evidence=" ++ job);
        }
        def fhe-run(row, mode, model) {
            let preparing = fh-stage-line("healing-snapshot-begin");
            let job = fh-host(list("prepare", HealEvalTarget(), HealEvalChecker()));
            let prepared = fh-stage-line("healing-snapshot-ready");
            ((String) job == "") || fh-has(job, "refused:") ? print_str("evaluation-refused=" ++ job) : fhe-prepared(job, row, mode, model);
        }
        def fhe-prepared(job, row, mode, model) {
            let marked = fh-write(job, "evaluation-only", HealEvalVersion());
            let contract = fh-write(job, "contract", fh-cat(list(HealEvalChecker(), " stdout=", row[6], " exit=0; evaluation-only\n")));
            !fh-ground(job) ? print_str("evaluation-refused=bootstrap;" ++ job) : fhe-result(job, row, mode, model, fh-test(job, "baseline", HealEvalChecker(), row[6], 10));
        }
        def fhe-main() {
            let entered = fh-stage-line("healing-case-ready");
            let id = read_line();
            let mode = read_line();
            let model = read_line();
            let row = fhe-find(fhe-cases(), id);
            !((Comparable) len(row) == 7) ? print_str("evaluation-refused=unknown-case") : !(((String) fh-read(HealEvalTarget()) == row[4]) && ((String) fh-read(HealEvalChecker()) == row[5])) ? print_str("evaluation-refused=case-bytes") : fhe-run(row, mode, model);
        }
    }
    0;
}
