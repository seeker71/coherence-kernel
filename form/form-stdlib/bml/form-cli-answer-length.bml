// A word range is an observable response requirement. One bounded correction
// uses the same admitted model and context; semantic quality stays unscored.
// preludes: form-stdlib/bml/form-cli-reasoning-budget.bml form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliAnswerLength {
  def fal-count(text) = fal-walk(text,0,0,0);
  def fal-walk(text,at,inside,count) = if ge(at,str_len(text)) then count else {
   let byte = str_byte_at(text,at);
   let space = or(eq(byte,32),and(ge(byte,9),le(byte,13)));
   fal-walk(text,add(at,1),not(space),add(count,if and(not(space),not(inside)) then 1 else 0));
  };
  def fal-within(words,lower,upper) = and(ge(words,lower),le(words,upper));
  def fal-target(lower,upper) = add(lower,div(sub(upper,lower),2));
  def fal-requirement(lower,upper) = str_concat("Return a complete answer of ",str_concat(int_to_str(lower),str_concat("–",str_concat(int_to_str(upper)," whitespace-delimited words. Form counts the final answer, including headings. Do not enumerate words or discuss the count in the answer."))));
  def fal-feedback(words,lower,upper) = fal-directed-feedback(words,lower,upper,gt(words,upper));
  def fal-directed-feedback(words,lower,upper,shorten) {
   let direction = if shorten then "Shorten" else "Expand";
   let action = if shorten then "Remove repetition and secondary elaboration while preserving the essential facts, source distinctions and enquiry." else "Add useful missing explanation rather than padding while preserving the original enquiry, source conditions, distinctions and useful content.";
   let aim = int_to_str(fal-target(lower,upper));
   let range = str_concat(int_to_str(lower),str_concat("–",int_to_str(upper)));
   let measured = str_concat(direction,str_concat(" the preceding answer from ",str_concat(int_to_str(words)," words to ")));
   let target = str_concat(aim,str_concat(" words, inside the requested ",str_concat(range," range. ")));
   let ending = " Return only the complete revised answer without self-assessment or counting narration. This observation supplies no new domain evidence.";
   str_concat(measured,str_concat(target,str_concat(action,ending)));
  }
  // Extra decimal room covers any representable observed count. The bridge
  // checks its actual encoded length again before submission.
  def fal-feedback-room(lower,upper) {
   let shorter = str_len(fal-directed-feedback(0,lower,upper,1));
   let longer = str_len(fal-directed-feedback(0,lower,upper,0));
   add(67,if gt(shorter,longer) then shorter else longer);
  }
  def fal-reserve(src,lower,upper,answer) = if le(upper,0) then 0 else add(answer,add(len(fcms-direct-answer-tail-ids(src,"")),fal-feedback-room(lower,upper)));
  // The controller restates the caller's unmet response requirement. This is
  // a follow-up request, not the result of a model-requested tool call.
  def fal-bridge(session,text,reserve) {
   let ids = fcms-direct-answer-observation-ids(session,text);
   if not(frbg-reserve-fits(session,len(ids),reserve)) then fcms-refuse(session,"length-response-reserve-does-not-fit")
   else fcms-observe-ids(session,ids,"length-response-observation-refused");
  }
  // result = session, answer, revision generation, feedback, initial words,
  // final words, range passed, revised, complete.
  def fal-result(session,text,revision,notice,initial,lower,upper,revised,complete) = list(session,text,revision,notice,initial,fal-count(text),if le(upper,0) then 1 else fal-within(fal-count(text),lower,upper),revised,complete);
  def fal-check(base,lower,upper,allowance) = fal-with(base,lower,upper,allowance,fcms-generate,fal-bridge);
  def fal-change(base,measured) = if not(nth(measured,7)) then "not-requested" else if str_eq(frbg-answer(base),nth(measured,1)) then "unchanged" else "changed";
  def fal-with(base,lower,upper,allowance,generate,bridge) {
   let session = frbg-session(base); let text = frbg-answer(base); let words = fal-count(text);
   if or(le(upper,0),or(not(frbg-complete(base)),fal-within(words,lower,upper))) then fal-result(session,text,frbg-empty(session),"",words,lower,upper,0,frbg-complete(base)) else {
    let data = json-node-object(list(oh-n("words",words),oh-n("minimum",lower),oh-n("maximum",upper),oh-s("basis","ASCII-whitespace-delimited words; includes headings")));
    let reading = oh-reading("native-generation",int_to_str(host_pid()),"answer-length",json-node-object(list(oh-n("minimum",lower),oh-n("maximum",upper))),json-node-int(words),json-node-int(0),list(oh-need("answer-within-requested-range",data)),list("revise-once","retain"),data);
    oh-voice(reading); let response = oh-response(reading,"revise-once"); oh-voice(response);
    if not(str_eq(oh-select(reading,response,"retain"),"revise-once")) then fal-result(session,text,frbg-empty(session),"",words,lower,upper,0,frbg-complete(base)) else {
     let notice = fal-feedback(words,lower,upper); let next = bridge(session,notice,allowance);
     let revision = if frbg-valid-session(next) then generate(next,allowance) else frbg-empty(next);
     let last = fcms-generation-session(revision); let revised = fcms-generation-text(revision);
     let result = fal-result(last,revised,revision,notice,words,lower,upper,1,frbg-stopped(last));
     oh-voice(oh-applied(reading,"revise-once",json-node-object(list(oh-n("words",nth(result,5)),oh-n("range_passed",nth(result,6)),oh-n("complete",nth(result,8)),oh-n("generated_ids",len(fcms-generation-ids(revision))),oh-s("answer_change",fal-change(base,result))))));
     result;
    };
   };
  }
 }
 0;
}
