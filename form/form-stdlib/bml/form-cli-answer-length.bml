// A word range is an observable response requirement. One bounded correction
// uses the same admitted model and context; semantic quality stays unscored.
// preludes: form-stdlib/bml/form-cli-reasoning-budget.bml form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliAnswerLength {
  def fal-count(text) = fal-walk(text,0,0,0);
  def fal-walk(text,at,inside,count) = at >= str_len(text) ? count : {
   let byte = str_byte_at(text,at);
   let space = ((Comparable) byte == 32) || ((byte >= 9) && (byte <= 13));
   fal-walk(text,at + 1,!space,count + ((!space) && (!inside) ? 1 : 0));
  };
  def fal-within(words,lower,upper) = (words >= lower) && (words <= upper);
  def fal-target(lower,upper) = lower + ((upper - lower) / 2);
  def fal-requirement(lower,upper) = "Return a complete answer of " ++ int_to_str(lower) ++ "–" ++ int_to_str(upper) ++ " whitespace-delimited words. Form counts the final answer, including headings. Do not enumerate words or discuss the count in the answer.";
  def fal-feedback(words,lower,upper) = fal-directed-feedback(words,lower,upper,words > upper);
  def fal-directed-feedback(words,lower,upper,shorten) {
   let direction = shorten ? "Shorten" : "Expand";
   let action = shorten ? "Remove repetition and secondary elaboration while preserving the essential facts, source distinctions and enquiry." : "Add useful missing explanation rather than padding while preserving the original enquiry, source conditions, distinctions and useful content.";
   let aim = int_to_str(fal-target(lower,upper));
   let range = int_to_str(lower) ++ "–" ++ int_to_str(upper);
   let measured = direction ++ " the preceding answer from " ++ int_to_str(words) ++ " words to ";
   let target = aim ++ " words, inside the requested " ++ range ++ " range. ";
   let ending = " Return only the complete revised answer without self-assessment or counting narration. This observation supplies no new domain evidence.";
   measured ++ target ++ action ++ ending;
  }
  // Extra decimal room covers any representable observed count. The bridge
  // checks its actual encoded length again before submission.
  def fal-feedback-room(lower,upper) {
   let shorter = str_len(fal-directed-feedback(0,lower,upper,1));
   let longer = str_len(fal-directed-feedback(0,lower,upper,0));
   67 + (shorter > longer ? shorter : longer);
  }
  def fal-reserve(src,lower,upper,answer) = upper <= 0 ? 0 : (answer + (len(fcms-direct-answer-tail-ids(src,"")) + fal-feedback-room(lower,upper)));
  // The controller restates the caller's unmet response requirement. This is
  // a follow-up request, not the result of a model-requested tool call.
  def fal-bridge(session,text,reserve) {
   let ids = fcms-direct-answer-observation-ids(session,text);
   !frbg-reserve-fits(session,len(ids),reserve) ? fcms-refuse(session,"length-response-reserve-does-not-fit")
   : fcms-observe-ids(session,ids,"length-response-observation-refused");
  }
  // result = session, answer, revision generation, feedback, initial words,
  // final words, range passed, revised, complete.
  def fal-result(session,text,revision,notice,initial,lower,upper,revised,complete) = list(session,text,revision,notice,initial,fal-count(text),upper <= 0 ? 1 : fal-within(fal-count(text),lower,upper),revised,complete);
  def fal-check(base,lower,upper,allowance) = fal-with(base,lower,upper,allowance,fcms-generate,fal-bridge);
  def fal-change(base,measured) = !measured[7] ? "not-requested" : (String) frbg-answer(base) == measured[1] ? "unchanged" : "changed";
  def fal-with(base,lower,upper,allowance,generate,bridge) {
   let session = frbg-session(base); let text = frbg-answer(base); let words = fal-count(text);
   (upper <= 0) || ((!frbg-complete(base)) || fal-within(words,lower,upper)) ? fal-result(session,text,frbg-empty(session),"",words,lower,upper,0,frbg-complete(base)) : {
    let data = json-node-object(list(oh-n("words",words),oh-n("minimum",lower),oh-n("maximum",upper),oh-s("basis","ASCII-whitespace-delimited words; includes headings")));
    let reading = oh-reading("native-generation",int_to_str(host_pid()),"answer-length",json-node-object(list(oh-n("minimum",lower),oh-n("maximum",upper))),json-node-int(words),json-node-int(0),list(oh-need("answer-within-requested-range",data)),list("revise-once","retain"),data);
    oh-voice(reading); let response = oh-response(reading,"revise-once"); oh-voice(response);
    !((String) oh-select(reading,response,"retain") == "revise-once") ? fal-result(session,text,frbg-empty(session),"",words,lower,upper,0,frbg-complete(base)) : {
     let notice = fal-feedback(words,lower,upper); let next = bridge(session,notice,allowance);
     let revision = frbg-valid-session(next) ? generate(next,allowance) : frbg-empty(next);
     let last = fcms-generation-session(revision); let revised = fcms-generation-text(revision);
     let result = fal-result(last,revised,revision,notice,words,lower,upper,1,frbg-stopped(last));
     oh-voice(oh-applied(reading,"revise-once",json-node-object(list(oh-n("words",result[5]),oh-n("range_passed",result[6]),oh-n("complete",result[8]),oh-n("generated_ids",len(fcms-generation-ids(revision))),oh-s("answer_change",fal-change(base,result))))));
     result;
    };
   };
  }
 }
 0;
}
