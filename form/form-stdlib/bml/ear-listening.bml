// Native listening policy. Energy admits an ASR candidate, never a word.
// Quiet level is measured before gain; the model's doubt gates stay independent.
// preludes: form/form-stdlib/core.fk
section [form.bml] {
 class EarListening {
  field ELWindowBytes = 256000;
  field ELPrerollBytes = 32000;
  field ELGainUnity = 1000;
  field ELGainLimit = 16000;
  field ELTargetPeak = 1024;
  field ELDecoderPauseMs = 200;
  field ELPauseMs = 500;
  def elp-max(a, b) = if (a > b) then a else b;
  def elp-min(a, b) = if (a < b) then a else b;
  def elp-s16(s, i) {
   let v = (str_byte_at(s, i) + (256 * str_byte_at(s, (i + 1))));
   if (v >= 32768) then (v - 65536) else v;
  }
  def elp-stats-go(s, i, sum, peak, count) = if ((i + 1) >= str_len(s)) then list(sum, peak, count) else elp-stats-add(s, i, sum, peak, count, elp-s16(s, i));
  def elp-stats-add(s, i, sum, peak, count, v) = elp-stats-go(s, (i + 2), (sum + (v * v)), elp-max(peak, abs(v)), (count + 1));
  def elp-sqrt(v, lo, hi) {
   let mid = ((lo + (hi + 1)) / 2);
   if (lo >= hi) then lo else if ((mid * mid) > v) then elp-sqrt(v, lo, (mid - 1)) else elp-sqrt(v, mid, hi);
  }
  def elp-stats(s) {
   let r = elp-stats-go(s, 0, 0, 0, 0);
   list(if ((Comparable) nth(r, 2) == 0) then 0 else elp-sqrt((head(r) / nth(r, 2)), 0, 32768), nth(r, 1));
  }
  def elp-db-rows() = list(list(-6, 16422), list(-12, 8231), list(-18, 4125), list(-24, 2067), list(-30, 1036), list(-36, 519), list(-42, 260), list(-48, 130), list(-54, 65), list(-60, 33), list(-66, 16), list(-72, 8), list(-78, 4), list(-84, 2), list(-90, 1));
  def elp-db-go(rows, rms) = if ((Comparable) len(rows) == 0) then -120 else if (rms >= nth(head(rows), 1)) then head(head(rows)) else elp-db-go(tail(rows), rms);
  def elp-db(rms) = elp-db-go(elp-db-rows(), rms);
  // State: noise estimate, consecutive candidate hops, window peak metadata.
  // Keep the straddling oldest chunk's peak conservatively when cutting a window.
  def elp-born() = list(-1, 0, list());
  def elp-floor(state) = elp-max(0, head(state));
  def elp-enter(fl) = elp-max(8, (2 * fl));
  def elp-hold(fl) = elp-max(6, ((3 * fl) / 2));
  def elp-strong(fl) = elp-max(100, (4 * fl));
  // A single quiet/dropout chunk must not drag the estimate below ordinary room noise.
  def elp-floor-next(fl, r, candidate) = if candidate then fl else (((fl * 7) + r) / 8);
  def elp-meta-bytes(rows) = if ((Comparable) len(rows) == 0) then 0 else (head(head(rows)) + elp-meta-bytes(tail(rows)));
  def elp-meta-cut(rows, excess) = if ((excess <= 0) || ((Comparable) len(rows) == 0)) then rows else if (excess >= head(head(rows))) then elp-meta-cut(tail(rows), (excess - head(head(rows)))) else cons(list((head(head(rows)) - excess), nth(head(rows), 1)), tail(rows));
  def elp-meta-push(rows, bytes, peak) {
   let more = append(rows, list(list(bytes, peak)));
   elp-meta-cut(more, (elp-meta-bytes(more) - ELWindowBytes()));
  }
  def elp-peak(rows) = if ((Comparable) len(rows) == 0) then 0 else elp-max(nth(head(rows), 1), elp-peak(tail(rows)));
  def elp-step(state, rms, peak, bytes, speaking) {
   let fl = if (head(state) < 0) then rms else head(state);
   let candidate = (rms > elp-enter(fl));
   let streak = if candidate then (nth(state, 1) + 1) else 0;
   let voice = ((rms > elp-strong(fl)) || ((speaking && (rms > elp-hold(fl))) || (streak >= 2)));
   let next = list(elp-floor-next(fl, rms, (candidate || voice)), streak, elp-meta-push(nth(state, 2), bytes, peak));
   list(next, voice);
  }
  // One gain for the whole window, never quantized back into microphone PCM.
  // Peak normalization cannot recover SNR or information lost below quantization.
  def elp-gain(peak) = if (peak <= 0) then ELGainUnity() else elp-max(ELGainUnity(), elp-min(ELGainLimit(), ((ELTargetPeak() * ELGainUnity()) / peak)));
  def elp-window-gain(state) {
   let peak = elp-peak(nth(state, 2));
   if (peak > (4 * elp-floor(state))) then elp-gain(peak) else ELGainUnity();
  }
  def elp-quiet-cut(total) = elp-max(0, (total - ELPrerollBytes()));
  // Agreement is display evidence, not a forced decoder prefix. Every open
  // phrase may be corrected from all of its audio, even after repeated agreement.
  def elp-revision-prefix(previous, agreed) = list();
  def elp-close(quietMs, tailMs, stable, full) = if ((quietMs >= ELDecoderPauseMs()) && ((tailMs >= ELDecoderPauseMs()) && (stable >= 1))) then "decoder" else if (quietMs > ELPauseMs()) then "pause" else if full then "full" else "";
 }
}
