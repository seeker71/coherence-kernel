//////////////////////////////////////////////////////////////////////
//
// form-cli-session-home.bml — high-grammar authority.
//
// Each session comes home as interned Form fuel, never a chat
// transcript. Census is a fresh denominator. Rank-1 A/B is seeded from
// interned gift identities. Local model flow injects Form observations;
// it does not re-encode the rented voice. fqt-lora stays 0 until
// generate loads tensors. Qwen GGUF stays frozen.
//
// Executable: form-stdlib/form-cli-session-home.bml
// Proven by: form-stdlib/tests/form-cli-session-home-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.sessionhome;

import Form.kernel.*;
import Form.cli.sessionlocal.*;
import Form.cli.lorawriter.*;

interface ISessionHome [public, witness, reusable] {
   section [public] {
      const String TrainRule = "interned gifts seed A/B; never transcripts";
      const int FqtLora = 0;
      const int ReencodeTranscript = 0;
      const String AdapterPath = ".form-lora-adapter";

      String Fuel() [abstract];
      int TranscriptMark( String strFuel ) [abstract];
      int WriteFromFuel( String strPath, String strFuel, int nDim ) [abstract];
      int Home( int nNative, int nLocal, int nRemote, int nResolved ) [abstract];
   }
}

template SessionHomeRow<TCount> [public, reusable] {
   section [public] {
      TCount Native() [get];
      TCount Local() [get];
      TCount Remote() [get];
      String Fuel() [get];
   }
}

class FormSessionHome [public, reusable, teach] : ISessionHome {
   section [public] {
      const String TrustRule = "count without content; seed from interned gifts; inject observations";
      const String ExecutablePath = "form/form-stdlib/form-cli-session-home.bml";

      String Fuel() [abstract] {}
      int TranscriptMark( String strFuel ) [abstract] {}
      int WriteFromFuel( String strPath, String strFuel, int nDim ) [abstract] {}
      int Home( int nNative, int nLocal, int nRemote, int nResolved ) [abstract] {}
   }
}

class FormSessionHomeSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-session-home-self";
      const String Pattern = "interned-fuel no-transcript rank-1-seed inject-ids fqt-lora-stays-0";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
