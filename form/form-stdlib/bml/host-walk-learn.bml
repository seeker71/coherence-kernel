// host-walk-learn.bml — after a walk's drafts and page: the body reads its own drafts, the rows reach a lift, and the exit proof and the register are read.
//
// What it holds, in the order the doors call them. Each is an argv child through host-child.bml with a deadline like its siblings, its whole
// output under .hearth/walk-io/<step>.out, and is read as its lines; a door that does not stand in the checkout is refused by name and no child begins.
//   hw-reading   a bounded native reading, newest first (observe/draft-native-reading-run.bml): {"count":hw-read-most,"newest":1,"until_ms":<the window's end less the
//                lift's room>}. The door itself asks the memory governor, picks the voice the room allows, starts no ask the time left cannot
//                hold, and says so on its line; a covenant rejection needs no voice and lands whatever the window. The child's deadline is the
//                window's end plus hw-backstop-ms, as a turn's is. It first yields to the host's other GPU doors, as a turn does.
//   hw-rows      our readings, then the body's own, become rows (observe/draft-readings-to-rows.bml): learn/draft-readings.jsonl stays the
//                current judge, learn/draft-readings-native.jsonl what a lift can choose. No model opens. The rows hold the person's words: they stay in this checkout and no landing carries them (hw-words, host-walk-carry.bml).
//   hw-lift      the 3B lift (observe/lora-lift-run.bml) over the body's accepted rows, judged on held-out rows we accepted: its door is its judge
//                (the trainer's validation before and after, `better` from the accepted held-out alone), and rows we rejected are scored beside
//                for information. The cadence is hw-lift-cadence, 8 new rows since the last lift of these rows: a lift trains from the same parent on every row, since
//                serving does not move here, so one row more would buy the same 188-343 s and much the same child; 8 is the smallest row set a lift of
//                record trained on and the set the 27B's trainer reads. The door says when it waits (the cadence, or a window short of its
//                row visits), and asks the governor before anything opens.
//   hw-lift-27b  the 27B's larger lift, or why not, on one line. It begins only after this walk's 3B lift read better 1 (the cheap judge first: new rows that
//                did not move the 3B do not earn the 27B's half hour), with the time left holding the judge and a bounded trainer (hw-lift-27b-floor-ms) and the
//                machine holding its weights over the live leases (hw-lift-27b-need). Then its rows (observe/qwen-last-block-rows-run.bml, the
//                native rows among them), its trainer, bounded by wall_s (observe/qwen-last-block-train-run.bml), and its judge on our accepted held-out
//                (observe/qwen-last-block-lift-run.bml), one row in the promotion ledger. The adapter's own rules stand in those doors: the judge's rows disjoint from the
//                child's by draft id, the child never worn here (wearing is the wear door's decision).
//   hw-rent      the rent meter (observe/session-rent-run.bml).
//   hw-proof     the goal's exit proof, read (observe/exit-proof-run.bml with no stdin: no model door).
//   hw-gaps      the gap register, read (observe/offline-voice-gaps-run.bml).
//   hw-steer     the register's open rows, offered (observe/self-steer-run.bml).
// What it needs: host-walk-text.bml (hw-line, hw-say), host-walk-turn.bml (hw-backstop-ms), host-walk-window.bml (hw-yield) and host-child.bml.
// PROOF: form-stdlib/tests/host-walk-learn-band.bml; a safe start skips each (hw-safe-skips?, host-walk-began.bml; form-stdlib/tests/host-walk-retry-band.bml).
import form-stdlib/bml/host-walk-text.bml;
import form-stdlib/bml/host-walk-turn.bml;
import form-stdlib/bml/host-walk-window.bml;
import form-stdlib/bml/host-child.bml;
import form-stdlib/bml/json-view.bml;
section [form.bml] {
 class HostWalkLearn {
  def hw-reading-door() = "observe/draft-native-reading-run.bml";
  def hw-rows-door() = "observe/draft-readings-to-rows.bml";
  def hw-lift-door() = "observe/lora-lift-run.bml";
  def hw-lift-27b-doors() = ["observe/qwen-last-block-rows-run.bml", "observe/qwen-last-block-train-run.bml", "observe/qwen-last-block-lift-run.bml"];
  def hw-proof-door() = "observe/exit-proof-run.bml";
  def hw-gaps-door() = "observe/offline-voice-gaps-run.bml";
  // a walk's asks: a Q8 ask measured 30 s with the GPU nearly its own, 85 s among three other sessions and up to 972 s among five (2026-10-31), so 48 fit in the hour or so a night
  // leaves after its turns and drafts; until_ms is what bounds them
  def hw-read-most() = 48;
  def hw-lift-room-ms() = 900000;
  def hw-lift-cadence() = 8;
  def hw-native-rows() = "learn/draft-readings-native.jsonl";
  def hw-record-rows() = "learn/draft-readings.jsonl";
  def hw-record-rejected() = "learn/draft-readings-heldout.jsonl";
  // ---- a step's child and what it says: the lines that carry its reading, its exit named when it was not 0
  def hw-learn-door(io, step, door, input, until, read) = file_size(door) < 1 ? "[" ++ step ++ "] refused: " ++ door ++ " does not stand in this checkout; no child was begun" : read(hch-run-in(io, step, ["./fkwu", door], input, until));
  def hw-learn-exit(step, run) = "[" ++ step ++ "] exit " ++ hch-status-text(run) ++ ((String) run[2] == "" ? "" : " (" ++ run[2] ++ ")") ++ ": its output stands in " ++ step ++ ".out";
  def hw-learn-told(step, run, text) = hch-ok?(run) && (Comparable) len(text) > 0 ? text : ((Comparable) len(text) > 0 ? text ++ "\n" : "") ++ hw-learn-exit(step, run);
  def hw-learn-lines(step, run, needles) = hw-learn-told(step, run, hch-with(run[1], needles));
  // the last line a door spoke as a line of its own: it begins with [ or {, and the value a door ends on is not one
  def hw-learn-spoken?(line) = (len(line) > 0) && (((Comparable) str_byte_at(line, 0) == 91) || ((Comparable) str_byte_at(line, 0) == 123));
  def hw-learn-tail(step, run) = hw-learn-told(step, run, hch-last-of(filter(l => hw-learn-spoken?(l), hch-lines(run[1]))));
  // ---- the reading
  def hw-reading-request(until) = jv-emit(jv-object([jv-n("count", hw-read-most()), jv-n("newest", 1), jv-n("until_ms", until - hw-lift-room-ms())])) ++ "\n";
  def hw-reading-needles() = ["[native-reading] read ", "[native-reading] voice ", "[native-reading] held by", "draft-native-reading:"];
  def hw-reading-at(io, door, until) = hw-learn-door(io, "reading", door, hw-reading-request(until), until + hw-backstop-ms(), run => hw-learn-lines("reading", run, hw-reading-needles()));
  def hw-reading(until) {
   let said = hw-say(hw-yield(until));
   hw-reading-at(hch-dir(), hw-reading-door(), until);
  }
  // ---- the rows
  def hw-rows-one(io, step, door, input) = hw-learn-door(io, step, door, input, hch-by(hch-step-backstop-ms()), run => hw-learn-tail(step, run));
  def hw-rows-at(io, door) {
   let ours = hw-rows-one(io, "rows-record", door, "");
   let body = hw-rows-one(io, "rows-native", door, "{\"readers\":[\"native-voice\"]}\n");
   "[rows] of-record " ++ ours ++ "\n[rows] native-voice " ++ body;
  }
  def hw-rows() = hw-rows-at(hch-dir(), hw-rows-door());
  // ---- the lift
  def hw-lift-request(until) = jv-emit(jv-object([jv-s("rows", hw-native-rows()), jv-s("valid_source", hw-record-rows()), jv-n("valid_rows", 5), jv-n("batch", 2), jv-n("cadence", hw-lift-cadence()), jv-s("negatives", hw-record-rejected()), jv-n("until_ms", until)])) ++ "\n";
  def hw-lift-needles() = ["[lift] judged", "[lift] cadence", "[lift] window", "[memory] held", "lora-lift:", "lift held"];
  def hw-lift-at(io, door, until) = hw-learn-door(io, "lift", door, hw-lift-request(until), until + hw-backstop-ms(), run => hw-learn-lines("lift", run, hw-lift-needles()));
  def hw-lift(until) = hw-lift-at(hch-dir(), hw-lift-door(), until);
  // ---- the 27B's lift: the judge's 717 s measured alone, doubled for its rows' captures, is what the trainer's bound leaves it
  def hw-lift-27b-judge-ms() = 1500000;
  def hw-lift-27b-floor-ms() = 2700000;
  def hw-lift-27b-out() = "form/form-stdlib/adapters/qwen38-last-block-next";
  // read 2026-11-01 on the 3B (parent 3585): the 6 rows the voice kept read better 1 at child 3425, and 6 rows we rejected read better 1 at 3441 and at 3446. This gate says the lift ran and moved, not that the rows earned it; the 27B's own judge reads them
  def hw-lifted-better?(lifted) = hw-has?(lifted, "[lift] judged") && hw-has?(lifted, ": better 1 ");
   // The trainer owns admission from its exact model and training geometry.
   def hw-lift-27b-why(lifted, left, doors) {
   let missing = filter(d => file_size(d) < 1, doors);
   !nil?(missing) ? missing[0] ++ " does not stand in this checkout"
   : !hw-lifted-better?(lifted) ? "this walk's 3B lift did not read better 1"
   : left < hw-lift-27b-floor-ms() ? hw-minutes(left) ++ " left cannot hold the trainer and the judge (" ++ hw-minutes(hw-lift-27b-floor-ms()) ++ ")"
    : "";
  }
  def hw-lift-27b-tail(step, run) = "[" ++ step ++ "] " ++ hw-learn-tail(step, run);
  def hw-lift-27b-judge(io, door, until, trained) {
   let run = hch-run-in(io, "lift-27b-judge", ["./fkwu", door], jv-emit(jv-object([jv-s("child", hw-lift-27b-out())])) ++ "\n", until + hw-backstop-ms());
   trained ++ "\n" ++ hw-learn-tail("lift-27b-judge", run);
  }
  def hw-lift-27b-train(io, doors, until, left, rows) {
   let run = hch-run-in(io, "lift-27b-train", ["./fkwu", doors[1]], jv-emit(jv-object([jv-s("out", hw-lift-27b-out()), jv-n("wall_s", (left - hw-lift-27b-judge-ms()) / 1000)])) ++ "\n", until + hw-backstop-ms());
   let said = rows ++ "\n" ++ hw-learn-tail("lift-27b-train", run);
   hch-ok?(run) ? hw-lift-27b-judge(io, doors[2], until, said) : said;
  }
  def hw-lift-27b-chain(io, doors, until, left) {
   let run = hch-run-in(io, "lift-27b-rows", ["./fkwu", doors[0]], "", hch-by(hch-step-backstop-ms()));
   hch-ok?(run) ? hw-lift-27b-train(io, doors, until, left, hw-learn-tail("lift-27b-rows", run)) : hw-learn-tail("lift-27b-rows", run);
  }
   def hw-lift-27b-at(io, doors, until, lifted) {
   let left = until - host_monotonic_ms();
    let why = hw-lift-27b-why(lifted, left, doors);
   (String) why == "" ? hw-lift-27b-chain(io, doors, until, left) : "[lift-27b] not this walk: " ++ why;
  }
   def hw-lift-27b(until, lifted) = hw-lift-27b-at(hch-dir(), hw-lift-27b-doors(), until, lifted);
  // ---- what the walk reads of itself, as children: neither opens a model
  def hw-proof-at(io, door) = hw-learn-door(io, "proof", door, "", hch-by(hch-step-backstop-ms()), run => hw-learn-tail("proof", run));
  def hw-proof() = hw-proof-at(hch-dir(), hw-proof-door());
  def hw-gaps-at(io, door) = hw-learn-door(io, "gaps", door, "", hch-by(hch-step-backstop-ms()), run => hw-learn-tail("gaps", run));
  def hw-gaps() = hw-gaps-at(hch-dir(), hw-gaps-door());
  // the meter reads usage counts, never words, and lands session by session, so a bound loses nothing
  def hw-rent-door() = "observe/session-rent-run.bml";
  def hw-steer-door() = "observe/self-steer-run.bml";
  def hw-rent-at(io, door) = hw-learn-door(io, "rent", door, "\n", hch-by(600000), run => hw-learn-lines("rent", run, ["[session-rent] "]));
  def hw-rent() = hw-rent-at(hch-dir(), hw-rent-door());
  def hw-steer-at(io, door) = hw-learn-door(io, "steer", door, "", hch-by(hch-step-backstop-ms()), run => hw-learn-tail("steer", run));
  def hw-steer() = hw-steer-at(hch-dir(), hw-steer-door());
 }
}
