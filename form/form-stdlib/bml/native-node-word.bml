// Native node identity: generated as one unsigned 64-bit word.
// preludes: form/form-stdlib/core.fk
section [form.bml] {
 def nnw-package-bits() = 6;
 def nnw-level-bits() = 13;
 def nnw-type-bits() = 12;
 def nnw-instance-bits() = 32;
 def nnw-mode-bits() = 1;
 def nnw-power(n) = if eq(n, 0) then 1 else mul(2, nnw-power(sub(n, 1)));
 def nnw-package-capacity() = nnw-power(nnw-package-bits());
 def nnw-level-capacity() = nnw-power(nnw-level-bits());
 def nnw-type-capacity() = nnw-power(nnw-type-bits());
 def nnw-instance-capacity() = nnw-power(nnw-instance-bits());
 def nnw-total-bits() = add(nnw-mode-bits(), add(nnw-package-bits(), add(nnw-level-bits(), add(nnw-type-bits(), nnw-instance-bits()))));
 def nnw-unsigned?(value, capacity) = if str_eq(value_kind(value), "int") then and(ge(value, 0), lt(value, capacity)) else 0;
 def nnw-integer-coordinate?(pkg, level, type) = if and(str_eq(value_kind(pkg), "int"), and(str_eq(value_kind(level), "int"), str_eq(value_kind(type), "int"))) then and(eq(pkg, 1), and(eq(level, 1), eq(type, 1))) else 0;
 def nnw-valid?(pkg, level, type, instance) = if nnw-integer-coordinate?(pkg, level, type) then str_eq(value_kind(instance), "int") else and(nnw-unsigned?(pkg, nnw-package-capacity()), and(nnw-unsigned?(level, nnw-level-capacity()), and(nnw-unsigned?(type, nnw-type-capacity()), nnw-unsigned?(instance, nnw-instance-capacity()))));
 def nnw-header() = str_concat("/* Generated by Form: observe/native-node-word-generate.bml. */\n#ifndef FK_NODE_WORD_H\n#define FK_NODE_WORD_H\ntypedef unsigned long long fk_node_id;\n_Static_assert(sizeof(fk_node_id) == 8, \"node identity requires a 64-bit word\");\n",
  str_concat(str_concat("#define FK_NID_PACKAGE_BITS ", int_to_str(nnw-package-bits())),
  str_concat(str_concat("\n#define FK_NID_LEVEL_BITS ", int_to_str(nnw-level-bits())),
  str_concat(str_concat("\n#define FK_NID_TYPE_BITS ", int_to_str(nnw-type-bits())),
  str_concat(str_concat("\n#define FK_NID_INSTANCE_BITS ", int_to_str(nnw-instance-bits())),
  "\n#define FK_NID_LEVEL_SHIFT (FK_NID_INSTANCE_BITS + FK_NID_TYPE_BITS)\n#define FK_NID_PACKAGE_SHIFT (FK_NID_LEVEL_SHIFT + FK_NID_LEVEL_BITS)\n#define FK_NID_MASK(bits) ((1ULL << (bits)) - 1ULL)\n#define FK_NID_MODE (1ULL << 63)\n_Static_assert(1 + FK_NID_PACKAGE_BITS + FK_NID_LEVEL_BITS + FK_NID_TYPE_BITS + FK_NID_INSTANCE_BITS == 64, \"node identity fields must occupy one word\");\nstatic int fk_nid_fits(long long p, long long l, long long t, long long i) {\n    if (p == 1 && l == 1 && t == 1) { return i >= -(1LL << 62) && i < (1LL << 62); }\n    return p >= 0 && (fk_node_id)p <= FK_NID_MASK(FK_NID_PACKAGE_BITS) &&\n           l >= 0 && (fk_node_id)l <= FK_NID_MASK(FK_NID_LEVEL_BITS) &&\n           t >= 0 && (fk_node_id)t <= FK_NID_MASK(FK_NID_TYPE_BITS) &&\n           i >= 0 && (fk_node_id)i <= FK_NID_MASK(FK_NID_INSTANCE_BITS);\n}\nstatic fk_node_id fk_nid_make(long long p, long long l, long long t, long long i) {\n    if (!fk_nid_fits(p, l, t, i)) { fk_die(\"fkwu: coordinate is outside the native 64-bit node identity layout\"); }\n    if (p == 1 && l == 1 && t == 1) { return ((fk_node_id)i) & ~FK_NID_MODE; }\n    return FK_NID_MODE | ((fk_node_id)p << FK_NID_PACKAGE_SHIFT) | ((fk_node_id)l << FK_NID_LEVEL_SHIFT) | ((fk_node_id)t << FK_NID_INSTANCE_BITS) | (fk_node_id)i;\n}\nstatic long long fk_nid_get(fk_node_id id, int field) {\n    if (!(id & FK_NID_MODE)) {\n        if (field != 3) { return 1; }\n        return id & (1ULL << 62) ? -1 - (long long)((~id) & ~FK_NID_MODE) : (long long)id;\n    }\n    if (field == 0) { return (long long)((id >> FK_NID_PACKAGE_SHIFT) & FK_NID_MASK(FK_NID_PACKAGE_BITS)); }\n    if (field == 1) { return (long long)((id >> FK_NID_LEVEL_SHIFT) & FK_NID_MASK(FK_NID_LEVEL_BITS)); }\n    if (field == 2) { return (long long)((id >> FK_NID_INSTANCE_BITS) & FK_NID_MASK(FK_NID_TYPE_BITS)); }\n    return (long long)(id & FK_NID_MASK(FK_NID_INSTANCE_BITS));\n}\n#endif\n")))));
 0;
}
