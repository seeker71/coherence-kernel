// Shared identity lives in Form. The native carrier supplies an owned regular
// file lease and positioned I/O; it never chooses a row or interprets a frame.
// Version 7 has its own journal. It never reinterprets a v6/private store.
import form-stdlib/bml/native-posix.bml;
import form-stdlib/bml/formbin-codec.bml;
import form-stdlib/bml/body-fingerprint.bml;
import form-stdlib/bml/field-reset-admission.bml;
section [form.bml] {
 let nfs-journals=record_new(0);
 let nfs-warmed-paths=record_new(0);
 let nfs-process=record_new(0);
 let nfs-admissions=record_new(0);
 class NativeField {
  // v6 shared rows were strictly below 2^26. IDs continue monotonically in
  // this version; reset must never recycle a published permanent coordinate.
  def nfs-first-id() = 67108864;
  def nfs-magic() = "FORMFLD7";
  def nfs-path() = "/tmp/form-field7-"+nps-result(102,24,[]).str()+".journal";
  def nfs-wire(value) {
   let encoded=fbc-encode(fbc-data(value));
   fbc-good(encoded) ? fbc-value(encoded) : form_error("native field encoding refused: "+fbc-error(encoded));
  }
  def nfs-unwire(bytes) {
   let decoded=fbc-decode(bytes);
    fbc-good(decoded) ? fbc-data-inert-value(fbc-value(decoded)) : form_error("native field decoding refused: "+fbc-error(decoded));
  }
  def nfs-read(fd,offset,count) = nfs-read-more(fd,offset,count,[]);
  def nfs-read-more(fd,offset,left,bins) = left==0 ? fbc-finish(bins,"") : {
   let observed=nps-read-at(fd,offset,left);
   observed[0]==-4 ? nfs-read-more(fd,offset,left,bins)
   : observed[0]<=0 ? form_error("native field read incomplete at "+offset.str()+": "+observed[0].str())
   : nfs-read-more(fd,offset+observed[0],left - observed[0],fbc-put(bins,observed[1]));
  };
  // The exact prefix and OS result remain available when a write fails.
  def nfs-write(fd,offset,bytes,written) = written==len(bytes) ? [1,written,0] : {
   let observed=nps-write-at(fd,offset+written,substring(bytes,written,len(bytes)));
   observed==-4 ? nfs-write(fd,offset,bytes,written)
   : observed<=0 ? [0,written,observed] : nfs-write(fd,offset,bytes,written+observed);
  };
   def nfs-memory(identity) {
    let fold=bfp-fold(nfs-magic(),bfp-initial());
    record_new(0,"identity",identity,"offset",8,"fold",fold,"seal",[8,fold],"stamp",nothing(),"durability_pending",1,"next",nfs-first-id(),"epoch",0,"nodes",0,"strings",0,"string_bytes",0,"pairs",0,"catalog",record_new(0),"coordinates",record_new(0),"sources",record_new(0),"roster",record_new(0),"rows",record_new(0),"keys",record_new(0),"pending",[],"valid",1);
   }
   def nfs-seal(state) = record_set(state,"seal",[record_get(state,"offset"),record_get(state,"fold")]);
   def nfs-stamp(lease,stage) {
    let stamp=nps-file-stamp(lease);
    nothing?(stamp) ? form_error("native field "+stage+" currentness stamp unavailable") : stamp;
   }
   def nfs-read-source(source,offset,count) = value_kind(source)=="string" ? substring(source,offset,offset+count) : nfs-read(source,offset,count);
   def nfs-fingerprint(fd,extent,offset,state) = offset==extent ? state : {
   let count=bfp-span(extent,offset);
    nfs-fingerprint(fd,extent,offset+count,bfp-fold(nfs-read-source(fd,offset,count),state));
  };
  def nfs-key(identity) = identity[0].str()+":"+identity[1].str();
   def nfs-open(lease) = nfs-open-mode(lease,1);
   def nfs-open-mode(lease,writing) {
   let fd=lease[1]; let identity=nps-file-identity(lease);
   if nothing?(identity) then form_error("native field lease identity unavailable") else {
    let extent=nps-file-size(fd);
    if extent==0 then {
      if writing != 1 then form_error("native field initialization requires its publication lease") else 0;
     let wrote=nfs-write(fd,0,nfs-magic(),0);
      if wrote[0]!=1 then form_error("native field header publication incomplete") else 0;
    } else 0;
    let size=nps-file-size(fd);
     let stamp=nfs-stamp(lease,"admission");
     let state=nfs-admit-image(identity,size,stamp,fd);
     if writing==1 && record_get(state,"durability_pending")==1 then {
      if nps-file-sync(fd)!=0 then form_error("native field recovered extent durability unavailable") else record_set(state,"durability_pending",0);
     } else 0;
     if stamp != nfs-stamp(lease,"recheck") then form_error("native field changed outside its publication lease") else nfs-admitted(state,stamp);
    };
   }
   // Admission reads either a leased descriptor or a complete captured image.
   // The retained seal remains the previous committed anchor until validation
   // succeeds. An image is only a warm cache; the writable lease admits effects.
   def nfs-admit-image(identity,size,stamp,source) {
     if size<8 || nfs-read-source(source,0,8)!=nfs-magic() then form_error("native field store schema unavailable or incompatible") else {
     let key=nfs-key(identity);
     let cached=record_has(nfs-journals,key) ? record_get(nfs-journals,key) : nothing();
     let trusted=!nothing?(cached) && record_get(cached,"valid")==1;
     let state=trusted ? cached : nfs-memory(identity);
     let seal=nothing?(cached) ? record_get(state,"seal") : record_get(cached,"seal");
     let observed=trusted ? [record_get(cached,"offset"),record_get(cached,"fold")] : seal;
     record_set(state,"seal",seal);
     record_set(state,"valid",0);
     if size<observed[0] then form_error("native field lost a previously observed committed extent") else 0;
      if !nothing?(cached) && (!trusted || stamp != record_get(cached,"stamp")) && nfs-fingerprint(source,observed[0],0,bfp-initial())!=observed[1] then form_error("native field previously committed bytes changed") else 0;
     let before=record_get(state,"offset");
      nfs-replay(source,state,size);
     if record_get(state,"offset")>before then record_set(state,"durability_pending",1) else 0;
      state;
    };
  }
   def nfs-admitted(state,stamp) {
    record_set(state,"stamp",stamp); nfs-seal(state); record_set(state,"valid",1);
    record_set(nfs-journals,nfs-key(record_get(state,"identity")),state); state;
   }
    // Capture bytes under the shared lease, then replay outside it. A cold
    // reader must not hold every writer while it constructs its local index.
    // Publication reacquires the writable lease and rechecks identity, the
    // committed prefix and every new frame before any caller effect executes.
   // Ownership and rotation. Every process that holds field state keeps a shared
   // flock on <journal>.owners for its whole life (a raw descriptor no cell owns;
   // the kernel drops it when the process ends). The first use tries an exclusive
   // lock first: granted means no other process holds any field state, so a journal
   // past the floor is rotated before anything is replayed. The new journal is one
   // field-rotate frame that carries the next id forward, so coordinates stay
   // monotonic and are never reissued; the replaced journal stays as <journal>.prior.
   def nfs-rotate-floor() = 262144;
   def nfs-own(path) = record_has(nfs-process,"owner") ? 0 : nfs-own-now(path);
   def nfs-own-now(path) {
    let owners=path+".owners";
    let made=nps-file-open(owners,1);
    if value_kind(made)!="list" then form_error("native field owner file unavailable: "+owners) else nps-file-settle(made);
    let fd=file_open(owners);
    if fd<0 then form_error("native field owner file unreadable: "+owners) else {
     let solo=nps-file-try-exclusive(fd)==0;
     let rotated=solo ? nfs-rotate(path) : 0;
     let shared=nps-result(73,131,[fd,1]);
     if shared != 0 then form_error("native field owner share refused: "+shared.str()) else 0;
     record_set(nfs-process,"owner",fd); record_set(nfs-process,"rotated",rotated); 0;
    };
   }
   // The last whole frame, by headers alone: [offset,count], or nothing() when any
   // header fails its checksum or a tail is incomplete (then nothing rotates).
   def nfs-last-frame(fd,offset,extent,last) = offset==extent ? last : extent - offset<40 ? nothing() : {
    let header=nfs-read(fd,offset,24); let lengthBytes=substring(header,0,8);
    if bfp-text(lengthBytes)!=substring(header,8,24) then nothing() else {
     let count=float_leaf(35,[3,lengthBytes,"value"]);
     count<0 || count>extent - offset - 40 ? nothing() : nfs-last-frame(fd,offset+40+count,extent,[offset,count]);
    };
   };
   def nfs-frame-bytes(rows,first) {
    let bytes=nfs-wire([1,first,rows]);
    let lengthBytes=float_leaf(34,[3,len(bytes)]);
    lengthBytes+bfp-text(lengthBytes)+bytes+bfp-text(bytes);
   }
   def nfs-rotation-frame?(frame) = fbc-proper?(frame) && len(frame)==3 && frame[0]==1 && value_kind(frame[1])=="int" && frame[1]>=nfs-first-id()
    && fbc-proper?(frame[2]) && len(frame[2])==1 && value_kind(frame[2][0])=="list" && !nil?(frame[2][0]) && frame[2][0][0]=="field-rotate";
   def nfs-rotate(path) {
    let lease=nps-file-lease(path,1);
    if nothing?(lease) then 0 else {
     defer nps-file-settle(lease);
     let fd=lease[1]; let extent=nps-file-size(fd);
     if extent<=nfs-rotate-floor() || nfs-read(fd,0,8)!=nfs-magic() then 0 else {
      let last=nfs-last-frame(fd,8,extent,nothing());
      if nothing?(last) then 0 else {
       let payload=nfs-read(fd,last[0]+24,last[1]+16); let bytes=substring(payload,0,last[1]);
       if substring(payload,last[1],last[1]+16)!=bfp-text(bytes) then 0 else {
        let frame=nfs-unwire(bytes);
        if !fbc-proper?(frame) || len(frame)!=3 || frame[0]!=1 || value_kind(frame[1])!="int" || !fbc-proper?(frame[2]) then 0 else {
         let next=frame[1]+len(frame[2]);
         let content=nfs-magic()+nfs-frame-bytes([["field-rotate",next,extent]],next);
         let fresh=path+".rotating";
         let written=nps-with-file(fresh,1,out=>{
          let cut=nps-file-resize(out,0); let wrote=nfs-write(out,0,content,0);
          wrote[0]==1 && cut==0 && nps-file-sync(out)==0 ? 1 : 0;
         });
         if written != 1 then form_error("native field rotation could not write "+fresh) else {
          if fs_rename(path,path+".prior")!=0 then form_error("native field rotation could not retain the prior journal") else 0;
          if fs_rename(fresh,path)!=0 then form_error("native field rotation could not publish "+fresh) else extent;
         };
        };
       };
      };
     };
    };
   }
   def nfs-warm(path) = record_has(nfs-warmed-paths,path) && record_get(record_get(nfs-warmed-paths,path),"valid")==1 ? 0 : {nfs-own(path); nfs-warm-now(path);};
   def nfs-warm-now(path) {
     let image=nfs-warm-image(path);
     if nothing?(image) then 0 else {
      let state=nfs-admit-image(image[0],len(image[2]),image[1],image[2]);
      record_set(nfs-warmed-paths,path,nfs-admitted(state,image[1])); 0;
     };
    }
    def nfs-warm-image(path) {
    let lease=nps-file-lease(path,0);
     if nothing?(lease) then nothing() else {
     defer nps-file-settle(lease);
      let size=nps-file-size(lease[1]);
       size<0 ? form_error("native field capture extent unavailable") : size==0 ? nothing() : {
       let identity=nps-file-identity(lease); let stamp=nfs-stamp(lease,"capture");
       let bytes=nfs-read(lease[1],0,size);
        if nothing?(identity) || len(bytes)!=size || size != nps-file-size(lease[1]) || stamp != nfs-stamp(lease,"captured") then form_error("native field changed during image capture") else [identity,stamp,bytes];
      };
    };
   }
   def nfs-cache-ready(lease) {
    let identity=nps-file-identity(lease);
    if nothing?(identity) then 0 else {
     let key=nfs-key(identity);
      if !record_has(nfs-journals,key) then 0 else {
       let state=record_get(nfs-journals,key);
       record_get(state,"valid")==1 && record_get(state,"offset")==nps-file-size(lease[1]) && record_get(state,"stamp")==nfs-stamp(lease,"ready");
      };
    };
   }
   // Read ahead within the leased, observed extent. The buffer is a working
   // quantum; a larger frame expands it and every frame keeps its own checks.
   // This view belongs only to this replay, never to the retained state cache.
   def nfs-replay-read(fd,view,offset,count,extent) {
    let start=record_get(view,"start"); let held=record_get(view,"bytes");
    if offset>=start && offset+count<=start+len(held) then substring(held,offset - start,offset - start+count) else {
     let span=max2(count,min2(65536,extent - offset));
      let bytes=nfs-read-source(fd,offset,span);
     record_set(view,"start",offset); record_set(view,"bytes",bytes);
     substring(bytes,0,count);
    };
   }
   def nfs-replay(fd,state,extent) {
    let before=record_get(state,"offset");
    if before==extent then 0 else {
     // The existing stage bus exposes actual replay progress without making
     // a native node (which would recursively ask this same field to warm).
     let stage=float_leaf(29,cons("native-field/replay",value_str([before,extent,record_get(state,"next")])));
     let outcome=record_new(0,"status","unfinished");
     defer float_leaf(30,[stage,record_get(outcome,"status"),record_get(state,"offset") - before,record_get(state,"next")]);
     let result=nfs-replay-window(fd,state,extent,record_new(0,"start",0,"bytes",""));
     record_set(outcome,"status","complete");result;
    };
   }
   def nfs-replay-window(fd,state,extent,view) {
   let offset=record_get(state,"offset");
   if offset==extent then 0 else if extent - offset<40 then form_error("native field has an incomplete unpublished frame; retained for its owner") else {
     let header=nfs-replay-read(fd,view,offset,24,extent); let lengthBytes=substring(header,0,8);
    if bfp-text(lengthBytes)!=substring(header,8,24) then form_error("native field frame extent checksum failed") else {
     let count=float_leaf(35,[3,lengthBytes,"value"]);
     if count<0 || count>extent - offset - 40 then form_error("native field frame extends beyond the retained journal") else {
       let payload=nfs-replay-read(fd,view,offset+24,count+16,extent);
       let bytes=substring(payload,0,count); let checksum=bfp-text(bytes);
       if substring(payload,count,count+16)!=checksum then form_error("native field frame checksum failed") else {
       let frame=nfs-unwire(bytes);
       // A rotated journal opens with one field-rotate frame carrying the next id.
       if offset==8 && record_get(state,"next")==nfs-first-id() && nfs-rotation-frame?(frame) then record_set(state,"next",frame[1]) else 0;
       if !fbc-proper?(frame) || len(frame)!=3 || frame[0]!=1 || frame[1]!=record_get(state,"next") || !fbc-proper?(frame[2]) || nil?(frame[2]) then form_error("native field frame sequence or rows refused") else {
         foldl((done,row)=>{nfs-apply(state,row);done;},0,frame[2]);
          record_set(state,"fold",bfp-fold(header+payload,record_get(state,"fold")));
        record_set(state,"offset",offset+40+count);
         nfs-replay-window(fd,state,extent,view);
       };
      };
     };
    };
   };
  }
  // Keys are process-local indexes over admitted values. Journal and gift
  // payloads retain FORMBIN2; replay rebuilds every index with this same key.
   def nfs-value-key(value) = fbc-data-key(value);
  def nfs-row-key(state,row) = nfs-value-key(value_kind(row)=="list" && !nil?(row) && (row[0]=="node" || row[0]=="integer" || row[0]=="string" || row[0]=="real" || row[0]=="cons") ? [record_get(state,"epoch"),row] : row);
  def nfs-apply(state,row) = nfs-insert(state,row,nfs-row-key(state,row));
  def nfs-gifts(state) = record_has(state,"gifts") ? record_get(state,"gifts") : {
    let gifts=record_new(0,"serial",0,"slots",record_new(0),"generations",record_new(0),"byte_generations",record_new(0),"frames",record_new(0),"publications",record_new(0),"attempts",record_new(0),"publication_attempts",record_new(0),"readers",record_new(0),"promotions",record_new(0),"reclaimed",record_new(0));
   record_set(state,"gifts",gifts); gifts;
  };
  def nfs-gift-table(state,name) = record_get(nfs-gifts(state),name);
  def nfs-gift-natural(value) = value_kind(value)=="int" && value>=0;
  def nfs-gift-existing(state,id) = value_kind(id)=="int" && !nothing?(nfs-gift-generation(state,id));
  def nfs-gift-dependencies(state,ids) = fbc-proper?(ids) && all?(id=>nfs-gift-existing(state,id) && !record_has(nfs-gift-table(state,"reclaimed"),id.str()),ids);
  def nfs-gift-apply(state,id,row) {
   let kind=value_kind(row)=="list" && !nil?(row) ? row[0] : "";
   if kind=="gift-generation" then {
    if !fbc-proper?(row) || len(row)!=12 || !nfs-gift-natural(row[1]) || row[1]!=record_get(nfs-gifts(state),"serial")+1
     || !nfs-gift-natural(row[2]) || row[2]<nfs-first-id() || !record_has(nfs-gift-table(state,"slots"),row[2].str())
     || value_kind(row[3])!="string" || len(row[3])==0 || value_kind(row[4])!="string"
     || !nfs-gift-natural(row[5]) || row[5]==0 || !nfs-gift-natural(row[6]) || row[6]==0
     || (row[7]!=0 && row[7]!=1) || !nfs-gift-natural(row[8]) || !nfs-gift-dependencies(state,row[9]) || !all?(dependency=>dependency<id,row[9])
     || !nfs-gift-natural(row[10]) || row[10]<nfs-gift-header-bytes() || row[8]>row[10] - nfs-gift-header-bytes()
     || value_kind(row[11])!="string" || len(row[11])!=16 then form_error("owned gift generation metadata refused") else {
     let coordinate=nfs-gift-coordinate(row);
     if nfs-parts(make_nodeid(coordinate[0],coordinate[1],coordinate[2],coordinate[3]))!=coordinate then form_error("owned gift generation exhausted its native coordinate") else 0;
     record_set(nfs-gifts(state),"serial",row[1]); record_set(nfs-gift-table(state,"generations"),id.str(),1);
    };
   }
   else if kind=="gift-slot" then {
    if !fbc-proper?(row) || len(row)!=5 || !nfs-gift-natural(row[1]) || row[1]<nfs-first-id() || !nfs-gift-natural(row[2]) || row[2]<nfs-gift-header-bytes()
     || (row[3]!=0 && !nfs-gift-existing(state,row[3])) || !nfs-gift-natural(row[4])
     || (row[4]==0 ? row[1]!=id || record_has(nfs-gift-table(state,"slots"),row[1].str()) : !record_has(nfs-gift-table(state,"slots"),row[1].str()) || record_get(nfs-gift-table(state,"slots"),row[1].str())!=row[4])
    then form_error("owned gift slot history refused") else record_set(nfs-gift-table(state,"slots"),row[1].str(),id);
   }
   else if kind=="gift-frame" then {
    if !fbc-proper?(row) || len(row)!=4 || value_kind(row[1])!="string" || (row[2]!=0 && !nfs-gift-existing(state,row[2])) || !nfs-gift-natural(row[3])
     || row[3]!=(record_has(nfs-gift-table(state,"frames"),row[1]) ? record_get(nfs-gift-table(state,"frames"),row[1]) : 0)
     then form_error("owned gift frame metadata refused") else {
      record_set(nfs-gift-table(state,"frames"),row[1],id);
      let generation=row[2]>0 ? nfs-gift-generation(state,row[2]) : nothing();
      if !nothing?(generation) then record_set(nfs-gift-table(state,"publications"),nfs-gift-publication-key(row[1],generation[4]),id) else 0;
     };
   }
   else if kind=="gift-reader" then {
    if !fbc-proper?(row) || len(row)!=6 || !nfs-gift-natural(row[1]) || row[1]==0 || !nfs-gift-natural(row[2]) || row[2]==0 || !nfs-gift-natural(row[3]) || !nfs-gift-dependencies(state,row[4]) || !nfs-gift-natural(row[5])
     || row[5]!=(record_has(nfs-gift-table(state,"readers"),row[1].str()+":"+row[2].str()) ? record_get(nfs-gift-table(state,"readers"),row[1].str()+":"+row[2].str()) : 0)
    then form_error("owned gift reader metadata refused") else record_set(nfs-gift-table(state,"readers"),row[1].str()+":"+row[2].str(),id);
   }
   else if kind=="gift-attempt" then {
    if !fbc-proper?(row) || len(row)!=9 || value_kind(row[1])!="string" || value_kind(row[2])!="string" || !nfs-gift-natural(row[3]) || row[3]==0 || !nfs-gift-natural(row[4]) || row[4]==0
     || !nfs-gift-natural(row[5]) || row[5] % 2!=0 || value_kind(row[6])!="string" || (row[7]!=0 && !nfs-gift-existing(state,row[7]))
     || row[8]!=(record_has(nfs-gift-table(state,"attempts"),row[1]) ? record_get(nfs-gift-table(state,"attempts"),row[1]) : 0)
     then form_error("owned gift publication attempt refused") else {
      record_set(nfs-gift-table(state,"attempts"),row[1],id);
      record_set(nfs-gift-table(state,"publication_attempts"),nfs-gift-publication-key(row[1],row[2]),id);
     };
   }
   else if kind=="gift-bytes" then {
    if !fbc-proper?(row) || len(row)!=2 || !nfs-gift-existing(state,row[1]) then form_error("owned byte-frame generation refused")
    else record_set(nfs-gift-table(state,"byte_generations"),row[1].str(),1);
   }
   else if kind=="gift-promote" || kind=="gift-reclaimed" then {
    if !fbc-proper?(row) || len(row)!=2 || !nfs-gift-existing(state,row[1]) then form_error("owned gift generation transition refused")
    else record_set(nfs-gift-table(state,kind=="gift-promote" ? "promotions" : "reclaimed"),row[1].str(),1);
   }
   else 0;
  }
  def nfs-insert(state,row,key) {
   let id=record_get(state,"next");
   let native=value_kind(row)=="list" && !nil?(row) && row[0]=="node";
   let coordinate=native ? nfs-value-key(nfs-row-coordinate(state,id,row)) : "";
   if native && record_has(record_get(state,"coordinates"),coordinate) then form_error("native field coordinate would name two different rows") else 0;
   if id>4294967295 then form_error("native field exhausted the native instance coordinate")
   else if record_has(record_get(state,"keys"),key) then form_error("native field journal repeats an already issued row") else {
    record_set(record_get(state,"rows"),id.str(),row);
    record_set(record_get(state,"keys"),key,id);
    if native then {
     record_set(state,"nodes",record_get(state,"nodes")+1);
     record_set(record_get(state,"catalog"),record_get(state,"nodes").str(),id);
     record_set(record_get(state,"coordinates"),coordinate,id);
    } else if value_kind(row)=="list" && !nil?(row) && row[0]=="string" then {
     record_set(state,"strings",record_get(state,"strings")+1); record_set(state,"string_bytes",record_get(state,"string_bytes")+len(row[1]));
    } else if value_kind(row)=="list" && !nil?(row) && row[0]=="cons" then record_set(state,"pairs",record_get(state,"pairs")+1) else 0;
    if value_kind(row)=="list" && len(row)==5 && row[0]=="source" then record_set(record_get(state,"sources"),row[1].str(),row[2:]) else 0;
    if value_kind(row)=="list" && len(row)==5 && row[0]=="roster" then record_set(record_get(state,"roster"),row[1].str(),id) else 0;
    if value_kind(row)=="list" && !nil?(row) && row[0]=="field-reset" then {
