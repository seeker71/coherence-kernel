// reply-envelope.bml — the planner reply's envelope as a byte grammar that holds a decode where it is made.
//
// The envelope: blocks <plan>, <goal>, <cases> or <band>, and <reference>, each at most once, with only whitespace
// between them. <plan> holds one JSON object; <cases> one JSON array of at most eight objects; <goal>, <band> and
// <reference> hold text up to their own close tag. Each block has a byte room, and a JSON string has its own.
//
// A state is [mode, tag, buf, stack, js, elems, seen, n, sl]:
//   mode  out (between blocks), open (reading an opening tag, buf the bytes so far), json, text, close (the JSON
//         value is whole, buf the close tag read so far), end (every block the reply needs is closed), broken
//   tag   the block's name; stack the open JSON containers, innermost first; js the JSON lexical state (value,
//         value0, key0, key, keystr, keyesc, colon, str, esc, num, lit, after); elems the cases array's entries;
//         seen the closed blocks; n the block's bytes; sl the string's bytes (lit: the literal read so far)
//
// renv-step(state, byte) answers the next state, or nothing() where the byte leaves the envelope; renv-feed walks a
// token's text. renv-stop-ok? reads whether a stop may end the reply here: between blocks or after the last one.
import form-stdlib/core.fk;
section [form.bml] {
 class ReplyEnvelope {
  def renv-tags() = ["plan", "goal", "cases", "band", "reference"];
  def renv-json?(tag) = (String) tag == "plan" || (String) tag == "cases";
  def renv-room(tag) = (String) tag == "plan" ? 6000 : (String) tag == "goal" ? 3000 : (String) tag == "cases" ? 8000 : 16000;
  def renv-string-room() = 1200;
  def renv-case-cap() = 8;
  def renv-start() = ["out", "", "", [], "", 0, [], 0, 0];
  def renv-mode(st) = st[0];
  def renv-seen(st) = st[6];
  def renv-at(st, mode, tag, buf, stack, js, elems, seen, n, sl) = [mode, tag, buf, stack, js, elems, seen, n, sl];
  def renv-ws?(b) = b == 32 || b == 10 || b == 13 || b == 9;
  def renv-digit?(b) = b >= 48 && b <= 57;
  def renv-has?(xs, x) = any?(y => (String) y == x, xs);
  def renv-prefix?(s, p) = len(s) <= len(p) && (String) substring(p, 0, len(s)) == s;
  def renv-chr(b) = substring(" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~", b - 32, b - 31);
  def renv-open-tag(tag) = "<" ++ tag ++ ">";
  def renv-close-tag(tag) = "</" ++ tag ++ ">";
  // a tag may open when it is not yet closed and cases and band stay one of
  def renv-may-open?(seen, tag) = !renv-has?(seen, tag) && !(((String) tag == "cases" && renv-has?(seen, "band")) || ((String) tag == "band" && renv-has?(seen, "cases")));
  // the reply is whole once the reference and its witness are closed
  def renv-whole?(seen) = renv-has?(seen, "reference") && (renv-has?(seen, "cases") || renv-has?(seen, "band"));
  def renv-stop-ok?(st) = !nothing?(st) && ((String) renv-mode(st) == "out" || (String) renv-mode(st) == "end" || (String) renv-mode(st) == "broken");
  // the state after an id, nothing where the id leaves the envelope: a stop id carries no text
  def renv-take(st, id, textf, stop?) = stop?(id) ? (renv-stop-ok?(st) ? st : nothing()) : renv-feed(st, textf(id));
  // the first id of ids, in the decode's own order, that keeps the reply inside the envelope; nothing when none does
  def renv-pick(st, ids, textf, stop?) = nil?(ids) ? nothing() : ids[0] >= 0 && !nothing?(renv-take(st, ids[0], textf, stop?)) ? ids[0] : renv-pick(st, ids[1:], textf, stop?);
  def renv-feed(st, text) = renv-feed-at(st, text, 0);
  def renv-feed-at(st, text, i) = nothing?(st) || i >= len(text) ? st : renv-feed-at(renv-step(st, str_byte_at(text, i)), text, i + 1);
  def renv-step(st, b) {
   let mode = renv-mode(st);
   (String) mode == "broken" ? st
   : (String) mode == "end" ? nothing()
   : (String) mode == "out" ? (renv-ws?(b) ? st : b == 60 ? renv-at(st, "open", "", "<", [], "", 0, renv-seen(st), 0, 0) : nothing())
   : (String) mode == "open" ? renv-opening(st, b)
   : st[7] >= renv-room(st[1]) ? nothing()
   : (String) mode == "text" ? renv-text(st, b)
   : (String) mode == "close" ? renv-closing(st, b)
   : renv-json(st, b);
  }
  def renv-opening(st, b) {
   let buf = st[2] ++ (b < 32 || b > 126 ? "\n" : renv-chr(b));
   let fits = filter(tag => renv-may-open?(renv-seen(st), tag) && renv-prefix?(buf, renv-open-tag(tag)), renv-tags());
   nil?(fits) ? nothing() : {
    let whole = filter(tag => (String) renv-open-tag(tag) == buf, fits);
    nil?(whole) ? renv-at(st, "open", "", buf, [], "", 0, renv-seen(st), 0, 0)
    : renv-at(st, renv-json?(whole[0]) ? "json" : "text", whole[0], "", [], "value", 0, renv-seen(st), 0, 0);
   };
  }
  def renv-closed(st) {
   let seen = cons(st[1], renv-seen(st));
   renv-at(st, renv-whole?(seen) ? "end" : "out", "", "", [], "", 0, seen, 0, 0);
  }
  // text runs to its own close tag; '<' opens the only place that tag can begin
  def renv-text(st, b) {
   let close = renv-close-tag(st[1]);
   let buf = b == 60 ? "<" : len(st[2]) > 0 && b >= 32 && b <= 126 && renv-prefix?(st[2] ++ renv-chr(b), close) ? st[2] ++ renv-chr(b) : "";
   (String) buf == close ? renv-closed(st) : renv-at(st, "text", st[1], buf, [], "", 0, renv-seen(st), st[7] + 1, 0);
  }
  def renv-closing(st, b) {
   let close = renv-close-tag(st[1]);
   len(st[2]) == 0 && renv-ws?(b) ? renv-bump(st)
   : b < 32 || b > 126 || !renv-prefix?(st[2] ++ renv-chr(b), close) ? nothing()
   : (String) (st[2] ++ renv-chr(b)) == close ? renv-closed(st)
   : renv-at(st, "close", st[1], st[2] ++ renv-chr(b), [], "", st[5], renv-seen(st), st[7] + 1, 0);
  }
  def renv-bump(st) = renv-at(st, st[0], st[1], st[2], st[3], st[4], st[5], st[6], st[7] + 1, st[8]);
  def renv-js(st, js, sl) = renv-at(st, "json", st[1], "", st[3], js, st[5], st[6], st[7] + 1, sl);
  def renv-push(st, kind, js, elems) = renv-at(st, "json", st[1], "", cons(kind, st[3]), js, elems, st[6], st[7] + 1, 0);
  // a container closes; the top one's close turns to the close tag
  def renv-pop(st, kind) = nil?(st[3]) || (String) st[3][0] != kind ? nothing() : nil?(st[3][1:]) ? renv-at(st, "close", st[1], "", [], "", st[5], st[6], st[7] + 1, 0) : renv-at(st, "json", st[1], "", st[3][1:], "after", st[5], st[6], st[7] + 1, 0);
  def renv-json(st, b) {
   let js = st[4];
   (String) js == "str" ? renv-in-string(st, b, "str", "esc", "after")
   : (String) js == "keystr" && renv-case-object?(st) ? renv-case-key(st, b)
   : (String) js == "keystr" ? renv-in-string(st, b, "keystr", "keyesc", "colon")
   : (String) js == "esc" ? (renv-has?(["\"", "\\", "/", "b", "f", "n", "r", "t", "u"], renv-chr(b < 32 || b > 126 ? 32 : b)) ? renv-js(st, "str", st[8] + 1) : nothing())
   : (String) js == "keyesc" ? (renv-has?(["\"", "\\", "/", "b", "f", "n", "r", "t", "u"], renv-chr(b < 32 || b > 126 ? 32 : b)) ? renv-js(st, "keystr", st[8] + 1) : nothing())
   : (String) js == "num" ? (renv-digit?(b) || b == 46 || b == 101 || b == 69 || b == 43 || b == 45 ? renv-js(st, "num", 0) : renv-after(renv-at(st, "json", st[1], "", st[3], "after", st[5], st[6], st[7], 0), b))
   : (String) js == "lit" ? renv-literal(st, b)
   : renv-ws?(b) ? renv-bump(st)
   : (String) js == "colon" ? (b == 58 ? renv-js(st, "value", 0) : nothing())
   : (String) js == "key0" ? (b == 125 ? renv-pop(st, "{") : b == 34 ? renv-js(st, "keystr", 0) : nothing())
   : (String) js == "key" ? (b == 34 ? renv-js(st, "keystr", 0) : nothing())
   : (String) js == "value0" && b == 93 ? ((String) st[1] == "cases" && nil?(st[3][1:]) ? nothing() : renv-pop(st, "["))
   : (String) js == "value" || (String) js == "value0" ? renv-value(st, b)
   : renv-after(st, b);
  }
  // a case object's keys are function, arguments, equals or call: buf carries the key read so far
  def renv-case-keys() = ["function", "arguments", "equals", "call"];
  def renv-case-object?(st) = (String) st[1] == "cases" && len(st[3]) == 2;
  def renv-case-array?(st) = (String) st[1] == "cases" && len(st[3]) == 1;
  def renv-case-key(st, b) {
   let read = st[2] ++ (b < 32 || b > 126 ? "\n" : renv-chr(b));
   b == 34 ? (renv-has?(renv-case-keys(), st[2]) ? renv-js(st, "colon", 0) : nothing())
   : any?(k => renv-prefix?(read, k), renv-case-keys()) ? renv-at(st, "json", st[1], read, st[3], "keystr", st[5], st[6], st[7] + 1, 0)
   : nothing();
  }
  def renv-in-string(st, b, here, esc, next) = b == 34 ? renv-js(st, next, 0) : b == 92 ? renv-js(st, esc, st[8] + 1) : b < 32 || st[8] >= renv-string-room() ? nothing() : renv-js(st, here, st[8] + 1);
  def renv-literal(st, b) {
   let read = st[2] ++ renv-chr(b < 32 || b > 126 ? 32 : b);
   let fits = filter(w => renv-prefix?(read, w), ["true", "false", "null"]);
   nil?(fits) ? nothing() : any?(w => (String) w == read, fits) ? renv-at(st, "json", st[1], "", st[3], "after", st[5], st[6], st[7] + 1, 0) : renv-at(st, "json", st[1], read, st[3], "lit", st[5], st[6], st[7] + 1, 0);
  }
  // the top value is the block's own: an object for <plan>, an array for <cases>; each case is an object, eight at most
  def renv-value(st, b) {
   let top = nil?(st[3]);
   let entry = !top && nil?(st[3][1:]) && (String) st[1] == "cases";
   top ? ((String) st[1] == "plan" && b == 123 ? renv-push(st, "{", "key0", 0) : (String) st[1] == "cases" && b == 91 ? renv-push(st, "[", "value0", 0) : nothing())
   : entry ? (b == 123 && st[5] < renv-case-cap() ? renv-push(st, "{", "key0", st[5] + 1) : nothing())
   : b == 123 ? renv-push(st, "{", "key0", st[5])
   : b == 91 ? renv-push(st, "[", "value0", st[5])
   : b == 34 ? renv-js(st, "str", 0)
   : renv-digit?(b) || b == 45 ? renv-js(st, "num", 0)
   : b == 116 || b == 102 || b == 110 ? renv-at(st, "json", st[1], renv-chr(b), st[3], "lit", st[5], st[6], st[7] + 1, 0)
   : nothing();
  }
  def renv-after(st, b) {
   let kind = nil?(st[3]) ? "" : st[3][0];
   renv-ws?(b) ? renv-bump(st)
   : b == 44 ? ((String) kind == "[" && !(renv-case-array?(st) && st[5] >= renv-case-cap()) ? renv-js(st, "value", 0) : (String) kind == "{" ? renv-js(st, "key", 0) : nothing())
   : b == 93 ? renv-pop(st, "[")
   : b == 125 ? renv-pop(st, "{")
   : nothing();
  }
 }
 0;
}
