//////////////////////////////////////////////////////////////////////
// form-cli-peer-direct-answer-dispatch.bml -- high-grammar direct speech
// dispatch for a caller-held Form-cli resident.
//
// A direct answer is an already-born local effect.  Selecting it does not
// require a second model observation of the task: the same live session takes
// the scannerless task bytes directly, under the caller's current resource
// lease.  `nothing` remains absence; numeric 0 and 1 remain ordinary values
// carried unchanged by the action result.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-peer-direct-answer-action.fk

section [form.bml] {
    class FormCliPeerDirectAnswerDispatch {
        field DirectAnswerDispatchRoute = "direct-answer";
        field DirectAnswerDispatchCarrier = "form-native-metal-jit";
        field DirectAnswerDispatchBranchRule = "direct-answer-enters-the-held-session-before-model-task-observation";

        def fcpdad-route() = DirectAnswerDispatchRoute();
        def fcpdad-carrier() = DirectAnswerDispatchCarrier();
        def fcpdad-branch-rule() = DirectAnswerDispatchBranchRule();
        def fcpdad-selected?(action) = if str_eq(action, fcpdad-route()) then 1 else 0;
        def fcpdad-run(session, task_kind, task_text, allocation) {
            fcpdaa-peer(fcpdaa-run(session, task_kind, task_text, allocation));
        }
    }
    0;
}
