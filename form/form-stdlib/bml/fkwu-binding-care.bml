// Care for a binding the fkwu compiler could not resolve. The kernel names the need
// itself: a `form-organ health` row with resource `binding` and the name as detail
// (runtime/fkwu-uni.c, fk_diag_signal). This provider answers it from the tree.
// preflight classifies the name (observe/preflight.fk pf-classify) and finds the units
// that define it (preflight-source.bml). When no kernel resolves the name and exactly
// one unit defines it, that unit joins the cell's preludes line and the cell compiles
// fresh through the kernel's compile-only door (pf-check, ./fkwu --check): diagnostics
// come back and nothing runs. The edit stays only when that binding is gone and no error
// appeared that was not already there; otherwise the cell's bytes go back exactly as they
// were. That is observe/tree-heal.fk's discipline: the reading decides, never the edit.
// A typo, a lane seam, a portable name or an arm that could not be observed leaves the
// need open, with the classification as its evidence. Either way the provider's own
// look is the re-observation, voiced as care_of the first reading. It edits only the tree
// the runner stands in; a stage run elsewhere is answered and left as it is.
// preludes: form-stdlib/organ-care.bml form-stdlib/bml/form-cli-heal-native-io.bml observe/preflight.fk
section [form.bml] {
 class FkwuBindingCare {
  def fkbc-provider() = oc-provider("fkwu-binding-prelude",list("binding"),"revise",fkbc-supply);

  // the cell a child compiles: ./fkwu <cell.fk|cell.bml> [arg]
  def fkbc-cell(argv) = len(argv) < 2 ? "" : !pfs-ends?(head(argv),"fkwu") ? "" : pfs-ends?(argv[1],".fk") || pfs-ends?(argv[1],".bml") ? argv[1] : "";
  def fkbc-argv(job,stage) = oh-values(json-array-elements(fhn-json(fhn-at(job,stage ++ ".argv.json"))));
  // the runner records where each stage ran; a heal snapshot's work copy is not this tree
  def fkbc-at-root?(job,stage) = (String) fhn-read(fhn-at(job,stage ++ ".cwd")) == fhn-root();

  // the compiler's own signal rows in one compile's output
  def fkbc-mark() = "form-organ health ";
  def fkbc-signals(out) = fkbc-rows(split-on(out,"\n"));
  def fkbc-rows(lines) = nil?(lines) ? list() : (Comparable) str_find(head(lines),fkbc-mark(),0) == 0 ? fkbc-row(parse-json("fkwu-signal",substring(head(lines),str_len(fkbc-mark()),str_len(head(lines)))),fkbc-rows(tail(lines))) : fkbc-rows(tail(lines));
  def fkbc-row(row,rest) = oh-valid(row) && (((String) oh-str(row,"organ") == "fkwu-compiler") && ((String) oh-str(row,"aspect") == "diagnostic")) ? cons(row,rest) : rest;
  def fkbc-binding?(row) = (String) oh-str(row,"observed") == "binding-missing";
  def fkbc-name(row) = json-string-value(oh-get(head(json-array-elements(oh-get(row,"needs"))),"detail"));
  def fkbc-missing?(rows,name) = nil?(rows) ? 0 : fkbc-binding?(head(rows)) && ((String) fkbc-name(head(rows)) == name) ? 1 : fkbc-missing?(tail(rows),name);
  // An error is known by what it asks for. Its coordinate moves when a unit joins the
  // assembled chain, so the line and column are not part of its identity.
  def fkbc-errors(rows) = nil?(rows) ? list() : oh-pain(head(rows)) ? cons(json-emit(oh-get(head(rows),"needs")),fkbc-errors(tail(rows))) : fkbc-errors(tail(rows));
  def fkbc-within?(after,before) = nil?(after) ? 1 : (oh-has(before,head(after)) && fkbc-within?(tail(after),before));
  def fkbc-exit(out) {
   let mark = pf-command-failure-mark() ++ " exit=";
   let at = str_find(out,mark,0);
   at < 0 ? 0 : str_to_int(fh-trim(substring(out,at + str_len(mark),str_len(out))));
  }
  def fkbc-compiled?(out) = (Comparable) pf-unsupported?(out) == 0;

  // the preludes line, in either tongue: the offset of its line, or -1
  def fkbc-prelude-line?(text,i) = pfs-at?(text,i,"; preludes:") || pfs-at?(text,i,"// preludes:");
  def fkbc-prelude-at(text,at) = at >= str_len(text) ? -1 : fkbc-prelude-line?(text,pfs-skip-blank(text,at)) ? at : fkbc-prelude-at(text,pfs-eol(text,at) + 1);
  def fkbc-tongue(cell) = pfs-ends?(cell,".bml") ? "// preludes:" : "; preludes:";
  def fkbc-with-prelude(text,unit,tongue) {
   let at = fkbc-prelude-at(text,0);
   at < 0 ? tongue ++ " " ++ unit ++ "\n" ++ text : fkbc-join-line(text,pfs-eol(text,at),unit,substring(text,at,pfs-eol(text,at)));
  }
  def fkbc-join-line(text,eol,unit,line) = oh-has(split-on(line," "),unit) ? text : substring(text,0,eol) ++ " " ++ unit ++ substring(text,eol,str_len(text));
  // the spelling every cell writes: form/form-stdlib/x resolves as form-stdlib/x
  def fkbc-token(home) = pfs-at?(home,0,"form/") ? substring(home,5,str_len(home)) : home;

  // the asking organ's reading after care, from the kernel's own signal
  def fkbc-reading(reading,name,rows,out,evidence) {
   let errors = fkbc-errors(rows);
   let exit = fkbc-exit(out);
   let missing = fkbc-missing?(rows,name);
   let clean = (!missing) && (nil?(errors) && ((Comparable) exit == 0));
   let observed = clean ? "clean" : missing ? "binding-missing" : "compile-error";
   let needs = clean ? list() : missing ? list(oh-need("binding",json-node-string(name))) : list(oh-need("source-diagnostics",json-node-string(nil?(errors) ? "exit " ++ int_to_str(exit) : int_to_str(len(errors)) ++ " error signals remain")));
   oh-reading(oh-str(reading,"organ"),oh-str(reading,"flow"),oh-str(reading,"aspect"),oh-get(reading,"expected"),json-node-string(observed),json-node-int(clean ? 1 : 0),needs,oh-values(json-array-elements(oh-get(reading,"offers"))),oh-set(evidence,"exit",json-node-int(exit)));
  }
  // When the provider could not look again, the reading is restated as a fresh
  // observation of the same content, naming why no compile was read.
  def fkbc-restate(reading,cell,name,reason) = oh-reading(oh-str(reading,"organ"),oh-str(reading,"flow"),oh-str(reading,"aspect"),oh-get(reading,"expected"),oh-get(reading,"observed"),oh-get(reading,"health"),json-array-elements(oh-get(reading,"needs")),oh-values(json-array-elements(oh-get(reading,"offers"))),json-node-object(list(oh-s("re_observation","none"),oh-s("reason",reason),oh-s("cell",cell),oh-s("name",name))));
  def fkbc-evidence(cell,name,classification,unit,edit,rows) = json-node-object(list(oh-s("re_observation","compile-only"),oh-s("cell",cell),oh-s("name",name),oh-s("classification",classification),oh-s("unit",unit),oh-s("edit",edit),oh-n("error_signals",len(fkbc-errors(rows)))));

  // Every answer keeps the reading it re-observed for the asking organ's callback and
  // leaves one outcome line in the job, where the door reads whether an edit stayed.
  def fkbc-answer(context,state,reason,cell,name,classification,unit,edit,fresh) {
   let job = record_get(context,"job");
   let line = fhn-json-line(fhn-at(job,"binding-care.jsonl"),list(oh-s("name",name),oh-s("cell",cell),oh-s("unit",unit),oh-s("edit",edit),oh-s("state",state),oh-s("reason",reason),oh-s("classification",classification)));
   let held = record_set(context,"binding_fresh",fresh);
   json-node-object(list(oh-s("resource","binding"),oh-s("state",state),oh-s("reason",reason),oh-s("name",name),oh-s("cell",cell),oh-s("classification",classification),oh-s("unit",unit),oh-s("edit",edit)));
  }
  def fkbc-supply(context,reading,need) {
   let name = json-string-value(oh-get(need,"detail"));
   let job = record_get(context,"job");
   let stage = record_get(context,"stage");
   let cell = fkbc-cell(fkbc-argv(job,stage));
   (String) cell == "" ? fkbc-answer(context,"unavailable","no-fkwu-cell-in-argv",cell,name,"","","none",fkbc-restate(reading,cell,name,"no-fkwu-cell-in-argv"))
   : !fkbc-at-root?(job,stage) ? fkbc-answer(context,"unavailable","stage-ran-outside-the-root",cell,name,"","","none",fkbc-restate(reading,cell,name,"stage-ran-outside-the-root"))
   : fkbc-supply-cell(context,reading,name,cell);
  }
  def fkbc-supply-cell(context,reading,name,cell) {
   let before = pf-check(cell);
   let rows = fkbc-signals(before);
   !fkbc-compiled?(before) ? fkbc-answer(context,"unavailable","no-compile-lane",cell,name,"","","none",fkbc-restate(reading,cell,name,"no-compile-lane"))
   : !fkbc-missing?(rows,name) ? fkbc-answer(context,"settled-by-observation","binding-already-present",cell,name,"","","none",fkbc-reading(reading,name,rows,before,fkbc-evidence(cell,name,"","","none",rows)))
   : fkbc-classified(context,reading,name,cell,before,rows,pf-classify(name));
  }
  def fkbc-classified(context,reading,name,cell,before,rows,classification) {
   let homes = pfs-at?(classification,0,"UNPRELUDED") ? pfs-defn-homes(name) : list();
   !((Comparable) len(homes) == 1) ? fkbc-answer(context,"need-open",nil?(homes) ? "classification" : int_to_str(len(homes)) ++ " defining units",cell,name,classification,"","none",fkbc-reading(reading,name,rows,before,fkbc-evidence(cell,name,classification,"","none",rows)))
   : fkbc-attempt(context,reading,name,cell,before,rows,classification,fkbc-token(head(homes)),read_file(cell));
  }
  def fkbc-attempt(context,reading,name,cell,before,rows,classification,unit,orig) {
   let edited = fkbc-with-prelude(orig,unit,fkbc-tongue(cell));
   (String) edited == orig ? fkbc-answer(context,"need-open","unit-already-on-preludes-line",cell,name,classification,unit,"none",fkbc-reading(reading,name,rows,before,fkbc-evidence(cell,name,classification,unit,"none",rows)))
   : fkbc-try(context,reading,name,cell,rows,classification,unit,orig,write_file(cell,edited));
  }
  def fkbc-try(context,reading,name,cell,rows,classification,unit,orig,wrote) {
   let after = pf-check(cell);
   let fresh = fkbc-signals(after);
   let exit = fkbc-exit(after);
   let keep = fkbc-compiled?(after) && ((!fkbc-missing?(fresh,name)) && (fkbc-within?(fkbc-errors(fresh),fkbc-errors(rows)) && (((Comparable) exit == 0) || (((Comparable) exit == 1) && (!nil?(fkbc-errors(fresh)))))));
   keep ? fkbc-answer(context,"delivered","binding-resolved",cell,name,classification,unit,"kept",fkbc-reading(reading,name,fresh,after,fkbc-evidence(cell,name,classification,unit,"kept",fresh)))
   : fkbc-restore(context,reading,name,cell,classification,unit,orig,fkbc-missing?(fresh,name) ? "binding-still-missing" : "new-error-appeared");
  }
  // The bytes go back exactly, and the restored cell is compiled again.
  def fkbc-restore(context,reading,name,cell,classification,unit,orig,reason) {
   let back = write_file(cell,orig);
   let exact = (String) read_file(cell) == orig;
   let again = pf-check(cell);
   let rows = fkbc-signals(again);
   fkbc-answer(context,exact ? "need-open" : "restore-unverified",reason,cell,name,classification,unit,exact ? "restored" : "restore-unverified",fkbc-reading(reading,name,rows,again,fkbc-evidence(cell,name,classification,unit,exact ? "restored" : "restore-unverified",rows)));
  }
  // the asking organ's callback: its fresh reading, bound to the first
  def fkbc-observe(context,reading,delivery) {
   let fresh = record_get(context,"binding_fresh");
   let cleared = record_set(context,"binding_fresh",json-node-null());
   oh-set(fresh,"care_of",json-node-string(oh-str(reading,"id")));
  }
  // an edit that stayed, as the job's outcome lines record it
  def fkbc-kept?(job) = fkbc-kept-in(split-on(fhn-read(fhn-at(job,"binding-care.jsonl")),"\n"));
  def fkbc-kept-in(lines) = nil?(lines) ? 0 : (str_len(head(lines)) > 0) && ((String) fhn-string(parse-json("binding-care",head(lines)),"edit") == "kept") ? 1 : fkbc-kept-in(tail(lines));
 }
 0;
}
