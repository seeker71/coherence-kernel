// Care for a binding the fkwu compiler could not resolve. The kernel names the need
// itself: a `form-organ health` row with resource `binding` and the name as detail
// (runtime/fkwu-uni.c, fk_diag_signal). This provider answers it from the tree.
// preflight classifies the name (observe/preflight.fk pf-classify) and finds the units
// that define it (preflight-source.bml). When no kernel resolves the name and exactly
// one unit defines it, that unit joins the cell's preludes line and the cell compiles
// fresh. The edit stays only when that binding is gone and no error appeared that was
// not already there; otherwise the cell's bytes go back exactly as they were. That is
// observe/tree-heal.fk's discipline: the reading decides, never the edit. A typo, a lane
// seam, a portable name or an arm that could not be observed leaves the need open, with
// the classification as its evidence. Either way the fresh compile's own signal is the
// re-observation, voiced as care_of the first reading.
// preludes: form-stdlib/organ-care.bml form-stdlib/bml/form-cli-heal-native-io.bml observe/preflight.fk
section [form.bml] {
 class FkwuBindingCare {
  def fkbc-provider() = oc-provider("fkwu-binding-prelude",list("binding"),"revise",fkbc-supply);

  // the cell a child compiles: ./fkwu <cell.fk|cell.bml> [arg]
  def fkbc-cell(argv) = if lt(len(argv),2) then "" else if not(pfs-ends?(head(argv),"fkwu")) then "" else if or(pfs-ends?(nth(argv,1),".fk"),pfs-ends?(nth(argv,1),".bml")) then nth(argv,1) else "";
  def fkbc-argv(job,stage) = oh-values(json-array-elements(fhn-json(fhn-at(job,str_concat(stage,".argv.json")))));

  // the compiler's own signal rows in one fresh compile's output
  def fkbc-mark() = "form-organ health ";
  def fkbc-signals(out) = fkbc-rows(split-on(out,"\n"));
  def fkbc-rows(lines) = if nil?(lines) then list() else if eq(str_find(head(lines),fkbc-mark(),0),0) then fkbc-row(parse-json("fkwu-signal",substring(head(lines),str_len(fkbc-mark()),str_len(head(lines)))),fkbc-rows(tail(lines))) else fkbc-rows(tail(lines));
  def fkbc-row(row,rest) = if and(oh-valid(row),and(str_eq(oh-str(row,"organ"),"fkwu-compiler"),str_eq(oh-str(row,"aspect"),"diagnostic"))) then cons(row,rest) else rest;
  def fkbc-binding?(row) = str_eq(oh-str(row,"observed"),"binding-missing");
  def fkbc-name(row) = json-string-value(oh-get(head(json-array-elements(oh-get(row,"needs"))),"detail"));
  def fkbc-missing?(rows,name) = if nil?(rows) then 0 else if and(fkbc-binding?(head(rows)),str_eq(fkbc-name(head(rows)),name)) then 1 else fkbc-missing?(tail(rows),name);
  // An error is known by what it asks for. Its coordinate moves when a unit joins the
  // assembled chain, so the line and column are not part of its identity.
  def fkbc-errors(rows) = if nil?(rows) then list() else if oh-pain(head(rows)) then cons(json-emit(oh-get(head(rows),"needs")),fkbc-errors(tail(rows))) else fkbc-errors(tail(rows));
  def fkbc-within?(after,before) = if nil?(after) then 1 else and(oh-has(before,head(after)),fkbc-within?(tail(after),before));
  def fkbc-exit(out) {
   let mark = str_concat(pf-command-failure-mark()," exit=");
   let at = str_find(out,mark,0);
   if lt(at,0) then 0 else str_to_int(fh-trim(substring(out,add(at,str_len(mark)),str_len(out))));
  }
  def fkbc-compiled?(out) = and(eq(pf-unsupported?(out),0),eq(pf-effect-refused?(out),0));

  // the preludes line, in either tongue: the offset of its line, or -1
  def fkbc-prelude-line?(text,i) = or(pfs-at?(text,i,"; preludes:"),pfs-at?(text,i,"// preludes:"));
  def fkbc-prelude-at(text,at) = if ge(at,str_len(text)) then -1 else if fkbc-prelude-line?(text,pfs-skip-blank(text,at)) then at else fkbc-prelude-at(text,add(pfs-eol(text,at),1));
  def fkbc-tongue(cell) = if pfs-ends?(cell,".bml") then "// preludes:" else "; preludes:";
  def fkbc-with-prelude(text,unit,tongue) {
   let at = fkbc-prelude-at(text,0);
   if lt(at,0) then str_concat(tongue,str_concat(" ",str_concat(unit,str_concat("\n",text)))) else fkbc-join-line(text,pfs-eol(text,at),unit,substring(text,at,pfs-eol(text,at)));
  }
  def fkbc-join-line(text,eol,unit,line) = if oh-has(split-on(line," "),unit) then text else str_concat(substring(text,0,eol),str_concat(" ",str_concat(unit,substring(text,eol,str_len(text)))));
  // the spelling every cell writes: form/form-stdlib/x resolves as form-stdlib/x
  def fkbc-token(home) = if pfs-at?(home,0,"form/") then substring(home,5,str_len(home)) else home;

  // the asking organ's reading after care, from the kernel's own signal
  def fkbc-reading(reading,name,rows,out,evidence) {
   let errors = fkbc-errors(rows);
   let exit = fkbc-exit(out);
   let missing = fkbc-missing?(rows,name);
   let clean = and(not(missing),and(nil?(errors),eq(exit,0)));
   let observed = if clean then "clean" else if missing then "binding-missing" else "compile-error";
   let needs = if clean then list() else if missing then list(oh-need("binding",json-node-string(name))) else list(oh-need("source-diagnostics",json-node-string(if nil?(errors) then str_concat("exit ",int_to_str(exit)) else str_concat(int_to_str(len(errors))," error signals remain"))));
   oh-reading(oh-str(reading,"organ"),oh-str(reading,"flow"),oh-str(reading,"aspect"),oh-get(reading,"expected"),json-node-string(observed),json-node-int(if clean then 1 else 0),needs,oh-values(json-array-elements(oh-get(reading,"offers"))),oh-set(evidence,"exit",json-node-int(exit)));
  }
  def fkbc-evidence(cell,name,classification,unit,edit,rows) = json-node-object(list(oh-s("re_observation","fresh-compile"),oh-s("cell",cell),oh-s("name",name),oh-s("classification",classification),oh-s("unit",unit),oh-s("edit",edit),oh-n("error_signals",len(fkbc-errors(rows)))));

  // Every answer keeps the reading it re-observed for the asking organ's callback and
  // leaves one outcome line in the job, where the door reads whether an edit stayed.
  def fkbc-answer(context,state,reason,cell,name,classification,unit,edit,fresh) {
   let job = record_get(context,"job");
   let line = fhn-json-line(fhn-at(job,"binding-care.jsonl"),list(oh-s("name",name),oh-s("cell",cell),oh-s("unit",unit),oh-s("edit",edit),oh-s("state",state),oh-s("classification",classification)));
   let held = record_set(context,"binding_fresh",fresh);
   json-node-object(list(oh-s("resource","binding"),oh-s("state",state),oh-s("reason",reason),oh-s("name",name),oh-s("cell",cell),oh-s("classification",classification),oh-s("unit",unit),oh-s("edit",edit)));
  }
  def fkbc-supply(context,reading,need) {
   let name = json-string-value(oh-get(need,"detail"));
   let cell = fkbc-cell(fkbc-argv(record_get(context,"job"),record_get(context,"stage")));
   if str_eq(cell,"") then fkbc-answer(context,"unavailable","no-fkwu-cell-in-argv",cell,name,"","","none",oh-set(reading,"stage",json-node-string("observe"))) else fkbc-supply-cell(context,reading,name,cell);
  }
  def fkbc-supply-cell(context,reading,name,cell) {
   let before = pf-fresh(cell);
   let rows = fkbc-signals(before);
   if not(fkbc-compiled?(before)) then fkbc-answer(context,"unavailable","no-fresh-compile",cell,name,"","","none",fkbc-reading(reading,name,rows,before,fkbc-evidence(cell,name,"","","none",rows)))
   else if not(fkbc-missing?(rows,name)) then fkbc-answer(context,"settled-by-observation","binding-already-present",cell,name,"","","none",fkbc-reading(reading,name,rows,before,fkbc-evidence(cell,name,"","","none",rows)))
   else fkbc-classified(context,reading,name,cell,before,rows,pf-classify(name));
  }
  def fkbc-classified(context,reading,name,cell,before,rows,classification) {
   let homes = if pfs-at?(classification,0,"UNPRELUDED") then pfs-defn-homes(name) else list();
   if not(eq(len(homes),1)) then fkbc-answer(context,"need-open",if nil?(homes) then "classification" else str_concat(int_to_str(len(homes))," defining units"),cell,name,classification,"","none",fkbc-reading(reading,name,rows,before,fkbc-evidence(cell,name,classification,"","none",rows)))
   else fkbc-attempt(context,reading,name,cell,rows,classification,fkbc-token(head(homes)),read_file(cell));
  }
  def fkbc-attempt(context,reading,name,cell,rows,classification,unit,orig) {
   let edited = fkbc-with-prelude(orig,unit,fkbc-tongue(cell));
   if str_eq(edited,orig) then fkbc-answer(context,"need-open","unit-already-on-preludes-line",cell,name,classification,unit,"none",fkbc-reading(reading,name,rows,"",fkbc-evidence(cell,name,classification,unit,"none",rows)))
   else fkbc-try(context,reading,name,cell,rows,classification,unit,orig,write_file(cell,edited));
  }
  def fkbc-try(context,reading,name,cell,rows,classification,unit,orig,wrote) {
   let after = pf-fresh(cell);
   let fresh = fkbc-signals(after);
   let exit = fkbc-exit(after);
   let keep = and(fkbc-compiled?(after),and(not(fkbc-missing?(fresh,name)),and(fkbc-within?(fkbc-errors(fresh),fkbc-errors(rows)),or(eq(exit,0),and(eq(exit,1),not(nil?(fkbc-errors(fresh))))))));
   if keep then fkbc-answer(context,"delivered","binding-resolved",cell,name,classification,unit,"kept",fkbc-reading(reading,name,fresh,after,fkbc-evidence(cell,name,classification,unit,"kept",fresh)))
   else fkbc-restore(context,reading,name,cell,classification,unit,orig,if fkbc-missing?(fresh,name) then "binding-still-missing" else "new-error-appeared");
  }
  // The bytes go back exactly, and the restored cell is observed again.
  def fkbc-restore(context,reading,name,cell,classification,unit,orig,reason) {
   let back = write_file(cell,orig);
   let exact = str_eq(read_file(cell),orig);
   let again = pf-fresh(cell);
   let rows = fkbc-signals(again);
   fkbc-answer(context,if exact then "need-open" else "restore-unverified",reason,cell,name,classification,unit,if exact then "restored" else "restore-unverified",fkbc-reading(reading,name,rows,again,fkbc-evidence(cell,name,classification,unit,if exact then "restored" else "restore-unverified",rows)));
  }
  // the asking organ's callback: its fresh reading, bound to the first
  def fkbc-observe(context,reading,delivery) {
   let fresh = record_get(context,"binding_fresh");
   let cleared = record_set(context,"binding_fresh",json-node-null());
   oh-set(fresh,"care_of",json-node-string(oh-str(reading,"id")));
  }
  // an edit that stayed, as the job's outcome lines record it
  def fkbc-kept?(job) = fkbc-kept-in(split-on(fhn-read(fhn-at(job,"binding-care.jsonl")),"\n"));
  def fkbc-kept-in(lines) = if nil?(lines) then 0 else if and(gt(str_len(head(lines)),0),str_eq(fhn-string(parse-json("binding-care",head(lines)),"edit"),"kept")) then 1 else fkbc-kept-in(tail(lines));
 }
 0;
}
