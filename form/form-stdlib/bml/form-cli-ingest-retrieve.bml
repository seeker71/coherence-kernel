//////////////////////////////////////////////////////////////////////
//
// form-cli-ingest-retrieve.bml — high-grammar authority.
//
// Sealed ingest is dark until the cells speak their laws in the
// span the two-phase door can retrieve. This organ does not run
// Qwen. It reads the three ingest cells and reports whether the
// phrases those cells already own are present: one cell, depth
// at least 3, waits at the door. No sealed question text lives
// here.
//
// Executable: form-stdlib/form-cli-ingest-retrieve.bml
// Proven by: form-stdlib/tests/form-cli-ingest-retrieve-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.ingestretrieve;

import Form.kernel.*;
import Form.cli.flow.*;

enum IngestPhrase [public] {
   ONE_CELL,
   DEPTH_AT_LEAST_3,
   WAITS_AT_THE_DOOR
}

interface IIngestRetrieve [public, witness, reusable] {
   section [public] {
      const int PhraseHit = 1;
      const int PhraseMiss = 0;
      const String CollapsePath = "ingest/equivalence-collapse.fk";
      const String DepthPath = "ingest/knowledge-ingest.fk";
      const String NboPath = "ingest/name-build-observe.fk";
      const String OneCell = "one cell";
      const String DepthAtLeast3 = "depth at least 3";
      const String WaitsAtTheDoor = "waits at the door";

      int Has( String strHay, String strNeedle ) [abstract];
      int Retrieve( String strPath, String strPhrase ) [abstract];
      int Readable( String strPath ) [abstract];
   }
}

template RetrieveHit<TPhrase> [public, reusable] {
   section [public] {
      String Path() [get];
      TPhrase Phrase() [get];
      int Hit() [get];
   }
}

class FormIngestRetrieve [public, reusable, teach] : IIngestRetrieve {
   section [public] {
      const String TrustRule = "retrieve from the ingest cells; do not copy sealed questions";
      const String ExecutablePath = "form/form-stdlib/form-cli-ingest-retrieve.bml";

      int Has( String strHay, String strNeedle ) [abstract] {}
      int Retrieve( String strPath, String strPhrase ) [abstract] {}
      int Readable( String strPath ) [abstract] {}
   }
}

class FormIngestRetrieveSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-ingest-retrieve-self";
      const String Pattern = "cell-phrase retrieve no-qwen no-sealed-prompt";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
