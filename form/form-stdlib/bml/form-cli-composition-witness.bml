// Native composition observations offered as response-grounding evidence.
// No model, file write, collection or persistent store is involved.
// preludes: form-stdlib/json.fk form-stdlib/tree-diff.fk
section [form.bml] {
 class FormCliCompositionWitness {
  def fccw-pair(key,value) = json-node-pair(key,value);
  def fccw-flag(key,value) = fccw-pair(key,json-node-bool(value));
  def fccw-facts(same,changed,unchanged,forward,restored) = json-node-object(list(
   fccw-flag("same_composition_same_node",same),
   fccw-flag("changed_composition_distinct_node",changed),
   fccw-flag("original_children_unchanged",unchanged),
   fccw-flag("forward_patch_matches_revision",forward),
   fccw-flag("retained_reverse_patch_restores_original",restored)));
  def fccw-expected() = fccw-facts(1,1,1,1,1);
  def fccw-leaves(nodes) = if nil?(nodes) then list() else cons(json-node-int(node_value(head(nodes))),fccw-leaves(tail(nodes)));
  def fccw-values(node) = json-node-array(fccw-leaves(node_children(node)));
  def fccw-recipe(left,right) = intern_node(bp("add"),list(intern_trivial_int(left),intern_trivial_int(right)));
  def fccw-observe() {
   let original = fccw-recipe(2,3);
   let before = fccw-values(original);
   let repeated = fccw-recipe(2,3);
   let revised = fccw-recipe(2,4);
   let forward = tree-diff(original,revised);
   let reverse = tree-diff(revised,original);
   let reconstructed = tree-patch(revised,reverse);
   let facts = fccw-facts(node_eq(original,repeated),not(node_eq(original,revised)),node_eq(before,fccw-values(original)),node_eq(tree-patch(original,forward),revised),node_eq(reconstructed,original));
   json-node-object(list(
    fccw-pair("schema",json-node-string("form-composition-witness-v1")),
    fccw-pair("source",json-node-string("form/form-stdlib/bml/form-cli-composition-witness.bml")),
    fccw-pair("scope",json-node-string("Observed recipe construction, node equality, child reads and tree diff/patch in one live fkwu process. The add recipes are inspected as data; their execution is not measured here.")),
    fccw-pair("original_before",before),
    fccw-pair("revised",fccw-values(revised)),
    fccw-pair("original_after",fccw-values(original)),
    fccw-pair("reconstructed",fccw-values(reconstructed)),
    fccw-pair("observed",facts),
    fccw-pair("restoration_basis",json-node-string("The original cell remains referenced while the reverse diff is constructed and applied. Restoration here uses that retained information.")),
    fccw-pair("unobserved",json-node-object(list(
     fccw-pair("collection_of_unreferenced_cells",json-node-null()),
     fccw-pair("durability_after_process_exit",json-node-null()),
     fccw-pair("automatic_persistence_of_response_text",json-node-null()),
     fccw-pair("identity_of_an_absent_resident_reply",json-node-null()))))));
  }
  def fccw-passed(report) = node_eq(json-object-get(report,"observed"),fccw-expected());
 }
 0;
}
