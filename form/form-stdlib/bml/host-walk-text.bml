// host-walk-text.bml — the plain readers every part of the walk shares (form-stdlib/bml/host-walk.bml names the parts).
//
// What it holds: a trimmed line (hw-line), the exit as text (hw-rc-text), minutes as text (hw-minutes), the
// prefix, suffix and substring tests the walk reads lines with (hw-starts?, hw-ends?, hw-has?), a spoken line that is
// no line when it is empty (hw-say), a "key=<digits>" field read from a line (hw-field, over parse.bml's parse-int and
// digits-end: the one scalar door), and the JSON row readers (hw-row-node, hw-row-int, hw-row-str): a key that is not
// there reads nothing() (an int) or "" (a string), never -1.
// What it needs: form-stdlib/bml/form-cli-heal-native-report.bml (the JSON and file readers) and form-stdlib/bml/parse.bml
// (parse-int, digits-end). Every other part of the walk needs this one.
import form-stdlib/bml/form-cli-heal-native-report.bml;
import form-stdlib/bml/parse.bml;
section [form.bml] {
 class HostWalkText {
  def hw-line(text) = trim(text ?? "");
  def hw-rc-text(rc) = nothing?(rc) ? "nothing" : rc.str();
  def hw-minutes(ms) = (ms / 60000).str() ++ " min";
  def hw-ends?(s, tail) = len(s) < len(tail) ? false : (String) substring(s, len(s) - len(tail), len(s)) == tail;
  def hw-starts?(s, p) = len(s) < len(p) ? false : (String) substring(s, 0, len(p)) == p;
  def hw-say(line) = (String) line == "" ? 0 : print_str(line);
  def hw-row-node(row, key) = json-object-has?(row, key) ? json-object-get(row, key) : json-node-null();
  def hw-row-int(row, key) = node_eq(hw-row-node(row, key), json-node-null()) ? nothing() : json-int-value(hw-row-node(row, key));
  def hw-row-str(row, key) = node_eq(hw-row-node(row, key), json-node-null()) ? "" : json-string-value(hw-row-node(row, key));
  def hw-field(s, key) {
   let at = str_find(s, key, 0);
   let from = at + len(key);
   at < 0 ? nothing() : parse-int(substring(s, from, digits-end(s, from)));
  }
  def hw-has?(out, word) = (!nothing?(out)) && (str_find(out, word, 0) >= 0);
 }
}
