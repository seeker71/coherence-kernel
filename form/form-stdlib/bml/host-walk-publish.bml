// host-walk-publish.bml — owned candidate windows and recoverable installation.
//
// A turn's candidate stands inside hw-with-published, which restores still-owned bytes on normal and stopped runs.
// Recovery preserves intervening writes and their marker; each walk heals before it syncs (host-walk-heal.bml).
// What it holds: the publish window (hw-with-published, hw-band-after), the installation (hw-install) and the checkpoint of a tree
// (hw-tree, hw-over).
// What it needs: host-walk-heal.bml (the put, the heal, hw-own-markers) and host-walk-text.bml.
import form-stdlib/bml/host-walk-text.bml;
import form-stdlib/bml/host-walk-heal.bml;
section [form.bml] {
 class HostWalkPublish {
  // A candidate in the tracked tree, with ownership-aware restoration.
  // hw-with-published(dir, paths, before, texts, run) writes a marker (<dir>/publish-<pid>.marker: the pid, its
  // stamp, the paths, their checkpoint texts and the bytes this publish writes) and reads it back, publishes the
  // texts over the paths, answers run() while they stand, and restores still-owned bytes in a deferred step, so a
  // form_error inside run restores too. Intervening writes retain the recovery marker. A window may open inside another of this
  // process (a band under a candidate runs the door, and the door publishes a scratch gap): each holds its own marker
  // (publish-<pid>.<n>.marker past the first). Nothing is published over a tree that moved from its checkpoint, over a path a marker
  // of this pid holds (an open window, or an earlier restore that did not hold; a marker that names no paths holds them all), or before
  // the marker reads back. A kill skips the defer, and so does a cell's deadline (the cell ends where it stands, its caller runs on);
  // the marker outlives either, and host-walk-heal.bml returns each path still holding that publish's own bytes to its checkpoint.
  // Bytes another writer left stay, and so does their marker.
  // Answers [run's answer, or nothing when it stopped; restored; "" or why nothing was published].
  def hw-marker(dir) = dir ++ "/publish-" ++ host_pid().str() ++ ".marker";
  def hw-window-marker(dir, n) = (Comparable) n == 0 ? hw-marker(dir) : dir ++ "/publish-" ++ host_pid().str() ++ "." ++ n.str() ++ ".marker";
  def hw-free-marker(dir, n) = (Comparable) host_path_exists(hw-window-marker(dir, n)) == 1 ? hw-free-marker(dir, n + 1) : hw-window-marker(dir, n);
  def hw-text-node(t) = nothing?(t) ? json-node-null() : json-node-string(t);
  def hw-strings(xs) = xs |> map(x => hw-text-node(x));
  def hw-marker-text(pid, at, paths, before, texts) = json-emit(json-node-object([fhn-n("pid", pid), fhn-n("at", at), json-node-pair("paths", json-node-array(hw-strings(paths))), json-node-pair("before", json-node-array(hw-strings(before))), json-node-pair("published", json-node-array(hw-strings(texts)))])) ++ "\n";
  def hw-marked?(marker, text) {
   let wrote = write_file_text(marker, text);
   (String) (read_file(marker) ?? "") == text;
  }
  def hw-row-paths(row) = json-object-has?(row, "paths") ? hw-heal-texts(row, "paths") : nothing();
  def hw-marker-paths(path) = try hw-row-paths(parse-json("publish-marker", read_file(path) ?? "")) else nothing();
  def hw-holds-any?(named, paths) = nothing?(named) || any?(p => any?(q => hw-same?(q, p), named), paths);
  def hw-held-by(dir, paths) = foldl((found, name) => (String) found != "" ? found : hw-holds-any?(hw-marker-paths(dir ++ "/" ++ name), paths) ? dir ++ "/" ++ name : "", "", hw-own-markers(dir));
  def hw-with-published(dir, paths, before, texts, run) {
   let made = host_dir_mkdir(dir);
   let marker = hw-free-marker(dir, 0);
   let why=hw-publication-why(dir,marker,paths,before,texts);
   why != "" ? [nothing(),hw-all-same?(paths,before),why] : hw-published-window(marker,paths,before,texts,run);
  }
  def hw-publication-why(dir,marker,paths,before,texts) {
   let held = hw-held-by(dir,paths);
   held != "" ? "marker-held: "+held+" holds a path of this publish under this pid"
   : !hw-all-same?(paths,before) ? "source-conflict: the tree moved from its checkpoint"
   : !hw-marked?(marker,hw-marker-text(host_pid(),now_unix_ms(),paths,before,texts)) ? "marker-unwritten: "+marker : "";
  }
  // Installation shares admission and killed-write recovery with observation
  // windows. Recovery restores only still-owned bytes and retains conflicts.
  def hw-install(dir,paths,before,texts) {
   let made = host_dir_mkdir(dir);
   let marker = hw-free-marker(dir, 0);
   let why=hw-publication-why(dir,marker,paths,before,texts);
   why != "" ? [false,hw-all-same?(paths,before),why] : {
    let put=try hw-put-all(paths,texts) else "put-refused: the put stopped";
    let wrote=(String) put == "" && hw-all-same?(paths,texts);
    let cleared=wrote ? host_path_remove(marker) : -1;
    let installed=wrote && cleared==0 && host_path_exists(marker)!=1;
    let restored=installed ? false : {let conflicts=hw-heal-each(paths,before,texts);nil?(conflicts);};
    if restored then host_path_remove(marker) else 0;
    let named=(String) put == "" ? "" : " (" ++ put ++ ")";
    [installed,restored,installed ? "" : restored ? "installation-failed: original source restored" ++ named : "installation-incomplete: retained marker owns restoration" ++ named];
   };
  }
  // a put the door refuses is the window's own "why nothing was published": the run never starts, and the deferred heal
  // returns whatever the list had already put
  def hw-held(said, paths, before, texts, run) {
   defer hw-heal-each(paths, before, texts);
   let put = hw-put-all(paths, texts);
   let named = record_set(said, "why", put);
   (String) put != "" ? form_error(put) : hw-all-same?(paths,texts) ? run() : form_error("candidate-installation-incomplete");
  }
  def hw-published-window(marker, paths, before, texts, run) {
   let said = record_new(0, "why", "");
   let answer = try hw-held(said, paths, before, texts, run) else nothing();
   let restored = hw-all-same?(paths, before);
   let cleared = restored ? host_path_remove(marker) : 0;
   [answer, restored, record_get(said, "why")];
  }
  // A publish's checkpoint is the tree as it stands, absence included: each path's bytes, or nothing where no file
  // stands, so a writable path the lane creates publishes and is absent again after the window (hw-put removes it).
  def hw-tree(paths) = paths |> map(p => read_file(p));
  // the texts a publish writes: the candidate's where it names one, the checkpoint's elsewhere; an absent path the
  // candidate does not name stays absent
  def hw-over(cand, before) = nil?(cand) ? [] : cons(cand[0] ?? before[0], hw-over(cand[1:], before[1:]));
  // what a publish window says of the band, [ran, reading]: the band ran under the candidate only when something
  // was published and the door did not refuse it, and then it reads run's first answer (nothing when the run
  // stopped). A refused or empty publish ran no band: the reading stays where it was before.
  def hw-band-after(window, published, before) = (published > 0) && ((String) window[2] == "") ? [true, nothing?(window[0]) ? nothing() : window[0][0]] : [false, before];
 }
}
