// rounding-ops.bml — floor, ceil, trunc and round as Form definitions; each answers an int.
// These bodies are the only definition on every kernel. fkwu walks them cold and its loop lane
// compiles them to arm64 once they run hot; no kernel carries a copy of its own.
section [form.bml] {
    class RoundingOps {
        def trunc(x) = float_to_int(x);
        def floor(x) {
            let d = add(x, 0.0);
            let q = float_to_int(d);
            if lt(d, add(q, 0.0)) then sub(q, 1) else q;
        }
        def ceil(x) {
            let d = add(x, 0.0);
            let q = float_to_int(d);
            if lt(add(q, 0.0), d) then add(q, 1) else q;
        }
        def round(x) {
            let d = add(x, 0.0);
            let a = if lt(d, 0.0) then sub(0.0, d) else d;
            let q = float_to_int(add(a, 0.5));
            if lt(d, 0.0) then sub(0, q) else q;
        }
        def math_floor(x) = floor(x);
        def math_ceil(x) = ceil(x);
    }
}
