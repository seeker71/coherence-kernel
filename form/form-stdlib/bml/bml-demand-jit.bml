//////////////////////////////////////////////////////////////////////
//
// bml-demand-jit.bml -- first-answer-safe, on-demand native pages.
//
// A BML caller offers an ordinary lowerable scalar recipe graph.  The
// first request is answered by the Form evaluator and leaves exactly one
// specialization pending.  A later bounded step validates a freshness-bound
// disk image or compiles one, checks it at the pending request argument,
// publishes it through a short leased rename, and installs it through
// jit_leaf_inram.  Later calls in the
// same process reach the retained NodeID page.
//
// This does not invent a NodeID namespace.  It reuses jonb-identity's exact
// length-delimited structure. Cache filenames are caller-owned lenses; they
// are never identity.
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/line-grammar.fk form-stdlib/form-fs.fk form-stdlib/jit-heat-gate.fk form-stdlib/form-node-category.bml form-stdlib/sha256.fk form-stdlib/organ-health.bml control/choice-lane-core.fk

section [form.bml] {
    class BmlDemandJit [public, observable, jit] {
        field BDJSchema = "bml-demand-jit-v3";
        field BDJCacheSchema = "bml-demand-jit-cache-v4";
        field BDJAttentionMs = 5000;
        field BDJMaxRows = 256;
        field BDJMaxCacheWireBytes = 1048576;
        field BDJPublishLeaseSeconds = 5;
        field BDJPublishLeaseSchema = "bml-demand-jit-publish-lease-v1";
        field BDJEmitterABI = "form-arm64-leaf-v1";
        field BDJRuntimePath = "./fkwu";
        field BDJEmitterPath = "form/form-stdlib/form-lower.fk";
        field BDJAuthorityPath = "form/form-stdlib/bml/bml-demand-jit.bml";
        field BDJNodeIdPolicy = "native-nodeid-is-one-u64;glass-fault-locator-is-sha256-prefix64-with-full-digest-owner-check";
        field BDJWiderFrontier = "strings-lists-cross-calls-and-whole-program-image-install";
        field BDJStageSchema = "bml-demand-jit-stage-v1";
        field BDJFieldSchema = "bml-demand-jit-field-v1";
        field BDJFaultSchema = "bml-demand-jit-fault-v2";
        field BDJFaultControlSchema = "bml-demand-jit-fault-control-v1";
        field BDJFaultControlResultSchema = "bml-demand-jit-fault-control-result-v1";
        field BDJHealedSchema = "bml-demand-jit-healed-v2";
        field BDJFaultPublisher = "jit.bml-demand";
        field BDJFaultPriority = 1000;
        field BDJFullProgramCallDoor = "runtime.full-program-image.call";
        field BDJFullProgramCallState = "carrier-door-absent";
        field BDJRuntimeIdentityKind = "fkwu-content-validated-source-unit-v3";
        field BDJExplicitRuntimeIdentityKind = "sha256-file-content-v1";
        field BDJRuntimeIdentityDoor = "program-image-sym.source-hash";
        field BDJSourceUnitSymPath = "form/form-stdlib/bml-demand-jit.sym";

        thought bdj-pattern = list("first-answer", "pending", "inspect", "compile-or-load", "challenge", "atomic-publish", "install", "reuse", "stale");

        // Execution, optional disk care and its completion have separate seats.
        // A cache observation never revokes a challenged native page.
        // pending = source, cache, program, root, argument, exact structural wire.
        def bdj-state-with-fault-and-control(epoch, registry, pending, status, fault, control) = list(BDJSchema(), epoch, registry, pending, status, fault, control, list(), nothing());
        def bdj-state-with-fault(epoch, registry, pending, status, fault) = bdj-state-with-fault-and-control(epoch, registry, pending, status, fault, nothing());
        def bdj-state(epoch, registry, pending, status) = bdj-state-with-fault(epoch, registry, pending, status, nothing());
        def bdj-empty(epoch) = bdj-state(epoch, jonb-registry(epoch), nothing(), "ready");
        def bdj-state-epoch(state) = state[1];
        def bdj-state-registry(state) = state[2];
        def bdj-state-pending(state) = state[3];
        def bdj-state-status(state) = state[4];
        def bdj-state-fault(state) = state[5];
        def bdj-state-last-control(state) = state[6];
        def bdj-state-care(state) = state[7];
        def bdj-state-cache-healed(state) = state[8];
        def bdj-state-with-care(state, care, healed) = list(BDJSchema(), bdj-state-epoch(state), bdj-state-registry(state), bdj-state-pending(state), bdj-state-status(state), bdj-state-fault(state), bdj-state-last-control(state), care, healed);
        def bdj-next(state, registry, pending, status, fault, control) = bdj-state-with-care(bdj-state-with-fault-and-control(bdj-state-epoch(state), registry, pending, status, fault, control), bdj-state-care(state), nothing());
        def bdj-state-faulted?(state) = nothing?(bdj-state-fault(state)) ? 0 : 1;
        def bdj-pending(source, cache, program, root, argument, epoch) = list(source, cache, program, root, argument, bdj-program-wire(program, root, epoch));
        def bdj-pending-source(pending) = pending[0];
        def bdj-pending-cache(pending) = pending[1];
        def bdj-pending-program(pending) = pending[2];
        def bdj-pending-root(pending) = pending[3];
        def bdj-pending-argument(pending) = pending[4];
        def bdj-pending-program-wire(pending) = pending[5];

        // jonb-flat is injective for nested integer rows because every row is
        // length-prefixed.  Its canonical decimal wire is stored and compared
        // byte-for-byte at the disk membrane; a lossy fold is never identity.
        def bdj-program-wire(program, root, epoch) = bdj-image-text(jonb-flat(program, root, epoch));

        def bdj-digits?(text, i) = i >= str_len(text) ? 1 : (str_byte_at(text, i) >= 48) && (str_byte_at(text, i) <= 57) ? bdj-digits?(text, i + 1) : 0;
        def bdj-uint?(text) = (Comparable) str_len(text) == 0 ? 0 : !((Comparable) bdj-digits?(text, 0) == 1) ? 0 : ((String) int_to_str(str_to_int(text)) == text);
        def bdj-byte-text?(text) = !((Comparable) bdj-uint?(text) == 1) ? 0 : str_to_int(text) > 255 ? 0 : 1;
        def bdj-byte-parts?(parts) = (Comparable) len(parts) == 0 ? 0 : !((Comparable) bdj-byte-text?(head(parts)) == 1) ? 0 : (Comparable) len(parts) == 1 ? 1 : bdj-byte-parts?(tail(parts));
        def bdj-parts-ints(parts) = (Comparable) len(parts) == 0 ? list() : cons(str_to_int(head(parts)), bdj-parts-ints(tail(parts)));
        def bdj-image-text(image) = (Comparable) len(image) == 0 ? "" : (Comparable) len(image) == 1 ? int_to_str(head(image)) : int_to_str(head(image)) ++ "," ++ bdj-image-text(tail(image));
        def bdj-cat(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ bdj-cat(tail(parts));

        // The current `.sym` source-hash is emitted and checked by fkwu's
        // program-image loader from every dependency's content digest. Reading
        // its bounded header reuses that already-paid content observation; no
        // demand hashes the executable or materializes an input-sized byte list.
        // ABI changes remain explicit in BDJEmitterABI, and every loaded page is
        // still point-challenged before publication or retained use.
        def bdj-hex-digit?(byte) = (byte >= 48) && (byte <= 57) ? 1 : (byte >= 97) && (byte <= 102) ? 1 : 0;
        def bdj-hex-tail?(text, i) = i >= str_len(text) ? 1 : (Comparable) bdj-hex-digit?(str_byte_at(text, i)) == 1 ? bdj-hex-tail?(text, i + 1) : 0;
        def bdj-content-identity?(identity) = !((Comparable) str_len(identity) == 71) ? 0 : !((String) substring(identity, 0, 7) == "sha256:") ? 0 : bdj-hex-tail?(identity, 7);
        def bdj-source-unit-hash-lines(lines) = (Comparable) len(lines) == 0 ? "" : (Comparable) str_find(head(lines), "source-hash ", 0) == 0 ? substring(head(lines), 12, str_len(head(lines))) : bdj-source-unit-hash-lines(tail(lines));
        def bdj-source-unit-hash() {
            let sourceHash = bdj-source-unit-hash-lines(split-on(fs-read-slice(BDJSourceUnitSymPath(), 0, 512), "\n"));
            (Comparable) str_find(sourceHash, "fk-unit-v3|", 0) == 0 ? sourceHash : "";
        }
        def bdj-runtime-fingerprint-from-identities(runtimeIdentity, emitterIdentity, authorityIdentity) {
            (!((Comparable) bdj-content-identity?(runtimeIdentity) == 1)) || ((!((Comparable) bdj-content-identity?(emitterIdentity) == 1)) || (!((Comparable) bdj-content-identity?(authorityIdentity) == 1))) ? ""
            : bdj-cat(list(BDJEmitterABI(), "|", BDJExplicitRuntimeIdentityKind(), "|runtime=", runtimeIdentity, "|emitter=", emitterIdentity, "|authority=", authorityIdentity));
        }
        def bdj-runtime-fingerprint() {
            let sourceHash = bdj-source-unit-hash();
            (String) sourceHash == "" ? "" : bdj-cat(list(BDJEmitterABI(), "|", BDJRuntimeIdentityKind(), "|", sourceHash));
        }
        def bdj-runtime-identity-ready?(identity) = (String) identity == "" ? 0 : (Comparable) str_find(identity, bdj-cat(list(BDJEmitterABI(), "|", BDJRuntimeIdentityKind(), "|")), 0) == 0 ? 1 : (Comparable) str_find(identity, bdj-cat(list(BDJEmitterABI(), "|", BDJExplicitRuntimeIdentityKind(), "|")), 0) == 0 ? 1 : 0;

        // Presence travels with each path observation.  A cache that does not
        // exist has no age; it is never rendered as a zero-millisecond cache.
        def bdj-field-present(value) = list(BDJFieldSchema(), 1, value, "measured");
        def bdj-field-absent(reason) = list(BDJFieldSchema(), 0, 0, reason);
        def bdj-field-present?(field) = field[1];
        def bdj-field-value(field) = field[2];
        def bdj-field-reason(field) = field[3];
        def bdj-path-mtime(path) = file_mtime(path) < 0 ? bdj-field-absent("path-absent") : bdj-field-present(file_mtime(path));
        def bdj-path-age-ms(path, observedMs) {
            let modified = file_mtime(path);
            let delta = observedMs - (modified * 1000);
            modified < 0 ? bdj-field-absent("path-absent")
            : bdj-field-present(delta < 0 ? 0 : delta);
        }

        def bdj-cache-disposition(cacheState) = (String) cacheState == "current" ? "hit-current" : (String) cacheState == "missing" ? "miss-absent" : (String) cacheState == "source-missing" ? "source-absent" : (String) cacheState == "runtime-identity-unavailable" ? "identity-unavailable" : str_find(cacheState, "stale-", 0) >= 0 ? "miss-stale" : str_find(cacheState, "cache-", 0) >= 0 ? "miss-invalid" : (String) cacheState == "not-requested" ? "not-requested" : "miss-other";

        // A stage record keeps wall times and artifact freshness separate.
        // Zero is meaningful only inside a named measured duration field.
        def bdj-stage(started, finished, cacheState, cacheAge, sourceAge, cacheMtime, sourceMtime, inspectMs, materializeMs, installChallengeMs, publishMs, materializeAction) = list(BDJStageSchema(), started, finished, bdj-cache-disposition(cacheState), cacheAge, sourceAge, cacheMtime, sourceMtime, inspectMs, materializeMs, installChallengeMs, publishMs, finished - started, materializeAction, BDJFullProgramCallState(), BDJFullProgramCallDoor());
        def bdj-stage-empty(started, finished, cacheState) = bdj-stage(started, finished, cacheState, bdj-field-absent("not-inspected"), bdj-field-absent("not-inspected"), bdj-field-absent("not-inspected"), bdj-field-absent("not-inspected"), 0, 0, 0, 0, "none");
        def bdj-stage-started(stage) = stage[1];
        def bdj-stage-finished(stage) = stage[2];
        def bdj-stage-cache-disposition(stage) = stage[3];
        def bdj-stage-cache-age(stage) = stage[4];
        def bdj-stage-source-age(stage) = stage[5];
        def bdj-stage-cache-mtime(stage) = stage[6];
        def bdj-stage-source-mtime(stage) = stage[7];
        def bdj-stage-inspect-ms(stage) = stage[8];
        def bdj-stage-materialize-ms(stage) = stage[9];
        def bdj-stage-install-challenge-ms(stage) = stage[10];
        def bdj-stage-publish-ms(stage) = stage[11];
        def bdj-stage-total-ms(stage) = stage[12];
        def bdj-stage-accounted-ms(stage) = bdj-stage-inspect-ms(stage) + (bdj-stage-materialize-ms(stage) + (bdj-stage-install-challenge-ms(stage) + bdj-stage-publish-ms(stage)));
        def bdj-stage-unattributed-ms(stage) = bdj-stage-accounted-ms(stage) > bdj-stage-total-ms(stage) ? 0 : (bdj-stage-total-ms(stage) - bdj-stage-accounted-ms(stage));
        def bdj-stage-materialize-action(stage) = stage[13];
        def bdj-stage-full-call-state(stage) = stage[14];
        def bdj-stage-full-call-door(stage) = stage[15];

        // Refusal is a latched attention state, never a routine Form fallback.
        // The original stage and exact cause survive until a matching control
        // records either `healed` or an explicit evidence-bearing `held`.
        // A diagnostic-control sample ID is a bounded locator, not canonical
        // NodeID identity. Runtime intern_node coordinates are allocation-order
        // local, while the NUMS-shaped canonical coordinate is 80 bits. Hash an
        // injective, length-delimited fault structure instead and carry its
        // complete 256-bit digest inside the fault/heal records. Glass receives
        // the first 64 digest bits as two exact u32 limbs; the owner verifies the
        // complete structure before it is allowed to publish the matching heal.
        // Fold the exact length-delimited wire directly into SHA state. The
        // pending program wire already exists for disk identity; a JIT fault
        // must not allocate and copy a second input-sized concatenation while
        // the highest-priority recovery path is active.
        def bdj-fault-hash-text(state, text) = sha256-stream-fold-string-from(state, text);
        def bdj-fault-hash-field(state, text) {
            let withLength = bdj-fault-hash-text(state, int_to_str(str_len(text)));
            let withColon = bdj-fault-hash-text(withLength, ":");
            bdj-fault-hash-text(withColon, text);
        }
        def bdj-fault-hash-separated-field(state, text) = bdj-fault-hash-field(bdj-fault-hash-text(state, "|"), text);
        def bdj-fault-identity-state(pending, epoch, cause, observedEpoch) {
            let named = bdj-fault-hash-text(sha256-stream-initial(), "bml-demand-jit-fault-identity-v1|");
            let source = bdj-fault-hash-field(named, bdj-pending-source(pending));
            let cache = bdj-fault-hash-separated-field(source, bdj-pending-cache(pending));
            let program = bdj-fault-hash-separated-field(cache, bdj-pending-program-wire(pending));
            let root = bdj-fault-hash-separated-field(program, int_to_str(bdj-pending-root(pending)));
            let argument = bdj-fault-hash-separated-field(root, int_to_str(bdj-pending-argument(pending)));
            let meaning = bdj-fault-hash-separated-field(argument, int_to_str(epoch));
            let failure = bdj-fault-hash-separated-field(meaning, cause);
            bdj-fault-hash-separated-field(failure, int_to_str(observedEpoch));
        }
        def bdj-fault-digest-for(pending, epoch, cause, observedEpoch) = sha256-stream-finalize(bdj-fault-identity-state(pending, epoch, cause, observedEpoch));
        def bdj-u32-be(bytes, at) = (bytes[at] * 16777216) + ((bytes[at + 1] * 65536) + ((bytes[at + 2] * 256) + bytes[at + 3]));
        def bdj-fault-locator-pack(digest) = fnc-packed(FNCPackedStatus(), 64, bdj-u32-be(digest, 0), bdj-u32-be(digest, 4), "sha256-prefix64");
        def bdj-fault-id-from-digest(digest) = bdj-cat(list("jit.f.", fnc-packed-key(bdj-fault-locator-pack(digest))));
        def bdj-fault-id(pending, epoch, cause, observedEpoch) = bdj-fault-id-from-digest(bdj-fault-digest-for(pending, epoch, cause, observedEpoch));
        def bdj-digest-bytes?(bytes, at) = at >= len(bytes) ? 1 : !((Comparable) oti-u32?(bytes[at]) == 1) ? 0 : bytes[at] > 255 ? 0 : bdj-digest-bytes?(bytes, at + 1);
        def bdj-digest-valid?(digest) = !((Comparable) len(digest) == 32) ? 0 : bdj-digest-bytes?(digest, 0);
        def bdj-fault-with-digest(cause, stage, disposition, evidence, observedEpoch, digest) = list(BDJFaultSchema(), cause, stage, disposition, evidence, observedEpoch, BDJFaultPriority(), BDJFaultPublisher(), bdj-fault-id-from-digest(digest), digest);
        def bdj-fault(pending, epoch, cause, stage, disposition, evidence, observedEpoch) {
            let digest = bdj-fault-digest-for(pending, epoch, cause, observedEpoch);
            bdj-fault-with-digest(cause, stage, disposition, evidence, observedEpoch, digest);
        }
        def bdj-fault-cause(fault) = fault[1];
        def bdj-fault-stage(fault) = fault[2];
        def bdj-fault-disposition(fault) = fault[3];
        def bdj-fault-evidence(fault) = fault[4];
        def bdj-fault-observed(fault) = fault[5];
        def bdj-fault-priority(fault) = fault[6];
        def bdj-fault-publisher(fault) = fault[7];
        def bdj-fault-key(fault) = fault[8];
        def bdj-fault-digest(fault) = fault[9];
        def bdj-fault-shape?(fault) = !((Comparable) len(fault) == 10) ? 0 : !((String) head(fault) == BDJFaultSchema()) ? 0 : bdj-digest-valid?(bdj-fault-digest(fault));
        def bdj-fault-bound-to-pending?(fault, pending, epoch) {
            !((Comparable) bdj-fault-shape?(fault) == 1) ? 0
            : nothing?(pending) ? 0
            : bdj-fault-bound-digest?(fault, bdj-fault-digest-for(pending, epoch, bdj-fault-cause(fault), bdj-fault-observed(fault)));
        }
        def bdj-fault-bound-digest?(fault, recomputed) = !((Comparable) ((Value) bdj-fault-digest(fault) == recomputed) == 1) ? 0 : ((String) bdj-fault-key(fault) == bdj-fault-id-from-digest(recomputed));
        // Controls may change the disposition and its evidence, but they never
        // rename the physical failure Glass is already holding. Retry time is
        // carried by the separate control record; fault observed/key remain the
        // causal identity that a successful heal must reference exactly.
        def bdj-fault-with-disposition(fault, disposition, evidence) = list(BDJFaultSchema(), bdj-fault-cause(fault), bdj-fault-stage(fault), disposition, evidence, bdj-fault-observed(fault), bdj-fault-priority(fault), bdj-fault-publisher(fault), bdj-fault-key(fault), bdj-fault-digest(fault));
        def bdj-fault-state(state, pending, cause, stage) = bdj-next(state, bdj-state-registry(state), pending, "jit-fault-attention", bdj-fault(pending, bdj-state-epoch(state), cause, stage, "attention", "awaiting-specific-control-evidence", bdj-stage-finished(stage)), nothing());
        def bdj-fault-control(cause, disposition, evidence, observedEpoch) = list(BDJFaultControlSchema(), cause, disposition, evidence, observedEpoch);
        def bdj-fault-control-disposition(control) = control[2];
        def bdj-fault-control-evidence(control) = control[3];
        def bdj-fault-control-observed(control) = control[4];
        def bdj-healed(fault, evidence, observedEpoch) = list(BDJHealedSchema(), bdj-fault-publisher(fault), bdj-fault-observed(fault), bdj-fault-key(fault), bdj-fault-cause(fault), bdj-fault-priority(fault), evidence, observedEpoch, bdj-fault-digest(fault));
        def bdj-healed?(value) = nothing?(value) ? 0 : !((Comparable) len(value) == 9) ? 0 : !((String) head(value) == BDJHealedSchema()) ? 0 : !((Comparable) bdj-digest-valid?(value[8]) == 1) ? 0 : ((String) value[3] == bdj-fault-id-from-digest(value[8]));
        def bdj-healed-publisher(value) = value[1];
        def bdj-healed-snapshot-epoch(value) = value[2];
        def bdj-healed-fault-key(value) = value[3];
        def bdj-healed-cause(value) = value[4];
        def bdj-healed-priority(value) = value[5];
        def bdj-healed-evidence(value) = value[6];
        def bdj-healed-observed(value) = value[7];
        def bdj-healed-digest(value) = value[8];
        def bdj-healed-matches-fault?(healed, fault) = !((Comparable) bdj-healed?(healed) == 1) ? 0 : !((Comparable) bdj-fault-shape?(fault) == 1) ? 0 : !((String) bdj-healed-publisher(healed) == bdj-fault-publisher(fault)) ? 0 : !((Comparable) bdj-healed-snapshot-epoch(healed) == bdj-fault-observed(fault)) ? 0 : !((String) bdj-healed-fault-key(healed) == bdj-fault-key(fault)) ? 0 : !((String) bdj-healed-cause(healed) == bdj-fault-cause(fault)) ? 0 : ((Value) bdj-healed-digest(healed) == bdj-fault-digest(fault));
        def bdj-fault-control-valid?(control) = !((Comparable) len(control) == 5) ? 0 : !((String) head(control) == BDJFaultControlSchema()) ? 0 : str_len(control[1]) <= 0 ? 0 : (!((String) control[2] == "healed")) && (!((String) control[2] == "held")) ? 0 : str_len(control[3]) <= 0 ? 0 : control[4] < 0 ? 0 : 1;
        def bdj-fault-control-result(status, state, control) = list(BDJFaultControlResultSchema(), status, state, control);
        def bdj-fault-control-status(result) = result[1];
        def bdj-fault-control-state(result) = result[2];
        def bdj-fault-apply(state, control) {
            !((Comparable) bdj-state-faulted?(state) == 1) ? bdj-care-control(state, control)
            : !((Comparable) bdj-fault-control-valid?(control) == 1) ? bdj-fault-control-result("refused-malformed-control", state, control)
            : !((String) control[1] == bdj-fault-cause(bdj-state-fault(state))) ? bdj-fault-control-result("refused-cause-mismatch", state, control)
            : (String) control[2] == "held" ? bdj-fault-control-result("held-with-evidence", bdj-next(state, bdj-state-registry(state), bdj-state-pending(state), "jit-fault-held", bdj-fault-with-disposition(bdj-state-fault(state), "held", control[3]), control), control)
            : bdj-fault-control-result("heal-probe-armed", bdj-next(state, bdj-state-registry(state), bdj-state-pending(state), "jit-heal-probe-armed", bdj-fault-with-disposition(bdj-state-fault(state), "probe-armed", control[3]), control), control);
        }

        // parsed = status, runtime fingerprint, epoch, exact-program-wire,
        // image-id, image. Runtime/emitter/authority changes expire disk ice.
        def bdj-cache-refused(reason) = list(reason, "", 0, "", 0, list());
        def bdj-cache-parsed(runtime, epoch, programWire, imageId, image) = list("parsed", runtime, epoch, programWire, imageId, image);
        def bdj-cache-parse-with-runtime(text, runtimeIdentity) {
            let lines = split-on(text, "\n");
            !((Comparable) len(lines) == 6) ? bdj-cache-refused("cache-shape")
            : !((String) lines[0] == BDJCacheSchema()) ? bdj-cache-refused("cache-schema")
            : !((Comparable) bdj-runtime-identity-ready?(runtimeIdentity) == 1) ? bdj-cache-refused("runtime-identity-unavailable")
            : !((String) lines[1] == runtimeIdentity) ? bdj-cache-refused("cache-runtime")
            : !((Comparable) bdj-uint?(lines[2]) == 1) ? bdj-cache-refused("cache-epoch")
            : (Comparable) str_len(lines[3]) == 0 ? bdj-cache-refused("cache-program-wire")
            : !((Comparable) bdj-uint?(lines[4]) == 1) ? bdj-cache-refused("cache-image-id")
            : bdj-cache-parse-image(lines);
        }
        def bdj-cache-parse(text) = bdj-cache-parse-with-runtime(text, bdj-runtime-fingerprint());
        def bdj-cache-parse-image(lines) {
            let parts = split-on(lines[5], ",");
            !((Comparable) bdj-byte-parts?(parts) == 1) ? bdj-cache-refused("cache-image-bytes")
            : bdj-cache-verify-image(lines, bdj-parts-ints(parts));
        }
        def bdj-cache-verify-image(lines, image) = !((Comparable) jonb-image-id(image) == str_to_int(lines[4])) ? bdj-cache-refused("cache-image-fold") : bdj-cache-parsed(lines[1], str_to_int(lines[2]), lines[3], str_to_int(lines[4]), image);
        def bdj-cache-image(parsed) = parsed[5];

        def bdj-cache-wire-with-runtime(runtimeIdentity, epoch, programWire, image) = bdj-cat(list(BDJCacheSchema(), "\n", runtimeIdentity, "\n", int_to_str(epoch), "\n", programWire, "\n", int_to_str(jonb-image-id(image)), "\n", bdj-image-text(image)));
        def bdj-cache-wire(epoch, programWire, image) = bdj-cache-wire-with-runtime(bdj-runtime-fingerprint(), epoch, programWire, image);
        def bdj-publish-lock-path(cache) = cache ++ ".publish-lock";
        def bdj-publish-lease-path(cache) = fs-path-join(bdj-publish-lock-path(cache), "lease");
        def bdj-candidate-path(cache) = fs-path-join(bdj-publish-lock-path(cache), "candidate");
