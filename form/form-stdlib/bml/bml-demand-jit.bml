            let publish = ((String) publishAttempt == "published") && (!((String) readback == "current")) ? bdj-cat(list("publish-readback-", readback)) : publishAttempt;
            let published = now_unix_ms();
            let publishMs = published - publishStarted;
            let stage = bdj-stage(started, published, cacheState, cacheAge, sourceAge, cacheMtime, sourceMtime, inspectMs, materializeMs, installMs, publishMs, materializeAction);
            let next = bdj-next(state, retained, nothing(), "resident-native", nothing(), nothing());
            let status = (String) publish == "published" ? "compiled-published-installed" : (String) publish == "reused-disk" ? "disk-installed" : (String) publish == "withheld-source-missing" ? "ram-installed-source-missing" : "ram-installed-disk-publish-failed";
            ((String) status == "ram-installed-disk-publish-failed") || ((String) status == "ram-installed-source-missing") ? bdj-step-publish-care(next, pending, image, runtimeIdentity, cacheState, publish, stage)
            : bdj-step-finish(status, cacheState, started, next, publish, 1, 1, stage);
        }
        // Cache care owns the exact bytes and their compilation identity. Its
        // retry crosses only the disk membrane; it neither emits nor installs
        // native code and cannot certify recovery of an execution fault.
        def bdj-care(fault, pending, image, runtimeIdentity) = list(fault, pending, image, runtimeIdentity, bdj-care-reading(fault, pending, bdj-fault-evidence(fault)));
        def bdj-care-fault(care) = care[0];
        def bdj-care-pending(care) = care[1];
        def bdj-care-image(care) = care[2];
        def bdj-care-runtime(care) = care[3];
        def bdj-care-observation(care) = care[4];
        def bdj-care-with-disposition(care, disposition, evidence) = list(bdj-fault-with-disposition(bdj-care-fault(care), disposition, evidence), bdj-care-pending(care), bdj-care-image(care), bdj-care-runtime(care), bdj-care-observation(care));
        // Read only resources implicated in the retained operation. Wall time
        // becomes a change only at lease expiry. A parent's unrelated writes
        // cannot wake care; its availability can. Host metadata does not expose
        // permission/capacity changes: a correlated organ response can offer those.
        def bdj-care-resources(pending, result) {
            let source = bdj-pending-source(pending);
            let cache = bdj-pending-cache(pending);
            (String) result == "withheld-source-missing" ? json-node-object(list(oh-n("source_file", fs-is-file?(source))))
            : (String) result == "publish-parent-unavailable" ? json-node-object(list(oh-n("parent_directory", fs-is-dir?(fs-path-dirname(cache)))))
            : (String) result == "publish-busy" ? bdj-care-lease-resources(cache)
            : json-node-object(list(oh-n("source_file", fs-is-file?(source)), oh-n("parent_directory", fs-is-dir?(fs-path-dirname(cache))),
                json-node-pair("cache", json-node-array(oh-ints(fs-stat(cache)))),
                json-node-pair("lease_directory", json-node-array(oh-ints(fs-stat(bdj-publish-lock-path(cache))))),
                oh-n("lease_expired", bdj-publish-lock-expired?(cache, now_unix_ms() / 1000)),
                json-node-pair("lease", json-node-array(oh-ints(fs-stat(bdj-publish-lease-path(cache))))),
                json-node-pair("candidate", json-node-array(oh-ints(fs-stat(bdj-candidate-path(cache)))))));
        }
        def bdj-care-lease-resources(cache) {
            let metadata = fs-stat(bdj-publish-lock-path(cache));
            let exists = metadata[4];
            let expired = exists && ((metadata[1] <= 0) || ((now_unix_ms() / 1000) >= (metadata[1] + BDJPublishLeaseSeconds())));
            json-node-object(list(oh-n("lease_present", exists), oh-n("lease_expired", expired), json-node-pair("lease_directory", json-node-array(oh-ints(metadata)))));
        }
        def bdj-care-reading(fault, pending, result) {
            let repaired = (String) result == "published";
            let reading = oh-reading("bml-demand-jit", bdj-image-text(bdj-fault-digest(fault)), "optional-cache-publication",
                json-node-string("published"), json-node-string(result), json-node-int(repaired),
                repaired ? list() : list(oh-need("cache-publication-resource", json-node-object(list(oh-s("source", bdj-pending-source(pending)), oh-s("cache", bdj-pending-cache(pending)))))),
                list("publish-retained-image", "await-resource"), bdj-care-resources(pending, result));
            reading;
        }
        def bdj-care-ready?(care) {
            let disposition = bdj-fault-disposition(bdj-care-fault(care));
            (String) disposition == "held" ? 0
            : (String) disposition != "waiting" ? 1
            : bdj-care-resource-changed?(care);
        }
        def bdj-care-resource-changed?(care) {
            let result = oh-str(bdj-care-observation(care), "observed");
            let current = bdj-care-resources(bdj-care-pending(care), result);
            // Availability may return between the failed operation and its
            // retained reading. Recognize that evidence without requiring a
            // second transition that might never arrive.
            (String) result == "withheld-source-missing" ? json-int-value(oh-get(current, "source_file"))
            : (String) result == "publish-parent-unavailable" ? json-int-value(oh-get(current, "parent_directory"))
            : (String) result == "publish-busy" ? (!json-int-value(oh-get(current, "lease_present"))) || json-int-value(oh-get(current, "lease_expired"))
            : !node_eq(current, oh-get(bdj-care-observation(care), "evidence"));
        }
        def bdj-care-fault-record(pending, epoch, publish, stage) {
            let fault = bdj-fault(pending, epoch, bdj-cat(list("disk-publish-", publish)), stage, "attention", publish, bdj-stage-finished(stage));
            list(BDJFaultSchema(), bdj-fault-cause(fault), stage, "waiting", publish, bdj-fault-observed(fault), nothing(), bdj-fault-publisher(fault), bdj-fault-key(fault), bdj-fault-digest(fault));
        }
        def bdj-step-publish-care(state, pending, image, runtimeIdentity, cacheState, publish, stage) {
            let care = bdj-care(bdj-care-fault-record(pending, bdj-state-epoch(state), publish, stage), pending, image, runtimeIdentity);
            oh-frame(bdj-care-observation(care));
            oh-frame(oh-response(bdj-care-observation(care), "await-resource"));
            let next = bdj-state-with-care(state, append(bdj-state-care(state), list(care)), nothing());
            bdj-step-receipt("ram-installed-cache-care", cacheState, bdj-stage-total-ms(stage), next, publish, 1, 1, stage);
        }
        def bdj-care-active(cares) = nil?(cares) ? nothing() : bdj-care-ready?(head(cares)) ? head(cares) : bdj-care-active(tail(cares));
        // A response resumes its exact waiting operation directly. It offers a
        // new attempt, not a claim that the resource recovered. The operation
        // itself observes the result and backtracks with its original context.
        def bdj-care-response(cares, response) {
            nil?(cares) ? nothing()
            : {
                let care = head(cares);
                let selected = oh-select(bdj-care-observation(care), response, nothing());
                (((String) bdj-fault-disposition(bdj-care-fault(care)) == "waiting") && !nothing?(selected) && ((String) selected == "publish-retained-image")) ? care
                : bdj-care-response(tail(cares), response);
            };
        }
        def bdj-care-hear(state, response) {
            let care = bdj-care-response(bdj-state-care(state), response);
            nothing?(care) ? nothing() : bdj-step-care-publish(state, care, now_unix_ms());
        }
        def bdj-care-for-cause(cares, cause) = (Comparable) len(cares) == 0 ? nothing() : (String) bdj-fault-cause(bdj-care-fault(head(cares))) == cause ? head(cares) : bdj-care-for-cause(tail(cares), cause);
        def bdj-care-cause-count(cares, cause) = (Comparable) len(cares) == 0 ? 0 : ((String) bdj-fault-cause(bdj-care-fault(head(cares))) == cause ? 1 : 0) + bdj-care-cause-count(tail(cares), cause);
        def bdj-care-for-digest(cares, digest) = (Comparable) len(cares) == 0 ? nothing() : (Value) bdj-fault-digest(bdj-care-fault(head(cares))) == digest ? head(cares) : bdj-care-for-digest(tail(cares), digest);
        def bdj-care-replace(cares, care, replacement) = (Comparable) len(cares) == 0 ? list() : (Value) head(cares) == care ? (nothing?(replacement) ? tail(cares) : cons(replacement, tail(cares))) : cons(head(cares), bdj-care-replace(tail(cares), care, replacement));
        def bdj-care-control(state, control) {
            (Comparable) len(bdj-state-care(state)) == 0 ? bdj-fault-control-result("refused-no-active-fault", state, control)
            : !bdj-fault-control-valid?(control) ? bdj-fault-control-result("refused-malformed-control", state, control)
            : bdj-care-cause-count(bdj-state-care(state), control[1]) > 1 ? bdj-fault-control-result("refused-ambiguous-cache-cause", state, control)
            : bdj-care-control-found(state, control, bdj-care-for-cause(bdj-state-care(state), control[1]));
        }
        def bdj-care-control-for(state, digest, control) {
            !bdj-fault-control-valid?(control) ? bdj-fault-control-result("refused-malformed-control", state, control)
            : bdj-care-control-found(state, control, bdj-care-for-digest(bdj-state-care(state), digest));
        }
        def bdj-care-control-found(state, control, care) {
            nothing?(care) ? bdj-fault-control-result("refused-cause-mismatch", state, control)
            : !((String) bdj-fault-cause(bdj-care-fault(care)) == control[1]) ? bdj-fault-control-result("refused-cause-mismatch", state, control)
            : bdj-care-control-update(state, control, care);
        }
        def bdj-care-control-update(state, control, care) {
            let disposition = (String) control[2] == "held" ? "held" : "probe-armed";
            let updated = bdj-care-with-disposition(care, disposition, control[3]);
            bdj-fault-control-result((String) disposition == "held" ? "held-with-evidence" : "heal-probe-armed", bdj-state-with-care(state, bdj-care-replace(bdj-state-care(state), care, updated), nothing()), control);
        }
        def bdj-step-care(state, started) {
            let care = bdj-care-active(bdj-state-care(state));
            nothing?(care) ? bdj-step-receipt("cache-care-waiting", "not-inspected", 0, state, "none", 0, 0, bdj-stage-empty(started, started, "not-inspected"))
            : bdj-step-care-publish(state, care, started);
        }
        def bdj-step-care-publish(state, care, started) {
            let walk = oac-backtrack-walk(list(bdj-care-publish-option, bdj-care-await-option), list(state, care, started), list());
            oac-payload(oac-backtrack-ack(walk));
        }
        def bdj-care-publish-option(offered) {
            let args = oac-option-args(offered);
            let [state, care, started] = args;
            let pending = bdj-care-pending(care);
            let cache = bdj-pending-cache(pending);
            let source = bdj-pending-source(pending);
            let sourceMtime = bdj-path-mtime(source);
            let cacheMtime = bdj-path-mtime(cache);
            let cacheAge = bdj-path-age-ms(cache, started);
            let sourceAge = bdj-path-age-ms(source, started);
            let bound = bdj-fault-bound-to-pending?(bdj-care-fault(care), pending, bdj-state-epoch(state));
            oh-frame(oh-response(bdj-care-observation(care), "publish-retained-image"));
            let attempt = !bound ? "care-identity-mismatch" : !fs-is-file?(source) ? "withheld-source-missing" : bdj-publish-with-runtime(cache, bdj-state-epoch(state), bdj-pending-program-wire(pending), bdj-care-image(care), bdj-care-runtime(care));
            let readback = (String) attempt == "published" ? bdj-cache-inspection-status(bdj-cache-inspect-content-with-runtime(cache, bdj-state-epoch(state), bdj-pending-program-wire(pending), bdj-care-runtime(care))) : "not-requested";
            let result = ((String) attempt == "published") && (!((String) readback == "current")) ? bdj-cat(list("publish-readback-", readback)) : attempt;
            let finished = now_unix_ms();
            let stage = bdj-stage(started, finished, "not-inspected", cacheAge, sourceAge, cacheMtime, sourceMtime, 0, 0, 0, finished - started, "retained-image");
            oh-frame(oh-applied(bdj-care-observation(care), "publish-retained-image", json-node-string(result)));
            let reading = oh-set(bdj-care-reading(bdj-care-fault(care), pending, result), "care_of", oh-get(bdj-care-observation(care), "id"));
            oh-frame(reading);
            let finding = list(result, stage, reading);
            (String) result == "published" ? oac-one(bdj-care-result-step(args, finding)) : oac-node(finding);
        }
        def bdj-care-await-option(offered) {
            let finding = head(oac-option-memory(offered));
            oh-frame(oh-response(finding[2], "await-resource"));
            oac-one(bdj-care-result-step(oac-option-args(offered), finding));
        }
        def bdj-care-result-step(args, finding) {
            let [state, care] = args;
            let [result, stage] = finding;
            let repaired = (String) result == "published";
            let replacement = repaired ? nothing() : list(bdj-fault-with-disposition(bdj-care-fault(care), (String) result == "care-identity-mismatch" ? "held" : "waiting", result), bdj-care-pending(care), bdj-care-image(care), bdj-care-runtime(care), finding[2]);
            let next = bdj-state-with-care(state, bdj-care-replace(bdj-state-care(state), care, replacement), repaired ? bdj-healed(bdj-care-fault(care), "cache-readback-current", bdj-stage-finished(stage)) : nothing());
            bdj-step-at-cache(bdj-step-receipt(repaired ? "cache-repaired" : "cache-care-observed", "not-inspected", bdj-stage-total-ms(stage), next, result, 0, 0, stage), bdj-pending-cache(bdj-care-pending(care)));
        }
        // The receipt and stage share one finished endpoint.  This prevents a
        // refusal from claiming time after its preserved diagnostic stage.
        def bdj-step-fault-finish(cacheState, state, diskAction, stage) = bdj-step-receipt-with-attention("jit-fault-attention", cacheState, bdj-stage-total-ms(stage), "immediate", state, diskAction, 0, 0, stage);
        def bdj-step-finish(status, cacheState, started, state, diskAction, installed, agreement, stage) = bdj-step-receipt(status, cacheState, bdj-stage-total-ms(stage), state, diskAction, installed, agreement, stage);
    }
    0;
}
