// One group owns each token/head. Independent scores and output columns run
// in parallel; every dot, softmax sum and value fold keeps the serial order.
// The score and exponential buffers retain the existing span layout.
// preludes: form-stdlib/metal-door.fk
section [form.bml] {
 class Qwen38PrefillAttention {
  def q38pa-index() = 59;
  def q38pa-name() = "form_gqa_span_cooperative_f32";
  def q38pa-threads() = 256;
  def q38pa-cat(parts) = if nil?(parts) then "" else str_concat(head(parts),q38pa-cat(tail(parts)));
  def q38pa-msl() = q38pa-cat(list("kernel void ",q38pa-name(),
   "(device const float* q [[buffer(0)]], device const float* kc [[buffer(1)]], device const float* vc [[buffer(2)]], device float* y [[buffer(3)]], device float* sc [[buffer(4)]], constant uint& pos0 [[buffer(5)]], constant uint& nq [[buffer(6)]], constant uint& nkv [[buffer(7)]], constant uint& hd [[buffer(8)]], constant float& scale [[buffer(9)]], constant uint& sstride [[buffer(10)]], constant uint& ntok [[buffer(11)]], uint3 group [[threadgroup_position_in_grid]], uint lid [[thread_index_in_threadgroup]]) {\n",
   " uint row=group.x, tk=row/nq; if(tk>=ntok) return; uint h=row-tk*nq, npos=pos0+tk+1u, kvh=h/(nq/nkv), KVD=nkv*hd, qoff=row*hd, koff=kvh*hd, S=row*sstride, E=(ntok*nq+row)*sstride; threadgroup float shared[2];\n",
   " for(uint t=lid;t<npos;t+=",int_to_str(q38pa-threads()),"u) { float acc=0.0f; uint c=hd; while(c>0u) { --c; float p=q[qoff+c]*kc[t*KVD+koff+c]; acc=p+acc; } sc[S+t]=acc*scale; }\n",
   " metal::threadgroup_barrier(metal::mem_flags::mem_device); if(lid==0u) { float mx=sc[S]; for(uint t=1u;t<npos;++t) if(sc[S+t]>mx) mx=sc[S+t]; shared[0]=mx; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n",
   " for(uint t=lid;t<npos;t+=",int_to_str(q38pa-threads()),"u) sc[E+t]=fexp(sc[S+t]-shared[0]); metal::threadgroup_barrier(metal::mem_flags::mem_device);\n",
   " if(lid==0u) { float sumes=0.0f; for(uint t=0u;t<npos;++t) sumes=sumes+sc[E+t]; shared[1]=1.0f/sumes; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\n",
   " for(uint t=lid;t<npos;t+=",int_to_str(q38pa-threads()),"u) sc[S+t]=sc[E+t]*shared[1]; metal::threadgroup_barrier(metal::mem_flags::mem_device);\n",
   " for(uint i=lid;i<hd;i+=",int_to_str(q38pa-threads()),"u) { float acc=0.0f; for(uint t=0u;t<npos;++t) { float pv=vc[t*KVD+koff+i]*sc[S+t]; acc=acc+pv; } y[qoff+i]=acc; } }\n"));
  def q38pa-pipes(msl) = list(metal_pipeline(msl,q38pa-name()));
  def q38pa-enqueue(pipeline,bufs,consts,groups,barrier) = metal_enqueue(pipeline,md-bind16(bufs,consts,q38pa-threads(),0,1,barrier),groups);
 }
 0;
}
