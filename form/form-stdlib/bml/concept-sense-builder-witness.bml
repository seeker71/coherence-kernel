// Exact complete outputs, executable indices and private publication boundaries.
// preludes: form-stdlib/bml/concept-sense-builder.bml form-stdlib/bml/native-source-inventory.bml
section [form.bml] {
 class ConceptSenseWitness {
  def csw-put(path,bytes) = if and(eq(write_file(path,bytes),str_len(bytes)),str_eq(read_file(path),bytes)) then path else form_error("sense witness exact write refused");
  def csw-copy(state,root,paths) = if nil?(paths) then 1 else csw-copy-file(state,root,head(paths),tail(paths));
  def csw-copy-file(state,root,path,rest) {
   let target = fs-path-join(root,path); fs_mkdir(fs-path-dirname(target));
   csw-put(target,csa-file(state,path)); csw-copy(state,root,rest);
  }
  def csw-paths(outputs) = if nil?(outputs) then list() else cons(head(head(outputs)),csw-paths(tail(outputs)));
  def csw-equal(root,outputs) = if nil?(outputs) then 1 else and(str_eq(read_file(fs-path-join(root,head(head(outputs)))),nth(head(outputs),1)),csw-equal(root,tail(outputs)));
  def csw-child(job,name,preludes,body) {
   let path = csw-put(nsi-path(job,str_concat(name,".bml")),csa-join(list("// preludes: ",preludes,"\nsection [form.bml] {\n",body,"\n}\n"),""));
   nsi-capture(list("./fkwu",path));
  }
  def csw-runtime(job,name,metadata,offsets) = csw-child(job,name,str_concat(metadata,str_concat(" ",offsets)),"list(cts10-count(),cts10-mapped-anchors(),cts10-total-senses(),cts10-ambiguous-anchors(),cts10-max-senses(),cts10-data-path(),cts10-data-sha256(),cts10-offsets());");
  def csw-manifest(work,keys) = if nil?(keys) then "" else str_concat(ctsb-line(head(keys),ctsb-binding(work,head(keys))),csw-manifest(work,tail(keys)));
  def csw-refusal(job,state,name,body,aspect) {
   let child = csw-child(job,name,"form-stdlib/bml/concept-sense-builder.bml",body);
   ctsb-check(state,name,and(eq(nsi-status(child),1),ge(str_find(nsi-text(child),aspect,0),0))); 1;
  }
  def csw-stages-gone(stages) = if nil?(stages) then 1 else and(not(fs_exists(nth(head(stages),1))),csw-stages-gone(tail(stages)));
  def csw-refusals(job,work,root,dict) {
   let state = record_get(work,"input");
   csw-refusal(job,state,"partial-decimal-refused","ctsb-number(cmm-state(\".\",\"form-sha256\"),\"01x\",0,3);","sense-build-complete-decimal");
   csw-refusal(job,state,"lemma-span-refused","let w = record_new(0,\"input\",cmm-state(\".\",\"form-sha256\")); ctsb-anchor-lemma(w,\"100000000000000000000000001000000000\",\"99tiny\",0);","sense-build-lemma-span");
   csw-refusal(job,state,"projected-count-refused","let w = record_new(0,\"input\",cmm-state(\".\",\"form-sha256\")); ctsb-render-row(w,record_new(0,\"expected\",1,\"count\",0),list(),0);","sense-build-projected-sense-count");
   csw-refusal(job,state,"unresolved-definition-refused","let w = record_new(0,\"input\",cmm-state(\".\",\"form-sha256\")); ctsb-senses(w,list(list(record_new(0,\"ready\",0),1,0)),list());","sense-build-referenced-definition-present");
   csw-refusal(job,state,"mapped-zero-sense-refused","let w = record_new(0,\"input\",cmm-state(\".\",\"form-sha256\")); ctsb-anchor-lemma(w,\"100000000000000000000000000000000000\",\"01a\",0);","sense-build-mapped-sense-count-positive");
   csw-refusal(job,state,"nul-dictionary-path-refused","ctsb-prepare(\".\",str_concat(\"owned\",str_concat(byte_to_str(0),\"extra\")),\"form-sha256\");","sense-build-complete-host-paths");
   csw-refusal(job,state,"duplicate-request-field-refused","ctsb-request(\"{\\\"dict\\\":\\\"a\\\",\\\"dict\\\":\\\"b\\\"}\");","unique root/dict/hash");
   let indexPath = fs-path-join(dict,"index.sense"); let held = read_file(indexPath);
   csw-put(indexPath,str_concat(held,"changed"));
   let call = csa-join(list("ctsb-prepare(",ctsb-quoted(root),",",ctsb-quoted(dict),",\"arm64-sha256\");"),"");
   let changed = csw-child(job,"changed-source-identity","form-stdlib/bml/concept-sense-builder.bml",call);
   csw-put(indexPath,held);
   ctsb-check(state,"source-identity-refusal-and-restoration",and(eq(nsi-status(changed),1),ge(str_find(nsi-text(changed),"sense-build-source-identity-index.sense",0),0)));
   let pathList = fs-path-join(job,"changed-stages.txt");
   let body = csa-join(list("let w = ctsb-complete(ctsb-prepare(",ctsb-quoted(root),",",ctsb-quoted(dict),",\"arm64-sha256\")); let s = record_get(w,\"input\"); cmm-freeze-outputs(s,record_get(w,\"outputs\")); let stages = cmm-stages(s,record_get(w,\"outputs\"),\".witness-changed-stage\"); record_set(s,\"owned-stages\",list()); record_set(s,\"published\",0); if not(cmm-stage-free(s,stages)) then form_error(\"private stage occupied\") else 0; cmm-stage-all(s,stages); let names = csa-join(record_get(s,\"owned-stages\"),\"\\n\"); write_file(",ctsb-quoted(pathList),",names); let p = ",ctsb-quoted(indexPath),"; let b = str_concat(read_file(p),\"changed\"); write_file(p,b); ctsb-source-fresh(w,ctsb-files());"),"");
   let stale = csw-child(job,"changed-held-source","form-stdlib/bml/concept-sense-builder.bml",body);
   csw-put(indexPath,held);
   let stages = split-on(read_file(pathList),"\n");
   ctsb-check(state,"held-source-refusal-after-staging",and(eq(nsi-status(stale),1),and(ge(str_find(nsi-text(stale),"wordnet-changed-before-publication",0),0),ge(str_find(nsi-text(stale),"private-stages-after-refusal",0),0))));
   ctsb-check(state,"four-private-stages-physically-released",and(eq(len(stages),4),csw-paths-gone(stages)));
   ctsb-check(state,"refused-publication-output-bytes-unchanged",csw-equal(root,record_get(work,"outputs"))); 10;
  }
  def csw-paths-gone(paths) = if nil?(paths) then 1 else and(not(fs_exists(head(paths))),csw-paths-gone(tail(paths)));
  def csw-run(dictSource) {
   let job = nsi-job(); let start = host_monotonic_ms(); let before = metal_live();
   let work = ctsb-complete(ctsb-prepare(".",dictSource,"arm64-sha256")); let state = record_get(work,"input"); let built = sub(host_monotonic_ms(),start);
   ctsb-check(state,"entire-data-byte-equality",str_eq(record_get(work,"data"),csa-file(state,ctsb-path(".tsv"))));
   let keys = append(list("source","archive_sha256"),append(list("index.sense_sha256","data.noun_sha256","data.verb_sha256","data.adj_sha256","data.adv_sha256"),list("semantic_index_sha256","semantic_payload_sha256","output","output_sha256","anchors","mapped_anchors","ambiguous_anchors","total_senses","max_senses","license")));
   let bindings = csw-manifest(work,keys); let current = record_get(work,"manifest-lines");
   record_set(work,"manifest-lines",csa-lines(ctsb-manifest(work)));
   ctsb-check(state,"all-current-manifest-source-and-data-bindings",str_eq(bindings,csw-manifest(work,keys))); record_set(work,"manifest-lines",current);
   let old = csw-runtime(job,"current-runtime",ctsb-path("-metadata.fk"),ctsb-path("-offsets.fk"));
   let root = nsi-directory(job,"sense-",0); let dict = nsi-directory(job,"wordnet-",0);
   csw-copy(state,root,csw-paths(record_get(work,"outputs"))); csw-copy(state,root,record_get(state,"files"));
   csw-copy(record_get(work,"source"),dict,ctsb-files());
   record_set(state,"root",root); record_set(record_get(work,"source"),"root",dict);
   ctsb-check(state,"actual-four-artifact-publication",eq(ctsb-publish(work),1));
   ctsb-check(state,"complete-published-artifact-bytes",csw-equal(root,record_get(work,"outputs")));
   let next = csw-runtime(job,"generated-runtime",fs-path-join(root,ctsb-path("-metadata.fk")),fs-path-join(root,ctsb-path("-offsets.fk")));
   ctsb-check(state,"all-10001-offsets-and-metadata-values",and(nsi-ok(old),and(nsi-ok(next),str_eq(nsi-text(old),nsi-text(next)))));
   let portable = csw-child(job,"portable-republication","form-stdlib/bml/concept-sense-builder.bml",csa-join(list("ctsb-run(",ctsb-quoted(root),",",ctsb-quoted(dict),",\"form-sha256\");"),""));
   ctsb-check(state,"portable-idempotence",and(nsi-ok(portable),csw-equal(root,record_get(work,"outputs"))));
   let refusals = csw-refusals(job,work,root,dict); let after = metal_live();
   ctsb-check(state,"cpu-resource-release",and(eq(nth(before,2),nth(after,2)),eq(nth(before,3),nth(after,3))));
   print(list("sense-builder","bytes",record_get(work,"bytes"),"senses",record_get(work,"total"),"build-ms",built,"refusals",refusals,"evidence",job)); 1;
  }
 }
 0;
}
