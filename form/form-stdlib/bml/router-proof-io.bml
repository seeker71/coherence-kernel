// Form owns byte framing and process leases for the local Rust sibling proof.
// All connections target loopback. The current socket listener binds wildcard;
// socket reads are blocking, bounded by the owning process supervisor.
// preludes: form-stdlib/kernel-http-header.fk form-stdlib/organ-health.bml form-stdlib/bml/form-cli-heal-native-process.bml
section [form.bml] {
 class RouterProofIO {
  def rp-cat(parts) = nil?(parts) ? "" : head(parts) ++ rp-cat(tail(parts));
  def rp-all(values) = nil?(values) ? 1 : (head(values) && rp-all(tail(values)));
  def rp-repeat(text, count) = count <= 0 ? "" : (Comparable) count == 1 ? text : rp-repeat-pair(rp-repeat(text, count / 2), text, count % 2);
  def rp-repeat-pair(half, text, odd) = (half ++ half) ++ (odd ? text : "");
  def rp-pattern(at) = at >= 256 ? "" : byte_to_str(at) ++ rp-pattern(at + 1);
  def rp-binary(count) = substring(rp-repeat(rp-pattern(0), (count + 255) / 256), 0, count);
  def rp-path(job, name) = job ++ "/" ++ name;
  def rp-text(path) = file_size(path) < 0 ? "" : read_file(path);
  def rp-number(path) = str_to_int(trim(rp-text(path)));
  def rp-save(path, value) = write_file(path, json-emit-precise(value) ++ "\n");
  def rp-publish(path, value) {
   let text = json-emit-precise(value) ++ "\n";
   let staging = path ++ ".staged";
   let wrote = write_file(staging, text);
   ((Comparable) wrote == str_len(text)) && ((String) rp-text(staging) == text) ? fs_rename(staging, path) : -1;
  }
  def rp-link(conn) = record_new(0, "socket", conn, "carry", "", "state", "open");
  def rp-open(port) = rp-opened(socket_connect("127.0.0.1", port));
  def rp-opened(socket) = nothing?(socket) || (socket <= 0) ? form_error("native proof connection refused") : rp-link(socket);
  def rp-close(link) {
   let result = socket_close(record_get(link, "socket"));
   record_set(link, "state", (Comparable) result == 0 ? "closed" : "close-refused");
   (Comparable) result == 0 ? result : form_error("native proof socket release refused");
  }
  def rp-fill(link) {
   let chunk = socket_recv(record_get(link, "socket"), 65536);
   nothing?(chunk) ? rp-read-ended(link, "error") : (Comparable) str_len(chunk) == 0 ? rp-read-ended(link, "eof") : rp-read-more(link, chunk);
  }
  def rp-read-ended(link, state) {
   record_set(link, "state", state);
   0;
  }
  def rp-read-more(link, chunk) {
   record_set(link, "carry", record_get(link, "carry") ++ chunk);
   1;
  }
  def rp-send-at(link, bytes, offset) = offset >= str_len(bytes) ? offset : rp-send-step(link, bytes, offset, socket_send(record_get(link, "socket"), substring(bytes, offset, str_len(bytes))));
  def rp-send-step(link, bytes, offset, count) = nothing?(count) || (count <= 0) ? -1 : rp-send-at(link, bytes, offset + count);
  def rp-send(link, bytes) = rp-send-at(link, bytes, 0);
  def rp-take(link, count) {
   let held = record_get(link, "carry");
   str_len(held) >= count ? rp-take-ready(link, held, count) : rp-fill(link) ? rp-take(link, count) : nothing();
  }
  def rp-take-ready(link, held, count) {
   let value = substring(held, 0, count);
   record_set(link, "carry", substring(held, count, str_len(held)));
   value;
  }
  def rp-until(link, delimiter) {
   let at = str_find(record_get(link, "carry"), delimiter, 0);
   at >= 0 ? rp-take(link, at + str_len(delimiter)) : rp-fill(link) ? rp-until(link, delimiter) : nothing();
  }
  def rp-eof-body(link, held) {
   let next = socket_recv(record_get(link, "socket"), 65536);
   nothing?(next) ? nothing() : (Comparable) str_len(next) == 0 ? held : rp-eof-body(link, held ++ next);
  }
  def rp-header-pairs(lines) = nil?(lines) ? list() : rp-header-line(head(lines), tail(lines));
  def rp-header-line(line, rest) {
   let at = str_find(line, ":", 0);
   at < 0 ? rp-header-pairs(rest) : cons(list(kh-ascii-lower(substring(line, 0, at)), trim(substring(line, at + 1, str_len(line)))), rp-header-pairs(rest));
  }
  def rp-header(headers, name) = nil?(headers) ? "" : (String) head(head(headers)) == name ? head(headers)[1] : rp-header(tail(headers), name);
  def rp-header-values(headers, name) = nil?(headers) ? list() : (String) head(head(headers)) == name ? cons(head(headers)[1], rp-header-values(tail(headers), name)) : rp-header-values(tail(headers), name);
  def rp-response(link) {
   let raw = rp-until(link, "\r\n\r\n");
   nothing?(raw) ? nothing() : rp-response-head(link, split-on(raw, "\r\n"));
  }
  def rp-response-head(link, lines) {
   let headers = rp-header-pairs(tail(lines));
   let parts = split-on(head(lines), " ");
   let status = str_to_int(parts[1]);
   let size = rp-header(headers, "content-length");
   let chunked = (String) kh-ascii-lower(rp-header(headers, "transfer-encoding")) == "chunked";
   let body = chunked ? rp-chunks(link, "") : str_len(size) > 0 ? rp-take(link, str_to_int(size)) : rp-response-close(link);
   nothing?(body) ? nothing() : list(status, headers, body);
  }
  def rp-response-close(link) {
   let held = record_get(link, "carry");
   record_set(link, "carry", "");
   rp-eof-body(link, held);
  }
  def rp-hex-digit(byte) = (byte >= 48) && (byte <= 57) ? (byte - 48) : (byte >= 65) && (byte <= 70) ? (byte - 55) : (byte >= 97) && (byte <= 102) ? (byte - 87) : nothing();
  def rp-hex-number(text, at, value) = at >= str_len(text) ? value : (Comparable) str_byte_at(text, at) == 59 ? value : rp-hex-step(text, at, value, rp-hex-digit(str_byte_at(text, at)));
  def rp-hex-step(text, at, value, digit) = nothing?(digit) ? nothing() : rp-hex-number(text, at + 1, (value * 16) + digit);
  def rp-hex-text(value) = value < 16 ? char_at("0123456789abcdef", value) : rp-hex-text(value / 16) ++ char_at("0123456789abcdef", value % 16);
  def rp-chunks(link, body) {
   let line = rp-until(link, "\r\n");
   nothing?(line) ? nothing() : rp-chunk-size(link, body, rp-hex-number(substring(line, 0, str_len(line) - 2), 0, 0));
  }
  def rp-chunk-size(link, body, count) = nothing?(count) ? nothing() : (Comparable) count == 0 ? rp-chunk-trailers(link, body) : rp-chunk-data(link, body, count, rp-take(link, count + 2));
  def rp-chunk-data(link, body, count, bytes) = nothing?(bytes) ? nothing() : !((String) substring(bytes, count, count + 2) == "\r\n") ? nothing() : rp-chunks(link, body ++ substring(bytes, 0, count));
  def rp-chunk-trailers(link, body) {
   let line = rp-until(link, "\r\n");
   nothing?(line) ? nothing() : (String) line == "\r\n" ? body : rp-chunk-trailers(link, body);
  }
  def rp-request(method, path, version, headers, body) = rp-request-framed(method, path, version, "127.0.0.1", headers, body, str_len(body) > 0 ? int_to_str(str_len(body)) : "");
  def rp-request-framed(method, path, version, host, headers, body, declared) = rp-cat(list(method, " ", path, " HTTP/", version, "\r\nHost: ", host, "\r\n", headers, str_len(declared) > 0 ? rp-cat(list("Content-Length: ", declared, "\r\n")) : "", "\r\n", body));
  def rp-get(path) = rp-request("GET", path, "1.1", "Connection: close\r\n", "");
  def rp-exchange(link, request) = (Comparable) rp-send(link, request) == str_len(request) ? rp-response(link) : nothing();
  def rp-fetch(port, request) {
   let link = rp-open(port);
   let row = rp-exchange(link, request);
   rp-close(link);
   row;
  }
  def rp-body(row) = nothing?(row) ? "" : row[2];
  def rp-code(row) = nothing?(row) ? -1 : head(row);
  def rp-h(row, name) = nothing?(row) ? "" : rp-header(row[1], name);
  def rp-answer(row, status, body, router) = rp-all(list((Comparable) rp-code(row) == status, (String) rp-body(row) == body, (String) rp-h(row, "x-form-router") == router));
  def rp-free-port() {
   let listener = socket_listen(0);
   nothing?(listener) || (listener <= 0) ? form_error("native proof port admission refused") : 0;
   let port = socket_port(listener);
   let released = socket_close(listener);
   !((Comparable) released == 0) ? form_error("native proof port release refused") : 0;
   port;
  }
  def rp-wait-file(path, deadline) = file_size(path) > 0 ? 1 : host_monotonic_ms() >= deadline ? 0 : rp-wait-file-pause(path, deadline);
  def rp-wait-file-pause(path, deadline) {
   host_sleep_ms(10);
   rp-wait-file(path, deadline);
  }
  def rp-owner(job) = record_new(0, "job", job, "children", list(), "released", list(), "rows", list(), "failed", 0, "started", 0);
  def rp-spawn(owner, name, argv, input) {
   let job = record_get(owner, "job");
   let pid = host_spawn_at(argv, list(input, rp-path(job, name ++ ".out"), rp-path(job, name ++ ".err")));
   nothing?(pid) || (pid <= 0) ? form_error("native routing child admission refused") : 0;
   record_set(owner, "children", cons(list(name, pid), record_get(owner, "children")));
   record_set(owner, "started", record_get(owner, "started") + 1);
   write_file(rp-path(job, name ++ ".pid"), int_to_str(pid));
   pid;
  }
  def rp-stop(pid) {
   nothing?(pid) || (pid <= 0) ? -1 : rp-stop-owned(pid);
  }
  def rp-stop-owned(pid) {
   let requested = (Comparable) host_alive(pid) == 1 ? host_kill(pid) : 0;
   rp-stop-wait(pid, host_monotonic_ms() + 2000, requested);
  }
  def rp-stop-wait(pid, deadline, requested) = !fhn-alive(pid) ? host_wait(pid) : host_monotonic_ms() >= deadline ? rp-stop-force(pid) : rp-stop-pause(pid, deadline, requested);
  def rp-stop-pause(pid, deadline, requested) {
   host_sleep_ms(10);
   rp-stop-wait(pid, deadline, requested);
  }
  def rp-stop-force(pid) {
   let signal = host_spawn_quiet(list("/bin/kill", "-KILL", int_to_str(pid)));
   host_wait(signal);
   host_wait(pid);
  }
  def rp-stop-all(children) = nil?(children) ? list() : cons(list(head(head(children)), head(children)[1], rp-stop(head(children)[1]), host_alive(head(children)[1])), rp-stop-all(tail(children)));
  def rp-child-name(children, pid) = nil?(children) ? "unowned" : (Comparable) head(children)[1] == pid ? head(head(children)) : rp-child-name(tail(children), pid);
  def rp-without-child(children, pid) = nil?(children) ? list() : (Comparable) head(children)[1] == pid ? rp-without-child(tail(children), pid) : cons(head(children), rp-without-child(tail(children), pid));
  def rp-release(owner, pid) {
   let children = record_get(owner, "children");
   let name = rp-child-name(children, pid);
   let result = (String) name == "unowned" ? -1 : rp-stop(pid);
   let alive = host_alive(pid);
   record_set(owner, "released", cons(list(name, pid, result, alive), record_get(owner, "released")));
   (Comparable) alive == 0 ? record_set(owner, "children", rp-without-child(children, pid)) : 0;
   result;
  }
  def rp-resource-rows(rows) = nil?(rows) ? list() : cons(json-node-object(list(fhn-s("child", head(head(rows))), fhn-n("pid", head(rows)[1]), fhn-n("wait_status", head(rows)[2]), fhn-n("alive_after_wait", head(rows)[3]))), rp-resource-rows(tail(rows)));
  def rp-resources-closed(rows) = nil?(rows) ? 1 : (((Comparable) head(rows)[3] == 0) && ((head(rows)[2] >= 0) && rp-resources-closed(tail(rows))));
  def rp-check(owner, aspect, expected, observed, accepted) {
   let row = oh-reading("router-native-proof", record_get(owner, "job"), aspect, expected, observed, json-node-int(accepted), accepted ? list() : list(oh-need("local-route-evidence", json-node-null())), accepted ? list() : list("request-evidence", "retain"), json-node-null());
   oh-voice(row);
   record_set(owner, "rows", cons(row, record_get(owner, "rows")));
   accepted ? 0 : rp-retain-pain(owner, row);
   accepted;
  }
  def rp-retain-pain(owner, row) {
   record_set(owner, "failed", record_get(owner, "failed") + 1);
   oh-voice(oh-response(row, "request-evidence"));
   let path = rp-path(record_get(owner, "job"), "attention.json");
   let text = json-emit-precise(row);
   let wrote = write_file(path, text);
   let retained = ((Comparable) wrote == str_len(text)) && ((String) rp-text(path) == text);
   oh-voice(oh-applied(row, "request-evidence", json-node-object(list(fhn-s("path", path), fhn-n("retained", retained)))));
   retained;
  }
 }
 0;
}
