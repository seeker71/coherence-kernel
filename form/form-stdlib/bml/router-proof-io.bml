// Form owns byte framing and process leases for the local Rust sibling proof.
// All connections target loopback. The current socket listener binds wildcard;
// socket reads are blocking, bounded by the owning process supervisor.
import form-stdlib/kernel-http-header.fk;
import form-stdlib/organ-health.bml;
import form-stdlib/bml/form-cli-heal-native-process.bml;
section [form.bml] {
 class RouterProofIO {
  def rp-cat(parts) = if nil?(parts) then "" else ((String) parts[0] + rp-cat(parts[1:]));
  def rp-all(values) = if nil?(values) then 1 else (values[0] && rp-all(values[1:]));
  def rp-repeat(text, count) = if (count <= 0) then "" else if ((Comparable) count == 1) then text else rp-repeat-pair(rp-repeat(text, (count / 2)), text, (count % 2));
  def rp-repeat-pair(half, text, odd) = (((String) half + half) + (if odd then text else ""));
  def rp-pattern(at) = if (at >= 256) then "" else ((String) byte_to_str(at) + rp-pattern((at + 1)));
  def rp-binary(count) = substring(rp-repeat(rp-pattern(0), ((count + 255) / 256)), 0, count);
  def rp-path(job, name) = (job + ("/" + name));
  def rp-text(path) = if (file_size(path) < 0) then "" else read_file(path);
  def rp-number(path) = str_to_int(trim(rp-text(path)));
  def rp-save(path, value) = write_file(path, (json-emit-precise(value) + "\n"));
  def rp-publish(path, value) {
   let text = (json-emit-precise(value) + "\n");
   let staging = (path + ".staged");
   let wrote = write_file(staging, text);
   if (((Comparable) wrote == len(text)) && ((String) rp-text(staging) == text)) then fs_rename(staging, path) else -1;
  }
  def rp-link(conn) = record_new(0, "socket", conn, "carry", "", "state", "open");
  def rp-open(port) = rp-opened(socket_connect("127.0.0.1", port));
  def rp-opened(socket) = if (nothing?(socket) || (socket <= 0)) then form_error("native proof connection refused") else rp-link(socket);
  def rp-close(link) {
   let result = socket_close(record_get(link, "socket"));
   record_set(link, "state", if ((Comparable) result == 0) then "closed" else "close-refused");
   if ((Comparable) result == 0) then result else form_error("native proof socket release refused");
  }
  def rp-fill(link) {
   let chunk = socket_recv(record_get(link, "socket"), 65536);
   if nothing?(chunk) then rp-read-ended(link, "error") else if ((Comparable) len(chunk) == 0) then rp-read-ended(link, "eof") else rp-read-more(link, chunk);
  }
  def rp-read-ended(link, state) {
   record_set(link, "state", state);
   0;
  }
  def rp-read-more(link, chunk) {
   record_set(link, "carry", ((String) record_get(link, "carry") + chunk));
   1;
  }
  def rp-send-at(link, bytes, offset) = if (offset >= len(bytes)) then offset else rp-send-step(link, bytes, offset, socket_send(record_get(link, "socket"), substring(bytes, offset, len(bytes))));
  def rp-send-step(link, bytes, offset, count) = if (nothing?(count) || (count <= 0)) then -1 else rp-send-at(link, bytes, (offset + count));
  def rp-send(link, bytes) = rp-send-at(link, bytes, 0);
  def rp-take(link, count) {
   let held = record_get(link, "carry");
   if (len(held) >= count) then rp-take-ready(link, held, count) else if rp-fill(link) then rp-take(link, count) else nothing();
  }
  def rp-take-ready(link, held, count) {
   let value = substring(held, 0, count);
   record_set(link, "carry", substring(held, count, len(held)));
   value;
  }
  def rp-until(link, delimiter) {
   let at = str_find(record_get(link, "carry"), delimiter, 0);
   if (at >= 0) then rp-take(link, (at + len(delimiter))) else if rp-fill(link) then rp-until(link, delimiter) else nothing();
  }
  def rp-eof-body(link, held) {
   let next = socket_recv(record_get(link, "socket"), 65536);
   if nothing?(next) then nothing() else if ((Comparable) len(next) == 0) then held else rp-eof-body(link, ((String) held + next));
  }
  def rp-header-pairs(lines) = if nil?(lines) then [] else rp-header-line(lines[0], lines[1:]);
  def rp-header-line(line, rest) {
   let at = str_find(line, ":", 0);
   if (at < 0) then rp-header-pairs(rest) else cons([kh-ascii-lower(substring(line, 0, at)), trim(substring(line, (at + 1), len(line)))], rp-header-pairs(rest));
  }
  def rp-header(headers, name) = if nil?(headers) then "" else if ((String) headers[0][0] == name) then headers[0][1] else rp-header(headers[1:], name);
  def rp-header-values(headers, name) = if nil?(headers) then [] else if ((String) headers[0][0] == name) then cons(headers[0][1], rp-header-values(headers[1:], name)) else rp-header-values(headers[1:], name);
  def rp-response(link) {
   let raw = rp-until(link, "\r\n\r\n");
   if nothing?(raw) then nothing() else rp-response-head(link, split-on(raw, "\r\n"));
  }
  def rp-response-head(link, lines) {
   let headers = rp-header-pairs(lines[1:]);
   let parts = split-on(lines[0], " ");
   let status = str_to_int(parts[1]);
   let size = rp-header(headers, "content-length");
   let chunked = ((String) kh-ascii-lower(rp-header(headers, "transfer-encoding")) == "chunked");
   let body = if chunked then rp-chunks(link, "") else if (len(size) > 0) then rp-take(link, str_to_int(size)) else rp-response-close(link);
   if nothing?(body) then nothing() else [status, headers, body];
  }
  def rp-response-close(link) {
   let held = record_get(link, "carry");
   record_set(link, "carry", "");
   rp-eof-body(link, held);
  }
  def rp-hex-digit(byte) = if ((byte >= 48) && (byte <= 57)) then (byte - 48) else if ((byte >= 65) && (byte <= 70)) then (byte - 55) else if ((byte >= 97) && (byte <= 102)) then (byte - 87) else -1;
  def rp-hex-number(text, at, value) = if (at >= len(text)) then value else if ((Comparable) str_byte_at(text, at) == 59) then value else if (rp-hex-digit(str_byte_at(text, at)) < 0) then -1 else rp-hex-number(text, (at + 1), ((value * 16) + rp-hex-digit(str_byte_at(text, at))));
  def rp-hex-text(value) = if (value < 16) then char_at("0123456789abcdef", value) else ((String) rp-hex-text((value / 16)) + char_at("0123456789abcdef", (value % 16)));
  def rp-chunks(link, body) {
   let line = rp-until(link, "\r\n");
   if nothing?(line) then nothing() else rp-chunk-size(link, body, rp-hex-number(substring(line, 0, (len(line) - 2)), 0, 0));
  }
  def rp-chunk-size(link, body, count) = if (count < 0) then nothing() else if ((Comparable) count == 0) then rp-chunk-trailers(link, body) else rp-chunk-data(link, body, count, rp-take(link, (count + 2)));
  def rp-chunk-data(link, body, count, bytes) = if nothing?(bytes) then nothing() else if (!((String) substring(bytes, count, (count + 2)) == "\r\n")) then nothing() else rp-chunks(link, ((String) body + substring(bytes, 0, count)));
  def rp-chunk-trailers(link, body) {
   let line = rp-until(link, "\r\n");
   if nothing?(line) then nothing() else if ((String) line == "\r\n") then body else rp-chunk-trailers(link, body);
  }
  def rp-request(method, path, version, headers, body) = rp-request-framed(method, path, version, "127.0.0.1", headers, body, if (len(body) > 0) then len(body).str() else "");
  def rp-request-framed(method, path, version, host, headers, body, declared) = rp-cat([method, " ", path, " HTTP/", version, "\r\nHost: ", host, "\r\n", headers, if (len(declared) > 0) then rp-cat(["Content-Length: ", declared, "\r\n"]) else "", "\r\n", body]);
  def rp-get(path) = rp-request("GET", path, "1.1", "Connection: close\r\n", "");
  def rp-exchange(link, request) = if ((Comparable) rp-send(link, request) == len(request)) then rp-response(link) else nothing();
  def rp-fetch(port, request) {
   let link = rp-open(port);
   let row = rp-exchange(link, request);
   rp-close(link);
   row;
  }
  def rp-body(row) = if nothing?(row) then "" else row[2];
  def rp-code(row) = if nothing?(row) then -1 else row[0];
  def rp-h(row, name) = if nothing?(row) then "" else rp-header(row[1], name);
  def rp-answer(row, status, body, router) = rp-all([((Comparable) rp-code(row) == status), ((String) rp-body(row) == body), ((String) rp-h(row, "x-form-router") == router)]);
  def rp-free-port() {
   let listener = socket_listen(0);
   if (nothing?(listener) || (listener <= 0)) then form_error("native proof port admission refused") else 0;
   let port = socket_port(listener);
   let released = socket_close(listener);
   if (!((Comparable) released == 0)) then form_error("native proof port release refused") else 0;
   port;
  }
  def rp-wait-file(path, deadline) = if (file_size(path) > 0) then 1 else if (host_monotonic_ms() >= deadline) then 0 else rp-wait-file-pause(path, deadline);
  def rp-wait-file-pause(path, deadline) {
   host_sleep_ms(10);
   rp-wait-file(path, deadline);
  }
  def rp-owner(job) = record_new(0, "job", job, "children", [], "released", [], "rows", [], "failed", 0, "started", 0);
  def rp-spawn(owner, name, argv, input) {
   let job = record_get(owner, "job");
   let pid = host_spawn_at(argv, [input, rp-path(job, (name + ".out")), rp-path(job, (name + ".err"))]);
   if (nothing?(pid) || (pid <= 0)) then form_error("native routing child admission refused") else 0;
   record_set(owner, "children", cons([name, pid], record_get(owner, "children")));
   record_set(owner, "started", (record_get(owner, "started") + 1));
   write_file(rp-path(job, (name + ".pid")), pid.str());
   pid;
  }
  def rp-stop(pid) {
   if (nothing?(pid) || (pid <= 0)) then -1 else rp-stop-owned(pid);
  }
  def rp-stop-owned(pid) {
   let requested = if ((Comparable) host_alive(pid) == 1) then host_kill(pid) else 0;
   rp-stop-wait(pid, (host_monotonic_ms() + 2000), requested);
  }
  def rp-stop-wait(pid, deadline, requested) = if (!fhn-alive(pid)) then host_wait(pid) else if (host_monotonic_ms() >= deadline) then rp-stop-force(pid) else rp-stop-pause(pid, deadline, requested);
  def rp-stop-pause(pid, deadline, requested) {
   host_sleep_ms(10);
   rp-stop-wait(pid, deadline, requested);
  }
  def rp-stop-force(pid) {
   let signal = host_spawn_quiet(["/bin/kill", "-KILL", pid.str()]);
   host_wait(signal);
   host_wait(pid);
  }
  def rp-stop-all(children) = if nil?(children) then [] else cons([children[0][0], children[0][1], rp-stop(children[0][1]), host_alive(children[0][1])], rp-stop-all(children[1:]));
  def rp-child-name(children, pid) = if nil?(children) then "unowned" else if ((Comparable) children[0][1] == pid) then children[0][0] else rp-child-name(children[1:], pid);
  def rp-without-child(children, pid) = if nil?(children) then [] else if ((Comparable) children[0][1] == pid) then rp-without-child(children[1:], pid) else cons(children[0], rp-without-child(children[1:], pid));
  def rp-release(owner, pid) {
   let children = record_get(owner, "children");
   let name = rp-child-name(children, pid);
   let result = if ((String) name == "unowned") then -1 else rp-stop(pid);
   let alive = host_alive(pid);
   record_set(owner, "released", cons([name, pid, result, alive], record_get(owner, "released")));
   if ((Comparable) alive == 0) then record_set(owner, "children", rp-without-child(children, pid)) else 0;
   result;
  }
  def rp-resource-rows(rows) = if nil?(rows) then [] else cons(json-node-object([fhn-s("child", rows[0][0]), fhn-n("pid", rows[0][1]), fhn-n("wait_status", rows[0][2]), fhn-n("alive_after_wait", rows[0][3])]), rp-resource-rows(rows[1:]));
  def rp-resources-closed(rows) = if nil?(rows) then 1 else (((Comparable) rows[0][3] == 0) && ((rows[0][2] >= 0) && rp-resources-closed(rows[1:])));
  def rp-check(owner, aspect, expected, observed, accepted) {
   let row = oh-reading("router-native-proof", record_get(owner, "job"), aspect, expected, observed, json-node-int(accepted), if accepted then [] else [oh-need("local-route-evidence", json-node-null())], if accepted then [] else ["request-evidence", "retain"], json-node-null());
   oh-voice(row);
   record_set(owner, "rows", cons(row, record_get(owner, "rows")));
   if accepted then 0 else rp-retain-pain(owner, row);
   accepted;
  }
  def rp-retain-pain(owner, row) {
   record_set(owner, "failed", (record_get(owner, "failed") + 1));
   oh-voice(oh-response(row, "request-evidence"));
   let path = rp-path(record_get(owner, "job"), "attention.json");
   let text = json-emit-precise(row);
   let wrote = write_file(path, text);
   let retained = (((Comparable) wrote == len(text)) && ((String) rp-text(path) == text));
   oh-voice(oh-applied(row, "request-evidence", json-node-object([fhn-s("path", path), fhn-n("retained", retained)])));
   retained;
  }
 }
 0;
}
