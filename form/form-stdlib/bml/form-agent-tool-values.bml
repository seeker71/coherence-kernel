// Resident coding-tool values. No acquisition or persistence occurs here.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
section [form.bml] {
    class FormAgentToolValues {
        field FatSchema = "form-agent-tool-result-v1";
        field FatMaxBytes = 1048576;
        field FatMaxDocuments = 512;
        field FatMaxArguments = 128;
        field FatMaxSortItems = 1024;
        field FatMaxPattern = 256;
        field FatMatchFuel = 50000;

        // Result: schema, exit, stdout, stderr, next resident documents, crossings.
        // Documents use zg's (identity, source lens, held text) value contract.
        def fat-result(code, out, err, docs) = list(FatSchema(), code, out, err, docs, 0);
        def fat-exit(r) = r[1];
        def fat-out(r) = r[2];
        def fat-error(r) = r[3];
        def fat-documents(r) = r[4];
        def fat-crossings(r) = r[5];
        def fat-ok(out, docs) = fat-result(0, out, "", docs);
        def fat-fail(reason, docs) = fat-result(2, "", reason, docs);
        def fat-reverse-go(xs, out) = nil?(xs) ? out : fat-reverse-go(tail(xs), cons(head(xs), out));
        def fat-reverse(xs) = fat-reverse-go(xs, list());
        def fat-join(xs, sep) = nil?(xs) ? "" : nil?(tail(xs)) ? head(xs) : head(xs) ++ sep ++ fat-join(tail(xs), sep);
        def fat-has(xs, s) = nil?(xs) ? 0 : (String) head(xs) == s ? 1 : fat-has(tail(xs), s);
        def fat-drop(xs, n) = (n <= 0) || nil?(xs) ? xs : fat-drop(tail(xs), n - 1);
        def fat-take(xs, n) = (n <= 0) || nil?(xs) ? list() : cons(head(xs), fat-take(tail(xs), n - 1));
        def fat-min(a, b) = a < b ? a : b;
        def fat-max(a, b) = a > b ? a : b;
        def fat-char(s, i) = (i < 0) || (i >= str_len(s)) ? 0 : str_byte_at(s, i);
        def fat-ws(c) = ((Comparable) c == 32) || (((Comparable) c == 9) || (((Comparable) c == 10) || ((Comparable) c == 13)));
        def fat-skip(s, i) = (i < str_len(s)) && fat-ws(fat-char(s, i)) ? fat-skip(s, i + 1) : i;
        def fat-rtrim(s, n) = (n > 0) && fat-ws(fat-char(s, n - 1)) ? fat-rtrim(s, n - 1) : n;
        def fat-trim(s) = substring(s, fat-skip(s, 0), fat-rtrim(s, str_len(s)));
        def fat-digit(c) = (c >= 48) && (c <= 57);
        def fat-natural-go(s, i) = i >= str_len(s) ? 1 : fat-digit(fat-char(s, i)) ? fat-natural-go(s, i + 1) : 0;
        def fat-natural(s) = (str_len(s) > 0) && fat-natural-go(s, 0);
        def fat-starts(s, prefix) = str_len(s) < str_len(prefix) ? 0 : ((String) substring(s, 0, str_len(prefix)) == prefix);
        def fat-ends(s, suffix) = str_len(s) < str_len(suffix) ? 0 : ((String) substring(s, str_len(s) - str_len(suffix), str_len(s)) == suffix);
        def fat-strip(s, n) = substring(s, n, str_len(s) - n);
        def fat-find-doc(docs, path) = nil?(docs) ? list() : ((String) head(docs)[0] == path) || ((String) head(docs)[1] == path) ? head(docs) : fat-find-doc(tail(docs), path);
        def fat-put-doc(docs, doc) = nil?(docs) ? list(doc) : (String) head(docs)[1] == doc[1] ? cons(doc, tail(docs)) : cons(head(docs), fat-put-doc(tail(docs), doc));
        // Empty concatenation preserves a string value, not a number/list.
        def fat-text?(s) = (Value) s == ("" ++ s);
        def fat-text-bytes(xs, total) = nil?(xs) ? total : !fat-text?(head(xs)) ? (FatMaxBytes() + 1) : fat-text-bytes(tail(xs), total + str_len(head(xs)));
        def fat-doc-bytes(docs, total) = nil?(docs) ? total : !((Comparable) len(head(docs)) == 3) ? (FatMaxBytes() + 1) : fat-doc-bytes(tail(docs), fat-text-bytes(head(docs), total));
        def fat-docs-valid(docs, seen) = nil?(docs) ? 1 : !((Comparable) len(head(docs)) == 3) ? 0 : fat-doc-valid(head(docs), tail(docs), seen);
        def fat-doc-valid(doc, rest, seen) = !(fat-text?(doc[0]) && (fat-text?(doc[1]) && fat-text?(doc[2]))) ? 0 : ((Comparable) str_len(doc[0]) == 0) || ((Comparable) str_len(doc[1]) == 0) ? 0 : fat-has(seen, doc[0]) || fat-has(seen, doc[1]) ? 0 : fat-docs-valid(rest, cons(doc[0], cons(doc[1], seen)));

        // Quoted argv only: no shell expansion, redirection, pipelines or execution.
        // Typed in-process callers skip this convenience spelling entirely.
        def fat-argv(s) = fat-argv-go(s, 0, 0, "", 0, list());
        def fat-argv-go(s, i, quote, word, active, out) = i >= str_len(s) ? (!((Comparable) quote == 0) ? list(list(), "unterminated-quote") : list(fat-reverse(active ? cons(word, out) : out), "")) : fat-argv-step(s, i, quote, word, active, out);
        def fat-argv-step(s, i, quote, word, active, out) {
            let c = fat-char(s, i);
            (!((Comparable) quote == 0)) && ((Comparable) c == quote) ? fat-argv-go(s, i + 1, 0, word, 1, out)
            : ((Comparable) quote == 0) && (((Comparable) c == 34) || ((Comparable) c == 39)) ? fat-argv-go(s, i + 1, c, word, 1, out)
            : ((Comparable) quote == 0) && fat-ws(c) ? fat-argv-go(s, i + 1, 0, "", 0, active ? cons(word, out) : out)
            : ((Comparable) quote == 0) && (((Comparable) c == 124) || (((Comparable) c == 59) || (((Comparable) c == 60) || ((Comparable) c == 62)))) ? list(list(), "shell-syntax-not-supported")
            : (!((Comparable) quote == 39)) && ((Comparable) c == 92) ? fat-argv-escape(s, i, quote, word, out)
            : fat-argv-go(s, i + 1, quote, word ++ byte_to_str(c), 1, out);
        }
        def fat-argv-escape(s, i, quote, word, out) = (i + 1) >= str_len(s) ? list(list(), "trailing-escape") : ((Comparable) quote == 0) || (((Comparable) fat-char(s, i + 1) == 34) || ((Comparable) fat-char(s, i + 1) == 92)) ? fat-argv-go(s, i + 2, quote, word ++ byte_to_str(fat-char(s, i + 1)), 1, out) : fat-argv-go(s, i + 1, quote, word ++ byte_to_str(92), 1, out);

        // Split a query only outside strings and nested brackets/parentheses.
        def fat-split-top(s, sep) = fat-split-go(s, sep, 0, 0, 0, 0, 0, list());
        def fat-split-go(s, sep, i, start, depth, quote, escape, out) = i >= str_len(s) ? ((!((Comparable) depth == 0)) || quote ? list(list(), "unbalanced-query") : list(fat-reverse(cons(fat-trim(substring(s, start, i)), out)), "")) : fat-split-step(s, sep, i, start, depth, quote, escape, out);
        def fat-split-step(s, sep, i, start, depth, quote, escape, out) {
            let c = fat-char(s, i);
            quote ? fat-split-go(s, sep, i + 1, start, depth, ((Comparable) c == 34) && (!escape) ? 0 : 1, ((Comparable) c == 92) && (!escape) ? 1 : 0, out)
            : (Comparable) c == 34 ? fat-split-go(s, sep, i + 1, start, depth, 1, 0, out)
            : ((Comparable) c == 40) || (((Comparable) c == 91) || ((Comparable) c == 123)) ? fat-split-go(s, sep, i + 1, start, depth + 1, 0, 0, out)
            : ((Comparable) c == 41) || (((Comparable) c == 93) || ((Comparable) c == 125)) ? (depth <= 0 ? list(list(), "unbalanced-query") : fat-split-go(s, sep, i + 1, start, depth - 1, 0, 0, out))
            : ((Comparable) depth == 0) && ((String) substring(s, i, fat-min(str_len(s), i + str_len(sep))) == sep) ? fat-split-go(s, sep, i + str_len(sep), i + str_len(sep), 0, 0, 0, cons(fat-trim(substring(s, start, i)), out))
            : fat-split-go(s, sep, i + 1, start, depth, 0, 0, out);
        }
    }
}
