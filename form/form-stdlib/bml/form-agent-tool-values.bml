// Resident coding-tool values. No acquisition or persistence occurs here.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/bml/string-join.bml
section [form.bml] {
    class FormAgentToolValues {
        field FatSchema = "form-agent-tool-result-v1";
        field FatMaxBytes = 1048576;
        field FatMaxDocuments = 512;
        field FatMaxArguments = 128;
        field FatMaxSortItems = 1024;
        field FatMaxPattern = 256;
        field FatMatchFuel = 50000;

        // Result: schema, exit, stdout, stderr, next resident documents, crossings.
        // Documents use zg's (identity, source lens, held text) value contract.
        def fat-result(code, out, err, docs) = [FatSchema(), code, out, err, docs, 0];
        def fat-exit(r) = r[1];
        def fat-out(r) = r[2];
        def fat-error(r) = r[3];
        def fat-documents(r) = r[4];
        def fat-crossings(r) = r[5];
        def fat-ok(out, docs) = fat-result(0, out, "", docs);
        def fat-fail(reason, docs) = fat-result(2, "", reason, docs);
        def fat-reverse(xs) = reverse(xs);
        def fat-join(xs, sep) = str-join-with(xs, sep);
        def fat-has(xs, s) = any?((item: String) => item == s, xs);
        def fat-drop(xs, n) = drop(n, xs);
        def fat-take(xs, n) = take(n, xs);
        def fat-min(a, b) = min2(a, b);
        def fat-max(a, b) = max2(a, b);
        def fat-char(s, i) = if ((i < 0) || (i >= str_len(s))) then 0 else str_byte_at(s, i);
        def fat-ws(c) = (((Comparable) c == 32) || (((Comparable) c == 9) || (((Comparable) c == 10) || ((Comparable) c == 13))));
        def fat-skip(s, i) = if ((i < str_len(s)) && fat-ws(fat-char(s, i))) then fat-skip(s, (i + 1)) else i;
        def fat-rtrim(s, n) = if ((n > 0) && fat-ws(fat-char(s, (n - 1)))) then fat-rtrim(s, (n - 1)) else n;
        def fat-trim(s) = substring(s, fat-skip(s, 0), fat-rtrim(s, str_len(s)));
        def fat-digit(c) = ((c >= 48) && (c <= 57));
        def fat-natural-go(s, i) = if (i >= str_len(s)) then 1 else if fat-digit(fat-char(s, i)) then fat-natural-go(s, (i + 1)) else 0;
        def fat-natural(s) = ((str_len(s) > 0) && fat-natural-go(s, 0));
        def fat-starts(s, prefix) = if (str_len(s) < str_len(prefix)) then 0 else ((String) substring(s, 0, str_len(prefix)) == prefix);
        def fat-ends(s, suffix) = if (str_len(s) < str_len(suffix)) then 0 else ((String) substring(s, (str_len(s) - str_len(suffix)), str_len(s)) == suffix);
        def fat-strip(s, n) = substring(s, n, (str_len(s) - n));
        def fat-find-doc(docs, path) = if nil?(docs) then [] else if (((String) head(docs)[0] == path) || ((String) head(docs)[1] == path)) then head(docs) else fat-find-doc(tail(docs), path);
        def fat-put-doc(docs, doc) = if nil?(docs) then [doc] else if ((String) head(docs)[1] == doc[1]) then cons(doc, tail(docs)) else cons(head(docs), fat-put-doc(tail(docs), doc));
        // Empty concatenation preserves a string value, not a number/list.
        def fat-text?(s) = ((Value) s == str_concat("", s));
        def fat-text-bytes(xs, total) = if nil?(xs) then total else if (!fat-text?(head(xs))) then (FatMaxBytes() + 1) else fat-text-bytes(tail(xs), (total + str_len(head(xs))));
        def fat-doc-bytes(docs, total) = if nil?(docs) then total else if (!((Comparable) len(head(docs)) == 3)) then (FatMaxBytes() + 1) else fat-doc-bytes(tail(docs), fat-text-bytes(head(docs), total));
        def fat-docs-valid(docs, seen) = if nil?(docs) then 1 else if (!((Comparable) len(head(docs)) == 3)) then 0 else fat-doc-valid(head(docs), tail(docs), seen);
        def fat-doc-valid(doc, rest, seen) = if (!(fat-text?(doc[0]) && (fat-text?(doc[1]) && fat-text?(doc[2])))) then 0 else if (((Comparable) str_len(doc[0]) == 0) || ((Comparable) str_len(doc[1]) == 0)) then 0 else if (fat-has(seen, doc[0]) || fat-has(seen, doc[1])) then 0 else fat-docs-valid(rest, cons(doc[0], cons(doc[1], seen)));

        // Quoted argv only: no shell expansion, redirection, pipelines or execution.
        // Typed in-process callers skip this convenience spelling entirely.
        def fat-argv(s) = fat-argv-go(s, 0, 0, "", 0, []);
        def fat-argv-go(s, i, quote, word, active, out) = if (i >= str_len(s)) then if (!((Comparable) quote == 0)) then [[], "unterminated-quote"] else [fat-reverse(if active then cons(word, out) else out), ""] else fat-argv-step(s, i, quote, word, active, out);
        def fat-argv-step(s, i, quote, word, active, out) {
            let c = fat-char(s, i);
            if ((!((Comparable) quote == 0)) && ((Comparable) c == quote)) then fat-argv-go(s, (i + 1), 0, word, 1, out)
            else if (((Comparable) quote == 0) && (((Comparable) c == 34) || ((Comparable) c == 39))) then fat-argv-go(s, (i + 1), c, word, 1, out)
            else if (((Comparable) quote == 0) && fat-ws(c)) then fat-argv-go(s, (i + 1), 0, "", 0, if active then cons(word, out) else out)
            else if (((Comparable) quote == 0) && (((Comparable) c == 124) || (((Comparable) c == 59) || (((Comparable) c == 60) || ((Comparable) c == 62))))) then [[], "shell-syntax-not-supported"]
            else if ((!((Comparable) quote == 39)) && ((Comparable) c == 92)) then fat-argv-escape(s, i, quote, word, out)
            else fat-argv-go(s, (i + 1), quote, str_concat(word, byte_to_str(c)), 1, out);
        }
        def fat-argv-escape(s, i, quote, word, out) = if ((i + 1) >= str_len(s)) then [[], "trailing-escape"] else if (((Comparable) quote == 0) || (((Comparable) fat-char(s, (i + 1)) == 34) || ((Comparable) fat-char(s, (i + 1)) == 92))) then fat-argv-go(s, (i + 2), quote, str_concat(word, byte_to_str(fat-char(s, (i + 1)))), 1, out) else fat-argv-go(s, (i + 1), quote, str_concat(word, byte_to_str(92)), 1, out);

        // Split a query only outside strings and nested brackets/parentheses.
        def fat-split-top(s, sep) = fat-split-go(s, sep, 0, 0, 0, 0, 0, []);
        def fat-split-go(s, sep, i, start, depth, quote, escape, out) = if (i >= str_len(s)) then if ((!((Comparable) depth == 0)) || quote) then [[], "unbalanced-query"] else [fat-reverse(cons(fat-trim(substring(s, start, i)), out)), ""] else fat-split-step(s, sep, i, start, depth, quote, escape, out);
        def fat-split-step(s, sep, i, start, depth, quote, escape, out) {
            let c = fat-char(s, i);
            if quote then fat-split-go(s, sep, (i + 1), start, depth, if (((Comparable) c == 34) && (!escape)) then 0 else 1, if (((Comparable) c == 92) && (!escape)) then 1 else 0, out)
            else if ((Comparable) c == 34) then fat-split-go(s, sep, (i + 1), start, depth, 1, 0, out)
            else if (((Comparable) c == 40) || (((Comparable) c == 91) || ((Comparable) c == 123))) then fat-split-go(s, sep, (i + 1), start, (depth + 1), 0, 0, out)
            else if (((Comparable) c == 41) || (((Comparable) c == 93) || ((Comparable) c == 125))) then if (depth <= 0) then [[], "unbalanced-query"] else fat-split-go(s, sep, (i + 1), start, (depth - 1), 0, 0, out)
            else if (((Comparable) depth == 0) && ((String) substring(s, i, fat-min(str_len(s), (i + str_len(sep)))) == sep)) then fat-split-go(s, sep, (i + str_len(sep)), (i + str_len(sep)), 0, 0, 0, cons(fat-trim(substring(s, start, i)), out))
            else fat-split-go(s, sep, (i + 1), start, depth, 0, 0, out);
        }
    }
}
