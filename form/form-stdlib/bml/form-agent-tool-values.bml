// Resident coding-tool values. No acquisition or persistence occurs here.
import form-stdlib/core.fk;
import form-stdlib/json.fk;
import form-stdlib/line-grammar.fk;
import form-stdlib/bml/string-join.bml;
section [form.bml] {
    class FormAgentToolValues {
        field FatSchema = "form-agent-tool-result-v1";
        field FatMaxBytes = 1048576;
        field FatMaxSortItems = 1024;

        // Result: schema, exit, output, stderr, resident documents, crossings,
        // optional value. Output is text or [nodes, raw-strings, ending]. Native
        // callers keep the nodes; fat-out renders only a requested text view.
        // Documents use zg's (identity, source lens, held text) value contract.
        def fat-result(code, out, err, docs) = [FatSchema(), code, out, err, docs, 0];
        def fat-exit(r) = r[1];
        def fat-out(r) = fat-text?(r[2]) ? r[2] : {
            let started = host_monotonic_ms(); let view = r[2];
            let text = nil?(view[0]) ? "" : fat-join(view[0] |> map(node => view[1] && node_type(node) == 2 ? node_value(node) : json-emit(node)), "\n") + view[2];
            fb_record(intern_node(intern_trivial_string("tool-text-view"), [intern_trivial_int(host_monotonic_ms() - started), intern_trivial_int(len(text)), intern_trivial_int(len(view[0]))]), "form-agent-tool-values.bml", 18);
            text;
        };
        def fat-error(r) = r[3];
        def fat-documents(r) = r[4];
        def fat-crossings(r) = r[5];
        def fat-has-value?(r) = (Comparable) len(r) > 6;
        def fat-value(r) = r[6];
        def fat-with-value(r, node) = append(r, [node]);
        def fat-ok(out, docs) = fat-result(0, out, "", docs);
        def fat-fail(reason, docs) = fat-result(2, "", reason, docs);
        def fat-reverse(xs) = reverse(xs);
        def fat-join(xs, sep) = str-join-with(xs, sep);
        def fat-has(xs, s) = any?((item: String) => item == s, xs);
        def fat-drop(xs, n) = drop(n, xs);
        def fat-take(xs, n) = take(n, xs);
        def fat-min(a, b) = min2(a, b);
        def fat-max(a, b) = max2(a, b);
        def fat-char(s, i) = if ((i < 0) || (i >= len(s))) then 0 else str_byte_at(s, i);
        def fat-ws(c) = (((Comparable) c == 32) || (((Comparable) c == 9) || (((Comparable) c == 10) || ((Comparable) c == 13))));
        def fat-skip(s, i) = if ((i < len(s)) && fat-ws(fat-char(s, i))) then fat-skip(s, (i + 1)) else i;
        def fat-rtrim(s, n) = if ((n > 0) && fat-ws(fat-char(s, (n - 1)))) then fat-rtrim(s, (n - 1)) else n;
        def fat-trim(s) = substring(s, fat-skip(s, 0), fat-rtrim(s, len(s)));
        def fat-digit(c) = ((c >= 48) && (c <= 57));
        def fat-natural-go(s, i) = if (i >= len(s)) then 1 else if fat-digit(fat-char(s, i)) then fat-natural-go(s, (i + 1)) else 0;
        def fat-natural(s) = ((len(s) > 0) && fat-natural-go(s, 0));
        def fat-starts(s, prefix) = if (len(s) < len(prefix)) then 0 else ((String) substring(s, 0, len(prefix)) == prefix);
        def fat-ends(s, suffix) = if (len(s) < len(suffix)) then 0 else ((String) substring(s, (len(s) - len(suffix)), len(s)) == suffix);
        def fat-strip(s, n) = substring(s, n, (len(s) - n));
        def fat-find-doc(docs, path) = if nil?(docs) then [] else if (((String) docs[0][0] == path) || ((String) docs[0][1] == path)) then docs[0] else fat-find-doc(docs[1:], path);
        def fat-put-doc(docs, doc) = if nil?(docs) then [doc] else if ((String) docs[0][1] == doc[1]) then cons(doc, docs[1:]) else cons(docs[0], fat-put-doc(docs[1:], doc));
        def fat-text?(s) = (String) value_kind(s) == "string";
        def fat-output?(out) = fat-text?(out) || ((String) value_kind(out) == "list" && len(out) == 3 && (String) value_kind(out[0]) == "list" && all?(node => (String) value_kind(node) == "node_id", out[0]) && (out[1] == 0 || out[1] == 1) && fat-text?(out[2]));
        def fat-docs-valid(docs, seen) = if nil?(docs) then 1 else if (!((Comparable) len(docs[0]) == 3)) then 0 else fat-doc-valid(docs[0], docs[1:], seen);
        def fat-doc-valid(doc, rest, seen) = if (!(fat-text?(doc[0]) && (fat-text?(doc[1]) && fat-text?(doc[2])))) then 0 else if (((Comparable) len(doc[0]) == 0) || ((Comparable) len(doc[1]) == 0)) then 0 else if (fat-has(seen, doc[0]) || fat-has(seen, doc[1])) then 0 else fat-docs-valid(rest, cons(doc[0], cons(doc[1], seen)));

        // Quoted argv only: no shell expansion, redirection, pipelines or execution.
        // Typed in-process callers skip this convenience spelling entirely.
        def fat-argv(s) = fat-argv-go(s, 0, 0, "", 0, []);
        def fat-argv-go(s, i, quote, word, active, out) = if (i >= len(s)) then if (!((Comparable) quote == 0)) then [[], "unterminated-quote"] else [fat-reverse(if active then cons(word, out) else out), ""] else fat-argv-step(s, i, quote, word, active, out);
        def fat-argv-step(s, i, quote, word, active, out) {
            let c = fat-char(s, i);
            if ((!((Comparable) quote == 0)) && ((Comparable) c == quote)) then fat-argv-go(s, (i + 1), 0, word, 1, out)
            else if (((Comparable) quote == 0) && (((Comparable) c == 34) || ((Comparable) c == 39))) then fat-argv-go(s, (i + 1), c, word, 1, out)
            else if (((Comparable) quote == 0) && fat-ws(c)) then fat-argv-go(s, (i + 1), 0, "", 0, if active then cons(word, out) else out)
            else if (((Comparable) quote == 0) && (((Comparable) c == 124) || (((Comparable) c == 59) || (((Comparable) c == 60) || ((Comparable) c == 62))))) then [[], "shell-syntax-not-supported"]
            else if ((!((Comparable) quote == 39)) && ((Comparable) c == 92)) then fat-argv-escape(s, i, quote, word, out)
            else fat-argv-go(s, (i + 1), quote, ((String) word + byte_to_str(c)), 1, out);
        }
        def fat-argv-escape(s, i, quote, word, out) = if ((i + 1) >= len(s)) then [[], "trailing-escape"] else if (((Comparable) quote == 0) || (((Comparable) fat-char(s, (i + 1)) == 34) || ((Comparable) fat-char(s, (i + 1)) == 92))) then fat-argv-go(s, (i + 2), quote, ((String) word + byte_to_str(fat-char(s, (i + 1)))), 1, out) else fat-argv-go(s, (i + 1), quote, ((String) word + byte_to_str(92)), 1, out);

        // Split a query only outside strings and nested brackets/parentheses.
        def fat-split-top(s, sep) = fat-split-go(s, sep, 0, 0, 0, 0, 0, []);
        def fat-split-go(s, sep, i, start, depth, quote, escape, out) = if (i >= len(s)) then if ((!((Comparable) depth == 0)) || quote) then [[], "unbalanced-query"] else [fat-reverse(cons(fat-trim(substring(s, start, i)), out)), ""] else fat-split-step(s, sep, i, start, depth, quote, escape, out);
        def fat-split-step(s, sep, i, start, depth, quote, escape, out) {
            let c = fat-char(s, i);
            if quote then fat-split-go(s, sep, (i + 1), start, depth, if (((Comparable) c == 34) && (!escape)) then 0 else 1, if (((Comparable) c == 92) && (!escape)) then 1 else 0, out)
            else if ((Comparable) c == 34) then fat-split-go(s, sep, (i + 1), start, depth, 1, 0, out)
            else if (((Comparable) c == 40) || (((Comparable) c == 91) || ((Comparable) c == 123))) then fat-split-go(s, sep, (i + 1), start, (depth + 1), 0, 0, out)
            else if (((Comparable) c == 41) || (((Comparable) c == 93) || ((Comparable) c == 125))) then if (depth <= 0) then [[], "unbalanced-query"] else fat-split-go(s, sep, (i + 1), start, (depth - 1), 0, 0, out)
            else if (((Comparable) depth == 0) && ((String) substring(s, i, fat-min(len(s), (i + len(sep)))) == sep)) then fat-split-go(s, sep, (i + len(sep)), (i + len(sep)), 0, 0, 0, cons(fat-trim(substring(s, start, i)), out))
            else fat-split-go(s, sep, (i + 1), start, depth, 0, 0, out);
        }
    }
}
