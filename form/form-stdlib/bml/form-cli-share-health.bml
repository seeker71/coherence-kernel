//////////////////////////////////////////////////////////////////////
//
// form-cli-share-health.bml — typed health for a measured share.
//
// An open percentage is attention, not a withheld report.  Binding absence,
// bounded collection in motion, and a candidate that failed reconciliation
// have different repairs.  This authority names them without emitting rollout
// content; zero remains a measured value inside an observed evidence row.
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-turn-evidence-live.fk

section [form.bml] {
    class FormCliShareHealth {
        field Rule = "absent-measuring-error-and-observed-are-distinct-share-states";
        field MeasuringReason = "selected-turn-not-fully-traversed";

        def fcsh-rule() = Rule();
        def fcsh-measuring-reason() = MeasuringReason();
        def fcsh-join(parts) = if ((Comparable) len(parts) == 0) then "" else str_concat(head(parts), fcsh-join(tail(parts)));

        def fcsh-checks(e) {
            fcsh-join(list(
                " identity=", int_to_str(fcte-identity?(e)),
                " time=", int_to_str(fcte-time-valid?(e)),
                " tokens=", int_to_str(fcte-token-valid?(e)),
                " tools=", int_to_str(fcte-tool-valid?(e)),
                " form=", int_to_str(fcte-form-valid?(e)),
                " lanes=", int_to_str(fcte-lanes-valid?(e)),
                " source=", int_to_str(fcte-source-ok?(e)),
                " complete=", int_to_str(((Comparable) fcte-complete(e) == 1))));
        }

        def fcsh-candidate(row) {
            let evidence = fcte-parse(row);
            if ((Comparable) fcte-shape?(evidence) == 0) then
                "measurement-health=Error stage=reconcile shape=0 attention=heal\n"
            else if (fcte-tool-output-bytes(evidence) < 0) then
                "measurement-health=Error stage=tool-output reason=unsupported-output-shape attention=heal\n"
            else if ((Comparable) fcte-numeric-fields-loop?(evidence, 5) == 0) then
                "measurement-health=Error stage=reconcile shape=1 numeric=0 attention=heal\n"
            else
                fcsh-join(list("measurement-health=Error stage=reconcile shape=1 numeric=1",
                    fcsh-checks(evidence), " attention=heal\n"));
        }

        def fcsh-progress(parts, stream_bytes) {
            if (((Comparable) len(parts) == 28) && ((String) nth(parts, 0) == fctel-progress-tag())) then
                fcsh-join(list(
                    "measurement-health=Measuring phase=collecting turn=", nth(parts, 2),
                    " cursor-byte=", nth(parts, 5),
                    " stream-bytes=", int_to_str(stream_bytes),
                    " attention=heal reason=", fcsh-measuring-reason(), "\n"))
            else
                "measurement-health=Error stage=progress-row shape=invalid attention=heal\n";
        }

        def fcsh-discovery(parts) {
            if (((Comparable) len(parts) == 5) && ((String) nth(parts, 0) == "turn-evidence-discovery-v2")) then
                fcsh-join(list(
                    "measurement-health=Measuring phase=discovering cursor-byte=", nth(parts, 2),
                    " stream-bytes=", nth(parts, 1),
                    " attention=heal reason=no-completed-turn-coordinate-yet\n"))
            else
                "measurement-health=Error stage=discovery-row shape=invalid attention=heal\n";
        }

        def fcsh-start-discovery(parts) {
            if (((Comparable) len(parts) == 8) && ((String) nth(parts, 0) == "turn-evidence-start-discovery-v1")) then
                fcsh-join(list(
                    "measurement-health=Measuring phase=locating-start turn=", nth(parts, 2),
                    " cursor-byte=", nth(parts, 4),
                    " complete-byte=", nth(parts, 3),
                    " stream-bytes=", nth(parts, 1),
                    " attention=heal reason=task-start-coordinate-not-yet-reached\n"))
            else
                "measurement-health=Error stage=start-discovery-row shape=invalid attention=heal\n";
        }

        def fcsh-validation-shape?(parts) = if (((Comparable) len(parts) == 10) && ((String) nth(parts, 0) == "turn-evidence-latest-validation-v2")) then 1 else if (((Comparable) len(parts) == 9) && ((String) nth(parts, 0) == "turn-evidence-latest-validation-v1")) then 1 else 0;
        def fcsh-validation-floor(parts) = if ((Comparable) len(parts) == 10) then str_to_int(nth(parts, 9)) else str_to_int(nth(parts, 3));
        def fcsh-validation-append-bytes(parts) = (str_to_int(nth(parts, 5)) - str_to_int(nth(parts, 3)));
        def fcsh-validation-checked-bytes(parts) = ((fcsh-validation-floor(parts) - str_to_int(nth(parts, 3))) + (str_to_int(nth(parts, 5)) - str_to_int(nth(parts, 6))));
        def fcsh-validation-remaining-bytes(parts) = (str_to_int(nth(parts, 6)) - fcsh-validation-floor(parts));

        def fcsh-validation(parts) {
            if ((Comparable) fcsh-validation-shape?(parts) == 1) then
                fcsh-join(list(
                    "measurement-health=Measuring phase=validating-latest turn=", nth(parts, 2),
                    " cursor-byte=", nth(parts, 6),
                    " checked-floor-byte=", int_to_str(fcsh-validation-floor(parts)),
                    " observed-carrier-bytes=", nth(parts, 3),
                    " stream-bytes=", nth(parts, 5),
                    " append-bytes=", int_to_str(fcsh-validation-append-bytes(parts)),
                    " checked-bytes=", int_to_str(fcsh-validation-checked-bytes(parts)),
                    " remaining-bytes=", int_to_str(fcsh-validation-remaining-bytes(parts)),
                    " attention=heal reason=append-range-not-fully-checked\n"))
            else
                "measurement-health=Error stage=latest-validation-row shape=invalid attention=heal\n";
        }

        // The collector can finish its internally reconciled row in this
        // invocation, but source/latestness remain the next evidence movement.
        // Name that transition instead of reporting the spool as unavailable.
        def fcsh-after-refresh(refresh) {
            if ((Comparable) str_find(refresh, "turn-evidence-refresh=observed", 0) == 0) then
                "measurement-health=Measuring phase=validating-latest attention=heal reason=append-range-not-yet-checked\n"
            else fcsh-health();
        }

        // Durable movement outranks an old failed candidate.  This pure door
        // makes that precedence directly witnessable without staining the
        // live spool from a band.
        def fcsh-health-state(path, progress, start, validation, discovery, candidate) {
            if (str_len(progress) > 0) then
                fcsh-progress(split-on(fctel-trim-end(progress), "|"), file_size(path))
            else if (str_len(start) > 0) then
                fcsh-start-discovery(split-on(fctel-trim-end(start), "|"))
            else if (str_len(validation) > 0) then
                fcsh-validation(split-on(fctel-trim-end(validation), "|"))
            else if (str_len(discovery) > 0) then
                fcsh-discovery(split-on(fctel-trim-end(discovery), "|"))
            else if (str_len(candidate) > 0) then
                fcsh-candidate(fctel-trim-end(candidate))
            else
                "measurement-health=Unavailable stage=refresh reason=no-completed-evidence-row attention=heal\n";
        }

        // The live door additionally binds precedence to the current carrier.
        // An old start/progress row may remain after interruption or rebind;
        // it is evidence only when its task coordinates and carrier identity
        // still validate.  A stale candidate or stale phase can therefore not
        // conceal a newer, physically valid continuation.
        def fcsh-health-state-reconciled(path, progress, start, validation, discovery, candidate) {
            let size = file_size(path);
            let progressParts = if (str_len(progress) > 0) then split-on(fctel-trim-end(progress), "|") else list();
            let startParts = if (str_len(start) > 0) then split-on(fctel-trim-end(start), "|") else list();
            let discoveryParts = if (str_len(discovery) > 0) then split-on(fctel-trim-end(discovery), "|") else list();
            if ((Comparable) fctel-progress-active?(progressParts, startParts, path, size) == 1) then
                fcsh-progress(progressParts, size)
            else if ((Comparable) fctel-start-discovery-active?(startParts, path, size) == 1) then
                fcsh-start-discovery(startParts)
            else if (str_len(validation) > 0) then
                fcsh-validation(split-on(fctel-trim-end(validation), "|"))
            else if ((str_len(discovery) > 0) && ((Comparable) fctel-discovery-state-valid?(discoveryParts, path, size) == 1)) then
                fcsh-discovery(discoveryParts)
            else if (str_len(candidate) > 0) then
                fcsh-candidate(fctel-trim-end(candidate))
            else if ((str_len(progress) > 0) || ((str_len(start) > 0) || (str_len(discovery) > 0))) then
                "measurement-health=Error stage=phase-state reason=carrier-or-coordinate-mismatch attention=heal\n"
            else
                "measurement-health=Unavailable stage=refresh reason=no-completed-evidence-row attention=heal\n";
        }

        def fcsh-health-bound(path) {
            let progress = if (file_size(fctel-progress-path()) > 0) then read_file(fctel-progress-path()) else "";
            let start = if (file_size(fctel-start-discovery-path()) > 0) then read_file(fctel-start-discovery-path()) else "";
            let validation = if (file_size(fctel-latest-validation-path()) > 0) then read_file(fctel-latest-validation-path()) else "";
            let discovery = if (file_size(fctel-discovery-path()) > 0) then read_file(fctel-discovery-path()) else "";
            let candidate = if (file_size(fctel-candidate-row-path()) > 0) then read_file(fctel-candidate-row-path()) else "";
            fcsh-health-state-reconciled(path, progress, start, validation, discovery, candidate);
        }

        def fcsh-health() {
            let path = fctel-bound-path();
            let grok = if (file_size(".form-cli-turn-grok-session") <= 0) then "" else "bound";
            if (((String) path == "") && ((String) grok == "")) then
                "measurement-health=Absent reason=no-bound-rollout attention=heal\n"
            else if ((String) path == "") then
                "measurement-health=Measuring reason=grok-session-bound attention=heal\n"
            else fcsh-health-bound(path);
        }
    }
    0;
}
