// The BML native compiler's own voice. It speaks only when something is wrong:
// an image withheld for the needs it names, or a run whose answer is a refusal.
// A table admitted and a value answered stay silent. Every reading goes through
// organ-health.bml, and the compiler gets its data back unchanged, so a reading
// never alters a table or a value.
// preludes: form-stdlib/organ-health.bml
section [form.bml] {
 class BmlCompilerHealth {
  def bch-organ() = "bml-native-compiler";
  def bch-flow() = int_to_str(host_pid());
  def bch-where(where) = json-node-object(list(oh-s("where",where)));
  def bch-reading(aspect,expected,observed,needs,offers,where) = oh-reading(bch-organ(),bch-flow(),aspect,json-node-string(expected),json-node-string(observed),json-node-int(0),needs,offers,bch-where(where));
  def bch-needs(resource,reasons) = if nil?(reasons) then list() else cons(oh-need(resource,json-node-string(head(reasons))),bch-needs(resource,tail(reasons)));
  def bch-join(reasons) = if nil?(reasons) then "" else if nil?(tail(reasons)) then head(reasons) else str_concat(head(reasons),str_concat(",",bch-join(tail(reasons))));
  def bch-refused?(text) = if eq(str_find(text,"BML-HATI-UNSUPPORTED",0),-1) then 0 else 1;

  // The organ's own answer to a reading it raised: abstain, withholding the table.
  def bch-abstain(reading,result) {
   let response = oh-response(reading,"abstain");
   let selected = oh-select(reading,response,"request-evidence");
   oh-voice(reading);
   oh-voice(response);
   oh-voice(oh-applied(reading,selected,result));
  }

  // An image with needs against it is withheld in the open, one need per reason.
  def bch-admit(where,reasons) = if nil?(reasons) then reasons else bch-withheld(where,reasons);
  def bch-withheld(where,reasons) {
   bch-abstain(bch-reading("admission","table",str_concat("refused:",bch-join(reasons)),bch-needs("lowering",reasons),list("abstain","request-evidence"),where),json-node-object(list(oh-s("table","withheld"))));
   reasons;
  }

  // A run whose answer is a refusal says so where it ran.
  def bch-ran(where,value) = bch-ran-text(where,value,value_str(value));
  def bch-ran-text(where,value,text) = if eq(bch-refused?(text),0) then value else bch-ran-refused(where,value,text);
  def bch-ran-refused(where,value,text) {
   bch-abstain(bch-reading("run","value",text,list(oh-need("lowering",json-node-string(text))),list("abstain","request-evidence"),where),json-node-object(list(oh-s("value","refused"))));
   value;
  }
 }
 0;
}
