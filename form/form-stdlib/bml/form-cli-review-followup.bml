// One caller-owned follow-up before a native review releases its model.
// preludes: form-stdlib/bml/form-cli-code-live.bml
section [form.bml] {
 class FormCliReviewFollowup {
  // [ordinary outcome, first report, first check count, observation admitted, route]
  def fcrf-next(state,followup,turns) = if (!fcap-reviewing(state)) then "requires-review" else if ((String) fat-trim(followup) == "") then "not-offered" else if (!((String) fcap-stage(state) == "complete")) then "first-review-incomplete" else if (fcap-turns(state) >= turns) then "turn-budget-exhausted" else "continue";
  def fcrf-admit(model,state,checker,context,turns,followup) {
   if (!fcap-reviewing(state)) then list(list(fcap-terminal(state,"followup-requires-review"),1,0,0,0),"",0,0,"requires-review") else if (((String) fcap-stage(state) == "complete") && (!((String) fat-trim(followup) == ""))) then list(list(fcap-terminal(state,"followup-requires-live-first-review;first-report-retained"),1,0,0,0),fcap-report(state),fcap-checks(state),0,"not-admitted") else if fcap-done(state) then list(fcac-admit(model,state,checker,context,turns),fcap-report(state),fcap-checks(state),0,"not-admitted") else if (!fcac-model-ready(model)) then list(list(fcap-terminal(state,"followup-native-model-unavailable"),1,0,0,0),fcap-report(state),fcap-checks(state),0,"not-admitted") else {
    let started = now_unix_ms();
    let begun = fcap-begin-context(state);
    fcrf-resident(fcac-open-budget(model,begun,context,turns),begun,checker,turns,started,followup);
   };
  }
  def fcrf-resident(session,state,checker,turns,started,followup) {
   if (!fcap-reviewing(state)) then list(fcac-settle(list(session,fcap-terminal(state,"followup-requires-review")),started),"",0,0,"requires-review") else {
    let first = fcac-loop(session,state,checker,turns,started);
    let route = fcrf-next(nth(first,1),followup,turns);
    if ((String) route == "continue") then fcrf-continue(first,checker,turns,started,followup) else {
     let held = if ((String) route == "turn-budget-exhausted") then list(head(first),fcap-terminal(nth(first,1),"followup-turn-budget-exhausted;first-report-retained")) else first;
     list(fcac-settle(held,started),fcap-report(nth(first,1)),fcap-checks(nth(first,1)),0,route);
    };
   };
  }
  def fcrf-continue(first,checker,turns,started,followup) {
   let session = head(first);
   let state = nth(first,1);
   let next = fcap-rework(state,str_concat("Caller-owned follow-up after a checked report. The preceding report and source observations remain in this same model context. Preserve the original goal, document boundaries and checks. ",followup));
   let after = fcacs-observe(session,fcac-observation-budget(next,turns));
   let admitted = (fcms-live?(after) && ((Comparable) fcms-observations(after) == (fcms-observations(session) + 1)));
   let outcome = fcac-settle(fcac-observed(session,after,next,checker,turns,started),started);
   list(outcome,fcap-report(state),fcap-checks(state),admitted,"continued");
  }
 }
 0;
}
