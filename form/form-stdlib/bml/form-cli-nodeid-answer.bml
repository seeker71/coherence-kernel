//////////////////////////////////////////////////////////////////////
//
// form-cli-nodeid-answer.bml — high-grammar picture.
//
// An answer is a node-id: blueprint, recipe, or cell. Naming is an
// offer. An ask receives a reply. Offer without ask replies nothing.
// Nested offers scale; one ask at the rim replies through the tree.
// The s-expr organ stays; this picture is the rise.
//
// Executable: form-stdlib/form-cli-nodeid-answer.bml
// Proven by: form-stdlib/tests/form-cli-nodeid-answer-bml-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.nodeidanswer;

import Form.kernel.*;
import Form.cli.flow.*;

enum NodeKind [public] {
   NONE,
   BLUEPRINT,
   RECIPE,
   CELL
}

enum Delay [public] {
   OFFER,
   ASK
}

enum Cost [public] {
   OUTSIDE,
   STREAM
}

interface INodeidAnswer [public, witness, reusable] {
   section [public] {
      const String TrustRule = "naming is an offer; ask replies; offer without ask is nothing; cost stays outside";

      Object Recipe( String op, Object a, Object b ) [abstract];
      Object Ask( Object p ) [abstract];
      Object Reply( Object p ) [abstract];
   }
}

template Pointer<T> [public, reusable] {
   section [public] {
      int Kind() [get];
      int Delay() [get];
      int Cost() [get];
      T Payload() [get];
   }
}

class FormNodeidAnswer [public, reusable, teach] : INodeidAnswer {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-nodeid-answer.bml";
      Object Recipe( String op, Object a, Object b ) [abstract] {}
      Object Ask( Object p ) [abstract] {}
      Object Reply( Object p ) [abstract] {}
   }
}

class FormNodeidAnswerSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-nodeid-answer-self";
      const String Pattern = "offer-ask nested-tree pyramid-scale agree-with-organ";
      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
