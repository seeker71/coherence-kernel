// Form owns snapshot identity, admission and guarded replacement.
// git/tar/cp carry filesystem operations; no interpreter owns repair meaning.
// preludes: form-stdlib/bml/form-cli-heal-policy.bml form-stdlib/json.fk form-stdlib/qwen35-artifact-seal-reader.fk form-stdlib/spool-bell-transport.fk
section [form.bml] {
 class FormCliHealNativeIO {
  def fhn-at(dir, leaf) = fh-cat(list(dir, "/", leaf));
  // one crossing per read: a missing file answers nothing on read, so no size call is needed first
  def fhn-read(path) { let text = read_file(path); text ?? ""; }
  def fhn-json(path) = parse-json(path, fhn-read(path));
  def fhn-string(doc, key) = json-string-value(json-object-get(doc, key));
  def fhn-number(doc, key) = json-int-value(json-object-get(doc, key));
  def fhn-s(key, value) = json-node-pair(key, json-node-string(value));
  def fhn-n(key, value) = json-node-pair(key, json-node-int(value));
  def fhn-without(pairs, key) = nil?(pairs) ? list() : (String) json-pair-key(head(pairs)) == key ? fhn-without(tail(pairs), key) : cons(head(pairs), fhn-without(tail(pairs), key));
  def fhn-put(doc, key, value) = json-node-object(append(fhn-without(json-object-pairs(doc), key), list(json-node-pair(key, value))));
  def fhn-a(key, value) = json-node-pair(key, json-node-array(value));
  def fhn-strings(xs) = nil?(xs) ? list() : cons(json-node-string(head(xs)), fhn-strings(tail(xs)));
  def fhn-write-json(path, doc) = write_file(path, json-emit(doc) ++ "\n");
  def fhn-append(path, text) = (Comparable) sbt-append-count(path, text) == str_len(text) ? "appended" : "refused:short-append";
  def fhn-json-line(path, pairs) = fhn-append(path, json-emit(json-node-object(pairs)) ++ "\n");
  def fhn-command(argv) {
   let pid = host_spawn_quiet(argv);
   nothing?(pid) ? 127 : host_wait(pid);
  }
  def fhn-capture(argv) {
   let out = host_capture(argv);
   nothing?(out) ? "" : fh-trim(out);
  }
  def fhn-shell(path, source) {
   let wrote = write_file(path, "umask 077\n" ++ source);
   wrote < 0 ? 127 : fhn-command(list("/bin/sh", path));
  }
  def fhn-hash(path) = file_size(path) < 0 ? "absent" : qaf-string-hex(saj-file-digest-any-tail(path, file_size(path)));
  def fhn-valid-hash(hash) = (Comparable) str_len(hash) == 64;
  def fhn-parts-valid(parts) = nil?(parts) ? 1 : ((String) head(parts) == "..") || (((String) head(parts) == ".git") || (((String) head(parts) == ".form-heal") || ((String) head(parts) == ""))) ? 0 : fhn-parts-valid(tail(parts));
  def fhn-relative(path) = (str_len(path) > 0) && ((!((Comparable) str_byte_at(path, 0) == 47)) && ((!fh-has(path, "\n")) && ((!fh-has(path, "\r")) && fhn-parts-valid(split-on(path, "/")))));
  def fhn-member(paths, path) = nil?(paths) ? 0 : (String) head(paths) == path ? 1 : fhn-member(tail(paths), path);
  def fhn-clean-names(paths, seen) = nil?(paths) ? reverse(seen) : ((String) head(paths) == "") || (file_size(head(paths)) < 0) ? fhn-clean-names(tail(paths), seen) : fhn-clean-names(tail(paths), cons(head(paths), seen));
  def fhn-add-name(paths, path) = fhn-member(paths, path) ? paths : append(paths, list(path));
  def fhn-names-valid(paths, root) = nil?(paths) ? 1 : (fhn-relative(head(paths)) && ((!fs_is_dir(fhn-at(root, head(paths)))) && fhn-names-valid(tail(paths), root)));
  def fhn-lines(paths) = nil?(paths) ? "" : fh-cat(list(head(paths), "\n", fhn-lines(tail(paths))));
  def fhn-nuls(paths) = nil?(paths) ? "" : fh-cat(list(head(paths), byte_to_str(0), fhn-nuls(tail(paths))));
  def fhn-unique(parent, prefix, attempt) {
   let path = fhn-at(parent, fh-cat(list(prefix, int_to_str(host_pid()), "-", int_to_str(host_monotonic_ms()), "-", int_to_str(attempt))));
   attempt >= 32 ? "" : (Comparable) host_dir_mkdir(path) == 1 ? fhn-private-dir(path) : fhn-unique(parent, prefix, attempt + 1);
  }
  def fhn-private-dir(path) {
   let protected = fhn-command(list("/bin/chmod", "700", path));
   (Comparable) protected == 0 ? path : "";
  }
  def fhn-root() = fhn-capture(list("/bin/pwd", "-P"));
  // Refuse managed symlinks, including ancestors, before reading through them.
  def fhn-link-scan-script(root, names) = fh-cat(list("cd ", fh-quote(root), " || exit 1\nwhile IFS= read -r fh_item; do\n fh_probe=$fh_item\n while [ \"$fh_probe\" != . ]; do\n  [ ! -L \"$fh_probe\" ] || exit 1\n  case \"$fh_probe\" in */*) fh_probe=${fh_probe%/*};; *) fh_probe=.;; esac\n done\ndone < ", fh-quote(names), "\n"));
  def fhn-no-links(job, root, names) = (Comparable) fhn-shell(fhn-at(job, "links-check.sh"), fhn-link-scan-script(root, names)) == 0;
  def fhn-manifest(paths, root) = nil?(paths) ? list() : cons(fhn-s(head(paths), fhn-hash(fhn-at(root, head(paths)))), fhn-manifest(tail(paths), root));
  def fhn-manifest-valid(pairs) = nil?(pairs) ? 1 : (fhn-valid-hash(json-string-value(json-pair-value(head(pairs)))) && fhn-manifest-valid(tail(pairs)));
  def fhn-dirty(pairs, root, except) = nil?(pairs) ? "" : (!((String) json-pair-key(head(pairs)) == except)) && (!((String) fhn-hash(fhn-at(root, json-pair-key(head(pairs)))) == json-string-value(json-pair-value(head(pairs))))) ? json-pair-key(head(pairs)) : fhn-dirty(tail(pairs), root, except);
  def fhn-owned(job, doc) = (String) fs-path-dirname(job) == fhn-at(fhn-string(doc, "root"), ".form-heal");
  def fhn-prepare(target, band) {
   let root = fhn-root();
   let spool = fhn-at(root, ".form-heal");
   let made = fs_mkdir(spool);
   let job = fhn-unique(spool, "attempt-native-", 0);
   ((String) job == "") || (!(fhn-relative(target) && fhn-relative(band))) ? "refused:invalid-relative-source" : ((String) target == band) || (fhn-member(split-on(target, "/"), "tests") || (!(((String) fs-path-extension(target) == ".fk") || ((String) fs-path-extension(target) == ".bml")))) ? "refused:production-source-and-separate-checker-required" : fhn-prepare-files(job, root, target, band);
  }
  def fhn-prepare-files(job, root, target, band) {
   let namesPath = fhn-at(job, "names.nul");
   let listed = fhn-shell(fhn-at(job, "inventory.sh"), fh-cat(list("git ls-files -z --cached --others --exclude-standard > ", fh-quote(namesPath), "\n")));
   let names = fhn-add-name(fhn-add-name(fhn-add-name(fhn-clean-names(split-on(fhn-read(namesPath), byte_to_str(0)), list()), target), band), "fkwu");
   let lines = write_file(fhn-at(job, "names.txt"), fhn-lines(names));
   let nuls = write_file(namesPath, fhn-nuls(names));
   !(((Comparable) listed == 0) && (fhn-names-valid(names, root) && fhn-no-links(job, root, fhn-at(job, "names.txt")))) ? "refused:snapshot-inventory-or-symlink" : fhn-prepare-sealed(job, root, target, band, names);
  }
  def fhn-prepare-sealed(job, root, target, band, names) {
   let manifest = fhn-manifest(names, root);
   let work = fhn-at(job, "work");
   let made = fs_mkdir(work);
   let empty = fs_mkdir(fhn-at(job, "empty"));
   let archive = fhn-command(list("/usr/bin/tar", "-c", "-f", fhn-at(job, "source.tar"), "-C", root, "--null", "-T", fhn-at(job, "names.nul")));
   let copied = (Comparable) archive == 0 ? fhn-command(list("/usr/bin/tar", "-x", "-p", "-f", fhn-at(job, "source.tar"), "-C", work)) : archive;
   let doc = json-node-object(list(fhn-s("root", root), fhn-s("target", target), fhn-s("band", band), json-node-pair("manifest", json-node-object(manifest)), fhn-s("carrier", "native-form-v1")));
   let saved = fhn-write-json(fhn-at(job, "snapshot.json"), doc);
   let original = write_file(fhn-at(job, "original"), fhn-read(fhn-at(root, target)));
   let checker = write_file(fhn-at(job, "checker"), fhn-read(fhn-at(root, band)));
   let t = write_file(fhn-at(job, "target"), target);
   let b = write_file(fhn-at(job, "band"), band);
   let ledger = write_file(fhn-at(job, "attempts.tsv"), "");
   !(((Comparable) copied == 0) && fhn-manifest-valid(manifest)) ? "refused:snapshot-copy-or-digest" : !((String) fhn-dirty(manifest, work, "") == "") ? "refused:snapshot-byte-mismatch" : job;
  }
  def fhn-guard(job) {
   let doc = fhn-json(fhn-at(job, "snapshot.json"));
   !fhn-owned(job, doc) ? "refused:session-outside-spool" : !fhn-no-links(job, fhn-at(job, "work"), fhn-at(job, "names.txt")) ? "changed:source-symlink" : fhn-guard-hashes(job, doc);
  }
  def fhn-guard-hashes(job, doc) {
   let dirty = fhn-dirty(json-object-pairs(json-object-get(doc, "manifest")), fhn-at(job, "work"), fhn-string(doc, "target"));
   (String) dirty == "" ? "clean" : "changed:" ++ dirty;
  }
  def fhn-reset(job) {
   let doc = fhn-json(fhn-at(job, "snapshot.json"));
   let root = fhn-string(doc, "root");
   !fhn-owned(job, doc) ? "refused:session-outside-spool" : !fhn-no-links(job, root, fhn-at(job, "names.txt")) ? "refused:live-source-symlink" : !((String) fhn-dirty(json-object-pairs(json-object-get(doc, "manifest")), root, "") == "") ? "refused:stale-input" : fhn-reset-copy(job, fhn-at(job, "work"));
  }
  def fhn-reset-copy(job, work) {
   let removed = fhn-command(list("/bin/rm", "-rf", "--", work));
   let made = fs_mkdir(work);
   let copied = fhn-command(list("/usr/bin/tar", "-x", "-p", "-f", fhn-at(job, "source.tar"), "-C", work));
   ((Comparable) removed == 0) && ((Comparable) copied == 0) ? "ready" : "refused:snapshot-reset";
  }
  def fhn-commit(job, proposal) {
   let doc = fhn-json(fhn-at(job, "snapshot.json"));
   let lock = fhn-at(fhn-at(fhn-string(doc, "root"), ".form-heal"), "commit.native-lock");
   !fhn-owned(job, doc) ? "refused:session-outside-spool" : !((Comparable) host_dir_mkdir(lock) == 1) ? "refused:commit-lock-held" : fhn-commit-held(job, proposal, doc, lock);
  }
  def fhn-commit-held(job, proposal, doc, lock) {
   defer host_dir_rmdir(lock);
   let root = fhn-string(doc, "root");
   let target = fhn-at(root, fhn-string(doc, "target"));
   let candidate = fhn-at(fhn-at(job, "work"), fhn-string(doc, "target"));
   let proposalNames = write_file(fhn-at(job, "proposal-name.txt"), fs-path-basename(proposal) ++ "\n");
   let offered = ((String) fs-path-dirname(proposal) == job) && (fhn-relative(fs-path-basename(proposal)) && fhn-no-links(job, job, fhn-at(job, "proposal-name.txt")));
   let valid = offered && (fhn-valid-hash(fhn-hash(proposal)) && (fhn-no-links(job, root, fhn-at(job, "names.txt")) && (((String) fhn-dirty(json-object-pairs(json-object-get(doc, "manifest")), root, "") == "") && (((String) fhn-guard(job) == "clean") && (((String) fhn-hash(candidate) == fhn-hash(proposal)) && (!((String) fhn-hash(candidate) == fhn-hash(fhn-at(job, "original")))))))));
   valid ? fhn-commit-copy(job, candidate, target) : "refused:stale-or-mutated-input";
  }
  def fhn-commit-copy(job, candidate, target) {
   let staged = target ++ fh-cat(list(".heal-", int_to_str(host_pid())));
   let copied = fhn-command(list("/bin/cp", "-p", candidate, staged));
   let moved = (Comparable) copied == 0 ? fs_rename(staged, target) : -1;
   (Comparable) moved == 0 ? "applied" : "refused:atomic-source-replacement";
  }
  def fhn-finish(job) {
   let doc = fhn-json(fhn-at(job, "snapshot.json"));
   !fhn-owned(job, doc) ? "refused:session-outside-spool" : (Comparable) fhn-command(list("/bin/rm", "-rf", "--", fhn-at(job, "work"), fhn-at(job, "source.tar"))) == 0 ? "snapshot-released;evidence-retained" : "refused:snapshot-release";
  }
 }
 0;
}
