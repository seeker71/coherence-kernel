// Complete native child observations own statement effects, refusal and source identity.
// preludes: form-stdlib/bml/bml-statement-admission-fixtures.bml form-stdlib/bml/native-source-inventory.bml form-stdlib/bml/formbin-codec.bml form-stdlib/bml/concept-source-audit.bml
section [form.bml] {
 class BmlStatementAdmissionWitness {
  def bsaw-require(ok,message) = if ok then 1 else form_error(str_concat("BML statement admission: ",message));
  def bsaw-state() = record_new(0,"root",".","hash","form-sha256","observations",0,"files",list());
  def bsaw-id(state,path) = json-node-object(list(oh-s("path",path),oh-n("bytes",str_len(csa-file(state,path))),oh-s("sha256",csa-file-hash(state,path))));
  def bsaw-ids(state,paths) = if nil?(paths) then list() else cons(bsaw-id(state,head(paths)),bsaw-ids(state,tail(paths)));
  def bsaw-read(path) {
   let result = fbc-read-exact(path,0);
   bsaw-require(fbc-good(result),str_concat("complete file: ",path)); fbc-value(result);
  }
  def bsaw-put(path,text) {
   let written = write_file(path,text);
   bsaw-require(and(eq(written,str_len(text)),str_eq(bsaw-read(path),text)),"complete owned publication and exact readback"); 1;
  }
  def bsaw-paths() = list("fkwu","runtime/fkwu-uni.c","runtime/fkwu-optable.h","form/form-stdlib/core.fk","form/form-stdlib/line-grammar.fk","form/form-stdlib/form-ontology-bp.fk","form/form-stdlib/bmf-core.fk","form/form-stdlib/bmf-grammar.fk","form/form-stdlib/bml.fk","form/form-stdlib/bml-floor-compile.fk","form/form-stdlib/source-compiler.fk","form/form-stdlib/source-compiler-text-lens.fk","form/form-stdlib/form-bml-lower.fk","form/form-stdlib/bml-source.fk","form/form-stdlib/grammars/form-bml.fk","form/form-stdlib/grammars/form-lift.fk","form/form-stdlib/tests/bml-import-ref-fixture.bml","form/form-stdlib/bml/bml-statement-admission-fixtures.bml","form/form-stdlib/bml/bml-statement-admission-witness.bml","observe/bml-statement-admission-run.bml","form/form-stdlib/compiler.fk","form/form-stdlib/engine.fk","form/form-stdlib/compiler-objects.fk","form/form-stdlib/grammar-chars.fk");
  def bsaw-equal(a,b) = str_eq(json-emit-precise(json-node-array(a)),json-emit-precise(json-node-array(b)));
  def bsaw-health(flow,aspect,ok,evidence) {
   let row = oh-reading("bml-statement-admission",flow,aspect,json-node-int(1),json-node-int(if ok then 1 else 0),json-node-int(if ok then 1 else 0),if ok then list() else list(oh-need("complete-source-effects-status",evidence)),list("request-evidence","retain"),evidence);
   oh-voice(row);
   if ok then 1 else bsaw-refusal(row);
  }
  def bsaw-refusal(row) {
   let response = oh-response(row,"request-evidence"); oh-voice(response);
   oh-voice(oh-applied(row,oh-select(row,response,"retain"),oh-get(row,"evidence")));
   form_error("BML statement admission witness refused; actual child evidence retained");
  }
  def bsaw-diagnostic(spec,errors) = if eq(nth(spec,3),0) then eq(str_len(errors),0) else and(gt(str_len(errors),0),ge(str_find(errors,nth(spec,4),0),0));
  def bsaw-control-lines(lines) = if nil?(lines) then list() else if str_eq(head(lines),"") then bsaw-control-lines(tail(lines)) else bsaw-control-line(head(lines),tail(lines));
  def bsaw-control-line(line,rest) {
   let prefix = "form-organ health ";
   bsaw-require(str_eq(substring(line,0,str_len(prefix)),prefix),"own refusal emitted an unexpected effect");
   let row = parse-json("statement-refusal-health",substring(line,str_len(prefix),str_len(line)));
   bsaw-require(oh-valid(row),"own refusal carried a malformed health event"); cons(row,bsaw-control-lines(rest));
  }
  def bsaw-control-output(output) {
   let rows = bsaw-control-lines(split-on(output,"\n"));
   if ne(len(rows),3) then 0 else bsaw-control-rows(rows,head(rows),nth(rows,1),nth(rows,2));
  }
  def bsaw-control-rows(rows,observed,response,applied) {
   let current = oh-current(rows,list());
   and(and(str_eq(oh-str(observed,"stage"),"observe"),and(str_eq(oh-str(response,"stage"),"response"),str_eq(oh-str(applied,"stage"),"applied"))),and(and(str_eq(oh-str(observed,"id"),oh-str(response,"id")),str_eq(oh-str(observed,"id"),oh-str(applied,"id"))),and(str_eq(oh-select(observed,response,"invalid"),"request-evidence"),and(eq(len(current),1),and(str_eq(oh-str(head(current),"organ"),"bml-statement-admission"),and(oh-pain(head(current)),str_eq(oh-str(head(current),"stage"),"applied")))))));
  }
  def bsaw-output(spec,output) = if str_eq(head(spec),"witness-own-refusal") then bsaw-control-output(output) else str_eq(output,nth(spec,2));
  def bsaw-one(job,spec,source,before) {
   let name = head(spec); let path = nsi-path(job,str_concat(name,".bml")); bsaw-put(path,source);
   let capture = nsi-capture(list("./fkwu",path)); let directory = nsi-evidence(capture);
   let output = bsaw-read(nsi-path(directory,"stdout")); let errors = bsaw-read(nsi-path(directory,"stderr"));
   let status = parse-json("statement-capture",bsaw-read(nsi-path(directory,"capture.json")));
   let complete = and(eq(json-int-value(json-object-get(status,"exit")),nsi-status(capture)),and(eq(json-int-value(json-object-get(status,"stdout_bytes")),str_len(output)),eq(json-int-value(json-object-get(status,"stderr_bytes")),str_len(errors))));
   let unchanged = bsaw-equal(before,bsaw-ids(bsaw-state(),bsaw-paths()));
   let matched = and(eq(nsi-status(capture),nth(spec,3)),and(bsaw-output(spec,output),bsaw-diagnostic(spec,errors)));
   let held = bsaw-state();
   let row = json-node-object(list(oh-s("case",name),oh-n("expected_exit",nth(spec,3)),oh-s("expected_stdout",nth(spec,2)),oh-s("required_diagnostic",nth(spec,4)),oh-n("actual_exit",nsi-status(capture)),oh-s("actual_stdout",output),oh-n("actual_stderr_bytes",str_len(errors)),oh-n("behavior_matches",matched),oh-n("complete_capture",complete),oh-n("source_identities_unchanged",unchanged),json-node-pair("source",bsaw-id(held,path)),json-node-pair("capture",bsaw-id(held,nsi-path(directory,"capture.json"))),json-node-pair("stdout",bsaw-id(held,nsi-path(directory,"stdout"))),json-node-pair("stderr",bsaw-id(held,nsi-path(directory,"stderr")))));
   let evidence = nsi-path(job,str_concat(name,".json")); bsaw-put(evidence,json-emit-precise(row));
   bsaw-health(job,name,and(complete,and(unchanged,matched)),oh-reference(evidence)); row;
  }
  def bsaw-each(job,specs,before) = if nil?(specs) then list() else cons(bsaw-one(job,head(specs),bsaf-wrap(nth(head(specs),1)),before),bsaw-each(job,tail(specs),before));
  def bsaw-full-each(job,specs,before) = if nil?(specs) then list() else cons(bsaw-one(job,head(specs),nth(head(specs),1),before),bsaw-full-each(job,tail(specs),before));
  def bsaw-forced(job,before) {
   let spec = list("witness-own-refusal","","three correlated observe/response/applied health events, without a following effect",1,"BML statement admission witness refused");
   let source = "// preludes: form-stdlib/bml/bml-statement-admission-witness.bml\nsection [form.bml] {\n bsaw-health(\"forced-refusal\",\"deliberate\",0,json-node-string(\"actual negative check\"));\n print_str(\"UNREACHED\");\n}\n";
   bsaw-one(job,spec,source,before);
  }
  def bsaw-run() {
   let before = bsaw-ids(bsaw-state(),bsaw-paths()); let job = nsi-job();
   let rows = bsaw-each(job,bsaf-cases(),before);
   let full = bsaw-full-each(job,bsaf-full-cases(),before);
   let refusal = bsaw-forced(job,before); let rows = append(rows,append(full,list(refusal)));
   bsaw-health(job,"final-source-reread",bsaw-equal(before,bsaw-ids(bsaw-state(),bsaw-paths())),json-node-int(len(before)));
   let report = json-node-object(list(oh-s("schema","bml-statement-admission-observations-v1"),oh-n("accepted",1),oh-s("scope","Actual complete child effects, final values, exact statuses, diagnostic refusals and unchanged source identities"),oh-s("fixtures",job),oh-n("case_count",len(rows)),json-node-pair("sources",json-node-array(before)),json-node-pair("cases",json-node-array(rows))));
   let path = nsi-path(job,"report.json"); bsaw-put(path,json-emit-precise(report));
   print(list("bml-statement-admission","cases",len(rows),"sources",len(before),"evidence",path)); 1;
  }
 }
 0;
}
