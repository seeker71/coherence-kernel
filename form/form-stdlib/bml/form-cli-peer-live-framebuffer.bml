//////////////////////////////////////////////////////////////////////
// form-cli-peer-live-framebuffer.bml -- high-grammar lifecycle channel
// for a resident peer. Frames carry only turn, public phase, and public
// signal: task and answer bytes remain with the caller.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/bml/form-cli-resident-continuity.bml observe/bidirectional-framebuffer-channel.fk

section [form.bml] {
    class FormCliPeerLiveFramebuffer {
        field Rule = "resident-peer-emits-opaque-lifecycle-frames-in-native-framebuffer";
        field PrivacyRule = "opaque-lifecycle-no-task-or-answer-bytes";

        def fcplf-stage-code(stage) {
            if str_eq(stage, "resident-cache") then 1 else
            if str_eq(stage, "source-context-ready") then 2 else
            if str_eq(stage, "native-program-ready") then 3 else
            if str_eq(stage, "resident-setup") then 4 else
            if str_eq(stage, "prefill-ready") then 5 else
            if str_eq(stage, "task-begin") then 6 else
            if str_eq(stage, "task-terminal") then 7 else
            if str_eq(stage, "release") then 8 else nothing();
        }
        def fcplf-stage-name(code) {
            if eq(code, 1) then "resident-cache" else
            if eq(code, 2) then "source-context-ready" else
            if eq(code, 3) then "native-program-ready" else
            if eq(code, 4) then "resident-setup" else
            if eq(code, 5) then "prefill-ready" else
            if eq(code, 6) then "task-begin" else
            if eq(code, 7) then "task-terminal" else
            if eq(code, 8) then "release" else nothing();
        }
        def fcplf-stage-known?(stage) = not(nothing?(fcplf-stage-code(stage)));
        def fcplf-exchange(turn, stage) {
            let code = fcplf-stage-code(stage);
            if nothing?(code) then nothing() else add(mul(turn, 16), code);
        }
        def fcplf-outbound(turn, stage, signal) {
            let code = fcplf-stage-code(stage);
            let exchange = fcplf-exchange(turn, stage);
            if nothing?(exchange) then nothing() else
                bfc-envelope(0, exchange, 0, list(turn, code, signal), nothing());
        }
        def fcplf-record(turn, stage, signal) {
            let outbound = fcplf-outbound(turn, stage, signal);
            if nothing?(outbound) then nothing() else
                bfc-record-out(outbound, fcplf-exchange(turn, stage));
        }
        def fcplf-rule() = Rule();
        def fcplf-privacy-rule() = PrivacyRule();
    }
    0;
}
