// Typed revision fields and complete source admission carry their observations.
// Retained source acquisition writes evidence without changing the corpus.
// preludes: form/form-stdlib/bml/concept-wiktionary-meaning.bml form/form-stdlib/bml/concept-translation-worker.bml form/form-stdlib/bml/concept-materializer.bml form/form-stdlib/bml/native-source-inventory.bml
section [form.bml] {
 class ConceptWiktionaryPinned {
  def cwp-check(state,aspect,ok) {
   let reading = oh-reading("wiktionary-pinned",str_concat(record_get(state,"evidence"),str_concat(":",int_to_str(record_get(state,"ordinal")))),aspect,json-node-int(1),json-node-int(ok),json-node-int(ok),list(),list("continue","retain"),oh-reference(record_get(state,"evidence")));
   record_set(state,"ordinal",add(record_get(state,"ordinal"),1));
   oh-voice(reading); let response = oh-response(reading,if ok then "continue" else "retain"); oh-voice(response);
   let selected = oh-select(reading,response,"retain");
   oh-voice(oh-applied(reading,selected,json-node-object(list(oh-s("publication","none"),oh-s("action",if ok then "advance through retained source admission" else "retain exact bytes and withhold source claim")))));
   if ok then 1 else form_error(str_concat("pinned revision refused: ",aspect));
  }
  def cwp-write(state,name,bytes) {
   let path = nsi-path(record_get(state,"evidence"),name);
   let wrote = write_file(path,bytes); let back = fbc-read-exact(path,0);
   cwp-check(state,"retained-byte-readback",and(eq(wrote,str_len(bytes)),and(fbc-good(back),str_eq(fbc-value(back),bytes))));
   path;
  }
  def cwp-key-count(pairs,key) = if nil?(pairs) then 0 else add(if str_eq(json-pair-key(head(pairs)),key) then 1 else 0,cwp-key-count(tail(pairs),key));
  def cwp-field(state,node,key,kind) {
   cwp-check(state,str_concat("typed-unique-field-",key),and(node_eq(node_category(node),JSON-OBJECT()),and(eq(cwp-key-count(json-object-pairs(node),key),1),ctwk-type(node,key,kind))));
   json-object-get(node,key);
  }
  def cwp-object(state,node,key) {
   cwp-check(state,str_concat("unique-object-",key),and(node_eq(node_category(node),JSON-OBJECT()),and(eq(cwp-key-count(json-object-pairs(node),key),1),node_eq(node_category(json-object-get(node,key)),JSON-OBJECT()))));
   json-object-get(node,key);
  }
  def cwp-one(state,node,key) {
   cwp-check(state,str_concat("unique-single-array-",key),and(node_eq(node_category(node),JSON-OBJECT()),and(eq(cwp-key-count(json-object-pairs(node),key),1),and(ctr-array(json-object-get(node,key)),eq(len(json-array-elements(json-object-get(node,key))),1)))));
   head(json-array-elements(json-object-get(node,key)));
  }
  def cwp-json(state,bytes) {
   cwp-check(state,"complete-utf8-json",and(fbc-utf8(bytes,0),jwa-valid(bytes)));
   cwp-check(state,"integer-representation-before-materialization",ctwk-integers(bytes,0));
   parse-json("pinned-wiktionary",bytes);
  }
 }
 0;
}
