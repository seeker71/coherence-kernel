// Record packets in the recipe walker retain field order, duplicate keys and
// aliases. The enclosing native record supplies mutable identity only.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NativeRecipeRecord {
  def nrr-owner-kind() = intern_trivial_string("native-recipe-record-owner-v1");
  def nrr-owner() = record_new(nrr-owner-kind());
  def nrr-owned-blueprint(owner, blueprint) = if not(record?(blueprint)) then 0 else if value_eq(blueprint, owner) then 1 else value_eq(record_blueprint(blueprint), nrr-owner-kind());
  def nrr-owned(owner, value) = if record?(value) then nrr-owned-blueprint(owner, record_blueprint(value)) else 0;
  def nrr-new(owner, packet) = record_new(owner, "packet", packet);
  def nrr-packet(value) = record_get(value, "packet");
  def nrr-field(row) = str_eq(value_kind(nth(row, 0)), "string");
  def nrr-find(rows, key) = if nil?(rows) then list() else if and(nrr-field(head(rows)), value_eq(nth(head(rows), 0), key)) then head(rows) else nrr-find(tail(rows), key);
  def nrr-get(owner, value, key) = if nrr-owned(owner, value) then nrr-get-row(nrr-find(nrr-packet(value), key)) else record_get(value, key);
  def nrr-get-row(row) = if nil?(row) then 0 else nth(row, 1);
  def nrr-fields(rows) = if nil?(rows) then list() else if nrr-field(head(rows)) then cons(head(rows), nrr-fields(tail(rows))) else nrr-fields(tail(rows));
  def nrr-has(owner, value, key) = if nrr-owned(owner, value) then not(nil?(nrr-find(nrr-packet(value), key))) else record_has(value, key);
  def nrr-set-rows(rows, key, value) = if nil?(rows) then list(list(key, value)) else if and(nrr-field(head(rows)), value_eq(nth(head(rows), 0), key)) then cons(list(key, value), tail(rows)) else cons(head(rows), nrr-set-rows(tail(rows), key, value));
  def nrr-set(owner, record, key, value) {
   if nrr-owned(owner, record) then {
    if not(str_eq(value_kind(key), "string")) then form_error("[recipe-record] field key must be a string") else 1;
    record_set(record, "packet", nrr-set-rows(nrr-packet(record), key, value));
    record;
   } else record_set(record, key, value);
  }
  def nrr-key-rows(rows) = if nil?(rows) then list() else cons(nth(head(rows), 0), nrr-key-rows(tail(rows)));
  def nrr-keys(owner, value) = if nrr-owned(owner, value) then nrr-key-rows(nrr-fields(nrr-packet(value))) else record_keys(value);
  def nrr-blueprint-rows(rows, current) = if nil?(rows) then current else nrr-blueprint-rows(tail(rows), if nrr-field(head(rows)) then current else nth(head(rows), 1));
  def nrr-blueprint(owner, value) = if nrr-owned(owner, value) then nrr-blueprint-rows(nrr-packet(value), 0) else record_blueprint(value);
 }
}
