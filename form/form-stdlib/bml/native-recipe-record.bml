// Record packets in the recipe walker retain field order, duplicate keys and
// aliases. The enclosing native record supplies mutable identity only.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NativeRecipeRecord {
  def nrr-owner-kind() = intern_trivial_string("native-recipe-record-owner-v1");
  def nrr-owner() = record_new(nrr-owner-kind());
  def nrr-owned-blueprint(owner, blueprint) = if (!record?(blueprint)) then 0 else if ((Value) blueprint == owner) then 1 else ((Value) record_blueprint(blueprint) == nrr-owner-kind());
  def nrr-owned(owner, value) = if record?(value) then nrr-owned-blueprint(owner, record_blueprint(value)) else 0;
  def nrr-new(owner, packet) = record_new(owner, "packet", packet);
  def nrr-packet(value) = record_get(value, "packet");
  def nrr-field(row) = (String) value_kind(row[0]) == "string";
  def nrr-find(rows, key) = nil?(rows) ? [] : nrr-field(head(rows)) && (Value) rows[0][0] == key ? head(rows) : nrr-find(tail(rows), key);
  def nrr-get(owner, value, key) = if nrr-owned(owner, value) then nrr-get-row(nrr-find(nrr-packet(value), key)) else record_get(value, key);
  def nrr-get-row(row) = nil?(row) ? 0 : row[1];
  def nrr-has(owner, value, key) = if nrr-owned(owner, value) then (!nil?(nrr-find(nrr-packet(value), key))) else record_has(value, key);
  def nrr-set-rows(rows, key, value) = nil?(rows) ? [[key,value]] : nrr-field(head(rows)) && (Value) rows[0][0] == key ? cons([key,value],tail(rows)) : cons(head(rows),nrr-set-rows(tail(rows),key,value));
  def nrr-set(owner, record, key, value) {
   if nrr-owned(owner, record) then {
    if (!((String) value_kind(key) == "string")) then form_error("[recipe-record] field key must be a string") else 1;
    record_set(record, "packet", nrr-set-rows(nrr-packet(record), key, value));
    record;
   } else record_set(record, key, value);
  }
  def nrr-keys(owner, value) = nrr-owned(owner,value) ? (nrr-packet(value) |> filter(nrr-field) |> map(row => row[0])) : record_keys(value);
  def nrr-blueprint(owner, value) = nrr-owned(owner,value) ? (nrr-packet(value) |> foldl((current,row) => nrr-field(row) ? current : row[1],0)) : record_blueprint(value);
 }
}
