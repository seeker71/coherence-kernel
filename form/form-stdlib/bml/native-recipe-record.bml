// Record packets in the recipe walker retain field order, duplicate keys and
// aliases. The enclosing native record supplies mutable identity only.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NativeRecipeRecord {
  def nrr-owner-kind() = intern_trivial_string("native-recipe-record-owner-v1");
  def nrr-owner() = record_new(nrr-owner-kind());
  def nrr-owned-blueprint(owner, blueprint) = !record?(blueprint) ? 0 : (Value) blueprint == owner ? 1 : ((Value) record_blueprint(blueprint) == nrr-owner-kind());
  def nrr-owned(owner, value) = record?(value) ? nrr-owned-blueprint(owner, record_blueprint(value)) : 0;
  def nrr-new(owner, packet) = record_new(owner, "packet", packet);
  def nrr-packet(value) = record_get(value, "packet");
  def nrr-field(row) = (String) value_kind(row[0]) == "string";
  def nrr-find(rows, key) = nil?(rows) ? list() : nrr-field(head(rows)) && ((Value) head(rows)[0] == key) ? head(rows) : nrr-find(tail(rows), key);
  def nrr-get(owner, value, key) = nrr-owned(owner, value) ? nrr-get-row(nrr-find(nrr-packet(value), key)) : record_get(value, key);
  def nrr-get-row(row) = nil?(row) ? 0 : row[1];
  def nrr-fields(rows) = rows |> filter(nrr-field);
  def nrr-has(owner, value, key) = nrr-owned(owner, value) ? (!nil?(nrr-find(nrr-packet(value), key))) : record_has(value, key);
  def nrr-set-rows(rows, key, value) = nil?(rows) ? list(list(key, value)) : nrr-field(head(rows)) && ((Value) head(rows)[0] == key) ? cons(list(key, value), tail(rows)) : cons(head(rows), nrr-set-rows(tail(rows), key, value));
  def nrr-set(owner, record, key, value) {
   nrr-owned(owner, record) ? {
    !((String) value_kind(key) == "string") ? form_error("[recipe-record] field key must be a string") : 1;
    record_set(record, "packet", nrr-set-rows(nrr-packet(record), key, value));
    record;
   } : record_set(record, key, value);
  }
  def nrr-key-rows(rows) = rows |> map(row => row[0]);
  def nrr-keys(owner, value) = nrr-owned(owner, value) ? nrr-key-rows(nrr-fields(nrr-packet(value))) : record_keys(value);
  def nrr-blueprint-rows(rows, current) = nil?(rows) ? current : nrr-blueprint-rows(tail(rows), nrr-field(head(rows)) ? current : head(rows)[1]);
  def nrr-blueprint(owner, value) = nrr-owned(owner, value) ? nrr-blueprint-rows(nrr-packet(value), 0) : record_blueprint(value);
 }
}
