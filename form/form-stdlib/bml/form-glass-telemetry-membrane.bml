package Form.surface.glasstelemetry;

import Form.kernel.*;
import Form.surface.terminalcanvas.*;

interface IFormGlassTelemetryMembrane [public, witness, reusable, privacy-safe] {
   section [public] {
      const String Schema = "glass-sample-v1";
      const String SnapshotSchema = "glass-snapshot-v1";
      const String ControlSchema = "glass-control-v1";
      const String PresenceRule = "every optional measurement carries an explicit presence bit; absent and measured zero never share a representation";
      const String PrivacyRule = "the membrane admits bounded semantic labels and measurements only; prompt, answer, message, and arbitrary content bodies have no field and never cross";
      const String ProvenanceRule = "every admitted sample is classified as physical-live, derived-window, catalog, or declared; the glass never upgrades one class into another";
      const String RootRule = "every publisher and controller receives an explicit caller-provided root; the membrane owns no implicit global location";
      const String CurrentRule = "one atomic replacement snapshot per publisher is the latest publication; candidate rename occurs only after a successful write; liveness requires a consumer lease or an explicit stale projection and is never inferred from file survival";
      const String ChannelRule = "channel identifiers are lowercase ASCII path-safe tokens with bounded length and no traversal segments";
      const String MultiActiveRule = "active is a per-sample lifecycle fact; multiple model samples may be active in the same publisher snapshot";
      const String CompletedRule = "completed is retained terminal request history; it remains visible but cannot assert in-flight work or pin active refresh cadence";
      const String ControlRule = "a channel inbox carries one bounded enum action offer and a correlated acknowledgement; inspect and request-evidence admit a 256-byte path-safe composite selector while other arguments remain 64-byte labels";
      const String TrustBoundaryRule = "publisher files share the caller root and are trusted only within the same operating-system identity; bounded reads precede parsing";
      const String InventoryRule = "all valid snapshot filenames are ranked newest-first by file modification time before the 128-publisher read bound is applied, so old instances cannot crowd newer owners out";
      const Int MaxSamplesPerPublisher = 512;
      const Int MaxChannelsPerSample = 16;
      const Int MaxIdentifierBytes = 64;
      const Int MaxSelectorBytes = 256;
      const Int MaxSnapshotWireBytes = 1048576;
      const Int MaxControlWireBytes = 4096;
      const Int MaxPublishers = 128;

      Object GlassSample( String id, Object parent, String kind,
          String memoryPlane, String owner, String lane, String purpose,
          Object bytes, Object capacity, String lifecycle,
          Object readEpoch, Object writeEpoch, Object heat,
          Object physicalHandle, String evictability, String evidence,
          String source, Object channels ) [abstract];
      Object PublishSnapshot( String explicitRoot, String publisher,
          Int epoch, Object samples ) [abstract];
      Object Inventory( String explicitRoot ) [abstract];
      Object Offer( String explicitRoot, Object offer ) [abstract];
      Object Poll( String explicitRoot, String channel ) [abstract];
      Object Acknowledge( String explicitRoot, Object acknowledgement ) [abstract];
   }
}

class FormGlassTelemetryMembrane [public, resident, observable, teach] : IFormGlassTelemetryMembrane {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-telemetry-membrane.bml";
      const String SnapshotSuffix = ".glass-snapshot";
      const String InboxSuffix = ".glass-control-inbox";
      const String AckSuffix = ".glass-control-ack";
      const String FilesystemFloor = "snapshot publication, inventory, control offer, poll, and acknowledgement use the Form filesystem membrane only";
      const String PayloadFloor = "telemetry cannot transport natural-language prompt or answer content because no unbounded payload field exists";

      Object GlassSample( String id, Object parent, String kind,
          String memoryPlane, String owner, String lane, String purpose,
          Object bytes, Object capacity, String lifecycle,
          Object readEpoch, Object writeEpoch, Object heat,
          Object physicalHandle, String evictability, String evidence,
          String source, Object channels ) [abstract] {}
      Object PublishSnapshot( String explicitRoot, String publisher,
          Int epoch, Object samples ) [abstract] {}
      Object Inventory( String explicitRoot ) [abstract] {}
      Object Offer( String explicitRoot, Object offer ) [abstract] {}
      Object Poll( String explicitRoot, String channel ) [abstract] {}
      Object Acknowledge( String explicitRoot, Object acknowledgement ) [abstract] {}
   }
}
