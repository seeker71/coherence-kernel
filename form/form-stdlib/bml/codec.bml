//////////////////////////////////////////////////////////////////////
// codec.bml — text becomes any value or cell, and any value becomes text it can be read back from.
//
// Urs, 2026-10-02: "stdlib and BML shall know how to parse any primitive and any cell of any type," and "BML shall
// have an intrinsic way to convert between types, especially string to any type for streaming and storage."
// parse.bml reads the scalars; this stands on it for what is structured: a list, and a cell of any Blueprint,
// both carried as the one JSON dialect the body already has (cell-serialize.fk). A list is the LIST blueprint,
// so a stored list reads back through the same cell reader as everything else, with no second scanner.
//
//   parse-as(kind,text,registry)  kind: int float number bool string json cell
//   parse-any(text,registry)      nothing, bool, number, cell, else the text itself
//   encode(value,registry)        any value -> typed text (int, float, string, nothing, list, cell)
//   decode(text,registry)         that text -> the same value; a cell to the same NodeID
//   encode-lines / decode-lines   a list of values <-> newline-delimited rows (a ledger, a stream)
//   convert(value,kind,registry)  between kinds: string int float bool list cell text any
//   core-id(name) / core-registry()  the core blueprints (LIST MAP PAIR SET TUPLE SOME NONE BOOL DECL FIELD)
//
// A cell is read through the Blueprint registry (wire-registry.fk): the same name and children mint the same
// NodeID, so a cell decoded here is the cell that was written (axiom 3). A reading that cannot arrive is nothing().
// decode(encode(v)) is v for every kind, and a row never holds a raw newline.
//////////////////////////////////////////////////////////////////////
// preludes: form-stdlib/bml/parse.bml form-stdlib/json.fk form-stdlib/wire-registry.fk form-stdlib/cell-serialize.fk
section [form.bml] {
 class FormCodec {
  // ---- the core blueprints: one list, in order; a name's instance is its place in it ------------------
  def core-names() = ["LIST", "MAP", "PAIR", "SET", "TUPLE", "SOME", "NONE", "BOOL", "DECL", "FIELD"];
  def core-place(name, names, n) = nil?(names) ? nothing() : (names[0] == name ? n : core-place(name, names[1:], n + 1));
  def core-id(name) = make_nodeid(1, 2, 97, core-place(name, core-names(), 1));
  def core-registry() = core-names() |> map(name => wr-entry(name, core-id(name)));
  def structured?(t) = starts-with?(t, "{");

  // ---- by kind ------------------------------------------------------------------------------------------
  def parse-as(kind, text, registry) = match kind {
   "int" => parse-int(text),
   "float" => parse-float(text),
   "number" => parse-number(text),
   "bool" => parse-bool(text),
   "string" => text,
   "json" => parse-json("parse", text),
   "cell" => json-to-cell(text, registry),
   _ => nothing()
  };

  // ---- by shape: each reading in turn, the text itself last ----------------------------------------------------
  def parse-any(text, registry) {
   let t = trim(text);
   nothing-word?(t) ? nothing() : (parse-bool(t) ?? parse-number(t) ?? (structured?(t) ? json-to-cell(t, registry) : text));
  }

  // ---- storage and streaming: one text for any value, and back ---------------------------------------------------
  // encode(v) writes a value as typed text: ints and floats as numbers (a float keeps its point, so 7.0 does not
  // come back as 7), strings quoted and escaped, nothing as null, a list as the LIST blueprint over its members, a
  // cell as its Blueprint object. decode(text) reads that text back to the same kind, and a cell to the same NodeID.
  def encode(v, registry) = nothing?(v) ? "null" : match value_kind(v) {
   "int" => value_str(v),
   "float" => float-text(v),
   "string" => json-quote-string(v),
   "list" => ("{\"bp\":\"LIST\",\"c\":[" ++ str-join-with(v |> map(x => encode(x, registry)), ",") ++ "]}"),
   "node_id" => cell-to-json(v, registry),
   _ => "null"
  };
  // a decoded cell as the value it stands for: a leaf is its value, the null cell is nothing, LIST is a list
  def cell-value(c) {
   wr-null?(c) ? nothing() :
   (Comparable) node_level(c) == 1 ? node_value(c) :
   node_eq(node_category(c), core-id("LIST")) ? (node_children(c) |> map(member => cell-value(member))) : c;
  }
  def decode(text, registry) {
   let t = trim(text);
   len(t) == 0 ? nothing() : cell-value(json-to-cell(t, cons(wr-entry("LIST", core-id("LIST")), registry)));
  }
  def encode-lines(values, registry) = str-join(values |> map(v => encode(v, registry) ++ "\n"));
  def decode-lines(text, registry) = split-on(text, "\n") |> filter(row => len(trim(row)) > 0) |> map(row => decode(row, registry));

  // ---- between kinds -------------------------------------------------------------------------------------------------
  // convert(value, kind, registry): kind is string int float bool list cell text any. A reading that cannot
  // arrive is nothing(); nothing converts to nothing. "text" is the storage form (encode); "any" reads a string
  // by what it holds (decode); every other kind reads a string as that kind.
  def as-string(v, registry) = match value_kind(v) { "string" => v, "int" | "float" => value_str(v), _ => encode(v, registry) };
  def as-list(v, registry) = match value_kind(v) { "list" => v, "string" => list-or-nothing(decode(v, registry)), _ => nothing() };
  def list-or-nothing(d) = nothing?(d) ? nothing() : (value_kind(d) == "list" ? d : nothing());
  def as-cell(v, registry) = match value_kind(v) { "node_id" => v, "string" => json-to-cell(v, registry), _ => nothing() };
  def as-any(v, registry) = match value_kind(v) { "string" => decode(v, registry), _ => v };
  def convert(v, kind, registry) = nothing?(v) ? nothing() : match kind {
   "string" => as-string(v, registry),
   "int" => as-int(v),
   "float" => as-float(v),
   "bool" => as-bool(v),
   "text" => encode(v, registry),
   "list" => as-list(v, registry),
   "cell" => as-cell(v, registry),
   "any" => as-any(v, registry),
   _ => nothing()
  };
 }
 0;
}
