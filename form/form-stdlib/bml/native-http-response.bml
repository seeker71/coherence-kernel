// Complete HTTP/1 response framing over held bytes. A transport that only
// reports bytes cannot attest orderly EOF, so close-delimited bodies refuse.
// Content-Length and chunked framing must account for every received byte.
// preludes: form-stdlib/bml/formbin-codec.bml form-stdlib/string-case.fk form-stdlib/url-encode.fk
section [form.bml] {
 class NativeHttpResponse {
  def nhr-ok(status,body) = list(1,"",status,body);
  def nhr-bad(reason) = list(0,reason,0,"");
  def nhr-good(result) = ((Comparable) head(result) == 1);
  def nhr-reason(result) = nth(result,1);
  def nhr-status(result) = nth(result,2);
  def nhr-body(result) = nth(result,3);
  def nhr-ows(byte) = (((Comparable) byte == 32) || ((Comparable) byte == 9));
  def nhr-left(text,at) = if ((Comparable) at == str_len(text)) then at else if nhr-ows(str_byte_at(text,at)) then nhr-left(text,(at + 1)) else at;
  def nhr-right(text,end) = if ((Comparable) end == 0) then end else if nhr-ows(str_byte_at(text,(end - 1))) then nhr-right(text,(end - 1)) else end;
  def nhr-trim(text) = substring(text,nhr-left(text,0),nhr-right(text,str_len(text)));
  def nhr-header-bytes(text,at) = if ((Comparable) at == str_len(text)) then 1 else ((((Comparable) str_byte_at(text,at) == 9) || ((str_byte_at(text,at) >= 32) && ((Comparable) str_byte_at(text,at) != 127))) && nhr-header-bytes(text,(at + 1)));
  def nhr-token(text,at) = if ((Comparable) at == str_len(text)) then (at > 0) else nhr-token-byte(text,at,str_byte_at(text,at));
  def nhr-tchar(byte) = (((byte >= 48) && (byte <= 57)) || (((byte >= 65) && (byte <= 90)) || (((byte >= 97) && (byte <= 122)) || (str_find("!#$%&'*+-.^_`|~",byte_to_str(byte),0) >= 0))));
  def nhr-token-byte(text,at,byte) = (nhr-tchar(byte) && nhr-token(text,(at + 1)));
  def nhr-token-end(text,at) = if (at >= str_len(text)) then at else if nhr-tchar(str_byte_at(text,at)) then nhr-token-end(text,(at + 1)) else at;
  def nhr-decimal(text,at) = if ((Comparable) at == str_len(text)) then (at > 0) else (((str_byte_at(text,at) >= 48) && (str_byte_at(text,at) <= 57)) && nhr-decimal(text,(at + 1)));
  def nhr-number(text,base,limit,at,value) = if ((Comparable) at == str_len(text)) then if (at > 0) then value else -1 else nhr-number-digit(text,base,limit,at,value,if ((Comparable) base == 16) then url-hex-value(str_byte_at(text,at)) else (str_byte_at(text,at) - 48));
  def nhr-number-digit(text,base,limit,at,value,digit) = if ((digit < 0) || ((digit >= base) || ((digit > limit) || (value > ((limit - digit) / base))))) then -1 else nhr-number(text,base,limit,(at + 1),((value * base) + digit));
  def nhr-status-line(line) = if (str_len(line) < 13) then 0 else if (!(((String) substring(line,0,9) == "HTTP/1.0 ") || ((String) substring(line,0,9) == "HTTP/1.1 "))) then 0 else if ((Comparable) str_byte_at(line,12) != 32) then 0 else if (!nhr-header-bytes(line,0)) then 0 else nhr-number(substring(line,9,12),10,599,0,0);
  def nhr-header-line(state,line,trailer) {
   let colon = str_find(line,":",0);
   if (!((colon > 0) && (nhr-token(substring(line,0,colon),0) && nhr-header-bytes(line,0)))) then "malformed HTTP header"
   else nhr-header-value(state,str-lower(substring(line,0,colon)),nhr-trim(substring(line,(colon + 1),str_len(line))),trailer);
  }
  def nhr-header-value(state,key,value,trailer) {
   if (((String) key == "content-length") || (((String) key == "transfer-encoding") || ((String) key == "content-encoding"))) then
    if trailer then "framing or encoding field in HTTP trailer"
    else if record_has(state,key) then "duplicate HTTP framing or encoding field"
    else nhr-store-header(state,key,value)
   else "";
  }
  def nhr-store-header(state,key,value) {
   record_set(state,key,value);
   "";
  }
  def nhr-headers(state,bytes,at,end,trailer) = if ((Comparable) at == end) then "" else if (at > end) then "malformed HTTP header delimiter" else nhr-header-at(state,bytes,at,end,trailer,str_find(bytes,"\r\n",at));
  def nhr-header-at(state,bytes,at,end,trailer,stop) = if ((stop < at) || (stop > end)) then "incomplete HTTP header line" else nhr-header-next(state,bytes,(stop + 2),end,trailer,nhr-header-line(state,substring(bytes,at,stop),trailer));
  def nhr-header-next(state,bytes,at,end,trailer,error) = if (str_len(error) > 0) then error else nhr-headers(state,bytes,at,end,trailer);
  def nhr-parse(bytes) = if (!((String) value_kind(bytes) == "string")) then nhr-bad("HTTP transport did not return bytes") else nhr-message(bytes,0);
  def nhr-message(bytes,start) = nhr-message-lines(bytes,start,str_find(bytes,"\r\n",start),str_find(bytes,"\r\n\r\n",start));
  def nhr-message-lines(bytes,start,lineEnd,headersEnd) {
   if ((lineEnd < start) || ((headersEnd < lineEnd) || ((headersEnd + 4) > str_len(bytes)))) then nhr-bad("complete HTTP status and headers required")
   else nhr-message-status(bytes,lineEnd,headersEnd,nhr-status-line(substring(bytes,start,lineEnd)));
  }
  def nhr-message-status(bytes,lineEnd,headersEnd,status) {
   if (status < 100) then nhr-bad("HTTP status outside 100..599")
   else nhr-read-headers(bytes,lineEnd,headersEnd,status);
  }
  def nhr-read-headers(bytes,lineEnd,headersEnd,status) {
    let state = record_new(0,"status",status);
    let error = nhr-headers(state,bytes,(lineEnd + 2),(headersEnd + 2),0);
    if (str_len(error) > 0) then nhr-bad(error) else nhr-message-body(state,bytes,(headersEnd + 4));
  }
  def nhr-message-body(state,bytes,start) {
   let status = record_get(state,"status");
   if ((Comparable) status == 101) then nhr-bad("HTTP protocol upgrade is not a response body")
   else if (status < 200) then if (record_has(state,"content-length") || record_has(state,"transfer-encoding")) then nhr-bad("interim response carries body framing") else nhr-message(bytes,start)
   else if (((Comparable) status == 204) || ((Comparable) status == 304)) then nhr-bodyless(state,bytes,start,status)
   else if (record_has(state,"content-encoding") && (!((String) str-lower(record_get(state,"content-encoding")) == "identity"))) then nhr-bad("HTTP content encoding requires an admitted decoder")
   else if record_has(state,"transfer-encoding") then if record_has(state,"content-length") then nhr-bad("HTTP response has two framing authorities") else if (!((String) str-lower(record_get(state,"transfer-encoding")) == "chunked")) then nhr-bad("HTTP transfer coding requires an admitted decoder") else nhr-chunk(state,bytes,start,list())
   else if record_has(state,"content-length") then nhr-sized(state,bytes,start,nhr-number(record_get(state,"content-length"),10,(str_len(bytes) - start),0,0))
   else nhr-bad("HTTP body has no verifiable length or chunk framing");
  }
  // RFC 9110 8.6: 204 forbids length; 304 length describes a representation,
  // so its complete decimal syntax is checked without folding into an int.
  def nhr-bodyless(state,bytes,start,status) {
   if (!((Comparable) start == str_len(bytes))) then nhr-bad("bytes after a bodyless HTTP status")
   else if (((Comparable) status == 204) && (record_has(state,"content-length") || record_has(state,"transfer-encoding"))) then nhr-bad("204 response carries forbidden body framing")
   else if (record_has(state,"content-length") && record_has(state,"transfer-encoding")) then nhr-bad("HTTP response has two framing authorities")
   else if (record_has(state,"content-length") && (!nhr-decimal(record_get(state,"content-length"),0))) then nhr-bad("bodyless representation length must be decimal")
   else nhr-ok(status,"");
  }
  def nhr-sized(state,bytes,start,size) = if ((size < 0) || ((Comparable) size != (str_len(bytes) - start))) then nhr-bad("HTTP Content-Length does not equal complete body bytes") else nhr-ok(record_get(state,"status"),substring(bytes,start,str_len(bytes)));
  def nhr-chunk(state,bytes,start,bins) = nhr-chunk-line(state,bytes,start,bins,str_find(bytes,"\r\n",start));
  def nhr-chunk-line(state,bytes,start,bins,end) = if (end < start) then nhr-bad("incomplete HTTP chunk size line") else nhr-chunk-text(state,bytes,(end + 2),bins,substring(bytes,start,end));
  def nhr-chunk-text(state,bytes,start,bins,line) {
   let semi = str_find(line,";",0); let prefix = if (semi < 0) then line else substring(line,0,semi);
   let number = if (semi < 0) then prefix else substring(prefix,0,nhr-right(prefix,str_len(prefix)));
   if (!(nhr-header-bytes(line,0) && nhr-extensions(line,str_len(number)))) then nhr-bad("malformed HTTP chunk extension")
   else nhr-chunk-size(state,bytes,start,bins,nhr-number(number,16,(str_len(bytes) - start),0,0));
  }
  // RFC 9112 7.1.1. Unknown extensions are ignored only after their complete
  // token/quoted-string grammar is admitted. BWS remains legal at its seams.
  def nhr-extensions(text,at) = if ((Comparable) at == str_len(text)) then 1 else nhr-extension-start(text,nhr-left(text,at));
  def nhr-extension-start(text,at) = if (at >= str_len(text)) then 0 else if ((Comparable) str_byte_at(text,at) != 59) then 0 else nhr-extension-name(text,nhr-left(text,(at + 1)));
  def nhr-extension-name(text,at) = nhr-extension-named(text,at,nhr-token-end(text,at));
  def nhr-extension-named(text,start,end) = if ((Comparable) start == end) then 0 else nhr-extension-equals(text,end,nhr-left(text,end));
  def nhr-extension-equals(text,end,spaced) = if ((spaced < str_len(text)) && ((Comparable) str_byte_at(text,spaced) == 61)) then nhr-extension-value(text,nhr-left(text,(spaced + 1))) else nhr-extensions(text,end);
  def nhr-extension-value(text,at) = if (at >= str_len(text)) then 0 else if ((Comparable) str_byte_at(text,at) == 34) then nhr-extension-quoted-end(text,nhr-quoted-end(text,(at + 1))) else nhr-extension-token-value(text,at,nhr-token-end(text,at));
  def nhr-extension-token-value(text,start,end) = ((end > start) && nhr-extensions(text,end));
  def nhr-extension-quoted-end(text,end) = if (end < 0) then 0 else nhr-extensions(text,end);
  def nhr-qdtext(byte) = (((Comparable) byte == 9) || (((Comparable) byte == 32) || (((Comparable) byte == 33) || (((byte >= 35) && (byte <= 91)) || (byte >= 93)))));
  def nhr-quoted-end(text,at) = if (at >= str_len(text)) then -1 else nhr-quoted-byte(text,at,str_byte_at(text,at));
  def nhr-quoted-byte(text,at,byte) = if ((Comparable) byte == 34) then (at + 1) else if ((Comparable) byte == 92) then nhr-quoted-pair(text,(at + 1)) else if (nhr-qdtext(byte) && ((Comparable) byte != 127)) then nhr-quoted-end(text,(at + 1)) else -1;
  def nhr-quoted-pair(text,at) = if (at >= str_len(text)) then -1 else if ((((Comparable) str_byte_at(text,at) == 9) || (str_byte_at(text,at) >= 32)) && ((Comparable) str_byte_at(text,at) != 127)) then nhr-quoted-end(text,(at + 1)) else -1;
  def nhr-chunk-size(state,bytes,start,bins,size) = if (size < 0) then nhr-bad("invalid or incomplete HTTP chunk size") else if ((Comparable) size == 0) then nhr-trailers(state,bytes,start,bins) else if (!((String) substring(bytes,(start + size),((start + size) + 2)) == "\r\n")) then nhr-bad("incomplete HTTP chunk data delimiter") else nhr-chunk(state,bytes,((start + size) + 2),fbc-put(bins,substring(bytes,start,(start + size))));
  def nhr-trailers(state,bytes,start,bins) = if ((String) substring(bytes,start,(start + 2)) == "\r\n") then if ((Comparable) (start + 2) == str_len(bytes)) then nhr-ok(record_get(state,"status"),fbc-finish(bins,"")) else nhr-bad("bytes after complete chunked HTTP body") else nhr-trailer-end(state,bytes,start,bins,str_find(bytes,"\r\n\r\n",start));
  def nhr-trailer-end(state,bytes,start,bins,end) = if ((end < start) || ((Comparable) (end + 4) != str_len(bytes))) then nhr-bad("incomplete HTTP trailers or trailing bytes") else nhr-trailer-result(state,bins,nhr-headers(state,bytes,start,(end + 2),1));
  def nhr-trailer-result(state,bins,error) = if (str_len(error) > 0) then nhr-bad(error) else nhr-ok(record_get(state,"status"),fbc-finish(bins,""));
 }
 0;
}
