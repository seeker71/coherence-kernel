// Complete HTTP/1 response framing over held bytes. A transport that only
// reports bytes cannot attest orderly EOF, so close-delimited bodies refuse.
// Content-Length and chunked framing must account for every received byte.
// preludes: form-stdlib/bml/formbin-codec.bml form-stdlib/string-case.fk form-stdlib/url-encode.fk
section [form.bml] {
 class NativeHttpResponse {
  def nhr-ok(status,body) = list(1,"",status,body);
  def nhr-bad(reason) = list(0,reason,0,"");
  def nhr-good(result) = eq(head(result),1);
  def nhr-reason(result) = nth(result,1);
  def nhr-status(result) = nth(result,2);
  def nhr-body(result) = nth(result,3);
  def nhr-ows(byte) = or(eq(byte,32),eq(byte,9));
  def nhr-left(text,at) = if eq(at,str_len(text)) then at else if nhr-ows(str_byte_at(text,at)) then nhr-left(text,add(at,1)) else at;
  def nhr-right(text,end) = if eq(end,0) then end else if nhr-ows(str_byte_at(text,sub(end,1))) then nhr-right(text,sub(end,1)) else end;
  def nhr-trim(text) = substring(text,nhr-left(text,0),nhr-right(text,str_len(text)));
  def nhr-header-bytes(text,at) = if eq(at,str_len(text)) then 1 else and(or(eq(str_byte_at(text,at),9),and(ge(str_byte_at(text,at),32),ne(str_byte_at(text,at),127))),nhr-header-bytes(text,add(at,1)));
  def nhr-token(text,at) = if eq(at,str_len(text)) then gt(at,0) else nhr-token-byte(text,at,str_byte_at(text,at));
  def nhr-tchar(byte) = or(and(ge(byte,48),le(byte,57)),or(and(ge(byte,65),le(byte,90)),or(and(ge(byte,97),le(byte,122)),ge(str_find("!#$%&'*+-.^_`|~",byte_to_str(byte),0),0))));
  def nhr-token-byte(text,at,byte) = and(nhr-tchar(byte),nhr-token(text,add(at,1)));
  def nhr-token-end(text,at) = if ge(at,str_len(text)) then at else if nhr-tchar(str_byte_at(text,at)) then nhr-token-end(text,add(at,1)) else at;
  def nhr-decimal(text,at) = if eq(at,str_len(text)) then gt(at,0) else and(and(ge(str_byte_at(text,at),48),le(str_byte_at(text,at),57)),nhr-decimal(text,add(at,1)));
  def nhr-number(text,base,limit,at,value) = if eq(at,str_len(text)) then if gt(at,0) then value else -1 else nhr-number-digit(text,base,limit,at,value,if eq(base,16) then url-hex-value(str_byte_at(text,at)) else sub(str_byte_at(text,at),48));
  def nhr-number-digit(text,base,limit,at,value,digit) = if or(lt(digit,0),or(ge(digit,base),or(gt(digit,limit),gt(value,div(sub(limit,digit),base))))) then -1 else nhr-number(text,base,limit,add(at,1),add(mul(value,base),digit));
  def nhr-status-line(line) = if lt(str_len(line),13) then 0 else if not(or(str_eq(substring(line,0,9),"HTTP/1.0 "),str_eq(substring(line,0,9),"HTTP/1.1 "))) then 0 else if ne(str_byte_at(line,12),32) then 0 else if not(nhr-header-bytes(line,0)) then 0 else nhr-number(substring(line,9,12),10,599,0,0);
  def nhr-header-line(state,line,trailer) {
   let colon = str_find(line,":",0);
   if not(and(gt(colon,0),and(nhr-token(substring(line,0,colon),0),nhr-header-bytes(line,0)))) then "malformed HTTP header"
   else nhr-header-value(state,str-lower(substring(line,0,colon)),nhr-trim(substring(line,add(colon,1),str_len(line))),trailer);
  }
  def nhr-header-value(state,key,value,trailer) {
   if or(str_eq(key,"content-length"),or(str_eq(key,"transfer-encoding"),str_eq(key,"content-encoding"))) then
    if trailer then "framing or encoding field in HTTP trailer"
    else if record_has(state,key) then "duplicate HTTP framing or encoding field"
    else nhr-store-header(state,key,value)
   else "";
  }
  def nhr-store-header(state,key,value) {
   record_set(state,key,value);
   "";
  }
  def nhr-headers(state,bytes,at,end,trailer) = if eq(at,end) then "" else if gt(at,end) then "malformed HTTP header delimiter" else nhr-header-at(state,bytes,at,end,trailer,str_find(bytes,"\r\n",at));
  def nhr-header-at(state,bytes,at,end,trailer,stop) = if or(lt(stop,at),gt(stop,end)) then "incomplete HTTP header line" else nhr-header-next(state,bytes,add(stop,2),end,trailer,nhr-header-line(state,substring(bytes,at,stop),trailer));
  def nhr-header-next(state,bytes,at,end,trailer,error) = if gt(str_len(error),0) then error else nhr-headers(state,bytes,at,end,trailer);
  def nhr-parse(bytes) = if not(str_eq(value_kind(bytes),"string")) then nhr-bad("HTTP transport did not return bytes") else nhr-message(bytes,0);
  def nhr-message(bytes,start) = nhr-message-lines(bytes,start,str_find(bytes,"\r\n",start),str_find(bytes,"\r\n\r\n",start));
  def nhr-message-lines(bytes,start,lineEnd,headersEnd) {
   if or(lt(lineEnd,start),or(lt(headersEnd,lineEnd),gt(add(headersEnd,4),str_len(bytes)))) then nhr-bad("complete HTTP status and headers required")
   else nhr-message-status(bytes,lineEnd,headersEnd,nhr-status-line(substring(bytes,start,lineEnd)));
  }
  def nhr-message-status(bytes,lineEnd,headersEnd,status) {
   if lt(status,100) then nhr-bad("HTTP status outside 100..599")
   else nhr-read-headers(bytes,lineEnd,headersEnd,status);
  }
  def nhr-read-headers(bytes,lineEnd,headersEnd,status) {
    let state = record_new(0,"status",status);
    let error = nhr-headers(state,bytes,add(lineEnd,2),add(headersEnd,2),0);
    if gt(str_len(error),0) then nhr-bad(error) else nhr-message-body(state,bytes,add(headersEnd,4));
  }
  def nhr-message-body(state,bytes,start) {
   let status = record_get(state,"status");
   if eq(status,101) then nhr-bad("HTTP protocol upgrade is not a response body")
   else if lt(status,200) then if or(record_has(state,"content-length"),record_has(state,"transfer-encoding")) then nhr-bad("interim response carries body framing") else nhr-message(bytes,start)
   else if or(eq(status,204),eq(status,304)) then nhr-bodyless(state,bytes,start,status)
   else if and(record_has(state,"content-encoding"),not(str_eq(str-lower(record_get(state,"content-encoding")),"identity"))) then nhr-bad("HTTP content encoding requires an admitted decoder")
   else if record_has(state,"transfer-encoding") then if record_has(state,"content-length") then nhr-bad("HTTP response has two framing authorities") else if not(str_eq(str-lower(record_get(state,"transfer-encoding")),"chunked")) then nhr-bad("HTTP transfer coding requires an admitted decoder") else nhr-chunk(state,bytes,start,list())
   else if record_has(state,"content-length") then nhr-sized(state,bytes,start,nhr-number(record_get(state,"content-length"),10,sub(str_len(bytes),start),0,0))
   else nhr-bad("HTTP body has no verifiable length or chunk framing");
  }
  // RFC 9110 8.6: 204 forbids length; 304 length describes a representation,
  // so its complete decimal syntax is checked without folding into an int.
  def nhr-bodyless(state,bytes,start,status) {
   if not(eq(start,str_len(bytes))) then nhr-bad("bytes after a bodyless HTTP status")
   else if and(eq(status,204),or(record_has(state,"content-length"),record_has(state,"transfer-encoding"))) then nhr-bad("204 response carries forbidden body framing")
   else if and(record_has(state,"content-length"),record_has(state,"transfer-encoding")) then nhr-bad("HTTP response has two framing authorities")
   else if and(record_has(state,"content-length"),not(nhr-decimal(record_get(state,"content-length"),0))) then nhr-bad("bodyless representation length must be decimal")
   else nhr-ok(status,"");
  }
  def nhr-sized(state,bytes,start,size) = if or(lt(size,0),ne(size,sub(str_len(bytes),start))) then nhr-bad("HTTP Content-Length does not equal complete body bytes") else nhr-ok(record_get(state,"status"),substring(bytes,start,str_len(bytes)));
  def nhr-chunk(state,bytes,start,bins) = nhr-chunk-line(state,bytes,start,bins,str_find(bytes,"\r\n",start));
  def nhr-chunk-line(state,bytes,start,bins,end) = if lt(end,start) then nhr-bad("incomplete HTTP chunk size line") else nhr-chunk-text(state,bytes,add(end,2),bins,substring(bytes,start,end));
  def nhr-chunk-text(state,bytes,start,bins,line) {
   let semi = str_find(line,";",0); let prefix = if lt(semi,0) then line else substring(line,0,semi);
   let number = if lt(semi,0) then prefix else substring(prefix,0,nhr-right(prefix,str_len(prefix)));
   if not(and(nhr-header-bytes(line,0),nhr-extensions(line,str_len(number)))) then nhr-bad("malformed HTTP chunk extension")
   else nhr-chunk-size(state,bytes,start,bins,nhr-number(number,16,sub(str_len(bytes),start),0,0));
  }
  // RFC 9112 7.1.1. Unknown extensions are ignored only after their complete
  // token/quoted-string grammar is admitted. BWS remains legal at its seams.
  def nhr-extensions(text,at) = if eq(at,str_len(text)) then 1 else nhr-extension-start(text,nhr-left(text,at));
  def nhr-extension-start(text,at) = if ge(at,str_len(text)) then 0 else if ne(str_byte_at(text,at),59) then 0 else nhr-extension-name(text,nhr-left(text,add(at,1)));
  def nhr-extension-name(text,at) = nhr-extension-named(text,at,nhr-token-end(text,at));
  def nhr-extension-named(text,start,end) = if eq(start,end) then 0 else nhr-extension-equals(text,end,nhr-left(text,end));
  def nhr-extension-equals(text,end,spaced) = if and(lt(spaced,str_len(text)),eq(str_byte_at(text,spaced),61)) then nhr-extension-value(text,nhr-left(text,add(spaced,1))) else nhr-extensions(text,end);
  def nhr-extension-value(text,at) = if ge(at,str_len(text)) then 0 else if eq(str_byte_at(text,at),34) then nhr-extension-quoted-end(text,nhr-quoted-end(text,add(at,1))) else nhr-extension-token-value(text,at,nhr-token-end(text,at));
  def nhr-extension-token-value(text,start,end) = and(gt(end,start),nhr-extensions(text,end));
  def nhr-extension-quoted-end(text,end) = if lt(end,0) then 0 else nhr-extensions(text,end);
  def nhr-qdtext(byte) = or(eq(byte,9),or(eq(byte,32),or(eq(byte,33),or(and(ge(byte,35),le(byte,91)),ge(byte,93)))));
  def nhr-quoted-end(text,at) = if ge(at,str_len(text)) then -1 else nhr-quoted-byte(text,at,str_byte_at(text,at));
  def nhr-quoted-byte(text,at,byte) = if eq(byte,34) then add(at,1) else if eq(byte,92) then nhr-quoted-pair(text,add(at,1)) else if and(nhr-qdtext(byte),ne(byte,127)) then nhr-quoted-end(text,add(at,1)) else -1;
  def nhr-quoted-pair(text,at) = if ge(at,str_len(text)) then -1 else if and(or(eq(str_byte_at(text,at),9),ge(str_byte_at(text,at),32)),ne(str_byte_at(text,at),127)) then nhr-quoted-end(text,add(at,1)) else -1;
  def nhr-chunk-size(state,bytes,start,bins,size) = if lt(size,0) then nhr-bad("invalid or incomplete HTTP chunk size") else if eq(size,0) then nhr-trailers(state,bytes,start,bins) else if not(str_eq(substring(bytes,add(start,size),add(add(start,size),2)),"\r\n")) then nhr-bad("incomplete HTTP chunk data delimiter") else nhr-chunk(state,bytes,add(add(start,size),2),fbc-put(bins,substring(bytes,start,add(start,size))));
  def nhr-trailers(state,bytes,start,bins) = if str_eq(substring(bytes,start,add(start,2)),"\r\n") then if eq(add(start,2),str_len(bytes)) then nhr-ok(record_get(state,"status"),fbc-finish(bins,"")) else nhr-bad("bytes after complete chunked HTTP body") else nhr-trailer-end(state,bytes,start,bins,str_find(bytes,"\r\n\r\n",start));
  def nhr-trailer-end(state,bytes,start,bins,end) = if or(lt(end,start),ne(add(end,4),str_len(bytes))) then nhr-bad("incomplete HTTP trailers or trailing bytes") else nhr-trailer-result(state,bins,nhr-headers(state,bytes,start,add(end,2),1));
  def nhr-trailer-result(state,bins,error) = if gt(str_len(error),0) then nhr-bad(error) else nhr-ok(record_get(state,"status"),fbc-finish(bins,""));
 }
 0;
}
