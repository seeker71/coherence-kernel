package Form.cli.organmint;

import Form.kernel.*;
import Form.cli.flow.*;

enum SampleSplit [public] {
   TRAIN,
   HELDOUT
}

interface IOrganMint [public, witness, reusable] {
   section [public] {
      const int MixA = 7;
      const int MixB = 13;
      const int NSkills = 12;
      const int LoraWriter = 0;
      const String TrustRule = "mint from living organs; observe source lesson and transform lineage separately; LoRA tensors wait on lift";

      int Mix( int nI, int nMod ) [abstract];
      String Situation( String strClass, int nI, String strSplit ) [abstract];
      Object LessonIdentity( String strClass, int nI ) [abstract];
      int Leakage( Object hRows ) [abstract];
      int LessonLeakage( Object hRows ) [abstract];
      int Unique( Object hRows ) [abstract];
      int LoraWriterReady() [abstract];
   }
}

template SampleRow<TClass> [public, reusable] {
   section [public] {
      String Split() [get];
      TClass Class() [get];
      String Situation() [get];
      Object SourceId() [get];
      Object LessonId() [get];
      Object TransformId() [get];
   }
}

class FormOrganMint [public, reusable, teach] : IOrganMint {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-organ-mint.bml";

      int Mix( int nI, int nMod ) [abstract] {}
      String Situation( String strClass, int nI, String strSplit ) [abstract] {}
      Object LessonIdentity( String strClass, int nI ) [abstract] {}
      int Leakage( Object hRows ) [abstract] {}
      int LessonLeakage( Object hRows ) [abstract] {}
      int Unique( Object hRows ) [abstract] {}
      int LoraWriterReady() [abstract] {}
   }
}

class FormOrganMintSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-organ-mint-self";
      const String Pattern = "combinatorial-mint source-overlap-visible lesson-lineage-disjoint transform-observed overlay-fit lora-identity-waits";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
