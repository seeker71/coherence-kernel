//////////////////////////////////////////////////////////////////////
//
// genlane-parity.bml — high-grammar authority for the generation
// parity pulse: the three-lane comparison's local half, kept
// re-runnable as an organ instead of remembered as an event.
//
// THE THREE TASKS, EXACTLY CHECKABLE. Each probes one muscle and each
// scores on one needle: a zero-family fact (axiom-1 names `nothing`),
// a line of Form generation (the operator is the body's `mul` — a
// Lisp-prior `(* 6 7)` dies on fkwu while `(mul 6 7)` answers 42),
// and a known-family fact (bootstrap/ground.fk returns 42). A task a
// reader cannot re-check by hand is not a task here.
//
// THE ANSWER SEAM, PAID FOR. Scoring is lexical over the ANSWER TEXT
// ONLY — the text after the "text:" marker. The fcmg span carries
// telemetry fields before that marker, and a needle can match a FIELD
// NAME instead of the answer: on the first live verdict (2026-08-30)
// "othing" matched heed_nothings=0 and lit T1 falsely, verdict 3 where
// the answers earn 2. A missing marker scores as an empty answer,
// never as the whole span.
//
// THE BUDGET FLOOR. A budget sizes what the pulse can SEE: a knowledge
// envelope has to be able to CLOSE inside the query phase, or the run
// measures only starvation. Sixteen tokens structurally forbade the
// close on the first live run — the model spent them all mid-envelope
// and timed out held, and that starvation is already on record in the
// 2026-08-30 receipts. The plain door's ledger opens its answer
// reserve only after a closed frame injects an observation.
//
// THE START LINE. It prints BEFORE first admission, so a reader of a
// hung run can tell "not started" from "stuck in admission". The first
// comparison lost thirteen minutes to that ambiguity
// (fk_metal_sync_external -> fk_wait_observed); since 2026-09-03 the
// resident hands the admission deadline (hearth-metal-deadline-ms) to
// the carrier and prints admission-deadline-ms before that line.
//
// A FALLING VERDICT IS VITALITY. When a shortcut is removed — a
// telemetry false-positive unmasked, a starving budget fed — the
// verdict may FALL, and that fall is the measurement getting honest,
// not the body regressing. Trajectory 3/2/6/4 witnessed 2026-08-30.
//
// Living cells: observe/genlane-parity-pulse.fk (the pulse),
//   observe/genlane-parity-pulse-scorer.fk (the pure scorer).
// Executable: form-stdlib/genlane-scorer.bml
// Proven by: form-stdlib/tests/genlane-pulse-scorer-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.genlaneparity;

import Form.kernel.*;
import Form.cli.heedmark.*;

// The three muscles, in pulse order. Each carries exactly one bit.
enum ParityTask [public] {
   ZERO_FAMILY,
   FORM_GENERATION,
   KNOWN_FAMILY
}

// The two regions of an fcmg span. A needle may land only in ANSWER.
enum SpanField [public] {
   TELEMETRY,
   ANSWER
}

// The three lanes the pulse's verdict is compared against. LOCAL is
// this organ; the rented lanes are re-run by agents per comparison.
enum ParityLane [public] {
   LOCAL,
   RENTED_PURE,
   RENTED_GROUNDED
}

// One task as data: the prompt, the budget that lets its envelope
// close, the needle that scores it, and the bit it earns.
template ParityProbe<TPrompt> [public, reusable] {
   section [public] {
      TPrompt Prompt() [get];
      int Budget() [get];
      String Needle() [get];
      int Bit() [get];
   }
}

interface IGenlaneParity [public, witness, reusable] {
   section [public] {
      const String Marker = "text:";
      const int BitZeroFamily = 1;
      const int BitFormGeneration = 2;
      const int BitKnownFamily = 4;
      const int FactBudget = 48;
      const int FormBudget = 24;
      const int StarvationBudget = 16;   // measured only starvation; kept as the counter-example
      const String TrustRule = "three exactly-checkable tasks; a needle lands only in the answer text; the start line precedes first admission";

      String Answer( String strSpan ) [abstract];               // text after the marker, or empty
      int Hit( String strSpan, String strNeedle ) [abstract];   // 1 only when the needle lands in Answer
      int TaskBit( int nTask ) [abstract];
      int EnvelopeCloses( int nBudget ) [abstract];             // 0 at the starvation floor
      int StartBeforeAdmission() [abstract];
   }
}

class FormGenlaneParity [public, reusable, flow] : IGenlaneParity {
   section [public] {
      const String AnswerRule = "score only the answer text after the marker; a telemetry field name is never an answer";
      const String MissingMarkerRule = "a missing marker scores as an empty answer, never as the whole span";
      const String BudgetRule = "a budget lets a knowledge envelope close, or the run measures only starvation";
      const String StartRule = "the start line prints before first admission, so silence is diagnosable";
      const String VitalityRule = "a verdict may fall when a shortcut is removed; the fall is the measurement getting honest";
      const String ExecutablePath = "form/form-stdlib/genlane-scorer.bml";

      String Answer( String strSpan ) [abstract] {}
      int Hit( String strSpan, String strNeedle ) [abstract] {}
      int TaskBit( int nTask ) [abstract] {}
      int EnvelopeCloses( int nBudget ) [abstract] {}
      int StartBeforeAdmission() [abstract] {}
   }
}

class FormGenlaneParitySelf [public, selfHosting, flow, observable] {
   section [public] {
      const String CoreName = "genlane-parity-self";
      const String Pattern = "three-tasks answer-text-only envelope-closes start-first falling-verdict-vitality";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
