// rag-crossfade.bml — a new ear serves over the old index while its own vectors fill in.
// preludes: form-stdlib/rag-retrieve.fk
//
// Read from arnsri33/embedflow (2026-09-10): an embedding upgrade usually means re-embedding
// the whole corpus and building a second index before the new model answers one query. The
// observation there is that two representation spaces can disagree everywhere and still keep
// each other's neighbourhoods well enough for a bounded candidate set — so the OLD index keeps
// serving as the candidate finder, the NEW ear scores only those candidates, and the new
// vectors fill a cache progressively: a few encoded inside the answer, the rest queued for a
// background breath. Both ears sound at once; the listener hears one signal. A crossfade.
//
// This body is in exactly that transition: the lexical re-vec (rag-embed.fk, four-way,
// sovereign) is the old ear; nomic-embed-form.fk and qwen38-embedding.bml on this host's
// Metal are the new ones. This cell is the flow between them, in pure list arithmetic so it
// runs the same on all four kernels. Every vector here is a list of ints (rag-retrieve.fk's
// quantized lane, L1 nearest, ties to the first — the source position).
//
// What it holds, each read off the answer itself rather than off the system:
//   state     "cold" / "partial" / "warm" — from the vectors THIS answer had, after its own
//             bounded encodes. cold ranks in the old ear's order and says so; partial ranks
//             only the warm candidates and says so; warm is deterministic over that set.
//   contract  (model revision dim pooling): the semantic fields of the ear, never its path or
//             device. Its key is the joined string; its dim is part of it, so a vector of
//             another width fills no slot even under the right name.
//   cache     (id contract-key vec). A vector answers only under the contract that made it —
//             the same reading fkwu gives a .fkb: the bytes of a source do not fix its meaning,
//             the binary that compiled them does. A vector under another contract is a miss,
//             and a cache brought in from anywhere passes rcf-cache-admit first, which keeps
//             only this contract's rows.
//   ear       the new model as this cell can carry it: a table of the vectors it answers. On
//             the host the ear is a Metal cell per text (observe/rag-crossfade-live.fk); here
//             a table stands where it stands. An id the ear cannot answer fills no slot and is
//             reported, not invented.
//   queue     ids waiting for the background breath; enqueue dedupes, materialize claims a
//             batch, encodes, and lets the claimed ids go. prewarm fills a named set now.
//   nDCG      per mille, gains binary (relevant or not), rank weights 1000/log2(i+1) for
//             i = 1..10 declared below — the table is the radius: n past 10 scores 10. A
//             duplicate id is scored once, so a repeated answer cannot climb above the ideal.
//   gap       G(K) = M_T - M_{T|S_K} on nDCG: what the native new ear finds in its top-n that
//             the crossfade at depth K does not. Containment is kept apart from it: the
//             per-mille of the native top-n present among the source candidates.
//   depth     the observed K*: the first K on an ascending curve whose gap is within eps;
//             0 when no walked K reaches it (a curve says nothing past its last point).
//   ann       the old index here is exact; when an approximate one arrives its penalty is a
//             separate axis: rcf-ann-fidelity is the per-mille of the exact top-n the
//             approximate top-n keeps, and its reading is "unknown" until a reference exists —
//             then "pass" at 950 or above, "warning" below. Unknown is a reading, not a zero.
//   reading   before any native index exists: how much of the top-n at depth K survives into
//             the top-n at the deepest K walked, and how deep in the source order the final
//             top-n reached. Three phases in the body's own words, thresholds declared here and
//             pinned by the band before any run: ice (settled: residual <= 50 per mille and the
//             final top-n came from within K), gas (residual > 100 per mille), water (in
//             motion: widen K and keep watching). embedflow's SAFE / UNSAFE_OR_UNCERTAIN /
//             EXPAND.
//   settle    the reading with memory. A surface hovering at a threshold would flip phase on
//             every read; rcf-settle asks more to LEAVE a phase than to enter it: from ice the
//             reading holds until residual passes 100, from gas until it drops to 50, and the
//             band between is where the last phase is kept. A state that flips at every read is
//             not a state.
//   seal      the declared rule folded to one number the band pins, so the thresholds and the
//             weight table cannot drift under a green verdict.
//   plan      status "ready" when the reading is ice and the ann reading is pass or unknown,
//             else "review"; strategy "progressive" from ice, else "progressive-with-review";
//             the cache fraction per mille; a warning count. rcf-backfill-ms is the cost of
//             not crossfading: the remaining documents times the measured ms per document.
//
// Proven by: form-stdlib/tests/rag-crossfade-band.bml (four-way at form/validate.sh).
section [form.bml] {
    class RagCrossfade {
        // --- response states, read from what this answer had ---
        def rcf-cold() = "cold";
        def rcf-partial() = "partial";
        def rcf-warm() = "warm";
        def rcf-state(available, total) = if eq(available, total) then rcf-warm() else if eq(available, 0) then rcf-cold() else rcf-partial();

        // --- the contract: semantic fields only; its key joins them, its dim guards the cache ---
        def rcf-contract(model, revision, dim, pooling) = list(model, revision, dim, pooling);
        def rcf-contract-model(c) = nth(c, 0);
        def rcf-contract-revision(c) = nth(c, 1);
        def rcf-contract-dim(c) = nth(c, 2);
        def rcf-contract-pooling(c) = nth(c, 3);
        def rcf-contract-key(c) = str_concat(rcf-contract-model(c), str_concat("@", str_concat(rcf-contract-revision(c), str_concat("/d", str_concat(int_to_str(rcf-contract-dim(c)), str_concat("/", rcf-contract-pooling(c)))))));

        // --- the target cache: (id contract-key vec); an absent vector is the empty list ---
        def rcf-cached(id, key, vec) = list(id, key, vec);
        def rcf-cached-id(c) = nth(c, 0);
        def rcf-cached-key(c) = nth(c, 1);
        def rcf-cached-vec(c) = nth(c, 2);
        def rcf-cache-get-key(cache, key, id) = if eq(len(cache), 0) then list() else if and(str_eq(rcf-cached-id(head(cache)), id), str_eq(rcf-cached-key(head(cache)), key)) then rcf-cached-vec(head(cache)) else rcf-cache-get-key(tail(cache), key, id);
        def rcf-cache-get(cache, contract, id) = rcf-cache-get-key(cache, rcf-contract-key(contract), id);
        def rcf-cache-has?(cache, contract, id) = if eq(len(rcf-cache-get(cache, contract, id)), 0) then 0 else 1;
        def rcf-cache-put(cache, contract, id, vec) = if eq(len(vec), rcf-contract-dim(contract)) then cons(rcf-cached(id, rcf-contract-key(contract), vec), cache) else cache;
        def rcf-cache-admit-go(cache, key, dim) = if eq(len(cache), 0) then list() else if and(str_eq(rcf-cached-key(head(cache)), key), eq(len(rcf-cached-vec(head(cache))), dim)) then cons(head(cache), rcf-cache-admit-go(tail(cache), key, dim)) else rcf-cache-admit-go(tail(cache), key, dim);
        def rcf-cache-admit(cache, contract) = rcf-cache-admit-go(cache, rcf-contract-key(contract), rcf-contract-dim(contract));

        // --- list floor ---
        def rcf-take(xs, n) = if or(le(n, 0), eq(len(xs), 0)) then list() else cons(head(xs), rcf-take(tail(xs), sub(n, 1)));
        def rcf-snoc(xs, x) = if eq(len(xs), 0) then list(x) else cons(head(xs), rcf-snoc(tail(xs), x));
        def rcf-in?(id, ids) = if eq(len(ids), 0) then 0 else if str_eq(head(ids), id) then 1 else rcf-in?(id, tail(ids));
        def rcf-count-in(ids, pool) = if eq(len(ids), 0) then 0 else add(rcf-in?(head(ids), pool), rcf-count-in(tail(ids), pool));
        def rcf-same?(xs, ys) = if eq(len(xs), 0) then if eq(len(ys), 0) then 1 else 0 else if eq(len(ys), 0) then 0 else if str_eq(head(xs), head(ys)) then rcf-same?(tail(xs), tail(ys)) else 0;
        def rcf-dedupe-go(ids, seen) = if eq(len(ids), 0) then list() else if eq(rcf-in?(head(ids), seen), 1) then rcf-dedupe-go(tail(ids), seen) else cons(head(ids), rcf-dedupe-go(tail(ids), cons(head(ids), seen)));
        def rcf-dedupe(ids) = rcf-dedupe-go(ids, list());

        // --- hits and misses, in candidate order ---
        def rcf-hits(cache, contract, ids) = if eq(len(ids), 0) then list() else if eq(rcf-cache-has?(cache, contract, head(ids)), 1) then cons(head(ids), rcf-hits(cache, contract, tail(ids))) else rcf-hits(cache, contract, tail(ids));
        def rcf-misses(cache, contract, ids) = if eq(len(ids), 0) then list() else if eq(rcf-cache-has?(cache, contract, head(ids)), 0) then cons(head(ids), rcf-misses(cache, contract, tail(ids))) else rcf-misses(cache, contract, tail(ids));

        // --- the new ear as a table of the vectors it answers ---
        def rcf-ear-vec(ear, id) = if eq(len(ear), 0) then list() else if str_eq(rag-id(head(ear)), id) then rag-vec(head(ear)) else rcf-ear-vec(tail(ear), id);
        def rcf-ear-entries(ear, ids) = if eq(len(ids), 0) then list() else cons(rag-entry(head(ids), rcf-ear-vec(ear, head(ids))), rcf-ear-entries(ear, tail(ids)));
        def rcf-encode-into(cache, contract, ear, ids) = if eq(len(ids), 0) then cache else rcf-encode-into(rcf-cache-put(cache, contract, head(ids), rcf-ear-vec(ear, head(ids))), contract, ear, tail(ids));

        // --- the queue for the background breath ---
        def rcf-enqueue(queue, ids) = if eq(len(ids), 0) then queue else if eq(rcf-in?(head(ids), queue), 1) then rcf-enqueue(queue, tail(ids)) else rcf-enqueue(rcf-snoc(queue, head(ids)), tail(ids));
        def rcf-release(queue, ids) = if eq(len(queue), 0) then list() else if eq(rcf-in?(head(queue), ids), 1) then rcf-release(tail(queue), ids) else cons(head(queue), rcf-release(tail(queue), ids));

        // --- rerank the warm candidates by the new ear; ties keep the source position ---
        def rcf-entries(cache, contract, ids) = if eq(len(ids), 0) then list() else cons(rag-entry(head(ids), rcf-cache-get(cache, contract, head(ids))), rcf-entries(cache, contract, tail(ids)));
        def rcf-rerank(tgt-q, cache, contract, ids) = rag-topk(tgt-q, rcf-entries(cache, contract, ids), len(ids));

        // --- one answer: (state candidates hits misses encoded queued ranked cache queue) ---
        def rcf-serve(src-q, tgt-q, index, cache, contract, ear, k, budget, queue) {
            let cands = rag-topk(src-q, index, k);
            let hits = rcf-hits(cache, contract, cands);
            let misses = rcf-misses(cache, contract, cands);
            let now = rcf-take(misses, budget);
            let cache2 = rcf-encode-into(cache, contract, ear, now);
            let scored = rcf-hits(cache2, contract, cands);
            let still = rcf-misses(cache2, contract, cands);
            let ranked = if eq(len(scored), 0) then cands else rcf-rerank(tgt-q, cache2, contract, scored);
            list(rcf-state(len(scored), len(cands)), cands, len(hits), len(misses), sub(len(scored), len(hits)), len(still), ranked, cache2, rcf-enqueue(queue, still));
        }
        def rcf-answer-state(a) = nth(a, 0);
        def rcf-answer-candidates(a) = nth(a, 1);
        def rcf-answer-hits(a) = nth(a, 2);
        def rcf-answer-misses(a) = nth(a, 3);
        def rcf-answer-encoded(a) = nth(a, 4);
        def rcf-answer-queued(a) = nth(a, 5);
        def rcf-answer-ranked(a) = nth(a, 6);
        def rcf-answer-cache(a) = nth(a, 7);
        def rcf-answer-queue(a) = nth(a, 8);

        // --- the background breath: (cache queue done unanswered) ---
        def rcf-materialize(cache, contract, ear, queue, batch) {
            let claimed = rcf-take(queue, batch);
            let cache2 = rcf-encode-into(cache, contract, ear, claimed);
            list(cache2, rcf-release(queue, claimed), rcf-hits(cache2, contract, claimed), rcf-misses(cache2, contract, claimed));
        }
        def rcf-breath-cache(b) = nth(b, 0);
        def rcf-breath-queue(b) = nth(b, 1);
        def rcf-breath-done(b) = nth(b, 2);
        def rcf-breath-unanswered(b) = nth(b, 3);
        // prewarm a named set now: (cache requested materialized)
        def rcf-prewarm(cache, contract, ear, ids) {
            let missing = rcf-misses(cache, contract, ids);
            let cache2 = rcf-encode-into(cache, contract, ear, missing);
            list(cache2, len(ids), len(rcf-hits(cache2, contract, missing)));
        }
        def rcf-prewarm-cache(p) = nth(p, 0);
        def rcf-prewarm-requested(p) = nth(p, 1);
        def rcf-prewarm-materialized(p) = nth(p, 2);

        // --- measuring, not assuming ---
        def rcf-native(tgt-q, ear, n) = rag-topk(tgt-q, ear, n);
        def rcf-restricted(src-q, tgt-q, index, ear, k) {
            let cands = rag-topk(src-q, index, k);
            rag-topk(tgt-q, rcf-ear-entries(ear, cands), len(cands));
        }
        def rcf-containment(cands, native, n) = if eq(len(rcf-take(native, n)), 0) then 0 else div(mul(rcf-count-in(rcf-take(native, n), cands), 1000), len(rcf-take(native, n)));
        def rcf-relevant-in(ranked, relevant, n) = rcf-count-in(rcf-take(ranked, n), relevant);
        // nDCG per mille: 1000 / log2(i + 1) for ranks 1..10, binary gains, duplicates scored once
        def rcf-rank-weights() = list(1000, 631, 500, 431, 387, 356, 333, 315, 301, 289);
        def rcf-weights-sum(weights, n) = if or(le(n, 0), eq(len(weights), 0)) then 0 else add(head(weights), rcf-weights-sum(tail(weights), sub(n, 1)));
        def rcf-dcg-go(ids, relevant, weights) = if or(eq(len(ids), 0), eq(len(weights), 0)) then 0 else add(if eq(rcf-in?(head(ids), relevant), 1) then head(weights) else 0, rcf-dcg-go(tail(ids), relevant, tail(weights)));
        def rcf-dcg(ranked, relevant, n) = rcf-dcg-go(rcf-take(rcf-dedupe(ranked), n), relevant, rcf-rank-weights());
        def rcf-idcg(relevant, n) = rcf-weights-sum(rcf-rank-weights(), if lt(len(relevant), n) then len(relevant) else n);
        def rcf-ndcg(ranked, relevant, n) = if eq(rcf-idcg(relevant, n), 0) then 0 else div(mul(rcf-dcg(ranked, relevant, n), 1000), rcf-idcg(relevant, n));
        def rcf-gap(native, restricted, relevant, n) = sub(rcf-ndcg(native, relevant, n), rcf-ndcg(restricted, relevant, n));
        def rcf-point(k, gap) = list(k, gap);
        def rcf-point-k(p) = nth(p, 0);
        def rcf-point-gap(p) = nth(p, 1);
        def rcf-curve(src-q, tgt-q, index, ear, relevant, n, ks) = if eq(len(ks), 0) then list() else cons(rcf-point(head(ks), rcf-gap(rcf-native(tgt-q, ear, n), rcf-restricted(src-q, tgt-q, index, ear, head(ks)), relevant, n)), rcf-curve(src-q, tgt-q, index, ear, relevant, n, tail(ks)));
        def rcf-observed-depth(curve, eps) = if eq(len(curve), 0) then 0 else if le(rcf-point-gap(head(curve)), eps) then rcf-point-k(head(curve)) else rcf-observed-depth(tail(curve), eps);

        // --- the approximation axis, apart from the gap ---
        def rcf-ann-pass-permille() = 950;
        def rcf-ann-fidelity(approx, exact, n) = if eq(len(rcf-take(exact, n)), 0) then 0 else div(mul(rcf-count-in(rcf-take(exact, n), rcf-take(approx, n)), 1000), len(rcf-take(exact, n)));
        def rcf-ann-reading(has-reference, fidelity) = if eq(has-reference, 0) then "unknown" else if ge(fidelity, rcf-ann-pass-permille()) then "pass" else "warning";

        // --- the reading before a native index exists ---
        def rcf-ice() = "ice";
        def rcf-water() = "water";
        def rcf-gas() = "gas";
        def rcf-settled-permille() = 50;
        def rcf-unsettled-permille() = 100;
        def rcf-reading(residual, deepest, k) = if and(le(residual, rcf-settled-permille()), le(deepest, k)) then rcf-ice() else if gt(residual, rcf-unsettled-permille()) then rcf-gas() else rcf-water();
        def rcf-stability(src-q, tgt-q, index, ear, k, kmax, n) = rcf-count-in(rcf-take(rcf-restricted(src-q, tgt-q, index, ear, k), n), rcf-take(rcf-restricted(src-q, tgt-q, index, ear, kmax), n));
        def rcf-rank-of(id, ids, at) = if eq(len(ids), 0) then 0 else if str_eq(head(ids), id) then at else rcf-rank-of(id, tail(ids), add(at, 1));
        def rcf-deepest-go(ids, source, best) = if eq(len(ids), 0) then best else if gt(rcf-rank-of(head(ids), source, 1), best) then rcf-deepest-go(tail(ids), source, rcf-rank-of(head(ids), source, 1)) else rcf-deepest-go(tail(ids), source, best);
        def rcf-deepest(src-q, tgt-q, index, ear, kmax, n) = rcf-deepest-go(rcf-take(rcf-restricted(src-q, tgt-q, index, ear, kmax), n), rag-topk(src-q, index, kmax), 0);
        def rcf-residual(src-q, tgt-q, index, ear, k, kmax, n) = div(mul(sub(n, rcf-stability(src-q, tgt-q, index, ear, k, kmax, n)), 1000), n);
        def rcf-read(src-q, tgt-q, index, ear, k, kmax, n) = rcf-reading(rcf-residual(src-q, tgt-q, index, ear, k, kmax, n), rcf-deepest(src-q, tgt-q, index, ear, kmax, n), k);
        // the reading with memory: leaving a phase asks more than entering it
        def rcf-settle(prev, residual, deepest, k) {
            let next = rcf-reading(residual, deepest, k);
            if str_eq(prev, next) then prev
            else if and(str_eq(prev, rcf-ice()), and(le(residual, rcf-unsettled-permille()), le(deepest, k))) then rcf-ice()
            else if and(str_eq(prev, rcf-gas()), gt(residual, rcf-settled-permille())) then rcf-gas()
            else next;
        }
        // the declared rule, folded: settled, unsettled, ann-pass, and the weight table's sum
        def rcf-rule-seal() = add(mul(add(mul(add(mul(rcf-settled-permille(), 1000), rcf-unsettled-permille()), 1000), rcf-ann-pass-permille()), 10000), rcf-weights-sum(rcf-rank-weights(), 10));

        // --- the plan, and the cost of not crossfading ---
        def rcf-fraction(cached, corpus) = if eq(corpus, 0) then 0 else div(mul(cached, 1000), corpus);
        def rcf-plan(reading, ann, corpus, cached, k) = list(if and(str_eq(reading, rcf-ice()), or(str_eq(ann, "pass"), str_eq(ann, "unknown"))) then "ready" else "review", if str_eq(reading, rcf-ice()) then "progressive" else "progressive-with-review", k, rcf-fraction(cached, corpus), add(if str_eq(reading, rcf-ice()) then 0 else 1, add(if str_eq(ann, "pass") then 0 else 1, if gt(cached, corpus) then 1 else 0)));
        def rcf-plan-status(p) = nth(p, 0);
        def rcf-plan-strategy(p) = nth(p, 1);
        def rcf-plan-depth(p) = nth(p, 2);
        def rcf-plan-fraction(p) = nth(p, 3);
        def rcf-plan-warnings(p) = nth(p, 4);
        def rcf-backfill-ms(corpus, cached, ms-per-doc) = if gt(cached, corpus) then 0 else mul(sub(corpus, cached), ms-per-doc);
    }
    0;
}
