// Optional initial reasoning; subsequent actions use the existing controller.
// All generated IDs stay in the resident session. Only final-channel IDs act.
// preludes: form-stdlib/bml/form-cli-code-live.bml
section [form.bml] {
 class FormCliCodeReasoning {
  def fcacr-help() = " Optional max_reply_tokens is a positive integer ceiling for each generated reply, including reasoning; omission preserves the context-only default. A partial reply is retained privately and never acts. Optional initial_reasoning_tokens (positive integer, at most " ++ int_to_str(hearth-code-initial-reasoning-limit()) ++ ") opens reasoning for the first reply of this admission. Its limit includes reasoning and final answer; the smaller reply ceiling and context capacity still apply. An incomplete generation does not act. Later replies use the ordinary controller. Generated reasoning stays in private evidence and outside tool actions and the framebuffer.";
  def fcacr-limit-valid(limit) = (limit > 0) && (limit <= hearth-code-initial-reasoning-limit());
  def fcacr-admit(model,state,checker,context,turns,limit) = fcap-done(state) ? list(state,1,0,0,0) : !fcacr-limit-valid(limit) ? list(fcap-terminal(state,"initial-reasoning-limit-refused"),1,0,0,0) : !fcac-model-ready(model) ? list(fcap-terminal(state,"native-qwen-artifact-seal-tokenizer-or-lane-unavailable"),1,0,0,0) : fcacr-open(model,fcap-begin-context(state),checker,context,turns,limit,now_unix_ms());
  def fcacr-open(model,state,checker,context,turns,limit,started) {
   let session = fcms-open-with-profile(mr-path(mr-find(model)),fcac-bootstrap-budget(state,turns),context,"knowledge-query-reasoning");
   let result = !fcms-live?(session) ? fcac-finish(session,fcap-terminal(state,fcms-reason(session)),started) : !((String) fcms-reason(session) == "opened-live-cursor") ? fcac-finish(session,fcap-terminal(state,"initial-reasoning-requires-live-tokenizer-cursor"),started) : fcacr-first(session,state,checker,turns,limit,started);
   fcac-finish-contexts(result,checker,turns,started,fcap-turns(state),list(0,0,0),1);
  }
  def fcacr-first(session,state,checker,turns,limit,started) {
   let available = (fcms-maxpos(session) - fcms-pos(session)) - 1;
   let generation = fcms-generate(session,fcac-token-allowance(state,fat-min(limit,available)));
   let next = fcms-generation-session(generation);
   let crystal = qsx-load(fcms-path(session));
   let boundary = ((Comparable) head(crystal) == 1) && (crystal[4] >= 0) ? fcrt-answer(fcms-generation-ids(generation),crystal[4]) : list(0,list());
   let answer = head(boundary) ? fat-trim(tkz-decode-text(fcms-src(session),boundary[1])) : "";
   let evidence = fcac-retain-reply(fcms-generation-text(generation));
   print_str("form-code-reasoning " ++ json-emit(json-node-object(list(fcap-shape-n("initial_reply_limit",limit),fcap-shape-n("effective_reply_limit",fcac-token-allowance(state,fat-min(limit,available))),fcap-shape-n("available_positions",available),fcap-shape-n("generated_ids",len(fcms-generation-ids(generation))),fcap-shape-n("boundary_present",head(boundary)),fcap-shape-n("completion_observed",fcms-stopped?(next)),fcap-shape-n("answer_bytes",str_len(answer)),fcap-shape-s("private_generation_evidence",evidence)))));
   (!fcms-stopped?(next)) || (fcms-pending(next) < 0) ? fcac-finish(next,fcap-terminal(state,fcms-pending(next) < 0 ? "initial-reasoning-generation-incomplete;candidate-retained" : fcac-incomplete-reason(state,len(fcms-generation-ids(generation)),evidence,"initial-reasoning-generation-incomplete;candidate-retained")),started) : !head(boundary) ? fcac-finish(next,fcap-terminal(state,"initial-reasoning-boundary-absent;candidate-retained"),started) : fcac-replied(next,state,answer,checker,turns,started);
  }
 }
 0;
}
