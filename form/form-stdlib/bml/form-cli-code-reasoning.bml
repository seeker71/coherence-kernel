// Optional initial reasoning; subsequent actions use the existing controller.
// All generated IDs stay in the resident session. Only final-channel IDs act.
import form-stdlib/bml/form-cli-code-live.bml;
section [form.bml] {
 class FormCliCodeReasoning {
  def fcacr-help() = " Optional max_reply_tokens is a positive integer ceiling for each generated reply, including reasoning; omission preserves the context-only default. A partial reply is retained privately and never acts. Optional initial_reasoning_tokens is a positive integer allowance for the first reply of this admission. Its limit includes reasoning and final answer; explicit reply ceilings and observed context capacity still apply. Reserved reasoning and answer stages must fit their admitted resident. An incomplete generation does not act. Later replies use the ordinary controller. Generated reasoning stays in private evidence and outside tool actions and the framebuffer.";
  def fcacr-limit-valid(limit) = value_kind(limit)=="int" && limit>0;
  def fcacr-admit(model,state,checker,context,turns,limit) = if fcap-done(state) then [state,1,0,0,0] else if (!fcacr-limit-valid(limit)) then [fcap-terminal(state,"initial-reasoning-limit-refused"),1,0,0,0] else if (!fcac-model-ready(model)) then [fcap-terminal(state,"native-qwen-artifact-seal-tokenizer-or-lane-unavailable"),1,0,0,0] else fcac-open-assisted(model,state,checker,context,turns,now_unix_ms(),fcac-helper-ask,(m,s,c,x,t,z)=>fcacr-open(m,s,c,x,t,limit,z));
  def fcacr-open(model,state,checker,context,turns,limit,started) {
   let session = fcacs-open-staged(mr-path(mr-find(model)),fcac-bootstrap-budget(state,turns),context,"knowledge-query-reasoning");
   let result = if (!fcms-live?(session)) then fcac-finish(session,fcap-terminal(state,fcms-reason(session)),started) else if (!((String) fcms-reason(session) == "opened-live-cursor")) then fcac-finish(session,fcap-terminal(state,"initial-reasoning-requires-live-tokenizer-cursor"),started) else fcacr-first(session,state,checker,turns,limit,started);
   fcac-finish-contexts(result,checker,turns,started,fcap-turns(state),[0,0,0],1);
  }
  def fcacr-first(session,state,checker,turns,limit,started) {
   let available = ((fcms-maxpos(session) - fcms-pos(session)) - 1);
   let generation = fcms-generate(session,fcac-token-allowance(state,fat-min(limit,available)));
   let next = fcms-generation-session(generation);
   let crystal = qsx-load(fcms-path(session));
   let boundary = if (((Comparable) crystal[0] == 1) && (crystal[4] >= 0)) then fcrt-answer(fcms-generation-ids(generation),crystal[4]) else [0,[]];
   let answer = if boundary[0] then fat-trim(tkz-decode-text(fcms-src(session),boundary[1])) else "";
   let evidence = fcac-retain-reply(fcms-generation-text(generation));
   print_str(("form-code-reasoning " + json-emit(json-node-object([fcap-shape-n("initial_reply_limit",limit),fcap-shape-n("effective_reply_limit",fcac-token-allowance(state,fat-min(limit,available))),fcap-shape-n("available_positions",available),fcap-shape-n("generated_ids",len(fcms-generation-ids(generation))),fcap-shape-n("boundary_present",boundary[0]),fcap-shape-n("completion_observed",fcms-stopped?(next)),fcap-shape-n("answer_bytes",len(answer)),fcap-shape-s("private_generation_evidence",evidence)]))));
   if ((!fcms-stopped?(next)) || (fcms-pending(next) < 0)) then fcac-finish(next,fcap-terminal(state,if (fcms-pending(next) < 0) then "initial-reasoning-generation-incomplete;candidate-retained" else fcac-incomplete-reason(state,len(fcms-generation-ids(generation)),evidence,"initial-reasoning-generation-incomplete;candidate-retained")),started) else if (!boundary[0]) then fcac-finish(next,fcap-terminal(state,"initial-reasoning-boundary-absent;candidate-retained"),started) else fcac-replied(next,state,answer,checker,turns,started);
  }
 }
 0;
}
