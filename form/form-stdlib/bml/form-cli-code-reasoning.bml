// Optional initial reasoning; subsequent actions use the existing controller.
// All generated IDs stay in the resident session. Only final-channel IDs act.
// preludes: form-stdlib/bml/form-cli-code-live.bml
section [form.bml] {
 class FormCliCodeReasoning {
  def fcacr-help() = str_concat(" Optional initial_reasoning_tokens (positive integer, at most ",str_concat(int_to_str(hearth-code-initial-reasoning-limit()),") opens reasoning for the first reply of this admission. Its limit includes reasoning and final answer; context capacity still applies. An incomplete generation does not act. Later replies use the ordinary controller. Generated reasoning stays in private evidence and outside tool actions and the framebuffer."));
  def fcacr-limit-valid(limit) = and(gt(limit,0),le(limit,hearth-code-initial-reasoning-limit()));
  def fcacr-admit(model,state,checker,context,turns,limit) = if fcap-done(state) then list(state,1,0,0,0) else if not(fcacr-limit-valid(limit)) then list(fcap-terminal(state,"initial-reasoning-limit-refused"),1,0,0,0) else if not(fcac-model-ready(model)) then list(fcap-terminal(state,"native-qwen-artifact-seal-tokenizer-or-lane-unavailable"),1,0,0,0) else fcacr-open(model,fcap-begin-context(state),checker,context,turns,limit,now_unix_ms());
  def fcacr-open(model,state,checker,context,turns,limit,started) {
   let session = fcms-open-with-profile(mr-path(mr-find(model)),fcac-bootstrap-budget(state,turns),context,"knowledge-query-reasoning");
   let result = if not(fcms-live?(session)) then fcac-finish(session,fcap-terminal(state,fcms-reason(session)),started) else if not(str_eq(fcms-reason(session),"opened-live-cursor")) then fcac-finish(session,fcap-terminal(state,"initial-reasoning-requires-live-tokenizer-cursor"),started) else fcacr-first(session,state,checker,turns,limit,started);
   fcac-settle(result,started);
  }
  def fcacr-first(session,state,checker,turns,limit,started) {
   let available = sub(sub(fcms-maxpos(session),fcms-pos(session)),1);
   let generation = fcms-generate(session,fat-min(limit,available));
   let next = fcms-generation-session(generation);
   let crystal = qsx-load(fcms-path(session));
   let boundary = if and(eq(head(crystal),1),ge(nth(crystal,4),0)) then fcrt-answer(fcms-generation-ids(generation),nth(crystal,4)) else list(0,list());
   let answer = if head(boundary) then fat-trim(tkz-decode-text(fcms-src(session),nth(boundary,1))) else "";
   let evidence = fcac-retain-reply(fcms-generation-text(generation));
   print_str(str_concat("form-code-reasoning ",json-emit(json-node-object(list(fcap-shape-n("initial_reply_limit",limit),fcap-shape-n("available_positions",available),fcap-shape-n("generated_ids",len(fcms-generation-ids(generation))),fcap-shape-n("boundary_present",head(boundary)),fcap-shape-n("completion_observed",fcms-stopped?(next)),fcap-shape-n("answer_bytes",str_len(answer)),fcap-shape-s("private_generation_evidence",evidence))))));
   if or(not(fcms-stopped?(next)),lt(fcms-pending(next),0)) then fcac-finish(next,fcap-terminal(state,"initial-reasoning-generation-incomplete;candidate-retained"),started) else if not(head(boundary)) then fcac-finish(next,fcap-terminal(state,"initial-reasoning-boundary-absent;candidate-retained"),started) else fcac-replied(next,state,answer,checker,turns,started);
  }
 }
 0;
}
