package Form.native.llama32threeb;

import Form.kernel.*;
import Form.native.metal.*;

interface ILlama32ThreeBResidentState [public, witness, reusable] {
   section [public] {
      const String Schema = "llama32-3b-resident-state-v1";
      const String OpenRule = "one Form call maps weights and allocates reusable scratch and KV state";
      const String RetainRule = "close is explicit; a completed turn does not imply release";
      const String PrefixRule = "prefill state remains in its living context for later decode";
      const String PhysicalRule = "residence requires a positive mmap-backed embedding Metal handle";
      const String LifecycleRule = "prefill and decode return to resident state; loaded, prefilled, active, and released remain independent facts rather than temperatures";

      bool Resident() [abstract];
      Object Prefill( Object ids ) [abstract];
      Object Step() [abstract];
      int Close() [abstract];
   }
}

class Llama32ThreeBResidentState [public, resident, flow, observable] : ILlama32ThreeBResidentState {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/llama32-3b-resident-state.bml";
      const String ModelId = "base.llama32-3b-metal";
      const int PhysicalWeightBytes = 2019377376;

      bool Resident() [abstract] {}
      Object Prefill( Object ids ) [abstract] {}
      Object Step() [abstract] {}
      int Close() [abstract] {}
   }
}
