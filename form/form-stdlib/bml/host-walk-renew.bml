// host-walk-renew.bml — a walk's steps run the code its own sync brought: after the sync, the door begins itself again.
//
// A door compiles its whole closure when it starts, and its sync rewrites that closure under it: a rule the door itself
// evaluates after the sync is the tree's code from before it, while a child begun after the sync compiles the tree the sync
// left (2026-11-03: the night's movement request ran a carry list that did not name receipts/alignment-answers, where the
// exam it had begun after the sync kept 24 answers). So a walk door has two starts (hw-walk-door):
//   the launched start  (launchd's, the retry's, a hand start: no renewal on its stdin) walks its door's prologue: the claim
//                       and the slot stamp (hw-begin), the heal, the sync, the build and the carrier. It then begins its own
//                       argv again (hw-renew): the same program by the same word, so ./fkwu is the kernel the build placed, and
//                       the same door, compiled from the tree the sync left. The child holds this process's own stdout and
//                       stderr (its lines land in the job's log, as the launcher's child's do) and reads one line on its stdin,
//                       {"renewal":{...}}: this start's pid ("from") and the pairs the prologue hands on (hw-renewal-pairs: the
//                       window's end on host_monotonic_ms, the day, the slot hour, the safe flag, the branch, and the sync, build
//                       and carrier lines; a door adds its own, the day turn its continuation's options). The launched start
//                       waits on it with no deadline, as the launcher waits on it, and ends with it: its value the line
//                       "[walk-renew] the renewed walk ended 0", or it ends 1 naming how the renewed one ended.
//   the renewed start   takes the walk from the start that began it (hw-renewed): the renewal carries every pair a walk reads,
//                       names this process's parent, and the lock names that parent and this door. From then on the lock and the
//                       slot stamp name this process (the stamp keeps the time its slot began), and it says "[walk-lock] <door>
//                       holds this checkout, pid <pid>, renewed from pid <from> after its sync". It walks the door's steps with
//                       the pairs it was handed: the turns, what learns, the movement, the carry and the release, each the code
//                       the sync brought. A renewal it cannot take walks nothing and ends 1 by name.
// The lock is claimed once (the launched start's mkdir), handed once (its owner file, by the renewed start) and released once
// (the renewed start's hw-release). A renewed start that ended before it took the walk leaves the lock named by its parent, which
// then ends 1; one that died after leaves it named by itself: a later start finds the holder gone and takes it over, and the retry
// reads a crash (host-walk-class.bml), as when the door walked its steps itself. The renewal line passes from the code one walk
// compiled to the code its sync brought, so a pair keeps its name and meaning, and a reader gives a pair added later its value
// when the line lacks it. Its evidence stands as a step's: .hearth/walk-io/renew.in (the line handed), renew.exit, renew.finding.
// What it holds: the two starts (hw-walk-door), the renewal's line and its readers (hw-renewal, hw-renewal-pairs, hw-renewal-line),
// the launched start's renewal (hw-renew, hw-renew-run, hw-renew-ended) and the renewed start's take (hw-renewed, hw-handed).
// What it needs: host-walk-text.bml, host-walk-lock.bml (the owner file and hw-own), host-walk-began.bml (the slot stamp) and
// host-child.bml (a step's evidence files, the wait and the reaping; its doors keep a child's output in a file, and this child's
// output is the job's own, so the spawn stands here).
// PROOF: form-stdlib/tests/host-walk-band.bml (claim "renewal": a scratch walk whose main moves a carry list under it builds its
// request with the list its sync brought; form-stdlib/tests/fixtures/walk-renew-door.bml is the door it begins).
import form-stdlib/bml/host-walk-text.bml;
import form-stdlib/bml/host-walk-lock.bml;
import form-stdlib/bml/host-walk-began.bml;
import form-stdlib/bml/host-child.bml;
section [form.bml] {
 class HostWalkRenew {
  // a walk door's two starts: one handed a renewal takes the walk and walks steps(renewal); any other walks prologue(text),
  // whose answer is the pairs it hands on, or nothing() when it holds no walk (its lines said why), and renews with them
  def hw-walk-door(door, text, prologue, steps) {
   let renewal = hw-renewal(text);
   nothing?(renewal) ? hw-renewing(prologue(text)) : hw-renewed-walk(door, renewal, steps);
  }
  def hw-renewing(pairs) = nothing?(pairs) ? 0 : hw-renew(pairs);
  def hw-renewed-walk(door, renewal, steps) {
   let taken = hw-renewed(door, renewal);
   let said = print_str(taken[1]);
   (Comparable) taken[0] == 1 ? steps(renewal) : form_error(taken[1]);
  }
  // ── the renewal's line ──
  // the renewal a start was handed: the object under "renewal" on its stdin line; nothing() for a launched start
  def hw-renewal(text) {
   let line = trim(text ?? "");
   let doc = len(line) > 0 && (Comparable) str_byte_at(line, 0) == 123 ? parse-json("walk-renewal", line) : json-node-object([]);
   json-object-has?(doc, "renewal") ? json-object-get(doc, "renewal") : nothing();
  }
  // the pairs every walk door hands on; the steps say the sync, build and carrier lines and read the sync (hw-conflicted?)
  def hw-renewal-pairs(until, day, hhmm, safe, branch, sync, build, carrier) = [fhn-n("until_ms", until), fhn-s("day", day), fhn-n("hhmm", hhmm), fhn-n("safe", safe ? 1 : 0), fhn-s("branch", branch), fhn-s("sync", sync), fhn-s("build", build), fhn-s("carrier", carrier)];
  def hw-renewal-keys() = ["from", "until_ms", "day", "hhmm", "safe", "branch", "sync", "build", "carrier"];
  def hw-renewal-line(from, pairs) = json-emit(json-node-object([json-node-pair("renewal", json-node-object(cons(fhn-n("from", from), pairs)))])) ++ "\n";
  // ── the launched start: its own argv begun again, the renewal's line on its stdin, waited on with no deadline ──
  // this process as the host tells it: its argv (the program and the door as they were begun) and its parent
  def hw-own-row() = host_process(host_pid());
  def hw-own-argv() {
   let me = hw-own-row();
   (String) value_kind(me) == "list" && len(me) > 4 && (String) value_kind(me[4]) == "list" ? me[4] : [];
  }
  def hw-parent-pid() {
   let me = hw-own-row();
   (String) value_kind(me) == "list" && len(me) > 1 && (String) value_kind(me[1]) == "int" ? me[1] : nothing();
  }
  def hw-renew(pairs) = hw-renew-ended(hw-renew-run(hch-dir(), hw-own-argv(), hw-renewal-line(host_pid(), pairs)));
  // a child that speaks where this process speaks: "" for its stdout and stderr keeps this process's own; [status, text, why]
  // as host-child.bml answers, the text "" (what it said is in this process's streams) or a signal's finding
  def hw-renew-run(io, argv, line) {
   let made = hch-mkdirs(io);
   let rotated = hch-rotate(io, "renew");
   let out = hch-out-path(io, "renew");
   let cleared = host_path_remove(out);
   let from = hch-input(io, "renew", line);
   let pid = nil?(argv) ? nothing() : host_spawn_at(argv, [from, "", ""]);
   nil?(argv) ? hch-unborn-why(io, "renew", out, "birth refused: this process's own argv did not read") : nothing?(pid) || pid <= 0 ? hch-unborn(io, "renew", out, pid) : hch-answer(io, "renew", out, hch-wait(pid, nothing()));
  }
  def hw-renew-ended(run) = hch-ok?(run) ? "[walk-renew] the renewed walk ended 0" : form_error("[walk-renew] the renewed walk " ++ (nothing?(run[0]) ? "gave no exit: " ++ run[2] : "ended " ++ run[0].str()) ++ ((String) trim(run[1] ?? "") == "" ? "" : ": " ++ trim(run[1])) ++ "; the renewal it was handed stands in " ++ hch-in-path(hch-dir(), "renew"));
  // ── the renewed start: the walk taken from the start that began it ──
  // [1, line] when it walks, [0, line] when it does not
  def hw-renewed(door, renewal) = hw-renewed-at(hw-lock(), hw-slot-path(), door, renewal, hw-parent-pid(), host_pid(), now_unix_ms());
  def hw-renewed-at(lock, path, door, renewal, parent, pid, now) {
   let missing = filter(k => !json-object-has?(renewal, k), hw-renewal-keys());
   let from = nil?(missing) ? hw-row-int(renewal, "from") : nothing();
   let owner = hw-owner(lock);
   let why = !nil?(missing) ? "the renewal carries no " ++ hch-join(missing, ", ") : nothing?(parent) || (Comparable) parent != from ? "pid " ++ from.str() ++ " did not begin this start" : nothing?(hw-field(owner, "pid=")) || (Comparable) hw-field(owner, "pid=") != from || (String) hw-owner-door(owner) != door ? "the lock reads '" ++ trim(owner) ++ "', not " ++ door ++ " pid " ++ from.str() : "";
   (String) why != "" ? [0, "[walk-lock] " ++ door ++ " renewal refused: " ++ why] : hw-handed(lock, path, door, from, pid, now);
  }
  // the lock's owner file and this door's slot row name this process; the row keeps the time its slot began
  def hw-handed(lock, path, door, from, pid, now) {
   let row = hw-slot-row(path, door);
   let began = !nothing?(hw-field(row, "pid=")) && (Comparable) hw-field(row, "pid=") == from ? hw-field(row, " at=") ?? now : now;
   let held = hw-own(lock, door, pid, now, ", renewed from pid " ++ from.str() ++ " after its sync");
   (Comparable) held[0] != 1 ? held : [1, held[1] ++ hw-begun-said(hw-slot-stamp(path, door, pid, began), false)];
  }
 }
}
