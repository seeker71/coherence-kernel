interface INodeidKnow [public, witness, reusable] {
   section [public] {
      const String TrustRule = "lookup is kra; wrap is an offer; unknown is nothing; ask pays outside";

      Object Know( String q ) [abstract];
      Object KnowReply( String q ) [abstract];
      int CatalogOk() [abstract];
   }
}

template KnowRow<TQuery> [public, reusable] {
   section [public] {
      TQuery Query() [get];
      Object Held() [get];
   }
}

class FormNodeidKnow [public, reusable, teach] : INodeidKnow {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-nodeid-know.bml";
      Object Know( String q ) [abstract] {}
      Object KnowReply( String q ) [abstract] {}
      int CatalogOk() [abstract] {}
   }
}

class FormNodeidKnowSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-nodeid-know-self";
      const String Pattern = "kra-lookup offer-wrap ask-outside agree-with-organ";
