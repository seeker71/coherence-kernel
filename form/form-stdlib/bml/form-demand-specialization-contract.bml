package Form.runtime.demandspecialization;

import Form.kernel.*;
import Form.glass.*;

interface IFormDemandSpecializationContract [public, witness, reusable] {
   section [public] {
      const String Schema = "form-demand-specialization-contract-v1";
      const String SourceRule = "present source is directly runnable; an acceleration artifact is optional and never establishes semantic readiness";
      const String JitRule = "a pure recipe at observed heat 5 or above may crystallize; after explicit decay, heat below 2 may melt it; below threshold or without purity the source remains walkable";
      const String JitEvidenceRule = "an absent or stale acceleration artifact proves only catalog compatibility facts, not demand or JIT; after-start JIT requires an observed resumable compiler and same-process installer";
      const String ModelRule = "loaded, prefilled, active, resident, idle, and released are independent model facts; none is inferred from an acceleration artifact";
      const String EvictionRule = "memory pressure chooses a policy-ranked eligible unit by grain, use count, and last use; active units are excluded";
      const String PageRule = "logical access age, model residence, JIT heat, and OS or Metal page residency are four separate axes";
      const String AdmissionSeam = "the current fkwu whole-unit BML admission may synchronously materialize a closure before the first Glass frame; this pending carrier seam is not described as JIT behavior";
   }
}

class FormDemandSpecializationContract [public, resident, observable, teach] : IFormDemandSpecializationContract {
   section [public] {
      const String AuthorityPath = "form/form-stdlib/bml/form-demand-specialization-contract.bml";
      const String ProofPath = "form/form-stdlib/tests/form-demand-specialization-contract-band.fk";
   }
}
