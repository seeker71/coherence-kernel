   };
  };
  def nia-close(owner) = if not(nia-owned?(owner)) then 0 else if gt(nra-live-views(record_get(owner,"views")),0) then nia-unease(owner,"retirement","released-prefix-readers") else if not(nra-outputs-closed(record_get(nia-memory(owner),"regions"))) then nia-unease(owner,"retirement","released-output-regions") else {
   record_set(owner,"active",2); let root = record_get(owner,"root");
   let retired = if or(nothing?(root),eq(record_get(owner,"code-live"),0)) then 1 else nia-invoke(owner,list(3,nia-root(owner)));
   if not(eq(retired,1)) then nia-unease(owner,"chunk-retirement","released-native-chunks") else {
    if not(record_has(owner,"retired-state")) then record_set(owner,"retired-state",if nothing?(root) then json-node-object(list(oh-n("mapped_requested_bytes",0))) else nia-live-state(owner)) else 0;
    let code = if eq(record_get(owner,"code-live"),1) then jit_leaf_inram(list(1,record_get(owner,"identity"),list()),0) else 1;
    if not(eq(code,1)) then nia-unease(owner,"code-retirement","released-arena-code") else { record_set(owner,"code-live",0); let closed = nra-close(record_get(owner,"carrier")); if eq(closed,1) then record_set(owner,"active",0) else 0; closed; };
   };
  };
 }
 0;
}
