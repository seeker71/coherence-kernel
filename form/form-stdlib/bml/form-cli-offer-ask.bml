//////////////////////////////////////////////////////////////////////
//
// form-cli-offer-ask.bml — high-grammar authority.
//
// An answer is an Offer<T>, not decoded tokens. Naming is an offer.
// Ask replies T. Unknown lookup is exact nothing. The catalog is
// generated: N is an argument, not a table of rows. Cost stays
// outside the local LLM stream.
//
// This is the lift of the Form list-walkers (fnid / fnk) into a
// generic reusable shape. The organ stays; the authoring rises.
//
// Executable: form-stdlib/form-cli-offer-ask.bml
// Proven by: form-stdlib/tests/form-cli-offer-ask-bml-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.offerask;

import Form.kernel.*;
import Form.cli.flow.*;

enum Delay [public] {
   OFFER,
   ASK
}

enum Cost [public] {
   OUTSIDE,
   STREAM
}

interface IAsk<T> [public, witness, reusable] {
   section [public] {
      const int DelayOffer = 0;
      const int DelayAsk = 1;
      const int CostOutside = 0;
      const String TrustRule = "offer without ask replies nothing; unknown lookup is nothing; catalog is generated; body lookup is kra then corpus";

      Object Offer( T value ) [abstract];
      Object Ask( Object hOffer ) [abstract];
      Object Reply( Object hOffer ) [abstract];
   }
}

template Offer<T> [public, reusable] {
   section [public] {
      int Delay() [get];
      int Cost() [get];
      T Payload() [get];
   }
}

template QueryRow<TQuery, T> [public, reusable] {
   section [public] {
      TQuery Query() [get];
      Offer<T> Held() [get];
   }
}

interface IKnowledge<TQuery, T> [public, witness, reusable] {
   section [public] {
      Offer<T> Lookup( TQuery q ) [abstract];
      T AskQuery( TQuery q ) [abstract];
      Object Catalog( int nN ) [abstract];
   }
}

class FormOfferAsk [public, reusable, teach] : IAsk<Object>, IKnowledge<String, Object> {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-offer-ask.bml";
      const int MixA = 7;
      const int MixB = 13;

      Object Offer( Object value ) [abstract] {}
      Object Ask( Object hOffer ) [abstract] {}
      Object Reply( Object hOffer ) [abstract] {}
      Offer<Object> Lookup( String q ) [abstract] {}
      Object AskQuery( String q ) [abstract] {}
      Object Catalog( int nN ) [abstract] {}
   }
}

class FormOfferAskSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-offer-ask-self";
      const String Pattern = "offer-ask lookup-not-guess catalog-generated body-kra-corpus cost-outside";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
