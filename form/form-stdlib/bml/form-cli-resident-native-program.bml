//////////////////////////////////////////////////////////////////////
// form-cli-resident-native-program.bml -- high-grammar declaration of
// a small Form-native thought program that a live resident can load once
// and invoke by NodeID without a process, HTTP, or model crossing.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk form-stdlib/language-template.fk form-stdlib/form-definition-language.fk form-stdlib/form-resident-pif-core-eval.fk

section [form.bml] {
    template ResidentNativeProgram<TSource> {
        member name: text;
        member module: TSource;
        member route: text;
    }

    class FormCliResidentNativeProgram {
        field ProgramName = "form-native-signal";
        field Route = "resident-native-program";
        field GrammarRule = "bmf-definition-module-lowers-before-resident-nodeid-load";
        field ReuseRule = "one-loaded-nodeid-serves-many-in-process-invocations";
        field SignalRule = "nothing-zero-one-and-value-remain-distinct-through-the-resident-receipt";
        field PresenceRule = "zero-is-present-and-is-not-nothing";
        field NoMembraneRule = "no-host-exec-http-or-model-call-enters-program-load-or-invoke";
        field ModulePrefix = "module resident { fn ninc";

        def fcrnp-name() = ProgramName();
        def fcrnp-route() = Route();
        def fcrnp-grammar-rule() = GrammarRule();
        def fcrnp-reuse-rule() = ReuseRule();
        def fcrnp-signal-rule() = SignalRule();
        def fcrnp-presence-rule() = PresenceRule();
        def fcrnp-no-membrane-rule() = NoMembraneRule();
        def fcrnp-zero-is-value?() = if and(not(nothing?(0)), not(eq(0, nothing()))) then 1 else 0;
        // The Form source punctuation is born as bytes, not parsed while this
        // BML module is lowered. The later BMF cursor receives the completed
        // module surface exactly once.
        def fcrnp-open() = byte_to_str(40);
        def fcrnp-close() = byte_to_str(41);
        def fcrnp-comma() = byte_to_str(44);
        def fcrnp-module-part1() = str_concat(ModulePrefix(), fcrnp-open());
        def fcrnp-module-part2() = str_concat(fcrnp-module-part1(), "x");
        def fcrnp-module-part3() = str_concat(fcrnp-module-part2(), fcrnp-close());
        def fcrnp-module-part4() = str_concat(fcrnp-module-part3(), " = add");
        def fcrnp-module-part5() = str_concat(fcrnp-module-part4(), fcrnp-open());
        def fcrnp-module-part6() = str_concat(fcrnp-module-part5(), "x");
        def fcrnp-module-part7() = str_concat(fcrnp-module-part6(), fcrnp-comma());
        def fcrnp-module-part8() = str_concat(fcrnp-module-part7(), "1");
        def fcrnp-module-part9() = str_concat(fcrnp-module-part8(), fcrnp-close());
        def fcrnp-module-source() = str_concat(fcrnp-module-part9(), "; }");
        def fcrnp-program? (name) = if str_eq(name, fcrnp-name()) then 1 else 0;

        // The generated resident source is assembled from BML-held byte
        // punctuation. BML's own cursor never has to mistake those Form
        // delimiters for BML syntax.
        def fcrnp-form-open() = byte_to_str(40);
        def fcrnp-signal-part1() = str_concat(fcrnp-form-open(), "defn form-native-signal ");
        def fcrnp-signal-part2() = str_concat(fcrnp-signal-part1(), fcrnp-form-open());
        def fcrnp-signal-part3() = str_concat(fcrnp-signal-part2(), "signal");
        def fcrnp-signal-part4() = str_concat(fcrnp-signal-part3(), fcrnp-close());
        def fcrnp-signal-part5() = str_concat(fcrnp-signal-part4(), " ");
        def fcrnp-signal-part6() = str_concat(fcrnp-signal-part5(), fcrnp-form-open());
        def fcrnp-signal-part7() = str_concat(fcrnp-signal-part6(), "if ");
        def fcrnp-signal-part8() = str_concat(fcrnp-signal-part7(), fcrnp-form-open());
        def fcrnp-signal-part9() = str_concat(fcrnp-signal-part8(), "eq signal 0");
        def fcrnp-signal-part10() = str_concat(fcrnp-signal-part9(), fcrnp-close());
        def fcrnp-signal-part11() = str_concat(fcrnp-signal-part10(), " nothing ");
        def fcrnp-signal-part12() = str_concat(fcrnp-signal-part11(), fcrnp-form-open());
        def fcrnp-signal-part13() = str_concat(fcrnp-signal-part12(), "if ");
        def fcrnp-signal-part14() = str_concat(fcrnp-signal-part13(), fcrnp-form-open());
        def fcrnp-signal-part15() = str_concat(fcrnp-signal-part14(), "eq signal 1");
        def fcrnp-signal-part16() = str_concat(fcrnp-signal-part15(), fcrnp-close());
        def fcrnp-signal-part17() = str_concat(fcrnp-signal-part16(), " 1 ");
        def fcrnp-signal-part18() = str_concat(fcrnp-signal-part17(), fcrnp-form-open());
        def fcrnp-signal-part19() = str_concat(fcrnp-signal-part18(), "ninc signal");
        def fcrnp-signal-part20() = str_concat(fcrnp-signal-part19(), fcrnp-close());
        def fcrnp-signal-part21() = str_concat(fcrnp-signal-part20(), fcrnp-close());
        def fcrnp-signal-part22() = str_concat(fcrnp-signal-part21(), fcrnp-close());
        def fcrnp-signal-source() = str_concat(fcrnp-signal-part22(), fcrnp-close());

        def fcrnp-compile(module_source) {
            let module = fdl-parse(module_source);
            if not(fdl-ok?(module)) then list("choice", nothing(), "bmf-module-refused") else list("value", str_concat(fcrnp-form-open(), str_concat("do ", str_concat(fdl-module-source(module), str_concat("\n", str_concat(fcrnp-signal-source(), str_concat("\n0", fcrnp-close())))))), "bmf-module-lowered-to-resident-source");
        }
        def fcrnp-compile-status(compile) = nth(compile, 0);
        def fcrnp-compile-source(compile) = nth(compile, 1);
        def fcrnp-compile-reason(compile) = nth(compile, 2);

        def fcrnp-loaded(state, compile, identity, status, reason) = list("form-cli-resident-native-program-load-v1", state, compile, identity, status, reason);
        def fcrnp-loaded-state(loaded) = nth(loaded, 1);
        def fcrnp-loaded-compile(loaded) = nth(loaded, 2);
        def fcrnp-loaded-identity(loaded) = nth(loaded, 3);
        def fcrnp-loaded-status(loaded) = nth(loaded, 4);
        def fcrnp-loaded-reason(loaded) = nth(loaded, 5);
        def fcrnp-loaded?(loaded) = if nothing?(loaded) then 0 else if not(eq(len(loaded), 6)) then 0 else if str_eq(nth(loaded, 0), "form-cli-resident-native-program-load-v1") then 1 else 0;
        def fcrnp-load-evaluated(state, compile) {
            let next = frpce-eval(state, fcrnp-compile-source(compile));
            let identity = frpce-identity(next);
            if nothing?(identity) then fcrnp-loaded(state, compile, nothing(), "nothing", "resident-program-defined-no-nodeid") else fcrnp-loaded(next, compile, identity, "returned", "resident-program-nodeid-retained");
        }
        def fcrnp-load(state) {
            let compile = fcrnp-compile(fcrnp-module-source());
            if not(str_eq(fcrnp-compile-status(compile), "value")) then fcrnp-loaded(state, compile, nothing(), "choice", fcrnp-compile-reason(compile)) else fcrnp-load-evaluated(state, compile);
        }

        def fcrnp-invocation(loaded, receipt, signal, reason) = list("form-cli-resident-native-program-invoke-v1", loaded, receipt, signal, reason, fcrnp-route(), 0, 0);
        def fcrnp-invocation-loaded(invocation) = nth(invocation, 1);
        def fcrnp-invocation-receipt(invocation) = nth(invocation, 2);
        def fcrnp-invocation-signal(invocation) = nth(invocation, 3);
        def fcrnp-invocation-reason(invocation) = nth(invocation, 4);
        def fcrnp-invocation-route(invocation) = nth(invocation, 5);
        def fcrnp-invocation-model-executed(invocation) = nth(invocation, 6);
        def fcrnp-invocation-host-crossings(invocation) = nth(invocation, 7);
        def fcrnp-invocation-value(invocation) = if nothing?(fcrnp-invocation-receipt(invocation)) then nothing() else frpce-receipt-value(fcrnp-invocation-receipt(invocation));
        def fcrnp-invoke-loaded(loaded, signal) {
            let receipt = frpce-invoke-one(fcrnp-loaded-state(loaded), fcrnp-loaded-identity(loaded), signal);
            fcrnp-invocation(loaded, receipt, frpce-signal(frpce-receipt-value(receipt)), frpce-receipt-reason(receipt));
        }
        def fcrnp-invoke(loaded, signal) = if not(eq(fcrnp-loaded?(loaded), 1)) then fcrnp-invocation(loaded, nothing(), "choice", "malformed-loaded-program") else if not(str_eq(fcrnp-loaded-status(loaded), "returned")) then fcrnp-invocation(loaded, nothing(), "choice", "resident-program-not-loaded") else fcrnp-invoke-loaded(loaded, signal);
    }
    0;
}
