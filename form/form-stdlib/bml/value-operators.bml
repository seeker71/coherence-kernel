// Shared value semantics behind BML operators. Kind branches are available to
// native specialization; receivers and operands arrive once in source order.
import form-stdlib/core.fk;
import form-stdlib/bml/string-join.bml;
section [form.bml] {
 def bml-value-number?(value) = (String) value_kind(value) == "int" || (String) value_kind(value) == "float";
 def bml-value-equal(a,b) = bml-value-number?(a) && bml-value-number?(b) ? (Comparable) a == b :
  (String) value_kind(a) == "list" && (String) value_kind(b) == "list" ?
   bml-value-list-equal(a,b) : ((Value) a == b);
 // the recursive call is the conditional's own branch, a tail call: a list of any length compares in constant stack
 // (the `&&` form put it to the right of an and, one frame per element: two lists of 416 thousand token ids stopped the
 // trainer's startup on the walker's 266 MB stack)
 def bml-value-list-equal(a,b) = nil?(a) ? nil?(b) :
  nil?(b) ? 0 :
  bml-value-equal(a[0],b[0]) ? bml-value-list-equal(a[1:],b[1:]) : 0;
 def bml-value-add(a,b) = (String) value_kind(a) == "string" && (String) value_kind(b) == "string" ? str_concat(a,b) :
  (String) value_kind(a) == "list" && (String) value_kind(b) == "list" ? append(a,b) : add(a,b);
 def bml-value-join(values,separator) = value_kind(values)=="list" && value_kind(separator)=="string" ? str-join-with(map(value=>value.str(),values),separator) : form_error("join needs a list and a string separator");
 def bml-value-index(xs,index) {
  let offset = index < 0 ? len(xs) + index : index;
  offset < 0 ? nothing : (String) value_kind(xs) == "string" ?
   (offset >= len(xs) ? nothing : byte_to_str(str_byte_at(xs,offset))) : (offset == 0 ? head(xs) : nth(xs,offset));
 }
 def bml-value-first(xs) = (String) value_kind(xs) == "string" ?
  (len(xs) == 0 ? nothing : byte_to_str(str_byte_at(xs,0))) : head(xs);
 def bml-slice-bound(index,size) = max2(0,index < 0 ? size + index : min2(index,size));
 def bml-value-tail(xs) = (String) value_kind(xs) == "string" ? substring(xs,1,len(xs)) : tail(xs);
 def bml-value-slice(xs,first,last) {
  let start = nothing?(first) ? 0 : first;
  if (String) value_kind(xs) == "string" then {
   let size = len(xs);
   substring(xs,bml-slice-bound(start,size),nothing?(last) ? size : bml-slice-bound(last,size));
  } else {
   let size = start < 0 || (!nothing?(last) && last < 0) ? len(xs) : 0;
   let from = max2(0,start < 0 ? size + start : start);
   let rest = drop(from,xs);
   nothing?(last) ? rest : take(max2(0,(last < 0 ? size + last : last) - from),rest);
  };
 }
}
