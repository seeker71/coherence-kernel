// A GGUF ask remains in one fkwu process: metadata, tokenizer, program emission,
// mapped weights, decoding, costs, identity and publication are owned by Form.
// The current executable model is the registry's llama32-3b content identity.
// Tokenization is the existing longest-vocabulary-match algorithm.
// preludes: form-stdlib/llama32-3b-resident-state.bml form-stdlib/llama3-tokenize.fk form-stdlib/model-registry.bml form-stdlib/ask-native-lane.fk native/metal/ask-declared-cost.fk form-stdlib/bml/sha256-owned.bml form-stdlib/organ-health.bml form-stdlib/form-fs.fk
section [form.bml] {
 class MetalAsk {
  def ma-cat(xs) = if nil?(xs) then "" else str_concat(head(xs),ma-cat(tail(xs)));
  def ma-put(owner,pairs) = if nil?(pairs) then owner else ma-put-next(owner,pairs,record_set(owner,head(head(pairs)),nth(head(pairs),1)));
  def ma-put-next(owner,pairs,kept) = ma-put(owner,tail(pairs));
  def ma-model() = "llama3.2:3b";
  def ma-blob() = mr-path(mr-find("llama32-3b"));
  def ma-identity() = substring(fs-path-basename(ma-blob()),7,71);
  def ma-hex(raw,i) = if ge(i,str_len(raw)) then "" else str_concat(hex-byte-to-pair(str_byte_at(raw,i)),ma-hex(raw,add(i,1)));
  def ma-hash(owner,path) {
   let hash = sho-file(path);
   let held = ma-put(owner,list(list("buffers",append(record_get(owner,"buffers"),record_get(hash,"buffers"))),list("pipelines",if gt(record_get(hash,"pipeline"),0) then append(record_get(owner,"pipelines"),list(record_get(hash,"pipeline"))) else record_get(owner,"pipelines"))));
   let digest = record_get(hash,"digest");
   if eq(str_len(digest),32) then ma-hex(digest,0) else "";
  }
  def ma-input-reason(model,prompt,cap) = if not(str_eq(model,ma-model())) then "model-not-admitted" else if eq(str_len(prompt),0) then "empty-prompt" else if or(not(str_eq(value_kind(cap),"int")),le(cap,0)) then "positive-integer-token-cap-required" else "";
  def ma-eos(src,id) = or(eq(id,gmt-u32(src,"tokenizer.ggml.eos_token_id")),or(eq(id,128001),eq(id,128009)));
  def ma-stop(src,id,remaining) = if ma-eos(src,id) then "eos" else if le(remaining,0) then "cap" else "";
  def ma-health(owner,aspect,why,ok) {
   let reading = oh-reading("metal-ask",int_to_str(owner),aspect,json-node-string("ready"),json-node-string(why),json-node-int(ok),if ok then list() else list(oh-need(why,json-node-null())),if ok then list("continue") else list("abstain","request-evidence"),json-node-object(list(oh-n("owner",owner))));
   let kept = record_set(owner,"health",reading);
   let framed = oh-frame(reading);
   reading;
  }
  def ma-refuse(owner,why) {
   let health = ma-health(owner,"admission",why,0);
   let response = oh-response(health,"abstain");
   let selected = oh-select(health,response,"request-evidence");
   let applied = oh-applied(health,selected,json-node-string("answer-withheld"));
   let held = ma-put(owner,list(list("health-response",response),list("health-applied",applied),list("ok",0),list("reason",why),list("text","")));
   let framed = oh-frame(applied);
   owner;
  }
  def ma-voice-refusal(owner) {
   let observed = oh-voice(record_get(owner,"health"));
   let response = oh-voice(record_get(owner,"health-response"));
   let applied = oh-voice(record_get(owner,"health-applied"));
   form_error(str_concat("metal ask refused: ",record_get(owner,"reason")));
  }
  def ma-positive(xs) = if nil?(xs) then 1 else and(gt(head(xs),0),ma-positive(tail(xs)));
  def ma-handles(slot) = append(l3rs-scratch(slot),append(lth-layer-handles(l3rs-layers(slot)),append(l3rs-keys(slot),append(l3rs-values(slot),lth-list-handles(l3rs-model-tvs(slot))))));
  def ma-release(xs,pipeline,remaining) {
   if nil?(xs) then reverse(remaining) else if le(head(xs),0) then ma-release(tail(xs),pipeline,remaining) else ma-release-next(xs,pipeline,remaining,if pipeline then mj-release-handle(head(xs)) else metal_buf_free(head(xs)));
  }
  def ma-release-next(xs,pipeline,remaining,rc) = ma-release(tail(xs),pipeline,if eq(rc,1) then remaining else cons(head(xs),remaining));
  def ma-close(owner) {
   let buffers = ma-release(record_get(owner,"buffers"),0,list());
   let pipelines = ma-release(record_get(owner,"pipelines"),1,list());
   let saved = ma-put(owner,list(list("buffers",buffers),list("pipelines",pipelines)));
   let ok = and(nil?(buffers),nil?(pipelines));
   let observed = ma-health(owner,"release",if ok then "ready" else "native-release-confirmation",ok);
   ok;
  }
  def ma-geometry?(src) {
   let d = gmt-u32(src,"llama.embedding_length");
   let h = gmt-u32(src,"llama.attention.head_count");
   let k = gmt-u32(src,"llama.attention.head_count_kv");
   let hd = gmt-u32(src,"llama.rope.dimension_count");
   and(str_eq(gmt-str(src,"general.architecture"),"llama"),and(gt(k,0),and(eq(mod(h,k),0),and(eq(mul(h,hd),d),and(gt(gmt-u32(src,"llama.block_count"),0),eq(gmt-vocab-n(src),gmt-u32(src,"llama.vocab_size")))))));
  }
  def ma-ask(path,model,prompt,cap) {
   let owner = record_new(0,"ok",0,"reason","","text","","ids",list(),"buffers",list(),"pipelines",list(),"prompt-sha256",anl-question-key(prompt),"path",path,"model",model,"cap",cap);
   let why = ma-input-reason(model,prompt,cap);
   if gt(str_len(why),0) then ma-refuse(owner,why) else if le(file_size(path),0) then ma-refuse(owner,"model-file-absent") else if not(md-door-live?()) then ma-refuse(owner,"dynamic-metal-device-absent") else ma-identify(owner,path,prompt,cap,ma-hash(owner,path));
  }
  def ma-identify(owner,path,prompt,cap,digest) {
   let kept = record_set(owner,"blob-sha256",digest);
   if not(str_eq(digest,ma-identity())) then ma-refuse(owner,"model-content-identity-mismatch") else ma-tokenize(owner,path,prompt,cap,lth-src(path));
  }
  def ma-tokenize(owner,path,prompt,cap,src) {
   if not(ma-geometry?(src)) then ma-refuse(owner,"model-geometry-refused") else ma-tokenized(owner,path,cap,src,l3t-encode(src,prompt));
  }
  def ma-tokenized(owner,path,cap,src,ids) {
   let capacity = add(len(ids),cap);
   if nil?(ids) then ma-refuse(owner,"tokenizer-refused") else if gt(capacity,gmt-u32(src,"llama.context_length")) then ma-refuse(owner,"model-position-limit") else ma-open(owner,path,cap,src,ids,capacity);
  }
  def ma-open(owner,path,cap,src,ids,capacity) {
   let started = host_monotonic_ms();
   let slot = l3rs-open(path,capacity);
   let kept = ma-put(owner,list(list("buffers",ma-handles(slot)),list("pipelines",l3rs-pipes(slot)),list("prompt-tokens",len(ids)),list("open-ms",sub(host_monotonic_ms(),started))));
   if not(and(ma-positive(record_get(owner,"buffers")),ma-positive(record_get(owner,"pipelines")))) then ma-open-refused(owner) else ma-run(owner,slot,src,ids,cap);
  }
  def ma-open-refused(owner) {
   let closed = ma-close(owner);
   ma-refuse(owner,"native-admission-refused");
  }
  def ma-forward(slot,id,pos) {
   let before = metal_live();
   let token = lth-forward(l3rs-pipes(slot),l3rs-scratch(slot),l3rs-geometry(slot),l3rs-layers(slot),l3rs-keys(slot),l3rs-values(slot),l3rs-embedding(slot),l3rs-output-norm(slot),l3rs-projection(slot),id,pos);
   let after = metal_live();
   let expected = add(mul(nth(l3rs-geometry(slot),12),17),5);
   if eq(sub(nth(after,7),nth(before,7)),expected) then token else -1;
  }
  def ma-prefill(slot,ids,pos) {
   let token = ma-forward(slot,head(ids),pos);
   if or(lt(token,0),nil?(tail(ids))) then list(token,add(pos,1)) else ma-prefill(slot,tail(ids),add(pos,1));
  }
  def ma-collect(slot,src,id,pos,remaining,acc) {
   let stop = ma-stop(src,id,remaining);
   if gt(str_len(stop),0) then list(acc,stop,pos) else if or(lt(id,0),ge(id,gmt-vocab-n(src))) then list(acc,"invalid-token",pos)
   else if eq(remaining,1) then list(append(acc,list(id)),"cap",pos) else ma-collect(slot,src,ma-forward(slot,id,pos),add(pos,1),sub(remaining,1),append(acc,list(id)));
  }
  def ma-run(owner,slot,src,ids,cap) {
   let before = metal_live(); let start = host_monotonic_ms();
   let prefilled = ma-prefill(slot,ids,0);
   let prefillMs = sub(host_monotonic_ms(),start); let decodeStart = host_monotonic_ms();
   let result = ma-collect(slot,src,head(prefilled),nth(prefilled,1),cap,list());
   let decodeMs = sub(host_monotonic_ms(),decodeStart); let after = metal_live();
   let sync = metal_sync();
   let text = l3d-text(src,head(result));
   let identityAfter = ma-hash(owner,l3rs-path(slot));
   let saved = ma-put(owner,list(
    list("ids",head(result)),list("text",text),list("reason",nth(result,1)),list("forwards",nth(result,2)),
    list("prefill-ms",prefillMs),list("decode-ms",decodeMs),
    list("dispatches",sub(nth(after,7),nth(before,7))),list("syncs",sub(nth(after,8),nth(before,8))),
    list("gpu-busy-us",sub(nth(after,11),nth(before,11))),
    list("identity-stable",str_eq(identityAfter,record_get(owner,"blob-sha256")))));
   let receipt = record_set(owner,"receipt",ma-receipt(owner,slot,src));
   let closed = ma-close(owner);
   let ok = and(ge(sync,0),and(closed,and(record_get(owner,"identity-stable"),and(gt(str_len(text),0),or(str_eq(nth(result,1),"cap"),str_eq(nth(result,1),"eos"))))));
   if not(ok) then ma-refuse(owner,if not(closed) then "native-release-confirmation" else if not(record_get(owner,"identity-stable")) then "model-changed-during-generation" else "generation-refused") else record_set(owner,"ok",1);
  }
  def ma-kv(name,value) = ma-cat(list("MEASURED ",name," ",int_to_str(value),"\n"));
  def ma-receipt(owner,slot,src) {
   let g = l3rs-geometry(slot); let n = record_get(owner,"forwards");
   let touched = adc-sum-touched(src,egg-tinfo-start(src),egg-tensor-count(src),0);
   let rowbytes = acr-type-bytes(lth-tv-ty(l3rs-embedding(slot)),nth(g,0));
   let traffic = acr-bytes-run(touched,rowbytes,nth(g,12),nth(g,3),nth(g,4),n);
   let macs = acr-macs-run(nth(g,12),nth(g,0),nth(g,1),nth(g,2),nth(g,3),nth(g,4),nth(g,7),n);
   ma-cat(list("EXECUTION form-native-gguf\nTOKENIZER longest-vocabulary-match\n",ma-kv("forwards",n),ma-kv("prefill_wall_ms",record_get(owner,"prefill-ms")),ma-kv("decode_wall_ms",record_get(owner,"decode-ms")),ma-kv("admission_wall_ms",record_get(owner,"open-ms")),ma-kv("gpu_busy_us",record_get(owner,"gpu-busy-us")),ma-kv("dispatches",record_get(owner,"dispatches")),ma-kv("syncs",record_get(owner,"syncs")),"DERIVED bytes_touched ",int_to_str(traffic),"\nDERIVED macs ",int_to_str(macs),"\nMEASUREMENT joules absent\nMEASUREMENT external_denominator absent\n"));
  }
  def ma-artifact(owner) = ma-cat(list("ASK-NATIVE v1\nLANE metal-gguf-native\nQUESTION-SHA256 ",record_get(owner,"prompt-sha256"),"\nMODEL ",record_get(owner,"model"),"\nBLOB-SHA256 ",record_get(owner,"blob-sha256"),"\nGATES execution-observed\nGATE-MODE native-runtime\nSTOP-REASON ",record_get(owner,"reason"),"\nKERNEL-PATH form-native-handle\nRECEIPT-BEGIN\n",record_get(owner,"receipt"),"RECEIPT-END\nANSWER-BEGIN\n",record_get(owner,"text"),"\nANSWER-END\n"));
  def ma-publish(owner,path) {
   if not(eq(record_get(owner,"ok"),1)) then 0 else if or(eq(str_len(path),0),ge(str_find(path,byte_to_str(0),0),0)) then ma-publish-refused(owner,"") else ma-publish-ready(owner,if eq(str_byte_at(path,0),47) then path else fs-path-join(host_cwd(),path),ma-artifact(owner));
  }
  // Host filesystem utilities carry only mode-aware mkdir and atomic 0600
  // temporary creation. Form owns path traversal, admission, writing and rename.
  def ma-command(argv) = ma-wait(host_spawn_quiet(argv));
  def ma-wait(pid) = if nothing?(pid) then -1 else if le(pid,0) then -1 else host_wait(pid);
  def ma-private-dir(path) = if fs-is-dir?(path) then 1 else if fs-exists?(path) then 0 else ma-private-child(path,ma-private-dir(fs-path-dirname(path)));
  def ma-private-child(path,parent) = if not(parent) then 0 else eq(ma-command(list("/bin/mkdir","-m","700",path)),0);
  def ma-output-line(raw) = if nothing?(raw) then "" else if and(gt(str_len(raw),0),eq(str_byte_at(raw,sub(str_len(raw),1)),10)) then substring(raw,0,sub(str_len(raw),1)) else raw;
  def ma-private-temp(path) = ma-check-temp(path,ma-output-line(host_capture(list("/usr/bin/mktemp",str_concat(path,".native.XXXXXXXX")))));
  def ma-check-temp(path,temporary) = if and(eq(str_find(temporary,str_concat(path,".native."),0),0),eq(file_size(temporary),0)) then temporary else "";
  def ma-publish-ready(owner,path,text) {
   let made = ma-private-dir(fs-path-dirname(path));
   if made then ma-publish-temp(owner,path,text,ma-private-temp(path)) else ma-publish-refused(owner,"");
  }
  def ma-publish-temp(owner,path,text,temporary) = if eq(str_len(temporary),0) then ma-publish-refused(owner,"") else ma-publish-write(owner,path,text,temporary);
  def ma-publish-write(owner,path,text,temporary) {
   let wrote = write_file(temporary,text);
   let moved = ma-publish-move(eq(wrote,str_len(text)),temporary,path);
   if eq(moved,0) then 1 else ma-publish-refused(owner,temporary);
  }
  def ma-publish-move(wrote,temporary,path) = if wrote then fs_rename(temporary,path) else -1;
  def ma-publish-refused(owner,path) {
   let removed = ma-remove-temp(path); let refused = ma-refuse(owner,"artifact-publication-refused");
   0;
  }
  def ma-remove-temp(path) = if gt(str_len(path),0) then fs_remove(path) else 0;
 }
 0;
}
