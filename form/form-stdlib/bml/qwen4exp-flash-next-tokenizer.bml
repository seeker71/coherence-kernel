// oracle used only to witness the fixed text below; it is not a dependency.
//
//////////////////////////////////////////////////////////////////////

package Form.native.qwen4exp;

import Form.kernel.*;
import Form.native.tokenizer.*;

interface IQwen4ExpFlashNextTokenizer [public, witness, reusable] {
   section [public] {
      const String Architecture = "qwen4exp";
      const String Algorithm = "gpt2-byte-bpe-from-gguf";
      const String ExternalRuntime = "none";
      const int Vocab = 248320;
      const int Bos = 248044;
      const int Eos = 248046;
      const String OracleText = "Hello, Form.";
      const String OracleIds = "9419,11,3268,13";

      bool Stop( int nToken ) [abstract];
      bool OracleParity( int nTokenCount ) [abstract];
   }
}
class Qwen4ExpFlashNextTokenizer [public, reusable, teach, observable] : IQwen4ExpFlashNextTokenizer {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/qwen4exp-flash-next-tokenizer.bml";
      const String Model = "Qwen3.8-Flash-Next UD-Q2_K_XL";

      bool Stop( int nToken ) [abstract] {}
      bool OracleParity( int nTokenCount ) [abstract] {}
   }
}
