// form-cli-model-draft.bml -- prompt-lookup drafting: speculative decode whose drafts are copied from the
// context. Code edits mostly copy what the lane has just read, so the IDs that followed the last occurrence of
// the current tail are a free guess at the next IDs; one span verify (qwen38-draft-verify.bml) answers the
// argmax after every one of them, and the longest run the model agrees with is taken in a single pass.
//
// The lane is GREEDY only. A session that owns a sampler keeps fcacs-sampled-quantum unchanged.
//
// The contract is fcms-walk's, exactly: a quantum emits `width` IDs, the last emitted ID stays pending and is
// not in KV, pos is that ID's position, a stop prediction stays pending and stops the walk. A drafted walk
// never consumes the final ID of the quantum, so a step drafts at most left-2 IDs (the verify consumes the
// pending ID and the draft; the next prediction is emitted by the next step or stays pending).
//
// Exactness: whether or not a draft is offered, every position goes through the verify (a span of 1 when
// nothing is drafted), so draft width 0 and draft width K walk the same arithmetic; a draft ID is only ever
// taken when it equals the argmax computed from the correct prefix. The band holds this against a scripted
// model whose recurrent state is not rewound by pos (tests/form-cli-model-draft-band.bml). That the span
// kernels give row t the same bytes whatever the split is a physical claim, held by
// tests/q8-0-mma-prefix-band.fk at the matmul and by observe/prompt-lookup-run.bml across the stack. Until
// the run's row says so (receipts/prompt-lookup.jsonl), fcmdr-live is 0 and the live lane decodes token-wise.
//
// A surprise is a choice point: a marked verify that refuses restores the mark and the same step lands as a
// span of 1; its finding travels in the walk's memory (oac-backtrack-walk) into the refusal reason when no
// option lands. Counters hold no IDs and no text.
//
// The owner is session slot 18 (15 adapter, 16 sampler, 17 observation owner), a mutable record. The
// session-bound quantum lives in form-cli-code-session.bml; this file knows no session but its slot.
import control/offer-ack-core.fk;
import control/choice-lane-core.fk;
import form-stdlib/bml/qwen38-draft-verify.bml;
section [form.bml] {
 class FormCliModelDraft {
  // A field is a name the whole program shares: the sampler's SessionSlot (16) answered for this one until it was
  // named apart, and the draft owner read as a sampler (the band's claim 1024).
  field DraftOwnerSlot = 18;
  // The longest tail matched is three IDs; a miss on three falls to two.
  field DraftOwnerWidth = 3;
  // A draft shorter than this is not worth a mark (one sync) and a possible restore plus re-run.
  field DraftOwnerMin = 2;
  // The live hook: 0 until receipts/prompt-lookup.jsonl holds a row of observe/prompt-lookup-run.bml with
  // identical 1 and draft width 3 faster than token-wise, and a landing flips it to 1 (as fcsw-seeding-live).
  def fcmdr-live() = 0;
  def fcmdr-width() = DraftOwnerWidth();
  def fcmdr-min() = DraftOwnerMin();
  // ── the owner ──
  // [hist: int -> ID, n, grams: "a b c" or "a b" -> index of the last ID of the latest occurrence, spare, kmax,
  //  kmin, span, counters]. nothing() when the session has none.
  def fcmdr-new(kmax, kmin, span, spare) = record_new(0, "hist", record_new(0), "n", 0, "grams", record_new(0), "spare", spare, "kmax", kmax, "kmin", kmin, "span", span, "steps", 0, "verifies", 0, "drafted", 0, "accepted", 0, "reruns", 0, "marks", 0, "lookups", 0, "found", 0, "refused", 0);
  def fcmdr-owner(session) = len(session) > DraftOwnerSlot() ? session[DraftOwnerSlot()] : nothing();
  // Slots 15..17 keep the shape their owners read: no carrier and no sampler read as [], no observation owner
  // reads as nothing().
  def fcmdr-pad(session) = len(session) >= DraftOwnerSlot() ? session : fcmdr-pad(append(session, [len(session) == 17 ? nothing() : []]));
  def fcmdr-with-owner(session, owner) = append(take(DraftOwnerSlot(), fcmdr-pad(session)), cons(owner, drop(DraftOwnerSlot() + 1, session)));
  def fcmdr-get(o, key) = record_get(o, key);
  def fcmdr-n(o) = record_get(o, "n");
  def fcmdr-kmax(o) = record_get(o, "kmax");
  def fcmdr-kmin(o) = record_get(o, "kmin");
  def fcmdr-span(o) = record_get(o, "span");
  def fcmdr-spare(o) = record_get(o, "spare");
  def fcmdr-bump(o, key, by) = record_set(o, key, record_get(o, key) + by);
  // Counters in the order a receipt row reads them.
  def fcmdr-counts(o) = nothing?(o) ? [] : [record_get(o, "steps"), record_get(o, "verifies"), record_get(o, "drafted"), record_get(o, "accepted"), record_get(o, "reruns"), record_get(o, "marks"), record_get(o, "lookups"), record_get(o, "found"), record_get(o, "refused")];
  // The spare's handles, counted before they are freed; the close answers against it.
  def fcmdr-owned(o) = nothing?(o) ? 0 : q38dv-spare-owned(record_get(o, "spare"));
  def fcmdr-close(o) {
   let spare = nothing?(o) ? [] : record_get(o, "spare");
   let freed = nil?(spare) ? 0 : q38dv-free(spare);
   nothing?(o) ? 0 : record_set(o, "spare", []);
   freed;
  }
  // ── the n-gram index ──
  def fcmdr-key2(a, b) = a.str() ++ " " ++ b.str();
  def fcmdr-key3(a, b, c) = a.str() ++ " " ++ b.str() ++ " " ++ c.str();
  // A record's keys are strings: an int key does not tell one position from another (witnessed: every read of
  // an int-keyed record answered the last write), so a position is keyed by its digits.
  def fcmdr-id(o, i) = record_get(record_get(o, "hist"), i.str());
  def fcmdr-put(o, id) {
   let n = record_get(o, "n");
   let hist = record_get(o, "hist");
   let grams = record_get(o, "grams");
   record_set(hist, n.str(), id);
   record_set(o, "n", n + 1);
   n >= 1 ? record_set(grams, fcmdr-key2(fcmdr-id(o, n - 1), id), n) : 0;
   n >= 2 ? record_set(grams, fcmdr-key3(fcmdr-id(o, n - 2), fcmdr-id(o, n - 1), id), n) : 0;
   1;
  }
  // The IDs that entered the context (prompt, observations, emitted IDs the walk consumed), in order. The
  // pending ID is not among them until it is consumed. A feed that does not arrive costs hit rate only.
  def fcmdr-feed(o, ids) = nothing?(o) || nil?(ids) ? 0 : fcmdr-put(o, ids[0]) + fcmdr-feed(o, ids[1:]);
  def fcmdr-find(o, key) = record_has(record_get(o, "grams"), key) ? record_get(record_get(o, "grams"), key) : -1;
  // The end of the latest earlier occurrence of the tail ending at `pending`: three IDs, else two; -1 when
  // neither was seen.
  def fcmdr-end(o, pending) {
   let n = record_get(o, "n");
   let e3 = n >= 2 ? fcmdr-find(o, fcmdr-key3(fcmdr-id(o, n - 2), fcmdr-id(o, n - 1), pending)) : -1;
   e3 >= 0 ? e3 : n >= 1 ? fcmdr-find(o, fcmdr-key2(fcmdr-id(o, n - 1), pending)) : -1;
  }
  // Position j of the history followed by the pending ID, which is index n.
  def fcmdr-seq(o, pending, j) = j < record_get(o, "n") ? fcmdr-id(o, j) : pending;
  def fcmdr-copy(o, pending, j, count) = count <= 0 ? [] : cons(fcmdr-seq(o, pending, j), fcmdr-copy(o, pending, j + 1, count - 1));
  // The up-to-k IDs that followed that occurrence, or nothing(): the caller writes `lookup ?? []`, so a miss
  // is a span of 1 and never -1. The copy ends at the pending ID, the newest the sequence holds.
  def fcmdr-lookup(o, pending, k) {
   let e = k <= 0 ? -1 : fcmdr-end(o, pending);
   e < 0 ? nothing() : fcmdr-copy(o, pending, e + 1, fcmdr-min-of(k, record_get(o, "n") - e));
  }
  def fcmdr-min-of(a, b) = a < b ? a : b;
  // A draft never carries a stop ID: the stop is the model's to predict, and a stop taken into KV would
  // advance pos where the token-wise walk leaves it pending.
  def fcmdr-cut(ids, stops) = nil?(ids) ? [] : (Comparable) q38-stop?(ids[0], stops) == 1 ? [] : cons(ids[0], fcmdr-cut(ids[1:], stops));
  // The longest prefix of the draft the verify agrees with: draft[i] == argmax after input i.
  def fcmdr-accepted(draft, argmaxes, i) = (i < len(draft)) && (draft[i] == argmaxes[i]) ? fcmdr-accepted(draft, argmaxes, i + 1) : i;
  // ── the step: how many IDs the verify may take ──
  // left counts the emissions still owed, the pending ID among them: the verify consumes it and the draft, and
  // the prediction after them is emitted next, so the draft holds at most left-2. KV past maxpos does not
  // exist, and the span holds `span` rows.
  def fcmdr-cap(o, pos, left, maxpos) = fcmdr-min-of(fcmdr-min-of(fcmdr-kmax(o), left - 2), fcmdr-min-of(maxpos - pos - 1, fcmdr-span(o) - 1));
  // io = [verify(ids, pos), advance(ids, pos), mark(0), restore(0)]: the verify answers one argmax per input or
  // nothing(); advance and mark and restore answer 1 or 0. The real ones are qwen38-draft-verify.bml's.
  def fcmdr-io(verify, advance, mark, restore) = [verify, advance, mark, restore];
  def fcmdr-verify(io, ids, pos) {
   let f = io[0];
   f(ids, pos);
  }
  def fcmdr-advance(io, ids, pos) {
   let f = io[1];
   f(ids, pos);
  }
  def fcmdr-mark(io) {
   let f = io[2];
   f(0);
  }
  def fcmdr-restore(io) {
   let f = io[3];
   f(0);
  }
  // [consumed, next, reason]: consumed is [id] plus the accepted draft, next the valid prediction after them.
  def fcmdr-draft-for(o, id, pos, left, stops, maxpos) {
   let k = fcmdr-cap(o, pos, left, maxpos);
   let asked = k >= fcmdr-kmin(o);
   asked ? fcmdr-bump(o, "lookups", 1) : 0;
   let found = asked ? fcmdr-cut(fcmdr-lookup(o, id, k) ?? [], stops) : [];
   len(found) >= fcmdr-kmin(o) ? found : [];
  }
  def fcmdr-step(o, io, id, pos, left, stops, maxpos) {
   let draft = fcmdr-draft-for(o, id, pos, left, stops, maxpos);
   nil?(draft) ? 0 : fcmdr-bump(o, "found", 1);
   let walked = oac-backtrack-walk([fcmdr-draft-option, fcmdr-plain-option], [o, io, id, pos, draft], []);
   let ack = oac-backtrack-ack(walked);
   oac-one?(ack) ? fcmdr-landed(o, oac-payload(ack)) : fcmdr-refused(o, oac-backtrack-memory(walked));
  }
  def fcmdr-landed(o, step) {
   fcmdr-bump(o, "steps", 1);
   fcmdr-feed(o, step[0]);
   step;
  }
  def fcmdr-refused(o, memory) {
   fcmdr-bump(o, "refused", 1);
   [[], -1, fcmdr-reason(memory, "")];
  }
  def fcmdr-reason(memory, acc) = nil?(memory) ? ((String) acc == "" ? "draft-verify-refused" : acc) : fcmdr-reason(memory[1:], (String) acc == "" ? memory[0][0] : acc ++ ">" ++ memory[0][0]);
  // ── the options: the first keeps the intent with a draft, the second lands it as a span of 1 ──
  def fcmdr-draft-option(offered) {
   let a = oac-option-args(offered);
   nil?(a[4]) ? oac-nothing() : fcmdr-draft-marked(a[0], a[1], a[2], a[3], a[4], fcmdr-mark(a[1]));
  }
  def fcmdr-draft-marked(o, io, id, pos, draft, marked) {
   fcmdr-bump(o, "marks", 1);
   marked == 1 ? fcmdr-draft-verified(o, io, id, pos, draft, fcmdr-verify(io, cons(id, draft), pos)) : oac-node(["draft-mark-refused", len(draft)]);
  }
  def fcmdr-draft-verified(o, io, id, pos, draft, argmaxes) {
   fcmdr-bump(o, "verifies", 1);
   nothing?(argmaxes) || len(argmaxes) != len(draft) + 1 ? fcmdr-undo(io, ["draft-verify-refused", len(draft)]) : fcmdr-draft-read(o, io, id, pos, draft, argmaxes, fcmdr-accepted(draft, argmaxes, 0));
  }
  def fcmdr-draft-read(o, io, id, pos, draft, argmaxes, j) {
   fcmdr-bump(o, "drafted", len(draft));
   fcmdr-bump(o, "accepted", j);
   j == len(draft) ? oac-one([cons(id, draft), argmaxes[j], ""]) : fcmdr-draft-rerun(o, io, id, pos, take(j, draft), argmaxes[j]);
  }
  // Cut short: the recurrent state took every draft ID, so it returns to the mark and takes only [id] and the
  // accepted ones. The KV rows past them are never read (attention reads up to the position) and are overwritten.
  def fcmdr-draft-rerun(o, io, id, pos, kept, next) {
   fcmdr-bump(o, "reruns", 1);
   fcmdr-restore(io) == 1 ? fcmdr-draft-advanced(io, cons(id, kept), next, fcmdr-advance(io, cons(id, kept), pos)) : oac-node(["draft-restore-refused", len(kept)]);
  }
  def fcmdr-draft-advanced(io, taken, next, advanced) = advanced == 1 ? oac-one([taken, next, ""]) : fcmdr-undo(io, ["draft-advance-refused", len(taken)]);
  // The finding is the option's; the state it leaves is the mark's, so the next option starts from where this one did.
  def fcmdr-undo(io, finding) {
   fcmdr-restore(io);
   oac-node(finding);
  }
  def fcmdr-plain-option(offered) {
   let a = oac-option-args(offered);
   fcmdr-plain-read(a[0], a[2], fcmdr-verify(a[1], [a[2]], a[3]));
  }
  def fcmdr-plain-read(o, id, argmaxes) {
   fcmdr-bump(o, "verifies", 1);
   nothing?(argmaxes) || len(argmaxes) != 1 || argmaxes[0] < 0 ? oac-node(["plain-verify-refused", 1]) : oac-one([[id], argmaxes[0], ""]);
  }
  // ── the walk: fcms-walk's contract, result = [ids pending pos stopped reason] ──
  // A reason that is not "" is a refusal: the pending ID is -1, the stream is not stopped by the model, and the
  // caller refuses its session with it.
  def fcmdr-walk(o, io, id, pos, left, stops, maxpos, out) = id < 0 ? [out, -1, pos, 1, ""] : (Comparable) q38-stop?(id, stops) == 1 ? [out, id, pos, 1, ""] : left <= 0 ? [out, id, pos, 0, ""] : left == 1 ? [append(out, [id]), id, pos, 0, ""] : fcmdr-after(o, io, fcmdr-step(o, io, id, pos, left, stops, maxpos), id, pos, left, stops, maxpos, out);
  def fcmdr-after(o, io, step, id, pos, left, stops, maxpos, out) = nil?(step[0]) ? [append(out, [id]), -1, pos, 0, step[2]] : fcmdr-walk(o, io, step[1], pos + len(step[0]), left - len(step[0]), stops, maxpos, append(out, step[0]));
  // ── the physical run's reading (observe/prompt-lookup-run.bml): kept here so a band can hold it model-free ──
  // The same IDs entered as one span, a span per ID, 3 then 5, and 5 then 3.
  def fcmdr-chunks(ids) = [[ids], map(i => [i], ids), [take(3, ids), drop(3, ids)], [take(5, ids), drop(5, ids)]];
  // Positions where two reply ID lists agree, from the front.
  def fcmdr-agree(a, b) = nil?(a) || nil?(b) ? 0 : (a[0] == b[0] ? 1 : 0) + fcmdr-agree(a[1:], b[1:]);
  // IDs per second, times 1000, from a count and the wall milliseconds.
  def fcmdr-milli(count, ms) = ms <= 0 ? 0 : count * 1000000 / ms;
  // Logits bytes from several splits: all arrived and all equal.
  def fcmdr-bytes-equal(bytes) = nil?(bytes) ? 0 : nothing?(bytes[0]) ? 0 : fcmdr-bytes-same(bytes[0], bytes[1:]);
  def fcmdr-bytes-same(first, rest) = nil?(rest) ? 1 : nothing?(rest[0]) ? 0 : (String) rest[0] == (String) first ? fcmdr-bytes-same(first, rest[1:]) : 0;
  // The lane may open only when the drafted reply is the undrafted one, the logits do not depend on the split, and
  // the drafted lane took less wall time than the lane as it runs today.
  def fcmdr-verdict(identical, equal, faster) = (identical == 1 && equal == 1 && faster == 1) ? "open" : "hold";
  // The last row that carries a verdict: a row that records only the model-free bands' readings says none.
  def fcmdr-verdict-rows(rows) = filter(r => str_find(r, "\"verdict\":", 0) >= 0, rows);
  def fcmdr-last-verdict(rows) = nil?(fcmdr-verdict-rows(rows)) ? "none" : str_find(fcmdr-verdict-rows(rows)[-1], "\"verdict\":\"open\"", 0) >= 0 ? "open" : "hold";
  // The forward the walk's boundary takes between quanta (fcacs-next): one position through the same verify,
  // so a drafted lane runs one arithmetic. Answers the next prediction, or -1 as q38-forward does when it fails.
  def fcmdr-forward(o, io, id, pos) {
   let argmaxes = fcmdr-verify(io, [id], pos);
   let arrived = !nothing?(argmaxes) && len(argmaxes) == 1 && argmaxes[0] >= 0;
   fcmdr-bump(o, "verifies", 1);
   arrived ? fcmdr-bump(o, "steps", 1) : fcmdr-bump(o, "refused", 1);
   arrived ? fcmdr-feed(o, [id]) : 0;
   arrived ? argmaxes[0] : -1;
  }
 }
 0;
}
