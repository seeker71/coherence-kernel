//////////////////////////////////////////////////////////////////////
//
// bml/form-glass-gift-frame.bml — the gift frame's interface contract.
//
//////////////////////////////////////////////////////////////////////

class FormGlassGiftFrameContract [public, contract] {
    section [class, public] {
      const String Schema = "form-glass-gift-frame-v1";
      const String OfferRule = "a publisher offers its frame into shared memory without an acknowledgement or reader requirement; short ownership transactions admit and publish native roots";
      const String ReceiveRule = "a reader receives the frame when it stands and survives when it does not: an absent gift is named absent with its carrier and never invented, and the reader keeps its own ground";
      const String TornRule = "the frame carries a sixteen-byte seqlock header ahead of the payload -- seq even is stable, odd is a give in flight -- and a read retries, bounded, until the sequence it took equals the sequence it re-reads, so no reader ever carries a torn frame";
      const String NameRule = "the frame is named by the CRC-32 of the publisher's bytes behind the native prefix, within the host name bound; legacy serialized frames have a separate name";
      const String ReleaseRule = "release unmaps and never unlinks, so the frame stays for the next receiver";
      const String RootRule = "node_gift_read adopts the actual shared root; its children carry payload, originating pid, process start, generation and lifetime; readers never decode or re-intern its graph";
      const String LifetimeRule = "the frame owns its current generation across author exit; replacement or compare-by-held-root retirement withdraws it; native GC retains descendants and dependency graphs, reaps dead reader holds and reuses retired ranges with new identities; private process-scoped frames withdraw on process exit";
      const String ShapeRule = "every reading carries the sovereignty-as-gift six-tuple: the reader does not depend on the gift to live, stays open to receive, the publisher's offer is unique, and received is witnessed 0 or 1";
    }
}
