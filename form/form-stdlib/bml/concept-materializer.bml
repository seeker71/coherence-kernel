// Canonical concept projection, validation and owned publication in Form.
// preludes: form-stdlib/bml/concept-source-audit.bml
section [form.bml] {
 class ConceptMaterializer {
  def cmm-base() = "cognition/concept-nl-semantic-13";
  def cmm-path(suffix) = str_concat(cmm-base(),suffix);
  def cmm-codes() = list("en","id","es","fr","pt-br","sw","de","ru","zh","ja","ar","hi","tr");
  def cmm-source-codes() = list("eng","ind","spa","fra","por","swa","deu","rus","cmn","jpn","arb","hin","tur");
  def cmm-state(root,engine) = record_new(0,"root",root,"hash",engine,"observations",0,"files",list());
  def cmm-check(state,aspect,ok) = csa-check(state,str_concat("materialize-",aspect),ok,"held canonical source and prepared output");
  def cmm-header() = str_concat("synset\t",str_concat(csa-join(cmm-codes(),"\t"),"\n"));
  def cmm-replace(text,start,end,replacement) = str_concat(substring(text,0,start),str_concat(replacement,substring(text,end,str_len(text))));
  def cmm-function-span(state,text,name,required) {
   let marker = str_concat("  (defn ",str_concat(name," "));
   let start = str_find(text,marker,0);
   if lt(start,0) then if required then cmm-check(state,"metadata-function-present",0) else nothing() else cmm-function-end(state,text,marker,start);
  }
  def cmm-function-end(state,text,marker,start) {
   cmm-check(state,"metadata-function-unique",lt(str_find(text,marker,add(start,1)),0));
   let next = str_find(text,"\n  (defn ",add(start,str_len(marker)));
   let end = if ge(next,0) then add(next,1) else str_find(text,"\n)\n",add(start,str_len(marker)));
   cmm-check(state,"metadata-function-boundary",gt(end,start));
   list(start,if ge(next,0) then end else add(end,1));
  }
  def cmm-function(state,text,name) {
   let span = cmm-function-span(state,text,name,1);
   substring(text,head(span),nth(span,1));
  }
  def cmm-function-set(state,text,name,replacement) {
   let span = cmm-function-span(state,text,name,1);
   cmm-replace(text,head(span),nth(span,1),replacement);
  }
  def cmm-quote-end(text,at) = if ge(at,str_len(text)) then nothing() else if eq(str_byte_at(text,at),92) then cmm-quote-end(text,add(at,2)) else if eq(str_byte_at(text,at),34) then at else cmm-quote-end(text,add(at,1));
  def cmm-hex?(text,at) = if ge(at,str_len(text)) then 1 else if or(and(ge(str_byte_at(text,at),48),le(str_byte_at(text,at),57)),and(ge(str_byte_at(text,at),97),le(str_byte_at(text,at),102))) then cmm-hex?(text,add(at,1)) else 0;
  def cmm-hashes(state,text,from,at,hashes,bins) {
   if ge(at,str_len(text)) then cmm-hashes-end(state,text,from,hashes,bins) else if eq(str_byte_at(text,at),34) then cmm-hash-string(state,text,from,at,cmm-quote-end(text,add(at,1)),hashes,bins) else cmm-hashes(state,text,from,add(at,1),hashes,bins);
  }
  def cmm-hash-string(state,text,from,start,end,hashes,bins) {
   cmm-check(state,"metadata-quoted-string",not(nothing?(end)));
   let value = substring(text,add(start,1),end);
   if and(eq(str_len(value),64),cmm-hex?(value,0)) then cmm-hash-replace(state,text,from,start,end,hashes,bins) else cmm-hashes(state,text,from,add(end,1),hashes,bins);
  }
  def cmm-hash-replace(state,text,from,start,end,hashes,bins) {
   cmm-check(state,"metadata-hash-count",not(nil?(hashes)));
   cmm-hashes(state,text,end,add(end,1),tail(hashes),fbc-put(fbc-put(bins,substring(text,from,add(start,1))),head(hashes)));
  }
  def cmm-hashes-end(state,text,from,hashes,bins) {
   cmm-check(state,"metadata-hashes-complete",nil?(hashes));
   fbc-finish(fbc-put(bins,substring(text,from,str_len(text))),"");
  }
  def cmm-one(state,text,old,new) {
   let at = str_find(text,old,0);
   cmm-check(state,"metadata-label-present",ge(at,0));
   cmm-check(state,"metadata-label-unique",lt(str_find(text,old,add(at,str_len(old))),0));
   cmm-replace(text,at,add(at,str_len(old)),new);
  }
  def cmm-label(state,text) {
   let current = "base-omw-then-revision-pinned-substantive-repair-111";
   if ge(str_find(text,current,0),0) then cmm-one(state,text,current,current) else cmm-one(state,text,"wikt-then-dedicated-wordnet-then-cldr-then-machine-first-hit",current);
  }
  def cmm-column-key(lens) = str_concat("column:",int_to_str(lens));
  def cmm-columns(work,fields,lens) {
   if eq(lens,13) then 1 else cmm-column(work,fields,lens,cmm-column-key(lens));
  }
  def cmm-column(work,fields,lens,key) {
   let bins = record_get(work,key);
   record_set(work,key,fbc-put(if str_eq(value_kind(bins),"list") then bins else list(),str_concat(nth(fields,add(lens,1)),"\n")));
   cmm-columns(work,fields,add(lens,1));
  }
  def cmm-rows(input,work,rows,sources,overlaySources,id) {
   if nil?(rows) then id else cmm-row(input,work,csa-fields(head(rows)),tail(rows),sources,overlaySources,id);
  }
  def cmm-row(input,work,original,rest,sources,overlaySources,id) {
   if not(eq(len(original),14)) then cmm-check(input,"primary-row-width",0) else 0;
   let repair = record_get(input,str_concat("overlay:",int_to_str(id)));
   let fields = if csa-overlay?(repair) then tail(nth(repair,1)) else original;
   let row = str_concat(csa-join(fields,"\t"),"\n");
   let source = if csa-overlay?(repair) then substring(overlaySources,mul(head(repair),13),mul(add(head(repair),1),13)) else substring(sources,mul(id,13),mul(add(id,1),13));
   record_set(work,"table",fbc-put(record_get(work,"table"),row));
   record_set(work,"sources",fbc-put(record_get(work,"sources"),source));
   let end = add(record_get(work,"offset"),str_len(row));
   record_set(work,"offset",end);
   record_set(work,"offsets",fbc-put(record_get(work,"offsets"),str_concat("    ",str_concat(int_to_str(end),"\n"))));
   cmm-columns(work,fields,0);
   cmm-rows(input,work,rest,sources,overlaySources,add(id,1));
  }
  def cmm-locale-rows(input,work,lens) {
   if eq(lens,13) then "" else str_concat("    (list \"",str_concat(nth(cmm-codes(),lens),str_concat("\" \"",str_concat(nth(cmm-source-codes(),lens),str_concat("\" 10000 0 \"",str_concat(csa-hash(input,fbc-finish(record_get(work,cmm-column-key(lens)),"")),str_concat("\" \"canonical-column-sha256-unreviewed\")\n",cmm-locale-rows(input,work,add(lens,1)))))))));
  }
  def cmm-metadata(input,work,tableHash,sourcesHash,repairHash,repairSourcesHash) {
   let metadata = csa-file(input,cmm-path("-metadata.fk"));
   let source = cmm-label(input,cmm-hashes(input,cmm-function(input,metadata,"cnl13-source-meta"),0,0,list(tableHash,sourcesHash),list()));
   let a = cmm-function-set(input,metadata,"cnl13-source-meta",source);
   let repair = str_concat("  (defn cnl13-substantive-repair-meta ()\n    (list 111 1443 \"",str_concat(repairHash,str_concat("\" \"",str_concat(repairSourcesHash,"\"\n          \"frequency-observed-and-google-machine-unreviewed\"))\n"))));
   let old = cmm-function-span(input,a,"cnl13-substantive-repair-meta",0);
   let b = if nothing?(old) then cmm-replace(a,head(cmm-function-span(input,a,"cnl13-machine-source-meta",1)),head(cmm-function-span(input,a,"cnl13-machine-source-meta",1)),repair) else cmm-replace(a,head(old),nth(old,1),repair);
   let locales = str_concat("  (defn cnl13-locale-meta-rows () (list\n",str_concat(cmm-locale-rows(input,work,0),"  ))\n"));
   let c = cmm-function-set(input,b,"cnl13-locale-meta-rows",locales);
   let body = str_find(c,"(do\n",0);
   cmm-check(input,"metadata-module-boundary",ge(body,0));
   str_concat("; concept-nl-semantic-13-metadata.fk — generated provenance for the canonical primary surface.\n; preludes: form/form-stdlib/core.fk\n",substring(c,body,str_len(c)));
  }
  def cmm-binding(path,hash) = list(path,hash);
  def cmm-find-binding(bindings,path) = if nil?(bindings) then nothing() else if str_eq(head(head(bindings)),path) then nth(head(bindings),1) else cmm-find-binding(tail(bindings),path);
  def cmm-manifest-line(input,work,line,bindings) {
   if ge(str_find(line,"label=",0),0) then if eq(str_find(line,"label=",0),0) then cmm-manifest-label(work) else line else cmm-manifest-hash(input,work,line,bindings,str_find(line,"  ",0));
  }
  def cmm-manifest-label(work) {
   record_set(work,"manifest-labels",add(record_get(work,"manifest-labels"),1));
   "label=base-omw-then-revision-pinned-substantive-repair-111";
  }
  def cmm-manifest-hash(input,work,line,bindings,at) {
   if lt(at,0) then line else cmm-manifest-bound(input,work,line,substring(line,add(at,2),str_len(line)),bindings);
  }
  def cmm-manifest-bound(input,work,line,path,bindings) {
   let hash = cmm-find-binding(bindings,path);
   if nothing?(hash) then line else cmm-manifest-rewrite(input,work,path,hash);
  }
  def cmm-manifest-rewrite(input,work,path,hash) {
   cmm-check(input,"manifest-binding-unique",csa-unique(work,"manifest:",path));
   str_concat(hash,str_concat("  ",path));
  }
  def cmm-manifest-lines(input,work,lines,bindings,bins) = if nil?(lines) then bins else cmm-manifest-lines(input,work,tail(lines),bindings,fbc-put(bins,str_concat(cmm-manifest-line(input,work,head(lines),bindings),"\n")));
  def cmm-manifest-missing(input,work,bindings,bins) = if nil?(bindings) then bins else cmm-manifest-missing(input,work,tail(bindings),if eq(record_get(work,str_concat("manifest:",head(head(bindings)))),1) then bins else fbc-put(bins,str_concat(cmm-manifest-rewrite(input,work,head(head(bindings)),nth(head(bindings),1)),"\n")));
  def cmm-output(path,bytes) = list(path,bytes);
  def cmm-count-codes() = list("F","W","D","C","G","0");
  def cmm-count-bytes(bytes,at,counts) {
   if ge(at,str_len(bytes)) then counts else cmm-count-byte(bytes,at,counts,byte_to_str(str_byte_at(bytes,at)));
  }
  def cmm-count-byte(bytes,at,counts,code) {
   if oh-has(cmm-count-codes(),code) then record_set(counts,code,add(record_get(counts,code),1)) else 0;
   cmm-count-bytes(bytes,add(at,1),counts);
  }
  def cmm-count-fields(counts,codes) = if nil?(codes) then list() else cons(oh-n(head(codes),record_get(counts,head(codes))),cmm-count-fields(counts,tail(codes)));
  def cmm-prepare(root,engine) {
   let input = cmm-state(root,engine);
   cmm-check(input,"hash-policy",or(str_eq(engine,"form-sha256"),str_eq(engine,"arm64-sha256")));
   let table = csa-file(input,cmm-path("-omw.tsv"));
   let lines = csa-lines(table);
   let sources = csa-file(input,cmm-path("-sources.dat"));
   let repairPath = "cognition/concept-10000-substantive-repair-111-nl.tsv";
   let repairSourcePath = "cognition/concept-10000-substantive-repair-111-nl-sources.dat";
   let repairText = csa-file(input,repairPath);
   let repairSources = csa-file(input,repairSourcePath);
   cmm-check(input,"source-shapes",and(str_eq(substring(table,0,str_len(cmm-header())),cmm-header()),and(eq(len(tail(lines)),10000),and(eq(str_len(sources),130000),and(eq(len(csa-lines(repairText)),111),eq(str_len(repairSources),1443))))));
   cmm-check(input,"repair-ids",eq(csa-repairs(input,csa-lines(repairText),0),111));
   let start = str_len(cmm-header());
   let work = record_new(0,"table",fbc-put(list(),cmm-header()),"sources",list(),"offset",start,"offsets",fbc-put(list(),str_concat("    ",str_concat(int_to_str(start),"\n"))),"manifest-labels",0);
   let count = cmm-rows(input,work,tail(lines),sources,repairSources,0);
   cmm-check(input,"complete-projection",eq(count,10000));
   let nextTable = fbc-finish(record_get(work,"table"),"");
   let nextSources = fbc-finish(record_get(work,"sources"),"");
   let tableHash = csa-hash(input,nextTable); let sourcesHash = csa-hash(input,nextSources);
   let repairHash = csa-hash(input,repairText); let repairSourcesHash = csa-hash(input,repairSources);
   let offsets = str_concat("; concept-nl-semantic-13-offsets.fk — generated byte offsets for 10k canonical rows.\n; preludes: form/form-stdlib/core.fk\n(do\n  (defn cnl13-offsets () (list\n",str_concat(fbc-finish(record_get(work,"offsets"),""),"  ))\n)\n"));
   let metadata = cmm-metadata(input,work,tableHash,sourcesHash,repairHash,repairSourcesHash);
   let bindings = list(cmm-binding("concept-nl-semantic-13-omw.tsv",tableHash),cmm-binding("concept-nl-semantic-13-sources.dat",sourcesHash),cmm-binding("model/concept-10000-ranked.dat",csa-file-hash(input,"model/concept-10000-ranked.dat")),cmm-binding(repairPath,repairHash),cmm-binding(repairSourcePath,repairSourcesHash),cmm-binding("model/concept-10000-substantive-repair-evidence.jsonl",csa-file-hash(input,"model/concept-10000-substantive-repair-evidence.jsonl")));
   let manifest = fbc-finish(cmm-manifest-missing(input,work,bindings,cmm-manifest-lines(input,work,csa-lines(csa-file(input,cmm-path("-source-manifest.txt"))),bindings,list())),"");
   cmm-check(input,"manifest-label",eq(record_get(work,"manifest-labels"),1));
   let outputs = list(cmm-output(cmm-path("-omw.tsv"),nextTable),cmm-output(cmm-path("-sources.dat"),nextSources),cmm-output(cmm-path("-offsets.fk"),offsets),cmm-output(cmm-path("-metadata.fk"),metadata),cmm-output(cmm-path("-source-manifest.txt"),manifest));
   record_new(0,"input",input,"outputs",outputs,"table-sha256",tableHash,"sources-sha256",sourcesHash,"source-counts",json-node-object(cmm-count-fields(cmm-count-bytes(nextSources,0,record_new(0)),cmm-count-codes())));
  }
  def cmm-copy-bytes(source,target,paths) {
   if nil?(paths) then target else cmm-copy-next(source,target,head(paths),tail(paths));
  }
  def cmm-copy-next(source,target,path,rest) {
   record_set(target,str_concat("bytes:",path),csa-file(source,path));
   record_set(target,"files",cons(path,record_get(target,"files")));
   cmm-copy-bytes(source,target,rest);
  }
  def cmm-proposed-outputs(state,outputs) {
   if nil?(outputs) then state else cmm-proposed-next(state,head(outputs),tail(outputs));
  }
  def cmm-proposed-next(state,output,rest) {
   record_set(state,str_concat("bytes:",head(output)),nth(output,1));
   cmm-proposed-outputs(state,rest);
  }
  def cmm-validate(prepared) {
   let input = record_get(prepared,"input");
   let proposed = cmm-copy-bytes(input,cmm-state(record_get(input,"root"),record_get(input,"hash")),record_get(input,"files"));
   cmm-proposed-outputs(proposed,record_get(prepared,"outputs"));
   let cells = csa-primary(proposed);
   let ids = csa-stable-ids(proposed);
   cmm-check(proposed,"complete-source-projection",and(eq(cells,130000),eq(ids,111)));
   record_set(prepared,"proposed",proposed);
   prepared;
  }
  def cmm-output?(outputs,path) = if nil?(outputs) then 0 else or(str_eq(head(head(outputs)),path),cmm-output?(tail(outputs),path));
  def cmm-freeze(prepared) {
   let input = record_get(prepared,"input");
   let proposed = record_get(prepared,"proposed");
   cmm-freeze-files(input,proposed,record_get(prepared,"outputs"),record_get(proposed,"files"));
   cmm-freeze-outputs(input,record_get(prepared,"outputs"));
   cmm-check(input,"source-fresh-before-staging",csa-fresh(input,record_get(input,"files")));
   prepared;
  }
  def cmm-freeze-files(input,proposed,outputs,paths) {
   if nil?(paths) then 1 else cmm-freeze-file(input,proposed,outputs,head(paths),tail(paths));
  }
  def cmm-freeze-file(input,proposed,outputs,path,rest) {
   let original = csa-file(input,path);
   if not(cmm-output?(outputs,path)) then cmm-check(input,"source-still-held",str_eq(original,csa-file(proposed,path))) else 0;
   cmm-freeze-files(input,proposed,outputs,rest);
  }
  def cmm-freeze-outputs(input,outputs) {
   if nil?(outputs) then 1 else cmm-freeze-output(input,head(outputs),tail(outputs));
  }
  def cmm-freeze-output(input,output,rest) {
   // Existing artifact bytes participate in the publication freshness check.
   let original = csa-file(input,head(output));
   cmm-freeze-outputs(input,rest);
  }
  def cmm-stages(input,outputs,suffix) {
   if nil?(outputs) then list() else cons(list(csa-at(input,head(head(outputs))),str_concat(csa-at(input,head(head(outputs))),suffix),nth(head(outputs),1)),cmm-stages(input,tail(outputs),suffix));
  }
  def cmm-stage-free(input,stages) = if nil?(stages) then 1 else and(not(fs_exists(nth(head(stages),1))),cmm-stage-free(input,tail(stages)));
  def cmm-stage-all(input,stages) {
   if nil?(stages) then 1 else cmm-stage-one(input,head(stages),tail(stages));
  }
  def cmm-stage-one(input,stage,rest) {
   let path = nth(stage,1); let bytes = nth(stage,2);
   record_set(input,"owned-stages",cons(path,record_get(input,"owned-stages")));
   let wrote = write_file(path,bytes);
   let observed = fbc-read-exact(path,0);
   let accepted = and(eq(wrote,str_len(bytes)),and(fbc-good(observed),str_eq(fbc-value(observed),bytes)));
   if not(accepted) then cmm-abort(input,"stage-write",path) else csa-check(input,"materialize-complete-stage",1,path);
   cmm-stage-all(input,rest);
  }
  def cmm-clean-stages(paths) {
   if nil?(paths) then 1 else cmm-clean-stage(head(paths),tail(paths));
  }
  def cmm-clean-stage(path,rest) {
   if fs_exists(path) then fs_remove(path) else 0;
   let released = not(fs_exists(path));
   let others = cmm-clean-stages(rest);
   and(released,others);
  }
  def cmm-stage-names(paths) = if nil?(paths) then list() else cons(json-node-string(head(paths)),cmm-stage-names(tail(paths)));
  def cmm-abort(input,aspect,path) {
   let row = oh-reading("concept-materializer",path,aspect,json-node-int(1),json-node-int(0),json-node-int(0),list(),list("release-private-stages","defer"),json-node-object(list(oh-n("published",record_get(input,"published")),oh-s("root",record_get(input,"root")),json-node-pair("ownedStages",json-node-array(cmm-stage-names(record_get(input,"owned-stages")))))));
   oh-voice(row);
   let response = oh-response(row,"release-private-stages");
   oh-voice(response);
   let selected = oh-select(row,response,"defer");
   let released = if str_eq(selected,"release-private-stages") then cmm-clean-stages(record_get(input,"owned-stages")) else 0;
   oh-voice(oh-applied(row,selected,json-node-int(released)));
   oh-voice(oh-reading("concept-materializer",path,"private-stages-after-refusal",json-node-int(1),json-node-int(released),json-node-int(released),list(),list("request-evidence"),json-node-int(record_get(input,"published"))));
   if released then record_set(input,"owned-stages",list()) else 0;
   form_error("concept publication refused; published count and private-stage disposition observed");
  }
  def cmm-fresh(input,paths) {
   if nil?(paths) then 1 else cmm-fresh-file(input,head(paths),tail(paths));
  }
  def cmm-fresh-file(input,path,rest) {
   let observed = fbc-read-exact(csa-at(input,path),0);
   if not(and(fbc-good(observed),str_eq(fbc-value(observed),csa-file(input,path)))) then cmm-abort(input,"source-changed-before-publication",path) else cmm-fresh(input,rest);
  }
  def cmm-publish-all(input,stages,index) {
   if nil?(stages) then index else cmm-publish-one(input,head(stages),tail(stages),index);
  }
  def cmm-publish-one(input,stage,rest,index) {
   let path = head(stage); let pending = nth(stage,1); let bytes = nth(stage,2);
   let reading = oh-reading("concept-materializer",path,"publication-ready",json-node-int(str_len(bytes)),json-node-int(file_size(pending)),json-node-int(1),list(),list("publish","defer"),json-node-object(list(oh-s("pending",pending),oh-n("published_before",index))));
   oh-voice(reading);
   let response = oh-response(reading,"publish");
   oh-voice(response);
   let selected = oh-select(reading,response,"defer");
   let status = if str_eq(selected,"publish") then fs_rename(pending,path) else -1;
   if eq(status,0) then record_set(input,"published",add(index,1)) else 0;
   let observed = fbc-read-exact(path,0);
   let accepted = and(eq(status,0),and(fbc-good(observed),str_eq(fbc-value(observed),bytes)));
   oh-voice(oh-applied(reading,selected,json-node-int(accepted)));
   if not(accepted) then cmm-abort(input,"publish-rename",path) else 0;
   csa-check(input,"materialize-published-bytes",1,path);
   cmm-publish-all(input,rest,add(index,1));
  }
  def cmm-publish(prepared) {
   cmm-freeze(prepared);
   let input = record_get(prepared,"input");
   let suffix = str_concat(".stage-",str_concat(int_to_str(host_pid()),str_concat("-",int_to_str(host_monotonic_ms()))));
   let stages = cmm-stages(input,record_get(prepared,"outputs"),suffix);
   record_set(prepared,"stages",stages);
   record_set(input,"owned-stages",list());
   record_set(input,"published",0);
   cmm-check(input,"private-stage-paths",cmm-stage-free(input,stages));
   cmm-stage-all(input,stages);
   cmm-check(input,"source-fresh-before-publication",cmm-fresh(input,record_get(input,"files")));
   let published = cmm-publish-all(input,stages,0);
   cmm-check(input,"all-artifacts-published",eq(published,5));
   cmm-check(input,"private-stages-released",cmm-clean-stages(record_get(input,"owned-stages")));
   record_set(input,"owned-stages",list());
   // The manifest is last. Each file rename is atomic; five files are not a
   // single atomic generation. The fresh full read observes final agreement.
   csa-run-with(record_get(input,"root"),record_get(input,"hash"));
   print_str(json-emit-precise(json-node-object(list(oh-s("schema","form-concept-materialization-v1"),oh-n("rows",10000),oh-n("repairs",111),oh-n("cells",130000),oh-n("artifacts",published),oh-s("tableSha256",record_get(prepared,"table-sha256")),oh-s("sourcesSha256",record_get(prepared,"sources-sha256")),json-node-pair("sourceCounts",record_get(prepared,"source-counts"))))));
   1;
  }
  def cmm-run(root,engine) = cmm-publish(cmm-validate(cmm-prepare(root,engine)));
  def cmm-request(text) {
   if not(jwa-valid(text)) then csa-input-refused("complete JSON required") else 0;
   let request = parse-json("concept-materializer-request",text);
   if not(node_eq(node_category(request),JSON-OBJECT())) then csa-input-refused("request object required") else 0;
   if not(csa-request-fields(json-object-pairs(request),list())) then csa-input-refused("unique string root/hash fields required") else 0;
   cmm-run(if json-object-has?(request,"root") then json-string-value(json-object-get(request,"root")) else ".",if json-object-has?(request,"hash") then json-string-value(json-object-get(request,"hash")) else "form-sha256");
  }
  def cmm-home() {
   let text = read_line();
   if or(nothing?(text),str_eq(text,"")) then cmm-run(".","form-sha256") else cmm-request(text);
  }
 }
 0;
}
