//////////////////////////////////////////////////////////////////////
//
// form-knowledge-integration-census.bml — high-grammar authority.
//
// "Known by the local model" is not a prompt-length claim.  A source is
// integrated only after an independently held-out case makes the local model
// emit the bounded Form knowledge-query envelope, the native walker resolves
// it to grounded REF/CTOR NodeIDs and provenance keys, a native execution
// agrees with its expected result, and the reasoning verdict cites that same
// currently accessible source. Prefix exposure and learned weights remain
// separate axes: RAG success cannot masquerade as a tensor update.
//
// The executable implementation is
// form/form-stdlib/form-knowledge-integration-census.fk.
//
//////////////////////////////////////////////////////////////////////

package Form.knowledge.integration;

import Form.kernel.*;
import Form.cli.flow.*;

enum HeldoutFamily [public] {
   COUNTEREXAMPLE,
   CROSS_OPERATION,
   NOVEL_PROGRAM,
   ADVERSARIAL_BOUNDARY
}

interface IKnowledgeIntegrationCensus [public, witness, reusable] {
   section [public] {
      const int IntegrationThresholdPercent = 95;
      const String QueryProtocol = "form-knowledge-query-token-v1";
      const String EvidenceBasis = "current-source+source-artifact-sha256+grounded-nodeid-rag+provenance+prefix+weights-v1";

      Object Census() [abstract];
      Object QueryObservation( String strSurface, Object hTypedResult ) [abstract];
      Object SourceRetrievalObservation( String strRoot, Object hAtoms, Object hSourceArtifactResult ) [abstract];
      Object Report( Object hSources, Object hConcepts, Object hObservations ) [abstract];
      bool Ready95( Object hReport ) [abstract];
   }
}

template IntegrationObservation<TConcept> [public, reusable] {
   section [public] {
      String SourcePath() [get];
      TConcept Concept() [get];
      Object LeakageAudit() [get];
      Object QueryObservation() [get];
      Object SourceRetrievalObservation() [get];
      Object NativeExecution() [get];
      Object ReasoningVerdict() [get];
      Object LocalModelEvidence() [get];
   }
}

class FormKnowledgeIntegrationCensus [public, reusable, teach, observable] : IKnowledgeIntegrationCensus {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-knowledge-integration-census.fk";
      const String Scope = "repository-live census of authoritative .fk .bml .bmf .form .md; generated xtal excluded";

      Object Census() [abstract] {}
      Object QueryObservation( String strSurface, Object hTypedResult ) [abstract] {}
      Object SourceRetrievalObservation( String strRoot, Object hAtoms, Object hSourceArtifactResult ) [abstract] {}
      Object Report( Object hSources, Object hConcepts, Object hObservations ) [abstract] {}
      bool Ready95( Object hReport ) [abstract] {}
   }
}
