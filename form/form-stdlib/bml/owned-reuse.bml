// Reuse within one caller-owned immutable epoch. The producer and every
// dependency stay fixed until release; effects and live reads need a new owner.
// Exact argument equality resolves printable-key collisions. Refusals are not
// retained. Empty lists, zero and one remain ordinary reusable values.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class OwnedReuse {
  def reuse-open(epoch,context,produce,retain) = record_new(0,
   "epoch",epoch,"context",context,"produce",produce,"retain",retain,"cells",record_new(0),
   "hits",0,"misses",0,"entries",0,"released",0);
  def reuse-find(rows,key) = nil?(rows) ? nothing() : value_eq(head(head(rows)),key) ? head(rows) : reuse-find(tail(rows),key);
  def reuse-call(owner,key) {
   if record_get(owner,"released") then nothing() else {
    let cells = record_get(owner,"cells"); let label = value_str(key);
    let rows = record_has(cells,label) ? record_get(cells,label) : [];
    let found = reuse-find(rows,key); let hit = !nothing?(found);
    let counter = hit ? "hits" : "misses";
    record_set(owner,counter,record_get(owner,counter) + 1);
    if hit then found[1] else {
     let produce = record_get(owner,"produce"); let retain = record_get(owner,"retain");
     let value = produce(record_get(owner,"context"),key);
     if retain(value) then {
      record_set(cells,label,cons([key,value],rows));
      record_set(owner,"entries",record_get(owner,"entries") + 1);
     } else 0;
     value;
    };
   };
  }
  def reuse-clear(cells,keys) {
   if nil?(keys) then 1 else { record_set(cells,head(keys),nothing()); reuse-clear(cells,tail(keys)); };
  }
  def reuse-release(owner) {
   let cells = record_get(owner,"cells");
   if !record_get(owner,"released") then reuse-clear(cells,record_keys(cells)) else 1;
   record_set(owner,"cells",nothing()); record_set(owner,"context",nothing());
   record_set(owner,"produce",nothing()); record_set(owner,"retain",nothing());
   record_set(owner,"released",1); 1;
  }
 }
}
