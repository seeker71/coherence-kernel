//////////////////////////////////////////////////////////////////////
// integer-power.bml -- exact non-negative integer powers as a small
// high-grammar Form primitive. The rule halves even exponents, so its
// work grows with exponent bits rather than exponent magnitude.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk

section [form.bml] {
    class FormIntegerPower {
        thought integer-power-pattern = list("integer", "nonnegative", "square-even", "multiply-odd", "nothing-negative");

        def fip-supported?(exponent) = if ge(exponent, 0) then 1 else 0;
        def fip-even?(exponent) = if eq(mod(exponent, 2), 0) then 1 else 0;
        def fip-pow(base, exponent) = if eq(fip-supported?(exponent), 0) then nothing() else fip-pow-nonnegative(base, exponent);
        def fip-pow-nonnegative(base, exponent) = if eq(exponent, 0) then 1 else fip-pow-positive(base, exponent);
        def fip-pow-positive(base, exponent) = if eq(fip-even?(exponent), 1) then fip-pow-square(base, exponent) else mul(base, fip-pow-nonnegative(base, sub(exponent, 1)));
        def fip-pow-square(base, exponent) {
            let half = fip-pow-nonnegative(base, div(exponent, 2));
            mul(half, half);
        }
        // A separate observation of branch depth keeps performance evidence
        // out of the hot result path. It names the exact recurrence, not an
        // imposed cap or a proxy counter.
        def fip-depth(exponent) = if eq(fip-supported?(exponent), 0) then nothing() else fip-depth-nonnegative(exponent);
        def fip-depth-nonnegative(exponent) = if eq(exponent, 0) then 0 else if eq(fip-even?(exponent), 1) then add(1, fip-depth-nonnegative(div(exponent, 2))) else add(1, fip-depth-nonnegative(sub(exponent, 1)));
    }
    0;
}
