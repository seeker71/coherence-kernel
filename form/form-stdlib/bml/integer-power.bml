//////////////////////////////////////////////////////////////////////
// integer-power.bml -- exact non-negative integer powers as a small
// high-grammar Form primitive. The rule halves even exponents, so its
// work grows with exponent bits rather than exponent magnitude.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk

section [form.bml] {
    class FormIntegerPower {
        thought integer-power-pattern = ["integer", "nonnegative", "square-even", "multiply-odd", "nothing-negative"];

        def fip-supported?(exponent) = exponent >= 0 ? 1 : 0;
        def fip-even?(exponent) = (Comparable) (exponent % 2) == 0 ? 1 : 0;
        def fip-pow(base, exponent) = (Comparable) fip-supported?(exponent) == 0 ? nothing() : fip-pow-nonnegative(base, exponent);
        def fip-pow-nonnegative(base, exponent) = (Comparable) exponent == 0 ? 1 : fip-pow-positive(base, exponent);
        def fip-pow-positive(base, exponent) = (Comparable) fip-even?(exponent) == 1 ? fip-pow-square(base, exponent) : (base * fip-pow-nonnegative(base, exponent - 1));
        def fip-pow-square(base, exponent) {
            let half = fip-pow-nonnegative(base, exponent / 2);
            half * half;
        }
        // A separate observation of branch depth keeps performance evidence
        // out of the hot result path. It names the exact recurrence, not an
        // imposed cap or a proxy counter.
        def fip-depth(exponent) = (Comparable) fip-supported?(exponent) == 0 ? nothing() : fip-depth-nonnegative(exponent);
        def fip-depth-nonnegative(exponent) = (Comparable) exponent == 0 ? 0 : (Comparable) fip-even?(exponent) == 1 ? (1 + fip-depth-nonnegative(exponent / 2)) : (1 + fip-depth-nonnegative(exponent - 1));
    }
    0;
}
