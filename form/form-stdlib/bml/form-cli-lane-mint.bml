//////////////////////////////////////////////////////////////////////
//
// form-cli-lane-mint.bml — high-grammar authority.
//
// Expand every milled skill across every query lane so the local
// layer generalizes: seven inquiry planes (when/where/which
// computable; what/who/how/why learned), the knowledge-query
// envelope, and the form-cli walk (native then local then remote).
// Cartesian coverage. Overlay fits the LANE, not the skill — the
// skill rides inside the question. Leakage 0. LoRA writer stays 0.
//
// Executable: form-stdlib/form-cli-lane-mint.bml
// Proven by: form-stdlib/tests/form-cli-lane-mint-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.lanemint;

import Form.kernel.*;
import Form.cli.flow.*;

enum SampleSplit [public] {
   TRAIN,
   HELDOUT
}

interface ILaneMint [public, witness, reusable] {
   section [public] {
      const int MixA = 7;
      const int MixB = 13;
      const int NSkills = 41;
      const int NLanes = 9;
      const int LoraWriter = 0;
      const String TrustRule = "every skill on every query lane; measure heldout; LoRA tensors wait on lift";

      int Mix( int nI, int nMod ) [abstract];
      String Situation( String strSkill, String strLane, int nI, String strSplit ) [abstract];
      int Leakage( Object hRows ) [abstract];
      int Unique( Object hRows ) [abstract];
      int LoraWriterReady() [abstract];
   }
}

template SampleRow<TClass> [public, reusable] {
   section [public] {
      String Split() [get];
      TClass Class() [get];
      String Situation() [get];
   }
}

class FormLaneMint [public, reusable, teach] : ILaneMint {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-lane-mint.bml";

      int Mix( int nI, int nMod ) [abstract] {}
      String Situation( String strSkill, String strLane, int nI, String strSplit ) [abstract] {}
      int Leakage( Object hRows ) [abstract] {}
      int Unique( Object hRows ) [abstract] {}
      int LoraWriterReady() [abstract] {}
   }
}

class FormLaneMintSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-lane-mint-self";
      const String Pattern = "cartesian-skill-lane heldout-leakage-0 overlay-fit-lane lora-identity-waits";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
