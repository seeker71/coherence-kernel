//////////////////////////////////////////////////////////////////////
// IQ4_NL (GGML type 20) layout authority for Flash-Next.
//////////////////////////////////////////////////////////////////////

package Form.native.quant;

import Form.kernel.*;
import Form.native.metal.*;

interface IIQ4NLLayout [public, witness, reusable] {
   section [public] {
      const int GGMLType = 20;
      const int BlockElements = 32;
      const int BlockBytes = 18;
      const int QuantOffset = 2;
      const int CodebookEntries = 16;
      const int SIMDWidth = 32;

      int QuantCode( Object bytes, int blockBase, int weightIndex ) [abstract];
      int SlotThreadCount( int rows ) [abstract];
      bool WithinBlock( int weightIndex ) [abstract];
   }
}

class IQ4NLLayout [public, reusable, teach, observable] : IIQ4NLLayout {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/iq4nl-layout.bml";
      const String Model = "Qwen3.8-Flash-Next UD-Q2_K_XL";
      int QuantCode( Object bytes, int blockBase, int weightIndex ) [abstract] {}
      int SlotThreadCount( int rows ) [abstract] {}
      bool WithinBlock( int weightIndex ) [abstract] {}
   }
}
