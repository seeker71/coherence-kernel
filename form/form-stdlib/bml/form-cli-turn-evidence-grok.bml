//////////////////////////////////////////////////////////////////////
//
// form-cli-turn-evidence-grok.bml — high-grammar authority for Grok
// session share. Named constants, templates, generics, class methods.
//
// Executable lowering: form-stdlib/form-cli-turn-evidence-grok.bml
// (generic class FormGrokEvidence<T>, fields as named constants).
//
// Magic strings and widths do not live in method bodies. A receipt is
// a reusable accumulator shape. Native / local / remote are named
// lanes, not 0/1/2 at the call site.
//
// Proven by: form-stdlib/tests/form-cli-turn-evidence-grok-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.evidence.grok;

import Form.kernel.*;
import Form.stdlib.fs.*;

enum EvidenceLane [public] {
   NATIVE,
   LOCAL,
   REMOTE
}

enum RefreshHealth [public] {
   WITHHELD,
   UNRECONCILED,
   OBSERVED
}

interface IGrokMeter [public, witness, reusable] {
   section [public] {
      const String BindPath = ".form-cli-turn-grok-session";
      const String ReceiptMark = "@form ";
      const int ReceiptMarkLen = 6;
      const String NativeKind = "fkwu";
      const String LogSuffix = ".log";
      const String TerminalName = "terminal";
      const String EventsName = "events.jsonl";
      const String TurnStartedMark = "\"type\":\"turn_started\"";
      const String ToolCompletedMark = "\"type\":\"tool_completed\"";
      const String TsKey = "\"ts\":";
      const String Provider = "xai";
      const String Model = "grok-4.6";
      const String TurnScope = "session";
      const String Pipe = "|";
      const String ZeroStr = "0";
      const String CompleteStr = "1";
      const int ChunkBytes = 1048576;
      const int OverlapBytes = 32;
      const int HeaderBytes = 512;
      const int TailBytes = 1024;
      const int AccWidth = 7;

      String BoundSession() [abstract];
      String RefreshOnce( String strSession ) [abstract];
      String Row( String strThread, String strTurn, int nNative, int nNfail, int nLocal, int nLfail, int nRemote, int nStdout, int nStderr, int nShown, int nTools, int nStarted, int nEnded ) [abstract];
   }
}

template ReceiptAcc<TCount> [public, reusable] {
   section [public] {
      TCount Native() [get];
      TCount Local() [get];
      TCount NativeFail() [get];
      TCount LocalFail() [get];
      TCount Stdout() [get];
      TCount Stderr() [get];
      TCount Shown() [get];
   }
}

template SessionPaths<TPath> [public, reusable] {
   section [public] {
      TPath Root() [get];
      TPath Terminal() [get];
      TPath Events() [get];
   }
}

class FormGrokEvidence [public, reusable, evidence] : IGrokMeter {
   section [public] {
      const String SourceKind = "grok-form-run-logs+explicit-form-binding";
      const String ExecutablePath = "form/form-stdlib/form-cli-turn-evidence-grok.bml";
      const String TrustRule = "marks, widths, and lanes are named fields, never magic in the methods";

      String BoundSession() [abstract] {}
      String RefreshOnce( String strSession ) [abstract] {}
      String Row( String strThread, String strTurn, int nNative, int nNfail, int nLocal, int nLfail, int nRemote, int nStdout, int nStderr, int nShown, int nTools, int nStarted, int nEnded ) [abstract] {}
   }
}

class FormGrokEvidenceSelf [public, selfHosting, evidence, observable] {
   section [public] {
      const String CoreName = "form-cli-turn-evidence-grok-self";
      const String Pattern = "named-const template generic class-method receipt-scan-row";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
