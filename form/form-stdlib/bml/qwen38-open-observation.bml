//////////////////////////////////////////////////////////////////////
// qwen38-open-observation.bml -- the observable native admission path.
//
// Opening a local Qwen context is not one unknowable wait.  Form reads and
// validates the artifact, derives geometry, JITs the MSL pipelines, allocates
// scratch, maps layer views, and binds terminal tensor views.  This BML cell
// owns those names, source coordinates, and their generic glass projection.
// No prompt, response, model path, or model byte crosses the event boundary.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk

section [form.bml] {
    class Qwen38OpenObservation {
        field Route = "model-admission";
        field Source = "native/metal/qwen35-dense-token-handle.fk";
        field BeginSuffix = "-begin";
        field BeginStatus = "begin";
        field SettledStatus = "value";
        field ArtifactCoordinate = 102201;
        field GeometryCoordinate = 102202;
        field PipelineCoordinate = 102203;
        field ScratchCoordinate = 102204;
        field LayerCoordinate = 102205;
        field TensorCoordinate = 102206;
        field OpenCoordinate = 102207;

        def q38oo-route() = Route();
        def q38oo-source() = Source();
        def q38oo-begin-suffix() = BeginSuffix();
        def q38oo-stage-status(phase) = if ge(str_find(phase, q38oo-begin-suffix(), 0), 0) then BeginStatus() else SettledStatus();
        def q38oo-stage-line(phase, stampMs) = str_concat("form-peer stage route=", str_concat(q38oo-route(), str_concat(" phase=", str_concat(phase, str_concat(" status=", str_concat(q38oo-stage-status(phase), str_concat(" stamp-ms=", str_concat(int_to_str(stampMs), "\n"))))))));
        def q38oo-stage(phase, coordinate) {
            fb_record(intern_trivial_string(phase), q38oo-source(), coordinate);
            print_str(q38oo-stage-line(phase, now_unix_ms()));
            0;
        }
        def q38oo-artifact-begin() = q38oo-stage("model-artifact-admission-begin", ArtifactCoordinate());
        def q38oo-artifact-ready() = q38oo-stage("model-artifact-admission-ready", ArtifactCoordinate());
        def q38oo-artifact-refused() = q38oo-stage("model-artifact-admission-refused", ArtifactCoordinate());
        def q38oo-geometry-begin() = q38oo-stage("model-geometry-begin", GeometryCoordinate());
        def q38oo-geometry-ready() = q38oo-stage("model-geometry-ready", GeometryCoordinate());
        def q38oo-pipeline-begin() = q38oo-stage("model-pipeline-jit-begin", PipelineCoordinate());
        def q38oo-pipeline-ready() = q38oo-stage("model-pipeline-jit-ready", PipelineCoordinate());
        def q38oo-scratch-begin() = q38oo-stage("model-scratch-begin", ScratchCoordinate());
        def q38oo-scratch-ready() = q38oo-stage("model-scratch-ready", ScratchCoordinate());
        def q38oo-layer-begin() = q38oo-stage("model-layer-map-begin", LayerCoordinate());
        def q38oo-layer-ready() = q38oo-stage("model-layer-map-ready", LayerCoordinate());
        def q38oo-tensor-begin() = q38oo-stage("model-tensor-view-begin", TensorCoordinate());
        def q38oo-tensor-ready() = q38oo-stage("model-tensor-view-ready", TensorCoordinate());
        def q38oo-open-ready() = q38oo-stage("model-open-ready", OpenCoordinate());
    }
    0;
}
