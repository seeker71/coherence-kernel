// A lock belongs to one callback and its native file lease. Cell deadlines
// close that lease even when Form defer cannot run. The owner directory keeps
// the held identity visible; an exclusive successor can retire its residue.
// Named legacy owners remain held until their process is observed to end.
import form-stdlib/bml/native-posix.bml;
section [form.bml] {
 class DirLock {
  def dl-owner-path(lock) = lock+"/owner";
  def dl-owner(lock) = read_file(dl-owner-path(lock)) ?? "";
  def dl-text(pid,now) = "pid="+pid.str()+" at="+now.str();
  def dl-digits(text,from,i) = i<len(text) && str_byte_at(text,i)>=48 && str_byte_at(text,i)<=57 ? dl-digits(text,from,i+1) : i>from ? str_to_int(substring(text,from,i)) : nothing();
  def dl-field(text,key) {let at=str_find(text,key,0);at<0 ? nothing() : dl-digits(text,at+len(key),at+len(key));}
  def dl-age-of(at,now) = value_kind(at)!="int" ? 0 : at<=0 ? 0 : (now/1000)-at;
  def dl-age-ms(path) = dl-age-of(file_mtime(path),now_unix_ms())*1000;
  def dl-began(pid) {
   let row=host_process(pid);
   value_kind(row)!="list" ? nothing() : len(row)<6 ? nothing() : value_kind(row[5])!="int" ? nothing() : row[5];
  }
  def dl-holds?(pid,at) {
   let alive=host_alive(pid);let began=dl-began(pid);
   alive==0 ? false : nothing?(alive) || nothing?(at) || nothing?(began) || began<=0 ? nothing() : began<=at+1000;
  }
  def dl-backoff(tries) = tries>=5 ? 32 : [1,2,4,8,16][tries];
  def dl-file(lock) = lock+".scoped-v1";
  def dl-expired(deadline) = !nothing?(deadline) && host_monotonic_ms()>=deadline;
  def dl-current(lease,path) {
   let current=nps-file-open(path,0);
   value_kind(current)!="list" ? 0 : {
    defer nps-file-settle(current);
    let held=nps-file-identity(lease);let seen=nps-file-identity(current);
    !nothing?(held) && !nothing?(seen) && take(2,held)==take(2,seen);
   };
  }
  def dl-owned?(owner) = dl-owner(owner[0])==owner[2] && dl-current(owner[1],dl-file(owner[0]));
  def dl-finish(owner) {
   let removed=dl-owned?(owner) ? host_dir_rmdir(owner[0]) : -1;
   nps-file-settle(owner[1]);removed;
  }
   // The operation record survives a callback or finalizer refusal. Callers
   // that retain effects can carry this same owner into their continuation.
   def dl-settle-operation(operation) {
    let lease=record_get(operation,"lease");let owner=record_get(operation,"owner");
    let released=try {nothing?(lease) ? 1 : {nothing?(owner) ? nps-file-settle(lease) : dl-finish(owner);nps-file-held(lease)==0;};} catch 0;
    record_set(operation,"released",released);released;
   }
   def dl-with-lock(lock,patience,body) {
    let operation=record_new(0);
    let result=dl-with-lock-owned(lock,patience,body,operation);
    record_get(operation,"released")==1 ? result : form_error("directory lock release incomplete");
   }
   def dl-with-lock-owned(lock,patience,body,operation) {
   let lease=nps-file-open(dl-file(lock),1);
    value_kind(lease)!="list" ? {record_set(operation,"released",1);nothing();} : {
     record_set(operation,"lease",lease);record_set(operation,"released",0);
     defer dl-settle-operation(operation);
    let deadline=nothing?(patience) ? nothing() : host_monotonic_ms()+patience;
    let owner=dl-acquire(lock,lease,deadline,0);
    nothing?(owner) ? nothing() : {
      record_set(operation,"owner",owner);
     body(owner);
    };
   };
  }
  def dl-acquire(lock,lease,deadline,tries) {
   let locked=nps-file-try-exclusive(lease[1]);
   locked==0 ? dl-current(lease,dl-file(lock)) ? dl-admit(lock,lease,deadline,0) : nothing()
    : locked != -11 || dl-expired(deadline) ? nothing() : {host_sleep_ms(dl-backoff(tries));dl-acquire(lock,lease,deadline,tries+1);};
  }
  def dl-admit(lock,lease,deadline,tries) {
   let made=host_dir_mkdir(lock);
   made==1 ? dl-own(lock,lease) : host_path_is_dir(lock)!=1 ? nothing() : {
    let text=dl-owner(lock);let pid=dl-field(text,"pid=");let at=dl-field(text," at=");
    // Holding the persistent file excludes any live scoped callback. An
    // unknown legacy owner is not made dead by the passage of time.
    !nothing?(dl-field(text," scoped=")) || (!nothing?(pid) && dl-holds?(pid,at)==false) ? dl-own(lock,lease)
     : dl-expired(deadline) ? nothing() : {host_sleep_ms(dl-backoff(tries));dl-admit(lock,lease,deadline,tries+1);};
   };
  }
  def dl-own(lock,lease) {
   let text=dl-text(host_pid(),now_unix_ms())+" scoped="+lease[0].str();
   write_file_text(dl-owner-path(lock),text);
   dl-owner(lock)==text ? [lock,lease,text] : nothing();
  }
 }
 0;
}
