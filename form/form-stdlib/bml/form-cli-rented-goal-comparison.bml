//////////////////////////////////////////////////////////////////////
//
// form-cli-rented-goal-comparison.bml — scannerless comparison of the
// observed normal rented-session baseline with one exact local Form-cli run.
//
// A historical normal-session receipt is not a provider-call receipt.  This
// grammar gives it its own explicit source, validates its stated provenance,
// and never feeds it into the stricter provider-only comparator.  The local
// side is admitted only from a durable task/reply pair whose exact task is the
// BML-owned goal and whose reply is direct Metal execution with zero callback
// crossings.  Prompt and answer bytes remain in the caller-owned spools.
//
// preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-embodied-goal-grammar.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormCliRentedGoalComparison {
        field ComparisonTag = "form-cli-rented-goal-comparison-v1";
        field ComparisonSource = "historical-rented-session-vs-local-direct";
        field HistoricalBaselineSource = "historical-rented-session-transcript";
        field LocalSource = "local-direct-no-provider";
        field TaskOpen = "<|form:agent-task|>";
        field TaskClose = "<|/form:agent-task|>";
        field ReplyClose = "<|/form:peer-contribution|>";
        field HistoricalHeading = "The goal, sharpened by Urs: the ORIGINAL prompt";
        field HistoricalQuantity = "93,628 output tokens across 118 assistant messages.";
        field HistoricalWitness = "; witnessed: 2026-08-30 -> denominator 93628";
        field HistoricalNormalTokens = 93628;
        field TenPercentBps = 1000;

        def fcgrc-tag() = ComparisonTag();
        def fcgrc-source() = ComparisonSource();
        def fcgrc-baseline-source() = HistoricalBaselineSource();
        def fcgrc-local-source() = LocalSource();
        def fcgrc-task-open() = TaskOpen();
        def fcgrc-task-close() = TaskClose();
        def fcgrc-reply-close() = ReplyClose();
        def fcgrc-normal-tokens() = HistoricalNormalTokens();
        def fcgrc-ten-percent-bps() = TenPercentBps();

        // A scalar zero is accepted only after the direct no-provider reply
        // has been observed.  Missing or malformed evidence remains nothing.
        def fcgrc-has?(text, needle) = if nothing?(text) then 0 else if ge(str_find(text, needle, 0), 0) then 1 else 0;
        def fcgrc-history?(text) = if eq(fcgrc-has?(text, HistoricalHeading()), 0) then 0 else if eq(fcgrc-has?(text, HistoricalQuantity()), 0) then 0 else if eq(fcgrc-has?(text, HistoricalWitness()), 0) then 0 else 1;

        // Select a fully bounded task frame.  The turn marker is checked
        // inside that frame, so an adjacent turn cannot donate its identity.
        def fcgrc-task-frame-present(text, turnmark, start, end) {
            let stop = add(end, str_len(TaskClose()));
            let frame = substring(text, start, stop);
            if ge(str_find(frame, turnmark, 0), 0) then frame else fcgrc-task-frame-go(text, turnmark, stop);
        }
        def fcgrc-task-frame-found(text, turnmark, start) {
            let end = str_find(text, TaskClose(), start);
            if lt(end, 0) then nothing() else fcgrc-task-frame-present(text, turnmark, start, end);
        }
        def fcgrc-task-frame-go(text, turnmark, from) {
            let start = str_find(text, TaskOpen(), from);
            if lt(start, 0) then nothing() else fcgrc-task-frame-found(text, turnmark, start);
        }
        def fcgrc-task-frame(text, turn) = if or(nothing?(text), le(turn, 0)) then nothing() else fcgrc-task-frame-go(text, str_concat("turn=", str_concat(int_to_str(turn), "\n")), 0);
        def fcgrc-exact-task?(frame) = if nothing?(frame) then 0 else if eq(fcgrc-has?(frame, "kind=direct-answer\n"), 0) then 0 else if eq(fcgrc-has?(frame, str_concat("task=", str_concat(fcpdag-embodied-goal-prompt(), "\n"))), 0) then 0 else 1;

        // Replies do not have an opening wrapper; their turn line and durable
        // contribution terminator jointly make the frame.  No response body
        // participates in this admission.
        def fcgrc-reply-frame-found(text, start) {
            let end = str_find(text, ReplyClose(), start);
            if lt(end, 0) then nothing() else substring(text, start, add(end, str_len(ReplyClose())));
        }
        def fcgrc-reply-frame-go(text, turnmark, from) {
            let start = str_find(text, turnmark, from);
            if lt(start, 0) then nothing() else fcgrc-reply-frame-found(text, start);
        }
        def fcgrc-reply-frame(text, turn) = if or(nothing?(text), le(turn, 0)) then nothing() else fcgrc-reply-frame-go(text, str_concat("turn=", str_concat(int_to_str(turn), "\n")), 0);
        def fcgrc-direct-reply?(frame) = if nothing?(frame) then 0 else if eq(fcgrc-has?(frame, "signal=candidate\n"), 0) then 0 else if eq(fcgrc-has?(frame, "route=direct-answer\n"), 0) then 0 else if eq(fcgrc-has?(frame, "callback-calls=0\n"), 0) then 0 else if eq(fcgrc-has?(frame, "lookup-count=0\n"), 0) then 0 else if eq(fcgrc-has?(frame, "injected-bytes=0\n"), 0) then 0 else if eq(fcgrc-has?(frame, "carrier=form-native-metal-jit\n"), 0) then 0 else if eq(fcgrc-has?(frame, "lifecycle=generate,release\n"), 0) then 0 else 1;

        // result = tag status source reason task-turn normal-remote-tokens
        //          form-cli-remote-tokens ratio-bps under-ten-percent.
        def fcgrc-result(status, reason, taskturn, normal, local, ratio, under) = list(fcgrc-tag(), status, fcgrc-source(), reason, taskturn, normal, local, ratio, under);
        def fcgrc-status(value) = nth(value, 1);
        def fcgrc-source-of(value) = nth(value, 2);
        def fcgrc-reason(value) = nth(value, 3);
        def fcgrc-task-turn(value) = nth(value, 4);
        def fcgrc-normal-remote-tokens(value) = nth(value, 5);
        def fcgrc-form-cli-remote-tokens(value) = nth(value, 6);
        def fcgrc-ratio-bps(value) = nth(value, 7);
        def fcgrc-under-ten-percent?(value) = nth(value, 8);
        def fcgrc-choice?(value) = if nothing?(value) then 0 else if not(eq(len(value), 9)) then 0 else if not(str_eq(nth(value, 0), fcgrc-tag())) then 0 else if not(str_eq(fcgrc-status(value), "choice")) then 0 else if not(nothing?(fcgrc-normal-remote-tokens(value))) then 0 else if not(nothing?(fcgrc-form-cli-remote-tokens(value))) then 0 else if not(nothing?(fcgrc-ratio-bps(value))) then 0 else nothing?(fcgrc-under-ten-percent?(value));
        def fcgrc-value?(value) = if nothing?(value) then 0 else if not(eq(len(value), 9)) then 0 else if not(str_eq(nth(value, 0), fcgrc-tag())) then 0 else if not(str_eq(fcgrc-status(value), "value")) then 0 else if not(eq(fcgrc-normal-remote-tokens(value), fcgrc-normal-tokens())) then 0 else if not(eq(fcgrc-form-cli-remote-tokens(value), 0)) then 0 else if not(eq(fcgrc-ratio-bps(value), 0)) then 0 else eq(fcgrc-under-ten-percent?(value), 1);
        def fcgrc-refuse(reason, turn) = fcgrc-result("choice", reason, turn, nothing(), nothing(), nothing(), nothing());
        def fcgrc-compare(history, tasks, replies, turn) {
            let task = fcgrc-task-frame(tasks, turn);
            let reply = fcgrc-reply-frame(replies, turn);
            if eq(fcgrc-history?(history), 0) then fcgrc-refuse("historical-baseline-unverified", turn) else if eq(fcgrc-exact-task?(task), 0) then fcgrc-refuse("exact-local-task-absent", turn) else if eq(fcgrc-direct-reply?(reply), 0) then fcgrc-refuse("direct-metal-reply-absent", turn) else fcgrc-result("value", "observed", turn, fcgrc-normal-tokens(), 0, 0, 1);
        }
    }
    0;
}
