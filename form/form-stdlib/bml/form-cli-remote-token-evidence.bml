//////////////////////////////////////////////////////////////////////
//
// form-cli-remote-token-evidence.bml — high-grammar authority for
// remote-token evidence carried by Codex rollouts.
//
// The remote model's own reported quantities are the denominator for a
// remote-token reduction claim. Provider-event count stays a separate boundary
// trace; it is never substituted for token volume. The executable collector
// selects `last_token_usage` for each completed call and sums those call-local
// quantities. Cumulative rollout totals are never summed. Prompt, answer, and
// reasoning content do not enter the receipt.
//
// Executable collector: form-stdlib/form-cli-turn-evidence-live.fk
// Proven by: form-stdlib/tests/form-cli-turn-evidence-live-band.fk
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk form-stdlib/language-template.fk

section [form.bml] {
    template RemoteTokenTotals<TCount> {
        member input: TCount;
        member cachedInput: TCount;
        member cacheWriteInput: TCount;
        member output: TCount;
        member reasoningOutput: TCount;
        member total: TCount;
    }

    // A comparison names one task node and two settled boundary receipts.  It
    // deliberately carries quantities and their source, never task prose,
    // model prose, or a content hash used as bookkeeping.  A NodeID is already
    // the body's stable, caller-born identity for this turn.
    template ComparableRemoteTokenReceipt<TTaskNode, TCount> {
        member taskNode: TTaskNode;
        member settled: int;
        member source: String;
        member providerCalls: TCount;
        member remoteTokens: TCount;
    }

    class FormRemoteTokenEvidence {
        field EventName = "token_count";
        field LastUsageName = "last_token_usage";
        field CumulativeUsageName = "total_token_usage";
        field QuantityRule = "sum-last-call-quantity-per-completed-call";
        field BoundaryRule = "event-count-is-not-token-volume";
        field DiscoveryRule = "retain-native-backward-cursor-across-bound-rollout-appends";
        field ActiveRule = "last-completed-provider-call-is-pressure-not-settled-share";
        field PrivacyRule = "prompt-answer-reasoning-content-never-crosses-the-receipt";
        field ComparisonRule = "same-task-node-settled-provider-baseline-vs-local-direct";
        field ProviderSource = "provider-last-token-usage";
        field LocalDirectSource = "local-direct-no-provider";
        field ComparisonTag = "form-comparable-remote-token-receipt-v1";
        field ProviderWindowTag = "form-provider-call-window-v1";

        def frte-event-name() = EventName();
        def frte-last-usage-name() = LastUsageName();
        def frte-cumulative-usage-name() = CumulativeUsageName();
        def frte-quantity-rule() = QuantityRule();
        def frte-boundary-rule() = BoundaryRule();
        def frte-discovery-rule() = DiscoveryRule();
        def frte-active-rule() = ActiveRule();
        def frte-privacy-rule() = PrivacyRule();
        def frte-comparison-rule() = ComparisonRule();
        def frte-provider-source() = ProviderSource();
        def frte-local-direct-source() = LocalDirectSource();
        def frte-comparison-tag() = ComparisonTag();
        def frte-provider-window-tag() = ProviderWindowTag();
        def frte-separate-quantity-from-event?() = if str_eq(frte-boundary-rule(), "event-count-is-not-token-volume") then 1 else 0;
        def frte-last-not-cumulative?() = if str_eq(frte-last-usage-name(), "last_token_usage") then 1 else 0;
        def frte-last-usage-marker() = str_concat(byte_to_str(34), str_concat(frte-last-usage-name(), str_concat(byte_to_str(34), ":")));
        // Transport labels can evolve. The call-local usage object is the
        // semantic provider boundary; a historical `token_count` label is
        // retained as an event-count detail, never as the sole admission door.
        def frte-call-local-usage-line?(line) = if ge(str_find(line, frte-last-usage-marker(), 0), 0) then 1 else 0;
        def frte-terminal-message-marker() = "\"last_agent_message\":";
        def frte-turn-id-marker() = "\"turn_id\":";
        // A completed turn is identified by its relationship: a turn identity
        // joined to its terminal agent message. The legacy task_complete label
        // remains an additional witness, not the only way a rollout may end.
        def frte-terminal-completion-line?(line) = if eq(str_find(line, frte-turn-id-marker(), 0), sub(0, 1)) then 0 else if ge(str_find(line, "\"task_complete\"", 0), 0) then 1 else if ge(str_find(line, frte-terminal-message-marker(), 0), 0) then 1 else 0;

        // Provider usage is sparse in a rollout.  This grammar walks only
        // `last_token_usage` frames; it does not allocate one Form frame for
        // every unrelated JSONL line.  A scanned zero is a present value,
        // while unreadable or unselected evidence remains `nothing` outside
        // this reducer.
        def frte-window(calls, tokens) = list(frte-provider-window-tag(), calls, tokens);
        def frte-window?(value) = if nothing?(value) then 0 else if not(eq(len(value), 3)) then 0 else str_eq(nth(value, 0), frte-provider-window-tag());
        def frte-window-calls(value) = nth(value, 1);
        def frte-window-tokens(value) = nth(value, 2);
        def frte-window-add(value, tokens) = frte-window(add(frte-window-calls(value), 1), add(frte-window-tokens(value), tokens));
        def frte-window-field(name, value) = str_concat("\n", str_concat(name, str_concat("=", value)));
        // This frame holds only position and scalar provider evidence.  It is
        // an observation of one bounded window, never a claim that a whole
        // task has settled.
        def frte-window-frame(cursor, bytes, tally) = str_concat("provider-window=observed", str_concat(frte-window-field("cursor", int_to_str(cursor)), str_concat(frte-window-field("bytes", int_to_str(bytes)), str_concat(frte-window-field("provider-calls", int_to_str(frte-window-calls(tally))), str_concat(frte-window-field("remote-tokens", int_to_str(frte-window-tokens(tally))), "\n")))));
        def frte-digit?(cp) = if ge(cp, 48) then if le(cp, 57) then 1 else 0 else 0;
        def frte-number-end(text, at, end) = if ge(at, end) then at else if eq(frte-digit?(ord(char_at(text, at))), 1) then frte-number-end(text, add(at, 1), end) else at;
        def frte-int-in(text, mark, from, end) {
            let at = str_find(text, mark, from);
            let start = if lt(at, 0) then end else add(at, str_len(mark));
            let stop = frte-number-end(text, start, end);
            if or(lt(at, 0), ge(at, end)) then 0 else if eq(start, stop) then 0 else str_to_int(substring(text, start, stop));
        }
        def frte-line-end(text, from) {
            let at = str_find(text, "\n", from);
            if lt(at, 0) then str_len(text) else at;
        }
        // Walk back only inside one small provider event line.  Finding no LF
        // inside that cap refuses the marker rather than borrowing a provider
        // type from a preceding unrelated line.
        def frte-line-floor(at) = if lt(at, 4096) then 0 else sub(at, 4096);
        def frte-line-start(found, at) = list(found, at);
        def frte-line-start-found?(value) = nth(value, 0);
        def frte-line-start-at(value) = nth(value, 1);
        def frte-line-start-go(text, at, floor) = if le(at, floor) then if eq(floor, 0) then frte-line-start(1, 0) else frte-line-start(0, floor) else if eq(ord(char_at(text, sub(at, 1))), 10) then frte-line-start(1, at) else frte-line-start-go(text, sub(at, 1), floor);
        def frte-line-start-at-or-nothing(text, at) = frte-line-start-go(text, at, frte-line-floor(at));
        def frte-provider-usage-frame?(text, at, end) {
            let start = frte-line-start-at-or-nothing(text, at);
            let prefix = substring(text, frte-line-start-at(start), end);
            if eq(frte-line-start-found?(start), 0) then 0 else if eq(frte-call-local-usage-line?(prefix), 0) then 0 else if ge(str_find(prefix, "\"type\":\"token_count\"", 0), 0) then 1 else if ge(str_find(prefix, "\"type\":\"provider_usage\"", 0), 0) then 1 else 0;
        }
        def frte-window-scan(text, from, tally) {
            let at = str_find(text, frte-last-usage-marker(), from);
            let end = frte-line-end(text, if lt(at, 0) then from else at);
            if lt(at, 0) then tally else if eq(frte-provider-usage-frame?(text, at, end), 0) then frte-window-scan(text, add(end, 1), tally) else frte-window-scan(text, add(end, 1), frte-window-add(tally, frte-int-in(text, "\"total_tokens\":", at, end)));
        }
        def frte-provider-call-window(text) = frte-window-scan(text, 0, frte-window(0, 0));

        // receipt = tag task-node settled source provider-calls remote-tokens.
        // `nothing` is absence of a comparison side, never a zero-token row.
        def frte-receipt(taskNode, settled, source, providerCalls, remoteTokens) = list(frte-comparison-tag(), taskNode, settled, source, providerCalls, remoteTokens);
        def frte-receipt-task-node(receipt) = nth(receipt, 1);
        def frte-receipt-settled(receipt) = nth(receipt, 2);
        def frte-receipt-source(receipt) = nth(receipt, 3);
        def frte-receipt-provider-calls(receipt) = nth(receipt, 4);
        def frte-receipt-remote-tokens(receipt) = nth(receipt, 5);
        def frte-receipt?(receipt) = if nothing?(receipt) then 0 else if not(eq(len(receipt), 6)) then 0 else if not(str_eq(nth(receipt, 0), frte-comparison-tag())) then 0 else if not(eq(frte-receipt-settled(receipt), 1)) then 0 else if lt(frte-receipt-provider-calls(receipt), 0) then 0 else if lt(frte-receipt-remote-tokens(receipt), 0) then 0 else 1;
        def frte-provider-baseline?(receipt) = if eq(frte-receipt?(receipt), 0) then 0 else if not(str_eq(frte-receipt-source(receipt), frte-provider-source())) then 0 else if le(frte-receipt-provider-calls(receipt), 0) then 0 else if le(frte-receipt-remote-tokens(receipt), 0) then 0 else 1;
        def frte-local-direct?(receipt) = if eq(frte-receipt?(receipt), 0) then 0 else if not(str_eq(frte-receipt-source(receipt), frte-local-direct-source())) then 0 else if not(eq(frte-receipt-provider-calls(receipt), 0)) then 0 else if not(eq(frte-receipt-remote-tokens(receipt), 0)) then 0 else 1;
        def frte-same-task?(baseline, candidate) = if node_eq(frte-receipt-task-node(baseline), frte-receipt-task-node(candidate)) then 1 else 0;
        def frte-comparable?(baseline, candidate) = if eq(frte-provider-baseline?(baseline), 0) then 0 else if eq(frte-receipt?(candidate), 0) then 0 else frte-same-task?(baseline, candidate);
        // Basis points preserve the threshold's exact 10% = 1000 bps form.
        // Invalid or missing evidence remains nothing instead of being folded
        // into the valid numeric zero result.
        def frte-ratio-bps(baseline, candidate) = if eq(frte-comparable?(baseline, candidate), 0) then nothing() else floor(div(mul(frte-receipt-remote-tokens(candidate), 10000), frte-receipt-remote-tokens(baseline)));
        def frte-under-ten-percent?(baseline, candidate) {
            let ratio = frte-ratio-bps(baseline, candidate);
            if nothing?(ratio) then nothing() else if le(ratio, 1000) then 1 else 0;
        }
        def frte-local-direct-under-ten-percent?(baseline, localDirect) = if eq(frte-local-direct?(localDirect), 0) then nothing() else frte-under-ten-percent?(baseline, localDirect);
    }
    0;
}
