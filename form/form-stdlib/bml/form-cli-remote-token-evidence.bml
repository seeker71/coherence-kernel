//////////////////////////////////////////////////////////////////////
//
// form-cli-remote-token-evidence.bml — high-grammar authority for
// remote-token evidence carried by an agent's own transcript.
//
// Two providers write the same six quantities, each at its own explicit typed
// position: a Codex rollout at `payload.last_token_usage` (or
// `payload.info.last_token_usage`), and a Claude Code session at
// `message.usage`. Both are read exactly; neither is searched for by descent.
//
// The remote model's own reported quantities are the denominator for a
// remote-token reduction claim. Provider-event count stays a separate boundary
// trace; it is never substituted for token volume. The executable collector
// selects the per-call usage object for each completed call and sums those
// call-local quantities. Cumulative rollout totals are never summed. Prompt,
// answer, and reasoning content do not enter the receipt.
//
// Executable collector: form-stdlib/form-cli-turn-evidence-live.fk
// Proven by: form-stdlib/tests/form-cli-turn-evidence-live-band.fk
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk form-stdlib/language-template.fk form-stdlib/json.fk

section [form.bml] {
    template RemoteTokenTotals<TCount> {
        member input: TCount;
        member cachedInput: TCount;
        member cacheWriteInput: TCount;
        member output: TCount;
        member reasoningOutput: TCount;
        member total: TCount;
    }

    // A comparison names one task node and two settled boundary receipts.  It
    // deliberately carries quantities and their source, never task prose,
    // model prose, or a content hash used as bookkeeping.  A NodeID is already
    // the body's stable, caller-born identity for this turn.
    template ComparableRemoteTokenReceipt<TTaskNode, TCount> {
        member taskNode: TTaskNode;
        member settled: int;
        member source: String;
        member providerCalls: TCount;
        member remoteTokens: TCount;
    }

    class FormRemoteTokenEvidence {
        field EventName = "token_count";
        field AlternateEventName = "provider_usage";
        field EventEnvelopeName = "event_msg";
        field TerminalEventName = "turn_finished";
        field LegacyTerminalEventName = "task_complete";
        field LastUsageName = "last_token_usage";
        field CumulativeUsageName = "total_token_usage";
        field QuantityRule = "sum-last-call-quantity-per-completed-call";
        field BoundaryRule = "event-count-is-not-token-volume";
        field DiscoveryRule = "retain-native-backward-cursor-across-bound-rollout-appends";
        field ActiveRule = "last-completed-provider-call-is-pressure-not-settled-share";
        field PrivacyRule = "prompt-answer-reasoning-content-never-crosses-the-receipt";
        field ComparisonRule = "same-task-node-settled-provider-baseline-vs-local-direct";
        field ProviderSource = "provider-last-token-usage";
        field LocalDirectSource = "local-direct-no-provider";
        field ComparisonTag = "form-comparable-remote-token-receipt-v1";
        field ProviderWindowTag = "form-provider-call-window-v1";
        field AttributionRule = "reported-total-minus-input-output-is-explicit-unattributed";
        // A second provider writes the same six quantities at its own typed
        // position, under its own names, and reports no total.
        field AssistantEnvelopeName = "assistant";
        field AssistantMessageName = "message";
        field AssistantUsageName = "usage";
        field AssistantCachedInputName = "cache_read_input_tokens";
        field AssistantCacheWriteName = "cache_creation_input_tokens";
        field AssistantOutputDetailsName = "output_tokens_details";
        field AssistantReasoningName = "thinking_tokens";
        field AssistantTotalRule = "sum-input-cache-write-cache-read-output-when-provider-reports-no-total";

        def frte-event-name() = EventName();
        def frte-alternate-event-name() = AlternateEventName();
        def frte-event-envelope-name() = EventEnvelopeName();
        def frte-terminal-event-name() = TerminalEventName();
        def frte-legacy-terminal-event-name() = LegacyTerminalEventName();
        def frte-last-usage-name() = LastUsageName();
        def frte-cumulative-usage-name() = CumulativeUsageName();
        def frte-quantity-rule() = QuantityRule();
        def frte-boundary-rule() = BoundaryRule();
        def frte-discovery-rule() = DiscoveryRule();
        def frte-active-rule() = ActiveRule();
        def frte-privacy-rule() = PrivacyRule();
        def frte-comparison-rule() = ComparisonRule();
        def frte-provider-source() = ProviderSource();
        def frte-local-direct-source() = LocalDirectSource();
        def frte-comparison-tag() = ComparisonTag();
        def frte-provider-window-tag() = ProviderWindowTag();
        def frte-attribution-rule() = AttributionRule();
        def frte-unattributed(input, output, total) = sub(total, add(input, output));
        def frte-separate-quantity-from-event?() = if str_eq(frte-boundary-rule(), "event-count-is-not-token-volume") then 1 else 0;
        def frte-last-not-cumulative?() = if str_eq(frte-last-usage-name(), "last_token_usage") then 1 else 0;
        def frte-last-usage-marker() = str_concat(byte_to_str(34), str_concat(frte-last-usage-name(), str_concat(byte_to_str(34), ":")));
        // A shaped usage object is evidence only inside the Codex event
        // envelope and one of its provider-usage payloads.  This keeps a
        // fully-shaped object nested in a tool result from becoming a remote
        // model call.  The alternate provider_usage label is explicit data,
        // rather than permission for any transport payload to self-identify.
        // Parse exactly one bounded JSONL row into typed Form cells.  The
        // collector owns the outer 2 MiB row/slice ceiling; this door also
        // requires the parser to consume the complete row.  Object access is
        // therefore independent of key order, nesting, and escaped strings.
        def frte-json-object?(node) = if nothing?(node) then 0 else if node_eq(node_category(node), JSON-OBJECT()) then 1 else 0;
        def frte-json-document(line) {
            let parsed = json-parse-value(line, 0, "form-cli-remote-token-evidence.jsonl");
            let root = json-pair-r(parsed);
            let end = json-skip-ws(line, json-pair-pos(parsed));
            if not(eq(end, str_len(line))) then list(0, root)
            else if not(eq(frte-json-object?(root), 1)) then list(0, root)
            else list(1, root);
        }
        def frte-json-document-valid?(document) = nth(document, 0);
        def frte-json-document-root(document) = nth(document, 1);
        def frte-json-string-field(object, key) = if not(eq(frte-json-object?(object), 1)) then "" else if not(json-object-has?(object, key)) then "" else json-string-value(json-object-get(object, key));
        def frte-json-object-field(object, key) = if not(eq(frte-json-object?(object), 1)) then nothing() else if not(json-object-has?(object, key)) then nothing() else if eq(frte-json-object?(json-object-get(object, key)), 1) then json-object-get(object, key) else nothing();
        // Direct JSON integers are type 1 on the current substrate; promoted
        // integer cells retain the historical type 6.  Strings and floats do
        // not enter token arithmetic through either door.
        def frte-json-int-node?(node) = if eq(node_type(node), 1) then 1 else if eq(node_type(node), 6) then 1 else 0;
        def frte-json-nonnegative-int-field?(object, key) = if not(eq(frte-json-object?(object), 1)) then 0 else if not(json-object-has?(object, key)) then 0 else if not(eq(frte-json-int-node?(json-object-get(object, key)), 1)) then 0 else if lt(json-int-value(json-object-get(object, key)), 0) then 0 else 1;
        def frte-envelope(line) {
            let document = frte-json-document(line);
            let root = frte-json-document-root(document);
            let payload = if eq(frte-json-document-valid?(document), 1) then frte-json-object-field(root, "payload") else nothing();
            if not(eq(frte-json-document-valid?(document), 1)) then list(0, root, payload)
            else if not(str_eq(frte-json-string-field(root, "type"), frte-event-envelope-name())) then list(0, root, payload)
            else if not(eq(frte-json-object?(payload), 1)) then list(0, root, payload)
            else list(1, root, payload);
        }
        def frte-envelope-valid?(envelope) = nth(envelope, 0);
        def frte-envelope-root(envelope) = nth(envelope, 1);
        def frte-envelope-payload(envelope) = nth(envelope, 2);
        def frte-top-type(line) {
            let document = frte-json-document(line);
            if eq(frte-json-document-valid?(document), 0) then "" else frte-json-string-field(frte-json-document-root(document), "type");
        }
        def frte-payload-type(line) {
            let envelope = frte-envelope(line);
            if eq(frte-envelope-valid?(envelope), 0) then "" else frte-json-string-field(frte-envelope-payload(envelope), "type");
        }
        def frte-event-envelope?(line) = frte-envelope-valid?(frte-envelope(line));
        def frte-provider-payload-object?(payload) {
            let kind = frte-json-string-field(payload, "type");
            if str_eq(kind, frte-event-name()) then 1 else if str_eq(kind, frte-alternate-event-name()) then 1 else 0;
        }
        def frte-provider-payload?(line) {
            let envelope = frte-envelope(line);
            if eq(frte-envelope-valid?(envelope), 0) then 0 else frte-provider-payload-object?(frte-envelope-payload(envelope));
        }
        // Current Codex rows carry usage below payload.info; the historical
        // provider envelope carried it directly.  Both are explicit typed
        // schema positions.  No recursive descendant search is permitted.
        def frte-provider-usage-object(payload) {
            let direct = frte-json-object-field(payload, frte-last-usage-name());
            let info = frte-json-object-field(payload, "info");
            if eq(frte-json-object?(direct), 1) then direct
            else if eq(frte-json-object?(info), 1) then frte-json-object-field(info, frte-last-usage-name())
            else nothing();
        }
        def frte-codex-usage-line?(line) {
            let envelope = frte-envelope(line);
            let payload = frte-envelope-payload(envelope);
            let usage = if eq(frte-envelope-valid?(envelope), 1) then frte-provider-usage-object(payload) else nothing();
            if eq(frte-envelope-valid?(envelope), 0) then 0 else if eq(frte-provider-payload-object?(payload), 0) then 0 else if not(eq(frte-json-object?(usage), 1)) then 0 else if eq(frte-json-nonnegative-int-field?(usage, "input_tokens"), 0) then 0 else if eq(frte-json-nonnegative-int-field?(usage, "output_tokens"), 0) then 0 else frte-json-nonnegative-int-field?(usage, "total_tokens");
        }
        def frte-codex-usage-object(line) {
            let envelope = frte-envelope(line);
            let payload = frte-envelope-payload(envelope);
            if eq(frte-envelope-valid?(envelope), 0) then nothing() else if eq(frte-provider-payload-object?(payload), 0) then nothing() else frte-provider-usage-object(payload);
        }

        // ── second typed schema position: an agent transcript's assistant row ──
        //
        // A Claude Code session writes JSONL whose assistant rows carry the
        // provider's own per-call usage at `message.usage`.  That is one
        // explicit typed position, exactly like `payload.info.last_token_usage`
        // above, and the same discipline holds: no recursive descendant search,
        // so a fully-shaped usage object nested in a tool result is content and
        // never a remote model call.  This provider names four of the six
        // counters differently and reports no total, so the total is computed
        // from the four input/output counters it does report.  Only the usage
        // object's integers are read; prompt, answer, reasoning and tool-output
        // text never cross this door.
        def frte-assistant-envelope-name() = AssistantEnvelopeName();
        def frte-assistant-message-name() = AssistantMessageName();
        def frte-assistant-usage-name() = AssistantUsageName();
        def frte-assistant-cached-input-name() = AssistantCachedInputName();
        def frte-assistant-cache-write-name() = AssistantCacheWriteName();
        def frte-assistant-output-details-name() = AssistantOutputDetailsName();
        def frte-assistant-reasoning-name() = AssistantReasoningName();
        def frte-assistant-total-rule() = AssistantTotalRule();
        def frte-assistant-type-marker() = str_concat(byte_to_str(34), str_concat("type", str_concat(byte_to_str(34), str_concat(":", str_concat(byte_to_str(34), str_concat(frte-assistant-envelope-name(), byte_to_str(34)))))));
        def frte-assistant-usage-marker() = str_concat(byte_to_str(34), str_concat(frte-assistant-usage-name(), str_concat(byte_to_str(34), ":")));
        // A byte prefilter, so one unrelated transcript row does not cost a
        // Form frame.  It decides whether the typed parse is worth running and
        // never admits a row on its own; the typed envelope stays the authority.
        def frte-assistant-shaped?(line) {
            let typeAt = str_find(line, frte-assistant-type-marker(), 0);
            let usageAt = str_find(line, frte-assistant-usage-marker(), 0);
            if lt(typeAt, 0) then 0 else if lt(usageAt, 0) then 0 else 1;
        }
        def frte-assistant-envelope(line) {
            let document = frte-json-document(line);
            let root = frte-json-document-root(document);
            let message = if eq(frte-json-document-valid?(document), 1) then frte-json-object-field(root, frte-assistant-message-name()) else nothing();
            if not(eq(frte-json-document-valid?(document), 1)) then list(0, root, message)
            else if not(str_eq(frte-json-string-field(root, "type"), frte-assistant-envelope-name())) then list(0, root, message)
            else if not(eq(frte-json-object?(message), 1)) then list(0, root, message)
            else list(1, root, message);
        }
        def frte-assistant-envelope-valid?(envelope) = nth(envelope, 0);
        def frte-assistant-envelope-message(envelope) = nth(envelope, 2);
        def frte-assistant-usage-object(line) {
            let envelope = if eq(frte-assistant-shaped?(line), 1) then frte-assistant-envelope(line) else list(0, nothing(), nothing());
            if eq(frte-assistant-envelope-valid?(envelope), 0) then nothing() else frte-json-object-field(frte-assistant-envelope-message(envelope), frte-assistant-usage-name());
        }
        def frte-assistant-usage-line?(line) {
            let usage = frte-assistant-usage-object(line);
            if not(eq(frte-json-object?(usage), 1)) then 0
            else if eq(frte-json-nonnegative-int-field?(usage, "input_tokens"), 0) then 0
            else frte-json-nonnegative-int-field?(usage, "output_tokens");
        }
        def frte-assistant-field-or(usage, key, fallback) = if eq(frte-json-nonnegative-int-field?(usage, key), 0) then fallback else json-int-value(json-object-get(usage, key));
        def frte-assistant-reasoning-or(usage, fallback) {
            let details = frte-json-object-field(usage, frte-assistant-output-details-name());
            if not(eq(frte-json-object?(details), 1)) then fallback else frte-assistant-field-or(details, frte-assistant-reasoning-name(), fallback);
        }
        // The two providers mean different things by `input_tokens`.  A Codex
        // rollout reports the whole input and names the cached part of it, so
        // uncached is a subtraction.  This provider reports the three parts
        // side by side — fresh input, tokens read from cache, tokens written to
        // cache — and never their sum.  The canonical counter is the whole
        // input, so it is composed here; reading the raw field as if it were
        // the whole would make uncached-input negative, which is how this seam
        // announced itself.
        def frte-assistant-total-input(usage) = add(add(frte-assistant-field-or(usage, "input_tokens", 0), frte-assistant-field-or(usage, frte-assistant-cache-write-name(), 0)), frte-assistant-field-or(usage, frte-assistant-cached-input-name(), 0));
        // A missing counter contributes nothing rather than refusing the row,
        // and the sum is the provider's own arithmetic made explicit, never an
        // estimate.
        def frte-assistant-computed-total(usage) = add(frte-assistant-total-input(usage), frte-assistant-field-or(usage, "output_tokens", 0));
        def frte-assistant-total-or(usage, fallback) = if eq(frte-json-nonnegative-int-field?(usage, "total_tokens"), 1) then json-int-value(json-object-get(usage, "total_tokens")) else if eq(frte-json-object?(usage), 1) then frte-assistant-computed-total(usage) else fallback;
        // The caller asks in the canonical six-counter vocabulary; this door
        // answers from the position and name this provider actually writes.
        def frte-assistant-usage-int-or(line, key, fallback) {
            let usage = frte-assistant-usage-object(line);
            if eq(frte-assistant-usage-line?(line), 0) then fallback
            else if str_eq(key, "input_tokens") then frte-assistant-total-input(usage)
            else if str_eq(key, "cached_input_tokens") then frte-assistant-field-or(usage, frte-assistant-cached-input-name(), fallback)
            else if str_eq(key, "cache_write_input_tokens") then frte-assistant-field-or(usage, frte-assistant-cache-write-name(), fallback)
            else if str_eq(key, "reasoning_output_tokens") then frte-assistant-reasoning-or(usage, fallback)
            else if str_eq(key, "total_tokens") then frte-assistant-total-or(usage, fallback)
            else frte-assistant-field-or(usage, key, fallback);
        }

        // Both schema positions are exact and independent.  A Codex rollout row
        // reads through the envelope grammar it always read through; an agent
        // transcript row reads through its own.  Neither shape can borrow the
        // other's admission.
        def frte-call-local-usage-line?(line) = if eq(frte-codex-usage-line?(line), 1) then 1 else frte-assistant-usage-line?(line);
        def frte-call-local-usage-object(line) = if eq(frte-codex-usage-line?(line), 1) then frte-codex-usage-object(line) else if eq(frte-assistant-usage-line?(line), 1) then frte-assistant-usage-object(line) else frte-codex-usage-object(line);
        // Extraction stays on the same typed object that admitted the row.
        // Optional provider counters use the caller's explicit fallback;
        // strings, floats, negatives, nested decoys, and same-named fields in
        // cumulative usage never enter arithmetic.
        def frte-call-local-usage-int-or(line, key, fallback) {
            let usage = frte-codex-usage-object(line);
            if eq(frte-codex-usage-line?(line), 0) then frte-assistant-usage-int-or(line, key, fallback)
            else if eq(frte-json-nonnegative-int-field?(usage, key), 0) then fallback
            else json-int-value(json-object-get(usage, key));
        }
        def frte-call-local-total(line) {
            frte-call-local-usage-int-or(line, "total_tokens", -1);
        }
        def frte-terminal-message-marker() = "\"last_agent_message\":";
        def frte-turn-id-marker() = "\"turn_id\":";
        // A completed turn must be the typed Codex terminal payload. Markers
        // nested in a tool result are content, not carrier boundaries.
        def frte-terminal-completion-line?(line) {
            let envelope = frte-envelope(line);
            let payload = frte-envelope-payload(envelope);
            let kind = frte-json-string-field(payload, "type");
            if eq(frte-envelope-valid?(envelope), 0) then 0 else if not(json-object-has?(payload, "turn_id")) then 0 else if str_eq(kind, frte-legacy-terminal-event-name()) then 1 else if and(str_eq(kind, frte-terminal-event-name()), json-object-has?(payload, "last_agent_message")) then 1 else 0;
        }

        // Provider usage is sparse in a rollout.  This grammar walks only
        // `last_token_usage` frames; it does not allocate one Form frame for
        // every unrelated JSONL line.  A scanned zero is a present value,
        // while unreadable or unselected evidence remains `nothing` outside
        // this reducer.
        def frte-window(calls, tokens) = list(frte-provider-window-tag(), calls, tokens);
        def frte-window?(value) = if nothing?(value) then 0 else if not(eq(len(value), 3)) then 0 else str_eq(nth(value, 0), frte-provider-window-tag());
        def frte-window-calls(value) = nth(value, 1);
        def frte-window-tokens(value) = nth(value, 2);
        def frte-window-add(value, tokens) = frte-window(add(frte-window-calls(value), 1), add(frte-window-tokens(value), tokens));
        def frte-window-field(name, value) = str_concat("\n", str_concat(name, str_concat("=", value)));
        // This frame holds only position and scalar provider evidence.  It is
        // an observation of one bounded window, never a claim that a whole
        // task has settled.
        def frte-window-frame(cursor, bytes, tally) = str_concat("provider-window=observed", str_concat(frte-window-field("cursor", int_to_str(cursor)), str_concat(frte-window-field("bytes", int_to_str(bytes)), str_concat(frte-window-field("provider-calls", int_to_str(frte-window-calls(tally))), str_concat(frte-window-field("remote-tokens", int_to_str(frte-window-tokens(tally))), "\n")))));
        def frte-digit?(cp) = if ge(cp, 48) then if le(cp, 57) then 1 else 0 else 0;
        def frte-number-end(text, at, end) = if ge(at, end) then at else if eq(frte-digit?(ord(char_at(text, at))), 1) then frte-number-end(text, add(at, 1), end) else at;
        def frte-int-in(text, mark, from, end) {
            let at = str_find(text, mark, from);
            let start = if lt(at, 0) then end else add(at, str_len(mark));
            let stop = frte-number-end(text, start, end);
            if or(lt(at, 0), ge(at, end)) then 0 else if eq(start, stop) then 0 else str_to_int(substring(text, start, stop));
        }
        def frte-line-end(text, from) {
            let at = str_find(text, "\n", from);
            if lt(at, 0) then str_len(text) else at;
        }
        // Walk back only inside one small provider event line.  Finding no LF
        // inside that cap refuses the marker rather than borrowing a provider
        // type from a preceding unrelated line.
        def frte-line-floor(at) = if lt(at, 4096) then 0 else sub(at, 4096);
        def frte-line-start(found, at) = list(found, at);
        def frte-line-start-found?(value) = nth(value, 0);
        def frte-line-start-at(value) = nth(value, 1);
        def frte-line-start-go(text, at, floor) = if le(at, floor) then if eq(floor, 0) then frte-line-start(1, 0) else frte-line-start(0, floor) else if eq(ord(char_at(text, sub(at, 1))), 10) then frte-line-start(1, at) else frte-line-start-go(text, sub(at, 1), floor);
        def frte-line-start-at-or-nothing(text, at) = frte-line-start-go(text, at, frte-line-floor(at));
        def frte-provider-usage-total(text, at, end) {
            let start = frte-line-start-at-or-nothing(text, at);
            let prefix = substring(text, frte-line-start-at(start), end);
            if eq(frte-line-start-found?(start), 0) then -1 else frte-call-local-total(prefix);
        }
        def frte-provider-usage-frame?(text, at, end) = if ge(frte-provider-usage-total(text, at, end), 0) then 1 else 0;
        def frte-window-scan(text, from, tally) {
            let at = str_find(text, str_concat(byte_to_str(34), str_concat(frte-last-usage-name(), byte_to_str(34))), from);
            let end = frte-line-end(text, if lt(at, 0) then from else at);
            let tokens = if lt(at, 0) then -1 else frte-provider-usage-total(text, at, end);
            if lt(at, 0) then tally else if lt(tokens, 0) then frte-window-scan(text, add(end, 1), tally) else frte-window-scan(text, add(end, 1), frte-window-add(tally, tokens));
        }
        def frte-provider-call-window(text) = frte-window-scan(text, 0, frte-window(0, 0));

        // receipt = tag task-node settled source provider-calls remote-tokens.
        // `nothing` is absence of a comparison side, never a zero-token row.
        def frte-receipt(taskNode, settled, source, providerCalls, remoteTokens) = list(frte-comparison-tag(), taskNode, settled, source, providerCalls, remoteTokens);
        def frte-receipt-task-node(receipt) = nth(receipt, 1);
        def frte-receipt-settled(receipt) = nth(receipt, 2);
        def frte-receipt-source(receipt) = nth(receipt, 3);
        def frte-receipt-provider-calls(receipt) = nth(receipt, 4);
        def frte-receipt-remote-tokens(receipt) = nth(receipt, 5);
        def frte-receipt?(receipt) = if nothing?(receipt) then 0 else if not(eq(len(receipt), 6)) then 0 else if not(str_eq(nth(receipt, 0), frte-comparison-tag())) then 0 else if not(eq(frte-receipt-settled(receipt), 1)) then 0 else if lt(frte-receipt-provider-calls(receipt), 0) then 0 else if lt(frte-receipt-remote-tokens(receipt), 0) then 0 else 1;
        def frte-provider-baseline?(receipt) = if eq(frte-receipt?(receipt), 0) then 0 else if not(str_eq(frte-receipt-source(receipt), frte-provider-source())) then 0 else if le(frte-receipt-provider-calls(receipt), 0) then 0 else if le(frte-receipt-remote-tokens(receipt), 0) then 0 else 1;
        def frte-local-direct?(receipt) = if eq(frte-receipt?(receipt), 0) then 0 else if not(str_eq(frte-receipt-source(receipt), frte-local-direct-source())) then 0 else if not(eq(frte-receipt-provider-calls(receipt), 0)) then 0 else if not(eq(frte-receipt-remote-tokens(receipt), 0)) then 0 else 1;
        def frte-same-task?(baseline, candidate) = if node_eq(frte-receipt-task-node(baseline), frte-receipt-task-node(candidate)) then 1 else 0;
        def frte-comparable?(baseline, candidate) = if eq(frte-provider-baseline?(baseline), 0) then 0 else if eq(frte-receipt?(candidate), 0) then 0 else frte-same-task?(baseline, candidate);
        // Basis points preserve the threshold's exact 10% = 1000 bps form.
        // Invalid or missing evidence remains nothing instead of being folded
        // into the valid numeric zero result.
        def frte-ratio-bps(baseline, candidate) = if eq(frte-comparable?(baseline, candidate), 0) then nothing() else floor(div(mul(frte-receipt-remote-tokens(candidate), 10000), frte-receipt-remote-tokens(baseline)));
        def frte-under-ten-percent?(baseline, candidate) {
            let ratio = frte-ratio-bps(baseline, candidate);
            if nothing?(ratio) then nothing() else if le(ratio, 1000) then 1 else 0;
        }
        def frte-local-direct-under-ten-percent?(baseline, localDirect) = if eq(frte-local-direct?(localDirect), 0) then nothing() else frte-under-ten-percent?(baseline, localDirect);
    }
    0;
}
