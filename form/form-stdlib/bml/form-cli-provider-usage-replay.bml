// Execute proposed notification sequences through the reader actually loaded.
// Proposals are data. A matched status proves that behavior for those events;
// it does not prove a contract violation or the surrounding prose.
// preludes: form-stdlib/bml/form-cli-provider-notification.bml form-stdlib/bml/form-agent-json-query.bml
section [form.bml] {
 class FormProviderUsageReplay {
  def fpur-max-events() = 64;
  def fpur-max-bytes() = 131072;
  def fpur-s(key,value) = json-node-pair(key,json-node-string(value));
  def fpur-n(key,value) = json-node-pair(key,json-node-int(value));
  def fpur-object(value) = (String) faj-type(value) == "object";
  def fpur-array(value) = (String) faj-type(value) == "array";
  def fpur-events-valid(events) = nil?(events) ? 1 : (fpur-object(head(events)) && fpur-events-valid(tail(events)));
  def fpur-invalid(reason) = json-node-object(list(fpur-s("schema","form-provider-usage-replay-v1"),fpur-s("status","proposal-invalid"),fpur-s("reason",reason),json-node-pair("claim_matches",json-node-null())));
  def fpur-request-reason(request) = !fpur-object(request) ? "request-needs-object" : ((String) fpn-str(request,"thread_id") == "") || ((String) fpn-str(request,"turn_id") == "") ? "selected-thread-and-turn-required" : !fpur-array(json-object-get(request,"events")) ? "events-array-required" : ((Comparable) len(json-array-elements(json-object-get(request,"events"))) == 0) || (len(json-array-elements(json-object-get(request,"events"))) > fpur-max-events()) ? "event-count-outside-bound" : !fpur-events-valid(json-array-elements(json-object-get(request,"events"))) ? "events-must-be-objects" : json-object-has?(request,"claimed_status") && ((String) fpn-str(request,"claimed_status") == "") ? "claimed-status-needs-nonempty-string" : "";
  // Each row retains its exact parsed event and before/after reader status.
  def fpur-walk(state,events,index,rows) = nil?(events) ? list(state,reverse(rows)) : {
   let next = fpn-event(state,head(events));
   let row = json-node-object(list(fpur-n("index",index),json-node-pair("event",head(events)),fpur-s("before_status",state[4]),fpur-s("after_status",next[4]),fpur-n("accepted_notifications",next[2])));
   fpur-walk(next,tail(events),index + 1,cons(row,rows));
  };
  def fpur-run(request) {
   let reason = fpur-request-reason(request);
   !((String) reason == "") ? fpur-invalid(reason) : str_len(json-emit(request)) > fpur-max-bytes() ? fpur-invalid("request-bytes-outside-bound") : {
    let events = json-array-elements(json-object-get(request,"events"));
    let result = fpur-walk(fpn-empty(fpn-str(request,"thread_id"),fpn-str(request,"turn_id")),events,0,list());
    let state = head(result); let claimed = json-object-has?(request,"claimed_status");
    json-node-object(list(fpur-s("schema","form-provider-usage-replay-v1"),fpur-s("status","replayed"),fpur-s("reader","linked-fpn-event"),fpur-n("event_count",len(events)),json-node-pair("claimed_status",claimed ? json-object-get(request,"claimed_status") : json-node-null()),json-node-pair("claim_matches",claimed ? json-node-int((String) fpn-str(request,"claimed_status") == state[4]) : json-node-null()),json-node-pair("steps",json-node-array(result[1])),json-node-pair("actual",fpn-report(state)),json-node-pair("defect_verified",json-node-null()),fpur-s("scope","Actual execution of these supplied events on the linked reader. A status match does not establish a normative defect, prose accuracy or complete review coverage.")));
   };
  }
  def fpur-read(bytes) = str_len(bytes) > fpur-max-bytes() ? fpur-invalid("request-bytes-outside-bound") : !jwa-valid(bytes) ? fpur-invalid("request-json-invalid") : fpur-run(parse-json("usage-replay",bytes));
  def fpur-findings(findings,index) = nil?(findings) ? list() : cons(json-node-object(list(fpur-n("finding",index),json-node-pair("replay",fpur-run(json-object-get(head(findings),"sequence"))))),fpur-findings(tail(findings),index + 1));
  def fpur-matched(rows) = nil?(rows) ? 1 : (((Comparable) fpn-num(frte-json-object-field(head(rows),"replay"),"claim_matches") == 1) && fpur-matched(tail(rows)));
  // Callback for fcac's existing read-only review and repair controller.
  // The caller composes any source or substantive report checks separately.
  def fpur-check-report(contract,subject) = fpur-check-text(subject[1]);
  def fpur-check-text(bytes) = (str_len(bytes) > fpur-max-bytes()) || (!jwa-valid(bytes)) ? list(0,"Review replay needs a complete bounded JSON report.") : {
   let report = parse-json("usage-review-report",bytes); let findings = json-object-get(report,"findings");
   !fpur-array(findings) ? list(0,"Report findings must be an array. Each finding supplies sequence={thread_id,turn_id,events,claimed_status}; events are complete notification objects. An empty findings array claims no findings and proves no review coverage.") : len(json-array-elements(findings)) > 16 ? list(0,"Report finding count exceeds the native replay bound.") : {
    let rows = fpur-findings(json-array-elements(findings),0);
    list(fpur-matched(rows),json-emit(json-node-object(list(fpur-s("schema","form-provider-review-replay-v1"),fpur-n("checked_sequences",len(rows)),json-node-pair("observations",json-node-array(rows)),fpur-s("scope","Sequence checks only. Revise any proposed sequence or claim that disagrees with actual execution; retain the original question, source and supplied contract. A matching claim does not establish that its explanation or defect interpretation is true.")))));
   };
  };
 }
 0;
}
