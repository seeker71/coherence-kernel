// Execute proposed notification sequences through the reader actually loaded.
// Proposals are data. A matched status proves that behavior for those events;
// it does not prove a contract violation or the surrounding prose.
// preludes: form-stdlib/bml/form-cli-provider-notification.bml form-stdlib/bml/form-agent-json-query.bml
section [form.bml] {
 class FormProviderUsageReplay {
  def fpur-max-events() = 64;
  def fpur-max-bytes() = 131072;
  def fpur-s(key,value) = json-node-pair(key,json-node-string(value));
  def fpur-n(key,value) = json-node-pair(key,json-node-int(value));
  def fpur-object(value) = str_eq(faj-type(value),"object");
  def fpur-array(value) = str_eq(faj-type(value),"array");
  def fpur-events-valid(events) = if nil?(events) then 1 else and(fpur-object(head(events)),fpur-events-valid(tail(events)));
  def fpur-invalid(reason) = json-node-object(list(fpur-s("schema","form-provider-usage-replay-v1"),fpur-s("status","proposal-invalid"),fpur-s("reason",reason),json-node-pair("claim_matches",json-node-null())));
  def fpur-request-reason(request) = if not(fpur-object(request)) then "request-needs-object" else if or(str_eq(fpn-str(request,"thread_id"),""),str_eq(fpn-str(request,"turn_id"),"")) then "selected-thread-and-turn-required" else if not(fpur-array(json-object-get(request,"events"))) then "events-array-required" else if or(eq(len(json-array-elements(json-object-get(request,"events"))),0),gt(len(json-array-elements(json-object-get(request,"events"))),fpur-max-events())) then "event-count-outside-bound" else if not(fpur-events-valid(json-array-elements(json-object-get(request,"events")))) then "events-must-be-objects" else if and(json-object-has?(request,"claimed_status"),str_eq(fpn-str(request,"claimed_status"),"")) then "claimed-status-needs-nonempty-string" else "";
  // Each row retains its exact parsed event and before/after reader status.
  def fpur-walk(state,events,index,rows) = if nil?(events) then list(state,reverse(rows)) else {
   let next = fpn-event(state,head(events));
   let row = json-node-object(list(fpur-n("index",index),json-node-pair("event",head(events)),fpur-s("before_status",nth(state,4)),fpur-s("after_status",nth(next,4)),fpur-n("accepted_notifications",nth(next,2))));
   fpur-walk(next,tail(events),add(index,1),cons(row,rows));
  };
  def fpur-run(request) {
   let reason = fpur-request-reason(request);
   if not(str_eq(reason,"")) then fpur-invalid(reason) else if gt(str_len(json-emit(request)),fpur-max-bytes()) then fpur-invalid("request-bytes-outside-bound") else {
    let events = json-array-elements(json-object-get(request,"events"));
    let result = fpur-walk(fpn-empty(fpn-str(request,"thread_id"),fpn-str(request,"turn_id")),events,0,list());
    let state = head(result); let claimed = json-object-has?(request,"claimed_status");
    json-node-object(list(fpur-s("schema","form-provider-usage-replay-v1"),fpur-s("status","replayed"),fpur-s("reader","linked-fpn-event"),fpur-n("event_count",len(events)),json-node-pair("claimed_status",if claimed then json-object-get(request,"claimed_status") else json-node-null()),json-node-pair("claim_matches",if claimed then json-node-int(str_eq(fpn-str(request,"claimed_status"),nth(state,4))) else json-node-null()),json-node-pair("steps",json-node-array(nth(result,1))),json-node-pair("actual",fpn-report(state)),json-node-pair("defect_verified",json-node-null()),fpur-s("scope","Actual execution of these supplied events on the linked reader. A status match does not establish a normative defect, prose accuracy or complete review coverage.")));
   };
  }
  def fpur-read(bytes) = if gt(str_len(bytes),fpur-max-bytes()) then fpur-invalid("request-bytes-outside-bound") else if not(jwa-valid(bytes)) then fpur-invalid("request-json-invalid") else fpur-run(parse-json("usage-replay",bytes));
  def fpur-findings(findings,index) = if nil?(findings) then list() else cons(json-node-object(list(fpur-n("finding",index),json-node-pair("replay",fpur-run(json-object-get(head(findings),"sequence"))))),fpur-findings(tail(findings),add(index,1)));
  def fpur-matched(rows) = if nil?(rows) then 1 else and(eq(fpn-num(frte-json-object-field(head(rows),"replay"),"claim_matches"),1),fpur-matched(tail(rows)));
  // Callback for fcac's existing read-only review and repair controller.
  // The caller composes any source or substantive report checks separately.
  def fpur-check-report(contract,subject) = fpur-check-text(nth(subject,1));
  def fpur-check-text(bytes) = if or(gt(str_len(bytes),fpur-max-bytes()),not(jwa-valid(bytes))) then list(0,"Review replay needs a complete bounded JSON report.") else {
   let report = parse-json("usage-review-report",bytes); let findings = json-object-get(report,"findings");
   if not(fpur-array(findings)) then list(0,"Report findings must be an array. Each finding supplies sequence={thread_id,turn_id,events,claimed_status}; events are complete notification objects. An empty findings array claims no findings and proves no review coverage.") else if gt(len(json-array-elements(findings)),16) then list(0,"Report finding count exceeds the native replay bound.") else {
    let rows = fpur-findings(json-array-elements(findings),0);
    list(fpur-matched(rows),json-emit(json-node-object(list(fpur-s("schema","form-provider-review-replay-v1"),fpur-n("checked_sequences",len(rows)),json-node-pair("observations",json-node-array(rows)),fpur-s("scope","Sequence checks only. Revise any proposed sequence or claim that disagrees with actual execution; retain the original question, source and supplied contract. A matching claim does not establish that its explanation or defect interpretation is true.")))));
   };
  };
 }
 0;
}
