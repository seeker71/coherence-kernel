// The oracle's control recipes choose an explicit native arithmetic owner.
// The independent scalar owners remain callable for parity observations.
// preludes: form/form-stdlib/bml/dsv4-oracle-native-matrices.bml form/form-stdlib/bml/dsv4-oracle-execution.bml
section [form.bml] {
 class Dsv4AcceleratedOracle {
  def dqa-prepare(path) {
   let r = dfo-open(path); dfo-admit-model(r); r;
  }
  def dqa-open(path) = dqa-admit(dqa-prepare(path));
  def dqa-open-at(path,pos) {
   let r = dqa-prepare(path); dfo-admit-position(r,pos); dqa-admit(r);
  }
  def dqa-admit(r) {
   record_set(r,"native-mx8",nfm-open()); record_set(r,"native-f16",dqr-open(1)); record_set(r,"native-mx4",dqr-open(40)); record_set(r,"native-iq2",dqr-open(16)); record_set(r,"iq-tables",dqr-iq-tables());
   record_set(r,"matrix-mx8",dqa-mx8); record_set(r,"matrix-f16",dqa-f16); record_set(r,"matrix-expert",dqa-expert); record_set(r,"matrix-out-a",dqa-out-a); r;
  }
  def dqa-workspace(owner,rows) = if (!(nfm-active(owner) && (dfo-positive(rows) && (rows <= 576460752303423487)))) then nothing() else if (record_has(owner,"workspace") && (!nothing?(npd-owned-span(record_get(owner,"memory"),record_get(owner,"workspace"),0,(rows * 8))))) then record_get(owner,"workspace") else dqa-grow(owner,rows);
  def dqa-shape(t,x,nd) = if (!(((Comparable) nd == 2) || ((Comparable) nd == 3))) then nothing() else if (!(fbc-list?(t) && ((Comparable) len(t) == 3))) then nothing() else if (!(fbc-list?(nth(t,1)) && (((Comparable) len(nth(t,1)) == nd) && dfo-positive-dims(nth(t,1))))) then nothing() else if (!(fbc-list?(x) && ((len(x) > 0) && (((Comparable) len(x) == head(nth(t,1))) && nfm-finite-list(x))))) then nothing() else dqa-shape-size(t,nd);
  def dqa-shape-size(t,nd) {
   let kind = head(t); let cols = head(nth(t,1)); let rows = nth(nth(t,1),1); let cells = dfo-product(cols,rows);
   let group = if ((Comparable) kind == 16) then 256 else if (((Comparable) kind == 40) || ((Comparable) kind == 41)) then 32 else if ((Comparable) kind == 1) then 1 else 0;
   if (((Comparable) group == 0) || ((rows > 576460752303423487) || ((cols > 576460752303423487) || ((!((Comparable) (cols % group) == 0)) || nothing?(cells))))) then nothing() else dqa-shape-bytes(t,nd,kind,cols,rows,cells);
  }
  def dqa-shape-bytes(t,nd,kind,cols,rows,cells) {
   let data = if ((Comparable) kind == 1) then dfo-product(cells,2) else if ((Comparable) kind == 40) then (cells / 2) else if ((Comparable) kind == 16) then dfo-product((cells / 256),66) else cells;
   let scales = if (((Comparable) kind == 40) || ((Comparable) kind == 41)) then (cells / 32) else 0; let stride = dfo-sum(data,scales); let total = dfo-product(stride,if ((Comparable) nd == 3) then nth(nth(t,1),2) else 1);
   if nothing?(total) then nothing() else record_new(0,"kind",kind,"cols",cols,"rows",rows,"cells",cells,"data",data,"scales",scales,"stride",stride,"total",total);
  }
  def dqa-layout(r,t,x,nd) {
   let shape = dqa-shape(t,x,nd); dfo-require((!nothing?(shape)),"matrix dimensions, vector, format or byte products");
   let at = dfo-abs(r,t); dfo-require(((at <= record_get(r,"extent")) && (record_get(shape,"total") <= (record_get(r,"extent") - at))),"complete matrix tensor exceeds source extent"); shape;
  }
  def dqa-output-layout(r,t,x,g) {
   dfo-require((fbc-list?(nth(t,1)) && (((Comparable) len(nth(t,1)) == 2) && dfo-positive-dims(nth(t,1)))),"grouped matrix dimensions");
   let groups = record_get(g,"ng"); let rank = record_get(g,"rank"); let cols = head(nth(t,1)); let width = dfo-product(groups,cols); let rows = dfo-product(groups,rank);
   dfo-require((dfo-positive(groups) && (dfo-positive(rank) && ((!nothing?(width)) && (!nothing?(rows))))),"grouped matrix products");
   dfo-require((fbc-list?(x) && (((Comparable) len(x) == width) && (nfm-finite-list(x) && (((Comparable) head(t) == 41) && ((Comparable) nth(nth(t,1),1) == rows))))),"grouped matrix input or format");
   let shape = dqa-shape-size(t,2); dfo-require((!nothing?(shape)),"grouped matrix byte products");
   let at = dfo-abs(r,t); dfo-require(((at <= record_get(r,"extent")) && (record_get(shape,"total") <= (record_get(r,"extent") - at))),"grouped matrix source extent"); shape;
  }
  def dqa-grow(owner,rows) {
   if record_has(owner,"workspace") then dfo-require(((Comparable) npd-region-close(record_get(owner,"workspace")) == 0),"native workspace resize release") else 1;
   let region = nfm-output(owner,rows); dfo-require((!nothing?(region)),"native workspace admission"); record_set(owner,"workspace",region); region;
  }
  def dqa-read(owner,data,scales,x,rows,kind) {
   let region = dqa-workspace(owner,rows); let vector = nfm-vector(x);
   let ran = if ((Comparable) kind == 41) then nfm-mx8-run(owner,data,scales,vector,rows,region) else if ((Comparable) kind == 1) then dqr-f16-run(owner,data,vector,rows,region) else if ((Comparable) kind == 40) then dqr-mx4-run(owner,data,scales,vector,rows,region) else if ((Comparable) kind == 16) then dqr-iq-run(owner,data,scales,vector,rows,region) else nothing();
   dfo-require(((Comparable) ran == rows),"native ordered matrix execution"); let out = nfm-read-output(region,0,rows,list()); dfo-require(dfo-finite-vector(out),"native matrix result must be finite"); out;
  }
  def dqa-mx8(r,key,x) {
   let t = dfo-tensor(r,key); let shape = dqa-layout(r,t,x,2); let rows = record_get(shape,"rows"); let at = dfo-abs(r,t); let cells = record_get(shape,"cells"); dfo-require(((Comparable) head(t) == 41),"native MXFP8 type");
   dqa-read(record_get(r,"native-mx8"),dfo-bytes(r,at,cells),dfo-bytes(r,(at + cells),(cells / 32)),x,rows,41);
  }
  def dqa-f16(r,key,x) {
   let t = dfo-tensor(r,key); let shape = dqa-layout(r,t,x,2); dfo-require(((Comparable) head(t) == 1),"native F16 type");
   dqa-read(record_get(r,"native-f16"),dfo-bytes(r,dfo-abs(r,t),record_get(shape,"data")),"",x,record_get(shape,"rows"),1);
  }
  def dqa-expert(r,key,expert,x) {
   let t = dfo-tensor(r,key); let shape = dqa-layout(r,t,x,3); let dims = nth(t,1); let cols = record_get(shape,"cols"); let rows = record_get(shape,"rows"); let kind = head(t); let cells = record_get(shape,"cells");
   dfo-require((dfo-natural(expert) && (expert < nth(dims,2))),"native expert index");
   if ((Comparable) kind == 40) then dqa-mx4(r,t,expert,x,cells,rows) else if ((Comparable) kind == 16) then dqa-iq(r,t,expert,x,cols,rows) else form_error("unsupported native expert format");
  }
  def dqa-mx4(r,t,expert,x,cells,rows) {
   let stride = ((cells / 2) + (cells / 32)); let at = (dfo-abs(r,t) + (expert * stride));
   dqa-read(record_get(r,"native-mx4"),dfo-bytes(r,at,(cells / 2)),dfo-bytes(r,(at + (cells / 2)),(cells / 32)),x,rows,40);
  }
  def dqa-iq(r,t,expert,x,cols,rows) {
   let stride = ((rows * (cols / 256)) * 66); let at = (dfo-abs(r,t) + (expert * stride));
   dqa-read(record_get(r,"native-iq2"),dfo-bytes(r,at,stride),record_get(r,"iq-tables"),x,rows,16);
  }
  def dqa-out-a(r,key,x,g) {
   let t = dfo-tensor(r,key); let shape = dqa-output-layout(r,t,x,g); let cols = record_get(shape,"cols"); let rows = record_get(shape,"rows"); let groups = record_get(g,"ng"); let rank = record_get(g,"rank"); let cells = record_get(shape,"cells"); let at = dfo-abs(r,t);
   let data = dfo-bytes(r,at,cells); let scales = dfo-bytes(r,(at + cells),(cells / 32));
   dqa-out-groups(record_get(r,"native-mx8"),data,scales,cols,rank,0,groups,x);
  }
  def dqa-out-groups(owner,data,scales,cols,rank,group,groups,x) = if ((Comparable) group == groups) then list() else dnr-cat(dqa-read(owner,substring(data,((group * rank) * cols),(((group + 1) * rank) * cols)),substring(scales,(((group * rank) * cols) / 32),((((group + 1) * rank) * cols) / 32)),dnr-take(x,cols),rank,41),dqa-out-groups(owner,data,scales,cols,rank,(group + 1),groups,dnr-drop(x,cols)));
  def dqa-close-owner(owner) {
   let mapClosed = if record_has(owner,"workspace") then npd-region-close(record_get(owner,"workspace")) else 0;
   let closed = if ((Comparable) record_get(owner,"active") == 0) then 1 else nfm-close(owner); if (((Comparable) mapClosed == 0) && ((Comparable) closed == 1)) then 1 else nothing();
  }
  def dqa-close(r) {
   let a = dqa-close-owner(record_get(r,"native-mx8")); let b = dqa-close-owner(record_get(r,"native-f16")); let c = dqa-close-owner(record_get(r,"native-mx4")); let d = dqa-close-owner(record_get(r,"native-iq2"));
   if (((Comparable) a == 1) && (((Comparable) b == 1) && (((Comparable) c == 1) && ((Comparable) d == 1)))) then 1 else nothing();
  }
  def dqa-one(path,token,pos,il,mode,out) {
   let r = dqa-open(path); let result = dfo-one-in(r,token,pos,il,mode,out); let closed = dqa-close(r);
   dfo-require((((Comparable) result == 1) && ((Comparable) closed == 1)),"native oracle completion"); 1;
  }
 }
 0;
}
