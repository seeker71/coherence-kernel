// A shared, current reading of Python detours and native places to continue.
// Source candidates are observations to follow, not claims of execution.
// preludes: gate/lens-text.bml form-stdlib/json.fk form-stdlib/form-fs.fk form-stdlib/hearth.bml form-stdlib/bml/native-source-inventory.bml
// native-guide: reference
// A Python word is read where it stands: a launch where it stands as a command,
// a name where it names the language, a copy where it lies inside a compiled image.
section [form.bml] {
 class NativeAuthoringGuide {
  def nrg-catalog() = list(
   list("jit", "form/form-stdlib/bml/native-jit-route.bml", "observe/native-jit-witness-run.fk", "Form owns JIT; read the current compiler route and execute its witnesses; see docs/native-jit-routing.md"),
   list("validate_fkwu_native_surface.py", "gate/native-surface.bml", "gate/drift-gates-run.bml", "native check"),
   list("sync_native_op_manifest.py", "gate/op-manifest.bml", "gate/drift-gates-run.bml", "native check"),
   list("validate_form_ontology.py", "gate/ontology.bml", "gate/drift-gates-run.bml", "native check"),
   list("validate_primitive_registry.py", "gate/primitive-registry.bml", "gate/drift-gates-run.bml", "native check"),
   list("verify_category_contract.py", "gate/category-contract.bml", "gate/drift-gates-run.bml", "native check"),
   list("gen_flt_ops_from_manifest.py", "observe/native-op-emitter-run.fk", "form/form-stdlib/tests/native-op-emitter-band.fk", "native writer and checked restoration"),
   list("fourth-arm-gap-analysis.py", "observe/fourth-arm-gap-analysis-run.fk", "form/form-stdlib/tests/fourth-arm-gap-analysis-band.fk", "native source vocabulary analysis for historical flatten surveys; not a band execution or repair proof"),
   list("fourth-arm survey","form/form-stdlib/bml/native-source-prepare.bml", "observe/native-source-prepare-run.fk", "native compiler owns dependency freshness; current source becomes disposable proof input; see docs/native-source-preparation.md"),
   list("maximum node depth", "form/form-stdlib/bml/formbin-depth.bml", "observe/formbin-depth-native-run.fk", "Form owns resumable artifact traversal and attention; Go FORMBIN2 carrier applies measured slice decisions; see docs/adaptive-artifact-depth.md"),
   list("formbin", "form/form-stdlib/bml/formbin-codec.bml", "gate/tests/kernel-conformance-band.fk", "native raw numeric codec, structural diff, source-lens IO and Go/Rust/TypeScript interoperability; see docs/native-form-artifacts.md"),
   list("mlx_lm", "observe/native-lora-train-run.fk", "form/form-stdlib/tests/native-lora-resume-band.fk", "full native Metal Llama LoRA training; prompt masks, all adapter projections, Adam continuation and atomic generations"),
   list("mlx_whisper", "observe/native-whisper-run.fk", "observe/native-whisper-homecoming-run.fk", "native Metal large-v3-turbo; shared safetensors, WAV resampling, timestamps, adaptive decoding and measured token flow; docs/native-whisper.md"),
   list("stt-oracle", "observe/stt-oracle-run.fk", "form/form-stdlib/tests/native-whisper-policy-band.fk", "native hearing, capture and handed WAV; the same model serves all recording windows"));
  def nrg-find(text, rows) = if nil?(rows) then list() else if (str_find(text, head(head(rows)), 0) >= 0) then head(rows) else nrg-find(text, tail(rows));
  def nrg-ext(path, ext) = ((String) fs-path-extension(path) == ext);
  def nrg-start(s, prefix) = lx-at?(s, 0, prefix);
  def nrg-has(s, part) = (str_find(s, part, 0) >= 0);
  def nrg-cat(parts) = if nil?(parts) then "" else str_concat(head(parts), nrg-cat(tail(parts)));
  def nrg-python-file(path) = (nrg-ext(path, ".py") || nrg-ext(path, ".pyw"));
  def nrg-input(path) = (nrg-has(path, "/fixtures/") || (nrg-has(path, "-fixtures/") || nrg-start(path, "form/form-samples/")));
  def nrg-history(path) = nrg-start(path, "receipts/");
  def nrg-scan-extension(path) = nrg-in(fs-path-extension(path), list("", ".fk", ".bml", ".sh", ".bash", ".zsh", ".ps1", ".cmd", ".bat", ".yml", ".yaml", ".toml", ".json", ".js", ".ts", ".go", ".rs", ".c", ".m", ".md"));
  def nrg-in(value, values) = if nil?(values) then 0 else if ((String) value == head(values)) then 1 else nrg-in(value, tail(values));
  def nrg-word-byte(b) = (((b >= 65) && (b <= 90)) || (((b >= 97) && (b <= 122)) || (((b >= 48) && (b <= 57)) || nrg-in(byte_to_str(b),list("_","-",".")))));
  def nrg-py-end(s, i) = if (i >= str_len(s)) then i else if (((str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57)) || (((Comparable) str_byte_at(s, i) == 46) && (((i + 1) < str_len(s)) && ((str_byte_at(s, (i + 1)) >= 48) && (str_byte_at(s, (i + 1)) <= 57))))) then nrg-py-end(s, (i + 1)) else i;
  def nrg-word-end(s, i) {
   let base = nrg-py-end(s, (i + 6));
   if lx-at?(s, base, ".exe") then (base + 4) else base;
  }
  def nrg-python-at(s, from) {
   let i = str_find(s, "python", from);
   let end = if (i < 0) then 0 else nrg-word-end(s, i);
   if (i < 0) then -1 else if ((((Comparable) i == 0) || (!nrg-word-byte(str_byte_at(s, (i - 1))))) && (((Comparable) end == str_len(s)) || nrg-in(byte_to_str(str_byte_at(s, end)), list(" ", "\t", "\n", "\r", "\"", "'", ";", ")", ",", "<", ">", "|", "&")))) then i else nrg-python-at(s, (i + 6));
  }
  // An MLX package directory inside a path names the package's files; an entry runs or imports it.
  def nrg-byte(s, i) = if ((i < 0) || (i >= str_len(s))) then -1 else str_byte_at(s, i);
  def nrg-mlx-word(s, word, from) {
   let i = str_find(s, word, from);
   let after = if (i < 0) then -1 else nrg-byte(s, (i + str_len(word)));
   if (i < 0) then 0 else if (((Comparable) after == 47) || ((Comparable) after == 92)) then nrg-mlx-word(s, word, (i + str_len(word))) else 1;
  }
  def nrg-mlx-entry(s) = ((nrg-mlx-word(s, "mlx_lm", 0) || nrg-mlx-word(s, "mlx_whisper", 0)) || (nrg-has(s, "import mlx") || nrg-has(s, "from mlx")));
  def nrg-environment(s) = ((nrg-has(s, "pip install") || nrg-has(s, "setup-python")) || nrg-has(s, "venv/bin/"));
  def nrg-token(s) = if (nrg-python-at(s, 0) >= 0) then "python-interpreter" else if nrg-mlx-entry(s) then "mlx-python-entry" else if nrg-has(s, "py -3") then "python-launcher" else if nrg-environment(s) then "python-environment" else "";
  // Where the word stands. A program source starts a process only by handing a
  // command to a door, so there the word is a launch when it stands as one: a
  // program path, an interpreter literal or a bare name with an argument literal
  // beside it, a line that carries a door, or a command position followed by a
  // command's shape. The language's own name, an identifier and prose are names.
  // Shell, config and extensionless files are command languages: every mention
  // outside a comment stays read as a launch.
  def nrg-program-source(path) = nrg-in(fs-path-extension(path), list(".fk", ".bml", ".c", ".m", ".go", ".rs", ".ts", ".js", ".json"));
  def nrg-doors() = list("host-exec", "host_exec", "host_spawn", "nsi-capture", "exec.Command", "Command::new", "spawn(", "execSync(", "execFile(", "system(", "popen(", "posix_spawn", "execv");
  def nrg-quote-byte(b) = (((Comparable) b == 34) || (((Comparable) b == 39) || ((Comparable) b == 96)));
  def nrg-space-byte(b) = (((Comparable) b == 32) || ((Comparable) b == 9));
  def nrg-opener-byte(b) = (nrg-quote-byte(b) || ((((Comparable) b == 124) || ((Comparable) b == 38)) || (((Comparable) b == 59) || (((Comparable) b == 40) || ((Comparable) b == 123)))));
  def nrg-closer-byte(b) = ((((Comparable) b == 60) || ((Comparable) b == 62)) || ((((Comparable) b == 124) || ((Comparable) b == 38)) || (((Comparable) b == 59) || ((Comparable) b == 41))));
  def nrg-back(s, j) = if (j < 0) then -1 else if nrg-space-byte(str_byte_at(s, j)) then nrg-back(s, (j - 1)) else j;
  def nrg-token-start(s, k) = if (k < 0) then 0 else if (nrg-space-byte(str_byte_at(s, k)) || nrg-opener-byte(str_byte_at(s, k))) then (k + 1) else nrg-token-start(s, (k - 1));
  def nrg-name-start(b) = (((Comparable) b == 95) || (((b >= 65) && (b <= 90)) || ((b >= 97) && (b <= 122))));
  def nrg-lead-word(t) = (nrg-in(t, list("env", "exec", "nohup", "sudo", "time", "command", "then", "do", "xargs", "nice")) || ((str_find(t, "=", 0) > 0) && nrg-name-start(nrg-byte(t, 0))));
  def nrg-command-before(s, i) {
   let j = nrg-back(s, (i - 1));
   if (j < 0) then 1 else if nrg-opener-byte(str_byte_at(s, j)) then 1 else if ((Comparable) j == (i - 1)) then 0 else nrg-lead-before(s, nrg-token-start(s, j), j);
  }
  def nrg-lead-before(s, k, j) = if nrg-lead-word(substring(s, k, (j + 1))) then nrg-command-before(s, k) else 0;
  def nrg-skip(s, k) = if (k >= str_len(s)) then k else if nrg-space-byte(str_byte_at(s, k)) then nrg-skip(s, (k + 1)) else k;
  def nrg-token-end(s, k) = if (k >= str_len(s)) then k else if (nrg-space-byte(str_byte_at(s, k)) || nrg-quote-byte(str_byte_at(s, k))) then k else nrg-token-end(s, (k + 1));
  def nrg-arg-token(s, k) = (nrg-in(substring(s, k, (k + 1)), list("-", "%", "$", "/", "~", ".", "<", ">", "|", "&", "{")) || (nrg-has(substring(s, k, nrg-token-end(s, k)), "/") || nrg-has(substring(s, k, nrg-token-end(s, k)), ".py")));
  def nrg-command-after(s, e) {
   let b = nrg-byte(s, e);
   let k = nrg-skip(s, e);
   if (b < 0) then 1 else if (nrg-quote-byte(b) || nrg-closer-byte(b)) then 1 else if (!nrg-space-byte(b)) then 0 else if (k >= str_len(s)) then 1 else if nrg-quote-byte(str_byte_at(s, k)) then 1 else nrg-arg-token(s, k);
  }
  def nrg-skip-list(s, k) = if (k >= str_len(s)) then k else if (nrg-space-byte(str_byte_at(s, k)) || ((Comparable) str_byte_at(s, k) == 44)) then nrg-skip-list(s, (k + 1)) else k;
  def nrg-arg-literal(s, k) {
   let at = nrg-skip-list(s, k);
   if ((at + 1) >= str_len(s)) then 0 else if (!nrg-quote-byte(str_byte_at(s, at))) then 0 else (((Comparable) str_byte_at(s, (at + 1)) == 32) || ((Comparable) str_byte_at(s, (at + 1)) == 45));
  }
  def nrg-exact-literal(s, i, e) = (nrg-quote-byte(nrg-byte(s, (i - 1))) && ((Comparable) nrg-byte(s, e) == nrg-byte(s, (i - 1))));
  def nrg-path-before(s, i) = (((Comparable) nrg-byte(s, (i - 1)) == 47) || ((Comparable) nrg-byte(s, (i - 1)) == 92));
  def nrg-launch-at(s, i) {
   let e = nrg-word-end(s, i);
   if nrg-path-before(s, i) then 1 else if nrg-exact-literal(s, i, e) then (((e - i) > 6) || nrg-arg-literal(s, (e + 1))) else (nrg-command-before(s, i) && nrg-command-after(s, e));
  }
  def nrg-python-launch(s, from) {
   let i = nrg-python-at(s, from);
   if (i < 0) then 0 else if nrg-launch-at(s, i) then 1 else nrg-python-launch(s, (i + 6));
  }
  // A door counts where it stands in code; a door named inside a string is prose.
  def nrg-quotes(s, i, k, n) = if (k >= i) then n else if (((Comparable) str_byte_at(s, k) == 34) && (!((Comparable) nrg-byte(s, (k - 1)) == 92))) then nrg-quotes(s, i, (k + 1), (n + 1)) else nrg-quotes(s, i, (k + 1), n);
  def nrg-in-code(s, i) = ((Comparable) (nrg-quotes(s, i, 0, 0) % 2) == 0);
  def nrg-door-at(s, door, from) {
   let i = str_find(s, door, from);
   if (i < 0) then 0 else if nrg-in-code(s, i) then 1 else nrg-door-at(s, door, (i + 1));
  }
  def nrg-door-line(s, doors) = if nil?(doors) then 0 else if nrg-door-at(s, head(doors), 0) then 1 else nrg-door-line(s, tail(doors));
  def nrg-launch-line(path, s) = if (!nrg-program-source(path)) then 1 else if nrg-door-line(s, nrg-doors()) then 1 else if (nrg-mlx-entry(s) || (nrg-has(s, "py -3") || nrg-environment(s))) then 1 else nrg-python-launch(s, 0);
  // A file that declares `native-guide: reference` in its head carries the guide's
  // own tokens and specimens: its lines are readings, unless one hands the word to a
  // door. A file holding a NUL byte is a compiled image; its text copies sources this
  // reading meets at their own paths.
  def nrg-head(text) = substring(text, 0, if (str_len(text) > 2048) then 2048 else str_len(text));
  def nrg-declared(text) = (nrg-has(nrg-head(text), "; native-guide: reference") || nrg-has(nrg-head(text), "// native-guide: reference"));
  def nrg-mode(text) = if (str_find(text, byte_to_str(0), 0) >= 0) then "compiled-artifact" else if nrg-declared(text) then "guide-reference" else "";
  def nrg-declared-kind(trimmed) = if nrg-door-line(trimmed, nrg-doors()) then "execution-candidate" else "guide-reference";
  def nrg-kind(path, mode, trimmed) = if ((String) mode == "compiled-artifact") then mode else if ((String) mode == "guide-reference") then nrg-declared-kind(trimmed) else if nrg-ext(path, ".md") then "guidance-reference" else if nrg-start(trimmed, "#!") then "execution-candidate" else if nrg-comment(trimmed) then "comment-reference" else if nrg-launch-line(path, trimmed) then "execution-candidate" else "name-reference";
  def nrg-comment(s) = (nrg-start(s, ";") || (nrg-start(s, "#") || (nrg-start(s, "//") || nrg-start(s, "*"))));
  def nrg-row(path, line, kind, token, reference) = list(path, line, kind, token, reference);
  def nrg-lines(path, mode, lines, number, found) {
   if nil?(lines) then reverse(found) else nrg-line(path, mode, head(lines), tail(lines), number, found);
  }
  def nrg-line(path, mode, line, rest, number, found) {
   let trimmed = lx-strip(line);
   let token = nrg-token(trimmed);
   if ((String) token == "") then nrg-lines(path, mode, rest, (number + 1), found) else nrg-lines(path, mode, rest, (number + 1), cons(nrg-row(path, number, nrg-kind(path, mode, trimmed), token, nrg-find(line, nrg-catalog())), found));
  }
  def nrg-source(path, text) = if nrg-python-file(path) then list(nrg-row(path, 1, if nrg-input(path) then "foreign-grammar-input" else "python-implementation", "python-source", nrg-find(path, nrg-catalog()))) else if (nrg-history(path) || (!nrg-scan-extension(path))) then list() else nrg-lines(path, nrg-mode(text), lx-lines(text), 1, list());
  def nrg-scan(paths, rows, unread) {
   if nil?(paths) then list(reverse(rows), reverse(unread)) else nrg-file(head(paths), tail(paths), rows, unread);
  }
  def nrg-file(path, rest, rows, unread) {
   if ((String) path == "") then nrg-scan(rest, rows, unread) else if (file_size(path) < 0) then nrg-scan(rest, rows, cons(path, unread)) else if (nrg-history(path) || (!(nrg-python-file(path) || nrg-scan-extension(path)))) then nrg-scan(rest, rows, unread) else nrg-read(path, rest, rows, unread, read_file(path));
  }
  def nrg-read(path, rest, rows, unread, source) = if (!nsi-exact(path,source)) then nrg-scan(rest, rows, cons(path, unread)) else nrg-scan(rest, append(reverse(nrg-source(path, source)), rows), unread);
  def nrg-s(key, value) = json-node-pair(key, json-node-string(value));
  def nrg-n(key, value) = json-node-pair(key, json-node-int(value));
  def nrg-strings(rows) = if nil?(rows) then list() else cons(json-node-string(head(rows)), nrg-strings(tail(rows)));
  def nrg-reference(row) = if nil?(row) then json-node-object(list(nrg-s("state", "native-search-owed"), nrg-s("next", "Search local Form cells, RAG, git history and receipts; build and observe an equivalent native path, update callers, then retire the Python implementation."))) else json-node-object(list(nrg-s("source", nth(row, 1)), nrg-s("witness", nth(row, 2)), nrg-s("scope", nth(row, 3)), nrg-s("state", if ((file_size(nth(row, 1)) >= 0) && (file_size(nth(row, 2)) >= 0)) then "reference-present;re-witness-before-replacement" else "reference-needs-recovery")));
  def nrg-json-row(row) = json-node-object(list(nrg-s("path", head(row)), nrg-n("line", nth(row, 1)), nrg-s("kind", nth(row, 2)), nrg-s("signal", nth(row, 3)), json-node-pair("native", nrg-reference(nth(row, 4)))));
  def nrg-json-rows(rows) = if nil?(rows) then list() else cons(nrg-json-row(head(rows)), nrg-json-rows(tail(rows)));
  def nrg-command(command) = json-emit(json-node-object(list(nrg-s("kind", "native-command-guidance"), nrg-s("signal", if ((String) nrg-token(command) == "") then "no-python-token-observed;not-an-execution-proof" else nrg-token(command)), json-node-pair("native", nrg-reference(nrg-find(command, nrg-catalog()))), nrg-s("next", "Use and witness the native reference when it fits; otherwise carry the native implementation attempt. This reading executes no proposed command."))));
  def nrg-count(rows, kind) = if nil?(rows) then 0 else ((if ((String) nth(head(rows), 2) == kind) then 1 else 0) + nrg-count(tail(rows), kind));
  def nrg-action(row) = (((String) nth(row, 2) == "python-implementation") || ((String) nth(row, 2) == "execution-candidate"));
  def nrg-next(rows, room) = if (nil?(rows) || (room <= 0)) then "" else if (!nrg-action(head(rows))) then nrg-next(tail(rows), room) else str_concat(head(head(rows)), str_concat(":", str_concat(int_to_str(nth(head(rows), 1)), str_concat(" -> ", str_concat(if nil?(nth(head(rows), 4)) then "native search and observed replacement" else nth(nth(head(rows), 4), 1), str_concat("\n", nrg-next(tail(rows), (room - 1))))))));
  def nrg-run() {
   nrg-observe(nsi-text(nsi-git()));
  }
  def nrg-publish(path,text) {
   let temporary = str_concat(path,str_concat(".native-",str_concat(int_to_str(host_pid()),str_concat("-",int_to_str(host_monotonic_ms())))));
   let written = write_file(temporary,text);
   if (!((Comparable) written == str_len(text))) then nrg-publish-refused(temporary) else nrg-publish-checked(path,temporary,text,read_file(temporary));
  }
  def nrg-publish-checked(path,temporary,text,readback) = if (!(nsi-exact(temporary,readback) && ((String) text == readback))) then nrg-publish-refused(temporary) else nrg-publish-moved(path,temporary,fs_rename(temporary,path));
  def nrg-publish-moved(path,temporary,status) = if ((Comparable) status == 0) then path else nrg-publish-refused(temporary);
  def nrg-publish-refused(temporary) {
   let removed = fs_remove(temporary);
   form_error("native authoring guide report publication incomplete");
  }
  def nrg-observe(inventory) {
   let started = host_monotonic_ms();
   let reading = nrg-scan(split-on(inventory, byte_to_str(0)), list(), list());
   let rows = head(reading);
   let unread = nth(reading, 1);
   let headAt = nsi-text(nsi-require(nsi-capture(list("git", "rev-parse", "HEAD"))));
   let made = fs_mkdir(HearthDir());
   let report = json-node-object(list(nrg-s("version", "native-authoring-guide-v2"), nrg-n("observed_unix_ms", now_unix_ms()), nrg-n("elapsed_ms", (host_monotonic_ms() - started)), nrg-s("head", if nothing?(headAt) then "unread" else lx-strip(headAt)), nrg-s("scope", "git tracked and unignored working files; static source candidates, not a process trace; ignored scratch and dynamic commands need the same authoring practice"), nrg-s("responsibility", "shared: the acting agent carries the next native attempt"), nrg-n("python_implementations", nrg-count(rows, "python-implementation")), nrg-n("execution_candidates", nrg-count(rows, "execution-candidate")), nrg-n("foreign_grammar_inputs", nrg-count(rows, "foreign-grammar-input")), nrg-n("name_references", nrg-count(rows, "name-reference")), nrg-n("compiled_artifacts", nrg-count(rows, "compiled-artifact")), json-node-pair("unread_paths", json-node-array(nrg-strings(unread))), json-node-pair("observations", json-node-array(nrg-json-rows(rows)))));
   let retained = nrg-publish(hearth-native-authoring-guide(),str_concat(json-emit(report), "\n"));
   nrg-cat(list("native authoring guide: Python implementations=", int_to_str(nrg-count(rows, "python-implementation")), " execution candidates=", int_to_str(nrg-count(rows, "execution-candidate")), " grammar inputs=", int_to_str(nrg-count(rows, "foreign-grammar-input")), " name references=", int_to_str(nrg-count(rows, "name-reference")), " compiled artifacts=", int_to_str(nrg-count(rows, "compiled-artifact")), " unread=", int_to_str(len(unread)), "\nreading=", retained, "\nNext native work, carried by us:\n", nrg-next(rows, 8)));
  }
 }
 0;
}
