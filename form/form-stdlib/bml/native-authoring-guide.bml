// A shared, current reading of Python detours and native places to continue.
// Source candidates are observations to follow, not claims of execution.
// preludes: gate/lens-text.bml form-stdlib/json.fk form-stdlib/form-fs.fk form-stdlib/hearth.bml form-stdlib/bml/native-source-inventory.bml
// native-guide: reference
// A Python word is read where it stands: a launch where it stands as a command,
// a name where it names the language, a copy where it lies inside a compiled image.
section [form.bml] {
 class NativeAuthoringGuide {
  def nrg-catalog() = list(
   list("jit", "form/form-stdlib/bml/native-jit-route.bml", "observe/native-jit-witness-run.fk", "Form owns JIT; read the current compiler route and execute its witnesses; see docs/native-jit-routing.md"),
   list("validate_fkwu_native_surface.py", "gate/native-surface.bml", "gate/drift-gates-run.bml", "native check"),
   list("sync_native_op_manifest.py", "gate/op-manifest.bml", "gate/drift-gates-run.bml", "native check"),
   list("validate_form_ontology.py", "gate/ontology.bml", "gate/drift-gates-run.bml", "native check"),
   list("validate_primitive_registry.py", "gate/primitive-registry.bml", "gate/drift-gates-run.bml", "native check"),
   list("verify_category_contract.py", "gate/category-contract.bml", "gate/drift-gates-run.bml", "native check"),
   list("gen_flt_ops_from_manifest.py", "observe/native-op-emitter-run.fk", "form/form-stdlib/tests/native-op-emitter-band.fk", "native writer and checked restoration"),
   list("fourth-arm-gap-analysis.py", "observe/fourth-arm-gap-analysis-run.fk", "form/form-stdlib/tests/fourth-arm-gap-analysis-band.fk", "native source vocabulary analysis for historical flatten surveys; not a band execution or repair proof"),
   list("fourth-arm survey","form/form-stdlib/bml/native-source-prepare.bml", "observe/native-source-prepare-run.fk", "native compiler owns dependency freshness; current source becomes disposable proof input; see docs/native-source-preparation.md"),
   list("maximum node depth", "form/form-stdlib/bml/formbin-depth.bml", "observe/formbin-depth-native-run.fk", "Form owns resumable artifact traversal and attention; Go FORMBIN2 carrier applies measured slice decisions; see docs/adaptive-artifact-depth.md"),
   list("formbin", "form/form-stdlib/bml/formbin-codec.bml", "gate/tests/kernel-conformance-band.fk", "native raw numeric codec, structural diff, source-lens IO and Go/Rust/TypeScript interoperability; see docs/native-form-artifacts.md"),
   list("mlx_lm", "observe/native-lora-train-run.fk", "form/form-stdlib/tests/native-lora-resume-band.fk", "full native Metal Llama LoRA training; prompt masks, all adapter projections, Adam continuation and atomic generations"),
   list("mlx_whisper", "observe/native-whisper-run.fk", "observe/native-whisper-homecoming-run.fk", "native Metal large-v3-turbo; shared safetensors, WAV resampling, timestamps, adaptive decoding and measured token flow; docs/native-whisper.md"),
   list("stt-oracle", "observe/stt-oracle-run.fk", "form/form-stdlib/tests/native-whisper-policy-band.fk", "native hearing, capture and handed WAV; the same model serves all recording windows"));
  def nrg-find(text, rows) = nil?(rows) ? list() : str_find(text, head(head(rows)), 0) >= 0 ? head(rows) : nrg-find(text, tail(rows));
  def nrg-ext(path, ext) = (String) fs-path-extension(path) == ext;
  def nrg-start(s, prefix) = lx-at?(s, 0, prefix);
  def nrg-has(s, part) = str_find(s, part, 0) >= 0;
  def nrg-cat(parts) = nil?(parts) ? "" : head(parts) ++ nrg-cat(tail(parts));
  def nrg-python-file(path) = nrg-ext(path, ".py") || nrg-ext(path, ".pyw");
  def nrg-input(path) = nrg-has(path, "/fixtures/") || (nrg-has(path, "-fixtures/") || nrg-start(path, "form/form-samples/"));
  def nrg-history(path) = nrg-start(path, "receipts/");
  def nrg-scan-extension(path) = nrg-in(fs-path-extension(path), list("", ".fk", ".bml", ".sh", ".bash", ".zsh", ".ps1", ".cmd", ".bat", ".yml", ".yaml", ".toml", ".json", ".js", ".ts", ".go", ".rs", ".c", ".m", ".md"));
  def nrg-in(value, values) = nil?(values) ? 0 : (String) value == head(values) ? 1 : nrg-in(value, tail(values));
  def nrg-word-byte(b) = ((b >= 65) && (b <= 90)) || (((b >= 97) && (b <= 122)) || (((b >= 48) && (b <= 57)) || nrg-in(byte_to_str(b),list("_","-","."))));
  def nrg-py-end(s, i) = i >= str_len(s) ? i : ((str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57)) || (((Comparable) str_byte_at(s, i) == 46) && (((i + 1) < str_len(s)) && ((str_byte_at(s, i + 1) >= 48) && (str_byte_at(s, i + 1) <= 57)))) ? nrg-py-end(s, i + 1) : i;
  def nrg-word-end(s, i) {
   let base = nrg-py-end(s, i + 6);
   lx-at?(s, base, ".exe") ? (base + 4) : base;
  }
  def nrg-python-at(s, from) {
   let i = str_find(s, "python", from);
   let end = i < 0 ? 0 : nrg-word-end(s, i);
   i < 0 ? -1 : (((Comparable) i == 0) || (!nrg-word-byte(str_byte_at(s, i - 1)))) && (((Comparable) end == str_len(s)) || nrg-in(byte_to_str(str_byte_at(s, end)), list(" ", "\t", "\n", "\r", "\"", "'", ";", ")", ",", "<", ">", "|", "&"))) ? i : nrg-python-at(s, i + 6);
  }
  // An MLX package directory inside a path names the package's files; an entry runs or imports it.
  def nrg-byte(s, i) = (i < 0) || (i >= str_len(s)) ? -1 : str_byte_at(s, i);
  def nrg-mlx-word(s, word, from) {
   let i = str_find(s, word, from);
   let after = i < 0 ? -1 : nrg-byte(s, i + str_len(word));
   i < 0 ? 0 : ((Comparable) after == 47) || ((Comparable) after == 92) ? nrg-mlx-word(s, word, i + str_len(word)) : 1;
  }
  def nrg-mlx-entry(s) = (nrg-mlx-word(s, "mlx_lm", 0) || nrg-mlx-word(s, "mlx_whisper", 0)) || (nrg-has(s, "import mlx") || nrg-has(s, "from mlx"));
  def nrg-environment(s) = (nrg-has(s, "pip install") || nrg-has(s, "setup-python")) || nrg-has(s, "venv/bin/");
  def nrg-token(s) = nrg-python-at(s, 0) >= 0 ? "python-interpreter" : nrg-mlx-entry(s) ? "mlx-python-entry" : nrg-has(s, "py -3") ? "python-launcher" : nrg-environment(s) ? "python-environment" : "";
  // Where the word stands. A program source starts a process only by handing a
  // command to a door, so there the word is a launch when it stands as one: a
  // program path, an interpreter literal or a bare name with an argument literal
  // beside it, a line that carries a door, or a command position followed by a
  // command's shape. The language's own name, an identifier and prose are names.
  // Shell, config and extensionless files are command languages: every mention
  // outside a comment stays read as a launch.
  def nrg-program-source(path) = nrg-in(fs-path-extension(path), list(".fk", ".bml", ".c", ".m", ".go", ".rs", ".ts", ".js", ".json"));
  def nrg-doors() = list("host-exec", "host_exec", "host_spawn", "nsi-capture", "exec.Command", "Command::new", "spawn(", "execSync(", "execFile(", "system(", "popen(", "posix_spawn", "execv");
  def nrg-quote-byte(b) = ((Comparable) b == 34) || (((Comparable) b == 39) || ((Comparable) b == 96));
  def nrg-space-byte(b) = ((Comparable) b == 32) || ((Comparable) b == 9);
  def nrg-opener-byte(b) = nrg-quote-byte(b) || ((((Comparable) b == 124) || ((Comparable) b == 38)) || (((Comparable) b == 59) || (((Comparable) b == 40) || ((Comparable) b == 123))));
  def nrg-closer-byte(b) = (((Comparable) b == 60) || ((Comparable) b == 62)) || ((((Comparable) b == 124) || ((Comparable) b == 38)) || (((Comparable) b == 59) || ((Comparable) b == 41)));
  def nrg-back(s, j) = j < 0 ? -1 : nrg-space-byte(str_byte_at(s, j)) ? nrg-back(s, j - 1) : j;
  def nrg-token-start(s, k) = k < 0 ? 0 : nrg-space-byte(str_byte_at(s, k)) || nrg-opener-byte(str_byte_at(s, k)) ? (k + 1) : nrg-token-start(s, k - 1);
  def nrg-name-start(b) = ((Comparable) b == 95) || (((b >= 65) && (b <= 90)) || ((b >= 97) && (b <= 122)));
  def nrg-lead-word(t) = nrg-in(t, list("env", "exec", "nohup", "sudo", "time", "command", "then", "do", "xargs", "nice")) || ((str_find(t, "=", 0) > 0) && nrg-name-start(nrg-byte(t, 0)));
  def nrg-command-before(s, i) {
   let j = nrg-back(s, i - 1);
   j < 0 ? 1 : nrg-opener-byte(str_byte_at(s, j)) ? 1 : (Comparable) j == (i - 1) ? 0 : nrg-lead-before(s, nrg-token-start(s, j), j);
  }
  def nrg-lead-before(s, k, j) = nrg-lead-word(substring(s, k, j + 1)) ? nrg-command-before(s, k) : 0;
  def nrg-skip(s, k) = k >= str_len(s) ? k : nrg-space-byte(str_byte_at(s, k)) ? nrg-skip(s, k + 1) : k;
  def nrg-token-end(s, k) = k >= str_len(s) ? k : nrg-space-byte(str_byte_at(s, k)) || nrg-quote-byte(str_byte_at(s, k)) ? k : nrg-token-end(s, k + 1);
  def nrg-arg-token(s, k) = nrg-in(substring(s, k, k + 1), list("-", "%", "$", "/", "~", ".", "<", ">", "|", "&", "{")) || (nrg-has(substring(s, k, nrg-token-end(s, k)), "/") || nrg-has(substring(s, k, nrg-token-end(s, k)), ".py"));
  def nrg-command-after(s, e) {
   let b = nrg-byte(s, e);
   let k = nrg-skip(s, e);
   b < 0 ? 1 : nrg-quote-byte(b) || nrg-closer-byte(b) ? 1 : !nrg-space-byte(b) ? 0 : k >= str_len(s) ? 1 : nrg-quote-byte(str_byte_at(s, k)) ? 1 : nrg-arg-token(s, k);
  }
  def nrg-skip-list(s, k) = k >= str_len(s) ? k : nrg-space-byte(str_byte_at(s, k)) || ((Comparable) str_byte_at(s, k) == 44) ? nrg-skip-list(s, k + 1) : k;
  def nrg-arg-literal(s, k) {
   let at = nrg-skip-list(s, k);
   (at + 1) >= str_len(s) ? 0 : !nrg-quote-byte(str_byte_at(s, at)) ? 0 : (((Comparable) str_byte_at(s, at + 1) == 32) || ((Comparable) str_byte_at(s, at + 1) == 45));
  }
  def nrg-exact-literal(s, i, e) = nrg-quote-byte(nrg-byte(s, i - 1)) && ((Comparable) nrg-byte(s, e) == nrg-byte(s, i - 1));
  def nrg-path-before(s, i) = ((Comparable) nrg-byte(s, i - 1) == 47) || ((Comparable) nrg-byte(s, i - 1) == 92);
  def nrg-launch-at(s, i) {
   let e = nrg-word-end(s, i);
   nrg-path-before(s, i) ? 1 : nrg-exact-literal(s, i, e) ? (((e - i) > 6) || nrg-arg-literal(s, e + 1)) : (nrg-command-before(s, i) && nrg-command-after(s, e));
  }
  def nrg-python-launch(s, from) {
   let i = nrg-python-at(s, from);
   i < 0 ? 0 : nrg-launch-at(s, i) ? 1 : nrg-python-launch(s, i + 6);
  }
  // A door counts where it stands in code; a door named inside a string is prose.
  def nrg-quotes(s, i, k, n) = k >= i ? n : ((Comparable) str_byte_at(s, k) == 34) && (!((Comparable) nrg-byte(s, k - 1) == 92)) ? nrg-quotes(s, i, k + 1, n + 1) : nrg-quotes(s, i, k + 1, n);
  def nrg-in-code(s, i) = (Comparable) (nrg-quotes(s, i, 0, 0) % 2) == 0;
  def nrg-door-at(s, door, from) {
   let i = str_find(s, door, from);
   i < 0 ? 0 : nrg-in-code(s, i) ? 1 : nrg-door-at(s, door, i + 1);
  }
  def nrg-door-line(s, doors) = nil?(doors) ? 0 : nrg-door-at(s, head(doors), 0) ? 1 : nrg-door-line(s, tail(doors));
  def nrg-launch-line(path, s) = !nrg-program-source(path) ? 1 : nrg-door-line(s, nrg-doors()) ? 1 : nrg-mlx-entry(s) || (nrg-has(s, "py -3") || nrg-environment(s)) ? 1 : nrg-python-launch(s, 0);
  // A file that declares `native-guide: reference` in its head carries the guide's
  // own tokens and specimens: its lines are readings, unless one hands the word to a
  // door. A file holding a NUL byte is a compiled image; its text copies sources this
  // reading meets at their own paths.
  def nrg-head(text) = substring(text, 0, str_len(text) > 2048 ? 2048 : str_len(text));
  def nrg-declared(text) = nrg-has(nrg-head(text), "; native-guide: reference") || nrg-has(nrg-head(text), "// native-guide: reference");
  def nrg-mode(text) = str_find(text, byte_to_str(0), 0) >= 0 ? "compiled-artifact" : nrg-declared(text) ? "guide-reference" : "";
  def nrg-declared-kind(trimmed) = nrg-door-line(trimmed, nrg-doors()) ? "execution-candidate" : "guide-reference";
  def nrg-kind(path, mode, trimmed) = (String) mode == "compiled-artifact" ? mode : (String) mode == "guide-reference" ? nrg-declared-kind(trimmed) : nrg-ext(path, ".md") ? "guidance-reference" : nrg-start(trimmed, "#!") ? "execution-candidate" : nrg-comment(trimmed) ? "comment-reference" : nrg-launch-line(path, trimmed) ? "execution-candidate" : "name-reference";
  def nrg-comment(s) = nrg-start(s, ";") || (nrg-start(s, "#") || (nrg-start(s, "//") || nrg-start(s, "*")));
  def nrg-row(path, line, kind, token, reference) = list(path, line, kind, token, reference);
  def nrg-lines(path, mode, lines, number, found) {
   nil?(lines) ? reverse(found) : nrg-line(path, mode, head(lines), tail(lines), number, found);
  }
  def nrg-line(path, mode, line, rest, number, found) {
   let trimmed = lx-strip(line);
   let token = nrg-token(trimmed);
   (String) token == "" ? nrg-lines(path, mode, rest, number + 1, found) : nrg-lines(path, mode, rest, number + 1, cons(nrg-row(path, number, nrg-kind(path, mode, trimmed), token, nrg-find(line, nrg-catalog())), found));
  }
  def nrg-source(path, text) = nrg-python-file(path) ? list(nrg-row(path, 1, nrg-input(path) ? "foreign-grammar-input" : "python-implementation", "python-source", nrg-find(path, nrg-catalog()))) : nrg-history(path) || (!nrg-scan-extension(path)) ? list() : nrg-lines(path, nrg-mode(text), lx-lines(text), 1, list());
  def nrg-scan(paths, rows, unread) {
   nil?(paths) ? list(reverse(rows), reverse(unread)) : nrg-file(head(paths), tail(paths), rows, unread);
  }
  def nrg-file(path, rest, rows, unread) {
   (String) path == "" ? nrg-scan(rest, rows, unread) : file_size(path) < 0 ? nrg-scan(rest, rows, cons(path, unread)) : nrg-history(path) || (!(nrg-python-file(path) || nrg-scan-extension(path))) ? nrg-scan(rest, rows, unread) : nrg-read(path, rest, rows, unread, read_file(path));
  }
  def nrg-read(path, rest, rows, unread, source) = !nsi-exact(path,source) ? nrg-scan(rest, rows, cons(path, unread)) : nrg-scan(rest, append(reverse(nrg-source(path, source)), rows), unread);
  def nrg-s(key, value) = json-node-pair(key, json-node-string(value));
  def nrg-n(key, value) = json-node-pair(key, json-node-int(value));
  def nrg-strings(rows) = nil?(rows) ? list() : cons(json-node-string(head(rows)), nrg-strings(tail(rows)));
  def nrg-reference(row) = nil?(row) ? json-node-object(list(nrg-s("state", "native-search-owed"), nrg-s("next", "Search local Form cells, RAG, git history and receipts; build and observe an equivalent native path, update callers, then retire the Python implementation."))) : json-node-object(list(nrg-s("source", row[1]), nrg-s("witness", row[2]), nrg-s("scope", row[3]), nrg-s("state", (file_size(row[1]) >= 0) && (file_size(row[2]) >= 0) ? "reference-present;re-witness-before-replacement" : "reference-needs-recovery")));
  def nrg-json-row(row) = json-node-object(list(nrg-s("path", head(row)), nrg-n("line", row[1]), nrg-s("kind", row[2]), nrg-s("signal", row[3]), json-node-pair("native", nrg-reference(row[4]))));
  def nrg-json-rows(rows) = nil?(rows) ? list() : cons(nrg-json-row(head(rows)), nrg-json-rows(tail(rows)));
  def nrg-command(command) = json-emit(json-node-object(list(nrg-s("kind", "native-command-guidance"), nrg-s("signal", (String) nrg-token(command) == "" ? "no-python-token-observed;not-an-execution-proof" : nrg-token(command)), json-node-pair("native", nrg-reference(nrg-find(command, nrg-catalog()))), nrg-s("next", "Use and witness the native reference when it fits; otherwise carry the native implementation attempt. This reading executes no proposed command."))));
  def nrg-count(rows, kind) = nil?(rows) ? 0 : (((String) head(rows)[2] == kind ? 1 : 0) + nrg-count(tail(rows), kind));
  def nrg-action(row) = ((String) row[2] == "python-implementation") || ((String) row[2] == "execution-candidate");
  def nrg-next(rows, room) = nil?(rows) || (room <= 0) ? "" : !nrg-action(head(rows)) ? nrg-next(tail(rows), room) : head(head(rows)) ++ ":" ++ int_to_str(head(rows)[1]) ++ " -> " ++ (nil?(head(rows)[4]) ? "native search and observed replacement" : head(rows)[4][1]) ++ "\n" ++ nrg-next(tail(rows), room - 1);
  def nrg-run() {
   nrg-observe(nsi-text(nsi-git()));
  }
  def nrg-publish(path,text) {
   let temporary = path ++ ".native-" ++ int_to_str(host_pid()) ++ "-" ++ int_to_str(host_monotonic_ms());
   let written = write_file(temporary,text);
   !((Comparable) written == str_len(text)) ? nrg-publish-refused(temporary) : nrg-publish-checked(path,temporary,text,read_file(temporary));
  }
  def nrg-publish-checked(path,temporary,text,readback) = !(nsi-exact(temporary,readback) && ((String) text == readback)) ? nrg-publish-refused(temporary) : nrg-publish-moved(path,temporary,fs_rename(temporary,path));
  def nrg-publish-moved(path,temporary,status) = (Comparable) status == 0 ? path : nrg-publish-refused(temporary);
  def nrg-publish-refused(temporary) {
   let removed = fs_remove(temporary);
   form_error("native authoring guide report publication incomplete");
  }
  def nrg-observe(inventory) {
   let started = host_monotonic_ms();
   let reading = nrg-scan(split-on(inventory, byte_to_str(0)), list(), list());
   let rows = head(reading);
   let unread = reading[1];
   let headAt = nsi-text(nsi-require(nsi-capture(list("git", "rev-parse", "HEAD"))));
   let made = fs_mkdir(HearthDir());
   let report = json-node-object(list(nrg-s("version", "native-authoring-guide-v2"), nrg-n("observed_unix_ms", now_unix_ms()), nrg-n("elapsed_ms", host_monotonic_ms() - started), nrg-s("head", nothing?(headAt) ? "unread" : lx-strip(headAt)), nrg-s("scope", "git tracked and unignored working files; static source candidates, not a process trace; ignored scratch and dynamic commands need the same authoring practice"), nrg-s("responsibility", "shared: the acting agent carries the next native attempt"), nrg-n("python_implementations", nrg-count(rows, "python-implementation")), nrg-n("execution_candidates", nrg-count(rows, "execution-candidate")), nrg-n("foreign_grammar_inputs", nrg-count(rows, "foreign-grammar-input")), nrg-n("name_references", nrg-count(rows, "name-reference")), nrg-n("compiled_artifacts", nrg-count(rows, "compiled-artifact")), json-node-pair("unread_paths", json-node-array(nrg-strings(unread))), json-node-pair("observations", json-node-array(nrg-json-rows(rows)))));
   let retained = nrg-publish(hearth-native-authoring-guide(),json-emit(report) ++ "\n");
   nrg-cat(list("native authoring guide: Python implementations=", int_to_str(nrg-count(rows, "python-implementation")), " execution candidates=", int_to_str(nrg-count(rows, "execution-candidate")), " grammar inputs=", int_to_str(nrg-count(rows, "foreign-grammar-input")), " name references=", int_to_str(nrg-count(rows, "name-reference")), " compiled artifacts=", int_to_str(nrg-count(rows, "compiled-artifact")), " unread=", int_to_str(len(unread)), "\nreading=", retained, "\nNext native work, carried by us:\n", nrg-next(rows, 8)));
  }
 }
 0;
}
