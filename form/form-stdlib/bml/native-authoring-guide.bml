// A shared, current reading of Python detours and native places to continue.
// Source candidates are observations to follow, not claims of execution.
// preludes: gate/lens-text.bml form-stdlib/json.fk form-stdlib/form-fs.fk form-stdlib/hearth.bml
section [form.bml] {
 class NativeAuthoringGuide {
  def nrg-catalog() = list(
   list("jit", "observe/native-jit-guide-run.fk", "observe/native-jit-witness-run.fk", "Form owns JIT; inspect current host compiler candidates and use the native route; see docs/native-jit-routing.md"),
   list("validate_fkwu_native_surface.py", "gate/native-surface.bml", "gate/tests/native-surface-band.fk", "native check"),
   list("sync_native_op_manifest.py", "gate/op-manifest.bml", "gate/tests/op-manifest-band.fk", "native check"),
   list("validate_form_ontology.py", "gate/ontology.bml", "gate/tests/ontology-band.fk", "native check"),
   list("validate_primitive_registry.py", "gate/primitive-registry.bml", "gate/tests/primitive-registry-band.fk", "native check"),
   list("verify_category_contract.py", "gate/category-contract.bml", "gate/tests/category-contract-band.fk", "native check"),
   list("gen_flt_ops_from_manifest.py", "observe/native-op-emitter-run.fk", "form/form-stdlib/tests/native-op-emitter-band.fk", "native writer and checked restoration"),
   list("fourth-arm-gap-analysis.py", "observe/fourth-arm-gap-analysis-run.fk", "form/form-stdlib/tests/fourth-arm-gap-analysis-band.fk", "native source vocabulary analysis for historical flatten surveys; not a band execution or repair proof"),
   list("fourth-arm-survey.sh", "observe/native-source-prepare-run.fk", "observe/native-source-cache-witness-run.fk", "native compiler owns dependency freshness; current source becomes disposable proof input; see docs/native-source-preparation.md"),
   list("maximum node depth", "form/form-stdlib/bml/formbin-depth.bml", "observe/formbin-depth-witness-run.fk", "Form owns resumable artifact traversal and attention; Go FORMBIN2 carrier applies measured slice decisions; see docs/adaptive-artifact-depth.md"),
   list("verify_kernel_conformance.py", "gate/kernel-conformance.bml", "gate/tests/kernel-conformance-band.fk", "partial: FORMBIN2 codec comparisons still need a native replacement"),
   list("mlx_lm", "observe/lora-step-native-run.fk", "form/form-stdlib/tests/lora-step-live-band.fk", "native learning reference; compare the requested model and objective"),
   list("stt-oracle", "observe/ear-tongue-native.fk", "form/form-stdlib/tests/ear-tongue-band.fk", "native hearing reference; compare file and streaming input semantics"));
  def nrg-find(text, rows) = if nil?(rows) then list() else if ge(str_find(text, head(head(rows)), 0), 0) then head(rows) else nrg-find(text, tail(rows));
  def nrg-ext(path, ext) = str_eq(fs-path-extension(path), ext);
  def nrg-start(s, prefix) = lx-at?(s, 0, prefix);
  def nrg-has(s, part) = ge(str_find(s, part, 0), 0);
  def nrg-python-file(path) = or(nrg-ext(path, ".py"), nrg-ext(path, ".pyw"));
  def nrg-input(path) = or(nrg-has(path, "/fixtures/"), or(nrg-has(path, "-fixtures/"), or(nrg-has(path, "/python-adapter/examples/"), nrg-start(path, "form/form-samples/"))));
  def nrg-history(path) = nrg-start(path, "receipts/");
  def nrg-reference-source(path) = nrg-in(path, list("form/form-stdlib/bml/native-authoring-guide.bml", "form/form-stdlib/tests/native-authoring-guide-band.fk"));
  def nrg-scan-extension(path) = nrg-in(fs-path-extension(path), list("", ".fk", ".bml", ".sh", ".bash", ".zsh", ".ps1", ".cmd", ".bat", ".yml", ".yaml", ".toml", ".json", ".js", ".ts", ".go", ".rs", ".c", ".m", ".md"));
  def nrg-in(value, values) = if nil?(values) then 0 else if str_eq(value, head(values)) then 1 else nrg-in(value, tail(values));
  def nrg-word-byte(b) = or(and(ge(b, 65), le(b, 90)), or(and(ge(b, 97), le(b, 122)), or(and(ge(b, 48), le(b, 57)), eq(b, 95))));
  def nrg-py-end(s, i) = if ge(i, str_len(s)) then i else if or(and(ge(str_byte_at(s, i), 48), le(str_byte_at(s, i), 57)), and(eq(str_byte_at(s, i), 46), and(lt(add(i, 1), str_len(s)), and(ge(str_byte_at(s, add(i, 1)), 48), le(str_byte_at(s, add(i, 1)), 57))))) then nrg-py-end(s, add(i, 1)) else i;
  def nrg-python-at(s, from) {
   let i = str_find(s, "python", from);
   let baseEnd = if lt(i, 0) then 0 else nrg-py-end(s, add(i, 6));
   let end = if lx-at?(s, baseEnd, ".exe") then add(baseEnd, 4) else baseEnd;
   if lt(i, 0) then -1 else if and(or(eq(i, 0), not(nrg-word-byte(str_byte_at(s, sub(i, 1))))), or(eq(end, str_len(s)), nrg-in(byte_to_str(str_byte_at(s, end)), list(" ", "\t", "\n", "\r", "\"", "'", ";", ")", ",")))) then i else nrg-python-at(s, add(i, 6));
  }
  def nrg-token(s) = if ge(nrg-python-at(s, 0), 0) then "python-interpreter" else if nrg-has(s, "mlx_lm") then "mlx-python-entry" else if nrg-has(s, "py -3") then "python-launcher" else if or(nrg-has(s, "pip install"), nrg-has(s, "setup-python")) then "python-environment" else "";
  def nrg-comment(s) = or(nrg-start(s, ";"), or(nrg-start(s, "#"), or(nrg-start(s, "//"), nrg-start(s, "*"))));
  def nrg-row(path, line, kind, token, reference) = list(path, line, kind, token, reference);
  def nrg-lines(path, lines, number, found) {
   if nil?(lines) then reverse(found) else nrg-line(path, head(lines), tail(lines), number, found);
  }
  def nrg-line(path, line, rest, number, found) {
   let trimmed = lx-strip(line);
   let token = nrg-token(trimmed);
   if str_eq(token, "") then nrg-lines(path, rest, add(number, 1), found) else nrg-line-found(path, line, rest, number, found, trimmed, token);
  }
  def nrg-line-found(path, line, rest, number, found, trimmed, token) {
   let kind = if nrg-reference-source(path) then "guide-reference" else if nrg-ext(path, ".md") then "guidance-reference" else if nrg-start(trimmed, "#!") then "execution-candidate" else if nrg-comment(trimmed) then "comment-reference" else "execution-candidate";
   let row = nrg-row(path, number, kind, token, nrg-find(line, nrg-catalog()));
   nrg-lines(path, rest, add(number, 1), cons(row, found));
  }
  def nrg-source(path, text) = if nrg-python-file(path) then list(nrg-row(path, 1, if nrg-input(path) then "foreign-grammar-input" else "python-implementation", "python-source", nrg-find(path, nrg-catalog()))) else if or(nrg-history(path), not(nrg-scan-extension(path))) then list() else nrg-lines(path, lx-lines(text), 1, list());
  def nrg-scan(paths, rows, unread) {
   if nil?(paths) then list(reverse(rows), reverse(unread)) else nrg-file(head(paths), tail(paths), rows, unread);
  }
  def nrg-file(path, rest, rows, unread) {
   if str_eq(path, "") then nrg-scan(rest, rows, unread) else if lt(file_size(path), 0) then nrg-scan(rest, rows, cons(path, unread)) else if or(nrg-history(path), not(or(nrg-python-file(path), nrg-scan-extension(path)))) then nrg-scan(rest, rows, unread) else nrg-read(path, rest, rows, unread, read_file(path));
  }
  def nrg-read(path, rest, rows, unread, source) = if nothing?(source) then nrg-scan(rest, rows, cons(path, unread)) else nrg-scan(rest, append(reverse(nrg-source(path, source)), rows), unread);
  def nrg-s(key, value) = json-node-pair(key, json-node-string(value));
  def nrg-n(key, value) = json-node-pair(key, json-node-int(value));
  def nrg-strings(rows) = if nil?(rows) then list() else cons(json-node-string(head(rows)), nrg-strings(tail(rows)));
  def nrg-reference(row) = if nil?(row) then json-node-object(list(nrg-s("state", "native-search-owed"), nrg-s("next", "Search local Form cells, RAG, git history and receipts; build and observe an equivalent native path, update callers, then retire the Python implementation."))) else json-node-object(list(nrg-s("source", nth(row, 1)), nrg-s("witness", nth(row, 2)), nrg-s("scope", nth(row, 3)), nrg-s("state", if and(ge(file_size(nth(row, 1)), 0), ge(file_size(nth(row, 2)), 0)) then "reference-present;re-witness-before-replacement" else "reference-needs-recovery")));
  def nrg-json-row(row) = json-node-object(list(nrg-s("path", head(row)), nrg-n("line", nth(row, 1)), nrg-s("kind", nth(row, 2)), nrg-s("signal", nth(row, 3)), json-node-pair("native", nrg-reference(nth(row, 4)))));
  def nrg-json-rows(rows) = if nil?(rows) then list() else cons(nrg-json-row(head(rows)), nrg-json-rows(tail(rows)));
  def nrg-command(command) = json-emit(json-node-object(list(nrg-s("kind", "native-command-guidance"), nrg-s("signal", if str_eq(nrg-token(command), "") then "no-python-token-observed;not-an-execution-proof" else nrg-token(command)), json-node-pair("native", nrg-reference(nrg-find(command, nrg-catalog()))), nrg-s("next", "Use and witness the native reference when it fits; otherwise carry the native implementation attempt. This reading executes no proposed command."))));
  def nrg-count(rows, kind) = if nil?(rows) then 0 else add(if str_eq(nth(head(rows), 2), kind) then 1 else 0, nrg-count(tail(rows), kind));
  def nrg-action(row) = str_eq(nth(row, 2), "python-implementation");
  def nrg-next(rows, room) = if or(nil?(rows), le(room, 0)) then "" else if not(nrg-action(head(rows))) then nrg-next(tail(rows), room) else str_concat(head(head(rows)), str_concat(":", str_concat(int_to_str(nth(head(rows), 1)), str_concat(" -> ", str_concat(if nil?(nth(head(rows), 4)) then "native search and observed replacement" else nth(nth(head(rows), 4), 1), str_concat("\n", nrg-next(tail(rows), sub(room, 1))))))));
  def nrg-run() {
   let inventory = host_capture(list("git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"));
   if nothing?(inventory) then "native authoring guide: inventory unavailable; recover the repository reading" else if or(ge(str_len(inventory), 1048576), or(eq(str_len(inventory), 0), not(eq(str_byte_at(inventory, sub(str_len(inventory), 1)), 0)))) then "native authoring guide: inventory incomplete; no clean reading" else nrg-observe(inventory);
  }
  def nrg-observe(inventory) {
   let started = host_monotonic_ms();
   let reading = nrg-scan(split-on(inventory, byte_to_str(0)), list(), list());
   let rows = head(reading);
   let unread = nth(reading, 1);
   let headAt = host_capture(list("git", "rev-parse", "HEAD"));
   let made = fs_mkdir(HearthDir());
   let report = json-node-object(list(nrg-s("version", "native-authoring-guide-v1"), nrg-n("observed_unix_ms", now_unix_ms()), nrg-n("elapsed_ms", sub(host_monotonic_ms(), started)), nrg-s("head", if nothing?(headAt) then "unread" else lx-strip(headAt)), nrg-s("scope", "git tracked and unignored working files; static source candidates, not a process trace; ignored scratch and dynamic commands need the same authoring practice"), nrg-s("responsibility", "shared: the acting agent carries the next native attempt"), nrg-n("python_implementations", nrg-count(rows, "python-implementation")), nrg-n("execution_candidates", nrg-count(rows, "execution-candidate")), nrg-n("foreign_grammar_inputs", nrg-count(rows, "foreign-grammar-input")), json-node-pair("unread_paths", json-node-array(nrg-strings(unread))), json-node-pair("observations", json-node-array(nrg-json-rows(rows)))));
   let written = write_file(hearth-native-authoring-guide(), str_concat(json-emit(report), "\n"));
   str_concat("native authoring guide: Python implementations=", str_concat(int_to_str(nrg-count(rows, "python-implementation")), str_concat(" execution candidates=", str_concat(int_to_str(nrg-count(rows, "execution-candidate")), str_concat(" grammar inputs=", str_concat(int_to_str(nrg-count(rows, "foreign-grammar-input")), str_concat(" unread=", str_concat(int_to_str(len(unread)), str_concat("\nreading=", str_concat(if lt(written, 0) then "could not retain report" else hearth-native-authoring-guide(), str_concat("\nNext native work, carried by us:\n", nrg-next(rows, 8))))))))))));
  }
 }
 0;
}
