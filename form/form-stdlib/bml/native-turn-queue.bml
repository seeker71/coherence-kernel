// native-turn-queue.bml — the one writer of learn/native-turn-queue.jsonl: a gap is one row, named by its id.
//
// observe/native-turn-run.bml reads this file and takes the open gap by id, so two rows of one id are one gap read twice (the
// queue held task-a1e5d0b6337fd863 three times and task-6b1930803d69bd7e twice before this home stood). Every door that adds a row
// passes ntq-append: a row whose id already stands is refused by name ("refused:id-stands <id>") and nothing is written; a row
// that names no id (a verified task record) appends as it always did. ntq-dedupe reads a queue that already holds repeats back to
// one row per id, the latest row of each id staying where it stands (the latest is what every reader of an id reads: rsi-rounds,
// form-cli-task's request row, form-cli-local-plan's plan row).
// A gap that learns its own final reading (form-cli-task's completed task, whose full is read after the code lane ran) replaces its row in place with ntq-put.
//   ntq-has?(path, id)     true when a row of that id stands in the queue file
//   ntq-append(path, row)  "appended" | "refused:id-stands <id>" | the sink's own refusal; row is a JSON node
//   ntq-put(path, row)     "appended" when no row of that id stood, else "replaced": the id's row now reads as this row, once, where the latest stood
//   ntq-dedupe(path)       how many earlier rows of a repeated id were dropped (0 when none: the file is left untouched)
// PROOF: form-stdlib/tests/offline-voice-gaps-band.bml, claim steer.
import form-stdlib/bml/form-cli-heal-native-io.bml;
import form-stdlib/bml/form-cli-guide-packet.bml;
section [form.bml] {
 class NativeTurnQueue {
  def ntq-path() = "learn/native-turn-queue.jsonl";
  def ntq-lines(path) = file_size(path) < 1 ? [] : filter(l => (Comparable) len(trim(l)) > 0, split-on(fhn-read(path), "\n"));
  def ntq-line-id(line) = fcgp-object-line?(trim(line)) ? fcgp-str(parse-json("queue-row", trim(line)), "id") : "";
  def ntq-has?(path, id) = (String) id != "" && any?(l => (String) ntq-line-id(l) == id, ntq-lines(path));
  def ntq-append(path, row) {
   let id = fcgp-str(row, "id");
   ntq-has?(path, id) ? "refused:id-stands " ++ id : fhn-append(path, lrun-row-line(row) ++ "\n");
  }
  def ntq-latest?(ids, at) = (String) ids[at] == "" || !any?(j => (Comparable) j > at && (String) ids[j] == ids[at], range(0, len(ids)));
  // the later row of each id, in order: the one reading of "one id is one gap" (native-turn-run reads its queue through it; a row with no id stays)
  def ntq-latest-rows(rows) {
   let ids = map(r => fcgp-str(r, "id"), rows);
   map(i => rows[i], filter(i => ntq-latest?(ids, i), range(0, len(rows))));
  }
  def ntq-dedupe(path) {
   let lines = ntq-lines(path);
   let ids = map(l => ntq-line-id(l), lines);
   let kept = filter(i => ntq-latest?(ids, i), range(0, len(lines)));
   let dropped = len(lines) - len(kept);
   let wrote = (Comparable) dropped == 0 ? 0 : write_file_text(path, foldl((acc, i) => acc ++ lines[i] ++ "\n", "", kept));
   dropped;
  }
  def ntq-put(path, row) {
   let id = fcgp-str(row, "id");
   let line = lrun-row-line(row);
   let lines = ntq-lines(path);
   let ids = map(l => ntq-line-id(l), lines);
   let kept = filter(i => (String) ids[i] != id || ntq-latest?(ids, i), range(0, len(lines)));
   let held = ntq-has?(path, id);
   let wrote = held ? write_file_text(path, foldl((acc, i) => acc ++ ((String) ids[i] == id ? line : lines[i]) ++ "\n", "", kept)) : 0;
   held ? "replaced" : fhn-append(path, lrun-row-line(row) ++ "\n");
  }
 }
}
