// The agent-facing, command-shaped JSON wire for resident coding tools.
// The input and result are data only: no host command, file, process, network,
// or implicit session-state operation exists on this path.
// preludes: form-stdlib/core.fk form-stdlib/bml/form-agent-tools.bml
section [form.bml] {
    class FormAgentToolWire {
        field FatWireSchema = "form-agent-tool-wire-v1";

        def fat-wire-value(pair) = head(pair);
        def fat-wire-error(pair) = nth(pair, 1);
        def fat-wire-good(value) = list(value, "");
        def fat-wire-bad(reason) = list(list(), reason);
        def fat-wire-string?(node) = str_eq(faj-type(node), "string");
        def fat-wire-object?(node) = faj-is(node, JSON-OBJECT());
        def fat-wire-array?(node) = faj-is(node, JSON-ARRAY());
        def fat-wire-field-string(obj, key, fallback) = if not(json-object-has?(obj, key)) then fat-wire-good(fallback) else if not(fat-wire-string?(json-object-get(obj, key))) then fat-wire-bad(str_concat("wire-field-needs-string:", key)) else fat-wire-good(node_value(json-object-get(obj, key)));
        def fat-wire-required-string(obj, key) = if not(json-object-has?(obj, key)) then fat-wire-bad(str_concat("wire-field-required:", key)) else fat-wire-field-string(obj, key, "");

        def fat-wire-document(node) = if not(fat-wire-object?(node)) then fat-wire-bad("wire-document-needs-object") else fat-wire-document-id(node, fat-wire-required-string(node, "id"));
        def fat-wire-document-id(node, id) = if not(str_eq(fat-wire-error(id), "")) then id else fat-wire-document-path(node, id, fat-wire-required-string(node, "path"));
        def fat-wire-document-path(node, id, path) = if not(str_eq(fat-wire-error(path), "")) then path else fat-wire-document-text(id, path, fat-wire-required-string(node, "text"));
        def fat-wire-document-text(id, path, text) = if not(str_eq(fat-wire-error(text), "")) then text else fat-wire-good(list(fat-wire-value(id), fat-wire-value(path), fat-wire-value(text)));
        def fat-wire-documents-loop(nodes, out) = if nil?(nodes) then fat-wire-good(fat-reverse(out)) else fat-wire-documents-next(nodes, out, fat-wire-document(head(nodes)));
        def fat-wire-documents-next(nodes, out, doc) = if not(str_eq(fat-wire-error(doc), "")) then doc else fat-wire-documents-loop(tail(nodes), cons(fat-wire-value(doc), out));
        def fat-wire-documents(obj) = if not(json-object-has?(obj, "documents")) then fat-wire-good(list()) else if not(fat-wire-array?(json-object-get(obj, "documents"))) then fat-wire-bad("wire-field-needs-array:documents") else fat-wire-documents-loop(node_children(json-object-get(obj, "documents")), list());

        def fat-wire-document-node(doc) = json-node-object(list(json-node-pair("id", intern_trivial_string(nth(doc, 0))), json-node-pair("path", intern_trivial_string(nth(doc, 1))), json-node-pair("text", intern_trivial_string(nth(doc, 2)))));
        def fat-wire-documents-node(docs) = if nil?(docs) then faj-array(list()) else faj-array(cons(fat-wire-document-node(head(docs)), node_children(fat-wire-documents-node(tail(docs)))));
        def fat-wire-result-node(result) = json-node-object(list(json-node-pair("schema", intern_trivial_string(FatWireSchema())), json-node-pair("exit", intern_trivial_int(fat-exit(result))), json-node-pair("stdout", intern_trivial_string(fat-out(result))), json-node-pair("stderr", intern_trivial_string(fat-error(result))), json-node-pair("documents", fat-wire-documents-node(fat-documents(result))), json-node-pair("crossings", intern_trivial_int(fat-crossings(result)))));
        def fat-wire-render(result) = json-emit(fat-wire-result-node(result));
        def fat-wire-refusal(reason) = fat-wire-render(fat-fail(reason, list()));

        def fat-wire-decoded(node) = if not(fat-wire-object?(node)) then fat-wire-refusal("wire-request-needs-object") else fat-wire-command(node, fat-wire-required-string(node, "command"));
        def fat-wire-command(node, command) = if not(str_eq(fat-wire-error(command), "")) then fat-wire-refusal(fat-wire-error(command)) else fat-wire-input(node, command, fat-wire-field-string(node, "input", ""));
        def fat-wire-input(node, command, input) = if not(str_eq(fat-wire-error(input), "")) then fat-wire-refusal(fat-wire-error(input)) else fat-wire-docs(node, command, input, fat-wire-documents(node));
        def fat-wire-docs(node, command, input, docs) = if not(str_eq(fat-wire-error(docs), "")) then fat-wire-refusal(fat-wire-error(docs)) else fat-wire-render(fat-command(fat-wire-value(docs), fat-wire-value(command), fat-wire-value(input)));
        def fat-wire-call(request) = if not(fat-text?(request)) then fat-wire-refusal("wire-request-needs-text") else if gt(str_len(request), FatMaxBytes()) then fat-wire-refusal("wire-request-limit") else if not(faj-valid(request)) then fat-wire-refusal("invalid-wire-json") else fat-wire-decoded(faj-json("form-agent-tool-wire", request));
    }
}
