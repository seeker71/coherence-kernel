// The agent-facing, command-shaped JSON wire for resident coding tools.
// The input and result are data only: no host command, file, process, network,
// or implicit session-state operation exists on this path.
// preludes: form-stdlib/core.fk form-stdlib/bml/form-agent-tools.bml
section [form.bml] {
    class FormAgentToolWire {
        field FatWireSchema = "form-agent-tool-wire-v1";

        def fat-wire-value(pair) = head(pair);
        def fat-wire-error(pair) = pair[1];
        def fat-wire-good(value) = list(value, "");
        def fat-wire-bad(reason) = list(list(), reason);
        def fat-wire-string?(node) = (String) faj-type(node) == "string";
        def fat-wire-object?(node) = faj-is(node, JSON-OBJECT());
        def fat-wire-array?(node) = faj-is(node, JSON-ARRAY());
        def fat-wire-field-string(obj, key, fallback) = !json-object-has?(obj, key) ? fat-wire-good(fallback) : !fat-wire-string?(json-object-get(obj, key)) ? fat-wire-bad("wire-field-needs-string:" ++ key) : fat-wire-good(node_value(json-object-get(obj, key)));
        def fat-wire-required-string(obj, key) = !json-object-has?(obj, key) ? fat-wire-bad("wire-field-required:" ++ key) : fat-wire-field-string(obj, key, "");

        def fat-wire-document(node) = !fat-wire-object?(node) ? fat-wire-bad("wire-document-needs-object") : fat-wire-document-id(node, fat-wire-required-string(node, "id"));
        def fat-wire-document-id(node, id) = !((String) fat-wire-error(id) == "") ? id : fat-wire-document-path(node, id, fat-wire-required-string(node, "path"));
        def fat-wire-document-path(node, id, path) = !((String) fat-wire-error(path) == "") ? path : fat-wire-document-text(id, path, fat-wire-required-string(node, "text"));
        def fat-wire-document-text(id, path, text) = !((String) fat-wire-error(text) == "") ? text : fat-wire-good(list(fat-wire-value(id), fat-wire-value(path), fat-wire-value(text)));
        def fat-wire-documents-loop(nodes, out) = nil?(nodes) ? fat-wire-good(fat-reverse(out)) : fat-wire-documents-next(nodes, out, fat-wire-document(head(nodes)));
        def fat-wire-documents-next(nodes, out, doc) = !((String) fat-wire-error(doc) == "") ? doc : fat-wire-documents-loop(tail(nodes), cons(fat-wire-value(doc), out));
        def fat-wire-documents(obj) = !json-object-has?(obj, "documents") ? fat-wire-good(list()) : !fat-wire-array?(json-object-get(obj, "documents")) ? fat-wire-bad("wire-field-needs-array:documents") : fat-wire-documents-loop(node_children(json-object-get(obj, "documents")), list());

        def fat-wire-document-node(doc) = json-node-object(list(json-node-pair("id", intern_trivial_string(doc[0])), json-node-pair("path", intern_trivial_string(doc[1])), json-node-pair("text", intern_trivial_string(doc[2]))));
        def fat-wire-document-nodes(docs) = nil?(docs) ? list() : cons(fat-wire-document-node(head(docs)), fat-wire-document-nodes(tail(docs)));
        def fat-wire-documents-node(docs) = json-node-array(fat-wire-document-nodes(docs));
        def fat-wire-result-node(result) = json-node-object(list(json-node-pair("schema", intern_trivial_string(FatWireSchema())), json-node-pair("exit", intern_trivial_int(fat-exit(result))), json-node-pair("stdout", intern_trivial_string(fat-out(result))), json-node-pair("stderr", intern_trivial_string(fat-error(result))), json-node-pair("documents", fat-wire-documents-node(fat-documents(result))), json-node-pair("crossings", intern_trivial_int(fat-crossings(result)))));
        def fat-wire-render(result) = json-emit(fat-wire-result-node(result));
        def fat-wire-refusal(reason) = fat-wire-render(fat-fail(reason, list()));

        def fat-wire-decoded(node) = !fat-wire-object?(node) ? fat-wire-refusal("wire-request-needs-object") : fat-wire-command(node, fat-wire-required-string(node, "command"));
        def fat-wire-command(node, command) = !((String) fat-wire-error(command) == "") ? fat-wire-refusal(fat-wire-error(command)) : fat-wire-input(node, command, fat-wire-field-string(node, "input", ""));
        def fat-wire-input(node, command, input) = !((String) fat-wire-error(input) == "") ? fat-wire-refusal(fat-wire-error(input)) : fat-wire-docs(node, command, input, fat-wire-documents(node));
        def fat-wire-docs(node, command, input, docs) = !((String) fat-wire-error(docs) == "") ? fat-wire-refusal(fat-wire-error(docs)) : fat-wire-render(fat-command(fat-wire-value(docs), fat-wire-value(command), fat-wire-value(input)));
        def fat-wire-call(request) = !fat-text?(request) ? fat-wire-refusal("wire-request-needs-text") : str_len(request) > FatMaxBytes() ? fat-wire-refusal("wire-request-limit") : !faj-valid(request) ? fat-wire-refusal("invalid-wire-json") : fat-wire-decoded(faj-json("form-agent-tool-wire", request));
    }
}
