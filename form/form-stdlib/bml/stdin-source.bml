// stdin-source.bml — a door's input as one source, read by bytes, never by lines.
//
// read_line cuts its input at every newline and at 8191 bytes, handing the rest back
// as the next "line"; a door that reads its arguments that way cannot take a value that
// is longer or spans lines. stdin-text reads fd 0 in 64 KiB chunks through file_read
// until the stream ends and joins them by halving, so the door holds its whole input
// as one string: the source a grammar (or parse-json) transmutes into Form in one pass.
// An empty stdin is "", and a closed one the same. fkwu carries file_read on fd 0.

section [form.bml] {
    class StdinSource {
        def stdin-chunks(acc) {
            let chunk = file_read(0, 65536);
            if (str_len(chunk) == 0) then acc else stdin-chunks(cons(chunk, acc));
        }
        def stdin-text() = str-join-reversed(stdin-chunks(list()));
    }
}
