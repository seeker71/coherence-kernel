// Derive a report assertion from an actual native source query.
// The caller chooses both queries before generation. Expected bytes remain in
// the checker; the model receives its source documents through the usual door.
// Matching query output establishes those bytes, not the answer's interpretation.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class FormCliSourceReportCheck {
  def fsrc-none(reason) = list(0,json-node-null(),json-node-object(list(nsm-s("status","unavailable"),nsm-s("reason",reason))));
  def fsrc-request(raw) = if or(gt(str_len(raw),FatMaxBytes()),not(faj-valid(raw))) then fsrc-none("bounded-json-request-required") else {
   let request = parse-json("source-report-check",raw);
   let documents = fat-wire-documents(request);
   if not(str_eq(fat-wire-error(documents),"")) then fsrc-none(fat-wire-error(documents)) else fsrc-derive(fat-wire-value(documents),json-object-get(request,"source_query"),json-object-get(request,"report_query"));
  };
  def fsrc-report(result) = json-node-object(list(nsm-s("status",if head(result) then "observed" else "unavailable"),json-node-pair("report_check",nth(result,1)),json-node-pair("source_observation",nth(result,2))));
  def fsrc-derive(docs,sourceQuery,reportQuery) = if not(fat-docs-valid(docs,list())) then fsrc-none("source-documents-invalid") else if not(and(fcap-source-query-valid(sourceQuery),fcap-source-query-valid(reportQuery))) then fsrc-none("caller-owned-readonly-queries-required") else {
   let observed = fat-call(docs,fcap-string(sourceQuery,"tool"),fcap-array(sourceQuery,"arguments"),"");
   let evidence = json-node-object(list(nsm-s("status",if and(eq(fat-exit(observed),0),str_eq(fat-error(observed),"")) then "observed" else "unavailable"),json-node-pair("query",sourceQuery),nsm-n("exit",fat-exit(observed)),nsm-s("stdout",fat-out(observed)),nsm-s("stderr",fat-error(observed)),nsm-s("scope","Exact native source-query output. A matching report query does not establish prose accuracy, source completeness or a normative conclusion.")));
   if not(and(eq(fat-exit(observed),0),str_eq(fat-error(observed),""))) then list(0,json-node-null(),evidence) else {
    let check = oh-set(reportQuery,"stdout",json-node-string(fat-out(observed)));
    if fcaq-report-checks-valid(list(check)) then list(1,check,evidence) else fsrc-none("derived-report-query-invalid");
   };
  };
 }
 0;
}
