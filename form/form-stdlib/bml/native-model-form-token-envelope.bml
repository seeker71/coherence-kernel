//////////////////////////////////////////////////////////////////////
//
// native-model-form-token-envelope.bml — authority for one compact,
// model-independent Form token contract across the local model registry.
//
// The contract does not pretend every artifact can execute. Every registry
// row receives a projection; text models with a bound runtime receive the
// compact prefix, Form-native non-generative lanes carry the same meanings as
// native primitives, and unbound/non-text/remote rows say why they are not
// prompt-admitted.
//
// Executable: form-stdlib/native-model-form-token-envelope.bml
// Proven by: form-stdlib/tests/native-model-form-token-envelope-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.native.modeltokens;

import Form.kernel.*;
import Form.native.models.*;

interface INativeModelFormTokenEnvelope [public, witness, reusable] {
   section [public] {
      const String Schema = "native-model-form-token-envelope-v1";
      const String PopulationRule = "exactly one token-envelope projection for every registry row";
      const String SemanticRule = "the eight controls keep one Form-owned meaning across every admitted model";
      const String NativeVocabularyRule = "every local registry row is assigned Node-ID,nothing,choice,fail,cut,undo,timeout,eval,store,release,melt,crystallize/crystalize,open,interface,protocol,offer,ask,broadcast,mesh,satsang";
      const String DeliveryRule = "bound local text generators receive compact names plus only the purified descriptions selected for the current query lane; Form-native non-generators carry native primitives";
      const String SafetyRule = "model-emitted controls and primitives remain inert until native validation admits them";
      const String AvailabilityRule = "unbound artifacts, non-text models, remote oracles, and fixtures are named rather than impersonating support";
      const int ControlCount = 8;
      const int NativeWordCount = 20;

      bool Local( String strClass ) [abstract];
      bool PromptAdmitted( String strModelId ) [abstract];
      String DeliveryMode( String strModelId ) [abstract];
      String Wrap( String strModelId, String strPrompt ) [abstract];
   }
}

class NativeModelFormTokenEnvelope [public, reusable, flow, teach, observable] : INativeModelFormTokenEnvelope {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-form-token-envelope.bml";
      const String ControlFamily = "<CHOICE> <CUT> <FAIL> <STOP> <UNDO> <STORE> <RESTORE> <TIMEOUT>";
      const String PrimitiveFamily = "mul add sub list lookup";
      const String NativeWordFamily = "Node-ID nothing choice fail cut undo timeout eval store release melt crystallize/crystalize open interface protocol offer ask broadcast mesh satsang";
      const String QwenModelId = "challenger.qwen38-flash-next-q2-metal";
      const String ThreeBModelId = "base.llama32-3b-metal";

      bool Local( String strClass ) [abstract] {}
      bool PromptAdmitted( String strModelId ) [abstract] {}
      String DeliveryMode( String strModelId ) [abstract] {}
      String Wrap( String strModelId, String strPrompt ) [abstract] {}
   }
}
