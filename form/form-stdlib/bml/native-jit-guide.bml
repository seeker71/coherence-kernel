// Read the current Form compiler route and its executable witnesses.
// preludes: form-stdlib/bml/native-jit-route.bml
section [form.bml] {
 class NativeJitGuide {
  def njg-paths() = list(njr-compiler(), njr-emitter(), njr-demand(), "observe/native-jit-witness-run.fk", "form/form-stdlib/tests/direct-source-jit-discovery-band.fk", "observe/native-jit-retirement-witness-run.fk", "docs/native-jit-routing.md");
  def njg-read(paths, count, unread) {
   if nil?(paths) then list(count, reverse(unread))
   else if nothing?(read_file(head(paths))) then njg-read(tail(paths), count, cons(head(paths), unread))
   else njg-read(tail(paths), add(count, 1), unread);
  }
  def njg-run() {
   let reading = njg-read(njg-paths(), 0, list());
   print(list("native-jit-guide", now_unix_ms(), "references-read", head(reading), "unread", nth(reading, 1)));
   print(list("owner", njr-owner(), "door", njr-door(), "compiler", njr-compiler(), "emitter", njr-emitter(), "demand", njr-demand()));
   print(list("references", njg-paths()));
   print("Recovery: search local Form cells, RAG, git history and receipts; attempt the Form route; retain behavior checks and per-stage streams, exit status and timing; update callers and re-observe. Source presence is a reading; execute the witnesses to establish behavior. Host loaders admit Form-emitted images.");
   if nil?(nth(reading, 1)) then 1 else form_error("native JIT guide: a current reference is unreadable");
  }
 }
 0;
}
