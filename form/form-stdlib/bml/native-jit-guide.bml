// Current source reading for the retired host JITs. Pattern matches are
// candidates to inspect; this is not a proof about a running process.
// preludes: form-stdlib/bml/native-authoring-guide.bml form-stdlib/bml/native-jit-route.bml
section [form.bml] {
 class NativeJitGuide {
  def njg-retired() = list("form/form-kernel-go/jit.go", "form/form-kernel-go/jit_value.go", "form/form-kernel-go/jit_c.go", "form/form-kernel-go/jit_race.go", "form/form-kernel-go/jitabi/jitabi.go", "form/form-kernel-go/jit_test.go", "form/form-kernel-go/jit_value_test.go", "form/form-kernel-ts/src/compiler.ts", "form/form-kernel-ts/src/bench.ts", "form/form-kernel-ts/src/numeric-bench.ts");
  def njg-signals() = list("plugin.Open(", "\"-buildmode=plugin\"", "new Function(", "emit_rust_source(", "compile_rust_cdylib(", "jitCompileClosure", "jitCompileHook", "jitCompiledGo", "registerEnvNative(\"jit_compile", "register_env_native(\"jit_compile");
  def njg-token(source, signals) = if nil?(signals) then "" else if nrg-has(source, head(signals)) then head(signals) else njg-token(source, tail(signals));
  def njg-lines(path, lines, number, rows) {
   if nil?(lines) then rows else njg-line(path, lx-strip(head(lines)), tail(lines), number, rows);
  }
  def njg-line(path, line, rest, number, rows) {
   let token = if nrg-comment(line) then "" else njg-token(line, njg-signals());
   njg-lines(path, rest, add(number, 1), if str_eq(token, "") then rows else cons(list(path, number, token), rows));
  }
  def njg-source(path) = nrg-in(fs-path-extension(path), list(".go", ".rs", ".ts", ".js", ".mjs", ".c"));
  def njg-scan(paths, rows, unread, files) {
   if nil?(paths) then list(reverse(rows), reverse(unread), files)
   else if or(str_eq(head(paths), ""), not(njg-source(head(paths)))) then njg-scan(tail(paths), rows, unread, files)
   else if lt(file_size(head(paths)), 0) then njg-scan(tail(paths), rows, if nrg-in(head(paths), njg-retired()) then unread else cons(head(paths), unread), files)
   else njg-read(head(paths), tail(paths), rows, unread, files, read_file(head(paths)));
  }
  def njg-read(path, rest, rows, unread, files, source) = if nothing?(source) then njg-scan(rest, rows, cons(path, unread), files) else njg-scan(rest, njg-lines(path, lx-lines(source), 1, rows), unread, add(files, 1));
  def njg-run() {
   let inventory = host_capture(list("git", "ls-files", "-z", "--cached", "--others", "--exclude-standard", "form/form-kernel-go", "form/form-kernel-rust/src", "form/form-kernel-ts/src"));
   if nothing?(inventory) then form_error("native JIT guide: inventory unavailable") else if or(eq(str_len(inventory), 0), or(ge(str_len(inventory), 1048576), not(eq(str_byte_at(inventory, sub(str_len(inventory), 1)), 0)))) then form_error("native JIT guide: inventory incomplete") else njg-report(njg-scan(split-on(inventory, byte_to_str(0)), list(), list(), 0));
  }
  def njg-report(reading) {
   print(list("native-jit-guide", now_unix_ms(), "files", nth(reading, 2), "candidates", len(head(reading)), "unread", len(nth(reading, 1))));
   print(list("candidates", head(reading), "unread", nth(reading, 1)));
   print(list("owner", njr-owner(), "door", njr-door(), "compiler", njr-compiler(), "emitter", njr-emitter(), "demand", njr-demand()));
   print("Recovery: inspect each candidate; search Form cells, RAG, git history and receipts; use the Form compiler; preserve behavior checks; remove the host emitter and its callers. Host loaders only admit Form-emitted images.");
   if and(nil?(head(reading)), nil?(nth(reading, 1))) then 1 else 0;
  }
 }
 0;
}
