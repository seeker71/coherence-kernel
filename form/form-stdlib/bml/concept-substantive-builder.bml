   let count = cmm-publish-all(input,stages,0);
   csb-check(input,"complete-publication",((Comparable) count == len(outputs)));
   csb-check(input,"stages-released",cmm-clean-stages(record_get(input,"owned-stages")));
   record_set(input,"owned-stages",list());
   csa-run-with(record_get(input,"root"),record_get(input,"hash"));
   count;
  }
  def csb-run(root,engine) = csb-publish(csb-prepare(root,engine));
 }
 0;
}
