// Deterministic substantive construction from held revision-pinned evidence.
// Recorded source identities and provenance are checked before publication.
// preludes: form-stdlib/bml/concept-materializer.bml
section [form.bml] {
 class ConceptSubstantiveBuilder {
  def csb-base() = "model/concept-10000-substantive-repair";
  def csb-path(suffix) = str_concat(csb-base(),suffix);
  def csb-nl(suffix) = str_concat("cognition/concept-10000-substantive-repair-111-nl",suffix);
  def csb-ranked() = "model/concept-10000-ranked.dat";
  def csb-lexical() = "model/concept-10000-lexical-index.dat";
  def csb-holes() = "model/concept-semantics-10000-wiktionary-lexical-remaining.tsv";
  def csb-manifest-files() = list(csb-ranked(),csb-lexical(),csb-path("-alias-index.dat"),csb-path("-evidence.jsonl"),csb-path("-migration.tsv"),csb-path("-semantic-index.dat"),csb-path("-semantic-payload.dat"),csb-nl(".tsv"),csb-nl("-sources.dat"),csb-path("-data.fk"),csb-nl("-data.fk"));
  def csb-input-files() = list(csb-ranked(),csb-path("-evidence.jsonl"),csb-nl(".tsv"),csb-nl("-sources.dat"));
  def csb-path-bytes(text,at) = if (at >= str_len(text)) then 1 else (((Comparable) str_byte_at(text,at) != 0) && csb-path-bytes(text,(at + 1)));
  def csb-root(root) = if (((String) value_kind(root) == "string") && ((str_len(root) > 0) && csb-path-bytes(root,0))) then root else csa-input-refused("nonempty root path without NUL bytes required");
  def csb-manifest-admit(state,lines,paths) {
   if nil?(paths) then csb-check(state,"manifest-paths-complete",nil?(lines)) else if nil?(lines) then csb-check(state,"manifest-path-missing",0) else csb-manifest-admit-row(state,csa-fields(head(lines)),head(paths),tail(lines),tail(paths));
  }
  def csb-manifest-admit-row(state,fields,path,rest,paths) {
   csb-check(state,"manifest-path-and-fields",(((Comparable) len(fields) == 3) && (((String) head(fields) == path) && (csa-digits(nth(fields,1),0) && (((Comparable) str_len(nth(fields,2)) == 64) && cmm-hex?(nth(fields,2),0))))));
   if oh-has(csb-input-files(),path) then csb-check(state,"held-input-identity",(((Comparable) str_len(csa-file(state,path)) == str_to_int(nth(fields,1))) && ((String) csa-file-hash(state,path) == nth(fields,2)))) else 0;
   csb-manifest-admit(state,rest,paths);
  }
  def csb-check(state,aspect,ok) = csa-check(state,str_concat("substantive-build-",aspect),ok,"held evidence and native prepared bytes");
  def csb-str(row,key) = json-string-value(json-object-get(row,key));
  def csb-num(row,key) = json-int-value(json-object-get(row,key));
  def csb-typed(row,keys,kind) = if nil?(keys) then 1 else (((Comparable) node_type(json-object-get(row,head(keys))) == kind) && csb-typed(row,tail(keys),kind));
  def csb-json-unique(pairs,seen) = if nil?(pairs) then 1 else if oh-has(seen,json-pair-key(head(pairs))) then 0 else csb-json-unique(tail(pairs),cons(json-pair-key(head(pairs)),seen));
  def csb-json(state,text) {
   if (!jwa-valid(text)) then csb-check(state,"complete-evidence-json",0) else 0;
   let row = parse-json("substantive-evidence",text);
   csb-check(state,"unique-object-fields",(node_eq(node_category(row),JSON-OBJECT()) && csb-json-unique(json-object-pairs(row),list())));
   row;
  }
  def csb-repeat(text,count) = if (count <= 0) then "" else str_concat(text,csb-repeat(text,(count - 1)));
  def csb-fixed(state,value,width) = if (str_len(value) > width) then csb-check(state,"fixed-byte-width",0) else str_concat(value,csb-repeat(" ",(width - str_len(value))));
  def csb-decimal(state,value,width) {
   let text = int_to_str(value);
   if (!((value >= 0) && (str_len(text) <= width))) then csb-check(state,"decimal-width",0) else 0;
   str_concat(csb-repeat("0",(width - str_len(text))),text);
  }
  def csb-length(state,value,width) = str_concat(csb-decimal(state,str_len(value),width),value);
  def csb-cat(parts) = csa-join(parts,"");
  def csb-clean(text,at,space,bins) {
   if (at >= str_len(text)) then fbc-finish(bins,"") else csb-clean-byte(text,at,space,bins,str_byte_at(text,at));
  }
  def csb-clean-byte(text,at,space,bins,b) {
   let separator = (((Comparable) b == 9) || (((Comparable) b == 10) || ((Comparable) b == 13)));
   csb-clean(text,(at + 1),separator,if separator then if space then bins else fbc-put(bins," ") else fbc-put(bins,byte_to_str(b)));
  }
  def csb-header(state,key) = record_get(state,str_concat("manifest:",key));
  def csb-headers(state,lines,count) {
   if nil?(lines) then count else csb-header-line(state,head(lines),tail(lines),count);
  }
  def csb-header-line(state,line,rest,count) {
   let at = str_find(line,"=",0);
   if (at < 0) then csb-headers(state,rest,count) else csb-header-value(state,substring(line,0,at),substring(line,(at + 1),str_len(line)),rest,count);
  }
  def csb-header-value(state,key,value,rest,count) {
   csb-check(state,"manifest-header-unique",csa-unique(state,"header-seen:",key));
   record_set(state,str_concat("manifest:",key),value);
   csb-headers(state,rest,(count + 1));
  }
  def csb-meta(state,row) {
   let meta = json-object-get(row,"_meta");
   csb-check(state,"metadata-types",(node_eq(node_category(meta),JSON-OBJECT()) && (csb-json-unique(json-object-pairs(meta),list()) && (csb-typed(meta,list("schema","sourceUrl","sourceSha256","selectionLaw","wiktionaryApi","rightsText","rightsUrl"),2) && csb-typed(meta,list("sourceStartRank","inspectedCandidates","selected"),1)))));
   csb-check(state,"metadata-identity",(((String) csb-str(meta,"schema") == "coherence-kernel.substantive-concept-repair.v1") && (((Comparable) csb-num(meta,"sourceStartRank") == 10001) && (((Comparable) csb-num(meta,"selected") == 111) && (csb-num(meta,"inspectedCandidates") >= 111)))));
   csb-meta-bind(state,meta,list(list("sourceUrl","frequency_source_url"),list("sourceSha256","frequency_source_sha256"),list("selectionLaw","selection_law"),list("wiktionaryApi","wiktionary_api"),list("rightsText","wiktionary_rights"),list("rightsUrl","wiktionary_rights_url")));
   csb-check(state,"metadata-candidate-count",((String) int_to_str(csb-num(meta,"inspectedCandidates")) == csb-header(state,"inspected_ranked_candidates")));
   let provenance = csa-file(state,"model/concept-10000-data.fk");
   csb-check(state,"frequency-source-anchor",((String) csb-str(meta,"sourceSha256") == csb-source-line(state,provenance,"; Upstream full source SHA-256:\n;   ")));
   csb-check(state,"frequency-commit-anchor",((String) csb-header(state,"frequency_source_commit") == csb-source-line(state,provenance,"; Commit: ")));
   csb-check(state,"frequency-url-commit",(str_find(csb-str(meta,"sourceUrl"),str_concat("/",str_concat(csb-header(state,"frequency_source_commit"),"/")),0) >= 0));
   record_set(state,"metadata",meta);
   meta;
  }
  def csb-source-line(state,text,marker) {
   let start = str_find(text,marker,0);
   csb-check(state,"provenance-anchor-unique",((start >= 0) && (str_find(text,marker,(start + 1)) < 0)));
   let from = (start + str_len(marker)); let end = str_find(text,"\n",from);
   csb-check(state,"provenance-anchor-complete",(end > from));
   substring(text,from,end);
  }
  def csb-meta-bind(state,meta,bindings) = if nil?(bindings) then 1 else csb-meta-next(state,meta,head(bindings),tail(bindings));
  def csb-meta-next(state,meta,binding,rest) {
   csb-check(state,"metadata-manifest-provenance",((String) csb-str(meta,head(binding)) == csb-header(state,nth(binding,1))));
   csb-meta-bind(state,meta,rest);
  }
  def csb-candidate(text,at,priorLetter) = if (at >= str_len(text)) then ((at > 0) && priorLetter) else if ((str_byte_at(text,at) >= 97) && (str_byte_at(text,at) <= 122)) then csb-candidate(text,(at + 1),1) else if (((Comparable) str_byte_at(text,at) == 45) && priorLetter) then csb-candidate(text,(at + 1),0) else 0;
  def csb-evidence(state,lines,holes,slot,previousRank,rows) {
   if nil?(lines) then if nil?(holes) then reverse(rows) else csb-check(state,"defect-cardinality",0) else if nil?(holes) then csb-check(state,"evidence-cardinality",0) else csb-evidence-row(state,csb-json(state,head(lines)),csa-fields(head(holes)),tail(lines),tail(holes),slot,previousRank,rows);
  }
  def csb-evidence-row(state,row,hole,rest,holes,slot,previousRank,rows) {
   csb-check(state,"evidence-field-types",(csb-typed(row,list("id","sourceRank","frequency","pageId","revisionId"),1) && csb-typed(row,list("legacyLabel","canonicalLabel","timestamp","englishSha256","section","definition"),2)));
   let id = csb-num(row,"id"); let rank = csb-num(row,"sourceRank"); let label = csb-str(row,"canonicalLabel");
   csb-check(state,"evidence-defect-binding",(((id >= 0) && (id < 10000)) && (csa-digits(head(hole),0) && (((Comparable) id == str_to_int(head(hole))) && ((String) csb-str(row,"legacyLabel") == nth(hole,1))))));
   csb-check(state,"evidence-provenance",((rank > previousRank) && ((csb-num(row,"frequency") > 0) && ((csb-num(row,"pageId") > 0) && ((csb-num(row,"revisionId") > 0) && (((Comparable) str_len(csb-str(row,"timestamp")) == 20) && (((Comparable) str_len(csb-str(row,"englishSha256")) == 64) && (cmm-hex?(csb-str(row,"englishSha256"),0) && ((str_len(csb-str(row,"section")) > 0) && (str_len(csb-str(row,"definition")) > 0))))))))));
   csb-check(state,"candidate-label",((str_len(label) <= 20) && csb-candidate(label,0,0)));
   csb-check(state,"evidence-unique",(csa-unique(state,"evidence-id:",int_to_str(id)) && (csa-unique(state,"evidence-label:",label) && csa-unique(state,"evidence-old:",csb-str(row,"legacyLabel")))));
   let overlay = record_get(state,str_concat("overlay:",int_to_str(id)));
   csb-check(state,"translation-revision-binding",(csa-overlay?(overlay) && (((Comparable) head(overlay) == slot) && (((String) nth(nth(overlay,1),1) == csb-cat(list("wiktionary:",int_to_str(csb-num(row,"pageId")),":",int_to_str(csb-num(row,"revisionId"))))) && ((String) nth(nth(overlay,1),2) == label)))));
   record_set(state,str_concat("repair:",int_to_str(id)),row);
   csb-evidence(state,rest,holes,(slot + 1),rank,cons(row,rows));
  }
  def csb-ranked-rows(state,bytes,id,rows,bins) {
   if ((Comparable) id == 10000) then list(reverse(rows),fbc-finish(bins,"")) else csb-ranked-row(state,bytes,id,rows,bins,record_get(state,str_concat("repair:",int_to_str(id))));
  }
  def csb-ranked-row(state,bytes,id,rows,bins,repair) {
   let at = (id * 30); let original = csa-label(substring(bytes,at,(at + 20))); let frequencyText = substring(bytes,(at + 21),(at + 29));
   if (!(csa-digits(frequencyText,0) && (((Comparable) str_byte_at(bytes,(at + 20)) == 124) && ((Comparable) str_byte_at(bytes,(at + 29)) == 59)))) then csb-check(state,"ranked-source-record",0) else 0;
   let present = node_eq(node_category(repair),JSON-OBJECT());
   let label = if present then csb-str(repair,"canonicalLabel") else original;
   let frequency = if present then csb-num(repair,"frequency") else str_to_int(frequencyText);
   if (!csa-unique(state,"canonical-label:",label)) then csb-check(state,"canonical-label-unique",0) else 0;
   let rendered = csb-cat(list(csb-fixed(state,label,20),"|",csb-decimal(state,frequency,8),";"));
   csb-ranked-rows(state,bytes,(id + 1),cons(list(label,id,frequency),rows),fbc-put(bins,rendered));
  }
  def csb-sort(rows) = if (len(rows) <= 1) then rows else csb-merge(csb-sort(take((len(rows) / 2),rows)),csb-sort(drop((len(rows) / 2),rows)),list());
  def csb-merge(left,right,rows) = if nil?(left) then append(reverse(rows),right) else if nil?(right) then append(reverse(rows),left) else if csa-byte-less(head(head(left)),head(head(right)),0) then csb-merge(tail(left),right,cons(head(left),rows)) else csb-merge(left,tail(right),cons(head(right),rows));
  def csb-index(state,rows,bins) = if nil?(rows) then fbc-finish(bins,"") else csb-index(state,tail(rows),fbc-put(bins,csb-cat(list(csb-fixed(state,head(head(rows)),20),"|",csb-decimal(state,nth(head(rows),1),4),";"))));
  def csb-aliases(rows) = if nil?(rows) then list() else cons(list(csb-str(head(rows),"legacyLabel"),csb-num(head(rows),"id")),csb-aliases(tail(rows)));
  def csb-payload(state,row) = csb-cat(list(csb-decimal(state,csb-num(row,"pageId"),10),csb-decimal(state,csb-num(row,"revisionId"),10),csb-fixed(state,csb-str(row,"timestamp"),20),csb-str(row,"englishSha256"),csb-length(state,"exact",2),csb-length(state,csb-str(row,"canonicalLabel"),2),csb-length(state,"accepted-substantive-repair",2),csb-length(state,csb-str(row,"section"),2),csb-length(state,csb-str(row,"definition"),5),"001",csb-length(state,"stable-id-repair",2)));
  def csb-semantic(state,id,offset,index,payload) = if ((Comparable) id == 10000) then list(fbc-finish(index,""),fbc-finish(payload,"")) else csb-semantic-row(state,id,offset,index,payload,record_get(state,str_concat("repair:",int_to_str(id))));
  def csb-semantic-row(state,id,offset,index,payload,row) {
   if (!node_eq(node_category(row),JSON-OBJECT())) then csb-semantic(state,(id + 1),offset,fbc-put(index,csb-repeat("0",15)),payload) else csb-semantic-value(state,id,offset,index,payload,csb-payload(state,row));
  }
  def csb-semantic-value(state,id,offset,index,payload,encoded) = csb-semantic(state,(id + 1),(offset + str_len(encoded)),fbc-put(index,csb-cat(list("11",csb-decimal(state,offset,8),csb-decimal(state,str_len(encoded),5)))),fbc-put(payload,encoded));
  def csb-migration-header() = "stable_id\tlegacy_alias\tcanonical_label\tupstream_rank\tfrequency\twiktionary_page\twiktionary_revision\ttimestamp\tsection\tenglish_section_sha256\tdefinition\n";
  def csb-migrations(rows,bins) = if nil?(rows) then fbc-finish(bins,"") else csb-migrations(tail(rows),fbc-put(bins,csb-migration-row(head(rows))));
  def csb-migration-row(row) = str_concat(csa-join(list(int_to_str(csb-num(row,"id")),csb-str(row,"legacyLabel"),csb-str(row,"canonicalLabel"),int_to_str(csb-num(row,"sourceRank")),int_to_str(csb-num(row,"frequency")),int_to_str(csb-num(row,"pageId")),int_to_str(csb-num(row,"revisionId")),csb-str(row,"timestamp"),csb-str(row,"section"),csb-str(row,"englishSha256"),csb-clean(csb-str(row,"definition"),0,0,list())),"\t"),"\n");
  def csb-values(rows,key) = if nil?(rows) then list() else cons(int_to_str(csb-num(head(rows),key)),csb-values(tail(rows),key));
  def csb-cases(rows,rank) = if nil?(rows) then if rank then "current-rank" else "0" else csb-cat(list("(if (eq id ",int_to_str(csb-num(head(rows),"id")),") ",if rank then int_to_str(csb-num(head(rows),"sourceRank")) else "1"," ",csb-cases(tail(rows),rank),")"));
  def csb-data-form(rows) = csb-cat(list("; concept-10000-substantive-repair-data.fk — stable-ID repair carriers.\n; Generated from revision-pinned frequency and Wiktionary evidence; do not hand edit.\n; preludes: form/form-stdlib/core.fk\n(do\n  (defn csr111-count () 111)\n  (defn csr111-alias-index-path () \"",csb-path("-alias-index.dat"),"\")\n  (defn csr111-semantic-index-path () \"",csb-path("-semantic-index.dat"),"\")\n  (defn csr111-semantic-payload-path () \"",csb-path("-semantic-payload.dat"),"\")\n  (defn csr111-migration-path () \"",csb-path("-migration.tsv"),"\")\n  (defn csr111-evidence-path () \"",csb-path("-evidence.jsonl"),"\")\n  (defn csr111-ids () (list ",csa-join(csb-values(rows,"id")," "),"))\n  (defn csr111-source-ranks () (list ",csa-join(csb-values(rows,"sourceRank")," "),"))\n  ; Constant decision ladders avoid list allocation on ordinary lookup.\n  (defn csr111-effective-rank (id current-rank) ",csb-cases(rows,1),")\n  (defn csr111-repaired-id? (id) ",csb-cases(rows,0),")\n  0)\n"));
  def csb-offsets(bytes,at,values) = if (at >= str_len(bytes)) then reverse(values) else csb-offsets(bytes,(at + 1),if ((Comparable) str_byte_at(bytes,at) == 10) then cons(int_to_str((at + 1)),values) else values);
  def csb-nl-form(state,bytes) {
   let offsets = csb-offsets(bytes,0,list("0"));
   csb-check(state,"overlay-offsets",(((Comparable) len(offsets) == 112) && ((String) head(reverse(offsets)) == int_to_str(str_len(bytes)))));
   csb-cat(list("; concept-10000-substantive-repair-111-nl-data.fk — generated 111 x 13 overlay.\n; English is frequency source F; twelve translations are attributed Google carrier G, unreviewed.\n; preludes: form/form-stdlib/core.fk\n(do\n  (defn csr111-nl-data-path () \"",csb-nl(".tsv"),"\")\n  (defn csr111-nl-sources-path () \"",csb-nl("-sources.dat"),"\")\n  (defn csr111-nl-offsets () (list ",csa-join(offsets," "),"))\n  0)\n"));
  }
  def csb-find-output(outputs,path) = if nil?(outputs) then nothing() else if ((String) head(head(outputs)) == path) then nth(head(outputs),1) else csb-find-output(tail(outputs),path);
  def csb-manifest(state,outputs,paths,bins) = if nil?(paths) then fbc-finish(bins,"") else csb-manifest-file(state,outputs,head(paths),tail(paths),bins);
  def csb-manifest-file(state,outputs,path,rest,bins) {
   let prepared = csb-find-output(outputs,path); let bytes = if nothing?(prepared) then csa-file(state,path) else prepared;
   csb-manifest(state,outputs,rest,fbc-put(bins,csb-cat(list(path,"\t",int_to_str(str_len(bytes)),"\t",csa-hash(state,bytes),"\n"))));
  }
  def csb-manifest-head(state) {
   let meta = record_get(state,"metadata");
   let lines = list("schema=coherence-kernel.substantive-concept-repair-manifest.v1",str_concat("frequency_source_url=",csb-str(meta,"sourceUrl")),str_concat("frequency_source_sha256=",csb-str(meta,"sourceSha256")),str_concat("frequency_source_commit=",csb-header(state,"frequency_source_commit")),str_concat("wiktionary_api=",csb-str(meta,"wiktionaryApi")),str_concat("wiktionary_rights=",csb-str(meta,"rightsText")),str_concat("wiktionary_rights_url=",csb-str(meta,"rightsUrl")),str_concat("translation_endpoint=",csb-header(state,"translation_endpoint")),"translation_state=machine-translated-unreviewed",str_concat("selection_law=",csb-str(meta,"selectionLaw")),str_concat("inspected_ranked_candidates=",int_to_str(csb-num(meta,"inspectedCandidates"))),"stable_ids_repaired=111","legacy_aliases=111","semantic_definitions=111","nl_cells=1443","nl_frequency_cells=111","nl_machine_unreviewed_cells=1332");
   let text = str_concat(csa-join(lines,"\n"),"\n");
   csb-check(state,"complete-recorded-manifest-header",((String) text == str_concat(csa-join(take(17,csa-lines(csa-file(state,csb-path("-source-manifest.txt")))),"\n"),"\n")));
   text;
  }
  def csb-prepare(root,engine) {
   let input = cmm-state(csb-root(root),engine);
   csb-check(input,"hash-policy",(((String) engine == "form-sha256") || ((String) engine == "arm64-sha256")));
   csb-manifest-admit(input,drop(17,csa-lines(csa-file(input,csb-path("-source-manifest.txt")))),csb-manifest-files());
   csa-primary(input);
   csb-check(input,"manifest-headers",((Comparable) csb-headers(input,take(17,csa-lines(csa-file(input,csb-path("-source-manifest.txt")))),0) == 17));
   let evidence = csa-lines(csa-file(input,csb-path("-evidence.jsonl")));
   let holes = csa-lines(csa-file(input,csb-holes()));
   csb-check(input,"evidence-and-defect-shapes",(((Comparable) len(evidence) == 112) && (((Comparable) len(holes) == 112) && ((String) head(holes) == "id\tanchor\tmorphology_status\tlookup\tsource_status"))));
   let meta = csb-meta(input,csb-json(input,head(evidence)));
   let rows = csb-evidence(input,tail(evidence),tail(holes),0,10000,list());
   let ranked = csb-ranked-rows(input,csa-file(input,csb-ranked()),0,list(),list());
   let semantic = csb-semantic(input,0,0,list(),list());
   let outputs = list(cmm-output(csb-ranked(),nth(ranked,1)),cmm-output(csb-lexical(),csb-index(input,csb-sort(head(ranked)),list())),cmm-output(csb-path("-alias-index.dat"),csb-index(input,csb-sort(csb-aliases(rows)),list())),cmm-output(csb-path("-semantic-index.dat"),head(semantic)),cmm-output(csb-path("-semantic-payload.dat"),nth(semantic,1)),cmm-output(csb-path("-migration.tsv"),csb-migrations(rows,fbc-put(list(),csb-migration-header()))),cmm-output(csb-path("-data.fk"),csb-data-form(rows)),cmm-output(csb-nl("-data.fk"),csb-nl-form(input,csa-file(input,csb-nl(".tsv")))));
   let manifest = csb-manifest(input,outputs,csb-manifest-files(),fbc-put(list(),csb-manifest-head(input)));
   let prepared = record_new(0,"input",input,"outputs",append(outputs,list(cmm-output(csb-path("-source-manifest.txt"),manifest))));
   cmm-validate(prepared);
   cmm-freeze(prepared);
   prepared;
  }
  def csb-publish(prepared) {
   cmm-freeze(prepared);
   let input = record_get(prepared,"input");
   let outputs = record_get(prepared,"outputs");
   let suffix = str_concat(".stage-",str_concat(int_to_str(host_pid()),str_concat("-",int_to_str(host_monotonic_ms()))));
   let stages = cmm-stages(input,outputs,suffix);
