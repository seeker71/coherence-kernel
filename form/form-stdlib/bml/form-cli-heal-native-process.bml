  }
  def fhn-care-needs(needs,span,settled) = nil?(needs) ? list() : settled && (((String) oh-str(head(needs),"resource") == "diagnostic-evidence") && node_eq(oh-get(head(needs),"detail"),span)) ? fhn-care-needs(tail(needs),span,settled) : cons(head(needs),fhn-care-needs(tail(needs),span,settled));
