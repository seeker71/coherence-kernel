// Form supervises native argv children, streams and correlated choices.
// The child is begun by the host_spawn_at door itself: the argv, its three streams (files this organ owns) and its directory are the
// whole of what a launch script used to say. Its exit comes from host_wait, its lineage from the process table (host_processes names
// the fkwu kernels and answers each one's parent) and its signals go to each process by number (host_signal): no shell, no ps, no kill.
import form-stdlib/bml/form-cli-heal-native-io.bml;
import form-stdlib/bml/host-child.bml;
import form-stdlib/bml/spawn-guard.bml;
import form-stdlib/bml/retry.bml;
import form-stdlib/bml/form-cli-heal-dynamic.bml;
import form-stdlib/bml/form-cli-heal-timing.bml;
import form-stdlib/organ-health.bml;
import form-stdlib/organ-care.bml;
import form-stdlib/bml/organ-health-discovery.bml;
import form-stdlib/bml/fkwu-binding-care.bml;
import form-stdlib/hearth.bml;
section [form.bml] {
 class FormCliHealNativeProcess {
  def fhn-stage-path(job, stage, suffix) = fhn-at(job, (String) stage + suffix);
  def fhn-id-char(b) = ((b >= 48) && (b <= 57)) || (((b >= 65) && (b <= 90)) || (((b >= 97) && (b <= 122)) || ((Comparable) b == 45)));
  def fhn-id-go(s, i) = i >= len(s) ? 1 : (fhn-id-char(str_byte_at(s, i)) && fhn-id-go(s, i + 1));
  def fhn-id(s) = (len(s) > 0) && ((len(s) <= 128) && fhn-id-go(s, 0));
  def fhn-stage-event(job, stage, phase, elapsed, extra) {
   let origin = str_to_int(fhn-read(fhn-stage-path(job,stage,".clock")));
   let recorded = origin > 0 ? (host_monotonic_ms() - origin) : elapsed;
   let health = oh-extract(json-node-object(extra));
   let frame = oh-valid(health) ? oh-frame(health) : 0;
   fhn-json-line(fhn-stage-path(job, stage, ".events.jsonl"), append([fhn-s("phase", phase), fhn-n("elapsed_ms", recorded),fhn-n("sample_elapsed_ms",elapsed)], extra));
  }
  def fhn-choice(job, stage, id, state, offered, selected, reason, result) {
   let saved = fhn-json-line(fhn-at(job, "choices.jsonl"), [fhn-s("stage", stage), fhn-s("id", id), fhn-s("state", state), fhn-a("offered", fhn-strings(offered)), fhn-s("selected", selected), fhn-s("reason", reason), fhn-s("result", result), fhn-n("stamp_ms", now_unix_ms()), fhn-s("actor", "form-policy")]);
   (String) saved == "appended" ? "recorded" : saved;
  }
  def fhn-json-rows(lines) = nil?(lines) ? [] : (String) lines[0] == "" ? fhn-json-rows(lines[1:]) : cons(parse-json("retained-metadata", lines[0]), fhn-json-rows(lines[1:]));
  // ---- the process, read from the host
  def fhn-alive(pid) = (Comparable) host_alive(pid) == 1;
  // when a process began (host_process: pid ppid exe cwd argv start-ms withheld): a pid that comes back to a different process
  // has another start, so a recorded member is signalled only while the process at its pid is still the one that was seen
  def fhn-start-of(pid) {
   let row = host_process(pid);
   (String) value_kind(row) == "list" && (Comparable) len(row) > 5 && (String) value_kind(row[5]) == "int" ? row[5] : 0;
  }
  def fhn-entry(pid) = [pid, fhn-start-of(pid)];
  def fhn-entry-live?(entry) = fhn-alive(entry[0]) && (Comparable) fhn-start-of(entry[0]) == entry[1];
  // the child and every descendant that is an fkwu kernel (host_processes names kernels by prefix and answers each one's parent):
  // deepest first, the child last. A descendant that is not an fkwu kernel is not found. The lineage is read before any signal,
  // because a stopped parent's children are no longer found through it.
  def fhn-child-tree(pid) = pid <= 0 ? [] : reverse(hch-lineage(pid));
  def fhn-entries-of(pid) = pid <= 0 || !fhn-alive(pid) ? [] : fhn-child-tree(pid) |> map(id => fhn-entry(id));
  // what a stage has been seen to own, kept in a file beside its streams while its child lives, so a child that ends and leaves
  // a descendant behind does not hide the descendant
  def fhn-members-path(job, stage) = fhn-stage-path(job, stage, ".members");
  def fhn-entry-line(entry) = entry[0].str() + " " + entry[1].str() + "\n";
  def fhn-entry-parse(parts) = (Comparable) len(parts) == 2 ? [[str_to_int(parts[0]), str_to_int(parts[1])]] : [];
  def fhn-entries-read(text) = foldl((acc, line) => append(acc, fhn-entry-parse(split-on(line, " "))), [], filter(line => len(line) > 0, split-on(text, "\n")));
  def fhn-entry-in?(entries, pid) = nil?(entries) ? false : (Comparable) entries[0][0] == pid ? true : fhn-entry-in?(entries[1:], pid);
  def fhn-entries-union(known, more) = nil?(more) ? known : fhn-entry-in?(known, more[0][0]) ? fhn-entries-union(known, more[1:]) : fhn-entries-union(append(known, [more[0]]), more[1:]);
  def fhn-note-members(job, stage, pid) {
   let known = fhn-entries-read(fhn-read(fhn-members-path(job, stage)));
   write_file(fhn-members-path(job, stage), str-spans(fhn-entries-union(known, fhn-entries-of(pid)) |> map(entry => fhn-entry-line(entry))));
  }
  // the members that still live: the lineage now and the lineage last noted, each checked against its start
  def fhn-live-members(job, stage, pid) = pid <= 0 ? [] : filter(entry => fhn-entry-live?(entry), fhn-entries-union(fhn-entries-read(fhn-read(fhn-members-path(job, stage))), fhn-entries-of(pid)));
  def fhn-group-members(job, stage, pid) = fh-trim(str-spans(fhn-live-members(job, stage, pid) |> map(entry => entry[0].str() + "\n")));
  def fhn-group-empty(job, stage, pid) = (pid <= 0) || nil?(fhn-live-members(job, stage, pid));
  // ---- signals, by the host's own numbers (STOP and CONT differ between Darwin and Linux)
  def fhn-signal-numbers(os) = (String) os == "Darwin" ? [["HUP", 1], ["INT", 2], ["QUIT", 3], ["KILL", 9], ["TERM", 15], ["STOP", 17], ["CONT", 19]] : [["HUP", 1], ["INT", 2], ["QUIT", 3], ["KILL", 9], ["TERM", 15], ["STOP", 19], ["CONT", 18]];
  def fhn-signal-lookup(rows, name) = nil?(rows) ? 0 : (String) rows[0][0] == name ? rows[0][1] : fhn-signal-lookup(rows[1:], name);
  def fhn-signal-number(name) = fhn-signal-lookup(fhn-signal-numbers(host_os() ?? ""), name);
  // 0 when the host took the signal, 1 when it refused (a name this table does not know is refused by the door: number 0)
  def fhn-send(pid, signal) = (Comparable) host_signal(pid, fhn-signal-number(signal)) < 0 ? 1 : 0;
  def fhn-signal-descendants(job, stage, ids, signal, started) = nil?(ids) ? 0 : fhn-signal-descendant(job, stage, ids[0], ids[1:], signal, started);
  def fhn-signal-descendant(job, stage, pid, rest, signal, started) {
   let status = fhn-alive(pid) ? fhn-send(pid, signal) : 0;
   let observed = fhn-stage-event(job, stage, "process-descendant-signal", host_monotonic_ms() - started, [fhn-n("pid", pid), fhn-s("signal", signal), fhn-n("signal_status", status), fhn-s("ownership_basis", "observed-parent-chain-before-termination")]);
   status + fhn-signal-descendants(job, stage, rest, signal, started);
  }
  def fhn-signal-all(entries, signal) = nil?(entries) ? 0 : fhn-send(entries[0][0], signal) + fhn-signal-all(entries[1:], signal);
  // every member the stage still owns, one signal each: the count the host refused
  def fhn-signal(job, stage, pid, signal, started) {
   let status = fhn-signal-all(fhn-live-members(job, stage, pid), signal);
   let recorded = fhn-stage-event(job, stage, "process-signal-observed", host_monotonic_ms() - started, [fhn-s("signal", signal), fhn-n("signal_status", status), fhn-n("group", pid)]);
   status;
  }
  // ---- begin the child: argv, its three streams, and (when it is not the body root) the directory it begins in
  // A host_spawn_at that ignores the directory element would run the child in the wrong place without a word, so a directory
  // that is not the working directory is asked of the door first: a spawn into a directory that cannot exist answers -4 from a
  // seed that carries the element, and begins the seed itself (which ends at once, and is waited for) from one that does not.
  // (the body's seed is ./fkwu in the working directory, as every child this organ begins is)
  def fhn-cwd-door?() = fhn-cwd-probe(sg-spawn-at(["./fkwu"], ["/dev/null", "/dev/null", "/dev/null", "/nonexistent/heal-native-cwd-probe"]));
  def fhn-cwd-probe(pid) = nothing?(pid) ? 0 : (Comparable) pid == -4 ? 1 : fhn-cwd-reap(pid);
  def fhn-cwd-reap(pid) {
   let waited = (Comparable) pid > 0 ? host_wait(pid) : 0;
   0;
  }
  def fhn-spawn(job, stage, cwd, input, argv) {
   let streams = [(String) input == "-" ? "/dev/null" : input, fhn-stage-path(job, stage, ".out"), fhn-stage-path(job, stage, ".err")];
   (String) cwd == host_cwd() ? sg-spawn-at(argv, streams) : fhn-cwd-door?() ? sg-spawn-at(argv, append(streams, [cwd])) : -4;
  }
  // the child's exit as the host reports it (a signal death reads 128 + the signal), kept beside its streams; "" while it lives
  def fhn-reap(job, stage, pid) {
   let known = fhn-read(fhn-stage-path(job, stage, ".raw-status"));
   (String) known != "" ? known : fhn-reap-wait(job, stage, pid);
  }
  def fhn-reap-wait(job, stage, pid) {
   let status = fhn-alive(pid) ? -2 : host_wait(pid);
   let noted = (Comparable) status >= 0 ? write_file(fhn-stage-path(job, stage, ".raw-status"), status.str()) : 0;
   (Comparable) status >= 0 ? status.str() : "";
  }
  def fhn-field(parts, prefix) = nil?(parts) ? "" : (Comparable) str_find(parts[0], prefix, 0) == 0 ? substring(parts[0], len(prefix), len(parts[0])) : fhn-field(parts[1:], prefix);
  def fhn-observe-stage(job, stage, line, elapsed) {
   let parts = split-on(line, " ");
   let phase = fhn-field(parts, "phase=");
   let route = fhn-field(parts, "route=");
   let state = fhn-field(parts, "status=");
   fhn-id(phase) && (fhn-id(route) && (fhn-id(state) && ((Comparable) len(parts) == 6))) ? fhn-stage-event(job, stage, phase, elapsed, [fhn-s("route", route), fhn-s("state", state), fhn-s("child_stamp_ms", fhn-field(parts, "stamp-ms="))]) : "";
  }
  // Runtime counters and epoch milliseconds use the full native integer lane.
  // Command-duration text has a separate, narrower grammar in fsuf-uint?.
  def fhn-flow-uint(node) = ((Comparable) node_type(node) == 1) && (((String) value_kind(node_value(node)) == "int") && (node_value(node) >= 0));
  def fhn-flow-fields(doc, names, numeric) = nil?(names) ? 1 : (json-object-has?(doc, names[0]) && ((numeric ? fhn-flow-uint(json-object-get(doc, names[0])) : (((Comparable) str_byte_at(json-emit(json-object-get(doc, names[0])), 0) == 34) && (len(fhn-string(doc, names[0])) <= 4096))) && fhn-flow-fields(doc, names[1:], numeric)));
  def fhn-flow-valid(doc) = ((Comparable) len(json-object-keys(doc)) == 12) && (fhn-flow-fields(doc, ["phase", "route", "model", "model_path", "base_seal_sha256", "adapter_path", "adapter_sha256", "adapter_state"], 0) && fhn-flow-fields(doc, ["input_tokens", "output_tokens", "position", "stamp_ms"], 1));
  def fhn-observe-flow(job, stage, line, elapsed) {
   let doc = parse-json("native-token-flow", substring(line, 15, len(line)));
   fhn-flow-valid(doc) ? fhn-json-line(fhn-stage-path(job, stage, ".flow.jsonl"), append(json-object-pairs(doc), [fhn-n("elapsed_ms", elapsed)])) : fhn-record-health(job,stage,oh-reading("token-flow-reader",stage,"protocol",json-node-string("typed counters and route"),json-node-int(len(line)),json-node-int(0),[oh-need("source-diagnostics",oh-reference(fhn-stage-path(job,stage,".out")))],["request-evidence","defer"],oh-reference(fhn-stage-path(job,stage,".out"))),elapsed);
  }
  def fhn-observe-health(job,stage,line,elapsed) {
   let row = parse-json("organ-health",substring(line,18,len(line)));
   oh-valid(row) && oc-needs-valid(json-array-elements(oh-get(row,"needs"))) ? fhn-record-health(job,stage,row,elapsed) : fhn-record-health(job,stage,oh-reading("health-flow-reader",stage,"protocol",json-node-string("complete organ reading with declared needs"),json-node-int(len(line)),json-node-int(0),[oh-need("source-diagnostics",oh-reference(fhn-stage-path(job,stage,".out")))],["request-evidence","defer"],oh-reference(fhn-stage-path(job,stage,".out"))),elapsed);
  }
  def fhn-observe-line(job, stage, line, elapsed) = (Comparable) str_find(line,"form-organ health ",0) == 0 ? fhn-observe-health(job,stage,line,elapsed) : (Comparable) str_find(line, "form-peer stage ", 0) == 0 ? fhn-observe-stage(job, stage, line, elapsed) : (Comparable) str_find(line, "form-heal flow ", 0) == 0 ? fhn-observe-flow(job, stage, line, elapsed) : "";
  def fhn-observe-lines(job, stage, lines, elapsed) = nil?(lines) ? 0 : (((String) fhn-observe-line(job, stage, lines[0], elapsed) == "appended" ? 1 : 0) + fhn-observe-lines(job, stage, lines[1:], elapsed));
  // Byte availability is not severity, interpretation or semantic progress.
  // The shared observation owner supplies identity; the span names the bytes.
  def fhn-observe-diagnostics(job, stage, offset, bytes, elapsed) {
   let end = offset + bytes;
   let source = oh-reference(fhn-stage-path(job,stage,".err"));
   let span = json-node-object([fhn-s("stream","stderr"),fhn-s("interpretation","unknown"),fhn-n("offset",offset),fhn-n("end",end),fhn-n("new_bytes",bytes),json-node-pair("source",source)]);
   let reading = oh-reading("native-process",fhn-stage-path(job,stage,""),"diagnostic-availability",json-node-string("organ interpretation of retained diagnostics"),span,json-node-null(),[oh-need("diagnostic-evidence",span),oh-need("diagnostic-interpretation",span)],["request-evidence","defer"],source);
   fhn-record-health(job,stage,reading,elapsed);
  }
  // Reader state: byte offset plus an incomplete diagnostic line. The private
  // output is already durable; a long non-diagnostic line is never truncated.
  def fhn-drain(job, stage, suffix, reader, elapsed) {
   let path = fhn-stage-path(job, stage, suffix);
   let offset = reader[0];
   let remaining = file_size(path) - offset;
   remaining <= 0 ? [reader, 0] : fhn-drain-bytes(job, stage, suffix, reader, elapsed, read_file_slice(path, offset, fhd-min(65536, remaining)));
  }
  def fhn-drain-bytes(job, stage, suffix, reader, elapsed, chunk) {
   let available = ((String) suffix == ".err") && (((String) value_kind(chunk) == "string") && (len(chunk) > 0)) ? fhn-observe-diagnostics(job,stage,reader[0],len(chunk),elapsed) : "";
   let text = (String) reader[1] + chunk;
   let rows = split-on(text, "\n");
   let complete = reverse(reverse(rows)[1:]);
   let pending = reverse(rows)[0];
   let observed = fhn-observe-lines(job, stage, complete, elapsed);
   [[reader[0] + len(chunk), len(pending) > 65536 ? "" : pending], observed];
  }
  def fhn-process-record(job, stage, state, started, wall, seconds, program, pid, status, reason, cleanup) {
   let events = fhn-json-rows(split-on(fhn-read(fhn-stage-path(job, stage, ".events.jsonl")), "\n"));
   let row = json-node-object([fhn-s("version", "observed-process-v1"), fhn-s("state", state), fhn-s("program", program), fhn-n("pid", pid), fhn-n("status", status), fhn-n("elapsed_ms", host_monotonic_ms() - started), fhn-n("started_unix_ms", wall), fhn-n("ended_unix_ms", now_unix_ms()), fhn-n("budget_ms", seconds * 1000), fhn-s("reason", reason), fhn-s("supervision", (Comparable) seconds == 0 ? "dynamic-progress" : "explicit-deadline"), fhn-s("timing_basis", "parent-monotonic-observation-ms"), fhn-a("events", events), fhn-n("output_bytes", fhd-max(0, file_size(fhn-stage-path(job, stage, ".out"))) + fhd-max(0, file_size(fhn-stage-path(job, stage, ".err")))), json-node-pair("cleanup", cleanup)]);
   let actual = fhn-read(fhn-stage-path(job, stage, ".raw-status"));
   let timed = fhn-put(fhn-put(fhn-put(row, "started_monotonic_ms", json-node-int(started)), "returncode", (String) actual == "" ? json-node-null() : json-node-int(str_to_int(actual))), "ended_unix_ms", (String) state == "running" ? json-node-null() : json-node-int(now_unix_ms()));
   let bound = fhn-put(timed,"output_drains",json-node-object([json-node-pair("stdout",fhn-drain-reading(job,stage,".out")),json-node-pair("stderr",fhn-drain-reading(job,stage,".err"))]));
   fhn-write-json(fhn-stage-path(job, stage, ".process.json"), bound);
  }
  def fhn-run(job, stage, seconds, directory, input, argv) {
   let doc = fhn-json(fhn-at(job, "snapshot.json"));
   let cwd = (String) directory == "root" ? fhn-string(doc, "root") : fhn-at(job, directory);
   !(fhn-owned(job, doc) && (fhn-id(stage) && fhn-member(["root", "work", "empty"], directory))) ? "refused:process-contract" : fhn-run-start(job, stage, seconds, cwd, input, argv);
  }
  def fhn-discover-process(job,stage,elapsed) {
   let root = fhn-string(fhn-json(fhn-at(job,"snapshot.json")),"root");
   let source = fhn-stage-path(job,stage,".events.jsonl");
   let declaration = ohd-renew(root,source,["organ-health-v1","diagnostic-availability","process-exit","correlated-care"]);
   (Comparable) json-int-value(json-object-get(declaration,"ok")) == 1 ? declaration : fhn-discovery-refused(job,stage,elapsed,source,declaration);
  }
  def fhn-discovery-refused(job,stage,elapsed,source,declaration) {
   let reading = oh-reading("native-process",fhn-stage-path(job,stage,""),"event-discovery",json-node-string("advertised event stream"),declaration,json-node-int(0),[oh-need("event-source-discovery",declaration)],["request-evidence","defer"],oh-reference(source));
   let recorded = fhn-record-health(job,stage,reading,elapsed);
   declaration;
  }
  def fhn-run-start(job, stage, seconds, cwd, input, argv) {
   let started = host_monotonic_ms();
   let wall = now_unix_ms();
   let clock = write_file(fhn-stage-path(job,stage,".clock"),started.str());
   let place = write_file(fhn-stage-path(job,stage,".cwd"),cwd);
   let eventFile = write_file(fhn-stage-path(job, stage, ".events.jsonl"), "");
   let flowFile = write_file(fhn-stage-path(job, stage, ".flow.jsonl"), "");
   let clearedAttention = fs_remove(fhn-stage-path(job, stage, ".attention.json"));
   let clearedStatus = fs_remove(fhn-stage-path(job, stage, ".raw-status"));
   let clearedPid = fs_remove(fhn-stage-path(job, stage, ".pid"));
   let clearedAdmission = fs_remove(fhn-stage-path(job, stage, ".admitted"));
   let clearedMembers = fs_remove(fhn-members-path(job, stage));
   let clearedOut = write_file(fhn-stage-path(job, stage, ".out"), "");
   let clearedErr = write_file(fhn-stage-path(job, stage, ".err"), "");
   let privateStreams = host_chmod(fhn-stage-path(job, stage, ".out"), 384) + host_chmod(fhn-stage-path(job, stage, ".err"), 384);
   let discovery = fhn-discover-process(job,stage,host_monotonic_ms() - started);
   let metadata = fhn-write-json(fhn-stage-path(job, stage, ".argv.json"), json-node-array(fhn-strings(argv)));
   let entered = fhn-stage-event(job, stage, "process-spawn-begin", 0, []);
   let pid = fhn-spawn(job, stage, cwd, input, argv);
   let noted = nothing?(pid) || pid <= 0 ? 0 : write_file(fhn-stage-path(job, stage, ".pid"), pid.str());
   let running = fhn-process-record(job, stage, "running", started, wall, seconds, argv[0], pid, -1, "awaiting-child", json-node-object([fhn-s("state", "owned")]));
   nothing?(pid) || pid <= 0 ? "127" : fhn-run-loop(job, stage, seconds, started, wall, argv[0], pid, [0, ""], [0, ""], 0, 1000, 1000);
  }
  // the child is begun directly, so the process that is waited for and the process that runs the program are one
  def fhn-run-loop(job, stage, seconds, started, wall, program, child, outReader, errReader, last, gap, next) {
   let elapsed = host_monotonic_ms() - started;
   let out = fhn-drain(job, stage, ".out", outReader, elapsed);
   let err = fhn-drain(job, stage, ".err", errReader, elapsed);
   let moved = (out[1] + err[1]) > 0;
   let progress = moved ? elapsed : last;
   let interval = moved ? fhd-max(1, elapsed - last) : gap;
   let admitted = file_size(fhn-stage-path(job, stage, ".admitted")) < 0 ? fhn-process-admit(job, stage, seconds, started, wall, program, child) : 0;
   !fhn-alive(child) ? fhn-run-complete(job, stage, seconds, started, wall, program, child, str_to_int(fhn-reap(job, stage, child)), "completed", out[0], err[0]) : fhn-run-live(job, stage, seconds, started, wall, program, child, out[0], err[0], progress, interval, next);
  }
  def fhn-process-admit(job, stage, seconds, started, wall, program, child) {
   let recorded = fhn-stage-event(job, stage, "process-child-observed", host_monotonic_ms() - started, [fhn-n("pid", child), fhn-n("group", child), fhn-s("group_basis", "child-begun-directly")]);
   let saved = write_file(fhn-stage-path(job, stage, ".admitted"), child.str());
   fhn-process-record(job, stage, "running", started, wall, seconds, program, child, -1, "child-observed", json-node-object([fhn-s("state", "owned")]));
  }
  def fhn-run-live(job, stage, seconds, started, wall, program, child, outReader, errReader, last, gap, next) {
   let elapsed = host_monotonic_ms() - started;
   let stop = (String) fh-trim(fhn-read(fhn-stage-path(job, stage, ".control"))) == "stop";
   let timeout = (seconds > 0) && (elapsed >= (seconds * 1000));
   (child > 0) && (stop || timeout) ? fhn-run-stop(job, stage, seconds, started, wall, program, child, stop ? "cancelled" : "timeout", outReader, errReader) : fhn-run-continue(job, stage, seconds, started, wall, program, child, outReader, errReader, last, gap, next, elapsed);
  }
  def fhn-run-continue(job, stage, seconds, started, wall, program, child, outReader, errReader, last, gap, next, elapsed) {
   let due = ((Comparable) seconds == 0) && (elapsed >= next);
   let noted = fhn-note-members(job, stage, child);
   let action = due ? fhn-dynamic-choice(job, stage, child, elapsed, elapsed - last, gap) : "continue";
   let nextTime = due ? (elapsed + fhd-next(elapsed - last, gap)) : next;
   let pause = host_sleep_ms(50);
   (String) action == "control-error" ? fhn-run-stop(job, stage, seconds, started, wall, program, child, "control-error", outReader, errReader) : fhn-run-loop(job, stage, seconds, started, wall, program, child, outReader, errReader, last, gap, nextTime);
  }
  // what the host says of a process, as one line (the `inspect` sample): pid, parent, executable, directory, how long it has lived
  def fhn-process-sample(pid) {
