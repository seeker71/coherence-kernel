  def fhn-exit-observed(status,reason,actual) = ((String) reason == "supervisor-exited-without-child-status") && (fsuf-uint?(actual) && (str_to_int(actual) <= 255)) ? [str_to_int(actual),"completed"] : [status,reason];
  def fhn-release-learner-lock(job, child) {
