   if str_eq(saved, "appended") then "recorded" else saved;
  }
  def fhn-json-rows(lines) = if nil?(lines) then list() else if str_eq(head(lines), "") then fhn-json-rows(tail(lines)) else cons(parse-json("retained-metadata", head(lines)), fhn-json-rows(tail(lines)));
  def fhn-process-state(pid) = fhn-capture(list("/bin/ps", "-p", int_to_str(pid), "-o", "stat="));
  def fhn-alive(pid) {
   let state = fhn-process-state(pid);
   and(gt(str_len(state), 0), not(eq(str_byte_at(state, 0), 90)));
  }
  def fhn-group(pid) = str_to_int(fhn-capture(list("/bin/ps", "-p", int_to_str(pid), "-o", "pgid=")));
  def fhn-group-members(pid) = fhn-capture(list("/bin/ps", "-g", int_to_str(pid), "-o", "pid="));
  def fhn-group-empty(pid) = or(le(pid, 0), str_eq(fhn-group-members(pid), ""));
  def fhn-nonempty(xs) = if nil?(xs) then list() else if str_eq(fh-trim(head(xs)), "") then fhn-nonempty(tail(xs)) else cons(fh-trim(head(xs)), fhn-nonempty(tail(xs)));
  def fhn-process-tree-rows(lines) = if nil?(lines) then list() else cons(fhn-nonempty(split-on(head(lines), " ")), fhn-process-tree-rows(tail(lines)));
  def fhn-process-children(rows, pid) = if nil?(rows) then list() else if and(eq(len(head(rows)), 2), eq(str_to_int(nth(head(rows), 1)), pid)) then cons(str_to_int(head(head(rows))), fhn-process-children(tail(rows), pid)) else fhn-process-children(tail(rows), pid);
  def fhn-descendants(rows, pending, found) = if nil?(pending) then found else fhn-descendants(rows, append(tail(pending), fhn-process-children(rows, head(pending))), cons(head(pending), found));
  def fhn-child-tree(pid) = if le(pid, 0) then list() else fhn-descendants(fhn-process-tree-rows(split-on(fhn-capture(list("/bin/ps", "-e", "-o", "pid=,ppid=")), "\n")), list(pid), list());
  def fhn-signal-descendants(job, stage, ids, signal, started) = if nil?(ids) then 0 else fhn-signal-descendant(job, stage, head(ids), tail(ids), signal, started);
  def fhn-signal-descendant(job, stage, pid, rest, signal, started) {
   let status = if fhn-alive(pid) then fhn-command(list("/bin/kill", str_concat("-", signal), int_to_str(pid))) else 0;
   let observed = fhn-stage-event(job, stage, "process-descendant-signal", sub(host_monotonic_ms(), started), list(fhn-n("pid", pid), fhn-s("signal", signal), fhn-n("signal_status", status), fhn-s("ownership_basis", "observed-parent-chain-before-termination")));
   add(status, fhn-signal-descendants(job, stage, rest, signal, started));
