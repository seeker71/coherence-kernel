  // Runtime counters and epoch milliseconds use the full native integer lane.
  // Command-duration text has a separate, narrower grammar in fsuf-uint?.
  def fhn-flow-uint(node) = and(eq(node_type(node),1),and(str_eq(value_kind(node_value(node)),"int"),ge(node_value(node),0)));
  def fhn-flow-fields(doc, names, numeric) = if nil?(names) then 1 else and(json-object-has?(doc, head(names)), and(if numeric then fhn-flow-uint(json-object-get(doc, head(names))) else and(eq(str_byte_at(json-emit(json-object-get(doc, head(names))), 0), 34), le(str_len(fhn-string(doc, head(names))), 4096)), fhn-flow-fields(doc, tail(names), numeric)));
  def fhn-flow-valid(doc) = and(eq(len(json-object-keys(doc)),12),and(fhn-flow-fields(doc, list("phase", "route", "model", "model_path", "base_seal_sha256", "adapter_path", "adapter_sha256", "adapter_state"), 0), fhn-flow-fields(doc, list("input_tokens", "output_tokens", "position", "stamp_ms"), 1)));
  def fhn-observe-flow(job, stage, line, elapsed) {
   let doc = parse-json("native-token-flow", substring(line, 15, str_len(line)));
   if fhn-flow-valid(doc) then fhn-json-line(fhn-stage-path(job, stage, ".flow.jsonl"), append(json-object-pairs(doc), list(fhn-n("elapsed_ms", elapsed)))) else fhn-record-health(job,stage,oh-reading("token-flow-reader",stage,"protocol",json-node-string("typed counters and route"),json-node-int(str_len(line)),json-node-int(0),list(oh-need("source-diagnostics",oh-reference(fhn-stage-path(job,stage,".out")))),list("request-evidence","defer"),oh-reference(fhn-stage-path(job,stage,".out"))),elapsed);
  }
  def fhn-observe-health(job,stage,line,elapsed) {
   let row = parse-json("organ-health",substring(line,18,str_len(line)));
   if oh-valid(row) then fhn-record-health(job,stage,row,elapsed) else fhn-record-health(job,stage,oh-reading("health-flow-reader",stage,"protocol",json-node-string("complete organ reading"),json-node-int(str_len(line)),json-node-int(0),list(oh-need("source-diagnostics",oh-reference(fhn-stage-path(job,stage,".out")))),list("request-evidence","defer"),oh-reference(fhn-stage-path(job,stage,".out"))),elapsed);
  }
  def fhn-observe-line(job, stage, line, elapsed) = if eq(str_find(line,"form-organ health ",0),0) then fhn-observe-health(job,stage,line,elapsed) else if eq(str_find(line, "form-peer stage ", 0), 0) then fhn-observe-stage(job, stage, line, elapsed) else if eq(str_find(line, "form-heal flow ", 0), 0) then fhn-observe-flow(job, stage, line, elapsed) else if and(str_eq(fhn-read(fhn-stage-path(job, stage, ".format")), "ollama-ndjson"), eq(str_byte_at(line, 0), 123)) then fhn-observe-ollama(job, stage, line, elapsed) else "";
  def fhn-observe-ollama(job, stage, line, elapsed) {
   let doc = parse-json("ollama-response", line);
   let text = if eq(node_type(json-object-get(doc, "response")), 2) then fhn-string(doc, "response") else "";
   let appended = fhn-append(fhn-stage-path(job, stage, ".reply.partial"), text);
   let done = node_eq(json-object-get(doc, "done"), intern_trivial_bool(true));
   let state = if json-object-has?(doc, "error") then "error" else if done then "done" else "streaming";
   let signal = if json-object-has?(doc,"error") then fhn-record-health(job,stage,oh-reading("loopback-generation",stage,"provider-error",json-node-int(0),json-node-int(1),json-node-int(0),list(oh-need("provider-diagnostics",oh-reference(fhn-stage-path(job,stage,".out")))),list("request-evidence","defer"),oh-reference(fhn-stage-path(job,stage,".out"))),elapsed) else "";
   let saved = write_file(fhn-stage-path(job, stage, ".generation-status"), state);
   let counts = if and(done, and(eq(node_type(json-object-get(doc, "prompt_eval_count")), 1), eq(node_type(json-object-get(doc, "eval_count")), 1))) then list(fhn-n("input_tokens", fhn-number(doc, "prompt_eval_count")), fhn-n("output_tokens", fhn-number(doc, "eval_count"))) else list(fhn-s("token_count_state", "provider-has-not-reported-counts"));
   let flow = if done then fhn-json-line(fhn-stage-path(job, stage, ".flow.jsonl"), append(list(fhn-s("route", "ollama-loopback"), fhn-s("model", fhn-string(doc, "model")), fhn-s("model_path", "loopback-model-registry"), fhn-s("adapter_path", ""), fhn-s("adapter_state", "service-owned;no-caller-adapter-selected"), fhn-s("phase", state), fhn-n("elapsed_ms", elapsed)), counts)) else "";
   fhn-stage-event(job, stage, str_concat("ollama-", state), elapsed, append(list(fhn-n("response_bytes", file_size(fhn-stage-path(job, stage, ".reply.partial")))), counts));
  }
  def fhn-observe-lines(job, stage, lines, elapsed) = if nil?(lines) then 0 else add(if str_eq(fhn-observe-line(job, stage, head(lines), elapsed), "appended") then 1 else 0, fhn-observe-lines(job, stage, tail(lines), elapsed));
  // Reader state: byte offset plus an incomplete diagnostic line. The private
  // output is already durable; a long non-diagnostic line is never truncated.
  def fhn-drain(job, stage, suffix, reader, elapsed) {
   let path = fhn-stage-path(job, stage, suffix);
   let offset = head(reader);
   let remaining = sub(file_size(path), offset);
   if le(remaining, 0) then list(reader, 0) else fhn-drain-bytes(job, stage, suffix, reader, elapsed, read_file_slice(path, offset, fhd-min(65536, remaining)));
  }
  def fhn-drain-bytes(job, stage, suffix, reader, elapsed, chunk) {
   let text = str_concat(nth(reader, 1), chunk);
   let rows = split-on(text, "\n");
   let complete = reverse(tail(reverse(rows)));
   let pending = head(reverse(rows));
   let observed = fhn-observe-lines(job, stage, complete, elapsed);
   list(list(add(head(reader), str_len(chunk)), if gt(str_len(pending), 65536) then "" else pending), observed);
  }
  def fhn-process-record(job, stage, state, started, wall, seconds, program, pid, status, reason, cleanup) {
