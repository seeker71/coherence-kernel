// Form supervises native argv children, streams and correlated choices.
// The shell script only establishes cwd, file descriptors and a child group.
// preludes: form-stdlib/bml/form-cli-heal-native-io.bml form-stdlib/bml/form-cli-heal-dynamic.bml form-stdlib/bml/form-cli-heal-timing.bml form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliHealNativeProcess {
  def fhn-stage-path(job, stage, suffix) = fhn-at(job, str_concat(stage, suffix));
  def fhn-id-char(b) = or(and(ge(b, 48), le(b, 57)), or(and(ge(b, 65), le(b, 90)), or(and(ge(b, 97), le(b, 122)), eq(b, 45))));
  def fhn-id-go(s, i) = if ge(i, str_len(s)) then 1 else and(fhn-id-char(str_byte_at(s, i)), fhn-id-go(s, add(i, 1)));
  def fhn-id(s) = and(gt(str_len(s), 0), and(le(str_len(s), 128), fhn-id-go(s, 0)));
  def fhn-stage-event(job, stage, phase, elapsed, extra) {
   let origin = str_to_int(fhn-read(fhn-stage-path(job,stage,".clock")));
   let recorded = if gt(origin,0) then sub(host_monotonic_ms(),origin) else elapsed;
   let health = oh-extract(json-node-object(extra));
   let frame = if oh-valid(health) then oh-frame(health) else 0;
