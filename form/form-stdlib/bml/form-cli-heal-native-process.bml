   let actual = fhn-read(fhn-stage-path(job, stage, ".raw-status"));
   let reconciled = fhn-exit-observed(status,reason,actual);
   let finalStatus = if groupReleased then head(reconciled) else 125;
   let reaped = fhn-stage-event(job, stage, "process-reaped", sub(host_monotonic_ms(), started), list(fhn-s("child_wait_status", actual), fhn-n("wrapper_status", waited)));
   let cleanup = json-node-object(list(fhn-s("state", if groupReleased then "released" else "members-remain"), fhn-s("group_members", fhn-group-members(child)), fhn-s("child_wait_status", actual)));
   let observed = fhn-stage-event(job, stage, "process-cleanup-observed", sub(host_monotonic_ms(), started), list(json-node-pair("cleanup", cleanup)));
   let ended = fhn-stage-event(job,stage,"organ-health",sub(host_monotonic_ms(),started),list(json-node-pair("health",oh-reading("process-progress",fhn-stage-path(job,stage,""),"cadence",json-node-string("work-settled"),json-node-string(if groupReleased then "work-settled" else "release-pending"),if groupReleased then json-node-null() else json-node-int(0),if groupReleased then list() else list(oh-need("owned-process-release",cleanup)),list("request-evidence","defer"),cleanup))));
   let health = fhn-record-health(job,stage,oh-reading("native-process",stage,"exit",json-node-int(0),json-node-int(finalStatus),json-node-int(eq(finalStatus,0)),if eq(finalStatus,0) then list() else list(oh-need(if str_eq(reason,"timeout") then "stage-timing" else if str_eq(reason,"cancelled") then "caller-direction" else "source-diagnostics",json-node-string(reason))),list("request-evidence","defer"),json-node-object(list(json-node-pair("stdout",oh-reference(fhn-stage-path(job,stage,".out"))),json-node-pair("stderr",oh-reference(fhn-stage-path(job,stage,".err")))))),sub(host_monotonic_ms(),started));
   let saved = fhn-process-record(job, stage, if groupReleased then "finished" else "release-pending", started, wall, seconds, program, child, finalStatus, if groupReleased then nth(reconciled,1) else "cleanup-incomplete", cleanup);
   let result = write_file(fhn-stage-path(job, stage, ".status"), int_to_str(finalStatus));
   let learnerLock = if groupReleased then fhn-release-learner-lock(job, child) else 0;
   int_to_str(finalStatus);
  }
  def fhn-record-health(job,stage,row,elapsed) {
   let recorded = fhn-stage-event(job,stage,"organ-health",elapsed,list(json-node-pair("health",row)));
   if and(oh-pain(row),str_eq(oh-str(row,"stage"),"observe")) then fhn-care-health(job,stage,row,elapsed) else recorded;
  }
  def fhn-care-health(job,stage,row,elapsed) {
   let offers = oh-values(json-array-elements(oh-get(row,"offers")));
   let response = oh-response(row,if oh-has(offers,"request-evidence") then "request-evidence" else "defer");
   let action = oh-select(row,response,"defer");
   let selected = fhn-choice(job,stage,oh-str(row,"id"),"selected",offers,action,oh-str(row,"aspect"),"organ-request");
   let incoming = fhn-stage-event(job,stage,"organ-response",elapsed,list(json-node-pair("health",response)));
   let started = host_monotonic_ms();
   let result = if str_eq(action,"request-evidence") then json-node-object(list(json-node-pair("stdout",oh-reference(fhn-stage-path(job,stage,".out"))),json-node-pair("stderr",oh-reference(fhn-stage-path(job,stage,".err"))),json-node-pair("token_flow",oh-reference(fhn-stage-path(job,stage,".flow.jsonl"))),fhn-s("child_status",fhn-read(fhn-stage-path(job,stage,".raw-status"))))) else json-node-string("need-remains-open");
   let applied = oh-applied(row,action,result);
   let observed = fhn-stage-event(job,stage,"organ-action-observed",add(elapsed,sub(host_monotonic_ms(),started)),list(json-node-pair("health",applied)));
   let choice = fhn-choice(job,stage,oh-str(row,"id"),"applied",offers,action,oh-str(row,"aspect"),json-emit-precise(result));
   "appended";
  }
  // The status rename can occur between the first read and the liveness probe.
  // Reconcile after reaping; explicit cancellation/deadline statuses retain meaning.
  def fhn-exit-observed(status,reason,actual) = if and(str_eq(reason,"supervisor-exited-without-child-status"),and(fsuf-uint?(actual),le(str_to_int(actual),255))) then list(str_to_int(actual),"completed") else list(status,reason);
  def fhn-release-learner-lock(job, child) {
   let root = fhn-string(fhn-json(fhn-at(job, "snapshot.json")), "root");
   let lock = fhn-at(root, ".form-heal/native-learning/update.lock");
   let owner = fhn-at(lock, "owner.pid");
   if and(gt(child, 0), and(eq(str_to_int(fhn-read(owner)), child), not(fhn-alive(child)))) then fhn-release-learner-owned(lock, owner) else 0;
  }
  def fhn-release-learner-owned(lock, owner) {
   let cleared = fs_remove(owner);
   host_dir_rmdir(lock);
  }
  def fhn-await-release(child, wrapper, remaining) = if or(le(remaining, 0), and(fhn-group-empty(child), not(fhn-alive(wrapper)))) then 0 else fhn-await-release-after(child, wrapper, remaining);
  def fhn-await-release-after(child, wrapper, remaining) {
   let pause = host_sleep_ms(50);
   fhn-await-release(child, wrapper, sub(remaining, 1));
  }
 }
 0;
}
