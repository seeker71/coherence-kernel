   ((String) recorded == "appended") && (oh-valid(row) && ((String) oh-str(row,"stage") == "observe")) ? fhn-care-health(job,stage,row,elapsed) : recorded;
  }
  def fhn-care-health(job,stage,row,elapsed) {
   let context = record_new(0);
