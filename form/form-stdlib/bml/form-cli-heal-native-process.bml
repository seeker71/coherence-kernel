   let row = json-node-object(list(fhn-s("version", "observed-process-v1"), fhn-s("state", state), fhn-s("program", program), fhn-n("pid", pid), fhn-n("status", status), fhn-n("elapsed_ms", sub(host_monotonic_ms(), started)), fhn-n("started_unix_ms", wall), fhn-n("ended_unix_ms", now_unix_ms()), fhn-n("budget_ms", mul(seconds, 1000)), fhn-s("reason", reason), fhn-s("supervision", if eq(seconds, 0) then "dynamic-progress" else "explicit-deadline"), fhn-s("timing_basis", "parent-monotonic-observation-ms"), fhn-a("events", events), fhn-n("output_bytes", add(fhd-max(0, file_size(fhn-stage-path(job, stage, ".out"))), fhd-max(0, file_size(fhn-stage-path(job, stage, ".err"))))), json-node-pair("cleanup", cleanup)));
   let actual = fhn-read(fhn-stage-path(job, stage, ".raw-status"));
