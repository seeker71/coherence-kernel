   ((String) fhn-string(span,"stream") == "stderr") && (((String) fhn-string(oh-get(span,"source"),"path") == path) && (fhn-flow-uint(oh-get(span,"offset")) && (fhn-flow-uint(oh-get(span,"end")) && (fhn-flow-uint(oh-get(span,"new_bytes")) && ((fhn-number(span,"new_bytes") > 0) && ((fhn-number(span,"end") >= fhn-number(span,"offset")) && ((Comparable) (fhn-number(span,"end") - fhn-number(span,"offset")) == fhn-number(span,"new_bytes"))))))));
