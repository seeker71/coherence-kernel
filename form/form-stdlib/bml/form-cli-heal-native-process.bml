  def fhn-care-providers(job) = [fhn-evidence-provider(),fkbc-provider()];
  def fhn-evidence-provider() = oc-provider("owned-process-diagnostic-evidence",["diagnostic-evidence"],"request-evidence",fhn-care-supply);
  def fhn-care-emit(context,phase,row) {
