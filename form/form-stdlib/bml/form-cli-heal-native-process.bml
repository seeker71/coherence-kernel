  }
  def fhn-care-needs(needs,span,settled) = if nil?(needs) then [] else if (settled && (((String) oh-str(head(needs),"resource") == "diagnostic-evidence") && node_eq(oh-get(head(needs),"detail"),span))) then fhn-care-needs(tail(needs),span,settled) else cons(head(needs),fhn-care-needs(tail(needs),span,settled));
