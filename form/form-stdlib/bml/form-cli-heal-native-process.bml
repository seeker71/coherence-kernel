  def fhn-field(parts, prefix) = if nil?(parts) then "" else if eq(str_find(head(parts), prefix, 0), 0) then substring(head(parts), str_len(prefix), str_len(head(parts))) else fhn-field(tail(parts), prefix);
  def fhn-observe-stage(job, stage, line, elapsed) {
