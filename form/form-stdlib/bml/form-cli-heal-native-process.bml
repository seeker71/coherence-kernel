  def fhn-drain-final(job,stage,suffix,reader,started) = fhn-drain-final-slices(job,stage,suffix,reader,started,hearth-process-final-drain-chunks());
  def fhn-drain-final-slices(job,stage,suffix,reader,started,remaining) = remaining <= 0 ? fhn-drain-retain(job,stage,suffix,reader,started) : {
