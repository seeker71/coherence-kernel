  }
  def fhn-care-needs(needs,span,settled) = nil?(needs) ? [] : settled && (((String) oh-str(needs[0],"resource") == "diagnostic-evidence") && node_eq(oh-get(needs[0],"detail"),span)) ? fhn-care-needs(needs[1:],span,settled) : cons(needs[0],fhn-care-needs(needs[1:],span,settled));
  // each provider's delivery is re-observed by the reading it answers
  def fhn-care-observe(context,reading,delivery) = (String) fhn-string(delivery,"resource") == "binding" ? fkbc-observe(context,reading,delivery) : fhn-care-observe-evidence(context,reading,delivery);
  def fhn-care-observe-evidence(context,reading,delivery) {
   let path = fhn-stage-path(record_get(context,"job"),record_get(context,"stage"),".err");
   let span = record_get(context,"span"); let held = record_get(context,"bytes");
   let valid = fhn-care-span?(context,span) && ((String) value_kind(held) == "string");
   let again = valid ? read_file_slice(path,fhn-number(span,"offset"),fhn-number(span,"new_bytes")) : nothing();
   let exact = valid && (((String) value_kind(again) == "string") && (((String) held == again) && (file_size(path) >= fhn-number(span,"end"))));
   record_set(context,"bytes",nothing());
   let evidence = json-node-object([json-node-pair("source",oh-reference(path)),fhn-n("evidence_reobserved",exact),fhn-n("offset",fhn-number(delivery,"offset")),fhn-n("end",fhn-number(delivery,"end")),fhn-s("interpretation","unknown")]);
   let fresh = oh-reading(oh-str(reading,"organ"),oh-str(reading,"flow"),oh-str(reading,"aspect"),oh-get(reading,"expected"),oh-get(reading,"observed"),oh-get(reading,"health"),fhn-care-needs(json-array-elements(oh-get(reading,"needs")),span,exact),oh-values(json-array-elements(oh-get(reading,"offers"))),evidence);
