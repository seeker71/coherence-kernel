  def fhn-launch-script(job, stage, cwd, input, argv) = fh-cat(list(
   "umask 077\ncd ", fh-quote(cwd), " || exit 127\nset -m\n",
   fh-quote(head(argv)), fh-args(tail(argv)), " < ", fh-quote(if str_eq(input, "-") then "/dev/null" else input),
