// Live Glass attention. Native cells in, keyed evidence and executable lenses out.
// No prompt text, host commands, source rewriting or model calls on this path.
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-sensor-rows.bml form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/champion-challenger.fk form/form-stdlib/part-self-update.fk observe/bidirectional-framebuffer-channel.fk

section [form.bml] {
    class FormGlassAwareness {
        field FGASchema = "glass-awareness-v1";
        field FGAInitialWindow = 16;
        field FGAMaxWindow = 64;
        field FGAMaxPublishers = 16;
        field FGAInitialRecipes = 32;
        field FGAMaxRecipes = 128;
        field FGAMaxEvents = 24;
        field FGAMaxRemembered = 512;
        field FGAPublisherHorizonMs = 5000;

        // A vocabulary, not a positional record: order and additional fields are immaterial.
        def fga-pair(key, value) = list(key, value);
        def fga-get(record, key) = (Comparable) len(record) == 0 ? nothing() : (String) head(head(record)) == key ? head(record)[1] : fga-get(tail(record), key);
        def fga-or(record, key, fallback) {
            let value = fga-get(record, key);
            value ?? fallback;
        }
        def fga-min(a, b) = a < b ? a : b;
        def fga-max(a, b) = a > b ? a : b;
        def fga-abs(n) = n < 0 ? (0 - n) : n;
        def fga-offset(cursor, count) = cursor - ((cursor / count) * count);
        def fga-window(rows, cursor, size) = (Comparable) len(rows) == 0 ? list() : take(size, append(drop(fga-offset(cursor, len(rows)), rows), take(fga-offset(cursor, len(rows)), rows)));

        // ---- how much of the attention a door can show ------------------------
        // A door has a height, and how many findings fit in it is not a number
        // anyone picks. It is the surface's rows, less the door's own chrome,
        // spent on the findings' own widths -- the same shape sparkWidth already
        // takes from its width. Measured 2026-09-10 on this checkout: the state
        // held its ceiling of 24, every finding was at most 94 characters and so
        // cost one row at the glass's own width of 100, the door's two chrome
        // lines cost 4 rows of a 30-row surface, and the whole 24 fit in the
        // remaining 26 with two rows to spare. A door that showed eight was
        // showing a third of what its surface could hold.
        def fga-rows-for(chars, width) = width <= 0 ? 1 : ((chars + (width - 1)) / width);
        def fga-fits-one(chars, rest, width, budget, shown) {
            let cost = fga-rows-for(chars, width);
            cost > budget ? shown : fga-fits(rest, width, budget - cost, shown + 1);
        }
        def fga-fits(lengths, width, budget, shown) = (Comparable) len(lengths) == 0 ? shown : fga-fits-one(head(lengths), tail(lengths), width, budget, shown);
        // at least one row of findings: a door that shows none of the thing it is
        // about has stopped being a door, however small the surface got
        def fga-shown(lengths, width, height, chrome) = fga-fits(lengths, width, fga-max(1, height - chrome), 0);
        def fga-lengths(lines) = (Comparable) len(lines) == 0 ? list() : cons(str_len(head(lines)), fga-lengths(tail(lines)));

        def fga-sensors() = list("machine", "glass", "queue", "process", "owner", "host", "storage", "ear");
        def fga-frame(source, kind, schema, seq, epoch, cadence, status, rows) = list(fga-pair("source", source), fga-pair("kind", kind), fga-pair("schema", schema), fga-pair("seq", seq), fga-pair("epoch", epoch), fga-pair("cadence", cadence), fga-pair("status", status), fga-pair("rows", rows));
        def fga-sensor-frame(sensor, seq, frame) = !((Comparable) fgsr-frame-valid?(frame) == 1) ? fga-frame(sensor, "metric", "unknown", seq, -1, 0, "decode-gap", list()) : !((String) frame[1] == sensor) ? fga-frame(sensor, "metric", FGSRSchema(), seq, -1, 0, "identity-mismatch", list()) : fga-frame(sensor, "metric", head(frame), seq, frame[2], fgsr-frame-cadence(frame), "read", frame[3]);
        def fga-read-sensor(sensor) {
            let handle = ggf-receive(fgsr-publisher(sensor));
            let before = ggf-seq(handle);
            let frame = nothing?(handle) ? nothing() : node_gift_read(handle);
            let after = ggf-seq(handle);
            let released = ggf-release(handle);
            nothing?(handle) ? fga-frame(sensor, "metric", "unknown", -1, -1, 0, "absent", list()) : !((Comparable) before == after) ? fga-frame(sensor, "metric", "unknown", after, -1, 0, "retry", list()) : fga-sensor-frame(sensor, after, frame);
        }
        def fga-read-sensors(names) = (Comparable) len(names) == 0 ? list() : cons(fga-read-sensor(head(names)), fga-read-sensors(tail(names)));
        def fga-publisher-frame(name, seq, snapshot) = !((Comparable) fgtm-snapshot-valid?(snapshot) == 1) ? fga-frame(name, "sample", "unknown", seq, -1, 0, "decode-gap", list()) : fga-frame(name, "sample", head(snapshot), seq, fgtm-snapshot-epoch(snapshot), 0, "read", fgtm-snapshot-samples(snapshot));
        def fga-read-publisher(root, name) {
            let before = fgtm-read-key(root, name);
            let reading = fgtm-read-current(root, name);
            let after = fgtm-read-key(root, name);
            !((Comparable) before == after) ? fga-frame(name, "sample", "unknown", after, -1, 0, "retry", list()) : !((String) fgtm-read-state-status(reading) == "current") ? fga-frame(name, "sample", "unknown", after, -1, 0, fgtm-read-state-status(reading), list()) : fga-publisher-frame(name, after, fgtm-field-value(fgtm-read-state-value(reading)));
        }
        def fga-read-publishers(root, names) = (Comparable) len(names) == 0 ? list() : cons(fga-read-publisher(root, head(names)), fga-read-publishers(root, tail(names)));
        def fga-external(names) = (Comparable) len(names) == 0 ? list() : (String) head(names) == "organs" ? fga-external(tail(names)) : cons(head(names), fga-external(tail(names)));
        def fga-names(root) = fga-external(fgtm-roster-in-space(gift_roster_names(), root));
        def fga-collect(root, names, cursor) = append(fga-read-sensors(fga-sensors()), fga-read-publishers(root, fga-window(names, cursor, FGAMaxPublishers())));
        def fga-fresh(frame, now) = !((String) fga-get(frame, "status") == "read") ? 0 : fga-get(frame, "epoch") > now ? -1 : fga-get(frame, "cadence") > 0 ? ((now - fga-get(frame, "epoch")) > (FGSRSilentFactor() * fga-get(frame, "cadence")) ? 0 : 1) : (now - fga-get(frame, "epoch")) > FGAPublisherHorizonMs() ? -1 : 1;
        def fga-entry-fresh(frame, epoch, now) = epoch < 0 ? fga-fresh(frame, now) : epoch > now ? -1 : (now - epoch) > (fga-get(frame, "cadence") > 0 ? (FGSRSilentFactor() * fga-get(frame, "cadence")) : FGAPublisherHorizonMs()) ? 0 : fga-fresh(frame, now);

        // Decode known carriers directly. Text payloads/notes never enter attention or its gift.
        // Capacity is an edge to inspect, NOT proof of contention or a utilization percentage.
        def fga-record(frame, id, domain, unit, present, fresh, numeric, value, capacity, lifecycle, sourceNode) = list(fga-pair("source", fga-get(frame, "source")), fga-pair("carrier", fga-get(frame, "kind")), fga-pair("schema", fga-get(frame, "schema")), fga-pair("id", id), fga-pair("domain", domain), fga-pair("unit", unit), fga-pair("present", present), fga-pair("fresh", fresh), fga-pair("numeric", numeric), fga-pair("value", value), fga-pair("capacity", capacity), fga-pair("lifecycle", lifecycle), fga-pair("seq", fga-get(frame, "seq")), fga-pair("epoch", fga-get(frame, "epoch")), fga-pair("source-node", sourceNode));
        def fga-bad-row(frame) = fga-record(frame, "row-decode", "interface", "", 0, 0, 0, 0, 0, "decode-gap", nothing());
        def fga-metric-fresh(row, frame, now) = ((String) fgo-evidence(row) == "silent") || ((String) fgo-evidence(row) == "unavailable") ? 0 : (String) fgo-evidence(row) == "catalog" ? 2 : !(((String) fgo-evidence(row) == "physical-live") || ((String) fgo-evidence(row) == "derived-window")) ? -1 : fga-entry-fresh(frame, fgo-observed-epoch(row), now);
        def fga-metric(frame, row, now) = len(row) < 19 ? fga-bad-row(frame) : !((String) head(row) == "form-glass-metric-v2") ? fga-bad-row(frame) : fga-record(frame, fgo-id(row), fgo-domain(row), fgo-unit(row), fgo-present?(row), fga-metric-fresh(row, frame, now), (String) fgo-value-kind(row) == "int", fgo-int-value(row), (Comparable) fgo-capacity-present?(row) == 1 ? fgo-capacity(row) : 0, fgo-lifecycle(row), fgo-source-node(row));
        def fga-sample(frame, row, now) = !((Comparable) fgtm-sample-valid?(row) == 1) ? fga-bad-row(frame) : fga-record(frame, fgtm-sample-id(row), fgtm-sample-kind(row), "sample", 1, (String) fgtm-sample-evidence(row) == "catalog" ? 2 : (String) fgtm-sample-evidence(row) == "declared" ? -1 : fga-entry-fresh(frame, fgd-sample-latest(row), now), fgtm-field-present?(fgtm-sample-bytes(row)), (Comparable) fgtm-field-present?(fgtm-sample-bytes(row)) == 1 ? fgtm-field-value(fgtm-sample-bytes(row)) : 0, 0, fgtm-sample-lifecycle(row), nothing());
        def fga-decode(frame, rows, now) = (Comparable) len(rows) == 0 ? list() : cons((String) fga-get(frame, "kind") == "metric" ? fga-metric(frame, head(rows), now) : fga-sample(frame, head(rows), now), fga-decode(frame, tail(rows), now));
        def fga-channel-record(frame, now) = fga-record(frame, "channel", "channel", "sequence", (String) fga-get(frame, "status") == "read", fga-fresh(frame, now), 0, 0, 0, fga-get(frame, "status"), nothing());
        def fga-effective-window(frames, size) = (Comparable) len(frames) == 0 ? size : fga-min(size, fga-max(1, (FGAMaxRemembered() - len(frames)) / len(frames)));
        def fga-records-go(frames, now, cursor, size) = (Comparable) len(frames) == 0 ? list() : append(cons(fga-channel-record(head(frames), now), fga-decode(head(frames), fga-window(fga-get(head(frames), "rows"), cursor, size), now)), fga-records-go(tail(frames), now, cursor, size));
        def fga-records(frames, now, cursor, size) = fga-records-go(frames, now, cursor, fga-effective-window(frames, size));
        def fga-count-go(frames, size) = (Comparable) len(frames) == 0 ? 0 : (fga-min(size, len(fga-get(head(frames), "rows"))) + fga-count-go(tail(frames), size));
        def fga-count(frames, size) = fga-count-go(frames, fga-effective-window(frames, size));
        def fga-total(frames) = (Comparable) len(frames) == 0 ? 0 : (len(fga-get(head(frames), "rows")) + fga-total(tail(frames)));

        // The self-update actuator owns ONLY its attention window. Same frames, same start,
        // before/after per channel; a correlated rehearsal installs the winning part.
        def fga-window-stages-go(frames, before, after) = (Comparable) len(frames) == 0 ? list() : cons(list(fga-pair("source", fga-get(head(frames), "source")), fga-pair("before", fga-min(before, len(fga-get(head(frames), "rows")))), fga-pair("after", fga-min(after, len(fga-get(head(frames), "rows"))))), fga-window-stages-go(tail(frames), before, after));
        def fga-window-stages(frames, before, after) = fga-window-stages-go(frames, fga-effective-window(frames, before), fga-effective-window(frames, after));
        def fga-window-choice(frames, old, candidate) {
            let before = fga-count(frames, old);
            let after = fga-count(frames, candidate);
            let trials = list(list(1, after >= before), list(1, candidate <= FGAMaxWindow()), list(1, candidate >= FGAInitialWindow()), list(1, after <= fga-total(frames)));
            let wins = (after > before) && cc-promote?(trials, 4, 0);
            psu-next-addr(old, candidate, wins);
        }
        def fga-install-window(frames, old, next, tick) {
            let out = bfc-envelope(0, tick, 0, fga-window-stages(frames, old, next), old);
            let outEvent = bfc-record-out(out, 0);
            let control = bfc-control(out, 5);
            let inEvent = bfc-record-in(control, 1);
            bfc-apply(out, control, old, next);
        }
        def fga-evolve-window(frames, old, tick) {
            let candidate = fga-min(FGAMaxWindow(), old * 2);
            let next = fga-window-choice(frames, old, candidate);
            (Comparable) old == next ? old : fga-install-window(frames, old, next, tick);
        }

        // A small native observation grammar. Recipes bind carried schema/domain/unit,
        // never a text prompt or a call name from a publisher. New bindings are executable
        // cells, not generated files. No claim of arbitrary program invention is made.
        def fga-lens-key(record) = list(fga-get(record, "schema"), fga-get(record, "domain"), fga-get(record, "unit"));
        def fga-lens-same(a, b) = ((String) a[0] == b[0]) && (((String) a[1] == b[1]) && ((String) a[2] == b[2]));
        def fga-lens-find(recipes, key) = (Comparable) len(recipes) == 0 ? list() : (Comparable) fga-lens-same(fga-get(head(recipes), "binding"), key) == 1 ? head(recipes) : fga-lens-find(tail(recipes), key);
        def fga-recipe(key) {
            let node = fgo-field-node(bp("glass-attention-lens-v1"), list(intern_trivial_string(key[0]), intern_trivial_string(key[1]), intern_trivial_string(key[2]), intern_trivial_string("presence-freshness-state-capacity")), "form/form-stdlib/bml/form-glass-awareness.bml", 1, 1);
            list(fga-pair("binding", key), fga-pair("op", "observe"), fga-pair("node", node));
        }
        def fga-learn-to(records, recipes, limit) = ((Comparable) len(records) == 0) || (len(recipes) >= limit) ? recipes : fga-learn-to(tail(records), (Comparable) len(fga-lens-find(recipes, fga-lens-key(head(records)))) == 0 ? cons(fga-recipe(fga-lens-key(head(records))), recipes) : recipes, limit);
        def fga-native-domain?(domain) = ((String) domain == "recipe") || (((String) domain == "symbol") || (((String) domain == "token") || (((String) domain == "cell") || ((String) domain == "blueprint"))));
        def fga-classify(record) = (Comparable) fga-get(record, "present") == 0 ? "observation-gap" : (Comparable) fga-get(record, "fresh") == 0 ? "stale-source" : (Comparable) fga-get(record, "fresh") == -1 ? "freshness-unproven" : (Comparable) fga-get(record, "fresh") == 2 ? "catalog" : ((String) fga-get(record, "lifecycle") == "failed") || ((String) fga-get(record, "lifecycle") == "error") ? "organ-failed" : (String) fga-get(record, "lifecycle") == "blocked" ? "restricted-flow" : ((Comparable) fga-get(record, "numeric") == 1) && ((fga-get(record, "capacity") > 0) && (fga-get(record, "value") >= fga-get(record, "capacity"))) ? "capacity-edge" : "observed";
        def fga-eval(recipe, record) = (Comparable) len(recipe) == 0 ? "lens-budget" : !((String) fga-get(recipe, "op") == "observe") ? "recipe-refused" : !((Comparable) fga-lens-same(fga-get(recipe, "binding"), fga-lens-key(record)) == 1) ? "binding-mismatch" : fga-classify(record);
        def fga-lens-correct(recipes, row) = (String) fga-eval(fga-lens-find(recipes, fga-lens-key(row)), row) == fga-classify(row);
        def fga-lens-trials(rows, old, candidate) = (Comparable) len(rows) == 0 ? list() : cons(list(fga-lens-correct(old, head(rows)), fga-lens-correct(candidate, head(rows))), fga-lens-trials(tail(rows), old, candidate));
        def fga-lens-stages(rows, old, candidate) = (Comparable) len(rows) == 0 ? list() : cons(list(fga-pair("source", fga-get(head(rows), "source")), fga-pair("id", fga-get(head(rows), "id")), fga-pair("binding", fga-lens-key(head(rows))), fga-pair("before", fga-eval(fga-lens-find(old, fga-lens-key(head(rows))), head(rows))), fga-pair("after", fga-eval(fga-lens-find(candidate, fga-lens-key(head(rows))), head(rows)))), fga-lens-stages(tail(rows), old, candidate));
        def fga-install-recipes(old, candidate, trials, tick) {
            let out = bfc-envelope(0, tick + 100000, 0, trials, old);
            let sent = bfc-record-out(out, 0);
            let control = bfc-control(out, 5);
            let received = bfc-record-in(control, 1);
            bfc-apply(out, control, old, candidate);
        }
        def fga-evolve-recipes(rows, old, limit, tick) {
            let seated = fga-learn-to(rows, old, limit);
            let nextLimit = fga-min(FGAMaxRecipes(), limit * 2);
            let candidate = fga-learn-to(rows, seated, nextLimit);
            let trials = fga-lens-trials(rows, seated, candidate);
            let wins = cc-exceeds?(trials) && cc-promote?(trials, 1, 0);
            let chosen = psu-next-addr(limit, nextLimit, wins);
            let recipes = (Comparable) chosen == limit ? seated : fga-install-recipes(seated, candidate, trials, tick);
            list(fga-pair("recipes", recipes), fga-pair("limit", chosen), fga-pair("gift", (Comparable) chosen == limit ? 0 : 1), fga-pair("before", cc-champ-score(trials)), fga-pair("after", (Comparable) chosen == limit ? cc-champ-score(trials) : cc-chall-score(trials)), fga-pair("trials", trials), fga-pair("stages", (Comparable) chosen == limit ? list() : fga-lens-stages(rows, seated, recipes)));
        }
        def fga-key-same(a, b) = ((String) fga-get(a, "source") == fga-get(b, "source")) && (((String) fga-get(a, "carrier") == fga-get(b, "carrier")) && (((String) fga-get(a, "domain") == fga-get(b, "domain")) && ((String) fga-get(a, "id") == fga-get(b, "id"))));
        def fga-prior(rows, row) = (Comparable) len(rows) == 0 ? list() : (Comparable) fga-key-same(head(rows), row) == 1 ? head(rows) : fga-prior(tail(rows), row);
        def fga-unseen(old, current) = (Comparable) len(old) == 0 ? list() : (Comparable) len(fga-prior(current, head(old))) == 0 ? cons(head(old), fga-unseen(tail(old), current)) : fga-unseen(tail(old), current);
        def fga-reason(row, prior, verdict) = !((String) verdict == "observed") ? verdict : (Comparable) len(prior) == 0 ? ((Comparable) fga-native-domain?(fga-get(row, "domain")) == 1 ? "new-native-identity" : "new-interface") : !((Comparable) fga-lens-same(fga-lens-key(row), fga-lens-key(prior)) == 1) ? "grammar-changed" : fga-get(row, "seq") < fga-get(prior, "seq") ? "channel-restarted" : !((String) fga-get(prior, "verdict") == "observed") ? "flow-restored" : "observed";
        def fga-attention?(reason) = (String) reason == "observed" ? 0 : (String) reason == "catalog" ? 0 : (String) reason == "new-interface" ? 0 : (String) reason == "new-native-identity" ? 0 : (String) reason == "flow-restored" ? 0 : (String) reason == "grammar-changed" ? 0 : (String) reason == "channel-restarted" ? 0 : 1;
        def fga-action(reason) = (String) reason == "lens-budget" ? "expand-observation-grammar" : (String) reason == "organ-failed" ? "request-healing-actuator" : (String) reason == "restricted-flow" ? "inspect-blocked-organ" : (String) reason == "capacity-edge" ? "inspect-capacity-contract" : (Comparable) fga-attention?(reason) == 1 ? "request-evidence" : "continue";
        def fga-event(row, prior, reason, recipe, now) = append(list(fga-pair("reason", reason), fga-pair("action", fga-action(reason)), fga-pair("attention", fga-attention?(reason)), fga-pair("observed-at", now), fga-pair("before-seq", fga-or(prior, "seq", -1)), fga-pair("after-seq", fga-get(row, "seq")), fga-pair("recipe-node", fga-or(recipe, "node", nothing()))), row);
        def fga-assess(rows, old, recipes, now) = (Comparable) len(rows) == 0 ? list() : cons(fga-assess-one(head(rows), fga-prior(old, head(rows)), fga-lens-find(recipes, fga-lens-key(head(rows))), now), fga-assess(tail(rows), old, recipes, now));
        def fga-assess-one(row, prior, recipe, now) {
            let verdict = fga-eval(recipe, row);
            let reason = fga-reason(row, prior, verdict);
            let changed = (Comparable) len(prior) == 0 ? 1 : !((String) verdict == fga-get(prior, "verdict")) ? 1 : ((String) reason == "grammar-changed") || ((String) reason == "channel-restarted") ? 1 : 0;
            append(list(fga-pair("verdict", verdict), fga-pair("changed", changed), fga-pair("event", fga-event(row, prior, reason, recipe, now))), row);
        }
        def fga-events(rows, attention) = (Comparable) len(rows) == 0 ? list() : ((Comparable) fga-get(head(rows), "changed") == 1) && ((Comparable) fga-get(fga-get(head(rows), "event"), "attention") == attention) ? cons(fga-get(head(rows), "event"), fga-events(tail(rows), attention)) : fga-events(tail(rows), attention);
        def fga-asks(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fga-attention?(fga-get(head(rows), "verdict")) == 1 ? cons(fga-get(head(rows), "event"), fga-asks(tail(rows))) : fga-asks(tail(rows));
        def fga-state-empty() = list(fga-pair("tick", 0), fga-pair("window", FGAInitialWindow()), fga-pair("rows", list()), fga-pair("recipes", list()), fga-pair("events", list()), fga-pair("gifts", 0));
        def fga-step(frames, publisherCount, now, state) {
            let tick = fga-get(state, "tick") + 1;
            let oldWindow = fga-get(state, "window");
            let size = fga-evolve-window(frames, oldWindow, tick);
            let cursor = fga-or(state, "cursor", 0);
            let records = fga-records(frames, now, cursor, size);
            let evolution = fga-evolve-recipes(records, fga-get(state, "recipes"), fga-or(state, "recipe-limit", FGAInitialRecipes()), tick);
            let recipes = fga-get(evolution, "recipes");
            let rows = fga-assess(records, fga-get(state, "rows"), recipes, now);
            let events = append(fga-events(rows, 1), fga-events(rows, 0));
            let lastStages = (Comparable) fga-get(evolution, "gift") == 1 ? fga-get(evolution, "stages") : fga-or(state, "recipe-stages", list());
            list(
                fga-pair("tick", tick), fga-pair("cursor", cursor + fga-effective-window(frames, size)),
                fga-pair("window", size), fga-pair("rows", take(FGAMaxRemembered(), append(rows, fga-unseen(fga-get(state, "rows"), rows)))),
                fga-pair("recipes", recipes), fga-pair("recipe-limit", fga-get(evolution, "limit")),
                fga-pair("recipe-before", fga-get(evolution, "before")), fga-pair("recipe-after", fga-get(evolution, "after")),
                fga-pair("recipe-stages", lastStages),
                fga-pair("events", take(FGAMaxEvents(), append(events, fga-get(state, "events")))),
                fga-pair("new-events", len(events)), fga-pair("asks", fga-asks(rows)),
                fga-pair("gifts", fga-get(state, "gifts") + (fga-get(evolution, "gift") + (size > oldWindow ? 1 : 0))),
                fga-pair("stages", fga-window-stages(frames, oldWindow, size)),
                fga-pair("before", fga-count(frames, oldWindow)), fga-pair("after", fga-count(frames, size)),
                fga-pair("unread-rows", fga-total(frames) - fga-count(frames, size)),
                fga-pair("unread-publishers", fga-max(0, publisherCount - FGAMaxPublishers())), fga-pair("epoch", now));
        }
        def fga-current(root, now, state) {
            let names = fga-names(root);
            fga-step(fga-collect(root, names, fga-get(state, "tick") * FGAMaxPublishers()), len(names), now, state);
        }
        def fga-detail-door(root) = "glass.awareness." ++ root;
        // A source node may contain private children. Export its bound local identity,
        // not those children. Generated lenses contain only observation vocabulary.
        def fga-public-event(event) = (Comparable) len(event) == 0 ? list() : (String) head(head(event)) == "source-node" ? cons(fga-pair("source-node-id", nothing?(head(event)[1]) ? nothing() : fgo-node-id(head(event)[1])), fga-public-event(tail(event))) : cons(head(event), fga-public-event(tail(event)));
        def fga-public-events(events) = (Comparable) len(events) == 0 ? list() : cons(fga-public-event(head(events)), fga-public-events(tail(events)));
        def fga-details(state) = list(
            fga-pair("epoch", fga-get(state, "epoch")), fga-pair("window", fga-get(state, "window")),
            fga-pair("events", fga-public-events(fga-get(state, "events"))), fga-pair("asks", fga-public-events(take(FGAMaxEvents(), fga-get(state, "asks")))),
            fga-pair("ask-count", len(fga-get(state, "asks"))), fga-pair("recipes", fga-get(state, "recipes")),
            fga-pair("recipe-limit", fga-get(state, "recipe-limit")), fga-pair("recipe-before", fga-get(state, "recipe-before")),
            fga-pair("recipe-after", fga-get(state, "recipe-after")),
            fga-pair("recipe-stages", take(FGAMaxEvents(), fga-get(state, "recipe-stages"))),
            fga-pair("recipe-stage-count", len(fga-get(state, "recipe-stages"))),
            fga-pair("stages", fga-get(state, "stages")), fga-pair("before", fga-get(state, "before")),
            fga-pair("after", fga-get(state, "after")), fga-pair("gifts", fga-get(state, "gifts")),
            fga-pair("unread-rows", fga-get(state, "unread-rows")), fga-pair("unread-publishers", fga-get(state, "unread-publishers")));
        def fga-give(root, state) {
            let handle = ggf-offer(fga-detail-door(root), FGSRFrameBytes());
            let given = nothing?(handle) ? nothing() : node_gift_write(handle, list(FGASchema(), fga-get(state, "epoch"), fga-details(state)));
            let released = ggf-release(handle);
            given;
        }
        def fga-read(root) {
            let handle = ggf-receive(fga-detail-door(root));
            let value = nothing?(handle) ? nothing() : node_gift_read(handle);
            let released = ggf-release(handle);
            value;
        }
        def fga-publish-row(id, kind, purpose, amount, heat, now, seq, frame, channels) = fgtm-sample(id, fgtm-absent(), kind, "membrane", "organs", "awareness", purpose, fgtm-absent(), fgtm-present(amount), heat > 0 ? "active" : "ready", fgtm-present(now), fgtm-present(now), fgtm-present(heat), fgtm-present(seq), "never", "derived-window", frame, channels);
        def fga-summary(state, now, seq, frame) = list(
            fga-publish-row("awareness.coverage", "event", "rows-read-this-window", fga-get(state, "after"), 0, now, seq, frame, list("events", "awareness")),
            fga-publish-row("awareness.asks", "event", "requests-in-current-window", len(fga-get(state, "asks")), len(fga-get(state, "asks")) > 0 ? 1 : 0, now, seq, frame, list("events", "awareness")),
            fga-publish-row("awareness.gifts", "event", "attention-expansions-reobserved", fga-get(state, "gifts"), 0, now, seq, frame, list("events", "awareness")),
            fga-publish-row("awareness.unread", "event", "rows-outside-current-window", fga-get(state, "unread-rows"), 0, now, seq, frame, list("events", "awareness")),
            fga-publish-row("awareness.unread-publishers", "event", "publishers-outside-current-window", fga-get(state, "unread-publishers"), 0, now, seq, frame, list("events", "awareness")));
        def fga-label(value) = (Comparable) fgtm-label?(value) == 1 ? value : "see-native-detail";
        def fga-event-samples(events, index, now, seq, frame) = (Comparable) len(events) == 0 ? list() : cons(fga-publish-row("awareness.event." ++ int_to_str(index), "event", fga-get(head(events), "reason"), fga-max(0, fga-get(head(events), "after-seq")), fga-get(head(events), "attention"), fga-get(head(events), "observed-at"), seq, frame, list("events", "awareness", fga-action(fga-get(head(events), "reason")), fga-label(fga-get(head(events), "source")), fga-label(fga-get(head(events), "id")))), fga-event-samples(tail(events), index + 1, now, seq, frame));
        def fga-node-label(node) = fgtm-cat(list("n", int_to_str(node_pkg(node)), ".", int_to_str(node_level(node)), ".", int_to_str(node_type(node)), ".", int_to_str(node_inst(node))));
        def fga-recipe-samples(recipes, index, now, seq, frame) = (Comparable) len(recipes) == 0 ? list() : cons(fga-publish-row("awareness.recipe." ++ int_to_str(index), "recipe", fga-node-label(fga-get(head(recipes), "node")), 0, 0, now, seq, frame, list("recipe", "grammar", "awareness", fga-label(fga-get(head(recipes), "binding")[1]), fga-label(fga-get(head(recipes), "binding")[2]))), fga-recipe-samples(tail(recipes), index + 1, now, seq, frame));
        def fga-samples(state, now, seq, frame) = append(fga-summary(state, now, seq, frame), append(fga-event-samples(fga-get(state, "events"), 0, now, seq, frame), fga-recipe-samples(fga-get(state, "recipes"), 0, now, seq, frame)));
    }
    0;
}
