// Live Glass attention. Native cells in, keyed evidence and executable lenses out.
// No prompt text, host commands, source rewriting or model calls on this path.
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-sensor-rows.bml form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/champion-challenger.fk form/form-stdlib/part-self-update.fk observe/bidirectional-framebuffer-channel.fk

section [form.bml] {
    class FormGlassAwareness {
        field FGASchema = "glass-awareness-v1";
        field FGAInitialWindow = 16;
        field FGAMaxWindow = 64;
        field FGAMaxPublishers = 16;
        field FGAInitialRecipes = 32;
        field FGAMaxRecipes = 128;
        field FGAMaxEvents = 24;
        field FGAMaxRemembered = 512;
        field FGAPublisherHorizonMs = 5000;

        // A vocabulary, not a positional record: order and additional fields are immaterial.
        def fga-pair(key, value) = list(key, value);
        def fga-get(record, key) = if eq(len(record), 0) then nothing() else if str_eq(head(head(record)), key) then nth(head(record), 1) else fga-get(tail(record), key);
        def fga-or(record, key, fallback) {
            let value = fga-get(record, key);
            if nothing?(value) then fallback else value;
        }
        def fga-min(a, b) = if lt(a, b) then a else b;
        def fga-max(a, b) = if gt(a, b) then a else b;
        def fga-abs(n) = if lt(n, 0) then sub(0, n) else n;
        def fga-offset(cursor, count) = sub(cursor, mul(div(cursor, count), count));
        def fga-window(rows, cursor, size) = if eq(len(rows), 0) then list() else take(size, append(drop(fga-offset(cursor, len(rows)), rows), take(fga-offset(cursor, len(rows)), rows)));

        // ---- how much of the attention a door can show ------------------------
        // A door has a height, and how many findings fit in it is not a number
        // anyone picks. It is the surface's rows, less the door's own chrome,
        // spent on the findings' own widths -- the same shape sparkWidth already
        // takes from its width. Measured 2026-09-10 on this checkout: the state
        // held its ceiling of 24, every finding was at most 94 characters and so
        // cost one row at the glass's own width of 100, the door's two chrome
        // lines cost 4 rows of a 30-row surface, and the whole 24 fit in the
        // remaining 26 with two rows to spare. A door that showed eight was
        // showing a third of what its surface could hold.
        def fga-rows-for(chars, width) = if le(width, 0) then 1 else div(add(chars, sub(width, 1)), width);
        def fga-fits-one(chars, rest, width, budget, shown) {
            let cost = fga-rows-for(chars, width);
            if gt(cost, budget) then shown else fga-fits(rest, width, sub(budget, cost), add(shown, 1));
        }
        def fga-fits(lengths, width, budget, shown) = if eq(len(lengths), 0) then shown else fga-fits-one(head(lengths), tail(lengths), width, budget, shown);
        // at least one row of findings: a door that shows none of the thing it is
        // about has stopped being a door, however small the surface got
        def fga-shown(lengths, width, height, chrome) = fga-fits(lengths, width, fga-max(1, sub(height, chrome)), 0);
        def fga-lengths(lines) = if eq(len(lines), 0) then list() else cons(str_len(head(lines)), fga-lengths(tail(lines)));

        def fga-sensors() = list("machine", "glass", "queue", "process", "owner", "host", "storage", "ear");
        def fga-frame(source, kind, schema, seq, epoch, cadence, status, rows) = list(fga-pair("source", source), fga-pair("kind", kind), fga-pair("schema", schema), fga-pair("seq", seq), fga-pair("epoch", epoch), fga-pair("cadence", cadence), fga-pair("status", status), fga-pair("rows", rows));
        def fga-sensor-frame(sensor, seq, frame) = if not(eq(fgsr-frame-valid?(frame), 1)) then fga-frame(sensor, "metric", "unknown", seq, -1, 0, "decode-gap", list()) else if not(str_eq(nth(frame, 1), sensor)) then fga-frame(sensor, "metric", FGSRSchema(), seq, -1, 0, "identity-mismatch", list()) else fga-frame(sensor, "metric", head(frame), seq, nth(frame, 2), fgsr-frame-cadence(frame), "read", nth(frame, 3));
        def fga-read-sensor(sensor) {
            let handle = ggf-receive(fgsr-publisher(sensor));
            let before = ggf-seq(handle);
            let frame = if nothing?(handle) then nothing() else node_gift_read(handle);
            let after = ggf-seq(handle);
            let released = ggf-release(handle);
            if nothing?(handle) then fga-frame(sensor, "metric", "unknown", -1, -1, 0, "absent", list()) else if not(eq(before, after)) then fga-frame(sensor, "metric", "unknown", after, -1, 0, "retry", list()) else fga-sensor-frame(sensor, after, frame);
        }
        def fga-read-sensors(names) = if eq(len(names), 0) then list() else cons(fga-read-sensor(head(names)), fga-read-sensors(tail(names)));
        def fga-publisher-frame(name, seq, snapshot) = if not(eq(fgtm-snapshot-valid?(snapshot), 1)) then fga-frame(name, "sample", "unknown", seq, -1, 0, "decode-gap", list()) else fga-frame(name, "sample", head(snapshot), seq, fgtm-snapshot-epoch(snapshot), 0, "read", fgtm-snapshot-samples(snapshot));
        def fga-read-publisher(root, name) {
            let before = fgtm-read-key(root, name);
            let reading = fgtm-read-current(root, name);
            let after = fgtm-read-key(root, name);
            if not(eq(before, after)) then fga-frame(name, "sample", "unknown", after, -1, 0, "retry", list()) else if not(str_eq(fgtm-read-state-status(reading), "current")) then fga-frame(name, "sample", "unknown", after, -1, 0, fgtm-read-state-status(reading), list()) else fga-publisher-frame(name, after, fgtm-field-value(fgtm-read-state-value(reading)));
        }
        def fga-read-publishers(root, names) = if eq(len(names), 0) then list() else cons(fga-read-publisher(root, head(names)), fga-read-publishers(root, tail(names)));
        def fga-external(names) = if eq(len(names), 0) then list() else if str_eq(head(names), "organs") then fga-external(tail(names)) else cons(head(names), fga-external(tail(names)));
        def fga-names(root) = fga-external(fgtm-roster-in-space(gift_roster_names(), root));
        def fga-collect(root, names, cursor) = append(fga-read-sensors(fga-sensors()), fga-read-publishers(root, fga-window(names, cursor, FGAMaxPublishers())));
        def fga-fresh(frame, now) = if not(str_eq(fga-get(frame, "status"), "read")) then 0 else if gt(fga-get(frame, "epoch"), now) then -1 else if gt(fga-get(frame, "cadence"), 0) then if gt(sub(now, fga-get(frame, "epoch")), mul(FGSRSilentFactor(), fga-get(frame, "cadence"))) then 0 else 1 else if gt(sub(now, fga-get(frame, "epoch")), FGAPublisherHorizonMs()) then -1 else 1;
        def fga-entry-fresh(frame, epoch, now) = if lt(epoch, 0) then fga-fresh(frame, now) else if gt(epoch, now) then -1 else if gt(sub(now, epoch), if gt(fga-get(frame, "cadence"), 0) then mul(FGSRSilentFactor(), fga-get(frame, "cadence")) else FGAPublisherHorizonMs()) then 0 else fga-fresh(frame, now);

        // Decode known carriers directly. Text payloads/notes never enter attention or its gift.
        // Capacity is an edge to inspect, NOT proof of contention or a utilization percentage.
        def fga-record(frame, id, domain, unit, present, fresh, numeric, value, capacity, lifecycle, sourceNode) = list(fga-pair("source", fga-get(frame, "source")), fga-pair("carrier", fga-get(frame, "kind")), fga-pair("schema", fga-get(frame, "schema")), fga-pair("id", id), fga-pair("domain", domain), fga-pair("unit", unit), fga-pair("present", present), fga-pair("fresh", fresh), fga-pair("numeric", numeric), fga-pair("value", value), fga-pair("capacity", capacity), fga-pair("lifecycle", lifecycle), fga-pair("seq", fga-get(frame, "seq")), fga-pair("epoch", fga-get(frame, "epoch")), fga-pair("source-node", sourceNode));
        def fga-bad-row(frame) = fga-record(frame, "row-decode", "interface", "", 0, 0, 0, 0, 0, "decode-gap", nothing());
        def fga-metric-fresh(row, frame, now) = if or(str_eq(fgo-evidence(row), "silent"), str_eq(fgo-evidence(row), "unavailable")) then 0 else if str_eq(fgo-evidence(row), "catalog") then 2 else if not(or(str_eq(fgo-evidence(row), "physical-live"), str_eq(fgo-evidence(row), "derived-window"))) then -1 else fga-entry-fresh(frame, fgo-observed-epoch(row), now);
        def fga-metric(frame, row, now) = if lt(len(row), 19) then fga-bad-row(frame) else if not(str_eq(head(row), "form-glass-metric-v2")) then fga-bad-row(frame) else fga-record(frame, fgo-id(row), fgo-domain(row), fgo-unit(row), fgo-present?(row), fga-metric-fresh(row, frame, now), str_eq(fgo-value-kind(row), "int"), fgo-int-value(row), if eq(fgo-capacity-present?(row), 1) then fgo-capacity(row) else 0, fgo-lifecycle(row), fgo-source-node(row));
        def fga-sample(frame, row, now) = if not(eq(fgtm-sample-valid?(row), 1)) then fga-bad-row(frame) else fga-record(frame, fgtm-sample-id(row), fgtm-sample-kind(row), "sample", 1, if str_eq(fgtm-sample-evidence(row), "catalog") then 2 else if str_eq(fgtm-sample-evidence(row), "declared") then -1 else fga-entry-fresh(frame, fgd-sample-latest(row), now), fgtm-field-present?(fgtm-sample-bytes(row)), if eq(fgtm-field-present?(fgtm-sample-bytes(row)), 1) then fgtm-field-value(fgtm-sample-bytes(row)) else 0, 0, fgtm-sample-lifecycle(row), nothing());
        def fga-decode(frame, rows, now) = if eq(len(rows), 0) then list() else cons(if str_eq(fga-get(frame, "kind"), "metric") then fga-metric(frame, head(rows), now) else fga-sample(frame, head(rows), now), fga-decode(frame, tail(rows), now));
        def fga-channel-record(frame, now) = fga-record(frame, "channel", "channel", "sequence", str_eq(fga-get(frame, "status"), "read"), fga-fresh(frame, now), 0, 0, 0, fga-get(frame, "status"), nothing());
        def fga-effective-window(frames, size) = if eq(len(frames), 0) then size else fga-min(size, fga-max(1, div(sub(FGAMaxRemembered(), len(frames)), len(frames))));
        def fga-records-go(frames, now, cursor, size) = if eq(len(frames), 0) then list() else append(cons(fga-channel-record(head(frames), now), fga-decode(head(frames), fga-window(fga-get(head(frames), "rows"), cursor, size), now)), fga-records-go(tail(frames), now, cursor, size));
        def fga-records(frames, now, cursor, size) = fga-records-go(frames, now, cursor, fga-effective-window(frames, size));
        def fga-count-go(frames, size) = if eq(len(frames), 0) then 0 else add(fga-min(size, len(fga-get(head(frames), "rows"))), fga-count-go(tail(frames), size));
        def fga-count(frames, size) = fga-count-go(frames, fga-effective-window(frames, size));
        def fga-total(frames) = if eq(len(frames), 0) then 0 else add(len(fga-get(head(frames), "rows")), fga-total(tail(frames)));

        // The self-update actuator owns ONLY its attention window. Same frames, same start,
        // before/after per channel; a correlated rehearsal installs the winning part.
        def fga-window-stages-go(frames, before, after) = if eq(len(frames), 0) then list() else cons(list(fga-pair("source", fga-get(head(frames), "source")), fga-pair("before", fga-min(before, len(fga-get(head(frames), "rows")))), fga-pair("after", fga-min(after, len(fga-get(head(frames), "rows"))))), fga-window-stages-go(tail(frames), before, after));
        def fga-window-stages(frames, before, after) = fga-window-stages-go(frames, fga-effective-window(frames, before), fga-effective-window(frames, after));
        def fga-window-choice(frames, old, candidate) {
            let before = fga-count(frames, old);
            let after = fga-count(frames, candidate);
            let trials = list(list(1, ge(after, before)), list(1, le(candidate, FGAMaxWindow())), list(1, ge(candidate, FGAInitialWindow())), list(1, le(after, fga-total(frames))));
            let wins = and(gt(after, before), cc-promote?(trials, 4, 0));
            psu-next-addr(old, candidate, wins);
        }
        def fga-install-window(frames, old, next, tick) {
            let out = bfc-envelope(0, tick, 0, fga-window-stages(frames, old, next), old);
            let outEvent = bfc-record-out(out, 0);
            let control = bfc-control(out, 5);
            let inEvent = bfc-record-in(control, 1);
            bfc-apply(out, control, old, next);
        }
        def fga-evolve-window(frames, old, tick) {
            let candidate = fga-min(FGAMaxWindow(), mul(old, 2));
            let next = fga-window-choice(frames, old, candidate);
            if eq(old, next) then old else fga-install-window(frames, old, next, tick);
        }

        // A small native observation grammar. Recipes bind carried schema/domain/unit,
        // never a text prompt or a call name from a publisher. New bindings are executable
        // cells, not generated files. No claim of arbitrary program invention is made.
        def fga-lens-key(record) = list(fga-get(record, "schema"), fga-get(record, "domain"), fga-get(record, "unit"));
        def fga-lens-same(a, b) = and(str_eq(nth(a, 0), nth(b, 0)), and(str_eq(nth(a, 1), nth(b, 1)), str_eq(nth(a, 2), nth(b, 2))));
        def fga-lens-find(recipes, key) = if eq(len(recipes), 0) then list() else if eq(fga-lens-same(fga-get(head(recipes), "binding"), key), 1) then head(recipes) else fga-lens-find(tail(recipes), key);
        def fga-recipe(key) {
            let node = fgo-field-node(bp("glass-attention-lens-v1"), list(intern_trivial_string(nth(key, 0)), intern_trivial_string(nth(key, 1)), intern_trivial_string(nth(key, 2)), intern_trivial_string("presence-freshness-state-capacity")), "form/form-stdlib/bml/form-glass-awareness.bml", 1, 1);
            list(fga-pair("binding", key), fga-pair("op", "observe"), fga-pair("node", node));
        }
        def fga-learn-to(records, recipes, limit) = if or(eq(len(records), 0), ge(len(recipes), limit)) then recipes else fga-learn-to(tail(records), if eq(len(fga-lens-find(recipes, fga-lens-key(head(records)))), 0) then cons(fga-recipe(fga-lens-key(head(records))), recipes) else recipes, limit);
        def fga-native-domain?(domain) = or(str_eq(domain, "recipe"), or(str_eq(domain, "symbol"), or(str_eq(domain, "token"), or(str_eq(domain, "cell"), str_eq(domain, "blueprint")))));
        def fga-classify(record) = if eq(fga-get(record, "present"), 0) then "observation-gap" else if eq(fga-get(record, "fresh"), 0) then "stale-source" else if eq(fga-get(record, "fresh"), -1) then "freshness-unproven" else if eq(fga-get(record, "fresh"), 2) then "catalog" else if or(str_eq(fga-get(record, "lifecycle"), "failed"), str_eq(fga-get(record, "lifecycle"), "error")) then "organ-failed" else if str_eq(fga-get(record, "lifecycle"), "blocked") then "restricted-flow" else if and(eq(fga-get(record, "numeric"), 1), and(gt(fga-get(record, "capacity"), 0), ge(fga-get(record, "value"), fga-get(record, "capacity")))) then "capacity-edge" else "observed";
        def fga-eval(recipe, record) = if eq(len(recipe), 0) then "lens-budget" else if not(str_eq(fga-get(recipe, "op"), "observe")) then "recipe-refused" else if not(eq(fga-lens-same(fga-get(recipe, "binding"), fga-lens-key(record)), 1)) then "binding-mismatch" else fga-classify(record);
        def fga-lens-correct(recipes, row) = str_eq(fga-eval(fga-lens-find(recipes, fga-lens-key(row)), row), fga-classify(row));
        def fga-lens-trials(rows, old, candidate) = if eq(len(rows), 0) then list() else cons(list(fga-lens-correct(old, head(rows)), fga-lens-correct(candidate, head(rows))), fga-lens-trials(tail(rows), old, candidate));
        def fga-lens-stages(rows, old, candidate) = if eq(len(rows), 0) then list() else cons(list(fga-pair("source", fga-get(head(rows), "source")), fga-pair("id", fga-get(head(rows), "id")), fga-pair("binding", fga-lens-key(head(rows))), fga-pair("before", fga-eval(fga-lens-find(old, fga-lens-key(head(rows))), head(rows))), fga-pair("after", fga-eval(fga-lens-find(candidate, fga-lens-key(head(rows))), head(rows)))), fga-lens-stages(tail(rows), old, candidate));
        def fga-install-recipes(old, candidate, trials, tick) {
            let out = bfc-envelope(0, add(tick, 100000), 0, trials, old);
            let sent = bfc-record-out(out, 0);
            let control = bfc-control(out, 5);
            let received = bfc-record-in(control, 1);
            bfc-apply(out, control, old, candidate);
        }
        def fga-evolve-recipes(rows, old, limit, tick) {
            let seated = fga-learn-to(rows, old, limit);
            let nextLimit = fga-min(FGAMaxRecipes(), mul(limit, 2));
            let candidate = fga-learn-to(rows, seated, nextLimit);
            let trials = fga-lens-trials(rows, seated, candidate);
            let wins = and(cc-exceeds?(trials), cc-promote?(trials, 1, 0));
            let chosen = psu-next-addr(limit, nextLimit, wins);
            let recipes = if eq(chosen, limit) then seated else fga-install-recipes(seated, candidate, trials, tick);
            list(fga-pair("recipes", recipes), fga-pair("limit", chosen), fga-pair("gift", if eq(chosen, limit) then 0 else 1), fga-pair("before", cc-champ-score(trials)), fga-pair("after", if eq(chosen, limit) then cc-champ-score(trials) else cc-chall-score(trials)), fga-pair("trials", trials), fga-pair("stages", if eq(chosen, limit) then list() else fga-lens-stages(rows, seated, recipes)));
        }
        def fga-key-same(a, b) = and(str_eq(fga-get(a, "source"), fga-get(b, "source")), and(str_eq(fga-get(a, "carrier"), fga-get(b, "carrier")), and(str_eq(fga-get(a, "domain"), fga-get(b, "domain")), str_eq(fga-get(a, "id"), fga-get(b, "id")))));
        def fga-prior(rows, row) = if eq(len(rows), 0) then list() else if eq(fga-key-same(head(rows), row), 1) then head(rows) else fga-prior(tail(rows), row);
        def fga-unseen(old, current) = if eq(len(old), 0) then list() else if eq(len(fga-prior(current, head(old))), 0) then cons(head(old), fga-unseen(tail(old), current)) else fga-unseen(tail(old), current);
        def fga-reason(row, prior, verdict) = if not(str_eq(verdict, "observed")) then verdict else if eq(len(prior), 0) then if eq(fga-native-domain?(fga-get(row, "domain")), 1) then "new-native-identity" else "new-interface" else if not(eq(fga-lens-same(fga-lens-key(row), fga-lens-key(prior)), 1)) then "grammar-changed" else if lt(fga-get(row, "seq"), fga-get(prior, "seq")) then "channel-restarted" else if not(str_eq(fga-get(prior, "verdict"), "observed")) then "flow-restored" else "observed";
        def fga-attention?(reason) = if str_eq(reason, "observed") then 0 else if str_eq(reason, "catalog") then 0 else if str_eq(reason, "new-interface") then 0 else if str_eq(reason, "new-native-identity") then 0 else if str_eq(reason, "flow-restored") then 0 else if str_eq(reason, "grammar-changed") then 0 else if str_eq(reason, "channel-restarted") then 0 else 1;
        def fga-action(reason) = if str_eq(reason, "lens-budget") then "expand-observation-grammar" else if str_eq(reason, "organ-failed") then "request-healing-actuator" else if str_eq(reason, "restricted-flow") then "inspect-blocked-organ" else if str_eq(reason, "capacity-edge") then "inspect-capacity-contract" else if eq(fga-attention?(reason), 1) then "request-evidence" else "continue";
        def fga-event(row, prior, reason, recipe, now) = append(list(fga-pair("reason", reason), fga-pair("action", fga-action(reason)), fga-pair("attention", fga-attention?(reason)), fga-pair("observed-at", now), fga-pair("before-seq", fga-or(prior, "seq", -1)), fga-pair("after-seq", fga-get(row, "seq")), fga-pair("recipe-node", fga-or(recipe, "node", nothing()))), row);
        def fga-assess(rows, old, recipes, now) = if eq(len(rows), 0) then list() else cons(fga-assess-one(head(rows), fga-prior(old, head(rows)), fga-lens-find(recipes, fga-lens-key(head(rows))), now), fga-assess(tail(rows), old, recipes, now));
        def fga-assess-one(row, prior, recipe, now) {
            let verdict = fga-eval(recipe, row);
            let reason = fga-reason(row, prior, verdict);
            let changed = if eq(len(prior), 0) then 1 else if not(str_eq(verdict, fga-get(prior, "verdict"))) then 1 else if or(str_eq(reason, "grammar-changed"), str_eq(reason, "channel-restarted")) then 1 else 0;
            append(list(fga-pair("verdict", verdict), fga-pair("changed", changed), fga-pair("event", fga-event(row, prior, reason, recipe, now))), row);
        }
        def fga-events(rows, attention) = if eq(len(rows), 0) then list() else if and(eq(fga-get(head(rows), "changed"), 1), eq(fga-get(fga-get(head(rows), "event"), "attention"), attention)) then cons(fga-get(head(rows), "event"), fga-events(tail(rows), attention)) else fga-events(tail(rows), attention);
        def fga-asks(rows) = if eq(len(rows), 0) then list() else if eq(fga-attention?(fga-get(head(rows), "verdict")), 1) then cons(fga-get(head(rows), "event"), fga-asks(tail(rows))) else fga-asks(tail(rows));
        def fga-state-empty() = list(fga-pair("tick", 0), fga-pair("window", FGAInitialWindow()), fga-pair("rows", list()), fga-pair("recipes", list()), fga-pair("events", list()), fga-pair("gifts", 0));
        def fga-step(frames, publisherCount, now, state) {
            let tick = add(fga-get(state, "tick"), 1);
            let oldWindow = fga-get(state, "window");
            let size = fga-evolve-window(frames, oldWindow, tick);
            let cursor = fga-or(state, "cursor", 0);
            let records = fga-records(frames, now, cursor, size);
            let evolution = fga-evolve-recipes(records, fga-get(state, "recipes"), fga-or(state, "recipe-limit", FGAInitialRecipes()), tick);
            let recipes = fga-get(evolution, "recipes");
            let rows = fga-assess(records, fga-get(state, "rows"), recipes, now);
            let events = append(fga-events(rows, 1), fga-events(rows, 0));
            let lastStages = if eq(fga-get(evolution, "gift"), 1) then fga-get(evolution, "stages") else fga-or(state, "recipe-stages", list());
            list(
                fga-pair("tick", tick), fga-pair("cursor", add(cursor, fga-effective-window(frames, size))),
                fga-pair("window", size), fga-pair("rows", take(FGAMaxRemembered(), append(rows, fga-unseen(fga-get(state, "rows"), rows)))),
                fga-pair("recipes", recipes), fga-pair("recipe-limit", fga-get(evolution, "limit")),
                fga-pair("recipe-before", fga-get(evolution, "before")), fga-pair("recipe-after", fga-get(evolution, "after")),
                fga-pair("recipe-stages", lastStages),
                fga-pair("events", take(FGAMaxEvents(), append(events, fga-get(state, "events")))),
                fga-pair("new-events", len(events)), fga-pair("asks", fga-asks(rows)),
                fga-pair("gifts", add(fga-get(state, "gifts"), add(fga-get(evolution, "gift"), if gt(size, oldWindow) then 1 else 0))),
                fga-pair("stages", fga-window-stages(frames, oldWindow, size)),
                fga-pair("before", fga-count(frames, oldWindow)), fga-pair("after", fga-count(frames, size)),
                fga-pair("unread-rows", sub(fga-total(frames), fga-count(frames, size))),
                fga-pair("unread-publishers", fga-max(0, sub(publisherCount, FGAMaxPublishers()))), fga-pair("epoch", now));
        }
        def fga-current(root, now, state) {
            let names = fga-names(root);
            fga-step(fga-collect(root, names, mul(fga-get(state, "tick"), FGAMaxPublishers())), len(names), now, state);
        }
        def fga-detail-door(root) = str_concat("glass.awareness.", root);
        // A source node may contain private children. Export its bound local identity,
        // not those children. Generated lenses contain only observation vocabulary.
        def fga-public-event(event) = if eq(len(event), 0) then list() else if str_eq(head(head(event)), "source-node") then cons(fga-pair("source-node-id", if nothing?(nth(head(event), 1)) then nothing() else fgo-node-id(nth(head(event), 1))), fga-public-event(tail(event))) else cons(head(event), fga-public-event(tail(event)));
        def fga-public-events(events) = if eq(len(events), 0) then list() else cons(fga-public-event(head(events)), fga-public-events(tail(events)));
        def fga-details(state) = list(
            fga-pair("epoch", fga-get(state, "epoch")), fga-pair("window", fga-get(state, "window")),
            fga-pair("events", fga-public-events(fga-get(state, "events"))), fga-pair("asks", fga-public-events(take(FGAMaxEvents(), fga-get(state, "asks")))),
            fga-pair("ask-count", len(fga-get(state, "asks"))), fga-pair("recipes", fga-get(state, "recipes")),
            fga-pair("recipe-limit", fga-get(state, "recipe-limit")), fga-pair("recipe-before", fga-get(state, "recipe-before")),
            fga-pair("recipe-after", fga-get(state, "recipe-after")),
            fga-pair("recipe-stages", take(FGAMaxEvents(), fga-get(state, "recipe-stages"))),
            fga-pair("recipe-stage-count", len(fga-get(state, "recipe-stages"))),
            fga-pair("stages", fga-get(state, "stages")), fga-pair("before", fga-get(state, "before")),
            fga-pair("after", fga-get(state, "after")), fga-pair("gifts", fga-get(state, "gifts")),
            fga-pair("unread-rows", fga-get(state, "unread-rows")), fga-pair("unread-publishers", fga-get(state, "unread-publishers")));
        def fga-give(root, state) {
            let handle = ggf-offer(fga-detail-door(root), FGSRFrameBytes());
            let given = if nothing?(handle) then nothing() else node_gift_write(handle, list(FGASchema(), fga-get(state, "epoch"), fga-details(state)));
            let released = ggf-release(handle);
            given;
        }
        def fga-read(root) {
            let handle = ggf-receive(fga-detail-door(root));
            let value = if nothing?(handle) then nothing() else node_gift_read(handle);
            let released = ggf-release(handle);
            value;
        }
        def fga-publish-row(id, kind, purpose, amount, heat, now, seq, frame, channels) = fgtm-sample(id, fgtm-absent(), kind, "membrane", "organs", "awareness", purpose, fgtm-absent(), fgtm-present(amount), if gt(heat, 0) then "active" else "ready", fgtm-present(now), fgtm-present(now), fgtm-present(heat), fgtm-present(seq), "never", "derived-window", frame, channels);
        def fga-summary(state, now, seq, frame) = list(
            fga-publish-row("awareness.coverage", "event", "rows-read-this-window", fga-get(state, "after"), 0, now, seq, frame, list("events", "awareness")),
            fga-publish-row("awareness.asks", "event", "requests-in-current-window", len(fga-get(state, "asks")), if gt(len(fga-get(state, "asks")), 0) then 1 else 0, now, seq, frame, list("events", "awareness")),
            fga-publish-row("awareness.gifts", "event", "attention-expansions-reobserved", fga-get(state, "gifts"), 0, now, seq, frame, list("events", "awareness")),
            fga-publish-row("awareness.unread", "event", "rows-outside-current-window", fga-get(state, "unread-rows"), 0, now, seq, frame, list("events", "awareness")),
            fga-publish-row("awareness.unread-publishers", "event", "publishers-outside-current-window", fga-get(state, "unread-publishers"), 0, now, seq, frame, list("events", "awareness")));
        def fga-label(value) = if eq(fgtm-label?(value), 1) then value else "see-native-detail";
        def fga-event-samples(events, index, now, seq, frame) = if eq(len(events), 0) then list() else cons(fga-publish-row(str_concat("awareness.event.", int_to_str(index)), "event", fga-get(head(events), "reason"), fga-max(0, fga-get(head(events), "after-seq")), fga-get(head(events), "attention"), fga-get(head(events), "observed-at"), seq, frame, list("events", "awareness", fga-action(fga-get(head(events), "reason")), fga-label(fga-get(head(events), "source")), fga-label(fga-get(head(events), "id")))), fga-event-samples(tail(events), add(index, 1), now, seq, frame));
        def fga-node-label(node) = fgtm-cat(list("n", int_to_str(node_pkg(node)), ".", int_to_str(node_level(node)), ".", int_to_str(node_type(node)), ".", int_to_str(node_inst(node))));
        def fga-recipe-samples(recipes, index, now, seq, frame) = if eq(len(recipes), 0) then list() else cons(fga-publish-row(str_concat("awareness.recipe.", int_to_str(index)), "recipe", fga-node-label(fga-get(head(recipes), "node")), 0, 0, now, seq, frame, list("recipe", "grammar", "awareness", fga-label(nth(fga-get(head(recipes), "binding"), 1)), fga-label(nth(fga-get(head(recipes), "binding"), 2)))), fga-recipe-samples(tail(recipes), add(index, 1), now, seq, frame));
        def fga-samples(state, now, seq, frame) = append(fga-summary(state, now, seq, frame), append(fga-event-samples(fga-get(state, "events"), 0, now, seq, frame), fga-recipe-samples(fga-get(state, "recipes"), 0, now, seq, frame)));
    }
    0;
}
