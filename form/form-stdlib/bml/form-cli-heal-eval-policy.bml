// Evaluation-only curriculum. Checkers are contracts; no gold patch is stored.
// witnessed: 2026-09-07 -> 511, four kernels
// preludes: form-stdlib/bml/form-cli-heal-policy.bml form-stdlib/json.fk
section [form.bml] {
    class FormCliHealEvaluationPolicy {
        field HealEvalVersion = "repair-evaluation-v1";
        field HealEvalTarget = "eval-subject.fk";
        field HealEvalChecker = "eval-check.fk";
        def fhe-prelude() = "; pre" ++ "ludes: form-stdlib/core.fk eval-subject.fk\n";
        // id, split, defect family, kind, original source, checker, exact stdout.
        def fhe-cases() = list(
            list("outer-close", "development", "outer-expression", "repair", "(do\n (defn eval-value () 19)\n", fhe-prelude() ++ "(eval-value)\n", "19"),
            list("quoted-close", "heldout", "lexical-context", "repair", "; misleading )) ((\n(do\n (defn eval-text () \"a(\\\"b\")\n", fhe-prelude() ++ "(str_len (eval-text))\n", "4"),
            list("nested-definition", "heldout", "definition-boundary", "repair", "(do\n (defn eval-first () 13\n (defn eval-second () 8))\n", fhe-prelude() ++ "(add (eval-first) (eval-second))\n", "21"),
            list("recursive-base", "heldout", "recursion-base", "semantic", "(defn eval-sum (xs) (if (nil? xs) 1 (add (head xs) (eval-sum (tail xs)))))\n", fhe-prelude() ++ "(add (if (eq (eval-sum (list)) 0) 1 0) (add (if (eq (eval-sum (list 4)) 4) 2 0) (if (eq (eval-sum (list -3 2 5)) 4) 4 0)))\n", "7"),
            list("positive-boundary", "heldout", "comparison-boundary", "semantic", "(defn eval-positive-count (xs) (if (nil? xs) 0 (add (if (ge (head xs) 0) 1 0) (eval-positive-count (tail xs)))))\n", fhe-prelude() ++ "(add (if (eq (eval-positive-count (list)) 0) 1 0) (add (if (eq (eval-positive-count (list 0)) 0) 2 0) (add (if (eq (eval-positive-count (list -4 0 3 8)) 2) 4 0) (add (if (eq (eval-positive-count (list -1 -2)) 0) 8 0) (if (eq (eval-positive-count (list -0.5 0 0.5)) 1) 16 0)))))\n", "31"),
            list("correct-control", "control", "preserve-correct-source", "control", "(defn eval-double (x) (mul x 2))\n", fhe-prelude() ++ "(add (if (eq (eval-double 0) 0) 1 0) (add (if (eq (eval-double -3) -6) 2 0) (if (eq (eval-double 7) 14) 4 0)))\n", "7")
        );
        def fhe-find(rows, id) = nil?(rows) ? list() : (String) head(head(rows)) == id ? head(rows) : fhe-find(tail(rows), id);
        def fhe-strings(xs) = nil?(xs) ? list() : cons(json-node-string(head(xs)), fhe-strings(tail(xs)));
        def fhe-json-rows(rows) = nil?(rows) ? list() : cons(json-node-array(fhe-strings(head(rows))), fhe-json-rows(tail(rows)));
        def fhe-manifest() = json-emit(json-node-object(list(json-node-pair("version", json-node-string(HealEvalVersion())), json-node-pair("target", json-node-string(HealEvalTarget())), json-node-pair("checker", json-node-string(HealEvalChecker())), json-node-pair("cases", json-node-array(fhe-json-rows(fhe-cases()))))));
        def fhe-request(fields) = (Comparable) len(fields) == 1 ? ((String) head(fields) == "eval") : (Comparable) len(fields) == 2 ? (((String) head(fields) == "eval") && ((String) fields[1] == "deterministic")) : (Comparable) len(fields) == 4 ? (((String) head(fields) == "eval") && (((String) fields[1] == "native") && ((!((String) fields[2] == "")) && ((Comparable) len(fhe-find(fhe-cases(), fields[3])) == 7)))) : 0;
        def fhe-outcome(kind, baseline, result, unchanged) = (String) kind == "control" ? (baseline && unchanged ? "preserved" : "regression") : baseline ? "invalid-case" : (Comparable) result == 1 ? "repaired" : (Comparable) result == -1 ? "refused-input-change" : "unresolved";
        def fhe-memory-allowed(evaluation) = (Comparable) evaluation == 0;
        def fhe-baseline-admissible(kind, status, clean) = (String) kind == "semantic" ? (((String) fh-trim(status) == "0") && clean) : 1;
    }
    0;
}
