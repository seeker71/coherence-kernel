// Evaluation-only curriculum. Checkers are contracts; no gold patch is stored.
// witnessed: 2026-09-07 -> 511, four kernels
// preludes: form-stdlib/bml/form-cli-heal-policy.bml form-stdlib/json.fk
section [form.bml] {
    class FormCliHealEvaluationPolicy {
        field HealEvalVersion = "repair-evaluation-v1";
        field HealEvalTarget = "eval-subject.fk";
        field HealEvalChecker = "eval-check.fk";
        def fhe-prelude() = str_concat("; pre", "ludes: form-stdlib/core.fk eval-subject.fk\n");
        // id, split, defect family, kind, original source, checker, exact stdout.
        def fhe-cases() = list(
            list("outer-close", "development", "outer-expression", "repair", "(do\n (defn eval-value () 19)\n", str_concat(fhe-prelude(), "(eval-value)\n"), "19"),
            list("quoted-close", "heldout", "lexical-context", "repair", "; misleading )) ((\n(do\n (defn eval-text () \"a(\\\"b\")\n", str_concat(fhe-prelude(), "(str_len (eval-text))\n"), "4"),
            list("nested-definition", "heldout", "definition-boundary", "repair", "(do\n (defn eval-first () 13\n (defn eval-second () 8))\n", str_concat(fhe-prelude(), "(add (eval-first) (eval-second))\n"), "21"),
            list("recursive-base", "heldout", "recursion-base", "semantic", "(defn eval-sum (xs) (if (nil? xs) 1 (add (head xs) (eval-sum (tail xs)))))\n", str_concat(fhe-prelude(), "(add (if (eq (eval-sum (list)) 0) 1 0) (add (if (eq (eval-sum (list 4)) 4) 2 0) (if (eq (eval-sum (list -3 2 5)) 4) 4 0)))\n"), "7"),
            list("positive-boundary", "heldout", "comparison-boundary", "semantic", "(defn eval-positive-count (xs) (if (nil? xs) 0 (add (if (ge (head xs) 0) 1 0) (eval-positive-count (tail xs)))))\n", str_concat(fhe-prelude(), "(add (if (eq (eval-positive-count (list)) 0) 1 0) (add (if (eq (eval-positive-count (list 0)) 0) 2 0) (add (if (eq (eval-positive-count (list -4 0 3 8)) 2) 4 0) (add (if (eq (eval-positive-count (list -1 -2)) 0) 8 0) (if (eq (eval-positive-count (list -0.5 0 0.5)) 1) 16 0)))))\n"), "31"),
            list("correct-control", "control", "preserve-correct-source", "control", "(defn eval-double (x) (mul x 2))\n", str_concat(fhe-prelude(), "(add (if (eq (eval-double 0) 0) 1 0) (add (if (eq (eval-double -3) -6) 2 0) (if (eq (eval-double 7) 14) 4 0)))\n"), "7")
        );
        def fhe-find(rows, id) = if nil?(rows) then list() else if str_eq(head(head(rows)), id) then head(rows) else fhe-find(tail(rows), id);
        def fhe-strings(xs) = if nil?(xs) then list() else cons(json-node-string(head(xs)), fhe-strings(tail(xs)));
        def fhe-json-rows(rows) = if nil?(rows) then list() else cons(json-node-array(fhe-strings(head(rows))), fhe-json-rows(tail(rows)));
        def fhe-manifest() = json-emit(json-node-object(list(json-node-pair("version", json-node-string(HealEvalVersion())), json-node-pair("target", json-node-string(HealEvalTarget())), json-node-pair("checker", json-node-string(HealEvalChecker())), json-node-pair("cases", json-node-array(fhe-json-rows(fhe-cases()))))));
        def fhe-request(fields) = if eq(len(fields), 1) then str_eq(head(fields), "eval") else if eq(len(fields), 2) then and(str_eq(head(fields), "eval"), str_eq(nth(fields, 1), "deterministic")) else if eq(len(fields), 4) then and(str_eq(head(fields), "eval"), and(str_eq(nth(fields, 1), "native"), and(not(str_eq(nth(fields, 2), "")), eq(len(fhe-find(fhe-cases(), nth(fields, 3))), 7)))) else 0;
        def fhe-outcome(kind, baseline, result, unchanged) = if str_eq(kind, "control") then if and(baseline, unchanged) then "preserved" else "regression" else if baseline then "invalid-case" else if eq(result, 1) then "repaired" else if eq(result, -1) then "refused-input-change" else "unresolved";
        def fhe-memory-allowed(evaluation) = eq(evaluation, 0);
        def fhe-baseline-admissible(kind, status, clean) = if str_eq(kind, "semantic") then and(str_eq(fh-trim(status), "0"), clean) else 1;
    }
    0;
}
