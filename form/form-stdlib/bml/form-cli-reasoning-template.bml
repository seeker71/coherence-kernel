// The ordinary scaffold remains authoritative; this profile leaves thought open.
// preludes: form-stdlib/qwen35-tokenizer-live-cursor.fk
section [form.bml] {
 class FormCliReasoningTemplate {
  def fcrt-profile?(profile) = str_eq(profile,"knowledge-query-reasoning");
  def fcrt-segments(prompt,crystal) = append(take(8,qtlc-chat-segments(prompt,crystal)),list(qtlc-id-segment(nth(crystal,6))));
  // Locate the actual closing token, not matching text inside a reasoning span.
  def fcrt-answer(ids,closing) = if nil?(ids) then list(0,list()) else if eq(head(ids),closing) then list(1,tail(ids)) else fcrt-answer(tail(ids),closing);
 }
 0;
}
