package Form.runtime.resourcegovernor;

import Form.kernel.*;

interface IFormResourceGovernor [public, witness, reusable] {
   section [public] {
      const String Schema = "form-resource-governor-v2";
      const String FrameRule = "active work and missing observation use a 250 millisecond frame; observed quiet uses a 500 millisecond frame";
      const String TargetRule = "each background grant targets 900 per 1000 of measured capacity minus measured foreground demand and measured reserve";
      const String MissingRule = "Glass v2 absent unavailable stale and error truths refuse optimistic grants; measured zero remains a value only with current physical-live process provenance";
      const String BackoffRule = "critical pressure revokes new grants in the current frame; warning pressure halves current grants in the current frame";
      const String RecoveryRule = "two clean frames precede additive recovery in bounded capacity-proportional steps with target hysteresis";
      const String StepRule = "one predicted-cost quantum returns done only after an observed worker completion; temporary contention yields and malformed or unsplittable work refuses";
      const String MetalRule = "one Form-native atomic fixed-path singleton admits at most one background Metal owner; critical pressure prevents every new admission without claiming cancellation of work already submitted";
      const String PermitRule = "an open offer becomes reserved only after host_dir_mkdir creates the fixed slot and exact owner bytes are written; occupied stale and unknown ownership fail closed and are never reclaimed speculatively";
      const String SubmitRule = "an already reserved owner may submit across a later observed critical frame only through a receipt bound to the exact command-buffer handle quantum permit publisher full process lifetime strictly advancing sequence and strictly advancing observation epoch; missing stale invalid or mismatched latest decisions refuse";
      const String CompletionRule = "Metal completion must repeat the exact submitted handle quantum permit submit sequence and submit epoch under the same advancing publisher lifetime before done clears the reservation";
      const String CpuScheduleRule = "nice and utility QoS are CPU-worker requests only; neither sets Metal priority nor proves host acceptance";
      const String RetentionRule = "models prefixes and KV remain resident while measured memory pressure is zero; missing pressure evidence grants no release authority";
      const String ReleaseRule = "supported pressure release order is JIT native page then whole inactive KV substate then inactive whole model";
      const String UnsupportedRule = "packed expert transformer layer and partial KV release are explicit unsupported seams until independent physical handles exist";

      Object Tick( Object state, Object sample ) [abstract];
      Object Step( Object decision, Object submitReceipt, Object quantum, Object usage, Object workerOutcome ) [abstract];
      Object PressureReleasePlan( Object pressure, int nRequiredBytes, Object units ) [abstract];
   }
}

class FormResourceGovernor [public, resident, flow, observable, teach] : IFormResourceGovernor {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-resource-governor.bml";
      const String AuthorityPath = "form/form-stdlib/bml/form-resource-governor.bml";
      const int ActiveFrameMilliseconds = 250;
      const int QuietFrameMilliseconds = 500;
      const int GrantScale = 1000;
      const int TargetGrant = 900;
      const int AdditiveRecoveryStep = 50;
      const int RecoveryCleanFrames = 2;
      const int FreshSignalFrames = 1;
      const int LatencyHalfMilliseconds = 250;
      const int LatencyStopMilliseconds = 500;
      const int MemoryPressureWarning = 1;
      const int MemoryPressureCritical = 2;
      const int ThermalHalf = 1;
      const int ThermalStop = 2;
      const int CpuNiceRequest = 10;
      const String CpuQosRequest = "utility";
      const int MaxBackgroundMetalInFlight = 1;

      Object Tick( Object state, Object sample ) [abstract] {}
      Object Step( Object decision, Object submitReceipt, Object quantum, Object usage, Object workerOutcome ) [abstract] {}
      Object PressureReleasePlan( Object pressure, int nRequiredBytes, Object units ) [abstract] {}
   }
}
