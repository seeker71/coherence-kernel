// Form owns source generation, version identity, cache selection and dispatch.
// The host adapter compiles the supplied source in RAM through Metal's API.
// FMJ1 | u32 mode | u32 entry bytes | u32 path bytes | entry | path | source.
// Modes: 0 RAM, 1 capture compiled archive, 2 require compiled archive hit,
// 3 retire the generation-qualified pipeline handle carried as a u64 payload.
// Disk is optional. A requested archive that fails is reported, never replaced.
// preludes: form-stdlib/metal-door.fk form-stdlib/sha256.fk form-stdlib/str-byte-at.fk form-stdlib/hex.fk
section [form.bml] {
 class MetalJit {
  def mj-source(body) = str_concat("#include <metal_stdlib>", str_concat(byte_to_str(10), str_concat("using namespace metal; ", body)));
  def mj-descriptor(source, entry, mode, path) = str_concat("FMJ1", str_concat(md-le32(mode), str_concat(md-le32(str_len(entry)), str_concat(md-le32(str_len(path)), str_concat(entry, str_concat(path, source))))));
  def mj-target() {
   let status = metal_status();
   let start = str_find(status, "metal_jit_target=", 0);
   let after = if lt(start, 0) then -1 else str_find(status, byte_to_str(10), start);
   if or(lt(start, 0), lt(after, 0)) then nothing() else substring(status, add(start, 17), after);
  }
  def mj-identity(source, entry, target) = hex-encode(sha256-stream-string(str_concat(md-le32(str_len(target)), str_concat(target, mj-descriptor(source, entry, 0, "")))));
  def mj-cache-path(directory, source, entry) {
   let target = mj-target();
   if nothing?(target) then nothing() else str_concat(directory, str_concat("/", str_concat(mj-identity(source, entry, target), ".metalbin")));
  }
  // A version holds its live pipeline and the exact program identity.
  def mj-admit(source, entry, mode, path) {
   let target = mj-target();
   let handle = if nothing?(target) then 0 else metal_pipeline(mj-descriptor(source, entry, mode, path), "form_metal_jit_v1");
   if le(handle, 0) then nothing() else list(handle, mj-identity(source, entry, target), source, entry, mode, path);
  }
  def mj-memory(source, entry) = mj-admit(source, entry, 0, "");
  def mj-cached(source, entry, directory) {
   let path = mj-cache-path(directory, source, entry);
   if nothing?(path) then nothing() else mj-admit(source, entry, if lt(file_size(path), 0) then 1 else 2, path);
  }
  def mj-handle(version) = if nothing?(version) then 0 else head(version);
  def mj-u64(value) = str_concat(md-le32(mod(value, 4294967296)), md-le32(div(value, 4294967296)));
  def mj-release-handle(handle) = if le(handle, 0) then 0 else metal_pipeline(mj-descriptor(mj-u64(handle), "", 3, ""), "form_metal_jit_v1");
  def mj-release(version) = mj-release-handle(mj-handle(version));
  def mj-enqueue(version, bindings, threads) = if le(mj-handle(version), 0) then 0 else metal_enqueue(mj-handle(version), bindings, threads);
  // The caller supplies its comparison domain and observed bytes. Selection
  // is a Form value: existing handles and submitted commands keep their version.
  def mj-select(candidate, expected, observed) = if and(gt(mj-handle(candidate), 0), str_eq(expected, observed)) then candidate else nothing();
  // Addresses map to independent records. Metadata never occupies the address
  // namespace, so every string is available to the caller. Exact source and
  // entry seals govern reuse; a different live program refuses replacement.
  def mj-thought-table() = record_new(0);
  def mj-thought-at(table, address) = if not(record?(table)) then nothing() else if not(record_has(table, address)) then nothing() else mj-thought-row(record_get(table, address), table, address);
  def mj-thought-row(row, table, address) = if not(record?(row)) then nothing() else if and(str_eq(record_get(row, "kind"), "metal-jit-thought"), and(eq(record_get(row, "owner"), table), str_eq(record_get(row, "address"), address))) then row else nothing();
  def mj-thought-recall(table, address) {
   let row = mj-thought-at(table, address);
   if nothing?(row) then -1 else record_get(row, "handle");
  }
  def mj-thought(table, address, source, entry, mode, path) {
   if not(record?(table)) then nothing() else if not(str_eq(value_kind(address), "string")) then nothing()
   else mj-thought-in(table, address, source, entry, mode, path);
  }
  def mj-thought-in(table, address, source, entry, mode, path) {
   let seal = mj-descriptor(source, entry, 0, "");
   let row = mj-thought-at(table, address);
   if and(record_has(table, address), nothing?(row)) then nothing()
   else if gt(mj-thought-recall(table, address), 0) then if str_eq(record_get(row, "seal"), seal) then table else nothing()
   else mj-thought-keep(table, address, seal, mj-admit(source, entry, mode, path));
  }
  def mj-thought-keep(table, address, seal, version) = if nothing?(version) then nothing() else record_set(table, address, record_new(0, "kind", "metal-jit-thought", "owner", table, "address", address, "handle", mj-handle(version), "seal", seal));
  // Retire only after native confirmation. A subsequent explicit thought call
  // can give the vacant address a new admission; the old handle stays stale.
  def mj-thought-release(table, address) = if le(mj-thought-recall(table, address), 0) then 0 else mj-thought-release-result(mj-thought-at(table, address), mj-release-handle(mj-thought-recall(table, address)));
  def mj-thought-release-result(row, released) {
   if eq(released, 1) then record_set(row, "handle", -1) else 0;
   if eq(released, 1) then record_set(row, "seal", "") else 0;
   released;
  }
 }
 0;
}
