// Metal admission for one Form process.
//
// A version is the admitted program. Its fields, in order, are:
//   handle    pipeline this process can enqueue
//   identity  digest of the device target, the source text and the kernel name
//   source    the MSL text that was admitted
//   entry     the kernel name
//   mode      0 compile in RAM, 2 load a file, 3 retire a handle, 4 copy the RAM archive
//   path      archive path, empty when the admission never touched a file
// The digest finds a candidate. A live hit still has to be the same source and
// the same kernel name. Two different programs that shared a digest stay two
// programs.
//
// Threads. Form evaluates on one walker thread. The process's other thread
// samples a time board and does not run Form. Metal runs the GPU, and its
// completion thread only signals a semaphore. It does not call back into this
// state. A second fkwu process has its own copy. Two processes may publish the
// same archive name: each writes a private temporary, then rename replaces the
// final name in one step. A reader opens that final name and checks the seal.
// This state has no lock. One walker is the whole of its safety. A second
// walker in this process would be a new design, and this record would not
// survive it.
//
// A miss compiles in RAM and returns that pipeline. The caller runs it.
// mj-publish-held later copies that same archive, seals it and renames it.
// This process does not compile into a file and does not load the file it
// just wrote. A later process loads the file only when the program is absent
// from its RAM and the file is present. If the copy never runs, that later
// process compiles again. The descriptor on the wire is FMJ1, then the mode,
// the entry length, the path length, the entry, the path and the source.
import form-stdlib/metal-door.fk;
import form-stdlib/sha256.fk;
import form-stdlib/str-byte-at.fk;
import form-stdlib/hex.fk;
import form-stdlib/organ-care.bml;
import form-stdlib/form-fs.fk;
import form-stdlib/bml/host-child.bml;
section [form.bml] {
 let MJ-CACHE-STATE = record_new(0, "writes", 0, "reading", nothing(), "pending", [], "failure", "", "live", []);
 let MJ-ARCHIVE-FOOTER-BYTES = 132;
 class MetalJit {
  def mj-source(body) = ("#include <metal_stdlib>" + (byte_to_str(10) + ("using namespace metal; " + body)));
  def mj-descriptor(source, entry, mode, path) = ("FMJ1" + (md-le32(mode) + (md-le32(len(entry)) + (md-le32(len(path)) + (entry + ((String) path + source))))));
  def mj-target() {
   let status = metal_status();
   let start = str_find(status, "metal_jit_target=", 0);
   let after = if (start < 0) then -1 else str_find(status, byte_to_str(10), start);
   if ((start < 0) || (after < 0)) then nothing() else substring(status, (start + 17), after);
  }
  def mj-identity(source, entry, target) = hex-encode(sha256-stream-string((md-le32(len(target)) + ((String) target + mj-descriptor(source, entry, 0, "")))));
  def mj-cache-path(directory, source, entry) {
   let target = mj-target();
   if nothing?(target) then nothing() else (directory + ("/" + (mj-identity(source, entry, target) + ".metalbin")));
  }
  // A version holds its live pipeline and the exact program identity.
  def mj-admit(source, entry, mode, path) {
   record_set(MJ-CACHE-STATE, "failure", "");
   let target = mj-target();
   let identity = nothing?(target) ? nothing() : mj-identity(source, entry, target);
   let valid = mode != 2 || mj-archive-held?(path, identity);
   !valid ? record_set(MJ-CACHE-STATE, "failure", "metal jit archive program identity or byte seal refused: " ++ path) : 0;
   let handle = nothing?(identity) || !valid ? 0 : metal_pipeline(mj-descriptor(source, entry, mode, path), "form_metal_jit_v1");
   handle <= 0 ? nothing() : [handle, identity, source, entry, mode, path];
  }
  // One self-contained Metal archive also carries Form's program identity and
  // a seal of the actual archive bytes. Loading its library must never replace
  // the caller's requested program with another program kept at the same path.
  def mj-archive-footer(bytes, identity) = "FMJS" ++ identity ++ hex-encode(sha256-stream-string(bytes ++ identity));
  def mj-archive-held?(path, identity) {
   let bytes = read_file(path);
   nothing?(bytes) || nothing?(identity) || len(bytes) <= MJ-ARCHIVE-FOOTER-BYTES ? 0 :
    (String) substring(bytes, len(bytes) - MJ-ARCHIVE-FOOTER-BYTES, len(bytes)) == mj-archive-footer(substring(bytes, 0, len(bytes) - MJ-ARCHIVE-FOOTER-BYTES), identity);
  }
  def mj-archive-seal(path, identity) {
   let bytes = read_file(path);
   nothing?(bytes) ? 0 : {
    let sealed = bytes ++ mj-archive-footer(bytes, identity);
    write_file_text(path, sealed) == len(sealed) && mj-archive-held?(path, identity);
   };
  }
  def mj-cache-diagnostic() = record_get(MJ-CACHE-STATE, "failure") ++ "\n" ++ metal_status();
  def mj-memory(source, entry) = mj-admit(source, entry, 0, "");
  // Ask by the program, not by the archive path. The path is only where a
  // later process will read the sealed copy.
  def mj-cached(source, entry, directory) {
   let target = mj-target();
   nothing?(target) ? nothing() : mj-cached-for(source, entry, target, directory);
  }
  def mj-cached-for(source, entry, target, directory) {
   let identity = mj-identity(source, entry, target);
   let held = mj-live-match(identity, source, entry);
   !nothing?(held) && mj-handle(held) > 0 ? held : mj-cache-open(source, entry, directory ++ "/" ++ identity ++ ".metalbin");
  }
  def mj-cache-reading(path, observed, health, cause, needs, offers) = oh-reading("metal-jit", path, "archive-retention", json-node-string("retained"), json-node-string(observed), json-node-int(health), needs, offers, json-node-string(cause));
  // Organ-care calls this as (context, stage, row). The row carries its own
  // stage. An observation becomes the publication's current reading.
  def mj-cache-emit(context, stage, row) {
   record_set(MJ-CACHE-STATE, "reading", row);
   (String) oh-str(row, "stage") == "observe" ? record_set(context, "reading", row) : 0;
   oh-frame(row);
  }
  def mj-cache-pending(path) = head(filter(context => (String) record_get(context, "path") == path, record_get(MJ-CACHE-STATE, "pending")));
  // One held admission is one program: same digest, same source, same kernel.
  def mj-same-program?(version, identity, source, entry) = (String) mj-version-identity(version) == identity && (String) mj-version-source(version) == source && (String) mj-version-entry(version) == entry;
  def mj-live-scan(identity, source, entry, rows) = nil?(rows) ? nothing() : mj-same-program?(rows[0][1], identity, source, entry) ? rows[0][1] : mj-live-scan(identity, source, entry, rows[1:]);
  def mj-live-match(identity, source, entry) = mj-live-scan(identity, source, entry, record_get(MJ-CACHE-STATE, "live"));
  def mj-live-keep(version, rows) = nil?(rows) ? [] : mj-same-program?(rows[0][1], mj-version-identity(version), mj-version-source(version), mj-version-entry(version)) ? mj-live-keep(version, rows[1:]) : cons(rows[0], mj-live-keep(version, rows[1:]));
  def mj-live-drop(handle, rows) = nil?(rows) ? [] : mj-handle(rows[0][1]) == handle ? mj-live-drop(handle, rows[1:]) : cons(rows[0], mj-live-drop(handle, rows[1:]));
  def mj-live-put(version) {
   record_set(MJ-CACHE-STATE, "live", cons([mj-version-identity(version), version], mj-live-keep(version, record_get(MJ-CACHE-STATE, "live"))));
   version;
  }
  def mj-cache-open(source, entry, path) {
   let present = file_size(path) >= 0;
   let found = present ? mj-admit(source, entry, 2, path) : nothing();
   nothing?(found) ? mj-cache-miss(source, entry, path, present ? mj-cache-diagnostic() : "archive absent") : mj-live-put(found);
  }
  // The caller receives the RAM pipeline here. The archive write stays pending.
  def mj-cache-miss(source, entry, path, cause) {
   let version = mj-admit(source, entry, 0, "");
   nothing?(version) ? mj-cache-uncompiled(source, entry, path, cause) : mj-cache-hold(source, entry, path, cause, version);
  }
  def mj-cache-hold(source, entry, path, cause, version) {
   let kept = mj-live-put(version);
   let context = record_new(0, "source", source, "entry", entry, "path", path, "version", version, "reading", nothing(), "cause", cause, "candidate", nothing(), "published", 0, "action", "publish-archive", "resource", "compiled-archive");
   record_set(MJ-CACHE-STATE, "pending", cons(context, record_get(MJ-CACHE-STATE, "pending")));
   let reading = mj-cache-reading(path, "publication-held", 1, cause, [oh-need("compiled-archive", json-node-string(path))], ["publish-archive"]);
   mj-cache-emit(context, "organ-health", reading);
   kept;
  }
  def mj-cache-uncompiled(source, entry, path, cause) {
   let context = record_new(0, "source", source, "entry", entry, "path", path, "version", nothing(), "reading", nothing(), "cause", cause, "candidate", nothing(), "published", 0, "action", "", "resource", "");
   record_set(MJ-CACHE-STATE, "pending", cons(context, record_get(MJ-CACHE-STATE, "pending")));
   let reading = mj-cache-reading(path, "archive-unavailable", 0, cause ++ "\n" ++ mj-cache-diagnostic(), [oh-need("compiled-archive", json-node-string(path))], []);
   mj-cache-emit(context, "organ-health", reading);
   nothing();
  }
  def mj-publish-held() = mj-publish-rows(record_get(MJ-CACHE-STATE, "pending"));
  def mj-publish-rows(rows) = nil?(rows) ? 1 : mj-publish-context(rows[0]) && mj-publish-rows(rows[1:]);
  def mj-publish-context(context) = (Comparable) record_get(context, "published") == 1 ? 1 : (String) record_get(context, "action") == "" ? 0 : mj-publish-now(context);
  def mj-publish-now(context) {
   mj-cache-care(context, record_get(context, "reading"), record_get(context, "resource"), record_get(context, "action"));
   (Comparable) record_get(context, "published") == 1;
  }
  def mj-cache-care(context, reading, resource, action) = oc-hear(context, reading, [oc-provider("metal-jit-archive", [resource], action, mj-cache-supply)], mj-cache-emit, mj-cache-observe);
  // Copy the archive the caller is already running. Seal that copy, then
  // rename it into place. The running pipeline stays the RAM one.
  def mj-cache-supply(context, reading, need) {
   let path = record_get(context, "path");
   let version = record_get(context, "version");
   let sequence = record_get(MJ-CACHE-STATE, "writes") + 1;
   record_set(MJ-CACHE-STATE, "writes", sequence);
   let temporary = path ++ ".writing-" ++ host_pid().str() ++ "-" ++ sequence.str();
   let made = hch-mkdirs(fs-path-dirname(path));
   let copied = mj-archive-store(mj-handle(version), temporary);
   let sealed = copied == 1 && mj-archive-seal(temporary, mj-version-identity(version));
   let published = sealed && host_path_rename(temporary, path) >= 0;
   let detail = published ? "archive copied" : copied != 1 ? mj-cache-diagnostic() : "archive copy refused: " ++ path;
   let removed = published ? 0 : host_path_remove(temporary);
   record_set(context, "candidate", nothing());
   record_set(context, "cause", record_get(context, "cause") ++ "\n" ++ detail);
   json-node-object([oh-n("published", published), oh-n("released", 1), oh-n("temporary_removed", file_size(temporary) < 0), oh-s("detail", detail)]);
  }
  // The copy is done when the sealed file is the archive that was compiled
  // in RAM. This step does not load that file. The next process loads it
  // when its own RAM does not already hold the program.
  def mj-cache-observe(context, reading, delivery) {
   let path = record_get(context, "path");
   let version = record_get(context, "version");
   let settled = json-int-value(oh-get(delivery, "published")) == 1;
   let ok = settled && !nothing?(version) && mj-archive-held?(path, mj-version-identity(version));
   record_set(context, "published", ok ? 1 : 0);
   let observed = ok ? "retained" : "publication-held";
   let cause = record_get(context, "cause") ++ (settled && !ok ? "\n" ++ mj-cache-diagnostic() : "");
   record_set(context, "action", ok ? "" : "retry-archive");
   record_set(context, "resource", ok ? "" : "writable-archive");
   let fresh = mj-cache-reading(path, observed, ok, cause, ok ? [] : [oh-need("writable-archive", json-node-string(path))], ok ? [] : ["retry-archive"]);
   oh-set(fresh, "care_of", oh-get(reading, "id"));
  }
  // A resource event resumes the original source, entry, path and findings.
  // Ordinary demand keeps an unchanged failure held; only a correlated offered
  // response enters care again. The RAM pipeline already returned stays put.
  def mj-cache-hear(path, response) {
   let context = mj-cache-pending(path);
   nothing?(context) ? nothing() : {
    let reading = record_get(context, "reading");
    (String) oh-select(reading, response, "") != "retry-archive" ? nothing() : {
     record_set(context, "action", "retry-archive");
     record_set(context, "resource", "writable-archive");
     mj-cache-care(context, reading, "writable-archive", "retry-archive");
     record_get(context, "version");
    };
   };
  }
  def mj-handle(version) = if nothing?(version) then 0 else version[0];
  def mj-version-identity(version) = version[1];
  def mj-version-source(version) = version[2];
  def mj-version-entry(version) = version[3];
  def mj-u64(value) = ((String) md-le32((value % 4294967296)) + md-le32((value / 4294967296)));
  def mj-release-handle(handle) = if (handle <= 0) then 0 else metal_pipeline(mj-descriptor(mj-u64(handle), "", 3, ""), "form_metal_jit_v1");
  // Copy the archive this handle already compiled. The answer is 1 when the
  // file holds that archive. It is not a second compile and not a new pipeline.
  def mj-archive-store(handle, path) = handle <= 0 ? 0 : metal_pipeline(mj-descriptor("", mj-u64(handle), 4, path), "form_metal_jit_v1");
  def mj-release(version) {
   let handle = mj-handle(version);
   let released = mj-release-handle(handle);
   (Comparable) released == 1 ? record_set(MJ-CACHE-STATE, "live", mj-live-drop(handle, record_get(MJ-CACHE-STATE, "live"))) : 0;
   released;
  }
  def mj-enqueue(version, bindings, threads) = if (mj-handle(version) <= 0) then 0 else metal_enqueue(mj-handle(version), bindings, threads);
  // The caller supplies its comparison domain and observed bytes. Selection
  // is a Form value: existing handles and submitted commands keep their version.
  def mj-select(candidate, expected, observed) = if ((mj-handle(candidate) > 0) && ((String) expected == observed)) then candidate else nothing();
  // A thought record belongs to its caller. The address is the caller's name
  // for a slot. The seal is the source and the kernel name. The same address
  // with a different program is refused, and the old handle is left in place.
  // Releasing a thought does not touch the live cache above. Same walker rule:
  // the caller does not share this record with another thread.
  def mj-thought-table() = record_new(0);
  def mj-thought-at(table, address) = if (!record?(table)) then nothing() else if (!record_has(table, address)) then nothing() else mj-thought-row(record_get(table, address), table, address);
  def mj-thought-row(row, table, address) = if (!record?(row)) then nothing() else if (((String) record_get(row, "kind") == "metal-jit-thought") && (((Comparable) record_get(row, "owner") == table) && ((String) record_get(row, "address") == address))) then row else nothing();
  def mj-thought-recall(table, address) {
   let row = mj-thought-at(table, address);
   if nothing?(row) then -1 else record_get(row, "handle");
  }
  def mj-thought(table, address, source, entry, mode, path) {
   if (!record?(table)) then nothing() else if (!((String) value_kind(address) == "string")) then nothing()
   else mj-thought-in(table, address, source, entry, mode, path);
  }
  def mj-thought-in(table, address, source, entry, mode, path) {
   let seal = mj-descriptor(source, entry, 0, "");
   let row = mj-thought-at(table, address);
   if (record_has(table, address) && nothing?(row)) then nothing()
   else if (mj-thought-recall(table, address) > 0) then if ((String) record_get(row, "seal") == seal) then table else nothing()
   else mj-thought-keep(table, address, seal, mj-admit(source, entry, mode, path));
  }
  def mj-thought-keep(table, address, seal, version) = if nothing?(version) then nothing() else record_set(table, address, record_new(0, "kind", "metal-jit-thought", "owner", table, "address", address, "handle", mj-handle(version), "seal", seal));
  // Retire only after native confirmation. A subsequent explicit thought call
  // can give the vacant address a new admission; the old handle stays stale.
  def mj-thought-release(table, address) = if (mj-thought-recall(table, address) <= 0) then 0 else mj-thought-release-result(mj-thought-at(table, address), mj-release-handle(mj-thought-recall(table, address)));
  def mj-thought-release-result(row, released) {
   if ((Comparable) released == 1) then record_set(row, "handle", -1) else 0;
   if ((Comparable) released == 1) then record_set(row, "seal", "") else 0;
   released;
  }
 }
 0;
}
