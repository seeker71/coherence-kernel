// Form owns source generation, version identity, cache selection and dispatch.
// The host adapter compiles the supplied source in RAM through Metal's API.
// FMJ1 | u32 mode | u32 entry bytes | u32 path bytes | entry | path | source.
// Modes: 0 RAM, 1 capture compiled archive, 2 require compiled archive hit,
// 3 retire the generation-qualified pipeline handle carried as a u64 payload.
// Disk is optional. A requested archive that fails is reported, never replaced.
// preludes: form-stdlib/metal-door.fk form-stdlib/sha256.fk form-stdlib/str-byte-at.fk form-stdlib/hex.fk
section [form.bml] {
 class MetalJit {
  def mj-source(body) = "#include <metal_stdlib>" ++ byte_to_str(10) ++ "using namespace metal; " ++ body;
  def mj-descriptor(source, entry, mode, path) = "FMJ1" ++ md-le32(mode) ++ md-le32(str_len(entry)) ++ md-le32(str_len(path)) ++ entry ++ path ++ source;
  def mj-target() {
   let status = metal_status();
   let start = str_find(status, "metal_jit_target=", 0);
   let after = start < 0 ? -1 : str_find(status, byte_to_str(10), start);
   (start < 0) || (after < 0) ? nothing() : substring(status, start + 17, after);
  }
  def mj-identity(source, entry, target) = hex-encode(sha256-stream-string(md-le32(str_len(target)) ++ target ++ mj-descriptor(source, entry, 0, "")));
  def mj-cache-path(directory, source, entry) {
   let target = mj-target();
   nothing?(target) ? nothing() : directory ++ "/" ++ mj-identity(source, entry, target) ++ ".metalbin";
  }
  // A version holds its live pipeline and the exact program identity.
  def mj-admit(source, entry, mode, path) {
   let target = mj-target();
   let handle = nothing?(target) ? 0 : metal_pipeline(mj-descriptor(source, entry, mode, path), "form_metal_jit_v1");
   handle <= 0 ? nothing() : list(handle, mj-identity(source, entry, target), source, entry, mode, path);
  }
  def mj-memory(source, entry) = mj-admit(source, entry, 0, "");
  def mj-cached(source, entry, directory) {
   let path = mj-cache-path(directory, source, entry);
   nothing?(path) ? nothing() : mj-admit(source, entry, file_size(path) < 0 ? 1 : 2, path);
  }
  def mj-handle(version) = nothing?(version) ? 0 : head(version);
  def mj-u64(value) = md-le32(value % 4294967296) ++ md-le32(value / 4294967296);
  def mj-release-handle(handle) = handle <= 0 ? 0 : metal_pipeline(mj-descriptor(mj-u64(handle), "", 3, ""), "form_metal_jit_v1");
  def mj-release(version) = mj-release-handle(mj-handle(version));
  def mj-enqueue(version, bindings, threads) = mj-handle(version) <= 0 ? 0 : metal_enqueue(mj-handle(version), bindings, threads);
  // The caller supplies its comparison domain and observed bytes. Selection
  // is a Form value: existing handles and submitted commands keep their version.
  def mj-select(candidate, expected, observed) = (mj-handle(candidate) > 0) && ((String) expected == observed) ? candidate : nothing();
  // Addresses map to independent records. Metadata never occupies the address
  // namespace, so every string is available to the caller. Exact source and
  // entry seals govern reuse; a different live program refuses replacement.
  def mj-thought-table() = record_new(0);
  def mj-thought-at(table, address) = !record?(table) ? nothing() : !record_has(table, address) ? nothing() : mj-thought-row(record_get(table, address), table, address);
  def mj-thought-row(row, table, address) = !record?(row) ? nothing() : ((String) record_get(row, "kind") == "metal-jit-thought") && (((Comparable) record_get(row, "owner") == table) && ((String) record_get(row, "address") == address)) ? row : nothing();
  def mj-thought-recall(table, address) {
   let row = mj-thought-at(table, address);
   nothing?(row) ? -1 : record_get(row, "handle");
  }
  def mj-thought(table, address, source, entry, mode, path) {
   !record?(table) ? nothing() : !((String) value_kind(address) == "string") ? nothing()
   : mj-thought-in(table, address, source, entry, mode, path);
  }
  def mj-thought-in(table, address, source, entry, mode, path) {
   let seal = mj-descriptor(source, entry, 0, "");
   let row = mj-thought-at(table, address);
   record_has(table, address) && nothing?(row) ? nothing()
   : mj-thought-recall(table, address) > 0 ? ((String) record_get(row, "seal") == seal ? table : nothing())
   : mj-thought-keep(table, address, seal, mj-admit(source, entry, mode, path));
  }
  def mj-thought-keep(table, address, seal, version) = nothing?(version) ? nothing() : record_set(table, address, record_new(0, "kind", "metal-jit-thought", "owner", table, "address", address, "handle", mj-handle(version), "seal", seal));
  // Retire only after native confirmation. A subsequent explicit thought call
  // can give the vacant address a new admission; the old handle stays stale.
  def mj-thought-release(table, address) = mj-thought-recall(table, address) <= 0 ? 0 : mj-thought-release-result(mj-thought-at(table, address), mj-release-handle(mj-thought-recall(table, address)));
  def mj-thought-release-result(row, released) {
   (Comparable) released == 1 ? record_set(row, "handle", -1) : 0;
   (Comparable) released == 1 ? record_set(row, "seal", "") : 0;
   released;
  }
 }
 0;
}
