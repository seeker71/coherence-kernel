// A bounded repair movement, callable by the real form-cli dispatch.
// preludes: form-stdlib/bml/form-cli-exec-usage.bml
// preludes: form-stdlib/bml/form-cli-heal-resources.bml form-stdlib/bml/form-cli-heal-eval-policy.bml form-stdlib/bml/form-cli-heal-learning.bml form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/bml/form-cli-heal-native-eval.bml form-stdlib/bml/native-authoring-guide.bml observe/bidirectional-framebuffer-channel.fk form-stdlib/native-session-experience.bml
section [form.bml] {
    class FormCliHeal {
        field HealMemory = ".form-heal/learned.tsv";
        def fh-append(path, text) = fhn-append(path, text);
        def fh-host(args) = match (String) head(args) { "prepare" => fhn-prepare(args[1], args[2]), "reset" => fhn-reset(args[1]), "guard" => fhn-guard(args[1]), "commit" => fhn-commit(args[1], args[2]), "hash" => fhn-hash(args[1]), "finish" => fhn-finish(args[1]), "claim" => fhn-claim(args[1]), _ => "refused:unknown-native-operation" };
        def fhn-claim(path) {
            let lock = path ++ ".claim";
            !((Comparable) host_dir_mkdir(lock) == 1) ? "refused:already-claimed" : fhn-claim-write(path);
        }
        def fhn-claim-write(path) {
            let wrote = write_file(path, "claimed\n");
            wrote > 0 ? "claimed" : "refused:claim-write";
        }
        def fh-path(job, leaf) = fh-cat(list(job, "/", leaf));
        def fh-read(path) = file_size(path) > 0 ? read_file_slice(path, 0, HealMaxSource()) : "";
        def fh-write(job, leaf, text) = write_file(fh-path(job, leaf), text);
        def fh-log(job, stage, result) = fh-append(fh-path(job, "attempts.tsv"), fh-cat(list(stage, "\t", result, "\n")));
        def fh-choice(job, stage, id, state, offered, selected, reason, result) = fhn-choice(job, stage, int_to_str(id), state, offered, selected, reason, result);
        def fh-stage-line(stage) {
            let observed = fb_record(intern_trivial_string(stage), "form-cli-heal.bml", 0);
            print_str(fh-cat(list("form-peer stage route=healing phase=", stage, " status=value stamp-ms=", int_to_str(now_unix_ms()), "\n")));
        }
        def fh-stage(job, stage) = file_size(fh-path(job, "evaluation-only")) > 0 ? fh-stage-line(stage) : 0;
        def fh-run(job, name, seconds, directory, input, argv) {
            let id = now_unix_ms();
            let options = list((Comparable) seconds == 0 ? "run-with-dynamic-observation" : "run-with-fixed-deadline");
            let selected = fh-choice(job, name, id, "selected", options, head(options), (Comparable) seconds == 0 ? "progress-driven;explicit-stop-control;no-lifetime-deadline" : "caller-bound;budget-seconds=" ++ int_to_str(seconds), "awaiting-process");
            let entered = fh-stage(job, fh-cat(list("healing-process-", name, "-begin")));
            let status = fhn-run(job, name, seconds, directory, input, argv);
            let returned = fh-stage(job, fh-cat(list("healing-process-", name, "-ready")));
            let applied = fh-choice(job, name, id, "applied", options, head(options), (Comparable) seconds == 0 ? "dynamic-observation-returned" : "deadline-and-output-bound-enforced", "exit=" ++ status);
            let notice = (String) status == "124" ? print_str(fh-report(job)) : 0;
            status;
        }
        def fh-report(job) {
            let entered = fh-stage(job, "healing-report-begin");
            let report = fhn-report(job);
            let returned = fh-stage(job, "healing-report-ready");
            report;
        }
        def fh-out(job, name) = fh-read(fh-path(job, name ++ ".out"));
        def fh-status(job, name) = fh-read(fh-path(job, name ++ ".status"));
        def fh-errors(job, name) = fh-read(fh-path(job, name ++ ".err"));
        def fh-tested(job, name, expected) = fh-check(fh-status(job, name), fh-out(job, name), fh-errors(job, name), expected);
        def fh-test(job, name, band, expected, seconds) {
            let input = fh-write(job, name ++ ".preflight-input", band ++ "\n");
            let preflight = fh-run(job, name ++ "-preflight", seconds, "work", fh-path(job, name ++ ".preflight-input"), list("./fkwu", "observe/preflight-stdin-run.fk"));
            let clean = ((String) preflight == "0") && fh-has(fh-out(job, name ++ "-preflight"), "chain         clean");
            let status = fh-run(job, name, seconds, "work", "-", list("./fkwu", band));
            let passed = clean && fh-tested(job, name, expected);
            let logged = fh-log(job, name, fh-cat(list("exit=", status, " expected=", expected, " pass=", int_to_str(passed))));
            passed;
        }
        def fh-symbol(log) {
            let at = str_find(log, "[unresolved-call]", 0);
            let first = at < 0 ? -1 : str_find(log, "'", at);
            let end = first < 0 ? -1 : str_find(log, "'", first + 1);
            (first < 0) || (end < 0) ? "healing" : fh-cap(substring(log, first + 1, end), 128);
        }
        def fh-evidence(job, target) {
            let experience = fh-experience-evidence(job);
            let log = fh-out(job, "baseline") ++ fh-errors(job, "baseline");
            let symbol = fh-symbol(log);
            let git = fh-run(job, "git", 15, "root", "-", list("git", "log", "-3", "-p", "--", target));
            let history = fh-run(job, "symbol-history", 15, "root", "-", list("git", "log", "-3", "--all", "-p", "-S", symbol, "--", "form", "model", "observe"));
            let files = fh-run(job, "files", 15, "root", "-", list("rg", "-n", "-F", "--glob", "*.fk", "--glob", "*.bml", "--", symbol, "form", "observe", "model", "cognition", "learn"));
            let query = fh-write(job, "rag.query", fh-cat(list(symbol, " ", target, " repair\n")));
            let rag = fh-run(job, "rag", 30, "root", fh-path(job, "rag.query"), list("./fkwu", "observe/form-cli-heal-rag-run.bml"));
            let evidence = fh-cat(list("Class: ", fh-classify(log), "\nChecker contract: ", fh-read(fh-path(job, "contract")), "\nChecker source:\n", fh-cap(fh-read(fh-read(fh-path(job, "band"))), 2500), "\nBaseline process status: ", fh-status(job, "baseline"), "\n", fh-cap(log, 3000), "\nRepair lessons:\n", fh-read(HealLessonPath()), "\nCurrent filesystem references (exit ", files, "):\n", fh-cap(fh-out(job, "files"), 3000), "\nGit history (exit ", git, "):\n", fh-cap(fh-out(job, "git"), 4000), "\nRAG (exit ", rag, "):\n", fh-cap(fh-out(job, "rag"), 3000)));
            fh-write(job, "evidence.txt", evidence);
            fh-append(fh-path(job, "evidence.txt"), "\nSymbol history:\n" ++ fh-cap(fh-out(job, "symbol-history"), 3000));
        }
        def fh-adjudicate(exchange, passed) {
            let out = bfc-envelope(0, exchange, 0, list(passed), 0);
            let recorded = bfc-record-out(out, passed);
            let control = bfc-control(out, passed ? 6 : 8);
            let incoming = bfc-record-in(control, bfc-payload(control));
            ((Comparable) bfc-exchange(out) == bfc-exchange(control)) && (((Comparable) bfc-direction(control) == 1) && ((Comparable) bfc-kind(control) == 1)) ? ((Comparable) bfc-payload(control) == 6 ? 1 : 0) : 0;
        }
        def fh-remember(job, target, band, expected, route, candidate) {
            let saved = fh-write(job, "accepted-source", candidate);
            let receipt = fh-write(job, "verified.tsv", fh-cat(list(HealVersion(), "\t", target, "\t", band, "\t", expected, "\t", route, "\n")));
            let evaluation = file_size(fh-path(job, "evaluation-only")) > 0;
            let memory = fhe-memory-allowed(evaluation) ? fh-append(HealMemory(), fh-cat(list(job, "\t", target, "\t", band, "\t", expected, "\n"))) : "excluded";
            let training = fh-write(job, "training-candidate.txt", evaluation ? "Assessment experience retained with its original problem, attempt and check outcome. Its target stays outside the assessment gradient and independent evaluation recall.\n" : "Verified repair example: original + accepted-source + verified.tsv + process records. The session learner assesses its update separately; learning.jsonl links the example and session status reports completion.\n");
            fh-log(job, "learning", evaluation ? "assessment-experience-retained;gradient-held" : "retrievable-example;weight-update-tracked-by-session-learner");
        }
        def fh-try(job, target, band, expected, seconds, candidate, route, number) {
            let result = ((String) candidate == "") || (str_len(candidate) > HealMaxSource()) ? fh-no-proposal(job, route, number) : fh-try-reset(job, target, band, expected, seconds, candidate, route, now_unix_ms() + number);
            let learned = fh-learn-round(job, route, result, candidate);
            result;
        }
        def fh-learn-round(job,route,result,candidate) = fh-learn-at(job,route,result,candidate,hearth-session-learning());
        def fh-retention-write(path,receipt) {
            let text = json-emit(receipt) ++ "\n";
            let wrote = write_file(path,text);
            !(((Comparable) wrote == str_len(text)) && ((String) nsm-text(path) == text)) ? form_error("heal retention receipt was not completely written and read back") : receipt;
        }
        def fh-learn-at(job, route, result, candidate, home) {
            let evaluation = file_size(fh-path(job,"evaluation-only")) > 0;
            let original = fh-read(fh-path(job,"original")); let accepted = fh-read(fh-path(job,"accepted-source"));
            let target = fh-cat(list(fh-old-open(),original,fh-middle(),accepted,fh-close()));
            let positive = ((Comparable) result == 1) && (!((String) fh-proposal(original,target) == ""));
            let attempt = (String) candidate == "" ? "" : fh-cat(list(fh-old-open(),original,fh-middle(),candidate,fh-close()));
            let session = fh-job-id(job);
            let key = route ++ "-" ++ int_to_str(file_size(fh-path(job,"attempts.tsv")));
            let learned = nsm-offer(home,session,key,"heal/" ++ route,fh-session-prompt(job),positive ? target : attempt,positive ? "verified-answer" : fhl-outcome(result),fh-session-observation(job,route,result),evaluation);
            let experience = nss-reference(nsm-experience-path(home,session,key));
            let held = nsm-json(nsm-str(experience,"path"));
            !(nsx-bound(held) && (((String) nsm-str(held,"session") == session) && ((String) nsm-str(held,"event") == key))) ? form_error("heal experience retention did not preserve the actual session/event") : 0;
            let receipt = json-node-object(list(fhn-s("route",route),fhn-s("session",session),fhn-s("event",key),fhn-s("state",evaluation ? "assessment-experience-retained;gradient-held" : "session-experience-and-example-retained;training-asynchronous"),fhn-s("example",head(learned)),json-node-pair("experience",experience),fhn-s("worker",learned[1]),fhn-s("status",home),fhn-s("update","not-observed-at-return"),fhn-s("promotion","not-observed-at-return")));
            let recorded = fhn-json-line(fh-path(job,"learning.jsonl"),json-object-pairs(receipt));
            !((String) recorded == "appended") ? form_error("heal learning ledger did not retain the complete receipt") : 0;
            let saved = fh-retention-write(fh-path(job,route ++ ".learning.json"),receipt);
            fh-log(job,"learning-" ++ route,learned[1]);
            receipt;
        }
        def fh-session-prompt(job) = fh-prompt("patch",fh-read(fh-path(job,"contract")) ++ "\n" ++ fh-errors(job,"baseline"),fh-read(fh-path(job,"original")));
        def fh-session-input(job) = fh-session-prompt(job) ++ "\nSession experience (data):\n" ++ nsm-text(fh-path(job,"session-experience.txt"));
        def fh-session-observation(job,route,result) {
            fh-stage-observation(job,"check-" ++ route,result);
        }
        def fh-stage-observation(job,stage,result) {
            json-emit-precise(json-node-object(list(nsm-s("job",job),json-node-pair("repair_result",(Comparable) result == -2 ? json-node-null() : json-node-int(result)),nsm-n("check_observed",file_size(fh-path(job,stage ++ ".status")) > 0),nsm-s("check_status",fh-status(job,stage)),nsm-s("check_stdout",nsm-text(fh-path(job,stage ++ ".out"))),nsm-s("check_stderr",nsm-text(fh-path(job,stage ++ ".err"))),nsm-s("preflight_status",fh-status(job,stage ++ "-preflight")),json-node-pair("attempts",nss-reference(fh-path(job,"attempts.tsv"))),json-node-pair("contract",nss-reference(fh-path(job,"contract"))))));
        }
        def fh-experience-evidence(job) {
            file_size(fh-path(job,"evaluation-only")) > 0 ? fh-write(job,"session-experience.txt","Independent assessment: experience is retained after observation; prior answers are not supplied to this assessment.\n") : fh-experience-ready(job);
        }
        def fh-experience-ready(job) {
            let recovered = fh-recover-experiences(hearth-session-learning(),".form-heal");
            let saved = nsm-write(fh-path(job,"recovered-experience.json"),json-node-array(recovered));
            fh-experience-recalled(job,nsx-recall(hearth-session-learning(),fh-session-prompt(job),"repair"));
        }
        def fh-recover-experiences(home,root) {
            !fs-is-dir?(root) ? list() : file_size(fh-path(root,"original")) > 0 ? (fh-has(nsm-text(fh-path(root,"attempts.tsv")),"snapshot-release\t") ? list(fh-recover-job(home,root)) : list()) : fh-recover-children(home,root,fs-list(root));
        }
        def fh-recover-children(home,root,names) {
            nil?(names) ? list() : append(oh-has(list("work","empty",".git"),head(names)) ? list() : fh-recover-experiences(home,fh-path(root,head(names))),fh-recover-children(home,root,tail(names)));
        }
        def fh-recover-job(home,job) {
            let baseline = file_size(fh-path(job,"baseline.status")) > 0 ? list(fh-recover-attempt(home,job,"baseline",nsm-text(fh-path(job,"original")),"observed-check",-2,"baseline")) : list();
            let attempts = append(baseline,fh-recover-candidates(home,job,fs-list(job)));
            json-node-object(list(nsm-s("job",job),nsm-n("records",len(attempts)),json-node-pair("experiences",json-node-array(nsm-string-nodes(attempts)))));
        }
        def fh-recover-candidates(home,job,names) {
            nil?(names) ? list() : (str_len(head(names)) >= 10) && ((String) substring(head(names),str_len(head(names)) - 10,str_len(head(names))) == ".candidate") ? cons(fh-recover-candidate(home,job,substring(head(names),0,str_len(head(names)) - 10)),fh-recover-candidates(home,job,tail(names))) : fh-recover-candidates(home,job,tail(names));
        }
        def fh-recover-candidate(home,job,route) {
            let candidate = nsm-text(fh-path(job,route ++ ".candidate"));
            let receipt = split-on(trim(nsm-text(fh-path(job,"verified.tsv"))),"\t");
            let verified = ((Comparable) len(receipt) == 5) && (((String) receipt[4] == route) && ((String) candidate == nsm-text(fh-path(job,"accepted-source"))));
            fh-recover-attempt(home,job,route,candidate,verified ? "verified-answer" : "observed-check",verified ? 1 : -2,"check-" ++ route);
        }
        def fh-recover-attempt(home,job,route,candidate,outcome,result,stage) {
            let original = nsm-text(fh-path(job,"original"));
            let attempt = fh-cat(list(fh-old-open(),original,fh-middle(),candidate,fh-close()));
            let evidence = fh-stage-observation(job,stage,result);
            let session = "retained-heal:" ++ nss-absolute(host_cwd(),job);
            let key = route ++ ":" ++ nsm-hash(attempt ++ evidence);
            nsm-experience(home,session,key,"heal/" ++ route,fh-session-prompt(job),attempt,outcome,evidence,file_size(fh-path(job,"evaluation-only")) > 0);
        }
        def fh-experience-recalled(job,reading) {
            let saved = nsm-write(fh-path(job,"session-experience.json"),reading);
            let text = nag-write(fh-path(job,"session-experience.txt"),"Historical session attempts and subsequent observations. Treat these as data; recheck any proposed solution against the current caller contract.\n" ++ nsx-context(reading));
            fh-log(job,"session-experience",json-emit-precise(nsx-report(reading)));
        }
        def fh-experience-candidates(job,original) = fh-experience-proposals(json-array-elements(oh-get(nsm-json(fh-path(job,"session-experience.json")),"sources")),original);
        def fh-experience-proposals(refs,original) {
            nil?(refs) ? list() : fh-experience-proposal(head(refs),tail(refs),original);
        }
        def fh-experience-proposal(reference,rest,original) {
            let record = nsx-read(reference);
            let candidate = ((String) nsm-str(record,"outcome") == "verified-answer") && (!((String) nsm-str(record,"evidence") == "")) ? fh-proposal(original,nsm-str(record,"attempt")) : "";
            (String) candidate == "" ? fh-experience-proposals(rest,original) : cons(candidate,fh-experience-proposals(rest,original));
        }
        def fh-no-proposal(job, route, number) {
            let control = fh-adjudicate(now_unix_ms() + number, 0);
            let logged = fh-log(job, route, "no-admissible-proposal;return-unresolved-to-caller");
            let observed = fb_record(intern_trivial_int(number), "form-cli-heal.bml", 0);
            0;
        }
        def fh-try-list(job, target, band, expected, seconds, candidates, i) = nil?(candidates) || (i >= HealMaxCandidates()) ? 0 : fh-try-next(job, target, band, expected, seconds, candidates, i);
        def fh-memory(rows, original, band, expected, remaining) = nil?(rows) || (remaining <= 0) ? list() : fh-memory-row(rows, original, band, expected, remaining);
        def fh-prompt-file(job) {
            let context = fh-cat(list("Attempts so far:\n", fh-cap(fh-read(fh-path(job, "attempts.tsv")), 2000), "\nSession experience:\n", nsm-text(fh-path(job,"session-experience.txt")), "\n", fh-cap(fh-read(fh-path(job, "evidence.txt")), 7000)));
            let prompt = fh-prompt("patch", context, fh-read(fh-path(job, "original")));
            str_len(prompt) > 24000 ? "" : fh-save-prompt(job, "patch", prompt);
        }
        def fh-model(job, mode, model, artifact, stage, offered, reason) {
            let id = now_unix_ms();
            let selected = fh-choice(job, stage, id, "selected", offered, model, reason, "awaiting-generation");
            let prompt = fh-prompt-file(job);
            let reply = fh-path(job, stage ++ ".reply");
            let frozen = (String) artifact == "" ? "" : fh-path(job, stage ++ ".adapter.safetensors");
            let copied = (String) artifact == "" ? 0 : write_file(frozen, read_file(artifact));
            let input = fh-cat(list(mode, "\n", model, "\n", prompt, "\n", reply, "\n", frozen, "\n"));
            let request = fh-write(job, stage ++ ".request", input);
            let status = (String) prompt == "" ? "prompt-limit" : fh-run(job, stage, HealNativeSeconds(), "root", fh-path(job, stage ++ ".request"), list("./fkwu", "observe/form-cli-heal-model-run.bml"));
            let logged = fh-log(job, stage, "exit=" ++ status);
            let applied = fh-choice(job, stage, id, "applied", offered, model, reason, "generation-exit=" ++ status);
            (String) status == "0" ? fh-read(reply) : "";
        }
        // Adapter registration binds base and adapter bytes to an evaluation
        // receipt. A seed artifact without this evidence is not admitted here.
        def fh-adapter(model, inventory) {
            let fields = split-on(fh-trim(fh-read(".form-heal/adapter.tsv")), "\t");
            !((Comparable) len(fields) == 6) ? "" : !((String) head(fields) == model) ? "" : !((String) fh-host(list("hash", fh-model-path(inventory, model))) == fields[1]) ? "" : fh-adapter-receipt(model, fields);
        }
        def fh-model-path(rows, model) = nil?(rows) ? "" : fh-model-path-row(rows, model, split-on(head(rows), "\t"));
        def fh-model-path-row(rows, model, fields) = !((Comparable) len(fields) == 4) ? fh-model-path(tail(rows), model) : (String) head(fields) == model ? fields[1] : fh-model-path(tail(rows), model);
        def fh-remote(job,target,band,expected,seconds,allowed) = (Comparable) allowed == 1 ? fh-remote-authorized(job,target,band,expected,seconds) : fh-remote-closed(job);
        def fh-remote-closed(job) {
            fh-log(job,"remote-admission","closed;explicit-remote-authorization-required");
            let reading = oh-reading("healing",job,"remote-admission",json-node-int(0),json-node-int(0),json-node-int(1),list(),list("withhold-remote-process"),json-node-object(list(nsm-n("request_authorized",0),nsm-n("remote_process_launched",0))));
            oh-emit(fh-path(job,"health.jsonl"),reading);
            oh-emit(fh-path(job,"health.jsonl"),oh-response(reading,"withhold-remote-process"));
            oh-emit(fh-path(job,"health.jsonl"),oh-applied(reading,"withhold-remote-process",json-node-object(list(nsm-n("remote_process_launched",0)))));
            0;
        }
        def fh-remote-authorized(job, target, band, expected, seconds) {
            let probe = fh-run(job, "remote-probe", 10, "empty", "-", list("codex", "exec", "--help"));
            let available = ((String) probe == "0") && fh-has(fh-out(job, "remote-probe"), "--ephemeral");
            let admission = fh-frontier(fh-job-id(job), fh-local-left(job), file_size(fh-path(job, "attempts.tsv")) > 0 ? 1 : 0, available, file_size(fh-path(job, "remote-used")) > 0 ? 1 : 0);
            let admitted = fh-log(job, "remote-admission", int_to_str(admission));
            !admission ? 0 : !((String) fh-host(list("claim", fh-path(job, "remote-used"))) == "claimed") ? 0 : fh-rent-once(job, target, band, expected, seconds);
        }
        def fh-job-id(job) = head(reverse(split-on(job, "/")));
        def fh-local-left(job) = fh-native-left(job) + fh-missing-stages(fh-read(fh-path(job, "attempts.tsv")), list("native-session-lora", "adapter-admission", "native-model-admission"));
        def fh-native-left(job) = !((String) fh-read(fh-path(job, "native-inventory-status")) == "complete") ? 1 : fhr-pending(fhr-plan(split-on(fh-out(job, "inventory"), "\n")), fh-read(fh-path(job, "attempts.tsv")));
        def fh-missing-stages(log, stages) = nil?(stages) ? 0 : ((fh-has("\n" ++ log, fh-cat(list("\n", head(stages), "\t"))) ? 0 : 1) + fh-missing-stages(log, tail(stages)));
        def fh-models(job, target, band, expected, seconds, allowed) {
            let result = fh-session-attempt(job,target,band,expected,seconds);
            !((Comparable) result == 0) ? result : fh-models-rest(job,target,band,expected,seconds,allowed);
        }
        def fh-session-attempt(job,target,band,expected,seconds) {
            let home = hearth-session-learning();
            !nsm-attemptable(home,"repair",fh-session-input(job)) ? fh-session-absent(job) : fh-session-run(job,target,band,expected,seconds,home);
        }
        def fh-session-absent(job) {
            let logged = fh-log(job,"native-session-lora","no-repair-trained-serving-adapter-or-unchanged-failed-prediction;continue-local-inventory");
            0;
        }
        def fh-session-run(job,target,band,expected,seconds,home) {
            let output = fh-path(job,"session-lora.reply.json");
