// q38-multi.bml — N independent Qwen token streams in one weight pass: the stream-indexed kernels.
//
// A decoded token moves every weight once (about 29 GB for the 27B at Q8_0) for one token's worth of arithmetic, so one stream sits
// at the memory-bandwidth floor of about 18 tokens a second. N streams that share the one pass cost the weights once and each
// stream's own state: the projections run N columns wide on the existing shared-weight matvec, and only the five things that
// differ by stream run per stream, in one dispatch each over (stream, head, ...): the rope at each stream's own position, the
// key/value store into each stream's own cache, the attention over each stream's own history, the convolution window and the
// gated-delta recurrence of the linear layers. Each kernel here is the single-stream kernel's arithmetic in its order, with a row
// offset (a stream's state at row * stride) in front, so a stream's result equals its own one-token step's bit for bit.
// The bands witness each kernel against the single-stream kernel on small synthetic data, with no model (q38-multi-band.bml).
// preludes: form-stdlib/core.fk form-stdlib/gpu-lease.bml native/metal/qwen35-dense-spec.fk
section [form.bml] {
 class Q38Multi {
  def q38m-header() = "#include <metal_stdlib>\n#pragma clang fp contract(off)\n";
  // The gated delta rule of the linear-attention layers, for nrows streams at once. One thread per (stream, value head, value dim);
  // stream row's state S is at row * sstride floats (nv * dv * dk), its convolution output c at row * cstride (convdim), its alpha and
  // beta at row * nv, its output at row * nv * dv. The body is kth-delta-msl's, term for term.
  def q38m-delta-msl(fname) = "kernel void " ++ fname ++ " (device float* S [[buffer(0)]], device const float* c [[buffer(1)]], device const float* alpha [[buffer(2)]], device const float* beta [[buffer(3)]], device float* o [[buffer(4)]], constant uint& nv [[buffer(5)]], constant uint& dv [[buffer(6)]], constant uint& dk [[buffer(7)]], constant uint& nk [[buffer(8)]], constant float& qscale [[buffer(9)]], constant uint& sstride [[buffer(10)]], constant uint& cstride [[buffer(11)]], constant uint& nrows [[buffer(12)]], uint gid [[thread_position_in_grid]]) { uint per = nv * dv; if (gid >= nrows * per) return; uint row = gid / per; uint g = gid - row * per; uint h = g / dv; uint i = g - h * dv; uint kh = h - (h / nk) * nk; device const float* cr = c + row * cstride; device const float* q = cr + kh * dk; device const float* k = cr + nk * dk + kh * dk; float v = cr[2u * nk * dk + h * dv + i]; uint r = row * sstride + (h * dv + i) * dk; float al = alpha[row * nv + h]; float pred = 0.0f; for (uint j = 0u; j < dk; ++j) { float sp = al * S[r + j]; S[r + j] = sp; pred = pred + sp * k[j]; } float err = v - pred; float bw = beta[row * nv + h] * err; float acc = 0.0f; for (uint j = 0u; j < dk; ++j) { float sn = S[r + j] + bw * k[j]; S[r + j] = sn; acc = acc + sn * (qscale * q[j]); } o[row * per + h * dv + i] = acc; }";
  // The causal convolution window of the linear-attention layers, for nrows streams at once. One thread per (stream, channel); stream
  // row's window is at row * wstride floats (convdim * kw), its input and output at row * xstride (convdim); the filter w is shared.
  // The body is gdm-conv-msl's: shift the window, append the new input, dot the window with the channel's taps.
  def q38m-conv-msl(fname) = "kernel void " ++ fname ++ " (device float* win [[buffer(0)]], device const float* x [[buffer(1)]], device const float* w [[buffer(2)]], device float* y [[buffer(3)]], constant uint& nch [[buffer(4)]], constant uint& kw [[buffer(5)]], constant uint& wstride [[buffer(6)]], constant uint& xstride [[buffer(7)]], constant uint& nrows [[buffer(8)]], uint gid [[thread_position_in_grid]]) { if (gid >= nrows * nch) return; uint row = gid / nch; uint c = gid - row * nch; device float* wn = win + row * wstride; uint b = c * kw; for (uint j = 0u; j + 1u < kw; ++j) { wn[b + j] = wn[b + j + 1u]; } wn[b + kw - 1u] = x[row * xstride + c]; float acc = 0.0f; for (uint j = 0u; j < kw; ++j) { acc = acc + wn[b + j] * w[b + j]; } y[row * xstride + c] = acc; }";
  // The partial rotary embedding of the full-attention layers, each stream at its OWN position (a device buffer of uints, not a
  // constant): one thread per (stream, head, rotated pair); stream row's heads are at row * vstride floats. kth-prope-msl's body.
  def q38m-rope-msl(fname) = "kernel void " ++ fname ++ " (device float* v [[buffer(0)]], device const uint* posb [[buffer(1)]], constant uint& nh [[buffer(2)]], constant uint& hd [[buffer(3)]], constant uint& nrot [[buffer(4)]], constant float& base [[buffer(5)]], constant uint& vstride [[buffer(6)]], constant uint& nrows [[buffer(7)]], uint gid [[thread_position_in_grid]]) { uint np = nrot / 2u; uint per = nh * np; if (gid >= nrows * per) return; uint row = gid / per; uint g = gid - row * per; uint h = g / np; uint k = g - h * np; uint o = row * vstride + h * hd; uint pos = posb[row]; float ex = (-2.0f * float(k)) / float(nrot); float fq = fpow(base, ex); float a = float(pos) * fq; float ca = fcos(a); float sa = fsin(a); uint i0 = o + k; uint i1 = o + k + np; float x0 = v[i0]; float x1 = v[i1]; float t0 = x0 * ca; float t1 = x1 * sa; v[i0] = t0 - t1; float t2 = x0 * sa; float t3 = x1 * ca; v[i1] = t2 + t3; }";
  // Attention over each stream's own history: one threadgroup per (stream, query head), 256 threads (mode 1). Stream row attends over
  // posb[row] + 1 positions of its own cache (the arena slice at row * kvstride floats) with its own query (row * qstride), its own
  // scores (row * scstride) and its own output (row * qstride). q38-gqa-tg-msl's body, every sum in its order.
  def q38m-gqa-msl(fname) = "kernel void " ++ fname ++ " (device const float* q [[buffer(0)]], device const float* kc [[buffer(1)]], device const float* vc [[buffer(2)]], device float* y [[buffer(3)]], device float* sc [[buffer(4)]], device const uint* posb [[buffer(5)]], constant uint& nq [[buffer(6)]], constant uint& nkv [[buffer(7)]], constant uint& hd [[buffer(8)]], constant float& scale [[buffer(9)]], constant uint& sstride [[buffer(10)]], constant uint& qstride [[buffer(11)]], constant uint& kvstride [[buffer(12)]], constant uint& scstride [[buffer(13)]], constant uint& nrows [[buffer(14)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { uint gh = tgpig.x; uint row = gh / nq; uint h = gh - row * nq; if (row >= nrows) return; uint npos = posb[row] + 1u; device const float* qr = q + row * qstride; device const float* kcr = kc + row * kvstride; device const float* vcr = vc + row * kvstride; device float* yr = y + row * qstride; device float* scr = sc + row * scstride; threadgroup float sh[16]; uint lid = (uint)sgitg * 32u + (uint)tiisg; uint grp = nq / nkv; uint kvh = h / grp; uint KVD = nkv * hd; uint qoff = h * hd; uint koff = kvh * hd; uint S = h * sstride; uint E = (nq + h) * sstride; for (uint t = lid; t < npos; t += 256u) { float acc = 0.0f; for (uint c = 0u; c < hd; ++c) { acc = metal::fma(qr[qoff + c], kcr[t * KVD + koff + c], acc); } scr[S + t] = acc * scale; } metal::threadgroup_barrier(metal::mem_flags::mem_device); float mx = -3.4e38f; for (uint t = lid; t < npos; t += 256u) { float v = scr[S + t]; if (v > mx) { mx = v; } } mx = metal::simd_max(mx); if (tiisg == 0) { sh[sgitg] = mx; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float gmx = sh[0]; for (uint k = 1u; k < 8u; ++k) { if (sh[k] > gmx) { gmx = sh[k]; } } float se = 0.0f; for (uint t = lid; t < npos; t += 256u) { float e = fexp(scr[S + t] - gmx); scr[E + t] = e; se = se + e; } se = metal::simd_sum(se); if (tiisg == 0) { sh[8u + sgitg] = se; } metal::threadgroup_barrier(metal::mem_flags::mem_device | metal::mem_flags::mem_threadgroup); float tot = 0.0f; for (uint k = 0u; k < 8u; ++k) { tot = tot + sh[8u + k]; } float inv = 1.0f / tot; for (uint c = lid; c < hd; c += 256u) { float acc = 0.0f; for (uint t = 0u; t < npos; ++t) { acc = metal::fma(vcr[t * KVD + koff + c], scr[E + t], acc); } yr[qoff + c] = acc * inv; } }";
  // The key (or value) store into each stream's own cache: stream row's cache is the arena slice at row * maxpos * kvd, and its
  // position is posb[row]. kth-copyoff-msl's store with the row and position folded into the destination.
  def q38m-kvwrite-msl(fname) = "kernel void " ++ fname ++ " (device const float* s [[buffer(0)]], device float* d [[buffer(1)]], device const uint* posb [[buffer(2)]], constant uint& kvd [[buffer(3)]], constant uint& maxpos [[buffer(4)]], constant uint& nrows [[buffer(5)]], uint gid [[thread_position_in_grid]]) { if (gid >= nrows * kvd) return; uint row = gid / kvd; uint i = gid - row * kvd; d[row * maxpos * kvd + posb[row] * kvd + i] = s[row * kvd + i]; }";
  // ── the driver: one step of N streams, one pass over the weights ──
  // The pipelines of the five kernels, [delta, conv, rope, kv write, attention], compiled from kth-msl's helpers plus the kernels.
  def q38m-msl() = kth-msl() ++ q38m-delta-msl("form_q38m_delta_rows") ++ q38m-conv-msl("form_q38m_conv_rows") ++ q38m-rope-msl("form_q38m_rope_rows") ++ q38m-kvwrite-msl("form_q38m_kvw_rows") ++ q38m-gqa-msl("form_q38m_gqa_rows") ++ q38m-fork-msl("form_q38m_fork") ++ q38m-lp-msl("form_q38m_lp");
  def q38m-pipes(msl) = [metal_pipeline(msl, "form_q38m_delta_rows"), metal_pipeline(msl, "form_q38m_conv_rows"), metal_pipeline(msl, "form_q38m_rope_rows"), metal_pipeline(msl, "form_q38m_kvw_rows"), metal_pipeline(msl, "form_q38m_gqa_rows"), metal_pipeline(msl, "form_q38m_fork"), metal_pipeline(msl, "form_q38m_lp")];
  // N streams' state side by side: per layer [conv, delta, K, V], stream s at s * its own stride (a single stream's allocation scaled by N).
  def q38m-new-arena(geo, n, allocate) = kth-stream-state-by(geo[21], geo[22], geo[1] * n, geo[23], geo[3] * n, geo[5], geo[4], geo[20], geo[18] * n, allocate);
  def q38m-uints(xs) = foldl((a, x) => a ++ md-le32(x), "", xs);
  // a linear-attention layer for ntok streams: q38s-linear-attn-span-s with the snapshot-free recurrence replaced by the row kernels
  def q38m-linear(ps, qs, mp, bs, geo, lay, st, ntok) {
   let pitch = qlslc-bs2-output-pitch(geo);
   q38-rms-span(ps, bs[33], lay[0], bs[1], geo[0], geo[6], ntok, 1);
   q38s-mv(ps, qs, lay[5], bs[1], bs[2], ntok, pitch, 1);
   q38s-mv(ps, qs, lay[7], bs[1], bs[3], ntok, kth-tv-r(lay[7]), 0);
   q38s-mv(ps, qs, lay[8], bs[1], bs[4], ntok, kth-tv-r(lay[8]), 0);
   q38s-mv(ps, qs, lay[12], bs[1], bs[7], ntok, kth-tv-r(lay[12]), 0);
   metal_enqueue(mp[1], md-bind16([st[0], bs[2], kth-tv-h(lay[6]), bs[2]], [geo[1], geo[23], geo[1] * geo[23], pitch, ntok], 256, 0, 0, 1), geo[1] * ntok);
   metal_enqueue(ps[8], q38-b16([bs[2]], [qlslc-bs2-allocation-elements(geo, ntok)], 0, 1), qlslc-bs2-allocation-elements(geo, ntok));
   metal_enqueue(nth(ps, qlslc-l2norm-span-pipeline()), q38-b16([bs[2]], [2 * geo[2], geo[4], geo[6], pitch, ntok], 0, 1), 2 * geo[2] * ntok);
   metal_enqueue(nth(ps, qlslc-gates-span-pipeline()), q38-b16([bs[3], bs[4], kth-tv-h(lay[9]), kth-tv-h(lay[10]), bs[5], bs[6]], [geo[3], ntok], 0, 1), geo[3] * ntok);
   metal_enqueue(mp[0], md-bind16([st[1], bs[2], bs[5], bs[6], bs[8]], [geo[3], geo[5], geo[4], geo[2], geo[7], geo[3] * geo[5] * geo[4], pitch, ntok], 256, 0, 0, 1), ntok * geo[3] * geo[5]);
   metal_enqueue(nth(ps, qlslc-norm-gate-span-pipeline()), q38-b16([bs[8], kth-tv-h(lay[11]), bs[7], bs[9]], [geo[3], geo[5], geo[6], ntok], 0, 1), geo[3] * ntok);
   q38s-mv-res(ps, qs, lay[13], bs[9], bs[10], bs[33], ntok, kth-tv-r(lay[13]), 1);
   1;
  }
  // a full-attention layer for ntok streams, each at its own position (posb): q38s-full-attn-span with rope, the cache store and the
  // attention replaced by the row kernels
  def q38m-full(ps, qs, mp, bs, geo, lay, st, posb, ntok) {
   let nqhd = geo[12] * geo[14];
   let kvd = geo[20];
   q38-rms-span(ps, bs[33], lay[0], bs[1], geo[0], geo[6], ntok, 1);
   q38s-mv(ps, qs, lay[5], bs[1], bs[2], ntok, q38-bs2-stride(geo), 1);
   q38s-mv(ps, qs, lay[6], bs[1], bs[24], ntok, kth-tv-r(lay[6]), 0);
   q38s-mv(ps, qs, lay[7], bs[1], bs[25], ntok, kth-tv-r(lay[7]), 0);
   metal_enqueue(ps[34], q38-b16([bs[2], bs[22]], [nqhd, geo[14], 0, ntok, q38-bs2-stride(geo)], 0, 1), nqhd * ntok);
   metal_enqueue(ps[34], q38-b16([bs[2], bs[23]], [nqhd, geo[14], geo[14], ntok, q38-bs2-stride(geo)], 0, 0), nqhd * ntok);
   metal_enqueue(ps[35], q38-b16([bs[22], kth-tv-h(lay[8]), bs[22]], [geo[12], geo[14], geo[6], ntok], 0, 1), geo[12] * ntok);
   metal_enqueue(ps[35], q38-b16([bs[24], kth-tv-h(lay[9]), bs[24]], [geo[13], geo[14], geo[6], ntok], 0, 0), geo[13] * ntok);
   metal_enqueue(mp[2], md-bind16([bs[22], posb], [geo[12], geo[14], geo[15], geo[16], nqhd, ntok], 256, 0, 0, 1), geo[12] * (geo[15] / 2) * ntok);
   metal_enqueue(mp[2], md-bind16([bs[24], posb], [geo[13], geo[14], geo[15], geo[16], kvd, ntok], 256, 0, 0, 0), geo[13] * (geo[15] / 2) * ntok);
   metal_enqueue(mp[3], md-bind16([bs[24], st[2], posb], [kvd, geo[18], ntok], 256, 0, 0, 1), kvd * ntok);
   metal_enqueue(mp[3], md-bind16([bs[25], st[3], posb], [kvd, geo[18], ntok], 256, 0, 0, 0), kvd * ntok);
   metal_enqueue(mp[4], md-bind16([bs[22], st[2], st[3], bs[26], bs[27], posb], [geo[12], geo[13], geo[14], geo[17], geo[18], nqhd, geo[18] * kvd, 2 * geo[12] * geo[18], ntok], 256, 0, 1, 1), geo[12] * ntok);
   metal_enqueue(ps[17], q38-b16([bs[26], bs[23]], [nqhd * ntok], 0, 1), nqhd * ntok);
   q38s-mv-res(ps, qs, lay[10], bs[26], bs[10], bs[33], ntok, kth-tv-r(lay[10]), 1);
   1;
  }
  def q38m-layers(ps, qs, mp, bs, geo, lays, arena, posb, l, nL, ntok) {
   if (l >= nL) then 1 else {
    let done = kth-full?(l, geo[22]) ? q38m-full(ps, qs, mp, bs, geo, nth(lays, l), nth(arena, l), posb, ntok) : q38m-linear(ps, qs, mp, bs, geo, nth(lays, l), nth(arena, l), ntok);
    q38s-ffn-span(ps, qs, bs, geo, nth(lays, l), ntok);
    let handed = q38-handover-after(l + 1, nL);
    q38m-layers(ps, qs, mp, bs, geo, lays, arena, posb, l + 1, nL, ntok);
   };
  }
  // The next greedy id of each of the ids' streams, stream i feeding ids[i] at poss[i]: one pass over the weights for all of them.
  // sx is the span scratch (q38s-open), arena the streams' state (q38m-new-arena), posb a uint buffer of at least ntok words.
  // The surprise of the greedy token, in micro-nats, one threadgroup of 256 a stream: -log p(argmax) = log(sum exp(logit - max)). A
  // stream that is sure of its line reads near 0; one that is guessing reads high. This is the local model's own judgement of its lens.
  def q38m-lp-msl(fname) = "kernel void " ++ fname ++ " (device const float* lg [[buffer(0)]], device uint* out [[buffer(1)]], constant uint& vocab [[buffer(2)]], uint row [[threadgroup_position_in_grid]], uint lid [[thread_position_in_threadgroup]]) { threadgroup float sh[256]; device const float* r = lg + row * vocab; float m = -INFINITY; for (uint i = lid; i < vocab; i += 256u) { m = metal::max(m, r[i]); } sh[lid] = m; threadgroup_barrier(metal::mem_flags::mem_threadgroup); for (uint s = 128u; s > 0u; s >>= 1u) { if (lid < s) { sh[lid] = metal::max(sh[lid], sh[lid + s]); } threadgroup_barrier(metal::mem_flags::mem_threadgroup); } float mx = sh[0]; threadgroup_barrier(metal::mem_flags::mem_threadgroup); float acc = 0.0f; for (uint i = lid; i < vocab; i += 256u) { acc += metal::exp(r[i] - mx); } sh[lid] = acc; threadgroup_barrier(metal::mem_flags::mem_threadgroup); for (uint s = 128u; s > 0u; s >>= 1u) { if (lid < s) { sh[lid] = sh[lid] + sh[lid + s]; } threadgroup_barrier(metal::mem_flags::mem_threadgroup); } if (lid == 0u) { float nats = metal::log(sh[0]); out[row] = uint(metal::clamp(nats * 1000000.0f, 0.0f, 4000000000.0f)); } }";
  def q38m-step(ctx, qs, mp, arena, sx, posb, ids, poss) = q38m-step-core(ctx, qs, mp, arena, sx, posb, ids, poss, 0)[0];
  // lpb is a uint buffer of at least ntok words, or 0 for no scoring; answers [ids, micro-nats of each greedy id]
  def q38m-step-core(ctx, qs, mp, arena, sx, posb, ids, poss, lpb) = gpu-lease-turn("qwen multi decode", () => {
   let ntok = len(ids);
   let bs = ctx[1];
   let geo = ctx[2];
   let w1 = metal_buf_write(sx[0], 0, q38m-uints(ids));
   let w2 = metal_buf_write(posb, 0, q38m-uints(poss));
   let batch = metal_batch_concurrent();
   metal_enqueue(qs[q38s-pipe-embed()], md-bind16([kth-tv-h(ctx[4]), sx[0], bs[33]], [geo[0], ntok, 0], 256, 0, 0, 1), geo[0] * ntok);
   let layers = q38m-layers(ctx[0], qs, mp, bs, geo, ctx[3], arena, posb, 0, geo[21], ntok);
   let head = q38s-head-check(ctx, qs, sx, ntok);
   let scored = lpb == 0 ? 0 : metal_enqueue(mp[6], md-bind16([sx[1], lpb], [geo[19]], 256, 0, 1, 1), ntok);
   let raw = metal_buf_read(sx[4], 0, ntok * 4);
   let lps = lpb == 0 ? q38m-fill(0, ntok) : q38m-read-ids(metal_buf_read(lpb, 0, ntok * 4), 0, ntok);
   [q38m-read-ids(raw, 0, ntok), lps];
  });
  def q38m-read-ids(raw, i, n) = i >= n ? [] : cons(kth-u32at(raw, i), q38m-read-ids(raw, i + 1, n));
  // The surprise reader as the LOCAL MODEL wrote it (observe/local-kernel-lane-run.bml, 2026-11-10: three lenses of the 27B each wrote it
  // from the spec above q38m-lp-msl; all three compiled and agreed word for word with q38m-lp-msl on two rows of 1024 floats; this is the
  // one it was surest of, kept verbatim). The lane does not run it: on 2026-11-11 the live counsel door (observe/local-counsel-run.bml,
  // two lenses, 60 tokens) decoded gibberish at surprise 0 with this kernel in q38m-msl and answered at 321681 and 556005 micro-nats with
  // q38m-lp-msl, though q38-model-kernel-band held it on small datasets. The lane runs q38m-lp-msl (as form_q38m_lp) until the band
  // meets the live decode; q38m-lp-model-kernel is still compared against it by that band and observe/local-kernel-lane-run.bml.
  def q38m-lp-model-msl() = "#include <metal_stdlib>\nusing namespace metal;\n#include <metal_math>\n\n" ++ q38m-lp-model-kernel("form_lp_model");
  def q38m-lp-model-kernel(fname) = str-join-with(["kernel void " ++ fname ++ " (device const float* lg [[buffer(0)]],","                           device uint* out [[buffer(1)]],", "                           constant uint& vocab [[buffer(2)]],", "                           uint row [[threadgroup_position_in_grid]],", "                           uint lid [[thread_position_in_threadgroup]])", "{", "    threadgroup float t[256];", "    t[lid] = 0.0f;", "    threadgroup_barrier(mem_flags::mem_threadgroup);", "", "    // Compute max over the row", "    float m = -INFINITY;", "    for (uint i = lid; i < vocab; i += 256) {", "        m = max(m, lg[row * vocab + i]);", "    }", "    t[lid] = m;", "    threadgroup_barrier(mem_flags::mem_threadgroup);", "", "    // Reduce max", "    for (uint stride = 128; stride > 0; stride >>= 1) {", "        if (lid < stride) {", "            t[lid] = max(t[lid], t[lid + stride]);", "        }", "        threadgroup_barrier(mem_flags::mem_threadgroup);", "    }", "    m = t[0];", "", "    // Compute sum of exp(x - m)", "    float s = 0.0f;", "    for (uint i = lid; i < vocab; i += 256) {", "        s += exp(lg[row * vocab + i] - m);", "    }", "    t[lid] = s;", "    threadgroup_barrier(mem_flags::mem_threadgroup);", "", "    // Reduce sum", "    for (uint stride = 128; stride > 0; stride >>= 1) {", "        if (lid < stride) {", "            t[lid] += t[lid + stride];", "        }", "        threadgroup_barrier(mem_flags::mem_threadgroup);", "    }", "    s = t[0];", "", "    if (lid == 0) {", "        out[row] = uint(clamp(log(s) * 1000000.0f, 0.0f, 4000000000.0f));", "    }", "}", ""], "\n");
  // Parallel reasoning over real prompts. Stream s feeds prompts[s] one token a step (teacher forced, position = step), then its own
  // greedy id; every step is one pass over the weights for all streams. A stream's continuation is the ids it predicts from the step
  // that fed its last prompt token on, `gen` of them. Streams of different prompt lengths share the pass: a short prompt starts
  // generating while a long one is still being read, so nothing waits for the longest prompt to be prefilled first.
  // Returns one list of gen ids per stream. The arena must be fresh (position 0 empty).
  def q38m-feed-ids(prompts, last, i) = map(s => i < len(prompts[s]) ? prompts[s][i] : last[s], range(0, len(prompts)));
  def q38m-fill(x, n) = n <= 0 ? [] : cons(x, q38m-fill(x, n - 1));
  def q38m-keep(prompts, outs, nxt, i, gen) = map(s => (i >= len(prompts[s]) - 1 && len(outs[s]) < gen) ? append(outs[s], [nxt[s]]) : outs[s], range(0, len(prompts)));
  def q38m-keep-sums(prompts, sums, lps, outs, i, gen) = map(s => (i >= len(prompts[s]) - 1 && len(outs[s]) < gen) ? sums[s] + lps[s] : sums[s], range(0, len(prompts)));
  // answers [ids per stream, summed micro-nats of each stream's generated tokens]; lpb 0 leaves the sums at zero
  def q38m-generate-go(ctx, qs, mp, arena, sx, posb, prompts, i, total, last, outs, gen, p0, lpb, sums) {
   if (i >= total) then [outs, sums] else {
    let r = q38m-step-core(ctx, qs, mp, arena, sx, posb, q38m-feed-ids(prompts, last, i), q38m-fill(p0 + i, len(prompts)), lpb);
    q38m-generate-go(ctx, qs, mp, arena, sx, posb, prompts, i + 1, total, r[0], q38m-keep(prompts, outs, r[0], i, gen), gen, p0, lpb, q38m-keep-sums(prompts, sums, r[1], outs, i, gen));
   };
  }
  def q38m-longest(prompts) = foldl((a, p) => len(p) > a ? len(p) : a, 0, prompts);
  // p0 is the position the first fed token lands at: 0 for a fresh arena, the shared prefix length after q38m-fork-all.
  def q38m-generate-scored(ctx, qs, mp, arena, sx, posb, prompts, gen, p0, lpb) = q38m-generate-go(ctx, qs, mp, arena, sx, posb, prompts, 0, q38m-longest(prompts) + gen - 1, q38m-fill(0, len(prompts)), map(p => [], prompts), gen, p0, lpb, q38m-fill(0, len(prompts)));
  def q38m-generate-from(ctx, qs, mp, arena, sx, posb, prompts, gen, p0) = q38m-generate-scored(ctx, qs, mp, arena, sx, posb, prompts, gen, p0, 0)[0];
  def q38m-generate(ctx, qs, mp, arena, sx, posb, prompts, gen) = q38m-generate-from(ctx, qs, mp, arena, sx, posb, prompts, gen, 0);
  // ── fork: one prefilled stream becomes N ──
  // A prompt is read once, at the batched prefill's rate, and its state (the linear layers' window and delta, the full layers' K and V
  // up to pos) is copied into slot s of the arena by one micro-kernel, a plain device-to-device copy at the memory bandwidth, so N
  // lines of thought that share a prefix pay for the prefix once. The arena slot strides are those of q38m-new-arena.
  def q38m-fork-msl(fname) = "kernel void " ++ fname ++ " (device const float* s [[buffer(0)]], device float* d [[buffer(1)]], constant uint& doff [[buffer(2)]], constant uint& n [[buffer(3)]], uint gid [[thread_position_in_grid]]) { if (gid >= n) return; d[doff + gid] = s[gid]; }";
  def q38m-fork-copy(pipe, src, dst, doff, count) = count <= 0 ? 0 : metal_enqueue(pipe, md-bind16([src, dst], [doff, count], 256, 0, 0, 1), count);
  def q38m-fork-layer(pipe, geo, l, st, ast, s, pos) {
   if (kth-full?(l, geo[22])) then {
    let kv = geo[20];
    let a = q38m-fork-copy(pipe, st[2], ast[2], s * geo[18] * kv, pos * kv);
    q38m-fork-copy(pipe, st[3], ast[3], s * geo[18] * kv, pos * kv);
   } else {
    let conv = geo[1] * geo[23];
    let delta = geo[3] * geo[5] * geo[4];
    let a = q38m-fork-copy(pipe, st[0], ast[0], s * conv, conv);
    q38m-fork-copy(pipe, st[1], ast[1], s * delta, delta);
   };
  }
  def q38m-fork-layers(pipe, geo, sts, arena, s, pos, l) {
   if (l >= geo[21]) then 0 else {
    let a = q38m-fork-layer(pipe, geo, l, sts[l], arena[l], s, pos);
    q38m-fork-layers(pipe, geo, sts, arena, s, pos, l + 1);
   };
  }
  def q38m-fork-all(ctx, pipe, sts, arena, n, pos) = gpu-lease-turn("qwen fork", () => {
   let batch = metal_batch_concurrent();
   let a = foldl((acc, s) => q38m-fork-layers(pipe, ctx[2], sts, arena, s, pos, 0), 0, range(0, n));
   metal_sync();
  });
 }
 0;
}
