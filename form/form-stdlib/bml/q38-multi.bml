// q38-multi.bml — N independent Qwen token streams in one weight pass: the stream-indexed kernels.
//
// A decoded token moves every weight once (about 29 GB for the 27B at Q8_0) for one token's worth of arithmetic, so one stream sits
// at the memory-bandwidth floor of about 18 tokens a second. N streams that share the one pass cost the weights once and each
// stream's own state: the projections run N columns wide on the existing shared-weight matvec, and only the five things that
// differ by stream run per stream, in one dispatch each over (stream, head, ...): the rope at each stream's own position, the
// key/value store into each stream's own cache, the attention over each stream's own history, the convolution window and the
// gated-delta recurrence of the linear layers. Each kernel here is the single-stream kernel's arithmetic in its order, with a row
// offset (a stream's state at row * stride) in front, so a stream's result equals its own one-token step's bit for bit.
// The bands witness each kernel against the single-stream kernel on small synthetic data, with no model (q38-multi-band.bml).
// preludes: form-stdlib/core.fk
section [form.bml] {
 class Q38Multi {
  def q38m-header() = "#include <metal_stdlib>\n#pragma clang fp contract(off)\n";
  // The gated delta rule of the linear-attention layers, for nrows streams at once. One thread per (stream, value head, value dim);
  // stream row's state S is at row * sstride floats (nv * dv * dk), its convolution output c at row * cstride (convdim), its alpha and
  // beta at row * nv, its output at row * nv * dv. The body is kth-delta-msl's, term for term.
  def q38m-delta-msl(fname) = "kernel void " ++ fname ++ " (device float* S [[buffer(0)]], device const float* c [[buffer(1)]], device const float* alpha [[buffer(2)]], device const float* beta [[buffer(3)]], device float* o [[buffer(4)]], constant uint& nv [[buffer(5)]], constant uint& dv [[buffer(6)]], constant uint& dk [[buffer(7)]], constant uint& nk [[buffer(8)]], constant float& qscale [[buffer(9)]], constant uint& sstride [[buffer(10)]], constant uint& cstride [[buffer(11)]], constant uint& nrows [[buffer(12)]], uint gid [[thread_position_in_grid]]) { uint per = nv * dv; if (gid >= nrows * per) return; uint row = gid / per; uint g = gid - row * per; uint h = g / dv; uint i = g - h * dv; uint kh = h - (h / nk) * nk; device const float* cr = c + row * cstride; device const float* q = cr + kh * dk; device const float* k = cr + nk * dk + kh * dk; float v = cr[2u * nk * dk + h * dv + i]; uint r = row * sstride + (h * dv + i) * dk; float al = alpha[row * nv + h]; float pred = 0.0f; for (uint j = 0u; j < dk; ++j) { float sp = al * S[r + j]; S[r + j] = sp; pred = pred + sp * k[j]; } float err = v - pred; float bw = beta[row * nv + h] * err; float acc = 0.0f; for (uint j = 0u; j < dk; ++j) { float sn = S[r + j] + bw * k[j]; S[r + j] = sn; acc = acc + sn * (qscale * q[j]); } o[row * per + h * dv + i] = acc; }";
  // The causal convolution window of the linear-attention layers, for nrows streams at once. One thread per (stream, channel); stream
  // row's window is at row * wstride floats (convdim * kw), its input and output at row * xstride (convdim); the filter w is shared.
  // The body is gdm-conv-msl's: shift the window, append the new input, dot the window with the channel's taps.
  def q38m-conv-msl(fname) = "kernel void " ++ fname ++ " (device float* win [[buffer(0)]], device const float* x [[buffer(1)]], device const float* w [[buffer(2)]], device float* y [[buffer(3)]], constant uint& nch [[buffer(4)]], constant uint& kw [[buffer(5)]], constant uint& wstride [[buffer(6)]], constant uint& xstride [[buffer(7)]], constant uint& nrows [[buffer(8)]], uint gid [[thread_position_in_grid]]) { if (gid >= nrows * nch) return; uint row = gid / nch; uint c = gid - row * nch; device float* wn = win + row * wstride; uint b = c * kw; for (uint j = 0u; j + 1u < kw; ++j) { wn[b + j] = wn[b + j + 1u]; } wn[b + kw - 1u] = x[row * xstride + c]; float acc = 0.0f; for (uint j = 0u; j < kw; ++j) { acc = acc + wn[b + j] * w[b + j]; } y[row * xstride + c] = acc; }";
  // The partial rotary embedding of the full-attention layers, each stream at its OWN position (a device buffer of uints, not a
  // constant): one thread per (stream, head, rotated pair); stream row's heads are at row * vstride floats. kth-prope-msl's body.
  def q38m-rope-msl(fname) = "kernel void " ++ fname ++ " (device float* v [[buffer(0)]], device const uint* posb [[buffer(1)]], constant uint& nh [[buffer(2)]], constant uint& hd [[buffer(3)]], constant uint& nrot [[buffer(4)]], constant float& base [[buffer(5)]], constant uint& vstride [[buffer(6)]], constant uint& nrows [[buffer(7)]], uint gid [[thread_position_in_grid]]) { uint np = nrot / 2u; uint per = nh * np; if (gid >= nrows * per) return; uint row = gid / per; uint g = gid - row * per; uint h = g / np; uint k = g - h * np; uint o = row * vstride + h * hd; uint pos = posb[row]; float ex = (-2.0f * float(k)) / float(nrot); float fq = fpow(base, ex); float a = float(pos) * fq; float ca = fcos(a); float sa = fsin(a); uint i0 = o + k; uint i1 = o + k + np; float x0 = v[i0]; float x1 = v[i1]; float t0 = x0 * ca; float t1 = x1 * sa; v[i0] = t0 - t1; float t2 = x0 * sa; float t3 = x1 * ca; v[i1] = t2 + t3; }";
  // Attention over each stream's own history: one threadgroup per (stream, query head), 256 threads (mode 1). Stream row attends over
  // posb[row] + 1 positions of its own cache (the arena slice at row * kvstride floats) with its own query (row * qstride), its own
  // scores (row * scstride) and its own output (row * qstride). q38-gqa-tg-msl's body, every sum in its order.
  def q38m-gqa-msl(fname) = "kernel void " ++ fname ++ " (device const float* q [[buffer(0)]], device const float* kc [[buffer(1)]], device const float* vc [[buffer(2)]], device float* y [[buffer(3)]], device float* sc [[buffer(4)]], device const uint* posb [[buffer(5)]], constant uint& nq [[buffer(6)]], constant uint& nkv [[buffer(7)]], constant uint& hd [[buffer(8)]], constant float& scale [[buffer(9)]], constant uint& sstride [[buffer(10)]], constant uint& qstride [[buffer(11)]], constant uint& kvstride [[buffer(12)]], constant uint& scstride [[buffer(13)]], constant uint& nrows [[buffer(14)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { uint gh = tgpig.x; uint row = gh / nq; uint h = gh - row * nq; if (row >= nrows) return; uint npos = posb[row] + 1u; device const float* qr = q + row * qstride; device const float* kcr = kc + row * kvstride; device const float* vcr = vc + row * kvstride; device float* yr = y + row * qstride; device float* scr = sc + row * scstride; threadgroup float sh[16]; uint lid = (uint)sgitg * 32u + (uint)tiisg; uint grp = nq / nkv; uint kvh = h / grp; uint KVD = nkv * hd; uint qoff = h * hd; uint koff = kvh * hd; uint S = h * sstride; uint E = (nq + h) * sstride; for (uint t = lid; t < npos; t += 256u) { float acc = 0.0f; for (uint c = 0u; c < hd; ++c) { acc = metal::fma(qr[qoff + c], kcr[t * KVD + koff + c], acc); } scr[S + t] = acc * scale; } metal::threadgroup_barrier(metal::mem_flags::mem_device); float mx = -3.4e38f; for (uint t = lid; t < npos; t += 256u) { float v = scr[S + t]; if (v > mx) { mx = v; } } mx = metal::simd_max(mx); if (tiisg == 0) { sh[sgitg] = mx; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float gmx = sh[0]; for (uint k = 1u; k < 8u; ++k) { if (sh[k] > gmx) { gmx = sh[k]; } } float se = 0.0f; for (uint t = lid; t < npos; t += 256u) { float e = fexp(scr[S + t] - gmx); scr[E + t] = e; se = se + e; } se = metal::simd_sum(se); if (tiisg == 0) { sh[8u + sgitg] = se; } metal::threadgroup_barrier(metal::mem_flags::mem_device | metal::mem_flags::mem_threadgroup); float tot = 0.0f; for (uint k = 0u; k < 8u; ++k) { tot = tot + sh[8u + k]; } float inv = 1.0f / tot; for (uint c = lid; c < hd; c += 256u) { float acc = 0.0f; for (uint t = 0u; t < npos; ++t) { acc = metal::fma(vcr[t * KVD + koff + c], scr[E + t], acc); } yr[qoff + c] = acc * inv; } }";
  // The key (or value) store into each stream's own cache: stream row's cache is the arena slice at row * maxpos * kvd, and its
  // position is posb[row]. kth-copyoff-msl's store with the row and position folded into the destination.
  def q38m-kvwrite-msl(fname) = "kernel void " ++ fname ++ " (device const float* s [[buffer(0)]], device float* d [[buffer(1)]], device const uint* posb [[buffer(2)]], constant uint& kvd [[buffer(3)]], constant uint& maxpos [[buffer(4)]], constant uint& nrows [[buffer(5)]], uint gid [[thread_position_in_grid]]) { if (gid >= nrows * kvd) return; uint row = gid / kvd; uint i = gid - row * kvd; d[row * maxpos * kvd + posb[row] * kvd + i] = s[row * kvd + i]; }";
 }
 0;
}
