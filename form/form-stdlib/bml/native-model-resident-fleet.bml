package Form.native.residentfleet;

import Form.kernel.*;
import Form.native.modelglass.*;

interface INativeModelResidentFleet [public, witness, reusable] {
   section [public] {
      const String Schema = "native-model-resident-fleet-v1";
      const String RetainRule = "a physical model remains resident and keeps its prefix until measured pressure requires reclamation";
      const String CapacityRule = "admit every physical model whose measured bytes fit the current pressure-adjusted budget";
      const String ParallelRule = "parallel availability means simultaneous live handles; execution overlap is scheduled separately";
      const String EvictionRule = "expert-shard grain precedes KV or substate, which precedes inactive whole-model; within one grain lower use-count precedes older last-use; active units are excluded";
      const String DenseRule = "dense transformer layers are token-required and not independently evictable";
      const String MoERule = "only independently mapped experts may be evicted; packed expert tensors remain indivisible";
      const String PressureRule = "pressure is a correlated glass measurement, never inferred from artifact size alone";
      const String AccessRule = "every physical model evaluation advances the fleet clock and refreshes that model access age without releasing any handle";

      int ResidentBytes() [abstract];
      int LoadedCount() [abstract];
      Object PressurePlan( int nRequestedBytes, int nReclaimBytes ) [abstract];
   }
}

class NativeModelResidentFleet [public, resident, flow, observable, teach] : INativeModelResidentFleet {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-resident-fleet.bml";
      const int DefaultWiredBudgetBytes = 103079215104;
      const int QwenFlashNextWeightBytes = 78869128864;
      const int Llama32ThreeBWeightBytes = 2019377376;
      const int QwenExpertSplitAvailable = 0;

      int ResidentBytes() [abstract] {}
      int LoadedCount() [abstract] {}
      Object PressurePlan( int nRequestedBytes, int nReclaimBytes ) [abstract] {}
   }
}
