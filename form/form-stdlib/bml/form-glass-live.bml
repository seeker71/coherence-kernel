//////////////////////////////////////////////////////////////////////
//
// form-glass-live.bml — live terminal and control adapter authority.
//
// Executable: form-stdlib/form-glass-live.bml
// Physical door: observe/form-glass-live-run.fk
//
//////////////////////////////////////////////////////////////////////

package Form.glass.live;

import Form.kernel.*;
import Form.glass.dashboard.*;
import Form.glass.telemetry.*;

interface IFormGlassLive [public, witness, resident, interactive] {
   section [public] {
      const String Schema = "form-glass-live-v1";
      const String DimensionRule = "columns and lines are polled through an explicitly labeled tput host port until the kernel grows a terminal-size and resize carrier";
      const String RefreshRule = "active external compute refreshes at 250ms, idle organs at 1s, current-process rows at 5 frames, privacy-bounded host and fkwu process rows at 30 frames, and storage catalog at 30 frames; identical terminal projections are held";
      const String DemandRule = "a missing acceleration image leaves source as the dispatch candidate but proves neither demand nor after-start JIT; Glass names the current whole-unit-blocking admission on the same visible row";
      const String TerminalSafetyRule = "the live adapter clears and homes without hiding the cursor or requiring an alternate-screen cleanup handler";
      const String ControlRule = "a second terminal offers focus, continue, request-evidence, or abstain to the glass-monitor channel; focus accepts any currently visible sample channel or cell id, unsupported actions are refused, and local state commits only after a correlated acknowledgement is written";
      const String ControlFreshnessRule = "an inbox offer older than thirty seconds is acknowledged stale and never replayed after monitor restart";
      const String OwnershipRule = "standalone glass reads typed external publisher snapshots; its own process sample and projections remain local, while Metal, MLX, framebuffer, and model handles are truthful only when their owning fkwu process publishes them";
      const String LeaseRule = "a publication older than five seconds remains visible only as an explicit last-observed stale projection; a surviving file never proves a living owner";
      const String DuplicateRule = "repeated sample ids retain the greatest millisecond snapshot epoch, independent of whole-second mtime ties, so old owner snapshots cannot form a wall of duplicate stale models";
      const String PrivacyRule = "live snapshots and controls contain identifiers, counters, states, provenance, and enum actions; never prompt or answer bytes";
      const String ProcessRule = "a byte-bounded exact-name pgrep yields digit-validated fkwu PIDs; one fixed per-PID ps host port requests RSS, CPU, elapsed, and comm only, then Form discards comm and never requests argv or scans another process";
      const String ObserverTaxRule = "glass.monitor composes itself locally, never serializes or reparses its own changing epoch, holds current-process rows for five frames, suppresses identical terminal projections, and keeps primitive scan heat visible";

      Object Live() [abstract];
      Object Control() [abstract];
   }
}

class FormGlassLive [public, resident, observable, flow, teach] : IFormGlassLive {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-live.bml";
      const String TelemetryRoot = "/tmp/form-glass-telemetry";
      const String MonitorPublisher = "glass.monitor";
      const String MonitorControlChannel = "glass-monitor";
      const Int FreshLeaseMilliseconds = 5000;
      const Int ControlFreshMilliseconds = 30000;

      Object Live() [abstract] {}
      Object Control() [abstract] {}
   }
}
