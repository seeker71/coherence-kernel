//////////////////////////////////////////////////////////////////////
//
// form-glass-live.bml — live terminal and control adapter authority.
//
// Executable: form-stdlib/form-glass-live.bml
// Physical door: observe/form-glass-live-run.fk
//
//////////////////////////////////////////////////////////////////////

package Form.glass.live;

import Form.kernel.*;
import Form.glass.dashboard.*;
import Form.glass.telemetry.*;

interface IFormGlassLive [public, witness, resident, interactive] {
   section [public] {
      const String Schema = "form-glass-live-v2";
      const String DimensionRule = "columns and lines are polled through an explicitly labeled tput host port until the kernel grows a terminal-size and resize carrier";
      const String RefreshRule = "one persistent process targets complete-frame deadlines of 250ms for active or moving work and 500ms for quiet work; observation time is subtracted before waiting, overruns continue immediately, carrier counters refresh every frame, primitive heat every 4 frames, host rows every 16 frames, and storage every 20 frames";
      const String DemandRule = "a missing acceleration image leaves source as the dispatch candidate but proves neither demand nor after-start JIT; Glass names the current whole-unit-blocking admission on the same visible row";
      const String TerminalSafetyRule = "the live adapter clears and homes without hiding the cursor or requiring an alternate-screen cleanup handler";
      const String ControlRule = "the correlated sidecar offers focus, inspect, continue, request-evidence, or abstain; focus selects a view or channel, inspect selects an id, evidence drills into provenance, local state commits only after an acknowledgement is written, and acknowledgement time never precedes offer time";
      const String InputCarrierRule = "the live footer exposes the line-commit sidecar as the current input carrier; interaction remains a real correlated offer and acknowledgement rather than a simulated raw-key path";
      const String HistoryRule = "the process retains the latest 128 observed-frame flow points across repaint suppression; stored epochs preserve actual adaptive cadence while a pure 240-step quarter-second fixture proves rollover without waiting sixty seconds";
      const String ProjectionRule = "the first or resized frame is complete and subsequent frames emit only changed semantic rows without resetting retained history";
      const String ModelNameRule = "Glass never synthesizes qwen, threeb, expert, or KV names; model and substate rows arrive only from a current owner publication carrying canonical identity";
      const String ObservationRule = "each frame joins the typed current structure, JIT, and Metal observation-v2 spine before projection and derives flow counters from those truths when available";
      const String ControlFreshnessRule = "an inbox offer older than thirty seconds is acknowledged stale and never replayed after monitor restart";
      const String RestartControlRule = "replacement startup reads the last correlated acknowledgement and seeds its consumed-offer identity before polling so even a still-fresh abstain cannot replay across process lifetime";
      const String SupervisorRule = "the zsh terminal carrier owns only foreground process supervision; Form writes running, selfmolt, or abstain state and alone decides whether a completed monitor is reborn";
      const String SelfMoltRule = "every fourth frame compares the complete launcher dependency identity; any changed source returns selfmolt so the carrier revalidates crystals and replaces the resident within one quiet-frame interval";
      const String VisiblePulseRule = "the top pulse line changes every frame and carries millisecond UTC, sequence, observed delta, target cadence, dispatch delta, framebuffer roots, NodeID count, and live arena-cons allocation count scoped to the monitor process";
      const String QueueRule = "queue depth is physical-live only while hearth board PID liveness is current; ownerless task and reply spools remain visible as durable catalog frames and never masquerade as a live request queue";
      const String GovernorRefreshRule = "once per four monitor frames a cached Form publisher refreshes the typed resource.governor snapshot without running the atomic proof fixture; unexposed host signals remain named fail-closed doors";
      const String OwnershipRule = "standalone glass reads typed external publisher snapshots; its own process sample and projections remain local, while Metal, MLX, framebuffer, and model handles are truthful only when their owning fkwu process publishes them";
      const String LeaseRule = "a publication older than five seconds remains visible only as an explicit last-observed stale projection; a surviving file never proves a living owner";
      const String DuplicateRule = "repeated sample ids and model rows sharing one physical handle retain the greatest millisecond snapshot epoch, independent of whole-second mtime ties, so old aliases cannot form a wall of duplicate stale models";
      const String AllocationIdentityRule = "sample id and numeric handle are allocation-local: deduplication requires the same publisher identity before either can alias; cross-publisher rows remain separate physical allocations until a shared process incarnation is proven";
      const String LegacyMigrationRule = "the exact pre-incarnation models.dual-resident snapshot is ignored only while an incarnated models.dual-resident.i publisher is present; no arbitrary stale publisher is silently retired";
      const String PrivacyRule = "live snapshots and controls contain identifiers, counters, states, provenance, and enum actions; never prompt or answer bytes";
      const String ProcessRule = "a byte-bounded exact-name pgrep yields digit-validated fkwu PIDs; one fixed per-PID ps host port requests RSS, CPU, elapsed, and comm only, then Form discards comm and never requests argv or scans another process";
      const String ObserverTaxRule = "glass.monitor composes itself locally, never serializes or reparses its own changing epoch, holds current-process rows for five frames, suppresses identical terminal projections, keeps primitive scan heat visible, and places previous-frame work wait and target milliseconds first in the metric stream as physical values while the first incomplete frame remains typed unavailable";

      Object Live() [abstract];
      Object Control() [abstract];
   }
}

class FormGlassLive [public, resident, observable, flow, teach] : IFormGlassLive {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-live.bml";
      const String TelemetryRoot = "/tmp/form-glass-telemetry";
      const String MonitorPublisher = "glass.monitor";
      const String MonitorControlChannel = "glass-monitor";
      const Int FreshLeaseMilliseconds = 5000;
      const Int ControlFreshMilliseconds = 30000;

      Object Live() [abstract] {}
      Object Control() [abstract] {}
   }
}
