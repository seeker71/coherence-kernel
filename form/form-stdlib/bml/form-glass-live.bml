//////////////////////////////////////////////////////////////////////
//
// form-glass-live.bml — live terminal and control adapter authority.
//
// Executable: form-stdlib/form-glass-live.bml
// Physical door: observe/form-glass-live-run.fk
//
//////////////////////////////////////////////////////////////////////

package Form.glass.live;

import Form.kernel.*;
import Form.glass.dashboard.*;
import Form.glass.telemetry.*;

interface IFormGlassLive [public, witness, resident, interactive] {
   section [public] {
      const String Schema = "form-glass-live-v2";
      const String DimensionRule = "columns and lines are polled through an explicitly labeled tput host port until the kernel grows a terminal-size and resize carrier";
      const String RefreshRule = "one persistent process targets complete-frame deadlines of 250ms for transient request attention or moving work and 500ms for quiet work; resident, loaded, prefilled, heartbeat, cache, mapping, and counter rows prove readiness but never hold the monitor at 4Hz; observation time is subtracted before waiting, overruns continue immediately, carrier counters and the exact model-owner PID RSS CPU elapsed and nice rows refresh every frame, primitive heat every 4 frames, other host rows every 16 frames, and storage every 20 frames";
      const String EventLoopRule = "deadline arithmetic and front/back frame state are Form-native and JIT refusal is the highest-priority typed wake; idle-polling-remains-unreplaced because the kernel lacks kernel.monotonic-ms and kernel.monotonic-wait-until-path-change, while FIFO/TCP substitution would violate producer nonblocking; the existing host sleep remains a named compatibility seam until that carrier exists";
      const String AttentionCadenceRule = "physical-live active request rows and the owner's model-state active row are the only state samples that raise cadence; completed or failed retained request history stays visible but cannot pin active cadence";
      const String DemandRule = "a missing acceleration image leaves source as the dispatch candidate but proves neither demand nor after-start JIT; Glass names the current whole-unit-blocking admission on the same visible row";
      const String TerminalSafetyRule = "the live adapter clears and homes without hiding the cursor or requiring an alternate-screen cleanup handler";
      const String ControlRule = "the correlated sidecar offers focus, inspect, continue, request-evidence, or abstain; focus selects help or a data view or channel, inspect selects an id, evidence drills into provenance, local state commits only after an acknowledgement is written, acknowledgement time never precedes offer time, and the terminal client waits at most two seconds before naming glass.monitor.control-ack as the missing door";
      const String InputCarrierRule = "form-glassctl maps the line-committed keys h a t o m f j i e c q to help, view, inspect, evidence, continue, and abstain offers; each key is a real correlated offer and acknowledgement rather than a simulated raw-key path";
      const String HistoryRule = "the process retains the latest 128 observed-frame flow points across repaint suppression; stored epochs preserve actual adaptive cadence while a pure 240-step quarter-second fixture proves rollover without waiting sixty seconds";
      const String ProjectionRule = "collection stages a back frame while the terminal retains the front frame, commit swaps them, the first or resized frame is complete, and subsequent frames emit only changed semantic rows without resetting retained history";
      const String ModelNameRule = "Glass never synthesizes qwen, threeb, expert, or KV names; model and substate rows arrive only from a current owner publication carrying canonical identity";
      const String ModelRouteTruthRule = "each frame joins lease-current owner liveness, its PID-and-start-correlated heartbeat, and same-epoch loaded and prefilled states before showing the exact Qwen3.8-Flash-Next UD-Q2_K_XL (Unsloth), Llama-3.2-3B-Instruct, and combined route as ready; otherwise each route displays its exact missing observation door";
      const String ObservationRule = "each frame joins the typed current-process structure, JIT, and Metal observation-v2 spine with separately owner-scoped primitive, JIT, Metal, MLX, mapping, and tensor-ledger observations; owner values retain publisher PID/start/sequence/observed provenance and never blend into local zeroes";
      const String RequestWindowRule = "Flow selects gpu.owner.busy-us-total jit.owner.metal-busy-us and metal.owner.dispatch-total before deriving adjacent-frame request windows; it selects queue-depth only from a standing Hearth, carries exact source or missing door into history, and never substitutes monitor-local post-drain zero";
      const String ControlFreshnessRule = "an inbox offer older than thirty seconds is acknowledged stale and never replayed after monitor restart";
      const String RestartControlRule = "replacement startup reads the last correlated acknowledgement and seeds its consumed-offer identity before polling so even a still-fresh abstain cannot replay across process lifetime";
      const String SupervisorRule = "the zsh terminal carrier owns only foreground process supervision; Form writes running, selfmolt, or abstain state and alone decides whether a completed monitor is reborn";
      const String SelfMoltRule = "every fourth frame compares the complete launcher dependency identity; any changed source returns selfmolt so the carrier revalidates crystals and replaces the resident within one quiet-frame interval";
      const String StringPoolRule = "each flow point carries the current-process interned-string count; Glass renders count, per-frame delta, rate, scope, and impact, and returns selfmolt after 262144 strings or 262144 projection nodes of process-lifetime growth so the supervisor bounds roughly ninety seconds of observed growth without touching model owners; the native north-star door is kernel.ephemeral-render-string";
      const String VisiblePulseRule = "the top pulse line changes every frame and carries millisecond UTC, sequence, observed delta, target cadence, dispatch delta, framebuffer roots, NodeID count, and live arena-cons allocation count scoped to the monitor process";
      const String QueueRule = "queue depth is physical-live only while hearth board PID liveness is current; file_size and read_file typed nothing are handled before string measurement; ownerless task and reply spools remain visible as durable catalog frames and never masquerade as a live request queue";
      const String GovernorRefreshRule = "once per four monitor frames a cached Form publisher refreshes the typed resource.governor snapshot without running the atomic proof fixture; unexposed host signals remain named fail-closed doors";
      const String OwnershipRule = "standalone glass reads typed external publisher snapshots; its own process sample and projections remain local, while owner Metal, MLX, JIT, primitive, model-handle and tensor values remain separately keyed to the exact publishing fkwu lifetime; allocation extents may be derived only by joining current PID/start/handles with the same Form size authority used to allocate them";
      const String AllocationProfileRule = "Glass never promotes exact Qwen or Llama fallback extents from catalog or collision-prone size-plus-mtime equality; stat rows must be captured once after open and join the same owner and carrier handle, and an inode or content-digest profile label is never evidence: Glass separately requires a physical-live owner sample whose carried strong-identity kind and exact value, parent, handle, and open epoch all match; the current carrier publishes no such sample, so exact fallback is unreachable and withheld";
      const String MLXOwnerPathRule = "the dual resident model owner executes Qwen and Llama through Metal, so MLX allocation on this owner path is an idle not-on-owner-model-path observation with absent numeric fields, never an ambiguous zero";
      const String LeaseRule = "a publication older than five seconds remains visible only as an explicit last-observed stale projection; its publisher identity is preserved so one typed flow never fragments, snapshot-stale is added as a channel, physical-live is demoted to derived-window, and a surviving file never proves a living owner";
      const String BoundedInspectionRule = "one bounded current-frame door selects atlas or flow explicitly while sharing the resident monitor collectors, typed inventory, and renderer; it never starts a second dashboard process";
      const String DuplicateRule = "repeated sample ids and model rows sharing one physical handle retain the greatest millisecond snapshot epoch, independent of whole-second mtime ties, so old aliases cannot form a wall of duplicate stale models";
      const String AllocationIdentityRule = "sample id and numeric handle are allocation-local: deduplication requires the same publisher identity before either can alias; cross-publisher rows remain separate physical allocations until a shared process incarnation is proven";
      const String LegacyMigrationRule = "the exact pre-incarnation models.dual-resident snapshot is ignored only while an incarnated models.dual-resident.i publisher is present; no arbitrary stale publisher is silently retired";
      const String PrivacyRule = "live snapshots and controls contain identifiers, counters, states, provenance, and enum actions; never prompt or answer bytes";
      const String ProcessRule = "a byte-bounded exact-name pgrep yields digit-validated fkwu PIDs; one fixed per-PID ps host port requests RSS, CPU, elapsed, and comm, then Form discards comm; the exact current model-owner PID/start join adds one bounded nice query so cooperative priority is measured every frame without scanning argv or another process";
      const String ObserverTaxRule = "glass.monitor composes itself locally, never serializes or reparses its own changing epoch, holds current-process rows for five frames, suppresses identical terminal projections, keeps primitive scan heat visible, and places previous-frame work wait and target milliseconds first in the metric stream as physical values while the first incomplete frame remains typed unavailable with one exact completed-predecessor door per field";

      Object Live() [abstract];
      Object Control() [abstract];
   }
}

class FormGlassLive [public, resident, observable, flow, teach] : IFormGlassLive {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-live.bml";
      const String TelemetryRoot = FormHearth.HearthTelemetryRoot;
      const String MonitorPublisher = "glass.monitor";
      const String MonitorControlChannel = "glass-monitor";
      const Int FreshLeaseMilliseconds = 5000;
      const Int ControlFreshMilliseconds = 30000;

      Object Live() [abstract] {}
      Object Control() [abstract] {}
   }
}
