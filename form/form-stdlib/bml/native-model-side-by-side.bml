//////////////////////////////////////////////////////////////////////
//
// native-model-side-by-side.bml — authority for one honest comparison
// surface over every row in the native model registry.
//
// A registry field is comparable as written.  Runtime capability and
// throughput are a second overlay: absent evidence is rendered explicitly
// as `unmeasured`, never promoted from a model name or a nearby backend.
//
//////////////////////////////////////////////////////////////////////

package Form.native.modelcomparison;

import Form.kernel.*;
import Form.native.models.*;

interface INativeModelSideBySide [public, witness, reusable] {
   section [public] {
      const String Schema = "native-model-side-by-side-v1";
      const String PopulationRule = "exactly one projected row for every registry row";
      const String UnknownRule = "missing capability evidence is the literal unmeasured";
      const String AuthorityRule = "comparison reports evidence and cannot promote a model";
      const String PerformanceRule = "wall throughput and acceptance state remain distinct";
      const String FormTokenRule = "every registry row carries explicit local, prompt-admitted, native-admitted, delivery-mode, state, reason, native-word count, action-proposal state, query-lane symbol count, admitted symbol count, and assemblage fields";
      const int QwenDecodeFloorMilliTokps = 23922;
      const int QwenPrefillFloorMilliTokps = 286947;

      int ProjectedCount( int nRegistryRows ) [abstract];
      bool PopulationComplete( int nRegistryRows, int nProjectedRows ) [abstract];
      bool PerformanceAccepted( int nDecodeMilliTokps, int nPrefillMilliTokps ) [abstract];
   }
}

class NativeModelSideBySide [public, reusable, teach, observable] : INativeModelSideBySide {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-side-by-side.bml";
      const String QwenModelId = "challenger.qwen38-flash-next-q2-metal";
      const String QwenParity = "proven-two-token-parity";
      const String QwenPerformance = "failing-90pct-gate";
      const String FormTokenEnvelope = "native-model-form-token-envelope-v1";
      const String FormSymbolStream = "native-model-symbol-stream-v1";

      int ProjectedCount( int nRegistryRows ) [abstract] {}
      bool PopulationComplete( int nRegistryRows, int nProjectedRows ) [abstract] {}
      bool PerformanceAccepted( int nDecodeMilliTokps, int nPrefillMilliTokps ) [abstract] {}
   }
}
