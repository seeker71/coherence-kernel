// Recover validated token events from retained stdout; never rerun a model.
// Original observations remain intact. Replayed elapsed time uses the child's
// epoch stamp relative to process start, not a reconstructed parent read time.
// preludes: form-stdlib/bml/form-cli-heal-native-process.bml form-stdlib/native-session-memory.bml
section [form.bml] {
 class FormCliHealFlowReplay {
  def fhrr-lines(lines,start) = if nil?(lines) then list() else if eq(str_find(head(lines),"form-heal flow ",0),0) then cons(fhrr-row(head(lines),start),fhrr-lines(tail(lines),start)) else fhrr-lines(tail(lines),start);
  def fhrr-row(line,start) {
   let doc = parse-json("retained-native-flow",substring(line,15,str_len(line)));
   if not(fhn-flow-valid(doc)) then form_error("retained token event invalid; original stdout preserved") else json-node-object(append(json-object-pairs(doc),list(nsm-n("elapsed_ms",sub(fhn-number(doc,"stamp_ms"),start)),nsm-s("timing_basis","child-epoch-stamp-minus-process-start"))));
  }
  def fhrr-text(rows) = if nil?(rows) then "" else str_concat(json-emit(head(rows)),str_concat("\n",fhrr-text(tail(rows))));
  def fhrr-last(rows) = if nil?(tail(rows)) then head(rows) else fhrr-last(tail(rows));
  def fhrr-run(home) {
   let output = nsm-at(home,"eval-model.out");
   let process = nsm-json(nsm-at(home,"eval-model.process.json"));
   let rows = fhrr-lines(split-on(nsm-text(output),"\n"),nsm-num(process,"started_unix_ms"));
   if not(str_eq(nsm-str(process,"state"),"finished")) then form_error("flow replay requires a finished process receipt") else if nil?(rows) then form_error("no token events to recover") else fhrr-save(home,output,process,rows);
  }
  def fhrr-save(home,output,process,rows) {
   let saved = nag-write(nsm-at(home,"replayed-flow.jsonl"),fhrr-text(rows));
   let last = fhrr-last(rows);
   let report = json-node-object(list(nsm-s("schema","form-heal-flow-replay-v1"),nsm-s("source_sha256",nsm-hash(nsm-text(output))),nsm-n("events",len(rows)),nsm-n("input_tokens",nsm-num(last,"input_tokens")),nsm-n("last_observed_output_tokens",nsm-num(last,"output_tokens")),nsm-s("last_phase",nsm-str(last,"phase")),nsm-s("model",nsm-str(last,"model")),nsm-s("adapter_state",nsm-str(last,"adapter_state")),nsm-n("process_status",nsm-num(process,"status")),json-node-pair("child_returncode",if json-object-has?(process,"returncode") then json-object-get(process,"returncode") else json-node-null()),nsm-n("process_wall_ms",nsm-num(process,"elapsed_ms")),nsm-s("process_reason",nsm-str(process,"reason")),nsm-s("scope","recovered-emitted-events;no-estimated-final-token-count;original-receipts-retained")));
   let published = nsm-write(nsm-at(home,"replayed-flow-summary.json"),report);
   report;
  }
 }
 0;
}
