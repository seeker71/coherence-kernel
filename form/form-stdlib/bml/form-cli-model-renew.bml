// Independent conversations share admitted weights, never stream history.
// The returned session replaces the caller's owner, including on refusal.
// Success retires the old stream; it must never be resumed or released again.
// No model admission, weight update, transcript persistence or remote call.
// preludes: form-stdlib/form-cli-model-session.fk form-stdlib/organ-health.bml
section [form.bml] {
 class FormCliModelRenew {
  def fcmr-result(changed,reason,session) = list(changed,reason,session);
  def fcmr-changed(result) = result[0];
  def fcmr-reason(result) = result[1];
  def fcmr-session(result) = result[2];
  def fcmr-id-valid(id,vocab) = !((String) value_kind(id) == "int") ? 0 : ((id >= 0) && (id < vocab));
  def fcmr-ids-valid(ids,vocab) = nil?(ids) ? 1 : (fcmr-id-valid(head(ids),vocab) && fcmr-ids-valid(tail(ids),vocab));
  def fcmr-input-reason(session,ids) {
   !fcms-resident?(session) ? "no-resident-context"
   : !fcms-live?(session) ? "session-not-live"
   : !((String) value_kind(ids) == "list") ? "prompt-ids-need-list"
   : nil?(ids) ? "empty-prompt"
   : len(ids) >= fcms-maxpos(session) ? "prompt-context-window-refused"
   : !fcmr-ids-valid(ids,fcms-ctx(session)[2][19]) ? "prompt-token-id-refused"
   : "";
  }
  def fcmr-new-session(previous,state,prefill,count) = fcmd-inherit(previous,fcms-session("live","fresh-stream-same-weights",fcms-path(previous),fcms-src(previous),fcms-ctx(previous),state,fcms-maxpos(previous),prefill[1],head(prefill),0,count,0,0,0));
  def fcmr-reading(flow,reason,good,expected,observed) = oh-reading("model-session",flow,"independent-stream",expected,observed,json-node-int(good),good ? list() : list(oh-need(reason,json-node-null())),list("replace-stream","retain-session","inspect-state-release"),json-node-null());
  def fcmr-observed(flow,result,expected,observed) {
   let reading = oh-voice(fcmr-reading(flow,fcmr-reason(result),fcmr-changed(result) && ((String) fcmr-reason(result) == "fresh-stream-same-weights"),expected,observed));
   result;
  }
  def fcmr-any-prompt(session,count,contract) = 1;
  def fcmr-replace-ids(session,ids) = fcmr-replace-ids-checked(session,ids,fcmr-any-prompt,0);
  // Check caller reply capacity after encoding and before allocation/prefill.
  // A refusal retains the original owner, stream and cost counters.
  def fcmr-replace-ids-checked(session,ids,check,contract) {
   let flow = int_to_str(host_pid()) ++ ":renew:" ++ int_to_str(now_unix_ms());
   let reason = fcmr-input-reason(session,ids);
   !((String) reason == "") ? fcmr-observed(flow,fcmr-result(0,reason,session),json-node-string("admissible independent prompt"),json-node-string(reason))
   : !check(session,len(ids),contract) ? fcmr-observed(flow,fcmr-result(0,"prompt-caller-capacity-refused",session),json-node-string("prompt and caller reply reserve fit"),json-node-int(len(ids)))
   : !fcmo-settled(metal_live()) ? fcmr-observed(flow,fcmr-result(0,"device-work-not-settled",session),json-node-string("settled device"),json-node-string("pending device work"))
   : fcmr-prepare(flow,session,ids);
  }
  def fcmr-prepare(flow,session,ids) {
   let reading = fcmr-reading(flow,"independent-stream-needed",0,json-node-string("fresh conversation state"),json-node-string("existing conversation state"));
   let voiced = oh-voice(reading);
   let response = oh-response(reading,"replace-stream");
   let answered = oh-voice(response);
   let selected = oh-select(reading,response,"retain-session");
   !((String) selected == "replace-stream") ? fcmr-result(0,"renewal-not-selected",session)
   : fcmr-allocated(flow,session,ids,reading,q38-new-state(fcms-ctx(session)[2]));
  }
  def fcmr-allocated(flow,session,ids,reading,fresh) {
   let good = fcmr-state-complete?(fresh,fcms-ctx(session)[2]);
   !good ? fcmr-discard(flow,session,fresh,"new-stream-allocation-refused")
   : fcmr-prefilled(flow,session,ids,reading,fresh,fcmr-prefill(fcms-ctx(session),fresh,ids));
  }
  def fcmr-state-complete?(state,geo) = ((Comparable) len(state) == geo[21]) && (((Comparable) q38-state-handle-count(state) == (2 * geo[21])) && q38-state-ok?(state));
  def fcmr-span(ctx,count) = q38-ctx-span(ctx) < fcma-span(count) ? q38-ctx-span(ctx) : fcma-span(count);
  def fcmr-prefill(ctx,state,ids) = fcmo-walk(fcmo-native-step,ctx,state,ids,0,fcmr-span(ctx,len(ids)));
  def fcmr-discard(flow,session,fresh,reason) {
   let settled = metal_sync();
   let expected = q38-state-handle-count(fresh);
   let released = q38-free-state(fresh);
   fcmr-observed(flow,fcmr-result(0,(Comparable) expected == released ? reason : "candidate-stream-release-incomplete",session),json-node-int(expected),json-node-int(released));
  }
  def fcmr-prefilled(flow,session,ids,reading,fresh,prefill) {
   !fcmo-shape(prefill,0,len(ids)) ? fcmr-discard(flow,session,fresh,"new-stream-prefill-refused")
   : fcmr-retire(flow,session,ids,reading,fresh,prefill);
  }
  def fcmr-retire(flow,session,ids,reading,fresh,prefill) {
   let settled = metal_sync();
   let expected = q38-state-handle-count(fcms-sts(session));
   let released = q38-free-state(fcms-sts(session));
   let next = fcms-refresh-head(fcmr-new-session(session,fresh,prefill,len(ids)));
   let applied = oh-voice(oh-applied(reading,"replace-stream",json-node-object(list(oh-n("prompt_ids",len(ids)),oh-n("old_state_handles_expected",expected),oh-n("old_state_handles_released",released),oh-n("weight_admissions",0)))));
   fcmr-observed(flow,fcmr-result(1,(Comparable) expected == released ? (fcms-live?(next) ? "fresh-stream-same-weights" : fcms-reason(next)) : "old-stream-release-incomplete",next),json-node-int(expected),json-node-int(released));
  }
  def fcmr-replace-with-profile(session,prompt,profile) = fcmr-replace-with-profile-checked(session,prompt,profile,fcmr-any-prompt,0);
  def fcmr-replace-with-profile-checked(session,prompt,profile,check,contract) {
   !fcms-resident?(session) ? fcmr-result(0,"no-resident-context",session)
   : !fcms-live?(session) ? fcmr-result(0,"session-not-live",session)
   : fcmr-encode-checked(session,prompt,profile,qsx-load(fcms-path(session)),check,contract);
  }
  def fcmr-encode(session,prompt,profile,crystal) = fcmr-encode-checked(session,prompt,profile,crystal,fcmr-any-prompt,0);
  def fcmr-encode-checked(session,prompt,profile,crystal,check,contract) {
   (Comparable) crystal[0] != 1 ? fcmr-replace-ids-checked(session,fcmg-chat-ids-profile(fcms-src(session),prompt,profile),check,contract)
   : fcmr-encoded-checked(session,qtlc-drain(fcmg-chat-cursor-profile(fcms-path(session),prompt,profile,crystal)),check,contract);
  }
  def fcmr-encoded(session,result) = fcmr-encoded-checked(session,result,fcmr-any-prompt,0);
  def fcmr-encoded-checked(session,result,check,contract) = !((String) head(result) == "done") ? fcmr-result(0,"prompt-cursor-refused",session) : fcmr-replace-ids-checked(session,result[1],check,contract);
 }
 0;
}
