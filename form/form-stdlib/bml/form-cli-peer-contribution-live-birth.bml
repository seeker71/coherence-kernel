//////////////////////////////////////////////////////////////////////
// form-cli-peer-contribution-live-birth.bml -- BML-owned birth packet
// for the durable spool resident. The entry owns model admission; this
// grammar names its cache, assembly stages, discoverability and release.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/bml/form-cli-peer-live-framebuffer.bml form-stdlib/hearth.bml form-stdlib/organ-health.bml

section [form.bml] {
    class FormCliPeerContributionLiveBirth {
        field EntrySource = "observe/form-cli-peer-contribution-live.fk";
        field EntryCacheSuffix = ".fkb";
        field Tag = "form-cli-peer-contribution-birth-v1";

        def fcpclb-entry-source() = EntrySource();
        def fcpclb-entry-cache() = str_concat(fcpclb-entry-source(), EntryCacheSuffix());
        def fcpclb-cache-state() {
            let source = file_mtime(fcpclb-entry-source());
            let cache = file_mtime(fcpclb-entry-cache());
            if lt(source, 0) then "missing" else if lt(cache, 0) then "cold" else if ge(cache, source) then "ready" else "stale";
        }
        // snapshot = cache source-context-ms native-program-ms setup-ms.
        // A numeric zero is an observed duration; missing context is nothing().
        def fcpclb-birth(cache, sourceContextMs, nativeProgramMs, setupMs) = list(Tag(), cache, sourceContextMs, nativeProgramMs, setupMs);
        def fcpclb-birth?(birth) = if nothing?(birth) then 0 else if not(eq(len(birth), 5)) then 0 else str_eq(nth(birth, 0), Tag());
        def fcpclb-cache(birth) = nth(birth, 1);
        def fcpclb-source-context-ms(birth) = nth(birth, 2);
        def fcpclb-native-program-ms(birth) = nth(birth, 3);
        def fcpclb-setup-ms(birth) = nth(birth, 4);
        def fcpclb-line(name, value) = print_str(str_concat("form-peer ", str_concat(name, str_concat("=", str_concat(value, "\n")))));
        def fcpclb-int(name, value) = fcpclb-line(name, int_to_str(value));
        def fcpclb-report-int(name, value) = if nothing?(value) then 0 else fcpclb-int(name, value);
        def fcpclb-report(birth) {
            fcpclb-line("program-image-cache", fcpclb-cache(birth));
            let source = fcpclb-report-int("source-context-ms", fcpclb-source-context-ms(birth));
            let native = fcpclb-report-int("native-program-ms", fcpclb-native-program-ms(birth));
            let setup = fcpclb-report-int("resident-setup-ms", fcpclb-setup-ms(birth));
            0;
        }
        def fcpclb-stage-int(stage, value) = if nothing?(value) then fcplf-record(0, stage, "nothing") else fcplf-record(0, stage, int_to_str(value));
        def fcpclb-record-birth(birth) {
            let cache = fcplf-record(0, "resident-cache", fcpclb-cache(birth));
            let source = fcpclb-stage-int("source-context-ready", fcpclb-source-context-ms(birth));
            let native = fcpclb-stage-int("native-program-ready", fcpclb-native-program-ms(birth));
            let setup = fcpclb-stage-int("resident-setup", fcpclb-setup-ms(birth));
            0;
        }
        def fcpclb-record-prefill(ms) = fcplf-record(0, "prefill-ready", int_to_str(ms));
        def fcpclb-report-prefill(ms) = fcpclb-int("admit-prefill-ms", ms);
        def fcpclb-record-release(ok) = fcplf-record(0, "release", int_to_str(ok));
        def fcpclb-hearth-paths?(task, reply, bell) = and(str_eq(task, hearth-task()), and(str_eq(reply, hearth-reply()), str_eq(bell, hearth-bell())));
        def fcpclb-board-reading(wanted, actual) {
            let same = str_eq(wanted, actual);
            let evidence = oh-reference(hearth-board());
            oh-reading("hearth-resident", int_to_str(host_pid()), "discovery-board", json-node-string(wanted), json-node-string(actual), json-node-int(same), if same then list() else list(oh-need("current-resident-board", evidence)), list("publish-current-board"), evidence);
        }
        def fcpclb-board-publish(wanted) {
            let before = hearth-board-read();
            let reading = fcpclb-board-reading(wanted, before);
            let observed = oh-voice(reading);
            if str_eq(wanted, before) then 1 else fcpclb-board-apply(wanted, reading);
        }
        def fcpclb-board-apply(wanted, reading) {
            let response = oh-response(reading, "publish-current-board");
            let heard = oh-voice(response);
            let action = oh-select(reading, response, "");
            if not(str_eq(action, "publish-current-board")) then 0 else {
                let written = write_file(hearth-board(), wanted);
                let applied = oh-voice(oh-applied(reading, action, json-node-int(written)));
                let after = hearth-board-read();
                let observed = oh-voice(fcpclb-board-reading(wanted, after));
                str_eq(wanted, after);
            };
        }
        // Custom spool residents remain independent. Only the resident using
        // this checkout's canonical paths publishes the discovery board.
        def fcpclb-register(task, reply, bell) = if fcpclb-hearth-paths?(task, reply, bell) then fcpclb-board-publish(hearth-board-text(host_pid(), hearth-capabilities())) else 1;
        // Release discovery before closing the model. A board naming another
        // resident belongs to that resident and remains untouched.
        def fcpclb-unregister() = if eq(hearth-board-pid(), host_pid()) then fcpclb-board-publish("") else 1;
    }
    0;
}
