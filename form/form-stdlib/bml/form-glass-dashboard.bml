package Form.glass.dashboard;

import Form.kernel.*;
import Form.surface.terminalcanvas.*;
import Form.glass.observer.*;
import Form.glass.telemetry.*;

interface IFormGlassDashboard [public, witness, reusable, surface-neutral] {
   section [public] {
      const String Schema = "form-glass-dashboard-v1";
      const String SceneRule = "the dashboard is a Form canvas scene; terminal ANSI is one adapter and another surface may project the same scene";
      const String ProvenanceRule = "physical-live, derived-window, catalog, declared, and unavailable are visible glyphs rather than footnotes";
      const String MemoryRule = "physical RSS, materialized model residence, logical catalog artifact extent, carrier-mapped extent, handle presence, callable route readiness, Form cell/node/tensor counts, and unavailable residence stay separate by unit and evidence; catalog weight bytes never enter the mapped or materialized resident totals";
      const String MemoryMapRule = "each measured region carries size, shape, plane color, truth glyph, lifecycle symbol, channels, and read/write-age alpha; absent sizes receive zero area and collapse into one unavailable-regions line, while attached catalog weights remain artifact-logical extents rather than mapped or physical residence";
      const String AgeRule = "observed semantic read and write epochs appear as separate textual ages and control monotonic retained alpha; absent access epochs remain named absent and publication time is never substituted";
      const String NonValueRule = "measured zero renders with its semantic state empty, drained, idle, or quiet while absent, unavailable, stale, and error carry their reason and exact missing door and never collapse into a question mark or sentinel number";
      const String NodeIDRule = "segment selector ids remain selectors; each local metric value has a real Glass projection Package.Level.Type.Instance, while evidence keeps external producer source-nodeid separate and unbound at telemetry.nodeid-owner-binding unless an interned framebuffer source node is present";
      const String ResponsiveRule = "the scene uses the exact observed terminal columns and lines; below 40x12 it enters an exact-size compact projection and never substitutes a larger fallback";
      const String InteractionRule = "the glass-monitor control channel may focus any currently visible sample channel or cell id; arbitrary publisher channels require their own consumer";
      const String MissingCarrierRule = "same-terminal raw keys, mouse, resize events, per-handle Metal bytes, and VM page age remain named carrier seams";
      const String RenderPipelineRule = "the Rich-inspired path is GlassSample -> semantic memory regions -> measure -> region allocation -> styled segments -> shaped lines -> full-frame terminal projection; the exact cell-canvas adapter separately supports diff and other surfaces";
      const String OverflowRule = "crop, ellipsis, fold, and hidden-count are explicit for samples and metrics; the live glass names hidden rows";
      const String StabilityRule = "default rows exclude absolute self-monotonic dispatch and intern counters; they remain available through primitive and memory focus without forcing repaint feedback";

      Object Scene( Int width, Int height, Int epoch, String focus, Object metrics, Object samples, Object publishers, String controlState ) [abstract];
   }
}

class FormGlassDashboard [public, resident, observable, flow, teach] : IFormGlassDashboard {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-dashboard.bml";
      const String TerminalAdapter = "form-terminal-canvas ANSI-24bit-v1";
      const String RichReference = "Rich render protocol, measurement, segments, layout, live refresh, tables, trees, and overflow are design references; no Python runtime is required";

      Object Scene( Int width, Int height, Int epoch, String focus, Object metrics, Object samples, Object publishers, String controlState ) [abstract] {}
   }
}
