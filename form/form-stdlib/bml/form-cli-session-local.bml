//////////////////////////////////////////////////////////////////////
//
// form-cli-session-local.bml — high-grammar authority.
//
// Session logs, counted without prompt text. Events already run
// native then local. Remote is the rented voice. Training fuel is
// Form shapes, mint, and the distillation corpus — never a chat
// transcript. 99% local sessions is the named target, not a claim.
//
// Executable: form-stdlib/form-cli-session-local.bml
// Proven by: form-stdlib/tests/form-cli-session-local-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.sessionlocal;

import Form.kernel.*;
import Form.cli.flow.*;
import Form.cli.oneturn.*;

enum SessionLane [public] {
   NATIVE,
   LOCAL,
   REMOTE
}

interface ISessionLocal [public, witness, reusable] {
   section [public] {
      const int TargetLocalPpm = 990000;
      const int OneTurn = 1;
      const String TrainRule = "shapes mint corpus overlay lora; never transcripts";

      int Leak( int nRemote, int nRequests ) [abstract];
      int EventLocalPpm( int nNative, int nLocal, int nRemote ) [abstract];
      int SessionLocal( int nRemotePresent, int nResolved ) [abstract];
   }
}

template SessionRow<TCount> [public, reusable] {
   section [public] {
      TCount Requests() [get];
      TCount RemoteTurns() [get];
      TCount Native() [get];
      TCount Local() [get];
   }
}

class FormSessionLocal [public, reusable, teach] : ISessionLocal {
   section [public] {
      const String TrustRule = "count logs without content; train from Form; 99 is target";
      const String ExecutablePath = "form/form-stdlib/form-cli-session-local.bml";

      int Leak( int nRemote, int nRequests ) [abstract] {}
      int EventLocalPpm( int nNative, int nLocal, int nRemote ) [abstract] {}
      int SessionLocal( int nRemotePresent, int nResolved ) [abstract] {}
   }
}

class FormSessionLocalSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-session-local-self";
      const String Pattern = "log-count no-transcript mint-corpus overlay-lora target-990000";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
