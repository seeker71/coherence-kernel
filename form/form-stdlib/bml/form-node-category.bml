package Form.node.category;

import Form.kernel.*;

interface IFormNodeCategory [public, witness, typed] {
   section [public] {
      const String Schema = "form-node-category-binding-v1";
      const String CoordinateRule = "cell and category retain their full package.level.type.instance coordinates; family is the category package.level.type prefix";
      const String RoleRule = "blueprint, recipe, cell, and value are explicit roles beside the coordinate; role is never inferred from coordinate bits";
      const String NUMSLineage = "NUMS.Go uses BlueprintNodeID_t and RecipeNodeID_t wrappers over the same NodeID_t p.l.t.i shape, so coordinate equality cannot establish semantic role";
      const String MembraneRule = "a flow publication carries cell identity, category identity, category family, explicit role, and stage type together";
      const String PackedRule = "transport profiles retain p4.l4.t8.i16 and p8.l8.t16.i32 with canonical base36 and explicit overflow; native identity storage is the single 64-bit word defined by native-node-word.bml";

      Object Bind( Object cellNode, String role, String stageType ) [abstract];
      Bool Valid( Object binding ) [abstract];
      Object Pack( Object node ) [abstract];
      Object Unpack( Object packed ) [abstract];
      Object PackedKey( Object packed ) [abstract];
   }
}

class FormNodeCategory [public, typed] : IFormNodeCategory {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-node-category.bml";
      Object Bind( Object cellNode, String role, String stageType ) [abstract] {}
      Bool Valid( Object binding ) [abstract] {}
      Object Pack( Object node ) [abstract] {}
      Object Unpack( Object packed ) [abstract] {}
      Object PackedKey( Object packed ) [abstract] {}
   }
}
