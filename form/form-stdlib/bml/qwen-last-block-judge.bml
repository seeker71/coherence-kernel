// qwen-last-block-judge.bml — the last block's trained adapter is judged against its parent on accepted rows it never saw.
//
// Intent: rung 4 of the last-block LoRA ladder (docs/qwen-last-block-lora-design.md, E.4). An adapter the rung-3 trainer exported
// (qwen-last-block-train.bml, qlbt-export: F32 safetensors blk.L.ffn_down.weight.lora_a [ff, r] and .lora_b [r, d] beside
// adapter_config.json) is read back into the pair's device record and scored by the loss it descended: the prompt-masked
// next-token cross-entropy through the frozen head (qlbt-eval: the block's forward from the captured block input, the pair,
// output_norm, output.weight, nlb_ce), the mean of the rows' token-mean losses as rung 3 read it, on accepted rows disjoint by draft
// id from the rows its config names, under the parent and under the child. The parent is the lane's adapter home. Absent, the lane
// wears no adapter and the parent reads as the base 27B: the pair at +0, so the block adds +-0 to its own output (rung 2, bit 1:
// 0 of 117,760 words differed from the model's). Present, it is read and loaded as the child is, at the child's rank, scale and
// layer (one device record carries either pair). Rejected rows are scored beside for information: a lower loss there is closeness
// to what we turned away and never enters `better`. A lift's shared rules are the 3B door's own, read in place from
// observe/lora-lift-run.bml (its entry runs only as the entry): ll-digest (sha256 of a side's draft ids joined by newlines),
// ll-better, ll-milli, ll-id, ll-reading-of, ll-doc, ll-shared, ll-negative-pairs.
// No device: the adapter directory's reading rules live in qwen-last-block-wear.bml, one definition this judge and the lane share
// (qlbj-present-why, qlbj-config / qlbj-config-why, qlbj-pair-why, qlbj-pair-bytes); here, qlbj-split-why / qlbj-reading-why (held-out and
// trained rows by line and draft id), qlbj-mean, qlbj-plan / qlbj-judged / qlbj-row (the promotion row). Device: qlbj-zero,
// qlbj-load, qlbj-means, qlbj-cached (a capture read, never prefilled).
// Inputs: adapter directories and readings rows; for the device part an open Qwen context and the rung-3 step record (qlbt-open).
// Effects: device writes into the record's A and B only. Stdin: none. Owner: form-stdlib/bml.
import form-stdlib/bml/qwen-last-block-train.bml;
import form-stdlib/bml/qwen-last-block-wear.bml;
import form-stdlib/lora-adapter.bml;
import observe/lora-lift-run.bml;
section [form.bml] {
 class QwenLastBlockJudge {
  // the lane's adapter home (the parent; the gap register reads rows whose parent is this path) and the trainer's staging export
  def qlbj-home() = "form/form-stdlib/adapters/qwen38-last-block";
  def qlbj-next() = "form/form-stdlib/adapters/qwen38-last-block-next";
  def qlbj-show(x) = nothing?(x) ? "unread" : x.str();
  // the lane's adapter home is absent when nothing stands at its path: the lane wears no adapter and the parent is the base
  def qlbj-home-absent?(dir) = (Comparable) host_path_is_dir(dir) != 1 && file_size(dir) < 0;
  // why a present parent home does not stand beside the child ("" when it does): read as the child is, at the child's rank, scale, layer
  def qlbj-parent-why(dir, c) = len(qlbj-present-why("parent", dir)) > 0 ? qlbj-present-why("parent", dir) : qlbj-parent-config-why(dir, qlbj-config(dir), c);
  def qlbj-parent-config-why(dir, p, c) {
   let w = qlbj-config-why("parent", dir, p);
   let at = "parent adapter config " ++ qlbj-cfg(dir);
   len(w) > 0 ? w
   : (Comparable) record_get(p, "rank") != record_get(c, "rank") ? at ++ ": rank " ++ record_get(p, "rank").str() ++ " beside the child's " ++ record_get(c, "rank").str() ++ "; one device record carries either pair"
   : !(record_get(p, "scale") == record_get(c, "scale")) ? at ++ ": scale " ++ record_get(p, "scale").str() ++ " beside the child's " ++ record_get(c, "scale").str()
   : (Comparable) qlbj-layer(p) != qlbj-layer(c) ? at ++ ": layer " ++ qlbj-layer(p).str() ++ " beside the child's " ++ qlbj-layer(c).str()
   : "";
  }
  // ── the rows by line: [[text, line], ...] for a file's non-empty lines (qlbt-lines counts every line) ──
  def qlbj-lines(path) = qlbt-lines(read_file(path) ?? "");
  def qlbj-last(xs, k) = len(xs) <= k ? xs : qlbj-last(xs[1:], k);
  def qlbj-at(lines, wanted) = filter(p => any?(w => (Comparable) w == p[1], wanted), lines);
  def qlbj-ids(ps) = map(p => ll-id(p[0]), ps);
  def qlbj-line-nums(ps) = map(p => p[1], ps);
  def qlbj-texts(ps) = map(p => p[0], ps);
  // why the split does not stand ("" when it does): the rows, the held-out count, the trained lines the config names, a draft id
  // on every selected row, no held-out draft among the trained ones, and held-out rows that read "accepted" with messages
  def qlbj-split-why(rowsPath, lines, k, valid, trainPath, wanted, train) {
   let shared = ll-shared(qlbj-ids(valid), qlbj-ids(train));
   file_size(rowsPath) < 0 ? "rows " ++ rowsPath ++ " is absent"
   : k <= 0 ? "valid_rows " ++ k.str() ++ " asks for no held-out row"
   : len(valid) < k ? "rows " ++ rowsPath ++ " holds " ++ len(lines).str() ++ " rows; valid_rows asks " ++ k.str()
   : file_size(trainPath) < 0 ? "the child's training rows " ++ trainPath ++ " are absent"
   : len(train) != len(wanted) ? "the child's config names lines " ++ qlbj-nums(wanted) ++ " of " ++ trainPath ++ "; " ++ len(train).str() ++ " of them are rows there"
   : any?(id => len(id) == 0, qlbj-ids(append(valid, train))) ? "a selected row has no draft id; the split is disjoint by draft id"
   : len(shared) > 0 ? "held-out draft " ++ shared[0] ++ " of " ++ rowsPath ++ " is among the rows the child trained on (" ++ trainPath ++ " lines " ++ qlbj-nums(wanted) ++ ")"
   : qlbj-reading-why(rowsPath, valid, "accepted", "the judge reads accepted held-out rows only");
  }
  // why a set of rows does not all read `want` with messages ("" when it does)
  def qlbj-reading-why(path, ps, want, rule) {
   let other = filter(p => !((String) ll-reading-of(p[0]) == want) || !json-object-has?(ll-doc(p[0]), "messages"), ps);
   nil?(other) ? "" : "line " ++ other[0][1].str() ++ " of " ++ path ++ " (draft " ++ ll-id(other[0][0]) ++ ") reads \"" ++ ll-reading-of(other[0][0]) ++ "\"" ++ (json-object-has?(ll-doc(other[0][0]), "messages") ? "" : " and carries no messages") ++ "; " ++ rule;
  }
  // a selected row in the trainer's shape (qlbt-row: ChatML through the tokfast index, prompt-masked, cut at the cap)
  def qlbj-row-of(src, x, p, cap) = qlbt-row(src, x, parse-json("readings-row", p[0]), p[1], cap);
  def qlbj-unsupervised(rows) = filter(row => qlbt-row-count(row) <= 0, rows);
  def qlbj-positions(rows) = foldl((acc, row) => acc + qlbt-row-n(row), 0, rows);
  def qlbj-supervised(rows) = foldl((acc, row) => acc + qlbt-row-count(row), 0, rows);
  // ── the device: the pair at +0 (the base), an adapter's pair loaded, every row's mean under the pair the record holds ──
  def qlbj-zero(o) = gpu-lease-turn("qwen judgement zero", () => {
   let rec = record_get(o, "rec");
   let za = nam-zero(rec[3], rec[6] * rec[7]);
   let zb = nam-zero(rec[4], rec[7] * rec[8]);
   nam-sync();
  });
  // an adapter's A and B into the record's pair: 1 when both landed whole, else 0
  def qlbj-load(o, dir, L) {
   let rec = record_get(o, "rec");
   let ab = qlbj-pair-bytes(dir, L);
   let wa = len(ab[0]) == rec[6] * rec[7] * 4 ? metal_buf_write(rec[3], 0, ab[0]) : 0;
   let wb = len(ab[1]) == rec[7] * rec[8] * 4 ? metal_buf_write(rec[4], 0, ab[1]) : 0;
   wa == rec[6] * rec[7] * 4 && wb == rec[7] * rec[8] * 4 ? 1 : 0;
  }
  // every prepared [row, xin]'s token-mean loss under the pair the record holds now (nothing for a row whose loss did not arrive)
  def qlbj-means(ps, geo, lay, onormTv, projTv, sx, o, prep) = map(p => qlbt-mean(qlbt-eval(ps, geo, lay, onormTv, projTv, sx, o, p[0], p[1]), qlbt-row-count(p[0])), prep);
  // the mean of the rows' token means (rung 3's mean); unknown when any row's did not arrive
  def qlbj-mean(xs) = nil?(xs) ? nothing() : any?(x => nothing?(x), xs) ? nothing() : sum(xs) / (len(xs) + 0.0);
  // a capture read from a directory another step owns: its bytes when the sidecar names the row's ids, else "" (never prefilled)
  def qlbj-cached(dir, row, d) {
   let raw = read_file(qlbt-capture-path(dir, row)) ?? "";
   let side = read_file(qlbt-sidecar-path(dir, row)) ?? "";
   len(raw) == qlbt-row-n(row) * d * 4 && qlbt-sidecar-matches?(side, row[1]) == 1 ? raw : "";
  }
  // ── the promotion row ──
  // plan: what was judged (identity, split, sides); judged: what the passes read
  def qlbj-plan(parent, parentReads, child, sha, bytes, model, L, r, cap, steps, batch, trainPath, train, rowsPath, valid, negPath, negs) = record_new(0, "parent", parent, "parent_reads", parentReads, "child", child, "child_sha256", sha, "child_bytes", bytes, "model", model, "layer", L, "rank", r, "cap", cap, "steps", steps, "batch", batch, "train_source", trainPath, "train", train, "valid_source", rowsPath, "valid", valid, "neg_source", negPath, "negs", negs);
  // validRows / negRows: qlbt rows; parentMeans / childMeans: per held-out row; negJudged: the judged rejected [text, line]s; negParent /
  // negChild: their means; excluded: [line, why] for each rejected row set aside; inRows / inParent / inChild: the in-sample witness
  // (0 rows when it was not read); neg_held: nothing until the lift reads apart the rejected rows the gradient never saw
  def qlbj-judged(validRows, parentMeans, childMeans, negJudged, negRows, negParent, negChild, excluded, inRows, inParent, inChild, need, wall) = record_new(0, "valid_rows", validRows, "parent", parentMeans, "child", childMeans, "neg_judged", negJudged, "neg_rows", negRows, "neg_parent", negParent, "neg_child", negChild, "excluded", excluded, "in_rows", inRows, "in_parent", inParent, "in_child", inChild, "need", need, "wall", wall, "neg_held", nothing());
  def qlbj-maybe(key, v) = nothing?(v) ? json-node-pair(key, json-node-null()) : fhn-n(key, v);
  def qlbj-millis(key, xs) = fhn-a(key, map(x => json-node-int(ll-milli(x)), xs));
  def qlbj-excluded-node(e) = json-node-object([fhn-n("line", e[0]), fhn-s("why", e[1])]);
  // the rejected side: the 3B lift's fields (ll-negative-pairs) over the judged rows, then the total and every row set aside, by line
  def qlbj-negative-pairs(plan, j) {
   let negPath = record_get(plan, "neg_source");
   let judged = record_get(j, "neg_judged");
   let rest = [fhn-n("rejected_rows_total", len(record_get(plan, "negs"))), fhn-a("rejected_excluded", map(e => qlbj-excluded-node(e), record_get(j, "excluded")))];
   len(negPath) == 0 ? [] : nil?(judged) ? append([fhn-s("rejected_source", negPath), fhn-n("rejected_rows", 0)], rest)
   : append(ll-negative-pairs(negPath, qlbj-texts(judged), qlbj-positions(record_get(j, "neg_rows")), record_get(j, "neg_parent"), record_get(j, "neg_child")), append([fhn-n("rejected_supervised_tokens", qlbj-supervised(record_get(j, "neg_rows")))], rest));
  }
  def qlbj-in-sample-pairs(j) = record_get(j, "in_rows") <= 0 ? [] : [fhn-n("in_sample_rows", record_get(j, "in_rows")), fhn-n("in_sample_parent_loss_milli", ll-milli(record_get(j, "in_parent"))), fhn-n("in_sample_child_loss_milli", ll-milli(record_get(j, "in_child"))), fhn-n("in_sample_reproduced", 1)];
  // the losses in nano beside their milli: a lift's fall of a hundredth of a nat is the whole reading, and the preference margin subtracts two of them (a float node prints six digits)
  def qlbj-loss(key, x) = nothing?(x) ? json-node-pair(key ++ "_nano", json-node-null()) : fhn-n(key ++ "_nano", float_to_int(x * 1000000000.0));
  def qlbj-precise-pairs(j) = [qlbj-loss("parent_loss", qlbj-parent-mean(j)), qlbj-loss("child_loss", qlbj-child-mean(j)), qlbj-loss("rejected_parent_loss", record_get(j, "neg_parent")), qlbj-loss("rejected_child_loss", record_get(j, "neg_child"))];
  // the rejected rows the gradient never saw, when the lift read them apart (the door sets neg_held: [rows, parent mean, child mean])
  def qlbj-held-pairs(j) = nothing?(record_get(j, "neg_held")) ? [] : [fhn-n("rejected_heldout_rows", record_get(j, "neg_held")[0]), qlbj-loss("rejected_heldout_parent_loss", record_get(j, "neg_held")[1]), qlbj-loss("rejected_heldout_child_loss", record_get(j, "neg_held")[2])];
  def qlbj-parent-mean(j) = qlbj-mean(record_get(j, "parent"));
  def qlbj-child-mean(j) = qlbj-mean(record_get(j, "child"));
  // promotion needs the mean to fall AND no held-out row to rise (docs/native-session-learning.md: "no per-row regression"): a child
  // that is better on average by being much better on two rows and a little worse on three is not better for the rows it
  // would serve. Rows compare positionally (both sides read the same held-out rows in the same order); a loss equal to its
  // parent's is no regression. The count stands in the row beside the milli lists it is read from.
  def qlbj-worse(parent, child) = nil?(parent) || nil?(child) ? 0 : (child[0] > parent[0] ? 1 : 0) + qlbj-worse(parent[1:], child[1:]);
  def qlbj-better(j, pm, cm) = ll-better(pm, cm) == 1 && qlbj-worse(record_get(j, "parent"), record_get(j, "child")) == 0 ? 1 : 0;
  // the row the gap register reads (where parent, field better): `better` reads the accepted held-out alone (ll-better), row by row
  def qlbj-row(plan, j) {
   let pm = qlbj-parent-mean(j);
   let cm = qlbj-child-mean(j);
   let valid = record_get(plan, "valid");
   let vrows = record_get(j, "valid_rows");
   json-node-object(append([fhn-n("at_unix_ms", now_unix_ms()), fhn-s("parent", record_get(plan, "parent")), fhn-s("parent_reads", record_get(plan, "parent_reads")), fhn-s("child", record_get(plan, "child")), fhn-s("child_sha256", record_get(plan, "child_sha256")), fhn-n("child_bytes", record_get(plan, "child_bytes")), fhn-s("model", record_get(plan, "model")), fhn-n("layer", record_get(plan, "layer")), fhn-s("slot", qlbj-slot()), fhn-n("rank", record_get(plan, "rank")), fhn-n("ids_cap", record_get(plan, "cap")), fhn-s("train_source", record_get(plan, "train_source")), fhn-s("valid_source", record_get(plan, "valid_source")), fhn-s("valid_reading", ll-reading-of(valid[0][0])), fhn-s("judged_on", "accepted held-out, disjoint from train by draft id"), fhn-n("train_rows", len(record_get(plan, "train"))), fhn-n("valid_rows", len(valid)), fhn-s("train_ids_sha256", ll-digest(qlbj-texts(record_get(plan, "train")))), fhn-s("valid_ids_sha256", ll-digest(qlbj-texts(valid))), fhn-a("valid_lines", map(n => json-node-int(n), qlbj-line-nums(valid))), fhn-n("valid_tokens", qlbj-positions(vrows)), fhn-n("valid_supervised_tokens", qlbj-supervised(vrows)), qlbj-maybe("steps", record_get(plan, "steps")), qlbj-maybe("batch", record_get(plan, "batch")), fhn-n("parent_loss_milli", ll-milli(pm)), fhn-n("child_loss_milli", ll-milli(cm)), fhn-n("parent_score_milli", 0 - ll-milli(pm)), fhn-n("child_score_milli", 0 - ll-milli(cm)), fhn-n("better", qlbj-better(j, pm, cm)), qlbj-millis("valid_parent_milli", record_get(j, "parent")), qlbj-millis("valid_child_milli", record_get(j, "child")), fhn-n("valid_rows_worse", qlbj-worse(record_get(j, "parent"), record_get(j, "child")))],
    append(qlbj-negative-pairs(plan, j), append(qlbj-precise-pairs(j), append(qlbj-held-pairs(j), append(qlbj-in-sample-pairs(j), [fhn-n("memory_need_bytes", record_get(j, "need")), fhn-n("rent_tokens", 0), fhn-n("wall_ms", record_get(j, "wall"))]))))));
  }
 }
 0;
}
