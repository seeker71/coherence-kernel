// Typed transcript projection carried in the existing native ear metric frame.
// The identifier codec is shared by producer/observer; no human line is parsed.
// preludes: form/form-stdlib/form-glass-observer.bml form/form-stdlib/bml/transcript-languages.bml
section [form.bml] {
    class EarTranscript {
        field ETRPrefix = "ear.transcript.";
        def etr-id(kind, code) = str_concat(ETRPrefix(), str_concat(kind, str_concat(".", code)));
        def etr-row?(row) = if (!((String) fgo-domain(row) == "ear")) then 0 else if (!((Comparable) str_find(fgo-id(row), ETRPrefix(), 0) == 0)) then 0 else if (!((String) fgo-value-kind(row) == "text")) then 0 else ((str_find(fgo-id(row), ".", str_len(ETRPrefix())) > str_len(ETRPrefix())) && ((str_find(fgo-id(row), ".", str_len(ETRPrefix())) + 1) < str_len(fgo-id(row))));
        def etr-kind(row) = substring(fgo-id(row), str_len(ETRPrefix()), str_find(fgo-id(row), ".", str_len(ETRPrefix())));
        def etr-code(row) = substring(fgo-id(row), (str_find(fgo-id(row), ".", str_len(ETRPrefix())) + 1), str_len(fgo-id(row)));
        def etr-row(kind, code, text, epoch, lifecycle, note) = fgo-observe-row(fgo-text("ear", etr-id(kind, if ((Comparable) str_len(code) == 0) then "und" else code), str_concat(kind, str_concat(" @", int_to_str(epoch))), text, "form", "physical-live", "ear-organ", lifecycle, "transcript", note), epoch, 0);
        // Retain one latest value per typed identity, never a transcript history.
        // An absent partial is not an instruction to erase it. A repeated growing
        // heartbeat is not new speech; a real correction is allowed to replace it.
        def etr-role(row) = substring(etr-kind(row), 0, str_find(etr-kind(row), "-", 0));
        def etr-same-slot?(a, b) = (((String) etr-role(a) == etr-role(b)) && (((String) etr-role(a) == "original") || ((String) etr-code(a) == etr-code(b))));
        def etr-flow-pick(held, fresh) = if (fgo-observed-epoch(fresh) < fgo-observed-epoch(held)) then held else if (((String) etr-code(held) == etr-code(fresh)) && (((String) etr-kind(held) == etr-kind(fresh)) && (((String) fgo-lifecycle(fresh) == "source") && ((String) fgo-text-value(held) == fgo-text-value(fresh))))) then held else fresh;
        def etr-flow-put(rows, fresh) = if ((Comparable) len(rows) == 0) then [fresh] else if etr-same-slot?(head(rows), fresh) then cons(etr-flow-pick(head(rows), fresh), tail(rows)) else cons(head(rows), etr-flow-put(tail(rows), fresh));
        def etr-flow(held, fresh) = if ((Comparable) len(fresh) == 0) then held else etr-flow(etr-flow-put(held, head(fresh)), tail(fresh));
        def etr-latest(rows) = if ((Comparable) len(rows) == 1) then head(rows) else etr-later(head(rows), etr-latest(tail(rows)));
        def etr-later(a, b) = if (fgo-observed-epoch(a) > fgo-observed-epoch(b)) then a else b;
    }
    0;
}
