// Typed transcript projection carried in the existing native ear metric frame.
// The identifier codec is shared by producer/observer; no human line is parsed.
import form/form-stdlib/form-glass-observer.bml;
import form/form-stdlib/bml/transcript-languages.bml;
section [form.bml] {
    class EarTranscript {
        field ETRPrefix = "ear.transcript.";
        def etr-id(kind, code) = (ETRPrefix() + (kind + ("." + code)));
        def etr-row?(row) = if (!((String) fgo-domain(row) == "ear")) then 0 else if (!((Comparable) str_find(fgo-id(row), ETRPrefix(), 0) == 0)) then 0 else if (!((String) fgo-value-kind(row) == "text")) then 0 else ((str_find(fgo-id(row), ".", len(ETRPrefix())) > len(ETRPrefix())) && ((str_find(fgo-id(row), ".", len(ETRPrefix())) + 1) < len(fgo-id(row))));
        def etr-kind(row) = substring(fgo-id(row), len(ETRPrefix()), str_find(fgo-id(row), ".", len(ETRPrefix())));
        def etr-code(row) = substring(fgo-id(row), (str_find(fgo-id(row), ".", len(ETRPrefix())) + 1), len(fgo-id(row)));
        // A row's doubt rides in its integer slot: a bitmask the producer reads off the ear's own
        // frame and the glass names in words, so no human line is parsed for it. The label is the
        // stage word and what the stage cost; the source clock is the row's own epoch, never text.
        // `standing` is how many leading bytes of a growing line two passes have agreed on (its
        // capacity slot); the bytes after it are tentative. Below zero, the whole text stands.
        def etr-row(kind, code, text, epoch, lifecycle, note, doubt, took, standing) = fgo-observe-row(fgo-metric("ear", etr-id(kind, if ((Comparable) len(code) == 0) then "und" else code), etr-label(kind, took), "text", etr-withheld-bits(doubt), text, 1, "", if (standing >= 0) then standing else 0, if (standing >= 0) then 1 else 0, 0, 0, "form", "physical-live", "ear-organ", lifecycle, "transcript", note), epoch, 0);
        def etr-standing(row) = if ((Comparable) fgo-capacity-present?(row) == 1) then fgo-capacity(row) else len(fgo-text-value(row));
        def etr-stage-word(kind) = if ((String) kind == "original-growing") then "hearing" else if ((String) kind == "original-closed") then "heard" else if ((String) kind == "translation-growing") then "translating" else if ((String) kind == "translation-closed") then "translated" else kind;
        def etr-label(kind, took) = if (took > 0) then (etr-stage-word(kind) + (" " + (took.str() + " ms"))) else etr-stage-word(kind);
        // 1 the line repeats itself; 2 heard in a tongue the house did not offer; 4 the translation
        // is the line itself, untranslated; 8 the same text stands in every other tongue; 16 the
        // line this translates is itself in doubt; 32 heard while the room kept naming its own sound;
        // 64 the line carries the room's own tag. Measured on the room's spool 2026-11-06: of 2389
        // closed translations 160 carried one text in pt, fa and id, and 82 copied the line; of
        // 2366 heard lines 741 came while the room named its sound six times in ten seconds.
        def etr-doubt(row) = fgo-int-value(row);
        // 128 a growing line the ear stopped growing and never closed (ea-transcript-let-go).
        // 256 withheld: two of the doubts that ask whether anyone said it at all (2, 16, 32, 64,
        // 128) stand on one row, so the view shows the doubt and not the words.
        def etr-doubt-names() = [[1, "repeats itself"], [2, "tongue not offered"], [4, "untranslated copy of the line"], [8, "same text in every tongue"], [16, "its line is in doubt"], [32, "heard over the room's named sound"], [64, "carries the room's own tag"], [128, "the ear let it go unclosed"], [256, "withheld"]];
        def etr-said-doubts(bits) = foldl((n, b) => if etr-bit?(bits, b) then (n + 1) else n, 0, [2, 16, 32, 64, 128]);
        def etr-withheld-bits(bits) = if (etr-said-doubts(bits) >= 2) then (if etr-bit?(bits, 256) then bits else (bits + 256)) else (if etr-bit?(bits, 256) then (bits - 256) else bits);
        def etr-withheld?(row) = etr-bit?(etr-doubt(row), 256);
        def etr-doubt-set(row, bit, on) = if ((Comparable) etr-bit?(etr-doubt(row), bit) == (if on then 1 else 0)) then row else append(take(5, row), cons(etr-withheld-bits(if on then (etr-doubt(row) + bit) else (etr-doubt(row) - bit)), row[6:]));
        // The room's own sound is one typed row: how many phantom frames (a pass that heard only
        // [MUSIC], (water running), [Birds]) stand in the span before now, in its integer slot, and
        // the newest tag they named as its text. A line heard with the floor or more of them in the
        // span before it is heard over the room's sound.
        def etr-room-id() = "ear.room.named";
        def etr-room-span() = 10000;
        def etr-room-floor() = 6;
        def etr-bit?(bits, bit) = ((bits / bit) - (2 * (bits / (2 * bit)))) == 1;
        def etr-doubt-words(bits) = etr-doubt-words-of(bits, etr-doubt-names(), "");
        def etr-doubt-words-of(bits, names, said) = if ((Comparable) len(names) == 0) then said else etr-doubt-words-of(bits, names[1:], if etr-bit?(bits, names[0][0]) then (if ((Comparable) len(said) == 0) then names[0][1] else (said + (", " + names[0][1]))) else said);
        // Retain one latest value per typed identity, never a transcript history.
        // An absent partial is not an instruction to erase it. A repeated growing
        // heartbeat is not new speech; a real correction is allowed to replace it.
        def etr-role(row) = substring(etr-kind(row), 0, str_find(etr-kind(row), "-", 0));
        def etr-same-slot?(a, b) = (((String) etr-role(a) == etr-role(b)) && (((String) etr-role(a) == "original") || ((String) etr-code(a) == etr-code(b))));
        // The same closed line seen again keeps the doubt it was first read with: the room around it
        // moves on, the line does not.
        def etr-flow-pick(held, fresh) = if (fgo-observed-epoch(fresh) < fgo-observed-epoch(held)) then held else if (((String) etr-code(held) == etr-code(fresh)) && (((String) etr-kind(held) == etr-kind(fresh)) && ((((String) fgo-lifecycle(fresh) == "source") || (fgo-observed-epoch(fresh) == fgo-observed-epoch(held))) && ((String) fgo-text-value(held) == fgo-text-value(fresh))))) then held else fresh;
        def etr-flow-put(rows, fresh) = if ((Comparable) len(rows) == 0) then [fresh] else if etr-same-slot?(rows[0], fresh) then cons(etr-flow-pick(rows[0], fresh), rows[1:]) else cons(rows[0], etr-flow-put(rows[1:], fresh));
        def etr-flow(held, fresh) = if ((Comparable) len(fresh) == 0) then held else etr-flow(etr-flow-put(held, fresh[0]), fresh[1:]);
        def etr-latest(rows) = if ((Comparable) len(rows) == 1) then rows[0] else etr-later(rows[0], etr-latest(rows[1:]));
        def etr-later(a, b) = if (fgo-observed-epoch(a) > fgo-observed-epoch(b)) then a else b;
    }
    0;
}
