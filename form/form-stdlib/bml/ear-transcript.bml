// Typed transcript projection carried in the existing native ear metric frame.
// The identifier codec is shared by producer/observer; no human line is parsed.
// preludes: form/form-stdlib/form-glass-observer.bml form/form-stdlib/bml/transcript-languages.bml
section [form.bml] {
    class EarTranscript {
        field ETRPrefix = "ear.transcript.";
        def etr-id(kind, code) = str_concat(ETRPrefix(), str_concat(kind, str_concat(".", code)));
        def etr-row?(row) = if not(str_eq(fgo-domain(row), "ear")) then 0 else if not(eq(str_find(fgo-id(row), ETRPrefix(), 0), 0)) then 0 else if not(str_eq(fgo-value-kind(row), "text")) then 0 else and(gt(str_find(fgo-id(row), ".", str_len(ETRPrefix())), str_len(ETRPrefix())), lt(add(str_find(fgo-id(row), ".", str_len(ETRPrefix())), 1), str_len(fgo-id(row))));
        def etr-kind(row) = substring(fgo-id(row), str_len(ETRPrefix()), str_find(fgo-id(row), ".", str_len(ETRPrefix())));
        def etr-code(row) = substring(fgo-id(row), add(str_find(fgo-id(row), ".", str_len(ETRPrefix())), 1), str_len(fgo-id(row)));
        def etr-row(kind, code, text, epoch, lifecycle, note) = fgo-text("ear", etr-id(kind, if eq(str_len(code), 0) then "und" else code), str_concat(kind, str_concat(" @", int_to_str(epoch))), text, "form", "physical-live", "ear-organ", lifecycle, "transcript", note);
    }
    0;
}
