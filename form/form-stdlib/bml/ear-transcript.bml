// Typed transcript projection carried in the existing native ear metric frame.
// The identifier codec is shared by producer/observer; no human line is parsed.
// preludes: form/form-stdlib/form-glass-observer.bml form/form-stdlib/bml/transcript-languages.bml
section [form.bml] {
    class EarTranscript {
        field ETRPrefix = "ear.transcript.";
        def etr-id(kind, code) = str_concat(ETRPrefix(), str_concat(kind, str_concat(".", code)));
        def etr-row?(row) = if not(str_eq(fgo-domain(row), "ear")) then 0 else if not(eq(str_find(fgo-id(row), ETRPrefix(), 0), 0)) then 0 else if not(str_eq(fgo-value-kind(row), "text")) then 0 else and(gt(str_find(fgo-id(row), ".", str_len(ETRPrefix())), str_len(ETRPrefix())), lt(add(str_find(fgo-id(row), ".", str_len(ETRPrefix())), 1), str_len(fgo-id(row))));
        def etr-kind(row) = substring(fgo-id(row), str_len(ETRPrefix()), str_find(fgo-id(row), ".", str_len(ETRPrefix())));
        def etr-code(row) = substring(fgo-id(row), add(str_find(fgo-id(row), ".", str_len(ETRPrefix())), 1), str_len(fgo-id(row)));
        def etr-row(kind, code, text, epoch, lifecycle, note) = fgo-observe-row(fgo-text("ear", etr-id(kind, if eq(str_len(code), 0) then "und" else code), str_concat(kind, str_concat(" @", int_to_str(epoch))), text, "form", "physical-live", "ear-organ", lifecycle, "transcript", note), epoch, 0);
        // Retain one latest value per typed identity, never a transcript history.
        // An absent partial is not an instruction to erase it. A repeated growing
        // heartbeat is not new speech; a real correction is allowed to replace it.
        def etr-role(row) = substring(etr-kind(row), 0, str_find(etr-kind(row), "-", 0));
        def etr-same-slot?(a, b) = and(str_eq(etr-code(a), etr-code(b)), str_eq(etr-role(a), etr-role(b)));
        def etr-flow-pick(held, fresh) = if lt(fgo-observed-epoch(fresh), fgo-observed-epoch(held)) then held else if and(str_eq(etr-kind(held), etr-kind(fresh)), and(str_eq(fgo-lifecycle(fresh), "source"), str_eq(fgo-text-value(held), fgo-text-value(fresh)))) then held else fresh;
        def etr-flow-put(rows, fresh) = if eq(len(rows), 0) then list(fresh) else if etr-same-slot?(head(rows), fresh) then cons(etr-flow-pick(head(rows), fresh), tail(rows)) else cons(head(rows), etr-flow-put(tail(rows), fresh));
        def etr-flow(held, fresh) = if eq(len(fresh), 0) then held else etr-flow(etr-flow-put(held, head(fresh)), tail(fresh));
        def etr-latest(rows) = if eq(len(rows), 1) then head(rows) else etr-later(head(rows), etr-latest(tail(rows)));
        def etr-later(a, b) = if gt(fgo-observed-epoch(a), fgo-observed-epoch(b)) then a else b;
    }
    0;
}
