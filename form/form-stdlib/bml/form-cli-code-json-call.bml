// form-cli-code-json-call.bml — a retained JSON tool reply, read beside the live lane.
//
// The live reply steps a node (fcsw-step). This unit is the reader for a reply that still
// arrives as JSON text: a name with a namespace or another case, arguments given as an
// alias object, and the lenient pass over a small model's fences and trailing commas.
// Bands and the census import it. The live lane does not, so the reader is not in that closure.
// A repair grants no authority. Role, writable paths and guards still decide.
import form-stdlib/bml/form-cli-code-swerve.bml;
import form-stdlib/bml/form-agent-tool-wire.bml;
import form-stdlib/bml/form-agent-tools.bml;
import form-stdlib/bml/form-agent-json-query.bml;
section [form.bml] {
 class FormCliCodeJsonCall {
  def fcctg-shown-cap() = 160;
  def fcctg-lower(s) = str-join(fcctg-lower-go(s, 0, len(s), []));
  def fcctg-lower-go(s, i, n, out) = i >= n ? reverse(out) : fcctg-lower-go(s, i + 1, n, cons(byte_to_str(fcctg-lower-byte(str_byte_at(s, i))), out));
  def fcctg-lower-byte(b) = b >= 65 && b <= 90 ? b + 32 : b;
  def fcctg-sep?(b) = b == 46 || b == 47 || b == 58;
  def fcctg-last-sep(s, i, at) = i >= len(s) ? at : fcctg-last-sep(s, i + 1, fcctg-sep?(str_byte_at(s, i)) ? i : at);
  def fcctg-key(name) {
   let t = fat-trim(name);
   fcctg-lower(substring(t, fcctg-last-sep(t, 0, 0 - 1) + 1, len(t)));
  }
  def fcctg-name(name, names) = fat-has(names, name) ? ["exact", name, [name]] : fcctg-name-of(filter(n => fcctg-key(n) == fcctg-key(name), names));
  def fcctg-name-of(found) = len(found) == 1 ? ["repaired", found[0], found] : len(found) > 1 ? ["ambiguous", "", found] : ["unknown", "", []];
  def fcctg-path-keys() = ["path", "file_path", "filePath", "file", "filename"];
  def fcctg-shape(tool) = tool == "edit" ? [["path", fcctg-path-keys(), 1], ["old", ["old", "old_string", "oldText", "old_text", "old_str"], 1], ["new", ["new", "new_string", "newText", "new_text", "new_str"], 1]]
   : tool == "read" || tool == "cat" ? [["path", fcctg-path-keys(), 1]]
   : tool == "write" ? [["path", fcctg-path-keys(), 1], ["text", ["text", "content", "contents"], 0]]
   : [];
  def fcctg-shown(text) = len(text) <= fcctg-shown-cap() ? text : substring(text, 0, fcctg-shown-cap()) ++ "...(" ++ len(text).str() ++ " bytes)";
  def fcctg-scalar?(node) = fat-wire-string?(node) || faj-type(node) == "number" || faj-type(node) == "boolean";
  def fcctg-scalar(node) = fat-wire-string?(node) ? node_value(node) : json-emit(node);
  def fcctg-args(tool, node) = fat-wire-array?(node) ? fcctg-array(node_children(node), 0, [], [], [])
   : fat-wire-object?(node) && !nil?(fcctg-shape(tool)) ? fcctg-object(fcctg-shape(tool), json-object-pairs(node))
   : ["refused", [], [["arguments", fcctg-shown(json-emit(node)), "must be an array of strings"]], []];
  def fcctg-array(items, i, out, failures, fields) = nil?(items) ? (nil?(failures) ? [nil?(fields) ? "exact" : "repaired", reverse(out), [], reverse(fields)] : ["refused", [], reverse(failures), []])
   : fat-wire-string?(items[0]) ? fcctg-array(items[1:], i + 1, cons(node_value(items[0]), out), failures, fields)
   : fcctg-scalar?(items[0]) ? fcctg-array(items[1:], i + 1, cons(fcctg-scalar(items[0]), out), failures, cons("arguments[" ++ i.str() ++ "]", fields))
   : fcctg-array(items[1:], i + 1, out, cons(["arguments[" ++ i.str() ++ "]", fcctg-shown(json-emit(items[0])), "must be a string"], failures), fields);
  def fcctg-known(shape) = foldl((acc, slot) => append(acc, slot[1]), [], shape);
  def fcctg-object(shape, pairs) {
   let unknown = filter(p => !fat-has(fcctg-known(shape), json-pair-key(p)), pairs) |> map(p => [json-pair-key(p), fcctg-shown(json-emit(json-pair-value(p))), "is not an argument of this tool"]);
   let slots = shape |> map(slot => fcctg-slot(slot, filter(p => fat-has(slot[1], json-pair-key(p)), pairs)));
   let failures = append(unknown, foldl((acc, r) => nothing?(r[1]) ? acc : append(acc, [r[1]]), [], slots));
   nil?(failures) ? ["repaired", foldl((acc, r) => nothing?(r[0]) ? acc : append(acc, [r[0]]), [], slots), [], pairs |> map(p => json-pair-key(p))] : ["refused", [], failures, []];
  }
  def fcctg-slot(slot, given) = len(given) > 1 ? [nothing(), [slot[0], fcctg-shown(json-emit(json-node-object(given))), "is given more than once"]]
   : nil?(given) ? [nothing(), slot[2] == 1 ? [slot[0], "absent", "is required"] : nothing()]
   : fcctg-scalar?(json-pair-value(given[0])) ? [fcctg-scalar(json-pair-value(given[0])), nothing()]
   : [nothing(), [json-pair-key(given[0]), fcctg-shown(json-emit(json-pair-value(given[0]))), "must be a string"]];
  def fcctg-failure-text(f) = f[0] ++ "=" ++ f[1] ++ " (" ++ f[2] ++ ")";
  def fcctg-arguments-note(tool, failures) = "Tool arguments must be an array of strings. Received: " ++ str-join-with(failures |> map(fcctg-failure-text), "; ") ++ ". "
   ++ (tool == "edit" ? fat-edit-guidance() : tool == "write" ? "write arguments are [path] with the new text as input, or [path,text]." : "read and cat take [path].");
  def fcctg-row(method, before, after, from, to, fields) = json-emit(json-node-object([json-node-pair("method", json-node-string(method)),
   json-node-pair("before_sha256", json-node-string(fcctg-sha(before))), json-node-pair("after_sha256", json-node-string(fcctg-sha(after))),
   json-node-pair("tool_before", json-node-string(from)), json-node-pair("tool_after", json-node-string(to)), json-node-pair("fields", json-node-array(fcctg-strings(fields))),
   json-node-pair("scope", json-node-string("call shape only; role, writable paths, guards and caller checks decide as before"))]));
  def fcctg-repair(raw, names) = faj-valid(raw) ? fcctg-repair-obj(raw, names, parse-json("turn-guard-call", raw)) : fcctg-read(raw, names);
  def fcctg-read(raw, names) {
   let read = fcctg-tolerate(raw);
   nil?(read[1]) ? [raw, [], ""] : fcctg-read-rows(raw, read, fcctg-repair-obj(read[0], names, parse-json("turn-guard-call", read[0])));
  }
  def fcctg-read-rows(raw, read, one) = [one[0], cons(fcctg-row("native-reply-read", raw, read[0], "", "", read[1]), one[1]), one[2]];
  def fcctg-has(s, mark) = str_find(s, mark, 0) >= 0;
  def fcctg-after(s, mark) = substring(s, str_find(s, mark, 0) + len(mark), len(s));
  def fcctg-before(s, mark) = fcctg-has(s, mark) ? substring(s, 0, str_find(s, mark, 0)) : s;
  def fcctg-unthink(s) = fcctg-has(s, "</think>") ? fcctg-after(s, "</think>") : s;
  def fcctg-untag(s) = fcctg-has(s, "<tool_call>") ? fcctg-before(fcctg-after(s, "<tool_call>"), "</tool_call>") : s;
  def fcctg-fence-body(t) = (fcctg-has(t, "\n") && str_find(t, "\n", 0) < 12 && !fat-starts(fat-trim(t), "{")) ? fcctg-after(t, "\n") : t;
  def fcctg-unfence(s) = fcctg-has(s, "```") ? fcctg-before(fcctg-fence-body(fcctg-after(s, "```")), "```") : s;
  def fcctg-last-brace(s, i) = i < 0 ? 0 - 1 : str_byte_at(s, i) == 125 ? i : fcctg-last-brace(s, i - 1);
  def fcctg-braces(s) = (fcctg-has(s, "{") && fcctg-last-brace(s, len(s) - 1) > str_find(s, "{", 0)) ? substring(s, str_find(s, "{", 0), fcctg-last-brace(s, len(s) - 1) + 1) : s;
  def fcctg-stage(acc, name, f) = (String) f(acc[0]) == acc[0] ? acc : [fat-trim(f(acc[0])), append(acc[1], [name])];
  def fcctg-tolerate(raw) {
   let a = fcctg-stage(fcctg-stage(fcctg-stage(fcctg-stage([raw, []], "think-block", fcctg-unthink), "tool-call-tag", fcctg-untag), "code-fence", fcctg-unfence), "prose-around", fcctg-braces);
   let l = faj-valid(a[0]) ? a : fcctg-stage(a, "lenient-json", fcctg-lenient);
   faj-valid(l[0]) ? l : [raw, []];
  }
  def fcctg-lenient(s) = len(s) > 32768 ? s : str-join(fcctg-len-go(s, 0, len(s), [], 0, 0));
  def fcctg-closes?(s, i, n) = i >= n ? false : str_byte_at(s, i) <= 32 ? fcctg-closes?(s, i + 1, n) : (str_byte_at(s, i) == 125 || str_byte_at(s, i) == 93);
  def fcctg-colon?(s, i, n) = i >= n ? false : str_byte_at(s, i) <= 32 ? fcctg-colon?(s, i + 1, n) : str_byte_at(s, i) == 58;
  def fcctg-word-byte?(b) = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
  def fcctg-word-end(s, i, n) = (i < n && (fcctg-word-byte?(str_byte_at(s, i)) || (str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57))) ? fcctg-word-end(s, i + 1, n) : i;
  def fcctg-len-go(s, i, n, out, q, p) = i >= n ? reverse(out) : fcctg-len-at(s, i, n, out, q, p, str_byte_at(s, i), substring(s, i, i + 1));
  def fcctg-len-at(s, i, n, out, q, p, b, c) {
   if q == 1 then (b == 92 && i + 1 < n ? fcctg-len-go(s, i + 2, n, cons(substring(s, i, i + 2), out), 1, p) : fcctg-len-go(s, i + 1, n, cons(c, out), b == 34 ? 0 : 1, p))
   else if q == 2 then (b == 92 && i + 1 < n && str_byte_at(s, i + 1) == 39 ? fcctg-len-go(s, i + 2, n, cons("'", out), 2, p) : b == 39 ? fcctg-len-go(s, i + 1, n, cons("\"", out), 0, 34) : fcctg-len-go(s, i + 1, n, cons(b == 34 ? "\\\"" : c, out), 2, p))
   else if b == 34 then fcctg-len-go(s, i + 1, n, cons(c, out), 1, 34)
   else if b == 39 then fcctg-len-go(s, i + 1, n, cons("\"", out), 2, 34)
   else if b == 44 && fcctg-closes?(s, i + 1, n) then fcctg-len-go(s, i + 1, n, out, 0, p)
   else if fcctg-word-byte?(b) then fcctg-len-word(s, i, n, out, p, fcctg-word-end(s, i, n))
   else fcctg-len-go(s, i + 1, n, cons(c, out), 0, b <= 32 ? p : b);
  }
  def fcctg-len-word(s, i, n, out, p, e) = fcctg-len-go(s, e, n, cons((p == 123 || p == 44) && fcctg-colon?(s, e, n) ? ("\"" ++ substring(s, i, e) ++ "\"") : substring(s, i, e), out), 0, 97);
  def fcctg-echo-note() = "Typed repair request [echo]: the reply repeated the observation it was given (role, mode, instruction, observation), which is input and no action. Reply with one action for the current role: a native tool call {\"tool\":...,\"arguments\":[...]} or this role's own fields.";
  def fcctg-noop?(tool, strs) = tool == "edit" && ((len(strs) == 3 && (String) strs[1] == strs[2]) || (len(strs) == 4 && (String) strs[2] == strs[3]));
  def fcctg-noop-note() = "Typed repair request [no-op]: the edit replaces a span with the same text, so it changes no document. Name the span that must change and the text that replaces it.";
  def fcctg-repair-obj(raw, names, obj) = fcctg-echo?(raw) ? [raw, [], fcctg-echo-note()] : !(fat-wire-object?(obj) && json-object-has?(obj, "tool") && fat-wire-string?(json-object-get(obj, "tool"))) ? [raw, [], ""]
   : fcctg-repair-named(raw, obj, fcctg-name(node_value(json-object-get(obj, "tool")), names), names);
  def fcctg-repair-named(raw, obj, named, names) = named[0] == "ambiguous" ? [raw, [], "Tool name \"" ++ node_value(json-object-get(obj, "tool")) ++ "\" reads as more than one native tool: " ++ str-join-with(named[2], ", ") ++ ". Use one exact name."]
   : named[0] == "unknown" ? [raw, [], "Unknown tool \"" ++ fcctg-shown(node_value(json-object-get(obj, "tool"))) ++ "\". Native tools: " ++ str-join-with(names, ", ") ++ "."]
   : fcctg-repair-args(raw, obj, named, json-object-has?(obj, "arguments") ? fcctg-args(named[1], json-object-get(obj, "arguments")) : ["absent", [], [], []]);
  def fcctg-repair-args(raw, obj, named, args) = args[0] == "refused" ? [raw, [], fcctg-arguments-note(named[1], args[2])]
   : fcctg-noop?(named[1], args[1]) ? [raw, [], fcctg-noop-note()]
   : named[0] == "exact" && args[0] != "repaired" ? [raw, [], ""]
   : fcctg-rebuilt(raw, named, args, json-emit(json-node-object(json-object-pairs(obj) |> map(p => fcctg-pair(p, named, args)))));
  def fcctg-pair(p, named, args) = json-pair-key(p) == "tool" ? json-node-pair("tool", json-node-string(named[1]))
   : json-pair-key(p) == "arguments" && args[0] == "repaired" ? json-node-pair("arguments", json-node-array(fcctg-strings(args[1])))
   : p;
  def fcctg-rebuilt(raw, named, args, text) = [text, append(named[0] == "repaired" ? [fcctg-row("native-tool-name-repair", raw, text, fcctg-tool-of(raw), named[1], ["tool"])] : [],
   args[0] == "repaired" ? [fcctg-row("native-tool-argument-repair", raw, text, fcctg-tool-of(raw), named[1], args[3])] : []), ""];
  def fcctg-tool-of(raw) = node_value(json-object-get(parse-json("turn-guard-call", raw), "tool"));
  def fcsw-json-step(state, raw, checker) = fcap-done(state) ? state : fcap-node-address?(raw) ? fcsw-node-step(state, fcap-address-node(raw), checker) : fcsw-repaired(state, raw, checker, fcctg-repair(raw, fcsw-tool-names()));
  def fcsw-repaired(state, raw, checker, repair) = repair[2] != "" ? fcap-revise(state, repair[2]) : fcsw-stepped(state, repair[0], checker, repair[1]);
  def fcsw-tool-in(text) {
   let obj = faj-valid(text) ? parse-json("swerve-call", text) : json-node-object([]);
   fat-wire-object?(obj) && json-object-has?(obj, "tool") && fat-wire-string?(json-object-get(obj, "tool")) ? node_value(json-object-get(obj, "tool")) : "";
  }
  def fcsw-stepped(state, text, checker, rows) {
   let tool = fcsw-tool-in(text);
   let open = tool == "" ? nothing() : fcacs-stage-open("code.tool", tool);
   let next = fcap-step(state, text, fcsw-staged-checker(checker));
   fcsw-observed-step(state, next, rows, open);
  }
 }
}
0;
