  def frss-root(base,manifest,digest) = if json-object-has?(manifest,"run_id") then frsh-path(base,str_concat("run-",fcam-hash(json-emit(json-node-array(list(json-object-get(manifest,"session"),json-object-get(manifest,"run_id"))))))) else frsh-path(base,str_concat(digest,str_concat("-",str_concat(int_to_str(host_pid()),str_concat("-",int_to_str(now_unix_ms()))))));
  def frss-run(manifest) = frss-admit(manifest,json-emit(manifest));
  def frss-admit(manifest,text) {
   if (!frss-valid(manifest)) then form_error("response session requires unique case ids and valid evaluation=1 requests") else 0;
   if (str_len(text) > FatMaxBytes()) then form_error("response session manifest oversized") else 0;
   let base = hearth-response-sessions();
   let parent = fs-mkdir(fs-path-dirname(base));
