   let summaryText = json-emit(report);
   let retained = frsh-frozen(frsh-path(root,"summary.json"),summaryText);
   let sealed = frsh-frozen(frsh-path(root,"summary.sha256"),fcam-hash(summaryText));
   let terminal = frss-observe(root,"terminal",1,frsh-path(root,"summary.json"));
   json-emit(report);
  }
