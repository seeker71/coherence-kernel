   let owner = frsh-frozen(frsh-path(root,"owner.json"),json-emit(json-node-object(list(nsm-n("owner_pid",host_pid()),nsm-n("admitted_unix_ms",now_unix_ms()),nsm-s("ownership_scope","admission evidence only; not a liveness claim")))));
   let admitted = frss-observe(root,"admission",1,frsh-path(root,"manifest.json"));
   let started = now_unix_ms();
