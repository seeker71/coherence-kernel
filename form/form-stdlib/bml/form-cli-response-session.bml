   let report = oh-set(oh-set(oh-set(brief,"native_executions_historical",json-node-null()),"provider_processes_historical",json-node-null()),"provider_usage_events",json-node-null());
   let ownerPath = frsh-path(root,"owner.json");
   let owner = if and(fs-exists?(ownerPath),faj-valid(read_file(ownerPath))) then parse-json("response-session-owner",read_file(ownerPath)) else json-node-null();
   let progress = if str_eq(oh-select(observation,response,"retain-unresolved"),"inspect-evidence") then frss-retained-reading(root,owner) else json-node-null();
   oh-emit(flow,oh-applied(observation,"inspect-evidence",progress));
