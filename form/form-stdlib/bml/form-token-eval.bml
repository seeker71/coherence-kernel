// form-token-eval.bml — Form tokens in the voice's own output, counted and judged.
//
// One scanner reads the in-stream contract as text: a control is <|form:VERB|>PAYLOAD<|/form:VERB|>, and Form
// answers it in the stream with <|form:observation|>RESULT<|/form:observation|>, RESULT one of value=<v>;
// recipe=@<p.l.t.i>; node=@<p.l.t.i>; or nothing=<reason>;. Only the envelope is Form's answer. A bare result the
// voice writes right after a control it closed (value=9;) is the voice imitating Form and reads forged, never an
// observation: microthought injects its results bare into the KV stream, but its record (microthought.json) keeps
// them apart from the voice's words, and the census weaves each back in its envelope. In an evaluation stream an
// envelope or a runtime marker the voice writes itself is renamed forged-<kind> (fte-unforge), its bytes kept.
// The scanner executes nothing.
//
// Two readings stand on it:
//   the census (ftcn-*)     per kind (recipe-birth, recipe-exec, choice, eval, knowledge-query, node-get,
//                           node-make, node-select), the controls the voice authored and how many per 1,000 IDs it
//                           generated (only controls whose IDs were read count toward the rate), the observations
//                           Form returned to them (success: value, recipe, node; or nothing=), the answers that cite
//                           an observation as a whole token, and the Form words the voice forged. Runtime markers
//                           (stage, resident-stage, peer-stage, token-receipt) and Form's observation envelopes are
//                           Form's words, never the voice's: they are counted apart. Each store of the voice's words
//                           is read once: the coding lane's replies from their own files, its transcripts for their
//                           IDs and markers. Teaching corpora are counted as taught, never as generated.
//                           observe/form-token-census.bml prints it.
//   the evaluation (fte-*)  each held-out question asked in arms: plain (no Form), taught (Form-token teaching in the
//                           prompt) and lora (the question alone, the teaching in the voice's weights). Form answers
//                           in the voice's own stream (fte-stream: the observation enters the same KV the moment a
//                           control closes) or, for a voice asked whole turns, at turn level (fte-reply). The answer
//                           is judged exact against the corpus answer read in the reply's own coordinates, with the
//                           controls emitted, the observations returned and the answer that is one of them, the
//                           refusals, the forged words, the replies cut short, the local IDs per correct answer, per
//                           family, and each question's own Form released. fte-replay asks Form again with moved
//                           coordinates carried both ways (the LoRA corpus's replayer).
//                           observe/form-token-eval-run.bml asks a local voice.
// A reading that did not arrive is nothing, never 0: a rate over no generated IDs and IDs per correct answer over
// no correct answer read null.
import form-stdlib/bml/form-cli-guide-packet.bml;
import form-stdlib/bml/string-join.bml;
section [form.bml] {
 class FormTokenCensus {
  def ftcn-kinds() = ["recipe-birth", "recipe-exec", "choice", "eval", "knowledge-query", "node-get", "node-make", "node-select"];
  def ftcn-runtime-kinds() = ["stage", "resident-stage", "peer-stage", "token-receipt"];
  def ftcn-observation() = "observation";
  def ftcn-forged-prefix() = "forged-";
  def ftcn-ledger() = "receipts/form-token-census.jsonl";
  def ftcn-member?(x, xs) = any?(k => (String) k == x, xs);
  def ftcn-runtime?(kind) = ftcn-member?(kind, ftcn-runtime-kinds());
  def ftcn-forged?(kind) = ftcn-starts?(kind, ftcn-forged-prefix());
  def ftcn-forged-kind(kind) = substring(kind, len(ftcn-forged-prefix()), len(kind));
  def ftcn-model?(kind) = !ftcn-runtime?(kind) && !((String) kind == ftcn-observation()) && !ftcn-forged?(kind);
  def ftcn-open(kind) = mc-cat(["<|form:", kind, "|>"]);
  def ftcn-close(kind) = mc-cat(["<|/form:", kind, "|>"]);
  def ftcn-control(kind, payload) = mc-cat([ftcn-open(kind), payload, ftcn-close(kind)]);
  def ftcn-starts-at?(s, at, p) = ((at + len(p)) <= len(s)) && ((String) substring(s, at, at + len(p)) == p);
  def ftcn-starts?(s, p) = ftcn-starts-at?(s, 0, p);
  // a kind is a word: a-z, 0-9 and '-', at most 40 bytes
  def ftcn-word-byte?(b) = ((b >= 97) && (b <= 122)) || ((b >= 48) && (b <= 57)) || ((Comparable) b == 45);
  def ftcn-word-from?(s, i) = i >= len(s) ? true : ftcn-word-byte?(str_byte_at(s, i)) ? ftcn-word-from?(s, i + 1) : false;
  def ftcn-word?(s) = (len(s) > 0) && (len(s) <= 40) && ftcn-word-from?(s, 0);
  // ── the scanner: every <|form:KIND|> opening in order, as [kind, payload, start, end, closed] ──
  // An opening whose close does not come before the next opening is unclosed: its payload is empty and its end
  // lies just past the opening.
  def ftcn-scan(text) = reverse(ftcn-scan-from(text, 0, []));
  def ftcn-scan-from(text, from, acc) {
   let i = str_find(text, "<|form:", from);
   if (i < 0) then acc else ftcn-scan-at(text, i, str_find(text, "|>", i + 7), acc);
  }
  def ftcn-scan-at(text, i, kindEnd, acc) {
   let kind = kindEnd < 0 ? "" : substring(text, i + 7, kindEnd);
   if ftcn-word?(kind) then ftcn-scan-closed(text, i, kind, kindEnd + 2, str_find(text, ftcn-close(kind), kindEnd + 2), str_find(text, "<|form:", kindEnd + 2), acc) else ftcn-scan-from(text, i + 7, acc);
  }
  def ftcn-scan-closed(text, i, kind, body, close, next, acc) {
   let closed = (close >= 0) && ((next < 0) || (close < next));
   let end = closed ? close + len(ftcn-close(kind)) : body;
   ftcn-scan-from(text, end, cons([kind, closed ? substring(text, body, close) : "", i, end, closed], acc));
  }
  // ── what Form answered ──
  def ftcn-class(result) = (String) result == "" ? "" : ftcn-starts?(result, "value=") ? "value" : ftcn-starts?(result, "recipe=@") ? "recipe" : ftcn-starts?(result, "node=@") ? "node" : ftcn-starts?(result, "nothing=") ? "nothing" : "other";
  def ftcn-success?(result) = ftcn-member?(ftcn-class(result), ["value", "recipe", "node"]);
  def ftcn-outcome(result) = ftcn-success?(result) ? "success" : (String) ftcn-class(result) == "nothing" ? "nothing" : "other";
  // a bare result written right after a closed control, past spaces: the voice's imitation of Form's answer, since
  // every text read here carries Form's own answers in their envelope
  def ftcn-bare-prefixes() = ["value=", "recipe=@", "node=@", "nothing=", "failure="];
  def ftcn-space?(b) = ((Comparable) b == 32) || ((Comparable) b == 10) || ((Comparable) b == 9) || ((Comparable) b == 13);
  def ftcn-skip-space(s, i) = (i < len(s)) && ftcn-space?(str_byte_at(s, i)) ? ftcn-skip-space(s, i + 1) : i;
  def ftcn-bare?(text, end) = any?(p => ftcn-starts-at?(text, ftcn-skip-space(text, end), p), ftcn-bare-prefixes());
  // what an answer carries to cite a success: the value's text, or the @address
  def ftcn-cite(result) {
   let at = (String) ftcn-class(result) == "value" ? 6 : str_find(result, "@", 0);
   let semi = str_find(result, ";", max2(at, 0));
   at < 0 ? "" : trim(substring(result, at, semi < 0 ? len(result) : semi));
  }
  // ── the voice's controls, each with what Form answered: [kind, payload, result, end, closed, bare] ──
  // result is "" when Form answered nothing in this text; bare is 1 when the voice wrote a bare result right after the
  // control. An observation answers the latest control still unanswered; one with no control to answer stands as kind
  // "" (unattributed). end is past the control, or past its observation once answered. Runtime markers and forged
  // words are no controls.
  def ftcn-controls(text) = ftcn-pair(text, ftcn-scan(text), []);
  def ftcn-pair(text, events, acc) = nil?(events) ? reverse(acc) : ftcn-pair-one(text, events[0], events[1:], acc);
  def ftcn-pair-one(text, e, rest, acc) {
   if ((String) e[0] == ftcn-observation()) then ftcn-pair(text, rest, ftcn-answer-latest(acc, e[1], e[3], []))
   else if (ftcn-runtime?(e[0]) || ftcn-forged?(e[0])) then ftcn-pair(text, rest, acc)
   else ftcn-pair(text, rest, cons([e[0], e[1], "", e[3], e[4], e[4] && ftcn-bare?(text, e[3]) ? 1 : 0], acc));
  }
  // acc runs latest first; seen holds the answered controls passed over, latest first
  def ftcn-answer-latest(acc, result, end, seen) {
   if nil?(acc) then cons(["", "", result, end, true, 0], reverse(seen))
   else if ((String) acc[0][2] == "") then append(reverse(seen), cons([acc[0][0], acc[0][1], result, end, acc[0][4], acc[0][5]], acc[1:]))
   else ftcn-answer-latest(acc[1:], result, end, cons(acc[0], seen));
  }
  def ftcn-answer-from(items) = foldl((m, it) => max2(m, it[3]), 0, items);
  // a cited value stands as a whole token: no letter or digit touches it, no '.' or '-' joins it to what stands
  // before, and no '.' or ',' joins it to a digit after (1 is not cited by 12, nor 2 by 2.5)
  def ftcn-byte(s, i) = (i < 0) || (i >= len(s)) ? -1 : str_byte_at(s, i);
  def ftcn-digit?(b) = (b >= 48) && (b <= 57);
  def ftcn-alnum?(b) = ftcn-digit?(b) || ((b >= 97) && (b <= 122)) || ((b >= 65) && (b <= 90));
  def ftcn-token-before?(s, at) = at <= 0 ? true : !ftcn-alnum?(ftcn-byte(s, at - 1)) && !((Comparable) ftcn-byte(s, at - 1) == 46) && !((Comparable) ftcn-byte(s, at - 1) == 45);
  def ftcn-token-after?(s, end) = end >= len(s) ? true : !ftcn-alnum?(ftcn-byte(s, end)) && !((((Comparable) ftcn-byte(s, end) == 46) || ((Comparable) ftcn-byte(s, end) == 44)) && ftcn-digit?(ftcn-byte(s, end + 1)));
  def ftcn-token-in?(s, word, from) {
   let at = str_find(s, word, from);
   if (at < 0) then false else if (ftcn-token-before?(s, at) && ftcn-token-after?(s, at + len(word))) then true else ftcn-token-in?(s, word, at + 1);
  }
  def ftcn-cited?(answer, it) = ftcn-success?(it[2]) && (len(ftcn-cite(it[2])) > 0) && ftcn-token-in?(answer, ftcn-cite(it[2]), 0);
  def ftcn-cites?(text, items) = any?(it => ftcn-cited?(substring(text, ftcn-answer-from(items), len(text)), it), items);
  // ── a tally: a record of counts keyed authored:<kind>, success:<kind>, nothing:<kind>, other:<kind>,
  //    runtime:<kind>, forged:<kind> (observation, bare, a runtime kind), answers, citing ──
  def ftcn-get(t, key) = record_get(t, key) ?? 0;
  def ftcn-bump(t, key, n) = record_set(t, key, ftcn-get(t, key) + n);
  def ftcn-tally-text(t, text) {
   let events = ftcn-scan(text);
   let runtime = map(e => ftcn-bump(t, "runtime:" ++ e[0], 1), filter(e => ftcn-runtime?(e[0]), events));
   let forged = map(e => ftcn-bump(t, "forged:" ++ ftcn-forged-kind(e[0]), 1), filter(e => ftcn-forged?(e[0]), events));
   let items = ftcn-pair(text, events, []);
   let bare = map(it => ftcn-bump(t, "forged:bare", 1), filter(it => (Comparable) it[5] == 1, items));
   let authored = map(it => ftcn-bump(t, "authored:" ++ it[0], 1), filter(it => !((String) it[0] == ""), items));
   let answered = map(it => ftcn-bump(t, mc-cat([ftcn-outcome(it[2]), ":", (String) it[0] == "" ? "unattributed" : it[0]]), 1), filter(it => !((String) it[2] == ""), items));
   let succeeded = any?(it => ftcn-success?(it[2]), items);
   let a = succeeded ? ftcn-bump(t, "answers", 1) : 0;
   let c = succeeded && ftcn-cites?(text, items) ? ftcn-bump(t, "citing", 1) : 0;
   t;
  }
  def ftcn-tally(texts) = foldl((t, text) => ftcn-tally-text(t, text), record_new(0), texts);
  def ftcn-merge(into, t) {
   let moved = map(k => ftcn-bump(into, k, ftcn-get(t, k)), record_keys(t));
   into;
  }
  def ftcn-key-kind(key, prefix) = substring(key, len(prefix), len(key));
  def ftcn-sum(t, prefix) = foldl((acc, k) => acc + (ftcn-starts?(k, prefix) ? ftcn-get(t, k) : 0), 0, record_keys(t));
  def ftcn-authored(t) = ftcn-sum(t, "authored:");
  def ftcn-observed(t) = ftcn-sum(t, "success:") + ftcn-sum(t, "nothing:") + ftcn-sum(t, "other:");
  def ftcn-runtime(t) = ftcn-sum(t, "runtime:");
  def ftcn-forged(t) = ftcn-sum(t, "forged:");
  // the model kinds outside the contract's eight, and the runtime and forged kinds, as name:count
  def ftcn-others(t) = filter(k => ftcn-starts?(k, "authored:") && !ftcn-member?(ftcn-key-kind(k, "authored:"), ftcn-kinds()), record_keys(t));
  def ftcn-named(t, keys, prefix) = str-join-with(map(k => mc-cat([ftcn-key-kind(k, prefix), ":", ftcn-get(t, k).str()]), keys), ", ");
  def ftcn-keys(t, prefix) = filter(k => ftcn-starts?(k, prefix), record_keys(t));
  def ftcn-runtime-keys(t) = ftcn-keys(t, "runtime:");
  // ── generated IDs ──
  def ftcn-digits(s, i, acc) = (i < len(s)) && (str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57) ? ftcn-digits(s, i + 1, (acc * 10) + (str_byte_at(s, i) - 48)) : acc;
  // the IDs one lane generated, read from its form-code counters: a counter that falls began a fresh stream
  def ftcn-lane-ids(text) = ftcn-lane-from(text, 0, 0, 0);
  def ftcn-lane-from(text, from, total, last) {
   let at = str_find(text, "form-code {", from);
   let line = at < 0 ? -1 : str_find(text, "\n", at);
   let key = at < 0 ? -1 : str_find(text, "\"generated_ids\":", at);
   let inLine = (key >= 0) && ((line < 0) || (key < line));
   let g = inLine ? ftcn-digits(text, key + 16, 0) : -1;
   if (at < 0) then total else ftcn-lane-from(text, at + 11, g < 0 ? total : g >= last ? total + (g - last) : total + g, g < 0 ? last : g);
  }
  // a rate per 1,000 IDs, kept in hundredths; nothing when no ID was read
  def ftcn-per-k(n, ids) = (nothing?(ids) || (ids <= 0)) ? nothing() : (n * 100000) / ids;
  def ftcn-hundredths(h) = mc-cat([(h / 100).str(), ".", (h - ((h / 100) * 100)) < 10 ? "0" : "", (h - ((h / 100) * 100)).str()]);
  def ftcn-rate(n, ids) = nothing?(ftcn-per-k(n, ids)) ? "rate unread: no generated ID read" : mc-cat([ftcn-hundredths(ftcn-per-k(n, ids)), " per 1,000 IDs"]);
  // ── the stores. An entry is [text, generated IDs or nothing, rated]: rated when the IDs that wrote its text are
  //    read in the store's IDs. A store is [name, files, tally, generated IDs or nothing, voice?, note, rated tally]. ──
  def ftcn-names(dir) = (Comparable) fs_is_dir(dir) != 1 ? [] : (fs_list(dir) ?? []);
  def ftcn-files(dir, suffix) = filter(p => fhn-suffix(p, suffix) && (file_size(p) > 0), map(n => mc-cat([dir, "/", n]), ftcn-names(dir)));
  def ftcn-read(path) = (Comparable) file_size(path) < 1 ? "" : fhn-read(path);
  def ftcn-entry(text, ids) = [text, ids, !nothing?(ids)];
  def ftcn-ids-of(entries) = foldl((acc, e) => acc + (e[1] ?? 0), 0, entries);
  def ftcn-store(name, files, entries, ids, voice, note) {
   let rated = ftcn-tally(map(e => e[0], filter(e => e[2], entries)));
   let unrated = ftcn-tally(map(e => e[0], filter(e => !e[2], entries)));
   [name, files, ftcn-merge(ftcn-merge(record_new(0), rated), unrated), ids, voice, note, rated];
  }
  def ftcn-first-seen?(seen, key) {
   let was = record_has(seen, key);
   let kept = record_set(seen, key, 1);
   !was;
  }
  // The coding lane. Each reply is read once, from .hearth/code-memory/replies. A lane transcript
  // (.hearth/native-turns/*.out) carries the lane's form-code counters (the IDs it generated), Form's runtime markers,
  // a form-code-reply line naming each reply it wrote (reply_evidence), and a report line (schema
  // form-native-code-v1) that repeats a reply word for word: the report line is passed over, so no reply is counted
  // twice. A reply a transcript names is rated, its IDs in that transcript's counters; a reply none names is counted,
  // its IDs unread.
  def ftcn-report-prefix() = "{\"schema\":\"form-native-code-v1\"";
  def ftcn-evidence-key() = "\"reply_evidence\":\"";
  def ftcn-evidence(text, from, acc) {
   let at = str_find(text, ftcn-evidence-key(), from);
   let start = at + len(ftcn-evidence-key());
   let end = at < 0 ? -1 : str_find(text, "\"", start);
   if ((at < 0) || (end < 0)) then acc else ftcn-evidence(text, end + 1, cons(substring(text, start, end), acc));
  }
  // a transcript: [its own lines, the IDs its counters read, the replies it names, report lines passed over]
  def ftcn-transcript(path) {
   let lines = split-on(ftcn-read(path), "\n");
   let own = filter(l => !ftcn-starts?(l, ftcn-report-prefix()), lines);
   let kept = str-join-with(own, "\n");
   [kept, ftcn-lane-ids(kept), ftcn-evidence(kept, 0, []), len(lines) - len(own)];
  }
  def ftcn-coding(root) {
   let transcripts = map(p => ftcn-transcript(p), ftcn-files(root ++ ".hearth/native-turns", ".out"));
   let named = record_new(0);
   let marked = map(t => map(n => record_set(named, root ++ n, 1), t[2]), transcripts);
   let paths = ftcn-files(root ++ ".hearth/code-memory/replies", "");
   let replies = map(p => [ftcn-read(p), nothing(), record_has(named, p)], paths);
   let rated = len(filter(r => r[2], replies));
   let absent = len(filter(n => (Comparable) file_size(n) < 1, record_keys(named)));
   let reports = foldl((acc, t) => acc + t[3], 0, transcripts);
   [ftcn-store("code-lane replies", len(paths), replies, nothing(), true, mc-cat([rated.str(), " of ", len(paths).str(), " named by a lane transcript, whose IDs count them; ", (len(paths) - rated).str(), " named by none"])), ftcn-store("lane transcripts", len(transcripts), map(t => [t[0], t[1], true], transcripts), foldl((acc, t) => acc + t[1], 0, transcripts), true, mc-cat([reports.str(), " report line(s) passed over, each repeating a reply; ", absent.str(), " named reply file(s) absent"]))];
  }
  // A draft's text lies under the root: the path its ledger row names when that path is under the root, else
  // .hearth/drafts/<draft>.md there; its ledger row carries its generated IDs. A census reads its own root only: a
  // draft the ledger names in another checkout is counted where that checkout is read.
  def ftcn-draft-path(root, r) = (len(root) > 0) && ftcn-starts?(fcgp-str(r, "path"), root) ? fcgp-str(r, "path") : mc-cat([root, ".hearth/drafts/", fcgp-str(r, "draft"), ".md"]);
  def ftcn-drafts(root) {
   let rows = filter(r => !((String) fcgp-str(r, "draft") == ""), fcgp-rows(root ++ "receipts/draft-ledger.jsonl"));
   let seen = record_new(0);
   let found = filter(d => ftcn-first-seen?(seen, d[0]) && (file_size(d[0]) > 0), map(r => [ftcn-draft-path(root, r), fcgp-num(r, "generated")], rows));
   let entries = map(d => ftcn-entry(ftcn-read(d[0]), d[1]), found);
   ftcn-store("drafts", len(found), entries, ftcn-ids-of(entries), true, mc-cat([len(rows).str(), " ledger row(s) name a draft, ", len(found).str(), " under this root"]));
  }
  // a reasoning reply (generate --reasoning): its controls, each with Form's injection woven back in its envelope
  // from microthought.json, then its answer; a reply with no microthought record ran no hook and reads its initial
  // and final text
  def ftcn-strings(doc, key) = fcgp-present?(doc, key) ? map(n => json-string-value(n), json-array-elements(json-object-get(doc, key))) : [];
  def ftcn-weave(frames, injections, acc) = nil?(frames) ? acc : ftcn-weave(frames[1:], nil?(injections) ? [] : injections[1:], mc-cat([acc, frames[0], nil?(injections) ? "" : ftcn-control(ftcn-observation(), injections[0]), "\n"]));
  def ftcn-thought-text(dir, thought) {
   let doc = parse-json("microthought", thought);
   mc-cat([ftcn-weave(ftcn-strings(doc, "controls"), ftcn-strings(doc, "injections"), ""), "\n", ftcn-read(dir ++ "/answer.txt")]);
  }
  def ftcn-generation-text(dir) {
   let thought = trim(ftcn-read(dir ++ "/microthought.json"));
   fcgp-object-line?(thought) ? ftcn-thought-text(dir, thought) : mc-cat([ftcn-read(dir ++ "/initial.txt"), "\n", ftcn-read(dir ++ "/final.txt")]);
  }
  // nothing when the reply kept no report
  def ftcn-generation-ids(dir) {
   let report = trim(ftcn-read(dir ++ "/report.json"));
   let doc = fcgp-object-line?(report) ? parse-json("generation-report", report) : nothing();
   nothing?(doc) ? nothing() : (fcgp-num(doc, "initial_generated_ids") ?? 0) + (fcgp-num(doc, "final_generated_ids") ?? 0) + (fcgp-num(doc, "length_revision_generated_ids") ?? 0);
  }
  def ftcn-generations(root) {
   let base = root ++ ".hearth/response-sessions/generation";
   let dirs = filter(d => (Comparable) fs_is_dir(d) == 1, map(n => mc-cat([base, "/", n]), ftcn-names(base)));
   let entries = map(d => ftcn-entry(ftcn-generation-text(d), ftcn-generation-ids(d)), dirs);
   ftcn-store("reasoning replies", len(dirs), entries, ftcn-ids-of(entries), true, "");
  }
  // the evaluation's own asks (receipts/form-token-eval.jsonl): the streams each physical row judged and the tails
  // the voice wrote past a control before Form answered (cut), with their IDs. A scripted row is no voice; a stream a
  // row does not carry is not read.
  def ftcn-elements(doc, key) = fcgp-present?(doc, key) ? json-array-elements(json-object-get(doc, key)) : [];
  def ftcn-judged(row) = foldl((acc, a) => append(acc, ftcn-elements(a, "questions_judged")), [], ftcn-elements(row, "arms"));
  def ftcn-question-entries(q) = cons(ftcn-entry(fcgp-str(q, "stream"), fcgp-num(q, "ids")), map(n => [json-string-value(n), nothing(), !nothing?(fcgp-num(q, "ids"))], ftcn-elements(q, "cut")));
  def ftcn-evaluations(root) {
   let rows = filter(r => (Comparable) (fcgp-num(r, "physical") ?? 0) == 1, fcgp-rows(root ++ "receipts/form-token-eval.jsonl"));
   let streams = filter(q => fcgp-present?(q, "stream"), foldl((acc, r) => append(acc, ftcn-judged(r)), [], rows));
   let entries = foldl((acc, q) => append(acc, ftcn-question-entries(q)), [], streams);
   ftcn-store("evaluation replies", nil?(streams) ? 0 : 1, entries, ftcn-ids-of(entries), true, mc-cat([len(streams).str(), " stream(s) of ", len(rows).str(), " physical row(s)"]));
  }
  def ftcn-corpus(name, paths) {
   let found = filter(p => file_size(p) > 0, paths);
   ftcn-store(name, len(found), map(p => [ftcn-read(p), nothing(), false], found), nothing(), false, "taught, not generated");
  }
