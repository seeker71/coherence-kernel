// form-token-eval.bml — Form tokens in the voice's own output, counted and judged.
//
// One scanner reads the in-stream contract as text: a control is <|form:VERB|>PAYLOAD<|/form:VERB|>, and Form
// answers it in the stream with <|form:observation|>RESULT<|/form:observation|>, RESULT one of value=<v>;
// recipe=@<p.l.t.i>; node=@<p.l.t.i>; or nothing=<reason>;. The bare result microthought injects today (value=22;
// right after a closed control, form-stdlib/bml/form-cli-microthought.bml fmc-render) is read as that control's
// observation too. The scanner executes nothing.
//
// Two readings stand on it:
//   the census (ftcn-*)     per kind (recipe-birth, recipe-exec, choice, eval, knowledge-query, node-get,
//                           node-make, node-select), the controls the voice authored and how many per 1,000 IDs it
//                           generated, the observations Form returned to them (success: value, recipe, node; or
//                           nothing=), and the answers that cite an observation. Runtime markers (stage,
//                           resident-stage, peer-stage, token-receipt) and Form's own observation envelopes are
//                           Form's words, never the voice's: they are counted apart. Teaching corpora are counted
//                           as taught, never as generated. observe/form-token-census.bml prints it.
//   the evaluation (fte-*)  each held-out question asked twice, without Form-token teaching and with it; the answer
//                           judged exact, with the controls emitted, the observations returned and used in the
//                           answer, the local IDs per correct answer and the refusals read beside it.
//                           observe/form-token-eval-run.bml asks a local voice.
// A reading that did not arrive is nothing, never 0: a rate over no generated IDs and IDs per correct answer over
// no correct answer read null.
import form-stdlib/bml/form-cli-guide-packet.bml;
import form-stdlib/bml/string-join.bml;
section [form.bml] {
 class FormTokenCensus {
  def ftcn-kinds() = ["recipe-birth", "recipe-exec", "choice", "eval", "knowledge-query", "node-get", "node-make", "node-select"];
  def ftcn-runtime-kinds() = ["stage", "resident-stage", "peer-stage", "token-receipt"];
  def ftcn-observation() = "observation";
  def ftcn-ledger() = "receipts/form-token-census.jsonl";
  def ftcn-member?(x, xs) = any?(k => (String) k == x, xs);
  def ftcn-runtime?(kind) = ftcn-member?(kind, ftcn-runtime-kinds());
  def ftcn-model?(kind) = !ftcn-runtime?(kind) && !((String) kind == ftcn-observation());
  def ftcn-open(kind) = mc-cat(["<|form:", kind, "|>"]);
  def ftcn-close(kind) = mc-cat(["<|/form:", kind, "|>"]);
  def ftcn-control(kind, payload) = mc-cat([ftcn-open(kind), payload, ftcn-close(kind)]);
  def ftcn-starts-at?(s, at, p) = ((at + len(p)) <= len(s)) && ((String) substring(s, at, at + len(p)) == p);
  def ftcn-starts?(s, p) = ftcn-starts-at?(s, 0, p);
  // a kind is a word: a-z, 0-9 and '-', at most 40 bytes
  def ftcn-word-byte?(b) = ((b >= 97) && (b <= 122)) || ((b >= 48) && (b <= 57)) || ((Comparable) b == 45);
  def ftcn-word-from?(s, i) = i >= len(s) ? true : ftcn-word-byte?(str_byte_at(s, i)) ? ftcn-word-from?(s, i + 1) : false;
  def ftcn-word?(s) = (len(s) > 0) && (len(s) <= 40) && ftcn-word-from?(s, 0);
  // ── the scanner: every <|form:KIND|> opening in order, as [kind, payload, start, end, closed] ──
  // An opening whose close does not come before the next opening is unclosed: its payload is empty and its end
  // lies just past the opening.
  def ftcn-scan(text) = reverse(ftcn-scan-from(text, 0, []));
  def ftcn-scan-from(text, from, acc) {
   let i = str_find(text, "<|form:", from);
   if (i < 0) then acc else ftcn-scan-at(text, i, str_find(text, "|>", i + 7), acc);
  }
  def ftcn-scan-at(text, i, kindEnd, acc) {
   let kind = kindEnd < 0 ? "" : substring(text, i + 7, kindEnd);
   if ftcn-word?(kind) then ftcn-scan-closed(text, i, kind, kindEnd + 2, str_find(text, ftcn-close(kind), kindEnd + 2), str_find(text, "<|form:", kindEnd + 2), acc) else ftcn-scan-from(text, i + 7, acc);
  }
  def ftcn-scan-closed(text, i, kind, body, close, next, acc) {
   let closed = (close >= 0) && ((next < 0) || (close < next));
   let end = closed ? close + len(ftcn-close(kind)) : body;
   ftcn-scan-from(text, end, cons([kind, closed ? substring(text, body, close) : "", i, end, closed], acc));
  }
  // ── what Form answered ──
  def ftcn-bare-prefixes() = ["value=", "recipe=@", "node=@", "nothing=", "failure="];
  def ftcn-space?(b) = ((Comparable) b == 32) || ((Comparable) b == 10) || ((Comparable) b == 9) || ((Comparable) b == 13);
  def ftcn-skip-space(s, i) = (i < len(s)) && ftcn-space?(str_byte_at(s, i)) ? ftcn-skip-space(s, i + 1) : i;
  // the bare result microthought injects right after a closed control: [result through its ';', end], or nothing
  def ftcn-bare(text, end) {
   let at = ftcn-skip-space(text, end);
   let semi = str_find(text, ";", at);
   let known = any?(p => ftcn-starts-at?(text, at, p), ftcn-bare-prefixes());
   (known && (semi > at) && ((semi - at) <= 240)) ? [substring(text, at, semi + 1), semi + 1] : nothing();
  }
  def ftcn-class(result) = (String) result == "" ? "" : ftcn-starts?(result, "value=") ? "value" : ftcn-starts?(result, "recipe=@") ? "recipe" : ftcn-starts?(result, "node=@") ? "node" : ftcn-starts?(result, "nothing=") ? "nothing" : "other";
  def ftcn-success?(result) = ftcn-member?(ftcn-class(result), ["value", "recipe", "node"]);
  def ftcn-outcome(result) = ftcn-success?(result) ? "success" : (String) ftcn-class(result) == "nothing" ? "nothing" : "other";
  // what an answer carries to cite a success: the value's text, or the @address
  def ftcn-cite(result) {
   let at = (String) ftcn-class(result) == "value" ? 6 : str_find(result, "@", 0);
   let semi = str_find(result, ";", max2(at, 0));
   at < 0 ? "" : trim(substring(result, at, semi < 0 ? len(result) : semi));
  }
  // ── the voice's controls, each with what Form answered: [kind, payload, result, end, closed] ──
  // result is "" when Form answered nothing in this text. An observation answers the latest control still
  // unanswered; one with no control to answer stands as kind "" (unattributed). end is past the control, or past
  // its observation once answered.
  def ftcn-controls(text) = ftcn-pair(text, ftcn-scan(text), []);
  def ftcn-pair(text, events, acc) = nil?(events) ? reverse(acc) : ftcn-pair-one(text, events[0], events[1:], acc);
  def ftcn-pair-one(text, e, rest, acc) {
   if ((String) e[0] == ftcn-observation()) then ftcn-pair(text, rest, ftcn-answer-latest(acc, e[1], e[3], []))
   else if ftcn-runtime?(e[0]) then ftcn-pair(text, rest, acc)
   else ftcn-pair(text, rest, cons(ftcn-with-bare(text, e), acc));
  }
  def ftcn-with-bare(text, e) {
   let bare = e[4] ? ftcn-bare(text, e[3]) : nothing();
   nothing?(bare) ? [e[0], e[1], "", e[3], e[4]] : [e[0], e[1], bare[0], bare[1], e[4]];
  }
  // acc runs latest first; seen holds the answered controls passed over, latest first
  def ftcn-answer-latest(acc, result, end, seen) {
   if nil?(acc) then cons(["", "", result, end, true], reverse(seen))
   else if ((String) acc[0][2] == "") then append(reverse(seen), cons([acc[0][0], acc[0][1], result, end, acc[0][4]], acc[1:]))
   else ftcn-answer-latest(acc[1:], result, end, cons(acc[0], seen));
  }
  def ftcn-answer-from(items) = foldl((m, it) => max2(m, it[3]), 0, items);
  def ftcn-cited?(answer, it) = ftcn-success?(it[2]) && (len(ftcn-cite(it[2])) > 0) && (str_find(answer, ftcn-cite(it[2]), 0) >= 0);
  def ftcn-cites?(text, items) = any?(it => ftcn-cited?(substring(text, ftcn-answer-from(items), len(text)), it), items);
  // ── a tally: a record of counts keyed authored:<kind>, success:<kind>, nothing:<kind>, other:<kind>,
  //    runtime:<kind>, answers, citing ──
  def ftcn-get(t, key) = record_get(t, key) ?? 0;
  def ftcn-bump(t, key, n) = record_set(t, key, ftcn-get(t, key) + n);
  def ftcn-tally-text(t, text) {
   let events = ftcn-scan(text);
   let runtime = map(e => ftcn-bump(t, "runtime:" ++ e[0], 1), filter(e => ftcn-runtime?(e[0]), events));
   let items = ftcn-pair(text, events, []);
   let authored = map(it => ftcn-bump(t, "authored:" ++ it[0], 1), filter(it => !((String) it[0] == ""), items));
   let answered = map(it => ftcn-bump(t, mc-cat([ftcn-outcome(it[2]), ":", (String) it[0] == "" ? "unattributed" : it[0]]), 1), filter(it => !((String) it[2] == ""), items));
   let succeeded = any?(it => ftcn-success?(it[2]), items);
   let a = succeeded ? ftcn-bump(t, "answers", 1) : 0;
   let c = succeeded && ftcn-cites?(text, items) ? ftcn-bump(t, "citing", 1) : 0;
   t;
  }
  def ftcn-tally(texts) = foldl((t, text) => ftcn-tally-text(t, text), record_new(0), texts);
  def ftcn-merge(into, t) {
   let moved = map(k => ftcn-bump(into, k, ftcn-get(t, k)), record_keys(t));
   into;
  }
  def ftcn-key-kind(key, prefix) = substring(key, len(prefix), len(key));
  def ftcn-sum(t, prefix) = foldl((acc, k) => acc + (ftcn-starts?(k, prefix) ? ftcn-get(t, k) : 0), 0, record_keys(t));
  def ftcn-authored(t) = ftcn-sum(t, "authored:");
  def ftcn-observed(t) = ftcn-sum(t, "success:") + ftcn-sum(t, "nothing:") + ftcn-sum(t, "other:");
  def ftcn-runtime(t) = ftcn-sum(t, "runtime:");
  // the model kinds outside the contract's eight, and the runtime kinds, as name:count
  def ftcn-others(t) = filter(k => ftcn-starts?(k, "authored:") && !ftcn-member?(ftcn-key-kind(k, "authored:"), ftcn-kinds()), record_keys(t));
  def ftcn-named(t, keys, prefix) = str-join-with(map(k => mc-cat([ftcn-key-kind(k, prefix), ":", ftcn-get(t, k).str()]), keys), ", ");
  def ftcn-runtime-keys(t) = filter(k => ftcn-starts?(k, "runtime:"), record_keys(t));
  // ── generated IDs ──
  def ftcn-digits(s, i, acc) = (i < len(s)) && (str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57) ? ftcn-digits(s, i + 1, (acc * 10) + (str_byte_at(s, i) - 48)) : acc;
  // the IDs one lane generated, read from its form-code counters: a counter that falls began a fresh stream
  def ftcn-lane-ids(text) = ftcn-lane-from(text, 0, 0, 0);
  def ftcn-lane-from(text, from, total, last) {
   let at = str_find(text, "form-code {", from);
   let line = at < 0 ? -1 : str_find(text, "\n", at);
   let key = at < 0 ? -1 : str_find(text, "\"generated_ids\":", at);
   let inLine = (key >= 0) && ((line < 0) || (key < line));
   let g = inLine ? ftcn-digits(text, key + 16, 0) : -1;
   if (at < 0) then total else ftcn-lane-from(text, at + 11, g < 0 ? total : g >= last ? total + (g - last) : total + g, g < 0 ? last : g);
  }
  // a rate per 1,000 IDs, kept in hundredths; nothing when no ID was read
  def ftcn-per-k(n, ids) = (nothing?(ids) || (ids <= 0)) ? nothing() : (n * 100000) / ids;
  def ftcn-hundredths(h) = mc-cat([(h / 100).str(), ".", (h - ((h / 100) * 100)) < 10 ? "0" : "", (h - ((h / 100) * 100)).str()]);
  def ftcn-rate(n, ids) = nothing?(ftcn-per-k(n, ids)) ? "rate unread: no generated ID read" : mc-cat([ftcn-hundredths(ftcn-per-k(n, ids)), " per 1,000 IDs"]);
  // ── the stores: [name, files, tally, generated IDs or nothing, voice?, what reads the IDs when this store does not] ──
  def ftcn-names(dir) = (Comparable) fs_is_dir(dir) != 1 ? [] : (fs_list(dir) ?? []);
  def ftcn-files(dir, suffix) = filter(p => fhn-suffix(p, suffix) && (file_size(p) > 0), map(n => mc-cat([dir, "/", n]), ftcn-names(dir)));
  def ftcn-read(path) = (Comparable) file_size(path) < 1 ? "" : fhn-read(path);
  def ftcn-store(name, files, texts, ids, voice, note) = [name, files, ftcn-tally(texts), ids, voice, note];
  def ftcn-replies(root) {
   let paths = ftcn-files(root ++ ".hearth/code-memory/replies", "");
   ftcn-store("code-lane replies", len(paths), map(p => ftcn-read(p), paths), nothing(), true, "counted by the lane transcripts");
  }
  def ftcn-lanes(root) {
   let texts = map(p => ftcn-read(p), ftcn-files(root ++ ".hearth/native-turns", ".out"));
   ftcn-store("lane transcripts", len(texts), texts, foldl((acc, t) => acc + ftcn-lane-ids(t), 0, texts), true, "");
  }
  // a draft's text lives at .hearth/drafts/<draft>.md under the root; its ledger row carries its generated IDs. A
  // census reads its own root: a draft the ledger names in another checkout is counted where that checkout is read.
  def ftcn-drafts(root) {
   let rows = filter(r => !((String) fcgp-str(r, "draft") == ""), fcgp-rows(root ++ "receipts/draft-ledger.jsonl"));
   let found = filter(d => file_size(d[0]) > 0, map(r => [mc-cat([root, ".hearth/drafts/", fcgp-str(r, "draft"), ".md"]), fcgp-num(r, "generated") ?? 0], rows));
   ftcn-store("drafts", len(found), map(d => ftcn-read(d[0]), found), foldl((acc, d) => acc + d[1], 0, found), true, mc-cat([len(rows).str(), " ledger row(s) name a draft, ", len(found).str(), " under this root"]));
  }
  // a reasoning reply (generate --reasoning): its controls and Form's injections woven back in their order, then
  // its answer; a reply with no microthought record reads its initial and final text
  def ftcn-strings(doc, key) = fcgp-present?(doc, key) ? map(n => json-string-value(n), json-array-elements(json-object-get(doc, key))) : [];
  def ftcn-weave(frames, injections, acc) = nil?(frames) ? acc : ftcn-weave(frames[1:], nil?(injections) ? [] : injections[1:], mc-cat([acc, frames[0], nil?(injections) ? "" : injections[0], "\n"]));
  def ftcn-thought-text(dir, thought) {
   let doc = parse-json("microthought", thought);
   mc-cat([ftcn-weave(ftcn-strings(doc, "controls"), ftcn-strings(doc, "injections"), ""), "\n", ftcn-read(dir ++ "/answer.txt")]);
  }
  def ftcn-generation-text(dir) {
   let thought = trim(ftcn-read(dir ++ "/microthought.json"));
   fcgp-object-line?(thought) ? ftcn-thought-text(dir, thought) : mc-cat([ftcn-read(dir ++ "/initial.txt"), "\n", ftcn-read(dir ++ "/final.txt")]);
  }
  def ftcn-generation-ids(dir) {
   let report = trim(ftcn-read(dir ++ "/report.json"));
   let doc = fcgp-object-line?(report) ? parse-json("generation-report", report) : json-node-object([]);
   (fcgp-num(doc, "initial_generated_ids") ?? 0) + (fcgp-num(doc, "final_generated_ids") ?? 0) + (fcgp-num(doc, "length_revision_generated_ids") ?? 0);
  }
  def ftcn-generations(root) {
   let base = root ++ ".hearth/response-sessions/generation";
   let dirs = filter(d => (Comparable) fs_is_dir(d) == 1, map(n => mc-cat([base, "/", n]), ftcn-names(base)));
   ftcn-store("reasoning replies", len(dirs), map(d => ftcn-generation-text(d), dirs), foldl((acc, d) => acc + ftcn-generation-ids(d), 0, dirs), true, "");
  }
  def ftcn-corpus(name, paths) {
   let found = filter(p => file_size(p) > 0, paths);
   ftcn-store(name, len(found), map(p => ftcn-read(p), found), nothing(), false, "taught, not generated");
  }
  // [stores, voice tally, generated IDs, corpus tally]
  def ftcn-census(root) {
   let stores = [ftcn-replies(root), ftcn-lanes(root), ftcn-drafts(root), ftcn-generations(root), ftcn-corpus("lora corpus", [root ++ ".form-lora-voice-native/distill.jsonl"]), ftcn-corpus("form-token traces", [root ++ "learn/form-token-traces.jsonl"])];
   let voice = foldl((t, s) => s[4] ? ftcn-merge(t, s[2]) : t, record_new(0), stores);
   let corpus = foldl((t, s) => s[4] ? t : ftcn-merge(t, s[2]), record_new(0), stores);
   [stores, voice, foldl((acc, s) => acc + (s[3] ?? 0), 0, stores), corpus];
  }
  // ── the lines ──
  def ftcn-outcomes(t, suffix) = mc-cat(["success ", ftcn-get(t, "success:" ++ suffix).str(), ", nothing ", ftcn-get(t, "nothing:" ++ suffix).str(), ", other ", ftcn-get(t, "other:" ++ suffix).str()]);
  def ftcn-observed-line(t) = mc-cat(["observations ", ftcn-observed(t).str(), " (success ", ftcn-sum(t, "success:").str(), ", nothing ", ftcn-sum(t, "nothing:").str(), ", other ", ftcn-sum(t, "other:").str(), ")"]);
  def ftcn-store-line(s) = s[4] ? mc-cat(["[form-token-census] ", s[0], ": files ", s[1].str(), ", model-authored ", ftcn-authored(s[2]).str(), ", runtime markers ", ftcn-runtime(s[2]).str(), ", ", ftcn-observed-line(s[2]), nothing?(s[3]) ? mc-cat([", generated IDs ", s[5]]) : mc-cat([", generated IDs ", s[3].str(), (String) s[5] == "" ? "" : mc-cat(["; ", s[5]])])]) : mc-cat(["[form-token-census] ", s[0], " (", s[5], "): files ", s[1].str(), ", controls ", ftcn-authored(s[2]).str(), nil?(ftcn-others(s[2])) && ((Comparable) ftcn-authored(s[2]) == 0) ? "" : mc-cat([" (", ftcn-named(s[2], filter(k => ftcn-starts?(k, "authored:"), record_keys(s[2])), "authored:"), ")"]), ", ", ftcn-observed-line(s[2])]);
  def ftcn-kind-line(t, k, ids) = mc-cat(["[form-token-census] kind ", k, ": authored ", ftcn-get(t, "authored:" ++ k).str(), " (", ftcn-rate(ftcn-get(t, "authored:" ++ k), ids), "), observations: ", ftcn-outcomes(t, k)]);
  def ftcn-lines(c) {
   let t = c[1];
   let ids = c[2];
   let files = foldl((acc, s) => acc + s[1], 0, c[0]);
   let others = ftcn-others(t);
   let runtimeKeys = ftcn-runtime-keys(t);
   let stores = map(s => ftcn-store-line(s), c[0]);
   let kinds = map(k => ftcn-kind-line(t, k, ids), ftcn-kinds());
   let rest = [mc-cat(["[form-token-census] other model kinds: ", nil?(others) ? "none" : ftcn-named(t, others, "authored:"), "; unattributed observations ", (ftcn-get(t, "success:unattributed") + ftcn-get(t, "nothing:unattributed") + ftcn-get(t, "other:unattributed")).str()]), mc-cat(["[form-token-census] answers: ", ftcn-get(t, "answers").str(), " carried a successful observation, ", ftcn-get(t, "citing").str(), " cite one"]), mc-cat(["[form-token-census] runtime markers, apart: ", nil?(runtimeKeys) ? "none" : ftcn-named(t, runtimeKeys, "runtime:")]), mc-cat(["[form-token-census] total: ", files.str(), " files, model-authored ", ftcn-authored(t).str(), " (", ftcn-rate(ftcn-authored(t), ids), " over ", ids.str(), " generated IDs), runtime markers ", ftcn-runtime(t).str(), ", ", ftcn-observed-line(t)])];
   append(stores, append(kinds, rest));
  }
  // ── the row ──
  def ftcn-kinds-node(t, ks, outcomes) = json-node-object(map(k => json-node-pair(k, outcomes ? json-node-object([fhn-n("authored", ftcn-get(t, "authored:" ++ k)), fhn-n("success", ftcn-get(t, "success:" ++ k)), fhn-n("nothing", ftcn-get(t, "nothing:" ++ k)), fhn-n("other", ftcn-get(t, "other:" ++ k))]) : json-node-int(ftcn-get(t, "authored:" ++ k))), ks));
  def ftcn-counts-node(t, keys, prefix) = json-node-object(map(k => fhn-n(ftcn-key-kind(k, prefix), ftcn-get(t, k)), keys));
  def ftcn-store-authored(c, name) = foldl((acc, s) => (String) s[0] == name ? ftcn-authored(s[2]) : acc, 0, c[0]);
  def ftcn-row(c, at) {
   let t = c[1];
   json-node-object([fhn-n("at_unix_ms", at), fhn-n("files", foldl((acc, s) => acc + s[1], 0, c[0])), fhn-n("model_authored", ftcn-authored(t)), fhn-n("runtime_markers", ftcn-runtime(t)), fhn-n("observations", ftcn-observed(t)), fhn-n("code_lane_model_authored", ftcn-store-authored(c, "code-lane replies")), fhn-n("lane_transcript_model_authored", ftcn-store-authored(c, "lane transcripts")), fhn-n("generated_ids", c[2]), fcgp-maybe("per_k_ids_hundredths", ftcn-per-k(ftcn-authored(t), c[2])), fhn-n("observations_success", ftcn-sum(t, "success:")), fhn-n("observations_nothing", ftcn-sum(t, "nothing:")), fhn-n("observations_other", ftcn-sum(t, "other:")), fhn-n("answers_with_observation", ftcn-get(t, "answers")), fhn-n("answers_citing", ftcn-get(t, "citing")), json-node-pair("kinds", ftcn-kinds-node(t, ftcn-kinds(), true)), json-node-pair("other_kinds", ftcn-counts-node(t, ftcn-others(t), "authored:")), json-node-pair("runtime_kinds", ftcn-counts-node(t, ftcn-runtime-keys(t), "runtime:")), fhn-n("corpus_controls", ftcn-authored(c[3])), json-node-pair("corpus_kinds", ftcn-kinds-node(c[3], ftcn-kinds(), false))]);
  }
  // ── the review's column (form-stdlib/bml/local-flow-reading.bml prints it): the latest census row, read as
  //    written; a field an older row does not carry reads null ──
  def ftcn-show(v) = nothing?(v) ? "null" : v.str();
  def ftcn-review-rate(row) = nothing?(fcgp-num(row, "per_k_ids_hundredths")) ? "rate unread" : mc-cat([ftcn-hundredths(fcgp-num(row, "per_k_ids_hundredths")), " per 1,000 IDs"]);
  def ftcn-review-of(row, before) = mc-cat(["[local-flow-review] form tokens: model-authored ", ftcn-show(fcgp-num(row, "model_authored")), " (", ftcn-review-rate(row), " over ", ftcn-show(fcgp-num(row, "generated_ids")), " generated IDs), observations ", ftcn-show(fcgp-num(row, "observations")), " (success ", ftcn-show(fcgp-num(row, "observations_success")), "), ", ftcn-show(fcgp-num(row, "answers_citing")), " answer(s) cite one, runtime markers ", ftcn-show(fcgp-num(row, "runtime_markers")), " apart; the census before read ", nothing?(before) ? "nothing" : mc-cat(["model-authored ", before.str()])]);
  def ftcn-review-line(rows) = nil?(rows) ? "[local-flow-review] form tokens: no census row yet (observe/form-token-census.bml)" : ftcn-review-of(rows[-1], len(rows) > 1 ? fcgp-num(rows[-2], "model_authored") : nothing());
  // stdin, optional: the root that holds the stores; "" reads this checkout
  def ftcn-root() {
   let line = read_line();
   (nothing?(line) || (String) trim(line) == "") ? "" : trim(line) ++ "/";
  }
  def ftcn-run(root) {
   let c = ftcn-census(root);
   let printed = map(line => print_str(line), ftcn-lines(c));
   let appended = fhn-append(ftcn-ledger(), json-emit(ftcn-row(c, now_unix_ms())) + "\n");
   ftcn-authored(c[1]);
  }
 }
 class FormTokenEval {
  def fte-ledger() = "receipts/form-token-eval.jsonl";
  def fte-traces() = "learn/form-token-traces.jsonl";
  def fte-arms() = ["plain", "taught"];
  // ── held-out rows: {"id", "split", "question", "answer"} (prompt/input and expected are read too; a number reads
  //    as its text) ──
  def fte-text(row, key) = !fcgp-present?(row, key) ? "" : fcgp-str-node?(json-object-get(row, key)) ? json-string-value(json-object-get(row, key)) : json-emit(json-object-get(row, key));
  def fte-field(row, keys) = foldl((found, k) => (String) found == "" ? fte-text(row, k) : found, "", keys);
  def fte-id(row) = fte-field(row, ["id"]);
  def fte-question(row) = fte-field(row, ["question", "prompt", "input"]);
  def fte-expected(row) = fte-field(row, ["answer", "expected"]);
  def fte-heldout?(row) = ftcn-member?(fte-text(row, "split"), ["heldout", "held-out", "test", "eval"]) && !((String) fte-question(row) == "") && !((String) fte-expected(row) == "");
  def fte-heldout(rows) = filter(r => fte-heldout?(r), rows);
  // until the traces corpus lands: three held-out questions and one training row, in its row shape
  def fte-fixture-lines() = ["{\"id\":\"fx-arith-1\",\"split\":\"heldout\",\"question\":\"What is 17 * 23 + 4?\",\"answer\":\"395\"}", "{\"id\":\"fx-arith-2\",\"split\":\"heldout\",\"question\":\"What is (1234 - 567) * 3?\",\"answer\":2001}", "{\"id\":\"fx-recipe-1\",\"split\":\"heldout\",\"question\":\"Apply the affine recipe with mul=3 and add=7 to the input 5. What value does it give?\",\"answer\":\"22\"}", "{\"id\":\"fx-train-1\",\"split\":\"train\",\"question\":\"What is 2 + 2?\",\"answer\":\"4\"}"];
  def fte-fixture-rows() = map(l => parse-json("trace-row", l), fte-fixture-lines());
  // [source, held-out rows]: the traces corpus when it holds held-out rows, else the fixtures
  def fte-rows(path) {
   let held = fte-heldout(fcgp-rows(path));
   nil?(held) ? ["fixture", fte-heldout(fte-fixture-rows())] : [path, held];
  }
  // ── the two prompts: the same question and the same answer line; only the teaching differs ──
  // no placeholder brackets here: a voice taught by examples echoes them around its answer
  def fte-instruction() = "End your reply with one line that begins with Answer: and holds only the exact answer.";
  def fte-teaching() = mc-cat(["You run inside Form, a runtime that can compute and look things up for you while you answer. ", "To ask it, write one control and stop: Form writes its observation into your reply as ", ftcn-control(ftcn-observation(), "RESULT"), ", where RESULT is value=<value>; or recipe=@<address>; or node=@<address>; or nothing=<reason>;. ", "Controls: ", ftcn-control("eval", "17 * 23 + 4"), " evaluates a pure expression (arithmetic, comparisons, strings, lists). ", ftcn-control("knowledge-query", "words naming the concept"), " looks the concept up in the body's grounded rows. ", ftcn-control("node-get", "@p.l.t.i"), " reads a node: its kind, value and children. ", ftcn-control("node-make", "category;@child,@child"), " makes a node and answers its address. ", ftcn-control("node-select", "predicate;@a,@b"), " answers the first node the predicate holds for. ", ftcn-control("recipe-birth", "affine-i32;mul=3;add=7"), " makes a recipe and answers recipe=@address; ", ftcn-control("recipe-exec", "@address;input=5;carrier=metal"), " runs it with that exact address and answers value=<value>;. ", ftcn-control("choice", "@first,@second;input=5;carrier=metal"), " tries recipes in order until one answers a value. ", "Use an observation's value in your answer; a control alone proves nothing, and nothing=<reason> is not an answer."]);
  def fte-prompt(arm, question) = (String) arm == "plain" ? mc-cat(["Question: ", question, "\n", fte-instruction()]) : mc-cat([fte-teaching(), "\n\nQuestion: ", question, "\n", fte-instruction()]);
  def fte-continue(prompt, stream) = mc-cat([prompt, "\n\nYour reply so far, with Form's observation:\n", stream, "\n\nContinue your reply from Form's observation."]);
  // ── one arm's reply: [stream text, generated IDs, stop reason, crossings] ──
  // ask(prompt) answers [text, generated IDs, stop reason]; observe(verb, payload) answers Form's RESULT. A plain arm
  // asks once. A taught arm reads the first control the voice closed, cuts the reply there (what follows was written
  // before Form answered), lets Form answer, and asks again with the reply so far, at most `crossings` times. The
  // crossing is turn-level: each ask prefills the reply so far, where the same-KV hook would keep the stream.
  def fte-first-control(text) {
   let closed = filter(e => ftcn-model?(e[0]) && e[4], ftcn-scan(text));
   nil?(closed) ? nothing() : closed[0];
  }
  def fte-reply(ask, observe, arm, question, crossings) {
   let prompt = fte-prompt(arm, question);
   let first = ask(prompt);
   (String) arm == "plain" ? [first[0], first[1], first[2], 0] : fte-cross(ask, observe, prompt, "", first, first[1], crossings, 0);
  }
  def fte-cross(ask, observe, prompt, stream, reply, ids, left, made) {
   let found = fte-first-control(reply[0]);
   if (nothing?(found) || (left <= 0)) then [mc-cat([stream, reply[0]]), ids, reply[2], made] else fte-crossed(ask, observe, prompt, mc-cat([stream, substring(reply[0], 0, found[3]), ftcn-control(ftcn-observation(), observe(found[0], found[1]))]), ids, left, made);
  }
  def fte-crossed(ask, observe, prompt, stream, ids, left, made) {
   let next = ask(fte-continue(prompt, stream));
   fte-cross(ask, observe, prompt, stream, next, ids + next[1], left - 1, made + 1);
  }
  // ── the answer and its judgement ──
  // the answer: the last "Answer:" line after the last control or observation, else the last line there
  def fte-after-mark(line) = trim(substring(line, str_find(str-lower(line), "answer:", 0) + 7, len(line)));
  def fte-answer(text, from) {
   let lines = filter(l => len(trim(l)) > 0, split-on(substring(text, from, len(text)), "\n"));
   let marked = filter(l => str_find(str-lower(l), "answer:", 0) >= 0, lines);
   nil?(lines) ? "" : nil?(marked) ? trim(lines[-1]) : fte-after-mark(marked[-1]);
  }
  def fte-wrap?(b) = ((Comparable) b == 46) || ((Comparable) b == 96) || ((Comparable) b == 34) || ((Comparable) b == 39) || ((Comparable) b == 42) || ftcn-space?(b);
  def fte-strip-end(s) = (len(s) > 0) && fte-wrap?(str_byte_at(s, len(s) - 1)) ? fte-strip-end(substring(s, 0, len(s) - 1)) : s;
  def fte-strip-start(s) = (len(s) > 0) && fte-wrap?(str_byte_at(s, 0)) ? fte-strip-start(substring(s, 1, len(s))) : s;
  def fte-norm(s) = fte-strip-start(fte-strip-end(str-lower(trim(s))));
  def fte-exact?(answer, expected) = !((String) fte-norm(answer) == "") && ((String) fte-norm(answer) == fte-norm(expected));
  // one reply judged: [exact, controls, observations, used in the answer, refusals, silent, IDs, crossings]
  def fte-judge(expected, reply) {
   let items = ftcn-controls(reply[0]);
   let answer = fte-answer(reply[0], ftcn-answer-from(items));
   let controls = len(filter(it => !((String) it[0] == ""), items));
   let observed = len(filter(it => !((String) it[2] == ""), items));
   let used = len(filter(it => ftcn-cited?(answer, it), items));
   let refused = len(filter(it => (String) ftcn-class(it[2]) == "nothing", items));
   [fte-exact?(answer, expected) ? 1 : 0, controls, observed, used, refused, (String) answer == "" ? 1 : 0, reply[1], reply[3]];
  }
  // an arm folded: [questions, exact, controls, observations, used, refusals, silent, IDs, crossings]
  def fte-fold(js) = foldl((a, j) => [a[0] + 1, a[1] + j[0], a[2] + j[1], a[3] + j[2], a[4] + j[3], a[5] + j[4], a[6] + j[5], a[7] + j[6], a[8] + j[7]], [0, 0, 0, 0, 0, 0, 0, 0, 0], js);
  def fte-per-correct(s) = s[1] <= 0 ? nothing() : s[7] / s[1];
  // each held-out row asked in each arm: [[arm, fold, [[id, judgement, answer]...]], ...]
  def fte-arm(rows, arm, ask, observe, crossings) {
   let judged = map(r => fte-judged(r, fte-reply(ask, observe, arm, fte-question(r), crossings)), rows);
   [arm, fte-fold(map(j => j[1], judged)), judged];
  }
  def fte-judged(row, reply) = [fte-id(row), fte-judge(fte-expected(row), reply), fte-answer(reply[0], ftcn-answer-from(ftcn-controls(reply[0]))), reply[0]];
  def fte-evaluate(rows, arms, ask, observe, crossings) = map(arm => fte-arm(rows, arm, ask, observe, crossings), arms);
  // ── the lines and the row ──
  def fte-show(v) = nothing?(v) ? "null" : v.str();
  def fte-line(a) = mc-cat(["[form-token-eval] ", a[0], ": ", a[1][0].str(), " question(s), exact ", a[1][1].str(), ", controls ", a[1][2].str(), ", observations ", a[1][3].str(), " (", a[1][4].str(), " used in the answer), refusals ", a[1][5].str(), ", silent ", a[1][6].str(), ", local IDs ", a[1][7].str(), " (", nothing?(fte-per-correct(a[1])) ? "no correct answer" : mc-cat([fte-per-correct(a[1]).str(), " per correct answer"]), "), crossings ", a[1][8].str()]);
  // the taught arm read against the plain one: exact answers, IDs per correct answer, Form's part in them
  def fte-compare-line(plain, taught) = mc-cat(["[form-token-eval] taught against plain: exact ", taught[1][1].str(), " against ", plain[1][1].str(), " of ", taught[1][0].str(), "; IDs per correct answer ", fte-show(fte-per-correct(taught[1])), " against ", fte-show(fte-per-correct(plain[1])), "; the taught voice wrote ", taught[1][2].str(), " control(s), Form answered ", taught[1][3].str(), " (", taught[1][5].str(), " refused) and ", taught[1][4].str(), " carried into an answer"]);
  def fte-question-line(a, q) = mc-cat(["[form-token-eval] ", a[0], " ", q[0], ": ", q[1][0] == 1 ? "exact" : "not exact", ", answer '", substring(q[2], 0, min2(len(q[2]), 80)), "', controls ", q[1][1].str(), ", observations ", q[1][2].str(), ", IDs ", q[1][6].str()]);
  def fte-arm-node(a) = json-node-object([fhn-s("arm", a[0]), fhn-n("questions", a[1][0]), fhn-n("exact", a[1][1]), fhn-n("controls", a[1][2]), fhn-n("observations", a[1][3]), fhn-n("observations_used", a[1][4]), fhn-n("refusals", a[1][5]), fhn-n("silent", a[1][6]), fhn-n("local_ids", a[1][7]), fcgp-maybe("ids_per_correct", fte-per-correct(a[1])), fhn-n("crossings", a[1][8]), json-node-pair("questions_judged", json-node-array(map(q => json-node-object([fhn-s("id", q[0]), fhn-n("exact", q[1][0]), fhn-s("answer", q[2]), fhn-n("controls", q[1][1]), fhn-n("observations", q[1][2]), fhn-n("refusals", q[1][4]), fhn-n("ids", q[1][6]), fhn-n("crossings", q[1][7]), fhn-s("stream", q[3])]), a[2])))]);
  def fte-row(at, source, voice, adapter, physical, crossing, arms) = json-node-object([fhn-n("at_unix_ms", at), fhn-s("source", source), fhn-s("voice", voice), fhn-s("adapter", adapter), fhn-n("physical", physical), fhn-s("crossing", crossing), json-node-pair("arms", json-node-array(map(a => fte-arm-node(a), arms)))]);
  // ── the review's column (form-stdlib/bml/local-flow-reading.bml prints it): the latest evaluation row ──
  def fte-arm-of(row, name) = foldl((found, a) => (String) fcgp-str(a, "arm") == name ? a : found, json-node-object([]), fcgp-present?(row, "arms") ? json-array-elements(json-object-get(row, "arms")) : []);
  def fte-review-of(row) {
   let p = fte-arm-of(row, "plain");
   let t = fte-arm-of(row, "taught");
   mc-cat(["[local-flow-review] form-token eval (", fcgp-str(row, "source"), ", ", (Comparable) (fcgp-num(row, "physical") ?? 0) == 1 ? mc-cat(["voice ", fcgp-str(row, "voice")]) : "scripted", "): taught exact ", fte-show(fcgp-num(t, "exact")), " against plain ", fte-show(fcgp-num(p, "exact")), " of ", fte-show(fcgp-num(t, "questions")), "; IDs per correct answer ", fte-show(fcgp-num(t, "ids_per_correct")), " against ", fte-show(fcgp-num(p, "ids_per_correct")), "; taught controls ", fte-show(fcgp-num(t, "controls")), ", observations ", fte-show(fcgp-num(t, "observations")), ", refusals ", fte-show(fcgp-num(t, "refusals"))]);
  }
  def fte-review-line(rows) = nil?(rows) ? "[local-flow-review] form-token eval: no row yet (observe/form-token-eval-run.bml)" : fte-review-of(rows[-1]);
 }
 0;
}
