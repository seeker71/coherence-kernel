package Form.native.tensorledger;

import Form.kernel.*;

interface INativeModelTensorLedger [public, witness, reusable] {
   section [public] {
      const String IdentityRule = "a tensor group has one stable semantic id; changing observation epochs and lifecycle never mint another group identity";
      const String ByteRule = "allocated bytes come from the same size list passed to the physical Metal allocation doors; mapped bytes come from the GGUF record length passed to metal_buf_from_file";
      const String HandleRule = "physical-live requires one positive carrier handle for every positive requested extent; zero placeholders are removed before reconciliation";
      const String ResidenceRule = "allocated and mapped byte extents are measured ownership facts; neither is renamed materialized-page residence";
      const String ReleaseRule = "release changes lifecycle only after the corresponding physical handle release succeeds";

      Object Group( String id, String parent, String owner, String kind, Object handles, Object sizes, Int observedEpoch, String source, Object channels ) [abstract];
      Int GroupValid( Object group ) [abstract];
      Int GroupBytes( Object group ) [abstract];
      Int GroupHandles( Object group ) [abstract];
      Object QwenScratchSizes( Int maxPosition ) [abstract];
      Object QwenStateSizes( Int layer, Int maxPosition, Int fullAttention ) [abstract];
      Int QwenAllocatedBytes( Int maxPosition, Int layers, Int fullAttentionInterval ) [abstract];
      Int QwenAllocatedHandles( Int maxPosition, Int layers, Int fullAttentionInterval ) [abstract];
      Object LlamaScratchSizes( Int modelWidth, Int feedForwardWidth, Int vocabulary, Int heads, Int maxPosition ) [abstract];
      Int LlamaCacheBytes( Int kvWidth, Int maxPosition ) [abstract];
      Int LlamaAllocatedBytes( Int modelWidth, Int feedForwardWidth, Int vocabulary, Int heads, Int kvWidth, Int layers, Int maxPosition ) [abstract];
      Int LlamaAllocatedHandles( Int modelWidth, Int feedForwardWidth, Int vocabulary, Int heads, Int kvWidth, Int layers, Int maxPosition ) [abstract];
   }
}

class NativeModelTensorLedger [public, reusable, observable, teach] : INativeModelTensorLedger {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-tensor-ledger.bml";
      Object Group( String id, String parent, String owner, String kind, Object handles, Object sizes, Int observedEpoch, String source, Object channels ) [abstract] {}
      Int GroupValid( Object group ) [abstract] {}
      Int GroupBytes( Object group ) [abstract] {}
      Int GroupHandles( Object group ) [abstract] {}
      Object QwenScratchSizes( Int maxPosition ) [abstract] {}
      Object QwenStateSizes( Int layer, Int maxPosition, Int fullAttention ) [abstract] {}
      Int QwenAllocatedBytes( Int maxPosition, Int layers, Int fullAttentionInterval ) [abstract] {}
      Int QwenAllocatedHandles( Int maxPosition, Int layers, Int fullAttentionInterval ) [abstract] {}
      Object LlamaScratchSizes( Int modelWidth, Int feedForwardWidth, Int vocabulary, Int heads, Int maxPosition ) [abstract] {}
      Int LlamaCacheBytes( Int kvWidth, Int maxPosition ) [abstract] {}
      Int LlamaAllocatedBytes( Int modelWidth, Int feedForwardWidth, Int vocabulary, Int heads, Int kvWidth, Int layers, Int maxPosition ) [abstract] {}
      Int LlamaAllocatedHandles( Int modelWidth, Int feedForwardWidth, Int vocabulary, Int heads, Int kvWidth, Int layers, Int maxPosition ) [abstract] {}
   }
}
