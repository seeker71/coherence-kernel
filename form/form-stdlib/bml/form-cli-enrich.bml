// Existing Form meanings offered to the arriving reasoner and writer.
// Explicit terms select authored senses; this is retrieval, not a classifier.
// Definitions and language rows retain their own authority. No model is loaded.
// preludes: cognition/form-neutral-word-field.fk cognition/response-word-field-dictionary.fk form-stdlib/word-frequency-purify.fk form-stdlib/meaning-codes.bml
section [form.bml] {
 class FormCliEnrich {
  def fce-limit() = 12;
  def fce-help() = mc-cat(list("enrich <space-separated exact terms>: retrieve Form definitions, all dictionary senses, seeded relations, usage examples and present language codes. Case matters. Up to ", int_to_str(fce-limit()), " terms per reading; repeat with the remaining terms. enrich --text-file PATH reads locale surfaces occurring in that file, retaining all codebook meanings for each match. These are source lookup candidates; choose language and sense from context. The arriving mind applies these resources to the enquiry and writes the answer."));
  def fce-join(words) = if nil?(words) then "" else mc-cat(list(head(words), if nil?(tail(words)) then "" else " ", fce-join(tail(words))));
  def fce-terms(parts) = if nil?(parts) then list() else if str_eq(trim(head(parts)), "") then fce-terms(tail(parts)) else cons(trim(head(parts)), fce-terms(tail(parts)));
  def fce-kind(kind) = if eq(kind, rwfd-kind-carrier()) then "carrier-label" else if eq(kind, rwfd-kind-functional()) then "functional" else if eq(kind, rwfd-kind-inflection()) then "inflection" else "lexical";
  def fce-edges(edges) = if nil?(edges) then "" else mc-cat(list("    seeded relation ", int_to_str(fwf-edge-rel(head(edges))), " -> ", fwf-surface(fwf-at(fwf-edge-to(head(edges)))), "\n", fce-edges(tail(edges))));
  def fce-neutral(seed) = if nil?(seed) then "" else mc-cat(list("  cognition/form-neutral-word-field.fk | authored seed ", int_to_str(fwf-id(seed)), "\n    ", fce-join(fwf-desc(seed)), "\n", fce-edges(fwf-forward(fwf-surface(seed)))));
  def fce-senses(rows) = if nil?(rows) then "" else mc-cat(list("    sense ", int_to_str(rwfd-id(head(rows))), " [", fce-kind(rwfd-kind(head(rows))), "]: ", fce-join(rwfd-desc(head(rows))), "\n", fce-senses(tail(rows))));
  def fce-dictionary(rows) = if nil?(rows) then "" else mc-cat(list("  cognition/response-word-field-dictionary.fk | senses=", int_to_str(len(rows)), "; select by context\n", fce-senses(rows)));
  def fce-usage(row) = if nil?(row) then "" else mc-cat(list("  form/form-stdlib/word-frequency-purify.fk | usage example\n    ", wfp-purified(row), "\n"));
  def fce-codes(term, table) = if not(mc-member?(mc-meanings(), term)) then "" else fce-code-line(mc-codes-in(table, term));
  def fce-code-line(codes) = mc-cat(list("  form/form-stdlib/meaning-codes.bml | language surfaces for one symbol; node is a short symbol anchor\n    ", mc-line(codes), "\n", if eq(len(codes), 3) then "    locale-rows=nothing for this meaning\n" else ""));
  def fce-term(term, table) {
   let body = mc-cat(list(fce-neutral(fwf-find(term)), fce-dictionary(rwfd-find-all(term)), fce-usage(wfp-find(term)), fce-codes(term, table)));
   mc-cat(list(term, "\n", if str_eq(body, "") then "  nothing: no exact entry in these resources; continue with source search\n" else body));
  }
  def fce-walk(terms, remaining, table) = if nil?(terms) then "" else if eq(remaining, 0) then mc-cat(list("remaining-terms=", int_to_str(len(terms)), "; request these in the next reading\n")) else mc-cat(list(fce-term(head(terms), table), fce-walk(tail(terms), sub(remaining, 1), table)));
  def fce-report(terms, table) = mc-cat(list("Form response enrichment | source=existing-native-resources\n", "Use the definitions to reason, choose senses in context, and connect the answer to an action.\n", "Seed identifiers and relations are authored vocabulary data. They do not measure a person's frequency or establish response quality.\n\n", fce-walk(terms, fce-limit(), table)));
  def fce-mention-meanings(symbols,table) = if nil?(symbols) then "" else mc-cat(list("    ",mc-line(mc-codes-in(table,head(symbols))),"\n",fce-mention-meanings(tail(symbols),table)));
  def fce-mentions(rows,table) = if nil?(rows) then "" else {
   let row = head(rows);
   mc-cat(list("  byte=",int_to_str(nth(row,1))," surface=",head(row),"\n",fce-mention-meanings(nth(row,2),table),fce-mentions(tail(rows),table)));
  };
  def fce-text-report(text,table) {
   let rows = mc-text-codes-in(mc-book-of(mc-meanings(),table),text);
   mc-cat(list("Form codebook text lookup | source=meaning-codes.bml\nExact case-sensitive locale surfaces at whitespace or punctuation boundaries; offsets are zero-based bytes. All matching symbols are retained. These candidates do not identify the prose's language or intended sense. Missing matches describe this codebook and delimiter set.\n",if nil?(rows) then "locale-matches=nothing\n" else fce-mentions(rows,table)));
  }
  def fce-text-file(path) {
   let text = read_file(path);
   if nothing?(text) then mc-cat(list("source=nothing path=",path,"\n")) else mc-cat(list("source=",path,"\n",fce-text-report(text,mc-table())));
  }
  def fce-command(arg) = if or(nothing?(arg), or(str_eq(trim(arg), ""), str_eq(trim(arg), "help"))) then fce-help() else if str_eq(trim(arg),"--text-file") then "enrich --text-file PATH needs a source path" else if eq(str_find(arg,"--text-file ",0),0) then fce-text-file(trim(substring(arg,str_len("--text-file "),str_len(arg)))) else fce-report(fce-terms(split-on(arg, " ")), mc-table());
 }
 0;
}
