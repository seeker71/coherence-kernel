// Existing Form meanings offered to the arriving reasoner and writer.
// Explicit terms select authored senses; this is retrieval, not a classifier.
// Definitions and language rows retain their own authority. No model is loaded.
import cognition/form-neutral-word-field.fk;
import cognition/response-word-field-dictionary.fk;
import form-stdlib/word-frequency-purify.fk;
import form-stdlib/meaning-codes.bml;
section [form.bml] {
 class FormCliEnrich {
  def fce-limit() = 12;
  def fce-help() = "enrich <space-separated exact terms>: retrieve Form definitions, all dictionary senses, seeded relations, usage examples and present language codes. Case matters. Up to " ++ fce-limit().str() ++ " terms per reading; repeat with the remaining terms. enrich --text-file PATH reads locale surfaces occurring in that file, retaining all codebook meanings for each match. These are source lookup candidates; choose language and sense from context. The arriving mind applies these resources to the enquiry and writes the answer.";
  def fce-join(words) = nil?(words) ? "" : words[0] ++ (nil?(words[1:]) ? "" : " ") ++ fce-join(words[1:]);
  def fce-terms(parts) = nil?(parts) ? [] : (String) trim(parts[0]) == "" ? fce-terms(parts[1:]) : cons(trim(parts[0]), fce-terms(parts[1:]));
  def fce-kind(kind) = (Comparable) kind == rwfd-kind-carrier() ? "carrier-label" : (Comparable) kind == rwfd-kind-functional() ? "functional" : (Comparable) kind == rwfd-kind-inflection() ? "inflection" : "lexical";
  def fce-edges(edges) = nil?(edges) ? "" : "    seeded relation " ++ fwf-edge-rel(edges[0]).str() ++ " -> " ++ fwf-surface(fwf-at(fwf-edge-to(edges[0]))) ++ "\n" ++ fce-edges(edges[1:]);
  def fce-neutral(seed) = nil?(seed) ? "" : "  cognition/form-neutral-word-field.fk | authored seed " ++ fwf-id(seed).str() ++ "\n    " ++ fce-join(fwf-desc(seed)) ++ "\n" ++ fce-edges(fwf-forward(fwf-surface(seed)));
  def fce-senses(rows) = nil?(rows) ? "" : "    sense " ++ rwfd-id(rows[0]).str() ++ " [" ++ fce-kind(rwfd-kind(rows[0])) ++ "]: " ++ fce-join(rwfd-desc(rows[0])) ++ "\n" ++ fce-senses(rows[1:]);
  def fce-dictionary(rows) = nil?(rows) ? "" : "  cognition/response-word-field-dictionary.fk | senses=" ++ len(rows).str() ++ "; select by context\n" ++ fce-senses(rows);
  def fce-usage(row) = nil?(row) ? "" : "  form/form-stdlib/word-frequency-purify.fk | usage example\n    " ++ wfp-purified(row) ++ "\n";
  def fce-codes(term, table) = !mc-member?(mc-meanings(), term) ? "" : fce-code-line(mc-codes-in(table, term));
  def fce-code-line(codes) = "  form/form-stdlib/meaning-codes.bml | language surfaces for one symbol; node is a short symbol anchor\n    " ++ mc-line(codes) ++ "\n" ++ ((Comparable) len(codes) == 3 ? "    locale-rows=nothing for this meaning\n" : "");
  def fce-term(term, table) {
   let body = fce-neutral(fwf-find(term)) ++ fce-dictionary(rwfd-find-all(term)) ++ fce-usage(wfp-find(term)) ++ fce-codes(term, table);
   term ++ "\n" ++ ((String) body == "" ? "  nothing: no exact entry in these resources; continue with source search\n" : body);
  }
  def fce-walk(terms, remaining, table) = nil?(terms) ? "" : (Comparable) remaining == 0 ? "remaining-terms=" ++ len(terms).str() ++ "; request these in the next reading\n" : fce-term(terms[0], table) ++ fce-walk(terms[1:], remaining - 1, table);
  def fce-report(terms, table) = "Form response enrichment | source=existing-native-resources\n" ++ "Use the definitions to reason, choose senses in context, and connect the answer to an action.\n" ++ "Seed identifiers and relations are authored vocabulary data. They do not measure a person's frequency or establish response quality.\n\n" ++ fce-walk(terms, fce-limit(), table);
  def fce-mention-meanings(symbols,table) = nil?(symbols) ? "" : "    " ++ mc-line(mc-codes-in(table,symbols[0])) ++ "\n" ++ fce-mention-meanings(symbols[1:],table);
  def fce-mentions(rows,table) = nil?(rows) ? "" : {
   let row = rows[0];
   "  byte=" ++ row[1].str() ++ " surface=" ++ row[0] ++ "\n" ++ fce-mention-meanings(row[2],table) ++ fce-mentions(rows[1:],table);
  };
  def fce-text-report(text,table) {
   let rows = mc-text-codes-in(mc-book-of(mc-meanings(),table),text);
   "Form codebook text lookup | source=meaning-codes.bml\nExact case-sensitive locale surfaces at whitespace or punctuation boundaries; offsets are zero-based bytes. All matching symbols are retained. These candidates do not identify the prose's language or intended sense. Missing matches describe this codebook and delimiter set.\n" ++ (nil?(rows) ? "locale-matches=nothing\n" : fce-mentions(rows,table));
  }
  def fce-text-file(path) {
   let text = read_file(path);
   nothing?(text) ? "source=nothing path=" ++ path ++ "\n" : "source=" ++ path ++ "\n" ++ fce-text-report(text,mc-table());
  }
  def fce-command(arg) = nothing?(arg) || (((String) trim(arg) == "") || ((String) trim(arg) == "help")) ? fce-help() : (String) trim(arg) == "--text-file" ? "enrich --text-file PATH needs a source path" : (Comparable) str_find(arg,"--text-file ",0) == 0 ? fce-text-file(trim(substring(arg,len("--text-file "),len(arg)))) : fce-report(fce-terms(split-on(arg, " ")), mc-table());
 }
 0;
}
