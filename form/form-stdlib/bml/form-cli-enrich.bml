// Existing Form meanings offered to the arriving reasoner and writer.
// Explicit terms select authored senses; this is retrieval, not a classifier.
// Definitions and language rows retain their own authority. No model is loaded.
// preludes: cognition/form-neutral-word-field.fk cognition/response-word-field-dictionary.fk form-stdlib/word-frequency-purify.fk form-stdlib/meaning-codes.bml
section [form.bml] {
 class FormCliEnrich {
  def fce-limit() = 12;
  def fce-help() = "enrich <space-separated exact terms>: retrieve Form definitions, all dictionary senses, seeded relations, usage examples and present language codes. Case matters. Up to " ++ int_to_str(fce-limit()) ++ " terms per reading; repeat with the remaining terms. enrich --text-file PATH reads locale surfaces occurring in that file, retaining all codebook meanings for each match. These are source lookup candidates; choose language and sense from context. The arriving mind applies these resources to the enquiry and writes the answer.";
  def fce-join(words) = nil?(words) ? "" : (head(words) ++ (nil?(tail(words)) ? "" : " ") ++ fce-join(tail(words)));
  def fce-terms(parts) = nil?(parts) ? list() : (String) trim(head(parts)) == "" ? fce-terms(tail(parts)) : cons(trim(head(parts)), fce-terms(tail(parts)));
  def fce-kind(kind) = (Comparable) kind == rwfd-kind-carrier() ? "carrier-label" : (Comparable) kind == rwfd-kind-functional() ? "functional" : (Comparable) kind == rwfd-kind-inflection() ? "inflection" : "lexical";
  def fce-edges(edges) = nil?(edges) ? "" : ("    seeded relation " ++ int_to_str(fwf-edge-rel(head(edges))) ++ " -> " ++ fwf-surface(fwf-at(fwf-edge-to(head(edges)))) ++ "\n" ++ fce-edges(tail(edges)));
  def fce-neutral(seed) = nil?(seed) ? "" : ("  cognition/form-neutral-word-field.fk | authored seed " ++ int_to_str(fwf-id(seed)) ++ "\n    " ++ fce-join(fwf-desc(seed)) ++ "\n" ++ fce-edges(fwf-forward(fwf-surface(seed))));
  def fce-senses(rows) = nil?(rows) ? "" : ("    sense " ++ int_to_str(rwfd-id(head(rows))) ++ " [" ++ fce-kind(rwfd-kind(head(rows))) ++ "]: " ++ fce-join(rwfd-desc(head(rows))) ++ "\n" ++ fce-senses(tail(rows)));
  def fce-dictionary(rows) = nil?(rows) ? "" : ("  cognition/response-word-field-dictionary.fk | senses=" ++ int_to_str(len(rows)) ++ "; select by context\n" ++ fce-senses(rows));
  def fce-usage(row) = nil?(row) ? "" : ("  form/form-stdlib/word-frequency-purify.fk | usage example\n    " ++ wfp-purified(row) ++ "\n");
  def fce-codes(term, table) = !mc-member?(mc-meanings(), term) ? "" : fce-code-line(mc-codes-in(table, term));
  def fce-code-line(codes) = "  form/form-stdlib/meaning-codes.bml | language surfaces for one symbol; node is a short symbol anchor\n    " ++ mc-line(codes) ++ "\n" ++ ((Comparable) len(codes) == 3 ? "    locale-rows=nothing for this meaning\n" : "");
  def fce-term(term, table) {
   let body = fce-neutral(fwf-find(term)) ++ fce-dictionary(rwfd-find-all(term)) ++ fce-usage(wfp-find(term)) ++ fce-codes(term, table);
   term ++ "\n" ++ ((String) body == "" ? "  nothing: no exact entry in these resources; continue with source search\n" : body);
  }
  def fce-walk(terms, remaining, table) = nil?(terms) ? "" : (Comparable) remaining == 0 ? ("remaining-terms=" ++ int_to_str(len(terms)) ++ "; request these in the next reading\n") : (fce-term(head(terms), table) ++ fce-walk(tail(terms), remaining - 1, table));
  def fce-report(terms, table) = "Form response enrichment | source=existing-native-resources\n" ++ "Use the definitions to reason, choose senses in context, and connect the answer to an action.\n" ++ "Seed identifiers and relations are authored vocabulary data. They do not measure a person's frequency or establish response quality.\n\n" ++ fce-walk(terms, fce-limit(), table);
  def fce-mention-meanings(symbols,table) = nil?(symbols) ? "" : ("    " ++ mc-line(mc-codes-in(table,head(symbols))) ++ "\n" ++ fce-mention-meanings(tail(symbols),table));
  def fce-mentions(rows,table) = nil?(rows) ? "" : {
   let row = head(rows);
   "  byte=" ++ int_to_str(row[1]) ++ " surface=" ++ head(row) ++ "\n" ++ fce-mention-meanings(row[2],table) ++ fce-mentions(tail(rows),table);
  };
  def fce-text-report(text,table) {
   let rows = mc-text-codes-in(mc-book-of(mc-meanings(),table),text);
   "Form codebook text lookup | source=meaning-codes.bml\nExact case-sensitive locale surfaces at whitespace or punctuation boundaries; offsets are zero-based bytes. All matching symbols are retained. These candidates do not identify the prose's language or intended sense. Missing matches describe this codebook and delimiter set.\n" ++ (nil?(rows) ? "locale-matches=nothing\n" : fce-mentions(rows,table));
  }
  def fce-text-file(path) {
   let text = read_file(path);
   nothing?(text) ? ("source=nothing path=" ++ path ++ "\n") : ("source=" ++ path ++ "\n" ++ fce-text-report(text,mc-table()));
  }
  def fce-command(arg) = nothing?(arg) || (((String) trim(arg) == "") || ((String) trim(arg) == "help")) ? fce-help() : (String) trim(arg) == "--text-file" ? "enrich --text-file PATH needs a source path" : (Comparable) str_find(arg,"--text-file ",0) == 0 ? fce-text-file(trim(substring(arg,str_len("--text-file "),str_len(arg)))) : fce-report(fce-terms(split-on(arg, " ")), mc-table());
 }
 0;
}
