// A worker's owner is a checkout-local lease, not the continued existence of a spool.
// Deadlines and ownership are checked between native model rounds and idle waits.
section [form.bml] {
    class EarWorkerLife {
        def ewl-owner-path() = ".hearth/ear.owner";
        def ewl-input-path() = ".hearth/ear.lane.input";
        def ewl-text(value) = if nothing?(value) then "" else value;
        def ewl-token(pid, epoch) = str_concat(int_to_str(pid), str_concat(" ", int_to_str(epoch)));
        def ewl-pid(owner) = str_to_int(substring(owner, 0, str_find(owner, " ", 0)));
        def ewl-input(owner) = str_concat("\n\n", str_concat(owner, "\n"));
        def ewl-claim(owner) {
            let saved = write_file_text(ewl-owner-path(), owner);
            if lt(saved, 0) then 0 else ge(write_file_text(ewl-input-path(), ewl-input(owner)), 0);
        }
        def ewl-same?(owner, current, alive) = if str_eq(owner, "") then 1 else and(str_eq(owner, current), eq(alive, 1));
        def ewl-owned?(owner) = if str_eq(owner, "") then 1 else ewl-same?(owner, ewl-text(read_file(ewl-owner-path())), host_alive(ewl-pid(owner)));
        def ewl-session(until, owner) = list(until, owner);
        def ewl-running?(session) = and(le(now_unix_ms(), head(session)), ewl-owned?(nth(session, 1)));
        // The spool is authoritative. A bounded native wait cannot miss a bell,
        // deadlock on an absent FIFO reader, or orphan a shell/sleep subprocess.
        def ewl-rest() = host_sleep_ms(20);
    }
    0;
}
