// A retained, selection-following viewport. No hidden second renderer.
// preludes: form/form-stdlib/form-glass-dashboard.bml
section [form.bml] {
    class GlassViewViewport {
        def fgvp-has?(keys, key) = if ((Comparable) len(keys) == 0) then 0 else if ((String) head(keys) == key) then 1 else fgvp-has?(tail(keys), key);
        def fgvp-intersects?(keys, values) = if ((Comparable) len(values) == 0) then 0 else if ((Comparable) fgvp-has?(keys, head(values)) == 1) then 1 else fgvp-intersects?(keys, tail(values));
        def fgvp-line-selected?(line, keys) = if ((Comparable) len(line) == 0) then 0 else if (((Comparable) fgvp-has?(keys, ftc-segment-node-id(head(line))) == 1) || ((Comparable) fgvp-intersects?(keys, ftc-segment-channels(head(line))) == 1)) then 1 else fgvp-line-selected?(tail(line), keys);
        def fgvp-index(lines, keys, at) = if ((Comparable) len(lines) == 0) then -1 else if ((Comparable) fgvp-line-selected?(head(lines), keys) == 1) then at else fgvp-index(tail(lines), keys, (at + 1));
        def fgvp-window(lines, keys, width, count) {
            let index = fgvp-index(lines, keys, 0);
            let room = fgd-max(0, (count - 2));
            let body = if ((Comparable) len(lines) == 0) then [] else tail(lines);
            let start = if ((index <= room) || (room <= 0)) then 0 else fgd-min(fgd-max(0, (len(body) - room)), (index - room));
            let below = fgd-max(0, (len(body) - (start + room)));
            let note = fgd-segment-line(fgd-cat(["rows above=", int_to_str(start), " below=", int_to_str(below), " | arrows/Tab browse; i field; e evidence"]), width, fgd-neutral(176), "view.overflow", ["view", "evidence"], "declared");
            if (count <= 0) then [] else if (len(lines) <= count) then lines else if ((Comparable) count == 1) then [note] else append([head(lines)], append(fgd-take(fgd-drop(body, start), room), [note]));
        }
    }
    0;
}
