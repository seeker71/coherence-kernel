// A retained, selection-following viewport. No hidden second renderer.
// preludes: form/form-stdlib/form-glass-dashboard.bml
section [form.bml] {
    class GlassViewViewport {
        def fgvp-has?(keys, key) = if eq(len(keys), 0) then 0 else if str_eq(head(keys), key) then 1 else fgvp-has?(tail(keys), key);
        def fgvp-intersects?(keys, values) = if eq(len(values), 0) then 0 else if eq(fgvp-has?(keys, head(values)), 1) then 1 else fgvp-intersects?(keys, tail(values));
        def fgvp-line-selected?(line, keys) = if eq(len(line), 0) then 0 else if or(eq(fgvp-has?(keys, ftc-segment-node-id(head(line))), 1), eq(fgvp-intersects?(keys, ftc-segment-channels(head(line))), 1)) then 1 else fgvp-line-selected?(tail(line), keys);
        def fgvp-index(lines, keys, at) = if eq(len(lines), 0) then -1 else if eq(fgvp-line-selected?(head(lines), keys), 1) then at else fgvp-index(tail(lines), keys, add(at, 1));
        def fgvp-window(lines, keys, width, count) {
            let index = fgvp-index(lines, keys, 0);
            let room = fgd-max(0, sub(count, 2));
            let body = if eq(len(lines), 0) then list() else tail(lines);
            let start = if or(le(index, room), le(room, 0)) then 0 else fgd-min(fgd-max(0, sub(len(body), room)), sub(index, room));
            let below = fgd-max(0, sub(len(body), add(start, room)));
            let note = fgd-segment-line(fgd-cat(list("rows above=", int_to_str(start), " below=", int_to_str(below), " | arrows/Tab browse; i field; e evidence")), width, fgd-neutral(176), "view.overflow", list("view", "evidence"), "declared");
            if le(count, 0) then list() else if le(len(lines), count) then lines else if eq(count, 1) then list(note) else append(list(head(lines)), append(fgd-take(fgd-drop(body, start), room), list(note)));
        }
    }
    0;
}
