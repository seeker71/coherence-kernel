// A retained, selection-following viewport. No hidden second renderer.
// preludes: form/form-stdlib/form-glass-dashboard.bml
section [form.bml] {
    class GlassViewViewport {
        def fgvp-has?(keys, key) = (Comparable) len(keys) == 0 ? 0 : (String) head(keys) == key ? 1 : fgvp-has?(tail(keys), key);
        def fgvp-intersects?(keys, values) = (Comparable) len(values) == 0 ? 0 : (Comparable) fgvp-has?(keys, head(values)) == 1 ? 1 : fgvp-intersects?(keys, tail(values));
        def fgvp-line-selected?(line, keys) = (Comparable) len(line) == 0 ? 0 : ((Comparable) fgvp-has?(keys, ftc-segment-node-id(head(line))) == 1) || ((Comparable) fgvp-intersects?(keys, ftc-segment-channels(head(line))) == 1) ? 1 : fgvp-line-selected?(tail(line), keys);
        def fgvp-index(lines, keys, at) = (Comparable) len(lines) == 0 ? -1 : (Comparable) fgvp-line-selected?(head(lines), keys) == 1 ? at : fgvp-index(tail(lines), keys, at + 1);
        def fgvp-window(lines, keys, width, count) {
            let index = fgvp-index(lines, keys, 0);
            let room = fgd-max(0, count - 2);
            let body = (Comparable) len(lines) == 0 ? list() : tail(lines);
            let start = (index <= room) || (room <= 0) ? 0 : fgd-min(fgd-max(0, len(body) - room), index - room);
            let below = fgd-max(0, len(body) - (start + room));
            let note = fgd-segment-line(fgd-cat(list("rows above=", int_to_str(start), " below=", int_to_str(below), " | arrows/Tab browse; i field; e evidence")), width, fgd-neutral(176), "view.overflow", list("view", "evidence"), "declared");
            count <= 0 ? list() : len(lines) <= count ? lines : (Comparable) count == 1 ? list(note) : append(list(head(lines)), append(fgd-take(fgd-drop(body, start), room), list(note)));
        }
    }
    0;
}
