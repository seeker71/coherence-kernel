// A retained, selection-following viewport. No hidden second renderer.
import form/form-stdlib/form-glass-dashboard.bml;
section [form.bml] {
    class GlassViewViewport {
        def fgvp-has?(keys, key) = if ((Comparable) len(keys) == 0) then 0 else if ((String) keys[0] == key) then 1 else fgvp-has?(keys[1:], key);
        def fgvp-intersects?(keys, values) = if ((Comparable) len(values) == 0) then 0 else if ((Comparable) fgvp-has?(keys, values[0]) == 1) then 1 else fgvp-intersects?(keys, values[1:]);
        def fgvp-line-selected?(line, keys) = if ((Comparable) len(line) == 0) then 0 else if (((Comparable) fgvp-has?(keys, ftc-segment-node-id(line[0])) == 1) || ((Comparable) fgvp-intersects?(keys, ftc-segment-channels(line[0])) == 1)) then 1 else fgvp-line-selected?(line[1:], keys);
        def fgvp-index(lines, keys, at) = if ((Comparable) len(lines) == 0) then -1 else if ((Comparable) fgvp-line-selected?(lines[0], keys) == 1) then at else fgvp-index(lines[1:], keys, (at + 1));
        def fgvp-window(lines, keys, width, count) {
            let index = fgvp-index(lines, keys, 0);
            let room = fgd-max(0, (count - 2));
            let body = if ((Comparable) len(lines) == 0) then [] else lines[1:];
            let start = if ((index <= room) || (room <= 0)) then 0 else fgd-min(fgd-max(0, (len(body) - room)), (index - room));
            let below = fgd-max(0, (len(body) - (start + room)));
            let note = fgd-segment-line(fgd-cat(["rows above=", start.str(), " below=", below.str(), " | arrows/Tab browse; i field; e evidence"]), width, fgd-neutral(176), "view.overflow", ["view", "evidence"], "declared");
            if (count <= 0) then [] else if (len(lines) <= count) then lines else if ((Comparable) count == 1) then [note] else append([lines[0]], append(fgd-take(fgd-drop(body, start), room), [note]));
        }
    }
    0;
}
