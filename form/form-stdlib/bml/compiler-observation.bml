// Read only diagnostics produced inside the caller's compilation window.
import form-stdlib/source-compiler.fk;
section [form.bml] {
 class CompilerObservation {
  def co-error-start() { kernel_stat(0); kernel_stat(13); }
  def co-error-since(start) {
   kernel_stat(0); let roots=framebuffer-events();
    let errors=drop(max2(0,len(roots) - (kernel_stat(13) - start)),roots) |> filter(n=>value_kind(n)=="node_id" && node_eq(node_category(n),fsc-compiler-error-cat));
   nil?(errors) ? nothing() : node_value(node_children(errors[-1])[0]);
  }
 }
}
