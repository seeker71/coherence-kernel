// Admission requires the captured roster to contain exactly this positive PID.
// The roster is a bounded observation, not a complete host liveness census.
import form-stdlib/core.fk;
section [form.bml] {
 class FieldResetAdmission {
  def fra-admit(pid,rows) =
   if (!((String) value_kind(pid) == "int")) then 0
   else if (!(pid > 0)) then 0
   else if (!((String) value_kind(rows) == "list")) then 0
   else if nil?(rows) then 0
   else if (!nil?(rows[1:])) then 0
   else if (!((String) value_kind(rows[0]) == "int")) then 0
   else ((Comparable) rows[0] == pid);
 }
 0;
}
