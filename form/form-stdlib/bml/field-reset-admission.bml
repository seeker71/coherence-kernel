// Admission requires the captured roster to contain exactly this positive PID.
// The roster is a bounded observation, not a complete host liveness census.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class FieldResetAdmission {
  def fra-admit(pid,rows) =
   !((String) value_kind(pid) == "int") ? 0
   : !(pid > 0) ? 0
   : !((String) value_kind(rows) == "list") ? 0
   : nil?(rows) ? 0
   : !nil?(tail(rows)) ? 0
   : !((String) value_kind(head(rows)) == "int") ? 0
   : ((Comparable) head(rows) == pid);
 }
 0;
}
