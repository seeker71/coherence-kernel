// Admission requires the captured roster to contain exactly this positive PID.
// The roster is a bounded observation, not a complete host liveness census.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class FieldResetAdmission {
  def fra-admit(pid,rows) =
   if not(str_eq(value_kind(pid),"int")) then 0
   else if not(gt(pid,0)) then 0
   else if not(str_eq(value_kind(rows),"list")) then 0
   else if nil?(rows) then 0
   else if not(nil?(tail(rows))) then 0
   else if not(str_eq(value_kind(head(rows)),"int")) then 0
   else eq(head(rows),pid);
 }
 0;
}
