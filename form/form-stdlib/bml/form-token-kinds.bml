// form-token-kinds.bml — the Form tokens, once.
//
// The nine controls a voice writes in its stream. The grammar (form-token-grammar.bml) dispatches them, the census
// (form-token-eval.bml) counts them per kind, the trainer's contract (lora-backward.bml) admits them and the Qwen
// head's control-ID rows name them: until 2026-10-09 each held its own copy of this list, and the copy in the trainer
// lacked recipe-import, so every recipe-import trace was refused unknown-verb and the adapter never held the ninth
// token. The three now read this one.
//
// The order is the Qwen head's: a verb's control-ID row is the first PAD row of the vocabulary + 1 + its index here, so
// a new verb closes the list and an existing verb never moves.
section [form.bml] {
 class FormTokenKinds {
  def ftk-verbs() = ["recipe-birth", "recipe-exec", "choice", "eval", "knowledge-query", "node-get", "node-make", "node-select", "recipe-import"];
  def ftk-verb?(verb) = any?(v => (String) v == verb, ftk-verbs());
  // a verb's index in the list, or -1: the offset of its control-ID row
  def ftk-index(verb) = ftk-index-from(verb, ftk-verbs(), 0);
  def ftk-index-from(verb, vs, i) = nil?(vs) ? 0 - 1 : (String) vs[0] == verb ? i : ftk-index-from(verb, vs[1:], i + 1);
 }
 0;
}
