// form-token-kinds.bml — the Form tokens, once.
//
// The nine controls a voice writes in its stream. The grammar (form-token-grammar.bml) dispatches them, the census
// (form-token-eval.bml) counts them per kind, the trainer's contract (lora-backward.bml) admits them and the Qwen
// head's control-ID rows name them: until 2026-10-09 each held its own copy of this list, and the copy in the trainer
// lacked recipe-import, so every recipe-import trace was refused unknown-verb and the adapter never held the ninth
// token. The three now read this one.
//
// The order is the Qwen head's: a verb's control-ID row is the first PAD row of the vocabulary + 1 + its index here, so
// a new verb closes the list and an existing verb never moves.
import form-stdlib/json-precise.bml;
import form-stdlib/line-grammar.fk;
section [form.bml] {
 class FormTokenKinds {
  def ftk-verbs() = ["recipe-birth", "recipe-exec", "choice", "eval", "knowledge-query", "node-get", "node-make", "node-select", "recipe-import"];
  def ftk-verb?(verb) = any?(v => (String) v == verb, ftk-verbs());
  def ftk-source-payload?(verb) = any?(v => verb==v,["recipe-birth","recipe-exec","choice","eval","node-make","node-select","tool"]);
  // a verb's index in the list, or -1: the offset of its control-ID row
  def ftk-index(verb) = ftk-index-from(verb, ftk-verbs(), 0);
  def ftk-index-from(verb, vs, i) = nil?(vs) ? 0 - 1 : (String) vs[0] == verb ? i : ftk-index-from(verb, vs[1:], i + 1);
  // A result's transport spelling is separate from its value. Encoded strings
  // have an explicit kind, so ordinary text that looks like JSON stays text.
  def ftk-result-head(result) { let at=str_find(result,"=",0); at<0 ? "" : substring(result,0,at); }
  def ftk-result-encoded?(result) = any?(k => ftk-result-head(result)==k,["value-json","nothing-json"]);
  def ftk-result-kind(result) {
   let head=ftk-result-head(result);
   ftk-result-encoded?(result) ? substring(head,0,len(head) - 5) : any?(k => head==k,["value","nothing","recipe","node"]) ? head : "";
  }
  def ftk-result-body(result) {
   let at=str_find(result,"=",0);
   let end=len(result)>0 && substring(result,len(result) - 1,len(result))==";" ? len(result) - 1 : len(result);
   let body=at<0 ? "" : substring(result,at + 1,end);
   ftk-result-encoded?(result) ? (try { let value=json-string-value(parse-json("Form observation",body)); value_kind(value)=="string" ? value : nothing(); } catch nothing()) : body;
  }
  def ftk-result(kind,text) = str_find(text,"<|",0)<0 ? kind + "=" + text + ";" : kind + "-json=" + str-join-with(split-on(json-emit-precise(json-node-string(text)),"<|"),"\\u003c|") + ";";
 }
 0;
}
