  def svs-floor(env) = env[17];
  def svs-nmin(env) = env[18];
  def svs-accept(d, v, j) = j >= len(d) ? j : (d[j] == v[j] ? svs-accept(d, v, j + 1) : j);
  // a row's acceptance (per mille, a running share) after a pass that tried k drafts and had m stand; a pass that tried none lets it drift back toward 600, so a row that fell under the floor is tried again
  def svs-rate(rate, m, k) = k <= 0 ? rate + (600 - rate) / 16 : (rate * 7 + 3 * (m * 1000 / k)) / 10;
  // props: what each row could carry (lists), rates: per mille, lims: the most each may carry, width: columns in the pass. Every row has its column; the rest go one at a time to the row whose next draft is
  // likeliest (rate^(k+1)), while that is at least floor. Answers the drafts each row carries (a prefix of its proposal).
  def svs-assign(props, rates, lims, width, floor) {
