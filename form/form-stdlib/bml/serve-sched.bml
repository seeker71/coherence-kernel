  // A sequence ended before it was admitted or before it decoded has no admit or decode time of its own: its ledger row reads them as the moment it ended, never as the epoch
  // (a queued one's queue_ms was -1296705433 and its decode_ms 1296748218 when they stood at zero)
  def svs-shed-seq(s, t) = svs-finish(svs-put(svs-put(s, 12, s[12] == 0 ? t : s[12]), 13, s[13] == 0 ? t : s[13]), "owner-gone", t);
  def svs-shed-end(S, env, gone, all) {
