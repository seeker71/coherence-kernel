   let a = svs-ng-index(idx, h, 1, len(h));
   [h, idx];
  }
  def svs-ng-key(h, i, n) = n == 1 ? h[i - 1].str() : n == 2 ? h[i - 2].str() ++ "," ++ h[i - 1].str() : h[i - 3].str() ++ "," ++ h[i - 2].str() ++ "," ++ h[i - 1].str();
  def svs-ng-note(idx, h, i) {
   let a = i >= 1 ? record_set(idx, svs-ng-key(h, i, 1), i) : 0;
   let b = i >= 2 ? record_set(idx, svs-ng-key(h, i, 2), i) : 0;
   let c = i >= 3 ? record_set(idx, svs-ng-key(h, i, 3), i) : 0;
