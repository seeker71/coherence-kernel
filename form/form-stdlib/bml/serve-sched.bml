   let lim = map(i => len(props[i]) < lims[i] ? len(props[i]) : lims[i], range(0, n));
   let ks = svs-assign-go(map(i => 0, range(0, n)), rates, lim, rates, width - n, floor);
   map(i => take(ks[i], props[i]), range(0, n));
