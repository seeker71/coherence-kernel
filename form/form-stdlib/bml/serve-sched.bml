   [append(S[0], [v1]), S[1], filter(x => (String) x[0] != (String) v[0], S[2]), S[3], S[4], S[5]];
  }
  // a sequence takes its row's greedy id: the end of turn ends it (and is no part of its reply); else the id is its reply's next, and it ends at a
  // stop string or at the count its caller named: no position of its own is its last
  def svs-advance(s, r, env, t) = svs-eos-call(env, r[0]) ? svs-finish(s, "stop", t) : svs-advance-id(svs-put(svs-put(svs-put(svs-put(svs-put(s, 9, cons(r[0], s[9])), 17, s[17] + 1), 14, s[14] + r[1]), 10, r[0]), 11, s[11] + 1), env, t);
  def svs-advance-id(s, env, t) = svs-stop-call(env, s) ? svs-finish(s, "stop-string", t) : s[4] > 0 && s[17] >= s[4] ? svs-finish(s, "length", t) : svs-loop-react(s, t);
  // ── a repeating answer is a signal the sequence answers inline, never a count it is cut at ──
  // Every 8 ids the tail of what a sequence has said is read for a period p (1..64) that its last three periods repeat exactly. A greedy sequence that repeats is
  // given a draw (temperature 700 milli, seed loop-marker): the repetition is the greedy path's attractor and a draw leaves it, the sequence keeps its place, its blocks
  // and its context. A sequence that drew and has stopped repeating goes back to greedy. One that still repeats after 64 more ids has said all it will say: it ends as
  // "adapted-repeat" with what it said (the client delivers it, the caller's own signals say it was surprised, and the rented guidance is for it).
