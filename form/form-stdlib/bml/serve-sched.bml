  }
  // the rows of the verify pass: [slot, pending id, position, temperature, seed, tokens said, blocks, drafts] a live sequence, in the order of the live list
  def svs-verify-rows(S, ds) = map(i => [S[2][i][7], S[2][i][10], S[2][i][11], S[2][i][22], S[2][i][23], S[2][i][17], S[2][i][24], ds[i]], range(0, len(S[2])));
  // a row that decoded one id in a server that speculates keeps its history (and its acceptance drifts toward the try again)
  def svs-advance-plain(s, r, env, t) {
   let s1 = svs-advance(s, r, env, t);
   (String) s1[6] == "done" || nil?(s1[27]) ? s1 : svs-put(svs-put(s1, 27, svs-ng-grow(s1[27], [r[0]])), 28, svs-rate(s1[28], 0, 0));
  }
  // a row after the verify pass: the ids it accepted one after another (the end of turn, a stop string or its count ends it there and the rest are no part of it), its acceptance and tallies, its history
  def svs-advance-spec(s, res, env, t) {
