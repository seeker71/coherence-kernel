  def svs-assign-go(ks, gn, lim, rates, free, floor) {
   let n = len(ks);
   let best = foldl((b, i) => ks[i] < lim[i] && (b < 0 || gn[i] > gn[b]) ? i : b, -1, range(0, n));
   free <= 0 || best < 0 || gn[best] < floor ? ks : svs-assign-go(map(i => i == best ? ks[i] + 1 : ks[i], range(0, n)), map(i => i == best ? gn[i] * rates[i] / 1000 : gn[i], range(0, n)), lim, rates, free - 1, floor);
