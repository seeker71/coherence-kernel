  def svs-tok-s10(s) = svs-decode-ms(s) <= 0 ? 0 : s[17] * 10000 / svs-decode-ms(s);
  def svs-model-field(s) = len(s) > 32 && len(s[32]) > 0 ? [svs-s("model", s[32])] : [];
  def svs-fields(s, at_unix_ms) = append(svs-model-field(s), svs-fields-core(s, at_unix_ms));
  def svs-fields-core(s, at_unix_ms) = [svs-s("id", s[0]), svs-s("who", s[18]),svs-s("status", s[15]), svs-n("priority", s[1]), svs-n("prompt_ids", len(s[25])), svs-n("cached_ids", s[21]), svs-n("yields", s[26]), svs-n("drafts_tried", s[29]), svs-n("drafts_accepted", s[30]), svs-n("temperature_milli", s[22]), svs-n("generated_ids", s[17]), svs-n("wall_ms", s[19] - s[2]), svs-n("queue_ms", s[12] - s[2]), svs-n("prefill_ms", s[16]), svs-n("decode_ms", svs-decode-ms(s)), json-node-pair("decode_tok_s", json-node-float-text(svs-tenths(svs-tok-s10(s)))), svs-n("surprise_micro_nats", s[17] > 0 ? s[14] / s[17] : 0), svs-n("slot", s[7]), svs-n("rent_tokens", 0), svs-n("at_unix_ms", at_unix_ms)];
  def svs-ledger-row(s, at_unix_ms) = json-emit(json-node-object(svs-fields(s, at_unix_ms)));
  def svs-reply-row(s, text, at_unix_ms) = json-emit(json-node-object(append(svs-fields(s, at_unix_ms), [svs-s("text", text)])));
  def svs-refused-row(fid, why, at_unix_ms) = json-emit(json-node-object([svs-s("id", fid), svs-s("status", "refused"), svs-s("reason", why), svs-n("generated_ids", 0), svs-n("rent_tokens", 0), svs-n("at_unix_ms", at_unix_ms), svs-s("text", "")]));
  // the reply's text ends at the earliest stop string the caller named (the stop string itself is no part of it)
  def svs-cut-at(text, stops) = foldl((a, st) => len(st) == 0 ? a : (str_find(text, st, 0) >= 0 && (a < 0 || str_find(text, st, 0) < a)) ? str_find(text, st, 0) : a, -1, stops);
  def svs-trim-stop(text, stops) = svs-cut-at(text, stops) < 0 ? text : substring(text, 0, svs-cut-at(text, stops));
  // a status line the server keeps for the clients and for a person: [pid, rows, live, queued, prefilling, the pool's blocks in use, its blocks, positions a block holds]
  def svs-status-row(S, pid, start, label, at_unix_ms, used, blocks, bsz) = json-emit(json-node-object([svs-n("pid", pid), svs-n("start", start), svs-s("label", label), svs-n("slots", S[5]), svs-n("blocks_used", used), svs-n("blocks", blocks), svs-n("block_positions", bsz), svs-n("live", len(S[2])), svs-n("queued", len(S[0])), svs-n("prefilling", len(S[1])), svs-n("at_unix_ms", at_unix_ms)]));
 }
 0;
}
