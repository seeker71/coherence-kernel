  // ── the reply and the ledger row ──
  def svs-s(k, v) = json-node-pair(k, json-node-string(v));
  def svs-n(k, v) = json-node-pair(k, json-node-int(v));
  def svs-tenths(x10) = (x10 / 10).str() ++ "." ++ (x10 % 10).str();
  def svs-decode-ms(s) = s[19] - s[13] < 0 ? 0 : s[19] - s[13];
