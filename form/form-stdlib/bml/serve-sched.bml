   (String) s2[6] == "done" || nil?(s2[27]) ? s2 : svs-put(s2, 27, svs-ng-grow(s2[27], take(taken, res[0])));
  }
  def svs-advance-many(s, ids, lps, env, t) = nil?(ids) || (String) s[6] == "done" ? s : svs-advance-many(svs-advance(s, [ids[0], lps[0]], env, t), ids[1:], lps[1:], env, t);
  // ── the row's own text as a drafter: what followed the last time its last few ids occurred ──
  // state: [the ids (the last svs-ng-window or so of the prompt and the reply), an index record: the key of the 1, 2 and 3 ids before a position -> that position (the latest)]. The suffix at the end
  // is not indexed until the next id arrives, so a lookup finds an EARLIER occurrence, never itself.
  def svs-ng-window() = 4096;
  def svs-ng-new(ids) {
   let h = len(ids) > svs-ng-window() ? drop(len(ids) - svs-ng-window(), ids) : ids;
