  def svs-ng-index(idx, h, i, n) = i >= n ? 0 : { let a = svs-ng-note(idx, h, i); svs-ng-index(idx, h, i + 1, n); };
  def svs-ng-grow(state, ids) {
   let h = append(state[0], ids);
