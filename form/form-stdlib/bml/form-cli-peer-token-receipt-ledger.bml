//////////////////////////////////////////////////////////////////////
// form-cli-peer-token-receipt-ledger.bml -- retained, typed comparison
// memory for a live Form resident.
//
// The ledger holds only redacted accounting receipts.  It is never a prompt,
// answer, transcript, path, or provider client.  A provider receipt can join
// a local receipt only through the canonical Form task node.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/bml/form-cli-remote-token-evidence.bml form-stdlib/bml/form-cli-embodied-goal-grammar.bml

section [form.bml] {
    class FormCliPeerTokenReceiptLedger {
        field TokenReceiptLedgerTag = "form-cli-peer-token-receipt-ledger-v1";
        field TokenReceiptComparisonTag = "form-cli-peer-token-comparison-v1";
        field TokenReceiptOpen = "<|form:token-receipt|>\n";
        field TokenReceiptClose = "\n<|/form:token-receipt|>";
        field TokenReceiptFrameOpen = "<|form:remote-token-comparison|>\n";
        field TokenReceiptFrameClose = "\n<|/form:remote-token-comparison|>";

        def fcptrl-tag() = TokenReceiptLedgerTag();
        def fcptrl-comparison-tag() = TokenReceiptComparisonTag();
        def fcptrl-empty() = list(fcptrl-tag(), list());
        def fcptrl-entries(ledger) = nth(ledger, 1);
        def fcptrl-ledger?(ledger) = if nothing?(ledger) then 0 else if not(eq(len(ledger), 2)) then 0 else str_eq(nth(ledger, 0), fcptrl-tag());
        def fcptrl-admit(ledger, receipt) = if or(eq(fcptrl-ledger?(ledger), 0), eq(frte-receipt?(receipt), 0)) then ledger else list(fcptrl-tag(), cons(receipt, fcptrl-entries(ledger)));
        def fcptrl-canonical?(receipt) = if eq(frte-receipt?(receipt), 0) then 0 else if not(node_eq(frte-receipt-task-node(receipt), fcpdag-embodied-goal-node())) then 0 else if or(eq(frte-local-direct?(receipt), 1), eq(frte-provider-baseline?(receipt), 1)) then 1 else 0;
        def fcptrl-receipt-frame(receipt) = if eq(fcptrl-canonical?(receipt), 0) then "" else str_concat(TokenReceiptOpen(), str_concat(fcptrl-line("goal", "embodied-v1"), str_concat("\n", str_concat(fcptrl-line("source", frte-receipt-source(receipt)), str_concat("\n", str_concat(fcptrl-line("provider-calls", int_to_str(frte-receipt-provider-calls(receipt))), str_concat("\n", str_concat(fcptrl-line("remote-tokens", int_to_str(frte-receipt-remote-tokens(receipt))), str_concat("\nsettled=1", TokenReceiptClose())))))))));
        def fcptrl-last-at(text, marker, at, last) = if lt(str_find(text, marker, at), 0) then last else fcptrl-last-at(text, marker, add(str_find(text, marker, at), str_len(marker)), str_find(text, marker, at));
        def fcptrl-last-before(text, marker, at) = fcptrl-last-at(substring(text, 0, at), marker, 0, -1);
        // An outer receipt comes after the preceding contribution closed, never
        // after its response opened. This keeps model-shaped marker bytes inert.
        def fcptrl-outer-at?(text, at) {
            let response = fcptrl-last-before(text, "<|form:response|>", at);
            let closed = fcptrl-last-before(text, "<|/form:peer-contribution|>", at);
            if lt(response, 0) then 1 else if gt(closed, response) then 1 else 0;
        }
        def fcptrl-canonical-nonnegative?(text) = if not(str_eq(int_to_str(str_to_int(text)), text)) then 0 else if lt(str_to_int(text), 0) then 0 else 1;
        def fcptrl-between(text, prefix, suffix) {
            let start = str_find(text, prefix, 0);
            let from = add(start, str_len(prefix));
            let end = str_find(text, suffix, from);
            if or(lt(start, 0), lt(end, from)) then "" else substring(text, from, end);
        }
        def fcptrl-frame-receipt(body) {
            let source = fcptrl-between(body, "goal=embodied-v1\nsource=", "\nprovider-calls=");
            let calls = fcptrl-between(body, "\nprovider-calls=", "\nremote-tokens=");
            let tokens = fcptrl-between(body, "\nremote-tokens=", "\nsettled=1");
            if or(not(str_eq(substring(body, 0, str_len("goal=embodied-v1\nsource=")), "goal=embodied-v1\nsource=")), not(str_eq(substring(body, sub(str_len(body), str_len("\nsettled=1")), str_len(body)), "\nsettled=1"))) then nothing() else if or(not(fcptrl-canonical-nonnegative?(calls)), not(fcptrl-canonical-nonnegative?(tokens))) then nothing() else if and(str_eq(source, frte-local-direct-source()), and(eq(str_to_int(calls), 0), eq(str_to_int(tokens), 0))) then frte-receipt(fcpdag-embodied-goal-node(), 1, source, 0, 0) else if and(str_eq(source, frte-provider-source()), and(gt(str_to_int(calls), 0), gt(str_to_int(tokens), 0))) then frte-receipt(fcpdag-embodied-goal-node(), 1, source, str_to_int(calls), str_to_int(tokens)) else nothing();
        }
        def fcptrl-recover-admitted(text, body-start, close, ledger) {
            let receipt = if eq(fcptrl-outer-at?(text, sub(body-start, str_len(TokenReceiptOpen()))), 1) then fcptrl-frame-receipt(substring(text, body-start, close)) else nothing();
            fcptrl-recover-go(text, add(close, str_len(TokenReceiptClose())), fcptrl-admit(ledger, receipt));
        }
        def fcptrl-recover-go(text, at, ledger) {
            let start = str_find(text, TokenReceiptOpen(), at);
            let body-start = add(start, str_len(TokenReceiptOpen()));
            let close = if lt(start, 0) then -1 else str_find(text, TokenReceiptClose(), body-start);
            if lt(start, 0) then ledger else if lt(close, body-start) then ledger else fcptrl-recover-admitted(text, body-start, close, ledger);
        }
        def fcptrl-recover(text) = if nothing?(text) then fcptrl-empty() else fcptrl-recover-go(text, 0, fcptrl-empty());
        def fcptrl-find-local(rows, provider) = if eq(len(rows), 0) then nothing() else if and(eq(frte-local-direct?(head(rows)), 1), eq(frte-same-task?(provider, head(rows)), 1)) then head(rows) else fcptrl-find-local(tail(rows), provider);
        def fcptrl-comparison(ledger, provider) {
            let local = if eq(fcptrl-ledger?(ledger), 1) then fcptrl-find-local(fcptrl-entries(ledger), provider) else nothing();
            if or(eq(frte-provider-baseline?(provider), 0), nothing?(local)) then nothing() else if eq(frte-comparable?(provider, local), 0) then nothing() else list(fcptrl-comparison-tag(), frte-receipt-task-node(provider), local, provider, frte-ratio-bps(provider, local), frte-local-direct-under-ten-percent?(provider, local));
        }
        def fcptrl-comparison?(value) = if nothing?(value) then 0 else if not(eq(len(value), 6)) then 0 else str_eq(nth(value, 0), fcptrl-comparison-tag());
        def fcptrl-local(value) = nth(value, 2);
        def fcptrl-provider(value) = nth(value, 3);
        def fcptrl-ratio-bps(value) = nth(value, 4);
        def fcptrl-under-ten-percent?(value) = nth(value, 5);
        def fcptrl-line(name, value) = str_concat(name, str_concat("=", value));
        def fcptrl-frame(value) = if eq(fcptrl-comparison?(value), 0) then "" else str_concat(TokenReceiptFrameOpen(), str_concat(fcptrl-line("source", "settled-provider-vs-local-direct"), str_concat("\n", str_concat(fcptrl-line("provider-calls", int_to_str(frte-receipt-provider-calls(fcptrl-provider(value)))), str_concat("\n", str_concat(fcptrl-line("remote-tokens", int_to_str(frte-receipt-remote-tokens(fcptrl-provider(value)))), str_concat("\n", str_concat(fcptrl-line("ratio-bps", int_to_str(fcptrl-ratio-bps(value))), str_concat("\n", str_concat(fcptrl-line("under-ten-percent", int_to_str(fcptrl-under-ten-percent?(value))), TokenReceiptFrameClose()))))))))));
    }
    0;
}
