//////////////////////////////////////////////////////////////////////
// form-cli-peer-token-receipt-ledger.bml -- retained, typed comparison
// memory for a live Form resident.
//
// The ledger holds only redacted accounting receipts.  It is never a prompt,
// answer, transcript, path, or provider client.  A provider receipt can join
// a local receipt only through the canonical Form task node.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/bml/form-cli-remote-token-evidence.bml form-stdlib/bml/form-cli-embodied-goal-grammar.bml

section [form.bml] {
    class FormCliPeerTokenReceiptLedger {
        field TokenReceiptLedgerTag = "form-cli-peer-token-receipt-ledger-v1";
        field TokenReceiptComparisonTag = "form-cli-peer-token-comparison-v1";
        field TokenReceiptOpen = "<|form:token-receipt|>\n";
        field TokenReceiptClose = "\n<|/form:token-receipt|>";
        field TokenReceiptFrameOpen = "<|form:remote-token-comparison|>\n";
        field TokenReceiptFrameClose = "\n<|/form:remote-token-comparison|>";

        def fcptrl-tag() = TokenReceiptLedgerTag();
        def fcptrl-comparison-tag() = TokenReceiptComparisonTag();
        def fcptrl-empty() = list(fcptrl-tag(), list());
        def fcptrl-entries(ledger) = ledger[1];
        def fcptrl-ledger?(ledger) = nothing?(ledger) ? 0 : !((Comparable) len(ledger) == 2) ? 0 : ((String) ledger[0] == fcptrl-tag());
        def fcptrl-admit(ledger, receipt) = ((Comparable) fcptrl-ledger?(ledger) == 0) || ((Comparable) frte-receipt?(receipt) == 0) ? ledger : list(fcptrl-tag(), cons(receipt, fcptrl-entries(ledger)));
        def fcptrl-canonical?(receipt) = (Comparable) frte-receipt?(receipt) == 0 ? 0 : !node_eq(frte-receipt-task-node(receipt), fcpdag-embodied-goal-node()) ? 0 : ((Comparable) frte-local-direct?(receipt) == 1) || ((Comparable) frte-provider-baseline?(receipt) == 1) ? 1 : 0;
        def fcptrl-receipt-frame(receipt) = (Comparable) fcptrl-canonical?(receipt) == 0 ? "" : TokenReceiptOpen() ++ fcptrl-line("goal", "embodied-v1") ++ "\n" ++ fcptrl-line("source", frte-receipt-source(receipt)) ++ "\n" ++ fcptrl-line("provider-calls", int_to_str(frte-receipt-provider-calls(receipt))) ++ "\n" ++ fcptrl-line("remote-tokens", int_to_str(frte-receipt-remote-tokens(receipt))) ++ "\nsettled=1" ++ TokenReceiptClose();
        def fcptrl-last-at(text, marker, at, last) = str_find(text, marker, at) < 0 ? last : fcptrl-last-at(text, marker, str_find(text, marker, at) + str_len(marker), str_find(text, marker, at));
        def fcptrl-last-before(text, marker, at) = fcptrl-last-at(substring(text, 0, at), marker, 0, -1);
        // An outer receipt comes after the preceding contribution closed, never
        // after its response opened. This keeps model-shaped marker bytes inert.
        def fcptrl-outer-at?(text, at) {
            let response = fcptrl-last-before(text, "<|form:response|>", at);
            let closed = fcptrl-last-before(text, "<|/form:peer-contribution|>", at);
            response < 0 ? 1 : closed > response ? 1 : 0;
        }
        def fcptrl-canonical-nonnegative?(text) = !((String) int_to_str(str_to_int(text)) == text) ? 0 : str_to_int(text) < 0 ? 0 : 1;
        def fcptrl-between(text, prefix, suffix) {
            let start = str_find(text, prefix, 0);
            let from = start + str_len(prefix);
            let end = str_find(text, suffix, from);
            (start < 0) || (end < from) ? "" : substring(text, from, end);
        }
        def fcptrl-frame-receipt(body) {
            let source = fcptrl-between(body, "goal=embodied-v1\nsource=", "\nprovider-calls=");
            let calls = fcptrl-between(body, "\nprovider-calls=", "\nremote-tokens=");
            let tokens = fcptrl-between(body, "\nremote-tokens=", "\nsettled=1");
            (!((String) substring(body, 0, str_len("goal=embodied-v1\nsource=")) == "goal=embodied-v1\nsource=")) || (!((String) substring(body, str_len(body) - str_len("\nsettled=1"), str_len(body)) == "\nsettled=1")) ? nothing() : (!fcptrl-canonical-nonnegative?(calls)) || (!fcptrl-canonical-nonnegative?(tokens)) ? nothing() : ((String) source == frte-local-direct-source()) && (((Comparable) str_to_int(calls) == 0) && ((Comparable) str_to_int(tokens) == 0)) ? frte-receipt(fcpdag-embodied-goal-node(), 1, source, 0, 0) : ((String) source == frte-provider-source()) && ((str_to_int(calls) > 0) && (str_to_int(tokens) > 0)) ? frte-receipt(fcpdag-embodied-goal-node(), 1, source, str_to_int(calls), str_to_int(tokens)) : nothing();
        }
        def fcptrl-recover-admitted(text, body-start, close, ledger) {
            let receipt = (Comparable) fcptrl-outer-at?(text, body-start - str_len(TokenReceiptOpen())) == 1 ? fcptrl-frame-receipt(substring(text, body-start, close)) : nothing();
            fcptrl-recover-go(text, close + str_len(TokenReceiptClose()), fcptrl-admit(ledger, receipt));
        }
        def fcptrl-recover-go(text, at, ledger) {
            let start = str_find(text, TokenReceiptOpen(), at);
            let body-start = start + str_len(TokenReceiptOpen());
            let close = start < 0 ? -1 : str_find(text, TokenReceiptClose(), body-start);
            start < 0 ? ledger : close < body-start ? ledger : fcptrl-recover-admitted(text, body-start, close, ledger);
        }
        def fcptrl-recover(text) = nothing?(text) ? fcptrl-empty() : fcptrl-recover-go(text, 0, fcptrl-empty());
        def fcptrl-find-local(rows, provider) = (Comparable) len(rows) == 0 ? nothing() : ((Comparable) frte-local-direct?(head(rows)) == 1) && ((Comparable) frte-same-task?(provider, head(rows)) == 1) ? head(rows) : fcptrl-find-local(tail(rows), provider);
        def fcptrl-comparison(ledger, provider) {
            let local = (Comparable) fcptrl-ledger?(ledger) == 1 ? fcptrl-find-local(fcptrl-entries(ledger), provider) : nothing();
            ((Comparable) frte-provider-baseline?(provider) == 0) || nothing?(local) ? nothing() : (Comparable) frte-comparable?(provider, local) == 0 ? nothing() : list(fcptrl-comparison-tag(), frte-receipt-task-node(provider), local, provider, frte-ratio-bps(provider, local), frte-local-direct-under-ten-percent?(provider, local));
        }
        def fcptrl-comparison?(value) = nothing?(value) ? 0 : !((Comparable) len(value) == 6) ? 0 : ((String) value[0] == fcptrl-comparison-tag());
        def fcptrl-local(value) = value[2];
        def fcptrl-provider(value) = value[3];
        def fcptrl-ratio-bps(value) = value[4];
        def fcptrl-under-ten-percent?(value) = value[5];
        def fcptrl-line(name, value) = name ++ "=" ++ value;
        def fcptrl-frame(value) = (Comparable) fcptrl-comparison?(value) == 0 ? "" : TokenReceiptFrameOpen() ++ fcptrl-line("source", "settled-provider-vs-local-direct") ++ "\n" ++ fcptrl-line("provider-calls", int_to_str(frte-receipt-provider-calls(fcptrl-provider(value)))) ++ "\n" ++ fcptrl-line("remote-tokens", int_to_str(frte-receipt-remote-tokens(fcptrl-provider(value)))) ++ "\n" ++ fcptrl-line("ratio-bps", int_to_str(fcptrl-ratio-bps(value))) ++ "\n" ++ fcptrl-line("under-ten-percent", int_to_str(fcptrl-under-ten-percent?(value))) ++ TokenReceiptFrameClose();
    }
    0;
}
