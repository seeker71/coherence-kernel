// Shared response assessment and retained-evidence boundaries.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class FormCliResponseShared {
  def frsh-request-valid(request) = (fcaq-request-valid(request) && (fcaq-evaluation(request) && (((String) fcap-string(request,"resume") == "") && ((String) fat-wire-error(fat-wire-documents(request)) == ""))));
  def frsh-path(root,name) = str_concat(root,str_concat("/",name));
  def frsh-supervision-valid(provider) = (fcad-int(json-object-get(provider,"seconds")) && (fcaq-number(provider,"seconds",-1) >= 0));
  def frsh-write-confirmed(written,present,actual,expected) = ((written >= 0) && (present && ((String) actual == expected)));
  def frsh-frozen(path,text) {
   let saved = write_file(path,text);
   if frsh-write-confirmed(saved,fs-exists?(path),read_file(path),text) then 1 else form_error("response evidence write failed, is absent, or differs after write");
  }
 }
 0;
}
