// offline-voice-gaps.bml — the gap register: every gap on the way to 100% offline voice, read as data and answered
// closed, open or unread, each with the numbers it read and the file it read them from. No model opens, no network.
//
// The gaps are rows of learn/offline-voice-gaps.jsonl; the reading rule lives in the row, never here:
//   id, title, goal        the gap and the goal line it serves (all queries native; all self-improvement features native;
//                          aligned voice; rent toward zero)
//   kind                   which reader (ovg-kinds names each kind's shape)
//   source, checkout       the file read; checkout "walk" resolves it inside the walk checkout the day-turn plist names
//   where, match           the tests a row must hold to count (where) or to be counted among those (match). A plain value is an
//                          equality; an object tests the field: {">":0} {">=":0} {"<":0} {"<=":0} a number; {"!=":v} absent or
//                          different; {"in":[v,..]} equal to one; {"has":s} a string holding s; {"absent":1} the key is not in the row;
//                          {"present":1} it is, not null; {"empty":1} absent, null or ""
//   since_ms               rows before that instant are history, outside the reading (the text names the window)
//   field, compare,        the field read, the comparison (==, !=, >=, <=, >, <) and what it is compared with: a
//   threshold | against    threshold (a number, or a string for a string field) or another field of the same row
//   also                   more comparisons the same row must hold: [{field, compare, threshold|against}, ..]
//   not_in                 {source, on}: the row's `on` value must appear in no row of that source
//   landed                 {not_source, gated}: a native source-changing landing on the ref must follow the row, or the gap reads open; gated 1: a gate must have run the band
//                          of each code file that landing touched as it landed, a gate row at its commit or the queued gaps' bands the landing read over its own tree
//                          (exit-proof.bml ep-unwitnessed): an edit no gate witnesses is not yet an improvement, and a landing that followed with one is named
//   spread                 (last) a field: the last row's margin (`against` less `field`) must exceed how far that field scatters over every
//                          row holding `where`, so a reading closes only when it separates from its siblings' noise; one row alone reads open
//   moved                  a field: the last row's value must first stand inside within_ms, read over the whole source, or the gap reads open
//   show                   fields of the row printed beside its verdict
//   within_ms              (last) the row must be younger than this, or the gap reads open; (share, sets, axis) only rows younger than this are read: a door that stopped
//                          running is not a door that runs, and a miss ages out once the lane answers again
//   by_schedule            1 (feature, share): a tracked ledger with no coordinator column reads only the rows native landings on the ref added inside within_ms (exit-proof.bml
//                          ep-landed-rows): a session's row, in this tree or landed under its own commit, is no row of the schedule, whatever its clock reads
//   left, right            (pair) the tests that choose the two sides, among the rows holding `where`
//   stood                  (landings) {days, gated}: a landing younger than days waits; a native one counts only when each line it added to source still stands on the ref and, gated 1, a gate ran the band of its code as it landed
//   next                   {band, step}: the band a closing movement answers to and the step toward it; observe/self-steer-run.bml offers it while the row stands open
//   on_slot                1: a file no landing carries (the walk's own .hearth): the row's time must stand in a slot's window, or the gap reads open
//   none_reads             "open": no row holding `where` is an open gap by its own name; absent, it reads unread
//   seam                   (share) a test at least one counted row must hold, so a seam that landed nothing never reads closed
//   before                 (first) {where, same}: every row holding before.where that stands ahead of the counted row must hold its `same` value, or the gap reads open, spoiled
//   row_key, against_key,  (table) a markdown table: the last row whose first cell is row_key, the column index read
//   column, threshold_milli  (0 is the first cell) as a decimal in milli, against the same column of the against_key row
//   days, grace_ms, stamp_within_ms  (schedule) the slots due in the last days, due grace_ms after their time, a stamp reading its slot within that
//   days, not_source       (landings) the commits on the ref in the last days; a path under a not_source prefix is no source
//   days, queue, guide     (gaps) the gaps of the queue and of the turns in the last days, against the guide ledger and the landings
//   sets, tags, axis, aliases  (sets, axis) the alignment set files under `sets`; the file that tags each predicate with its axis; the words it names this axis by
//   door, count_text       (feature) the door a step of the walk must begin; a marker in a text source counted instead of a row read
// One reader per shape, every kind dropping in as data:
//   last      the last row that holds `where`: `field` compared with threshold or `against`, and `also`
//   share     the rows that hold `where`: the permille of them that hold `match`, compared with threshold; with by_schedule, only the rows native landings added
//   first     the first row that holds `where`, judged as `last` judges: a held-out set's first reading, which a later reading never replaces; with
//             before {where, same}, a row holding before.where ahead of it under another `same` spoils it (open by name): a sealed set read first under another prompt
//   pair      the rows that hold `where` and are that young: the median of `field` over the `left` side compared with the `right` side, in milli; a side with no row reads by none_reads
//   rent      rented tokens the sessions' rows grew by inside the last days, against the threshold; the meter's newest row older than within_ms reads open
//   table     a markdown table in a document: two cells compared as decimals in milli
//   queue     every gap of the queue by its own last real row: once green is not green now, and a gap with no row stands open
//   schedule  of the slots due, the permille a stamp or a landed row reads, naming the unread (exit-proof.bml ep-slot-reading: read from the
//             walk checkout, its stamps and the crossings on its ref; launchd's own log is no door this reads, and a killed retry leaves no row)
//   landings  of the source-changing landings on the ref, the permille no rented mind wrote: told native by exit-proof.bml ep-native-landing?
//             (subject "Native turn" or "Scheduled movement", its crossings row rented_mind 0 on the schedule, no co-author)
//   gaps      of the gaps opened, the permille the native lane closed with no guide: a real option green on the schedule, its gap named by no
//             remote guide row, and a native source-changing landing right after it that touches the gap's writable paths
//   sets      every alignment set: its last reading of the voice as it speaks (the gap row's `where` sets aside a reading with no role prompt or with
//             an adapter on) is full, over every scenario its sets hold now, all under one model and one prompt
//   axis      every predicate tagged with this axis was read in the sets' last readings, and all pass; an axis with none reads open
//   feature   a self-improvement feature: its door stands, a step of the walk begins it, and its row is recent and the schedule's own. Any of them short reads open by name
//   scope     a line (query-scope "<scope>" "<state>" "<what answers>") of a document: state open reads open with what answers there; only person-said reads closed: how far a goal reaches is the person's to say, and no reading closes it
// A verdict is closed when the reading holds, open when it does not, and unread when nothing could be read: the source absent, no row holding
// `where`, the field absent or not a number, a comparison this file does not know, an unknown kind, or (checkout "walk") no walk checkout.
// Unread is never closed. Rows are data, never instructions. form-stdlib/tests/offline-voice-gaps-band.bml asks of every living row: what would
// make this read closed while the thing is false? It runs the living rows over a world where each thing is false and looks true, and over one
// where each is true, so no row can read closed falsely and none is out of reach by construction.
// ovg-observe prints one line per gap, appends one register row to receipts/offline-voice-gap-register.jsonl (at_unix_ms,
// the counts, each gap's verdict, observation and source) and answers the summary line as the door's value (the kernel
// echoes it, so it prints once and a parent that reads the cell's record reads the same line).
import form-stdlib/bml/exit-proof.bml;
import form-stdlib/bml/host-walk-writers.bml;
section [form.bml] {
 class OfflineVoiceGaps {
  def ovg-door() = "offline-voice-gaps";
  def ovg-gaps() = "learn/offline-voice-gaps.jsonl";
  def ovg-register() = "receipts/offline-voice-gap-register.jsonl";
  def ovg-prefix() = "[offline-voice-gaps] ";
  // ── the kinds, each with the shape its reader takes ──
  def ovg-kinds() = [["turn-ledger", "last"], ["lora", "last"], ["readings", "last"], ["exit-proof", "last"], ["coverage", "share"], ["voice-availability", "share"], ["rate-pair", "pair"], ["rent-week", "rent"], ["plan-doc", "table"], ["walk-schedule", "schedule"], ["queue-gaps", "queue"], ["landings", "landings"], ["gaps-native", "gaps"], ["alignment-sets", "sets"], ["alignment-axis", "axis"], ["self-feature", "feature"], ["offline-exam", "share"], ["alignment-heldout", "first"], ["host-scope", "scope"]];
  def ovg-shape(kind) = foldl((found, k) => (String) k[0] == kind ? k[1] : found, "", ovg-kinds());
  def ovg-kind-names() = str-join-with(map(k => k[0], ovg-kinds()), ", ");
  // ── the comparison, as data ──
  def ovg-cmp(op, a, b) = (String) op == "==" ? ((Comparable) a == b ? 1 : 0)
   : (String) op == "!=" ? ((Comparable) a == b ? 0 : 1)
   : (String) op == ">=" ? (a >= b ? 1 : 0)
   : (String) op == "<=" ? (a <= b ? 1 : 0)
   : (String) op == ">" ? (a > b ? 1 : 0)
   : (String) op == "<" ? (a < b ? 1 : 0)
   : nothing();
  def ovg-cmp-str(op, a, b) = (String) op == "==" ? ((String) a == b ? 1 : 0) : (String) op == "!=" ? ((String) a == b ? 0 : 1) : nothing();
  def ovg-verdict(ok) = nothing?(ok) ? "unread" : (Comparable) ok == 1 ? "closed" : "open";
  def ovg-op-note(ok, op) = nothing?(ok) ? "; comparison \"" ++ op ++ "\" unknown" : "";
  // ── the tests a row must hold: `where` and `match` ──
  def ovg-keys(obj) = map(p => json-pair-key(p), json-object-pairs(obj));
  def ovg-object?(n) = fcgp-object?(n);
  def ovg-test?(row, key, op, want) = (String) op == "absent" ? !json-object-has?(row, key)
   : (String) op == "present" ? fcgp-present?(row, key)
   : (String) op == "empty" ? (!fcgp-present?(row, key)) || node_eq(json-object-get(row, key), json-node-string(""))
   : (String) op == "!=" ? (!json-object-has?(row, key)) || !node_eq(json-object-get(row, key), want)
   : (String) op == "in" ? json-object-has?(row, key) && any?(w => node_eq(json-object-get(row, key), w), json-array-elements(want))
   : (String) op == "has" ? str_find(fcgp-str(row, key), json-string-value(want), 0) >= 0
   : ovg-test-num?(fcgp-num(row, key), op, want);
  def ovg-test-num?(v, op, want) = nothing?(v) ? false : (Comparable) (ovg-cmp(op, v, json-int-value(want)) ?? 0) == 1;
  def ovg-holds?(row, obj, key) {
   let want = json-object-get(obj, key);
   ovg-object?(want) ? all?(p => ovg-test?(row, key, json-pair-key(p), json-pair-value(p)), json-object-pairs(want)) : json-object-has?(row, key) && node_eq(json-object-get(row, key), want);
  }
  def ovg-matches?(row, obj) = all?(k => ovg-holds?(row, obj, k), ovg-keys(obj));
  // a gap row may carry since_ms: rows before that instant are history, outside its reading (the text names the window)
  def ovg-since?(gap, r) = nothing?(fcgp-num(gap, "since_ms")) ? true : ((fcgp-num(r, "at_unix_ms") ?? 0) >= fcgp-num(gap, "since_ms"));
  def ovg-where(gap, rows) = filter(r => ovg-matches?(r, fcgp-obj(gap, "where")) && ovg-since?(gap, r), rows);
  def ovg-obj-text(obj) = str-join-with(map(k => k ++ " " ++ json-emit(json-object-get(obj, k)), ovg-keys(obj)), ", ");
  def ovg-since-text(gap) = nothing?(fcgp-num(gap, "since_ms")) ? "" : " since " ++ fcgp-num(gap, "since_ms").str();
  def ovg-where-text(gap) = (nil?(ovg-keys(fcgp-obj(gap, "where"))) ? "" : " where " ++ ovg-obj-text(fcgp-obj(gap, "where"))) ++ ovg-since-text(gap);
  def ovg-none-verdict(gap) = (String) fcgp-str(gap, "none_reads") == "open" ? "open" : "unread";
  def ovg-none(gap, rows) = [ovg-none-verdict(gap), "no row" ++ ovg-where-text(gap) ++ " among " ++ len(rows).str() ++ " row(s)"];
  def ovg-at(row) = nothing?(fcgp-num(row, "at_unix_ms")) ? "" : ", at " ++ fcgp-num(row, "at_unix_ms").str();
  def ovg-place(gap, mine, rows) = " (the last of " ++ len(mine).str() ++ " row(s)" ++ ovg-where-text(gap) ++ ((Comparable) len(mine) == len(rows) ? "" : " of " ++ len(rows).str()) ++ ovg-at(mine[-1]) ++ ")";
  // ── last: the last row that holds `where` ──
  def ovg-now(opts) = fcgp-num(opts, "now_ms") ?? now_unix_ms();
  def ovg-zone(opts) = fcgp-num(opts, "zone_ms") ?? hw-zone-ms();
  def ovg-read-last(gap, rows, opts) {
   let mine = ovg-where(gap, rows);
   nil?(mine) ? ovg-none(gap, rows) : ovg-with-spread(gap, mine, ovg-fresh(gap, mine[-1], ovg-place(gap, mine, rows), opts));
  }
  // spread: the last row's margin (`against` less `field`) must be wider than the spread of `spread` over its siblings, the
  // earlier rows holding `where`, so a child closes only when it stands apart from how far they scatter; the last row stands
  // outside the noise it is read against, so a child far better than its siblings never widens their spread itself. Fewer
  // than two siblings read no noise
  def ovg-with-spread(gap, mine, r) = (String) fcgp-str(gap, "spread") == "" ? r : ovg-spread-joined(r, ovg-spread-read(gap, mine[-1], take(len(mine) - 1, mine)));
  def ovg-spread-joined(r, s) = [ovg-worst([r, s]), r[1] ++ "; " ++ s[1]];
  def ovg-spread-read(gap, row, siblings) {
   let key = fcgp-str(gap, "spread");
   let vs = filter(v => !nothing?(v), map(x => fcgp-num(x, key), siblings));
   let margin = (fcgp-num(row, fcgp-str(gap, "against")) ?? 0) - (fcgp-num(row, fcgp-str(gap, "field")) ?? 0);
   let wide = len(vs) < 2 ? 0 : foldl((m, v) => v > m ? v : m, vs[0], vs) - foldl((m, v) => v < m ? v : m, vs[0], vs);
   len(vs) < 2 ? ["open", "fewer than two siblings read no noise: " ++ len(vs).str() ++ " earlier row(s) hold " ++ key] : ovg-judged(ovg-cmp(">", margin, wide), "margin " ++ margin.str() ++ " > spread " ++ wide.str() ++ " of " ++ key ++ " over " ++ len(vs).str() ++ " sibling row(s)", ">");
  }
  // moved: the last row's value of `moved` must first stand inside within_ms, read over the whole source: a count that stopped moving is a door re-reading what it read
  def ovg-moved-rule(gap, row, opts) = (String) fcgp-str(gap, "moved") == "" ? [] : [ovg-moved-read(gap, fcgp-str(gap, "moved"), row, opts)];
  def ovg-moved-read(gap, key, row, opts) {
   let v = fcgp-node(row, key);
   let first = foldl((found, x) => !nothing?(found) ? found : fcgp-present?(x, key) && node_eq(fcgp-node(x, key), v) ? x : found, nothing(), ovg-where(gap, fcgp-rows(ovg-path(gap, opts))));
   !fcgp-present?(row, key) ? ["unread", "field " ++ key ++ " absent"]
   : nothing?(first) ? ["unread", key ++ " " ++ json-emit(v) ++ " stands in no row of " ++ fcgp-str(gap, "source")]
   : ovg-stale?(gap, first, opts) ? ["open", key ++ " " ++ json-emit(v) ++ " has stood since " ++ fcgp-num(first, "at_unix_ms").str() ++ ", before the window: the rows re-read what did not move"]
   : ["closed", key ++ " " ++ json-emit(v) ++ " first stood at " ++ fcgp-num(first, "at_unix_ms").str()];
  }
  def ovg-stale?(gap, row, opts) = !nothing?(fcgp-num(gap, "within_ms")) && ((ovg-now(opts) - (fcgp-num(row, "at_unix_ms") ?? 0)) > fcgp-num(gap, "within_ms"));
  def ovg-fresh(gap, row, place, opts) = ovg-stale?(gap, row, opts) ? ["open", "the row is older than " ++ (fcgp-num(gap, "within_ms") / 3600000).str() ++ " hours" ++ place ++ ovg-show(gap, row)] : ovg-off-slot?(gap, row, opts) ? ["open", "the row stands outside every slot of the schedule, so the schedule did not write it" ++ place ++ ovg-show(gap, row)] : ovg-judge-whole(gap, row, place, opts);
  def ovg-off-slot?(gap, row, opts) = ((Comparable) (fcgp-num(gap, "on_slot") ?? 0) == 1) && !ep-in-a-slot?(fcgp-num(row, "at_unix_ms") ?? 0, ovg-zone(opts));
  def ovg-show(gap, row) = fcgp-present?(gap, "show") ? "; " ++ str-join-with(map(n => json-string-value(n) ++ " " ++ json-emit(fcgp-node(row, json-string-value(n))), json-array-elements(json-object-get(gap, "show"))), ", ") : "";
  def ovg-also(gap) = fcgp-present?(gap, "also") ? json-array-elements(json-object-get(gap, "also")) : [];
  // every comparison of the row: the worst verdict stands (open, then unread, then closed)
  def ovg-worst(results) = any?(r => (String) r[0] == "open", results) ? "open" : any?(r => (String) r[0] == "unread", results) ? "unread" : "closed";
  def ovg-judge-whole(gap, row, place, opts) {
   let first = ovg-judge(gap, row, place);
   let more = map(c => ovg-judge(c, row, ""), ovg-also(gap));
   let free = ovg-not-in(gap, row, opts);
   let landed = ovg-landed-rule(gap, row, opts);
   let all = append(append(append(cons(first, more), free), landed), ovg-moved-rule(gap, row, opts));
   [ovg-worst(all), str-join-with(map(r => r[1], all), "; ") ++ ovg-show(gap, row)];
  }
  // landed: a green row is not a landed edit: a native source-changing landing on the ref must follow it. Gated, that landing's touched code stands witnessed as it
  // landed (exit-proof.bml ep-unwitnessed); a native landing that followed with code no gate ran is named, and counts not
  def ovg-landed-rule(gap, row, opts) = nil?(ovg-keys(fcgp-obj(gap, "landed"))) ? [] : ovg-landed-read(fcgp-obj(gap, "landed"), row, opts);
  def ovg-landed-read(rule, row, opts) {
   let repo = ovg-repo(opts);
   let ref = ovg-ref(opts);
   let landings = ep-landings(repo, ref, (fcgp-num(row, "at_unix_ms") ?? 0) - 60000);
   let crossings = ovg-crossings(repo, ref);
   let zone = ovg-zone(opts);
   let gated = (Comparable) (fcgp-num(rule, "gated") ?? 0) == 1;
   nothing?(landings) || nothing?(crossings) || nothing?(zone) ? [["unread", "git or the crossings ledger did not read on " ++ ref ++ " in " ++ repo]]
   : ovg-landed-said(ref, gated, map(l => [l, gated ? ep-unwitnessed(repo, l) : []], filter(l => ovg-landed-after?(row, [l], []) && ep-native-landing?(l, crossings, zone) && ep-source-changing?(l, ovg-strings(rule, "not_source")), landings)));
  }
  // [landing, its code no gate witnessed] of each native landing that followed the row: one with none is the landed edit
  def ovg-landed-said(ref, gated, read) {
   let short = filter(p => !nil?(p[1]), read);
   any?(p => nil?(p[1]), read) ? [] : [["open", "no native source-changing landing on " ++ ref ++ (gated ? " whose touched code a gate's band reads" : "") ++ " followed it within " ++ (ovg-land-reach-ms() / 3600000).str() ++ " hours" ++ (nil?(short) ? "" : " (" ++ str-join-with(map(p => substring(p[0][0], 0, 9) ++ " touched " ++ str-join-with(p[1], ", "), ovg-take(3, short)), "; ") ++ ", whose band no gate ran as it landed)")]];
  }
  def ovg-not-in(gap, row, opts) {
   let rule = fcgp-obj(gap, "not_in");
   let on = fcgp-str(rule, "on");
   let path = (String) on == "" ? "" : ovg-under(opts, fcgp-str(rule, "source"));
   (String) on == "" ? [] : any?(r => (String) fcgp-str(r, on) == fcgp-str(row, on), ep-text-rows(path)) ? [["open", on ++ " \"" ++ fcgp-str(row, on) ++ "\" stands in " ++ fcgp-str(rule, "source")]] : [];
  }
  def ovg-string?(gap) = fcgp-str-node?(fcgp-node(gap, "threshold"));
  def ovg-judge(gap, row, place) {
   let field = fcgp-str(gap, "field");
   let op = fcgp-str(gap, "compare");
   !fcgp-present?(row, field) ? ["unread", "field " ++ field ++ " absent" ++ place]
   : ovg-string?(gap) ? ovg-judge-str(gap, row, field, op, place) : ovg-judge-num(gap, row, field, op, place);
  }
  def ovg-judge-str(gap, row, field, op, place) {
   let v = fcgp-str(row, field);
   let want = fcgp-str(gap, "threshold");
   let ok = ovg-cmp-str(op, v, want);
   [ovg-verdict(ok), field ++ " \"" ++ v ++ "\" " ++ op ++ " \"" ++ want ++ "\"" ++ place ++ ovg-op-note(ok, op)];
  }
  def ovg-judge-num(gap, row, field, op, place) {
   let v = fcgp-num(row, field);
   let against = fcgp-str(gap, "against");
   let want = (String) against == "" ? fcgp-num(gap, "threshold") : fcgp-num(row, against);
   nothing?(v) ? ["unread", "field " ++ field ++ " is not a number" ++ place]
   : nothing?(want) ? ["unread", ((String) against == "" ? "threshold absent" : "field " ++ against ++ " is not a number") ++ place]
   : ovg-judged(ovg-cmp(op, v, want), field ++ " " ++ v.str() ++ " " ++ op ++ " " ++ ((String) against == "" ? "" : against ++ " ") ++ want.str() ++ place, op);
  }
  def ovg-judged(ok, text, op) = [ovg-verdict(ok), text ++ ovg-op-note(ok, op)];
  // ── share: the permille of the rows holding `where` that also hold `match` ──
  def ovg-pm(part, whole) = (part * 1000) / whole;
  def ovg-within-text(gap) = nothing?(fcgp-num(gap, "within_ms")) ? "" : " inside the last " ++ (fcgp-num(gap, "within_ms") / 3600000).str() ++ " hours";
  def ovg-recent(gap, rows, opts) = nothing?(fcgp-num(gap, "within_ms")) ? rows : filter(r => !ovg-stale?(gap, r, opts), rows);
  def ovg-read-share(gap, rows, opts) = ovg-noted(ovg-share-reading(gap, rows, opts), ovg-unattributed(gap, rows, opts));
  def ovg-noted(r, note) = [r[0], r[1] ++ note];
  // a gap whose `where` names session: a row with no session column cannot say who asked; it is named, never counted
  def ovg-unattributed(gap, rows, opts) {
   let w = fcgp-obj(gap, "where");
   let bare = json-object-has?(w, "session") ? ovg-recent(gap, filter(r => !json-object-has?(r, "session") && ovg-since?(gap, r) && all?(k => (String) k == "session" || ovg-holds?(r, w, k), ovg-keys(w)), rows), opts) : [];
   nil?(bare) ? "" : "; " ++ len(bare).str() ++ " row(s) holding the rest of `where` carry no session column: unattributed, so uncounted";
  }
  // a gap whose `where` reads the schedule's and the person's rows (session "", or coordinated_by host-schedule): a row whose
  // line ended at launchd under no job the body names reads detached there (coordination.bml); it is named, never counted
  def ovg-schedule-word?(w, k) = json-object-has?(w, k) && ((String) json-emit(json-object-get(w, k)) == ((String) k == "session" ? "\"\"" : "\"host-schedule\""));
  def ovg-detached(gap, rows, opts) {
   let w = fcgp-obj(gap, "where");
   let keys = filter(k => ovg-schedule-word?(w, k), ["session", "coordinated_by"]);
   let held = nil?(keys) ? [] : ovg-recent(gap, filter(r => any?(k => (String) fcgp-str(r, k) == "detached", keys) && ovg-since?(gap, r) && all?(k => any?(x => (String) x == k, keys) || ovg-holds?(r, w, k), ovg-keys(w)), rows), opts);
   nil?(held) ? "" : "; " ++ len(held).str() ++ " row(s) holding the rest of `where` read detached: a line that ended at launchd under no job the body names, so uncounted";
  }
  def ovg-share-reading(gap, rows, opts) {
   let mine = ovg-recent(gap, ovg-where(gap, rows), opts);
   let m = fcgp-obj(gap, "match");
   let op = fcgp-str(gap, "compare");
   let want = fcgp-num(gap, "threshold");
   let seam = fcgp-obj(gap, "seam");
   nil?(mine) ? [ovg-none-verdict(gap), "no row" ++ ovg-where-text(gap) ++ ovg-within-text(gap) ++ " among " ++ len(rows).str() ++ " row(s)"]
   : nil?(ovg-keys(m)) ? ["unread", "no match rule in the gap row"]
   : nothing?(want) ? ["unread", "threshold absent in the gap row"]
   : (!nil?(ovg-keys(seam))) && (!any?(r => ovg-matches?(r, seam), mine)) ? ["unread", "the seam landed no row: none of " ++ len(mine).str() ++ " row(s)" ++ ovg-where-text(gap) ++ " holds " ++ ovg-obj-text(seam)]
   : ovg-share-of(gap, mine, m, op, want, len(filter(r => ovg-matches?(r, m), mine)));
  }
  def ovg-share-of(gap, mine, m, op, want, hits) = ovg-judged(ovg-cmp(op, ovg-pm(hits, len(mine)), want), hits.str() ++ " of " ++ len(mine).str() ++ " row(s)" ++ ovg-where-text(gap) ++ ovg-within-text(gap) ++ " hold " ++ ovg-obj-text(m) ++ ": " ++ ovg-pm(hits, len(mine)).str() ++ " pm " ++ op ++ " " ++ want.str(), op);
  // ── pair: the median of a field over two sides of the young rows, in milli ──
  def ovg-sorted-in(x, xs) = nil?(xs) ? [x] : x <= xs[0] ? cons(x, xs) : cons(xs[0], ovg-sorted-in(x, xs[1:]));
  def ovg-median(xs) {
   let sorted = foldl((acc, x) => ovg-sorted-in(x, acc), [], xs);
   sorted[len(sorted) / 2];
  }
  def ovg-side(gap, rows, key) {
   let field = fcgp-str(gap, "field");
   let m = fcgp-obj(gap, key);
   filter(v => !nothing?(v), map(r => fcgp-present?(r, field) ? ovg-milli(json-emit(fcgp-node(r, field))) : nothing(), filter(r => ovg-matches?(r, m), rows)));
  }
  def ovg-read-pair(gap, rows, opts) {
   let mine = ovg-recent(gap, ovg-where(gap, rows), opts);
   let left = ovg-side(gap, mine, "left");
   let right = ovg-side(gap, mine, "right");
   let op = fcgp-str(gap, "compare");
   let sides = "holding " ++ ovg-obj-text(fcgp-obj(gap, "left")) ++ " " ++ len(left).str() ++ " row(s), holding " ++ ovg-obj-text(fcgp-obj(gap, "right")) ++ " " ++ len(right).str() ++ " row(s)";
   nil?(left) || nil?(right) ? [ovg-none-verdict(gap), "a side has no row" ++ ovg-where-text(gap) ++ ovg-within-text(gap) ++ ": " ++ sides ++ ", among " ++ len(rows).str() ++ " row(s)"]
   : ovg-judged(ovg-cmp(op, ovg-median(left), ovg-median(right)), "the median " ++ fcgp-str(gap, "field") ++ ovg-within-text(gap) ++ ": " ++ sides ++ ": " ++ ovg-median(left).str() ++ " " ++ op ++ " " ++ ovg-median(right).str() ++ " in milli", op);
  }
  // ── rent: rented tokens the sessions' rows grew by inside a window; a session's row is cumulative, so its growth is its newest row less its newest before the window ──
  def ovg-rented-of(r) {
   let rented = fcgp-obj(r, "rented");
   fcgp-num(r, "rented_total") ?? ((fcgp-num(rented, "input") ?? 0) + (fcgp-num(rented, "cache_write") ?? 0) + (fcgp-num(rented, "cache_read") ?? 0) + (fcgp-num(rented, "output") ?? 0));
  }
  def ovg-row-at(r) = fcgp-num(r, "at_unix_ms") ?? 0;
  def ovg-newest(rows) = foldl((best, r) => nothing?(best) || ovg-row-at(r) >= ovg-row-at(best) ? r : best, nothing(), rows);
  def ovg-growth(mine, from, to) {
   let last = ovg-newest(filter(r => ovg-row-at(r) < to, mine));
   let base = ovg-newest(filter(r => ovg-row-at(r) < from, mine));
   let grew = (nothing?(last) ? 0 : ovg-rented-of(last)) - (nothing?(base) ? 0 : ovg-rented-of(base));
   grew < 0 ? 0 : grew;
  }
  def ovg-rent-between(rows, from, to) = foldl((acc, s) => acc + ovg-growth(filter(r => (String) fcgp-str(r, "session") == s, rows), from, to), 0, ovg-distinct(map(r => fcgp-str(r, "session"), rows)));
  def ovg-read-rent(gap, rows, opts) {
   let days = fcgp-num(gap, "days") ?? 7;
   let now = ovg-now(opts);
   let span = days * ep-day-ms();
   let newest = ovg-newest(rows);
   let op = fcgp-str(gap, "compare");
   let want = fcgp-num(gap, "threshold") ?? 0;
   nothing?(newest) ? [ovg-none-verdict(gap), "no row of the meter"]
   : ovg-stale?(gap, newest, opts) ? ["open", "the meter is quiet: its newest row of " ++ len(rows).str() ++ " is older than " ++ (fcgp-num(gap, "within_ms") / 3600000).str() ++ " hours" ++ ovg-at(newest)]
   : ovg-rent-metered(ovg-judged(ovg-cmp(op, ovg-rent-between(rows, now - span, now + 1), want), ovg-rent-between(rows, now - span, now + 1).str() ++ " rented token(s) in the last " ++ days.str() ++ " days (the " ++ days.str() ++ " before: " ++ ovg-rent-between(rows, now - 2 * span, now - span).str() ++ "), over " ++ len(rows).str() ++ " meter row(s): " ++ op ++ " " ++ want.str(), op), len(filter(r => ovg-unmetered?(r) && ovg-row-at(r) >= now - span, rows)));
  }
  // a row whose usage did not read holds an unknown, never a zero: a reading that would close over one is unread
  def ovg-unmetered?(r) = nothing?(fcgp-num(r, "rented_total")) && nothing?(fcgp-num(fcgp-obj(r, "rented"), "output"));
  def ovg-rent-metered(judged, unmetered) = (Comparable) unmetered > 0 && (String) judged[0] == "closed" ? ["unread", judged[1] ++ "; " ++ unmetered.str() ++ " meter row(s) in the window read no usage"] : judged;
  // ── table: a markdown table in a document, two cells as decimals in milli ──
  def ovg-drop-last(xs) = len(xs) <= 1 ? [] : cons(xs[0], ovg-drop-last(xs[1:]));
  def ovg-cells(line) = map(c => trim(c), ovg-drop-last(split-on(line, "|")[1:]));
  def ovg-table-row?(line) = len(line) > 0 && (Comparable) str_byte_at(line, 0) == 124;
  def ovg-table-rows(text) = map(l => ovg-cells(l), filter(l => ovg-table-row?(l), map(l => trim(l), split-on(text, "\n"))));
  def ovg-row-for(rows, key) = foldl((found, c) => (!nil?(c)) && (String) c[0] == key ? c : found, [], rows);
  def ovg-cell(cells, i) = i < len(cells) ? cells[i] : "";
  def ovg-digits(s, i, acc) = i >= len(s) ? acc : (str_byte_at(s, i) >= 48) && (str_byte_at(s, i) <= 57) ? ovg-digits(s, i + 1, acc * 10 + (str_byte_at(s, i) - 48)) : nothing();
  def ovg-pad3(s) = len(s) >= 3 ? substring(s, 0, 3) : ovg-pad3(s ++ "0");
  // "2.79" reads 2790, "11" reads 11000; a cell that is not an unsigned decimal reads nothing
  def ovg-milli(text) {
   let t = trim(text);
   let dot = str_find(t, ".", 0);
   let whole = dot < 0 ? ovg-digits(t, 0, 0) : ovg-digits(substring(t, 0, dot), 0, 0);
   let frac = dot < 0 ? 0 : ovg-digits(ovg-pad3(substring(t, dot + 1, len(t))), 0, 0);
   len(t) == 0 || nothing?(whole) || nothing?(frac) ? nothing() : whole * 1000 + frac;
  }
  def ovg-read-table(gap, text) {
   let rows = ovg-table-rows(text);
   let key = fcgp-str(gap, "row_key");
   let akey = fcgp-str(gap, "against_key");
   let col = fcgp-num(gap, "column");
   let op = fcgp-str(gap, "compare");
   let mine = ovg-row-for(rows, key);
   let other = (String) akey == "" ? [] : ovg-row-for(rows, akey);
   let v = nothing?(col) || nil?(mine) ? nothing() : ovg-milli(ovg-cell(mine, col));
   let want = nothing?(col) ? nothing() : (String) akey == "" ? fcgp-num(gap, "threshold_milli") : nil?(other) ? nothing() : ovg-milli(ovg-cell(other, col));
   nothing?(col) ? ["unread", "column absent in the gap row"]
   : nil?(mine) ? ["unread", "no table row keyed " ++ key ++ " among " ++ len(rows).str() ++ " table row(s)"]
   : nothing?(v) ? ["unread", "row " ++ key ++ " column " ++ col.str() ++ " holds no decimal (\"" ++ ovg-cell(mine, col) ++ "\")"]
   : nothing?(want) ? ["unread", (String) akey == "" ? "threshold_milli absent in the gap row" : "no decimal in column " ++ col.str() ++ " of a row keyed " ++ akey ++ " among " ++ len(rows).str() ++ " table row(s)"]
   : ovg-judged(ovg-cmp(op, v, want), key ++ " column " ++ col.str() ++ " reads " ++ ovg-cell(mine, col) ++ ((String) akey == "" ? "" : " against " ++ akey ++ " " ++ ovg-cell(other, col)) ++ ": " ++ v.str() ++ " " ++ op ++ " " ++ want.str() ++ " in milli (the last table row of each key)", op);
  }
  // ── schedule: the slots due, read from the walk checkout ──
  def ovg-ref(opts) = (String) fcgp-str(opts, "ref") == "" ? ep-ref() : fcgp-str(opts, "ref");
  def ovg-names(states) = str-join-with(map(s => s[0] ++ s[2], states), ", ");
  def ovg-read-schedule(gap, opts) {
   let walk = ovg-walk(opts);
   let zone = ovg-zone(opts);
   nothing?(zone) ? ["unread", "the host's zone did not read"] : ovg-schedule-of(gap, ep-slot-reading(walk, ovg-ref(opts), ovg-now(opts), zone, fcgp-num(gap, "days") ?? 7, fcgp-num(gap, "grace_ms") ?? 2700000, fcgp-num(gap, "stamp_within_ms") ?? 2700000));
  }
  def ovg-schedule-of(gap, read) = (String) read[1] != "" ? ["unread", read[1]] : nil?(read[0]) ? ["unread", "no slot due in the window"] : ovg-schedule-said(gap, read[0], ep-slots-of-state(read[0], "landed"), ep-slots-of-state(read[0], "began"), ep-slots-of-state(read[0], "unread"));
  def ovg-schedule-said(gap, all, landed, began, unread) {
   let read = len(landed) + len(began);
   let op = fcgp-str(gap, "compare");
   let want = fcgp-num(gap, "threshold") ?? 1000;
   ovg-judged(ovg-cmp(op, ovg-pm(read, len(all)), want), read.str() ++ " of " ++ len(all).str() ++ " slot(s) due in the last " ++ (fcgp-num(gap, "days") ?? 7).str() ++ " days read a stamp or a landed row: " ++ len(landed).str() ++ " landed, " ++ len(began).str() ++ " began only" ++ (nil?(began) ? "" : " (" ++ ovg-names(began) ++ ": a stamp says began, never finished)") ++ "; " ++ len(unread).str() ++ " unread" ++ (nil?(unread) ? "" : " (" ++ ovg-names(unread) ++ ")") ++ ": " ++ ovg-pm(read, len(all)).str() ++ " pm " ++ op ++ " " ++ want.str(), op);
  }
  // ── landings: of the source-changing landings on the ref, the share no rented mind wrote ──
  def ovg-strings(gap, key) = fcgp-present?(gap, key) ? map(n => json-string-value(n), json-array-elements(json-object-get(gap, key))) : [];
  def ovg-take(n, xs) = n <= 0 || nil?(xs) ? [] : cons(xs[0], ovg-take(n - 1, xs[1:]));
  def ovg-crossings(repo, ref) = ep-rows-of(ep-blob(repo, ref, "receipts/crossings-ledger.jsonl", "gaps-crossings"));
  def ovg-read-landings(gap, opts) {
   let repo = ovg-repo(opts);
   let ref = ovg-ref(opts);
   let days = fcgp-num(gap, "days") ?? 30;
   let landings = ep-landings(repo, ref, ovg-now(opts) - days * ep-day-ms());
   let crossings = ovg-crossings(repo, ref);
   let zone = ovg-zone(opts);
   nothing?(landings) || nothing?(crossings) || nothing?(zone) ? ["unread", "git or the crossings ledger did not read on " ++ ref ++ " in " ++ repo] : ovg-landings-said(gap, opts, filter(l => ep-source-changing?(l, ovg-strings(gap, "not_source")), landings), crossings, zone, days, ref);
  }
  // stood: why a native landing does not yet count ("" when it does): each line it added to source must still stand on the ref, and a gate must have run the band of its code as it landed
  def ovg-added-lines(repo, sha, path) {
   let run = ep-git(repo, "stood", ["show", sha, "--no-renames", "-U0", "--format=", "--", path]);
   hch-ok?(run) ? filter(l => (Comparable) len(trim(l)) > 0, map(l => substring(l, 1, len(l)), filter(l => ep-starts?(l, "+") && !ep-starts?(l, "+++ "), split-on(hch-said(run), "\n")))) : nothing();
  }
  def ovg-path-stands?(repo, ref, sha, path) {
   let lines = ovg-added-lines(repo, sha, path);
   let blob = nothing?(lines) || nil?(lines) ? "" : ep-blob(repo, ref, path, "stood-blob");
   let landed = nothing?(lines) || nil?(lines) ? "" : ep-blob(repo, sha, path, "stood-landed");
   !nothing?(lines) && (nil?(lines) || (!nothing?(blob) && !nothing?(landed) && all?(l => ovg-line-count(blob, l) >= ovg-line-count(landed, l), lines)));
  }
  // a line stands by its count: as many as the landing left, so a line alike elsewhere in the file does not stand for one a later commit removed
  def ovg-line-count(text, line) = ovg-occurrences("\n" ++ text ++ "\n", "\n" ++ line ++ "\n", 0, 0);
  def ovg-stood-why(rule, l, repo, ref, notSource) {
   let unread = (Comparable) (fcgp-num(rule, "gated") ?? 0) == 1 ? ep-unwitnessed(repo, l) : [];
   let gone = filter(p => ep-source-path?(p, notSource) && !ovg-path-stands?(repo, ref, l[0], p), l[4]);
   !nil?(gone) ? "a line no longer stands in " ++ gone[0] : !nil?(unread) ? "no gate's band reads " ++ unread[0] : "";
  }
  def ovg-landings-said(gap, opts, changing, crossings, zone, days, ref) {
   let rule = fcgp-obj(gap, "stood");
   let wait = fcgp-num(rule, "days") ?? 0;
   let ripe = filter(l => l[1] <= ovg-now(opts) - wait * ep-day-ms(), changing);
   let young = len(changing) - len(ripe);
   let repo = ovg-repo(opts);
   let told = filter(l => ep-native-landing?(l, crossings, zone), ripe);
   let read = map(l => [l, nil?(ovg-keys(rule)) ? "" : ovg-stood-why(rule, l, repo, ref, ovg-strings(gap, "not_source"))], told);
   let native = map(p => p[0], filter(p => (String) p[1] == "", read));
   let held = filter(p => (String) p[1] != "", read);
   let op = fcgp-str(gap, "compare");
   let want = fcgp-num(gap, "threshold") ?? 1000;
   nil?(ripe) ? [ovg-none-verdict(gap), "no source-changing landing on " ++ ref ++ " in the last " ++ days.str() ++ " days" ++ (young > 0 ? " older than " ++ wait.str() ++ " days (" ++ young.str() ++ " younger wait)" : "")] : ovg-judged(ovg-cmp(op, ovg-pm(len(native), len(ripe)), want), len(native).str() ++ " of " ++ len(ripe).str() ++ " source-changing landing(s) on " ++ ref ++ " in the last " ++ days.str() ++ " days read native" ++ (nil?(native) ? "" : " (" ++ str-join-with(map(l => substring(l[0], 0, 9), ovg-take(5, native)), ", ") ++ ")") ++ (young > 0 ? "; " ++ young.str() ++ " younger than " ++ wait.str() ++ " days wait" : "") ++ (nil?(held) ? "" : "; held out: " ++ str-join-with(map(p => substring(p[0][0], 0, 9) ++ " " ++ p[1], ovg-take(5, held)), ", ")) ++ ": " ++ ovg-pm(len(native), len(ripe)).str() ++ " pm " ++ op ++ " " ++ want.str(), op);
  }
  // ── gaps: of the gaps opened, the share the native lane closed and landed with no guide ──
  def ovg-real?(r) = ((Comparable) (fcgp-num(r, "dry") ?? 0) == 0) && ((Comparable) (fcgp-num(r, "test") ?? 0) == 0);
  def ovg-land-reach-ms() = 14400000;
  def ovg-distinct(xs) = foldl((acc, x) => any?(y => (String) y == x, acc) ? acc : append(acc, [x]), [], xs);
  def ovg-queue-row(queue, id) = foldl((best, q) => (String) fcgp-str(q, "id") == id ? q : best, nothing(), queue);
  def ovg-writable(queue, id) {
   let q = ovg-queue-row(queue, id);
   nothing?(q) ? [] : ovg-strings(q, "writable");
  }
  def ovg-touches?(landing, writable) = nil?(writable) || any?(p => any?(w => (String) w == p, writable), landing[4]);
  def ovg-lane-green?(r) = ((fcgp-num(r, "option") ?? 0) > 0) && ((Comparable) (fcgp-num(r, "band_green") ?? 0) == 1) && ((String) fcgp-str(r, "coordinated_by") == "host-schedule") && !json-object-has?(r, "session");
  def ovg-landed-after?(r, natives, writable) {
   let at = fcgp-num(r, "at_unix_ms") ?? 0;
   any?(l => (l[1] >= at - 60000) && (l[1] <= at + ovg-land-reach-ms()) && ovg-touches?(l, writable), natives);
  }
  def ovg-gap-native?(id, rows, natives, guides, queue) = !any?(g => (String) fcgp-str(g, "gap") == id, guides) && any?(r => (String) fcgp-str(r, "gap") == id && ovg-lane-green?(r) && ovg-landed-after?(r, natives, ovg-writable(queue, id)), rows);
  def ovg-read-gaps(gap, opts) {
   let days = fcgp-num(gap, "days") ?? 30;
   let since = ovg-now(opts) - days * ep-day-ms();
   let rows = filter(r => ovg-real?(r) && ((fcgp-num(r, "at_unix_ms") ?? 0) >= since), ep-text-rows(ovg-under(opts, fcgp-str(gap, "source"))));
   let queue = ep-text-rows(ovg-under(opts, fcgp-str(gap, "queue")));
   let guides = ep-text-rows(ovg-under(opts, fcgp-str(gap, "guide")));
   let repo = ovg-repo(opts);
   let ref = ovg-ref(opts);
   let landings = ep-landings(repo, ref, since);
   let crossings = ovg-crossings(repo, ref);
   let zone = ovg-zone(opts);
   nothing?(landings) || nothing?(crossings) || nothing?(zone) ? ["unread", "git or the crossings ledger did not read on " ++ ref ++ " in " ++ repo]
   : ovg-gaps-said(gap, ovg-gap-ids(rows, queue), rows, filter(l => ep-native-landing?(l, crossings, zone) && ep-source-changing?(l, ovg-strings(gap, "not_source")), landings), guides, queue, days);
  }
  // ── queue: every gap of the queue, read by its own last real row: once green is not green now, and a gap with no row stands open ──
  def ovg-last-green?(id, rows) {
   let mine = filter(r => (String) fcgp-str(r, "gap") == id, rows);
   !nil?(mine) && ((Comparable) (fcgp-num(mine[-1], "band_green") ?? 0) == 1);
  }
  def ovg-open-note(id, rows) {
   let mine = filter(r => (String) fcgp-str(r, "gap") == id, rows);
   nil?(mine) ? id ++ " (no row)" : id ++ " (band_after " ++ json-emit(fcgp-node(mine[-1], "band_after")) ++ ", " ++ fcgp-str(mine[-1], "lane_status") ++ ")";
  }
  def ovg-read-queue(gap, opts) {
   let rows = filter(r => ovg-real?(r), ep-text-rows(ovg-under(opts, fcgp-str(gap, "source"))));
   let ids = filter(id => (String) id != "", map(q => fcgp-str(q, "id"), ep-text-rows(ovg-under(opts, fcgp-str(gap, "queue")))));
   let open = filter(id => !ovg-last-green?(id, rows), ids);
   nil?(ids) ? ["unread", "no gap in " ++ fcgp-str(gap, "queue")] : [nil?(open) ? "closed" : "open", (len(ids) - len(open)).str() ++ " of " ++ len(ids).str() ++ " queue gap(s) read green in their last real row" ++ (nil?(open) ? "" : "; open: " ++ str-join-with(map(id => ovg-open-note(id, rows), open), ", "))];
  }
  // a queue row with no turn row yet stands open however old it is; a turn row is opened inside the window
  def ovg-gap-ids(rows, queue) = ovg-distinct(append(map(r => fcgp-str(r, "gap"), rows), filter(id => (String) id != "", map(q => fcgp-str(q, "id"), queue))));
  def ovg-gaps-said(gap, ids, rows, natives, guides, queue, days) {
   let closed = filter(id => ovg-gap-native?(id, rows, natives, guides, queue), ids);
   let op = fcgp-str(gap, "compare");
   let want = fcgp-num(gap, "threshold") ?? 1000;
   nil?(ids) ? ["unread", "no gap in the queue or the turns of the last " ++ days.str() ++ " days"] : ovg-judged(ovg-cmp(op, ovg-pm(len(closed), len(ids)), want), len(closed).str() ++ " of " ++ len(ids).str() ++ " gap(s) of the queue and the last " ++ days.str() ++ " days' turns closed by the native lane, landed, with no guide" ++ (nil?(closed) ? "" : " (" ++ str-join-with(ovg-take(5, closed), ", ") ++ ")") ++ ": " ++ ovg-pm(len(closed), len(ids)).str() ++ " pm " ++ op ++ " " ++ want.str(), op);
  }
  // ── sets: every alignment set's last reading ──
  def ovg-set-file?(name) = ep-starts?(name, "scenarios") && (str_find(name, ".jsonl", 0) > 0);
  def ovg-set-paths(gap, opts) {
   let dir = fcgp-str(gap, "sets");
   let found = fs_list(ovg-under(opts, dir)) ?? [];
   map(n => dir ++ "/" ++ n, filter(n => ovg-set-file?(n), found));
  }
  // a reading's fixtures is one set, or several read together with commas between; its scenarios are all of theirs
  def ovg-read-sets-of(r) = map(s => trim(s), split-on(fcgp-str(r, "fixtures"), ","));
  def ovg-last-of-set(rows, set) = foldl((best, r) => any?(s => (String) s == set, ovg-read-sets-of(r)) ? r : best, nothing(), rows);
  def ovg-base(p) { let at = ep-rfind(p, "/", 0, -1); at < 0 ? p : substring(p, at + 1, len(p)); }
  def ovg-set-count(opts, set) = len(ep-text-rows(ovg-under(opts, set)));
  def ovg-sets-hold(opts, r) = foldl((acc, s) => acc + ovg-set-count(opts, s), 0, ovg-read-sets-of(r));
  // [set, verdict word, text]
  def ovg-set-reading(rows, set, opts) {
   let r = ovg-last-of-set(rows, set);
   let n = nothing?(r) ? 0 : ovg-sets-hold(opts, r);
   nothing?(r) ? [set, "open", ovg-base(set) ++ " has no reading"]
   : (fcgp-num(r, "predicates_total") ?? 0) <= 0 ? [set, "open", ovg-base(set) ++ " read no predicate"]
   : !((Comparable) fcgp-num(r, "predicates_passed") == fcgp-num(r, "predicates_total")) ? [set, "open", ovg-base(set) ++ " " ++ fcgp-num(r, "predicates_passed").str() ++ "/" ++ fcgp-num(r, "predicates_total").str()]
   : !((Comparable) (fcgp-num(r, "scenarios") ?? 0) == n) ? [set, "open", ovg-base(set) ++ " read " ++ (fcgp-num(r, "scenarios") ?? 0).str() ++ " scenario(s), its reading's sets hold " ++ n.str()]
   : [set, "closed", ovg-base(set) ++ " " ++ fcgp-num(r, "predicates_passed").str() ++ "/" ++ fcgp-num(r, "predicates_total").str()];
  }
  def ovg-digest(r) = fcgp-str(r, "model") ++ " " ++ substring(fcgp-str(r, "prompt_digest") ++ "            ", 0, 12);
  def ovg-read-sets(gap, opts) {
   let rows = ovg-recent(gap, ovg-where(gap, ep-text-rows(ovg-under(opts, fcgp-str(gap, "source")))), opts);
   let sets = ovg-set-paths(gap, opts);
   let reads = map(s => ovg-set-reading(rows, s, opts), sets);
   let lasts = filter(r => !nothing?(r), map(s => ovg-last-of-set(rows, s), sets));
   let digests = ovg-distinct(map(r => ovg-digest(r), lasts));
   let text = str-join-with(map(r => r[2], reads), ", ");
   nil?(sets) ? ["unread", "no set file under " ++ fcgp-str(gap, "sets")]
   : any?(r => (String) r[1] == "open", reads) ? ["open", text]
   : len(digests) > 1 ? ["open", text ++ "; read under more than one model or prompt: " ++ str-join-with(digests, ", ")]
   : ["closed", text ++ " under " ++ digests[0]];
  }
  // ── axis: the alignment step tags every predicate with one axis (model/fixtures/alignment/axes.jsonl: {id, axes}, one word per predicate)
  // and a reading lands one row per axis (receipts/alignment-axis-ledger.jsonl). All that are tagged must have been read, and all read must pass ──
  def ovg-axis-words(gap) = cons(fcgp-str(gap, "axis"), ovg-strings(gap, "aliases"));
  def ovg-axis-word?(words, t) = any?(w => (String) w == t, words);
  def ovg-axis-tagged(gap, opts, words) = foldl((acc, row) => acc + len(filter(t => ovg-axis-word?(words, t), ovg-strings(row, "axes"))), 0, ep-text-rows(ovg-under(opts, fcgp-str(gap, "tags"))));
  // each set's last row of this axis, a reading that held several sets once
  def ovg-axis-rows(rows, sets) = foldl((acc, s) => { let r = ovg-last-of-set(rows, s); nothing?(r) || any?(x => (Comparable) fcgp-num(x, "at_unix_ms") == fcgp-num(r, "at_unix_ms") && (String) fcgp-str(x, "fixtures") == fcgp-str(r, "fixtures"), acc) ? acc : append(acc, [r]); }, [], sets);
  def ovg-read-axis(gap, opts) {
   let words = ovg-axis-words(gap);
   let rows = filter(r => ovg-axis-word?(words, fcgp-str(r, "axis")), ovg-recent(gap, ovg-where(gap, ep-text-rows(ovg-under(opts, fcgp-str(gap, "source")))), opts));
   let lasts = ovg-axis-rows(rows, ovg-set-paths(gap, opts));
   let passed = foldl((acc, r) => acc + (fcgp-num(r, "predicates_passed") ?? 0), 0, lasts);
   let total = foldl((acc, r) => acc + (fcgp-num(r, "predicates_total") ?? 0), 0, lasts);
   let tagged = ovg-axis-tagged(gap, opts, words);
   let digests = ovg-distinct(map(r => ovg-digest(r), lasts));
   let axis = fcgp-str(gap, "axis");
   (tagged <= 0) && (total <= 0) ? ["open", "no predicate carries the axis " ++ axis ++ " in any set"]
   : total < tagged ? ["open", "the last readings read " ++ total.str() ++ " of the " ++ tagged.str() ++ " predicate(s) tagged " ++ axis ++ ": a set or a scenario stands unread"]
   : (Comparable) passed != total ? ["open", passed.str() ++ "/" ++ total.str() ++ " predicate(s) tagged " ++ axis ++ " pass"]
   : len(digests) > 1 ? ["open", passed.str() ++ "/" ++ total.str() ++ " predicate(s) tagged " ++ axis ++ ", read under more than one model or prompt: " ++ str-join-with(digests, ", ")]
   : ["closed", passed.str() ++ "/" ++ total.str() ++ " predicate(s) tagged " ++ axis ++ " pass under " ++ digests[0]];
  }
  // ── feature: the door stands, a step of the walk begins it, and its row is recent ──
  def ovg-bml-dir() = "form/form-stdlib/bml";
  def ovg-walk-units(opts) = append(["observe/scheduled-walk.bml", "observe/day-turn.bml"], map(n => ovg-bml-dir() ++ "/" ++ n, filter(n => ep-starts?(n, "host-walk") && (String) n != "host-walk-window.bml" && (str_find(n, ".bml", 0) > 0) && (str_find(n, ".bml.", 0) < 0), fs_list(ovg-under(opts, ovg-bml-dir())) ?? [])));
  def ovg-walk-begins?(door, opts) = any?(u => ep-has?(ep-code-of(read_file(ovg-under(opts, u))), "\"" ++ door ++ "\""), ovg-walk-units(opts));
  def ovg-read-feature(gap, opts) {
   let door = fcgp-str(gap, "door");
   (String) door == "" ? ovg-feature-reading(gap, opts)
   : (Comparable) host_path_exists(ovg-under(opts, door)) != 1 ? ["open", "the door " ++ door ++ " does not stand"]
   : !ovg-walk-begins?(door, opts) ? ["open", "no step of the walk begins " ++ door ++ ": it runs when a session begins it; its reading alone: " ++ ovg-feature-reading(gap, opts)[1]]
   : ovg-feature-reading(gap, opts);
  }
  def ovg-feature-reading(gap, opts) {
   let path = ovg-path(gap, opts);
   (String) path == "" ? ["open", "no walk checkout"]
   : (Comparable) host_path_exists(path) != 1 ? ["open", "absent: " ++ path ++ ovg-writer-note(fcgp-str(gap, "source"))]
   : (String) fcgp-str(gap, "count_text") != "" ? ovg-count-text(gap, fhn-read(path))
   : (Comparable) (fcgp-num(gap, "by_schedule") ?? 0) == 1 ? ovg-read-landed(gap, opts)
   : ovg-read-last(gap, fcgp-rows(path), opts);
  }
  // an absent ledger names its writer (host-walk-writers.bml): a door that stands and has not written here, or no door at all
  def ovg-writer-note(source) {
   let units = map(w => w[1], filter(w => (String) w[0] == source, hw-carried-writers()));
   nil?(units) ? "; no door writes it" : "; its writer " ++ str-join-with(units, ", ") ++ " has landed no row of it in this checkout";
  }
  // by_schedule: the rows native landings on the ref added to this source inside within_ms, and the reading is the last of them
  def ovg-carried(gap, opts) {
   let repo = ovg-repo(opts);
   let crossings = ovg-crossings(repo, ovg-ref(opts));
   let zone = ovg-zone(opts);
   nothing?(crossings) || nothing?(zone) ? nothing() : ep-landed-rows(repo, ovg-ref(opts), ovg-now(opts) - (fcgp-num(gap, "within_ms") ?? (7 * ep-day-ms())), fcgp-str(gap, "source"), crossings, zone);
  }
  def ovg-carried-unread(opts) = ["unread", "git or the crossings ledger did not read on " ++ ovg-ref(opts) ++ " in " ++ ovg-repo(opts)];
  def ovg-read-landed(gap, opts) {
   let ref = ovg-ref(opts);
   let rows = ovg-carried(gap, opts);
   nothing?(rows) ? ovg-carried-unread(opts)
   : nil?(ovg-where(gap, rows)) ? [ovg-none-verdict(gap), "no native landing on " ++ ref ++ ovg-within-text(gap) ++ " added a row" ++ ovg-where-text(gap) ++ " to this ledger (" ++ len(rows).str() ++ " row(s) they added hold none): a session's row, in this tree or under its own commit, is no row of the schedule"]
   : ovg-read-last(gap, rows, opts);
  }
  def ovg-read-carried-rows(shape, gap, opts) {
   let rows = ovg-carried(gap, opts);
   nothing?(rows) ? ovg-carried-unread(opts) : ovg-read-rows(shape, gap, rows, opts);
  }
  def ovg-occurrences(text, needle, from, n) {
   let at = str_find(text, needle, from);
   at < 0 ? n : ovg-occurrences(text, needle, at + len(needle), n + 1);
  }
  def ovg-count-text(gap, text) {
   let needle = fcgp-str(gap, "count_text");
   let n = ovg-occurrences(text, needle, 0, 0);
   ovg-judged(ovg-cmp(fcgp-str(gap, "compare"), n, fcgp-num(gap, "threshold") ?? 0), "the marker " ++ needle ++ " stands " ++ n.str() ++ " time(s)", fcgp-str(gap, "compare"));
  }
  // ── scope: what the document names of a host or a goal's reach ──
  def ovg-scope-mark(gap) = "(query-scope \"" ++ fcgp-str(gap, "scope") ++ "\" \"";
  def ovg-scope-text(text, at) { let end = str_find(text, "\")", at); end < 0 ? "" : substring(text, at, end); }
  def ovg-read-scope(gap, opts) {
   let text = read_file(ovg-path(gap, opts)) ?? "";
   let at = str_find(text, ovg-scope-mark(gap), 0);
   let cells = at < 0 ? [] : split-on(ovg-scope-text(text, at + len(ovg-scope-mark(gap))), "\" \"");
   len(cells) < 2 ? ["unread", "no query-scope line names " ++ fcgp-str(gap, "scope") ++ " in " ++ fcgp-str(gap, "source")]
   : (String) cells[0] == "open" ? ["open", "an open scope, the person's to say: " ++ cells[1]]
   : (String) cells[0] == "person-said" ? ["closed", "the person said: " ++ cells[1]]
   : ["unread", "state \"" ++ cells[0] ++ "\" of " ++ fcgp-str(gap, "scope") ++ " is neither open nor person-said"];
  }
  // ── where a source is: this checkout, the stdin root, or the walk checkout ──
  def ovg-walk(opts) = fcgp-present?(opts, "walk") ? fcgp-str(opts, "walk") : sr-walk-dir();
  def ovg-walk?(gap) = (String) fcgp-str(gap, "checkout") == "walk";
  def ovg-repo(opts) = (String) fcgp-str(opts, "root") == "" ? "." : fcgp-str(opts, "root");
  def ovg-under(opts, p) = (String) fcgp-str(opts, "root") == "" ? p : fcgp-str(opts, "root") ++ "/" ++ p;
  def ovg-path(gap, opts) {
   let src = fcgp-str(gap, "source");
   ovg-walk?(gap) ? ((String) ovg-walk(opts) == "" ? "" : ovg-walk(opts) ++ "/" ++ src) : ovg-under(opts, src);
  }
  def ovg-shown(gap, path) = (String) path == "" ? "walk:" ++ fcgp-str(gap, "source") : path;
  // ── one gap: [verdict, observation] ──
  def ovg-self-reading?(shape) = any?(s => (String) s == shape, ["queue", "landings", "gaps", "sets", "axis", "feature", "scope"]);
  def ovg-read-self(gap, shape, opts) = (String) shape == "queue" ? ovg-read-queue(gap, opts) : (String) shape == "landings" ? ovg-read-landings(gap, opts) : (String) shape == "gaps" ? ovg-read-gaps(gap, opts) : (String) shape == "sets" ? ovg-read-sets(gap, opts) : (String) shape == "axis" ? ovg-read-axis(gap, opts) : (String) shape == "scope" ? ovg-read-scope(gap, opts) : ovg-read-feature(gap, opts);
  def ovg-read-rows(shape, gap, rows, opts) = ovg-noted(ovg-read-rows-of(shape, gap, rows, opts), ovg-detached(gap, rows, opts));
  def ovg-read-rows-of(shape, gap, rows, opts) = (String) shape == "last" ? ovg-read-last(gap, rows, opts) : (String) shape == "first" ? ovg-read-first(gap, rows, opts) : (String) shape == "pair" ? ovg-read-pair(gap, rows, opts) : (String) shape == "rent" ? ovg-read-rent(gap, rows, opts) : ovg-read-share(gap, rows, opts);
  // first: the first row that holds `where`: a held-out reading counts once, and a later reading of the same set under the same prompt reads nothing.
  // before {where, same}: a row holding before.where that stands ahead of it under another `same` spoils it, and the gap reads open by name
  def ovg-before(gap) = fcgp-obj(fcgp-obj(gap, "before"), "where");
  def ovg-same(gap) = fcgp-str(fcgp-obj(gap, "before"), "same");
  def ovg-before-rows(gap, rows) = nil?(ovg-keys(ovg-before(gap))) ? [] : filter(r => ovg-matches?(r, ovg-before(gap)), rows);
  // the rows holding before.where whose `same` differs from the row's: the exam asks it of the reading it would make (offline-exam.bml oex-sealed-why)
  def ovg-spoiling(gap, rows, row) = filter(r => (String) fcgp-str(r, ovg-same(gap)) != fcgp-str(row, ovg-same(gap)), ovg-before-rows(gap, rows));
  def ovg-ahead-of-first(gap, rows) = foldl((acc, r) => (Comparable) acc[1] == 1 ? acc : ovg-matches?(r, fcgp-obj(gap, "where")) && ovg-since?(gap, r) ? [acc[0], 1] : [append(acc[0], [r]), 0], [[], 0], rows)[0];
  def ovg-read-first(gap, rows, opts) {
   let mine = ovg-where(gap, rows);
   nil?(mine) ? ovg-none(gap, rows) : ovg-first-of(gap, mine, ovg-spoiling(gap, ovg-ahead-of-first(gap, rows), mine[0]), opts);
  }
  def ovg-first-of(gap, mine, spoiled, opts) {
   let place = " (the first of " ++ len(mine).str() ++ " row(s)" ++ ovg-where-text(gap) ++ ovg-at(mine[0]) ++ ")";
   nil?(spoiled) ? ovg-judge-whole(gap, mine[0], place, opts) : ["open", "spoiled: " ++ len(spoiled).str() ++ " row(s) holding " ++ ovg-obj-text(ovg-before(gap)) ++ " stand ahead of it under another " ++ ovg-same(gap) ++ ", the first " ++ substring(fcgp-str(spoiled[0], ovg-same(gap)) ++ "            ", 0, 12) ++ ovg-at(spoiled[0]) ++ place];
  }
  def ovg-read(gap, opts) {
   let kind = fcgp-str(gap, "kind");
   let shape = ovg-shape(kind);
   let path = ovg-path(gap, opts);
   (String) shape == "" ? ["unread", "kind \"" ++ kind ++ "\" has no reader (the kinds: " ++ ovg-kind-names() ++ ")"]
   : ovg-self-reading?(shape) ? ovg-read-self(gap, shape, opts)
   : (String) path == "" ? ["unread", "no walk checkout: the day-turn plist names none"]
   : (String) shape == "schedule" ? ovg-read-schedule(gap, opts)
   : (Comparable) host_path_exists(path) != 1 ? [ovg-none-verdict(gap), "absent: " ++ path]
   : (String) shape == "table" ? ovg-read-table(gap, fhn-read(path))
   : (Comparable) (fcgp-num(gap, "by_schedule") ?? 0) == 1 ? ovg-read-carried-rows(shape, gap, opts)
   : ovg-read-rows(shape, gap, fcgp-rows(path), opts);
  }
  // [gap, verdict, observation, source shown]
  def ovg-result(gap, opts) {
   let r = ovg-read(gap, opts);
   [gap, r[0], r[1], ovg-shown(gap, ovg-path(gap, opts))];
  }
  def ovg-line(r) = ovg-prefix() ++ fcgp-str(r[0], "id") ++ ": " ++ r[1] ++ " — " ++ fcgp-str(r[0], "title") ++ "; " ++ r[2] ++ " (" ++ fcgp-str(r[0], "kind") ++ " " ++ r[3] ++ "; serves: " ++ fcgp-str(r[0], "goal") ++ ")";
  def ovg-count(results, verdict) = len(filter(r => (String) r[1] == verdict, results));
  def ovg-summary(results, regPath, kept) = ovg-prefix() ++ "summary: " ++ len(results).str() ++ " gap(s): closed " ++ ovg-count(results, "closed").str() ++ ", open " ++ ovg-count(results, "open").str() ++ ", unread " ++ ovg-count(results, "unread").str() ++ "; register " ++ regPath ++ " " ++ kept;
  def ovg-row-of(r) = json-node-object([fhn-s("id", fcgp-str(r[0], "id")), fhn-s("kind", fcgp-str(r[0], "kind")), fhn-s("verdict", r[1]), fhn-s("observation", lrun-home-free(r[2])), fhn-s("source", lrun-home-free(r[3])), fhn-s("goal", fcgp-str(r[0], "goal"))]);
  def ovg-register-row(results, gapsPath) = json-node-object([fhn-n("at_unix_ms", now_unix_ms()), fhn-s("gaps_file", gapsPath), fhn-n("gaps", len(results)), fhn-n("closed", ovg-count(results, "closed")), fhn-n("open", ovg-count(results, "open")), fhn-n("unread", ovg-count(results, "unread")), json-node-pair("verdicts", json-node-array(map(r => ovg-row-of(r), results)))]);
  // ── the door: stdin options, the gaps file, the lines, the register row ──
  def ovg-spec() = [["gaps", "str"], ["root", "str"], ["walk", "str"], ["register", "str"], ["ref", "str"], ["now_ms", "int"], ["zone_ms", "int"]];
  def ovg-opts() = dop-doc(ovg-door(), stdin-text(), ovg-spec());
  def ovg-or(v, dflt) = (String) v == "" ? dflt : v;
  def ovg-run(opts) {
   let gapsPath = ovg-or(fcgp-str(opts, "gaps"), ovg-gaps());
   let regPath = ovg-or(fcgp-str(opts, "register"), ovg-register());
   let gaps = (Comparable) host_path_exists(gapsPath) == 1 ? fcgp-rows(gapsPath) : [];
   (Comparable) host_path_exists(gapsPath) != 1 ? dop-refuse(ovg-door(), "no gaps file at " ++ gapsPath)
   : nil?(gaps) ? dop-refuse(ovg-door(), "no gap row in " ++ gapsPath)
   : ovg-observe(gaps, opts, gapsPath, regPath);
  }
  def ovg-observe(gaps, opts, gapsPath, regPath) {
   let results = map(g => ovg-result(g, opts), gaps);
   let swept = fs-remove-tree(ep-io());
   let printed = map(r => print_str(ovg-line(r)), results);
   let kept = fhn-append(regPath, lrun-row-line(ovg-register-row(results, gapsPath)) ++ "\n");
   ovg-summary(results, regPath, kept);
  }
 }
}
