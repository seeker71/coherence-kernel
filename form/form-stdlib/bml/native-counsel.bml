// native-counsel.bml — the native turn asks counsel of the resident server before it walks its ladder.
//
// An engineering turn reads its gap's goal; with .hearth/walk.counsel present (opt-in, as .hearth/walk.lenses is for the planner) the turn first puts the goal
// to the 27B through the lenses a counsel gives (observe/local-counsel-run.bml): one request a lens in the standing server's spool, each decoded beside every other sequence the
// server holds, under the server's GPU lease. The turn never opens a model of its own for it: no server standing is named and the turn goes on without counsel (counsel
// is advice, never a gate). The reply is kept beside the turn's candidates (.hearth/native-turns/<gap>.counsel, one lens a paragraph) for the lens and voice ways to read,
// the door line is printed, and the turn's walk line carries what was asked: "; counsel: <n> lenses, surest <i>".
//
//   ncs-wanted?()                          .hearth/walk.counsel stands
//   ncs-question(goal)                     the question one lens is asked of
//   ncs-ask(dir, question, lenses, gen, who)   ["served" line texts surprises] or ["unserved" reason [] []]
//   ncs-for-turn(id, goal)                 the whole turn-side call: prints the line, keeps the texts, answers the walk-line note ("" when none)
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/bml/serve-sched.bml form-stdlib/bml/serve-client.bml
section [form.bml] {
 class NativeCounsel {
  def ncs-dir() = ".hearth/native-turns";
  def ncs-gen() = 120;
  def ncs-lenses() = ["Answer by naming what could go wrong first.", "Answer by naming the smallest first step."];
  def ncs-wanted?() = file_size(".hearth/walk.counsel") >= 0;
  def ncs-question(goal) = "An engineering request for one small edit of a Form codebase:\n" ++ goal ++ "\nWhat should the engineer know before the first edit?";
  // the reply ends at the model's own end-of-turn; ids decoded after it are not part of it
  def ncs-reply(text) {
   let at = str_find(text, "<|im_end|>", 0);
   trim(at < 0 ? text : substring(text, 0, at));
  }
  def ncs-surest(sc, i, best) = i >= len(sc) ? best : ncs-surest(sc, i + 1, sc[i] < sc[best] ? i : best);
  def ncs-ask(dir, question, lenses, gen, who) {
   let st = svc-standing(dir);
   (String) st[0] != "standing" ? ["unserved", "no server stands (" ++ st[1] ++ ")", [], []] : ncs-served(dir, question, lenses, gen, who);
  }
  def ncs-served(dir, question, lenses, gen, who) {
   let ids = map(i => svc-submit(dir, "n" ++ i.str(), svc-spec-json(question, lenses[i], 1, gen, [], 0, who)), range(0, len(lenses)));
   let got = map(id => len(id) == 0 ? ["unserved", "the spool refused the request file"] : svc-wait(dir, id, 0), ids);
   let down = filter(g => (String) g[0] != "answered", got);
   nil?(down) ? ncs-of-docs(lenses, map(g => g[1], got)) : ["unserved", "the server did not answer (" ++ down[0][1] ++ ")", [], []];
  }
  // the replies as the turn reads them: the line, each lens's text, each lens's surprise (micro-nats a token: the confidence it read)
  def ncs-of-docs(lenses, docs) {
   let sc = map(d => svc-int(d, "surprise_micro_nats"), docs);
   let line = "served by the resident server: " ++ len(lenses).str() ++ " lenses, prompt " ++ svc-int(docs[0], "prompt_ids").str() ++ " ids a lens; queue " ++ svc-int(docs[0], "queue_ms").str() ++ " ms, prefill " ++ svc-int(docs[0], "prefill_ms").str() ++ " ms, " ++ svc-int(docs[0], "generated_ids").str() ++ " tokens; surest lens " ++ ncs-surest(sc, 0, 0).str();
   ["served", line, map(d => ncs-reply(svc-str(d, "text")), docs), sc];
  }
  def ncs-keep(id, lenses, texts) {
   let made = host_dir_mkdir(".hearth") + host_dir_mkdir(ncs-dir());
   write_file(ncs-dir() ++ "/" ++ id ++ ".counsel", str-join(map(i => "[" ++ lenses[i] ++ "]\n" ++ texts[i] ++ "\n", range(0, len(lenses)))));
  }
  def ncs-for-turn(id, goal) {
   let r = ncs-ask(svc-default-dir(), ncs-question(goal), ncs-lenses(), ncs-gen(), "native-turn-counsel");
   let said = print_str("[native-turn:counsel] " ++ id ++ " " ++ ((String) r[0] == "served" ? r[1] : "unserved: " ++ r[1] ++ "; the turn goes on without counsel"));
   let kept = (String) r[0] == "served" ? ncs-keep(id, ncs-lenses(), r[2]) : 0;
   (String) r[0] == "served" ? "; counsel: " ++ len(ncs-lenses()).str() ++ " lenses, surest " ++ ncs-surest(r[3], 0, 0).str() : "";
  }
 }
}
