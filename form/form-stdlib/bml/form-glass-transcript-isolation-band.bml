// Two native ear publishers must not replace one another's time slots.
// preludes: form/form-stdlib/form-glass-live.bml observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
    class FormGlassTranscriptIsolationBand {
        def fgti-bit(ok, bit) = if ok then bit else 0;
        def fgti-text(held) = if eq(len(fgsr-held-rows(held)), 0) then "" else fgo-text-value(head(fgsr-held-rows(held)));
        def fgti-count(held) = len(fglm-transcripts(fgsr-held-rows(held)));
        def fgti-row(text, epoch) = etr-row("original-closed", "en", text, epoch, "stored", "synthetic isolation witness");
        // Exercise the live cache-reading door with a private mapped gift.
        // The entry's logical selector does not publish that selector's name.
        def fgti-read(handle, name, held) {
            let kept = list(list(fgsr-publisher("ear"), ggf-name(name), handle, "take", 0));
            let cache = append(fgl-cache-full-kept(list(), list(), list(), list(), kept), list(list(), list(), list(), held));
            fgl-ear-snapshot(kept, cache);
        }
        def fgti-compete(writer, reader, name, held, n) {
            if le(n, 0) then 1 else fgti-compete-step(writer, reader, name, held, n);
        }
        def fgti-compete-step(writer, reader, name, held, n) {
            let given = node_gift_write(writer, fgsr-frame("ear", add(1000, n), list(fgti-row("other checkout", add(1000, n)))));
            let next = fgti-read(reader, name, held);
            and(and(eq(fgsr-held-seq(next), fgsr-held-seq(held)), str_eq(fgti-text(next), "this checkout")), fgti-compete(writer, reader, name, next, sub(n, 1)));
        }
        def fgti-physical(a, b) {
            let beforeMaps = kernel_stat(41);
            let ha = ggf-offer(a, 8192);
            let hb = ggf-offer(b, 8192);
            let first = node_gift_write(ha, fgsr-frame("ear", 1000, list(fgti-row("this checkout", 1000))));
            let held = fgti-read(ha, a, list());
            let before = bfc-envelope(0, host_pid(), 0, list(fgti-count(held), 1), -1);
            let sent = bfc-record-out(before, 0);
            let response = bfc-control(before, 5);
            let received = bfc-record-in(response, 1);
            let reader = bfc-apply(before, response, hb, ha);
            let isolated = fgti-compete(hb, reader, a, held, 20);
            let bad = node_gift_write(ha, list("incomplete snapshot"));
            let retained = fgti-read(ha, a, held);
            let silent = fgsr-rows-or-absent-at("ear", retained, 1400);
            let fresh = node_gift_write(ha, fgsr-frame("ear", 1500, list(fgti-row("new speech", 1500))));
            let moved = fgti-read(ha, a, retained);
            let off = node_gift_write(ha, fgsr-frame("ear", 1600, list(fgo-text("ear", "ear.state", "state", "asleep", "form", "physical-live", "ear-organ", "asleep", "ear", "synthetic off"))));
            let cleared = fgti-read(ha, a, moved);
            let out = bfc-record-out(bfc-envelope(0, host_pid(), 0, list(isolated, fgti-count(retained), fgti-count(cleared)), -1), 2);
            let releaseA = ggf-release(ha);
            let releaseB = ggf-release(hb);
            sum(list(fgti-bit(eq(fgti-count(held), 1), 16), fgti-bit(isolated, 32), fgti-bit(str_eq(fgti-text(retained), "this checkout"), 64), fgti-bit(eq(fgsr-held-epoch(retained), 1000), 128), fgti-bit(str_eq(fgo-evidence(nth(silent, 1)), "silent"), 256), fgti-bit(and(str_eq(fgti-text(moved), "new speech"), gt(fgsr-held-seq(moved), fgsr-held-seq(held))), 512), fgti-bit(eq(fgti-count(cleared), 0), 1024), fgti-bit(eq(kernel_stat(41), beforeMaps), 2048)));
        }
        def fgti-run() {
            let scope = str_concat("/fixture/glass-transcript-isolation/", int_to_str(host_pid()));
            let rootA = str_concat(scope, "/a");
            let rootB = str_concat(scope, "/b");
            let a = fgsr-publisher-in("ear", rootA);
            let b = fgsr-publisher-in("ear", rootB);
            let separate = not(str_eq(ggf-name(a), ggf-name(b)));
            let private = and(not(str_eq(a, fgsr-publisher("ear"))), not(str_eq(b, fgsr-publisher("ear"))));
            sum(list(fgti-bit(separate, 1), fgti-bit(str_eq(fgsr-publisher-in("ear", rootA), a), 2), fgti-bit(str_eq(fgsr-publisher("ear"), fgsr-publisher-in("ear", host_cwd())), 4), fgti-bit(str_eq(fgsr-publisher-in("host", rootA), fgsr-publisher-in("host", rootB)), 8), if and(separate, private) then fgti-physical(a, b) else 0));
        }
    }
    0;
}
