//////////////////////////////////////////////////////////////////////
//
// form-glass-event-loop.bml — event/deadline and frame-buffer authority.
//
// The kernel rests on a monotonic budget joined with the seq words of the
// gift frames it watches (host_sleep_ms with a watch list): a control offer
// or a telemetry publish moves a frame's seq word and the rest ends within a
// millisecond; a quiet field rests to the deadline, landing within half a
// millisecond of the ask.  Telemetry snapshots and control offers are cells in
// gift frames, so their writers remain independent of a Glass reader; the
// watch changes nothing in the producer contract.
//
// Executable: form-stdlib/form-glass-event-loop.bml
//
//////////////////////////////////////////////////////////////////////

package Form.glass.event_loop;

import Form.kernel.*;

interface IFormGlassEventLoop [public, observable, resident] {
   section [public] {
      const String Schema = "form-glass-event-loop-v1";
      const String WaitDoor = "kernel.monotonic-wait-until-frame-change";
      const String ClockDoor = "kernel.monotonic-ms";
      const String DeadlineRule = "deadlines advance from the prior monotonic deadline, never from completion time; a late observation skips every elapsed slot in one bounded arithmetic step";
      const String WakeRule = "a typed JIT refusal outranks every number of simultaneous control, deadline, and telemetry wakes, presents its fault frame immediately, and then holds ordinary collection; telemetry and control path changes otherwise stage a back frame, deadline or control admission may present it, and no event is inferred from an unchanged poll";
      const String RefusalRule = "JIT refusal never falls through to an ordinary frame: the hold retains publisher plus fault identity and only a newer typed jit-healed event from the same publisher with the same identity resumes; a control acknowledgement or an arbitrary healed string never resumes";
      const String BufferRule = "the terminal reads only the front frame while collection builds the back frame; commit swaps identities atomically and unchanged projection remains a renderer decision";
      const String ProducerRule = "telemetry and control producers give cells into gift frames and never open a FIFO, socket, or reader-owned endpoint, so Glass absence cannot block them";
      const String WaitRule = "idle-rest-wakes-on-frame-seq: host_sleep_ms with a watch list rests on the monotonic clock and wakes the moment a watched gift frame seq word moves; the rest is sliced so it lands within half a millisecond of the ask, and the glass footer names the door";

      Object Schedule() [abstract];
      Object Wake() [abstract];
      Object FrameBuffer() [abstract];
      Object Plan() [abstract];
   }
}

class FormGlassEventLoop [public, observable, resident, flow, teach] : IFormGlassEventLoop {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-event-loop.bml";

      Object Schedule() [abstract] {}
      Object Wake() [abstract] {}
      Object FrameBuffer() [abstract] {}
      Object Plan() [abstract] {}
   }
}
