//////////////////////////////////////////////////////////////////////
// form-cli-resident-continuity.bml — one admitted local mind carries
// compact task capsules until the model's own declared context is full.
//
// The ceiling is not an imposed token budget. It is the selected artifact's
// declared context capacity. Ordinary one-shot generation stays exact-need;
// the living agent opens once at the carrier truth it can hold.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk form-stdlib/language-template.fk

section [form.bml] {
    template ResidentCapacity<TCount> {
        member required: TCount;
        member artifactDeclared: TCount;
        member opened: TCount;
    }

    class FormResidentContinuity {
        field Profile = "resident-agent";
        field CapacityRule = "open-at-artifact-declared-context-capacity";
        field ReuseRule = "same-sealed-artifact-and-fitting-capsule-reuses-residence";
        field OverflowRule = "beyond-artifact-context-is-typed-local-gap-not-remote-fallback";
        field PeerOpenRule = "resident-peer-opens-at-artifact-declared-context-capacity";
        field StageRule = "admission-emits-native-framebuffer-stages-before-and-after-open-prefill";
        field DefaultTaskRoute = "direct-answer";
        field ExplicitRecipePrefix = "recipe ";
        field ExplicitSourcePrefix = "source ";
        field ExplicitSymbolPrefix = "symbol ";
        field SourceRouteRule = "source-prefix-runs-one-caller-born-strict-source-action-without-model-forward";
        field SourceContextRule = "source-root-and-artifact-are-born-once-at-peer-admission-not-reacquired-from-task-bytes";
        field SourceSymbolRouteRule = "symbol-prefix-queries-one-admission-born-source-snapshot-without-model-forward";
        field SourceSnapshotReuseRule = "one-admission-source-snapshot-serves-many-hot-keyed-symbol-lookups-in-the-same-residence";
        field RetryRule = "direct-answer-failure-or-nothing-reframes-once-locally-only-while-stream-open";
        field DirectResponseRule = "direct-answer-frame-asks-for-plain-prose-not-control";
        field AnswerCapacityRule = "direct-answer-decoding-uses-resident-remaining-context-not-fixed-token-cap";
        field PeerFrameRule = "resident-peer-emits-opaque-lifecycle-frames-in-native-framebuffer";
        field PeerFramePrivacyRule = "opaque-lifecycle-no-task-or-answer-bytes";
        field ObservedSessionRule = "task-observation-returns-the-live-session-directly-to-the-selected-action";
        field DirectUserTurnRule = "direct-answer-enters-as-user-turn-then-opens-plain-assistant-turn";
        field DecodePulseRule = "local-decode-publishes-exponentially-spaced-opaque-native-checkpoints";
        field BootstrapTeachingRule = "resident-bootstrap-carries-current-form-teaching-overlay-before-local-answering";

        def frc-profile() = Profile();
        def frc-capacity-rule() = CapacityRule();
        def frc-reuse-rule() = ReuseRule();
        def frc-overflow-rule() = OverflowRule();
        def frc-peer-open-rule() = PeerOpenRule();
        def frc-stage-rule() = StageRule();
        def frc-default-task-route() = DefaultTaskRoute();
        def frc-explicit-recipe-prefix() = ExplicitRecipePrefix();
        def frc-explicit-source-prefix() = ExplicitSourcePrefix();
        def frc-explicit-symbol-prefix() = ExplicitSymbolPrefix();
        def frc-source-route-rule() = SourceRouteRule();
        def frc-source-context-rule() = SourceContextRule();
        def frc-source-symbol-route-rule() = SourceSymbolRouteRule();
        def frc-source-snapshot-reuse-rule() = SourceSnapshotReuseRule();
        def frc-retry-rule() = RetryRule();
        def frc-direct-response-rule() = DirectResponseRule();
        def frc-answer-capacity-rule() = AnswerCapacityRule();
        def frc-peer-frame-rule() = PeerFrameRule();
        def frc-peer-frame-privacy-rule() = PeerFramePrivacyRule();
        def frc-observed-session-rule() = ObservedSessionRule();
        def frc-direct-user-turn-rule() = DirectUserTurnRule();
        def frc-decode-pulse-rule() = DecodePulseRule();
        def frc-bootstrap-teaching-rule() = BootstrapTeachingRule();
        def frc-is-agent-profile?(profile) = if str_eq(profile, frc-profile()) then 1 else 0;
    }
    0;
}
