// form-cli-one-body.bml — high-grammar picture.
//
// Urs: invented need dissolves with the right architecture, JIT,
// cache, substrate lookup, and high-level design.
//
// This file is a picture, not a lowering. It names seats the body
// already has. It does not grow a compile cell, an xtal, or a lisp
// twin. Heat will earn an executable when a walk is hot enough to
// want one.
//
// Seats already alive:
//   intern     surface/minimal-surface.fk   (content is identity)
//   cache      form-stdlib/cache.fk         (source ice, .fkb derived)
//   heat       form-stdlib/jit-heat-gate.fk (crystallize on heat, melt)
//   rest       form-stdlib/rest-force-jit.fk (ask, then JIT)
//   offer      Form.cli.offerask            (Offer<T>, lookup, ask)
//   engine     teachings/lc-one-engine.md   (one recipe, speed earned)
//
//////////////////////////////////////////////////////////////////////

package Form.cli.onebody;

import Form.kernel.*;
import Form.cli.flow.*;
import Form.cli.offerask.*;

enum Phase [public] {
   ICE,
   WATER,
   GAS,
   HEAT
}

interface IIce [public, witness, reusable] {
   section [public] {
      const String Seat = "BML or higher is the only ice";
      const String TrustRule = "author here; do not twin a lowering as a second ice";
   }
}

interface ILookup [public, witness, reusable] {
   section [public] {
      const String Seat = "intern_node / node_eq — content is the address";
      const String TrustRule = "same meaning, one node; lookup, not a published copy";
   }
}

interface ICache [public, witness, reusable] {
   section [public] {
      const String Seat = "cache-fresh? — derived image, disposable";
      const String TrustRule = "missing or older than ice regenerates; git does not keep it";
   }
}

interface IHeat [public, witness, reusable] {
   section [public] {
      const String Seat = "hg-request — crystallize on heat, melt on cool";
      const String TrustRule = "speed is earned at the door; an unspecialized walk is honest Form";
   }
}

template BodyCell<TMeaning> [public, reusable] {
   section [public] {
      TMeaning Ice() [get];
      TMeaning Looked() [get];
      TMeaning Cached() [get];
      TMeaning Hot() [get];
   }
}

class FormOneBody [public, reusable, teach] {
   section [public] {
      const String PicturePath = "form/form-stdlib/bml/form-cli-one-body.bml";
      const String Pattern = "one-ice intern-lookup disposable-cache heat-at-door offer-ask";
      const int InventedNeed = 0;
   }
}

class FormOneBodySelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-one-body-self";
      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return false; }
      bool Trustable() [witness] { return true; }
   }
}
