// preludes: form/form-stdlib/bml/ear-listening.bml
section [form.bml] {
 class EarListeningBand {
  def elpb-bit(ok, bit) = if ok then bit else 0;
  def elpb-fold(rows, bit, acc) = if ((Comparable) len(rows) == 0) then acc else elpb-fold(tail(rows), (bit * 2), (acc + elpb-bit(head(rows), bit)));
  def elp-test() {
   let noise = head(elp-step(elp-born(), 70, 150, 3200, 0));
   let quiet = elp-step(noise, 90, 220, 3200, 0);
   let first = elp-step(noise, 160, 500, 3200, 0);
   let second = elp-step(head(first), 160, 500, 3200, 0);
   let hold = elp-step(head(second), 110, 300, 3200, 1);
   let rest = elp-step(head(hold), 70, 150, 3200, 1);
   let gentle = head(elp-step(elp-born(), 3, 8, 3200, 0));
   let low1 = elp-step(gentle, 18, 56, 3200, 0);
   let low2 = elp-step(head(low1), 18, 56, 3200, 0);
   let m = elp-meta-push(list(list(256000, 30000)), 3200, 56);
   let m2 = elp-meta-push(m, 256000, 56);
   let stats = elp-stats(str_concat(str_concat(byte_to_str(0), byte_to_str(128)), str_concat(byte_to_str(255), byte_to_str(127))));
   elpb-fold(list(
    ((Comparable) elp-floor(noise) == 70),
    ((Comparable) nth(quiet, 1) == 0),
    ((Comparable) nth(first, 1) == 0),
    (((Comparable) nth(second, 1) == 1) && ((Comparable) elp-floor(head(second)) == 70)),
    ((Comparable) nth(hold, 1) == 1),
    ((Comparable) nth(rest, 1) == 0),
    ((Comparable) nth(elp-step(noise, 300, 905, 3200, 0), 1) == 1),
    (((Comparable) nth(low1, 1) == 0) && ((Comparable) nth(low2, 1) == 1)),
    (((Comparable) elp-quiet-cut(5000) == 0) && ((Comparable) elp-quiet-cut(64000) == 32000)),
    (((Comparable) elp-gain(0) == 1000) && ((Comparable) elp-gain(32768) == 1000)),
    (((Comparable) elp-gain(56) == 16000) && ((Comparable) elp-gain(256) == 4000)),
    (((Comparable) elp-meta-bytes(m) == 256000) && ((Comparable) elp-peak(m) == 30000)),
    (((Comparable) elp-meta-bytes(m2) == 256000) && ((Comparable) elp-peak(m2) == 56)),
    (((Comparable) head(stats) == 32767) && ((Comparable) nth(stats, 1) == 32768)),
    ((Comparable) len(elp-revision-prefix(list(1, 2, 3, 4), list(1, 2, 3, 4))) == 0),
    (((Comparable) head(elp-stats("")) == 0) && ((Comparable) nth(elp-step(noise, 0, 0, 3200, 0), 1) == 0)),
    ((String) elp-close(50, 1000, 5, 0) == ""),
    ((String) elp-close(200, 200, 1, 0) == "decoder"),
    (((String) elp-close(501, -1, 0, 0) == "pause") && ((String) elp-close(0, -1, 0, 1) == "full")),
    ((Comparable) elp-window-gain(noise) == 1000),
    ((Comparable) nth(elp-step(head(elp-step(noise, 0, 0, 3200, 0)), 90, 220, 3200, 0), 1) == 0),
    (((Comparable) elp-db(8) == -72) && (((Comparable) elp-db(1) == -90) && ((Comparable) elp-db(0) == -120)))
   ), 1, 0);
  }
 }
}
