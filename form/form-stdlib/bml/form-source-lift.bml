// Cursor-based Form-to-BML lifting. A candidate is admitted only when lowering
// reconstructs the original syntax tree, including evaluation order and scope.
// preludes: form-stdlib/source-compiler.fk form-stdlib/bml/string-join.bml
section [form.bml] {
 def fsl-ws(c) = c == 32 || c == 10 || c == 13 || c == 9;
 def fsl-skip(s,i) = i >= str_len(s) ? i : fsl-ws(str_byte_at(s,i)) ? fsl-skip(s,i + 1) : str_byte_at(s,i) == 59 ? {
  let end = str_find(s,"\n",i); end < 0 ? str_len(s) : fsl-skip(s,end + 1);
 } : i;
 def fsl-end(s,i) = i >= str_len(s) ? i : (fsl-ws(str_byte_at(s,i)) || str_byte_at(s,i) == 40 || str_byte_at(s,i) == 41 || str_byte_at(s,i) == 59) ? i : fsl-end(s,i + 1);
 def fsl-word(n) = head(n);
 def fsl-kids(n) = nth(n,1);
 def fsl-op(n) = nil?(fsl-kids(n)) ? "" : fsl-word(head(fsl-kids(n)));
 def fsl-quote(s,i) = i >= str_len(s) ? form_error("lift: unterminated string") :
  str_byte_at(s,i) == 92 ? fsl-quote(s,i + 2) : str_byte_at(s,i) == 34 ? i + 1 : fsl-quote(s,i + 1);
 def fsl-read(s,i) {
  let at = fsl-skip(s,i); let prefix = substring(s,i,at);
  if at >= str_len(s) then form_error("lift: missing expression") else
  if str_byte_at(s,at) == 40 then {
   let group = fsl-sequence(s,at + 1,list(),1);
   list(list("",head(group),prefix,nth(group,2)),nth(group,1));
  } else {
   let end = str_byte_at(s,at) == 34 ? fsl-quote(s,at + 1) : fsl-end(s,at);
   end <= at ? form_error("lift: unexpected delimiter") : list(list(substring(s,at,end),list(),prefix,""),end);
  };
 }
 def fsl-sequence(s,i,out,group) {
  let at = fsl-skip(s,i);
  if at >= str_len(s) then (group ? form_error("lift: unclosed group") : list(reverse(out),at,substring(s,i,at)))
  else if str_byte_at(s,at) == 41 then (group ? list(reverse(out),at + 1,substring(s,i,at)) : form_error("lift: unexpected close"))
  else { let next = fsl-read(s,i); fsl-sequence(s,nth(next,1),cons(head(next),out),group); };
 }
 def fsl-parse(s) = head(fsl-sequence(s,0,list(),0));
 def fsl-comments(text,indent) = str_find(text,";",0) < 0 ? "" : str-join(map(line => {
  let clean = trim(line);
  str_len(clean) > 0 ? str_concat(indent,str_concat("//",str_concat(substring(clean,1,str_len(clean)),"\n"))) : "";
 },split-on(text,"\n")));
 def fsl-root(nodes) = foldr((n,out) => ((String) fsl-op(n) == "do") ? append(fsl-root(tail(fsl-kids(n))),out) : cons(n,out),list(),nodes);
 def fsl-shape(n) = fsl-string?(n) ? list("$string",bmf-unescape-str(substring(fsl-word(n),1,str_len(fsl-word(n)) - 1))) : list(fsl-word(n) == "true" ? "1" : fsl-word(n) == "false" ? "0" : fsl-word(n),map(fsl-shape,fsl-kids(n)));
 def fsl-shapes(nodes) = map(fsl-shape,fsl-root(nodes));
 def fsl-definitions(nodes) = foldl((count,n) => count + (((String) fsl-op(n) == "defn") ? 1 : 0) + fsl-definitions(fsl-kids(n)),0,nodes);
 // One operator description owns spelling, precedence and comparison contract.
 let fsl-call-rule = list("",8,"");
 let fsl-operators = record_new(0,
  "add",list("+",5,""),"sub",list("-",5,""),"mul",list("*",6,""),"div",list("/",6,""),"mod",list("%",6,""),
  "lt",list("<",4,""),"le",list("<=",4,""),"gt",list(">",4,""),"ge",list(">=",4,""),
  "eq",list("==",4,"(Comparable) "),"ne",list("!=",4,"(Comparable) "),
  "str_eq",list("==",4,"(String) "),"value_eq",list("==",4,"(Value) "),
  "and",list("&&",3,""),"or",list("||",2,""),"if",list("",1,""),"not",list("",7,""));
 def fsl-rule(op) = record_has(fsl-operators,op) ? record_get(fsl-operators,op) : fsl-call-rule;
 def fsl-args(nodes,indent) = str-join-with(map(n => fsl-expr(n,indent),nodes),", ");
 def fsl-expr(n,indent) = fsl-render(n,indent,0);
 def fsl-string?(n) = str_byte_at(fsl-word(n),0) == 34;
 def fsl-render(n,indent,parent) {
  let op = fsl-op(n); let kids = fsl-kids(n); let args = nil?(kids) ? list() : tail(kids);
  let rule = fsl-rule(op); let infix = head(rule); let priority = nth(rule,1);
  let text = if nil?(kids) then fsl-word(n) else
   if (op == "do") then str-join(list("{\n",fsl-statements(args,str_concat(indent,"    ")),indent,"}")) else
   if ((op == "if") && len(args) == 3) then str-join(list(fsl-render(head(args),indent,2)," ? ",fsl-render(nth(args,1),indent,0)," : ",fsl-render(nth(args,2),indent,1))) else
   if ((infix != "") && len(args) == 2) then {
    let contract = nth(rule,2);
    str-join(list(contract,fsl-render(head(args),indent,contract != "" ? 8 : priority == 4 ? priority + 1 : priority)," ",infix," ",fsl-render(nth(args,1),indent,priority + 1)));
   } else if ((op == "not") && len(args) == 1) then str_concat("!",fsl-render(head(args),indent,priority))
   else str-join(list(fsl-expr(head(kids),indent),"(",fsl-args(args,indent),")"));
  str_concat(fsl-comments(nth(n,2),indent),priority < parent ? str-join(list("(",text,")")) : text);
 }
 def fsl-statement(n,indent) {
  let op = fsl-op(n); let kids = fsl-kids(n);
  let text = if op == "defn" then str-join(list("def ",fsl-word(nth(kids,1)),"(",str-join-with(map(fsl-word,fsl-kids(nth(kids,2))),", "),") = ",fsl-expr(nth(kids,3),indent))) else
   if op == "let" then str-join(list("let ",fsl-word(nth(kids,1))," = ",fsl-expr(nth(kids,2),indent))) else fsl-expr(list(fsl-word(n),kids,"",nth(n,3)),indent);
  str-join(list(fsl-comments(nth(n,2),indent),indent,text,";\n"));
 }
 def fsl-statements(nodes,indent) = str-join(map(n => fsl-statement(n,indent),nodes));
 def fsl-literal-name?(n) = (String) fsl-word(n) == "true" || (String) fsl-word(n) == "false";
 def fsl-literal-bindings?(nodes) = any?(n => {
  let kids = fsl-kids(n); let op = fsl-op(n);
  (op == "let" && fsl-literal-name?(nth(kids,1))) ||
  (op == "defn" && (fsl-literal-name?(nth(kids,1)) || any?(fsl-literal-name?,fsl-kids(nth(kids,2))))) || fsl-literal-bindings?(kids);
 },nodes);
 def form-source-lift(source,owner) {
  let parsed = fsl-parse(source); let first = head(parsed);
  let body = nil?(parsed) ? list() : fsl-root(cons(list(fsl-word(first),fsl-kids(first),"",nth(first,3)),tail(parsed)));
  let candidate = str-join(list(fsl-comments(nil?(parsed) ? source : nth(first,2),""),"section [form.bml] {\n",fsl-statements(body,"    "),"}\n"));
  // The lift preserves names and dependencies. Read their contracts from the
  // original Form directly, without lowering the candidate once for discovery
  // and again for execution. The comparison below still owns admission.
  let homes = fsc-bml-home-context(owner);
  let catalog = fsc-bml-file-signatures(owner,source,list(owner),list(),nth(homes,1),head(homes));
  let lowered = form-source-compile-loop(candidate,owner,0,nth(catalog,1));
  let same = !fsl-literal-bindings?(parsed) && (Value) fsl-shapes(parsed) == fsl-shapes(fsl-parse(lowered));
  list(same,candidate,fsl-definitions(parsed),lowered);
 }
}
