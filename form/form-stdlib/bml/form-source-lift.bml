// Native Form and BML lifting. A candidate is admitted only when lowering
// preserves the admitted operand contracts, evaluation order and scope.
import form-stdlib/source-compiler.fk;
import form-stdlib/bml/string-join.bml;
section [form.bml] {
 def fsl-ws(c) = c == 32 || c == 10 || c == 13 || c == 9;
 def fsl-skip(s,i) = i >= len(s) ? i : fsl-ws(str_byte_at(s,i)) ? fsl-skip(s,i + 1) : str_byte_at(s,i) == 59 ? {
  let end = str_find(s,"\n",i); end < 0 ? len(s) : fsl-skip(s,end + 1);
 } : i;
 def fsl-end(s,i) = i >= len(s) ? i : (fsl-ws(str_byte_at(s,i)) || str_byte_at(s,i) == 40 || str_byte_at(s,i) == 41 || str_byte_at(s,i) == 59) ? i : fsl-end(s,i + 1);
 def fsl-word(n) = n[0];
 def fsl-kids(n) = n[1];
 def fsl-op(n) = nil?(fsl-kids(n)) ? "" : fsl-word(fsl-kids(n)[0]);
 def fsl-quote(s,i) = i >= len(s) ? form_error("lift: unterminated string") :
  str_byte_at(s,i) == 92 ? fsl-quote(s,i + 2) : str_byte_at(s,i) == 34 ? i + 1 : fsl-quote(s,i + 1);
 def fsl-read(s,i) {
  let at = fsl-skip(s,i); let prefix = substring(s,i,at);
  if at >= len(s) then form_error("lift: missing expression") else
  if str_byte_at(s,at) == 40 then {
   let group = fsl-sequence(s,at + 1,[],1);
   [["",group[0],prefix,group[2]],group[1]];
  } else {
   let end = str_byte_at(s,at) == 34 ? fsl-quote(s,at + 1) : fsl-end(s,at);
   end <= at ? form_error("lift: unexpected delimiter") : [[substring(s,at,end),[],prefix,""],end];
  };
 }
 def fsl-sequence(s,i,out,group) {
  let at = fsl-skip(s,i);
  if at >= len(s) then (group ? form_error("lift: unclosed group") : [reverse(out),at,substring(s,i,at)])
  else if str_byte_at(s,at) == 41 then (group ? [reverse(out),at + 1,substring(s,i,at)] : form_error("lift: unexpected close"))
  else { let next = fsl-read(s,i); fsl-sequence(s,next[1],cons(next[0],out),group); };
 }
 def fsl-parse(s) = fsl-sequence(s,0,[],0)[0];
 def fsl-comments(text,indent) = str_find(text,";",0) < 0 ? "" : str-join(map(line => {
  let clean = trim(line);
  len(clean) > 0 ? (indent + ("//" + (substring(clean,1,len(clean)) + "\n"))) : "";
 },split-on(text,"\n")));
 // Remove the single module wrapper only. Nested top-level blocks keep scope.
 def fsl-root(nodes) = len(nodes) == 1 && (String) fsl-op(nodes[0]) == "do" ? fsl-kids(nodes[0])[1:] : nodes;
 // Imports belong to the loader, outside the executable section. Preserve
 // their spelling and order; the dependency comparison also checks comments.
 def fsl-import?(nodes) = len(nodes) >= 2 && (String) fsl-word(nodes[0]) == "import" && nil?(fsl-kids(nodes[1])) && str_find(nodes[1][2],"\n",0) < 0;
 def fsl-module(nodes,imports,body) = nil?(nodes) ? [reverse(imports),reverse(body)] :
  fsl-import?(nodes) ? fsl-module(nodes[1:][1:],cons(nodes[1],cons(nodes[0],imports)),body) : fsl-module(nodes[1:],imports,cons(nodes[0],body));
 def fsl-import-text(nodes) = nil?(nodes) ? "" : str-join([fsl-comments(nodes[0][2],""),"import ",fsl-word(nodes[1]),"\n",fsl-import-text(nodes[1:][1:])]);
 // The compiler spells a quoted semicolon as byte_to_str(59), joined to
 // neighboring literal spans. Only closed string construction can normalize;
 // calls with variables or effects retain their complete structure.
 def fsl-constant-string(n) {
  let kids = fsl-kids(n); let op = fsl-op(n);
  if fsl-string?(n) then fsc-unescape-str(substring(fsl-word(n),1,len(fsl-word(n)) - 1))
  else if op == "byte_to_str" && len(kids) == 2 && (String) fsl-word(kids[1]) == "59" then ";"
  else if op == "str_concat" && len(kids) == 3 then {
   let left = fsl-constant-string(kids[1]); let right = fsl-constant-string(kids[2]);
   nothing?(left) || nothing?(right) ? fail : ((String) left + right);
  } else fail;
 }
 def fsl-shape(n) {
  let text = fsl-constant-string(n);
  let word = fsl-word(n) == "true" ? "1" : fsl-word(n) == "false" ? "0" : fsl-word(n);
  !nothing?(text) ? ["$string",text] : nil?(fsl-kids(n)) && fsc-int?(word) ? ["$number",intern_trivial_int(str_to_int(word)),false] :
   nil?(fsl-kids(n)) && fsc-float?(word) ? ["$number",intern_trivial_float(word),str_to_float(word) == 0.0 && substring(word,0,1) == "-"] :
   [word,map(fsl-shape,fsl-kids(n))];
 }
 def fsl-shapes(nodes) {
  let module = fsl-module(nodes,[],[]);
  append(map(fsl-shape,module[0]),map(fsl-shape,fsl-root(module[1])));
 }
 def fsl-definitions(nodes) = foldl((count,n) => count + (((String) fsl-op(n) == "defn") ? 1 : 0) + fsl-definitions(fsl-kids(n)),0,nodes);
 // Grammar owns operator spelling and precedence; the lift retains the source
 // comparison contract. Conditional priority is below every binary operator.
 let fsl-call-priority = foldl((p,row) => max2(p,row[2] + 3),0,form-bml-operators());
 let fsl-call-rule = ["",fsl-call-priority,""];
 let fsl-operators = foldl((table,row) => record_set(table,row[1],
  [row[0],row[2] + 1,(row[1] == "eq" || row[1] == "ne") ? "(Comparable) " : ""]),
  record_new(0,"if",["",0,""],"not",["",fsl-call-priority - 1,""]),form-bml-operators());
 record_set(fsl-operators,"str_eq",["==",record_get(fsl-operators,"eq")[1],"(String) "]);
 record_set(fsl-operators,"value_eq",["==",record_get(fsl-operators,"eq")[1],"(Value) "]);
 def fsl-rule(op) = record_has(fsl-operators,op) ? record_get(fsl-operators,op) : fsl-call-rule;
 def fsl-args(nodes,indent) = str-join-with(map(n => fsl-expr(n,indent),nodes),", ");
 def fsl-expr(n,indent) = fsl-render(n,indent,0);
 def fsl-string?(n) = str_byte_at(fsl-word(n),0) == 34;
 def fsl-case?(n,subject) {
  let kids = fsl-kids(n);
  if fsl-op(n) != "if" || len(kids) != 4 then false else {
   let test = fsl-kids(kids[1]);
   fsl-op(kids[1]) == "value_eq" && len(test) == 3 &&
    fsl-shape(test[1]) == fsl-shape(subject) && fsl-word(test[2]) != "_";
  };
 }
 def fsl-match-subject(n) {
  let kids = fsl-kids(n);
  if fsl-op(n) != "if" || len(kids) != 4 then fail else {
   let test = fsl-kids(kids[1]); let subject = test[1];
   fsl-op(kids[1]) == "value_eq" && len(test) == 3 && nil?(fsl-kids(subject)) &&
    fsl-case?(n,subject) && fsl-case?(kids[3],subject) ? subject : fail;
  };
 }
 def fsl-match-arms(n,subject,indent) = fsl-case?(n,subject) ? {
  let kids = fsl-kids(n); let test = fsl-kids(kids[1]);
  str-join([fsl-comments(n[2],indent),fsl-comments(kids[1][2],indent),indent,
   fsl-expr(test[2],indent)," => ",fsl-expr(kids[2],indent),",\n",fsl-match-arms(kids[3],subject,indent)]);
 } : str-join([indent,"_ => ",fsl-expr(n,indent),"\n"]);
 def fsl-render(n,indent,parent) {
  let op = fsl-op(n); let kids = fsl-kids(n); let args = nil?(kids) ? [] : kids[1:];
  let rule = fsl-rule(op); let infix = rule[0]; let priority = rule[1];
  let subject = fsl-match-subject(n);
  let text = if nil?(kids) then fsl-word(n) else
   if (op == "do") then str-join(["{\n",fsl-statements(args,(indent + "    ")),indent,"}"]) else
   if !nothing?(subject) then str-join(["match ",fsl-expr(subject,indent)," {\n",fsl-match-arms([fsl-word(n),kids,"",n[3]],subject,(indent + "    ")),indent,"}"]) else
   if ((op == "if") && len(args) == 3) then str-join([fsl-render(args[0],indent,1)," ? ",fsl-render(args[1],indent,0)," : ",fsl-render(args[2],indent,0)]) else
   if op == "list" then str-join(["[",fsl-args(args,indent),"]"]) else
   if op == "add" && len(args) == 2 then str-join(["(Number) ",fsl-render(args[0],indent,fsl-call-priority)," + (Number) ",fsl-render(args[1],indent,fsl-call-priority)]) else
   if ((infix != "") && len(args) == 2) then {
    let contract = rule[2];
    str-join([contract,fsl-render(args[0],indent,contract != "" ? fsl-call-priority : priority)," ",infix," ",fsl-render(args[1],indent,priority + 1)]);
   } else if ((op == "not") && len(args) == 1) then ("!" + fsl-render(args[0],indent,priority))
   else str-join([fsl-expr(kids[0],indent),"(",fsl-args(args,indent),")"]);
  ((String) fsl-comments(n[2],indent) + (priority < parent ? str-join(["(",text,")"]) : text));
 }
 def fsl-statement(n,indent) {
  let op = fsl-op(n); let kids = fsl-kids(n);
  let text = if op == "defn" then str-join(["def ",fsl-word(kids[1]),"(",str-join-with(map(fsl-word,fsl-kids(kids[2])),", "),") = ",fsl-expr(kids[3],indent)]) else
   if op == "let" then str-join(["let ",fsl-word(kids[1])," = ",fsl-expr(kids[2],indent)]) else fsl-expr([fsl-word(n),kids,"",n[3]],indent);
  str-join([fsl-comments(n[2],indent),indent,text,";\n"]);
 }
 def fsl-statements(nodes,indent) = str-join(map(n => fsl-statement(n,indent),nodes));
 def fsl-literal-names() = ["true","false","str_concat","byte_to_str"];
 def fsl-literal-name?(n) = any?(name => (String) fsl-word(n) == name,fsl-literal-names());
 def fsl-literal-bindings?(nodes) = any?(n => {
  let kids = fsl-kids(n); let op = fsl-op(n);
  (op == "let" && fsl-literal-name?(kids[1])) ||
  (op == "defn" && (fsl-literal-name?(kids[1]) || any?(fsl-literal-name?,fsl-kids(kids[2])))) || fsl-literal-bindings?(kids);
 },nodes);
 // Retain the authored BML structure; rewrite only complete calls inside its
 // executable sections. Quoted text, comments, declarations and other dialects
 // stay in place. The existing lowering remains the admission authority.
 def fsl-commented?(cursor) {
  let at = skip-ws(cursor); let gap = cur-slice(cursor,cur-pos(at)); let ch = cur-peek-char(at);
  str_find(gap,"//",0) >= 0 || str_find(gap,"/*",0) >= 0 ? true : cur-eof?(at) ? false :
   fsl-commented?(ch == "\"" || ch == "'" ? cur-advance(gm-q-scan(cur-advance(at,1),cur-peek(at)),1) : cur-advance(at,1));
 }
 def fsl-surface-base(grammar,text) {
  let value = trim(text);
  choice {
   (str_find(text,"//",0) >= 0 || str_find(text,"/*",0) >= 0) && fsl-commented?(cursor-str(text)) ? str-join(["(",text,"\n)"]) : fail;
   substring(value,0,1) == "(" && fsc-bml-span-end(value,1,len(value),[")"],"group") == len(value) - 1 ? value : fail;
   { let parsed = g-match-rule(grammar,"callchain",cursor-str(value)); rok?(parsed) && cur-eof?(skip-ws(rok-cur(parsed))) ? value : fail; };
   str-join(["(",value,")"]);
  };
 }
 // Read balanced spans once. Full expression parsing belongs to admission,
 // after rewriting; reparsing every enclosing call makes nesting quadratic.
 // A generic suffix is a group only when it is followed by a call.
 def fsl-arg-end(cursor,closers) {
  let at = skip-ws(cursor); let ch = cur-peek-char(at);
  if cur-eof?(at) then fail
  else if nil?(closers) && (ch == "," || ch == ")") then at
  else if ch == "\"" || ch == "'" then fsl-arg-end(cur-advance(gm-q-scan(cur-advance(at,1),cur-peek(at)),1),closers)
  else if ch == "(" || ch == "[" || ch == "{" then fsl-arg-end(cur-advance(at,1),cons(ch == "(" ? ")" : ch == "[" ? "]" : "}",closers))
  else if ch == ")" || ch == "]" || ch == "}" then
   nil?(closers) || ch != closers[0] ? fail : fsl-arg-end(cur-advance(at,1),closers[1:])
  else if ch == "<" then {
   let generic = gen-scan(cur-advance(at,1),1);
   fsl-arg-end(!nil?(generic) && cur-peek-char(skip-ws(generic)) == "(" ? generic : cur-advance(at,1),closers);
  } else fsl-arg-end(cur-advance(at,1),closers);
 }
 def fsl-surface-args(grammar,cursor,values) {
  let at = skip-ws(cursor);
  if cur-peek-char(at) == ")" then [cur-advance(at,1),reverse(values)] else {
   let next = fsl-arg-end(at,[]);
   if nothing?(next) then fail else {
    let mark = cur-peek-char(next);
    let items = cons(cur-slice(cursor,cur-pos(next)),values);
    mark == "," ? fsl-surface-args(grammar,cur-advance(next,1),items) :
     mark == ")" ? [cur-advance(next,1),reverse(items)] : fail;
   };
  };
 }
 def fsl-surface-call(grammar,word,values,local-renderer) {
  let args = map(value => fsl-surface-walk(grammar,cursor-str(value),"",[],local-renderer),values);
  let base = nil?(args) ? "" : fsl-surface-base(grammar,args[0]);
  if word == "list" then str-join(["[",str-join-with(args,","),"]"])
  else if len(args) == 1 then match word {
   "head" => str-join([base,"[0]"]),
   "tail" => str-join([base,"[1:]"]),
   "str_len" => str-join(["len(",args[0],")"]),
   "int_to_str" => str-join([base,".str()"]),
   "value_str" => str-join([base,".str()"]),
   _ => fail
  } else if len(args) != 2 then fail else if word == "nth" then {
   let index = fsc-compile-form-bml-expr-recipe(args[1]);
   fsc-source-leaf?(index) && node_type(index) == 1 && node_value(index) >= 0 ?
    str-join([base,"[",trim(args[1]),"]"]) : fail;
  }
  else if word == "range" then str-join(["(",base," .. ",fsl-surface-base(grammar,args[1]),")"])
  else if word == "str_concat" then {
   let text = any?(arg => fsl-text?(fsc-compile-form-bml-expr-recipe(arg)),args);
   str-join(["(",text ? "" : "(String) ",base," + ",fsl-surface-base(grammar,args[1]),")"]);
  }
  else {
   let rule = fsl-rule(word); let right = fsl-surface-base(grammar,args[1]);
   rule[0] == "" ? fail : word == "add" ? str-join(["((Number) ",base," + (Number) ",right,")"]) :
    str-join(["(",rule[2],base," ",rule[0]," ",right,")"]);
  };
 }
 let fsl-surface-calls = foldl((names,name) => record_set(names,name,1),record_new(0),
  append(["list","nth","range","head","tail","str_len","str_concat","int_to_str","value_str"],record_keys(fsl-operators)));
 def fsl-surface-walk(grammar,cursor,previous,pieces,local-renderer) {
  let at = skip-ws(cursor);
  if cur-eof?(at) then str-join(reverse(cons(cur-slice(cursor,cur-pos(at)),pieces))) else {
   let quoted = cur-peek-char(at) == "\"" || cur-peek-char(at) == "'";
   let name = is-alpha-cp(cur-peek(at)) || cur-peek(at) == 36 ? match-pat(p-run("bmlname"),at,caps-empty()) : nothing;
   let after = quoted ? cur-advance(gm-q-scan(cur-advance(at,1),cur-peek(at)),1) :
    !nothing?(name) && m-ok?(name) ? m-cur(name) : cur-advance(at,1);
   let word = cur-slice(at,cur-pos(after)); let open = skip-ws(after);
   let eligible = previous != "def" && previous != "." && (!local-renderer || word != "int_to_str") &&
    record_has(fsl-surface-calls,word) && cur-peek-char(open) == "(";
   let parsed = eligible ? fsl-surface-args(grammar,cur-advance(open,1),[]) : nothing();
   let replacement = nothing?(parsed) ? fail : fsl-surface-call(grammar,word,parsed[1],local-renderer);
   let prefix = cur-slice(cursor,cur-pos(at));
   nothing?(replacement) ? fsl-surface-walk(grammar,after,word,cons(((String) prefix + word),pieces),local-renderer) :
    fsl-surface-walk(grammar,parsed[0],")",cons(str-join([prefix,cur-slice(after,cur-pos(open)),replacement]),pieces),local-renderer);
  };
 }
 def fsl-surface-parts(source,start,read-body) {
  let at = fsc-find-section-open(source,start);
  if at < 0 then [substring(source,start,len(source))] else {
   let dialect-end = fsc-find-char-from(source,"]",at + 9);
   let open = fsc-find-char-from(source,"{",dialect-end);
   let dialect = substring(source,at + 9,dialect-end);
   let close = fsc-high-level-form-dialect?(dialect) ? fsc-bml-block-end(source,open + 1,0) : fsc-section-end(source,open + 1);
   let body = substring(source,open + 1,close);
   append([substring(source,start,open + 1),dialect == "form.bml" ? read-body(body) : body,
    substring(source,close,fsc-section-after(source,close))],fsl-surface-parts(source,fsc-section-after(source,close),read-body));
  };
 }
 def fsl-surface-sections(source,start) {
  let grammar = form-bml-grammar();
  str-join(fsl-surface-parts(source,start,body => {
   let local-renderer = str_find(body,"int_to_str",0) >= 0 && fsl-binding?(fsc-rec-do(fsc-form-bml-lines-recipes-loop(body,0,[])),"int_to_str");
   fsl-surface-walk(grammar,cursor-str(body),"",[],local-renderer);
  }));
 }
 // Module imports retain dependency order and loader spelling. Quoted source
 // specimens are data, even when one of their lines resembles a directive.
 def fsl-import-lines(lines,quoted,continued) = nil?(lines) ? [] : {
  let line = lines[0]; let clean = trim(line);
  let payload = quoted ? nothing : bml-source-prelude-line(line);
  let text = continued ? (substring(clean,0,2) == "//" ? substring(clean,2,len(clean)) :
   substring(clean,0,1) == ";" ? substring(clean,1,len(clean)) : form_error("import lift: missing prelude continuation")) : payload;
  let dependencies = nothing?(text) ? [[],0] : bml-source-dependency-tokens(bml-source-words(text),[]);
  let replacement = nothing?(text) ? line : str-join-with(map(path => str-join(["import ",path,";"]),dependencies[0]),"\n");
  let next-quoted = !quoted && (substring(clean,0,1) == ";" || substring(clean,0,2) == "//") ? false : bml-source-quote-state(line,0,quoted,0);
  cons(replacement,fsl-import-lines(lines[1:],next-quoted,dependencies[1]));
 };
 def form-bml-import-lift(source) = str-join-with(fsl-import-lines(split-on(source,"\n"),false,false),"\n");
 // These normalizations express the supported source domains: string length,
 // value rendering, list indexing and list remainder. Broader value behavior
 // is established by the shared value-operator execution witness.
 def fsl-binding?(recipe,name) {
  let kids = node_children(recipe); let category = node_category(recipe);
  let declares = node_eq(category,fsc-rec-FNDEF-CAT) || node_eq(category,fsc-rec-LET-CAT);
  (declares && fsc-bml-binding(node_value(kids[0]))[0] == name) ||
   (node_eq(category,fsc-rec-FNDEF-CAT) && any?(row => row[0] == name,fsc-bml-type-params(node_children(kids[1])))) ||
   any?(child => fsl-binding?(child,name),kids);
 }
 def fsl-semantic-recipe(recipe) = fsl-semantic-recipe-in(recipe,fsl-binding?(recipe,"int_to_str"));
 def fsl-semantic-recipe-in(recipe,shadowed) {
  let kids = node_children(recipe); let category = node_category(recipe);
  let call = node_eq(category,fsc-rec-FNCALL-CAT);
  let name = call ? fsc-bml-type-name(kids[0]) : fsc-source-primitive-name(category);
  let args = map(child => fsl-semantic-recipe-in(child,shadowed),call ? kids[1:] : kids);
  if nil?(kids) then recipe
  else if name == "str_len" then fsc-rec-form-call("len",args)
  else if name == "int_to_str" && !shadowed then fsc-rec-form-call("value_str",args)
  else if name == "bml-value-tail" then fsc-rec-form-call("tail",args)
  else if name == "bml-value-first" then fsc-rec-form-call("head",args)
  else if name == "bml-value-slice" && len(args) == 3 && node_eq(args[1],intern_trivial_int(1)) &&
   node_eq(args[2],fsc-rec-call("nothing",[])) then fsc-rec-form-call("tail",[args[0]])
  else if name == "nth" && len(args) == 2 && node_eq(args[1],intern_trivial_int(0)) then fsc-rec-form-call("head",[args[0]])
  else if name == "bml-value-index" && len(args) == 2 && fsc-source-leaf?(args[1]) && node_type(args[1]) == 1 && node_value(args[1]) >= 0 then
   node_value(args[1]) == 0 ? fsc-rec-form-call("head",[args[0]]) : fsc-rec-form-call("nth",args)
  else if name == "bml-value-add" && len(args) == 2 && any?(fsl-text?,args) then
   fsc-rec-form-call("str_concat",map(arg => fsl-add-contract(arg) == "String" ? node_children(arg)[2] : arg,args))
  else if name == "bml-value-add" && len(args) == 2 && fsl-add-contract(args[0]) == "Number" && fsl-add-contract(args[1]) == "Number" then
   fsc-rec-form-call("add",map(arg => node_children(arg)[2],args))
  else if (name == "$bml==" || name == "$bml!=") && any?(arg => fsl-add-contract(arg) != "",args) then
   fsc-bml-typed-equality(name,map(arg => fsl-add-contract(arg) == "" ? [arg,""] : [node_children(arg)[2],fsl-add-contract(arg)],args))[0]
  else call ? fsc-rec-call(name,args) : intern_node(category,args);
 }
 def fsl-add-contract(recipe) = node_eq(node_category(recipe),fsc-rec-FNCALL-CAT) &&
  fsc-bml-type-name(node_children(recipe)[0]) == "$bml-as" ? node_value(node_children(recipe)[1]) : "";
 def fsl-text?(recipe) = fsl-add-contract(recipe) == "String" ||
  fsc-bml-value-contract([recipe,""]) == "String" ||
  (node_eq(node_category(recipe),fsc-rec-FNCALL-CAT) &&
   fsc-bml-type-name(node_children(recipe)[0]) == "bml-value-add" && any?(fsl-text?,node_children(recipe)[1:]));
 def fsl-semantic-structure(source) = fsl-surface-parts(form-bml-import-lift(source),0,body =>
  fsl-semantic-recipe(fsc-rec-do(fsc-form-bml-lines-recipes-loop(body,0,[]))));
 def form-bml-semantic-equivalent?(source,candidate) =
  bml-source-dependencies(source,0) == bml-source-dependencies(candidate,0) &&
   fsl-semantic-structure(source) == fsl-semantic-structure(candidate);
 // Identity before type resolution retains comparison annotations, lexical
 // bindings and call order. Equal recipes receive identical imported context;
 // a surface-only proof need not load that unchanged dependency graph.
 def fsl-surface-structure(source) = fsl-surface-parts(source,0,body => {
  fsc-bml-check-section-refs(body);
  fsc-rec-do(fsc-form-bml-lines-recipes-loop(body,0,[]));
 });
 def form-bml-surface-equivalent?(source,candidate) =
  bml-source-dependencies(source,0) == bml-source-dependencies(candidate,0) &&
   fsl-surface-structure(source) == fsl-surface-structure(candidate);
 def form-bml-source-lift(source,owner) = fsl-surface-verify(source,form-bml-import-lift(fsl-surface-sections(source,0)),owner,record_new(0));
 def fsl-surface-verify(source,candidate,owner,discovery) {
  let same = form-bml-semantic-equivalent?(source,candidate);
  let homes = fsc-bml-home-context(owner);
  let catalog = fsc-bml-file-signatures-in(owner,source,[owner],[],homes[1],homes[0],discovery);
  let after = form-source-compile-loop(candidate,owner,0,catalog[1]);
  [same,candidate,fsl-definitions(fsl-parse(after)),after];
 }
 // Mixed modules retain their authored dialects. Opaque section leaves let
 // the Form reader own the surrounding scope without parsing grammar data.
 def fsl-section-spans(source,start,sections,pieces) {
  let at = fsc-find-section-open(source,start);
  if at < 0 then [str-join(reverse(cons(substring(source,start,len(source)),pieces))),reverse(sections)] else {
   let dialect-end = fsc-find-char-from(source,"]",at + 9);
   let open = fsc-find-char-from(source,"{",dialect-end);
   let dialect = substring(source,at + 9,dialect-end);
   let close = fsc-high-level-form-dialect?(dialect) ? fsc-bml-block-end(source,open + 1,0) : fsc-section-end(source,open + 1);
   let after = fsc-section-after(source,close);
   let marker = "$fsl-section-" + (at.str() + "$");
   str_find(source,marker,0) >= 0 ? form_error("lift: section identity already present") : 0;
   fsl-section-spans(source,after,cons([marker,substring(source,at,after)],sections),
    cons("\n",cons(marker,cons(substring(source,start,at),pieces))));
  };
 }
 def fsl-mixed-flush(pending) = nil?(pending) ? "" : str-join(["section [form.bml] {\n",str-join(reverse(pending)),"}\n"]);
 def fsl-mixed-body(nodes,sections,pending,out) = nil?(nodes) ? str-join(reverse(cons(fsl-mixed-flush(pending),out))) : {
  let n = nodes[0]; let op = fsl-op(n);
  let section = nil?(fsl-kids(n)) && record_has(sections,fsl-word(n));
  if section || op == "do" then {
   let body = section ? record_get(sections,fsl-word(n)) : str-join(["(do\n",fsl-mixed-body(fsl-kids(n)[1:],sections,[],[]),")\n"]);
   fsl-mixed-body(nodes[1:],sections,[],cons(str-join([fsl-comments(n[2],""),body,"\n"]),cons(fsl-mixed-flush(pending),out)));
  } else fsl-mixed-body(nodes[1:],sections,cons(fsl-statement(n,"    "),pending),out);
 };
 def fsl-sections-only?(nodes,sections) = all?(n =>
  nil?(fsl-kids(n)) && record_has(sections,fsl-word(n)) ||
  fsl-op(n) == "do" && fsl-sections-only?(fsl-kids(n)[1:],sections),nodes);
 def fsl-mixed-source-lift(source,owner,discovery) {
  let spans = fsl-section-spans(source,0,[],[]);
  let parsed = fsl-parse(fsc-strip-bml-comments(spans[0]));
  let module = fsl-module(parsed,[],[]); let nodes = fsl-root(module[1]);
  let sections = foldl((r,row) => record_set(r,row[0],row[1]),record_new(0),spans[1]);
  if fsl-sections-only?(nodes,sections) then fsl-surface-verify(source,form-bml-import-lift(fsl-surface-sections(source,0)),owner,discovery) else {
   let candidate = trim(form-bml-import-lift(fsl-import-text(module[0]) + fsl-mixed-body(nodes,sections,[],[]))) + "\n";
   fsl-verify-form(source,candidate,owner,parsed,discovery);
  };
 }
 def form-source-lift(source,owner) = form-source-lift-in(source,owner,record_new(0));
 // Units are [source,owner]. The batch owns only reusable discovery facts;
 // each result keeps its own contract order, proof and lowered executable.
 def form-source-lift-batch(units) {
  let discovery = record_new(0);
  map(unit => form-source-lift-in(unit[0],unit[1],discovery),units);
 }
 def form-source-lift-in(source,owner,discovery) = fsc-find-section-open(source,0) >= 0 ? fsl-mixed-source-lift(source,owner,discovery) : fsl-form-source-lift(source,owner,discovery);
 def fsl-form-source-lift(source,owner,discovery) {
  let parsed = fsl-parse(source); let first = parsed[0];
  let module = fsl-module(nil?(parsed) ? [] : cons([fsl-word(first),fsl-kids(first),"",first[3]],parsed[1:]),[],[]);
  let candidate = str-join([fsl-comments(nil?(parsed) ? source : first[2],""),fsl-import-text(module[0]),"section [form.bml] {\n",fsl-statements(fsl-root(module[1]),"    "),"}\n"]);
  fsl-verify-form(source,candidate,owner,parsed,discovery);
 }
 def fsl-verify-form(source,candidate,owner,parsed,discovery) {
  // The lift preserves names and dependencies. Read their contracts from the
  // original Form directly, without lowering the candidate once for discovery
  // and again for execution. The comparison below still owns admission.
  let homes = fsc-bml-home-context(owner);
  let catalog = fsc-bml-file-signatures-in(owner,source,[owner],[],homes[1],homes[0],discovery);
  let before = form-source-compile-loop(source,owner,0,catalog[1]);
  let lowered = form-source-compile-loop(candidate,owner,0,catalog[1]);
  let shadowed = any?(signature => any?(name => (String) signature[0] == name,fsl-literal-names()),catalog[1]);
  let dependencies = (Value) bml-source-dependencies(source,1) == bml-source-dependencies(candidate,0);
  // Loader dependencies were compared above; their comment/import spelling
  // is separate from the executable module whose scope must stay identical.
  let original = fsl-parse(before);
  let same = dependencies && !shadowed && !fsl-literal-bindings?(parsed) &&
   (Value) fsl-shapes(fsl-module(original,[],[])[1]) == fsl-shapes(fsl-module(fsl-parse(lowered),[],[])[1]);
  let refined = same ? fsl-surface-sections(candidate,0) : candidate;
  [same && form-bml-semantic-equivalent?(candidate,refined),refined,fsl-definitions(original),
   refined == candidate ? lowered : form-source-compile-loop(refined,owner,0,catalog[1])];
 }
}
