// gpu-dispatch.bml — a recipe takes the GPU lane by the shape of its data, and callers never name it.
// A tensor is the tensor organ's value, list(handle, shape, type). A recipe's home asks gd-tensor? of
// its argument: a tensor runs the recipe's own nodes as a Metal kernel, compiled once per process
// through gpu-lower and kept in this unit's record; a list walks the CPU lane as before. A reduce
// answers its float, which is the one wait; a map or a filter answers a resident tensor, so a chain
// of them crosses the membrane once per call and waits only when a number is read.
// The chooser's belief sits here too: representation decides. Resident data takes the GPU; a list
// stays on the CPU lane, because packing a list costs more than the lane's own fold at every size
// measured (a million floats: 10 ms to pack, 2.5 ms to fold). The column behind it, read 15 Sep
// 2026 under host load 6: at 100,000 resident the GPU wins accumulate 1.8x and transform 4.8x and
// sits near parity on reduce and filter; at 19 the CPU wins by three orders.
// preludes: form-stdlib/core.fk form-stdlib/bml/gpu-lower.bml observe/belief-freshness.fk
section [form.bml] {
    class GpuDispatch {
        def gd-tensor?(v) = !((String) value_kind(v) == "list") ? 0 : !((Comparable) len(v) == 3) ? 0 : !((String) value_kind(v[0]) == "int") ? 0 : !((String) value_kind(v[1]) == "list") ? 0 : (String) value_kind(v[2]) == "string" ? 1 : 0;
        def gd-h(t) = t[0];
        def gd-shape(t) = t[1];
        def gd-product(xs) = nil?(xs) ? 1 : (head(xs) * gd-product(tail(xs)));
        def gd-n(t) = gd-product(gd-shape(t));
        def gd-handles(ts) = ts |> map(gd-h);

        // ---- one compile per (defn, bindings) per process ----
        def gd-bind-key(bs) = nil?(bs) ? "" : "|" ++ int_to_str(head(bs)[0]) ++ "=" ++ head(bs)[1] ++ gd-bind-key(tail(bs));
        def gd-key(name, bindings) = name ++ gd-bind-key(bindings);
        def gd-program(name, bindings) {
            let key = gd-key(name, bindings);
            record_has(gd-cache, key) ? record_get(gd-cache, key) : gd-compile(name, bindings, key);
        }
        def gd-compile(name, bindings, key) {
            let prog = gl-program-bound(name, bindings);
            let kept = gl-ok?(prog) ? record_set(gd-cache, key, prog) : 0;
            prog;
        }

        // ---- a call over tensors: a program the lane declines answers its reason, an enqueue Metal declines answers nothing ----
        def gd-call(name, bindings, tensors, init, scalars) {
            let prog = gd-program(name, bindings);
            let n = gd-n(head(tensors));
            let out = gl-ok?(prog) ? gl-run(prog, gd-handles(tensors), n, init, scalars) : nothing();
            !gl-ok?(prog) ? prog : nothing?(out) ? nothing() : (String) prog[4] == "map" ? list(out, list(n), "f32") : (String) prog[4] == "filter" ? list(out, list(n + 1), "f32-counted") : gl-read(out);
        }

        // ---- the chooser's belief ----
        def gd-belief() = bf-belief("gpu-lane-by-representation", 1, 20260915);
        def gd-choose(v) = gd-tensor?(v) ? "gpu" : "cpu";

        // ---- tensors from and to lists: the door packs once; a read-back decodes a small count ----
        def gd-tensor(xs) = list(gl-f32-buf(xs), list(len(xs)), "f32");
        def gd-read(t, n) = gl-read-n(gd-h(t), n);
        def gd-free(t) = metal_buf_free(gd-h(t));
    }
    let gd-cache = record_new(0);
}
