package Form.cli.cellmesh;

import Form.kernel.*;

interface IFormCliCellMesh [public, witness, resident, membrane] {
   section [public] {
      const String Schema = "form-cli-cell-mesh-v1";
      const String FloorRule = "two cells stream interned Form nodes over append-only mesh logs on the fkwu arm; CHANNEL-V0 .fkb waits on write_form_binary; a third observer cell is the shared field both trust";
      const String AxiomRule = "identity is content-addressed (axiom-3); a cell meets another only through an offered interface (axiom-4); send is offer-and-ack of a node (axiom-5)";
      const String TrustRule = "protocol and grammar change are adopted only when the interned protocol node is already on the observer field; a peer cannot mint trust by writing its own channel";
      const String MeshRule = "join adds a cell by opening directed CHANNEL-V0 files to every present peer and to the observer; the mesh is the set of those edges";
      const String GlassRule = "one glass snapshot per mesh names cells, directed edges, observer field, protocol version, honor and invasion counts; payloads never cross the membrane";
      const String EvalRule = "the protocol names the eval door as a Form symbol; v0 streams interned nodes and records intern-node as the door; untrusted execution of a received recipe is a later stone";
      const String SingleWriterRule = "each CHANNEL-V0 file has one writer; the observer field is written only by the observer cell through this organ";

      Object Open(String root, String cellA, String cellB, String observer);
      Object Send(Object mesh, String from, String to, Object payload, Int mode);
      Object Recv(Object mesh, String from, String to, Int since);
      Object PublishProtocol(Object mesh, String observer, Int version, String grammar, String evalDoor);
      Object AdoptProtocol(Object mesh, String cell, Int version, String grammar, String evalDoor);
      Object Join(Object mesh, String cell);
      Object PublishGlass(Object mesh, String glassRoot, Int epoch);
   }
}

class FormCliCellMeshAuthority [public, witness] : IFormCliCellMesh {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-cell-mesh.fk";
   }
}
