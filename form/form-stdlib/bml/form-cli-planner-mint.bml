package Form.cli.plannermint;

import Form.kernel.*;
import Form.cli.flow.*;

enum SampleSplit [public] {
   TRAIN,
   HELDOUT
}

interface IPlannerMint [public, witness, reusable] {
   section [public] {
      const int MixA = 7;
      const int MixB = 13;
      const int NSkills = 8;
      const int NLanes = 9;
      const int LoraWriter = 0;
      const String TrustRule = "learn planner shape not chat; measure heldout; LoRA tensors wait on lift";

      int Mix( int nI, int nMod ) [abstract];
      String Situation( String strSkill, String strLane, int nI, String strSplit ) [abstract];
      int Leakage( Object hRows ) [abstract];
      int Unique( Object hRows ) [abstract];
      int LoraWriterReady() [abstract];
   }
}

template SampleRow<TClass> [public, reusable] {
   section [public] {
      String Split() [get];
      TClass Class() [get];
      String Situation() [get];
   }
}

class FormPlannerMint [public, reusable, teach] : IPlannerMint {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-planner-mint.bml";

      int Mix( int nI, int nMod ) [abstract] {}
      String Situation( String strSkill, String strLane, int nI, String strSplit ) [abstract] {}
      int Leakage( Object hRows ) [abstract] {}
      int Unique( Object hRows ) [abstract] {}
      int LoraWriterReady() [abstract] {}
   }
}

class FormPlannerMintSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-planner-mint-self";
      const String Pattern = "planner-shape no-transcript cartesian-lane overlay-fit";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
