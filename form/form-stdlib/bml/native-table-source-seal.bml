// Shared byte identities for held source publication and table admission.
import form-stdlib/json.fk;
import form-stdlib/bml/native-table-sources.bml;
import form-stdlib/bml/sha256-owned-bytes.bml;
section [form.bml] {
 class NativeTableSourceSeal {
  def ntss-need(ok,reason,path) = if ok then 1 else nts-refuse(reason,path);
  def ntss-get(obj,key) = if json-object-has?(obj,key) then json-object-get(obj,key) else nts-refuse("seal-field",key);
  def ntss-str(obj,key) {
   let value = json-string-value(ntss-get(obj,key));
   if ((String) value_kind(value) == "string") then value else nts-refuse("seal-string",key);
  }
  def ntss-num(obj,key) {
   let value = json-int-value(ntss-get(obj,key));
   if (((String) value_kind(value) == "int") && (value >= 0)) then value else nts-refuse("seal-integer",key);
  }
  def ntss-hex(bytes) = if nil?(bytes) then "" else (((String) json-hex-digit((bytes[0] / 16)) + json-hex-digit((bytes[0] % 16))) + ntss-hex(bytes[1:]));
  def ntss-hash(text) {
   let context = sob-context();
   if !(sob-context-ready(context) && !nothing?(mj-target())) then ntss-hex(sha256-stream-string(text)) else {
    let result = sob-hash-in(context,text);
    ntss-need(record_get(result,"reason") == "ready",record_get(result,"reason"),"source-sha256");
    sob-hex(record_get(result,"digest"),0);
   };
  }
  def ntss-read(path) = nts-read(path);
  def ntss-s(key,value) = json-node-pair(key,json-node-string(value));
  def ntss-n(key,value) = json-node-pair(key,json-node-int(value));
  def ntss-reference(path,text) = json-node-object([ntss-s("path",path),ntss-n("bytes",len(text)),ntss-s("sha256",ntss-hash(text))]);
  def ntss-content-current(row,text) = (((Comparable) ntss-num(row,"bytes") == len(text)) && ((String) ntss-str(row,"sha256") == ntss-hash(text)));
  def ntss-file-current(row,path) = ntss-content-current(row,ntss-read(path));
  def ntss-find(rows,owner) = if nil?(rows) then nothing() else if ((String) ntss-str(rows[0],"owner") == owner) then rows[0] else ntss-find(rows[1:],owner);
  def ntss-parse(path,text) {
   let seal = parse-json(path,text);
   ntss-need(((String) ntss-str(seal,"schema") == "native-table-source-seal-v1"),"seal-schema",path);
   seal;
  }
  def ntss-load(path) = ntss-parse(path,ntss-read(path));
 }
 0;
}
