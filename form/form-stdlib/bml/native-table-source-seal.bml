// Shared byte identities for held source publication and table admission.
// preludes: form-stdlib/bml/native-table-sources.bml form-stdlib/bml/sha256-owned-bytes.bml
section [form.bml] {
 class NativeTableSourceSeal {
  def ntss-need(ok,reason,path) = ok ? 1 : nts-refuse(reason,path);
  def ntss-get(obj,key) = json-object-has?(obj,key) ? json-object-get(obj,key) : nts-refuse("seal-field",key);
  def ntss-str(obj,key) {
   let value = json-string-value(ntss-get(obj,key));
   (String) value_kind(value) == "string" ? value : nts-refuse("seal-string",key);
  }
  def ntss-num(obj,key) {
   let value = json-int-value(ntss-get(obj,key));
   ((String) value_kind(value) == "int") && (value >= 0) ? value : nts-refuse("seal-integer",key);
  }
  def ntss-hex(bytes) = nil?(bytes) ? "" : (json-hex-digit(head(bytes) / 16) ++ json-hex-digit(head(bytes) % 16)) ++ ntss-hex(tail(bytes));
  def ntss-hash(text) {
   let context = sob-context();
   !(sob-context-ready(context) && !nothing?(mj-target())) ? ntss-hex(sha256-stream-string(text)) : {
    let result = sob-hash-in(context,text);
    ntss-need(record_get(result,"reason") == "ready",record_get(result,"reason"),"source-sha256");
    sob-hex(record_get(result,"digest"),0);
   };
  }
  def ntss-read(path) = nts-read(path);
  def ntss-s(key,value) = json-node-pair(key,json-node-string(value));
  def ntss-n(key,value) = json-node-pair(key,json-node-int(value));
  def ntss-reference(path,text) = json-node-object(list(ntss-s("path",path),ntss-n("bytes",str_len(text)),ntss-s("sha256",ntss-hash(text))));
  def ntss-content-current(row,text) = ((Comparable) ntss-num(row,"bytes") == str_len(text)) && ((String) ntss-str(row,"sha256") == ntss-hash(text));
  def ntss-file-current(row,path) = ntss-content-current(row,ntss-read(path));
  def ntss-find(rows,owner) = nil?(rows) ? nothing() : (String) ntss-str(head(rows),"owner") == owner ? head(rows) : ntss-find(tail(rows),owner);
  def ntss-parse(path,text) {
   let seal = parse-json(path,text);
   ntss-need((String) ntss-str(seal,"schema") == "native-table-source-seal-v1","seal-schema",path);
   seal;
  }
  def ntss-load(path) = ntss-parse(path,ntss-read(path));
 }
 0;
}
