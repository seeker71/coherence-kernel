// Shared byte identities for held source publication and table admission.
// preludes: form-stdlib/bml/native-table-sources.bml form-stdlib/sha256.fk
section [form.bml] {
 class NativeTableSourceSeal {
  def ntss-need(ok,reason,path) = if ok then 1 else nts-refuse(reason,path);
  def ntss-get(obj,key) = if json-object-has?(obj,key) then json-object-get(obj,key) else nts-refuse("seal-field",key);
  def ntss-str(obj,key) {
   let value = json-string-value(ntss-get(obj,key));
   if str_eq(value_kind(value),"string") then value else nts-refuse("seal-string",key);
  }
  def ntss-num(obj,key) {
   let value = json-int-value(ntss-get(obj,key));
   if and(str_eq(value_kind(value),"int"),ge(value,0)) then value else nts-refuse("seal-integer",key);
  }
  def ntss-hex(bytes) = if nil?(bytes) then "" else str_concat(str_concat(json-hex-digit(div(head(bytes),16)),json-hex-digit(mod(head(bytes),16))),ntss-hex(tail(bytes)));
  def ntss-hash(text) = ntss-hex(sha256-stream-string(text));
  def ntss-read(path) = nts-read(path);
  def ntss-s(key,value) = json-node-pair(key,json-node-string(value));
  def ntss-n(key,value) = json-node-pair(key,json-node-int(value));
  def ntss-reference(path,text) = json-node-object(list(ntss-s("path",path),ntss-n("bytes",str_len(text)),ntss-s("sha256",ntss-hash(text))));
  def ntss-content-current(row,text) = and(eq(ntss-num(row,"bytes"),str_len(text)),str_eq(ntss-str(row,"sha256"),ntss-hash(text)));
  def ntss-file-current(row,path) = ntss-content-current(row,ntss-read(path));
  def ntss-find(rows,owner) = if nil?(rows) then nothing() else if str_eq(ntss-str(head(rows),"owner"),owner) then head(rows) else ntss-find(tail(rows),owner);
  def ntss-parse(path,text) {
   let seal = parse-json(path,text);
   ntss-need(str_eq(ntss-str(seal,"schema"),"native-table-source-seal-v1"),"seal-schema",path);
   seal;
  }
  def ntss-load(path) = ntss-parse(path,ntss-read(path));
 }
 0;
}
