package Form.glass.liveui;

import Form.kernel.*;
import Form.surface.terminalcanvas.*;
import Form.glass.dashboard.*;
import Form.glass.telemetry.*;

interface IFormGlassLiveUI [public, witness, resident, interactive, surface-neutral] {
   section [public] {
      const String Schema = "form-glass-live-ui-v2";
      const String ViewRule = "atlas, raster, overview, memory, flow, and recipes are measured responsive views over the same typed scene rather than separate dashboards";
      const String FlowRule = "a retained observed-frame ring distinguishes cumulative deltas from instantaneous gauges, stores actual frame epochs and per-lane evidence, and preserves unavailable separately from measured zero";
      const String DensityRule = "each shaped row retains subtype, lifecycle, evidence, plane, read age, write age, owner, lane, purpose, source, and selection identity as width permits";
      const String LayoutRule = "80x24 is one exact narrow raster, widths at least 100 cells use a measured two-column split, and every frame contains exactly the observed row count with no scroll or wrap";
      const String EvidenceRule = "inspect selects an exact sample, metric, or typed observation id and request-evidence reveals publisher, owner, lane, purpose, source, evidence, process truth, semantic access ages, or a reasoned non-value";
      const String QueueRule = "request queue depth is shown when published and otherwise reads unavailable with the missing request-queue publisher named";
      const String ObservationV2Rule = "memory renders typed cells, blueprints, recipes, tensors, and arenas; recipes renders JIT states; flow renders Metal pending, batch, in-flight, and slot observations with measured zero or unavailable reason and door intact";
      const String ShardRule = "flow, typed observation, and responsive layout crystallize as independent freshness-bound images before the small live-UI assembly imports them; one changed view cannot force a monolithic live-UI materialization";
      const String VisibleClockRule = "each projected frame carries UTC to the millisecond, frame sequence, observed inter-frame delta, target cadence, dispatch delta, framebuffer roots, NodeID count, and live arena-cons allocation count, explicitly scoped to the glass process";
      const String DenseAtlasRule = "the default 80x24 atlas places a history-backed visible-record gas-water-ice river, a declared request-token-layer-tensor-Metal-framebuffer-Glass schema, two flow histories per row, and thirty-nine fixed two-byte ASCII KT tiles per row; each tile independently retains exact NodeID, channels, evidence, kind and truth: plane is foreground hue, lifecycle is background, age is alpha, and active lifecycle is bold; the always-visible legend routes monochrome and assistive readers to exact text through inspect and detailed views";
      const String TimeRasterRule = "the raster view projects fifteen aggregate resource lanes over retained observed frames; every activity character is a selectable lane+epoch cell that retains physical-live, derived-window, catalog, declared, or unavailable evidence without upgrading it, newest frame is at right, actual retained span is measured from frame epochs, and deltas remain derived";
      const String PriorityRule = "measured and stale observations render before unavailable carrier seams; zero retains its measured scope and never impersonates a global absence";
      const String RestartRule = "startup inherits the last acknowledged offer id before polling so a consumed abstain remains acknowledged instead of replaying into a replacement process";

      Object Frame( Int width, Int height, Int epoch, Int hertz, Int sequence, String view, String focus, String filter, String selected, Int evidenceOpen, Object metrics, Object samples, Object publishers, String control, Object history, Object observations, String carrierSeam ) [abstract];
   }
}

class FormGlassLiveUI [public, resident, observable, flow, teach] : IFormGlassLiveUI {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-glass-live-ui.bml";
      const String FlowShardPath = "form/form-stdlib/form-glass-flow-ui.bml";
      const String ObservationShardPath = "form/form-stdlib/form-glass-observation-ui.bml";
      const String LayoutShardPath = "form/form-stdlib/form-glass-layout-ui.bml";
      const Int RetainedQuarterSecondPoints = 128;

      Object Frame( Int width, Int height, Int epoch, Int hertz, Int sequence, String view, String focus, String filter, String selected, Int evidenceOpen, Object metrics, Object samples, Object publishers, String control, Object history, Object observations, String carrierSeam ) [abstract] {}
   }
}
