  def cbi-static-entries(rows, regions) = if nil?(rows) then list() else append(cbi-global-entries-one(nth(head(rows), 1), cbi-global-names(nth(head(rows), 1)), head(head(rows)), regions), cbi-static-entries(tail(rows), regions));
  // Clang text AST is a second independent census of the active platform.
  def cbi-ast-name(s) {
   let q = str_find(s, "'", 0);
   if lt(q, 0) then "" else cbi-ast-word-back(s, sub(q, 2), sub(q, 1));
  }
  def cbi-ast-word-back(s, i, end) = if or(lt(i, 0), not(cbi-word(str_byte_at(s, i)))) then substring(s, add(i, 1), end) else cbi-ast-word-back(s, sub(i, 1), end);
  def cbi-ast-root(s) = or(lx-at?(s, 0, "|-"), lx-at?(s, 0, "`-"));
  def cbi-ast(rows, current, functions, globals) {
   if nil?(rows) then list(lx-str-uniq(reverse(functions)), lx-str-uniq(reverse(globals))) else cbi-ast-one(head(rows), tail(rows), current, functions, globals);
  }
  def cbi-ast-one(s, rest, current, functions, globals) {
   if cbi-ast-root(s) then cbi-ast(rest, if lx-at?(s, 2, "FunctionDecl ") then cbi-ast-name(s) else "", functions, if and(lx-at?(s, 2, "VarDecl "), or(lx-at?(cbi-ast-name(s), 0, "fk_"), str_eq(cbi-ast-name(s), "errno"))) then cons(cbi-ast-name(s), globals) else globals)
   else cbi-ast(rest, current, if and(not(str_eq(current, "")), or(lx-at?(s, 5, "CompoundStmt "), lx-at?(s, 4, "CompoundStmt "))) then cons(current, functions) else functions, globals);
  }
  def cbi-audit(path, astpath, out) {
   let s = read_file(path);
   let rows = cbi-inventory(s);
   let globals = lx-str-uniq(cbi-all-names(rows, "declaration"));
   let functions = lx-str-uniq(cbi-all-names(rows, "function"));
   let ast = cbi-ast(lx-lines(read_file(astpath)), "", list(), list());
   let statics = cbi-all-statics(s, rows);
   let regions = cons(list(0, "host ABI and instrumentation"), cbi-regions(rows, cbi-region-anchors()));
   let doc = json-node-object(list(cbi-s("schema", "c-bootstrap-audit-v1"), cbi-s("source", path), cbi-n("source_bytes", str_len(s)), cbi-n("source_lines", cbi-lines(s, 0, str_len(s), 0)), cbi-s("method", "all raw preprocessor branches; lexical calls and references may include macros, function pointers and shadowed identifiers; numeric tokens are not automatically limits; active-platform Clang reconciliation is by unique names, not behavior"), json-node-pair("census", json-node-object(list(cbi-n("function_definitions_all_branches", cbi-count(rows, "function")), cbi-n("function_unique_names_all_branches", len(functions)), cbi-n("global_declarations_all_branches", cbi-global-count(rows)), cbi-n("global_unique_names_all_branches", len(globals)), cbi-n("active_clang_function_unique_names", len(head(ast))), cbi-n("active_clang_global_unique_names", len(nth(ast, 1))), json-node-pair("clang_functions_missing_from_lexical", cbi-json-strings(lx-str-minus(head(ast), functions))), json-node-pair("clang_globals_missing_from_lexical", cbi-json-strings(lx-str-minus(nth(ast, 1), globals))), json-node-pair("lexical_functions_inactive_here", cbi-json-strings(lx-str-minus(functions, head(ast)))), json-node-pair("lexical_globals_inactive_here", cbi-json-strings(lx-str-minus(globals, nth(ast, 1))))))), json-node-pair("functions", json-node-array(cbi-fn-entries(s, rows, globals, regions))), json-node-pair("globals", json-node-array(cbi-global-entries(rows, regions))), json-node-pair("static_locals", json-node-array(cbi-static-entries(statics, regions))), json-node-pair("all_declaration_units", json-node-array(cbi-json-units(rows)))));
   let wrote = if cbi-regions-valid(tail(regions), 0) then write_file(out, str_concat(json-emit(doc), "\n")) else -1;
   list(cbi-summary(rows), "global-names", len(globals), "static-declaration-units", len(statics), "active-clang-functions", len(head(ast)), "active-clang-globals", len(nth(ast, 1)), "missing-functions", lx-str-minus(head(ast), functions), "missing-globals", lx-str-minus(nth(ast, 1), globals), "written", wrote);
  }
 }
