// ear-yield.bml — when the live ear stands down: ONE definition shared by the ear (observe/ear-live-native.fk) and its stand-in (observe/ear-yield-load-run.fk).
//
// A standing .hearth/ear.yield file (opt-in, default absent: no change) asks the ear's cadence to stand down while ANOTHER live process holds the GPU lease (a local
// model turn, or the resident server observe/qwen-serve-run.bml, which writes the file while it serves). Cadence passes on silence cost the whole GPU a turbo pass every
// chunk (about a fifth of its time, and ~4x the local model's decode); while the lease is held elsewhere the ear passes only on speech it hears, as it does without a
// cadence, and goes back to passing on everything the moment the lease is free. Pressure slows or yields; it never cuts what the other tenant runs.
section [form.bml] {
    class EarYield {
     def el-yield-why(flag, pid, me, alive) =
  flag != 1 ? "no-flag" :
  pid <= 0 || alive != 1 ? "lease-free" :
  pid == me ? "lease-mine" :
  "yielding";
        def el-yield-flag?() = file_size(".hearth/ear.yield") >= 0;
        def el-lease-field(s, at) = at < 0 ? s : substring(s, 0, at);
        def el-owner-pid(path) {
            let text = read_file(path) ?? "";
            let lines = split-on(text, "\n");
            len(lines) < 2 ? 0 : str_to_int(el-lease-field(lines[1], str_find(lines[1], ":", 0))) ?? 0;
        }
        // the exclusive lease's holder, else the resident server's registration (gpu-lease.bml: a resident holds no exclusive lease, and the ear is its guest)
        def el-lease-pid() {
            let p = el-owner-pid("/tmp/form-gpu.lock/owner");
            p > 0 ? p : el-owner-pid("/tmp/form-gpu.lock.resident/owner");
        }
        def el-lease-busy?() {
            let pid = el-lease-pid();
            pid > 0 && pid != host_pid() && host_alive(pid) == 1;
        }
        def el-yielding?() = el-yield-flag?() && el-lease-busy?();
    }
}
