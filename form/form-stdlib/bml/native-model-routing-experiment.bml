package Form.native.modelroutingexperiment;

import Form.kernel.*;
import Form.native.models.*;
import Form.native.modeltokens.*;

interface INativeModelRoutingExperiment [public, witness, reusable] {
   section [public] {
      const String Schema = "native-model-routing-experiment-v1";
      const String ReplayRule = "policy replay uses fixed case facts and never impersonates a model run";
      const String PhysicalRule = "physical observations retain model, prompt contract, cap, latency, normalized egress admission, and applied rejection result";
      const String SelectionRule = "known deterministic grammar stays native; 3B proposes unknown NL-to-Form; Qwen follows only explicit native inability";
      const String CostRule = "route cost orders native below 3B below first-demand Qwen without treating units as wall milliseconds";
      const String TokenRule = "every selected local lane must be prompt-admitted or native-admitted by the shared Form token envelope";

      String Route( String strPolicy, String strTask, int nKnownGrammar, String strNativeOutcome, int nProposalValid ) [abstract];
      int ExactPlans( String strPolicy ) [abstract];
      int CostUnits( String strPolicy ) [abstract];
      String Champion() [abstract];
   }
}

class NativeModelRoutingExperiment [public, reusable, flow, teach, observable] : INativeModelRoutingExperiment {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-routing-experiment.bml";
      const String BaselinePolicy = "3b-all-natural-language";
      const String NativeOnlyPolicy = "native-first-no-translator";
      const String ChampionPolicy = "capability-aware";
      const int NativeCostUnits = 1;
      const int ThreeBCostUnits = 10;
      const int QwenRouteCostUnits = 1000;

      String Route( String strPolicy, String strTask, int nKnownGrammar, String strNativeOutcome, int nProposalValid ) [abstract] {}
      int ExactPlans( String strPolicy ) [abstract] {}
      int CostUnits( String strPolicy ) [abstract] {}
      String Champion() [abstract] {}
   }
}
