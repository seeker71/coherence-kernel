// disposable.bml — a resource that must be given back says how, once.
//
// A class over Disposable<H> names its release: `class MetalBuffer : Disposable<Int> { def dispose(h) = ...; }`
// hoists MetalBuffer_dispose, and the acquirer holds it with `defer MetalBuffer_dispose(h);` so the release
// runs at the block's end, in reverse order of acquiring, on a normal exit and on a stop.
// disposable-conforms?(class) answers whether a class carries every member its template names; it reads the
// class value and refuses nothing, so a class that names no dispose is a reading, not a stop.
// preludes: form-stdlib/core.fk form-stdlib/language-template.fk
section [form.bml] {
 template Disposable<H> { member dispose: Release<H>; }

 class DisposableCheck {
  def dc-has?(members, name) = !nil?(language-class-member-named(members, name));
  def dc-covers?(wanted, members) = nil?(wanted) ? 1
   : !dc-has?(members, language-template-member-name(head(wanted))) ? 0
   : dc-covers?(tail(wanted), members);
  def disposable-conforms?(kind) = language-class-valid?(kind)
   && dc-covers?(language-template-members(language-class-template(kind)), language-class-members(kind));
 }
}
