// Explicit, session-owned Qwen head adapters. No default selection or promotion.
// Identity covers the exact finite A/B bytes supplied to the Metal admission.
// preludes: form-stdlib/qwen-lora-train.fk
section [form.bml] {
 class FormCliModelAdapter {
  field SessionPrefixSize = 15;
  def fcmd-carrier(session) = len(session) > SessionPrefixSize() ? session[SessionPrefixSize()] : list();
  def fcmd-with-carrier(session,carrier) = append(take(SessionPrefixSize(),session),cons(carrier,drop(SessionPrefixSize() + 1,session)));
  def fcmd-inherit(before,after) = append(take(SessionPrefixSize(),after),drop(SessionPrefixSize(),before));
  def fcmd-path(carrier) = (Comparable) len(carrier) == 4 ? carrier[1] : "";
  def fcmd-digest(carrier) = (Comparable) len(carrier) == 4 ? carrier[2] : "";
  def fcmd-adapter(carrier) = (Comparable) len(carrier) == 4 ? carrier[3] : list();
  def fcmd-active?(carrier) = qlh-admitted?(fcmd-adapter(carrier));
  def fcmd-pair-valid?(a,b,width) = !(((String) value_kind(a) == "string") && ((String) value_kind(b) == "string")) ? 0 : !((String) value_kind(width) == "int") ? 0 : width <= 0 ? 0 : !(((Comparable) str_len(a) == (width * 4)) && ((Comparable) str_len(b) == (width * 4))) ? 0 : (qlt-finite-bytes?(a,0,width) && qlt-finite-bytes?(b,0,width));
  def fcmd-pair-digest(a,b) = hex-encode(sha256-stream-string(a ++ b));
  def fcmd-snapshot(path) = file_size(path) <= 0 ? list() : !qlh-whole?(path) ? list() : {
   let a = qlh-tensor-bytes(path,qlh-a-name());
   let b = qlh-tensor-bytes(path,qlh-b-name());
   !fcmd-pair-valid?(a,b,qlh-width()) ? list() : list(a,b,fcmd-pair-digest(a,b));
  };
  // [admitted, reason, owned carrier]. Even an incomplete returned allocation
  // remains owned by the refused session until its normal release boundary.
  def fcmd-admit(ctx,path) = len(ctx) < 7 ? list(0,"adapter-context-unavailable",list()) : !((Comparable) ctx[2][0] == qlh-width()) ? list(0,"adapter-model-width-mismatch",list()) : {
   let material = fcmd-snapshot(path);
   nil?(material) ? list(0,"adapter-artifact-missing-invalid-or-nonfinite",list()) : {
    let adapter = q38-lora-rank1-open(head(material),material[1],qlh-width(),md-f32-bits(1.0));
    let carrier = list("qwen-session-adapter-v1",path,material[2],adapter);
    qlh-admitted?(adapter) ? list(1,"adapter-admitted",carrier) : list(0,"adapter-device-admission-refused",carrier);
   };
  };
  def fcmd-owned(carrier) {
   let adapter = fcmd-adapter(carrier);
   !((Comparable) len(adapter) == 5) ? 0 : sum(list(adapter[0] > 0 ? 1 : 0,adapter[1] > 0 ? 1 : 0,adapter[2] > 0 ? 1 : 0));
  }
  def fcmd-close(carrier) = qlh-close(fcmd-adapter(carrier));
  def fcmd-forward(ctx,state,carrier,id,pos) = nil?(carrier) ? q38-forward(ctx[0],ctx[1],ctx[2],ctx[3],state,ctx[4],ctx[5],ctx[6],id,pos) : q38-forward-adapted(ctx[0],ctx[1],ctx[2],ctx[3],state,ctx[4],ctx[5],ctx[6],fcmd-adapter(carrier),id,pos);
  // Prefill already advanced the stream. Recompute only its final head; never
  // replay the final input token or insert an intermediate prediction into KV.
  def fcmd-pending(ctx,carrier,basePending) = nil?(carrier) ? basePending : !fcmd-active?(carrier) ? -1 : {
   metal_batch_concurrent();
   q38-head-adapted(ctx[0],ctx[1],ctx[2],ctx[5],ctx[6],fcmd-adapter(carrier));
   kth-u32at(metal_buf_read(ctx[1][31],0,4),0);
  };
 }
 0;
}
