// Explicit, session-owned Qwen head adapters. No default selection or promotion.
// Identity covers the exact finite A/B bytes supplied to the Metal admission.
// preludes: form-stdlib/qwen-lora-train.fk
section [form.bml] {
 class FormCliModelAdapter {
  field SessionPrefixSize = 15;
  def fcmd-carrier(session) = if (len(session) > SessionPrefixSize()) then session[SessionPrefixSize()] else [];
  def fcmd-with-carrier(session,carrier) = append(take(SessionPrefixSize(),session),cons(carrier,drop((SessionPrefixSize() + 1),session)));
  def fcmd-inherit(before,after) = append(take(SessionPrefixSize(),after),drop(SessionPrefixSize(),before));
  def fcmd-path(carrier) = if ((Comparable) len(carrier) == 4) then carrier[1] else "";
  def fcmd-digest(carrier) = if ((Comparable) len(carrier) == 4) then carrier[2] else "";
  def fcmd-adapter(carrier) = if ((Comparable) len(carrier) == 4) then carrier[3] else [];
  def fcmd-active?(carrier) = qlh-admitted?(fcmd-adapter(carrier));
  def fcmd-pair-valid?(a,b,width) = if (!(((String) value_kind(a) == "string") && ((String) value_kind(b) == "string"))) then 0 else if (!((String) value_kind(width) == "int")) then 0 else if (width <= 0) then 0 else if (!(((Comparable) str_len(a) == (width * 4)) && ((Comparable) str_len(b) == (width * 4)))) then 0 else (qlt-finite-bytes?(a,0,width) && qlt-finite-bytes?(b,0,width));
  def fcmd-pair-digest(a,b) = hex-encode(sha256-stream-string(str_concat(a,b)));
  def fcmd-snapshot(path) = if (file_size(path) <= 0) then [] else if (!qlh-whole?(path)) then [] else {
   let a = qlh-tensor-bytes(path,qlh-a-name());
   let b = qlh-tensor-bytes(path,qlh-b-name());
   if (!fcmd-pair-valid?(a,b,qlh-width())) then [] else [a,b,fcmd-pair-digest(a,b)];
  };
  // [admitted, reason, owned carrier]. Even an incomplete returned allocation
  // remains owned by the refused session until its normal release boundary.
  def fcmd-admit(ctx,path) = if (len(ctx) < 7) then [0,"adapter-context-unavailable",[]] else if (!((Comparable) ctx[2][0] == qlh-width())) then [0,"adapter-model-width-mismatch",[]] else {
   let material = fcmd-snapshot(path);
   if nil?(material) then [0,"adapter-artifact-missing-invalid-or-nonfinite",[]] else {
    let adapter = q38-lora-rank1-open(head(material),material[1],qlh-width(),md-f32-bits(1.0));
    let carrier = ["qwen-session-adapter-v1",path,material[2],adapter];
    if qlh-admitted?(adapter) then [1,"adapter-admitted",carrier] else [0,"adapter-device-admission-refused",carrier];
   };
  };
  def fcmd-owned(carrier) {
   let adapter = fcmd-adapter(carrier);
   if (!((Comparable) len(adapter) == 5)) then 0 else sum([if (adapter[0] > 0) then 1 else 0,if (adapter[1] > 0) then 1 else 0,if (adapter[2] > 0) then 1 else 0]);
  }
  def fcmd-close(carrier) = qlh-close(fcmd-adapter(carrier));
  def fcmd-forward(ctx,state,carrier,id,pos) = if nil?(carrier) then q38-forward(ctx[0],ctx[1],ctx[2],ctx[3],state,ctx[4],ctx[5],ctx[6],id,pos) else q38-forward-adapted(ctx[0],ctx[1],ctx[2],ctx[3],state,ctx[4],ctx[5],ctx[6],fcmd-adapter(carrier),id,pos);
  // Prefill already advanced the stream. Recompute only its final head; never
  // replay the final input token or insert an intermediate prediction into KV.
  def fcmd-pending(ctx,carrier,basePending) = if nil?(carrier) then basePending else if (!fcmd-active?(carrier)) then -1 else {
   metal_batch_concurrent();
   q38-head-adapted(ctx[0],ctx[1],ctx[2],ctx[5],ctx[6],fcmd-adapter(carrier));
   kth-u32at(metal_buf_read(ctx[1][31],0,4),0);
  };
 }
 0;
}
