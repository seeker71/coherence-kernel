// The specimen's own class definitions determine native method selection.
// preludes: form-stdlib/form-ontology-loader.fk form-stdlib/source-compiler.fk form-stdlib/bml/python-class-runtime.bml form-stdlib/bml/python-compiler-health.bml
section [form.bml] {
 class PythonNativeDispatch {
  def pnd-cat(parts) = if nil?(parts) then "" else str_concat(head(parts),pnd-cat(tail(parts)));
  def pnd-runtime() {
   let relative = "form-stdlib/bml/python-class-runtime.bml";
   let rootPath = str_concat("form/",relative);
   let path = if ge(file_size(rootPath),0) then rootPath else relative;
   let size = file_size(path); let bytes = read_file(path);
   if not(and(ge(size,0),and(str_eq(value-kind(bytes),"string"),and(eq(str_len(bytes),size),eq(file_size(path),size))))) then pch-refuse("native class runtime source read incomplete") else 0;
   form-source-compile-text(bytes,path);
  }
  def pnd-call(receiver,method,args) = pnd-cat(list("(_py_native_dispatch ",receiver," ",fsc-q(method)," (list ",join-strings-with-spaces(args),"))"));
  def pnd-super(current,method,args) = pnd-cat(list("(_py_native_super self ",fsc-q(current)," ",fsc-q(method)," (list ",join-strings-with-spaces(args),"))"));
  def pnd-classes(node) = if node_eq(node_category(node),fol-bp("PY-BMF-CLASS")) then list(node) else pnd-children(node_children(node));
  def pnd-children(nodes) = if nil?(nodes) then list() else append(pnd-classes(head(nodes)),pnd-children(tail(nodes)));
  def pnd-name(node) = node_value(head(node_children(node)));
  def pnd-has-base(node) = node_eq(node_category(nth(node_children(node),1)),fol-bp("PY-BMF-IDENT"));
  def pnd-base(node) = if pnd-has-base(node) then pnd-name(nth(node_children(node),1)) else "";
  def pnd-methods(node) = drop(if pnd-has-base(node) then 2 else 1,node_children(node));
  def pnd-args(at,count) = if ge(at,count) then "" else pnd-cat(list(" (nth args ",int_to_str(at),")",pnd-args(add(at,1),count)));
  def pnd-next(node) = pnd-cat(list("(_py_native_find self ",fsc-q(pnd-base(node))," method args (sub remaining 1))"));
  def pnd-method-chain(className,methods,absent) {
   if nil?(methods) then absent else pnd-method(className,head(methods),tail(methods),absent);
  }
  def pnd-method(className,method,rest,absent) {
   let name = pnd-name(method);
   if str_eq(name,"__init__") then pnd-method-chain(className,rest,absent) else pnd-method-call(className,method,name,rest,absent);
  }
  def pnd-method-call(className,method,name,rest,absent) {
   let count = sub(len(node_children(method)),3);
   if lt(count,0) then pch-refuse("native instance method requires self") else 0;
   pnd-cat(list("(if (str_eq method ",fsc-q(name),") (if (eq (len args) ",int_to_str(count),") (",className,"__",name," self",pnd-args(0,count),") (form_error \"native method argument count refused\")) ",pnd-method-chain(className,rest,absent),")"));
  }
  def pnd-class-chain(classes) = if nil?(classes) then "(form_error \"native class method not found\")" else pnd-cat(list("(if (str_eq class ",fsc-q(pnd-name(head(classes))),") ",pnd-method-chain(pnd-name(head(classes)),pnd-methods(head(classes)),pnd-next(head(classes)))," ",pnd-class-chain(tail(classes)),")"));
  def pnd-base-chain(classes) = if nil?(classes) then "(form_error \"native super class not found\")" else pnd-cat(list("(if (str_eq class ",fsc-q(pnd-name(head(classes))),") ",fsc-q(pnd-base(head(classes)))," ",pnd-base-chain(tail(classes)),")"));
  def pnd-source(ast) = str_concat(pnd-runtime(),pnd-source-classes(pnd-classes(ast)));
  def pnd-source-classes(classes) = pnd-cat(list("(defn _py_native_find (self class method args remaining) (if (le remaining 0) (form_error \"native method lineage exhausted\") ",pnd-class-chain(classes),"))\n(defn _py_native_base (class) ",pnd-base-chain(classes),")\n(defn _py_native_dispatch (self method args) (_py_native_find self (_py_native_attr self \"__class__\") method args ",int_to_str(len(classes)),"))\n(defn _py_native_super (self class method args) (_py_native_find self (_py_native_base class) method args ",int_to_str(len(classes)),"))\n"));
 }
 0;
}
