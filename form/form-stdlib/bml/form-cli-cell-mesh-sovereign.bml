// A bounded, sovereign in-memory cell-to-cell channel for form-cli.
//
// State is an ordinary Form value.  A caller keeps the channel returned by a
// transition and offers it to the next call; no process, file, socket, or
// hidden session participates.  Two endpoint cells name the same observer and
// shared field.  That observer is trusted only when its supplied grounding is
// trustworthy according to core-grounding's five-axiom boundary.
//
// Grammar/protocol changes are data proposals.  They are admitted only from
// that shared observer, on the shared field, one revision at a time.  Streamed
// symbols select a fixed native evaluation vocabulary; an incoming proposal
// cannot introduce arbitrary source or evaluator code.
// preludes: form-stdlib/core-grounding.fk
section [form.bml] {
    class FormCliCellMesh {
        field FcmMaxSymbols = 16;
        field FcmMaxEvents = 64;

        // cell = (identity observer-id shared-field)
        def fcm-cell(identity, observer, shared) = list(identity, observer, shared);
        def fcm-cell-id(cell) = nth(cell, 0);
        def fcm-cell-observer(cell) = nth(cell, 1);
        def fcm-cell-shared(cell) = nth(cell, 2);

        // observer = (identity shared-field grounding-rows)
        def fcm-observer(identity, shared, groundings) = list(identity, shared, groundings);
        def fcm-observer-id(observer) = nth(observer, 0);
        def fcm-observer-shared(observer) = nth(observer, 1);
        def fcm-observer-groundings(observer) = nth(observer, 2);
        def fcm-observer-trusted?(observer) = core-trustworthy?(fcm-observer-groundings(observer));

        // grammar = (identity revision admitted-symbols admitted-primitives)
        def fcm-grammar(identity, revision, symbols, primitives) = list(identity, revision, symbols, primitives);
        def fcm-grammar-id(grammar) = nth(grammar, 0);
        def fcm-grammar-revision(grammar) = nth(grammar, 1);
        def fcm-grammar-symbols(grammar) = nth(grammar, 2);
        def fcm-grammar-primitives(grammar) = nth(grammar, 3);
        def fcm-fixed-primitives() = list("identity", "head", "count", "join");

        // protocol = (identity revision grammar-id grammar-revision)
        def fcm-protocol(identity, revision, grammarId, grammarRevision) = list(identity, revision, grammarId, grammarRevision);
        def fcm-protocol-id(protocol) = nth(protocol, 0);
        def fcm-protocol-revision(protocol) = nth(protocol, 1);
        def fcm-protocol-grammar-id(protocol) = nth(protocol, 2);
        def fcm-protocol-grammar-revision(protocol) = nth(protocol, 3);

        // event = (kind sequence from to detail), all event rows are inspectable.
        def fcm-event(kind, sequence, from, to, detail) = list(kind, sequence, from, to, detail);
        def fcm-event-kind(event) = nth(event, 0);
        def fcm-event-sequence(event) = nth(event, 1);
        def fcm-event-from(event) = nth(event, 2);
        def fcm-event-to(event) = nth(event, 3);
        def fcm-event-detail(event) = nth(event, 4);

        // channel = (identity left right observer grammar protocol events)
        def fcm-channel(identity, left, right, observer, grammar, protocol, events) = list(identity, left, right, observer, grammar, protocol, events);
        def fcm-channel-id(channel) = nth(channel, 0);
        def fcm-channel-left(channel) = nth(channel, 1);
        def fcm-channel-right(channel) = nth(channel, 2);
        def fcm-channel-observer(channel) = nth(channel, 3);
        def fcm-channel-grammar(channel) = nth(channel, 4);
        def fcm-channel-protocol(channel) = nth(channel, 5);
        def fcm-channel-events(channel) = nth(channel, 6);

        // transition = (accepted? channel event value-or-reason)
        def fcm-transition(accepted, channel, event, value) = list(accepted, channel, event, value);
        def fcm-accepted?(transition) = nth(transition, 0);
        def fcm-transition-channel(transition) = nth(transition, 1);
        def fcm-transition-event(transition) = nth(transition, 2);
        def fcm-transition-value(transition) = nth(transition, 3);

        def fcm-has?(values, value) = if nil?(values) then 0 else if str_eq(head(values), value) then 1 else fcm-has?(tail(values), value);
        def fcm-unique?(values) = if nil?(values) then 1 else if fcm-has?(tail(values), head(values)) then 0 else fcm-unique?(tail(values));
        def fcm-names?(values) = if nil?(values) then 1 else if eq(str_len(head(values)), 0) then 0 else fcm-names?(tail(values));
        def fcm-members?(values, allowed) = if nil?(values) then 1 else if fcm-has?(allowed, head(values)) then fcm-members?(tail(values), allowed) else 0;
        def fcm-grammar-valid?(grammar) = if gt(len(fcm-grammar-symbols(grammar)), FcmMaxSymbols()) then 0 else if not(fcm-names?(fcm-grammar-symbols(grammar))) then 0 else if not(fcm-unique?(fcm-grammar-symbols(grammar))) then 0 else if not(fcm-unique?(fcm-grammar-primitives(grammar))) then 0 else fcm-members?(fcm-grammar-primitives(grammar), fcm-fixed-primitives());
        def fcm-protocol-matches?(protocol, grammar) = if not(str_eq(fcm-protocol-grammar-id(protocol), fcm-grammar-id(grammar))) then 0 else eq(fcm-protocol-grammar-revision(protocol), fcm-grammar-revision(grammar));

        // Neither endpoint delegates its identity: both explicitly nominate the
        // same observer and field, and that observer has a grounded boundary.
        def fcm-shared-observer?(left, right, observer) = if str_eq(fcm-cell-id(left), fcm-cell-id(right)) then 0 else if not(str_eq(fcm-cell-observer(left), fcm-observer-id(observer))) then 0 else if not(str_eq(fcm-cell-observer(right), fcm-observer-id(observer))) then 0 else if not(str_eq(fcm-cell-shared(left), fcm-observer-shared(observer))) then 0 else if not(str_eq(fcm-cell-shared(right), fcm-observer-shared(observer))) then 0 else fcm-observer-trusted?(observer);
        def fcm-open-valid?(left, right, observer, grammar, protocol) = if not(fcm-shared-observer?(left, right, observer)) then 0 else if not(fcm-grammar-valid?(grammar)) then 0 else fcm-protocol-matches?(protocol, grammar);
        def fcm-open(identity, left, right, observer, grammar, protocol) = if fcm-open-valid?(left, right, observer, grammar, protocol) then fcm-open-accepted(identity, left, right, observer, grammar, protocol) else fcm-transition(0, list(), fcm-event("refused", 0, fcm-cell-id(left), fcm-cell-id(right), list("open", "shared-observer-or-grammar-refused")), "shared-observer-or-grammar-refused");
        def fcm-open-accepted(identity, left, right, observer, grammar, protocol) = fcm-open-with-event(identity, left, right, observer, grammar, protocol, fcm-event("open", 1, fcm-cell-id(left), fcm-cell-id(right), list(fcm-observer-id(observer), fcm-observer-shared(observer), fcm-grammar-id(grammar), int_to_str(fcm-grammar-revision(grammar)))));
        def fcm-open-with-event(identity, left, right, observer, grammar, protocol, event) = fcm-transition(1, fcm-channel(identity, left, right, observer, grammar, protocol, list(event)), event, "open");

        def fcm-endpoint?(channel, identity) = if str_eq(fcm-cell-id(fcm-channel-left(channel)), identity) then 1 else str_eq(fcm-cell-id(fcm-channel-right(channel)), identity);
        def fcm-other(channel, identity) = if str_eq(fcm-cell-id(fcm-channel-left(channel)), identity) then fcm-cell-id(fcm-channel-right(channel)) else fcm-cell-id(fcm-channel-left(channel));
        def fcm-channel-valid?(channel) = if gt(len(fcm-channel-events(channel)), FcmMaxEvents()) then 0 else if not(fcm-shared-observer?(fcm-channel-left(channel), fcm-channel-right(channel), fcm-channel-observer(channel))) then 0 else if not(fcm-grammar-valid?(fcm-channel-grammar(channel))) then 0 else fcm-protocol-matches?(fcm-channel-protocol(channel), fcm-channel-grammar(channel));
        def fcm-next-event(channel, kind, from, to, detail) = fcm-event(kind, add(len(fcm-channel-events(channel)), 1), from, to, detail);
        def fcm-record(channel, event) = fcm-channel(fcm-channel-id(channel), fcm-channel-left(channel), fcm-channel-right(channel), fcm-channel-observer(channel), fcm-channel-grammar(channel), fcm-channel-protocol(channel), append(fcm-channel-events(channel), list(event)));
        def fcm-refuse(channel, from, reason) = fcm-refuse-with-event(channel, from, reason, fcm-next-event(channel, "refused", from, fcm-observer-id(fcm-channel-observer(channel)), list(reason)));
        def fcm-refuse-with-event(channel, from, reason, event) = fcm-transition(0, fcm-record(channel, event), event, reason);

        // Evaluation is deliberately a finite dispatcher.  Protocol adaptation
        // may select one of these forms, never stream arbitrary evaluator code.
        def fcm-join(values) = if nil?(values) then "" else if nil?(tail(values)) then head(values) else str_concat(head(values), str_concat(",", fcm-join(tail(values))));
        def fcm-eval(primitive, symbols) = if str_eq(primitive, "identity") then symbols else if str_eq(primitive, "head") then if nil?(symbols) then list() else list(head(symbols)) else if str_eq(primitive, "count") then list(int_to_str(len(symbols))) else if str_eq(primitive, "join") then list(fcm-join(symbols)) else list();
        def fcm-send(channel, from, primitive, symbols) = if not(fcm-channel-valid?(channel)) then fcm-refuse(channel, from, "channel-not-grounded") else if not(fcm-endpoint?(channel, from)) then fcm-refuse(channel, from, "sender-not-an-endpoint") else if not(fcm-members?(symbols, fcm-grammar-symbols(fcm-channel-grammar(channel)))) then fcm-refuse(channel, from, "symbol-not-admitted") else if not(fcm-has?(fcm-grammar-primitives(fcm-channel-grammar(channel)), primitive)) then fcm-refuse(channel, from, "primitive-not-admitted") else fcm-send-accepted(channel, from, primitive, symbols, fcm-eval(primitive, symbols));
        def fcm-send-accepted(channel, from, primitive, symbols, value) = fcm-send-with-event(channel, from, primitive, symbols, value, fcm-next-event(channel, "send", from, fcm-other(channel, from), list(primitive, symbols, value)));
        def fcm-send-with-event(channel, from, primitive, symbols, value, event) = fcm-transition(1, fcm-record(channel, event), event, value);

        // Only the jointly named observer can advance both grammar and protocol.
        // A rejected proposal records its reason while preserving the old channel.
        def fcm-next-revision?(newRevision, oldRevision) = eq(newRevision, add(oldRevision, 1));
        def fcm-adapt(channel, proposer, shared, grammar, protocol) = if not(fcm-channel-valid?(channel)) then fcm-refuse(channel, proposer, "channel-not-grounded") else if not(str_eq(proposer, fcm-observer-id(fcm-channel-observer(channel)))) then fcm-refuse(channel, proposer, "proposal-not-from-shared-observer") else if not(str_eq(shared, fcm-observer-shared(fcm-channel-observer(channel)))) then fcm-refuse(channel, proposer, "proposal-not-from-shared-field") else if not(fcm-grammar-valid?(grammar)) then fcm-refuse(channel, proposer, "proposed-grammar-invalid") else if not(fcm-protocol-matches?(protocol, grammar)) then fcm-refuse(channel, proposer, "protocol-does-not-name-grammar") else if not(fcm-next-revision?(fcm-grammar-revision(grammar), fcm-grammar-revision(fcm-channel-grammar(channel)))) then fcm-refuse(channel, proposer, "grammar-revision-not-next") else if not(fcm-next-revision?(fcm-protocol-revision(protocol), fcm-protocol-revision(fcm-channel-protocol(channel)))) then fcm-refuse(channel, proposer, "protocol-revision-not-next") else fcm-adapt-accepted(channel, proposer, grammar, protocol);
        def fcm-adapt-accepted(channel, proposer, grammar, protocol) = fcm-adapt-with-event(channel, proposer, grammar, protocol, fcm-next-event(channel, "adapted", proposer, fcm-channel-id(channel), list(fcm-grammar-id(grammar), int_to_str(fcm-grammar-revision(grammar)), fcm-protocol-id(protocol), int_to_str(fcm-protocol-revision(protocol)))));
        def fcm-adapt-with-event(channel, proposer, grammar, protocol, event) = fcm-transition(1, fcm-channel(fcm-channel-id(channel), fcm-channel-left(channel), fcm-channel-right(channel), fcm-channel-observer(channel), grammar, protocol, append(fcm-channel-events(channel), list(event))), event, "adapted");

        // A compact ordinary form-cli response.  The API above is the reusable
        // organ; this fixture proves a two-cell flow without asking callers to
        // construct a Lisp expression at the command boundary.
        def fcm-demo-open() = fcm-open("mesh-demo", fcm-cell("cell-a", "shared-observer", "core-field"), fcm-cell("cell-b", "shared-observer", "core-field"), fcm-observer("shared-observer", "core-field", the-core()), fcm-grammar("mesh-grammar", 1, list("offer", "receipt"), list("identity", "count")), fcm-protocol("mesh-protocol", 1, "mesh-grammar", 1));
        def fcm-demo-send() = fcm-send(fcm-transition-channel(fcm-demo-open()), "cell-a", "identity", list("offer", "receipt"));
        def fcm-demo-adapt() = fcm-adapt(fcm-transition-channel(fcm-demo-send()), "shared-observer", "core-field", fcm-grammar("mesh-grammar", 2, list("offer", "receipt", "reflection"), list("identity", "count", "join")), fcm-protocol("mesh-protocol", 2, "mesh-grammar", 2));
        def fcm-demo-channel() = fcm-transition-channel(fcm-demo-adapt());
        def fcm-demo-event-count(channel) = int_to_str(len(fcm-channel-events(channel)));
        def fcm-demo-report() = str_concat("mesh-demo events=", fcm-demo-event-count(fcm-demo-channel()));
    }
}
