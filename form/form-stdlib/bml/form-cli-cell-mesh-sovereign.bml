// A bounded, sovereign in-memory cell-to-cell channel for form-cli.
//
// State is an ordinary Form value.  A caller keeps the channel returned by a
// transition and offers it to the next call; no process, file, socket, or
// hidden session participates.  Two endpoint cells name the same observer and
// shared field.  That observer is trusted only when its supplied grounding is
// trustworthy according to core-grounding's five-axiom boundary.
//
// Grammar/protocol changes are data proposals.  They are admitted only from
// that shared observer, on the shared field, one revision at a time.  Streamed
// symbols select a fixed native evaluation vocabulary; an incoming proposal
// cannot introduce arbitrary source or evaluator code.
// preludes: form-stdlib/core-grounding.fk
section [form.bml] {
    class FormCliCellMesh {
        field FcmMaxSymbols = 16;
        field FcmMaxEvents = 64;

        // cell = (identity observer-id shared-field)
        def fcm-cell(identity, observer, shared) = list(identity, observer, shared);
        def fcm-cell-id(cell) = cell[0];
        def fcm-cell-observer(cell) = cell[1];
        def fcm-cell-shared(cell) = cell[2];

        // observer = (identity shared-field grounding-rows)
        def fcm-observer(identity, shared, groundings) = list(identity, shared, groundings);
        def fcm-observer-id(observer) = observer[0];
        def fcm-observer-shared(observer) = observer[1];
        def fcm-observer-groundings(observer) = observer[2];
        def fcm-observer-trusted?(observer) = core-trustworthy?(fcm-observer-groundings(observer));

        // grammar = (identity revision admitted-symbols admitted-primitives)
        def fcm-grammar(identity, revision, symbols, primitives) = list(identity, revision, symbols, primitives);
        def fcm-grammar-id(grammar) = grammar[0];
        def fcm-grammar-revision(grammar) = grammar[1];
        def fcm-grammar-symbols(grammar) = grammar[2];
        def fcm-grammar-primitives(grammar) = grammar[3];
        def fcm-fixed-primitives() = list("identity", "head", "count", "join");

        // protocol = (identity revision grammar-id grammar-revision)
        def fcm-protocol(identity, revision, grammarId, grammarRevision) = list(identity, revision, grammarId, grammarRevision);
        def fcm-protocol-id(protocol) = protocol[0];
        def fcm-protocol-revision(protocol) = protocol[1];
        def fcm-protocol-grammar-id(protocol) = protocol[2];
        def fcm-protocol-grammar-revision(protocol) = protocol[3];

        // event = (kind sequence from to detail), all event rows are inspectable.
        def fcm-event(kind, sequence, from, to, detail) = list(kind, sequence, from, to, detail);
        def fcm-event-kind(event) = event[0];
        def fcm-event-sequence(event) = event[1];
        def fcm-event-from(event) = event[2];
        def fcm-event-to(event) = event[3];
        def fcm-event-detail(event) = event[4];

        // channel = (identity left right observer grammar protocol events)
        def fcm-channel(identity, left, right, observer, grammar, protocol, events) = list(identity, left, right, observer, grammar, protocol, events);
        def fcm-channel-id(channel) = channel[0];
        def fcm-channel-left(channel) = channel[1];
        def fcm-channel-right(channel) = channel[2];
        def fcm-channel-observer(channel) = channel[3];
        def fcm-channel-grammar(channel) = channel[4];
        def fcm-channel-protocol(channel) = channel[5];
        def fcm-channel-events(channel) = channel[6];

        // transition = (accepted? channel event value-or-reason)
        def fcm-transition(accepted, channel, event, value) = list(accepted, channel, event, value);
        def fcm-accepted?(transition) = transition[0];
        def fcm-transition-channel(transition) = transition[1];
        def fcm-transition-event(transition) = transition[2];
        def fcm-transition-value(transition) = transition[3];

        def fcm-has?(values, value) = nil?(values) ? 0 : (String) head(values) == value ? 1 : fcm-has?(tail(values), value);
        def fcm-unique?(values) = nil?(values) ? 1 : fcm-has?(tail(values), head(values)) ? 0 : fcm-unique?(tail(values));
        def fcm-names?(values) = nil?(values) ? 1 : (Comparable) str_len(head(values)) == 0 ? 0 : fcm-names?(tail(values));
        def fcm-members?(values, allowed) = nil?(values) ? 1 : fcm-has?(allowed, head(values)) ? fcm-members?(tail(values), allowed) : 0;
        def fcm-grammar-valid?(grammar) = len(fcm-grammar-symbols(grammar)) > FcmMaxSymbols() ? 0 : !fcm-names?(fcm-grammar-symbols(grammar)) ? 0 : !fcm-unique?(fcm-grammar-symbols(grammar)) ? 0 : !fcm-unique?(fcm-grammar-primitives(grammar)) ? 0 : fcm-members?(fcm-grammar-primitives(grammar), fcm-fixed-primitives());
        def fcm-protocol-matches?(protocol, grammar) = !((String) fcm-protocol-grammar-id(protocol) == fcm-grammar-id(grammar)) ? 0 : ((Comparable) fcm-protocol-grammar-revision(protocol) == fcm-grammar-revision(grammar));

        // Neither endpoint delegates its identity: both explicitly nominate the
        // same observer and field, and that observer has a grounded boundary.
        def fcm-shared-observer?(left, right, observer) = (String) fcm-cell-id(left) == fcm-cell-id(right) ? 0 : !((String) fcm-cell-observer(left) == fcm-observer-id(observer)) ? 0 : !((String) fcm-cell-observer(right) == fcm-observer-id(observer)) ? 0 : !((String) fcm-cell-shared(left) == fcm-observer-shared(observer)) ? 0 : !((String) fcm-cell-shared(right) == fcm-observer-shared(observer)) ? 0 : fcm-observer-trusted?(observer);
        def fcm-open-valid?(left, right, observer, grammar, protocol) = !fcm-shared-observer?(left, right, observer) ? 0 : !fcm-grammar-valid?(grammar) ? 0 : fcm-protocol-matches?(protocol, grammar);
        def fcm-open(identity, left, right, observer, grammar, protocol) = fcm-open-valid?(left, right, observer, grammar, protocol) ? fcm-open-accepted(identity, left, right, observer, grammar, protocol) : fcm-transition(0, list(), fcm-event("refused", 0, fcm-cell-id(left), fcm-cell-id(right), list("open", "shared-observer-or-grammar-refused")), "shared-observer-or-grammar-refused");
        def fcm-open-accepted(identity, left, right, observer, grammar, protocol) = fcm-open-with-event(identity, left, right, observer, grammar, protocol, fcm-event("open", 1, fcm-cell-id(left), fcm-cell-id(right), list(fcm-observer-id(observer), fcm-observer-shared(observer), fcm-grammar-id(grammar), int_to_str(fcm-grammar-revision(grammar)))));
        def fcm-open-with-event(identity, left, right, observer, grammar, protocol, event) = fcm-transition(1, fcm-channel(identity, left, right, observer, grammar, protocol, list(event)), event, "open");

        def fcm-endpoint?(channel, identity) = (String) fcm-cell-id(fcm-channel-left(channel)) == identity ? 1 : ((String) fcm-cell-id(fcm-channel-right(channel)) == identity);
        def fcm-other(channel, identity) = (String) fcm-cell-id(fcm-channel-left(channel)) == identity ? fcm-cell-id(fcm-channel-right(channel)) : fcm-cell-id(fcm-channel-left(channel));
        def fcm-channel-valid?(channel) = len(fcm-channel-events(channel)) > FcmMaxEvents() ? 0 : !fcm-shared-observer?(fcm-channel-left(channel), fcm-channel-right(channel), fcm-channel-observer(channel)) ? 0 : !fcm-grammar-valid?(fcm-channel-grammar(channel)) ? 0 : fcm-protocol-matches?(fcm-channel-protocol(channel), fcm-channel-grammar(channel));
        def fcm-next-event(channel, kind, from, to, detail) = fcm-event(kind, len(fcm-channel-events(channel)) + 1, from, to, detail);
        def fcm-record(channel, event) = fcm-channel(fcm-channel-id(channel), fcm-channel-left(channel), fcm-channel-right(channel), fcm-channel-observer(channel), fcm-channel-grammar(channel), fcm-channel-protocol(channel), append(fcm-channel-events(channel), list(event)));
        def fcm-refuse(channel, from, reason) = fcm-refuse-with-event(channel, from, reason, fcm-next-event(channel, "refused", from, fcm-observer-id(fcm-channel-observer(channel)), list(reason)));
        def fcm-refuse-with-event(channel, from, reason, event) = fcm-transition(0, fcm-record(channel, event), event, reason);

        // Evaluation is deliberately a finite dispatcher.  Protocol adaptation
        // may select one of these forms, never stream arbitrary evaluator code.
        def fcm-join(values) = nil?(values) ? "" : nil?(tail(values)) ? head(values) : head(values) ++ "," ++ fcm-join(tail(values));
        def fcm-eval(primitive, symbols) = (String) primitive == "identity" ? symbols : (String) primitive == "head" ? (nil?(symbols) ? list() : list(head(symbols))) : (String) primitive == "count" ? list(int_to_str(len(symbols))) : (String) primitive == "join" ? list(fcm-join(symbols)) : list();
        def fcm-send(channel, from, primitive, symbols) = !fcm-channel-valid?(channel) ? fcm-refuse(channel, from, "channel-not-grounded") : !fcm-endpoint?(channel, from) ? fcm-refuse(channel, from, "sender-not-an-endpoint") : !fcm-members?(symbols, fcm-grammar-symbols(fcm-channel-grammar(channel))) ? fcm-refuse(channel, from, "symbol-not-admitted") : !fcm-has?(fcm-grammar-primitives(fcm-channel-grammar(channel)), primitive) ? fcm-refuse(channel, from, "primitive-not-admitted") : fcm-send-accepted(channel, from, primitive, symbols, fcm-eval(primitive, symbols));
        def fcm-send-accepted(channel, from, primitive, symbols, value) = fcm-send-with-event(channel, from, primitive, symbols, value, fcm-next-event(channel, "send", from, fcm-other(channel, from), list(primitive, symbols, value)));
        def fcm-send-with-event(channel, from, primitive, symbols, value, event) = fcm-transition(1, fcm-record(channel, event), event, value);

        // Only the jointly named observer can advance both grammar and protocol.
        // A rejected proposal records its reason while preserving the old channel.
        def fcm-next-revision?(newRevision, oldRevision) = (Comparable) newRevision == (oldRevision + 1);
        def fcm-adapt(channel, proposer, shared, grammar, protocol) = !fcm-channel-valid?(channel) ? fcm-refuse(channel, proposer, "channel-not-grounded") : !((String) proposer == fcm-observer-id(fcm-channel-observer(channel))) ? fcm-refuse(channel, proposer, "proposal-not-from-shared-observer") : !((String) shared == fcm-observer-shared(fcm-channel-observer(channel))) ? fcm-refuse(channel, proposer, "proposal-not-from-shared-field") : !fcm-grammar-valid?(grammar) ? fcm-refuse(channel, proposer, "proposed-grammar-invalid") : !fcm-protocol-matches?(protocol, grammar) ? fcm-refuse(channel, proposer, "protocol-does-not-name-grammar") : !fcm-next-revision?(fcm-grammar-revision(grammar), fcm-grammar-revision(fcm-channel-grammar(channel))) ? fcm-refuse(channel, proposer, "grammar-revision-not-next") : !fcm-next-revision?(fcm-protocol-revision(protocol), fcm-protocol-revision(fcm-channel-protocol(channel))) ? fcm-refuse(channel, proposer, "protocol-revision-not-next") : fcm-adapt-accepted(channel, proposer, grammar, protocol);
        def fcm-adapt-accepted(channel, proposer, grammar, protocol) = fcm-adapt-with-event(channel, proposer, grammar, protocol, fcm-next-event(channel, "adapted", proposer, fcm-channel-id(channel), list(fcm-grammar-id(grammar), int_to_str(fcm-grammar-revision(grammar)), fcm-protocol-id(protocol), int_to_str(fcm-protocol-revision(protocol)))));
        def fcm-adapt-with-event(channel, proposer, grammar, protocol, event) = fcm-transition(1, fcm-channel(fcm-channel-id(channel), fcm-channel-left(channel), fcm-channel-right(channel), fcm-channel-observer(channel), grammar, protocol, append(fcm-channel-events(channel), list(event))), event, "adapted");

        // A compact ordinary form-cli response.  The API above is the reusable
        // organ; this fixture proves a two-cell flow without asking callers to
        // construct a Lisp expression at the command boundary.
        def fcm-demo-open() = fcm-open("mesh-demo", fcm-cell("cell-a", "shared-observer", "core-field"), fcm-cell("cell-b", "shared-observer", "core-field"), fcm-observer("shared-observer", "core-field", the-core()), fcm-grammar("mesh-grammar", 1, list("offer", "receipt"), list("identity", "count")), fcm-protocol("mesh-protocol", 1, "mesh-grammar", 1));
        def fcm-demo-send() = fcm-send(fcm-transition-channel(fcm-demo-open()), "cell-a", "identity", list("offer", "receipt"));
        def fcm-demo-adapt() = fcm-adapt(fcm-transition-channel(fcm-demo-send()), "shared-observer", "core-field", fcm-grammar("mesh-grammar", 2, list("offer", "receipt", "reflection"), list("identity", "count", "join")), fcm-protocol("mesh-protocol", 2, "mesh-grammar", 2));
        def fcm-demo-channel() = fcm-transition-channel(fcm-demo-adapt());
        def fcm-demo-event-count(channel) = int_to_str(len(fcm-channel-events(channel)));
        def fcm-demo-report() = "mesh-demo events=" ++ fcm-demo-event-count(fcm-demo-channel());
    }
}
