// flow-signal.bml — the flow's signal surface: one small frame in process shared memory, one packed integer, no text to build and none to parse.
//
// A flow (observe/flow-direct-run.bml: one request, plan -> candidate -> apply -> band -> land) writes what it meets into ONE frame (form-glass-gift-frame: shm_offer / shm_write, a seqlock header
// the reader never sees torn) and rings ONE shared bell frame. The frame is a single line of five words, about sixty bytes:
//   <request> <state> <t0> <tlast> <why>
//   state   one integer, 48 bits: the five lights (3 bits each: 0 not reached, 1 started, 2 ok, 3 partial, 4 discomfort, 5 repaired), the stage (4 bits), the kind (3 bits), the repairs (6 bits),
//           the got count (12 bits, saturating) and the missed count (8 bits, saturating). A reader unpacks it by division and remainder (fsg-unpack): no column is cut and nothing is trimmed.
//   t0      host_monotonic_ms when the flow began; tlast when it last gave a cell. The host's monotonic clock is one clock for every process, so a reader computes what has elapsed by itself:
//           a flow that has gone quiet is a number that keeps growing in the reader, not a number frozen in the frame.
//   why     the one-word spelling of the cell's why (no spaces)
// The frame's seq word is the wake-up: a reader sleeps on it (host_sleep_ms over the frame handles) and the kernel wakes it on a write; no timer, no tail, no ring (a cell that was overwritten before
// a reader woke is one whose lights and counts are still in the state). A discomfort cell is also recorded as a framebuffer cell (fb_record), so a reader that wants the history has it by asking the body.
// Disk gets only the sparse durable fact at a request's end (fsg-end-row), appended by the caller to a ledger the body already keeps.
// The slots are fixed names /fgn-flow-00 .. /fgn-flow-31 (15 is the resident server's own frame) and /fgn-flow-bell, within the 31-byte bound.
// preludes: form-stdlib/core.fk form-stdlib/bml/serve-sched.bml
section [form.bml] {
 class FlowSignal {
  field FSGBytes = 4096;
  def fsg-name(slot) = "/fgn-flow-" ++ (slot < 10 ? "0" : "") ++ slot.str();
  def fsg-bell-name() = "/fgn-flow-bell";
  def fsg-sp(n) = n <= 0 ? "" : " " ++ fsg-sp(n - 1);
  def fsg-pad(s, n) = len(s) >= n ? substring(s, 0, n) : s ++ fsg-sp(n - len(s));
  // the one-word spelling of a why: no spaces, so a reader splits the frame on its spaces (one pass; the index is kept for the callers that still pass one)
  def fsg-clean(s, i) = str-join-with(split-on(s, " "), "-");
  // A writer OFFERS: an offer on a name that already stands (a dead flow's frame, a watcher's mapping) maps the same object in place, so every reader sees this writer's frame,
  // and its write lands. A receive handle is read-only: a write through it is a silent no-op, which once left live flows blind behind the last run's rows. Receive is only the
  // fallback when the offer is refused, and that is said aloud.
  def fsg-open-handle(name) {
   let got = shm_offer(name, FSGBytes());
   nothing?(got) ? fsg-open-fallback(name) : got;
  }
  def fsg-open-fallback(name) {
   let said = print_str("flow-signal: the offer of " ++ name ++ " was refused; this flow's cells will not reach the frame\n");
   shm_receive(name);
  }
  // a frame given whole: a write that did not land (no handle, or the handle answered nothing) is said aloud once per writer
  def fsg-give(F, key, text) {
   let h = record_get(F, key);
   let r = nothing?(h) ? nothing() : shm_write(h, text);
   nothing?(r) ? fsg-blind(F, key) : r;
  }
  def fsg-blind(F, key) {
   let seen = record_get(F, "blind");
   nothing?(seen) || seen == 0 ? fsg-blind-say(F, key) : 0;
  }
  def fsg-blind-say(F, key) {
   let a = record_set(F, "blind", 1);
   let b = print_str("flow-signal: a write to the " ++ key ++ " frame of " ++ record_get(F, "id") ++ " did not land; the frame is blind to this flow\n");
   0;
  }
  // the names behind the codes, read only by a reader that wants words (a writer never looks a name up: it holds the code)
  def fsg-stages() = ["plan", "cand", "appl", "band", "land", "end", "start", "serve"];
  def fsg-kinds() = ["go", "ok", "part", "disc", "fix", "end"];
  def fsg-glyphs() = ".>+~!R";
  def fsg-index(names, name, i) = nil?(names) ? 15 : (String) names[0] == (String) name ? i : fsg-index(names[1:], name, i + 1);
  def fsg-stage-index(stage) = fsg-index(fsg-stages(), stage, 0);
  def fsg-kind-index(kind) = fsg-index(fsg-kinds(), kind, 0);
  def fsg-cap(v, hi) = v > hi ? hi : v < 0 ? 0 : v;
  // the five lights are one integer, three bits a stage, the stage's own position the weight
  def fsg-p8(i) = i <= 0 ? 1 : 8 * fsg-p8(i - 1);
  def fsg-light-of(lights, i) = (lights / fsg-p8(i)) % 8;
  def fsg-code(kind, was) = kind == "go" ? 1 : kind == "ok" ? (was == 5 || was == 3 ? was : 2) : kind == "part" ? 3 : kind == "disc" ? 4 : kind == "fix" ? 5 : was;
  def fsg-light(F, stage, kind) {
   let i = fsg-stage-index(stage);
   let ls = record_get(F, "lights");
   i > 4 ? ls : ls + (fsg-code(kind, fsg-light-of(ls, i)) - fsg-light-of(ls, i)) * fsg-p8(i);
  }
  def fsg-pack(lights, stage, kind, rep, got, missed) = lights + 32768 * (fsg-stage-index(stage) + 16 * (fsg-kind-index(kind) + 8 * (fsg-cap(rep, 63) + 64 * (fsg-cap(got, 4095) + 4096 * fsg-cap(missed, 255)))));
  // [lights, stage, kind, repairs, got, missed] of a state
  def fsg-unpack(s) = [s % 32768, (s / 32768) % 16, (s / 524288) % 8, (s / 4194304) % 64, (s / 268435456) % 4096, (s / 1099511627776) % 256];
  def fsg-name-at(names, i) = i >= 0 && i < len(names) ? names[i] : "?";
  // the lights as the five glyphs of the picture, for a reader that wants to show them
  def fsg-glyph-line(lights) = str-join(map(i => substring(fsg-glyphs(), fsg-light-of(lights, i), fsg-light-of(lights, i) + 1), [0, 1, 2, 3, 4]));
  // a writer's state: the frame handle, the bell, the request, the lights, the repairs, the clocks
  def fsg-state(slot, request) = record_new(0, "h", fsg-open-handle(fsg-name(slot)), "bell", fsg-open-handle(fsg-bell-name()), "id", request, "rep", 0, "t0", host_monotonic_ms(), "lights", 0, "stage", "plan", "kind", "go", "why", "go", "got", 0, "miss", 0, "blind", 0);
  def fsg-frame(F) = record_get(F, "id") ++ " " ++ fsg-pack(record_get(F, "lights"), record_get(F, "stage"), record_get(F, "kind"), record_get(F, "rep"), record_get(F, "got"), record_get(F, "miss")).str() ++ " " ++ record_get(F, "t0").str() ++ " " ++ host_monotonic_ms().str() ++ " " ++ record_get(F, "why");
  // opening a slot writes a FRESH frame (this request, no light lit, kind "go"): a persisted slot never shows a previous flow
  def fsg-new(slot, request) {
   let F = fsg-state(slot, request);
   let w = fsg-give(F, "h", fsg-frame(F));
   F;
  }
  // one cell: the lights and the counts move, the frame is given whole (one short line), the bell is rung. Answers the frame line.
  def fsg-emit(F, stage, kind, got, missed, why, ids, ms) {
   let a = record_set(F, "lights", fsg-light(F, stage, kind));
   let c = record_set(F, "stage", stage);
   let d = record_set(F, "kind", kind);
   let e = record_set(F, "why", fsg-clean(why, 0));
   let f = kind == "fix" ? record_set(F, "rep", record_get(F, "rep") + 1) : 0;
   let g = record_set(F, "got", got);
   let h = record_set(F, "miss", missed);
   let line = fsg-frame(F);
   let i = fsg-give(F, "h", line);
   let j = fsg-give(F, "bell", record_get(F, "id"));
   let k = kind == "disc" ? fb_record([stage, why, got, missed], "flow-signal:" ++ record_get(F, "id"), record_get(F, "rep")) : 0;
   line;
  }
  def fsg-release(F) {
   let a = nothing?(record_get(F, "h")) ? 0 : shm_release(record_get(F, "h"));
   nothing?(record_get(F, "bell")) ? 0 : shm_release(record_get(F, "bell"));
  }
  // the sparse durable fact of a request's end: one JSON row for a ledger the body already keeps
  def fsg-end-row(request, verdict, cause, got, missed, repairs, ms) = "{\"at_unix_ms\":" ++ now_unix_ms().str() ++ ",\"request\":\"" ++ request ++ "\",\"rung\":\"flow\",\"verdict\":\"" ++ verdict ++ "\",\"kind\":\"" ++ cause ++ "\",\"got\":" ++ got.str() ++ ",\"missed\":" ++ missed.str() ++ ",\"repairs\":" ++ repairs.str() ++ ",\"ms\":" ++ ms.str() ++ ",\"rent_tokens\":0}";
 }
 0;
}
