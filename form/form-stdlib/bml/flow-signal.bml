// flow-signal.bml — the flow's signal surface: one small frame in process shared memory, one packed integer, no text to build and none to parse.
//
// A flow (observe/flow-direct-run.bml: one request, plan -> candidate -> apply -> band -> land) writes what it meets into ONE frame (form-glass-gift-frame: shm_offer / shm_write, a seqlock header
// the reader never sees torn) and rings ONE shared bell frame. The frame is a single line of five words, about sixty bytes:
//   <request> <state> <t0> <tlast> <why>
//   state   one integer, 48 bits: the five lights (3 bits each: 0 not reached, 1 started, 2 ok, 3 partial, 4 discomfort, 5 repaired), the stage (4 bits), the kind (3 bits), the repairs (6 bits),
//           the got count (12 bits, saturating) and the missed count (8 bits, saturating). A reader unpacks it by division and remainder (fsg-unpack): no column is cut and nothing is trimmed.
//   t0      host_monotonic_ms when the flow began; tlast when it last gave a cell. The host's monotonic clock is one clock for every process, so a reader computes what has elapsed by itself:
//           a flow that has gone quiet is a number that keeps growing in the reader, not a number frozen in the frame.
//   why     the one-word spelling of the cell's why (no spaces)
// The frame's seq word is the wake-up: a reader sleeps on it (host_sleep_ms over the frame handles) and the kernel wakes it on a write; no timer, no tail, no ring (a cell that was overwritten before
// a reader woke is one whose lights and counts are still in the state). A discomfort cell is also recorded as a framebuffer cell (fb_record), so a reader that wants the history has it by asking the body.
// Disk gets only the sparse durable fact at a request's end (fsg-end-row), appended by the caller to a ledger the body already keeps.
// The slots are fixed names /fgn-flow-00 .. /fgn-flow-31 (15 is the resident server's own frame) and /fgn-flow-bell, within the 31-byte bound.
// preludes: form-stdlib/core.fk form-stdlib/bml/serve-sched.bml form-stdlib/bml/string-join.bml form-stdlib/bml/def-window.bml
section [form.bml] {
 class FlowSignal {
  field FSGBytes = 4096;
  def fsg-name(slot) = "/fgn-flow-" ++ (slot < 10 ? "0" : "") ++ slot.str();
  def fsg-bell-name() = "/fgn-flow-bell";
  def fsg-sp(n) = n <= 0 ? "" : " " ++ fsg-sp(n - 1);
  def fsg-pad(s, n) = len(s) >= n ? substring(s, 0, n) : s ++ fsg-sp(n - len(s));
  // the one-word spelling of a why: no spaces, so a reader splits the frame on its spaces (one pass; the index is kept for the callers that still pass one)
  def fsg-clean(s, i) = str-join-with(split-on(s, " "), "-");
  // A writer OFFERS: an offer on a name that already stands (a dead flow's frame, a watcher's mapping) maps the same object in place, so every reader sees this writer's frame,
  // and its write lands. A receive handle is read-only: a write through it is a silent no-op, which once left live flows blind behind the last run's rows. Receive is only the
  // fallback when the offer is refused, and that is said aloud.
  def fsg-open-handle(name) {
   let got = shm_offer(name, FSGBytes());
   nothing?(got) ? fsg-open-fallback(name) : got;
  }
  def fsg-open-fallback(name) {
   let said = print_str("flow-signal: the offer of " ++ name ++ " was refused; this flow's cells will not reach the frame\n");
   shm_receive(name);
  }
  // a frame given whole: a write that did not land (no handle, or the handle answered nothing) is said aloud once per writer
  def fsg-give(F, key, text) {
   let h = record_get(F, key);
   let r = nothing?(h) ? nothing() : shm_write(h, text);
   nothing?(r) ? fsg-blind(F, key) : r;
  }
  def fsg-blind(F, key) {
   let seen = record_get(F, "blind");
   nothing?(seen) || seen == 0 ? fsg-blind-say(F, key) : 0;
  }
  def fsg-blind-say(F, key) {
   let a = record_set(F, "blind", 1);
   let b = print_str("flow-signal: a write to the " ++ key ++ " frame of " ++ record_get(F, "id") ++ " did not land; the frame is blind to this flow\n");
   0;
  }
  // the names behind the codes, read only by a reader that wants words (a writer never looks a name up: it holds the code)
  def fsg-stages() = ["plan", "cand", "appl", "band", "land", "end", "start", "serve"];
  def fsg-kinds() = ["go", "ok", "part", "disc", "fix", "end"];
  def fsg-glyphs() = ".>+~!R";
  def fsg-index(names, name, i) = nil?(names) ? 15 : (String) names[0] == (String) name ? i : fsg-index(names[1:], name, i + 1);
  def fsg-stage-index(stage) = fsg-index(fsg-stages(), stage, 0);
  def fsg-kind-index(kind) = fsg-index(fsg-kinds(), kind, 0);
  def fsg-cap(v, hi) = v > hi ? hi : v < 0 ? 0 : v;
  // What a landing is witnessed by: a behavioural reading, never the compile. A band stands (the request's own, or one the voice authored in scratch) and its verdict holds at least one claim (full >= 1: a claim read over a call),
  // or an edited band file reads what it read before. A candidate whose only witness is that its files compile answers no request (frq-4fdd05e7916d5d0c, frq-4b09fbf1b6cca1f0, frq-0aae08039590a06d landed that way).
  def fsg-witness(band, full, bandfile?) = bandfile? || (len(band) > 0 && full >= 1) ? "behavioural" : "no-behavioural-witness";
  // What an edit may not do to a definition that already stood: stop calling what it called. frq-4b09fbf1b6cca1f0 turned its fixture by rewriting dcc-reply-lands? (95b3e19d7) so that three of its four covenant checks
  // (dc-reply-receivable?, dc-ends-open?, dc-one-teaching?) were no longer called: the band read full and the predicate it was asked to wire was weaker. The comparison is generic: for every definition the old text holds
  // and the new text still holds by name, the names the old body calls (a name run closed by "(") must still be called by the new body, unless the request's own words name them (then the asking is what removes them).
  // Added definitions are free; comments are not code. Answers [[definition, [dropped names]]], empty when nothing was weakened.
  def fsg-wk-code(region) = str-join-with(filter(l => str_find(trim(l), "//", 0) != 0, split-on(region, "\n")), "\n");
  def fsg-wk-calls-from(t, p, own, acc) {
   let at = str_find(t, "(", p);
   let n = at < 0 ? "" : substring(t, fdw-name-start(t, at, 0), at);
   at < 0 ? acc : fsg-wk-calls-from(t, at + 1, own, len(n) > 1 && (String) n != (String) own && !any?(x => (String) x == (String) n, acc) ? append(acc, [n]) : acc);
  }
  def fsg-wk-dropped(oldr, newr, own, words) {
   let still = fsg-wk-calls-from(newr, 0, own, []);
   filter(n => !any?(m => (String) m == (String) n, still) && str_find(words, n, 0) < 0, fsg-wk-calls-from(oldr, 0, own, []));
  }
  // A definition the old text held and the new text no longer holds is the whole body dropped: weakened, unless the request's own words ask for a removal (frq-6c23e5a7d9fbb3c4 asked to add tm-grow-with and the candidate deleted it, 616141f6f, reverted).
  def fsg-wk-asked-gone?(words) = any?(v => str_find(words, v, 0) >= 0, ["remove", "delete", "retire", "drop", "rename", "replace"]);
  def fsg-wk-row(acc, x, oldtext, newtext, ni, words) {
   let d = nothing?(fdw-named(ni, x[2])) ? (fsg-wk-asked-gone?(words) ? [] : ["(removed)"]) : fsg-wk-dropped(fsg-wk-code(fdw-region-of(oldtext, [x], x[2])), fsg-wk-code(fdw-region-of(newtext, ni, x[2])), x[2], words);
   len(d) == 0 ? acc : append(acc, [[x[2], d]]);
  }
  def fsg-wk-weakened(oldtext, newtext, words) {
   let ni = fdw-infos(newtext);
   foldl((acc, x) => fsg-wk-row(acc, x, oldtext, newtext, ni, words), [], filter(x => fdw-bml-sig?(x), fdw-infos(oldtext)));
  }
  // The manifest: a request that names no definitions (feature-sized: "a classifier door", "a reading door") ended in three refusal kinds, each because the voice had no small thing to build and read: nothing edited, a band
  // no definition answered, a band that called a name no file holds. The plan step asks the voice for one line a definition, "name(params) :: call == expected", from the request's own words; what is not that shape falls away.
  // The rows are handed to the candidate (fsg-mf-block), become the witness band (fsg-mf-band: one claim per fixture, nothing for the voice to author or mis-name) and answer an unbound name (fsg-mf-note).
  def fsg-mf-byte?(b) = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 95 || b == 63;
  def fsg-mf-name?(s) = len(s) > 0 && all?(i => fsg-mf-byte?(str_byte_at(s, i)), range(0, len(s)));
  def fsg-mf-clean(l) {
   let t = trim(l);
   let u = str_find(t, "- ", 0) == 0 || str_find(t, "* ", 0) == 0 ? trim(substring(t, 2, len(t))) : t;
   len(u) > 1 && substring(u, 0, 1) == "`" && substring(u, len(u) - 1, len(u)) == "`" ? substring(u, 1, len(u) - 1) : u;
  }
  def fsg-mf-row(line) {
   let at = str_find(line, " :: ", 0);
   let eq = at < 0 ? -1 : str_find(line, " == ", at + 4);
   let sig = at < 0 ? "" : trim(substring(line, 0, at));
   let call = eq < 0 ? "" : trim(substring(line, at + 4, eq));
   let exp = eq < 0 ? "" : trim(substring(line, eq + 4, len(line)));
   let p = str_find(sig, "(", 0);
   let name = p < 1 ? "" : substring(sig, 0, p);
   fsg-mf-name?(name) && substring(sig, len(sig) - 1, len(sig)) == ")" && str_find(call, name ++ "(", 0) == 0 && len(exp) > 0 && str_find(call, ";", 0) < 0 && str_find(exp, ";", 0) < 0 ? [name, sig, call, exp] : nothing();
  }
  // two fixtures a definition, never the same call twice: one fixture is passed by a constant (its value) or an echo (its argument), two that answer different values are passed only by a definition that tells them apart
  def fsg-mf-keep(acc, r) = any?(x => (String) x[2] == (String) r[2], acc) || len(filter(x => (String) x[0] == (String) r[0], acc)) >= 2 ? acc : append(acc, [r]);
  def fsg-mf-rows(text) = take(8, foldl((acc, r) => fsg-mf-keep(acc, r), [], filter(r => !nothing?(r), map(l => fsg-mf-row(fsg-mf-clean(l)), split-on(text, "\n")))));
  def fsg-mf-merge(rows, more) = take(8, foldl((acc, r) => fsg-mf-keep(acc, r), rows, more));
  def fsg-mf-names(rows) = foldl((acc, r) => any?(x => (String) x == (String) r[0], acc) ? acc : append(acc, [r[0]]), [], rows);
  def fsg-mf-of(rows, name) = filter(r => (String) r[0] == (String) name, rows);
  // contrast: two of a definition's fixtures answer different values and one answers a value its call did not hand it. Without it the band cannot tell a definition from a constant or an echo, and what is missing is one fixture line
  def fsg-mf-handed?(r) = str_find((String) r[2], (String) r[3], len(r[0]) + 1) >= 0;
  def fsg-mf-contrast?(rows, name) {
   let fs = fsg-mf-of(rows, name);
   len(fsg-mf-names(map(r => [r[3]], fs))) >= 2 && any?(r => !fsg-mf-handed?(r), fs);
  }
  def fsg-mf-flat(rows) = filter(n => !fsg-mf-contrast?(rows, n), fsg-mf-names(rows));
  def fsg-mf-contrast-ask(rows, names) = "These definitions hold no contrast yet: a constant, or a definition that hands back its argument, would answer every fixture they have.\n" ++ fsg-mf-join(map(r => r[1] ++ " :: " ++ r[2] ++ " == " ++ r[3], filter(r => any?(n => (String) n == (String) r[0], names), rows)), "\n") ++ "\nFor each, give ONE more line in the same shape, from the request's words: its call hands the definition other arguments, and its value differs from the value above and from what the call hands it (a classifier: a reading of another kind). Answer with the lines only.";
  // A fixture's value has a source: the request's words, or the definition as it stood. frq-4fdd05e7916d5d0c (82c1d8176, reverted) wrote 60 and 3000 into ds-cost-ms for kinds no caller sends, and its band called those
  // values "the request's own words"; neither the request nor the definition's old body held them. A fixture whose value the edit writes into the definition as a literal that came from neither is invented: it is asked for again,
  // never counted as a witness.
  def fsg-mf-lit(r) { let v = trim((String) r[3]); len(v) >= 2 && str_byte_at(v, 0) == 34 && str_byte_at(v, len(v) - 1) == 34 ? substring(v, 1, len(v) - 1) : v; }
  def fsg-mf-invented(rows, goal, oldtext, newtext) = filter(r => len(fsg-mf-lit(r)) > 1 && str_find(goal, fsg-mf-lit(r), 0) < 0 && str_find(fdw-region(oldtext, r[0]), fsg-mf-lit(r), 0) < 0 && str_find(fdw-region(newtext, r[0]), fsg-mf-lit(r), 0) >= 0, rows);
  def fsg-mf-invented-ask(rows) = "These fixtures expect a value that neither the request's words nor the definition as it stood state, and the edit now writes that value into the definition:\n" ++ fsg-mf-join(map(r => "- " ++ r[2] ++ " == " ++ r[3], rows), "\n") ++ "\nA fixture's value comes from the request's words (a quoted number, name or list) or from a call that already stands. For each definition above give one fixture, in the same line form, whose value the request's words state.";
  def fsg-mf-join(xs, sep) = foldl((acc, x) => len(acc) == 0 ? x : acc ++ sep ++ x, "", xs);
  def fsg-mf-block(rows) = nil?(rows) ? "" : "\nDefinition manifest: " ++ fsg-mf-join(fsg-mf-names(rows), ", ") ++ "\nManifest, each line a definition :: a fixture call == the value the request's words give (write each definition with exactly that signature; every call, run against your edit, must answer its value, so a definition answers all of its lines). ADD these as new definitions and CALL the definitions the files already hold; do not rewrite an existing definition to turn a fixture: an edit that makes an existing definition stop calling what it called is put back as weakening:\n" ++ fsg-mf-join(map(r => "- " ++ r[1] ++ " :: " ++ r[2] ++ " == " ++ r[3], rows), "\n");
  def fsg-mf-pow(i) = i <= 0 ? 1 : 2 * fsg-mf-pow(i - 1);
  def fsg-mf-full(rows) = fsg-mf-pow(len(rows)) - 1;
  // claim i of a manifest band is fixture i: the bits a verdict lacks are the fixtures that did not hold, read from the number, not from what the band printed
  def fsg-mf-bit?(got, i) { let q = got / fsg-mf-pow(i); q - 2 * (q / 2) == 1; }
  def fsg-mf-failing(rows, got) = map(i => rows[i], filter(i => !fsg-mf-bit?(got, i), range(0, len(rows))));
  def fsg-mf-claim-defs(rows) = fsg-mf-join(map(i => "  def mf-c-" ++ i.str() ++ "(ctx) = " ++ rows[i][2] ++ " == " ++ rows[i][3] ++ ";", range(0, len(rows))), "\n");
  def fsg-mf-claim-list(rows) = fsg-mf-join(map(i => "[\"fixture-" ++ i.str() ++ "\", " ++ fsg-mf-pow(i).str() ++ ", 1, mf-c-" ++ i.str() ++ "]", range(0, len(rows))), ", ");
  def fsg-mf-band(label, preludes, rows) = "; " ++ label ++ " — the witness the flow wrote from the request's manifest: one claim per fixture call, each reading the value the request's own words gave.\n;\n; Expected: " ++ fsg-mf-full(rows).str() ++ "\n; preflight-exec: forbidden\n// preludes: form-stdlib/core.fk form-stdlib/bml/live.bml " ++ preludes ++ "\nsection [form.bml] {\n class MfBand {\n" ++ fsg-mf-claim-defs(rows) ++ "\n }\n live-claims(\"" ++ label ++ "\", 0, [" ++ fsg-mf-claim-list(rows) ++ "]);\n}\n";
  def fsg-mf-note(rows, name) = nil?(rows) || len(name) == 0 ? "" : "The definitions this request names are:\n" ++ fsg-mf-join(map(n => fsg-mf-of(rows, n)[0][1], fsg-mf-names(rows)), "\n") ++ "\nA name outside this list and outside the files shown is not in the body: call those, or write the definition you call.\n\n";
  // A fixture a definition only repeats is no witness: 7c128c84e added dc-classify(reply, given) = ["advise"] and dcc-classify-claims(reply, given) = [["me", "stuck"]], constants shaped exactly like the fixtures, and the generated
  // band read full. For each definition the edit ADDS (the old text does not hold it), a fixture of that name whose expected value stands verbatim in the body while no parameter name occurs in the body (the definition ignores
  // what it is handed), or a body that is only that value, reads constant. Answers the names; empty when every added definition answers from its arguments. Same pattern as fsg-wk-weakened.
  def fsg-mf-word-from(s, w, p) {
   let at = str_find(s, w, p);
   at < 0 ? false : (at == 0 || !fsg-mf-byte?(str_byte_at(s, at - 1))) && (at + len(w) >= len(s) || !fsg-mf-byte?(str_byte_at(s, at + len(w)))) ? true : fsg-mf-word-from(s, w, at + 1);
  }
  def fsg-mf-params(region) {
   let o = str_find(region, "(", 0);
   let c = o < 0 ? -1 : str_find(region, ")", o);
   c < 0 ? [] : filter(p => len(p) > 0, map(p => trim(p), split-on(substring(region, o + 1, c), ",")));
  }
  def fsg-mf-body(region) {
   let c = str_find(region, ")", 0);
   c < 0 ? "" : substring(region, c + 1, len(region));
  }
  // an echo is the same no-witness from the other side: ea3f6f608 added dr-reading-kind(k) = k under the fixture dr-reading-kind("received") == "received", and the band read full over a definition that hands back what it was handed
  def fsg-mf-echo?(t, region) = any?(p => t == "= " ++ p ++ ";" || t == "= " ++ p, fsg-mf-params(region));
  def fsg-mf-constant-of?(name, region, rows) {
   let body = fsg-wk-code(fsg-mf-body(region));
   let t = trim(body);
   len(filter(r => ((String) r[0] == (String) name && ((str_find(body, (String) r[3], 0) >= 0 && !any?(p => fsg-mf-word-from(body, p, 0), fsg-mf-params(region))) || fsg-mf-echo?(t, region))) || t == "= " ++ (String) r[3] ++ ";" || t == "= " ++ (String) r[3], rows)) > 0;
  }
  def fsg-mf-constant(oldtext, newtext, rows) {
   let oi = fdw-infos(oldtext);
   let ni = fdw-infos(newtext);
   nil?(rows) ? [] : map(x => x[2], filter(x => nothing?(fdw-named(oi, x[2])) && fsg-mf-constant-of?(x[2], fdw-region-of(newtext, ni, x[2]), rows), filter(x => fdw-bml-sig?(x), ni)));
  }
  // the five lights are one integer, three bits a stage, the stage's own position the weight
  def fsg-p8(i) = i <= 0 ? 1 : 8 * fsg-p8(i - 1);
  def fsg-light-of(lights, i) = (lights / fsg-p8(i)) % 8;
  def fsg-code(kind, was) = kind == "go" ? 1 : kind == "ok" ? (was == 5 || was == 3 ? was : 2) : kind == "part" ? 3 : kind == "disc" ? 4 : kind == "fix" ? 5 : was;
  def fsg-light(F, stage, kind) {
   let i = fsg-stage-index(stage);
   let ls = record_get(F, "lights");
   i > 4 ? ls : ls + (fsg-code(kind, fsg-light-of(ls, i)) - fsg-light-of(ls, i)) * fsg-p8(i);
  }
  def fsg-pack(lights, stage, kind, rep, got, missed) = lights + 32768 * (fsg-stage-index(stage) + 16 * (fsg-kind-index(kind) + 8 * (fsg-cap(rep, 63) + 64 * (fsg-cap(got, 4095) + 4096 * fsg-cap(missed, 255)))));
  // [lights, stage, kind, repairs, got, missed] of a state
  def fsg-unpack(s) = [s % 32768, (s / 32768) % 16, (s / 524288) % 8, (s / 4194304) % 64, (s / 268435456) % 4096, (s / 1099511627776) % 256];
  def fsg-name-at(names, i) = i >= 0 && i < len(names) ? names[i] : "?";
  // the lights as the five glyphs of the picture, for a reader that wants to show them
  def fsg-glyph-line(lights) = str-join(map(i => substring(fsg-glyphs(), fsg-light-of(lights, i), fsg-light-of(lights, i) + 1), [0, 1, 2, 3, 4]));
  // a writer's state: the frame handle, the bell, the request, the lights, the repairs, the clocks
  def fsg-state(slot, request) = record_new(0, "h", fsg-open-handle(fsg-name(slot)), "bell", fsg-open-handle(fsg-bell-name()), "id", request, "rep", 0, "t0", host_monotonic_ms(), "lights", 0, "stage", "plan", "kind", "go", "why", "go", "got", 0, "miss", 0, "blind", 0);
  def fsg-frame(F) = record_get(F, "id") ++ " " ++ fsg-pack(record_get(F, "lights"), record_get(F, "stage"), record_get(F, "kind"), record_get(F, "rep"), record_get(F, "got"), record_get(F, "miss")).str() ++ " " ++ record_get(F, "t0").str() ++ " " ++ host_monotonic_ms().str() ++ " " ++ record_get(F, "why");
  // opening a slot writes a FRESH frame (this request, no light lit, kind "go"): a persisted slot never shows a previous flow
  def fsg-new(slot, request) {
   let F = fsg-state(slot, request);
   let w = fsg-give(F, "h", fsg-frame(F));
   F;
  }
  // one cell: the lights and the counts move, the frame is given whole (one short line), the bell is rung. Answers the frame line.
  def fsg-emit(F, stage, kind, got, missed, why, ids, ms) {
   let a = record_set(F, "lights", fsg-light(F, stage, kind));
   let c = record_set(F, "stage", stage);
   let d = record_set(F, "kind", kind);
   let e = record_set(F, "why", fsg-clean(why, 0));
   let f = kind == "fix" ? record_set(F, "rep", record_get(F, "rep") + 1) : 0;
   let g = record_set(F, "got", got);
   let h = record_set(F, "miss", missed);
   let line = fsg-frame(F);
   let i = fsg-give(F, "h", line);
   let j = fsg-give(F, "bell", record_get(F, "id"));
   let k = kind == "disc" ? fb_record([stage, why, got, missed], "flow-signal:" ++ record_get(F, "id"), record_get(F, "rep")) : 0;
   line;
  }
  def fsg-release(F) {
   let a = nothing?(record_get(F, "h")) ? 0 : shm_release(record_get(F, "h"));
   nothing?(record_get(F, "bell")) ? 0 : shm_release(record_get(F, "bell"));
  }
  // the sparse durable fact of a request's end: one JSON row for a ledger the body already keeps
  def fsg-end-row(request, verdict, cause, got, missed, repairs, ms) = "{\"at_unix_ms\":" ++ now_unix_ms().str() ++ ",\"request\":\"" ++ request ++ "\",\"rung\":\"flow\",\"verdict\":\"" ++ verdict ++ "\",\"kind\":\"" ++ cause ++ "\",\"got\":" ++ got.str() ++ ",\"missed\":" ++ missed.str() ++ ",\"repairs\":" ++ repairs.str() ++ ",\"ms\":" ++ ms.str() ++ ",\"rent_tokens\":0}";
 }
 0;
}
