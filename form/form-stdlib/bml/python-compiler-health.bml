// Source admission and publication own their observation and abstention.
// Source bytes stay in the compiler's private evidence files.
// preludes: form-stdlib/organ-health.bml
section [form.bml] {
 class PythonCompilerHealth {
  def pch-reading(aspect,state,ok) = oh-reading("python-compiler",int_to_str(host_pid()),aspect,json-node-string("ready"),json-node-string(state),if lt(ok,0) then json-node-null() else json-node-int(ok),if eq(ok,0) then list(oh-need("admitted-source-or-publication",json-node-null())) else list(),if eq(ok,0) then list("abstain","request-evidence") else list("continue"),json-node-object(list(oh-n("pid",host_pid()))));
  def pch-observe(aspect,state,ok) = oh-voice(pch-reading(aspect,state,ok));
  def pch-refuse(reason) = pch-refuse-release(reason,"not-created");
  def pch-refuse-release(reason,cleanup) {
   let reading = pch-reading("admission-or-publication",reason,0);
   let response = oh-response(reading,"abstain");
   let selected = oh-select(reading,response,"request-evidence");
   oh-voice(reading); oh-voice(response);
   oh-voice(oh-applied(reading,selected,json-node-object(list(oh-s("publication","withheld"),oh-s("owned-stage",cleanup)))));
   form_error(reason);
  }
 }
 0;
}
