// Typed JSON admission happens before any model hash or hardware admission.
// Prelude JSON syntax admission carries nesting as Form data without a fixed cap.
// preludes: form-stdlib/bml/metal-ask.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 class MetalAskRequest {
  def mar-text(request,key,default) = json-object-has?(request,key) ? json-string-value(json-object-get(request,key)) : default;
  def mar-optional-type(request,key,type) = json-object-has?(request,key) ? ((Comparable) node_type(json-object-get(request,key)) == type) : 1;
  def mar-member(keys,key) = nil?(keys) ? 0 : (String) head(keys) == key ? 1 : mar-member(tail(keys),key);
  def mar-unique(pairs,seen) = nil?(pairs) ? 1 : mar-member(seen,json-pair-key(head(pairs))) ? 0 : mar-unique(tail(pairs),cons(json-pair-key(head(pairs)),seen));
  def mar-schema(request) = !node_eq(node_category(request),JSON-OBJECT()) ? "request-object-required" : !mar-unique(json-object-pairs(request),list()) ? "request-duplicate-field" : !(json-object-has?(request,"prompt") && mar-optional-type(request,"prompt",2)) ? "request-prompt-string-required" : !(mar-optional-type(request,"model",2) && (mar-optional-type(request,"blob",2) && mar-optional-type(request,"artifact",2))) ? "request-option-string-required" : !mar-optional-type(request,"max_tokens",1) ? "request-token-cap-integer-required" : "";
  def mar-read(text) = nothing?(text) ? list(0,"request-json-required") : !jwa-valid(text) ? list(0,"request-json-invalid") : mar-parsed(parse-json("metal-ask-request",text));
  def mar-parsed(request) = mar-checked(request,mar-schema(request));
  def mar-checked(request,reason) = str_len(reason) > 0 ? list(0,reason) : list(1,request);
  def mar-input-refused(reason) = ma-refuse(record_new(0,"ok",0,"reason","","text","","buffers",list(),"pipelines",list()),reason);
  def mar-run-text(text) = mar-run-admitted(mar-read(text));
  def mar-run-admitted(admitted) = !head(admitted) ? ma-voice-refusal(mar-input-refused(admitted[1])) : mar-run(admitted[1]);
  def mar-run(request) {
   let prompt = mar-text(request,"prompt","");
   let cap = json-object-has?(request,"max_tokens") ? json-int-value(json-object-get(request,"max_tokens")) : 96;
   let owner = ma-ask(mar-text(request,"blob",ma-blob()),mar-text(request,"model",ma-model()),prompt,cap);
   let path = mar-text(request,"artifact",anl-artifact-path());
   ma-publish(owner,path) ? print_str(ma-artifact(owner)) : ma-voice-refusal(owner);
  }
 }
 0;
}
