// Typed JSON admission happens before any model hash or hardware admission.
// Prelude JSON syntax admission carries nesting as Form data without a fixed cap.
// preludes: form-stdlib/bml/metal-ask.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 class MetalAskRequest {
  def mar-text(request,key,default) = if json-object-has?(request,key) then json-string-value(json-object-get(request,key)) else default;
  def mar-optional-type(request,key,type) = if json-object-has?(request,key) then eq(node_type(json-object-get(request,key)),type) else 1;
  def mar-member(keys,key) = if nil?(keys) then 0 else if str_eq(head(keys),key) then 1 else mar-member(tail(keys),key);
  def mar-unique(pairs,seen) = if nil?(pairs) then 1 else if mar-member(seen,json-pair-key(head(pairs))) then 0 else mar-unique(tail(pairs),cons(json-pair-key(head(pairs)),seen));
  def mar-schema(request) = if not(node_eq(node_category(request),JSON-OBJECT())) then "request-object-required" else if not(mar-unique(json-object-pairs(request),list())) then "request-duplicate-field" else if not(and(json-object-has?(request,"prompt"),mar-optional-type(request,"prompt",2))) then "request-prompt-string-required" else if not(and(mar-optional-type(request,"model",2),and(mar-optional-type(request,"blob",2),mar-optional-type(request,"artifact",2)))) then "request-option-string-required" else if not(mar-optional-type(request,"max_tokens",1)) then "request-token-cap-integer-required" else "";
  def mar-read(text) = if nothing?(text) then list(0,"request-json-required") else if not(jwa-valid(text)) then list(0,"request-json-invalid") else mar-parsed(parse-json("metal-ask-request",text));
  def mar-parsed(request) = mar-checked(request,mar-schema(request));
  def mar-checked(request,reason) = if gt(str_len(reason),0) then list(0,reason) else list(1,request);
  def mar-input-refused(reason) = ma-refuse(record_new(0,"ok",0,"reason","","text","","buffers",list(),"pipelines",list()),reason);
  def mar-run-text(text) = mar-run-admitted(mar-read(text));
  def mar-run-admitted(admitted) = if not(head(admitted)) then ma-voice-refusal(mar-input-refused(nth(admitted,1))) else mar-run(nth(admitted,1));
  def mar-run(request) {
   let prompt = mar-text(request,"prompt","");
   let cap = if json-object-has?(request,"max_tokens") then json-int-value(json-object-get(request,"max_tokens")) else 96;
   let owner = ma-ask(mar-text(request,"blob",ma-blob()),mar-text(request,"model",ma-model()),prompt,cap);
   let path = mar-text(request,"artifact",anl-artifact-path());
   if ma-publish(owner,path) then print_str(ma-artifact(owner)) else ma-voice-refusal(owner);
  }
 }
 0;
}
