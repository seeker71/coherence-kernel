// Sum every model reported by a retained provider CLI result.
// modelUsage uses disjoint input, cache-read, cache-creation and output quantities.
// Coverage is this result's reported models, not the surrounding session.
// preludes: form-stdlib/json.fk
section [form.bml] {
 class FormCliProviderModelUsage {
  def pmu-number(doc,key) {
   !json-object-has?(doc,key) ? nothing() : {
    let node = json-object-get(doc,key); let value = json-int-value(node);
    !((String) value_kind(value) == "int") ? nothing()
    : !node_eq(node,json-node-int(value)) ? nothing()
    : value < 0 ? nothing() : value;
   };
  }
  def pmu-values(row) = list(pmu-number(row,"inputTokens"),pmu-number(row,"cacheReadInputTokens"),pmu-number(row,"cacheCreationInputTokens"),pmu-number(row,"outputTokens"));
  def pmu-known?(xs) = nil?(xs) ? 1 : nothing?(head(xs)) ? 0 : pmu-known?(tail(xs));
  def pmu-add(a,b) = nil?(a) ? list() : cons(head(a) + head(b),pmu-add(tail(a),tail(b)));
  def pmu-sum(models,keys,acc) {
   nil?(keys) ? acc : {
    let values = pmu-values(json-object-get(models,head(keys)));
    !pmu-known?(values) ? nothing() : pmu-sum(models,tail(keys),pmu-add(acc,values));
   };
  }
  def pmu-n(key,value) = json-node-pair(key,json-node-int(value));
  def pmu-s(key,value) = json-node-pair(key,json-node-string(value));
  def pmu-unobserved(reason) = json-node-object(list(pmu-s("status","unobserved"),pmu-s("reason",reason),json-node-pair("total_tokens",json-node-null())));
  def pmu-report(result) {
   let models = json-object-get(result,"modelUsage"); let keys = json-object-keys(models);
   nil?(keys) || (!node_eq(models,json-node-object(json-object-pairs(models)))) ? pmu-unobserved("reported-model-usage-absent") : {
    let sum = pmu-sum(models,keys,list(0,0,0,0));
    nothing?(sum) ? pmu-unobserved("reported-model-counter-missing-or-invalid") : {
     let input = head(sum) + (sum[1] + sum[2]); let output = sum[3];
     json-node-object(list(pmu-s("status","observed"),pmu-s("scope","all models reported in this retained CLI result"),pmu-n("model_count",len(keys)),pmu-n("input_tokens",input),pmu-n("cached_input_tokens",sum[1]),pmu-n("cache_write_input_tokens",sum[2]),pmu-n("uncached_input_tokens",head(sum) + sum[2]),pmu-n("output_tokens",output),pmu-n("total_tokens",input + output)));
    };
   };
  }
 }
}
