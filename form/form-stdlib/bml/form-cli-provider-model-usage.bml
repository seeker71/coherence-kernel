// Sum every model reported by a retained provider CLI result.
// modelUsage uses disjoint input, cache-read, cache-creation and output quantities.
// Coverage is this result's reported models, not the surrounding session.
// preludes: form-stdlib/json.fk
section [form.bml] {
 class FormCliProviderModelUsage {
  def pmu-number(doc,key) {
   if not(json-object-has?(doc,key)) then nothing() else {
    let node = json-object-get(doc,key); let value = json-int-value(node);
    if not(str_eq(value_kind(value),"int")) then nothing()
    else if not(node_eq(node,json-node-int(value))) then nothing()
    else if lt(value,0) then nothing() else value;
   };
  }
  def pmu-values(row) = list(pmu-number(row,"inputTokens"),pmu-number(row,"cacheReadInputTokens"),pmu-number(row,"cacheCreationInputTokens"),pmu-number(row,"outputTokens"));
  def pmu-known?(xs) = if nil?(xs) then 1 else if nothing?(head(xs)) then 0 else pmu-known?(tail(xs));
  def pmu-add(a,b) = if nil?(a) then list() else cons(add(head(a),head(b)),pmu-add(tail(a),tail(b)));
  def pmu-sum(models,keys,acc) {
   if nil?(keys) then acc else {
    let values = pmu-values(json-object-get(models,head(keys)));
    if not(pmu-known?(values)) then nothing() else pmu-sum(models,tail(keys),pmu-add(acc,values));
   };
  }
  def pmu-n(key,value) = json-node-pair(key,json-node-int(value));
  def pmu-s(key,value) = json-node-pair(key,json-node-string(value));
  def pmu-unobserved(reason) = json-node-object(list(pmu-s("status","unobserved"),pmu-s("reason",reason),json-node-pair("total_tokens",json-node-null())));
  def pmu-report(result) {
   let models = json-object-get(result,"modelUsage"); let keys = json-object-keys(models);
   if or(nil?(keys),not(node_eq(models,json-node-object(json-object-pairs(models))))) then pmu-unobserved("reported-model-usage-absent") else {
    let sum = pmu-sum(models,keys,list(0,0,0,0));
    if nothing?(sum) then pmu-unobserved("reported-model-counter-missing-or-invalid") else {
     let input = add(head(sum),add(nth(sum,1),nth(sum,2))); let output = nth(sum,3);
     json-node-object(list(pmu-s("status","observed"),pmu-s("scope","all models reported in this retained CLI result"),pmu-n("model_count",len(keys)),pmu-n("input_tokens",input),pmu-n("cached_input_tokens",nth(sum,1)),pmu-n("cache_write_input_tokens",nth(sum,2)),pmu-n("uncached_input_tokens",add(head(sum),nth(sum,2))),pmu-n("output_tokens",output),pmu-n("total_tokens",add(input,output))));
    };
   };
  }
 }
}
