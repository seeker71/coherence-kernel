// The same observed input-resource owner serves a distinct view-plan request.
// preludes: form/form-stdlib/bml/dsv4-tensor-views.bml form/form-stdlib/bml/dsv4-oracle-input.bml
section [form.bml] {
 class Dsv4TensorViewsInput {
  def dtvi-parse(bytes) = dtvi-fields(split-on(dsi-without-final-lf(bytes),byte_to_str(0)));
  def dtvi-fields(fields) = if (!(((Comparable) len(fields) == 7) && (((String) head(fields) == "DTV1") && (((String) nth(fields,5) == "END") && ((String) nth(fields,6) == ""))))) then dqi-refused("one complete DTV1 tensor view request required") else dtvi-values(nth(fields,1),dqi-int(nth(fields,2)),dqi-int(nth(fields,3)),nth(fields,4));
  def dtvi-values(path,maximum,page,out) = if (!(dqi-path(path) && (dqi-path(out) && dtv-geometry-good(maximum,page)))) then dqi-refused("typed tensor view path maximum page and destination required") else record_new(0,"ready",1,"reason","complete tensor view request","path",path,"maximum",maximum,"page",page,"out",out);
  def dtvi-run() {
   let request = dsi-read-at-with(0,nothing(),dtvi-parse); dfo-require(((Comparable) record_get(request,"ready") == 1),record_get(request,"reason"));
   let plan = dtv-plan(record_get(request,"path"),record_get(request,"maximum"),record_get(request,"page")); dtv-publish-params(plan,record_get(request,"out")); dtv-emit(plan);
  }
 }
 0;
}
