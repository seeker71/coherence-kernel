// The lines of the source tree that name a symbol, read in process.
//
// The healer offers its guide the current references to the symbol a failure named. It ran `rg -n -F --glob *.fk --glob *.bml --
// symbol form observe model cognition learn` as a program for it. The search is a file walk and a string find, and the body has both:
// fh-references(symbol) answers [exit, text] with the lines as `path:line:text` (the shape `rg -n` printed), exit 0 when something
// matched and 1 when nothing did, the way `rg` exits. Only .fk and .bml files are read, hidden entries are not entered, a directory
// that is not there is skipped, and the list stops at fh-reference-cap() lines. A file is read whole and searched with one find; it
// is split into lines only when it names the symbol, so a search over the tree costs the reading, not a line loop per file.
//
// PROOF: form-stdlib/tests/form-cli-heal-native-band.bml (claim 8192).
import form-stdlib/line-grammar.fk;
import form-stdlib/bml/order.bml;
section [form.bml] {
 class FormCliHealReferences {
  def fh-reference-cap() = 200;
  def fh-reference-dirs() = ["form", "observe", "model", "cognition", "learn"];
  def fh-has-suffix(s, suffix) = (len(s) >= len(suffix)) && ((String) substring(s, len(s) - len(suffix), len(s)) == suffix);
  def fh-source-leaf?(leaf) = fh-has-suffix(leaf, ".fk") || fh-has-suffix(leaf, ".bml");
  def fh-ref-sources(dir) = foldl((acc, leaf) => append(acc, fh-ref-entry(dir + "/" + leaf, leaf)), [], sort-strings(fs_list(dir) ?? []));
  def fh-ref-entry(path, leaf) = (String) substring(leaf, 0, 1) == "." ? [] : ((Comparable) fs_is_dir(path) == 1) ? fh-ref-sources(path) : fh-source-leaf?(leaf) ? [path] : [];
  def fh-ref-lines(path, lines, symbol, n) = nil?(lines) ? [] : (str_find(lines[0], symbol, 0) >= 0) ? cons(path + ":" + n.str() + ":" + lines[0], fh-ref-lines(path, lines[1:], symbol, n + 1)) : fh-ref-lines(path, lines[1:], symbol, n + 1);
  def fh-ref-file(path, symbol) {
   let text = read_file(path) ?? "";
   (str_find(text, symbol, 0) < 0) ? [] : fh-ref-lines(path, split-on(text, "\n"), symbol, 1);
  }
  def fh-ref-collect(paths, symbol, found) = nil?(paths) || (len(found) >= fh-reference-cap()) ? found : fh-ref-collect(paths[1:], symbol, append(found, fh-ref-file(paths[0], symbol)));
  def fh-references(symbol) {
   let files = foldl((acc, dir) => append(acc, (Comparable) fs_is_dir(dir) == 1 ? fh-ref-sources(dir) : []), [], fh-reference-dirs());
   let hits = len(symbol) == 0 ? [] : fh-ref-collect(files, symbol, []);
   let kept = fh-cap-lines(hits, fh-reference-cap());
   [len(kept) > 0 ? 0 : 1, fh-join-lines(kept)];
  }
  def fh-cap-lines(lines, n) = (len(lines) <= n) ? lines : fh-take(lines, n);
  def fh-take(lines, n) = (n <= 0) || nil?(lines) ? [] : cons(lines[0], fh-take(lines[1:], n - 1));
  def fh-join-lines(lines) = nil?(lines) ? "" : lines[0] + "\n" + fh-join-lines(lines[1:]);
 }
 0;
}
