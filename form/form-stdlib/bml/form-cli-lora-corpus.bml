//////////////////////////////////////////////////////////////////////
//
// form-cli-lora-corpus.bml — high-grammar authority.
//
// Enough LoRA examples to bring lens/staking/perception/movement
// home: every lens organ on every query lane, train 12 + heldout 4.
// The file is gitignored. Rank-1 A/B seeds from Form samples.
// Qwen GGUF stays frozen. fqt-lora? stays 0 until generate loads
// tensors. No sealed prompt. No chat transcript.
//
// Executable: form-stdlib/form-cli-lora-corpus.bml
// Proven by: form-stdlib/tests/form-cli-lora-corpus-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.cli.loracorpus;

import Form.kernel.*;
import Form.cli.flow.*;

interface ILoraCorpus [public, witness, reusable] {
   section [public] {
      const int MixA = 7;
      const int MixB = 13;
      const int NSkills = 8;
      const int NLanes = 9;
      const int TrainN = 12;
      const int HeldoutN = 4;
      const int Dim = 64;
      const int FqtLora = 0;
      const String CorpusPath = ".form-lora-corpus";
      const String TrustRule = "mint enough Form samples; Qwen tensors stay frozen until generate loads them";

      int N() [abstract];
      String Line( Object hRow ) [abstract];
      int LoraWriterReady() [abstract];
   }
}

template SampleRow<TClass> [public, reusable] {
   section [public] {
      String Split() [get];
      TClass Class() [get];
      String Situation() [get];
   }
}

class FormLoraCorpus [public, reusable, teach] : ILoraCorpus {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-lora-corpus.bml";

      int N() [abstract] {}
      String Line( Object hRow ) [abstract] {}
      int LoraWriterReady() [abstract] {}
   }
}

class FormLoraCorpusSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-lora-corpus-self";
      const String Pattern = "enough-samples gitignored-corpus rank-1-seed fqt-lora-stays-0";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
