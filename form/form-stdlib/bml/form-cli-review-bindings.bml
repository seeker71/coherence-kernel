// Review evidence belongs to exact caller-owned documents and report fields.
// This checks links, never whether a quote entails the reviewer's conclusion.
// preludes: form-stdlib/bml/form-cli-code-policy.bml
section [form.bml] {
 class FormCliReviewBindings {
  def fcrb-present(text,quote) = and(gt(str_len(fat-trim(quote)),0),ge(str_find(text,quote,0),0));
  def fcrb-fail(index,reason) = list(0,str_concat("Review binding ",str_concat(int_to_str(index),str_concat(": ",reason))),0,0);
  // draft and report are parsed objects; sources are caller-selected [id,path,text].
  // Return [passed, observation, applied count, unresolved count].
  def fcrb-check(draft,report,sources) = if not(and(fat-wire-object?(draft),fat-wire-object?(report))) then fcrb-fail(0,"draft and report must be objects") else if not(fat-wire-array?(json-object-get(report,"review_findings"))) then fcrb-fail(0,"review_findings must be an array") else fcrb-rows(node_children(json-object-get(report,"review_findings")),draft,report,sources,0,0,0);
  def fcrb-rows(rows,draft,report,sources,index,applied,unresolved) = if nil?(rows) then list(1,"Exact review links checked; finding completeness, entailment and answer quality remain unmeasured.",applied,unresolved) else fcrb-next(rows,draft,report,sources,index,applied,unresolved,fcrb-row(head(rows),draft,report,sources,index));
  def fcrb-next(rows,draft,report,sources,index,applied,unresolved,checked) = if not(head(checked)) then checked else fcrb-rows(tail(rows),draft,report,sources,add(index,1),add(applied,nth(checked,2)),add(unresolved,nth(checked,3)));
  def fcrb-row(row,draft,report,sources,index) {
   let field = fcap-string(row,"draft_field");
   let quote = fcap-string(row,"draft_quote");
   let source = fat-find-doc(sources,fcap-string(row,"source_path"));
   if not(fat-wire-object?(row)) then fcrb-fail(index,"finding must be an object") else if not(and(fat-wire-string?(json-object-get(draft,field)),fat-wire-string?(json-object-get(report,field)))) then fcrb-fail(index,"draft_field must name a string field in both reports") else if not(fcrb-present(fcap-string(draft,field),quote)) then fcrb-fail(index,"draft_quote is absent from its named field") else if nil?(source) then fcrb-fail(index,"source_path is not in caller-selected evidence") else if not(fcrb-present(nth(source,2),fcap-string(row,"source_quote"))) then fcrb-fail(index,"source_quote is absent from its named document") else if str_eq(fat-trim(fcap-string(row,"explanation")),"") then fcrb-fail(index,"explanation is empty") else fcrb-status(row,draft,report,index,field,quote);
  }
  def fcrb-status(row,draft,report,index,field,quote) {
   let status = fcap-string(row,"status");
   let replacement = fcap-string(row,"replacement_quote");
   let operation = if json-object-has?(row,"operation") then fcap-string(row,"operation") else "replace";
   if not(fat-wire-string?(json-object-get(row,"replacement_quote"))) then fcrb-fail(index,"replacement_quote must be a string") else if str_eq(status,"unresolved") then if str_eq(replacement,"") then list(1,"unresolved link retained",0,1) else fcrb-fail(index,"unresolved finding must leave replacement_quote empty") else if not(str_eq(status,"applied")) then fcrb-fail(index,"status must be applied or unresolved") else if str_eq(fcap-string(draft,field),fcap-string(report,field)) then fcrb-fail(index,"applied finding left its field unchanged") else if str_eq(operation,"delete") then if and(str_eq(replacement,""),lt(str_find(fcap-string(report,field),quote,0),0)) then list(1,"deleted quote absent from changed field",1,0) else fcrb-fail(index,"delete requires an empty replacement and the draft quote absent from the corrected field") else if not(str_eq(operation,"replace")) then fcrb-fail(index,"operation must be replace or delete") else if str_eq(quote,replacement) then fcrb-fail(index,"applied replacement repeats the draft quote") else if not(fcrb-present(fcap-string(report,field),replacement)) then fcrb-fail(index,"replacement_quote is absent from its named corrected field") else list(1,"applied link retained",1,0);
  }
 }
 0;
}
