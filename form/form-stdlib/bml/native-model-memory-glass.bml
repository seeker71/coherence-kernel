package Form.native.modelmemoryglass;

import Form.kernel.*;
import Form.native.modelglass.*;
import Form.native.residentfleet.*;

interface INativeModelMemoryGlass [public, witness, reusable] {
   section [public] {
      const String Schema = "native-model-memory-glass-v1";
      const String CapacityRule = "width is physical-byte share of the configured wired budget; overlays with unknown bytes are visibly unscaled";
      const String ColourRule = "green is native world, blue is dense NL-to-Form, purple is reasoning weights, orange is MoE experts, cyan is KV or recurrent substate, neutral is headroom";
      const String ReadAgeRule = "fill alpha carries read age: recent is opaque and older is increasingly transparent";
      const String WriteAgeRule = "edge alpha carries write age: recent mutable state is opaque while immutable weights carry a quiet edge";
      const String SymbolRule = "model diamond, weights block, expert hollow diamond, KV ledger, substate eye, active arrow, pinned stop, and eviction arrow remain readable without colour";
      const String EvictionRule = "the frontier marks the next policy-ranked physically evictable unit; desired but unavailable split grains are shown pinned rather than promised";
      const String PageRule = "logical fleet-clock access age never claims OS or Metal page residency; that requires a separate physical-live carrier";
      const String PrivacyRule = "only model identity, purpose, bytes, access age, state, and carrier handle enter the framebuffer; prompts and answers do not";

      Object Project( Object fleet, Object session ) [abstract];
      Object Write( Object fleet, Object session ) [abstract];
   }
}

class NativeModelMemoryGlass [public, resident, flow, observable, teach] : INativeModelMemoryGlass {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/native-model-memory-glass.bml";
      const String EventCategory = "FORM-MODEL-MEMORY-V1";
      const String PhysicalFloor = "current Qwen experts and both KV stores are packed allocations; the inactive whole model is the first physical release grain until split handles land";

      Object Project( Object fleet, Object session ) [abstract] {}
      Object Write( Object fleet, Object session ) [abstract] {}
   }
}
