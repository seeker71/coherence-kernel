   let latestRead = filter(x => (String) lfr-option-key(x[0]) == latestKey, read);
   let note = if nil?(latestRead) then "" else lfr-phase-note(latestRead[0][0], latestRead[0][1]);
   print_str(mc-cat(["[local-flow-review] local: ", len(all).str(), " option(s) (", here.str(), " in this checkout, ", (len(all) - here).str(), " only in ", if ((String) walk == "") then "no walk checkout" else walk, "), ", green.str(), " band green, ", verification[0].str(), " locally verified, ", verification[1].str(), " with verification unmeasured; ", lfr-count-text(counts), "; local tokens are welcome and never a target"]));
   print_str(mc-cat(["[local-flow-review] success: local_verified ", success[1].str(), " of ", success[0].str(), " gap(s) attempted, ", success[2].str(), " unread (their rows carry no local_verified)"]));
   print_str(mc-cat(["[local-flow-review] remote: guide prompts ", len(guides).str(), "; whole-task work tokens ", fcgp-show(work), " (null is unknown); optional review ", len(reviews).str(), " row(s), separate from required work"]));
   map(s => print_str(lfr-session-line(s, all, guides, reviews)), lfr-last(lfr-sessions(lfr-rows(lfr-rent())), 3));
   map(g => lfr-print-gap(g, all, guides, reviews, merged), gaps);
   map(l => print_str(l), lfr-phase-lines(read, newest, (!nil?(newest)) && lfr-has-out?(newest[0]), reviewed, pool));
   let line = lfr-next-line(next, note);
   let said = print_str(line);
   let row = json-node-object([fhn-n("at_unix_ms", now_unix_ms()), fhn-n("options", len(all)), fhn-n("options_here", here), fhn-s("walk_checkout", walk), fhn-n("green", green), fhn-n("local_verified", verification[0]), fhn-n("local_verification_unknown", verification[1]), fhn-n("open_gaps", len(open)), fhn-n("landing_pending", pending), fhn-n("local_generated_ids", counts[0] + counts[4]), fhn-n("local_injected_ids", counts[1] + counts[5]), fhn-n("lane_wall_ms", counts[2] + counts[6]), fhn-n("folded_options", counts[3]), fhn-n("folded_generated_ids", counts[4]), fhn-n("folded_injected_ids", counts[5]), fhn-n("folded_wall_ms", counts[6]), fhn-n("unread_options", counts[7]), fhn-n("unread_wall_ms", counts[8]), fhn-n("gaps_attempted", success[0]), fhn-n("gaps_local_verified", success[1]), fhn-n("gaps_unread", success[2]), fhn-n("remote_guide_prompts", len(guides)), fcgp-maybe("required_remote_tokens", work), fhn-n("remote_review_rows", len(reviews)), json-node-pair("phase", if nil?(latestRead) then json-node-null() else lfr-phase-row(latestRead[0][0], latestRead[0][1])), json-node-pair("phase_also", json-node-array(filter(p => !((String) lfr-str(p, "option_key") == latestKey), fresh))), json-node-pair("phase_unread", if (nil?(newest) || lfr-has-out?(newest[0])) then json-node-null() else json-node-string(lfr-option-key(newest[0]))), json-node-pair("phase_pool", pool), fhn-s("next", next[0]), fhn-s("next_text", mc-cat([next[1], note]))]);
   let kept = fhn-append(lfr-ledger(), json-emit(row) + "\n");
   line;
  }
 }
}
