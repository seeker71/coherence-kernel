// Resident document mutation; the coding policy owns role and writable checks.
// This tool proposes syntax repair. Existing compiler/behavior checks own success.
// preludes: form-stdlib/bml/form-agent-tool-wire.bml form-stdlib/bml/form-bml-boolean-repair.bml form-stdlib/sha256.fk
section [form.bml] {
 class FormCliCodeBmlRepair {
  def fcbmr-relevant(docs) = nil?(docs) ? 0 : ((str_find(head(docs)[2],"section [form.bml]",0) >= 0) || fcbmr-relevant(tail(docs)));
  def fcbmr-guidance() = "The native repair-bml tool takes arguments=[path] and empty input. In implement, it inserts right-nested binary and/or calls into caller-writable form.bml source while preserving other bytes. It reports native edit locations and before/after hashes. It does not compile, run checks, or fix behavior. Run verify afterward; repair any remaining failure. ";
  def fcbmr-rows(rows) = nil?(rows) ? list() : {
   let row = head(rows);
   cons(json-node-object(list(json-node-pair("operator",json-node-string(head(row))),json-node-pair("start_byte",json-node-int(row[1])),json-node-pair("end_byte",json-node-int(row[2])),json-node-pair("original_arity",json-node-int(row[3])))),fcbmr-rows(tail(rows)));
  };
  def fcbmr-call(docs,args,input) = !(((Comparable) len(args) == 1) && ((String) input == "")) ? fat-fail("repair-bml-needs-one-path-and-empty-input",docs) : fcbmr-doc(docs,fat-find-doc(docs,head(args)));
  def fcbmr-doc(docs,doc) = nil?(doc) ? fat-fail("resident-document-not-found",docs) : {
   let before = doc[2];
   let result = fbr-repair(before);
   !head(result) ? fat-fail(result[3],docs) : {
    let after = result[1];
    let observation = json-node-object(list(json-node-pair("method",json-node-string("native-bml-boolean-repair")),json-node-pair("changed_calls",json-node-int(len(result[2]))),json-node-pair("edits",json-node-array(fcbmr-rows(result[2]))),json-node-pair("before_sha256",json-node-string(hex-encode(sha256-stream-string(before)))),json-node-pair("after_sha256",json-node-string(hex-encode(sha256-stream-string(after)))),json-node-pair("checks_run",json-node-int(0)),json-node-pair("next",json-node-string("Run the unchanged compiler and behavior checks through verify."))));
    fat-bounded(fat-ok(json-emit(observation),fat-put-doc(docs,list(head(doc),doc[1],after))),docs);
   };
  };
 }
 0;
}
