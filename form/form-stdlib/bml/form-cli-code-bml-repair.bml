// Resident document mutation; the coding policy owns role and writable checks.
// This tool proposes syntax repair. Existing compiler/behavior checks own success.
import form-stdlib/bml/form-agent-tool-wire.bml;
import form-stdlib/bml/form-bml-boolean-repair.bml;
import form-stdlib/bml/form-source-lift.bml;
import form-stdlib/sha256.fk;
section [form.bml] {
 class FormCliCodeBmlRepair {
  def fcbmr-relevant(docs) = if nil?(docs) then 0 else ((str_find(docs[0][2],"section [form.bml]",0) >= 0) || fcbmr-relevant(docs[1:]));
  def fcbmr-guidance() = "Read-only bml-syntax takes arguments=[path] and empty input. It parses resident executable BML through the actual compiler without changing documents, publishing candidate files or invoking a process. Refusal retains the compiler diagnostic. Grammar admission does not prove bindings or behavior; the original execution checks still decide success. The native repair-bml tool takes arguments=[path] and empty input. In implement, it inserts right-nested binary and/or calls into caller-writable form.bml source while preserving other bytes. It reports native edit locations and before/after hashes. It does not compile, run checks, or fix behavior. Run verify afterward; repair any remaining failure. ";
  def fcbl-guidance() = "For BML source lifting, call {\"tool\":\"lift-bml\",\"arguments\":[\"path\"],\"input\":\"\"}. It transforms the whole resident writable document to compact operators, collections and imports, preserving bindings, operator providers and semantic structure, without model, file, process or network calls. changed=false means no supported lift remains: do not repeat it. A refusal preserves the original document; inspect the diagnostic and repair its cause before trying again. After changed=true, verify and finish the pending task, then review. Do not rewrite source that this tool can transform. ";
  def fcbl-call(docs,args,input) = len(args) != 1 || input != "" ? fat-fail("lift-bml-needs-one-path-and-empty-input",docs) : {
   let doc = fat-find-doc(docs,args[0]);
   nil?(doc) ? fat-fail("resident-document-not-found",docs) : try fcbl-doc(docs,doc) catch fat-fail("lift-bml-source-refused; original document retained for inspection; compiler organ signal emitted on stderr",docs);
  };
  def fcbl-doc(docs,doc) {
   let before = doc[2];
   if fsc-find-section-open(before,0) < 0 then fat-fail("lift-bml-needs-executable-BML",docs) else {
    let after = form-bml-import-lift(fsl-surface-sections(before,0));
    if !form-bml-semantic-equivalent?(before,after) then fat-fail("lift-bml-semantic-change-refused",docs) else {
     let observation = json-node-object([json-node-pair("method",json-node-string("native-bml-source-lift")),
      json-node-pair("changed",json-node-bool(before != after)),json-node-pair("equivalent",json-node-bool(true)),
      json-node-pair("before_sha256",json-node-string(fat-document-sha(doc))),
      json-node-pair("after_sha256",json-node-string(fat-document-sha([doc[0],doc[1],after]))),
      json-node-pair("checks_run",json-node-int(0))]);
     fat-bounded(fat-ok(json-emit(observation),fat-put-doc(docs,[doc[0],doc[1],after])),docs);
    };
   };
  }
  def fcbmr-rows(rows) = if nil?(rows) then [] else {
   let row = rows[0];
   cons(json-node-object([json-node-pair("operator",json-node-string(row[0])),json-node-pair("start_byte",json-node-int(row[1])),json-node-pair("end_byte",json-node-int(row[2])),json-node-pair("original_arity",json-node-int(row[3]))]),fcbmr-rows(rows[1:]));
  };
  def fcbmr-call(docs,args,input) = if (!(((Comparable) len(args) == 1) && ((String) input == ""))) then fat-fail("repair-bml-needs-one-path-and-empty-input",docs) else fcbmr-doc(docs,fat-find-doc(docs,args[0]));
  def fcbmr-doc(docs,doc) = if nil?(doc) then fat-fail("resident-document-not-found",docs) else {
   let before = doc[2];
   let result = fbr-repair(before);
   if (!result[0]) then fat-fail(result[3],docs) else {
    let after = result[1];
    let observation = json-node-object([json-node-pair("method",json-node-string("native-bml-boolean-repair")),json-node-pair("changed_calls",json-node-int(len(result[2]))),json-node-pair("edits",json-node-array(fcbmr-rows(result[2]))),json-node-pair("before_sha256",json-node-string(hex-encode(sha256-stream-string(before)))),json-node-pair("after_sha256",json-node-string(hex-encode(sha256-stream-string(after)))),json-node-pair("checks_run",json-node-int(0)),json-node-pair("next",json-node-string("Run the unchanged compiler and behavior checks through verify."))]);
    fat-bounded(fat-ok(json-emit(observation),fat-put-doc(docs,[doc[0],doc[1],after])),docs);
   };
  };
 }
 0;
}
