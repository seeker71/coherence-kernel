// Resident document mutation; the coding policy owns role and writable checks.
// This tool proposes syntax repair. Existing compiler/behavior checks own success.
// preludes: form-stdlib/bml/form-agent-tool-wire.bml form-stdlib/bml/form-bml-boolean-repair.bml form-stdlib/sha256.fk
section [form.bml] {
 class FormCliCodeBmlRepair {
  def fcbmr-relevant(docs) = if nil?(docs) then 0 else or(ge(str_find(nth(head(docs),2),"section [form.bml]",0),0),fcbmr-relevant(tail(docs)));
  def fcbmr-guidance() = "The native repair-bml tool takes arguments=[path] and empty input. In implement, it inserts right-nested binary and/or calls into caller-writable form.bml source while preserving other bytes. It reports native edit locations and before/after hashes. It does not compile, run checks, or fix behavior. Run verify afterward; repair any remaining failure. ";
  def fcbmr-rows(rows) = if nil?(rows) then list() else {
   let row = head(rows);
   cons(json-node-object(list(json-node-pair("operator",json-node-string(head(row))),json-node-pair("start_byte",json-node-int(nth(row,1))),json-node-pair("end_byte",json-node-int(nth(row,2))),json-node-pair("original_arity",json-node-int(nth(row,3))))),fcbmr-rows(tail(rows)));
  };
  def fcbmr-call(docs,args,input) = if not(and(eq(len(args),1),str_eq(input,""))) then fat-fail("repair-bml-needs-one-path-and-empty-input",docs) else fcbmr-doc(docs,fat-find-doc(docs,head(args)));
  def fcbmr-doc(docs,doc) = if nil?(doc) then fat-fail("resident-document-not-found",docs) else {
   let before = nth(doc,2);
   let result = fbr-repair(before);
   if not(head(result)) then fat-fail(nth(result,3),docs) else {
    let after = nth(result,1);
    let observation = json-node-object(list(json-node-pair("method",json-node-string("native-bml-boolean-repair")),json-node-pair("changed_calls",json-node-int(len(nth(result,2)))),json-node-pair("edits",json-node-array(fcbmr-rows(nth(result,2)))),json-node-pair("before_sha256",json-node-string(hex-encode(sha256-stream-string(before)))),json-node-pair("after_sha256",json-node-string(hex-encode(sha256-stream-string(after)))),json-node-pair("checks_run",json-node-int(0)),json-node-pair("next",json-node-string("Run the unchanged compiler and behavior checks through verify."))));
    fat-bounded(fat-ok(json-emit(observation),fat-put-doc(docs,list(head(doc),nth(doc,1),after))),docs);
   };
  };
 }
 0;
}
