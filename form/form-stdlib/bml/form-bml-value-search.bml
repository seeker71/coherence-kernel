// Bounded one-edit search. Wrap a bare value expression with a unary call
// already used in this source. The caller owns admission, execution and cost
// of checker(contract, source) -> [0|1, observation]. No IO or model calls.
// Result: [status, source, attempts, reason]. Each attempt is
// [start-byte, end-byte, wrapper, passed, observation, source-sha256].
// A passing original is unchanged; exhaustion/refusal preserves the original.
// preludes: form-stdlib/bml/form-bml-boolean-repair.bml form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/hearth.bml
section [form.bml] {
 class FormBmlValueSearch {
  def fbvs-limit() = hearth-code-value-search-check-limit();
  def fbvs-has(xs,x) = nil?(xs) ? 0 : (((String) head(xs) == x) || fbvs-has(tail(xs),x));
  def fbvs-name(t) = (Comparable) str_len(t) == 0 ? 0 : {
   let c = str_byte_at(t,0);
   (((c >= 65) && (c <= 90)) || (((c >= 97) && (c <= 122)) || ((Comparable) c == 95))) && (fsc-bml-expression-name?(t) && ((str_find(t,".",0) < 0) && ((str_find(t,":",0) < 0) && (!fbvs-has(list("if","then","else","def","fn","let","do","end","class","section","true","false","nothing"),t)))));
  };
  def fbvs-group-end(ts,i,stop) = i >= len(ts) ? i : (String) fbr-at(ts,i) == stop ? (i + 1) : !((String) fbr-closer(fbr-at(ts,i)) == "") ? fbvs-group-end(ts,fbvs-group-end(ts,i + 1,fbr-closer(fbr-at(ts,i))),stop) : fbvs-group-end(ts,i + 1,stop);
  def fbvs-arity(ts,i,count,value) = i >= len(ts) ? -1 : (String) fbr-at(ts,i) == ")" ? (count + value) : (String) fbr-at(ts,i) == "," ? fbvs-arity(ts,i + 1,count + 1,0) : !((String) fbr-closer(fbr-at(ts,i)) == "") ? fbvs-arity(ts,fbvs-group-end(ts,i + 1,fbr-closer(fbr-at(ts,i))),count,1) : fbvs-arity(ts,i + 1,count,1);
  def fbvs-value-site(ts,i) = fbvs-name(fbr-at(ts,i)) && (fbvs-has(list("then","else","=","{",";"),(Comparable) i == 0 ? "" : fbr-at(ts,i - 1)) && fbvs-has(list("else",";", ")","}"),fbr-at(ts,i + 1)));
  def fbvs-unary(ts,i) = fbvs-name(fbr-at(ts,i)) && (((String) fbr-at(ts,i + 1) == "(") && ((!fbvs-has(list("def","fn",".","::"),(Comparable) i == 0 ? "" : fbr-at(ts,i - 1))) && ((Comparable) fbvs-arity(ts,i + 2,0,0) == 1)));
  def fbvs-scan(ts,i,depth,active,sites,wrappers) = i >= len(ts) ? list(reverse(sites),reverse(wrappers)) : {
   let token = fbr-at(ts,i);
   ((Comparable) depth == 0) && ((String) token == "section") ? fbvs-scan(ts,i + 5,1,(String) fbr-at(ts,i + 2) == "form.bml",sites,wrappers) : {
    let nextSites = active && fbvs-value-site(ts,i) ? cons(ts[i],sites) : sites;
    let nextWrappers = active && (fbvs-unary(ts,i) && (!fbvs-has(wrappers,token))) ? cons(token,wrappers) : wrappers;
    let nextDepth = !((String) fbr-closer(token) == "") ? (depth + 1) : fbr-closing(token) ? (depth - 1) : depth;
    fbvs-scan(ts,i + 1,nextDepth,(Comparable) nextDepth == 0 ? 0 : active,nextSites,nextWrappers);
   };
  };
  def fbvs-shape(r) = !((String) value_kind(r) == "list") ? 0 : !((Comparable) len(r) == 2) ? 0 : ((((Value) head(r) == 0) || ((Value) head(r) == 1)) && ((String) value_kind(r[1]) == "string"));
  def fbvs-result(status,source,attempts,reason) = list(status,source,reverse(attempts),reason);
  def fbvs-malformed() = "caller-checker-returned-malformed-result";
  def fbvs-row(start,end,wrapper,result,source) = list(start,end,wrapper,head(result),result[1],hex-encode(sha256-stream-string(source)));
  def fbvs-wrap(source,site,wrapper) = substring(source,0,site[1]) ++ wrapper ++ "(" ++ substring(source,site[1],site[2]) ++ ")" ++ substring(source,site[2],str_len(source));
  def fbvs-search(source,checker,contract,budget) = !(((String) value_kind(budget) == "int") && ((budget > 0) && (budget <= fbvs-limit()))) ? fbvs-result("refused",source,list(),"check-budget-must-be-integer-in-range") : {
   let syntax = fbr-repair(source);
   !head(syntax) ? fbvs-result("refused",source,list(),syntax[3]) : !nil?(syntax[2]) ? fbvs-result("refused",source,list(),"boolean-syntax-repair-required") : {
    let prepared = fbvs-scan(fbr-lex(source,0,list())[1],0,0,0,list(),list());
    let checked = checker(contract,source);
    let attempts = list(fbvs-row(0,0,"",fbvs-shape(checked) ? checked : list(0,fbvs-malformed()),source));
    !fbvs-shape(checked) ? fbvs-result("refused",source,attempts,fbvs-malformed()) : {
     head(checked) ? fbvs-result("unchanged",source,attempts,checked[1]) : fbvs-next(source,checker,contract,budget,head(prepared),prepared[1],prepared[1],attempts);
    };
   };
  };
  def fbvs-next(source,checker,contract,budget,sites,wrappers,remaining,attempts) = len(attempts) >= budget ? fbvs-result("exhausted",source,attempts,"check-budget-exhausted") : nil?(sites) ? fbvs-result("exhausted",source,attempts,"no-passing-single-value-wrapper") : nil?(remaining) ? fbvs-next(source,checker,contract,budget,tail(sites),wrappers,wrappers,attempts) : {
   let site = head(sites); let wrapper = head(remaining);
   let candidate = fbvs-wrap(source,site,wrapper);
   let checked = checker(contract,candidate);
   let next = cons(fbvs-row(site[1],site[2],wrapper,fbvs-shape(checked) ? checked : list(0,fbvs-malformed()),candidate),attempts);
   !fbvs-shape(checked) ? fbvs-result("refused",source,next,fbvs-malformed()) : {
    head(checked) ? fbvs-result("repaired",candidate,next,checked[1]) : fbvs-next(source,checker,contract,budget,sites,wrappers,tail(remaining),next);
   };
  };
 }
 0;
}
