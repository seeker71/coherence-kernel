// A finite one-edit frontier: add an existing unary call to a bare value,
// or remove a unary call around its original argument. The caller owns admission, execution and cost
// of checker(contract, source) -> [0|1, observation]. No IO or model calls.
// Result: [status, source, attempts, reason]. Each attempt is
// [start-byte, end-byte, wrapper, passed, observation, source-sha256].
// A passing original is unchanged; exhaustion/refusal preserves the original.
// A rung-0 candidate turns one number, and a number reads only what its band reads, so what an edit moved is read from the two
// texts as well: fbvs-moved-def(before,after) names the definition it stands in ("" outside any), and fbvs-kind-why(before,after) answers
// "" or "kind-moved: ..." when the edit leaves a kind the body knows where another stood. The kinds are data (fbvs-kinds): a call's argument
// kinds and its answer's, "nodes" a list of nodes. A call with a known position answers to that position; a removed call with none answers to
// its own answer kind. A string where a JSON node belongs stops json-emit and reads "" through the wire doors, and a band can read full over it.
// A call the kinds do not know, at a position whose kind they do, leaves there what the body cannot read ("kind-unread"): a local wrapper hides the same string its door would.
import form-stdlib/bml/form-bml-boolean-repair.bml;
import form-stdlib/sha256.fk;
import form-stdlib/hex.fk;
import form-stdlib/hearth.bml;
section [form.bml] {
 class FormBmlValueSearch {
  def fbvs-limit() = hearth-code-value-search-check-limit();
  def fbvs-has(xs,x) = any?((item: String) => item == x,xs);
  def fbvs-name(t) = if ((Comparable) len(t) == 0) then 0 else {
   let c = str_byte_at(t,0);
   ((((c >= 65) && (c <= 90)) || (((c >= 97) && (c <= 122)) || ((Comparable) c == 95))) && (fsc-bml-expression-name?(t) && ((str_find(t,".",0) < 0) && ((str_find(t,":",0) < 0) && (!fbvs-has(["if","then","else","def","fn","let","do","end","class","section","true","false","nothing"],t))))));
  };
  def fbvs-group-end(ts,i,stop) = if (i >= len(ts)) then i else if ((String) fbr-at(ts,i) == stop) then (i + 1) else if (!((String) fbr-closer(fbr-at(ts,i)) == "")) then fbvs-group-end(ts,fbvs-group-end(ts,(i + 1),fbr-closer(fbr-at(ts,i))),stop) else fbvs-group-end(ts,(i + 1),stop);
  def fbvs-arity(ts,i,count,value) = if (i >= len(ts)) then -1 else if ((String) fbr-at(ts,i) == ")") then (count + value) else if ((String) fbr-at(ts,i) == ",") then fbvs-arity(ts,(i + 1),(count + 1),0) else if (!((String) fbr-closer(fbr-at(ts,i)) == "")) then fbvs-arity(ts,fbvs-group-end(ts,(i + 1),fbr-closer(fbr-at(ts,i))),count,1) else fbvs-arity(ts,(i + 1),count,1);
  def fbvs-value-site(ts,i) = (fbvs-name(fbr-at(ts,i)) && (fbvs-has(["then","else","=","{",";"],if ((Comparable) i == 0) then "" else fbr-at(ts,(i - 1))) && fbvs-has(["else",";", ")","}"],fbr-at(ts,(i + 1)))));
  def fbvs-unary(ts,i) = (fbvs-name(fbr-at(ts,i)) && (((String) fbr-at(ts,(i + 1)) == "(") && ((!fbvs-has(["def","fn",".","::"],if ((Comparable) i == 0) then "" else fbr-at(ts,(i - 1)))) && ((Comparable) fbvs-arity(ts,(i + 2),0,0) == 1))));
  def fbvs-scan(ts,i,depth,active,sites,wrappers) = if (i >= len(ts)) then [reverse(sites),reverse(wrappers)] else {
   let token = fbr-at(ts,i);
   if (((Comparable) depth == 0) && ((String) token == "section")) then fbvs-scan(ts,(i + 5),1,((String) fbr-at(ts,(i + 2)) == "form.bml"),sites,wrappers) else {
    let nextSites = if (active && fbvs-value-site(ts,i)) then cons(ts[i],sites) else sites;
    let nextWrappers = if (active && (fbvs-unary(ts,i) && (!fbvs-has(wrappers,token)))) then cons(token,wrappers) else wrappers;
    let nextDepth = if (!((String) fbr-closer(token) == "")) then (depth + 1) else if fbr-closing(token) then (depth - 1) else depth;
    fbvs-scan(ts,(i + 1),nextDepth,if ((Comparable) nextDepth == 0) then 0 else active,nextSites,nextWrappers);
   };
  };
  def fbvs-shape(r) = if (!((String) value_kind(r) == "list")) then 0 else if (!((Comparable) len(r) == 2)) then 0 else ((((Value) r[0] == 0) || ((Value) r[0] == 1)) && ((String) value_kind(r[1]) == "string"));
  def fbvs-result(status,source,attempts,reason) = [status,source,reverse(attempts),reason];
  def fbvs-malformed() = "caller-checker-returned-malformed-result";
  def fbvs-row(start,end,wrapper,result,source) = [start,end,wrapper,result[0],result[1],hex-encode(sha256-stream-string(source))];
  def fbvs-wrap(source,site,wrapper) = (substring(source,0,site[1]) + (wrapper + ("(" + (substring(source,site[1],site[2]) + (")" + substring(source,site[2],len(source)))))));
  def fbvs-search(source,checker,contract,budget) = if (!(nothing?(budget) || value_kind(budget)=="int" && budget>0)) then fbvs-result("refused",source,[],"check-budget-must-be-positive-native-integer") else {
   let syntax = fbr-repair(source);
   if (!syntax[0]) then fbvs-result("refused",source,[],syntax[3]) else if (!nil?(syntax[2])) then fbvs-result("refused",source,[],"boolean-syntax-repair-required") else {
    let prepared = fbvs-scan(fbr-lex(source,0,[])[1],0,0,0,[],[]);
    let checked = checker(contract,source);
    let attempts = [fbvs-row(0,0,"",if fbvs-shape(checked) then checked else [0,fbvs-malformed()],source)];
    if (!fbvs-shape(checked)) then fbvs-result("refused",source,attempts,fbvs-malformed()) else {
     if checked[0] then fbvs-result("unchanged",source,attempts,checked[1]) else fbvs-next(source,checker,contract,budget,prepared[0],prepared[1],prepared[1],attempts);
    };
   };
  };
  def fbvs-next(source,checker,contract,budget,sites,wrappers,remaining,attempts) = if (!nothing?(budget) && len(attempts) >= budget) then fbvs-result("exhausted",source,attempts,"check-budget-exhausted") else if nil?(sites) then fbvs-unwrappers(source,checker,contract,budget,fbr-lex(source,0,[])[1],0,attempts) else if nil?(remaining) then fbvs-next(source,checker,contract,budget,sites[1:],wrappers,wrappers,attempts) else {
   let site = sites[0]; let wrapper = remaining[0];
   let candidate = fbvs-wrap(source,site,wrapper);
   let checked = checker(contract,candidate);
   let next = cons(fbvs-row(site[1],site[2],wrapper,if fbvs-shape(checked) then checked else [0,fbvs-malformed()],candidate),attempts);
   if (!fbvs-shape(checked)) then fbvs-result("refused",source,next,fbvs-malformed()) else {
    if checked[0] then fbvs-result("repaired",candidate,next,checked[1]) else fbvs-next(source,checker,contract,budget,sites,wrappers,remaining[1:],next);
   };
  };
  def fbvs-unwrappers(source,checker,contract,budget,tokens,index,attempts) {
   let spent=!nothing?(budget) && len(attempts)>=budget;
   let result=foldl((held,at)=>{
    !nothing?(held[0]) || !fbvs-unary(tokens,at) ? held : {
     let end=fbvs-group-end(tokens,at+2,")");
     let candidate=substring(source,0,tokens[at][1])+substring(source,tokens[at+2][1],tokens[end - 1][1])+substring(source,tokens[end - 1][2],len(source));
     let checked=checker(contract,candidate);
     let next=cons(fbvs-row(tokens[at][1],tokens[end - 1][2],"remove:"+fbr-at(tokens,at),fbvs-shape(checked) ? checked : [0,fbvs-malformed()],candidate),held[2]);
     !fbvs-shape(checked) ? ["refused",source,next,fbvs-malformed()] : checked[0] ? ["repaired",candidate,next,checked[1]] : !nothing?(budget) && len(next)>=budget ? ["exhausted",source,next,"check-budget-exhausted"] : [nothing(),source,next,""];
    };
   },[spent ? "exhausted" : nothing(),source,attempts,spent ? "check-budget-exhausted" : ""],index .. len(tokens));
   fbvs-result(nothing?(result[0]) ? "exhausted" : result[0],result[1],result[2],nothing?(result[0]) ? "no-passing-single-value-rewrite" : result[3]);
  }
  def fbvs-first-diff(a,b,i) = if ((i >= len(a)) || (i >= len(b))) then i else if (!((Comparable) str_byte_at(a,i) == str_byte_at(b,i))) then i else fbvs-first-diff(a,b,(i + 1));
  def fbvs-near(ts,byte,i,found) = if ((i >= len(ts)) || ((Comparable) ts[i][1] > byte)) then found else fbvs-near(ts,byte,(i + 1),i);
  def fbvs-def-from(ts,i) = if (i < 0) then "" else if ((String) fbr-at(ts,i) == "def") then fbr-at(ts,(i + 1)) else fbvs-def-from(ts,(i - 1));
  def fbvs-moved-def(before,after) {
   let ts = fbr-lex(before,0,[])[1];
   fbvs-def-from(ts,fbvs-near(ts,fbvs-first-diff(before,after,0),0,-1));
  }
  def fbvs-kinds() = [["json-node-string",["string"],"node"],["json-node-nullable-string",["string"],"node"],["json-node-float-text",["string"],"node"],["json-node-int",["int"],"node"],["json-node-bool",["bool"],"node"],["json-node-array",["nodes"],"node"],["json-node-object",["nodes"],"node"],["json-node-pair",["string","node"],"node"],["fhn-s",["string","string"],"node"],["fhn-n",["string","int"],"node"],["nsm-s",["string","string"],"node"],["nsm-n",["string","int"],"node"],["fct-pair",["string","string"],"node"],["json-string-value",["node"],"string"],["json-int-value",["node"],"int"],["json-array-elements",["node"],"nodes"],["json-object-pairs",["node"],"nodes"],["json-object-get",["node","string"],"node"]];
  def fbvs-kinds-of(name) = filter(row => (String) row[0] == name,fbvs-kinds());
  def fbvs-argument-kind(name,n) {
   let rows = fbvs-kinds-of(name);
   if (nil?(rows) || (n >= len(rows[0][1]))) then "" else rows[0][1][n];
  }
  def fbvs-around(ts,i,depth,commas) = if (i < 0) then [-1,0] else if fbr-closing(fbr-at(ts,i)) then fbvs-around(ts,(i - 1),(depth + 1),commas) else if (!((String) fbr-closer(fbr-at(ts,i)) == "")) then (if ((Comparable) depth == 0) then [i,commas] else fbvs-around(ts,(i - 1),(depth - 1),commas)) else fbvs-around(ts,(i - 1),depth,if (((Comparable) depth == 0) && ((String) fbr-at(ts,i) == ",")) then (commas + 1) else commas);
  def fbvs-wants(ts,at) {
   let open = fbvs-around(ts,(at - 1),0,0);
   if (open[0] < 1) then "" else if ((String) fbr-at(ts,open[0]) == "(") then fbvs-argument-kind(fbr-at(ts,(open[0] - 1)),open[1]) else if ((String) fbr-at(ts,open[0]) == "[") then (if ((String) fbvs-wants(ts,open[0]) == "nodes") then "node" else "") else "";
  }
  def fbvs-literal-kind(t) {
   let b = str_byte_at(t,0);
   if (((Comparable) b == 34) || ((Comparable) b == 39)) then "string" else if (((Comparable) b >= 48) && ((Comparable) b <= 57)) then "int" else "";
  }
  def fbvs-expression-kind(ts,from,to) {
   let rows = fbvs-kinds-of(fbr-at(ts,from));
   if ((to - from) == 1) then fbvs-literal-kind(fbr-at(ts,from)) else if (nil?(rows) || (!((String) fbr-at(ts,(from + 1)) == "(")) || (!((Comparable) fbvs-group-end(ts,(from + 2),")") == to))) then "" else rows[0][2];
  }
  def fbvs-kind-read(ts,at,shorter) {
   let name = fbr-at(ts,at);
   let rows = fbvs-kinds-of(name);
   let inner = fbvs-expression-kind(ts,(at + 2),(fbvs-group-end(ts,(at + 2),")") - 1));
   let wants = fbvs-wants(ts,at);
   let have = if shorter then (if (!((String) inner == "")) then inner else if nil?(rows) then "" else rows[0][1][0]) else (if nil?(rows) then "" else rows[0][2]);
   let need = if (!((String) wants == "")) then wants else if (shorter && (!nil?(rows))) then rows[0][2] else "";
   if (((String) need == "") || ((String) have == need)) then "" else if ((String) have == "") then ("kind-unread: " + (if shorter then "removing " else "wrapping in ") + name + " leaves no kind the body can read where " + need + " stood") else ("kind-moved: " + (if shorter then "removing " else "wrapping in ") + name + " leaves " + have + " where " + need + " stood");
  }
  def fbvs-kind-why(before,after) {
   let shorter = len(after) < len(before);
   let ts = fbr-lex(shorter ? before : after,0,[])[1];
   let near = fbvs-near(ts,fbvs-first-diff(before,after,0),0,-1);
   let at = ((String) fbr-at(ts,near) == "(") ? (near - 1) : near;
   if ((at < 0) || (!((String) fbr-at(ts,(at + 1)) == "(")) || (!fbvs-name(fbr-at(ts,at)))) then "" else fbvs-kind-read(ts,at,shorter);
  }
 }
 0;
}
