// form-rows-bridge.bml — the one place a JSON node and a Form value meet.
//
// The organ-health library (organ-health.bml, json-view.bml) and the session-learning documents still hold their readings as JSON
// nodes: Form nodes of the JSON categories, built with json-node-object / json-node-pair and read with json-object-get. Their
// readings travel into Form's own rows (form-rows.bml) and out of them through these two functions, so a door that writes an event
// or reads a ledger never touches JSON text, and the day those libraries hold Form records this file is deleted and the calls to it
// with it.
//   frb-of-node(node)    a JSON node as a Form value: object -> record (keys in order), array -> list, string, int, float,
//                        true/false -> 1/0, null -> nothing
//   frb-to-node(value)   a Form value as a JSON node: record -> object, list -> array, nothing -> null, a float keeps its bits
// preflight-exec: forbidden
import form-stdlib/bml/form-rows.bml;
import form-stdlib/json.fk;
import form-stdlib/json-precise.bml;
section [form.bml] {
 class FormRowsBridge {
  def frb-of-node(n) {
   if node_eq(node_category(n), JSON-OBJECT()) then frb-of-object(n)
   else if node_eq(node_category(n), JSON-ARRAY()) then map(x => frb-of-node(x), json-array-elements(n))
   else if node_eq(node_category(n), JSON-NULL()) then nothing()
   else frb-of-leaf(n, node_type(n));
  }
  def frb-of-object(n) = foldl((rec, p) => record_set(rec, json-pair-key(p), frb-of-node(json-pair-value(p))), record_new(0), json-object-pairs(n));
  def frb-of-leaf(n, t) = (Comparable) t == 2 ? node_value(n) : (Comparable) t == 1 ? node_value(n) : (Comparable) t == 7 ? frb-float(node_value(n)) : (Comparable) t == 3 ? (node_value(n) ? 1 : 0) : nothing();
  def frb-float(v) = (String) value_kind(v) == "float" ? v : v + 0.0;
  // a ledger row: the text a writer appends for a node it built (one line, a newline after it), and the nodes a reader takes
  // back from a rows file (none when the file is absent or refused at some line: a ledger that does not read whole is not read)
  def frb-row-text(node) = frw-emit(frb-of-node(node)) ++ "\n";
  def frb-nodes-of(path) = frb-nodes-from(frw-rows(read_file(path) ?? ""));
  def frb-nodes-from(r) = (String) r[0] == "ok" ? map(v => frb-to-node(v), r[1]) : [];
  def frb-to-node(v) = frb-to-node-kind(v, (String) value_kind(v));
  def frb-to-node-kind(v, k) = k == "int" ? json-node-int(v) : k == "float" ? json-precise-float(v) : k == "string" ? json-node-string(v) : k == "null" ? json-node-null() : k == "list" ? json-node-array(map(x => frb-to-node(x), v)) : k == "record" ? json-node-object(map(key => json-node-pair(key, frb-to-node(record_get(v, key))), record_keys(v))) : form_error("form-rows-bridge: a value of kind " ++ k ++ " has no JSON node");
 }
 0;
}
