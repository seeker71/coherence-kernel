//////////////////////////////////////////////////////////////////////
//
// form-terminal-canvas.bml — surface-neutral terminal canvas authority.
//
// The canvas is Form data first.  ANSI is one projection, never the
// storage shape.  Terminal capabilities which the carrier cannot observe
// remain named seams rather than inferred facts.
//
// Executable: form-stdlib/form-terminal-canvas.bml
// Proven by: form-stdlib/tests/form-terminal-canvas-band.fk
//
//////////////////////////////////////////////////////////////////////

package Form.surface.terminalcanvas;

import Form.kernel.*;

interface IFormTerminalCanvas [public, witness, reusable, surface-neutral] {
   section [public] {
      const String Schema = "form-terminal-canvas-v1";
      const String CellRule = "a rectangular canvas is rows of cells; every cell carries one glyph and a semantic style";
      const String StyleRule = "concept and RGB are semantic while alpha carries age; symbols preserve meaning when colour is absent";
      const String CompositionRule = "clip, horizontal composition, vertical composition, and overlay operate on canvas data before projection";
      const String DiffRule = "frame differences are deterministic row-major changed cells, including style-only changes";
      const String MeasureRule = "minimum and maximum cell widths are resolved before region allocation";
      const String SegmentRule = "contiguous styled text is a semantic segment carrying node id, channels, control, and evidence";
      const String OverflowRule = "crop, ellipsis, fold, and hidden-count are explicit policies; hidden telemetry is never silently discarded";
      const String CadenceRule = "active compute, host health, and storage catalogs refresh at distinct evidence-appropriate cadences";
      const String ProjectionRule = "ANSI true-colour is one projection of the surface tree; the tree itself contains no escape sequences";
      const String TransparencySeam = "terminals expose no portable alpha channel; ANSI projection maps alpha to normal or dim while retaining exact alpha in Form data";
      const String SizeSeam = "the current native carrier exposes no terminal-size primitive; callers provide dimensions and may label them observed or fallback";
      const String InputSeam = "read_line is available but raw key, mouse, resize event, and nonblocking input carriers are not yet exposed";
      const String WidthSeam = "the current Form string cursor is byte-oriented; incremental cursor placement is proven for one-column ASCII and full-frame rendering is used for wider symbols";

      Object Canvas( Int width, Int height, Object blankStyle ) [abstract];
      Object ComposeHorizontal( Object left, Object right ) [abstract];
      Object ComposeVertical( Object top, Object bottom ) [abstract];
      Object Clip( Object canvas, Int x, Int y, Int width, Int height ) [abstract];
      Object Diff( Object previous, Object next ) [abstract];
      Object Measure( Object renderable, Int availableWidth ) [abstract];
      Object AllocateMeasuredSplit( Int availableWidth, Int height, Int gap, Object leftMeasurement, Object rightMeasurement ) [abstract];
      Object Segments( Object renderable, Object region ) [abstract];
      String ProjectAnsi( Object surface ) [abstract];
   }
}

class FormTerminalCanvas [public, resident, observable, teach] : IFormTerminalCanvas {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-terminal-canvas.bml";
      const String TerminalProjection = "ANSI-24bit-v1";
      const String NeutralProjection = "Form-canvas-tree-v1";
      const String CarrierFloor = "print_str can emit ANSI and read_line can accept submitted lines; screen size, raw events, and terminal alpha remain outside the current carrier";

      Object Canvas( Int width, Int height, Object blankStyle ) [abstract] {}
      Object ComposeHorizontal( Object left, Object right ) [abstract] {}
      Object ComposeVertical( Object top, Object bottom ) [abstract] {}
      Object Clip( Object canvas, Int x, Int y, Int width, Int height ) [abstract] {}
      Object Diff( Object previous, Object next ) [abstract] {}
      String ProjectAnsi( Object surface ) [abstract] {}
   }
}
