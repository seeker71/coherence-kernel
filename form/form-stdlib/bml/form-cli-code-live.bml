   if fs-exists?(path) then fcac-unused-reply-path(base,add(index,1)) else path;
  }
  def fcac-retained-reply(path,raw,written) = if and(fs-exists?(path),str_eq(read_file(path),raw)) then path else "";
  // Feedback prefill may outlive the caller. Retain the completed action first;
  // the next loop saves any subsequently admitted context references as well.
  // Terminal state still settles model release before its final checkpoint.
  def fcac-advance(session,next,checker,turns,started) = if fcap-done(next) then fcac-finish(session,next,started) else if not(fcam-save(next)) then fcac-finish(session,fcap-terminal(next,"checkpoint-write-refused;candidate-retained"),started) else if ge(fcap-turns(next),turns) then fcac-loop(session,next,checker,turns,started) else fcac-observed(session,fcacs-observe-profile(session,fcac-observation-budget(next,turns),fcac-reasoning?(next)),next,checker,turns,started);
  def fcac-observed(before,after,next,checker,turns,started) {
   let admitted = fcap-observation-admitted(next,fcms-observations(before),fcms-observations(after),fcms-live?(after));
   // fcms-observe-ids checks capacity before touching KV. Only that branch may
   // retain the live owner; a failed/partial prefill keeps its refused owner.
   if and(fcms-live?(before),and(not(fcms-live?(after)),str_eq(fcms-reason(after),"coding-observation-context-capacity"))) then fcac-capacity-stop(before,admitted,fcms-reason(after),started)
   else fcac-loop(after,admitted,checker,turns,started);
  }
  def fcac-decode(session, state, started, stops, ids) = fcac-decoded(fcacs-quantum(session, stops, fcac-decode-width(state,session,len(ids))), state, started, stops, ids);
  def fcac-decoded(generation, state, started, stops, before) {
   let session = fcms-generation-session(generation);
   let ids = append(before, fcms-generation-ids(generation));
   let observed = fcac-observe(state, session, started);
   if or(fcac-reply-exhausted(state,len(ids)),or(fcms-stopped?(session), ge(fcms-pos(session), sub(fcms-maxpos(session), 1)))) then fcms-generation(tkz-decode-text(fcms-src(session), ids), ids, session) else fcac-decode(fcacs-next(session, stops), state, started, stops, ids);
  }
 }
 0;
}
