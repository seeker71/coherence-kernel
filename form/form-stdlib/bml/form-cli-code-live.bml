section [form.bml] {
 class FormCliCodeLive {
  field CodeProgressQuantum = 4;
  def fcac-retained(state) = if fcam-managed(state) then ";checkpoint-retained" else ";candidate-retained-in-result";
  def fcac-sample(s, session, started) = fcac-metric(s, "tools", fcap-calls(s), started);
  def fcac-metric(s, lane, value, started) = fgtm-sample(str_concat(str_concat("code.", int_to_str(host_pid())), str_concat(".", lane)), fgtm-absent(), "metric", "form", "qwen.coding", lane, fcap-stage(s), fgtm-absent(), fgtm-present(value), if fcap-done(s) then if str_eq(fcap-stage(s), "complete") then "ready" else "unknown" else "active", fgtm-present(started), fgtm-present(now_unix_ms()), fgtm-absent(), fgtm-absent(), "pinned", "physical-live", "form-cli-code", list("qwen", "coding", "native", fcap-stage(s)));
  def fcac-observe(s, session, started) {
   let publish = fgtm-publish-snapshot(hearth-telemetry-root(), str_concat("qwen.coding.", int_to_str(host_pid())), now_unix_ms(), list(fcac-sample(s, session, started), fcac-metric(s, "generated-ids", fcms-generated-ids(session), started), fcac-metric(s, "repairs", fcap-failures(s), started), fcac-metric(s, "checks", fcap-checks(s), started), fcac-metric(s, "lessons-recalled", fcam-hits(s), started)));
   let frame = fb_record(intern_trivial_int(fcap-turns(s)), "form-cli-code-live.bml", fcap-calls(s));
   print_str(str_concat("form-code ", json-emit(json-node-object(list(json-node-pair("mode", json-node-string(fcap-mode(s))), json-node-pair("stage", json-node-string(fcap-stage(s))), json-node-pair("turns", json-node-int(fcap-turns(s))), json-node-pair("tool_calls", json-node-int(fcap-calls(s))), json-node-pair("repairs", json-node-int(fcap-failures(s))), json-node-pair("checks", json-node-int(fcap-checks(s))), json-node-pair("generated_ids", json-node-int(fcms-generated-ids(session))), json-node-pair("injected_ids", json-node-int(fcms-injected-ids(session))), json-node-pair("position", json-node-int(fcms-pos(session))), json-node-pair("elapsed_ms", json-node-int(sub(now_unix_ms(), started))))))));
   print_str("\n");
  }
  def fcac-open(model, state, context) = fcms-open-with-profile(mr-path(mr-find(model)), fcap-bootstrap(state), context, "knowledge-query");
  def fcac-replies-left(state,turns) = fat-max(0,sub(turns,fcap-turns(state)));
  def fcac-budget(state,turns) = json-node-object(list(json-node-pair("limit",json-node-int(turns)),json-node-pair("completed",json-node-int(fcap-turns(state))),json-node-pair("remaining",json-node-int(fcac-replies-left(state,turns)))));
  def fcac-budget-instruction(state,turns) = str_concat("Every generated reply counts, including tool reads. Source observations already supplied remain available. ",if eq(fcac-replies-left(state,turns),1) then "This is the final allowed reply. Submit the requested deliverable from the supported evidence, retaining unresolved findings honestly. A further tool read leaves no reply for the deliverable. All caller checks still apply." else "Plan inspection and the requested deliverable within the remaining replies. All caller checks still apply.");
  def fcac-token-budget-pairs(state) = if le(fcap-reply-token-limit(state),0) then list() else list(json-node-pair("max_reply_tokens",json-node-int(fcap-reply-token-limit(state))),json-node-pair("token_budget_instruction",json-node-string("Each generated reply has this token ceiling, including reasoning when enabled. Finish the JSON and end the reply within it. A partial reply is retained as evidence and never acts. All original goals, sources and checks remain in force.")));
  def fcac-budget-pairs(state,turns) = append(list(json-node-pair("reply_budget",fcac-budget(state,turns)),json-node-pair("budget_instruction",json-node-string(fcac-budget-instruction(state,turns)))),fcac-token-budget-pairs(state));
  def fcac-token-allowance(state,available) = if le(fcap-reply-token-limit(state),0) then available else fat-min(available,fcap-reply-token-limit(state));
  def fcac-reply-exhausted(state,count) = and(gt(fcap-reply-token-limit(state),0),ge(count,fcap-reply-token-limit(state)));
  // The pending prediction is the first ID; this is the decode-width boundary.
  def fcac-reply-room(session) = fat-max(0,sub(fcms-maxpos(session),fcms-pos(session)));
  def fcac-reasoning?(state) = gt(head(fcap-reasoning(state)),0);
  def fcac-profile(state) = if fcac-reasoning?(state) then "knowledge-query-reasoning" else "knowledge-query";
  def fcac-reply-fits(session,state) = if fcac-reasoning?(state) then frbg-reserve-fits(session,fcac-token-allowance(state,head(fcap-reasoning(state))),fcac-token-allowance(state,nth(fcap-reasoning(state),1))) else or(le(fcap-reply-token-limit(state),0),ge(fcac-reply-room(session),fcap-reply-token-limit(state)));
  def fcac-decode-width(state,session,count) = fat-max(0,fat-min(CodeProgressQuantum(),fat-min(sub(fcms-maxpos(session),fcms-pos(session)),if le(fcap-reply-token-limit(state),0) then CodeProgressQuantum() else sub(fcap-reply-token-limit(state),count))));
  def fcac-bootstrap-budget(state,turns) = str_concat(fcap-bootstrap(state),str_concat("\nCALLER REPLY BUDGET: ",json-emit(json-node-object(fcac-budget-pairs(state,turns)))));
  def fcac-observation-budget(state,turns) = json-emit(json-node-object(append(json-object-pairs(parse-json("observation",fcap-observation(state))),fcac-budget-pairs(state,turns))));
  def fcac-open-budget(model,state,context,turns) = fcms-open-with-profile(mr-path(mr-find(model)),fcac-bootstrap-budget(state,turns),context,fcac-profile(state));
  def fcac-model-ready(model) {
   let row = mr-find(model);
   if str_eq(mr-path(row), "") then 0 else if not(fat-starts(model, "qwen")) then 0 else if not(and(mr-file?(mr-path(row)), and(mr-side?(mr-path(row), mr-suffix-seal()), and(mr-side?(mr-path(row), mr-suffix-tokfast()), mr-side?(mr-path(row), mr-suffix-crystal()))))) then 0 else mr-wired?(mr-arch(row));
  }
  // checker = [native callback, caller contract]. The callback receives that
  // contract and candidate documents, returning [passed, actual observation].
  def fcac-run(model, goal, docs, writable, checker, context, turns) = if not(and(fat-docs-valid(docs, list()), and(gt(str_len(goal), 0), and(gt(context, 0), gt(turns, 0))))) then list(fcap-terminal(fcap-open(goal, docs, writable), "invalid-caller-contract"), 1, 0, 0, 0) else fcac-admit(model, fcap-open(goal, docs, writable), checker, context, turns);
  // Fresh, unmanaged review: no recalled answers, checkpoint writes or LoRA.
  // checker is [report callback, contract, optional source callback, contract].
  def fcac-review(model, goal, docs, checker, context, turns) = if not(and(fat-docs-valid(docs, list()), and(gt(str_len(goal), 0), and(gt(context, 0), gt(turns, 0))))) then list(fcap-terminal(fcap-open-review(goal, docs), "invalid-caller-contract"), 1, 0, 0, 0) else fcac-admit(model, fcap-open-review(goal, docs), checker, context, turns);
  def fcac-admit(model, state, checker, context, turns) = if fcap-done(state) then list(state, 1, 0, 0, 0) else if not(fcac-model-ready(model)) then list(fcap-terminal(state, "native-qwen-artifact-seal-tokenizer-or-lane-unavailable"), 1, 0, 0, 0) else fcac-open-timed(model, state, checker, context, turns, now_unix_ms());
  def fcac-open-timed(model, state, checker, context, turns, started) = fcac-open-context(model,fcap-begin-context(state),checker,context,turns,started);
  def fcac-open-context(model,state,checker,context,turns,started) = fcac-resident(fcac-open-budget(model,state,context,turns),state,checker,turns,started);
  def fcac-resident(session,state,checker,turns,started) = fcac-finish-contexts(fcac-loop(session,state,checker,turns,started),checker,turns,started,fcap-turns(state),list(0,0,0),1);
  // A complete action survives an observation that cannot fit. Partial model
  // replies, failed prefills, failed admission and exhausted reply budgets do
  // not select renewal. At least one completed reply bounds each residence.
  def fcac-capacity-stop(session,state,reason,started) = append(fcac-finish(session,fcap-terminal(state,reason),started),list(state));
  def fcac-renewable(result,firstTurn,turns) = if not(eq(len(result),3)) then 0 else {
   let session = head(result); let state = nth(result,2);
   let capacity = or(fat-has(list("coding-observation-context-capacity","coding-reply-context-capacity"),fcap-note(nth(result,1))),ge(fcms-pos(session),sub(fcms-maxpos(session),1)));
   and(fcms-live?(session),and(capacity,and(not(fcap-done(state)),and(gt(fcap-turns(state),firstTurn),lt(fcap-turns(state),turns)))));
  };
  def fcac-context-cost(session,prior) = list(add(head(prior),fcms-generated-ids(session)),add(nth(prior,1),fcms-injected-ids(session)),add(nth(prior,2),fcms-observations(session)));
  def fcac-total-result(result,prior) = list(head(result),nth(result,1),add(nth(result,2),head(prior)),add(nth(result,3),nth(prior,1)),add(nth(result,4),nth(prior,2)));
  def fcac-context-reading(state,number,live) {
   let detail = json-node-object(list(oh-n("context_number",number),oh-n("completed_replies",fcap-turns(state)),oh-s("scope","model context availability; source quality remains caller-checked")));
   oh-reading("native-coding",if fcam-managed(state) then fcam-id(state) else str_concat("code.",int_to_str(host_pid())),"model-context",json-node-int(1),json-node-int(live),json-node-int(live),if live then list() else list(oh-need("model-context-capacity",detail)),list("renew-context"),detail);
  }
  def fcac-renew-release-complete(reason) = not(fat-has(list("old-stream-release-incomplete","candidate-stream-release-incomplete"),reason));
  def fcac-finish-contexts(result,checker,turns,started,firstTurn,prior,number) = if not(fcac-renewable(result,firstTurn,turns)) then fcac-total-result(fcac-settle(result,started),prior) else {
   let session = head(result); let state = nth(result,2);
   let reading = fcac-context-reading(state,number,0);
   oh-voice(reading); oh-voice(oh-response(reading,"renew-context"));
   let next = fcap-begin-context(state);
   let renewed = fcmr-replace-with-profile(session,fcac-bootstrap-budget(next,turns),fcac-profile(next));
   // Renewal returns the sole current owner, including on partial failure.
   // The old session is used below only for its retained cost counters.
