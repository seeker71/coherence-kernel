  // Each changed page is a new choice checked by the real prompt tokenizer.
  // An irreducible envelope or non-capacity failure retains its distinct owner.
  def fcac-renew(session,state,turns) = fcac-renew-with(session,state,turns,fcmr-replace-with-profile-checked);
  def fcac-renew-with(session,state,turns,renewer) {
   let next = fcap-begin-context(state);
   let first = renewer(session,fcac-bootstrap-budget(next,turns),fcac-profile(next),fcac-renewal-fits,[next,turns]);
   fcac-renew-focused(first,next,state,turns,renewer,len(fcap-note(state)),1,"");
  }
  def fcac-renew-focused(result,next,original,turns,renewer,bytes,attempts,evidence) = !fcac-room-refused?(result) || nothing?(fcap-observation-result(original)) || bytes <= 1 ? [result,next,attempts] : {
   let smaller=max2(1,bytes / 2);
