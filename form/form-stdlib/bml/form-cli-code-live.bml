   let noticeEvidence = if gt(str_len(frbg-notice(bounded)),0) then fcac-retain-reply(frbg-notice(bounded)) else "";
   let selected = fcac-reasoned-answer(bounded);
   print_str(str_concat("form-code-reasoning-reserve ",json-emit(json-node-object(list(fcap-shape-n("reply",add(fcap-turns(state),1)),fcap-shape-n("requested_initial_tokens",initial),fcap-shape-n("requested_answer_tokens",answer),fcap-shape-n("effective_initial_tokens",initialLimit),fcap-shape-n("effective_answer_tokens",answerLimit),fcap-shape-n("initial_generated_ids",len(fcms-generation-ids(first))),fcap-shape-n("final_generated_ids",len(fcms-generation-ids(final))),fcap-shape-n("observation_prefill_ids",fcms-injected-ids(next)),fcap-shape-s("answer_origin",frbg-origin(bounded)),fcap-shape-n("completion_observed",head(selected)),fcap-shape-s("generation_reason",frbg-reason(bounded)),fcap-shape-s("private_initial_evidence",firstEvidence),fcap-shape-s("private_final_evidence",finalEvidence),fcap-shape-s("private_controller_evidence",noticeEvidence))))));
