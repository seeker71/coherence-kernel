  def fcac-retain-reply(raw) {
   let root = hearth-code-replies();
   let parent = fs-mkdir(fs-path-dirname(root));
   let made = fs-mkdir(root);
   let base = str_concat(root,str_concat("/",str_concat(int_to_str(host_pid()),str_concat("-",int_to_str(now_unix_ms())))));
   let path = fcac-unused-reply-path(base,0);
