  };
  def fcac-retain-reply(raw) {
   let root = hearth-code-replies();
   let parent = fs-mkdir(fs-path-dirname(root));
   let made = fs-mkdir(root);
   let base = root ++ "/" ++ int_to_str(host_pid()) ++ "-" ++ int_to_str(now_unix_ms());
   let path = fcac-unused-reply-path(base,0);
   fcac-retained-reply(path,raw,write_file(path,raw));
  }
  def fcac-unused-reply-path(base,index) {
   let path = base ++ ((Comparable) index == 0 ? "" : "-" ++ int_to_str(index)) ++ ".txt";
   fs-exists?(path) ? fcac-unused-reply-path(base,index + 1) : path;
  }
  def fcac-retained-reply(path,raw,written) = fs-exists?(path) && ((String) read_file(path) == raw) ? path : "";
  // Feedback prefill may outlive the caller. Retain the completed action first;
  // the next loop saves any subsequently admitted context references as well.
  // Terminal state still settles model release before its final checkpoint.
  def fcac-advance(session,next,checker,turns,started) = fcap-done(next) ? fcac-finish(session,next,started) : !fcam-save(next) ? fcac-finish(session,fcap-terminal(next,"checkpoint-write-refused;candidate-retained"),started) : fcap-turns(next) >= turns ? fcac-loop(session,next,checker,turns,started) : fcac-observed(session,fcacs-observe-profile(session,fcac-observation-budget(next,turns),fcac-reasoning?(next)),next,checker,turns,started);
  def fcac-observed(before,after,next,checker,turns,started) {
   let admitted = fcap-observation-admitted(next,fcms-observations(before),fcms-observations(after),fcms-live?(after));
   // fcms-observe-ids checks capacity before touching KV. Only that branch may
   // retain the live owner; a failed/partial prefill keeps its refused owner.
   fcms-live?(before) && ((!fcms-live?(after)) && ((String) fcms-reason(after) == "coding-observation-context-capacity")) ? fcac-capacity-stop(before,admitted,fcms-reason(after),started)
   : fcac-loop(after,admitted,checker,turns,started);
  }
  def fcac-decode(session, state, started, stops, ids) = fcac-decoded(fcacs-quantum(session, stops, fcac-decode-width(state,session,len(ids))), state, started, stops, ids);
  def fcac-decoded(generation, state, started, stops, before) {
   let session = fcms-generation-session(generation);
   let ids = append(before, fcms-generation-ids(generation));
   let observed = fcac-observe(state, session, started);
   fcac-reply-exhausted(state,len(ids)) || (fcms-stopped?(session) || (fcms-pos(session) >= (fcms-maxpos(session) - 1))) ? fcms-generation(tkz-decode-text(fcms-src(session), ids), ids, session) : fcac-decode(fcacs-next(session, stops), state, started, stops, ids);
  }
 }
 0;
}
