   (String) mr-path(row) == "" ? 0 : !fat-starts(model, "qwen") ? 0 : !(mr-file?(mr-path(row)) && (mr-side?(mr-path(row), mr-suffix-seal()) && (mr-side?(mr-path(row), mr-suffix-tokfast()) && mr-side?(mr-path(row), mr-suffix-crystal())))) ? 0 : mr-wired?(mr-arch(row));
