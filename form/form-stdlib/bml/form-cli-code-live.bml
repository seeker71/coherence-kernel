  def fcac-incomplete-reason(state,count,evidence,fallback) = if not(fcac-reply-exhausted(state,count)) then fallback else if str_eq(evidence,"") then "reply-token-budget-reached;partial-reply-retention-failed;no-action" else "reply-token-budget-reached;partial-reply-retained;no-action";
  def fcac-replied(session,state,raw,checker,turns,started) {
