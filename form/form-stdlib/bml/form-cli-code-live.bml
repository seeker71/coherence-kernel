   let spent = if changed then fcac-context-cost(session,prior) else prior;
   let evidence = json-node-object(list(oh-n("renewed",good),oh-n("owner_replaced",changed),oh-s("reason",reason),oh-s("trigger",fcap-note(nth(result,1))),oh-n("remaining_positions",fcac-reply-room(session)),oh-n("max_reply_tokens",fcap-reply-token-limit(state)),oh-n("weight_admissions",0),oh-n("completed_contexts",number),oh-n("context_prompt_ids",fcms-prompt-ids(session)),oh-n("generated_ids",if changed then head(spent) else add(head(prior),fcms-generated-ids(session))),oh-n("injected_ids",if changed then nth(spent,1) else add(nth(prior,1),fcms-injected-ids(session)))));
   oh-voice(oh-applied(reading,"renew-context",evidence));
   print_str(str_concat("form-code-context ",json-emit(evidence)));
