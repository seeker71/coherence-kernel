  def fcac-reasoned-answer(result) = if (!frbg-complete(result)) then [0,"",("reasoning-reserve-" + (frbg-reason(result) + ";candidate-retained"))] else if (!frbg-stopped(frbg-session(result)) && nil?(fcac-control-submissions())) then [0,"","reasoning-reserve-stream-not-stopped;candidate-retained"] else [1,fat-trim(frbg-answer(result)),""];
  // Initial-only and continuing reasoning share generation, privacy, action
