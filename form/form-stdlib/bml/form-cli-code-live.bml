  def fcac-reply-fits(session,state) = fcac-reasoning?(state) ? frbg-reserve-fits(session,fcac-token-allowance(state,head(fcap-reasoning(state))),fcac-token-allowance(state,fcap-reasoning(state)[1])) : ((fcap-reply-token-limit(state) <= 0) || (fcac-reply-room(session) >= fcap-reply-token-limit(state)));
