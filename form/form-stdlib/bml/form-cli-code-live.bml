section [form.bml] {
 class FormCliCodeLive {
  field CodeProgressQuantum = 4;
  def fcac-retained(state) = fcam-managed(state) ? ";checkpoint-retained" : ";candidate-retained-in-result";
  def fcac-sample(s, session, started) = fcac-metric(s, "tools", fcap-calls(s), started);
  def fcac-metric(s, lane, value, started) = fgtm-sample(("code." ++ int_to_str(host_pid())) ++ "." ++ lane, fgtm-absent(), "metric", "form", "qwen.coding", lane, fcap-stage(s), fgtm-absent(), fgtm-present(value), fcap-done(s) ? ((String) fcap-stage(s) == "complete" ? "ready" : "unknown") : "active", fgtm-present(started), fgtm-present(now_unix_ms()), fgtm-absent(), fgtm-absent(), "pinned", "physical-live", "form-cli-code", list("qwen", "coding", "native", fcap-stage(s)));
