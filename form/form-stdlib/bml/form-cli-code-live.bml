// Native Qwen coding with owned stream renewal after completed work.
// No process, HTTP, Ollama or rented fallback is invoked by this module.
// A lane that already holds memory gives it back when the machine runs low: at each turn boundary (fcac-loop) a low
// reading saves the checkpoint and ends the lane with the reason host-memory-low (fcac-memory-stop).
// The sealed tokenizer establishes observation capacity before KV changes. Growth
// speaks through organ health; it does not reject a result that fits. A refused
// source observation retains exact evidence and selects progressively smaller
// pages until one fits or its fixed envelope needs a renewed context.
import form-stdlib/bml/form-cli-code-memory.bml;
import form-stdlib/bml/form-cli-code-session.bml;
import form-stdlib/bml/form-cli-code-swerve.bml;
import form-stdlib/bml/form-cli-model-renew.bml;
import form-stdlib/bml/form-cli-reasoning-budget.bml;
import form-stdlib/form-glass-telemetry-membrane.bml;
import form-stdlib/hearth.bml;
import form-stdlib/organ-health.bml;
import form-stdlib/bml/form-token-grammar.bml;
import form-stdlib/bml/memory-governor.bml;
section [form.bml] {
 class FormCliCodeLive {
  field CodeProgressQuantum = 4;
  def fcac-retained(state) = if fcam-managed(state) then ";checkpoint-retained" else ";candidate-retained-in-result";
  def fcac-sample(s, session, started) = fcac-metric(s, "tools", fcap-calls(s), started);
  def fcac-metric(s, lane, value, started) = fgtm-sample((("code." + host_pid().str()) + ("." + lane)), fgtm-absent(), "metric", "form", "qwen.coding", lane, fcap-stage(s), fgtm-absent(), fgtm-present(value), if fcap-done(s) then if ((String) fcap-stage(s) == "complete") then "ready" else "unknown" else "active", fgtm-present(started), fgtm-present(now_unix_ms()), fgtm-absent(), fgtm-absent(), "pinned", "physical-live", "form-cli-code", ["qwen", "coding", "native", fcap-stage(s)]);
  def fcac-observe(s, session, started) {
   let publish = fgtm-publish-snapshot(hearth-telemetry-root(), ("qwen.coding." + host_pid().str()), now_unix_ms(), [fcac-sample(s, session, started), fcac-metric(s, "generated-ids", fcms-generated-ids(session), started), fcac-metric(s, "repairs", fcap-failures(s), started), fcac-metric(s, "checks", fcap-checks(s), started), fcac-metric(s, "lessons-recalled", fcam-hits(s), started)]);
   let frame = fb_record(intern_trivial_int(fcap-turns(s)), "form-cli-code-live.bml", fcap-calls(s));
   print_str(("form-code " + json-emit(json-node-object(append([json-node-pair("mode", json-node-string(fcap-mode(s))), json-node-pair("stage", json-node-string(fcap-stage(s))), json-node-pair("turns", json-node-int(fcap-turns(s))), json-node-pair("tool_calls", json-node-int(fcap-calls(s))), json-node-pair("repairs", json-node-int(fcap-failures(s))), json-node-pair("checks", json-node-int(fcap-checks(s))), json-node-pair("generated_ids", json-node-int(fcms-generated-ids(session))), json-node-pair("injected_ids", json-node-int(fcms-injected-ids(session))), json-node-pair("position", json-node-int(fcms-pos(session))), json-node-pair("elapsed_ms", json-node-int((now_unix_ms() - started)))],fcsw-telemetry-pairs(s))))));
   print_str("\n");
  }
  def fcac-open(model, state, context) = fcms-open-with-profile(mr-path(mr-find(model)), fcap-bootstrap(state), context, "knowledge-query");
  def fcac-replies-left(state,turns) = fat-max(0,(turns - fcap-turns(state)));
  def fcac-budget(state,turns) = json-node-object([json-node-pair("limit",json-node-int(turns)),json-node-pair("completed",json-node-int(fcap-turns(state))),json-node-pair("remaining",json-node-int(fcac-replies-left(state,turns)))]);
  def fcac-finish-minimum(state) = if fcap-done(state) then 0 else if ((String) fcap-stage(state) == "review") then 1 else if ((String) fcap-stage(state) == "implement") then (len(state[5]) + 1) else if ((String) fcap-stage(state) == "repair") then if fcap-reviewing(state) then 1 else (len(state[5]) + 2) else if ((String) fcap-stage(state) == "split") then 3 else if ((String) fcap-stage(state) == "plan") then if ((Value) state[5] == [fcap-direct-task()]) then 3 else 4 else 5;
  def fcac-coding-finish-instruction() = "Coding completion requires task=done for each implemented pending task, then a separate review verdict with findings. Closing the last task automatically runs caller checks before review; acceptance checks again. Once implementation is finished, task=done reaches those checks directly; a separate verify is optional diagnostic work. Keep a reply for review. A passing check alone does not complete the original goal.";
  def fcac-budget-instruction(state,turns) = ("Every generated reply counts, including tool reads. Source observations already supplied remain available. " + (if (!fcap-reviewing(state)) then fcsw-coding-instruction(state,fcac-replies-left(state,turns),fcac-finish-minimum(state),fcac-coding-finish-instruction()) else if ((Comparable) fcac-replies-left(state,turns) == 1) then "This is the final allowed reply. Submit the requested deliverable from the supported evidence, retaining unresolved findings honestly. A further tool read leaves no reply for the deliverable. All caller checks still apply." else "Plan inspection and the requested deliverable within the remaining replies. All caller checks still apply."));
  def fcac-token-budget-pairs(state) = if (fcap-reply-token-limit(state) <= 0) then [] else [json-node-pair("max_reply_tokens",json-node-int(fcap-reply-token-limit(state))),json-node-pair("token_budget_instruction",json-node-string("Each generated reply has this token ceiling, including reasoning when enabled. Finish the native node submission within it. A partial reply is retained as evidence and never acts. All original goals, sources and checks remain in force."))];
  def fcac-budget-pairs(state,turns) = append([json-node-pair("reply_budget",fcac-budget(state,turns)),json-node-pair("completion_replies_minimum",json-node-int(fcac-finish-minimum(state))),json-node-pair("completion_budget_scope",json-node-string("Protocol lower bound from the current phase; unfinished edits, reads, failed checks and rejected reviews can require more replies. The caller's limit is unchanged.")),json-node-pair("budget_instruction",json-node-string(fcac-budget-instruction(state,turns)))],fcac-token-budget-pairs(state));
  def fcac-token-allowance(state,available) = if (fcap-reply-token-limit(state) <= 0) then available else fat-min(available,fcap-reply-token-limit(state));
  def fcac-reply-exhausted(state,count) = ((fcap-reply-token-limit(state) > 0) && (count >= fcap-reply-token-limit(state)));
  // The pending prediction is the first ID; this is the decode-width boundary.
  def fcac-reply-room(session) = fat-max(0,(fcms-maxpos(session) - fcms-pos(session)));
  def fcac-reasoning?(state) = (fcap-reasoning(state)[0] > 0);
  def fcac-profile(state) = if fcac-reasoning?(state) then "knowledge-query-reasoning" else "knowledge-query";
  // A reply ceiling bounds consumption; it does not reserve unused positions.
  // Explicit reasoning/answer stages retain their requested reservation.
  def fcac-reply-fits(session,state) = if fcac-reasoning?(state) then frbg-reserve-fits(session,fcac-token-allowance(state,fcap-reasoning(state)[0]),fcac-token-allowance(state,fcap-reasoning(state)[1])) else fcac-reply-room(session)>=2;
  def fcac-decode-width(state,session,count) = fat-max(0,fat-min(CodeProgressQuantum(),fat-min((fcms-maxpos(session) - fcms-pos(session)),if (fcap-reply-token-limit(state) <= 0) then CodeProgressQuantum() else (fcap-reply-token-limit(state) - count))));
  def fcac-bootstrap-budget(state,turns) = fcap-bootstrap(state) + "\nCALLER REPLY BUDGET: " + fcap-model-packet(json-node-object(fcac-budget-pairs(state,turns)));
  def fcac-observation-budget(state,turns) = fcap-model-packet(json-node-object(append(json-object-pairs(fcap-observation-node(state)),fcac-budget-pairs(state,turns))));
  // The final-stage request carries current work and full failed-check evidence.
  // A reference to an earlier observation must not replace the active correction.
  def fcac-current-reply-fits(session,state,turns) = if (!fcac-reply-fits(session,state)) then 0 else if (!fcac-reasoning?(state)) then 1 else frbg-task-reserve-fits(session,fcac-token-allowance(state,fcap-reasoning(state)[0]),fcac-token-allowance(state,fcap-reasoning(state)[1]),fcac-observation-budget(state,turns));
  def fcac-open-budget(model,state,context,turns) = fcacs-open-staged(mr-path(mr-find(model)),fcac-bootstrap-budget(state,turns),context,fcac-profile(state));
  def fcac-model-ready(model) {
   let row = mr-find(model);
   if ((String) mr-path(row) == "") then 0 else if (!fat-starts(model, "qwen")) then 0 else if (!(mr-file?(mr-path(row)) && (mr-side?(mr-path(row), mr-suffix-seal()) && (mr-side?(mr-path(row), mr-suffix-tokfast()) && mr-side?(mr-path(row), mr-suffix-crystal()))))) then 0 else mr-wired?(mr-arch(row));
  }
  // checker = [native callback, caller contract]. The callback receives that
