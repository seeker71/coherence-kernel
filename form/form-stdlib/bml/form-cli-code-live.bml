  }
  def fcac-reasoned-answer(result) = if not(frbg-complete(result)) then list(0,"",str_concat("reasoning-reserve-",str_concat(frbg-reason(result),";candidate-retained"))) else if not(frbg-stopped(frbg-session(result))) then list(0,"","reasoning-reserve-stream-not-stopped;candidate-retained") else list(1,fat-trim(frbg-answer(result)),"");
  // Initial-only and continuing reasoning share generation, privacy, action
  // admission and accounting. Each stage retains the caller's token ceiling.
  def fcac-reasoned(session,state,checker,turns,initial,answer,started) {
   let initialLimit = fcac-token-allowance(state,initial);
   let answerLimit = fcac-token-allowance(state,answer);
   let original = frbg-generate(session,initialLimit,answerLimit);
   let prefixEvidence = if fcjc-needed(original,answerLimit) then fcac-retain-reply(frbg-answer(original)) else "";
   if str_eq(prefixEvidence,"") then 0 else print_str(str_concat("form-code-json-prefix ",json-emit(json-node-object(list(fcap-shape-s("reply_evidence",prefixEvidence),fcap-shape-n("generated_ids",len(fcms-generation-ids(frbg-final(original)))),fcap-shape-n("stop_id",fcms-pending(frbg-session(original))))))));
   let completed = fcjc-complete(original,answerLimit);
   let bounded = head(completed);
