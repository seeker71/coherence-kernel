  def fcac-run(model, goal, docs, writable, checker, context, turns) = if (!(fat-docs-valid(docs, []) && ((len(goal) > 0) && ((context > 0) && (turns > 0))))) then [fcap-terminal(fcap-open(goal, docs, writable), "invalid-caller-contract"), 1, 0, 0, 0] else fcac-admit(model, fcap-open(goal, docs, writable), checker, context, turns);
  // Fresh, unmanaged review: no recalled answers, checkpoint writes or LoRA.
  // checker is [report callback, contract, optional source callback, contract].
  def fcac-review(model, goal, docs, checker, context, turns) = if (!(fat-docs-valid(docs, []) && ((len(goal) > 0) && ((context > 0) && (turns > 0))))) then [fcap-terminal(fcap-open-review(goal, docs), "invalid-caller-contract"), 1, 0, 0, 0] else fcac-admit(model, fcap-open-review(goal, docs), checker, context, turns);
  def fcac-admit(model, state, checker, context, turns) = if fcap-done(state) then [state, 1, 0, 0, 0] else if (!fcac-model-ready(model)) then [fcap-terminal(state, "native-qwen-artifact-seal-tokenizer-or-lane-unavailable"), 1, 0, 0, 0] else fcac-open-timed(model, state, checker, context, turns, now_unix_ms());
  def fcac-open-timed(model, state, checker, context, turns, started) = fcac-open-context(model,fcap-begin-context(fcac-held-state(state,context)),checker,context,turns,started);
  def fcac-open-context(model,state,checker,context,turns,started) = fcac-resident(fcac-open-budget(model,state,context,turns),state,checker,turns,started);
  def fcac-resident(session,state,checker,turns,started) = fcac-finish-contexts(fcac-loop(session,state,checker,turns,started),checker,turns,started,fcap-turns(state),[0,0,0],1);
  // Completed actions and retained no-action attempts survive a full context.
  // Each renewal needs a counted reply and remaining caller allowance. Failed
  // admission, prediction, retention and partial prefill retain their owner.
  def fcac-capacity-stop(session,state,reason,started) = append(fcac-finish(session,fcap-terminal(state,reason),started),[state]);
  def fcac-renewable(result,firstTurn,turns) = if (!((Comparable) len(result) == 3)) then 0 else {
   let session = result[0]; let state = result[2];
   let capacity = (fat-has(["coding-observation-context-capacity","coding-reply-context-capacity"],fcap-note(result[1])) || (fcms-pos(session) >= (fcms-maxpos(session) - 1)));
   (fcms-live?(session) && (capacity && ((!fcap-done(state)) && ((fcap-turns(state) > firstTurn) && (fcap-turns(state) < turns)))));
  };
  def fcac-context-cost(session,prior) = [(prior[0] + fcms-generated-ids(session)),(prior[1] + fcms-injected-ids(session)),(prior[2] + fcms-observations(session))];
  def fcac-total-result(result,prior) = [result[0],result[1],(result[2] + prior[0]),(result[3] + prior[1]),(result[4] + prior[2])];
  def fcac-context-reading(state,number,live) {
   let detail = json-node-object([oh-n("context_number",number),oh-n("counted_replies",fcap-turns(state)),oh-s("scope","model context availability; source quality remains caller-checked")]);
   oh-reading("native-coding",if fcam-managed(state) then fcam-id(state) else ("code." + host_pid().str()),"model-context",json-node-int(1),json-node-int(live),json-node-int(live),if live then [] else [oh-need("model-context-capacity",detail)],["renew-context"],detail);
  }
  def fcac-renew-release-complete(reason) = (!fat-has(["old-stream-release-incomplete","candidate-stream-release-incomplete"],reason));
  // The decoder needs its pending prediction and one advance. Other reservation
  // comes from explicit reasoning stages, never a reply ceiling or window fraction.
  def fcac-renewal-fits(session,promptIds,contract) = promptIds < fcms-maxpos(session) - 1 && fcac-current-reply-fits(fcms-with-stream(session,promptIds,0,0,0,0,0),contract[0],contract[1]);
  def fcac-renewal-ending(reason) = ("native-context-renewal-" + reason);
  // the two refusals a bounded trigger can cure: no room for the reply and next observation (prompt-caller-capacity-refused),
