  }
  def fcac-open(model, state, context) = fcms-open-with-profile(mr-path(mr-find(model)), fcap-bootstrap(state), context, "knowledge-query");
  def fcac-replies-left(state,turns) = fat-max(0,turns - fcap-turns(state));
  def fcac-budget(state,turns) = json-node-object(list(json-node-pair("limit",json-node-int(turns)),json-node-pair("completed",json-node-int(fcap-turns(state))),json-node-pair("remaining",json-node-int(fcac-replies-left(state,turns)))));
  def fcac-finish-minimum(state) = fcap-done(state) ? 0 : (String) fcap-stage(state) == "review" ? 1 : (String) fcap-stage(state) == "implement" ? (len(state[5]) + 1) : (String) fcap-stage(state) == "repair" ? (fcap-reviewing(state) ? 1 : (len(state[5]) + 2)) : (String) fcap-stage(state) == "split" ? 3 : (String) fcap-stage(state) == "plan" ? ((Value) state[5] == list(fcap-direct-task()) ? 3 : 4) : 5;
  def fcac-coding-finish-instruction() = "Coding completion requires task=done for each implemented pending task, then a separate review verdict with findings. Closing the last task automatically runs caller checks before review; acceptance checks again. Once implementation is finished, task=done reaches those checks directly; a separate verify is optional diagnostic work. Keep a reply for review. A passing check alone does not complete the original goal.";
  def fcac-budget-instruction(state,turns) = "Every generated reply counts, including tool reads. Source observations already supplied remain available. " ++ (!fcap-reviewing(state) ? fcac-coding-finish-instruction() : (Comparable) fcac-replies-left(state,turns) == 1 ? "This is the final allowed reply. Submit the requested deliverable from the supported evidence, retaining unresolved findings honestly. A further tool read leaves no reply for the deliverable. All caller checks still apply." : "Plan inspection and the requested deliverable within the remaining replies. All caller checks still apply.");
  def fcac-token-budget-pairs(state) = fcap-reply-token-limit(state) <= 0 ? list() : list(json-node-pair("max_reply_tokens",json-node-int(fcap-reply-token-limit(state))),json-node-pair("token_budget_instruction",json-node-string("Each generated reply has this token ceiling, including reasoning when enabled. Finish the JSON and end the reply within it. A partial reply is retained as evidence and never acts. All original goals, sources and checks remain in force.")));
  def fcac-budget-pairs(state,turns) = append(list(json-node-pair("reply_budget",fcac-budget(state,turns)),json-node-pair("completion_replies_minimum",json-node-int(fcac-finish-minimum(state))),json-node-pair("completion_budget_scope",json-node-string("Protocol lower bound from the current phase; unfinished edits, reads, failed checks and rejected reviews can require more replies. The caller's limit is unchanged.")),json-node-pair("budget_instruction",json-node-string(fcac-budget-instruction(state,turns)))),fcac-token-budget-pairs(state));
