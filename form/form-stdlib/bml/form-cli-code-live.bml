  def fcac-finish-contexts(result,checker,turns,started,firstTurn,prior,number) = fcac-finish-contexts-with(result,checker,turns,started,firstTurn,prior,number,fcac-loop,fcac-renew);
  def fcac-finish-contexts-with(result,checker,turns,started,firstTurn,prior,number,loop,renew) = if (!fcac-renewable(result,firstTurn,turns)) then fcac-total-result(fcac-settle(result,started),prior) else {
   let session = result[0]; let state = result[2];
