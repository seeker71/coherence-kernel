  def fcac-loop-with(session, state, checker, turns, started, sense) = ((!fcap-done(state)) && (fcap-turns(state) < turns) && fcac-memory-low?(sense)) ? fcac-memory-stop(session, state, started) : fcac-loop-turn(session, state, checker, turns, started);
  def fcac-memory-stop(session, state, started) {
