// One natural-language catalog shared by the native tongue and its observer.
// Names are prompt/display vocabulary, not a translation-quality claim.
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk
section [form.bml] {
    class TranscriptLanguages {
        def tln-rows() = list(list("en", "English", 50259), list("pt", "Portuguese", 50267), list("fa", "Persian", 50300), list("id", "Indonesian", 50275), list("de", "German", 50261), list("fr", "French", 50265), list("zh", "Chinese", 50260), list("es", "Spanish", 50262), list("ru", "Russian", 50263), list("it", "Italian", 50274), list("ja", "Japanese", 50266), list("ko", "Korean", 50264), list("ar", "Arabic", 50272), list("hi", "Hindi", 50276), list("tr", "Turkish", 50268), list("nl", "Dutch", 50271), list("pl", "Polish", 50269), list("ro", "Romanian", 50284), list("sv", "Swedish", 50273), list("uk", "Ukrainian", 50280), list("vi", "Vietnamese", 50278), list("th", "Thai", 50289), list("he", "Hebrew", 50279), list("el", "Greek", 50281), list("cs", "Czech", 50283), list("hu", "Hungarian", 50286), list("ms", "Malay", 50282), list("tl", "Tagalog", 50348), list("bn", "Bengali", 50302), list("ta", "Tamil", 50287), list("ur", "Urdu", 50290), list("sw", "Swahili", 50318));
        def tln-defaults() = take(4, tln-rows());
        def tln-name-in(rows, code) = if eq(len(rows), 0) then "" else if str_eq(head(head(rows)), code) then nth(head(rows), 1) else tln-name-in(tail(rows), code);
        def tln-name(code) = tln-name-in(tln-rows(), code);
        def tln-known?(code) = gt(str_len(tln-name(code)), 0);
        def tln-label(code) = if eq(tln-known?(code), 1) then tln-name(code) else code;
        def tln-member?(xs, x) = if eq(len(xs), 0) then 0 else if str_eq(head(xs), x) then 1 else tln-member?(tail(xs), x);
        def tln-valid-codes?(codes) = if eq(len(codes), 0) then 0 else if eq(tln-known?(head(codes)), 0) then 0 else if eq(len(codes), 1) then 1 else tln-valid-codes?(tail(codes));
        def tln-valid-selection?(s) = if or(str_eq(s, "all"), str_eq(s, "none")) then 1 else tln-valid-codes?(split-on(s, "+"));
        def tln-selected?(s, code) = if str_eq(s, "all") then 1 else tln-member?(split-on(s, "+"), code);
        def tln-keys(rows) = if eq(len(rows), 0) then list() else cons(head(head(rows)), tln-keys(tail(rows)));
        def tln-join(keys) = if eq(len(keys), 0) then "none" else if eq(len(keys), 1) then head(keys) else str_concat(head(keys), str_concat("+", tln-join(tail(keys))));
        def tln-selected-rows(rows, s) = if eq(len(rows), 0) then list() else if eq(tln-selected?(s, head(head(rows))), 1) then cons(head(rows), tln-selected-rows(tail(rows), s)) else tln-selected-rows(tail(rows), s);
        def tln-toggle-keys(rows, s, code) = if eq(len(rows), 0) then list() else if not(eq(tln-selected?(s, head(head(rows))), str_eq(code, head(head(rows))))) then cons(head(head(rows)), tln-toggle-keys(tail(rows), s, code)) else tln-toggle-keys(tail(rows), s, code);
        def tln-toggle(s, code) = if eq(tln-known?(code), 0) then s else tln-join(tln-toggle-keys(tln-rows(), s, code));

        // The token whisper wears for this tongue when it says which one it heard. It lives in the
        // SAME row as the name because the ear kept its own shortlist and the two drifted: the ear
        // listened for three (en, fa, pt) under a comment reading "the three the glass offers", while
        // the glass offered four — and the missing one was Indonesian, in a house that speaks it
        // (corpus row 1416 heardshort). One row, one truth; ear-heard-tongues-band holds them equal.
        // The order is whisper's own LANGUAGES order, 50259 + the tongue's index; every code here
        // falls at offset 0..89, inside the 99 logits the ear reads.
        def tln-heard-tok-in(rows, code) = if eq(len(rows), 0) then sub(0, 1) else if str_eq(head(head(rows)), code) then nth(head(rows), 2) else tln-heard-tok-in(tail(rows), code);
        def tln-heard-tok(code) = tln-heard-tok-in(tln-rows(), code);
        def tln-heard-toks(codes) = if eq(len(codes), 0) then list() else tln-heard-toks-cons(tln-heard-tok(head(codes)), tln-heard-toks(tail(codes)));
        def tln-heard-toks-cons(t, rest) = if lt(t, 0) then rest else cons(t, rest);
        def tln-default-toks() = tln-heard-toks(tln-keys(tln-defaults()));
    }
    0;
}
