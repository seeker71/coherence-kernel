// One natural-language catalog shared by the native tongue and its observer.
// Names are prompt/display vocabulary, not a translation-quality claim.
// preludes: form/form-stdlib/core.fk
section [form.bml] {
    class TranscriptLanguages {
        def tln-rows() = list(list("en", "English"), list("pt", "Portuguese"), list("fa", "Persian"), list("id", "Indonesian"), list("de", "German"), list("fr", "French"), list("zh", "Chinese"), list("es", "Spanish"), list("ru", "Russian"), list("it", "Italian"), list("ja", "Japanese"), list("ko", "Korean"), list("ar", "Arabic"), list("hi", "Hindi"), list("tr", "Turkish"), list("nl", "Dutch"), list("pl", "Polish"), list("ro", "Romanian"), list("sv", "Swedish"), list("uk", "Ukrainian"), list("vi", "Vietnamese"), list("th", "Thai"), list("he", "Hebrew"), list("el", "Greek"), list("cs", "Czech"), list("hu", "Hungarian"), list("ms", "Malay"), list("tl", "Tagalog"), list("bn", "Bengali"), list("ta", "Tamil"), list("ur", "Urdu"), list("sw", "Swahili"));
        def tln-defaults() = take(4, tln-rows());
        def tln-name-in(rows, code) = if eq(len(rows), 0) then "" else if str_eq(head(head(rows)), code) then nth(head(rows), 1) else tln-name-in(tail(rows), code);
        def tln-name(code) = tln-name-in(tln-rows(), code);
        def tln-known?(code) = gt(str_len(tln-name(code)), 0);
        def tln-label(code) = if eq(tln-known?(code), 1) then tln-name(code) else code;
        def tln-member?(xs, x) = if eq(len(xs), 0) then 0 else if str_eq(head(xs), x) then 1 else tln-member?(tail(xs), x);
        def tln-valid-codes?(codes) = if eq(len(codes), 0) then 0 else if eq(tln-known?(head(codes)), 0) then 0 else if eq(len(codes), 1) then 1 else tln-valid-codes?(tail(codes));
        def tln-valid-selection?(s) = if or(str_eq(s, "all"), str_eq(s, "none")) then 1 else tln-valid-codes?(split-on(s, "+"));
        def tln-selected?(s, code) = if str_eq(s, "all") then 1 else tln-member?(split-on(s, "+"), code);
        def tln-keys(rows) = if eq(len(rows), 0) then list() else cons(head(head(rows)), tln-keys(tail(rows)));
        def tln-join(keys) = if eq(len(keys), 0) then "none" else if eq(len(keys), 1) then head(keys) else str_concat(head(keys), str_concat("+", tln-join(tail(keys))));
        def tln-selected-rows(rows, s) = if eq(len(rows), 0) then list() else if eq(tln-selected?(s, head(head(rows))), 1) then cons(head(rows), tln-selected-rows(tail(rows), s)) else tln-selected-rows(tail(rows), s);
        def tln-toggle-keys(rows, s, code) = if eq(len(rows), 0) then list() else if not(eq(tln-selected?(s, head(head(rows))), str_eq(code, head(head(rows))))) then cons(head(head(rows)), tln-toggle-keys(tail(rows), s, code)) else tln-toggle-keys(tail(rows), s, code);
        def tln-toggle(s, code) = if eq(tln-known?(code), 0) then s else tln-join(tln-toggle-keys(tln-rows(), s, code));
    }
    0;
}
