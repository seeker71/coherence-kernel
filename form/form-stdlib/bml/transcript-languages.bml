// One natural-language catalog shared by the native tongue and its observer.
// Names are prompt/display vocabulary, not a translation-quality claim.
// preludes: form/form-stdlib/core.fk form/form-stdlib/line-grammar.fk
section [form.bml] {
    class TranscriptLanguages {
        def tln-rows() = [["en", "English", 50259], ["pt", "Portuguese", 50267], ["fa", "Persian", 50300], ["id", "Indonesian", 50275], ["de", "German", 50261], ["fr", "French", 50265], ["zh", "Chinese", 50260], ["es", "Spanish", 50262], ["ru", "Russian", 50263], ["it", "Italian", 50274], ["ja", "Japanese", 50266], ["ko", "Korean", 50264], ["ar", "Arabic", 50272], ["hi", "Hindi", 50276], ["tr", "Turkish", 50268], ["nl", "Dutch", 50271], ["pl", "Polish", 50269], ["ro", "Romanian", 50284], ["sv", "Swedish", 50273], ["uk", "Ukrainian", 50280], ["vi", "Vietnamese", 50278], ["th", "Thai", 50289], ["he", "Hebrew", 50279], ["el", "Greek", 50281], ["cs", "Czech", 50283], ["hu", "Hungarian", 50286], ["ms", "Malay", 50282], ["tl", "Tagalog", 50348], ["bn", "Bengali", 50302], ["ta", "Tamil", 50287], ["ur", "Urdu", 50290], ["sw", "Swahili", 50318]];
        def tln-defaults() = take(4, tln-rows());
        def tln-name-in(rows, code) = if ((Comparable) len(rows) == 0) then "" else if ((String) head(head(rows)) == code) then head(rows)[1] else tln-name-in(tail(rows), code);
        def tln-name(code) = tln-name-in(tln-rows(), code);
        def tln-known?(code) = (str_len(tln-name(code)) > 0);
        def tln-label(code) = if ((Comparable) tln-known?(code) == 1) then tln-name(code) else code;
        def tln-member?(xs, x) = if ((Comparable) len(xs) == 0) then 0 else if ((String) head(xs) == x) then 1 else tln-member?(tail(xs), x);
        def tln-valid-codes?(codes) = if ((Comparable) len(codes) == 0) then 0 else if ((Comparable) tln-known?(head(codes)) == 0) then 0 else if ((Comparable) len(codes) == 1) then 1 else tln-valid-codes?(tail(codes));
        def tln-valid-selection?(s) = if (((String) s == "all") || ((String) s == "none")) then 1 else tln-valid-codes?(split-on(s, "+"));
        def tln-selected?(s, code) = if ((String) s == "all") then 1 else tln-member?(split-on(s, "+"), code);
        def tln-keys(rows) = if ((Comparable) len(rows) == 0) then [] else cons(head(head(rows)), tln-keys(tail(rows)));
        def tln-join(keys) = if ((Comparable) len(keys) == 0) then "none" else if ((Comparable) len(keys) == 1) then head(keys) else str_concat(head(keys), str_concat("+", tln-join(tail(keys))));
        def tln-selected-rows(rows, s) = if ((Comparable) len(rows) == 0) then [] else if ((Comparable) tln-selected?(s, head(head(rows))) == 1) then cons(head(rows), tln-selected-rows(tail(rows), s)) else tln-selected-rows(tail(rows), s);
        def tln-toggle-keys(rows, s, code) = if ((Comparable) len(rows) == 0) then [] else if (!((Comparable) tln-selected?(s, head(head(rows))) == ((String) code == head(head(rows))))) then cons(head(head(rows)), tln-toggle-keys(tail(rows), s, code)) else tln-toggle-keys(tail(rows), s, code);
        def tln-toggle(s, code) = if ((Comparable) tln-known?(code) == 0) then s else tln-join(tln-toggle-keys(tln-rows(), s, code));

        // The token whisper wears for this tongue when it says which one it heard. It lives in the
        // SAME row as the name because the ear kept its own shortlist and the two drifted: the ear
        // listened for three (en, fa, pt) under a comment reading "the three the glass offers", while
        // the glass offered four — and the missing one was Indonesian, in a house that speaks it
        // (corpus row 1416 heardshort). One row, one truth; ear-heard-tongues-band holds them equal.
        // The order is whisper's own LANGUAGES order, 50259 + the tongue's index; every code here
        // falls at offset 0..89, inside the 99 logits the ear reads.
        def tln-heard-tok-in(rows, code) = if ((Comparable) len(rows) == 0) then (0 - 1) else if ((String) head(head(rows)) == code) then head(rows)[2] else tln-heard-tok-in(tail(rows), code);
        def tln-heard-tok(code) = tln-heard-tok-in(tln-rows(), code);
        def tln-heard-toks(codes) = if ((Comparable) len(codes) == 0) then [] else tln-heard-toks-cons(tln-heard-tok(head(codes)), tln-heard-toks(tail(codes)));
        def tln-heard-toks-cons(t, rest) = if (t < 0) then rest else cons(t, rest);
        def tln-default-toks() = tln-heard-toks(tln-keys(tln-defaults()));
    }
    0;
}
