// Reuse an agreed translation only while the source extends the same thought.
// A correction to already-heard words must be free to correct their translation.
section [form.bml] {
    class EarTranslationFlow {
        def etf-extends?(prior, current) = and(gt(str_len(prior), 0), and(ge(str_len(current), str_len(prior)), str_eq(substring(current, 0, str_len(prior)), prior)));
        def etf-forced(prior, current, committed, previous) = if str_eq(prior, current) then previous else if etf-extends?(prior, current) then committed else list();
    }
    0;
}
