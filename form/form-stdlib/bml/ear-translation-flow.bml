// Reuse an agreed translation only while the source extends the same thought.
// A correction to already-heard words must be free to correct their translation.
section [form.bml] {
    class EarTranslationFlow {
        def etf-extends?(prior, current) = (str_len(prior) > 0) && ((str_len(current) >= str_len(prior)) && ((String) substring(current, 0, str_len(prior)) == prior));
        def etf-forced(prior, current, committed, previous) = (String) prior == current ? previous : etf-extends?(prior, current) ? committed : list();
    }
    0;
}
