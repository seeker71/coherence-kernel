// form-cli-build-flow.bml — the native form-cli's regeneration, build, install and proof, as flows over form-cli-build.bml.
//
// fcb-regen(opts)   publish the sealed source identity and this host's native platform bundle (the executable, its .fkb and .sym) from
//                   one witnessed candidate: the source closure is sealed, the startup C is emitted from the seal, the build runs over
//                   those exact originals, and the files land first (each by a same-directory rename) with the source identity last.
// fcb-build(opts)   install, copy or build the native form-cli: with no out, form/form-cli becomes the link to this host's published,
//                   verified bundle in form-stdlib/bootstrap; an out names a copy. A checkout that holds no current generation
//                   regenerates (an install) or builds the copy inside a private copy of the body and leaves its own bundle alone.
// fcb-prove(binary, id)  the behavioral proof of an executable: identity, then its REPL from an empty directory.
// Every flow answers "" when it held and its reason when it did not; nothing is retried blind, and a failed candidate keeps its work
// directory when opts say retain. opts is a record: out, explicit, bootstrap_dir, regenerated, private, force_link, runner,
// emission_dir, snapshot, seal, seal_id, retain, cc, out_dir.
// preludes: form-stdlib/bml/form-cli-build.bml
import form-stdlib/bml/source-tree.bml;
section [form.bml] {
 class FormCliBuildFlow {
  def fcb-opt(opts, key, dflt) = record_has(opts, key) ? record_get(opts, key) : dflt;
  def fcb-roots-path() = "form/form-stdlib/form-cli-source-roots.txt";
  def fcb-roots-text() = read_file(fcb-roots-path()) ?? "";
  // the manifest of the sources a generation names, read from form/: its own path first, then every source it lists
  def fcb-manifest-rel() = "form-stdlib/bootstrap/form-cli.dependencies";
  def fcb-source-paths(form) {
   let manifest = fs-path-join(form, fcb-manifest-rel());
   fcb-regular?(manifest) && (Comparable) file_size(manifest) > 0 ? cons(fcb-manifest-rel(), fcb-lines(read_file(manifest) ?? "")) : nothing();
  }
  def fcb-work(kind) {
   let swept = fcb-sweep-ended();
   let dir = temp_dir() ++ "/form-cli-" ++ kind ++ "." ++ host_pid().str() ++ "." ++ now_unix_ms().str();
   let made = hch-mkdirs(dir);
   dir;
  }
  // A work dir is form-cli-<kind>.<pid>.<ms>. A build that was stopped (a deadline, a kill) leaves its dirs behind, each a
  // sealed body, a runner and a candidate (100 to 160 MB). A build that begins takes back the dirs of builds whose process
  // has ended; a dir whose pid lives (another build, or a pid the host gave out again) stays, and so does a dir a failed
  // build kept on purpose (retain 1 marks it .retained).
  def fcb-sweep-ended() = foldl((acc, name) => acc + fcb-sweep-one(name), 0, fs_list(temp_dir()) ?? []);
  def fcb-sweep-one(name) {
   let pid = fcb-work-pid(name, ["form-cli-regen.", "form-cli-build.", "form-cli-private."]);
   let dir = temp_dir() ++ "/" ++ name;
   nothing?(pid) || pid == host_pid() || (Comparable) host_alive(pid) == 1 || (Comparable) file_size(dir ++ "/.retained") >= 0 ? 0 : ((Comparable) host_dir_rmdir(dir) == 0 ? 1 : 0);
  }
  def fcb-retain(dir, said) {
   let marked = write_file_text(dir ++ "/.retained", said ++ dir ++ "\n");
   print_str(said ++ dir);
  }
  // the pid a work dir's name carries, nothing for any other name
  def fcb-work-pid(name, kinds) = nil?(kinds) ? nothing() : (Comparable) str_find(name, kinds[0], 0) == 0 ? fcb-work-pid-at(substring(name, len(kinds[0]), len(name))) : fcb-work-pid(name, kinds[1:]);
  def fcb-work-pid-at(rest) = str_find(rest, ".", 0) <= 0 ? nothing() : fcb-digits?(substring(rest, 0, str_find(rest, ".", 0)), 0) ? str_to_int(substring(rest, 0, str_find(rest, ".", 0))) : nothing();
  def fcb-digits?(s, i) = i >= len(s) ? true : (str_byte_at(s, i) >= 48 && str_byte_at(s, i) <= 57) && fcb-digits?(s, i + 1);
  def fcb-rm(dir) = host_dir_rmdir(dir);
  def fcb-then(why, next) = (String) why != "" ? why : next();
  // OS operations by seed door: a regular file copied whole (the mode rides along), a mode set. The mode is octal digits ("700") or
  // "+x", which gives execute wherever read stands (what chmod +x made of 644 and of 600).
  def fcb-copy(from, to) = fcb-regular?(from) && (Comparable) host_file_copy(from, to) >= 0;
  def fcb-octal(s) = len(s) == 0 ? -1 : fcb-octal-go(s, 0, 0);
  def fcb-octal-go(s, i, acc) = i >= len(s) ? acc : (str_byte_at(s, i) < 48 || str_byte_at(s, i) > 55) ? -1 : fcb-octal-go(s, i + 1, acc * 8 + (str_byte_at(s, i) - 48));
  def fcb-xbit(bits, r, x) = (bits / r) % 2 == 1 && (bits / x) % 2 == 0 ? x : 0;
  def fcb-with-exec(bits) = bits + fcb-xbit(bits, 256, 64) + fcb-xbit(bits, 32, 8) + fcb-xbit(bits, 4, 1);
  def fcb-mode-bits(mode, path) = (String) mode == "+x" ? (Comparable) host_file_mode(path) < 0 ? -1 : fcb-with-exec(host_file_mode(path) % 4096) : fcb-octal(mode);
  def fcb-chmod(mode, path) = (Comparable) fcb-mode-bits(mode, path) >= 0 && (Comparable) host_chmod(path, fcb-mode-bits(mode, path)) == 0;
  def fcb-publish(from, to) {
   let stage = to ++ ".writing-" ++ host_pid().str();
   fcb-copy(from, stage) && (Comparable) host_path_rename(stage, to) == 0;
  }
  def fcb-trim-file(path) = trim(read_file(path) ?? "");
  // ---- the closure door: a request on its stdin, a checked reading of what it left
  def fcb-door() = "form/form-stdlib/bml/form-cli-source-closure.bml";
  def fcb-ask(io, step, runner, lines) = hch-run-in(io, step, [runner, fcb-door()], fcb-join(lines, "\n") ++ "\n", hch-by(7200000));
  def fcb-ask-why(run, what) = hch-ok?(run) ? "" : what ++ ": " ++ trim(run[1]);
  def fcb-roots-lines() = fcb-lines(fcb-roots-text());
  // ---- the source identity still current: the seal verified, and the files on disk fold to the identity it was sealed with
  def fcb-identity-current(io, runner, form, seal, seal-id, paths, want-id) {
   let run = fcb-ask(io, "source-verify", runner, ["FCSV1", seal, seal-id, "END"]);
   !hch-ok?(run) ? "source verification refused: " ++ trim(run[1])
   : (String) (fcb-source-id(fcb-read-sources(form, paths)) ?? "") != want-id ? "canonical source identity changed"
   : "";
  }
  // ---- the identity of the sources as they stand: the closure door seals them into a work directory and the seal's source.id
  // is printed, one line of 16 hex — the identity a build begun now would carry. Nothing is built or published; the work
  // directory is removed again. A consumer that keeps a copy compares this line with the copy's own form-cli.source.id.
  def fcb-source-identity() {
   let work = fcb-work("identity");
   let held = work ++ "/fkwu-source";
   let ok = fcb-copy(host_cwd() ++ "/fkwu", held) && fcb-chmod("700", held);
   let why = ok ? fcb-source-identity-seal(work, held) : "identity: the native source runner could not be held";
   let gone = fcb-rm(work);
   why;
  }
  def fcb-source-identity-seal(work, runner) {
   let seal-dir = work ++ "/source-seal";
   let run = fcb-ask(work, "source-closure", runner, append(["FCSC1", fcb-form(), seal-dir], fcb-roots-lines()));
   let id = fcb-trim-file(seal-dir ++ "/source.id");
   !hch-ok?(run) ? "identity: native source dependency closure refused: " ++ trim(run[1])
   : !fcb-id-valid?(id) ? "identity: sealed source identity is no identity"
   : fcb-say(id);
  }
  // ---- regeneration
  def fcb-regen(opts) {
   let form = fcb-form();
   let out = fcb-opt(opts, "out_dir", fcb-boot-default());
   let made = hch-mkdirs(out);
   let lock = fcb-lock-acquire(out ++ "/.form-cli-publish.lock");
   (Comparable) lock[0] != 0 ? lock[1] : fcb-regen-held(opts, form, out);
  }
  def fcb-boot-default() = fcb-form() ++ "/form-stdlib/bootstrap";
  def fcb-regen-held(opts, form, out) {
   let work = fcb-work("regen");
   let why = fcb-regen-run(opts, form, out, work);
   let kept = (String) why != "" && (Comparable) fcb-opt(opts, "retain", 0) == 1;
   let say = kept ? fcb-retain(work, "regen: retained failed work dir ") : fcb-rm(work);
   let released = fcb-lock-release(out ++ "/.form-cli-publish.lock");
   why;
  }
  def fcb-regen-run(opts, form, out, work) {
   let runner = fcb-opt(opts, "runner", host_cwd() ++ "/fkwu");
   let held = work ++ "/fkwu-source";
   fcb-regular?(runner) ? fcb-regen-copy(opts, form, out, work, runner, held) : "regen: native source runner is missing or not a regular executable: " ++ runner;
  }
  def fcb-regen-copy(opts, form, out, work, runner, held) {
   let ok = fcb-copy(runner, held) && fcb-chmod("700", held);
   ok ? fcb-regen-seal(opts, form, out, work, held, fcb-id-file(held)) : "regen: the native source runner could not be held";
  }
  def fcb-regen-seal(opts, form, out, work, runner, author-id) {
   let seal-dir = work ++ "/source-seal";
   let run = fcb-ask(work, "source-closure", runner, append(["FCSC1", form, seal-dir], fcb-roots-lines()));
   let ready = fcb-trim-file(seal-dir ++ "/ready");
   !hch-ok?(run) ? "regen: native source dependency closure refused: " ++ trim(run[1])
   : !(fcb-nonempty?(seal-dir ++ "/ready") && fcb-nonempty?(seal-dir ++ "/sources.json") && fcb-nonempty?(seal-dir ++ "/source.id")) ? "regen: native source seal completion is absent"
   : !fcb-id-valid?(ready) ? "regen: native source seal identity is no identity"
   : fcb-regen-install(opts, form, out, work, runner, author-id, seal-dir, seal-dir ++ "/sources.json", ready);
  }
  def fcb-nonempty?(path) = (Comparable) file_size(path) > 0;
  def fcb-regen-install(opts, form, out, work, runner, author-id, seal-dir, seal, seal-id) {
   let run = fcb-ask(work, "source-install", runner, ["FCSI1", seal, seal-id, "END"]);
   let paths = fcb-source-paths(form);
   let want-id = fcb-trim-file(seal-dir ++ "/source.id");
   !hch-ok?(run) ? "regen: checked source manifest publication refused: " ++ trim(run[1])
   : nothing?(paths) ? "regen: the installed source manifest is absent"
   : !fcb-id-valid?(want-id) ? "regen: sealed source identity is no identity"
   : fcb-regen-emit(opts, form, out, work, runner, author-id, seal-dir, seal, seal-id, paths, want-id);
  }
  def fcb-regen-emit(opts, form, out, work, runner, author-id, seal-dir, seal, seal-id, paths, want-id) {
   let emission = work ++ "/native-entry";
   let still = fcb-identity-current(work, runner, form, seal, seal-id, paths, want-id);
   let run = fcb-ask(work, "emission", runner, ["FCSE1", seal, seal-id, emission, "END"]);
   let eid = fcb-trim-file(emission ++ "/ready");
   (String) still != "" ? still
   : !hch-ok?(run) ? "regen: sealed native startup emission refused: " ++ trim(run[1])
   : !(fcb-nonempty?(emission ++ "/ready") && fcb-nonempty?(emission ++ "/form-cli-native.c") && fcb-nonempty?(emission ++ "/runtime-source.c")) ? "regen: native startup completion is absent"
   : !fcb-id-valid?(eid) ? "regen: native startup identity is no identity"
   : fcb-regen-candidate(opts, form, out, work, runner, author-id, seal-dir, seal, seal-id, paths, want-id, emission, eid);
  }
  def fcb-emitted-check(work, runner, mode, emission, eid, target) {
   let run = fcb-ask(work, "emission-check-" ++ mode, runner, [mode, emission ++ "/emission.json", eid, target, "END"]);
   hch-ok?(run) ? "" : "emitted source check " ++ mode ++ " refused: " ++ trim(run[1]);
  }
  def fcb-regen-candidate(opts, form, out, work, runner, author-id, seal-dir, seal, seal-id, paths, want-id, emission, eid) {
   let boot = work ++ "/bootstrap";
   let made = hch-mkdirs(boot);
   let startup = boot ++ "/form-cli-native.c";
   let check = fcb-emitted-check(work, runner, "FCEP1", emission, eid, startup);
   let id-copied = fcb-copy(seal-dir ++ "/source.id", boot ++ "/form-cli.source.id");
   let attested = fcb-write-startup(boot ++ "/form-cli.native.attestation", want-id, startup, author-id, emission ++ "/runtime-source.c");
   (String) check != "" ? check
   : !attested ? "regen: the startup attestation could not be written and verified"
   : fcb-then(fcb-identity-current(work, runner, form, seal, seal-id, paths, want-id), () => fcb-regen-build(opts, form, out, work, runner, author-id, seal-dir, seal, seal-id, paths, want-id, emission, eid, boot));
  }
  def fcb-regen-build(opts, form, out, work, runner, author-id, seal-dir, seal, seal-id, paths, want-id, emission, eid, boot) {
   let inner = record_new(0, "out", work ++ "/form-cli", "explicit", 1, "bootstrap_dir", boot, "force_link", 1, "runner", runner, "emission_dir", emission, "snapshot", seal-dir ++ "/body", "seal", seal, "seal_id", seal-id, "retain", fcb-opt(opts, "retain", 0), "cc", fcb-opt(opts, "cc", "cc"));
   let why = fcb-build-main(inner);
   (String) why != "" ? why : fcb-regen-verify(opts, form, out, work, runner, author-id, seal, seal-id, paths, want-id, emission, eid, boot);
  }
  def fcb-regen-verify(opts, form, out, work, runner, author-id, seal, seal-id, paths, want-id, emission, eid, boot) {
   let slug = fcb-platform-slug();
   let platform-ok = fcb-verify-platform(work ++ "/form-cli.native.attestation", want-id, boot ++ "/form-cli.native.attestation", slug, work ++ "/form-cli", work ++ "/form-cli.fkb", work ++ "/form-cli.sym");
   let check = fcb-emitted-check(work, runner, "FCEV1", emission, eid, boot ++ "/form-cli-native.c");
   let startup-ok = fcb-verify-startup(boot ++ "/form-cli.native.attestation", want-id, boot ++ "/form-cli-native.c", emission ++ "/runtime-source.c", author-id);
   !platform-ok ? "regen: the built platform bundle refused its attestation"
   : (String) check != "" ? check
   : !startup-ok ? "regen: the startup attestation no longer holds"
   : fcb-then(fcb-identity-current(work, runner, form, seal, seal-id, paths, want-id), () => fcb-regen-publish(form, out, work, boot, slug, want-id));
  }
  // the witnessed candidate IS the platform bundle; nothing is rebuilt. Files land first, each by a same-directory rename; the
  // source identity last, the mark that the generation stands.
  def fcb-regen-publish(form, out, work, boot, slug, want-id) {
   let target = out ++ "/form-cli-" ++ slug;
   let landed = fcb-publish(work ++ "/form-cli.fkb", target ++ ".fkb") && fcb-publish(work ++ "/form-cli.sym", target ++ ".sym") && fcb-publish(work ++ "/form-cli.native.attestation", target ++ ".native.attestation")
    && fcb-publish(work ++ "/form-cli", target) && fcb-publish(boot ++ "/form-cli.native.attestation", out ++ "/form-cli.native.attestation");
   let own = landed && fcb-verify-platform(target ++ ".native.attestation", want-id, out ++ "/form-cli.native.attestation", slug, target, target ++ ".fkb", target ++ ".sym");
   let done = own && fcb-publish(boot ++ "/form-cli.source.id", out ++ "/form-cli.source.id");
   !landed ? "regen: a published file could not land"
   : !own ? "regen: published platform bundle refused its own attestation"
   : !done ? "regen: the source identity could not land"
   : fcb-regen-said(out, slug, want-id);
  }
  def fcb-regen-said(out, slug, want-id) {
   let said = print_str("regen: native startup, sealed recipe and form-cli-" ++ slug ++ " bundle accepted into " ++ out ++ "; source=" ++ want-id);
   "";
  }
  // ---- the build
  // a generation is current when the files a regeneration publishes stand and its identity answers for the sources the manifest lists
  def fcb-bootstrap-files() = ["form-cli.dependencies", "form-cli.source.id", "form-cli.native.attestation"];
  def fcb-current?(form) {
   let boot = fs-path-join(form, "form-stdlib/bootstrap");
   let paths = fcb-source-paths(form);
   all?(f => fcb-nonempty?(boot ++ "/" ++ f) && fcb-regular?(boot ++ "/" ++ f), fcb-bootstrap-files()) && !nothing?(paths)
   && fcb-current-at?(boot, fcb-source-id(fcb-read-sources(form, paths)) ?? "");
  }
  def fcb-current-at?(boot, id) = (String) fcb-trim-file(boot ++ "/form-cli.source.id") == id;
  def fcb-build(opts) {
   let form = fcb-form();
   let verified = hch-run-in(fcb-io(), "native-node-word", ["./fkwu", "observe/native-node-word-verify.bml"], "", hch-by(1800000));
   !hch-ok?(verified) ? "build: native node word verification refused: " ++ trim(verified[1])
   : (String) fcb-opt(opts, "bootstrap_dir", "") == "" && (Comparable) fcb-opt(opts, "regenerated", 0) != 1 && !fcb-current?(form) ? fcb-build-stale(opts, form)
   : fcb-build-main(opts);
  }
  def fcb-build-stale(opts, form) {
   (Comparable) fcb-opt(opts, "explicit", 0) == 1 && (Comparable) fcb-opt(opts, "private", 0) != 1 ? fcb-build-private(opts, form)
   : fcb-build-regen(opts, form);
  }
  def fcb-build-regen(opts, form) {
   let said = print_str("build: no current native bootstrap in this checkout; regenerating it from source");
   let why = fcb-regen(opts);
   let held = record_set(opts, "regenerated", 1);
   (String) why != "" ? why : fcb-build-main(opts);
  }
  // a copy build for a checkout with no current generation: the body's tracked and new files and its runtime are copied into a private
  // directory with its own lookup boundary, the build runs there (regenerating that copy's bootstrap), only the out is written
  def fcb-build-private(opts, form) {
   let said = print_str("build: no current native bootstrap in this checkout; building the copy in a private body, leaving this checkout's bundle untouched");
   let body = fcb-work("private");
   let why = fcb-private-run(opts, body);
   let kept=(String) why != "" && (Comparable) fcb-opt(opts,"retain",0)==1;
   let gone=kept ? fcb-retain(body, "build: retained private body ") : fcb-rm(body);
   why;
  }
  def fcb-private-run(opts, body) {
   let names = tracked-files();
   let copied = cbn-copy(host_cwd(), names, body);
   (String) copied != "" ? "build: the private copy of the body could not be made: " ++ copied
   : fcb-private-built(opts, body);
  }
  def fcb-private-built(opts, body) {
   let held = fcb-copy(host_cwd() ++ "/fkwu", body ++ "/fkwu") && (Comparable) write_file(body ++ "/.git", "private body lookup boundary\n") > 0 && fcb-private-store(body);
   let out = fcb-out-path(opts);
   let request = "{\"out\":\"" ++ out ++ "\",\"explicit\":1,\"private\":1,\"retain\":" ++ fcb-opt(opts, "retain", 0).str() ++ "}";
   let run = held ? hch-run-at(fcb-io(), "private-build", body, ["./fkwu", "gate/form-cli-build-run.bml"], request, hch-by(7200000)) : [nothing(), "", "not held"];
   let said = held ? print_str(trim(run[1])) : 0;
   !held ? "build: the private body could not be held" : !hch-ok?(run) ? "build: the build inside the private body failed\n" ++ trim(run[2]) : "";
  }
  def fcb-out-path(opts) {
   let out = fcb-opt(opts, "out", "form-cli");
   fcb-starts?(out, "/") ? out : fcb-form() ++ "/" ++ out;
  }
  // the main build, over a current bootstrap
  def fcb-build-main(opts) {
   let form = fcb-form();
   let paths = fcb-source-paths(form);
   let boot = (String) fcb-opt(opts, "bootstrap_dir", "") == "" ? fcb-boot-default() : fcb-opt(opts, "bootstrap_dir", "");
   let work = fcb-work("build");
   let why = nothing?(paths) ? "form-cli source dependency manifest missing" : fcb-build-held(opts, form, paths, boot, work);
   let kept = (String) why != "" && (Comparable) fcb-opt(opts, "retain", 0) == 1;
   let say = kept ? fcb-retain(work, "build: retained failed native CLI work directory ") : fcb-rm(work);
   why;
  }
  def fcb-build-held(opts, form, paths, boot, work) {
   let slug = fcb-platform-slug();
   let want-id = fcb-source-id(fcb-read-sources(form, paths));
   let body = host_cwd();
   let copies = fcb-copy(boot ++ "/form-cli.native.attestation", work ++ "/bootstrap.attestation") && fcb-copy(body ++ "/runtime/fkwu-uni.c", work ++ "/runtime-source.c") && fcb-copy(body ++ "/runtime/fkwu-optable.h", work ++ "/fkwu-optable.h") && fcb-copy(body ++ "/runtime/fkwu-node-word.h", work ++ "/fkwu-node-word.h");
   !copies ? "build: a regular artifact is missing"
   : nothing?(want-id) ? "build: a listed source is absent"
   : (String) fcb-trim-file(boot ++ "/form-cli.source.id") != want-id ? "build: native CLI source generation is stale; regenerate with {\"regen\":1}"
   : fcb-build-platform(opts, form, paths, boot, work, slug, want-id);
  }
  def fcb-build-platform(opts, form, paths, boot, work, slug, want-id) {
   let candidate = work ++ "/form-cli";
   let platform = fs-path-join(form, "form-stdlib/bootstrap/form-cli-" ++ slug);
   let published = (Comparable) fcb-opt(opts, "force_link", 0) != 1 && (Comparable) file_size(platform ++ ".native.attestation") >= 0;
   published ? fcb-copy-platform(opts, form, paths, boot, work, slug, want-id, candidate, platform) : fcb-build-native(opts, form, paths, boot, work, slug, want-id, candidate);
  }
  def fcb-copy-platform(opts, form, paths, boot, work, slug, want-id, candidate, platform) {
   let held = fcb-copy(platform, candidate) && fcb-copy(platform ++ ".fkb", candidate ++ ".fkb") && fcb-copy(platform ++ ".sym", candidate ++ ".sym") && fcb-copy(platform ++ ".native.attestation", work ++ "/platform.attestation")
    && fcb-verify-platform(work ++ "/platform.attestation", want-id, work ++ "/bootstrap.attestation", slug, candidate, candidate ++ ".fkb", candidate ++ ".sym");
   !held ? "build: published native CLI bundle refused; explicit regeneration is required" : fcb-build-publish(opts, form, paths, boot, work, slug, want-id, candidate, 1);
  }
  def fcb-build-native(opts, form, paths, boot, work, slug, want-id, candidate) {
   let cc = fcb-opt(opts, "cc", "cc");
   let runner = fcb-opt(opts, "runner", host_cwd() ++ "/fkwu");
   let compiler = hch-run-in(fcb-io(), "cc-present", [cc, "--version"], "", hch-by(60000));
   !hch-ok?(compiler) ? "build: compiler required for native startup: " ++ cc
   : !fcb-regular?(runner) ? "build: native source runner required: " ++ runner
   : !fcb-copy(runner, work ++ "/source-fkwu") ? "build: native source runner could not be held"
   : fcb-build-seal(opts, form, paths, boot, work, slug, want-id, candidate, cc);
  }
  // the sealed snapshot: handed in by a regeneration, else sealed here from the roots
  def fcb-build-seal(opts, form, paths, boot, work, slug, want-id, candidate, cc) {
   let runner = work ++ "/source-fkwu";
   let given = len(fcb-opt(opts, "seal", "")) > 0;
   let sealed = given ? [fcb-opt(opts, "seal", ""), fcb-opt(opts, "snapshot", ""), fcb-opt(opts, "seal_id", "")] : fcb-seal-here(work, runner, form);
   let seal = sealed[0];
   let snapshot = sealed[1];
   let seal-id = sealed[2];
   (String) seal == "" ? "build: " ++ snapshot
   : (String) snapshot != fs-path-dirname(seal) ++ "/body" ? "build: snapshot path disagrees with source seal owner"
   : !fcb-id-valid?(seal-id) ? "build: source snapshot completion absent"
   : (String) fcb-trim-file(fs-path-dirname(seal) ++ "/source.id") != want-id ? "build: held source snapshot identity changed"
   : fcb-build-emit(opts, form, paths, boot, work, slug, want-id, candidate, cc, runner, seal, snapshot, seal-id);
  }
  def fcb-seal-here(work, runner, form) {
   let dir = work ++ "/sources";
   let run = fcb-ask(work, "source-closure", runner, append(["FCSC1", form, dir], fcb-roots-lines()));
   hch-ok?(run) ? [dir ++ "/sources.json", dir ++ "/body", fcb-trim-file(dir ++ "/ready")] : ["", "the source closure refused: " ++ trim(run[1]), ""];
  }
  def fcb-build-emit(opts, form, paths, boot, work, slug, want-id, candidate, cc, runner, seal, snapshot, seal-id) {
   let before = fcb-ask(work, "verify-before", runner, ["FCSV1", seal, seal-id, "END"]);
   let same-table = (String) (read_file(work ++ "/fkwu-optable.h") ?? "") == (read_file(snapshot ++ "/runtime/fkwu-optable.h") ?? "x") && (String) (read_file(work ++ "/fkwu-node-word.h") ?? "") == (read_file(snapshot ++ "/runtime/fkwu-node-word.h") ?? "x");
   let given = len(fcb-opt(opts, "emission_dir", "")) > 0;
   let emission = given ? fcb-opt(opts, "emission_dir", "") : work ++ "/native-entry";
   let made = given ? nothing() : fcb-ask(work, "emission", runner, ["FCSE1", seal, seal-id, emission, "END"]);
   let eid = fcb-trim-file(emission ++ "/ready");
   !hch-ok?(before) ? "build: source snapshot verification refused: " ++ trim(before[1])
   : !same-table ? "build: the runtime tables differ from the sealed snapshot"
   : !given && !hch-ok?(made) ? "build: native startup emission refused: " ++ trim(made[1])
   : !fcb-id-valid?(eid) ? "build: native startup completion absent"
   : fcb-then(fcb-emitted-check(work, runner, "FCEP1", emission, eid, work ++ "/startup.c"), () => fcb-build-compile(opts, form, paths, boot, work, slug, want-id, candidate, cc, runner, seal, snapshot, seal-id));
  }
  def fcb-build-compile(opts, form, paths, boot, work, slug, want-id, candidate, cc, runner, seal, snapshot, seal-id) {
   let identity = fcb-verify-startup(work ++ "/bootstrap.attestation", want-id, work ++ "/startup.c", work ++ "/runtime-source.c", "");
   let windows = fcb-starts?(slug, "windows-");
   let argv = append([cc, "-O2", "-I", work, "-o", candidate, work ++ "/startup.c"], windows ? ["-lws2_32", "-lwinmm", "-lavicap32", "-luser32", "-lwlanapi", "-lbthprops", "-lwinhttp"] : []);
   let compiled = identity ? hch-run-in(fcb-io(), "cc-startup", argv, "", hch-by(7200000)) : [nothing(), "", ""];
   !identity ? "build: native startup identity refused"
   : !hch-ok?(compiled) ? "build: the native startup did not compile: " ++ trim(compiled[1])
   : fcb-build-recipe(opts, form, paths, boot, work, slug, want-id, candidate, runner, seal, snapshot, seal-id);
  }
  def fcb-build-recipe(opts, form, paths, boot, work, slug, want-id, candidate, runner, seal, snapshot, seal-id) {
   let recipe = snapshot ++ "/form/form-stdlib/form-cli-repl.fk";
   let isolated = fcb-private-store(snapshot);
   let run = isolated ? hch-run-at(fcb-io(), "compile-source", snapshot, [candidate, "--compile-source", recipe], "", hch-by(7200000)) : [nothing(),"",""];
   let said = print_str(trim(run[1]));
   !isolated ? "build: native recipe private store configuration unavailable"
   : !hch-ok?(run) ? "build: native recipe compilation refused"
   : !(fcb-copy(recipe ++ ".fkb", candidate ++ ".fkb") && fcb-copy(recipe ++ ".sym", candidate ++ ".sym")) ? "build: the recipe image or its symbols are missing"
   : fcb-then(fcb-verify-after(work, runner, seal, seal-id), () => fcb-build-attest(opts, form, paths, boot, work, slug, want-id, candidate));
  }
  def fcb-verify-after(work, runner, seal, seal-id) {
   let run = fcb-ask(work, "verify-after", runner, ["FCSV1", seal, seal-id, "END"]);
   hch-ok?(run) ? "" : "build: source snapshot changed during compilation: " ++ trim(run[1]);
  }
  def fcb-build-attest(opts, form, paths, boot, work, slug, want-id, candidate) {
   let wrote = fcb-write-platform(work ++ "/platform.attestation", work ++ "/bootstrap.attestation", slug, candidate, candidate ++ ".fkb", candidate ++ ".sym");
   wrote ? fcb-build-publish(opts, form, paths, boot, work, slug, want-id, candidate, 0) : "build: the platform attestation could not be written and verified";
  }
  // checks, then publication: the install is one relative link swapped in whole; a copy is published executable last
  def fcb-build-publish(opts, form, paths, boot, work, slug, want-id, candidate, platform-verified) {
   let check = fcb-check-dir(work ++ "/check");
   let identity = fcb-verify-identity(candidate, want-id, check);
   let attested = fcb-verify-platform(work ++ "/platform.attestation", want-id, work ++ "/bootstrap.attestation", slug, candidate, candidate ++ ".fkb", candidate ++ ".sym");
   let current = (String) (fcb-source-id(fcb-read-sources(form, paths)) ?? "") == want-id;
   (String) identity != "" ? identity
   : !attested ? "build: the platform attestation no longer holds"
   : !current ? "build: source generation changed before publication"
   : fcb-publish-out(opts, form, work, slug, want-id, candidate, platform-verified, check);
  }
  def fcb-publish-out(opts, form, work, slug, want-id, candidate, platform-verified, check) {
   let out = fcb-out-path(opts);
   let made = hch-mkdirs(fs-path-dirname(out));
   let link = (Comparable) fcb-opt(opts, "explicit", 0) != 1 && (Comparable) platform-verified == 1 && (String) fcb-opt(opts, "bootstrap_dir", "") == "";
   link ? fcb-link-out(out, slug, want-id, check) : fcb-copy-out(out, work, candidate, want-id);
  }
  def fcb-link-out(out, slug, want-id, check) {
   let stage = out ++ ".linking-" ++ host_pid().str();
   let linked = (Comparable) host_symlink("form-stdlib/bootstrap/form-cli-" ++ slug, stage) == 0 && (Comparable) host_path_rename(stage, out) == 0;
   let identity = linked ? fcb-verify-identity(out, want-id, check) : "build: the link could not be made";
   (String) identity != "" ? identity : fcb-say("linked " ++ out ++ " -> form-stdlib/bootstrap/form-cli-" ++ slug ++ "; source=" ++ want-id);
  }
  def fcb-copy-out(out, work, candidate, want-id) {
   let pid = host_pid().str();
   let staged = fcb-copy(candidate ++ ".fkb", out ++ ".fkb.writing-" ++ pid) && fcb-copy(candidate ++ ".sym", out ++ ".sym.writing-" ++ pid) && fcb-copy(work ++ "/platform.attestation", out ++ ".native.attestation.writing-" ++ pid) && (Comparable) write_file_text(out ++ ".source.id.writing-" ++ pid, want-id ++ "\n") == len(want-id)+1 && fcb-copy(candidate, out ++ ".writing-" ++ pid) && fcb-chmod("+x", out ++ ".writing-" ++ pid);
   let landed = staged && (Comparable) host_path_rename(out ++ ".fkb.writing-" ++ pid, out ++ ".fkb") == 0 && (Comparable) host_path_rename(out ++ ".sym.writing-" ++ pid, out ++ ".sym") == 0 && (Comparable) host_path_rename(out ++ ".native.attestation.writing-" ++ pid, out ++ ".native.attestation") == 0 && (Comparable) host_path_rename(out ++ ".source.id.writing-" ++ pid, out ++ ".source.id") == 0 && (Comparable) host_path_rename(out ++ ".writing-" ++ pid, out) == 0;
   !landed ? "build: the executable could not be published" : fcb-say("built " ++ out ++ " with native Form image and symbols; source=" ++ want-id);
  }
  def fcb-say(line) {
   let said = print_str(line);
   "";
  }
 }
}
