// form-token-tool-spell.bml — a tool call written back as the control's words (the inverse of form-token-tool.bml's reader).
//
// ftt-render spells any call in the roster the way the lane's reader reads it: a word bare when it can be, quoted when it
// cannot, and a block for the texts of an edit and the input of the rest. A call read back from its spelling is the very cell
// (form-token-tool-band.bml, observe/native-tools-census-run.bml). The lane's decode path does not carry this module: it reads
// calls and never writes them, and the closure the lane lowers sits near a size at which the runtime's lowering of the
// lane's own units came out garbled (2026-10-08: one more call site in form-cli-model-session.fk was enough), so the writer
// stays with the bands, the census and the receipts.
import form-stdlib/bml/form-token-tool.bml;
section [form.bml] {
 class FormTokenToolSpell {
  // The canonical spelling of a call: what the lane shows the model, what a receipt keeps, what the census replays.
  // nothing when the tool is not in the roster.
  def ftt-bare-word?(w) = len(w) > 0 && !ftv-starts?(w, "@") && !ftv-starts?(w, "<<<<") && all?(i => str_byte_at(w, i) > 32 && str_byte_at(w, i) != 34 && str_byte_at(w, i) != 39, range(0, len(w)));
  def ftt-quote(s) = "\"" ++ str-join(ftt-quote-go(s, 0, len(s), [])) ++ "\"";
  def ftt-quote-go(s, i, n, out) = i >= n ? reverse(out) : ftt-quote-go(s, i + 1, n, cons(ftt-quote-byte(str_byte_at(s, i), substring(s, i, i + 1)), out));
  def ftt-quote-byte(b, c) = b == 34 ? "\\\"" : b == 92 ? "\\\\" : b == 10 ? "\\n" : b == 9 ? "\\t" : c;
  def ftt-spell(w) = ftt-bare-word?(w) ? w : ftt-quote(w);
  // a text may travel in a block when none of its lines is ====
  def ftt-blockable?(t) = str_find("\n" ++ t ++ "\n", "\n====\n", 0) < 0;
  // edit's shapes (fat-edit): [path,old,new], [path,old1,new1,old2,new2...], the guarded batch [path,sha,old1,new1...] and the
  // whole replacement [path,"sha256",sha,text]. The trailing texts ride the block; the path, a hash and the word sha256 are words.
  def ftt-sha-word?(w) = len(w) == 64 && all?(i => (str_byte_at(w, i) >= 48 && str_byte_at(w, i) <= 57) || (str_byte_at(w, i) >= 97 && str_byte_at(w, i) <= 102), range(0, len(w)));
  def ftt-edit-words(args) = len(args) == 4 && args[1] == "sha256" ? 3 : (len(args) >= 4 && len(args) % 2 == 0 && ftt-sha-word?(args[1])) ? 2 : 1;
  def ftt-edit-texts(args) = len(args) < 3 ? 0 : len(args) - ftt-edit-words(args);
  def ftt-render(tool, args, input) {
   let spec = ftt-tool-node(tool);
   if nothing?(spec) then nothing() else ftt-render-spec(spec, args, input);
  }
  def ftt-render-spec(spec, args, input) {
   let args-mode = ftt-node-block(spec) == "args";
   let texts = args-mode ? ftt-edit-texts(args) : 0;
   let tail = drop(len(args) - texts, args);
   let blocked = args-mode ? (texts > 0 && all?(t => ftt-blockable?(t), tail)) : len(input) > 0;
   let words = args-mode && blocked ? take(len(args) - texts, args) : args;
   let line = str-join-with(cons(ftt-node-name(spec), words |> map(ftt-spell)), " ");
   let body = !blocked ? "" : args-mode ? "\n<<<<\n" ++ str-join-with(tail, "\n====\n") ++ "\n>>>>" : "\n<<<<\n" ++ input ++ "\n>>>>";
   args-mode && len(input) > 0 ? nothing() : line ++ body;
  }
 }
 0;
}
