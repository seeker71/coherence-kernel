// Admit complete binary integer cells before a thought may be evaluated.
// A variable, missing operand or malformed suffix supplies no numeric value.
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
section [form.bml] {
 class LocalGenerateLiteral {
  def lgl-space?(byte) = or(eq(byte,32),or(eq(byte,9),or(eq(byte,10),eq(byte,13))));
  def lgl-digit?(byte) = and(ge(byte,48),le(byte,57));
  def lgl-space-end(text,at,end) = if ge(at,end) then at else if lgl-space?(str_byte_at(text,at)) then lgl-space-end(text,add(at,1),end) else at;
  def lgl-digit-end(text,at,end) = if ge(at,end) then at else if lgl-digit?(str_byte_at(text,at)) then lgl-digit-end(text,add(at,1),end) else at;
  def lgl-number(text,at,end) {
   let start = lgl-space-end(text,at,end);
   let digits = if and(lt(start,end),eq(str_byte_at(text,start),45)) then add(start,1) else start;
   let stop = lgl-digit-end(text,digits,end);
   if eq(stop,digits) then list() else list(str_to_int(substring(text,start,stop)),stop);
  }
  def lgl-operands(text,at,end) {
   let first = lgl-number(text,at,end);
   if nil?(first) then list() else {
    let between = nth(first,1); let next = lgl-space-end(text,between,end);
    let second = if gt(next,between) then lgl-number(text,next,end) else list();
    if nil?(second) then list() else {
     let close = lgl-space-end(text,nth(second,1),end);
     if and(lt(close,end),eq(str_byte_at(text,close),41)) then list(head(first),head(second),add(close,1)) else list();
    };
   };
  }
  def lgl-op-at(text,op,from) {
   let needle = str_concat("(",str_concat(op," ")); let at = str_find(text,needle,from);
   if lt(at,0) then list() else {
    let body = lgl-operands(text,add(at,str_len(needle)),str_len(text));
    if nil?(body) then lgl-op-at(text,op,add(at,1)) else list(op,head(body),nth(body,1),at,nth(body,2));
   };
  }
 }
 0;
}
