// Admit complete binary integer cells before a thought may be evaluated.
// A variable, missing operand or malformed suffix supplies no numeric value.
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
section [form.bml] {
 class LocalGenerateLiteral {
  def lgl-space?(byte) = ((Comparable) byte == 32) || (((Comparable) byte == 9) || (((Comparable) byte == 10) || ((Comparable) byte == 13)));
  def lgl-digit?(byte) = (byte >= 48) && (byte <= 57);
  def lgl-space-end(text,at,end) = at >= end ? at : lgl-space?(str_byte_at(text,at)) ? lgl-space-end(text,at + 1,end) : at;
  def lgl-digit-end(text,at,end) = at >= end ? at : lgl-digit?(str_byte_at(text,at)) ? lgl-digit-end(text,at + 1,end) : at;
  def lgl-number(text,at,end) {
   let start = lgl-space-end(text,at,end);
   let digits = (start < end) && ((Comparable) str_byte_at(text,start) == 45) ? (start + 1) : start;
   let stop = lgl-digit-end(text,digits,end);
   (Comparable) stop == digits ? list() : list(str_to_int(substring(text,start,stop)),stop);
  }
  def lgl-operands(text,at,end) {
   let first = lgl-number(text,at,end);
   nil?(first) ? list() : {
    let between = first[1]; let next = lgl-space-end(text,between,end);
    let second = next > between ? lgl-number(text,next,end) : list();
    nil?(second) ? list() : {
     let close = lgl-space-end(text,second[1],end);
     (close < end) && ((Comparable) str_byte_at(text,close) == 41) ? list(head(first),head(second),close + 1) : list();
    };
   };
  }
  def lgl-op-at(text,op,from) {
   let needle = "(" ++ op ++ " "; let at = str_find(text,needle,from);
   at < 0 ? list() : {
    let body = lgl-operands(text,at + str_len(needle),str_len(text));
    nil?(body) ? lgl-op-at(text,op,at + 1) : list(op,head(body),body[1],at,body[2]);
   };
  }
 }
 0;
}
