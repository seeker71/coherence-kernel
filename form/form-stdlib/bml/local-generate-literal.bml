// Admit complete binary integer cells before a thought may be evaluated.
// A variable, missing operand or malformed suffix supplies no numeric value.
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
section [form.bml] {
 class LocalGenerateLiteral {
  def lgl-space?(byte) = (((Comparable) byte == 32) || (((Comparable) byte == 9) || (((Comparable) byte == 10) || ((Comparable) byte == 13))));
  def lgl-digit?(byte) = ((byte >= 48) && (byte <= 57));
  def lgl-space-end(text,at,end) = if (at >= end) then at else if lgl-space?(str_byte_at(text,at)) then lgl-space-end(text,(at + 1),end) else at;
  def lgl-digit-end(text,at,end) = if (at >= end) then at else if lgl-digit?(str_byte_at(text,at)) then lgl-digit-end(text,(at + 1),end) else at;
  def lgl-number(text,at,end) {
   let start = lgl-space-end(text,at,end);
   let digits = if ((start < end) && ((Comparable) str_byte_at(text,start) == 45)) then (start + 1) else start;
   let stop = lgl-digit-end(text,digits,end);
   if ((Comparable) stop == digits) then list() else list(str_to_int(substring(text,start,stop)),stop);
  }
  def lgl-operands(text,at,end) {
   let first = lgl-number(text,at,end);
   if nil?(first) then list() else {
    let between = nth(first,1); let next = lgl-space-end(text,between,end);
    let second = if (next > between) then lgl-number(text,next,end) else list();
    if nil?(second) then list() else {
     let close = lgl-space-end(text,nth(second,1),end);
     if ((close < end) && ((Comparable) str_byte_at(text,close) == 41)) then list(head(first),head(second),(close + 1)) else list();
    };
   };
  }
  def lgl-op-at(text,op,from) {
   let needle = str_concat("(",str_concat(op," ")); let at = str_find(text,needle,from);
   if (at < 0) then list() else {
    let body = lgl-operands(text,(at + str_len(needle)),str_len(text));
    if nil?(body) then lgl-op-at(text,op,(at + 1)) else list(op,head(body),nth(body,1),at,nth(body,2));
   };
  }
 }
 0;
}
