// Every observation ID enters the same resident state, in bounded submissions.
// Span-wide admitted scratch uses the existing sliced batched path. Narrow or
// legacy contexts retain the per-position barrier path. A failed submission is
// never retried on a mutated state. Intermediate predictions never enter KV.
// preludes: form-stdlib/bml/form-cli-model-admission.bml native/metal/qwen35-dense-token-handle.fk
section [form.bml] {
 class FormCliModelObservation {
  def fcmo-shape(result,pos,count) = and(eq(len(result),2),and(ge(head(result),0),eq(nth(result,1),add(pos,count))));
  def fcmo-settled(live) = and(eq(len(live),20),and(eq(nth(live,5),0),and(eq(nth(live,6),0),eq(nth(live,14),0))));
  def fcmo-sliced?(ctx) = gt(q38-ctx-span(ctx),1);
  def fcmo-span(ctx,count) = if and(fcmo-sliced?(ctx),lt(q38-ctx-span(ctx),fcma-span(count))) then q38-ctx-span(ctx) else fcma-span(count);
  def fcmo-route(barrier,sliced,ctx,sts,ids,pos) = if fcmo-sliced?(ctx) then sliced(ctx,sts,ids,pos) else barrier(ctx,sts,ids,pos);
  def fcmo-barrier(ctx,sts,ids,pos) = q38-prefill-span(nth(ctx,0),nth(ctx,1),nth(ctx,2),nth(ctx,3),sts,nth(ctx,4),nth(ctx,5),nth(ctx,6),ids,pos);
  def fcmo-sliced(ctx,sts,ids,pos) = q38-prefill-span-sliced(nth(ctx,0),nth(ctx,1),nth(ctx,2),nth(ctx,3),sts,nth(ctx,4),nth(ctx,5),nth(ctx,6),ids,pos,q38-ctx-span(ctx));
  def fcmo-step(ctx,sts,ids,pos) = fcmo-route(fcmo-barrier,fcmo-sliced,ctx,sts,ids,pos);
  def fcmo-walk(step,ctx,sts,ids,pos,span) {
   if or(nil?(ids),le(span,0)) then list(-1,pos)
   else fcmo-slice(step,ctx,sts,ids,pos,span,if lt(len(ids),span) then len(ids) else span);
  }
  def fcmo-slice(step,ctx,sts,ids,pos,span,count) {
   let result = step(ctx,sts,take(count,ids),pos);
   if not(fcmo-shape(result,pos,count)) then list(-1,pos)
   else if eq(count,len(ids)) then result
   else fcmo-walk(step,ctx,sts,drop(count,ids),nth(result,1),span);
  }
  def fcmo-checked-step(step,ctx,sts,ids,pos) {
   let begin = q38oo-stage(str_concat("model-observation-positions-",str_concat(int_to_str(pos),"-begin")),8388625);
   let result = step(ctx,sts,ids,pos);
   let good = and(fcmo-shape(result,pos,len(ids)),and(lt(head(result),nth(nth(ctx,2),19)),fcmo-settled(metal_live())));
   let observed = q38oo-stage(str_concat("model-observation-positions-",str_concat(int_to_str(if good then nth(result,1) else pos),if good then "-ready" else "-refused")),8388625);
   if good then result else list(-1,pos);
  }
  def fcmo-native-step(ctx,sts,ids,pos) = fcmo-checked-step(fcmo-step,ctx,sts,ids,pos);
  def fcmo-barrier-step(ctx,sts,ids,pos) = fcmo-checked-step(fcmo-barrier,ctx,sts,ids,pos);
  def fcmo-prefill(ctx,sts,ids,pos) {
   let span = fcmo-span(ctx,len(ids));
   let selected = q38oo-stage(str_concat("model-observation-route-",str_concat(if fcmo-sliced?(ctx) then "sliced-span-" else "barrier-span-",int_to_str(span))),8388625);
   fcmo-walk(fcmo-native-step,ctx,sts,ids,pos,span);
  }
  // Retained reference for live equivalence and timing observations.
  def fcmo-prefill-reference(ctx,sts,ids,pos) = fcmo-walk(fcmo-barrier-step,ctx,sts,ids,pos,fcma-span(len(ids)));
 }
}
