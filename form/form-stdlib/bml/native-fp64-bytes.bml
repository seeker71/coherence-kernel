// Exact finite binary64 values at an immutable byte boundary.
// Packing and decoding happen outside native matrix reduction loops.
// preludes: form-stdlib/core.fk form-stdlib/bml/formbin-codec.bml
section [form.bml] {
 class NativeFp64Bytes {
  def nfb-require(ok,reason) = if ok then 1 else form_error(str_concat("native fp64: ",reason));
  def nfb-power(x,n,acc) = if ((Comparable) n == 0) then acc else nfb-power((x * x),(n / 2),if ((Comparable) (n % 2) == 1) then (acc * x) else acc);
  def nfb-pow2(n) = if (n < 0) then nfb-power(0.5,(0 - n),1.0) else nfb-power(2.0,n,1.0);
  def nfb-exponent-adjust(x,e) = if (x < nfb-pow2(e)) then nfb-exponent-adjust(x,(e - 1)) else if (x >= nfb-pow2((e + 1))) then nfb-exponent-adjust(x,(e + 1)) else e;
  def nfb-exponent(x) = nfb-exponent-adjust(x,floor((math_log(x) / math_log(2.0))));
  def nfb-le(src,at,n) = if ((Comparable) n == 0) then 0 else (str_byte_at(src,at) + (256 * nfb-le(src,(at + 1),(n - 1))));
  def nfb-fields(sign,exponent,mantissa) = (sign * (if ((Comparable) exponent == 0) then ((1.0 * mantissa) * nfb-pow2(-1074)) else if ((Comparable) exponent == 2047) then if ((Comparable) mantissa == 0) then (1.0 / 0.0) else (0.0 / 0.0) else ((1.0 + ((1.0 * mantissa) / 4503599627370496.0)) * nfb-pow2((exponent - 1023)))));
  def nfb-f64(src) {
   nfb-require(((Comparable) str_len(src) == 8),"binary64 requires exactly eight bytes");
   let lo = nfb-le(src,0,4); let hi = nfb-le(src,4,4);
   nfb-fields(if (hi >= 2147483648) then -1.0 else 1.0,((hi / 1048576) % 2048),(lo + ((hi % 1048576) * 4294967296)));
  }
 }
 0;
}
