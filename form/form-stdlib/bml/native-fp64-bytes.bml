// Exact finite binary64 values at an immutable byte boundary.
// Packing and decoding happen outside native matrix reduction loops.
// preludes: form-stdlib/core.fk form-stdlib/bml/formbin-codec.bml
section [form.bml] {
 class NativeFp64Bytes {
  def nfb-require(ok,reason) = if ok then 1 else form_error(str_concat("native fp64: ",reason));
  def nfb-power(x,n,acc) = if eq(n,0) then acc else nfb-power(mul(x,x),div(n,2),if eq(mod(n,2),1) then mul(acc,x) else acc);
  def nfb-pow2(n) = if lt(n,0) then nfb-power(0.5,sub(0,n),1.0) else nfb-power(2.0,n,1.0);
  def nfb-exponent-adjust(x,e) = if lt(x,nfb-pow2(e)) then nfb-exponent-adjust(x,sub(e,1)) else if ge(x,nfb-pow2(add(e,1))) then nfb-exponent-adjust(x,add(e,1)) else e;
  def nfb-exponent(x) = nfb-exponent-adjust(x,floor(div(math_log(x),math_log(2.0))));
  def nfb-le(src,at,n) = if eq(n,0) then 0 else add(str_byte_at(src,at),mul(256,nfb-le(src,add(at,1),sub(n,1))));
  def nfb-fields(sign,exponent,mantissa) = mul(sign,if eq(exponent,0) then mul(mul(1.0,mantissa),nfb-pow2(-1074)) else if eq(exponent,2047) then if eq(mantissa,0) then div(1.0,0.0) else div(0.0,0.0) else mul(add(1.0,div(mul(1.0,mantissa),4503599627370496.0)),nfb-pow2(sub(exponent,1023))));
  def nfb-f64(src) {
   nfb-require(eq(str_len(src),8),"binary64 requires exactly eight bytes");
   let lo = nfb-le(src,0,4); let hi = nfb-le(src,4,4);
   nfb-fields(if ge(hi,2147483648) then -1.0 else 1.0,mod(div(hi,1048576),2048),add(lo,mul(mod(hi,1048576),4294967296)));
  }
 }
 0;
}
