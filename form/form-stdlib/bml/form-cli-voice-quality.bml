// What an answer is worth against what it was given.
//
// The structural floor (observe/answer-parity-check.fk) counts what an answer
// mentions: axes, receipt paths, an admitted limit. It cannot tell a number the
// body measured from a number the voice invented, and it cannot see an answer
// saying the same thing three times. Both are exactly countable, so the body
// counts them itself.
//
// Every maximal digit run is a number, thousands separators read through. A
// number the answer states that its packet does not contain was not given to
// it; that is the one unfaithfulness no phrasing can excuse. Two shares read
// together say more than either alone: grounded is how much of what the answer
// says was given to it, used is how much of what it was given the answer reached
// for — faithful and narrow is a different shortfall than broad and invented.
// Repetition is the distinct share of an answer's non-empty lines. Neither is a verdict — a count
// is attention — and felt resonance is still the person's to read.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml observe/answer-parity-check.fk
section [form.bml] {
 class FormCliVoiceQuality {
  def vq-digit?(b) = and(ge(b,48),le(b,57));
  def vq-at(text,i) = str_byte_at(text,i);
  def vq-digit-at?(text,i) = and(lt(i,str_len(text)),vq-digit?(vq-at(text,i)));
  // a run ends at the first byte that is neither a digit nor a separator standing between digits
  def vq-run-end(text,i) = if vq-digit-at?(text,i) then vq-run-end(text,add(i,1)) else if and(and(lt(i,str_len(text)),eq(vq-at(text,i),44)),vq-digit-at?(text,add(i,1))) then vq-run-end(text,add(i,1)) else i;
  def vq-strip(text,i,stop,acc) = if ge(i,stop) then acc else vq-strip(text,add(i,1),stop,if eq(vq-at(text,i),44) then acc else str_concat(acc,substring(text,i,add(i,1))));
  def vq-first-digit(text,i) = if ge(i,str_len(text)) then -1 else if vq-digit?(vq-at(text,i)) then i else vq-first-digit(text,add(i,1));
  def vq-numbers(text) = vq-numbers-go(text,0,list());
  def vq-numbers-go(text,from,acc) {
   let at = vq-first-digit(text,from);
   if lt(at,0) then acc else vq-numbers-at(text,at,acc,vq-run-end(text,at));
  }
  def vq-numbers-at(text,at,acc,stop) = vq-numbers-go(text,stop,cons(vq-strip(text,at,stop,""),acc));
  def vq-member?(xs,x) = if nil?(xs) then 0 else if str_eq(head(xs),x) then 1 else vq-member?(tail(xs),x);
  def vq-distinct(xs) = vq-distinct-go(xs,list());
  def vq-distinct-go(xs,seen) = if nil?(xs) then seen else vq-distinct-go(tail(xs),if eq(vq-member?(seen,head(xs)),1) then seen else cons(head(xs),seen));
  def vq-in-pool(xs,pool) = if nil?(xs) then 0 else add(vq-member?(pool,head(xs)),vq-in-pool(tail(xs),pool));
  def vq-absent(xs,pool) = if nil?(xs) then list() else if eq(vq-member?(pool,head(xs)),1) then vq-absent(tail(xs),pool) else cons(head(xs),vq-absent(tail(xs),pool));
  def vq-take(xs,n) = if or(nil?(xs),le(n,0)) then list() else cons(head(xs),vq-take(tail(xs),sub(n,1)));
  def vq-strings(xs) = if nil?(xs) then list() else cons(json-node-string(head(xs)),vq-strings(tail(xs)));
  def vq-live-lines(xs) = if nil?(xs) then list() else if str_eq(trim(head(xs)),"") then vq-live-lines(tail(xs)) else cons(trim(head(xs)),vq-live-lines(tail(xs)));
  def vq-lines(text) = vq-live-lines(split-on(text,"\n"));
  def vq-share(part,whole) = if le(whole,0) then 0 else div(mul(part,100),whole);
  // Answers one reading. A packet that was not retained leaves the fidelity
  // fields at -1: not measured is not the same as nothing invented.
  def vq-reading(name,answerPath,packetPath) {
   let answer = fhn-read(answerPath);
   let packet = if str_eq(packetPath,"") then "" else fhn-read(packetPath);
   let given = not(str_eq(packet,""));
   let stated = vq-distinct(vq-numbers(answer));
   let pool = if given then vq-numbers(packet) else list();
   let grounded = if given then vq-in-pool(stated,pool) else 0;
   let invented = if given then vq-absent(stated,pool) else list();
   let offered = if given then vq-distinct(pool) else list();
   let used = if given then vq-in-pool(offered,stated) else 0;
   let lines = vq-lines(answer);
   let distinct = vq-distinct(lines);
   let floor = apc-floor(answer);
   json-node-object(list(
    fhn-n("at_unix_ms",now_unix_ms()),
    fhn-s("answer",name),
    fhn-s("answer_path",answerPath),
    fhn-s("packet",packetPath),
    fhn-n("bytes",str_len(answer)),
    fhn-n("axes_named",nth(floor,0)),
    fhn-n("axes_of",9),
    fhn-n("receipts_cited",nth(floor,1)),
    fhn-n("receipts_existing",nth(floor,2)),
    fhn-n("limits_named",nth(floor,3)),
    fhn-n("lines",len(lines)),
    fhn-n("lines_distinct",len(distinct)),
    fhn-n("distinct_share",vq-share(len(distinct),len(lines))),
    fhn-n("numbers_stated",len(stated)),
    fhn-n("numbers_grounded",if given then grounded else sub(0,1)),
    fhn-n("numbers_invented",if given then len(invented) else sub(0,1)),
    fhn-n("grounded_share",if given then vq-share(grounded,len(stated)) else sub(0,1)),
    fhn-n("numbers_offered",if given then len(offered) else sub(0,1)),
    fhn-n("numbers_used",if given then used else sub(0,1)),
    fhn-n("used_share",if given then vq-share(used,len(offered)) else sub(0,1)),
    json-node-pair("invented",json-node-array(vq-strings(vq-take(invented,12))))));
  }
 }
}
