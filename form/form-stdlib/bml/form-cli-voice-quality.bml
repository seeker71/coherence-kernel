// Text overlap and structural observations for an answer and its source packet.
// Digit runs ignore signs, decimal points, units and claim relationships;
// commas between digits are removed. Matching runs establish lexical overlap.
// An absent run may be a valid calculation, and a matching run may belong to
// a false claim. Distinct lines count exact trimmed lines, not paraphrases.
// Claim support, relevance, answer quality and felt resonance stay unmeasured.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml observe/answer-parity-check.fk
section [form.bml] {
 class FormCliVoiceQuality {
  def vq-digit?(b) = and(ge(b,48),le(b,57));
  def vq-at(text,i) = str_byte_at(text,i);
  def vq-digit-at?(text,i) = and(lt(i,str_len(text)),vq-digit?(vq-at(text,i)));
  // a run ends at the first byte that is neither a digit nor a separator standing between digits
  def vq-run-end(text,i) = if vq-digit-at?(text,i) then vq-run-end(text,add(i,1)) else if and(and(lt(i,str_len(text)),eq(vq-at(text,i),44)),vq-digit-at?(text,add(i,1))) then vq-run-end(text,add(i,1)) else i;
  def vq-strip(text,i,stop,acc) = if ge(i,stop) then acc else vq-strip(text,add(i,1),stop,if eq(vq-at(text,i),44) then acc else str_concat(acc,substring(text,i,add(i,1))));
  def vq-first-digit(text,i) = if ge(i,str_len(text)) then -1 else if vq-digit?(vq-at(text,i)) then i else vq-first-digit(text,add(i,1));
  def vq-numbers(text) = vq-numbers-go(text,0,list());
  def vq-numbers-go(text,from,acc) {
   let at = vq-first-digit(text,from);
   if lt(at,0) then acc else vq-numbers-at(text,at,acc,vq-run-end(text,at));
  }
  def vq-numbers-at(text,at,acc,stop) = vq-numbers-go(text,stop,cons(vq-strip(text,at,stop,""),acc));
  def vq-member?(xs,x) = if nil?(xs) then 0 else if str_eq(head(xs),x) then 1 else vq-member?(tail(xs),x);
  def vq-distinct(xs) = vq-distinct-go(xs,list());
  def vq-distinct-go(xs,seen) = if nil?(xs) then seen else vq-distinct-go(tail(xs),if eq(vq-member?(seen,head(xs)),1) then seen else cons(head(xs),seen));
  def vq-in-pool(xs,pool) = if nil?(xs) then 0 else add(vq-member?(pool,head(xs)),vq-in-pool(tail(xs),pool));
  def vq-absent(xs,pool) = if nil?(xs) then list() else if eq(vq-member?(pool,head(xs)),1) then vq-absent(tail(xs),pool) else cons(head(xs),vq-absent(tail(xs),pool));
  def vq-take(xs,n) = if or(nil?(xs),le(n,0)) then list() else cons(head(xs),vq-take(tail(xs),sub(n,1)));
  def vq-strings(xs) = if nil?(xs) then list() else cons(json-node-string(head(xs)),vq-strings(tail(xs)));
  def vq-live-lines(xs) = if nil?(xs) then list() else if str_eq(trim(head(xs)),"") then vq-live-lines(tail(xs)) else cons(trim(head(xs)),vq-live-lines(tail(xs)));
  def vq-lines(text) = vq-live-lines(split-on(text,"\n"));
  def vq-count(key,n,present) = json-node-pair(key,if present then json-node-int(n) else json-node-null());
  def vq-share(key,part,whole,present) = json-node-pair(key,if or(not(present),le(whole,0)) then json-node-null() else json-node-int(div(mul(part,100),whole)));
  // Missing files and empty files remain distinct. A zero denominator has
  // no percentage; null carries that absence without inventing a verdict.
  def vq-reading(name,answerPath,packetPath) {
   let answerRead = read_file(answerPath);
   let packetRead = if str_eq(packetPath,"") then nothing() else read_file(packetPath);
   let answerPresent = not(nothing?(answerRead));
   let packetPresent = not(nothing?(packetRead));
   let answer = if answerPresent then answerRead else "";
   let packet = if packetPresent then packetRead else "";
   let given = and(answerPresent,packetPresent);
   let stated = vq-distinct(vq-numbers(answer));
   let pool = if packetPresent then vq-numbers(packet) else list();
   let matched = if given then vq-in-pool(stated,pool) else 0;
   let absent = if given then vq-absent(stated,pool) else list();
   let offered = vq-distinct(pool);
   let used = if given then vq-in-pool(offered,stated) else 0;
   let lines = vq-lines(answer);
   let distinct = vq-distinct(lines);
   let floor = apc-floor(answer);
   json-node-object(list(
    fhn-s("schema","form-voice-text-overlap-v2"),
    fhn-s("scope","distinct digit-run overlap and exact trimmed-line repetition; no claim verification"),
    json-node-pair("claim_support",json-node-null()),
    fhn-n("at_unix_ms",now_unix_ms()),
    fhn-s("answer",name),
    fhn-s("answer_path",answerPath),
    fhn-s("packet",packetPath),
    fhn-n("answer_present",answerPresent),
    fhn-n("packet_present",packetPresent),
    vq-count("bytes",str_len(answer),answerPresent),
    vq-count("axes_named",nth(floor,0),answerPresent),
    fhn-n("axes_of",9),
    vq-count("receipts_cited",nth(floor,1),answerPresent),
    vq-count("receipts_existing",nth(floor,2),answerPresent),
    vq-count("limits_named",nth(floor,3),answerPresent),
    vq-count("lines",len(lines),answerPresent),
    vq-count("lines_distinct",len(distinct),answerPresent),
    vq-share("distinct_line_percent",len(distinct),len(lines),answerPresent),
    vq-count("answer_digit_runs",len(stated),answerPresent),
    vq-count("answer_digit_runs_in_packet",matched,given),
    vq-count("answer_digit_runs_absent_from_packet",len(absent),given),
    vq-share("answer_digit_overlap_percent",matched,len(stated),given),
    vq-count("packet_digit_runs",len(offered),packetPresent),
    vq-count("packet_digit_runs_in_answer",used,given),
    vq-share("packet_digit_coverage_percent",used,len(offered),given),
    json-node-pair("absent_digit_runs",if given then json-node-array(vq-strings(vq-take(absent,12))) else json-node-null())));
  }
 }
}
