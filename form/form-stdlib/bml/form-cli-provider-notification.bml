// Correlated App Server usage snapshots. No provider execution or file writes.
// Authority: installed ThreadTokenUsageUpdatedNotification JSON schema.
// preludes: form-stdlib/bml/form-cli-remote-token-evidence.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 class FormProviderNotification {
  def fpn-str(node,key) = frte-json-string-field(node,key);
  def fpn-num(node,key) = json-int-value(json-object-get(node,key));
  def fpn-int(node,key) = frte-json-nonnegative-int-field?(node,key);
  // The reader offers its field roles to callers preparing native context.
  // This is the intended contract; implementation and answer quality still need observation.
  def fpn-contract() = json-node-object(list(
   json-node-pair("schema",json-node-string("form-provider-usage-contract-v1")),
   json-node-pair("correlation",json-node-string("The caller selects one nonempty thread ID and turn ID. Events for other identities leave that selected reading unchanged. Empty caller identity means unobserved correlation, not a valid wildcard.")),
   json-node-pair("total",json-node-string("Cumulative thread usage. A present cumulative quantity retains its cumulative meaning across notifications.")),
   json-node-pair("last",json-node-string("Usage of the most recent model call, not another cumulative counter. Successive calls may have different sizes; decreasing last usage alone is not a cumulative regression.")),
   json-node-pair("input_partition",json-node-string("This reader defines uncached input as reported inputTokens minus reported cachedInputTokens. The latter is a subset of the former.")),
   json-node-pair("cache_writes",json-node-string("Report the optional cacheWriteInputTokens quantity separately. Its presence alone supplies no additive price rule or instruction to subtract it from uncached input. A missing quantity stays unknown.")),
   json-node-pair("cache_write_input_relation",json-node-null()),
   json-node-pair("relation_scope",json-node-string("Only supplied relations support a contract defect. A null relation is absent from this contract; it neither asserts nor denies a possible provider relationship. An additional relation needs evidence before a reader can be called defective for not checking it. A hypothetical downstream interpretation does not supply that evidence.")),
   json-node-pair("scope",json-node-string("Reported token volume is not monetary cost. A cumulative snapshot is an observed prefix; notification count is not model-call count. Structural checks establish their covered cases."))));
  def fpn-fields(node,keys) = nil?(keys) ? 1 : (fpn-int(node,head(keys)) && fpn-fields(node,tail(keys)));
  def fpn-valid-usage(node) = fpn-fields(node,list("inputTokens","cachedInputTokens","outputTokens","reasoningOutputTokens","totalTokens")) && ((fpn-num(node,"cachedInputTokens") <= fpn-num(node,"inputTokens")) && ((fpn-num(node,"reasoningOutputTokens") <= fpn-num(node,"outputTokens")) && ((fpn-num(node,"totalTokens") >= (fpn-num(node,"inputTokens") + fpn-num(node,"outputTokens"))) && (json-object-has?(node,"cacheWriteInputTokens") ? fpn-int(node,"cacheWriteInputTokens") : 1))));
  def fpn-empty(thread,turn) = list(thread,turn,0,json-node-null(),"unobserved",nothing());
  def fpn-write-floor(state) = len(state) > 5 ? state[5] : fpn-int(state[3],"cacheWriteInputTokens") ? fpn-num(state[3],"cacheWriteInputTokens") : nothing();
  def fpn-fail(state,reason) = list(state[0],state[1],state[2],state[3],reason,fpn-write-floor(state));
  def fpn-writes-regressed(state,total) = nothing?(fpn-write-floor(state)) || (!fpn-int(total,"cacheWriteInputTokens")) ? 0 : (fpn-num(total,"cacheWriteInputTokens") < fpn-write-floor(state));
  def fpn-monotone(old,next,keys) = nil?(keys) ? 1 : ((fpn-num(next,head(keys)) >= fpn-num(old,head(keys))) && fpn-monotone(old,next,tail(keys)));
  def fpn-event(state,row) {
   let params = frte-json-object-field(row,"params");
   !((String) fpn-str(row,"method") == "thread/tokenUsage/updated") ? state
   : ((String) state[0] == "") || ((String) state[1] == "") ? fpn-fail(state,"missing-correlation")
   : !(((String) fpn-str(params,"threadId") == state[0]) && ((String) fpn-str(params,"turnId") == state[1])) ? state
   : fpn-usage(state,frte-json-object-field(params,"tokenUsage"));
  }
  def fpn-usage(state,usage) {
   let total = frte-json-object-field(usage,"total"); let last = frte-json-object-field(usage,"last");
   !(fpn-valid-usage(total) && fpn-valid-usage(last)) ? fpn-fail(state,"invalid-usage-snapshot")
   : (state[2] > 0) && (fpn-writes-regressed(state,total) || (!fpn-monotone(state[3],total,list("inputTokens","cachedInputTokens","outputTokens","reasoningOutputTokens","totalTokens")))) ? fpn-fail(state,"cumulative-usage-regressed")
   : !(((String) state[4] == "unobserved") || ((String) state[4] == "observed-prefix")) ? state
   : list(state[0],state[1],state[2] + 1,total,"observed-prefix",fpn-int(total,"cacheWriteInputTokens") ? fpn-num(total,"cacheWriteInputTokens") : fpn-write-floor(state));
  }
  def fpn-line(state,line) = str_len(line) > 2097152 ? fpn-fail(state,"oversized-row") : !jwa-valid(line) ? fpn-fail(state,"invalid-json") : fpn-event(state,parse-json("provider-notification",line));
  def fpn-lines(state,bytes,at) {
   let end = str_find(bytes,"\n",at);
   end < 0 ? list(state,substring(bytes,at,str_len(bytes))) : fpn-lines(fpn-line(state,substring(bytes,at,end)),bytes,end + 1);
  }
  def fpn-file(path,size,offset,pending,state) {
   offset >= size ? ((String) pending == "" ? state : fpn-fail(state,"unfinished-json-row"))
   : fpn-slice(path,size,offset,pending,state,read_file_slice(path,offset,min2(65536,size - offset)));
  }
  def fpn-slice(path,size,offset,pending,state,bytes) {
   nothing?(bytes) || ((Comparable) str_len(bytes) == 0) ? fpn-fail(fpn-empty(state[0],state[1]),"source-read-failed")
   : fpn-file-next(path,size,offset + str_len(bytes),fpn-lines(state,pending ++ bytes,0));
  }
  def fpn-file-next(path,size,offset,result) = str_len(result[1]) > 2097152 ? fpn-fail(head(result),"oversized-row") : fpn-file(path,size,offset,result[1],head(result));
  def fpn-read(path,thread,turn) {
   let size = file_size(path);
   let state = size < 0 ? fpn-fail(fpn-empty(thread,turn),"source-unavailable") : fpn-file(path,size,0,"",fpn-empty(thread,turn));
   let stable = file_size(path) < size ? fpn-fail(fpn-empty(thread,turn),"source-shrank") : state;
   json-node-object(list(json-node-pair("source",json-node-string(path)),json-node-pair("source_prefix_bytes",json-node-int(size)),json-node-pair("usage",fpn-report(stable))));
  }
  def fpn-quantity(state,key) = (state[2] > 0) && fpn-int(state[3],key) ? json-node-int(fpn-num(state[3],key)) : json-node-null();
  def fpn-report(state) {
   let total = state[3]; let seen = state[2] > 0;
   json-node-object(list(json-node-pair("schema",json-node-string("form-provider-usage-snapshot-v1")),json-node-pair("status",json-node-string(state[4])),json-node-pair("thread_id",json-node-string(state[0])),json-node-pair("turn_id",json-node-string(state[1])),json-node-pair("scope",json-node-string("latest validated cumulative thread usage reported during the correlated turn;unfinished and unreported work excluded")),json-node-pair("usage_notifications",json-node-int(state[2])),json-node-pair("model_calls",json-node-null()),json-node-pair("whole_session_tokens",json-node-null()),json-node-pair("input_tokens",fpn-quantity(state,"inputTokens")),json-node-pair("cached_input_tokens",fpn-quantity(state,"cachedInputTokens")),json-node-pair("uncached_input_tokens",seen ? json-node-int(fpn-num(total,"inputTokens") - fpn-num(total,"cachedInputTokens")) : json-node-null()),json-node-pair("cache_write_input_tokens",fpn-quantity(state,"cacheWriteInputTokens")),json-node-pair("output_tokens",fpn-quantity(state,"outputTokens")),json-node-pair("reasoning_output_tokens",fpn-quantity(state,"reasoningOutputTokens")),json-node-pair("total_tokens",fpn-quantity(state,"totalTokens")),json-node-pair("unattributed_tokens",seen ? json-node-int(fpn-num(total,"totalTokens") - (fpn-num(total,"inputTokens") + fpn-num(total,"outputTokens"))) : json-node-null()),json-node-pair("unobserved_remainder",json-node-int(1)),json-node-pair("aggregation",json-node-string("replace cumulative snapshot;never sum snapshots or count notifications as model calls"))));
  }
 }
 0;
}
