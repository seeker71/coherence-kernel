// Correlated App Server usage snapshots. No provider execution or file writes.
// Authority: installed ThreadTokenUsageUpdatedNotification JSON schema.
// preludes: form-stdlib/bml/form-cli-remote-token-evidence.bml form-stdlib/bml/json-wire-admission.bml
section [form.bml] {
 class FormProviderNotification {
  def fpn-str(node,key) = frte-json-string-field(node,key);
  def fpn-num(node,key) = json-int-value(json-object-get(node,key));
  def fpn-int(node,key) = frte-json-nonnegative-int-field?(node,key);
  def fpn-fields(node,keys) = if nil?(keys) then 1 else and(fpn-int(node,head(keys)),fpn-fields(node,tail(keys)));
  def fpn-valid-usage(node) = and(fpn-fields(node,list("inputTokens","cachedInputTokens","outputTokens","reasoningOutputTokens","totalTokens")),and(le(fpn-num(node,"cachedInputTokens"),fpn-num(node,"inputTokens")),and(le(fpn-num(node,"reasoningOutputTokens"),fpn-num(node,"outputTokens")),and(ge(fpn-num(node,"totalTokens"),add(fpn-num(node,"inputTokens"),fpn-num(node,"outputTokens"))),if json-object-has?(node,"cacheWriteInputTokens") then fpn-int(node,"cacheWriteInputTokens") else 1))));
  def fpn-empty(thread,turn) = list(thread,turn,0,json-node-null(),"unobserved",nothing());
  def fpn-write-floor(state) = if gt(len(state),5) then nth(state,5) else if fpn-int(nth(state,3),"cacheWriteInputTokens") then fpn-num(nth(state,3),"cacheWriteInputTokens") else nothing();
  def fpn-fail(state,reason) = list(nth(state,0),nth(state,1),nth(state,2),nth(state,3),reason,fpn-write-floor(state));
  def fpn-writes-regressed(state,total) = if or(nothing?(fpn-write-floor(state)),not(fpn-int(total,"cacheWriteInputTokens"))) then 0 else lt(fpn-num(total,"cacheWriteInputTokens"),fpn-write-floor(state));
  def fpn-monotone(old,next,keys) = if nil?(keys) then 1 else and(ge(fpn-num(next,head(keys)),fpn-num(old,head(keys))),fpn-monotone(old,next,tail(keys)));
  def fpn-event(state,row) {
   let params = frte-json-object-field(row,"params");
   if not(str_eq(fpn-str(row,"method"),"thread/tokenUsage/updated")) then state
   else if or(str_eq(nth(state,0),""),str_eq(nth(state,1),"")) then fpn-fail(state,"missing-correlation")
   else if not(and(str_eq(fpn-str(params,"threadId"),nth(state,0)),str_eq(fpn-str(params,"turnId"),nth(state,1)))) then state
   else fpn-usage(state,frte-json-object-field(params,"tokenUsage"));
  }
  def fpn-usage(state,usage) {
   let total = frte-json-object-field(usage,"total"); let last = frte-json-object-field(usage,"last");
   if not(and(fpn-valid-usage(total),fpn-valid-usage(last))) then fpn-fail(state,"invalid-usage-snapshot")
   else if and(gt(nth(state,2),0),or(fpn-writes-regressed(state,total),not(fpn-monotone(nth(state,3),total,list("inputTokens","cachedInputTokens","outputTokens","reasoningOutputTokens","totalTokens"))))) then fpn-fail(state,"cumulative-usage-regressed")
   else if not(or(str_eq(nth(state,4),"unobserved"),str_eq(nth(state,4),"observed-prefix"))) then state
   else list(nth(state,0),nth(state,1),add(nth(state,2),1),total,"observed-prefix",if fpn-int(total,"cacheWriteInputTokens") then fpn-num(total,"cacheWriteInputTokens") else fpn-write-floor(state));
  }
  def fpn-line(state,line) = if gt(str_len(line),2097152) then fpn-fail(state,"oversized-row") else if not(jwa-valid(line)) then fpn-fail(state,"invalid-json") else fpn-event(state,parse-json("provider-notification",line));
  def fpn-lines(state,bytes,at) {
   let end = str_find(bytes,"\n",at);
   if lt(end,0) then list(state,substring(bytes,at,str_len(bytes))) else fpn-lines(fpn-line(state,substring(bytes,at,end)),bytes,add(end,1));
  }
  def fpn-file(path,size,offset,pending,state) {
   if ge(offset,size) then if str_eq(pending,"") then state else fpn-fail(state,"unfinished-json-row")
   else fpn-slice(path,size,offset,pending,state,read_file_slice(path,offset,min2(65536,sub(size,offset))));
  }
  def fpn-slice(path,size,offset,pending,state,bytes) {
   if or(nothing?(bytes),eq(str_len(bytes),0)) then fpn-fail(fpn-empty(nth(state,0),nth(state,1)),"source-read-failed")
   else fpn-file-next(path,size,add(offset,str_len(bytes)),fpn-lines(state,str_concat(pending,bytes),0));
  }
  def fpn-file-next(path,size,offset,result) = if gt(str_len(nth(result,1)),2097152) then fpn-fail(head(result),"oversized-row") else fpn-file(path,size,offset,nth(result,1),head(result));
  def fpn-read(path,thread,turn) {
   let size = file_size(path);
   let state = if lt(size,0) then fpn-fail(fpn-empty(thread,turn),"source-unavailable") else fpn-file(path,size,0,"",fpn-empty(thread,turn));
   let stable = if lt(file_size(path),size) then fpn-fail(fpn-empty(thread,turn),"source-shrank") else state;
   json-node-object(list(json-node-pair("source",json-node-string(path)),json-node-pair("source_prefix_bytes",json-node-int(size)),json-node-pair("usage",fpn-report(stable))));
  }
  def fpn-quantity(state,key) = if and(gt(nth(state,2),0),fpn-int(nth(state,3),key)) then json-node-int(fpn-num(nth(state,3),key)) else json-node-null();
  def fpn-report(state) {
   let total = nth(state,3); let seen = gt(nth(state,2),0);
   json-node-object(list(json-node-pair("schema",json-node-string("form-provider-usage-snapshot-v1")),json-node-pair("status",json-node-string(nth(state,4))),json-node-pair("thread_id",json-node-string(nth(state,0))),json-node-pair("turn_id",json-node-string(nth(state,1))),json-node-pair("scope",json-node-string("latest validated cumulative thread usage reported during the correlated turn;unfinished and unreported work excluded")),json-node-pair("usage_notifications",json-node-int(nth(state,2))),json-node-pair("model_calls",json-node-null()),json-node-pair("whole_session_tokens",json-node-null()),json-node-pair("input_tokens",fpn-quantity(state,"inputTokens")),json-node-pair("cached_input_tokens",fpn-quantity(state,"cachedInputTokens")),json-node-pair("uncached_input_tokens",if seen then json-node-int(sub(fpn-num(total,"inputTokens"),fpn-num(total,"cachedInputTokens"))) else json-node-null()),json-node-pair("cache_write_input_tokens",fpn-quantity(state,"cacheWriteInputTokens")),json-node-pair("output_tokens",fpn-quantity(state,"outputTokens")),json-node-pair("reasoning_output_tokens",fpn-quantity(state,"reasoningOutputTokens")),json-node-pair("total_tokens",fpn-quantity(state,"totalTokens")),json-node-pair("unattributed_tokens",if seen then json-node-int(sub(fpn-num(total,"totalTokens"),add(fpn-num(total,"inputTokens"),fpn-num(total,"outputTokens")))) else json-node-null()),json-node-pair("unobserved_remainder",json-node-int(1)),json-node-pair("aggregation",json-node-string("replace cumulative snapshot;never sum snapshots or count notifications as model calls"))));
  }
 }
 0;
}
