// One selected quantity per route. Its scope and evidence travel with the value.
// Broader model totals come from the native provider-usage reader; missing is null.
// preludes: form-stdlib/bml/form-cli-provider-model-usage.bml
section [form.bml] {
 class FormCliScopedUsage {
  def fsu-text(row,key) = json-string-value(json-object-get(row,key));
  def fsu-number(row,key) { let n = pmu-number(row,key); if nothing?(n) then json-node-null() else json-node-int(n); }
  def fsu-broader-valid(row) {
   let values = list(pmu-number(row,"total_tokens"),pmu-number(row,"input_tokens"),pmu-number(row,"cached_input_tokens"),pmu-number(row,"uncached_input_tokens"),pmu-number(row,"output_tokens"),pmu-number(row,"model_count"));
   if not(pmu-known?(values)) then 0 else and(str_eq(fsu-text(row,"status"),"observed"),and(gt(nth(values,5),0),and(eq(head(values),add(nth(values,1),nth(values,4))),eq(nth(values,1),add(nth(values,2),nth(values,3))))));
  }
  def fsu-select(recorded,reported) {
   let broad = fsu-broader-valid(reported);
   let scope = if broad then fsu-text(reported,"scope") else fsu-text(recorded,"usage_scope");
   let value = if broad then pmu-number(reported,"total_tokens") else pmu-number(recorded,"rent_tokens");
   let observed = and(not(nothing?(value)),gt(str_len(scope),0));
   json-node-object(list(pmu-s("status",if observed then "observed" else "unobserved"),json-node-pair("tokens",if observed then json-node-int(value) else json-node-null()),pmu-s("basis",if not(observed) then "unobserved" else if broad then "all-reported-models" else "recorded-scope"),pmu-s("scope",if observed then scope else "quantity or its scope unavailable"),pmu-s("evidence",if broad then fsu-text(recorded,"usage_evidence") else fsu-text(recorded,"evidence")),pmu-s("broader_usage",if broad then "observed" else if str_eq(fsu-text(reported,"status"),"observed") then "reported-counters-invalid" else "unobserved"),json-node-pair("input_tokens",if broad then fsu-number(reported,"input_tokens") else json-node-null()),json-node-pair("cached_input_tokens",if broad then fsu-number(reported,"cached_input_tokens") else json-node-null()),json-node-pair("uncached_input_tokens",if broad then fsu-number(reported,"uncached_input_tokens") else json-node-null()),json-node-pair("output_tokens",if broad then fsu-number(reported,"output_tokens") else json-node-null())));
  }
  def fsu-row(pair) {
   let r = json-object-get(pair,"recorded_route");
   json-node-object(list(pmu-s("route",fsu-text(r,"movement")),pmu-s("measured",fsu-text(r,"measured")),pmu-s("note",fsu-text(r,"note")),json-node-pair("token_usage",fsu-select(r,json-object-get(pair,"all_reported_model_usage"))),json-node-pair("calls",json-node-object(list(json-node-pair("non_form",fsu-number(r,"non_form_calls")),json-node-pair("provider",fsu-number(r,"provider_calls")),json-node-pair("host",fsu-number(r,"host_calls")),pmu-s("scope",fsu-text(r,"crossing_scope")),pmu-s("evidence",fsu-text(r,"evidence")))))));
  }
  def fsu-rows(rows) = if nil?(rows) then list() else cons(fsu-row(head(rows)),fsu-rows(tail(rows)));
 }
}
