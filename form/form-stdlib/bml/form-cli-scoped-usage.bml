// One selected quantity per route. Its scope and evidence travel with the value.
// Broader model totals come from the native provider-usage reader; missing is null.
// preludes: form-stdlib/bml/form-cli-provider-model-usage.bml
section [form.bml] {
 class FormCliScopedUsage {
  def fsu-text(row,key) = json-string-value(json-object-get(row,key));
  def fsu-number(row,key) { let n = pmu-number(row,key); nothing?(n) ? json-node-null() : json-node-int(n); }
  def fsu-broader-valid(row) {
   let values = list(pmu-number(row,"total_tokens"),pmu-number(row,"input_tokens"),pmu-number(row,"cached_input_tokens"),pmu-number(row,"uncached_input_tokens"),pmu-number(row,"output_tokens"),pmu-number(row,"model_count"));
   !pmu-known?(values) ? 0 : (((String) fsu-text(row,"status") == "observed") && ((values[5] > 0) && (((Comparable) head(values) == (values[1] + values[4])) && ((Comparable) values[1] == (values[2] + values[3])))));
  }
  def fsu-select(recorded,reported) {
   let broad = fsu-broader-valid(reported);
   let scope = broad ? fsu-text(reported,"scope") : fsu-text(recorded,"usage_scope");
   let value = broad ? pmu-number(reported,"total_tokens") : pmu-number(recorded,"rent_tokens");
   let observed = (!nothing?(value)) && (str_len(scope) > 0);
   json-node-object(list(pmu-s("status",observed ? "observed" : "unobserved"),json-node-pair("tokens",observed ? json-node-int(value) : json-node-null()),pmu-s("basis",!observed ? "unobserved" : broad ? "all-reported-models" : "recorded-scope"),pmu-s("scope",observed ? scope : "quantity or its scope unavailable"),pmu-s("evidence",broad ? fsu-text(recorded,"usage_evidence") : fsu-text(recorded,"evidence")),pmu-s("broader_usage",broad ? "observed" : (String) fsu-text(reported,"status") == "observed" ? "reported-counters-invalid" : "unobserved"),json-node-pair("input_tokens",broad ? fsu-number(reported,"input_tokens") : json-node-null()),json-node-pair("cached_input_tokens",broad ? fsu-number(reported,"cached_input_tokens") : json-node-null()),json-node-pair("uncached_input_tokens",broad ? fsu-number(reported,"uncached_input_tokens") : json-node-null()),json-node-pair("output_tokens",broad ? fsu-number(reported,"output_tokens") : json-node-null())));
  }
  def fsu-row(pair) {
   let r = json-object-get(pair,"recorded_route");
   json-node-object(list(pmu-s("route",fsu-text(r,"movement")),pmu-s("measured",fsu-text(r,"measured")),pmu-s("note",fsu-text(r,"note")),json-node-pair("token_usage",fsu-select(r,json-object-get(pair,"all_reported_model_usage"))),json-node-pair("calls",json-node-object(list(json-node-pair("non_form",fsu-number(r,"non_form_calls")),json-node-pair("provider",fsu-number(r,"provider_calls")),json-node-pair("host",fsu-number(r,"host_calls")),pmu-s("scope",fsu-text(r,"crossing_scope")),pmu-s("evidence",fsu-text(r,"evidence")))))));
  }
  def fsu-rows(rows) = rows |> map(fsu-row);
 }
}
