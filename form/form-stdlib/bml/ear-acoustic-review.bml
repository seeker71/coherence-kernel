// One bounded second acoustic view at a doubtful close. No teacher, no text
// completion, no new threshold: both readings must agree on text and language.
// preludes: form/form-stdlib/ear-native.fk form/form-stdlib/bml/ear-listening.bml form/form-stdlib/line-grammar.fk observe/bidirectional-framebuffer-channel.fk
section [form.bml] {
 class EarAcousticReview {
  field EarWordTrustMilli = -1500;
  // Shared by the live pass and its review, so tags and loops cannot acquire
  // a different meaning merely by taking the second door.
  def el-detag-go(s, i, n, depth, acc) = i >= n ? acc : el-detag-byte(s, i, n, depth, acc, str_byte_at(s, i));
  def el-detag-byte(s, i, n, depth, acc, c) = ((Comparable) c == 40) || ((Comparable) c == 91) ? el-detag-go(s, i + 1, n, depth + 1, acc) : ((Comparable) c == 41) || ((Comparable) c == 93) ? el-detag-go(s, i + 1, n, elp-max(0, depth - 1), acc) : el-detag-go(s, i + 1, n, depth, depth > 0 ? acc : acc ++ byte_to_str(c));
  def el-note?(s, i, n) = ((i + 2) < n) && (((Comparable) str_byte_at(s, i) == 226) && (((Comparable) str_byte_at(s, i + 1) == 153) && (((Comparable) str_byte_at(s, i + 2) == 170) || ((Comparable) str_byte_at(s, i + 2) == 171))));
  def el-note-go(s, i, n, acc) = i >= n ? acc : el-note?(s, i, n) ? el-note-go(s, i + 3, n, acc) : el-note-go(s, i + 1, n, acc ++ byte_to_str(str_byte_at(s, i)));
  def el-detag(s) {
   let a = el-detag-go(s, 0, str_len(s), 0, "");
   trim(el-note-go(a, 0, str_len(a), ""));
  }
  def el-mark?(s, i, n) = el-note?(s, i, n) || (((i + 2) < n) && (((Comparable) str_byte_at(s, i) == 226) && (((Comparable) str_byte_at(s, i + 1) == 128) && ((Comparable) str_byte_at(s, i + 2) == 166))));
  def el-letter?(c) = ((c >= 65) && (c <= 90)) || (((c >= 97) && (c <= 122)) || (((c >= 48) && (c <= 57)) || (c >= 194)));
  def el-said-go(s, i, n) = i >= n ? 0 : el-mark?(s, i, n) ? el-said-go(s, i + 3, n) : el-letter?(str_byte_at(s, i)) ? 1 : el-said-go(s, i + 1, n);
  def el-has-words(s) = el-said-go(s, 0, str_len(s));
  def el-words(s) = split-on(s, " ");
  def el-join(xs) = (Comparable) len(xs) == 0 ? "" : (Comparable) len(tail(xs)) == 0 ? head(xs) : head(xs) ++ " " ++ el-join(tail(xs));
  def el-take(xs, n) = ((Comparable) n == 0) || ((Comparable) len(xs) == 0) ? list() : cons(head(xs), el-take(tail(xs), n - 1));
  def el-bare(w) = (Comparable) str_len(w) == 0 ? w : el-bare-last(w, str_byte_at(w, str_len(w) - 1));
  def el-bare-last(w, c) = ((Comparable) c == 46) || (((Comparable) c == 44) || (((Comparable) c == 63) || ((Comparable) c == 33))) ? substring(w, 0, str_len(w) - 1) : w;
  def el-span-eq(ws, width, k) = k >= width ? 1 : (String) el-bare(ws[k]) == el-bare(ws[width + k]) ? el-span-eq(ws, width, k + 1) : 0;
  def el-loop-at(ws, width) = (width > 32) || (len(ws) < (2 * width)) ? 0 : el-span-eq(ws, width, 0) && ((width > 1) || ((len(ws) >= 3) && ((String) el-bare(head(ws)) == el-bare(ws[2])))) ? width : el-loop-at(ws, width + 1);
  def el-unloop-go(ws, acc) = len(ws) < 2 ? el-join(append(acc, ws)) : el-unloop-at(ws, acc, el-loop-at(ws, 1));
  def el-unloop-at(ws, acc, width) = width > 0 ? el-join(append(acc, el-take(ws, width))) ++ " …" : el-unloop-go(tail(ws), append(acc, list(head(ws))));
  def el-unloop(s) = el-unloop-go(el-words(s), list());
  def el-trust-line() = EarWordTrustMilli();
  def eac-pack(st, r, encMs, decMs, gain) {
   let raw = el-unloop(trim(enw-heard(st, r)));
   let clean = el-detag(raw);
   list(enw-lang-code(head(r)), clean, encMs, decMs, len(r[1]), head(r), r[1], float_to_int(enw-nospeech-prob(r) * 1000.0), (String) clean == raw ? "" : raw, float_to_int(enw-line-logprob(r) * 1000.0), gain);
  }
  def eac-words?(h) = len(h) < 11 ? 0 : el-has-words(h[1]);
  def eac-credible?(h) = !eac-words?(h) ? 0 : ((h[9] >= EarWordTrustMilli()) && (h[7] <= float_to_int(enw-doubt-line() * 1000.0)));
  def eac-needs?(h) = !eac-words?(h) ? 0 : (h[9] < EarWordTrustMilli());
  def eac-agree?(a, b) = (!eac-words?(a)) || (!eac-words?(b)) ? 0 : (((String) head(a) == head(b)) && ((String) a[1] == b[1]));
  def eac-select(first, review, ms) {
   let accepted = eac-needs?(first) && (eac-credible?(review) && eac-agree?(first, review));
   list(accepted ? review : first, accepted ? "confirmed" : !eac-credible?(review) ? "uncertain" : "disagreed", ms, first[9], review[9]);
  }
  // Exclude already committed audio, including a cut inside a retained chunk.
  def eac-phrase(parts, total, cut) = enw-parts-drop(parts, elp-max(0, cut - (total - enw-parts-len(parts))));
  // Audio and gain must cover the same phrase. A finished loud phrase is not
  // context for this phrase's mel normalization or its gain estimate.
  def eac-straddles?(rows, drop) = (drop <= 0) || ((Comparable) len(rows) == 0) ? 0 : drop < head(head(rows)) ? 1 : eac-straddles?(tail(rows), drop - head(head(rows)));
  def eac-window(parts, total, cut, listening) {
   let drop = elp-max(0, cut - (total - enw-parts-len(parts)));
   let phrase = enw-parts-drop(parts, drop);
   let rows = listening[2];
   let kept = elp-meta-cut(rows, drop);
   // Whole chunks reuse their measured peaks. Only a straddling first chunk
   // needs its retained samples measured; its removed peak must not survive.
   let peaks = (len(phrase) > 0) && eac-straddles?(rows, drop) ? cons(list(str_len(head(phrase)), elp-stats(head(phrase))[1]), tail(kept)) : kept;
   list(phrase, elp-window-gain(list(head(listening), listening[1], peaks)));
  }
  def eac-tick(bytes) = elp-max(0, ELWindowBytes() - bytes) / 640;
  // The complete live open-phrase pass lives here, so physical bands exercise
  // the same cut, gain, timestamp, and unconstrained revision as the microphone.
  def eac-open(st, parts, total, cut, cap, listening) {
   let window = eac-window(parts, total, cut, listening);
   let [phrase, gain] = window;
   let t0 = now_unix_ms();
   let te = enw-encode-parts-gain(st, phrase, ELWindowBytes(), gain);
   let t1 = now_unix_ms();
   let r = enw-transcribe-from2(st, te, eac-tick(enw-parts-len(phrase)), cap, -1, elp-revision-prefix(list(), list()));
   eac-pack(st, r, t1 - t0, now_unix_ms() - t1, gain);
  }
  // The same live pass with the plain no-timestamps line: a model whose timestamp-prompted greedy
  // answers music with its one-word mark gives its words when asked without a tick.
  def eac-open-plain(st, parts, total, cut, cap, listening) {
   let window = eac-window(parts, total, cut, listening);
   let [phrase, gain] = window;
   let t0 = now_unix_ms();
   let te = enw-encode-parts-gain(st, phrase, ELWindowBytes(), gain);
   let t1 = now_unix_ms();
   let r = enw-transcribe(st, te, elp-min(136, elp-max(8, cap)));
   eac-pack(st, r, t1 - t0, now_unix_ms() - t1, gain);
  }
  // Exact trailing fill: unlike front padding, no audio will cover an overshoot.
  def eac-zero-tail(st, off, end, block) = off >= end ? off : eac-zero-write(st, off, end, block, elp-min(str_len(block), end - off));
  def eac-zero-write(st, off, end, block, bytes) {
   let wrote = metal_buf_write(enw-b(st, 0), off, (Comparable) bytes == str_len(block) ? block : substring(block, 0, bytes));
   eac-zero-tail(st, off + bytes, end, block);
  }
  def eac-encode(st, parts, gain) {
   let xs = enw-parts-drop(parts, elp-max(0, enw-parts-len(parts) - ELWindowBytes()));
   let end = enw-parts-write(st, xs, 0);
   let filled = eac-zero-tail(st, end, ELWindowBytes(), enw-zblock());
   enw-encode-at-gain(st, ELWindowBytes(), gain);
  }
  def eac-review(st, parts, cap, gain) {
   let t0 = now_unix_ms();
   let te = eac-encode(st, parts, gain);
   let t1 = now_unix_ms();
   let r = enw-transcribe(st, te, elp-min(136, elp-max(8, cap)));
   eac-pack(st, r, t1 - t0, now_unix_ms() - t1, gain);
  }
  def eac-close(st, parts, total, cut, cap, gain, first) = !eac-needs?(first) ? list(first, "", 0, 0, 0) : eac-reconsider(st, eac-phrase(parts, total, cut), cap, gain, first);
  def eac-reconsider(st, parts, cap, gain, first) = (Comparable) enw-parts-len(parts) == 0 ? list(first, "no-audio", 0, first[9], 0) : eac-attempt(st, parts, cap, gain, first);
  def eac-attempt(st, parts, cap, gain, first) {
   let t0 = now_unix_ms();
   let out = bfc-envelope(0, t0, 0, list(first[9], EarWordTrustMilli()), 0);
   let observed = bfc-record-out(out, 0);
   let measured = fb_record(intern_trivial_int(first[9]), "ear-acoustic-review:first-lp", 0);
   let control = bfc-control(out, 5);
   let received = bfc-record-in(control, 1);
   let action = bfc-apply(out, control, 0, 1);
   (Comparable) action == 1 ? eac-finish(out, first, eac-review(st, parts, cap, gain), t0) : list(first, "no-control", 0, first[9], 0);
  }
  def eac-finish(out, first, review, t0) {
   let result = eac-select(first, review, now_unix_ms() - t0);
   let measured = fb_record(intern_trivial_int(review[9]), "ear-acoustic-review:second-lp", 2);
   let observed = bfc-record-out(bfc-envelope(0, bfc-exchange(out), 0, list(first[9], review[9], eac-credible?(head(result))), 0), 2);
   result;
  }
 }
}
