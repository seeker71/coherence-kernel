// FORMBIN2 is inert wire data here. No identity is issued or evaluated.
// Numeric payloads remain eight little-endian bytes, including every int64
// value, signed zero, infinities and NaN payloads. Composite continuations
// and decoded ownership live in Form data, independent of host stack depth.
// preludes: form-stdlib/core.fk form-stdlib/bml/formbin-depth.bml form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/str-byte-at.fk form-stdlib/json.fk
section [form.bml] {
 class FormbinCodec {
  def fbc-max-bytes() = 67108864;
  def fbc-fail(reason) = list(0, "form binary: " ++ reason, list(), 0, 0);
  def fbc-ok(value, nodes, depth) = list(1, "", value, nodes, depth);
  def fbc-good(result) = (Comparable) head(result) == 1;
  def fbc-value(result) = result[2];
  def fbc-error(result) = result[1];
  def fbc-word(n) = byte_to_str((n / 16777216) % 256) ++ byte_to_str((n / 65536) % 256) ++ byte_to_str((n / 256) % 256) ++ byte_to_str(n % 256);
  def fbc-u32?(n) = (String) value-kind(n) == "int" ? ((n >= 0) && (n <= 4294967295)) : 0;
  def fbc-list?(value) = (String) value-kind(value) == "list";
  def fbc-text?(value) = (String) value-kind(value) == "string";
  // Binary carries join completed chunks of equal population. Each byte is
  // copied logarithmically while output grows; no whole-prefix append loop.
  def fbc-put(bins, text) = fbc-put-weight(bins, text, 1);
  def fbc-put-weight(bins, text, weight) = nil?(bins) ? fbd-push(list(weight, text), list()) : (Comparable) head(head(bins)) == weight ? fbc-put-weight(fbd-rest(bins), head(bins)[1] ++ text, weight * 2) : fbd-push(list(weight, text), bins);
  def fbc-finish(bins, out) = nil?(bins) ? out : fbc-finish(fbd-rest(bins), head(bins)[1] ++ out);
  // Constructors carry issued coordinates, never native NodeIDs.
  def fbc-leaf(pkg, level, type, inst) = fbc-u32?(pkg) && (fbc-u32?(level) && (fbc-u32?(type) && fbc-u32?(inst))) ? (((Comparable) level == 1) && ((Comparable) type == 2) ? nothing() : list(0, pkg, level, type, inst)) : nothing();
  def fbc-string(pkg, value) = fbc-u32?(pkg) && fbc-text?(value) ? (fbc-utf8(value, 0) ? list(4, pkg, value) : nothing()) : nothing();
  def fbc-number(tag, raw) = (((Comparable) tag == 2) || ((Comparable) tag == 3)) && fbc-text?(raw) ? ((Comparable) str_len(raw) == 8 ? list(tag, raw) : nothing()) : nothing();
  def fbc-composite(category, children) = fbc-list?(children) ? list(1, category, children) : nothing();
  def fbc-cont?(s, p) = p >= str_len(s) ? 0 : ((str_byte_at(s, p) >= 128) && (str_byte_at(s, p) <= 191));
  def fbc-utf8(s, p) = p >= str_len(s) ? 1 : fbc-utf8-byte(s, p, str_byte_at(s, p));
  def fbc-utf8-byte(s, p, b) {
   b < 128 ? fbc-utf8(s, p + 1)
   : (b >= 194) && (b <= 223) ? (fbc-cont?(s, p + 1) ? fbc-utf8(s, p + 2) : 0)
   : (b >= 224) && (b <= 239) ? (fbc-cont?(s, p + 1) && (fbc-cont?(s, p + 2) && (((Comparable) b == 224 ? (str_byte_at(s, p + 1) >= 160) : 1) && ((Comparable) b == 237 ? (str_byte_at(s, p + 1) <= 159) : 1))) ? fbc-utf8(s, p + 3) : 0)
   : (b >= 240) && (b <= 244) ? (fbc-cont?(s, p + 1) && (fbc-cont?(s, p + 2) && (fbc-cont?(s, p + 3) && (((Comparable) b == 240 ? (str_byte_at(s, p + 1) >= 144) : 1) && ((Comparable) b == 244 ? (str_byte_at(s, p + 1) <= 143) : 1)))) ? fbc-utf8(s, p + 4) : 0)
   : 0;
  }
  def fbc-decode(s) {
   nothing?(s) ? fbc-fail("unreadable artifact")
   : str_len(s) > fbc-max-bytes() ? fbc-fail("maximum artifact size exceeded")
   : !((String) substring(s, 0, 8) == "FORMBIN2") ? fbc-fail("bad magic")
   : str_len(s) < 12 ? fbc-fail("truncated u32")
   : fbd-u32(s, 8) > 262144 ? fbc-fail("maximum string count exceeded")
   : fbc-pool(s, 12, fbd-u32(s, 8), 0, list());
  }
  // File readings retain both extent observations beside the held bytes.
  // Decoding starts only when one complete, unchanged extent was read.
  def fbc-read-exact(path, maximum) = fbc-read-sized(path, file_size(path), maximum);
  def fbc-read-sized(path, before, maximum) = before < 0 ? fbc-fail("unreadable artifact") : (maximum > 0) && (before > maximum) ? fbc-fail("maximum artifact size exceeded") : fbc-read-observed(path, before, read_file(path));
  def fbc-read-observed(path, before, bytes) = fbc-read-extents(before, file_size(path), bytes);
  def fbc-read-extents(before, after, bytes) {
   let readBytes = nothing?(bytes) ? -1 : str_len(bytes);
   let evidence = "; before=" ++ int_to_str(before) ++ " after=" ++ int_to_str(after) ++ " read=" ++ int_to_str(readBytes);
   (before < 0) || ((after < 0) || nothing?(bytes)) ? fbc-fail("unreadable artifact" ++ evidence)
   : !((Comparable) before == after) ? fbc-fail("artifact extent changed during read" ++ evidence)
   : !((Comparable) readBytes == before) ? fbc-fail("incomplete artifact read" ++ evidence)
   : fbc-ok(bytes, before, after);
  }
  def fbc-load(path) = fbc-load-read(fbc-read-exact(path, fbc-max-bytes()));
  def fbc-load-read(reading) = fbc-good(reading) ? fbc-decode(fbc-value(reading)) : reading;
  def fbc-pool(s, p, left, total, strings) {
   (Comparable) left == 0 ? fbc-walk(s, fbd-start(p), reverse(strings), list())
   : (p + 4) > str_len(s) ? fbc-fail("truncated u32")
   : fbc-pool-string(s, p + 4, left, total, strings, fbd-u32(s, p));
  }
  def fbc-pool-string(s, p, left, total, strings, size) {
   (total + size) > 33554432 ? fbc-fail("maximum string bytes exceeded")
   : size > (str_len(s) - p) ? fbc-fail("truncated string")
   : !fbc-utf8(substring(s, p, p + size), 0) ? fbc-fail("invalid utf8")
   : fbc-pool(s, p + size, left - 1, total + size, cons(substring(s, p, p + size), strings));
  }
  def fbc-linked-reverse(xs, acc) = nil?(xs) ? acc : fbc-linked-reverse(fbd-rest(xs), fbd-push(head(xs), acc));
  def fbc-walk(s, state, strings, stack) {
   let step = fbd-slice(s, state, 4096);
   let next = head(step);
   fbc-walk-built(s, next, strings, fbc-rows(s, strings, fbc-linked-reverse(step[1], list()), stack));
  }
  def fbc-walk-built(s, state, strings, built) {
   !fbc-good(built) ? built
   : (Comparable) state[4] == 3 ? list(0, state[5], list(), 0, 0)
   : (Comparable) state[4] == 2 ? fbc-ok(head(fbc-value(built)), state[2], state[3])
   : fbc-walk(s, state, strings, fbc-value(built));
  }
  def fbc-rows(s, strings, rows, stack) {
   nil?(rows) ? fbc-ok(stack, 0, 0)
   : fbc-row(s, strings, head(rows), fbd-rest(rows), stack);
  }
  def fbc-row(s, strings, row, rows, stack) {
   let [tag, p] = row;
   (Comparable) tag == 1 ? fbc-row-composite(s, strings, rows, fbc-pop-children(stack, row[2], list()))
   : ((Comparable) tag == 2) || ((Comparable) tag == 3) ? fbc-rows(s, strings, rows, fbd-push(list(tag, substring(s, p + 4, p + 12)), stack))
   : fbc-row-leaf(s, strings, rows, stack, fbd-u32(s, p + 4), fbd-u32(s, p + 8), fbd-u32(s, p + 12), fbd-u32(s, p + 16));
  }
  def fbc-pop-children(stack, count, children) = (Comparable) count == 0 ? list(head(stack), children, fbd-rest(stack)) : fbc-pop-children(fbd-rest(stack), count - 1, cons(head(stack), children));
  def fbc-row-composite(s, strings, rows, parts) = fbc-rows(s, strings, rows, fbd-push(fbc-composite(head(parts), parts[1]), parts[2]));
  def fbc-row-leaf(s, strings, rows, stack, pkg, level, type, inst) {
   ((Comparable) level == 1) && ((Comparable) type == 2) ?
    (inst >= len(strings) ? fbc-fail("bad string index " ++ int_to_str(inst))
    : fbc-rows(s, strings, rows, fbd-push(list(4, pkg, strings[inst]), stack)))
   : fbc-rows(s, strings, rows, fbd-push(list(0, pkg, level, type, inst), stack));
  }
  // The encoder emits from the decoded model. Traversal tasks include an
  // explicit child-count token after each category, preserving wire order.
  def fbc-tasks(children, rest) = fbc-tasks-reversed(reverse(children), rest);
  def fbc-tasks-reversed(children, rest) = nil?(children) ? rest : fbc-tasks-reversed(tail(children), fbd-push(list(0, head(children)), rest));
  def fbc-encode(root) {
   let pool = record_new(0);
   record_set(pool, "values", list());
   record_set(pool, "size", 0);
   let wire = fbc-emit(fbd-push(list(0, root), list()), pool, list());
   nothing?(wire) ? fbc-fail("invalid node data")
   : fbc-encoded("FORMBIN2" ++ fbc-word(record_get(pool, "size")) ++ fbc-pool-emit(reverse(record_get(pool, "values")), list()) ++ wire);
  }
  def fbc-encoded(wire) = fbc-good(fbc-decode(wire)) ? fbc-ok(wire, 0, 0) : fbc-decode(wire);
  def fbc-pool-emit(values, out) = nil?(values) ? fbc-finish(out, "") : fbc-pool-emit(tail(values), fbc-put(out, fbc-word(str_len(head(values))) ++ head(values)));
  def fbc-string-index(pool, s) {
   let key = "string:" ++ s;
   record_has(pool, key) ? record_get(pool, key)
   : fbc-string-insert(pool, s, key, record_get(pool, "size"));
  }
  def fbc-string-insert(pool, s, key, index) {
   record_set(pool, key, index);
   record_set(pool, "size", index + 1);
   record_set(pool, "values", cons(s, record_get(pool, "values")));
   index;
  }
  def fbc-emit(tasks, pool, out) {
   nil?(tasks) ? fbc-finish(out, "")
   : (Comparable) head(head(tasks)) == 1 ? fbc-emit(fbd-rest(tasks), pool, fbc-put(out, fbc-word(head(tasks)[1])))
   : fbc-emit-node(head(tasks)[1], fbd-rest(tasks), pool, out);
  }
  def fbc-emit-node(node, rest, pool, out) {
   !fbc-list?(node) ? nothing()
   : (Comparable) head(node) == 1 ? (((Comparable) len(node) == 3) && (fbc-list?(node[2]) && (len(node[2]) <= 262144)) ? fbc-emit(fbd-push(list(0, node[1]), fbd-push(list(1, len(node[2])), fbc-tasks(node[2], rest))), pool, fbc-put(out, fbc-word(1))) : nothing())
   : (Comparable) head(node) == 4 ? (((Comparable) len(node) == 3) && (!nothing?(fbc-string(node[1], node[2]))) ? fbc-emit(rest, pool, fbc-put(out, fbc-word(0) ++ fbc-word(node[1]) ++ fbc-word(1) ++ fbc-word(2) ++ fbc-word(fbc-string-index(pool, node[2])))) : nothing())
   : ((Comparable) head(node) == 2) || ((Comparable) head(node) == 3) ? (((Comparable) len(node) == 2) && (!nothing?(fbc-number(head(node), node[1]))) ? fbc-emit(rest, pool, fbc-put(out, fbc-word(head(node)) ++ node[1])) : nothing())
   : (Comparable) head(node) == 0 ? (((Comparable) len(node) == 5) && (!nothing?(fbc-leaf(node[1], node[2], node[3], node[4]))) ? fbc-emit(rest, pool, fbc-put(out, fbc-word(0) ++ fbc-word(node[1]) ++ fbc-word(node[2]) ++ fbc-word(node[3]) ++ fbc-word(node[4]))) : nothing())
   : nothing();
  }
  def fbc-dump(path, root) = fbc-dump-result(path, fbc-encode(root));
  def fbc-dump-result(path, encoded) = !fbc-good(encoded) ? encoded : (Comparable) write_file(path, fbc-value(encoded)) == str_len(fbc-value(encoded)) ? encoded : fbc-fail("artifact write incomplete");
  // Structural identity resolves strings and ignores their allocation index
  // and package, matching their artifact value. All other coordinates and
  // every numeric payload bit participate. The canonical tree byte stream
  // receives its own schema; it is not a hash of source formatting.
  def fbc-structural(root) = fbc-structure(fbd-push(list(0, root), list()), list());
  def fbc-structure(tasks, out) {
   nil?(tasks) ? fbc-finish(out, "")
   : (Comparable) head(head(tasks)) == 1 ? fbc-structure(fbd-rest(tasks), fbc-put(out, fbc-word(head(tasks)[1])))
   : fbc-structure-node(head(tasks)[1], fbd-rest(tasks), out);
  }
  def fbc-structure-node(node, rest, out) {
   (Comparable) head(node) == 1 ? fbc-structure(fbd-push(list(0, node[1]), fbd-push(list(1, len(node[2])), fbc-tasks(node[2], rest))), fbc-put(out, fbc-word(1)))
   : (Comparable) head(node) == 4 ? fbc-structure(rest, fbc-put(out, fbc-word(4) ++ fbc-word(str_len(node[2])) ++ node[2]))
   : ((Comparable) head(node) == 2) || ((Comparable) head(node) == 3) ? fbc-structure(rest, fbc-put(out, fbc-word(head(node)) ++ node[1]))
   : fbc-structure(rest, fbc-put(out, fbc-word(0) ++ fbc-word(node[1]) ++ fbc-word(node[2]) ++ fbc-word(node[3]) ++ fbc-word(node[4])));
  }
  def fbc-hash(s) = hex-encode(sha256-stream-string(s));
 }
 0;
}
