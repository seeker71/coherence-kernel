    else if (((Comparable) node[0] == 2) || ((Comparable) node[0] == 3)) then if (((Comparable) len(node) == 2) && fbc-number-valid?(node[0],node[1])) then fbc-emit(rest, pool, fbc-put(out, ((String) fbc-word(node[0]) + node[1]))) else nothing()
    else if ((Comparable) node[0] == 0) then if (((Comparable) len(node) == 5) && fbc-leaf-valid?(node[1],node[2],node[3],node[4])) then fbc-emit(rest, pool, fbc-put(out, (fbc-word(0) + (fbc-word(node[1]) + (fbc-word(node[2]) + ((String) fbc-word(node[3]) + fbc-word(node[4]))))))) else nothing()
    else nothing();
  }
  def fbc-dump(path, root) = fbc-dump-result(path, fbc-encode(root));
  def fbc-dump-result(path, encoded) = if (!fbc-good(encoded)) then encoded else if ((Comparable) write_file(path, fbc-value(encoded)) == len(fbc-value(encoded))) then encoded else fbc-fail("artifact write incomplete");
  // Structural identity resolves strings and ignores their allocation index
  // and package, matching their artifact value. All other coordinates and
  // every numeric payload bit participate. The canonical tree byte stream
  // receives its own schema; it is not a hash of source formatting.
  def fbc-structural(root) = fbc-structure(fbd-push([0, root], []), []);
   // Replay already holds ordinary values. Emit the same structural bytes
   // directly, without constructing a second inert tree for every field row.
   // Recovery still owns BYTES/DOTTED normalization before this entry point.
   def fbc-data-key(value) = fbc-data-key-walk(fbd-push([0,value],[]),[]);
   def fbc-data-key-head(name,count) {
    if !fbc-u32?(count) then form_error("form binary: structural child count exceeds u32 geometry") else 0;
     fbc-word(1)+fbc-word(4)+fbc-word(len(name))+name+fbc-word(count);
   }
   def fbc-data-key-walk(tasks,out) = nil?(tasks) ? fbc-finish(out,"") : tasks[0][0]==1 ? fbc-data-key-walk(fbd-rest(tasks),fbc-put(out,tasks[0][1])) : fbc-data-key-value(tasks[0][1],fbd-rest(tasks),out);
   def fbc-data-key-value(value,rest,out) {
    let kind=value_kind(value);
    kind=="list" ? fbc-data-key-list(value,rest,out)
     : nothing?(value) ? fbc-data-key-walk(rest,fbc-put(out,fbc-data-key-head(FBC-NOTHING[2],0)))
      : kind=="int" || kind=="float" ? fbc-data-key-walk(rest,fbc-put(out,fbc-word(kind=="int" ? 3 : 2)+float_leaf(34,[kind=="int" ? 3 : 2,value])))
     : kind=="string" ? fbc-data-key-string(value,rest,out)
     : kind=="node_id" ? form_error("form binary: native values require an explicit payload or coordinate policy")
     : form_error("form binary: ordinary value has no portable representation");
   }
   def fbc-data-key-list(value,rest,out) = fbc-proper?(value) ? fbc-data-key-walk(fbc-tasks(value,rest),fbc-put(out,fbc-data-key-head(FBC-LIST[2],len(value)))) : fbc-data-key-dotted(value,[],rest,out);
   def fbc-data-key-dotted(items,heads,rest,out) = value_kind(items)=="list" ? fbc-data-key-dotted(tail(items),cons(head(items),heads),rest,out) : fbc-data-key-walk(fbc-tasks-reversed(heads,fbd-push([0,items],rest)),fbc-put(out,fbc-data-key-head(FBC-DOTTED[2],2)+fbc-data-key-head(FBC-LIST[2],len(heads))));
   def fbc-data-key-string(value,rest,out) {
    if fbc-utf8(value,0) then {
     if !fbc-u32?(len(value)) then form_error("form binary: structural string exceeds u32 geometry") else 0;
      fbc-data-key-walk(rest,fbc-put(out,fbc-word(4)+fbc-word(len(value))+value));
     } else fbc-data-key-bytes(value,0,rest,fbc-put(out,fbc-data-key-head(FBC-BYTES[2],1+(len(value)+7)/8)+fbc-word(3)+float_leaf(34,[3,len(value)])));
   }
   def fbc-data-key-bytes(value,offset,rest,out) = offset>=len(value) ? fbc-data-key-walk(rest,out) : {
    let chunk=substring(value,offset,offset+8);
     fbc-data-key-bytes(value,offset+8,rest,fbc-put(out,fbc-word(3)+chunk+fbc-data-padding(8-len(chunk))));
   };
  def fbc-structure(tasks, out) {
   if nil?(tasks) then fbc-finish(out, "")
   else if ((Comparable) tasks[0][0] == 1) then fbc-structure(fbd-rest(tasks), fbc-put(out, fbc-word(tasks[0][1])))
   else fbc-structure-node(tasks[0][1], fbd-rest(tasks), out);
  }
   def fbc-structure-node(node, rest, out) {
    if ((Comparable) node[0] == 1) then {
     if !fbc-u32?(len(node[2])) then form_error("form binary: structural child count exceeds u32 geometry") else 0;
     fbc-structure(fbd-push([0, node[1]], fbd-push([1, len(node[2])], fbc-tasks(node[2], rest))), fbc-put(out, fbc-word(1)));
    }
    else if ((Comparable) node[0] == 4) then {
     if !fbc-u32?(len(node[2])) then form_error("form binary: structural string exceeds u32 geometry") else 0;
     fbc-structure(rest, fbc-put(out, (fbc-word(4) + ((String) fbc-word(len(node[2])) + node[2]))));
    }
   else if (((Comparable) node[0] == 2) || ((Comparable) node[0] == 3)) then fbc-structure(rest, fbc-put(out, ((String) fbc-word(node[0]) + node[1])))
   else fbc-structure(rest, fbc-put(out, (fbc-word(0) + (fbc-word(node[1]) + (fbc-word(node[2]) + ((String) fbc-word(node[3]) + fbc-word(node[4])))))));
  }
  def fbc-hash(s) = hex-encode(sha256-stream-string(s));
 }
 0;
}
