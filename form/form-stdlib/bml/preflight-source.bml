// preflight-source.bml — which lane a unit travels, where its cache lives, and whether its
// surface closes. The reading preflight needs before it can force a fresh compile.
//
// WHY THIS CELL EXISTS
//   preflight's fresh compile read one thing off a path: does it end in ".fk". Everything else
//   was refused as an unsupported source kind, and the refusal exited 0 — so the cells the body
//   is asked to write TODAY (high-grammar BML, AGENTS.md's authoring floor since 2026-08-30)
//   got no preflight at all, and nothing said so out loud.
//
//   The seed already knows better, and says so in one function: fk_unit_lowers reads a unit onto
//   the lowering lane when its file wears .bml OR its text carries a `section [` block on a line
//   of its own (runtime/fkwu-uni.c). That second half is the part a suffix cannot see:
//   form-stdlib/compiler.fk, runtime-grammar.fk and the ten -bmf.fk grammars all wear .fk and all
//   travel the BML lane. This cell mirrors that same reading so preflight sees what the runner
//   sees, rather than a second opinion about it.
//
// WHERE THE CACHE LIVES — measured, because guessing it deleted a source once
//   A lowering unit's artifacts hang off the WHOLE path: rag-crossfade.bml.fkb, .bml.sym,
//   .bml.lowfk. A plain .fk replaces its suffix: rag-embed.fkb, rag-embed.sym. preflight computed
//   only the second shape, so on a lowering unit it removed a file that was never there and the
//   warm image survived — and a warm image answers `cached image was compiled with errors` with
//   no name and no line. Witnessed 2026-09-10 on a sectioned .fk carrying one unresolved call:
//   warm, the page read `unresolved 0`; with the real artifact removed by hand, `unresolved 1`
//   and the name. A pre-verdict probe reporting a false zero is the failure it exists to catch.
//
//   pfs-artifacts answers with a LIST, and an unsupported kind answers with an EMPTY one. That
//   shape is the 2026-08-26 lesson made structural: a removal path was once derived by a
//   substitution that returned its input unchanged when the mark was absent, and a .bml source
//   was deleted while preflight believed it was clearing a .fkb. A caller that folds over this
//   list cannot reach the source, because the source is not in it.
//
// THE SURFACE, READ AS ITSELF
//   The .fk balance walker counts parens, ends a comment at `;`, and knows `\` inside a string.
//   Held against a brace surface it is not wrong so much as absent: `//` is not a comment to it,
//   `{` is not a delimiter, and `;` — a statement TERMINATOR in BML — makes it skip the rest of
//   every line of real code. It answered depth 0 on grammars/bml.fk by walking past most of the
//   file. This walker reads the surface the compiler reads: `//` to end of line, `/* */` nested
//   by nothing, `"` with backslash, and three delimiter families counted apart, so an unclosed
//   brace is named a brace. It starts at the `section [` line, because the prose and the
//   directives above it are not code and never balanced anything.
//
//   A count is attention, not a verdict — the same footing the voice mirror stands on. A
//   nonzero depth says a delimiter did not close; which one, and whether that matters, the
//   writer reads.
//
// THE EFFECT MARKER SPEAKS BOTH TONGUES
//   fkwu has no compile-only door, so preflight RUNS a cell to obtain whole-chain diagnostics,
//   and a cell that owns a model, a listener, or a mutation carries `preflight-exec: forbidden`
//   to be preserved instead. That marker was spelled with a leading `;` only. A BML writer
//   reaches for `//`, writes the line, and would have watched preflight execute the thing the
//   line asked it not to. Both spellings are the marker now.

section [form.bml] {
    class PreflightSource {

        // ── bytes, guarded ───────────────────────────────────────────────────────
        // str_byte_at past the end dies rc1 on the full kernels by design. Length first,
        // always; 0 stands for "no byte here" and matches nothing this walker looks for.
        def pfs-byte(s, i) = if or(lt(i, 0), ge(i, str_len(s))) then 0 else str_byte_at(s, i);
        def pfs-blank?(c) = or(eq(c, 32), or(eq(c, 9), eq(c, 13)));
        def pfs-skip-blank(s, i) = if pfs-blank?(pfs-byte(s, i)) then pfs-skip-blank(s, add(i, 1)) else i;
        def pfs-eol(s, i) = if or(ge(i, str_len(s)), eq(pfs-byte(s, i), 10)) then i else pfs-eol(s, add(i, 1));
        def pfs-at?(s, i, mark) = if gt(add(i, str_len(mark)), str_len(s)) then 0 else str_eq(substring(s, i, add(i, str_len(mark))), mark);
        def pfs-ends?(s, x) = if lt(str_len(s), str_len(x)) then 0 else str_eq(substring(s, sub(str_len(s), str_len(x)), str_len(s)), x);

        // ── the seed's own reading of which units lower ───────────────────────────
        // This scan is a MIRROR of fk_unit_lowers, blindness included, and the blindness is
        // load-bearing: it knows nothing about strings, so a .fk whose string literal holds a
        // line beginning with `section [` is routed to the lowering lane by the runner itself.
        // A smarter reading here would be a second opinion that disagrees with the runner
        // about which cache a unit writes — and preflight would go back to removing files that
        // are not there. Where the runner goes, this goes.
        //
        // It is real, and it is latent: measured 2026-09-10, 45 .fk units in this tree carry
        // such a line and NONE of them is inside a string. The one that was is a fixture in
        // this cell's own band, where it turned every arm red at once; the repair a writer
        // needs is to byte-build the literal so no line of the lowered source starts with the
        // mark. Healing it for real means teaching fk_unit_lowers about strings in the C seed
        // and moving this scan in the same breath, so the two never answer differently.
        def pfs-section-mark() = "section [";
        def pfs-section-scan(s, i) = if ge(i, str_len(s)) then -1 else if pfs-at?(s, pfs-skip-blank(s, i), pfs-section-mark()) then pfs-skip-blank(s, i) else pfs-section-scan(s, add(pfs-eol(s, i), 1));
        def pfs-section-at(text) = pfs-section-scan(text, 0);
        def pfs-section-block?(text) = if ge(pfs-section-at(text), 0) then 1 else 0;
        def pfs-body-start(text) = if ge(pfs-section-at(text), 0) then pfs-section-at(text) else 0;
        def pfs-lowers?(path, text) = if pfs-ends?(path, ".bml") then 1 else pfs-section-block?(text);

        // ── the kind, in the body's own words ─────────────────────────────────────
        // "bml"          a high-grammar unit, lowered in memory and cached as <path>.bml.fkb
        // "lowering-fk"  a .fk carrying a section block: same lane, .fk name
        // "fk"           the ordinary direct-source lane
        // "unsupported"  nothing preflight can compile; the source is read and never touched
        def pfs-kind(path, text) = if pfs-ends?(path, ".bml") then "bml" else if not(pfs-ends?(path, ".fk")) then "unsupported" else if pfs-section-block?(text) then "lowering-fk" else "fk";
        def pfs-supported?(path, text) = if str_eq(pfs-kind(path, text), "unsupported") then 0 else 1;
        def pfs-kind-note(kind) = if str_eq(kind, "bml") then "high grammar, lowered in memory through form/form-stdlib/bml-floor-compile.fk" else if str_eq(kind, "lowering-fk") then "a .fk carrying a `section [` block, so it travels the same lowering lane" else if str_eq(kind, "fk") then "direct source" else "no compile lane here; preflight reads this source and changes nothing";

        // ── where the cache lives ─────────────────────────────────────────────────
        def pfs-stem(path) = if pfs-ends?(path, ".fk") then substring(path, 0, sub(str_len(path), 3)) else path;
        def pfs-artifacts(path, text) = if str_eq(pfs-kind(path, text), "unsupported") then list() else if pfs-lowers?(path, text) then list(str_concat(path, ".fkb"), str_concat(path, ".sym"), str_concat(path, ".lowfk")) else list(str_concat(pfs-stem(path), ".fkb"), str_concat(pfs-stem(path), ".sym"));

        // ── the brace surface ─────────────────────────────────────────────────────
        // Four states walk the same bytes: code, line comment, block comment, string. The
        // three delimiter families are counted apart so the report can name the one that
        // stayed open. The closing state rides out with them — a string or a block comment
        // that never ends is its own answer, and reads as unclosed rather than as depth 0.
        //
        // THE WALK IS BOUNDED BY THE BLOCK, and that boundary was paid for. Walking from the
        // first `section [` line to end of file is right for a .bml and wrong for a .fk that
        // carries one: grammars/bml.fk closes its block at line 3925 and then continues for
        // 2500 lines of ordinary Form, whose parens this walker has no business counting. It
        // read depth -1 there — a red line on a file that closes perfectly. So a walk starts
        // at a `section [`, ends when the brace depth returns to zero, and the scan resumes
        // after it; a unit carrying five blocks (lora-backward.bml) gets five readings folded
        // into one. What lies between blocks is prose and directives, and balances nothing.
        //
        // `seen` is what makes zero mean two things honestly: before the block's own `{` it
        // means not-yet-open, after it means closed — and only the second one stops the walk.
        def pfs-bal-go(s, i, n, p, b, k, seen) = if ge(i, n) then list(p, b, k, 0, i) else if and(seen, eq(b, 0)) then list(p, b, k, 0, i) else pfs-bal-code(s, i, n, p, b, k, or(seen, gt(b, 0)));
        def pfs-bal-code(s, i, n, p, b, k, seen) {
            let c = pfs-byte(s, i);
            let c2 = pfs-byte(s, add(i, 1));
            if and(eq(c, 47), eq(c2, 47)) then pfs-bal-line(s, add(i, 2), n, p, b, k, seen)
            else if and(eq(c, 47), eq(c2, 42)) then pfs-bal-block(s, add(i, 2), n, p, b, k, seen)
            else if eq(c, 34) then pfs-bal-str(s, add(i, 1), n, p, b, k, seen)
            else if eq(c, 40) then pfs-bal-go(s, add(i, 1), n, add(p, 1), b, k, seen)
            else if eq(c, 41) then pfs-bal-go(s, add(i, 1), n, sub(p, 1), b, k, seen)
            else if eq(c, 123) then pfs-bal-go(s, add(i, 1), n, p, add(b, 1), k, seen)
            else if eq(c, 125) then pfs-bal-go(s, add(i, 1), n, p, sub(b, 1), k, seen)
            else if eq(c, 91) then pfs-bal-go(s, add(i, 1), n, p, b, add(k, 1), seen)
            else if eq(c, 93) then pfs-bal-go(s, add(i, 1), n, p, b, sub(k, 1), seen)
            else pfs-bal-go(s, add(i, 1), n, p, b, k, seen);
        }
        def pfs-bal-line(s, i, n, p, b, k, seen) = if ge(i, n) then list(p, b, k, 0, i) else if eq(pfs-byte(s, i), 10) then pfs-bal-go(s, add(i, 1), n, p, b, k, seen) else pfs-bal-line(s, add(i, 1), n, p, b, k, seen);
        def pfs-bal-block(s, i, n, p, b, k, seen) = if ge(i, n) then list(p, b, k, 2, i) else if and(eq(pfs-byte(s, i), 42), eq(pfs-byte(s, add(i, 1)), 47)) then pfs-bal-go(s, add(i, 2), n, p, b, k, seen) else pfs-bal-block(s, add(i, 1), n, p, b, k, seen);
        def pfs-bal-str(s, i, n, p, b, k, seen) = if ge(i, n) then list(p, b, k, 3, i) else if eq(pfs-byte(s, i), 92) then pfs-bal-str(s, add(i, 2), n, p, b, k, seen) else if eq(pfs-byte(s, i), 34) then pfs-bal-go(s, add(i, 1), n, p, b, k, seen) else pfs-bal-str(s, add(i, 1), n, p, b, k, seen);

        // Every `section [` block in the unit, folded into one reading. A unit with no block
        // has no brace surface at all, and answers closed — there is nothing here to read, and
        // its compile is the whole reading.
        def pfs-balance(text) = pfs-blocks(text, 0, 0, 0, 0, 0);
        def pfs-blocks(text, from, p, b, k, st) {
            let at = pfs-section-scan(text, from);
            if lt(at, 0) then list(p, b, k, st)
            else pfs-blocks-at(text, at, p, b, k, st);
        }
        def pfs-blocks-at(text, at, p, b, k, st) {
            let r = pfs-bal-go(text, at, str_len(text), 0, 0, 0, 0);
            pfs-blocks(text, nth(r, 4), add(p, nth(r, 0)), add(b, nth(r, 1)), add(k, nth(r, 2)), if eq(st, 0) then nth(r, 3) else st);
        }

        def pfs-closed?(bal) = if and(eq(nth(bal, 0), 0), and(eq(nth(bal, 1), 0), and(eq(nth(bal, 2), 0), eq(nth(bal, 3), 0)))) then 1 else 0;
        def pfs-open-name(bal) = if eq(nth(bal, 3), 3) then "string" else if eq(nth(bal, 3), 2) then "block comment" else if not(eq(nth(bal, 1), 0)) then "braces" else if not(eq(nth(bal, 2), 0)) then "brackets" else if not(eq(nth(bal, 0), 0)) then "parens" else "";
        def pfs-open-depth(bal) = if not(eq(nth(bal, 1), 0)) then nth(bal, 1) else if not(eq(nth(bal, 2), 0)) then nth(bal, 2) else nth(bal, 0);

        // ── the effect marker, in both tongues ────────────────────────────────────
        def pfs-effect-mark-fk() = "; preflight-exec: forbidden";
        def pfs-effect-mark-bml() = "// preflight-exec: forbidden";
        def pfs-mark-line?(text, start, mark) = if not(pfs-at?(text, start, mark)) then 0 else if ge(pfs-skip-blank(text, add(start, str_len(mark))), str_len(text)) then 1 else if eq(pfs-byte(text, pfs-skip-blank(text, add(start, str_len(mark)))), 10) then 1 else 0;
        def pfs-effect-line?(text, at) = or(pfs-mark-line?(text, pfs-skip-blank(text, at), pfs-effect-mark-fk()), pfs-mark-line?(text, pfs-skip-blank(text, at), pfs-effect-mark-bml()));
        def pfs-effect-scan(text, at) = if ge(at, str_len(text)) then 0 else if pfs-effect-line?(text, at) then 1 else pfs-effect-scan(text, add(pfs-eol(text, at), 1));
        def pfs-effect-marked?(text) = pfs-effect-scan(text, 0);

        // ── where a name no kernel resolves is defined ───────────────────────────────
        // A name every kernel misses is a typo only when no unit defines it. When one does, the
        // chain never loads it, and that unit's repo-relative path — a spelling `; preludes:`
        // reads — is the repair. The roots are the tree's own top-level directories, read off the
        // disk; dot-directories hold caches, run scratch and other worktrees, and band helpers,
        // seedbank copies and toolchain trees are not units to prelude, so the walk passes them by.
        // Direct source defines with `(defn name `, high grammar with `def name(`.
        def pfs-home-skips() = list("tests", ".cache", "seedbank", "node_modules", "target");
        def pfs-unit-root?(name) = if eq(pfs-byte(name, 0), 46) then 0 else fs_is_dir(name);
        def pfs-home-in(root, rows, needle) = if eq(len(rows), 0) then "" else if ge(str_find(read_file(str_concat(root, str_concat("/", nth(head(rows), 0)))), needle, 0), 0) then str_concat(root, str_concat("/", nth(head(rows), 0))) else pfs-home-in(root, tail(rows), needle);
        def pfs-home-root(root, suffix, needle) = if pfs-unit-root?(root) then pfs-home-in(root, source_inventory(root, suffix, pfs-home-skips()), needle) else "";
        def pfs-home-roots(roots, suffix, needle) = if eq(len(roots), 0) then "" else pfs-home-next(roots, suffix, needle, pfs-home-root(head(roots), suffix, needle));
        def pfs-home-next(roots, suffix, needle, hit) = if gt(str_len(hit), 0) then hit else pfs-home-roots(tail(roots), suffix, needle);
        def pfs-defn-home(name) {
            let roots = fs_list(".");
            let fk = pfs-home-roots(roots, ".fk", str_concat("(defn ", str_concat(name, " ")));
            if gt(str_len(fk), 0) then fk else pfs-home-roots(roots, ".bml", str_concat("def ", str_concat(name, "(")));
        }
    }
}
