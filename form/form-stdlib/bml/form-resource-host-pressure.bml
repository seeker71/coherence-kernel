package Form.runtime.resourcegovernor.hostpressure;

import Form.kernel.*;

interface IFormResourceHostPressure [public, witness, reusable] {
   section [public] {
      const String Schema = "form-resource-host-headroom-policy-v1";
      const String SourceRule = "the Darwin memory_pressure free percentage is a current system-wide headroom input, not Metal working-set bytes and not model residency";
      const String ThresholdRule = "ten percent or less requests warning backoff and five percent or less requests critical backoff; these explicit local governor thresholds preserve the requested ninety-percent utilization target and are not names for an Apple pressure enum";
      const String RetentionRule = "a current reading above the warning threshold authorizes retain and no release; it does not claim that open or mapped model pages are resident";
      const String ReleaseRule = "warning or critical headroom never unloads by itself; a current reclaim-byte request and current unique inactive whole handles remain mandatory";
      const String ModelGrainRule = "packed MoE experts transformer layers and partial KV have no independent physical release handle and therefore remain unsupported";

      Object PressureFromOutput( String output, Object provenance ) [abstract];
      Object Retention( Object pressure, Object requiredBytes, Object units ) [abstract];
   }
}

class FormResourceHostPressure [public, resident, flow, observable, teach] : IFormResourceHostPressure {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-resource-host-pressure.bml";
      const String AuthorityPath = "form/form-stdlib/bml/form-resource-host-pressure.bml";
      const int WarningFreePercent = 10;
      const int CriticalFreePercent = 5;

      Object PressureFromOutput( String output, Object provenance ) [abstract] {}
      Object Retention( Object pressure, Object requiredBytes, Object units ) [abstract] {}
   }
}
