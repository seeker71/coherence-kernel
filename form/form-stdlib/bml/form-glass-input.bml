// Native terminal byte door and incremental VT key decoder. No Glass actions
// live in the host carrier. A read never waits for a newline. Bracketed paste
// is text, never a stream of commands; unknown escape sequences are discarded.
// preludes: form/form-stdlib/core.fk
section [form.bml] {
    class FormGlassInput {
        def fgki-open() = host_sleep_ms(list("terminal-input", 1));
        def fgki-close() = host_sleep_ms(list("terminal-input", 0));
        def fgki-read() = host_sleep_ms(list("terminal-input", 2));
        def fgki-active() = host_sleep_ms(list("terminal-input", 3));
        field FGKITextLimit = 256;
        field FGKIEscapeMs = 120;
        def fgki-state(mode, text, escape, paste, started, serial) = list(mode, text, escape, paste, started, serial);
        def fgki-empty() = fgki-state("", "", "", 0, 0, 0);
        def fgki-mode(s) = s[0];
        def fgki-text(s) = s[1];
        def fgki-escape(s) = s[2];
        def fgki-paste?(s) = s[3];
        def fgki-started(s) = s[4];
        def fgki-serial(s) = s[5];
        def fgki-prompt(s, mode) = fgki-state(mode, "", "", 0, 0, fgki-serial(s));
        def fgki-clear(s) = fgki-state("", "", "", 0, 0, fgki-serial(s));
        def fgki-edit(s, text) = fgki-state(fgki-mode(s), text, "", fgki-paste?(s), 0, fgki-serial(s));
        def fgki-result(s, kind, value) = list(s, kind, value);
        def fgki-none(s) = fgki-result(s, "", "");
        def fgki-expire(s, now) = (str_len(fgki-escape(s)) > 0) && ((now - fgki-started(s)) >= FGKIEscapeMs()) ? fgki-state("", "", "", fgki-paste?(s), 0, fgki-serial(s)) : s;
        def fgki-sequence(s, byte, now) {
            let held = fgki-escape(s);
            let seq = held ++ byte_to_str(byte);
            let next = fgki-state(fgki-mode(s), fgki-text(s), str_len(seq) < 24 ? seq : held, fgki-paste?(s), now, fgki-serial(s));
            let clear = fgki-edit(s, fgki-text(s));
            ((Comparable) str_len(held) == 1) && (((Comparable) byte == 91) || ((Comparable) byte == 79)) ? fgki-none(next)
            : (str_len(held) > 1) && (byte < 64) ? fgki-none(next)
            : (String) seq == (byte_to_str(27) ++ "[200~") ? fgki-none(fgki-state(fgki-mode(s), fgki-text(s), "", 1, 0, fgki-serial(s)))
            : (String) seq == (byte_to_str(27) ++ "[201~") ? fgki-none(fgki-state(fgki-mode(s), fgki-text(s), "", 0, 0, fgki-serial(s)))
            : (Comparable) fgki-paste?(s) == 1 ? fgki-none(clear)
            : ((String) seq == (byte_to_str(27) ++ "[A")) || ((String) seq == (byte_to_str(27) ++ "OA")) ? fgki-result(clear, "move", -1)
            : ((String) seq == (byte_to_str(27) ++ "[B")) || ((String) seq == (byte_to_str(27) ++ "OB")) ? fgki-result(clear, "move", 1)
            : fgki-none(clear);
        }
        def fgki-byte(s0, byte, now) {
            let s = fgki-state(fgki-mode(s0), fgki-text(s0), fgki-escape(s0), fgki-paste?(s0), fgki-started(s0), fgki-serial(s0) + 1);
            str_len(fgki-escape(s)) > 0 ? fgki-sequence(s, byte, now)
            : (Comparable) byte == 27 ? fgki-none(fgki-state(fgki-mode(s), fgki-text(s), byte_to_str(27), fgki-paste?(s), now, fgki-serial(s)))
            : ((Comparable) fgki-paste?(s) == 1) && ((Comparable) str_len(fgki-mode(s)) == 0) ? fgki-none(s)
            : str_len(fgki-mode(s)) > 0 ? fgki-text-byte(s, byte)
            : (Comparable) byte == 9 ? fgki-result(s, "move", 1)
            : (Comparable) byte == 3 ? fgki-result(s, "key", "q")
            : (byte >= 32) && (byte <= 126) ? fgki-result(s, "key", byte_to_str(byte))
            : fgki-none(s);
        }
        def fgki-text-byte(s, byte) {
            ((Comparable) fgki-paste?(s) == 0) && (((Comparable) byte == 13) || ((Comparable) byte == 10)) ? fgki-result(fgki-clear(s), fgki-mode(s), fgki-text(s))
            : ((Comparable) fgki-paste?(s) == 0) && (((Comparable) byte == 127) || ((Comparable) byte == 8)) ? fgki-none(fgki-edit(s, substring(fgki-text(s), 0, str_len(fgki-text(s)) > 0 ? (str_len(fgki-text(s)) - 1) : 0)))
            : ((byte >= 32) && (byte <= 126)) && (str_len(fgki-text(s)) < FGKITextLimit()) ? fgki-none(fgki-edit(s, fgki-text(s) ++ byte_to_str(byte)))
            : fgki-none(s);
        }
    }
    0;
}
