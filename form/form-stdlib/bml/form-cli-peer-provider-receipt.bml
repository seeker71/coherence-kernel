//////////////////////////////////////////////////////////////////////
//
// form-cli-peer-provider-receipt.bml -- a scalar provider boundary inside
// the Form turnwheel.
//
// A remote provider is not invoked here.  When one has already crossed its
// own boundary, it may offer only a settled call count and token total.  The
// fixed grammar maps `goal=embodied-v1` to the BML-owned canonical node; task
// bytes never nominate a NodeID, root, session, model, or path.
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/form-cli-peer-stream-ingress.fk form-stdlib/bml/form-cli-remote-token-evidence.bml form-stdlib/bml/form-cli-embodied-goal-grammar.bml

section [form.bml] {
    class FormCliPeerProviderReceipt {
        field ProviderReceiptRoute = "provider-receipt";
        field ProviderReceiptCarrier = "form-provider-receipt";
        field ProviderReceiptVersion = "form-cli-peer-provider-receipt-v1";
        field ProviderReceiptGoal = "embodied-v1";
        field ProviderReceiptOpen = "<|form:provider-receipt|>\n";
        field ProviderReceiptClose = "\n<|/form:provider-receipt|>";
        field ProviderReceiptGoalPrefix = "goal=";
        field ProviderReceiptSettledLine = "settled=1";
        field ProviderReceiptCallsPrefix = "provider-calls=";
        field ProviderReceiptTokensPrefix = "remote-tokens=";

        def fcprr-route() = ProviderReceiptRoute();
        def fcprr-carrier() = ProviderReceiptCarrier();
        def fcprr-version() = ProviderReceiptVersion();
        def fcprr-goal() = ProviderReceiptGoal();
        def fcprr-open() = ProviderReceiptOpen();
        def fcprr-close() = ProviderReceiptClose();
        def fcprr-goal-prefix() = ProviderReceiptGoalPrefix();
        def fcprr-settled-line() = ProviderReceiptSettledLine();
        def fcprr-calls-prefix() = ProviderReceiptCallsPrefix();
        def fcprr-tokens-prefix() = ProviderReceiptTokensPrefix();
        def fcprr-canonical-positive?(text) = !((String) int_to_str(str_to_int(text)) == text) ? 0 : str_to_int(text) <= 0 ? 0 : 1;
        def fcprr-split(text) = split-on(text, "\n");
        def fcprr-starts?(text, prefix) = (Comparable) str_find(text, prefix, 0) == 0;
        def fcprr-after(text, prefix) = substring(text, str_len(prefix), str_len(text));
        def fcprr-lines(rows) = (Comparable) len(rows) == 0 ? "" : (Comparable) len(tail(rows)) == 0 ? head(rows) : head(rows) ++ "\n" ++ fcprr-lines(tail(rows));
        def fcprr-envelope(calls, tokens) = fcprr-open() ++ fcprr-lines(list(fcprr-goal-prefix() ++ fcprr-goal(), fcprr-settled-line(), fcprr-calls-prefix() ++ int_to_str(calls), fcprr-tokens-prefix() ++ int_to_str(tokens))) ++ fcprr-close();

        // `nothing` is malformed or noncanonical incoming evidence; a valid
        // scalar zero is intentionally impossible at this provider boundary.
        def fcprr-parse-fields(rows) {
            let calls = fcprr-after(rows[2], fcprr-calls-prefix());
            let tokens = fcprr-after(rows[3], fcprr-tokens-prefix());
            fcprr-canonical-positive?(calls) && fcprr-canonical-positive?(tokens) ? list(str_to_int(calls), str_to_int(tokens)) : nothing();
        }
        def fcprr-parse(text) {
            let open = fcprr-open();
            let close = fcprr-close();
            let close_at = str_len(text) - str_len(close);
            let body = close_at < str_len(open) ? "" : substring(text, str_len(open), close_at);
            let rows = fcprr-split(body);
            (!((Comparable) str_find(text, open, 0) == 0)) || (!((Comparable) str_find(text, close, str_len(open)) == close_at)) ? nothing() : !((Comparable) len(rows) == 4) ? nothing() : !((String) head(rows) == (fcprr-goal-prefix() ++ fcprr-goal())) ? nothing() : !((String) rows[1] == fcprr-settled-line()) ? nothing() : (!fcprr-starts?(rows[2], fcprr-calls-prefix())) || (!fcprr-starts?(rows[3], fcprr-tokens-prefix())) ? nothing() : fcprr-parse-fields(rows);
        }
        def fcprr-calls(parsed) = parsed[0];
        def fcprr-tokens(parsed) = parsed[1];
        def fcprr-kind?(kind) = (String) kind == fcprr-route();
        def fcprr-receipt(parsed) = frte-receipt(fcpdag-embodied-goal-node(), 1, frte-provider-source(), fcprr-calls(parsed), fcprr-tokens(parsed));
        def fcprr-frame(receipt) = "<|form:remote-token-comparison|>\n" ++ fcprr-lines(list("goal=" ++ fcprr-goal(), "source=" ++ frte-receipt-source(receipt), "provider-calls=" ++ int_to_str(frte-receipt-provider-calls(receipt)), "remote-tokens=" ++ int_to_str(frte-receipt-remote-tokens(receipt)), "settled=1")) ++ "\n<|/form:remote-token-comparison|>";
        def fcprr-result(session, receipt, response, signal, reason) = list(fcprr-version(), session, receipt, response, signal, reason);
        def fcprr-session(result) = result[1];
        def fcprr-receipt-of(result) = result[2];
        def fcprr-response(result) = result[3];
        def fcprr-signal(result) = result[4];
        def fcprr-reason(result) = result[5];
        def fcprr-result?(result) = nothing?(result) ? 0 : !((Comparable) len(result) == 6) ? 0 : ((String) result[0] == fcprr-version());
        def fcprr-refused(session, reason) = fcprr-result(session, nothing(), "", "choice", reason);
        def fcprr-admit(session, parsed) {
            let receipt = fcprr-receipt(parsed);
            fcprr-result(session, receipt, fcprr-frame(receipt), "value", "settled-provider-receipt-admitted");
        }
        def fcprr-run(session, kind, text) {
            let parsed = fcprr-parse(text);
            !fcprr-kind?(kind) ? fcprr-refused(session, "provider-receipt-requires-provider-receipt-task") : nothing?(parsed) ? fcprr-refused(session, "provider-receipt-shape-refused") : fcprr-admit(session, parsed);
        }
        def fcprr-value-present?(result) = nothing?(fcprr-receipt-of(result)) ? 0 : 1;
        def fcprr-value(result) = nothing?(fcprr-receipt-of(result)) ? nothing() : frte-receipt-remote-tokens(fcprr-receipt-of(result));
        def fcprr-tool-status(result) = nothing?(fcprr-receipt-of(result)) ? "choice;model=0;provider=0" : "value;model=0;provider-calls=" ++ int_to_str(frte-receipt-provider-calls(fcprr-receipt-of(result))) ++ ";remote-tokens=" ++ int_to_str(frte-receipt-remote-tokens(fcprr-receipt-of(result)));
        def fcprr-peer(result) = fcpa-result-full(fcprr-session(result), result, fcprr-response(result), 0, 0, fcprr-route(), 0, fcprr-tool-status(result), fcprr-carrier(), fcprr-value-present?(result), fcprr-value(result), 0, 0, (String) fcprr-signal(result) == "value" ? "ingress,validate,release" : "choice,release", 0);
        def fcprr-run-peer-task(stream, session, task_node, task) {
            let result = fcprr-run(session, fcpsi-task-kind(task), fcpsi-task-text(task));
            let peer = fcprr-peer(result);
            let candidate = fcpsi-peer-result(stream, task_node, fcpa-response(peer), 0, nothing());
            list(fcpsi-result-state(candidate), peer, candidate);
        }
        def fcprr-run-peer(stream, session, task_node) {
            let task = fcpsi-find-task(fcpsi-tasks(stream), task_node);
            nothing?(task) ? list(stream, nothing(), fcpsi-result(stream, "nothing", 0, nothing(), "task-node-absent", nothing())) : fcprr-run-peer-task(stream, session, task_node, task);
        }
    }
    0;
}
