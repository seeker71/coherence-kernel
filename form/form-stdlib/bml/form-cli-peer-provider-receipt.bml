//////////////////////////////////////////////////////////////////////
//
// form-cli-peer-provider-receipt.bml -- a scalar provider boundary inside
// the Form turnwheel.
//
// A remote provider is not invoked here.  When one has already crossed its
// own boundary, it may offer only a settled call count and token total.  The
// fixed grammar maps `goal=embodied-v1` to the BML-owned canonical node; task
// bytes never nominate a NodeID, root, session, model, or path.
//
//////////////////////////////////////////////////////////////////////

import form-stdlib/form-cli-peer-stream-ingress.fk;
import form-stdlib/bml/form-cli-remote-token-evidence.bml;
import form-stdlib/bml/form-cli-embodied-goal-grammar.bml;

section [form.bml] {
    class FormCliPeerProviderReceipt {
        field ProviderReceiptRoute = "provider-receipt";
        field ProviderReceiptCarrier = "form-provider-receipt";
        field ProviderReceiptVersion = "form-cli-peer-provider-receipt-v1";
        field ProviderReceiptGoal = "embodied-v1";
        field ProviderReceiptOpen = "<|form:provider-receipt|>\n";
        field ProviderReceiptClose = "\n<|/form:provider-receipt|>";
        field ProviderReceiptGoalPrefix = "goal=";
        field ProviderReceiptSettledLine = "settled=1";
        field ProviderReceiptCallsPrefix = "provider-calls=";
        field ProviderReceiptTokensPrefix = "remote-tokens=";

        def fcprr-route() = ProviderReceiptRoute();
        def fcprr-carrier() = ProviderReceiptCarrier();
        def fcprr-version() = ProviderReceiptVersion();
        def fcprr-goal() = ProviderReceiptGoal();
        def fcprr-open() = ProviderReceiptOpen();
        def fcprr-close() = ProviderReceiptClose();
        def fcprr-goal-prefix() = ProviderReceiptGoalPrefix();
        def fcprr-settled-line() = ProviderReceiptSettledLine();
        def fcprr-calls-prefix() = ProviderReceiptCallsPrefix();
        def fcprr-tokens-prefix() = ProviderReceiptTokensPrefix();
        def fcprr-canonical-positive?(text) = if (!((String) str_to_int(text).str() == text)) then 0 else if (str_to_int(text) <= 0) then 0 else 1;
        def fcprr-split(text) = split-on(text, "\n");
        def fcprr-starts?(text, prefix) = ((Comparable) str_find(text, prefix, 0) == 0);
        def fcprr-after(text, prefix) = substring(text, len(prefix), len(text));
        def fcprr-lines(rows) = if ((Comparable) len(rows) == 0) then "" else if ((Comparable) len(rows[1:]) == 0) then rows[0] else (rows[0] + ("\n" + fcprr-lines(rows[1:])));
        def fcprr-envelope(calls, tokens) = (fcprr-open() + ((String) fcprr-lines([((String) fcprr-goal-prefix() + fcprr-goal()), fcprr-settled-line(), (fcprr-calls-prefix() + calls.str()), (fcprr-tokens-prefix() + tokens.str())]) + fcprr-close()));

        // `nothing` is malformed or noncanonical incoming evidence; a valid
        // scalar zero is intentionally impossible at this provider boundary.
        def fcprr-parse-fields(rows) {
            let calls = fcprr-after(rows[2], fcprr-calls-prefix());
            let tokens = fcprr-after(rows[3], fcprr-tokens-prefix());
            if (fcprr-canonical-positive?(calls) && fcprr-canonical-positive?(tokens)) then [str_to_int(calls), str_to_int(tokens)] else nothing();
        }
        def fcprr-parse(text) {
            let open = fcprr-open();
            let close = fcprr-close();
            let close_at = (len(text) - len(close));
            let body = if (close_at < len(open)) then "" else substring(text, len(open), close_at);
            let rows = fcprr-split(body);
            if ((!((Comparable) str_find(text, open, 0) == 0)) || (!((Comparable) str_find(text, close, len(open)) == close_at))) then nothing() else if (!((Comparable) len(rows) == 4)) then nothing() else if (!((String) rows[0] == ((String) fcprr-goal-prefix() + fcprr-goal()))) then nothing() else if (!((String) rows[1] == fcprr-settled-line())) then nothing() else if ((!fcprr-starts?(rows[2], fcprr-calls-prefix())) || (!fcprr-starts?(rows[3], fcprr-tokens-prefix()))) then nothing() else fcprr-parse-fields(rows);
        }
        def fcprr-calls(parsed) = parsed[0];
        def fcprr-tokens(parsed) = parsed[1];
        def fcprr-kind?(kind) = ((String) kind == fcprr-route());
        def fcprr-receipt(parsed) = frte-receipt(fcpdag-embodied-goal-node(), 1, frte-provider-source(), fcprr-calls(parsed), fcprr-tokens(parsed));
        def fcprr-frame(receipt) = ("<|form:remote-token-comparison|>\n" + (fcprr-lines([("goal=" + fcprr-goal()), ("source=" + frte-receipt-source(receipt)), ("provider-calls=" + frte-receipt-provider-calls(receipt).str()), ("remote-tokens=" + frte-receipt-remote-tokens(receipt).str()), "settled=1"]) + "\n<|/form:remote-token-comparison|>"));
        def fcprr-result(session, receipt, response, signal, reason) = [fcprr-version(), session, receipt, response, signal, reason];
        def fcprr-session(result) = result[1];
        def fcprr-receipt-of(result) = result[2];
        def fcprr-response(result) = result[3];
        def fcprr-signal(result) = result[4];
        def fcprr-reason(result) = result[5];
        def fcprr-result?(result) = if nothing?(result) then 0 else if (!((Comparable) len(result) == 6)) then 0 else ((String) result[0] == fcprr-version());
        def fcprr-refused(session, reason) = fcprr-result(session, nothing(), "", "choice", reason);
        def fcprr-admit(session, parsed) {
            let receipt = fcprr-receipt(parsed);
            fcprr-result(session, receipt, fcprr-frame(receipt), "value", "settled-provider-receipt-admitted");
        }
        def fcprr-run(session, kind, text) {
            let parsed = fcprr-parse(text);
            if (!fcprr-kind?(kind)) then fcprr-refused(session, "provider-receipt-requires-provider-receipt-task") else if nothing?(parsed) then fcprr-refused(session, "provider-receipt-shape-refused") else fcprr-admit(session, parsed);
        }
        def fcprr-value-present?(result) = if nothing?(fcprr-receipt-of(result)) then 0 else 1;
        def fcprr-value(result) = if nothing?(fcprr-receipt-of(result)) then nothing() else frte-receipt-remote-tokens(fcprr-receipt-of(result));
        def fcprr-tool-status(result) = if nothing?(fcprr-receipt-of(result)) then "choice;model=0;provider=0" else ("value;model=0;provider-calls=" + (frte-receipt-provider-calls(fcprr-receipt-of(result)).str() + (";remote-tokens=" + frte-receipt-remote-tokens(fcprr-receipt-of(result)).str())));
        def fcprr-peer(result) = fcpa-result-full(fcprr-session(result), result, fcprr-response(result), 0, 0, fcprr-route(), 0, fcprr-tool-status(result), fcprr-carrier(), fcprr-value-present?(result), fcprr-value(result), 0, 0, if ((String) fcprr-signal(result) == "value") then "ingress,validate,release" else "choice,release", 0);
        def fcprr-run-peer-task(stream, session, task_node, task) {
            let result = fcprr-run(session, fcpsi-task-kind(task), fcpsi-task-text(task));
            let peer = fcprr-peer(result);
            let candidate = fcpsi-peer-result(stream, task_node, fcpa-response(peer), 0, nothing());
            [fcpsi-result-state(candidate), peer, candidate];
        }
        def fcprr-run-peer(stream, session, task_node) {
            let task = fcpsi-find-task(fcpsi-tasks(stream), task_node);
            if nothing?(task) then [stream, nothing(), fcpsi-result(stream, "nothing", 0, nothing(), "task-node-absent", nothing())] else fcprr-run-peer-task(stream, session, task_node, task);
        }
    }
    0;
}
