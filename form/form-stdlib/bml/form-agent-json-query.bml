// Query pipelines over resident JSON cells; json.fk remains the codec.
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/shell-exec.fk form-stdlib/bml/form-agent-tool-values.bml
section [form.bml] {
    class FormAgentJsonQuery {
        // Syntax admission protects the permissive legacy parser. Only the
        // existing parser constructs JSON cells; this pass returns an end
        // position or a negative encoding of the first error's byte and reason.
        field FajErrorRadix = 16;
        def faj-error(at, reason) = 0 - (((at + 1) * FajErrorRadix()) + reason);
        def faj-error-at(error) = ((0 - error) / FajErrorRadix()) - 1;
        def faj-error-reason(error) = (0 - error) % FajErrorRadix();
        def faj-expected(reason) = list("JSON value", "closing string quote", "escaped control byte", "valid string escape", "four hexadecimal Unicode escape digits", "integer digit", "fraction digit", "exponent digit", "nesting depth at most 64", "quoted object key", "colon after object key", "comma or closing array bracket", "comma or closing object brace", "end of input after one JSON value")[reason];
        def faj-hex(c) = fat-digit(c) || (((c >= 65) && (c <= 70)) || ((c >= 97) && (c <= 102)));
        def faj-hex4(s, i, n) = (Comparable) n == 0 ? i : faj-hex(fat-char(s, i)) ? faj-hex4(s, i + 1, n - 1) : faj-error(i, 4);
        def faj-string(s, i) = i >= str_len(s) ? faj-error(i, 1) : (Comparable) fat-char(s, i) == 34 ? (i + 1) : fat-char(s, i) < 32 ? faj-error(i, 2) : (Comparable) fat-char(s, i) == 92 ? faj-string-escape(s, i + 1) : faj-string(s, i + 1);
        def faj-string-escape(s, i) = (Comparable) fat-char(s, i) == 117 ? faj-string-hex(s, faj-hex4(s, i + 1, 4)) : (i < str_len(s)) && (str_find("\"\\/bfnrt", byte_to_str(fat-char(s, i)), 0) >= 0) ? faj-string(s, i + 1) : faj-error(i, 3);
        def faj-string-hex(s, end) = end < 0 ? end : faj-string(s, end);
        def faj-digits(s, i) = fat-digit(fat-char(s, i)) ? faj-digits(s, i + 1) : i;
        def faj-number(s, i) = faj-number-int(s, (Comparable) fat-char(s, i) == 45 ? (i + 1) : i);
        def faj-number-int(s, i) = (Comparable) fat-char(s, i) == 48 ? faj-number-frac(s, i + 1) : (fat-char(s, i) >= 49) && (fat-char(s, i) <= 57) ? faj-number-frac(s, faj-digits(s, i)) : faj-error(i, 5);
        def faj-number-frac(s, i) = (Comparable) fat-char(s, i) == 46 ? (fat-digit(fat-char(s, i + 1)) ? faj-number-exp(s, faj-digits(s, i + 1)) : faj-error(i + 1, 6)) : faj-number-exp(s, i);
        def faj-number-exp(s, i) = ((Comparable) fat-char(s, i) == 101) || ((Comparable) fat-char(s, i) == 69) ? faj-number-exp-digits(s, ((Comparable) fat-char(s, i + 1) == 43) || ((Comparable) fat-char(s, i + 1) == 45) ? (i + 2) : (i + 1)) : i;
        def faj-number-exp-digits(s, i) = fat-digit(fat-char(s, i)) ? faj-digits(s, i) : faj-error(i, 7);
        def faj-end(s, i, depth) = depth > 64 ? faj-error(fat-skip(s, i), 8) : faj-value(s, fat-skip(s, i), depth);
        def faj-value(s, i, depth) {
            let c = fat-char(s, i);
            (Comparable) c == 34 ? faj-string(s, i + 1)
            : (Comparable) c == 91 ? faj-container(s, fat-skip(s, i + 1), depth + 1, 93, 1)
            : (Comparable) c == 123 ? faj-container(s, fat-skip(s, i + 1), depth + 1, 125, 1)
            : ((Comparable) c == 45) || fat-digit(c) ? faj-number(s, i)
            : fat-starts(substring(s, i, str_len(s)), "true") ? (i + 4)
            : fat-starts(substring(s, i, str_len(s)), "false") ? (i + 5)
            : fat-starts(substring(s, i, str_len(s)), "null") ? (i + 4) : faj-error(i, 0);
        }
        def faj-container(s, i, depth, close, emptyAllowed) = emptyAllowed && ((Comparable) fat-char(s, i) == close) ? (i + 1) : (Comparable) close == 125 ? ((Comparable) fat-char(s, i) == 34 ? faj-object-value(s, faj-string(s, i + 1), depth) : faj-error(i, 9)) : faj-container-after(s, faj-end(s, i, depth), depth, close);
        def faj-object-value(s, keyEnd, depth) = keyEnd < 0 ? keyEnd : (Comparable) fat-char(s, fat-skip(s, keyEnd)) == 58 ? faj-container-after(s, faj-end(s, fat-skip(s, keyEnd) + 1, depth), depth, 125) : faj-error(fat-skip(s, keyEnd), 10);
        def faj-container-after(s, end, depth, close) = end < 0 ? end : faj-container-delim(s, fat-skip(s, end), depth, close);
        def faj-container-delim(s, i, depth, close) = (Comparable) fat-char(s, i) == close ? (i + 1) : (Comparable) fat-char(s, i) == 44 ? faj-container(s, fat-skip(s, i + 1), depth, close, 0) : faj-error(i, (Comparable) close == 93 ? 11 : 12);
        def faj-complete(s) = faj-complete-end(s, faj-end(s, 0, 0));
        def faj-complete-end(s, end) = end < 0 ? end : (Comparable) fat-skip(s, end) == str_len(s) ? str_len(s) : faj-error(fat-skip(s, end), 13);
        def faj-valid(s) = faj-complete(s) >= 0;
        def faj-valid-end(s, end) = end < 0 ? 0 : ((Comparable) fat-skip(s, end) == str_len(s));
        // The diagnostic names syntax without copying source or answer text.
        // Offsets count bytes, starting at zero; end of input has no byte.
        def faj-diagnostic(s, error) {
            let at = faj-error-at(error);
            let present = at < str_len(s);
            let byte = present ? fat-char(s, at) : 0;
            json-node-object(list(json-node-pair("byte_offset", json-node-int(at)), json-node-pair("expected", json-node-string(faj-expected(faj-error-reason(error)))), json-node-pair("found_byte", present ? json-node-int(byte) : json-node-null()), json-node-pair("found", json-node-string(!present ? "end-of-input" : (byte >= 32) && (byte < 127) ? byte_to_str(byte) : "non-printing-or-multibyte-byte"))));
        }
        // At a mismatched closer, remove an extra closer or insert the missing
        // expected one. Exactly one single-byte candidate must be strict JSON.
        // String contents and every other byte stay untouched. EOF is not a
        // mismatched closer: unfinished generation receives no completion.
        def faj-closer-candidate(s, error) = error >= 0 ? nothing() : (Comparable) faj-error-reason(error) == 13 ? faj-root-closer-candidate(s,error) : {
            let at = faj-error-at(error);
            let reason = faj-error-reason(error);
            let expected = (Comparable) reason == 11 ? 93 : (Comparable) reason == 12 ? 125 : 0;
            let wrong = (Comparable) expected == 93 ? 125 : 93;
            ((Comparable) expected == 0) || (!((Comparable) fat-char(s,at) == wrong)) ? nothing() : {
                let removed = substring(s,0,at) ++ substring(s,at + 1,str_len(s));
                let inserted = substring(s,0,at) ++ byte_to_str(expected) ++ substring(s,at,str_len(s));
                let removalOk = ((Comparable) fat-char(s,fat-skip(s,at + 1)) == expected) && faj-valid(removed);
                let insertionOk = faj-valid(inserted);
                (Comparable) removalOk == insertionOk ? nothing() : removalOk ? removed : inserted;
            };
        };
        // A completed root object followed by a comma can have closed one
        // member too early. Remove only its parser-proven final brace. The
        // remaining bytes must form one object with unique decoded keys, so
        // a trailing member cannot replace an already supplied command field.
        def faj-root-closer-candidate(s,error) {
            let end = faj-end(s,0,0);
            !(((Comparable) fat-char(s,fat-skip(s,0)) == 123) && ((end > 0) && (((Comparable) fat-char(s,faj-error-at(error)) == 44) && ((Comparable) fat-skip(s,end) == faj-error-at(error))))) ? nothing() : {
                let at = end - 1;
                let candidate = substring(s,0,at) ++ substring(s,end,str_len(s));
                !(((Comparable) fat-char(s,at) == 125) && faj-valid(candidate)) ? nothing()
                : faj-unique-pairs(node_children(parse-json("root-closer-candidate",candidate)),list()) ? candidate : nothing();
            };
        }
        def faj-unique-pairs(pairs,keys) = nil?(pairs) ? 1 : {
            let key = json-pair-key(head(pairs));
            fat-has(keys,key) ? 0 : faj-unique-pairs(tail(pairs),cons(key,keys));
        };
        def faj-closer-offset(s,error) = (Comparable) faj-error-reason(error) == 13 ? (faj-end(s,0,0) - 1) : faj-error-at(error);
        def faj-null() = intern_node(JSON-NULL(), list());
        def faj-array(xs) = intern_node(JSON-ARRAY(), xs);
        def faj-is(node, kind) = node_eq(node_category(node), kind);
        def faj-truth(node) = !(faj-is(node, JSON-NULL()) || node_eq(node, intern_trivial_bool(false)));
        def faj-type(node) = faj-is(node, JSON-OBJECT()) ? "object" : faj-is(node, JSON-ARRAY()) ? "array" : faj-is(node, JSON-NULL()) ? "null" : (Comparable) node_type(node) == 2 ? "string" : (Comparable) node_type(node) == 3 ? "boolean" : "number";
        // The shared codec constructs cells; the query object model keeps the
        // last value for a repeated key, preserving its first insertion order.
        def faj-json(source, text) = faj-normalize(parse-json(source, text));
        def faj-normalize(node) = faj-is(node, JSON-OBJECT()) ? json-node-object(faj-normal-pairs(node_children(node), list())) : faj-is(node, JSON-ARRAY()) ? faj-array(faj-normal-items(node_children(node))) : node;
        def faj-normal-items(nodes) = nil?(nodes) ? list() : cons(faj-normalize(head(nodes)), faj-normal-items(tail(nodes)));
        def faj-normal-pairs(pairs, out) = nil?(pairs) ? out : faj-normal-pairs(tail(pairs), faj-put-pair(out, json-node-pair(json-pair-key(head(pairs)), faj-normalize(json-pair-value(head(pairs))))));
        def faj-put-pair(pairs, pair) = nil?(pairs) ? list(pair) : (String) json-pair-key(head(pairs)) == json-pair-key(pair) ? cons(pair, tail(pairs)) : cons(head(pairs), faj-put-pair(tail(pairs), pair));

        // Compiler result: AST, error. Compilation precedes input evaluation.
        def faj-bad(error) = list(list(), error);
        def faj-built(ast) = list(ast, "");
        def faj-compile(s) = str_len(s) > 512 ? faj-bad("query-limit") : faj-pipe(fat-trim(s), fat-split-top(fat-trim(s), "|"));
        def faj-pipe(s, split) = !((String) split[1] == "") ? faj-bad(split[1]) : len(head(split)) > 1 ? faj-compile-many("pipe", head(split), list()) : faj-fallback(s, fat-split-top(s, "//"));
        def faj-fallback(s, split) = len(head(split)) > 1 ? faj-compile-many("fallback", head(split), list()) : faj-simple(s);
        def faj-compile-many(kind, parts, out) = nil?(parts) ? faj-built(list(kind, fat-reverse(out))) : faj-compiled-one(kind, parts, out, faj-compile(head(parts)));
        def faj-compiled-one(kind, parts, out, r) = !((String) r[1] == "") ? r : faj-compile-many(kind, tail(parts), cons(head(r), out));
        def faj-wrap(kind, compiled) = !((String) compiled[1] == "") ? compiled : faj-built(list(kind, head(compiled)));
        def faj-simple(s) = (String) s == "." ? faj-built(list("id"))
            : fat-has(list("keys", "length", "type", "empty", "sort", "unique", "to_entries"), s) ? faj-built(list(s))
            : fat-starts(s, "map(") && fat-ends(s, ")") ? faj-wrap("map", faj-compile(substring(s, 4, str_len(s) - 1)))
            : fat-starts(s, "has(") && fat-ends(s, ")") ? faj-wrap("has", faj-compile(substring(s, 4, str_len(s) - 1)))
            : fat-starts(s, "contains(") && fat-ends(s, ")") ? faj-wrap("contains", faj-compile(substring(s, 9, str_len(s) - 1)))
            : fat-starts(s, "select(") && fat-ends(s, ")") ? faj-wrap("select", faj-predicate(substring(s, 7, str_len(s) - 1), list("==", "!=", ">=", "<=", ">", "<")))
            : faj-valid(s) ? faj-built(list("literal", faj-json("resident-query-literal", s)))
            : fat-starts(s, "[") && fat-ends(s, "]") ? faj-wrap("collect", faj-compile(fat-strip(s, 1)))
            : fat-starts(s, "{") && fat-ends(s, "}") ? faj-object-compile(head(fat-split-top(fat-strip(s, 1), ",")), list())
            : (Comparable) fat-char(s, 0) == 46 ? faj-path(s, 1, list())
            : (Comparable) fat-char(s, 0) == 36 ? (faj-name(substring(s, 1, str_len(s))) ? faj-built(list("variable", substring(s, 1, str_len(s)))) : faj-bad("invalid-variable"))
            : faj-bad("unsupported-jq-expression");
        def faj-predicate(s, ops) = nil?(ops) ? faj-compile(s) : faj-predicate-split(s, ops, head(fat-split-top(s, head(ops))));
        def faj-predicate-split(s, ops, parts) = (Comparable) len(parts) == 2 ? faj-predicate-pair(head(ops), faj-compile(head(parts)), faj-compile(parts[1])) : len(parts) > 2 ? faj-bad("chained-comparison-not-supported") : faj-predicate(s, tail(ops));
        def faj-predicate-pair(op, a, b) = !((String) a[1] == "") ? a : !((String) b[1] == "") ? b : faj-built(list("compare", op, head(a), head(b)));
        def faj-name-byte(c) = fat-digit(c) || (((c >= 65) && (c <= 90)) || (((c >= 97) && (c <= 122)) || ((Comparable) c == 95)));
        def faj-name-end(s, i) = faj-name-byte(fat-char(s, i)) ? faj-name-end(s, i + 1) : i;
        def faj-name(s) = (str_len(s) > 0) && ((!fat-digit(fat-char(s, 0))) && ((Comparable) faj-name-end(s, 0) == str_len(s)));
        def faj-path(s, i, parts) = i >= str_len(s) ? faj-built(list("path", fat-reverse(parts))) : (Comparable) fat-char(s, i) == 46 ? (((Comparable) fat-char(s, i - 1) == 46) || ((Comparable) fat-char(s, i + 1) == 0) ? faj-bad("empty-path-segment") : faj-path(s, i + 1, parts)) : (Comparable) fat-char(s, i) == 91 ? faj-path-bracket(s, i, parts) : (Comparable) fat-char(s, i - 1) == 93 ? faj-bad("missing-path-separator") : faj-path-key(s, i, faj-name-end(s, i), parts);
        def faj-path-key(s, i, end, parts) = (Comparable) i == end ? faj-bad("unsupported-path-syntax") : (end >= str_len(s)) || (((Comparable) fat-char(s, end) == 46) || ((Comparable) fat-char(s, end) == 91)) ? faj-path(s, end, cons(list("key", substring(s, i, end)), parts)) : faj-bad("unsupported-path-syntax");
        def faj-path-bracket(s, i, parts) = faj-path-bracket-end(s, i, faj-bracket-end(s, fat-skip(s, i + 1)), parts);
        def faj-bracket-end(s, i) = (Comparable) fat-char(s, i) == 34 ? faj-quoted-bracket-end(s, faj-string(s, i + 1)) : str_find(s, "]", i);
        def faj-quoted-bracket-end(s, end) = end < 0 ? -1 : (Comparable) fat-char(s, fat-skip(s, end)) == 93 ? fat-skip(s, end) : -1;
        def faj-path-bracket-end(s, i, end, parts) = end < 0 ? faj-bad("unclosed-path-bracket") : faj-path-index(s, end, fat-trim(substring(s, i + 1, end)), parts);
        def faj-path-index(s, end, index, parts) = (String) index == "" ? faj-path(s, end + 1, cons(list("each"), parts)) : fat-natural(index) ? faj-path(s, end + 1, cons(list("index", str_to_int(index)), parts)) : ((Comparable) fat-char(index, 0) == 34) && faj-valid(index) ? faj-path(s, end + 1, cons(list("key", node_value(parse-json("resident-query-key", index))), parts)) : faj-bad("unsupported-array-index");
        def faj-object-compile(parts, out) = nil?(parts) ? faj-built(list("object", fat-reverse(out))) : faj-object-pair(parts, out, head(fat-split-top(head(parts), ":")));
        def faj-object-pair(parts, out, pair) = !((Comparable) len(pair) == 2) ? faj-bad("object-needs-key-and-expression") : faj-object-key(parts, out, head(pair), faj-compile(pair[1]));
        def faj-object-key(parts, out, key, r) = !((String) r[1] == "") ? r : faj-name(key) ? faj-object-compile(tail(parts), cons(list(key, head(r)), out)) : ((Comparable) fat-char(key, 0) == 34) && faj-valid(key) ? faj-object-compile(tail(parts), cons(list(node_value(parse-json("resident-query-key", key)), head(r)), out)) : faj-bad("invalid-object-key");

        // Evaluation result: stream of JSON nodes, error. No error is a value.
        def faj-values(xs) = list(xs, "");
        def faj-one(node) = faj-values(list(node));
        def faj-eval(ast, node, vars) {
            let kind = head(ast);
            (String) kind == "id" ? faj-one(node)
            : (String) kind == "literal" ? faj-one(ast[1])
            : (String) kind == "variable" ? faj-var(vars, ast[1])
            : (String) kind == "empty" ? faj-values(list())
            : (String) kind == "pipe" ? faj-pipeline(ast[1], list(node), vars)
            : (String) kind == "fallback" ? faj-fallback-eval(ast[1], node, vars)
            : (String) kind == "path" ? faj-path-eval(ast[1], list(node))
            : (String) kind == "map" ? (faj-is(node, JSON-ARRAY()) ? faj-collected(faj-each(ast[1], node_children(node), vars)) : faj-bad("map-needs-array"))
            : (String) kind == "collect" ? faj-collected(faj-eval(ast[1], node, vars))
            : (String) kind == "has" ? faj-has-result(node, faj-eval(ast[1], node, vars))
            : (String) kind == "contains" ? faj-contains-result(node, faj-eval(ast[1], node, vars))
            : (String) kind == "select" ? faj-selected(node, faj-eval(ast[1], node, vars))
            : (String) kind == "compare" ? faj-compared(ast[1], faj-eval(ast[2], node, vars), faj-eval(ast[3], node, vars))
            : (String) kind == "object" ? faj-object-eval(ast[1], node, vars, list())
            : fat-has(list("sort", "unique"), kind) ? faj-sorted(kind, node)
            : faj-builtin(kind, node);
        }
        def faj-var(vars, name) = nil?(vars) ? faj-bad("unbound-variable") : (String) head(head(vars)) == name ? faj-one(head(vars)[1]) : faj-var(tail(vars), name);
        def faj-bound(ast, vars) = (String) head(ast) == "variable" ? ((String) faj-var(vars, ast[1])[1] == "") : fat-has(list("pipe", "fallback"), head(ast)) ? faj-bound-many(ast[1], vars) : fat-has(list("map", "collect", "select", "has", "contains"), head(ast)) ? faj-bound(ast[1], vars) : (String) head(ast) == "compare" ? (faj-bound(ast[2], vars) && faj-bound(ast[3], vars)) : (String) head(ast) == "object" ? faj-bound-pairs(ast[1], vars) : 1;
        // Object-key presence is distinct from a missing key resolving to null.
        // Array-index has is outside this query subset and returns an error.
        def faj-has-result(node, result) = !((String) result[1] == "") ? result : !faj-is(node, JSON-OBJECT()) ? faj-bad("has-needs-object") : faj-has-keys(node, head(result));
        def faj-has-keys(node, keys) = nil?(keys) ? faj-values(list()) : !((String) faj-type(head(keys)) == "string") ? faj-bad("has-needs-string-key") : faj-joined(faj-one(intern_trivial_bool(json-object-has?(node, node_value(head(keys))))), faj-has-keys(node, tail(keys)));
        // Literal substring presence only. Collection containment is outside
        // this resident subset; punctuation presence is not semantic quality.
        def faj-contains-result(node, result) = !((String) result[1] == "") ? result : !((String) faj-type(node) == "string") ? faj-bad("contains-needs-string-input") : faj-contains-strings(node_value(node), head(result));
        def faj-contains-strings(text, needles) = nil?(needles) ? faj-values(list()) : !((String) faj-type(head(needles)) == "string") ? faj-bad("contains-needs-string-argument") : faj-joined(faj-one(intern_trivial_bool(str_find(text, node_value(head(needles)), 0) >= 0)), faj-contains-strings(text, tail(needles)));
        def faj-bound-many(asts, vars) = nil?(asts) ? 1 : (faj-bound(head(asts), vars) && faj-bound-many(tail(asts), vars));
        def faj-bound-pairs(pairs, vars) = nil?(pairs) ? 1 : (faj-bound(head(pairs)[1], vars) && faj-bound-pairs(tail(pairs), vars));
        def faj-each(ast, nodes, vars) = nil?(nodes) ? faj-values(list()) : faj-append(faj-eval(ast, head(nodes), vars), ast, tail(nodes), vars);
        def faj-append(r, ast, rest, vars) = !((String) r[1] == "") ? r : faj-joined(r, faj-each(ast, rest, vars));
        def faj-joined(a, b) = !((String) b[1] == "") ? b : faj-values(append(head(a), head(b)));
        def faj-pipeline(stages, nodes, vars) = nil?(stages) ? faj-values(nodes) : faj-pipeline-next(stages, vars, faj-each(head(stages), nodes, vars));
        def faj-pipeline-next(stages, vars, r) = !((String) r[1] == "") ? r : faj-pipeline(tail(stages), head(r), vars);
        def faj-truths(nodes) = nil?(nodes) ? list() : faj-truth(head(nodes)) ? cons(head(nodes), faj-truths(tail(nodes))) : faj-truths(tail(nodes));
        def faj-fallback-eval(stages, node, vars) = nil?(stages) ? faj-values(list()) : faj-fallback-next(stages, node, vars, faj-eval(head(stages), node, vars));
        def faj-fallback-next(stages, node, vars, r) = !((String) r[1] == "") ? r : len(faj-truths(head(r))) > 0 ? faj-values(faj-truths(head(r))) : nil?(tail(stages)) ? r : faj-fallback-eval(tail(stages), node, vars);
        def faj-collected(r) = !((String) r[1] == "") ? r : faj-one(faj-array(head(r)));
        def faj-selected(node, r) = !((String) r[1] == "") ? r : len(faj-truths(head(r))) > 0 ? faj-one(node) : faj-values(list());
        def faj-path-eval(parts, nodes) = nil?(parts) ? faj-values(nodes) : faj-path-next(parts, faj-path-many(head(parts), nodes));
        def faj-path-next(parts, r) = !((String) r[1] == "") ? r : faj-path-eval(tail(parts), head(r));
        def faj-path-many(part, nodes) = nil?(nodes) ? faj-values(list()) : faj-path-combine(part, tail(nodes), faj-path-one(part, head(nodes)));
        def faj-path-combine(part, rest, r) = !((String) r[1] == "") ? r : faj-joined(r, faj-path-many(part, rest));
        def faj-path-one(part, node) = (String) head(part) == "key" ? (faj-is(node, JSON-NULL()) ? faj-one(faj-null()) : faj-is(node, JSON-OBJECT()) ? faj-one(json-object-get-loop(node_children(node), part[1], faj-null())) : faj-bad("key-needs-object")) : (String) head(part) == "index" ? (faj-is(node, JSON-NULL()) ? faj-one(faj-null()) : faj-is(node, JSON-ARRAY()) ? faj-one(part[1] < len(node_children(node)) ? node_children(node)[part[1]] : faj-null()) : faj-bad("index-needs-array")) : faj-is(node, JSON-ARRAY()) ? faj-values(node_children(node)) : faj-is(node, JSON-OBJECT()) ? faj-values(faj-object-values(node_children(node))) : faj-bad("iteration-needs-array-or-object");
        def faj-object-values(pairs) = nil?(pairs) ? list() : cons(json-pair-value(head(pairs)), faj-object-values(tail(pairs)));
        def faj-object-eval(pairs, node, vars, out) = nil?(pairs) ? faj-one(json-node-object(out)) : faj-object-evaluated(pairs, node, vars, out, faj-eval(head(pairs)[1], node, vars));
        def faj-object-evaluated(pairs, node, vars, out, r) = !((String) r[1] == "") ? r : !((Comparable) len(head(r)) == 1) ? faj-bad("object-field-needs-one-value") : faj-object-eval(tail(pairs), node, vars, faj-put-pair(out, json-node-pair(head(head(pairs)), head(head(r)))));
        def faj-compared(op, a, b) = !((String) a[1] == "") ? a : !((String) b[1] == "") ? b : !(((Comparable) len(head(a)) == 1) && ((Comparable) len(head(b)) == 1)) ? faj-bad("comparison-needs-one-value") : faj-compare(op, head(head(a)), head(head(b)));
        def faj-compare(op, a, b) = (String) op == "==" ? faj-one(intern_trivial_bool(faj-equal(a, b))) : (String) op == "!=" ? faj-one(intern_trivial_bool(!faj-equal(a, b))) : ((String) faj-type(a) == "number") && ((String) faj-type(b) == "number") ? faj-one(intern_trivial_bool((String) op == ">" ? (node_value(a) > node_value(b)) : (String) op == "<" ? (node_value(a) < node_value(b)) : (String) op == ">=" ? (node_value(a) >= node_value(b)) : (node_value(a) <= node_value(b)))) : faj-bad("ordered-comparison-needs-numbers");
        def faj-equal(a, b) = !((String) faj-type(a) == faj-type(b)) ? 0 : faj-is(a, JSON-ARRAY()) ? faj-equal-array(node_children(a), node_children(b)) : faj-is(a, JSON-OBJECT()) ? (((Comparable) len(node_children(a)) == len(node_children(b))) && faj-equal-object(node_children(a), b)) : (String) faj-type(a) == "number" ? ((Comparable) node_value(a) == node_value(b)) : ((String) json-emit(a) == json-emit(b));
        def faj-equal-array(a, b) = nil?(a) ? nil?(b) : nil?(b) ? 0 : (faj-equal(head(a), head(b)) && faj-equal-array(tail(a), tail(b)));
        def faj-equal-object(pairs, b) = nil?(pairs) ? 1 : (fat-has(json-object-keys(b), json-pair-key(head(pairs))) && (faj-equal(json-pair-value(head(pairs)), json-object-get-loop(node_children(b), json-pair-key(head(pairs)), faj-null())) && faj-equal-object(tail(pairs), b)));
        def faj-strings(xs) = nil?(xs) ? list() : cons(intern_trivial_string(head(xs)), faj-strings(tail(xs)));
        def faj-indices(n) = 0 .. n |> map(i => intern_trivial_int(i));
        def faj-codepoints(s) = 0 .. str_len(s) |> filter(i => (fat-char(s, i) < 128) || (fat-char(s, i) >= 192)) |> len();
        def faj-builtin(kind, node) = (String) kind == "type" ? faj-one(intern_trivial_string(faj-type(node))) : (String) kind == "length" ? (faj-is(node, JSON-OBJECT()) || faj-is(node, JSON-ARRAY()) ? faj-one(intern_trivial_int(len(node_children(node)))) : faj-is(node, JSON-NULL()) ? faj-one(intern_trivial_int(0)) : (Comparable) node_type(node) == 2 ? faj-one(intern_trivial_int(faj-codepoints(node_value(node)))) : faj-bad("length-needs-container")) : (String) kind == "keys" ? (faj-is(node, JSON-OBJECT()) ? faj-one(faj-array(faj-strings(faj-string-sort(json-object-keys(node))))) : faj-is(node, JSON-ARRAY()) ? faj-one(faj-array(faj-indices(len(node_children(node))))) : faj-bad("keys-needs-container")) : (String) kind == "to_entries" ? (faj-is(node, JSON-OBJECT()) ? faj-one(faj-array(faj-entries(node_children(node)))) : faj-bad("to_entries-needs-object")) : faj-bad("unsupported-jq-operation");
        def faj-string-sort(xs) = sh-sort(xs);
        def faj-scalar-rank(node) = faj-is(node, JSON-NULL()) ? 0 : (Comparable) node_type(node) == 3 ? (node_eq(node, intern_trivial_bool(false)) ? 1 : 2) : (String) faj-type(node) == "number" ? 3 : (Comparable) node_type(node) == 2 ? 4 : 5;
        def faj-scalar-less(a, b) = !((Comparable) faj-scalar-rank(a) == faj-scalar-rank(b)) ? (faj-scalar-rank(a) < faj-scalar-rank(b)) : (Comparable) faj-scalar-rank(a) == 3 ? (node_value(a) < node_value(b)) : (Comparable) faj-scalar-rank(a) == 4 ? sh-str-lt(node_value(a), node_value(b)) : 0;
        def faj-scalar-insert(x, xs) = nil?(xs) ? list(x) : faj-scalar-less(x, head(xs)) ? cons(x, xs) : cons(head(xs), faj-scalar-insert(x, tail(xs)));
        def faj-scalar-sort(xs) = nil?(xs) ? list() : faj-scalar-insert(head(xs), faj-scalar-sort(tail(xs)));
        def faj-scalars(xs) = nil?(xs) ? 1 : faj-scalar-rank(head(xs)) >= 5 ? 0 : faj-scalars(tail(xs));
        def faj-unique(xs) = nil?(xs) ? list() : nil?(tail(xs)) ? xs : faj-equal(head(xs), xs[1]) ? faj-unique(tail(xs)) : cons(head(xs), faj-unique(tail(xs)));
        def faj-sorted(kind, node) =
            !faj-is(node, JSON-ARRAY()) ? faj-bad("sort-needs-array")
            : len(node_children(node)) > FatMaxSortItems() ? faj-bad("sort-item-limit")
            : !faj-scalars(node_children(node)) ? faj-bad("sort-supports-scalars-only")
            : faj-one(faj-array((String) kind == "unique" ? faj-unique(faj-scalar-sort(node_children(node))) : faj-scalar-sort(node_children(node))));
        def faj-entries(pairs) = nil?(pairs) ? list() : cons(json-node-object(list(json-node-pair("key", intern_trivial_string(json-pair-key(head(pairs)))), json-node-pair("value", json-pair-value(head(pairs))))), faj-entries(tail(pairs)));
        def faj-render(nodes, raw) = nil?(nodes) ? "" : (raw && ((Comparable) node_type(head(nodes)) == 2) ? node_value(head(nodes)) : json-emit(head(nodes))) ++ "\n" ++ faj-render(tail(nodes), raw);
    }
}
