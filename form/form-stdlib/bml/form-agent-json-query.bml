// Query pipelines over resident JSON cells; json.fk remains the codec.
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/shell-exec.fk form-stdlib/bml/form-agent-tool-values.bml
section [form.bml] {
    class FormAgentJsonQuery {
        // Syntax admission protects the permissive legacy parser. Only the
        // existing parser constructs JSON cells; this pass returns an end
        // position or a negative encoding of the first error's byte and reason.
        field FajErrorRadix = 16;
        def faj-error(at, reason) = (0 - (((at + 1) * FajErrorRadix()) + reason));
        def faj-error-at(error) = (((0 - error) / FajErrorRadix()) - 1);
        def faj-error-reason(error) = ((0 - error) % FajErrorRadix());
        def faj-expected(reason) = ["JSON value", "closing string quote", "escaped control byte", "valid string escape", "four hexadecimal Unicode escape digits", "integer digit", "fraction digit", "exponent digit", "nesting depth at most 64", "quoted object key", "colon after object key", "comma or closing array bracket", "comma or closing object brace", "end of input after one JSON value"][reason];
        def faj-hex(c) = (fat-digit(c) || (((c >= 65) && (c <= 70)) || ((c >= 97) && (c <= 102))));
        def faj-hex4(s, i, n) = if ((Comparable) n == 0) then i else if faj-hex(fat-char(s, i)) then faj-hex4(s, (i + 1), (n - 1)) else faj-error(i, 4);
        def faj-string(s, i) = if (i >= str_len(s)) then faj-error(i, 1) else if ((Comparable) fat-char(s, i) == 34) then (i + 1) else if (fat-char(s, i) < 32) then faj-error(i, 2) else if ((Comparable) fat-char(s, i) == 92) then faj-string-escape(s, (i + 1)) else faj-string(s, (i + 1));
        def faj-string-escape(s, i) = if ((Comparable) fat-char(s, i) == 117) then faj-string-hex(s, faj-hex4(s, (i + 1), 4)) else if ((i < str_len(s)) && (str_find("\"\\/bfnrt", byte_to_str(fat-char(s, i)), 0) >= 0)) then faj-string(s, (i + 1)) else faj-error(i, 3);
        def faj-string-hex(s, end) = if (end < 0) then end else faj-string(s, end);
        def faj-digits(s, i) = if fat-digit(fat-char(s, i)) then faj-digits(s, (i + 1)) else i;
        def faj-number(s, i) = faj-number-int(s, if ((Comparable) fat-char(s, i) == 45) then (i + 1) else i);
        def faj-number-int(s, i) = if ((Comparable) fat-char(s, i) == 48) then faj-number-frac(s, (i + 1)) else if ((fat-char(s, i) >= 49) && (fat-char(s, i) <= 57)) then faj-number-frac(s, faj-digits(s, i)) else faj-error(i, 5);
        def faj-number-frac(s, i) = if ((Comparable) fat-char(s, i) == 46) then if fat-digit(fat-char(s, (i + 1))) then faj-number-exp(s, faj-digits(s, (i + 1))) else faj-error((i + 1), 6) else faj-number-exp(s, i);
        def faj-number-exp(s, i) = if (((Comparable) fat-char(s, i) == 101) || ((Comparable) fat-char(s, i) == 69)) then faj-number-exp-digits(s, if (((Comparable) fat-char(s, (i + 1)) == 43) || ((Comparable) fat-char(s, (i + 1)) == 45)) then (i + 2) else (i + 1)) else i;
        def faj-number-exp-digits(s, i) = if fat-digit(fat-char(s, i)) then faj-digits(s, i) else faj-error(i, 7);
        def faj-end(s, i, depth) = if (depth > 64) then faj-error(fat-skip(s, i), 8) else faj-value(s, fat-skip(s, i), depth);
        def faj-value(s, i, depth) {
            let c = fat-char(s, i);
            if ((Comparable) c == 34) then faj-string(s, (i + 1))
            else if ((Comparable) c == 91) then faj-container(s, fat-skip(s, (i + 1)), (depth + 1), 93, 1)
            else if ((Comparable) c == 123) then faj-container(s, fat-skip(s, (i + 1)), (depth + 1), 125, 1)
            else if (((Comparable) c == 45) || fat-digit(c)) then faj-number(s, i)
            else if fat-starts(substring(s, i, str_len(s)), "true") then (i + 4)
            else if fat-starts(substring(s, i, str_len(s)), "false") then (i + 5)
            else if fat-starts(substring(s, i, str_len(s)), "null") then (i + 4) else faj-error(i, 0);
        }
        def faj-container(s, i, depth, close, emptyAllowed) = if (emptyAllowed && ((Comparable) fat-char(s, i) == close)) then (i + 1) else if ((Comparable) close == 125) then if ((Comparable) fat-char(s, i) == 34) then faj-object-value(s, faj-string(s, (i + 1)), depth) else faj-error(i, 9) else faj-container-after(s, faj-end(s, i, depth), depth, close);
        def faj-object-value(s, keyEnd, depth) = if (keyEnd < 0) then keyEnd else if ((Comparable) fat-char(s, fat-skip(s, keyEnd)) == 58) then faj-container-after(s, faj-end(s, (fat-skip(s, keyEnd) + 1), depth), depth, 125) else faj-error(fat-skip(s, keyEnd), 10);
        def faj-container-after(s, end, depth, close) = if (end < 0) then end else faj-container-delim(s, fat-skip(s, end), depth, close);
        def faj-container-delim(s, i, depth, close) = if ((Comparable) fat-char(s, i) == close) then (i + 1) else if ((Comparable) fat-char(s, i) == 44) then faj-container(s, fat-skip(s, (i + 1)), depth, close, 0) else faj-error(i, if ((Comparable) close == 93) then 11 else 12);
        def faj-complete(s) = faj-complete-end(s, faj-end(s, 0, 0));
        def faj-complete-end(s, end) = if (end < 0) then end else if ((Comparable) fat-skip(s, end) == str_len(s)) then str_len(s) else faj-error(fat-skip(s, end), 13);
        def faj-valid(s) = (faj-complete(s) >= 0);
        def faj-valid-end(s, end) = if (end < 0) then 0 else ((Comparable) fat-skip(s, end) == str_len(s));
        // The diagnostic names syntax without copying source or answer text.
        // Offsets count bytes, starting at zero; end of input has no byte.
        def faj-diagnostic(s, error) {
            let at = faj-error-at(error);
            let present = (at < str_len(s));
            let byte = if present then fat-char(s, at) else 0;
            json-node-object([json-node-pair("byte_offset", json-node-int(at)), json-node-pair("expected", json-node-string(faj-expected(faj-error-reason(error)))), json-node-pair("found_byte", if present then json-node-int(byte) else json-node-null()), json-node-pair("found", json-node-string(if (!present) then "end-of-input" else if ((byte >= 32) && (byte < 127)) then byte_to_str(byte) else "non-printing-or-multibyte-byte"))]);
        }
        // At a mismatched closer, remove an extra closer or insert the missing
        // expected one. Exactly one single-byte candidate must be strict JSON.
        // String contents and every other byte stay untouched. EOF is not a
        // mismatched closer: unfinished generation receives no completion.
        def faj-closer-candidate(s, error) = if (error >= 0) then nothing() else if ((Comparable) faj-error-reason(error) == 13) then faj-root-closer-candidate(s,error) else {
            let at = faj-error-at(error);
            let reason = faj-error-reason(error);
            let expected = if ((Comparable) reason == 11) then 93 else if ((Comparable) reason == 12) then 125 else 0;
            let wrong = if ((Comparable) expected == 93) then 125 else 93;
            if (((Comparable) expected == 0) || (!((Comparable) fat-char(s,at) == wrong))) then nothing() else {
                let removed = str_concat(substring(s,0,at),substring(s,(at + 1),str_len(s)));
                let inserted = str_concat(substring(s,0,at),str_concat(byte_to_str(expected),substring(s,at,str_len(s))));
                let removalOk = (((Comparable) fat-char(s,fat-skip(s,(at + 1))) == expected) && faj-valid(removed));
                let insertionOk = faj-valid(inserted);
                if ((Comparable) removalOk == insertionOk) then nothing() else if removalOk then removed else inserted;
            };
        };
        // A completed root object followed by a comma can have closed one
        // member too early. Remove only its parser-proven final brace. The
        // remaining bytes must form one object with unique decoded keys, so
        // a trailing member cannot replace an already supplied command field.
        def faj-root-closer-candidate(s,error) {
            let end = faj-end(s,0,0);
            if (!(((Comparable) fat-char(s,fat-skip(s,0)) == 123) && ((end > 0) && (((Comparable) fat-char(s,faj-error-at(error)) == 44) && ((Comparable) fat-skip(s,end) == faj-error-at(error)))))) then nothing() else {
                let at = (end - 1);
                let candidate = str_concat(substring(s,0,at),substring(s,end,str_len(s)));
                if (!(((Comparable) fat-char(s,at) == 125) && faj-valid(candidate))) then nothing()
                else if faj-unique-pairs(node_children(parse-json("root-closer-candidate",candidate)),[]) then candidate else nothing();
            };
        }
        def faj-unique-pairs(pairs,keys) = if nil?(pairs) then 1 else {
            let key = json-pair-key(head(pairs));
            if fat-has(keys,key) then 0 else faj-unique-pairs(tail(pairs),cons(key,keys));
        };
        def faj-closer-offset(s,error) = if ((Comparable) faj-error-reason(error) == 13) then (faj-end(s,0,0) - 1) else faj-error-at(error);
        def faj-null() = intern_node(JSON-NULL(), []);
        def faj-array(xs) = intern_node(JSON-ARRAY(), xs);
        def faj-is(node, kind) = node_eq(node_category(node), kind);
        def faj-truth(node) = (!(faj-is(node, JSON-NULL()) || node_eq(node, intern_trivial_bool(false))));
        def faj-type(node) = if faj-is(node, JSON-OBJECT()) then "object" else if faj-is(node, JSON-ARRAY()) then "array" else if faj-is(node, JSON-NULL()) then "null" else if ((Comparable) node_type(node) == 2) then "string" else if ((Comparable) node_type(node) == 3) then "boolean" else "number";
        // The shared codec constructs cells; the query object model keeps the
        // last value for a repeated key, preserving its first insertion order.
        def faj-json(source, text) = faj-normalize(parse-json(source, text));
        def faj-normalize(node) = if faj-is(node, JSON-OBJECT()) then json-node-object(faj-normal-pairs(node_children(node), [])) else if faj-is(node, JSON-ARRAY()) then faj-array(faj-normal-items(node_children(node))) else node;
        def faj-normal-items(nodes) = if nil?(nodes) then [] else cons(faj-normalize(head(nodes)), faj-normal-items(tail(nodes)));
        def faj-normal-pairs(pairs, out) = if nil?(pairs) then out else faj-normal-pairs(tail(pairs), faj-put-pair(out, json-node-pair(json-pair-key(head(pairs)), faj-normalize(json-pair-value(head(pairs))))));
        def faj-put-pair(pairs, pair) = if nil?(pairs) then [pair] else if ((String) json-pair-key(head(pairs)) == json-pair-key(pair)) then cons(pair, tail(pairs)) else cons(head(pairs), faj-put-pair(tail(pairs), pair));

        // Compiler result: AST, error. Compilation precedes input evaluation.
        def faj-bad(error) = [[], error];
        def faj-built(ast) = [ast, ""];
        def faj-compile(s) = if (str_len(s) > 512) then faj-bad("query-limit") else faj-pipe(fat-trim(s), fat-split-top(fat-trim(s), "|"));
        def faj-pipe(s, split) = if (!((String) split[1] == "")) then faj-bad(split[1]) else if (len(head(split)) > 1) then faj-compile-many("pipe", head(split), []) else faj-fallback(s, fat-split-top(s, "//"));
        def faj-fallback(s, split) = if (len(head(split)) > 1) then faj-compile-many("fallback", head(split), []) else faj-simple(s);
        def faj-compile-many(kind, parts, out) = if nil?(parts) then faj-built([kind, fat-reverse(out)]) else faj-compiled-one(kind, parts, out, faj-compile(head(parts)));
        def faj-compiled-one(kind, parts, out, r) = if (!((String) r[1] == "")) then r else faj-compile-many(kind, tail(parts), cons(head(r), out));
        def faj-wrap(kind, compiled) = if (!((String) compiled[1] == "")) then compiled else faj-built([kind, head(compiled)]);
        def faj-simple(s) = if ((String) s == ".") then faj-built(["id"])
            else if fat-has(["keys", "length", "type", "empty", "sort", "unique", "to_entries"], s) then faj-built([s])
            else if (fat-starts(s, "map(") && fat-ends(s, ")")) then faj-wrap("map", faj-compile(substring(s, 4, (str_len(s) - 1))))
            else if (fat-starts(s, "has(") && fat-ends(s, ")")) then faj-wrap("has", faj-compile(substring(s, 4, (str_len(s) - 1))))
            else if (fat-starts(s, "contains(") && fat-ends(s, ")")) then faj-wrap("contains", faj-compile(substring(s, 9, (str_len(s) - 1))))
            else if (fat-starts(s, "select(") && fat-ends(s, ")")) then faj-wrap("select", faj-predicate(substring(s, 7, (str_len(s) - 1)), ["==", "!=", ">=", "<=", ">", "<"]))
            else if faj-valid(s) then faj-built(["literal", faj-json("resident-query-literal", s)])
            else if (fat-starts(s, "[") && fat-ends(s, "]")) then faj-wrap("collect", faj-compile(fat-strip(s, 1)))
            else if (fat-starts(s, "{") && fat-ends(s, "}")) then faj-object-compile(head(fat-split-top(fat-strip(s, 1), ",")), [])
            else if ((Comparable) fat-char(s, 0) == 46) then faj-path(s, 1, [])
            else if ((Comparable) fat-char(s, 0) == 36) then if faj-name(substring(s, 1, str_len(s))) then faj-built(["variable", substring(s, 1, str_len(s))]) else faj-bad("invalid-variable")
            else faj-bad("unsupported-jq-expression");
        def faj-predicate(s, ops) = if nil?(ops) then faj-compile(s) else faj-predicate-split(s, ops, head(fat-split-top(s, head(ops))));
        def faj-predicate-split(s, ops, parts) = if ((Comparable) len(parts) == 2) then faj-predicate-pair(head(ops), faj-compile(head(parts)), faj-compile(parts[1])) else if (len(parts) > 2) then faj-bad("chained-comparison-not-supported") else faj-predicate(s, tail(ops));
        def faj-predicate-pair(op, a, b) = if (!((String) a[1] == "")) then a else if (!((String) b[1] == "")) then b else faj-built(["compare", op, head(a), head(b)]);
        def faj-name-byte(c) = (fat-digit(c) || (((c >= 65) && (c <= 90)) || (((c >= 97) && (c <= 122)) || ((Comparable) c == 95))));
        def faj-name-end(s, i) = if faj-name-byte(fat-char(s, i)) then faj-name-end(s, (i + 1)) else i;
        def faj-name(s) = ((str_len(s) > 0) && ((!fat-digit(fat-char(s, 0))) && ((Comparable) faj-name-end(s, 0) == str_len(s))));
        def faj-path(s, i, parts) = if (i >= str_len(s)) then faj-built(["path", fat-reverse(parts)]) else if ((Comparable) fat-char(s, i) == 46) then if (((Comparable) fat-char(s, (i - 1)) == 46) || ((Comparable) fat-char(s, (i + 1)) == 0)) then faj-bad("empty-path-segment") else faj-path(s, (i + 1), parts) else if ((Comparable) fat-char(s, i) == 91) then faj-path-bracket(s, i, parts) else if ((Comparable) fat-char(s, (i - 1)) == 93) then faj-bad("missing-path-separator") else faj-path-key(s, i, faj-name-end(s, i), parts);
        def faj-path-key(s, i, end, parts) = if ((Comparable) i == end) then faj-bad("unsupported-path-syntax") else if ((end >= str_len(s)) || (((Comparable) fat-char(s, end) == 46) || ((Comparable) fat-char(s, end) == 91))) then faj-path(s, end, cons(["key", substring(s, i, end)], parts)) else faj-bad("unsupported-path-syntax");
        def faj-path-bracket(s, i, parts) = faj-path-bracket-end(s, i, faj-bracket-end(s, fat-skip(s, (i + 1))), parts);
        def faj-bracket-end(s, i) = if ((Comparable) fat-char(s, i) == 34) then faj-quoted-bracket-end(s, faj-string(s, (i + 1))) else str_find(s, "]", i);
        def faj-quoted-bracket-end(s, end) = if (end < 0) then -1 else if ((Comparable) fat-char(s, fat-skip(s, end)) == 93) then fat-skip(s, end) else -1;
        def faj-path-bracket-end(s, i, end, parts) = if (end < 0) then faj-bad("unclosed-path-bracket") else faj-path-index(s, end, fat-trim(substring(s, (i + 1), end)), parts);
        def faj-path-index(s, end, index, parts) = if ((String) index == "") then faj-path(s, (end + 1), cons(["each"], parts)) else if fat-natural(index) then faj-path(s, (end + 1), cons(["index", str_to_int(index)], parts)) else if (((Comparable) fat-char(index, 0) == 34) && faj-valid(index)) then faj-path(s, (end + 1), cons(["key", node_value(parse-json("resident-query-key", index))], parts)) else faj-bad("unsupported-array-index");
        def faj-object-compile(parts, out) = if nil?(parts) then faj-built(["object", fat-reverse(out)]) else faj-object-pair(parts, out, head(fat-split-top(head(parts), ":")));
        def faj-object-pair(parts, out, pair) = if (!((Comparable) len(pair) == 2)) then faj-bad("object-needs-key-and-expression") else faj-object-key(parts, out, head(pair), faj-compile(pair[1]));
        def faj-object-key(parts, out, key, r) = if (!((String) r[1] == "")) then r else if faj-name(key) then faj-object-compile(tail(parts), cons([key, head(r)], out)) else if (((Comparable) fat-char(key, 0) == 34) && faj-valid(key)) then faj-object-compile(tail(parts), cons([node_value(parse-json("resident-query-key", key)), head(r)], out)) else faj-bad("invalid-object-key");

        // Evaluation result: stream of JSON nodes, error. No error is a value.
        def faj-values(xs) = [xs, ""];
        def faj-one(node) = faj-values([node]);
        def faj-eval(ast, node, vars) {
            let kind = head(ast);
            if ((String) kind == "id") then faj-one(node)
            else if ((String) kind == "literal") then faj-one(ast[1])
            else if ((String) kind == "variable") then faj-var(vars, ast[1])
            else if ((String) kind == "empty") then faj-values([])
            else if ((String) kind == "pipe") then faj-pipeline(ast[1], [node], vars)
            else if ((String) kind == "fallback") then faj-fallback-eval(ast[1], node, vars)
            else if ((String) kind == "path") then faj-path-eval(ast[1], [node])
            else if ((String) kind == "map") then if faj-is(node, JSON-ARRAY()) then faj-collected(faj-each(ast[1], node_children(node), vars)) else faj-bad("map-needs-array")
            else if ((String) kind == "collect") then faj-collected(faj-eval(ast[1], node, vars))
            else if ((String) kind == "has") then faj-has-result(node, faj-eval(ast[1], node, vars))
            else if ((String) kind == "contains") then faj-contains-result(node, faj-eval(ast[1], node, vars))
            else if ((String) kind == "select") then faj-selected(node, faj-eval(ast[1], node, vars))
            else if ((String) kind == "compare") then faj-compared(ast[1], faj-eval(ast[2], node, vars), faj-eval(ast[3], node, vars))
            else if ((String) kind == "object") then faj-object-eval(ast[1], node, vars, [])
            else if fat-has(["sort", "unique"], kind) then faj-sorted(kind, node)
            else faj-builtin(kind, node);
        }
        def faj-var(vars, name) = if nil?(vars) then faj-bad("unbound-variable") else if ((String) head(head(vars)) == name) then faj-one(head(vars)[1]) else faj-var(tail(vars), name);
        def faj-bound(ast, vars) = if ((String) head(ast) == "variable") then ((String) faj-var(vars, ast[1])[1] == "") else if fat-has(["pipe", "fallback"], head(ast)) then faj-bound-many(ast[1], vars) else if fat-has(["map", "collect", "select", "has", "contains"], head(ast)) then faj-bound(ast[1], vars) else if ((String) head(ast) == "compare") then (faj-bound(ast[2], vars) && faj-bound(ast[3], vars)) else if ((String) head(ast) == "object") then faj-bound-pairs(ast[1], vars) else 1;
        // Object-key presence is distinct from a missing key resolving to null.
        // Array-index has is outside this query subset and returns an error.
        def faj-has-result(node, result) = if (!((String) result[1] == "")) then result else if (!faj-is(node, JSON-OBJECT())) then faj-bad("has-needs-object") else faj-has-keys(node, head(result));
        def faj-has-keys(node, keys) = if nil?(keys) then faj-values([]) else if (!((String) faj-type(head(keys)) == "string")) then faj-bad("has-needs-string-key") else faj-joined(faj-one(intern_trivial_bool(json-object-has?(node, node_value(head(keys))))), faj-has-keys(node, tail(keys)));
        // Literal substring presence only. Collection containment is outside
        // this resident subset; punctuation presence is not semantic quality.
        def faj-contains-result(node, result) = if (!((String) result[1] == "")) then result else if (!((String) faj-type(node) == "string")) then faj-bad("contains-needs-string-input") else faj-contains-strings(node_value(node), head(result));
        def faj-contains-strings(text, needles) = if nil?(needles) then faj-values([]) else if (!((String) faj-type(head(needles)) == "string")) then faj-bad("contains-needs-string-argument") else faj-joined(faj-one(intern_trivial_bool((str_find(text, node_value(head(needles)), 0) >= 0))), faj-contains-strings(text, tail(needles)));
        def faj-bound-many(asts, vars) = if nil?(asts) then 1 else (faj-bound(head(asts), vars) && faj-bound-many(tail(asts), vars));
        def faj-bound-pairs(pairs, vars) = if nil?(pairs) then 1 else (faj-bound(head(pairs)[1], vars) && faj-bound-pairs(tail(pairs), vars));
        def faj-each(ast, nodes, vars) = if nil?(nodes) then faj-values([]) else faj-append(faj-eval(ast, head(nodes), vars), ast, tail(nodes), vars);
        def faj-append(r, ast, rest, vars) = if (!((String) r[1] == "")) then r else faj-joined(r, faj-each(ast, rest, vars));
        def faj-joined(a, b) = if (!((String) b[1] == "")) then b else faj-values(append(head(a), head(b)));
        def faj-pipeline(stages, nodes, vars) = if nil?(stages) then faj-values(nodes) else faj-pipeline-next(stages, vars, faj-each(head(stages), nodes, vars));
        def faj-pipeline-next(stages, vars, r) = if (!((String) r[1] == "")) then r else faj-pipeline(tail(stages), head(r), vars);
        def faj-truths(nodes) = if nil?(nodes) then [] else if faj-truth(head(nodes)) then cons(head(nodes), faj-truths(tail(nodes))) else faj-truths(tail(nodes));
        def faj-fallback-eval(stages, node, vars) = if nil?(stages) then faj-values([]) else faj-fallback-next(stages, node, vars, faj-eval(head(stages), node, vars));
        def faj-fallback-next(stages, node, vars, r) = if (!((String) r[1] == "")) then r else if (len(faj-truths(head(r))) > 0) then faj-values(faj-truths(head(r))) else if nil?(tail(stages)) then r else faj-fallback-eval(tail(stages), node, vars);
        def faj-collected(r) = if (!((String) r[1] == "")) then r else faj-one(faj-array(head(r)));
        def faj-selected(node, r) = if (!((String) r[1] == "")) then r else if (len(faj-truths(head(r))) > 0) then faj-one(node) else faj-values([]);
        def faj-path-eval(parts, nodes) = if nil?(parts) then faj-values(nodes) else faj-path-next(parts, faj-path-many(head(parts), nodes));
        def faj-path-next(parts, r) = if (!((String) r[1] == "")) then r else faj-path-eval(tail(parts), head(r));
        def faj-path-many(part, nodes) = if nil?(nodes) then faj-values([]) else faj-path-combine(part, tail(nodes), faj-path-one(part, head(nodes)));
        def faj-path-combine(part, rest, r) = if (!((String) r[1] == "")) then r else faj-joined(r, faj-path-many(part, rest));
        def faj-path-one(part, node) = if ((String) head(part) == "key") then if faj-is(node, JSON-NULL()) then faj-one(faj-null()) else if faj-is(node, JSON-OBJECT()) then faj-one(json-object-get-loop(node_children(node), part[1], faj-null())) else faj-bad("key-needs-object") else if ((String) head(part) == "index") then if faj-is(node, JSON-NULL()) then faj-one(faj-null()) else if faj-is(node, JSON-ARRAY()) then faj-one(if (part[1] < len(node_children(node))) then node_children(node)[part[1]] else faj-null()) else faj-bad("index-needs-array") else if faj-is(node, JSON-ARRAY()) then faj-values(node_children(node)) else if faj-is(node, JSON-OBJECT()) then faj-values(faj-object-values(node_children(node))) else faj-bad("iteration-needs-array-or-object");
        def faj-object-values(pairs) = if nil?(pairs) then [] else cons(json-pair-value(head(pairs)), faj-object-values(tail(pairs)));
        def faj-object-eval(pairs, node, vars, out) = if nil?(pairs) then faj-one(json-node-object(out)) else faj-object-evaluated(pairs, node, vars, out, faj-eval(head(pairs)[1], node, vars));
        def faj-object-evaluated(pairs, node, vars, out, r) = if (!((String) r[1] == "")) then r else if (!((Comparable) len(head(r)) == 1)) then faj-bad("object-field-needs-one-value") else faj-object-eval(tail(pairs), node, vars, faj-put-pair(out, json-node-pair(head(head(pairs)), head(head(r)))));
        def faj-compared(op, a, b) = if (!((String) a[1] == "")) then a else if (!((String) b[1] == "")) then b else if (!(((Comparable) len(head(a)) == 1) && ((Comparable) len(head(b)) == 1))) then faj-bad("comparison-needs-one-value") else faj-compare(op, head(head(a)), head(head(b)));
        def faj-compare(op, a, b) = if ((String) op == "==") then faj-one(intern_trivial_bool(faj-equal(a, b))) else if ((String) op == "!=") then faj-one(intern_trivial_bool((!faj-equal(a, b)))) else if (((String) faj-type(a) == "number") && ((String) faj-type(b) == "number")) then faj-one(intern_trivial_bool(if ((String) op == ">") then (node_value(a) > node_value(b)) else if ((String) op == "<") then (node_value(a) < node_value(b)) else if ((String) op == ">=") then (node_value(a) >= node_value(b)) else (node_value(a) <= node_value(b)))) else faj-bad("ordered-comparison-needs-numbers");
        def faj-equal(a, b) = if (!((String) faj-type(a) == faj-type(b))) then 0 else if faj-is(a, JSON-ARRAY()) then faj-equal-array(node_children(a), node_children(b)) else if faj-is(a, JSON-OBJECT()) then (((Comparable) len(node_children(a)) == len(node_children(b))) && faj-equal-object(node_children(a), b)) else if ((String) faj-type(a) == "number") then ((Comparable) node_value(a) == node_value(b)) else ((String) json-emit(a) == json-emit(b));
        def faj-equal-array(a, b) = if nil?(a) then nil?(b) else if nil?(b) then 0 else (faj-equal(head(a), head(b)) && faj-equal-array(tail(a), tail(b)));
        def faj-equal-object(pairs, b) = if nil?(pairs) then 1 else (fat-has(json-object-keys(b), json-pair-key(head(pairs))) && (faj-equal(json-pair-value(head(pairs)), json-object-get-loop(node_children(b), json-pair-key(head(pairs)), faj-null())) && faj-equal-object(tail(pairs), b)));
        def faj-strings(xs) = if nil?(xs) then [] else cons(intern_trivial_string(head(xs)), faj-strings(tail(xs)));
        def faj-indices(i, n) = if (i >= n) then [] else cons(intern_trivial_int(i), faj-indices((i + 1), n));
        def faj-codepoints(s, i, n) = if (i >= str_len(s)) then n else faj-codepoints(s, (i + 1), if ((fat-char(s, i) < 128) || (fat-char(s, i) >= 192)) then (n + 1) else n);
        def faj-builtin(kind, node) = if ((String) kind == "type") then faj-one(intern_trivial_string(faj-type(node))) else if ((String) kind == "length") then if (faj-is(node, JSON-OBJECT()) || faj-is(node, JSON-ARRAY())) then faj-one(intern_trivial_int(len(node_children(node)))) else if faj-is(node, JSON-NULL()) then faj-one(intern_trivial_int(0)) else if ((Comparable) node_type(node) == 2) then faj-one(intern_trivial_int(faj-codepoints(node_value(node), 0, 0))) else faj-bad("length-needs-container") else if ((String) kind == "keys") then if faj-is(node, JSON-OBJECT()) then faj-one(faj-array(faj-strings(faj-string-sort(json-object-keys(node))))) else if faj-is(node, JSON-ARRAY()) then faj-one(faj-array(faj-indices(0, len(node_children(node))))) else faj-bad("keys-needs-container") else if ((String) kind == "to_entries") then if faj-is(node, JSON-OBJECT()) then faj-one(faj-array(faj-entries(node_children(node)))) else faj-bad("to_entries-needs-object") else faj-bad("unsupported-jq-operation");
        def faj-string-sort(xs) = sh-sort(xs);
        def faj-scalar-rank(node) = if faj-is(node, JSON-NULL()) then 0 else if ((Comparable) node_type(node) == 3) then if node_eq(node, intern_trivial_bool(false)) then 1 else 2 else if ((String) faj-type(node) == "number") then 3 else if ((Comparable) node_type(node) == 2) then 4 else 5;
        def faj-scalar-less(a, b) = if (!((Comparable) faj-scalar-rank(a) == faj-scalar-rank(b))) then (faj-scalar-rank(a) < faj-scalar-rank(b)) else if ((Comparable) faj-scalar-rank(a) == 3) then (node_value(a) < node_value(b)) else if ((Comparable) faj-scalar-rank(a) == 4) then sh-str-lt(node_value(a), node_value(b)) else 0;
        def faj-scalar-insert(x, xs) = if nil?(xs) then [x] else if faj-scalar-less(x, head(xs)) then cons(x, xs) else cons(head(xs), faj-scalar-insert(x, tail(xs)));
        def faj-scalar-sort(xs) = if nil?(xs) then [] else faj-scalar-insert(head(xs), faj-scalar-sort(tail(xs)));
        def faj-scalars(xs) = if nil?(xs) then 1 else if (faj-scalar-rank(head(xs)) >= 5) then 0 else faj-scalars(tail(xs));
        def faj-unique(xs) = if nil?(xs) then [] else if nil?(tail(xs)) then xs else if faj-equal(head(xs), xs[1]) then faj-unique(tail(xs)) else cons(head(xs), faj-unique(tail(xs)));
        def faj-sorted(kind, node) =
            if (!faj-is(node, JSON-ARRAY())) then faj-bad("sort-needs-array")
            else if (len(node_children(node)) > FatMaxSortItems()) then faj-bad("sort-item-limit")
            else if (!faj-scalars(node_children(node))) then faj-bad("sort-supports-scalars-only")
            else faj-one(faj-array(if ((String) kind == "unique") then faj-unique(faj-scalar-sort(node_children(node))) else faj-scalar-sort(node_children(node))));
        def faj-entries(pairs) = if nil?(pairs) then [] else cons(json-node-object([json-node-pair("key", intern_trivial_string(json-pair-key(head(pairs)))), json-node-pair("value", json-pair-value(head(pairs)))]), faj-entries(tail(pairs)));
        def faj-render(nodes, raw) = if nil?(nodes) then "" else str_concat(if (raw && ((Comparable) node_type(head(nodes)) == 2)) then node_value(head(nodes)) else json-emit(head(nodes)), str_concat("\n", faj-render(tail(nodes), raw)));
    }
}
