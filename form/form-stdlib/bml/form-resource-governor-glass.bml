package Form.runtime.resourcegovernorglass;

import Form.kernel.*;

interface IFormResourceGovernorGlass [public, witness, reusable] {
   section [public] {
      const String Schema = "form-resource-governor-glass-v1";
      const String Publisher = "resource.governor";
      const String TargetRule = "CPU GPU and unified-memory rows carry current grant as bytes target as capacity and grant-per-target as heat only when target is physically grounded above zero; a fail-closed zero target is unavailable rather than measured zero-over-zero";
      const String PressureRule = "memory pressure is physical-live only when its typed signal carries current full-process provenance; unknown pressure publishes absent fields and unknown lifecycle";
      const String AdmissionRule = "the Metal admission row distinguishes open offer atomic reservation exact correlated submit and refusal while the reason remains a named row and frame field; admitted tags alone carry no authority";
      const String PermitRule = "the frame retains exact permit id publisher pid process start incarnation base sequence base observation submit sequence submit observation and command-buffer handle; Glass rows project only bounded fields";
      const String BackoffRule = "additive recovery half backoff stop backoff and invalid input are separate visible reason rows";
      const String ReleaseRule = "release status required bytes reclaimed bytes selection count and reason remain distinct; unavailable pressure is refusal rather than zero";
      const String SlotRule = "absent current unknown stale and refused physical singleton observations remain distinct and unknown ownership is failed closed";
      const String SafetyRule = "a non-current sample can project only a zero-grant typed-signal-not-current decision; an optimistic mismatch becomes adapter-input-invalid with absent grants";
      const String PublicationRule = "the adapter publishes through the existing atomic Glass telemetry membrane and never writes dashboard or layout state";

      Object Project( Object policy, Object sample, Object decision, Object consumeResult, Object submitBind, Object quantum, Object releasePlan, Object slotObservation, int nEpoch ) [abstract];
      Object Samples( Object frame ) [abstract];
      Object Publish( String sRoot, int nEpoch, Object frame ) [abstract];
   }
}

class FormResourceGovernorGlass [public, observable, teach] : IFormResourceGovernorGlass {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-resource-governor-glass.bml";
      const String AuthorityPath = "form/form-stdlib/bml/form-resource-governor-glass.bml";
      const String TelemetryPrelude = "form/form-stdlib/form-glass-telemetry-membrane.bml";
      const String GovernorPrelude = "form/form-stdlib/form-resource-governor.bml";
      const String GlassRoot = FormHearth.HearthTelemetryRoot;

      Object Project( Object policy, Object sample, Object decision, Object consumeResult, Object submitBind, Object quantum, Object releasePlan, Object slotObservation, int nEpoch ) [abstract] {}
      Object Samples( Object frame ) [abstract] {}
      Object Publish( String sRoot, int nEpoch, Object frame ) [abstract] {}
   }
}
