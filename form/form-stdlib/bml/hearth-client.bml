// Native task delivery. The C seed's read_line returns chunks at its byte
// boundary; assemble the complete physical line before offering the task.
// File-backed requests preserve multiline source packets directly.
// preludes: form-stdlib/hearth.bml form-stdlib/lane-motion.bml form-stdlib/organ-health.bml
section [form.bml] {
 class HearthClient {
  field SeedLineChunkBytes = 8191;
  def hc-body-line() = hc-line-chunks(read_line(), "");
  def hc-line-chunks(part,held) = if nothing?(part) then if str_eq(held,"") then nothing() else held else if eq(str_len(part),SeedLineChunkBytes()) then hc-line-chunks(read_line(),str_concat(held,part)) else str_concat(held,part);
  def hc-send(turn0,kind,body) {
   if or(nothing?(body),str_eq(body,"")) then form_error("hearth task body is absent") else 0;
   if eq(hearth-standing(),0) then {
    print("signal=nothing"); print("reason=no-standing-hearth"); 0;
   } else {
    let turn = if le(turn0,0) then add(lms-max-turn(read_file(hearth-task())),1) else turn0;
    let frame = str_concat(fcpa-task-frame(turn,kind,body),"\n");
    let appended = sbt-append-count(hearth-task(),frame);
    let complete = eq(appended,str_len(frame));
    let evidence = json-node-object(list(oh-n("turn",turn),oh-n("body_bytes",str_len(body)),oh-n("frame_bytes",str_len(frame))));
    let reading = oh-voice(oh-reading("hearth-client",int_to_str(host_pid()),"task-append",json-node-int(str_len(frame)),json-node-int(appended),json-node-int(complete),if complete then list() else list(oh-need("durable-task-append",evidence)),list("inspect-spool"),evidence));
    if not(complete) then form_error("hearth task append is incomplete; inspect the spool before another send") else {
     let rung = sbt-ring(hearth-bell());
     if not(eq(rung,1)) then form_error("hearth task is appended; bell delivery failed; ring the existing task without appending again") else 0;
     print(str_concat("sent turn=",str_concat(int_to_str(turn),str_concat(" to-pid=",str_concat(int_to_str(hearth-board-pid()),str_concat(" body-bytes=",int_to_str(str_len(body))))))));
     0;
    };
   };
  }
  def hc-send-file(request) {
   let path = oh-str(request,"body_path");
   let body = read_file(path);
   if or(nothing?(body),ne(str_len(body),file_size(path))) then form_error("hearth body file could not be read completely") else hc-send(if json-object-has?(request,"turn") then json-int-value(oh-get(request,"turn")) else 0,if json-object-has?(request,"kind") then oh-str(request,"kind") else hearth-kind-answer(),body);
  }
 }
}
