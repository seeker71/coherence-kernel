// Native task delivery. The C seed's read_line returns chunks at its byte
// boundary; assemble the complete physical line before offering the task.
// File-backed requests preserve multiline source packets directly.
// preludes: form-stdlib/hearth.bml form-stdlib/lane-motion.bml form-stdlib/organ-health.bml
section [form.bml] {
 class HearthClient {
  field SeedLineChunkBytes = 8191;
  def hc-body-line() = hc-line-chunks(read_line(), "");
  def hc-line-chunks(part,held) = nothing?(part) ? ((String) held == "" ? nothing() : held) : (Comparable) str_len(part) == SeedLineChunkBytes() ? hc-line-chunks(read_line(),held ++ part) : held ++ part;
  def hc-send(turn0,kind,body) {
   nothing?(body) || ((String) body == "") ? form_error("hearth task body is absent") : 0;
   (Comparable) hearth-standing() == 0 ? {
    print("signal=nothing"); print("reason=no-standing-hearth"); 0;
   } : {
    let turn = turn0 <= 0 ? (lms-max-turn(read_file(hearth-task())) + 1) : turn0;
    let frame = fcpa-task-frame(turn,kind,body) ++ "\n";
    let appended = sbt-append-count(hearth-task(),frame);
    let complete = (Comparable) appended == str_len(frame);
    let evidence = json-node-object(list(oh-n("turn",turn),oh-n("body_bytes",str_len(body)),oh-n("frame_bytes",str_len(frame))));
    let reading = oh-voice(oh-reading("hearth-client",int_to_str(host_pid()),"task-append",json-node-int(str_len(frame)),json-node-int(appended),json-node-int(complete),complete ? list() : list(oh-need("durable-task-append",evidence)),list("inspect-spool"),evidence));
    !complete ? form_error("hearth task append is incomplete; inspect the spool before another send") : {
     let rung = sbt-ring(hearth-bell());
     !((Comparable) rung == 1) ? form_error("hearth task is appended; bell delivery failed; ring the existing task without appending again") : 0;
     print("sent turn=" ++ int_to_str(turn) ++ " to-pid=" ++ int_to_str(hearth-board-pid()) ++ " body-bytes=" ++ int_to_str(str_len(body)));
     0;
    };
   };
  }
  def hc-send-file(request) {
   let path = oh-str(request,"body_path");
   let body = read_file(path);
   nothing?(body) || ((Comparable) str_len(body) != file_size(path)) ? form_error("hearth body file could not be read completely") : hc-send(json-object-has?(request,"turn") ? json-int-value(oh-get(request,"turn")) : 0,json-object-has?(request,"kind") ? oh-str(request,"kind") : hearth-kind-answer(),body);
  }
 }
}
