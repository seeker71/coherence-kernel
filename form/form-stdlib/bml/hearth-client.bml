// Native task delivery. The C seed's read_line returns chunks at its byte
// boundary; assemble the complete physical line before offering the task.
// File-backed requests preserve multiline source packets directly.
import form-stdlib/hearth.bml;
import form-stdlib/lane-motion.bml;
import form-stdlib/organ-health.bml;
section [form.bml] {
 class HearthClient {
  field SeedLineChunkBytes = 8191;
  def hc-body-line() = hc-line-chunks(read_line(), "");
  def hc-line-chunks(part,held) = if nothing?(part) then if ((String) held == "") then nothing() else held else if ((Comparable) len(part) == SeedLineChunkBytes()) then hc-line-chunks(read_line(),((String) held + part)) else ((String) held + part);
  def hc-send(turn0,kind,body) {
   if (nothing?(body) || ((String) body == "")) then form_error("hearth task body is absent") else 0;
   if ((Comparable) hearth-standing() == 0) then {
    print("signal=nothing"); print("reason=no-standing-hearth"); 0;
   } else {
    let turn = if (turn0 <= 0) then (lms-max-turn(read_file(hearth-task())) + 1) else turn0;
    let frame = (fcpa-task-frame(turn,kind,body) + "\n");
    let appended = sbt-append-count(hearth-task(),frame);
    let complete = ((Comparable) appended == len(frame));
    let evidence = json-node-object([oh-n("turn",turn),oh-n("body_bytes",len(body)),oh-n("frame_bytes",len(frame))]);
    let reading = oh-voice(oh-reading("hearth-client",host_pid().str(),"task-append",json-node-int(len(frame)),json-node-int(appended),json-node-int(complete),if complete then [] else [oh-need("durable-task-append",evidence)],["inspect-spool"],evidence));
    if (!complete) then form_error("hearth task append is incomplete; inspect the spool before another send") else {
     let rung = sbt-ring(hearth-bell());
     if (!((Comparable) rung == 1)) then form_error("hearth task is appended; bell delivery failed; ring the existing task without appending again") else 0;
     print(("sent turn=" + (turn.str() + (" to-pid=" + (hearth-board-pid().str() + (" body-bytes=" + len(body).str()))))));
     0;
    };
   };
  }
  def hc-send-file(request) {
   let path = oh-str(request,"body_path");
   let body = read_file(path);
   if (nothing?(body) || ((Comparable) len(body) != file_size(path))) then form_error("hearth body file could not be read completely") else hc-send(if json-object-has?(request,"turn") then json-int-value(oh-get(request,"turn")) else 0,if json-object-has?(request,"kind") then oh-str(request,"kind") else hearth-kind-answer(),body);
  }
 }
}
