//////////////////////////////////////////////////////////////////////
// frame-luma.bml — the 24-bit BMP interpretation belongs to Form.
//
// The host carrier owes bytes. This cell validates their media shape and
// folds pixels into a nine-value heuristic row: present, side, mean,
// dark%, left/center/right mean, width,
// height. The divide-and-combine walk keeps call depth logarithmic.
//
// preludes: form-stdlib/core.fk
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FrameLuma {
        thought frame-luma-boundary = list("host-reads-owned-bytes", "Form-validates-media", "Form-folds-pixels", "Form-selects-policy");

        def flm-default-policy() = list(60, 8, 75, 12);
        def flm-integer?(v, low, high) = (((String) value_kind(v) == "int") && ((v >= low) && (v <= high)));
        def flm-policy-valid?(p) = if (!((String) value_kind(p) == "list")) then 0 else if (!((Comparable) len(p) == 4)) then 0
            else (flm-integer?(nth(p, 0), 0, 256) && (flm-integer?(nth(p, 1), 0, 100) && (flm-integer?(nth(p, 2), nth(p, 1), 100) && flm-integer?(nth(p, 3), 0, 255))));
        // Positive tagged integer range; both sums and percent products fit.
        def flm-max-pixels() = (4611686018427387903 / 255);

        def flm-u16(s, i) = (str_byte_at(s, i) + (str_byte_at(s, (i + 1)) * 256));
        def flm-u32(s, i) = (flm-u16(s, i) + (flm-u16(s, (i + 2)) * 65536));
        def flm-s32(s, i) {
            let u = flm-u32(s, i);
            if (u >= 2147483648) then (u - 4294967296) else u;
        }
        def flm-height(signed-height) = if (signed-height < 0) then (0 - signed-height) else signed-height;
        def flm-row-bytes(width) = band(((width * 3) + 3), -4);

        // sum, dark, left sum, center sum, right sum, and their three counts
        def flm-zero() = list(0, 0, 0, 0, 0, 0, 0, 0);
        def flm-merge(a, b) = list(
            (nth(a, 0) + nth(b, 0)), (nth(a, 1) + nth(b, 1)),
            (nth(a, 2) + nth(b, 2)), (nth(a, 3) + nth(b, 3)),
            (nth(a, 4) + nth(b, 4)), (nth(a, 5) + nth(b, 5)),
            (nth(a, 6) + nth(b, 6)), (nth(a, 7) + nth(b, 7)));
        def flm-one(s, offset, row-bytes, width, pixel, dark) {
            let x = (pixel % width);
            let y = (pixel / width);
            let at = (offset + ((y * row-bytes) + (x * 3)));
            let lum = ((str_byte_at(s, at) + (str_byte_at(s, (at + 1)) + str_byte_at(s, (at + 2)))) / 3);
            let left = (x < (width / 3));
            let center = ((!left) && (x < ((width * 2) / 3)));
            list(lum, if (lum < dark) then 1 else 0,
                if left then lum else 0, if center then lum else 0,
                if (left || center) then 0 else lum,
                if left then 1 else 0, if center then 1 else 0,
                if (left || center) then 0 else 1);
        }
        def flm-fold(s, offset, row-bytes, width, first, after, dark) =
            if (first >= after) then flm-zero()
            else if ((Comparable) (first + 1) == after) then flm-one(s, offset, row-bytes, width, first, dark)
            else flm-fold-halves(s, offset, row-bytes, width, first, after, ((first + after) / 2), dark);
        def flm-fold-halves(s, offset, row-bytes, width, first, after, middle, dark) =
            flm-merge(flm-fold(s, offset, row-bytes, width, first, middle, dark),
                      flm-fold(s, offset, row-bytes, width, middle, after, dark));

        def flm-shape-valid?(s, dib, offset, width, signed-height, height, row-bytes) =
            if (str_len(s) < 54) then 0
            else if (!(((Comparable) str_byte_at(s, 0) == 66) && ((Comparable) str_byte_at(s, 1) == 77))) then 0
            else if (dib < 40) then 0
            else if (dib > (str_len(s) - 14)) then 0
            else if (offset < (14 + dib)) then 0
            else if (offset > str_len(s)) then 0
            else if (!((Comparable) flm-u16(s, 26) == 1)) then 0
            else if (!((Comparable) flm-u16(s, 28) == 24)) then 0
            else if (!((Comparable) flm-u32(s, 30) == 0)) then 0
            else if (width <= 0) then 0
            else if ((Comparable) signed-height == 0) then 0
            else if (row-bytes <= 0) then 0
            else if (height > ((str_len(s) - offset) / row-bytes)) then 0
            else if (height > (flm-max-pixels() / width)) then 0
            else 1;

        def flm-result-policy(fold, width, height, policy) {
            let count = (width * height);
            let mean = if ((Comparable) count == 0) then 0 else (nth(fold, 0) / count);
            let dark-percent = if ((Comparable) count == 0) then 0 else ((nth(fold, 1) * 100) / count);
            let left-mean = if ((Comparable) nth(fold, 5) == 0) then 0 else (nth(fold, 2) / nth(fold, 5));
            let center-mean = if ((Comparable) nth(fold, 6) == 0) then 0 else (nth(fold, 3) / nth(fold, 6));
            let right-mean = if ((Comparable) nth(fold, 7) == 0) then 0 else (nth(fold, 4) / nth(fold, 7));
            let side = if ((left-mean <= center-mean) && (left-mean <= right-mean)) then 0 else if ((center-mean <= left-mean) && (center-mean <= right-mean)) then 1 else 2;
            let spread = if (left-mean > right-mean) then (left-mean - right-mean) else (right-mean - left-mean);
            // The default preserves the historical empty-third means (zero).
            // This is a luminance heuristic, not an identity or presence proof.
            let present = if (((dark-percent >= nth(policy, 1)) && (dark-percent <= nth(policy, 2))) && (spread >= nth(policy, 3))) then 1 else 0;
            list(present, side, mean, dark-percent, left-mean, center-mean, right-mean, width, height);
        }

        def flm-result(fold, width, height) = flm-result-policy(fold, width, height, flm-default-policy());
        def flm-layout(s) = if nothing?(s) then nothing() else if (!((String) value_kind(s) == "string")) then nothing() else if (str_len(s) < 54) then nothing() else flm-layout-header(s);
        def flm-layout-header(s) {
            let dib = flm-u32(s, 14);
            let offset = flm-u32(s, 10);
            let width = flm-s32(s, 18);
            let signed-height = flm-s32(s, 22);
            let height = flm-height(signed-height);
            let row-bytes = flm-row-bytes(width);
            if ((Comparable) flm-shape-valid?(s, dib, offset, width, signed-height, height, row-bytes) == 0) then nothing()
            else list(offset, row-bytes, width, height, (width * height));
        }
        def flm-stat-policy(s, policy) = if (!flm-policy-valid?(policy)) then nothing() else flm-stat-layout(s, policy, flm-layout(s));
        def flm-stat-layout(s, policy, layout) = if nothing?(layout) then nothing() else flm-result-policy(flm-fold(s, nth(layout, 0), nth(layout, 1), nth(layout, 2), 0, nth(layout, 4), head(policy)), nth(layout, 2), nth(layout, 3), policy);
        def flm-stat(s) = flm-stat-policy(s, flm-default-policy());
        def flm-read(path, policy) = flm-stat-policy(read_file(path), policy);
        def flm-mean-file(path, policy) {
            let row = flm-read(path, policy);
            if nothing?(row) then -1 else nth(row, 2);
        }
    }
    0;
}
