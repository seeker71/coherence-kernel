// host-walk-exam.bml — the night's exam with the network denied (observe/offline-exam-run.bml), first of the model doors: a turn or a plan can spend the whole window, and the exam's rows are what the register reads.
// hw-exam gives the door half of what the window leaves past the lift's room, as until_ms, and the door names what that could not hold; night only. A child through host-child.bml like its siblings, its output under .hearth/walk-io/exam.out.
// PROOF: form-stdlib/tests/offline-exam-band.bml, form-stdlib/tests/host-walk-learn-band.bml (its place in the night); a safe start skips it (hw-safe-skips?, host-walk-began.bml).
import form-stdlib/bml/host-walk-learn.bml;
section [form.bml] {
 class HostWalkExam {
  def hw-exam-door() = "observe/offline-exam-run.bml";
  def hw-exam-until(until, now) = now + (until - hw-lift-room-ms() - now) / 2;
  def hw-exam-at(io, door, until) = hw-learn-door(io, "exam", door, json-emit(json-node-object([fhn-n("until_ms", hw-exam-until(until, host_monotonic_ms()))])) ++ "\n", until + hw-backstop-ms(), run => hw-learn-lines("exam", run, ["[offline-exam]", "[alignment"]));
  def hw-exam(until) {
   let said = hw-say(hw-yield(until));
   hw-exam-at(hch-dir(), hw-exam-door(), until);
  }
 }
}
