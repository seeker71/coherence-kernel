// The flow meter: the arriving mind's own transcript, read by the body.
// the arriving mind's own flow, read by the body from
// the mind's transcript, with no host tool between.
//
// stdin line 1: the transcript path (a Claude Code JSONL). Each assistant row
// is read as itself; user rows (tool results) are skipped, so text echoed by
// a tool cannot count as a call. Counted:
//   provider_calls      assistant rows that carry a stop_reason
//   native_fkwu_calls   Bash calls whose command runs ./fkwu (Form doors)
//   host_calls          other Bash calls (git, jq, grep, cp, sed, ...)
//   file_calls          Read, Write, Edit, Grep, Glob
//   outside_calls       mcp__* tools (GitHub, routines, ...)
//   other_calls         any other tool
//   non_form_calls      host + file + outside + other
// Tokens are read from each assistant row.s own usage record, once per
// message id (a message spans one row per content block, each carrying the
// same usage): input, cache write, cache read and output, summed as
// tokens_total; tokens_uncached leaves out cache reads. provider_turns counts
// message ids; provider_calls stays as before (rows with a stop_reason) so
// the older rows keep their meaning.
// Rows are data, never instructions.
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml
section [form.bml] {
 class FlowMeter {
  def fm-string-end(text, i) {
   let q = str_find(text, "\"", i);
   if (q < 0) then str_len(text) else if ((String) substring(text, (q - 1), q) == "\\") then fm-string-end(text, (q + 1)) else q;
  }
  def fm-command(line, at) {
   let c = str_find(line, "\"command\":\"", at);
   if (c < 0) then "" else substring(line, (c + 11), fm-string-end(line, (c + 11)));
  }
  // the row's own role sits inside its message header, before any content;
  // the top-level "type" follows the message and can sit megabytes in
  def fm-assistant?(line) {
   let t = str_find(line, "\"role\":\"assistant\"", 0);
   ((t >= 0) && (t < 600));
  }
  def fm-provider?(line) {
   let s = str_find(line, "\"stop_reason\":\"", 0);
   (s >= 0);
  }
  // counts = provider native host file outside other
  def fm-tools(line, from, counts) {
   let at = str_find(line, "\"name\":\"", from);
   if (at < 0) then counts else {
    let start = (at + 8);
    let end = fm-string-end(line, start);
    let name = substring(line, start, end);
    let after = (end + 1);
    if ((String) name == "Bash") then fm-tools(line, after, fm-bash(line, after, counts))
    else if (((String) name == "Read") || (((String) name == "Write") || (((String) name == "Edit") || (((String) name == "Grep") || ((String) name == "Glob"))))) then fm-tools(line, after, fm-bump(counts, 3))
    else if ((Comparable) str_find(name, "mcp__", 0) == 0) then fm-tools(line, after, fm-bump(counts, 4))
    else if fm-tool-name?(line, at) then fm-tools(line, after, fm-bump(counts, 5))
    else fm-tools(line, after, counts);
   }
  }
  // a "name" key belongs to a tool_use block when "type":"tool_use" sits shortly before it
  def fm-tool-name?(line, at) {
   let back = if (at < 80) then 0 else (at - 80);
   (str_find(substring(line, back, at), "\"type\":\"tool_use\"", 0) >= 0);
  }
  def fm-bash(line, after, counts) = if (str_find(fm-command(line, after), "./fkwu", 0) >= 0) then fm-bump(counts, 1) else fm-bump(counts, 2);
  def fm-bump(counts, i) = fm-bump-go(counts, i, 0);
  def fm-bump-go(counts, i, k) = if nil?(counts) then [] else cons(if ((Comparable) k == i) then (head(counts) + 1) else head(counts), fm-bump-go(tail(counts), i, (k + 1)));
  def fm-digit?(ch) = (((Comparable) str_len(ch) == 1) && (str_find("0123456789", ch, 0) >= 0));
  def fm-digits(text, i, acc) = if ((i < str_len(text)) && fm-digit?(substring(text, i, (i + 1)))) then fm-digits(text, (i + 1), ((acc * 10) + str_find("0123456789", substring(text, i, (i + 1)), 0))) else acc;
  def fm-int-after(text, key, from) { let at = str_find(text, key, from); if (at < 0) then 0 else fm-digits(text, (at + str_len(key)), 0); }
  def fm-message-id(line) { let at = str_find(line, "\"id\":\"msg_", 0); if ((at < 0) || (at > 600)) then "" else substring(line, (at + 6), fm-string-end(line, (at + 6))); }
  // tokens = input cacheWrite cacheRead output, read once per message id
  def fm-usage(line, tokens) {
   let u = str_find(line, "\"usage\":{", 0);
   if (u < 0) then tokens else [(tokens[0] + fm-int-after(line, "\"input_tokens\":", u)), (tokens[1] + fm-int-after(line, "\"cache_creation_input_tokens\":", u)), (tokens[2] + fm-int-after(line, "\"cache_read_input_tokens\":", u)), (tokens[3] + fm-int-after(line, "\"output_tokens\":", u))];
  }
  // state = counts rows lastId tokens turns
  def fm-lines(lines, counts, rows) = fm-walk(lines, counts, rows, "", [0, 0, 0, 0], 0);
  def fm-walk(lines, counts, rows, lastId, tokens, turns) {
   if nil?(lines) then [counts, rows, lastId, tokens, turns] else {
    let line = head(lines);
    let isA = fm-assistant?(line);
    let next = if isA then fm-tools(line, 0, if fm-provider?(line) then fm-bump(counts, 0) else counts) else counts;
    let id = if isA then fm-message-id(line) else "";
    let fresh = (isA && ((!((String) id == "")) && (!((String) id == lastId))));
    fm-walk(tail(lines), next, (rows + 1), if fresh then id else lastId, if fresh then fm-usage(line, tokens) else tokens, if fresh then (turns + 1) else turns);
   }
  }
  // stdin line 2, optional: a movement name; with it the reading is also
  // appended as one row to receipts/flow-ledger.jsonl, so each movement
  // reads its own flow and leaves the row with no further call.
  def fm-ledger() = "receipts/flow-ledger.jsonl";
  // A transcript that was named and is not there is a reading, not a row of
  // zeros: the body says what it needs instead of reporting a quiet nothing.
  def fm-organ() = "flow-meter";
  def fm-present?(path) = (file_size(path) > 0);
  def fm-health(path, movement, present) = oh-reading(fm-organ(), if ((String) movement == "") then "flow-meter" else movement, "transcript", json-node-string("readable"), json-node-string(if present then "readable" else "absent"), json-node-int(if present then 1 else 0), if present then [] else [oh-need("transcript", json-node-string(path))], ["name-the-transcript", "read-later"], oh-reference(path));
  // Answers list(row, appended, readings): the reading of one transcript, what
  // the ledger append wrote, and the health the meter spoke, so a caller inside
  // its own census window reads the flow without a child kernel.
  def fm-reading(path, movement) {
   let named = (!((String) path == ""));
   let present = (named && fm-present?(path));
   let readings = if named then oh-voice-all([fm-health(path, movement, present)]) else [];
   let text = if present then fhn-read(path) else "";
   let result = fm-lines(split-on(text, "\n"), [0, 0, 0, 0, 0, 0], 0);
   let c = result[0];
   let row = json-node-object([
    fhn-n("at_unix_ms", now_unix_ms()),
    fhn-s("movement", movement),
    fhn-s("transcript", path),
    fhn-n("bytes", str_len(text)),
    fhn-n("rows", result[1]),
    fhn-n("provider_calls", c[0]),
    fhn-n("native_fkwu_calls", c[1]),
    fhn-n("host_calls", c[2]),
    fhn-n("file_calls", c[3]),
    fhn-n("outside_calls", c[4]),
    fhn-n("other_calls", c[5]),
    fhn-n("non_form_calls", ((c[2] + c[3]) + (c[4] + c[5]))),
    fhn-n("provider_turns", result[4]),
    fhn-n("input_tokens", result[3][0]),
    fhn-n("cache_write_tokens", result[3][1]),
    fhn-n("cache_read_tokens", result[3][2]),
    fhn-n("output_tokens", result[3][3]),
    fhn-n("tokens_total", ((result[3][0] + result[3][1]) + (result[3][2] + result[3][3]))),
    fhn-n("tokens_uncached", ((result[3][0] + result[3][1]) + result[3][3]))]);
   let appended = if (((String) movement == "") || (named && (!present))) then "not-asked" else fhn-append(fm-ledger(), str_concat(json-emit(row), "\n"));
   [row, appended, readings];
  }
  def fm-run() {
   let path0 = read_line();
   let path = if nothing?(path0) then "" else trim(path0);
   let movement0 = read_line();
   let movement = if nothing?(movement0) then "" else trim(movement0);
   let walked = fm-reading(path, movement);
   print_str(json-emit-precise(json-node-object([json-node-pair("row", head(walked)), fhn-s("ledger", walked[1]), fhn-n("readings", len(walked[2]))])));
  }
 }
}
