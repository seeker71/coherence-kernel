//////////////////////////////////////////////////////////////////////
// dsv4-validate.bml -- the physical validation window of the Form-native DeepSeek-V4 driver: its plan, its abort rules and its run, as definitions.
//
// observe/dsv4-validate-run.bml is the door that calls these; this file holds no top-level effect so a band can read every rule on scripted readings. The window takes the IQ2XXS file
// (the one ds4 recorded its references on) through the driver ONCE, ALONE, staged so the machine is read at each step and the run stops the moment a reading says it must.
//
// WHY STAGED. A model door piled on a model door restarted this Mac three times on 2026-10-02. The driver maps 1,202 tensors of an 80 GiB file and the GPU wires only what it touches, so
// the window walks the residency in steps and reads host_vm_stat after each: compile, map, state, wirespan probe, token 1 layer by layer, the head, the recorded-logits prompt, the recorded stream
// (twice, for bit equality). Each stage is preceded by the governor's ask for the stage's estimate (mg-ask) and followed by metal_sync, mg-low? and the wired reading.
//
// THE ABORT RULES (dvr-abort-reason, dvr-ask-reason), in this order, and the first that holds ends the run:
//   a denied ask       the governor will not grant the stage's estimate (reason named)
//   host-memory-low    mg-low?: available under half the reserve, wired over 80 percent, or the compressor over 40 percent
//   wired-above-lease  wired grew past the lease the window holds (shared + private bytes, dls-shared of the header + the KV margin) since the baseline
//   stage-delta        a stage's wired growth, less the movement the machine makes by itself (dvr-ambient, read before the window), is over twice its estimate (a floor of 64 MiB, so a small estimate is not a hair trigger)
//   budget             20 minutes of the 30 the window is given have passed
//   stage-refused      the driver answered nothing for the stage (a block it does not support, a refused open)
//   wirespan           the one-expert probe grew wired memory by half the expert STACK or more (read by the probe's own limit, below): the working-set estimate (a slice, not a stack) is wrong, and the lease with it
// On an abort: metal_sync, free every handle (dsv4-close in synced rounds), mg-release, a receipt row with status aborted and the reason, the exit says aborted. Nothing is retried.
//
// REFUSED BEFORE ANYTHING OPENS: another model door resident (the same process rows flp-gpu-holders reads, plus a ds4 process and another copy of this door), a lease another process holds, the
// governor holding the window's lease, the recorded logits file not the one pinned (SHA-256), the file not a deepseek4 GGUF whose layout is consistent.
//
// THE ESTIMATES ARE DERIVED FROM THE HEADER, NOT MEASURED (the window is what measures them): a layer's token-1 step touches that layer's dense tensors and six experts' slices; the map and
// compile stages are bounds (512 MiB); the wirespan probe expects one expert slice (2,162,688 B on the IQ2XXS file's layer 0 gate stack of 553,648,128 B).
//
// THE WINDOW IS NEVER THE DEFAULT: empty stdin, {} and {"dry":1} print the plan; only {"go":1} runs it. And with a gap below present, {"go":1} still maps nothing: it writes a receipt row naming the gaps
// (status refused, reason driver-gaps), gives back any lease this process holds, and stops. A stop inside a stage reads as an abort (try/catch), so the handles, the lease and the receipt always follow.
// THE WIRESPAN PROBE is judged by its own limit (twice the stack, dvr-wirespan-limit), not by twice the slice: half a stack (277 MB on the IQ2XXS file) is over the slice's 128 MiB floor, and the
// generic delta rule would have ended the run as stage-delta before the probe could say 'stack'.
// THE MACHINE MOVES BY ITSELF. host_vm_stat's wired count is every process's. The first window (2026-10-03 06:47 WITA) ended at the state stage on wired +198,148,096 B against a price of 18,270,208 B that is exact
// (the device's own ledger reads it within a page: native/metal/tests/dsv4-open-band.bml): on this Mac a sibling process moves wired memory by 306 to 328 MB every second or so, up and down (7 steps over 16 MiB in 900
// readings 10 ms apart, 2026-10-03 06:55 WITA). So the door reads that movement before the window (dvr-ambient: the spread of 120 readings 25 ms apart, 3 s, which holds more than one up step and one down step)
// and judges each stage by its wired growth LESS that movement (dvr-own-delta: what the window itself wired, at least), the wirespan probe's kind the same way (dvr-wirespan-kind-noisy: 'stack' only when the delta
// less the movement is half the stack, 'slice' only when the delta plus the movement is still a slice, 'between' when the machine's own motion hides which), and every stage row carries the device's own bytes
// (metal_live word 18, which no other process moves) beside the wired reading, so the next reading tells the window's allocation from the machine's. The receipt names the movement (wired_noise) and each stage's own_delta.
// The movement is bursty (19.8 MB over one 3 s reading, 331.9 MB over the next), so a stage-delta is met with a second 3 s reading before the run ends (dvr-reread): the larger of the two readings is the one taken from
// the delta. The guard is not widened by a guess: with no movement the rule is the rule it was, and a growth past twice the estimate plus the movement still ends the run.
// The stream stage's estimate is the expert cache (every new expert the 24 ids meet grows wired memory), and a logits leg whose prompt ids hold nowhere (none supplied, the pinned row missing or failing its check) is a named 'waits' row in the log and no run.
//
// WHAT THE DRIVER CANNOT RUN YET (dvr-gaps = dsv4-layout.fk dvl-driver-gaps, read from the header, printed by the dry plan): every tensor of the header whose type its role has no kernel for, from the layout's one
// table of the types each role may carry (a dense projection MXFP8 or Q8_0, an expert stack MXFP4, IQ2_XXS or Q2_K, the routers and the embedding F16, the norms F32). Since driver stage 4 the layer and the head
// run the real IQ2XXS file's Q8_0 dense and output tensors and its Q2_K down stacks, so that header reads NO gap, as the reap25 header and both fixtures do; a header holding a type outside the table (a doctored
// one, or another build) reads one line a tensor type. The plan names the gaps so the window is not spent finding them. The ordering question (ds4's own Q8_0 and Q2_K order against the driver's lanes) is a note
// the plan prints beside it (dvr-notes), never a gap: it is what the window's stream leg and tie budget measure.
//
// THE RECORDED REFERENCES (read from the recording, never recomputed): the logits of ds4's dump on its 14-token chat-templated prompt (the JSON is pinned by SHA-256; the recording does not carry
// the 14 prompt ids; the row beside it pins them: dvr-logits-prompt-path, derived from the IQ2XXS header by bml/dsv4-chat-template.bml, so that leg runs on them unless the caller supplies others as logits_prompt_ids), judged by Pearson r, top-10 overlap and the TIE BUDGET (the reference's top-two margin
// against our largest delta over its top 64: a token flips when the delta exceeds the margin); and the 24-token greedy stream for the raw prompt ids 671 6102 294 8760 344 (a cycle of 7), matched
// token by token, run twice for bit equality of ids and last logits, and read at every step for OUR top-two margin and the recorded id's gap below our top (dvr-step, the receipt's stream_margins and
// stream_recorded_gap): the stream leg has no reference logits of its own, so its near ties are told from our own margins, and the tie budget proper is the logits leg's.
//
// Proven by: form-stdlib/tests/dsv4-validate-band.bml (the plan, the dry door's output, the abort rules and the ask on scripted readings, the holders, the references' arithmetic, the receipt row; nothing opened).
//////////////////////////////////////////////////////////////////////
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/json.fk form-stdlib/bml/stdin-source.bml form-stdlib/bml/memory-governor.bml form-stdlib/bml/form-cli-local-plan.bml form-stdlib/bml/sha256-owned.bml form-stdlib/dsv4-layout.fk form-stdlib/dsv4-lease.fk form-stdlib/dsv4-tokenizer.fk native/metal/dsv4-token-handle.fk
section [form.bml] {
 class Dsv4Validate {
  // ---- the pins ---------------------------------------------------------------------------------------------------------
  def dvr-file() = "/Users/ursmuff/models/ds4-engine/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf";
  def dvr-logits-path() = "form/form-stdlib/tests/oracles/ds4-logits-capital-of-france.json";
  def dvr-logits-bytes() = 1588387;
  def dvr-logits-sha() = "3898af1731936bf0a59d0c0ce01a60df62f54b9b64552673c7f93df3b7c79d27";
  def dvr-prompt() = [671, 6102, 294, 8760, 344];
  def dvr-stream() = [11111, 16, 455, 6102, 294, 8760, 344, 11111, 16, 455, 6102, 294, 8760, 344, 11111, 16, 455, 6102, 294, 8760, 344, 11111, 16, 455];
  def dvr-logits-prompt-path() = "form/form-stdlib/tests/oracles/ds4-logits-capital-of-france-prompt.json";
  def dvr-logits-count() = 14;
  def dvr-receipt-path() = "receipts/dsv4-validation.jsonl";
  def dvr-budget-ms() = 1800000;
  def dvr-abort-ms() = 1200000;
  def dvr-mib() = 1048576;
  def dvr-floor() = 64 * 1048576;
  def dvr-bound() = 512 * 1048576;
  def dvr-ambient-samples() = 120;
  def dvr-ambient-nap-ms() = 25;
  def dvr-default-cap() = 64;
  def dvr-token-1() = 671;

  // ---- options (one JSON line on stdin) -------------------------------------------------------------------------------------
  def dvr-text(doc, key, d) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : d;
  def dvr-int(doc, key, d) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : d;
  def dvr-ints(doc, key) = json-object-has?(doc, key) ? map(n => json-int-value(n), json-array-elements(json-object-get(doc, key))) : [];
  def dvr-options() {
   let line = trim(stdin-text());
   (len(line) > 0) && (str_byte_at(line, 0) == 123) ? parse-json("dsv4-validate-options", line) : json-node-object([]);
  }
  // THE WINDOW IS NEVER THE DEFAULT. Empty stdin, {} and {"dry":1} all print the plan; only an explicit {"go":1} (and no dry) runs the window.
  def dvr-go?(opts) = dvr-int(opts, "go", 0) == 1 && dvr-int(opts, "dry", 0) != 1;
  def dvr-dry?(opts) = !dvr-go?(opts);

  // ---- the logits leg's prompt ids: the request's own, else the pinned row's, never a guess ----------------------------------------------
  // The row beside the recording (tests/oracles/ds4-logits-capital-of-france-prompt.json) holds the 14 ids ds4's chat template gives its prompt, derived natively from the IQ2XXS header (bml/dsv4-chat-template.bml)
  // and held to the row by tests/ds4-recorded-references-band.bml. The door reads them as they stand, after one check: the ids are the row's own parts in order (BOS, the system ids, User, the prompt ids, Assistant,
  // think), their number is the recording's prompt_tokens, and the prompt ids are the raw prompt the stream leg pins. A wrong id, a wrong count or a missing BOS reads false and the leg waits.
  def dvr-logits-row() = parse-json("dsv4-logits-prompt", read_file_slice(dvr-logits-prompt-path(), 0, 8192));
  def dvr-chat-parts(row) = append(append([dvr-int(row, "bos", 0 - 1)], dvr-ints(row, "system_ids")), append(append([dvr-int(row, "user", 0 - 1)], dvr-ints(row, "prompt_ids")), [dvr-int(row, "assistant", 0 - 1), dvr-int(row, "think", 0 - 1)]));
  def dvr-chat-ids-ok?(ids, row) = len(ids) == dvr-logits-count() && ids == dvr-chat-parts(row) && dvr-int(row, "bos", 0 - 1) >= 0 && ids[0] == dvr-int(row, "bos", 0 - 1) && dvr-ints(row, "prompt_ids") == dvr-prompt() && dvr-int(row, "prompt_tokens", 0) == dvr-logits-count();
  def dvr-pinned-go(row) = dvr-chat-ids-ok?(dvr-ints(row, "ids"), row) ? dvr-ints(row, "ids") : [];
  def dvr-pinned-ids() = try dvr-pinned-go(dvr-logits-row()) catch [];
  def dvr-logits-ids(opts) = len(dvr-ints(opts, "logits_prompt_ids")) > 0 ? dvr-ints(opts, "logits_prompt_ids") : dvr-pinned-ids();
  def dvr-logits-from(opts) = len(dvr-ints(opts, "logits_prompt_ids")) > 0 ? "supplied" : (len(dvr-pinned-ids()) > 0 ? "pinned" : "none");

  // ---- the machine: the abort rules on a reading -----------------------------------------------------------------------------
  // the governor's ask for a stage, refused with its reason (an empty string when it is granted)
  def dvr-ask-reason(vm, est) {
   let v = mg-verdict(vm, est);
   mg-granted?(v) ? "" : "ask-denied:" ++ v[1];
  }
  // after a stage: the first rule that holds, in the documented order; vm the reading after the stage, base the wired bytes at the baseline,
  // lease the shared + private bytes the window holds, est the stage's estimate, delta its wired growth, elapsed the window's age
  def dvr-abort-reason(vm, base, lease, est, delta, elapsed) =
   !mg-vm-ok?(vm) ? "memory-unreadable" : mg-low?(vm) ? "host-memory-low" : (mg-wired(vm) - base) > lease ? "wired-above-lease" : delta > 2 * (est > dvr-floor() ? est : dvr-floor()) ? "stage-delta" : elapsed > dvr-abort-ms() ? "budget" : "";
  // the machine's own movement: the spread (largest minus smallest) of wired readings; nothing and one reading read 0
  def dvr-spread-go(ws, lo, hi) = len(ws) == 0 ? hi - lo : dvr-spread-go(ws[1:], ws[0] < lo ? ws[0] : lo, ws[0] > hi ? ws[0] : hi);
  def dvr-spread(ws) = len(ws) == 0 ? 0 : dvr-spread-go(ws[1:], ws[0], ws[0]);
  // read live: the spread of dvr-ambient-samples readings dvr-ambient-nap-ms apart (3 s); an unreadable machine reads 0 and the memory-unreadable rule is the one that speaks
  def dvr-ambient-read(n, lo, hi, nap, vm) = !mg-vm-ok?(vm) ? dvr-ambient-go(n - 1, lo, hi) : dvr-ambient-go(n - 1, mg-wired(vm) < lo ? mg-wired(vm) : lo, mg-wired(vm) > hi ? mg-wired(vm) : hi);
  def dvr-ambient-go(n, lo, hi) = n == 0 ? hi - lo : dvr-ambient-read(n, lo, hi, host_sleep_ms(dvr-ambient-nap-ms()), mg-sense());
  def dvr-ambient() {
   let vm = mg-sense();
   mg-vm-ok?(vm) ? dvr-ambient-go(dvr-ambient-samples(), mg-wired(vm), mg-wired(vm)) : 0;
  }
  // what a stage's wired growth says about the window itself: the growth less the machine's own movement, never below 0 (an up step of the machine reads as nothing; a growth past it is the window's, at least)
  def dvr-own-delta(delta, noise) = delta > noise ? delta - noise : 0;
  // the device's own bytes for this process (metal_live word 18, currentAllocatedSize), 0 while Metal is not up
  def dvr-own() = len(metal_live()) > 18 ? metal_live()[18] : 0;
  // the wirespan probe: the delta against the slice and the stack it was read from: "slice" (the working-set estimate holds), "stack" (it does not), "between"
  def dvr-wirespan-kind(delta, slice, stack) = delta >= stack / 2 ? "stack" : delta <= slice * 2 + dvr-floor() ? "slice" : "between";
  // the same with the machine's own movement: 'stack' only when the delta less the movement reaches half the stack, 'slice' only when the delta plus the movement is still within a slice (no movement: the kind above)
  def dvr-wirespan-kind-noisy(delta, noise, slice, stack) = (delta - noise) >= stack / 2 ? "stack" : (delta + noise) <= slice * 2 + dvr-floor() ? "slice" : "between";
  // The probe's stage is asked for the slice but JUDGED against the stack: a delta of half the stack (277 MB on the IQ2XXS file) is over twice the slice's estimate, so the generic delta rule
  // would end the run as stage-delta before the probe could name what it found. The probe's own limit is twice the stack; dvr-judge-wirespan reads the kind and ends the run on 'stack'.
  def dvr-wirespan-limit(m) = dvr-stack(m);

  // ---- the layout's figures, from the header ------------------------------------------------------------------------------------
  def dvr-sum-bytes(ix, names) = len(names) == 0 ? 0 : (dvl-has?(ix, names[0]) ? dvl-r-bytes(dvl-row-of(ix, names[0])) : 0) + dvr-sum-bytes(ix, names[1:]);
  def dvr-layer-dense(m, il) = dvr-sum-bytes(record_get(m, "index"), dvl-l(m, il, "names")) - dls-layer-stacks(m, il);
  // what token 1 touches in a layer: its dense tensors and `used` experts' slices (used = 6 on both real files)
  def dvr-est-layer(m, il) = dvr-layer-dense(m, il) + record_get(m, "used") * dls-layer-expert(m, il);
  def dvr-est-layers-go(m, il, n) = il == n ? [] : cons(dvr-est-layer(m, il), dvr-est-layers-go(m, il + 1, n));
  def dvr-est-layers(m) = dvr-est-layers-go(m, 0, record_get(m, "layers-n"));
  def dvr-sum(xs) = len(xs) == 0 ? 0 : xs[0] + dvr-sum(xs[1:]);
  // one pass each: a fold with the best so far (a recursion that called itself twice a level would take 2^n steps over 43 layers)
  def dvr-min-go(xs, best) = len(xs) == 0 ? best : dvr-min-go(xs[1:], xs[0] < best ? xs[0] : best);
  def dvr-max-go(xs, best) = len(xs) == 0 ? best : dvr-max-go(xs[1:], xs[0] > best ? xs[0] : best);
  def dvr-min(xs) = dvr-min-go(xs[1:], xs[0]);
  def dvr-max(xs) = dvr-max-go(xs[1:], xs[0]);
  def dvr-est-head(m) = dvr-sum-bytes(record_get(m, "index"), ["output.weight", "output_hc_fn.weight", "output_hc_scale.weight", "output_hc_base.weight", "output_norm.weight"]);
  def dvr-est-map(m, cap) = dvr-bound() + dso-plan-bytes(dso-scratch-plan(m, cap));
  def dvr-slice(m) = dls-names-bytes(record_get(m, "index"), ["blk.0.ffn_gate_exps.weight"]) / dvl-l(m, 0, "nexp");
  def dvr-stack(m) = dls-names-bytes(record_get(m, "index"), ["blk.0.ffn_gate_exps.weight"]);
  // the stages: [label, estimate, what]; the layers are one row each in dvr-est-layers
  def dvr-stages(m, opts) {
   let cap = dvr-int(opts, "cap", dvr-default-cap());
   let c = dvr-int(opts, "cache_experts", dls-cache-experts());
   [["compile", dvr-bound(), "the seven graph units' kernels compile (the carrier keys a pipeline by its source)"],
    ["map", dvr-est-map(m, cap), "dsv4-open-span maps the driver's 1,202 tensors (no copy, demand-paged) and allocates the scratch"],
    ["state", dvl-kv-total(m, cap), "the KV arenas and the compressors' state for the capacity"],
    ["wirespan", dvr-slice(m), "ONE dispatch reading ONE expert slice of layer 0's gate stack: wired grows by the slice or by the stack"],
    ["layers", dvr-sum(dvr-est-layers(m)), "token 1 through every block, one stage a block, the machine read after each"],
    ["head", dvr-est-head(m), "the output head and the first greedy id (the cold token's clock stops here)"],
    ["logits", dls-cache(m, c), "the recorded-logits prompt through prefill (the expert cache is the bound), compared by r, top-10 overlap and the tie budget"],
    ["stream", dls-cache(m, c), "the raw prompt ids, 24 greedy ids against the recorded stream (every new expert it meets grows wired memory, up to the expert cache: that is its estimate, not 0), then once more from a fresh state for bit equality"]];
  }

  // ---- what the driver cannot run yet, from the header alone ------------------------------------------------------------------------
  // ONE AUTHORITY: the layout's table of the types each role may carry (dsv4-layout.fk dvl-dense-types, dvl-expert-types, dvl-driver-gaps) is what the layer's admission and the head read, so this door asks
  // the layout and keeps no list of its own: a gap is a tensor of the header whose type the driver has no kernel for (or whose block type does not tile its columns). The distinct lines, the head's first
  // then each layer's; EMPTY when the driver can run every tensor its blocks and its head bind (the reap25 header, the IQ2XXS file's, both fixtures).
  def dvr-member?(x, xs) = len(xs) == 0 ? false : (xs[0] == x || dvr-member?(x, xs[1:]));
  def dvr-dense-leaves() = dvl-dense-leaves();
  def dvr-layer-gaps(m, il) = dvl-layer-gaps(m, il);
  def dvr-head-gaps(m) = dvl-head-gaps(m);
  def dvr-gaps(m) = dvl-driver-gaps(m);
  def dvr-str-has?(s, part) = str_find(s, part, 0) >= 0;
  // A NOTE, NOT A GAP. The recorded stream was earned by ds4 on the IQ2XXS file: ds4 quantises the activation of a Q8_0 dense matvec to int8 per 32-block and dots in integers (ds4.c:6814, :7051), reads
  // Q2_K in a plain ascending f32 sum (:3480) and its F16 dots on two NEON accumulators. The driver's lanes read f32 activations and sum by lane tree (each within 3e-5 of the oracle's fp64 on the fixture),
  // so on a near tie the greedy stream can differ from ds4's by that rounding alone (ds4-order-match.fk's header records a third-step margin of 0.0197 of 24 logits on the earlier lane); the ds4 order lanes
  // (dkr-unit-ds4q8, dkr-unit-ds4q2k: compiled by the kernels band, not in the graph) are what to wire if the window's readings say so. WHAT THE WINDOW READS, and which leg: the STREAM leg runs on the raw
  // prompt ids alone and records, for each of its 24 steps, OUR top-two logit margin (stream_margins) and how far the recorded id's logit sits below our top (stream_recorded_gap, 0 where we chose it), so a flip
  // at a step can be told from a near tie (a miss with a gap near the margin's scale is rounding; a miss with a large gap is not). The reference's own TIE BUDGET (its top-two margin against our largest delta)
  // belongs to the LOGITS leg, which runs on the recording's 14 chat-templated prompt ids (pinned in the row beside the recording; a request may supply others). It is a MEASUREMENT the window exists to make: it does not
  // stop the window from running, so it is printed in the plan and never counted among the gaps.
  def dvr-has-q-types?(m) = dvl-type-in?(dvl-type(record_get(m, "index"), "output.weight"), [8]) || dvl-type-in?(dvl-type(record_get(m, "index"), "blk.0.ffn_down_exps.weight"), [10]);
  def dvr-order-note() = "note, not a gap: the recorded stream was earned with ds4's own order (Q8_0 activations quantised to int8 per 32-block, Q2_K in a plain ascending sum); the driver's lanes read f32 activations and sum by lane tree, so a near-tie token may differ: the stream leg records our top-two margin and the recorded id's gap at each of its 24 steps (the logits leg's tie budget is read on the recording's 14 prompt ids), and the ds4q8 and ds4q2k units are the lanes to wire if they say so";
  def dvr-notes(m) = dvr-has-q-types?(m) ? [dvr-order-note()] : [];

  // ---- the processes: who else holds the GPU -------------------------------------------------------------------------------------------
  def dvr-validate-row?(row, mine) = (String) value_kind(row) == "list" && len(row) >= 5 && !flp-pid-in?(mine, row[0]) && (String) value_kind(row[4]) == "list" && len(row[4]) >= 2 && (String) value_kind(row[4][1]) == "string" && flp-ends?(row[4][1], "observe/dsv4-validate-run.bml");
  def dvr-ds4-row?(row, mine) = (String) value_kind(row) == "list" && len(row) >= 3 && !flp-pid-in?(mine, row[0]) && (String) value_kind(row[2]) == "string" && (flp-ends?(row[2], "/ds4") || flp-ends?(row[2], "/ds4-server"));
  // the rows that hold the GPU: flp-gpu-holders-of's (the walk's doors, learning, the LoRA lanes), another copy of this door, a ds4 process
  def dvr-holders-of(rows, mine, me) = filter(r => flp-gpu-row?(r, mine, me) || dvr-validate-row?(r, mine) || dvr-ds4-row?(r, mine), rows);
  def dvr-rows-of(pids) = (String) value_kind(pids) == "list" ? hw-process-rows(pids) : [];
  def dvr-process-rows() = append(dvr-rows-of(host_processes("fkwu*")), dvr-rows-of(host_processes("ds4*")));
  def dvr-holder-text(rows) = len(rows) == 0 ? "none" : flp-join(map(r => mc-cat([(String) value_kind(r[4]) == "list" && len(r[4]) >= 2 ? r[4][1] : "a process", " (pid ", r[0].str(), ")"]), rows), ", ");
  // [holder rows, live lease rows other than this process's, the machine reading]
  def dvr-facts() {
   let me = host_process(host_pid());
   let mine = flp-lineage(host_pid(), 32);
   let leases = filter(r => r[0] != host_pid(), mg-lease-view(mg-lease-dir()));
   [dvr-holders-of(dvr-process-rows(), mine, me), leases, mg-sense()];
  }
  def dvr-facts-clear?(facts) = len(facts[0]) == 0 && len(facts[1]) == 0 && mg-vm-ok?(facts[2]) && !mg-low?(facts[2]);
  def dvr-facts-lines(facts) = [
   "[dsv4-validate] other model doors resident: " ++ dvr-holder-text(facts[0]),
   "[dsv4-validate] memory leases held by other processes: " ++ len(facts[1]).str(),
   mg-status-line(facts[2]),
   "[dsv4-validate] the window may start: " ++ (dvr-facts-clear?(facts) ? "yes" : "no")];

  // ---- the plan, as lines (the dry door prints these and opens nothing) ------------------------------------------------------------------------
  def dvr-gib(b) = mg-gib-text(b);
  def dvr-stage-line(row) = "[dsv4-validate] stage " ++ row[0] ++ ": ask " ++ dvr-gib(row[1]) ++ " (" ++ row[1].str() ++ " B); " ++ row[2];
  // the logits leg's line: the ids it will run on and the ask of its stage, or why it waits
  def dvr-ask-text(ask) = "ask " ++ dvr-gib(ask) ++ " (" ++ ask.str() ++ " B)";
  def dvr-logits-line(opts, ids, ask) {
   let from = dvr-logits-from(opts);
   from == "supplied" ? "will run on the " ++ len(ids).str() ++ " prompt ids supplied " ++ dvr-ids-json(ids) ++ ", " ++ dvr-ask-text(ask)
    : (from == "pinned" ? "will run on the " ++ len(ids).str() ++ " chat-templated prompt ids " ++ dvr-ids-json(ids) ++ " pinned beside the recording (" ++ dvr-logits-prompt-path() ++ ": BOS, system, User, prompt, Assistant, <think>; a supplied logits_prompt_ids replaces them), " ++ dvr-ask-text(ask)
    : "WAITS: no logits_prompt_ids supplied and the row " ++ dvr-logits-prompt-path() ++ " is missing or fails its check (14 ids that are its own parts in order); supply them as logits_prompt_ids");
  }
  // the movement the machine makes by itself, read before anything of the window runs (the dry plan reads it too: it is the machine's, not the window's)
  def dvr-ambient-line(noise) = "[dsv4-validate] ambient: wired memory moved by " ++ dvr-gib(noise) ++ " (" ++ noise.str() ++ " B) over " ++ ((dvr-ambient-samples() * dvr-ambient-nap-ms()) / 1000).str() ++ " s of readings " ++ dvr-ambient-nap-ms().str()
   ++ " ms apart on this machine with nothing of ours running; the stage-delta rule judges a stage's wired growth less that movement, and the stage lines print the device's own bytes beside it";
  def dvr-plan-lines(m, size, opts, facts, noise) {
   let cap = dvr-int(opts, "cap", dvr-default-cap());
   let c = dvr-int(opts, "cache_experts", dls-cache-experts());
   let shared = dls-shared(m, c, cap);
   let lease = shared + mg-kv-margin();
   let layers = dvr-est-layers(m);
   let gaps = dvr-gaps(m);
   let logitsIds = dvr-logits-ids(opts);
   append(["[dsv4-validate] DRY: the plan below is what the window WILL do; nothing is opened, nothing mapped, no lease taken, no row written, no kernel compiled",
    "[dsv4-validate] file " ++ dvr-text(opts, "file", dvr-file()) ++ " " ++ size.str() ++ " B (" ++ dvr-gib(size) ++ "), " ++ record_get(m, "arch") ++ ", " ++ record_get(m, "layers-n").str() ++ " layers, " ++ record_get(m, "tensors").str() ++ " tensors, header read only",
    "[dsv4-validate] lease: shared " ++ dvr-gib(shared) ++ " (" ++ shared.str() ++ " B: dense " ++ dls-dense(m).str() ++ " + " ++ c.str() ++ " experts a layer " ++ dls-cache(m, c).str() ++ " + KV at " ++ cap.str() ++ " positions " ++ dvl-kv-total(m, cap).str() ++ "), private " ++ dvr-gib(mg-kv-margin()) ++ ", derived and not measured",
    "[dsv4-validate] the window asks the governor for " ++ dvr-gib(lease) ++ " against a wired cap of " ++ dvr-gib(mg-wired-cap-of(mg-mem(facts[2]))) ++ " on this machine (the file itself is " ++ dvr-gib(size) ++ ")"],
    append(dvr-facts-lines(facts),
     append(map(row => dvr-stage-line(row), dvr-stages(m, opts)),
      ["[dsv4-validate] layers: " ++ len(layers).str() ++ " stages, ask " ++ (dvr-min(layers) / dvr-mib()).str() ++ " MiB to " ++ (dvr-max(layers) / dvr-mib()).str() ++ " MiB (first " ++ layers[0].str() ++ " B, last " ++ layers[len(layers) - 1].str() ++ " B), together " ++ dvr-gib(dvr-sum(layers)),
       dvr-ambient-line(noise),
       "[dsv4-validate] abort on: a denied ask, host-memory-low, wired above the lease (" ++ dvr-gib(lease) ++ " past the baseline), a stage delta over twice its estimate (floor 64 MiB) once that movement is taken from it, 20 minutes of 30, a stage the driver refuses, a wirespan probe that wires half the stack or more once that movement is taken from it",
       "[dsv4-validate] on an abort: metal_sync, free every handle in synced rounds, mg-release, a receipt row with the reason; nothing is retried",
       "[dsv4-validate] references: recorded logits " ++ dvr-logits-path() ++ " (" ++ dvr-logits-bytes().str() ++ " B, SHA-256 " ++ dvr-logits-sha() ++ "); the stream " ++ dvr-ids-json(dvr-stream()) ++ " for the raw prompt " ++ dvr-ids-json(dvr-prompt()),
       "[dsv4-validate] logits leg: " ++ dvr-logits-line(opts, logitsIds, dls-cache(m, c)),
       "[dsv4-validate] the driver cannot run yet: " ++ (len(gaps) == 0 ? "nothing named by the header" : flp-join(gaps, "; ")),
       "[dsv4-validate] ordering: " ++ (len(dvr-notes(m)) == 0 ? "the file holds no Q8_0 output or Q2_K down tensor, so ds4's own order is not in question" : dvr-notes(m)[0]),
       "[dsv4-validate] receipt: one dated row appended to " ++ dvr-text(opts, "receipt", dvr-receipt-path()),
       "[dsv4-validate] budget " ++ (dvr-budget-ms() / 60000).str() ++ " minutes, abort at " ++ (dvr-abort-ms() / 60000).str(),
       "[dsv4-validate] DRY ends: " ++ (len(dvr-stages(m, opts)) + len(layers) - 1).str() ++ " stages would run"])));
  }

  // ---- the references' arithmetic ------------------------------------------------------------------------------------------------------------
  def dvr-sum-f(xs, i, acc) = i == len(xs) ? acc : dvr-sum-f(xs, i + 1, acc + xs[i]);
  def dvr-pearson-go(a, b, i, ma, mb, num, da, db) = i == len(a) ? num / (math_sqrt(da) * math_sqrt(db)) : dvr-pearson-go(a, b, i + 1, ma, mb, num + (a[i] - ma) * (b[i] - mb), da + (a[i] - ma) * (a[i] - ma), db + (b[i] - mb) * (b[i] - mb));
  def dvr-pearson(a, b) = dvr-pearson-go(a, b, 0, dvr-sum-f(a, 0, 0.0) / (1.0 * len(a)), dvr-sum-f(b, 0, 0.0) / (1.0 * len(b)), 0.0, 0.0, 0.0);
  // the k largest indices, largest first (ties keep the earlier index)
  def dvr-best-excluding(xs, i, best, bi, taken) = i == len(xs) ? bi : ((!dvr-member?(i, taken) && (bi < 0 || xs[i] > best)) ? dvr-best-excluding(xs, i + 1, xs[i], i, taken) : dvr-best-excluding(xs, i + 1, best, bi, taken));
  def dvr-top-go(xs, k, taken) = k == 0 ? taken : dvr-top-go(xs, k - 1, append(taken, [dvr-best-excluding(xs, 0, 0.0, 0 - 1, taken)]));
  def dvr-top(xs, k) = dvr-top-go(xs, k, []);
  def dvr-overlap(a, b) = len(a) == 0 ? 0 : (dvr-member?(a[0], b) ? 1 : 0) + dvr-overlap(a[1:], b);
  def dvr-abs(v) = v < 0.0 ? 0.0 - v : v;
  def dvr-maxdelta-go(ours, ref, idx, best) = len(idx) == 0 ? best : dvr-maxdelta-go(ours, ref, idx[1:], dvr-abs(ours[idx[0]] - ref[idx[0]]) > best ? dvr-abs(ours[idx[0]] - ref[idx[0]]) : best);
  def dvr-maxdelta(ours, ref, idx) = dvr-maxdelta-go(ours, ref, idx, 0.0);
  // [r, top-10 overlap, our argmax, their argmax, their top-two margin, our max |delta| over their top 64, ours finite 1 or 0]
  def dvr-agreement(ours, ref) {
   let k64 = len(ref) < 64 ? len(ref) : 64;
   let k10 = len(ref) < 10 ? len(ref) : 10;
   let top = dvr-top(ref, k64);
   let ourTop = dvr-top(ours, k10);
   [dvr-pearson(ours, ref), dvr-overlap(ourTop, top[0:k10]), ourTop[0], top[0], ref[top[0]] - ref[top[1]], dvr-maxdelta(ours, ref, top), dkr-all-finite?(ours) ? 1 : 0];
  }
  // the stream: how many of the recorded ids the walk matched from the start, and the first index it did not
  def dvr-match-go(got, want, i) = (i == len(got) || i == len(want)) ? i : (got[i] == want[i] ? dvr-match-go(got, want, i + 1) : i);
  def dvr-matched(got, want) = dvr-match-go(got, want, 0);
  // ONE STEP OF THE STREAM, read from OUR logits: [our argmax, our top-two margin (top minus second; 0 on a tie), how far the logit of the recorded id `want` sits below our top (0 where it is our top; -1 reads
  // want as no id)]. One pass with the best and second so far (a recursion that called itself twice a level would take 2^n steps over 129,280 values); the strict > keeps the earlier index on a tie, and an equal
  // second reads margin 0.
  def dvr-two-go(xs, i, bi, bv, sv) = i == len(xs) ? [bi, bv, sv] : (xs[i] > bv ? dvr-two-go(xs, i + 1, i, xs[i], bv) : (xs[i] > sv ? dvr-two-go(xs, i + 1, bi, bv, xs[i]) : dvr-two-go(xs, i + 1, bi, bv, sv)));
  def dvr-two(xs) = dvr-two-go(xs, 1, 0, xs[0], 0.0 - 1.0e30);
  def dvr-step(ours, want) {
   let t = dvr-two(ours);
   [t[0], t[1] - t[2], (want >= 0 && want < len(ours)) ? t[1] - ours[want] : 0.0];
  }
  def dvr-steps-margins(readings) = len(readings) == 0 ? [] : cons(readings[0][1], dvr-steps-margins(readings[1:]));
  def dvr-steps-gaps(readings) = len(readings) == 0 ? [] : cons(readings[0][2], dvr-steps-gaps(readings[1:]));
  // the recorded id of step i, or -1 past the recorded stream
  def dvr-want-at(i) = i < len(dvr-stream()) ? dvr-stream()[i] : 0 - 1;
  def dvr-bits(xs) = len(xs) == 0 ? [] : cons(md-f32-bits(xs[0]), dvr-bits(xs[1:]));
  // the recorded logits, read from the pinned file: 129,280 values
  def dvr-ref-logits() {
   let text = read_file_slice(dvr-logits-path(), 0, 1600000);
   let at = str_find(text, "\"logits\":[", 0);
   let end = str_find(text, "]", at);
   map(p => str_to_float(trim(p)), split-on(substring(text, at + 10, end), ","));
  }
  def dvr-hex(d, i) = i == len(d) ? "" : (substring("0123456789abcdef", str_byte_at(d, i) / 16, (str_byte_at(d, i) / 16) + 1) ++ substring("0123456789abcdef", str_byte_at(d, i) % 16, (str_byte_at(d, i) % 16) + 1) ++ dvr-hex(d, i + 1));
  def dvr-sha(path) { let d = record_get(sho-file(path), "digest"); len(d) == 32 ? dvr-hex(d, 0) : ""; }
  def dvr-logits-pinned?() = file_size(dvr-logits-path()) == dvr-logits-bytes() && dvr-sha(dvr-logits-path()) == dvr-logits-sha();

  // ---- the receipt row -------------------------------------------------------------------------------------------------------------------------
  def dvr-q(s) = "\"" ++ s ++ "\"";
  def dvr-kv(k, v) = dvr-q(k) ++ ":" ++ v;
  def dvr-join(xs, sep) = len(xs) == 0 ? "" : (len(xs) == 1 ? xs[0] : xs[0] ++ sep ++ dvr-join(xs[1:], sep));
  def dvr-ids-json(xs) = "[" ++ dvr-join(map(x => x.str(), xs), ",") ++ "]";
  def dvr-floats-json(xs) = "[" ++ dvr-join(map(x => x.str(), xs), ",") ++ "]";
  def dvr-stage-json(s) = "{" ++ dvr-join([dvr-kv("stage", dvr-q(s[0])), dvr-kv("estimate", s[1].str()), dvr-kv("wired_delta", s[2].str()), dvr-kv("ms", s[3].str()), dvr-kv("own_delta", s[4].str())], ",") ++ "}";
  // r: the run's record: status reason file bytes lease cap cache stages(list of [label est delta ms]) wirespan(delta slice stack kind) cold_ms matched ids deterministic agreement gaps
  def dvr-receipt-row(date, at, r) = "{" ++ dvr-join([
   dvr-kv("schema", dvr-q("dsv4-validation-v1")), dvr-kv("at_unix_ms", at.str()), dvr-kv("date", dvr-q(date)), dvr-kv("status", dvr-q(record_get(r, "status"))), dvr-kv("reason", dvr-q(record_get(r, "reason"))),
   dvr-kv("file", dvr-q(record_get(r, "file"))), dvr-kv("file_bytes", record_get(r, "bytes").str()), dvr-kv("lease_shared", record_get(r, "shared").str()), dvr-kv("lease_private", mg-kv-margin().str()),
   dvr-kv("cap", record_get(r, "cap").str()), dvr-kv("cache_experts", record_get(r, "cache").str()), dvr-kv("wired_noise", record_get(r, "noise").str()),
   dvr-kv("stages", "[" ++ dvr-join(map(s => dvr-stage-json(s), record_get(r, "stages")), ",") ++ "]"),
   dvr-kv("wirespan", "{" ++ dvr-join([dvr-kv("delta", record_get(r, "ws-delta").str()), dvr-kv("slice", record_get(r, "ws-slice").str()), dvr-kv("stack", record_get(r, "ws-stack").str()), dvr-kv("kind", dvr-q(record_get(r, "ws-kind")))], ",") ++ "}"),
   dvr-kv("cold_token_ms", record_get(r, "cold-ms").str()), dvr-kv("stream_matched", record_get(r, "matched").str()), dvr-kv("stream_of", "24"), dvr-kv("ids", dvr-ids-json(record_get(r, "ids"))),
   dvr-kv("stream_margins", dvr-floats-json(record_get(r, "margins"))), dvr-kv("stream_recorded_gap", dvr-floats-json(record_get(r, "rgaps"))),
   dvr-kv("deterministic", record_get(r, "deterministic").str()),
   dvr-kv("logits", record_get(r, "logits")), dvr-kv("driver_gaps", "[" ++ dvr-join(map(g => dvr-q(g), record_get(r, "gaps")), ",") ++ "]"),
   dvr-kv("elapsed_ms", record_get(r, "elapsed").str())], ",") ++ "}";
  def dvr-logits-json(a) = "{" ++ dvr-join([dvr-kv("r", a[0].str()), dvr-kv("top10_overlap", a[1].str()), dvr-kv("argmax_ours", a[2].str()), dvr-kv("argmax_ref", a[3].str()), dvr-kv("ref_margin", a[4].str()), dvr-kv("max_delta_top64", a[5].str()), dvr-kv("finite", a[6].str())], ",") ++ "}";
  def dvr-date() = trim(host-exec("date '+%Y-%m-%d %H:%M:%S %Z'", ""));
  def dvr-append(path, line) = write_file_text(path, (read_file(path) ?? "") ++ line ++ "\n");

  // ---- the run (the window; never run by a band) --------------------------------------------------------------------------------------------------
  def dvr-said(lines) = len(lines) == 0 ? 0 : dvr-said-next(print_str(lines[0]), lines[1:]);
  def dvr-said-next(said, rest) = dvr-said(rest);
  def dvr-env(file, m, size, shared, cap, cache, base, lease) = record_new(0, "file", file, "m", m, "bytes", size, "shared", shared, "cap", cap, "cache", cache, "base", base, "lease", lease, "prev", base, "noise", 0, "t0", host_monotonic_ms(),
    "log", [], "ctx", [], "sts", [], "reason", "", "ws-delta", 0, "ws-slice", 0, "ws-stack", 0, "ws-kind", "none", "cold-ms", 0, "matched", 0, "ids", [], "margins", [], "rgaps", [], "deterministic", 0, "logits", "{\"waits\":\"no logits_prompt_ids supplied\"}", "extra", []);
  def dvr-elapsed(env) = host_monotonic_ms() - record_get(env, "t0");
  def dvr-note(env, key, v) = record_set(env, key, v);
  def dvr-log-add(env, row) = record_set(env, "log", append(record_get(env, "log"), [row]));
  // one stage: ask, run, sync, read, judge. Answers "" when it held, or the reason the run ends.
  def dvr-stage(env, label, est, run) = dvr-stage-with(env, label, est, est, run);
  // est is what the governor is asked for; limit is what the stage-delta rule is held to (the same, but for the wirespan probe)
  def dvr-stage-with(env, label, est, limit, run) {
   let before = mg-sense();
   let why = dvr-ask-reason(before, est);
   why != "" ? dvr-stop(env, label, why) : dvr-stage-run(env, label, est, limit, run);
  }
  // the stage's line: its wired growth, the machine's own movement it is judged less, and the device's own bytes the stage took
  def dvr-stage-said(label, delta, est, noise, own, ms) = "[dsv4-validate] stage " ++ label ++ ": wired " ++ (delta >= 0 ? "+" : "-") ++ dvr-gib(delta >= 0 ? delta : 0 - delta) ++ " against an estimate of " ++ dvr-gib(est)
   ++ " (the machine moved by up to " ++ dvr-gib(noise) ++ " by itself), own device bytes " ++ (own >= 0 ? "+" : "-") ++ (own >= 0 ? own : 0 - own).str() ++ ", " ++ ms.str() ++ " ms";
  def dvr-stage-run(env, label, est, limit, run) {
   let t = host_monotonic_ms();
   let own0 = dvr-own();
   let r = run();
   let s = metal_sync();
   let vm = mg-sense();
   let delta = mg-wired(vm) - record_get(env, "prev");
   let own = dvr-own() - own0;
   let noted = record_set(env, "prev", mg-wired(vm));
   let logged = dvr-log-add(env, [label, est, delta, host_monotonic_ms() - t, own]);
   let said = print_str(dvr-stage-said(label, delta, est, record_get(env, "noise"), own, host_monotonic_ms() - t));
   let first = nothing?(r) ? "stage-refused" : dvr-abort-reason(vm, record_get(env, "base"), record_get(env, "lease"), limit, dvr-own-delta(delta, record_get(env, "noise")), dvr-elapsed(env));
   let why = first == "stage-delta" ? dvr-reread(env, vm, limit, delta) : first;
   why == "" ? "" : dvr-stop(env, label, why);
  }
  // THE MACHINE'S MOVEMENT IS BURSTY (19.8 MB over one 3 s reading, 331.9 MB over the next, on 2026-10-03), so a calibration taken in a lull can be below what comes after. A stage-delta is therefore met with a
  // second reading before the run ends: the machine is read again over 3 s, the movement the rule takes from the delta is the larger of the two readings, and the rule is asked again of the same delta. A growth
  // the machine's own movement does not cover (a persistent shift the re-read does not see move) still ends the run.
  def dvr-reread-reason(vm, base, lease, limit, delta, before, now, elapsed) = dvr-abort-reason(vm, base, lease, limit, dvr-own-delta(delta, before > now ? before : now), elapsed);
  def dvr-reread(env, vm, limit, delta) {
   let now = dvr-ambient();
   let before = record_get(env, "noise");
   let widened = record_set(env, "noise", before > now ? before : now);
   let said = print_str("[dsv4-validate] stage-delta met on a wired growth of " ++ delta.str() ++ " B: the machine read again over 3 s moved by " ++ now.str() ++ " B (" ++ before.str() ++ " B before the window); the rule is asked again with the larger");
   dvr-reread-reason(vm, record_get(env, "base"), record_get(env, "lease"), limit, delta, before, now, dvr-elapsed(env));
  }
  def dvr-stop(env, label, why) {
   let said = print_str("[dsv4-validate] ABORT at " ++ label ++ ": " ++ why);
   why;
  }
  def dvr-seq(steps) = len(steps) == 0 ? "" : dvr-seq-next(steps, steps[0]());
  def dvr-seq-next(steps, r) = r == "" ? dvr-seq(steps[1:]) : r;
  def dvr-ctx(env) = record_get(env, "ctx");
  def dvr-sts(env) = record_get(env, "sts");

  def dvr-do-compile(env) { let ps = dkr-open-pipes(dkr-graph-units()); record_set(env, "ps", ps); 1; }
  def dvr-do-map(env) {
   let ctx = dsv4-open-span(record_get(env, "file"), record_get(env, "cap"), 1);
   len(ctx) == 13 ? { let k = record_set(env, "ctx", ctx); let p = dsv4-prepare(ctx); p == 1 ? 1 : nothing(); } : nothing();
  }
  def dvr-do-state(env) {
   let ctx = dvr-ctx(env);
   let sts = dsv4-new-state(ctx[2], ctx[0], record_get(env, "cap"));
   nothing?(sts) ? nothing() : { let k = record_set(env, "sts", sts); 1; };
  }
  // one dispatch over one expert slice of layer 0's gate stack
  def dvr-do-wirespan(env) {
   let ctx = dvr-ctx(env);
   let m = record_get(env, "m");
   let ids = metal_buf_write(dso-buf(ctx, "expert-ids"), 0, dkr-u32-bytes([137]));
   let hidden = dvl-l(m, 0, "hidden");
   let e = record_get(m, "e");
   let r = dkr-go(dkl-p(ctx, dkl-expert-kernel(dvl-l(m, 0, "gate-type"))), [dso-handle(ctx, "blk.0.ffn_gate_exps.weight"), dkl-b(ctx, "xn"), dkl-b(ctx, "xgate"), dkl-b(ctx, "expert-ids")], [hidden, e, 1, 0], hidden * 32);
   let k1 = record_set(env, "ws-slice", dvr-slice(m));
   let k2 = record_set(env, "ws-stack", dvr-stack(m));
   r == 1 ? 1 : nothing();
  }
  // after the wirespan stage: judge the probe from the delta that stage logged
  def dvr-judge-wirespan(env) {
   let row = dvr-log-last(record_get(env, "log"));
   let kind = dvr-wirespan-kind-noisy(row[2], record_get(env, "noise"), record_get(env, "ws-slice"), record_get(env, "ws-stack"));
   let k1 = record_set(env, "ws-delta", row[2]);
   let k2 = record_set(env, "ws-kind", kind);
   let said = print_str("[dsv4-validate] wirespan: one expert slice of " ++ record_get(env, "ws-slice").str() ++ " B read from a stack of " ++ record_get(env, "ws-stack").str() ++ " B grew wired memory by " ++ row[2].str() ++ " B: " ++ kind);
   kind == "stack" ? dvr-stop(env, "wirespan", "wirespan-whole-stack") : "";
  }
  def dvr-log-last(log) = log[len(log) - 1];
  def dvr-do-layer(env, il) {
   let ctx = dvr-ctx(env);
   let emb = il == 0 ? dsv4-embed(ctx, dvr-token-1()) : 2;
   let r = nothing?(emb) ? nothing() : dsv4-layer(ctx, dvr-sts(env), il, 0, dvr-token-1(), record_get(env, "cap"));
   nothing?(r) ? nothing() : 1;
  }
  def dvr-layer-steps(env, m, il) = il == record_get(m, "layers-n") ? [] : cons(() => dvr-stage(env, "layer-" ++ il.str(), dvr-est-layer(m, il), () => dvr-do-layer(env, il)), dvr-layer-steps(env, m, il + 1));
  def dvr-do-head(env) {
   let ctx = dvr-ctx(env);
   let h = dsv4-head(ctx);
   let id = nothing?(h) ? nothing() : dsv4-argmax(ctx);
   let k = record_set(env, "cold-ms", dvr-elapsed(env));
   nothing?(id) ? nothing() : 1;
  }
  // a fresh state for a new walk: the old one is freed (synced rounds) first
  def dvr-fresh-state(env) {
   let freed = dsv4-free-state(dvr-sts(env));
   let ctx = dvr-ctx(env);
   let sts = dsv4-new-state(ctx[2], ctx[0], record_get(env, "cap"));
   nothing?(sts) ? nothing() : { let k = record_set(env, "sts", sts); 1; };
  }
  def dvr-do-logits(env, ids) {
   let fresh = dvr-fresh-state(env);
   let ctx = dvr-ctx(env);
   let pf = nothing?(fresh) ? nothing() : dsv4-prefill-span-sliced(ctx, dvr-sts(env), ids, 0);
   let ours = nothing?(pf) ? [] : dsv4-logits(ctx);
   let a = len(ours) == 0 ? nothing() : dvr-agreement(ours, dvr-ref-logits());
   let k = nothing?(a) ? 0 : record_set(env, "logits", dvr-logits-json(a));
   let said = nothing?(a) ? 0 : print_str("[dsv4-validate] logits: r " ++ a[0].str() ++ ", top-10 overlap " ++ a[1].str() ++ "/10, our argmax " ++ a[2].str() ++ " and theirs " ++ a[3].str() ++ ", their top-two margin " ++ a[4].str() ++ " against our max delta over their top 64 " ++ a[5].str());
   nothing?(a) ? nothing() : 1;
  }
  // [ids, last logits bits] of one 24-id walk from a fresh state
  // [ids, the reading of each step (dvr-step: our argmax, our top-two margin, the recorded id's gap below our top), the last logits' bits] of one 24-id walk from a fresh state: the prefill answers id 0 from
  // the logits it leaves, and each decode answers the next id from the logits IT leaves, each read before the next step overwrites them
  def dvr-walk-go(ctx, sts, id, pos, left, ids, rd, lg) {
   left == 0 ? [ids, rd, dvr-bits(lg)] : {
    let nid = dsv4-decode(ctx, sts, id, pos);
    nothing?(nid) ? [ids, rd, dvr-bits(lg)] : {
     let lg2 = dsv4-logits(ctx);
     dvr-walk-go(ctx, sts, nid, pos + 1, left - 1, append(ids, [nid]), append(rd, [dvr-step(lg2, dvr-want-at(len(ids)))]), lg2);
    };
   };
  }
  def dvr-walk(env) {
   let fresh = dvr-fresh-state(env);
   let ctx = dvr-ctx(env);
   let pf = nothing?(fresh) ? nothing() : dsv4-prefill-span-sliced(ctx, dvr-sts(env), dvr-prompt(), 0);
   let lg0 = nothing?(pf) ? [] : dsv4-logits(ctx);
   nothing?(pf) ? nothing() : dvr-walk-go(ctx, dvr-sts(env), pf[0], pf[1], len(dvr-stream()) - 1, [pf[0]], [dvr-step(lg0, dvr-want-at(0))], lg0);
  }
  def dvr-do-stream(env) {
   let a = dvr-walk(env);
   let b = nothing?(a) ? nothing() : dvr-walk(env);
   let m1 = nothing?(a) ? 0 : dvr-matched(a[0], dvr-stream());
   let k1 = record_set(env, "ids", nothing?(a) ? [] : a[0]);
   let k2 = record_set(env, "matched", m1);
   let same = (nothing?(a) || nothing?(b)) ? 0 : (a[0] == b[0] && a[2] == b[2] && a[1] == b[1] ? 1 : 0);
   let k3 = record_set(env, "deterministic", same);
   let k4 = record_set(env, "margins", nothing?(a) ? [] : dvr-steps-margins(a[1]));
   let k5 = record_set(env, "rgaps", nothing?(a) ? [] : dvr-steps-gaps(a[1]));
   let said = print_str("[dsv4-validate] stream: " ++ m1.str() ++ " of 24 recorded ids matched from the start; twice from a fresh state: " ++ (same == 1 ? "ids and last logits bit-equal" : "NOT bit-equal")
    ++ "; our top-two margin at each step " ++ dvr-floats-json(record_get(env, "margins")) ++ ", the recorded id's gap below our top " ++ dvr-floats-json(record_get(env, "rgaps")));
   nothing?(a) || nothing?(b) ? nothing() : 1;
  }
  def dvr-steps(env, m, opts) {
   let ids = dvr-logits-ids(opts);
   append([() => dvr-stage(env, "compile", dvr-bound(), () => dvr-do-compile(env)),
           () => dvr-stage(env, "map", dvr-est-map(m, record_get(env, "cap")), () => dvr-do-map(env)),
           () => dvr-stage(env, "state", dvl-kv-total(m, record_get(env, "cap")), () => dvr-do-state(env)),
           () => dvr-stage-with(env, "wirespan", dvr-slice(m), dvr-wirespan-limit(m), () => dvr-do-wirespan(env)),
           () => dvr-judge-wirespan(env)],
     append(dvr-layer-steps(env, m, 0),
      append([() => dvr-stage(env, "head", dvr-est-head(m), () => dvr-do-head(env))],
       append(len(ids) > 0 ? [() => dvr-stage(env, "logits", dls-cache(m, record_get(env, "cache")), () => dvr-do-logits(env, ids))] : [() => dvr-waits(env, "logits")],
        [() => dvr-stage(env, "stream", dls-cache(m, record_get(env, "cache")), () => dvr-do-stream(env))]))));
  }
  // a leg that waits for what the caller has not supplied: named in the log and the output, no estimate, no run, no abort
  def dvr-waits(env, label) {
   let logged = dvr-log-add(env, [label ++ "-waits-for-prompt-ids", 0, 0, 0, 0]);
   let said = print_str("[dsv4-validate] stage " ++ label ++ ": waits for logits_prompt_ids (none supplied and the pinned row does not hold); not run");
   "";
  }
  // free everything the window holds, give the lease back, answer the handles still held
  def dvr-release(env) {
   let s = metal_sync();
   let ctx = dvr-ctx(env);
   let left = len(ctx) == 13 ? dsv4-close(ctx, dvr-sts(env)) : [];
   let unleased = mg-release();
   len(left);
  }
  def dvr-record(env, status, reason, held) = record_new(0, "status", status, "reason", reason, "file", record_get(env, "file"), "bytes", record_get(env, "bytes"), "shared", record_get(env, "shared"), "cap", record_get(env, "cap"),
    "cache", record_get(env, "cache"), "noise", record_get(env, "noise"), "stages", record_get(env, "log"), "ws-delta", record_get(env, "ws-delta"), "ws-slice", record_get(env, "ws-slice"), "ws-stack", record_get(env, "ws-stack"), "ws-kind", record_get(env, "ws-kind"),
    "cold-ms", record_get(env, "cold-ms"), "matched", record_get(env, "matched"), "ids", record_get(env, "ids"), "margins", record_get(env, "margins"), "rgaps", record_get(env, "rgaps"), "deterministic", record_get(env, "deterministic"), "logits", record_get(env, "logits"),
    "gaps", dvr-gaps(record_get(env, "m")), "elapsed", dvr-elapsed(env), "held", held);
  def dvr-finish(env, opts, why) {
   let held = dvr-release(env);
   let status = why == "" ? "completed" : "aborted";
   let r = dvr-record(env, status, why == "" ? (held == 0 ? "released" : "handles-held") : why, held);
   let row = dvr-receipt-row(dvr-date(), now_unix_ms(), r);
   let wrote = dvr-append(dvr-text(opts, "receipt", dvr-receipt-path()), row);
   let said = print_str("[dsv4-validate] " ++ status ++ ": " ++ record_get(r, "reason") ++ "; handles still held " ++ held.str() ++ "; receipt row " ++ (wrote >= 0 ? "written" : "NOT written"));
   status == "completed" && held == 0 ? 0 : 1;
  }
  def dvr-refuse(why, file) {
   let said = print_str("[dsv4-validate] REFUSED before anything opened: " ++ why);
   1;
  }
  // the window: the checks that must hold before anything opens, the lease, the stages
  def dvr-window(opts) {
   let file = dvr-text(opts, "file", dvr-file());
   let size = file_size(file);
   let src = size > 24 ? dvl-src(file) : "";
   let m = (str_len(src) > 24 && egg-magic-ok?(src) == 1 && gmt-str(src, "general.architecture") == "deepseek4") ? dvl-open(src) : nothing();
   let facts = dvr-facts();
   !(!nothing?(m) && dvl-consistent?(m)) ? dvr-refuse("the file is not a deepseek4 GGUF with a consistent layout", file) : !dvr-facts-clear?(facts) ? dvr-refuse(flp-join(dvr-facts-lines(facts), " | "), file) : !dvr-logits-pinned?() ? dvr-refuse("the recorded logits file is not the one pinned", file) : len(dvr-gaps(m)) > 0 ? dvr-refuse-gaps(opts, file, size, m) : dvr-window-leased(opts, file, size, m);
  }
  def dvr-window-leased(opts, file, size, m) {
   let cap = dvr-int(opts, "cap", dvr-default-cap());
   let cache = dvr-int(opts, "cache_experts", dls-cache-experts());
   let shared = dls-shared(m, cache, cap);
   let granted = mg-lease("dsv4 validation window", file, shared, mg-kv-margin());
   !mg-granted?(granted) ? dvr-refuse(mg-line("dsv4 validation window", shared + mg-kv-margin(), granted), file) : dvr-window-run(opts, file, size, m, shared, cap, cache);
  }
  def dvr-window-run(opts, file, size, m, shared, cap, cache) {
   let noise = dvr-ambient();
   let vm0 = mg-sense();
   let env = dvr-env(file, m, size, shared, cap, cache, mg-wired(vm0), shared + mg-kv-margin());
   let noted = record_set(env, "noise", noise);
   let said = print_str(dvr-ambient-line(noise));
   // a stop inside a stage is a backtrack point, not the end of the window: it reads as an abort, and the handles, the lease and the receipt follow
   let why = try dvr-seq(dvr-steps(env, m, opts)) catch "walker-stop";
   dvr-finish(env, opts, why);
  }
  // the header names tensors the driver cannot run: the window cannot succeed, so nothing is mapped or compiled, any lease this process holds is given back, and the receipt names the gaps
  def dvr-refuse-gaps(opts, file, size, m) {
   let cap = dvr-int(opts, "cap", dvr-default-cap());
   let cache = dvr-int(opts, "cache_experts", dls-cache-experts());
   let env = dvr-env(file, m, size, dls-shared(m, cache, cap), cap, cache, 0, 0);
   let unleased = mg-release();
   let row = dvr-receipt-row(dvr-date(), now_unix_ms(), dvr-record(env, "refused", "driver-gaps", 0));
   let wrote = dvr-append(dvr-text(opts, "receipt", dvr-receipt-path()), row);
   let said = print_str("[dsv4-validate] REFUSED before anything was mapped: the driver cannot run " ++ len(dvr-gaps(m)).str() ++ " things this file holds (" ++ flp-join(dvr-gaps(m), "; ") ++ "); receipt row " ++ (wrote >= 0 ? "written" : "NOT written"));
   1;
  }
  // the door: the dry plan, or the window
  def dvr-main() {
   let opts = dvr-options();
   dvr-dry?(opts) ? dvr-dry(opts) : dvr-window(opts);
  }
  def dvr-dry(opts) {
   let file = dvr-text(opts, "file", dvr-file());
   let size = file_size(file);
   let src = size > 24 ? dvl-src(file) : "";
   let m = (str_len(src) > 24 && egg-magic-ok?(src) == 1 && gmt-str(src, "general.architecture") == "deepseek4") ? dvl-open(src) : nothing();
   nothing?(m) ? dvr-refuse("dry: the file is not a deepseek4 GGUF (or is absent): " ++ file, file) : dvr-said(dvr-plan-lines(m, size, opts, dvr-facts(), dvr-ambient()));
  }
 }
 0;
}
