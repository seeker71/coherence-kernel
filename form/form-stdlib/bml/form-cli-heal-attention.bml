// Failure asks for evidence before another attempt. A successful process exit
// and a model's error signal are separate observations.
// preludes: form-stdlib/bml/form-cli-heal-native-io.bml observe/bidirectional-framebuffer-channel.fk cognition/error-loving-attention.fk
section [form.bml] {
 class FormCliHealAttention {
  def fha-error-phase(phase) = fhn-member(list("error", "forward-refused", "stream-write-refused", "context-capacity"), phase);
  def fha-kind(status, reason, signals) = if str_eq(reason, "timeout") then "timeout" else if str_eq(reason, "cancelled") then "cancelled" else if ne(status, 0) then "process-failure" else if gt(signals, 0) then "reported-error" else "";
  // Only evidence acquisition and explicit deferral have actuators here.
  // A missing, stale or unsupported response selects evidence acquisition.
  def fha-select(outbound, inbound) = if nothing?(inbound) then bfc-alternative(outbound) else if ne(len(inbound), 5) then bfc-alternative(outbound) else if not(and(eq(bfc-direction(inbound), 1), and(eq(bfc-kind(inbound), 1), eq(bfc-exchange(outbound), bfc-exchange(inbound))))) then bfc-alternative(outbound) else if or(eq(bfc-payload(inbound), 4), eq(bfc-payload(inbound), 7)) then bfc-payload(inbound) else bfc-alternative(outbound);
  def fha-action(code) = if eq(code, 7) then "defer" else "request-evidence";
  def fha-next(kind) = if str_eq(kind, "timeout") then "review-stage-timing" else if str_eq(kind, "cancelled") then "await-caller-direction" else if str_eq(kind, "reported-error") then "inspect-model-stage" else "revise-from-diagnostics";
  // References share the original bytes. No private output enters the frame.
  def fha-file(path) = json-node-object(list(fhn-s("path", path), fhn-n("bytes", file_size(path)), fhn-n("present", ge(file_size(path), 0))));
 }
 0;
}
