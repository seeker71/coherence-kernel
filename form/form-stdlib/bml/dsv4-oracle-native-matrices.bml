// Form-emitted ordered fp64 reductions for F16, MXFP4 and IQ2_XXS weights.
// preludes: form/form-stdlib/bml/dsv4-oracle-reference.bml form-stdlib/bml/native-fp64-matrix.bml
section [form.bml] {
 class Dsv4QuantRam {
  def dqr-e2-code(first,last,label) = list(
   nfm-ubfx(12,8,first,last),nfm-ubfx(13,12,1,2),nfm-ubfx(14,12,0,0),nfm-ubfx(15,12,3,3),fa-lsl-x-imm(15,15,63),fa-cmp-x(13,0),npd-branch(0,str_concat(label,"-subnormal")),
   fa-add-x-imm(13,13,1022),fa-lsl-x-imm(13,13,52),fa-lsl-x-imm(14,14,51),fa-add-x-r(14,14,13),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),npd-branch(14,str_concat(label,"-done")),
   npd-label(str_concat(label,"-subnormal")),fa-scvtf(1,14),fa-fmul(1,1,6),fa-fmov-x-d(14,1),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),npd-label(str_concat(label,"-done")));
  def dqr-mx4-image() {
   let rows = npd-cat(list(list(
    fa-add-x-imm(17,7,0),fa-movz-x(16,1022),fa-lsl-x-imm(16,16,52),fa-fmov-d-x(6,16),
    npd-label("row"),fa-cmp-x(7,0),npd-branch(0,"done"),fa-fmov-d-x(4,31),fa-add-x-imm(9,4,0),nfm-ubfx(10,5,8,63),
    npd-label("group"),fa-fmov-d-x(0,31),fa-fmov-d-x(5,31),fa-movz-x(11,16),
    npd-label("element"),fa-ldrb(8,0,0),fa-add-x-imm(0,0,1)),dqr-e2-code(0,3,"low"),list(
    fa-ldr-d(2,9,0),fa-add-x-imm(9,9,8),fa-fmul(1,1,2),fa-fadd(0,0,1)),dqr-e2-code(4,7,"high"),list(
    fa-ldr-d(2,9,0),fa-add-x-imm(9,9,8),fa-fmul(1,1,2),fa-fadd(5,5,1),fa-sub-x-imm(11,11,1),fa-cmp-x(11,0),npd-branch(1,"element"),
    fa-ldrb(13,2,0),fa-add-x-imm(2,2,1),fa-add-x-imm(13,13,896),fa-lsl-x-imm(13,13,52),fa-fmov-d-x(3,13),fa-fadd(0,0,5),fa-fmul(0,0,3),fa-fadd(4,4,0),fa-sub-x-imm(10,10,1),fa-cmp-x(10,0),npd-branch(1,"group"),
    fa-str-d(4,6,0),fa-add-x-imm(6,6,8),fa-sub-x-imm(7,7,1),npd-branch(14,"row"),npd-label("done"),fa-add-x-imm(0,17,0),fa-ret())));
   fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
  }
  def dqr-f16-image() {
   let rows = list(
    fa-add-x-imm(17,7,0),fa-movz-x(16,999),fa-lsl-x-imm(16,16,52),fa-fmov-d-x(6,16),
    npd-label("row"),fa-cmp-x(7,0),npd-branch(0,"done"),fa-fmov-d-x(4,31),fa-add-x-imm(9,4,0),nfm-ubfx(10,5,3,63),
    npd-label("element"),fa-ldrb(12,0,0),fa-ldrb(13,0,1),fa-lsl-x-imm(13,13,8),fa-add-x-r(12,12,13),fa-add-x-imm(0,0,2),nfm-ubfx(13,12,10,14),nfm-ubfx(14,12,0,9),nfm-ubfx(15,12,15,15),fa-lsl-x-imm(15,15,63),fa-cmp-x(13,0),npd-branch(0,"subnormal"),
    fa-cmp-x(13,31),npd-branch(0,"special"),fa-add-x-imm(13,13,1008),npd-branch(14,"normal"),npd-label("special"),fa-movz-x(13,2047),
    npd-label("normal"),fa-lsl-x-imm(13,13,52),fa-lsl-x-imm(14,14,42),fa-add-x-r(14,14,13),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),npd-branch(14,"multiply"),
    npd-label("subnormal"),fa-scvtf(1,14),fa-fmul(1,1,6),fa-fmov-x-d(14,1),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),
    npd-label("multiply"),fa-ldr-d(2,9,0),fa-add-x-imm(9,9,8),fa-fmul(1,1,2),fa-fadd(4,4,1),fa-sub-x-imm(10,10,1),fa-cmp-x(10,0),npd-branch(1,"element"),
    fa-str-d(4,6,0),fa-add-x-imm(6,6,8),fa-sub-x-imm(7,7,1),npd-branch(14,"row"),npd-label("done"),fa-add-x-imm(0,17,0),fa-ret());
   fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
  }
  def dqr-iq-image() {
   let rows = list(
    fa-add-x-imm(17,7,0),fa-movz-x(16,999),fa-lsl-x-imm(16,16,52),fa-fmov-d-x(6,16),
    npd-label("row"),fa-cmp-x(7,0),npd-branch(0,"done"),fa-fmov-d-x(4,31),fa-add-x-imm(9,4,0),nfm-ubfx(10,5,11,63),
    npd-label("block"),fa-ldrb(12,0,0),fa-ldrb(13,0,1),fa-lsl-x-imm(13,13,8),fa-add-x-r(12,12,13),fa-add-x-imm(0,0,2),nfm-ubfx(13,12,10,14),nfm-ubfx(14,12,0,9),nfm-ubfx(15,12,15,15),fa-lsl-x-imm(15,15,63),fa-cmp-x(13,0),npd-branch(0,"subnormal"),
    fa-cmp-x(13,31),npd-branch(0,"special"),fa-add-x-imm(13,13,1008),npd-branch(14,"normal"),npd-label("special"),fa-movz-x(13,2047),
    npd-label("normal"),fa-lsl-x-imm(13,13,52),fa-lsl-x-imm(14,14,42),fa-add-x-r(14,14,13),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),npd-branch(14,"scale"),
    npd-label("subnormal"),fa-scvtf(1,14),fa-fmul(1,1,6),fa-fmov-x-d(14,1),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),
    npd-label("scale"),fa-movz-x(16,1020),fa-lsl-x-imm(16,16,52),fa-fmov-d-x(2,16),fa-fmul(3,1,2),fa-movz-x(11,8),
    npd-label("group"),fa-ldrb(15,0,4),fa-ldrb(16,0,5),fa-lsl-x-imm(16,16,8),fa-add-x-r(15,15,16),fa-ldrb(16,0,6),fa-lsl-x-imm(16,16,16),fa-add-x-r(15,15,16),fa-ldrb(16,0,7),fa-lsl-x-imm(16,16,24),fa-add-x-r(15,15,16),
    nfm-ubfx(3,15,28,31),fa-add-x-r(3,3,3),fa-add-x-imm(3,3,1),fa-scvtf(5,3),fa-fmul(5,5,3),fa-fmov-d-x(0,31),fa-movz-x(12,4),
    npd-label("quarter"),fa-ldrb(14,0,0),fa-add-x-imm(0,0,1),fa-lsl-x-imm(14,14,3),fa-add-x-r(14,14,2),nfm-ubfx(13,15,0,6),fa-add-x-imm(3,2,2048),fa-add-x-r(3,3,13),fa-ldrb(13,3,0),fa-movz-x(1,8),fa-fmov-d-x(7,31),
    npd-label("element"),fa-ldrb(16,14,0),fa-add-x-imm(14,14,1),fa-scvtf(1,16),nfm-ubfx(3,13,0,0),fa-lsl-x-imm(3,3,63),fa-fmov-x-d(16,1),fa-add-x-r(16,16,3),fa-fmov-d-x(1,16),nfm-ubfx(13,13,1,63),fa-ldr-d(2,9,0),fa-add-x-imm(9,9,8),fa-fmul(1,1,2),fa-fadd(7,7,1),fa-sub-x-imm(1,1,1),fa-cmp-x(1,0),npd-branch(1,"element"),
    fa-fadd(0,0,7),nfm-ubfx(15,15,7,63),fa-sub-x-imm(12,12,1),fa-cmp-x(12,0),npd-branch(1,"quarter"),
    fa-fmul(0,0,5),fa-fadd(4,4,0),fa-add-x-imm(0,0,4),fa-sub-x-imm(11,11,1),fa-cmp-x(11,0),npd-branch(1,"group"),
    fa-sub-x-imm(10,10,1),fa-cmp-x(10,0),npd-branch(1,"block"),fa-str-d(4,6,0),fa-add-x-imm(6,6,8),fa-sub-x-imm(7,7,1),npd-branch(14,"row"),npd-label("done"),fa-add-x-imm(0,17,0),fa-ret());
   fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
  }
  def dqr-open(kind) {
   dfo-require(or(eq(kind,1),or(eq(kind,40),eq(kind,16))),"unknown independent matrix format");
   let owner = nfm-open(); let tombstoned = jit_leaf_inram(list(1,record_get(owner,"identity"),list()),0); dfo-require(eq(tombstoned,0),"independent numerical owner unused identity close");
   let image = if eq(kind,1) then dqr-f16-image() else if eq(kind,40) then dqr-mx4-image() else if eq(kind,16) then dqr-iq-image() else list(); dfo-require(gt(len(image),0),"unknown independent matrix format");
   let identity = intern_node(make_nodeid(31,2,0,182),cons(intern_trivial_string("dsv4-independent-quant-fp64-v1"),cons(intern_trivial_int(owner),npd-nodes(image))));
   record_set(owner,"image",image); record_set(owner,"identity",identity); record_set(owner,"request",list(0,identity,image)); record_set(owner,"format",kind); owner;
  }
  def dqr-basic(owner,x,rows,kind) = if not(and(nfm-active(owner),and(eq(record_get(owner,"format"),kind),record?(x)))) then 0 else if not(and(dfo-positive(rows),le(rows,576460752303423487))) then 0 else if not(and(dfo-positive(record_get(x,"count")),le(record_get(x,"count"),576460752303423487))) then 0 else and(str_eq(value_kind(record_get(x,"bytes")),"string"),nfm-vector-good(x));
  def dqr-f16-run(owner,data,x,rows,region) {
   let cols = record_get(x,"count");
   let valid = if not(and(dqr-basic(owner,x,rows,1),str_eq(value_kind(data),"string"))) then 0 else and(eq(mod(str_len(data),mul(cols,2)),0),eq(div(str_len(data),mul(cols,2)),rows));
   let pointer = if valid then npd-owned-span(record_get(owner,"memory"),region,0,mul(rows,8)) else nothing();
   if nothing?(pointer) then nothing() else nfm-mx8-execute(owner,data,"",record_get(x,"bytes"),rows,pointer);
  }
  def dqr-mx4-run(owner,data,scales,x,rows,region) {
   let cols = record_get(x,"count");
   let valid = if not(and(dqr-basic(owner,x,rows,40),and(str_eq(value_kind(data),"string"),str_eq(value_kind(scales),"string")))) then 0 else and(eq(mod(cols,32),0),and(eq(mod(str_len(data),div(cols,2)),0),and(eq(div(str_len(data),div(cols,2)),rows),eq(str_len(scales),div(str_len(data),16)))));
   let pointer = if valid then npd-owned-span(record_get(owner,"memory"),region,0,mul(rows,8)) else nothing();
   if nothing?(pointer) then nothing() else nfm-mx8-execute(owner,data,scales,record_get(x,"bytes"),rows,pointer);
  }
  def dqr-iq-grid(grid,i,j,bins) = if eq(i,256) then fbc-finish(bins,"") else if eq(j,8) then dqr-iq-grid(grid,add(i,1),0,bins) else dqr-iq-grid(grid,i,add(j,1),fbc-put(bins,byte_to_str(dfo-grid-byte(grid,i,j))));
  def dqr-iq-tables() = str_concat(dqr-iq-grid(dfo-iq-grid-hex(),0,0,list()),nfm-bytes-list(dfo-iq-signs(),""));
  def dqr-iq-run(owner,data,tables,x,rows,region) {
   let cols = record_get(x,"count"); let stride = dfo-product(div(cols,256),66);
   let valid = if not(and(dqr-basic(owner,x,rows,16),and(str_eq(value_kind(data),"string"),str_eq(value_kind(tables),"string")))) then 0 else if not(and(eq(str_len(tables),2176),and(eq(mod(cols,256),0),dfo-positive(stride)))) then 0 else and(eq(mod(str_len(data),stride),0),eq(div(str_len(data),stride),rows));
   let pointer = if valid then npd-owned-span(record_get(owner,"memory"),region,0,mul(rows,8)) else nothing();
   if nothing?(pointer) then nothing() else nfm-mx8-execute(owner,data,tables,record_get(x,"bytes"),rows,pointer);
  }
 }
 0;
}
