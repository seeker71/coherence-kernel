 class Dsv4QuantRam {
  def dqr-e2-code(first,last,label) = list(
   nfm-ubfx(12,8,first,last),nfm-ubfx(13,12,1,2),nfm-ubfx(14,12,0,0),nfm-ubfx(15,12,3,3),fa-lsl-x-imm(15,15,63),fa-cmp-x(13,0),npd-branch(0,str_concat(label,"-subnormal")),
