    fa-cmp-x(13,31),npd-branch(0,"special"),fa-add-x-imm(13,13,1008),npd-branch(14,"normal"),npd-label("special"),fa-movz-x(13,2047),
    npd-label("normal"),fa-lsl-x-imm(13,13,52),fa-lsl-x-imm(14,14,42),fa-add-x-r(14,14,13),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),npd-branch(14,"scale"),
    npd-label("subnormal"),fa-scvtf(1,14),fa-fmul(1,1,6),fa-fmov-x-d(14,1),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),
    npd-label("scale"),fa-movz-x(16,1020),fa-lsl-x-imm(16,16,52),fa-fmov-d-x(2,16),fa-fmul(3,1,2),fa-movz-x(11,8),
    npd-label("group"),fa-ldrb(15,0,4),fa-ldrb(16,0,5),fa-lsl-x-imm(16,16,8),fa-add-x-r(15,15,16),fa-ldrb(16,0,6),fa-lsl-x-imm(16,16,16),fa-add-x-r(15,15,16),fa-ldrb(16,0,7),fa-lsl-x-imm(16,16,24),fa-add-x-r(15,15,16),
