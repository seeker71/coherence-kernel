   fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
  }
  def dqr-f16-image() {
   let rows = list(
    fa-add-x-imm(17,7,0),fa-movz-x(16,999),fa-lsl-x-imm(16,16,52),fa-fmov-d-x(6,16),
    npd-label("row"),fa-cmp-x(7,0),npd-branch(0,"done"),fa-fmov-d-x(4,31),fa-add-x-imm(9,4,0),nfm-ubfx(10,5,3,63),
    npd-label("element"),fa-ldrb(12,0,0),fa-ldrb(13,0,1),fa-lsl-x-imm(13,13,8),fa-add-x-r(12,12,13),fa-add-x-imm(0,0,2),nfm-ubfx(13,12,10,14),nfm-ubfx(14,12,0,9),nfm-ubfx(15,12,15,15),fa-lsl-x-imm(15,15,63),fa-cmp-x(13,0),npd-branch(0,"subnormal"),
    fa-cmp-x(13,31),npd-branch(0,"special"),fa-add-x-imm(13,13,1008),npd-branch(14,"normal"),npd-label("special"),fa-movz-x(13,2047),
    npd-label("normal"),fa-lsl-x-imm(13,13,52),fa-lsl-x-imm(14,14,42),fa-add-x-r(14,14,13),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),npd-branch(14,"multiply"),
    npd-label("subnormal"),fa-scvtf(1,14),fa-fmul(1,1,6),fa-fmov-x-d(14,1),fa-add-x-r(14,14,15),fa-fmov-d-x(1,14),
    npd-label("multiply"),fa-ldr-d(2,9,0),fa-add-x-imm(9,9,8),fa-fmul(1,1,2),fa-fadd(4,4,1),fa-sub-x-imm(10,10,1),fa-cmp-x(10,0),npd-branch(1,"element"),
    fa-str-d(4,6,0),fa-add-x-imm(6,6,8),fa-sub-x-imm(7,7,1),npd-branch(14,"row"),npd-label("done"),fa-add-x-imm(0,17,0),fa-ret());
   fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
