    npd-label("quarter"),fa-ldrb(14,0,0),fa-add-x-imm(0,0,1),fa-lsl-x-imm(14,14,3),fa-add-x-r(14,14,2),nfm-ubfx(13,15,0,6),fa-add-x-imm(3,2,2048),fa-add-x-r(3,3,13),fa-ldrb(13,3,0),fa-movz-x(1,8),fa-fmov-d-x(7,31),
    npd-label("element"),fa-ldrb(16,14,0),fa-add-x-imm(14,14,1),fa-scvtf(1,16),nfm-ubfx(3,13,0,0),fa-lsl-x-imm(3,3,63),fa-fmov-x-d(16,1),fa-add-x-r(16,16,3),fa-fmov-d-x(1,16),nfm-ubfx(13,13,1,63),fa-ldr-d(2,9,0),fa-add-x-imm(9,9,8),fa-fmul(1,1,2),fa-fadd(7,7,1),fa-sub-x-imm(1,1,1),fa-cmp-x(1,0),npd-branch(1,"element"),
    fa-fadd(0,0,7),nfm-ubfx(15,15,7,63),fa-sub-x-imm(12,12,1),fa-cmp-x(12,0),npd-branch(1,"quarter"),
    fa-fmul(0,0,5),fa-fadd(4,4,0),fa-add-x-imm(0,0,4),fa-sub-x-imm(11,11,1),fa-cmp-x(11,0),npd-branch(1,"group"),
    fa-sub-x-imm(10,10,1),fa-cmp-x(10,0),npd-branch(1,"block"),fa-str-d(4,6,0),fa-add-x-imm(6,6,8),fa-sub-x-imm(7,7,1),npd-branch(14,"row"),npd-label("done"),fa-add-x-imm(0,17,0),fa-ret());
   fa-image(npd-emit(rows,npd-labels(rows,0,list()),0));
  }
  def dqr-open(kind) {
   dfo-require((((Comparable) kind == 1) || (((Comparable) kind == 40) || ((Comparable) kind == 16))),"unknown independent matrix format");
   let owner = nfm-open(); let tombstoned = jit_leaf_inram(list(1,record_get(owner,"identity"),list()),0); dfo-require(((Comparable) tombstoned == 0),"independent numerical owner unused identity close");
   let image = if ((Comparable) kind == 1) then dqr-f16-image() else if ((Comparable) kind == 40) then dqr-mx4-image() else if ((Comparable) kind == 16) then dqr-iq-image() else list(); dfo-require((len(image) > 0),"unknown independent matrix format");
   let identity = intern_node(make_nodeid(31,2,0,182),cons(intern_trivial_string("dsv4-independent-quant-fp64-v1"),cons(intern_trivial_int(owner),npd-nodes(image))));
   record_set(owner,"image",image); record_set(owner,"identity",identity); record_set(owner,"request",list(0,identity,image)); record_set(owner,"format",kind); owner;
  }
  def dqr-basic(owner,x,rows,kind) = if (!(nfm-active(owner) && (((Comparable) record_get(owner,"format") == kind) && record?(x)))) then 0 else if (!(dfo-positive(rows) && (rows <= 576460752303423487))) then 0 else if (!(dfo-positive(record_get(x,"count")) && (record_get(x,"count") <= 576460752303423487))) then 0 else (((String) value_kind(record_get(x,"bytes")) == "string") && nfm-vector-good(x));
  def dqr-f16-run(owner,data,x,rows,region) {
   let cols = record_get(x,"count");
   let valid = if (!(dqr-basic(owner,x,rows,1) && ((String) value_kind(data) == "string"))) then 0 else (((Comparable) (str_len(data) % (cols * 2)) == 0) && ((Comparable) (str_len(data) / (cols * 2)) == rows));
   let pointer = if valid then npd-owned-span(record_get(owner,"memory"),region,0,(rows * 8)) else nothing();
   if nothing?(pointer) then nothing() else nfm-mx8-execute(owner,data,"",record_get(x,"bytes"),rows,pointer);
  }
  def dqr-mx4-run(owner,data,scales,x,rows,region) {
   let cols = record_get(x,"count");
   let valid = if (!(dqr-basic(owner,x,rows,40) && (((String) value_kind(data) == "string") && ((String) value_kind(scales) == "string")))) then 0 else (((Comparable) (cols % 32) == 0) && (((Comparable) (str_len(data) % (cols / 2)) == 0) && (((Comparable) (str_len(data) / (cols / 2)) == rows) && ((Comparable) str_len(scales) == (str_len(data) / 16)))));
   let pointer = if valid then npd-owned-span(record_get(owner,"memory"),region,0,(rows * 8)) else nothing();
   if nothing?(pointer) then nothing() else nfm-mx8-execute(owner,data,scales,record_get(x,"bytes"),rows,pointer);
  }
  def dqr-iq-grid(grid,i,j,bins) = if ((Comparable) i == 256) then fbc-finish(bins,"") else if ((Comparable) j == 8) then dqr-iq-grid(grid,(i + 1),0,bins) else dqr-iq-grid(grid,i,(j + 1),fbc-put(bins,byte_to_str(dfo-grid-byte(grid,i,j))));
  def dqr-iq-tables() = str_concat(dqr-iq-grid(dfo-iq-grid-hex(),0,0,list()),nfm-bytes-list(dfo-iq-signs(),""));
  def dqr-iq-run(owner,data,tables,x,rows,region) {
   let cols = record_get(x,"count"); let stride = dfo-product((cols / 256),66);
   let valid = if (!(dqr-basic(owner,x,rows,16) && (((String) value_kind(data) == "string") && ((String) value_kind(tables) == "string")))) then 0 else if (!(((Comparable) str_len(tables) == 2176) && (((Comparable) (cols % 256) == 0) && dfo-positive(stride)))) then 0 else (((Comparable) (str_len(data) % stride) == 0) && ((Comparable) (str_len(data) / stride) == rows));
   let pointer = if valid then npd-owned-span(record_get(owner,"memory"),region,0,(rows * 8)) else nothing();
   if nothing?(pointer) then nothing() else nfm-mx8-execute(owner,data,tables,record_get(x,"bytes"),rows,pointer);
  }
 }
 0;
}
