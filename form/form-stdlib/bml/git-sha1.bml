// git-sha1.bml — SHA-1 (FIPS 180-4) over a Form string, the hash git names every object by.
//
// A git object id is sha1("<type> <size>\0" ++ body). This file is the whole of it, in Form: the message is a string (strings
// are bytes, str_byte_at is O(1) and runs in the loop lane), the working registers and the sliding 16-word schedule are the
// parameters of one self-tail-calling loop, and nothing is held in a list. Whole blocks are read in place from the caller's
// string; only the one or two closing blocks (the tail, 0x80, zeros, the 64-bit bit length) are built.
//
//   gsha-raw(s)            the 20 digest bytes as a string
//   gsha-hex(s)            the 40 lowercase hex characters
//   gsha-object-hex(type, body)   the id of the framed object: sha1("<type> <len>\0" ++ body)
//   gsha-hex-of-raw(raw)   hex of any raw byte string;  gsha-raw-of-hex(hex)  the inverse (nothing() when not hex)
//
// PROOF: form-stdlib/tests/git-native-sha1-band.fk (NIST vectors, million-a style repetition, block-boundary lengths, git's
// own empty-blob id e69de29b...).
section [form.bml] {
 class GitSha1 {
  def gsha-rotl(x, n) = rotr_u32(x, 32 - n);
  def gsha-byte(s, p) = str_byte_at(s, p);
  def gsha-word(s, p) = bor(shl_u32(str_byte_at(s, p), 24), bor(shl_u32(str_byte_at(s, add(p, 1)), 16), bor(shl_u32(str_byte_at(s, add(p, 2)), 8), str_byte_at(s, add(p, 3)))));
  def gsha-f(t, b, c, d) = t < 20 ? bor(band(b, c), band(bnot_u32(b), d)) : t < 40 ? bxor(b, bxor(c, d)) : t < 60 ? bor(band(b, c), bor(band(b, d), band(c, d))) : bxor(b, bxor(c, d));
  def gsha-k(t) = t < 20 ? 1518500249 : t < 40 ? 1859775393 : t < 60 ? 2400959708 : 3395469782;
  // x0 is always the schedule word for round t; the word 16 rounds ahead is rolled in at the tail of the window
  // four stages of twenty rounds, each with its own f and k inline: no per-round dispatch, no wrapper calls
  def gsha-rounds(t, a, b, c, d, e, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15) = gsha-s0(t, a, b, c, d, e, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15);
  def gsha-s0(t, a, b, c, d, e, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15) = (Comparable) t == 20 ? gsha-s1(t, a, b, c, d, e, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15) : gsha-s0(add(t, 1), add_u32(add_u32(add_u32(rotr_u32(a, 27), bor(band(b, c), band(bnot_u32(b), d))), add_u32(e, 1518500249)), x0), a, rotr_u32(b, 2), c, d, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, rotr_u32(bxor(bxor(x13, x8), bxor(x2, x0)), 31));
  def gsha-s1(t, a, b, c, d, e, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15) = (Comparable) t == 40 ? gsha-s2(t, a, b, c, d, e, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15) : gsha-s1(add(t, 1), add_u32(add_u32(add_u32(rotr_u32(a, 27), bxor(b, bxor(c, d))), add_u32(e, 1859775393)), x0), a, rotr_u32(b, 2), c, d, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, rotr_u32(bxor(bxor(x13, x8), bxor(x2, x0)), 31));
  def gsha-s2(t, a, b, c, d, e, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15) = (Comparable) t == 60 ? gsha-s3(t, a, b, c, d, e, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15) : gsha-s2(add(t, 1), add_u32(add_u32(add_u32(rotr_u32(a, 27), bor(band(b, c), bor(band(b, d), band(c, d)))), add_u32(e, 2400959708)), x0), a, rotr_u32(b, 2), c, d, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, rotr_u32(bxor(bxor(x13, x8), bxor(x2, x0)), 31));
  def gsha-s3(t, a, b, c, d, e, x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15) = (Comparable) t == 80 ? [a, b, c, d, e] : gsha-s3(add(t, 1), add_u32(add_u32(add_u32(rotr_u32(a, 27), bxor(b, bxor(c, d))), add_u32(e, 3395469782)), x0), a, rotr_u32(b, 2), c, d, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, rotr_u32(bxor(bxor(x13, x8), bxor(x2, x0)), 31));
  def gsha-block(h, s, p) = gsha-fold(h, gsha-rounds(0, head(h), head(tail(h)), head(tail(tail(h))), head(tail(tail(tail(h)))), head(tail(tail(tail(tail(h))))), gsha-word(s, p), gsha-word(s, add(p, 4)), gsha-word(s, add(p, 8)), gsha-word(s, add(p, 12)), gsha-word(s, add(p, 16)), gsha-word(s, add(p, 20)), gsha-word(s, add(p, 24)), gsha-word(s, add(p, 28)), gsha-word(s, add(p, 32)), gsha-word(s, add(p, 36)), gsha-word(s, add(p, 40)), gsha-word(s, add(p, 44)), gsha-word(s, add(p, 48)), gsha-word(s, add(p, 52)), gsha-word(s, add(p, 56)), gsha-word(s, add(p, 60))));
  def gsha-fold(h, r) = [add_u32(h[0], r[0]), add_u32(h[1], r[1]), add_u32(h[2], r[2]), add_u32(h[3], r[3]), add_u32(h[4], r[4])];
  def gsha-blocks(h, s, p, end) = p >= end ? h : gsha-blocks(gsha-block(h, s, p), s, add(p, 64), end);
  def gsha-init() = [1732584193, 4023233417, 2562383102, 271733878, 3285377520];
  def gsha-zeros(k) = k <= 0 ? "" : k == 1 ? byte_to_str(0) : str_concat(gsha-zeros(k / 2), gsha-zeros(k - (k / 2)));
  def gsha-u32-str(w) = str_concat(byte_to_str(band(shr_u32(w, 24), 255)), str_concat(byte_to_str(band(shr_u32(w, 16), 255)), str_concat(byte_to_str(band(shr_u32(w, 8), 255)), byte_to_str(band(w, 255)))));
  // the closing bytes: the partial block, 0x80, zeros to 56 mod 64, the bit length as 64-bit big-endian
  def gsha-tail(s, full, n) {
   let rest = n - full;
   let padn = (119 - rest) % 64;
   let bits = n * 8;
   str_concat(substring(s, full, n),str_concat(byte_to_str(128), str_concat(gsha-zeros(padn), str_concat(gsha-u32-str(bits / 4294967296), gsha-u32-str(bits % 4294967296)))));
  }
  def gsha-state(s) {
   let n = len(s);
   let full = n - (n % 64);
   let h1 = gsha-blocks(gsha-init(), s, 0, full);
   let tail = gsha-tail(s, full, n);
   gsha-blocks(h1, tail, 0, len(tail));
  }
  def gsha-raw(s) {
   let h = gsha-state(s);
   str_concat(gsha-u32-str(h[0]), str_concat(gsha-u32-str(h[1]), str_concat(gsha-u32-str(h[2]), str_concat(gsha-u32-str(h[3]), gsha-u32-str(h[4])))));
  }
  def gsha-nibble(n) = substring("0123456789abcdef", n, n + 1);
  def gsha-hex-at(raw, i) = i >= len(raw) ? "" : str_concat(gsha-nibble(shr_u32(str_byte_at(raw, i), 4)), str_concat(gsha-nibble(band(str_byte_at(raw, i), 15)), gsha-hex-at(raw, i + 1)));
  def gsha-hex-of-raw(raw) = gsha-hex-at(raw, 0);
  def gsha-hex(s) = gsha-hex-of-raw(gsha-raw(s));
  def gsha-hexval(c) = c >= 48 && c <= 57 ? c - 48 : c >= 97 && c <= 102 ? c - 87 : c >= 65 && c <= 70 ? c - 55 : 0 - 1;
  def gsha-hex?(h) = len(h) % 2 == 0 && gsha-hex-ok(h, 0);
  def gsha-hex-ok(h, i) = i >= len(h) ? true : gsha-hexval(str_byte_at(h, i)) >= 0 && gsha-hex-ok(h, i + 1);
  def gsha-raw-at(h, i) = i >= len(h) ? "" : str_concat(byte_to_str(gsha-hexval(str_byte_at(h, i)) * 16 + gsha-hexval(str_byte_at(h, i + 1))), gsha-raw-at(h, i + 2));
  def gsha-raw-of-hex(h) = gsha-hex?(h) ? gsha-raw-at(h, 0) : nothing();
  def gsha-object-hex(type, body) = gsha-hex(str_concat(type, str_concat(" ", str_concat(len(body).str(), str_concat(byte_to_str(0), body)))));
 }
 0;
}
