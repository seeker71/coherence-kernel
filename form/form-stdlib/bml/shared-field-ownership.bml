// Unique process identities expose first admission into the shared field.
// preludes: form-stdlib/core.fk form-stdlib/organ-health.bml
section [form.bml] {
 class SharedTailOwnership {
  def sht-check(name,ok,expected,observed) {
   let reading = oh-reading("shared-field",str_concat(int_to_str(host_pid()),str_concat(":",name)),name,json-node-int(expected),json-node-int(observed),json-node-int(ok),list(),list("continue","repair"),json-node-object(list(oh-s("scope","first admission of a local prefix followed by a shared tail"))));
   oh-voice(reading); let response = oh-response(reading,if ok then "continue" else "repair"); oh-voice(response);
   oh-voice(oh-applied(reading,oh-select(reading,response,"repair"),json-node-object(list(oh-s("action",if ok then "retain exact shared meaning" else "withhold shared-list completeness")))));
   if ok then 1 else form_error(str_concat("shared field ownership differs: ",name));
  }
  def sht-run() {
   let live = kernel_live(host_pid()); sht-check("shared-field-active",and(ge(len(live),24),eq(nth(live,22),2)),2,nth(live,22));
   let identity = str_concat("shared-tail-ownership-",int_to_str(host_pid()));
   let category = intern_trivial_string(identity);
   let tailNode = intern_node(category,list(intern_trivial_int(10),intern_trivial_int(20),intern_trivial_int(30)));
   let shared = node_children(tailNode);
   sht-check("source-tail-complete",eq(len(shared),3),3,len(shared));
   let mixed = cons(intern_trivial_int(host_pid()),shared);
   sht-check("local-prefix-and-shared-tail",eq(len(mixed),4),4,len(mixed));
   let joined = intern_node(category,mixed); let received = node_children(joined);
   sht-check("first-shared-admission-complete",eq(len(received),4),4,len(received));
   sht-check("shared-tail-identity-preserved",value_eq(tail(received),shared),1,if value_eq(tail(received),shared) then 1 else 0);
   1;
  }
 }
 0;
}
