// local-focus-lenses.bml — the planner's focus guide answered by parallel lenses of the local model, as a call a door can make.
//
// One prefix (the planner's own focus prompt, flp-focus-prompt), three lenses, one weight pass per step for all of them
// (q38-lenses.bml). Each lens text is cut at its closing bracket and read by the planner's own rules (a JSON array of catalog
// names); of the lenses that pass, the one the model was surest of (least surprise a token) is written at flp-focus-path(req), the
// file the planner reads back only when its prompt matches, its status is answered and the reply is valid. No lens that passes means
// no file: the planner asks as before. lfl-run asks a standing resident server (serve-client.bml) one request a lens; with none standing it opens
// the model, runs, closes the model and answers a status line, so a caller that opens the model again in the same process (the planner's voice) starts from nothing. Needs form-cli-local-plan.bml (flp-*),
// q38-lenses.bml and the qwen stack in its prelude closure.
// preludes: form-stdlib/core.fk form-stdlib/bml/q38-multi.bml form-stdlib/bml/form-cli-code-live.bml form-stdlib/bml/q38-lenses.bml form-stdlib/bml/serve-client.bml native/metal/qwen35-dense-token-handle.fk native/metal/qwen35-dense-spec.fk
section [form.bml] {
 class LocalFocusLenses {
  // The planner's focus prompt states the request's `needs`; the request's `problem` is where its subject is often named (organ_steady
  // stood only in the problem of frq-77b2…). Each lens's task carries the problem's opening after the shared prefix, so the prefix (and
  // the prompt the focus file must equal) is unchanged. A lens may abstain with "[]" when no catalog function is the one the task
  // changes (frq-77b2…'s subject is outside its catalog): an abstaining winner writes no focus and the planner asks as before; forcing
  // a catalog name made its plan, which changed the right definition elsewhere, refuse for changing what the request did not name.
  def lfl-background(req) {
   let problem = flp-text(req, "problem");
   len(problem) == 0 ? "" : "\nBackground: " ++ (len(problem) > 900 ? substring(problem, 0, 900) : problem) ++ "\n";
  }
  def lfl-abstain-note() = " If none of the catalog functions is the one the task changes, answer [].";
  def lfl-tasks(req) = map(t => lfl-background(req) ++ "\n" ++ t ++ lfl-abstain-note() ++ " Answer with only a JSON array of names.", ["Choose only the single most central function.", "Choose the smallest set of functions whose behavior must change.", "Choose every function whose behavior the task changes."]);
  // the reply up to and including its first closing bracket, after the opening the lens already gave
  def lfl-cut-at(text, i) = i >= len(text) ? "" : str_byte_at(text, i) == 93 ? substring(text, 0, i + 1) : lfl-cut-at(text, i + 1);
  def lfl-candidate(text) {
   let cut = lfl-cut-at(text, 0);
   len(cut) == 0 ? "" : "[" ++ cut;
  }
  // the planner's own rules for a focus reply: a JSON array of names, each in the catalog
  def lfl-valid(text, names) {
   let ok = len(text) > 0 && faj-valid(text);
   let value = ok ? parse-json("focus-candidate", text) : json-node-null();
   let selected = fcgp-array?(value) ? flp-strings(value) : [];
   (String) text == "[]" || (!nil?(selected) && len(selected) == len(json-array-elements(value)) && !any?(name => !flp-has?(names, name), selected));
  }
  def lfl-best(rows, i, best) = i >= len(rows) ? best : lfl-best(rows, i + 1, (rows[i][0] && (best < 0 || rows[i][1] < rows[best][1])) ? i : best);
  def lfl-keep(req, prompt, text, promptIds, generated, lens) {
   let made = flp-mkdirs(flp-dir() ++ "/focus");
   let kept = write_file_text(flp-focus-path(req), json-emit(json-node-object([fhn-s("prompt", prompt), fhn-s("model", "qwen3.8-27b-lenses"), fhn-s("status", "answered"), fhn-s("text", text), fhn-n("prompt_ids", promptIds), fhn-n("generated_ids", generated), fhn-n("complete", 1), fhn-n("released", 1), fhn-s("reason", ""), fhn-s("raw", ""), fhn-n("lens", lens)])));
   kept;
  }
  // answers a status line: kept (names the lens and the text) or nothing kept (why)
  // A resident server that stands (observe/qwen-serve-run.bml) holds the GPU lease and the weights: the lenses are asked of it, one request each (who "focus"), and decode beside
  // every other sequence it serves. With none standing, or when it does not answer, this process opens a session of its own, as it always did.
  def lfl-run(req, gen) {
   let prompt = flp-focus-prompt(req);
   let names = flp-source-names(flp-req-files(req));
   let st = svc-standing(svc-default-dir());
   (String) st[0] == "standing" ? lfl-run-served(req, gen, prompt, names) : lfl-run-own(req, gen, prompt, names);
  }
  def lfl-run-own(req, gen, prompt, names) {
   let ctx = qlz-open(4096);
   let r = qlz-run-ids(ctx, qlz-chat-prefix(ctx, prompt), map(t => qlz-chat-lens(ctx, t, "["), lfl-tasks(req)), gen);
   let closed = qlz-close(ctx);
   let shape = "prefix " ++ len(r[2]).str() ++ " ids; prefill " ++ r[3][0].str() ++ " ms, fork " ++ r[3][1].str() ++ " ms, " ++ gen.str() ++ " tokens x " ++ len(r[0]).str() ++ " lenses " ++ r[3][2].str() ++ " ms";
   lfl-conclude(req, gen, prompt, names, map(t => lfl-candidate(t), r[0]), r[1], len(r[2]), shape, r[0]);
  }
  // the server's reply is the lens's own text from the start of the assistant's turn (the stop string "]" may or may not stand in it): an array begins "["; closed here when the stop trimmed it
  def lfl-served-candidate(text) {
   let cut = lfl-cut-at(text, 0);
   len(text) == 0 || str_byte_at(text, 0) != 91 ? "" : len(cut) > 0 ? cut : text ++ "]";
  }
  def lfl-run-served(req, gen, prompt, names) {
   let dir = svc-default-dir();
   let tasks = lfl-tasks(req);
   let ids = map(i => svc-submit(dir, "f" ++ i.str(), svc-spec-json(prompt, tasks[i], 1, gen, ["]"], 0, "focus")), range(0, len(tasks)));
   let got = map(id => len(id) == 0 ? ["unserved", "the spool refused the request file"] : svc-wait(dir, id, 0), ids);
   let down = filter(g => (String) g[0] != "answered", got);
   nil?(down) ? lfl-served-conclude(req, gen, prompt, names, map(g => g[1], got)) : lfl-run-own(req, gen, prompt, names);
  }
  def lfl-served-conclude(req, gen, prompt, names, docs) {
   let texts = map(d => svc-str(d, "text"), docs);
   let shape = "served by the resident server: prompt " ++ svc-int(docs[0], "prompt_ids").str() ++ " ids a lens; queue " ++ svc-int(docs[0], "queue_ms").str() ++ " ms, prefill " ++ svc-int(docs[0], "prefill_ms").str() ++ " ms, decode " ++ svc-int(docs[0], "decode_ms").str() ++ " ms on lens 0, " ++ len(docs).str() ++ " lenses, rent_tokens 0";
   lfl-conclude(req, gen, prompt, names, map(t => lfl-served-candidate(t), texts), map(d => svc-int(d, "surprise_micro_nats"), docs), svc-int(docs[0], "prompt_ids"), shape, texts);
  }
  def lfl-conclude(req, gen, prompt, names, cands, surprises, promptIds, shape0, replies) {
   let rows = map(i => [lfl-valid(cands[i], names), surprises[i]], range(0, len(cands)));
   let best = lfl-best(rows, 0, 0 - 1);
   let shape = shape0 ++ "; valid " ++ map(x => x[0], rows).str() ++ " surprise " ++ map(x => x[1], rows).str();
   if (best < 0) then "no lens gave a valid focus (" ++ shape ++ "; replies " ++ replies.str() ++ ")" else if ((String) cands[best] == "[]") then "the surest lens abstained: no catalog function is the one the task changes, nothing kept, the planner asks as before (" ++ shape ++ ")" else {
    let kept = lfl-keep(req, prompt, cands[best], promptIds, gen * len(cands), best);
    "kept lens " ++ best.str() ++ ": " ++ cands[best] ++ " (" ++ shape ++ ")";
   };
  }
 }
 0;
}
