// Token transport is private; diagnostic events carry counts and route identity.
// preludes: form-stdlib/form-cli-model-session.fk form-stdlib/qwen-lora-head.fk form-stdlib/json.fk form-stdlib/spool-bell-transport.fk form-stdlib/organ-health.bml
section [form.bml] {
    class FormCliHealFlow {
        def fhf-pair(key, value) = json-node-pair(key, json-node-string(value));
        def fhf-number(key, value) = json-node-pair(key, json-node-int(value));
        def fhf-event(phase, model, path, artifact, inputs, outputs, position) {
            let row = json-node-object([fhf-pair("phase", phase), fhf-pair("route", "native-fkwu-metal"), fhf-pair("model", model), fhf-pair("model_path", path), fhf-pair("base_seal_sha256", qaf-seal-fields(path)[1]), fhf-pair("adapter_path", artifact), fhf-pair("adapter_sha256", if ((String) artifact == "") then "" else qaf-string-hex(saj-file-digest(artifact, file_size(artifact)))), fhf-pair("adapter_state", if ((String) artifact == "") then "base-only" else "admitted-output-head-rank1"), fhf-number("input_tokens", inputs), fhf-number("output_tokens", outputs), fhf-number("position", position), fhf-number("stamp_ms", now_unix_ms())]);
            print_str(str_concat("form-heal flow ", str_concat(json-emit(row), "\n")));
        }
        def fhf-next(ctx, sts, adapter, token, position) = if nil?(adapter) then q38-forward(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], token, position) else q38-forward-adapted(ctx[0], ctx[1], ctx[2], ctx[3], sts, ctx[4], ctx[5], ctx[6], adapter, token, position);
        // A quantum is one emitted prediction and at most one forward. The
        // pending prediction enters KV exactly once. No 512-token truncation.
        def fhf-walk(ctx, sts, src, adapter, artifact, model, path, partial, token, position, inputs, outputs, stops, maxpos) =
            if (token < 0) then fhf-pressure("prediction",partial,json-node-string("nonnegative token"),json-node-int(token),"native-numeric-diagnostics","forward-refused",outputs)
            else if q38-stop?(token, stops) then ["eos", outputs]
            else if (position >= maxpos) then fhf-pressure("context",partial,json-node-int(maxpos),json-node-int(position),"context-capacity","context-capacity",outputs)
            else fhf-emit(ctx, sts, src, adapter, artifact, model, path, partial, token, position, inputs, outputs, stops, maxpos);
        def fhf-emit(ctx, sts, src, adapter, artifact, model, path, partial, token, position, inputs, outputs, stops, maxpos) {
            let chunk = tkz-decode-text(src, [token]);
            let wrote = sbt-append-count(partial, chunk);
            let count = if ((Comparable) wrote == str_len(chunk)) then (outputs + 1) else outputs;
            let observed = fhf-event("decode", model, path, artifact, inputs, count, position);
            if ((Comparable) wrote != str_len(chunk)) then fhf-pressure("output",partial,json-node-int(str_len(chunk)),json-node-int(wrote),"writable-output","stream-write-refused",outputs) else fhf-walk(ctx, sts, src, adapter, artifact, model, path, partial, fhf-next(ctx, sts, adapter, token, position), (position + 1), inputs, count, stops, maxpos);
        }
        def fhf-run(ctx, sts, src, adapter, artifact, model, path, output, token, position, inputs, maxpos) {
            let partial = str_concat(output, ".partial");
            let initialized = write_file(partial, "");
            let admitted = fhf-event("admitted", model, path, artifact, inputs, 0, position);
            let result = if (initialized < 0) then fhf-pressure("output",partial,json-node-int(0),json-node-int(initialized),"writable-output","stream-write-refused",0) else fhf-walk(ctx, sts, src, adapter, artifact, model, path, partial, token, position, inputs, 0, fcmg-q35-stops(src), maxpos);
            let final = fhf-event(head(result), model, path, artifact, inputs, result[1], (position + result[1]));
            let health = if ((String) head(result) == "eos") then oh-voice(oh-reading("native-generation",partial,"completion",json-node-string("eos"),json-node-string("eos"),json-node-int(1),[],["defer"],oh-reference(partial))) else 0;
            result;
        }
        def fhf-pressure(aspect,flow,expected,observed,resource,reason,outputs) {
            let signal = oh-voice(oh-reading("native-generation",flow,aspect,expected,observed,json-node-int(0),[oh-need(resource,observed)],["request-evidence","defer"],oh-reference(flow)));
            [reason,outputs];
        }
    }
    0;
}
