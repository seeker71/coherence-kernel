// Read the same native publishers as Glass without becoming a publisher.
// No model admission, microphone action, owner poke, or second renderer loop.
// preludes: form/form-stdlib/form-glass-live.bml
section [form.bml] {
    class GlassViewAudit {
        def fgva-views() = list("help", "atlas", "raster", "overview", "memory", "flow", "recipes", "meaning", "kernel", "events", "channels", "choice");
        def fgva-snapshot() = fgl-inspection-snapshot();
        def fgva-frame(data, view, width, height) = fgd-live-segment-frame(width, height, nth(data, 0), 20, 0, view, "all", "all", "none", 0, nth(data, 1), nth(data, 2), list(), "read-only", nth(data, 4), nth(data, 3), "native audit; typed kernel rows belong to this probe");
        def fgva-view(data, view) {
            let metrics = fglui-navigation-metrics(nth(data, 1), view, "all");
            let observations = fglui-navigation-observations(nth(data, 3), view);
            let narrow = fgva-frame(data, view, 80, 24);
            let wide = fgva-frame(data, view, 160, 40);
            print(list("view", view, "metrics", len(metrics), "metric-gaps", len(fglui-missing-metrics(metrics)), "typed-gaps", len(fglui-seam-observations(observations)), "navigation", len(fglui-navigation-keys(nth(data, 1), nth(data, 2), nth(data, 3), view, "all")), "frame-rows", len(fgd-segment-frame-lines(narrow)), len(fgd-segment-frame-lines(wide))));
        }
        def fgva-each(data, views) = if eq(len(views), 0) then 0 else fgva-each-step(data, views);
        def fgva-each-step(data, views) {
            let shown = fgva-view(data, head(views));
            add(1, fgva-each(data, tail(views)));
        }
        def fgva-missing(rows) = if eq(len(rows), 0) then 0 else fgva-missing-step(rows);
        def fgva-missing-step(rows) {
            let row = head(rows);
            let shown = if eq(fgo-present?(row), 0) then print(list("missing", fgo-domain(row), fgo-id(row), "door", fgo-source(row))) else if str_eq(fgo-evidence(row), "silent") then print(list("silent", fgo-domain(row), fgo-id(row), "age-ms", fgo-age(row), "door", fgo-source(row))) else 0;
            fgva-missing(tail(rows));
        }
        def fgva-run() {
            let data = fgva-snapshot();
            let started = print(list("glass-view-audit-v1", "epoch", nth(data, 0), "scope", "published-frames+probe-typed-kernel", "samples", len(nth(data, 2))));
            let views = fgva-each(data, fgva-views());
            let gaps = fgva-missing(nth(data, 1));
            print(list("audit-complete", views, "expected", len(fgva-views())));
        }
    }
    0;
}
