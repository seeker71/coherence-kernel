//////////////////////////////////////////////////////////////////////
// form-cli-grounded-synthesis.bml — the body grounds first, then the
// cheapest voice that answers.
//
// Grounding is native: one in-process enrich reading of the enquiry's exact
// terms and an index of receipts whose names carry those terms, ranked by
// terms matched and then by date, newest first, each with its opening bytes.
// The packet then goes, in this order, to:
//   1. the registry's answer model through the in-process fkwu model session;
//      complete generation and observed release are required;
//   2. one provider turn through the native process organ, no tools, in the
//      job's owned empty directory with its own config home and session
//      identity — only when explicitly allowed and local generation did not answer.
//      A first answer under fgs-min-answer-bytes opens one additional turn
//      carrying that length observation; both answers and costs are retained.
//      Length alone establishes neither the cause nor the answer's quality.
// The report carries the provider's own usage over all attempts, the oracle's
// token counts, and the answer's path. Answer quality stays with the reader.
// Every quantity that was not observed stays 0 with its source named "none";
// nothing is inferred.
//
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/bml/form-cli-enrich.bml form-stdlib/bml/form-cli-native-voice.bml
//////////////////////////////////////////////////////////////////////

section [form.bml] {
 class FormCliGroundedSynthesis {
  def fgs-opening-bytes() = 400;
  def fgs-uuid-source() = "/proc/sys/kernel/random/uuid";
  def fgs-min(a, b) = a < b ? a : b;
  def fgs-clean(parts) = nil?(parts) ? list() : (String) trim(head(parts)) == "" ? fgs-clean(tail(parts)) : cons(trim(head(parts)), fgs-clean(tail(parts)));
  def fgs-hits(name, terms) = nil?(terms) ? 0 : ((str_find(name, head(terms), 0) < 0 ? 0 : 1) + fgs-hits(name, tail(terms)));
  def fgs-md?(name) = (str_len(name) > 3) && ((String) substring(name, str_len(name) - 3, str_len(name)) == ".md");
  def fgs-path(name) = str_find(name, "/", 0) < 0 ? ("receipts/" ++ name) : name;
  def fgs-date(path) = str_len(path) < 19 ? 0 : ((str_to_int(substring(path, 9, 13)) * 10000) + ((str_to_int(substring(path, 14, 16)) * 100) + str_to_int(substring(path, 17, 19))));
  def fgs-row(name, terms) = list((fgs-hits(name, terms) * 100000000) + fgs-date(fgs-path(name)), fgs-path(name), fgs-hits(name, terms));
  def fgs-rank(names, terms) = nil?(names) ? list() : fgs-md?(head(names)) && (fgs-hits(head(names), terms) > 0) ? cons(fgs-row(head(names), terms), fgs-rank(tail(names), terms)) : fgs-rank(tail(names), terms);
  def fgs-best(rows, best) = nil?(rows) ? best : fgs-best(tail(rows), nil?(best) || (head(rows)[0] > best[0]) ? head(rows) : best);
  def fgs-without(rows, row) = nil?(rows) ? list() : (String) head(rows)[1] == row[1] ? tail(rows) : cons(head(rows), fgs-without(tail(rows), row));
  def fgs-top(rows, limit) = nil?(rows) || ((Comparable) limit == 0) ? list() : fgs-take(rows, limit, fgs-best(rows, list()));
  def fgs-take(rows, limit, best) = cons(best, fgs-top(fgs-without(rows, best), limit - 1));
  def fgs-opening(path, opening) {
   let text = read_file(path);
   substring(text, 0, fgs-min(str_len(text), opening));
  }
  // Each receipt carries a key beside its path. A path is sixty characters of
  // date and title; a voice that cannot reproduce it cites nothing at all, and
  // the body reads that as an answer with no evidence. A key is four characters,
  // and the door resolves it back to the path it stands for — so the citation is
  // the body's own mapping rather than the voice's memory of a filename.
  def fgs-index(rows, opening) = fgs-index-at(rows, opening, 1);
  def fgs-index-at(rows, opening, k) = nil?(rows) ? "" : ("--- [R" ++ int_to_str(k) ++ "] " ++ head(rows)[1] ++ " (terms matched: " ++ int_to_str(head(rows)[2]) ++ ")\n" ++ fgs-opening(head(rows)[1], opening) ++ "\n" ++ fgs-index-at(tail(rows), opening, k + 1));
  def fgs-packet(enquiry, enrichment, index) = enquiry ++ "\n\n[Native Form grounding: one in-process enrich reading of the enquiry's exact terms. Use the observed definitions and relations.]\n" ++ enrichment ++ "\n[Receipts in this body whose names carry the terms, with their opening bytes. Cite by path only what these openings support; name what would need the full receipt.]\n" ++ index ++ "\nThis turn has no tools and no file access; everything usable is in this message. Answer the enquiry itself, point by point, from the material above, citing a receipt by its path wherever its opening supports the point. After the answer, say plainly what the material does not establish.\n";
  def fgs-min-answer-bytes() = 1200;
  def fgs-repair-packet(packet, thin) = packet ++ "\n[The previous attempt returned " ++ int_to_str(str_len(thin)) ++ " bytes, below this door's length threshold. That observation establishes neither why it was short nor its quality. Use the supplied material to complete the enquiry; this turn has no tools or file access.]\n";
  def fgs-names(rows) = rows |> map(row => json-node-string(row[1]));
  def fgs-usage(doc, key) = json-object-has?(doc, key) ? json-int-value(json-object-get(doc, key)) : 0;
  def fgs-text(doc, key) = json-object-has?(doc, key) ? json-string-value(json-object-get(doc, key)) : "";
  def fgs-flag(doc, key, fallback) = json-object-has?(doc, key) ? ((Comparable) json-int-value(json-object-get(doc, key)) == 1) : fallback;
  def fgs-uuid() {
   let text = fs_exists(fgs-uuid-source()) ? trim(read_file(fgs-uuid-source())) : "";
   (Comparable) str_len(text) == 36 ? text : nothing();
  }
  def fgs-argv(home, uuid, effort) = append(list("env", "-u", "CLAUDECODE", "-u", "CLAUDE_CODE_CHILD_SESSION", "-u", "CLAUDE_CODE_SESSION_ID", "CLAUDE_CONFIG_DIR=" ++ home, "claude", "-p"), append(nothing?(uuid) ? list() : list("--session-id", uuid), append((String) effort == "" ? list() : list("--effort", effort), list("--output-format", "json", "--max-turns", "1", "--tools", ""))));

  def fgs-join(parts, sep) = nil?(parts) ? "" : nil?(tail(parts)) ? head(parts) : (head(parts) ++ sep ++ fgs-join(tail(parts), sep));
  def fgs-provider-allowed(request) = json-object-has?(request,"provider") ? fgs-flag(json-object-get(request,"provider"),"allowed",false) : false;
  // A second turn is a second rent. The body observes a thin answer either way and
  // says so; spending again on it is the caller's word, never the door's habit.
  def fgs-repair-allowed(request) = json-object-has?(request,"provider") ? fgs-flag(json-object-get(request,"provider"),"repair",false) : false;

  // provider result = status doc; doc is the provider's own result JSON or an empty object
  def fgs-ask-provider(job, stage, seconds, packetPath, effort) {
   let emptyDir = fs_mkdir(fhn-at(job, "empty"));
   let home = fhn-at(job, "claude-home");
   let homeDir = fs_mkdir(home);
   let status = fhn-run(job, stage, seconds, "empty", packetPath, fgs-argv(home, fgs-uuid(), effort));
   let raw = fhn-read(fhn-stage-path(job, stage, ".out"));
   list(status, ((String) status == "0") && (str_len(raw) > 0) ? parse-json("provider-result", raw) : json-node-object(list()));
  }
  def fgs-not-asked() = list("not-asked", json-node-object(list()));
  def fgs-doc-usage(doc) = json-object-has?(doc, "usage") ? json-object-get(doc, "usage") : json-node-object(list());
  def fgs-usage2(doc1, doc2, key) = fgs-usage(fgs-doc-usage(doc1), key) + fgs-usage(fgs-doc-usage(doc2), key);
  def fgs-details(doc) = json-object-has?(fgs-doc-usage(doc), "output_tokens_details") ? json-object-get(fgs-doc-usage(doc), "output_tokens_details") : json-node-object(list());

  // The one public door. request: enquiry, terms, seconds, receipts, oracle (1/0), provider {allowed}.
  def fgs-answer(request) {
   let enquiry = fgs-text(request, "enquiry");
   let terms = fgs-text(request, "terms");
   let seconds = json-object-has?(request, "seconds") ? fhn-number(request, "seconds") : 600;
   let limit = json-object-has?(request, "receipts") ? fhn-number(request, "receipts") : 8;
   let askOracle = fgs-flag(request, "oracle", true);
   let allowProvider = fgs-provider-allowed(request);
   let allowRepair = fgs-repair-allowed(request);
   let effort = fgs-text(request, "effort");
   let opening = json-object-has?(request, "opening_bytes") ? fhn-number(request, "opening_bytes") : fgs-opening-bytes();
   ((String) trim(enquiry) == "") || ((String) trim(terms) == "") ? form_error("grounded synthesis needs enquiry and terms") : fgs-start(enquiry, terms, seconds, limit, askOracle, allowProvider, allowRepair, effort, opening, request);
  }
  def fgs-start(enquiry, terms, seconds, limit, askOracle, allowProvider, allowRepair, effort, opening, request) {
   let started = now_unix_ms();
   let root = fhn-root();
   let spool = fhn-at(root, ".form-heal");
   let made = fs_mkdir(spool);
   let job = fhn-unique(spool, "grounded-");
   nothing?(job) ? form_error("grounded synthesis evidence directory unavailable") : 0;
   let saved = fhn-write-json(fhn-at(job, "snapshot.json"), json-node-object(list(fhn-s("root", root))));
   let enrichment = fce-command(terms);
   let rows = fgs-top(fgs-rank(fs_list(fhn-at(root, "receipts")), fgs-clean(split-on(terms, " "))), limit);
   let packet = fgs-packet(enquiry, enrichment, fgs-index(rows, opening));
   let packetPath = fhn-at(job, "packet.txt");
   let wrote = write_file_text(packetPath, packet);
   let grounded = now_unix_ms();
   let oracle = askOracle ? fcnv-ask(packet,request) : fcnv-not-asked();
   let nativeEvidence = askOracle ? fcnv-retain(job,oracle) : 0;
   let oracleDone = now_unix_ms();
   let oracleAnswered = (String) oracle[0] == "answered";
   let askProvider = allowProvider && (!oracleAnswered);
   let first = askProvider ? fgs-ask-provider(job, "synthesis", seconds, packetPath, effort) : fgs-not-asked();
   let firstAnswer = fgs-text(first[1], "result");
   let thin = askProvider && (str_len(trim(firstAnswer)) < fgs-min-answer-bytes());
   let repairing = thin && allowRepair;
   let keptFirst = repairing ? write_file_text(fhn-at(job, "answer-1.md"), firstAnswer) : 0;
   let repairPath = fhn-at(job, "packet-repair.txt");
   let wroteRepair = repairing ? write_file_text(repairPath, fgs-repair-packet(packet, firstAnswer)) : 0;
   let second = repairing ? fgs-ask-provider(job, "synthesis-repair", seconds, repairPath, effort) : fgs-not-asked();
   let ended = now_unix_ms();
   let doc1 = first[1];
   let doc2 = second[1];
   let secondAnswer = fgs-text(doc2, "result");
   let providerAnswer = repairing && (str_len(trim(secondAnswer)) > 0) ? secondAnswer : firstAnswer;
   let doc = repairing && (str_len(trim(secondAnswer)) > 0) ? doc2 : doc1;
   let source = oracleAnswered ? "fkwu-model-session" : (String) trim(providerAnswer) == "" ? "none" : "provider";
   let answer = oracleAnswered ? oracle[1] : providerAnswer;
   let answerPath = fhn-at(job, "answer.md");
   let kept = write_file_text(answerPath, answer);
   let input = fgs-usage2(doc1, doc2, "input_tokens");
   let cacheWrite = fgs-usage2(doc1, doc2, "cache_creation_input_tokens");
   let cacheRead = fgs-usage2(doc1, doc2, "cache_read_input_tokens");
   let output = fgs-usage2(doc1, doc2, "output_tokens");
   json-node-object(list(
    fhn-s("source", source),
    fhn-s("status", thin ? second[0] : first[0]),
    fhn-n("provider_attempts", repairing ? 2 : askProvider ? 1 : 0),
    fhn-n("answer_thin", thin ? 1 : 0),
    fhn-n("repair_allowed", allowRepair ? 1 : 0),
    fhn-s("effort", effort),
    fhn-n("opening_bytes", opening),
    fhn-n("thinking_tokens", fgs-usage(fgs-details(doc1), "thinking_tokens") + fgs-usage(fgs-details(doc2), "thinking_tokens")),
    fhn-s("evidence", job),
    fhn-s("packet", packetPath),
    fhn-s("answer", answerPath),
    fhn-s("oracle", oracle[0]),
    json-node-pair("native_generation",fcnv-metadata(oracle)),
    fhn-n("oracle_ms", oracleDone - grounded),
    fhn-n("oracle_tokens_evaluated", oracle[2]),
    fhn-n("oracle_tokens_predicted", oracle[3]),
    fhn-s("oracle_model", oracle[4]),
    fhn-s("provider_session", fgs-text(doc, "session_id")),
    fhn-a("receipts", fgs-names(rows)),
    fhn-n("enrichment_bytes", str_len(enrichment)),
    fhn-n("packet_bytes", str_len(packet)),
    fhn-n("answer_bytes", str_len(answer)),
    fhn-n("grounding_ms", grounded - started),
    fhn-n("provider_ms", ended - oracleDone),
    fhn-n("provider_turns", fgs-usage(doc1, "num_turns") + fgs-usage(doc2, "num_turns")),
    fhn-n("input_tokens", input),
    fhn-n("cache_write_input_tokens", cacheWrite),
    fhn-n("cache_read_input_tokens", cacheRead),
    fhn-n("output_tokens", output),
    fhn-n("rent_tokens", (input + cacheWrite) + (cacheRead + output))));
  }
 }
}
