//////////////////////////////////////////////////////////////////////
// form-cli-grounded-synthesis.bml — the body grounds first, then the
// cheapest voice that answers.
//
// Grounding is native: one in-process enrich reading of the enquiry's exact
// terms and an index of receipts whose names carry those terms, ranked by
// terms matched and then by date, newest first, each with its opening bytes.
// The packet then goes, in this order, to:
//   1. the registry's answer model through the in-process fkwu model session;
//      complete generation and observed release are required;
//   2. one provider turn through the native process organ, no tools, in the
//      job's owned empty directory with its own config home and session
//      identity — only when explicitly allowed and local generation did not answer.
//      A first answer under fgs-min-answer-bytes opens one additional turn
//      carrying that length observation; both answers and costs are retained.
//      Length alone establishes neither the cause nor the answer's quality.
// The report carries the provider's own usage over all attempts, the oracle's
// token counts, and the answer's path. Answer quality stays with the reader.
// Every quantity that was not observed stays 0 with its source named "none";
// nothing is inferred.
//
// preludes: form-stdlib/bml/form-cli-heal-native-report.bml form-stdlib/bml/form-cli-enrich.bml form-stdlib/bml/form-cli-native-voice.bml
//////////////////////////////////////////////////////////////////////

section [form.bml] {
 class FormCliGroundedSynthesis {
  def fgs-opening-bytes() = 400;
  def fgs-uuid-source() = "/proc/sys/kernel/random/uuid";
  def fgs-min(a, b) = if lt(a, b) then a else b;
  def fgs-clean(parts) = if nil?(parts) then list() else if str_eq(trim(head(parts)), "") then fgs-clean(tail(parts)) else cons(trim(head(parts)), fgs-clean(tail(parts)));
  def fgs-hits(name, terms) = if nil?(terms) then 0 else add(if lt(str_find(name, head(terms), 0), 0) then 0 else 1, fgs-hits(name, tail(terms)));
  def fgs-md?(name) = and(gt(str_len(name), 3), str_eq(substring(name, sub(str_len(name), 3), str_len(name)), ".md"));
  def fgs-path(name) = if lt(str_find(name, "/", 0), 0) then mc-cat(list("receipts/", name)) else name;
  def fgs-date(path) = if lt(str_len(path), 19) then 0 else add(mul(str_to_int(substring(path, 9, 13)), 10000), add(mul(str_to_int(substring(path, 14, 16)), 100), str_to_int(substring(path, 17, 19))));
  def fgs-row(name, terms) = list(add(mul(fgs-hits(name, terms), 100000000), fgs-date(fgs-path(name))), fgs-path(name), fgs-hits(name, terms));
  def fgs-rank(names, terms) = if nil?(names) then list() else if and(fgs-md?(head(names)), gt(fgs-hits(head(names), terms), 0)) then cons(fgs-row(head(names), terms), fgs-rank(tail(names), terms)) else fgs-rank(tail(names), terms);
  def fgs-best(rows, best) = if nil?(rows) then best else fgs-best(tail(rows), if or(nil?(best), gt(nth(head(rows), 0), nth(best, 0))) then head(rows) else best);
  def fgs-without(rows, row) = if nil?(rows) then list() else if str_eq(nth(head(rows), 1), nth(row, 1)) then tail(rows) else cons(head(rows), fgs-without(tail(rows), row));
  def fgs-top(rows, limit) = if or(nil?(rows), eq(limit, 0)) then list() else fgs-take(rows, limit, fgs-best(rows, list()));
  def fgs-take(rows, limit, best) = cons(best, fgs-top(fgs-without(rows, best), sub(limit, 1)));
  def fgs-opening(path, opening) {
   let text = read_file(path);
   substring(text, 0, fgs-min(str_len(text), opening));
  }
  def fgs-index(rows, opening) = if nil?(rows) then "" else mc-cat(list("--- ", nth(head(rows), 1), " (terms matched: ", int_to_str(nth(head(rows), 2)), ")\n", fgs-opening(nth(head(rows), 1), opening), "\n", fgs-index(tail(rows), opening)));
  def fgs-packet(enquiry, enrichment, index) = mc-cat(list(enquiry, "\n\n[Native Form grounding: one in-process enrich reading of the enquiry's exact terms. Use the observed definitions and relations.]\n", enrichment, "\n[Receipts in this body whose names carry the terms, with their opening bytes. Cite by path only what these openings support; name what would need the full receipt.]\n", index, "\nThis turn has no tools and no file access; everything usable is in this message. Answer the enquiry itself, point by point, from the material above, citing a receipt by its path wherever its opening supports the point. After the answer, say plainly what the material does not establish.\n"));
  def fgs-min-answer-bytes() = 1200;
  def fgs-repair-packet(packet, thin) = mc-cat(list(packet, "\n[The previous attempt returned ", int_to_str(str_len(thin)), " bytes, below this door's length threshold. That observation establishes neither why it was short nor its quality. Use the supplied material to complete the enquiry; this turn has no tools or file access.]\n"));
  def fgs-names(rows) = if nil?(rows) then list() else cons(json-node-string(nth(head(rows), 1)), fgs-names(tail(rows)));
  def fgs-usage(doc, key) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else 0;
  def fgs-text(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def fgs-flag(doc, key, fallback) = if json-object-has?(doc, key) then eq(json-int-value(json-object-get(doc, key)), 1) else fallback;
  def fgs-uuid() {
   let text = if fs_exists(fgs-uuid-source()) then trim(read_file(fgs-uuid-source())) else "";
   if eq(str_len(text), 36) then text else "";
  }
  def fgs-argv(home, uuid, effort) = append(list("env", "-u", "CLAUDECODE", "-u", "CLAUDE_CODE_CHILD_SESSION", "-u", "CLAUDE_CODE_SESSION_ID", mc-cat(list("CLAUDE_CONFIG_DIR=", home)), "claude", "-p"), append(if str_eq(uuid, "") then list() else list("--session-id", uuid), append(if str_eq(effort, "") then list() else list("--effort", effort), list("--output-format", "json", "--max-turns", "1", "--tools", ""))));

  def fgs-join(parts, sep) = if nil?(parts) then "" else if nil?(tail(parts)) then head(parts) else mc-cat(list(head(parts), sep, fgs-join(tail(parts), sep)));
  def fgs-provider-allowed(request) = if json-object-has?(request,"provider") then fgs-flag(json-object-get(request,"provider"),"allowed",false) else false;
  // A second turn is a second rent. The body observes a thin answer either way and
  // says so; spending again on it is the caller's word, never the door's habit.
  def fgs-repair-allowed(request) = if json-object-has?(request,"provider") then fgs-flag(json-object-get(request,"provider"),"repair",false) else false;

  // provider result = status doc; doc is the provider's own result JSON or an empty object
  def fgs-ask-provider(job, stage, seconds, packetPath, effort) {
   let emptyDir = fs_mkdir(fhn-at(job, "empty"));
   let home = fhn-at(job, "claude-home");
   let homeDir = fs_mkdir(home);
   let status = fhn-run(job, stage, seconds, "empty", packetPath, fgs-argv(home, fgs-uuid(), effort));
   let raw = fhn-read(fhn-stage-path(job, stage, ".out"));
   list(status, if and(str_eq(status, "0"), gt(str_len(raw), 0)) then parse-json("provider-result", raw) else json-node-object(list()));
  }
  def fgs-not-asked() = list("not-asked", json-node-object(list()));
  def fgs-doc-usage(doc) = if json-object-has?(doc, "usage") then json-object-get(doc, "usage") else json-node-object(list());
  def fgs-usage2(doc1, doc2, key) = add(fgs-usage(fgs-doc-usage(doc1), key), fgs-usage(fgs-doc-usage(doc2), key));
  def fgs-details(doc) = if json-object-has?(fgs-doc-usage(doc), "output_tokens_details") then json-object-get(fgs-doc-usage(doc), "output_tokens_details") else json-node-object(list());

  // The one public door. request: enquiry, terms, seconds, receipts, oracle (1/0), provider {allowed}.
  def fgs-answer(request) {
   let enquiry = fgs-text(request, "enquiry");
   let terms = fgs-text(request, "terms");
   let seconds = if json-object-has?(request, "seconds") then fhn-number(request, "seconds") else 600;
   let limit = if json-object-has?(request, "receipts") then fhn-number(request, "receipts") else 8;
   let askOracle = fgs-flag(request, "oracle", true);
   let allowProvider = fgs-provider-allowed(request);
   let allowRepair = fgs-repair-allowed(request);
   let effort = fgs-text(request, "effort");
   let opening = if json-object-has?(request, "opening_bytes") then fhn-number(request, "opening_bytes") else fgs-opening-bytes();
   if or(str_eq(trim(enquiry), ""), str_eq(trim(terms), "")) then form_error("grounded synthesis needs enquiry and terms") else fgs-start(enquiry, terms, seconds, limit, askOracle, allowProvider, allowRepair, effort, opening, request);
  }
  def fgs-start(enquiry, terms, seconds, limit, askOracle, allowProvider, allowRepair, effort, opening, request) {
   let started = now_unix_ms();
   let root = fhn-root();
   let spool = fhn-at(root, ".form-heal");
   let made = fs_mkdir(spool);
   let job = fhn-unique(spool, "grounded-", 0);
   let saved = fhn-write-json(fhn-at(job, "snapshot.json"), json-node-object(list(fhn-s("root", root))));
   let enrichment = fce-command(terms);
   let rows = fgs-top(fgs-rank(fs_list(fhn-at(root, "receipts")), fgs-clean(split-on(terms, " "))), limit);
   let packet = fgs-packet(enquiry, enrichment, fgs-index(rows, opening));
   let packetPath = fhn-at(job, "packet.txt");
   let wrote = write_file_text(packetPath, packet);
   let grounded = now_unix_ms();
   let oracle = if askOracle then fcnv-ask(packet,request) else fcnv-not-asked();
   let nativeEvidence = if askOracle then fcnv-retain(job,oracle) else 0;
   let oracleDone = now_unix_ms();
   let oracleAnswered = str_eq(nth(oracle, 0), "answered");
   let askProvider = and(allowProvider, not(oracleAnswered));
   let first = if askProvider then fgs-ask-provider(job, "synthesis", seconds, packetPath, effort) else fgs-not-asked();
   let firstAnswer = fgs-text(nth(first, 1), "result");
   let thin = and(askProvider, lt(str_len(trim(firstAnswer)), fgs-min-answer-bytes()));
   let repairing = and(thin, allowRepair);
   let keptFirst = if repairing then write_file_text(fhn-at(job, "answer-1.md"), firstAnswer) else 0;
   let repairPath = fhn-at(job, "packet-repair.txt");
   let wroteRepair = if repairing then write_file_text(repairPath, fgs-repair-packet(packet, firstAnswer)) else 0;
   let second = if repairing then fgs-ask-provider(job, "synthesis-repair", seconds, repairPath, effort) else fgs-not-asked();
   let ended = now_unix_ms();
   let doc1 = nth(first, 1);
   let doc2 = nth(second, 1);
   let secondAnswer = fgs-text(doc2, "result");
   let providerAnswer = if and(repairing, gt(str_len(trim(secondAnswer)), 0)) then secondAnswer else firstAnswer;
   let doc = if and(repairing, gt(str_len(trim(secondAnswer)), 0)) then doc2 else doc1;
   let source = if oracleAnswered then "fkwu-model-session" else if str_eq(trim(providerAnswer), "") then "none" else "provider";
   let answer = if oracleAnswered then nth(oracle, 1) else providerAnswer;
   let answerPath = fhn-at(job, "answer.md");
   let kept = write_file_text(answerPath, answer);
   let input = fgs-usage2(doc1, doc2, "input_tokens");
   let cacheWrite = fgs-usage2(doc1, doc2, "cache_creation_input_tokens");
   let cacheRead = fgs-usage2(doc1, doc2, "cache_read_input_tokens");
   let output = fgs-usage2(doc1, doc2, "output_tokens");
   json-node-object(list(
    fhn-s("source", source),
    fhn-s("status", if thin then nth(second, 0) else nth(first, 0)),
    fhn-n("provider_attempts", if repairing then 2 else if askProvider then 1 else 0),
    fhn-n("answer_thin", if thin then 1 else 0),
    fhn-n("repair_allowed", if allowRepair then 1 else 0),
    fhn-s("effort", effort),
    fhn-n("opening_bytes", opening),
    fhn-n("thinking_tokens", add(fgs-usage(fgs-details(doc1), "thinking_tokens"), fgs-usage(fgs-details(doc2), "thinking_tokens"))),
    fhn-s("evidence", job),
    fhn-s("packet", packetPath),
    fhn-s("answer", answerPath),
    fhn-s("oracle", nth(oracle, 0)),
    json-node-pair("native_generation",fcnv-metadata(oracle)),
    fhn-n("oracle_ms", sub(oracleDone, grounded)),
    fhn-n("oracle_tokens_evaluated", nth(oracle, 2)),
    fhn-n("oracle_tokens_predicted", nth(oracle, 3)),
    fhn-s("oracle_model", nth(oracle, 4)),
    fhn-s("provider_session", fgs-text(doc, "session_id")),
    fhn-a("receipts", fgs-names(rows)),
    fhn-n("enrichment_bytes", str_len(enrichment)),
    fhn-n("packet_bytes", str_len(packet)),
    fhn-n("answer_bytes", str_len(answer)),
    fhn-n("grounding_ms", sub(grounded, started)),
    fhn-n("provider_ms", sub(ended, oracleDone)),
    fhn-n("provider_turns", add(fgs-usage(doc1, "num_turns"), fgs-usage(doc2, "num_turns"))),
    fhn-n("input_tokens", input),
    fhn-n("cache_write_input_tokens", cacheWrite),
    fhn-n("cache_read_input_tokens", cacheRead),
    fhn-n("output_tokens", output),
    fhn-n("rent_tokens", add(add(input, cacheWrite), add(cacheRead, output)))));
  }
 }
}
