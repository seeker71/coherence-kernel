// Deterministic fault injection for tests and the explicit live retry witness.
// The wrong candidate is supplied by this fixture, never attributed to Qwen.
// preludes: form-stdlib/bml/form-cli-code-request.bml
section [form.bml] {
 class FormCliCodeRepairFixture {
  def fcrf-goal() = "Fix calc.form so bump(x) returns x*x+x+1 for all integers, including zero and negative inputs. Keep the module and unary function name. The native definition grammar is module calc { fn bump(x) = add(x,1); }. Use only add, sub, mul and integer expressions. Preserve locked.txt. Diagnose the actual failing case and change the approach; do not change the checks.";
  def fcrf-docs() = list(list("calc", "calc.form", "module calc { fn bump(x) = add(x,1); }"), list("locked", "locked.txt", "caller-owned"));
  def fcrf-contract() = node_children(faj-json("repair-checks", "[{\"kind\":\"definition\",\"path\":\"calc.form\",\"function\":\"bump\",\"cases\":[[0,1],[1,3],[-1,1],[2,7],[21,463],[-2,3]]},{\"tool\":\"read\",\"arguments\":[\"locked.txt\"],\"stdout\":\"caller-owned\"}]"));
  def fcrf-checker() = list(fcaq-check, fcrf-contract());
  def fcrf-implementation() {
   let initial = fcap-open(fcrf-goal(), fcrf-docs(), list("calc.form"));
   let refined = fcap-step(initial, "{\"brief\":\"Implement the quadratic; preserve locked.txt.\"}", fcrf-checker());
   let planned = fcap-step(refined, "{\"plan\":\"Change the expression, inspect edge cases and run native checks.\"}", fcrf-checker());
   fcap-step(planned, "{\"tasks\":[\"Implement the expression\"]}", fcrf-checker());
  }
  def fcrf-failure() {
   let wrong = fcap-step(fcrf-implementation(), "{\"tool\":\"edit\",\"arguments\":[\"calc.form\",\"add(x,1)\",\"add(x,2)\"]}", fcrf-checker());
   let reviewed = fcap-step(wrong, "{\"task\":\"done\"}", fcrf-checker());
   fcap-step(reviewed, "{\"verdict\":\"accept\",\"reason\":\"Seeded wrong candidate for an actual checker failure.\"}", fcrf-checker());
  }
  def fcrf-first-state() = fcap-open("Set enabled true in config.json. Read expected.json for the required provider and copy that provider into config.json. Preserve remote=false and preserve expected.json exactly. Use one implementation task.", list(list("config", "config.json", "{\"enabled\":false,\"provider\":\"unset\",\"remote\":false}"), list("expected", "expected.json", "{\"provider\":\"native-qwen\"}")), list("config.json"));
  def fcrf-first(model) = if not(fcac-model-ready(model)) then list("attention", "native-model-unavailable") else fcrf-first-opened(fcac-open(model, fcrf-first-state(), 8192));
  def fcrf-first-opened(session) = if fcms-live?(session) then fcrf-first-generate(session) else fcrf-first-refused(session);
  def fcrf-first-refused(session) {
   let released = fcms-release-ok?(session);
   list("attention", fcms-reason(session), "released", released);
  }
  def fcrf-first-generate(session) {
   let generation = fcacs-quantum(session, fcacs-stops(session, qsx-load(fcms-path(session))), 128);
   let text = tkz-decode-text(fcms-src(session), fcms-generation-ids(generation));
   let stopped = fcms-stopped?(fcms-generation-session(generation));
   let released = fcms-release-ok?(fcms-generation-session(generation));
   let next = fcap-step(fcrf-first-state(), text, list(fcaq-check, list()));
   let passed = and(eq(stopped, 1), and(eq(released, 1), str_eq(fcap-stage(next), "plan")));
   let observed = bfc-record-out(bfc-envelope(0, now_unix_ms(), 0, list(passed, stopped, released, len(fcms-generation-ids(generation))), 3), 0);
   list("first-reply-pass", passed, "stopped", stopped, "ids", len(fcms-generation-ids(generation)), "release", released, "stage", fcap-stage(next), "synthetic-reply", text);
  }
 }
 0;
}
