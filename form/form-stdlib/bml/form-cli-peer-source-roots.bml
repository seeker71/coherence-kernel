//////////////////////////////////////////////////////////////////////
// form-cli-peer-source-roots.bml -- caller-born definition roots.
//
// A resident's source-symbol index is a retained capability.  Its roots are
// fixed at birth, never inferred from task bytes, and cover both the Form
// orchestration body and the Form-emitted native organs it can name.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/source-of.fk

section [form.bml] {
    class FormCliPeerSourceRoots {
        field StdlibRelative = "/form/form-stdlib";
        field NativeMetalRelative = "/form/native/metal";

        def fcpsr-stdlib-root(bodyRoot) = str_concat(bodyRoot, StdlibRelative());
        def fcpsr-native-metal-root(bodyRoot) = str_concat(bodyRoot, NativeMetalRelative());
        def fcpsr-resident-source-roots(bodyRoot) = list(fcpsr-stdlib-root(bodyRoot), fcpsr-native-metal-root(bodyRoot));
    }
    0;
}
