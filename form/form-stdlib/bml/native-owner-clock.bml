// Process-local owner identities use the existing record-construction clock.
// The counter survives compaction; record display text carries no identity.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NativeOwnerClock {
  def noc-positive(value) = if str_eq(value_kind(value),"int") then gt(value,0) else 0;
  def noc-sequence() {
   let count = kernel_stat(164);
   if not(noc-positive(count)) then form_error("native owner construction clock unavailable") else count;
  }
  def noc-open() {
   let marker = record_new(0);
   let count = noc-sequence();
   let pid = host_pid();
   let page = kernel_live(pid);
   if lt(len(page),3) then form_error("native owner process birth unavailable")
   else if not(and(eq(nth(page,1),pid),noc-positive(nth(page,2)))) then form_error("native owner process birth unavailable")
   else str_concat(fstr-int-to-str(pid),str_concat(":",str_concat(fstr-int-to-str(nth(page,2)),str_concat(":",fstr-int-to-str(count)))));
  }
  def noc-held(owner,key) {
   if record_has(owner,key) then record_get(owner,key) else {
    let identity = noc-open();
    record_set(owner,key,identity);
    identity;
   }
  }
 }
 0;
}
