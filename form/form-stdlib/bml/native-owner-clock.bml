// Process-local owner identities use the record-constructor dispatch clock.
// Tail dispatch can count one construction twice. Monotonicity supplies owner
// identity, not an allocation total; compaction preserves this clock.
import form-stdlib/core.fk;
section [form.bml] {
 class NativeOwnerClock {
  def noc-positive(value) = if ((String) value_kind(value) == "int") then (value > 0) else 0;
  def noc-process-ended-by(entry,alive,process) {
   let current=process(entry[0]);
   alive(entry[0])==0 || (noc-positive(entry[1]) && value_kind(current)=="list" && len(current)>5 && current[0]==entry[0] && noc-positive(current[5]) && current[5] != entry[1]);
  }
  def noc-process-ended?(entry) = noc-process-ended-by(entry,pid=>host_alive(pid),pid=>host_process(pid));
  def noc-sequence() {
   let count = kernel_stat(164);
   if (!noc-positive(count)) then form_error("native owner construction clock unavailable") else count;
  }
  def noc-open() {
   let marker = record_new(0);
   let count = noc-sequence();
   let pid = host_pid();
   // Owner birth is a process fact. Reading it does not need the graph's live
   // inventory, which would replay unrelated history to name a local event.
   let page = host_process(pid);
   if (value_kind(page)!="list" || len(page)<6) then form_error("native owner process birth unavailable")
   else if (!(((Comparable) page[0] == pid) && noc-positive(page[5]))) then form_error("native owner process birth unavailable")
   else (fstr-int-to-str(pid) + (":" + (fstr-int-to-str(page[5]) + (":" + fstr-int-to-str(count)))));
  }
  def noc-held(owner,key) {
   if record_has(owner,key) then record_get(owner,key) else {
    let identity = noc-open();
    record_set(owner,key,identity);
    identity;
   }
  }
 }
 0;
}
