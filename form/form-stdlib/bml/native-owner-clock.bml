// Process-local owner identities use the record-constructor dispatch clock.
// Tail dispatch can count one construction twice. Monotonicity supplies owner
// identity, not an allocation total; compaction preserves this clock.
// preludes: form-stdlib/core.fk
section [form.bml] {
 class NativeOwnerClock {
  def noc-positive(value) = (String) value_kind(value) == "int" ? (value > 0) : 0;
  def noc-sequence() {
   let count = kernel_stat(164);
   !noc-positive(count) ? form_error("native owner construction clock unavailable") : count;
  }
  def noc-open() {
   let marker = record_new(0);
   let count = noc-sequence();
   let pid = host_pid();
   let page = kernel_live(pid);
   len(page) < 3 ? form_error("native owner process birth unavailable")
   : !(((Comparable) page[1] == pid) && noc-positive(page[2])) ? form_error("native owner process birth unavailable")
   : fstr-int-to-str(pid) ++ ":" ++ fstr-int-to-str(page[2]) ++ ":" ++ fstr-int-to-str(count);
  }
  def noc-held(owner,key) {
   record_has(owner,key) ? record_get(owner,key) : {
    let identity = noc-open();
    record_set(owner,key,identity);
    identity;
   }
  }
 }
 0;
}
