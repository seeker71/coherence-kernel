// Exact text partitions and ordered review participation. No semantic verdict.
// Punctuation boundaries are an explicit heuristic, not a sentence parser.
// preludes: form-stdlib/bml/form-cli-quote-evidence.bml
section [form.bml] {
 class FormCliReviewSpans {
  def fcrs-is-int(v) = ((String) value_kind(v) == "int");
  def fcrs-is-list(v) = ((String) value_kind(v) == "list");
  def fcrs-is-str(v) = ((String) value_kind(v) == "string");
  def fcrs-is-punct(b) = (((Comparable) b == 46) || (((Comparable) b == 63) || ((Comparable) b == 33)));
  def fcrs-row-valid(row) = if (!fcrs-is-list(row)) then 0 else if (!((Comparable) len(row) == 3)) then 0 else (fcrs-is-int(nth(row,0)) && (fcrs-is-int(nth(row,1)) && fcrs-is-str(nth(row,2))));
  def fcrs-row-text(row) = nth(row, 2);
  def fcrs-row-start(row) = nth(row, 0);
  def fcrs-row-end(row) = nth(row, 1);
  def fcrs-row-ok(row, text, expectedStart) = if (!fcrs-row-valid(row)) then 0 else if (!((Comparable) fcrs-row-start(row) == expectedStart)) then 0 else if (!(fcrs-row-end(row) > fcrs-row-start(row))) then 0 else if (!(fcrs-row-end(row) <= str_len(text))) then 0 else ((String) substring(text,fcrs-row-start(row),fcrs-row-end(row)) == fcrs-row-text(row));
  def fcrs-rows-check(rows, text, i, expectedStart) = if ((Comparable) i == len(rows)) then ((Comparable) expectedStart == str_len(text)) else {
   let row = nth(rows, i);
   if (!fcrs-row-ok(row, text, expectedStart)) then 0 else fcrs-rows-check(rows, text, (i + 1), fcrs-row-end(row));
  };
  def fcrs-complete?(text, rows) = if (!fcrs-is-str(text)) then 0 else if (!fcrs-is-list(rows)) then 0 else fcrs-rows-check(rows, text, 0, 0);
  def fcrs-ids-check(rows, ids, i) = if ((Comparable) i == len(rows)) then ((Comparable) len(ids) == len(rows)) else {
   let id = nth(ids, i);
   if (!fcrs-is-int(id)) then 0 else if (!((Comparable) id == i)) then 0 else fcrs-ids-check(rows, ids, (i + 1));
  };
  def fcrs-ids-complete?(rows, ids) = if (!fcrs-is-list(rows)) then 0 else if (!fcrs-is-list(ids)) then 0 else if (!((Comparable) len(rows) == len(ids))) then 0 else fcrs-ids-check(rows, ids, 0);
  def fcrs-skip-ws(text, i, end) = if ((i < end) && fat-ws(str_byte_at(text, i))) then fcrs-skip-ws(text, (i + 1), end) else i;
  def fcrs-scan(text, i, end, start, rows) = if (i >= end) then if ((Comparable) start == end) then reverse(rows) else reverse(cons(list(start, end, substring(text, start, end)), rows)) else {
   let b = str_byte_at(text, i);
   if (fcrs-is-punct(b) && (((Comparable) (i + 1) == end) || fat-ws(str_byte_at(text, (i + 1))))) then {
    let k = fcrs-skip-ws(text, (i + 1), end);
    fcrs-scan(text, k, end, k, cons(list(start, k, substring(text, start, k)), rows));
   } else fcrs-scan(text, (i + 1), end, start, rows);
  };
  def fcrs-spans(text) = if (!fcrs-is-str(text)) then list() else if ((Comparable) str_len(text) == 0) then list() else {
   let i = fcrs-skip-ws(text, 0, str_len(text));
   if (i >= str_len(text)) then list(list(0, str_len(text), text)) else fcrs-scan(text, i, str_len(text), 0, list());
  };
 }
 0;
}
