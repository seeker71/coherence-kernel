// Exact text partitions and ordered review participation. No semantic verdict.
// Punctuation boundaries are an explicit heuristic, not a sentence parser.
// preludes: form-stdlib/bml/form-cli-quote-evidence.bml
section [form.bml] {
 class FormCliReviewSpans {
  def fcrs-is-int(v) = str_eq(value_kind(v), "int");
  def fcrs-is-list(v) = str_eq(value_kind(v), "list");
  def fcrs-is-str(v) = str_eq(value_kind(v), "string");
  def fcrs-is-punct(b) = or(eq(b, 46), or(eq(b, 63), eq(b, 33)));
  def fcrs-row-valid(row) = if not(fcrs-is-list(row)) then 0 else if not(eq(len(row),3)) then 0 else and(fcrs-is-int(nth(row,0)),and(fcrs-is-int(nth(row,1)),fcrs-is-str(nth(row,2))));
  def fcrs-row-text(row) = nth(row, 2);
  def fcrs-row-start(row) = nth(row, 0);
  def fcrs-row-end(row) = nth(row, 1);
  def fcrs-row-ok(row, text, expectedStart) = if not(fcrs-row-valid(row)) then 0 else if not(eq(fcrs-row-start(row),expectedStart)) then 0 else if not(gt(fcrs-row-end(row),fcrs-row-start(row))) then 0 else if not(le(fcrs-row-end(row),str_len(text))) then 0 else str_eq(substring(text,fcrs-row-start(row),fcrs-row-end(row)),fcrs-row-text(row));
  def fcrs-rows-check(rows, text, i, expectedStart) = if eq(i, len(rows)) then eq(expectedStart, str_len(text)) else {
   let row = nth(rows, i);
   if not(fcrs-row-ok(row, text, expectedStart)) then 0 else fcrs-rows-check(rows, text, add(i, 1), fcrs-row-end(row));
  };
  def fcrs-complete?(text, rows) = if not(fcrs-is-str(text)) then 0 else if not(fcrs-is-list(rows)) then 0 else fcrs-rows-check(rows, text, 0, 0);
  def fcrs-ids-check(rows, ids, i) = if eq(i, len(rows)) then eq(len(ids), len(rows)) else {
   let id = nth(ids, i);
   if not(fcrs-is-int(id)) then 0 else if not(eq(id, i)) then 0 else fcrs-ids-check(rows, ids, add(i, 1));
  };
  def fcrs-ids-complete?(rows, ids) = if not(fcrs-is-list(rows)) then 0 else if not(fcrs-is-list(ids)) then 0 else if not(eq(len(rows), len(ids))) then 0 else fcrs-ids-check(rows, ids, 0);
  def fcrs-skip-ws(text, i, end) = if and(lt(i, end), fat-ws(str_byte_at(text, i))) then fcrs-skip-ws(text, add(i, 1), end) else i;
  def fcrs-scan(text, i, end, start, rows) = if ge(i, end) then if eq(start, end) then reverse(rows) else reverse(cons(list(start, end, substring(text, start, end)), rows)) else {
   let b = str_byte_at(text, i);
   if and(fcrs-is-punct(b), or(eq(add(i, 1), end), fat-ws(str_byte_at(text, add(i, 1))))) then {
    let k = fcrs-skip-ws(text, add(i, 1), end);
    fcrs-scan(text, k, end, k, cons(list(start, k, substring(text, start, k)), rows));
   } else fcrs-scan(text, add(i, 1), end, start, rows);
  };
  def fcrs-spans(text) = if not(fcrs-is-str(text)) then list() else if eq(str_len(text), 0) then list() else {
   let i = fcrs-skip-ws(text, 0, str_len(text));
   if ge(i, str_len(text)) then list(list(0, str_len(text), text)) else fcrs-scan(text, i, str_len(text), 0, list());
  };
 }
 0;
}
