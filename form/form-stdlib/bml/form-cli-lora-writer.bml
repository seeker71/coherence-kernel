//////////////////////////////////////////////////////////////////////
//
// form-cli-lora-writer.bml — high-grammar authority.
//
// This cell emits general-d rank-1 A/B as Form text, applied the
// cheap way (never form the d×d). Qwen GGUF stays frozen. Generate
// does not load this file yet. fqt-lora? stays 0 until that seam.
//
// Fuel is Form knowledge (a sample string), not a 27B gradient.
//
// Executable: form-stdlib/form-cli-lora-writer.bml
//
//////////////////////////////////////////////////////////////////////

package Form.cli.lorawriter;

import Form.kernel.*;

interface ILoraWriter [public, witness, reusable] {
   section [public] {
      const int Scale = 1000;
      const int Rank = 1;
      const String Tag = "lora-v1";
      const String Path = ".form-lora-adapter";

      int Dot( Object hA, Object hB ) [abstract];
      Object IdForward( Object hB, Object hA, Object hX ) [abstract];
      String Emit( Object hA, Object hB ) [abstract];
      int Write( String strPath, Object hA, Object hB ) [abstract];
      int Written( String strPath ) [abstract];
   }
}

template AdapterPair<TVec> [public, reusable] {
   section [public] {
      TVec A() [get];
      TVec B() [get];
      int Rank() [get];
      int Scale() [get];
   }
}

class FormLoraWriter [public, reusable, teach] : ILoraWriter {
   section [public] {
      const String TrustRule = "emit A/B; Qwen tensors stay frozen until generate loads the file";
      const String ExecutablePath = "form/form-stdlib/form-cli-lora-writer.bml";

      int Dot( Object hA, Object hB ) [abstract] {}
      Object IdForward( Object hB, Object hA, Object hX ) [abstract] {}
      String Emit( Object hA, Object hB ) [abstract] {}
      int Write( String strPath, Object hA, Object hB ) [abstract] {}
      int Written( String strPath ) [abstract] {}
   }
}
