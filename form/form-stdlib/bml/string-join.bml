// string-join.bml — join a list of strings in linear passes.
// A right fold or an accumulator copies its whole result once per element, so joining 100k
// four-byte chunks costs 35 s; pairing neighbours and folding the halves copies each byte
// once per round, about seventeen rounds for 100k, and lands in 25 ms. Every organ that
// builds a buffer, a binding or a line of bytes joins through here, linked by name.
import form-stdlib/core.fk;
section [form.bml] {
    class StringJoin {
        def sj-pair(xs, acc) = if nil?(xs) then reverse(acc) else if nil?(xs[1:]) then reverse(cons(xs[0], acc)) else sj-pair(xs[1:][1:], cons(((String) xs[0] + xs[1:][0]), acc));
        def str-join(parts) = if nil?(parts) then "" else if nil?(parts[1:]) then parts[0] else str-join(sj-pair(parts, []));
        def str-join-reversed(parts) = str-join(reverse(parts));
        def sj-sep-onto(parts, sep, acc) = if nil?(parts) then acc else sj-sep-onto(parts[1:], sep, cons(parts[0], if nil?(acc) then acc else cons(sep, acc)));
        def str-join-with(parts, sep) = str-join-reversed(sj-sep-onto(parts, sep, []));
    }
}
