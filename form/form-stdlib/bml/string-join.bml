// Balanced string joining shares its implementation with the source bootstrap.
import form-stdlib/core.fk;
section [form.bml] {
    class StringJoin {
        def sj-pair(xs, acc) = str-spans-pair(xs,acc);
        def str-join(parts) = str-spans(parts);
        def str-join-reversed(parts) = str-join(reverse(parts));
        def sj-sep-onto(parts, sep, acc) = if nil?(parts) then acc else sj-sep-onto(parts[1:], sep, cons(parts[0], if nil?(acc) then acc else cons(sep, acc)));
        def str-join-with(parts, sep) = str-join-reversed(sj-sep-onto(parts, sep, []));
    }
}
