// string-join.bml — join a list of strings in linear passes.
// A right fold or an accumulator copies its whole result once per element, so joining 100k
// four-byte chunks costs 35 s; pairing neighbours and folding the halves copies each byte
// once per round, about seventeen rounds for 100k, and lands in 25 ms. Every organ that
// builds a buffer, a binding or a line of bytes joins through here, linked by name.
// preludes: form-stdlib/core.fk
section [form.bml] {
    class StringJoin {
        def sj-pair(xs, acc) = nil?(xs) ? reverse(acc) : nil?(tail(xs)) ? reverse(cons(head(xs), acc)) : sj-pair(tail(tail(xs)), cons(head(xs) ++ head(tail(xs)), acc));
        def str-join(parts) = nil?(parts) ? "" : nil?(tail(parts)) ? head(parts) : str-join(sj-pair(parts, list()));
        def str-join-reversed(parts) = str-join(reverse(parts));
        def sj-sep-onto(parts, sep, acc) = nil?(parts) ? acc : sj-sep-onto(tail(parts), sep, cons(head(parts), nil?(acc) ? acc : cons(sep, acc)));
        def str-join-with(parts, sep) = str-join-reversed(sj-sep-onto(parts, sep, list()));
    }
}
