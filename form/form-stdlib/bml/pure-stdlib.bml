// Common pure surfaces shared by ordinary BML and the in-stream evaluator.
import form-stdlib/core.fk;
import form-stdlib/form-recipe-exec-token.fk;
section [form.bml] {
 class PureStdlib {
  field PureCategoryRoot = make_nodeid(31, 2, 0, 224);
  def pure-leaf(node) = node_level(node) == 1 && nil?(node_children(node));
  def kind(node) = pure-leaf(node) ? (node_type(node) == 1 ? "int" : node_type(node) == 2 ? "string" : node_type(node) == 3 ? "bool" : node_type(node) == 7 ? "float" : "leaf") : pure-category-name(node_category(node));
  def pure-category-name(category) = nil?(node_children(category)) ? frex-node-coordinate(category) : node_eq(node_category(category), PureCategoryRoot()) ? node_value(node_children(category)[0]) : frex-node-coordinate(category);
  def kids(node) = map(child => pure-leaf(child) ? node_value(child) : child, node_children(node));
  def sqrt(value) = value < 0 ? nothing() : math_sqrt(value);
  def max(values) = nil?(values) ? nothing() : maximum(values);
  def min(values) = nil?(values) ? nothing() : foldl((a,b) => a < b ? a : b, values[0], values[1:]);
 }
 0;
}
