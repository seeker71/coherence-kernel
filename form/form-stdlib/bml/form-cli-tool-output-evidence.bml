// Native carrier decoding: custom calls carry input, and their results may
// carry typed text blocks instead of one string. Only an exact executor
// result's final receipt is admitted; quoted examples are not boundaries.
// No private text leaves this reducer. Unsupported output shapes are an
// explicit negative coverage sentinel, never a measured zero.
// preludes: form-stdlib/core.fk form-stdlib/json.fk
section [form.bml] {
    class FormCliToolOutputEvidence {
        def fcto-unknown() = list(-1, 0, 0, 0, 0, 0, 0, 0);
        def fcto-request(segment, from) {
            let input = fctel-json-payload-string-from(segment, from, "input");
            let arguments = fctel-json-payload-string-from(segment, from, "arguments");
            let name = fctel-json-payload-string-from(segment, from, "name");
            let runner = (((String) name == "exec") || ((String) name == "functions.exec")) || (((String) name == "wait") || ((String) name == "functions.wait"));
            runner && (str_len(input) > 0) ? 2
            : runner && (str_len(arguments) > 0) ? 2
            : str_find(input ++ arguments, "form-run ", 0) >= 0 ? 1
            : fctel-native-command?(arguments);
        }
        def fcto-last-line(text, from, last) {
            let at = str_find(text, "\n", from);
            at < 0 ? substring(text, last, str_len(text))
            : fcto-last-line(text, at + 1, at + 1);
        }
        def fcto-receipt(text) {
            let tail = trim(substring(text, fctel-max(0, str_len(text) - 512), str_len(text)));
            let line = trim(fcto-last-line(tail, 0, 0));
            let parts = split-on(line, " ");
            !((Comparable) len(parts) == 6) ? fctel-zero-output-measure()
            : !((String) head(parts) == "@form") ? fctel-zero-output-measure()
            : !(fcte-digits?(parts[2]) && (fcte-digits?(parts[3]) && (fcte-digits?(parts[4]) && fcte-digits?(parts[5])))) ? fcto-unknown()
            : !((Comparable) (str_to_int(parts[3]) + str_to_int(parts[4])) == str_to_int(parts[5])) ? fcto-unknown()
            : fctel-form-line-measure(line);
        }
        def fcto-executor-result(text) {
            let document = frte-json-document(text);
            let root = frte-json-document-root(document);
            let shaped = ((Comparable) frte-json-document-valid?(document) == 1) && (json-object-has?(root, "wall_time_seconds") && (json-object-has?(root, "chunk_id") && json-object-has?(root, "output")));
            !shaped ? fctel-zero-output-measure()
            : !((Comparable) frte-json-nonnegative-int-field?(root, "exit_code") == 1) ? fctel-zero-output-measure()
            : fcto-executor-measure(root, fcto-receipt(frte-json-string-field(root, "output")));
        }
        def fcto-executor-measure(root, measure) {
            let failed = (Comparable) json-int-value(json-object-get(root, "exit_code")) == 0 ? 0 : 1;
            (measure[1] > 0) && (!((Comparable) measure[2] == failed)) ? fcto-unknown()
            : measure;
        }
        def fcto-block(block, scan) {
            let kind = frte-json-string-field(block, "type");
            let text = frte-json-string-field(block, "text");
            !(((String) kind == "input_text") || ((String) kind == "text")) ? fctel-zero-output-measure()
            : (Comparable) scan == 0 ? fctel-zero-output-measure()
            : !((Comparable) str_find(text, "{", 0) == 0) ? fctel-zero-output-measure()
            : fcto-executor-result(text);
        }
        def fcto-blocks(xs, scan, acc) {
            (Comparable) len(xs) == 0 ? acc : fcto-blocks-next(xs, scan, acc, fcto-block(head(xs), scan));
        }
        def fcto-blocks-next(xs, scan, acc, measure) {
            measure[0] < 0 ? fcto-unknown()
            : fcto-blocks(tail(xs), scan, fctel-measure-add(acc, measure));
        }
        def fcto-array(segment, at, stop, scan) {
            let parsed = json-parse-value(segment, at, "form-tool-output");
            let array = json-pair-r(parsed);
            !(((Comparable) json-pair-pos(parsed) == stop) && node_eq(node_category(array), JSON-ARRAY())) ? fcto-unknown()
            : fcto-array-count(stop - at, fcto-blocks(json-array-elements(array), scan, fctel-zero-output-measure()));
        }
        def fcto-array-count(bytes, measure) {
            measure[0] < 0 ? measure
            : cons(bytes, tail(measure));
        }
        def fcto-output-range(segment, from, end, prefix, scan) {
            let at = fctel-json-payload-field-start-from(segment, from, "output");
            let stop = fctel-json-value-end(segment, at);
            (at < 0) || ((stop < at) || (stop > end)) ? fcto-unknown()
            : (Comparable) ord(char_at(segment, at)) == 34 ? fctel-raw-output-measure-range(segment, from, end, prefix, scan > 0 ? 1 : 0)
            : (Comparable) ord(char_at(segment, at)) == 91 ? fcto-array(segment, at, stop, scan)
            : fcto-unknown();
        }
    }
}
