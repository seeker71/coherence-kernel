// Node controls operate on the native substrate; model bytes never become a
// claim that a node exists. Creation interns immutable content. Reads retain
// coordinates and children, and selection returns the chosen child itself.
import form-stdlib/form-recipe-exec-token.fk;
import form-stdlib/organ-health.bml;
section [form.bml] {
 class FormCliNodeControl {
  def fnc-open() = record_new(0,"nodes",record_new(0));
  def fnc-key(node) = frex-node-coordinate(node);
  def fnc-field?(request,key,type) = json-object-has?(request,key) && node_type(oh-get(request,key)) == type && node_pkg(oh-get(request,key)) == 1 && node_level(oh-get(request,key)) == 1;
  def fnc-keep(owner,node) { record_set(record_get(owner,"nodes"),fnc-key(node),node); node; }
  def fnc-match(node,parts) = !nothing?(node) && node_pkg(node) == parts[0] && node_level(node) == parts[1] && node_type(node) == parts[2] && node_inst(node) == parts[3] && fnc-content?(node,parts);
  def fnc-content?(node,parts) = parts[0] == 0 ? !node_eq(node_category(node),node) : parts[0] != 1 || parts[1] != 1 ? 1 : parts[2] == 2 ? value_kind(node_value(node)) == "string" : parts[2] == 7 ? value_kind(node_value(node)) == "float" : parts[2] == 3 ? node_value(node) == parts[3] : 1;
   def fnc-find(parts,index,end) = index > end ? nothing : fnc-match(node_at(index),parts) ? node_at(index) : fnc-find(parts,index + 1,end);
   def fnc-slotted?(parts) = parts[0] == 0 || parts[0] == 1 && parts[1] == 1 && (parts[2] == 2 || parts[2] == 7);
  def fnc-resolve(owner,key) {
   let parts = frex-coordinate-parts(key); let known = record_get(owner,"nodes");
   if nothing?(parts) || !nnw-valid?(parts[0],parts[1],parts[2],parts[3]) then nothing else if record_has(known,key) then record_get(known,key) else {
    let direct = node_at(parts[3]);
    // Integer/boolean coordinates carry their complete literal meaning. Native
    // composites, strings and float64 payloads address their storage slot; a
    // miss needs no field-wide scan. Other identity layouts use the census.
    let found = parts[0] == 1 && parts[1] == 1 && parts[2] == 1 ? intern_trivial_int(parts[3]) : parts[0] == 1 && parts[1] == 1 && parts[2] == 3 ? parts[3] == 0 || parts[3] == 1 ? intern_trivial_bool(parts[3]) : nothing : fnc-match(direct,parts) ? direct : fnc-slotted?(parts) ? nothing : fnc-find(parts,1,kernel_stat(4));
    nothing?(found) ? nothing : fnc-keep(owner,found);
   };
  }
  def fnc-description(node) {
   let kids = node_children(node); let category = node_category(node);
   let primitive = node_pkg(node) == 1 && node_level(node) == 1;
   json-node-object(append([oh-s("node",fnc-key(node)),oh-s("category",fnc-key(category)),json-node-pair("children",json-node-array(kids |> map(child=>json-node-string(fnc-key(child)))))],primitive ? [json-node-pair("value",node)] : []));
  }
  def fnc-leaf(value) = node_pkg(value) != 1 || node_level(value) != 1 ? nothing : node_type(value) == 1 || node_type(value) == 2 || node_type(value) == 3 || node_type(value) == 7 ? value : nothing;
  def fnc-child(owner,value) = node_eq(node_category(value),JSON-OBJECT()) && fnc-field?(value,"node",2) ? fnc-resolve(owner,oh-str(value,"node")) : fnc-leaf(value);
  def fnc-created(owner,request) {
   if json-object-has?(request,"value") && !json-object-has?(request,"category") && !json-object-has?(request,"children") then fnc-leaf(oh-get(request,"value"))
   else if !fnc-field?(request,"category",2) || !oh-array(request,"children") then nothing else {
    let category = frex-node-from-coordinate(oh-str(request,"category"));
    let children = json-array-elements(oh-get(request,"children")) |> map(value=>fnc-child(owner,value));
    nothing?(category) || any?(child=>nothing?(child),children) ? nothing : intern_node(category,children);
   };
  }
  def fnc-run(owner,payload) {
   let request = parse-json("form-node-control",payload);
   if !node_eq(node_category(request),JSON-OBJECT()) || !fnc-field?(request,"op",2) then ["nothing","node-request-shape",nothing] else if !oh-has(["create","read","select"],oh-str(request,"op")) then ["nothing","node-operation-or-index",nothing] else {
    let op = oh-str(request,"op");
    let node = op == "create" ? fnc-created(owner,request) : fnc-field?(request,"node",2) ? fnc-resolve(owner,oh-str(request,"node")) : nothing;
    if nothing?(node) then ["nothing",op == "create" ? "node-creation-shape-or-child-absent" : "node-absent",nothing]
    else if op == "create" || op == "read" then ["node",op == "create" ? "node-created" : "node-read",fnc-keep(owner,node)]
    else if op == "select" && fnc-field?(request,"index",1) then {
     let children = node_children(node); let at = node_value(oh-get(request,"index")); let index = at < 0 ? len(children) + at : at;
     index < 0 || index >= len(children) ? ["nothing","node-child-absent",nothing] : ["node","node-selected",fnc-keep(owner,children[index])];
    } else ["nothing","node-operation-or-index",nothing];
   };
  }
 }
 0;
}
