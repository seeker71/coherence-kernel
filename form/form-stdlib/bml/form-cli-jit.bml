//////////////////////////////////////////////////////////////////////
//
// form-cli-jit.bml — high-grammar authority for on-demand emission.
//
// One thought. Backends are data, not named C primitives. The executable
// lowering is form-stdlib/form-cli-jit.bml (generic class FormJit<T>).
//
// C installs. Form emits. metal_pipeline / mlx_run / jit_leaf_inram are
// host leaves the Apply method may call; they are not the architecture.
//
// THE UNIVERSALITY LAW (Urs, 2026-08-30): every recipe is JIT-eligible —
// the compiler and the JIT's own cells included; nothing is exempt by
// role. Crystallize-on-heat applies to whatever is hot, all the way
// down: a compiler that stays interpreted is a recipe whose heat has
// not yet met a wide-enough lowering, never a privileged exception.
// Honest floor at stamping: real arm64 pages are born and KEPT for the
// u32/leaf lanes (fk_arm64_u32 keep-cache; leaf subset tags {1,2,3,4,
// 5,8} through jit_leaf_inram); everything wider — the BML compiler,
// the heat gate itself — still walks. The named crossings, in order:
// transparent runtime dispatch (heat counted where calls happen, birth
// without an explicit gate call), the lowerable frontier widened past
// the leaf subset (strings, lists, calls), and self-application — the
// emitter crystallizing its own hot paths. The growtax teaching rides
// with this law: before pointing the JIT at a lane, prove the heat is
// the recipe's own (receipts/2026-08-30-growtax-the-cold-floor-drops.md).
//
//////////////////////////////////////////////////////////////////////

package Form.cli.jit;

import Form.kernel.*;

enum JitBackend [public] {
   MLX,
   METAL,
   CPU
}

template BackendCell<TImage> [public, reusable] {
   section [public] {
      TImage Emit( int n ) [abstract];
      int Apply( int n ) [abstract];
   }
}

class FormJit [public, reusable, jit] {
   section [public] {
      const int Mul = 3;
      const int Add = 7;
      const int Sample = 5;
      const int Expect = 22;

      String EmitMlx( int n ) [abstract];
      String EmitMsl() [abstract];
      int Apply( JitBackend backend, int n ) [abstract];

      // The live CPU gate is state threaded rather than hidden globally. Any
      // recipe may be offered; lowerability and heat decide native/Form route.
      Cell Gate( int meaningEpoch ) [abstract];
      Cell Request( Cell gate, Cell program, int root, int n ) [abstract];

      // The production on-demand owner separates availability from
      // optimization: DemandRequest returns the Form answer; DemandProgress
      // advances JIT and confirms its canonical Glass publication.
      Cell DemandOwner( int meaningEpoch ) [abstract];
      Cell DemandRequest( Cell owner, int n ) [abstract];
      Cell DemandProgress( Cell owner ) [abstract];
   }
}
