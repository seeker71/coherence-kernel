//////////////////////////////////////////////////////////////////////
//
// form-cli-jit.bml — high-grammar authority for on-demand emission.
//
// One thought. Backends are data, not named C primitives. The executable
// lowering is form-stdlib/form-cli-jit.bml (generic class FormJit<T>).
//
// C installs. Form emits. metal_pipeline / mlx_run / jit_leaf_inram are
// host leaves the Apply method may call; they are not the architecture.
//
//////////////////////////////////////////////////////////////////////

package Form.cli.jit;

import Form.kernel.*;

enum JitBackend [public] {
   MLX,
   METAL,
   CPU
}

template BackendCell<TImage> [public, reusable] {
   section [public] {
      TImage Emit( int n ) [abstract];
      int Apply( int n ) [abstract];
   }
}

class FormJit [public, reusable, jit] {
   section [public] {
      const int Mul = 3;
      const int Add = 7;
      const int Sample = 5;
      const int Expect = 22;

      String EmitMlx( int n ) [abstract];
      String EmitMsl() [abstract];
      int Apply( JitBackend backend, int n ) [abstract];
   }
}
