package Form.cli.authorhigh;

import Form.kernel.*;
import Form.cli.flow.*;

enum AuthorGrain [public] {
   HIGH,
   LOWER,
   BAND,
   ORGAN,
   SEED,
   OTHER
}

interface IAuthorHigh [public, witness, reusable] {
   section [public] {
      const int GrainHigh = 0;
      const int GrainLower = 1;
      const int GrainBand = 2;
      const int GrainOrgan = 3;
      const int GrainSeed = 4;
      const int GrainOther = 5;
      const int Force = 0;
      const String TrustRule = "new meaning authors BML or higher; existing Form organs stay; xtal is generated; bands prove; the C seed shrinks";

      int Grain( String strPath ) [abstract];
      int NewMeaningOffers( String strPath ) [abstract];
      int CompanionOk( String strPath ) [abstract];
      String Speak() [abstract];
   }
}

template GrainCell<TPath> [public, reusable] {
   section [public] {
      TPath Path() [get];
      int Grain() [get];
   }
}

class FormAuthorHigh [public, reusable, teach] : IAuthorHigh {
   section [public] {
      const String ExecutablePath = "form/form-stdlib/form-cli-author-high.bml";

      int Grain( String strPath ) [abstract] {}
      int NewMeaningOffers( String strPath ) [abstract] {}
      int CompanionOk( String strPath ) [abstract] {}
      String Speak() [abstract] {}
   }
}

class FormAuthorHighSelf [public, selfHosting, teach, observable] {
   section [public] {
      const String CoreName = "form-cli-author-high-self";
      const String Pattern = "new-meaning-bml-or-higher organ-keep xtal-generated band-proof seed-shrink offer-not-force";

      bool Observable() [witness] { return true; }
      bool Executable() [witness] { return true; }
      bool Trustable() [witness] { return true; }
   }
}
