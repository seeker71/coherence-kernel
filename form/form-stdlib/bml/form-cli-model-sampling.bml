// Session-owned, seeded sampling of Qwen's actual output logits.
// The device selects exact top-k after presence penalties; Form owns the
// temperature, nucleus filter and MINSTD draw. Model weights stay read-only.
// preludes: form-stdlib/bml/form-cli-model-adapter.bml form-stdlib/sampling.fk
section [form.bml] {
 class FormCliModelSampling {
  field SessionSlot = 16;
  field Partitions = 256;
  field TopK = 20;
  field Temperature = 0.7;
  field TopP = 0.8;
  field Presence = 1.5;
  def fcsam-top-k() = TopK();
  def fcsam-temperature() = Temperature();
  def fcsam-top-p() = TopP();
  def fcsam-presence() = Presence();
  def fcsam-msl() = "#define FCSAM_K " ++ int_to_str(TopK()) ++ "\n" ++ fcsam-kernels();
  def fcsam-kernels() = "#include <metal_stdlib>\nusing namespace metal;
inline void fcsam_insert(thread float* v,thread uint* ids,uint k,float x,uint id) {
 if(!isfinite(x))return;
 uint at=k;for(uint j=0;j<k;j++){if(x>v[j]||(x==v[j]&&id<ids[j])){at=j;break;}}
 if(at==k)return;for(uint j=k-1;j>at;j--){v[j]=v[j-1];ids[j]=ids[j-1];}v[at]=x;ids[at]=id;
}
kernel void fcsam_clear(device uint* seen [[buffer(0)]],constant uint& n [[buffer(1)]],uint i [[thread_position_in_grid]]) {if(i<n)seen[i]=0;}
kernel void fcsam_parts(device const float* logits [[buffer(0)]],device const uint* seen [[buffer(1)]],device float* values [[buffer(2)]],device uint* ids [[buffer(3)]],constant uint& n [[buffer(4)]],constant uint& parts [[buffer(5)]],constant uint& k [[buffer(6)]],constant float& penalty [[buffer(7)]],uint part [[thread_position_in_grid]]) {
 if(part>=parts||k>FCSAM_K)return;float v[FCSAM_K];uint ix[FCSAM_K];for(uint j=0;j<k;j++){v[j]=-INFINITY;ix[j]=0xffffffffu;}
 for(uint i=part;i<n;i+=parts)fcsam_insert(v,ix,k,logits[i]-(seen[i]?penalty:0.0f),i);
 for(uint j=0;j<k;j++){values[part*k+j]=v[j];ids[part*k+j]=ix[j];}
}
kernel void fcsam_merge(device const float* values [[buffer(0)]],device const uint* ids [[buffer(1)]],device float* chosen [[buffer(2)]],device uint* selected [[buffer(3)]],constant uint& parts [[buffer(4)]],constant uint& k [[buffer(5)]],uint i [[thread_position_in_grid]]) {
 if(i!=0u||k>FCSAM_K)return;float v[FCSAM_K];uint ix[FCSAM_K];for(uint j=0;j<k;j++){v[j]=-INFINITY;ix[j]=0xffffffffu;}
 for(uint j=0;j<parts*k;j++)fcsam_insert(v,ix,k,values[j],ids[j]);
 for(uint j=0;j<k;j++){chosen[j]=v[j];selected[j]=ix[j];}
}
";
  def fcsam-seed-valid(seed) = !((String) value_kind(seed) == "int") ? 0 : ((seed > 0) && (seed < 2147483647));
  def fcsam-positive(xs) = nil?(xs) ? 1 : ((head(xs) > 0) && fcsam-positive(tail(xs)));
  // [vocabulary, pipelines, owned buffers, initial seed, current RNG, draws,
  //  aggregate diagnostics]. Diagnostics contain no token IDs or text.
  // Even partial admission owns its positive buffer handles until close.
  def fcsam-open(vocab,seed) = !(fcsam-seed-valid(seed) && (vocab >= TopK())) ? list() : {
   let source = fcsam-msl();
   let pipes = list(metal_pipeline(source,"fcsam_parts"),metal_pipeline(source,"fcsam_merge"),metal_pipeline(source,"fcsam_clear"));
   let bytes = (Partitions() * TopK()) * 4;
   let buffers = list(metal_buf_alloc(bytes),metal_buf_alloc(bytes),metal_buf_alloc(TopK() * 4),metal_buf_alloc(TopK() * 4),metal_buf_alloc(vocab * 4));
   list(vocab,pipes,buffers,seed,seed,0,list(0,0,0,0.0));
  };
  def fcsam-live(owner) = len(owner) < 6 ? 0 : (fcsam-positive(owner[1]) && fcsam-positive(owner[2]));
  def fcsam-owned(owner) = len(owner) < 6 ? 0 : fcsam-count(owner[2]);
  def fcsam-count(xs) = nil?(xs) ? 0 : ((head(xs) > 0 ? 1 : 0) + fcsam-count(tail(xs)));
  def fcsam-close(owner) = len(owner) < 6 ? 0 : { metal_sync(); q38-free-handles(owner[2]); };
  def fcsam-owner(session) = len(session) > SessionSlot() ? session[SessionSlot()] : list();
  def fcsam-with-owner(session,owner) {
   let base = (Comparable) len(session) == SessionSlot() ? session : (Comparable) len(session) == (SessionSlot() - 1) ? append(session,list(list())) : take(SessionSlot(),session);
   append(base,cons(owner,drop(SessionSlot() + 1,session)));
  }
  def fcsam-reset(owner) = !fcsam-live(owner) ? 0 : {
   metal_sync();
   metal_enqueue(owner[1][2],md-bind(list(owner[2][4]),list(head(owner))),head(owner));
  };
  def fcsam-mark(owner,id) = (id < 0) || (id >= head(owner)) ? 0 : ((Comparable) metal_buf_write(owner[2][4],id * 4,md-le32(1)) == 4);
  def fcsam-ids(bytes,i,n,out) = i >= n ? reverse(out) : fcsam-ids(bytes,i + 1,n,cons(kth-u32at(bytes,i),out));
  // Exact top-k, descending logit, lowest token ID first on ties. Nonfinite
  // logits do not become candidates; fewer than k finite logits fail closed.
  def fcsam-candidates(owner,logits,penalty) = !fcsam-live(owner) ? list() : {
   let b = owner[2]; let p = owner[1];
   metal_sync(); metal_batch_concurrent();
   let parts = metal_enqueue(head(p),q38-b16(list(logits,b[4],head(b),b[1]),list(head(owner),Partitions(),TopK(),md-f32-bits(penalty)),0,0),Partitions());
   let merged = (Comparable) parts == 1 ? metal_enqueue(p[1],q38-b16(list(head(b),b[1],b[2],b[3]),list(Partitions(),TopK()),0,1),1) : 0;
   let values = (Comparable) merged == 1 ? metal_buf_read(b[2],0,TopK() * 4) : "";
   let ids = (Comparable) merged == 1 ? metal_buf_read(b[3],0,TopK() * 4) : "";
   !(((Comparable) str_len(ids) == (TopK() * 4)) && (((Comparable) str_len(values) == (TopK() * 4)) && qlt-finite-bytes?(values,0,TopK()))) ? list() : list(qlt-f32s(values,TopK()),fcsam-ids(ids,0,TopK(),list()));
  };
  // Top-p keeps the smallest sorted prefix reaching its threshold. Ties keep
  // their stable order, so the explicit top-k cap is never widened by a tie.
  def fcsam-prefix(probs,total,limit,out) = nil?(probs) ? reverse(out) : {
   let next = total + head(probs); let kept = cons(head(probs),out);
   next >= limit ? reverse(kept) : fcsam-prefix(tail(probs),next,limit,kept);
  };
  def fcsam-probs(logits) = smp-renorm(fcsam-prefix(smp-softmax(smp-temperature(logits,Temperature())),0.0,TopP(),list()));
  // Cumulative over draws, including stop tokens. The peak is conditional on
  // the selected top-k, before nucleus filtering; it is not model confidence.
  def fcsam-stats(owner) = len(owner) > 6 ? owner[6] : list(0,0,0,0.0);
  def fcsam-observe(owner,pick,nucleus,peak) {
   let prior = fcsam-stats(owner);
   list(head(prior) + (pick > 0 ? 1 : 0),prior[1] + ((Comparable) nucleus == 1 ? 1 : 0),prior[2] + nucleus,prior[3] + peak);
  }
  def fcsam-draw(owner,logits) {
   let candidates = fcsam-candidates(owner,logits,Presence());
   nil?(candidates) ? list(-1,owner) : {
    let state = smp-minstd(owner[4]);
    let probabilities = smp-softmax(smp-temperature(head(candidates),Temperature()));
    let nucleus = fcsam-prefix(probabilities,0.0,TopP(),list());
    let pick = smp-sample(smp-renorm(nucleus),smp-uniform(state));
    let stats = fcsam-observe(owner,pick,len(nucleus),head(probabilities));
    list(candidates[1][pick],append(take(4,owner),list(state,owner[5] + 1,stats)));
   };
  }
  // The head at entry already predicts the next token. Each selected ID is
  // committed exactly once by step; the last emitted ID stays pending at cap.
  // [ids,pending,position,stopped,owner,reason]. The caller supplies its existing
  // forward and progress functions; sampling never replays a prompt or state.
  def fcsam-walk(session,owner,logits,step,pulse,pos,left,stops,out,untilPulse,width,completed) {
   let chosen = fcsam-draw(owner,logits); let id = head(chosen); let next = chosen[1];
   id < 0 ? list(out,-1,pos,0,next,"sampling-candidates-unavailable")
   : q38-stop?(id,stops) ? list(out,id,pos,1,next,"")
   : !fcsam-mark(next,id) ? list(out,-1,pos,0,next,"sampling-presence-write-failed")
   : {
    let output = append(out,list(id)); let count = completed + 1;
    untilPulse <= 1 ? pulse(count) : 0;
    (Comparable) left == 1 ? list(output,id,pos,0,next,"")
    : step(session,id,pos) < 0 ? list(output,-1,pos + 1,0,next,"sampling-forward-failed")
    : fcsam-walk(session,next,logits,step,pulse,pos + 1,left - 1,stops,output,untilPulse <= 1 ? (width * 2) : (untilPulse - 1),untilPulse <= 1 ? (width * 2) : width,count);
   };
  }
  def fcsam-run(session,owner,logits,step,pulse,pos,limit,stops) = !fcsam-reset(owner) ? list(list(),-1,pos,0,owner,"sampling-reset-failed") : fcsam-walk(session,owner,logits,step,pulse,pos,limit,stops,list(),1,1,0);
 }
 0;
}
