// Select the token row decoder from the tensor's actual GGUF type.
// preludes: form-stdlib/q4k-msl.fk form-stdlib/q6k-msl.fk
section [form.bml] {
 class Qwen38Embedding {
  def q38e-index(type) = match type { 8 => 30, 12 => 49, 14 => 50, 0 => 51, _ => -1 };
  def q38e-f32-msl() = "kernel void form_qwen_f32_row(device const float* s [[buffer(0)]], device float* d [[buffer(1)]], constant uint& off [[buffer(2)]], constant uint& n [[buffer(3)]], uint i [[thread_position_in_grid]]) { if (i < n) d[i] = s[off+i]; }";
  def q38e-msl() = q4m-dequant-body("form_qwen_q4k_row") ++ q6m-dequant-body("form_qwen_q6k_row") ++ q38e-f32-msl();
  def q38e-pipes(msl) = list(metal_pipeline(msl, "form_qwen_q4k_row"), metal_pipeline(msl, "form_qwen_q6k_row"), metal_pipeline(msl, "form_qwen_f32_row"));
 }
 0;
}
