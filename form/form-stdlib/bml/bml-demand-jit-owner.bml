//////////////////////////////////////////////////////////////////////
//
// bml-demand-jit-owner.bml -- production request/event/progress boundary.
//
// Request adopts the current executable state. Progress owns the effectful
// JIT step and canonical Glass publication. Unpublished observations remain
// ordered, immutable evidence; acknowledging them never restores old state.
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/bml-demand-jit.fk form-stdlib/bml/bml-demand-jit-glass.bml

section [form.bml] {
    class BmlDemandJitOwner [public, observable, jit] {
        field BDJOSchema = "bml-demand-jit-owner-v2";
        field BDJORequestSchema = "bml-demand-jit-owner-request-v1";
        field BDJOProgressSchema = "bml-demand-jit-owner-progress-v1";

        // owner = schema, JIT state, first receipt, measured first-answer ms,
        //          immutable observations awaiting publication in order, lifecycle.
        def bdjo-owner-queue(state, first, firstMs, publications, lifecycle) = list(BDJOSchema(), state, first, firstMs, publications, lifecycle);
        def bdjo-owner-state(state, first, firstMs, awaiting, lifecycle) = bdjo-owner-queue(state, first, firstMs, if nothing?(awaiting) then list() else list(bdjo-observe(state, awaiting)), lifecycle);
        def bdjo-owner(epoch) = bdjo-owner-state(bdj-empty(epoch), nothing(), 0, nothing(), "ready");
        def bdjo-owner-from-state(state) = bdjo-owner-state(state, nothing(), 0, nothing(), "ready");
        def bdjo-state(owner) = nth(owner, 1);
        def bdjo-first(owner) = nth(owner, 2);
        def bdjo-first-ms(owner) = nth(owner, 3);
        def bdjo-publications(owner) = nth(owner, 4);
        def bdjo-awaiting-observation(owner) = if nil?(bdjo-publications(owner)) then nothing() else head(bdjo-publications(owner));
        def bdjo-awaiting(owner) = if nil?(bdjo-publications(owner)) then nothing() else nth(bdjo-awaiting-observation(owner), 0);
        def bdjo-lifecycle(owner) = nth(owner, 5);

        def bdjo-request-result(first, owner) = list(BDJORequestSchema(), first, owner);
        def bdjo-request-first(result) = nth(result, 1);
        def bdjo-request-owner(result) = nth(result, 2);

        // A request-time carrier loss already contains a fault. Hold its exact
        // diagnostic step for publication; never run the automatic heal first.
        def bdjo-request-new(owner, first, elapsed) {
            let state = bdj-receipt-state(first);
            let awaiting = if ((Comparable) bdj-state-faulted?(state) == 1) then bdj-step-fault-held(state) else nothing();
            let lifecycle = if ((Comparable) bdj-state-faulted?(state) == 1) then "fault-publication-pending" else "step-pending";
            bdjo-owner-state(state, first, elapsed, awaiting, lifecycle);
        }
        def bdjo-new-fault?(before, after) {
            if !bdj-state-faulted?(after) then 0
            else if !bdj-state-faulted?(before) then 1
            else ((Value) bdj-fault-digest(bdj-state-fault(before))) != bdj-fault-digest(bdj-state-fault(after));
        }
        // The first demand supplies publication context, while each request
        // supplies current ownership. A newly lost page queues its own fault
        // behind older evidence rather than disappearing under that evidence.
        def bdjo-request-retained(owner, first) {
            let state = bdj-receipt-state(first);
            let changed = bdjo-new-fault?(bdjo-state(owner), state);
            let publications = if changed then append(bdjo-publications(owner), list(bdjo-observe(state, bdj-step-fault-held(state)))) else bdjo-publications(owner);
            bdjo-owner-queue(state, bdjo-first(owner), bdjo-first-ms(owner), publications,
                if changed && nothing?(bdjo-awaiting(owner)) then "fault-publication-pending" else bdjo-lifecycle(owner));
        }
        def bdjo-request(owner, source, cache, program, root, argument) {
            let started = now_unix_ms();
            let first = bdj-request(bdjo-state(owner), source, cache, program, root, argument);
            let elapsed = (now_unix_ms() - started);
            let next = if nothing?(bdjo-first(owner)) then bdjo-request-new(owner, first, elapsed) else bdjo-request-retained(owner, first);
            bdjo-request-result(first, next);
        }

        def bdjo-progress-result(status, step, publication, reading, confirmed, owner) = list(BDJOProgressSchema(), status, step, publication, reading, confirmed, owner);
        def bdjo-progress-status(result) = nth(result, 1);
        def bdjo-progress-step(result) = nth(result, 2);
        def bdjo-progress-publication(result) = nth(result, 3);
        def bdjo-progress-reading(result) = nth(result, 4);
        def bdjo-progress-confirmed?(result) = nth(result, 5);
        def bdjo-progress-owner(result) = nth(result, 6);

        def bdjo-cache-path(state) {
            let pending = bdj-state-pending(state);
            if !nothing?(pending) then bdj-pending-cache(pending)
            else "";
        }
        def bdjo-cache-bytes(path, step) {
            let bytes = if !bdjg-disk-ready?(step) || ((String) path == "") then -1 else file_size(path);
            if (bytes < 0) then nothing() else bytes;
        }
        // Select from the state that will run the step, then measure only
        // after it has executed. Delivery retries retain these observed facts;
        // the original first-demand context is not the later cache's owner.
        def bdjo-observe(state, step) {
            let path = if ((String) bdj-step-cache-path(step) != "") then bdj-step-cache-path(step) else bdjo-cache-path(state);
            list(step, path, bdjo-cache-bytes(path, step));
        }
        def bdjo-stage(owner, step) = bdjo-owner-queue(bdj-step-state(step), bdjo-first(owner), bdjo-first-ms(owner), append(bdjo-publications(owner), list(bdjo-observe(bdjo-state(owner), step))), "telemetry-publication-pending");
        def bdjo-reading-snapshot(reading) {
            if (!((String) fgtm-read-state-status(reading) == "current")) then nothing()
            else if (!((Comparable) fgtm-field-present?(fgtm-read-state-value(reading)) == 1)) then nothing()
            else fgtm-field-value(fgtm-read-state-value(reading));
        }
        def bdjo-publish-confirmed?(publication, reading, epoch, expectedSamples) {
            let snapshot = bdjo-reading-snapshot(reading);
            if (!((String) bdjg-publish-status(publication) == "published")) then 0
            else if nothing?(snapshot) then 0
            else if (!((String) fgtm-snapshot-publisher(snapshot) == BDJGPublisher())) then 0
            else if (!((Comparable) fgtm-snapshot-epoch(snapshot) == epoch)) then 0
            else ((Value) fgtm-snapshot-samples(snapshot) == expectedSamples);
        }
        def bdjo-next-epoch-at(root) {
            let now = now_unix_ms();
            let current = bdjo-reading-snapshot(fgtm-read-current(root, BDJGPublisher()));
            if nothing?(current) then now else max2(now, (fgtm-snapshot-epoch(current) + 1));
        }
        def bdjo-after-confirmed(owner, step) {
            let state = bdjo-state(owner);
            let remaining = tail(bdjo-publications(owner));
            if !nil?(remaining) then bdjo-owner-queue(state, bdjo-first(owner), bdjo-first-ms(owner), remaining, "telemetry-publication-pending")
            else if bdj-state-faulted?(state) then bdjo-owner-state(state, bdjo-first(owner), bdjo-first-ms(owner), nothing(), "fault-published")
            else if !nil?(bdj-state-care(state)) then bdjo-owner-state(state, bdjo-first(owner), bdjo-first-ms(owner), nothing(), "cache-care-published")
            else if !nothing?(bdj-state-pending(state)) then bdjo-owner-state(state, bdjo-first(owner), bdjo-first-ms(owner), nothing(), "step-pending")
            else if ((String) bdj-step-status(step)) == "cache-repaired" then bdjo-owner-state(state, nothing(), 0, nothing(), "cache-repaired-published")
            else if ((Comparable) bdjg-healed?(step) == 1) then bdjo-owner-state(state, nothing(), 0, nothing(), "healed-published")
            else bdjo-owner-state(state, nothing(), 0, nothing(), "resident-published");
        }
        def bdjo-after-publication(owner, step, publication, reading, epoch, expectedSamples) {
            let confirmed = bdjo-publish-confirmed?(publication, reading, epoch, expectedSamples);
            let next = if ((Comparable) confirmed == 1) then bdjo-after-confirmed(owner, step) else bdjo-owner-queue(bdjo-state(owner), bdjo-first(owner), bdjo-first-ms(owner), bdjo-publications(owner), "telemetry-publication-unconfirmed");
            bdjo-progress-result(if ((Comparable) confirmed == 1) then bdjo-lifecycle(next) else "telemetry-publication-unconfirmed", step, publication, reading, confirmed, next);
        }
        def bdjo-publish-at(owner, step, telemetryRoot) {
            let epoch = bdjo-next-epoch-at(telemetryRoot);
            let first = bdjo-first(owner);
            let cacheBytes = nth(bdjo-awaiting-observation(owner), 2);
            let expected = bdjg-samples(epoch, bdjo-first-ms(owner), first, step, cacheBytes);
            let publication = bdjg-publish-at(telemetryRoot, BDJGPublisher(), epoch, bdjo-first-ms(owner), first, step, cacheBytes);
            let reading = fgtm-read-current(telemetryRoot, BDJGPublisher());
            bdjo-after-publication(owner, step, publication, reading, epoch, expected);
        }
        // Care acts when the event arrives, even while earlier telemetry waits.
        // Its observation joins that ordered queue; delivery cannot undo care.
        // Stale, unrelated and explicitly held responses leave the owner intact.
        def bdjo-hear(owner, response) = bdjo-hear-at(owner, response, BDJGRoot());
        def bdjo-hear-at(owner, response, telemetryRoot) {
            let step = bdj-care-hear(bdjo-state(owner), response);
            if nothing?(step) then bdjo-progress-result("event-unmatched", nothing(), nothing(), nothing(), 1, owner)
            else {
                let next = bdjo-stage(owner, step);
                bdjo-publish-at(next, bdjo-awaiting(next), telemetryRoot);
            };
        }

        def bdjo-progress(owner) = bdjo-progress-at(owner, BDJGRoot());
        def bdjo-progress-at(owner, telemetryRoot) {
            if (!nothing?(bdjo-awaiting(owner))) then bdjo-publish-at(owner, bdjo-awaiting(owner), telemetryRoot)
            else if nothing?(bdjo-first(owner)) then bdjo-progress-result("idle", nothing(), nothing(), nothing(), 1, owner)
            else bdjo-progress-step-with-runtime-at(owner, telemetryRoot, bdj-runtime-fingerprint());
        }

        // Test/diagnostic lens: only the telemetry root and explicit runtime
        // identity vary. Production progress derives its own runtime identity;
        // event care already owns the image and identity it will publish.
        def bdjo-progress-with-runtime-at(owner, telemetryRoot, runtimeIdentity) {
            if (!nothing?(bdjo-awaiting(owner))) then bdjo-publish-at(owner, bdjo-awaiting(owner), telemetryRoot)
            else if nothing?(bdjo-first(owner)) then bdjo-progress-result("idle", nothing(), nothing(), nothing(), 1, owner)
            else bdjo-progress-step-with-runtime-at(owner, telemetryRoot, runtimeIdentity);
        }
        def bdjo-progress-step-with-runtime-at(owner, telemetryRoot, runtimeIdentity) {
            let step = bdj-step-with-runtime(bdjo-state(owner), runtimeIdentity);
            if ((String) bdj-step-status(step) == "cache-care-waiting") then bdjo-progress-result("cache-care-waiting", nothing(), nothing(), nothing(), 1, owner)
            else bdjo-publish-at(bdjo-stage(owner, step), step, telemetryRoot);
        }
    }
    0;
}
