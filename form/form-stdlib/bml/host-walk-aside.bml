// host-walk-aside.bml — tracked work that is not a union row waits as a patch in the checkout's hearth, and the walk follows main.
//
// A turn's source edit that did not land, a drawn page, a row whose ledger main deleted or git reads as binary: none of it
// rides a rebase (it would come back with an edge to conflict on), and none of it may hold the walk off main. hw-set-aside
// writes it whole into <dir>/<rel>/aside.patch (`git diff --binary HEAD` over its paths: `git apply` returns it) beside the
// rows it names (<rel>/rows.txt), then returns those paths to HEAD: a staged row is unstaged, a path HEAD holds is checked
// out, a file HEAD never held (an add, a rename's new name) stays in the tree untracked. The paths go back only once the
// patch is written whole; the answer is true when the work waits whole and the tree is back at HEAD for those paths.
// Nothing goes onto the stash stack (every worktree of the repo shares it), and nothing is lost.
// What it needs: host-child.bml (every git step is an argv child with its exit read from the host; hch-mkdirs).
import form-stdlib/bml/host-child.bml;
section [form.bml] {
 class HostWalkAside {
  // a status row is [XY, path, the path a rename or copy came from ("" for any other row)]
  def hw-aside-paths(rows) = foldl((acc, row) => (String) row[2] == "" ? append(acc, [row[1]]) : append(acc, [row[2], row[1]]), [], rows);
  def hw-aside-head-paths(rows) = foldl((acc, row) => (String) substring(row[0], 0, 1) == "A" ? acc : (String) row[2] == "" ? append(acc, [row[1]]) : append(acc, [row[2]]), [], rows);
  def hw-set-aside(io, dir, rows, said, rel) {
   let made = hch-mkdirs(dir ++ "/" ++ rel);
   let patch = hch-git-quiet-in(io, dir, "sync-aside-diff", append(["diff", "--binary", "HEAD", "--"], hw-aside-paths(rows)))[1] ?? "";
   let wrote = len(patch) > 0 ? write_file(dir ++ "/" ++ rel ++ "/aside.patch", patch) : 0 - 1;
   let named = write_file(dir ++ "/" ++ rel ++ "/rows.txt", said ++ "\n");
   ((Comparable) wrote == len(patch) && len(patch) > 0) ? hw-aside-back(io, dir, rows) : false;
  }
  def hw-aside-back(io, dir, rows) {
   let unstaged = hch-git-in(io, dir, "sync-aside-reset", append(["reset", "-q", "HEAD", "--"], hw-aside-paths(rows)));
   nil?(hw-aside-head-paths(rows)) ? true : hch-ok?(hch-git-in(io, dir, "sync-aside-restore", append(["checkout", "-q", "HEAD", "--"], hw-aside-head-paths(rows))));
  }
 }
 0;
}
