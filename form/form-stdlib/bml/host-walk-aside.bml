// host-walk-aside.bml — work that would hold the walk off main waits in the checkout's hearth, and the walk follows main.
//
// Tracked work that is not a union row (a turn's source edit that did not land, a drawn page, a row whose ledger main deleted
// or git reads as binary) would come back from a rebase with an edge to conflict on; an untracked file at a path main now
// tracks (a band a turn wrote that another hand landed) would stop the rebase. Neither may hold the walk. hw-set-aside writes
// the tracked work whole into <dir>/<rel>/aside.patch (`git diff --binary HEAD` over its paths: `git apply` returns it),
// moves each untracked file in main's way to <rel>/untracked/<its path>, and names them all in <rel>/rows.txt. Only then
// do the tracked paths return to HEAD: a staged row is unstaged, a path HEAD holds is checked out, a file HEAD never held (an
// add, a rename's new name) stays in the tree untracked. The answer is true when every piece waits whole and the tree is
// back at HEAD for those paths. Nothing goes onto the stash stack (every worktree of the repo shares it); nothing is lost.
// What it needs: host-child.bml (every git step is an argv child with its exit read from the host; hch-mkdirs).
import form-stdlib/bml/host-child.bml;
section [form.bml] {
 class HostWalkAside {
  // a status row is [XY, path, the path a rename or copy came from ("" for any other row)]
  def hw-aside-paths(rows) = foldl((acc, row) => (String) row[2] == "" ? append(acc, [row[1]]) : append(acc, [row[2], row[1]]), [], rows);
  def hw-aside-head-paths(rows) = foldl((acc, row) => (String) substring(row[0], 0, 1) == "A" ? acc : (String) row[2] == "" ? append(acc, [row[1]]) : append(acc, [row[2]]), [], rows);
  // the untracked files at a path origin/main holds
  def hw-in-way(io, dir) = filter(p => len(p) > 0 && hch-ok?(hch-git-quiet-in(io, dir, "sync-way", ["cat-file", "-e", "origin/main:" ++ p])), split-on(hch-git-quiet-in(io, dir, "sync-untracked", ["ls-files", "--others", "--exclude-standard", "-z"])[1] ?? "", byte_to_str(0)));
  def hw-way-text(way) = foldl((acc, p) => (String) acc == "" ? "?? " ++ p : acc ++ " ?? " ++ p, "", way);
  def hw-set-aside(io, dir, rows, way, said, rel) {
   let made = hch-mkdirs(dir ++ "/" ++ rel);
   let named = write_file(dir ++ "/" ++ rel ++ "/rows.txt", said ++ "\n");
   let held = nil?(rows) ? true : hw-aside-patch(io, dir, rows, rel);
   (held && all?(p => hw-aside-move(dir, rel, p), way)) ? (nil?(rows) ? true : hw-aside-back(io, dir, rows)) : false;
  }
  def hw-aside-patch(io, dir, rows, rel) {
   let patch = hch-git-quiet-in(io, dir, "sync-aside-diff", append(["diff", "--binary", "HEAD", "--"], hw-aside-paths(rows)))[1] ?? "";
   let wrote = len(patch) > 0 ? write_file(dir ++ "/" ++ rel ++ "/aside.patch", patch) : 0 - 1;
   (Comparable) wrote == len(patch) && len(patch) > 0;
  }
  // host_path_rename answers 0 when it moved the file
  def hw-aside-move(dir, rel, p) {
   let to = dir ++ "/" ++ rel ++ "/untracked/" ++ p;
   let made = hch-mkdirs(fs-path-dirname(to));
   host_path_rename(dir ++ "/" ++ p, to) == 0;
  }
  def hw-aside-back(io, dir, rows) {
   let unstaged = hch-git-in(io, dir, "sync-aside-reset", append(["reset", "-q", "HEAD", "--"], hw-aside-paths(rows)));
   nil?(hw-aside-head-paths(rows)) ? true : hch-ok?(hch-git-in(io, dir, "sync-aside-restore", append(["checkout", "-q", "HEAD", "--"], hw-aside-head-paths(rows))));
  }
 }
 0;
}
