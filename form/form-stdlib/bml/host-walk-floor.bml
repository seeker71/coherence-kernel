// host-walk-floor.bml — the option floor: a window holds an option only when its room holds a real option of that lane.
//
// One definition for the turns (receipts/native-turn-ledger.jsonl, hw-option-floor) and the planner
// (.hearth/local-plans/ledger.jsonl, observe/local-plan-run.bml lpr-floor-of): the median length of that lane's real
// options. A real option opened a model (local_generated_ids above 0) and reached a verdict (its "verdict" or its
// "lane_status" names one). A recheck, an already-full or idle read, a refusal before any model, a dry or test row, a
// lane that gave its memory back, a generation that broke before its reply (a voice_status other than answered, or a lane
// ending the failure table reads as the lane's own machinery: fctrt-broke?) and an option cut at a window's end
// (hw-cut-word) are no option. The rows of the voice that will open measure it when that voice has any, else every
// voice's rows do. The median: half the real options fit in it, and one option a machine held for hours or one that
// broke in a minute moves it one rank, never by its length. Half an hour stands while no real option is measured; the
// ceiling keeps a window able to hold a turn. The floor's words name the rows it read and the voice.
// What it needs: host-walk-text.bml (hw-field, hw-starts?, hw-minutes) and form-cli-task-runtime.bml (fctrt-broke?).
import form-stdlib/bml/host-walk-text.bml;
import form-stdlib/bml/form-cli-task-runtime.bml;
section [form.bml] {
 class HostWalkFloor {
  def hw-ledger() = "receipts/native-turn-ledger.jsonl";
  def hw-option-unmeasured-ms() = 1800000;
  // the word an option cut at its window's end carries (form-token-grammar.bml, ftg-window-end, writes it)
  def hw-cut-word() = "window-end";
  def hw-text-at(line, key) {
   let at = str_find(line, key, 0);
   let from = at + len(key);
   let close = str_find(line, "\"", from);
   at < 0 ? nothing() : substring(line, from, close < 0 ? len(line) : close);
  }
  def hw-word(line, key) = hw-text-at(line, key) ?? "";
  def hw-verdict?(line) = len(hw-word(line, "\"verdict\":\"")) > 0 || len(hw-word(line, "\"lane_status\":\"")) > 0;
  def hw-broke?(line) = (!nothing?(hw-text-at(line, "\"voice_status\":\"")) && (String) hw-word(line, "\"voice_status\":\"") != "answered") || fctrt-broke?(hw-word(line, "\"lane_reason\":\""));
  def hw-cut?(line) = hw-starts?(hw-word(line, "\"lane_reason\":\""), hw-cut-word()) || (String) hw-word(line, "\"voice_status\":\"") == hw-cut-word();
  def hw-real?(line) = (hw-field(line, "\"local_generated_ids\":") ?? 0) > 0 && str_find(line, "\"dry\":1", 0) < 0 && str_find(line, "\"test\":1", 0) < 0 && (String) hw-word(line, "\"rung\":\"") != "recheck" && !hw-starts?(hw-word(line, "\"lane_reason\":\""), "host-memory-") && hw-verdict?(line) && !hw-broke?(line) && !hw-cut?(line);
  def hw-wall(line) = hw-real?(line) ? hw-field(line, "\"wall_ms\":") : nothing();
  // the voice a row opened: the planner's "voice", the turn's approach "model"
  def hw-voice-of(line) = hw-text-at(line, "\"voice\":\"") ?? hw-word(line, "\"model\":\"");
  def hw-walls(lines, voice) = nil?(lines) ? [] : hw-walls-with((String) voice == "" || (String) hw-voice-of(lines[0]) == voice ? hw-wall(lines[0]) : nothing(), hw-walls(lines[1:], voice));
  def hw-walls-with(wall, rest) = nothing?(wall) ? rest : cons(wall, rest);
  def hw-insert(x, xs) = nil?(xs) ? [x] : x <= xs[0] ? cons(x, xs) : cons(xs[0], hw-insert(x, xs[1:]));
  def hw-sorted(xs) = nil?(xs) ? [] : hw-insert(xs[0], hw-sorted(xs[1:]));
  def hw-option-ceiling-ms() = 3600000;
  def hw-floor-words(walls, who) = "the median of " ++ len(walls).str() ++ " real options of " ++ who;
  def hw-floor-read(walls, who) = walls[len(walls) / 2] > hw-option-ceiling-ms() ? [hw-option-ceiling-ms(), hw-floor-words(walls, who) ++ ", held at " ++ hw-minutes(hw-option-ceiling-ms())] : [walls[len(walls) / 2], hw-floor-words(walls, who)];
  def hw-option-floor-of(text, voice) {
   let lines = split-on(text, "\n");
   let own = (String) voice == "" ? [] : hw-sorted(hw-walls(lines, voice));
   let every = nil?(own) ? hw-sorted(hw-walls(lines, "")) : [];
   !nil?(own) ? hw-floor-read(own, voice)
   : !nil?(every) ? hw-floor-read(every, (String) voice == "" ? "every voice" : "every voice, none of " ++ voice ++ " yet")
   : [hw-option-unmeasured-ms(), "no real option measured yet" ++ ((String) voice == "" ? "" : ", of " ++ voice ++ " or any voice")];
  }
  def hw-option-floor-at(path, voice) = hw-option-floor-of(file_size(path) < 1 ? "" : fhn-read(path), voice);
  // a turn opens this voice first: its memory is the one a turn waits for (hw-turn-need)
  def hw-turn-voice() = "qwen38-q4";
  def hw-option-floor-for(voice) = hw-option-floor-at(hw-ledger(), voice);
  def hw-option-floor() = hw-option-floor-for(hw-turn-voice());
 }
}
