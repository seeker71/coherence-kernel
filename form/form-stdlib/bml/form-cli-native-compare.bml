//////////////////////////////////////////////////////////////////////
// form-cli-native-compare.bml — the body's own answer to the pinned enquiry
// of docs/single-call-parity-goal.form, composed in one process from what
// the body has measured.
//
// Zero provider, zero oracle, zero calls that leave the body. The
// composition reads receipts/rent-ledger.jsonl and
// receipts/parity-contest-ledger.jsonl, the route rows of the pinned
// receipt, the enrich seeds for the enquiry's terms, one step along the
// seeded relations, and the dated receipt index, and speaks the comparison
// axis by axis with what is pending named. Two doors carry it:
//   observe/form-cli-compare-run.bml prints it raw and floors it into the
//   contest ledger; observe/native-voice-run.bml hands it to the in-process
//   model session as the packet, so the body's local voice speaks from the body's
//   own numbers at rent 0.
//
// preludes: form-stdlib/bml/form-cli-grounded-synthesis.bml observe/answer-parity-check.fk
//////////////////////////////////////////////////////////////////////

section [form.bml] {
 class FormCliNativeCompare {
  def fnc-enquiry() = "receipts/artifacts/2026-09-18-form-cli-enquiry.txt";
  def fnc-terms() = "quality volume frequency vitality trust traceability sovereignty resonance rented membrane";
  def fnc-receipt() = "receipts/2026-09-18-direct-vs-guided-form-cli.md";
  def fnc-rent-ledger() = "receipts/rent-ledger.jsonl";
  def fnc-contest-ledger() = "receipts/parity-contest-ledger.jsonl";
  def fnc-route-ledger() = "receipts/route-ledger.jsonl";
  def fnc-opening() = 160;
  def fnc-receipt-limit() = 8;
  def fnc-int(doc, key) = if json-object-has?(doc, key) then json-int-value(json-object-get(doc, key)) else 0;
  def fnc-str(doc, key) = if json-object-has?(doc, key) then json-string-value(json-object-get(doc, key)) else "";
  def fnc-nonempty(xs) = if nil?(xs) then list() else if str_eq(trim(head(xs)), "") then fnc-nonempty(tail(xs)) else cons(head(xs), fnc-nonempty(tail(xs)));
  def fnc-parse(xs) = if nil?(xs) then list() else cons(parse-json("ledger-row", head(xs)), fnc-parse(tail(xs)));
  def fnc-rows(path) = fnc-parse(fnc-nonempty(split-on(fhn-read(path), "\n")));
  def fnc-walk-line(r) = mc-cat(list("  ", fnc-str(r, "movement"), " | source=", fnc-str(r, "source"), " | rent=", int_to_str(fnc-int(r, "rent_tokens")), " | oracle=", fnc-str(r, "oracle"), " | oracle-predicted=", int_to_str(fnc-int(r, "oracle_tokens_predicted")), " | receipts-in-packet=", int_to_str(fnc-int(r, "receipts_in_packet")), " | answer-bytes=", int_to_str(fnc-int(r, "answer_bytes")), "\n"));
  def fnc-walk-lines(rows) = if nil?(rows) then "" else mc-cat(list(fnc-walk-line(head(rows)), fnc-walk-lines(tail(rows))));
  def fnc-contest-line(r) = mc-cat(list("  ", fnc-str(r, "movement"), " | source=", fnc-str(r, "single_source"), " | rent=", int_to_str(fnc-int(r, "single_rent_tokens")), " | left-the-body=", int_to_str(fnc-int(r, "single_non_form_calls")), " | receipts=", int_to_str(fnc-int(r, "single_receipts_existing")), " | floor=", int_to_str(fnc-int(r, "floor_parity")), " | reading=", fnc-str(r, "reading"), "\n"));
  def fnc-contest-lines(rows) = if nil?(rows) then "" else mc-cat(list(fnc-contest-line(head(rows)), fnc-contest-lines(tail(rows))));
  def fnc-provider-rent?(row) {
   if not(and(str_eq(fnc-str(row,"single_source"),"provider"),eq(fnc-int(row,"floor_parity"),1))) then 0
   else if not(json-object-has?(row,"single_rent_tokens")) then 0 else {
    let node = json-object-get(row,"single_rent_tokens"); let value = json-int-value(node);
    if not(str_eq(value_kind(value),"int")) then 0 else if not(node_eq(node,json-node-int(value))) then 0 else ge(value,0);
   };
  }
  def fnc-min-rent(rows, best) = if nil?(rows) then best else {
   let row = head(rows); let rent = fnc-int(row,"single_rent_tokens");
   let next = if not(fnc-provider-rent?(row)) then best else if nothing?(best) then rent else if lt(rent,best) then rent else best;
   fnc-min-rent(tail(rows),next);
  };
  def fnc-min-rent-text(rows) {
   let value = fnc-min-rent(rows,nothing());
   if nothing?(value) then "unobserved" else int_to_str(value);
  }
  // one step along the seeded relations: what each seeded term points at, and what that is
  def fnc-relations(terms) = if nil?(terms) then "" else mc-cat(list(fnc-relation(head(terms), fwf-forward(head(terms))), fnc-relations(tail(terms))));
  def fnc-relation(term, edges) = if nil?(edges) then "" else mc-cat(list("  ", term, " -> ", fwf-surface(fwf-at(fwf-edge-to(head(edges)))), ": ", fce-join(fwf-desc(fwf-at(fwf-edge-to(head(edges))))), "\n", fnc-relation(term, tail(edges))));
  // the route rows of the first day: guided, direct, bounded, relayed; every number the answer speaks is a row
  def fnc-route-line(r) = mc-cat(list("  ", fnc-str(r, "movement"), " (", fnc-str(r, "note"), "): rent ", int_to_str(fnc-int(r, "rent_tokens")), "; ", int_to_str(fnc-int(r, "non_form_calls")), " calls left the body; evidence ", fnc-str(r, "evidence"), "\n"));
  def fnc-route-lines(rows) = if nil?(rows) then "" else mc-cat(list(fnc-route-line(head(rows)), fnc-route-lines(tail(rows))));
  def fnc-route-calls(rows) = if nil?(rows) then "" else mc-cat(list(fnc-str(head(rows), "movement"), " ", int_to_str(fnc-int(head(rows), "non_form_calls")), ", ", fnc-route-calls(tail(rows))));
  def fnc-guided-route(rows) = if nil?(rows) then json-node-object(list()) else if eq(str_find(fnc-str(head(rows), "movement"), "guided", 0), 0) then head(rows) else fnc-guided-route(tail(rows));
  def fnc-term-list() = fgs-clean(split-on(fnc-terms(), " "));
  def fnc-index() = fgs-index(fgs-top(fgs-rank(fs_list("receipts"), fnc-term-list()), fnc-receipt-limit()), fnc-opening());
  // the guided reference's structural floor: (axes cited existing limits bytes)
  def fnc-guided-floor() = apc-floor(apc-text(fnc-receipt()));
  def fnc-text(enrichment, index, routes, walks, contests, guided) = mc-cat(list(
   "form-cli compare | source=native | provider=0 oracle=0 calls-left-the-body=0\n",
   "enquiry: ", fnc-enquiry(), "\n",
   "the body answers from its own rows, seeds and receipts; the person's reading is the judge of quality and resonance.\n\n",
   "[rented] tokens per answer to this enquiry, from the body's own rows\n",
   fnc-route-lines(routes),
   "  this call (native): rent 0; 0 calls left the body\n",
   "  minimum observed rent with the floor met among provider contests: ", fnc-min-rent-text(contests), "\n\n",
   "[walks] ", fnc-rent-ledger(), "\n", fnc-walk-lines(walks), "\n",
   "[contests] ", fnc-contest-ledger(), " (a rung with a provider inside; not this flow)\n", fnc-contest-lines(contests), "\n",
   "[quality] structural floor of the guided answer: axes=", int_to_str(nth(guided, 0)), " receipts-cited=", int_to_str(nth(guided, 2)), " limits-named=", int_to_str(nth(guided, 3)), " bytes=", int_to_str(nth(guided, 4)), "; floors of the contest answers are in their rows; the person's reading decides: pending\n",
   "[volume] this output is the body's own composition; packet sizes and answer bytes are in the rows above\n",
   "[frequency] calls that left the body per answer: ", fnc-route-calls(routes), "provider contests 1, this call 0\n",
   "[vitality] doors that stand for this enquiry: observe/form-cli-grounded-synthesis-run.bml, observe/rent-walk-run.bml, observe/parity-contest-run.bml, observe/answer-parity-check.fk, observe/form-cli-native-call-census-run.fk, observe/native-voice-run.bml, this door\n",
   "[trust] every rent figure above is a provider's own usage record; where the share meter's token-pressure lane read the same call it agreed (13,222 on 2026-09-18); this call's figures are the body's own counters\n",
   "[traceability] each row names its evidence path; the receipt names its artifacts; this output names its own crossings below\n",
   "[sovereignty] who decided each answer: guided = a rented mind at every step; direct = a rented mind inside one organ call; bounded and contests = the body chose the packet, a provider wrote once; local-oracle walks = the body chose the packet, an unrented model on this host wrote; this call = the body alone\n",
   "[resonance] not a number the body has; pending: the person's reading of the answers side by side\n",
   "[membrane] the planes this call crossed while composing (its own census window) follow the ground below\n\n",
   "[native ground] one in-process enrich reading of the terms\n", enrichment, "\n",
   "[one step along the seeded relations] what each seeded term points at, and what that is\n", fnc-relations(fnc-term-list()), "\n",
   "[receipts by name] terms matched first, then date, newest first; openings of ", int_to_str(fnc-opening()), " bytes\n", index,
   "[pending] felt resonance; local model availability and response quality require the current native-generation reading; the share meter requires a completed-turn coordinate on the current transcript\n"));
  // the whole composition, fresh from the ledgers, seeds and receipts
  def fnc-compose() = fnc-text(fce-command(fnc-terms()), fnc-index(), fnc-rows(fnc-route-ledger()), fnc-rows(fnc-rent-ledger()), fnc-rows(fnc-contest-ledger()), fnc-guided-floor());
  // the native rung measures itself into the contest ledger: rent 0, nothing left the body
  def fnc-self-row(single, guided, routes) = json-node-object(list(
   fhn-n("at_unix_ms", now_unix_ms()),
   fhn-s("movement", "native compare call"),
   fhn-s("enquiry", fnc-enquiry()),
   fhn-s("single_source", "native"),
   fhn-s("single_oracle", "not-asked"),
   fhn-s("single_answer", "receipts/artifacts/2026-09-18-native-compare-answer.txt"),
   fhn-n("single_rent_tokens", 0),
   fhn-n("single_non_form_calls", 0),
   fhn-n("single_axes", nth(single, 0)),
   fhn-n("single_receipts_cited", nth(single, 1)),
   fhn-n("single_receipts_existing", nth(single, 2)),
   fhn-n("single_limits", nth(single, 3)),
   fhn-n("single_bytes", nth(single, 4)),
   fhn-s("guided_answer", fnc-receipt()),
   fhn-n("guided_rent_tokens", fnc-int(fnc-guided-route(routes), "rent_tokens")),
   fhn-n("guided_non_form_calls", fnc-int(fnc-guided-route(routes), "non_form_calls")),
   fhn-n("guided_axes", nth(guided, 0)),
   fhn-n("guided_receipts_existing", nth(guided, 2)),
   fhn-n("guided_limits", nth(guided, 3)),
   fhn-n("floor_parity", if and(ge(nth(single, 0), nth(guided, 0)), and(ge(nth(single, 2), nth(guided, 2)), ge(nth(single, 3), nth(guided, 3)))) then 1 else 0),
   fhn-n("rent_ratio_bps", 0),
   fhn-n("rent_under_1pct", 1),
   fhn-n("zero_non_form", 1),
   fhn-s("reading", "pending")));
 }
}
