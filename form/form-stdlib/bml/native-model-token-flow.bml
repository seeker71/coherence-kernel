//////////////////////////////////////////////////////////////////////
//
// native-model-token-flow.bml — typed cross-process model-flow authority.
//
// This authority carries only execution metadata.  There is deliberately no
// prompt, decoded text, or token text field.  Presence is explicit so an
// unavailable token, tensor byte count, expert choice, or timing cannot turn
// into zero at the membrane.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    interface NativeModelTokenFlow {
        concept NodeIdentity = "producer-runtime-id";
        concept Stage = oneOf("request", "token", "layer", "tensor", "expert", "metal", "framebuffer", "glass");
        concept Evidence = oneOf("physical-live", "derived-window", "catalog", "declared");
        concept OptionalNumber = tagged("absent", "present");
        concept OptionalLabel = tagged("absent", "present");
        concept SemanticRole = oneOf("blueprint", "recipe", "cell", "value");

        rule nodeIdentity = "package.level.type.instance";
        rule coordinateWidth = "u16.u16.u16.u32";
        rule typeCapacity = "65536 families per package and level";
        rule operatorAbstraction = "type is the operator family; instance is its operation or variant";
        rule formFlowCategory = "1.2.99.1703";
        rule categoryBoundary = "every v2 event carries the producer CELL id, node_category id, category family prefix, explicit semantic role, and stage type; the original CELL id remains the event identity";
        rule roleBoundary = "NUMS.Go BlueprintNodeID_t and RecipeNodeID_t wrap the same NodeID_t coordinate, so role is never inferred from p.l.t.i bits";
        rule compatibility = "v1 events remain readable but project category/family/role-unpublished channels rather than inventing semantics";
        rule identityBoundary = "the producer reports its runtime node id; consumers validate coordinate shape and the publisher-flow parent chain without claiming cross-process content identity";
        rule privacy = "there is no prompt or decoded-payload field; trusted publishers keep every label metadata-only";
        rule absence = "unexposed fields remain absent and never become zero";
        rule projection = "when an optional expert id or framebuffer numeric field is absent, the exact route or sink provenance remains the compact visible value; absence is never rendered as an invented zero";
        rule publication = "typed current snapshot and Glass projection each replace by atomic rename";
    }
    0;
}
