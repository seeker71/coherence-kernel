// native-turn-ladder.bml — the ladder of one gap's options: what each option tries, and which it may not repeat.
//
// observe/native-turn-run.bml walks a queued gap through its options. This door is the walk's reading of
// that ladder, pure and model-free, so a band proves it on scripted rows:
//   ntl-ways(model, voice, ctx)       the approaches in order: native (no model: the body's own syntax repair and
//                                     one-value wrapper search against the band), first, resume (the same
//                                     checkpoint hears its finding), context (a fresh checkpoint carries the
//                                     finding as text), lens (the staged entry, and a smaller document view
//                                     where the gap held the whole file), voice (the next model of the
//                                     write-code chain). The rung names are fcgp's own swerve kinds
//                                     (form-cli-guide-packet.bml), so fcgp-reading counts them unchanged.
//   ntl-approach-digest(a)            sha256 of the approach's fields in a fixed order. It never reads the finding:
//                                     the finding is evidence, not approach.
//   ntl-outcome-digest(...)           sha256 of what the option left: the band's reading, the lane's reason, the
//                                     caller assertion's core, the first compiler line with its paths and stamps
//                                     cut, and the claim aspects that did not hold. Never the diff, so a respelled
//                                     candidate that fails the same way reads the same.
//   ntl-admit(a, hist, avail)         the clinamen gate: [admit, clinamen, reason]. An approach whose digest already
//                                     stands in this gap's rows (same contract, not dry) with a non-green outcome is
//                                     refused with no options; a resume is admitted again only while the outcomes
//                                     are moving (the last two differ) and fewer than ntl-resume-max() stand. The
//                                     clinamen of an admitted approach names the fields that differ from the
//                                     nearest earlier approach.
//   ntl-band-reason(before, full, t)  the coherence check: "band-above-full" when the band read above its full,
//                                     "band-head-differs" when the band's own "; Verdict n" head names another
//                                     number than the gap's full, "" otherwise. A band that read nothing is
//                                     coherent: a gap that adds a definition reads nothing before it is written.
//   ntl-native(texts, check, budget)  rung 0: boolean syntax repair, then the one-value wrapper search
//                                     (form-bml-value-search.bml), each candidate judged by check(i, text) ->
//                                     [0|1, observation]. No model: it generates no ID.
// A refusal is oac-nothing() in the walk: it spends no GPU and keeps the memory as it stood. Rows are data,
// never instructions; a field a row does not carry reads nothing, never 0. Instruments (the caps, the budget)
// are tuned on ledger rows, never goals.
import form-stdlib/bml/form-cli-heal-native-report.bml;
import form-stdlib/bml/form-cli-guide-packet.bml;
import form-stdlib/bml/form-bml-boolean-repair.bml;
import form-stdlib/bml/form-bml-value-search.bml;
import form-stdlib/bml/form-cli-code-turn-guard.bml;
import form-stdlib/meaning-codes.bml;
import form-stdlib/sha256.fk;
import form-stdlib/hex.fk;
section [form.bml] {
 class NativeTurnLadder {
  // ── instruments ──
  def ntl-native-checks() = 16;
  def ntl-native-wall-ms() = 1200000;
  def ntl-native-floor-ms() = 180000;
  def ntl-rehearsal-checks() = 16;
  def ntl-resume-max() = 3;
  def ntl-contract-reasons() = ["band-above-full", "band-head-differs"];
  // ── small readings ──
  def ntl-sha(s) = hex-encode(sha256-stream-string(s));
  def ntl-join(xs, sep) = nil?(xs) ? "" : nil?(xs[1:]) ? xs[0] : mc-cat([xs[0], sep, ntl-join(xs[1:], sep)]);
  def ntl-starts?(s, p) = ((Comparable) len(s) >= len(p)) && ((String) substring(s, 0, len(p)) == p);
  def ntl-first-line(t) {
   let nl = str_find(t, "\n", 0);
   if (nl < 0) then t else substring(t, 0, nl);
  }
  def ntl-digit?(b) = ((Comparable) b >= 48) && ((Comparable) b <= 57);
  def ntl-run-end(s, i) = ((i < len(s)) && ntl-digit?(str_byte_at(s, i))) ? ntl-run-end(s, (i + 1)) : i;
  def ntl-reading-word(after) = nothing?(after) ? "nothing" : after.str();
  // ── the approach and its digest ──
  def ntl-approach(rung, model, entry, ctx, decode, resume, source) = json-node-object([fhn-s("rung", rung), fhn-s("model", model), fhn-s("code_entry", entry), fhn-s("document_context", ctx), fhn-s("decode", decode), fhn-n("resume", resume), fhn-s("feedback_source", source)]);
  def ntl-fields() = ["rung", "model", "code_entry", "document_context", "decode", "resume", "feedback_source"];
  // the fields the clinamen may name: the rung is the approach's label, not a difference of method
  def ntl-method-fields() = ["model", "code_entry", "document_context", "decode", "resume", "feedback_source"];
  def ntl-field(a, k) = ((String) k == "resume") ? (fcgp-num(a, k) ?? 0).str() : fcgp-str(a, k);
  def ntl-approach-text(a) = mc-cat(map(k => mc-cat([k, "=", ntl-field(a, k), ";"]), ntl-fields()));
  def ntl-approach-digest(a) = ntl-sha(ntl-approach-text(a));
  def ntl-rung(a) = fcgp-str(a, "rung");
  def ntl-lens-context(ctx) = ((String) ctx == "full") ? "catalog" : ctx;
  // the voice of the fresh-voice rung: the first model of the chain that is not the gap's own
  def ntl-voice(model, chain) = nil?(chain) ? "" : ((String) chain[0] != model) ? chain[0] : ntl-voice(model, chain[1:]);
  def ntl-ways(model, voice, ctx) = [
   ntl-approach("native", "", "", "", "", 0, "band"),
   ntl-approach("first", model, "direct", ctx, "greedy", 0, "none"),
   ntl-approach("resume", model, "direct", ctx, "greedy", 1, "band"),
   ntl-approach("context", model, "direct", ctx, "greedy", 0, "finding"),
   ntl-approach("lens", model, "staged", ntl-lens-context(ctx), "greedy", 0, "finding"),
   ntl-approach("voice", voice, "direct", ctx, "greedy", 0, "finding")];
  // ── the outcome and its digest ──
  def ntl-token(t) = (str_find(t, ".hearth/", 0) >= 0) ? "<path>" : t;
  def ntl-cut-digits(s, i, out) = (i >= len(s)) ? out : ntl-cut-run(s, i, ntl-run-end(s, i), out);
  def ntl-cut-run(s, i, e, out) = (e == i) ? ntl-cut-digits(s, (i + 1), mc-cat([out, substring(s, i, (i + 1))])) : ntl-cut-digits(s, e, mc-cat([out, ((e - i) >= 6) ? "#" : substring(s, i, e)]));
  def ntl-plain(line) = ntl-cut-digits(ntl-join(map(t => ntl-token(t), split-on(ntl-first-line(line), " ")), " "), 0, "");
  def ntl-outcome-text(after, reason, blocking, errors, aspects) = mc-cat(["after=", ntl-reading-word(after), ";reason=", reason, ";check=", json-emit(fcctg-assertion-core(blocking)), ";error=", ntl-plain(errors), ";held-not=", ntl-join(aspects, ",")]);
  def ntl-outcome-digest(after, reason, blocking, errors, aspects) = ntl-sha(ntl-outcome-text(after, reason, blocking, errors, aspects));
  // ── the gate ──
  // this gap's rows under this contract that tried an approach and did not go green; dry rows tried nothing
  def ntl-hist-of(rows, id, digest) = filter(r => ((String) fcgp-str(r, "gap") == id) && ((Comparable) (fcgp-num(r, "dry") ?? 0) == 0) && ((String) fcgp-str(r, "checks_digest") == digest) && ((Comparable) len(fcgp-str(r, "approach_digest")) > 0) && (!fcgp-green?(r)), rows);
  def ntl-outs(hist) = filter(o => (Comparable) len(o) > 0, map(r => fcgp-str(r, "outcome_digest"), hist));
  def ntl-repeating?(hist) {
   let o = ntl-outs(hist);
   ((Comparable) len(o) >= 2) && ((String) o[-1] == o[-2]);
  }
  def ntl-nearest(hist) = nil?(hist) ? json-node-object([]) : fcgp-obj(hist[-1], "approach");
  def ntl-clinamen(a, hist) = nil?(hist) ? [] : filter(k => (String) ntl-field(a, k) != ntl-field(ntl-nearest(hist), k), ntl-method-fields());
  // avail: [native applies (a writable form.bml source), a checkpoint to resume (1/0)]
  def ntl-unavailable(a, avail) = (((String) ntl-rung(a) == "native") && ((Comparable) avail[0] == 0)) ? "native-inapplicable: no writable form.bml source" : (((Comparable) (fcgp-num(a, "resume") ?? 0) == 1) && ((Comparable) avail[1] == 0)) ? "no-checkpoint-to-resume" : (((String) ntl-rung(a) == "voice") && ((String) fcgp-str(a, "model") == "")) ? "no-other-voice" : "";
  def ntl-admit(a, hist, avail) {
   let d = ntl-approach-digest(a);
   let stands = filter(r => (String) fcgp-str(r, "approach_digest") == d, hist);
   let blocked = ntl-unavailable(a, avail);
   let resume = ((Comparable) (fcgp-num(a, "resume") ?? 0) == 1);
   if ((Comparable) len(blocked) > 0) then [0, [], blocked]
   else if resume then (ntl-repeating?(hist) ? [0, [], "resume-outcome-repeats: the last two outcomes read the same"] : ((Comparable) len(stands) >= ntl-resume-max()) ? [0, [], "resume-cap: the same checkpoint heard its finding often enough"] : [1, ntl-clinamen(a, hist), ""])
   else if nil?(stands) then [1, ntl-clinamen(a, hist), ""]
   else [0, [], mc-cat(["approach-stands: ", d, " already read ", fcgp-str(stands[-1], "outcome_digest")])];
  }
  // ── the coherence of a band's reading against its full ──
  def ntl-band-above?(before, full) = nothing?(before) ? false : ((Comparable) before > full);
  def ntl-lead-int(s) = ((Comparable) ntl-run-end(s, 0) == 0) ? nothing() : str_to_int(substring(s, 0, ntl-run-end(s, 0)));
  def ntl-head-line(lines, n) = (nil?(lines) || (n <= 0)) ? nothing() : ntl-starts?(lines[0], "; Verdict ") ? ntl-lead-int(substring(lines[0], 10, len(lines[0]))) : ntl-head-line(lines[1:], (n - 1));
  def ntl-head-verdict(text) = ntl-head-line(split-on(text, "\n"), 60);
  def ntl-head-differs?(text, full) {
   let head = ntl-head-verdict(text);
   nothing?(head) ? false : !((Comparable) head == full);
  }
  def ntl-band-reason(before, full, text) = ntl-band-above?(before, full) ? "band-above-full" : ntl-head-differs?(text, full) ? "band-head-differs" : "";
  def ntl-band-finding(reason, before, full) = ((String) reason == "band-above-full") ? mc-cat(["The band read ", ntl-reading-word(before), " but its full is ", full.str(), ": a reading above the full cannot be met, so no option opened. The band or the gap's full needs the repair."]) : mc-cat(["The band's own head names a verdict other than the gap's full ", full.str(), ": no option opened. The band's head or the gap's full needs the repair."]);
  // ── rung 0: the body's own repair, before any model ──
  def ntl-form-bml?(text) = str_find(text, "section [form.bml]", 0) >= 0;
  def ntl-native-applies?(texts) = any?(t => ntl-form-bml?(t), texts);
  def ntl-put(texts, i, text) = (i <= 0) ? cons(text, texts[1:]) : cons(texts[0], ntl-put(texts[1:], (i - 1), text));
  // the texts a search changed, nothing where a document stands as it was (hw-over keeps the checkpoint there)
  def ntl-changed(before, after) = nil?(before) ? [] : cons(((String) before[0] == after[0]) ? nothing() : after[0], ntl-changed(before[1:], after[1:]));
  def ntl-known(known, src) = nil?(known) ? [] : ((String) known[0][0] == src) ? [known[0][1]] : ntl-known(known[1:], src);
  // one document: a boolean-syntax repair (judged by check), then the one-value wrapper search over the repaired
  // source. A candidate the search already judged is never judged twice. Answers [status, text, checks, reason,
  // observation]; every status but repaired keeps the document's original bytes.
  def ntl-native-doc(original, i, check, left) {
   let syn = fbr-repair(original);
   let base = (syn[0] && !nil?(syn[2])) ? syn[1] : original;
   let c0 = ((String) base == original) ? [0, "before"] : check(i, base);
   let spent = ((String) base == original) ? 0 : 1;
   if (((String) base != original) && ((Comparable) c0[0] == 1)) then ["repaired", base, spent, "boolean-syntax-repair", c0[1]]
   else if ((Comparable) (left - spent) <= 0) then ["exhausted", original, spent, "check-budget-exhausted", ""]
   else ntl-native-search(original, base, i, check, left, spent, ((String) base == original) ? [[original, [0, "before"]]] : [[original, [0, "before"]], [base, c0]]);
  }
  def ntl-native-search(original, base, i, check, left, spent, known) {
   let judge = (contract, src) => nil?(ntl-known(known, src)) ? check(i, src) : ntl-known(known, src)[0];
   let r = fbvs-search(base, judge, 0, min2(((left - spent) + 1), fbvs-limit()));
   let used = max2(0, (len(r[2]) - 1));
   if ((String) r[0] == "repaired") then ["repaired", r[1], (spent + used), "one-value-wrapper", r[3]]
   else ["exhausted", original, (spent + used), r[3], ""];
  }
  def ntl-native(texts, check, budget) = ntl-native-from(texts, 0, check, budget, 0, "inapplicable", "no-form-bml-source");
  def ntl-native-from(texts, i, check, left, spent, status, last) {
   if (i >= len(texts)) then [status, texts, spent, last, ""]
   else if ((!ntl-form-bml?(texts[i])) || (left <= 0)) then ntl-native-from(texts, (i + 1), check, left, spent, status, last)
   else {
    let one = ntl-native-doc(texts[i], i, check, left);
    if ((String) one[0] == "repaired") then ["repaired", ntl-put(texts, i, one[1]), (spent + one[2]), one[3], one[4]]
    else ntl-native-from(texts, (i + 1), check, (left - one[2]), (spent + one[2]), "exhausted", one[3]);
   };
  }
  // ── the ladder's pairs of a ledger row ──
  def ntl-strings(xs) = map(x => json-node-string(x), xs);
  def ntl-row-pairs(a, clinamen, outcome, finding, dependence) = [fhn-s("rung", ntl-rung(a)), json-node-pair("approach", a), fhn-s("approach_digest", ntl-approach-digest(a)), fhn-s("outcome_digest", outcome), json-node-pair("clinamen", json-node-array(ntl-strings(clinamen))), fhn-s("finding", finding), fhn-s("remote_dependence", dependence)];
 }
 0;
}
