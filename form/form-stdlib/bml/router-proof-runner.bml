// The outer Form owner verifies the child's verdict, transported observations,
// retained process resources and observed process-group cleanup independently.
// preludes: form-stdlib/bml/router-proof-io.bml
section [form.bml] {
 class RouterProofRunner {
  def rpr-event-health(events) = if nil?(events) then list() else rpr-event-one(head(events), tail(events));
  def rpr-event-one(event, rest) {
   let row = json-object-get(event, "health");
   if and(str_eq(fhn-string(event, "phase"), "organ-health"), and(str_eq(fhn-string(row, "organ"), "router-native-proof"), str_eq(fhn-string(row, "stage"), "observe"))) then cons(row, rpr-event-health(rest)) else rpr-event-health(rest);
  }
  def rpr-correlated(rows, events) = if nil?(rows) then nil?(events) else if nil?(events) then 0 else and(str_eq(json-emit-precise(head(rows)), json-emit-precise(head(events))), rpr-correlated(tail(rows), tail(events)));
  def rpr-pain(rows) = if nil?(rows) then list() else if eq(json-int-value(json-object-get(head(rows), "health")), 1) then rpr-pain(tail(rows)) else cons(json-node-string(fhn-string(head(rows), "aspect")), rpr-pain(tail(rows)));
  def rpr-resources(rows) = if nil?(rows) then 1 else and(eq(json-int-value(json-object-get(head(rows), "alive_after_wait")), 0), and(ge(json-int-value(json-object-get(head(rows), "wait_status")), 0), rpr-resources(tail(rows))));
  def rpr-report(job, status) {
   let rows = json-array-elements(parse-json("routing-observations", fhn-read(fhn-at(job, "observations.json"))));
   let resources = json-array-elements(parse-json("routing-resources", fhn-read(fhn-at(job, "resources.json"))));
   let process = parse-json("routing-process", fhn-read(fhn-at(job, "routing.process.json")));
   let events = rpr-event-health(json-array-elements(json-object-get(process, "events")));
   let aligned = rpr-correlated(rows, events);
   let cleanup = json-object-get(process, "cleanup");
   let released = and(str_eq(fhn-string(cleanup, "state"), "released"), str_eq(fhn-string(cleanup, "group_members"), ""));
   let pain = rpr-pain(rows);
   let accepted = rp-all(list(str_eq(status, "0"), gt(len(rows), 0), nil?(pain), aligned, released, gt(len(resources), 0), rpr-resources(resources)));
   let report = json-node-object(list(fhn-s("schema", "native-router-observation-v1"), fhn-s("evidence", job), fhn-n("observations", len(rows)), fhn-n("transported_observations", len(events)), fhn-n("exact_health_correlation", aligned), fhn-n("owned_children", len(resources)), fhn-n("process_group_released", released), json-node-pair("pain", json-node-array(pain)), fhn-s("status", status), fhn-n("stdout_bytes", file_size(fhn-at(job, "routing.out"))), fhn-n("stderr_bytes", file_size(fhn-at(job, "routing.err"))), fhn-n("accepted", accepted)));
   rp-save(fhn-at(job, "report.json"), report);
   print_str(json-emit-precise(report));
   let diagnostics = fhn-read(fhn-at(job, "routing.err"));
   if gt(str_len(diagnostics), 0) then print_str(diagnostics) else 0;
   if accepted then 1 else form_error("native routing observation or owned cleanup refused");
  }
  def rpr-run() {
   let job = fhn-unique("/tmp", "form-native-router-", 0);
   if str_eq(job, "") then form_error("cannot retain router observation") else 0;
   let input = fhn-at(job, "input");
   write_file(input, str_concat(job, "\n"));
   print_str(str_concat("process-evidence=", job));
   let status = fhn-run-start(job, "routing", 180, fhn-root(), input, list("./fkwu", "form/form-kernel-rust/router-native-exercise.bml"));
   rpr-report(job, status);
  }
 }
 0;
}
