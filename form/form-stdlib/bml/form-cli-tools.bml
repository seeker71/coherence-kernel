// The CLI admits declared native files; the shared tool wire remains data-only.
import form-stdlib/bml/form-agent-tool-wire.bml;
import form-stdlib/bml/form-cli-code-request.bml;
section [form.bml] {
 class FormCliTools {
  def fctw-s(key,value) = json-node-pair(key,json-node-string(value));
  def fctw-n(key,value) = json-node-pair(key,json-node-int(value));
  def fctw-call(request) = !fat-text?(request) || len(request) > FatMaxBytes() || !faj-valid(request) ? fat-wire-call(request) : fctw-decoded(faj-json("form-cli-tools",request));
  def fctw-decoded(node) = !fat-wire-object?(node) ? fat-wire-decoded(node) : fctw-command(node,fat-wire-required-string(node,"command"));
  def fctw-command(node,command) = fat-wire-error(command) != "" ? fat-wire-command(node,command) : fctw-input(node,command,fat-wire-field-string(node,"input",""));
  def fctw-input(node,command,input) = fat-wire-error(input) != "" ? fat-wire-input(node,command,input) : fctw-docs(node,command,input,host_monotonic_ms(),fcaq-documents(node));
  def fctw-files(node,docs) {
   let declared=node_children(json-object-get(node,"documents"));
   0 .. len(declared) |> filter(i=>!json-object-has?(declared[i],"text")) |> map(i=>json-node-object([fctw-s("id",docs[i][0]),fctw-s("path",docs[i][1]),fctw-n("bytes",len(docs[i][2]))]));
  }
  def fctw-docs(node,command,input,started,docs) = fat-wire-error(docs) != "" ? fat-wire-refusal(fat-wire-error(docs)) : fctw-admitted(command,input,fat-wire-value(docs),fctw-files(node,fat-wire-value(docs)),host_monotonic_ms() - started);
  def fctw-admitted(command,input,docs,files,elapsed) = nil?(files) ? fat-wire-render(fat-command(docs,fat-wire-value(command),fat-wire-value(input))) : {
   let resources=json-node-object([fctw-s("scope","native-file-admission"),fctw-n("file_snapshots",len(files)),json-node-pair("files",json-node-array(files)),fctw-n("elapsed_ms",elapsed)]);
   fb_record(resources,"form-cli-tools.bml",0);
   fctw-result(fat-command(docs,fat-wire-value(command),fat-wire-value(input)),resources);
  };
  def fctw-result(result,resources) = json-emit(oh-set(fat-wire-result-node(result),"resources",resources));
 }
}
