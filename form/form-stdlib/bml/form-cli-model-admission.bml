// Admission scratch width and the selected prefill route share one authority.
// preludes: form-stdlib/core.fk
section [form.bml] {
    class FormCliModelAdmission {
        field ModelAdmissionSpan = 64;
        def fcma-span(positions) = positions <= 0 ? 1 : positions < ModelAdmissionSpan() ? positions : ModelAdmissionSpan();
    }
    0;
}
