// Admission scratch width and the selected prefill route share one authority.
// preludes: form-stdlib/core.fk
section [form.bml] {
    class FormCliModelAdmission {
        field ModelAdmissionSpan = 64;
        def fcma-span(positions) = if le(positions, 0) then 1 else if lt(positions, ModelAdmissionSpan()) then positions else ModelAdmissionSpan();
    }
    0;
}
