// Admission scratch width and the selected prefill route share one authority.
import form-stdlib/core.fk;
section [form.bml] {
    class FormCliModelAdmission {
        field ModelAdmissionSpan = 64;
        field ModelAdmissionPrefillSpan = 1024;
        def fcma-span(positions) = positions <= 0 ? 1 : positions < ModelAdmissionSpan() ? positions : ModelAdmissionSpan();
        def fcma-floor(positions) = fcma-span(positions);
        def fcma-prefill-span(positions) = positions <= 0 ? 1 : positions < ModelAdmissionPrefillSpan() ? positions : ModelAdmissionPrefillSpan();
        def fcma-lease-fixed(ask,positions) { let span=fcma-span(positions); [span,ask(span)]; }
        // Keep the full prompt. Reduce only scratch width when its lease does
        // not fit; an unsuccessful ask owns no buffers or memory lease.
        def fcma-lease-span(ask,positions) = fcma-lease-span-at(ask,fcma-prefill-span(positions),fcma-floor(positions));
        def fcma-lease-span-at(ask,span,floor) {
            let verdict = ask(span);
            verdict[0] == 1 || span <= floor || verdict[1] != "capacity" ? [span,verdict] : fcma-lease-span-at(ask,max2(floor,span / 2),floor);
        }
    }
    0;
}
