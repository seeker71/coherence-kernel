//////////////////////////////////////////////////////////////////////
//
// source-compiler-typed-emission.bml -- scannerless source emission through
// a structurally-admitted Program Image.
//
// The only raw PIF in this path is the final executor projection.  It is
// derived from, and remains beside, the typed NodeID envelope; callers cannot
// supply a raw image to this authority.
//
// preludes: form-stdlib/core.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/defdata.fk form-stdlib/form-definition-language.fk form-stdlib/source-compiler-emission.fk form-stdlib/bml/program-image-typed-emission.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class SourceCompilerTypedEmission [public, native, reusable] {
        field Version = "source-compiler-typed-emission-v1";
        field Tag = "source-compiler-typed-emission";
        field StatusReady = "typed-emission-ready";
        field StatusInvestigate = "investigate";
        field StatusRefused = "refused";
        field ReasonReady = "scannerless-grammar-and-typed-image-admitted";
        field ReasonParseFailed = "form-definition-parse-failed";
        field ReasonLoweringRejected = "lowering-not-form-floor";
        field ReasonTypedImageRejected = "typed-program-image-rejected";
        field ReasonNestedMalformed = "nested-emission-malformed";
        field ReasonNestedRefused = "nested-emission-refused";
        field ReasonNestedInvestigate = "nested-emission-investigate";
        field FormFloor = "form-top-level-source-floor";
        thought pattern = list("scannerless-bmf", "typed-nodeid-image", "single-executor-projection", "nested-emission-receipt");

        // row = (tag surface module lowering typed-envelope raw-pif table-text
        //        nested-emission status reason).  `nothing` means the stage
        // has not happened; it is distinct from the integer 0 and an empty
        // table, neither of which is a usable program image here.
        def scte-row(surface, module, lowering, typedEnvelope, rawPif, tableText, emission, status, reason) = list(Tag(), surface, module, lowering, typedEnvelope, rawPif, tableText, emission, status, reason);
        def scte-row?(row) = if nothing?(row) then 0 else if not(eq(len(row), 10)) then 0 else str_eq(nth(row, 0), Tag());
        def scte-row-surface(row) = nth(row, 1);
        def scte-row-module(row) = nth(row, 2);
        def scte-row-lowering(row) = nth(row, 3);
        def scte-row-typed-envelope(row) = nth(row, 4);
        def scte-row-raw-pif(row) = nth(row, 5);
        def scte-row-table-text(row) = nth(row, 6);
        def scte-row-emission(row) = nth(row, 7);
        def scte-row-status(row) = nth(row, 8);
        def scte-row-reason(row) = nth(row, 9);
        def scte-ready?(row) = if scte-row?(row) then str_eq(scte-row-status(row), StatusReady()) else 0;
        def scte-investigate?(row) = if scte-row?(row) then str_eq(scte-row-status(row), StatusInvestigate()) else 0;
        def scte-refused?(row) = if scte-row?(row) then str_eq(scte-row-status(row), StatusRefused()) else 0;

        def scte-no-lowering() = list(Tag(), "no-lowering", nothing(), nothing());
        def scte-lowering-form-floor?(lowering) = if not(eq(len(lowering), 5)) then 0 else str_eq(fdl-lowering-kind(lowering), FormFloor());
        def scte-refusal(surface, module, lowering, typedEnvelope, reason) = scte-row(surface, module, lowering, typedEnvelope, nothing(), nothing(), nothing(), StatusRefused(), reason);

        def scte-from-emission(surface, module, lowering, typedEnvelope, rawPif, tableText, emission) {
            if not(sce-emission?(emission)) then scte-row(surface, module, lowering, typedEnvelope, rawPif, tableText, emission, StatusRefused(), ReasonNestedMalformed()) else if sce-emitted?(emission) then scte-row(surface, module, lowering, typedEnvelope, rawPif, tableText, emission, StatusReady(), ReasonReady()) else if sce-refused?(emission) then scte-row(surface, module, lowering, typedEnvelope, rawPif, tableText, emission, StatusRefused(), ReasonNestedRefused()) else scte-row(surface, module, lowering, typedEnvelope, rawPif, tableText, emission, StatusInvestigate(), ReasonNestedInvestigate());
        }

        def scte-from-admitted-image(surface, module, lowering, compileEnvelope, compileOutput, typedEnvelope, dylib) {
            let rawPif = pitte-raw-envelope(typedEnvelope);
            let tableText = pitte-envelope-table-text(typedEnvelope);
            let emission = sce-emission-from-compile(compileEnvelope, compileOutput, rawPif, tableText, dylib);
            scte-from-emission(surface, module, lowering, typedEnvelope, rawPif, tableText, emission);
        }
        def scte-from-parsed-module(surface, module, compileEnvelope, compileOutput, typedEnvelope, dylib) {
            let lowering = fdl-lowering(module);
            if not(scte-lowering-form-floor?(lowering)) then scte-refusal(surface, module, lowering, typedEnvelope, ReasonLoweringRejected()) else if not(pitte-envelope-valid?(typedEnvelope)) then scte-refusal(surface, module, lowering, typedEnvelope, ReasonTypedImageRejected()) else scte-from-admitted-image(surface, module, lowering, compileEnvelope, compileOutput, typedEnvelope, dylib);
        }
        def scte-from-form-definition-source(surface, compileEnvelope, compileOutput, typedEnvelope, dylib) {
            let module = fdl-parse(surface);
            if not(fdl-ok?(module)) then scte-refusal(surface, module, scte-no-lowering(), typedEnvelope, ReasonParseFailed()) else scte-from-parsed-module(surface, module, compileEnvelope, compileOutput, typedEnvelope, dylib);
        }

        def scte-version() = Version();
    }
    0;
}
