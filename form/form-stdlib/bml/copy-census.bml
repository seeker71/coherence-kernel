//////////////////////////////////////////////////////////////////////
// copy-census.bml — the body looks for its own copies.
//
// Urs, 2026-09-10: "there are copies and we did not detect it? what
// other copies do we have?"
//
// Three times in one day the same disease: nine private names for one
// int-to-float promotion; one float_to_str living in core.fk and again
// in fourth-shim.fk; a band inlining the engine AND the reference it
// checks against, so it proved its two copies agree with each other and
// not with the tree. Each was found by a hand grepping after the fact,
// because the body has no organ that looks. It has a lens for clouded
// words, a lens for kernel length, a lens for what a pass costs — and
// none for the thing that has bitten it most often (corpus row 1420).
//
// Two censuses, because copies wear two shapes:
//
//   same-body   one definition written twice under different names.
//               The nine-names disease. Found by normalizing away the
//               NAME and comparing what is left.
//   same-name   one name defined in more than one file. The mirror
//               disease: float_to_str, the bp table, the jit ABI. Not
//               wrong by itself — a shim SHOULD mirror — but every one
//               of them is a place where drift is silent.
//
// Neither is a ban. A census is attention, and the reader decides —
// the same footing as observe/voice-frequency.fk.
// The prefix is cpc-, not cc-, because the census caught its author first: cc-line-end
// and cc-cat already stood in cell-channel.bml, and a cell preluding both would have
// taken one silently. The reflex that would have caught it — grep the body's frequency of
// a name BEFORE using it — is written down in this body and I skipped it (row 1420 owncopy).
// preludes: form/form-stdlib/core.fk form/form-stdlib/str-byte-at.fk form/form-stdlib/form-fs.fk form/form-stdlib/bml/number.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormCopyCensus {
        // ---- which files carry definitions ------------------------------------------
        def cpc-ext-ok?(p) {
            let n = str_len(p);
            if and(ge(n, 3), str_eq(substring(p, sub(n, 3), n), ".fk")) then 1
            else if and(ge(n, 4), str_eq(substring(p, sub(n, 4), n), ".bml")) then 1 else 0;
        }
        // artefacts and caches are not the body's writing
        def cpc-skip?(name) = if or(str_eq(name, ".git"), or(str_eq(name, ".cache"), or(str_eq(name, "node_modules"), str_eq(name, ".hearth")))) then 1 else 0;

        def cpc-join(d, n) = if str_eq(d, "") then n else str_concat(d, str_concat("/", n));
        def cpc-walk(dir, acc) = cpc-walk-go(dir, fs_list(dir), acc);
        def cpc-walk-go(dir, names, acc) {
            if eq(len(names), 0) then acc else cpc-walk-one(dir, head(names), tail(names), acc);
        }
        def cpc-walk-one(dir, name, rest, acc) {
            let p = cpc-join(dir, name);
            let acc2 = if eq(cpc-skip?(name), 1) then acc
                       else if eq(fs_is_dir(p), 1) then cpc-walk(p, acc)
                       else if eq(cpc-ext-ok?(p), 1) then cons(p, acc) else acc;
            cpc-walk-go(dir, rest, acc2);
        }

        // ---- one definition, normalized so only its SHAPE is left -------------------
        // whitespace runs collapse to one space, so indentation and line breaks are not
        // identity; the name is cut away, so two names over one body meet as equals
        def cpc-ws?(b) = if or(eq(b, 32), or(eq(b, 9), or(eq(b, 10), eq(b, 13)))) then 1 else 0;

        // NOTHING HERE BUILDS A STRING. A squashed copy assembled one str_concat per byte
        // is O(n^2) in the text it reads — the exact wound healed in observe/voice-frequency.fk
        // hours before this file was written, and a census of 27 MB would never have finished.
        // So the shape is read in place: a fingerprint folded over the non-whitespace bytes in
        // one pass with no allocation, and an equality that walks both spans at once skipping
        // whitespace runs. Both are O(n) and neither leaves anything behind.
        def cpc-next-sig(s, i, n) = if ge(i, n) then i else if eq(cpc-ws?(str_byte_at(s, i)), 1) then cpc-next-sig(s, add(i, 1), n) else i;
        // fold: h = h*131 + byte, kept inside the range a tagged int carries exactly
        def cpc-fold(s, i, n, h) {
            let j = cpc-next-sig(s, i, n);
            if ge(j, n) then h else cpc-fold(s, add(j, 1), n, mod(add(mul(h, 131), str_byte_at(s, j)), 1073741789));
        }
        def cpc-fingerprint(s, from, to) = cpc-fold(s, from, to, 7);
        // how many bytes actually carry shape — a second cheap discriminator
        def cpc-sig-len(s, i, n, c) {
            let j = cpc-next-sig(s, i, n);
            if ge(j, n) then c else cpc-sig-len(s, add(j, 1), n, add(c, 1));
        }
        // whitespace-insensitive equality over two spans of two texts, one pass, no copy
        def cpc-same?(a, ai, aj, b, bi, bj) {
            let x = cpc-next-sig(a, ai, aj);
            let y = cpc-next-sig(b, bi, bj);
            if and(ge(x, aj), ge(y, bj)) then 1
            else if or(ge(x, aj), ge(y, bj)) then 0
            else if eq(str_byte_at(a, x), str_byte_at(b, y)) then cpc-same?(a, add(x, 1), aj, b, add(y, 1), bj) else 0;
        }
        // ---- reading definitions out of a file --------------------------------------
        // Parens inside string literals and line comments are not structure. A balancer
        // that counts them swallows whole files, which is the .fk pre-check's own known
        // wound, so both are stepped over here rather than counted.
        def cpc-ident?(b) = if or(and(ge(b, 97), le(b, 122)), or(and(ge(b, 65), le(b, 90)), or(and(ge(b, 48), le(b, 57)), or(eq(b, 45), or(eq(b, 95), or(eq(b, 63), eq(b, 33))))))) then 1 else 0;
        def cpc-ident-end(s, i, n) = if ge(i, n) then i else if eq(cpc-ident?(str_byte_at(s, i)), 1) then cpc-ident-end(s, add(i, 1), n) else i;
        def cpc-quote-end(s, i, n) {
            if ge(i, n) then i
            else if eq(str_byte_at(s, i), 92) then cpc-quote-end(s, add(i, 2), n)
            else if eq(str_byte_at(s, i), 34) then add(i, 1) else cpc-quote-end(s, add(i, 1), n);
        }
        def cpc-line-end(s, i, n) = if ge(i, n) then i else if eq(str_byte_at(s, i), 10) then i else cpc-line-end(s, add(i, 1), n);
        // from the byte after an open paren to the byte after its match
        def cpc-paren-end(s, i, n, d) {
            if ge(i, n) then i else cpc-paren-at(s, i, n, d, str_byte_at(s, i));
        }
        def cpc-paren-at(s, i, n, d, b) {
            if eq(b, 34) then cpc-paren-end(s, cpc-quote-end(s, add(i, 1), n), n, d)
            else if eq(b, 59) then cpc-paren-end(s, cpc-line-end(s, i, n), n, d)
            else if eq(b, 40) then cpc-paren-end(s, add(i, 1), n, add(d, 1))
            else if eq(b, 41) then if le(d, 1) then add(i, 1) else cpc-paren-end(s, add(i, 1), n, sub(d, 1))
            else cpc-paren-end(s, add(i, 1), n, d);
        }
        // a .bml definition runs to the `;` that closes it at brace depth 0
        def cpc-bml-end(s, i, n, d) {
            if ge(i, n) then i else cpc-bml-at(s, i, n, d, str_byte_at(s, i));
        }
        def cpc-bml-at(s, i, n, d, b) {
            if eq(b, 34) then cpc-bml-end(s, cpc-quote-end(s, add(i, 1), n), n, d)
            else if eq(b, 123) then cpc-bml-end(s, add(i, 1), n, add(d, 1))
            else if eq(b, 125) then if le(d, 1) then add(i, 1) else cpc-bml-end(s, add(i, 1), n, sub(d, 1))
            else if and(eq(b, 59), eq(d, 0)) then add(i, 1)
            else cpc-bml-end(s, add(i, 1), n, d);
        }

        // a row is (name fingerprint from to) — the span begins AFTER the name, so two
        // names over one body meet as equals
        def cpc-row(s, name, from, to) = list(name, cpc-fingerprint(s, from, to), from, to, cpc-sig-len(s, from, to, 0));
        def cpc-r-name(r) = nth(r, 0);
        def cpc-r-fp(r) = nth(r, 1);
        def cpc-r-from(r) = nth(r, 2);
        def cpc-r-to(r) = nth(r, 3);
        def cpc-r-len(r) = nth(r, 4);

        def cpc-fk-defs(s, i, n, acc) {
            let at = str_find(s, "(defn ", i);
            if lt(at, 0) then acc else cpc-fk-one(s, at, n, acc);
        }
        def cpc-fk-one(s, at, n, acc) {
            let ns = add(at, 6);
            let ne = cpc-ident-end(s, ns, n);
            let en = cpc-paren-end(s, add(at, 1), n, 1);
            cpc-fk-defs(s, add(at, 6), n, if ge(ne, en) then acc else cons(cpc-row(s, substring(s, ns, ne), ne, sub(en, 1)), acc));
        }
        def cpc-bml-defs(s, i, n, acc) {
            let at = str_find(s, "def ", i);
            if lt(at, 0) then acc else cpc-bml-one(s, at, n, acc);
        }
        def cpc-bml-one(s, at, n, acc) {
            let ns = add(at, 4);
            let ne = cpc-ident-end(s, ns, n);
            let en = cpc-bml-end(s, ne, n, 0);
            cpc-bml-defs(s, add(at, 4), n, if ge(ne, en) then acc else cons(cpc-row(s, substring(s, ns, ne), ne, en), acc));
        }
        def cpc-defs-of(s, path) {
            let n = str_len(s);
            if eq(cpc-bml?(path), 1) then cpc-bml-defs(s, 0, n, list()) else cpc-fk-defs(s, 0, n, list());
        }
        // one statement per line: written on one line, this block returned the `let`'s value
        // (the path length, 31) instead of the test, and cpc-defs-of then read every .bml with
        // the .fk reader and found nothing, silently. The brace trap answers, it does not refuse.
        def cpc-bml?(p) {
            let n = str_len(p);
            if and(ge(n, 4), str_eq(substring(p, sub(n, 4), n), ".bml")) then 1 else 0;
        }
        // ---- the census -------------------------------------------------------------
        // A row carries what it takes to judge a copy without going back to disk: the
        // name, where it lives, the shape's fingerprint and length, and the shape itself.
        def cpc-frow(name, path, fp, sl, text) = list(name, path, fp, sl, text);
        def cpc-f-name(r) = nth(r, 0);
        def cpc-f-path(r) = nth(r, 1);
        def cpc-f-fp(r) = nth(r, 2);
        def cpc-f-sl(r) = nth(r, 3);
        def cpc-f-text(r) = nth(r, 4);

        def cpc-file-rows(path) {
            let s = read_file(path);
            cpc-file-rows-go(s, path, cpc-defs-of(s, path), list());
        }
        def cpc-file-rows-go(s, path, ds, acc) {
            if eq(len(ds), 0) then acc else cpc-file-rows-one(s, path, head(ds), tail(ds), acc);
        }
        def cpc-file-rows-one(s, path, d, rest, acc) {
            let t = substring(s, cpc-r-from(d), cpc-r-to(d));
            cpc-file-rows-go(s, path, rest, cons(cpc-frow(cpc-r-name(d), path, cpc-r-fp(d), cpc-r-len(d), t), acc));
        }

        // 512 buckets so no bucket grows long enough for the table's linear scan to bite
        def cpc-bucket-of(fp) = int_to_str(mod(fp, 512));
        def cpc-add(tab, r) {
            let k = cpc-bucket-of(cpc-f-fp(r));
            record_set(tab, k, cons(r, cpc-bucket(tab, k)));
        }
        def cpc-bucket(tab, k) {
            let v = record_get(tab, k);
            if eq(v, 0) then list() else v;
        }
        def cpc-add-all(tab, rs) = if eq(len(rs), 0) then tab else cpc-add-all(cpc-add(tab, head(rs)), tail(rs));
        def cpc-scan(tab, paths) = if eq(len(paths), 0) then tab else cpc-scan(cpc-add-all(tab, cpc-file-rows(head(paths))), tail(paths));
        def cpc-census(paths) = cpc-scan(record_new(0), paths);

        // ---- reading the families back ----------------------------------------------
        // two rows are one shape when the cheap keys agree AND the shapes actually match
        def cpc-twin?(a, b) = if and(eq(cpc-f-fp(a), cpc-f-fp(b)), eq(cpc-f-sl(a), cpc-f-sl(b))) then cpc-same?(cpc-f-text(a), 0, str_len(cpc-f-text(a)), cpc-f-text(b), 0, str_len(cpc-f-text(b))) else 0;
        def cpc-twins-of(r, rs, acc) {
            if eq(len(rs), 0) then acc
            else cpc-twins-of(r, tail(rs), if eq(cpc-twin?(r, head(rs)), 1) then cons(head(rs), acc) else acc);
        }
        // a family is worth a reader's attention when the SAME shape wears MORE THAN ONE name
        def cpc-names-differ?(r, fam) = if eq(len(fam), 0) then 0 else if str_eq(cpc-f-name(r), cpc-f-name(head(fam))) then cpc-names-differ?(r, tail(fam)) else 1;
        def cpc-not-twins(r, rs, acc) {
            if eq(len(rs), 0) then acc
            else cpc-not-twins(r, tail(rs), if eq(cpc-twin?(r, head(rs)), 1) then acc else cons(head(rs), acc));
        }
        def cpc-fams(rs, acc) {
            if eq(len(rs), 0) then acc else cpc-fams-one(head(rs), tail(rs), acc);
        }
        def cpc-fams-one(r, rest, acc) {
            let tw = cpc-twins-of(r, rest, list());
            let rem = cpc-not-twins(r, rest, list());
            cpc-fams(rem, if and(gt(len(tw), 0), eq(cpc-names-differ?(r, tw), 1)) then cons(cons(r, tw), acc) else acc);
        }
        def cpc-all-fams(tab, i, acc) {
            if ge(i, 512) then acc else cpc-all-fams(tab, add(i, 1), cpc-cat(cpc-fams(cpc-bucket(tab, int_to_str(i)), list()), acc));
        }
        def cpc-cat(xs, ys) = if eq(len(xs), 0) then ys else cpc-cat(tail(xs), cons(head(xs), ys));
        def cpc-families(tab) = cpc-all-fams(tab, 0, list());

        // ---- the same-name census: one name, more than one file ---------------------
        def cpc-name-add(tab, r) {
            let k = cpc-f-name(r);
            record_set(tab, k, cpc-name-paths(tab, k, cpc-f-path(r)));
        }
        def cpc-name-paths(tab, k, p) {
            let v = record_get(tab, k);
            let cur = if eq(v, 0) then list() else v;
            if eq(cpc-has-path?(cur, p), 1) then cur else cons(p, cur);
        }
        def cpc-has-path?(ps, p) = if eq(len(ps), 0) then 0 else if str_eq(head(ps), p) then 1 else cpc-has-path?(tail(ps), p);
        def cpc-names-add-all(tab, rs) = if eq(len(rs), 0) then tab else cpc-names-add-all(cpc-name-add(tab, head(rs)), tail(rs));
        def cpc-names-scan(tab, paths) = if eq(len(paths), 0) then tab else cpc-names-scan(cpc-names-add-all(tab, cpc-file-rows(head(paths))), tail(paths));
        def cpc-name-census(paths) = cpc-names-scan(record_new(0), paths);

        // ---- saying it -------------------------------------------------------------
        def cpc-fam-names(fam) = if eq(len(fam), 0) then "" else str_concat(cpc-f-name(head(fam)), str_concat(if eq(len(tail(fam)), 0) then "" else ", ", cpc-fam-names(tail(fam))));
        def cpc-fam-line(fam) = str_concat("  x", str_concat(int_to_str(len(fam)), str_concat("  ", str_concat(cpc-fam-names(fam), str_concat("   [", str_concat(cpc-clip(cpc-f-text(head(fam)), 96), "]"))))));
        def cpc-clip(s, n) = if le(str_len(s), n) then s else str_concat(substring(s, 0, n), " ...");
        def cpc-say-fams(fs, k) {
            if or(eq(len(fs), 0), le(k, 0)) then 0 else cpc-say-one(head(fs), tail(fs), k);
        }
        def cpc-say-one(f, rest, k) {
            print_str(cpc-fam-line(f));
            cpc-say-fams(rest, sub(k, 1));
        }
        // how many definitions the families hold beyond one copy each — the count that
        // says what the body is carrying twice
        // an accessor like `(r) = nth(r, 3)` lands in many families by coincidence of INDEX,
        // not by anyone copying anything. Substance separates the two: how many bytes of
        // actual shape a definition carries. Below about two dozen there is nothing to have
        // copied. The census shows both, because deciding which is which is the reader's.
        def cpc-weighty(fs, min-sl, acc) {
            if eq(len(fs), 0) then acc
            else cpc-weighty(tail(fs), min-sl, if ge(cpc-f-sl(head(head(fs))), min-sl) then cons(head(fs), acc) else acc);
        }
        // ---- reading the same-name census back ----------------------------------------
        def cpc-name-keys(tab) = record_keys(tab);
        def cpc-name-multi(tab, ks, acc) {
            if eq(len(ks), 0) then acc
            else cpc-name-multi(tab, tail(ks), if gt(len(cpc-bucket(tab, head(ks))), 1) then cons(list(head(ks), cpc-bucket(tab, head(ks))), acc) else acc);
        }
        def cpc-multi-names(tab) = cpc-name-multi(tab, cpc-name-keys(tab), list());
        def cpc-mn-line(e) = str_concat("  x", str_concat(int_to_str(len(nth(e, 1))), str_concat("  ", str_concat(nth(e, 0), str_concat("   ", cpc-clip(cpc-paths-text(nth(e, 1)), 110))))));
        def cpc-paths-text(ps) = if eq(len(ps), 0) then "" else str_concat(head(ps), str_concat(if eq(len(tail(ps)), 0) then "" else "  ", cpc-paths-text(tail(ps))));
        def cpc-say-names(es, k) {
            if or(eq(len(es), 0), le(k, 0)) then 0 else cpc-say-name-one(head(es), tail(es), k);
        }
        def cpc-say-name-one(e, rest, k) {
            print_str(cpc-mn-line(e));
            cpc-say-names(rest, sub(k, 1));
        }
        def cpc-extra(fs) = if eq(len(fs), 0) then 0 else add(sub(len(head(fs)), 1), cpc-extra(tail(fs)));
        0;
    }
    0;
}
