//////////////////////////////////////////////////////////////////////
// copy-census.bml — the body looks for its own copies.
//
// Urs, 2026-09-10: "there are copies and we did not detect it? what
// other copies do we have?"
//
// Three times in one day the same disease: nine private names for one
// int-to-float promotion; one float_to_str living in core.fk and again
// in fourth-shim.fk; a band inlining the engine AND the reference it
// checks against, so it proved its two copies agree with each other and
// not with the tree. Each was found by a hand grepping after the fact,
// because the body has no organ that looks. It has a lens for clouded
// words, a lens for kernel length, a lens for what a pass costs — and
// none for the thing that has bitten it most often (corpus row 1420).
//
// Two censuses, because copies wear two shapes:
//
//   same-body   one definition written twice under different names.
//               The nine-names disease. Found by normalizing away the
//               NAME and comparing what is left.
//   same-name   one name defined in more than one file. The mirror
//               disease: float_to_str, the bp table, the jit ABI. Not
//               wrong by itself — a shim SHOULD mirror — but every one
//               of them is a place where drift is silent.
//
// Neither is a ban. A census is attention, and the reader decides —
// the same footing as observe/voice-frequency.fk.
// The prefix is cpc-, not cc-, because the census caught its author first: cc-line-end
// and cc-cat already stood in cell-channel.bml, and a cell preluding both would have
// taken one silently. The reflex that would have caught it — grep the body's frequency of
// a name BEFORE using it — is written down in this body and I skipped it (row 1420 owncopy).
import form/form-stdlib/core.fk;
import form/form-stdlib/str-byte-at.fk;
import form/form-stdlib/form-fs.fk;
import form/form-stdlib/bml/number.bml;
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormCopyCensus {
        // ---- which files carry definitions ------------------------------------------
        def cpc-ext-ok?(p) {
            let n = len(p);
            if ((n >= 3) && ((String) substring(p, (n - 3), n) == ".fk")) then 1
            else if ((n >= 4) && ((String) substring(p, (n - 4), n) == ".bml")) then 1 else 0;
        }
        // artefacts and caches are not the body's writing
        def cpc-skip?(name) = if (((String) name == ".git") || (((String) name == ".cache") || (((String) name == "node_modules") || ((String) name == ".hearth")))) then 1 else 0;

        def cpc-join(d, n) = if ((String) d == "") then n else (d + ("/" + n));
        def cpc-walk(dir, acc) = cpc-walk-go(dir, fs_list(dir), acc);
        def cpc-walk-go(dir, names, acc) {
            if ((Comparable) len(names) == 0) then acc else cpc-walk-one(dir, names[0], names[1:], acc);
        }
        def cpc-walk-one(dir, name, rest, acc) {
            let p = cpc-join(dir, name);
            let acc2 = if ((Comparable) cpc-skip?(name) == 1) then acc
                       else if ((Comparable) fs_is_dir(p) == 1) then cpc-walk(p, acc)
                       else if ((Comparable) cpc-ext-ok?(p) == 1) then cons(p, acc) else acc;
            cpc-walk-go(dir, rest, acc2);
        }

        // ---- one definition, normalized so only its SHAPE is left -------------------
        // whitespace runs collapse to one space, so indentation and line breaks are not
        // identity; the name is cut away, so two names over one body meet as equals
        def cpc-ws?(b) = if (((Comparable) b == 32) || (((Comparable) b == 9) || (((Comparable) b == 10) || ((Comparable) b == 13)))) then 1 else 0;

        // NOTHING HERE BUILDS A STRING. A squashed copy assembled one str_concat per byte
        // is O(n^2) in the text it reads — the exact wound healed in observe/voice-frequency.fk
        // hours before this file was written, and a census of 27 MB would never have finished.
        // So the shape is read in place: a fingerprint folded over the non-whitespace bytes in
        // one pass with no allocation, and an equality that walks both spans at once skipping
        // whitespace runs. Both are O(n) and neither leaves anything behind.
        def cpc-next-sig(s, i, n) = if (i >= n) then i else if ((Comparable) cpc-ws?(str_byte_at(s, i)) == 1) then cpc-next-sig(s, (i + 1), n) else i;
        // fold: h = h*131 + byte, kept inside the range a tagged int carries exactly
        def cpc-fold(s, i, n, h) {
            let j = cpc-next-sig(s, i, n);
            if (j >= n) then h else cpc-fold(s, (j + 1), n, (((h * 131) + str_byte_at(s, j)) % 1073741789));
        }
        def cpc-fingerprint(s, from, to) = cpc-fold(s, from, to, 7);
        // how many bytes actually carry shape — a second cheap discriminator
        def cpc-sig-len(s, i, n, c) {
            let j = cpc-next-sig(s, i, n);
            if (j >= n) then c else cpc-sig-len(s, (j + 1), n, (c + 1));
        }
        // whitespace-insensitive equality over two spans of two texts, one pass, no copy
        def cpc-same?(a, ai, aj, b, bi, bj) {
            let x = cpc-next-sig(a, ai, aj);
            let y = cpc-next-sig(b, bi, bj);
            if ((x >= aj) && (y >= bj)) then 1
            else if ((x >= aj) || (y >= bj)) then 0
            else if ((Comparable) str_byte_at(a, x) == str_byte_at(b, y)) then cpc-same?(a, (x + 1), aj, b, (y + 1), bj) else 0;
        }
        // ---- reading definitions out of a file --------------------------------------
        // Parens inside string literals and line comments are not structure. A balancer
        // that counts them swallows whole files, which is the .fk pre-check's own known
        // wound, so both are stepped over here rather than counted.
        def cpc-ident?(b) = if (((b >= 97) && (b <= 122)) || (((b >= 65) && (b <= 90)) || (((b >= 48) && (b <= 57)) || (((Comparable) b == 45) || (((Comparable) b == 95) || (((Comparable) b == 63) || ((Comparable) b == 33))))))) then 1 else 0;
        def cpc-ident-end(s, i, n) = if (i >= n) then i else if ((Comparable) cpc-ident?(str_byte_at(s, i)) == 1) then cpc-ident-end(s, (i + 1), n) else i;
        def cpc-quote-end(s, i, n) {
            if (i >= n) then i
            else if ((Comparable) str_byte_at(s, i) == 92) then cpc-quote-end(s, (i + 2), n)
            else if ((Comparable) str_byte_at(s, i) == 34) then (i + 1) else cpc-quote-end(s, (i + 1), n);
        }
        def cpc-line-end(s, i, n) = if (i >= n) then i else if ((Comparable) str_byte_at(s, i) == 10) then i else cpc-line-end(s, (i + 1), n);
        // from the byte after an open paren to the byte after its match
        def cpc-paren-end(s, i, n, d) {
            if (i >= n) then i else cpc-paren-at(s, i, n, d, str_byte_at(s, i));
        }
        def cpc-paren-at(s, i, n, d, b) {
            if ((Comparable) b == 34) then cpc-paren-end(s, cpc-quote-end(s, (i + 1), n), n, d)
            else if ((Comparable) b == 59) then cpc-paren-end(s, cpc-line-end(s, i, n), n, d)
            else if ((Comparable) b == 40) then cpc-paren-end(s, (i + 1), n, (d + 1))
            else if ((Comparable) b == 41) then if (d <= 1) then (i + 1) else cpc-paren-end(s, (i + 1), n, (d - 1))
            else cpc-paren-end(s, (i + 1), n, d);
        }
        // a .bml definition runs to the `;` that closes it at brace depth 0
        def cpc-bml-end(s, i, n, d) {
            if (i >= n) then i else cpc-bml-at(s, i, n, d, str_byte_at(s, i));
        }
        def cpc-bml-at(s, i, n, d, b) {
            if ((Comparable) b == 34) then cpc-bml-end(s, cpc-quote-end(s, (i + 1), n), n, d)
            else if ((Comparable) b == 123) then cpc-bml-end(s, (i + 1), n, (d + 1))
            else if ((Comparable) b == 125) then if (d <= 1) then (i + 1) else cpc-bml-end(s, (i + 1), n, (d - 1))
            else if (((Comparable) b == 59) && ((Comparable) d == 0)) then (i + 1)
            else cpc-bml-end(s, (i + 1), n, d);
        }

        // a row is (name fingerprint from to) — the span begins AFTER the name, so two
        // names over one body meet as equals
        def cpc-row(s, name, from, to) = [name, cpc-fingerprint(s, from, to), from, to, cpc-sig-len(s, from, to, 0)];
        def cpc-r-name(r) = r[0];
        def cpc-r-fp(r) = r[1];
        def cpc-r-from(r) = r[2];
        def cpc-r-to(r) = r[3];
        def cpc-r-len(r) = r[4];

        def cpc-fk-defs(s, i, n, acc) {
            let at = str_find(s, "(defn ", i);
            if (at < 0) then acc else cpc-fk-one(s, at, n, acc);
        }
        def cpc-fk-one(s, at, n, acc) {
            let ns = (at + 6);
            let ne = cpc-ident-end(s, ns, n);
            let en = cpc-paren-end(s, (at + 1), n, 1);
            cpc-fk-defs(s, (at + 6), n, if (ne >= en) then acc else cons(cpc-row(s, substring(s, ns, ne), ne, (en - 1)), acc));
        }
        def cpc-bml-defs(s, i, n, acc) {
            let at = str_find(s, "def ", i);
            if (at < 0) then acc else cpc-bml-one(s, at, n, acc);
        }
        def cpc-bml-one(s, at, n, acc) {
            let ns = (at + 4);
            let ne = cpc-ident-end(s, ns, n);
            let en = cpc-bml-end(s, ne, n, 0);
            cpc-bml-defs(s, (at + 4), n, if (ne >= en) then acc else cons(cpc-row(s, substring(s, ns, ne), ne, en), acc));
        }
        def cpc-defs-of(s, path) {
            let n = len(s);
            if ((Comparable) cpc-bml?(path) == 1) then cpc-bml-defs(s, 0, n, []) else cpc-fk-defs(s, 0, n, []);
        }
        def cpc-bml?(p) {
            let n = len(p);
            if ((n >= 4) && ((String) substring(p, (n - 4), n) == ".bml")) then 1 else 0;
        }
        // ---- the census -------------------------------------------------------------
        // A row carries what it takes to judge a copy without going back to disk: the
        // name, where it lives, the shape's fingerprint and length, and the shape itself.
        def cpc-frow(name, path, fp, sl, text) = [name, path, fp, sl, text];
        def cpc-f-name(r) = r[0];
        def cpc-f-path(r) = r[1];
        def cpc-f-fp(r) = r[2];
        def cpc-f-sl(r) = r[3];
        def cpc-f-text(r) = r[4];

        def cpc-file-rows(path) {
            let s = read_file(path);
            cpc-file-rows-go(s, path, cpc-defs-of(s, path), []);
        }
        def cpc-file-rows-go(s, path, ds, acc) {
            if ((Comparable) len(ds) == 0) then acc else cpc-file-rows-one(s, path, ds[0], ds[1:], acc);
        }
        def cpc-file-rows-one(s, path, d, rest, acc) {
            let t = substring(s, cpc-r-from(d), cpc-r-to(d));
            cpc-file-rows-go(s, path, rest, cons(cpc-frow(cpc-r-name(d), path, cpc-r-fp(d), cpc-r-len(d), t), acc));
        }

        // 512 buckets so no bucket grows long enough for the table's linear scan to bite
        def cpc-bucket-of(fp) = (fp % 512).str();
        def cpc-add(tab, r) {
            let k = cpc-bucket-of(cpc-f-fp(r));
            record_set(tab, k, cons(r, cpc-bucket(tab, k)));
        }
        def cpc-bucket(tab, k) {
            let v = record_get(tab, k);
            if ((Comparable) v == 0) then [] else v;
        }
        def cpc-add-all(tab, rs) = if ((Comparable) len(rs) == 0) then tab else cpc-add-all(cpc-add(tab, rs[0]), rs[1:]);
        def cpc-scan(tab, paths) = if ((Comparable) len(paths) == 0) then tab else cpc-scan(cpc-add-all(tab, cpc-file-rows(paths[0])), paths[1:]);
        def cpc-census(paths) = cpc-scan(record_new(0), paths);

        // ---- reading the families back ----------------------------------------------
        // two rows are one shape when the cheap keys agree AND the shapes actually match
        def cpc-twin?(a, b) = if (((Comparable) cpc-f-fp(a) == cpc-f-fp(b)) && ((Comparable) cpc-f-sl(a) == cpc-f-sl(b))) then cpc-same?(cpc-f-text(a), 0, len(cpc-f-text(a)), cpc-f-text(b), 0, len(cpc-f-text(b))) else 0;
        def cpc-twins-of(r, rs, acc) {
            if ((Comparable) len(rs) == 0) then acc
            else cpc-twins-of(r, rs[1:], if ((Comparable) cpc-twin?(r, rs[0]) == 1) then cons(rs[0], acc) else acc);
        }
        // a family is worth a reader's attention when the SAME shape wears MORE THAN ONE name
        def cpc-names-differ?(r, fam) = if ((Comparable) len(fam) == 0) then 0 else if ((String) cpc-f-name(r) == cpc-f-name(fam[0])) then cpc-names-differ?(r, fam[1:]) else 1;
        def cpc-not-twins(r, rs, acc) {
            if ((Comparable) len(rs) == 0) then acc
            else cpc-not-twins(r, rs[1:], if ((Comparable) cpc-twin?(r, rs[0]) == 1) then acc else cons(rs[0], acc));
        }
        def cpc-fams(rs, acc) {
            if ((Comparable) len(rs) == 0) then acc else cpc-fams-one(rs[0], rs[1:], acc);
        }
        def cpc-fams-one(r, rest, acc) {
            let tw = cpc-twins-of(r, rest, []);
            let rem = cpc-not-twins(r, rest, []);
            cpc-fams(rem, if ((len(tw) > 0) && ((Comparable) cpc-names-differ?(r, tw) == 1)) then cons(cons(r, tw), acc) else acc);
        }
        def cpc-all-fams(tab, i, acc) {
            if (i >= 512) then acc else cpc-all-fams(tab, (i + 1), cpc-cat(cpc-fams(cpc-bucket(tab, i.str()), []), acc));
        }
        def cpc-cat(xs, ys) = if ((Comparable) len(xs) == 0) then ys else cpc-cat(xs[1:], cons(xs[0], ys));
        def cpc-families(tab) = cpc-all-fams(tab, 0, []);

        // ---- the same-name census: one name, more than one file ---------------------
        def cpc-name-add(tab, r) {
            let k = cpc-f-name(r);
            record_set(tab, k, cpc-name-paths(tab, k, cpc-f-path(r)));
        }
        def cpc-name-paths(tab, k, p) {
            let v = record_get(tab, k);
            let cur = if ((Comparable) v == 0) then [] else v;
            if ((Comparable) cpc-has-path?(cur, p) == 1) then cur else cons(p, cur);
        }
        def cpc-has-path?(ps, p) = if ((Comparable) len(ps) == 0) then 0 else if ((String) ps[0] == p) then 1 else cpc-has-path?(ps[1:], p);
        def cpc-names-add-all(tab, rs) = if ((Comparable) len(rs) == 0) then tab else cpc-names-add-all(cpc-name-add(tab, rs[0]), rs[1:]);
        def cpc-names-scan(tab, paths) = if ((Comparable) len(paths) == 0) then tab else cpc-names-scan(cpc-names-add-all(tab, cpc-file-rows(paths[0])), paths[1:]);
        def cpc-name-census(paths) = cpc-names-scan(record_new(0), paths);

        // ---- saying it -------------------------------------------------------------
        def cpc-fam-names(fam) = if ((Comparable) len(fam) == 0) then "" else (cpc-f-name(fam[0]) + ((String) (if ((Comparable) len(fam[1:]) == 0) then "" else ", ") + cpc-fam-names(fam[1:])));
        def cpc-fam-line(fam) = ("  x" + (len(fam).str() + ("  " + (cpc-fam-names(fam) + ("   [" + (cpc-clip(cpc-f-text(fam[0]), 96) + "]"))))));
        def cpc-clip(s, n) = if (len(s) <= n) then s else (substring(s, 0, n) + " ...");
        def cpc-say-fams(fs, k) {
            if (((Comparable) len(fs) == 0) || (k <= 0)) then 0 else cpc-say-one(fs[0], fs[1:], k);
        }
        def cpc-say-one(f, rest, k) {
            print_str(cpc-fam-line(f));
            cpc-say-fams(rest, (k - 1));
        }
        // how many definitions the families hold beyond one copy each — the count that
        // says what the body is carrying twice
        // an accessor like `(r) = nth(r, 3)` lands in many families by coincidence of INDEX,
        // not by anyone copying anything. Substance separates the two: how many bytes of
        // actual shape a definition carries. Below about two dozen there is nothing to have
        // copied. The census shows both, because deciding which is which is the reader's.
        def cpc-weighty(fs, min-sl, acc) {
            if ((Comparable) len(fs) == 0) then acc
            else cpc-weighty(fs[1:], min-sl, if (cpc-f-sl(fs[0][0]) >= min-sl) then cons(fs[0], acc) else acc);
        }
        // ---- reading the same-name census back ----------------------------------------
        def cpc-name-keys(tab) = record_keys(tab);
        def cpc-name-multi(tab, ks, acc) {
            if ((Comparable) len(ks) == 0) then acc
            else cpc-name-multi(tab, ks[1:], if (len(cpc-bucket(tab, ks[0])) > 1) then cons([ks[0], cpc-bucket(tab, ks[0])], acc) else acc);
        }
        def cpc-multi-names(tab) = cpc-name-multi(tab, cpc-name-keys(tab), []);
        def cpc-mn-line(e) = ("  x" + (len(e[1]).str() + ("  " + (e[0] + ("   " + cpc-clip(cpc-paths-text(e[1]), 110))))));
        def cpc-paths-text(ps) = if ((Comparable) len(ps) == 0) then "" else (ps[0] + ((String) (if ((Comparable) len(ps[1:]) == 0) then "" else "  ") + cpc-paths-text(ps[1:])));
        def cpc-say-names(es, k) {
            if (((Comparable) len(es) == 0) || (k <= 0)) then 0 else cpc-say-name-one(es[0], es[1:], k);
        }
        def cpc-say-name-one(e, rest, k) {
            print_str(cpc-mn-line(e));
            cpc-say-names(rest, (k - 1));
        }
        def cpc-extra(fs) = if ((Comparable) len(fs) == 0) then 0 else ((len(fs[0]) - 1) + cpc-extra(fs[1:]));
    }
    0;
}
