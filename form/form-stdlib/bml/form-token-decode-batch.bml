// Decode requested token IDs with one bounded vocabulary walk when it saves
// repeated traversal. Keep the reference byte alphabet and text rendering.
// No persistent index, external runtime, model call or generation change.
// preludes: form-stdlib/dsv4-tokenizer.fk
section [form.bml] {
 class FormTokenDecodeBatch {
  // Plan = valid, highest ID, repeated-walk steps, number of requested IDs.
  def ftdb-plan-loop(ids,vocab,last,steps,count) = if nil?(ids) then list(1,last,steps,count) else {
   let id = head(ids);
   if not(str_eq(value_kind(id),"int")) then list(0,-1,0,0) else if or(lt(id,0),ge(id,vocab)) then list(0,-1,0,0) else
    ftdb-plan-loop(tail(ids),vocab,if gt(id,last) then id else last,add(steps,add(id,1)),add(count,1));
  };
  def ftdb-plan(ids,vocab) = if not(str_eq(value_kind(ids),"list")) then list(0,-1,0,0) else ftdb-plan-loop(ids,vocab,-1,0,0);
  // Two traversals of the highest requested prefix leave margin for the map.
  def ftdb-batch?(plan) = and(head(plan),and(gt(nth(plan,3),1),ge(nth(plan,2),mul(2,add(nth(plan,1),1)))));
  def ftdb-mark(ids,wanted) = if nil?(ids) then 0 else {
   record_set(wanted,int_to_str(head(ids)),1); ftdb-mark(tail(ids),wanted);
  };
  def ftdb-scan(src,at,id,last,wanted,found) = if gt(id,last) then 0 else {
   let key = int_to_str(id);
   if eq(record_get(wanted,key),1) then record_set(found,key,tkz-dec-piece-acc(src,at,0,gmt-token-len(src,at),list())) else 0;
   if eq(id,last) then 0 else ftdb-scan(src,gmt-token-next(src,at),add(id,1),last,wanted,found);
  };
  def ftdb-join(ids,found,acc) = if nil?(ids) then reverse(acc) else ftdb-join(tail(ids),found,append(reverse(record_get(found,int_to_str(head(ids)))),acc));
  def ftdb-batch-bytes(src,ids,last) {
   let wanted = record_new(0); let found = record_new(0);
   ftdb-mark(ids,wanted); ftdb-scan(src,gmt-tokens-first(src),0,last,wanted,found);
   ftdb-join(ids,found,list());
  }
  def ftdb-bytes(src,ids) = if nil?(ids) then list() else {
   let plan = ftdb-plan(ids,gmt-vocab-n(src));
   if not(head(plan)) then form_error("token decode requires integer IDs inside the source vocabulary") else
    if ftdb-batch?(plan) then ftdb-batch-bytes(src,ids,nth(plan,1)) else tkz-decode-bytes(src,ids);
  };
  def ftdb-text(src,ids) = tkz-render-acc(ftdb-bytes(src,ids),"");
 }
 0;
}
