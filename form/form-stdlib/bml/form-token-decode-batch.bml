// Decode requested token IDs with one bounded vocabulary walk when it saves
// repeated traversal. Keep the reference byte alphabet and text rendering.
// No persistent index, external runtime, model call or generation change.
// preludes: form-stdlib/dsv4-tokenizer.fk
section [form.bml] {
 class FormTokenDecodeBatch {
  // Plan = valid, highest ID, repeated-walk steps, number of requested IDs.
  def ftdb-plan-loop(ids,vocab,last,steps,count) = nil?(ids) ? list(1,last,steps,count) : {
   let id = head(ids);
   !((String) value_kind(id) == "int") ? list(0,-1,0,0) : (id < 0) || (id >= vocab) ? list(0,-1,0,0) :
    ftdb-plan-loop(tail(ids),vocab,id > last ? id : last,steps + (id + 1),count + 1);
  };
  def ftdb-plan(ids,vocab) = !((String) value_kind(ids) == "list") ? list(0,-1,0,0) : ftdb-plan-loop(ids,vocab,-1,0,0);
  // Two traversals of the highest requested prefix leave margin for the map.
  def ftdb-batch?(plan) = head(plan) && ((plan[3] > 1) && (plan[2] >= (2 * (plan[1] + 1))));
  def ftdb-mark(ids,wanted) = nil?(ids) ? 0 : {
   record_set(wanted,int_to_str(head(ids)),1); ftdb-mark(tail(ids),wanted);
  };
  def ftdb-scan(src,at,id,last,wanted,found) = id > last ? 0 : {
   let key = int_to_str(id);
   (Comparable) record_get(wanted,key) == 1 ? record_set(found,key,tkz-dec-piece-acc(src,at,0,gmt-token-len(src,at),list())) : 0;
   (Comparable) id == last ? 0 : ftdb-scan(src,gmt-token-next(src,at),id + 1,last,wanted,found);
  };
  def ftdb-join(ids,found,acc) = nil?(ids) ? reverse(acc) : ftdb-join(tail(ids),found,append(reverse(record_get(found,int_to_str(head(ids)))),acc));
  def ftdb-batch-bytes(src,ids,last) {
   let wanted = record_new(0); let found = record_new(0);
   ftdb-mark(ids,wanted); ftdb-scan(src,gmt-tokens-first(src),0,last,wanted,found);
   ftdb-join(ids,found,list());
  }
  def ftdb-bytes(src,ids) = nil?(ids) ? list() : {
   let plan = ftdb-plan(ids,gmt-vocab-n(src));
   !head(plan) ? form_error("token decode requires integer IDs inside the source vocabulary") :
    ftdb-batch?(plan) ? ftdb-batch-bytes(src,ids,plan[1]) : tkz-decode-bytes(src,ids);
  };
  def ftdb-text(src,ids) = tkz-render-acc(ftdb-bytes(src,ids),"");
 }
 0;
}
