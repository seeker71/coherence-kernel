// Decode requested token IDs with one bounded vocabulary walk when it saves
// repeated traversal. Keep the reference byte alphabet and text rendering.
// No persistent index, external runtime, model call or generation change.
import form-stdlib/dsv4-tokenizer.fk;
section [form.bml] {
 class FormTokenDecodeBatch {
  // Plan = valid, highest ID, repeated-walk steps, number of requested IDs.
  def ftdb-plan-loop(ids,vocab,last,steps,count) = if nil?(ids) then [1,last,steps,count] else {
   let id = ids[0];
   if (!((String) value_kind(id) == "int")) then [0,-1,0,0] else if ((id < 0) || (id >= vocab)) then [0,-1,0,0] else
    ftdb-plan-loop(ids[1:],vocab,if (id > last) then id else last,(steps + (id + 1)),(count + 1));
  };
  def ftdb-plan(ids,vocab) = if (!((String) value_kind(ids) == "list")) then [0,-1,0,0] else ftdb-plan-loop(ids,vocab,-1,0,0);
  // Two traversals of the highest requested prefix leave margin for the map.
  def ftdb-batch?(plan) = (plan[0] && ((plan[3] > 1) && (plan[2] >= (2 * (plan[1] + 1)))));
  def ftdb-mark(ids,wanted) = if nil?(ids) then 0 else {
   record_set(wanted,ids[0].str(),1); ftdb-mark(ids[1:],wanted);
  };
  def ftdb-scan(src,at,id,last,wanted,found) = if (id > last) then 0 else {
   let key = id.str();
   if ((Comparable) record_get(wanted,key) == 1) then record_set(found,key,tkz-dec-piece-acc(src,at,0,gmt-token-len(src,at),[])) else 0;
   if ((Comparable) id == last) then 0 else ftdb-scan(src,gmt-token-next(src,at),(id + 1),last,wanted,found);
  };
  def ftdb-join(ids,found,acc) = if nil?(ids) then reverse(acc) else ftdb-join(ids[1:],found,append(reverse(record_get(found,ids[0].str())),acc));
  def ftdb-batch-bytes(src,ids,last) {
   let wanted = record_new(0); let found = record_new(0);
   ftdb-mark(ids,wanted); ftdb-scan(src,gmt-tokens-first(src),0,last,wanted,found);
   ftdb-join(ids,found,[]);
  }
  def ftdb-bytes(src,ids) = if nil?(ids) then [] else {
   let plan = ftdb-plan(ids,gmt-vocab-n(src));
   if (!plan[0]) then form_error("token decode requires integer IDs inside the source vocabulary") else
    if ftdb-batch?(plan) then ftdb-batch-bytes(src,ids,plan[1]) else tkz-decode-bytes(src,ids);
  };
  def ftdb-text(src,ids) = tkz-render-acc(ftdb-bytes(src,ids),"");
 }
 0;
}
