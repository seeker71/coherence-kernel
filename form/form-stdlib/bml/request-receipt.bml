// request-receipt.bml — one request's receipt, joined by its id from the ledgers themselves, written as a Form row (no JSON).
//
// Every local voice stream that works for a request names it in its ledger row's who (planner-<id>, planner-guide-<id>,
// planner-lens-*-<id>, planner-repair-<id>, lens-names-<id>, counsel-<id>, repair-manifest-<id>, flow-<id>). rr-data(id) reads
// receipts/local-run-ledger.jsonl, keeps the rows whose who holds the id (a raw line is searched for the id first, so a ledger of
// thousands of rows is not parsed), and answers ONE Form record: each stream's who, model, wall_ms, generated_ids, surprise_micro_nats
// and rent_tokens, the sum of rent_tokens, the asks the flow bracketed with the GPU registry (which tenants used the device during each,
// receipts/ask-tenants.rows) and the request's last row of receipts/local-plan-ledger.jsonl (verdict, kind, repairs, ms, planned).
// rr-line(id) is that record as a form-rows line (frw-emit): {request "frq-..." streams 7 rows [{...}] ...}. The join is the key, never a
// time window; nothing in the line is typed by hand. A stream that carries no id (a request planned before the planner named it) is not
// here: the line counts the streams it found and does not guess one.
// The flow lands the line beside its end row (observe/flow-direct-run.bml, fl-end: receipts/request-receipts.rows), and
// observe/request-receipt-run.bml prints it for any request, or for a whole set ({"set":"answered"}).
// The run ledger it reads is form-rows (receipts/local-run-ledger.rows, written by ledger.bml ledger-append). The plan ledger is still JSON lines
// at its writers (observe/local-plan-run.bml, the flow's end row): that is the one edge left in this file (rr-json-rows, parse-json), named so that
// the next layer can rebase those writers on rows and delete it.
import form-stdlib/bml/form-cli-heal-native-report.bml;
import form-stdlib/bml/form-rows.bml;
section [form.bml] {
 class RequestReceipt {
  def rr-run-ledger() = "receipts/local-run-ledger.rows";
  def rr-plan-ledger() = "receipts/local-plan-ledger.jsonl";
  def rr-tenants-ledger() = "receipts/ask-tenants.rows";
  def rr-lines(path, id) = file_size(path) < 1 ? [] : filter(x => (Comparable) len(trim(x)) != 0 && str_find(x, id, 0) >= 0, split-on(fhn-read(path), "\n"));
  // the JSON edge: a run or plan ledger row, read once into the fields this file uses
  def rr-json-rows(path, id) = map(x => parse-json("receipt-row", x), rr-lines(path, id));
  // a ledger field may be null (a row with no who, a row with no model) or absent (a row from before the field): read it as text or as a number only when it is one
  def rr-str(r, key) { let v = fhn-text(r, key); (String) value_kind(v) == "string" ? v : ""; }
  // the run ledger's rows are form-rows records: the rows whose line holds the id, read back as data
  def rr-run-rows(id) = filter(r => !nothing?(r), map(x => rr-ok-or-nothing(frw-parse(x)), rr-lines(rr-run-ledger(), id)));
  def rr-rstr(r, key) { let v = frw-get(r, key); (String) value_kind(v) == "string" ? v : ""; }
  def rr-rint(r, key) { let v = frw-get(r, key); (String) value_kind(v) == "int" ? v : 0; }
  def rr-mine(rows, id) = filter(r => str_find(rr-rstr(r, "who"), id, 0) >= 0, rows);
  def rr-stream(r) = record_new(0, "who", rr-rstr(r, "who"), "model", rr-rstr(r, "model"), "wall_ms", rr-rint(r, "wall_ms"), "generated_ids", rr-rint(r, "generated_ids"), "surprise_micro_nats", rr-rint(r, "surprise_micro_nats"), "rent_tokens", rr-rint(r, "rent_tokens"));
  def rr-end-row(rows, id) = foldl((acc, r) => (String) rr-str(r, "request") == id ? r : acc, nothing(), rows);
  def rr-end-record(r) = nothing?(r) ? record_new(0) : record_new(0, "verdict", rr-str(r, "verdict"), "kind", rr-str(r, "kind"), "repairs", fhn-count(r, "repairs"), "ms", fhn-count(r, "ms"), "planned", fhn-count(r, "planned"), "rent_tokens", fhn-count(r, "rent_tokens"));
  // the asks the flow bracketed with the GPU registry: one Form row a line, read back as data
  def rr-asks(id) {
   let t = file_size(rr-tenants-ledger()) < 1 ? [] : filter(x => str_find(x, id, 0) >= 0, split-on(fhn-read(rr-tenants-ledger()), "\n"));
   filter(r => !nothing?(r) && (String) value_kind(r) == "record" && (String) frw-get(r, "request") == id, map(x => rr-ok-or-nothing(frw-parse(x)), t));
  }
  def rr-ok-or-nothing(r) = (String) r[0] == "ok" ? r[1] : nothing();
  def rr-ask(r) = record_new(0, "who", frw-get(r, "who"), "wall_ms", frw-get(r, "wall_ms"), "tenants", frw-get(r, "tenants"));
  def rr-data(id) {
   let mine = rr-mine(rr-run-rows(id), id);
   record_new(0, "request", id, "streams", len(mine), "rows", map(r => rr-stream(r), mine), "rent_tokens", foldl((a, r) => a + rr-rint(r, "rent_tokens"), 0, mine), "asks", map(r => rr-ask(r), rr-asks(id)), "end", rr-end-record(rr-end-row(rr-json-rows(rr-plan-ledger(), id), id)));
  }
  def rr-line(id) = frw-emit(rr-data(id));
  // The receipt of a whole set in ONE line, read from the ledgers: every request of learn/local-requests.jsonl whose status is `status` (a row begins {"id":"frq-... on its own line), joined by id as rr-data joins one
  // request. Per request: its id, the streams the keyed ledgers hold for it, their surprise and rent_tokens, and its last plan-ledger end. A request that ended before the ledgers named the request id in each stream has
  // streams 0 here and is counted as keyless, never given a stream. The sums are the ledgers' own.
  def rr-requests() = "learn/local-requests.jsonl";
  def rr-set-ids(status) = map(l => substring(l, 7, str_find(l, "\"", 7)), filter(l => str_find(l, "{\"id\":\"frq-", 0) == 0 && str_find(l, "\"status\":\"" ++ status ++ "\"", 0) >= 0, split-on(fhn-read(rr-requests()), "\n")));
  def rr-surprise(d) = foldl((a, r) => a + frw-get(r, "surprise_micro_nats"), 0, frw-get(d, "rows"));
  def rr-end-text(d) = rr-rstr(frw-get(d, "end"), "verdict") ++ "/" ++ rr-rstr(frw-get(d, "end"), "kind");
  def rr-set-row(d) = record_new(0, "request", frw-get(d, "request"), "streams", frw-get(d, "streams"), "surprise_micro_nats", rr-surprise(d), "rent_tokens", frw-get(d, "rent_tokens"), "end", rr-end-text(d));
  def rr-set-record(status) {
   let ds = map(id => rr-data(id), rr-set-ids(status));
   record_new(0, "set", status, "requests", len(ds), "with_streams", len(filter(d => frw-get(d, "streams") > 0, ds)), "keyless", len(filter(d => frw-get(d, "streams") == 0, ds)), "streams", foldl((a, d) => a + frw-get(d, "streams"), 0, ds), "surprise_micro_nats", foldl((a, d) => a + rr-surprise(d), 0, ds), "rent_tokens", foldl((a, d) => a + frw-get(d, "rent_tokens"), 0, ds), "rows", map(d => rr-set-row(d), ds));
  }
  def rr-set-line(status) = frw-emit(rr-set-record(status));
 }
}
