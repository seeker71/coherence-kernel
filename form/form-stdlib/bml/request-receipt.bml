// request-receipt.bml — one request's receipt, joined by its id from the ledgers themselves.
//
// Every local voice stream that works for a request names it in its ledger row's who (planner-<id>, planner-guide-<id>,
// planner-lens-*-<id>, planner-repair-<id>, lens-names-<id>, counsel-<id>, repair-manifest-<id>, flow-<id>). rr-line(id) reads
// receipts/local-run-ledger.jsonl, keeps the rows whose who holds the id (a raw line is searched for the id first, so a ledger of
// thousands of rows is not parsed), and answers ONE JSON line: each stream's who, model, wall_ms, generated_ids, surprise_micro_nats
// and rent_tokens, the sum of rent_tokens, and the request's last row of receipts/local-plan-ledger.jsonl (verdict, kind, repairs,
// ms, planned). The join is the key, never a time window; nothing in the line is typed by hand. A stream that carries no id (a
// request planned before the planner named it) is not here: the line counts the streams it found and does not guess one.
// The flow lands the line beside its end row (observe/flow-direct-run.bml, fl-end: receipts/request-receipts.jsonl), and
// observe/request-receipt-run.bml prints it for any request.
import form-stdlib/bml/form-cli-heal-native-report.bml;
section [form.bml] {
 class RequestReceipt {
  def rr-run-ledger() = "receipts/local-run-ledger.jsonl";
  def rr-plan-ledger() = "receipts/local-plan-ledger.jsonl";
  def rr-rows(path, id) = file_size(path) < 1 ? [] : map(x => parse-json("receipt-row", x), filter(x => (Comparable) len(trim(x)) != 0 && str_find(x, id, 0) >= 0, split-on(fhn-read(path), "\n")));
  // a ledger field may be null (a row with no who, a row with no model): read it as text only when it is text
  def rr-str(r, key) { let v = fhn-text(r, key); (String) value_kind(v) == "string" ? v : ""; }
  def rr-mine(rows, id) = filter(r => str_find(rr-str(r, "who"), id, 0) >= 0, rows);
  def rr-stream(r) = json-node-object([fhn-s("who", rr-str(r, "who")), fhn-s("model", rr-str(r, "model")), fhn-n("wall_ms", fhn-count(r, "wall_ms")), fhn-n("generated_ids", fhn-count(r, "generated_ids")), fhn-n("surprise_micro_nats", fhn-count(r, "surprise_micro_nats")), fhn-n("rent_tokens", fhn-count(r, "rent_tokens"))]);
  def rr-end(rows, id) = foldl((acc, r) => (String) rr-str(r, "request") == id ? r : acc, nothing(), rows);
  def rr-end-node(r) = nothing?(r) ? json-node-object([]) : json-node-object([fhn-s("verdict", rr-str(r, "verdict")), fhn-s("kind", rr-str(r, "kind")), fhn-n("repairs", fhn-count(r, "repairs")), fhn-n("ms", fhn-count(r, "ms")), fhn-n("planned", fhn-count(r, "planned")), fhn-n("rent_tokens", fhn-count(r, "rent_tokens"))]);
  def rr-line(id) {
   let mine = rr-mine(rr-rows(rr-run-ledger(), id), id);
   let asks = filter(r => (String) rr-str(r, "request") == id, rr-rows(rr-tenants-ledger(), id));
   json-emit(json-node-object([fhn-s("request", id), fhn-n("streams", len(mine)), json-node-pair("rows", json-node-array(map(r => rr-stream(r), mine))), fhn-n("rent_tokens", foldl((a, r) => a + fhn-count(r, "rent_tokens"), 0, mine)), json-node-pair("asks", json-node-array(map(r => rr-ask(r), asks))), json-node-pair("end", rr-end-node(rr-end(rr-rows(rr-plan-ledger(), id), id)))]));
  }
  // The receipt of a whole set in ONE line, read from the ledgers: every request of learn/local-requests.jsonl whose status is `status` (a row begins {"id":"frq-... on its own line), joined by id as rr-line joins one
  // request. Per request: its id, the streams the keyed ledgers hold for it, their surprise and rent_tokens, and its last plan-ledger end. A request that ended before the ledgers named the request id in each stream has
  // streams 0 here and is counted as keyless, never given a stream. The sums are the ledgers' own.
  def rr-requests() = "learn/local-requests.jsonl";
  def rr-set-ids(status) = map(l => substring(l, 7, str_find(l, "\"", 7)), filter(l => str_find(l, "{\"id\":\"frq-", 0) == 0 && str_find(l, "\"status\":\"" ++ status ++ "\"", 0) >= 0, split-on(fhn-read(rr-requests()), "\n")));
  def rr-one(id) { let d = parse-json("receipt-line", rr-line(id)); [id, fhn-count(d, "streams"), fhn-count(d, "rent_tokens"), foldl((a, r) => a + fhn-count(r, "surprise_micro_nats"), 0, json-array-elements(json-object-get(d, "rows"))), json-object-get(d, "end")]; }
  def rr-one-node(x) = json-node-object([fhn-s("request", x[0]), fhn-n("streams", x[1]), fhn-n("surprise_micro_nats", x[3]), fhn-n("rent_tokens", x[2]), fhn-s("end", rr-str(x[4], "verdict") ++ "/" ++ rr-str(x[4], "kind"))]);
  def rr-set-line(status) {
   let xs = map(id => rr-one(id), rr-set-ids(status));
   json-emit(json-node-object([fhn-s("set", status), fhn-n("requests", len(xs)), fhn-n("with_streams", len(filter(x => x[1] > 0, xs))), fhn-n("keyless", len(filter(x => x[1] == 0, xs))), fhn-n("streams", foldl((a, x) => a + x[1], 0, xs)), fhn-n("surprise_micro_nats", foldl((a, x) => a + x[3], 0, xs)), fhn-n("rent_tokens", foldl((a, x) => a + x[2], 0, xs)), json-node-pair("rows", json-node-array(map(x => rr-one-node(x), xs)))]));
  }
  // the asks the flow bracketed with the GPU registry (receipts/ask-tenants.jsonl): which stream, how long, and which tenants used the device during it
  def rr-tenants-ledger() = "receipts/ask-tenants.jsonl";
  def rr-ask(r) = json-node-object([fhn-s("who", rr-str(r, "who")), fhn-n("wall_ms", fhn-count(r, "wall_ms")), json-node-pair("tenants", json-object-has?(r, "tenants") ? json-object-get(r, "tenants") : json-node-array([]))]);
 }
}
