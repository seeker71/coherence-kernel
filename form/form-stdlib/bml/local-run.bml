//////////////////////////////////////////////////////////////////////
// local-run.bml — every local generation, recorded where it happens.
//
// The voice door (form-cli-native-voice.bml fcnv-ask) is the one place every lane asks the model, so it is the one place
// a generation can be counted without a caller remembering to. Each ask lands one row: when, which session asked (the
// host's CLAUDE_CODE_SESSION_ID, or "" when the host's own schedule asked), the lane, how it ended, the IDs the
// prompt and the answer took, and, when the caller measured them, the ask's wall clock and its rates: prefill_tok_s
// (prompt IDs per second of prefill) and decode_tok_s (generated IDs per second of decode). receipts/session-rent-ledger.jsonl
// reads them back per session, so a probe, a draft, a companion turn and an engineering turn all count as the local
// tokens they were. A row written before the rates were fields reads as a row with the rates absent (null).
//
//   local-run-record(result)                                  append the row for one fcnv-ask result; the answer is the ledger's, never the voice's
//   local-run-record-timed(result, wall_ms, prefill_ms, decode_ms)   the same row with the rates the caller's clocks measured (0 ms: that rate absent)
//   local-run-rate(ids, ms)                                   ids per second as a float, or nothing() when either is 0
//   local-run-rows()                                          every row, as typed cells
//   local-run-of(rows, id)                                    the rows one session asked
//////////////////////////////////////////////////////////////////////
// preludes: form-stdlib/bml/ledger.bml form-stdlib/bml/host-fs.bml
section [form.bml] {
 blueprint LocalRun { at_unix_ms: int, session: string, lane: string, status: string, prompt_ids: int, generated_ids: int, model: string, wall_ms: option<int>, prefill_tok_s: option<float>, decode_tok_s: option<float> }
 class LocalRunLedger {
  def lrun-ledger() = "receipts/local-run-ledger.jsonl";
  // the host's session id (CLAUDE_CODE_SESSION_ID) from the environment door, "" when the host's own schedule asked
  def lrun-session() = trim(hfs-env("CLAUDE_CODE_SESSION_ID", ""));
  def lrun-lane(result) = result[10] == "" ? "registry-weights" : "native-metal-lora";
  // a rate is IDs over the seconds they took; a clock that did not run (0 ms) or nothing to count leaves the rate absent
  def local-run-rate(ids, ms) = (ms <= 0) || (ids <= 0) ? nothing() : (ids + 0.0) * 1000.0 / (ms + 0.0);
  def lrun-row(result, wallMs, prefillMs, decodeMs) = LocalRun{at_unix_ms: now_unix_ms(), session: lrun-session(), lane: lrun-lane(result), status: result[0], prompt_ids: result[2], generated_ids: result[3], model: result[4], wall_ms: wallMs <= 0 ? nothing() : wallMs, prefill_tok_s: local-run-rate(result[2], prefillMs), decode_tok_s: local-run-rate(result[3], decodeMs)};
  def local-run-record-timed-at(path, result, wallMs, prefillMs, decodeMs) = ledger-append(path, lrun-row(result, wallMs, prefillMs, decodeMs));
  def local-run-record-timed(result, wallMs, prefillMs, decodeMs) = local-run-record-timed-at(lrun-ledger(), result, wallMs, prefillMs, decodeMs);
  def local-run-record-at(path, result) = local-run-record-timed-at(path, result, 0, 0, 0);
  def local-run-record(result) = local-run-record-at(lrun-ledger(), result);
  def local-run-rows() = ledger-rows(lrun-ledger(), "LocalRun");
  def local-run-of(rows, session) = rows |> filter(row => row-get(row, "session") == session);
 }
 0;
}
