//////////////////////////////////////////////////////////////////////
// form-cli-native-fleet-live.bml -- physical two-seat native witness.
// The runner supplies paths and text; this BML owns admission, one-token
// advancement for each independent KV state, and exact release.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/bml/form-cli-model-fleet.bml form-stdlib/bml/form-cli-peer-direct-quantum.bml

section [form.bml] {
    class FormCliNativeFleetLive {
        field ResultTag = "form-cli-native-fleet-live-result-v1";
        field Alpha = "alpha";
        field Beta = "beta";

        def fcnfl-result(status, reason, fleet, alpha, beta, released) = list(ResultTag(), status, reason, fleet, alpha, beta, released);
        def fcnfl-status(value) = nth(value, 1);
        def fcnfl-reason(value) = nth(value, 2);
        def fcnfl-fleet(value) = nth(value, 3);
        def fcnfl-alpha(value) = nth(value, 4);
        def fcnfl-beta(value) = nth(value, 5);
        def fcnfl-released(value) = nth(value, 6);
        def fcnfl-token-count(quantum) = len(fcdq-ids(quantum));
        def fcnfl-fleet-from-quantums(alpha, beta) = fcmf-fleet(list(fcmf-seat(Alpha(), fcdq-session(alpha)), fcmf-seat(Beta(), fcdq-session(beta))));

        def fcnfl-second-admission(first, path, bootstrap, maxpos) = if str_eq(fcmf-admission-signal(first), "value") then fcmf-open(fcmf-admission-fleet(first), Beta(), path, bootstrap, maxpos) else first;
        def fcnfl-reject(admission, reason) {
            let fleet = fcmf-admission-fleet(admission);
            let released = fcmf-release(fleet);
            fcnfl-result(fcmf-admission-signal(admission), reason, fleet, nothing(), nothing(), released);
        }
        def fcnfl-run-live(fleet, alpha, beta) {
            let advancedAlpha = fcdq-advance(alpha);
            let advancedBeta = fcdq-advance(beta);
            let carried = fcnfl-fleet-from-quantums(advancedAlpha, advancedBeta);
            let released = fcmf-release(carried);
            fcnfl-result("value", "two-native-model-tokens-observed", carried, advancedAlpha, advancedBeta, released);
        }
        def fcnfl-run-admitted(admission, task, gas) {
            let fleet = fcmf-admission-fleet(admission);
            let alphaSeat = fcmf-find-name(fcmf-seats(fleet), Alpha());
            let betaSeat = fcmf-find-name(fcmf-seats(fleet), Beta());
            let alpha = if nothing?(alphaSeat) then nothing() else fcdq-begin(fcmf-seat-session(alphaSeat), "direct-answer", task, gas);
            let beta = if nothing?(betaSeat) then nothing() else fcdq-begin(fcmf-seat-session(betaSeat), "direct-answer", task, gas);
            if not(str_eq(fcmf-admission-signal(admission), "value")) then fcnfl-reject(admission, fcmf-admission-reason(admission)) else if or(nothing?(alpha), nothing?(beta)) then fcnfl-reject(admission, "model-seat-lookup-absent") else if or(eq(fcdq-live?(alpha), 0), eq(fcdq-live?(beta), 0)) then fcnfl-reject(admission, "direct-observation-not-live") else fcnfl-run-live(fleet, alpha, beta);
        }
        def fcnfl-run(pathAlpha, pathBeta, bootstrap, task, maxpos, gas) {
            let first = fcmf-open(fcmf-empty(), Alpha(), pathAlpha, bootstrap, maxpos);
            let second = fcnfl-second-admission(first, pathBeta, bootstrap, maxpos);
            fcnfl-run-admitted(second, task, gas);
        }
    }
    0;
}
