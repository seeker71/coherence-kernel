// Executable behavioral checks for the existing native definition grammar.
// A deliberately narrow, total arithmetic lane: one unary function, no effects,
// recursion, unknown bindings or arbitrary evaluation of model text.
// preludes: form-stdlib/bml/form-cli-code-policy.bml form-stdlib/form-definition-language.fk form-stdlib/form-resident-pif-core-eval.fk
section [form.bml] {
 class FormCliCodeDefinition {
  def fcad-int(node) = ((String) faj-type(node) == "number") && (((String) value_kind(json-int-value(node)) == "int") && ((String) json-emit(node) == int_to_str(json-int-value(node))));
  def fcad-cases-valid(rows) = nil?(rows) ? 1 : !fat-wire-array?(head(rows)) ? 0 : !((Comparable) len(node_children(head(rows))) == 2) ? 0 : (fcad-int(head(node_children(head(rows)))) && (fcad-int(node_children(head(rows))[1]) && fcad-cases-valid(tail(rows))));
  def fcad-check-valid(row) = (str_len(fcap-string(row, "path")) > 0) && ((str_len(fcap-string(row, "function")) > 0) && (fat-wire-array?(json-object-get(row, "cases")) && ((len(node_children(json-object-get(row, "cases"))) > 0) && fcad-cases-valid(node_children(json-object-get(row, "cases"))))));
  def fcad-expr-valid(expr, parameter, depth) = depth <= 0 ? 0 : (String) fdl-tag(expr) == "__fdl_int__" ? 1 : (String) fdl-tag(expr) == "__fdl_name__" ? ((String) node_value(node_children(expr)[1]) == parameter) : !((String) fdl-tag(expr) == "__fdl_call__") ? 0 : fcad-call-valid(node_value(node_children(expr)[1]), tail(node_children(node_children(expr)[2])), parameter, depth);
  def fcad-call-valid(name, args, parameter, depth) = fat-has(list("add", "sub", "mul", "le", "lt", "gt", "ge", "eq", "ne", "and", "or", "not"), name) && (((Comparable) len(args) == fef-oparity(name)) && fcad-args-valid(args, parameter, depth - 1));
  def fcad-args-valid(args, parameter, depth) = nil?(args) ? 1 : (fcad-expr-valid(head(args), parameter, depth) && fcad-args-valid(tail(args), parameter, depth));
  def fcad-check(row, docs) = nil?(fat-find-doc(docs, fcap-string(row, "path"))) ? list(0, "definition-source-absent") : fcad-module(row, fdl-parse(fat-find-doc(docs, fcap-string(row, "path"))[2]));
  def fcad-module(row, module) = !fdl-ok?(module) ? list(0, "definition-grammar-refused") : !((Comparable) fdl-decl-count(module) == 1) ? list(0, "definition-check-requires-one-function") : fcad-decl(row, head(fdl-module-decls(module)));
  def fcad-decl(row, decl) = !((String) fdl-tag(decl) == "__fdl_fn__") ? list(0, "definition-check-requires-function") : !(((String) fdl-fn-name(decl) == fcap-string(row, "function")) && ((Comparable) fdl-fn-param-count(decl) == 1)) ? list(0, "definition-name-or-arity-mismatch") : !fcad-expr-valid(fdl-fn-body(decl), node_value(head(fdl-fn-param-nodes(decl))), 16) ? list(0, "definition-outside-pure-arithmetic-lane") : fcad-cases(node_children(json-object-get(row, "cases")), frpce-eval(frpce-empty(), fdl-fn-source(decl)), 0);
  def fcad-cases(rows, loaded, passed) = nil?(rows) ? list(1, "native-definition-cases-passed=" ++ int_to_str(passed)) : fcad-case(rows, loaded, passed, json-int-value(head(node_children(head(rows)))), json-int-value(node_children(head(rows))[1]));
  def fcad-case(rows, loaded, passed, input, expected) {
   let result = frpce-invoke-one(loaded, frpce-identity(loaded), input);
   ((String) frpce-receipt-status(result) == "returned") && (((Comparable) frpce-receipt-output(result) == 1) && ((Comparable) frpce-receipt-value(result) == expected)) ? fcad-cases(tail(rows), loaded, passed + 1) : list(0, "native-definition-case-failed input=" ++ int_to_str(input) ++ " expected=" ++ int_to_str(expected) ++ " actual=" ++ int_to_str(frpce-receipt-value(result)));
  }
 }
 0;
}
