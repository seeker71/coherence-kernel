// Executable behavioral checks for the existing native definition grammar.
// A deliberately narrow, total arithmetic lane: one unary function, no effects,
// recursion, unknown bindings or arbitrary evaluation of model text.
import form-stdlib/bml/form-cli-code-policy.bml;
import form-stdlib/form-definition-language.fk;
import form-stdlib/form-resident-pif-core-eval.fk;
section [form.bml] {
 class FormCliCodeDefinition {
  def fcad-int(node) = (((String) faj-type(node) == "number") && (((String) value_kind(json-int-value(node)) == "int") && ((String) json-emit(node) == json-int-value(node).str())));
  def fcad-cases-valid(rows) = if nil?(rows) then 1 else if (!fat-wire-array?(rows[0])) then 0 else if (!((Comparable) len(node_children(rows[0])) == 2)) then 0 else (fcad-int(node_children(rows[0])[0]) && (fcad-int(node_children(rows[0])[1]) && fcad-cases-valid(rows[1:])));
  def fcad-check-valid(row) = ((len(fcap-string(row, "path")) > 0) && ((len(fcap-string(row, "function")) > 0) && (fat-wire-array?(json-object-get(row, "cases")) && ((len(node_children(json-object-get(row, "cases"))) > 0) && fcad-cases-valid(node_children(json-object-get(row, "cases")))))));
  def fcad-expr-valid(expr, parameter, depth) = if (depth <= 0) then 0 else if ((String) fdl-tag(expr) == "__fdl_int__") then 1 else if ((String) fdl-tag(expr) == "__fdl_name__") then ((String) node_value(node_children(expr)[1]) == parameter) else if (!((String) fdl-tag(expr) == "__fdl_call__")) then 0 else fcad-call-valid(node_value(node_children(expr)[1]), node_children(node_children(expr)[2])[1:], parameter, depth);
  def fcad-call-valid(name, args, parameter, depth) = (fat-has(["add", "sub", "mul", "le", "lt", "gt", "ge", "eq", "ne", "and", "or", "not"], name) && (((Comparable) len(args) == fef-oparity(name)) && fcad-args-valid(args, parameter, (depth - 1))));
  def fcad-args-valid(args, parameter, depth) = if nil?(args) then 1 else (fcad-expr-valid(args[0], parameter, depth) && fcad-args-valid(args[1:], parameter, depth));
  def fcad-check(row, docs) = if nil?(fat-find-doc(docs, fcap-string(row, "path"))) then [0, "definition-source-absent"] else fcad-module(row, fdl-parse(fat-find-doc(docs, fcap-string(row, "path"))[2]));
  def fcad-module(row, module) = if (!fdl-ok?(module)) then [0, "definition-grammar-refused"] else if (!((Comparable) fdl-decl-count(module) == 1)) then [0, "definition-check-requires-one-function"] else fcad-decl(row, fdl-module-decls(module)[0]);
  def fcad-decl(row, decl) = if (!((String) fdl-tag(decl) == "__fdl_fn__")) then [0, "definition-check-requires-function"] else if (!(((String) fdl-fn-name(decl) == fcap-string(row, "function")) && ((Comparable) fdl-fn-param-count(decl) == 1))) then [0, "definition-name-or-arity-mismatch"] else if (!fcad-expr-valid(fdl-fn-body(decl), node_value(fdl-fn-param-nodes(decl)[0]), 16)) then [0, "definition-outside-pure-arithmetic-lane"] else fcad-cases(node_children(json-object-get(row, "cases")), frpce-eval(frpce-empty(), fdl-fn-source(decl)), 0);
  def fcad-cases(rows, loaded, passed) = if nil?(rows) then [1, ("native-definition-cases-passed=" + passed.str())] else fcad-case(rows, loaded, passed, json-int-value(node_children(rows[0])[0]), json-int-value(node_children(rows[0])[1]));
  def fcad-case(rows, loaded, passed, input, expected) {
   let result = frpce-invoke-one(loaded, frpce-identity(loaded), input);
   if (((String) frpce-receipt-status(result) == "returned") && (((Comparable) frpce-receipt-output(result) == 1) && ((Comparable) frpce-receipt-value(result) == expected))) then fcad-cases(rows[1:], loaded, (passed + 1)) else [0, ("native-definition-case-failed input=" + (input.str() + (" expected=" + (expected.str() + (" actual=" + frpce-receipt-value(result).str())))))];
  }
 }
 0;
}
