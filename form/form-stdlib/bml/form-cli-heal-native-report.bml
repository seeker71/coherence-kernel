// A current projection of retained process, token and choice evidence.
import form-stdlib/bml/form-cli-heal-native-process.bml;
section [form.bml] {
 class FormCliHealNativeReport {
  def fhn-suffix(name, suffix) = (len(name) >= len(suffix)) && ((String) substring(name, len(name) - len(suffix), len(name)) == suffix);
  def fhn-files(names, suffix) = names |> filter(name => fhn-suffix(name, suffix));
  def fhn-timing-events(events) = events |> map(event => json-node-array([json-object-get(event, "phase"), json-object-get(event, "elapsed_ms")]));
  def fhn-flow-key(row) = json-emit(json-node-array([json-object-get(row, "route"), json-object-get(row, "model"), json-object-get(row, "model_path"), json-object-get(row, "adapter_path")]));
  def fhn-flow-latest(rows, seen) = nil?(rows) ? [] : fhn-member(seen, fhn-flow-key(rows[0])) ? fhn-flow-latest(rows[1:], seen) : cons(rows[0], fhn-flow-latest(rows[1:], cons(fhn-flow-key(rows[0]), seen)));
  def fhn-report-process(job, file) {
   let stage = substring(file, 0, len(file) - len(".process.json"));
   let process = fhn-report-current(job, stage, fhn-json(fhn-at(job, file)));
   let timing = parse-json("native-timing", fhwt-report(json-node-object([json-object-get-pair(process, "elapsed_ms"), fhn-a("events", fhn-timing-events(json-array-elements(json-object-get(process, "events"))))])));
   let flows = fhn-json-rows(split-on(fhn-read(fhn-stage-path(job, stage, ".flow.jsonl")), "\n"));
   let healthy = ((Comparable) fhn-number(timing,"valid") == 1) && ((Comparable) fhn-number(timing,"accounted_ms") == fhn-number(process,"elapsed_ms"));
   let timingHealth = oh-reading("process-timing",fhn-stage-path(job,stage,""),"wall-accounting",json-object-get(process,"elapsed_ms"),json-object-get(timing,"accounted_ms"),json-node-int(healthy),healthy ? [] : [oh-need("monotonic-event-source",oh-reference(fhn-stage-path(job,stage,".events.jsonl")))],["request-evidence","defer"],oh-reference(fhn-stage-path(job,stage,".events.jsonl")));
   let emitted = oh-emit(fhn-at(job,"health.jsonl"),timingHealth);
   json-node-object([fhn-s("stage", stage), json-node-pair("process", process), json-node-pair("timing", timing), fhn-a("token_flows", reverse(fhn-flow-latest(reverse(flows), []))), fhn-n("token_events", len(flows)),fhn-a("health",append(oh-current(json-array-elements(json-object-get(process,"events")),[]),[timingHealth]))]);
  }
  def fhn-report-current(job, stage, doc) {
   let public = json-node-object(fhn-without(json-object-pairs(doc), "argv"));
   !((String) fhn-string(doc, "state") == "running") ? public : fhn-put(fhn-put(public, "elapsed_ms", json-node-int(host_monotonic_ms() - fhn-number(doc, "started_monotonic_ms"))), "events", json-node-array(fhn-json-rows(split-on(fhn-read(fhn-stage-path(job, stage, ".events.jsonl")), "\n"))));
  }
  def json-object-get-pair(doc, key) = json-node-pair(key, json-object-get(doc, key));
  def fhn-report-processes(job, files) = files |> map(file => fhn-report-process(job, file));
  def fhn-report-valid(rows) = nil?(rows) ? 1 : (((Comparable) fhn-number(json-object-get(rows[0], "timing"), "valid") == 1) && (((Comparable) fhn-number(json-object-get(rows[0], "timing"), "accounted_ms") == fhn-number(json-object-get(rows[0], "process"), "elapsed_ms")) && fhn-report-valid(rows[1:])));
  def fhn-report-lines(rows) = nil?(rows) ? "" : fh-cat(["- ", fhn-string(rows[0], "stage"), ": ", fhn-number(json-object-get(rows[0], "process"), "elapsed_ms").str(), " ms; state=", fhn-string(json-object-get(rows[0], "process"), "state"), "; reason=", fhn-string(json-object-get(rows[0], "process"), "reason"), "; exit=", fhn-number(json-object-get(rows[0], "process"), "status").str(), "\n  intervals=", json-emit(json-object-get(json-object-get(rows[0], "timing"), "spans")), "\n  token_flows=", json-emit(json-object-get(rows[0], "token_flows")), "\n", fhn-report-lines(rows[1:])]);
  def fhn-report-choice-lines(rows) = nil?(rows) ? "" : fh-cat(["- ", fhn-string(rows[0], "stage"), " [", fhn-string(rows[0], "id"), "] ", fhn-string(rows[0], "state"), ": offered=", json-emit(json-object-get(rows[0], "offered")), "; selected=", fhn-string(rows[0], "selected"), "; reason=", fhn-string(rows[0], "reason"), "; result=", fhn-string(rows[0], "result"), "\n", fhn-report-choice-lines(rows[1:])]);
  def fhn-report(job) {
   let rows = fhn-report-processes(job, fhn-files(host_dir_list(job), ".process.json"));
   let choices = fhn-json-rows(split-on(fhn-read(fhn-at(job, "choices.jsonl")), "\n"));
   let learning = fhn-json-rows(split-on(fhn-read(fhn-at(job, "learning.jsonl")), "\n"));
   let valid = (len(rows) > 0) && fhn-report-valid(rows);
   let summary = json-node-object([fhn-s("version", "heal-observation-v1"), fhn-n("generated_unix_ms", now_unix_ms()), fhn-s("evidence", job), fhn-n("timing_reconciled", valid), fhn-a("processes", rows), fhn-a("choices", choices), fhn-a("learning_rounds", learning)]);
   let saved = fhn-write-json(fhn-at(job, "timing-report.json"), summary);
   let text = fh-cat(["# Observed healing run\n\nWall intervals include waiting; they are not CPU or hardware-floor measurements.\n\n", fhn-report-lines(rows), "\n## Recorded choices\n\n", fhn-report-choice-lines(choices), "\n## Learning rounds\n\n", json-emit(json-node-array(learning)), "\n"]);
   let human = write_file(fhn-at(job, "timing-report.md"), text);
   fh-cat(["timing-report=", fhn-at(job, "timing-report.json"), "; processes=", len(rows).str(), "; choice-events=", len(choices).str(), "; timing-reconciled=", valid.str(), "\n", fhn-report-lines(rows), fhn-report-choice-lines(choices)]);
  }
 }
 0;
}
