  def fcap-document-identity(doc) = list(json-node-pair("id",json-node-string(head(doc))),json-node-pair("path",json-node-string(doc[1])),json-node-pair("bytes",json-node-int(str_len(doc[2]))),json-node-pair("resident_sha256",json-node-string(fat-document-sha(doc))));
  def fcap-document-catalog(docs) = nil?(docs) ? list() : cons(json-node-object(fcap-document-identity(head(docs))),fcap-document-catalog(tail(docs)));
  def fcap-model-documents(docs) = nil?(docs) ? list() : cons(json-node-object(append(fcap-document-identity(head(docs)),list(json-node-pair("text",json-node-string(head(docs)[2]))))),fcap-model-documents(tail(docs)));
  def fcap-with-native-submission(s,count) {
