  }
  def fcap-with-report(s, report) = fcap-provenance(fcap-with-memory(s,list(fcap-failures(s),fcap-evidence(s),fcap-reflections(s),fcap-checks(s),fcap-repeat(s),fcap-tool-history(s),fcap-mode(s),report)),fcap-native-repairs(s),"submitted");
  def fcap-inherit(s, next) = append(fat-take(fcap-with-memory(next, fcap-memory(s)), 13), len(s) >= 14 ? list(s[13]) : list());
  def fcap-failures(s) = head(fcap-memory(s));
  def fcap-evidence(s) = fcap-memory(s)[1];
  def fcap-reflections(s) = fcap-memory(s)[2];
  def fcap-checks(s) = fcap-memory(s)[3];
  def fcap-repeat(s) = fcap-memory(s)[4];
  def fcap-count-check(s) = fcap-with-memory(s, list(fcap-failures(s), fcap-evidence(s), fcap-reflections(s), fcap-checks(s) + 1, fcap-repeat(s)));
  def fcap-stage(s) = s[0];
  def fcap-docs(s) = s[3];
  def fcap-note(s) = s[8];
  def fcap-turns(s) = s[9];
  def fcap-calls(s) = s[10];
  def fcap-done(s) = ((String) fcap-stage(s) == "complete") || ((String) fcap-stage(s) == "attention");
  def fcap-move(s, stage, docs, pending, brief, plan, note, calls, completed) = fcap-inherit(s, fcap-state(stage, s[1], s[2], docs, s[4], pending, brief, plan, note, fcap-turns(s) + 1, calls, completed));
  def fcap-note-at(s, stage, note) = fcap-move(s, stage, fcap-docs(s), s[5], s[6], s[7], note, fcap-calls(s), s[11]);
  def fcap-open(goal, docs, writable) = fcap-state("refine", goal, docs, docs, writable, list(), "", "", "Ground first; keep the original goal authoritative.", 0, 0, 0);
  def fcap-direct-task() = "Complete the original caller goal supplied in this context, including its explicitly requested tool calls.";
  def fcap-open-direct-code(goal,docs,writable) = fcap-state("implement",goal,docs,docs,writable,list(fcap-direct-task()),"","","Implement the caller's supplied task. Review and native checks still decide completion; failed checks retain the existing repair and replanning path.",0,0,0);
  def fcap-open-review(goal, docs) {
   let state = fcap-open(goal, docs, list());
