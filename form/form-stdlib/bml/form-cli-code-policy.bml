  }
  def fcap-readonly(tool) = fat-has(list("rg", "jq", "read", "cat", "head", "tail", "wc", "sort", "uniq", "tr", "cut", "awk", "sed", "balance", "arity"), tool);
  def fcap-edit-stage(s,tool) = ((String) fcap-stage(s) == "implement") || (((String) fcap-stage(s) == "repair") && ((!fcap-repeat(s)) && fat-has(list("edit","write","repair-bml"),tool)));
  def fcap-tool-allowed(s, tool, args) = fcap-readonly(tool) ? 1 : fcap-reviewing(s) || (!fcap-edit-stage(s,tool)) ? 0 : !fat-has(list("edit", "write", "repair-bml", "rehearse-bml"), tool) ? 0 : nil?(args) ? 0 : fat-has(s[4], head(args));
  def fcap-readonly-preserved(originals, docs, writable) = nil?(originals) ? 1 : ((fat-has(writable, head(originals)[1]) ? 1 : ((Value) head(originals) == fat-find-doc(docs, head(originals)[1]))) && fcap-readonly-preserved(tail(originals), docs, writable));
  def fcap-tool(s, obj) = !fcap-string-array(json-object-get(obj, "arguments")) ? fcap-revise(s, "Tool arguments must be an array of strings.") : json-object-has?(obj, "input") && (!fat-wire-string?(json-object-get(obj, "input"))) ? fcap-revise(s, "Tool input must be a string.") : fcap-tool-ready(s, fcap-string(obj, "tool"), fcap-array(obj, "arguments"), fcap-string(obj, "input"));
