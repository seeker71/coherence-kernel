  }
  def fcap-read-note(provided,result) = if nil?(provided) then fcap-result-note(result) else if not(and(eq(fat-exit(result),0),str_eq(fat-error(result),""))) then fcap-result-note(result) else if not(str_eq(fat-out(result),nth(provided,2))) then fcap-read-changed(provided,result) else json-emit(json-node-object(list(json-node-pair("exit",json-node-int(0)),json-node-pair("stderr",json-node-string("")),json-node-pair("stdout_reference",fcap-context-reference(provided)),json-node-pair("observation",json-node-string("The native read verified these exact bytes match the document already supplied to this model context. Use its provided text. cat or a focused native query remains available to inspect content again.")))));
  def fcap-context-reference(provided) = json-node-object(list(json-node-pair("id",json-node-string(head(provided))),json-node-pair("path",json-node-string(nth(provided,1))),json-node-pair("bytes",json-node-int(str_len(nth(provided,2)))),json-node-pair("scope",json-node-string("current-model-context"))));
  // One exact line splice against the admission snapshot, never against a
  // prior patch. Reconstruct and compare the actual read before emitting it.
  def fcap-common-lines(a,b,n) = if or(nil?(a),nil?(b)) then n else if not(str_eq(head(a),head(b))) then n else fcap-common-lines(tail(a),tail(b),add(n,1));
  def fcap-read-splice(before,after) {
