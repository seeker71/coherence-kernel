  def fcap-signature-max() = 2048;
   def fcap-held-stdout(out) = if (!fat-text?(out) || len(out) <= fcap-signature-max()) then out else [hex-encode(sha256-stream-string(out)),len(out)];
  def fcap-held-stderr(err) = if (len(err) <= fcap-signature-max()) then err else (fcap-clip(err,fcap-excerpt-line()) + (" [stderr sha256 " + (hex-encode(sha256-stream-string(err)) + (" bytes " + (len(err).str() + "]")))));
  def fcap-held-signature(signature) = if (!((Comparable) len(signature) == 6)) then signature else [signature[0],signature[1],signature[2],signature[3],if ((String) value_kind(signature[4]) == "string") then fcap-held-stdout(signature[4]) else signature[4],if ((String) value_kind(signature[5]) == "string") then fcap-held-stderr(signature[5]) else signature[5]];
   // The guard reads identity, never a rendered native payload. A deferred view
