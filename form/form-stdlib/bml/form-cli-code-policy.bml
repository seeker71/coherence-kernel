    let view = fat-text?(result[2]) ? 0 : fb_record(intern_node(intern_trivial_string("native-tool-result"), [intern_trivial_string(ftw-coord(fat-value(result))), intern_trivial_int(len(result[2][0])), intern_trivial_int(0)]), "form-cli-code-policy.bml", 189);
   let history = fcap-tool-history(s);
