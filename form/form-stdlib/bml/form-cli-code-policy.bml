// A coding movement over resident documents. Model messages are values, never
// host commands. The caller owns writable paths and the verification callback.
// preludes: form-stdlib/bml/form-agent-tool-wire.bml observe/bidirectional-framebuffer-channel.fk form-stdlib/bml/form-cli-review-guidance.bml form-stdlib/bml/form-cli-report-amend.bml form-stdlib/bml/form-cli-code-bml-repair.bml form-stdlib/bml/form-cli-code-value-search.bml form-stdlib/bml/form-cli-qwen-meaning.bml form-stdlib/form-lift.bml
section [form.bml] {
 class FormCliCodePolicy {
  def fcap-string(obj, key) = fcap-string-value(fat-wire-field-string(obj, key, ""));
  def fcap-string-value(result) = (String) fat-wire-error(result) == "" ? fat-wire-value(result) : "";
  def fcap-strings(nodes) = nil?(nodes) ? list() : cons(node_value(head(nodes)), fcap-strings(tail(nodes)));
  def fcap-string-array(node) = !fat-wire-array?(node) ? 0 : fcap-string-nodes(node_children(node));
  def fcap-string-nodes(nodes) = nil?(nodes) ? 1 : (fat-wire-string?(head(nodes)) && fcap-string-nodes(tail(nodes)));
  def fcap-nonempty(strings) = nil?(strings) ? 1 : ((str_len(fat-trim(head(strings))) > 0) && fcap-nonempty(tail(strings)));
  def fcap-array(obj, key) = fcap-strings(node_children(json-object-get(obj, key)));
  // state: stage, goal, originals, documents, writable, pending tasks,
  // refined brief, plan, observation, model turns, tool calls, completed tasks,
  // repair memory [failures, latest evidence, repair reflections, check runs,
