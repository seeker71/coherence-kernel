// A coding movement over resident documents. Model messages are values, never
// host commands. The caller owns writable paths and the verification callback.
import form-stdlib/bml/form-agent-tool-wire.bml;
import form-stdlib/bml/form-cli-code-turn-guard.bml;
import observe/bidirectional-framebuffer-channel.fk;
import form-stdlib/bml/form-cli-review-guidance.bml;
import form-stdlib/bml/form-cli-report-amend.bml;
import form-stdlib/bml/form-cli-code-bml-repair.bml;
import form-stdlib/bml/form-cli-code-value-search.bml;
import form-stdlib/bml/form-cli-qwen-meaning.bml;
import form-stdlib/form-lift.bml;
import form-stdlib/bml/form-token-grammar.bml;
section [form.bml] {
 class FormCliCodePolicy {
  def fcap-string(obj, key) = fcap-string-value(fat-wire-field-string(obj, key, ""));
  def fcap-string-value(result) = if ((String) fat-wire-error(result) == "") then fat-wire-value(result) else "";
  def fcap-strings(nodes) = nodes |> map(node => node_value(node));
  def fcap-string-array(node) = if (!fat-wire-array?(node)) then 0 else fcap-string-nodes(node_children(node));
  def fcap-string-nodes(nodes) = if nil?(nodes) then 1 else (fat-wire-string?(nodes[0]) && fcap-string-nodes(nodes[1:]));
  def fcap-nonempty(strings) = if nil?(strings) then 1 else ((len(fat-trim(strings[0])) > 0) && fcap-nonempty(strings[1:]));
  def fcap-array(obj, key) = fcap-strings(node_children(json-object-get(obj, key)));
  // state: stage, goal, originals, documents, writable, pending tasks,
  // refined brief, plan, observation, model turns, tool calls, completed tasks,
  // repair memory [failures, latest evidence, repair reflections, check runs,
  // repeated counterexample]. It is working memory, never a weight update.
  def fcap-state(stage, goal, originals, docs, writable, pending, brief, plan, note, turns, calls, completed) = [stage, goal, originals, docs, writable, pending, brief, plan, note, turns, calls, completed, [0, "", [], 0, 0]];
  def fcap-memory(s) = s[12];
  // Checkpoint identity is shared state; reading it needs no storage organ.
  def fcam-context(s) = len(s) >= 14 ? s[13] : [];
  def fcam-managed(s) = (Comparable) len(fcam-context(s)) == 4;
  def fcam-id(s) = fcam-context(s)[1];
  // Preserve the tool history and caller-owned work kind when a repair updates
  // the earlier memory slots. Model JSON cannot change the kind.
  def fcap-with-memory(s, memory) = append(append(fat-take(s, 12), [append(memory, fat-drop(fcap-memory(s), len(memory)))]), if (len(s) >= 14) then [s[13]] else []);
  def fcap-mode(s) = if (len(fcap-memory(s)) >= 7) then fcap-memory(s)[6] else "code";
  def fcap-reviewing(s) = ((String) fcap-mode(s) == "review");
  def fcap-report(s) = if (len(fcap-memory(s)) >= 8) then fcap-memory(s)[7] else "";
  // This snapshot belongs to one admitted model context. Reset it at admission,
  // including checkpoint resume; source edits do not update it implicitly.
  def fcap-context-docs(s) = if (len(fcap-memory(s)) >= 9) then fcap-memory(s)[8] else [];
  def fcap-context-instructions(s) = if (len(fcap-memory(s)) >= 10) then fcap-memory(s)[9] else [];
  def fcap-native-repairs(s) = if (len(fcap-memory(s)) >= 11) then fcap-memory(s)[10] else [];
  def fcap-report-source(s) = if (len(fcap-memory(s)) >= 12) then fcap-memory(s)[11] else "submitted";
  def fcap-context-native-review(s) = if (len(fcap-memory(s)) >= 13) then fcap-memory(s)[12] else 0;
  def fcap-context-native-submission(s) = if (len(fcap-memory(s)) >= 14) then fcap-memory(s)[13] else 0;
  // Holding source bytes does not attest that a model has received them.
  // This caller-owned admission choice survives transitions and checkpoints.
  def fcap-document-context(s) = if (len(fcap-memory(s)) >= 15) then fcap-memory(s)[14] else "full";
  def fcap-catalog?(s) = ((String) fcap-document-context(s) == "catalog");
  def fcap-with-document-context(s,mode) {
   let padded = fcap-with-native-submission(s,fcap-context-native-submission(s));
   fcap-with-memory(padded,append(fat-take(fcap-memory(padded),14),[mode]));
  }
  def fcap-admission-docs(s) = if fcap-catalog?(s) then [] else fcap-docs(s);
  // Caller-selected source queries retain their commands, never supplied output.
  // This predicate was authored by native Qwen and checked on 39 behavior cases.
  def fcap-source-query-valid(row) = if ((((fat-wire-object?(row) && fcap-readonly(fcap-string(row,"tool"))) && fcap-string-array(json-object-get(row,"arguments"))) && (!json-object-has?(row,"input"))) && (!json-object-has?(row,"stdout"))) then 1 else 0;
  def fcap-source-query-rows-valid(rows) = if nil?(rows) then 1 else (fcap-source-query-valid(rows[0]) && fcap-source-query-rows-valid(rows[1:]));
  def fcap-source-query-rows(rows) = rows |> map(row => [fcap-string(row,"tool"),fcap-array(row,"arguments")]);
  def fcap-source-queries(s) = if (len(fcap-memory(s)) >= 16) then fcap-memory(s)[15] else [];
  def fcap-with-source-queries(s,queries) {
   let padded = fcap-with-document-context(s,fcap-document-context(s));
   fcap-with-memory(padded,append(fat-take(fcap-memory(padded),15),[queries]));
  }
  def fcap-source-observations(docs,queries) = if nil?(queries) then [] else {
   let query = queries[0];
   if (!fcap-readonly(query[0])) then form_error("source query must be read-only") else 0;
   let result = fcap-readonly-call(docs,query[0],query[1],"");
   if (!((Value) docs == fat-documents(result))) then form_error("source query changed its documents") else 0;
   cons(json-node-object(append([json-node-pair("tool",json-node-string(query[0])),json-node-pair("arguments",json-node-array(fcap-string-json(query[1])))],json-object-pairs(fcap-result-node(result)))),fcap-source-observations(docs,queries[1:]));
  };
  def fcap-source-context(s) = nil?(fcap-source-queries(s)) ? "" : "\nNATIVE SOURCE OBSERVATIONS: Actual read-only query results, including exit and diagnostics. Retrieve missing evidence; original documents and checks remain whole.\n" + fcap-model-packet(json-node-object([json-node-pair("source_observations",json-node-array(fcap-source-observations(fcap-docs(s),fcap-source-queries(s))))]));
  def fcap-document-identity(doc) = [json-node-pair("id",json-node-string(doc[0])),json-node-pair("path",json-node-string(doc[1])),json-node-pair("bytes",json-node-int(len(doc[2]))),json-node-pair("resident_sha256",json-node-string(fat-document-sha(doc)))];
  def fcap-document-catalog(docs) = docs |> map(doc => json-node-object(fcap-document-identity(doc)));
  def fcap-model-documents(docs) = docs |> map(doc => json-node-object(append(fcap-document-identity(doc),[json-node-pair("text",json-node-string(doc[2]))])));
  def fcap-with-native-submission(s,count) {
   let padded = fcap-with-native-context(s,fcap-context-native-review(s));
   fcap-with-memory(padded,append(fat-take(fcap-memory(padded),13),[count]));
  }
  // Only the live controller can attest that this exact rejected report was
  // generated in the current context. A replay or bootstrap cannot infer it.
  def fcap-native-submission-admitted(s,raw) = if (!fcap-awaiting-native-review(s)) then s else if (!(fcap-node-address?(raw) || faj-valid(raw))) then s else {
   let obj = fcap-node-address?(raw) ? fcap-node-object(fcap-address-node(raw)) : parse-json("native-submission",raw);
   if nothing?(obj) then s else {
   let report = if json-object-has?(obj,"report") then fcap-report-text(obj) else json-emit(obj);
   if ((String) report == fcap-last-native(s)[4][0]) then fcap-with-native-submission(s,len(fcap-native-repairs(s))) else s;
   };
  };
  def fcap-with-native-context(s,count) {
   let padded = fcap-provenance(s,fcap-native-repairs(s),fcap-report-source(s));
   fcap-with-memory(padded,append(fat-take(fcap-memory(padded),12),[count]));
  }
  def fcap-last-native(s) = reverse(fcap-native-repairs(s))[0];
  def fcap-awaiting-native-review(s) = if (!(fcap-reviewing(s) && (((String) fcap-stage(s) == "review") && ((String) fcap-report-source(s) == "caller-native-repair")))) then 0 else if nil?(fcap-native-repairs(s)) then 0 else ((String) fcap-last-native(s)[1] == "accepted-for-review");
  def fcap-native-context-start(s) = if nil?(fcap-native-repairs(s)) then s else fcap-with-native-submission(fcap-with-native-context(s,len(fcap-native-repairs(s))),0);
  def fcap-native-context-admitted(s) = if fcap-awaiting-native-review(s) then fcap-with-native-context(s,len(fcap-native-repairs(s))) else s;
  def fcap-provenance(s,events,source) = fcap-with-memory(s,[fcap-failures(s),fcap-evidence(s),fcap-reflections(s),fcap-checks(s),fcap-repeat(s),fcap-tool-history(s),fcap-mode(s),fcap-report(s),fcap-context-docs(s),fcap-context-instructions(s),events,source]);
  def fcap-record-native(s,method,status,observation,source) = fcap-provenance(s,append(fcap-native-repairs(s),[[method,status,observation,fcap-checks(s)]]),source);
  // Exact reports and their own checker results stay paired. These records are
  // returned to the caller. An explicit continuation also admits the newest
  // pair once per resident context, with full evidence again after resume.
  def fcap-report-check-evidence(report,result) = [report,if fcap-check-shape?(result) then result else []];
  def fcap-record-native-evidence(s,method,status,observation,source,before,after) = fcap-provenance(s,append(fcap-native-repairs(s),[[method,status,observation,fcap-checks(s),before,after]]),source);
  // Continuing a direct task after native calls without a document change or
  // completed step invites local decomposition, with its evidence intact.
  def fcap-context-guide(s) = fcap-calls(s)>0 && !fcap-reviewing(s) && fat-has(["implement","repair"],fcap-stage(s)) && ((Value) s[5]==[fcap-direct-task()]) && ((Value) fcap-docs(s)==s[2]) && s[11]==0 ? cons("split",s[1:]) : s;
  def fcap-begin-context(s) {
   let s=fcap-context-guide(s);
   let begun = fcap-native-context-start(fcap-with-memory(s,[fcap-failures(s),fcap-evidence(s),fcap-reflections(s),fcap-checks(s),fcap-repeat(s),fcap-tool-history(s),fcap-mode(s),fcap-report(s),fcap-admission-docs(s),[fcap-work-instruction(s)]]));
   fcap-admit-evidence(fcap-with-context-evidence(begun,""));
  }
  // Only a completed observation admits its instruction to this context.
  // Bootstrap always carries full instructions, including after resume.
  def fcap-observation-admitted(s,before,after,live) = if (live && ((Comparable) after == (before + 1))) then fcap-native-context-admitted(fcap-admit-evidence(fcap-admit-instruction(s))) else s;
  def fcap-admit-instruction(s) = if ((len(fcap-memory(s)) < 9) || fat-has(fcap-context-instructions(s),fcap-work-instruction(s))) then s else fcap-with-memory(s,append(fat-take(fcap-memory(s),9),[append(fcap-context-instructions(s),[fcap-work-instruction(s)])]));
  def fcap-observation-instruction(s) {
   let full = fcap-work-instruction(s);
   let reference = "Continue the supplied instructions for this role and the original caller requirements.";
   if (fat-has(fcap-context-instructions(s),full) && (len(reference) < len(full))) then reference else full;
  }
  def fcap-with-report(s, report) = fcap-provenance(fcap-with-memory(s,[fcap-failures(s),fcap-evidence(s),fcap-reflections(s),fcap-checks(s),fcap-repeat(s),fcap-tool-history(s),fcap-mode(s),report]),fcap-native-repairs(s),"submitted");
  def fcap-inherit(s, next) = append(fat-take(fcap-with-memory(next, fcap-memory(s)), 13), if (len(s) >= 14) then [s[13]] else []);
  def fcap-failures(s) = fcap-memory(s)[0];
  def fcap-evidence(s) = fcap-memory(s)[1];
  def fcap-reflections(s) = fcap-memory(s)[2];
  def fcap-checks(s) = fcap-memory(s)[3];
  def fcap-repeat(s) = fcap-memory(s)[4];
  def fcap-count-check(s) = fcap-with-memory(s, [fcap-failures(s), fcap-evidence(s), fcap-reflections(s), (fcap-checks(s) + 1), fcap-repeat(s)]);
  def fcap-stage(s) = s[0];
  def fcap-docs(s) = s[3];
  // The state owns the observation cell. Text is produced only for a text caller.
  def fcap-note(s) = value_kind(s[8])=="node_id" ? json-emit(s[8]) : s[8];
  def fcap-note-cell(s) = value_kind(s[8])=="node_id" ? s[8] : json-node-string(fcap-evidence-reference(s,s[8]));
  def fcap-turns(s) = s[9];
  def fcap-calls(s) = s[10];
  def fcap-done(s) = (((String) fcap-stage(s) == "complete") || ((String) fcap-stage(s) == "attention"));
  def fcap-move(s, stage, docs, pending, brief, plan, note, calls, completed) = fcap-inherit(s, fcap-state(stage, s[1], s[2], docs, s[4], pending, brief, plan, note, (fcap-turns(s) + 1), calls, completed));
  def fcap-note-at(s, stage, note) = fcap-move(s, stage, fcap-docs(s), s[5], s[6], s[7], note, fcap-calls(s), s[11]);
  def fcap-open(goal, docs, writable) = fcap-state("refine", goal, docs, docs, writable, [], "", "", "Ground first; keep the original goal authoritative.", 0, 0, 0);
  def fcap-direct-task() = "Complete the original caller goal supplied in this context, including its explicitly requested tool calls.";
  def fcap-open-direct-code(goal,docs,writable) = fcap-state("implement",goal,docs,docs,writable,[fcap-direct-task()],"","","Implement the caller's supplied task. Review and native checks still decide completion; failed checks retain the existing repair and replanning path.",0,0,0);
  def fcap-open-review(goal, docs) {
   let state = fcap-open(goal, docs, []);
   fcap-with-memory(state, append(fcap-memory(state), [[[], 0], "review", ""]));
  }
  def fcap-open-direct-review(goal,docs) = fcap-inherit(fcap-open-review(goal,docs),fcap-state("review",goal,docs,docs,[],[],"","","Inspect the supplied evidence and submit the report. Read-only tools and verify are available.",0,0,0));
  def fcap-terminal(s, reason) = fcap-inherit(s, fcap-state("attention", s[1], s[2], fcap-docs(s), s[4], s[5], s[6], s[7], reason, fcap-turns(s), fcap-calls(s), s[11]));
  def fcap-control(id, observation, action) {
   let out = bfc-envelope(0, id, 0, observation, 3);
   let sent = bfc-record-out(out, 0);
   let reply = bfc-control(out, action);
   let received = bfc-record-in(reply, 0);
   if (((Comparable) bfc-exchange(reply) == id) && (((Comparable) bfc-direction(reply) == 1) && ((Comparable) bfc-kind(reply) == 1))) then bfc-payload(reply) else 3;
  }
  def fcap-revise(s, reason) {
   let action = fcap-control((now_unix_ms() + fcap-turns(s)), [fcap-turns(s), fcap-calls(s)], 2);
   if ((Comparable) action == 2) then fcap-note-at(s, fcap-stage(s), reason) else fcap-terminal(s, "diagnostic-control-unavailable");
  }
  def fcap-readonly(tool) = tool=="help" || fat-readonly(tool);
  def fcap-readonly-call(docs,tool,args,input) = tool=="help" ? fcap-help(docs,args) : fat-call(docs,tool,args,input);
  def fcap-guides() = [["workflow",fl-local-work],["form",ftg-teaching],["meaning",fqt-meaning-prefix],["bml",fl-guidance],["edit",fat-edit-guidance],["repair-bml",fcbmr-guidance],["lift-bml",fcbl-guidance],["rehearse-bml",fcbvs-guidance]];
  def fcap-help(docs,args) {
   let guides=fcap-guides();
   let found=len(args)==1 ? guides |> filter(row=>row[0]==args[0]) : [];
   if nil?(found) then fat-fail("help needs one guide: " + str-join-with(guides |> map(row=>row[0]),", "),docs) else {
    let read=found[0][1];
    fat-ok(read(),docs);
   };
  }
  def fcap-edit-stage(s,tool) = (((String) fcap-stage(s) == "implement") || (((String) fcap-stage(s) == "repair") && ((!fcap-repeat(s)) && fat-has(["edit","write","repair-bml","lift-bml"],tool))));
  def fcap-tool-allowed(s, tool, args) = if fcap-readonly(tool) then 1 else if (fcap-reviewing(s) || (!fcap-edit-stage(s,tool))) then 0 else if (!fat-has(["edit", "write", "repair-bml", "rehearse-bml","lift-bml"], tool)) then 0 else if nil?(args) then 0 else fat-has(s[4], args[0]);
  def fcap-readonly-preserved(originals, docs, writable) = if nil?(originals) then 1 else ((if fat-has(writable, originals[0][1]) then 1 else ((Value) originals[0] == fat-find-doc(docs, originals[0][1]))) && fcap-readonly-preserved(originals[1:], docs, writable));
  def fcap-tool(s, obj) = if (!fcap-string-array(json-object-get(obj, "arguments"))) then fcap-revise(s, "Tool arguments must be an array of strings.") else if (json-object-has?(obj, "input") && (!fat-wire-string?(json-object-get(obj, "input")))) then fcap-revise(s, "Tool input must be a string.") else fcap-tool-ready(s, fcap-string(obj, "tool"), fcap-array(obj, "arguments"), fcap-string(obj, "input"));
  def fcap-tool-ready(s, tool, args, input) = if (!fcap-tool-allowed(s, tool, args)) then fcap-revise(s, "Tool unavailable in this role or target is not caller-writable.") else fcap-tool-observed(s, tool, args, input, if tool=="help" then fcap-help(fcap-docs(s),args) else if ((String) tool == "repair-bml") then fcbmr-call(fcap-docs(s),args,input) else if tool == "lift-bml" then fcbl-call(fcap-docs(s),args,input) else fat-call(fcap-docs(s), tool, args, input));
  def fcap-tool-history(s) = if (len(fcap-memory(s)) >= 6) then fcap-memory(s)[5] else [[], 0];
  // The signature identifies a call and its result for same-call detection; it is not where a result is kept. A stdout
