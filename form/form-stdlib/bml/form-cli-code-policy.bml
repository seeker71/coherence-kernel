  def fcap-document-context(s) = len(fcap-memory(s)) >= 15 ? fcap-memory(s)[14] : "full";
  def fcap-catalog?(s) = (String) fcap-document-context(s) == "catalog";
  def fcap-with-document-context(s,mode) {
   let padded = fcap-with-native-submission(s,fcap-context-native-submission(s));
   fcap-with-memory(padded,append(fat-take(fcap-memory(padded),14),list(mode)));
  }
  def fcap-admission-docs(s) = fcap-catalog?(s) ? list() : fcap-docs(s);
  // Caller-selected source queries retain their commands, never supplied output.
  // This predicate was authored by native Qwen and checked on 39 behavior cases.
  def fcap-source-query-valid(row) = (((fat-wire-object?(row) && fcap-readonly(fcap-string(row,"tool"))) && fcap-string-array(json-object-get(row,"arguments"))) && (!json-object-has?(row,"input"))) && (!json-object-has?(row,"stdout")) ? 1 : 0;
  def fcap-source-query-rows-valid(rows) = nil?(rows) ? 1 : (fcap-source-query-valid(head(rows)) && fcap-source-query-rows-valid(tail(rows)));
  def fcap-source-query-rows(rows) = nil?(rows) ? list() : cons(list(fcap-string(head(rows),"tool"),fcap-array(head(rows),"arguments")),fcap-source-query-rows(tail(rows)));
