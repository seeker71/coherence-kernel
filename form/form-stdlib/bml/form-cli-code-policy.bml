  def fcap-no-progress(s) {
   let next = fcap-repair-state(s, "The same native tool, arguments and result repeated without a document change. Diagnose the missing evidence and choose next=plan; repeating the call is not progress.");
   fcap-with-memory(next, append([fcap-failures(next), fcap-evidence(next), fcap-reflections(next), fcap-checks(next), 1], [fcap-tool-history(next)]));
  }
   def fcap-result-node(result) = json-node-object(append([json-node-pair("exit",json-node-int(fat-exit(result))),json-node-pair("stdout",json-node-string(fat-text?(result[2]) ? result[2] : "")),json-node-pair("stderr",json-node-string(fat-error(result))),json-node-pair("crossings",json-node-int(fat-crossings(result)))],fat-has-value?(result) ? [json-node-pair("value",fat-value(result))] : []));
  def fcap-note-with(node, pairs) = json-node-object(append(json-object-pairs(node), pairs));
  def fcap-checked-documents(docs) = if nil?(docs) then [] else {
   let doc = docs[0];
   let digest = hex-encode(sha256-stream-string(doc[2]));
   let fields = [json-node-pair("id",json-node-string(doc[0])),json-node-pair("path",json-node-string(doc[1])),json-node-pair("bytes",json-node-int(len(doc[2]))),json-node-pair("sha256",json-node-string(digest))];
   cons(json-node-object(fields),fcap-checked-documents(docs[1:]));
  };
  // The callback has just received these resident bytes. Identical failures
  // after a source edit retain their new source identity; no success is inferred.
  def fcap-verification-node(s,result) {
   let source = [json-node-pair("checked_documents",json-node-array(fcap-checked-documents(fcap-docs(s)))),json-node-pair("verification_scope",json-node-string("Exact resident documents supplied to this native verification call. The caller's result remains authoritative."))];
   fcap-note-with(fcap-result-node(result), source);
  }
  def fcap-guard-node(s,tool,args,result) {
   let evidence = fat-guard-evidence(fcap-docs(s),tool,args,result);
   let base = fcap-result-node(result);
   nothing?(evidence) ? base : fcap-note-with(base, [json-node-pair("guard_evidence",evidence)]);
  }
  def fcap-guard-read?(s,path) {
   let prior = fcap-tool-history(s)[0];
   if (!((Comparable) len(prior) == 6)) then 0 else {
    let args = prior[1];
    (fat-has(["edit","write"],prior[0]) && ((!nil?(args)) && (((String) args[0] == path) && fat-has(["edit-not-found","edit-ambiguous","document-exists-use-guarded-edit","edit-sha256-mismatch"],prior[5]))));
   };
  }
