// A coding movement over resident documents. Model messages are values, never
// host commands. The caller owns writable paths and the verification callback.
// preludes: form-stdlib/bml/form-agent-tool-wire.bml observe/bidirectional-framebuffer-channel.fk form-stdlib/bml/form-cli-review-guidance.bml
section [form.bml] {
 class FormCliCodePolicy {
  def fcap-string(obj, key) = fcap-string-value(fat-wire-field-string(obj, key, ""));
  def fcap-string-value(result) = if str_eq(fat-wire-error(result), "") then fat-wire-value(result) else "";
  def fcap-strings(nodes) = if nil?(nodes) then list() else cons(node_value(head(nodes)), fcap-strings(tail(nodes)));
  def fcap-string-array(node) = if not(fat-wire-array?(node)) then 0 else fcap-string-nodes(node_children(node));
  def fcap-string-nodes(nodes) = if nil?(nodes) then 1 else and(fat-wire-string?(head(nodes)), fcap-string-nodes(tail(nodes)));
  def fcap-nonempty(strings) = if nil?(strings) then 1 else and(gt(str_len(fat-trim(head(strings))), 0), fcap-nonempty(tail(strings)));
  def fcap-array(obj, key) = fcap-strings(node_children(json-object-get(obj, key)));
  // state: stage, goal, originals, documents, writable, pending tasks,
  // refined brief, plan, observation, model turns, tool calls, completed tasks,
  // repair memory [failures, latest evidence, model reflections, check runs,
  // repeated counterexample]. It is working memory, never a weight update.
  def fcap-state(stage, goal, originals, docs, writable, pending, brief, plan, note, turns, calls, completed) = list(stage, goal, originals, docs, writable, pending, brief, plan, note, turns, calls, completed, list(0, "", list(), 0, 0));
  def fcap-memory(s) = nth(s, 12);
  // Preserve the tool history and caller-owned work kind when a repair updates
  // the earlier memory slots. Model JSON cannot change the kind.
  def fcap-with-memory(s, memory) = append(append(fat-take(s, 12), list(append(memory, fat-drop(fcap-memory(s), len(memory))))), if ge(len(s), 14) then list(nth(s, 13)) else list());
  def fcap-mode(s) = if ge(len(fcap-memory(s)), 7) then nth(fcap-memory(s), 6) else "code";
  def fcap-reviewing(s) = str_eq(fcap-mode(s), "review");
  def fcap-report(s) = if ge(len(fcap-memory(s)), 8) then nth(fcap-memory(s), 7) else "";
  // This snapshot belongs to one admitted model context. Reset it at admission,
  // including checkpoint resume; source edits do not update it implicitly.
  def fcap-context-docs(s) = if ge(len(fcap-memory(s)),9) then nth(fcap-memory(s),8) else list();
  def fcap-context-instructions(s) = if ge(len(fcap-memory(s)),10) then nth(fcap-memory(s),9) else list();
  def fcap-native-repairs(s) = if ge(len(fcap-memory(s)),11) then nth(fcap-memory(s),10) else list();
  def fcap-report-source(s) = if ge(len(fcap-memory(s)),12) then nth(fcap-memory(s),11) else "submitted";
  def fcap-provenance(s,events,source) = fcap-with-memory(s,list(fcap-failures(s),fcap-evidence(s),fcap-reflections(s),fcap-checks(s),fcap-repeat(s),fcap-tool-history(s),fcap-mode(s),fcap-report(s),fcap-context-docs(s),fcap-context-instructions(s),events,source));
  def fcap-record-native(s,method,status,observation,source) = fcap-provenance(s,append(fcap-native-repairs(s),list(list(method,status,observation,fcap-checks(s)))),source);
  // Exact reports and their own checker results stay paired. These records are
  // returned to the caller, not automatically injected into model context.
  def fcap-report-check-evidence(report,result) = list(report,if fcap-check-shape?(result) then result else list());
  def fcap-record-native-evidence(s,method,status,observation,source,before,after) = fcap-provenance(s,append(fcap-native-repairs(s),list(list(method,status,observation,fcap-checks(s),before,after))),source);
  def fcap-begin-context(s) = fcap-with-memory(s,list(fcap-failures(s),fcap-evidence(s),fcap-reflections(s),fcap-checks(s),fcap-repeat(s),fcap-tool-history(s),fcap-mode(s),fcap-report(s),fcap-docs(s),list(fcap-work-instruction(s))));
  // Only a completed observation admits its instruction to this context.
  // Bootstrap always carries full instructions, including after resume.
  def fcap-observation-admitted(s,before,after,live) = if and(live,eq(after,add(before,1))) then fcap-admit-instruction(s) else s;
  def fcap-admit-instruction(s) = if or(lt(len(fcap-memory(s)),9),fat-has(fcap-context-instructions(s),fcap-work-instruction(s))) then s else fcap-with-memory(s,append(fat-take(fcap-memory(s),9),list(append(fcap-context-instructions(s),list(fcap-work-instruction(s))))));
  def fcap-observation-instruction(s) {
   let full = fcap-work-instruction(s);
   let reference = "Continue the supplied instructions for this role and the original caller requirements.";
   if and(fat-has(fcap-context-instructions(s),full),lt(str_len(reference),str_len(full))) then reference else full;
  }
  def fcap-with-report(s, report) = fcap-provenance(fcap-with-memory(s, append(fat-take(fcap-memory(s), 7), list(report))),fcap-native-repairs(s),"submitted");
  def fcap-inherit(s, next) = append(fat-take(fcap-with-memory(next, fcap-memory(s)), 13), if ge(len(s), 14) then list(nth(s, 13)) else list());
  def fcap-failures(s) = head(fcap-memory(s));
  def fcap-evidence(s) = nth(fcap-memory(s), 1);
  def fcap-reflections(s) = nth(fcap-memory(s), 2);
  def fcap-checks(s) = nth(fcap-memory(s), 3);
  def fcap-repeat(s) = nth(fcap-memory(s), 4);
  def fcap-count-check(s) = fcap-with-memory(s, list(fcap-failures(s), fcap-evidence(s), fcap-reflections(s), add(fcap-checks(s), 1), fcap-repeat(s)));
  def fcap-stage(s) = nth(s, 0);
  def fcap-docs(s) = nth(s, 3);
  def fcap-note(s) = nth(s, 8);
  def fcap-turns(s) = nth(s, 9);
  def fcap-calls(s) = nth(s, 10);
  def fcap-done(s) = or(str_eq(fcap-stage(s), "complete"), str_eq(fcap-stage(s), "attention"));
  def fcap-move(s, stage, docs, pending, brief, plan, note, calls, completed) = fcap-inherit(s, fcap-state(stage, nth(s, 1), nth(s, 2), docs, nth(s, 4), pending, brief, plan, note, add(fcap-turns(s), 1), calls, completed));
  def fcap-note-at(s, stage, note) = fcap-move(s, stage, fcap-docs(s), nth(s, 5), nth(s, 6), nth(s, 7), note, fcap-calls(s), nth(s, 11));
  def fcap-open(goal, docs, writable) = fcap-state("refine", goal, docs, docs, writable, list(), "", "", "Ground first; keep the original goal authoritative.", 0, 0, 0);
  def fcap-direct-task() = "Complete the original caller goal supplied in this context, including its explicitly requested tool calls.";
  def fcap-open-direct-code(goal,docs,writable) = fcap-state("implement",goal,docs,docs,writable,list(fcap-direct-task()),"","","Implement the caller's supplied task. Review and native checks still decide completion; failed checks retain the existing repair and replanning path.",0,0,0);
  def fcap-open-review(goal, docs) {
   let state = fcap-open(goal, docs, list());
   fcap-with-memory(state, append(fcap-memory(state), list(list(list(), 0), "review", "")));
  }
  def fcap-open-direct-review(goal,docs) = fcap-inherit(fcap-open-review(goal,docs),fcap-state("review",goal,docs,docs,list(),list(),"","","Inspect the supplied evidence and submit the report. Read-only tools and verify are available.",0,0,0));
  def fcap-terminal(s, reason) = fcap-inherit(s, fcap-state("attention", nth(s, 1), nth(s, 2), fcap-docs(s), nth(s, 4), nth(s, 5), nth(s, 6), nth(s, 7), reason, fcap-turns(s), fcap-calls(s), nth(s, 11)));
  def fcap-control(id, observation, action) {
   let out = bfc-envelope(0, id, 0, observation, 3);
   let sent = bfc-record-out(out, 0);
   let reply = bfc-control(out, action);
   let received = bfc-record-in(reply, 0);
   if and(eq(bfc-exchange(reply), id), and(eq(bfc-direction(reply), 1), eq(bfc-kind(reply), 1))) then bfc-payload(reply) else 3;
  }
  def fcap-revise(s, reason) {
   let action = fcap-control(add(now_unix_ms(), fcap-turns(s)), list(fcap-turns(s), fcap-calls(s)), 2);
   if eq(action, 2) then fcap-note-at(s, fcap-stage(s), reason) else fcap-terminal(s, "diagnostic-control-unavailable");
  }
  def fcap-readonly(tool) = fat-has(list("rg", "jq", "read", "cat", "head", "tail", "wc", "sort", "uniq", "tr", "cut", "awk", "sed"), tool);
  def fcap-tool-allowed(s, tool, args) = if fcap-readonly(tool) then 1 else if or(fcap-reviewing(s), not(str_eq(fcap-stage(s), "implement"))) then 0 else if not(fat-has(list("edit", "write"), tool)) then 0 else if nil?(args) then 0 else fat-has(nth(s, 4), head(args));
  def fcap-readonly-preserved(originals, docs, writable) = if nil?(originals) then 1 else and(if fat-has(writable, nth(head(originals), 1)) then 1 else value_eq(head(originals), fat-find-doc(docs, nth(head(originals), 1))), fcap-readonly-preserved(tail(originals), docs, writable));
  def fcap-tool(s, obj) = if not(fcap-string-array(json-object-get(obj, "arguments"))) then fcap-revise(s, "Tool arguments must be an array of strings.") else if and(json-object-has?(obj, "input"), not(fat-wire-string?(json-object-get(obj, "input")))) then fcap-revise(s, "Tool input must be a string.") else fcap-tool-ready(s, fcap-string(obj, "tool"), fcap-array(obj, "arguments"), fcap-string(obj, "input"));
  def fcap-tool-ready(s, tool, args, input) = if not(fcap-tool-allowed(s, tool, args)) then fcap-revise(s, "Tool unavailable in this role or target is not caller-writable.") else fcap-tool-observed(s, tool, args, input, fat-call(fcap-docs(s), tool, args, input));
  def fcap-tool-history(s) = if ge(len(fcap-memory(s)), 6) then nth(fcap-memory(s), 5) else list(list(), 0);
  def fcap-tool-observed(s, tool, args, input, result) {
   let signature = list(tool, args, input, fat-exit(result), fat-out(result), fat-error(result));
   let history = fcap-tool-history(s);
   let same = and(value_eq(signature, head(history)), value_eq(fcap-docs(s), fat-documents(result)));
   let count = if same then add(nth(history, 1), 1) else 1;
   let next = fcap-tool-result-noted(s,result,fcap-tool-note(s,tool,args,result));
   let tracked = fcap-with-memory(next, append(fat-take(fcap-memory(next), 5), list(list(signature, count))));
   if lt(count, 3) then tracked else fcap-no-progress(tracked);
  }
  def fcap-no-progress(s) {
   let next = fcap-repair-state(s, "The same native tool, arguments and result repeated without a document change. Diagnose the missing evidence and choose next=plan; repeating the call is not progress.");
   fcap-with-memory(next, append(list(fcap-failures(next), fcap-evidence(next), fcap-reflections(next), fcap-checks(next), 1), list(fcap-tool-history(next))));
  }
  def fcap-result-note(result) = json-emit(json-node-object(list(json-node-pair("exit",json-node-int(fat-exit(result))),json-node-pair("stdout",json-node-string(fat-out(result))),json-node-pair("stderr",json-node-string(fat-error(result))))));
  def fcap-tool-note(s,tool,args,result) = if and(str_eq(tool,"read"),eq(len(args),1)) then fcap-read-note(fat-find-doc(fcap-context-docs(s),head(args)),result) else fcap-result-note(result);
  def fcap-read-note(provided,result) = if nil?(provided) then fcap-result-note(result) else if not(and(eq(fat-exit(result),0),str_eq(fat-error(result),""))) then fcap-result-note(result) else if not(str_eq(fat-out(result),nth(provided,2))) then fcap-read-changed(provided,result) else json-emit(json-node-object(list(json-node-pair("exit",json-node-int(0)),json-node-pair("stderr",json-node-string("")),json-node-pair("stdout_reference",fcap-context-reference(provided)),json-node-pair("observation",json-node-string("The native read verified these exact bytes match the document already supplied to this model context. Use its provided text. cat or a focused native query remains available to inspect content again.")))));
  def fcap-context-reference(provided) = json-node-object(list(json-node-pair("id",json-node-string(head(provided))),json-node-pair("path",json-node-string(nth(provided,1))),json-node-pair("bytes",json-node-int(str_len(nth(provided,2)))),json-node-pair("scope",json-node-string("current-model-context"))));
  // One exact line splice against the admission snapshot, never against a
  // prior patch. Reconstruct and compare the actual read before emitting it.
  def fcap-common-lines(a,b,n) = if or(nil?(a),nil?(b)) then n else if not(str_eq(head(a),head(b))) then n else fcap-common-lines(tail(a),tail(b),add(n,1));
  def fcap-read-splice(before,after) {
   let prefix = fcap-common-lines(before,after,0);
   let a = fat-drop(before,prefix);
   let b = fat-drop(after,prefix);
   let suffix = fcap-common-lines(reverse(a),reverse(b),0);
   list(prefix,sub(len(a),suffix),fat-take(b,sub(len(b),suffix)));
  }
  def fcap-read-rebuild(before,splice) = fat-join(append(fat-take(before,head(splice)),append(nth(splice,2),fat-drop(before,add(head(splice),nth(splice,1))))),"\n");
  def fcap-read-changed(provided,result) {
   let before = split-on(nth(provided,2),"\n");
   let splice = fcap-read-splice(before,split-on(fat-out(result),"\n"));
   let full = fcap-result-note(result);
   let patch = json-emit(json-node-object(list(json-node-pair("exit",json-node-int(0)),json-node-pair("stderr",json-node-string("")),json-node-pair("stdout_patch",json-node-object(list(json-node-pair("base",fcap-context-reference(provided)),json-node-pair("first_line",json-node-int(add(head(splice),1))),json-node-pair("remove_lines",json-node-int(nth(splice,1))),json-node-pair("current_lines",json-node-array(fcap-string-json(nth(splice,2)))),json-node-pair("current_bytes",json-node-int(str_len(fat-out(result))))))),json-node-pair("observation",json-node-string("Exact current read, encoded as one line splice against the original document supplied at admission. Split that base on newline, replace remove_lines at the one-based first_line with current_lines, then join with newline. All other lines are unchanged. Native reconstruction matched the actual read byte-for-byte. cat returns the full current text.")))));
   if and(str_eq(fcap-read-rebuild(before,splice),fat-out(result)),lt(str_len(patch),str_len(full))) then patch else full;
  }
  def fcap-tool-result(s,result) = fcap-tool-result-noted(s,result,fcap-result-note(result));
  def fcap-tool-result-noted(s, result, note) {
   let next = if fcap-readonly-preserved(nth(s, 2), fat-documents(result), nth(s, 4)) then fat-documents(result) else fcap-docs(s);
   let moved = fcap-move(s, fcap-stage(s), next, nth(s, 5), nth(s, 6), nth(s, 7), note, add(fcap-calls(s), 1), nth(s, 11));
   if or(gt(fat-exit(result), 1), not(str_eq(fat-error(result), ""))) then fcap-repair-state(moved, str_concat("Native tool failed: ", note)) else moved;
  }
  def fcap-step(s, raw, checker) = if fcap-done(s) then s else if not(faj-valid(raw)) then fcap-revise(s, "Malformed response. Return exactly one JSON object; no markdown or commentary.") else fcap-object(s, faj-json("native-code-response", raw), checker);
  def fcap-object(s, obj, checker) = if not(fat-wire-object?(obj)) then fcap-revise(s, "Response must be an object.") else if json-object-has?(obj, "tool") then if str_eq(fcap-string(obj, "tool"), "verify") then fcap-verify-tool(s, obj, checker) else fcap-tool(s, obj) else fcap-role(s, obj, checker);
  def fcap-check-shape?(result) = if not(str_eq(value_kind(result), "list")) then 0 else if not(eq(len(result), 2)) then 0 else and(or(value_eq(head(result), 0), value_eq(head(result), 1)), str_eq(value_kind(nth(result, 1)), "string"));
  def fcap-check-passed?(result) = and(fcap-check-shape?(result), value_eq(head(result), 1));
  // verify invokes only the caller's already-bound callback. It accepts no
  // source, command, path or replacement contract from the model.
  def fcap-verify-tool(s, obj, checker) = if not(fcap-string-array(json-object-get(obj, "arguments"))) then fcap-revise(s, "verify arguments must be an empty array.") else if not(nil?(fcap-array(obj, "arguments"))) then fcap-revise(s, "verify takes no arguments; the caller owns its checks.") else if and(json-object-has?(obj, "input"), not(and(fat-wire-string?(json-object-get(obj, "input")), str_eq(fcap-string(obj, "input"), "")))) then fcap-revise(s, "verify takes no input; the caller owns its checks.") else fcap-verify-observed(s, fcap-source-check(s, checker));
  def fcap-source-check(s, checker) = if ge(len(checker), 4) then fcap-check(nth(checker, 2), nth(checker, 3), fcap-docs(s)) else if fcap-reviewing(s) then list(0, "No source-only verification callback was supplied; the report checker runs on submission.") else fcap-check(head(checker), nth(checker, 1), fcap-docs(s));
  def fcap-verify-observed(s, result) = fcap-verify-counted(fcap-count-check(s), result);
  def fcap-verify-counted(s, result) = if not(fcap-check-shape?(result)) then fcap-terminal(s, "caller-checker-returned-malformed-result") else fcap-tool-observed(s, "verify", list(), "", fat-result(if head(result) then 0 else 2, nth(result, 1), if head(result) then "" else "caller verification refused", fcap-docs(s)));
  def fcap-role(s, obj, checker) = if str_eq(fcap-stage(s), "refine") then fcap-refine(s, fcap-string(obj, "brief")) else if str_eq(fcap-stage(s), "plan") then fcap-plan(s, fcap-string(obj, "plan")) else if str_eq(fcap-stage(s), "split") then fcap-split(s, obj) else if str_eq(fcap-stage(s), "implement") then fcap-implemented(s, obj) else if str_eq(fcap-stage(s), "review") then fcap-review(s, obj, checker) else if str_eq(fcap-stage(s), "repair") then fcap-review-repair(s, obj, checker) else fcap-terminal(s, "unknown-stage");
  def fcap-review-repair(s,obj,checker) = if and(fcap-reviewing(s),json-object-has?(obj,"report")) then fcap-review(s,obj,checker) else fcap-repair(s,obj);
  def fcap-refine(s, brief) = if eq(str_len(fat-trim(brief)), 0) then fcap-revise(s, "Return a nonempty brief preserving the original goal and constraints.") else fcap-move(s, "plan", fcap-docs(s), list(), brief, "", "Now plan from the original goal, brief and evidence.", fcap-calls(s), 0);
  def fcap-plan(s, plan) = if eq(str_len(fat-trim(plan)), 0) then fcap-revise(s, "Return a nonempty plan including verification and dependencies.") else fcap-move(s, "split", fcap-docs(s), list(), nth(s, 6), plan, "Split into ordered, concrete tasks; avoid unnecessary fragmentation.", fcap-calls(s), nth(s, 11));
  def fcap-split(s, obj) = if not(fcap-string-array(json-object-get(obj, "tasks"))) then fcap-revise(s, "tasks must be a nonempty array of task strings in dependency order.") else fcap-split-tasks(s, fcap-array(obj, "tasks"));
  def fcap-split-tasks(s, tasks) = if or(nil?(tasks), not(fcap-nonempty(tasks))) then fcap-revise(s, "No empty tasks; each task must name observable work.") else fcap-move(s, "implement", fcap-docs(s), tasks, nth(s, 6), nth(s, 7), if fcap-reviewing(s) then "Inspect the first pending task using read-only native tools; preserve every document." else "Implement the first pending task using native tools.", fcap-calls(s), nth(s, 11));
  def fcap-implemented(s, obj) = if not(str_eq(fcap-string(obj, "task"), "done")) then fcap-revise(s, "Use a native tool or return task=done after this task is implemented.") else if nil?(nth(s, 5)) then fcap-revise(s, "Pending task state is absent.") else fcap-move(s, if nil?(tail(nth(s, 5))) then "review" else "implement", fcap-docs(s), tail(nth(s, 5)), nth(s, 6), nth(s, 7), if nil?(tail(nth(s, 5))) then "Review the actual documents against the original goal; inspect edge cases." else "Continue with the next pending task.", fcap-calls(s), add(nth(s, 11), 1));
  def fcap-check(callback, contract, docs) = callback(contract, docs);
  def fcap-report-text(obj) = if or(fat-wire-object?(json-object-get(obj,"report")),fat-wire-array?(json-object-get(obj,"report"))) then json-emit(json-object-get(obj,"report")) else fcap-string(obj,"report");
  def fcap-review(s, obj, checker) = if and(fcap-reviewing(s),not(json-object-has?(obj,"verdict"))) then fcap-review-report(s,if json-object-has?(obj,"report") then fcap-report-text(obj) else json-emit(obj),checker) else if str_eq(fcap-string(obj, "verdict"), "reject") then if eq(str_len(fat-trim(fcap-string(obj, "reason"))), 0) then fcap-revise(s, "A rejection needs concrete findings.") else fcap-review-findings(s,fcap-string(obj,"reason")) else if not(str_eq(fcap-string(obj, "verdict"), "accept")) then fcap-revise(s, "Return verdict=accept or reject and a concrete reason.") else if fcap-reviewing(s) then fcap-review-report(s,fcap-report-text(obj),checker) else if value_eq(nth(s, 2), fcap-docs(s)) then fcap-rework(s, "No implementation change exists; a verbal acceptance is not completion.") else fcap-submit(s, checker);
  def fcap-review-findings(s,reason) = if not(fcap-reviewing(s)) then fcap-rework(s,str_concat("Review findings: ",reason)) else fcap-revise(s,str_concat("Read-only finding retained: ",str_concat(reason,"\nThe inspected source stays unchanged. Negative findings belong in your report. Inspect further if needed, then submit the requested report as one JSON object containing these findings and any proposed correction. Submitting it runs the caller's checks; it does not approve the inspected source.")));
  def fcap-review-report(s, report, checker) = if not(value_eq(nth(s, 2), fcap-docs(s))) then fcap-terminal(s, "read-only-review-documents-changed") else if eq(str_len(fat-trim(report)), 0) then fcap-revise(s, "Submit a nonempty report; a phase verdict is not the review result.") else fcap-submit(fcap-with-report(s, report), checker);
  // A review checker receives [documents, report]; a coding checker retains
  // its original documents-only signature. Neither is supplied by the model.
  def fcap-check-state(s, checker) = fcap-check(head(checker), nth(checker, 1), if fcap-reviewing(s) then list(fcap-docs(s), fcap-report(s)) else fcap-docs(s));
  def fcap-submit(s, checker) = fcap-submitted(fcap-count-check(s),checker,fcap-check-state(s,checker));
  // Optional checker entries 4/5 are a caller-owned native repair callback and
  // contract. The model cannot supply either. One attempt per failed submission;
  // every changed report runs the original complete checker again.
  def fcap-submitted(s,checker,result) = if and(fcap-reviewing(s),and(ge(len(checker),6),and(fcap-check-shape?(result),not(head(result))))) then fcap-native-attempt(fcap-verified(s,result),checker,result) else fcap-verified(s,result);
  def fcap-native-attempt(s,checker,failed) = if fcap-done(s) then s else {
   let callback = nth(checker,4);
   let proposal = callback(nth(checker,5),list(fcap-docs(s),fcap-report(s),nth(failed,1)));
   let next = fcap-native-proposed(s,checker,proposal,fcap-report-check-evidence(fcap-report(s),failed));
   // Native work stays inside this submitted turn; its checks have their own count.
