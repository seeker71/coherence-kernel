  def fcap-report-check-evidence(report,result) = list(report,fcap-check-shape?(result) ? result : list());
  def fcap-record-native-evidence(s,method,status,observation,source,before,after) = fcap-provenance(s,append(fcap-native-repairs(s),list(list(method,status,observation,fcap-checks(s),before,after))),source);
  def fcap-begin-context(s) {
   let begun = fcap-native-context-start(fcap-with-memory(s,list(fcap-failures(s),fcap-evidence(s),fcap-reflections(s),fcap-checks(s),fcap-repeat(s),fcap-tool-history(s),fcap-mode(s),fcap-report(s),fcap-admission-docs(s),list(fcap-work-instruction(s)))));
   fcap-admit-evidence(fcap-with-context-evidence(begun,""));
  }
  // Only a completed observation admits its instruction to this context.
  // Bootstrap always carries full instructions, including after resume.
  def fcap-observation-admitted(s,before,after,live) = live && ((Comparable) after == (before + 1)) ? fcap-native-context-admitted(fcap-admit-evidence(fcap-admit-instruction(s))) : s;
  def fcap-admit-instruction(s) = (len(fcap-memory(s)) < 9) || fat-has(fcap-context-instructions(s),fcap-work-instruction(s)) ? s : fcap-with-memory(s,append(fat-take(fcap-memory(s),9),list(append(fcap-context-instructions(s),list(fcap-work-instruction(s))))));
  def fcap-observation-instruction(s) {
   let full = fcap-work-instruction(s);
   let reference = "Continue the supplied instructions for this role and the original caller requirements.";
