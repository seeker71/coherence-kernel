   let fields = json-object-pairs(parse-json("native-verification-result",fcap-result-note(result)));
   let source = list(json-node-pair("checked_documents",json-node-array(fcap-checked-documents(fcap-docs(s)))),json-node-pair("verification_scope",json-node-string("Exact resident documents supplied to this native verification call. The caller's result remains authoritative.")));
   json-emit(json-node-object(append(fields,source)));
  }
  def fcap-guard-note(s,tool,args,result) {
