  }
  def fcap-last-native(s) = head(reverse(fcap-native-repairs(s)));
  def fcap-awaiting-native-review(s) = !(fcap-reviewing(s) && (((String) fcap-stage(s) == "review") && ((String) fcap-report-source(s) == "caller-native-repair"))) ? 0 : nil?(fcap-native-repairs(s)) ? 0 : ((String) fcap-last-native(s)[1] == "accepted-for-review");
  def fcap-native-context-start(s) = nil?(fcap-native-repairs(s)) ? s : fcap-with-native-submission(fcap-with-native-context(s,len(fcap-native-repairs(s))),0);
  def fcap-native-context-admitted(s) = fcap-awaiting-native-review(s) ? fcap-with-native-context(s,len(fcap-native-repairs(s))) : s;
  def fcap-provenance(s,events,source) = fcap-with-memory(s,list(fcap-failures(s),fcap-evidence(s),fcap-reflections(s),fcap-checks(s),fcap-repeat(s),fcap-tool-history(s),fcap-mode(s),fcap-report(s),fcap-context-docs(s),fcap-context-instructions(s),events,source));
  def fcap-record-native(s,method,status,observation,source) = fcap-provenance(s,append(fcap-native-repairs(s),list(list(method,status,observation,fcap-checks(s)))),source);
  // Exact reports and their own checker results stay paired. These records are
  // returned to the caller. An explicit continuation also admits the newest
