  def fcap-context-reference(provided) = json-node-object(list(json-node-pair("id",json-node-string(head(provided))),json-node-pair("path",json-node-string(provided[1])),json-node-pair("bytes",json-node-int(str_len(provided[2]))),json-node-pair("scope",json-node-string("current-model-context"))));
