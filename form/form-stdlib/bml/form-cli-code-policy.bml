     let exact=value_kind(key)=="list" ? nothing() : fcap-context-child(root,key);
      let found=value_kind(key)=="list" ? fcap-context-path(root,key) : !nothing?(exact) ? exact : value_kind(key)=="string" && str_find(key,".",0)>=0 ? fcap-context-path(root,split-on(key,".")) : nothing();
     if nothing?(found) then fcap-context-unease("existing field or index",record_new(0,"path",key,"shape",ftv-node-result(root))) else {
      let name=kind(found);
      let value=name=="ftw-record" || name=="ftw-list" || fat-wire-object?(found) || fat-wire-array?(found) ? found : fat-wire-string?(found) || faj-type(found)=="number" || faj-type(found)=="boolean" ? node_value(found) : node_eq(found,json-node-null()) ? nothing() : ftw-decode(found);
       value_kind(value)=="node_id" ? ftv-hold(lane,value) : value_kind(value)=="string" && (len(value)>ftv-max-render() || ftv-carries-control?(value)) ? ftv-hold(lane,found) : value;
     };
  }
  // Walk the existing cells: decode keys and leaves, never the whole context.
  def fcap-context-child(node,key) {
   if nothing?(node) then nothing() else {
    let name=kind(node); let kids=node_children(node);
    if name=="ftw-record" then fcap-context-pair(kids,key)
    else if fat-wire-object?(node) then value_kind(key)!="string" ? fcap-context-unease("string record key",key) : json-object-has?(node,key) ? json-object-get(node,key) : nothing()
    else if name=="ftw-list" || fat-wire-array?(node) then value_kind(key)!="int" ? fcap-context-unease("integer list index",key) : key>=-len(kids) && key<len(kids) ? kids[key] : nothing()
    else if name=="ftw-node" then fcap-context-child(kids[0],key)
    else if name=="ftw-nothing" then nothing()
    else fcap-context-unease("record or list",name);
   };
  }
  def fcap-context-pair(kids,key) = nil?(kids) ? nothing() : ftw-decode(kids[0])==key ? kids[1] : fcap-context-pair(kids[2:],key);
  def fcap-context-unease?(node) = value_kind(node)=="node_id" && kind(node)=="ftw-record" && !nothing?(fcap-context-pair(node_children(node),"kind")) && ftw-decode(fcap-context-pair(node_children(node),"kind"))=="context-unease";
  def fcap-context-path(node,path) = fcap-context-path-at(node,path,path);
  def fcap-context-path-at(node,path,original) {
   if nil?(path) || nothing?(node) || fcap-context-unease?(node) then node else {
    let part=path[0];
    let key=(kind(node)=="ftw-list" || fat-wire-array?(node)) && value_kind(part)=="string" && str_to_int(part).str()==part ? str_to_int(part) : part;
    let child=fcap-context-child(node,key);
    let next=nothing?(child) ? fcap-context-unease("existing field or index",record_new(0,"path",original,"at",key,"shape",ftv-node-result(node))) : fcap-context-unease?(child) ? fcap-context-failed-path(child,original) : child;
    fcap-context-path-at(next,path[1:],original);
   };
  }
  def fcap-context-failed-path(node,path) {
   let reading=ftw-decode(node);
   record_set(reading,"path",path);
   ftw-encode(reading);
  }
  def fcap-context-unease(needed,observed) {
   let node=ftw-encode(record_new(0,"kind","context-unease","needed",needed,"observed",observed,"current","Each path component descends into the preceding value; query peer fields separately. Use code_context for current role, pending and observation; task_context holds admitted sources and goal. Choose a valid path or submit a focused read action. List indexes are integers. Do not traverse this diagnostic as source data."));
   fb_record(node,"coding-context-unease",1);
   node;
  }
  def fcap-model-organs(lane) {
    ftv-offer(lane,"fcap-context-field",2,a=>fcap-context-field(a[0],a[1]));
   ftv-offer(lane,"fcap-native-tool",3,a=>fcap-native-tool(a[0],a[1],a[2]));
   ftv-offer(lane,"fcap-native-reply",1,a=>fcap-native-reply(a[0]));
   lane;
  }
  def fcap-model-visible(node) {
   if fat-wire-object?(node) then {
   let fields=["path","resident_sha256","start_byte","end_byte","message","needed","next","stdout_reference","observation","stdout","stderr","detail","guard_evidence"] |> filter(k=>json-object-has?(node,k)) |> map(k=>{
     let value=json-object-get(node,k);
      let whole=k=="stdout" && json-object-has?(node,"path") && !json-object-has?(node,"start_byte");
      let structured=k=="stdout" && json-object-has?(node,"value");
      k + ": " + (fat-wire-string?(value) && len(node_value(value))>ftv-max-render() && (whole || structured) ? ftv-node-result(ftv-hold(ftg-lane-session("code"),value)) : fcap-model-visible(value));
    });
    ftv-node-result(ftv-hold(ftg-lane-session("code"),node)) + (json-object-has?(node,"change") ? "\nAttention: " + fcap-string(node,"change") : "") + (nil?(fields) ? "" : "\n"+fields.join("\n"));
   } else if fat-wire-array?(node) then ftv-node-result(ftv-hold(ftg-lane-session("code"),node)) else fat-wire-string?(node) ? node_value(node) : json-emit(node);
  }
  def fcap-model-bind(name,obj) {
     let lane=fcap-model-organs(ftg-lane-session("code"));
     let node=ftv-hold(lane,fcap-model-cell(obj));
     ftw-put(ftv-ws(lane),"local",name,"node",node);
     node;
  }
  def fcap-model-packet(obj) {
     let name=json-object-has?(obj,"goal") ? "task_context" : json-object-has?(obj,"role") ? "code_context" : json-object-has?(obj,"source_observations") ? "source_context" : "code_budget";
     let node=fcap-model-bind(name,obj);
    let address=ftw-coord(node);
    let fields=(json-object-pairs(node) |> map(json-pair-key)).join(", ");
    let visible=["goal","brief","plan","role","instruction","observation","replan_required","repair_attempts","budget_instruction"] |> filter(k=>json-object-has?(node,k)) |> map(k=>k + ": " + fcap-model-visible(json-object-get(node,k)));
    let catalog=json-object-get(node,"document_catalog");
    let paths=fat-wire-array?(catalog) ? node_children(catalog) |> map(doc=>fcap-string(doc,"path") + " (" + node_value(json-object-get(doc,"bytes")).str() + " bytes)") : [];
    let writable=json-object-get(node,"writable");
   name + " = " + address + ";\nfields: " + fields + "\n" + visible.join("\n") + (nil?(paths) ? "" : "\nResident paths:\n"+paths.join("\n")) + (fat-wire-array?(writable) ? "\nWritable: " + (node_children(writable) |> map(value=>node_value(value))).join(", ") : "") + "\n";
  }
  // Caller corrections outlive the transient tool/check failure at the cursor.
  // Admission restores every retained event, including after context renewal.
  def fcap-caller-feedback(s) = if (len(fcap-memory(s)) >= 25) then fcap-memory(s)[24] else [];
  // the newest four, each bounded; the older ones are named by their count, never carried whole
  def fcap-caller-feedback-json(rows) = append(len(rows) > 4 ? [json-node-object([json-node-pair("id",json-node-string("omitted")),json-node-pair("text",json-node-string(((len(rows) - 4).str() + " earlier observations are omitted; a later repair may have resolved them.")))])] : [],drop(max2(0,len(rows) - 4),rows) |> map(row => json-node-object([json-node-pair("id",json-node-string(row[0])),json-node-pair("text",json-node-string(fcctg-squeeze(row[1],1200)))])));
  def fcap-caller-feedback-pairs(s) = if nil?(fcap-caller-feedback(s)) then [] else [json-node-pair("caller_feedback",json-node-array(fcap-caller-feedback-json(fcap-caller-feedback(s)))),json-node-pair("caller_feedback_scope",json-node-string("Retained observations from earlier source states. Later repairs can resolve them. Compare each with current source and native verification before asserting that the reported condition still holds."))];
  def fcap-model-lane(s) = fcap-reviewing(s) ? ftg-bind-once("", "") : ftg-bind-once("code",fcam-managed(s) ? fcam-id(s) : "");
  // How the lane teaches a tool call. "tool" is the control table's own verb (form-token-tool.bml): the call is spoken as
  // words and a verbatim block and read by one cursor into the call cell. "eval" is the constructor spelled in a BML eval.
  // FORM_CODE_CALL_FORM names the form (tool | eval). The default is tool: measured on the local Qwen3.8-27B-Q8_0 through
  // this lane (docs/form-native-agent-tools.md), every tool call it wrote in that form read and ran at the first try, and the
  // turns the eval spelling spent on reading context fields before its first call were not spent. eval stays for comparison.
  // A JSON reply is not a form: the live lane answers it with the no-action note.
  def fcap-call-form() = fcap-call-named((host_getenv("FORM_CODE_CALL_FORM") ?? ""));
  def fcap-call-named(name) = name == "eval" ? "eval" : "tool";
  def fcap-call-name(tool,word) = fcap-call-form() == "tool" ? ftg-render("tool",tool + " " + word) : "fcap-native-tool(\"" + tool + "\",[\"" + word + "\"],\"\")";
  def fcap-call-head() = fcap-call-form() == "tool"
   ? "A tool call is " + ftg-render("tool","read path 1 20") + ": the tool's name, its words (bare, \"quoted\" or an @address of a text cell), and for edit and write a block on the lines after, written exactly as the file holds it, nothing escaped: " + ftg-render("tool","edit path\n<<<<\nspan to replace\n====\nnew text\n>>>>\n") + " The span is the file's own bytes: a quote or a backslash in it is written as the file holds it. A whole-document replacement guarded by the resident hash names the hash as a word and carries the new text alone: " + ftg-render("tool","edit path sha256 HASH\n<<<<\nthe whole new text\n>>>>\n") + " The control executes the call inside this decode stream; Form saves its effects and returns the actual result cell with refreshed code_context. Continue from that observation with another needed tool or the current role reply; no outside caller reads or guides the next step. A call that does not read answers nothing=tool-... naming what failed; send the corrected call. "
   : ftg-render("eval","fcap-native-tool(\"read\",[\"path\",\"1\",\"20\"],\"\")") + " executes the returned tool cell immediately inside this decode stream. Form saves its effects and returns the actual result cell with refreshed code_context. Continue from that observation with another needed tool or the current role reply; no outside caller reads or guides the next step. ";
  def fcap-call-missing() = fcap-call-form() == "tool" ? "a complete Form tool call, or a Form eval returning fcap-native-reply" : "a complete Form eval returning fcap-native-tool or fcap-native-reply";
  def fcap-call-whole-read() = fcap-call-form() == "tool" ? "A whole read is the path alone. " : "A whole read uses [path]. ";
  def fcap-bootstrap(s) {
   let lane=fcap-model-lane(s);
   let source = if fcap-catalog?(s) then json-node-pair("document_catalog",json-node-array(fcap-document-catalog(fcap-docs(s)))) else json-node-pair("documents",json-node-array(fcap-model-documents(fcap-docs(s))));
   let retained = append(fcap-caller-feedback-pairs(s),if fcap-amendable(s) then [json-node-pair("retained_report",json-node-string(fcap-report(s)))] else []);
   let body = json-node-object(append(retained,[json-node-pair("goal", json-node-string(s[1])), json-node-pair("writable", json-node-array(fcap-string-json(s[4]))), source, json-node-pair("brief", json-node-string(s[6])), json-node-pair("plan", json-node-string(s[7])), json-node-pair("prior_repairs", json-node-array(fcap-prior-repairs-json(fat-take(reverse(fcap-reflections(s)), 3)))),json-node-pair("native_source_verification",fcap-source-reading(s))]));
     let protocol = "You are the local Qwen coding member inside Form. Submit one native node for the CURRENT role. " + fcap-call-head() + fcrg-submit("[[\"task\",\"done\"]]") + " for role fields, following the current role instruction. Stop after the complete role reply. Do not echo its address. Use native BML strings, no markdown fences. Original goal and caller constraints stay authoritative. Read fields with fcap-context-field(code_context,\"field-name\"). The second argument may be a dotted path or a nested path list; no third argument. Query peer fields separately. Current work is code_context: [\"pending\",0] or [\"observation\",\"stdout\"]. task_context holds goal and sources. Exact dotted keys take precedence. List indexes are integers. Large text stays a native cell. An @address already reads its value: use substring(@address,start,end) for focused text, without node_value. A cell returned directly into a variable uses node_value(cell). Bound names follow current context; historical coordinates belong to earlier observations. Context/data reads supply evidence; they do not submit tasks. Native tools: " + str-join-with(fat-tools(),", ") + ". Read offset is one-based, count is lines, optional fourth argument bytes. " + fcap-call-whole-read();
    let authority = "Tools read caller-supplied resident documents by exact catalog id or path, not host scratch paths. write creates absent paths; arguments=[path], input=new text. Existing documents, including empty ones, use edit. For whole replacement, edit arguments=[path,\"sha256\",resident_sha256,new_text], input=\"\"; the catalog or a read supplies that guard. Read-only tools are allowed in every role. Implement and repair may edit caller-writable paths; a changed repair runs caller checks immediately. Repeated counterexamples require next=plan or next=split before more edits. Failed tools/checks enter repair: act on the evidence or name a changed approach and route. failure_evidence may reference its matching failure_evidence_id already supplied in this context; use those exact earlier bytes. Keep replies concise and tasks few. Do not invent successful checks. ";
   let guidance = fcap-call-name("bml-api","function-name") + " supplies native declaration, path, line and source fingerprint cells under code_context.observation.value.symbols. Use fcap-context-field to read them; rg -n finds related calls. Read the relevant function, callers and ownership contract. Retain the learned design in your plan before context renewal. Ask " + fcap-call-name("help","bml") + " for guidance: " + str-join-with(fcap-guides() |> map(row=>row[0]),", ") + ". Form owns tools, choices, checkpoints, checks and release. edit arguments are [path,old,new], input is empty: replace a resident span. Read help edit for matching details, help bml for authoring, help form for native controls and help meaning for shared Form meanings. ";
   let rules = protocol + "Structured tool results live in code_context.observation.value. Read those native fields directly. stdout is text already produced and stays empty when no text was rendered. " + guidance + authority;
   let verification = "The native verify tool takes arguments=[] and no input. It runs the caller's existing source checks; it cannot execute a command supplied by you. Review mode is read-only and returns a report, never a source edit. Documents below are already present in this context. A read may return stdout_reference for identical bytes or stdout_patch with exact changed lines against the original supplied document. Native reconstruction verifies the current bytes before either compact result is emitted. Resolve each against its original supplied text. Oversized source reads return exact stdout in observation_excerpt with source byte coordinates, resident_sha256 and next: an executable continuation. Read that content and call next only for missing evidence. Query excerpts use clipped head/tail, not whole source.\n";
   let catalogVerification = "The native verify tool takes arguments=[] and no input. It runs the caller's existing source checks; it cannot execute a command supplied by you. Review mode is read-only and returns a report, never a source edit. The document catalog lists source identities. NATIVE SOURCE OBSERVATIONS supply actual admitted query results. Use evidence already supplied and retrieve a specific missing fact. Oversized source reads return exact stdout in observation_excerpt with source byte coordinates, resident_sha256 and next: an executable continuation. Read that content and call next only for missing evidence. All original documents stay whole for native tools and unchanged caller checks.\n";
    rules + (fcap-reviewing(s) || !fcbmr-relevant(fcap-docs(s)) ? "" : "BML repair-bml, lift-bml and rehearse-bml tools remain available. Read their native help before use. ") + (fcap-catalog?(s) ? catalogVerification : verification) + fcap-model-packet(body) + fcap-model-packet(fcap-observation-node(s)) + fcap-source-context(s) + "\nCURRENT REPLY: " + fcap-work-instruction(s);
  }
 }
 0;
}
