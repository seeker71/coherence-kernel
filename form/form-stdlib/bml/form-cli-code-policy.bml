  def fcap-with-memory(s, memory) = append(append(fat-take(s, 12), list(append(memory, fat-drop(fcap-memory(s), len(memory))))), len(s) >= 14 ? list(s[13]) : list());
  def fcap-mode(s) = len(fcap-memory(s)) >= 7 ? fcap-memory(s)[6] : "code";
  def fcap-reviewing(s) = (String) fcap-mode(s) == "review";
  def fcap-report(s) = len(fcap-memory(s)) >= 8 ? fcap-memory(s)[7] : "";
  // This snapshot belongs to one admitted model context. Reset it at admission,
  // including checkpoint resume; source edits do not update it implicitly.
  def fcap-context-docs(s) = len(fcap-memory(s)) >= 9 ? fcap-memory(s)[8] : list();
  def fcap-context-instructions(s) = len(fcap-memory(s)) >= 10 ? fcap-memory(s)[9] : list();
  def fcap-native-repairs(s) = len(fcap-memory(s)) >= 11 ? fcap-memory(s)[10] : list();
  def fcap-report-source(s) = len(fcap-memory(s)) >= 12 ? fcap-memory(s)[11] : "submitted";
  def fcap-context-native-review(s) = len(fcap-memory(s)) >= 13 ? fcap-memory(s)[12] : 0;
  def fcap-context-native-submission(s) = len(fcap-memory(s)) >= 14 ? fcap-memory(s)[13] : 0;
  // Holding source bytes does not attest that a model has received them.
