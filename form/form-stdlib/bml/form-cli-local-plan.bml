   if (!flp-held?(a)) then flp-with-readings(a, before, a[4]) else if (!flp-held?(b)) then flp-with-readings(b, before, append(a[4], b[4])) else if (common > 0) then flp-with-readings(flp-refused(3, mc-cat(["claim-holds-under-stubs:", common.str()]), mc-cat(["The claims with bits summing to ", common.str(), " hold with each named definition a stub, both answering (nothing) (the band reads ", a[4][0].str(), ") and answering its first argument (", b[4][0].str(), "): they test nothing the gap changes. Every claim must fail for a stub."])), before, append(a[4], b[4])) else flp-with-readings(flp-held(), before, append(a[4], b[4]));
  }
  // ── the verification: cheapest first ──
  def flp-verify(plan, req, ctx, planner, stamp) {
   let v = flp-shape(plan, ctx);
   if (!flp-held?(v)) then v else flp-verify-paths(plan, req, ctx, planner, stamp);
  }
  def flp-verify-paths(plan, req, ctx, planner, stamp) {
   let v = flp-paths(plan);
