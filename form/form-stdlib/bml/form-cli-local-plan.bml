  }
  def flp-measured(plan, ctx, tree, v) = if ((Comparable) len(flp-p-defs(plan)) < 2) then flp-falls(v, flp-one-fall(plan, v)) else flp-solo-walk(plan, ctx, tree, v, flp-p-defs(plan), 1, []);
  def flp-solo-walk(plan, ctx, tree, v, defs, i, falls) = if nil?(defs) then flp-falls(v, falls) else flp-solo-read(plan, ctx, tree, v, defs, i, falls, flp-solo-run(plan, ctx, mc-cat([tree, "/solo-", i.str()]), defs[0]));
  def flp-solo-as(d) = if flp-def-present?(d) then "at today's text" else "a stub answering (nothing), as the file does not have it yet";
  def flp-solo-read(plan, ctx, tree, v, defs, i, falls, r) {
   let d = defs[0];
   let full = flp-p-full(plan);
   let kept = append(falls, [[d[0], if nothing?(r[0]) then nothing() else (full - r[0]), r[3]]]);
   let alone = mc-cat(["With ", d[0], " alone ", flp-solo-as(d), " and every other definition standing as your <reference>, the band"]);
   if ((Comparable) r[1] == 1) then flp-refused-after(v, 8, mc-cat(["band-deadline:solo:", d[0]]), mc-cat([alone, " did not end within ", (flp-ctx-deadline(ctx) / 1000).str(), " s; a band ends for any candidate."]), kept)
   else if nothing?(r[0]) then flp-refused-after(v, 8, mc-cat(["band-no-number:solo:", d[0]]), mc-cat([alone, " did not exit 0 with a number on its last line; a band ends with a number for any candidate.", if ((Comparable) len(r[2]) > 0) then mc-cat([" fkwu said:\n", r[2]]) else ""]), kept)
   else if ((r[0] >= full) && ((Comparable) r[3] == 0)) then flp-refused-after(v, 8, mc-cat(["definition-unmeasured:", d[0]]), mc-cat([alone, " still reads ", r[0].str(), " of ", full.str(), " and every check still holds: no claim and no check measures the change to ", d[0], ", so the lane could leave it undone and turn the band full. Give ", d[0], " a claim that asks for a value only the changed ", d[0], " gives, or a check of the text only the change writes (what a definition prints is measured through a definition that answers the text it prints, or by a check), or leave ", d[0], " out of the plan and the goal."]), kept)
