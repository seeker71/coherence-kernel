   let bad = flp-first-index(rows, n => (!flp-tool-row?(n)), 0);
   if (!fcgp-array?(checks)) then flp-refused(4, "checks-shape", "The plan's \"checks\" is absent or not a JSON array: give at least one read-only tool call, such as rg -c -F \"def <name>(\" <file> answering \"1\\n\".")
   else if nil?(rows) then flp-refused(4, "checks-none", "The plan names no checks: give at least one read-only tool call, such as rg -c -F \"(defn <name>\" <file> answering \"1\\n\".")
   else if (bad >= 0) then flp-refused(4, mc-cat(["check-shape#", (bad + 1).str()]), mc-cat(["Check ", (bad + 1).str(), " is not a read-only native tool call {\"tool\",\"arguments\",\"stdout\"} (optional \"exit\" and \"input\"; tools rg, head, tail, read, cat, wc and the like): ", flp-head(json-emit(rows[bad]), 300)]))
   else flp-rehearsed(plan, fccw-rehearse(json-node-object([json-node-pair("checks", checks), json-node-pair("writable", flp-json-strings(flp-p-writable(plan)))]), flp-docs(plan)));
