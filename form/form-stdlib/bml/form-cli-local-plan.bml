  }
  def flp-mkdirs-next(path, sp) {
   let made = if (sp > 0) then fs_mkdir(substring(path, 0, sp)) else 0;
   flp-mkdirs-at(path, (sp + 1));
  }
  def flp-mkdirs(path) = if ((String) path == "") then 0 else flp-mkdirs-at(path, 0);
  def flp-put(path, text) {
