  }
  // ── (6) the queue row, read back as native-turn-run reads it ──
  def flp-row(plan, req, planner) = json-node-object(append([fhn-s("id", flp-p-id(plan)), fhn-s("goal", flp-p-goal(plan)), json-node-pair("writable", flp-json-strings(flp-p-writable(plan))), fhn-s("band", flp-p-band(plan)), fhn-n("full", flp-p-full(plan)), json-node-pair("checks", flp-p-checks(plan))], append(if nil?(flp-p-sources(plan)) then [] else [json-node-pair("sources", flp-json-strings(flp-p-sources(plan)))], append([fhn-s("document_context", "catalog"), fhn-s("origin", "local-plan"), fhn-s("request", flp-req-id(req))], planner))));
  def flp-row-str(row, key) = if json-object-has?(row, key) then json-string-value(json-object-get(row, key)) else "";
  def flp-row-int(row, key) = if json-object-has?(row, key) then json-int-value(json-object-get(row, key)) else 0;
  def flp-row-strs(row, key) = if json-object-has?(row, key) then map(n => json-string-value(n), json-array-elements(json-object-get(row, key))) else [];
  def flp-row-reads?(row, plan) = ((String) flp-row-str(row, "id") == flp-p-id(plan)) && (((String) flp-row-str(row, "goal") == flp-p-goal(plan)) && (((String) flp-row-str(row, "band") == flp-p-band(plan)) && (((Comparable) flp-row-int(row, "full") == flp-p-full(plan)) && (((String) flp-join(flp-row-strs(row, "writable"), "\n") == flp-join(flp-p-writable(plan), "\n")) && (((String) json-emit(json-object-get(row, "checks")) == json-emit(flp-p-checks(plan))) && ((String) flp-row-str(row, "document_context") == "catalog"))))));
  // the queue row that already carries a request's gap, or nothing: a request is planned once
  def flp-request-row(queue, id) = if ((Comparable) len(id) == 0) then nothing() else flp-first(flp-queue-rows(queue), r => ((String) flp-text(r, "request") == id));
  def flp-row-check(plan, req, ctx, planner) {
   let line = json-emit(flp-row(plan, req, planner));
   let rows = flp-queue-rows(flp-ctx-queue(ctx));
   let asked = flp-request-row(flp-ctx-queue(ctx), flp-req-id(req));
   let taken = flp-first(rows, r => ((String) flp-text(r, "id") == flp-p-id(plan)));
