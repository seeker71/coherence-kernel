  def flp-sexp-end(t, i, depth, quoted) = if (i >= len(t)) then -1 else flp-sexp-byte(t, i, depth, quoted, str_byte_at(t, i));
  def flp-sexp-byte(t, i, depth, quoted, b) = if quoted then flp-sexp-end(t, (i + (if ((Comparable) b == 92) then 2 else 1)), depth, (!((Comparable) b == 34))) else if ((Comparable) b == 34) then flp-sexp-end(t, (i + 1), depth, true) else if ((Comparable) b == 59) then flp-sexp-end(t, flp-line-end(t, i), depth, false) else if ((Comparable) b == 40) then flp-sexp-end(t, (i + 1), (depth + 1), false) else if ((Comparable) b == 41) then (if (depth <= 1) then (i + 1) else flp-sexp-end(t, (i + 1), (depth - 1), false)) else flp-sexp-end(t, (i + 1), depth, false);
  def flp-fk-params-at(text, at, name) {
   let open = str_find(text, "(", (at + len(flp-fk-mark(name))));
   let close = if (open < 0) then -1 else str_find(text, ")", open);
   if ((open < 0) || (close < 0)) then [] else flp-words(substring(text, (open + 1), close));
  }
  // a definition stands in a file's text: make answers its text from the params the file (or, new, the plan) gives
  def flp-fk-replace(text, d, make, at) {
   let end = flp-sexp-end(text, at, 0, false);
