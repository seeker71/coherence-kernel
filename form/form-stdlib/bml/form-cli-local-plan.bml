  def flp-stub-words(flavor) = if ((String) flavor == "nothing") then "answering (nothing)" else "answering its first argument";
  def flp-fk-body(params, flavor) = if ((String) flavor == "nothing") then "(nothing)" else if nil?(params) then "0" else params[0];
  def flp-fk-def(name, params, flavor) = mc-cat(["(defn ", name, " (", flp-join(params, " "), ") ", flp-fk-body(params, flavor), ")"]);
  def flp-first-param(raw) = trim(flp-cut-at(flp-cut-at(flp-cut-at(raw, ","), ":"), "="));
  def flp-bml-body(raw, flavor) = if ((String) flavor == "nothing") then "nothing()" else if ((Comparable) len(flp-first-param(raw)) == 0) then "0" else flp-first-param(raw);
  def flp-bml-def(name, raw, flavor) = mc-cat(["def ", name, "(", raw, ") = ", flp-bml-body(raw, flavor), ";"]);
