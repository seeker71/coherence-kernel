  def flp-line-with(text, mark, ls) = if (ls >= len(text)) then -1 else if flp-starts?(substring(text, flp-indent-end(text, ls), flp-line-end(text, ls)), mark) then ls else flp-line-with(text, mark, (flp-line-end(text, ls) + 1));
