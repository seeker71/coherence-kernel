  def flp-blank(bml) = if bml then "section [form.bml] {\n class LocalPlanStub {\n }\n 0;\n}\n" else "(do\n    0)\n";
  def flp-stub-def(text, d, bml, flavor) = if nothing?(text) then text else if bml then flp-bml-place(text, d, raw => flp-bml-def(d[0], raw, flavor)) else flp-fk-place(text, d, params => flp-fk-def(d[0], params, flavor));
