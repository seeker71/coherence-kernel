    let snapshots=append(flp-p-writable(plan),flp-p-sources(plan)) |> filter(flp-exists?) |> map(path=>flp-tree-file(tree + "/today",path,fhn-read(path)));
    any?(path=>path != "",snapshots) ? flp-refused(1,"source-snapshot","The verification owner could not retain its original source bytes.") : flp-verify-bands(plan,req,ctx,tree);
   };
  }
  // the lane's own read-only arity tool reads a .fk band against the arities fkwu's reader demands, before any run
  def flp-arity(plan) = if flp-ends?(flp-p-band(plan), ".fk") then trim(fat-out(fat-call([["band.fk", "band.fk", flp-p-text(plan)]], "arity", ["band.fk"], ""))) else "";
  // the band's parentheses, strings and ';' comments read past: [state, line, depth]; state ok, stray or open
  def flp-paren-walk(t, i, depth, quoted, line) = if (i >= len(t)) then [if ((Comparable) depth == 0) then "ok" else "open", line, depth] else flp-paren-byte(t, i, depth, quoted, line, str_byte_at(t, i));
  def flp-paren-byte(t, i, depth, quoted, line, b) = if ((Comparable) b == 10) then flp-paren-walk(t, (i + 1), depth, quoted, (line + 1)) else if quoted then flp-paren-walk(t, (i + (if ((Comparable) b == 92) then 2 else 1)), depth, (!((Comparable) b == 34)), line) else if ((Comparable) b == 34) then flp-paren-walk(t, (i + 1), depth, true, line) else if ((Comparable) b == 59) then flp-paren-walk(t, flp-line-end(t, i), depth, false, line) else if ((Comparable) b == 40) then flp-paren-walk(t, (i + 1), (depth + 1), false, line) else if ((Comparable) b == 41) then (if (depth <= 0) then ["stray", line, -1] else flp-paren-walk(t, (i + 1), (depth - 1), false, line)) else flp-paren-walk(t, (i + 1), depth, false, line);
  def flp-balance(plan) {
   let w = if flp-ends?(flp-p-band(plan), ".fk") then flp-paren-walk(flp-p-text(plan), 0, 0, false, 1) else ["ok", 0, 0];
   if ((String) w[0] == "stray") then mc-cat(["a ')' on line ", w[1].str(), " of the band closes a form that was never opened"]) else if ((String) w[0] == "open") then mc-cat([w[2].str(), " form(s) opened in the band are never closed by its end"]) else "";
  }
  def flp-verify-bands(plan, req, ctx, tree) {
   let unbalanced = flp-balance(plan);
   let said = if ((Comparable) len(unbalanced) > 0) then "" else flp-arity(plan);
   if ((Comparable) len(unbalanced) > 0) then flp-refused(1, "band-balance", mc-cat(["The band's parentheses do not balance, so fkwu cannot read it: ", unbalanced, ". Count each form's parentheses; strings and ';' comments are read past."]))
   else if ((Comparable) len(said) > 0) then flp-refused(1, "band-arity", mc-cat(["The band calls Form words with the wrong number of arguments, so fkwu cannot read it. The arity tool says (lines of the band text):\n", said, "\nand, or, add, str_concat and the like take two: nest them, (and a (and b c))."])) else flp-verify-run(plan, req, ctx, tree);
  }
  // ── (2)+(3) moot: the band reads full on today's files, both stubs fail it, and it names the definition the change stands in ──
  // A moved request carries a fixborn: the change that moved the code it cites, with the definition (path:name) that
  // change landed in. The plan must name that definition (in that file), so a band over any other definition, a
  // request with no fixborn, or one whose fixborn stands in no .bml or .fk definition, is never read as moot. The
  // stubs are rung 3's own, so a band no stub fails stays gap-closed.
  def flp-gap-closed?(v) = ((Comparable) v[0] == 2) && ((String) v[1] == "gap-closed");
  def flp-moot?(v) = ((Comparable) v[0] == 2) && ((String) v[1] == "moot");
  def flp-def-key(d) = mc-cat([d[2], ":", d[0]]);
  def flp-on-request?(plan, req) = ((Comparable) len(flp-fixed-key(req)) > 0) && any?(d => ((String) flp-def-key(d) == flp-fixed-key(req)), flp-p-defs(plan));
  def flp-moot-text(plan, stubs) = mc-cat(["On today's files the band reads its full ", flp-p-full(plan).str(), ", and with each named definition a stub answering (nothing) it reads ", stubs[0].str(), " and answering its first argument ", stubs[1].str(), ": the band measures the definition the request's change stands in and today's files already meet it, so the request is moot while its fixborn stands."]);
  def flp-mooted(plan, req, ctx, tree, open) {
   let s = flp-stubs(plan, ctx, tree, open[3]);
   if (flp-held?(s) && flp-on-request?(plan, req)) then [2, "moot", flp-moot-text(plan, s[4]), open[3], s[4], nothing(), []] else flp-with-readings(open, open[3], s[4]);
  }
  def flp-verify-run(plan, req, ctx, tree) {
   let open = flp-open(plan, ctx, tree);
   let stubbed = if flp-held?(open) then flp-stubs(plan, ctx, tree, open[3]) else if flp-gap-closed?(open) then flp-mooted(plan, req, ctx, tree, open) else open;
   let reached = if flp-held?(stubbed) then flp-reference(plan, ctx, tree, stubbed) else stubbed;
   if (!flp-held?(reached)) then reached else flp-measured(plan, ctx, tree, reached);
  }
  // ── (7) reachable: with the planner's own <reference> definitions standing, the band reads full ──
  // The reference is a witness that some candidate the goal describes turns the band full. Every queued gap has
  // one; it stays in the scratch tree and never reaches the lane.
  // The reference block's delimiters, by the block's own lines: a .fk reference is read as the band is (strings and
  // ';' comments read past), a .bml one with its strings and '//' comments read past; [state, line, byte, opener]
  def flp-opener-of(b) = if ((Comparable) b == 41) then 40 else if ((Comparable) b == 93) then 91 else 123;
  def flp-slash2?(t, i) = if ((i + 1) >= len(t)) then false else ((Comparable) str_byte_at(t, (i + 1)) == 47);
  def flp-delim-walk(t, i, stack, quoted, line) = if (i >= len(t)) then (if nil?(stack) then ["ok", 0, 0, []] else ["open", stack[0][1], stack[0][0], []]) else flp-delim-byte(t, i, stack, quoted, line, str_byte_at(t, i));
  def flp-delim-byte(t, i, stack, quoted, line, b) = if ((Comparable) b == 10) then flp-delim-walk(t, (i + 1), stack, quoted, (line + 1)) else if quoted then flp-delim-walk(t, (i + (if ((Comparable) b == 92) then 2 else 1)), stack, (!((Comparable) b == 34)), line) else if ((Comparable) b == 34) then flp-delim-walk(t, (i + 1), stack, true, line) else if (((Comparable) b == 47) && flp-slash2?(t, i)) then flp-delim-walk(t, flp-line-end(t, i), stack, false, line) else if (((Comparable) b == 40) || (((Comparable) b == 91) || ((Comparable) b == 123))) then flp-delim-walk(t, (i + 1), cons([b, line], stack), false, line) else if (((Comparable) b == 41) || (((Comparable) b == 93) || ((Comparable) b == 125))) then flp-delim-close(t, i, stack, line, b) else flp-delim-walk(t, (i + 1), stack, false, line);
  def flp-delim-close(t, i, stack, line, b) = if nil?(stack) then ["stray", line, b, []] else if ((Comparable) stack[0][0] == flp-opener-of(b)) then flp-delim-walk(t, (i + 1), stack[1:], false, line) else ["mismatch", line, b, stack[0]];
  def flp-ch(b) = mc-cat(["'", byte_to_str(b), "'"]);
  def flp-delims-said(w, bml) = if ((String) w[0] == "stray") then mc-cat(["a ", if bml then flp-ch(w[2]) else "')'", " on line ", w[1].str(), " closes nothing that was opened"]) else if ((String) w[0] == "mismatch") then mc-cat(["the ", flp-ch(w[2]), " on line ", w[1].str(), " closes the ", flp-ch(w[3][0]), " opened on line ", w[3][1].str()]) else if bml then mc-cat(["the ", flp-ch(w[2]), " opened on line ", w[1].str(), " is never closed"]) else mc-cat([w[2].str(), " form(s) are never closed by its end"]);
  // "" when the text's delimiters balance, else where they do not
  def flp-delims(text, bml) {
   let w = if bml then flp-delim-walk(text, 0, [], false, 1) else flp-paren-walk(text, 0, 0, false, 1);
   if ((String) w[0] == "ok") then "" else flp-delims-said(w, bml);
  }
  // the line a compiler names in its words ("section: line N"), quoted from the placed file whose path it names
  def flp-said-line-no(said) {
   let at = str_find(said, "section: line ", 0);
   if (at < 0) then nothing() else flp-number-at(said, (at + 14));
  }
  def flp-line-of(text, n) {
   let ls = flp-lines(text);
   if (n < 1) then nothing() else if (n > len(ls)) then nothing() else ls[(n - 1)];
  }
  def flp-quote-at(said, texts) {
   let n = flp-said-line-no(said);
   let named = flp-first(texts, wt => (str_find(said, wt[0], 0) >= 0));
   let line = if (nothing?(n) || nothing?(named)) then nothing() else flp-line-of(named[1], n);
   if nothing?(line) then "" else mc-cat(["\nLine ", n.str(), " of ", named[0], ", with your definitions standing, reads:\n", line]);
  }
  def flp-reference(plan, ctx, tree, v) {
   let ref = flp-p-reference(plan);
   let none = (Comparable) len(trim(ref)) == 0;
   let missing = flp-first(flp-p-defs(plan), d => nothing?(flp-ref-text(ref, d, flp-file-bml?(d[2]))));
   let unbalanced = if none then "" else flp-delims(ref, flp-file-bml?(flp-p-defs(plan)[0][2]));
   if none then flp-with-readings(flp-refused(7, "reference-none", "The reply has no <reference> block, or an empty one, so nothing witnesses that any candidate turns the band full. Form reads the band with your <reference> definitions standing before the gap is queued: write each definition the plan names, whole, as you expect the lane to write it, between <reference> and </reference>."), v[3], v[4])
   else if (!nothing?(missing)) then flp-with-readings(flp-refused(7, mc-cat(["reference-missing:", missing[0]]), mc-cat(["The <reference> block holds no definition of ", missing[0], ": write each definition the plan names, whole, beginning '(defn ", missing[0], " ' for a .fk file or 'def ", missing[0], "(' for a .bml file."])), v[3], v[4])
   else if ((Comparable) len(unbalanced) > 0) then flp-with-readings(flp-refused(7, "reference-balance", mc-cat(["The <reference> block's delimiters do not balance, so no compiler can read it: ", unbalanced, " (lines of the <reference> block). Close each (, [ and { with its own closer; strings and comments are read past."])), v[3], v[4])
   else flp-reference-read(plan, ctx, mc-cat([tree, "/reference"]), v);
  }
  // a check over files that exist, read with the reference standing: a check the reference breaks forbids the
  // change the band asks for; a check that names a new writable file would read only a skeleton there, so the fccw
  // witness of rung 4 alone reads it
  def flp-reads-new?(plan, row) = any?(a => (flp-has?(flp-p-writable(plan), a) && (!flp-exists?(a))), fccw-args(row));
  def flp-ref-docs(plan, texts) = append(map(wt => [wt[0], wt[0], wt[1]], texts), map(p => [p, p, fhn-read(p)], flp-p-sources(plan)));
  def flp-ref-broken(plan, docs) = flp-first(filter(n => (!flp-reads-new?(plan, n)), json-array-elements(flp-p-checks(plan))), n => (!fccw-eval(n, docs)[0]));
  def flp-reference-read(plan, ctx, root, v) {
   let ref = flp-p-reference(plan);
   let texts = map(w => [w, flp-standing(plan, w, (t, d, bml) => flp-ref-def(t, d, bml, ref))], flp-p-writable(plan));
   let unplaced = flp-first(texts, wt => nothing?(wt[1]));
   let placed = if nothing?(unplaced) then map(wt => flp-tree-file(root, wt[0], wt[1]), texts) else [];
   let docs = if nothing?(unplaced) then flp-ref-docs(plan, texts) else [];
   let broken = if nothing?(unplaced) then flp-ref-broken(plan, docs) else nothing();
   let seen = if nothing?(broken) then [] else fccw-eval(broken, docs);
   let path = flp-at(root, flp-p-band(plan));
   let put = flp-put(path, flp-p-text(plan));
   let r = if (nothing?(unplaced) && nothing?(broken)) then flp-band-run(path, flp-ctx-deadline(ctx)) else [nothing(), 0, ""];
   let full = flp-p-full(plan);
   if (!nothing?(unplaced)) then flp-with-readings(flp-refused(7, mc-cat(["reference-site:", unplaced[0]]), mc-cat(["Form could not stand the <reference> definitions in ", unplaced[0], "."])), v[3], v[4])
   else if (!nothing?(broken)) then flp-with-readings(flp-refused(7, mc-cat(["reference-check:", flp-head(flp-sha(json-emit(broken)), 12)]), mc-cat(["The check ", json-emit(broken), " forbids the change your <reference> makes: with your definitions standing it prints ", flp-said(seen[2]), " (exit ", seen[4].str(), ") where it asks ", flp-said(seen[1]), " (exit ", seen[3].str(), "). A check pins what the gap keeps: leave out a check the change must break, or ask for what the changed file prints."])), v[3], v[4])
   else if (nothing?(r[0]) && (str_find(r[2], "error", 0) >= 0)) then flp-reach(flp-refused(7, "reference-compile", mc-cat(["Your <reference> definitions, standing in a scratch copy of the file, do not compile, so they witness nothing. Write them in the file's own dialect, as its other definitions are written. fkwu said:\n", r[2], flp-quote-at(r[2], texts)])), v[3], v[4], r[0])
   else if (nothing?(r[0]) || (!((Comparable) r[0] == full))) then flp-reach(flp-refused(7, "unreachable", mc-cat(["With your <reference> definitions standing, the band reads ", flp-show(r[0]), " of ", full.str(), ": the band, the goal and the reference disagree, so no candidate the goal describes turns the band full.", if ((Comparable) len(r[2]) > 0) then mc-cat([" fkwu said:\n", r[2], flp-quote-at(r[2], texts)]) else ""])), v[3], v[4], r[0])
   else flp-reach(v, v[3], v[4], r[0]);
  }
  // ── (8) measured: each named definition alone at today's text, every other standing as the reference ──
  // A definition whose change nothing measures hides behind its neighbours' stubs: with it alone at today's text
  // (the nothing-stub when the file lacks it) and the rest as the reference, the band must read below full or a
  // check must fail. full minus that reading is the definition's solofall, the claim bits it alone owes; the one
  // definition of a plan that names one reads its solofall from rungs 2 and 3, with no run of its own.
  def flp-solo-place(t, e, bml, d, ref) = if (((String) e[0] == d[0]) && ((String) e[2] == d[2])) then (if flp-def-present?(e) then t else flp-stub-def(t, e, bml, "nothing")) else flp-ref-def(t, e, bml, ref);
  // [reading, timed out, what fkwu said, checks that fall]: the mixed tree's band reading, and how many checks over
  // files that exist fail on its texts (a check the lane must meet measures a change no band reads, a printed line)
  def flp-checks-fallen(plan, docs) = len(filter(n => (!fccw-eval(n, docs)[0]), filter(n => (!flp-reads-new?(plan, n)), json-array-elements(flp-p-checks(plan)))));
  def flp-solo-run(plan, ctx, root, d) {
   let ref = flp-p-reference(plan);
   let texts = map(w => [w, flp-standing(plan, w, (t, e, bml) => flp-solo-place(t, e, bml, d, ref))], flp-p-writable(plan));
   let unplaced = flp-first(texts, wt => nothing?(wt[1]));
   let placed = if nothing?(unplaced) then map(wt => flp-tree-file(root, wt[0], wt[1]), texts) else [];
   let fallen = if nothing?(unplaced) then flp-checks-fallen(plan, flp-ref-docs(plan, texts)) else 0;
   let path = flp-at(root, flp-p-band(plan));
   let put = flp-put(path, flp-p-text(plan));
   let r = if nothing?(unplaced) then flp-band-run(path, flp-ctx-deadline(ctx)) else [nothing(), 0, mc-cat(["Form could not stand the definitions in ", unplaced[0], "."])];
