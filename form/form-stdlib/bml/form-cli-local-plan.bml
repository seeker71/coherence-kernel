  }
  // every claim fails for a stub: no claim bit stands in both stub readings
  def flp-bit?(n, b) = (Comparable) ((n / b) % 2) == 1;
  def flp-common(x, y, b, full, acc) = if (b > full) then acc else flp-common(x, y, (b * 2), full, if (flp-bit?(x, b) && flp-bit?(y, b)) then (acc + b) else acc);
