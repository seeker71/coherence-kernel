  def flp-paren-close(t, i, depth) = if (i >= len(t)) then -1 else if ((Comparable) str_byte_at(t, i) == 40) then flp-paren-close(t, (i + 1), (depth + 1)) else if ((Comparable) str_byte_at(t, i) == 41) then (if (depth <= 1) then i else flp-paren-close(t, (i + 1), (depth - 1))) else flp-paren-close(t, (i + 1), depth);
