   write_file_text(path, text);
  }
  // ── (2) the gap is open on today's files ──
  def flp-open(plan, ctx, tree) {
   let path = flp-at(mc-cat([tree, "/today"]), flp-p-band(plan));
   let put = flp-put(path, flp-p-text(plan));
   let r = flp-band-run(path, flp-ctx-deadline(ctx));
