   let measure = flp-first(flp-p-writable(plan), p => flp-band-like?(p));
   let missing = flp-first(flp-p-sources(plan), p => (!flp-source-ok?(p)));
   if (!nothing?(bad)) then flp-refused(5, mc-cat(["writable-path:", bad]), mc-cat(["The writable path ", bad, " neither exists as a file nor is new under form/, observe/, gate/ or learn/ in a directory that exists (relative, no '..')."]))
   else if (!nothing?(measure)) then flp-refused(5, mc-cat(["writable-band:", measure]), mc-cat(["The writable path ", measure, " is a band: a gap edits the code its band measures, never a band."]))
   else if (!nothing?(missing)) then flp-refused(5, mc-cat(["source-absent:", missing]), mc-cat(["The source ", missing, " is not a file of the checkout."]))
   else flp-held();
  }
  // ── (4) checks ──
  def flp-tool-row?(n) = if (!fcgp-object?(n)) then false else (fcgp-str-node?(fcgp-node(n, "tool")) && (fcap-readonly(fcgp-str(n, "tool")) && (fcgp-array?(fcgp-node(n, "arguments")) && (all?(a => fcgp-str-node?(a), json-array-elements(fcgp-node(n, "arguments"))) && (fcgp-str-node?(fcgp-node(n, "stdout")) && ((!fcgp-present?(n, "exit")) || fcgp-int-node?(fcgp-node(n, "exit"))) && ((!fcgp-present?(n, "input")) || fcgp-str-node?(fcgp-node(n, "input"))) && (!fcgp-present?(n, "kind")))))));
  def flp-docs(plan) = map(p => [p, p, fhn-read(p)], append(flp-p-writable(plan), flp-p-sources(plan)));
  def flp-checks(plan) {
