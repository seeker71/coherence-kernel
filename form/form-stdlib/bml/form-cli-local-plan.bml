  }
  // a writable file's text with each of its plan definitions placed by place(text, definition, bml)
  def flp-standing(plan, w, place) {
   let here = flp-exists?(w);
   let original = if here then fhn-read(w) else "";
   let bml = if here then flp-bml-surface?(original) else flp-ends?(w, ".bml");
   foldl((t, d) => place(t, d, bml), if here then original else flp-blank(bml), filter(d => ((String) d[2] == w), flp-p-defs(plan)));
  }
  def flp-stubbed(plan, w, flavor) = flp-standing(plan, w, (t, d, bml) => flp-stub-def(t, d, bml, flavor));
  // a placed copy stands where fkwu looks first: the scratch tree's own form/ root; "" when it stands, else the file
  def flp-stub-path(w) = if flp-starts?(w, "form/") then w else mc-cat(["form/", w]);
  def flp-tree-file(root, w, text) = if nothing?(text) then w else flp-stub-placed(root, w, text);
  def flp-stub-file(plan, root, w, flavor) = flp-tree-file(root, w, flp-stubbed(plan, w, flavor));
  def flp-stub-placed(root, w, text) {
   let a = flp-put(flp-at(root, flp-stub-path(w)), text);
   let b = if flp-starts?(w, "form/") then 0 else flp-put(flp-at(root, w), text);
