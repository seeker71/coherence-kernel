  def flp-under-roots?(p) = any?(r => flp-starts?(p, r), flp-roots());
  def flp-writable-ok?(p) = if (!flp-path-safe?(p)) then false else if flp-exists?(p) then (!flp-is-dir?(p)) else (flp-under-roots?(p) && flp-is-dir?(flp-parent(p)));
  def flp-band-like?(p) = flp-starts?(p, flp-tests()) || (flp-ends?(p, "-band.fk") || flp-ends?(p, "-band.bml"));
  def flp-source-ok?(p) = flp-path-safe?(p) && (flp-exists?(p) && (!flp-is-dir?(p)));
  def flp-paths(plan) {
