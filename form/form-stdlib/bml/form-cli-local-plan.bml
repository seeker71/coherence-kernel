   else if nothing?(r[0]) then flp-held() else if ((Comparable) r[0] == full) then flp-with-readings(flp-refused(2, "gap-closed", mc-cat(["On today's files the band already reads its full ", full.str(), ": the gap is closed, so there is nothing for the lane to do. Ask for a value today's definitions do not give."])), r[0], []) else if (r[0] > full) then flp-with-readings(flp-refused(2, "band-above-full", mc-cat(["On today's files the band reads ", r[0].str(), ", above its full ", full.str(), ": its claim bits do not sum to full."])), r[0], []) else flp-with-readings(flp-held(), r[0], []);
  }
