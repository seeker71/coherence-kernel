  def flp-file-bml?(w) = if flp-exists?(w) then flp-bml-surface?(fhn-read(w)) else flp-ends?(w, ".bml");
  def flp-ref-text(ref, d, bml) {
   let at = if bml then flp-bml-find(ref, d[0], 0) else str_find(ref, flp-fk-mark(d[0]), 0);
