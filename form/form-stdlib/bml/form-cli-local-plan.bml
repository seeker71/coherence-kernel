   else if nothing?(r[0]) then flp-refused(1, mc-cat(["band-no-number:", flavor]), if (str_find(r[2], "error", 0) >= 0) then mc-cat(["The band does not compile on fkwu (each named definition standing as a stub ", flp-stub-words(flavor), "), so it cannot read a candidate. fkwu said:\n", r[2]]) else mc-cat(["With each named definition a stub ", flp-stub-words(flavor), ", the band did not exit 0 with a number on its last line, so it cannot read a candidate.", if ((Comparable) len(r[2]) > 0) then mc-cat([" fkwu said:\n", r[2]]) else " It printed no number: a band ends with a number for any answer."]))
   else if (r[0] >= full) then flp-with-readings(flp-refused(3, mc-cat(["band-full-under-stub:", flavor]), mc-cat(["With each named definition a stub ", flp-stub-words(flavor), ", the band still reads ", r[0].str(), " of ", full.str(), ": its claims do not test the definitions. Each claim must ask for a value the stub cannot give."])), nothing(), [r[0]])
