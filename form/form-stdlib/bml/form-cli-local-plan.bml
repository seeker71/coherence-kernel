  }
  // ── one model on the one GPU: the doors that open one ──
  // the walk's doors (host-walk.bml, another planner among them), the session learning's and the LoRA lanes'. The
  // walk's coordinators (scheduled-walk, day-turn) open no model themselves; their children do (a native turn, the
  // movement, the code lane, the drafts, a planner), so a planner waits on those, never on a coordinator that may
  // itself be waiting (hw-yield) for the walk this planner runs under
  def flp-coordinators() = ["observe/scheduled-walk.bml", "observe/day-turn.bml"];
  def flp-gpu-doors() = append(filter(d => !flp-has?(flp-coordinators(), d), hw-walk-doors()), ["observe/native-session-learning-run.fk", "observe/native-lora-train-run.fk", "observe/native-lora-supervise-run.fk", "observe/native-lora-fuse-run.fk", "observe/lora-voice-run.fk", "observe/lora-lift-run.bml"]);
  def flp-door-of(argv) = if (!((String) value_kind(argv) == "list")) then "" else if (len(argv) < 2) then "" else if (!((String) value_kind(argv[1]) == "string")) then "" else (flp-first(flp-gpu-doors(), d => flp-ends?(argv[1], d)) ?? "");
  def flp-pid-in?(pids, pid) = any?(p => ((Comparable) p == pid), pids);
  // a process row (pid ppid exe cwd argv start withheld) holds the GPU when it runs a GPU door, in this checkout or
  // another, and is neither this process nor one it runs under (mine: this pid and its ancestors); another planner
  // holds it only when it began first (by start, then pid), so two planners never wait on each other
  def flp-start-of(row) = if (!((String) value_kind(row) == "list")) then nothing() else if (len(row) < 6) then nothing() else if (!((String) value_kind(row[5]) == "int")) then nothing() else row[5];
  def flp-began-first?(row, me) = if (nothing?(flp-start-of(row)) || nothing?(flp-start-of(me))) then true else if (flp-start-of(row) < flp-start-of(me)) then true else if (flp-start-of(row) > flp-start-of(me)) then false else (row[0] < me[0]);
  def flp-gpu-row?(row, mine, me) = if (!((String) value_kind(row) == "list")) then false else if (len(row) < 5) then false else if flp-pid-in?(mine, row[0]) then false else if ((String) flp-door-of(row[4]) == "") then false else if ((String) flp-door-of(row[4]) == "observe/local-plan-run.bml") then flp-began-first?(row, me) else true;
  def flp-parent-of(row) = if (!((String) value_kind(row) == "list")) then 0 else if (len(row) < 2) then 0 else if (!((String) value_kind(row[1]) == "int")) then 0 else row[1];
  def flp-lineage(pid, depth) {
   let parent = flp-parent-of(host_process(pid));
   if ((depth <= 0) || (parent <= 1)) then [pid] else cons(pid, flp-lineage(parent, (depth - 1)));
  }
  def flp-gpu-holders-of(rows, mine, me) = filter(r => flp-gpu-row?(r, mine, me), rows);
  def flp-gpu-holders() {
   let pids = host_processes("fkwu*");
   if (!((String) value_kind(pids) == "list")) then [] else flp-gpu-holders-of(hw-process-rows(pids), flp-lineage(host_pid(), 32), host_process(host_pid()));
  }
  def flp-holder-names(rows) = flp-join(map(r => mc-cat([flp-door-of(r[4]), " (pid ", r[0].str(), ") in ", if ((String) value_kind(r[3]) == "string") then r[3] else "a checkout it withholds"]), rows), ", ");
  // ── one option of the walk ──
  // memory entries: [finding, outcome, lens, voice, reply, row, prompt IDs, generated IDs]
  def flp-way(memory, voices) {
   let lenses = flp-lenses();
   if nil?(memory) then [voices[0], lenses[0], "first"] else flp-way-after(memory, voices, memory[-1]);
  }
  // a way is [voice, lens, kind]: first, resume (the same voice and lens hear the failure and their own reply), lens
  // or voice (a swerve)
  def flp-way-after(memory, voices, last) {
   let again = (len(memory) >= 2) && ((String) memory[-2][1] == last[1]);
   if (!flp-has?(voices, last[3])) then [voices[0], last[2], "voice"] else if (!again) then [last[3], last[2], "resume"] else flp-swerve(last, voices);
  }
  def flp-swerve(last, voices) {
   let lenses = flp-lenses();
   let li = flp-index(lenses, last[2], 0);
   let vi = flp-index(voices, last[3], 0);
   if ((li + 1) < len(lenses)) then [last[3], lenses[(li + 1)], "lens"] else if ((vi >= 0) && ((vi + 1) < len(voices))) then [voices[(vi + 1)], lenses[0], "voice"] else [last[3], last[2], "resume"];
  }
  def flp-index(xs, x, i) = if nil?(xs) then -1 else if ((String) xs[0] == x) then i else flp-index(xs[1:], x, (i + 1));
  def flp-spent(memory, slot) = foldl((n, m) => (n + m[slot]), 0, memory);
  def flp-ask(voice, packet, name, n) = voice(packet, name, n);
  // an approach is what an option tried: its voice, its lens and the kind of way (first, resume, lens, voice). Its
  // digest never takes the feedback the voice heard, which is evidence: the same approach repeats its digest
  def flp-approach(way) = json-node-object([fhn-s("voice", way[0]), fhn-s("lens", way[1]), fhn-s("kind", way[2])]);
  def flp-approach-digest(way) = flp-sha(mc-cat([way[0], "|", way[1], "|", way[2]]));
