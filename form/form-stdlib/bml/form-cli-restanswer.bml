//////////////////////////////////////////////////////////////////////
//
// form-cli-restanswer.bml — high-grammar authority for the resting
// answer: a reply that sleeps as a recipe until need wakes it into data.
//
// THE LAW THIS NAMES (Seeker 71, 2026-08-30). An answer can be a NodeID —
// a blueprint, a recipe, or a cell. A recipe evaluates on demand, so its
// cost falls OUTSIDE the carrier that holds it — a token stream, an
// embedding recipe — and lands at force time, where the JIT may fully
// resolve code into data. The reserve an answer needs shrinks to a
// pointer's width when the answer is allowed to rest.
//
// CONSTRUCTION IS FREE, FORCE PAYS. A rest pointer carries its recipe
// surface and no value. Pointers embed: an operand may itself be a
// pointer, and force resolves depth-first at need, so a composed answer
// stays code until asked to become data. An op the lowering cannot
// express answers through the tree-walk as form-unlowerable — visible,
// never pretended, never refused. Evaluation provably happens at force
// time: an unknown op defers for free and answers its sentinel only when
// forced.
//
// THE HONOR ORDER. A knowledge-query surface is offered to the rest
// registry first (a pointer, injected as recipe=value), then to the
// homecoming corpus (an exact question answers its fresh word), then to
// the existing source search. Every rest lane is a lookup, never a
// classifier: an unknown surface answers exact nothing — axiom-1,
// silence is whole — and falls through unchanged.
//
// THE STRIP SEAM, PAID FOR. The lookup receives the FULL MARKED frame;
// the rest registries match BARE inner text. Without the strip the lanes
// were a numb-green: wired, banded, and structurally unable to fire on
// the live door. No synthetic band caught it, because a scripted lookup
// accepts any surface — only the live lookup discriminates on frame
// shape. Contract-reading between cells is the witness pure bands
// cannot replace.
//
// THE FOURTH ENDING (closegift). Stop, timeout, and end are three facts;
// body-closed is a fourth, kept just as distinct. When the query budget
// dies with a frame still HELD and a real answer reserve exists, the
// body appends ONLY the close mark — never a word of content — and
// honors one lookup on the body-closed frame: hit and miss inject a
// typed observation and open the reserve; nothing and spent inject
// nothing and the walk ends as before. Every such walk carries a
// body-closed record beside the honor's own, so the gift can never be
// scored as the speaker's own period. Fungible walks keep the old
// timeout ending byte-for-byte — the reserve is what makes continuing
// honest.
//
// Living cells: form-stdlib/local-generate-organ.fk (lg-defer, lg-force),
//   form-stdlib/rest-force-jit.fk (the crystallize door),
//   form-stdlib/knowledge-rest-answer.fk (registry + corpus lanes),
//   form-stdlib/form-cli-model-generate.fk (fcmg-heed-rest-honor, strip),
//   form-stdlib/form-cli-heed-cursor.fk (fhc-close-honoring).
// Proven by: tests/local-generate-organ-band.fk (33554431 four-way),
//   tests/rest-force-jit-band.fk (255),
//   tests/knowledge-rest-answer-band.fk (511 four-way),
//   tests/form-cli-model-generate-heed-report-band.fk (8388607),
//   tests/form-cli-heed-cursor-band.fk (524287 four-way).
//
//////////////////////////////////////////////////////////////////////

package Form.cli.restanswer;

import Form.kernel.*;
import Form.cli.heedmark.*;

// The lane that answered, in honor order. SOURCE is the existing search;
// the two rest lanes sit ahead of it and cost no source IO.
enum RestLane [public] {
   REGISTRY,
   CORPUS,
   SOURCE
}

// How a cursor walk can end. BODY_CLOSED is the closegift: the listener
// adds only the close mark so a held question can still be honored.
enum WalkEnding [public] {
   STOP,
   TIMEOUT,
   END,
   BODY_CLOSED
}

// A delayed-execution pointer: the recipe surface travels, the value
// does not exist yet. Identity today is the surface text; interning it
// as a NodeID is one band of work now that eq carries the coordinate
// law on all four arms.
template RestPointer<TOp> [public, reusable] {
   section [public] {
      TOp Op() [get];
      int A() [get];
      int B() [get];
      String Surface() [get];   // "(mul 6 7)" — never the value
   }
}

interface IRestAnswer [public, witness, reusable] {
   section [public] {
      const int ConstructionCost = 0;
      const int CrystallizeFires = 5;    // jd-crystallize?'s door: fifth force births native
      const int UnknownOpSentinel = -1;  // paid at force time, never at carry time

      int Force( RestPointer p ) [abstract];              // depth-first, at need
      String DeferText( RestPointer p ) [abstract];       // the resting surface
      RestPointer RegistryAnswer( String strQuery ) [abstract];   // or exact nothing
      String CorpusWord( String strQuestion ) [abstract]; // exact tokens -> fresh word
      String FrameInner( String strMarkedFrame ) [abstract];      // the strip
      int BodyCloseEligible( int nPhase, String strScanState, int nAnswerCap ) [abstract];
   }
}

class FormRestAnswer [public, reusable, flow] : IRestAnswer {
   section [public] {
      const String RestRule = "the reply is a pointer; force pays outside the carrier, at the crystallize door";
      const String LookupRule = "a lookup, never a classifier: unknown answers exact nothing, never a false match";
      const String StripRule = "the lookup receives the marked frame; the registries match bare inner text";
      const String CloseGiftRule = "the body adds only the close mark; a body-closed record keeps the gift unmistakable";
      const String FungibleRule = "no reserve, no continuing: fungible walks keep the old timeout byte-for-byte";
      const String LoanspeakRule = "only execution tells a borrowed tongue from the native word; fluency is the disguise";
      const String ExecutablePath = "form/form-stdlib/knowledge-rest-answer.fk";

      int Force( RestPointer p ) [abstract] {}
      String DeferText( RestPointer p ) [abstract] {}
      RestPointer RegistryAnswer( String strQuery ) [abstract] {}
      String CorpusWord( String strQuestion ) [abstract] {}
      String FrameInner( String strMarkedFrame ) [abstract] {}
      int BodyCloseEligible( int nPhase, String strScanState, int nAnswerCap ) [abstract] {}
   }
}
