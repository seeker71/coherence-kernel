// form-cli-surface-inquiry.fk — one Form-native offered request/response
// surface, whose bounded lineage remains inquireable while it is live.
//
// A surface is declared, not guessed: "NL" and "PL" are ordinary values here,
// as is any other nonempty declared surface.  This cell does not claim to parse
// or understand every natural/programming language.  It carries the offered
// language/grammar label to the later native adapter, or leaves it as an honest
// unsupported semantic step.  Requests and responses retain opaque identifiers
// only; no prompt or answer bytes are carried into the framebuffer.
//
// The offer's interface is a list of inquiry relations.  A request can be
// followed only through relations it explicitly offered.  Unknown and unoffered
// inquiries return empty, never a made-up answer.
//
// Direct-source native primitives used: fb_record, framebuffer-events,
// framebuffer-clear, node_source, intern_node.  No shell, host, or model call.
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
section [form.bml] {
    // Offer = id, surface, language-or-grammar, channel, inquiry-interface,
    //         consent, request-id. Response = id, request-id, response-id,
    //         outcome, evidence-id.
    def fsi-offer(id, surface, language, channel, interface, consent, request-id) = list(id, surface, language, channel, interface, consent, request-id);
    def fsi-offer-id(offer) = nth(offer, 0);
    def fsi-offer-surface(offer) = nth(offer, 1);
    def fsi-offer-language(offer) = nth(offer, 2);
    def fsi-offer-channel(offer) = nth(offer, 3);
    def fsi-offer-interface(offer) = nth(offer, 4);
    def fsi-offer-consent(offer) = nth(offer, 5);
    def fsi-offer-request-id(offer) = nth(offer, 6);
    def fsi-response(id, request-id, response-id, outcome, evidence-id) = list(id, request-id, response-id, outcome, evidence-id);
    def fsi-response-id(response) = nth(response, 0);
    def fsi-response-request-id(response) = nth(response, 1);
    def fsi-response-value(response) = nth(response, 2);
    def fsi-response-outcome(response) = nth(response, 3);
    def fsi-response-evidence(response) = nth(response, 4);
    def fsi-member?(value, values) = (Comparable) len(values) == 0 ? 0 : (String) value == head(values) ? 1 : fsi-member?(value, tail(values));
    def fsi-nonempty?(value) = str_len(value) > 0 ? 1 : 0;
    def fsi-offer-valid?(offer) = (Comparable) len(offer) == 7 ? (Comparable) fsi-nonempty?(fsi-offer-surface(offer)) == 1 ? (Comparable) fsi-nonempty?(fsi-offer-language(offer)) == 1 ? (Comparable) fsi-nonempty?(fsi-offer-channel(offer)) == 1 ? (Comparable) fsi-nonempty?(fsi-offer-request-id(offer)) == 1 ? 1 : 0 : 0 : 0 : 0 : 0;
    // The inquiry routes all return identifiers/provenance, never payload text.
    def fsi-inquire(offer, response, relation, source-line, source-col) = (Comparable) fsi-member?(relation, fsi-offer-interface(offer)) == 0 ? empty() : (String) relation == "surface" ? list(fsi-offer-surface(offer), fsi-offer-language(offer)) : (String) relation == "channel" ? list(fsi-offer-channel(offer)) : (String) relation == "consent" ? list(fsi-offer-consent(offer)) : (String) relation == "request" ? list(fsi-offer-id(offer), fsi-offer-request-id(offer)) : (String) relation == "response" ? list(fsi-response-id(response), fsi-response-value(response)) : (String) relation == "lineage" ? list(fsi-response-id(response), fsi-response-request-id(response), fsi-offer-id(offer)) : (String) relation == "state" ? list(fsi-response-outcome(response)) : (String) relation == "evidence" ? list(source-line, source-col, fsi-response-evidence(response)) : empty();
    def fsi-record(category, value, line) = fb_record(intern_node(make_nodeid(12, 1, category, 1), list(intern_trivial_string(value))), "form/form-stdlib/form-cli-surface-inquiry.fk", line * 65536 + 1);
    // One native no-payload event pair.  The response points to the request by
    // ID; the framebuffer independently preserves their direct source records.
    def fsi-observe(offer, response) = {
        framebuffer-clear();
        list(fsi-record(1, fsi-offer-request-id(offer), 72), fsi-record(2, fsi-response-value(response), 73), framebuffer-events());
    };
    def fsi-demo-interface() = list("surface", "channel", "consent", "request", "response", "lineage", "state", "evidence");
    def fsi-nl-offer() = fsi-offer(11, "NL", "en", "form-cli", fsi-demo-interface(), "ephemeral", "rq-nl-11");
    def fsi-pl-offer() = fsi-offer(21, "PL", "form", "form-cli", fsi-demo-interface(), "ephemeral", "rq-pl-21");
    def fsi-nl-response() = fsi-response(12, 11, "rs-nl-12", "grounded", "fb-nl-12");
    def fsi-pl-response() = fsi-response(22, 21, "rs-pl-22", "grounded", "fb-pl-22");
    // This decoder is the form-cli verb body.  Its input is metadata only:
    // id|surface|language-or-grammar|channel|relation,relation|consent|
    // request-id|response-id|outcome|evidence-id|inquiry
    // There is deliberately no request/response payload field to retain.
    def fsi-join(values, separator) = (Comparable) len(values) == 0 ? "" : (Comparable) len(values) == 1 ? head(values) : str_concat(head(values), str_concat(separator, fsi-join(tail(values), separator)));
    def fsi-render(relation, answer, events) = str_concat("surface-inquiry|relation=", str_concat(relation, str_concat("|answer=", str_concat(fsi-join(answer, ","), str_concat("|framebuffer-events=", int_to_str(events))))));
    // CLI projection is deliberately string-only.  The internal inquiry retains
    // numeric node identity; the surface projection preserves the caller's
    // opaque identifiers without coercing those nodes into host values.
    def fsi-command-answer(fields, relation) = (String) relation == "surface" ? list(nth(fields, 1), nth(fields, 2)) : (String) relation == "channel" ? list(nth(fields, 3)) : (String) relation == "consent" ? list(nth(fields, 5)) : (String) relation == "request" ? list(nth(fields, 0), nth(fields, 6)) : (String) relation == "response" ? list(nth(fields, 0), nth(fields, 7)) : (String) relation == "lineage" ? list(nth(fields, 7), nth(fields, 0), nth(fields, 0)) : (String) relation == "state" ? list(nth(fields, 8)) : (String) relation == "evidence" ? list("73", "1", nth(fields, 9)) : empty();
    def fsi-form-cli-command(arg) = {
        let fields = split-on(arg, "|");
        !((Comparable) len(fields) == 11) ? "surface-inquiry:error:expected-11-metadata-fields" : {
            let id = str_to_int(nth(fields, 0));
            let interface = split-on(nth(fields, 4), ",");
            let offer = fsi-offer(id, nth(fields, 1), nth(fields, 2), nth(fields, 3), interface, nth(fields, 5), nth(fields, 6));
            let response = fsi-response(id + 1, id, nth(fields, 7), nth(fields, 8), nth(fields, 9));
            let relation = nth(fields, 10);
            (Comparable) fsi-offer-valid?(offer) == 0 ? "surface-inquiry:error:invalid-offer" : {
                let trace = fsi-observe(offer, response);
                let allowed = fsi-inquire(offer, response, relation, 73, 1);
                (Comparable) len(allowed) == 0 ? "surface-inquiry:miss" : fsi-render(relation, fsi-command-answer(fields, relation), len(nth(trace, 2)));
            };
        };
    };
    // Live framebuffer inquiry stays bounded: it follows only the retained
    // source coordinates of at most eight event roots.  It never renders the
    // node body, request, response, prompt, or answer.  These helpers append
    // after the established carrier functions so existing emitted roots retain
    // their identities when this optional inquiry surface grows.
    def fsi-origin-coordinate(node) = (Comparable) len(node_source(node)) == 3 ? str_concat(nth(node_source(node), 0), str_concat(":", str_concat(int_to_str(nth(node_source(node), 1)), str_concat(":", int_to_str(nth(node_source(node), 2)))))) : "none";
    def fsi-origin-coordinates(nodes, remaining) = (Comparable) len(nodes) == 0 || (Comparable) remaining == 0 ? "" : str_concat(fsi-origin-coordinate(head(nodes)), (Comparable) remaining == 1 || (Comparable) len(tail(nodes)) == 0 ? "" : str_concat(",", fsi-origin-coordinates(tail(nodes), remaining - 1)));
    def fsi-framebuffer-inquiry(relation) = (String) relation == "events" ? str_concat("framebuffer-inquiry|events=", int_to_str(len(framebuffer-events()))) : (String) relation == "origins" ? str_concat("framebuffer-inquiry|origins=", fsi-origin-coordinates(framebuffer-events(), 8)) : "framebuffer-inquiry:miss";
    def fsi-bit(condition, bit) = condition ? bit : 0;
    def form-cli-surface-inquiry-check() = {
        let nl-offer = fsi-nl-offer();
        let pl-offer = fsi-pl-offer();
        let nl-response = fsi-nl-response();
        let pl-response = fsi-pl-response();
        let trace = fsi-observe(nl-offer, nl-response);
        let events = nth(trace, 2);
        let response-source = node_source(nth(trace, 1));
        let framebuffer-events-answer = fsi-framebuffer-inquiry("events");
        let framebuffer-origins-answer = fsi-framebuffer-inquiry("origins");
        let framebuffer-miss = fsi-framebuffer-inquiry("unoffered");
        let surface = fsi-inquire(nl-offer, nl-response, "surface", 73, 1);
        let channel = fsi-inquire(nl-offer, nl-response, "channel", 73, 1);
        let consent = fsi-inquire(nl-offer, nl-response, "consent", 73, 1);
        let request = fsi-inquire(nl-offer, nl-response, "request", 73, 1);
        let response = fsi-inquire(nl-offer, nl-response, "response", 73, 1);
        let lineage = fsi-inquire(nl-offer, nl-response, "lineage", 73, 1);
        let evidence = fsi-inquire(nl-offer, nl-response, "evidence", 73, 1);
        let denied = fsi-inquire(nl-offer, nl-response, "unoffered", 73, 1);
        // 65535: declared NL/PL surfaces, permitted metadata routes,
        // bounded framebuffer coordinates, and refusal of an unoffered route.
        fsi-bit((Comparable) fsi-offer-valid?(nl-offer) == 1, 1) + (fsi-bit((Comparable) fsi-offer-valid?(pl-offer) == 1, 2) + (fsi-bit((String) nth(surface, 0) == "NL", 4) + (fsi-bit((String) fsi-offer-surface(pl-offer) == "PL", 8) + (fsi-bit((String) nth(channel, 0) == "form-cli", 16) + (fsi-bit((String) nth(consent, 0) == "ephemeral", 32) + (fsi-bit((String) nth(request, 1) == "rq-nl-11", 64) + (fsi-bit((String) nth(response, 1) == "rs-nl-12", 128) + (fsi-bit((Comparable) nth(lineage, 2) == 11, 256) + (fsi-bit((Comparable) len(events) == 2, 512) + (fsi-bit((Comparable) nth(response-source, 1) == 73, 1024) + (fsi-bit((Comparable) nth(evidence, 2) == "fb-nl-12", 2048) + (fsi-bit((Comparable) len(denied) == 0, 4096) + (fsi-bit((String) framebuffer-events-answer == "framebuffer-inquiry|events=2", 8192) + (fsi-bit(!((Comparable) str_find(framebuffer-origins-answer, "form/form-stdlib/form-cli-surface-inquiry.fk:72:1", 0) == 0), 16384) + fsi-bit((String) framebuffer-miss == "framebuffer-inquiry:miss", 32768)))))))))))))));
    };
}
