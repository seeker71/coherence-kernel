// program-image-fkb.fk -- program image carried as a .fkb recipe envelope.
//
// This layer folds the table payload and its canonical symbol/dependency image
// into the program-image artifact shape without claiming the artifact can be
// loaded or executed yet. It is the semantic contract between the
// source-artifact descriptor route and the future 9h loader/executor.
//
// preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk
section [form.bml] {
    def pif-version() = "program-image-fkb-v2";
    def pif-artifact-version() = sad-version-program-image-fkb();
    def pif-feature(name, status) = list("program-image-fkb-feature", name, status);
    def pif-feature-name(f) = nth(f, 1);
    def pif-feature-status(f) = nth(f, 2);
    def program-image-fkb-manifest() = list(pif-feature("tbl-shaped-payload-in-fkb-envelope", 1), pif-feature("program-image-kind-not-parsed-data", 1), pif-feature("program-image-kind-not-compiler-image", 1), pif-feature("exact-node-row-arity-4", 1), pif-feature("string-byte-rows", 1), pif-feature("table-counts-must-match", 1), pif-feature("embedded-symbol-dependency-image", 1), pif-feature("node-symbol-dependencies", 1), pif-feature("node-symbol-dependency-targets", 1), pif-feature("symbol-deps-resolve-to-nodes", 1), pif-feature("sym-sidecar-is-locale-lens", 1), pif-feature("descriptor-derived-only-after-valid-table", 1), pif-feature("seal-required-before-route", 1), pif-feature("source-hash-required-before-route", 1), pif-feature("table-numeric-stream", 1), pif-feature("no-form-binary-io", 1), pif-feature("no-program-image-load", 1), pif-feature("no-selector-install", 1), pif-feature("no-c-seed-growth", 1), pif-feature("future-9h-loads-envelope", 1));
    def program-image-fkb-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) pif-feature-name(head(fs)) == name && (Comparable) pif-feature-status(head(fs)) == 1 ? 1 : program-image-fkb-manifest-has?(name, tail(fs));
    def pif-bit?(x) = (Comparable) x == 0 ? 1 : (Comparable) x == 1 ? 1 : 0;
    def pif-nonempty?(s) = str_len(s) > 0;
    def pif-byte?(b) = b >= 0 ? b <= 255 ? 1 : 0 : 0;
    // node-row = (tag a b c), exactly the table executor's nodesx4 shape.
    def pif-node-row(tag, a, b, c) = list(tag, a, b, c);
    def pif-node-row-valid?(row) = (Comparable) len(row) == 4;
    def pif-node-rows-valid?(rows) = nil?(rows) ? 1 : pif-node-row-valid?(head(rows)) ? pif-node-rows-valid?(tail(rows)) : 0;
    // string rows are byte lists. The numeric table stream writes len(row)
    // before the bytes, matching the table executor's string section.
    def pif-string-row-valid?(row) = nil?(row) ? 1 : pif-byte?(head(row)) ? pif-string-row-valid?(tail(row)) : 0;
    def pif-string-rows-valid?(rows) = nil?(rows) ? 1 : pif-string-row-valid?(head(rows)) ? pif-string-rows-valid?(tail(rows)) : 0;
    // table-image = ("program-image-table" nf fn-roots nr node-rows ns string-byte-rows)
    def pif-table-image(nf, fn-roots, nr, node-rows, ns, string-byte-rows) = list("program-image-table", nf, fn-roots, nr, node-rows, ns, string-byte-rows);
    def pif-table-image-from-parts(fn-roots, node-rows, string-byte-rows) = pif-table-image(len(fn-roots), fn-roots, len(node-rows), node-rows, len(string-byte-rows), string-byte-rows);
    def pif-table?(t) = (Comparable) len(t) == 7 ? (String) nth(t, 0) == "program-image-table" : 0;
    def pif-table-nf(t) = nth(t, 1);
    def pif-table-fn-roots(t) = nth(t, 2);
    def pif-table-nr(t) = nth(t, 3);
    def pif-table-node-rows(t) = nth(t, 4);
    def pif-table-ns(t) = nth(t, 5);
    def pif-table-string-byte-rows(t) = nth(t, 6);
    def pif-table-valid?(t) = pif-table?(t) ? (Comparable) pif-table-nf(t) == len(pif-table-fn-roots(t)) ? (Comparable) pif-table-nr(t) == len(pif-table-node-rows(t)) ? (Comparable) pif-table-ns(t) == len(pif-table-string-byte-rows(t)) ? pif-node-rows-valid?(pif-table-node-rows(t)) ? pif-string-rows-valid?(pif-table-string-byte-rows(t)) : 0 : 0 : 0 : 0 : 0;
    def pif-node-rows-numeric(rows) = nil?(rows) ? empty() : append(head(rows), pif-node-rows-numeric(tail(rows)));
    def pif-string-row-numeric(row) = cons(len(row), row);
    def pif-string-rows-numeric(rows) = nil?(rows) ? empty() : append(pif-string-row-numeric(head(rows)), pif-string-rows-numeric(tail(rows)));
    def pif-table-numeric-stream(t) = pif-table-valid?(t) ? append(list(pif-table-nf(t)), append(pif-table-fn-roots(t), append(list(pif-table-nr(t)), append(pif-node-rows-numeric(pif-table-node-rows(t)), append(list(pif-table-ns(t)), pif-string-rows-numeric(pif-table-string-byte-rows(t))))))) : empty();
    // symbol rows hold stable canonical keys. Locale/domain spellings live in
    // `.sym` lenses over these ids; they are not the executable dependency truth.
    def pif-symbol-row(symbol-id, canonical-key) = list(symbol-id, canonical-key);
    def pif-symbol-row-id(row) = nth(row, 0);
    def pif-symbol-row-key(row) = nth(row, 1);
    def pif-symbol-row-valid-at?(row, expected-id) = (Comparable) len(row) == 2 ? (Comparable) pif-symbol-row-id(row) == expected-id ? pif-nonempty?(pif-symbol-row-key(row)) : 0 : 0;
    def pif-symbol-rows-valid-at?(rows, expected-id) = nil?(rows) ? 1 : pif-symbol-row-valid-at?(head(rows), expected-id) ? pif-symbol-rows-valid-at?(tail(rows), expected-id + 1) : 0;
    // symbol-dependency-target = (dependency-symbol-id target-node-id)
    // target-node-id names the concrete node row that defines the dependency.
    def pif-symbol-dependency-target(symbol-id, target-node-id) = list(symbol-id, target-node-id);
    def pif-symbol-dependency-target-symbol(target) = nth(target, 0);
    def pif-symbol-dependency-target-node(target) = nth(target, 1);
    // node-symbol-row = (node-id defined-symbol-id dependency-targets)
    // defined-symbol-id may be -1 for an anonymous node that still carries deps.
    def pif-node-symbol-row(node-id, defined-symbol-id, dependency-targets) = list(node-id, defined-symbol-id, dependency-targets);
    def pif-node-symbol-row-node(row) = nth(row, 0);
    def pif-node-symbol-row-defined(row) = nth(row, 1);
    def pif-node-symbol-row-dependency-targets(row) = nth(row, 2);
    def pif-node-symbol-row-deps(row) = pif-node-symbol-row-dependency-targets(row);
    def pif-symbol-id-ref?(symbol-id, symbol-count) = symbol-id >= 0 ? symbol-id < symbol-count : 0;
    def pif-node-id-ref?(node-id, node-count) = node-id >= 0 ? node-id < node-count : 0;
    def pif-defined-symbol-ref?(symbol-id, symbol-count) = (Comparable) symbol-id == 0 - 1 ? 1 : pif-symbol-id-ref?(symbol-id, symbol-count);
    def pif-symbol-dependency-target-after?(target, previous-symbol, previous-node, symbol-count, node-count) = (Comparable) len(target) == 2 ? pif-symbol-id-ref?(pif-symbol-dependency-target-symbol(target), symbol-count) ? pif-node-id-ref?(pif-symbol-dependency-target-node(target), node-count) ? pif-symbol-dependency-target-symbol(target) > previous-symbol ? 1 : (Comparable) pif-symbol-dependency-target-symbol(target) == previous-symbol ? pif-symbol-dependency-target-node(target) > previous-node : 0 : 0 : 0 : 0;
    def pif-symbol-dependency-targets-valid-after?(targets, previous-symbol, previous-node, symbol-count, node-count) = nil?(targets) ? 1 : pif-symbol-dependency-target-after?(head(targets), previous-symbol, previous-node, symbol-count, node-count) ? pif-symbol-dependency-targets-valid-after?(tail(targets), pif-symbol-dependency-target-symbol(head(targets)), pif-symbol-dependency-target-node(head(targets)), symbol-count, node-count) : 0;
    def pif-node-symbol-row-valid-after?(row, previous-node, node-count, symbol-count) = (Comparable) len(row) == 3 ? pif-node-symbol-row-node(row) > previous-node ? pif-node-symbol-row-node(row) < node-count ? pif-defined-symbol-ref?(pif-node-symbol-row-defined(row), symbol-count) ? pif-symbol-dependency-targets-valid-after?(pif-node-symbol-row-dependency-targets(row), 0 - 1, 0 - 1, symbol-count, node-count) : 0 : 0 : 0 : 0;
    def pif-node-symbol-rows-valid-after?(rows, previous-node, node-count, symbol-count) = nil?(rows) ? 1 : pif-node-symbol-row-valid-after?(head(rows), previous-node, node-count, symbol-count) ? pif-node-symbol-rows-valid-after?(tail(rows), pif-node-symbol-row-node(head(rows)), node-count, symbol-count) : 0;
    def pif-node-symbol-rows-define-symbol?(rows, symbol-id) = nil?(rows) ? 0 : (Comparable) pif-node-symbol-row-defined(head(rows)) == symbol-id ? 1 : pif-node-symbol-rows-define-symbol?(tail(rows), symbol-id);
    def pif-node-symbol-rows-defined-unique?(rows) = nil?(rows) ? 1 : (Comparable) pif-node-symbol-row-defined(head(rows)) == 0 - 1 ? pif-node-symbol-rows-defined-unique?(tail(rows)) : pif-node-symbol-rows-define-symbol?(tail(rows), pif-node-symbol-row-defined(head(rows))) ? 0 : pif-node-symbol-rows-defined-unique?(tail(rows));
    def pif-node-symbol-row-defines?(row, node-id, symbol-id) = (Comparable) len(row) == 3 ? (Comparable) pif-node-symbol-row-node(row) == node-id ? (Comparable) pif-node-symbol-row-defined(row) == symbol-id : 0 : 0;
    def pif-node-symbol-rows-define-at?(rows, node-id, symbol-id) = nil?(rows) ? 0 : pif-node-symbol-row-defines?(head(rows), node-id, symbol-id) ? 1 : pif-node-symbol-rows-define-at?(tail(rows), node-id, symbol-id);
    def pif-node-symbol-dependency-targets-resolve?(targets, all-rows) = nil?(targets) ? 1 : pif-node-symbol-rows-define-at?(all-rows, pif-symbol-dependency-target-node(head(targets)), pif-symbol-dependency-target-symbol(head(targets))) ? pif-node-symbol-dependency-targets-resolve?(tail(targets), all-rows) : 0;
    def pif-node-symbol-row-deps-resolve?(row, all-rows) = pif-node-symbol-dependency-targets-resolve?(pif-node-symbol-row-dependency-targets(row), all-rows);
    def pif-node-symbol-rows-deps-resolve?(rows, all-rows) = nil?(rows) ? 1 : pif-node-symbol-row-deps-resolve?(head(rows), all-rows) ? pif-node-symbol-rows-deps-resolve?(tail(rows), all-rows) : 0;
    // symbol-image = ("program-image-symbol-image" symbol-count symbol-rows
    //                 node-symbol-count node-symbol-rows)
    def pif-symbol-image(symbol-count, symbol-rows, node-symbol-count, node-symbol-rows) = list("program-image-symbol-image", symbol-count, symbol-rows, node-symbol-count, node-symbol-rows);
    def pif-empty-symbol-image() = pif-symbol-image(0, empty(), 0, empty());
    def pif-symbol-image?(img) = (Comparable) len(img) == 5 ? (String) nth(img, 0) == "program-image-symbol-image" : 0;
    def pif-symbol-image-count(img) = nth(img, 1);
    def pif-symbol-image-rows(img) = nth(img, 2);
    def pif-symbol-image-node-count(img) = nth(img, 3);
    def pif-symbol-image-node-rows(img) = nth(img, 4);
    def pif-symbol-image-valid-for-table?(img, table) = pif-symbol-image?(img) ? pif-table-valid?(table) ? (Comparable) pif-symbol-image-count(img) == len(pif-symbol-image-rows(img)) ? (Comparable) pif-symbol-image-node-count(img) == len(pif-symbol-image-node-rows(img)) ? pif-symbol-rows-valid-at?(pif-symbol-image-rows(img), 0) ? pif-node-symbol-rows-valid-after?(pif-symbol-image-node-rows(img), 0 - 1, pif-table-nr(table), pif-symbol-image-count(img)) ? pif-node-symbol-rows-defined-unique?(pif-symbol-image-node-rows(img)) ? pif-node-symbol-rows-deps-resolve?(pif-symbol-image-node-rows(img), pif-symbol-image-node-rows(img)) : 0 : 0 : 0 : 0 : 0 : 0 : 0;
    // envelope = ("program-image-fkb-envelope" version source-path source-hash
    //             source-mtime artifact-path content-hash artifact-mtime seal-ok
    //             table-image symbol-image)
    def pif-envelope(source-path, source-hash, source-mtime, artifact-path, content-hash, artifact-mtime, seal-ok, table-image) = pif-envelope-with-symbols(source-path, source-hash, source-mtime, artifact-path, content-hash, artifact-mtime, seal-ok, table-image, pif-empty-symbol-image());
    def pif-envelope-with-symbols(source-path, source-hash, source-mtime, artifact-path, content-hash, artifact-mtime, seal-ok, table-image, symbol-image) = list("program-image-fkb-envelope", pif-version(), source-path, source-hash, source-mtime, artifact-path, content-hash, artifact-mtime, seal-ok, table-image, symbol-image);
    def pif-envelope?(e) = (Comparable) len(e) == 11 ? (String) nth(e, 0) == "program-image-fkb-envelope" : 0;
    def pif-envelope-version(e) = nth(e, 1);
    def pif-envelope-source-path(e) = nth(e, 2);
    def pif-envelope-source-hash(e) = nth(e, 3);
    def pif-envelope-source-mtime(e) = nth(e, 4);
    def pif-envelope-artifact-path(e) = nth(e, 5);
    def pif-envelope-content-hash(e) = nth(e, 6);
    def pif-envelope-artifact-mtime(e) = nth(e, 7);
    def pif-envelope-seal-ok(e) = nth(e, 8);
    def pif-envelope-table(e) = nth(e, 9);
    def pif-envelope-symbol-image(e) = nth(e, 10);
    def pif-envelope-shape-valid?(e) = pif-envelope?(e) ? (String) pif-envelope-version(e) == pif-version() ? pif-nonempty?(pif-envelope-source-path(e)) ? pif-nonempty?(pif-envelope-source-hash(e)) ? pif-envelope-source-mtime(e) > 0 ? pif-nonempty?(pif-envelope-artifact-path(e)) ? pif-nonempty?(pif-envelope-content-hash(e)) ? pif-envelope-artifact-mtime(e) > 0 ? pif-bit?(pif-envelope-seal-ok(e)) : 0 : 0 : 0 : 0 : 0 : 0 : 0 : 0;
    def pif-envelope-valid?(e) = pif-envelope-shape-valid?(e) ? (Comparable) pif-envelope-seal-ok(e) == 1 ? pif-table-valid?(pif-envelope-table(e)) ? pif-symbol-image-valid-for-table?(pif-envelope-symbol-image(e), pif-envelope-table(e)) : 0 : 0 : 0;
    def pif-envelope-includes-tbl?(e) = pif-envelope-valid?(e) ? 1 : 0;
    def pif-source-from-envelope(e) = pif-envelope-shape-valid?(e) ? sad-source(pif-envelope-source-path(e), pif-envelope-source-hash(e), pif-envelope-source-mtime(e)) : sad-source("", "", 0);
    def pif-descriptor-from-envelope(e) = pif-envelope-valid?(e) ? sad-program-image-fkb(pif-artifact-version(), pif-envelope-artifact-path(e), pif-envelope-source-hash(e), pif-envelope-content-hash(e), pif-envelope-artifact-mtime(e), pif-envelope-seal-ok(e), pif-envelope-includes-tbl?(e)) : sad-no-artifact();
    def pif-route-from-envelope(e) = sad-route(pif-source-from-envelope(e), pif-descriptor-from-envelope(e), sad-no-artifact());
}
