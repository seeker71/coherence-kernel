; living-world-recipe-tree-revision.fk -- prospective contradiction may grow
; an admitted Recipe tree without mutating its parent or granting authority.
;
; A revision blueprint is scoped to one exact match inside one current
; Recipe-tree successor and one exact current prospective suite.  It may reuse
; the prior root as an opaque, content-identical fallback subtree.  Every new
; reference, literal, operator, argument cell, application, root, and blueprint
; must be recurrently offered by sources disjoint from the tree-construction,
; independent-trial, and prospective-evaluation source sets.
;
; The codec owns no task vocabulary or operator catalogue.  New operators are
; target-scoped safe Form tokens offered as cells.  Literal values must already
; occur inside an exact resolved prospective case; projected numeric carriers
; remain scoped and are never reoffered as global scalar attributions.
;
; A composition is compatible only when its Recipe remains consistent on every
; retained placement and exact on every resolved ONE prospective case.  All
; non-ONE cases, alternatives, unknowns, lenses, timeout state, derivations,
; and source identities remain in the field.  This first membrane admits only
; a composition field.  Independent Recipe reoffer and trial admission are a
; separate later membrane.  No Recipe, answer, voice, or promotion is active.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk

(let LWRTR-BLUEPRINT  (bp "LWRTR-BLUEPRINT"))
(let LWRTR-DERIVATION (bp "LWRTR-DERIVATION"))
(let LWRTR-COMPOSITION (bp "LWRTR-COMPOSITION"))
(let LWRTR-FIELD      (bp "LWRTR-FIELD"))
(let LWRTR-ORIGIN     (bp "LWRTR-ORIGIN"))

(defn lwrtr-union-items (items field)
    (if (eq (len items) 0) field
        (lwrtr-union-items (tail items)
            (lwo-field-add field (head items)))))

; children: exact admitted successor, exact prior match, exact suite, root,
; optional declaration/lens/unknown/choice/timeout, alternatives, evidence,
; local path.
(defn lwrtr-blueprint
    (successor match suite root declaration lens alternatives unknown choice
     timeout evidence)
    (intern_node LWRTR-BLUEPRINT
        (list successor match suite root declaration lens alternatives unknown
              choice timeout evidence (lwo-local-path))))
(defn lwrtr-blueprint? (cell)
    (lwo-category? cell LWRTR-BLUEPRINT))
(defn lwrtr-blueprint-successor (blueprint)
    (nth (node_children blueprint) 0))
(defn lwrtr-blueprint-match (blueprint)
    (nth (node_children blueprint) 1))
(defn lwrtr-blueprint-suite (blueprint)
    (nth (node_children blueprint) 2))
(defn lwrtr-blueprint-root (blueprint)
    (nth (node_children blueprint) 3))
(defn lwrtr-blueprint-declaration (blueprint)
    (nth (node_children blueprint) 4))
(defn lwrtr-blueprint-lens (blueprint)
    (nth (node_children blueprint) 5))
(defn lwrtr-blueprint-alternatives (blueprint)
    (nth (node_children blueprint) 6))
(defn lwrtr-blueprint-unknown (blueprint)
    (nth (node_children blueprint) 7))
(defn lwrtr-blueprint-choice (blueprint)
    (nth (node_children blueprint) 8))
(defn lwrtr-blueprint-timeout (blueprint)
    (nth (node_children blueprint) 9))
(defn lwrtr-blueprint-evidence (blueprint)
    (nth (node_children blueprint) 10))

(defn lwrtr-match-in-successor? (successor match)
    (if (eq (lwrth-candidate? successor) 0) 0
        (lwo-field-has?
            (lwrth-field-matches (lwo-emergent-shape successor)) match)))
(defn lwrtr-prior-root (match)
    (lwrt-blueprint-root
        (lwrt-composition-blueprint
            (lwrth-match-composition match))))

; Collect the complete tree DAG surface, including internal argument and
; operator cells.  Content-addressed field insertion removes repeated nodes.
(defn lwrtr-tree-cells-items (items field)
    (if (eq (len items) 0) field
        (do
            (let tree (head items))
            (let with-tree (lwo-field-add field tree))
            (if (eq (lwrt-application? tree) 0)
                (lwrtr-tree-cells-items (tail items) with-tree)
                (do
                    (let operator (lwrt-application-operator tree))
                    (let arguments (lwrt-application-arguments tree))
                    (lwrtr-tree-cells-items
                        (append (lwrt-argument-items arguments) (tail items))
                        (lwo-field-add
                            (lwo-field-add with-tree operator) arguments)))))))
(defn lwrtr-tree-cells (tree)
    (lwrtr-tree-cells-items (list tree) (lwo-empty-field)))

(defn lwrtr-new-operator-valid? (operator successor)
    (if (and (eq (lwrt-operator? operator) 1)
             (and (node_eq (lwrt-operator-target operator) successor)
                  (eq (lwph-source-name-safe?
                        (lwrt-operator-token operator)) 1))) 1 0))
(defn lwrtr-tree-shape-items? (items successor prior-cells)
    (if (eq (len items) 0) 1
        (do
            (let tree (head items))
            (if (eq (lwrt-reference? tree) 1)
                (if (eq (lwph-source-name-safe?
                            (lwrt-reference-name tree)) 1)
                    (lwrtr-tree-shape-items?
                        (tail items) successor prior-cells) 0)
                (if (eq (lwrt-literal? tree) 1)
                    (if (eq (node_type (lwrt-literal-value tree)) 1)
                        (lwrtr-tree-shape-items?
                            (tail items) successor prior-cells) 0)
                    (if (eq (lwrt-application? tree) 0) 0
                        (do
                            (let operator
                                (lwrt-application-operator tree))
                            (let arguments
                                (lwrt-application-arguments tree))
                            (if (or (eq (lwrt-arguments? arguments) 0)
                                    (or (eq (len
                                            (lwrt-argument-items arguments)) 0)
                                        (and
                                            (eq (lwo-field-has?
                                                    prior-cells operator) 0)
                                            (eq (lwrtr-new-operator-valid?
                                                    operator successor) 0))))
                                0
                                (lwrtr-tree-shape-items?
                                    (append
                                        (lwrt-argument-items arguments)
                                        (tail items))
                                    successor prior-cells)))))))))

(defn lwrtr-resolved-case? (case)
    (oac-one? (lwps-case-immediate case)))
(defn lwrtr-value-in-bindings-items? (value items)
    (if (eq (len items) 0) 0
        (if (node_eq value (lwre-binding-value (head items))) 1
            (lwrtr-value-in-bindings-items? value (tail items)))))
(defn lwrtr-value-in-case? (value case)
    (if (or
            (eq (lwrtr-value-in-bindings-items? value
                    (lwre-binding-items (lwps-case-bindings case))) 1)
            (and (eq (lwrtr-resolved-case? case) 1)
                 (node_eq value
                    (oac-payload (lwps-case-immediate case))))) 1 0))
(defn lwrtr-value-in-cases-items? (value items)
    (if (eq (len items) 0) 0
        (if (eq (lwrtr-value-in-case? value (head items)) 1) 1
            (lwrtr-value-in-cases-items? value (tail items)))))
(defn lwrtr-literal-grounded? (literal suite)
    (lwrtr-value-in-cases-items? (lwrt-literal-value literal)
        (lwo-field-items
            (lwps-dataset-cases (lwps-suite-dataset suite)))))

(defn lwrtr-name-in-bindings-items? (name items)
    (if (eq (len items) 0) 0
        (if (str_eq name (lwre-binding-name (head items))) 1
            (lwrtr-name-in-bindings-items? name (tail items)))))
(defn lwrtr-name-in-cases-items? (name items)
    (if (eq (len items) 0) 1
        (if (eq (lwrtr-name-in-bindings-items? name
                    (lwre-binding-items
                        (lwps-case-bindings (head items)))) 1)
            (lwrtr-name-in-cases-items? name (tail items)) 0)))
(defn lwrtr-reference-covered? (reference suite)
    (lwrtr-name-in-cases-items? (lwrt-reference-name reference)
        (lwo-field-items
            (lwps-dataset-cases (lwps-suite-dataset suite)))))

(defn lwrtr-blueprint-shape-valid? (blueprint)
    (if (eq (lwrtr-blueprint? blueprint) 0) 0
        (do
            (let successor (lwrtr-blueprint-successor blueprint))
            (let match (lwrtr-blueprint-match blueprint))
            (if (or (eq (lwrth-candidate? successor) 0)
                    (or (eq (lwrth-match? match) 0)
                        (or (eq (lwrtr-match-in-successor?
                                    successor match) 0)
                            (eq (lwps-suite-shape-valid?
                                    (lwrtr-blueprint-suite blueprint)) 0))))
                0
                (do
                    (let prior-cells
                        (lwrtr-tree-cells (lwrtr-prior-root match)))
                    (if (eq (lwrtr-tree-shape-items?
                                (list (lwrtr-blueprint-root blueprint))
                                successor prior-cells) 0) 0
                        (if (eq (lwhrn-optional-declaration-valid?
                                    (lwrtr-blueprint-declaration blueprint)) 0)
                            0
                            (if (eq (lwhrn-optional-lens-valid?
                                        (lwrtr-blueprint-lens blueprint)) 0)
                                0
                                (if (eq (lwo-category?
                                            (lwrtr-blueprint-alternatives
                                                blueprint) LWO-FIELD) 0) 0
                                    (if (eq (lwhrn-optional-unknown-valid?
                                                (lwrtr-blueprint-unknown
                                                    blueprint)) 0) 0
                                        (if (eq (lwlc-choice-valid?
                                                    (lwrtr-blueprint-choice
                                                        blueprint)) 0) 0
                                            (lwhrn-optional-timeout-valid?
                                                (lwrtr-blueprint-timeout
                                                    blueprint)))))))))))))

(defn lwrtr-ancestor-sources (world match suite)
    (lwrtr-union-items
        (lwo-field-items (lwrtep-suite-sources world suite))
        (lwrtr-union-items
            (lwo-field-items (lwrth-match-revision-sources match))
            (lwrth-match-tree-sources match))))
(defn lwrtr-cell-source-clean? (world cell ancestors threshold)
    (do
        (let sources (lwrth-direct-sources world cell))
        (if (and (ge (lwo-field-size sources) threshold)
                 (eq (lwrth-fields-disjoint? sources ancestors) 1)) 1 0)))

(defn lwrtr-new-tree-current-items?
    (world items successor suite prior-cells ancestors threshold)
    (if (eq (len items) 0) 1
        (do
            (let tree (head items))
            (if (eq (lwo-field-has? prior-cells tree) 1)
                (lwrtr-new-tree-current-items? world (tail items) successor
                    suite prior-cells ancestors threshold)
                (if (eq (lwrtr-cell-source-clean?
                            world tree ancestors threshold) 0) 0
                    (if (eq (lwrt-reference? tree) 1)
                        (if (and
                                (eq (lwrtr-reference-covered? tree suite) 1)
                                (eq (lwrt-optional-cell-current? world
                                    (lwrt-reference-evidence tree) threshold) 1))
                            (lwrtr-new-tree-current-items? world (tail items)
                                successor suite prior-cells ancestors threshold)
                            0)
                        (if (eq (lwrt-literal? tree) 1)
                            (if (and
                                    (eq (lwrtr-literal-grounded? tree suite) 1)
                                    (eq (lwo-active? world
                                        (lwrt-literal-evidence tree)) 1))
                                (lwrtr-new-tree-current-items? world (tail items)
                                    successor suite prior-cells ancestors
                                    threshold) 0)
                            (do
                                (let operator
                                    (lwrt-application-operator tree))
                                (let arguments
                                    (lwrt-application-arguments tree))
                                (if (or
                                        (eq (lwrtr-new-operator-valid?
                                                operator successor) 0)
                                        (or (eq (lwrtr-cell-source-clean?
                                                    world operator ancestors
                                                    threshold) 0)
                                            (or (eq (lwrtr-cell-source-clean?
                                                        world arguments
                                                        ancestors threshold) 0)
                                                (eq (lwo-active? world
                                                    (lwrt-application-evidence
                                                        tree)) 0))))
                                    0
                                    (lwrtr-new-tree-current-items? world
                                        (append
                                            (lwrt-argument-items arguments)
                                            (tail items))
                                        successor suite prior-cells ancestors
                                        threshold))))))))))

(defn lwrtr-successor-contradicted-case-items
    (items field)
    (if (eq (len items) 0) field
        (do
            (let placement (head items))
            (let case (lwps-placement-case placement))
            (lwrtr-successor-contradicted-case-items (tail items)
                (if (and (eq (lwrtr-resolved-case? case) 1)
                         (and (gt (lwo-field-size
                                    (lwps-placement-outputs placement)) 0)
                              (eq (lwo-field-size
                                    (lwps-placement-matches placement)) 0)))
                    (lwo-field-add field case) field)))))
(defn lwrtr-successor-contradicted-cases (candidate suite)
    (lwrtr-successor-contradicted-case-items
        (lwo-field-items
            (lwps-evaluation-placements
                (lwrtep-evaluate-successor-ready candidate suite)))
        (lwo-empty-field)))

(defn lwrtr-field-items-current? (world items threshold)
    (if (eq (len items) 0) 1
        (if (eq (lwrt-recurrent-cell?
                    world (head items) threshold) 1)
            (lwrtr-field-items-current? world (tail items) threshold) 0)))
(defn lwrtr-blueprint-current-ready? (world blueprint threshold)
    ; The caller has already verified the exact successor/suite membrane.
    (if (or (lt threshold 1)
            (or (eq (lwrtr-blueprint-shape-valid? blueprint) 0)
                (eq (lwrt-recurrent-cell?
                        world blueprint threshold) 0))) 0
        (do
            (let successor (lwrtr-blueprint-successor blueprint))
            (let match (lwrtr-blueprint-match blueprint))
            (let suite (lwrtr-blueprint-suite blueprint))
            (if (eq (lwo-field-size
                        (lwrtr-successor-contradicted-cases
                            successor suite)) 0) 0
                (do
                    (let prior-cells
                        (lwrtr-tree-cells (lwrtr-prior-root match)))
                    (let ancestors
                        (lwrtr-ancestor-sources world match suite))
                    (if (eq (lwrtr-cell-source-clean?
                                world blueprint ancestors threshold) 0) 0
                        (if (eq (lwrtr-new-tree-current-items? world
                                    (list (lwrtr-blueprint-root blueprint))
                                    successor suite prior-cells ancestors
                                    threshold) 0) 0
                            (if (eq (lwrtr-field-items-current? world
                                        (lwo-field-items
                                            (lwrtr-blueprint-alternatives
                                                blueprint)) threshold) 0) 0
                                (if (and
                                        (eq (lwrt-optional-cell-current? world
                                            (lwrtr-blueprint-declaration
                                                blueprint) threshold) 1)
                                        (and
                                            (eq (lwrt-optional-cell-current?
                                                world
                                                (lwrtr-blueprint-lens blueprint)
                                                threshold) 1)
                                            (and
                                                (eq (lwrt-optional-cell-current?
                                                    world
                                                    (lwrtr-blueprint-unknown
                                                        blueprint) threshold) 1)
                                                (and
                                                    (eq (lwrt-optional-cell-current?
                                                        world
                                                        (lwrtr-blueprint-choice
                                                            blueprint)
                                                        threshold) 1)
                                                    (and
                                                        (eq (lwrt-optional-cell-current?
                                                            world
                                                            (lwrtr-blueprint-timeout
                                                                blueprint)
                                                            threshold) 1)
                                                        (eq (lwo-active? world
                                                            (lwrtr-blueprint-evidence
                                                                blueprint))
                                                            1)))))) 1 0)))))))))

(defn lwrtr-blueprint-current? (world blueprint threshold)
    ; Cheap local failures close before the deep parent graph is revisited.
    (if (or (lt threshold 1)
            (or (eq (lwrtr-blueprint-shape-valid? blueprint) 0)
                (eq (lwrt-recurrent-cell?
                        world blueprint threshold) 0))) 0
        (if (eq (lwrtep-ready? world
                    (lwrtr-blueprint-successor blueprint)
                    (lwrtr-blueprint-suite blueprint) threshold) 0) 0
            (lwrtr-blueprint-current-ready? world blueprint threshold))))

(defn lwrtr-recipe-for (blueprint)
    (lwre-recipe (lwrt-source-for (lwrtr-blueprint-root blueprint))
        (lwre-bound-form-contract 1024 blueprint) blueprint))

; children: exact case, Recipe, bindings, output, match bit, local path.
(defn lwrtr-derivation (case recipe output exact)
    (intern_node LWRTR-DERIVATION
        (list case recipe (lwps-case-bindings case) output
              (intern_trivial_int exact) (lwo-local-path))))
(defn lwrtr-derive-case (recipe case)
    (do
        (let output
            (intern_trivial_int
                (lwre-evaluate-bound recipe (lwps-case-bindings case))))
        (let exact
            (if (and (eq (lwrtr-resolved-case? case) 1)
                     (node_eq output
                        (oac-payload (lwps-case-immediate case)))) 1 0))
        (lwrtr-derivation case recipe output exact)))
(defn lwrtr-place-case (recipe case)
    (if (eq (lwrtr-resolved-case? case) 0)
        (lwps-placement case (lwo-empty-field) (lwo-empty-field)
            (lwo-empty-field) (lwps-case-time case)
            (lwps-case-alternatives case) (lwps-case-unknown case)
            (lwps-case-lens case) (lwps-case-evidence case))
        (do
            (let derivation (lwrtr-derive-case recipe case))
            (let derivations (lwo-field (list derivation)))
            (let outputs
                (lwo-field (list (nth (node_children derivation) 3))))
            (let matches
                (if (eq (node_value
                            (nth (node_children derivation) 4)) 1)
                    derivations (lwo-empty-field)))
            (lwps-placement case derivations outputs matches
                (lwps-case-time case) (lwps-case-alternatives case)
                (lwps-case-unknown case) (lwps-case-lens case)
                (lwps-case-evidence case)))))
(defn lwrtr-place-case-items (items recipe field)
    (if (eq (len items) 0) field
        (lwrtr-place-case-items (tail items) recipe
            (lwo-field-add field
                (lwrtr-place-case recipe (head items))))))

; children: blueprint, Recipe, retained evaluations, prospective placements,
; metrics, state, alternatives, unknowns, local path.
(defn lwrtr-composition
    (blueprint recipe retained placements metrics state alternatives unknowns)
    (intern_node LWRTR-COMPOSITION
        (list blueprint recipe retained placements metrics state alternatives
              unknowns (lwo-local-path))))
(defn lwrtr-composition? (cell)
    (lwo-category? cell LWRTR-COMPOSITION))
(defn lwrtr-composition-blueprint (composition)
    (nth (node_children composition) 0))
(defn lwrtr-composition-recipe (composition)
    (nth (node_children composition) 1))
(defn lwrtr-composition-retained (composition)
    (nth (node_children composition) 2))
(defn lwrtr-composition-placements (composition)
    (nth (node_children composition) 3))
(defn lwrtr-composition-metrics (composition)
    (nth (node_children composition) 4))
(defn lwrtr-composition-state (composition)
    (nth (node_children composition) 5))
(defn lwrtr-composition-alternatives (composition)
    (nth (node_children composition) 6))
(defn lwrtr-composition-unknowns (composition)
    (nth (node_children composition) 7))

(defn lwrtr-composition-for (blueprint)
    (do
        (let successor (lwrtr-blueprint-successor blueprint))
        (let suite (lwrtr-blueprint-suite blueprint))
        (let target (lwrtep-target-for successor))
        (let recipe (lwrtr-recipe-for blueprint))
        (let retained
            (lwhrn-evaluations-items recipe
                (lwo-field-items
                    (lwht-tissue-placements (lwo-emergent-shape target)))
                (lwo-empty-field)))
        (let retained-state
            (lwhrn-evaluation-state-items
                (lwo-field-items retained) 0 0 0))
        (let placements
            (lwrtr-place-case-items
                (lwo-field-items
                    (lwps-dataset-cases (lwps-suite-dataset suite)))
                recipe (lwo-empty-field)))
        (let metrics (lwps-metrics-for placements))
        (let state
            (if (and (eq (lwph-consistent? retained-state) 1)
                     (and (eq (lwps-metrics-value metrics 2)
                                (lwps-metrics-value metrics 1))
                          (and (eq (lwps-metrics-value metrics 4) 0)
                               (eq (lwps-metrics-value metrics 5) 0))))
                (lwph-consistent) (lwph-divergent)))
        (let unknown (lwrtr-blueprint-unknown blueprint))
        (lwrtr-composition blueprint recipe retained placements metrics state
            (lwrtr-blueprint-alternatives blueprint)
            (if (node_eq unknown (lwo-none)) (lwo-empty-field)
                (lwo-field (list unknown))))))

(defn lwrtr-collect-blueprints-ready
    (world items successor suite threshold field)
    (if (eq (len items) 0) field
        (lwrtr-collect-blueprints-ready world (tail items) successor suite
            threshold
            (if (and (eq (lwrtr-blueprint? (head items)) 1)
                     (and (node_eq (lwrtr-blueprint-successor (head items))
                            successor)
                          (and (node_eq (lwrtr-blueprint-suite (head items))
                                suite)
                               (eq (lwrtr-blueprint-current-ready?
                                    world (head items) threshold) 1))))
                (lwo-field-add field (head items)) field))))
(defn lwrtr-blueprints-for-ready (world successor suite threshold)
    (lwrtr-collect-blueprints-ready world
        (lwo-field-items (lwo-world-cells world)) successor suite threshold
        (lwo-empty-field)))
(defn lwrtr-blueprints-for (world successor suite threshold)
    (if (eq (lwrtep-ready? world successor suite threshold) 0)
        (lwo-empty-field)
        (lwrtr-blueprints-for-ready world successor suite threshold)))
(defn lwrtr-compositions-items (items all compatible divergent)
    (if (eq (len items) 0) (list all compatible divergent)
        (do
            (let composition (lwrtr-composition-for (head items)))
            (lwrtr-compositions-items (tail items)
                (lwo-field-add all composition)
                (if (eq (lwph-consistent?
                            (lwrtr-composition-state composition)) 1)
                    (lwo-field-add compatible composition) compatible)
                (if (eq (lwph-divergent?
                            (lwrtr-composition-state composition)) 1)
                    (lwo-field-add divergent composition) divergent)))))

; children: successor, suite, every blueprint/composition, compatible and
; divergent subsets, OPEN/READY/PLURAL, alternatives, unknowns, witnesses,
; threshold, local path.
(defn lwrtr-field-cell
    (successor suite blueprints compositions compatible divergent status
     alternatives unknowns witnesses threshold)
    (intern_node LWRTR-FIELD
        (list successor suite blueprints compositions compatible divergent
              status alternatives unknowns witnesses
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwrtr-field? (cell) (lwo-category? cell LWRTR-FIELD))
(defn lwrtr-field-successor (field) (nth (node_children field) 0))
(defn lwrtr-field-suite (field) (nth (node_children field) 1))
(defn lwrtr-field-blueprints (field) (nth (node_children field) 2))
(defn lwrtr-field-compositions (field) (nth (node_children field) 3))
(defn lwrtr-field-compatible (field) (nth (node_children field) 4))
(defn lwrtr-field-divergent (field) (nth (node_children field) 5))
(defn lwrtr-field-status (field) (nth (node_children field) 6))
(defn lwrtr-field-alternatives (field) (nth (node_children field) 7))
(defn lwrtr-field-unknowns (field) (nth (node_children field) 8))
(defn lwrtr-field-witnesses (field) (nth (node_children field) 9))
(defn lwrtr-field-threshold (field)
    (node_value (nth (node_children field) 10)))

(defn lwrtr-blueprint-options-items (items alternatives unknowns)
    (if (eq (len items) 0) (list alternatives unknowns)
        (do
            (let blueprint (head items))
            (let unknown (lwrtr-blueprint-unknown blueprint))
            (lwrtr-blueprint-options-items (tail items)
                (lwrtr-union-items
                    (lwo-field-items
                        (lwrtr-blueprint-alternatives blueprint)) alternatives)
                (if (node_eq unknown (lwo-none)) unknowns
                    (lwo-field-add unknowns unknown))))))

; Witness collection is world-dependent and kept separate from option folding.
(defn lwrtr-blueprint-witness-items (world items field)
    (if (eq (len items) 0) field
        (lwrtr-blueprint-witness-items world (tail items)
            (lwrtr-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world (head items))) field))))
(defn lwrtr-field-for-ready (world successor suite threshold)
    (do
            (let blueprints
                (lwrtr-blueprints-for-ready world successor suite threshold))
            (let groups
                (lwrtr-compositions-items
                    (lwo-field-items blueprints) (lwo-empty-field)
                    (lwo-empty-field) (lwo-empty-field)))
            (let compositions (nth groups 0))
            (let compatible (nth groups 1))
            (let divergent (nth groups 2))
            (let count (lwo-field-size compatible))
            (let status
                (if (eq count 1) (lwhrn-ready)
                    (if (gt count 1) (lwhrn-plural) (lwhrn-open))))
            (let options
                (lwrtr-blueprint-options-items (lwo-field-items blueprints)
                    (lwo-empty-field) (lwo-empty-field)))
            (let witnesses
                (lwrtr-blueprint-witness-items world
                    (lwo-field-items blueprints)
                    (lwrtr-union-items
                        (lwo-field-items
                            (lwo-active-attributions-for world successor))
                        (lwrtr-union-items
                            (lwo-field-items
                                (lwo-active-attributions-for world suite))
                            (lwo-empty-field)))))
            (lwrtr-field-cell successor suite blueprints compositions
                compatible divergent status (nth options 0)
                (lwo-field-add (nth options 1)
                    (lwlc-unknown compositions)) witnesses threshold)))
(defn lwrtr-field-for (world successor suite threshold)
    (if (eq (lwrtep-ready? world successor suite threshold) 0) (lwo-none)
        (lwrtr-field-for-ready world successor suite threshold)))

(defn lwrtr-origin (successor suite threshold)
    (intern_node LWRTR-ORIGIN
        (list successor suite (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwrtr-origin-successor (origin) (nth (node_children origin) 0))
(defn lwrtr-origin-suite (origin) (nth (node_children origin) 1))
(defn lwrtr-origin-threshold (origin)
    (node_value (nth (node_children origin) 2)))
(defn lwrtr-proposal-from-field (field)
        (if (or (node_eq field (lwo-none))
                (eq (lwo-field-size (lwrtr-field-blueprints field)) 0))
            (lwo-none)
            (do
                (let successor (lwrtr-field-successor field))
                (let suite (lwrtr-field-suite field))
                (let threshold (lwrtr-field-threshold field))
                (let witnesses (lwrtr-field-witnesses field))
                (let compatible
                    (lwo-field-size (lwrtr-field-compatible field)))
                (let total
                    (lwo-field-size (lwrtr-field-compositions field)))
                (let origin (lwrtr-origin successor suite threshold))
                (let candidate
                    (lwo-emergent field witnesses
                        (intern_trivial_int compatible)
                        (intern_trivial_int total)
                        (intern_trivial_int
                            (lwo-field-size witnesses)) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin))))
(defn lwrtr-proposal-for (world successor suite threshold)
    (lwrtr-proposal-from-field
        (lwrtr-field-for world successor suite threshold)))
(defn lwrtr-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrtr-field?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwrtr-candidate-current? (world candidate)
    (if (eq (lwrtr-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwrtr-proposal-for world
                    (lwrtr-origin-successor origin)
                    (lwrtr-origin-suite origin)
                    (lwrtr-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwrtr-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrtr-candidate-current? world candidate) 1)) 1 0))
(defn lwrtr-integrate (round proposal action)
    (if (eq (lwrtr-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

(defn lwrtr-progress-target (field)
    (if (node_eq field (lwo-none)) "field:nothing"
        (lcfb-cat (list
            "blueprints:" (int_to_str
                (lwo-field-size (lwrtr-field-blueprints field)))
            ":compatible:" (int_to_str
                (lwo-field-size (lwrtr-field-compatible field)))
            ":divergent:" (int_to_str
                (lwo-field-size (lwrtr-field-divergent field)))
            ":ready:" (int_to_str
                (lwhrn-ready? (lwrtr-field-status field)))))))

