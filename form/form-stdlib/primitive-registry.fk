// primitive-registry.fk — the common native table: one row per native the
// kernels carry, each with its declared outside:
// (name, Form category, contract line, verification probe, expected outside, lane).
//
// The rows are docs/kernel-interface.md's pure core and measured natives that
// are natives on the siblings, and the host doors the siblings still carry.
// A name with a home in Form or BML has no row: fkwu links the home by name and
// hands it to every sibling inside the closure.
//
// lane 1 — four-way: fkwu answers the name from runtime/fkwu-optable.h, Go,
//          Rust and TS register it, and the probe runs in-band
//          (tests/primitive-registry-band.fk).
// lane 0 — declared, not run in-band; the spec names why:
//            host-io          the answer depends on host command authority
//            socket-carrier   loopback I/O proven in the socket bands
//            one-meaning      the kernels answer it differently today
// The sibling doors at the end carry no probe: fkwu has no name for them.
//
// The category tokens mirror form-kernel-go/main.go's attribution
// constructors (call access method compare list witness undefined).
// Drift gate: gate/primitive-registry.bml — rows and doors == main.go's
// natives, tokens == Go attribution, lane 1 ⊆ fkwu ∩ Rust ∩ TS, every row
// a name fkwu answers.
// Probes that touch the host write under temp_dir() with this process's pid,
// so four kernels running at once never share a path.
section [form.bml] {
    // ── the cell: one native's declared outside ──────────────────────────
    def prim(name, category, spec, verify, expected, mode) = ["prim", name, category, spec, verify, expected, mode];
    def prim-name(e) = e[1];
    def prim-category(e) = e[2];
    def prim-spec(e) = e[3];
    def prim-verify(e) = e[4];
    def prim-expected(e) = e[5];
    def prim-mode(e) = e[6];
    // verification: run the declared recipe, compare the declared outside.
    def prim-call0(f) = f();
    def prim-verified?(e) = (Comparable) prim-call0(prim-verify(e)) == prim-expected(e);
    // ── walk helpers over the registry ───────────────────────────────────
    def prim-known-token?(t) = (String) t == "call" || ((String) t == "access" || ((String) t == "method" || ((String) t == "compare" || ((String) t == "list" || ((String) t == "witness" || (String) t == "undefined")))));
    def prim-shape-ok?(e) = (Comparable) len(e) == 7 && ((String) e[0] == "prim" && (len(prim-name(e)) > 0 && (len(prim-spec(e)) > 0 && prim-known-token?(prim-category(e)))));
    def prim-shapes-ok-count(entries) = (Comparable) len(entries) == 0 ? 0 : (Number) (prim-shape-ok?(entries[0]) ? 1 : 0) + (Number) prim-shapes-ok-count(entries[1:]);
    def prim-mode-count(entries, m) = (Comparable) len(entries) == 0 ? 0 : (Number) ((Comparable) prim-mode(entries[0]) == m ? 1 : 0) + (Number) prim-mode-count(entries[1:], m);
    // lane-1 verifications that answer their declared outside.
    def prim-verified-count(entries) = (Comparable) len(entries) == 0 ? 0 : (Number) ((Comparable) prim-mode(entries[0]) == 1 ? prim-verified?(entries[0]) ? 1 : 0 : 0) + (Number) prim-verified-count(entries[1:]);
    def prim-name-in?(entries, n) = (Comparable) len(entries) == 0 ? false : (String) prim-name(entries[0]) == n ? true : prim-name-in?(entries[1:], n);
    def prim-dup-count(entries) = (Comparable) len(entries) == 0 ? 0 : (Number) (prim-name-in?(entries[1:], prim-name(entries[0])) ? 1 : 0) + (Number) prim-dup-count(entries[1:]);
    def prim-find(entries, n) = (Comparable) len(entries) == 0 ? 0 : (String) prim-name(entries[0]) == n ? entries[0] : prim-find(entries[1:], n);

    // ── the verification probes ──────────────────────────────────────────
    // Each probe is a zero-argument definition the row names bare: on fkwu a
    // defn in value position runs its body, so a probe is never written inline.
    // PRIM-REGISTRY-PROBE's coordinates (blueprint-registry.json), built with
    // make_nodeid so no probe leans on bp.
    def pv-bp() = make_nodeid(1, 2, 99, 24);
    def pv-add-cat() = make_nodeid(1, 2, 12, 1);
    // the smallest composite (add 2 3): a probe observes it, nothing walks it.
    def pv-probe-recipe() = intern_node(pv-add-cat(), [intern_trivial_int(2), intern_trivial_int(3)]);
    def pv-path(tag) = (temp_dir() + ("/prim-reg-" + (tag + ("-" + (host_pid().str() + ("-" + host_monotonic_ms().str()))))));
    // the probe's answer, read before its path leaves (a file or a directory tree)
    def pv-gone(p, answer) = {
        fs_remove(p);
        fs_rmdir(p);
        answer;
    };
    def pv-method-define-m(self) = 11;
    def pv-method-has-m(self) = 1;
    def pv-method-invoke-m(self, n) = (Number) n + (Number) 4;
    def pv-method-define() = {
        method_define(pv-bp(), "pv-def", pv-method-define-m);
        method_invoke(record_new(pv-bp()), "pv-def");
    };
    def pv-method-has() = {
        method_define(pv-bp(), "pv-has", pv-method-has-m);
        method_has(record_new(pv-bp()), "pv-has") ? method_has(record_new(pv-bp()), "pv-absent") ? 0 : 1 : 0;
    };
    def pv-method-invoke() = {
        method_define(pv-bp(), "pv-inv", pv-method-invoke-m);
        method_invoke(record_new(pv-bp()), "pv-inv", 3);
    };
    def pv-print() = {
        print("prim-registry-print-probe");
        1;
    };
    def pv-str-len() = str_len("satsang");
    def pv-substring() = (String) substring("satsang", 3, 7) == "sang" ? 1 : 0;
    def pv-str-concat() = str_len(str_concat("sat", "sang"));
    def pv-host-exec() = len(host-exec("printf form", ""));
    def pv-form-error() = nothing?(attempt(form_error("prim-registry-probe"))) ? 1 : 0;
    def pv-record-new() = record?(record_new(pv-bp(), "x", 1)) ? 1 : 0;
    def pv-record-get() = record_get(record_new(pv-bp(), "x", 41), "x");
    def pv-record-set() = record_get(record_set(record_new(pv-bp(), "x", 1), "x", 8), "x");
    def pv-record-has() = record_has(record_new(pv-bp(), "x", 1), "x") ? record_has(record_new(pv-bp()), "y") ? 0 : 1 : 0;
    def pv-record-blueprint() = value_eq(record_blueprint(record_new(pv-bp())), pv-bp()) ? 1 : 0;
    def pv-record-keys() = len(record_keys(record_new(pv-bp(), "a", 1, "b", 2)));
    def pv-record?() = record?(record_new(pv-bp())) ? record?(7) ? 0 : 1 : 0;
    def pv-str-find() = str_find("satsang", "sang", 0);
    def pv-scan-run() = scan_run("  form", 0, 0);
    def pv-str-eq() = (Number) ((String) "a" == "a") + (Number) (((String) "a" == "b") * 7);
    def pv-value-str() = (String) value_str([1, "a", 2.5, nothing()]) == "[1, a, 2.5, null]" ? 1 : 0;
    def pv-value-kind() = (String) value_kind(7) == "int" ? 1 : 0;
    def pv-value-kind-k() = (String) value-kind(7) == "int" ? 1 : 0;
    def pv-nothing() = (String) value_kind(nothing()) == "null" ? 1 : 0;
    def pv-nothing?() = (Comparable) nothing?(nothing()) == 1 && (Comparable) nothing?([]) == 0 ? 1 : 0;
    def pv-str-to-float() = round(str_to_float(" 2.5abc"));
    def pv-float-to-int() = (Number) float_to_int(3.9) + (Number) float_to_int(-2.9);
    def pv-str-byte-at() = (Number) str_byte_at("AZ", 1) + (Number) str_byte_at("AZ", 5);
    def pv-byte-to-str() = (String) byte_to_str(65) == "A" ? 1 : 0;
    def pv-input-byte() = input_byte(-1);
    def pv-list() = len(list(1, 2, 3));
    def pv-cons() = head(cons(9, [1]));
    def pv-head() = head([7, 8]);
    def pv-tail() = len(tail([1, 2, 3]));
    def pv-len() = (Number) len([1, 2]) + (Number) ((Number) len("abc") + (Number) len(cons("__dict__", empty())));
    def pv-nth() = nth([4, 5, 6], 2);
    def pv-empty() = len(empty());
    def pv-get() = (Number) _get([4, 5], 1) + (Number) _get(["__dict__", "k", 10], "k");
    def pv-math-sqrt() = round(math_sqrt(9.0));
    def pv-math-pi() = round(math_pi() * 2.0);
    def pv-math-pow() = round(math_pow(2.0, 10.0));
    def pv-math-log() = round(math_log(math_exp(1.0)));
    def pv-math-exp() = round(math_exp(0.0));
    def pv-round-ndigits() = round(round_ndigits(2.5, 0));
    def pv-make-float32() = round(float_value(make_float32(0.5)) * 2.0);
    def pv-make-float64() = round(float_value(make_float64(2.5)));
    def pv-float-leaf() = nothing?(float_leaf(9, 0)) ? 1 : 0;
    def pv-host-file-read-text() = {
        let p = pv-path("hrt");
        write_file_text(p, "satsang");
        pv-gone(p, len(host_file_read_text(p)));
    };
    def pv-read-file() = {
        let p = pv-path("rf");
        write_file_text(p, "satsang");
        pv-gone(p, len(read_file(p)));
    };
    def pv-read-file-bytes() = {
        let p = pv-path("rb");
        write_file_text(p, "satsang");
        pv-gone(p, head(read_file_bytes(p)));
    };
    def pv-source-inventory() = {
        let d = pv-path("inv");
        fs_mkdir(d);
        write_file_text((d + "/a.txt"), "x");
        pv-gone(d, len(source_inventory(d, ".txt", [])) >= 1 ? 1 : 0);
    };
    def pv-band() = band(12, 10);
    def pv-bor() = bor(12, 10);
    def pv-bxor() = bxor(12, 10);
    def pv-bnot-u32() = add_u32(bnot_u32(0), 1);
    def pv-shl-u32() = shr_u32(shl_u32(1, 31), 31);
    def pv-shr-u32() = shr_u32(1024, 10);
    def pv-rotr-u32() = rotr_u32(rotr_u32(1, 1), 31);
    def pv-add-u32() = add_u32(shl_u32(1, 31), shl_u32(1, 31));
    def pv-recipe-to-bytes() = len(recipe_to_bytes(pv-probe-recipe())) >= 10 ? 1 : 0;
    def pv-bytes-to-recipe() = value_eq(bytes_to_recipe(recipe_to_bytes(pv-probe-recipe())), pv-probe-recipe()) ? 1 : 0;
    def pv-write-form-binary() = {
        let p = pv-path("wfb");
        pv-gone(p, write_form_binary(p, pv-probe-recipe()) > 0 ? 1 : 0);
    };
    def pv-read-form-binary() = {
        let p = pv-path("rfb");
        write_form_binary(p, pv-probe-recipe());
        pv-gone(p, value_eq(read_form_binary(p), pv-probe-recipe()) ? 1 : 0);
    };
    def pv-host-file-size() = {
        let p = pv-path("hsz");
        write_file_text(p, "12345");
        pv-gone(p, host_file_size(p));
    };
    def pv-file-size() = {
        let p = pv-path("sz");
        write_file_text(p, "12345");
        pv-gone(p, file_size(p));
    };
    def pv-host-file-mtime() = {
        let p = pv-path("hmt");
        write_file_text(p, "x");
        pv-gone(p, host_file_mtime(p) > 0 ? 1 : 0);
    };
    def pv-file-mtime() = {
        let p = pv-path("mt");
        write_file_text(p, "x");
        pv-gone(p, file_mtime(p) > 0 ? 1 : 0);
    };
    def pv-host-file-read-slice() = {
        let p = pv-path("hsl");
        write_file_text(p, "satsang");
        pv-gone(p, (String) host_file_read_slice(p, 3, 4) == "sang" ? 1 : 0);
    };
    def pv-read-file-slice() = {
        let p = pv-path("sl");
        write_file_text(p, "satsang");
        pv-gone(p, (String) read_file_slice(p, 3, 4) == "sang" ? 1 : 0);
    };
    def pv-host-path-exists() = {
        let d = pv-path("hex");
        host_dir_mkdir(d);
        pv-gone(d, (Number) host_path_exists(d) + (Number) host_path_exists((d + "-absent")));
    };
    def pv-fs-exists() = {
        let d = pv-path("ex");
        fs_mkdir(d);
        pv-gone(d, (Number) fs_exists(d) + (Number) fs_exists((d + "-absent")));
    };
    def pv-host-path-is-dir() = {
        let d = pv-path("hisd");
        host_dir_mkdir(d);
        pv-gone(d, (Number) host_path_is_dir(d) + (Number) host_path_is_dir((d + "-absent")));
    };
    def pv-fs-is-dir() = {
        let d = pv-path("isd");
        fs_mkdir(d);
        pv-gone(d, (Number) fs_is_dir(d) + (Number) fs_is_dir((d + "-absent")));
    };
    // a fresh directory made twice, then removed: 2 x the first answer + the second reads 2
    // when the first call created it and the second found it standing.
    def pv-mkdir-fold(d, made, again) = {
        fs_rmdir(d);
        (Number) (made * 2) + (Number) again;
    };
    def pv-host-dir-mkdir() = {
        let d = pv-path("hmk");
        let made = host_dir_mkdir(d);
        pv-mkdir-fold(d, made, host_dir_mkdir(d));
    };
    def pv-fs-mkdir() = {
        let d = pv-path("mk");
        let made = fs_mkdir(d);
        pv-mkdir-fold(d, made, fs_mkdir(d));
    };
    def pv-host-dir-rmdir() = {
        let d = pv-path("hrm");
        host_dir_mkdir(d);
        host_dir_mkdir((d + "/inner"));
        write_file_text((d + "/inner/f.txt"), "x");
        (Number) host_dir_rmdir(d) + (Number) host_path_exists(d);
    };
    def pv-fs-rmdir() = {
        let d = pv-path("rm");
        fs_mkdir(d);
        fs_mkdir((d + "/inner"));
        write_file_text((d + "/inner/f.txt"), "x");
        (Number) fs_rmdir(d) + (Number) fs_exists(d);
    };
    def pv-host-path-remove() = {
        let p = pv-path("hdel");
        write_file_text(p, "x");
        (Number) host_path_remove(p) + (Number) host_path_exists(p);
    };
    def pv-fs-remove() = {
        let p = pv-path("del");
        write_file_text(p, "x");
        (Number) fs_remove(p) + (Number) fs_exists(p);
    };
    def pv-host-path-rename() = {
        let p = pv-path("hmv");
        write_file_text(p, "x");
        host_path_rename(p, (p + "-b"));
        pv-gone((p + "-b"), (Number) host_path_exists((p + "-b")) + (Number) host_path_exists(p));
    };
    def pv-fs-rename() = {
        let p = pv-path("mv");
        write_file_text(p, "x");
        fs_rename(p, (p + "-b"));
        pv-gone((p + "-b"), (Number) fs_exists((p + "-b")) + (Number) fs_exists(p));
    };
    def pv-host-dir-list() = {
        let d = pv-path("hls");
        host_dir_mkdir(d);
        write_file_text((d + "/f.txt"), "x");
        pv-gone(d, len(host_dir_list(d)) >= 1 ? 1 : 0);
    };
    def pv-fs-list() = {
        let d = pv-path("ls");
        fs_mkdir(d);
        write_file_text((d + "/one.txt"), "x");
        pv-gone(d, len(fs_list(d)) >= 1 ? 1 : 0);
    };
    def pv-socket-listen() = {
        let h = socket_listen(0);
        socket_close(h);
        h >= 0 ? 1 : 0;
    };
    def pv-socket-port() = {
        let h = socket_listen(0);
        let p = socket_port(h);
        socket_close(h);
        p > 0 ? 1 : 0;
    };
    def pv-socket-accept() = socket_accept(-1);
    def pv-socket-connect() = socket_connect("127.0.0.1", 9);
    def pv-socket-send() = socket_send(-1, "x");
    def pv-socket-recv() = nothing?(socket_recv(-1, 4)) ? 0 : 1;
    def pv-socket-close() = socket_close(-1);
    def pv-make-nodeid() = (Number) node_type(make_nodeid(1, 2, 12, 1)) + (Number) node_inst(make_nodeid(1, 2, 12, 1));
    def pv-bp-type() = node_type(bp("add"));
    def pv-intern-trivial-int() = node_value(intern_trivial_int(77));
    def pv-intern-trivial-string() = (String) node_value(intern_trivial_string("sat")) == "sat" ? 1 : 0;
    def pv-intern-trivial-bool() = (Number) node_inst(intern_trivial_bool(true)) + (Number) node_inst(intern_trivial_bool(false));
    def pv-intern-trivial-float() = round(float_value(intern_trivial_float("0.5")) * 2.0);
    def pv-float-value() = round(float_value(make_float64(1.5)));
    def pv-intern-node() = value_eq(pv-probe-recipe(), pv-probe-recipe()) && (value_eq(node_category(pv-probe-recipe()), pv-add-cat()) && (Comparable) node_value(node_children(pv-probe-recipe())[1]) == 3) ? 1 : 0;
    def pv-node-category() = value_eq(node_category(pv-probe-recipe()), pv-add-cat()) ? 1 : 0;
    def pv-node-children() = len(node_children(pv-probe-recipe()));
    def pv-node-value() = node_value(intern_trivial_int(41));
    def pv-node-pkg() = node_pkg(make_nodeid(2, 3, 4, 5));
    def pv-node-level() = node_level(make_nodeid(2, 3, 4, 5));
    def pv-node-type() = node_type(make_nodeid(2, 3, 4, 5));
    def pv-node-inst() = node_inst(make_nodeid(2, 3, 4, 5));
    def pv-value-eq() = (Number) value_eq(7, 7) + (Number) (value_eq(7, "7") * 7);
    def pv-node-eq() = (Number) node_eq(pv-add-cat(), pv-add-cat()) + (Number) (node_eq(pv-add-cat(), pv-bp()) * 7);
    def pv-fb-record() = value_eq(fb_record(pv-probe-recipe(), "prim-registry.fk", 65537), pv-probe-recipe()) ? 1 : 0;
    def pv-node-source() = node_source(fb_record(intern_node(pv-add-cat(), [intern_trivial_int(1), intern_trivial_int(1)]), "prim-reg-src.fk", 458755))[1];
    def pv-framebuffer-events() = len(framebuffer-events()) >= 0 ? 1 : 0;
    def pv-framebuffer-clear() = {
        framebuffer-clear();
        (Comparable) len(framebuffer-events()) == 0 ? 1 : 0;
    };
    def pv-write-file-bytes() = {
        let p = pv-path("wb");
        pv-gone(p, write_file_bytes(p, [1, 2, 3]));
    };
    def pv-host-file-append-bytes() = {
        let p = pv-path("hap");
        write_file_bytes(p, [1, 2]);
