    // ── the sibling doors — host doors Go, Rust and TS carry and fkwu has no
    // name for, so no unit fkwu compiles can call them; named here as strings.
    // A door leaves this table when fkwu answers its name (a lane-1 row) or its
    // last caller leaves (a release).
    def prim-door(name, category, spec) = ["door", name, category, spec];
    def prim-sibling-doors() = [
        prim-door("random_bytes", "call", "n bytes from /dev/urandom, for api.bml's event ids; entropy_bytes in the host door table"),
        prim-door("framebuffer-event-rows", "witness", "ordered detail rows of the framebuffer, read by api.bml's observe route"),
        prim-door("framebuffer-counts", "witness", "(file line col count) aggregation rows, read by api.bml's observe route"),
        prim-door("framebuffer-observe-start", "witness", "turns runtime observation on for api.bml's observe route"),
        prim-door("framebuffer-observe-stop", "witness", "turns runtime observation off for api.bml's observe route")];
    0;
}
