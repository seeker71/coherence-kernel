        pv-gone(p, write_file_text(p, "sat"));
    };
    def pv-now-unix-ms() = now_unix_ms() > 0 ? 1 : 0;
    def pv-host-temp-dir() = len(host_temp_dir()) > 0 ? 1 : 0;
    def pv-temp-dir() = len(temp_dir()) > 0 ? 1 : 0;
    def pv-host-pid() = host_pid() > 0 ? 1 : 0;
    def pv-host-monotonic-ms() = {
        let t0 = host_monotonic_ms();
        t0 >= 0 && t0 <= host_monotonic_ms() ? 1 : 0;
    };
    def pv-host-cwd() = len(host_cwd()) > 0 ? 1 : 0;
    def pv-kernel-stat() = {
        record_new(0);
        kernel_stat(164) > 0 ? 1 : 0;
    };
    def pv-kernel-live() = {
        let page = kernel_live(host_pid());
        (Comparable) page[1] == host_pid() && page[2] > 0 ? 1 : 0;
    };
    def pv-print-str() = (Comparable) print_str("prim-registry-print-str-probe") == 0 ? 1 : 0;

    // ── the table — main.go registration order ───────────────────────────
    def prim-registry() = [
        prim("print", "call", "writes its arguments space-separated and a newline to stdout, nothing as nothing; answers 0", pv-print, 1, 1),
        prim("str_len", "access", "byte length of a string; nothing stops", pv-str-len, 7, 1),
        prim("substring", "access", "bytes [max(a,0), min(b,len)); empty when reversed or not a string; never stops", pv-substring, 1, 1),
        prim("str_concat", "method", "two strings joined", pv-str-concat, 7, 1),
        prim("host-exec", "method", "host-io: runs a host command under sh -c with the second argument as its stdin and answers its output; a launch that never happened answers nothing", pv-host-exec, 4, 0),
        prim("form_error", "witness", "stops with the message; attempt recovers it to nothing", pv-form-error, 1, 1),
        prim("record_new", "method", "mutable record tagged by a blueprint (0 for none) with k v pairs", pv-record-new, 1, 1),
        prim("record_get", "access", "field value by name, 0 when absent", pv-record-get, 41, 1),
        prim("record_set", "method", "mutates the field in place and answers the record", pv-record-set, 8, 1),
        prim("record_has", "access", "field presence as 0/1", pv-record-has, 1, 1),
        prim("record_blueprint", "access", "the record's blueprint, 0 for none", pv-record-blueprint, 1, 1),
        prim("record_keys", "access", "field names in insertion order", pv-record-keys, 2, 1),
        prim("record?", "access", "record type predicate", pv-record?, 1, 1),
        prim("method_define", "method", "binds a definition as a named method on a blueprint; its first param is the receiver", pv-method-define, 11, 1),
        prim("method_has", "access", "method presence by the record's blueprint", pv-method-has, 1, 1),
        prim("method_invoke", "method", "dispatches by blueprint, binds the receiver then the args", pv-method-invoke, 7, 1),
        prim("str_find", "access", "byte index of needle from max(from,0), or -1; a non-string stops", pv-str-find, 3, 1),
        prim("scan_run", "access", "end index of a contiguous byte-class run (0 ws, 1 digit, 2 alpha, 3 ident, 4 nonquote, 5 nonnl, 6 jsonsafe)", pv-scan-run, 2, 1),
        prim("str_eq", "compare", "string equality as 0/1; nothing equals only nothing", pv-str-eq, 1, 1),
        prim("value_str", "method", "the one rendering: nothing is empty on its own and null as an item, a record and a closure name their kind", pv-value-str, 1, 1),
        prim("value_kind", "witness", "kind name: int string null list closure node_id float record", pv-value-kind, 1, 1),
        prim("nothing", "witness", "the axiom-1 third value: never-was, neither 0 nor empty", pv-nothing, 1, 1),
