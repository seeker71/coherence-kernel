        prim("bp", "witness", "one-meaning: fkwu's tag 45 answers its argument, the siblings answer bp_table.go's NodeID; law 10 is the BML resolution in form-ontology-bp.fk", pv-bp-type, 12, 0),
        prim("intern_trivial_int", "witness", "int as a trivial NodeID; node_value reads it back", pv-intern-trivial-int, 77, 1),
