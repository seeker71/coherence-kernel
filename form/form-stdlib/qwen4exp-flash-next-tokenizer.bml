//////////////////////////////////////////////////////////////////////
//
// qwen4exp-flash-next-tokenizer.bml — executable GGUF tokenizer.
//
// Authority: form-stdlib/bml/qwen4exp-flash-next-tokenizer.bml
// preludes: form-stdlib/dsv4-tokenizer.fk form-stdlib/qwen35-tokenizer.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class Qwen4ExpFlashNextTokenizerAuthority {
        field Q4TKAuthorityPath = "form/form-stdlib/bml/qwen4exp-flash-next-tokenizer.bml";
        field Q4TKAuthorityKind = "high-bml-interface-class-const";
    }

    class Qwen4ExpFlashNextTokenizer {
        field Q4TKVocab = 248320;
        field Q4TKBos = 248044;
        field Q4TKEos = 248046;

        ref q4tk-authority = Qwen4ExpFlashNextTokenizerAuthority;
        thought q4tk-law = list("gguf-vocab", "gguf-merges", "byte-bpe", "native-decode", "explicit-stop");

        def q4tk-encode(src, text) = q35-encode(src, text);
        def q4tk-decode(src, ids) = tkz-decode-text(src, ids);
        def q4tk-chat-ids(src, prompt) = q35-chat-ids(src, prompt);
        def q4tk-special-id(src, literal) = q35-special-id(src, literal);
        def q4tk-stop?(token) = if eq(token, Q4TKEos()) then 1 else 0;
        def q4tk-metadata-agrees?(src) = if eq(gmt-vocab-n(src), Q4TKVocab()) then if eq(gmt-u32(src, "tokenizer.ggml.bos_token_id"), Q4TKBos()) then if eq(gmt-u32(src, "tokenizer.ggml.eos_token_id"), Q4TKEos()) then 1 else 0 else 0 else 0;
    }
    0;
}
