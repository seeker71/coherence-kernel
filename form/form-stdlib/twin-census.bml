//////////////////////////////////////////////////////////////////////
//
// twin-census.bml — which of my doors is a private copy of a warm one.
//
// Authority: form-stdlib/bml/twin-census.bml
// preludes: form/form-stdlib/bearing-census.bml
// Proven by: form-stdlib/tests/twin-census-band.fk
//
// `bearing-census` ranks the doors the body LEANS ON. It answers "what is the
// next substring?" and it answers it by heat, which means a door nothing drives
// hard never rises. A private copy of a shared door is exactly that door: cold
// by construction, because nothing else in the body ever calls it. On
// 2026-09-07 four of them sat in `sha256.fk` — `nil?`, `nth-rec`, `append-1`,
// `append-list` — and the census only reached them once a locale walk drove
// them seventy-six million times. Routing them to the shared floor halved the
// walk (195.7M steps to 60.1M) and left corpus row 1351, `coldtwin`: a
// duplicate's price is not the duplication, it is standing outside everyone
// else's heat.
//
// This cell asks the inverse question, and asks it of the SOURCE rather than of
// the heat, so a cold door does not have to be driven before it can be named:
//
//   which of my doors has a twin on the shared floor, where the twin
//   crystallized and this one never will?
//
// Sameness is the hard part and the honest part. Three verdicts, never a bare
// claim:
//
//   looks-identical  the two normalized bodies are the same bytes. Normalized
//                    means: comments cut, whitespace squeezed, the door's own
//                    name rewritten to @s and each parameter to its position
//                    @0 @1 @2 — so `append-list(xs, ys)` and `append(xs, ys)`
//                    read as one body, which is what they are.
//   differs-at       the two bodies share a long prefix AND a long suffix and
//                    part in ONE window between them. Both sides of that window
//                    are carried, because the window is not noise: it is the
//                    adapter. `append-1` and `append` part at `@1` against
//                    `(list @1)`, and the heal that landed wrote exactly that —
//                    `(defn append-1 (xs x) (append xs (list x)))`.
//   unproven         the twin named is a NATIVE. A native has no body in any
//                    file, so no body comparison can be made; the pair is
//                    handed over as a lead for a band, never as a proof. This
//                    is the `nth-rec` / `nth` case, and a band is what settled
//                    it: they part at a negative index, and no caller stands
//                    there.
//
// Two doors that read alike but part on an edge are NOT twins. The window says
// where, so the reader can go look at the edge instead of trusting a ranking.
//
// The heat is an overlay, never the finder — and it must be read through the
// CRYSTAL column, not the heat column. Heat counts WALKS, and a door that
// crystallizes stops walking, so its heat freezes where it took off while a
// door that never crystallizes accrues without bound. Measured on 2026-09-07's
// morning tree: `append` in line-grammar.fk sat at 21,547 walks with crystal 3
// while `append-1` in sha256.fk sat at 30,191,048 with crystal 0. Read as
// calls, the cold door looks a thousand times the hotter. Only crystal
// separates them, which is why this lens compares crystal and reports heat.
//
// Crystal's states are not one thing either: 1 and 2 are earned (the JIT
// compiled that body), 3 is granted (the seed's recipe-twin table binds a few
// names at a fixed arity in a few named units). A warm side at 3 is warm
// because the seed knows its NAME — which is why sha256.fk's own PRIVATE
// `nil?` carried crystal 3 that same morning: a private copy is not cold by
// law, it is cold when its name is one the seed does not know.
//
// Warm is crystal >= 1. The warm side is never
// offered as the cold one — when exactly one of a pair is warm, the other is
// the cold one whatever order they were found in. And when the two doors carry
// the SAME name in two units, a name-keyed heat ledger cannot tell them apart
// at all, so the pair says `heat-ambiguous` and stops there: the finding stands
// without it, because one of two identical bodies under one name is dead weight
// whichever one the walker entered.
//
// A pair costs something to close, and the cost is named: `sites` is how many
// OTHER doors in the units given mention the cold name — the doors whose call
// would have to reach the warm one instead.
//
// What this cell will not see, said plainly:
//   - a pair parting inside the first TWCBucketBytes bytes of its body. Exact
//     twins are found by whole-body equality regardless; near-twins are only
//     compared inside a bucket keyed on that prefix, so the two loops must at
//     least begin alike.
//   - a Form door and a BML door meaning one thing. Their syntax differs, so
//     their normalized bodies differ; the lens reads bodies, not meanings.
//   - whitespace inside a string literal, which the squeeze collapses.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class TwinCensusAuthority {
        field TWCAuthorityPath = "form/form-stdlib/bml/twin-census.bml";
        field TWCAuthorityKind = "high-bml-interface-class-const";
    }

    class TwinCensus {
        field TWCSensor = "twin";
        field TWCCadenceMs = 5000;
        field TWCScale = 10000;
        field TWCNoReading = -1;
        field TWCBodyLines = 40;
        field TWCBucketBytes = 12;
        field TWCSimBp = 7000;
        field TWCWindowCap = 48;
        field TWCMinBody = 14;
        // as deep as the seed will give (kernel_hot_rows caps at 64), and the depth is not
        // a preference. Heat ranks by WALKS, and the warm side of a pair is warm exactly
        // because it stopped walking — so the crystallized door is the one a heat-ranked
        // snapshot loses first. Witnessed 2026-09-07 on the morning tree: at 40 rows
        // `append` was absent and every pair read `no-warm-side`; at 64 it stands at
        // 21,547 walks with crystal 3, and the same pairs read `cold-and-warm`
        field TWCTopN = 64;
        ref twc-authority = TwinCensusAuthority;
        thought twc-pattern = list("the-source-finds-the-pair-the-heat-only-colours-it", "a-window-is-an-adapter-not-noise", "a-native-twin-is-unproven-not-proven", "the-warm-door-is-never-the-cold-one", "one-name-in-two-units-cannot-be-told-apart-by-name");

        // --- bytes ---------------------------------------------------------------
        def twc-ws?(b) = (Comparable) b == 32 ? 1 : (Comparable) b == 9 ? 1 : (Comparable) b == 10 ? 1 : (Comparable) b == 13 ? 1 : 0;
        def twc-lstrip(s, i) = i >= str_len(s) ? i : (Comparable) twc-ws?(str_byte_at(s, i)) == 1 ? twc-lstrip(s, i + 1) : i;
        def twc-rstrip(s, e) = e <= 0 ? 0 : (Comparable) twc-ws?(str_byte_at(s, e - 1)) == 1 ? twc-rstrip(s, e - 1) : e;
        def twc-trim(s) = twc-trim-at(s, twc-lstrip(s, 0));
        def twc-trim-at(s, i) = substring(s, i, twc-rstrip(s, str_len(s)));
        def twc-ends-byte?(s, ch) = (Comparable) str_len(s) == 0 ? 0 : (Comparable) str_byte_at(s, str_len(s) - 1) == ch ? 1 : 0;
        def twc-starts-byte?(s, ch) = (Comparable) str_len(s) == 0 ? 0 : (Comparable) str_byte_at(s, 0) == ch ? 1 : 0;
        def twc-cut-tail(s, ch) = (Comparable) twc-ends-byte?(s, ch) == 1 ? twc-trim(substring(s, 0, str_len(s) - 1)) : s;
        def twc-cut-head(s, ch) = (Comparable) twc-starts-byte?(s, ch) == 1 ? twc-trim(substring(s, 1, str_len(s))) : s;
        // max2 and min2 are core's, reached by name. This cell first carried its own
        // twc-max and twc-min, byte for byte core's bodies under a private prefix — and
        // then it was run over its own source beside core.fk and named them. A lens for
        // cold twins that keeps two is not a lens, so they were routed rather than
        // written up.

        // --- the lane a file is authored in ---------------------------------------
        // a .bml body ends at its `;` and opens after its `=`; a Form body carries the
        // defn's own closing paren. Cutting those is what lets two doors in one lane be
        // compared as bodies; across lanes the syntax itself differs, and the lens says
        // so by simply not matching them
        def twc-lane(path) = (Comparable) bcs-ends-with?(path, ".bml") == 1 ? "bml" : "form";
        def twc-lane-strip(lane, s) = (String) lane == "bml" ? twc-cut-head(twc-cut-tail(s, 59), 61) : twc-cut-tail(s, 41);

        // --- opening a door: its name, its parameters, where its body starts --------
        def twc-name-at(line) = twc-name-at-i(line, bcs-skip-spaces(line, 0));
        def twc-name-at-i(line, i) = (Comparable) bcs-starts-with?(line, i, "def ") == 1 ? (i + 4) : (Comparable) bcs-starts-with?(line, i, "(defn ") == 1 ? (i + 6) : TWCNoReading();
        def twc-params-in(s, i, end, acc) = i >= end ? reverse(acc) : twc-params-tok(s, i, end, acc, bcs-name-end(s, i));
        def twc-params-tok(s, i, end, acc, j) = j > i ? twc-params-in(s, j, end, cons(substring(s, i, j), acc)) : twc-params-in(s, i + 1, end, acc);

        // a body ends where the next door opens — or where the block itself does. In BML
        // a class's fields and its closing brace follow the last def in the class; without
        // this the last door of every class would swallow the next class's furniture
        def twc-closes?(line) = twc-closes-at(line, bcs-skip-spaces(line, 0));
        def twc-closes-at(line, i) = (Comparable) bcs-starts-with?(line, i, "}") == 1 ? 1 : (Comparable) bcs-starts-with?(line, i, "class ") == 1 ? 1 : (Comparable) bcs-starts-with?(line, i, "field ") == 1 ? 1 : (Comparable) bcs-starts-with?(line, i, "ref ") == 1 ? 1 : (Comparable) bcs-starts-with?(line, i, "thought ") == 1 ? 1 : (Comparable) bcs-starts-with?(line, i, "section ") == 1 ? 1 : 0;
        def twc-stop?(line) = (Comparable) bcs-opens-def?(line) == 1 ? 1 : twc-closes?(line);
        def twc-raw-go(rest, left, acc) = (left <= 0) || ((Comparable) len(rest) == 0) ? acc : twc-raw-at(rest, left, acc, bcs-strip-comment(head(rest)));
        def twc-raw-at(rest, left, acc, line) = (Comparable) twc-stop?(line) == 1 ? acc : twc-raw-go(tail(rest), left - 1, acc ++ " " ++ line);
        def twc-raw(rest, line, from) = twc-raw-go(tail(rest), TWCBodyLines(), substring(line, from, str_len(line)));

        // --- the normal form: @s for the door itself, @0 @1 for its parameters -------
        // two doors that differ only in what they called their own arguments are one door
        // written twice, and a comparison that cannot see that would miss every real twin
        // this body actually carries
        def twc-index-of(params, tok, i) = (Comparable) len(params) == 0 ? TWCNoReading() : (String) head(params) == tok ? i : twc-index-of(tail(params), tok, i + 1);
        def twc-map-arg(tok, k) = k < 0 ? tok : "@" ++ int_to_str(k);
        def twc-map-tok(nm, params, tok) = (String) tok == nm ? "@s" : twc-map-arg(tok, twc-index-of(params, tok, 0));
        def twc-norm-sp(acc) = (Comparable) str_len(acc) == 0 ? acc : (Comparable) str_byte_at(acc, str_len(acc) - 1) == 32 ? acc : acc ++ " ";
        def twc-norm-tok(nm, params, s, i, acc, j) = twc-norm-go(nm, params, s, j, acc ++ twc-map-tok(nm, params, substring(s, i, j)));
        def twc-norm-at(nm, params, s, i, acc, b) = (Comparable) bcs-name-byte?(b) == 1 ? twc-norm-tok(nm, params, s, i, acc, bcs-name-end(s, i)) : (Comparable) twc-ws?(b) == 1 ? twc-norm-go(nm, params, s, twc-lstrip(s, i), twc-norm-sp(acc)) : twc-norm-go(nm, params, s, i + 1, acc ++ byte_to_str(b));
        def twc-norm-go(nm, params, s, i, acc) = i >= str_len(s) ? acc : twc-norm-at(nm, params, s, i, acc, str_byte_at(s, i));
        def twc-normal(nm, params, s) = twc-trim(twc-norm-go(nm, params, s, 0, ""));

        // --- a door cell: list(unit, name, normal body) -----------------------------
        def twc-door(unit, nm, body) = list(unit, nm, body);
        def twc-d-unit(d) = (Comparable) len(d) == 0 ? "" : d[0];
        def twc-d-name(d) = (Comparable) len(d) == 0 ? "" : d[1];
        def twc-d-body(d) = (Comparable) len(d) == 0 ? "" : d[2];
        // two keys, because a near twin parts in ONE window and therefore still matches
        // at one END. Keying only on the head loses the pair that parts in its first
        // bytes — `reverse-acc-loop` opens `(if (eq (len @0) 0)` where `reverse-onto`
        // opens `(if (nil? @0)`, and they are otherwise one body
        def twc-d-key(d) = substring(twc-d-body(d), 0, TWCBucketBytes());
        def twc-d-tail-key(d) = substring(twc-d-body(d), str_len(twc-d-body(d)) - TWCBucketBytes(), str_len(twc-d-body(d)));
        def twc-same-door?(a, b) = ((String) twc-d-unit(a) == twc-d-unit(b)) && ((String) twc-d-name(a) == twc-d-name(b)) ? 1 : 0;
        def twc-where(d) = twc-d-unit(d) ++ " " ++ twc-d-name(d);

        // --- reading a unit's doors -------------------------------------------------
        def twc-doors-cell(unit, lane, rest, acc, nm, params, raw) = twc-doors-in(unit, lane, tail(rest), cons(twc-door(unit, nm, twc-normal(nm, params, twc-lane-strip(lane, twc-trim(raw)))), acc));
        def twc-doors-body(unit, lane, rest, acc, line, nm, pstart, close) = close < 0 ? twc-doors-in(unit, lane, tail(rest), acc) : twc-doors-cell(unit, lane, rest, acc, nm, twc-params-in(line, pstart, close, list()), twc-raw(rest, line, close + 1));
        def twc-doors-close(unit, lane, rest, acc, line, nm, open) = open < 0 ? twc-doors-in(unit, lane, tail(rest), acc) : twc-doors-body(unit, lane, rest, acc, line, nm, open + 1, str_find(line, ")", open));
        def twc-doors-arg(unit, lane, rest, acc, line, nm) = twc-doors-close(unit, lane, rest, acc, line, nm, str_find(line, "(", bcs-name-end(line, twc-name-at(line))));
        def twc-doors-open(unit, lane, rest, acc, line) = twc-doors-name(unit, lane, rest, acc, line, bcs-def-name(line));
        def twc-doors-name(unit, lane, rest, acc, line, nm) = (Comparable) str_len(nm) == 0 ? twc-doors-in(unit, lane, tail(rest), acc) : twc-doors-arg(unit, lane, rest, acc, line, nm);
        def twc-doors-at(unit, lane, rest, acc, line) = (Comparable) bcs-opens-def?(line) == 0 ? twc-doors-in(unit, lane, tail(rest), acc) : twc-doors-open(unit, lane, rest, acc, line);
        def twc-doors-in(unit, lane, rest, acc) = (Comparable) len(rest) == 0 ? acc : twc-doors-at(unit, lane, rest, acc, bcs-strip-comment(head(rest)));
        // the floor is a policy and is named as one. `(nth @0 1)` is ten bytes, and two
        // accessors reading field one of two DIFFERENT records share those bytes without
        // sharing a meaning — a coincidence, not a copy. Bytes are the information in a
        // body, so a floor on them is the honest filter; TWCMinBody keeps `(eq (len @0) 0)`,
        // which is `nil?`, and drops the one-field readers
        def twc-keep(doors, acc) = (Comparable) len(doors) == 0 ? acc : twc-keep(tail(doors), str_len(twc-d-body(head(doors))) < TWCMinBody() ? acc : cons(head(doors), acc));
        def twc-doors-of(path) = twc-keep(twc-doors-in(path, twc-lane(path), bcs-read-lines(path), list()), list());
        def twc-doors(paths) = (Comparable) len(paths) == 0 ? list() : append(twc-doors-of(head(paths)), twc-doors(tail(paths)));

        // --- where two bodies part ----------------------------------------------------
        def twc-pre(a, b, i) = (i >= str_len(a)) || (i >= str_len(b)) ? i : (Comparable) str_byte_at(a, i) == str_byte_at(b, i) ? twc-pre(a, b, i + 1) : i;
        def twc-suf(a, b, k, cap) = k >= cap ? k : (Comparable) str_byte_at(a, str_len(a) - (k + 1)) == str_byte_at(b, str_len(b) - (k + 1)) ? twc-suf(a, b, k + 1, cap) : k;
        def twc-sim-bp(p, s, la, lb) = max2(la, lb) <= 0 ? 0 : (((p + s) * TWCScale()) / max2(la, lb));
        // list(kind, at, sim, window-a, window-b)
        def twc-p-kind(v) = v[0];
        def twc-p-at(v) = v[1];
        def twc-p-sim(v) = v[2];
        def twc-p-win-a(v) = v[3];
        def twc-p-win-b(v) = v[4];
        def twc-no-pair() = list("", 0, 0, "", "");
        def twc-part-say(p, sim, wa, wb) = (sim >= TWCSimBp()) && ((str_len(wa) <= TWCWindowCap()) && (str_len(wb) <= TWCWindowCap())) ? list("differs-at", p, sim, wa, wb) : twc-no-pair();
        def twc-part-suf(a, b, p, s) = twc-part-say(p, twc-sim-bp(p, s, str_len(a), str_len(b)), substring(a, p, str_len(a) - s), substring(b, p, str_len(b) - s));
        def twc-part-at(a, b, p) = twc-part-suf(a, b, p, twc-suf(a, b, 0, min2(str_len(a), str_len(b)) - p));
        def twc-part(a, b) = (String) a == b ? list("looks-identical", str_len(a), TWCScale(), "", "") : twc-part-at(a, b, twc-pre(a, b, 0));
        // exact twins are found by whole-body equality whatever they start with; a near
        // twin has to match at one end — head bucket or tail bucket. A pair that parts
        // at BOTH ends is not one window and is not offered, which is the lens's own
        // named blind edge
        def twc-verdict(a, b) = (String) twc-d-body(a) == twc-d-body(b) ? twc-part(twc-d-body(a), twc-d-body(b)) : ((String) twc-d-key(a) == twc-d-key(b)) || ((String) twc-d-tail-key(a) == twc-d-tail-key(b)) ? twc-part(twc-d-body(a), twc-d-body(b)) : twc-no-pair();

        // --- the heat overlay ----------------------------------------------------------
        // crystal is field 7 of a hot row: >0 the JIT took this defn, 0 it is still walking,
        // <0 it was refused. Warm is >= 1. An unmeasured door is no-reading and NOT cold —
        // the same honesty the bearing census keeps, for the same reason
        def twc-measured?(rows, nm) = bcs-measured?(rows, nm);
        def twc-crystal(rows, nm) = (Comparable) bcs-measured?(rows, nm) == 0 ? TWCNoReading() : bcs-crystal(bcs-row-of(rows, nm));
        def twc-calls(rows, nm) = (Comparable) bcs-measured?(rows, nm) == 0 ? TWCNoReading() : bcs-heat(bcs-row-of(rows, nm));
        def twc-warm?(rows, nm) = (Comparable) bcs-measured?(rows, nm) == 0 ? 0 : bcs-crystal(bcs-row-of(rows, nm)) >= 1 ? 1 : 0;
        // the warm door is never offered as the cold one: when exactly one side carries
        // crystal, the OTHER is the cold one whatever order the pair was found in
        def twc-order-at(a, b, wa, wb) = (String) twc-d-name(a) == twc-d-name(b) ? list(a, b, "heat-ambiguous") : ((Comparable) wa == 1) && ((Comparable) wb == 1) ? list(a, b, "both-warm") : (Comparable) wb == 1 ? list(a, b, "cold-and-warm") : (Comparable) wa == 1 ? list(b, a, "cold-and-warm") : list(a, b, "no-warm-side");
        def twc-order(rows, a, b) = twc-order-at(a, b, twc-warm?(rows, twc-d-name(a)), twc-warm?(rows, twc-d-name(b)));

        // --- what it costs to close a pair ------------------------------------------
        // the doors that would have to reach the warm one instead. A mention is
        // boundary-checked and comments are already cut, so a door named in prose is not
        // a call site
        def twc-sites(doors, nm, cold, acc) = (Comparable) len(doors) == 0 ? acc : twc-sites(tail(doors), nm, cold, ((Comparable) twc-same-door?(head(doors), cold) == 0) && ((Comparable) bcs-mentions?(twc-d-body(head(doors)), nm) == 1) ? (acc + 1) : acc);

        // --- a pair cell ---------------------------------------------------------------
        // list(coldUnit coldName warmUnit warmName kind sim winCold winWarm
        //      coldCrystal coldMeasured coldCalls warmCrystal warmMeasured warmCalls
        //      sites chill role heat bytes)
        def twc-cell-of(rows, doors, cold, warm, kind, sim, wc, ww, role, heat) = twc-cell-with(rows, cold, warm, kind, sim, wc, ww, role, heat, twc-calls(rows, twc-d-name(cold)), twc-sites(doors, twc-d-name(cold), cold, 0));
        def twc-cell-with(rows, cold, warm, kind, sim, wc, ww, role, heat, calls, sites) = list(twc-d-unit(cold), twc-d-name(cold), twc-d-unit(warm), twc-d-name(warm), kind, sim, wc, ww, twc-crystal(rows, twc-d-name(cold)), twc-measured?(rows, twc-d-name(cold)), calls, twc-crystal(rows, twc-d-name(warm)), twc-measured?(rows, twc-d-name(warm)), twc-calls(rows, twc-d-name(warm)), sites, max2(calls, 0), role, heat, str_len(twc-d-body(cold)));
        def twc-c-cold-unit(c) = (Comparable) len(c) == 0 ? "" : c[0];
        def twc-c-cold(c) = (Comparable) len(c) == 0 ? "" : c[1];
        def twc-c-warm-unit(c) = (Comparable) len(c) == 0 ? "" : c[2];
        def twc-c-warm(c) = (Comparable) len(c) == 0 ? "" : c[3];
        def twc-c-kind(c) = (Comparable) len(c) == 0 ? "no-pair" : c[4];
        def twc-c-sim(c) = (Comparable) len(c) == 0 ? TWCNoReading() : c[5];
        def twc-c-win-cold(c) = (Comparable) len(c) == 0 ? "" : c[6];
        def twc-c-win-warm(c) = (Comparable) len(c) == 0 ? "" : c[7];
        def twc-c-cold-crystal(c) = (Comparable) len(c) == 0 ? TWCNoReading() : c[8];
        def twc-c-cold-measured(c) = (Comparable) len(c) == 0 ? 0 : c[9];
        def twc-c-cold-calls(c) = (Comparable) len(c) == 0 ? TWCNoReading() : c[10];
        def twc-c-warm-crystal(c) = (Comparable) len(c) == 0 ? TWCNoReading() : c[11];
        def twc-c-warm-measured(c) = (Comparable) len(c) == 0 ? 0 : c[12];
        def twc-c-warm-calls(c) = (Comparable) len(c) == 0 ? TWCNoReading() : c[13];
        def twc-c-sites(c) = (Comparable) len(c) == 0 ? TWCNoReading() : c[14];
        def twc-c-chill(c) = (Comparable) len(c) == 0 ? 0 : c[15];
        def twc-c-role(c) = (Comparable) len(c) == 0 ? "no-pair" : c[16];
        def twc-c-heat(c) = (Comparable) len(c) == 0 ? "no-reading" : c[17];
        def twc-c-bytes(c) = (Comparable) len(c) == 0 ? 0 : c[18];

        // --- the body lane: pairs found by comparing bodies ----------------------------
        // the windows travel with the cold door on the left, so a reader sees what the cold
        // side says where the warm side says something else — which is the adapter to write.
        // The verdict was computed over (a, b) and the ordering may have swapped them, so
        // which window belongs to the cold side is asked, never assumed
        def twc-body-cell(rows, doors, a, b, v) = twc-body-ordered(rows, doors, a, v, twc-order(rows, a, b));
        def twc-body-ordered(rows, doors, a, v, o) = twc-body-role(rows, doors, v, o[0], o[1], o[2], twc-same-door?(o[0], a));
        def twc-body-role(rows, doors, v, cold, warm, heat, coldIsA) = twc-cell-of(rows, doors, cold, warm, twc-p-kind(v), twc-p-sim(v), (Comparable) coldIsA == 1 ? twc-p-win-a(v) : twc-p-win-b(v), (Comparable) coldIsA == 1 ? twc-p-win-b(v) : twc-p-win-a(v), (String) twc-d-name(cold) == twc-d-name(warm) ? "shadow" : "twin", heat);
        def twc-pairs-one(rows, doors, d, rest, acc, v) = twc-pairs-with(rows, doors, d, tail(rest), (Comparable) str_len(twc-p-kind(v)) == 0 ? acc : cons(twc-body-cell(rows, doors, d, head(rest), v), acc));
        def twc-pairs-with(rows, doors, d, rest, acc) = (Comparable) len(rest) == 0 ? acc : twc-pairs-one(rows, doors, d, rest, acc, twc-verdict(d, head(rest)));
        def twc-pairs-go(rows, doors, rest, acc) = (Comparable) len(rest) == 0 ? acc : twc-pairs-go(rows, doors, tail(rest), twc-pairs-with(rows, doors, head(rest), tail(rest), acc));
        def twc-body-pairs(rows, doors) = twc-pairs-go(rows, doors, doors, list());

        // --- the native lane: a door whose stem names a native ---------------------------
        // no body exists to compare against, so this is `unproven` and stays unproven. The
        // census's own stem match is reused rather than rewritten — a lens for private
        // copies has no business keeping one
        // and the strongest shadow of all: a door whose OWN name is in the op table. The
        // bearing census calls that kind `shadowed` and asks for routing rather than for
        // minting; here it is a pair like any other, cold recipe against warm seed arm,
        // and still unproven, because a native has no body either way
        def twc-native-door(nm) = twc-door("runtime/fkwu-optable.h", nm, "");
        def twc-native-cell(rows, doors, d, tw) = twc-cell-of(rows, doors, d, twc-native-door(tw), "unproven", TWCNoReading(), "", "", "native", "warm-by-construction");
        def twc-native-name(natives, nm) = (Comparable) bcs-native?(natives, nm) == 1 ? nm : bcs-twin(natives, nm);
        def twc-native-at(rows, doors, rest, natives, acc, tw) = twc-native-go(rows, doors, tail(rest), natives, (Comparable) str_len(tw) == 0 ? acc : cons(twc-native-cell(rows, doors, head(rest), tw), acc));
        def twc-native-go(rows, doors, rest, natives, acc) = (Comparable) len(rest) == 0 ? acc : twc-native-at(rows, doors, rest, natives, acc, twc-native-name(natives, twc-d-name(head(rest))));
        def twc-native-pairs(rows, doors, natives) = twc-native-go(rows, doors, doors, natives, list());

        // --- the whole reading ------------------------------------------------------------
        def twc-insert(c, sorted) = (Comparable) len(sorted) == 0 ? list(c) : (Comparable) twc-before?(c, head(sorted)) == 1 ? cons(c, sorted) : cons(head(sorted), twc-insert(c, tail(sorted)));
        // heat leads, because a measured cold door is a measured cost. Under a body nothing
        // has driven yet — the morning case this lens exists for — the duplicated BODY's
        // size leads instead: a fifty-byte coincidence is a copy where a ten-byte one is an
        // accident, and only then does the reroute cost break the tie
        def twc-before?(c, o) = twc-c-chill(c) > twc-c-chill(o) ? 1 : twc-c-chill(c) < twc-c-chill(o) ? 0 : twc-c-bytes(c) > twc-c-bytes(o) ? 1 : twc-c-bytes(c) < twc-c-bytes(o) ? 0 : twc-c-sites(c) > twc-c-sites(o) ? 1 : 0;
        def twc-sort(pairs) = (Comparable) len(pairs) == 0 ? list() : twc-insert(head(pairs), twc-sort(tail(pairs)));
        def twc-census(rows, doors, natives) = twc-sort(append(twc-body-pairs(rows, doors), twc-native-pairs(rows, doors, natives)));
        // a take-n door stood here and was byte-identical to bcs-take, which this cell
        // already preludes. Nothing called it. It is gone rather than routed: the cheapest
        // reroute is the one where the cold door had no callers at all

        // the standing name, and WHY it stands, because the three reasons are not one
        // claim. A pair whose warm side actually crystallized leads: its heal is already
        // measured. Next comes a pair whose two bodies are simply one body — a duplicate
        // stands whether or not anything has driven it, and naming it before it is driven
        // is the entire point of asking the source instead of the heat. Only last, and
        // said as such, comes the nearest pair, which merely PARTS somewhere
        def twc-first-heat(pairs, heat) = (Comparable) len(pairs) == 0 ? list() : (String) twc-c-heat(head(pairs)) == heat ? head(pairs) : twc-first-heat(tail(pairs), heat);
        def twc-first-kind(pairs, kind) = (Comparable) len(pairs) == 0 ? list() : (String) twc-c-kind(head(pairs)) == kind ? head(pairs) : twc-first-kind(tail(pairs), kind);
        def twc-standing-head(pairs) = (Comparable) len(pairs) == 0 ? list() : head(pairs);
        def twc-standing(pairs) = twc-standing-of(twc-first-heat(pairs, "cold-and-warm"), twc-first-kind(pairs, "looks-identical"), pairs);
        def twc-standing-of(cold, same, pairs) = len(cold) > 0 ? cold : len(same) > 0 ? same : twc-standing-head(pairs);
        def twc-standing-why(pairs) = len(twc-first-heat(pairs, "cold-and-warm")) > 0 ? "a cold side measured against a crystallized one" : len(twc-first-kind(pairs, "looks-identical")) > 0 ? "one body standing under two doors; no crystallized side was measured" : (Comparable) len(pairs) == 0 ? "no pair found in the units given" : "the nearest pair only — it PARTS, so it is not a twin";
        def twc-standing-name(pairs) = twc-standing-name-of(twc-standing(pairs));
        def twc-standing-name-of(c) = (Comparable) len(c) == 0 ? "no-twin-found" : twc-c-cold(c);
        def twc-count-heat(pairs, heat, acc) = (Comparable) len(pairs) == 0 ? acc : twc-count-heat(tail(pairs), heat, (String) twc-c-heat(head(pairs)) == heat ? (acc + 1) : acc);
        def twc-count-kind(pairs, kind, acc) = (Comparable) len(pairs) == 0 ? acc : twc-count-kind(tail(pairs), kind, (String) twc-c-kind(head(pairs)) == kind ? (acc + 1) : acc);
        def twc-of(pairs, cold, warm) = (Comparable) len(pairs) == 0 ? list() : ((String) twc-c-cold(head(pairs)) == cold) && ((String) twc-c-warm(head(pairs)) == warm) ? head(pairs) : twc-of(tail(pairs), cold, warm);

        // --- saying it ---------------------------------------------------------------------
        // a number that says no-reading below zero is bcs-num, already preluded here. This cell
        // carried its own until its own census named the two as one body.
        def twc-crystal-text(crystal, measured) = (Comparable) measured == 0 ? "no-reading" : int_to_str(crystal);
        // the crystal flag's states are not one thing, and the difference decides whether a
        // reroute is safe. 1 and 2 are EARNED: the JIT compiled that door's own body. 3 is
        // GRANTED: the seed's recipe-twin table binds a handful of names, at a fixed arity,
        // in a handful of named units, and hands the walker a twin where it already reads a
        // tag. So a warm side at 3 is warm because the seed knows its NAME — rename it, or
        // move it to another file, and it goes cold with nothing else changed. The table
        // itself is not copied here on purpose: a lens for private copies keeping a private
        // copy of the seed's own list would be the wound it exists to name. Read it in
        // runtime/fkwu-uni.c at fk_twin_id_of
        def twc-crystal-word(crystal, measured) = (Comparable) measured == 0 ? "no-reading" : (Comparable) crystal == 3 ? "seed-twinned by name" : crystal > 0 ? "jit-compiled from its own body" : crystal < 0 ? "refused" : "held, still walking";
        def twc-window-text(c) = (String) twc-c-kind(c) == "differs-at" ? bcs-cat(list(" — ", bcs-pct(twc-c-sim(c)), " alike, parting where it says `", twc-c-win-cold(c), "` and the warm one says `", twc-c-win-warm(c), "`")) : "";
        def twc-c-text(c) = bcs-cat(list("chill ", int_to_str(twc-c-chill(c)), "  ", twc-c-cold(c), " (", twc-c-cold-unit(c), ") ", twc-c-kind(c), " ", twc-c-warm(c), " (", twc-c-warm-unit(c), ")  crystal ", twc-crystal-text(twc-c-cold-crystal(c), twc-c-cold-measured(c)), " against ", twc-crystal-text(twc-c-warm-crystal(c), twc-c-warm-measured(c)), ", ", bcs-num(twc-c-cold-calls(c)), " calls cold, ", int_to_str(twc-c-bytes(c)), " body bytes, ", int_to_str(twc-c-sites(c)), " doors to reroute, ", twc-c-heat(c), twc-window-text(c)));
        def twc-warmth(c) = bcs-cat(list(twc-c-warm(c), " is ", twc-crystal-word(twc-c-warm-crystal(c), twc-c-warm-measured(c)), "; ", twc-c-cold(c), " is ", twc-crystal-word(twc-c-cold-crystal(c), twc-c-cold-measured(c))));
        def twc-remedy(c) = (String) twc-c-kind(c) == "unproven" ? "hold the two meanings side by side in a band before routing to " ++ twc-c-warm(c) : (String) twc-c-role(c) == "shadow" ? "one of two identical bodies under one name is dead weight; delete the private one" : (String) twc-c-kind(c) == "differs-at" ? "route to " ++ twc-c-warm(c) ++ ", with the parting window as the adapter" : "route to " ++ twc-c-warm(c);
    }
    0;
}
