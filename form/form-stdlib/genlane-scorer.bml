//////////////////////////////////////////////////////////////////////
//
// genlane-scorer.bml
//
// Executable BML. Authority: form-stdlib/bml/genlane-parity.bml
//
// The parity pulse's pure scorer: an answer is the text after the
// "text:" marker, and a hit lands only inside that answer. A telemetry
// field name is never an answer — on the first live verdict
// (2026-08-30) "othing" matched heed_nothings=0 and lit a bit the
// answer had not earned. A missing marker scores as an empty answer,
// never as the whole span.
//
// Living mirror: observe/genlane-parity-pulse-scorer.fk
// Proven by: form-stdlib/tests/genlane-pulse-scorer-band.fk
// witnessed: 2026-08-30 -> 511
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGenlaneParityAuthority {
        field GenlaneAuthorityPath = "form/form-stdlib/bml/genlane-parity.bml";
        field GenlaneAuthorityKind = "high-bml-class-template-field";
    }

    class FormGenlaneScorer {
        field Marker = "text:";
        field BitZeroFamily = 1;
        field BitFormGeneration = 2;
        field BitKnownFamily = 4;

        ref gls-authority = FormGenlaneParityAuthority;
        thought gls-law = list("answer-text-only", "missing-marker-empty", "budget-closes-envelope", "start-before-admission", "falling-verdict-vitality");

        def glp-answer(reply) {
            let at = str_find(reply, Marker(), 0);
            if lt(at, 0) then "" else substring(reply, add(at, str_len(Marker())), str_len(reply));
        }
        def glp-hit?(reply, needle) = if ge(str_find(glp-answer(reply), needle, 0), 0) then 1 else 0;
    }
    0;
}
