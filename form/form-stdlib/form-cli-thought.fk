; form-cli-thought.fk — form-cli reaches the resonance stream as a thought.
;
; Verbs (numeric in, numeric or name out):
;   thought phase <deg> <churn>     -> ice / water / gas / plasma
;   thought ask <id>                -> neighborhood size of a now-rooted claim
;   thought step add <a> <b>        -> evaluate a recipe token
;   thought love <n>                -> draw; the source is unchanged
;
; Direct-source Form does not read argv. The live door calls these.
; Standing door: ./fkwu form/form-stdlib/form-cli-thought-run.fk
; form-cli.fk thought route was attempted; that chain carries a standing
; native_blueprint lane seam on fkwu. This organ does not wait on it.
;
; preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk

(do
    (defn fct-phase-name (p)
        (if (eq p (srs-ice)) "ice"
            (if (eq p (srs-water)) "water"
                (if (eq p (srs-gas)) "gas"
                    (if (eq p (srs-plasma)) "plasma" "unknown")))))

    (defn fct-thought-phase (deg churn)
        (fct-phase-name (srs-phase deg churn 5 2 1 8)))

    (defn fct-thought-ask (id)
        (len (srs-ask (srs-demo) id)))

    (defn fct-thought-step (op a b)
        (srs-step (srs-token (srs-tok-recipe) op) a b))

    (defn fct-thought-love (n)
        (srs-draw-love n))

    (defn fct-thought-source ()
        (srs-source-after-draw))

    ; String verb, numeric args. The form-cli dispatcher splits, then calls here.
    (defn fct-respond (verb a b c)
        (if (str_eq verb "phase") (fct-thought-phase a b)
            (if (str_eq verb "ask") (int_to_str (fct-thought-ask a))
                (if (str_eq verb "step") (int_to_str (fct-thought-step (srs-op-add) a b))
                    (if (str_eq verb "love") (int_to_str (fct-thought-love a))
                        "usage: thought phase|ask|step|love")))))

    0)
