// form-cli-thought.fk — form-cli reaches the resonance stream as a thought.
//
// Verbs (numeric in, numeric or name out):
//   thought phase <deg> <churn>     -> ice / water / gas / plasma
//   thought ask <id>                -> neighborhood size of a now-rooted claim
//   thought step add <a> <b>        -> evaluate a recipe token
//   thought love <n>                -> draw; the source is unchanged
//
// Direct-source Form does not read argv. The live door calls these.
// This organ is the thought door on its own; it does not wait on the
// form-cli.fk dispatch chain.
//
// preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk
section [form.bml] {
    def fct-phase-name(p) = (Comparable) p == srs-ice() ? "ice" : (Comparable) p == srs-water() ? "water" : (Comparable) p == srs-gas() ? "gas" : (Comparable) p == srs-plasma() ? "plasma" : "unknown";
    def fct-thought-phase(deg, churn) = fct-phase-name(srs-phase(deg, churn, 5, 2, 1, 8));
    def fct-thought-ask(id) = len(srs-ask(srs-demo(), id));
    def fct-thought-step(op, a, b) = srs-step(srs-token(srs-tok-recipe(), op), a, b);
    def fct-thought-love(n) = srs-draw-love(n);
    def fct-thought-source() = srs-source-after-draw();
    // String verb, numeric args. The form-cli dispatcher splits, then calls here.
    def fct-respond(verb, a, b, c) = (String) verb == "phase" ? fct-thought-phase(a, b) : (String) verb == "ask" ? int_to_str(fct-thought-ask(a)) : (String) verb == "step" ? int_to_str(fct-thought-step(srs-op-add(), a, b)) : (String) verb == "love" ? int_to_str(fct-thought-love(a)) : "usage: thought phase|ask|step|love";
    0;
}
