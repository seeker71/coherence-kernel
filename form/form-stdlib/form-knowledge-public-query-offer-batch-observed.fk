; form-knowledge-public-query-offer-batch-observed.fk -- first physical surface.
;
; This is a compact, public, answer-free summary of the physical 15-family
; supervised-RAG batch observed on 2026-08-25.  It retains the immutable plan,
; run and residence identities plus every raw-output digest and family outcome.
; It is not the raw fkpqo result and cannot replace that result's recomputable
; source/frame evidence.  It is the durable comparison point for refine/undo.
;
; Canonical-heldout credit is exactly zero.  A transport miss is not an answer
; miss: grammars is kept as the former; four other families are kept as the
; latter.  `ready=0` therefore remains informative rather than being repaired
; in the record.
;
; preludes: form-stdlib/form-knowledge-public-query-offer-batch.fk
; Proven by: form-stdlib/tests/form-knowledge-public-query-offer-batch-observed-band.fk

(do
    (defn fkpqoo-schema () "public-query-offer-batch-observed-summary-v1")
    (defn fkpqoo-row-schema () "public-query-offer-family-observed-v1")
    (defn fkpqoo-plan-sha ()
        "439e49a1ed6c5980618f998f77229a5f25ba0d74f1030e3018ebc13a887486cb")
    (defn fkpqoo-run-id ()
        "ec4ef867cd9048cab9990a73ad60ab6c451e154f9dbb8234521362f26a183e41")
    (defn fkpqoo-residence-id ()
        "e584d16c76aa516130bbab35a4fc04c505655bac46f0b4309fd40256fcb45e95")

    (defn fkpqoo-row (family raw-sha transport answer95)
        (list (fkpqoo-row-schema) family raw-sha transport answer95))
    (defn fkpqoo-family (row) (nth row 1))
    (defn fkpqoo-raw-sha (row) (nth row 2))
    (defn fkpqoo-transport (row) (nth row 3))
    (defn fkpqoo-answer95 (row) (nth row 4))

    (defn fkpqoo-rows ()
        (list
            (fkpqoo-row "receipts" "2c980c59337fc70120233e4d839ed634e2e41f291a2f74ab2ba54c7daf22870f" 1 1)
            (fkpqoo-row "learn" "567e9ab7bd300d2b5c798c67551cb10f794e594b2a8e15527121da1b033388e8" 1 1)
            (fkpqoo-row "teachings" "3cd10351ab122a6766cbeab9b5a539f9f8dcf96821399605f3369f7873299924" 1 0)
            (fkpqoo-row "presence" "bccf445891ca7291dd24fff5366bda021fa50aba83b0e39febdee99314fe0de3" 1 1)
            (fkpqoo-row "grammars" "b44d2491aa8a6d24aee634543438a80091b08935de37e904eae4516798dbf217" 0 0)
            (fkpqoo-row "proof" "7ab7445d8dbe1795b0bb70a76bc3d1fc513e97fa74bb1e59f208107f0127a69e" 1 1)
            (fkpqoo-row "docs" "32231e5a0b2d23d03163d74439209627ed8ce4ccb9b6414371fd542cedc95858" 1 1)
            (fkpqoo-row "model" "fa414daefcada4641fd69cc24ccb51201cead6d9bac801948d92bc5c3011458d" 1 1)
            (fkpqoo-row "form-stdlib" "f8a36c5b4c0ad9cd83de47a1f7977f51a1a5159713c105d2770c01b1efe75114" 1 0)
            (fkpqoo-row "observe" "c3f4d47ef9691dbf808e909bea3e4061d8652f79aef4243146f1d88a53d8a8e0" 1 1)
            (fkpqoo-row "ingest" "4364bd54540e64d250312949c358ccebd91c5e66f0d80a7f6b1307b10ed39478" 1 0)
            (fkpqoo-row "axioms" "ee92f3bc7240bf837cb95275d20d713165de566d29e144848936c0ddfe440068" 1 1)
            (fkpqoo-row "control" "1db2a6672a4daf0a919f1912b58af78756930e7fdcd75a0a981d6af3727289e4" 1 1)
            (fkpqoo-row "bootstrap" "176153f3377521bbe5393d34a4b5828e84ad3c215d06d29e36070712a2569c45" 1 1)
            (fkpqoo-row "cognition" "a578a8208520bdd6f88a718242b75a655162daa889adf52c76e2cd1d004566ba" 1 0)))

    (defn fkpqoo-bit? (value) (if (or (eq value 0) (eq value 1)) 1 0))
    (defn fkpqoo-family-in? (family families)
        (if (eq (len families) 0) 0
            (if (str_eq family (head families)) 1
                (fkpqoo-family-in? family (tail families)))))
    (defn fkpqoo-row-valid? (row)
        (if (or (not (eq (len row) 5))
                (not (str_eq (nth row 0) (fkpqoo-row-schema)))) 0
            (if (and (eq (fkpqoo-family-in? (fkpqoo-family row)
                              (fkpfm-family-ids)) 1)
                (and (eq (nmfe-sha256? (fkpqoo-raw-sha row)) 1)
                (and (eq (fkpqoo-bit? (fkpqoo-transport row)) 1)
                     (eq (fkpqoo-bit? (fkpqoo-answer95 row)) 1)))) 1 0)))
    (defn fkpqoo-all-valid? (rows)
        (if (eq (len rows) 0) 1
            (if (eq (fkpqoo-row-valid? (head rows)) 1)
                (fkpqoo-all-valid? (tail rows)) 0)))
    (defn fkpqoo-sum-transport (rows)
        (if (eq (len rows) 0) 0
            (add (fkpqoo-transport (head rows))
                 (fkpqoo-sum-transport (tail rows)))))
    (defn fkpqoo-sum-answer95 (rows)
        (if (eq (len rows) 0) 0
            (add (fkpqoo-answer95 (head rows))
                 (fkpqoo-sum-answer95 (tail rows)))))
    (defn fkpqoo-count-family (family rows)
        (if (eq (len rows) 0) 0
            (add (if (str_eq family (fkpqoo-family (head rows))) 1 0)
                 (fkpqoo-count-family family (tail rows)))))
    (defn fkpqoo-every-family-once? (families rows)
        (if (eq (len families) 0) 1
            (if (eq (fkpqoo-count-family (head families) rows) 1)
                (fkpqoo-every-family-once? (tail families) rows) 0)))
    (defn fkpqoo-family-row (family rows)
        (if (eq (len rows) 0) (nothing)
            (if (str_eq family (fkpqoo-family (head rows))) (head rows)
                (fkpqoo-family-row family (tail rows)))))

    ; summary = schema plan run residence rows total structural transport
    ;           answer95 heldout supervised local remote opens reopens release
    ;           complete ready
    (defn fkpqoo-summary ()
        (do
            (let rows (fkpqoo-rows))
            (let total (len rows))
            (let transport (fkpqoo-sum-transport rows))
            (let answer95 (fkpqoo-sum-answer95 rows))
            (let structural (if (and (eq total (fkpqo-family-total))
                (and (eq (fkpqoo-all-valid? rows) 1)
                     (eq (fkpqoo-every-family-once?
                         (fkpfm-family-ids) rows) 1))) 1 0))
            (let complete (if (and (eq structural 1)
                (and (eq total 15) (and (eq 0 0)
                (and (eq 1 1) (and (eq 0 0) (eq 1 1)))))) 1 0))
            (list (fkpqoo-schema) (fkpqoo-plan-sha) (fkpqoo-run-id)
                  (fkpqoo-residence-id) rows total structural transport
                  answer95 0 transport total 0 1 0 1 complete
                  (if (and (eq complete 1) (eq transport total)) 1 0))))

    0)
