; ds4-tensor-table.fk — what the DeepSeek-V4-Flash file says it needs, read by
; this body's own walker.
;
; The sibling cell kat-coder-tensor-table.fk did this for KAT-Coder and found a
; missing decoder. This one asks the same question of the model the 43-layer
; stack already runs, and the answer inverts.
;
; READ 2026-07-28 from
;   ~/models/ds4/ds4flash-v5mx-reap25-type40-mxfp8lt-dspark-v1.gguf
; 91 321 404 640 bytes — the same figure receipts/2026-07-22-first-deepseek-
; token.md records, arrived at here by asking the file rather than by copying
; the receipt. NOTHING BUT THE HEADER WAS READ: an 8 MB window covers the 71 KV
; pairs and all 1406 tensor infos, which begin at byte 5 248 946. No weights
; were touched and nothing was run.
;
; THE CENSUS, derived by egg-* and checked by the band against this record:
;   F32       0   536  — no decode needed
;   F16       1   359  — f16-decode.fk                 COVERED
;   IQ2_XXS  16    93  — iq2xxs-msl.fk                 COVERED
;   I32      26     3  — an index table, not weights   NO DECODE OWED
;   MXFP4    40    45  — mxfp4-msl.fk                  COVERED
;   MXFP8    41   370  — mxfp8-msl.fk                  COVERED
;   1406 total, nothing uncovered.
;
; THE INVERSION, and it is the reason this cell is worth its bytes. KAT-Coder
; is a file every tool can read — llama.cpp runs it, and its quantizations are
; the ordinary Q4_K/Q6_K/Q8_0 — and it needed a decoder this body did not have
; (Q3_K, 94 tensors). DS4 is a file NOTHING else on this machine can read: ds4,
; llama.cpp, ollama and LM Studio all refuse types 40 and 41 outright
; (receipts/2026-07-22-first-deepseek-token.md), and this body decodes every
; one of its 1406 tensors. Being unreadable by the world and being unreadable
; by us are independent properties, and the model that is exotic to everyone
; else is the one that is fully at home here. Which of the two can be REFUTED
; against an external reference runs exactly the other way — that is the trade
; the KAT-Coder work took on deliberately, and this cell is where the two halves
; of it can be seen at once.
;
; The I32 row owes no decoder and the band says so explicitly rather than
; quietly counting it as covered: it is ffn_gate_tid2eid, the hash-routing
; lookup the first three layers select experts through, and an index table is
; read as integers.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/equireach-gguf.fk

(do
    (defn ds4t-path () "/Users/ursmuff/models/ds4/ds4flash-v5mx-reap25-type40-mxfp8lt-dspark-v1.gguf")
    (defn ds4t-window () 8388608)
    (defn ds4t-file-bytes () 91321404640)

    ; ── the record ───────────────────────────────────────────────────────
    (defn ds4t-gguf-version () 3)
    (defn ds4t-tensor-count () 1406)
    (defn ds4t-kv-count () 71)
    (defn ds4t-tensor-infos-at () 5248946)

    ; row = (ggml-type-code count covered? why)
    (defn ds4t-row (code count covered why) (list code count covered why))
    (defn ds4t-row-code (r) (nth r 0))
    (defn ds4t-row-count (r) (nth r 1))
    (defn ds4t-row-covered (r) (nth r 2))
    (defn ds4t-row-why (r) (nth r 3))
    (defn ds4t-census ()
        (list (ds4t-row  0 536 1 "F32 — no decode needed")
              (ds4t-row  1 359 1 "F16 — f16-decode.fk")
              (ds4t-row 16  93 1 "IQ2_XXS — iq2xxs-msl.fk")
              (ds4t-row 26   3 1 "I32 — ffn_gate_tid2eid, an index table; no decoder owed")
              (ds4t-row 40  45 1 "MXFP4 — mxfp4-msl.fk")
              (ds4t-row 41 370 1 "MXFP8 — mxfp8-msl.fk")))

    (defn ds4t-sum-go (rs acc) (if (eq (len rs) 0) acc (ds4t-sum-go (tail rs) (add acc (ds4t-row-count (head rs))))))
    (defn ds4t-total () (ds4t-sum-go (ds4t-census) 0))
    (defn ds4t-uncovered-go (rs acc)
        (if (eq (len rs) 0) acc
            (ds4t-uncovered-go (tail rs)
                (if (eq (ds4t-row-covered (head rs)) 0) (add acc (ds4t-row-count (head rs))) acc))))
    (defn ds4t-uncovered-tensors () (ds4t-uncovered-go (ds4t-census) 0))

    ; ── the live read ────────────────────────────────────────────────────
    (defn ds4t-src () (read_file_slice (ds4t-path) 0 (ds4t-window)))
    (defn ds4t-present? () (if (ge (str_len (ds4t-src)) (ds4t-window)) 1 0))
    (defn ds4t-live-count-go (s off n t acc)
        (if (eq n 0) acc
            (ds4t-live-count-go s (egg-ti-next s off) (sub n 1) t
                (if (eq (egg-ti-type s off) t) (add acc 1) acc))))
    (defn ds4t-live-count (t)
        (if (eq (ds4t-present?) 0) 0
            (do (let s (ds4t-src))
                (ds4t-live-count-go s (egg-tinfo-start s) (egg-tensor-count s) t 0))))
    (defn ds4t-live-version () (if (eq (ds4t-present?) 0) 0 (egg-version (ds4t-src))))
    (defn ds4t-live-tensor-count () (if (eq (ds4t-present?) 0) 0 (egg-tensor-count (ds4t-src))))
    (defn ds4t-live-kv-count () (if (eq (ds4t-present?) 0) 0 (egg-kv-count (ds4t-src))))
    (defn ds4t-live-tinfo-start () (if (eq (ds4t-present?) 0) 0 (egg-tinfo-start (ds4t-src))))
    (defn ds4t-live-agrees-go (rs)
        (if (eq (len rs) 0) 1
            (if (eq (ds4t-live-count (ds4t-row-code (head rs))) (ds4t-row-count (head rs)))
                (ds4t-live-agrees-go (tail rs)) 0)))
    (defn ds4t-live-agrees? () (if (eq (ds4t-present?) 0) 0 (ds4t-live-agrees-go (ds4t-census))))
    ; the census must ACCOUNT for every tensor — a type present in the file and
    ; absent from the record would leave this short, which is the failure a
    ; hand-written census is most likely to have
    (defn ds4t-live-total-go (s off n acc)
        (if (eq n 0) acc (ds4t-live-total-go s (egg-ti-next s off) (sub n 1) (add acc 1))))
    (defn ds4t-live-walked ()
        (if (eq (ds4t-present?) 0) 0
            (do (let s (ds4t-src)) (ds4t-live-total-go s (egg-tinfo-start s) (egg-tensor-count s) 0))))
    0)
