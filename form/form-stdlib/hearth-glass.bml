//////////////////////////////////////////////////////////////////////
//
// hearth-glass.bml
//
// Executable BML. The GLASS: the hearth's life rendered through the
// framebuffer channel as a living dashboard — every restart, prefill,
// request and reply LEDGERED durably, every phase longer than a second
// DECOMPOSED into one-second glyph steps, shade as transparency
// (space then light then medium then dark then full), symbols for the
// organs (queued, prefill, decode, served, melt, crystal), color by
// latency (green under one second, yellow under five, red beyond).
// The renderer is pure: rows in, one ANSI frame out; the live door
// ticks each second, diffs the durable sources, appends normalized
// ledger events, and repaints. Watching the glass IS reading the
// framebuffer voice.
//
// preludes: form-stdlib/core.fk form-stdlib/form-cli-movement.bml
//
// Proven by: form-stdlib/tests/hearth-glass-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormHearthGlass {
        thought glass-pattern = list("ledger", "decompose-to-seconds", "shade-is-transparency", "latency-color", "one-frame-per-tick");

        def gl-esc() = byte_to_str(27);
        def gl-nl() = byte_to_str(10);
        def gl-color(code) = str_concat(gl-esc(), str_concat("[", str_concat(code, "m")));
        def gl-reset() = gl-color("0");
        def gl-green() = gl-color("32");
        def gl-yellow() = gl-color("33");
        def gl-red() = gl-color("31");
        def gl-dim() = gl-color("2");
        def gl-home() = str_concat(gl-esc(), str_concat("[H", str_concat(gl-esc(), "[2J")));

        def gl-lat-color(ms) = if lt(ms, 1000) then gl-green() else if lt(ms, 5000) then gl-yellow() else gl-red();

        def gl-b3(a, b, c) = str_concat(byte_to_str(a), str_concat(byte_to_str(b), byte_to_str(c)));
        def gl-shade(i) = if le(i, 0) then " " else if eq(i, 1) then gl-b3(226, 150, 145) else if eq(i, 2) then gl-b3(226, 150, 146) else if eq(i, 3) then gl-b3(226, 150, 147) else gl-b3(226, 150, 136);
        def gl-ramp-go(n, i, acc) = if ge(i, n) then acc else gl-ramp-go(n, add(i, 1), str_concat(acc, gl-shade(if lt(i, 4) then add(i, 1) else 4)));
        def gl-seconds-bar(ms) = gl-ramp-go(if lt(div(ms, 1000), 1) then 1 else div(ms, 1000), 0, "");

        def gl-spark-one(v, top) = gl-shade(if le(top, 0) then 0 else div(mul(v, 4), top));
        def gl-spark-go(vs, top, acc) = if eq(len(vs), 0) then acc else gl-spark-go(tail(vs), top, str_concat(acc, gl-spark-one(head(vs), top)));
        def gl-max-go(vs, m) = if eq(len(vs), 0) then m else gl-max-go(tail(vs), if gt(head(vs), m) then head(vs) else m);
        def gl-spark(vs) = gl-spark-go(vs, gl-max-go(vs, 1), "");

        def gl-sym-served() = gl-b3(226, 156, 147);
        def gl-sym-melt() = "~";
        def gl-sym-crystal() = gl-b3(226, 156, 166);
        def gl-sym-decode() = gl-b3(226, 151, 137);
        def gl-sym-prefill() = gl-b3(226, 151, 144);

        def gl-line(label, value) = str_concat(gl-dim(), str_concat(label, str_concat(gl-reset(), str_concat(value, gl-nl()))));
        def gl-lat-line(label, ms) = str_concat(gl-dim(), str_concat(label, str_concat(gl-lat-color(ms), str_concat(int_to_str(ms), str_concat("ms ", str_concat(gl-seconds-bar(ms), str_concat(gl-reset(), gl-nl())))))));

        def gl-ledger-line(kind, t, detail) = str_concat(kind, str_concat(" t=", str_concat(int_to_str(t), str_concat(" ", str_concat(detail, gl-nl())))));

        def gl-collect-go(text, marker, from, acc) = gl-collect-at(text, marker, str_find(text, marker, from), acc);
        def gl-collect-at(text, marker, at, acc) = if lt(at, 0) then acc else gl-collect-go(text, marker, add(at, str_len(marker)), cons(fmv-field-int(text, add(at, str_len(marker)), 0, 0), acc));
        def gl-collect(text, marker) = gl-collect-go(text, str_concat(marker, "="), 0, tail(list(0)));

        def gl-insert(v, xs) = if eq(len(xs), 0) then list(v) else if le(v, head(xs)) then cons(v, xs) else cons(head(xs), gl-insert(v, tail(xs)));
        def gl-sort-go(xs, acc) = if eq(len(xs), 0) then acc else gl-sort-go(tail(xs), gl-insert(head(xs), acc));
        def gl-sort(xs) = gl-sort-go(xs, tail(list(0)));
        def gl-nth-of(xs, i) = if eq(len(xs), 0) then 0 else if le(i, 0) then head(xs) else gl-nth-of(tail(xs), sub(i, 1));
        def gl-pct(xs, p) = gl-nth-of(gl-sort(xs), sub(div(add(mul(len(xs), p), 99), 100), 1));

        def gl-newest(xs) = if eq(len(xs), 0) then 0 else head(xs);
        def gl-gauge-go(cells, fill, i, acc) = if ge(i, cells) then acc else gl-gauge-go(cells, fill, add(i, 1), str_concat(acc, gl-shade(if lt(i, fill) then 4 else 0)));
        def gl-gauge(pct) = gl-gauge-go(10, div(add(pct, 5), 10), 0, "");
        def gl-pct-color(pct) = if lt(pct, 50) then gl-green() else if lt(pct, 80) then gl-yellow() else gl-red();

        def gl-age-text(a) = if lt(a, 60) then str_concat(int_to_str(a), "s") else if lt(a, 3600) then str_concat(int_to_str(div(a, 60)), "m") else str_concat(int_to_str(div(a, 3600)), "h");
        def gl-age-color(a) = if lt(a, 3) then gl-green() else if lt(a, 30) then gl-yellow() else gl-dim();
        def gl-fresh(a) = str_concat("  ", str_concat(gl-age-color(a), str_concat(gl-age-text(a), gl-reset())));
        def gl-lat-line2(label, ms, suffix) = str_concat(gl-dim(), str_concat(label, str_concat(gl-lat-color(ms), str_concat(int_to_str(ms), str_concat("ms ", str_concat(gl-seconds-bar(ms), str_concat(gl-reset(), str_concat(suffix, gl-nl()))))))));
        def gl-word-end(s, i) = if ge(i, str_len(s)) then i else if eq(ord(char_at(s, i)), 10) then i else if str_eq(char_at(s, i), " ") then i else gl-word-end(s, add(i, 1));
        def gl-word-at(s, marker, at) = if lt(at, 0) then "" else substring(s, add(at, str_len(marker)), gl-word-end(s, add(at, str_len(marker))));
        def gl-word-field(s, name) = gl-word-at(s, str_concat(name, "="), str_find(s, str_concat(name, "="), 0));
        def gl-count-of(text, needle) = gl-count-go(text, needle, 0, 0);
        def gl-count-go(text, needle, from, acc) = gl-count-at(text, needle, str_find(text, needle, from), acc);
        def gl-count-at(text, needle, at, acc) = if lt(at, 0) then acc else gl-count-go(text, needle, add(at, str_len(needle)), add(acc, 1));
        def gl-member(xs, v) = if eq(len(xs), 0) then 0 else if eq(head(xs), v) then 1 else gl-member(tail(xs), v);
        def gl-diff-go(xs, ys, acc) = if eq(len(xs), 0) then acc else gl-diff-go(tail(xs), ys, if eq(gl-member(ys, head(xs)), 1) then acc else cons(head(xs), acc));
        def gl-waiting-turns(task-turns, reply-turns) = gl-diff-go(task-turns, reply-turns, tail(list(0)));
        def gl-phase-line(gas, water, ice) = str_concat("gas=", str_concat(int_to_str(gas), str_concat(" water=", str_concat(int_to_str(water), str_concat(" ice=", int_to_str(ice))))));
        def gl-turns-line-go(ts, acc) = if eq(len(ts), 0) then acc else gl-turns-line-go(tail(ts), str_concat(acc, str_concat(" ", int_to_str(head(ts)))));
        def gl-turns-line(ts) = if eq(len(ts), 0) then "none" else gl-turns-line-go(ts, "");
    }
    0;
}
