//////////////////////////////////////////////////////////////////////
//
// hearth-glass.bml
//
// Executable BML. The GLASS DATA VOCABULARY: how the hearth's durable
// sources become numbers and words — collectors, percentiles, field
// readers, waiting-set diffs, phase text, hearth symbols. Rendering
// belongs to the generic engine (term-graphics.bml); this surface
// never names a color or an escape.
//
// preludes: form-stdlib/core.fk form-stdlib/form-cli-movement.bml form-stdlib/term-graphics.bml form-stdlib/text-rows.bml
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormHearthGlass {
        thought glass-pattern = list("ledger", "data-not-paint", "newest-speaks", "one-frame-per-tick");

        def gl-sym-served() = tg-b3(226, 156, 147);
        def gl-sym-melt() = "~";
        def gl-sym-crystal() = tg-b3(226, 156, 166);
        def gl-sym-decode() = tg-b3(226, 151, 137);
        def gl-sym-prefill() = tg-b3(226, 151, 144);

        def gl-ledger-line(kind, t, detail) = kind ++ " t=" ++ int_to_str(t) ++ " " ++ detail ++ tg-nl();

        def gl-collect-go(text, marker, from, acc) = gl-collect-at(text, marker, str_find(text, marker, from), acc);
        def gl-collect-at(text, marker, at, acc) = at < 0 ? acc : gl-collect-go(text, marker, at + str_len(marker), cons(fmv-field-int(text, at + str_len(marker), 0, 0), acc));
        def gl-collect(text, marker) = gl-collect-go(text, marker ++ "=", 0, tail(list(0)));

        def gl-insert(v, xs) = (Comparable) len(xs) == 0 ? list(v) : v <= head(xs) ? cons(v, xs) : cons(head(xs), gl-insert(v, tail(xs)));
        def gl-sort-go(xs, acc) = (Comparable) len(xs) == 0 ? acc : gl-sort-go(tail(xs), gl-insert(head(xs), acc));
        def gl-sort(xs) = gl-sort-go(xs, tail(list(0)));
        def gl-nth-of(xs, i) = (Comparable) len(xs) == 0 ? 0 : i <= 0 ? head(xs) : gl-nth-of(tail(xs), i - 1);
        def gl-pct(xs, p) = gl-nth-of(gl-sort(xs), (((len(xs) * p) + 99) / 100) - 1);
        def gl-max-go(vs, m) = tg-max-go(vs, m);
        def gl-newest(xs) = (Comparable) len(xs) == 0 ? 0 : head(xs);

        def gl-word-end(s, i) = i >= str_len(s) ? i : (Comparable) ord(char_at(s, i)) == 10 ? i : (String) char_at(s, i) == " " ? i : gl-word-end(s, i + 1);
        def gl-word-at(s, marker, at) = at < 0 ? "" : substring(s, at + str_len(marker), gl-word-end(s, at + str_len(marker)));
        def gl-word-field(s, name) = gl-word-at(s, name ++ "=", str_find(s, name ++ "=", 0));
        def gl-line-field-at-present(s, marker, at) {
            let start = at + str_len(marker);
            let stop = str_find(s, tg-nl(), start);
            substring(s, start, stop < 0 ? str_len(s) : stop);
        }
        def gl-line-field-at(s, marker, at) = at < 0 ? "" : gl-line-field-at-present(s, marker, at);
        def gl-line-field(s, name) = gl-line-field-at(s, name ++ "=", str_find(s, name ++ "=", 0));
        def gl-find-last-go(s, needle, at) = str_find(s, needle, at + 1) < 0 ? at : gl-find-last-go(s, needle, str_find(s, needle, at + 1));
        def gl-find-last(s, needle) = gl-find-last-go(s, needle, str_find(s, needle, 0));
        def gl-word-field-last(s, name) = gl-word-at(s, name ++ "=", gl-find-last(s, name ++ "="));
        def gl-line-till(s, i) = tx-line-till(s, i);
        def gl-line-at(s, marker, at) = at < 0 ? "" : gl-line-till(s, at + str_len(marker));
        def gl-line-field-last(s, name) = gl-line-at(s, name ++ "=", gl-find-last(s, name ++ "="));
        def gl-clip(s, n) = str_len(s) <= n ? s : substring(s, 0, n) ++ "...";
        def gl-noise-line?(t) = (String) t == "" ? 1 : (String) t == "<think>" ? 1 : (String) t == "</think>" ? 1 : 0;
        def gl-body-walk(s, i) = i >= str_len(s) ? "" : (Comparable) gl-noise-line?(gl-line-till(s, i)) == 1 ? gl-body-walk(s, gl-line-end(s, i) + 1) : gl-line-till(s, i);
        def gl-body-after(s, marker) = gl-body-go(s, gl-find-last(s, marker), marker);
        def gl-body-go(s, at, marker) = at < 0 ? "" : gl-body-walk(s, at + str_len(marker));
        def gl-line-start(s, at) = tx-line-start(s, at);
        def gl-line-of(s, at) = tx-line-of(s, at);
        def gl-find-last-any-go(s, needles, best) = (Comparable) len(needles) == 0 ? best : gl-find-last-any-go(s, tail(needles), gl-find-last(s, head(needles)) > best ? gl-find-last(s, head(needles)) : best);
        def gl-find-last-any(s, needles) = gl-find-last-any-go(s, needles, 0 - 1);
        def gl-find-before-go(s, needle, at, cap) = str_find(s, needle, at + 1) < 0 ? at : str_find(s, needle, at + 1) >= cap ? at : gl-find-before-go(s, needle, str_find(s, needle, at + 1), cap);
        def gl-find-before(s, needle, cap) = str_find(s, needle, 0) < 0 ? (0 - 1) : str_find(s, needle, 0) >= cap ? (0 - 1) : gl-find-before-go(s, needle, str_find(s, needle, 0), cap);
        def gl-turn-before(s, cap) = gl-turn-before-of(s, gl-find-before(s, "turn=", cap));
        def gl-turn-before-of(s, at) = at < 0 ? 0 : fmv-field-int(s, at + str_len("turn="), 0, 0);
        def gl-count-of(text, needle) = gl-count-go(text, needle, 0, 0);
        def gl-count-go(text, needle, from, acc) = gl-count-at(text, needle, str_find(text, needle, from), acc);
        def gl-count-at(text, needle, at, acc) = at < 0 ? acc : gl-count-go(text, needle, at + str_len(needle), acc + 1);

        // A begin stage is already an asynchronous observation: the glass
        // derives its present age from the framebuffer without touching the
        // model thread or asking a shell to wait. An end stage dissolves the
        // flight back to `nothing`; numeric zero is never used for that
        // absence. The route is data, not a hard-coded direct-answer special
        // case: a Form-native source, recipe, or admission stage deserves the
        // same present-tense witness.
        def gl-line-end(s, at) = tx-line-end(s, at);
        def gl-direct-stage-line(out) {
            let at = gl-find-last(out, "form-peer stage route=direct-answer");
            at < 0 ? "" : substring(out, at, gl-line-end(out, at));
        }
        // The SELECTION is a stage like any other: the last stage line of
        // ANY route shows which door the policy chose and where the turn
        // stands right now — task-observation status=choice IS the model
        // selection moment, visible before the chosen route begins.
        def gl-stage-line(out) {
            let at = gl-find-last(out, "form-peer stage ");
            at < 0 ? "" : gl-line-till(out, at);
        }
        def gl-stage-field(out, name) = gl-word-field(gl-stage-line(out), name);
        def gl-flight-stage-line(out) = gl-stage-line(out);
        def gl-flight-route(out) = gl-word-field(gl-flight-stage-line(out), "route");
        def gl-flight-phase(out) = gl-word-field(gl-flight-stage-line(out), "phase");
        def gl-flight-status(out) = gl-word-field(gl-flight-stage-line(out), "status");
        def gl-flight-stamp(out) = str_to_int(gl-word-field(gl-flight-stage-line(out), "stamp-ms"));
        def gl-flight?(out) = (String) gl-flight-status(out) == "begin" ? 1 : 0;
        def gl-flight-route-now(out) = (Comparable) gl-flight?(out) == 1 ? gl-flight-route(out) : "nothing";
        def gl-flight-phase-now(out) = (Comparable) gl-flight?(out) == 1 ? gl-flight-phase(out) : "nothing";
        def gl-flight-age(out, nowms) = (Comparable) gl-flight?(out) == 1 ? (nowms - gl-flight-stamp(out)) : 0;
        def gl-direct-phase(out) = gl-word-field(gl-direct-stage-line(out), "phase");
        def gl-direct-status(out) = gl-word-field(gl-direct-stage-line(out), "status");
        def gl-direct-stamp(out) = str_to_int(gl-word-field(gl-direct-stage-line(out), "stamp-ms"));
        def gl-direct-flight?(out) = (String) gl-direct-status(out) == "begin" ? 1 : 0;
        def gl-direct-flight-phase(out) = (Comparable) gl-direct-flight?(out) == 1 ? gl-direct-phase(out) : "none";
        def gl-direct-flight-age(out, nowms) = (Comparable) gl-direct-flight?(out) == 1 ? (nowms - gl-direct-stamp(out)) : 0;

        def gl-member(xs, v) = (Comparable) len(xs) == 0 ? 0 : (Comparable) head(xs) == v ? 1 : gl-member(tail(xs), v);
        def gl-diff-go(xs, ys, acc) = (Comparable) len(xs) == 0 ? acc : gl-diff-go(tail(xs), ys, (Comparable) gl-member(ys, head(xs)) == 1 ? acc : cons(head(xs), acc));
        def gl-waiting-turns(task-turns, reply-turns) = gl-diff-go(task-turns, reply-turns, tail(list(0)));
        def gl-phase-line(gas, water, ice) = "gas=" ++ int_to_str(gas) ++ " water=" ++ int_to_str(water) ++ " ice=" ++ int_to_str(ice);
        def gl-turns-line-go(ts, acc) = (Comparable) len(ts) == 0 ? acc : gl-turns-line-go(tail(ts), acc ++ " " ++ int_to_str(head(ts)));
        def gl-turns-line(ts) = (Comparable) len(ts) == 0 ? "none" : gl-turns-line-go(ts, "");
    }
    0;
}
