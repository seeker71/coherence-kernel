    def iq2xs-u16(bytes, off) = nth(bytes, off) + 256 * nth(bytes, off + 1);
    def iq2xs-d(bytes, base) = fd-f16(iq2xs-u16(bytes, base));
    def iq2xs-qword(bytes, base, i) = iq2xs-u16(bytes, iq2x-qword-offset(base, i));
    def iq2xs-scale-byte(bytes, base, i) = nth(bytes, iq2x-scale-offset(base, i));
    def iq2xs-scale-code(bytes, base, i) = iq2x-scale-code(iq2xs-scale-byte(bytes, base, i), i);
    def iq2xs-grid-index(bytes, base, i) = iq2x-grid-index(iq2xs-qword(bytes, base, i));
    def iq2xs-sign-index(bytes, base, i) = iq2x-sign-index(iq2xs-qword(bytes, base, i));
    def iq2xs-sign-mask(bytes, base, i) = nth(iq2-ksigns(), iq2xs-sign-index(bytes, base, i));
    def iq2xs-sign(bytes, base, i) = (Comparable) iq2-mod(iq2xs-sign-mask(bytes, base, i) / iq2-pow2(iq2x-j(i)), 2) == 1 ? -1 : 1;
    def iq2xs-mag(bytes, base, i) = nth(iq2xs-grid(), iq2xs-grid-index(bytes, base, i) * IQ2XSGridWidth() + iq2x-j(i));
    def iq2xs-scale(bytes, base, i) = 0.25 * iq2xs-d(bytes, base) * (0.5 + iq2xs-scale-code(bytes, base, i));
    def iq2xs-at(bytes, base, i) = (Comparable) iq2x-within-block(i) == 1 ? iq2xs-scale(bytes, base, i) * iq2xs-sign(bytes, base, i) * iq2xs-mag(bytes, base, i) : form_error("iq2xs-at: weight index outside the 256-weight IQ2_XS block -- use iq2xs-at-flat for the 74-byte stride");
    def iq2xs-dequant-from(bytes, base, i, n) = i >= n ? empty() : cons(iq2xs-at(bytes, base, i), iq2xs-dequant-from(bytes, base, i + 1, n));
    def iq2xs-dequant(bytes, base) = iq2xs-dequant-from(bytes, base, 0, IQ2XSBlockElements());
    def iq2xs-at-flat(bytes, base, i) = iq2xs-at(bytes, base + IQ2XSBlockBytes() * iq2x-block-of(i), iq2x-within(i));
    0;
}
