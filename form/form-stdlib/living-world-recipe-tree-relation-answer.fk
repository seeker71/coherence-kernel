; living-world-recipe-tree-relation-answer.fk -- a current relation-aware
; composition answers an unresolved, consented binding query without importing
; an expected answer.
;
; The query is a content-addressed question cell carrying exact current parent
; and relation candidates, explicitly offered bindings, alternatives, optional
; unknowable, optional real-time lens declaration, optional sender-authored
; timeout, evidence, and local path.  Zero applicable relations executes every
; exact successor match, one executes that relation, and many retain every
; relation output.  No ordering or score chooses among plural relations.
;
; Immediate output geometry is NOTHING, ONE, or NODE.  Timeout condensation is
; a separate observation and never rewrites immediate silence or output.  The
; answer retains every derivation and crosses a separate ordinary unanimous
; offer/acknowledgment boundary governed by the exact active query, binding,
; parent, and relation holders.  Recipe, model, and voice authority do not move.
; witnessed: 2026-08-09 -> direct Form compile 340; answer band 31/31
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/living-world-recipe-tree-relation-nursery.fk form-stdlib/living-world-recipe-tree-relation-offer.fk form-stdlib/living-world-recipe-tree-relation-prospective.fk

(let LWRRPA-QUERY      (bp "LWRRPA-QUERY"))
(let LWRRPA-DERIVATION (bp "LWRRPA-DERIVATION"))
(let LWRRPA-ANSWER     (bp "LWRRPA-ANSWER"))
(let LWRRPA-ORIGIN     (bp "LWRRPA-ORIGIN"))

; children: exact revised successor, admitted relation field, bindings,
; alternatives, optional unknowable, optional lens declaration, optional
; timeout, evidence, local path.
(defn lwrrpa-query
    (parent relations bindings alternatives unknown declaration timeout evidence)
    (intern_node LWRRPA-QUERY
        (list parent relations bindings alternatives unknown declaration timeout
              evidence (lwo-local-path))))
(defn lwrrpa-query? (cell) (lwo-category? cell LWRRPA-QUERY))
(defn lwrrpa-query-parent (query) (nth (node_children query) 0))
(defn lwrrpa-query-relations (query) (nth (node_children query) 1))
(defn lwrrpa-query-bindings (query) (nth (node_children query) 2))
(defn lwrrpa-query-alternatives (query) (nth (node_children query) 3))
(defn lwrrpa-query-unknown (query) (nth (node_children query) 4))
(defn lwrrpa-query-declaration (query) (nth (node_children query) 5))
(defn lwrrpa-query-timeout (query) (nth (node_children query) 6))
(defn lwrrpa-query-evidence (query) (nth (node_children query) 7))
(defn lwrrpa-query-path (query) (nth (node_children query) 8))

(defn lwrrpa-relations-valid-items? (items)
    (if (eq (len items) 0) 1
        (if (eq (lwrro-candidate? (head items)) 1)
            (lwrrpa-relations-valid-items? (tail items)) 0)))
(defn lwrrpa-optional-unknown-valid? (unknown)
    (if (node_eq unknown (lwo-none)) 1 (lwlc-unknown? unknown)))
(defn lwrrpa-optional-declaration-valid? (declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-valid? declaration)))
(defn lwrrpa-optional-timeout-valid? (timeout)
    (if (node_eq timeout (lwo-none)) 1 (oac-timeout-valid? timeout)))
(defn lwrrpa-query-valid? (query)
    (if (eq (lwrrpa-query? query) 0) 0
        (if (eq (lwrtrh-candidate?
                    (lwrrpa-query-parent query)) 0) 0
            (if (or (eq (lwo-category?
                            (lwrrpa-query-relations query) LWO-FIELD) 0)
                    (eq (lwo-field-size
                            (lwrrpa-query-relations query)) 0)) 0
                (if (eq (lwrrpa-relations-valid-items?
                            (lwo-field-items
                                (lwrrpa-query-relations query))) 0) 0
                    (if (eq (lwre-bindings-valid?
                                (lwrrpa-query-bindings query)) 0) 0
                        (if (eq (lwo-category?
                                    (lwrrpa-query-alternatives query)
                                    LWO-FIELD) 0) 0
                            (if (eq (lwrrpa-optional-unknown-valid?
                                        (lwrrpa-query-unknown query)) 0) 0
                                (if (eq (lwrrpa-optional-declaration-valid?
                                            (lwrrpa-query-declaration query))
                                        0) 0
                                    (lwrrpa-optional-timeout-valid?
                                        (lwrrpa-query-timeout query)))))))))))

(defn lwrrpa-optional-declaration-current? (world declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-current? world declaration)))
(defn lwrrpa-query-active? (world query threshold)
    (lwps-active-at-threshold? world query threshold))
(defn lwrrpa-query-parent-current? (world query)
    (lwrtrh-integrated-current? world (lwrrpa-query-parent query)))
(defn lwrrpa-query-relations-current? (world query)
    (lwrrp-relations-current-items? world (lwrrpa-query-parent query)
        (lwo-field-items (lwrrpa-query-relations query))))
(defn lwrrpa-query-bindings-current? (world query)
    (lwre-bindings-current? world (lwrrpa-query-bindings query)))
(defn lwrrpa-query-declaration-current? (world query)
    (lwrrpa-optional-declaration-current? world
        (lwrrpa-query-declaration query)))
(defn lwrrpa-query-current? (world query threshold)
    (if (or (lt threshold 1)
            (eq (lwrrpa-query-valid? query) 0)) 0
        (do
            (if (and (eq (lwrrpa-query-active?
                            world query threshold) 1)
                     (and (eq (lwrrpa-query-parent-current? world query) 1)
                     (and (eq (lwrrpa-query-relations-current? world query) 1)
                     (and (eq (lwrrpa-query-bindings-current? world query) 1)
                          (eq (lwrrpa-query-declaration-current?
                                world query) 1))))) 1 0))))

(defn lwrrpa-relation-applies? (relation bindings)
    (do
        (let invariant
            (lwrro-choice-invariant (lwo-emergent-shape relation)))
        (let binding
            (lwrrn-binding-by-name (lwre-binding-items bindings)
                (lwrrn-invariant-name invariant)))
        (if (node_eq binding (lwo-none)) 0
            (node_eq (lwre-binding-value binding)
                (lwrrn-invariant-value invariant)))))

; children: exact executing basis (relation candidate or successor match),
; Recipe, bindings, output, local path.
(defn lwrrpa-derivation (basis recipe bindings output)
    (intern_node LWRRPA-DERIVATION
        (list basis recipe bindings output (lwo-local-path))))
(defn lwrrpa-derivation? (cell)
    (lwo-category? cell LWRRPA-DERIVATION))
(defn lwrrpa-derivation-basis (derivation)
    (nth (node_children derivation) 0))
(defn lwrrpa-derivation-recipe (derivation)
    (nth (node_children derivation) 1))
(defn lwrrpa-derivation-bindings (derivation)
    (nth (node_children derivation) 2))
(defn lwrrpa-derivation-output (derivation)
    (nth (node_children derivation) 3))

(defn lwrrpa-derive-relation-items
    (items bindings derivations outputs)
    (if (eq (len items) 0) (list derivations outputs)
        (do
            (let relation (head items))
            (if (eq (lwrrpa-relation-applies? relation bindings) 0)
                (lwrrpa-derive-relation-items
                    (tail items) bindings derivations outputs)
                (do
                    (let trial
                        (lwrro-choice-trial
                            (lwo-emergent-shape relation)))
                    (let recipe (lwrrn-trial-recipe trial))
                    (let output
                        (intern_trivial_int
                            (lwre-evaluate-bound recipe bindings)))
                    (lwrrpa-derive-relation-items (tail items) bindings
                        (lwo-field-add derivations
                            (lwrrpa-derivation relation recipe
                                bindings output))
                        (lwo-field-add outputs output)))))))
(defn lwrrpa-derive-match-items
    (items bindings derivations outputs)
    (if (eq (len items) 0) (list derivations outputs)
        (do
            (let match (head items))
            (let recipe (lwrtrh-match-recipe match))
            (let output
                (intern_trivial_int
                    (lwre-evaluate-bound recipe bindings)))
            (lwrrpa-derive-match-items (tail items) bindings
                (lwo-field-add derivations
                    (lwrrpa-derivation match recipe bindings output))
                (lwo-field-add outputs output)))))
(defn lwrrpa-compose (parent relations bindings)
    (do
        (let related
            (lwrrpa-derive-relation-items (lwo-field-items relations)
                bindings (lwo-empty-field) (lwo-empty-field)))
        (if (gt (lwo-field-size (nth related 0)) 0) related
            (lwrrpa-derive-match-items
                (lwo-field-items
                    (lwrtrh-field-matches
                        (lwo-emergent-shape parent)))
                bindings (lwo-empty-field) (lwo-empty-field)))))

(defn lwrrpa-immediate (outputs)
    (if (eq (lwo-field-size outputs) 0) (oac-nothing)
        (if (eq (lwo-field-size outputs) 1)
            (oac-one (head (lwo-field-items outputs)))
            (oac-node outputs))))
(defn lwrrpa-time (query observed-time)
    (if (or (node_eq (lwrrpa-query-timeout query) (lwo-none))
            (node_eq observed-time (lwo-none))) (lwo-none)
        (oac-timeout-condense
            (lwrrpa-query-timeout query) observed-time)))

(defn lwrrpa-union-items (items field)
    (if (eq (len items) 0) field
        (lwrrpa-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwrrpa-relation-witnesses (world items field)
    (if (eq (len items) 0) field
        (lwrrpa-relation-witnesses world (tail items)
            (lwrrpa-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world (head items)))
                field))))
(defn lwrrpa-witnesses (world query)
    (do
        (let with-query
            (lwrrpa-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world query))
                (lwo-empty-field)))
        (let with-parent
            (lwrrpa-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwrrpa-query-parent query))) with-query))
        (let with-relations
            (lwrrpa-relation-witnesses world
                (lwo-field-items (lwrrpa-query-relations query)) with-parent))
        (lwrrpa-union-items
            (lwo-field-items
                (lwre-binding-witnesses
                    world (lwrrpa-query-bindings query)))
            with-relations)))

; children: exact query, all derivations, unique outputs, immediate ack,
; separate time observation, alternatives, optional unknowable, optional lens
; declaration, complete witnesses, observed time, threshold, local path.
(defn lwrrpa-answer
    (query derivations outputs immediate time alternatives unknown declaration
     witnesses observed-time threshold)
    (intern_node LWRRPA-ANSWER
        (list query derivations outputs immediate time alternatives unknown
              declaration witnesses observed-time
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwrrpa-answer? (cell) (lwo-category? cell LWRRPA-ANSWER))
(defn lwrrpa-answer-query (answer) (nth (node_children answer) 0))
(defn lwrrpa-answer-derivations (answer) (nth (node_children answer) 1))
(defn lwrrpa-answer-outputs (answer) (nth (node_children answer) 2))
(defn lwrrpa-answer-immediate (answer) (nth (node_children answer) 3))
(defn lwrrpa-answer-time (answer) (nth (node_children answer) 4))
(defn lwrrpa-answer-alternatives (answer) (nth (node_children answer) 5))
(defn lwrrpa-answer-unknown (answer) (nth (node_children answer) 6))
(defn lwrrpa-answer-declaration (answer) (nth (node_children answer) 7))
(defn lwrrpa-answer-witnesses (answer) (nth (node_children answer) 8))
(defn lwrrpa-answer-observed-time (answer) (nth (node_children answer) 9))
(defn lwrrpa-answer-threshold (answer)
    (node_value (nth (node_children answer) 10)))
(defn lwrrpa-answer-path (answer) (nth (node_children answer) 11))

; Currentness and composition are separate cells so a caller that has just
; observed the exact immutable world/query snapshot can inspect composition
; without paying for, or hiding behind, the same currentness walk again.
; This helper grants no authority: public entry points still observe currentness.
(defn lwrrpa-answer-for-current
    (world query threshold observed-time)
    (do
        (let composed
            (lwrrpa-compose (lwrrpa-query-parent query)
                (lwrrpa-query-relations query)
                (lwrrpa-query-bindings query)))
        (let outputs (nth composed 1))
        (lwrrpa-answer query (nth composed 0) outputs
            (lwrrpa-immediate outputs)
            (lwrrpa-time query observed-time)
            (lwrrpa-query-alternatives query)
            (lwrrpa-query-unknown query)
            (lwrrpa-query-declaration query)
            (lwrrpa-witnesses world query) observed-time threshold)))
(defn lwrrpa-answer-for (world query threshold observed-time)
    (if (eq (lwrrpa-query-current? world query threshold) 0) (lwo-none)
        (lwrrpa-answer-for-current world query threshold observed-time)))
(defn lwrrpa-answer-current? (world answer)
    (if (eq (lwrrpa-answer? answer) 0) 0
        (node_eq answer
            (lwrrpa-answer-for world (lwrrpa-answer-query answer)
                (lwrrpa-answer-threshold answer)
                (lwrrpa-answer-observed-time answer)))))

(defn lwrrpa-origin (answer)
    (intern_node LWRRPA-ORIGIN
        (list answer (lwrrpa-answer-witnesses answer) (lwo-local-path))))
(defn lwrrpa-proposal-from-answer (answer)
    (do
        (let witnesses (lwrrpa-answer-witnesses answer))
        (let origin (lwrrpa-origin answer))
        (let candidate
            (lwo-emergent answer witnesses
                (intern_trivial_int
                    (lwo-field-size (lwrrpa-answer-derivations answer)))
                (intern_trivial_int
                    (lwo-field-size (lwrrpa-answer-outputs answer)))
                (intern_trivial_int (lwo-field-size witnesses)) origin))
        (lwt-proposal candidate
            (lwt-sources-from-attributions
                (lwo-field-items witnesses) (lwo-empty-field))
            origin)))
(defn lwrrpa-proposal (world query threshold observed-time)
    (do
        (let answer
            (lwrrpa-answer-for world query threshold observed-time))
        (if (node_eq answer (lwo-none)) (lwo-none)
            (lwrrpa-proposal-from-answer answer))))
(defn lwrrpa-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrrpa-answer?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
; Structural freshness after the exact query snapshot has already been
; observed current.  This is the second, bounded half of candidate currentness;
; it cannot activate a candidate and does not replace the public full check.
(defn lwrrpa-candidate-current-after-query? (world candidate)
    (if (eq (lwrrpa-candidate? candidate) 0) 0
        (do
            (let answer (lwo-emergent-shape candidate))
            (let fresh-answer
                (lwrrpa-answer-for-current world
                    (lwrrpa-answer-query answer)
                    (lwrrpa-answer-threshold answer)
                    (lwrrpa-answer-observed-time answer)))
            (node_eq candidate
                (lwt-proposal-candidate
                    (lwrrpa-proposal-from-answer fresh-answer))))))
(defn lwrrpa-candidate-current? (world candidate)
    (if (eq (lwrrpa-candidate? candidate) 0) 0
        (do
            (let answer (lwo-emergent-shape candidate))
            (if (eq (lwrrpa-query-current? world
                        (lwrrpa-answer-query answer)
                        (lwrrpa-answer-threshold answer)) 0) 0
                (lwrrpa-candidate-current-after-query? world candidate)))))
(defn lwrrpa-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrrpa-candidate-current? world candidate) 1)) 1 0))
(defn lwrrpa-integrate (round proposal action)
    (if (eq (lwrrpa-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; The caller has just observed the exact round-world/query snapshot current.
; Structural answer freshness is still checked here; lwt-integrate still owns
; the unanimous offer/ack boundary.  Direct lwt-integrate is already public,
; so this creates no new authority surface.
(defn lwrrpa-integrate-after-query-current (round proposal action)
    (if (eq (lwrrpa-candidate-current-after-query?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

(defn lwrrpa-progress-target (answer)
    (if (node_eq answer (lwo-none)) "answer:nothing"
        (lcfb-cat (list
            "derivations:"
            (int_to_str
                (lwo-field-size (lwrrpa-answer-derivations answer)))
            ":outputs:"
            (int_to_str (lwo-field-size (lwrrpa-answer-outputs answer)))
            ":immediate:"
            (if (eq (oac-one? (lwrrpa-answer-immediate answer)) 1) "ONE"
                (if (eq (oac-node?
                            (lwrrpa-answer-immediate answer)) 1) "NODE"
                    "NOTHING"))
            ":time:"
            (if (node_eq (lwrrpa-answer-time answer) (lwo-none)) "NONE"
                (if (eq (oac-time-pending?
                            (lwrrpa-answer-time answer)) 1) "PENDING"
                    "OUTCOME"))))))
