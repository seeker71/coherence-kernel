//////////////////////////////////////////////////////////////////////
//
// native-model-glass.bml — executable model routing and glass projection.
//
// Authority: form-stdlib/bml/native-model-glass.bml
// preludes: form/form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelGlassAuthority {
        field NMGAuthorityPath = "form/form-stdlib/bml/native-model-glass.bml";
        field NMGAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelGlass {
        field NMGSchema = "native-model-glass-v1";
        field NMGCarrierSchema = "native-model-carrier-v1";
        field NMGThreeB = "base.llama32-3b-metal";
        field NMGNative = "world.entity-state";
        field NMGQwen = "challenger.qwen38-flash-next-q2-metal";

        ref nmg-authority = NativeModelGlassAuthority;
        thought nmg-route-law = list("known-grammar-native", "3b-open-nl-to-form", "native-validate-and-evaluate", "explicit-inability", "qwen-reasoning-fallback");

        // model: tag, id, role, loaded, prefilled, active, phase,
        // context-token count, transition reason, execution surface.
        def nmg-model(id, role, loaded, prefilled, active, phase, contextTokens, reason, surface) {
            list("native-model-glass-state", id, role, loaded, prefilled, active, phase, contextTokens, reason, surface);
        }
        def nmg-id(model) = nth(model, 1);
        def nmg-role(model) = nth(model, 2);
        def nmg-loaded?(model) = nth(model, 3);
        def nmg-prefilled?(model) = nth(model, 4);
        def nmg-active?(model) = nth(model, 5);
        def nmg-phase(model) = nth(model, 6);
        def nmg-context-tokens(model) = nth(model, 7);
        def nmg-reason(model) = nth(model, 8);
        def nmg-surface(model) = nth(model, 9);

        // session: tag, sequence, selected output route, decision, model rows.
        def nmg-session(sequence, route, decision, models) = list("native-model-glass-session", sequence, route, decision, models);
        def nmg-sequence(session) = nth(session, 1);
        def nmg-route(session) = nth(session, 2);
        def nmg-decision(session) = nth(session, 3);
        def nmg-models(session) = nth(session, 4);

        def nmg-initial() {
            nmg-session(0, "none", "idle", list(
                nmg-model(NMGNative(), "form-validator-world-evaluator", 1, 0, 0, "ready", 0, "native-image-resident", "fkwu-native"),
                nmg-model(NMGThreeB(), "nl-to-form-proposer", 0, 0, 0, "absent", 0, "no-live-context", "fkwu+Metal"),
                nmg-model(NMGQwen(), "reasoning-fallback", 0, 0, 0, "absent", 0, "no-live-context", "fkwu+Metal")));
        }

        def nmg-find(id, models) = if eq(len(models), 0) then list() else if str_eq(id, nmg-id(head(models))) then head(models) else nmg-find(id, tail(models));
        def nmg-replace(id, replacement, models) = if eq(len(models), 0) then list() else if str_eq(id, nmg-id(head(models))) then cons(replacement, tail(models)) else cons(head(models), nmg-replace(id, replacement, tail(models)));
        def nmg-deactivate-model(model) = nmg-model(nmg-id(model), nmg-role(model), nmg-loaded?(model), nmg-prefilled?(model), 0, nmg-phase(model), nmg-context-tokens(model), nmg-reason(model), nmg-surface(model));
        def nmg-deactivate-all(models) = if eq(len(models), 0) then list() else cons(nmg-deactivate-model(head(models)), nmg-deactivate-all(tail(models)));

        // This is an observation transition. Loaders call it at their real
        // boundary; artifact discovery must never call it with loaded=1.
        def nmg-observed(session, id, loaded, prefilled, active, phase, contextTokens, reason, route, decision) {
            let quiet = nmg-deactivate-all(nmg-models(session));
            let previous = nmg-find(id, quiet);
            let replacement = nmg-model(id, nmg-role(previous), loaded, prefilled, active, phase, contextTokens, reason, nmg-surface(previous));
            nmg-session(add(nmg-sequence(session), 1), route, decision, nmg-replace(id, replacement, quiet));
        }

        def nmg-valid-bit(value) = if or(eq(value, 0), eq(value, 1)) then 1 else 0;
        def nmg-model-valid?(model) {
            if not(eq(len(model), 10)) then 0
            else if not(eq(nmg-valid-bit(nmg-loaded?(model)), 1)) then 0
            else if not(eq(nmg-valid-bit(nmg-prefilled?(model)), 1)) then 0
            else if not(eq(nmg-valid-bit(nmg-active?(model)), 1)) then 0
            else if and(eq(nmg-prefilled?(model), 1), eq(nmg-loaded?(model), 0)) then 0
            else if lt(nmg-context-tokens(model), 0) then 0
            else 1;
        }
        def nmg-active-count(models) = if eq(len(models), 0) then 0 else add(nmg-active?(head(models)), nmg-active-count(tail(models)));
        def nmg-models-valid?(models) = if eq(len(models), 0) then 1 else if eq(nmg-model-valid?(head(models)), 1) then nmg-models-valid?(tail(models)) else 0;
        def nmg-session-valid?(session) = if eq(nmg-models-valid?(nmg-models(session)), 1) then if le(nmg-active-count(nmg-models(session)), 1) then 1 else 0 else 0;
        def nmg-active-id(session) {
            let models = nmg-models(session);
            if eq(len(models), 0) then "none" else nmg-active-id-in(models);
        }
        def nmg-active-id-in(models) = if eq(len(models), 0) then "none" else if eq(nmg-active?(head(models)), 1) then nmg-id(head(models)) else nmg-active-id-in(tail(models));

        // Capability-aware ingress. Form and deterministic grammar stay in
        // the resident native image. The 3B opens only when an NL-to-Form
        // translation is needed and the native grammar has no exact shape.
        def nmg-ingress-route(kind, task, knownGrammar) {
            if str_eq(kind, "form") then "native"
            else if and(str_eq(task, "nl-form"), eq(knownGrammar, 0)) then "3b"
            else "native";
        }
        def nmg-begin-routed-input(session, kind, task, knownGrammar) {
            let route = nmg-ingress-route(kind, task, knownGrammar);
            if str_eq(route, "3b") then nmg-observed(session, NMGThreeB(), 1, 0, 1, "nl-to-form", 0, "direct-metal-context-opened", "none", "3b-proposes-form-tokens-and-primitives")
            else if str_eq(kind, "form") then nmg-observed(session, NMGNative(), 1, 0, 1, "validate-form", 0, "form-input-bypasses-nl-translation", "none", "native-validation")
            else nmg-observed(session, NMGNative(), 1, 0, 1, "native-ingress", 0, "native-grammar-or-world-first", "none", "native-first");
        }
        def nmg-begin-input(session, kind) = nmg-begin-routed-input(session, kind, "general", 0);
        // Physical 3B transitions mirror Qwen's carrier-bound path.  The
        // ordinary ingress selector never earns these states by itself.
        def nmg-threeb-loading(session) = nmg-observed(session, NMGThreeB(), 0, 0, 1, "loading", 0, "nl-form-ingress-authorized", "none", "3b-runtime-opening");
        def nmg-threeb-loaded(session) = nmg-observed(session, NMGThreeB(), 1, 0, 0, "resident", 0, "3b-context-open-returned", "none", "3b-loaded-not-prefilled");
        def nmg-threeb-prefilling(session, residentTokens) = nmg-observed(session, NMGThreeB(), 1, 0, 1, "prefill", residentTokens, "3b-prefix-evaluate-entered", "none", "3b-prefilling");
        def nmg-threeb-finished(session, contextTokens) = nmg-observed(session, NMGThreeB(), 1, 1, 0, "resident", contextTokens, "3b-generation-returned", "none", "3b-answer");
        def nmg-finish-ingress(session, valid, promptTokens) {
            if eq(valid, 1) then nmg-observed(session, NMGThreeB(), 1, 1, 0, "resident", promptTokens, "form-proposal-validated", "none", "form-ready-for-native-evaluation")
            else nmg-observed(session, NMGThreeB(), 1, 1, 0, "rejected", promptTokens, "invalid-or-unproven-form-proposal", "none", "native-deterministic-translation-repair");
        }
        def nmg-begin-native(session) = nmg-observed(session, NMGNative(), 1, 0, 1, "evaluate-form", 0, "validated-form-entered-native-world", "none", "native-world-evaluating");

        def nmg-native-unable?(outcome) {
            if str_eq(outcome, "nothing") then 1
            else if str_eq(outcome, "request-evidence") then 1
            else if str_eq(outcome, "unable") then 1
            else 0;
        }
        // Direct adapter for cognition/native-cognition-cycle.fk's witnessed
        // response shape: [nothing,0,1,alternative,ack,action,route].
        def nmg-native-response-outcome(response) {
            if not(eq(len(response), 7)) then "invalid-response"
            else if and(eq(nth(response, 6), 0), and(eq(nth(response, 5), 0), not(nothing?(nth(response, 4))))) then "answer"
            else if and(eq(nth(response, 6), 1), eq(nth(response, 5), 4)) then "request-evidence"
            else "invalid-response";
        }
        def nmg-finish-native-response(session, response) = nmg-finish-native(session, nmg-native-response-outcome(response));
        def nmg-finish-native(session, outcome) {
            if str_eq(outcome, "answer") then nmg-observed(session, NMGNative(), 1, 0, 0, "answered", 0, "native-answer-present", NMGNative(), "native-answer")
            else if eq(nmg-native-unable?(outcome), 1) then nmg-observed(session, NMGNative(), 1, 0, 0, "unable", 0, outcome, NMGQwen(), "qwen-selected-not-yet-loaded")
            else nmg-observed(session, NMGNative(), 1, 0, 0, "abstained", 0, outcome, "none", "abstain-unrecognized-native-outcome");
        }

        // These transitions are called around the actual Qwen state API.
        // Selection alone never marks the 79 GB model loaded.
        def nmg-qwen-loading(session) = nmg-observed(session, NMGQwen(), 0, 0, 1, "loading", 0, "native-fallback-authorized", NMGQwen(), "qwen-runtime-opening");
        def nmg-qwen-loaded(session) = nmg-observed(session, NMGQwen(), 1, 0, 0, "resident", 0, "qwen-context-open-returned", NMGQwen(), "qwen-loaded-not-prefilled");
        def nmg-qwen-prefilling(session, residentTokens) = nmg-observed(session, NMGQwen(), 1, 0, 1, "prefill", residentTokens, "qwen-prefix-evaluate-entered", NMGQwen(), "qwen-prefilling");
        def nmg-qwen-reasoning(session, contextTokens) = nmg-observed(session, NMGQwen(), 1, 1, 1, "reason", contextTokens, "qwen-prefill-returned", NMGQwen(), "qwen-reasoning");
        def nmg-qwen-finished(session, contextTokens) = nmg-observed(session, NMGQwen(), 1, 1, 0, "resident", contextTokens, "qwen-generation-finished", NMGQwen(), "qwen-answer");
        def nmg-release(session, id) = nmg-observed(session, id, 0, 0, 0, "released", 0, "runtime-context-closed", nmg-route(session), "model-released");

        def nmg-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), nmg-cat(tail(parts)));
        def nmg-render-row(model) {
            nmg-cat(list("GLASS MODEL id=", nmg-id(model), " role=", nmg-role(model), " loaded=", int_to_str(nmg-loaded?(model)), " prefilled=", int_to_str(nmg-prefilled?(model)), " active=", int_to_str(nmg-active?(model)), " phase=", nmg-phase(model), " context_tokens=", int_to_str(nmg-context-tokens(model)), " reason=", nmg-reason(model), " surface=", nmg-surface(model), "\n"));
        }
        def nmg-render-models(models) = if eq(len(models), 0) then "" else str_concat(nmg-render-row(head(models)), nmg-render-models(tail(models)));
        def nmg-render(session) {
            nmg-cat(list("GLASS ROUTE schema=", NMGSchema(), " sequence=", int_to_str(nmg-sequence(session)), " selected=", nmg-route(session), " active=", nmg-active-id(session), " decision=", nmg-decision(session), "\n", nmg-render-models(nmg-models(session))));
        }

        // Framebuffer nodes deliberately omit prompt, proposal, answer, and
        // token ids. The live glass receives only identity and state.
        def nmg-frame-row(model, sequence) {
            intern_node_at(bp("FORM-MODEL-GLASS-V1"), list(
                intern_trivial_string(nmg-id(model)),
                intern_trivial_string(nmg-role(model)),
                intern_trivial_int(nmg-loaded?(model)),
                intern_trivial_int(nmg-prefilled?(model)),
                intern_trivial_int(nmg-active?(model)),
                intern_trivial_string(nmg-phase(model)),
                intern_trivial_int(nmg-context-tokens(model)),
                intern_trivial_string(nmg-reason(model)),
                intern_trivial_int(sequence)),
                "form/form-stdlib/native-model-glass.bml", 1, 1);
        }
        def nmg-frame-models(models, sequence) = if eq(len(models), 0) then list() else cons(nmg-frame-row(head(models), sequence), nmg-frame-models(tail(models), sequence));
        def nmg-glass-write(session) {
            let frames = nmg-frame-models(nmg-models(session), nmg-sequence(session));
            print_str(nmg-render(session));
            list("native-model-glass-frame", session, frames);
        }

        // Physical frames are admitted only beside a positive carrier handle
        // obtained from the live model context.  Pure route rehearsals use
        // nmg-glass-write and can never emit FORM-MODEL-CARRIER-V1.
        def nmg-carrier-frame(session, id, handle, event, closed) {
            intern_node_at(bp("FORM-MODEL-CARRIER-V1"), list(
                intern_trivial_string(id),
                intern_trivial_int(handle),
                intern_trivial_string(event),
                intern_trivial_int(closed),
                intern_trivial_int(nmg-sequence(session))),
                "form/form-stdlib/native-model-glass.bml", 1, 1);
        }
        def nmg-glass-write-physical-admitted(session, id, handle, event) {
            let carrier = nmg-carrier-frame(session, id, handle, event, 0);
            print_str(nmg-cat(list("GLASS CARRIER schema=", NMGCarrierSchema(), " evidence=physical model=", id, " handle=", int_to_str(handle), " event=", event, " closed=0\n")));
            let glass = nmg-glass-write(session);
            list("native-model-physical-frame", carrier, glass);
        }
        def nmg-glass-write-physical(session, id, handle, event) = if le(handle, 0) then list("native-model-carrier-refused", id, "missing-live-handle", event) else nmg-glass-write-physical-admitted(session, id, handle, event);
        def nmg-glass-write-physical-release-admitted(session, id, priorHandle) {
            let carrier = nmg-carrier-frame(session, id, priorHandle, "release-returned", 1);
            print_str(nmg-cat(list("GLASS CARRIER schema=", NMGCarrierSchema(), " evidence=physical model=", id, " handle=", int_to_str(priorHandle), " event=release-returned closed=1\n")));
            let glass = nmg-glass-write(session);
            list("native-model-physical-release-frame", carrier, glass);
        }
        def nmg-glass-write-physical-release(session, id, priorHandle, closeResult) = if or(le(priorHandle, 0), not(eq(closeResult, 1))) then list("native-model-carrier-refused", id, "unproven-close", closeResult) else nmg-glass-write-physical-release-admitted(session, id, priorHandle);
    }
    0;
}
