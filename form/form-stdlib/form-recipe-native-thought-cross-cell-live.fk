; form-recipe-native-thought-cross-cell-live.fk — ONE intentional effectful
; Metal micro-thought crossing, with bounded framebuffer stage observations.
;
; This driver must not be preflighted: its purpose is the live carrier effect.
; The pure mechanism and edge band are preflighted separately before this door
; is opened. It makes no local-model or mesh-broadcast claim.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/form-recipe-native-thought-cross-cell.fk

(do
    (defn frntlive-bit (condition bit) (if condition bit 0))
    (defn frntlive-cat (parts)
        (if (eq (len parts) 0) ""
            (str_concat (head parts) (frntlive-cat (tail parts)))))
    (defn frntlive-froc-actions-events (events)
        (if (eq (len events) 0) ""
            (if (eq (len (tail events)) 0)
                (froc-event-action (head events))
                (str_concat (froc-event-action (head events))
                    (str_concat ","
                        (frntlive-froc-actions-events (tail events)))))))
    (defn frntlive-froc-actions (trace)
        (frntlive-froc-actions-events (froc-trace-events trace)))
    (defn frntlive-record-stage (stage index)
        (fb_record stage
            "form-recipe-native-thought-cross-cell-live.fk" index))
    (defn frntlive-stage-line (stage)
        (frntlive-cat (list
            "[framebuffer] stage=" (int_to_str (frnt-stage-index stage))
            " name=" (frnt-stage-name stage)
            " node=" (frex-node-coordinate stage) "\n")))

    (framebuffer-clear)

    (let surface (frex-surface (frex-recipe) 5 "metal"))
    (let scan (frnt-bmf-consume-default surface))
    (let stage0 (frnt-stage 0 "request-addressed"
        (frnt-scan-request scan) scan (nothing) (nothing)))
    (let recorded0 (frntlive-record-stage stage0 0))
    (let stage1 (frnt-stage 1 "bmf-bytes-consumed"
        recorded0 scan (nothing) (nothing)))
    (let recorded1 (frntlive-record-stage stage1 1))

    ; The sole effectful Metal call in this driver.
    (let live (frexl-execute-stream (frnt-scan-consumed scan)))
    (let last-error (metal_status))
    (let stage2 (frnt-stage 2 "native-execution-observed"
        recorded1 scan live (nothing)))
    (let recorded2 (frntlive-record-stage stage2 2))

    (let result (frnt-cross-live-result scan live
        (str_concat (temp_dir) "/frnt-live.channel")
        (str_concat (temp_dir) "/frnt-live.persistence")
        1 last-error))
    (let rich (frnt-result-ack result))
    (let crossing (frnt-result-crossing result))
    (let crossing-ack (froc-cross-ack crossing))
    (let meaning (frnt-ack-meaning rich))
    (let vitality (frnt-ack-vitality rich))

    (let stage3 (frnt-stage 3 "typed-observation-crossed"
        recorded2 scan live crossing-ack))
    (let recorded3 (frntlive-record-stage stage3 3))
    (let stage4 (frnt-stage 4 "two-lenses-observed"
        recorded3 scan live crossing-ack))
    (let recorded4 (frntlive-record-stage stage4 4))
    (let stage5 (frnt-stage 5 "release-observed"
        recorded4 scan live crossing-ack))
    (let recorded5 (frntlive-record-stage stage5 5))
    (let frames (framebuffer-events))

    (print (frntlive-stage-line stage0))
    (print (frntlive-stage-line stage1))
    (print (frntlive-stage-line stage2))
    (print (frntlive-stage-line stage3))
    (print (frntlive-stage-line stage4))
    (print (frntlive-stage-line stage5))
    (print (frntlive-cat (list
        "form-recipe-native-thought-cross-cell-live"
        " surface=" (froc-node-text (frnt-scan-surface scan))
        " request=" (froc-node-text (frnt-ack-request rich))
        " recipe=" (froc-node-text (frnt-ack-recipe rich))
        " code=" (froc-node-text (frnt-ack-code rich))
        " execution=" (froc-node-text (frnt-ack-execution rich))
        " observation=" (froc-node-text (frnt-ack-observation rich))
        " emitter=" (froc-node-text (froc-ack-emitter crossing-ack))
        " receiver=" (froc-node-text (froc-ack-receiver crossing-ack))
        " channel=" (froc-node-text (froc-ack-channel crossing-ack))
        " received=" (froc-node-text (froc-ack-received crossing-ack))
        " meaning=" (froc-node-text meaning)
        " vitality=" (froc-node-text vitality)
        " scan-status=" (frnt-scan-status scan)
        " scan-bytes=" (int_to_str (frnt-scan-bytes scan))
        " pretokenized=" (int_to_str (frnt-ack-pretokenized? rich))
        " status=" (frnt-ack-status rich)
        " reason=" (frnt-ack-reason rich)
        " carrier=" (frnt-ack-carrier rich)
        " present=" (int_to_str (frnt-ack-value-present? rich))
        " value=" (int_to_str (frnt-ack-value rich))
        " expected=" (int_to_str (frexl-recipe-expected
            (frnt-scan-recipe scan) 5))
        " source-generated=" (int_to_str
            (frnt-ack-source-generated? rich))
        " native-code-generated=" (int_to_str
            (frnt-ack-native-generated? rich))
        " recipe-executed=" (int_to_str
            (frnt-ack-recipe-executed? rich))
        " model-executed=" (int_to_str
            (frnt-ack-model-executed? rich))
        " pipeline-created=" (int_to_str
            (frexl-result-pipeline-created? live))
        " wrote-bytes=" (int_to_str (frexl-result-wrote-bytes live))
        " enqueued=" (int_to_str (frexl-result-enqueued live))
        " synced=" (int_to_str (frexl-result-synced live))
        " read-bytes=" (int_to_str (frexl-result-read-bytes live))
        " buffer-released=" (int_to_str
            (frnt-ack-buffer-released? rich))
        " last-error=" (frnt-ack-last-error rich)
        " delivered=" (froc-ack-delivery-status crossing-ack)
        " transported=" (int_to_str (froc-ack-transported? crossing-ack))
        " mesh-transported="
            (int_to_str (froc-ack-mesh-transported? crossing-ack))
        " persistence=" (froc-persistence-status
            (froc-ack-persistence crossing-ack))
        " bmf-lifecycle=" (frnt-trace-actions (frnt-scan-trace scan))
        " execution-lifecycle=" (frex-trace-actions
            (frexl-result-lifecycle live))
        " crossing-lifecycle=" (frntlive-froc-actions
            (froc-ack-cross-trace crossing-ack))
        " framebuffer-events=" (int_to_str (len frames))
        "\n")))

    (sum (list
        (frntlive-bit (eq (frnt-addressed-request? scan) 1) 1)
        (frntlive-bit (and (str_eq (frnt-scan-consumed scan) surface)
                           (eq (frnt-scan-pretokenized? scan) 0)) 2)
        (frntlive-bit (node_eq (nth (node_children
                            (frnt-ack-code rich)) 0)
                            (frnt-ack-recipe rich)) 4)
        (frntlive-bit (eq (frnt-ack-native-generated? rich) 1) 8)
        (frntlive-bit (eq (frnt-ack-recipe-executed? rich) 1) 16)
        (frntlive-bit (eq (frnt-ack-model-executed? rich) 0) 32)
        (frntlive-bit (and (str_eq (frnt-ack-status rich) "value")
            (and (eq (frnt-ack-value-present? rich) 1)
                 (eq (frnt-ack-value rich) 22))) 64)
        (frntlive-bit (eq (frnt-ack-buffer-released? rich) 1) 128)
        (frntlive-bit (and (str_eq
                            (froc-ack-delivery-status crossing-ack) "delivered")
                           (eq (froc-ack-transported? crossing-ack) 1)) 256)
        (frntlive-bit (eq (frnt-ack-retains? rich live) 1) 512)
        (frntlive-bit (and (not (node_eq meaning vitality))
            (and (str_eq (frnt-lens-name meaning) "meaning")
                 (str_eq (frnt-lens-name vitality) "vitality"))) 1024)
        (frntlive-bit (str_eq (froc-persistence-status
            (froc-ack-persistence crossing-ack)) "reloaded") 2048)
        (frntlive-bit (eq (froc-ack-mesh-transported? crossing-ack) 0) 4096)
        (frntlive-bit (eq (len frames) 6) 8192)
        (frntlive-bit (and (eq (frnt-stage-index stage0) 0)
            (and (eq (frnt-stage-index stage5) 5)
                 (str_eq (frnt-stage-name stage5) "release-observed"))) 16384)
        (frntlive-bit (eq (frnt-ack-source-generated? rich) 1) 32768)
        (frntlive-bit (and (eq (frexl-result-pipeline-created? live) 1)
            (and (eq (frexl-result-wrote-bytes live) 4)
            (and (eq (frexl-result-enqueued live) 1)
            (and (gt (frexl-result-synced live) 0)
                 (eq (frexl-result-read-bytes live) 4))))) 65536)
        (frntlive-bit (eq (frnt-ack-stream-bytes rich)
                           (str_len surface)) 131072)
        (frntlive-bit (and (str_eq (frnt-ack-carrier rich) "metal")
                           (gt (str_len (frnt-ack-last-error rich)) 0)) 262144)
        (frntlive-bit (and
            (eq (frnt-trace-has? (frnt-scan-trace scan) "choice") 1)
            (and (eq (frnt-trace-has? (frnt-scan-trace scan) "cut") 1)
            (and (eq (frnt-trace-has? (frnt-scan-trace scan) "release") 1)
            (and (eq (frex-trace-has?
                        (frexl-result-lifecycle live) "choice") 1)
            (and (eq (frex-trace-has?
                        (frexl-result-lifecycle live) "release") 1)
            (and (eq (froc-trace-has?
                        (froc-ack-cross-trace crossing-ack) "choice") 1)
            (and (eq (froc-trace-has?
                        (froc-ack-cross-trace crossing-ack) "send") 1)
            (and (eq (froc-trace-has?
                        (froc-ack-cross-trace crossing-ack) "receive") 1)
                 (eq (froc-trace-has?
                        (froc-ack-cross-trace crossing-ack) "release") 1)))))))))
            524288))))
