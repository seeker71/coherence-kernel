; form-knowledge-signal-floor.fk — how much of a score could have been had
; without reading the source.
;
; WHY. On 2026-08-26 three local-finetuned rows in the control plane read
; `trained-unpromoted` against a metric named `training-validation-task-f1`.
; A trained adapter from June sits unloaded behind that number. So it matters
; a great deal whether that number can tell knowing from overlapping.
;
; It partly cannot. The evidence, computed with the body's own
; nmfe-token-f1-ppm against the sealed answers:
;
;   v312 expects "the first candidate offered".  The single word "the" scores
;        400,000 ppm — forty percent of range. The model's own corrected reply
;        scored 162,162 while carrying THREE of the four expected tokens,
;        because it was verbose. A stopword beat a mostly-right answer.
;   v323 expects "the canonical first-class nothing".  The single word
;        "nothing" scores 285,714 ppm.
;
; WHAT THE SECOND ONE IS NOT. I first read v323 as a refusal earning credit.
; It is not. The question asks what pm-match returns when no clause fits, and
; the model answered "nothing", which is substantively right and incompletely
; phrased — the row asked for the source PHRASE. So the metric there is not
; rewarding emptiness; it is scoring phrasing while the model knew. Recorded
; because the first reading was mine, was sharper-sounding, and was wrong.
;
; THE INSTRUMENT, AND WHY IT IS NAMED GUESS AND NOT REFUSAL. Fix a small set
; of generic replies CHOSEN IN ADVANCE and independent of any row — stopwords,
; bare refusals, empty. For a given expected answer, the GUESS FLOOR is the
; best score any of them earns. Then:
;
;   lift     = score - floor      the part that required the source
;   headroom = 1,000,000 - floor  the room the row leaves for evidence
;
; A row whose floor is high is a row where a generic reply scores well. That
; can happen because the metric is loose (v312) or because the answer is
; reachable from a generic vocabulary (v323). Either way the score is weak
; evidence, which is the thing a promotion gate needs to know.
;
; THIS REPORTS AND NEVER GATES. It refuses no promotion and changes no verdict.
; It makes an existing number readable — 162,162 alone looks like partial
; credit; "162,162, floor 400,000, lift -237,838" cannot be misread. Every
; number already banked becomes readable retroactively, with no model, no
; carrier and no rerun, because the floor needs only the sealed answer.
;
; THE GUESS SET IS CLOSED AND DECLARED. A floor computed over an unbounded set
; of possible replies would be a different and much larger claim; this one is
; exactly "these twelve strings, and here they are". Enlarging it can only
; raise a floor, so every lift reported here is an UPPER bound on evidence.
;
; preludes: form-stdlib/native-model-evidence.fk
;
; Proven by: form-stdlib/tests/form-knowledge-signal-floor-band.fk

(do
    ; ── the guess set: fixed, row-independent, and small enough to read ────
    (defn fksf-guesses ()
        (list "" "nothing" "unknown" "none"
              "the" "a" "an" "is" "of" "and" "it" "yes"))
    (defn fksf-guess-count () (len (fksf-guesses)))

    (defn fksf-max-loop (expected gs best)
        (if (eq (len gs) 0) best
            (do (let s (nmfe-token-f1-ppm expected (head gs)))
                (fksf-max-loop expected (tail gs)
                    (if (gt s best) s best)))))

    ; The floor asks only the sealed answer. No reply, no digest, no model.
    (defn fksf-floor (expected) (fksf-max-loop expected (fksf-guesses) 0))

    (defn fksf-headroom (expected) (sub 1000000 (fksf-floor expected)))
    (defn fksf-lift (expected score) (sub score (fksf-floor expected)))

    ; A score at or below what a guess would earn carries no evidence. Said as
    ; 0/1 rather than as a refusal: this cell decides nothing, it only answers.
    (defn fksf-evidential? (expected score)
        (if (gt (fksf-lift expected score) 0) 1 0))

    ; Which guess reached the floor — so a reader can see WHY a row is weak
    ; rather than being told that it is.
    (defn fksf-witness-loop (expected gs best out)
        (if (eq (len gs) 0) out
            (do (let s (nmfe-token-f1-ppm expected (head gs)))
                (if (gt s best)
                    (fksf-witness-loop expected (tail gs) s (head gs))
                    (fksf-witness-loop expected (tail gs) best out)))))
    (defn fksf-floor-witness (expected)
        (fksf-witness-loop expected (fksf-guesses) 0 ""))

    ; A reading of one row, as ordinary data a caller can render.
    (defn fksf-read (expected score)
        (list "signal-floor-v1" score (fksf-floor expected)
              (fksf-lift expected score) (fksf-headroom expected)
              (fksf-evidential? expected score) (fksf-floor-witness expected)))
    (defn fksf-read-score (r)      (nth r 1))
    (defn fksf-read-floor (r)      (nth r 2))
    (defn fksf-read-lift (r)       (nth r 3))
    (defn fksf-read-headroom (r)   (nth r 4))
    (defn fksf-read-evidential (r) (nth r 5))
    (defn fksf-read-witness (r)    (nth r 6))

    0)
