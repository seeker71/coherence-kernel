// relational-inquiry-metabolism.fk — one Form-native meeting cell for asking,
// giving, receiving, knowing-I, knowing-we, and building together.
// witnessed: pending first execution
//
// Retrieval channels and perspectives stay orthogonal. Any channel may answer
// any inquiry lane; the lane changes attention order rather than permission.
section [form.bml] {
    def rim-memory() = 0;
    def rim-sensed() = 1;
    def rim-subtle() = 2;
    def rim-i() = 0;
    def rim-we() = 1;
    def rim-ask() = 0;
    def rim-give() = 1;
    def rim-receive() = 2;
    def rim-know-i() = 3;
    def rim-know-we() = 4;
    def rim-build() = 5;
    // Evaluation = [freshness,lineage,certainty,clarity,resonance,trust,
    // sovereignty,vitality,I-perspective,us-perspective], each 0..1000.
    def rim-evaluation(fresh, lineage, certainty, clarity, resonance, trust, sovereignty, vitality, i-view, us-view) = [fresh, lineage, certainty, clarity, resonance, trust, sovereignty, vitality, i-view, us-view];
    def rim-score-sum(xs) = (Comparable) len(xs) == 0 ? 0 : xs[0] + rim-score-sum(xs[1:]);
    def rim-score(evaluation) = rim-score-sum(evaluation) / len(evaluation);
    // A response keeps source, value node, evaluation, and influence lineage.
    def rim-response(channel, node, evaluation, influence) = [channel, node, evaluation, influence];
    def rim-channel(r) = r[0];
    def rim-node(r) = r[1];
    def rim-eval(r) = r[2];
    def rim-influence(r) = r[3];
    // Lanes: 0 what, 1 where, 2 when, 3 who, 4 how, 5 which, 6 why.
    // Ordering is attention, not exclusion; all three channels remain offered.
    def rim-route(lane) = (Comparable) lane == 0 ? [rim-memory(), rim-sensed(), rim-subtle()] : (Comparable) lane == 1 ? [rim-sensed(), rim-memory(), rim-subtle()] : (Comparable) lane == 2 ? [rim-sensed(), rim-memory(), rim-subtle()] : (Comparable) lane == 3 ? [rim-sensed(), rim-memory(), rim-subtle()] : (Comparable) lane == 4 ? [rim-memory(), rim-sensed(), rim-subtle()] : (Comparable) lane == 5 ? [rim-memory(), rim-sensed(), rim-subtle()] : (Comparable) lane == 6 ? [rim-subtle(), rim-memory(), rim-sensed()] : [];
    def rim-find-channel(responses, channel) = (Comparable) len(responses) == 0 ? nothing() : (Comparable) rim-channel(responses[0]) == channel ? responses[0] : rim-find-channel(responses[1:], channel);
    def rim-ordered(route, responses) = (Comparable) len(route) == 0 ? [] : {
        let found = rim-find-channel(responses, route[0]);
        nothing?(found) ? rim-ordered(route[1:], responses) : cons(found, rim-ordered(route[1:], responses));
    };
    def rim-best-loop(responses, best) = (Comparable) len(responses) == 0 ? best : rim-best-loop(responses[1:], rim-score(rim-eval(responses[0])) > rim-score(rim-eval(best)) ? responses[0] : best);
    def rim-best(responses) = (Comparable) len(responses) == 0 ? nothing() : rim-best-loop(responses[1:], responses[0]);
    def rim-agreement-count(responses, node) = (Comparable) len(responses) == 0 ? 0 : ((Comparable) rim-node(responses[0]) == node ? 1 : 0) + rim-agreement-count(responses[1:], node);
    def rim-alternatives(responses, chosen) = (Comparable) len(responses) == 0 ? [] : (Comparable) rim-node(responses[0]) == chosen ? rim-alternatives(responses[1:], chosen) : cons(rim-node(responses[0]), rim-alternatives(responses[1:], chosen));
    // Trace = [movement,lane,perspective,route,response-count,chosen,
    //          agreement,alternatives,ack]. Ack is nothing/0/1/node-shaped.
    def rim-interact(movement, lane, perspective, responses) = {
        let ordered = rim-ordered(rim-route(lane), responses);
        let best = rim-best(ordered);
        nothing?(best) ? [movement, lane, perspective, rim-route(lane), 0, nothing(), 0, [], nothing()] : {
            let chosen = rim-node(best);
            let agreement = rim-agreement-count(ordered, chosen);
            let alternatives = rim-alternatives(ordered, chosen);
            let ack = agreement > 1 ? 1 : chosen;
            [movement, lane, perspective, rim-route(lane), len(ordered), chosen, agreement, alternatives, ack];
        };
    };
    def rim-ask-with(lane, perspective, responses) = rim-interact(rim-ask(), lane, perspective, responses);
    def rim-give-with(lane, perspective, responses) = rim-interact(rim-give(), lane, perspective, responses);
    def rim-receive-with(lane, perspective, responses) = rim-interact(rim-receive(), lane, perspective, responses);
    def rim-know-i-with(lane, responses) = rim-interact(rim-know-i(), lane, rim-i(), responses);
    def rim-know-we-with(lane, responses) = rim-interact(rim-know-we(), lane, rim-we(), responses);
    def rim-build-with(lane, perspective, responses) = rim-interact(rim-build(), lane, perspective, responses);
    0;
}
