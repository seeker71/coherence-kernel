//////////////////////////////////////////////////////////////////////
// lora-adapter.bml — the body reads its own adapter. A safetensors file is
// eight little-endian bytes of header length, a JSON header naming every
// tensor with dtype, shape and byte span, then the bytes. Read natively:
// the low-rank pairs, the layers they touch, the rank, the dtype, and
// whether header + spans equal the file (structurally whole, axiom-3).
// The training log's last iteration is read the same way. Applying the
// delta inside the walker's projections is the next stone; today the
// body sees the adapter it trained.
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/hearth.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormLoraAdapter {
        field LAPublisher = "voice.lora";
        def la-cat(parts) = if eq(len(parts), 0) then "" else str_concat(head(parts), la-cat(tail(parts)));
        def la-q() = byte_to_str(34);
        def la-text(t) = if nothing?(t) then "" else t;
        def la-count(text, needle, from, acc) {
            let at = str_find(text, needle, from);
            if lt(at, 0) then acc else la-count(text, needle, add(at, str_len(needle)), add(acc, 1));
        }
        def la-digit?(c) = if and(ge(c, 48), le(c, 57)) then 1 else 0;
        def la-digits-end(s, i) = if ge(i, str_len(s)) then i else if eq(la-digit?(str_byte_at(s, i)), 1) then la-digits-end(s, add(i, 1)) else i;
        def la-int-at(s, i) = if or(ge(i, str_len(s)), eq(la-digits-end(s, i), i)) then sub(0, 1) else str_to_int(substring(s, i, la-digits-end(s, i)));
        def la-int-after(s, marker, from) {
            let at = str_find(s, marker, from);
            if lt(at, 0) then sub(0, 1) else la-int-at(s, add(at, str_len(marker)));
        }
        def la-text-after(s, marker, stop) {
            let at = str_find(s, marker, 0);
            if lt(at, 0) then "" else substring(s, add(at, str_len(marker)), str_find(s, stop, add(at, str_len(marker))));
        }
        // header length: eight little-endian bytes
        def la-u64-go(bytes, i, scale, acc) = if ge(i, 8) then acc else la-u64-go(bytes, add(i, 1), mul(scale, 256), add(acc, mul(str_byte_at(bytes, i), scale)));
        def la-header-len(path) {
            let b = la-text(read_file_slice(path, 0, 8));
            if lt(str_len(b), 8) then sub(0, 1) else la-u64-go(b, 0, 1, 0);
        }
        def la-header(path) {
            let n = la-header-len(path);
            if lt(n, 0) then "" else la-text(read_file_slice(path, 8, n));
        }
        // the census over the header text
        def la-pairs(h) = la-count(h, ".lora_a" , 0, 0);
        def la-rank(h) = la-int-after(h, str_concat(str_concat(str_concat("lora_a", la-q()), ":{"), la-cat(list(la-q(), "dtype", la-q(), ":", la-q()))), 0);
        // lora_a is stored (input, rank): the rank is the second number of its shape
        def la-rank-of(h) {
            let at = str_find(h, ".lora_a", 0);
            let shape = if lt(at, 0) then sub(0, 1) else str_find(h, la-cat(list(la-q(), "shape", la-q(), ":[")), at);
            if lt(shape, 0) then sub(0, 1) else la-int-at(h, add(str_find(h, ",", shape), 1));
        }
        def la-lower(s, i, acc) = if ge(i, str_len(s)) then acc else la-lower(s, add(i, 1), str_concat(acc, byte_to_str(if and(ge(str_byte_at(s, i), 65), le(str_byte_at(s, i), 90)) then add(str_byte_at(s, i), 32) else str_byte_at(s, i))));
        def la-dtype(h) = la-lower(la-text-after(h, la-cat(list(la-q(), "dtype", la-q(), ":", la-q())), la-q()), 0, "");
        def la-max-end-go(h, from, best) {
            let at = str_find(h, la-cat(list(la-q(), "data_offsets", la-q(), ":[")), from);
            if lt(at, 0) then best else la-max-end-next(h, add(at, 17), best);
        }
        def la-max-end-next(h, i, best) {
            let comma = str_find(h, ",", i);
            let e = if lt(comma, 0) then sub(0, 1) else la-int-at(h, add(comma, 1)); la-max-end-go(h, i, if gt(e, best) then e else best);
        }
        def la-max-end(h) = la-max-end-go(h, 0, 0);
        def la-layer-go(h, from, lo, hi) {
            let at = str_find(h, "model.layers.", from);
            if lt(at, 0) then list(lo, hi) else la-layer-next(h, add(at, 13), la-int-at(h, add(at, 13)), lo, hi);
        }
        def la-layer-next(h, i, n, lo, hi) = la-layer-go(h, i, if or(lt(lo, 0), lt(n, lo)) then n else lo, if gt(n, hi) then n else hi);
        def la-layers(h) = la-layer-go(h, 0, sub(0, 1), sub(0, 1));
        def la-whole?(path) {
            let n = la-header-len(path);
            if lt(n, 0) then 0 else if eq(add(8, add(n, la-max-end(la-header(path)))), file_size(path)) then 1 else 0;
        }
        // census row: (pairs rank dtype layer-lo layer-hi bytes whole)
        def la-census(path) {
            let h = la-header(path);
            let ls = la-layers(h); list("lora-census-v1", la-pairs(h), la-rank-of(h), la-dtype(h), head(ls), nth(ls, 1), file_size(path), la-whole?(path));
        }
        // the training log's last iteration line: iter, loss text, tokens/sec
        def la-last-iter-go(log, from, best) {
            let at = str_find(log, "Iter ", from);
            if lt(at, 0) then best else la-last-iter-go(log, add(at, 5), if ge(str_find(log, "Train loss", at), 0) then at else best);
        }
        def la-last-iter-line(log) {
            let at = la-last-iter-go(log, 0, sub(0, 1));
            if lt(at, 0) then "" else substring(log, at, str_find(log, byte_to_str(10), at));
        }
        def la-iter(line) = la-int-after(line, "Iter ", 0);
        def la-loss(line) = la-text-after(line, "Train loss ", ",");
        def la-tokens-sec(line) = la-int-after(line, "Tokens/sec ", 0);
        def la-loss-label(loss) = if eq(str_len(loss), 0) then "loss-unknown" else str_concat("loss-", loss);
        def la-tags() = list("all", "we", "mesh", "voice");
        def la-samples(census, line, epoch) = list(
            fgtm-sample("voice.lora.adapter", fgtm-absent(), "lora-adapter", "form", LAPublisher(), "voice", la-cat(list("rank-", int_to_str(nth(census, 2)), "-", nth(census, 3), "-layers-", int_to_str(nth(census, 4)), "-", int_to_str(nth(census, 5)))), fgtm-present(nth(census, 6)), fgtm-present(nth(census, 1)), if eq(nth(census, 7), 1) then "stored" else "failed", fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", "safetensors.header", la-tags()),
            fgtm-sample("voice.lora.train", fgtm-absent(), "lora-train", "form", LAPublisher(), "voice", la-loss-label(la-loss(line)), fgtm-absent(), fgtm-present(if lt(la-iter(line), 0) then 0 else la-iter(line)), if eq(str_len(line), 0) then "idle" else "active", fgtm-absent(), fgtm-present(epoch), fgtm-present(if lt(la-tokens-sec(line), 0) then 0 else la-tokens-sec(line)), fgtm-absent(), "never", "physical-live", "train.log", la-tags())
        );
        def la-publish(root, census, line, epoch) = fgtm-publish-snapshot(root, LAPublisher(), epoch, la-samples(census, line, epoch));
    }
    0;
}
//////////////////////////////////////////////////////////////////////
// THE NUMBERS, AND THE WRITER. Below the header census: the body decodes
// the adapter's float32 tensors natively (sign, exponent, mantissa by
// integer arithmetic; powers of two by exact doubling), computes a
// low-rank delta B(A x) itself, and writes an adapter file in the same
// format — header JSON plus little-endian floats — that it reads back
// whole. That round trip is the LoRA writer HOMECOMING names.
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormLoraNumbers {
        def ln-pow2(n) = if eq(n, 0) then 1.0 else if gt(n, 0) then mul(2.0, ln-pow2(sub(n, 1))) else div(ln-pow2(add(n, 1)), 2.0);
        def ln-u32-le(bytes, i) = add(str_byte_at(bytes, i), add(mul(str_byte_at(bytes, add(i, 1)), 256), add(mul(str_byte_at(bytes, add(i, 2)), 65536), mul(str_byte_at(bytes, add(i, 3)), 16777216))));
        def ln-f32-decode(u) {
            let sign = if ge(u, 2147483648) then 0.0 else 1.0;
            let body = if ge(u, 2147483648) then sub(u, 2147483648) else u;
            let e = div(body, 8388608);
            let m = mod(body, 8388608);
            let mag = if eq(e, 0) then 0.0 else mul(add(1.0, div(str_to_float(int_to_str(m)), 8388608.0)), ln-pow2(sub(e, 127)));
            if eq(sign, 1.0) then mag else sub(0.0, mag);
        }
        def ln-exp-of(a, e) = if lt(a, 1.0) then ln-exp-of(mul(a, 2.0), sub(e, 1)) else if ge(a, 2.0) then ln-exp-of(div(a, 2.0), add(e, 1)) else e;
        def ln-f32-encode(x) {
            let neg = if lt(x, 0.0) then 1 else 0;
            let a = if eq(neg, 1) then sub(0.0, x) else x;
            let e = if eq(a, 0.0) then 0 else ln-exp-of(a, 0);
            let m = if eq(a, 0.0) then 0 else float_to_int(round(mul(sub(div(a, ln-pow2(e)), 1.0), 8388608.0)));
            add(mul(neg, 2147483648), add(mul(if eq(a, 0.0) then 0 else add(e, 127), 8388608), m));
        }
        def ln-u32-bytes(u) = list(mod(u, 256), mod(div(u, 256), 256), mod(div(u, 65536), 256), mod(div(u, 16777216), 256));
        def ln-floats-bytes(xs) = if eq(len(xs), 0) then list() else append(ln-u32-bytes(ln-f32-encode(head(xs))), ln-floats-bytes(tail(xs)));
        // read n floats of a tensor at byte offset `begin` past the header
        def ln-floats-go(bytes, i, n, acc) = if ge(i, mul(n, 4)) then reverse(acc) else ln-floats-go(bytes, add(i, 4), n, cons(ln-f32-decode(ln-u32-le(bytes, i)), acc));
        def ln-floats(path, hlen, begin, n) {
            let bytes = read_file_slice(path, add(8, add(hlen, begin)), mul(n, 4));
            if nothing?(bytes) then list() else if lt(str_len(bytes), mul(n, 4)) then list() else ln-floats-go(bytes, 0, n, list());
        }
        def ln-tensor-begin(h, name) {
            let at = str_find(h, str_concat(la-q(), name), 0);
            if lt(at, 0) then sub(0, 1) else la-int-after(h, la-cat(list(la-q(), "data_offsets", la-q(), ":[")), at);
        }
        def ln-dot(xs, ys) = if or(eq(len(xs), 0), eq(len(ys), 0)) then 0.0 else add(mul(head(xs), head(ys)), ln-dot(tail(xs), tail(ys)));
        def ln-norm2(xs) = ln-dot(xs, xs);
        // an adapter file: tensors as (name shape floats); header JSON then bytes
        def ln-shape-text(shape) = if eq(len(shape), 0) then "" else if eq(len(tail(shape)), 0) then int_to_str(head(shape)) else str_concat(int_to_str(head(shape)), str_concat(",", ln-shape-text(tail(shape))));
        def ln-entry(t, begin) = la-cat(list(la-q(), head(t), la-q(), ":{", la-q(), "dtype", la-q(), ":", la-q(), "F32", la-q(), ",", la-q(), "shape", la-q(), ":[", ln-shape-text(nth(t, 1)), "],", la-q(), "data_offsets", la-q(), ":[", int_to_str(begin), ",", int_to_str(add(begin, mul(4, len(nth(t, 2))))), "]}"));
        def ln-entries(ts, begin) = if eq(len(ts), 0) then "" else str_concat(ln-entry(head(ts), begin), if eq(len(tail(ts)), 0) then "" else str_concat(",", ln-entries(tail(ts), add(begin, mul(4, len(nth(head(ts), 2)))))));
        def ln-header(ts) = la-cat(list("{", ln-entries(ts, 0), "}"));
        def ln-pad(s) = if eq(mod(str_len(s), 8), 0) then s else ln-pad(str_concat(s, " "));
        def ln-text-bytes(s, i, acc) = if ge(i, str_len(s)) then reverse(acc) else ln-text-bytes(s, add(i, 1), cons(str_byte_at(s, i), acc));
        def ln-body-bytes(ts) = if eq(len(ts), 0) then list() else append(ln-floats-bytes(nth(head(ts), 2)), ln-body-bytes(tail(ts)));
        def ln-write(path, ts) {
            let h = ln-pad(ln-header(ts));
            let cleared = fs-remove-file(path);
            let wrote = host_file_append_bytes(path, append(ln-u32-bytes(str_len(h)), append(list(0, 0, 0, 0), append(ln-text-bytes(h, 0, list()), ln-body-bytes(ts)))));
            file_size(path);
        }
    }
    0;
}
