//////////////////////////////////////////////////////////////////////
// lora-adapter.bml — the body reads its own adapter. A safetensors file is
// eight little-endian bytes of header length, a JSON header naming every
// tensor with dtype, shape and byte span, then the bytes. Read natively:
// the low-rank pairs, the layers they touch, the rank, the dtype, and
// whether header + spans equal the file (structurally whole, axiom-3).
// The training log's last iteration is read the same way. Applying the
// delta inside the walker's projections is the next stone; today the
// body sees the adapter it trained.
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/hearth.bml
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormLoraAdapter {
        field LAPublisher = "voice.lora";
        def la-cat(parts) = (Comparable) len(parts) == 0 ? "" : head(parts) ++ la-cat(tail(parts));
        def la-q() = byte_to_str(34);
        def la-text(t) = t ?? "";
        def la-count(text, needle, from, acc) {
            let at = str_find(text, needle, from);
            at < 0 ? acc : la-count(text, needle, at + str_len(needle), acc + 1);
        }
        def la-digit?(c) = (c >= 48) && (c <= 57) ? 1 : 0;
        def la-digits-end(s, i) = i >= str_len(s) ? i : (Comparable) la-digit?(str_byte_at(s, i)) == 1 ? la-digits-end(s, i + 1) : i;
        def la-int-at(s, i) = (i >= str_len(s)) || ((Comparable) la-digits-end(s, i) == i) ? (0 - 1) : str_to_int(substring(s, i, la-digits-end(s, i)));
        def la-int-after(s, marker, from) {
            let at = str_find(s, marker, from);
            at < 0 ? (0 - 1) : la-int-at(s, at + str_len(marker));
        }
        def la-text-after(s, marker, stop) {
            let at = str_find(s, marker, 0);
            at < 0 ? "" : substring(s, at + str_len(marker), str_find(s, stop, at + str_len(marker)));
        }
        // header length: eight little-endian bytes
        def la-u64-go(bytes, i, scale, acc) = i >= 8 ? acc : la-u64-go(bytes, i + 1, scale * 256, acc + (str_byte_at(bytes, i) * scale));
        def la-header-len(path) {
            let b = la-text(read_file_slice(path, 0, 8));
            str_len(b) < 8 ? (0 - 1) : la-u64-go(b, 0, 1, 0);
        }
        def la-header(path) {
            let n = la-header-len(path);
            n < 0 ? "" : la-text(read_file_slice(path, 8, n));
        }
        // the census over the header text
        def la-pairs(h) = la-count(h, ".lora_a" , 0, 0);
        def la-rank(h) = la-int-after(h, (("lora_a" ++ la-q()) ++ ":{") ++ la-cat(list(la-q(), "dtype", la-q(), ":", la-q())), 0);
        // lora_a is stored (input, rank): the rank is the second number of its shape
        def la-rank-of(h) {
            let at = str_find(h, ".lora_a", 0);
            let shape = at < 0 ? (0 - 1) : str_find(h, la-cat(list(la-q(), "shape", la-q(), ":[")), at);
            shape < 0 ? (0 - 1) : la-int-at(h, str_find(h, ",", shape) + 1);
        }
        def la-lower(s, i, acc) = i >= str_len(s) ? acc : la-lower(s, i + 1, acc ++ byte_to_str((str_byte_at(s, i) >= 65) && (str_byte_at(s, i) <= 90) ? (str_byte_at(s, i) + 32) : str_byte_at(s, i)));
        def la-dtype(h) = la-lower(la-text-after(h, la-cat(list(la-q(), "dtype", la-q(), ":", la-q())), la-q()), 0, "");
        def la-max-end-go(h, from, best) {
            let at = str_find(h, la-cat(list(la-q(), "data_offsets", la-q(), ":[")), from);
            at < 0 ? best : la-max-end-next(h, at + 17, best);
        }
        def la-max-end-next(h, i, best) {
            let comma = str_find(h, ",", i);
            let e = comma < 0 ? (0 - 1) : la-int-at(h, comma + 1); la-max-end-go(h, i, e > best ? e : best);
        }
        def la-max-end(h) = la-max-end-go(h, 0, 0);
        def la-layer-go(h, from, lo, hi) {
            let at = str_find(h, "model.layers.", from);
            at < 0 ? list(lo, hi) : la-layer-next(h, at + 13, la-int-at(h, at + 13), lo, hi);
        }
        def la-layer-next(h, i, n, lo, hi) = la-layer-go(h, i, (lo < 0) || (n < lo) ? n : lo, n > hi ? n : hi);
        def la-layers(h) = la-layer-go(h, 0, 0 - 1, 0 - 1);
        def la-whole?(path) {
            let n = la-header-len(path);
            n < 0 ? 0 : (Comparable) (8 + (n + la-max-end(la-header(path)))) == file_size(path) ? 1 : 0;
        }
        // census row: (pairs rank dtype layer-lo layer-hi bytes whole)
        def la-census(path) {
            let h = la-header(path);
            let ls = la-layers(h); list("lora-census-v1", la-pairs(h), la-rank-of(h), la-dtype(h), head(ls), ls[1], file_size(path), la-whole?(path));
        }
        // the training log's last iteration line: iter, loss text, tokens/sec
        def la-last-iter-go(log, from, best) {
            let at = str_find(log, "Iter ", from);
            at < 0 ? best : la-last-iter-go(log, at + 5, str_find(log, "Train loss", at) >= 0 ? at : best);
        }
        def la-last-iter-line(log) {
            let at = la-last-iter-go(log, 0, 0 - 1);
            at < 0 ? "" : substring(log, at, str_find(log, byte_to_str(10), at));
        }
        def la-iter(line) = la-int-after(line, "Iter ", 0);
        def la-loss(line) = la-text-after(line, "Train loss ", ",");
        def la-tokens-sec(line) = la-int-after(line, "Tokens/sec ", 0);
        def la-loss-label(loss) = (Comparable) str_len(loss) == 0 ? "loss-unknown" : "loss-" ++ loss;
        def la-tags() = list("all", "we", "mesh", "voice");
        def la-samples(census, line, epoch) = list(
            fgtm-sample("voice.lora.adapter", fgtm-absent(), "lora-adapter", "form", LAPublisher(), "voice", la-cat(list("rank-", int_to_str(census[2]), "-", census[3], "-layers-", int_to_str(census[4]), "-", int_to_str(census[5]))), fgtm-present(census[6]), fgtm-present(census[1]), (Comparable) census[7] == 1 ? "stored" : "failed", fgtm-absent(), fgtm-present(epoch), fgtm-absent(), fgtm-absent(), "never", "physical-live", "safetensors.header", la-tags()),
            fgtm-sample("voice.lora.train", fgtm-absent(), "lora-train", "form", LAPublisher(), "voice", la-loss-label(la-loss(line)), fgtm-absent(), fgtm-present(la-iter(line) < 0 ? 0 : la-iter(line)), (Comparable) str_len(line) == 0 ? "idle" : "active", fgtm-absent(), fgtm-present(epoch), fgtm-present(la-tokens-sec(line) < 0 ? 0 : la-tokens-sec(line)), fgtm-absent(), "never", "physical-live", "train.log", la-tags())
        );
        def la-publish(root, census, line, epoch) = fgtm-publish-snapshot(root, LAPublisher(), epoch, la-samples(census, line, epoch));
    }
    0;
}
//////////////////////////////////////////////////////////////////////
// THE NUMBERS, AND THE WRITER. Below the header census: the body decodes
// the adapter's float32 tensors natively (sign, exponent, mantissa by
// integer arithmetic; powers of two by exact doubling), computes a
// low-rank delta B(A x) itself, and writes an adapter file in the same
// format — header JSON plus little-endian floats — that it reads back
// whole. That round trip is the LoRA writer HOMECOMING names.
//////////////////////////////////////////////////////////////////////
section [form.bml] {
    class FormLoraNumbers {
        def ln-pow2(n) = (Comparable) n == 0 ? 1.0 : n > 0 ? (2.0 * ln-pow2(n - 1)) : (ln-pow2(n + 1) / 2.0);
        def ln-u32-le(bytes, i) = str_byte_at(bytes, i) + ((str_byte_at(bytes, i + 1) * 256) + ((str_byte_at(bytes, i + 2) * 65536) + (str_byte_at(bytes, i + 3) * 16777216)));
        def ln-f32-decode(u) {
            let sign = u >= 2147483648 ? 0.0 : 1.0;
            let body = u >= 2147483648 ? (u - 2147483648) : u;
            let e = body / 8388608;
            let m = body % 8388608;
            let mag = (Comparable) e == 0 ? 0.0 : ((1.0 + ((m + 0.0) / 8388608.0)) * ln-pow2(e - 127));
            (Comparable) sign == 1.0 ? mag : (0.0 - mag);
        }
        def ln-exp-of(a, e) = a < 1.0 ? ln-exp-of(a * 2.0, e - 1) : a >= 2.0 ? ln-exp-of(a / 2.0, e + 1) : e;
        def ln-f32-encode(x) {
            let neg = x < 0.0 ? 1 : 0;
            let a = (Comparable) neg == 1 ? (0.0 - x) : x;
            let e = (Comparable) a == 0.0 ? 0 : ln-exp-of(a, 0);
            let m = (Comparable) a == 0.0 ? 0 : float_to_int(round(((a / ln-pow2(e)) - 1.0) * 8388608.0));
            (neg * 2147483648) + ((((Comparable) a == 0.0 ? 0 : (e + 127)) * 8388608) + m);
        }
        def ln-u32-bytes(u) = list(u % 256, (u / 256) % 256, (u / 65536) % 256, (u / 16777216) % 256);
        def ln-floats-bytes(xs) = (Comparable) len(xs) == 0 ? list() : append(ln-u32-bytes(ln-f32-encode(head(xs))), ln-floats-bytes(tail(xs)));
        // read n floats of a tensor at byte offset `begin` past the header
        def ln-floats-go(bytes, i, n, acc) = i >= (n * 4) ? reverse(acc) : ln-floats-go(bytes, i + 4, n, cons(ln-f32-decode(ln-u32-le(bytes, i)), acc));
        def ln-floats(path, hlen, begin, n) {
            let bytes = read_file_slice(path, 8 + (hlen + begin), n * 4);
            nothing?(bytes) ? list() : str_len(bytes) < (n * 4) ? list() : ln-floats-go(bytes, 0, n, list());
        }
        def ln-tensor-begin(h, name) {
            let at = str_find(h, la-q() ++ name, 0);
            at < 0 ? (0 - 1) : la-int-after(h, la-cat(list(la-q(), "data_offsets", la-q(), ":[")), at);
        }
        def ln-dot(xs, ys) = ((Comparable) len(xs) == 0) || ((Comparable) len(ys) == 0) ? 0.0 : ((head(xs) * head(ys)) + ln-dot(tail(xs), tail(ys)));
        def ln-norm2(xs) = ln-dot(xs, xs);
        // an adapter file: tensors as (name shape floats); header JSON then bytes
        def ln-shape-text(shape) = (Comparable) len(shape) == 0 ? "" : (Comparable) len(tail(shape)) == 0 ? int_to_str(head(shape)) : int_to_str(head(shape)) ++ "," ++ ln-shape-text(tail(shape));
        def ln-entry(t, begin) = la-cat(list(la-q(), head(t), la-q(), ":{", la-q(), "dtype", la-q(), ":", la-q(), "F32", la-q(), ",", la-q(), "shape", la-q(), ":[", ln-shape-text(t[1]), "],", la-q(), "data_offsets", la-q(), ":[", int_to_str(begin), ",", int_to_str(begin + (4 * len(t[2]))), "]}"));
        def ln-entries(ts, begin) = (Comparable) len(ts) == 0 ? "" : ln-entry(head(ts), begin) ++ ((Comparable) len(tail(ts)) == 0 ? "" : "," ++ ln-entries(tail(ts), begin + (4 * len(head(ts)[2]))));
        def ln-header(ts) = la-cat(list("{", ln-entries(ts, 0), "}"));
        def ln-pad(s) = (Comparable) (str_len(s) % 8) == 0 ? s : ln-pad(s ++ " ");
        def ln-text-bytes(s, i, acc) = i >= str_len(s) ? reverse(acc) : ln-text-bytes(s, i + 1, cons(str_byte_at(s, i), acc));
        def ln-body-bytes(ts) = (Comparable) len(ts) == 0 ? list() : append(ln-floats-bytes(head(ts)[2]), ln-body-bytes(tail(ts)));
        def ln-write(path, ts) {
            let h = ln-pad(ln-header(ts));
            let cleared = fs-remove-file(path);
            let wrote = host_file_append_bytes(path, append(ln-u32-bytes(str_len(h)), append(list(0, 0, 0, 0), append(ln-text-bytes(h, 0, list()), ln-body-bytes(ts)))));
            file_size(path);
        }
    }
    0;
}
