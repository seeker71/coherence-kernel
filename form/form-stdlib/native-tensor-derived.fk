; Form tensor recipes on native Metal. Behavior and refusals travel together.
; preludes: form-stdlib/native-tensor.bml
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/native-tensor-derived-band.fk

(do
    (defn mld-j (a b) (str_concat a (str_concat " " b)))

    (defn mld-land () "1000 mul 1 f32 2 div add i32")
    (defn mld-close (body) (mld-j body (mld-land)))

    (defn mld-neg () "-1 mul")
    (defn mld-sub () (mld-j (mld-neg) "add"))
    (defn mld-square () "dup mul")
    (defn mld-recip () "1 swap div")

    (defn mld-sigmoid () (mld-j (mld-neg) (mld-j "exp 1 add" (mld-recip))))
    (defn mld-silu () (mld-j "dup" (mld-j (mld-sigmoid) "mul")))
    (defn mld-swiglu () (mld-j (mld-silu) "mul"))
    (defn mld-tanh () (mld-j "2 mul exp dup 1" (mld-j (mld-sub) "swap 1 add div")))

    (defn mld-scale (s) (mld-j s "mul"))
    (defn mld-axpy () "mul add")
    (defn mld-min (h) (mld-j (mld-neg) (mld-j h (mld-j "-1 mul max" (mld-neg)))))
    (defn mld-clamp (lo hi) (mld-j lo (mld-j "max" (mld-min hi))))
    (defn mld-gelu-z ()
        "dup dup dup mul 44715 f32 1000000 div mul 1 f32 add mul 797884561 f32 1000000000 div mul")
    (defn mld-gelu ()
        (mld-j (mld-gelu-z) (mld-j (mld-tanh) "1 f32 add mul 1 f32 2 div mul")))

    (defn mld-mean (n) (mld-j "sum" (mld-j (int_to_str n) "div")))
    (defn mld-rmsnorm (n) (mld-j "dup dup mul" (mld-j (mld-mean n) "rsqrt mul")))
    (defn mld-l2norm () "dup dup mul sum rsqrt mul")
    (defn mld-centre (n) (mld-j "dup" (mld-j (mld-mean n) (mld-j (mld-neg) "add"))))
    (defn mld-layernorm (n) (mld-j (mld-centre n) (mld-rmsnorm n)))
    (defn mld-softmax () (mld-j "dup rmax" (mld-j (mld-neg) "add exp dup sum div")))

    (defn mld-attn-scores (kfrag) (mld-j kfrag "matmul"))
    (defn mld-attn (kfrag vfrag)
        (mld-j (mld-attn-scores kfrag) (mld-j (mld-softmax) (mld-j vfrag "matmul"))))

    (defn mld-rope-pair (afrag)
        (mld-j "dup v2 1 0 take v2 -1 1 f32 mul"
        (mld-j afrag (mld-j "sin mul swap" (mld-j afrag "cos mul add")))))

    (defn mld-p-sub () (mld-j "7 3" (mld-j (mld-sub) "i32")))
    (defn mld-p-neg () (mld-j "5" (mld-j (mld-neg) "i32")))
    (defn mld-p-square () (mld-j "6" (mld-j (mld-square) "i32")))
    (defn mld-p-recip () (mld-close (mld-j "4 f32" (mld-recip))))
    (defn mld-p-sigmoid () (mld-close (mld-j "0 f32" (mld-sigmoid))))
    (defn mld-p-silu () (mld-close (mld-j "0 f32" (mld-silu))))
    (defn mld-p-tanh () (mld-close (mld-j "0 f32" (mld-tanh))))
    (defn mld-p-swiglu () (mld-close (mld-j "6 f32 0 f32" (mld-swiglu))))
    (defn mld-p-gated () (mld-close (mld-j "6 f32 0 f32" (mld-j (mld-sigmoid) "mul"))))
    (defn mld-p-mean () (mld-close (mld-j "v4 1 2 3 4 f32" (mld-mean 4))))
    (defn mld-p-l2norm () (mld-close (mld-j "v2 3 4 f32" (mld-j (mld-l2norm) "sum"))))
    (defn mld-p-rmsnorm () (mld-close (mld-j "v2 3 3 f32" (mld-j (mld-rmsnorm 2) "sum"))))
    (defn mld-p-softmax () (mld-close (mld-j "v2 1 1 f32" (mld-j (mld-softmax) "sum"))))
    (defn mld-p-matmul () (mld-close "v4 1 2 3 4 f32 r2 2 2 dup matmul sum"))
    (defn mld-p-take () "v4 10 20 30 40 v1 2 take sum i32")
    (defn mld-p-argmax () "v4 1 9 3 4 argmax i32")

    (defn mld-pow () "swap log mul exp")           ; a^b : stack [b, a]
    (defn mld-where () "dup 7 mul swap 1 swap -1 mul add 9 mul add")
    (defn mld-mod (n) (mld-j "dup" (mld-j (int_to_str n) (mld-j "div i32" (mld-j (int_to_str n) (mld-j "mul" (mld-sub)))))))

    (defn mld-p-sin () (mld-close "0 f32 sin"))
    (defn mld-p-cos () (mld-close "0 f32 cos"))
    (defn mld-p-log () (mld-close "1 f32 log"))
    (defn mld-p-pow () (mld-close (mld-j "2 f32 3" (mld-pow))))
    (defn mld-p-gt () "5 3 gt i32")
    (defn mld-p-iota () "5 iota sum i32")
    (defn mld-p-where () (mld-j "1 0 gt i32" (mld-j (mld-where) "i32")))
    (defn mld-p-mod () (mld-j "17" (mld-j (mld-mod 5) "i32")))

    (defn mld-p-scale () (mld-close (mld-j "7 f32" (mld-scale "3"))))
    (defn mld-p-axpy () (mld-close (mld-j "7 f32 3 4" (mld-axpy))))
    (defn mld-p-clamp () (mld-j "5" (mld-j (mld-clamp "0" "3") "i32")))
    (defn mld-p-clamp-lo () (mld-j "-2" (mld-j (mld-clamp "0" "3") "i32")))
    (defn mld-p-gelu () (mld-j "1 f32" (mld-j (mld-gelu) "1000 mul i32")))
    (defn mld-p-layernorm () (mld-j "v4 1 2 3 4 f32" (mld-j (mld-layernorm 4) "dup mul sum 1000 mul i32")))

    (defn mld-run (p) (nt-eval p))

    (defn mld-check ()
        (add (if (eq (mld-run (mld-p-sub)) 4) 1 0)
        (add (if (eq (mld-run (mld-p-neg)) (sub 0 5)) 2 0)
        (add (if (eq (mld-run (mld-p-square)) 36) 4 0)
        (add (if (eq (mld-run (mld-p-recip)) 250) 8 0)
        (add (if (eq (mld-run (mld-p-sigmoid)) 500) 16 0)
        (add (if (eq (mld-run (mld-p-silu)) 0) 32 0)
        (add (if (eq (mld-run (mld-p-tanh)) 0) 64 0)
        (add (if (eq (mld-run (mld-p-swiglu)) 0) 128 0)
        (add (if (eq (mld-run (mld-p-mean)) 2500) 256 0)
        (add (if (eq (mld-run (mld-p-l2norm)) 1400) 512 0)
        (add (if (eq (mld-run (mld-p-rmsnorm)) 2000) 1024 0)
        (add (if (eq (mld-run (mld-p-softmax)) 1000) 2048 0)
        (add (if (eq (mld-run (mld-p-matmul)) 54000) 4096 0)
        (add (if (eq (mld-run (mld-p-take)) 30) 8192 0)
        (add (if (eq (mld-run (mld-p-argmax)) 1) 16384 0)
        (add (if (eq (mld-run (mld-p-gated)) 3000) 32768 0)
        (add (if (eq (mld-run (mld-p-sin)) 0) 65536 0)
        (add (if (eq (mld-run (mld-p-cos)) 1000) 131072 0)
        (add (if (eq (mld-run (mld-p-log)) 0) 262144 0)
        (add (if (eq (mld-run (mld-p-pow)) 8000) 524288 0)
        (add (if (eq (mld-run (mld-p-gt)) 1) 1048576 0)
        (add (if (eq (mld-run (mld-p-iota)) 10) 2097152 0)
        (add (if (eq (mld-run (mld-p-where)) 7) 4194304 0)
        (add (if (eq (mld-run (mld-p-mod)) 2) 8388608 0)
        (add (if (eq (mld-run (mld-p-scale)) 21000) 16777216 0)
        (add (if (eq (mld-run (mld-p-axpy)) 19000) 33554432 0)
        (add (if (eq (mld-run (mld-p-clamp)) 3) 67108864 0)
        (add (if (eq (mld-run (mld-p-clamp-lo)) 0) 134217728 0)
        (add (if (eq (mld-run (mld-p-gelu)) 841) 268435456 0)
             (if (eq (mld-run (mld-p-layernorm)) 3999) 536870912 0)))))))))))))))))))))))))))))))
    0)
