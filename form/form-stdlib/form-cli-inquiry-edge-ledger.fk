// form-cli-inquiry-edge-ledger.fk — one persistent validated learned-edge slot.
//
// This is the smallest vertical replacement path for source-authored inquiry rows:
// `fciel-learn` validates an observed edge, persists structured state, and a later
// process reloads it through `fciel-augment`. The slot can be replaced by the next
// validated observation; static rows remain as the bootstrap while this grows.
// State schema: edge-v1\nSS,RR,TT\n (two decimal digits per field).
// witnessed: 2026-07-22 -> learned 08,01,05; 10->11 edges; reload changed 0 to node
section [form.bml] {
    def fciel-path() = ".form-native-inquiry-edges.tsv";
    def fciel-two(n) = str_concat(byte_to_str(48 + n / 10), byte_to_str(48 + n % 10));
    def fciel-number(text, pos) = (str_byte_at(text, pos) - 48) * 10 + (str_byte_at(text, pos + 1) - 48);
    def fciel-edge(s, r, t) = [s, r, t, 3];
    def fciel-valid-fields?(s, r, t) = s >= 1 && s <= 12 ? (Comparable) r == 1 ? t >= 1 && t <= 12 ? 1 : 0 : 0 : 0;
    def fciel-valid-state?(text) = (Comparable) str_len(text) == 17 ? (Comparable) str_byte_at(text, 0) == 101 ? fciel-valid-fields?(fciel-number(text, 8), fciel-number(text, 11), fciel-number(text, 14)) : 0 : 0;
    def fciel-load() = {
        let text = read_file(fciel-path());
        (Comparable) fciel-valid-state?(text) == 1 ? fciel-edge(fciel-number(text, 8), fciel-number(text, 11), fciel-number(text, 14)) : nothing();
    };
    def fciel-augment(bootstrap) = {
        let learned = fciel-load();
        nothing?(learned) ? bootstrap : cons(learned, bootstrap);
    };
    def fciel-learn(s, r, t) = (Comparable) fciel-valid-fields?(s, r, t) == 0 ? nothing() : {
        let row = str_concat("edge-v1\n", str_concat(fciel-two(s), str_concat(",", str_concat(fciel-two(r), str_concat(",", str_concat(fciel-two(t), "\n"))))));
        let wrote = write_file(fciel-path(), row);
        (Comparable) wrote == str_len(row) ? 1 : 0;
    };
    def fciel-reset() = write_file(fciel-path(), "");
}
