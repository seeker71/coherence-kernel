// text-summary-learning.fk - Form-native text summarizer learning lane.
//
// Floor: source text, summary claims, citations, quality metrics, spectrum
// metadata, oracle evidence requests, and CHOICE-RECEIPT outcomes are explicit
// Form rows. A cell can learn summary intent, choose a summary candidate, refuse
// below-floor summaries, and turn successful receipts back into native training
// samples without a Python carrier or ambient LLM authority. The source
// floor can read a file through kernel-native file natives,
// verify byte slices as citations, and bind those citations to a summary receipt.
// It also names typed file/store/route/stream source coordinates, production
// front-door telemetry rows, and producer pacing against backpressure so each
// new carrier can land as the same receipt shape instead of a parallel summarizer.
//
// North star: summarization becomes a native two-way teaching channel. Text,
// code, proof logs, runtime events, dialogue, and memory cells lower through
// typed summary grammars; local LLMs, remote committees, source search, and
// optional humans are teachers; the Form-native candidate wins lane by lane when
// it reaches enough factuality, coverage, confidence, sovereignty, trust, and
// aliveness with fewer LLM tokens, less energy, and less nutrition.
//
section [form.bml] {
    def tsl-floor() = ["source, summary, citation, quality, metadata, receipt, and oracle rows are Form data", "a summary passes only with coverage, factuality, citations, compression, confidence, trust, sovereignty, and no contradiction", "successful summary receipts become native training samples", "real source files can be read through kernel-native file natives and cited by byte slice", "file, file-backed store, socket-served route telemetry traces, production front-door telemetry rows, and backpressure-aware stream windows with producer pacing plus ack/replay can emit the same coordinate receipt shape"];
    def tsl-north-star() = ["native summary grammars and kernels summarize text, code, proof logs, runtime events, dialogue, and memory cells", "external LLMs and source-search lanes are teachers until Form-native summaries win heldout receipts", "the winning summary candidate uses fewer tokens and less energy while carrying more sovereignty, trust, and aliveness", "file, store, route, and stream sources lower into claim spans without host-tool execution", "every source carrier produces coordinate receipts with dynamic locators, selectors, offsets, lengths, codecs, capability gates, public-front-door telemetry, and live producer pacing receipts"];
    def tsl-spectrum(token-frequency, meaning-impact, expression-rhythm, uncertainty, novelty, source-grounding) = [token-frequency, meaning-impact, expression-rhythm, uncertainty, novelty, source-grounding];
    def tsl-spectrum-token-frequency(spectrum) = spectrum[0];
    def tsl-spectrum-meaning-impact(spectrum) = spectrum[1];
    def tsl-spectrum-expression-rhythm(spectrum) = spectrum[2];
    def tsl-spectrum-uncertainty(spectrum) = spectrum[3];
    def tsl-spectrum-novelty(spectrum) = spectrum[4];
    def tsl-spectrum-source-grounding(spectrum) = spectrum[5];
    def tsl-meta(conviction, confidence, mood, expression, spectrum, sovereignty, trust, aliveness) = [conviction, confidence, mood, expression, spectrum, sovereignty, trust, aliveness];
    def tsl-meta-conviction(meta) = meta[0];
    def tsl-meta-confidence(meta) = meta[1];
    def tsl-meta-mood(meta) = meta[2];
    def tsl-meta-expression(meta) = meta[3];
    def tsl-meta-spectrum(meta) = meta[4];
    def tsl-meta-sovereignty(meta) = meta[5];
    def tsl-meta-trust(meta) = meta[6];
    def tsl-meta-aliveness(meta) = meta[7];
    def tsl-meta-floor?(meta) = tsl-meta-conviction(meta) >= 70 && (tsl-meta-confidence(meta) >= 70 && (tsl-meta-sovereignty(meta) >= 70 && (tsl-meta-trust(meta) >= 70 && (tsl-meta-aliveness(meta) >= 70 && tsl-spectrum-meaning-impact(tsl-meta-spectrum(meta)) >= 70)))) ? 1 : 0;
    def tsl-source(source-id, token-count, source-claims, source-citations, modality, floor, north-star) = [source-id, token-count, source-claims, source-citations, modality, floor, north-star];
