    def tsl-candidate-trust(candidate) = candidate[9];
    def tsl-candidate-ready?(candidate) = tsl-candidate-coverage(candidate) >= 80 && (tsl-candidate-factuality(candidate) >= 80 && (tsl-candidate-confidence(candidate) >= 70 && (tsl-candidate-sovereignty(candidate) >= 70 && tsl-candidate-trust(candidate) >= 70))) ? 1 : 0;
    def tsl-candidate-lower-cost?(candidate, best) = tsl-candidate-tokens(best) > tsl-candidate-tokens(candidate) ? 1 : (Comparable) tsl-candidate-tokens(best) == tsl-candidate-tokens(candidate) ? tsl-candidate-energy(best) > tsl-candidate-energy(candidate) ? 1 : (Comparable) tsl-candidate-energy(best) == tsl-candidate-energy(candidate) ? tsl-candidate-nutrition(best) > tsl-candidate-nutrition(candidate) ? 1 : 0 : 0 : 0;
    def tsl-winner-loop(candidates, best) = (Comparable) len(candidates) == 0 ? best : (Comparable) tsl-candidate-ready?(head(candidates)) == 1 ? (Comparable) len(best) == 0 ? tsl-winner-loop(tail(candidates), head(candidates)) : (Comparable) tsl-candidate-lower-cost?(head(candidates), best) == 1 ? tsl-winner-loop(tail(candidates), head(candidates)) : tsl-winner-loop(tail(candidates), best) : tsl-winner-loop(tail(candidates), best);
    def tsl-winner(candidates) = tsl-winner-loop(candidates, empty());
    def tsl-summary-candidates() = [tsl-candidate("remote:model-committee", "remote-llm-teacher", 2600, 80, 80, 95, 95, 92, 55, 76), tsl-candidate("ollama:local", "local-llm-teacher", 900, 42, 42, 88, 86, 83, 78, 78), tsl-candidate("form-native:summary", "native-candidate", 160, 12, 12, 86, 84, 81, 92, 84), tsl-candidate("human:optional", "human-teacher", 0, 20, 20, 90, 90, 90, 40, 90)];
    def tsl-choice-candidate-row(candidate, category) = cr-choice-candidate(tsl-candidate-path(candidate), category, true, 0, tsl-candidate-confidence(candidate), "summary-candidate-receipt");
