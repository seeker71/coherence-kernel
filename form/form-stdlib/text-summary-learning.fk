    def tsl-summary-receipt(selected, meta, token-cost) = cr-choice-receipt("summarize-source-with-citations", "text-summary-learning", "summary-choice", tsl-choice-candidate-rows(tsl-summary-candidates(), "summary-choice"), selected, cr-outcome-success(), tsl-meta-confidence(meta), tsl-choice-value(meta), "selected summary carried citations, coverage, factuality, and native metadata", "text-summary-learning", "form/form-stdlib/text-summary-learning.fk", 20260614, token-cost, cr-choice-trace(4, 1, 0, 0));
    def tsl-receipt-feature(receipt) = [cr-receipt-certainty(receipt), cr-receipt-cost(receipt), cr-trace-attempts(cr-receipt-trace(receipt)), cr-trace-successes(cr-receipt-trace(receipt)), cr-trace-failures(cr-receipt-trace(receipt)), cr-trace-silences(cr-receipt-trace(receipt))];
