    def tsl-summary-pass?(summary) = tsl-summary-claims(summary) > 0 && (tsl-summary-citations(summary) > 0 && (tsl-summary-compression(summary) >= 50 && (tsl-summary-factuality(summary) >= 80 && (tsl-summary-coverage(summary) >= 80 && ((Comparable) tsl-summary-contradiction(summary) == 0 && (tsl-summary-confidence(summary) >= 70 && (Comparable) tsl-meta-floor?(tsl-summary-meta(summary)) == 1)))))) ? 1 : 0;
    def tsl-summary-feature(summary) = [tsl-summary-coverage(summary), tsl-summary-factuality(summary), tsl-summary-citations(summary), (Comparable) tsl-summary-contradiction(summary) == 0 ? 100 : 0, tsl-summary-compression(summary), tsl-summary-confidence(summary), tsl-meta-sovereignty(tsl-summary-meta(summary)), tsl-meta-trust(tsl-summary-meta(summary)), tsl-meta-aliveness(tsl-summary-meta(summary))];
    def tsl-sample(label, feature, lane) = [label, feature, lane];
    def tsl-label(sample) = sample[0];
    def tsl-feature(sample) = sample[1];
    def tsl-lane(sample) = sample[2];
    def tsl-exemplar(sample) = [tsl-label(sample), tsl-feature(sample)];
    def tsl-learn-sample(sample, model) = cons(tsl-exemplar(sample), model);
    def tsl-learn-stream(samples, model) = (Comparable) len(samples) == 0 ? model : tsl-learn-stream(tail(samples), tsl-learn-sample(head(samples), model));
    def tsl-device(samples) = tsl-learn-stream(samples, empty());
    def tsl-source-doc-feature() = [9, 1, 1, 0, 2, 1];
    def tsl-proof-log-feature() = [1, 9, 1, 0, 2, 1];
    def tsl-runtime-event-feature() = [1, 1, 9, 0, 2, 1];
    def tsl-dialogue-feature() = [1, 0, 1, 9, 2, 1];
    def tsl-summary-samples() = [tsl-sample("summary:source-doc", tsl-source-doc-feature(), "text:source-doc"), tsl-sample("summary:proof-log", tsl-proof-log-feature(), "text:proof-log"), tsl-sample("summary:runtime-events", tsl-runtime-event-feature(), "text:runtime-events"), tsl-sample("summary:dialogue", tsl-dialogue-feature(), "text:dialogue")];
    def tsl-summary-model() = tsl-device(tsl-summary-samples());
    def tsl-row(feature, label) = [feature, label];
    def tsl-row-feature(row) = row[0];
    def tsl-row-label(row) = row[1];
    def tsl-pair(model, row) = [ns-label(tsl-row-feature(row), model), tsl-row-label(row)];
    def tsl-eval(model, rows) = (Comparable) len(rows) == 0 ? empty() : cons(tsl-pair(model, head(rows)), tsl-eval(model, tail(rows)));
    def tsl-correct(model, rows) = ce-correct(tsl-eval(model, rows));
    def tsl-candidate(path, teacher, llm-tokens, energy, nutrition, coverage, factuality, confidence, sovereignty, trust) = [path, teacher, llm-tokens, energy, nutrition, coverage, factuality, confidence, sovereignty, trust];
    def tsl-candidate-path(candidate) = candidate[0];
    def tsl-candidate-teacher(candidate) = candidate[1];
    def tsl-candidate-tokens(candidate) = candidate[2];
    def tsl-candidate-energy(candidate) = candidate[3];
    def tsl-candidate-nutrition(candidate) = candidate[4];
    def tsl-candidate-coverage(candidate) = candidate[5];
