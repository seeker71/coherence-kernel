    def tsl-plan-request(request) = (String) request == "text:summarize-file" ? tsl-plan("summary/plan", request, "host:file", "cap.host.file.read", "read_file+read_file_slice", "file size, text length, prefix, and citation slices must match before learning", "native source grammar extracts claim spans directly from file, store, route, or stream sources") : (String) request == "text:summarize-store" ? tsl-plan("summary/plan", request, "store:query", "cap.store.query", "cell-log-store:cls-get+read_file_slice", "store query returns a value receipt before summary learning", "kernel-owned stores emit source claim spans with snapshot ids and rollback receipts") : (String) request == "text:summarize-route" ? tsl-plan("summary/plan", request, "kernel:route", "cap.kernel.route.read", "socket:kh-serve-listener+production-front-door-telemetry-trace", "route body, status, router header, wire bytes, request bytes, telemetry timing, and public front-door sample rows must match before summary learning", "kernel routes feed summary claim spans from socket-served response bodies, headers, production telemetry trace, authority rows, and live route pressure") : (String) request == "text:summarize-stream" ? tsl-plan("summary/plan", request, "stream:read", "cap.stream.read", "channel:read-since+pressure-window+ack-replay+producer-pacing", "stream window summaries require ordered event payloads, cursor counts, capacity, deferred-count, ack, replay, and producer pacing receipts", "ordered events lower into summary claim spans with cursor, backpressure, ack, replay, producer pacing, and adaptive publish-rate receipts") : (String) request == "text:summarize" ? tsl-plan("summary/plan", request, "kernel:call", "cap.summary.receipt", "text-summary-learning", "quality gates plus CHOICE-RECEIPT before learning", "native summary grammar and kernel candidate wins heldout lanes") : tsl-plan("summary/no-plan", request, "none", "none", "none", "unknown summary request refused", "add a typed request row before execution");
