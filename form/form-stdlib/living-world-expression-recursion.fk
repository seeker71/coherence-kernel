; living-world-expression-recursion.fk -- outcomes may ask to become new
; structural evidence or new enquiry, never automatic truth.
;
; A participant first offers an exact reflection of one current admitted
; expression application.  ONE confirms the locally derived output, ZERO
; offers a structurally compatible correction, NOTHING retains immediate
; silence, and NODE may carry an explicit alternative.  Declaration, live
; lens layers, alternatives, unknowable remainder, choice, and sender-authored
; timeout remain independently optional.
;
; The reflection crosses its own dependency-holder membrane.  A bearing
; reflection then crosses another membrane before its exact input/observed
; correspondence can enter structural recurrence.  Because admitted emergent
; correspondence candidates are ordinary resonance evidence, two or more
; distinct reflected applications may grow a reusable mapping; that mapping
; can compose again without a fixed grammar or a special depth limit.
;
; An unsettled admitted reflection also proposes an enquiry focus governed by
; the same holders.  The field scans every reflection and retains zero, one,
; or many focus proposals; no content order, score, or hidden primary chooses
; among them.  Existing enquiry membranes still govern questions and answers.
;
; Honest floor: participants still offer observations and acknowledgments.
; This organ grows structural composition and attention, not general syntax,
; semantics, autonomous goals, or unrestricted natural-language generation.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-resonance-proposal.fk form-stdlib/living-world-resonance-application.fk form-stdlib/living-world-expression-blueprint.fk form-stdlib/living-world-expression-composition.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk

(let LWX-RECURSION-REFLECTION            (bp "LWX-RECURSION-REFLECTION"))
(let LWX-RECURSION-REFLECTION-ORIGIN     (bp "LWX-RECURSION-REFLECTION-ORIGIN"))
(let LWX-RECURSION-CORRESPONDENCE-ORIGIN (bp "LWX-RECURSION-CORRESPONDENCE-ORIGIN"))
(let LWX-RECURSION-FOCUS-ORIGIN          (bp "LWX-RECURSION-FOCUS-ORIGIN"))

; children: admitted application candidate, observed result, immediate ack,
; optional live declaration, alternatives, optional unknown, optional choice,
; optional timeout, offered evidence, local path
(defn lwxr-reflection
    (application-candidate observed ack declaration alternatives unknown choice
     timeout evidence)
    (intern_node LWX-RECURSION-REFLECTION
        (list application-candidate observed ack declaration alternatives
              unknown choice timeout evidence (lwo-local-path))))
(defn lwxr-reflection? (cell)
    (lwo-category? cell LWX-RECURSION-REFLECTION))
(defn lwxr-reflection-application-candidate (reflection)
    (nth (node_children reflection) 0))
(defn lwxr-reflection-observed (reflection)
    (nth (node_children reflection) 1))
(defn lwxr-reflection-ack (reflection)
    (nth (node_children reflection) 2))
(defn lwxr-reflection-declaration (reflection)
    (nth (node_children reflection) 3))
(defn lwxr-reflection-alternatives (reflection)
    (nth (node_children reflection) 4))
(defn lwxr-reflection-unknown (reflection)
    (nth (node_children reflection) 5))
(defn lwxr-reflection-choice (reflection)
    (nth (node_children reflection) 6))
(defn lwxr-reflection-timeout (reflection)
    (nth (node_children reflection) 7))
(defn lwxr-reflection-evidence (reflection)
    (nth (node_children reflection) 8))
(defn lwxr-reflection-path (reflection)
    (nth (node_children reflection) 9))

(defn lwxr-reflection-application (reflection)
    (lwo-emergent-shape
        (lwxr-reflection-application-candidate reflection)))
(defn lwxr-reflection-derivation (reflection)
    (lwxc-application-derivation
        (lwxr-reflection-application reflection)))
(defn lwxr-reflection-input (reflection)
    (lwxc-derivation-input (lwxr-reflection-derivation reflection)))
(defn lwxr-reflection-expected (reflection)
    (lwxc-derivation-output (lwxr-reflection-derivation reflection)))

(defn lwxr-shape-compatible? (expected observed)
    (if (or (node_eq expected (lwo-none))
            (node_eq observed (lwo-none))) 0
        (if (and (node_eq (node_category expected) (node_category observed))
                 (eq (len (node_children expected))
                     (len (node_children observed)))) 1 0)))

(defn lwxr-node-observed (ack)
    (if (eq (oac-alternative-ack? ack) 1)
        (oac-alternative-offered (oac-payload ack))
        (oac-payload ack)))

(defn lwxr-reflection-ack-coherent? (reflection)
    (do
        (let ack (lwxr-reflection-ack reflection))
        (let expected (lwxr-reflection-expected reflection))
        (let observed (lwxr-reflection-observed reflection))
        (if (eq (oac-one? ack) 1)
            (if (and (node_eq observed expected)
                     (node_eq (oac-payload ack) observed)) 1 0)
            (if (eq (oac-zero? ack) 1)
                (if (and (eq (lwxr-shape-compatible?
                                expected observed) 1)
                         (not (node_eq expected observed))) 1 0)
                (if (eq (oac-nothing? ack) 1)
                    (if (node_eq observed (lwo-none)) 1 0)
                    (if (eq (oac-node? ack) 1)
                        (if (and (eq (lwxr-shape-compatible?
                                        expected observed) 1)
                                 (node_eq observed
                                    (lwxr-node-observed ack))) 1 0)
                        0))))))

(defn lwxr-optional-declaration-current? (world declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-current? world declaration)))
(defn lwxr-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwxr-optional-timeout-valid? (timeout)
    (if (or (node_eq timeout (lwo-none))
            (eq (oac-timeout-valid? timeout) 1)) 1 0))

(defn lwxr-reflection-shape-valid? (world reflection)
    (if (and (eq (lwxr-reflection? reflection) 1)
             (and (eq (oac-valid-ack?
                            (lwxr-reflection-ack reflection)) 1)
                  (and (eq (lwxr-reflection-ack-coherent?
                                reflection) 1)
                       (and (eq (lwxr-optional-declaration-current?
                                    world
                                    (lwxr-reflection-declaration
                                        reflection)) 1)
                            (and (eq (lwo-category?
                                        (lwxr-reflection-alternatives
                                            reflection) LWO-FIELD) 1)
                                 (and (eq (lwxr-optional-unknown-valid?
                                            (lwxr-reflection-unknown
                                                reflection)) 1)
                                      (and (eq (lwlc-choice-valid?
                                            (lwxr-reflection-choice
                                                reflection)) 1)
                                           (eq (lwxr-optional-timeout-valid?
                                                (lwxr-reflection-timeout
                                                    reflection)) 1))))))))
        1 0))

(defn lwxr-reflection-valid? (world reflection)
    (if (and (eq (lwxr-reflection-shape-valid? world reflection) 1)
             (eq (lwxc-application-integrated-current? world
                    (lwxr-reflection-application-candidate reflection)) 1))
        1 0))

(defn lwxr-reflection-current? (world reflection)
    (if (and (eq (lwo-active? world reflection) 1)
             (eq (lwxr-reflection-valid? world reflection) 1)) 1 0))

(defn lwxr-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwxr-field-union-items (tail items)
            (lwo-field-add field (head items)))))

(defn lwxr-reflection-witnesses (world reflection)
    (do
        (let from-reflection
            (lwo-active-attributions-for world reflection))
        (let from-application-authority
            (lwxr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwxr-reflection-application-candidate reflection)))
                from-reflection))
        (let from-application-witnesses
            (lwxr-field-union-items
                (lwo-field-items
                    (lwo-emergent-witnesses
                        (lwxr-reflection-application-candidate reflection)))
                from-application-authority))
        (if (node_eq (lwxr-reflection-declaration reflection) (lwo-none))
            from-application-witnesses
            (lwxr-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world
                        (lwxr-reflection-declaration reflection)))
                from-application-witnesses))))

(defn lwxr-reflection-origin (reflection witnesses)
    (intern_node LWX-RECURSION-REFLECTION-ORIGIN
        (list reflection witnesses)))

(defn lwxr-reflection-proposal (world reflection)
    (if (eq (lwxr-reflection-current? world reflection) 0) (lwo-none)
        (do
            (let witnesses (lwxr-reflection-witnesses world reflection))
            (let count (lwo-field-size witnesses))
            (let origin (lwxr-reflection-origin reflection witnesses))
            (let candidate
                (lwo-emergent reflection witnesses
                    (intern_trivial_int 1)
                    (intern_trivial_int 1)
                    (intern_trivial_int count) origin))
            (lwt-proposal candidate
                (lwt-sources-from-attributions
                    (lwo-field-items witnesses) (lwo-empty-field))
                origin))))

(defn lwxr-reflection-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwxr-reflection?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwxr-reflection-candidate-current? (world candidate)
    (if (eq (lwxr-reflection-candidate? candidate) 0) 0
        (do
            ; Once admitted, a reflection remains a historical observation
            ; while its exact witness attributions remain live.  New evidence
            ; may reopen the old application conclusion without erasing this
            ; observation.  Upstream revocation still propagates because the
            ; application witnesses are embedded in the candidate membrane.
            (let reflection (lwo-emergent-shape candidate))
            (if (and (eq (lwo-active? world candidate) 1)
                     (and (eq (lwo-emergent-ready? world candidate) 1)
                          (and (eq (lwo-active? world reflection) 1)
                               (eq (lwxr-reflection-shape-valid?
                                    world reflection) 1)))) 1 0))))

(defn lwxr-integrate-reflection (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwxr-reflection-candidate? candidate) 0)
            (lwt-round (lwt-round-world round)
                (lwt-round-proposals round) (lwo-empty-field) round)
            (do
                (let current
                    (lwxr-reflection-proposal
                        (lwt-round-world round)
                        (lwo-emergent-shape candidate)))
                (if (or (node_eq current (lwo-none))
                        (not (node_eq candidate
                            (lwt-proposal-candidate current))))
                    (lwt-round (lwt-round-world round)
                        (lwt-round-proposals round)
                        (lwo-empty-field) round)
                    (lwt-integrate round proposal action))))))

(defn lwxr-reflection-bearing? (world candidate)
    (if (eq (lwxr-reflection-candidate-current? world candidate) 0) 0
        (do
            (let reflection (lwo-emergent-shape candidate))
            (if (and (eq (oac-nothing?
                            (lwxr-reflection-ack reflection)) 0)
                     (not (node_eq
                        (lwxr-reflection-observed reflection)
                        (lwo-none)))) 1 0))))

; --- a governed outcome may become ordinary recurrence evidence ------

(defn lwxr-correspondence-origin
    (reflection-candidate correspondence witnesses)
    (intern_node LWX-RECURSION-CORRESPONDENCE-ORIGIN
        (list reflection-candidate correspondence witnesses)))

(defn lwxr-correspondence-proposal (world reflection-candidate)
    (if (eq (lwxr-reflection-bearing?
                world reflection-candidate) 0) (lwo-none)
        (do
            (let reflection (lwo-emergent-shape reflection-candidate))
            (let correspondence
                (lwr-correspondence
                    (lwxr-reflection-input reflection)
                    (lwxr-reflection-observed reflection)))
            (let witnesses
                (lwxr-field-union-items
                    (lwo-field-items
                        (lwo-emergent-witnesses reflection-candidate))
                    (lwo-active-attributions-for
                        world reflection-candidate)))
            (let count (lwo-field-size witnesses))
            (let origin
                (lwxr-correspondence-origin
                    reflection-candidate correspondence witnesses))
            (let candidate
                (lwo-emergent correspondence witnesses
                    (intern_trivial_int 1)
                    (intern_trivial_int 1)
                    (intern_trivial_int count) origin))
            (lwt-proposal candidate
                (lwt-sources-from-attributions
                    (lwo-field-items witnesses) (lwo-empty-field))
                origin))))

(defn lwxr-correspondence-origin? (origin)
    (lwo-category? origin LWX-RECURSION-CORRESPONDENCE-ORIGIN))
(defn lwxr-correspondence-origin-reflection-candidate (origin)
    (nth (node_children origin) 0))

(defn lwxr-correspondence-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (and (eq (lwr-raw-correspondence?
                        (lwo-emergent-shape candidate)) 1)
                  (eq (lwxr-correspondence-origin?
                        (lwo-emergent-provenance candidate)) 1))) 1 0))

(defn lwxr-correspondence-candidate-current? (world candidate)
    (if (eq (lwxr-correspondence-candidate? candidate) 0) 0
        (do
            (let reflection-candidate
                (lwxr-correspondence-origin-reflection-candidate
                    (lwo-emergent-provenance candidate)))
            (let proposal
                (lwxr-correspondence-proposal world reflection-candidate))
            (if (node_eq proposal (lwo-none)) 0
                (if (and (eq (lwo-active? world candidate) 1)
                         (node_eq candidate
                            (lwt-proposal-candidate proposal))) 1 0)))))

(defn lwxr-integrate-correspondence (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwxr-correspondence-candidate? candidate) 0)
            (lwt-round (lwt-round-world round)
                (lwt-round-proposals round) (lwo-empty-field) round)
            (do
                (let reflection-candidate
                    (lwxr-correspondence-origin-reflection-candidate
                        (lwo-emergent-provenance candidate)))
                (let current
                    (lwxr-correspondence-proposal
                        (lwt-round-world round) reflection-candidate))
                (if (or (node_eq current (lwo-none))
                        (not (node_eq candidate
                            (lwt-proposal-candidate current))))
                    (lwt-round (lwt-round-world round)
                        (lwt-round-proposals round)
                        (lwo-empty-field) round)
                    (lwt-integrate round proposal action))))))

; --- unresolved outcomes may propose attention -----------------------

(defn lwxr-reflection-unsettled-count (reflection)
    (add
        (if (eq (oac-one? (lwxr-reflection-ack reflection)) 1) 0 1)
        (add (lwo-field-size (lwxr-reflection-alternatives reflection))
             (if (node_eq
                    (lwxr-reflection-unknown reflection)
                    (lwo-none)) 0 1))))

(defn lwxr-reflection-unsettled? (reflection)
    (if (gt (lwxr-reflection-unsettled-count reflection) 0) 1 0))

(defn lwxr-focus-origin (reflection-candidate focus witnesses)
    (intern_node LWX-RECURSION-FOCUS-ORIGIN
        (list reflection-candidate focus witnesses)))

(defn lwxr-focus-proposal (world reflection-candidate)
    (if (eq (lwxr-reflection-candidate-current?
                world reflection-candidate) 0) (lwo-none)
        (do
            (let reflection (lwo-emergent-shape reflection-candidate))
            (if (eq (lwxr-reflection-unsettled? reflection) 0) (lwo-none)
                (do
                    (let focus
                        (lwen-focus
                            (lwxr-reflection-input reflection)
                            reflection-candidate))
                    (let witnesses
                        (lwxr-field-union-items
                            (lwo-field-items
                                (lwo-emergent-witnesses reflection-candidate))
                            (lwo-active-attributions-for
                                world reflection-candidate)))
                    (let count (lwo-field-size witnesses))
                    (let origin
                        (lwxr-focus-origin
                            reflection-candidate focus witnesses))
                    (let candidate
                        (lwo-emergent focus witnesses
                            (intern_trivial_int 1)
                            (intern_trivial_int
                                (lwxr-reflection-unsettled-count reflection))
                            (intern_trivial_int count) origin))
                    (lwt-proposal candidate
                        (lwt-sources-from-attributions
                            (lwo-field-items witnesses) (lwo-empty-field))
                        origin))))))

(defn lwxr-focus-origin? (origin)
    (lwo-category? origin LWX-RECURSION-FOCUS-ORIGIN))
(defn lwxr-focus-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (and (eq (lwen-raw-focus?
                        (lwo-emergent-shape candidate)) 1)
                  (eq (lwxr-focus-origin?
                        (lwo-emergent-provenance candidate)) 1))) 1 0))

(defn lwxr-focus-candidate-current? (world candidate)
    (if (eq (lwxr-focus-candidate? candidate) 0) 0
        (do
            (let reflection-candidate
                (nth (node_children
                    (lwo-emergent-provenance candidate)) 0))
            (let proposal (lwxr-focus-proposal world reflection-candidate))
            (if (node_eq proposal (lwo-none)) 0
                (if (and (eq (lwo-active? world candidate) 1)
                         (node_eq candidate
                            (lwt-proposal-candidate proposal))) 1 0)))))

(defn lwxr-integrate-focus (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwxr-focus-candidate? candidate) 0)
            (lwt-round (lwt-round-world round)
                (lwt-round-proposals round) (lwo-empty-field) round)
            (do
                (let reflection-candidate
                    (nth (node_children
                        (lwo-emergent-provenance candidate)) 0))
                (let current
                    (lwxr-focus-proposal
                        (lwt-round-world round) reflection-candidate))
                (if (or (node_eq current (lwo-none))
                        (not (node_eq candidate
                            (lwt-proposal-candidate current))))
                    (lwt-round (lwt-round-world round)
                        (lwt-round-proposals round)
                        (lwo-empty-field) round)
                    (lwt-integrate round proposal action))))))

(defn lwxr-focus-proposals-items (world items acc)
    (if (eq (len items) 0) acc
        (do
            (let proposal (lwxr-focus-proposal world (head items)))
            (lwxr-focus-proposals-items world (tail items)
                (if (node_eq proposal (lwo-none)) acc
                    (lwo-field-add acc proposal))))))

(defn lwxr-focus-proposals (world)
    (lwxr-focus-proposals-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwxr-time-observation (reflection observed-time)
    (if (or (node_eq (lwxr-reflection-timeout reflection) (lwo-none))
            (node_eq observed-time (lwo-none))) (lwo-none)
        (oac-timeout-condense
            (lwxr-reflection-timeout reflection) observed-time)))
