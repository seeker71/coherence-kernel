//////////////////////////////////////////////////////////////////////
//
// form-glass-vitals.bml — the body takes its own vitals.
//
// Urs, 2026-09-09: "getting better self awareness of what is healthy and
// what needs attention in general is vital, right now you are relying on
// me to point out organs to pay attention to."
//
// That was exactly right, and the door before this one proved it: a
// declaration of which organs must keep giving is only ever as good as
// what somebody remembered to write in it. Two rows, hand-typed. Every
// organ nobody thought of was invisible, and the body's self-awareness
// was really my awareness, borrowed.
//
// So this door names no organ. It does not know what a healthy cadence
// is, and it never decides one. Instead it WATCHES, and lets every
// surface teach its own rhythm:
//
//   a surface that has not been seen to move at least twice has taught
//   no rhythm -- one gap is a moment, not a cadence -- and nothing is
//   claimed about it: it is RESTING, which is a statement about the
//   watch, not about the surface
//
//   a surface that has moved has demonstrated its own slowest interval,
//   and while it keeps inside that it is BEATING
//
//   a surface that has moved, taught a rhythm, and then gone quiet past
//   its own widest demonstrated gap has departed FROM ITSELF, and that
//   is FALTERING -- the one reading here that asks for attention
//
// Health is not a number anyone set. It is a surface still resembling
// itself. That makes the reading true for organs no one has named,
// including ones that arrive after this line was written -- and it makes
// the watch honest about its own youth, because a rhythm nobody has
// witnessed yet is not a rhythm and says so.
//
// The body then SIGNALS: fgv-publish gives the vitals into the membrane
// as a frame like any other, so the body's own reading of its health is
// a surface any reader can take -- and one that itself has a rhythm, so
// a vitals organ that stops is caught by the next watch that sees it.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-crossings.bml

section [form.bml] {
    class FormGlassVitals {
        field FGVSchema = "form-glass-vitals-v1";
        field FGVEntrySchema = "form-glass-vital-v1";
        // how far past its OWN widest demonstrated gap a surface may drift
        // before the drift is worth attention -- the same forgiveness the
        // choice and sensor lanes already give a declared cadence
        field FGVSlackFactor = 3;
        // One gap is not a rhythm. A surface seen to move exactly once has
        // shown a single interval, and a bound built on it is as narrow as
        // whatever that one moment happened to be -- witnessed 2026-09-09, a
        // surface whose only gap was 4 ms got a 12 ms bound and was called
        // faltering by the very reading that was measuring it, because taking
        // the reading took longer than the bound. Two beats are the least a
        // rhythm can be made of, and until then the honest word is resting.
        field FGVLeastBeats = 2;
        field FGVPublisher = "vitals";

        // ---- one watched surface ---------------------------------------------
        // beats is how many times THIS watch saw the stamp advance; widestMs is
        // the largest interval it has seen between two of those advances, which
        // is the surface's own slowest demonstrated rhythm.
        def fgv-entry(name, lastSpoke, beats, widestMs, firstSeen) = list(FGVEntrySchema(), name, lastSpoke, beats, widestMs, firstSeen);
        def fgv-name(e) = nth(e, 1);
        def fgv-last-spoke(e) = nth(e, 2);
        def fgv-beats(e) = nth(e, 3);
        def fgv-widest(e) = nth(e, 4);
        def fgv-first-seen(e) = nth(e, 5);
        def fgv-entry?(e) = if lt(len(e), 6) then 0 else if str_eq(head(e), FGVEntrySchema()) then 1 else 0;
        def fgv-silence(e, now) = if gt(fgv-last-spoke(e), now) then 0 else sub(now, fgv-last-spoke(e));
        // the bound is the surface's own: its widest gap, times the slack
        def fgv-own-bound(e) = mul(FGVSlackFactor(), fgv-widest(e));

        // ---- what a surface's own history says about it ------------------------
        def fgv-state(e, now) = if lt(fgv-beats(e), FGVLeastBeats()) then "resting" else if le(fgv-silence(e, now), fgv-own-bound(e)) then "beating" else "faltering";
        def fgv-attention?(e, now) = if str_eq(fgv-state(e, now), "faltering") then 1 else 0;

        // ---- the watch: censuses folded over time -------------------------------
        def fgv-find(es, name) = if eq(len(es), 0) then list() else if str_eq(fgv-name(head(es)), name) then head(es) else fgv-find(tail(es), name);
        def fgv-max(a, b) = if gt(a, b) then a else b;
        // a slot the watch has never seen: it starts with no rhythm and no claim
        def fgv-arrived(s, now) = fgv-entry(fgx-slot-name(s), fgx-slot-spoke(s), 0, 0, now);
        // a slot the watch knows: if its stamp advanced, that interval is a beat
        // and the widest beat it has ever shown becomes its own bound
        def fgv-advanced(held, s) = fgv-entry(fgv-name(held), fgx-slot-spoke(s), add(fgv-beats(held), 1), fgv-max(fgv-widest(held), sub(fgx-slot-spoke(s), fgv-last-spoke(held))), fgv-first-seen(held));
        def fgv-step(held, s, now) = if eq(len(held), 0) then fgv-arrived(s, now) else if gt(fgx-slot-spoke(s), fgv-last-spoke(held)) then fgv-advanced(held, s) else held;
        def fgv-observe(es, slots, now) = if eq(len(slots), 0) then list() else cons(fgv-step(fgv-find(es, fgx-slot-name(head(slots))), head(slots), now), fgv-observe(es, tail(slots), now));

        // ---- the body's own reading --------------------------------------------
        def fgv-count-state(es, now, want) = if eq(len(es), 0) then 0 else add(if str_eq(fgv-state(head(es), now), want) then 1 else 0, fgv-count-state(tail(es), now, want));
        def fgv-needing-attention(es, now) = if eq(len(es), 0) then list() else if eq(fgv-attention?(head(es), now), 1) then cons(head(es), fgv-needing-attention(tail(es), now)) else fgv-needing-attention(tail(es), now);
        // How long this watch has been watching, taken from the oldest thing it
        // has seen: a reading from a young watch calls everything resting and
        // says so, rather than mistaking its own youth for the body's stillness.
        def fgv-watching-since(es, held) = if eq(len(es), 0) then held else if lt(held, 0) then fgv-watching-since(tail(es), fgv-first-seen(head(es))) else if lt(fgv-first-seen(head(es)), held) then fgv-watching-since(tail(es), fgv-first-seen(head(es))) else fgv-watching-since(tail(es), held);
        def fgv-watched-ms(es, now) {
            let since = fgv-watching-since(es, -1);
            if lt(since, 0) then 0 else if gt(since, now) then 0 else sub(now, since);
        }
        def fgv-body(es, now) = list(FGVSchema(), len(es), fgv-count-state(es, now, "beating"), fgv-count-state(es, now, "faltering"), fgv-count-state(es, now, "resting"), fgv-watched-ms(es, now));
        def fgv-body-watched(b) = nth(b, 1);
        def fgv-body-beating(b) = nth(b, 2);
        def fgv-body-faltering(b) = nth(b, 3);
        def fgv-body-resting(b) = nth(b, 4);
        def fgv-body-watching-ms(b) = nth(b, 5);
        def fgv-body?(b) = if lt(len(b), 6) then 0 else if str_eq(head(b), FGVSchema()) then 1 else 0;

        // ---- the signal ---------------------------------------------------------
        // The body publishes its own vitals as a frame. Every row carries the
        // surface's state as its lifecycle, its silence as heat, its own
        // demonstrated bound as capacity, and its beats as the sequence -- so a
        // reader sees not just the verdict but the evidence the verdict came
        // from, and can disagree with it.
        // The signal is a FINDING, not a mirror. A body with a thousand healthy
        // surfaces has nothing to say about nine hundred and ninety-nine of
        // them, and a signal that grows with the body is a second census, not a
        // sign. So one row carries the whole reading, and after it comes one row
        // per surface asking for attention -- bounded by how much is wrong, not
        // by how much exists.
        //
        // A surface's own name cannot be a sample id: the membrane's fields are
        // LABELS, and a roster name carries a path and a bar. That law is right
        // and the membrane already holds the answer -- labels for the shared
        // skeleton, a cell for what does not fit. The id is lawful and made
        // here; the true name rides in the cell, with the evidence the state
        // came from, so a reader sees why and can disagree.
        field FGVFindingSchema = "form-glass-vital-finding-v1";
        def fgv-finding(e, now) = list(FGVFindingSchema(), fgv-name(e), fgv-state(e, now), fgv-silence(e, now), fgv-own-bound(e), fgv-beats(e), fgv-widest(e));
        def fgv-finding-name(f) = nth(f, 1);
        def fgv-finding-state(f) = nth(f, 2);
        def fgv-finding-silence(f) = nth(f, 3);
        def fgv-finding-bound(f) = nth(f, 4);
        def fgv-finding-beats(f) = nth(f, 5);
        def fgv-finding-widest(f) = nth(f, 6);
        // The nineteen fields are a SHARED skeleton with meanings that are not
        // this lane's to borrow: lifecycle names memory residency and takes only
        // its own words, heat is a nought-to-a-thousand gauge. A vital state is
        // neither of those, and pressing it into either would make this lane
        // legible at the cost of making the field a lie. So the state rides in
        // purpose, which is a free label, and in the cell, which was built for
        // exactly what does not fit; lifecycle answers "unknown", because the
        // membrane lifecycle of a watched surface is genuinely not something a
        // watch of stamps can know.
        def fgv-vital-sample(id, purpose, capacity, readEpoch, now) = fgtm-sample(id, fgtm-absent(), "vital", "membrane", FGVPublisher(), "vitals", purpose, fgtm-absent(), fgtm-present(capacity), "unknown", fgtm-present(readEpoch), fgtm-present(now), fgtm-absent(), fgtm-absent(), "never", "physical-live", "self-observed", list("vitals"));
        def fgv-body-row(es, now) = fgtm-with-cell(fgv-vital-sample("body", "reading", fgv-watched-ms(es, now), now, now), fgv-body(es, now));
        def fgv-attention-rows(fs, now, n) = if eq(len(fs), 0) then list() else cons(fgtm-with-cell(fgv-vital-sample(str_concat("attention.", int_to_str(n)), fgv-finding-state(head(fs)), fgv-finding-bound(head(fs)), sub(now, fgv-finding-silence(head(fs))), now), head(fs)), fgv-attention-rows(tail(fs), now, add(n, 1)));
        def fgv-findings(es, now) = if eq(len(es), 0) then list() else cons(fgv-finding(head(es), now), fgv-findings(tail(es), now));
        def fgv-rows(es, now) = cons(fgv-body-row(es, now), fgv-attention-rows(fgv-findings(fgv-needing-attention(es, now), now), now, 0));
        def fgv-publish(root, es, now) = fgtm-publish-snapshot(root, FGVPublisher(), now, fgv-rows(es, now));

        // ---- reading the signal back, without watching anything yourself -------
        def fgv-signal-body(samples) = if eq(len(samples), 0) then list() else if str_eq(fgtm-sample-id(head(samples)), "body") then fgtm-sample-cell(head(samples)) else fgv-signal-body(tail(samples));
        def fgv-signal-findings(samples) = if eq(len(samples), 0) then list() else if str_eq(fgtm-sample-id(head(samples)), "body") then fgv-signal-findings(tail(samples)) else cons(fgtm-sample-cell(head(samples)), fgv-signal-findings(tail(samples)));
        // 1 when the signal names this surface as asking for attention, 0 when
        // it does not -- and "not named" means the watch had no complaint, never
        // that the surface is unknown: the body row says how many were watched.
        def fgv-signal-attention?(samples, name) = if eq(len(samples), 0) then 0 else if str_eq(fgv-finding-name(head(samples)), name) then 1 else fgv-signal-attention?(tail(samples), name);
        def fgv-take-signal(root) = fgtm-read-current(root, FGVPublisher());
        def fgv-signal-samples(reading) = if not(str_eq(fgtm-read-state-status(reading), "current")) then list() else fgtm-snapshot-samples(fgtm-field-value(fgtm-read-state-value(reading)));

        // ---- the flow: watch, signal, wait, watch ------------------------------
        // The watch is rebuilt from the census every tick, so it is bounded by
        // the roster and never grows without end, and a name that leaves the
        // directory leaves the watch with it. The vitals frame registers like
        // any other publisher, which means the watch sees ITSELF and holds its
        // own rhythm to the same standard as everything else -- a vitals organ
        // that stops is caught by the next watch that reads the roster.
        field FGVCadenceMs = 1000;
        def fgv-tick(root, es, now) {
            let seen = fgv-observe(es, fgx-roster-slots(now), now);
            let given = fgv-publish(root, seen, now);
            seen;
        }
        def fgv-loop(root, es) {
            let seen = fgv-tick(root, es, now_unix_ms());
            let rested = host_sleep_ms(FGVCadenceMs());
            fgv-loop(root, seen);
        }
    }
    0;
}
