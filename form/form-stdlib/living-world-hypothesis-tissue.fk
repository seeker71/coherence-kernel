; living-world-hypothesis-tissue.fk -- differentiated Recipes may be re-offered.
;
; Several independently admitted held-out placements may form a local tissue
; over one integrated plural hypothesis field.  Every generated hypothesis is
; retained with its confirmed, contradicted, and unresolved placements.  A
; hypothesis becomes compatible only by exact recurrence across the requested
; number of placements and by accumulating no contradiction.  Compatibility
; is not promotion, ranking, or a default.
;
; An integrated tissue may authorize only an inert, target-scoped application
; description.  The exact generated Recipe executes on new bindings only after
; independent holders re-offer that whole application through the ordinary
; living-world membrane.  Zero, one, or many applications may coexist; none is
; selected by list order, NodeID, score, or majority.  Declaration, real-time
; lens layers, alternatives, unknowable remainder, choice, and timeout are all
; independently optional.  Immediate execution and a timeout observation are
; retained as different cells.
;
; witnessed: 2026-08-09 -> tissue 32767 + contradicted successor 2147483647
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk

(let LWHT-RECEIPT             (bp "LWHT-RECEIPT"))
(let LWHT-TISSUE              (bp "LWHT-TISSUE"))
(let LWHT-OPEN                (bp "LWHT-OPEN"))
(let LWHT-COHERENT            (bp "LWHT-COHERENT"))
(let LWHT-PLURAL              (bp "LWHT-PLURAL"))
(let LWHT-CONTRADICTED        (bp "LWHT-CONTRADICTED"))
(let LWHT-ORIGIN              (bp "LWHT-ORIGIN"))
(let LWHT-APPLICATION         (bp "LWHT-APPLICATION"))
(let LWHT-EXECUTION           (bp "LWHT-EXECUTION"))

(defn lwht-status (kind) (intern_node kind (empty)))
(defn lwht-open () (lwht-status LWHT-OPEN))
(defn lwht-coherent () (lwht-status LWHT-COHERENT))
(defn lwht-plural () (lwht-status LWHT-PLURAL))
(defn lwht-contradicted () (lwht-status LWHT-CONTRADICTED))
(defn lwht-open? (status) (if (node_eq status (lwht-open)) 1 0))
(defn lwht-coherent? (status)
    (if (node_eq status (lwht-coherent)) 1 0))
(defn lwht-plural? (status) (if (node_eq status (lwht-plural)) 1 0))
(defn lwht-contradicted? (status)
    (if (node_eq status (lwht-contradicted)) 1 0))

(defn lwht-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwht-field-union-items (tail items)
            (lwo-field-add field (head items)))))

; --- current admitted placement surface -------------------------------

(defn lwht-placement-for-field? (world candidate field-candidate)
    (if (and (eq (lwph-probe-integrated-current? world candidate) 1)
             (node_eq
                (lwph-placement-candidate (lwo-emergent-shape candidate))
                field-candidate)) 1 0))
(defn lwht-collect-placements (world items field-candidate field)
    (if (eq (len items) 0) field
        (lwht-collect-placements world (tail items) field-candidate
            (if (eq (lwht-placement-for-field?
                        world (head items) field-candidate) 1)
                (lwo-field-add field (head items)) field))))
(defn lwht-placements-for (world field-candidate)
    (lwht-collect-placements world
        (lwo-field-items (lwo-world-cells world)) field-candidate
        (lwo-empty-field)))

(defn lwht-evaluation-for-items (items hypothesis)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq
                (lwph-probe-eval-hypothesis (head items)) hypothesis)
            (head items)
            (lwht-evaluation-for-items (tail items) hypothesis))))
(defn lwht-evaluation-for (placement hypothesis)
    (lwht-evaluation-for-items
        (lwo-field-items (lwph-placement-evaluations placement))
        hypothesis))

(defn lwht-receipt-evaluations
    (placement-items hypothesis evaluations placements alternatives unknowns)
    (if (eq (len placement-items) 0)
        (list evaluations placements alternatives unknowns)
        (do
            (let candidate (head placement-items))
            (let placement (lwo-emergent-shape candidate))
            (let evaluation (lwht-evaluation-for placement hypothesis))
            (let next-evaluations
                (if (node_eq evaluation (lwo-none)) evaluations
                    (lwo-field-add evaluations evaluation)))
            (let next-placements
                (if (node_eq evaluation (lwo-none)) placements
                    (lwo-field-add placements candidate)))
            (let next-alternatives
                (lwht-field-union-items
                    (lwo-field-items
                        (lwph-placement-alternatives placement))
                    alternatives))
            (let next-unknowns
                (lwht-field-union-items
                    (lwo-field-items (lwph-placement-unknowns placement))
                    unknowns))
            (lwht-receipt-evaluations (tail placement-items) hypothesis
                next-evaluations next-placements next-alternatives
                next-unknowns))))

(defn lwht-filter-evaluations (items wanted field)
    (if (eq (len items) 0) field
        (lwht-filter-evaluations (tail items) wanted
            (if (node_eq
                    (lwph-probe-eval-state (head items)) wanted)
                (lwo-field-add field (head items)) field))))

; children: exact generated hypothesis, every matching probe evaluation,
;           confirmed/contradicted/unresolved subsets, placement candidates,
;           local state, alternatives, unknowns, local path
(defn lwht-receipt
    (hypothesis evaluations confirmed contradicted unresolved placements
     state alternatives unknowns)
    (intern_node LWHT-RECEIPT
        (list hypothesis evaluations confirmed contradicted unresolved
              placements state alternatives unknowns (lwo-local-path))))
(defn lwht-receipt? (cell) (lwo-category? cell LWHT-RECEIPT))
(defn lwht-receipt-hypothesis (receipt) (nth (node_children receipt) 0))
(defn lwht-receipt-evaluation-field (receipt)
    (nth (node_children receipt) 1))
(defn lwht-receipt-confirmed (receipt) (nth (node_children receipt) 2))
(defn lwht-receipt-contradicted (receipt) (nth (node_children receipt) 3))
(defn lwht-receipt-unresolved (receipt) (nth (node_children receipt) 4))
(defn lwht-receipt-placements (receipt) (nth (node_children receipt) 5))
(defn lwht-receipt-state (receipt) (nth (node_children receipt) 6))
(defn lwht-receipt-alternatives (receipt) (nth (node_children receipt) 7))
(defn lwht-receipt-unknowns (receipt) (nth (node_children receipt) 8))
(defn lwht-receipt-path (receipt) (nth (node_children receipt) 9))

(defn lwht-receipt-for (hypothesis placements threshold)
    (do
        (let gathered
            (lwht-receipt-evaluations
                (lwo-field-items placements) hypothesis
                (lwo-empty-field) (lwo-empty-field)
                (lwph-hypothesis-alternatives hypothesis)
                (lwph-hypothesis-unknowns hypothesis)))
        (let evaluations (nth gathered 0))
        (let confirmed
            (lwht-filter-evaluations (lwo-field-items evaluations)
                (lwph-consistent) (lwo-empty-field)))
        (let contradicted
            (lwht-filter-evaluations (lwo-field-items evaluations)
                (lwph-divergent) (lwo-empty-field)))
        (let unresolved
            (lwht-filter-evaluations (lwo-field-items evaluations)
                (lwph-unresolved) (lwo-empty-field)))
        (let compatible
            (if (and (ge (lwo-field-size confirmed) threshold)
                     (and (eq (lwo-field-size contradicted) 0)
                          (eq (lwo-field-size unresolved) 0))) 1 0))
        (let state
            (if (eq compatible 1) (lwph-consistent)
                (if (gt (lwo-field-size contradicted) 0)
                    (lwph-divergent) (lwph-unresolved))))
        (let unknowns
            (lwo-field-add (nth gathered 3)
                (lwlc-unknown evaluations)))
        (lwht-receipt hypothesis evaluations confirmed contradicted
            unresolved (nth gathered 1) state (nth gathered 2) unknowns)))

(defn lwht-build-receipts (hypothesis-items placements threshold field)
    (if (eq (len hypothesis-items) 0) field
        (lwht-build-receipts (tail hypothesis-items) placements threshold
            (lwo-field-add field
                (lwht-receipt-for
                    (head hypothesis-items) placements threshold)))))
(defn lwht-filter-receipts (items wanted field)
    (if (eq (len items) 0) field
        (lwht-filter-receipts (tail items) wanted
            (if (node_eq (lwht-receipt-state (head items)) wanted)
                (lwo-field-add field (head items)) field))))
(defn lwht-receipt-hypotheses (items field)
    (if (eq (len items) 0) field
        (lwht-receipt-hypotheses (tail items)
            (lwo-field-add field
                (lwht-receipt-hypothesis (head items))))))
(defn lwht-receipt-alternatives-items (items field)
    (if (eq (len items) 0) field
        (lwht-receipt-alternatives-items (tail items)
            (lwht-field-union-items
                (lwo-field-items
                    (lwht-receipt-alternatives (head items))) field))))
(defn lwht-receipt-unknowns-items (items field)
    (if (eq (len items) 0) field
        (lwht-receipt-unknowns-items (tail items)
            (lwht-field-union-items
                (lwo-field-items
                    (lwht-receipt-unknowns (head items))) field))))

(defn lwht-placement-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (let with-attributions
                (lwht-field-union-items
                    (lwo-field-items
                        (lwo-active-attributions-for world candidate)) field))
            (lwht-placement-witnesses-items world (tail items)
                (lwht-field-union-items
                    (lwo-field-items (lwo-emergent-witnesses candidate))
                    with-attributions)))))
(defn lwht-witnesses (world field-candidate placements)
    (do
        (let with-field
            (lwht-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world field-candidate))
                (lwo-emergent-witnesses field-candidate)))
        (lwht-placement-witnesses-items world
            (lwo-field-items placements) with-field)))

; children: integrated plural field, all current admitted placements, every
;           receipt, compatible/contradicted/unresolved receipt subsets,
;           compatible hypothesis set, state, alternatives, unknowns,
;           witnesses, confirmation threshold, local path
(defn lwht-tissue
    (field-candidate placements receipts compatible contradicted unresolved
     hypotheses status alternatives unknowns witnesses threshold)
    (intern_node LWHT-TISSUE
        (list field-candidate placements receipts compatible contradicted
              unresolved hypotheses status alternatives unknowns witnesses
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwht-tissue? (cell) (lwo-category? cell LWHT-TISSUE))
(defn lwht-tissue-field (tissue) (nth (node_children tissue) 0))
(defn lwht-tissue-placements (tissue) (nth (node_children tissue) 1))
(defn lwht-tissue-receipts (tissue) (nth (node_children tissue) 2))
(defn lwht-tissue-compatible (tissue) (nth (node_children tissue) 3))
(defn lwht-tissue-contradicted (tissue) (nth (node_children tissue) 4))
(defn lwht-tissue-unresolved (tissue) (nth (node_children tissue) 5))
(defn lwht-tissue-hypotheses (tissue) (nth (node_children tissue) 6))
(defn lwht-tissue-status (tissue) (nth (node_children tissue) 7))
(defn lwht-tissue-alternatives (tissue) (nth (node_children tissue) 8))
(defn lwht-tissue-unknowns (tissue) (nth (node_children tissue) 9))
(defn lwht-tissue-witnesses (tissue) (nth (node_children tissue) 10))
(defn lwht-tissue-threshold-cell (tissue) (nth (node_children tissue) 11))
(defn lwht-tissue-threshold (tissue)
    (node_value (lwht-tissue-threshold-cell tissue)))
(defn lwht-tissue-path (tissue) (nth (node_children tissue) 12))

(defn lwht-tissue-for (world field-candidate threshold)
    (if (or (le threshold 0)
            (eq (lwph-integrated-current? world field-candidate) 0))
        (lwo-none)
        (do
            (let field (lwo-emergent-shape field-candidate))
            (let placements
                (lwht-placements-for world field-candidate))
            (let receipts
                (lwht-build-receipts
                    (lwo-field-items (lwph-field-consistent field))
                    placements threshold (lwo-empty-field)))
            (let compatible
                (lwht-filter-receipts (lwo-field-items receipts)
                    (lwph-consistent) (lwo-empty-field)))
            (let contradicted
                (lwht-filter-receipts (lwo-field-items receipts)
                    (lwph-divergent) (lwo-empty-field)))
            (let unresolved
                (lwht-filter-receipts (lwo-field-items receipts)
                    (lwph-unresolved) (lwo-empty-field)))
            (let hypotheses
                (lwht-receipt-hypotheses
                    (lwo-field-items compatible) (lwo-empty-field)))
            (let status
                (if (eq (lwo-field-size compatible) 0)
                    (if (gt (lwo-field-size contradicted) 0)
                        (lwht-contradicted) (lwht-open))
                    (if (gt (lwo-field-size compatible) 1)
                        (lwht-plural) (lwht-coherent))))
            (let alternatives
                (lwht-receipt-alternatives-items
                    (lwo-field-items receipts)
                    (lwph-field-alternatives field)))
            (let unknowns
                (lwo-field-add
                    (lwht-receipt-unknowns-items
                        (lwo-field-items receipts)
                        (lwph-field-unknowns field))
                    (lwlc-unknown receipts)))
            (lwht-tissue field-candidate placements receipts compatible
                contradicted unresolved hypotheses status alternatives
                unknowns (lwht-witnesses world field-candidate placements)
                threshold))))

(defn lwht-origin (field-candidate threshold)
    (intern_node LWHT-ORIGIN
        (list field-candidate (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwht-origin-field (origin) (nth (node_children origin) 0))
(defn lwht-origin-threshold (origin)
    (node_value (nth (node_children origin) 1)))
(defn lwht-proposal (world field-candidate threshold)
    (do
        (let tissue (lwht-tissue-for world field-candidate threshold))
        (if (or (node_eq tissue (lwo-none))
                (eq (lwo-field-size (lwht-tissue-placements tissue)) 0))
            (lwo-none)
            (do
                (let witnesses (lwht-tissue-witnesses tissue))
                (let count (lwo-field-size witnesses))
                (let origin (lwht-origin field-candidate threshold))
                (let candidate
                    (lwo-emergent tissue witnesses
                        (intern_trivial_int
                            (lwo-field-size
                                (lwht-tissue-compatible tissue)))
                        (intern_trivial_int
                            (lwo-field-size (lwht-tissue-receipts tissue)))
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwht-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwht-tissue?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwht-candidate-current? (world candidate)
    (if (eq (lwht-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwht-proposal world (lwht-origin-field origin)
                    (lwht-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwht-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwht-candidate-current? world candidate) 1)) 1 0))

; Generic emergent readiness requires positive coherence.  A fully
; contradicted tissue truthfully has zero compatible hypotheses and therefore
; zero coherence; changing that metric would disguise the observation.  The
; tissue-specific boundary instead admits the contradiction as a current model
; state only when at least one exact receipt is contradicted, every witness is
; still active, the full witness threshold is met, and tending is unanimous.
(defn lwht-contradicted-ready? (world candidate)
    (if (eq (lwht-candidate? candidate) 0) 0
        (do
            (let tissue (lwo-emergent-shape candidate))
            (if (and (eq (lwht-contradicted?
                            (lwht-tissue-status tissue)) 1)
                     (and (gt (lwo-field-size
                                (lwht-tissue-contradicted tissue)) 0)
                          (and (ge (lwo-field-size
                                    (lwo-emergent-witnesses candidate))
                                   (lwo-emergent-threshold candidate))
                               (eq (lwo-all-active? world
                                    (lwo-field-items
                                        (lwo-emergent-witnesses candidate)))
                                   1)))) 1 0))))
(defn lwht-candidate-ready? (world candidate)
    (if (eq (lwo-emergent-ready? world candidate) 1) 1
        (lwht-contradicted-ready? world candidate)))
(defn lwht-integrate (round proposal action)
    (do
        (let world (lwt-round-world round))
        (let candidate (lwt-proposal-candidate proposal))
        (let outcome (lwt-evaluate-proposal world proposal))
        (if (and (eq (lwht-candidate-current? world candidate) 1)
                 (and (node_eq (lwt-outcome-status outcome)
                               (lwt-status-acknowledged))
                      (eq (lwht-candidate-ready? world candidate) 1)))
            (lwt-round
                (lwt-integrate-sources world
                    (lwo-field-items
                        (lwt-proposal-participants proposal))
                    candidate action outcome)
                (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field) outcome) round)
            (lwt-round world (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field) outcome) round))))

; --- exact optional re-offer and prospective native execution ---------

; children: integrated tissue, compatible generated hypothesis, exact new
;           bindings and before-cell, optional declaration, optional real-time
;           lens layers, alternatives, optional unknowable remainder,
;           optional choice, optional timeout, evidence, local path
(defn lwht-application
    (tissue hypothesis bindings before declaration layers alternatives
     unknown choice timeout evidence)
    (intern_node LWHT-APPLICATION
        (list tissue hypothesis bindings before declaration layers
              alternatives unknown choice timeout evidence
              (lwo-local-path))))
(defn lwht-application? (cell) (lwo-category? cell LWHT-APPLICATION))
(defn lwht-application-tissue (application)
    (nth (node_children application) 0))
(defn lwht-application-hypothesis (application)
    (nth (node_children application) 1))
(defn lwht-application-bindings (application)
    (nth (node_children application) 2))
(defn lwht-application-before (application)
    (nth (node_children application) 3))
(defn lwht-application-declaration (application)
    (nth (node_children application) 4))
(defn lwht-application-layers (application)
    (nth (node_children application) 5))
(defn lwht-application-alternatives (application)
    (nth (node_children application) 6))
(defn lwht-application-unknown (application)
    (nth (node_children application) 7))
(defn lwht-application-choice (application)
    (nth (node_children application) 8))
(defn lwht-application-timeout (application)
    (nth (node_children application) 9))
(defn lwht-application-evidence (application)
    (nth (node_children application) 10))
(defn lwht-application-path (application)
    (nth (node_children application) 11))

(defn lwht-optional-declaration-valid? (declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-valid? declaration)))
(defn lwht-layers-valid? (layers)
    (if (eq (lwlc-layers? layers) 0) 0
        (lwlc-all-lenses? (lwlc-layer-items layers))))
(defn lwht-application-options-valid? (application)
    (if (eq (lwht-optional-declaration-valid?
                (lwht-application-declaration application)) 0) 0
        (if (eq (lwht-layers-valid?
                    (lwht-application-layers application)) 0) 0
            (if (eq (lwo-category?
                        (lwht-application-alternatives application)
                        LWO-FIELD) 0) 0
                (if (eq (lwph-optional-unknown-valid?
                            (lwht-application-unknown application)) 0) 0
                    (if (eq (lwlc-choice-valid?
                                (lwht-application-choice application)) 0) 0
                        (lwac-optional-timeout-valid?
                            (lwht-application-timeout application))))))))
(defn lwht-application-shape-valid? (application)
    (if (eq (lwht-application? application) 0) 0
        (if (eq (lwht-candidate?
                    (lwht-application-tissue application)) 0) 0
            (if (eq (lwph-hypothesis?
                        (lwht-application-hypothesis application)) 0) 0
                (if (eq (lwre-bindings-valid?
                            (lwht-application-bindings application)) 0) 0
                    (if (node_eq
                            (lwht-application-before application) (lwo-none)) 0
                        (lwht-application-options-valid? application)))))))

(defn lwht-application-current? (world application threshold)
    (if (and (gt threshold 0)
             (and (eq (lwht-application-shape-valid? application) 1)
                  (and (eq (lwht-integrated-current? world
                              (lwht-application-tissue application)) 1)
                       (and (eq (lwo-field-has?
                                  (lwht-tissue-hypotheses
                                    (lwo-emergent-shape
                                      (lwht-application-tissue application)))
                                  (lwht-application-hypothesis application)) 1)
                            (and (eq (lwo-active? world application) 1)
                                 (and (ge (lwph-active-source-count
                                            world application) threshold)
                                      (and (eq (lwre-bindings-current? world
                                                  (lwht-application-bindings
                                                    application)) 1)
                                           (and (eq (lwo-active? world
                                                      (lwht-application-before
                                                        application)) 1)
                                                (or (node_eq
                                                      (lwht-application-declaration
                                                        application)
                                                      (lwo-none))
                                                    (eq (lwo-active? world
                                                          (lwht-application-declaration
                                                            application)) 1)))))))))) 1 0))

(defn lwht-collect-applications
    (world items tissue threshold field)
    (if (eq (len items) 0) field
        (lwht-collect-applications world (tail items) tissue threshold
            (if (and (eq (lwht-application? (head items)) 1)
                     (and (node_eq
                            (lwht-application-tissue (head items)) tissue)
                          (eq (lwht-application-current?
                                world (head items) threshold) 1)))
                (lwo-field-add field (head items)) field))))
(defn lwht-applications-for (world tissue threshold)
    (lwht-collect-applications world
        (lwo-field-items (lwo-world-cells world)) tissue threshold
        (lwo-empty-field)))

(defn lwht-application-witnesses (world application)
    (do
        (let tissue (lwht-application-tissue application))
        (let with-tissue
            (lwht-field-union-items
                (lwo-field-items (lwo-active-attributions-for world tissue))
                (lwo-emergent-witnesses tissue)))
        (let with-application
            (lwht-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world application))
                with-tissue))
        (let with-bindings
            (lwht-field-union-items
                (lwo-field-items
                    (lwre-binding-witnesses world
                        (lwht-application-bindings application)))
                with-application))
        (lwht-field-union-items
            (lwo-field-items
                (lwo-active-attributions-for world
                    (lwht-application-before application)))
            with-bindings)))

(defn lwht-time-observation (application observed-time)
    (if (or (node_eq
              (lwht-application-timeout application) (lwo-none))
            (node_eq observed-time (lwo-none))) (lwo-none)
        (oac-timeout-condense
            (lwht-application-timeout application) observed-time)))

; children: exact re-offered application, generated Recipe, numeric output,
;           immediate ONE ack, optional separate time observation,
;           alternatives, optional unknown, optional choice, witnesses,
;           observed time, recurrence threshold, local path
(defn lwht-execution
    (application recipe output immediate time alternatives unknown choice
     witnesses observed-time threshold)
    (intern_node LWHT-EXECUTION
        (list application recipe output immediate time alternatives unknown
              choice witnesses observed-time (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwht-execution? (cell) (lwo-category? cell LWHT-EXECUTION))
(defn lwht-execution-application (execution)
    (nth (node_children execution) 0))
(defn lwht-execution-recipe (execution) (nth (node_children execution) 1))
(defn lwht-execution-output (execution) (nth (node_children execution) 2))
(defn lwht-execution-immediate (execution) (nth (node_children execution) 3))
(defn lwht-execution-time (execution) (nth (node_children execution) 4))
(defn lwht-execution-alternatives (execution)
    (nth (node_children execution) 5))
(defn lwht-execution-unknown (execution) (nth (node_children execution) 6))
(defn lwht-execution-choice (execution) (nth (node_children execution) 7))
(defn lwht-execution-witnesses (execution) (nth (node_children execution) 8))
(defn lwht-execution-observed-time (execution)
    (nth (node_children execution) 9))
(defn lwht-execution-threshold (execution)
    (node_value (nth (node_children execution) 10)))
(defn lwht-execution-path (execution) (nth (node_children execution) 11))

(defn lwht-execution-for (world application threshold observed-time)
    (if (eq (lwht-application-current?
                world application threshold) 0) (lwo-none)
        (do
            (let hypothesis
                (lwht-application-hypothesis application))
            (let recipe (lwph-hypothesis-recipe hypothesis))
            (let output
                (intern_trivial_int
                    (lwre-evaluate-bound recipe
                        (lwht-application-bindings application))))
            (lwht-execution application recipe output (oac-one output)
                (lwht-time-observation application observed-time)
                (lwht-application-alternatives application)
                (lwht-application-unknown application)
                (lwht-application-choice application)
                (lwht-application-witnesses world application)
                observed-time threshold))))
(defn lwht-execution-current? (world execution)
    (if (eq (lwht-execution? execution) 0) 0
        (if (node_eq execution
                (lwht-execution-for world
                    (lwht-execution-application execution)
                    (lwht-execution-threshold execution)
                    (lwht-execution-observed-time execution))) 1 0)))

0
