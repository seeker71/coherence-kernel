; bml-native-mutable-locals.fk - mutable local frame carrier for BML lowering.
;
; This is the minimum executable row that general BML assignment lowering
; targets: a method/frame-local mutable environment with source receipts, named
; slots, assignment, reads, aliasing, and frame isolation. grammars/bml.fk lowers
; source declare/assign/read onto the same shape on the Hati lane: one frame per
; call carrying this blueprint, record sets for declare and assign, record gets
; for reads (tests/fixtures/bml-mutable-locals.bml runs them).
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-bp.fk
;
(do
    (defn bnml-source (language path line)
        (list "source" language path line))
    (defn bnml-source-language (source) (nth source 1))
    (defn bnml-source-path (source) (nth source 2))
    (defn bnml-source-line (source) (nth source 3))

    (defn bnml-frame-bp ()
        (bp "BML-MUTABLE-LOCAL-FRAME"))

    (defn bnml-frame (source)
        (record_new (bnml-frame-bp) "__source" source))

    (defn bnml-frame-source (frame)
        (record_get frame "__source"))

    (defn bnml-has? (frame name)
        (record_has frame name))

    (defn bnml-read (frame name)
        (record_get frame name))

    (defn bnml-declare (frame name value)
        (do
            (record_set frame name value)
            frame))

    (defn bnml-assign (frame name value)
        (do
            (record_set frame name value)
            frame))

    (defn bnml-next-code-point ()
        "form/form-stdlib/grammars/bml.fk:a control body's standing value on the BMA lane -> the if and while the control lane brings to BMA")

    0)
