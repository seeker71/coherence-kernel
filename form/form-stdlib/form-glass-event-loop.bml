//////////////////////////////////////////////////////////////////////
//
// form-glass-event-loop.bml — executable event/deadline state and
// front/back frame buffers.  The wait effect is the kernel's host_sleep_ms with a
// watch list: a monotonic budget joined with the seq words of the gift frames it
// watches -- an offer or a publish moves a word and the rest ends there.
//
// Authority: form-stdlib/bml/form-glass-event-loop.bml
// preludes: form/form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassEventLoop {
        field FGELSchema = "form-glass-event-loop-v1";
        field FGELScheduleSchema = "form-glass-schedule-v1";
        field FGELWakeSchema = "form-glass-wake-v1";
        field FGELBufferSchema = "form-glass-frame-buffer-v1";
        field FGELPlanSchema = "form-glass-event-plan-v1";
        field FGELWaitDoor = "kernel.monotonic-wait-until-frame-change";
        field FGELClockDoor = "kernel.monotonic-ms";
        def fgel-wake-kind?(kind) = match (String) kind { "jit-refusal" | "jit-healed" | "telemetry" | "control" | "deadline" => 1, _ => 0 };
        def fgel-wake-priority(kind) = match (String) kind { "jit-refusal" => 5, "jit-healed" => 4, "control" => 3, "deadline" => 2, "telemetry" => 1, _ => 0 };

        // Schedule fields: schema, next deadline, budget, skipped slots,
        // last monotonic observation.  Time is supplied by the future
        // monotonic carrier; wall timestamps never enter these functions.
        def fgel-schedule(deadline, budget, skipped, observed) = list(FGELScheduleSchema(), deadline, budget, skipped, observed);
        def fgel-schedule-deadline(schedule) = schedule[1];
        def fgel-schedule-budget(schedule) = schedule[2];
        def fgel-schedule-skipped(schedule) = schedule[3];
        def fgel-schedule-observed(schedule) = schedule[4];
        def fgel-schedule-valid?(schedule) = !((Comparable) len(schedule) == 5) ? 0 : !((String) head(schedule) == FGELScheduleSchema()) ? 0 : fgel-schedule-budget(schedule) <= 0 ? 0 : fgel-schedule-skipped(schedule) < 0 ? 0 : fgel-schedule-observed(schedule) < 0 ? 0 : (fgel-schedule-deadline(schedule) >= fgel-schedule-observed(schedule));
        def fgel-schedule-start(monotonicNow, budget) = (monotonicNow < 0) || (budget <= 0) ? list(FGELScheduleSchema(), 0, 0, 0, 0) : fgel-schedule(monotonicNow + budget, budget, 0, monotonicNow);
        def fgel-due?(schedule, monotonicNow) = !((Comparable) fgel-schedule-valid?(schedule) == 1) ? 0 : (monotonicNow >= fgel-schedule-deadline(schedule));
        def fgel-elapsed-slots(schedule, monotonicNow) = !((Comparable) fgel-schedule-valid?(schedule) == 1) ? 0 : monotonicNow < fgel-schedule-deadline(schedule) ? 0 : (((monotonicNow - fgel-schedule-deadline(schedule)) / fgel-schedule-budget(schedule)) + 1);
        def fgel-missed-slots(schedule, monotonicNow) {
            let elapsed = fgel-elapsed-slots(schedule, monotonicNow);
            elapsed <= 1 ? 0 : (elapsed - 1);
        }
        def fgel-schedule-advance(schedule, monotonicNow) {
            let elapsed = fgel-elapsed-slots(schedule, monotonicNow);
            let steps = elapsed <= 0 ? 1 : elapsed;
            let nextDeadline = fgel-schedule-deadline(schedule) + (steps * fgel-schedule-budget(schedule));
            let missed = elapsed <= 1 ? 0 : (elapsed - 1);
            fgel-schedule(nextDeadline, fgel-schedule-budget(schedule), fgel-schedule-skipped(schedule) + missed, monotonicNow);
        }

        // Wake fields: schema, kind, monotonic observation, source identity,
        // evidence identity.  Source and evidence are bounded identifiers;
        // prompt, answer and payload bytes are outside this membrane.
        def fgel-wake(kind, monotonicAt, source, evidence) = list(FGELWakeSchema(), kind, monotonicAt, source, evidence);
        def fgel-wake-kind(wake) = wake[1];
        def fgel-wake-at(wake) = wake[2];
        def fgel-wake-source(wake) = wake[3];
        def fgel-wake-evidence(wake) = wake[4];
        def fgel-wake-valid?(wake) = !((Comparable) len(wake) == 5) ? 0 : !((String) head(wake) == FGELWakeSchema()) ? 0 : !((Comparable) fgel-wake-kind?(fgel-wake-kind(wake)) == 1) ? 0 : fgel-wake-at(wake) < 0 ? 0 : str_len(fgel-wake-source(wake)) <= 0 ? 0 : (str_len(fgel-wake-evidence(wake)) > 0);
        // Every supplied wake is examined. A count cap here could hide a JIT
        // refusal behind ordinary telemetry; the membrane already bounds each
        // producer snapshot.
        def fgel-select-wake-next(best, wakes) = (Comparable) len(wakes) == 0 ? best : !((Comparable) fgel-wake-valid?(head(wakes)) == 1) ? fgel-select-wake-next(best, tail(wakes)) : !((Comparable) fgel-wake-valid?(best) == 1) ? fgel-select-wake-next(head(wakes), tail(wakes)) : fgel-wake-priority(fgel-wake-kind(head(wakes))) > fgel-wake-priority(fgel-wake-kind(best)) ? fgel-select-wake-next(head(wakes), tail(wakes)) : fgel-select-wake-next(best, tail(wakes));
        def fgel-select-wake(wakes) = fgel-select-wake-next(list(), wakes);

        // Buffer fields: schema, front, back, presented generation, staged
        // generation.  Collection mutates neither frame; a new value is
        // returned for stage and commit.
        def fgel-buffer(front, back, presented, staged) = list(FGELBufferSchema(), front, back, presented, staged);
        def fgel-buffer-front(buffer) = buffer[1];
        def fgel-buffer-back(buffer) = buffer[2];
        def fgel-buffer-presented(buffer) = buffer[3];
        def fgel-buffer-staged(buffer) = buffer[4];
        def fgel-buffer-empty() = fgel-buffer(list(), list(), 0, 0);
        def fgel-buffer-valid?(buffer) = !((Comparable) len(buffer) == 5) ? 0 : !((String) head(buffer) == FGELBufferSchema()) ? 0 : fgel-buffer-presented(buffer) < 0 ? 0 : (fgel-buffer-staged(buffer) >= fgel-buffer-presented(buffer));
        def fgel-buffer-stage(buffer, frame) = !((Comparable) fgel-buffer-valid?(buffer) == 1) ? fgel-buffer-empty() : fgel-buffer(fgel-buffer-front(buffer), frame, fgel-buffer-presented(buffer), fgel-buffer-staged(buffer) + 1);
        def fgel-buffer-pending?(buffer) = !((Comparable) fgel-buffer-valid?(buffer) == 1) ? 0 : (fgel-buffer-staged(buffer) > fgel-buffer-presented(buffer));
        def fgel-buffer-commit(buffer) = !((Comparable) fgel-buffer-pending?(buffer) == 1) ? buffer : fgel-buffer(fgel-buffer-back(buffer), fgel-buffer-front(buffer), fgel-buffer-staged(buffer), fgel-buffer-staged(buffer));

        // A control wake presents immediately.  Telemetry may stage early and
        // coalesce until the anchored deadline; a deadline presents whatever
        // is staged.  Advancing is arithmetic, so a late wake cannot recurse
        // once per missed frame.
        def fgel-plan(disposition, schedule, buffer, wake) = list(FGELPlanSchema(), disposition, schedule, buffer, wake);
        def fgel-plan-disposition(plan) = plan[1];
        def fgel-plan-schedule(plan) = plan[2];
        def fgel-plan-buffer(plan) = plan[3];
        def fgel-plan-cause(plan) = plan[4];
        def fgel-plan-after-stage(schedule, staged, wake) = (String) fgel-wake-kind(wake) == "jit-refusal" ? fgel-plan("heal-hold", schedule, fgel-buffer-commit(staged), wake) : (String) fgel-wake-kind(wake) == "control" ? fgel-plan("present", fgel-schedule-advance(schedule, fgel-wake-at(wake)), fgel-buffer-commit(staged), wake) : ((String) fgel-wake-kind(wake) == "deadline") || ((Comparable) fgel-due?(schedule, fgel-wake-at(wake)) == 1) ? fgel-plan("present", fgel-schedule-advance(schedule, fgel-wake-at(wake)), fgel-buffer-commit(staged), wake) : fgel-plan("staged", schedule, staged, wake);
        def fgel-plan-wake(schedule, buffer, wake, nextFrame) = !((Comparable) fgel-schedule-valid?(schedule) == 1) ? fgel-plan("refused-schedule", schedule, buffer, wake) : !((Comparable) fgel-buffer-valid?(buffer) == 1) ? fgel-plan("refused-buffer", schedule, buffer, wake) : !((Comparable) fgel-wake-valid?(wake) == 1) ? fgel-plan("refused-wake", schedule, buffer, wake) : fgel-plan-after-stage(schedule, fgel-buffer-stage(buffer, nextFrame), wake);
        def fgel-plan-wakes(schedule, buffer, wakes, nextFrame) = fgel-plan-wake(schedule, buffer, fgel-select-wake(wakes), nextFrame);
        def fgel-resume-matches-fault?(plan, resumeWake) = !((String) fgel-wake-kind(resumeWake) == "jit-healed") ? 0 : !((String) fgel-wake-source(resumeWake) == fgel-wake-source(fgel-plan-cause(plan))) ? 0 : !((String) fgel-wake-evidence(resumeWake) == fgel-wake-evidence(fgel-plan-cause(plan))) ? 0 : (fgel-wake-at(resumeWake) > fgel-wake-at(fgel-plan-cause(plan)));
        def fgel-resume-held(plan, resumeWake) = !((String) fgel-plan-disposition(plan) == "heal-hold") ? fgel-plan("refused-resume-not-held", fgel-plan-schedule(plan), fgel-plan-buffer(plan), resumeWake) : !((Comparable) fgel-wake-valid?(resumeWake) == 1) ? fgel-plan("refused-resume-wake", fgel-plan-schedule(plan), fgel-plan-buffer(plan), resumeWake) : !((String) fgel-wake-kind(resumeWake) == "jit-healed") ? fgel-plan("refused-resume-kind", fgel-plan-schedule(plan), fgel-plan-buffer(plan), resumeWake) : !((Comparable) fgel-resume-matches-fault?(plan, resumeWake) == 1) ? fgel-plan("refused-resume-fault-identity", fgel-plan-schedule(plan), fgel-plan-buffer(plan), resumeWake) : fgel-plan("present", fgel-schedule-advance(fgel-plan-schedule(plan), fgel-wake-at(resumeWake)), fgel-plan-buffer(plan), resumeWake);

        // Existing regular-file publication is already producer-safe when
        // Glass is absent.  The missing wait carrier observes those paths; it
        // must not require a producer to ring a FIFO or connect a socket.
        def fgel-event-sources() = list("jit-refusal", "jit-healed-after-rechallenge", "telemetry-frame-seq-change", "control-inbox-frame-seq-change", "monotonic-deadline");
        def fgel-carrier-gap() = list("form-glass-event-wait-v1", "available", "clock-door", FGELClockDoor(), "wait-door", FGELWaitDoor(), "native", "host_sleep_ms (list budget-ms watch ...)", "idle-rest-wakes-on-frame-seq");
    }
    0;
}
