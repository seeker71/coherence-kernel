; form-cli-anyone-door.fk — which seats are actually free for anyone.
;
; Yes: there is no free Cursor, Codex, Claude, Grok, or Gemini client.
; Those names are siblings (agent-gate.fk). They are not anyone-doors.
; A free Gemini webpage is not a seat that can carry form-cli.
;
; Anyone-doors that exist:
;   chatgpt  — free talk client (WELCOME door 1, the public Sema GPT)
;   form-cli — free body on their machine (WELCOME door 2, no account)
;
; Claude as a talk seat is paid (WELCOME door 3). Cursor, Codex, Grok,
; Gemini have no free client in this catalog.
;
; Groq and other host-owed API faces live in form-cli-free-remote.fk.
; An API is not a client.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-anyone-door-band.fk
; witnessed: 2026-08-19 -> 511

(do
    (defn fad-row (name kind free door) (list name kind free door))
    (defn fad-name (r) (nth r 0))
    (defn fad-kind (r) (nth r 1))
    (defn fad-free (r) (nth r 2))
    (defn fad-door (r) (nth r 3))

    (defn fad-kind-client () "client")
    (defn fad-kind-body   () "body")

    (defn fad-catalog ()
        (list
            (fad-row "chatgpt"  "client" 1 "welcome-1")
            (fad-row "cursor"   "client" 0 "none")
            (fad-row "codex"    "client" 0 "none")
            (fad-row "claude"   "client" 0 "welcome-3-paid")
            (fad-row "grok"     "client" 0 "none")
            (fad-row "gemini"   "client" 0 "none")
            (fad-row "form-cli" "body"   1 "welcome-2")))

    (defn fad-n () (len (fad-catalog)))

    (defn fad-find-loop (xs name)
        (if (eq (len xs) 0) (empty)
            (if (str_eq (fad-name (head xs)) name) (head xs)
                (fad-find-loop (tail xs) name))))
    (defn fad-find (name) (fad-find-loop (fad-catalog) name))

    (defn fad-free? (r) (eq (fad-free r) 1))
    (defn fad-client? (r) (str_eq (fad-kind r) (fad-kind-client)))

    (defn fad-n-free-client-loop (xs)
        (if (eq (len xs) 0) 0
            (add (if (and (fad-client? (head xs)) (fad-free? (head xs))) 1 0)
                 (fad-n-free-client-loop (tail xs)))))
    (defn fad-n-free-client () (fad-n-free-client-loop (fad-catalog)))

    (defn fad-n-free-body-loop (xs)
        (if (eq (len xs) 0) 0
            (add (if (and (str_eq (fad-kind (head xs)) (fad-kind-body))
                          (fad-free? (head xs))) 1 0)
                 (fad-n-free-body-loop (tail xs)))))
    (defn fad-n-free-body () (fad-n-free-body-loop (fad-catalog)))

    (defn fad-anyone-talk () "chatgpt")
    (defn fad-anyone-body () "form-cli")

    (defn fad-spoken ()
        (str_concat "form-cli anyone-door: the free talk seat is ChatGPT. "
        (str_concat "There is no free Cursor, Codex, Claude, Grok, or Gemini client. "
                    "The free body is form-cli on their own machine.")))

    (defn fadk (cond bit) (if cond bit 0))
    (defn fad-check ()
        (add (add (add (add (add (add (add (add
            (fadk (eq (fad-n) 7) 1)
            (fadk (and (eq (fad-n-free-client) 1)
                       (str_eq (fad-anyone-talk) "chatgpt")) 2))
            (fadk (and (eq (fad-n-free-body) 1)
                       (str_eq (fad-anyone-body) "form-cli")) 4))
            (fadk (eq (fad-free (fad-find "cursor")) 0) 8))
            (fadk (eq (fad-free (fad-find "codex")) 0) 16))
            (fadk (eq (fad-free (fad-find "claude")) 0) 32))
            (fadk (eq (fad-free (fad-find "grok")) 0) 64))
            (fadk (eq (fad-free (fad-find "gemini")) 0) 128))
            (fadk (str_eq (fad-door (fad-find "claude")) "welcome-3-paid") 256)))

    0)
