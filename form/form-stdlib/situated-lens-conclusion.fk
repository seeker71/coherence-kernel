; situated-lens-conclusion.fk — let an observed time/lens relation affect a
; conclusion without pretending that the lens itself manufactures truth.
;
; A sparse observation row is:
;   [time, lens, candidate, push, source-node]
;
; where lens is the complete [point, direction, intensity, focus] value from
; core-word-inquiry.fk. Exactly one valid row must match the situated request.
; Missing evidence and ambiguous duplicate evidence both answer nothing.
;
; The crossing law is the observed-margin × analytic-push law attributed to
; observe/jacobian-lens.fk:
;   push > margin  -> the candidate may replace the current conclusion
;   push == margin -> tie, no change
;   push < margin  -> no change
;
; The field supplies candidate and push. This cell does not infer what a
; point, direction, intensity, or focus ought to mean. It only makes their
; observed relation addressable, causal, reversible, and inspectable.
;
; Outcome:
;   [kind, node, conclusion, changed, reason, push, margin, source-node]
;
; kind:   0 nothing / 1 value
; reason: 0 observed, 1 invalid, 2 missing, 3 ambiguous,
;         4 excluded scope, 5 inner decline
;
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk
; witnessed: 2026-07-26 -> 2097151 four-way;
; actual fkwu nothing/0/1 binding 7

(do
    (defn slc-tag-nothing () 0)
    (defn slc-tag-value () 1)

    (defn slc-observation (time lens candidate push source-node)
        (list time lens candidate push source-node))
    (defn slc-r-time (row) (nth row 0))
    (defn slc-r-lens (row) (nth row 1))
    (defn slc-r-candidate (row) (nth row 2))
    (defn slc-r-push (row) (nth row 3))
    (defn slc-r-source (row) (nth row 4))

    (defn slc-bit? (value)
        (if (or (eq value 0) (eq value 1)) 1 0))
    (defn slc-lens-eq? (a b)
        (if (and (eq (cwi-l-point a) (cwi-l-point b))
            (and (eq (cwi-l-direction a) (cwi-l-direction b))
            (and (eq (cwi-l-intensity a) (cwi-l-intensity b))
                 (eq (cwi-l-focus a) (cwi-l-focus b))))) 1 0))
    (defn slc-row-valid? (row)
        (if (and (eq (len row) 5)
            (and (eq (cwi-time? (slc-r-time row)) 1)
            (and (eq (cwi-lens? (slc-r-lens row)) 1)
            (and (eq (slc-bit? (slc-r-candidate row)) 1)
            (and (ge (slc-r-push row) 0)
                 (ge (slc-r-source row) 2)))))) 1 0))
    (defn slc-field-valid? (field)
        (if (eq (len field) 0) 1
            (if (eq (slc-row-valid? (head field)) 1)
                (slc-field-valid? (tail field))
                0)))
    (defn slc-row-matches? (row time lens)
        (if (and (eq (slc-r-time row) time)
                 (eq (slc-lens-eq? (slc-r-lens row) lens) 1)) 1 0))
    (defn slc-match-count (field time lens)
        (if (eq (len field) 0) 0
            (add (slc-row-matches? (head field) time lens)
                 (slc-match-count (tail field) time lens))))
    (defn slc-find-match (field time lens)
        (if (eq (len field) 0) (nothing)
            (if (eq (slc-row-matches? (head field) time lens) 1)
                (head field)
                (slc-find-match (tail field) time lens))))

    (defn slc-outcome
        (kind node conclusion changed reason push margin source-node)
        (list kind node conclusion changed reason push margin source-node))
    (defn slc-o-kind (outcome) (nth outcome 0))
    (defn slc-o-node (outcome) (nth outcome 1))
    (defn slc-o-conclusion (outcome) (nth outcome 2))
    (defn slc-o-changed (outcome) (nth outcome 3))
    (defn slc-o-reason (outcome) (nth outcome 4))
    (defn slc-o-push (outcome) (nth outcome 5))
    (defn slc-o-margin (outcome) (nth outcome 6))
    (defn slc-o-source (outcome) (nth outcome 7))
    (defn slc-nothing-outcome (node reason margin)
        (slc-outcome (slc-tag-nothing) node -1 0 reason 0 margin 0))
    (defn slc-value-outcome
        (node conclusion changed reason push margin source-node)
        (slc-outcome (slc-tag-value) node conclusion changed reason
            push margin source-node))

    ; Projection of observe/jacobian-lens.fk's strict crossing law.
    (defn slc-crosses? (push margin)
        (if (gt push margin) 1 0))

    ; Timeless settlement carries the proposition and sovereign inner bit, but
    ; deliberately does not use time or lens to construct its node or value.
    (defn slc-settle-timeless
        (scope offered inquiry base time lens inner)
        (if (or (eq (slc-bit? base) 0)
                (eq (cwi-core-request-valid?
                        scope offered inquiry inner) 0))
            (slc-nothing-outcome 2 1 0)
            (do
                (let node (cwi-logic-node (cwi-logic-mode-timeless)
                    scope offered inquiry time lens inner))
                (if (eq (cwi-scope-allows? scope offered) 0)
                    (slc-value-outcome node 0
                        (if (eq base 0) 0 1) 4 0 0 node)
                    (if (eq inner 0)
                        (slc-value-outcome node 0
                            (if (eq base 0) 0 1) 5 0 0 node)
                        (slc-value-outcome node base 0 0 0 0 node))))))

    ; Situated settlement requires one exact observation at the time/lens
    ; coordinate. The selected row, not a built-in interpretation, supplies
    ; the candidate and its push toward the decision boundary.
    (defn slc-settle-situated
        (scope offered inquiry base margin field time lens inner)
        (if (or (eq (slc-bit? base) 0)
            (or (lt margin 0)
            (or (eq (slc-field-valid? field) 0)
                (eq (cwi-request-valid?
                        scope offered inquiry time lens inner) 0))))
            (slc-nothing-outcome 2 1 margin)
            (do
                (let node
                    (cwi-request-node scope offered inquiry time lens inner))
                (if (eq (cwi-scope-allows? scope offered) 0)
                    (slc-value-outcome node 0
                        (if (eq base 0) 0 1) 4 0 margin node)
                    (if (eq inner 0)
                        (slc-value-outcome node 0
                            (if (eq base 0) 0 1) 5 0 margin node)
                        (do
                            (let count (slc-match-count field time lens))
                            (if (eq count 0)
                                (slc-nothing-outcome node 2 margin)
                                (if (gt count 1)
                                    (slc-nothing-outcome node 3 margin)
                                    (do
                                        (let row
                                            (slc-find-match field time lens))
                                        (let candidate
                                            (slc-r-candidate row))
                                        (let push (slc-r-push row))
                                        (let conclusion
                                            (if (eq
                                                    (slc-crosses?
                                                        push margin) 1)
                                                candidate
                                                base))
                                        (slc-value-outcome node conclusion
                                            (if (eq conclusion base) 0 1)
                                            0 push margin
                                            (slc-r-source row)))))))))))

    ; fkwu binding: missing/ambiguous/invalid becomes actual nothing; a
    ; witnessed conclusion becomes its terminal 0/1 value.
    (defn slc-actual (outcome)
        (if (eq (slc-o-kind outcome) (slc-tag-nothing))
            (nothing)
            (slc-o-conclusion outcome)))

    0)
