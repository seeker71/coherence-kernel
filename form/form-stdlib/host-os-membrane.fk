// Host platform and carrier catalog. Readiness names its current witness;
// each C-owned stage names the next Form-owned replacement.
// Tuple layouts stay private behind these named accessors.
// preludes: form-stdlib/hati-os-targets.fk form-stdlib/table.bml
section [form.bml] {
 class HostOsMembrane {
  field HomPlatformKind = "host-os-platform";
  field HomDoorKind = "host-os-door";
  field HomSeedKind = "host-os-seed-stage";
  field HomNativeBody = "form-native";

  def hom-platform(target,os,arch,metal,direct-src,table-loop,host-carriers,speech-carrier,seed-state,shrink-next) = [HomPlatformKind(),target,os,arch,metal,direct-src,table-loop,host-carriers,speech-carrier,seed-state,shrink-next];
  def hom-kind(p) = head(p);
  def hom-target(p) = p[1];
  def hom-os(p) = p[2];
  def hom-arch(p) = p[3];
  def hom-metal(p) = p[4];
  def hom-direct-src(p) = p[5];
  def hom-table-loop(p) = p[6];
  def hom-host-carriers(p) = p[7];
  def hom-speech-carrier(p) = p[8];
  def hom-seed-state(p) = p[9];
  def hom-shrink-next(p) = p[10];
  def hom-empty-platform() = hom-platform("","","",0,0,0,0,0,"","");
  def hom-platforms() = [
   hom-platform("macos-arm64","macos","arm64",1,1,1,1,0,"cc-checkout-seed","move-source-runner-and-host-membrane-into-form"),
   hom-platform("windows-amd64","windows","amd64",1,1,1,1,0,"mingw-cc-checkout-seed","keep-win32-carriers-thin-and-form-owned"),
   hom-platform("windows-arm64","windows","arm64",0,0,0,0,0,"target-floor","first-metal-receipt"),
   hom-platform("android-arm64","android","arm64",1,1,1,0,0,"ndk-cc-checkout-seed","concrete-audio-video-speech-carrier-receipts")];
  def hom-find-platform(target,rows) = tb-first(rows,p => ((String) hom-target(p) == target)) ?? hom-empty-platform();
  def hom-platform-for(target) = hom-find-platform(target,hom-platforms());
  def hom-supported?(target) = (str_len(target) > 0) && ((String) hom-target(hom-platform-for(target)) == target);
  def hom-catalog-known?(target) = (str_len(target) > 0) && ((String) hos-target-name(hos-target-by-name(target)) == target);
  def hom-metal-ready?(target) = hom-metal(hom-platform-for(target));
  def hom-direct-src-ready?(target) = hom-direct-src(hom-platform-for(target));
  def hom-table-loop-ready?(target) = hom-table-loop(hom-platform-for(target));

  def hom-door(protocol,capability,value-shape,body-cell,carrier-contract,local-only) = [HomDoorKind(),protocol,capability,value-shape,body-cell,carrier-contract,local-only];
  def hom-door-kind(d) = head(d);
  def hom-door-protocol(d) = d[1];
  def hom-door-cap(d) = d[2];
  def hom-door-shape(d) = d[3];
  def hom-door-body(d) = d[4];
  def hom-door-contract(d) = d[5];
  def hom-door-local(d) = d[6];
  def hom-empty-door() = hom-door("","","","","",0);
  def hom-doors() = [
   hom-door("host:file","cap.host.file","bytes",HomNativeBody(),"storage-port-file",1),
   hom-door("host:memory","cap.host.memory","frame",HomNativeBody(),"shm-offer-receive",1),
   hom-door("http:request","cap.network.http","text",HomNativeBody(),"http-client-exchange",1),
   hom-door("audio:pcm16","cap.audio.sample","bytes",HomNativeBody(),"host-os-local-audio-receipt",1),
   hom-door("video:rgba-time","cap.video.frame","pixel",HomNativeBody(),"host-os-local-video-receipt",1),
   hom-door("speech:loopback","cap.speech.loopback","receipt",HomNativeBody(),"voice-room-witness",1)];
  def hom-find-door(protocol,rows) = tb-first(rows,d => ((String) hom-door-protocol(d) == protocol)) ?? hom-empty-door();
  def hom-door-for(protocol) = hom-find-door(protocol,hom-doors());
  def hom-door-known?(protocol) = (str_len(protocol) > 0) && ((String) hom-door-protocol(hom-door-for(protocol)) == protocol);
  def hom-door-body-owned?(protocol) = ((String) hom-door-body(hom-door-for(protocol)) == HomNativeBody());

  def hom-seed-stage(name,c-owned,form-owned,platform-generic,shrink-next) = [HomSeedKind(),name,c-owned,form-owned,platform-generic,shrink-next];
  def hom-seed-name(s) = s[1];
  def hom-seed-c(s) = s[2];
  def hom-seed-form(s) = s[3];
  def hom-seed-generic(s) = s[4];
  def hom-seed-next(s) = s[5];
  def hom-seed-stages() = [
   hom-seed-stage("checkout-c-seed",1,0,1,"direct-source-runner-in-form"),
   hom-seed-stage("input-byte-eof-guard",1,0,1,"form-owned-staged-input"),
   hom-seed-stage("native-walker",0,1,1,"form-macho-elf-pe-bootstrap")];
  def hom-find-seed-stage(name,rows) = tb-first(rows,s => ((String) hom-seed-name(s) == name)) ?? hom-seed-stage("",0,0,0,"");
  def hom-seed-stage-for(name) = hom-find-seed-stage(name,hom-seed-stages());
  def hom-all-metal-has-shrink?(rows) = all?(p => ((Comparable) hom-metal(p) != 1) || ((String) hom-shrink-next(p) != ""),rows);
  def hom-all-speech-carriers-pending?(rows) = all?(p => ((Comparable) hom-speech-carrier(p) == 0),rows);
 }
 0;
}
