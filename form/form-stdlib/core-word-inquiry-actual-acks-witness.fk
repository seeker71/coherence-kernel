; core-word-inquiry-actual-acks.fk — bind the four-way ack-kind law to
; fkwu's actual nothing / 0 / 1 / node reply values.
;
; SINGLE-WITNESS (fkwu): the proof siblings do not carry actual `nothing`.
; The law and numeric geometry cross four-way in
; form/form-stdlib/tests/core-word-inquiry-band.fk.
;
; witnessed: 2026-07-25 -> 15 on fkwu
; import "form-stdlib/core-word-inquiry.fk"

(do
    (defn cwia-bit (condition bit) (if condition bit 0))
    (defn cwia-lens () (cwi-lens 1 2 3 4))
    (defn cwia-nothing-arm ()
        (do
            (let proof (cwi-reply "I" "i" "when" 7 (cwia-lens) 0 1))
            (cwia-bit
                (and (nothing? (cwi-p-ack proof))
                     (eq (cwi-p-reason proof) 2)) 1)))
    (defn cwia-zero-arm ()
        (do
            (let proof (cwi-reply "i" "I" "when" 7 (cwia-lens) 1 1))
            (cwia-bit
                (and (eq (cwi-p-ack proof) 0)
                     (eq (cwi-p-reason proof) 3)) 2)))
    (defn cwia-one-arm ()
        (do
            (let proof (cwi-reply "I" "i" "when" 7 (cwia-lens) 1 1))
            (cwia-bit
                (and (eq (cwi-p-ack proof) 1)
                     (eq (cwi-p-reason proof) 0)) 4)))
    (defn cwia-node-arm ()
        (do
            (let proof (cwi-reply "WE" "we" "why" 9 (cwia-lens) 1 1))
            (cwia-bit
                (and (eq (cwi-node-ack? proof) 1)
                     (eq (cwi-p-reason proof) 0)) 8)))
    (defn core-word-inquiry-actual-acks-witness ()
        (add (add (add
            (cwia-nothing-arm)
            (cwia-zero-arm))
            (cwia-one-arm))
            (cwia-node-arm)))
    (core-word-inquiry-actual-acks-witness))
