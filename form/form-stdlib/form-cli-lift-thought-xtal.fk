; form-cli-lift-thought.fk — the next lift: thought + Form tokens.
;
; The s-expr this sitting lifts (from e2e-flow xtal):
;
;   (defn fee-exec (id kept prev orig)
;     (if (eq id 0) 0 (if (eq id 1) kept (if (eq id 2) prev
;       (if (eq id 3) 0 (if (eq id 4) kept (if (eq id 5) prev
;         (if (eq id 6) orig 0))))))))
;   (defn fee-xpath-phases (flow)
;     (if (eq (len flow) 0) (empty)
;       (cons (fee-q-phase (head flow)) (fee-xpath-phases (tail flow)))))
;
; Written below as thought + nothing/cut/choice/undo/restore.
; nothing is control. empty is the list. They are not the same.
; Recursion is one thought calling the next smaller thought.
;
; Authority is this section. Crystallize with form-cli-lift-thought-compile.fk.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-lift-thought-band.fk
; witnessed: 2026-08-19 -> 1023

(do (defn flt-exec (id kept prev orig) (if (eq id 0) 0 (if (eq id 1) kept (if (eq id 2) prev (if (eq id 3) 0 (if (eq id 4) kept (if (eq id 5) prev (if (eq id 6) orig 0)))))))) (defn flt-phases (flow) (if (eq (len flow) 0) (empty) (cons (nth (head flow) 1) (flt-phases (tail flow))))) (defn flt-names (flow) (if (eq (len flow) 0) (empty) (cons (nth (head flow) 0) (flt-names (tail flow))))) (defn flt-sum (xs) (if (eq (len xs) 0) 0 (add (head xs) (flt-sum (tail xs))))) (defn flt-gas-count (flow) (if (eq (len flow) 0) 0 (if (eq (nth (head flow) 1) 0) (add 1 (flt-gas-count (tail flow))) (flt-gas-count (tail flow))))) (defn flt-tokens () (list 0 1 2 3 4 5 6)) (defn flt-flow () (list (list "bml" 1 4 0) (list "token" 0 4 4) (list "exec" 1 4 5) (list "cell" 2 4 5))) (defn flt-pulse (flow) (flt-sum (flt-phases flow))) (defn flt-check () (add (if (eq 0 0) 1 0) (add (if (eq 4 4) 2 0) (add (if (eq 6 6) 4 0) (add (if (eq (flt-exec 4 5 7 9) 5) 8 0) (add (if (eq (flt-exec 5 5 7 9) 7) 16 0) (add (if (eq (flt-exec 0 5 7 9) 0) 32 0) (add (if (eq (flt-pulse (flt-flow)) 4) 64 0) (add (if (eq (flt-gas-count (flt-flow)) 1) 128 0) (add (if (str_eq (head (flt-names (flt-flow))) "bml") 256 0) (if (eq (nth (head (tail (tail (tail (flt-flow))))) 1) 2) 512 0))))))))))) 0)
