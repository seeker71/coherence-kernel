; source-of.fk — the discovery organ: which source file births a name. The
; missing half of generation-on-demand — the crossing can admit a recipe
; and the registry can cache its node, but nothing could yet answer "where
; does this name LIVE?" without a mind grepping. Now the body greps itself.
;
; THE INDEX IS COMPUTED, NEVER CURATED. This body has paid twice for
; hand-held mirrors (the bp table; the module graph in six list copies):
; a curated name->file map drifts silently. sof-index reads the source
; bytes themselves — every `(defn name ` in every listed cell — so the
; index is exactly as true as the tree it scanned, and it is a VALUE: cache
; it as a node keyed by the meaning epoch, and the membrane that dissolves
; stale code dissolves the stale index with it.
;
; THREE ANSWERS, and the middle one is the body's honesty about itself:
;   one file    -> the birth source, directly
;   many files  -> CHOICE — append lives in four cells today (core,
;                  core-native, line-grammar, fourth-shim), and prelude
;                  order decides; the index must SHOW the plurality, never
;                  pick silently (the resolver's choice, not the index's)
;   none        -> nothing — a name no source births cannot be generated
;                  on demand, and saying so is the answer
;
; NODE-AS-CACHE, the cohesion Urs named: request a name; sof-find discovers
; its source; the crossing admits it; the once-born registry caches the
; node under content+epoch identity. The source is the truth, the node is
; the cache, and the epoch membrane is the invalidation — all three organs
; existed; this is the join that lets a REQUEST start the chain instead of
; a prelude line.
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/source-of-band.fk

(do
    ; ── THE SCAN IS THE HOST'S GREP, THE STRUCTURE IS FORM'S ────────────────
    ; Designed under four asks — flexibility, efficiency, scalability,
    ; multi-threaded execution — and one fresh burn: the first draft walked
    ; every file in Form with append-per-row, the quadratic accumulator
    ; taxonomy row one, and timed out on its own body. The host's grep scans
    ; at C speed in ONE spoken-token call and emits file:name rows Form
    ; parses linearly (cons + one reverse, never append-per-row).
    ;
    ;   flexibility   the pattern is an argument (sof-grep-pattern); any
    ;                 birth shape — defn, define, optable row — is one
    ;                 pattern away, and dirs are data
    ;   efficiency    one process boundary crossing per shard; O(bytes)
    ;                 scan in C; O(rows) structure in Form
    ;   scalability   shards: each dir (or dir-slice) is an independent
    ;                 grep; nothing shares state but the merged list
    ;   multi-thread  shard greps can run as CONCURRENT background
    ;                 processes writing per-shard spools, merged through
    ;                 the spool transport (the proven floor, #549) — the
    ;                 sequential path below is the same shape at N=1, so
    ;                 going wide changes the driver, never the organ
    (defn sof-grep-pattern () "^ *\\(defn ")
    ; MEASURED THIS SITTING: fk_host_exec truncates stdout at 262,143 bytes
    ; (2^18 - 1), SILENTLY — the silent-partial family with its exact number.
    ; A completion token at the tail of a large output drowns with the rows.
    ; So the rows go to a shard FILE (read_file has no cap; NUL-clean at
    ; 27MB, witnessed) and only the spoken token crosses stdout.
    ;
    ; The first version used one fixed /tmp/sof-shard.txt. That made two
    ; concurrent residents overwrite one another's source evidence. A shard
    ; now receives a one-use host-created lease instead: Form accepts only a
    ; conservative filename alphabet and the known lease prefix, reads that
    ; lease once, then releases that exact path. The source index itself stays
    ; purely computed data; no request can nominate a filename or another
    ; residence's spool.
    (defn sof-shard-prefix () "/tmp/sof-shard.")
    (defn sof-shard-done-prefix () "ZDONE:")
    (defn sof-safe-shard-byte? (byte)
        (if (and (ge byte 97) (le byte 122)) 1
        (if (and (ge byte 65) (le byte 90)) 1
        (if (and (ge byte 48) (le byte 57)) 1
        (if (eq byte 45) 1
        (if (eq byte 95) 1
        (if (eq byte 46) 1
        (if (eq byte 47) 1 0))))))))
    (defn sof-safe-shard-path-at? (path at)
        (if (eq at (str_len path)) 1
            (if (eq (sof-safe-shard-byte? (str_byte_at path at)) 1)
                (sof-safe-shard-path-at? path (add at 1)) 0)))
    (defn sof-safe-shard-path? (path)
        (if (or (nothing? path) (eq (str_len path) 0)) 0
            (if (not (eq (str_find path (sof-shard-prefix) 0) 0)) 0
                (sof-safe-shard-path-at? path 0))))
    (defn sof-shard-path-from-output (out)
        (if (or (nothing? out)
                (not (eq (str_find out (sof-shard-done-prefix) 0) 0)))
            (nothing)
            (do
                (let path (substring out (str_len (sof-shard-done-prefix))
                    (str_len out)))
                (if (eq (sof-safe-shard-path? path) 1) path (nothing)))))
    (defn sof-shard-release (path)
        ; `path` is accepted only through sof-shard-path-from-output above,
        ; hence contains no shell punctuation and remains the exact one-use
        ; lease that this scan obtained.
        (host-exec (str_concat "rm -f -- " path) ""))
    (defn sof-shard-command (dir)
        (str_concat "out=$(mktemp /tmp/sof-shard.XXXXXX) || exit 1; grep -H -E '"
            (str_concat (sof-grep-pattern)
            (str_concat "' " (str_concat dir
            (str_concat "/*.fk 2>/dev/null | sed -E 's/^([^:]*):[[:space:]]*\\(defn ([^ (]+).*/\\2 \\1/' > \"$out\"; printf '"
            (str_concat (sof-shard-done-prefix) "'%s \"$out\"")))))))
    (defn sof-shard-scan (dir)
        (do (let out (host-exec (sof-shard-command dir) ""))
            (let path (sof-shard-path-from-output out))
            (if (nothing? path) (nothing)
                (do
                    (let s (read_file path))
                    (let released (sof-shard-release path))
                    (if (nothing? s) "" s)))))

    ; linear parse: cons rows, reverse once
    (defn sof-parse (s pos acc)
        (do (let e (str_find s "\n" pos))
            (if (lt e 0) (reverse acc)
                (do (let sp (str_find s " " pos))
                    (sof-parse s (add e 1)
                        (if (or (lt sp 0) (gt sp e)) acc
                            (cons (list (substring s pos sp)
                                        (substring s (add sp 1) e)) acc)))))))

    (defn sof-index-dir (dir)
        (do (let s (sof-shard-scan dir))
            (if (nothing? s) (list) (sof-parse s 0 (list)))))
    (defn sof-index-go (dirs acc)
        (if (eq (len dirs) 0) (reverse acc)
            (sof-index-go (tail dirs) (sof-cons-all (sof-index-dir (head dirs)) acc))))
    (defn sof-cons-all (rows acc)
        (if (eq (len rows) 0) acc
            (sof-cons-all (tail rows) (cons (head rows) acc))))
    (defn sof-index (dirs) (sof-index-go dirs (list)))

    ; ── discovery: one file, a choice of files, or nothing ─────────────────
    (defn sof-all (index name out)
        (if (eq (len index) 0) out
            (sof-all (tail index) name
                (if (str_eq (nth (head index) 0) name)
                    (append out (list (nth (head index) 1))) out))))
    (defn sof-find (index name)
        (do (let hits (sof-all index name (list)))
            (if (eq (len hits) 0) (nothing)
                (if (eq (len hits) 1) (list "one" (head hits))
                    (list "choice" hits)))))
    (defn sof-size (index) (len index))
    0)
