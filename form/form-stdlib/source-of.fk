// source-of.fk — the discovery organ: which source file births a name. The
// missing half of generation-on-demand — the crossing can admit a recipe
// and the registry can cache its node, but nothing could yet answer "where
// does this name LIVE?" without a mind grepping. Now the body greps itself.
//
// THE INDEX IS COMPUTED, NEVER CURATED. This body has paid twice for
// hand-held mirrors (the bp table; the module graph in six list copies):
// a curated name->file map drifts silently. sof-index reads the source
// bytes themselves — every `(defn name ` in every listed cell — so the
// index is exactly as true as the tree it scanned, and it is a VALUE: cache
// it as a node keyed by the meaning epoch, and the membrane that dissolves
// stale code dissolves the stale index with it.
//
// THREE ANSWERS, and the middle one is the body's honesty about itself:
//   one file    -> the birth source, directly
//   many files  -> CHOICE — append lives in three cells today (core,
//                  line-grammar, fourth-shim), and prelude
//                  order decides; the index must SHOW the plurality, never
//                  pick silently (the resolver's choice, not the index's)
//   none        -> nothing — a name no source births cannot be generated
//                  on demand, and saying so is the answer
//
// NODE-AS-CACHE, the cohesion Urs named: request a name; sof-find discovers
// its source; the crossing admits it; the once-born registry caches the
// node under content+epoch identity. The source is the truth, the node is
// the cache, and the epoch membrane is the invalidation — all three organs
// existed; this is the join that lets a REQUEST start the chain instead of
// a prelude line.
//
// preludes: form-stdlib/bml/order.bml
import form-stdlib/core.fk;
import form-stdlib/keyed-map.fk;
import form-stdlib/bml/order.bml;
//
section [form.bml] {
    // ── THE SCAN IS FORM'S ───────────────────────────────────────────────────
    // A directory is read in Form and no process runs: fs_list names its
    // entries, the `*.fk` ones (a name that does not begin with a dot, as a
    // shell glob would not) are taken in byte order, each is read whole, and a
    // line that is `  (defn name rest` becomes a row [name, dir/file].
    //
    //   flexibility   the dirs are data; any birth shape is one prefix away
    //   efficiency    one read_file per cell; a cell with no `(defn ` in it
    //                 costs one str_find; rows are consed and reversed once,
    //                 never appended per row (the quadratic accumulator)
    //   scalability   each dir is an independent scan; nothing shares state
    //                 but the merged list
    //   no residue    the scan makes no file and holds no lease: a request
    //                 cannot nominate a filename and there is nothing to release
    def sof-defn-mark() = "(defn ";
    def sof-fk-name?(name) = (Comparable) len(name) > 3 && !((Comparable) str_byte_at(name, 0) == 46) && (String) substring(name, len(name) - 3, len(name)) == ".fk";
    // the names of a directory that a `dir/*.fk` glob would match, in byte order
    def sof-cells(dir) = {
        let names = fs_list(dir);
        nothing?(names) ? [] : sort-strings(names |> filter(n => (Comparable) sof-fk-name?(n)));
    };
    // one line `  (defn name rest` read as [name, path], or [] when it is not one
    def sof-skip-sp(line, i) = i >= len(line) ? i : (Comparable) ord(char_at(line, i)) == 32 ? sof-skip-sp(line, i + 1) : i;
    def sof-name-end(line, i) = i >= len(line) ? i : ((Comparable) ord(char_at(line, i)) == 32 || (Comparable) ord(char_at(line, i)) == 40) ? i : sof-name-end(line, i + 1);
    def sof-defn-row(line, from, path) = {
        let p = sof-skip-sp(line, from);
        !((Comparable) str_find(line, sof-defn-mark(), p) == p) ? [] : {
            let a = p + 6;
            let b = sof-name-end(line, a);
            b > a ? [substring(line, a, b), path] : [];
        };
    };
    // the same, from a `path:  (defn name rest` row (the shape a grep prints)
    def sof-grep-row(line) = {
        let c = str_find(line, ":", 0);
        c < 0 ? [] : sof-defn-row(line, c + 1, substring(line, 0, c));
    };
    // linear parse of one cell's text: cons rows, reverse once
    def sof-parse(s, path, pos, acc) = pos >= len(s) ? reverse(acc) : {
        let e = str_find(s, "\n", pos);
        let stop = e < 0 ? len(s) : e;
        let row = sof-defn-row(substring(s, pos, stop), 0, path);
        sof-parse(s, path, stop + 1, (Comparable) len(row) == 0 ? acc : cons(row, acc));
    };
    def sof-cell-rows(path) = {
        let s = read_file(path);
        nothing?(s) ? [] : str_find(s, sof-defn-mark(), 0) < 0 ? [] : sof-parse(s, path, 0, []);
    };
    def sof-dir-go(dir, names, acc) = (Comparable) len(names) == 0 ? reverse(acc) : sof-dir-go(dir, names[1:], sof-cons-all(sof-cell-rows(dir + "/" + names[0]), acc));
    def sof-index-dir(dir) = sof-dir-go(dir, sof-cells(dir), []);
    def sof-index-go(dirs, acc) = (Comparable) len(dirs) == 0 ? reverse(acc) : sof-index-go(dirs[1:], sof-cons-all(sof-index-dir(dirs[0]), acc));
    def sof-cons-all(rows, acc) = (Comparable) len(rows) == 0 ? acc : sof-cons-all(rows[1:], cons(rows[0], acc));
    def sof-index(dirs) = sof-index-go(dirs, []);
    // A scan is necessarily O(source bytes); a retained lookup must not be
    // O(all births).  The index therefore receives a second, computed shape:
    // a depth derived from the observed row count and a Form-native keyed map
    // from exact symbol bytes to its one-or-many paths.  The raw rows remain in
    // the snapshot for inspection/audit, while queries use the map.  This is
    // not a curated function table: both forms are born from the same scan.
    def sof-index-map-go(rows, lookup) = (Comparable) len(rows) == 0 ? lookup : {
        let row = rows[0];
        let name = row[0];
        let path = row[1];
        let key = km-key-of-string(name);
        let paths = km-get(lookup, key, nothing());
        sof-index-map-go(rows[1:], km-put(lookup, key, nothing?(paths) ? [path] : cons(path, paths)));
    };
    def sof-index-map(index) = sof-index-map-go(index, km-for(sof-size(index)));
    def sof-map-find(lookup, name) = {
        let paths = km-get(lookup, km-key-of-string(name), nothing());
        nothing?(paths) ? nothing() : (Comparable) len(paths) == 1 ? ["one", paths[0]] : ["choice", paths];
    };
    // ── retained source index: one cold scan, many hot queries ─────────────
    // A snapshot is caller-owned resident data, not a global cache.  Its epoch
    // is supplied by the same live meaning membrane that owns the JIT route.
    // A changed epoch produces `choice` (rebuild is a decision) rather than
    // silently reusing stale births or spending another scan in a query.
    def sof-snapshot-version() = "source-of-snapshot-v2";
    def sof-snapshot(epoch, dirs, index) = [sof-snapshot-version(), epoch, dirs, index, sof-index-map(index)];
    def sof-snapshot?(snapshot) = nothing?(snapshot) ? 0 : !((Comparable) len(snapshot) == 5) ? 0 : (String) snapshot[0] == sof-snapshot-version();
    def sof-snapshot-epoch(snapshot) = snapshot[1];
    def sof-snapshot-dirs(snapshot) = snapshot[2];
    def sof-snapshot-index(snapshot) = snapshot[3];
    def sof-snapshot-lookup(snapshot) = snapshot[4];
    def sof-snapshot-build(epoch, dirs) = sof-snapshot(epoch, dirs, sof-index(dirs));
    def sof-snapshot-current?(snapshot, epoch) = (Comparable) sof-snapshot?(snapshot) == 1 ? (Comparable) sof-snapshot-epoch(snapshot) == epoch ? 1 : 0 : 0;
    // A symbol is source-map data, never a filename or shell fragment.  The
    // Form surface permits punctuation in names (for example `->`, `?`, `!`),
    // so this only refuses whitespace and parens: bytes that cannot name one
    // atom in the direct-source grammar.
    def sof-symbol-byte?(byte) = byte <= 32 ? 0 : (Comparable) byte == 40 ? 0 : (Comparable) byte == 41 ? 0 : 1;
    def sof-symbol-at?(name, at) = (Comparable) at == len(name) ? 1 : (Comparable) sof-symbol-byte?(str_byte_at(name, at)) == 1 ? sof-symbol-at?(name, at + 1) : 0;
    def sof-symbol?(name) = nothing?(name) || (Comparable) len(name) == 0 ? 0 : sof-symbol-at?(name, 0);
    // result = signal, reason, name, requested epoch, snapshot epoch, raw
    // discovery. `raw` is exactly sof-find's one/choice/nothing result, so the
    // reader never has to decode rendered text to recover plurality.
    def sof-snapshot-query-version() = "source-of-snapshot-query-v1";
    def sof-snapshot-query-result(signal, reason, name, requested-epoch, snapshot-epoch, raw) = [sof-snapshot-query-version(), signal, reason, name, requested-epoch, snapshot-epoch, raw];
    def sof-snapshot-query?(result) = nothing?(result) ? 0 : !((Comparable) len(result) == 7) ? 0 : (String) result[0] == sof-snapshot-query-version();
    def sof-query-signal(result) = result[1];
    def sof-query-reason(result) = result[2];
    def sof-query-name(result) = result[3];
    def sof-query-requested-epoch(result) = result[4];
    def sof-query-snapshot-epoch(result) = result[5];
    def sof-query-raw(result) = result[6];
    def sof-snapshot-query-current(snapshot, epoch, name) = {
        let raw = sof-map-find(sof-snapshot-lookup(snapshot), name);
        nothing?(raw) ? sof-snapshot-query-result("nothing", "symbol-unborn", name, epoch, sof-snapshot-epoch(snapshot), raw) : (String) raw[0] == "one" ? sof-snapshot-query-result("value", "symbol-one", name, epoch, sof-snapshot-epoch(snapshot), raw) : sof-snapshot-query-result("choice", "symbol-plural", name, epoch, sof-snapshot-epoch(snapshot), raw);
    };
    def sof-snapshot-query(snapshot, epoch, name) = !((Comparable) sof-snapshot?(snapshot) == 1) ? sof-snapshot-query-result("choice", "source-index-absent", name, epoch, nothing(), nothing()) : !((Comparable) sof-symbol?(name) == 1) ? sof-snapshot-query-result("choice", "symbol-shape-refused", name, epoch, sof-snapshot-epoch(snapshot), nothing()) : !((Comparable) sof-snapshot-current?(snapshot, epoch) == 1) ? sof-snapshot-query-result("choice", "source-index-stale", name, epoch, sof-snapshot-epoch(snapshot), nothing()) : sof-snapshot-query-current(snapshot, epoch, name);
    // ── discovery: one file, a choice of files, or nothing ─────────────────
    def sof-all(index, name, out) = (Comparable) len(index) == 0 ? out : sof-all(index[1:], name, (String) index[0][0] == name ? append(out, [index[0][1]]) : out);
    def sof-find(index, name) = {
        let hits = sof-all(index, name, []);
        (Comparable) len(hits) == 0 ? nothing() : (Comparable) len(hits) == 1 ? ["one", hits[0]] : ["choice", hits];
    };
    def sof-size(index) = len(index);
    0;
}
