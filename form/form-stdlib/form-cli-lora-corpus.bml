//////////////////////////////////////////////////////////////////////
//
// form-cli-lora-corpus.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-lora-corpus.bml
//
// Emits enough lens x lane rows for LoRA fuel. Writes gitignored
// .form-lora-corpus. Seeds rank-1 A/B from sample bytes. fqt-lora?
// stays 0. Qwen GGUF is not modified.
//
// Proven by: form-stdlib/tests/form-cli-lora-corpus-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SampleRow<TClass> {
        member split: String;
        member className: TClass;
        member situation: String;
    }

    class FormLoraCorpusAuthority {
        field CorpusAuthorityPath = "form/form-stdlib/bml/form-cli-lora-corpus.bml";
        field CorpusAuthorityKind = "high-bml-class-template-field";
    }

    class FormLoraCorpus<T> {
        field MixA = 7;
        field MixB = 13;
        field NSkills = 8;
        field NLanes = 9;
        field TrainN = 12;
        field HeldoutN = 4;
        field Dim = 64;
        field FqtLora = 0;
        field CorpusPath = ".form-lora-corpus";
        field AdapterPath = ".form-lora-adapter";
        field Pipe = "|";
        field Nl = "\n";

        ref flc-authority = FormLoraCorpusAuthority;
        thought flc-pattern = list("enough", "gitignored", "rank-1-seed", "qwen-frozen");

        def flc-n() = mul(NSkills(), mul(NLanes(), add(TrainN(), HeldoutN())));

        def flc-scale-20-5() = mul(NSkills(), mul(NLanes(), add(20, 5)));

        def flc-line(row) = str_concat(nth(row, 0), str_concat(Pipe(), str_concat(nth(row, 1), str_concat(Pipe(), str_concat(nth(row, 2), Nl())))));

        def flc-print-one(row, rest) {
            print_str(flc-line(row));
            flc-print(rest);
        }

        def flc-print(rows) = if eq(len(rows), 0) then 0 else flc-print-one(head(rows), tail(rows));

        def flc-join(rows, acc) = if eq(len(rows), 0) then acc else flc-join(tail(rows), str_concat(acc, flc-line(head(rows))));

        def flc-body(rows) = flc-join(rows, "");

        def flc-fuel-loop(rows, n, acc) = if eq(n, 0) then acc else if eq(len(rows), 0) then acc else flc-fuel-loop(tail(rows), sub(n, 1), str_concat(acc, nth(head(rows), 2)));

        def flc-fuel(rows) = flc-fuel-loop(rows, NSkills(), "");

        def flc-fqt-lora() = FqtLora();

        def flc-path() = CorpusPath();

        def flc-dim() = Dim();

        def flc-bit(ok, bit) = if ok then bit else 0;

        def flc-check() {
            let n = flc-n();
            let c0 = flc-bit(eq(n, 1152), 1);
            let c1 = flc-bit(and(eq(TrainN(), 12), eq(HeldoutN(), 4)), 2);
            let c2 = flc-bit(eq(Dim(), 64), 4);
            let c3 = flc-bit(eq(FqtLora(), 0), 8);
            let c4 = flc-bit(str_eq(CorpusPath(), ".form-lora-corpus"), 16);
            let c5 = flc-bit(eq(flc-scale-20-5(), 1800), 32);
            let c6 = flc-bit(str_eq(AdapterPath(), ".form-lora-adapter"), 64);
            let c7 = flc-bit(eq(fqt-lora?(), 0), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
