; living-world-recipe-transformation.fk -- a settled path becomes Recipe data.
;
; A current READY intention plan may be reflected as an exact ordered Recipe
; transformation. The reflection retains every execution candidate, native
; trace Recipe, observed delta, overall before/after boundary, alternative,
; offered unknown, witness, and local path. It does not claim that a new
; composite Recipe ran: the already observed native step traces remain the
; execution ground, while this cell is inspectable recipe-data for a path.
;
; The transformation is governed by the plan field's active witnesses. A
; separately consented observer may then confirm, correct, remain silent, or
; offer another node. Only attributions from sources outside the integrated
; transformation's participant field count as independent observation.
; Revocation or any dependency movement leaves history intact and makes the
; affected candidate stale.
;
; witnessed: 2026-08-07 -> transformation/re-observation 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk

(let LWRX-RECIPE-SEQUENCE (bp "LWRX-RECIPE-SEQUENCE"))
(let LWRX-DELTA-SEQUENCE  (bp "LWRX-DELTA-SEQUENCE"))
(let LWRX-LENS-SEQUENCE   (bp "LWRX-LENS-SEQUENCE"))
(let LWRX-OVERALL         (bp "LWRX-OVERALL"))
(let LWRX-TRANSFORMATION  (bp "LWRX-TRANSFORMATION"))
(let LWRX-ORIGIN          (bp "LWRX-ORIGIN"))
(let LWRX-OBSERVATION     (bp "LWRX-OBSERVATION"))
(let LWRX-RESULT          (bp "LWRX-RESULT"))
(let LWRX-CONFIRM         (bp "LWRX-CONFIRM"))
(let LWRX-CORRECT         (bp "LWRX-CORRECT"))
(let LWRX-WAIT            (bp "LWRX-WAIT"))
(let LWRX-NODE-RETURN     (bp "LWRX-NODE-RETURN"))
(let LWRX-RESULT-ORIGIN   (bp "LWRX-RESULT-ORIGIN"))

(defn lwrx-state (kind) (intern_node kind (empty)))
(defn lwrx-confirm () (lwrx-state LWRX-CONFIRM))
(defn lwrx-correct () (lwrx-state LWRX-CORRECT))
(defn lwrx-wait () (lwrx-state LWRX-WAIT))
(defn lwrx-node-return () (lwrx-state LWRX-NODE-RETURN))
(defn lwrx-confirm? (state) (if (node_eq state (lwrx-confirm)) 1 0))
(defn lwrx-correct? (state) (if (node_eq state (lwrx-correct)) 1 0))
(defn lwrx-wait? (state) (if (node_eq state (lwrx-wait)) 1 0))

(defn lwrx-recipe-sequence (items)
    (intern_node LWRX-RECIPE-SEQUENCE items))
(defn lwrx-recipe-sequence? (cell)
    (lwo-category? cell LWRX-RECIPE-SEQUENCE))
(defn lwrx-recipe-sequence-items (sequence) (node_children sequence))
(defn lwrx-delta-sequence (items)
    (intern_node LWRX-DELTA-SEQUENCE items))
(defn lwrx-delta-sequence? (cell)
    (lwo-category? cell LWRX-DELTA-SEQUENCE))
(defn lwrx-delta-sequence-items (sequence) (node_children sequence))
(defn lwrx-lens-sequence (items)
    (intern_node LWRX-LENS-SEQUENCE items))
(defn lwrx-lens-sequence? (cell)
    (lwo-category? cell LWRX-LENS-SEQUENCE))
(defn lwrx-lens-sequence-items (sequence) (node_children sequence))

(defn lwrx-overall (before after lenses)
    (intern_node LWRX-OVERALL
        (list before after lenses (lwo-local-path))))
(defn lwrx-overall? (cell) (lwo-category? cell LWRX-OVERALL))
(defn lwrx-overall-before (overall) (nth (node_children overall) 0))
(defn lwrx-overall-after (overall) (nth (node_children overall) 1))
(defn lwrx-overall-lenses (overall) (nth (node_children overall) 2))
(defn lwrx-overall-path (overall) (nth (node_children overall) 3))

(defn lwrx-step-recipes (items)
    (if (eq (len items) 0) (empty)
        (cons
            (lwre-trace-recipe
                (lwac-execution-trace
                    (lwo-emergent-shape (head items))))
            (lwrx-step-recipes (tail items)))))
(defn lwrx-step-deltas (items)
    (if (eq (len items) 0) (empty)
        (cons
            (lwac-execution-actual
                (lwo-emergent-shape (head items)))
            (lwrx-step-deltas (tail items)))))
(defn lwrx-step-lenses (items)
    (if (eq (len items) 0) (empty)
        (cons
            (lwac-delta-lens
                (lwac-execution-actual
                    (lwo-emergent-shape (head items))))
            (lwrx-step-lenses (tail items)))))
(defn lwrx-last (items)
    (if (eq (len (tail items)) 0) (head items)
        (lwrx-last (tail items))))

(defn lwrx-plan-unknowns (plan)
    (do
        (let field (lwig-group-unknowns (lwig-plan-group plan)))
        (let derived (lwig-plan-unknown plan))
        (if (node_eq derived (lwo-none)) field
            (lwo-field-add field derived))))

; children: exact READY plan, ordered execution candidates, Recipes, deltas,
; lenses, overall boundary, alternatives, unknowns, evidence, local path
(defn lwrx-transformation
    (plan steps recipes deltas lenses overall alternatives unknowns evidence)
    (intern_node LWRX-TRANSFORMATION
        (list plan steps recipes deltas lenses overall alternatives unknowns
              evidence (lwo-local-path))))
(defn lwrx-transformation? (cell)
    (lwo-category? cell LWRX-TRANSFORMATION))
(defn lwrx-transformation-plan (transformation)
    (nth (node_children transformation) 0))
(defn lwrx-transformation-steps (transformation)
    (nth (node_children transformation) 1))
(defn lwrx-transformation-recipes (transformation)
    (nth (node_children transformation) 2))
(defn lwrx-transformation-deltas (transformation)
    (nth (node_children transformation) 3))
(defn lwrx-transformation-lenses (transformation)
    (nth (node_children transformation) 4))
(defn lwrx-transformation-overall (transformation)
    (nth (node_children transformation) 5))
(defn lwrx-transformation-alternatives (transformation)
    (nth (node_children transformation) 6))
(defn lwrx-transformation-unknowns (transformation)
    (nth (node_children transformation) 7))
(defn lwrx-transformation-evidence (transformation)
    (nth (node_children transformation) 8))
(defn lwrx-transformation-path (transformation)
    (nth (node_children transformation) 9))

(defn lwrx-transformation-for (world plan)
    (if (or (eq (lwig-plan? plan) 0)
            (or (eq (lwig-plan-current? world plan) 0)
                (eq (lwig-ready? (lwig-plan-status plan)) 0)))
        (lwo-none)
        (do
            (let items
                (lwig-sequence-items (lwig-plan-sequence plan)))
            (if (eq (len items) 0) (lwo-none)
                (do
                    (let recipes (lwrx-step-recipes items))
                    (let deltas (lwrx-step-deltas items))
                    (let lenses (lwrx-step-lenses items))
                    (let first-delta (head deltas))
                    (let last-delta (lwrx-last deltas))
                    (lwrx-transformation plan
                        (lwig-sequence items)
                        (lwrx-recipe-sequence recipes)
                        (lwrx-delta-sequence deltas)
                        (lwrx-lens-sequence lenses)
                        (lwrx-overall
                            (lwac-delta-before first-delta)
                            (lwac-delta-after last-delta)
                            (lwrx-lens-sequence lenses))
                        (lwig-plan-alternatives plan)
                        (lwrx-plan-unknowns plan)
                        (lwig-plan-evidence plan)))))))

(defn lwrx-transformation-current? (world transformation)
    (if (eq (lwrx-transformation? transformation) 0) 0
        (if (node_eq transformation
                (lwrx-transformation-for world
                    (lwrx-transformation-plan transformation))) 1 0)))
(defn lwrx-origin (plan)
    (intern_node LWRX-ORIGIN (list plan (lwo-local-path))))
(defn lwrx-proposal (world plan)
    (do
        (let transformation (lwrx-transformation-for world plan))
        (if (node_eq transformation (lwo-none)) (lwo-none)
            (do
                (let witnesses
                    (lwig-group-witnesses (lwig-plan-group plan)))
                (let count (lwo-field-size witnesses))
                (let origin (lwrx-origin plan))
                (let candidate
                    (lwo-emergent transformation witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwrx-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrx-transformation?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwrx-candidate-current? (world candidate)
    (if (eq (lwrx-candidate? candidate) 0) 0
        (do
            (let transformation (lwo-emergent-shape candidate))
            (let current
                (lwrx-transformation-for world
                    (lwrx-transformation-plan transformation)))
            (if (and (node_eq transformation current)
                     (node_eq (lwo-emergent-witnesses candidate)
                        (lwig-group-witnesses
                            (lwig-plan-group
                                (lwrx-transformation-plan current))))) 1 0))))
(defn lwrx-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrx-candidate-current? world candidate) 1)) 1 0))
(defn lwrx-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwrx-candidate-current? world
            (lwt-proposal-candidate proposal))))
(defn lwrx-integrate (round proposal action)
    (if (eq (lwrx-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; children: integrated transformation, optional observed overall, exact ack,
; alternatives, optional unknown, evidence, local path
(defn lwrx-observation
    (transformation observed ack alternatives unknown evidence)
    (intern_node LWRX-OBSERVATION
        (list transformation observed ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwrx-observation? (cell) (lwo-category? cell LWRX-OBSERVATION))
(defn lwrx-observation-transformation (observation)
    (nth (node_children observation) 0))
(defn lwrx-observation-observed (observation)
    (nth (node_children observation) 1))
(defn lwrx-observation-ack (observation) (nth (node_children observation) 2))
(defn lwrx-observation-alternatives (observation)
    (nth (node_children observation) 3))
(defn lwrx-observation-unknown (observation)
    (nth (node_children observation) 4))
(defn lwrx-observation-evidence (observation)
    (nth (node_children observation) 5))
(defn lwrx-observation-path (observation) (nth (node_children observation) 6))

(defn lwrx-observation-coherent? (observation)
    (do
        (let candidate (lwrx-observation-transformation observation))
        (let observed (lwrx-observation-observed observation))
        (let ack (lwrx-observation-ack observation))
        (let overall
            (lwrx-transformation-overall
                (lwo-emergent-shape candidate)))
        (if (eq (oac-one? ack) 1)
            (if (and (node_eq observed overall)
                     (node_eq (oac-payload ack) overall)) 1 0)
            (if (eq (oac-zero? ack) 1)
                (if (and (not (node_eq observed (lwo-none)))
                         (not (node_eq observed overall))) 1 0)
                (if (eq (oac-nothing? ack) 1)
                    (if (node_eq observed (lwo-none)) 1 0)
                    (if (eq (oac-alternative-ack? ack) 1)
                        (do
                            (let alternative (oac-payload ack))
                            (if (and (node_eq
                                      (oac-alternative-reference alternative)
                                      overall)
                                     (node_eq
                                      (oac-alternative-offered alternative)
                                      observed)) 1 0))
                        (if (eq (oac-node? ack) 1)
                            (if (node_eq (oac-payload ack) observed) 1 0)
                            0)))))))
(defn lwrx-observation-valid? (observation)
    (if (eq (lwrx-observation? observation) 0) 0
        (if (eq (lwrx-candidate?
                    (lwrx-observation-transformation observation)) 0) 0
            (if (eq (oac-valid-ack?
                        (lwrx-observation-ack observation)) 0) 0
                (if (eq (lwo-category?
                            (lwrx-observation-alternatives observation)
                            LWO-FIELD) 0) 0
                    (if (eq (lwac-optional-unknown-valid?
                                (lwrx-observation-unknown observation)) 0) 0
                        (lwrx-observation-coherent? observation)))))))

(defn lwrx-independent-attributions-items
    (world items transformation field)
    (if (eq (len items) 0) field
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (lwrx-independent-attributions-items
                world (tail items) transformation
                (if (eq (lwo-active-by? world transformation source) 1)
                    field (lwo-field-add field attribution))))))
(defn lwrx-independent-attributions (world observation)
    (lwrx-independent-attributions-items world
        (lwo-field-items
            (lwo-active-attributions-for world observation))
        (lwrx-observation-transformation observation)
        (lwo-empty-field)))

(defn lwrx-result-state (ack)
    (if (eq (oac-one? ack) 1) (lwrx-confirm)
        (if (or (eq (oac-zero? ack) 1)
                (eq (oac-alternative-ack? ack) 1))
            (lwrx-correct)
            (if (eq (oac-nothing? ack) 1)
                (lwrx-wait) (lwrx-node-return)))))
(defn lwrx-result-alternatives (transformation observation)
    (do
        (let merged
            (lwac-field-union-items
                (lwo-field-items
                    (lwrx-observation-alternatives observation))
                (lwrx-transformation-alternatives transformation)))
        (let ack (lwrx-observation-ack observation))
        (let observed (lwrx-observation-observed observation))
        (if (or (eq (oac-zero? ack) 1)
                (or (eq (oac-alternative-ack? ack) 1)
                    (eq (oac-node? ack) 1)))
            (if (node_eq observed (lwo-none)) merged
                (lwo-field-add merged observed))
            merged)))
(defn lwrx-result-unknowns (transformation observation)
    (do
        (let unknown (lwrx-observation-unknown observation))
        (if (node_eq unknown (lwo-none))
            (lwrx-transformation-unknowns transformation)
            (lwo-field-add
                (lwrx-transformation-unknowns transformation) unknown))))

; children: transformation candidate, exact observation, state, alternatives,
; unknowns, offered evidence, local path
(defn lwrx-result
    (transformation observation state alternatives unknowns evidence)
    (intern_node LWRX-RESULT
        (list transformation observation state alternatives unknowns evidence
              (lwo-local-path))))
(defn lwrx-result? (cell) (lwo-category? cell LWRX-RESULT))
(defn lwrx-result-transformation (result) (nth (node_children result) 0))
(defn lwrx-result-observation (result) (nth (node_children result) 1))
(defn lwrx-result-state-cell (result) (nth (node_children result) 2))
(defn lwrx-result-alternative-field (result) (nth (node_children result) 3))
(defn lwrx-result-unknown-field (result) (nth (node_children result) 4))
(defn lwrx-result-evidence (result) (nth (node_children result) 5))
(defn lwrx-result-path (result) (nth (node_children result) 6))

(defn lwrx-result-for (world observation threshold)
    (if (eq (lwrx-observation-valid? observation) 0) (lwo-none)
        (do
            (let candidate
                (lwrx-observation-transformation observation))
            (if (eq (lwrx-integrated-current? world candidate) 0)
                (lwo-none)
                (do
                    (let independent
                        (lwrx-independent-attributions world observation))
                    (if (lt (lwo-field-size independent) threshold)
                        (lwo-none)
                        (do
                            (let transformation
                                (lwo-emergent-shape candidate))
                            (lwrx-result candidate observation
                                (lwrx-result-state
                                    (lwrx-observation-ack observation))
                                (lwrx-result-alternatives
                                    transformation observation)
                                (lwrx-result-unknowns
                                    transformation observation)
                                (lwrx-observation-evidence observation)))))))))
(defn lwrx-result-witnesses (world observation)
    (lwac-field-union-items
        (lwo-field-items
            (lwrx-independent-attributions world observation))
        (lwo-active-attributions-for world
            (lwrx-observation-transformation observation))))
(defn lwrx-result-origin (observation threshold)
    (intern_node LWRX-RESULT-ORIGIN
        (list observation (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwrx-result-proposal (world observation threshold)
    (do
        (let result (lwrx-result-for world observation threshold))
        (if (node_eq result (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwrx-result-witnesses world observation))
                (let count (lwo-field-size witnesses))
                (let origin (lwrx-result-origin observation threshold))
                (let candidate
                    (lwo-emergent result witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwrx-result-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrx-result? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwrx-result-threshold (proposal)
    (node_value (nth (node_children (lwt-proposal-origin proposal)) 1)))
(defn lwrx-result-candidate-current? (world candidate threshold)
    (if (eq (lwrx-result-candidate? candidate) 0) 0
        (do
            (let result (lwo-emergent-shape candidate))
            (let observation (lwrx-result-observation result))
            (let current (lwrx-result-for world observation threshold))
            (if (and (node_eq result current)
                     (node_eq (lwo-emergent-witnesses candidate)
                        (lwrx-result-witnesses world observation))) 1 0))))
(defn lwrx-result-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwrx-result-candidate-current? world
            (lwt-proposal-candidate proposal)
            (lwrx-result-threshold proposal))))
(defn lwrx-result-integrated-current? (world candidate threshold)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrx-result-candidate-current?
                    world candidate threshold) 1)) 1 0))
(defn lwrx-result-integrate (round proposal action)
    (if (eq (lwrx-result-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
