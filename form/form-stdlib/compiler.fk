// compiler.fk - shared Form compiler object and runtime cells
//
import form-stdlib/core.fk;
import form-stdlib/compiler-objects.fk;
import form-stdlib/engine.fk;
import form-stdlib/grammar-chars.fk;
//
// Source languages lower through the same three bands:
//   source objects -> compiler objects -> executable program objects.
// The kernel sees only Form data and host access primitives.
(do
section [form.bml] {
    //; --- compiler object cells: one home ---------------------------
    //; The object waist (compiler-object / -unit / -section / -rule and their
    //; accessors) lives in compiler-objects.fk since 2026-08-18, preluded above,
    //; so the source-text lens chain can reach it without reading this file's
    //; section block. Names and meanings unchanged.
    //; --- compiler picture cells ------------------------------------
    //; The picture is executable model data: flows, stages, language ports,
    //; evidence, and next breaths all use the same compiler-object carrier.
    def compiler-stage(name, intent, carrier, artifact, proof) = compiler-object("compiler-stage", [name, intent, carrier, artifact, proof], [carrier, artifact, proof], compiler-identity-inverse);
    def compiler-stage-name(x) = cell-value(x)[0];
    def compiler-stage-intent(x) = cell-value(x)[1];
    def compiler-stage-carrier(x) = cell-value(x)[2];
    def compiler-stage-artifact(x) = cell-value(x)[3];
    def compiler-stage-proof(x) = cell-value(x)[4];
    def compiler-flow(name, stages) = compiler-object("compiler-flow", [name, stages], stages, compiler-identity-inverse);
    def compiler-flow-name(x) = cell-value(x)[0];
    def compiler-flow-stages(x) = cell-value(x)[1];
    def compiler-flow-stage-count(x) = len(compiler-flow-stages(x));
    def compiler-language-port(language, source_surface, grammar_surface, lowerer, emitter, runtime, shared_carrier, status, gaps, proof) = compiler-object("compiler-language-port", [language, source_surface, grammar_surface, lowerer, emitter, runtime, shared_carrier, status, gaps, proof], [grammar_surface, lowerer, emitter, runtime, proof], compiler-identity-inverse);
    def compiler-language-port-language(x) = cell-value(x)[0];
    def compiler-language-port-source-surface(x) = cell-value(x)[1];
    def compiler-language-port-grammar-surface(x) = cell-value(x)[2];
    def compiler-language-port-lowerer(x) = cell-value(x)[3];
    def compiler-language-port-emitter(x) = cell-value(x)[4];
    def compiler-language-port-runtime(x) = cell-value(x)[5];
    def compiler-language-port-shared-carrier(x) = cell-value(x)[6];
    def compiler-language-port-status(x) = cell-value(x)[7];
    def compiler-language-port-gaps(x) = cell-value(x)[8];
    def compiler-language-port-proof(x) = cell-value(x)[9];
    def compiler-language-port-shared?(port) = (String) compiler-language-port-shared-carrier(port) == "compiler-object" ? (String) compiler-language-port-runtime(port) == "form-kernel" ? true : false : false;
    def compiler-language-port-proven?(port) = (String) compiler-language-port-status(port) == "proven";
    def compiler-shared-port-count(ports) = nil?(ports) ? 0 : (Number) (compiler-language-port-shared?(ports[0]) ? 1 : 0) + (Number) compiler-shared-port-count(ports[1:]);
    def compiler-proven-port-count(ports) = nil?(ports) ? 0 : (Number) (compiler-language-port-proven?(ports[0]) ? 1 : 0) + (Number) compiler-proven-port-count(ports[1:]);
    def compiler-find-language-port(ports, language) = nil?(ports) ? [] : (String) compiler-language-port-language(ports[0]) == language ? ports[0] : compiler-find-language-port(ports[1:], language);
    def compiler-picture(name, compiler_compiler_flow, compiler_flow, language_ports, evidence, next_breaths) = compiler-object("compiler-picture", [name, compiler_compiler_flow, compiler_flow, language_ports, evidence, next_breaths], [compiler_compiler_flow, compiler_flow, language_ports, evidence, next_breaths], compiler-identity-inverse);
    def compiler-picture-name(x) = cell-value(x)[0];
    def compiler-picture-compiler-compiler-flow(x) = cell-value(x)[1];
    def compiler-picture-compiler-flow(x) = cell-value(x)[2];
    def compiler-picture-language-ports(x) = cell-value(x)[3];
    def compiler-picture-evidence(x) = cell-value(x)[4];
    def compiler-picture-next-breaths(x) = cell-value(x)[5];
    def compiler-picture-total-stages(picture) = (Number) compiler-flow-stage-count(compiler-picture-compiler-compiler-flow(picture)) + (Number) compiler-flow-stage-count(compiler-picture-compiler-flow(picture));
    def compiler-picture-shared-port-count(picture) = compiler-shared-port-count(compiler-picture-language-ports(picture));
    def compiler-picture-proven-port-count(picture) = compiler-proven-port-count(compiler-picture-language-ports(picture));
    def compiler-picture-score(picture) = (Number) compiler-picture-total-stages(picture) + (Number) ((Number) len(compiler-picture-language-ports(picture)) + (Number) ((Number) compiler-picture-shared-port-count(picture) + (Number) ((Number) compiler-picture-proven-port-count(picture) + (Number) ((Number) len(compiler-picture-evidence(picture)) + (Number) len(compiler-picture-next-breaths(picture))))));
    def bmf-bml-compiler-compiler-flow(_x) = compiler-flow("compiler-compiler", [compiler-stage("grammar-source", "A grammar is source, not metadata.", "BMF or BNF or Form grammar text", "source grammar objects", "bmf-grammar.fk and compiler.fk"), compiler-stage("grammar-parse", "The grammar parses itself into objects.", "BMF object runtime", "Rule or Branch or Sequence or Repeat objects", "compiler.fk comp-bmf-runtime-parse"), compiler-stage("grammar-compile", "Source grammar objects lower into reusable compiler objects.", "compiler-object", "compiler-rule and comp-bmf-* cells", "apply-bmf-compiler-first-rule"), compiler-stage("dialect-capsule", "A grammar becomes a runtime port by selector.", "grammar-loader registry", "parse and emit capsule", "language-packs-fourth-band.fk"), compiler-stage("sibling-proof", "The same grammar carrier walks on each kernel.", "Go/Rust/TypeScript kernels", "identical result", "form/validate.sh")]);
    def bmf-bml-compiler-flow(_x) = compiler-flow("compiler", [compiler-stage("source-scan", "Read source bytes into dialect source objects.", "grammar surface", "tokens or source cells", "python-bmf and bml bands"), compiler-stage("lift", "Lower dialect source objects into shared compiler objects.", "compiler-object", "compiler-program or Form recipe cells", "compiler.fk and language lift bands"), compiler-stage("normalize", "Map equivalent language shapes to the same NodeID family.", "Form CTORs", "RBasic or language-view recipes", "CTOR unification and parity bands"), compiler-stage("emit", "Write a runnable artifact or a reversible target surface.", "emitter", ".fk or .fkb or native target text", "source-compiler and emit bands"), compiler-stage("run-observe", "Execute with trace and provenance visible.", "form-kernel", "value plus trace/framebuffer evidence", "sibling kernels and witness trace")]);
    def bmf-bml-language-ports(_x) = [compiler-language-port("BMF", "BMF grammar text", "compiler.fk bmf second", "bmf-compiler-rules", "comp-bmf-runtime", "form-kernel", "compiler-object", "proven", "full original source body semantic lowering remains growing", "language-packs-fourth-band.fk"), compiler-language-port("BML", "BML object/runtime source", "grammars/bml.fk", "apply-bml-bmf-first-rule and indexed source parser", "bml-form-lower.bml bml-run-unit-value", "form-kernel", "compiler-object", "proven", "complete thesis corpus execution remains growing", "observe/bml-native-run.bml"), compiler-language-port("Python", "Python source", "grammars/python-bmf.fk", "shared BMF object lift", "emit-engine or Form recipe", "form-kernel", "compiler-object", "in-motion", "f-strings, decorators, try/catch, modules, ORM runtime", "language-packs-fourth-band.fk"), compiler-language-port("TypeScript", "TypeScript source", "grammars/typescript-bmf.fk", "shared BMF object lift", "emit-engine or Form recipe", "form-kernel", "compiler-object", "seed", "full TS grammar and semantic lift", "language-packs-fourth-band.fk"), compiler-language-port("Go", "Go source", "grammars/go-bmf.fk", "shared BMF object lift", "emit-engine or Form recipe", "form-kernel", "compiler-object", "seed", "full Go grammar and semantic lift", "language-packs-fourth-band.fk"), compiler-language-port("Rust", "Rust source", "grammars/rust-bmf.fk", "shared BMF object lift", "emit-engine or Form recipe", "form-kernel", "compiler-object", "seed", "full Rust grammar and semantic lift", "language-packs-fourth-band.fk"), compiler-language-port("Java", "legacy JBMF and future Java source", "legacy-jbmf plus future java-bmf", "shared BMF object lift", "emit-engine or Form recipe", "form-kernel", "compiler-object", "legacy-source", "import Java grammar from Angelic/JBMF into Form", "Downloads/Angelic/CD/Source/Java/JBMF"), compiler-language-port("CSharp", "future CSharp source", "future csharp-bmf", "shared BMF object lift", "emit-engine or Form recipe", "form-kernel", "compiler-object", "target", "author CSharp grammar and semantic lift on the same port contract", "compiler-picture")];
    def bmf-bml-compiler-picture(_x) = compiler-picture("BMF/BML modern compiler and compiler-compiler", bmf-bml-compiler-compiler-flow(0), bmf-bml-compiler-flow(0), bmf-bml-language-ports(0), ["Downloads/Angelic/src/BMF class hierarchy", "Downloads/Angelic/src/BML/lang object model", "form/form-stdlib/compiler.fk", "form/form-stdlib/grammar-loader.fk", "form/form-stdlib/tests/language-packs-fourth-band.fk", "form/validate.sh sibling-kernel parity"], ["move grammar ports into grammar-loader registry capsules", "complete BMF source body semantic lowering", "lift BML object model into canonical compiler objects", "extend Python/TS/Go/Rust grammar ports by same contract", "add Java and CSharp ports without changing the core flow"]);
    def bmf-bml-compiler-picture-score(_x) = compiler-picture-score(bmf-bml-compiler-picture(0));
    //; --- multi-section Form source objects --------------------------
    //; A source file can carry several dialect sections as Form objects:
    //; a readable BMF second, a recipe section, serialized objects, or any
    //; other supported language section. The parser for this shape lives in
    //; Form binaries above the kernel; this module defines the object model.
    def form-source(name, sections) = compiler-object("form-source", [name, sections], sections, compiler-identity-inverse);
    def form-source-name(src) = cell-value(src)[0];
    def form-source-sections(src) = cell-value(src)[1];
    def form-source-section-by-dialect-list(sections, dialect) = nil?(sections) ? [] : (String) form-section-dialect(sections[0]) == dialect ? sections[0] : form-source-section-by-dialect-list(sections[1:], dialect);
    def form-source-section-by-dialect(src, dialect) = form-source-section-by-dialect-list(form-source-sections(src), dialect);
    def form-bmf-second(language, section-object) = form-section((language + ".bmf"), section-object);
    def form-rule-recipe-section(language, rules) = form-section((language + ".recipes"), compiler-section(language, "recipes", rules));
    //; --- BMF compiler model objects ---------------------------------
    //; Mirrors the proven BMF source classes: Rule, Sequence, Branch,
    //; Repeat, Tag, RuleCall, MethodCall, Primitive, CharRange, CharChain.
    def comp-bmf-rule(name, args, item, process) = ["comp-bmf-rule", name, args, item, process];
    def comp-bmf-sequence(items) = ["comp-bmf-sequence", items];
    def comp-bmf-branch(items) = ["comp-bmf-branch", items];
    def comp-bmf-repeat(item, min, max) = ["comp-bmf-repeat", item, min, max];
    def comp-bmf-tag(name, item) = ["comp-bmf-tag", name, item];
    def comp-bmf-rule-call(name, args) = ["comp-bmf-rule-call", name, args];
    def comp-bmf-method-call(name, args) = ["comp-bmf-method-call", name, args];
    def comp-bmf-primitive(name, args) = ["comp-bmf-primitive", name, args];
    def comp-bmf-char-range(first, last) = ["comp-bmf-char-range", first, last];
    def comp-bmf-char-chain(value) = ["comp-bmf-char-chain", value];
    def comp-bmf-char-chain-strip(value, strip-before, strip-after) = ["comp-bmf-char-chain", value, strip-before, strip-after];
    def comp-bmf-inline(item) = ["comp-bmf-inline", item];
    def comp-bmf-literal(kind, value) = ["comp-bmf-literal", kind, value];
    def comp-bmf-char(value) = ["comp-bmf-char", value];
    def comp-bmf-process(code, result-type) = ["comp-bmf-process", code, result-type];
    def comp-bmf-attribute(fields, code) = ["comp-bmf-attribute", fields, code];
    def comp-bmf-syntax(name, extension, goal, rules, methods, primitives) = ["comp-bmf-syntax", name, extension, goal, rules, methods, primitives];
    def comp-bmf-call-name(call) = call[1];
    def comp-bmf-call-args(call) = call[2];
    //; --- BMF component runtime ---------------------------------------
    //; Executes the component model above through grammar-chars.fk's
    //; character-stream matcher. This is the first shared runtime path for
    //; Rule/Branch/Sequence/Repeat/Tag/RuleCall/Primitive/CharRange/CharChain
    //; objects instead of dialect-specific rule shims.
    def comp-bmf-kind(item) = item[0];
    def comp-bmf-runtime-emit-caps(caps) = caps;
    def comp-bmf-items-to-char-patterns(items) = nil?(items) ? [] : cons(comp-bmf-to-char-pattern(items[0]), comp-bmf-items-to-char-patterns(items[1:]));
    def comp-bmf-primitive-to-char-pattern(name) = (String) name == "Nil" ? ["nil"] : (String) name == "Fail" ? ["fail"] : (String) name == "Cut" ? ["cut"] : (String) name == "EndOfFile" ? ["eof"] : (String) name == "EndOfLine" ? ["eol"] : ["fail"];
    def comp-bmf-to-char-pattern(item) = {
        let kind = comp-bmf-kind(item);
        (String) kind == "comp-bmf-char-chain" ? ["string", item[1]] : (String) kind == "comp-bmf-char-range" ? ["char-range", ord(item[1]), ord(item[2])] : (String) kind == "comp-bmf-sequence" ? cons("sequence", comp-bmf-items-to-char-patterns(item[1])) : (String) kind == "comp-bmf-branch" ? cons("choice", comp-bmf-items-to-char-patterns(item[1])) : (String) kind == "comp-bmf-repeat" ? ["multi-match", comp-bmf-to-char-pattern(item[1]), item[2], item[3]] : (String) kind == "comp-bmf-tag" ? (String) item[1] == "" ? comp-bmf-to-char-pattern(item[2]) : ["capture", item[1], comp-bmf-to-char-pattern(item[2])] : (String) kind == "comp-bmf-rule-call" ? ["rule", item[1]] : (String) kind == "comp-bmf-primitive" ? comp-bmf-primitive-to-char-pattern(item[1]) : ["fail"];
    };
    def comp-bmf-rule-to-char-rule(rule) = [rule[1], comp-bmf-to-char-pattern(rule[3]), comp-bmf-runtime-emit-caps];
    def comp-bmf-rules-to-char-rules(rules) = nil?(rules) ? [] : cons(comp-bmf-rule-to-char-rule(rules[0]), comp-bmf-rules-to-char-rules(rules[1:]));
    def comp-bmf-runtime-match(rules, start-name, source) = cm-match-pattern(["rule", start-name], mk-cstream(source), comp-bmf-rules-to-char-rules(rules));
    def comp-bmf-runtime-parse(rules, start-name, source) = {
        let m = comp-bmf-runtime-match(rules, start-name, source);
        cmatch?(m) ? ccap-get(cmatch-caps(m), "_result") : [];
    };
    //; --- BMF syntax written as a BMF second --------------------------
    def bmf-src-name(value) = bmf-atom("bmf-name", value);
    def bmf-src-string(value) = bmf-atom("bmf-string", value);
    def bmf-src-char(value) = bmf-atom("bmf-char", value);
    def bmf-src-int(value) = bmf-atom("bmf-int", value);
    def bmf-src-float(value) = bmf-atom("bmf-float", value);
    def bmf-src-field(value) = bmf-atom("bmf-field", value);
    def bmf-src-args(value) = bmf-atom("bmf-args", value);
    def bmf-src-fields(value) = bmf-atom("bmf-fields", value);
    def bmf-src-code(value) = bmf-atom("bmf-code", value);
    def bmf-src-op(value) = bmf-atom("bmf-op", value);
    def bmf-kw(value) = object-lit("bmf-keyword", value);
    def bmf-op(value) = object-lit("bmf-op", value);
    def bmf-ref(name) = object-lit("bmf-ref", name);
    def bmf-name(capture-name) = ["capture", capture-name, object-lit("bmf-name", "")];
    def bmf-string-lit(capture-name) = ["capture", capture-name, object-lit("bmf-string", "")];
    def bmf-pattern-lit(capture-name) = ["capture", capture-name, object-lit("bmf-pattern", "")];
    def bmf-rules-lit(capture-name) = ["capture", capture-name, object-lit("bmf-rules", "")];
    def bmf-meta-cap(objects, capture-name) = bmf-collection-value(objects, capture-name);
    def bmf-emit-rule-source(objects) = bmf-rule-spec(bmf-meta-cap(objects, "name"), bmf-meta-cap(objects, "pattern"), bmf-meta-cap(objects, "action"));
    def bmf-emit-reversible-rule-source(objects) = bmf-reversible-rule-spec(bmf-meta-cap(objects, "name"), bmf-meta-cap(objects, "pattern"), bmf-meta-cap(objects, "action"), bmf-meta-cap(objects, "reverse"));
    def bmf-emit-literal-source(objects) = bmf-terminal(bmf-meta-cap(objects, "value"));
    def bmf-emit-capture-source(objects) = bmf-capture(bmf-meta-cap(objects, "name"), bmf-meta-cap(objects, "kind"));
    def bmf-emit-section-source(objects) = bmf-section(bmf-meta-cap(objects, "dialect"), bmf-meta-cap(objects, "rules"));
    def bmf-emit-node-source(objects) = compiler-object("bmf-source-node", objects, objects, compiler-identity-inverse);
    //; --- BMF source object compiler ----------------------------------
    //; These rules compile completed BMF source objects into the same
    //; component model used by BML and language adapters.
    def bmf-compile-char-chain(objects) = comp-bmf-char-chain(bmf-meta-cap(objects, "value"));
    def bmf-compile-char-range(objects) = comp-bmf-char-range(bmf-meta-cap(objects, "first"), bmf-meta-cap(objects, "last"));
    def bmf-compile-rule-call(objects) = comp-bmf-rule-call(bmf-meta-cap(objects, "name"), []);
    def bmf-compile-primitive(objects) = comp-bmf-primitive(bmf-meta-cap(objects, "name"), []);
    def bmf-compile-sequence-two(objects) = comp-bmf-sequence([bmf-meta-cap(objects, "left"), bmf-meta-cap(objects, "right")]);
    def bmf-compile-branch-two(objects) = comp-bmf-branch([bmf-meta-cap(objects, "left"), bmf-meta-cap(objects, "right")]);
    def bmf-compile-repeat-zero(objects) = comp-bmf-repeat(bmf-meta-cap(objects, "item"), 0, 2147483647);
    def bmf-compile-repeat-one(objects) = comp-bmf-repeat(bmf-meta-cap(objects, "item"), 1, 2147483647);
    def bmf-compile-optional(objects) = comp-bmf-repeat(bmf-meta-cap(objects, "item"), 0, 1);
    def bmf-compile-tag(objects) = comp-bmf-tag(bmf-meta-cap(objects, "name"), bmf-meta-cap(objects, "item"));
    def bmf-compile-method-call(objects) = {
        let call = bmf-meta-cap(objects, "call");
        comp-bmf-method-call(comp-bmf-call-name(call), comp-bmf-call-args(call));
    };
    def bmf-compile-rule(objects) = {
        let call = bmf-meta-cap(objects, "call");
        comp-bmf-rule(comp-bmf-call-name(call), comp-bmf-call-args(call), bmf-meta-cap(objects, "item"), []);
    };
    def bmf-compile-bmf-char-int(objects) = comp-bmf-char(bmf-meta-cap(objects, "value"));
    def bmf-compile-bmf-char-quoted(objects) = comp-bmf-char(bmf-meta-cap(objects, "value"));
    def bmf-char-compiled-value(compiled-char) = compiled-char[1];
    def bmf-compile-bmf-lit(objects) = comp-bmf-char-chain-strip(bmf-meta-cap(objects, "value"), bmf-meta-cap(objects, "strip-before"), bmf-meta-cap(objects, "strip-after"));
    def bmf-compile-bmf-range-single(objects) = {
        let first = bmf-meta-cap(objects, "first");
        comp-bmf-char-range(bmf-char-compiled-value(first), bmf-char-compiled-value(first));
    };
    def bmf-compile-bmf-range(objects) = comp-bmf-char-range(bmf-char-compiled-value(bmf-meta-cap(objects, "first")), bmf-char-compiled-value(bmf-meta-cap(objects, "last")));
    def bmf-compile-bmf-literal-int(objects) = comp-bmf-literal("int", bmf-meta-cap(objects, "value"));
    def bmf-compile-bmf-literal-float(objects) = comp-bmf-literal("float", bmf-meta-cap(objects, "value"));
    def bmf-compile-bmf-literal-string(objects) = comp-bmf-literal("string", bmf-meta-cap(objects, "value"));
    def bmf-compile-bmf-literal-field(objects) = comp-bmf-literal("field", bmf-meta-cap(objects, "value"));
    def bmf-compile-bmf-call(objects) = comp-bmf-rule-call(bmf-meta-cap(objects, "name"), bmf-meta-cap(objects, "args"));
    def bmf-compile-bmf-call-base(objects) = bmf-meta-cap(objects, "call");
    def bmf-compile-bmf-inline(objects) = comp-bmf-inline(bmf-meta-cap(objects, "expr"));
    def bmf-compile-bmf-tag-named(objects) = comp-bmf-tag(bmf-meta-cap(objects, "name"), []);
    def bmf-compile-bmf-tag-anon(_objects) = comp-bmf-tag("", []);
    def bmf-compile-bmf-expr-one(objects) = bmf-meta-cap(objects, "term");
    def bmf-compile-bmf-expr-branch(objects) = comp-bmf-branch([bmf-meta-cap(objects, "left"), bmf-meta-cap(objects, "right")]);
    def bmf-compile-bmf-term-one(objects) = bmf-meta-cap(objects, "factor");
    def bmf-compile-bmf-term-sequence(objects) = comp-bmf-sequence([bmf-meta-cap(objects, "left"), bmf-meta-cap(objects, "right")]);
    def bmf-compile-bmf-factor-item(objects) = bmf-meta-cap(objects, "item");
    def bmf-compile-bmf-factor-call(objects) = bmf-meta-cap(objects, "call");
    def bmf-compile-bmf-factor-tag-item(objects) = comp-bmf-tag(bmf-meta-cap(objects, "tag")[1], bmf-meta-cap(objects, "item"));
    def bmf-compile-bmf-item-method-bare(objects) = bmf-meta-cap(objects, "item");
    def bmf-compile-bmf-item-method(objects) = {
        let call = bmf-meta-cap(objects, "call");
        comp-bmf-method-call(comp-bmf-call-name(call), comp-bmf-call-args(call));
    };
    def bmf-compile-bmf-item-bare(objects) = bmf-meta-cap(objects, "item");
    def bmf-compile-bmf-item-star(objects) = comp-bmf-repeat(bmf-meta-cap(objects, "item"), 0, 2147483647);
    def bmf-compile-bmf-item-plus(objects) = comp-bmf-repeat(bmf-meta-cap(objects, "item"), 1, 2147483647);
    def bmf-compile-bmf-item-slash(objects) = comp-bmf-sequence([comp-bmf-repeat(bmf-meta-cap(objects, "item"), (String) bmf-meta-cap(objects, "mode") == "+" ? 1 : 0, 2147483647), bmf-meta-cap(objects, "next")]);
    def bmf-compile-bmf-opt(objects) = comp-bmf-repeat(bmf-meta-cap(objects, "expr"), 0, 1);
    def bmf-compile-bmf-must(objects) = comp-bmf-repeat(bmf-meta-cap(objects, "expr"), str_to_int(bmf-meta-cap(objects, "low")), str_to_int(bmf-meta-cap(objects, "high")));
    def bmf-compile-bmf-attribute(objects) = comp-bmf-attribute(bmf-meta-cap(objects, "fields"), bmf-meta-cap(objects, "code"));
    def bmf-compile-bmf-rule-full(objects) = {
        let call = bmf-meta-cap(objects, "call");
        comp-bmf-rule(comp-bmf-call-name(call), comp-bmf-call-args(call), bmf-meta-cap(objects, "item"), []);
    };
    //; fkwu-clean split, 2026-08-17: the three rule tables below were lets at
    //; THIS do's level, and defn bodies further down read them. Three host
    //; kernels resolve such reads lazily at call time; fkwu compiles every
    //; name positionally, so on the body's own seed kernel the whole cursor
    //; family stopped at these lines. A unit-top-level let IS visible to a
    //; defn inside a later do (probed on synthetic truth before this edit),
    //; so the do closes here, the tables stand at unit level, and a second do
    //; reopens after them. Values and evaluation order are unchanged: the
    //; tables still evaluate once, after every defn they reference is
    //; registered, before every reader runs. Also (empty) at :121 was bare
    //; `empty` — a native has no value form on fkwu, the call does.
    0;
}
)

section [form.bml] {
