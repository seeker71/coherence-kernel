; ear-native.fk — whisper-tiny as the body's own pass: weights mapped straight off the model file
; (ear-npz), the kernels the body emits (ear-msl), activations resident on the device between
; dispatches, one read-back of four bytes per token. The encoder runs once per audio window, the
; decoder greedily until <|endoftext|> or the line cap; the tongue is the argmax over the language
; window after <|startoftranscript|>. Text comes back through the reference's own token table
; (multilingual.tiktoken: base64 bytes per rank) and the body's base64. No host tool stands
; between the microphone bytes and the words.
; Every binding a layer dispatches is built once at open and stored (the shapes that vary between
; calls travel in the device's own shape word), so a dispatch is one enqueue of a stored string:
; an encode is 2 + 3 + 4x7 + 1 + 4 = 38 dispatches, a token 1 + 4x9 + 1 + 2 = 40, one sync each.
; The count went UP where a fact was pulled out of the loop that was recomputing it: a layernorm's
; row statistics are one pass over the rows (ear_lnstat) instead of a prologue inside every column
; tile, and the cross attention is a chunk pass plus a fold instead of six lonely threadgroups. Each
; costs a launch and saves far more than a launch. The four cross gemms share ONE ln_post reading
; because they all read the same rows.
; preludes: form/form-stdlib/ear-npz.fk form/form-stdlib/ear-msl.fk form/form-stdlib/metal-door.fk form/form-stdlib/str-byte-at.fk form/form-stdlib/base64.fk
(do
    (defn enw-D () 384)
    (defn enw-F () 1536)
    (defn enw-H () 6)
    (defn enw-HD () 64)
    (defn enw-V () 51865)
    (defn enw-CTX () 448)
    (defn enw-TF () 3000)
    (defn enw-TE () 1500)
    (defn enw-layers () 4)
    (defn enw-sot () 50258)
    (defn enw-eot () 50257)
    (defn enw-lang-lo () 50259)
    (defn enw-lang-hi () 50358)
    (defn enw-tok-transcribe () 50359)
    (defn enw-notimestamps () 50363)
    (defn enw-ts0 () 50364)
    ; ---- pipelines, in em-names order ----
    (defn enw-pi-spec () 0)
    (defn enw-pi-melnorm () 1)
    (defn enw-pi-addpos () 2)
    (defn enw-pi-gemm () 3)
    (defn enw-pi-mv () 4)
    (defn enw-pi-attn () 5)
    (defn enw-pi-attn-dec () 6)
    (defn enw-pi-embed () 7)
    (defn enw-pi-embed-n () 8)
    (defn enw-pi-argmax () 9)
    (defn enw-pi-melbank () 10)
    (defn enw-pi-copy () 11)
    (defn enw-pi-attn-x () 12)
    (defn enw-pi-attn-xfin () 13)
    (defn enw-pi-lnstat () 14)
    ; the cross window cut into chunks of 64 keys: the group count both halves of the split attention agree on
    (defn enw-xchunks (Tk) (div (add Tk 63) 64))
    (defn enw-pipes-go (msl names) (if (eq (len names) 0) (list) (cons (metal_pipeline msl (head names)) (enw-pipes-go msl (tail names)))))
    (defn enw-pipes () (enw-pipes-go (em-unit) (em-names)))
    (defn enw-p (st i) (nth (nth st 3) i))
    (defn enw-go (st pi bind threads) (metal_enqueue (enw-p st pi) bind threads))
    ; ---- weights: the file mapped once at offset 0 (aligned), every member copied on the device into its own aligned buffer; (name handle) rows ----
    (defn enw-copy (ps whole row) (do (let h (metal_buf_alloc (en-bytes row))) (let c (metal_enqueue (nth ps (enw-pi-copy)) (md-bind (list whole h) (list (en-off row) (en-bytes row))) (en-bytes row))) h))
    (defn enw-map (ps whole rows) (if (eq (len rows) 0) (list) (cons (list (head (head rows)) (enw-copy ps whole (head rows))) (enw-map ps whole (tail rows)))))
    (defn enw-h (hs name) (if (eq (len hs) 0) 0 (if (str_eq (head (head hs)) name) (nth (head hs) 1) (enw-h (tail hs) name))))
    (defn enw-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (enw-cat (tail xs)))))
    (defn enw-w (hs prefix leaf) (enw-h hs (enw-cat (list prefix "." leaf))))
    (defn enw-blk (side l) (enw-cat (list side ".blocks." (int_to_str l))))
    ; ---- activations ----
    (defn enw-f32 (n) (metal_buf_alloc (mul 4 n)))
    (defn enw-per-layer (n l) (if (ge l (enw-layers)) (list) (cons (enw-f32 n) (enw-per-layer n (add l 1)))))
    (defn enw-zeros (s n) (if (ge (str_len s) n) (substring s 0 n) (enw-zeros (str_concat s s) n)))
    (defn enw-bufs ()
        (list (metal_buf_alloc 960000)                        ; 0 pcm (30 s s16)
              (enw-f32 (mul (enw-TF) 80))                       ; 1 mel
              (enw-f32 (mul 80 201))                            ; 2 filt
              (enw-f32 (mul (enw-TF) (enw-D)))                  ; 3 ht (conv1 out)
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 4 hx (the encoder's residual stream)
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 5 hq
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 6 hk
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 7 hv
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 8 ha
              (enw-f32 (mul (enw-TE) (enw-F)))                  ; 9 hf
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 10 henc (ln_post rows, written by the first cross dispatch)
              (enw-f32 (mul (enw-CTX) (enw-D)))                 ; 11 dx (CTX rows: the batched prefill)
              (enw-f32 (mul (enw-CTX) (enw-D)))                 ; 12 dq
              (enw-f32 (mul (enw-CTX) (enw-D)))                 ; 13 da
              (enw-f32 (mul (enw-CTX) (enw-F)))                 ; 14 df
              (enw-f32 (enw-V))                                 ; 15 dl (logits)
              (metal_buf_alloc 16)                              ; 16 dout
              (enw-per-layer (mul (enw-TE) (enw-D)) 0)          ; 17 cross k per layer
              (enw-per-layer (mul (enw-TE) (enw-D)) 0)          ; 18 cross v per layer
              (enw-per-layer (mul (enw-CTX) (enw-D)) 0)         ; 19 self k cache per layer
              (enw-per-layer (mul (enw-CTX) (enw-D)) 0)         ; 20 self v cache per layer
              (metal_buf_alloc (mul 4 (enw-CTX)))               ; 21 ids for the batched prefill
              (metal_buf_alloc 32)                              ; 22 shp: Te pos Tdec Tf 0
              (enw-f32 (enw-TF))                                ; 23 frame maxima
              (metal_buf_alloc (mul 2 (enw-V)))                 ; 24 a zero bias (half) for the weights that carry none
              (metal_buf_alloc 1024)                            ; 25 the argmax's first-stage (value, index) pairs
              (enw-f32 (mul 6 (mul 24 66)))                     ; 26 the cross attention's per-chunk (m, l, acc[64]) partials
              (enw-f32 (mul 2 (enw-TE)))))                      ; 27 each row's layernorm (mean, rsqrt), read by every tile
    (defn enw-b (st i) (nth (nth st 4) i))
    (defn enw-bl (st i l) (nth (nth (nth st 4) i) l))
    (defn enw-mel (st) (enw-b st 1))
    (defn enw-henc (st) (enw-b st 10))
    (defn enw-shp (st) (enw-b st 22))
    ; ---- layer tables: every handle a layer needs, resolved once at open, in a fixed order ----
    (defn enw-enc-names () (list "attn_ln.weight" "attn_ln.bias" "attn.query.weight" "attn.query.bias" "attn.key.weight" "attn.value.weight" "attn.value.bias" "attn.out.weight" "attn.out.bias" "mlp_ln.weight" "mlp_ln.bias" "mlp1.weight" "mlp1.bias" "mlp2.weight" "mlp2.bias"))
    (defn enw-dec-names () (append (enw-enc-names) (list "cross_attn_ln.weight" "cross_attn_ln.bias" "cross_attn.query.weight" "cross_attn.query.bias" "cross_attn.key.weight" "cross_attn.value.weight" "cross_attn.value.bias" "cross_attn.out.weight" "cross_attn.out.bias")))
    (defn enw-table (hs prefix names) (if (eq (len names) 0) (list) (cons (enw-w hs prefix (head names)) (enw-table hs prefix (tail names)))))
    (defn enw-tables (hs side names l) (if (ge l (enw-layers)) (list) (cons (enw-table hs (enw-blk side l) names) (enw-tables hs side names (add l 1)))))
    (defn enw-lt (st side l) (nth (nth st (if (str_eq side "encoder") 6 7)) l))
    (defn enw-hs (st) (nth st 2))
    ; ---- bindings, built once: the fused gemm over rows (tiles), the fused gemm for one row (mv), attention over rows, attention for one row ----
    ; shape slots: 0 Te, 1 pos, 2 Tdec, 3 Tf, 4 zero
    (defn enw-lnst (st) (enw-b st 27))
    (defn enw-gbind (st x g b w0 b0 w1 b1 w2 b2 y0 y1 y2 r hout N K Nper mode hasln tslot yslot wanth)
        (md-bind16 (list x g b w0 b0 w1 b1 w2 b2 y0 y1 y2 r hout (enw-shp st) (enw-lnst st)) (list N K Nper mode hasln tslot yslot wanth 0 0) 256 0 1 0))
    ; a layernorm's row statistics, computed once for rows shp[tslot] of x and read by every tile that follows
    (defn enw-lnbind (st x K tslot) (md-bind16 (list x (enw-lnst st) (enw-shp st)) (list K tslot) 256 0 1 0))
    ; the conv1d as the tiled gemm: x staged as im2col on the fly, K = 3*Cin, rows Tout = shp[tslot], Tin = shp[3] (the frame count)
    (defn enw-cbind (st x w b y Cin Cout tslot cstride)
        (md-bind16 (list x w b w b w b w b y y y y y (enw-shp st) (enw-lnst st)) (list Cout (mul 3 Cin) Cout 1 0 tslot 4 0 cstride 3) 256 0 1 0))
    (defn enw-mbind (st x g b w0 b0 w1 b1 w2 b2 y0 y1 y2 r N K Nper mode hasln yslot lastrow)
        (md-bind16 (list x g b w0 b0 w1 b1 w2 b2 y0 y1 y2 r r (enw-shp st) (enw-lnst st)) (list N K Nper mode hasln yslot lastrow) 256 0 1 0))
    (defn enw-abind (st q k v y tqslot tkmode) (md-bind16 (list q k v y (enw-shp st)) (list (enw-H) tqslot tkmode) 256 0 1 0))
    (defn enw-dbind (st q k v y tkmode) (md-bind16 (list q k v y (enw-shp st)) (list (enw-H) tkmode) 256 6152 1 0))
    ; the split cross attention for one row: the chunk pass writes partials, the fold pass writes the row
    (defn enw-xbind (st q k v tkmode) (md-bind16 (list q k v (enw-b st 26) (enw-shp st)) (list (enw-H) tkmode) 64 0 1 0))
    (defn enw-xfbind (st y tkmode) (md-bind16 (list (enw-b st 26) y (enw-shp st)) (list (enw-H) tkmode) 64 0 1 0))
    (defn enw-t32 (n) (div (add n 31) 32))
    (defn enw-t8 (n) (div (add n 7) 8))
    ; an encoder layer: ln+qkv, attention, out+residual, ln+mlp1+gelu, mlp2+residual
    (defn enw-enc-binds-l (st l)
        (do (let w (enw-lt st "encoder" l)) (let Z (enw-b st 24)) (let D (enw-D)) (let F (enw-F))
            (let hx (enw-b st 4)) (let hq (enw-b st 5)) (let hk (enw-b st 6)) (let hv (enw-b st 7)) (let ha (enw-b st 8)) (let hf (enw-b st 9))
            (list (enw-gbind st hx (nth w 0) (nth w 1) (nth w 2) (nth w 3) (nth w 4) Z (nth w 5) (nth w 6) hq hk hv hx hx (mul 3 D) D D 0 1 0 4 0)
                  (enw-abind st hq hk hv ha 0 0)
                  (enw-gbind st ha (nth w 0) (nth w 1) (nth w 7) (nth w 8) (nth w 7) (nth w 8) (nth w 7) (nth w 8) hx hx hx hx hx D D D 2 0 0 4 0)
                  (enw-gbind st hx (nth w 9) (nth w 10) (nth w 11) (nth w 12) (nth w 11) (nth w 12) (nth w 11) (nth w 12) hf hf hf hf hf F D F 1 1 0 4 0)
                  (enw-gbind st hf (nth w 9) (nth w 10) (nth w 13) (nth w 14) (nth w 13) (nth w 14) (nth w 13) (nth w 14) hx hx hx hx hx D F D 2 0 0 4 0))))
    (defn enw-enc-binds (st l) (if (ge l (enw-layers)) (list) (cons (enw-enc-binds-l st l) (enw-enc-binds st (add l 1)))))
    ; the cross caches: ln_post fused into each layer's k/v gemm (the first also writes the normalised rows to henc)
    (defn enw-cross-bind-l (st l)
        (do (let w (enw-lt st "decoder" l)) (let hs (enw-hs st)) (let Z (enw-b st 24)) (let D (enw-D))
            (enw-gbind st (enw-b st 4) (enw-h hs "encoder.ln_post.weight") (enw-h hs "encoder.ln_post.bias") (nth w 19) Z (nth w 20) (nth w 21) (nth w 20) (nth w 21) (enw-bl st 17 l) (enw-bl st 18 l) (enw-bl st 18 l) (enw-b st 4) (enw-henc st) (mul 2 D) D D 0 1 0 4 (if (eq l 0) 1 0))))
    (defn enw-cross-binds (st l) (if (ge l (enw-layers)) (list) (cons (enw-cross-bind-l st l) (enw-cross-binds st (add l 1)))))
    ; a decoder layer for one row: ln+qkv (k/v straight into the caches at pos), own attention, out+residual, ln+cross-q, cross attention, out+residual, ln+mlp1+gelu, mlp2+residual
    (defn enw-dec-binds-l (st l)
        (do (let w (enw-lt st "decoder" l)) (let Z (enw-b st 24)) (let D (enw-D)) (let F (enw-F))
            (let dx (enw-b st 11)) (let dq (enw-b st 12)) (let da (enw-b st 13)) (let df (enw-b st 14)) (let kc (enw-bl st 19 l)) (let vc (enw-bl st 20 l))
            (list (enw-mbind st dx (nth w 0) (nth w 1) (nth w 2) (nth w 3) (nth w 4) Z (nth w 5) (nth w 6) dq kc vc dx (mul 3 D) D D 0 1 1 0)
                  (enw-dbind st dq kc vc da 1)
                  (enw-mbind st da (nth w 0) (nth w 1) (nth w 7) (nth w 8) (nth w 7) (nth w 8) (nth w 7) (nth w 8) dx dx dx dx D D D 2 0 4 0)
                  (enw-mbind st dx (nth w 15) (nth w 16) (nth w 17) (nth w 18) (nth w 17) (nth w 18) (nth w 17) (nth w 18) dq dq dq dx D D D 0 1 4 0)
                  (enw-xbind st dq (enw-bl st 17 l) (enw-bl st 18 l) 2)
                  (enw-mbind st da (nth w 0) (nth w 1) (nth w 22) (nth w 23) (nth w 22) (nth w 23) (nth w 22) (nth w 23) dx dx dx dx D D D 2 0 4 0)
                  (enw-mbind st dx (nth w 9) (nth w 10) (nth w 11) (nth w 12) (nth w 11) (nth w 12) (nth w 11) (nth w 12) df df df dx F D F 1 1 4 0)
                  (enw-mbind st df (nth w 9) (nth w 10) (nth w 13) (nth w 14) (nth w 13) (nth w 14) (nth w 13) (nth w 14) dx dx dx dx D F D 2 0 4 0)
                  (enw-xfbind st da 2))))
    (defn enw-dec-binds (st l) (if (ge l (enw-layers)) (list) (cons (enw-dec-binds-l st l) (enw-dec-binds st (add l 1)))))
    ; the same layer over rows (the batched prefill): rows Tdec from pos, causal own attention
    (defn enw-pre-binds-l (st l)
        (do (let w (enw-lt st "decoder" l)) (let Z (enw-b st 24)) (let D (enw-D)) (let F (enw-F))
            (let dx (enw-b st 11)) (let dq (enw-b st 12)) (let da (enw-b st 13)) (let df (enw-b st 14)) (let kc (enw-bl st 19 l)) (let vc (enw-bl st 20 l))
            (list (enw-gbind st dx (nth w 0) (nth w 1) (nth w 2) (nth w 3) (nth w 4) Z (nth w 5) (nth w 6) dq kc vc dx dx (mul 3 D) D D 0 1 2 1 0)
                  (enw-abind st dq kc vc da 2 1)
                  (enw-gbind st da (nth w 0) (nth w 1) (nth w 7) (nth w 8) (nth w 7) (nth w 8) (nth w 7) (nth w 8) dx dx dx dx dx D D D 2 0 2 4 0)
                  (enw-gbind st dx (nth w 15) (nth w 16) (nth w 17) (nth w 18) (nth w 17) (nth w 18) (nth w 17) (nth w 18) dq dq dq dx dx D D D 0 1 2 4 0)
                  (enw-abind st dq (enw-bl st 17 l) (enw-bl st 18 l) da 2 2)
                  (enw-gbind st da (nth w 0) (nth w 1) (nth w 22) (nth w 23) (nth w 22) (nth w 23) (nth w 22) (nth w 23) dx dx dx dx dx D D D 2 0 2 4 0)
                  (enw-gbind st dx (nth w 9) (nth w 10) (nth w 11) (nth w 12) (nth w 11) (nth w 12) (nth w 11) (nth w 12) df df df dx dx F D F 1 1 2 4 0)
                  (enw-gbind st df (nth w 9) (nth w 10) (nth w 13) (nth w 14) (nth w 13) (nth w 14) (nth w 13) (nth w 14) dx dx dx dx dx D F D 2 0 2 4 0))))
    (defn enw-pre-binds (st l) (if (ge l (enw-layers)) (list) (cons (enw-pre-binds-l st l) (enw-pre-binds st (add l 1)))))
    ; the rest: melnorm, conv1, conv2, positions, ln+logits (row 0; the prefill's last row), the three argmax windows (tongue, text, text-or-timestamp)
    ; an argmax is a PAIR of binds now — the fold over G groups, then the fold over their G answers
    (defn enw-argmax-bind (st lo hi lo2 hi2)
        (list (md-bind16 (list (enw-b st 15) (enw-b st 16) (enw-b st 25)) (list lo hi lo2 hi2 0 (em-argmax-G)) 256 0 1 0)
              (md-bind16 (list (enw-b st 15) (enw-b st 16) (enw-b st 25)) (list lo hi lo2 hi2 1 (em-argmax-G)) 256 0 1 0)))
    (defn enw-argmax-go (st pair)
        (add (enw-go st (enw-pi-argmax) (head pair) (em-argmax-G))
             (enw-go st (enw-pi-argmax) (nth pair 1) 1)))
    ; the group count the mv kernel's own row rule asks for: eight simdgroups, each taking em-mv-rows(N) outputs
    (defn enw-mv-groups (n) (do (let per (mul 8 (em-mv-rows n))) (div (add n (sub per 1)) per)))
    (defn enw-misc-binds (st)
        (do (let hs (enw-hs st)) (let Z (enw-b st 24)) (let D (enw-D)) (let tok (enw-h hs "decoder.token_embedding.weight")) (let lw (enw-h hs "decoder.ln.weight")) (let lb (enw-h hs "decoder.ln.bias"))
            (list (md-bind16 (list (enw-mel st) (enw-b st 23) (enw-shp st)) (list) 256 0 1 0)
                  (enw-cbind st (enw-mel st) (enw-h hs "encoder.conv1.weight") (enw-h hs "encoder.conv1.bias") (enw-b st 3) 80 D 3 1)
                  (enw-cbind st (enw-b st 3) (enw-h hs "encoder.conv2.weight") (enw-h hs "encoder.conv2.bias") (enw-b st 4) D D 0 2)
                  (md-bind (list (enw-b st 4) (enw-shp st)) (list D))
                  (enw-mbind st (enw-b st 11) lw lb tok Z tok Z tok Z (enw-b st 15) (enw-b st 15) (enw-b st 15) (enw-b st 11) (enw-V) D (enw-V) 0 1 4 0)
                  (enw-mbind st (enw-b st 11) lw lb tok Z tok Z tok Z (enw-b st 15) (enw-b st 15) (enw-b st 15) (enw-b st 11) (enw-V) D (enw-V) 0 1 4 1)
                  (enw-argmax-bind st (enw-lang-lo) (enw-lang-hi) 0 0)
                  (enw-argmax-bind st 0 (add (enw-eot) 1) 0 0)
                  (enw-argmax-bind st 0 (add (enw-eot) 1) (enw-ts0) (enw-V))
                  (enw-lnbind st (enw-b st 4) D 0)
                  (enw-lnbind st (enw-b st 11) D 2))))
    (defn enw-binds (st) (nth st 8))
    (defn enw-bind-enc (st l i) (nth (nth (nth (enw-binds st) 0) l) i))
    (defn enw-bind-cross (st l) (nth (nth (enw-binds st) 1) l))
    (defn enw-bind-dec (st l i) (nth (nth (nth (enw-binds st) 2) l) i))
    (defn enw-bind-pre (st l i) (nth (nth (nth (enw-binds st) 3) l) i))
    (defn enw-bind-misc (st i) (nth (nth (enw-binds st) 4) i))
    ; the argmax window asked for, from the three stored or built on the spot
    (defn enw-argmax-pick (st lo hi lo2 hi2)
        (if (and (eq lo (enw-lang-lo)) (and (eq hi (enw-lang-hi)) (eq hi2 0))) (enw-bind-misc st 6)
        (if (and (eq lo 0) (and (eq hi (add (enw-eot) 1)) (eq hi2 0))) (enw-bind-misc st 7)
        (if (and (eq lo 0) (and (eq hi (add (enw-eot) 1)) (and (eq lo2 (enw-ts0)) (eq hi2 (enw-V))))) (enw-bind-misc st 8)
            (enw-argmax-bind st lo hi lo2 hi2)))))
    ; ---- the open state: (path rows hs pipes bufs toklines enc-tables dec-tables binds) ----
    (defn enw-open (path tokpath)
        (do (let rows (en-table path))
            (let ps (enw-pipes))
            (let whole (metal_buf_from_file path 0 (file_size path)))
            (let hs (enw-map ps whole rows))
            (let bs (enw-bufs))
            (let st0 (list path rows hs ps bs (split-on (en-text (read_file tokpath)) (byte_to_str 10)) (enw-tables hs "encoder" (enw-enc-names) 0) (enw-tables hs "decoder" (enw-dec-names) 0)))
            (let st (append st0 (list (list (enw-enc-binds st0 0) (enw-cross-binds st0 0) (enw-dec-binds st0 0) (enw-pre-binds st0 0) (enw-misc-binds st0)))))
            (let z1 (metal_buf_write (enw-shp st) 0 (enw-zeros (byte_to_str 0) 32)))
            (let z2 (metal_buf_write (enw-b st 24) 0 (enw-zeros (byte_to_str 0) (mul 2 (enw-V)))))
            (let bank (metal_enqueue (enw-p st (enw-pi-melbank)) (md-bind (list (enw-b st 2)) (list)) (mul 80 201)))
            (let s (metal_sync))
            st))
    ; ---- encoder over L samples of s16 pcm ----
    (defn enw-enc-layer (st l T)
        (do (let D (enw-D)) (let r64 (enw-t32 T)) (let ln (enw-bind-misc st 9))
            (let a0 (enw-go st (enw-pi-lnstat) ln T))
            (let a1 (enw-go st (enw-pi-gemm) (enw-bind-enc st l 0) (mul (enw-t32 (mul 3 D)) r64)))
            (let a2 (enw-go st (enw-pi-attn) (enw-bind-enc st l 1) (mul (enw-H) (enw-t8 T))))
            (let a3 (enw-go st (enw-pi-gemm) (enw-bind-enc st l 2) (mul (enw-t32 D) r64)))
            (let b0 (enw-go st (enw-pi-lnstat) ln T))
            (let a4 (enw-go st (enw-pi-gemm) (enw-bind-enc st l 3) (mul (enw-t32 (enw-F)) r64)))
            (let a5 (enw-go st (enw-pi-gemm) (enw-bind-enc st l 4) (mul (enw-t32 D) r64)))
            (add a1 (add a2 (add a3 (add a4 a5))))))
    (defn enw-enc-layers (st l T acc) (if (ge l (enw-layers)) acc (enw-enc-layers st (add l 1) T (add acc (enw-enc-layer st l T)))))
    (defn enw-cross (st l T) (if (ge l (enw-layers)) 0 (add (enw-go st (enw-pi-gemm) (enw-bind-cross st l) (mul (enw-t32 (mul 2 (enw-D))) (enw-t32 T))) (enw-cross st (add l 1) T))))
    ; returns Tenc, the encoder positions; the encoded window rests in henc and the cross caches
    (defn enw-encode (st pcm)
        (do (let L (div (str_len pcm) 2))
            (let Tf (div L 160))
            (let Te (div Tf 2))
            (let D (enw-D))
            (let w0 (metal_buf_write (enw-b st 0) 0 pcm))
            (let s1 (metal_enqueue (enw-p st (enw-pi-spec)) (md-bind16 (list (enw-b st 0) (enw-b st 2) (enw-mel st) (enw-b st 23) (enw-shp st)) (list L Tf) 256 0 1 0) Tf))
            (let s2 (enw-go st (enw-pi-melnorm) (enw-bind-misc st 0) (div (add (mul Tf 80) 255) 256)))
            (let c1 (enw-go st (enw-pi-gemm) (enw-bind-misc st 1) (mul (enw-t32 D) (enw-t32 Tf))))
            (let c2 (enw-go st (enw-pi-gemm) (enw-bind-misc st 2) (mul (enw-t32 D) (enw-t32 Te))))
            (let ap (enw-go st (enw-pi-addpos) (enw-bind-misc st 3) (mul Te D)))
            (let ls (enw-enc-layers st 0 Te 0))
            (let lp (enw-go st (enw-pi-lnstat) (enw-bind-misc st 9) Te))
            (let cr (enw-cross st 0 Te))
            (let s (metal_sync))
            Te))
    ; ---- one decoder step: token id at position pos; argmax over [lo, hi) and [lo2, hi2) ----
    (defn enw-dec-layer (st l C)
        (do (let D (enw-D)) (let g48 (enw-t8 D))
            (let a1 (enw-go st (enw-pi-mv) (enw-bind-dec st l 0) (enw-t8 (mul 3 D))))
            (let a2 (enw-go st (enw-pi-attn-dec) (enw-bind-dec st l 1) (enw-H)))
            (let a3 (enw-go st (enw-pi-mv) (enw-bind-dec st l 2) g48))
            (let a4 (enw-go st (enw-pi-mv) (enw-bind-dec st l 3) g48))
            (let a5 (enw-go st (enw-pi-attn-x) (enw-bind-dec st l 4) (mul (enw-H) C)))
            (let a5b (enw-go st (enw-pi-attn-xfin) (enw-bind-dec st l 8) (enw-H)))
            (let a6 (enw-go st (enw-pi-mv) (enw-bind-dec st l 5) g48))
            (let a7 (enw-go st (enw-pi-mv) (enw-bind-dec st l 6) (enw-t8 (enw-F))))
            (let a8 (enw-go st (enw-pi-mv) (enw-bind-dec st l 7) g48))
            (add a1 (add a2 (add a3 (add a4 (add a5 (add a5b (add a6 (add a7 a8))))))))))
    (defn enw-dec-layers (st l C acc) (if (ge l (enw-layers)) acc (enw-dec-layers st (add l 1) C (add acc (enw-dec-layer st l C)))))
    (defn enw-step4 (st id pos Te lo hi lo2 hi2)
        (do (let hs (enw-hs st))
            (let e (metal_enqueue (enw-p st (enw-pi-embed)) (md-bind (list (enw-h hs "decoder.token_embedding.weight") (enw-h hs "decoder.positional_embedding") (enw-b st 11) (enw-shp st)) (list id pos (enw-D))) (enw-D)))
            (let ls (enw-dec-layers st 0 (enw-xchunks Te) 0))
            (let lg (enw-go st (enw-pi-mv) (enw-bind-misc st 4) (enw-mv-groups (enw-V))))
            (let am (enw-argmax-go st (enw-argmax-pick st lo hi lo2 hi2)))
            (let s (metal_sync))
            (en-u32 (en-text (metal_buf_read (enw-b st 16) 0 4)) 0)))
    (defn enw-step (st id pos Te lo hi) (enw-step4 st id pos Te lo hi 0 0))
    (defn enw-ts? (id) (ge id (enw-ts0)))
    ; a step whose argmax may answer text, end, or a timestamp: the decoder keeps its own clock
    (defn enw-step2 (st id pos Te) (enw-step4 st id pos Te 0 (add (enw-eot) 1) (enw-ts0) (enw-V)))
    ; a loop of period one, two or three repeated three times is the model going round: stop paying for it
    (defn enw-looping? (id acc) (if (lt (len acc) 5) 0 (if (and (eq id (nth acc 0)) (eq id (nth acc 1))) 1 (if (and (eq id (nth acc 1)) (and (eq (nth acc 0) (nth acc 2)) (eq (nth acc 1) (nth acc 3)))) 1 (if (and (eq id (nth acc 2)) (and (eq (nth acc 0) (nth acc 3)) (eq (nth acc 1) (nth acc 4)))) 1 0)))))
    ; the last twelve tokens carrying four or fewer distinct ids is the model going round: stop paying for it
    (defn enw-member? (xs x) (if (eq (len xs) 0) 0 (if (eq (head xs) x) 1 (enw-member? (tail xs) x))))
    (defn enw-distinct (xs seen) (if (eq (len xs) 0) (len seen) (enw-distinct (tail xs) (if (eq (enw-member? seen (head xs)) 1) seen (cons (head xs) seen)))))
    (defn enw-take (xs n) (if (or (eq n 0) (eq (len xs) 0)) (list) (cons (head xs) (enw-take (tail xs) (sub n 1)))))
    (defn enw-round? (nid acc) (if (lt (len acc) 11) 0 (if (le (enw-distinct (cons nid (enw-take acc 11)) (list)) 4) 1 0)))
    ; the ends of a line are the world's: end-of-text, the decoder's clock past the window (its clock runs ahead, so 1.5x + 1 s), going round, or more tokens than the audio could carry (cap from the seconds since the cut)
    (defn enw-greedy2 (st id pos Te cap acc)
        (do (let nid (enw-step2 st id pos Te))
            (let maxtick (add (div (mul Te 3) 1) 50))
            (if (or (eq nid (enw-eot)) (or (ge (len acc) cap) (or (eq (enw-looping? nid acc) 1) (or (eq (enw-round? nid acc) 1) (and (enw-ts? nid) (gt (sub nid (enw-ts0)) maxtick)))))) (reverse acc) (enw-greedy2 st nid (add pos 1) Te cap (cons nid acc)))))
    ; transcribe from a tick (20 ms units) into the window: the cut point is handed to the decoder as its first timestamp,
    ; so only what came after it is spoken; returns (lang-token ids) with timestamps kept in ids
    (defn enw-transcribe-from (st Te tick cap)
        (do (let lang (enw-step st (enw-sot) 0 Te (enw-lang-lo) (enw-lang-hi)))
            (let t1 (enw-step st lang 1 Te 0 (add (enw-eot) 1)))
            (let t2 (enw-step st (enw-tok-transcribe) 2 Te 0 (add (enw-eot) 1)))
            (list lang (enw-greedy2 st (add (enw-ts0) tick) 3 Te cap (list)))))
    ; the decoder's last word on time: the final timestamp if the line closed with one, else -1
    (defn enw-last-ts (ids) (if (eq (len ids) 0) (sub 0 1) (do (let last (nth ids (sub (len ids) 1))) (if (enw-ts? last) (sub last (enw-ts0)) (sub 0 1)))))
    ; ---- greedy line: prompt sot, lang, transcribe, notimestamps; then text until eot or cap ----
    (defn enw-greedy (st pos Te cap acc)
        (do (let id (enw-step st (if (eq (len acc) 0) (enw-notimestamps) (head acc)) pos Te 0 (add (enw-eot) 1)))
            (if (or (eq id (enw-eot)) (ge (len acc) cap)) (reverse acc) (enw-greedy st (add pos 1) Te cap (cons id acc)))))
    ; returns (lang-token ids)
    (defn enw-transcribe (st Te cap)
        (do (let lang (enw-step st (enw-sot) 0 Te (enw-lang-lo) (enw-lang-hi)))
            (let t1 (enw-step st lang 1 Te 0 (add (enw-eot) 1)))
            (let t2 (enw-step st (enw-tok-transcribe) 2 Te 0 (add (enw-eot) 1)))
            (list lang (enw-greedy st 3 Te cap (list)))))
    ; ---- words: rank -> base64 line -> bytes ----
    (defn enw-bytes-str (xs) (if (eq (len xs) 0) "" (str_concat (byte_to_str (head xs)) (enw-bytes-str (tail xs)))))
    (defn enw-tok (st id) (if (ge id (enw-eot)) "" (do (let line (nth (nth st 5) id)) (let sp (str_find line " " 0)) (if (lt sp 0) "" (enw-bytes-str (base64-decode (substring line 0 sp)))))))
    (defn enw-text (st ids) (if (eq (len ids) 0) "" (str_concat (enw-tok st (head ids)) (enw-text st (tail ids)))))
    ; the language token's own name is the code the reference uses (en, fa, pt, ...): the tiktoken has no line for it, so a small table
    (defn enw-langs () (list "en" "zh" "de" "es" "ru" "ko" "fr" "ja" "pt" "tr" "pl" "ca" "nl" "ar" "sv" "it" "id" "hi" "fi" "vi" "he" "uk" "el" "ms" "cs" "ro" "da" "hu" "ta" "no" "th" "ur" "hr" "bg" "lt" "la" "mi" "ml" "cy" "sk" "te" "fa" "lv" "bn" "sr" "az" "sl" "kn" "et" "mk" "br" "eu" "is" "hy" "ne" "mn" "bs" "kk" "sq" "sw" "gl" "mr" "pa" "si" "km" "sn" "yo" "so" "af" "oc" "ka" "be" "tg" "sd" "gu" "am" "yi" "lo" "uz" "fo" "ht" "ps" "tk" "nn" "mt" "sa" "lb" "my" "bo" "tl" "mg" "as" "tt" "haw" "ln" "ha" "ba" "jw" "su"))
    (defn enw-lang-code (tok) (do (let i (sub tok (enw-lang-lo))) (if (or (lt i 0) (ge i (len (enw-langs)))) "?" (nth (enw-langs) i))))
    0)
; ---- the batched prefill: T tokens through the decoder in one pass, the argmax of the last row ----
; the row kernels the encoder uses, from pos: k/v land in their caches from pos, own attention is causal from pos, cross attention reads the encoded window
(do
    (defn enw-ids-bytes (ids acc) (if (eq (len ids) 0) acc (enw-ids-bytes (tail ids) (str_concat acc (md-le32 (head ids))))))
    (defn enw-pre-layer (st l T)
        (do (let D (enw-D)) (let r64 (enw-t32 T)) (let g6 (mul (enw-t32 D) r64)) (let ga (mul (enw-H) (enw-t8 T))) (let ln (enw-bind-misc st 10))
            (let n1 (enw-go st (enw-pi-lnstat) ln T))
            (let a1 (enw-go st (enw-pi-gemm) (enw-bind-pre st l 0) (mul (enw-t32 (mul 3 D)) r64)))
            (let a2 (enw-go st (enw-pi-attn) (enw-bind-pre st l 1) ga))
            (let a3 (enw-go st (enw-pi-gemm) (enw-bind-pre st l 2) g6))
            (let n2 (enw-go st (enw-pi-lnstat) ln T))
            (let a4 (enw-go st (enw-pi-gemm) (enw-bind-pre st l 3) g6))
            (let a5 (enw-go st (enw-pi-attn) (enw-bind-pre st l 4) ga))
            (let a6 (enw-go st (enw-pi-gemm) (enw-bind-pre st l 5) g6))
            (let n3 (enw-go st (enw-pi-lnstat) ln T))
            (let a7 (enw-go st (enw-pi-gemm) (enw-bind-pre st l 6) (mul (enw-t32 (enw-F)) r64)))
            (let a8 (enw-go st (enw-pi-gemm) (enw-bind-pre st l 7) g6))
            0))
    (defn enw-pre-layers (st l T) (if (ge l (enw-layers)) 0 (do (let x (enw-pre-layer st l T)) (enw-pre-layers st (add l 1) T))))
    ; ids from pos0; answers the argmax over (lo hi) and (lo2 hi2) of the last row's logits
    (defn enw-prefill (st ids pos0 Te lo hi lo2 hi2)
        (do (let hs (enw-hs st))
            (let T (len ids))
            (let w (metal_buf_write (enw-b st 21) 0 (enw-ids-bytes ids "")))
            (let e (metal_enqueue (enw-p st (enw-pi-embed-n)) (md-bind (list (enw-h hs "decoder.token_embedding.weight") (enw-h hs "decoder.positional_embedding") (enw-b st 21) (enw-b st 11) (enw-shp st)) (list pos0 (enw-D) T)) (mul T (enw-D))))
            (let ls (enw-pre-layers st 0 T))
            (let lg (enw-go st (enw-pi-mv) (enw-bind-misc st 5) (enw-mv-groups (enw-V))))
            (let am (enw-argmax-go st (enw-argmax-pick st lo hi lo2 hi2)))
            (let s (metal_sync))
            (en-u32 (en-text (metal_buf_read (enw-b st 16) 0 4)) 0)))
    ; transcribe from a tick with the tongue known (or detected when lang < 0) and an agreed text prefix prefilled;
    ; returns (lang ids) where ids = prefix + what the decoder added (timestamps kept)
    ; the tongue: the argmax over the language window, unless it lies outside the three the glass offers and one of them is within 3 logits of it
    (defn enw-f32-of (b i) (do (let bits (en-u32 b i)) (let s (div bits 2147483648)) (let e (mod (div bits 8388608) 256)) (let m (mod bits 8388608)) (if (eq e 0) 0.0 (if (eq e 255) -99999.0 (mul (if (eq s 1) -1.0 1.0) (mul (add 1.0 (div (str_to_float (int_to_str m)) 8388608.0)) (fq-pow2 (sub e 127))))))))
    (defn enw-lang-logit (b tok) (enw-f32-of b (mul 4 (sub tok (enw-lang-lo)))))
    (defn enw-three () (list 50259 50300 50267))
    (defn enw-best-of (b toks best bv) (if (eq (len toks) 0) (list best bv) (do (let v (enw-lang-logit b (head toks))) (if (gt v bv) (enw-best-of b (tail toks) (head toks) v) (enw-best-of b (tail toks) best bv)))))
    (defn enw-lang-pick (st top) (if (or (eq top 50259) (or (eq top 50300) (eq top 50267))) top (do (let b (en-text (metal_buf_read (enw-b st 15) (mul 4 (enw-lang-lo)) (mul 4 99)))) (let three (enw-best-of b (enw-three) 50259 -99999.0)) (if (ge (add (nth three 1) 3.0) (enw-lang-logit b top)) (head three) top))))
    (defn enw-transcribe-from2 (st Te tick cap lang prefix)
        (do (let l (if (lt lang 0) (enw-lang-pick st (enw-prefill st (list (enw-sot)) 0 Te (enw-lang-lo) (enw-lang-hi) 0 0)) lang))
            (let head-ids (append (list l (enw-tok-transcribe) (add (enw-ts0) tick)) prefix))
            (let first (enw-prefill st (if (lt lang 0) head-ids (cons (enw-sot) head-ids)) (if (lt lang 0) 1 0) Te 0 (add (enw-eot) 1) (enw-ts0) (enw-V)))
            (let p0 (add 1 (len head-ids)))
            (let room (sub cap (len prefix)))
            (let tail-ids (if (or (eq first (enw-eot)) (le room 0)) (list) (enw-greedy2 st first p0 Te (if (lt room 4) 4 room) (list first))))
            (list l (append prefix tail-ids))))
    0)
