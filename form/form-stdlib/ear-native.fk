; ear-native.fk — whisper-tiny as the body's own pass: weights mapped straight off the model file
; (ear-npz), the kernels the body emits (ear-msl), activations resident on the device between
; dispatches, one read-back of four bytes per token. The encoder runs once per audio window, the
; decoder greedily until <|endoftext|> or the line cap; the tongue is the argmax over the language
; window after <|startoftranscript|>. Text comes back through the reference's own token table
; (multilingual.tiktoken: base64 bytes per rank) and the body's base64. No host tool stands
; between the microphone bytes and the words.
; preludes: form/form-stdlib/ear-npz.fk form/form-stdlib/ear-msl.fk form/form-stdlib/metal-door.fk form/form-stdlib/str-byte-at.fk form/form-stdlib/base64.fk
(do
    (defn enw-D () 384)
    (defn enw-F () 1536)
    (defn enw-H () 6)
    (defn enw-HD () 64)
    (defn enw-V () 51865)
    (defn enw-CTX () 448)
    (defn enw-TF () 3000)
    (defn enw-TE () 1500)
    (defn enw-layers () 4)
    (defn enw-sot () 50258)
    (defn enw-eot () 50257)
    (defn enw-lang-lo () 50259)
    (defn enw-lang-hi () 50358)
    (defn enw-tok-transcribe () 50359)
    (defn enw-notimestamps () 50363)
    ; ---- weights: the file mapped once at offset 0 (aligned), every member copied on the device into its own aligned buffer; (name handle) rows ----
    (defn enw-copy (ps whole row) (do (let h (metal_buf_alloc (en-bytes row))) (let c (metal_enqueue (nth ps 11) (md-bind (list whole h) (list (en-off row) (en-bytes row))) (en-bytes row))) h))
    (defn enw-map (ps whole rows) (if (eq (len rows) 0) (list) (cons (list (head (head rows)) (enw-copy ps whole (head rows))) (enw-map ps whole (tail rows)))))
    (defn enw-h (hs name) (if (eq (len hs) 0) 0 (if (str_eq (head (head hs)) name) (nth (head hs) 1) (enw-h (tail hs) name))))
    (defn enw-cat (xs) (if (eq (len xs) 0) "" (str_concat (head xs) (enw-cat (tail xs)))))
    (defn enw-w (hs prefix leaf) (enw-h hs (enw-cat (list prefix "." leaf))))
    (defn enw-blk (side l) (enw-cat (list side ".blocks." (int_to_str l))))
    ; ---- pipelines, in em-names order ----
    (defn enw-pipes-go (msl names) (if (eq (len names) 0) (list) (cons (metal_pipeline msl (head names)) (enw-pipes-go msl (tail names)))))
    (defn enw-pipes () (enw-pipes-go (em-unit) (em-names)))
    (defn enw-p (st i) (nth (nth st 3) i))
    ; ---- activations ----
    (defn enw-f32 (n) (metal_buf_alloc (mul 4 n)))
    (defn enw-per-layer (n l) (if (ge l (enw-layers)) (list) (cons (enw-f32 n) (enw-per-layer n (add l 1)))))
    (defn enw-bufs ()
        (list (metal_buf_alloc 960000)                        ; 0 pcm (30 s s16)
              (enw-f32 (mul (enw-TF) 201))                      ; 1 power
              (enw-f32 (mul (enw-TF) 80))                       ; 2 mel
              (enw-f32 (mul 80 201))                            ; 3 filt
              (enw-f32 (mul (enw-TF) (enw-D)))                  ; 4 ht (conv1 out)
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 5 hx
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 6 hn
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 7 hq
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 8 hk
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 9 hv
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 10 ha
              (enw-f32 (mul (enw-TE) (enw-F)))                  ; 11 hf
              (enw-f32 (mul (enw-TE) (enw-D)))                  ; 12 henc
              (enw-f32 (enw-D))                                 ; 13 dx
              (enw-f32 (enw-D))                                 ; 14 dn
              (enw-f32 (enw-D))                                 ; 15 dq
              (enw-f32 (enw-D))                                 ; 16 da
              (enw-f32 (enw-F))                                 ; 17 df
              (enw-f32 (enw-V))                                 ; 18 dl (logits)
              (metal_buf_alloc 16)                              ; 19 dout
              (enw-per-layer (mul (enw-TE) (enw-D)) 0)          ; 20 cross k per layer
              (enw-per-layer (mul (enw-TE) (enw-D)) 0)          ; 21 cross v per layer
              (enw-per-layer (mul (enw-CTX) (enw-D)) 0)         ; 22 self k cache per layer
              (enw-per-layer (mul (enw-CTX) (enw-D)) 0)))       ; 23 self v cache per layer
    (defn enw-b (st i) (nth (nth st 4) i))
    (defn enw-bl (st i l) (nth (nth (nth st 4) i) l))
    ; ---- the open state: (path rows hs pipes bufs toklines) ----
    (defn enw-open (path tokpath)
        (do (let rows (en-table path))
            (let ps (enw-pipes))
            (let whole (metal_buf_from_file path 0 (file_size path)))
            (let hs (enw-map ps whole rows))
            (let bs (enw-bufs))
            (let st (list path rows hs ps bs (split-on (en-text (read_file tokpath)) (byte_to_str 10))))
            (let bank (enw-run st 10 (list (enw-b st 3)) (list) (mul 80 201)))
            (let s (metal_sync))
            st))
    (defn enw-hs (st) (nth st 2))
    (defn enw-run (st pi bufs consts threads) (metal_enqueue (enw-p st pi) (md-bind bufs consts) threads))
    ; gemm: x[T][K] . w[N][K]^T (+b) -> y rows from yoff; mode 0 plain, 1 gelu, 2 add r
    (defn enw-gemm (st x w b y r T N K hasb mode yoff) (enw-run st 0 (list x w (if (eq b 0) w b) y r) (list T N K hasb mode yoff) (mul T N)))
    (defn enw-ln (st x g b y T) (enw-run st 2 (list x g b y) (list T (enw-D)) T))
    ; decode-time attention: groups = heads, 256 threads each, threadgroup scores for up to 1536 keys (+ the sum)
    (defn enw-attn-dec (st q k v y Tk) (metal_enqueue (enw-p st 12) (md-bind16 (list q k v y) (list Tk (enw-H) (enw-HD)) 256 6152 1 0) (enw-H)))
    (defn enw-attn (st q k v y Tq Tk causal qoff) (enw-run st 3 (list q k v y) (list Tq Tk (enw-H) (enw-HD) causal qoff) (mul (enw-H) Tq)))
    ; ---- encoder over L samples of s16 pcm ----
    (defn enw-enc-layer (st l T)
        (do (let hs (enw-hs st))
            (let p (enw-blk "encoder" l))
            (let hx (enw-b st 5)) (let hn (enw-b st 6)) (let hq (enw-b st 7)) (let hk (enw-b st 8)) (let hv (enw-b st 9)) (let ha (enw-b st 10)) (let hf (enw-b st 11))
            (let a1 (enw-ln st hx (enw-w hs p "attn_ln.weight") (enw-w hs p "attn_ln.bias") hn T))
            (let a2 (enw-gemm st hn (enw-w hs p "attn.query.weight") (enw-w hs p "attn.query.bias") hq hq T (enw-D) (enw-D) 1 0 0))
            (let a3 (enw-gemm st hn (enw-w hs p "attn.key.weight") 0 hk hk T (enw-D) (enw-D) 0 0 0))
            (let a4 (enw-gemm st hn (enw-w hs p "attn.value.weight") (enw-w hs p "attn.value.bias") hv hv T (enw-D) (enw-D) 1 0 0))
            (let a5 (enw-attn st hq hk hv ha T T 0 0))
            (let a6 (enw-gemm st ha (enw-w hs p "attn.out.weight") (enw-w hs p "attn.out.bias") hx hx T (enw-D) (enw-D) 1 2 0))
            (let a7 (enw-ln st hx (enw-w hs p "mlp_ln.weight") (enw-w hs p "mlp_ln.bias") hn T))
            (let a8 (enw-gemm st hn (enw-w hs p "mlp1.weight") (enw-w hs p "mlp1.bias") hf hf T (enw-F) (enw-D) 1 1 0))
            (let a9 (enw-gemm st hf (enw-w hs p "mlp2.weight") (enw-w hs p "mlp2.bias") hx hx T (enw-D) (enw-F) 1 2 0))
            (add a1 (add a2 (add a3 (add a4 (add a5 (add a6 (add a7 (add a8 a9))))))))))
    (defn enw-enc-layers (st l T acc) (if (ge l (enw-layers)) acc (enw-enc-layers st (add l 1) T (add acc (enw-enc-layer st l T)))))
    (defn enw-cross (st l T)
        (do (let hs (enw-hs st))
            (let p (enw-blk "decoder" l))
            (let ck (enw-gemm st (enw-b st 12) (enw-w hs p "cross_attn.key.weight") 0 (enw-bl st 20 l) (enw-bl st 20 l) T (enw-D) (enw-D) 0 0 0))
            (let cv (enw-gemm st (enw-b st 12) (enw-w hs p "cross_attn.value.weight") (enw-w hs p "cross_attn.value.bias") (enw-bl st 21 l) (enw-bl st 21 l) T (enw-D) (enw-D) 1 0 0))
            (if (ge (add l 1) (enw-layers)) (add ck cv) (add (add ck cv) (enw-cross st (add l 1) T)))))
    ; returns Tenc, the encoder positions; the encoded window rests in henc and the cross caches
    (defn enw-encode (st pcm)
        (do (let L (div (str_len pcm) 2))
            (let Tf (div L 160))
            (let Te (div Tf 2))
            (let hs (enw-hs st))
            (let w0 (metal_buf_write (enw-b st 0) 0 pcm))
            (let s1 (enw-run st 7 (list (enw-b st 0) (enw-b st 1)) (list L Tf) (mul Tf 201)))
            (let s2 (enw-run st 8 (list (enw-b st 1) (enw-b st 3) (enw-b st 2)) (list Tf) (mul Tf 80)))
            (let s3 (enw-run st 9 (list (enw-b st 2)) (list (mul Tf 80)) 1))
            (let c1 (enw-run st 1 (list (enw-b st 2) (enw-h hs "encoder.conv1.weight") (enw-h hs "encoder.conv1.bias") (enw-b st 4)) (list Tf Tf 80 (enw-D) 1) (mul Tf (enw-D))))
            (let c2 (enw-run st 1 (list (enw-b st 4) (enw-h hs "encoder.conv2.weight") (enw-h hs "encoder.conv2.bias") (enw-b st 5)) (list Tf Te (enw-D) (enw-D) 2) (mul Te (enw-D))))
            (let ap (enw-run st 4 (list (enw-b st 5)) (list Te (enw-D)) (mul Te (enw-D))))
            (let ls (enw-enc-layers st 0 Te 0))
            (let lp (enw-ln st (enw-b st 5) (enw-h hs "encoder.ln_post.weight") (enw-h hs "encoder.ln_post.bias") (enw-b st 12) Te))
            (let cr (enw-cross st 0 Te))
            (let s (metal_sync))
            Te))
    ; ---- one decoder step: token id at position pos; argmax over [lo, hi) ----
    (defn enw-dec-layer (st l pos Te)
        (do (let hs (enw-hs st))
            (let p (enw-blk "decoder" l))
            (let dx (enw-b st 13)) (let dn (enw-b st 14)) (let dq (enw-b st 15)) (let da (enw-b st 16)) (let df (enw-b st 17))
            (let kc (enw-bl st 22 l)) (let vc (enw-bl st 23 l))
            (let a1 (enw-ln st dx (enw-w hs p "attn_ln.weight") (enw-w hs p "attn_ln.bias") dn 1))
            (let a2 (enw-gemm st dn (enw-w hs p "attn.query.weight") (enw-w hs p "attn.query.bias") dq dq 1 (enw-D) (enw-D) 1 0 0))
            (let a3 (enw-gemm st dn (enw-w hs p "attn.key.weight") 0 kc kc 1 (enw-D) (enw-D) 0 0 pos))
            (let a4 (enw-gemm st dn (enw-w hs p "attn.value.weight") (enw-w hs p "attn.value.bias") vc vc 1 (enw-D) (enw-D) 1 0 pos))
            (let a5 (enw-attn-dec st dq kc vc da (add pos 1)))
            (let a6 (enw-gemm st da (enw-w hs p "attn.out.weight") (enw-w hs p "attn.out.bias") dx dx 1 (enw-D) (enw-D) 1 2 0))
            (let b1 (enw-ln st dx (enw-w hs p "cross_attn_ln.weight") (enw-w hs p "cross_attn_ln.bias") dn 1))
            (let b2 (enw-gemm st dn (enw-w hs p "cross_attn.query.weight") (enw-w hs p "cross_attn.query.bias") dq dq 1 (enw-D) (enw-D) 1 0 0))
            (let b3 (enw-attn-dec st dq (enw-bl st 20 l) (enw-bl st 21 l) da Te))
            (let b4 (enw-gemm st da (enw-w hs p "cross_attn.out.weight") (enw-w hs p "cross_attn.out.bias") dx dx 1 (enw-D) (enw-D) 1 2 0))
            (let c1 (enw-ln st dx (enw-w hs p "mlp_ln.weight") (enw-w hs p "mlp_ln.bias") dn 1))
            (let c2 (enw-gemm st dn (enw-w hs p "mlp1.weight") (enw-w hs p "mlp1.bias") df df 1 (enw-F) (enw-D) 1 1 0))
            (let c3 (enw-gemm st df (enw-w hs p "mlp2.weight") (enw-w hs p "mlp2.bias") dx dx 1 (enw-D) (enw-F) 1 2 0))
            (add a1 (add a2 (add a3 (add a4 (add a5 (add a6 (add b1 (add b2 (add b3 (add b4 (add c1 (add c2 c3))))))))))))))
    (defn enw-dec-layers (st l pos Te acc) (if (ge l (enw-layers)) acc (enw-dec-layers st (add l 1) pos Te (add acc (enw-dec-layer st l pos Te)))))
    (defn enw-step (st id pos Te lo hi)
        (do (let hs (enw-hs st))
            (let e (enw-run st 5 (list (enw-h hs "decoder.token_embedding.weight") (enw-h hs "decoder.positional_embedding") (enw-b st 13)) (list id pos (enw-D)) (enw-D)))
            (let ls (enw-dec-layers st 0 pos Te 0))
            (let fl (enw-ln st (enw-b st 13) (enw-h hs "decoder.ln.weight") (enw-h hs "decoder.ln.bias") (enw-b st 14) 1))
            (let lg (enw-gemm st (enw-b st 14) (enw-h hs "decoder.token_embedding.weight") 0 (enw-b st 18) (enw-b st 18) 1 (enw-V) (enw-D) 0 0 0))
            (let am (enw-run st 6 (list (enw-b st 18) (enw-b st 19)) (list lo hi) 1))
            (let s (metal_sync))
            (en-u32 (en-text (metal_buf_read (enw-b st 19) 0 4)) 0)))
    (defn enw-ts0 () 50364)
    (defn enw-ts? (id) (ge id (enw-ts0)))
    ; a step whose argmax may answer text, end, or a timestamp: the decoder keeps its own clock
    (defn enw-step2 (st id pos Te)
        (do (let hs (enw-hs st))
            (let e (enw-run st 5 (list (enw-h hs "decoder.token_embedding.weight") (enw-h hs "decoder.positional_embedding") (enw-b st 13)) (list id pos (enw-D)) (enw-D)))
            (let ls (enw-dec-layers st 0 pos Te 0))
            (let fl (enw-ln st (enw-b st 13) (enw-h hs "decoder.ln.weight") (enw-h hs "decoder.ln.bias") (enw-b st 14) 1))
            (let lg (enw-gemm st (enw-b st 14) (enw-h hs "decoder.token_embedding.weight") 0 (enw-b st 18) (enw-b st 18) 1 (enw-V) (enw-D) 0 0 0))
            (let am (enw-run st 13 (list (enw-b st 18) (enw-b st 19)) (list 0 (add (enw-eot) 1) (enw-ts0) (enw-V)) 1))
            (let s (metal_sync))
            (en-u32 (en-text (metal_buf_read (enw-b st 19) 0 4)) 0)))
    ; a loop of period one, two or three repeated three times is the model going round: stop paying for it
    (defn enw-looping? (id acc) (if (lt (len acc) 5) 0 (if (and (eq id (nth acc 0)) (eq id (nth acc 1))) 1 (if (and (eq id (nth acc 1)) (and (eq (nth acc 0) (nth acc 2)) (eq (nth acc 1) (nth acc 3)))) 1 (if (and (eq id (nth acc 2)) (and (eq (nth acc 0) (nth acc 3)) (eq (nth acc 1) (nth acc 4)))) 1 0)))))
    (defn enw-greedy2 (st id pos Te cap acc)
        (do (let nid (enw-step2 st id pos Te))
            (if (or (eq nid (enw-eot)) (or (ge (len acc) cap) (eq (enw-looping? nid acc) 1))) (reverse acc) (enw-greedy2 st nid (add pos 1) Te cap (cons nid acc)))))
    ; transcribe from a tick (20 ms units) into the window: the cut point is handed to the decoder as its first timestamp,
    ; so only what came after it is spoken; returns (lang-token ids) with timestamps kept in ids
    (defn enw-transcribe-from (st Te tick cap)
        (do (let lang (enw-step st (enw-sot) 0 Te (enw-lang-lo) (enw-lang-hi)))
            (let t1 (enw-step st lang 1 Te 0 1))
            (let t2 (enw-step st (enw-tok-transcribe) 2 Te 0 1))
            (list lang (enw-greedy2 st (add (enw-ts0) tick) 3 Te cap (list)))))
    ; the decoder's last word on time: the final timestamp if the line closed with one, else -1
    (defn enw-last-ts (ids) (if (eq (len ids) 0) (sub 0 1) (do (let last (nth ids (sub (len ids) 1))) (if (enw-ts? last) (sub last (enw-ts0)) (sub 0 1)))))
    ; ---- greedy line: prompt sot, lang, transcribe, notimestamps; then text until eot or cap ----
    (defn enw-greedy (st pos Te cap acc)
        (do (let id (enw-step st (if (eq (len acc) 0) (enw-notimestamps) (head acc)) pos Te 0 (add (enw-eot) 1)))
            (if (or (eq id (enw-eot)) (ge (len acc) cap)) (reverse acc) (enw-greedy st (add pos 1) Te cap (cons id acc)))))
    ; returns (lang-token ids)
    (defn enw-transcribe (st Te cap)
        (do (let lang (enw-step st (enw-sot) 0 Te (enw-lang-lo) (enw-lang-hi)))
            (let t1 (enw-step st lang 1 Te 0 1))
            (let t2 (enw-step st (enw-tok-transcribe) 2 Te 0 1))
            (list lang (enw-greedy st 3 Te cap (list)))))
    ; ---- words: rank -> base64 line -> bytes ----
    (defn enw-bytes-str (xs) (if (eq (len xs) 0) "" (str_concat (byte_to_str (head xs)) (enw-bytes-str (tail xs)))))
    (defn enw-tok (st id) (if (ge id (enw-eot)) "" (do (let line (nth (nth st 5) id)) (let sp (str_find line " " 0)) (if (lt sp 0) "" (enw-bytes-str (base64-decode (substring line 0 sp)))))))
    (defn enw-text (st ids) (if (eq (len ids) 0) "" (str_concat (enw-tok st (head ids)) (enw-text st (tail ids)))))
    ; the language token's own name is the code the reference uses (en, fa, pt, ...): the tiktoken has no line for it, so a small table
    (defn enw-langs () (list "en" "zh" "de" "es" "ru" "ko" "fr" "ja" "pt" "tr" "pl" "ca" "nl" "ar" "sv" "it" "id" "hi" "fi" "vi" "he" "uk" "el" "ms" "cs" "ro" "da" "hu" "ta" "no" "th" "ur" "hr" "bg" "lt" "la" "mi" "ml" "cy" "sk" "te" "fa" "lv" "bn" "sr" "az" "sl" "kn" "et" "mk" "br" "eu" "is" "hy" "ne" "mn" "bs" "kk" "sq" "sw" "gl" "mr" "pa" "si" "km" "sn" "yo" "so" "af" "oc" "ka" "be" "tg" "sd" "gu" "am" "yi" "lo" "uz" "fo" "ht" "ps" "tk" "nn" "mt" "sa" "lb" "my" "bo" "tl" "mg" "as" "tt" "haw" "ln" "ha" "ba" "jw" "su"))
    (defn enw-lang-code (tok) (do (let i (sub tok (enw-lang-lo))) (if (or (lt i 0) (ge i (len (enw-langs)))) "?" (nth (enw-langs) i))))
    0)
