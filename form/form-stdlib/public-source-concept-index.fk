    (defn psci-build-specs-at (root specs index)
        (if (nil? specs) index
            (do
                (let spec (head specs))
                (let entry (psci-register-at root (nth spec 0) (nth spec 1)
                    (nth spec 2)))
                (if (nothing? entry) (nothing)
                    (psci-build-specs-at root (tail specs)
                        (psci-add-entry index entry))))))
    (defn psci-public-sample-index-at (root)
        (psci-build-specs-at root (psci-public-sample-specs)
            (psci-index-empty)))
    0)
