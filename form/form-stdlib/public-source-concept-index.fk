    def psci-build-specs-at(root, specs, index) = nil?(specs) ? index : {
        let spec = head(specs);
        let entry = psci-register-at(root, spec[0], spec[1], spec[2]);
        nothing?(entry) ? nothing() : psci-build-specs-at(root, tail(specs), psci-add-entry(index, entry));
    };
    def psci-public-sample-index-at(root) = psci-build-specs-at(root, psci-public-sample-specs(), psci-index-empty());
    0;
}
