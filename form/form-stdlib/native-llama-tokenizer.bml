// Local Hugging Face tokenizer JSON supplies every vocabulary id and merge rank.
// The Llama alternation is Form; Unicode categories are versioned input data.
// preludes: form-stdlib/native-ordered-index.bml form-stdlib/json.fk form-stdlib/line-grammar.fk form-stdlib/dsv4-tokenizer.fk form-stdlib/llama3-pretokenize.fk form-stdlib/metal-door.fk
section [form.bml] {
 class NativeLlamaTokenizer {
  def nlt-value(o,k) = node_value(json-object-get(o,k));
  def nlt-vocab(ps,t) = nil?(ps) ? t : nlt-vocab(tail(ps),noi-put(t,json-pair-key(head(ps)),node_value(json-pair-value(head(ps)))));
  def nlt-decoder(ps,t) = nil?(ps) ? t : nlt-decoder(tail(ps),noi-put(t,md-le32(node_value(json-pair-value(head(ps)))),json-pair-key(head(ps))));
  def nlt-merges(rows,i,t) = nil?(rows) ? t : nlt-merges(tail(rows),i + 1,noi-put(t,nlt-merge-key(head(rows)),i));
  def nlt-merge-key(node) {
   let pair = json-array-elements(node);
   (Comparable) len(pair) == 2 ? node_value(head(pair)) ++ " " ++ node_value(pair[1]) : node_value(node);
  }
  def nlt-specials(rows,t) = nil?(rows) ? t : nlt-specials(tail(rows),noi-put(t,nlt-value(head(rows),"content"),nlt-value(head(rows),"id")));
  def nlt-added-decoder(rows,t) = nil?(rows) ? t : nlt-added-decoder(tail(rows),noi-put(t,md-le32(nlt-value(head(rows),"id")),nlt-value(head(rows),"content")));
  def nlt-hex(s,i,n) = i >= str_len(s) ? n : nlt-hex(s,i + 1,(n * 16) + str_find("0123456789ABCDEF",substring(s,i,i + 1),0));
  def nlt-number-key(n) = substring("0000000" ++ int_to_str(n),str_len(int_to_str(n)),str_len(int_to_str(n)) + 7);
  def nlt-category-lines(lines,t) = nil?(lines) ? t : nlt-category-lines(tail(lines),nlt-category-line(head(lines),t));
  def nlt-category-line(line,t) {
   let fields = split-on(line,";");
   (len(fields) < 2) || ((String) substring(trim(line),0,1) == "#") ? t : nlt-category-fields(fields,t);
  }
  def nlt-category-fields(fields,t) {
   let cat = trim(head(split-on(fields[1],"#")));
   let k = (String) substring(cat,0,1) == "L" ? 1 : (String) substring(cat,0,1) == "N" ? 2 : 0;
   let range = split-on(trim(head(fields)),"..");
   let lo = nlt-hex(head(range),0,0); let hi = (Comparable) len(range) == 1 ? lo : nlt-hex(range[1],0,0);
   noi-put(t,nlt-number-key(lo),list(hi,k));
  }
  def nlt-open(dir) {
   let path = dir ++ "/tokenizer.json"; let root = parse-json(path,read_file(path));
   let model = json-object-get(root,"model");
   !((String) nlt-value(model,"type") == "BPE") ? form_error("native Llama tokenizer requires BPE") : nlt-open-model(dir,root,model);
  }
  // tokenizer: vocab, decoder, merge index, special index, Unicode index, model dir, added-token decoder.
  def nlt-open-model(dir,root,model) {
   let vocab = json-object-pairs(json-object-get(model,"vocab"));
   let categories = read_file("form/form-stdlib/data/DerivedGeneralCategory-15.1.0.txt");
   nothing?(categories) ? form_error("native tokenizer Unicode categories absent") : list(nlt-vocab(vocab,list()),nlt-decoder(vocab,list()),nlt-merges(json-array-elements(json-object-get(model,"merges")),0,list()),nlt-specials(json-array-elements(json-object-get(root,"added_tokens")),list()),nlt-category-lines(split-on(categories,byte_to_str(10)),list()),dir,nlt-added-decoder(json-array-elements(json-object-get(root,"added_tokens")),list()));
  }
  def nlt-class(t,s,i) {
   let cp = tkz-uval(s,i); let row = noi-floor(t[4],nlt-number-key(cp),nothing());
   nothing?(row) ? 0 : cp <= head(row) ? row[1] : 0;
  }
  def nlt-ws(cp) = ((cp >= 9) && (cp <= 13)) || (((Comparable) cp == 32) || (((Comparable) cp == 133) || (((Comparable) cp == 160) || (((Comparable) cp == 5760) || (((cp >= 8192) && (cp <= 8202)) || (((Comparable) cp == 8232) || (((Comparable) cp == 8233) || (((Comparable) cp == 8239) || (((Comparable) cp == 8287) || ((Comparable) cp == 12288))))))))));
  // kind: 1 letters, 2 numbers, 3 other, 4 whitespace, 5 CR/LF.
  def nlt-kind(t,s,i,kind) = i >= str_len(s) ? 0 : (Comparable) kind == 4 ? nlt-ws(tkz-uval(s,i)) : (Comparable) kind == 5 ? tkz-newline(str_byte_at(s,i)) : (Comparable) kind == 3 ? (((Comparable) nlt-class(t,s,i) == 0) && (!nlt-ws(tkz-uval(s,i)))) : ((Comparable) nlt-class(t,s,i) == kind);
  def nlt-run(t,s,i,kind,remaining) = ((Comparable) remaining == 0) || (!nlt-kind(t,s,i,kind)) ? i : nlt-run(t,s,i + tkz-ulen(s,i),kind,remaining - 1);
  def nlt-lastnl(s,i,end,prior) = i >= end ? prior : nlt-lastnl(s,i + tkz-ulen(s,i),end,tkz-newline(str_byte_at(s,i)) ? (i + 1) : prior);
  def nlt-prev(s,i,end,prev) = i >= end ? prev : nlt-prev(s,i + tkz-ulen(s,i),end,i);
  def nlt-space-end(t,s,i) {
   let end = nlt-run(t,s,i,4,-1); let nl = nlt-lastnl(s,i,end,-1);
   nl >= 0 ? nl : (end < str_len(s)) && (end > (i + tkz-ulen(s,i))) ? nlt-prev(s,i,end,i) : end;
  }
  def nlt-end(t,s,i) {
   let cp = tkz-uval(s,i); let next = i + tkz-ulen(s,i);
   let contraction = (Comparable) cp == 39 ? l3-contract-len(s,str_len(s),i) : 0;
   contraction > 0 ? (i + contraction)
   : nlt-kind(t,s,i,1) ? nlt-run(t,s,i,1,-1)
   : (!tkz-newline(cp)) && (((Comparable) nlt-class(t,s,i) == 0) && nlt-kind(t,s,next,1)) ? nlt-run(t,s,next,1,-1)
   : nlt-kind(t,s,i,2) ? nlt-run(t,s,i,2,3)
   : nlt-kind(t,s,i,3) ? nlt-run(t,s,nlt-run(t,s,i,3,-1),5,-1)
   : ((Comparable) cp == 32) && nlt-kind(t,s,next,3) ? nlt-run(t,s,nlt-run(t,s,next,3,-1),5,-1)
   : nlt-space-end(t,s,i);
  }
  def nlt-symbol(b) {
   let cp = tkz-b2cp(b);
   cp < 128 ? byte_to_str(cp) : byte_to_str(192 + (cp / 64)) ++ byte_to_str(128 + (cp % 64));
  }
  def nlt-symbols(s,i,end) = i .. end |> map(k => nlt-symbol(str_byte_at(s,k)));
  def nlt-best(table,syms,i,bestRank,bestIndex) {
   len(syms) < 2 ? bestIndex : nlt-best-next(table,syms,i,bestRank,bestIndex,noi-get(table,head(syms) ++ " " ++ syms[1]));
  }
  def nlt-best-next(table,syms,i,rank,at,found) = nothing?(found) ? nlt-best(table,tail(syms),i + 1,rank,at) : found < rank ? nlt-best(table,tail(syms),i + 1,found,i) : nlt-best(table,tail(syms),i + 1,rank,at);
  def nlt-merge(syms,at) = (Comparable) at == 0 ? cons(head(syms) ++ syms[1],tail(tail(syms))) : cons(head(syms),nlt-merge(tail(syms),at - 1));
  def nlt-bpe(table,syms) = nlt-bpe-at(table,syms,nlt-best(table,syms,0,2147483647,-1));
  def nlt-bpe-at(table,syms,at) = at < 0 ? syms : nlt-bpe(table,nlt-merge(syms,at));
  def nlt-ids(vocab,syms) = nil?(syms) ? list() : cons(nlt-required(noi-get(vocab,head(syms))),nlt-ids(vocab,tail(syms)));
  def nlt-required(v) = v ?? form_error("native tokenizer vocabulary entry absent");
  def nlt-encode-from(t,s,i,acc) {
   i >= str_len(s) ? reverse(acc) : nlt-piece(t,s,i,nlt-end(t,s,i),acc);
  }
  def nlt-piece(t,s,i,end,acc) = end <= i ? form_error("native tokenizer splitter made no progress") : nlt-encode-from(t,s,end,append(reverse(nlt-ids(head(t),nlt-bpe(t[2],nlt-symbols(s,i,end)))),acc));
  def nlt-encode(t,s) = nlt-encode-from(t,s,0,list());
  def nlt-special(t,text) = nlt-required(noi-get(t[3],text));
  def nlt-decode-piece(s,i,acc) = i >= str_len(s) ? acc : nlt-decode-next(s,i,acc,tkz-cp2b(tkz-secp-val(s,i)));
  def nlt-decode-next(s,i,acc,b) = b < 0 ? form_error("native tokenizer byte alphabet invalid") : nlt-decode-piece(s,i + tkz-secp-len(str_byte_at(s,i)),acc ++ byte_to_str(b));
  def nlt-added-text(t,id) = len(t) < 7 ? nothing() : noi-get(t[6],md-le32(id));
  def nlt-known-id(t,id) = (id >= 0) && ((!nothing?(noi-get(t[1],md-le32(id)))) || (!nothing?(nlt-added-text(t,id))));
  def nlt-decode-id(t,id) {
   nlt-added-text(t,id) ?? nlt-decode-piece(nlt-required(noi-get(t[1],md-le32(id))),0,"");
  }
  def nlt-decode(t,ids) = nil?(ids) ? "" : nlt-decode-id(t,head(ids)) ++ nlt-decode(t,tail(ids));
  def nlt-header(t,role) = append(list(nlt-special(t,"<|start_header_id|>")),append(nlt-encode(t,role),append(list(nlt-special(t,"<|end_header_id|>")),nlt-encode(t,"\n\n"))));
  def nlt-message(t,role,text) = append(nlt-header(t,role),append(nlt-encode(t,trim(text)),list(nlt-special(t,"<|eot_id|>"))));
  // Explicit date matches the tokenizer template's deterministic no-strftime branch.
  def nlt-chat-start(t) = append(list(nlt-special(t,"<|begin_of_text|>")),append(nlt-header(t,"system"),append(nlt-encode(t,"Cutting Knowledge Date: December 2023\nToday Date: 26 Jul 2024\n\n"),list(nlt-special(t,"<|eot_id|>")))));
  def nlt-chat(t,prompt) = append(nlt-chat-start(t),append(nlt-message(t,"user",prompt),nlt-header(t,"assistant")));
 }
 0;
}
