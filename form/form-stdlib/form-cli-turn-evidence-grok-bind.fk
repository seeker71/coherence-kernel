; form-cli-turn-evidence-grok-bind.fk — bind one private Grok session dir.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk
; preludes: form-stdlib/form-cli-turn-evidence-grok.fk

(do
    (let path (read_line))
    (if (eq (fs-is-dir? path) 1)
        (do
            (write_file_text (fctg-session-bind-path) path)
            (print_str "grok-session-binding=observed\n")
            0)
        (do
            (print_str "grok-session-binding=withheld\n")
            1)))
