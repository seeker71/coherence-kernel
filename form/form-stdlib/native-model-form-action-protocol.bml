//////////////////////////////////////////////////////////////////////
//
// native-model-form-action-protocol.bml — executable action proposal,
// routing, admission, and healing signals for every admitted local model.
//
// Authority: form-stdlib/bml/native-model-form-action-protocol.bml
// preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk form-stdlib/native-model-form-token-envelope.bml form-stdlib/form-agent-protocol.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelFormActionProtocolAuthority {
        field NMFAPAuthorityPath = "form/form-stdlib/bml/native-model-form-action-protocol.bml";
        field NMFAPAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelFormActionProtocol {
        field NMFAPSchema = "native-model-form-action-protocol-v1";
        field NMFAPWire = "form-agent-protocol/Hermes-tool-call";

        ref nmfap-authority = NativeModelFormActionProtocolAuthority;
        thought nmfap-law = list("offer-before-action", "native-gate", "typed-healing", "no-silent-drop");

        // proposal: tag, model, word, args, Node-ID, interface, protocol, offered.
        def nmfap-proposal(model, word, args, nodeid, interfaceName, protocolName, offered) = list("native-model-form-action-proposal", model, nmfte-canonical-word(word), args, nodeid, interfaceName, protocolName, offered);
        def nmfap-model(proposal) = nth(proposal, 1);
        def nmfap-word(proposal) = nth(proposal, 2);
        def nmfap-args(proposal) = nth(proposal, 3);
        def nmfap-nodeid(proposal) = nth(proposal, 4);
        def nmfap-interface(proposal) = nth(proposal, 5);
        def nmfap-protocol(proposal) = nth(proposal, 6);
        def nmfap-offered?(proposal) = nth(proposal, 7);

        def nmfap-model-row(model) = nmfte-find-row(model, nmcp-registry());
        def nmfap-model-admitted?(model) {
            let row = nmfap-model-row(model);
            if ((Comparable) len(row) == 0) then 0
            else if ((Comparable) nmfte-prompt-admitted?(row) == 1) then 1
            else nmfte-native-admitted?(row);
        }
        def nmfap-needs-nodeid?(word) {
            let canonical = nmfte-canonical-word(word);
            if ((String) canonical == "nothing") then 0
            else if ((String) canonical == "choice") then 0
            else if ((String) canonical == "fail") then 0
            else if ((String) canonical == "cut") then 0
            else if ((String) canonical == "undo") then 0
            else if ((String) canonical == "timeout") then 0
            else if ((String) canonical == "interface") then 0
            else if ((String) canonical == "protocol") then 0
            else 1;
        }
        def nmfap-nonempty?(text) = if (str_len(text) > 0) then 1 else 0;
        def nmfap-admit?(proposal) {
            if (!((Comparable) len(proposal) == 8)) then 0
            else if ((Comparable) nmfap-model-admitted?(nmfap-model(proposal)) == 0) then 0
            else if ((Comparable) nmfte-native-word?(nmfap-word(proposal)) == 0) then 0
            else if (!((Comparable) nmfap-offered?(proposal) == 1)) then 0
            else if ((Comparable) nmfap-nonempty?(nmfap-interface(proposal)) == 0) then 0
            else if ((Comparable) nmfap-nonempty?(nmfap-protocol(proposal)) == 0) then 0
            else if (((Comparable) nmfap-needs-nodeid?(nmfap-word(proposal)) == 1) && ((Comparable) nmfap-nonempty?(nmfap-nodeid(proposal)) == 0)) then 0
            else 1;
        }

        def nmfap-control-tag(word) {
            let canonical = nmfte-canonical-word(word);
            if ((String) canonical == "choice") then "<CHOICE>"
            else if ((String) canonical == "fail") then "<FAIL>"
            else if ((String) canonical == "cut") then "<CUT>"
            else if ((String) canonical == "undo") then "<UNDO>"
            else if ((String) canonical == "timeout") then "<TIMEOUT>"
            else if ((String) canonical == "store") then "<STORE>"
            else "";
        }
        def nmfap-route(word) {
            let canonical = nmfte-canonical-word(word);
            if ((String) canonical == "Node-ID") then "nodeid-coordinate"
            else if ((String) canonical == "nothing") then "native-nothing"
            else if (str_len(nmfap-control-tag(canonical)) > 0) then "control-invite-dispatch"
            else if ((String) canonical == "eval") then "form-eval"
            else if ((String) canonical == "release") then "lifecycle-release"
            else if ((String) canonical == "melt") then "jit-melt"
            else if ((String) canonical == "crystallize") then "jit-crystallize"
            else if ((String) canonical == "open") then "lifecycle-open"
            else if ((String) canonical == "interface") then "channel-interface"
            else if ((String) canonical == "protocol") then "form-agent-protocol"
            else if ((String) canonical == "offer") then "offer-ack"
            else if ((String) canonical == "ask") then "grounded-ask"
            else if ((String) canonical == "broadcast") then "world-broadcast"
            else if ((String) canonical == "mesh") then "mesh-route"
            else if ((String) canonical == "satsang") then "satsang-protocol"
            else "unknown";
        }
        def nmfap-tool-name(word) = str_concat("form.", nmfte-canonical-word(word));
        def nmfap-tool-call(id, proposal) = ap-tool-call(id, nmfap-tool-name(nmfap-word(proposal)), nmfap-args(proposal));

        // healing: tag, signal, next action. No failure is dropped.
        def nmfap-healing(proposal) {
            if ((Comparable) len(nmfap-model-row(nmfap-model(proposal))) == 0) then list("native-model-form-healing", "unknown-model", "register-or-correct-model-id")
            else if ((Comparable) nmfap-model-admitted?(nmfap-model(proposal)) == 0) then list("native-model-form-healing", "model-unavailable", "bind-runtime-or-route-to-admitted-sibling")
            else if ((Comparable) nmfte-native-word?(nmfap-word(proposal)) == 0) then list("native-model-form-healing", "unknown-word", "ground-word-and-add-witnessed-route")
            else if (!((Comparable) nmfap-offered?(proposal) == 1)) then list("native-model-form-healing", "not-offered", "offer-before-action")
            else if (((Comparable) nmfap-nonempty?(nmfap-interface(proposal)) == 0) || ((Comparable) nmfap-nonempty?(nmfap-protocol(proposal)) == 0)) then list("native-model-form-healing", "missing-contract", "name-interface-and-protocol")
            else if (((Comparable) nmfap-needs-nodeid?(nmfap-word(proposal)) == 1) && ((Comparable) nmfap-nonempty?(nmfap-nodeid(proposal)) == 0)) then list("native-model-form-healing", "missing-nodeid", "resolve-exact-nodeid-before-effect")
            else list("native-model-form-healing", "ready", nmfap-route(nmfap-word(proposal)));
        }
        def nmfap-healing-signal(healing) = nth(healing, 1);
        def nmfap-healing-next(healing) = nth(healing, 2);
        def nmfap-plan(proposal) = list("native-model-form-action-plan", nmfap-model(proposal), nmfap-word(proposal), nmfap-admit?(proposal), nmfap-route(nmfap-word(proposal)), nmfap-healing(proposal));

        def nmfap-word-admitted?(model, word) = nmfap-admit?(nmfap-proposal(model, word, "{}", "31.2.0.1", "native-model-form", NMFAPWire(), 1));
        def nmfap-count-admitted-words(model, words) = if ((Comparable) len(words) == 0) then 0 else (nmfap-word-admitted?(model, nmfte-word-name(head(words))) + nmfap-count-admitted-words(model, tail(words)));
    }
    0;
}
