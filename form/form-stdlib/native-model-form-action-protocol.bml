//////////////////////////////////////////////////////////////////////
//
// native-model-form-action-protocol.bml — executable action proposal,
// routing, admission, and healing signals for every admitted local model.
//
// Authority: form-stdlib/bml/native-model-form-action-protocol.bml
// preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk form-stdlib/native-model-form-token-envelope.bml form-stdlib/form-agent-protocol.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelFormActionProtocolAuthority {
        field NMFAPAuthorityPath = "form/form-stdlib/bml/native-model-form-action-protocol.bml";
        field NMFAPAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelFormActionProtocol {
        field NMFAPSchema = "native-model-form-action-protocol-v1";
        field NMFAPWire = "form-agent-protocol/Hermes-tool-call";

        ref nmfap-authority = NativeModelFormActionProtocolAuthority;
        thought nmfap-law = list("offer-before-action", "native-gate", "typed-healing", "no-silent-drop");

        // proposal: tag, model, word, args, Node-ID, interface, protocol, offered.
        def nmfap-proposal(model, word, args, nodeid, interfaceName, protocolName, offered) = list("native-model-form-action-proposal", model, nmfte-canonical-word(word), args, nodeid, interfaceName, protocolName, offered);
        def nmfap-model(proposal) = nth(proposal, 1);
        def nmfap-word(proposal) = nth(proposal, 2);
        def nmfap-args(proposal) = nth(proposal, 3);
        def nmfap-nodeid(proposal) = nth(proposal, 4);
        def nmfap-interface(proposal) = nth(proposal, 5);
        def nmfap-protocol(proposal) = nth(proposal, 6);
        def nmfap-offered?(proposal) = nth(proposal, 7);

        def nmfap-model-row(model) = nmfte-find-row(model, nmcp-registry());
        def nmfap-model-admitted?(model) {
            let row = nmfap-model-row(model);
            if eq(len(row), 0) then 0
            else if eq(nmfte-prompt-admitted?(row), 1) then 1
            else nmfte-native-admitted?(row);
        }
        def nmfap-needs-nodeid?(word) {
            let canonical = nmfte-canonical-word(word);
            if str_eq(canonical, "nothing") then 0
            else if str_eq(canonical, "choice") then 0
            else if str_eq(canonical, "fail") then 0
            else if str_eq(canonical, "cut") then 0
            else if str_eq(canonical, "undo") then 0
            else if str_eq(canonical, "timeout") then 0
            else if str_eq(canonical, "interface") then 0
            else if str_eq(canonical, "protocol") then 0
            else 1;
        }
        def nmfap-nonempty?(text) = if gt(str_len(text), 0) then 1 else 0;
        def nmfap-admit?(proposal) {
            if not(eq(len(proposal), 8)) then 0
            else if eq(nmfap-model-admitted?(nmfap-model(proposal)), 0) then 0
            else if eq(nmfte-native-word?(nmfap-word(proposal)), 0) then 0
            else if not(eq(nmfap-offered?(proposal), 1)) then 0
            else if eq(nmfap-nonempty?(nmfap-interface(proposal)), 0) then 0
            else if eq(nmfap-nonempty?(nmfap-protocol(proposal)), 0) then 0
            else if and(eq(nmfap-needs-nodeid?(nmfap-word(proposal)), 1), eq(nmfap-nonempty?(nmfap-nodeid(proposal)), 0)) then 0
            else 1;
        }

        def nmfap-control-tag(word) {
            let canonical = nmfte-canonical-word(word);
            if str_eq(canonical, "choice") then "<CHOICE>"
            else if str_eq(canonical, "fail") then "<FAIL>"
            else if str_eq(canonical, "cut") then "<CUT>"
            else if str_eq(canonical, "undo") then "<UNDO>"
            else if str_eq(canonical, "timeout") then "<TIMEOUT>"
            else if str_eq(canonical, "store") then "<STORE>"
            else "";
        }
        def nmfap-route(word) {
            let canonical = nmfte-canonical-word(word);
            if str_eq(canonical, "Node-ID") then "nodeid-coordinate"
            else if str_eq(canonical, "nothing") then "native-nothing"
            else if gt(str_len(nmfap-control-tag(canonical)), 0) then "control-invite-dispatch"
            else if str_eq(canonical, "eval") then "form-eval"
            else if str_eq(canonical, "release") then "lifecycle-release"
            else if str_eq(canonical, "melt") then "jit-melt"
            else if str_eq(canonical, "crystallize") then "jit-crystallize"
            else if str_eq(canonical, "open") then "lifecycle-open"
            else if str_eq(canonical, "interface") then "channel-interface"
            else if str_eq(canonical, "protocol") then "form-agent-protocol"
            else if str_eq(canonical, "offer") then "offer-ack"
            else if str_eq(canonical, "ask") then "grounded-ask"
            else if str_eq(canonical, "broadcast") then "world-broadcast"
            else if str_eq(canonical, "mesh") then "mesh-route"
            else if str_eq(canonical, "satsang") then "satsang-protocol"
            else "unknown";
        }
        def nmfap-tool-name(word) = str_concat("form.", nmfte-canonical-word(word));
        def nmfap-tool-call(id, proposal) = ap-tool-call(id, nmfap-tool-name(nmfap-word(proposal)), nmfap-args(proposal));

        // healing: tag, signal, next action. No failure is dropped.
        def nmfap-healing(proposal) {
            if eq(len(nmfap-model-row(nmfap-model(proposal))), 0) then list("native-model-form-healing", "unknown-model", "register-or-correct-model-id")
            else if eq(nmfap-model-admitted?(nmfap-model(proposal)), 0) then list("native-model-form-healing", "model-unavailable", "bind-runtime-or-route-to-admitted-sibling")
            else if eq(nmfte-native-word?(nmfap-word(proposal)), 0) then list("native-model-form-healing", "unknown-word", "ground-word-and-add-witnessed-route")
            else if not(eq(nmfap-offered?(proposal), 1)) then list("native-model-form-healing", "not-offered", "offer-before-action")
            else if or(eq(nmfap-nonempty?(nmfap-interface(proposal)), 0), eq(nmfap-nonempty?(nmfap-protocol(proposal)), 0)) then list("native-model-form-healing", "missing-contract", "name-interface-and-protocol")
            else if and(eq(nmfap-needs-nodeid?(nmfap-word(proposal)), 1), eq(nmfap-nonempty?(nmfap-nodeid(proposal)), 0)) then list("native-model-form-healing", "missing-nodeid", "resolve-exact-nodeid-before-effect")
            else list("native-model-form-healing", "ready", nmfap-route(nmfap-word(proposal)));
        }
        def nmfap-healing-signal(healing) = nth(healing, 1);
        def nmfap-healing-next(healing) = nth(healing, 2);
        def nmfap-plan(proposal) = list("native-model-form-action-plan", nmfap-model(proposal), nmfap-word(proposal), nmfap-admit?(proposal), nmfap-route(nmfap-word(proposal)), nmfap-healing(proposal));

        def nmfap-word-admitted?(model, word) = nmfap-admit?(nmfap-proposal(model, word, "{}", "31.2.0.1", "native-model-form", NMFAPWire(), 1));
        def nmfap-count-admitted-words(model, words) = if eq(len(words), 0) then 0 else add(nmfap-word-admitted?(model, nmfte-word-name(head(words))), nmfap-count-admitted-words(model, tail(words)));
    }
    0;
}
