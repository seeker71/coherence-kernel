; form-cli-adaptive-execute.fk — Form-owned oracle membrane crossings.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-adaptive-generation.fk

(do
    (defn fag-oracle (command prompt)
        (host-exec (str_concat "env -u ANTHROPIC_API_KEY "
                    (str_concat command " 2>/dev/null"))
            (str_concat
                "Respond to the inquiry itself. Separate observed ground from inference. "
                (str_concat
                    "Use exactly these headings: GROUNDING:, ANSWER:, UNCERTAINTY:. "
                    (str_concat
                    "Avoid absolutes. Treat axioms as chosen current ground whose use remains observable, not as unquestionable truth. "
                    prompt)))))
    (defn fag-persist (evidence)
        (host-exec
            "mkdir -p $HOME/.coherence-network; cat >> $HOME/.coherence-network/form-cli-inference.log; printf '\\n=== /inference ===\\n' >> $HOME/.coherence-network/form-cli-inference.log"
            evidence))
    (defn fag-runtime-evidence (base cheap-command strong-command remote-command selected)
        (str_concat base
            (str_concat "\nCHEAP-RUNTIME ollama\nCHEAP-COMMAND "
            (str_concat cheap-command
            (str_concat "\nSTRONG-RUNTIME ollama\nSTRONG-COMMAND "
            (str_concat strong-command
            (str_concat "\nREMOTE-RUNTIME claude-cli\nREMOTE-COMMAND "
            (str_concat remote-command
            (str_concat "\nTRAINING-PROMPT-BEGIN\n"
            (str_concat "Use the accepted response to correct the rejected local response."
            (str_concat "\nTRAINING-PROMPT-END\nTRAINING-RESPONSE-BEGIN\n"
            (str_concat (fnr-s-cheap selected)
            (str_concat "\nTRAINING-RESPONSE-END\nTRAINING-CORRECTION-BEGIN\n"
            (str_concat (fnr-s-reply selected)
                        "\nTRAINING-CORRECTION-END"))))))))))))))
    (defn fag-generate (prompt native-miss cheap-local strong-local remote)
        (do
            (let cheap (fag-oracle cheap-local prompt))
            (let strong (if (eq (fnr-usable? cheap) 1) ""
                            (fag-oracle strong-local prompt)))
            (let rented (if (or (eq (fnr-usable? cheap) 1)
                                (eq (fnr-usable? strong) 1)) ""
                            (fag-oracle remote prompt)))
            (let selected (fnr-select-adaptive cheap strong rented))
            (do (fag-persist
                    (fag-runtime-evidence
                        (fnr-adaptive-evidence prompt native-miss selected)
                        cheap-local strong-local remote selected))
                selected)))
    0)
