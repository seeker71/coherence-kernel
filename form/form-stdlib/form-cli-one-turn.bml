//////////////////////////////////////////////////////////////////////
//
// form-cli-one-turn.bml
//
// Executable BML. High-grammar authority:
//   form-stdlib/bml/form-cli-one-turn.bml
//
// Generic class FormOneTurn<T> — FileIO door. One local turn is the
// request. Remote reviews at most once. A third remote is leak, not
// another attempt. Composes FormLocalReady walk.
//
// Proven by: form-stdlib/tests/form-cli-one-turn-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template RequestBudget<TTurn> {
        member localFirst: TTurn;
        member remoteReview: TTurn;
        member cap: int;
    }

    class FormOneTurnAuthority {
        field OneTurnAuthorityPath = "form/form-stdlib/bml/form-cli-one-turn.bml";
        field OneTurnAuthorityKind = "high-bml-class-template-field";
    }

    class FormOneTurn<T> {
        field OneTurn = 1;
        field RemoteReviewCap = 1;
        field LaneNative = 0;
        field LaneLocal = 1;
        field LaneRemote = 2;
        field NextLocal = 0;
        field NextRemote = 1;
        field NextStop = 2;
        field NextNothing = 3;

        ref fot-authority = FormOneTurnAuthority;
        thought fot-pattern = list("local-first", "review-once", "stop", "leak", "drop");

        def fot-resolved(lane) = if eq(lane, LaneRemote()) then 0 else 1;

        def fot-walk(native-hit, shape) = flr-walk(native-hit, shape);

        def fot-next(turns-used, resolved) = if eq(resolved, 1) then NextStop() else if eq(turns-used, 0) then NextLocal() else if eq(turns-used, OneTurn()) then NextRemote() else NextNothing();

        def fot-leak-one-request(remote-turns) = if le(remote-turns, OneTurn()) then 0 else sub(remote-turns, OneTurn());

        def fot-admit-remote(turns-used, resolved) = if eq(fot-next(turns-used, resolved), NextRemote()) then 1 else 0;

        ; Remote absent is timeout, not another rented turn. Local already
        ; observed, or still gets one local walk. The body on disk stands.
        def fot-next-drop(turns-used, resolved, remote-present) = if eq(resolved, 1) then NextStop() else if eq(remote-present, 0) then if eq(turns-used, 0) then NextLocal() else NextStop() else fot-next(turns-used, resolved);

        def fot-admit-remote-live(turns-used, resolved, remote-present) = if eq(fot-next-drop(turns-used, resolved, remote-present), NextRemote()) then 1 else 0;

        def fot-bit(ok, bit) = if ok then bit else 0;

        def fot-drop-check() {
            let d0 = fot-bit(eq(fot-next-drop(0, 0, 0), NextLocal()), 1);
            let d1 = fot-bit(eq(fot-next-drop(1, 0, 0), NextStop()), 2);
            let d2 = fot-bit(eq(fot-next-drop(1, 1, 0), NextStop()), 4);
            let d3 = fot-bit(eq(fot-admit-remote-live(1, 0, 0), 0), 8);
            let d4 = fot-bit(eq(fot-next-drop(1, 0, 1), NextRemote()), 16);
            let d5 = fot-bit(eq(fot-leak-one-request(105), 104), 32);
            add(d0, add(d1, add(d2, add(d3, add(d4, d5)))));
        }

        def fot-check() {
            let native-lane = fot-walk(1, Quiet());
            let local-lane = fot-walk(0, UnbalancedMark());
            let remote-lane = fot-walk(0, Quiet());
            let c0 = fot-bit(eq(OneTurn(), 1), 1);
            let c1 = fot-bit(and(eq(native-lane, LaneNative()), eq(fot-resolved(native-lane), 1)), 2);
            let c2 = fot-bit(and(eq(local-lane, LaneLocal()), eq(fot-resolved(local-lane), 1)), 4);
            let c3 = fot-bit(and(eq(remote-lane, LaneRemote()), eq(fot-resolved(remote-lane), 0)), 8);
            let c4 = fot-bit(and(eq(fot-next(0, 0), NextLocal()), and(eq(fot-next(1, 0), NextRemote()), eq(fot-next(2, 0), NextNothing()))), 16);
            let c5 = fot-bit(eq(fot-next(1, 1), NextStop()), 32);
            let c6 = fot-bit(and(eq(fot-leak-one-request(1), 0), eq(fot-leak-one-request(107), 106)), 64);
            let c7 = fot-bit(and(eq(fot-admit-remote(1, 0), 1), eq(fot-admit-remote(2, 0), 0)), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
