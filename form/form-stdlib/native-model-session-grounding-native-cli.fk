; native-model-session-grounding-native-cli.fk -- direct Form-native private
; session replay request.  The request carries only explicit consent and local
; paths/options.  No query, answer, corpus row, or checkpoint byte crosses it.
;
; stdin, one line each:
; consent token, owner surface, repo root, Codex home, local RAG index, private
; state root, salt file, file limit, candidate limit, optional expiry ms (0 for
; none), optional expiry default (empty/NOTHING/ZERO/ONE), optional lens.
;
; preludes: form-stdlib/core.fk observe/live-call-framebuffer.fk form-stdlib/native-model-session-grounding-native.fk

(do
    (let started
        (lcfb-open-stream "native-session-grounding" "form-native"
            "direct-private-replay" "consent-request"
            "form/form-stdlib/native-model-session-grounding-native-cli.fk"
            14 9))
    (let consent-token (read_line))
    (let owner-surface (read_line))
    (let repo-root (read_line))
    (let codex-home (read_line))
    (let index-path (read_line))
    (let state-root (read_line))
    (let salt-path (read_line))
    (let file-limit (str_to_int (read_line)))
    (let candidate-limit (str_to_int (read_line)))
    (let expiry-ms (str_to_int (read_line)))
    (let default-kind (read_line))
    (let lens (read_line))
    (let request-observed
        (lcfb-call-stream "native-session-grounding" "consent-request"
            "leave" "form-native" "validate-options"
            "scoped-diagnostic-request" 1 started
            "form/form-stdlib/native-model-session-grounding-native-cli.fk"
            31 9))
    (let result
        (nmsgn-run consent-token owner-surface repo-root codex-home index-path
            state-root salt-path file-limit candidate-limit expiry-ms
            default-kind lens started))
    (print_str (nth result 1))
    0)
