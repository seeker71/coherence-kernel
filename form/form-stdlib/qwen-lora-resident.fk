; qwen-lora-resident.fk — Form-native continuity arithmetic for the local mouth.
;
; A resident owns one Qwen context and one admitted adapter.  Its input and
; output are Form's line stream: any cell that can hold the stream can speak to
; it, and `release` returns both device resources.  No HTTP, subprocess, or
; second runtime belongs inside this organ.
;
; Proven by: form-stdlib/tests/qwen-lora-resident-band.fk
; preludes: form-stdlib/voice-home.fk form-stdlib/form-cli-model-generate.fk form-stdlib/model-registry.bml

(do
    (defn qlr-release? (line)
        (if (nothing? line) 1 (if (str_eq (trim line) "release") 1 0)))
    ; The final predicted id is returned to the caller but has not yet entered
    ; the recurrent state.  All earlier output ids have, so this is the next
    ; safe position for the following streamed cell.
    (defn qlr-next-pos (pos prompt-ids output-ids)
        (if (gt (len output-ids) 0)
            (add pos (add (len prompt-ids) (sub (len output-ids) 1)))
            (add pos (len prompt-ids))))
    (defn qlr-room? (pos prompt-ids cap maxpos)
        (if (le (add pos (add (len prompt-ids) cap)) maxpos) 1 0))
    ; Three tokens are enough for the first standing breath to complete on the
    ; compact local carrier; the stream itself, not a fresh admission, extends
    ; it on the next line.
    (defn qlr-cap () 3)
    (defn qlr-last-path () ".form-qwen-lora-resident-last.txt")
    0)
