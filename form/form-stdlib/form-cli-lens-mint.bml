//////////////////////////////////////////////////////////////////////
//
// form-cli-lens-mint.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-lens-mint.bml
//
// Eight lens organs asked on every query lane. Overlay class is the
// lens so perception and movement stay distinct from Steiner staking.
// Cartesian n = 8 skills * 9 lanes * (tn+hn).
//
// Proven by: form-stdlib/tests/form-cli-lens-mint-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SampleRow<TClass> {
        member split: String;
        member className: TClass;
        member situation: String;
    }

    class FormLensMintAuthority {
        field MintAuthorityPath = "form/form-stdlib/bml/form-cli-lens-mint.bml";
        field MintAuthorityKind = "high-bml-class-template-field";
    }

    class FormLensMint<T> {
        field MixA = 7;
        field MixB = 13;
        field NSkills = 8;
        field NLanes = 9;
        field LoraWriter = 0;
        field SplitTrain = "train";
        field SplitHeldout = "heldout";

        ref fls-authority = FormLensMintAuthority;
        thought fls-pattern = list("lens", "stake", "perception", "movement");
        thought fls-lanes = list("when", "where", "which", "what", "who", "how", "why", "knowledge-query", "walk");
        thought fls-skills = list("perception", "nl-lens", "pl-lens", "jacobian", "stake", "compiler", "field", "lens-move");
        thought fls-sources = list("form/form-stdlib/lenses.fk", "cognition/nl-lenses-13.fk", "cognition/pl-lenses-13.fk", "observe/jacobian-lens.fk", "ingest/frequency-ingest-steiner-core.fk", "form/form-stdlib/compiler-lens.bml", "form/form-stdlib/field-model-form.fk", "form/form-stdlib/assemblage-point.fk", "presence/inquiry-planes.fk");

        def fls-mix(i, n) = mod(add(mul(i, MixA()), MixB()), n);

        def fls-perception-stems() = list("what IS projects onto meaning feeling trust sovereignty vitality", "meaning is a lookup the other four lenses are measured or earned", "two media carry the projection symbol and sound TTS renders STT recognises", "gate 25 in three tongues is one cell on the meaning lens");
        def fls-nl-stems() = list("thirteen NL lenses detect and generate through a numeric meaning", "presence enquiry affirmation and grounded framing are the four tiny meanings", "unknown text returns empty never a fabricated locale", "crossing NL lenses preserves only caller-supplied detail for meaning four");
        def fls-pl-stems() = list("thirteen PL lenses are registry detection and bounded generation not thirteen parsers", "detection is evidence-scoring not a proof of language", "exact binary-function generation for add subtract multiply division stays out", "a programming surface is a lens onto the same Form cell");
        def fls-jacobian-stems() = list("a choice flips when push exceeds margin hesitation is the most edit-sensitive moment", "nothing is zero-jacobian silence carries no signal back", "timeout is unknown partials remaining unknown is not zero", "the jacobian maps an edit to how much it moves each downstream thought");
        def fls-stake-stems() = list("a lens fires when a mark it addresses is present in the situation", "a lens that always applies is a horoscope not a lens", "staking a lens commits one view the others remain untried like cut", "context requirements choose reverse lenses the arriving situation stakes which fires");
        def fls-compiler-stems() = list("the compiler is a reasoning instrument not only a lowering step", "a compiler lens holds human surface machine surface source map and diagnostics", "fidelity of a source-map is how much of the expression survived the lower", "dependency edges stay visible so movement of one cell is observed from another");
        def fls-field-stems() = list("Hoffman interface lens observer selects fitness icons from a hidden substrate", "Levin bioelectric lens tissue state is voltage-pattern memory", "Wolfram rule-space lens observer budget samples a larger field and leaves residual", "a field recipe uses regions cells deltas receipts not character streams");
        def fls-move-stems() = list("switching the lens moves the assemblage point what was invisible becomes the next move", "jacobian push moves a thought past its margin and the path diverges", "staking one lens changes perception and therefore which lane choice walks", "feeling trust sovereignty vitality move the body before meaning names the move");

        def fls-stems(class) = if str_eq(class, "perception") then fls-perception-stems() else if str_eq(class, "nl-lens") then fls-nl-stems() else if str_eq(class, "pl-lens") then fls-pl-stems() else if str_eq(class, "jacobian") then fls-jacobian-stems() else if str_eq(class, "stake") then fls-stake-stems() else if str_eq(class, "compiler") then fls-compiler-stems() else if str_eq(class, "field") then fls-field-stems() else fls-move-stems();

        def fls-ask(lane, gloss) = if str_eq(lane, "when") then str_concat("When is this computable: ", gloss) else if str_eq(lane, "where") then str_concat("Where is the NodeID for: ", gloss) else if str_eq(lane, "which") then str_concat("Which cell answers: ", gloss) else if str_eq(lane, "what") then str_concat("What is: ", gloss) else if str_eq(lane, "who") then str_concat("Who offers: ", gloss) else if str_eq(lane, "how") then str_concat("How does the body: ", gloss) else if str_eq(lane, "why") then str_concat("Why does Form: ", gloss) else if str_eq(lane, "knowledge-query") then str_concat("Emit knowledge-query envelope ANCHOR PATH for: ", gloss) else str_concat("Walk native then local then remote for: ", gloss);

        def fls-prefix(split) = if str_eq(split, SplitTrain()) then "Observed " else "Boundary: observed ";

        def fls-situation(skill, lane, i, split) {
            let stems = fls-stems(skill);
            let stem = nth(stems, fls-mix(i, len(stems)));
            str_concat(fls-prefix(split), str_concat(fls-ask(lane, stem), str_concat(" case ", int_to_str(i))));
        }

        def fls-row(skill, lane, i, split) = list(split, skill, fls-situation(skill, lane, i, split));

        def fls-i-rows(skill, lane, i, n, split, acc) = if eq(i, n) then acc else fls-i-rows(skill, lane, add(i, 1), n, split, cons(fls-row(skill, lane, i, split), acc));

        def fls-lane-rows(skill, lanes, n, split, acc) = if eq(len(lanes), 0) then acc else fls-lane-rows(skill, tail(lanes), n, split, fls-i-rows(skill, head(lanes), 0, n, split, acc));

        def fls-skill-rows(skills, tn, hn, acc) = if eq(len(skills), 0) then acc else fls-skill-rows(tail(skills), tn, hn, fls-lane-rows(head(skills), fls-lanes(), hn, SplitHeldout(), fls-lane-rows(head(skills), fls-lanes(), tn, SplitTrain(), acc)));

        def fls-corpus(tn, hn) = fls-skill-rows(fls-skills(), tn, hn, tail(list("x")));

        def fls-n(tn, hn) = mul(len(fls-skills()), mul(len(fls-lanes()), add(tn, hn)));

        def fls-has-situation(rows, s) = if eq(len(rows), 0) then 0 else if str_eq(nth(head(rows), 2), s) then 1 else fls-has-situation(tail(rows), s);

        def fls-train-only(rows, acc) = if eq(len(rows), 0) then acc else if str_eq(nth(head(rows), 0), SplitTrain()) then fls-train-only(tail(rows), cons(head(rows), acc)) else fls-train-only(tail(rows), acc);

        def fls-leakage-loop(all, rows) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), SplitHeldout()) then fls-has-situation(fls-train-only(all, tail(list("x"))), nth(head(rows), 2)) else 0, fls-leakage-loop(all, tail(rows)));

        def fls-leakage(rows) = fls-leakage-loop(rows, rows);

        def fls-unique-loop(rows, seen) = if eq(len(rows), 0) then len(seen) else if eq(fls-has-situation(seen, nth(head(rows), 2)), 1) then fls-unique-loop(tail(rows), seen) else fls-unique-loop(tail(rows), cons(head(rows), seen));

        def fls-unique(rows) = fls-unique-loop(rows, tail(list("x")));

        def fls-count-split(rows, split) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), split) then 1 else 0, fls-count-split(tail(rows), split));

        def fls-lora-writer() = LoraWriter();

        def fls-mix-diverse() = if eq(fls-mix(0, 9), fls-mix(1, 9)) then 0 else 1;

        def fls-pair-hit(rows, skill, lane) = fls-has-situation(rows, fls-situation(skill, lane, 0, SplitTrain()));

        def fls-lane-cover(rows, skill, lanes) = if eq(len(lanes), 0) then 1 else if eq(fls-pair-hit(rows, skill, head(lanes)), 0) then 0 else fls-lane-cover(rows, skill, tail(lanes));

        def fls-skill-cover(rows, skills) = if eq(len(skills), 0) then 1 else if eq(fls-lane-cover(rows, head(skills), fls-lanes()), 0) then 0 else fls-skill-cover(rows, tail(skills));

        def fls-covers-all(rows) = fls-skill-cover(rows, fls-skills());

        def fls-predict(models, names, s) = nth(names, fqt-predict-index(models, s));

        def fls-heldout-hit(models, names, row) = if str_eq(nth(row, 0), SplitHeldout()) then if str_eq(fls-predict(models, names, nth(row, 2)), nth(row, 1)) then 1 else 0 else 0;

        def fls-heldout-correct-loop(models, names, rows) = if eq(len(rows), 0) then 0 else add(fls-heldout-hit(models, names, head(rows)), fls-heldout-correct-loop(models, names, tail(rows)));

        def fls-heldout-correct(rows) {
            let names = fls-skills();
            let models = fqt-fit(rows, names);
            fls-heldout-correct-loop(models, names, rows);
        }

        def fls-bit(ok, bit) = if ok then bit else 0;

        def fls-check() {
            let rows = fls-corpus(1, 1);
            let n = fls-n(1, 1);
            let correct = fls-heldout-correct(rows);
            let c0 = fls-bit(eq(n, 144), 1);
            let c1 = fls-bit(eq(fls-mix-diverse(), 1), 2);
            let c2 = fls-bit(eq(fls-leakage(rows), 0), 4);
            let c3 = fls-bit(eq(fls-unique(rows), n), 8);
            let c4 = fls-bit(and(eq(fls-count-split(rows, SplitTrain()), 72), eq(fls-count-split(rows, SplitHeldout()), 72)), 16);
            let c5 = fls-bit(ge(correct, 54), 32);
            let c6 = fls-bit(eq(fls-lora-writer(), 0), 64);
            let c7 = fls-bit(eq(fls-covers-all(rows), 1), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
