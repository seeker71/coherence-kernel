; living-world-contextual-answer.fk -- consent adds context; silence remains.
;
; A current, admitted contention resolution may propose a new contextual
; answer beside the earlier silent answer.  The successor exposes the selected
; route's exact native derivation while retaining the original answer, every
; alternative, and the complete stance evidence.  It does not overwrite the
; silent answer or alter either mapping.  Resolution holders unanimously
; govern admission, and any stance revocation makes the successor stale.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk form-stdlib/living-world-enquiry-answer.fk form-stdlib/living-world-contention-tending.fk

(let LWCTA-ANSWER (bp "LWCTA-ANSWER"))
(let LWCTA-ORIGIN (bp "LWCTA-ORIGIN"))

(defn lwcta-silent-answer-for-items (world items question)
    (if (eq (len items) 0) (lwo-none)
        (do
            (let candidate (head items))
            (if (and (eq (lwen-answer-candidate? candidate) 1)
                     (and (eq (lwo-active? world candidate) 1)
                          (and (eq (lwen-answer-current?
                                       world candidate) 1)
                               (and (node_eq
                                    (lwen-answer-question-candidate
                                        (lwo-emergent-shape candidate))
                                    question)
                                    (eq (oac-nothing?
                                        (lwen-answer-ack
                                            (lwo-emergent-shape candidate)))
                                        1)))))
                candidate
                (lwcta-silent-answer-for-items
                    world (tail items) question)))))

(defn lwcta-silent-answer-for (world question)
    (lwcta-silent-answer-for-items world
        (lwo-field-items (lwo-world-cells world)) question))

; children: earlier silent answer, question, resolution, selected route,
;           output, derivation ack, original alternatives, stance evidence,
;           local path
(defn lwcta-answer (silent resolution-candidate)
    (do
        (let resolution (lwo-emergent-shape resolution-candidate))
        (let route (lwctd-resolution-route resolution))
        (intern_node LWCTA-ANSWER
            (list silent
                  (lwctd-resolution-question resolution)
                  resolution-candidate route
                  (lwen-route-output route)
                  (oac-node (lwen-route-derivation route))
                  (lwctd-resolution-alternatives resolution)
                  (lwctd-resolution-evidence resolution)
                  (lwo-local-path)))))
(defn lwcta-answer? (cell) (lwo-category? cell LWCTA-ANSWER))
(defn lwcta-answer-silent (answer) (nth (node_children answer) 0))
(defn lwcta-answer-question (answer) (nth (node_children answer) 1))
(defn lwcta-answer-resolution (answer) (nth (node_children answer) 2))
(defn lwcta-answer-route (answer) (nth (node_children answer) 3))
(defn lwcta-answer-output (answer) (nth (node_children answer) 4))
(defn lwcta-answer-ack (answer) (nth (node_children answer) 5))
(defn lwcta-answer-alternatives (answer) (nth (node_children answer) 6))
(defn lwcta-answer-stance-evidence (answer) (nth (node_children answer) 7))
(defn lwcta-answer-path (answer) (nth (node_children answer) 8))

(defn lwcta-origin (answer witnesses)
    (intern_node LWCTA-ORIGIN (list answer witnesses)))

(defn lwcta-answer-proposal (world resolution-candidate)
    (if (eq (lwctd-resolution-steady?
                world resolution-candidate) 0) (lwo-none)
        (do
            (let resolution (lwo-emergent-shape resolution-candidate))
            (let question (lwctd-resolution-question resolution))
            (let silent (lwcta-silent-answer-for world question))
            (if (node_eq silent (lwo-none)) (lwo-none)
                (do
                    (let witnesses
                        (lwr-field-union-items
                            (lwo-field-items
                                (lwo-active-attributions-for world silent))
                            (lwo-active-attributions-for
                                world resolution-candidate)))
                    (let answer (lwcta-answer silent resolution-candidate))
                    (let origin (lwcta-origin answer witnesses))
                    (let candidate
                        (lwo-emergent answer witnesses
                            (intern_trivial_int
                                (lwo-field-size
                                    (lwo-active-attributions-for
                                        world resolution-candidate)))
                            (intern_trivial_int 1)
                            (intern_trivial_int
                                (lwo-field-size witnesses)) origin))
                    (lwt-proposal candidate
                        (lwt-sources-from-attributions
                            (lwo-field-items witnesses) (lwo-empty-field))
                        origin))))))

(defn lwcta-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwcta-answer?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwcta-current? (world candidate)
    (if (eq (lwcta-candidate? candidate) 0) 0
        (do
            (let answer (lwo-emergent-shape candidate))
            (let fresh
                (lwcta-answer-proposal world
                    (lwcta-answer-resolution answer)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))

(defn lwcta-steady? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwcta-current? world candidate) 1)) 1 0))

(defn lwcta-active-for-resolution-items? (world items resolution)
    (if (eq (len items) 0) 0
        (do
            (let candidate (head items))
            (if (and (eq (lwcta-candidate? candidate) 1)
                     (and (eq (lwcta-steady? world candidate) 1)
                          (node_eq
                            (lwcta-answer-resolution
                                (lwo-emergent-shape candidate))
                            resolution)))
                1
                (lwcta-active-for-resolution-items?
                    world (tail items) resolution)))))

(defn lwcta-active-for-resolution? (world resolution)
    (lwcta-active-for-resolution-items? world
        (lwo-field-items (lwo-world-cells world)) resolution))

(defn lwcta-proposals-items (world items acc)
    (if (eq (len items) 0) acc
        (do
            (let resolution (head items))
            (lwcta-proposals-items world (tail items)
                (if (or
                        (eq (lwctd-resolution-steady?
                                world resolution) 0)
                        (eq (lwcta-active-for-resolution?
                                world resolution) 1)) acc
                    (do
                        (let proposal
                            (lwcta-answer-proposal world resolution))
                        (if (node_eq proposal (lwo-none)) acc
                            (lwo-field-add acc proposal))))))))

(defn lwcta-proposals (world)
    (lwcta-proposals-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwcta-integrate (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwcta-current? (lwt-round-world round) candidate) 0)
            (lwt-round (lwt-round-world round) (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field)
                    (lwt-evaluate-proposal
                        (lwt-round-world round) proposal)) round)
            (lwt-integrate round proposal action))))
