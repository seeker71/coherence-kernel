// kernel-http-header.fk — focused Form-native HTTP header value surface.
//
// `http_get` emits header rows as `(43001 name value)`.  Artifact movement
// needs only that row and an ASCII case-insensitive lookup; importing the whole
// request/router/pressure graph for those three fields made the model door carry
// unrelated protocol meaning.  This cell is the canonical header subset used by
// kernel-http.fk too: the logic is moved, not copied.
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    let kh_tag_header = 43001;
    def kh-ascii-lower-char(c) = {
        let cp = ord(c);
        cp >= 65 && cp <= 90 ? char_at("abcdefghijklmnopqrstuvwxyz", cp - 65) : c;
    };
    def kh-ascii-lower-loop(text, i) = i >= str_len(text) ? "" : str_concat(kh-ascii-lower-char(char_at(text, i)), kh-ascii-lower-loop(text, i + 1));
    def kh-ascii-lower(text) = kh-ascii-lower-loop(text, 0);
    def kh-str-eq-ci?(left, right) = (String) kh-ascii-lower(left) == kh-ascii-lower(right);
    def kh-header(name, value) = list(kh_tag_header, name, value);
    def kh-header?(header) = (Comparable) len(header) == 3 ? (Comparable) nth(header, 0) == kh_tag_header : false;
    def kh-header-name(header) = nth(header, 1);
    def kh-header-value(header) = nth(header, 2);
    def kh-headers-valid?(headers) = nil?(headers) ? true : kh-header?(head(headers)) ? kh-headers-valid?(tail(headers)) : false;
    def kh-header-present?(headers, name) = nil?(headers) ? false : kh-str-eq-ci?(kh-header-name(head(headers)), name) ? true : kh-header-present?(tail(headers), name);
    def kh-header-value-or(headers, name, default-value) = nil?(headers) ? default-value : kh-str-eq-ci?(kh-header-name(head(headers)), name) ? kh-header-value(head(headers)) : kh-header-value-or(tail(headers), name, default-value);
    def kh-header-observation(headers, name) = (String) name == "" ? "not-required" : kh-header-present?(headers, name) ? "present" : "missing";
}
