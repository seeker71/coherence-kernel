//////////////////////////////////////////////////////////////////////
//
// text-rows.bml
//
// Executable BML. The TEXT-ROWS ENGINE: one vocabulary for tabular
// text — files and pipes of "field field field" lines (heat
// snapshots, process censuses, stones ledgers). Line boundaries,
// kth-field slicing, integer fields, count, find-line, and
// max-line-by-int-field live HERE and nowhere else; the line
// primitives the glass vocabulary re-exports are these.
//
// preludes: form-stdlib/core.fk
//
// Proven by: form-stdlib/tests/text-rows-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormTextRows {
        thought text-rows-pattern = list("lines-are-rows", "fields-by-index", "one-line-vocabulary");

        def tx-nl() = byte_to_str(10);
        def tx-line-end(s, i) = if ge(i, str_len(s)) then i else if eq(ord(char_at(s, i)), 10) then i else tx-line-end(s, add(i, 1));
        def tx-line-start(s, at) = if le(at, 0) then 0 else if eq(ord(char_at(s, sub(at, 1))), 10) then at else tx-line-start(s, sub(at, 1));
        def tx-line-till(s, i) = substring(s, i, tx-line-end(s, i));
        def tx-line-of(s, at) = if lt(at, 0) then "" else substring(s, tx-line-start(s, at), tx-line-end(s, at));
        def tx-count-lines(s) = tx-count-go(s, 0, 0);
        def tx-count-go(s, from, acc) = tx-count-at(s, str_find(s, tx-nl(), from), acc);
        def tx-count-at(s, at, acc) = if lt(at, 0) then acc else tx-count-go(s, add(at, 1), add(acc, 1));
        def tx-find-line(s, needle) = tx-line-of(s, str_find(s, needle, 0));

        def tx-field-start(line, k, i) = if le(k, 0) then i else tx-field-start(line, sub(k, 1), tx-skip-field(line, i));
        def tx-skip-field(line, i) = tx-skip-spaces(line, tx-field-end(line, i));
        def tx-field-end(line, i) = if ge(i, str_len(line)) then i else if str_eq(char_at(line, i), " ") then i else tx-field-end(line, add(i, 1));
        def tx-skip-spaces(line, i) = if ge(i, str_len(line)) then i else if str_eq(char_at(line, i), " ") then tx-skip-spaces(line, add(i, 1)) else i;
        def tx-field(line, k) = tx-field-of(line, tx-field-start(line, k, 0));
        def tx-field-of(line, i) = substring(line, i, tx-field-end(line, i));
        def tx-rest(line, k) = substring(line, tx-field-start(line, k, 0), str_len(line));
        def tx-int(line, k) = tx-int-of(tx-field(line, k));
        def tx-int-of(w) = if eq(str_len(w), 0) then 0 else str_to_int(w);

        def tx-max-line-go(s, k, from, best, bestline) = tx-max-line-at(s, k, from, str_find(s, tx-nl(), from), best, bestline);
        def tx-max-line-at(s, k, from, nl, best, bestline) = if lt(nl, 0) then bestline else tx-max-line-pick(s, k, nl, tx-int(substring(s, from, nl), k), substring(s, from, nl), best, bestline);
        def tx-max-line-pick(s, k, nl, v, line, best, bestline) = if gt(v, best) then tx-max-line-go(s, k, add(nl, 1), v, line) else tx-max-line-go(s, k, add(nl, 1), best, bestline);
        def tx-max-line-by-int(s, k) = if eq(str_len(s), 0) then "" else tx-max-line-go(s, k, 0, sub(0, 1), "");
    }
    0;
}
