; switch-census.fk — how many questions does this body ask its caller? A number, and a ratchet.
;
; WHY A NUMBER. Urs, 2026-08-03: "why all the knobs and switches? we support all silicone on all
; platforms, and if we find an issue that means unfinished work, nothing more." The census that day
; found 69 FORM_DS4_* and 9 FORM_CLI_*. A switch is a question the body asks the caller instead of
; answering, so with 69 of them "what are we capable of" had no single answer — it had a
; configuration space — and every question therefore became a trial. The knobs were why we did not
; know ourselves. A count that nobody states is a count that only grows, so the body states it.
;
; THE DISPOSITION RULE, which is the whole cleanup:
;
;   INPUT       a value the caller must supply because only the caller knows it — which model file,
;               which prompt, how many steps. Not a knob. An argument. These stay.
;   INSTRUMENT  a diagnostic that changes what is REPORTED and never what is COMPUTED. Legitimate,
;               but ten of them is nine too many; they want one door, not one flag each.
;   EXPERIMENT  an A/B on behaviour or speed. THE DEFAULT ALREADY IS THE DECISION — whatever the
;               switch does when unset is what we ship, every day, to everyone. So the other branch
;               is a decision made and never written down. Inline the default, delete the loser.
;               These must reach zero.
;
; WHY THE RATCHET AND NOT A TARGET. A target is a wish. sc-ceiling is the count as last measured, and
; the band FAILS if today's census exceeds it. Adding a switch is then not forbidden — it is visible,
; and it costs a deliberate edit to this line with your reason next to it. That is the difference
; between a rule and a wall.
;
; HOW TO RE-MEASURE (the census is a fact about the tree, not a fact about this cell):
;   grep -rhoE 'FORM_(DS4|CLI)_[A-Z0-9_]+' --include='*.sh' --include='*.fk' . | sort -u | wc -l
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/switch-census-band.fk

(do
    ; ---- the census, measured, not estimated -------------------------------------------
    ; 2026-08-03 opened at 78 (69 DS4 + 9 CLI). First pass removed four: HZ_SCOPED and PAD were
    ; live branches whose own comments said "REFUTED, and kept as the falsifier" — the numbers are
    ; the falsifier, a branch nobody takes is a second program maintained in the dark; MOE_FUSE2 and
    ; Q80_CPU_ORDER were comments promising an A/B whose code was already gone. Deleting all four
    ; left the lane bit-identical: 113 PASS, 101 gates, same decoded stream.
    (defn sc-opened-at () 78)
    (defn sc-measured-ds4 () 62)
    (defn sc-measured-cli () 9)
    (defn sc-measured () (add (sc-measured-ds4) (sc-measured-cli)))

    ; of the 57 DS4 switches actually READ by metal_dsv4_stack.sh (the other 12 are named in
    ; comments or read elsewhere), this is how they fall. Classification is a judgement and is
    ; meant to be argued with; the counts are not.
    (defn sc-input () 13)        ; blob, prompt, prompt-ids, prompt-token, kv-steps, kv-cap,
                                 ; kv-sequence, stack-layers, control-adapter, ref-logits,
                                 ; ref-logits-b, ref-ids, seq-ids
    (defn sc-instrument () 10)   ; gates, profile, trace-hc, stage-blk0, census, bw, double,
                                 ; skip, hostshare, dump-logits
    (defn sc-experiment () (sub (sc-measured) (add (sc-input) (sc-instrument))))

    ; ---- the ratchet ------------------------------------------------------------------
    ; Raise this ONLY with a reason written beside it. Lowering it is the work.
    (defn sc-ceiling () 71)
    (defn sc-within-ratchet? (n) (if (le n (sc-ceiling)) 1 0))

    ; ---- the law this encodes ----------------------------------------------------------
    ; Stated so a reader meets it here rather than inferring it from the numbers.
    (defn sc-law ()
        (list
            "the only limits are the physical hardware and our imagination"
            "an issue is unfinished work, never a limit"
            "UNFINISHED names the work and the file that would do it; there is no category for 'limit'"
            "platform support is detection, not configuration — Darwin links Metal, Windows loads nvcuda, neither asks"
            "the default already IS the decision; an un-deleted branch is a decision never written down"))

    (defn sc-say (xs) (if (eq (len xs) 0) 0 (do (print_str (str_concat "  " (head xs))) (sc-say (tail xs)))))

    (print_str "— questions this body asks its caller —")
    (print_str (str_concat "  measured 2026-08-03   " (int_to_str (sc-measured))))
    (print_str (str_concat "  input       (keep)    " (int_to_str (sc-input))))
    (print_str (str_concat "  instrument  (fold)    " (int_to_str (sc-instrument))))
    (print_str (str_concat "  experiment  (delete)  " (int_to_str (sc-experiment))))
    (print_str (str_concat "  ratchet ceiling       " (int_to_str (sc-ceiling))))
    (print_str "")
    (sc-say (sc-law))
    (sc-experiment))
