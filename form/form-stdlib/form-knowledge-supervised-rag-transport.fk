; form-knowledge-supervised-rag-transport.fk -- answer-free supervised query
; transport, projected beside rather than into canonical mastery.
;
; The integration census has two intentionally narrower admissions:
; canonical heldout integration and heldout source retrieval.  The observed
; axioms query rehearsal is neither.  Form supplied an answer-free query offer,
; the local model emitted it, Form executed the source-bound lookup and injected
; the typed result, and the same local stream answered.  This cell retains that
; useful crossing without relabeling it as canonical heldout, learned weights,
; native program execution, or whole-family mastery.
;
; A task reconstructs its public query offer and effective prompt.  A physical
; row carries only hashes, counters, scores, and releases from the live report.
; A boundary binds the durable receipt and keeps all three mastery credits at
; literal zero.  The projection has its own denominator: distinct offered
; supervised transport tasks.  It never enters fki-observation or changes any
; field of form-knowledge-integration-report-v1.
;
; Content addresses establish byte consistency and current-source freshness;
; they do not authenticate the model, GPU, process, or host.
;
; preludes: form-stdlib/form-knowledge-integration-census.fk
; preludes: form-stdlib/form-knowledge-axioms-public-curriculum.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/native-model-evidence.fk
; Proven by: form-stdlib/tests/form-knowledge-supervised-rag-transport-band.fk

(do
    (defn fksrt-basis ()
        "current-source+answer-free-offer+scannerless-query+typed-rag-injection+same-stream-answer+separate-credit-v1")
    (defn fksrt-auth-seam ()
        "content-bound public receipt does not authenticate model, GPU, process, or host")
    (defn fksrt-scope () "supervised-answer-free-rag-transport-only")

    ; task = tag task-id binding-kind row-id family path anchor question
    ;        current-source-id
    (defn fksrt-task
        (task-id binding-kind row-id family path anchor question source-id)
        (list "supervised-rag-task-v1" task-id binding-kind row-id family path
              anchor question source-id))
    (defn fksrt-task-id (t) (nth t 1))
    (defn fksrt-task-binding-kind (t) (nth t 2))
    (defn fksrt-task-row-id (t) (nth t 3))
    (defn fksrt-task-family (t) (nth t 4))
    (defn fksrt-task-path (t) (nth t 5))
    (defn fksrt-task-anchor (t) (nth t 6))
    (defn fksrt-task-question (t) (nth t 7))
    (defn fksrt-task-source-id (t) (nth t 8))
    (defn fksrt-task-offer (t)
        (fkap-rag-query-offer (fksrt-task-path t) (fksrt-task-anchor t)
            (fksrt-task-question t)))
    (defn fksrt-task-prompt (t)
        (fkap-query-rehearsal-prompt (fksrt-task-offer t)
            (fksrt-task-question t)))
    (defn fksrt-task-effective-prompt (t)
        (do
            (let prompt (fksrt-task-prompt t))
            (if (nothing? prompt) (nothing)
                (fqt-bound-source-knowledge-prompt prompt))))
    (defn fksrt-task-expected-frame (t)
        (do
            (let offer (fksrt-task-offer t))
            (if (nothing? offer) "" (nth offer 3))))
    (defn fksrt-source-id-sha (source-id)
        (if (eq (fki-source-artifact-id-shape? source-id) 1)
            (substring source-id 7 71) ""))
    (defn fksrt-task-binding-sha (t)
        (do
            (let effective (fksrt-task-effective-prompt t))
            (if (nothing? effective) ""
                (nmfe-sha256 (nmfe-fields (list
                    (fksrt-task-binding-kind t)
                    (fksrt-task-row-id t)
                    (fksrt-task-path t)
                    (fksrt-source-id-sha (fksrt-task-source-id t))
                    (nmfe-sha256 (fksrt-task-question t))
                    (nmfe-sha256 (fksrt-task-expected-frame t))
                    (nmfe-sha256 effective)))))))
    (defn fksrt-task-valid? (t sources)
        (if (not (eq (len t) 9)) 0
            (do
                (let offer (fksrt-task-offer t))
                (let prompt (fksrt-task-prompt t))
                (let checks (list
                    (if (str_eq (nth t 0) "supervised-rag-task-v1") 1 0)
                    (if (gt (str_len (fksrt-task-id t)) 0) 1 0)
                    (if (str_eq (fksrt-task-binding-kind t)
                            "axioms-query-rehearsal-binding-v1") 1 0)
                    (if (gt (str_len (fksrt-task-row-id t)) 0) 1 0)
                    (fki-current-source-member? (fksrt-task-path t)
                        (fksrt-task-family t) sources)
                    (if (str_eq (fksrt-task-source-id t)
                            (fkss-source-id (fksrt-task-path t))) 1 0)
                    (fki-source-artifact-id-shape?
                        (fksrt-task-source-id t))
                    (fkap-rag-query-offer-valid? offer
                        (fksrt-task-question t))
                    (if (nothing? prompt) 0 1)
                    (if (nothing? offer) 0
                        (if (eq (nth offer 8) 0) 1 0))
                    (if (gt (str_len (fksrt-task-binding-sha t)) 0) 1 0)))
                (if (eq (sum checks) 11) 1 0))))

    ; physical = tag model binding-sha effective-prompt-sha
    ;            expected-frame-sha actual-frame-sha raw-sha answer-sha
    ;            answer-key reported-source-id source-id live-cursor
    ;            frame-exact frame-at-zero frame-once query-tokens answer-tokens
    ;            hits misses nothings frame-refusals generated-tokens
    ;            forward-passes exact-ppm f1-ppm sequence-ppm promotion-ppm
    ;            error state-release residence-release latency-ms verdict
    (defn fksrt-physical
        (model-id binding-sha effective-prompt-sha expected-frame-sha
         actual-frame-sha raw-sha answer-sha answer-key reported-source-id
         source-id live-cursor frame-exact frame-at-zero frame-once query-tokens
         answer-tokens hits misses nothings frame-refusals generated-tokens
         forward-passes exact-ppm f1-ppm sequence-ppm promotion-ppm error
         state-release residence-release latency-ms verdict)
        (list "supervised-rag-physical-v1" model-id binding-sha
              effective-prompt-sha expected-frame-sha actual-frame-sha raw-sha
              answer-sha answer-key reported-source-id source-id live-cursor
              frame-exact frame-at-zero frame-once query-tokens answer-tokens
              hits misses nothings frame-refusals generated-tokens
              forward-passes exact-ppm f1-ppm sequence-ppm promotion-ppm error
              state-release residence-release latency-ms verdict))
    (defn fksrt-physical-binding-sha (p) (nth p 2))
    (defn fksrt-physical-score-shaped? (p)
        (if (and (ge (nth p 23) 0) (le (nth p 23) 1000000))
            (if (and (ge (nth p 24) 0) (le (nth p 24) 1000000))
            (if (and (ge (nth p 25) 0) (le (nth p 25) 1000000))
            (if (and (ge (nth p 26) 0) (le (nth p 26) 1000000)) 1 0)
            0) 0) 0))
    (defn fksrt-physical-hashes-shaped? (p)
        (if (and (eq (nmfe-sha256? (nth p 2)) 1)
            (and (eq (nmfe-sha256? (nth p 3)) 1)
            (and (eq (nmfe-sha256? (nth p 4)) 1)
            (and (eq (nmfe-sha256? (nth p 5)) 1)
            (and (eq (nmfe-sha256? (nth p 6)) 1)
            (and (eq (nmfe-sha256? (nth p 7)) 1)
                 (eq (nmfe-sha256? (nth p 8)) 1))))))) 1 0))
    (defn fksrt-transport-valid? (task p sources)
        (if (or (eq (fksrt-task-valid? task sources) 0)
                (not (eq (len p) 32))) 0
            (do
                (let effective (fksrt-task-effective-prompt task))
                (let checks (list
                    (if (str_eq (nth p 0) "supervised-rag-physical-v1") 1 0)
                    (if (gt (str_len (nth p 1)) 0) 1 0)
                    (fksrt-physical-hashes-shaped? p)
                    (if (str_eq (nth p 2)
                            (fksrt-task-binding-sha task)) 1 0)
                    (if (str_eq (nth p 3) (nmfe-sha256 effective)) 1 0)
                    (if (str_eq (nth p 4)
                            (nmfe-sha256
                                (fksrt-task-expected-frame task))) 1 0)
                    (if (str_eq (nth p 5) (nth p 4)) 1 0)
                    (if (str_eq (nth p 9)
                            (fksrt-task-source-id task)) 1 0)
                    (if (str_eq (nth p 10)
                            (fksrt-task-source-id task)) 1 0)
                    (if (and (eq (nth p 11) 1)
                        (and (eq (nth p 12) 1)
                        (and (eq (nth p 13) 1)
                             (eq (nth p 14) 1)))) 1 0)
                    (if (and (gt (nth p 15) 0)
                             (gt (nth p 16) 0)) 1 0)
                    (if (and (eq (nth p 17) 1)
                        (and (eq (nth p 18) 0)
                        (and (eq (nth p 19) 0)
                             (eq (nth p 20) 0)))) 1 0)
                    (if (and (gt (nth p 21) 0)
                        (and (eq (nth p 21)
                                (add (nth p 15) (nth p 16)))
                             (ge (nth p 22) (nth p 21)))) 1 0)
                    (fksrt-physical-score-shaped? p)
                    (if (or (eq (nth p 27) 0) (eq (nth p 27) 1)) 1 0)
                    (if (and (eq (nth p 28) 1)
                             (eq (nth p 29) 1)) 1 0)
                    (if (gt (nth p 30) 0) 1 0)
                    (if (eq (nth p 31) 134217727) 1 0)))
                (if (eq (sum checks) 18) 1 0))))
    (defn fksrt-answer95? (task p sources)
        (if (eq (fksrt-transport-valid? task p sources) 0) 0
            (if (and (ge (nth p 23) 950000)
                (and (ge (nth p 24) 950000)
                (and (ge (nth p 25) 950000)
                (and (ge (nth p 26) 950000)
                     (eq (nth p 27) 0))))) 1 0)))

    ; boundary = tag mode answer-free supervised canonical-heldout-credit
    ;            learned-weights-credit whole-family-mastery-credit
    ;            receipt-path receipt-source-id observed-at auth-seam
    (defn fksrt-boundary (receipt-path receipt-source-id observed-at)
        (list "supervised-rag-boundary-v1"
              "supervised-answer-free-rag" 1 1 0 0 0 receipt-path
              receipt-source-id observed-at (fksrt-auth-seam)))
    (defn fksrt-boundary-valid? (b)
        (if (not (eq (len b) 11)) 0
            (if (and (str_eq (nth b 0) "supervised-rag-boundary-v1")
                (and (str_eq (nth b 1) "supervised-answer-free-rag")
                (and (eq (nth b 2) 1)
                (and (eq (nth b 3) 1)
                (and (eq (nth b 4) 0)
                (and (eq (nth b 5) 0)
                (and (eq (nth b 6) 0)
                (and (gt (str_len (nth b 7)) 0)
                (and (str_eq (nth b 8) (fkss-source-id (nth b 7)))
                (and (gt (str_len (nth b 9)) 0)
                     (str_eq (nth b 10) (fksrt-auth-seam)))))))))))) 1 0)))

    (defn fksrt-observation (task physical boundary)
        (list "supervised-rag-transport-observation-v1" task physical
              boundary))
    (defn fksrt-observation-task (o) (nth o 1))
    (defn fksrt-observation-physical (o) (nth o 2))
    (defn fksrt-observation-boundary (o) (nth o 3))
    (defn fksrt-observation-binding-sha (o)
        (fksrt-physical-binding-sha (fksrt-observation-physical o)))
    (defn fksrt-observation-valid? (o sources)
        (if (not (eq (len o) 4)) 0
            (if (and (str_eq (nth o 0)
                         "supervised-rag-transport-observation-v1")
                (and (eq (fksrt-transport-valid?
                            (fksrt-observation-task o)
                            (fksrt-observation-physical o) sources) 1)
                     (eq (fksrt-boundary-valid?
                            (fksrt-observation-boundary o)) 1))) 1 0)))

    (defn fksrt-count-valid (rows sources)
        (if (eq (len rows) 0) 0
            (add (fksrt-observation-valid? (head rows) sources)
                 (fksrt-count-valid (tail rows) sources))))
    (defn fksrt-count-answer95 (rows sources)
        (if (eq (len rows) 0) 0
            (add (if (eq (fksrt-observation-valid? (head rows) sources) 1)
                     (fksrt-answer95? (fksrt-observation-task (head rows))
                         (fksrt-observation-physical (head rows)) sources) 0)
                 (fksrt-count-answer95 (tail rows) sources))))
    (defn fksrt-count-binding (binding rows)
        (if (eq (len rows) 0) 0
            (add (if (and (eq (len (head rows)) 4)
                          (str_eq binding
                              (fksrt-observation-binding-sha (head rows)))) 1 0)
                 (fksrt-count-binding binding (tail rows)))))
    (defn fksrt-count-duplicate-bindings (remaining all)
        (if (eq (len remaining) 0) 0
            (add (if (and (eq (len (head remaining)) 4)
                          (gt (fksrt-count-binding
                              (fksrt-observation-binding-sha (head remaining))
                              all) 1)) 1 0)
                 (fksrt-count-duplicate-bindings (tail remaining) all))))
    (defn fksrt-percent (n total)
        (if (eq total 0) 0 (div (mul n 100) total)))

    ; projection fields: tag scope offered valid answer95 invalid duplicates
    ; transport-percent answer95-percent canonical-credit learned-credit
    ; family-mastery-credit current-source-bound answer-free-supervised basis seam
    (defn fksrt-project (sources observations)
        (do
            (let total (len observations))
            (let valid (fksrt-count-valid observations sources))
            (let answer95 (fksrt-count-answer95 observations sources))
            (let duplicates
                (fksrt-count-duplicate-bindings observations observations))
            (list "form-knowledge-supervised-rag-transport-projection-v1"
                  (fksrt-scope) total valid answer95 (sub total valid)
                  duplicates (fksrt-percent valid total)
                  (fksrt-percent answer95 total) 0 0 0 valid valid
                  (fksrt-basis) (fksrt-auth-seam))))
    (defn fksrt-projection-valid? (r)
        (if (not (eq (len r) 16)) 0
            (if (and (str_eq (nth r 0)
                         "form-knowledge-supervised-rag-transport-projection-v1")
                (and (str_eq (nth r 1) (fksrt-scope))
                (and (eq (nth r 2) (add (nth r 3) (nth r 5)))
                (and (eq (nth r 6) 0)
                (and (eq (nth r 7) (fksrt-percent (nth r 3) (nth r 2)))
                (and (eq (nth r 8) (fksrt-percent (nth r 4) (nth r 2)))
                (and (eq (nth r 9) 0)
                (and (eq (nth r 10) 0)
                (and (eq (nth r 11) 0)
                (and (eq (nth r 12) (nth r 3))
                (and (eq (nth r 13) (nth r 3))
                (and (str_eq (nth r 14) (fksrt-basis))
                     (str_eq (nth r 15) (fksrt-auth-seam)))))))))))))) 1 0)))

    ; Durable public adapter for the strengthened 2026-08-25 observation.
    ; It carries no answer bytes and earns no canonical or family credit.
    (defn fksrt-axioms-task ()
        (fksrt-task "axioms-resting-point-count-v1"
            "axioms-query-rehearsal-binding-v1" "h01" "axioms"
            "axioms/core-axioms.form" "resting point"
            "How many axioms are held as the resting point in core-axioms.form? Reply with only the English number."
            "sha256:893d1a85f5a9475705e59f1bac50b9b19076e2fafb55751b52897af3a6d5bcad"))
    (defn fksrt-axioms-physical ()
        (fksrt-physical "Qwen3.8-27B-Q8_0-local"
            "66ee9a6bbce5937e656bb5c0bfe813a3f2555d51a9c6fc4b63998312ba98a8cc"
            "02923a57150a68d75a9ff6ea6ecb121a7efea14963864f651f65a4808fe96d46"
            "ec543fe301c403275641265fa224899e01debb596367a2c09a27adf5ef8ccc46"
            "ec543fe301c403275641265fa224899e01debb596367a2c09a27adf5ef8ccc46"
            "4d7db831fdb44d9a7dbc7cc934c1177e94117f3f94852219bdc51153a2d0ac50"
            "222b0bd51fcef7e65c2e62db2ed65457013bab56be6fafeb19ee11d453153c80"
            "d4610fbe9d17783baa32a1343e1923b461c3b3fd9bb6909faa82f6e1610c4cd0"
            "sha256:893d1a85f5a9475705e59f1bac50b9b19076e2fafb55751b52897af3a6d5bcad"
            "sha256:893d1a85f5a9475705e59f1bac50b9b19076e2fafb55751b52897af3a6d5bcad"
            1 1 1 1 20 1 1 0 0 0 21 1039
            1000000 1000000 1000000 1000000 0 1 1 515907 134217727))
    (defn fksrt-axioms-boundary ()
        (fksrt-boundary
            "receipts/2026-08-25-axioms-query-token-rag-transfer.md"
            "sha256:1e6e0c4d765670422911cee1dcb5543c49e937f7a966dabe0eb935dc52ad8127"
            "2026-08-25-WITA"))
    (defn fksrt-axioms-observation ()
        (fksrt-observation (fksrt-axioms-task)
            (fksrt-axioms-physical) (fksrt-axioms-boundary)))
    (defn fksrt-axioms-sources ()
        (list (fki-source "axioms/core-axioms.form" "axioms")))
    (defn fksrt-axioms-projection ()
        (fksrt-project (fksrt-axioms-sources)
            (list (fksrt-axioms-observation))))

    0)
