; form-cli-turn-evidence-grok-refresh.fk — count @form receipts and
; turn_started events in the bound Grok session. Writes the private
; evidence row. Prompt and answer text are never stored.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
; preludes: form-stdlib/form-fs.fk
; preludes: form-stdlib/form-cli-turn-evidence.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk
; preludes: form-stdlib/form-cli-turn-evidence-grok.fk

(do
    (let session (fctg-bound-session))
    (if (str_eq session "")
        (do (print_str "turn-evidence-refresh=withheld\n") 1)
        (do (print_str (fctg-refresh-once session)) 0)))
