; living-world-composition-outcome.fk -- observed results reopen compositions.
;
; A composition is derived only from a current ALIGNED multi-lens bundle. It
; retains the exact primary sequence, every current outcome observation, a
; state, alternatives, optional unknown, witnesses, and local path.
;
; Outcome observations target the stable bundle identity rather than a mutable
; candidate. ONE confirms only the exact aligned sequence. ZERO carries a
; different observed sequence as correction. NOTHING carries no invented
; sequence. Alternative NODEs and other NODEs remain separate. Lens,
; alternatives, unknown, and evidence are independently optional payloads.
;
; New or revoked outcome evidence changes composition identity. The earlier
; admitted candidate stays in history but becomes stale; a fresh proposal is
; governed by all current bundle and outcome holders. Corrections never rewrite
; relation edges or silently become grammar authority.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-multilens-plan.fk

(let LWCO-OBSERVATION  (bp "LWCO-OBSERVATION"))
(let LWCO-EVIDENCE     (bp "LWCO-EVIDENCE"))
(let LWCO-EVIDENCE-SET (bp "LWCO-EVIDENCE-SET"))
(let LWCO-COMPOSITION  (bp "LWCO-COMPOSITION"))
(let LWCO-UNOBSERVED   (bp "LWCO-UNOBSERVED"))
(let LWCO-CONFIRMED    (bp "LWCO-CONFIRMED"))
(let LWCO-CONTESTED    (bp "LWCO-CONTESTED"))
(let LWCO-ORIGIN       (bp "LWCO-ORIGIN"))

(defn lwco-unobserved () (intern_node LWCO-UNOBSERVED (empty)))
(defn lwco-confirmed () (intern_node LWCO-CONFIRMED (empty)))
(defn lwco-contested () (intern_node LWCO-CONTESTED (empty)))
(defn lwco-unobserved? (cell) (lwo-category? cell LWCO-UNOBSERVED))
(defn lwco-confirmed? (cell) (lwo-category? cell LWCO-CONFIRMED))
(defn lwco-contested? (cell) (lwo-category? cell LWCO-CONTESTED))

; children: addressed bundle, optional observed sequence, optional lens, ack,
;           optional alternatives, optional unknown, evidence, local path
(defn lwco-observation
    (bundle observed lens ack alternatives unknown evidence)
    (intern_node LWCO-OBSERVATION
        (list bundle observed lens ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwco-observation? (cell) (lwo-category? cell LWCO-OBSERVATION))
(defn lwco-observation-bundle (observation) (nth (node_children observation) 0))
(defn lwco-observation-observed (observation)
    (nth (node_children observation) 1))
(defn lwco-observation-lens (observation) (nth (node_children observation) 2))
(defn lwco-observation-ack (observation) (nth (node_children observation) 3))
(defn lwco-observation-alternatives (observation)
    (nth (node_children observation) 4))
(defn lwco-observation-unknown (observation) (nth (node_children observation) 5))
(defn lwco-observation-offered-evidence (observation)
    (nth (node_children observation) 6))
(defn lwco-observation-path (observation) (nth (node_children observation) 7))

(defn lwco-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwco-observed-optional-sequence? (observed)
    (if (or (node_eq observed (lwo-none))
            (eq (lwrp-sequence? observed) 1)) 1 0))
(defn lwco-observation-coherent? (observation)
    (do
        (let bundle (lwco-observation-bundle observation))
        (let observed (lwco-observation-observed observation))
        (let ack (lwco-observation-ack observation))
        (let primary (lwmp-bundle-primary-sequence bundle))
        (if (eq (oac-one? ack) 1)
            (if (and (eq (lwrp-sequence? observed) 1)
                     (node_eq observed primary)) 1 0)
            (if (eq (oac-zero? ack) 1)
                (if (and (eq (lwrp-sequence? observed) 1)
                         (not (node_eq observed primary))) 1 0)
                (if (eq (oac-nothing? ack) 1)
                    (if (node_eq observed (lwo-none)) 1 0)
                    (lwco-observed-optional-sequence? observed))))))
(defn lwco-observation-valid? (observation)
    (if (and (eq (lwco-observation? observation) 1)
             (and (eq (lwmp-bundle-aligned?
                         (lwco-observation-bundle observation)) 1)
                  (and (eq (oac-valid-ack?
                             (lwco-observation-ack observation)) 1)
                       (and (eq (lwo-category?
                                  (lwco-observation-alternatives observation)
                                  LWO-FIELD) 1)
                            (and (eq (lwco-optional-unknown-valid?
                                      (lwco-observation-unknown observation)) 1)
                                 (eq (lwco-observation-coherent?
                                      observation) 1)))))) 1 0))

; children: observation and all current attribution witnesses
(defn lwco-evidence (observation attributions)
    (intern_node LWCO-EVIDENCE (list observation attributions)))
(defn lwco-evidence-observation (evidence) (nth (node_children evidence) 0))
(defn lwco-evidence-attributions (evidence) (nth (node_children evidence) 1))

; children: confirmations, corrections, silences, alternatives, unresolved
(defn lwco-evidence-set
    (confirmations corrections silences alternatives unresolved)
    (intern_node LWCO-EVIDENCE-SET
        (list confirmations corrections silences alternatives unresolved)))
(defn lwco-evidence-set? (cell) (lwo-category? cell LWCO-EVIDENCE-SET))
(defn lwco-evidence-confirmations (set) (nth (node_children set) 0))
(defn lwco-evidence-corrections (set) (nth (node_children set) 1))
(defn lwco-evidence-silences (set) (nth (node_children set) 2))
(defn lwco-evidence-alternatives (set) (nth (node_children set) 3))
(defn lwco-evidence-unresolved (set) (nth (node_children set) 4))
(defn lwco-empty-evidence-set ()
    (lwco-evidence-set
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field)))

(defn lwco-classify (evidence set)
    (do
        (let observation (lwco-evidence-observation evidence))
        (let ack (lwco-observation-ack observation))
        (if (eq (oac-one? ack) 1)
            (lwco-evidence-set
                (lwo-field-add (lwco-evidence-confirmations set) evidence)
                (lwco-evidence-corrections set)
                (lwco-evidence-silences set)
                (lwco-evidence-alternatives set)
                (lwco-evidence-unresolved set))
            (if (eq (oac-zero? ack) 1)
                (lwco-evidence-set
                    (lwco-evidence-confirmations set)
                    (lwo-field-add (lwco-evidence-corrections set) evidence)
                    (lwco-evidence-silences set)
                    (lwco-evidence-alternatives set)
                    (lwco-evidence-unresolved set))
                (if (eq (oac-nothing? ack) 1)
                    (lwco-evidence-set
                        (lwco-evidence-confirmations set)
                        (lwco-evidence-corrections set)
                        (lwo-field-add
                            (lwco-evidence-silences set) evidence)
                        (lwco-evidence-alternatives set)
                        (lwco-evidence-unresolved set))
                    (if (and (eq (oac-node? ack) 1)
                             (eq (oac-alternative?
                                   (oac-payload ack)) 1))
                        (lwco-evidence-set
                            (lwco-evidence-confirmations set)
                            (lwco-evidence-corrections set)
                            (lwco-evidence-silences set)
                            (lwo-field-add
                                (lwco-evidence-alternatives set) evidence)
                            (lwco-evidence-unresolved set))
                        (lwco-evidence-set
                            (lwco-evidence-confirmations set)
                            (lwco-evidence-corrections set)
                            (lwco-evidence-silences set)
                            (lwco-evidence-alternatives set)
                            (lwo-field-add
                                (lwco-evidence-unresolved set) evidence))))))))

(defn lwco-collect-items (world items bundle set)
    (if (eq (len items) 0) set
        (do
            (let observation (head items))
            (if (and (eq (lwco-observation-valid? observation) 1)
                     (and (eq (lwo-active? world observation) 1)
                          (node_eq (lwco-observation-bundle observation)
                                   bundle)))
                (lwco-collect-items world (tail items) bundle
                    (lwco-classify
                        (lwco-evidence observation
                            (lwo-active-attributions-for world observation))
                        set))
                (lwco-collect-items world (tail items) bundle set)))))
(defn lwco-evidence-for (world bundle)
    (lwco-collect-items world
        (lwo-field-items (lwo-world-cells world)) bundle
        (lwco-empty-evidence-set)))

(defn lwco-field-attribution-count-items (items count)
    (if (eq (len items) 0) count
        (lwco-field-attribution-count-items (tail items)
            (add count
                (lwo-field-size
                    (lwco-evidence-attributions (head items)))))))
(defn lwco-field-attribution-count (field)
    (lwco-field-attribution-count-items (lwo-field-items field) 0))
(defn lwco-confirmation-count (set)
    (lwco-field-attribution-count (lwco-evidence-confirmations set)))
(defn lwco-correction-count (set)
    (lwco-field-attribution-count (lwco-evidence-corrections set)))
(defn lwco-silence-count (set)
    (lwco-field-attribution-count (lwco-evidence-silences set)))
(defn lwco-alternative-count (set)
    (lwco-field-attribution-count (lwco-evidence-alternatives set)))
(defn lwco-unresolved-count (set)
    (lwco-field-attribution-count (lwco-evidence-unresolved set)))

(defn lwco-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwco-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwco-witnesses-from-evidence-items (items witnesses)
    (if (eq (len items) 0) witnesses
        (lwco-witnesses-from-evidence-items (tail items)
            (lwco-field-union-items
                (lwo-field-items
                    (lwco-evidence-attributions (head items))) witnesses))))
(defn lwco-witnesses (bundle set)
    (do
        (let confirmations
            (lwco-witnesses-from-evidence-items
                (lwo-field-items (lwco-evidence-confirmations set))
                (lwmp-bundle-witnesses bundle)))
        (let corrections
            (lwco-witnesses-from-evidence-items
                (lwo-field-items (lwco-evidence-corrections set))
                confirmations))
        (let silences
            (lwco-witnesses-from-evidence-items
                (lwo-field-items (lwco-evidence-silences set)) corrections))
        (let alternatives
            (lwco-witnesses-from-evidence-items
                (lwo-field-items (lwco-evidence-alternatives set)) silences))
        (lwco-witnesses-from-evidence-items
            (lwo-field-items (lwco-evidence-unresolved set)) alternatives)))

(defn lwco-state-for (set)
    (do
        (let contention
            (add (lwco-correction-count set)
                (add (lwco-alternative-count set)
                     (lwco-unresolved-count set))))
        (if (gt contention 0) (lwco-contested)
            (if (gt (lwco-confirmation-count set) 0)
                (lwco-confirmed) (lwco-unobserved)))))
(defn lwco-alternatives-for (set)
    (do
        (let corrections
            (lwco-field-union-items
                (lwo-field-items (lwco-evidence-corrections set))
                (lwo-empty-field)))
        (let alternatives
            (lwco-field-union-items
                (lwo-field-items (lwco-evidence-alternatives set))
                corrections))
        (lwco-field-union-items
            (lwo-field-items (lwco-evidence-unresolved set)) alternatives)))
(defn lwco-unknown-for (set state)
    (if (or (eq (lwco-unobserved? state) 1)
            (eq (lwco-contested? state) 1))
        (lwlc-unknown set) (lwo-none)))

; children: current bundle, exact primary sequence, outcome evidence set,
;           state, alternatives, optional unknown, witnesses, local path
(defn lwco-composition-cell
    (bundle sequence set state alternatives unknown witnesses)
    (intern_node LWCO-COMPOSITION
        (list bundle sequence set state alternatives unknown witnesses
              (lwo-local-path))))
(defn lwco-composition? (cell) (lwo-category? cell LWCO-COMPOSITION))
(defn lwco-composition-bundle (composition) (nth (node_children composition) 0))
(defn lwco-composition-sequence (composition) (nth (node_children composition) 1))
(defn lwco-composition-evidence (composition) (nth (node_children composition) 2))
(defn lwco-composition-state (composition) (nth (node_children composition) 3))
(defn lwco-composition-alternatives (composition) (nth (node_children composition) 4))
(defn lwco-composition-unknown (composition) (nth (node_children composition) 5))
(defn lwco-composition-witnesses (composition) (nth (node_children composition) 6))
(defn lwco-composition-path (composition) (nth (node_children composition) 7))

(defn lwco-composition-for (world bundle)
    (if (or (eq (lwmp-bundle-current? world bundle) 0)
            (eq (lwmp-bundle-aligned? bundle) 0))
        (lwo-none)
        (do
            (let set (lwco-evidence-for world bundle))
            (let state (lwco-state-for set))
            (lwco-composition-cell bundle
                (lwmp-bundle-primary-sequence bundle) set state
                (lwco-alternatives-for set)
                (lwco-unknown-for set state)
                (lwco-witnesses bundle set)))))

(defn lwco-composition-current? (world composition)
    (if (eq (lwco-composition? composition) 0) 0
        (if (node_eq composition
                (lwco-composition-for world
                    (lwco-composition-bundle composition))) 1 0)))

(defn lwco-origin (composition)
    (intern_node LWCO-ORIGIN (list composition (lwo-local-path))))
(defn lwco-proposal-for (world bundle)
    (do
        (let composition (lwco-composition-for world bundle))
        (if (node_eq composition (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwco-composition-witnesses composition))
                (let count (lwo-field-size witnesses))
                (let origin (lwco-origin composition))
                (let candidate
                    (lwo-emergent composition witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwco-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwco-composition?
                   (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwco-candidate-current? (world candidate)
    (if (eq (lwco-candidate? candidate) 0) 0
        (do
            (let composition (lwo-emergent-shape candidate))
            (let current (lwco-composition-for world
                            (lwco-composition-bundle composition)))
            (if (and (node_eq composition current)
                     (and (node_eq (lwo-emergent-witnesses candidate)
                                   (lwco-composition-witnesses current))
                          (eq (lwo-field-size
                                (lwco-composition-witnesses current))
                              (lwo-emergent-coherence candidate)))) 1 0))))
(defn lwco-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwco-candidate-current? world candidate) 1)) 1 0))

(defn lwco-integrate (round proposal action)
    (if (eq (lwco-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
