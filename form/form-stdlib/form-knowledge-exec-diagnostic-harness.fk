; form-knowledge-exec-diagnostic-harness.fk -- executable semantic judge for
; one exact-source-disjoint local reasoning diagnostic.
;
; This cell never reads model prose.  Five supplied recipe values are executed
; through the current offer/ack control body and scored as typed consequences.
; Response shape, provenance, latency and transport remain separate readings.
;
; The harness was frozen before any model candidate was generated.
;
; preludes: form-stdlib/core.fk control/offer-ack-core.fk control/choice-lane-core.fk
;
; Proven by: form-stdlib/tests/form-knowledge-exec-diagnostic-harness-band.fk

(do
    (defn fkedh-bit (ok bit) (if ok bit 0))

    ; Candidate recipes are zero-argument entrypoints.  Helpers remain the
    ; candidate's sovereign choice; only these observed consequences are read.
    (defn fkedh-score (presencef choicef cutf undof timeoutf)
        (do
            (let presence (presencef))
            (let chosen (choicef))
            (let cut (cutf))
            (let undone (undof))
            (let timed (timeoutf))
            (sum (list
                (fkedh-bit (eq (len presence) 3) 1)
                (fkedh-bit (and (nothing? (nth presence 0))
                                (eq (nothing? (nth presence 1)) 0)) 2)
                (fkedh-bit (eq (nth presence 1) 0) 4)
                (fkedh-bit (eq (nth presence 2) 1) 8)
                (fkedh-bit
                    (and (eq (oac-one? chosen) 1)
                         (eq (node_value (oac-payload chosen)) 1)) 16)
                (fkedh-bit
                    (eq (oac-nothing?
                        (oac-cut-receipt-ack cut)) 1) 32)
                (fkedh-bit (eq (oac-cut-receipt-pruned cut) 1) 64)
                (fkedh-bit (eq undone 41) 128)
                (fkedh-bit
                    (and (eq (oac-nothing? (oac-timeout-ack timed)) 1)
                    (and (eq (oac-timeout-budget-left timed) 0)
                    (and (eq (oac-timeout-alts-left timed) 1)
                         (eq (oac-timed-out? timed) 1)))) 256)))))

    (defn fkedh-perfect () 511)
    0)
