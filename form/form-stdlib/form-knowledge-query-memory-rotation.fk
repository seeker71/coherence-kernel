; form-knowledge-query-memory-rotation.fk -- apply one answer-free memory to a
; fresh public presentation state, then keep, undo, cut or retain on timeout.
;
; Query memory is deliberately question-bound.  Rotation therefore means a
; distinct sealed presentation lane for the same challenge, not an invented
; claim of paraphrase generalization.  The persisted memory selects only query
; bytes; the answer remains absent.  A physical local-model observation later
; chooses whether the immutable memory node stays selected or its explicit
; rollback node is restored.
;
; `nothing`, zero generated tokens, one generated token, timeout, cut and undo
; remain different values.  A successful rotation is RAG-assisted and carries
; its supervised origin; it never receives unassisted-heldout or learned-weight
; credit.
;
; preludes: form-stdlib/form-knowledge-query-memory.fk
; preludes: form-stdlib/form-knowledge-public-resident-eval.fk
; preludes: form-stdlib/form-knowledge-query-memory-rotation-token.fk
; Proven by: form-stdlib/tests/form-knowledge-query-memory-rotation-band.fk

import "./form-knowledge-query-memory.fk"
import "./form-knowledge-public-resident-eval.fk"
import "./form-knowledge-query-memory-rotation-token.fk"

(do
    (defn fkqmr-plan-schema () "form-knowledge-query-memory-rotation-plan-v1")
    (defn fkqmr-observation-schema ()
        "form-knowledge-query-memory-rotation-observation-v1")
    (defn fkqmr-choice-schema ()
        "form-knowledge-query-memory-rotation-choice-v1")
    (defn fkqmr-bit? (x) (if (or (eq x 0) (eq x 1)) 1 0))

    ; plan = schema memory-node memory-key rollback-node rollback-key
    ;        original-question-sha trial-id row-id lane family source-path
    ;        source-sha presentation-question-sha query query-sha offer-node
    ;        offer-key rag supervised-origin heldout learned answer-stored
    ;        model-executed local remote
    (defn fkqmr-plan (memory original-question presentation)
        (if (or (eq (fkqm-memory-valid? memory original-question) 0)
                (eq (fkp30-presentation-valid? presentation) 0)) (nothing)
            (do
                (let question (fkp30-presentation-prompt presentation))
                (let fresh-offer (fkap-rag-query-offer
                    (nth memory 5) (nth memory 7) question))
                (let selected (fkqm-select memory original-question))
                (if (or (nothing? fresh-offer)
                    (or (nothing? selected)
                    (or (not (str_eq question original-question))
                    (or (not (str_eq (fkp30-presentation-source presentation)
                                     (nth memory 5)))
                    (or (not (str_eq (nth fresh-offer 5) (nth memory 6)))
                        (not (str_eq selected (nth fresh-offer 3))))))))
                    (nothing)
                    (list (fkqmr-plan-schema)
                        (nth memory 1) (nth memory 2)
                        (fkqm-undo-node memory) (nth memory 14)
                        (nmfe-sha256 original-question)
                        (fkp30-presentation-trial-id presentation)
                        (fkp30-presentation-row-id presentation)
                        (fkp30-presentation-lane presentation)
                        (fkp30-presentation-family presentation)
                        (fkp30-presentation-source presentation)
                        (fkp30-presentation-source-sha presentation)
                        (nmfe-sha256 question) selected
                        (nmfe-sha256 selected) (nth fresh-offer 1)
                        (nth fresh-offer 2) 1 1 0 0 0 0 1 0)))))

    (defn fkqmr-plan-valid? (plan memory original-question presentation)
        (if (or (nothing? plan) (not (eq (len plan) 25))) 0
            (do
                (let rebuilt (fkqmr-plan memory original-question presentation))
                (if (nothing? rebuilt) 0
                    (if (and (str_eq (nth plan 0) (nth rebuilt 0))
                        (and (node_eq (nth plan 1) (nth rebuilt 1))
                        (and (str_eq (nth plan 2) (nth rebuilt 2))
                        (and (node_eq (nth plan 3) (nth rebuilt 3))
                        (and (str_eq (nth plan 4) (nth rebuilt 4))
                        (and (str_eq (nth plan 5) (nth rebuilt 5))
                        (and (str_eq (nth plan 6) (nth rebuilt 6))
                        (and (str_eq (nth plan 7) (nth rebuilt 7))
                        (and (str_eq (nth plan 8) (nth rebuilt 8))
                        (and (str_eq (nth plan 9) (nth rebuilt 9))
                        (and (str_eq (nth plan 10) (nth rebuilt 10))
                        (and (str_eq (nth plan 11) (nth rebuilt 11))
                        (and (str_eq (nth plan 12) (nth rebuilt 12))
                        (and (str_eq (nth plan 13) (nth rebuilt 13))
                        (and (str_eq (nth plan 14) (nth rebuilt 14))
                        (and (node_eq (nth plan 15) (nth rebuilt 15))
                        (and (str_eq (nth plan 16) (nth rebuilt 16))
                        (and (eq (nth plan 17) 1)
                        (and (eq (nth plan 18) 1)
                        (and (eq (nth plan 19) 0)
                        (and (eq (nth plan 20) 0)
                        (and (eq (nth plan 21) 0)
                        (and (eq (nth plan 22) 0)
                        (and (eq (nth plan 23) 1)
                             (eq (nth plan 24) 0))))))))))))))))))))))))) 1 0)))))

    (defn fkqmr-recipe (plan) (fkqmrt-recipe plan))
    (defn fkqmr-recipe-valid? (recipe plan)
        (fkqmrt-recipe-valid? recipe plan))
    (defn fkqmr-request-token (plan) (fkqmrt-request-token plan))
    (defn fkqmr-request-valid? (request plan)
        (fkqmrt-request-valid? request plan))

    ; observation = schema plan transport promotion generated hits misses
    ;               nothings timeout frame-refusals state-release
    ;               residence-release answer-stored local remote
    (defn fkqmr-observation
        (plan transport promotion generated hits misses nothings timeout
         frame-refusals state-release residence-release)
        (if (or (nothing? plan)
                (or (eq (fkqmr-bit? transport) 0)
                (or (lt promotion 0)
                (or (gt promotion 1000000)
                (or (lt generated 0)
                (or (lt hits 0)
                (or (lt misses 0)
                (or (lt nothings 0)
                (or (eq (fkqmr-bit? timeout) 0)
                (or (lt frame-refusals 0)
                (or (eq (fkqmr-bit? state-release) 0)
                    (eq (fkqmr-bit? residence-release) 0))))))))))))
            (nothing)
            (list (fkqmr-observation-schema) plan transport promotion
                  generated hits misses nothings timeout frame-refusals
                  state-release residence-release 0 1 0)))
    (defn fkqmr-observation-valid? (o)
        (if (or (nothing? o) (not (eq (len o) 15))) 0
            (if (and (str_eq (nth o 0) (fkqmr-observation-schema))
                (and (not (nothing? (nth o 1)))
                (and (eq (fkqmr-bit? (nth o 2)) 1)
                (and (and (ge (nth o 3) 0) (le (nth o 3) 1000000))
                (and (ge (nth o 4) 0)
                (and (ge (nth o 5) 0)
                (and (ge (nth o 6) 0)
                (and (ge (nth o 7) 0)
                (and (eq (fkqmr-bit? (nth o 8)) 1)
                (and (ge (nth o 9) 0)
                (and (eq (fkqmr-bit? (nth o 10)) 1)
                (and (eq (fkqmr-bit? (nth o 11)) 1)
                (and (eq (nth o 12) 0)
                (and (eq (nth o 13) 1)
                     (eq (nth o 14) 0))))))))))))))) 1 0)))

    (defn fkqmr-signal (o)
        (if (eq (fkqmr-observation-valid? o) 0) (nothing)
            (if (eq (nth o 8) 1) "timeout"
                (if (or (eq (nth o 10) 0) (eq (nth o 11) 0)) "cut"
                    (if (or (eq (nth o 2) 0)
                        (or (eq (nth o 4) 0)
                        (or (eq (nth o 5) 0)
                        (or (gt (nth o 6) 0)
                        (or (gt (nth o 7) 0)
                            (gt (nth o 9) 0)))))) "undo"
                        (if (ge (nth o 3) 950000) "keep" "undo"))))))
    (defn fkqmr-choice (o)
        (do
            (let signal (fkqmr-signal o))
            (if (nothing? signal) (nothing)
                (do
                    (let plan (nth o 1))
                    (let next-node (if (str_eq signal "undo")
                        (nth plan 3) (nth plan 1)))
                    (list (fkqmr-choice-schema) signal next-node
                          (nth plan 2) (nth plan 4))))))
    (defn fkqmr-choice-signal (choice)
        (if (nothing? choice) (nothing) (nth choice 1)))
    (defn fkqmr-choice-node (choice)
        (if (nothing? choice) (nothing) (nth choice 2)))

    ; The carrier returns another content-addressed node.  Presence is stored
    ; independently from generated=0/1, so neither becomes absence.  A real
    ; `nothing` observation still returns Form nothing and never mints a token.
    (defn fkqmr-choice-token (observation)
        (do
            (let choice (fkqmr-choice observation))
            (if (nothing? choice) (nothing)
                (fkqmrt-choice-token
                    (nth observation 1)
                    (fkqmr-choice-signal choice)
                    (fkqmr-choice-node choice)
                    (nth observation 4) 1 (nth observation 8)
                    (nth observation 10) (nth observation 11)))))
    (defn fkqmr-choice-token-signal (token)
        (fkqmrt-choice-token-signal token))
    (defn fkqmr-choice-token-node (token)
        (fkqmrt-choice-token-node token))
    (defn fkqmr-choice-token-generated (token)
        (fkqmrt-choice-token-generated token))
    (defn fkqmr-choice-token-present? (token)
        (fkqmrt-choice-token-present? token))
    0)
