//////////////////////////////////////////////////////////////////////
//
// lane-counsel.bml
//
// Executable BML. The LANE COUNSEL: measure, observe, improve — for
// any agent. One reading takes the same sample the glass paints,
// judges each performance lane through the engine's one threshold
// scale (thresholds are rows of DATA, each carrying the named stone
// that improves it), orders the report worst-first, and diffs every
// judged value against the previous reading so improvement itself is
// measured. Lower is better for every judged lane; a lane inside its
// good range needs no advice and gets none.
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormLaneCounsel {
        thought lane-counsel-pattern = list("advice-is-data", "worst-first", "stone-named", "delta-vs-last-reading", "lower-is-better");

        def lc-row(name, lo, hi, stone) = list(name, lo, hi, stone);
        def lc-advice() = list(lc-row("lastms", hearth-lat-lo(), hearth-lat-hi() * 6, "serve time: fold the armed-by-absence prompt prefix into the preload; measure prefill share vs decode share"), lc-row("tpot", 800, 2000, "decode pace: crystallize the hot decode recipes through the heat gate; check metal is carrying the model"), lc-row("p95", 20000, 45000, "tail latency: shorter asks, per-turn context recycling in the turnwheel (crowdfade)"), lc-row("kvpct", hearth-fill-lo(), hearth-fill-hi(), "context pressure: per-turn context recycling in the turnwheel before the crowdfade thins answers"), lc-row("hopper", 1, 3, "queue pressure: more sender processes ride the drain law; heal ringlock so one process can burst"), lc-row("icemiss", 1, 3, "missing or invalidated specializations: request cells on demand; repair freshness before recomputing"), lc-row("fails", 1, 2, "typed errors in replies: read the ledger and the failing turn's frame"), lc-row("touts", 1, 2, "decode timeouts: read heed telemetry for the timed-out walk"), lc-row("admit", 60000, 240000, "admission cost: span-batched prefill at open (fcmg-live-prefill-span); a per-token walk pays minutes"), lc-row("errs", 1, 7, "diagnostics in the birth log: read server.out carets; a degraded birth steps down by canary"), lc-row("degraded", 1, 2, "a birth stepped down voiceless: fix the unit the canary named, rebirth"), lc-row("orphans", 1, 2, "stray peers beyond the board: end the fkwu CHILD (never the wrapper), witness first"));

        def lc-hearth-absent?(s) = (String) gl-word-field(s, "alive") == "0";
        def lc-hearth-required?(name) = (String) name == "orphans" ? 0 : 1;
        def lc-observed?(s, name) = ((Comparable) lc-hearth-required?(name) == 1) && ((Comparable) lc-hearth-absent?(s) == 1) ? 0 : (String) name == "kvpct" ? (!((String) gl-word-field(s, "kvpos") == "")) : (String) gl-word-field(s, name) == "nothing" ? 0 : (!((String) gl-word-field(s, name) == ""));
        def lc-val(s, name) = !lc-observed?(s, name) ? nothing() : (String) name == "kvpct" ? ((fmv-field(s, "kvpos") * 100) / hearth-maxpos()) : fmv-field(s, name);
        def lc-verdict(s, row) {
            let value = lc-val(s, row[0]);
            nothing?(value) ? "dim" : tg-scale(value, row[1], row[2]);
        }
        def lc-delta(cur, prev) = cur < prev ? "improving" : cur > prev ? "worsening" : "steady";
        def lc-delta-of(s, p, name) {
            let current = lc-val(s, name);
            let previous = lc-val(p, name);
            nothing?(current) ? "unobserved" : (Comparable) str_len(p) == 0 ? "first-reading" : nothing?(previous) ? "unobserved" : lc-delta(current, previous);
        }
        def lc-stone(tone, stone) = ((String) tone == "good") || ((String) tone == "dim") ? "" : "  -> " ++ stone;
        def lc-missing-reason(s, name) = ((Comparable) lc-hearth-required?(name) == 1) && ((Comparable) lc-hearth-absent?(s) == 1) ? "no-standing-hearth" : "no-sample";
        def lc-display(s, name, value) = nothing?(value) ? "? " ++ lc-missing-reason(s, name) : int_to_str(value);
        def lc-line(s, p, row) = lc-line-of(row[0], lc-verdict(s, row), lc-display(s, row[0], lc-val(s, row[0])), lc-delta-of(s, p, row[0]), row[3]);
        def lc-line-of(name, tone, display, delta, stone) = tg-span(tone, name ++ " " ++ display) ++ "  " ++ tg-span("dim", delta) ++ lc-stone(tone, stone) ++ tg-nl();
        // walks ride the generic table engine: the verdict predicate
        // carries (sample, want) as one list argument.
        def lc-verdict-is?(row, sw) = (String) lc-verdict(sw[0], row) == sw[1] ? 1 : 0;
        def lc-line3(acc, row, spw) = acc ++ lc-line(spw[0], spw[1], row);
        def lc-walk(s, p, rows, want, acc) = tb-fold3(tb-filter2(rows, lc-verdict-is?, list(s, want)), lc-line3, list(s, p), acc);
        def lc-worst-tone(s) = (Comparable) tb-any2?(lc-advice(), lc-verdict-is?, list(s, "bad")) == 1 ? "bad" : (Comparable) tb-any2?(lc-advice(), lc-verdict-is?, list(s, "warn")) == 1 ? "warn" : "good";
        def lc-first-stone(s, want) = lc-stone-of(tb-find2(lc-advice(), lc-verdict-is?, list(s, want)));
        def lc-stone-of(row) = (Comparable) len(row) == 0 ? "" : row[3];
        def lc-observed-count-go(s, rows, count) = (Comparable) len(rows) == 0 ? count : lc-observed-count-go(s, tail(rows), count + lc-observed?(s, head(rows)[0]));
        def lc-observed-count(s) = lc-observed-count-go(s, lc-advice(), 0);
        def lc-unobserved-count(s) = len(lc-advice()) - lc-observed-count(s);
        def lc-unobserved-improve(s) = int_to_str(lc-unobserved-count(s)) ++ "/" ++ int_to_str(len(lc-advice())) ++ " judged lanes unobserved - no all-good verdict";
        def lc-improve(s) = !((String) lc-worst-tone(s) == "good") ? lc-first-stone(s, lc-worst-tone(s)) : lc-unobserved-count(s) > 0 ? lc-unobserved-improve(s) : "all judged lanes good - improve by adding the next judged lane";
        def lc-report(s, p) = tg-span("dim", "counsel - worst first" ++ tg-nl()) ++ lc-walk(s, p, lc-advice(), "bad", "") ++ lc-walk(s, p, lc-advice(), "warn", "") ++ lc-walk(s, p, lc-advice(), "good", "") ++ lc-walk(s, p, lc-advice(), "dim", "") ++ "improve: " ++ lc-improve(s) ++ tg-nl();
    }
    0;
}
