//////////////////////////////////////////////////////////////////////
//
// lane-counsel.bml
//
// Executable BML. The LANE COUNSEL: measure, observe, improve — for
// any agent. One reading takes the same sample the glass paints,
// judges each performance lane through the engine's one threshold
// scale (thresholds are rows of DATA, each carrying the named stone
// that improves it), orders the report worst-first, and diffs every
// judged value against the previous reading so improvement itself is
// measured. Lower is better for every judged lane; a lane inside its
// good range needs no advice and gets none.
//
// preludes: form-stdlib/core.fk form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml
//
// Proven by: form-stdlib/tests/lane-counsel-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormLaneCounsel {
        thought lane-counsel-pattern = list("advice-is-data", "worst-first", "stone-named", "delta-vs-last-reading", "lower-is-better");

        def lc-row(name, lo, hi, stone) = list(name, lo, hi, stone);
        def lc-advice() = list(lc-row("lastms", hearth-lat-lo(), mul(hearth-lat-hi(), 6), "serve time: fold the armed-by-absence prompt prefix into the preload; measure prefill share vs decode share"), lc-row("tpot", 800, 2000, "decode pace: crystallize the hot decode recipes through the heat gate; check metal is carrying the model"), lc-row("p95", 20000, 45000, "tail latency: shorter asks, per-turn context recycling in the turnwheel (crowdfade)"), lc-row("kvpct", hearth-fill-lo(), hearth-fill-hi(), "context pressure: per-turn context recycling in the turnwheel before the crowdfade thins answers"), lc-row("hopper", 1, 3, "queue pressure: more sender processes ride the drain law; heal ringlock so one process can burst"), lc-row("icemiss", 1, 3, "cold ices: run the cells once to refreeze; clear only what a healed surface invalidates"), lc-row("fails", 1, 2, "typed errors in replies: read the ledger and the failing turn's frame"), lc-row("touts", 1, 2, "decode timeouts: read heed telemetry for the timed-out walk"), lc-row("admit", 60000, 240000, "admission cost: span-batched prefill at open (fcmg-live-prefill-span); a per-token walk pays minutes"));

        def lc-observed?(s, name) = if str_eq(name, "kvpct") then not(str_eq(gl-word-field(s, "kvpos"), "")) else if str_eq(gl-word-field(s, name), "nothing") then 0 else not(str_eq(gl-word-field(s, name), ""));
        def lc-val(s, name) = if not(lc-observed?(s, name)) then nothing() else if str_eq(name, "kvpct") then div(mul(fmv-field(s, "kvpos"), 100), hearth-maxpos()) else fmv-field(s, name);
        def lc-verdict(s, row) {
            let value = lc-val(s, nth(row, 0));
            if nothing?(value) then "dim" else tg-scale(value, nth(row, 1), nth(row, 2));
        }
        def lc-delta(cur, prev) = if lt(cur, prev) then "improving" else if gt(cur, prev) then "worsening" else "steady";
        def lc-delta-of(s, p, name) {
            let current = lc-val(s, name);
            let previous = lc-val(p, name);
            if nothing?(current) then "unobserved" else if eq(str_len(p), 0) then "first-reading" else if nothing?(previous) then "unobserved" else lc-delta(current, previous);
        }
        def lc-stone(tone, stone) = if or(str_eq(tone, "good"), str_eq(tone, "dim")) then "" else str_concat("  -> ", stone);
        def lc-display(value) = if nothing?(value) then "nothing" else int_to_str(value);
        def lc-line(s, p, row) = lc-line-of(nth(row, 0), lc-verdict(s, row), lc-val(s, nth(row, 0)), lc-delta-of(s, p, nth(row, 0)), nth(row, 3));
        def lc-line-of(name, tone, v, delta, stone) = str_concat(tg-span(tone, str_concat(name, str_concat(" ", lc-display(v)))), str_concat("  ", str_concat(tg-span("dim", delta), str_concat(lc-stone(tone, stone), tg-nl()))));
        def lc-walk(s, p, rows, want, acc) = if eq(len(rows), 0) then acc else lc-walk(s, p, tail(rows), want, if str_eq(lc-verdict(s, head(rows)), want) then str_concat(acc, lc-line(s, p, head(rows))) else acc);
        def lc-worst-tone(s) = if gt(str_len(lc-walk(s, "", lc-advice(), "bad", "")), 0) then "bad" else if gt(str_len(lc-walk(s, "", lc-advice(), "warn", "")), 0) then "warn" else "good";
        def lc-first-stone-go(s, rows, want) = if eq(len(rows), 0) then "" else if str_eq(lc-verdict(s, head(rows)), want) then nth(head(rows), 3) else lc-first-stone-go(s, tail(rows), want);
        def lc-improve(s) = if str_eq(lc-worst-tone(s), "good") then "all judged lanes good - improve by adding the next judged lane" else lc-first-stone-go(s, lc-advice(), lc-worst-tone(s));
        def lc-report(s, p) = str_concat(tg-span("dim", str_concat("counsel - worst first", tg-nl())), str_concat(lc-walk(s, p, lc-advice(), "bad", ""), str_concat(lc-walk(s, p, lc-advice(), "warn", ""), str_concat(lc-walk(s, p, lc-advice(), "good", ""), str_concat(lc-walk(s, p, lc-advice(), "dim", ""), str_concat("improve: ", str_concat(lc-improve(s), tg-nl())))))));
    }
    0;
}
