//////////////////////////////////////////////////////////////////////
//
// lane-counsel.bml
//
// Executable BML. The LANE COUNSEL: measure, observe, improve — for
// any agent. One reading takes the same sample the glass paints,
// judges each performance lane through the engine's one threshold
// scale (thresholds are rows of DATA, each carrying the named stone
// that improves it), orders the report worst-first, and diffs every
// judged value against the previous reading so improvement itself is
// measured. Lower is better for every judged lane; a lane inside its
// good range needs no advice and gets none.
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/lane-motion.bml
//
// Proven by: form-stdlib/tests/lane-counsel-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormLaneCounsel {
        thought lane-counsel-pattern = list("advice-is-data", "worst-first", "stone-named", "delta-vs-last-reading", "lower-is-better");

        def lc-row(name, lo, hi, stone) = list(name, lo, hi, stone);
        def lc-advice() = list(lc-row("lastms", hearth-lat-lo(), mul(hearth-lat-hi(), 6), "serve time: fold the armed-by-absence prompt prefix into the preload; measure prefill share vs decode share"), lc-row("tpot", 800, 2000, "decode pace: crystallize the hot decode recipes through the heat gate; check metal is carrying the model"), lc-row("p95", 20000, 45000, "tail latency: shorter asks, per-turn context recycling in the turnwheel (crowdfade)"), lc-row("kvpct", hearth-fill-lo(), hearth-fill-hi(), "context pressure: per-turn context recycling in the turnwheel before the crowdfade thins answers"), lc-row("hopper", 1, 3, "queue pressure: more sender processes ride the drain law; heal ringlock so one process can burst"), lc-row("icemiss", 1, 3, "missing or invalidated specializations: request cells on demand; repair freshness before recomputing"), lc-row("fails", 1, 2, "typed errors in replies: read the ledger and the failing turn's frame"), lc-row("touts", 1, 2, "decode timeouts: read heed telemetry for the timed-out walk"), lc-row("admit", 60000, 240000, "admission cost: span-batched prefill at open (fcmg-live-prefill-span); a per-token walk pays minutes"), lc-row("errs", 1, 7, "diagnostics in the birth log: read server.out carets; a degraded birth steps down by canary"), lc-row("degraded", 1, 2, "a birth stepped down voiceless: fix the unit the canary named, rebirth"), lc-row("orphans", 1, 2, "stray peers beyond the board: end the fkwu CHILD (never the wrapper), witness first"));

        def lc-hearth-absent?(s) = str_eq(gl-word-field(s, "alive"), "0");
        def lc-hearth-required?(name) = if str_eq(name, "orphans") then 0 else 1;
        def lc-observed?(s, name) = if and(eq(lc-hearth-required?(name), 1), eq(lc-hearth-absent?(s), 1)) then 0 else if str_eq(name, "kvpct") then not(str_eq(gl-word-field(s, "kvpos"), "")) else if str_eq(gl-word-field(s, name), "nothing") then 0 else not(str_eq(gl-word-field(s, name), ""));
        def lc-val(s, name) = if not(lc-observed?(s, name)) then nothing() else if str_eq(name, "kvpct") then div(mul(fmv-field(s, "kvpos"), 100), hearth-maxpos()) else fmv-field(s, name);
        def lc-verdict(s, row) {
            let value = lc-val(s, nth(row, 0));
            if nothing?(value) then "dim" else tg-scale(value, nth(row, 1), nth(row, 2));
        }
        def lc-delta(cur, prev) = if lt(cur, prev) then "improving" else if gt(cur, prev) then "worsening" else "steady";
        def lc-delta-of(s, p, name) {
            let current = lc-val(s, name);
            let previous = lc-val(p, name);
            if nothing?(current) then "unobserved" else if eq(str_len(p), 0) then "first-reading" else if nothing?(previous) then "unobserved" else lc-delta(current, previous);
        }
        def lc-stone(tone, stone) = if or(str_eq(tone, "good"), str_eq(tone, "dim")) then "" else str_concat("  -> ", stone);
        def lc-missing-reason(s, name) = if and(eq(lc-hearth-required?(name), 1), eq(lc-hearth-absent?(s), 1)) then "no-standing-hearth" else "no-sample";
        def lc-display(s, name, value) = if nothing?(value) then str_concat("? ", lc-missing-reason(s, name)) else int_to_str(value);
        def lc-line(s, p, row) = lc-line-of(nth(row, 0), lc-verdict(s, row), lc-display(s, nth(row, 0), lc-val(s, nth(row, 0))), lc-delta-of(s, p, nth(row, 0)), nth(row, 3));
        def lc-line-of(name, tone, display, delta, stone) = str_concat(tg-span(tone, str_concat(name, str_concat(" ", display))), str_concat("  ", str_concat(tg-span("dim", delta), str_concat(lc-stone(tone, stone), tg-nl()))));
        // walks ride the generic table engine: the verdict predicate
        // carries (sample, want) as one list argument.
        def lc-verdict-is?(row, sw) = if str_eq(lc-verdict(nth(sw, 0), row), nth(sw, 1)) then 1 else 0;
        def lc-line3(acc, row, spw) = str_concat(acc, lc-line(nth(spw, 0), nth(spw, 1), row));
        def lc-walk(s, p, rows, want, acc) = tb-fold3(tb-filter2(rows, lc-verdict-is?, list(s, want)), lc-line3, list(s, p), acc);
        def lc-worst-tone(s) = if eq(tb-any2?(lc-advice(), lc-verdict-is?, list(s, "bad")), 1) then "bad" else if eq(tb-any2?(lc-advice(), lc-verdict-is?, list(s, "warn")), 1) then "warn" else "good";
        def lc-first-stone(s, want) = lc-stone-of(tb-find2(lc-advice(), lc-verdict-is?, list(s, want)));
        def lc-stone-of(row) = if eq(len(row), 0) then "" else nth(row, 3);
        def lc-observed-count-go(s, rows, count) = if eq(len(rows), 0) then count else lc-observed-count-go(s, tail(rows), add(count, lc-observed?(s, nth(head(rows), 0))));
        def lc-observed-count(s) = lc-observed-count-go(s, lc-advice(), 0);
        def lc-unobserved-count(s) = sub(len(lc-advice()), lc-observed-count(s));
        def lc-unobserved-improve(s) = str_concat(int_to_str(lc-unobserved-count(s)), str_concat("/", str_concat(int_to_str(len(lc-advice())), " judged lanes unobserved - no all-good verdict")));
        def lc-improve(s) = if not(str_eq(lc-worst-tone(s), "good")) then lc-first-stone(s, lc-worst-tone(s)) else if gt(lc-unobserved-count(s), 0) then lc-unobserved-improve(s) else "all judged lanes good - improve by adding the next judged lane";
        def lc-report(s, p) = str_concat(tg-span("dim", str_concat("counsel - worst first", tg-nl())), str_concat(lc-walk(s, p, lc-advice(), "bad", ""), str_concat(lc-walk(s, p, lc-advice(), "warn", ""), str_concat(lc-walk(s, p, lc-advice(), "good", ""), str_concat(lc-walk(s, p, lc-advice(), "dim", ""), str_concat("improve: ", str_concat(lc-improve(s), tg-nl())))))));
    }
    0;
}
