; living-world-contextual-species.fk -- behavior may recur across offered views.
;
; This organ receives contextual facets over a shared offered focus. A facet
; points only to an already admitted behavioral species or an exact historical
; native trial, carries an optional current lens declaration, and acknowledges
; the relation with ONE, ZERO, NOTHING, ALTERNATIVE, or another NODE. No domain
; label, representative Recipe, task class, or imported answer is installed.
;
; A behavior kernel removes only the exact target identity from a local trial
; signature; before, after, evaluator, and effect remain. Exact targets,
; Recipes, traces, contexts, alternatives, unknowns, and witnesses remain in
; receipts. Recurrent ONE facets group by this kernel. One group is COHERENT;
; more than one is SPLIT; dissent, alternatives, or unresolved NODEs are
; AMBIGUOUS; insufficient independent recurrence is OPEN. A split is evidence,
; never a winner. Any admitted component has no primary member.
;
; A separately offered question may ask an admitted tissue for its present
; component and complete field. The answer is native NODE composition with an
; exact derivation. No remote oracle or prose generator enters this path.
;
; witnessed: 2026-08-07 -> 3 focused bands return 32767
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk

(let LWCS-KERNEL          (bp "LWCS-KERNEL"))
(let LWCS-FACET           (bp "LWCS-FACET"))
(let LWCS-FACET-EVIDENCE  (bp "LWCS-FACET-EVIDENCE"))
(let LWCS-EVIDENCE-SET    (bp "LWCS-EVIDENCE-SET"))
(let LWCS-COMPONENT       (bp "LWCS-COMPONENT"))
(let LWCS-FIELD           (bp "LWCS-FIELD"))
(let LWCS-COHERENT        (bp "LWCS-COHERENT"))
(let LWCS-SPLIT           (bp "LWCS-SPLIT"))
(let LWCS-AMBIGUOUS       (bp "LWCS-AMBIGUOUS"))
(let LWCS-OPEN            (bp "LWCS-OPEN"))
(let LWCS-TISSUE          (bp "LWCS-TISSUE"))
(let LWCS-ORIGIN          (bp "LWCS-ORIGIN"))
(let LWCS-QUESTION        (bp "LWCS-QUESTION"))
(let LWCS-DERIVATION      (bp "LWCS-DERIVATION"))
(let LWCS-ANSWER          (bp "LWCS-ANSWER"))
(let LWCS-ANSWER-ORIGIN   (bp "LWCS-ANSWER-ORIGIN"))

(defn lwcs-status (kind) (intern_node kind (empty)))
(defn lwcs-coherent () (lwcs-status LWCS-COHERENT))
(defn lwcs-split () (lwcs-status LWCS-SPLIT))
(defn lwcs-ambiguous () (lwcs-status LWCS-AMBIGUOUS))
(defn lwcs-open () (lwcs-status LWCS-OPEN))
(defn lwcs-coherent? (status) (if (node_eq status (lwcs-coherent)) 1 0))
(defn lwcs-split? (status) (if (node_eq status (lwcs-split)) 1 0))
(defn lwcs-ambiguous? (status) (if (node_eq status (lwcs-ambiguous)) 1 0))
(defn lwcs-open? (status) (if (node_eq status (lwcs-open)) 1 0))

; --- behavior kernels ---------------------------------------------------

; The exact target is context retained in each receipt, not erased. It simply
; does not become the cross-context grouping key.
(defn lwcs-kernel (before after evaluator effect)
    (intern_node LWCS-KERNEL
        (list before after evaluator effect (lwo-local-path))))
(defn lwcs-kernel? (cell) (lwo-category? cell LWCS-KERNEL))
(defn lwcs-kernel-before (kernel) (nth (node_children kernel) 0))
(defn lwcs-kernel-after (kernel) (nth (node_children kernel) 1))
(defn lwcs-kernel-evaluator (kernel) (nth (node_children kernel) 2))
(defn lwcs-kernel-effect (kernel) (nth (node_children kernel) 3))
(defn lwcs-kernel-path (kernel) (nth (node_children kernel) 4))
(defn lwcs-kernel-for-signature (signature)
    (lwcs-kernel
        (lwbs-signature-before signature)
        (lwbs-signature-after signature)
        (lwbs-signature-evaluator signature)
        (lwbs-signature-effect signature)))

; --- anchors ------------------------------------------------------------

(defn lwcs-anchor-valid? (anchor)
    (if (or (eq (lwbs-candidate? anchor) 1)
            (eq (lwtn-trial-candidate? anchor) 1)) 1 0))
(defn lwcs-anchor-current? (world anchor)
    (if (eq (lwbs-candidate? anchor) 1)
        (lwbs-integrated-current? world anchor)
        (if (eq (lwtn-trial-candidate? anchor) 1)
            (lwbs-historical-trial-valid? world anchor) 0)))
(defn lwcs-signature-for-anchor (world anchor)
    (if (eq (lwbs-candidate? anchor) 1)
        (do
            (let field (lwo-emergent-shape anchor))
            (let comparison (lwbs-field-comparison field))
            (if (eq (oac-one? comparison) 1)
                (oac-payload comparison) (lwo-none)))
        (do
            (let receipt (lwbs-receipt-for world anchor))
            (if (node_eq receipt (lwo-none)) (lwo-none)
                (lwbs-signature-for receipt)))))
(defn lwcs-kernel-for-anchor (world anchor)
    (do
        (let signature (lwcs-signature-for-anchor world anchor))
        (if (node_eq signature (lwo-none)) (lwo-none)
            (lwcs-kernel-for-signature signature))))
(defn lwcs-anchor-members (anchor)
    (if (eq (lwbs-candidate? anchor) 1)
        (lwbs-field-members (lwo-emergent-shape anchor))
        (lwo-field-add (lwo-empty-field) anchor)))
(defn lwcs-anchor-receipts (world anchor)
    (if (eq (lwbs-candidate? anchor) 1)
        (lwbs-field-receipts (lwo-emergent-shape anchor))
        (do
            (let receipt (lwbs-receipt-for world anchor))
            (if (node_eq receipt (lwo-none)) (lwo-empty-field)
                (lwo-field-add (lwo-empty-field) receipt)))))
(defn lwcs-anchor-alternatives (anchor)
    (if (eq (lwbs-candidate? anchor) 1)
        (lwbs-field-alternative-field (lwo-emergent-shape anchor))
        (lwtn-trial-alternatives (lwo-emergent-shape anchor))))
(defn lwcs-anchor-unknowns (anchor)
    (if (eq (lwbs-candidate? anchor) 1)
        (lwbs-field-unknown-field (lwo-emergent-shape anchor))
        (lwtn-trial-unknowns (lwo-emergent-shape anchor))))

; --- contextual facets -------------------------------------------------

; children: shared focus, exact anchor, optional live declaration, ack,
; alternatives, optional unknowable remainder, evidence, local path
(defn lwcs-facet
    (focus anchor context ack alternatives unknown evidence)
    (intern_node LWCS-FACET
        (list focus anchor context ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwcs-facet? (cell) (lwo-category? cell LWCS-FACET))
(defn lwcs-facet-focus (facet) (nth (node_children facet) 0))
(defn lwcs-facet-anchor (facet) (nth (node_children facet) 1))
(defn lwcs-facet-context (facet) (nth (node_children facet) 2))
(defn lwcs-facet-ack (facet) (nth (node_children facet) 3))
(defn lwcs-facet-alternatives (facet) (nth (node_children facet) 4))
(defn lwcs-facet-unknown (facet) (nth (node_children facet) 5))
(defn lwcs-facet-offered-evidence (facet) (nth (node_children facet) 6))
(defn lwcs-facet-path (facet) (nth (node_children facet) 7))
(defn lwcs-facet-ack-valid? (facet)
    (do
        (let ack (lwcs-facet-ack facet))
        (let anchor (lwcs-facet-anchor facet))
        (if (eq (oac-one? ack) 1)
            (node_eq (oac-payload ack) anchor)
            (if (eq (oac-alternative-ack? ack) 1)
                (node_eq
                    (oac-alternative-reference (oac-payload ack)) anchor)
                (if (or (eq (oac-zero? ack) 1)
                        (or (eq (oac-nothing? ack) 1)
                            (eq (oac-node? ack) 1))) 1 0)))))
(defn lwcs-facet-valid? (facet)
    (if (eq (lwcs-facet? facet) 0) 0
        (do
            (let context (lwcs-facet-context facet))
            (if (and (eq (lwcs-anchor-valid?
                             (lwcs-facet-anchor facet)) 1)
                     (and (or (node_eq context (lwo-none))
                              (eq (lwlc-declaration-valid? context) 1))
                          (and (eq (oac-valid-ack?
                                      (lwcs-facet-ack facet)) 1)
                               (and (eq (lwcs-facet-ack-valid? facet) 1)
                                    (and (eq (lwo-category?
                                              (lwcs-facet-alternatives facet)
                                              LWO-FIELD) 1)
                                         (eq (lwac-optional-unknown-valid?
                                              (lwcs-facet-unknown facet))
                                             1)))))) 1 0))))
(defn lwcs-focus-current? (world focus)
    (if (node_eq focus (lwo-none)) 1
        (lwo-active? world focus)))
(defn lwcs-context-current? (world context)
    (if (node_eq context (lwo-none)) 1
        (lwlc-declaration-current? world context)))
(defn lwcs-facet-current? (world facet focus)
    (if (and (eq (lwcs-facet-valid? facet) 1)
             (and (node_eq (lwcs-facet-focus facet) focus)
                  (and (eq (lwo-active? world facet) 1)
                       (and (eq (lwcs-focus-current? world focus) 1)
                            (and (eq (lwcs-anchor-current? world
                                      (lwcs-facet-anchor facet)) 1)
                                 (eq (lwcs-context-current? world
                                      (lwcs-facet-context facet)) 1)))))) 1 0))

(defn lwcs-independent-attributions-items
    (world items anchor field)
    (if (eq (len items) 0) field
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (lwcs-independent-attributions-items world (tail items) anchor
                (if (eq (lwo-active-by? world anchor source) 1) field
                    (lwo-field-add field attribution))))))
(defn lwcs-independent-attributions (world facet)
    (lwcs-independent-attributions-items world
        (lwo-field-items
            (lwo-active-attributions-for world facet))
        (lwcs-facet-anchor facet) (lwo-empty-field)))
(defn lwcs-sources-for-attributions (attributions)
    (lwt-sources-from-attributions
        (lwo-field-items attributions) (lwo-empty-field)))

; children: exact facet, independent attributions, distinct sources, kernel,
; exact members, exact receipts
(defn lwcs-facet-evidence
    (facet attributions sources kernel members receipts)
    (intern_node LWCS-FACET-EVIDENCE
        (list facet attributions sources kernel members receipts)))
(defn lwcs-facet-evidence? (cell)
    (lwo-category? cell LWCS-FACET-EVIDENCE))
(defn lwcs-evidence-facet (evidence) (nth (node_children evidence) 0))
(defn lwcs-evidence-attributions (evidence) (nth (node_children evidence) 1))
(defn lwcs-evidence-sources (evidence) (nth (node_children evidence) 2))
(defn lwcs-evidence-kernel (evidence) (nth (node_children evidence) 3))
(defn lwcs-evidence-members (evidence) (nth (node_children evidence) 4))
(defn lwcs-evidence-receipts (evidence) (nth (node_children evidence) 5))
(defn lwcs-evidence-for-facet (world facet)
    (do
        (let attributions (lwcs-independent-attributions world facet))
        (lwcs-facet-evidence facet attributions
            (lwcs-sources-for-attributions attributions)
            (lwcs-kernel-for-anchor world (lwcs-facet-anchor facet))
            (lwcs-anchor-members (lwcs-facet-anchor facet))
            (lwcs-anchor-receipts world (lwcs-facet-anchor facet)))))

; children: supports, dissents, silences, alternatives, unresolved,
; below-threshold provisional evidence
(defn lwcs-evidence-set
    (supports dissents silences alternatives unresolved provisional)
    (intern_node LWCS-EVIDENCE-SET
        (list supports dissents silences alternatives unresolved provisional)))
(defn lwcs-set-supports (set) (nth (node_children set) 0))
(defn lwcs-set-dissents (set) (nth (node_children set) 1))
(defn lwcs-set-silences (set) (nth (node_children set) 2))
(defn lwcs-set-alternatives (set) (nth (node_children set) 3))
(defn lwcs-set-unresolved (set) (nth (node_children set) 4))
(defn lwcs-set-provisional (set) (nth (node_children set) 5))
(defn lwcs-empty-evidence-set ()
    (lwcs-evidence-set
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)))
(defn lwcs-classify-evidence (evidence threshold set)
    (do
        (let source-count
            (lwo-field-size (lwcs-evidence-sources evidence)))
        (if (or (le threshold 0) (lt source-count threshold))
            (lwcs-evidence-set
                (lwcs-set-supports set) (lwcs-set-dissents set)
                (lwcs-set-silences set) (lwcs-set-alternatives set)
                (lwcs-set-unresolved set)
                (lwo-field-add (lwcs-set-provisional set) evidence))
            (do
                (let ack
                    (lwcs-facet-ack (lwcs-evidence-facet evidence)))
                (if (eq (oac-one? ack) 1)
                    (lwcs-evidence-set
                        (lwo-field-add (lwcs-set-supports set) evidence)
                        (lwcs-set-dissents set) (lwcs-set-silences set)
                        (lwcs-set-alternatives set)
                        (lwcs-set-unresolved set)
                        (lwcs-set-provisional set))
                    (if (eq (oac-zero? ack) 1)
                        (lwcs-evidence-set
                            (lwcs-set-supports set)
                            (lwo-field-add
                                (lwcs-set-dissents set) evidence)
                            (lwcs-set-silences set)
                            (lwcs-set-alternatives set)
                            (lwcs-set-unresolved set)
                            (lwcs-set-provisional set))
                        (if (eq (oac-nothing? ack) 1)
                            (lwcs-evidence-set
                                (lwcs-set-supports set)
                                (lwcs-set-dissents set)
                                (lwo-field-add
                                    (lwcs-set-silences set) evidence)
                                (lwcs-set-alternatives set)
                                (lwcs-set-unresolved set)
                                (lwcs-set-provisional set))
                            (if (eq (oac-alternative-ack? ack) 1)
                                (lwcs-evidence-set
                                    (lwcs-set-supports set)
                                    (lwcs-set-dissents set)
                                    (lwcs-set-silences set)
                                    (lwo-field-add
                                        (lwcs-set-alternatives set) evidence)
                                    (lwcs-set-unresolved set)
                                    (lwcs-set-provisional set))
                                (lwcs-evidence-set
                                    (lwcs-set-supports set)
                                    (lwcs-set-dissents set)
                                    (lwcs-set-silences set)
                                    (lwcs-set-alternatives set)
                                    (lwo-field-add
                                        (lwcs-set-unresolved set) evidence)
                                    (lwcs-set-provisional set))))))))))
(defn lwcs-collect-evidence-items
    (world items focus threshold set)
    (if (eq (len items) 0) set
        (do
            (let facet (head items))
            (if (eq (lwcs-facet-current? world facet focus) 1)
                (lwcs-collect-evidence-items world (tail items) focus threshold
                    (lwcs-classify-evidence
                        (lwcs-evidence-for-facet world facet) threshold set))
                (lwcs-collect-evidence-items world (tail items) focus threshold
                    set)))))
(defn lwcs-evidence-for (world focus threshold)
    (lwcs-collect-evidence-items world
        (lwo-field-items (lwo-world-cells world)) focus threshold
        (lwcs-empty-evidence-set)))
(defn lwcs-set-blocker-count (set)
    (add (lwo-field-size (lwcs-set-dissents set))
        (add (lwo-field-size (lwcs-set-alternatives set))
             (lwo-field-size (lwcs-set-unresolved set)))))
(defn lwcs-set-all-items (set)
    (append (lwo-field-items (lwcs-set-supports set))
        (append (lwo-field-items (lwcs-set-dissents set))
            (append (lwo-field-items (lwcs-set-silences set))
                (append (lwo-field-items (lwcs-set-alternatives set))
                    (append (lwo-field-items (lwcs-set-unresolved set))
                        (lwo-field-items (lwcs-set-provisional set))))))))

; --- emergent components ------------------------------------------------

; children: kernel, exact anchors, union members, union receipts, contexts,
; facet evidence, alternatives, unknowns, witnesses, local path
(defn lwcs-component
    (kernel anchors members receipts contexts evidence alternatives unknowns
     witnesses)
    (intern_node LWCS-COMPONENT
        (list kernel anchors members receipts contexts evidence alternatives
              unknowns witnesses (lwo-local-path))))
(defn lwcs-component? (cell) (lwo-category? cell LWCS-COMPONENT))
(defn lwcs-component-kernel (component) (nth (node_children component) 0))
(defn lwcs-component-anchors (component) (nth (node_children component) 1))
(defn lwcs-component-members (component) (nth (node_children component) 2))
(defn lwcs-component-receipts (component) (nth (node_children component) 3))
(defn lwcs-component-contexts (component) (nth (node_children component) 4))
(defn lwcs-component-evidence (component) (nth (node_children component) 5))
(defn lwcs-component-alternatives (component) (nth (node_children component) 6))
(defn lwcs-component-unknowns (component) (nth (node_children component) 7))
(defn lwcs-component-witnesses (component) (nth (node_children component) 8))
(defn lwcs-component-path (component) (nth (node_children component) 9))

(defn lwcs-field-add-optional (field value)
    (if (node_eq value (lwo-none)) field (lwo-field-add field value)))
(defn lwcs-optional-unknown-field (unknown)
    (if (node_eq unknown (lwo-none)) (lwo-empty-field)
        (lwo-field-add (lwo-empty-field) unknown)))
(defn lwcs-context-witnesses (world context)
    (if (node_eq context (lwo-none)) (lwo-empty-field)
        (lwo-active-attributions-for world context)))
(defn lwcs-evidence-witnesses (world evidence)
    (do
        (let facet (lwcs-evidence-facet evidence))
        (let anchor (lwcs-facet-anchor facet))
        (let context (lwcs-facet-context facet))
        (let with-facet
            (lwac-field-union-items
                (lwo-field-items (lwcs-evidence-attributions evidence))
                (lwo-active-attributions-for world anchor)))
        (lwac-field-union-items
            (lwo-field-items (lwcs-context-witnesses world context))
            with-facet)))
(defn lwcs-evidence-alternatives (evidence)
    (do
        (let facet (lwcs-evidence-facet evidence))
        (let anchor (lwcs-facet-anchor facet))
        (let base
            (lwac-field-union-items
                (lwo-field-items (lwcs-facet-alternatives facet))
                (lwcs-anchor-alternatives anchor)))
        (let ack (lwcs-facet-ack facet))
        (if (eq (oac-alternative-ack? ack) 1)
            (lwo-field-add base
                (oac-alternative-offered (oac-payload ack)))
            (if (or (eq (oac-zero? ack) 1)
                    (eq (oac-node? ack) 1))
                (lwo-field-add base evidence) base))))
(defn lwcs-evidence-unknowns (evidence)
    (do
        (let facet (lwcs-evidence-facet evidence))
        (lwac-field-union-items
            (lwo-field-items
                (lwcs-optional-unknown-field
                    (lwcs-facet-unknown facet)))
            (lwcs-anchor-unknowns (lwcs-facet-anchor facet)))))
(defn lwcs-component-from-evidence (world evidence)
    (do
        (let facet (lwcs-evidence-facet evidence))
        (lwcs-component (lwcs-evidence-kernel evidence)
            (lwo-field-add (lwo-empty-field) (lwcs-facet-anchor facet))
            (lwcs-evidence-members evidence)
            (lwcs-evidence-receipts evidence)
            (lwcs-field-add-optional
                (lwo-empty-field) (lwcs-facet-context facet))
            (lwo-field-add (lwo-empty-field) evidence)
            (lwcs-evidence-alternatives evidence)
            (lwcs-evidence-unknowns evidence)
            (lwcs-evidence-witnesses world evidence))))
(defn lwcs-component-add-evidence (world component evidence)
    (do
        (let facet (lwcs-evidence-facet evidence))
        (lwcs-component (lwcs-component-kernel component)
            (lwo-field-add
                (lwcs-component-anchors component)
                (lwcs-facet-anchor facet))
            (lwac-field-union-items
                (lwo-field-items (lwcs-evidence-members evidence))
                (lwcs-component-members component))
            (lwac-field-union-items
                (lwo-field-items (lwcs-evidence-receipts evidence))
                (lwcs-component-receipts component))
            (lwcs-field-add-optional
                (lwcs-component-contexts component)
                (lwcs-facet-context facet))
            (lwo-field-add (lwcs-component-evidence component) evidence)
            (lwac-field-union-items
                (lwo-field-items (lwcs-evidence-alternatives evidence))
                (lwcs-component-alternatives component))
            (lwac-field-union-items
                (lwo-field-items (lwcs-evidence-unknowns evidence))
                (lwcs-component-unknowns component))
            (lwac-field-union-items
                (lwo-field-items (lwcs-evidence-witnesses world evidence))
                (lwcs-component-witnesses component)))))
(defn lwcs-components-add-items (world items evidence)
    (if (eq (len items) 0)
        (list (lwcs-component-from-evidence world evidence))
        (do
            (let component (head items))
            (if (node_eq (lwcs-component-kernel component)
                         (lwcs-evidence-kernel evidence))
                (cons (lwcs-component-add-evidence
                          world component evidence)
                      (tail items))
                (cons component
                    (lwcs-components-add-items
                        world (tail items) evidence))))))
(defn lwcs-components-from-support-items (world supports components)
    (if (eq (len supports) 0) (lwo-field components)
        (lwcs-components-from-support-items world (tail supports)
            (lwcs-components-add-items world components (head supports)))))
(defn lwcs-components-for (world set)
    (lwcs-components-from-support-items world
        (lwo-field-items (lwcs-set-supports set)) (list)))
(defn lwcs-component-for-kernel-items (items kernel)
    (if (eq (len items) 0) (lwo-none)
        (if (node_eq (lwcs-component-kernel (head items)) kernel)
            (head items)
            (lwcs-component-for-kernel-items (tail items) kernel))))
(defn lwcs-component-for-kernel (components kernel)
    (lwcs-component-for-kernel-items
        (lwo-field-items components) kernel))

; --- contextual field --------------------------------------------------

(defn lwcs-all-evidence-alternatives (items field)
    (if (eq (len items) 0) field
        (lwcs-all-evidence-alternatives (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwcs-evidence-alternatives (head items))) field))))
(defn lwcs-all-evidence-unknowns (items field)
    (if (eq (len items) 0) field
        (lwcs-all-evidence-unknowns (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwcs-evidence-unknowns (head items))) field))))
(defn lwcs-all-evidence-witnesses (world items field)
    (if (eq (len items) 0) field
        (lwcs-all-evidence-witnesses world (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwcs-evidence-witnesses world (head items))) field))))
(defn lwcs-components-alternatives (items field)
    (if (eq (len items) 0) field
        (lwcs-components-alternatives (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwcs-component-alternatives (head items))) field))))
(defn lwcs-components-unknowns (items field)
    (if (eq (len items) 0) field
        (lwcs-components-unknowns (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwcs-component-unknowns (head items))) field))))
(defn lwcs-focus-witnesses (world focus)
    (if (node_eq focus (lwo-none)) (lwo-empty-field)
        (lwo-active-attributions-for world focus)))

; children: focus, components, complete evidence, status, alternatives,
; unknowns, witnesses, distinct-source threshold, local path
(defn lwcs-field
    (focus components set status alternatives unknowns witnesses threshold)
    (intern_node LWCS-FIELD
        (list focus components set status alternatives unknowns witnesses
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwcs-field? (cell) (lwo-category? cell LWCS-FIELD))
(defn lwcs-field-focus (field) (nth (node_children field) 0))
(defn lwcs-field-components (field) (nth (node_children field) 1))
(defn lwcs-field-evidence (field) (nth (node_children field) 2))
(defn lwcs-field-status (field) (nth (node_children field) 3))
(defn lwcs-field-alternatives (field) (nth (node_children field) 4))
(defn lwcs-field-unknowns (field) (nth (node_children field) 5))
(defn lwcs-field-witnesses (field) (nth (node_children field) 6))
(defn lwcs-field-threshold-cell (field) (nth (node_children field) 7))
(defn lwcs-field-threshold (field)
    (node_value (lwcs-field-threshold-cell field)))
(defn lwcs-field-path (field) (nth (node_children field) 8))
(defn lwcs-field-for (world focus threshold)
    (do
        (let set (lwcs-evidence-for world focus threshold))
        (let components (lwcs-components-for world set))
        (let component-items (lwo-field-items components))
        (let component-count (len component-items))
        (let blockers (lwcs-set-blocker-count set))
        (let provisional-count
            (lwo-field-size (lwcs-set-provisional set)))
        (let status
            (if (gt blockers 0) (lwcs-ambiguous)
                (if (gt component-count 1) (lwcs-split)
                    (if (and (eq component-count 1)
                             (and (eq provisional-count 0)
                                  (gt threshold 0)))
                        (lwcs-coherent) (lwcs-open)))))
        (let all-items (lwcs-set-all-items set))
        (let base-alternatives
            (lwcs-all-evidence-alternatives
                all-items (lwo-empty-field)))
        (let component-alternatives
            (lwcs-components-alternatives
                component-items base-alternatives))
        (let alternatives
            (if (eq (lwcs-split? status) 1)
                (lwac-field-union-items component-items component-alternatives)
                component-alternatives))
        (let base-unknowns
            (lwcs-all-evidence-unknowns all-items (lwo-empty-field)))
        (let component-unknowns
            (lwcs-components-unknowns component-items base-unknowns))
        (let unknowns
            (if (eq (lwcs-coherent? status) 1) component-unknowns
                (lwo-field-add component-unknowns (lwlc-unknown set))))
        (let evidence-witnesses
            (lwcs-all-evidence-witnesses
                world all-items (lwo-empty-field)))
        (let witnesses
            (lwac-field-union-items
                (lwo-field-items (lwcs-focus-witnesses world focus))
                evidence-witnesses))
        (lwcs-field focus components set status alternatives unknowns
            witnesses threshold)))

; --- component admission ------------------------------------------------

; children: shared focus, selected component without a primary member, exact
; whole field snapshot, local path
(defn lwcs-tissue (focus component field)
    (intern_node LWCS-TISSUE
        (list focus component field (lwo-local-path))))
(defn lwcs-tissue? (cell) (lwo-category? cell LWCS-TISSUE))
(defn lwcs-tissue-focus (tissue) (nth (node_children tissue) 0))
(defn lwcs-tissue-component (tissue) (nth (node_children tissue) 1))
(defn lwcs-tissue-field (tissue) (nth (node_children tissue) 2))
(defn lwcs-tissue-path (tissue) (nth (node_children tissue) 3))
(defn lwcs-origin (focus kernel threshold)
    (intern_node LWCS-ORIGIN
        (list focus kernel (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwcs-origin-focus (origin) (nth (node_children origin) 0))
(defn lwcs-origin-kernel (origin) (nth (node_children origin) 1))
(defn lwcs-origin-threshold (origin)
    (node_value (nth (node_children origin) 2)))
(defn lwcs-tissue-proposal (world focus kernel threshold)
    (do
        (let field (lwcs-field-for world focus threshold))
        (let status (lwcs-field-status field))
        (if (or (le threshold 0)
                (or (eq (lwcs-ambiguous? status) 1)
                    (eq (lwcs-open? status) 1)))
            (lwo-none)
            (do
                (let component
                    (lwcs-component-for-kernel
                        (lwcs-field-components field) kernel))
                (if (or (node_eq component (lwo-none))
                        (lt (lwo-field-size
                                (lwcs-component-members component)) 2))
                    (lwo-none)
                    (do
                        (let witnesses (lwcs-field-witnesses field))
                        (let count (lwo-field-size witnesses))
                        (let origin (lwcs-origin focus kernel threshold))
                        (let candidate
                            (lwo-emergent
                                (lwcs-tissue focus component field)
                                witnesses
                                (intern_trivial_int
                                    (lwo-field-size
                                        (lwcs-component-evidence component)))
                                (intern_trivial_int
                                    (lwo-field-size
                                        (lwcs-component-contexts component)))
                                (intern_trivial_int count) origin))
                        (lwt-proposal candidate
                            (lwt-sources-from-attributions
                                (lwo-field-items witnesses)
                                (lwo-empty-field))
                            origin)))))))
(defn lwcs-tissue-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwcs-tissue? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwcs-tissue-candidate-current? (world candidate)
    (if (eq (lwcs-tissue-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwcs-tissue-proposal world
                    (lwcs-origin-focus origin)
                    (lwcs-origin-kernel origin)
                    (lwcs-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwcs-tissue-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwcs-tissue-candidate-current? world candidate) 1)) 1 0))
(defn lwcs-tissue-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwcs-tissue-candidate-current?
            world (lwt-proposal-candidate proposal))))
(defn lwcs-tissue-integrate (round proposal action)
    (if (eq (lwcs-tissue-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- separately consented enquiry --------------------------------------

; children: admitted tissue, optional live declaration, alternatives,
; optional unknowable remainder, evidence, local path
(defn lwcs-question (tissue context alternatives unknown evidence)
    (intern_node LWCS-QUESTION
        (list tissue context alternatives unknown evidence
              (lwo-local-path))))
(defn lwcs-question? (cell) (lwo-category? cell LWCS-QUESTION))
(defn lwcs-question-tissue (question) (nth (node_children question) 0))
(defn lwcs-question-context (question) (nth (node_children question) 1))
(defn lwcs-question-alternatives (question) (nth (node_children question) 2))
(defn lwcs-question-unknown (question) (nth (node_children question) 3))
(defn lwcs-question-evidence (question) (nth (node_children question) 4))
(defn lwcs-question-path (question) (nth (node_children question) 5))
(defn lwcs-question-valid? (question)
    (if (eq (lwcs-question? question) 0) 0
        (do
            (let context (lwcs-question-context question))
            (if (and (eq (lwcs-tissue-candidate?
                             (lwcs-question-tissue question)) 1)
                     (and (or (node_eq context (lwo-none))
                              (eq (lwlc-declaration-valid? context) 1))
                          (and (eq (lwo-category?
                                      (lwcs-question-alternatives question)
                                      LWO-FIELD) 1)
                               (eq (lwac-optional-unknown-valid?
                                      (lwcs-question-unknown question))
                                   1)))) 1 0))))
(defn lwcs-question-sources (world question)
    (lwcs-sources-for-attributions
        (lwo-active-attributions-for world question)))
(defn lwcs-derivation (tissue field question-attributions)
    (intern_node LWCS-DERIVATION
        (list tissue field question-attributions (lwo-local-path))))
(defn lwcs-derivation? (cell) (lwo-category? cell LWCS-DERIVATION))
(defn lwcs-derivation-tissue (derivation) (nth (node_children derivation) 0))
(defn lwcs-derivation-field (derivation) (nth (node_children derivation) 1))
(defn lwcs-derivation-question-attributions (derivation)
    (nth (node_children derivation) 2))
(defn lwcs-derivation-path (derivation) (nth (node_children derivation) 3))

; children: exact question/tissue/component, whole field status/components,
; members, receipts, contexts, NODE ack, alternatives, unknowns, derivation,
; local path
(defn lwcs-answer
    (question tissue component field ack alternatives unknowns derivation)
    (intern_node LWCS-ANSWER
        (list question tissue component (lwcs-field-status field)
              (lwcs-field-components field)
              (lwcs-component-members component)
              (lwcs-component-receipts component)
              (lwcs-component-contexts component)
              ack alternatives unknowns derivation (lwo-local-path))))
(defn lwcs-answer? (cell) (lwo-category? cell LWCS-ANSWER))
(defn lwcs-answer-question (answer) (nth (node_children answer) 0))
(defn lwcs-answer-tissue (answer) (nth (node_children answer) 1))
(defn lwcs-answer-component (answer) (nth (node_children answer) 2))
(defn lwcs-answer-status (answer) (nth (node_children answer) 3))
(defn lwcs-answer-components (answer) (nth (node_children answer) 4))
(defn lwcs-answer-members (answer) (nth (node_children answer) 5))
(defn lwcs-answer-receipts (answer) (nth (node_children answer) 6))
(defn lwcs-answer-contexts (answer) (nth (node_children answer) 7))
(defn lwcs-answer-ack (answer) (nth (node_children answer) 8))
(defn lwcs-answer-alternatives (answer) (nth (node_children answer) 9))
(defn lwcs-answer-unknowns (answer) (nth (node_children answer) 10))
(defn lwcs-answer-derivation (answer) (nth (node_children answer) 11))
(defn lwcs-answer-path (answer) (nth (node_children answer) 12))
(defn lwcs-answer-for (world question threshold)
    (if (or (eq (lwcs-question-valid? question) 0)
            (le threshold 0)) (lwo-none)
        (do
            (let tissue-candidate (lwcs-question-tissue question))
            (let context (lwcs-question-context question))
            (let question-attributions
                (lwo-active-attributions-for world question))
            (let question-sources
                (lwcs-sources-for-attributions question-attributions))
            (if (or (eq (lwcs-tissue-integrated-current?
                            world tissue-candidate) 0)
                    (or (eq (lwcs-context-current? world context) 0)
                        (lt (lwo-field-size question-sources) threshold)))
                (lwo-none)
                (do
                    (let tissue (lwo-emergent-shape tissue-candidate))
                    (let component (lwcs-tissue-component tissue))
                    (let field (lwcs-tissue-field tissue))
                    (let alternatives
                        (lwac-field-union-items
                            (lwo-field-items
                                (lwcs-question-alternatives question))
                            (lwcs-field-alternatives field)))
                    (let unknown
                        (lwcs-question-unknown question))
                    (let unknowns
                        (if (node_eq unknown (lwo-none))
                            (lwcs-field-unknowns field)
                            (lwo-field-add
                                (lwcs-field-unknowns field) unknown)))
                    (lwcs-answer question tissue-candidate component field
                        (oac-node component) alternatives unknowns
                        (lwcs-derivation tissue-candidate field
                            question-attributions)))))))
(defn lwcs-answer-witnesses (world question)
    (do
        (let tissue (lwcs-question-tissue question))
        (let with-question
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world question))
                (lwo-active-attributions-for world tissue)))
        (lwac-field-union-items
            (lwo-field-items
                (lwcs-context-witnesses
                    world (lwcs-question-context question)))
            with-question)))
(defn lwcs-answer-origin (question threshold)
    (intern_node LWCS-ANSWER-ORIGIN
        (list question (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwcs-answer-origin-threshold (origin)
    (node_value (nth (node_children origin) 1)))
(defn lwcs-answer-proposal (world question threshold)
    (do
        (let answer (lwcs-answer-for world question threshold))
        (if (node_eq answer (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwcs-answer-witnesses world question))
                (let count (lwo-field-size witnesses))
                (let origin (lwcs-answer-origin question threshold))
                (let candidate
                    (lwo-emergent answer witnesses
                        (intern_trivial_int 1)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwcs-answer-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwcs-answer? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwcs-answer-candidate-current? (world candidate)
    (if (eq (lwcs-answer-candidate? candidate) 0) 0
        (do
            (let answer (lwo-emergent-shape candidate))
            (let origin (lwo-emergent-provenance candidate))
            (let question (lwcs-answer-question answer))
            (let fresh
                (lwcs-answer-proposal world question
                    (lwcs-answer-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwcs-answer-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwcs-answer-candidate-current? world candidate) 1)) 1 0))
(defn lwcs-answer-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwcs-answer-candidate-current?
            world (lwt-proposal-candidate proposal))))
(defn lwcs-answer-integrate (round proposal action)
    (if (eq (lwcs-answer-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
