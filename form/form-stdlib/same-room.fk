// Compare supplied network signatures; overlap is evidence, not a physical
// room measurement. Grouping joins the first matching current group head.
// New members become that head; group order and reverse member order persist.
// preludes: form-stdlib/core.fk form-stdlib/context-signature.fk form-stdlib/room-register.fk
section [form.bml] {
 class SameRoom {
  def sr-device(id,signature) = list(id,signature);
  def sr-dev-id(device): String = nth(device,0);
  def sr-dev-ctx(device) = nth(device,1);
  def sr-same?(a,b,floor) = cs-overlap(a,b) >= floor;
  def sr-which-room(signature,known,tolerance,new-id) = rr-rediscover(signature,known,tolerance,new-id);
  def sr-which-room-id(signature,known,tolerance,new-id) = rr-id(sr-which-room(signature,known,tolerance,new-id));
  def sr-joins?(device,group,floor) = !nil?(group) && sr-same?(sr-dev-ctx(device),sr-dev-ctx(head(group)),floor);
  def sr-add(device,groups,floor) =
   if nil?(groups) then list(list(device))
   else if sr-joins?(device,head(groups),floor) then cons(cons(device,head(groups)),tail(groups))
   else cons(head(groups),sr-add(device,tail(groups),floor));
  def sr-grouping-cells(devices,floor) {
   def place(groups,device) = sr-add(device,groups,floor);
   foldl(place,empty,devices);
  }
  def sr-ids(group) = map(sr-dev-id,group);
  def sr-grouping(devices,floor) = map(sr-ids,sr-grouping-cells(devices,floor));
  def sr-room-count(devices,floor) = len(sr-grouping-cells(devices,floor));
  def sr-why(a,b,floor) {
   let overlap = cs-overlap(a,b);
   list("network-overlap",if overlap >= floor then "same-room" else "different-room",overlap,floor);
  }
  def sr-why-signal(why): String = nth(why,0);
  def sr-why-verdict(why): String = nth(why,1);
  def sr-why-overlap(why) = nth(why,2);
  def sr-why-floor(why) = nth(why,3);
 }
}
