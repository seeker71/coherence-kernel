// resident-ingress-turnwheel-join.fk — one cooperative crossing from yielded
// resident ingress envelopes into the already-living form-cli turnwheel.
//
// The host and its shared session exist before `ritj-offer` can admit an
// externally represented envelope.  `ritj-ready` opens one correlation
// exchange.  Publish and accept envelopes for another exchange become an
// explicit choice of their alternative; they do not move the host.  A valid
// publish reaches fcrt-publish, and a valid accept reaches fcrt-accept-program
// or fcrt-accept-prompt.  Program rows remain dynamic NodeID data and execute
// through jonb's JIT-once-born door; this join adds no callable seat.
//
// Polling and yielding remain cooperative: this cell claims no kernel thread,
// socket readiness, or physical Qwen run.  Its bounded event window contains
// only exchange, movement, signal and identity/reason — never recipe, prompt,
// or model bytes.  Absence, present 0, present 1, choice, timeout, cut, undo and
// refusal remain different results.
//
// preludes: form-stdlib/resident-async-ingress.fk
// preludes: form-stdlib/form-cli-resident-turnwheel.fk
// Proven by: form-stdlib/tests/resident-ingress-turnwheel-join-band.fk
section [form.bml] {
    // state = host, ingress, channel, ready-exchange, current-route-nodeid,
    // bounded causal events, event capacity.
    def ritj-state(host, ingress, channel, ready-exchange, current-id, events, capacity) = ["resident-ingress-turnwheel-join-v1", host, ingress, channel, ready-exchange, current-id, events, capacity];
    def ritj-host(s) = s[1];
    def ritj-ingress(s) = s[2];
    def ritj-channel(s) = s[3];
    def ritj-ready-exchange(s) = s[4];
    def ritj-current-id(s) = s[5];
    def ritj-events(s) = s[6];
    def ritj-event-capacity(s) = s[7];
    def ritj-new(host, ingress, channel, event-capacity) = ritj-state(host, ingress, channel, nothing(), nothing(), [], event-capacity);
    def ritj-with(s, host, ingress, ready-exchange, current-id, events) = ritj-state(host, ingress, ritj-channel(s), ready-exchange, current-id, events, ritj-event-capacity(s));
    def ritj-event(exchange, movement, signal, detail) = [exchange, movement, signal, detail];
    def ritj-observe(s, exchange, movement, signal, detail) = ritj-with(s, ritj-host(s), ritj-ingress(s), ritj-ready-exchange(s), ritj-current-id(s), rai-bounded-events(append(ritj-events(s), [ritj-event(exchange, movement, signal, detail)]), ritj-event-capacity(s)));
    // result = state, signal, present, value, detail, yielded-envelope.
    def ritj-result(state, signal, present, value, detail, envelope) = ["resident-ingress-turnwheel-result-v1", state, signal, present, value, detail, envelope];
    def ritj-result-state(r) = r[1];
    def ritj-result-signal(r) = r[2];
    def ritj-result-present?(r) = r[3];
    def ritj-result-value(r) = r[4];
    def ritj-result-detail(r) = r[5];
    def ritj-result-envelope(r) = r[6];
    // Ready is emitted from an existing host and changes no host/session/KV
    // state.  It returns [state', fcrt-ready-receipt].
    def ritj-ready(s, exchange) = {
        let receipt = fcrt-ready(ritj-host(s), exchange);
        let opened = ritj-with(s, ritj-host(s), ritj-ingress(s), exchange, ritj-current-id(s), ritj-events(s));
        [ritj-observe(opened, exchange, "ready", "value", receipt[2]), receipt];
    };
    // An offer from before ready is absence.  A different exchange is a
    // first-class choice of the envelope alternative.  Only a correlated
    // offer reaches the ingress water.
    def ritj-offer(s, envelope) = nothing?(ritj-ready-exchange(s)) ? ritj-result(s, "nothing", 0, nothing(), "ready-not-observed", envelope) : !((Comparable) rai-env-exchange(envelope) == ritj-ready-exchange(s)) ? {
        let s2 = ritj-observe(s, rai-env-exchange(envelope), rai-env-kind(envelope), "choice", "exchange-mismatch");
        ritj-result(s2, "choice", 1, rai-env-alternative(envelope), "exchange-mismatch", envelope);
    } : {
        let offered = rai-offer(ritj-ingress(s), envelope);
        let s2 = ritj-with(s, ritj-host(s), offered[0], ritj-ready-exchange(s), ritj-current-id(s), ritj-events(s));
        let s3 = ritj-observe(s2, rai-env-exchange(envelope), rai-env-kind(envelope), offered[2], rai-env-alternative(envelope));
        ritj-result(s3, offered[2], nothing?(offered[1]) ? 0 : 1, offered[1], offered[2], envelope);
    };
    def ritj-from-act(s, envelope, act, movement) = {
        let host2 = fcrt-act-host(act);
        let s2 = ritj-with(s, host2, ritj-ingress(s), ritj-ready-exchange(s), ritj-current-id(s), ritj-events(s));
        let s3 = ritj-observe(s2, rai-env-exchange(envelope), movement, fcrt-act-signal(act), fcrt-act-reason(act));
        ritj-result(s3, fcrt-act-signal(act), nothing?(fcrt-act-value(act)) ? 0 : 1, fcrt-act-value(act), fcrt-act-reason(act), envelope);
    };
    def ritj-publish-yielded(s, envelope) = {
        let p = rai-env-payload(envelope);
        let route = p[2];
        let act = fcrt-publish(ritj-host(s), p[0], p[1], route, rai-env-exchange(envelope));
        !((String) fcrt-act-signal(act) == "value") ? ritj-from-act(s, envelope, act, "publish") : {
            let s2 = ritj-with(s, fcrt-act-host(act), ritj-ingress(s), ritj-ready-exchange(s), fcrt-route-identity(route), ritj-events(s));
            let s3 = ritj-observe(s2, rai-env-exchange(envelope), "publish", "value", fcrt-route-identity(route));
            ritj-result(s3, "value", 1, fcrt-route-identity(route), fcrt-act-reason(act), envelope);
        };
    };
    def ritj-route-correlated?(s, envelope) = nothing?(ritj-current-id(s)) ? 0 : nothing?(rai-env-alternative(envelope)) ? 0 : node_eq(ritj-current-id(s), rai-env-alternative(envelope));
    def ritj-accept-program-yielded(s, envelope) = (Comparable) ritj-route-correlated?(s, envelope) == 0 ? {
        let s2 = ritj-observe(s, rai-env-exchange(envelope), "accept-program", "choice", "route-nodeid-mismatch");
        ritj-result(s2, "choice", 1, rai-env-alternative(envelope), "route-nodeid-mismatch", envelope);
    } : {
        let p = rai-env-payload(envelope);
        ritj-from-act(s, envelope, fcrt-accept-program(ritj-host(s), p[0], p[1], p[2], p[3]), "accept-program");
    };
    // This branch is compile-present but stays cold in the pure band.  A live
    // q38 residence can use the same correlated ingress without another API.
    def ritj-accept-prompt-yielded(s, envelope) = (Comparable) ritj-route-correlated?(s, envelope) == 0 ? {
        let s2 = ritj-observe(s, rai-env-exchange(envelope), "accept-prompt", "choice", "route-nodeid-mismatch");
        ritj-result(s2, "choice", 1, rai-env-alternative(envelope), "route-nodeid-mismatch", envelope);
    } : {
        let p = rai-env-payload(envelope);
        ritj-from-act(s, envelope, fcrt-accept-prompt(ritj-host(s), p[0], p[1], p[2], p[3]), "accept-prompt");
    };
    def ritj-cut-yielded(s, envelope) = {
        let cut = fcrt-cut(ritj-host(s), rai-env-payload(envelope));
        let s2 = ritj-with(s, cut[0], ritj-ingress(s), ritj-ready-exchange(s), ritj-current-id(s), ritj-events(s));
        let present = nothing?(cut[1]) ? 0 : 1;
        let s3 = ritj-observe(s2, rai-env-exchange(envelope), "cut-flow", "cut", present);
        ritj-result(s3, "cut", present, [cut[1], cut[2]], "flow-cut-returned-to-caller", envelope);
    };
    def ritj-undo-yielded(s, envelope) = {
        let replay = fcrt-undo-of(ritj-host(s), rai-env-payload(envelope));
        let s2 = ritj-observe(s, rai-env-exchange(envelope), "undo", nothing?(replay) ? "nothing" : "value", rai-env-payload(envelope));
        ritj-result(s2, nothing?(replay) ? "nothing" : "value", nothing?(replay) ? 0 : 1, replay, "replay-seam-observed", envelope);
    };
    def ritj-dispatch(s, envelope) = (String) rai-env-kind(envelope) == "publish" ? ritj-publish-yielded(s, envelope) : (String) rai-env-kind(envelope) == "accept-program" ? ritj-accept-program-yielded(s, envelope) : (String) rai-env-kind(envelope) == "accept-prompt" ? ritj-accept-prompt-yielded(s, envelope) : (String) rai-env-kind(envelope) == "cut-flow" ? ritj-cut-yielded(s, envelope) : (String) rai-env-kind(envelope) == "undo" ? ritj-undo-yielded(s, envelope) : {
        let s2 = ritj-observe(s, rai-env-exchange(envelope), rai-env-kind(envelope), "choice", "movement-not-selected");
        ritj-result(s2, "choice", 1, rai-env-alternative(envelope), "movement-not-selected", envelope);
    };
    // One cooperative quantum: at most one ingress envelope and at most one
    // turnwheel act.  Timeout/cut/release signals from ingress never dispatch
    // their payload as a recipe or prompt.
    def ritj-step(s, now) = {
        let yielded = rai-yield(ritj-ingress(s), now);
        let s1 = ritj-with(s, ritj-host(s), yielded[0], ritj-ready-exchange(s), ritj-current-id(s), ritj-events(s));
        let envelope = yielded[1];
        let signal = yielded[2];
        nothing?(envelope) ? ritj-result(s1, "nothing", 0, nothing(), "ingress-idle", nothing()) : !((String) signal == "value") ? {
            let s2 = ritj-observe(s1, rai-env-exchange(envelope), rai-env-kind(envelope), signal, rai-env-alternative(envelope));
            ritj-result(s2, signal, 0, nothing(), rai-env-alternative(envelope), envelope);
        } : ritj-dispatch(s1, envelope);
    };
    0;
}
