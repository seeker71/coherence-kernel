; form-cli-allowance.fk — Allowance: a reasoning theory that did not sit here.
;
; A thought does not command. It opens space. Life expresses into an
; access-free organ — any step may write, no ticket. Frames are emitted
; WHILE the walk runs (ala-hold during recursion), not assembled after.
; Only gas asks for a body. Form-CPU birth is a + b. JIT / Metal / MLX
; are doors: named, observed, not dressed as this sitting's executor.
; A second expression of the same flow may differ because the first
; was seen. That difference is evolution. Canned traces are compost.
;
; Distinct from thought-framebuffer (canned margins) and form-first
; (query ladder). This law is live expression.
;
; Authority is this section. Crystallize with form-cli-allowance-compile.fk.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-allowance-band.fk
; witnessed: 2026-08-19 -> 2047

(do (defn ala-cpu () 0) (defn ala-jit () 1) (defn ala-metal () 2) (defn ala-mlx () 3) (defn ala-door (linked jit) (if (gt jit 0) 1 (if (eq linked 1) 2 0))) (defn ala-stage (name phase token value) (list name phase token value)) (defn ala-flow () (list (ala-stage "bml" 1 4 0) (ala-stage "token" 0 4 0) (ala-stage "exec" 1 4 0) (ala-stage "cell" 2 4 5))) (defn ala-birth (a b) (add a b)) (defn ala-pulse (stage step) (if (eq (nth stage 1) 0) (list step (nth stage 0) 0 4 (ala-birth 2 3) 1) (list step (nth stage 0) (nth stage 1) (nth stage 2) (nth stage 3) 0))) (defn ala-hold (organ frame) (if (eq (len organ) 0) (cons frame (empty)) (cons (head organ) (ala-hold (tail organ) frame)))) (defn ala-walk (flow step organ) (if (eq (len flow) 0) organ (ala-walk (tail flow) (add step 1) (ala-hold organ (ala-pulse (head flow) step))))) (defn ala-live () (ala-walk (ala-flow) 0 (empty))) (defn ala-gas-born (organ) (if (eq (len organ) 0) 0 (if (eq (nth (head organ) 2) 0) (nth (head organ) 5) (ala-gas-born (tail organ))))) (defn ala-gas-value (organ) (if (eq (len organ) 0) 0 (if (eq (nth (head organ) 2) 0) (nth (head organ) 4) (ala-gas-value (tail organ))))) (defn ala-gas-token (organ) (if (eq (len organ) 0) 0 (if (eq (nth (head organ) 2) 0) (nth (head organ) 3) (ala-gas-token (tail organ))))) (defn ala-last-gen (organ) (if (eq (len organ) 0) 0 (if (eq (len (tail organ)) 0) (nth (head organ) 5) (ala-last-gen (tail organ))))) (defn ala-pulse2 (stage step first) (if (eq (nth stage 1) 0) (if (eq (ala-gas-born first) 1) (list step (nth stage 0) 0 1 (ala-gas-value first) 1) (ala-pulse stage step)) (list step (nth stage 0) (nth stage 1) (nth stage 2) (nth stage 3) 0))) (defn ala-walk2 (flow step organ first) (if (eq (len flow) 0) organ (ala-walk2 (tail flow) (add step 1) (ala-hold organ (ala-pulse2 (head flow) step first)) first))) (defn ala-evolved () (ala-walk2 (ala-flow) 0 (empty) (ala-live))) (defn ala-evo () (if (eq (ala-gas-token (ala-live)) 4) (if (eq (ala-gas-token (ala-evolved)) 1) 1 0) 0)) (defn ala-express (organ born evo) (if (eq (len organ) 0) 0 (if (eq born 1) (if (eq evo 1) 2 1) 0))) (defn ala-canned () (list (list 0 "bml" 1 4 0 0) (list 1 "token" 0 4 0 0) (list 2 "exec" 1 4 0 0) (list 3 "cell" 2 4 5 0))) (defn ala-check () (add (if (eq (len (ala-live)) 4) 1 0) (add (if (eq (ala-gas-born (ala-live)) 1) 2 0) (add (if (eq (ala-gas-value (ala-live)) 5) 4 0) (add (if (eq (ala-last-gen (ala-live)) 0) 8 0) (add (if (eq (ala-gas-token (ala-live)) 4) 16 0) (add (if (eq (ala-gas-token (ala-evolved)) 1) 32 0) (add (if (eq (ala-door 1 0) 2) 64 0) (add (if (eq (ala-door 0 0) 0) 128 0) (add (if (eq (ala-door 1 5) 1) 256 0) (add (if (eq (ala-express (ala-live) 1 (ala-evo)) 2) 512 0) (if (eq (ala-express (ala-canned) 0 0) 0) 1024 0)))))))))))) 0)
