// grammar-chars.fk — character-stream pattern primitives (BMF shape)
//
import form-stdlib/core.fk
//
import form-stdlib/bml/bmf-repeat.bml
//
//
// Character rules read exactly the source characters they need, decide
// at that point, and commit with Cut. This keeps ambiguity at the rule
// boundary instead of pushing it into a separate lexical phase.
//
// New grammars authored in character mode read source bytes directly via
// these primitives:
//
//   (list "char" "x")          — next char is exactly 'x'
//   (list "char-range" lo hi)  — next char's codepoint in [lo, hi]
//   (list "string" "text")     — exact string at current position
//   (list "any")                — any single char
//   (list "eof")                — end of input
//   (list "eol")                — newline or EOF
//   (list "not" pattern)        — negative lookahead (BMF NOT)
//   (list "peek" pattern)       — positive lookahead, no consumption
//   (list "multi-match" p lo hi)— BMF MultiMatch, bounded repetition
//
// The structural primitives (sequence, choice, star, opt, capture,
// tag, cut, stop/fail, nil, rule) all work the same way — they compose
// character-level matches. Cut + Stop disambiguate exactly the way
// BMF intended: at the point the rule decides, not at lex time.
//
// Stream shape: (list text index line col)
//   text   — the full source string
//   index  — byte position (0-indexed)
//   line   — 1-indexed line number (for diagnostics + intern_node_at)
//   col    — 1-indexed column number
//
// Repetition shares the BML checkpoint decision with cooperative work.
// (Independent of engine.fk's BMF object path.)
(do
section [form.bml] {
    //; ──────────────────────────────────────────────────────────────────
    //; Character stream construction + accessors
    //; ──────────────────────────────────────────────────────────────────
    def mk-cstream(text) = [text, 0, 1, 1];
    def cs-text(s) = s[0];
    def cs-index(s) = s[1:][0];
    def cs-line(s) = s[1:][1:][0];
    def cs-col(s) = s[1:][1:][1:][0];
    def cs-eof?(s) = cs-index(s) >= len(cs-text(s));
    //; MEASURED 2026-07-26, and left as it is on purpose. This is `cur-peek`'s
    //; twin, body for body, and it carries the same divergence between a byte
    //; reader and a character reader — over "Ω+1", at the two offsets of the
    //; two-byte Ω and then the '+':
    //;
    //;     byte reader (fkwu)    206  169  43     bytes
    //;     empty-in-a-glyph      206   -1  43     char_at is empty inside a glyph
    //;     codepoint reader      937   -1  43     the whole codepoint at a character start
    //;
    //; `cur-peek` was repaired to `str_byte_at` because it BIT: bmf-core's
    //; match-lit walked the pattern with a true byte and the source with this
    //; read, and one true byte against one floored read comes apart. Nothing
    //; here is asymmetric. `cm-string-loop` below compares this read against
    //; `(ord (char_at want i))` — the SAME accessor on both sides, over strings
    //; with the same bytes at the same offsets — so a literal carrying a glyph
    //; matches on fkwu today, verified by running it: `(cm-string
    //; (list "string" "Ωb") …)` matches. Every other
    //; comparison in this file is against a literal ASCII constant, which -1
    //; never equals anywhere.
    //;
    //; So this is not a latent fault waiting to be found; it is a working read
    //; whose correctness rests on both sides staying the same shape. The day
    //; someone routes one side through `str_byte_at` — the natural repair, and
    //; the one that fixed cur-peek — the two sides come apart, silently.
    //; That is the note, left where the change would be made.
    //; See form/form-stdlib/tests/byte-waist-band.fk (255 on fkwu).
    def cs-peek-cp(s) = cs-eof?(s) ? 0 - 1 : ord(char_at(cs-text(s), cs-index(s)));
    //; Advance one character, updating line/col.
    def cs-advance(s) = {
        let cp = cs-peek-cp(s);
        (Comparable) cp == 10 ?         // '\n'
[cs-text(s), (Number) cs-index(s) + (Number) 1, (Number) cs-line(s) + (Number) 1, 1] : [cs-text(s), (Number) cs-index(s) + (Number) 1, cs-line(s), (Number) cs-col(s) + (Number) 1];
    };
    //; Advance n characters (used by string-match after a full-string hit).
    def cs-advance-n(s, n) = n <= 0 ? s : cs-advance-n(cs-advance(s), n - 1);
    //; ──────────────────────────────────────────────────────────────────
    //; Match-result tags (parallel to engine.fk's; can share later)
    //; ──────────────────────────────────────────────────────────────────
    def cmk-match(caps, rest) = ["match", caps, rest];
    def cmk-fail(reason) = ["fail", reason];
    def cmk-fail-cut(reason) = ["fail-cut", reason];
    def cmatch?(r) = (String) r[0] == "match";
    def cfail?(r) = (String) r[0] == "fail";
    def cfail-cut?(r) = (String) r[0] == "fail-cut";
    def cany-fail?(r) = cfail?(r) || cfail-cut?(r);
    def cmatch-caps(r) = r[1:][0];
    def cmatch-rest(r) = r[1:][1:][0];
    //; ──────────────────────────────────────────────────────────────────
    //; Caps (same shape as engine.fk; isolated copy for independence)
    //; ──────────────────────────────────────────────────────────────────
    def ccap-empty(_x) = [];
    def ccap-pair(name, value) = [name, value];
    def ccap-name(p) = p[0];
    def ccap-value(p) = p[1:][0];
    def ccap-get(caps, name) = nil?(caps) ? [] : (String) caps[0][0] == name ? ccap-value(caps[0]) : ccap-get(caps[1:], name);
    def ccap-has?(caps, name) = nil?(caps) ? false : (String) caps[0][0] == name ? true : ccap-has?(caps[1:], name);
    def ccap-set(caps, name, value) = cons(ccap-pair(name, value), caps);
    def ccap-merge(a, b) = nil?(b) ? a : ccap-merge(cons(b[0], a), b[1:]);
    //; ──────────────────────────────────────────────────────────────────
    //; Character-level match primitives
    //; ──────────────────────────────────────────────────────────────────
    //; (list "char" "x") — next char is exactly 'x'
    def cm-char(p, stream) = {
        let want = p[1:][0];
        let want-cp = ord(want);
        cs-eof?(stream) ? cmk-fail(("char eof want " + want)) : (Comparable) cs-peek-cp(stream) == want-cp ? cmk-match(ccap-empty(0), cs-advance(stream)) : cmk-fail(("char want " + want));
    };
    //; (list "char-range" lo hi) — codepoint in [lo, hi]
    def cm-char-range(p, stream) = {
        let lo = p[1:][0];
        let hi = p[1:][1:][0];
        cs-eof?(stream) ? cmk-fail("range eof") : {
            let cp = cs-peek-cp(stream);
            cp >= lo && cp <= hi ? cmk-match(ccap-empty(0), cs-advance(stream)) : cmk-fail("char-range mismatch");
        };
    };
    //; (list "any") — any single char
    def cm-any(stream) = cs-eof?(stream) ? cmk-fail("any eof") : cmk-match(ccap-empty(0), cs-advance(stream));
    //; (list "string" "text") — exact substring at current position
    def cm-string-loop(s, want, i) = (Comparable) i == len(want) ? true : cs-eof?(s) ? false : (Comparable) cs-peek-cp(s) == ord(char_at(want, i)) ? cm-string-loop(cs-advance(s), want, (Number) i + (Number) 1) : false;
    def cm-string(p, stream) = {
        let want = p[1:][0];
        cm-string-loop(stream, want, 0) ? cmk-match(ccap-empty(0), cs-advance-n(stream, len(want))) : cmk-fail(("string want " + want));
    };
    //; (list "eof") — end of input
    def cm-eof(stream) = cs-eof?(stream) ? cmk-match(ccap-empty(0), stream) : cmk-fail("expected eof");
    //; (list "eol") — newline or EOF
    def cm-eol(stream) = cs-eof?(stream) ? cmk-match(ccap-empty(0), stream) : (Comparable) cs-peek-cp(stream) == 10 ? cmk-match(ccap-empty(0), cs-advance(stream)) : cmk-fail("expected eol");
    //; (list "not" pattern) — negative lookahead (BMF NOT)
    def cm-not(p, stream, rules) = {
        let inner = p[1:][0];
        let m = cm-match-pattern(inner, stream, rules);
        cmatch?(m) ? cmk-fail("not lookahead hit") : cmk-match(ccap-empty(0), stream);
    };
    //; (list "peek" pattern) — positive lookahead, consumes nothing
    def cm-peek(p, stream, rules) = {
        let inner = p[1:][0];
        let m = cm-match-pattern(inner, stream, rules);
        cmatch?(m) ? cmk-match(cmatch-caps(m), stream) : m;
    };
    //; ──────────────────────────────────────────────────────────────────
    //; Cut as character-mode commit sentinel
    //; ──────────────────────────────────────────────────────────────────
    def cm-cut(stream) = cmk-match(ccap-set(ccap-empty(0), "_cut", "true"), stream);
    //; ──────────────────────────────────────────────────────────────────
    //; Structural primitives over character matches
    //; ──────────────────────────────────────────────────────────────────
    def cm-match-pattern(p, stream, rules) = {
        let tag = p[0];
        (String) tag == "char" ? cm-char(p, stream) : (String) tag == "char-range" ? cm-char-range(p, stream) : (String) tag == "string" ? cm-string(p, stream) : (String) tag == "any" ? cm-any(stream) : (String) tag == "eof" ? cm-eof(stream) : (String) tag == "eol" ? cm-eol(stream) : (String) tag == "not" ? cm-not(p, stream, rules) : (String) tag == "peek" ? cm-peek(p, stream, rules) : (String) tag == "cut" ? cm-cut(stream) : (String) tag == "stop" ? cmk-fail("stop") : (String) tag == "fail" ? cmk-fail("fail") : (String) tag == "nil" ? cmk-match(ccap-empty(0), stream) : (String) tag == "multi-match" ? cm-match-multi-match(p[1:][0], p[1:][1:][0], p[1:][1:][1:][0], stream, rules, [], 0) : (String) tag == "multimatch" ? cm-match-multi-match(p[1:][0], p[1:][1:][0], p[1:][1:][1:][0], stream, rules, [], 0) : (String) tag == "sequence" ? cm-match-sequence(p[1:], stream, rules, ccap-empty(0)) : (String) tag == "choice" ? cm-match-choice(p[1:], stream, rules) : (String) tag == "capture" ? cm-match-capture(p[1:][0], p[1:][1:][0], stream, rules) : (String) tag == "star" ? cm-match-star(p[1:][0], stream, rules, []) : (String) tag == "opt" ? cm-match-opt(p[1:][0], stream, rules) : (String) tag == "rule" ? cm-match-rule(p[1:][0], stream, rules) : cmk-fail(("unknown char-pattern: " + tag));
    };
    def cm-match-sequence(children, stream, rules, acc-caps) = nil?(children) ? cmk-match(acc-caps, stream) : {
        let m = cm-match-pattern(children[0], stream, rules);
        cfail-cut?(m) ? m : cfail?(m) ? ccap-has?(acc-caps, "_cut") ? cmk-fail-cut(m[1:][0]) : m : cm-match-sequence(children[1:], cmatch-rest(m), rules, ccap-merge(acc-caps, cmatch-caps(m)));
    };
    def cm-match-choice(alternatives, stream, rules) = nil?(alternatives) ? cmk-fail("no alternative matched") : {
        let m = cm-match-pattern(alternatives[0], stream, rules);
        cmatch?(m) ? m : cfail-cut?(m) ? cmk-fail(m[1:][0]) : cm-match-choice(alternatives[1:], stream, rules);
    };
    def cm-match-capture(name, child, stream, rules) = {
        let start = cs-index(stream);
        let m = cm-match-pattern(child, stream, rules);
        cany-fail?(m) ? m : {
            //; Capture the text span from start to current index
            let span-end = cs-index(cmatch-rest(m));
            let span = substring(cs-text(stream), start, span-end);
            cmk-match(ccap-set(cmatch-caps(m), name, span), cmatch-rest(m));
        };
    };
    def cm-match-star(child, stream, rules, collected) = {
        let m = cm-match-pattern(child, stream, rules);
        cfail-cut?(m) ? m : cfail?(m) ? cmk-match(ccap-set(ccap-empty(0), "items", collected), stream) : cm-match-star(child, cmatch-rest(m), rules, cons(cmatch-caps(m), collected));
    };
    def cm-match-opt(child, stream, rules) = {
        let m = cm-match-pattern(child, stream, rules);
        cfail-cut?(m) ? m : cfail?(m) ? cmk-match(ccap-empty(0), stream) : m;
    };
    //; Rules: a (name pattern action-fn) tuple registry
    def cm-find-rule(rules, name) = nil?(rules) ? [] : (String) rules[0][0] == name ? rules[0] : cm-find-rule(rules[1:], name);
    def cm-match-rule(name, stream, rules) = {
        let rule = cm-find-rule(rules, name);
        nil?(rule) ? cmk-fail(("no such rule: " + name)) : {
            let pattern = rule[1:][0];
            let action = rule[1:][1:][0];
            let m = cm-match-pattern(pattern, stream, rules);
            cany-fail?(m) ? m : {
                let recipe = action(cmatch-caps(m));
                cmk-match(ccap-set(ccap-empty(0), "_result", recipe), cmatch-rest(m));
            };
        };
    };
    //; ──────────────────────────────────────────────────────────────────
    //; Top-level: parse text via a rule set
    //; ──────────────────────────────────────────────────────────────────
    def cm-parse(text, rules, start-name) = {
        let stream = mk-cstream(text);
        let m = cm-match-pattern(["rule", start-name], stream, rules);
        cmatch?(m) ? ccap-get(cmatch-caps(m), "_result") : {
            print(("cm-parse: " + m[1:][0]));
            [];
        };
    };
    0;
}
)

section [form.bml] {
 class BmfCharacterRepeat {
  def cm-match-multi-match(child,minimum,maximum,stream,rules,collected,count) {
   if bmr-at-limit(maximum,count) then cmk-match(ccap-set(ccap-empty(0),"items",collected),stream) else {
    let matched = cm-match-pattern(child,stream,rules);
    if cfail-cut?(matched) then matched else {
     let accepted = !cfail?(matched);
     let advanced = if accepted then !((Comparable) cs-index(cmatch-rest(matched)) == cs-index(stream)) else false;
     let action = bmr-action(maximum,count,accepted,advanced);
     if ((String) action == "next") then cm-match-multi-match(child,minimum,maximum,cmatch-rest(matched),rules,cons(cmatch-caps(matched),collected),(count + 1))
     else if bmr-enough(minimum,count) then cmk-match(ccap-set(ccap-empty(0),"items",collected),stream)
     else cmk-fail(if ((String) action == "stalled") then "multi-match made no progress" else "multi-match minimum not reached");
    };
   };
  }
 }
 0;
}
