//////////////////////////////////////////////////////////////////////
//
// term-graphics.bml
//
// Executable BML. The TERMINAL GRAPHICS ENGINE: generic rendering
// vocabulary for any framebuffer panel. Nothing here knows the hearth.
//
// Semantics over codes: callers name TONES (good, warn, bad, dim,
// plain), never SGR numbers — the code table lives in exactly one def.
// One duration formatter for every time a time is shown. One threshold
// scale for every judged quantity — the thresholds are the caller's
// DATA, not the engine's opinion. A panel is a LIST of lanes
// (label, value, tone, age-ms); one fold renders the whole frame.
// Shade is transparency (space, light, medium, dark, full); bars,
// ramps and sparklines are the same shade vocabulary at three scales.
//
import form-stdlib/core.fk;
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormTermGraphics {
        thought term-graphics-pattern = ["tones-not-codes", "one-duration-voice", "thresholds-are-data", "panel-is-data", "shade-is-transparency"];

        def tg-esc() = byte_to_str(27);
        def tg-nl() = byte_to_str(10);
        def tg-csi() = (tg-esc() + "[");
        def tg-code(name) = if ((String) name == "good") then "32" else if ((String) name == "warn") then "33" else if ((String) name == "bad") then "31" else if ((String) name == "dim") then "2" else if ((String) name == "bold") then "1" else "0";
        def tg-sgr(code) = (tg-csi() + (code + "m"));
        def tg-tone(name) = tg-sgr(tg-code(name));
        def tg-reset() = tg-tone("plain");
        def tg-span(name, text) = (tg-tone(name) + ((String) text + tg-reset()));
        // The cursor and screen vocabulary: every CSI code the body emits
        // is named here once; a canvas or panel calls the name.
        def tg-cursor-home() = (tg-csi() + "H");
        def tg-cursor-to(x, y) = (tg-csi() + ((y + 1).str() + (";" + ((x + 1).str() + "H"))));
        def tg-cursor-hide() = (tg-csi() + "?25l");
        def tg-cursor-show() = (tg-csi() + "?25h");
        // DEC 2026 batches a complete update on supporting terminals.
        def tg-sync-begin() = (tg-csi() + "?2026h");
        def tg-sync-end() = (tg-csi() + "?2026l");
        def tg-screen-clear() = (tg-csi() + "2J");
        def tg-screen-erase-rest() = (tg-csi() + "J");
        def tg-line-erase-rest() = (tg-csi() + "K");
        def tg-alt-screen-on() = (tg-csi() + "?1049h");
        def tg-alt-screen-off() = (tg-csi() + "?1049l");
        def tg-home() = ((String) tg-cursor-home() + tg-screen-clear());
        // Truecolor is the tg- extension a 24-bit canvas composes into one
        // SGR: the prefixes live here, the RGB triple is the caller's data.
        def tg-rgb(r, g, b) = (r.str() + (";" + (g.str() + (";" + b.str()))));
        def tg-fg-rgb(r, g, b) = ("38;2;" + tg-rgb(r, g, b));
        def tg-bg-rgb(r, g, b) = ("48;2;" + tg-rgb(r, g, b));

        def tg-scale(v, lo, hi) = if (v < lo) then "good" else if (v < hi) then "warn" else "bad";
        def tg-dur(ms) = if (ms < 1000) then (ms.str() + "ms") else if (ms < 60000) then ((ms / 1000).str() + "s") else if (ms < 3600000) then ((ms / 60000).str() + "m") else if (ms < 86400000) then ((ms / 3600000).str() + "h") else ((ms / 86400000).str() + "d");
        def tg-dur-us(us) = if (us < 1000) then (us.str() + "us") else tg-dur((us / 1000));
        // One voice for counts and one for bytes, beside the one for time.
        def tg-count(v) = if (v >= 1000000000) then ((v / 1000000000).str() + "G") else if (v >= 1000000) then ((v / 1000000).str() + "M") else if (v >= 1000) then ((v / 1000).str() + "K") else v.str();
        def tg-bytes(v) = if (v >= 1073741824) then ((v / 1073741824).str() + "GiB") else if (v >= 1048576) then ((v / 1048576).str() + "MiB") else if (v >= 1024) then ((v / 1024).str() + "KiB") else (v.str() + "B");
        // tg-scale with any number of rungs: the rung index of v against an
        // ascending threshold list (0 below the first, len(rungs) at or past the last).
        def tg-rung(v, rungs) = if ((Comparable) len(rungs) == 0) then 0 else if (v < rungs[0]) then 0 else (1 + tg-rung(v, rungs[1:]));

        def tg-b3(a, b, c) = (byte_to_str(a) + ((String) byte_to_str(b) + byte_to_str(c)));
        def tg-shade(i) = if (i <= 0) then " " else if ((Comparable) i == 1) then tg-b3(226, 150, 145) else if ((Comparable) i == 2) then tg-b3(226, 150, 146) else if ((Comparable) i == 3) then tg-b3(226, 150, 147) else tg-b3(226, 150, 136);
        def tg-ramp-go(n, i, acc) = if (i >= n) then acc else tg-ramp-go(n, (i + 1), ((String) acc + tg-shade(if (i < 4) then (i + 1) else 4)));
        def tg-ramp(n) = tg-ramp-go(if (n < 1) then 1 else n, 0, "");
        def tg-bar-go(cells, fill, i, acc) = if (i >= cells) then acc else tg-bar-go(cells, fill, (i + 1), ((String) acc + tg-shade(if (i < fill) then 4 else 0)));
        def tg-bar(fill, cells) = tg-bar-go(cells, fill, 0, "");
        def tg-max-go(vs, m) = if ((Comparable) len(vs) == 0) then m else tg-max-go(vs[1:], if (vs[0] > m) then vs[0] else m);
        def tg-spark-one(v, top) = tg-shade(if (top <= 0) then 0 else ((v * 4) / top));
        def tg-spark-go(vs, top, acc) = if ((Comparable) len(vs) == 0) then acc else tg-spark-go(vs[1:], top, ((String) acc + tg-spark-one(vs[0], top)));
        def tg-spark(vs) = tg-spark-go(vs, tg-max-go(vs, 1), "");

        def tg-age-lo() = 3000;
        def tg-age-hi() = 30000;
        def tg-age-suffix(agems) = if (agems < 0) then "" else ("  " + tg-span(tg-scale(agems, tg-age-lo(), tg-age-hi()), tg-dur(agems)));

        def tg-lane(label, value, tone, agems) = [label, value, tone, agems];
        def tg-lane-render(l) = (tg-span("dim", l[0]) + (tg-span(l[2], l[1]) + ((String) tg-age-suffix(l[3]) + tg-nl())));
        def tg-frame-go(lanes, acc) = if ((Comparable) len(lanes) == 0) then acc else tg-frame-go(lanes[1:], ((String) acc + tg-lane-render(lanes[0])));
        def tg-frame(lanes) = ((String) tg-home() + tg-frame-go(lanes, ""));
    }
    0;
}
