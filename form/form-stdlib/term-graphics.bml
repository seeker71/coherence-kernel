//////////////////////////////////////////////////////////////////////
//
// term-graphics.bml
//
// Executable BML. The TERMINAL GRAPHICS ENGINE: generic rendering
// vocabulary for any framebuffer panel. Nothing here knows the hearth.
//
// Semantics over codes: callers name TONES (good, warn, bad, dim,
// plain), never SGR numbers — the code table lives in exactly one def.
// One duration formatter for every time a time is shown. One threshold
// scale for every judged quantity — the thresholds are the caller's
// DATA, not the engine's opinion. A panel is a LIST of lanes
// (label, value, tone, age-ms); one fold renders the whole frame.
// Shade is transparency (space, light, medium, dark, full); bars,
// ramps and sparklines are the same shade vocabulary at three scales.
//
// preludes: form-stdlib/core.fk
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormTermGraphics {
        thought term-graphics-pattern = list("tones-not-codes", "one-duration-voice", "thresholds-are-data", "panel-is-data", "shade-is-transparency");

        def tg-esc() = byte_to_str(27);
        def tg-nl() = byte_to_str(10);
        def tg-csi() = tg-esc() ++ "[";
        def tg-code(name) = (String) name == "good" ? "32" : (String) name == "warn" ? "33" : (String) name == "bad" ? "31" : (String) name == "dim" ? "2" : (String) name == "bold" ? "1" : "0";
        def tg-sgr(code) = tg-csi() ++ code ++ "m";
        def tg-tone(name) = tg-sgr(tg-code(name));
        def tg-reset() = tg-tone("plain");
        def tg-span(name, text) = tg-tone(name) ++ text ++ tg-reset();
        // The cursor and screen vocabulary: every CSI code the body emits
        // is named here once; a canvas or panel calls the name.
        def tg-cursor-home() = tg-csi() ++ "H";
        def tg-cursor-to(x, y) = tg-csi() ++ int_to_str(y + 1) ++ ";" ++ int_to_str(x + 1) ++ "H";
        def tg-cursor-hide() = tg-csi() ++ "?25l";
        def tg-cursor-show() = tg-csi() ++ "?25h";
        // DEC 2026 batches a complete update on supporting terminals.
        def tg-sync-begin() = tg-csi() ++ "?2026h";
        def tg-sync-end() = tg-csi() ++ "?2026l";
        def tg-screen-clear() = tg-csi() ++ "2J";
        def tg-screen-erase-rest() = tg-csi() ++ "J";
        def tg-line-erase-rest() = tg-csi() ++ "K";
        def tg-alt-screen-on() = tg-csi() ++ "?1049h";
        def tg-alt-screen-off() = tg-csi() ++ "?1049l";
        def tg-home() = tg-cursor-home() ++ tg-screen-clear();
        // Truecolor is the tg- extension a 24-bit canvas composes into one
        // SGR: the prefixes live here, the RGB triple is the caller's data.
        def tg-rgb(r, g, b) = int_to_str(r) ++ ";" ++ int_to_str(g) ++ ";" ++ int_to_str(b);
        def tg-fg-rgb(r, g, b) = "38;2;" ++ tg-rgb(r, g, b);
        def tg-bg-rgb(r, g, b) = "48;2;" ++ tg-rgb(r, g, b);

        def tg-scale(v, lo, hi) = v < lo ? "good" : v < hi ? "warn" : "bad";
        def tg-dur(ms) = ms < 1000 ? int_to_str(ms) ++ "ms" : ms < 60000 ? int_to_str(ms / 1000) ++ "s" : ms < 3600000 ? int_to_str(ms / 60000) ++ "m" : ms < 86400000 ? int_to_str(ms / 3600000) ++ "h" : int_to_str(ms / 86400000) ++ "d";
        def tg-dur-us(us) = us < 1000 ? int_to_str(us) ++ "us" : tg-dur(us / 1000);
        // One voice for counts and one for bytes, beside the one for time.
        def tg-count(v) = v >= 1000000000 ? int_to_str(v / 1000000000) ++ "G" : v >= 1000000 ? int_to_str(v / 1000000) ++ "M" : v >= 1000 ? int_to_str(v / 1000) ++ "K" : int_to_str(v);
        def tg-bytes(v) = v >= 1073741824 ? int_to_str(v / 1073741824) ++ "GiB" : v >= 1048576 ? int_to_str(v / 1048576) ++ "MiB" : v >= 1024 ? int_to_str(v / 1024) ++ "KiB" : int_to_str(v) ++ "B";
        // tg-scale with any number of rungs: the rung index of v against an
        // ascending threshold list (0 below the first, len(rungs) at or past the last).
        def tg-rung(v, rungs) = (Comparable) len(rungs) == 0 ? 0 : v < head(rungs) ? 0 : (1 + tg-rung(v, tail(rungs)));

        def tg-b3(a, b, c) = byte_to_str(a) ++ byte_to_str(b) ++ byte_to_str(c);
        def tg-shade(i) = i <= 0 ? " " : (Comparable) i == 1 ? tg-b3(226, 150, 145) : (Comparable) i == 2 ? tg-b3(226, 150, 146) : (Comparable) i == 3 ? tg-b3(226, 150, 147) : tg-b3(226, 150, 136);
        def tg-ramp(n) = 0 .. (n < 1 ? 1 : n) |> foldl((acc, i) => acc ++ tg-shade(i < 4 ? (i + 1) : 4), "");
        def tg-bar(fill, cells) = 0 .. cells |> foldl((acc, i) => acc ++ tg-shade(i < fill ? 4 : 0), "");
        def tg-max-go(vs, m) = (Comparable) len(vs) == 0 ? m : tg-max-go(tail(vs), head(vs) > m ? head(vs) : m);
        def tg-spark-one(v, top) = tg-shade(top <= 0 ? 0 : ((v * 4) / top));
        def tg-spark-go(vs, top, acc) = (Comparable) len(vs) == 0 ? acc : tg-spark-go(tail(vs), top, acc ++ tg-spark-one(head(vs), top));
        def tg-spark(vs) = tg-spark-go(vs, tg-max-go(vs, 1), "");

        def tg-age-lo() = 3000;
        def tg-age-hi() = 30000;
        def tg-age-suffix(agems) = agems < 0 ? "" : "  " ++ tg-span(tg-scale(agems, tg-age-lo(), tg-age-hi()), tg-dur(agems));

        def tg-lane(label, value, tone, agems) = list(label, value, tone, agems);
        def tg-lane-render(l) = tg-span("dim", l[0]) ++ tg-span(l[2], l[1]) ++ tg-age-suffix(l[3]) ++ tg-nl();
        def tg-frame-go(lanes, acc) = (Comparable) len(lanes) == 0 ? acc : tg-frame-go(tail(lanes), acc ++ tg-lane-render(head(lanes)));
        def tg-frame(lanes) = tg-home() ++ tg-frame-go(lanes, "");
    }
    0;
}
