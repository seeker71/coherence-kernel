//////////////////////////////////////////////////////////////////////
//
// term-graphics.bml
//
// Executable BML. The TERMINAL GRAPHICS ENGINE: generic rendering
// vocabulary for any framebuffer panel. Nothing here knows the hearth.
//
// Semantics over codes: callers name TONES (good, warn, bad, dim,
// plain), never SGR numbers — the code table lives in exactly one def.
// One duration formatter for every time a time is shown. One threshold
// scale for every judged quantity — the thresholds are the caller's
// DATA, not the engine's opinion. A panel is a LIST of lanes
// (label, value, tone, age-ms); one fold renders the whole frame.
// Shade is transparency (space, light, medium, dark, full); bars,
// ramps and sparklines are the same shade vocabulary at three scales.
//
// preludes: form-stdlib/core.fk
//
// Proven by: form-stdlib/tests/term-graphics-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormTermGraphics {
        thought term-graphics-pattern = list("tones-not-codes", "one-duration-voice", "thresholds-are-data", "panel-is-data", "shade-is-transparency");

        def tg-esc() = byte_to_str(27);
        def tg-nl() = byte_to_str(10);
        def tg-csi() = str_concat(tg-esc(), "[");
        def tg-code(name) = if str_eq(name, "good") then "32" else if str_eq(name, "warn") then "33" else if str_eq(name, "bad") then "31" else if str_eq(name, "dim") then "2" else if str_eq(name, "bold") then "1" else "0";
        def tg-sgr(code) = str_concat(tg-csi(), str_concat(code, "m"));
        def tg-tone(name) = tg-sgr(tg-code(name));
        def tg-reset() = tg-tone("plain");
        def tg-span(name, text) = str_concat(tg-tone(name), str_concat(text, tg-reset()));
        // The cursor and screen vocabulary: every CSI code the body emits
        // is named here once; a canvas or panel calls the name.
        def tg-cursor-home() = str_concat(tg-csi(), "H");
        def tg-cursor-to(x, y) = str_concat(tg-csi(), str_concat(int_to_str(add(y, 1)), str_concat(";", str_concat(int_to_str(add(x, 1)), "H"))));
        def tg-cursor-hide() = str_concat(tg-csi(), "?25l");
        def tg-cursor-show() = str_concat(tg-csi(), "?25h");
        def tg-screen-clear() = str_concat(tg-csi(), "2J");
        def tg-screen-erase-rest() = str_concat(tg-csi(), "J");
        def tg-line-erase-rest() = str_concat(tg-csi(), "K");
        def tg-alt-screen-on() = str_concat(tg-csi(), "?1049h");
        def tg-alt-screen-off() = str_concat(tg-csi(), "?1049l");
        def tg-home() = str_concat(tg-cursor-home(), tg-screen-clear());
        // Truecolor is the tg- extension a 24-bit canvas composes into one
        // SGR: the prefixes live here, the RGB triple is the caller's data.
        def tg-rgb(r, g, b) = str_concat(int_to_str(r), str_concat(";", str_concat(int_to_str(g), str_concat(";", int_to_str(b)))));
        def tg-fg-rgb(r, g, b) = str_concat("38;2;", tg-rgb(r, g, b));
        def tg-bg-rgb(r, g, b) = str_concat("48;2;", tg-rgb(r, g, b));

        def tg-scale(v, lo, hi) = if lt(v, lo) then "good" else if lt(v, hi) then "warn" else "bad";
        def tg-dur(ms) = if lt(ms, 1000) then str_concat(int_to_str(ms), "ms") else if lt(ms, 60000) then str_concat(int_to_str(div(ms, 1000)), "s") else if lt(ms, 3600000) then str_concat(int_to_str(div(ms, 60000)), "m") else if lt(ms, 86400000) then str_concat(int_to_str(div(ms, 3600000)), "h") else str_concat(int_to_str(div(ms, 86400000)), "d");
        def tg-dur-us(us) = if lt(us, 1000) then str_concat(int_to_str(us), "us") else tg-dur(div(us, 1000));
        // One voice for counts and one for bytes, beside the one for time.
        def tg-count(v) = if ge(v, 1000000000) then str_concat(int_to_str(div(v, 1000000000)), "G") else if ge(v, 1000000) then str_concat(int_to_str(div(v, 1000000)), "M") else if ge(v, 1000) then str_concat(int_to_str(div(v, 1000)), "K") else int_to_str(v);
        def tg-bytes(v) = if ge(v, 1073741824) then str_concat(int_to_str(div(v, 1073741824)), "GiB") else if ge(v, 1048576) then str_concat(int_to_str(div(v, 1048576)), "MiB") else if ge(v, 1024) then str_concat(int_to_str(div(v, 1024)), "KiB") else str_concat(int_to_str(v), "B");
        // tg-scale with any number of rungs: the rung index of v against an
        // ascending threshold list (0 below the first, len(rungs) at or past the last).
        def tg-rung(v, rungs) = if eq(len(rungs), 0) then 0 else if lt(v, head(rungs)) then 0 else add(1, tg-rung(v, tail(rungs)));

        def tg-b3(a, b, c) = str_concat(byte_to_str(a), str_concat(byte_to_str(b), byte_to_str(c)));
        def tg-shade(i) = if le(i, 0) then " " else if eq(i, 1) then tg-b3(226, 150, 145) else if eq(i, 2) then tg-b3(226, 150, 146) else if eq(i, 3) then tg-b3(226, 150, 147) else tg-b3(226, 150, 136);
        def tg-ramp-go(n, i, acc) = if ge(i, n) then acc else tg-ramp-go(n, add(i, 1), str_concat(acc, tg-shade(if lt(i, 4) then add(i, 1) else 4)));
        def tg-ramp(n) = tg-ramp-go(if lt(n, 1) then 1 else n, 0, "");
        def tg-bar-go(cells, fill, i, acc) = if ge(i, cells) then acc else tg-bar-go(cells, fill, add(i, 1), str_concat(acc, tg-shade(if lt(i, fill) then 4 else 0)));
        def tg-bar(fill, cells) = tg-bar-go(cells, fill, 0, "");
        def tg-max-go(vs, m) = if eq(len(vs), 0) then m else tg-max-go(tail(vs), if gt(head(vs), m) then head(vs) else m);
        def tg-spark-one(v, top) = tg-shade(if le(top, 0) then 0 else div(mul(v, 4), top));
        def tg-spark-go(vs, top, acc) = if eq(len(vs), 0) then acc else tg-spark-go(tail(vs), top, str_concat(acc, tg-spark-one(head(vs), top)));
        def tg-spark(vs) = tg-spark-go(vs, tg-max-go(vs, 1), "");

        def tg-age-lo() = 3000;
        def tg-age-hi() = 30000;
        def tg-age-suffix(agems) = if lt(agems, 0) then "" else str_concat("  ", tg-span(tg-scale(agems, tg-age-lo(), tg-age-hi()), tg-dur(agems)));

        def tg-lane(label, value, tone, agems) = list(label, value, tone, agems);
        def tg-lane-render(l) = str_concat(tg-span("dim", nth(l, 0)), str_concat(tg-span(nth(l, 2), nth(l, 1)), str_concat(tg-age-suffix(nth(l, 3)), tg-nl())));
        def tg-frame-go(lanes, acc) = if eq(len(lanes), 0) then acc else tg-frame-go(tail(lanes), str_concat(acc, tg-lane-render(head(lanes))));
        def tg-frame(lanes) = str_concat(tg-home(), tg-frame-go(lanes, ""));
    }
    0;
}
