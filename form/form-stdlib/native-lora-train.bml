// One resident model and tokenizer serve a training run. Sequence microbatches
// accumulate a token-weighted batch gradient; every completed round updates LoRA.
// Parameters and Adam moments publish together, after device health and byte checks.
// preludes: form-stdlib/native-lora-dataset.bml form-stdlib/native-lora-checkpoint.bml form-stdlib/native-llama-voice.bml form-stdlib/native-lora-recompute.bml observe/bidirectional-framebuffer-channel.fk form-stdlib/json-precise.bml form-stdlib/sha256.fk form-stdlib/native-lora-progress.bml
section [form.bml] {
 class NativeLoraTrain {
  def ntr-int(k,v) = json-node-pair(k,json-node-int(v));
  def ntr-text(k,v) = json-node-pair(k,json-node-string(v));
  def ntr-real(k,v) = json-node-pair(k,json-precise-float(v));
  def ntr-get(r,k) = node_value(json-object-get(r,k));
  def ntr-activation-policy() = "memory-selected-whole-tape-or-layer-input-checkpoints;whole-sequence";
  def ntr-row-policy(checkpointed) = if checkpointed then "layer-input-checkpoints;whole-sequence-recompute" else "whole-tape;whole-sequence";
  def ntr-request(model,adapter,data,out,steps,batch,lr,masked,layers) = json-node-object(list(ntr-text("schema","native-lora-training-v1"),ntr-text("model",model),ntr-text("adapter",adapter),ntr-text("data",data),ntr-text("output",out),ntr-int("steps",steps),ntr-int("batch",batch),ntr-real("learning_rate",lr),ntr-int("mask_prompt",masked),ntr-int("layers",layers)));
  def ntr-event(out,kind,fields) {
   let text = str_concat(json-emit-precise(json-node-object(append(list(ntr-text("stage",kind),ntr-int("at_ms",host_monotonic_ms()),ntr-int("pid",host_pid()),ntr-text("owner","Form-native-Metal")),fields))),"\n");
   let wrote = sbt-append(str_concat(out,"/training-events.jsonl"),text);
   let shown = print_str(text);
   wrote;
  }
  def ntr-health-event(out,kind,reading,fields) {
   let voice = oh-voice(reading);
   ntr-event(out,kind,append(fields,list(json-node-pair("health",reading))));
  }
  def ntr-progress-observe(out,checkpoint,expected,step) {
   let config = parse-json("native-checkpoint-configuration",read_file(str_concat(checkpoint,"/adapter_config.json")));
   let marker = parse-json("native-checkpoint-completion",read_file(str_concat(checkpoint,"/complete.json")));
   let actual = json-object-get(config,"training_progress");
   let valid = and(nlp-checkpoint(config,marker),nlp-same(expected,actual));
   let reading = oh-reading("native-lora",out,"dataset-continuity",expected,actual,json-node-int(valid),if valid then list() else list(oh-need("checkpoint-progress-agreement",oh-reference(checkpoint))),list("continue-checkpoint","inspect-checkpoint"),oh-reference(checkpoint));
   let observed = ntr-health-event(out,"dataset-progress",reading,list(ntr-int("optimizer_step",step),json-node-pair("training_progress",actual),ntr-int("next_row_index",nlp-cursor(expected)),ntr-text("checkpoint",checkpoint)));
   if valid then 1 else form_error("published native dataset progress disagrees");
  }
  def ntr-config(model,r,step) = json-node-object(list(ntr-text("model",nth(model,4)),ntr-text("fine_tune_type","lora"),ntr-int("num_layers",ntr-get(r,"layers")),json-node-pair("lora_parameters",json-object-get(nth(model,5),"lora_parameters")),ntr-text("optimizer","adam"),ntr-real("learning_rate",ntr-get(r,"learning_rate")),ntr-int("batch_size",ntr-get(r,"batch")),ntr-int("mask_prompt",ntr-get(r,"mask_prompt")),ntr-int("native_step",step),ntr-text("data",ntr-get(r,"data")),ntr-text("sequence_policy","whole-row; memory admission; no silent truncation")));
  def ntr-save(model,state,r,step) {
   let out = ntr-get(r,"output"); let made = fs-mkdir(str_concat(out,"/generations"));
   let gen = str_concat(out,str_concat("/generations/",str_concat(int_to_str(step),str_concat("-",str_concat(int_to_str(host_pid()),str_concat("-",int_to_str(host_monotonic_ms())))))));
   let mkdir = fs-mkdir(gen);
   let a = nlc-save(str_concat(gen,"/adapters.safetensors"),nlc-adapter-rows(nlb-pairs(nth(model,1))),nth(model,4),step);
   let o = nlc-save(str_concat(gen,"/optimizer.safetensors"),nlc-optimizer-rows(state),nth(model,4),step);
   let progress = json-object-get(r,"training_progress");
   let config = oh-set(ntr-config(model,r,step),"activation_policy",json-node-string(ntr-activation-policy()));
   let c = if nlp-valid(progress) then nag-write(str_concat(gen,"/adapter_config.json"),json-emit-precise(oh-set(config,"training_progress",progress))) else form_error("native checkpoint requires dataset progress");
   let complete = nag-write(str_concat(gen,"/complete.json"),json-emit-precise(json-node-object(list(ntr-int("step",step),ntr-int("adapter_bytes",nth(a,1)),ntr-int("adapter_tensors",nth(a,2)),ntr-int("optimizer_bytes",nth(o,1)),ntr-int("optimizer_tensors",nth(o,2)),json-node-pair("training_progress",progress)))));
   let sync = nlc-sync-host(host_spawn_at(list("/bin/sync"),list("/dev/null","/dev/null","/dev/null")));
   nag-publish(out,gen);
  }
  def ntr-resume(model,state,adapter) {
   let config = nth(model,5);
   if not(json-object-has?(config,"native_step")) then list(0,"new Adam state; historical adapter has no optimizer checkpoint") else ntr-resume-native(state,nag-resolve(adapter),ntr-get(config,"native_step"),config);
  }
  def ntr-resume-native(state,dir,step,config) {
   let marker = parse-json("native-generation",read_file(str_concat(dir,"/complete.json")));
   if or(lt(step,0),not(eq(step,ntr-get(marker,"step")))) then form_error("native checkpoint step disagreement") else if not(nlp-checkpoint(config,marker)) then form_error("native checkpoint dataset progress disagreement") else ntr-resume-checked(state,dir,step);
  }
  def ntr-resume-checked(state,dir,step) {
   let restore = nlc-load-optimizer(state,str_concat(dir,"/optimizer.safetensors"));
   list(step,"Adam moments and step restored from the same published generation");
  }
  def ntr-whole-tape-bytes(model,t) = add(nlg-cache-bytes(model,t),add(mul(3,nlg-forward-bytes(model,t,0)),mul(12,mul(t,nth(head(model),5)))));
  def ntr-checkpointed?(model,t) = not(nlg-slice-fits?(ntr-whole-tape-bytes(model,t)));
  def ntr-policy-bytes(model,t,checkpointed) = if checkpointed then nlrc-bytes(model,t) else ntr-whole-tape-bytes(model,t);
  def ntr-row-bytes(model,t) = ntr-policy-bytes(model,t,ntr-checkpointed?(model,t));
  // Assessment retains the complete KV and releases each forward tape. Include
  // all head rows and masked-loss buffers in the slice admission estimate.
  def ntr-score-bytes(model,t,pos) {
   let g = head(model);
   add(nlg-forward-bytes(model,t,pos),mul(4,add(mul(5,t),add(mul(sub(t,1),add(nth(g,5),mul(2,nth(g,0)))),mul(t,nth(g,5))))));
  }
  def ntr-score-chunk(model,t,pos) = if le(t,0) then 0 else if nlg-slice-fits?(ntr-score-bytes(model,t,pos)) then t else ntr-score-chunk(model,div(t,2),pos);
  // Totals: weighted loss, supervised tokens, input tokens, slices, peak estimate.
  // A zero-mask slice still advances every prompt token through the same KV.
  def ntr-score-slices(model,ctx,ids,targets,mask,pos,limit,loss,tokens,slices,peak) {
   if nil?(ids) then list(loss,tokens,pos,slices,peak) else {
    let t = ntr-score-chunk(model,nlg-min(limit,len(ids)),pos);
    if eq(t,0) then form_error("native assessment awaits memory for one token") else {
     let estimate = ntr-score-bytes(model,t,pos); let weights = take(t,mask); let count = sum(weights);
     let r = if gt(count,0.0) then nll-forward-evaluation(model,ctx,take(t,ids),pos) else nll-forward(model,ctx,take(t,ids),pos,0);
     let value = if gt(count,0.0) then nlb-loss-masked(model,r,take(t,targets),weights) else 0.0;
     let released = nll-forward-close(r);
     if not(released) then form_error("native assessment forward release incomplete") else ntr-score-slices(model,ctx,drop(t,ids),drop(t,targets),drop(t,mask),add(pos,t),limit,add(loss,mul(value,count)),add(tokens,count),add(slices,1),nlg-max(peak,estimate));
    };
   };
  }
  def ntr-score(model,sample) {
   let ids = head(sample); let t = len(ids); let targets = nth(sample,1); let mask = nth(sample,2);
   if not(and(gt(t,0),and(eq(t,len(targets)),and(eq(t,len(mask)),and(nlb-mask-valid(mask),and(eq(sum(mask),nth(sample,3)),gt(nth(sample,3),0.0))))))) then form_error("native assessment token/mask shape refused")
   else if not(and(nll-ids-valid(ids,nth(head(model),5)),nll-ids-valid(targets,nth(head(model),5)))) then form_error("native assessment token IDs refused")
   else if gt(t,nth(head(model),9)) then form_error("native assessment row exceeds model positions")
   else if not(nlg-room(add(nlg-cache-bytes(model,t),ntr-score-bytes(model,1,sub(t,1))))) then form_error("native assessment awaits complete KV and one token")
   else {
    let ctx = nll-context(model,t);
    let limit = ntr-score-chunk(model,t,0);
    let totals = if lt(limit,t) then ntr-score-care(model,ctx,sample,limit) else ntr-score-slices(model,ctx,ids,targets,mask,0,t,0.0,0.0,0,0);
    let freed = nll-context-close(ctx);
    if not(and(freed,and(eq(nth(totals,2),t),eq(nth(totals,1),nth(sample,3))))) then form_error("native assessment coverage or release incomplete") else totals;
   };
  }
  def ntr-score-care(model,ctx,sample,limit) {
   let t = len(head(sample)); let expected = json-node-int(t);
   let reading = oh-reading("native-lora",nth(model,4),"assessment-memory",expected,json-node-int(limit),json-node-int(0),list(oh-need("bounded-complete-assessment",expected)),list("slice-assessment","defer"),json-node-int(nth(sample,4)));
   let sent = oh-voice(reading); let response = oh-response(reading,"slice-assessment"); let received = oh-voice(response);
   if not(str_eq(oh-select(reading,response,"defer"),"slice-assessment")) then form_error("native assessment response did not correlate") else {
    let applied = oh-voice(oh-applied(reading,"slice-assessment",json-node-int(limit)));
    let totals = ntr-score-slices(model,ctx,head(sample),nth(sample,1),nth(sample,2),0,limit,0.0,0.0,0,0);
    let covered = and(eq(nth(totals,2),t),eq(nth(totals,1),nth(sample,3)));
    let fresh = oh-reading("native-lora",nth(model,4),"assessment-memory",expected,json-node-int(nth(totals,2)),json-node-int(covered),if covered then list() else list(oh-need("bounded-complete-assessment",expected)),list("inspect-assessment"),json-node-object(list(ntr-int("line",nth(sample,4)),ntr-int("slices",nth(totals,3)),ntr-int("peak_slice_estimated_bytes",nth(totals,4)))));
    let observed = oh-voice(oh-set(fresh,"care_of",json-node-string(oh-str(reading,"id"))));
    totals;
   };
  }
  def ntr-score-loss(totals) = div(head(totals),nth(totals,1));
  def ntr-validation(model,tk,rows,masked,out,step) {
   let start = host_monotonic_ms();
   let totals = ntr-validation-rows(model,tk,rows,masked,0.0,0.0,0);
   if le(nth(totals,1),0.0) then form_error("native validation has no supervised tokens") else ntr-event(out,"validation",list(ntr-int("optimizer_step",step),ntr-int("rows",nth(totals,2)),ntr-real("supervised_tokens",nth(totals,1)),ntr-real("loss",div(head(totals),nth(totals,1))),ntr-int("wall_ms",sub(host_monotonic_ms(),start))));
  }
  def ntr-validation-rows(model,tk,rows,masked,loss,tokens,count) {
   if nil?(rows) then list(loss,tokens,count) else ntr-validation-row(model,tk,head(nld-prepare(tk,list(head(rows)),masked)),tail(rows),masked,loss,tokens,count);
  }
  def ntr-validation-row(model,tk,sample,rest,masked,loss,tokens,count) {
   let value = ntr-score-loss(ntr-score(model,sample));
   ntr-validation-rows(model,tk,rest,masked,add(loss,mul(value,nth(sample,3))),add(tokens,nth(sample,3)),add(count,1));
  }
  def ntr-grade-hex(bytes) = nlp-hex(bytes);
  def ntr-grade-rows(model,tk,rows,index) = if nil?(rows) then list() else cons(ntr-grade-row(model,tk,head(rows),index),ntr-grade-rows(model,tk,tail(rows),add(index,1)));
  def ntr-grade-row(model,tk,row,index) {
   let sample = nld-row(tk,row,1,add(index,1)); let totals = ntr-score(model,sample);
   json-node-object(list(ntr-int("index",index),ntr-text("row_sha256",ntr-grade-hex(sha256-stream-string(json-emit-precise(row)))),ntr-real("loss",ntr-score-loss(totals)),ntr-real("supervised_tokens",nth(totals,1)),ntr-int("input_tokens",nth(totals,2)),ntr-int("assessment_slices",nth(totals,3)),ntr-int("peak_slice_estimated_bytes",nth(totals,4))));
  }
  def ntr-assessment(model,tk,r,phase) {
   if not(json-object-has?(r,"assessment")) then 0 else ntr-assessment-at(model,tk,r,phase,host_monotonic_ms());
  }
  def ntr-assessment-at(model,tk,r,phase,started) {
   let rows = json-array-elements(parse-json("native-assessment",read_file(ntr-get(r,"assessment"))));
   if nil?(rows) then form_error("native assessment has no rows") else ntr-assessment-save(r,phase,ntr-grade-rows(model,tk,rows,0),started);
  }
  def ntr-assessment-save(r,phase,scores,started) {
   let out = ntr-get(r,"output"); let path = str_concat(out,str_concat("/assessment-",str_concat(phase,".json")));
   let saved = nag-write(path,json-emit-precise(json-node-array(scores)));
   ntr-event(out,str_concat("assessment-",phase),list(ntr-int("rows",len(scores)),ntr-int("wall_ms",sub(host_monotonic_ms(),started)),ntr-text("scores",path)));
  }
  def ntr-admit(model,sample) {
   ntr-admit-policy(model,sample,ntr-checkpointed?(model,len(head(sample))));
  }
  def ntr-admit-policy(model,sample,checkpointed) {
   let t = len(head(sample)); let bytes = ntr-policy-bytes(model,t,checkpointed);
   if gt(t,nth(head(model),9)) then form_error(str_concat("native training row exceeds model positions; line=",int_to_str(nth(sample,4)))) else if not(nlg-room(bytes)) then form_error(str_concat("native training checkpointed row awaits memory; line=",str_concat(int_to_str(nth(sample,4)),str_concat(" required_additional_bytes=",int_to_str(bytes))))) else 1;
  }
  def ntr-recompute-event(context,stage,index,t,elapsed) = ntr-event(head(context),str_concat("row-",str_concat(stage,"-layer")),list(ntr-int("line",nth(context,1)),ntr-int("layer",index),ntr-int("input_tokens",t),ntr-int("wall_ms",elapsed),ntr-int("device_bytes",nth(metal_live(),18))));
  def ntr-batch(model,state,rows,total,out,loss) {
   if nil?(rows) then loss else ntr-batch-row(model,state,head(rows),tail(rows),total,out,loss);
  }
  def ntr-batch-row(model,state,sample,rest,total,out,loss) {
   let checkpointed = ntr-checkpointed?(model,len(head(sample)));
   let entering = ntr-event(out,"row-start",list(ntr-int("line",nth(sample,4)),ntr-int("input_tokens",len(head(sample))),ntr-real("supervised_tokens",nth(sample,3)),ntr-int("required_additional_bytes",ntr-policy-bytes(model,len(head(sample)),checkpointed)),ntr-int("whole_tape_estimated_bytes",ntr-whole-tape-bytes(model,len(head(sample)))),ntr-text("activation_policy",ntr-row-policy(checkpointed))));
   let admitted = ntr-admit-policy(model,sample,checkpointed); let start = host_monotonic_ms(); let live = metal_live();
   let ctx = nll-context(model,len(head(sample))); let r = if checkpointed then nlrc-forward-observed(model,ctx,head(sample),list(out,nth(sample,4)),ntr-recompute-event) else nll-forward(model,ctx,head(sample),0,1);
   let forward = host_monotonic_ms(); let fg = metal_live();
   let forwardObserved = ntr-event(out,"row-forward-complete",list(ntr-int("line",nth(sample,4)),ntr-int("wall_ms",sub(forward,start)),ntr-int("dispatches",sub(nth(fg,7),nth(live,7)))));
   let weight = div(nth(sample,3),total);
   let value = if checkpointed then nlrc-backward-observed(model,r,nth(sample,1),nth(sample,2),state,weight,list(out,nth(sample,4)),ntr-recompute-event) else nlb-backward-masked(model,r,nth(sample,1),nth(sample,2),state,weight);
   let backward = host_monotonic_ms(); let bg = metal_live();
   let backwardObserved = ntr-event(out,"row-backward-complete",list(ntr-int("line",nth(sample,4)),ntr-int("wall_ms",sub(backward,forward)),ntr-int("dispatches",sub(nth(bg,7),nth(fg,7)))));
   let release = nll-forward-close(r); let close = nll-context-close(ctx);
   let event = ntr-event(out,"row",list(ntr-int("line",nth(sample,4)),ntr-int("input_tokens",len(head(sample))),ntr-real("supervised_tokens",nth(sample,3)),ntr-real("batch_weight",weight),ntr-real("sequence_loss",value),ntr-int("forward_ms",sub(forward,start)),ntr-int("backward_ms",sub(backward,forward)),ntr-int("forward_gpu_us",sub(nth(fg,11),nth(live,11))),ntr-int("backward_gpu_us",sub(nth(bg,11),nth(fg,11))),ntr-int("dispatches",sub(nth(bg,7),nth(live,7)))));
   ntr-batch(model,state,rest,total,out,add(loss,mul(value,weight)));
  }
  def ntr-cycle-rows(rows,cursor,batch) = take(batch,append(drop(cursor,rows),rows));
  def ntr-round(model,tk,state,rows,r,round,step) {
   let out = ntr-get(r,"output"); let steps = ntr-get(r,"steps");
   if ge(round,steps) then list(step,round,"completed") else if gt(file_size(str_concat(out,"/cancel")),0) then list(step,round,"cancelled") else ntr-round-ready(model,tk,state,rows,r,round,step);
  }
  def ntr-round-ready(model,tk,state,rows,r,round,step) {
   let out = ntr-get(r,"output"); let start = host_monotonic_ms();
   let batch = nlg-min(ntr-get(r,"batch"),len(rows));
   let progress = json-object-get(r,"training_progress");
   let selected = ntr-cycle-rows(rows,nlp-cursor(progress),batch);
   let prepared = nld-prepare(tk,selected,ntr-get(r,"mask_prompt"));
   let tokensAt = host_monotonic_ms(); let zero = nlb-clear(state);
   let loss = ntr-batch(model,state,prepared,nld-weight(prepared),out,0.0);
   let beforeUpdate = host_monotonic_ms();
   let health = nlb-health(state,1,0,0.0);
   let observation = bfc-envelope(0,add(920000,step),0,list(round,nld-tokens(prepared),head(health),nth(health,1)),3);
   let sent = bfc-record-out(observation,0);
   let control = bfc-control(observation,if eq(head(health),0) then 6 else 3);
   let received = bfc-record-in(control,1);
   let update = if eq(bfc-payload(control),6) then nlb-safe-step(state,ntr-get(r,"learning_rate"),add(step,1),1.0) else form_error("native training non-finite gradient; update abstained");
   let after = bfc-record-out(bfc-envelope(0,add(920000,step),0,append(update,nlb-health(state,0,0,0.0)),3),2);
   let updated = host_monotonic_ms();
