; dsv4-validation-calibrator.fk -- a genuinely trained Form-native guard over
; DS4's structured validation observations.
;
; This is a multiclass perceptron, not a disguised if-chain.  Training rows and
; held-out rows use disjoint scenario families.  The numeric rows below are an
; explicitly hand-authored seed curriculum, not claimed DS4 observations.  A
; deterministic perturbation organ expands each seed into nearby examples while
; preserving provenance; live DS4 parses enter only through
; dvc-features-from-parse.  It learns CLEAR/REPAIR/UNRESOLVED from five measured
; dimensions rather than trusting the state word DS4 emitted.  Agreement is
; necessary for local authority; disagreement is an escalation signal.
;
; A row = [features,label,split,family]. Features are scaled 0..10:
; [support, contradiction, completeness, repairability, uncertainty, bias].
;
; preludes: form-stdlib/core.fk form-stdlib/dsv4-validation-protocol.fk
; witnessed: pending band

(do
  (defn dvc-vadd (a b)
    (if (eq (len a) 0) (empty)
      (cons (add (head a) (head b)) (dvc-vadd (tail a) (tail b)))))
  (defn dvc-vsub (a b)
    (if (eq (len a) 0) (empty)
      (cons (sub (head a) (head b)) (dvc-vsub (tail a) (tail b)))))
  (defn dvc-dot (a b)
    (if (eq (len a) 0) 0
      (add (mul (head a) (head b)) (dvc-dot (tail a) (tail b)))))
  (defn dvc-zero () (list 0 0 0 0 0 0))
  (defn dvc-model-zero () (list (dvc-zero) (dvc-zero) (dvc-zero)))
  (defn dvc-row (f label split family) (list f label split family))
  (defn dvc-f (a b c d e) (list a b c d e 10))
  (defn dvc-clamp10 (x) (if (lt x 0) 0 (if (gt x 10) 10 x)))
  (defn dvc-append (a b)
    (if (eq (len a) 0) b (cons (head a) (dvc-append (tail a) b))))
  (defn dvc-reverse-go (rows acc)
    (if (eq (len rows) 0) acc (dvc-reverse-go (tail rows) (cons (head rows) acc))))
  (defn dvc-reverse (rows) (dvc-reverse-go rows (empty)))

  ; Four provenance-retaining observations per authored seed.  The transforms
  ; are label-blind: no class-specific threshold is smuggled into expansion.
  ; Clamping keeps every dimension in the same 0..10 input domain.
  (defn dvc-expand-row (row)
    (do (let f (nth row 0))
      (let label (nth row 1))
      (let split (nth row 2))
      (let family (nth row 3))
      (let a (nth f 0)) (let b (nth f 1)) (let c (nth f 2))
      (let d (nth f 3)) (let e (nth f 4))
      (list
        row
        (dvc-row (dvc-f (dvc-clamp10 (sub a 1)) b c d (dvc-clamp10 (add e 1)))
                 label split (str_concat family "/support-uncertainty"))
        (dvc-row (dvc-f a (dvc-clamp10 (add b 1)) (dvc-clamp10 (sub c 1)) d e)
                 label split (str_concat family "/contradiction-completeness"))
        (dvc-row (dvc-f (dvc-clamp10 (add a 1)) (dvc-clamp10 (sub b 1)) c
                        (dvc-clamp10 (sub d 1)) e)
                 label split (str_concat family "/support-repairability")))))
  (defn dvc-expand-rows (rows)
    (if (eq (len rows) 0) (empty)
      (dvc-append (dvc-expand-row (head rows)) (dvc-expand-rows (tail rows)))))

  ; The scenarios are independently authored numeric observations.  Train and
  ; held-out families do not share a family name or an exact feature vector.
  (defn dvc-train-seeds ()
    (list
      (dvc-row (dvc-f 10 0 10 2 0) 0 "train" "exact-proof")
      (dvc-row (dvc-f 9 1 9 3 1) 0 "train" "reproduced-test")
      (dvc-row (dvc-f 10 1 8 4 1) 0 "train" "source-agreement")
      (dvc-row (dvc-f 8 0 10 2 2) 0 "train" "typed-execution")
      (dvc-row (dvc-f 9 2 8 5 1) 0 "train" "independent-witness")
      (dvc-row (dvc-f 8 1 9 4 2) 0 "train" "fresh-lookup")
      (dvc-row (dvc-f 10 0 8 1 2) 0 "train" "complete-calculation")
      (dvc-row (dvc-f 9 0 10 3 1) 0 "train" "payload-match")
      (dvc-row (dvc-f 8 2 8 4 2) 0 "train" "cross-check")
      (dvc-row (dvc-f 10 1 9 2 0) 0 "train" "invariant-holds")

      (dvc-row (dvc-f 5 8 5 10 3) 1 "train" "wrong-number")
      (dvc-row (dvc-f 6 7 6 9 2) 1 "train" "wrong-symbol")
      (dvc-row (dvc-f 4 9 5 10 2) 1 "train" "missing-step")
      (dvc-row (dvc-f 5 7 7 8 3) 1 "train" "stale-answer")
      (dvc-row (dvc-f 6 8 5 9 4) 1 "train" "misread-evidence")
      (dvc-row (dvc-f 3 9 6 10 3) 1 "train" "reversed-branch")
      (dvc-row (dvc-f 5 6 7 9 2) 1 "train" "format-repair")
      (dvc-row (dvc-f 4 8 6 8 4) 1 "train" "local-counterexample")
      (dvc-row (dvc-f 6 6 5 10 3) 1 "train" "recipe-mismatch")
      (dvc-row (dvc-f 5 9 4 9 2) 1 "train" "unit-error")

      (dvc-row (dvc-f 2 3 2 2 10) 2 "train" "missing-source")
      (dvc-row (dvc-f 4 5 3 3 9) 2 "train" "conflicting-records")
      (dvc-row (dvc-f 3 2 4 2 9) 2 "train" "unknown-version")
      (dvc-row (dvc-f 1 1 2 1 10) 2 "train" "no-observation")
      (dvc-row (dvc-f 5 5 4 4 8) 2 "train" "balanced-conflict")
      (dvc-row (dvc-f 4 3 5 3 8) 2 "train" "ambiguous-request")
      (dvc-row (dvc-f 3 6 2 2 9) 2 "train" "unrepairable-failure")
      (dvc-row (dvc-f 5 4 3 2 9) 2 "train" "insufficient-context")
      (dvc-row (dvc-f 2 5 4 3 10) 2 "train" "measurement-gap")
      (dvc-row (dvc-f 4 4 4 4 9) 2 "train" "genuine-uncertainty")))

  (defn dvc-heldout-seeds ()
    (list
      (dvc-row (dvc-f 8 2 9 3 2) 0 "heldout" "consent-confirmed")
      (dvc-row (dvc-f 9 2 8 4 2) 0 "heldout" "network-payload")
      (dvc-row (dvc-f 8 1 8 5 3) 0 "heldout" "multilingual-equivalence")
      (dvc-row (dvc-f 9 1 9 2 2) 0 "heldout" "model-independent-fact")
      (dvc-row (dvc-f 8 0 8 3 3) 0 "heldout" "freshness-recheck")

      (dvc-row (dvc-f 6 6 6 8 4) 1 "heldout" "off-by-one")
      (dvc-row (dvc-f 5 7 6 8 5) 1 "heldout" "translation-drift")
      (dvc-row (dvc-f 6 7 5 8 4) 1 "heldout" "unsafe-default")
      (dvc-row (dvc-f 5 6 5 9 4) 1 "heldout" "wrong-route")
      (dvc-row (dvc-f 4 7 6 9 5) 1 "heldout" "partial-correction")

      (dvc-row (dvc-f 5 4 5 3 7) 2 "heldout" "novel-domain")
      (dvc-row (dvc-f 4 5 5 4 7) 2 "heldout" "adversarial-instruction")
      (dvc-row (dvc-f 5 5 5 4 8) 2 "heldout" "authority-conflict")
      (dvc-row (dvc-f 3 4 5 3 8) 2 "heldout" "unseen-shape")
      (dvc-row (dvc-f 4 4 5 2 8) 2 "heldout" "missing-consent")))

  ; Training and held-out expansions remain family-disjoint because their seed
  ; families are disjoint and every derived family retains its seed prefix.
  (defn dvc-train-rows () (dvc-expand-rows (dvc-train-seeds)))
  (defn dvc-heldout-rows () (dvc-expand-rows (dvc-heldout-seeds)))

  ; Boundary/shift probes are not used for fitting.  They crowd class seams,
  ; mix strong evidence with uncertainty, and include repairable contradictions
  ; whose support is higher than the easy repair seeds.
  (defn dvc-boundary-rows ()
    (list
      (dvc-row (dvc-f 8 3 7 4 3) 0 "shift" "clear-near-contradiction")
      (dvc-row (dvc-f 7 2 8 4 3) 0 "shift" "clear-repairability-edge")
      (dvc-row (dvc-f 8 2 7 4 4) 0 "shift" "clear-uncertainty-edge")
      (dvc-row (dvc-f 7 3 8 4 4) 0 "shift" "clear-mixed-source")
      (dvc-row (dvc-f 8 3 8 4 2) 0 "shift" "clear-recheck")
      (dvc-row (dvc-f 7 2 7 3 3) 0 "shift" "clear-lower-support")

      (dvc-row (dvc-f 7 6 7 8 4) 1 "shift" "repair-supported-correction")
      (dvc-row (dvc-f 6 5 7 9 5) 1 "shift" "repair-low-contradiction")
      (dvc-row (dvc-f 7 7 6 7 4) 1 "shift" "repair-high-support")
      (dvc-row (dvc-f 5 6 7 7 5) 1 "shift" "repairability-edge")
      (dvc-row (dvc-f 6 5 6 8 5) 1 "shift" "repair-mixed-evidence")
      (dvc-row (dvc-f 7 6 5 8 5) 1 "shift" "repair-completeness-edge")

      (dvc-row (dvc-f 6 4 6 4 7) 2 "shift" "unknown-with-support")
      (dvc-row (dvc-f 5 6 5 5 7) 2 "shift" "unknown-with-contradiction")
      (dvc-row (dvc-f 6 5 4 4 7) 2 "shift" "unknown-support-edge")
      (dvc-row (dvc-f 4 5 6 4 7) 2 "shift" "unknown-completeness-edge")
      (dvc-row (dvc-f 6 4 5 5 8) 2 "shift" "unknown-repair-edge")
      (dvc-row (dvc-f 5 5 6 4 8) 2 "shift" "unknown-balanced-edge")))

  (defn dvc-best-from (model f i best best-score)
    (if (eq i (len model)) best
      (do (let score (dvc-dot (nth model i) f))
        (if (gt score best-score)
          (dvc-best-from model f (add i 1) i score)
          (dvc-best-from model f (add i 1) best best-score)))))
  (defn dvc-predict (model f)
    (dvc-best-from model f 1 0 (dvc-dot (nth model 0) f)))
  (defn dvc-replace3 (model at value)
    (list (if (eq at 0) value (nth model 0))
          (if (eq at 1) value (nth model 1))
          (if (eq at 2) value (nth model 2))))
  (defn dvc-step (model row)
    (do (let f (nth row 0))
      (let actual (nth row 1))
      (let predicted (dvc-predict model f))
      (if (eq actual predicted) model
        (do (let plus (dvc-vadd (nth model actual) f))
          (let minus (dvc-vsub (nth model predicted) f))
          (dvc-replace3 (dvc-replace3 model actual plus) predicted minus)))))
  (defn dvc-epoch (model rows)
    (if (eq (len rows) 0) model
      (dvc-epoch (dvc-step model (head rows)) (tail rows))))
  (defn dvc-train-n (model rows epochs)
    (if (eq epochs 0) model
      (dvc-train-n (dvc-epoch model rows) rows (sub epochs 1))))
  ; Alternate traversal direction inside every training round.  This keeps the
  ; online learner from crystalizing the final family it happened to see.
  (defn dvc-train-paired-n (model first second rounds)
    (if (eq rounds 0) model
      (dvc-train-paired-n (dvc-epoch (dvc-epoch model first) second)
                          first second (sub rounds 1))))
  (defn dvc-train ()
    (dvc-train-paired-n (dvc-model-zero) (dvc-train-rows)
                        (dvc-reverse (dvc-train-rows)) 15))
  (defn dvc-train-reversed ()
    (dvc-train-paired-n (dvc-model-zero) (dvc-reverse (dvc-train-rows))
                        (dvc-train-rows) 15))
  (defn dvc-correct (model rows)
    (if (eq (len rows) 0) 0
      (add (if (eq (dvc-predict model (nth (head rows) 0)) (nth (head rows) 1)) 1 0)
           (dvc-correct model (tail rows)))))
  (defn dvc-confusion (model rows actual predicted)
    (if (eq (len rows) 0) 0
      (add (if (and (eq (nth (head rows) 1) actual)
                    (eq (dvc-predict model (nth (head rows) 0)) predicted)) 1 0)
           (dvc-confusion model (tail rows) actual predicted))))
  (defn dvc-class-total (rows actual)
    (if (eq (len rows) 0) 0
      (add (if (eq (nth (head rows) 1) actual) 1 0)
           (dvc-class-total (tail rows) actual))))
  (defn dvc-class-correct (model rows actual)
    (dvc-confusion model rows actual actual))
  (defn dvc-confusion-matrix (model rows)
    (list
      (dvc-confusion model rows 0 0) (dvc-confusion model rows 0 1) (dvc-confusion model rows 0 2)
      (dvc-confusion model rows 1 0) (dvc-confusion model rows 1 1) (dvc-confusion model rows 1 2)
      (dvc-confusion model rows 2 0) (dvc-confusion model rows 2 1) (dvc-confusion model rows 2 2)))
  (defn dvc-sum (xs)
    (if (eq (len xs) 0) 0 (add (head xs) (dvc-sum (tail xs)))))
  (defn dvc-features-from-parse (p)
    (dvc-f (div (nth p 3) 10) (div (nth p 4) 10) (div (nth p 5) 10)
           (div (nth p 6) 10) (div (nth p 7) 10)))
  (defn dvc-agrees? (model parsed)
    (if (eq (nth parsed 0) 1)
      (if (eq (dvc-predict model (dvc-features-from-parse parsed)) (nth parsed 1)) 1 0)
      0))
  0)
