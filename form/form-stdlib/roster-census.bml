//////////////////////////////////////////////////////////////////////
//
// roster-census.bml — the body counts its kernels by the pages they open,
// and names the ones its roster cannot see.
//
// A kernel is a living process whose live page names it, says alive, and was
// opened as or after the process started: every kernel opens /fg-k<pid> as it
// starts (fk_nodes_init calls fk_live_open), whatever its binary is named. The
// census asks every pid's page name once (kernel_page_ended: 1 an ended
// kernel's page, 2 a page it read, 0 none, -1 a page the host will not let it
// read), reads each page that stands (kernel_live) and the process under it
// (host_process: when it started, and which fields the host withheld). The
// roster is kernel_live_pids, every kernel holding a slot in /fg-kernels whose
// page says alive: what every organ that asks the roster sees. The host's name
// read, host_processes "fkwu*", names the processes that call themselves
// kernels. On 2026-09-11 Urs counted 14 fkwu processes while the roster named
// 11 — three living glass organs had never landed in it.
//
//   untracked  kernels the roster lacks: alive, and invisible to every organ
//              that asks the roster
//   stale      roster pids that are no living kernel: a page a kernel left on
//              a pid another process holds now
//   unpaged    processes named fkwu that are no living kernel: no page, or one
//              a kernel before them left
//   orphans    kernels whose owner walk ends at launchd: nobody waits for them
//              and nobody will stop them
//   errands    kernels whose row the host told, and told short: no cell, no
//              binary, or an owner walk that ends unread, gone or at an
//              ancestor with no binary
//   kernels    what each runs and for whom — (pid cell cwd exe owner owner-pid
//              kernel-parent withheld), read with host_process, no shell — and
//              the cells more than one kernel runs
//
// What a read did not see stays apart from what it saw. unread-names: the
// processes the name read could not name. unread-pages: pids whose page stands
// on a living process and could not be read, or whose process's start the host
// would not tell. unread-rows: kernels whose row, or an ancestor's binary on
// their owner walk, the host withheld (a withheld field, not an empty one).
// host-read: the name read answered a list. roster-read: the roster holds this
// census. page-read: the walk found this census's own page living.
//
// kernel-roster.bml speaks these as organ-health readings, and gives a slot
// only to the untracked kernels a caller names; kernel-pages.bml speaks the
// pages.
//
// The reads are a moment apart, so a kernel that starts or ends between them
// can show in one list and not the other; rce-settled takes the census twice
// and keeps only what both reads agree on.
//
// preludes: form/form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class RosterCensus {
        def rce-pids(rows) = if nil?(rows) then list() else cons(head(head(rows)), rce-pids(tail(rows)));
        def rce-in?(x, xs) = if nil?(xs) then 0 else if eq(head(xs), x) then 1 else rce-in?(x, tail(xs));
        def rce-minus(xs, ys) = if nil?(xs) then list() else if eq(rce-in?(head(xs), ys), 1) then rce-minus(tail(xs), ys) else cons(head(xs), rce-minus(tail(xs), ys));
        def rce-both(xs, ys) = if nil?(xs) then list() else if eq(rce-in?(head(xs), ys), 1) then cons(head(xs), rce-both(tail(xs), ys)) else rce-both(tail(xs), ys);
        // every pid of xs, then the ones of ys that xs lacks
        def rce-union(xs, ys) = append(xs, rce-minus(ys, xs));
        // 1 when both are 1
        def rce-all(x, y) = if eq(x, 1) then rce-one(y) else 0;
        def rce-one(y) = if eq(y, 1) then 1 else 0;
        def rce-roster() = kernel_live_pids();
        // the name read: a row with figures for each process whose name begins with fkwu, a pid alone for one the host
        // would not name, and -1 when the host would not list its processes. rce-fkwu-named? is the same rule over a
        // binary's last path segment (fkwu-20260911 is a kernel's name, fk is not).
        def rce-name-rows() = host_processes("fkwu*");
        def rce-listed?(rows) = if eq(rows, sub(0, 1)) then 0 else 1;
        def rce-rows-long(rows, keep) = if nil?(rows) then list() else if eq(rce-one(if gt(len(head(rows)), 1) then 1 else 0), keep) then cons(head(head(rows)), rce-rows-long(tail(rows), keep)) else rce-rows-long(tail(rows), keep);
        def rce-named(rows) = if eq(rce-listed?(rows), 0) then list() else rce-rows-long(rows, 1);
        def rce-unnamed(rows) = if eq(rce-listed?(rows), 0) then list() else rce-rows-long(rows, 0);
        def rce-fkwu-named?(name) = if lt(str_len(name), 4) then 0 else if str_eq(substring(name, 0, 4), "fkwu") then 1 else 0;
        // the page walk: every pid's page name asked once, kept as (ended standing withheld). Pids run below pid_max on
        // Linux and below 100000 on macOS, where no such file stands, walked in blocks of 100 so no walk recurses deeper
        // than a block. A page a kernel left standing is read here and never unlinked: Urs asked to be asked first, so
        // burial is an explicit kernel_page_bury pid, one pid at a time.
        def rce-pid-bound-of(n) = if gt(n, 0) then n else 100000;
        def rce-pid-bound-read(text) = if nothing?(text) then 100000 else rce-pid-bound-of(str_to_int(text));
        def rce-pid-bound() = rce-pid-bound-read(read_file("/proc/sys/kernel/pid_max"));
        def rce-page-keep(pid, s, acc) = if eq(s, 0) then acc else if eq(s, 1) then list(cons(pid, nth(acc, 0)), nth(acc, 1), nth(acc, 2)) else if eq(s, 2) then list(nth(acc, 0), cons(pid, nth(acc, 1)), nth(acc, 2)) else list(nth(acc, 0), nth(acc, 1), cons(pid, nth(acc, 2)));
        def rce-page-span(pid, hi, acc) = if ge(pid, hi) then acc else rce-page-span(add(pid, 1), hi, rce-page-keep(pid, kernel_page_ended(pid), acc));
        def rce-pages-from(lo, bound, acc) = if ge(lo, bound) then acc else rce-pages-from(add(lo, 100), bound, rce-page-span(lo, add(lo, 100), acc));
        def rce-pages() = rce-pages-from(1, rce-pid-bound(), list(list(), list(), list()));
        // the pids whose kernel has ended with its page standing, read and never unlinked
        def rce-ended() = nth(rce-pages(), 0);
        // the pids of xs whose process stands (a 1) or has left (a 0)
        def rce-alive-is(xs, a) = if nil?(xs) then list() else if eq(rce-one(host_alive(head(xs))), a) then cons(head(xs), rce-alive-is(tail(xs), a)) else rce-alive-is(tail(xs), a);
        // a page's words (kernel_live) and its process's row (host_process: pid ppid exe cwd argv start-ms withheld) say
        // whether a kernel lives there: 1 the page names the pid, says alive (word 19) and was opened (word 2) as or
        // after the process started; 0 no kernel lives there (the process has left, or the page is not its own); -1
        // the host would not tell when the process started
        def rce-row-start(row) = if lt(len(row), 6) then 0 else nth(row, 5);
        def rce-row-withheld(row) = if lt(len(row), 7) then 0 else nth(row, 6);
        def rce-page-names?(pid, page) = if lt(len(page), 20) then 0 else if eq(nth(page, 1), pid) then rce-one(nth(page, 19)) else 0;
        def rce-living-at(pid, page, row) = if eq(row, sub(0, 1)) then 0 else if eq(rce-page-names?(pid, page), 0) then 0 else if le(rce-row-start(row), 0) then sub(0, 1) else if ge(nth(page, 2), rce-row-start(row)) then 1 else 0;
        // the standing pages sorted as (living start-unread), living as (pid row) pairs
        def rce-sort-standing(pids) = if nil?(pids) then list(list(), list()) else rce-sort-one(head(pids), host_process(head(pids)), rce-sort-standing(tail(pids)));
        def rce-sort-one(pid, row, rest) = rce-sort-with(pid, row, rce-living-at(pid, kernel_live(pid), row), rest);
        def rce-sort-with(pid, row, st, rest) = if eq(st, 1) then list(cons(list(pid, row), nth(rest, 0)), nth(rest, 1)) else if eq(st, 0) then rest else list(nth(rest, 0), cons(pid, nth(rest, 1)));
        // what each kernel runs and for whom. The cell is the first word after the binary that is not a flag: fkwu runs
        // argv[1] and reads a word after it as a number (./fkwu CELL N), and --src comes before the cell. The owner is
        // the first ancestor that is neither a kernel, a shell nor login, named by its binary's last path segment;
        // ("launchd" 1) when the chain ends at pid 1, ("gone" pid) when an ancestor ended while it was being read,
        // ("unread" 0) when the host would not say an ancestor's parent — never read as pid 1 —, ("withheld" pid) when
        // it withheld an ancestor's binary, and ("unwalked" pid) past 32 ancestors. The kernel-parent is the first kernel
        // the walk passed, 0 when it passed none. A kernel is an ancestor whose page the census found living — a pageless
        // process named fkwu is no kernel, and the walk stops at it as an owner; a shell is one this host lists in
        // /etc/shells, or one of the common ones, or login.
        def rce-slash-at(s, i, at) = if ge(i, str_len(s)) then at else if eq(str_byte_at(s, i), 47) then rce-slash-at(s, add(i, 1), i) else rce-slash-at(s, add(i, 1), at);
        def rce-base(s) = substring(s, add(rce-slash-at(s, 0, sub(0, 1)), 1), str_len(s));
        def rce-str-in?(s, xs) = if nil?(xs) then 0 else if str_eq(head(xs), s) then 1 else rce-str-in?(s, tail(xs));
        def rce-shell-floor() = list("sh", "bash", "zsh", "dash", "ksh", "tcsh", "csh", "login");
        def rce-shell-line?(line) = if eq(str_len(line), 0) then 0 else if eq(str_byte_at(line, 0), 47) then 1 else 0;
        def rce-shell-lines(lines) = if nil?(lines) then list() else if eq(rce-shell-line?(head(lines)), 1) then cons(rce-base(head(lines)), rce-shell-lines(tail(lines))) else rce-shell-lines(tail(lines));
        // the lines of a text, split at each newline (byte 10)
        def rce-lines-from(s, i, at) = if ge(i, str_len(s)) then rce-last-line(s, at, i) else if eq(str_byte_at(s, i), 10) then cons(substring(s, at, i), rce-lines-from(s, add(i, 1), add(i, 1))) else rce-lines-from(s, add(i, 1), at);
        def rce-last-line(s, at, i) = if gt(i, at) then list(substring(s, at, i)) else list();
        def rce-shells-of(text) = if nothing?(text) then rce-shell-floor() else append(rce-shell-floor(), rce-shell-lines(rce-lines-from(text, 0, 0)));
        def rce-shells() = rce-shells-of(read_file("/etc/shells"));
        // env: (shells living), living the pids whose page the census found living, or -1 when no page walk was taken
        // (rce-kernel-of): then each ancestor's own page is asked as the walk asks it. 1 a kernel lives there, 0 none
        // does, -1 the host would not show the page or tell when its process started
        def rce-living-page(pid, row, st) = if eq(st, 2) then rce-living-at(pid, kernel_live(pid), row) else if lt(st, 0) then sub(0, 1) else 0;
        def rce-kernel-at?(pid, row, env) = if eq(nth(env, 1), sub(0, 1)) then rce-living-page(pid, row, kernel_page_ended(pid)) else rce-in?(pid, nth(env, 1));
        // an ancestor whose binary the host withheld: an empty binary beside a withheld field (a removed binary is empty
        // with nothing withheld)
        def rce-exe-withheld?(row) = if gt(str_len(nth(row, 2)), 0) then 0 else if gt(rce-row-withheld(row), 0) then 1 else 0;
        def rce-walk-depth() = 32;
        def rce-owner-of(ppid, depth, kp, env) = if eq(ppid, 1) then list("launchd", 1, kp) else if le(ppid, 0) then list("unread", 0, kp) else if le(depth, 0) then list("unwalked", ppid, kp) else rce-owner-at(host_process(ppid), ppid, depth, kp, env);
        def rce-owner-at(row, ppid, depth, kp, env) = if eq(row, sub(0, 1)) then list("gone", ppid, kp) else if eq(rce-exe-withheld?(row), 1) then list("withheld", ppid, kp) else rce-owner-past(row, ppid, depth, kp, env, rce-kernel-at?(ppid, row, env));
        // k: whether a kernel lives at this ancestor. A kernel is walked past, the first one kept as the kernel-parent;
        // one the host would not show reads withheld; a shell is walked past; anything else is the owner
        def rce-owner-past(row, ppid, depth, kp, env, k) = if eq(k, 1) then rce-owner-of(nth(row, 1), sub(depth, 1), if gt(kp, 0) then kp else ppid, env) else if lt(k, 0) then list("withheld", ppid, kp) else if eq(rce-str-in?(rce-base(nth(row, 2)), nth(env, 0)), 1) then rce-owner-of(nth(row, 1), sub(depth, 1), kp, env) else list(rce-base(nth(row, 2)), ppid, kp);
        // a word that is empty or begins with "-" is a flag, not the cell
        def rce-flag?(w) = if eq(str_len(w), 0) then 1 else if eq(str_byte_at(w, 0), 45) then 1 else 0;
        def rce-cell-in(words) = if nil?(words) then "" else if eq(rce-flag?(head(words)), 1) then rce-cell-in(tail(words)) else head(words);
        def rce-cell(argv) = if nil?(argv) then "" else rce-cell-in(tail(argv));
        // (pid cell cwd exe owner owner-pid kernel-parent withheld), or an empty list when the pid has ended
        def rce-kernel-of(row) = rce-kernel-with(row, list(rce-shells(), sub(0, 1)));
        def rce-kernel-with(row, env) = if eq(row, sub(0, 1)) then list() else rce-kernel-row(row, rce-owner-of(nth(row, 1), rce-walk-depth(), 0, env));
        def rce-kernel-row(row, owner) = list(nth(row, 0), rce-cell(nth(row, 4)), nth(row, 3), nth(row, 2), nth(owner, 0), nth(owner, 1), nth(owner, 2), rce-row-withheld(row));
        def rce-kernels-keep(k, rest) = if nil?(k) then rest else cons(k, rest);
        def rce-kernels-of(pairs, env) = if nil?(pairs) then list() else rce-kernels-keep(rce-kernel-with(nth(head(pairs), 1), env), rce-kernels-of(tail(pairs), env));
        // one rule for a kernel's line and its readings. An orphan is a kernel whose owner walk ends at launchd. A walk
        // that stopped short (unread, gone, withheld, an ancestor with no binary, unwalked) has not seen whether it does.
        // A row the host withheld, or a walk it withheld, is unread. An errand is a row the host told short: no cell, no
        // binary, or a walk that ended unread, gone or at an ancestor with no binary. Unwalked is the census's own bound,
        // and the kernel's line says it.
        def rce-owner-short?(owner) = if eq(str_len(owner), 0) then 1 else if str_eq(owner, "unread") then 1 else if str_eq(owner, "gone") then 1 else if str_eq(owner, "unwalked") then 1 else if str_eq(owner, "withheld") then 1 else 0;
        def rce-row-unread?(k) = if gt(nth(k, 7), 0) then 1 else if str_eq(nth(k, 4), "withheld") then 1 else 0;
        def rce-errand?(k) = if eq(rce-row-unread?(k), 1) then 0 else if eq(str_len(nth(k, 1)), 0) then 1 else if eq(str_len(nth(k, 3)), 0) then 1 else if str_eq(nth(k, 4), "unwalked") then 0 else rce-owner-short?(nth(k, 4));
        def rce-orphans(ks) = if nil?(ks) then list() else if str_eq(nth(head(ks), 4), "launchd") then cons(head(head(ks)), rce-orphans(tail(ks))) else rce-orphans(tail(ks));
        def rce-short(ks) = if nil?(ks) then list() else if eq(rce-owner-short?(nth(head(ks), 4)), 1) then cons(head(head(ks)), rce-short(tail(ks))) else rce-short(tail(ks));
        def rce-errands(ks) = if nil?(ks) then list() else if eq(rce-errand?(head(ks)), 1) then cons(head(head(ks)), rce-errands(tail(ks))) else rce-errands(tail(ks));
        def rce-unread-rows(ks) = if nil?(ks) then list() else if eq(rce-row-unread?(head(ks)), 1) then cons(head(head(ks)), rce-unread-rows(tail(ks))) else rce-unread-rows(tail(ks));
        // cells more than one kernel runs, as (cell n). A kernel whose words cannot be read has no cell and no twin,
        // and a kernel whose kernel-parent runs the same cell is its worker, not its twin.
        def rce-cell-at(pid, ks) = if nil?(ks) then "" else if eq(head(head(ks)), pid) then nth(head(ks), 1) else rce-cell-at(pid, tail(ks));
        def rce-worker?(k, all) = if le(nth(k, 6), 0) then 0 else if str_eq(rce-cell-at(nth(k, 6), all), nth(k, 1)) then 1 else 0;
        def rce-cell-count(cell, ks, all) = if nil?(ks) then 0 else if str_eq(nth(head(ks), 1), cell) then add(sub(1, rce-worker?(head(ks), all)), rce-cell-count(cell, tail(ks), all)) else rce-cell-count(cell, tail(ks), all);
        def rce-dups-walk(ks, all, seen) = if nil?(ks) then list() else rce-dups-step(nth(head(ks), 1), ks, all, seen);
        def rce-dups-step(cell, ks, all, seen) = if eq(str_len(cell), 0) then rce-dups-walk(tail(ks), all, seen) else if eq(rce-str-in?(cell, seen), 1) then rce-dups-walk(tail(ks), all, seen) else if gt(rce-cell-count(cell, all, all), 1) then cons(list(cell, rce-cell-count(cell, all, all)), rce-dups-walk(tail(ks), all, cons(cell, seen))) else rce-dups-walk(tail(ks), all, cons(cell, seen));
        def rce-duplicates(ks) = rce-dups-walk(ks, ks, list());
        // one read of each, as (named roster kernels unpaged unread-names unread-pages unread-rows host-read roster-read
        // page-read): kernels are the rows of the living pages, unpaged the named pids that are no living kernel and
        // whose page was read, unread-pages the withheld pages of living processes and the standing pages whose
        // process's start the host would not tell
        def rce-take() {
            let me = host_pid();
            let rows = rce-name-rows();
            let roster = rce-roster();
            let pages = rce-pages();
            let sorted = rce-sort-standing(nth(pages, 1));
            let living = rce-pids(nth(sorted, 0));
            let named = rce-named(rows);
            let blind = rce-union(rce-alive-is(nth(pages, 2), 1), nth(sorted, 1));
            let kernels = rce-kernels-of(nth(sorted, 0), list(rce-shells(), living));
            list(named, roster, kernels, rce-minus(rce-minus(named, living), blind), rce-unnamed(rows), blind, rce-unread-rows(kernels), rce-listed?(rows), rce-in?(me, roster), rce-in?(me, living));
        }
        def rce-take-untracked(t) = rce-minus(rce-pids(nth(t, 2)), nth(t, 1));
        def rce-take-stale(t) = rce-minus(rce-minus(nth(t, 1), rce-pids(nth(t, 2))), nth(t, 5));
        def rce-take-orphans(t) = rce-orphans(nth(t, 2));
        def rce-take-open(t) = rce-union(rce-short(nth(t, 2)), rce-orphans(nth(t, 2)));
        // taken twice, as (named roster kernels untracked stale orphans short errands unpaged unread-names unread-pages
        // unread-rows host-read roster-read page-read). What is untracked, stale, orphaned, on an errand or unpaged is
        // reported when both reads agree; the counts and kernel rows are the second read's. What either read could not
        // see is carried, and a read either take missed stays missed, so no reading claims what a take did not see. A
        // kernel is short when neither read saw it reach an owner that is not launchd and not both saw it reach launchd.
        def rce-settle(a, b) = list(nth(b, 0), nth(b, 1), nth(b, 2), rce-both(rce-take-untracked(a), rce-take-untracked(b)), rce-both(rce-take-stale(a), rce-take-stale(b)), rce-both(rce-take-orphans(a), rce-take-orphans(b)), rce-minus(rce-both(rce-take-open(a), rce-take-open(b)), rce-both(rce-take-orphans(a), rce-take-orphans(b))), rce-both(rce-errands(nth(a, 2)), rce-errands(nth(b, 2))), rce-both(nth(a, 3), nth(b, 3)), rce-union(nth(a, 4), nth(b, 4)), rce-union(nth(a, 5), nth(b, 5)), rce-union(nth(a, 6), nth(b, 6)), rce-all(nth(a, 7), nth(b, 7)), rce-all(nth(a, 8), nth(b, 8)), rce-all(nth(a, 9), nth(b, 9)));
        def rce-settled(wait-ms) {
            let a = rce-take();
            let rest = host_sleep_ms(wait-ms);
            let b = rce-take();
            rce-settle(a, b);
        }
        // a settled census, read by name
        def rce-s-named(s) = nth(s, 0);
        def rce-s-roster(s) = nth(s, 1);
        def rce-s-kernels(s) = nth(s, 2);
        def rce-s-untracked(s) = nth(s, 3);
        def rce-s-stale(s) = nth(s, 4);
        def rce-s-orphans(s) = nth(s, 5);
        def rce-s-short(s) = nth(s, 6);
        def rce-s-errands(s) = nth(s, 7);
        def rce-s-unpaged(s) = nth(s, 8);
        def rce-s-unread-names(s) = nth(s, 9);
        def rce-s-unread-pages(s) = nth(s, 10);
        def rce-s-unread-rows(s) = nth(s, 11);
        def rce-s-host-read(s) = nth(s, 12);
        def rce-s-roster-read(s) = nth(s, 13);
        def rce-s-page-read(s) = nth(s, 14);
    }
    0;
}
