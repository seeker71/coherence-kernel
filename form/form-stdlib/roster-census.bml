//////////////////////////////////////////////////////////////////////
//
// roster-census.bml — the body counts its kernels by the pages they open,
// and names the ones its roster cannot see.
//
// A kernel is a living process whose live page names it, says alive, and was
// opened as or after the process started: every kernel opens /fg-k<pid> as it
// starts (fk_nodes_init calls fk_live_open), whatever its binary is named. The
// census asks every pid's page name once (kernel_page_ended: 1 an ended
// kernel's page, 2 a page that stands and is not one, 0 none, -1 a page the
// host will not let it open), reads each page that stands (kernel_live) and the process under it
// (host_process: when it started, and which fields the host withheld). The
// roster is kernel_live_pids, every kernel holding a slot in /fg-kernels whose
// page says alive: what every organ that asks the roster sees. The host's name
// read, host_processes "fkwu*", names the processes that call themselves
// kernels. On 2026-09-11 Urs counted 14 fkwu processes while the roster named
// 11 — three living glass organs had never landed in it.
//
//   untracked  kernels the roster lacks: alive, and invisible to every organ
//              that asks the roster
//   stale      roster pids that are no living kernel: a page a kernel left on
//              a pid another process holds now
//   unpaged    processes named fkwu that are no living kernel: no page, or one
//              a kernel before them left
//   orphans    kernels whose owner walk ends at launchd: nobody waits for them
//              and nobody will stop them
//   errands    kernels whose row the host told, and told short: no cell, no
//              binary, or an owner walk that ends unread, gone or at an
//              ancestor with no binary
//   kernels    what each runs and for whom — (pid cell cwd exe owner owner-pid
//              kernel-parent withheld), read with host_process, no shell — and
//              the cells more than one kernel runs
//
// What a read did not see stays apart from what it saw. unread-names: the
// processes the name read could not name. unread-pages: pids whose page stands
// on a living process and could not be read, or whose process's start the host
// would not tell. unread-rows: kernels whose row, or an ancestor's binary on
// their owner walk, the host withheld (a withheld field, not an empty one).
// host-read: the name read answered a list. roster-read: the roster holds this
// census. page-read: the walk found this census's own page living.
//
// kernel-roster.bml speaks these as organ-health readings, and gives a slot
// only to the untracked kernels a caller names; kernel-pages.bml speaks the
// pages.
//
// The reads are a moment apart, so a kernel that starts or ends between them
// can show in one list and not the other; rce-settled takes the census twice
// and keeps only what both reads agree on.
//
// preludes: form/form-stdlib/core.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class RosterCensus {
        def rce-pids(rows) = nil?(rows) ? list() : cons(head(head(rows)), rce-pids(tail(rows)));
        def rce-in?(x, xs) = nil?(xs) ? 0 : (Comparable) head(xs) == x ? 1 : rce-in?(x, tail(xs));
        def rce-minus(xs, ys) = nil?(xs) ? list() : (Comparable) rce-in?(head(xs), ys) == 1 ? rce-minus(tail(xs), ys) : cons(head(xs), rce-minus(tail(xs), ys));
        def rce-both(xs, ys) = nil?(xs) ? list() : (Comparable) rce-in?(head(xs), ys) == 1 ? cons(head(xs), rce-both(tail(xs), ys)) : rce-both(tail(xs), ys);
        // every pid of xs, then the ones of ys that xs lacks
        def rce-union(xs, ys) = append(xs, rce-minus(ys, xs));
        // 1 when both are 1
        def rce-all(x, y) = (Comparable) x == 1 ? rce-one(y) : 0;
        def rce-one(y) = (Comparable) y == 1 ? 1 : 0;
        def rce-roster() = kernel_live_pids();
        // the name read: a row with figures for each process whose name begins with fkwu, a pid alone for one the host
        // would not name, and nothing when the host would not list its processes. rce-fkwu-named? is the same rule over a
        // binary's last path segment (fkwu-20260911 is a kernel's name, fk is not).
        def rce-name-rows() = host_processes("fkwu*");
        def rce-listed?(rows) = nothing?(rows) ? 0 : 1;
        def rce-rows-long(rows, keep) = nil?(rows) ? list() : (Comparable) rce-one(len(head(rows)) > 1 ? 1 : 0) == keep ? cons(head(head(rows)), rce-rows-long(tail(rows), keep)) : rce-rows-long(tail(rows), keep);
        def rce-named(rows) = (Comparable) rce-listed?(rows) == 0 ? list() : rce-rows-long(rows, 1);
        def rce-unnamed(rows) = (Comparable) rce-listed?(rows) == 0 ? list() : rce-rows-long(rows, 0);
        def rce-fkwu-named?(name) = str_len(name) < 4 ? 0 : (String) substring(name, 0, 4) == "fkwu" ? 1 : 0;
        // the page walk: every pid's page name asked once, kept as (ended standing withheld). Pids run below pid_max on
        // Linux and below 100000 on macOS, where no such file stands, walked in blocks of 100 so no walk recurses deeper
        // than a block. A page a kernel left standing is read here and never unlinked: Urs asked to be asked first, so
        // burial is an explicit kernel_page_bury pid, one pid at a time.
        def rce-pid-bound-of(n) = n > 0 ? n : 100000;
        def rce-pid-bound-read(text) = nothing?(text) ? 100000 : rce-pid-bound-of(str_to_int(text));
        def rce-pid-bound() = rce-pid-bound-read(read_file("/proc/sys/kernel/pid_max"));
        def rce-page-keep(pid, s, acc) = (Comparable) s == 0 ? acc : (Comparable) s == 1 ? list(cons(pid, acc[0]), acc[1], acc[2]) : (Comparable) s == 2 ? list(acc[0], cons(pid, acc[1]), acc[2]) : list(acc[0], acc[1], cons(pid, acc[2]));
        def rce-page-span(pid, hi, acc) = pid >= hi ? acc : rce-page-span(pid + 1, hi, rce-page-keep(pid, kernel_page_ended(pid), acc));
        def rce-pages-from(lo, bound, acc) = lo >= bound ? acc : rce-pages-from(lo + 100, bound, rce-page-span(lo, lo + 100, acc));
        def rce-pages() = rce-pages-from(1, rce-pid-bound(), list(list(), list(), list()));
        // the pids whose kernel has ended with its page standing, read and never unlinked
        def rce-ended() = rce-pages()[0];
        // the pids of xs whose process stands (a 1) or has left (a 0)
        def rce-alive-is(xs, a) = nil?(xs) ? list() : (Comparable) rce-one(host_alive(head(xs))) == a ? cons(head(xs), rce-alive-is(tail(xs), a)) : rce-alive-is(tail(xs), a);
        // a page's words (kernel_live) and its process's row (host_process: pid ppid exe cwd argv start-ms withheld) say
        // whether a kernel lives there: 1 the page names the pid, says alive (word 19) and was opened (word 2) as or
        // after the process started; 0 no kernel lives there (the process has left, or the page is not its own); -1
        // the host would not tell when the process started
        def rce-row-start(row) = len(row) < 6 ? 0 : row[5];
        def rce-row-withheld(row) = len(row) < 7 ? 0 : row[6];
        def rce-page-names?(pid, page) = len(page) < 20 ? 0 : (Comparable) page[1] == pid ? rce-one(page[19]) : 0;
        def rce-living-at(pid, page, row) = (Comparable) row == (0 - 1) ? 0 : (Comparable) rce-page-names?(pid, page) == 0 ? 0 : rce-row-start(row) <= 0 ? (0 - 1) : page[2] >= rce-row-start(row) ? 1 : 0;
        // the standing pages sorted as (living start-unread), living as (pid row) pairs
        def rce-sort-standing(pids) = nil?(pids) ? list(list(), list()) : rce-sort-one(head(pids), host_process(head(pids)), rce-sort-standing(tail(pids)));
        def rce-sort-one(pid, row, rest) = rce-sort-with(pid, row, rce-living-at(pid, kernel_live(pid), row), rest);
        def rce-sort-with(pid, row, st, rest) = (Comparable) st == 1 ? list(cons(list(pid, row), rest[0]), rest[1]) : (Comparable) st == 0 ? rest : list(rest[0], cons(pid, rest[1]));
        // what each kernel runs and for whom. The cell is the first word after the binary that is not a flag: fkwu runs
        // argv[1] and reads a word after it as a number (./fkwu CELL N), and --src comes before the cell. The owner is
        // the first ancestor that is neither a kernel, a shell nor login, named by its binary's last path segment;
        // ("launchd" 1) when the chain ends at pid 1, ("gone" pid) when an ancestor ended while it was being read,
        // ("unread" 0) when the host would not say an ancestor's parent — never read as pid 1 —, ("withheld" pid) when
        // it withheld an ancestor's binary, and ("unwalked" pid) past 32 ancestors. The kernel-parent is the first kernel
        // the walk passed, 0 when it passed none. A kernel is an ancestor whose page the census found living — a pageless
        // process named fkwu is no kernel, and the walk stops at it as an owner; a shell is one this host lists in
        // /etc/shells, or one of the common ones, or login.
        def rce-slash-at(s, i, at) = i >= str_len(s) ? at : (Comparable) str_byte_at(s, i) == 47 ? rce-slash-at(s, i + 1, i) : rce-slash-at(s, i + 1, at);
        def rce-base(s) = substring(s, rce-slash-at(s, 0, 0 - 1) + 1, str_len(s));
        def rce-str-in?(s, xs) = nil?(xs) ? 0 : (String) head(xs) == s ? 1 : rce-str-in?(s, tail(xs));
        def rce-shell-floor() = list("sh", "bash", "zsh", "dash", "ksh", "tcsh", "csh", "login");
        def rce-shell-line?(line) = (Comparable) str_len(line) == 0 ? 0 : (Comparable) str_byte_at(line, 0) == 47 ? 1 : 0;
        def rce-shell-lines(lines) = nil?(lines) ? list() : (Comparable) rce-shell-line?(head(lines)) == 1 ? cons(rce-base(head(lines)), rce-shell-lines(tail(lines))) : rce-shell-lines(tail(lines));
        // the lines of a text, split at each newline (byte 10)
        def rce-lines-from(s, i, at) = i >= str_len(s) ? rce-last-line(s, at, i) : (Comparable) str_byte_at(s, i) == 10 ? cons(substring(s, at, i), rce-lines-from(s, i + 1, i + 1)) : rce-lines-from(s, i + 1, at);
        def rce-last-line(s, at, i) = i > at ? list(substring(s, at, i)) : list();
        def rce-shells-of(text) = nothing?(text) ? rce-shell-floor() : append(rce-shell-floor(), rce-shell-lines(rce-lines-from(text, 0, 0)));
        def rce-shells() = rce-shells-of(read_file("/etc/shells"));
        // env: (shells living), living the pids whose page the census found living, or -1 when no page walk was taken
        // (rce-kernel-of): then each ancestor's own page is asked as the walk asks it. 1 a kernel lives there, 0 none
        // does, -1 the host would not show the page or tell when its process started
        def rce-living-page(pid, row, st) = (Comparable) st == 2 ? rce-living-at(pid, kernel_live(pid), row) : st < 0 ? (0 - 1) : 0;
        def rce-kernel-at?(pid, row, env) = (Comparable) env[1] == (0 - 1) ? rce-living-page(pid, row, kernel_page_ended(pid)) : rce-in?(pid, env[1]);
        // an ancestor whose binary the host withheld: an empty binary beside a withheld field (a removed binary is empty
        // with nothing withheld)
        def rce-exe-withheld?(row) = str_len(row[2]) > 0 ? 0 : rce-row-withheld(row) > 0 ? 1 : 0;
        def rce-walk-depth() = 32;
        def rce-owner-of(ppid, depth, kp, env) = (Comparable) ppid == 1 ? list("launchd", 1, kp) : ppid <= 0 ? list("unread", 0, kp) : depth <= 0 ? list("unwalked", ppid, kp) : rce-owner-at(host_process(ppid), ppid, depth, kp, env);
        def rce-owner-at(row, ppid, depth, kp, env) = (Comparable) row == (0 - 1) ? list("gone", ppid, kp) : (Comparable) rce-exe-withheld?(row) == 1 ? list("withheld", ppid, kp) : rce-owner-past(row, ppid, depth, kp, env, rce-kernel-at?(ppid, row, env));
        // k: whether a kernel lives at this ancestor. A kernel is walked past, the first one kept as the kernel-parent;
        // one the host would not show reads withheld; a shell is walked past; anything else is the owner
        def rce-owner-past(row, ppid, depth, kp, env, k) = (Comparable) k == 1 ? rce-owner-of(row[1], depth - 1, kp > 0 ? kp : ppid, env) : k < 0 ? list("withheld", ppid, kp) : (Comparable) rce-str-in?(rce-base(row[2]), env[0]) == 1 ? rce-owner-of(row[1], depth - 1, kp, env) : list(rce-base(row[2]), ppid, kp);
        // a word that is empty or begins with "-" is a flag, not the cell
        def rce-flag?(w) = (Comparable) str_len(w) == 0 ? 1 : (Comparable) str_byte_at(w, 0) == 45 ? 1 : 0;
        def rce-cell-in(words) = nil?(words) ? "" : (Comparable) rce-flag?(head(words)) == 1 ? rce-cell-in(tail(words)) : head(words);
        def rce-cell(argv) = nil?(argv) ? "" : rce-cell-in(tail(argv));
        // (pid cell cwd exe owner owner-pid kernel-parent withheld), or an empty list when the pid has ended
        def rce-kernel-of(row) = rce-kernel-with(row, list(rce-shells(), 0 - 1));
        def rce-kernel-with(row, env) = (Comparable) row == (0 - 1) ? list() : rce-kernel-row(row, rce-owner-of(row[1], rce-walk-depth(), 0, env));
        def rce-kernel-row(row, owner) = list(row[0], rce-cell(row[4]), row[3], row[2], owner[0], owner[1], owner[2], rce-row-withheld(row));
        def rce-kernels-keep(k, rest) = nil?(k) ? rest : cons(k, rest);
        def rce-kernels-of(pairs, env) = nil?(pairs) ? list() : rce-kernels-keep(rce-kernel-with(head(pairs)[1], env), rce-kernels-of(tail(pairs), env));
        // one rule for a kernel's line and its readings. An orphan is a kernel whose owner walk ends at launchd. A walk
        // that stopped short (unread, gone, withheld, an ancestor with no binary, unwalked) has not seen whether it does.
        // A row the host withheld, or a walk it withheld, is unread. An errand is a row the host told short: no cell, no
        // binary, or a walk that ended unread, gone or at an ancestor with no binary. Unwalked is the census's own bound,
        // and the kernel's line says it.
        def rce-owner-short?(owner) = (Comparable) str_len(owner) == 0 ? 1 : (String) owner == "unread" ? 1 : (String) owner == "gone" ? 1 : (String) owner == "unwalked" ? 1 : (String) owner == "withheld" ? 1 : 0;
        def rce-row-unread?(k) = k[7] > 0 ? 1 : (String) k[4] == "withheld" ? 1 : 0;
        def rce-errand?(k) = (Comparable) rce-row-unread?(k) == 1 ? 0 : (Comparable) str_len(k[1]) == 0 ? 1 : (Comparable) str_len(k[3]) == 0 ? 1 : (String) k[4] == "unwalked" ? 0 : rce-owner-short?(k[4]);
        def rce-orphans(ks) = nil?(ks) ? list() : (String) head(ks)[4] == "launchd" ? cons(head(head(ks)), rce-orphans(tail(ks))) : rce-orphans(tail(ks));
        def rce-short(ks) = nil?(ks) ? list() : (Comparable) rce-owner-short?(head(ks)[4]) == 1 ? cons(head(head(ks)), rce-short(tail(ks))) : rce-short(tail(ks));
        def rce-errands(ks) = nil?(ks) ? list() : (Comparable) rce-errand?(head(ks)) == 1 ? cons(head(head(ks)), rce-errands(tail(ks))) : rce-errands(tail(ks));
        def rce-unread-rows(ks) = nil?(ks) ? list() : (Comparable) rce-row-unread?(head(ks)) == 1 ? cons(head(head(ks)), rce-unread-rows(tail(ks))) : rce-unread-rows(tail(ks));
        // cells more than one kernel runs, as (cell n). A kernel whose words cannot be read has no cell and no twin,
        // and a kernel whose kernel-parent runs the same cell is its worker, not its twin.
        def rce-cell-at(pid, ks) = nil?(ks) ? "" : (Comparable) head(head(ks)) == pid ? head(ks)[1] : rce-cell-at(pid, tail(ks));
        def rce-worker?(k, all) = k[6] <= 0 ? 0 : (String) rce-cell-at(k[6], all) == k[1] ? 1 : 0;
        def rce-cell-count(cell, ks, all) = nil?(ks) ? 0 : (String) head(ks)[1] == cell ? ((1 - rce-worker?(head(ks), all)) + rce-cell-count(cell, tail(ks), all)) : rce-cell-count(cell, tail(ks), all);
        def rce-dups-walk(ks, all, seen) = nil?(ks) ? list() : rce-dups-step(head(ks)[1], ks, all, seen);
        def rce-dups-step(cell, ks, all, seen) = (Comparable) str_len(cell) == 0 ? rce-dups-walk(tail(ks), all, seen) : (Comparable) rce-str-in?(cell, seen) == 1 ? rce-dups-walk(tail(ks), all, seen) : rce-cell-count(cell, all, all) > 1 ? cons(list(cell, rce-cell-count(cell, all, all)), rce-dups-walk(tail(ks), all, cons(cell, seen))) : rce-dups-walk(tail(ks), all, cons(cell, seen));
        def rce-duplicates(ks) = rce-dups-walk(ks, ks, list());
        // one read of each, as (named roster kernels unpaged unread-names unread-pages unread-rows host-read roster-read
        // page-read): kernels are the rows of the living pages, unpaged the named pids that are no living kernel and
        // whose page was read, unread-pages the withheld pages of living processes and the standing pages whose
        // process's start the host would not tell
        def rce-take() {
            let me = host_pid();
            let rows = rce-name-rows();
            let roster = rce-roster();
            let pages = rce-pages();
            let sorted = rce-sort-standing(pages[1]);
            let living = rce-pids(sorted[0]);
            let named = rce-named(rows);
            let blind = rce-union(rce-alive-is(pages[2], 1), sorted[1]);
            let kernels = rce-kernels-of(sorted[0], list(rce-shells(), living));
            list(named, roster, kernels, rce-minus(rce-minus(named, living), blind), rce-unnamed(rows), blind, rce-unread-rows(kernels), rce-listed?(rows), rce-in?(me, roster), rce-in?(me, living));
        }
        def rce-take-untracked(t) = rce-minus(rce-pids(t[2]), t[1]);
        def rce-take-stale(t) = rce-minus(rce-minus(t[1], rce-pids(t[2])), t[5]);
        def rce-take-orphans(t) = rce-orphans(t[2]);
        def rce-take-open(t) = rce-union(rce-short(t[2]), rce-orphans(t[2]));
        // taken twice, as (named roster kernels untracked stale orphans short errands unpaged unread-names unread-pages
        // unread-rows host-read roster-read page-read). What is untracked, stale, orphaned, on an errand or unpaged is
        // reported when both reads agree; the counts and kernel rows are the second read's. What either read could not
        // see is carried, and a read either take missed stays missed, so no reading claims what a take did not see. A
        // kernel is short when neither read saw it reach an owner that is not launchd and not both saw it reach launchd.
        def rce-settle(a, b) = list(b[0], b[1], b[2], rce-both(rce-take-untracked(a), rce-take-untracked(b)), rce-both(rce-take-stale(a), rce-take-stale(b)), rce-both(rce-take-orphans(a), rce-take-orphans(b)), rce-minus(rce-both(rce-take-open(a), rce-take-open(b)), rce-both(rce-take-orphans(a), rce-take-orphans(b))), rce-both(rce-errands(a[2]), rce-errands(b[2])), rce-both(a[3], b[3]), rce-union(a[4], b[4]), rce-union(a[5], b[5]), rce-union(a[6], b[6]), rce-all(a[7], b[7]), rce-all(a[8], b[8]), rce-all(a[9], b[9]));
        def rce-settled(wait-ms) {
            let a = rce-take();
            let rest = host_sleep_ms(wait-ms);
            let b = rce-take();
            rce-settle(a, b);
        }
        // a settled census, read by name
        def rce-s-named(s) = s[0];
        def rce-s-roster(s) = s[1];
        def rce-s-kernels(s) = s[2];
        def rce-s-untracked(s) = s[3];
        def rce-s-stale(s) = s[4];
        def rce-s-orphans(s) = s[5];
        def rce-s-short(s) = s[6];
        def rce-s-errands(s) = s[7];
        def rce-s-unpaged(s) = s[8];
        def rce-s-unread-names(s) = s[9];
        def rce-s-unread-pages(s) = s[10];
        def rce-s-unread-rows(s) = s[11];
        def rce-s-host-read(s) = s[12];
        def rce-s-roster-read(s) = s[13];
        def rce-s-page-read(s) = s[14];
    }
    0;
}
