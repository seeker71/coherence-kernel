// form-recipe-exec-token.fk — bounded streamed NodeID recipe requests and
// typed lifecycle observations, before any native execution carrier is joined.
//
// THE HONEST SEAM. A decoded stream may offer this exact surface:
//
//   <|form:recipe-exec|>@p.l.t.i;input=N;carrier=auto<|/form:recipe-exec|>
//
// The surface does not execute anything. Form accepts one complete bounded
// envelope, reconstructs the four-coordinate NodeID with make_nodeid, and
// compares that reconstruction with the registered content-addressed recipe.
// Only then does it intern a request TOKEN. Ordinary prose, partial/nested
// envelopes, trailing bytes, non-canonical integers, unknown NodeIDs and extra
// fields become `nothing` without an execution offer.
//
// This cell is the pure state seam only. Carrier observations are supplied as
// typed testable data; model-executed, native-executed and native-code-generated
// remain 0. `choice`, `cut`, `undo`, `refine`, `crystallize`, `dissolve`, and
// `release` below are content-addressed lifecycle observations, not claims that
// Metal/CPU work occurred. A later live cell may bind the same request and
// observation shapes to those carriers without changing their identities.
//
// DISTINCT SIGNALS. `nothing` has value-present=0. Successful integer 0 and 1
// both have status=value and value-present=1. failure and timeout remain named
// outcomes when no later choice succeeds. During fallback, failure adds undo +
// refine; timeout adds cut + undo + refine; nothing simply leaves room for the
// next choice. A successful value crystallizes the selected observation, then
// dissolves unselected alternatives and releases the bounded reducer context.
//
// PRIVACY. Rendering contains NodeIDs, bounded status names, carrier choice,
// counters and value presence. It never reproduces the request surface or any
// model/private payload.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
//
// Proven by: form-stdlib/tests/form-recipe-exec-token-band.fk
section [form.bml] {
    // ── stream grammar and resource bounds ───────────────────────────
    def frex-open() = "<|form:recipe-exec|>";
    def frex-close() = "<|/form:recipe-exec|>";
    def frex-observation-open() = "<|form:recipe-observation|>";
    def frex-observation-close() = "<|/form:recipe-observation|>";
    def frex-max-payload-bytes() = 128;
    def frex-max-input-bytes() = 12;
    def frex-max-attempts() = 4;
    def frex-max-render-bytes() = 1024;
    def frex-max-frame-bytes() = str_len(frex-open()) + (frex-max-payload-bytes() + str_len(frex-close()));
    // ── content-addressed identities ─────────────────────────────────
    // Category slots separate token families. Composition supplies identity.
    def frex-recipe-category() = make_nodeid(31, 2, 0, 56);
    def frex-request-category() = make_nodeid(31, 2, 0, 57);
    def frex-offer-category() = make_nodeid(31, 2, 0, 58);
    def frex-event-category() = make_nodeid(31, 2, 0, 59);
    def frex-observation-category() = make_nodeid(31, 2, 0, 60);
    def frex-absent-category() = make_nodeid(31, 2, 0, 61);
    def frex-absent-token() = intern_node(frex-absent-category(), list(intern_trivial_string("nothing")));
    // One direct recipe. Its children say what this protocol example means and
    // keep its schema/lifecycle version in identity.
    // This file does not evaluate the recipe.
    def frex-recipe() = intern_node(frex-recipe-category(), list(intern_trivial_string("affine-scalar-v1"), intern_trivial_int(3), intern_trivial_int(7), intern_trivial_string("signed-int"), intern_trivial_string("signed-int"), intern_trivial_string("recipe-exec-lifecycle-v1")));
    def frex-recipe-valid?(node) = nothing?(node) ? 0 : !node_eq(node, frex-recipe()) ? 0 : !node_eq(node_category(node), frex-recipe-category()) ? 0 : (Comparable) len(node_children(node)) == 6 ? 1 : 0;
    def frex-node-key(node) = str_concat(int_to_str(node_pkg(node)), str_concat(".", str_concat(int_to_str(node_level(node)), str_concat(".", str_concat(int_to_str(node_type(node)), str_concat(".", int_to_str(node_inst(node))))))));
    def frex-node-coordinate(node) = str_concat("@", frex-node-key(node));
    // Strict canonical @p.l.t.i reader. It walks raw bytes and reconstructs the
    // NodeID; it does not tokenize the surrounding stream.
    def frex-digit?(s, at) = {
        let b = str_byte_at(s, at);
        b >= 48 && b <= 57 ? 1 : 0;
    };
    def frex-digits?(s, at, end) = at >= end ? 1 : (Comparable) frex-digit?(s, at) == 1 ? frex-digits?(s, at + 1, end) : 0;
    def frex-coordinate-parts(text) = {
        let n = str_len(text);
        let d1 = str_find(text, ".", 1);
        let d2 = d1 < 0 ? -1 : str_find(text, ".", d1 + 1);
        let d3 = d2 < 0 ? -1 : str_find(text, ".", d2 + 1);
        let d4 = d3 < 0 ? -1 : str_find(text, ".", d3 + 1);
        n < 8 || (!((String) substring(text, 0, 1) == "@") || (d1 < 2 || (d2 < d1 + 2 || (d3 < d2 + 2 || (!(d3 < n - 1) || !(d4 < 0)))))) ? nothing() : {
            let p = substring(text, 1, d1);
            let l = substring(text, d1 + 1, d2);
            let t = substring(text, d2 + 1, d3);
            let i = substring(text, d3 + 1, n);
            (Comparable) frex-digits?(text, 1, d1) == 1 && ((Comparable) frex-digits?(text, d1 + 1, d2) == 1 && ((Comparable) frex-digits?(text, d2 + 1, d3) == 1 && (Comparable) frex-digits?(text, d3 + 1, n) == 1)) ? (String) p == int_to_str(str_to_int(p)) && ((String) l == int_to_str(str_to_int(l)) && ((String) t == int_to_str(str_to_int(t)) && (String) i == int_to_str(str_to_int(i)))) ? list(str_to_int(p), str_to_int(l), str_to_int(t), str_to_int(i)) : nothing() : nothing();
        };
    };
    def frex-node-from-coordinate(text) = {
        let parts = frex-coordinate-parts(text);
        nothing?(parts) ? nothing() : {
            let node = make_nodeid(nth(parts, 0), nth(parts, 1), nth(parts, 2), nth(parts, 3));
            (String) frex-node-coordinate(node) == text ? node : nothing();
        };
    };
    // On fkwu, make_nodeid reconstructs the four visible coordinate fields but
    // does not turn that coordinate into the already-interned node object:
    // node_eq may therefore be 0 even when all four fields agree. Resolution is
    // explicit through this one-recipe registry. The request reconstructs first,
    // compares every coordinate field, and only then receives the registered
    // content-addressed recipe node used in request identity.
    def frex-node-coordinate-eq?(a, b) = (Comparable) node_pkg(a) == node_pkg(b) && ((Comparable) node_level(a) == node_level(b) && ((Comparable) node_type(a) == node_type(b) && (Comparable) node_inst(a) == node_inst(b))) ? 1 : 0;
    def frex-recipe-from-coordinate(text) = {
        let reconstructed = frex-node-from-coordinate(text);
        nothing?(reconstructed) ? nothing() : (Comparable) frex-node-coordinate-eq?(reconstructed, frex-recipe()) == 1 ? frex-recipe() : nothing();
    };
    // ── request token and strict surface parser ──────────────────────
    // request = (state reason recipe input carrier token)
    def frex-request(state, reason, recipe, input, carrier, token) = list(state, reason, recipe, input, carrier, token);
    def frex-request-state(r) = nth(r, 0);
    def frex-request-reason(r) = nth(r, 1);
    def frex-request-recipe(r) = nth(r, 2);
    def frex-request-input(r) = nth(r, 3);
    def frex-request-carrier(r) = nth(r, 4);
    def frex-request-token(r) = nth(r, 5);
    def frex-request-ready?(r) = (String) frex-request-state(r) == "ready" ? 1 : 0;
    def frex-nothing-request(reason) = frex-request("nothing", reason, nothing(), 0, "", nothing());
    def frex-carrier?(carrier) = (String) carrier == "auto" || ((String) carrier == "metal" || (String) carrier == "cpu") ? 1 : 0;
    def frex-input-text?(text) = (Comparable) str_len(text) == 0 || str_len(text) > frex-max-input-bytes() ? 0 : (String) text == int_to_str(str_to_int(text)) ? 1 : 0;
    def frex-request-node(recipe, input, carrier) = intern_node(frex-request-category(), list(recipe, intern_trivial_int(input), intern_trivial_string(carrier), intern_trivial_int(frex-max-attempts())));
    def frex-request-node-valid?(token) = nothing?(token) ? 0 : !node_eq(node_category(token), frex-request-category()) ? 0 : !((Comparable) len(node_children(token)) == 4) ? 0 : !((Comparable) frex-recipe-valid?(nth(node_children(token), 0)) == 1) ? 0 : !((Comparable) frex-carrier?(node_value(nth(node_children(token), 2))) == 1) ? 0 : (Comparable) node_value(nth(node_children(token), 3)) == frex-max-attempts() ? 1 : 0;
    def frex-parse-payload(payload) = {
        let n = str_len(payload);
        let s1 = str_find(payload, ";", 0);
        let s2 = s1 < 0 ? -1 : str_find(payload, ";", s1 + 1);
        let s3 = s2 < 0 ? -1 : str_find(payload, ";", s2 + 1);
        s1 < 0 || (s2 < 0 || !(s3 < 0)) ? frex-nothing-request("field-shape") : {
            let coordinate = substring(payload, 0, s1);
            let input-field = substring(payload, s1 + 1, s2);
            let carrier-field = substring(payload, s2 + 1, n);
            !((Comparable) str_find(input-field, "input=", 0) == 0) ? frex-nothing-request("input-field") : !((Comparable) str_find(carrier-field, "carrier=", 0) == 0) ? frex-nothing-request("carrier-field") : {
                let input-text = substring(input-field, 6, str_len(input-field));
                let carrier = substring(carrier-field, 8, str_len(carrier-field));
                let reconstructed = frex-node-from-coordinate(coordinate);
                let recipe = frex-recipe-from-coordinate(coordinate);
                nothing?(reconstructed) ? frex-nothing-request("node-coordinate") : nothing?(recipe) ? frex-nothing-request("unknown-recipe") : !((Comparable) frex-input-text?(input-text) == 1) ? frex-nothing-request("input-integer") : !((Comparable) frex-carrier?(carrier) == 1) ? frex-nothing-request("carrier-choice") : {
                    let input = str_to_int(input-text);
                    let token = frex-request-node(recipe, input, carrier);
                    frex-request("ready", "ready", recipe, input, carrier, token);
                };
            };
        };
    };
    def frex-parse(surface) = !((Comparable) str_find(surface, frex-open(), 0) == 0) ? frex-nothing-request("no-recipe-token") : {
        let close-at = str_find(surface, frex-close(), str_len(frex-open()));
        close-at < 0 ? str_len(surface) > frex-max-frame-bytes() ? frex-nothing-request("payload-budget-exceeded") : frex-nothing-request("held-incomplete") : !((Comparable) (close-at + str_len(frex-close())) == str_len(surface)) ? frex-nothing-request("trailing-bytes") : {
            let payload = substring(surface, str_len(frex-open()), close-at);
            (Comparable) str_len(payload) == 0 ? frex-nothing-request("empty-payload") : str_len(payload) > frex-max-payload-bytes() ? frex-nothing-request("payload-budget-exceeded") : str_find(payload, frex-open(), 0) >= 0 ? frex-nothing-request("nested-recipe-token") : frex-parse-payload(payload);
        };
    };
    def frex-surface(recipe, input, carrier) = str_concat(frex-open(), str_concat(frex-node-coordinate(recipe), str_concat(";input=", str_concat(int_to_str(input), str_concat(";carrier=", str_concat(carrier, frex-close()))))));
    // ── typed carrier observations offered to the pure reducer ───────
    // An offer is evidence supplied by a later carrier boundary. This file
    // neither makes nor verifies the underlying execution claim.
    // offer = (carrier status value value-present reason token)
    def frex-offer-status?(status) = (String) status == "nothing" || ((String) status == "value" || ((String) status == "failure" || (String) status == "timeout")) ? 1 : 0;
    def frex-offer(carrier, status, value, reason) = {
        let present = (String) status == "value" ? 1 : 0;
        let token = intern_node(frex-offer-category(), list(intern_trivial_string(carrier), intern_trivial_string(status), intern_trivial_int(value), intern_trivial_int(present), intern_trivial_string(reason)));
        list(carrier, status, value, present, reason, token);
    };
    def frex-offer-carrier(o) = nth(o, 0);
    def frex-offer-status(o) = nth(o, 1);
    def frex-offer-value(o) = nth(o, 2);
    def frex-offer-value-present?(o) = nth(o, 3);
    def frex-offer-reason(o) = nth(o, 4);
    def frex-offer-token(o) = nth(o, 5);
    def frex-offer-valid?(o) = !((Comparable) len(o) == 6) ? 0 : !((Comparable) frex-carrier?(frex-offer-carrier(o)) == 1) ? 0 : (String) frex-offer-carrier(o) == "auto" ? 0 : !((Comparable) frex-offer-status?(frex-offer-status(o)) == 1) ? 0 : !((Comparable) frex-offer-value-present?(o) == ((String) frex-offer-status(o) == "value" ? 1 : 0)) ? 0 : node_eq(frex-offer-token(o), intern_node(frex-offer-category(), list(intern_trivial_string(frex-offer-carrier(o)), intern_trivial_string(frex-offer-status(o)), intern_trivial_int(frex-offer-value(o)), intern_trivial_int(frex-offer-value-present?(o)), intern_trivial_string(frex-offer-reason(o)))));
    // ── lifecycle observations and bounded fallback ──────────────────
    def frex-request-or-absent(request) = (Comparable) frex-request-ready?(request) == 1 ? frex-request-token(request) : frex-absent-token();
    def frex-event(request, action, carrier, signal, attempt) = intern_node(frex-event-category(), list(frex-request-or-absent(request), intern_trivial_string(action), intern_trivial_string(carrier), intern_trivial_string(signal), intern_trivial_int(attempt)));
    def frex-event-action(event) = node_value(nth(node_children(event), 1));
    def frex-event-carrier(event) = node_value(nth(node_children(event), 2));
    def frex-event-signal(event) = node_value(nth(node_children(event), 3));
    def frex-trace-has?(trace, action) = (Comparable) len(trace) == 0 ? 0 : (String) frex-event-action(head(trace)) == action ? 1 : frex-trace-has?(tail(trace), action);
    def frex-trace-count(trace, action) = (Comparable) len(trace) == 0 ? 0 : ((String) frex-event-action(head(trace)) == action ? 1 : 0) + frex-trace-count(tail(trace), action);
    def frex-trace-add(trace, event) = append(trace, list(event));
    def frex-trace-actions(trace) = (Comparable) len(trace) == 0 ? "" : (Comparable) len(tail(trace)) == 0 ? frex-event-action(head(trace)) : str_concat(frex-event-action(head(trace)), str_concat(",", frex-trace-actions(tail(trace))));
    // result = (status reason request-token observation-token recipe-token
    //           carrier value value-present trace executed model-executed
    //           native-code-generated attempts)
    def frex-observation-token-with-flags(status, reason, request, carrier, value, present, trace, executed, model-executed, native-code-generated) = intern_node(frex-observation-category(), append(list(intern_trivial_string(status), intern_trivial_string(reason), frex-request-or-absent(request), (Comparable) frex-request-ready?(request) == 1 ? frex-request-recipe(request) : frex-absent-token(), intern_trivial_string(carrier), intern_trivial_int(value), intern_trivial_int(present), intern_trivial_int(executed), intern_trivial_int(model-executed), intern_trivial_int(native-code-generated)), trace));
    def frex-observation-token(status, reason, request, carrier, value, present, trace) = frex-observation-token-with-flags(status, reason, request, carrier, value, present, trace, 0, 0, 0);
    def frex-result-with-flags(status, reason, request, carrier, value, present, trace, attempts, executed, model-executed, native-code-generated) = {
        let observation = frex-observation-token-with-flags(status, reason, request, carrier, value, present, trace, executed, model-executed, native-code-generated);
        list(status, reason, frex-request-or-absent(request), observation, (Comparable) frex-request-ready?(request) == 1 ? frex-request-recipe(request) : frex-absent-token(), carrier, value, present, trace, executed, model-executed, native-code-generated, attempts);
    };
    def frex-result(status, reason, request, carrier, value, present, trace, attempts) = frex-result-with-flags(status, reason, request, carrier, value, present, trace, attempts, 0, 0, 0);
    def frex-result-status(r) = nth(r, 0);
    def frex-result-reason(r) = nth(r, 1);
    def frex-result-request(r) = nth(r, 2);
    def frex-result-observation(r) = nth(r, 3);
    def frex-result-recipe(r) = nth(r, 4);
    def frex-result-carrier(r) = nth(r, 5);
    def frex-result-value(r) = nth(r, 6);
    def frex-result-value-present?(r) = nth(r, 7);
    def frex-result-trace(r) = nth(r, 8);
    def frex-result-executed?(r) = nth(r, 9);
    def frex-result-model-executed?(r) = nth(r, 10);
    def frex-result-native-code-generated?(r) = nth(r, 11);
    def frex-result-attempts(r) = nth(r, 12);
    def frex-carrier-admitted?(request, offer) = (String) frex-request-carrier(request) == "auto" ? 1 : (String) frex-request-carrier(request) == frex-offer-carrier(offer) ? 1 : 0;
    def frex-finish(request, status, reason, carrier, trace, attempts) = {
        let released = frex-trace-add(trace, frex-event(request, "release", carrier, status, attempts));
        frex-result(status, reason, request, carrier, 0, 0, released, attempts);
    };
    def frex-choice-loop(request, offers, attempt, trace, last-status, last-reason) = attempt >= frex-max-attempts() ? {
        let cut-trace = frex-trace-add(trace, frex-event(request, "cut", "", "attempt-budget", attempt));
        frex-finish(request, "timeout", "attempt-budget", "", cut-trace, attempt);
    } : (Comparable) len(offers) == 0 ? (Comparable) attempt == 0 ? {
        let nothing-trace = frex-trace-add(trace, frex-event(request, "nothing", "", "no-offer", 0));
        frex-finish(request, "nothing", "no-offer", "", nothing-trace, 0);
    } : frex-finish(request, last-status, last-reason, "", trace, attempt) : {
        let offer = head(offers);
        let carrier = (Comparable) len(offer) == 6 ? frex-offer-carrier(offer) : "";
        let selected = frex-trace-add(trace, frex-event(request, "choice", carrier, "offered", attempt));
        !((Comparable) frex-offer-valid?(offer) == 1) || !((Comparable) frex-carrier-admitted?(request, offer) == 1) ? {
            let failed = frex-trace-add(selected, frex-event(request, "failure", carrier, "invalid-offer", attempt));
            let undone = frex-trace-add(failed, frex-event(request, "undo", carrier, "invalid-offer", attempt));
            let refined = frex-trace-add(undone, frex-event(request, "refine", carrier, "next-choice", attempt));
            frex-choice-loop(request, tail(offers), attempt + 1, refined, "failure", "invalid-offer");
        } : {
            let status = frex-offer-status(offer);
            let reason = frex-offer-reason(offer);
            (String) status == "value" ? {
                let crystal = frex-trace-add(selected, frex-event(request, "crystallize", carrier, "value", attempt));
                let dissolved = frex-trace-add(crystal, frex-event(request, "dissolve", carrier, "alternatives", attempt));
                let released = frex-trace-add(dissolved, frex-event(request, "release", carrier, "value", attempt));
                frex-result("value", reason, request, carrier, frex-offer-value(offer), 1, released, attempt + 1);
            } : (String) status == "nothing" ? {
                let saw = frex-trace-add(selected, frex-event(request, "nothing", carrier, reason, attempt));
                let refined = frex-trace-add(saw, frex-event(request, "refine", carrier, "next-choice", attempt));
                frex-choice-loop(request, tail(offers), attempt + 1, refined, "nothing", reason);
            } : (String) status == "failure" ? {
                let failed = frex-trace-add(selected, frex-event(request, "failure", carrier, reason, attempt));
                let undone = frex-trace-add(failed, frex-event(request, "undo", carrier, reason, attempt));
                let refined = frex-trace-add(undone, frex-event(request, "refine", carrier, "next-choice", attempt));
                frex-choice-loop(request, tail(offers), attempt + 1, refined, "failure", reason);
            } : {
                let timed = frex-trace-add(selected, frex-event(request, "timeout", carrier, reason, attempt));
                let cut = frex-trace-add(timed, frex-event(request, "cut", carrier, reason, attempt));
                let undone = frex-trace-add(cut, frex-event(request, "undo", carrier, reason, attempt));
                let refined = frex-trace-add(undone, frex-event(request, "refine", carrier, "next-choice", attempt));
                frex-choice-loop(request, tail(offers), attempt + 1, refined, "timeout", reason);
            };
        };
    };
    def frex-choice(request, offers) = !((Comparable) frex-request-ready?(request) == 1) ? frex-result("nothing", frex-request-reason(request), request, "", 0, 0, empty(), 0) : frex-choice-loop(request, offers, 0, empty(), "nothing", "no-offer");
    // ── bounded witness rendering ────────────────────────────────────
    def frex-cat(parts) = (Comparable) len(parts) == 0 ? "" : str_concat(head(parts), frex-cat(tail(parts)));
    def frex-render(result) = {
        let value-text = (Comparable) frex-result-value-present?(result) == 1 ? int_to_str(frex-result-value(result)) : "absent";
        let rendered = frex-cat(list(frex-observation-open(), "\nstatus=", frex-result-status(result), "\nreason=", frex-result-reason(result), "\nrequest-node=@", frex-node-key(frex-result-request(result)), "\nrecipe-node=@", frex-node-key(frex-result-recipe(result)), "\nobservation-node=@", frex-node-key(frex-result-observation(result)), "\ncarrier=", frex-result-carrier(result), "\nvalue-present=", int_to_str(frex-result-value-present?(result)), "\nvalue=", value-text, "\nattempts=", int_to_str(frex-result-attempts(result)), "\nexecuted=", int_to_str(frex-result-executed?(result)), "\nmodel-executed=", int_to_str(frex-result-model-executed?(result)), "\nnative-code-generated=", int_to_str(frex-result-native-code-generated?(result)), "\nlifecycle=", frex-trace-actions(frex-result-trace(result)), "\n", frex-observation-close()));
        str_len(rendered) <= frex-max-render-bytes() ? rendered : "";
    };
    0;
}
