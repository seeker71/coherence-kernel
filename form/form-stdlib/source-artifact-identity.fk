// source-artifact-identity.fk -- Layer 8d source artifact digest/vouch rows.
//
// This layer owns digest identity over material. It computes SHA-256 over
// caller-supplied byte lists, over any file's own bytes read off disk through
// read_file_bytes (sai-vouch-file-bytes, binary included), and over text source
// once the caller's observed file size matches the read string's byte length.
//
// Digest identity is not a seal, proof, native callable status, cache write,
// artifact load, runtime selector, compiler emission, or route algebra. When
// this layer enriches `sap-*` observations, it carries only honestly matched
// source/content hashes and leaves seal/proof/callable fields to their own
// later evidence.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-fs.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk form-stdlib/source-artifact-probe.fk
section [form.bml] {
    def sai-feature(name, status) = list("source-artifact-identity-feature", name, status);
    def sai-feature-name(f) = nth(f, 1);
    def sai-feature-status(f) = nth(f, 2);
    def source-artifact-identity-manifest() = list(sai-feature("byte-list-sha256-hex", 1), sai-feature("declared-content-hash-verify", 1), sai-feature("declared-source-hash-verify", 1), sai-feature("evidence-kind-carried", 1), sai-feature("supplied-byte-list-evidence", 1), sai-feature("text-source-helper-scoped", 1), sai-feature("text-size-must-match-observed", 1), sai-feature("emits-observations-for-sap", 1), sai-feature("identity-match-does-not-set-seal-ok", 1), sai-feature("no-seal-verification", 1), sai-feature("no-proof-callable-native-admission", 1), sai-feature("no-artifact-load", 1), sai-feature("no-runtime-selector", 1), sai-feature("no-compiler-emission", 1), sai-feature("no-cache-write", 1), sai-feature("no-c-seed-growth", 1), sai-feature("binary-file-hash", 1), sai-feature("file-bytes-evidence", 1), sai-feature("does-not-derive-sac-state-or-route", 1), sai-feature("read-only-no-disk-write", 1), sai-feature("no-sap-import-cycle", 1));
    def source-artifact-identity-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) sai-feature-name(head(fs)) == name && (Comparable) sai-feature-status(head(fs)) == 1 ? 1 : source-artifact-identity-manifest-has?(name, tail(fs));
    def sai-hash-prefix() = "sha256:";
    def sai-target-source-hash() = "source-hash";
    def sai-target-content-hash() = "content-hash";
    def sai-evidence-supplied-bytes() = "supplied-byte-list";
    def sai-evidence-text-source() = "text-source-size-checked";
    def sai-evidence-file-bytes() = "file-bytes";
    def sai-status-match() = "match";
    def sai-status-mismatch() = "mismatch";
    def sai-status-undeclared() = "undeclared";
    def sai-status-malformed() = "malformed";
    def sai-status-size-mismatch() = "size-mismatch";
    def sai-status-unobserved() = "unobserved";
    def sai-string-bytes-loop(s, i, n, acc) = i >= n ? reverse(acc) : sai-string-bytes-loop(s, i + 1, n, cons(str-byte-at(s, i), acc));
    def sai-string-bytes(s) = sai-string-bytes-loop(s, 0, str_len(s), list());
    def sai-sha256-hex(bytes) = str_concat(sai-hash-prefix(), hex-encode(sha256(bytes)));
    def sai-sha256-string(s) = sai-sha256-hex(sai-string-bytes(s));
    def sai-lower-hex-byte?(c) = c >= 48 && c <= 57 ? 1 : c >= 97 && c <= 102 ? 1 : 0;
    def sai-lower-hex-loop(s, i, end) = i >= end ? 1 : (Comparable) sai-lower-hex-byte?(str-byte-at(s, i)) == 1 ? sai-lower-hex-loop(s, i + 1, end) : 0;
    def sai-canonical-sha256?(h) = (Comparable) str_len(h) == 71 ? (String) substring(h, 0, 7) == sai-hash-prefix() ? sai-lower-hex-loop(h, 7, 71) : 0 : 0;
    def sai-status-for(expected, actual) = (String) expected == "" ? sai-status-undeclared() : (Comparable) sai-canonical-sha256?(expected) == 0 ? sai-status-malformed() : (String) expected == actual ? sai-status-match() : sai-status-mismatch();
    // vouch = ("source-artifact-identity-vouch" target path evidence-kind
    //          expected-hash actual-hash status observed-size material-size)
    def sai-vouch(target, path, evidence-kind, expected-hash, actual-hash, status, observed-size, material-size) = list("source-artifact-identity-vouch", target, path, evidence-kind, expected-hash, actual-hash, status, observed-size, material-size);
    def sai-vouch?(v) = (String) nth(v, 0) == "source-artifact-identity-vouch";
    def sai-vouch-target(v) = nth(v, 1);
    def sai-vouch-path(v) = nth(v, 2);
    def sai-vouch-evidence-kind(v) = nth(v, 3);
    def sai-vouch-expected-hash(v) = nth(v, 4);
    def sai-vouch-actual-hash(v) = nth(v, 5);
    def sai-vouch-status(v) = nth(v, 6);
    def sai-vouch-observed-size(v) = nth(v, 7);
    def sai-vouch-material-size(v) = nth(v, 8);
    def sai-vouch-match?(v) = sai-vouch?(v) ? (String) sai-vouch-status(v) == sai-status-match() ? 1 : 0 : 0;
    def sai-vouch-hash-if-match(v) = sai-vouch-match?(v) ? sai-vouch-actual-hash(v) : "";
    def sai-vouch-bytes(target, path, expected-hash, bytes) = {
        let actual = sai-sha256-hex(bytes);
        sai-vouch(target, path, sai-evidence-supplied-bytes(), expected-hash, actual, sai-status-for(expected-hash, actual), len(bytes), len(bytes));
    };
    def sai-vouch-source-bytes(path, expected-hash, bytes) = sai-vouch-bytes(sai-target-source-hash(), path, expected-hash, bytes);
    def sai-vouch-content-bytes(path, expected-hash, bytes) = sai-vouch-bytes(sai-target-content-hash(), path, expected-hash, bytes);
    // a file's own bytes, read off disk through read_file_bytes: any file, binary
    // included. A path that does not open is unobserved, never the empty digest.
    def sai-vouch-file-bytes(target, path, expected-hash) = {
        let bytes = read_file_bytes(path);
        nothing?(bytes) ? sai-vouch(target, path, sai-evidence-file-bytes(), expected-hash, "", sai-status-unobserved(), -1, 0) : {
            let actual = sai-sha256-hex(bytes);
            sai-vouch(target, path, sai-evidence-file-bytes(), expected-hash, actual, sai-status-for(expected-hash, actual), len(bytes), len(bytes));
        };
    };
    def sai-vouch-text-source(path, observed-size, expected-hash, text) = {
        let material-size = str_len(text);
        (Comparable) observed-size == material-size ? {
            let actual = sai-sha256-string(text);
            sai-vouch(sai-target-source-hash(), path, sai-evidence-text-source(), expected-hash, actual, sai-status-for(expected-hash, actual), observed-size, material-size);
        } : sai-vouch(sai-target-source-hash(), path, sai-evidence-text-source(), expected-hash, "", sai-status-size-mismatch(), observed-size, material-size);
    };
    def sai-vouch-text-source-observation(source-observation, expected-hash) = sap-observation?(source-observation) && sap-role?(source-observation, sap-role-source()) ? (Comparable) sap-observation-present?(source-observation) == 1 ? sai-vouch-text-source(sap-observation-path(source-observation), sap-observation-size(source-observation), expected-hash, read_file(sap-observation-path(source-observation))) : sai-vouch(sai-target-source-hash(), sap-observation-path(source-observation), sai-evidence-text-source(), expected-hash, "", sai-status-unobserved(), sap-observation-size(source-observation), 0) : sai-vouch(sai-target-source-hash(), "", sai-evidence-text-source(), expected-hash, "", sai-status-unobserved(), -1, 0);
    def sai-source-observation-from-vouch(path, exists, size, mtime, source-vouch) = sap-source-observation(path, exists, size, mtime, (String) sai-vouch-target(source-vouch) == sai-target-source-hash() ? sai-vouch-hash-if-match(source-vouch) : "");
    def sai-program-image-fkb-observation-from-vouches(path, exists, size, mtime, source-vouch, content-vouch, seal-ok, includes-tbl) = sap-program-image-fkb-observation(path, exists, size, mtime, (String) sai-vouch-target(source-vouch) == sai-target-source-hash() ? sai-vouch-hash-if-match(source-vouch) : "", (String) sai-vouch-target(content-vouch) == sai-target-content-hash() ? sai-vouch-hash-if-match(content-vouch) : "", seal-ok, includes-tbl);
    def sai-native-dylib-observation-from-vouches(path, exists, size, mtime, source-vouch, content-vouch, seal-ok, proof, callable, lowerable) = sap-native-dylib-observation(path, exists, size, mtime, (String) sai-vouch-target(source-vouch) == sai-target-source-hash() ? sai-vouch-hash-if-match(source-vouch) : "", (String) sai-vouch-target(content-vouch) == sai-target-content-hash() ? sai-vouch-hash-if-match(content-vouch) : "", seal-ok, proof, callable, lowerable);
}
