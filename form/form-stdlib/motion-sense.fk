// Supplied acceleration, yaw and GPS samples become mesh readings.
// Direction is the existing sign/dominance sector (0..7), nudged by yaw;
// speed integrates acceleration magnitude, not a measured velocity vector.
// GPS cells use rounded degrees. Acquisition remains with the host carrier.
// preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/geometry.fk form-stdlib/world-sensor-floor.fk
section [form.bml] {
 class MotionSense {
  def ms-accel-sensor() = wsf-sensor("accelerometer","motion");
  def ms-gyro-sensor() = wsf-sensor("gyroscope","motion");
  def ms-gps-sensor() = wsf-sensor("gps","where");
  def ms-acceleration(accel) = list("acceleration",vlen(accel),accel);
  def ms-acc-magnitude(a) = nth(a,1);
  def ms-acc-vector(a) = nth(a,2);
  def ms-speed(history,dt) {
   def integrate(accel,rest) = vlen(accel) * dt + rest;
   foldr(integrate,0.0,history);
  }
  def fabs2(x) = if x < 0.0 then 0.0 - x else x;
  def ms-octant(ax,ay) =
   if ax >= 0.0 && ay >= 0.0 then if fabs2(ax) >= fabs2(ay) then 0 else 1
   else if ax < 0.0 && ay >= 0.0 then if fabs2(ay) >= fabs2(ax) then 2 else 3
   else if ax < 0.0 && ay < 0.0 then if fabs2(ax) >= fabs2(ay) then 4 else 5
   else if fabs2(ay) >= fabs2(ax) then 6 else 7;
  def ms-yaw-nudge(octant,gz) = if gz > 0.0 then (octant + 1) % 8 else if gz < 0.0 then (octant + 7) % 8 else octant;
  def ms-direction(accel,gyro) = ms-yaw-nudge(ms-octant(vx(accel),vy(accel)),vz(gyro));
  def gps-lat(g) = nth(g,0);
  def gps-lon(g) = nth(g,1);
  def ms-location(gps) = (round(gps-lat(gps)) + 90) * 360 + round(gps-lon(gps)) + 180;
  def motion-obs(gps,history,gyro,dt,confidence) = list("motion-obs",gps,history,gyro,dt,confidence);
  def mo-gps(m) = nth(m,1);
  def mo-history(m) = nth(m,2);
  def mo-gyro(m) = nth(m,3);
  def mo-dt(m) = nth(m,4);
  def mo-conf(m) = nth(m,5);
  def ms-route(motion) = list(
   wsf-route(ms-gps-sensor(),ms-location(mo-gps(motion)),mo-conf(motion)),
   wsf-route(ms-accel-sensor(),ms-direction(head(mo-history(motion)),mo-gyro(motion)),mo-conf(motion)));
  def ms-fuse(motion) = wsf-fuse(ms-route(motion));
 }
}
