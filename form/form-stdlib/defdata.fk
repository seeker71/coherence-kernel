// defdata.fk -- static data as realized value, not a zero-arg runtime thunk.
//
// This is the first embodiment of the data-literal story. It does NOT add a
// kernel primitive. It names the authoring discipline and the carrier policy:
// small stable data can be realized inline; compact generative data can be
// realized by a micro-recipe once at load when the recipe is smaller than the
// realized constants; large stable data can live as .fkb; data that is both
// large/stable and compactly generative can use a hybrid.
//
// The current lowering target is a top-level module constant: source can lower
// `defdata NAME VALUE` to `(let NAME VALUE)`, and later functions can read NAME
// as a realized value. A future `defdata` keyword is still authoring sugar and
// artifact policy; it should lower here rather than add a kernel primitive.
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    let DD-SAMPLE-ROWS = list(8, 13, 21);
    {
        def dd-inline() = 1;
        def dd-micro-recipe() = 2;
        def dd-fkb() = 3;
        def dd-hybrid() = 4;
        // const-size and recipe-size are authoring estimates: row count, byte band,
        // token band, or another stable scalar. The micro-recipe route is earned by
        // being smaller than the realized constants, not by being generative alone.
        // stable/generative are 1/0 flags.
        def dd-recipe-smaller?(const-size, recipe-size) = recipe-size < const-size ? 1 : 0;
        def dd-policy(const-size, recipe-size, stable, generative) = (Comparable) stable == 1 ? (Comparable) generative == 1 ? (Comparable) dd-recipe-smaller?(const-size, recipe-size) == 1 ? const-size >= 64 ? dd-hybrid() : dd-micro-recipe() : const-size >= 64 ? dd-fkb() : dd-inline() : const-size >= 64 ? dd-fkb() : dd-inline() : (Comparable) generative == 1 ? (Comparable) dd-recipe-smaller?(const-size, recipe-size) == 1 ? dd-micro-recipe() : const-size >= 64 ? dd-fkb() : dd-inline() : const-size >= 64 ? dd-fkb() : dd-inline();
        def dd-spec(name, const-size, recipe-size, stable, generative, carrier, value) = list("defdata", name, const-size, recipe-size, stable, generative, carrier, value);
        def dd-name(d) = nth(d, 1);
        def dd-const-size(d) = nth(d, 2);
        def dd-recipe-size(d) = nth(d, 3);
        def dd-size(d) = dd-const-size(d);
        def dd-stable(d) = nth(d, 4);
        def dd-generative(d) = nth(d, 5);
        def dd-carrier(d) = nth(d, 6);
        def dd-value(d) = nth(d, 7);
        // The value side of the contract: consumers read a value cell, not a thunk.
        def dd-value-count(d) = len(dd-value(d));
        def dd-value-head(d) = head(dd-value(d));
        // The compiler/language gap is now syntax and artifact policy, not value
        // export. The repaired source runner can bind a top-level data value once
        // and let later functions read that realized value.
        def dd-needs-loader-binding?() = 0;
        def dd-can-lower-to-module-constant?() = 1;
        def dd-lowered-sample-value() = DD-SAMPLE-ROWS;
        def dd-lowered-sample-count() = len(DD-SAMPLE-ROWS);
        def dd-lowered-sample-head() = head(DD-SAMPLE-ROWS);
        def ddk(ok, bit) = ok ? bit : 0;
        def dd-sum(xs) = (Comparable) len(xs) == 0 ? 0 : head(xs) + dd-sum(tail(xs));
        def defdata-check() = {
            let sample = dd-spec("sample", 3, 0, 1, 0, dd-policy(3, 0, 1, 0), list(8, 13, 21));
            dd-sum(list(ddk((Comparable) dd-policy(3, 0, 1, 0) == dd-inline(), 1), ddk((Comparable) dd-policy(80, 0, 1, 0) == dd-fkb(), 2), ddk((Comparable) dd-policy(20, 5, 0, 1) == dd-micro-recipe(), 4), ddk((Comparable) dd-policy(80, 12, 1, 1) == dd-hybrid(), 8), ddk((Comparable) dd-policy(8, 40, 1, 1) == dd-inline(), 16), ddk((Comparable) dd-policy(8, 8, 1, 1) == dd-inline(), 32), ddk((Comparable) dd-value-head(sample) == 8, 64), ddk((Comparable) dd-value-count(sample) == 3, 128), ddk((Comparable) dd-can-lower-to-module-constant?() == 1, 256), ddk((Comparable) dd-lowered-sample-count() == 3, 512), ddk((Comparable) dd-lowered-sample-head() == 8, 1024)));
        };
        0;
    };
}
