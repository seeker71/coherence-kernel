; living-world-active-index.fk -- re-observe active evidence once per local act.
;
; The world remains the authority. This index is rebuilt from its exact
; attribution and revocation fields at the moment of use; it is neither stored
; authority nor a cache that can outlive evidence movement. It preserves the
; attribution ordering used by ordinary evidence derivation, while allowing
; symbol and relation currentness to ask membership locally instead of
; re-scanning all attributions for every unrelated cell.
;
; Indexed relation integration is semantically the ordinary unanimous tending
; membrane: the same response outcome, participants, candidate evidence,
; endpoint freshness, witness readiness, offered action, and attribution
; integration are required. The only difference is evaluation shape.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-relation-learning.fk

(let LWAI-INDEX    (bp "LWAI-INDEX"))
(let LWAI-PAYLOADS (bp "LWAI-PAYLOADS"))

; The world attribution field is unique. Accumulate raw lists and intern once;
; repeated lwo-field-add would re-walk a growing field quadratically.
(defn lwai-active-attribution-list (world items acc)
    (if (eq (len items) 0) acc
        (do
            (let attribution (head items))
            (lwai-active-attribution-list world (tail items)
                (if (eq (lwo-attribution-revoked? world
                            (lwo-attribution-payload attribution)
                            (lwo-attribution-source attribution)) 1)
                    acc (cons attribution acc))))))

(defn lwai-active-payload-list (items acc)
    (if (eq (len items) 0) acc
        (lwai-active-payload-list (tail items)
            (cons (lwo-attribution-payload (head items)) acc))))
(defn lwai-payloads (items) (intern_node LWAI-PAYLOADS items))

; children: exact active payload identities, exact active attributions,
;           revocation identity used to derive them, local path
(defn lwai-index (world)
    (do
        ; Reversed world order is the exact order produced by the ordinary
        ; lwo-active-attributions-for accumulator for any one payload.
        (let active-list
            (lwai-active-attribution-list world
                (lwo-field-items (lwo-world-attributions world)) (empty)))
        (let attributions
            (lwo-field active-list))
        (let cells
            (lwai-payloads
                (lwai-active-payload-list active-list (empty))))
        (intern_node LWAI-INDEX
            (list cells attributions (lwo-world-revocations world)
                  (lwo-local-path)))))
(defn lwai-index? (index) (lwo-category? index LWAI-INDEX))
(defn lwai-index-cells (index) (nth (node_children index) 0))
(defn lwai-index-attributions (index) (nth (node_children index) 1))
(defn lwai-index-revocations (index) (nth (node_children index) 2))
(defn lwai-index-path (index) (nth (node_children index) 3))

(defn lwai-active? (index payload)
    (lwo-member? (node_children (lwai-index-cells index)) payload))
(defn lwai-active-attribution? (index attribution)
    (lwo-field-has? (lwai-index-attributions index) attribution))

(defn lwai-active-attributions-for-items (items payload acc)
    (if (eq (len items) 0) (lwo-field (reverse acc))
        (do
            (let attribution (head items))
            (lwai-active-attributions-for-items (tail items) payload
                (if (node_eq
                        (lwo-attribution-payload attribution) payload)
                    (cons attribution acc) acc)))))
(defn lwai-active-attributions-for (index payload)
    (lwai-active-attributions-for-items
        (lwo-field-items (lwai-index-attributions index)) payload
        (empty)))

(defn lwai-symbol-collect-items
    (index items referent coordinate surface supports alternatives dissents
     silences unresolved)
    (if (eq (len items) 0)
        (lwsl-evidence-set supports alternatives dissents silences unresolved)
        (do
            (let observation (head items))
            (if (eq (lwsl-observation-valid? observation) 0)
                (lwai-symbol-collect-items index (tail items)
                    referent coordinate surface supports alternatives dissents
                    silences unresolved)
                (if (eq (lwsl-same-coordinate?
                            observation referent coordinate) 0)
                    (lwai-symbol-collect-items index (tail items)
                        referent coordinate surface supports alternatives
                        dissents silences unresolved)
                    (if (eq (lwai-active? index observation) 0)
                        (lwai-symbol-collect-items index (tail items)
                            referent coordinate surface supports alternatives
                            dissents silences unresolved)
                        (do
                            (let classified
                                (lwsl-classify-evidence observation
                                    (lwsl-evidence observation
                                        (lwai-active-attributions-for
                                            index observation))
                                    surface supports alternatives dissents
                                    silences unresolved))
                            (lwai-symbol-collect-items index (tail items)
                                referent coordinate surface
                                (lwsl-evidence-supports classified)
                                (lwsl-evidence-alternatives classified)
                                (lwsl-evidence-dissents classified)
                                (lwsl-evidence-silences classified)
                                (lwsl-evidence-unresolved classified)))))))))

(defn lwai-symbol-evidence-for-at
    (world index referent coordinate surface)
    (lwai-symbol-collect-items index
        (lwo-field-items (lwo-world-cells world))
        referent coordinate surface
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field)))

(defn lwai-symbol-candidate-current? (world index candidate)
    (if (eq (lwsl-symbol-candidate? candidate) 0) 0
        (do
            (let symbol (lwo-emergent-shape candidate))
            (let evidence
                (lwai-symbol-evidence-for-at world index
                    (lwnv-symbol-referent symbol)
                    (lwnv-symbol-coordinate symbol)
                    (lwnv-symbol-surface symbol)))
            (let witnesses (lwsl-witnesses evidence))
            (if (and (node_eq evidence (lwnv-symbol-evidence symbol))
                     (and (node_eq witnesses
                               (lwo-emergent-witnesses candidate))
                          (and (eq (lwsl-support-count evidence)
                                   (lwo-emergent-coherence candidate))
                               (and (eq (lwo-field-size witnesses)
                                        (lwo-emergent-resonance candidate))
                                    (ge (lwsl-support-count evidence)
                                        (lwo-emergent-threshold candidate))))))
                1 0))))

(defn lwai-symbol-integrated-current? (world index candidate)
    (if (and (eq (lwai-active? index candidate) 1)
             (eq (lwai-symbol-candidate-current?
                    world index candidate) 1)) 1 0))

(defn lwai-relation-collect-items
    (index items relation left right supports alternatives dissents silences
     unresolved)
    (if (eq (len items) 0)
        (lwrl-evidence-set supports alternatives dissents silences unresolved)
        (do
            (let observation (head items))
            (if (eq (lwrl-observation-valid? observation) 0)
                (lwai-relation-collect-items index (tail items)
                    relation left right supports alternatives dissents
                    silences unresolved)
                (if (eq (lwrl-same-pair?
                            observation relation left right) 0)
                    (lwai-relation-collect-items index (tail items)
                        relation left right supports alternatives dissents
                        silences unresolved)
                    (if (eq (lwai-active? index observation) 0)
                        (lwai-relation-collect-items index (tail items)
                            relation left right supports alternatives dissents
                            silences unresolved)
                        (do
                            (let classified
                                (lwrl-classify-evidence observation
                                    (lwrl-evidence observation
                                        (lwai-active-attributions-for
                                            index observation))
                                    relation left right supports alternatives
                                    dissents silences unresolved))
                            (lwai-relation-collect-items index (tail items)
                                relation left right
                                (lwrl-evidence-supports classified)
                                (lwrl-evidence-alternatives classified)
                                (lwrl-evidence-dissents classified)
                                (lwrl-evidence-silences classified)
                                (lwrl-evidence-unresolved classified)))))))))

(defn lwai-relation-evidence-for (world index relation left right)
    (lwai-relation-collect-items index
        (lwo-field-items (lwo-world-cells world)) relation left right
        (lwo-empty-field) (lwo-empty-field) (lwo-empty-field)
        (lwo-empty-field) (lwo-empty-field)))

(defn lwai-relation-endpoints-current? (world index left right)
    (if (and (eq (lwai-symbol-integrated-current?
                        world index left) 1)
             (eq (lwai-symbol-integrated-current?
                        world index right) 1)) 1 0))

(defn lwai-relation-proposal-for (world index observation threshold)
    (if (eq (lwrl-observation-valid? observation) 0) (lwo-none)
        (if (eq (oac-one? (lwrl-observation-ack observation)) 0)
            (lwo-none)
            (if (eq (lwai-active? index observation) 0) (lwo-none)
                (do
                    (let relation (lwrl-observation-relation observation))
                    (let left (lwrl-observation-left observation))
                    (let right (lwrl-observation-right observation))
                    (if (eq (lwai-relation-endpoints-current?
                                world index left right) 0)
                        (lwo-none)
                        (do
                            (let evidence
                                (lwai-relation-evidence-for
                                    world index relation left right))
                            (if (lt (lwrl-support-count evidence) threshold)
                                (lwo-none)
                                (do
                                    (let edge
                                        (lwrl-edge relation left right evidence))
                                    (let witnesses (lwrl-witnesses evidence))
                                    (let origin
                                        (lwrl-origin relation left right
                                            evidence threshold))
                                    (let candidate
                                        (lwo-emergent edge witnesses
                                            (intern_trivial_int
                                                (lwrl-support-count evidence))
                                            (intern_trivial_int
                                                (lwo-field-size witnesses))
                                            (intern_trivial_int threshold)
                                            origin))
                                    (lwt-proposal candidate
                                        (lwt-sources-from-attributions
                                            (lwo-field-items witnesses)
                                            (lwo-empty-field))
                                        origin))))))))))

(defn lwai-relation-candidate-current? (world index candidate)
    (if (eq (lwrl-candidate? candidate) 0) 0
        (do
            (let edge (lwo-emergent-shape candidate))
            (let evidence
                (lwai-relation-evidence-for world index
                    (lwrl-edge-relation edge)
                    (lwrl-edge-left edge)
                    (lwrl-edge-right edge)))
            (let witnesses (lwrl-witnesses evidence))
            (if (and (eq (lwai-relation-endpoints-current?
                           world index (lwrl-edge-left edge)
                           (lwrl-edge-right edge)) 1)
                     (and (node_eq evidence (lwrl-edge-evidence edge))
                          (and (node_eq witnesses
                                   (lwo-emergent-witnesses candidate))
                               (and (eq (lwrl-support-count evidence)
                                        (lwo-emergent-coherence candidate))
                                    (and (eq (lwo-field-size witnesses)
                                             (lwo-emergent-resonance candidate))
                                         (ge (lwrl-support-count evidence)
                                             (lwo-emergent-threshold
                                                candidate))))))) 1 0))))

(defn lwai-witness-active? (index witness)
    (if (eq (lwo-category? witness LWO-ATTRIBUTION) 1)
        (lwai-active-attribution? index witness)
        (lwai-active? index witness)))
(defn lwai-all-active? (index items)
    (if (eq (len items) 0) 1
        (if (eq (lwai-witness-active? index (head items)) 1)
            (lwai-all-active? index (tail items)) 0)))
(defn lwai-emergent-ready? (index candidate)
    (if (and (ge (lwo-field-size (lwo-emergent-witnesses candidate))
                 (lwo-emergent-threshold candidate))
             (and (eq (lwai-all-active? index
                           (lwo-field-items
                               (lwo-emergent-witnesses candidate))) 1)
                  (and (gt (lwo-emergent-coherence candidate) 0)
                       (gt (lwo-emergent-resonance candidate) 0)))) 1 0))

; All participants admit the same emergent candidate through the same offered
; action. Build their exact attributions and boundary events in source order,
; then intern one resulting world instead of a whole intermediate world per
; participant. Relation candidates are LWO-EMERGENT cells, not raw
; LWO-RELATION cells, so the relation/contradiction fields remain unchanged.
(defn lwai-integration-fields
    (sources candidate action provenance attributions events)
    (if (eq (len sources) 0) (list attributions events)
        (do
            (let source (head sources))
            (let ack (oac-one candidate))
            (lwai-integration-fields (tail sources)
                candidate action provenance
                (lwo-field-add attributions
                    (lwo-attribution candidate source provenance))
                (lwo-field-add events
                    (lwo-boundary-event source action ack))))))

(defn lwai-integrate-relation-sources
    (world sources candidate action provenance)
    (do
        (let fields
            (lwai-integration-fields sources candidate action provenance
                (lwo-world-attributions world) (lwo-world-events world)))
        (lwo-world
            (lwo-field-add (lwo-world-cells world) candidate)
            (lwo-world-relations world)
            (nth fields 0)
            (lwo-world-revocations world)
            (nth fields 1))))

(defn lwai-integrate-relation (round proposal action)
    (do
        (let world (lwt-round-world round))
        (let index (lwai-index world))
        (let outcome (lwt-evaluate-proposal world proposal))
        (let candidate (lwt-proposal-candidate proposal))
        (if (and (node_eq (lwt-outcome-status outcome)
                          (lwt-status-acknowledged))
                 (and (eq (lwai-relation-candidate-current?
                                world index candidate) 1)
                      (eq (lwai-emergent-ready?
                                index candidate) 1)))
            (lwt-round
                (lwai-integrate-relation-sources world
                    (lwo-field-items
                        (lwt-proposal-participants proposal))
                    candidate action outcome)
                (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field) outcome)
                round)
            (lwt-round world (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field) outcome) round))))
