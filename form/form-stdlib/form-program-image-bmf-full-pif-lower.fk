; form-program-image-bmf-full-pif-lower.fk -- content-vouched admission of a
; generic bounded-BMF raw-state image through the full-PIF call protocol.
;
; fprsl-lower remains the compiler.  This cell does not translate, flatten or
; reinterpret its linked table.  It derives a canonical entry symbol from the
; exact table bytes, seals those bytes in a PIF envelope, decodes the canonical
; payload back into data, and admits that same PIF to the unchanged FPCPF
; receiver.  The one public OFFER value is the raw string.  The returned value
; remains [code, at, captures, semantic], preserving native query NodeIDs and
; keeping semantic nothing distinct from integer 0 and integer 1.
;
; SHA compression is offered to the Form-emitted arm64 JIT organ.  Until the
; list cursor itself reaches JIT, a uniquely claimed and released local scratch
; file is the measured bulk byte carrier (about 3 ms for the current 52 KiB
; image versus about 1.85 s through 807 interpreted string handoffs).  Its
; identity is retained in the content vouch.  Carrier refusal turns first to
; the resident bounded cursor and then to the scalar Form recipe.  No process,
; HTTP, model, C, flatten or operation-table authority enters.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-program-image-bmf-raw-state-lower.fk
; preludes: form-stdlib/form-program-image-full-pif-call-adapter.fk
; preludes: form-stdlib/program-image-fkb-string-decode.fk
; preludes: native/metal/sha256-arm64-jit.fk
; Proven by: form-stdlib/tests/form-program-image-bmf-full-pif-lower-band.fk

(do
    (defn fpbfl-version () "form-program-image-bmf-full-pif-lower-v1")
    (defn fpbfl-ready-tag () "bmf-full-pif-ready")
    (defn fpbfl-refused-tag () "bmf-full-pif-refused")
    (defn fpbfl-call-name () "parse-raw-string")
    (defn fpbfl-all? (values)
        (if (nil? values) 1
            (if (head values) (fpbfl-all? (tail values)) 0)))

    (defn fpbfl-refused (reason)
        (list (fpbfl-refused-tag) reason (nothing)))
    (defn fpbfl-refused? (result)
        (if (not (eq (len result) 3)) 0
        (if (not (str_eq (head result) (fpbfl-refused-tag))) 0
        (if (not (gt (str_len (nth result 1)) 0)) 0
            (if (nothing? (nth result 2)) 1 0)))))
    (defn fpbfl-reason (result)
        (if (fpbfl-refused? result) (nth result 1) ""))

    ; A ready row retains every value needed to recompute the crossing.  The
    ; raw image is evidence of the compiler boundary; the admitted PIF and
    ; protocol values remain live Form values rather than log assertions.
    (defn fpbfl-ready-row
        (spec raw-image entry-index key pif container decode admission
         envelope binding caller capability call protocol receiver resolution)
        (list (fpbfl-ready-tag) spec raw-image entry-index key pif container
              decode admission envelope binding caller capability call
              protocol receiver resolution))
    (defn fpbfl-ready-shape? (result)
        (if (eq (len result) 17)
            (str_eq (head result) (fpbfl-ready-tag)) 0))
    (defn fpbfl-spec (result) (nth result 1))
    (defn fpbfl-raw-image (result) (nth result 2))
    (defn fpbfl-entry-index (result) (nth result 3))
    (defn fpbfl-key (result) (nth result 4))
    (defn fpbfl-pif (result) (nth result 5))
    (defn fpbfl-container (result) (nth result 6))
    (defn fpbfl-decode (result) (nth result 7))
    (defn fpbfl-admission (result) (nth result 8))
    (defn fpbfl-envelope (result) (nth result 9))
    (defn fpbfl-binding (result) (nth result 10))
    (defn fpbfl-caller (result) (nth result 11))
    (defn fpbfl-capability (result) (nth result 12))
    (defn fpbfl-call (result) (nth result 13))
    (defn fpbfl-protocol (result) (nth result 14))
    (defn fpbfl-receiver (result) (nth result 15))
    (defn fpbfl-resolution (result) (nth result 16))

    ; Every digest first reaches the existing Form-authored arm64 SHA recipe.
    ; A bulk-carrier miss stays distinct from the digest bytes and turns to the
    ; resident cursor, then the portable scalar recipe.  No miss is confused
    ; with hash("") or integer 0.
    (defn fpbfl-sha256-row (hash lane byte-count crossing)
        (list "bmf-full-pif-sha256-observation-v1"
            hash lane byte-count crossing))
    (defn fpbfl-sha256-row-hash (row) (nth row 1))
    (defn fpbfl-sha256-row-lane (row) (nth row 2))
    (defn fpbfl-sha256-row-crossing (row) (nth row 4))
    (defn fpbfl-decode-from-observation (bytes observation)
        (do
            (let crossing (fpbfl-sha256-row-crossing observation))
            (if (saj-carrier-ready? crossing)
                (pifsd-decode-string (saj-carrier-raw crossing))
                (pifbd-decode-bytes bytes))))
    (defn fpbfl-decode-canonical-bytes (bytes scope)
        (do
            (let crossing (saj-bytes-observe-bulk bytes scope))
            (if (saj-carrier-ready? crossing)
                (pifsd-decode-string (saj-carrier-raw crossing))
                (pifbd-decode-bytes bytes))))
    (defn fpbfl-sha256-observe (bytes)
        (do
            (let crossing
                (saj-bytes-digest-bulk bytes "bmf-full-pif"))
            (if (saj-bulk-ready? crossing)
                (fpbfl-sha256-row
                    (str_concat (sai-hash-prefix)
                        (hex-encode
                            (sai-string-bytes
                                (saj-bulk-digest crossing))))
                    "form-arm64-sha256-jit+local-byte-file-carrier"
                    (len bytes) crossing)
                (do
                    (let resident (saj-bytes-digest bytes))
                    (if (eq (str_len resident) 32)
                        (fpbfl-sha256-row
                            (str_concat (sai-hash-prefix)
                                (hex-encode
                                    (sai-string-bytes resident)))
                            "form-arm64-sha256-jit+resident-bounded-cursor"
                            (len bytes) crossing)
                        (fpbfl-sha256-row
                            (sai-sha256-hex bytes)
                            "scalar-form-sha256-fallback"
                            (len bytes) crossing))))))
    (defn fpbfl-sha256-hex (bytes)
        (fpbfl-sha256-row-hash (fpbfl-sha256-observe bytes)))
    (defn fpbfl-table-hash (table)
        (fpbfl-sha256-hex (pifbc-table-bytes table)))
    (defn fpbfl-table-hash-bytes (table-bytes)
        (fpbfl-sha256-hex table-bytes))
    (defn fpbfl-source-path (table-hash)
        (str_concat "generated:bounded-bmf-raw-state/" table-hash))
    (defn fpbfl-artifact-path (table-hash)
        (str_concat "resident:bmf-full-pif/" table-hash))
    (defn fpbfl-entry-key (table-hash)
        (str_concat "bmf/full-pif/" table-hash))
    (defn fpbfl-caller-key (table-hash)
        (str_concat "bmf/full-pif-caller/" table-hash))
    (defn fpbfl-capability-key (table-hash)
        (str_concat "capability/bmf-full-pif/" table-hash))

    (defn fpbfl-symbol-image (table entry-index key)
        (do
            (let root (nth (pif-table-fn-roots table) entry-index))
            (pif-symbol-image 1
                (list (pif-symbol-row 0 key))
                1
                (list (pif-node-symbol-row root 0 (empty))))))
    (defn fpbfl-pif-with-hash
        (table table-hash symbol-image content-hash)
        (pif-envelope-with-symbols
            (fpbfl-source-path table-hash) table-hash 1
            (fpbfl-artifact-path table-hash) content-hash 1 1
            table symbol-image))
    ; The canonical encoder otherwise rebuilds the 52 KiB table once for the
    ; table identity, once for the payload hash and once for the container.
    ; Carrying the exact already-encoded table bytes across those three pure
    ; stages makes the shared value explicit and leaves one encoding pass.
    (defn fpbfl-payload-bytes-with-table (pif table-bytes)
        (if (pif-envelope-valid? pif)
            (if (pifbc-metadata-encodable? pif)
                (if (pifbc-table-encodable? (pif-envelope-table pif))
                    (if (pifbc-symbol-image-encodable?
                            (pif-envelope-symbol-image pif)
                            (pif-envelope-table pif))
                        (append-list (pifbc-magic)
                        (append-list (u32-to-bytes (pifbc-byte-version))
                        (append-list (pifbc-string-bytes (pifbc-builder-id))
                        (append-list (pifbc-string-bytes
                            (pif-envelope-source-path pif))
                        (append-list (pifbc-string-bytes
                            (pif-envelope-source-hash pif))
                        (append-list (pifbc-signed-bytes
                            (pif-envelope-source-mtime pif))
                        (append-list (pifbc-string-bytes
                            (pif-envelope-artifact-path pif))
                        (append-list (pifbc-signed-bytes
                            (pif-envelope-seal-ok pif))
                        (append-list table-bytes
                            (pifbc-symbol-image-bytes
                                (pif-envelope-symbol-image pif)))))))))))
                        (empty))
                    (empty))
                (empty))
            (empty)))
    (defn fpbfl-finalized-row (pif bytes observation)
        (list "bmf-full-pif-finalized-v1" pif bytes observation))
    (defn fpbfl-finalized-pif (row) (nth row 1))
    (defn fpbfl-finalized-bytes (row) (nth row 2))
    (defn fpbfl-finalized-observation (row) (nth row 3))
    (defn fpbfl-finalized (table table-bytes table-hash symbol-image)
        (do
            ; Content-hash is excluded from canonical payload bytes, so this
            ; first valid envelope closes the hash without circular identity.
            (let provisional
                (fpbfl-pif-with-hash table table-hash symbol-image table-hash))
            (let payload-bytes
                (fpbfl-payload-bytes-with-table provisional table-bytes))
            (let carrier
                (saj-bytes-observe-bulk
                    payload-bytes "bmf-full-pif-payload"))
            (let observation
                (if (saj-carrier-ready? carrier)
                    (fpbfl-sha256-row
                        (str_concat (sai-hash-prefix)
                            (hex-encode (sai-string-bytes
                                (saj-carrier-digest carrier))))
                        "form-arm64-sha256-jit+local-byte-file-carrier"
                        (len payload-bytes) carrier)
                    (fpbfl-sha256-observe payload-bytes)))
            (let content-hash (fpbfl-sha256-row-hash observation))
            (fpbfl-finalized-row
                (fpbfl-pif-with-hash
                    table table-hash symbol-image content-hash)
                payload-bytes observation)))
    (defn fpbfl-final-pif (table table-hash symbol-image)
        (do
            (let table-bytes (pifbc-table-bytes table))
            (fpbfl-finalized-pif
                (fpbfl-finalized
                    table table-bytes table-hash symbol-image))))

    (defn fpbfl-content-vouch-observed (pif bytes observation)
        (do
            (let expected (pif-envelope-content-hash pif))
            (let actual (fpbfl-sha256-row-hash observation))
            (sai-vouch (sai-target-content-hash)
                (pif-envelope-artifact-path pif)
                (str_concat "supplied-byte-list+"
                    (fpbfl-sha256-row-lane observation))
                expected actual (sai-status-for expected actual)
                (len bytes) (len bytes))))
    (defn fpbfl-content-vouch (pif bytes)
        (fpbfl-content-vouch-observed
            pif bytes (fpbfl-sha256-observe bytes)))
    (defn fpbfl-container-from-envelope-bytes-observed
        (pif bytes observation)
        (if (not (pif-envelope? pif))
            (pifbc-container pif (empty) (pifbc-empty-vouch)
                (pifbc-status-refused) (pifbc-reason-malformed-envelope))
        (if (not (pif-envelope-valid? pif))
            (pifbc-container pif (empty) (pifbc-empty-vouch)
                (pifbc-status-refused) (pifbc-reason-invalid-envelope))
        (if (not (pifbc-metadata-encodable? pif))
            (pifbc-container pif (empty) (pifbc-empty-vouch)
                (pifbc-status-investigate)
                (pifbc-reason-non-encodable-metadata))
        (if (not (pifbc-table-encodable? (pif-envelope-table pif)))
            (pifbc-container pif (empty) (pifbc-empty-vouch)
                (pifbc-status-investigate)
                (pifbc-reason-non-encodable-table))
        (if (not (pifbc-symbol-image-encodable?
                    (pif-envelope-symbol-image pif)
                    (pif-envelope-table pif)))
            (pifbc-container pif (empty) (pifbc-empty-vouch)
                (pifbc-status-investigate)
                (pifbc-reason-non-encodable-symbols))
            (do
                (let vouch
                    (fpbfl-content-vouch-observed pif bytes observation))
                (if (sai-vouch-match? vouch)
                    (pifbc-container pif bytes vouch
                        (pifbc-status-ready) (pifbc-reason-ready))
                    (if (str_eq (sai-vouch-status vouch)
                                (sai-status-malformed))
                        (pifbc-container pif bytes vouch
                            (pifbc-status-refused)
                            (pifbc-reason-content-hash-malformed))
                        (pifbc-container pif bytes vouch
                            (pifbc-status-investigate)
                            (pifbc-reason-content-hash-mismatch)))))))))))
    (defn fpbfl-container-from-envelope-bytes (pif bytes)
        (fpbfl-container-from-envelope-bytes-observed
            pif bytes (fpbfl-sha256-observe bytes)))
    (defn fpbfl-container-from-envelope (pif)
        (fpbfl-container-from-envelope-bytes
            pif (pifbc-payload-bytes pif)))
    (defn fpbfl-load-envelope (pif)
        (do
            (let source (pif-source-from-envelope pif))
            (let fkb (pif-descriptor-from-envelope pif))
            (rale-envelope-from-selection source fkb (sad-no-artifact)
                (ras-selection-from-plan
                    (rap-plan-from-descriptors
                        source fkb (sad-no-artifact))))))
    (defn fpbfl-witness (pif key)
        (list (fpbfl-version) key (pif-envelope-content-hash pif)))

    (defn fpbfl-build-from-image (spec raw-image)
        ; fpbfl-lower supplies this image in the same lexical movement as
        ; fprsl-lower. Grammar ancestry is witnessed once by fpbfl-observed?;
        ; resident execution rechecks the content-vouched image, not its whole
        ; authoring history, before every OFFER.
        (if (not (fprsl-image-shape? raw-image))
            (fpbfl-refused "raw-state-image-refused")
        (if (not (value_eq spec (nth raw-image 2)))
            (fpbfl-refused "raw-state-spec-mismatch")
            (do
                (let ir (nth raw-image 3))
                (let linked (fpis-link ir))
                (if (not (fpis-linked? linked))
                    (fpbfl-refused "raw-state-link-refused")
                    (do
                        (let table (fpis-table linked))
                        (let entry-index (fpis-label-index
                            (nth ir 1) (fprsl-label-entry)))
                        (if (lt entry-index 0)
                            (fpbfl-refused "raw-state-entry-missing")
                            (do
                                (let table-bytes (pifbc-table-bytes table))
                                (let table-hash
                                    (fpbfl-table-hash-bytes table-bytes))
                                (let key (fpbfl-entry-key table-hash))
                                (let symbols (fpbfl-symbol-image
                                    table entry-index key))
                                (let finalized (fpbfl-finalized
                                    table table-bytes table-hash symbols))
                                (let pif (fpbfl-finalized-pif finalized))
                                (let container
                                    (fpbfl-container-from-envelope-bytes-observed
                                        pif
                                        (fpbfl-finalized-bytes finalized)
                                        (fpbfl-finalized-observation finalized)))
                                (if (not (pifbc-ready? container))
                                    (fpbfl-refused "content-vouch-refused")
                                    (do
                                        (let observation
                                            (fpbfl-finalized-observation
                                                finalized))
                                        (let decode
                                            (fpbfl-decode-from-observation
                                                (pifbc-container-bytes
                                                    container)
                                                observation))
                                        (if (not (pifbd-decoded? decode))
                                            (fpbfl-refused
                                                "canonical-decode-refused")
                                            (do
                                                (let admission
                                                    (pifbd-admitted-row
                                                        (fpbfl-witness pif key)
                                                        decode pif))
                                                (let envelope
                                                    (fpbfl-load-envelope pif))
                                                (let recipe
                                                    (fpcpf-pirc-envelope pif))
                                                (let binding
                                                    (fpcpf-binding key recipe))
                                                (let caller (fpcpf-binding
                                                    (fpbfl-caller-key table-hash)
                                                    recipe))
                                                (let capability
                                                    (intern_trivial_string
                                                        (fpbfl-capability-key
                                                            table-hash)))
                                                (let call (fpcpf-call-binding
                                                    caller (fpbfl-call-name)
                                                    binding capability))
                                                (let protocol (fpcpf-registry
                                                    (list caller binding)
                                                    (list capability)
                                                    (list call)))
                                                (let request
                                                    (pise-request-by-canonical-key
                                                        key))
                                                (let receiver (fpcpf-receiver
                                                    binding envelope admission
                                                    request))
                                                (let resolution
                                                    (pise-resolve pif request))
                                                (if (not (and
                                                        (fpcpf-registry-valid?
                                                            protocol)
                                                        (and
                                                            (fpcpf-receiver-valid?
                                                                receiver)
                                                            (and
                                                                (pise-resolution?
                                                                    resolution)
                                                                (str_eq
                                                                    (pise-resolution-status
                                                                        resolution)
                                                                    (pise-status-ready))))))
                                                    (fpbfl-refused
                                                        "full-pif-admission-refused")
                                                    (fpbfl-ready-row spec
                                                        raw-image entry-index
                                                        key pif container decode
                                                        admission envelope
                                                        binding caller capability
                                                        call protocol
                                                        receiver
                                                        resolution))))))))))))))

    (defn fpbfl-lower (spec)
        (do
            (let raw-image (fprsl-lower spec))
            (if (fprsl-refused? raw-image)
                (fpbfl-refused
                    (str_concat "raw-state-" (fprsl-reason raw-image)))
                (fpbfl-build-from-image spec raw-image))))

    ; Hot readiness validates the already-born immutable values and their
    ; admitted relationships.  It does not re-encode, re-hash or re-decode the
    ; image.  Those O(image bytes) birth witnesses live in fpbfl-observed?;
    ; OFFER execution remains proportional only to the offered raw cursor.
    (defn fpbfl-ready? (result)
        (if (not (fpbfl-ready-shape? result)) 0
            (do
                (let spec (fpbfl-spec result))
                (let raw-image (fpbfl-raw-image result))
                (if (not (and (fprsl-image-shape? raw-image)
                              (value_eq spec (nth raw-image 2)))) 0
                    (do
                        (let ir (nth raw-image 3))
                        (let linked (fpis-link ir))
                        (if (not (fpis-linked? linked)) 0
                            (do
                                (let table (fpis-table linked))
                                (let entry-index (fpis-label-index
                                    (nth ir 1) (fprsl-label-entry)))
                                (let pif (fpbfl-pif result))
                                (let table-hash
                                    (pif-envelope-source-hash pif))
                                (let key (fpbfl-entry-key table-hash))
                                (let container (fpbfl-container result))
                                (let bytes
                                    (pifbc-container-bytes container))
                                (let vouch
                                    (pifbc-container-vouch container))
                                (let decode (fpbfl-decode result))
                                (let payload (pifbd-decode-payload decode))
                                (let admission (fpbfl-admission result))
                                (if (not (fpbfl-all? (list
                                    (ge entry-index 0)
                                    (eq (fpbfl-entry-index result) entry-index)
                                    (str_eq (fpbfl-key result) key)
                                    (pif-envelope-valid? pif)
                                    (value_eq (pif-envelope-table pif) table)
                                    (value_eq
                                        (pif-envelope-symbol-image pif)
                                        (fpbfl-symbol-image
                                            table entry-index key))
                                    (str_eq (pif-envelope-source-path pif)
                                        (fpbfl-source-path table-hash))
                                    (str_eq (pif-envelope-source-hash pif)
                                        table-hash)
                                    (str_eq (pif-envelope-artifact-path pif)
                                        (fpbfl-artifact-path table-hash))
                                    (pifbc-ready? container)
                                    (value_eq (pifbc-container-pif container)
                                        pif)
                                    (sai-vouch-match? vouch)
                                    (str_eq (sai-vouch-expected-hash vouch)
                                        (pif-envelope-content-hash pif))
                                    (str_eq (sai-vouch-actual-hash vouch)
                                        (pif-envelope-content-hash pif))
                                    (eq (sai-vouch-material-size vouch)
                                        (len bytes))
                                    (pifbd-decoded? decode)
                                    (eq (pifbd-decode-next decode) (len bytes))
                                    (pifbd-payload-source-matches-pif?
                                        payload pif)
                                    (pifbd-payload-artifact-path-matches-pif?
                                        payload pif)
                                    (pifbd-payload-seal-matches-pif?
                                        payload pif)
                                    (value_eq (pifbd-payload-table payload)
                                        table)
                                    (value_eq
                                        (pifbd-payload-symbol-image payload)
                                        (pif-envelope-symbol-image pif))
                                    (pifbd-admitted? admission)
                                    (value_eq admission
                                        (pifbd-admitted-row
                                            (fpbfl-witness pif key)
                                            decode pif))
                                    (pise-resolution? (fpbfl-resolution result))
                                    (str_eq (pise-resolution-status
                                            (fpbfl-resolution result))
                                        (pise-status-ready))
                                    (eq (pise-resolution-entry-index
                                            (fpbfl-resolution result))
                                        entry-index)
                                    (value_eq (fpbfl-envelope result)
                                        (fpbfl-load-envelope pif))
                                    (node_eq (fpbfl-binding result)
                                        (fpcpf-binding key
                                            (fpcpf-pirc-envelope pif)))
                                    (node_eq (fpbfl-caller result)
                                        (fpcpf-binding
                                            (fpbfl-caller-key table-hash)
                                            (fpcpf-pirc-envelope pif)))
                                    (node_eq (fpbfl-capability result)
                                        (intern_trivial_string
                                            (fpbfl-capability-key table-hash)))
                                    (node_eq (fpbfl-call result)
                                        (fpcpf-call-binding
                                            (fpbfl-caller result)
                                            (fpbfl-call-name)
                                            (fpbfl-binding result)
                                            (fpbfl-capability result)))
                                    (fpcpf-registry-valid?
                                        (fpbfl-protocol result))
                                    (fpcpf-receiver-valid?
                                        (fpbfl-receiver result))))) 0
                                    (if (and
                                        (node_eq (fpbfl-protocol result)
                                            (fpcpf-registry
                                                (list (fpbfl-caller result)
                                                    (fpbfl-binding result))
                                                (list
                                                    (fpbfl-capability result))
                                                (list (fpbfl-call result))))
                                        (value_eq (fpbfl-receiver result)
                                            (fpcpf-receiver
                                                (fpbfl-binding result)
                                                (fpbfl-envelope result)
                                                admission
                                                (pise-request-by-canonical-key
                                                    key)))) 1 0)))))))))

    ; Cold provenance re-observes compiler ancestry, table identity and the
    ; canonical decoder.  It is a birth/persistence boundary, never a per-OFFER
    ; toll.  The string-cursor decoder can replace the legacy list decoder at
    ; this one seam without changing the hot protocol.
    (defn fpbfl-observed? (result)
        (if (not (fpbfl-ready? result)) 0
            (do
                (let fresh (fprsl-lower (fpbfl-spec result)))
                (if (not (fprsl-image-shape? fresh)) 0
                    (if (not (value_eq fresh (fpbfl-raw-image result))) 0
                        (do
                            (let pif (fpbfl-pif result))
                            (let table (pif-envelope-table pif))
                            (let bytes (pifbc-container-bytes
                                (fpbfl-container result)))
                            (and
                                (str_eq (fpbfl-table-hash table)
                                    (pif-envelope-source-hash pif))
                                (value_eq (fpbfl-decode result)
                                    (fpbfl-decode-canonical-bytes bytes
                                        "bmf-full-pif-observed")))))))))

    (defn fpbfl-offer (result raw fuel correlation)
        (fpcpf-offer (fpbfl-call result) correlation
            (list (fpcpf-value (rpmw-kind-string) raw)) fuel))

    ; The hot handle is the immutable, already-admitted relation born above.
    ; Its NodeIDs and retained resolution are enough to enter the resident
    ; micro-walker; byte sealing and whole-image validation remain cold.
    (defn fpbfl-hot-ready? (result)
        (if (not (fpbfl-ready-shape? result)) 0
            (do
                (let resolution (fpbfl-resolution result))
                (if (not (pise-resolution? resolution)) 0
                (if (not (str_eq (pise-resolution-status resolution)
                                 (pise-status-ready))) 0
                (if (not (eq (pise-resolution-entry-index resolution)
                             (fpbfl-entry-index result))) 0
                (if (not (node_eq (fpbfl-binding result)
                                  (fpcpf-receiver-binding
                                      (fpbfl-receiver result)))) 0
                    1)))))))
    (defn fpbfl-hot-walk (result offer raw fuel)
        (do
            (let pif (fpbfl-pif result))
            (let resolution (fpbfl-resolution result))
            (let input-kind (rpmw-kind-string))
            (let micro (rpmw-walk-after-valid-entry-with-kind
                (fpbfl-envelope result) (fpbfl-admission result)
                (fpbfl-entry-index result) fuel raw input-kind pif
                (pise-resolution-root-node resolution)))
            (let walk (rpsw-produced-with-kind
                (fpbfl-envelope result) (fpbfl-admission result)
                (fpcpf-receiver-request (fpbfl-receiver result))
                fuel raw input-kind resolution micro
                (rpmw-receipt-trace micro)))
            (fpcpf-result-receipt (fpbfl-protocol result) offer walk)))
    (defn fpbfl-execute (result raw fuel correlation)
        (if (not (fpbfl-hot-ready? result)) (nothing)
            (do
                (let offer (fpbfl-offer result raw fuel correlation))
                (if (not (fpcpf-offer-valid? offer)) (nothing)
                    (fpbfl-hot-walk result offer raw fuel)))))
    (defn fpbfl-receipt-observed? (result receipt)
        (if (not (fpbfl-hot-ready? result)) 0
        (if (not (fpcpf-receipt? receipt)) 0
            (do
                (let offer (fpcpf-receipt-offer receipt))
                (if (not (fpcpf-offer-valid? offer)) 0
                    (do
                        (let values (fpcpf-offer-values offer))
                        (if (not (eq (len values) 1)) 0
                            (do
                                (let fresh (fpbfl-execute result
                                    (fpcpf-value-raw (head values))
                                    (node_value (fpcp-child offer 3))
                                    (fpcp-child offer 1)))
                                (if (not (fpcpf-receipt? fresh)) 0
                                (if (not (node_eq
                                        (fpcpf-receipt-ack receipt)
                                        (fpcpf-receipt-ack fresh))) 0
                                    (do
                                        (let held-walk
                                            (fpcpf-receipt-symbol-walk
                                                receipt))
                                        (let fresh-walk
                                            (fpcpf-receipt-symbol-walk fresh))
                                        (if (not (and
                                                (rpsw-receipt? held-walk)
                                                (rpsw-receipt? fresh-walk))) 0
                                            (and
                                                (str_eq
                                                    (rpsw-receipt-status
                                                        held-walk)
                                                    (rpsw-receipt-status
                                                        fresh-walk))
                                                (and
                                                    (rpsw-trace-fields-match?
                                                        (rpsw-receipt-trace
                                                            held-walk)
                                                        (rpsw-receipt-trace
                                                            fresh-walk))
                                                    (fpcpf-micro-equal?
                                                        (rpsw-receipt-micro-walk
                                                            held-walk)
                                                        (rpsw-receipt-micro-walk
                                                            fresh-walk))))))))))))))))

    0)
