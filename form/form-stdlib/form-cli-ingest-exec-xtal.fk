
(let ExecHit (language-template-with-members "ExecHit" (list "TPath") (list (language-template-member "path" "TPath") (language-template-member "value" "int") (language-template-member "observe" "String"))))
(defn IngestExecAuthorityPath () "form/form-stdlib/bml/form-cli-ingest-exec.bml")
(defn IngestExecAuthorityKind () "high-bml-class-template-field")
(defn FormIngestExecAuthority () (list "abstraction" "FormIngestExecAuthority" (list) (list) (list "IngestExecAuthorityPath" "IngestExecAuthorityKind") (list) (list)))
(defn SameCells () 1)
(defn DiffCells () 2)
(defn DeepYes () 1)
(defn DeepNo () 0)
(defn NamedOnly () 0)
(defn Lesson () 1)
(defn Claim () 2)
(defn CollapsePath () "ingest/equivalence-collapse.fk")
(defn DepthPath () "ingest/knowledge-ingest.fk")
(defn NboPath () "ingest/name-build-observe.fk")
(defn fie-authority () FormIngestExecAuthority)
(defn fie-pattern () (list "native-return" "ec-cells2" "ki-deep" "nbo-enter"))
(defn fie-same () (ec-cells2 (list 7) (list 7)))
(defn fie-diff () (ec-cells2 (list 7) (list 9)))
(defn fie-deep () (ki-deep? (list 3 0)))
(defn fie-shallow () (ki-deep? (list 1 0)))
(defn fie-named () (nbo-enter (list 1 0 0)))
(defn fie-lesson () (nbo-enter (list 1 1 0)))
(defn fie-claim () (nbo-enter (list 1 1 1)))
(defn fie-collapse-observe () (str_concat "native ec-cells2 same=" (str_concat (int_to_str (fie-same)) (str_concat " different=" (int_to_str (fie-diff))))))
(defn fie-depth-observe () (str_concat "native ki-deep? 3=" (str_concat (int_to_str (fie-deep)) (str_concat " 1=" (int_to_str (fie-shallow))))))
(defn fie-nbo-observe () (str_concat "native nbo-enter named=" (str_concat (int_to_str (fie-named)) (str_concat " lesson=" (str_concat (int_to_str (fie-lesson)) (str_concat " claim=" (int_to_str (fie-claim))))))))
(defn fie-observe (path) (if (str_eq path (CollapsePath)) (fie-collapse-observe) (if (str_eq path (DepthPath)) (fie-depth-observe) (if (str_eq path (NboPath)) (fie-nbo-observe) ""))))
(defn fie-bit (ok bit) (if ok bit 0))
(defn fie-check () (do (let c0 (fie-bit (eq (fie-same) (SameCells)) 1)) (let c1 (fie-bit (eq (fie-diff) (DiffCells)) 2)) (let c2 (fie-bit (eq (fie-deep) (DeepYes)) 4)) (let c3 (fie-bit (eq (fie-shallow) (DeepNo)) 8)) (let c4 (fie-bit (and (eq (fie-named) (NamedOnly)) (and (eq (fie-lesson) (Lesson)) (eq (fie-claim) (Claim)))) 16)) (let c5 (fie-bit (ge (str_find (fie-collapse-observe) "same=1" 0) 0) 32)) (let c6 (fie-bit (ge (str_find (fie-depth-observe) "3=1" 0) 0) 64)) (let c7 (fie-bit (and (str_eq (fie-observe (CollapsePath)) (fie-collapse-observe)) (str_eq (fie-observe "other") "")) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormIngestExec () (list "abstraction" "FormIngestExec" (list "T") (list "fie-same" "fie-diff" "fie-deep" "fie-shallow" "fie-named" "fie-lesson" "fie-claim" "fie-collapse-observe" "fie-depth-observe" "fie-nbo-observe" "fie-observe" "fie-bit" "fie-check") (list "SameCells" "DiffCells" "DeepYes" "DeepNo" "NamedOnly" "Lesson" "Claim" "CollapsePath" "DepthPath" "NboPath") (list "fie-authority") (list "fie-pattern")))
0
