//////////////////////////////////////////////////////////////////////
//
// form-cli-lane-mint.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-lane-mint.bml
//
// Every skill from the four mills asked on every query lane.
// Overlay class is the lane so the tongue generalizes: same cell,
// different question-kind. Cartesian n = skills * lanes * (tn+hn).
//
// Proven by: form-stdlib/tests/form-cli-lane-mint-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SampleRow<TClass> {
        member split: String;
        member className: TClass;
        member situation: String;
    }

    class FormLaneMintAuthority {
        field MintAuthorityPath = "form/form-stdlib/bml/form-cli-lane-mint.bml";
        field MintAuthorityKind = "high-bml-class-template-field";
    }

    class FormLaneMint<T> {
        field MixA = 7;
        field MixB = 13;
        field NSkills = 41;
        field NLanes = 9;
        field LoraWriter = 0;
        field SplitTrain = "train";
        field SplitHeldout = "heldout";

        ref fln-authority = FormLaneMintAuthority;
        thought fln-pattern = list("cartesian", "inquiry-plane", "knowledge-query", "form-cli-walk");
        thought fln-lanes = list("when", "where", "which", "what", "who", "how", "why", "knowledge-query", "walk");
        thought fln-computable = list("when", "where", "which");
        thought fln-skills = list("bml", "bmf", "lift-sexp", "node-lookup", "craft-cell", "framebuffer", "micro-thought", "evaluate", "channel", "protocol", "axiom", "satsang", "nothing", "timeout", "trust", "choice-undo", "embodied-memory", "assemblage", "human-design", "gene-keys", "astrology", "physics", "chemistry", "biology", "quantum", "math", "logic", "shape-match", "time-direction", "phase", "frequency", "vitality", "consent", "four-way", "collapse", "jit", "iching", "codon", "ifs", "organic", "rag-heed");
        thought fln-sources = list("presence/inquiry-planes.fk", "form/form-stdlib/form-cli-qwen-teach-layer.fk", "form/form-stdlib/form-cli-universe-mint.bml", "form/form-stdlib/form-cli-unique-mint.bml", "form/form-stdlib/form-cli-domain-mint.bml", "form/form-stdlib/form-cli-organ-mint.bml");

        def fln-mix(i, n) = mod(add(mul(i, MixA()), MixB()), n);

        def fln-gloss-of(pairs, skill) = if eq(len(pairs), 0) then skill else if str_eq(nth(head(pairs), 0), skill) then nth(head(pairs), 1) else fln-gloss-of(tail(pairs), skill);

        def fln-glosses() = list(list("bml", "BML executable source authority"), list("bmf", "scannerless BMF byte-fold no tokenizer"), list("lift-sexp", "form.lift s-expression to infix thought"), list("node-lookup", "knowledge-query envelope anchor then path"), list("craft-cell", "NodeID Blueprint Recipe Cell intern"), list("framebuffer", "execute observe control re-observe"), list("micro-thought", "thought kernel inquiry plane abstain"), list("evaluate", "walker recipe typed observation release"), list("channel", "CHANNEL-V0 honor interface never invade"), list("protocol", "run and speak are one offer"), list("axiom", "five axioms then theorems"), list("satsang", "circle witnesses dissent stays visible"), list("nothing", "first-class silence not a missing zero"), list("timeout", "budget ended alternatives untried"), list("trust", "receipts before trust judged not credulity"), list("choice-undo", "choice and undo are native primitives"), list("embodied-memory", "checkpoint value not a reasoning chain"), list("assemblage", "switch frame by aliveness not success"), list("human-design", "rave mandala date becomes a gate"), list("gene-keys", "shadow gift siddhi hologenetic profile"), list("astrology", "one sky two astrologies ayanamsa"), list("physics", "force energy wave field from the 64"), list("chemistry", "bond is hold as one whole depth three"), list("biology", "life grow sense a living cell"), list("quantum", "observer-effect named as a borrow"), list("math", "number set function proof"), list("logic", "backward-chaining goal forward axioms"), list("shape-match", "nearest-shape agreeing bins no float"), list("time-direction", "Julian Day north star moves"), list("phase", "ice water gas orthogonal to substance"), list("frequency", "fear-love spectrum from text"), list("vitality", "weakest life-good first extraction loses"), list("consent", "exposure rests closed carrier reads Form"), list("four-way", "Go Rust TypeScript fkwu no trusted prover"), list("collapse", "same Blueprint one cell link restatements"), list("jit", "hot and pure crystallizes hysteresis"), list("iching", "three tongues one cell two different 64s"), list("codon", "amino-acid rings not a faked codon table"), list("ifs", "Self protectors exiles eight C faces"), list("organic", "pattern adapt body feel flow rhythm"), list("rag-heed", "grounded NodeID envelope then prefill"));

        def fln-gloss(skill) = fln-gloss-of(fln-glosses(), skill);

        def fln-ask(lane, gloss) = if str_eq(lane, "when") then str_concat("When is this computable: ", gloss) else if str_eq(lane, "where") then str_concat("Where is the NodeID for: ", gloss) else if str_eq(lane, "which") then str_concat("Which cell answers: ", gloss) else if str_eq(lane, "what") then str_concat("What is: ", gloss) else if str_eq(lane, "who") then str_concat("Who offers: ", gloss) else if str_eq(lane, "how") then str_concat("How does the body: ", gloss) else if str_eq(lane, "why") then str_concat("Why does Form: ", gloss) else if str_eq(lane, "knowledge-query") then str_concat("Emit knowledge-query envelope ANCHOR PATH for: ", gloss) else str_concat("Walk native then local then remote for: ", gloss);

        def fln-prefix(split) = if str_eq(split, SplitTrain()) then "Observed " else "Boundary: observed ";

        def fln-situation(skill, lane, i, split) = str_concat(fln-prefix(split), str_concat(fln-ask(lane, fln-gloss(skill)), str_concat(" case ", int_to_str(i))));

        def fln-row(skill, lane, i, split) = list(split, lane, fln-situation(skill, lane, i, split));

        def fln-i-rows(skill, lane, i, n, split, acc) = if eq(i, n) then acc else fln-i-rows(skill, lane, add(i, 1), n, split, cons(fln-row(skill, lane, i, split), acc));

        def fln-lane-rows(skill, lanes, n, split, acc) = if eq(len(lanes), 0) then acc else fln-lane-rows(skill, tail(lanes), n, split, fln-i-rows(skill, head(lanes), 0, n, split, acc));

        def fln-skill-rows(skills, tn, hn, acc) = if eq(len(skills), 0) then acc else fln-skill-rows(tail(skills), tn, hn, fln-lane-rows(head(skills), fln-lanes(), hn, SplitHeldout(), fln-lane-rows(head(skills), fln-lanes(), tn, SplitTrain(), acc)));

        def fln-corpus(tn, hn) = fln-skill-rows(fln-skills(), tn, hn, tail(list("x")));

        def fln-n(tn, hn) = mul(len(fln-skills()), mul(len(fln-lanes()), add(tn, hn)));

        def fln-has-situation(rows, s) = if eq(len(rows), 0) then 0 else if str_eq(nth(head(rows), 2), s) then 1 else fln-has-situation(tail(rows), s);

        def fln-train-only(rows, acc) = if eq(len(rows), 0) then acc else if str_eq(nth(head(rows), 0), SplitTrain()) then fln-train-only(tail(rows), cons(head(rows), acc)) else fln-train-only(tail(rows), acc);

        def fln-leakage-loop(all, rows) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), SplitHeldout()) then fln-has-situation(fln-train-only(all, tail(list("x"))), nth(head(rows), 2)) else 0, fln-leakage-loop(all, tail(rows)));

        def fln-leakage(rows) = fln-leakage-loop(rows, rows);

        def fln-unique-loop(rows, seen) = if eq(len(rows), 0) then len(seen) else if eq(fln-has-situation(seen, nth(head(rows), 2)), 1) then fln-unique-loop(tail(rows), seen) else fln-unique-loop(tail(rows), cons(head(rows), seen));

        def fln-unique(rows) = fln-unique-loop(rows, tail(list("x")));

        def fln-count-split(rows, split) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), split) then 1 else 0, fln-count-split(tail(rows), split));

        def fln-lora-writer() = LoraWriter();

        def fln-mix-diverse() = if eq(fln-mix(0, 9), fln-mix(1, 9)) then 0 else 1;

        def fln-pair-hit(rows, skill, lane) = fln-has-situation(rows, fln-situation(skill, lane, 0, SplitTrain()));

        def fln-lane-cover(rows, skill, lanes) = if eq(len(lanes), 0) then 1 else if eq(fln-pair-hit(rows, skill, head(lanes)), 0) then 0 else fln-lane-cover(rows, skill, tail(lanes));

        def fln-skill-cover(rows, skills) = if eq(len(skills), 0) then 1 else if eq(fln-lane-cover(rows, head(skills), fln-lanes()), 0) then 0 else fln-skill-cover(rows, tail(skills));

        def fln-covers-all(rows) = fln-skill-cover(rows, fln-skills());

        def fln-computable?(lane) = if str_eq(lane, "when") then 1 else if str_eq(lane, "where") then 1 else if str_eq(lane, "which") then 1 else 0;

        def fln-predict(models, names, s) = nth(names, fqt-predict-index(models, s));

        def fln-heldout-hit(models, names, row) = if str_eq(nth(row, 0), SplitHeldout()) then if str_eq(fln-predict(models, names, nth(row, 2)), nth(row, 1)) then 1 else 0 else 0;

        def fln-heldout-correct-loop(models, names, rows) = if eq(len(rows), 0) then 0 else add(fln-heldout-hit(models, names, head(rows)), fln-heldout-correct-loop(models, names, tail(rows)));

        def fln-heldout-correct(rows) {
            let names = fln-lanes();
            let models = fqt-fit(rows, names);
            fln-heldout-correct-loop(models, names, rows);
        }

        def fln-bit(ok, bit) = if ok then bit else 0;

        def fln-check() {
            let rows = fln-corpus(1, 1);
            let n = fln-n(1, 1);
            let correct = fln-heldout-correct(rows);
            let c0 = fln-bit(eq(n, 738), 1);
            let c1 = fln-bit(eq(fln-mix-diverse(), 1), 2);
            let c2 = fln-bit(eq(fln-leakage(rows), 0), 4);
            let c3 = fln-bit(eq(fln-unique(rows), n), 8);
            let c4 = fln-bit(and(eq(fln-count-split(rows, SplitTrain()), 369), eq(fln-count-split(rows, SplitHeldout()), 369)), 16);
            let c5 = fln-bit(ge(correct, 328), 32);
            let c6 = fln-bit(eq(fln-lora-writer(), 0), 64);
            let c7 = fln-bit(and(eq(fln-covers-all(rows), 1), and(eq(fln-computable?("when"), 1), eq(fln-computable?("why"), 0))), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
