// form-cli-nodeid-knowledge-resident.fk -- the strict concept route and its
// current source answer stay inside the resident form-cli process.
//
// The mapping is the persisted content-addressed body, never a function or
// operations table:
//
//   SHA256(concept) -> one bounded .route -> one bounded .psci source record
//                   -> one current repo source snapshot
//
// A route is admitted only when its key hash, source/entry content keys, source
// coordinate, current byte count, and current SHA-256 all agree.  The answer is
// cut from the same immutable snapshot whose identity is checked, then the file
// is rehashed once before return.  Missing, ambiguous, malformed, stale, and
// timeout remain typed outcomes.  A leading @ is refused without opening the
// old linear NodeID fallback.  No host-exec, HTTP, model, Metal, flattening, or
// ambient source-path argument participates.
//
// On a hit the correlated held/current source tokens, answer, outcome, counts,
// and lifecycle are offered to the resident content-addressed thought image.
// That image returns present 1 only when every binding agrees; a non-hit does
// not walk and retains exact nothing with output-count 0.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
// preludes: form-stdlib/bmf-core.fk
// preludes: form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-fs.fk
// preludes: form-stdlib/form-knowledge-source-search.fk
// preludes: form-stdlib/form-cli-heed-current-source.fk
// preludes: form-stdlib/form-cli-current-answer-thought-walk.fk
section [form.bml] {
    def fcnkr-schema() = "form-cli-nodeid-knowledge-resident-v1";
    def fcnkr-route-schema() = "psckr-reference-v1";
    def fcnkr-source-schema() = "pscish-entry-v2";
    def fcnkr-source-node-schema() = "public-source-artifact-node-v1";
    def fcnkr-max-key-bytes() = 64;
    def fcnkr-max-path-bytes() = 320;
    def fcnkr-max-route-bytes() = 2048;
    def fcnkr-max-source-row-bytes() = 2048;
    def fcnkr-max-candidates() = 64;
    def fcnkr-open() = "<|form:nodeid-knowledge-query|>";
    def fcnkr-close() = "<|/form:nodeid-knowledge-query|>";
    def fcnkr-max-payload-bytes() = 96;
    def fcnkr-max-frame-bytes() = str_len(fcnkr-open()) + (fcnkr-max-payload-bytes() + str_len(fcnkr-close()));
    def fcnkr-byte-key?(b) = b >= 97 && b <= 122 || (b >= 48 && b <= 57 || (Comparable) b == 45) ? 1 : 0;
    def fcnkr-key-loop?(key, at) = at >= str_len(key) ? 1 : (Comparable) fcnkr-byte-key?(str_byte_at(key, at)) == 1 ? fcnkr-key-loop?(key, at + 1) : 0;
    def fcnkr-key-valid?(key) = (Comparable) str_len(key) == 0 || str_len(key) > fcnkr-max-key-bytes() ? 0 : fcnkr-key-loop?(key, 0);
    def fcnkr-keys-valid-loop?(keys, count) = nil?(keys) ? count > 0 && count <= 6 ? 1 : 0 : (Comparable) fcnkr-key-valid?(head(keys)) == 0 ? 0 : fcnkr-keys-valid-loop?(tail(keys), count + 1);
    def fcnkr-keys-valid?(keys) = fcnkr-keys-valid-loop?(keys, 0);
    def fcnkr-lower-byte(b) = b >= 65 && b <= 90 ? b + 32 : b;
    def fcnkr-normalize-byte?(b) = b >= 97 && b <= 122 || b >= 48 && b <= 57 ? 1 : 0;
    def fcnkr-normalize-loop(raw, at, max, out, pending-separator) = at >= str_len(raw) || str_len(out) >= max ? out : {
        let b = fcnkr-lower-byte(str_byte_at(raw, at));
        (Comparable) fcnkr-normalize-byte?(b) == 1 ? {
            let room = max - str_len(out);
            let separated = (Comparable) pending-separator == 1 && str_len(out) > 0 ? room > 1 ? str_concat(out, "-") : out : out;
            str_len(separated) >= max ? separated : fcnkr-normalize-loop(raw, at + 1, max, str_concat(separated, byte_to_str(b)), 0);
        } : fcnkr-normalize-loop(raw, at + 1, max, out, str_len(out) > 0 ? 1 : 0);
    };
    def fcnkr-normalize(raw, max) = fcnkr-normalize-loop(raw, 0, max, "", 0);
    def fcnkr-clip-key(key) = str_len(key) <= fcnkr-max-key-bytes() ? key : substring(key, 0, fcnkr-max-key-bytes());
    def fcnkr-path-stem(path) = {
        let base = fs-path-basename(path);
        let ext = fs-path-extension(base);
        (String) ext == "" ? base : substring(base, 0, str_len(base) - str_len(ext));
    };
    def fcnkr-ends-with?(s, suffix) = str_len(s) < str_len(suffix) ? 0 : (String) substring(s, str_len(s) - str_len(suffix), str_len(s)) == suffix ? 1 : 0;
    def fcnkr-source-extension?(path) = (Comparable) fcnkr-ends-with?(path, ".fk") == 1 || ((Comparable) fcnkr-ends-with?(path, ".bml") == 1 || ((Comparable) fcnkr-ends-with?(path, ".bmf") == 1 || ((Comparable) fcnkr-ends-with?(path, ".form") == 1 || (Comparable) fcnkr-ends-with?(path, ".md") == 1))) ? 1 : 0;
    // This is the source-family schema carried as Form data, not a mapping from
    // concepts to functions.  A route may authorize only the same public body
    // roots from which the persisted registry was born.
    def fcnkr-family-roots() = [["axioms", "axioms"], ["bootstrap", "bootstrap"], ["form-stdlib", "form/form-stdlib"], ["grammars", "grammars"], ["cognition", "cognition"], ["learn", "learn"], ["observe", "observe"], ["teachings", "teachings"], ["receipts", "receipts"], ["model", "model"], ["proof", "proof"], ["control", "control"], ["ingest", "ingest"], ["presence", "presence"], ["docs", "docs"]];
    def fcnkr-family-root(family, rows) = nil?(rows) ? "" : (String) family == head(rows)[0] ? head(rows)[1] : fcnkr-family-root(family, tail(rows));
    def fcnkr-path-under-root?(path, root) = (String) root == "" || str_len(path) <= str_len(root) ? 0 : !((String) substring(path, 0, str_len(root)) == root) ? 0 : (String) substring(path, str_len(root), str_len(root) + 1) == "/" ? 1 : 0;
    def fcnkr-relative-source?(path) = (Comparable) str_len(path) == 0 || str_len(path) > fcnkr-max-path-bytes() ? 0 : (Comparable) str_byte_at(path, 0) == 47 ? 0 : str_find(path, "..", 0) >= 0 ? 0 : fcnkr-source-extension?(path);
    def fcnkr-path-valid-for-family?(family, path) = {
        let root = fcnkr-family-root(family, fcnkr-family-roots());
        (Comparable) fcnkr-relative-source?(path) == 0 ? 0 : (Comparable) fcnkr-ends-with?(path, "-xtal.fk") == 1 ? 0 : fcnkr-path-under-root?(path, root);
    };
    def fcnkr-split-loop(text, delimiter, start, acc) = {
        let at = str_find(text, delimiter, start);
        at < 0 ? reverse(cons(substring(text, start, str_len(text)), acc)) : fcnkr-split-loop(text, delimiter, at + str_len(delimiter), cons(substring(text, start, at), acc));
    };
    def fcnkr-split(text, delimiter) = fcnkr-split-loop(text, delimiter, 0, empty());
    def fcnkr-join-loop(parts, delimiter, out) = nil?(parts) ? out : fcnkr-join-loop(tail(parts), delimiter, (String) out == "" ? head(parts) : str_concat(out, str_concat(delimiter, head(parts))));
    def fcnkr-join(parts, delimiter) = fcnkr-join-loop(parts, delimiter, "");
    def fcnkr-string-hex(s) = hex-encode(host-abi-string-to-bytes(s));
    def fcnkr-hex-string(h) = (Comparable) hex-valid?(h) == 0 ? "" : host-abi-bytes-to-string(hex-decode(h));
    def fcnkr-hex64?(h) = (Comparable) str_len(h) == 64 && (Comparable) hex-valid?(h) == 1 ? 1 : 0;
    def fcnkr-key-member?(key, keys) = nil?(keys) ? 0 : (String) key == head(keys) ? 1 : fcnkr-key-member?(key, tail(keys));
    def fcnkr-string-nodes(xs) = nil?(xs) ? empty() : cons(intern_trivial_string(head(xs)), fcnkr-string-nodes(tail(xs)));
    def fcnkr-hash(s) = hex-encode(sha256-stream-string(s));
    def fcnkr-unique-key(family, path) = {
        let stem = fcnkr-normalize(fcnkr-path-stem(path), 24);
        let named = (String) stem == "" ? "source" : stem;
        fcnkr-clip-key(str_concat("source-", str_concat(family, str_concat("-", str_concat(named, str_concat("-", substring(fcnkr-hash(path), 0, 16)))))));
    };
    def fcnkr-artifact() = fs-path-join(fs-temp-dir(), "public-source-concept-registry-v1");
    def fcnkr-route-root-at(artifact) = fs-path-join(artifact, "concept-key-routes-v1/routes");
    def fcnkr-route-root() = fcnkr-route-root-at(fcnkr-artifact());
    def fcnkr-bucket-at(artifact, key) = {
        let hash = fcnkr-hash(key);
        fs-path-join(fs-path-join(fcnkr-route-root-at(artifact), substring(hash, 0, 2)), hash);
    };
    def fcnkr-bucket(key) = fcnkr-bucket-at(fcnkr-artifact(), key);
    def fcnkr-route-files(names, acc) = nil?(names) ? reverse(acc) : fcnkr-route-files(tail(names), (Comparable) fcnkr-ends-with?(head(names), ".route") == 1 ? cons(head(names), acc) : acc);
    // read row = status reason text.  Missing and over-window are not both an
    // empty string: absence is nothing; a held artifact beyond fuel is timeout.
    def fcnkr-read-row(status, reason, text) = [status, reason, text];
    def fcnkr-read-status(r) = r[0];
    def fcnkr-read-reason(r) = r[1];
    def fcnkr-read-text(r) = r[2];
    def fcnkr-read-bounded(path, limit) = {
        let size = fs-stat-size(path);
        size < 0 ? fcnkr-read-row("nothing", "artifact-missing", "") : size > limit ? fcnkr-read-row("timeout", "artifact-over-window", "") : fcnkr-read-row("ready", "bounded-artifact", fs-read-slice(path, 0, size));
    };
    // route = schema key key-hash family path source-key entry-key
    def fcnkr-route-valid?(r, key) = !((Comparable) len(r) == 7) ? 0 : !((String) r[0] == fcnkr-route-schema()) ? 0 : !((String) fcnkr-hex-string(r[1]) == key) ? 0 : !((String) r[2] == fcnkr-hash(key)) ? 0 : (Comparable) str_len(r[3]) == 0 ? 0 : (Comparable) fcnkr-path-valid-for-family?(r[3], fcnkr-hex-string(r[4])) == 0 ? 0 : (Comparable) fcnkr-hex64?(r[5]) == 0 ? 0 : fcnkr-hex64?(r[6]);
    def fcnkr-parse-route(text, key) = {
        let r = fcnkr-split(text, "|");
        (Comparable) fcnkr-route-valid?(r, key) == 1 ? [r[0], key, r[2], r[3], fcnkr-hex-string(r[4]), r[5], r[6]] : empty();
    };
    def fcnkr-source-artifact-path-at(artifact, family, path) = {
        let hash = fcnkr-hash(path);
        fs-path-join(fs-path-join(fs-path-join(fs-path-join(artifact, "shards"), family), substring(hash, 0, 2)), str_concat(hash, ".psci"));
    };
    def fcnkr-source-artifact-path(family, path) = fcnkr-source-artifact-path-at(fcnkr-artifact(), family, path);
    def fcnkr-source-key(family, path, source-id, size) = fcnkr-hash(fcnkr-join([family, fcnkr-string-hex(path), source-id, int_to_str(size)], "|"));
    def fcnkr-entry-key(source-key, keys) = fcnkr-hash(fcnkr-join([source-key, fcnkr-join(keys, ",")], "|"));
    // row = schema family path source-id size keys source-key entry-key unique
    def fcnkr-source-row-valid?(row, route, key) = !((Comparable) len(row) == 9) ? 0 : !((String) row[0] == fcnkr-source-schema()) ? 0 : !((String) row[1] == route[3]) ? 0 : !((String) row[2] == route[4]) ? 0 : (Comparable) fcnkr-path-valid-for-family?(row[1], row[2]) == 0 ? 0 : (Comparable) fcnkr-keys-valid?(row[5]) == 0 ? 0 : !((Comparable) fcnkr-key-member?(key, row[5]) == 1) ? 0 : row[4] < 0 ? 0 : !((String) row[6] == route[5]) ? 0 : !((String) row[7] == route[6]) ? 0 : !((String) row[6] == fcnkr-source-key(row[1], row[2], row[3], row[4])) ? 0 : !((String) row[7] == fcnkr-entry-key(row[6], row[5])) ? 0 : !((String) row[8] == fcnkr-unique-key(row[1], row[2])) ? 0 : fcnkr-key-member?(row[8], row[5]);
    def fcnkr-parse-source-row(text, route, key) = {
        let f = fcnkr-split(text, "|");
        !((Comparable) len(f) == 11) ? empty() : {
            let size = str_to_int(f[4]);
            let path = fcnkr-hex-string(f[2]);
            let source-id = str_concat("sha256:", f[3]);
            let keys = fcnkr-split(f[10], ",");
            let row = [f[0], f[1], path, source-id, size, keys, f[7], f[8], f[9]];
            !((String) int_to_str(size) == f[4]) || ((Comparable) fcnkr-hex64?(f[3]) == 0 || (Comparable) fcnkr-source-row-valid?(row, route, key) == 0) ? empty() : row;
        };
    };
    // These are byte-for-byte the source/entry structures held by PSCI.  Their
    // categories are protocol families; identity remains recursive content.
    def fcnkr-source-category() = make_nodeid(31, 2, 0, 86);
    def fcnkr-entry-category() = make_nodeid(31, 2, 0, 87);
    def fcnkr-absent-category() = make_nodeid(31, 2, 0, 90);
    def fcnkr-source-token-category() = make_nodeid(31, 2, 0, 96);
    def fcnkr-entry-token-category() = make_nodeid(31, 2, 0, 97);
    def fcnkr-absent() = intern_node(fcnkr-absent-category(), [intern_trivial_string("nothing")]);
    def fcnkr-source-node(row, source-id, size) = intern_node(fcnkr-source-category(), [intern_trivial_string(fcnkr-source-node-schema()), intern_trivial_string(row[1]), intern_trivial_string(row[2]), intern_trivial_string(source-id), intern_trivial_int(size)]);
    def fcnkr-entry-node(source, row) = intern_node(fcnkr-entry-category(), cons(source, fcnkr-string-nodes(row[5])));
    def fcnkr-source-token(source, row, source-id) = intern_node(fcnkr-source-token-category(), [source, intern_trivial_string(row[1]), intern_trivial_string(row[2]), intern_trivial_string(source-id)]);
    def fcnkr-entry-token(entry, source-token, row) = intern_node(fcnkr-entry-token-category(), [entry, source-token, intern_trivial_int(len(row[5]))]);
    def fcnkr-node-key(node) = str_concat("@", str_concat(int_to_str(node_pkg(node)), str_concat(".", str_concat(int_to_str(node_level(node)), str_concat(".", str_concat(int_to_str(node_type(node)), str_concat(".", int_to_str(node_inst(node)))))))));
    // result = schema status reason key family path held current entry answer
    //          held-id current-id size lookup hit executed trace artifact
    def fcnkr-result(status, reason, key, family, path, held, current, entry, answer, held-id, current-id, size, lookup, hit, executed, trace) = [fcnkr-schema(), status, reason, key, family, path, held, current, entry, answer, held-id, current-id, size, lookup, hit, executed, trace, fcnkr-artifact()];
    def fcnkr-status(r) = r[1];
    def fcnkr-reason(r) = r[2];
    def fcnkr-key(r) = r[3];
    def fcnkr-family(r) = r[4];
    def fcnkr-path(r) = r[5];
    def fcnkr-held(r) = r[6];
    def fcnkr-current(r) = r[7];
    def fcnkr-entry(r) = r[8];
    def fcnkr-answer(r) = r[9];
    def fcnkr-held-id(r) = r[10];
    def fcnkr-current-id(r) = r[11];
    def fcnkr-source-size(r) = r[12];
    def fcnkr-lookup-count(r) = r[13];
    def fcnkr-hit-count(r) = r[14];
    def fcnkr-executed?(r) = r[15];
    def fcnkr-trace(r) = r[16];
    def fcnkr-result-artifact(r) = r[17];
    def fcnkr-empty-result(status, reason, key, lookup, trace) = fcnkr-result(status, reason, key, "", "", fcnkr-absent(), fcnkr-absent(), fcnkr-absent(), "", "", "", -1, lookup, 0, lookup > 0 ? 1 : 0, trace);
    def fcnkr-answer-from-snapshot(snapshot, key) = {
        let atoms = fhcs-atoms(key);
        let first = nil?(atoms) ? -1 : fkss-find-ci(snapshot, head(atoms));
        let start = fkss-answer-start(first, str_len(snapshot));
        let end = fkss-min(str_len(snapshot), start + fkss-answer-limit());
        substring(snapshot, start, end);
    };
    def fcnkr-current-result(root, key, row) = {
        let relative = row[2];
        let full = fs-path-join(root, relative);
        let before = fs-stat-size(full);
        before < 0 || !((Comparable) fs-is-file?(full) == 1) ? fcnkr-empty-result("stale", "source-unavailable", key, 1, "choice,stale,undo,refine,release") : {
            let snapshot = fs-read-text(full);
            let after = fs-stat-size(full);
            let current-id = str_concat("sha256:", fcnkr-hash(snapshot));
            let stable-id = (Comparable) after == str_len(snapshot) && (Comparable) fs-is-file?(full) == 1 ? fkss-source-id(full) : "";
            !((Comparable) before == row[4]) || (!((Comparable) after == row[4]) || (!((String) current-id == row[3]) || !((String) stable-id == current-id))) ? fcnkr-empty-result("stale", "source-rebuild-needed", key, 1, "choice,stale,undo,refine,release") : {
                let held-source = fcnkr-source-node(row, row[3], row[4]);
                let current-source = fcnkr-source-node(row, current-id, after);
                let entry = fcnkr-entry-node(held-source, row);
                let source-token = fcnkr-source-token(held-source, row, row[3]);
                let current-token = fcnkr-source-token(current-source, row, current-id);
                let entry-token = fcnkr-entry-token(entry, source-token, row);
                fcnkr-result("hit", "concept-registry-current-source-hit", key, row[1], relative, source-token, current-token, entry-token, fcnkr-answer-from-snapshot(snapshot, key), row[3], current-id, after, 1, 1, 1, "choice,cut,release");
            };
        };
    };
    def fcnkr-inspect-route-at(root, artifact, bucket, key, name) = {
        let route-read = fcnkr-read-bounded(fs-path-join(bucket, name), fcnkr-max-route-bytes());
        (String) fcnkr-read-status(route-read) == "timeout" ? fcnkr-empty-result("timeout", "route-reference-timeout", key, 1, "choice,timeout,cut,undo,refine,release") : !((String) fcnkr-read-status(route-read) == "ready") ? fcnkr-empty-result("nothing", "route-reference-missing", key, 1, "choice,cut,undo,refine,release") : {
            let route = fcnkr-parse-route(fcnkr-read-text(route-read), key);
            (Comparable) len(route) == 0 ? fcnkr-empty-result("failure", "invalid-route-reference", key, 1, "choice,failure,cut,undo,refine,release") : {
                let source-read = fcnkr-read-bounded(fcnkr-source-artifact-path-at(artifact, route[3], route[4]), fcnkr-max-source-row-bytes());
                (String) fcnkr-read-status(source-read) == "timeout" ? fcnkr-empty-result("timeout", "source-artifact-over-window", key, 1, "choice,timeout,cut,undo,refine,release") : !((String) fcnkr-read-status(source-read) == "ready") ? fcnkr-empty-result("nothing", "source-artifact-missing", key, 1, "choice,cut,undo,refine,release") : {
                    let row = fcnkr-parse-source-row(fcnkr-read-text(source-read), route, key);
                    (Comparable) len(row) == 0 ? fcnkr-empty-result("failure", "invalid-source-artifact", key, 1, "choice,failure,cut,undo,refine,release") : fcnkr-current-result(root, key, row);
                };
            };
        };
    };
    def fcnkr-resolve-files-loop(root, artifact, bucket, files, key, first, hits, stale, missing, invalid, timeout) = nil?(files) ? timeout > 0 ? fcnkr-empty-result("timeout", "route-reference-timeout", key, 1, "choice,timeout,cut,undo,refine,release") : stale > 0 ? fcnkr-empty-result("stale", "route-reference-refused", key, 1, "choice,stale,undo,refine,release") : missing + invalid > 0 ? fcnkr-empty-result("nothing", "route-reference-refused", key, 1, "choice,cut,undo,refine,release") : (Comparable) hits == 0 ? fcnkr-empty-result("nothing", "concept-not-routed", key, 1, "choice,cut,release") : hits > 1 ? fcnkr-empty-result("ambiguous", "ambiguous-concept-key", key, 1, "choice,ambiguous,undo,refine,cut,release") : first : {
        let observed = fcnkr-inspect-route-at(root, artifact, bucket, key, head(files));
        let status = fcnkr-status(observed);
        fcnkr-resolve-files-loop(root, artifact, bucket, tail(files), key, (String) status == "hit" && (Comparable) hits == 0 ? observed : first, hits + ((String) status == "hit" ? 1 : 0), stale + ((String) status == "stale" ? 1 : 0), missing + ((String) status == "nothing" ? 1 : 0), invalid + ((String) status == "failure" ? 1 : 0), timeout + ((String) status == "timeout" ? 1 : 0));
    };
    def fcnkr-execute-concept-at(root, artifact, key) = {
        let bucket = fcnkr-bucket-at(artifact, key);
        !((Comparable) fs-is-dir?(bucket) == 1) ? fcnkr-empty-result("nothing", "concept-not-routed", key, 0, "choice,cut,release") : {
            let files = fcnkr-route-files(fs-list(bucket), empty());
            len(files) > fcnkr-max-candidates() ? fcnkr-empty-result("timeout", "candidate-window-timeout", key, 1, "choice,timeout,cut,undo,refine,release") : fcnkr-resolve-files-loop(root, artifact, bucket, files, key, fcnkr-empty-result("nothing", "concept-not-routed", key, 1, "choice,cut,release"), 0, 0, 0, 0, 0);
        };
    };
    def fcnkr-execute-concept(key) = {
        let root = fhcs-default-root();
        (String) root == "" ? fcnkr-empty-result("failure", "body-root-unresolved", key, 0, "choice,failure,cut,undo,refine,release") : fcnkr-execute-concept-at(root, fcnkr-artifact(), key);
    };
    // A real immutable BMF raw-byte cursor consumes the canonical surface.
    // Direct CLI input cannot be incomplete or trailing because this organ
    // births the envelope; cursor fuel still retains timeout independently.
    def fcnkr-scan-row(status, reason, position) = [status, reason, position, 1];
    def fcnkr-scan-status(scan) = scan[0];
    def fcnkr-scan-reason(scan) = scan[1];
    def fcnkr-scan-position(scan) = scan[2];
    def fcnkr-scan-cursor(cursor, fuel) = (Comparable) cur-eof?(cursor) == 1 ? fcnkr-scan-row("ready", "complete", cur-pos(cursor)) : fuel <= 0 ? fcnkr-scan-row("timeout", "cursor-step-budget", cur-pos(cursor)) : {
        let observed-byte = cur-peek(cursor);
        fcnkr-scan-cursor(cur-advance(cursor, 1), fuel - 1);
    };
    def fcnkr-scan(surface) = fcnkr-scan-cursor(cursor-str(surface), fcnkr-max-frame-bytes());
    def fcnkr-execute(input) = {
        let scan = fcnkr-scan(fcnkr-surface(input));
        (String) fcnkr-scan-status(scan) == "timeout" ? fcnkr-empty-result("timeout", fcnkr-scan-reason(scan), input, 0, "choice,timeout,cut,undo,refine,release") : (Comparable) str_len(input) == 0 ? fcnkr-empty-result("nothing", "empty-request", "", 0, "choice,release") : (Comparable) str_byte_at(input, 0) == 64 ? (Comparable) ric-node-id-valid?(input) == 0 ? fcnkr-empty-result("failure", "invalid-nodeid-coordinate", input, 0, "choice,failure,cut,undo,refine,release") : fcnkr-empty-result("nothing", "strict-nodeid-route-unavailable", input, 0, "choice,cut,release") : (Comparable) fcnkr-key-valid?(input) == 0 ? fcnkr-empty-result("failure", "invalid-concept-key", input, 0, "choice,failure,cut,undo,refine,release") : fcnkr-execute-concept(input);
    };
    def fcnkr-thought-values(r) = [fcnkr-held(r), fcnkr-current(r), fcnkr-answer(r), fcnkr-answer(r), fcnkr-status(r), fcnkr-status(r), fcnkr-reason(r), fcnkr-reason(r), fcnkr-lookup-count(r), fcnkr-lookup-count(r), fcnkr-hit-count(r), fcnkr-hit-count(r), fcnkr-executed?(r), fcnkr-executed?(r), fcnkr-trace(r), fcnkr-trace(r)];
    def fcnkr-thought-kinds() = [fcatw-kind-node(), fcatw-kind-node(), fcatw-kind-string(), fcatw-kind-string(), fcatw-kind-string(), fcatw-kind-string(), fcatw-kind-string(), fcatw-kind-string(), fcatw-kind-int(), fcatw-kind-int(), fcatw-kind-int(), fcatw-kind-int(), fcatw-kind-int(), fcatw-kind-int(), fcatw-kind-string(), fcatw-kind-string()];
    def fcnkr-thought(r) = !((String) fcnkr-status(r) == "hit") ? nothing() : fcatw-run(fcnkr-thought-values(r), fcnkr-thought-kinds(), 93);
    def fcnkr-thought-status(thought) = nothing?(thought) ? "nothing" : fcatw-status(thought);
    def fcnkr-thought-value-text(thought) = nothing?(thought) ? "nothing" : (Comparable) fcatw-output-count(thought) == 0 ? "nothing" : int_to_str(fcatw-value(thought));
    def fcnkr-thought-output-count(thought) = nothing?(thought) ? 0 : fcatw-output-count(thought);
    def fcnkr-line(acc, key, value) = str_concat(acc, str_concat("\n", str_concat(key, str_concat("=", value))));
    def fcnkr-render(r) = {
        let thought = fcnkr-thought(r);
        let r0 = fcnkr-line("nodeid-knowledge", "status", fcnkr-status(r));
        let r1 = fcnkr-line(r0, "route-mode", "strict-one-bucket");
        let r2 = fcnkr-line(r1, "reason", fcnkr-reason(r));
        let r3 = fcnkr-line(r2, "source", fcnkr-node-key(fcnkr-held(r)));
        let r4 = fcnkr-line(r3, "entry", fcnkr-node-key(fcnkr-entry(r)));
        let r5 = fcnkr-line(r4, "path", fcnkr-path(r));
        let r6 = fcnkr-line(r5, "lookup-count", int_to_str(fcnkr-lookup-count(r)));
        let r7 = fcnkr-line(r6, "scannerless", "1");
        let r8 = fcnkr-line(r7, "model-executed", "0");
        let r9 = fcnkr-line(r8, "trace", fcnkr-trace(r));
        let r10 = fcnkr-line(r9, "resident-thought-self-consistency-symbol", fcatw-symbol());
        let r11 = fcnkr-line(r10, "resident-thought-self-consistency-status", fcnkr-thought-status(thought));
        let r12 = fcnkr-line(r11, "resident-thought-self-consistency-value", fcnkr-thought-value-text(thought));
        let r13 = fcnkr-line(r12, "resident-thought-self-consistency-output-count", int_to_str(fcnkr-thought-output-count(thought)));
        let r14 = fcnkr-line(r13, "carrier", "resident-form-source-unit");
        let r15 = fcnkr-line(r14, "carrier-boundary", "none");
        let r16 = fcnkr-line(r15, "artifact", fcnkr-result-artifact(r));
        fcnkr-line(r16, "answer", fcnkr-answer(r));
    };
    def fcnkr-query(input) = (Comparable) str_len(input) == 0 ? "usage: nodeid-knowledge <concept-key|@p.l.t.i>" : {
        let result = fcnkr-execute(input);
        // Retain only the correlated source/absence NodeID and this
        // organ's coordinate.  Query and answer bytes never enter the
        // framebuffer.  The live framebuffer-status verb can observe
        // this crossing before the session flows onward.
        let event = fb_record(fcnkr-held(result), "form-cli-nodeid-knowledge-resident.fk", 1);
        fcnkr-line(fcnkr-render(result), "framebuffer-event", (String) fcnkr-status(result) == "hit" ? "source-coordinate-retained" : "absence-coordinate-retained");
    };
    def fcnkr-surface(input) = (Comparable) str_len(input) == 0 ? "" : str_concat(fcnkr-open(), str_concat((Comparable) str_byte_at(input, 0) == 64 ? "nodeid=" : "concept=", str_concat(input, fcnkr-close())));
    def fcnkr-stage-head(stage) = fcnkr-line("nodeid-stage", "stage", stage);
    def fcnkr-stage(stage, input) = (Comparable) str_len(input) == 0 ? "usage: nodeid-stage surface|scan|route|lookup|current <concept-key|@p.l.t.i>" : (String) stage == "surface" ? fcnkr-line(fcnkr-stage-head(stage), "surface", fcnkr-surface(input)) : (String) stage == "scan" ? {
        let ok = (Comparable) str_byte_at(input, 0) == 64 ? ric-node-id-valid?(input) : fcnkr-key-valid?(input);
        let scan = fcnkr-scan(fcnkr-surface(input));
        let status = (Comparable) ok == 0 ? "failure" : fcnkr-scan-status(scan);
        let r0 = fcnkr-line(fcnkr-stage-head(stage), "status", status);
        let r1 = fcnkr-line(r0, "reason", (Comparable) ok == 0 ? "invalid-coordinate" : fcnkr-scan-reason(scan));
        let r2 = fcnkr-line(r1, "consumed-bytes", int_to_str(fcnkr-scan-position(scan)));
        fcnkr-line(r2, "scannerless", "1");
    } : (String) stage == "route" ? {
        let bucket = (Comparable) fcnkr-key-valid?(input) == 1 ? fcnkr-bucket(input) : "";
        let r0 = fcnkr-line(fcnkr-stage-head(stage), "artifact", fcnkr-artifact());
        let r1 = fcnkr-line(r0, "bucket", bucket);
        fcnkr-line(r1, "present", int_to_str((String) bucket == "" ? 0 : fs-is-dir?(bucket)));
    } : (String) stage == "lookup" || (String) stage == "current" ? {
        let r = fcnkr-execute(input);
        let r0 = fcnkr-line(fcnkr-stage-head(stage), "status", fcnkr-status(r));
        let r1 = fcnkr-line(r0, "reason", fcnkr-reason(r));
        let r2 = fcnkr-line(r1, "path", fcnkr-path(r));
        let r3 = fcnkr-line(r2, "lookup-count", int_to_str(fcnkr-lookup-count(r)));
        (String) stage == "current" ? fcnkr-line(r3, "answer-bytes", int_to_str(str_len(fcnkr-answer(r)))) : r3;
    } : "usage: nodeid-stage surface|scan|route|lookup|current <concept-key|@p.l.t.i>";
    0;
}
