; form-cli-ki-lift.fk — knowledge-ingest, authored in form.lift.
;
; Lift of ingest/knowledge-ingest.fk. ice/liquid/compost are the three
; verdicts, not magic 2/1/0. Crystallize; the s-expr still serves callers.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-ki-lift-band.fk
; witnessed: 2026-08-20 -> 11111

section [form.lift] {
    allow ki-depth(u) = head(u);
    allow ki-fear(u) = head(tail(u));
    allow ki-deep?(u) = if ki-depth(u) >= 3 then 1 else 0;
    allow ki-fear-free?(u) = if ki-fear(u) == 0 then 1 else 0;
    allow ki-freezable?(u) = if ki-deep?(u) == 1 then if ki-fear-free?(u) == 1 then 1 else 0 else 0;
    allow ki-witnessable?(u) = ki-deep?(u);
    allow ki-ingest(u) = if ki-freezable?(u) == 1 then ice else if ki-witnessable?(u) == 1 then liquid else compost;
    allow kik(cond, bit) = if cond then bit else 0;
    allow knowledge-ingest-check() = add(kik(ki-ingest(list(5, 0)) == ice, 1), add(kik(ki-ingest(list(5, 1)) == liquid, 10), add(kik(ki-ingest(list(1, 0)) == compost, 100), add(kik(ki-ingest(list(5, 0)) > ki-ingest(list(1, 0)), 1000), kik(ki-witnessable?(list(5, 1)) == 1, 10000)))));
    0;
}
