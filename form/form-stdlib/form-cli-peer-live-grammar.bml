//////////////////////////////////////////////////////////////////////
// form-cli-peer-live-grammar.bml -- BML task grammar for the held peer.
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/bml/form-cli-resident-continuity.bml

section [form.bml] {
    class FormCliPeerLiveGrammar {
        field GrammarRule = "explicit-prefix-selects-one-caller-owned-effect-without-authority-escalation";
        field NativeRule = "native-decimal-selects-retained-bml-bmf-nodeid-program-before-model";

        def fcpalg-grammar-rule() = GrammarRule();
        def fcpalg-native-rule() = NativeRule();
        def fcpalg-is-recipe?(text) = if eq(str_find(text, frc-explicit-recipe-prefix(), 0), 0) then 1 else 0;
        def fcpalg-is-source?(text) = if eq(str_find(text, frc-explicit-source-prefix(), 0), 0) then 1 else 0;
        def fcpalg-is-symbol?(text) = if eq(str_find(text, frc-explicit-symbol-prefix(), 0), 0) then 1 else 0;
        def fcpalg-is-grounded?(text) = if eq(str_find(text, frc-explicit-ground-prefix(), 0), 0) then 1 else 0;
        def fcpalg-is-weave?(text) = if eq(str_find(text, frc-explicit-weave-prefix(), 0), 0) then 1 else 0;
        def fcpalg-is-native?(text) = if eq(str_find(text, frc-explicit-native-prefix(), 0), 0) then 1 else 0;
        def fcpalg-source-body(text) = substring(text, str_len(frc-explicit-source-prefix()), str_len(text));
        def fcpalg-source-kind(text) {
            let body = fcpalg-source-body(text);
            if and(gt(str_len(body), 0), eq(str_byte_at(body, 0), 64)) then "source-nodeid" else "source-concept";
        }
        def fcpalg-kind(text) = if eq(fcpalg-is-recipe?(text), 1) then "recipe" else if eq(fcpalg-is-native?(text), 1) then "resident-native-program" else if eq(fcpalg-is-weave?(text), 1) then "grounded-weave" else if eq(fcpalg-is-grounded?(text), 1) then "grounded-answer" else if eq(fcpalg-is-symbol?(text), 1) then "source-symbol" else if eq(fcpalg-is-source?(text), 1) then fcpalg-source-kind(text) else frc-default-task-route();
        def fcpalg-body(text) = if eq(fcpalg-is-recipe?(text), 1) then substring(text, str_len(frc-explicit-recipe-prefix()), str_len(text)) else if eq(fcpalg-is-native?(text), 1) then substring(text, str_len(frc-explicit-native-prefix()), str_len(text)) else if eq(fcpalg-is-weave?(text), 1) then substring(text, str_len(frc-explicit-weave-prefix()), str_len(text)) else if eq(fcpalg-is-grounded?(text), 1) then substring(text, str_len(frc-explicit-ground-prefix()), str_len(text)) else if eq(fcpalg-is-symbol?(text), 1) then substring(text, str_len(frc-explicit-symbol-prefix()), str_len(text)) else if eq(fcpalg-is-source?(text), 1) then fcpalg-source-body(text) else text;
        def fcpalg-retry?(signal) = if or(str_eq(signal, "failure"), str_eq(signal, "nothing")) then 1 else 0;
        def fcpalg-retry-task(task) = str_concat("Answer the preceding task directly and plainly; do not emit a control token. Task: ", task);
    }
    0;
}
