// Chat, prompt/completion and plain-text JSONL become teacher-forced token rows.
// Prompt masking supervises the final assistant response, including its end marker.
// Rows retain their line number; malformed data never vanishes from the denominator.
import form-stdlib/native-llama-tokenizer.bml;
import form-stdlib/native-llama-backward.bml;
section [form.bml] {
 class NativeLoraDataset {
  def nld-string(o,k) {
   let value = json-object-get(o,k);
   !((Comparable) node_type(value) == 2) ? form_error("native training requires a string: " + k) : node_value(value);
  }
  def nld-message(role,text) = json-node-object([json-node-pair("role",json-node-string(role)),json-node-pair("content",json-node-string(text))]);
  def nld-system(t,text) = append([nlt-special(t,"<|begin_of_text|>")],append(nlt-header(t,"system"),append(nlt-encode(t,"Cutting Knowledge Date: December 2023\nToday Date: 26 Jul 2024\n\n" + trim(text)),[nlt-special(t,"<|eot_id|>")])));
  def nld-messages(t,messages) = nil?(messages) ? [] : append(nld-one(t,messages[0]),nld-messages(t,messages[1:]));
  def nld-one(t,m) {
   let role = nld-string(m,"role");
   json-object-has?(m,"tool_calls") || (!(((String) role == "user") || ((String) role == "assistant"))) ? form_error("native training chat role/tool payload requires a matching template") : nlt-message(t,role,nld-string(m,"content"));
  }
  def nld-chat(t,messages) = nil?(messages) ? nld-system(t,"") : (String) nld-string(messages[0],"role") == "system" ? append(nld-system(t,nld-string(messages[0],"content")),nld-messages(t,messages[1:])) : append(nld-system(t,""),nld-messages(t,messages));
  def nld-chat-row(t,messages,masked,line) {
   nil?(messages) ? form_error("native training chat is empty") : nld-chat-ready(t,messages,masked,line);
  }
  def nld-chat-ready(t,messages,masked,line) {
   let final = messages[len(messages) - 1]; let assistant = (String) nld-string(final,"role") == "assistant";
   masked && (!assistant) ? form_error("native prompt-masked row must end in an assistant response") : nld-sample(nld-chat(t,messages),masked ? len(append(nld-chat(t,take(len(messages) - 1,messages)),nlt-header(t,"assistant"))) : 0,line);
  }
  def nld-row(t,row,masked,line) {
   json-object-has?(row,"tools") && (!((Comparable) node_category(json-object-get(row,"tools")) == JSON-NULL())) ? form_error("native training tools require a matching tool template")
   : json-object-has?(row,"messages") ? nld-chat-row(t,json-array-elements(json-object-get(row,"messages")),masked,line)
   : json-object-has?(row,"prompt") ? nld-chat-row(t,[nld-message("user",nld-string(row,"prompt")),nld-message("assistant",nld-string(row,"completion"))],masked,line)
   : json-object-has?(row,"text") ? nld-sample(append([nlt-special(t,"<|begin_of_text|>")],append(nlt-encode(t,nld-string(row,"text")),[nlt-special(t,"<|eot_id|>")])),0,line)
   : form_error("native training row has no supported text field at line " + line.str());
  }
  def nld-mask(n,offset,i) = i >= n ? [] : cons((i + 1) >= offset ? 1.0 : 0.0,nld-mask(n,offset,i + 1));
  // Sample: input ids, target ids, target mask, supervised count, source line.
  def nld-sample(tokens,offset,line) {
   let n = len(tokens) - 1; let mask = nld-mask(n,offset,0);
   (n <= 0) || (sum(mask) <= 0) ? form_error("native training has no supervised targets at line " + line.str()) : [take(n,tokens),tokens[1:],mask,sum(mask),line];
  }
  def nld-lines(text) = nld-nonempty(split-on(text,"\n"),1);
  def nld-nonempty(lines,i) = nil?(lines) ? [] : (Comparable) len(trim(lines[0])) == 0 ? nld-nonempty(lines[1:],i + 1) : cons([lines[0],i],nld-nonempty(lines[1:],i + 1));
  def nld-file(path) {
   let text = read_file(path);
   nothing?(text) ? form_error("native training data absent: " + path) : nld-lines(text);
  }
  def nld-prepare(t,rows,masked) = rows |> map(row => nld-row(t,parse-json("native-training-row",row[0]),masked,row[1]));
  def nld-weight(rows) = nil?(rows) ? 0.0 : (rows[0][3] + nld-weight(rows[1:]));
  def nld-tokens(rows) = nil?(rows) ? 0 : (len(rows[0][0]) + nld-tokens(rows[1:]));
 }
 0;
}
