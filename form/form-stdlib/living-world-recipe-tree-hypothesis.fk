; living-world-recipe-tree-hypothesis.fk -- independent trials may turn an
; offered Recipe composition into plural successor hypothesis tissue.
;
; A current Recipe-tree field and a separately current contradiction-revision
; field may meet only by exact Recipe identity.  Direct sources of the tree
; blueprint and direct sources of the revision offers must be disjoint and
; recurrent.  Every compatible composition is crossed with every viable trial;
; zero matches remain OPEN, one is READY, and many remain PLURAL.  No list
; order, score, or hidden representative selects a Recipe.
;
; The admitted object is a field of hypotheses and their exact evaluations,
; alternatives, unknowns, source sets, and provenance.  It is not an answer,
; voice surface, promotion decision, or authority outside its two interfaces.
; Revocation of either parent field or any direct offer makes it stale while
; retaining history.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk

(let LWRTH-MATCH  (bp "LWRTH-MATCH"))
(let LWRTH-FIELD  (bp "LWRTH-FIELD"))
(let LWRTH-ORIGIN (bp "LWRTH-ORIGIN"))

(defn lwrth-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwrth-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwrth-source-items (items field)
    (if (eq (len items) 0) field
        (lwrth-source-items (tail items)
            (lwo-field-add field
                (lwo-attribution-source (head items))))))
(defn lwrth-direct-sources (world cell)
    (lwrth-source-items
        (lwo-field-items (lwo-active-attributions-for world cell))
        (lwo-empty-field)))
(defn lwrth-offer-source-items (world items field)
    (if (eq (len items) 0) field
        (lwrth-offer-source-items world (tail items)
            (lwrth-field-union-items
                (lwo-field-items
                    (lwrth-direct-sources world (head items))) field))))
(defn lwrth-revision-sources (world trial)
    (lwrth-offer-source-items world
        (lwo-field-items
            (lwhrn-evidence-offers
                (lwhrn-trial-evidence trial)))
        (lwo-empty-field)))
(defn lwrth-fields-disjoint-items? (items other)
    (if (eq (len items) 0) 1
        (if (eq (lwo-field-has? other (head items)) 1) 0
            (lwrth-fields-disjoint-items? (tail items) other))))
(defn lwrth-fields-disjoint? (first second)
    (lwrth-fields-disjoint-items? (lwo-field-items first) second))

(defn lwrth-trial-recipe (trial)
    (lwhrn-candidate-recipe
        (lwhrn-evidence-candidate
            (lwhrn-trial-evidence trial))))

; children: tree/revision parent candidates, exact compatible composition,
; exact independently viable trial, Recipe, evaluations, disjoint direct source
; sets, alternatives, unknowns, local path
(defn lwrth-match
    (tree-candidate revision-candidate composition trial recipe evaluations
     tree-sources revision-sources alternatives unknowns)
    (intern_node LWRTH-MATCH
        (list tree-candidate revision-candidate composition trial recipe
              evaluations tree-sources revision-sources alternatives unknowns
              (lwo-local-path))))
(defn lwrth-match? (cell) (lwo-category? cell LWRTH-MATCH))
(defn lwrth-match-tree-candidate (match) (nth (node_children match) 0))
(defn lwrth-match-revision-candidate (match) (nth (node_children match) 1))
(defn lwrth-match-composition (match) (nth (node_children match) 2))
(defn lwrth-match-trial (match) (nth (node_children match) 3))
(defn lwrth-match-recipe (match) (nth (node_children match) 4))
(defn lwrth-match-evaluations (match) (nth (node_children match) 5))
(defn lwrth-match-tree-sources (match) (nth (node_children match) 6))
(defn lwrth-match-revision-sources (match) (nth (node_children match) 7))
(defn lwrth-match-alternatives (match) (nth (node_children match) 8))
(defn lwrth-match-unknowns (match) (nth (node_children match) 9))

(defn lwrth-match-for
    (world tree-candidate revision-candidate composition trial)
    (do
        (let recipe (lwrt-composition-recipe composition))
        (let trial-recipe (lwrth-trial-recipe trial))
        (let blueprint (lwrt-composition-blueprint composition))
        (let tree-sources
            (lwrth-direct-sources world blueprint))
        (let revision-sources
            (lwrth-revision-sources world trial))
        (let revision-offer-candidate
            (lwhrn-evidence-candidate
                (lwhrn-trial-evidence trial)))
        (let revision-unknown
            (lwhrn-candidate-unknown revision-offer-candidate))
        (let unknowns
            (lwrth-field-union-items
                (lwo-field-items
                    (lwrt-composition-unknowns composition))
                (if (node_eq revision-unknown (lwo-none))
                    (lwo-empty-field)
                    (lwo-field (list revision-unknown)))))
        (if (or (not (node_eq recipe trial-recipe))
                (or (lt (lwo-field-size tree-sources) 2)
                    (or (lt (lwo-field-size revision-sources) 2)
                        (eq (lwrth-fields-disjoint?
                                tree-sources revision-sources) 0))))
            (lwo-none)
            (lwrth-match tree-candidate revision-candidate composition trial
                recipe (lwhrn-trial-evaluations trial) tree-sources
                revision-sources
                (lwrth-field-union-items
                    (lwo-field-items
                        (lwhrn-candidate-alternatives
                            revision-offer-candidate))
                    (lwrt-composition-alternatives composition))
                unknowns))))

(defn lwrth-matches-for-trials
    (world tree-candidate revision-candidate composition trials matches)
    (if (eq (len trials) 0) matches
        (do
            (let match
                (lwrth-match-for world tree-candidate revision-candidate
                    composition (head trials)))
            (lwrth-matches-for-trials world tree-candidate revision-candidate
                composition (tail trials)
                (if (node_eq match (lwo-none)) matches
                    (lwo-field-add matches match))))))
(defn lwrth-matches-for-compositions
    (world tree-candidate revision-candidate compositions trials matches)
    (if (eq (len compositions) 0) matches
        (lwrth-matches-for-compositions world tree-candidate revision-candidate
            (tail compositions) trials
            (lwrth-matches-for-trials world tree-candidate revision-candidate
                (head compositions) trials matches))))

(defn lwrth-matches-for (world tree-candidate revision-candidate)
    (if (or (eq (lwrt-integrated-current?
                    world tree-candidate) 0)
            (eq (lwhrn-integrated-current?
                    world revision-candidate) 0)) (lwo-empty-field)
        (do
            (let tree-field (lwo-emergent-shape tree-candidate))
            (let revision-field (lwo-emergent-shape revision-candidate))
            (if (not (node_eq
                        (lwrt-field-target tree-field)
                        (lwhrn-field-target revision-field)))
                (lwo-empty-field)
                (lwrth-matches-for-compositions world tree-candidate
                    revision-candidate
                    (lwo-field-items
                        (lwrt-field-compatible tree-field))
                    (lwo-field-items
                        (lwhrn-field-viable revision-field))
                    (lwo-empty-field))))))

(defn lwrth-match-options (items alternatives unknowns)
    (if (eq (len items) 0) (list alternatives unknowns)
        (lwrth-match-options (tail items)
            (lwrth-field-union-items
                (lwo-field-items
                    (lwrth-match-alternatives (head items))) alternatives)
            (lwrth-field-union-items
                (lwo-field-items
                    (lwrth-match-unknowns (head items))) unknowns))))

; children: current tree and revision parents, every exact source-disjoint
; match, OPEN/READY/PLURAL, alternatives, unknowns, witnesses, local path
(defn lwrth-field-cell
    (tree-candidate revision-candidate matches status alternatives unknowns
     witnesses)
    (intern_node LWRTH-FIELD
        (list tree-candidate revision-candidate matches status alternatives
              unknowns witnesses (lwo-local-path))))
(defn lwrth-field? (cell) (lwo-category? cell LWRTH-FIELD))
(defn lwrth-field-tree-candidate (field) (nth (node_children field) 0))
(defn lwrth-field-revision-candidate (field) (nth (node_children field) 1))
(defn lwrth-field-matches (field) (nth (node_children field) 2))
(defn lwrth-field-status (field) (nth (node_children field) 3))
(defn lwrth-field-alternatives (field) (nth (node_children field) 4))
(defn lwrth-field-unknowns (field) (nth (node_children field) 5))
(defn lwrth-field-witnesses (field) (nth (node_children field) 6))

(defn lwrth-parent-witnesses (world candidate field)
    (lwrth-field-union-items
        (lwo-field-items (lwo-active-attributions-for world candidate))
        (lwrth-field-union-items
            (lwo-field-items (lwo-emergent-witnesses candidate)) field)))
(defn lwrth-field-for (world tree-candidate revision-candidate)
    (if (or (eq (lwrt-integrated-current?
                    world tree-candidate) 0)
            (eq (lwhrn-integrated-current?
                    world revision-candidate) 0)) (lwo-none)
        (do
            (let matches
                (lwrth-matches-for world tree-candidate revision-candidate))
            (let count (lwo-field-size matches))
            (let status
                (if (eq count 1) (lwhrn-ready)
                    (if (gt count 1) (lwhrn-plural) (lwhrn-open))))
            (let options
                (lwrth-match-options (lwo-field-items matches)
                    (lwo-empty-field) (lwo-empty-field)))
            (let witnesses
                (lwrth-parent-witnesses world revision-candidate
                    (lwrth-parent-witnesses world tree-candidate
                        (lwo-empty-field))))
            (lwrth-field-cell tree-candidate revision-candidate matches status
                (nth options 0)
                (lwo-field-add (nth options 1) (lwlc-unknown matches))
                witnesses))))

(defn lwrth-origin (tree-candidate revision-candidate)
    (intern_node LWRTH-ORIGIN
        (list tree-candidate revision-candidate (lwo-local-path))))
(defn lwrth-origin-tree-candidate (origin) (nth (node_children origin) 0))
(defn lwrth-origin-revision-candidate (origin) (nth (node_children origin) 1))
(defn lwrth-proposal-for (world tree-candidate revision-candidate)
    (do
        (let field
            (lwrth-field-for world tree-candidate revision-candidate))
        (if (or (node_eq field (lwo-none))
                (eq (lwo-field-size
                        (lwrth-field-matches field)) 0)) (lwo-none)
            (do
                (let witnesses (lwrth-field-witnesses field))
                (let count (lwo-field-size (lwrth-field-matches field)))
                (let origin
                    (lwrth-origin tree-candidate revision-candidate))
                (let candidate
                    (lwo-emergent field witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int count)
                        (intern_trivial_int
                            (lwo-field-size witnesses)) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field)) origin)))))
(defn lwrth-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrth-field?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwrth-candidate-current? (world candidate)
    (if (eq (lwrth-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwrth-proposal-for world
                    (lwrth-origin-tree-candidate origin)
                    (lwrth-origin-revision-candidate origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwrth-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrth-candidate-current? world candidate) 1)) 1 0))
(defn lwrth-integrate (round proposal action)
    (if (eq (lwrth-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

(defn lwrth-progress-target (field)
    (if (node_eq field (lwo-none)) "field:nothing"
        (lcfb-cat (list
            "matches:" (int_to_str
                (lwo-field-size (lwrth-field-matches field)))
            ":ready:" (int_to_str
                (lwhrn-ready? (lwrth-field-status field)))
            ":plural:" (int_to_str
                (lwhrn-plural? (lwrth-field-status field)))))))

