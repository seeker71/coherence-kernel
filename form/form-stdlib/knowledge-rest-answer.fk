// knowledge-rest-answer.fk — the body answers its model's question with a
// resting pointer instead of decoded bytes.
//
// Witnessed need (probe + pulse, 2026-08-30): the local model, asked a
// fact, emits <|form:knowledge-query|> and starves — the plain door holds
// no answer reserve, so the model's own right instinct (ask the body)
// ends in knowledge-query-decode-timeout. The restanswer law (corpus row
// 1161) dissolves the starvation: the reply is a POINTER; force pays
// outside the stream, at rfj-force — the crystallize-on-heat door — and
// the reserve an answer needs shrinks to a pointer's width.
//
// The registry is a lookup, not a classifier (the hdc-locate discipline):
// an unknown query answers exact nothing, never a fabricated value. A row
// is (list surface pointer); surfaces grow the way lg-catalog grows.
//
// The corpus lane: every homecoming distillation row is a question the
// body can answer natively — the query surface splits to tokens, locates
// by the corpus's own exact-match door (a lookup, not a classifier), and
// the fresh word comes home as the observation. 553 questions answerable
// with zero model decode and zero remote tokens the day this lane opened.
// Case and wording must match the row's tokens exactly (a trailing ? on
// the last word is stripped); anything else misses to nothing — never a
// false match.
//
// preludes: learn/homecoming-distillation-corpus.fk form-stdlib/rest-force-jit.fk
//
section [form.bml] {
    def kra-row(surface, p) = list(surface, p);
    def kra-registry() = list(kra-row("bootstrap/ground", lg-defer("add", 40, 2)), kra-row("six times seven", lg-defer("mul", 6, 7)), kra-row("ground twice", lg-defer("add", lg-defer("add", 40, 2), lg-defer("add", 40, 2))));
    def kra-find(rows, q) = (Comparable) len(rows) == 0 ? nothing() : (String) nth(head(rows), 0) == q ? nth(head(rows), 1) : kra-find(tail(rows), q);
    def kra-answer(q) = kra-find(kra-registry(), q);
    // force a query's answer through the JIT door:
    // (list value route gate' born), or exact nothing for an unknown query.
    def kra-force(g, q) = {
        let p = kra-answer(q);
        nothing?(p) ? nothing() : rfj-force(g, p);
    };
    // ── the corpus lane ────────────────────────────────────────────────────
    // split a surface into corpus-shaped tokens: space-separated, one
    // trailing ? stripped from the final word. Empty words (double spaces)
    // are dropped.
    def kra-strip-q(w) = {
        let n = str_len(w);
        (Comparable) n == 0 ? w : (String) substring(w, n - 1, n) == "?" ? substring(w, 0, n - 1) : w;
    };
    def kra-split-loop(s, from, acc) = {
        let at = str_find(s, " ", from);
        at < 0 ? {
            let w = substring(s, from, str_len(s));
            (Comparable) str_len(w) == 0 ? acc : cons(w, acc);
        } : {
            let w = substring(s, from, at);
            kra-split-loop(s, at + 1, (Comparable) str_len(w) == 0 ? acc : cons(w, acc));
        };
    };
    def kra-rev(xs, acc) = (Comparable) len(xs) == 0 ? acc : kra-rev(tail(xs), cons(head(xs), acc));
    def kra-strip-last(ws) = (Comparable) len(ws) == 0 ? ws : {
        let r = kra-rev(ws, empty());
        kra-rev(tail(r), list(kra-strip-q(head(r))));
    };
    def kra-split(s) = kra-strip-last(kra-rev(kra-split-loop(s, 0, empty()), empty()));
    // a corpus question answers its fresh word; unknown locates to nothing.
    def kra-corpus-word(q) = {
        let mid = hdc-locate(kra-split(q));
        (Comparable) mid == 0 ? nothing() : hdc-fresh(hdc-row-for-id(mid));
    };
    // ── the high-grammar authority ─────────────────────────────────────────
    // The BML picture of the whole resting-answer law — pointer, honor order,
    // strip seam, and the fourth ending — lives beside the heedmark's the way
    // every high authority does: the .bml is the readable law, this cell is
    // one of its living mirrors, the bands are its witnesses.
    def kra-authority-path() = "form/form-stdlib/bml/form-cli-restanswer.bml";
    def kra-authority-kind() = "high-bml-class-template-field";
    def FormRestAnswerAuthority() = list("abstraction", "FormRestAnswerAuthority", list(), list(), list("kra-authority-path", "kra-authority-kind"), list(), list());
    0;
}
