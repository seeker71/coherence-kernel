//////////////////////////////////////////////////////////////////////
//
// form-cli-turn-evidence-grok.bml
//
// Executable BML for Grok session share. High-grammar authority:
//   form-stdlib/bml/form-cli-turn-evidence-grok.bml
//
// Generic class FormGrokEvidence<T> — FileIO<T> door: methods hoist to
// bare fndefs, type parameter erases, class name mints an abstraction
// descriptor. Named constants ride `field`. Receipt scan and row are
// methods of one organ, not a s-expr do/let/if chain.
//
// Proven by: form-stdlib/tests/form-cli-turn-evidence-grok-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template ReceiptAcc<TCount> {
        member native: TCount;
        member local: TCount;
        member nativeFail: TCount;
        member localFail: TCount;
        member stdout: TCount;
        member stderr: TCount;
        member shown: TCount;
    }

    template SessionPaths<TPath> {
        member root: TPath;
        member terminal: TPath;
        member events: TPath;
    }

    class FormGrokEvidenceAuthority {
        field Path = "form/form-stdlib/bml/form-cli-turn-evidence-grok.bml";
        field Kind = "high-bml-class-template-field";
    }

    class FormGrokEvidence<T> {
        field BindPath = ".form-cli-turn-grok-session";
        field ReceiptMark = "@form ";
        field ReceiptMarkLen = 6;
        field NativeKind = "fkwu";
        field LogSuffix = ".log";
        field TerminalName = "terminal";
        field EventsName = "events.jsonl";
        field TurnStartedMark = "\"type\":\"turn_started\"";
        field ToolCompletedMark = "\"type\":\"tool_completed\"";
        field TsKey = "\"ts\":";
        field Provider = "xai";
        field Model = "grok-4.6";
        field TurnScope = "session";
        field Pipe = "|";
        field Space = " ";
        field ZeroStr = "0";
        field CompleteStr = "1";
        field ChunkBytes = 1048576;
        field OverlapBytes = 32;
        field HeaderBytes = 512;
        field TailBytes = 1024;
        field INative = 0;
        field ILocal = 1;
        field INativeFail = 2;
        field ILocalFail = 3;
        field IStdout = 4;
        field IStderr = 5;
        field IShown = 6;

        ref fctg-authority = FormGrokEvidenceAuthority;
        thought fctg-pattern = list("receipt", "scan", "row", "refresh");

        def fctg-session-bind-path() = BindPath();
        def fctg-chunk() = ChunkBytes();
        def fctg-overlap() = OverlapBytes();
        def fctg-zero() = list(0, 0, 0, 0, 0, 0, 0);
        def fctg-names-none() = tail(list("."));
        def fctg-lf() = byte_to_str(10);
        def fctg-cr() = byte_to_str(13);
        def fctg-refresh-withheld() = str_concat("turn-evidence-refresh=withheld", fctg-lf());
        def fctg-refresh-unreconciled-msg() = str_concat("turn-evidence-refresh=unreconciled", fctg-lf());

        def fctg-nl?(ch) = or(str_eq(ch, fctg-lf()), str_eq(ch, fctg-cr()));
        def fctg-space?(ch) = str_eq(ch, Space());
        def fctg-stop?(ch) = or(fctg-space?(ch), fctg-nl?(ch));
        def fctg-line-start?(s, i) = or(eq(i, 0), fctg-nl?(char_at(s, sub(i, 1))));
        def fctg-digit?(s, i) = is-digit-cp(ord(char_at(s, i)));

        def fctg-kind-end(s, i, n) = if ge(i, n) then i else if fctg-stop?(char_at(s, i)) then i else fctg-kind-end(s, add(i, 1), n);
        def fctg-int-end(s, i, n) = if ge(i, n) then i else if fctg-digit?(s, i) then fctg-int-end(s, add(i, 1), n) else i;
        def fctg-skip-sp(s, i, n) = if ge(i, n) then i else if fctg-space?(char_at(s, i)) then fctg-skip-sp(s, add(i, 1), n) else i;
        def fctg-parse-int(s, a, b) = if eq(a, b) then 0 else str_to_int(substring(s, a, b));

        def fctg-add6(a, b) = list(add(nth(a, INative()), nth(b, INative())), add(nth(a, ILocal()), nth(b, ILocal())), add(nth(a, INativeFail()), nth(b, INativeFail())), add(nth(a, ILocalFail()), nth(b, ILocalFail())), add(nth(a, IStdout()), nth(b, IStdout())), add(nth(a, IStderr()), nth(b, IStderr())), add(nth(a, IShown()), nth(b, IShown())));

        def fctg-receipt(s, i, n) {
            let ke = fctg-kind-end(s, i, n);
            let kind = substring(s, i, ke);
            let a = fctg-skip-sp(s, ke, n);
            let ae = fctg-int-end(s, a, n);
            let b = fctg-skip-sp(s, ae, n);
            let be = fctg-int-end(s, b, n);
            let c = fctg-skip-sp(s, be, n);
            let ce = fctg-int-end(s, c, n);
            let d = fctg-skip-sp(s, ce, n);
            let de = fctg-int-end(s, d, n);
            let ex = fctg-parse-int(s, a, ae);
            let so = fctg-parse-int(s, b, be);
            let se = fctg-parse-int(s, c, ce);
            let sh = fctg-parse-int(s, d, de);
            let fw = if str_eq(kind, NativeKind()) then 1 else 0;
            let loc = if eq(fw, 1) then 0 else 1;
            let nfail = if and(eq(fw, 1), not(eq(ex, 0))) then 1 else 0;
            let lfail = if and(eq(fw, 0), not(eq(ex, 0))) then 1 else 0;
            list(fw, loc, nfail, lfail, so, se, sh);
        }

        def fctg-scan(s, i, n, acc) {
            let p = str_find(s, ReceiptMark(), i);
            if lt(p, 0) then acc
            else if fctg-line-start?(s, p) then fctg-scan(s, add(p, ReceiptMarkLen()), n, fctg-add6(acc, fctg-receipt(s, add(p, ReceiptMarkLen()), n)))
            else fctg-scan(s, add(p, 1), n, acc);
        }

        def fctg-file-scan(path) {
            let s = read_file(path);
            fctg-scan(s, 0, str_len(s), fctg-zero());
        }
        def fctg-file(path) = if le(file_size(path), 0) then fctg-zero() else fctg-file-scan(path);
        def fctg-join-path(dir, name) = fs-path-join(dir, name);
        def fctg-dir(dir, names, acc) = if eq(len(names), 0) then acc else fctg-dir(dir, tail(names), fctg-add6(acc, fctg-file(fctg-join-path(dir, head(names)))));
        def fctg-count-mark(s, needle, from, acc) {
            let p = str_find(s, needle, from);
            if lt(p, 0) then acc else fctg-count-mark(s, needle, add(p, str_len(needle)), add(acc, 1));
        }
        def fctg-pipe(xs) = if eq(len(xs), 0) then "" else if eq(len(tail(xs)), 0) then head(xs) else str_concat(head(xs), str_concat(Pipe(), fctg-pipe(tail(xs))));

        def fctg-row(thread, turn, native, nfail, local, lfail, remote, so, se, sh, tools, started, ended) {
            let dur = sub(ended, started);
            let shown = add(so, se);
            let fcmds = add(native, local);
            let ffail = add(nfail, lfail);
            let total = add(native, add(local, remote));
            fctg-pipe(list(fcte-tag(), thread, turn, Provider(), Model(), int_to_str(started), int_to_str(ended), int_to_str(dur), ZeroStr(), ZeroStr(), int_to_str(remote), ZeroStr(), ZeroStr(), ZeroStr(), ZeroStr(), ZeroStr(), ZeroStr(), ZeroStr(), int_to_str(tools), int_to_str(tools), ZeroStr(), ZeroStr(), int_to_str(fcmds), int_to_str(ffail), int_to_str(so), int_to_str(se), int_to_str(shown), int_to_str(native), int_to_str(nfail), int_to_str(local), int_to_str(remote), int_to_str(total), ZeroStr(), fcte-source-kind-grok(), CompleteStr()));
        }

        def fctg-log-names(names, acc) = if eq(len(names), 0) then acc else if eq(fs-suffix?(head(names), LogSuffix()), 1) then fctg-log-names(tail(names), cons(head(names), acc)) else fctg-log-names(tail(names), acc);

        def fctg-count-file-step(path, needle, size, offset, acc) {
            let remain = sub(size, offset);
            let n = if lt(remain, ChunkBytes()) then remain else ChunkBytes();
            let body = read_file_slice(path, offset, n);
            let from = if eq(offset, 0) then 0 else OverlapBytes();
            let c = fctg-count-mark(body, needle, from, 0);
            let nxt = if eq(add(offset, n), size) then size else sub(add(offset, n), OverlapBytes());
            fctg-count-file-loop(path, needle, size, nxt, add(acc, c));
        }
        def fctg-count-file-loop(path, needle, size, offset, acc) = if ge(offset, size) then acc else fctg-count-file-step(path, needle, size, offset, acc);

        def fctg-count-file(path, needle) = if le(file_size(path), 0) then 0 else fctg-count-file-loop(path, needle, file_size(path), 0, 0);
        def fctg-first-ts(path) = if le(file_size(path), 0) then 0 else fctel-iso-ms(fctel-json-string-after(read_file_slice(path, 0, HeaderBytes()), TsKey(), 0));
        def fctg-last-ts-body(path, size) {
            let start = if lt(size, TailBytes()) then 0 else sub(size, TailBytes());
            let body = read_file_slice(path, start, sub(size, start));
            let p = fctel-find-last-text(body, TsKey(), 0, -1);
            if lt(p, 0) then 0 else fctel-iso-ms(fctel-json-string-after(body, TsKey(), p));
        }
        def fctg-last-ts(path) = if le(file_size(path), 0) then 0 else fctg-last-ts-body(path, file_size(path));

        def fctg-bound-session() = if le(file_size(BindPath()), 0) then "" else fctel-trim-end(read_file(BindPath()));
        def fctg-pair-time(started0, ended0) = if and(gt(started0, 0), ge(ended0, started0)) then list(started0, ended0) else list(0, 0);

        def fctg-refresh-scan(term, events, session) {
            let names = fctg-log-names(fs-list(term), fctg-names-none());
            let acc = fctg-dir(term, names, fctg-zero());
            let remote = fctg-count-file(events, TurnStartedMark());
            let tools = fctg-count-file(events, ToolCompletedMark());
            let ts = fctg-pair-time(fctg-first-ts(events), fctg-last-ts(events));
            let row = fctg-row(fs-path-basename(session), TurnScope(), nth(acc, INative()), nth(acc, INativeFail()), nth(acc, ILocal()), nth(acc, ILocalFail()), remote, nth(acc, IStdout()), nth(acc, IStderr()), nth(acc, IShown()), tools, nth(ts, 0), nth(ts, 1));
            let wrote = write_file_text(fctel-candidate-row-path(), row);
            if eq(fcte-valid?(fcte-parse(row)), 1) then fctg-refresh-observed(row, acc, remote) else fctg-refresh-unreconciled(row);
        }

        def fctg-refresh-observed(row, acc, remote) {
            let kept = write_file_text(fctel-observed-row-path(), row);
            fctel-join(list("turn-evidence-refresh=observed native=", int_to_str(nth(acc, INative())), " local=", int_to_str(nth(acc, ILocal())), " remote=", int_to_str(remote), fctg-lf()));
        }

        def fctg-refresh-unreconciled(row) {
            let kept = write_file_text(fctel-progress-path(), row);
            fctg-refresh-unreconciled-msg();
        }

        def fctg-refresh-once(session) {
            let term = fs-path-join(session, TerminalName());
            let events = fs-path-join(session, EventsName());
            if or(eq(fs-is-dir?(term), 0), eq(fs-exists?(events), 0)) then fctg-refresh-withheld() else fctg-refresh-scan(term, events, session);
        }

        def fctg-bit(ok, bit) = if ok then bit else 0;

        def fctg-check() {
            let p1 = str_concat(fs-temp-dir(), "/fk-grok-a.log");
            let p2 = str_concat(fs-temp-dir(), "/fk-grok-b.log");
            let w1 = fs-write-text(p1, str_concat("@form fkwu 0 10 2 12", str_concat(fctg-lf(), str_concat("@form git 1 3 1 4", fctg-lf()))));
            let w2 = fs-write-text(p2, str_concat("@form fkwu 0 5 0 5", str_concat(fctg-lf(), str_concat("not a receipt", fctg-lf()))));
            let acc = fctg-add6(fctg-file(p1), fctg-file(p2));
            let row = fctg-row("thread-g", "turn-g", nth(acc, INative()), nth(acc, INativeFail()), nth(acc, ILocal()), nth(acc, ILocalFail()), 1, nth(acc, IStdout()), nth(acc, IStderr()), nth(acc, IShown()), 2, 1000, 2000);
            let e = fcte-parse(row);
            let share = fcte-boundary-share(e);
            let c0 = fctg-bit(and(eq(nth(acc, INative()), 2), eq(nth(acc, ILocal()), 1)), 1);
            let c1 = fctg-bit(str_eq(fcte-source(e), fcte-source-kind-grok()), 2);
            let c2 = fctg-bit(and(eq(fcte-valid?(e), 1), str_eq(fcte-kind-name(e), "observed")), 4);
            let c3 = fctg-bit(and(eq(fcte-native-commands(e), 2), and(eq(fcte-local-events(e), 1), eq(fcte-remote-events(e), 1))), 8);
            let c4 = fctg-bit(eq(fcte-form-shown-bytes(e), add(fcte-form-stdout-bytes(e), fcte-form-stderr-bytes(e))), 16);
            let c5 = fctg-bit(eq(sum(share), 100), 32);
            let c6 = fctg-bit(str_eq(fcte-kind-name(fcte-parse("unmeasured")), "declared"), 64);
            let c7 = fctg-bit(str_eq(fcte-kind-name(fcte-parse("turn-evidence-v1|thread-1|turn-1|openai|gpt-test|1000|2000|1000|100|128|2|1000|600|400|0|200|50|1200|3|3|400|2048|2|1|100|20|120|1|0|2|2|5|1|codex-rollout-jsonl+explicit-form-binding|1")), "observed"), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
