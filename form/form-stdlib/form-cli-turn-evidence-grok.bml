//////////////////////////////////////////////////////////////////////
//
// form-cli-turn-evidence-grok.bml
//
// Executable BML for Grok session share. High-grammar authority:
//   form-stdlib/bml/form-cli-turn-evidence-grok.bml
//
// Generic class FormGrokEvidence<T> — FileIO<T> door: methods hoist to
// bare fndefs, type parameter erases, class name mints an abstraction
// descriptor. Named constants ride `field`. Receipt scan and row are
// methods of one organ, not a s-expr do/let/if chain.
//
//
//////////////////////////////////////////////////////////////////////

// preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/language-model.fk form-stdlib/form-cli-turn-evidence.fk form-stdlib/form-cli-turn-evidence-live.fk

section [form.bml] {
    template ReceiptAcc<TCount> {
        member native: TCount;
        member local: TCount;
        member nativeFail: TCount;
        member localFail: TCount;
        member stdout: TCount;
        member stderr: TCount;
        member shown: TCount;
    }

    template SessionPaths<TPath> {
        member root: TPath;
        member terminal: TPath;
        member events: TPath;
    }

    class FormGrokEvidenceAuthority {
        field Path = "form/form-stdlib/bml/form-cli-turn-evidence-grok.bml";
        field Kind = "high-bml-class-template-field";
    }

    class FormGrokEvidence<T> {
        field BindPath = ".form-cli-turn-grok-session";
        field ReceiptMark = "@form ";
        field ReceiptMarkLen = 6;
        field NativeKind = "fkwu";
        field LogSuffix = ".log";
        field TerminalName = "terminal";
        field EventsName = "events.jsonl";
        field TurnStartedMark = "\"type\":\"turn_started\"";
        field ToolCompletedMark = "\"type\":\"tool_completed\"";
        field TsKey = "\"ts\":";
        field Provider = "xai";
        field Model = "grok-4.6";
        field TurnScope = "session";
        field Pipe = "|";
        field Space = " ";
        field ZeroStr = "0";
        field CompleteStr = "1";
        field ChunkBytes = 1048576;
        field OverlapBytes = 32;
        field HeaderBytes = 512;
        field TailBytes = 1024;
        field INative = 0;
        field ILocal = 1;
        field INativeFail = 2;
        field ILocalFail = 3;
        field IStdout = 4;
        field IStderr = 5;
        field IShown = 6;

        ref fctg-authority = FormGrokEvidenceAuthority;
        thought fctg-pattern = list("receipt", "scan", "row", "refresh");

        def fctg-session-bind-path() = BindPath();
        def fctg-chunk() = ChunkBytes();
        def fctg-overlap() = OverlapBytes();
        def fctg-zero() = list(0, 0, 0, 0, 0, 0, 0);
        def fctg-names-none() = tail(list("."));
        def fctg-lf() = byte_to_str(10);
        def fctg-cr() = byte_to_str(13);
        def fctg-refresh-unavailable() = "turn-evidence-refresh=unavailable reason=no-terminal-events-file" ++ fctg-lf();
        def fctg-refresh-unreconciled-msg() = "turn-evidence-refresh=unreconciled" ++ fctg-lf();

        def fctg-nl?(ch) = ((String) ch == fctg-lf()) || ((String) ch == fctg-cr());
        def fctg-space?(ch) = (String) ch == Space();
        def fctg-stop?(ch) = fctg-space?(ch) || fctg-nl?(ch);
        def fctg-line-start?(s, i) = ((Comparable) i == 0) || fctg-nl?(char_at(s, i - 1));
        def fctg-digit?(s, i) = is-digit-cp(ord(char_at(s, i)));

        def fctg-kind-end(s, i, n) = i >= n ? i : fctg-stop?(char_at(s, i)) ? i : fctg-kind-end(s, i + 1, n);
        def fctg-int-end(s, i, n) = i >= n ? i : fctg-digit?(s, i) ? fctg-int-end(s, i + 1, n) : i;
        def fctg-skip-sp(s, i, n) = i >= n ? i : fctg-space?(char_at(s, i)) ? fctg-skip-sp(s, i + 1, n) : i;
        def fctg-parse-int(s, a, b) = (Comparable) a == b ? 0 : str_to_int(substring(s, a, b));

        def fctg-add6(a, b) = list(a[INative()] + b[INative()], a[ILocal()] + b[ILocal()], a[INativeFail()] + b[INativeFail()], a[ILocalFail()] + b[ILocalFail()], a[IStdout()] + b[IStdout()], a[IStderr()] + b[IStderr()], a[IShown()] + b[IShown()]);

        def fctg-receipt(s, i, n) {
            let ke = fctg-kind-end(s, i, n);
            let kind = substring(s, i, ke);
            let a = fctg-skip-sp(s, ke, n);
            let ae = fctg-int-end(s, a, n);
            let b = fctg-skip-sp(s, ae, n);
            let be = fctg-int-end(s, b, n);
            let c = fctg-skip-sp(s, be, n);
            let ce = fctg-int-end(s, c, n);
            let d = fctg-skip-sp(s, ce, n);
            let de = fctg-int-end(s, d, n);
            let ex = fctg-parse-int(s, a, ae);
            let so = fctg-parse-int(s, b, be);
            let se = fctg-parse-int(s, c, ce);
            let sh = fctg-parse-int(s, d, de);
            let fw = (String) kind == NativeKind() ? 1 : 0;
            let loc = (Comparable) fw == 1 ? 0 : 1;
            let nfail = ((Comparable) fw == 1) && (!((Comparable) ex == 0)) ? 1 : 0;
            let lfail = ((Comparable) fw == 0) && (!((Comparable) ex == 0)) ? 1 : 0;
            list(fw, loc, nfail, lfail, so, se, sh);
        }

        def fctg-scan(s, i, n, acc) {
            let p = str_find(s, ReceiptMark(), i);
            p < 0 ? acc
            : fctg-line-start?(s, p) ? fctg-scan(s, p + ReceiptMarkLen(), n, fctg-add6(acc, fctg-receipt(s, p + ReceiptMarkLen(), n)))
            : fctg-scan(s, p + 1, n, acc);
        }

        def fctg-file-scan(path) {
            let s = read_file(path);
            fctg-scan(s, 0, str_len(s), fctg-zero());
        }
        def fctg-file(path) = file_size(path) <= 0 ? fctg-zero() : fctg-file-scan(path);
        def fctg-join-path(dir, name) = fs-path-join(dir, name);
        def fctg-dir(dir, names, acc) = (Comparable) len(names) == 0 ? acc : fctg-dir(dir, tail(names), fctg-add6(acc, fctg-file(fctg-join-path(dir, head(names)))));
        def fctg-count-mark(s, needle, from, acc) {
            let p = str_find(s, needle, from);
            p < 0 ? acc : fctg-count-mark(s, needle, p + str_len(needle), acc + 1);
        }
        def fctg-pipe(xs) = (Comparable) len(xs) == 0 ? "" : (Comparable) len(tail(xs)) == 0 ? head(xs) : head(xs) ++ Pipe() ++ fctg-pipe(tail(xs));

        def fctg-row(thread, turn, native, nfail, local, lfail, remote, so, se, sh, tools, started, ended) {
            let dur = ended - started;
            let shown = so + se;
            let fcmds = native + local;
            let ffail = nfail + lfail;
            let total = native + (local + remote);
            fctg-pipe(list(fcte-tag(), thread, turn, Provider(), Model(), int_to_str(started), int_to_str(ended), int_to_str(dur), ZeroStr(), ZeroStr(), int_to_str(remote), ZeroStr(), ZeroStr(), ZeroStr(), ZeroStr(), ZeroStr(), ZeroStr(), ZeroStr(), int_to_str(tools), int_to_str(tools), ZeroStr(), ZeroStr(), int_to_str(fcmds), int_to_str(ffail), int_to_str(so), int_to_str(se), int_to_str(shown), int_to_str(native), int_to_str(nfail), int_to_str(local), int_to_str(remote), int_to_str(total), ZeroStr(), fcte-source-kind-grok(), CompleteStr(), ZeroStr()));
        }

        def fctg-log-names(names, acc) = (Comparable) len(names) == 0 ? acc : (Comparable) fs-suffix?(head(names), LogSuffix()) == 1 ? fctg-log-names(tail(names), cons(head(names), acc)) : fctg-log-names(tail(names), acc);

        def fctg-count-file-step(path, needle, size, offset, acc) {
            let remain = size - offset;
            let n = remain < ChunkBytes() ? remain : ChunkBytes();
            let body = read_file_slice(path, offset, n);
            let from = (Comparable) offset == 0 ? 0 : OverlapBytes();
            let c = fctg-count-mark(body, needle, from, 0);
            let nxt = (Comparable) (offset + n) == size ? size : ((offset + n) - OverlapBytes());
            fctg-count-file-loop(path, needle, size, nxt, acc + c);
        }
        def fctg-count-file-loop(path, needle, size, offset, acc) = offset >= size ? acc : fctg-count-file-step(path, needle, size, offset, acc);

        def fctg-count-file(path, needle) = file_size(path) <= 0 ? 0 : fctg-count-file-loop(path, needle, file_size(path), 0, 0);
        def fctg-first-ts(path) = file_size(path) <= 0 ? 0 : fctel-iso-ms(fctel-json-root-string(fctel-first-line(read_file_slice(path, 0, HeaderBytes())), "ts"));
        def fctg-last-ts-lines(body, from, last) {
            from >= str_len(body) ? last : fctg-last-ts-line(body, from, last, scan_run(body, from, 5));
        }
        def fctg-last-ts-line(body, from, last, foundEnd) {
            let end = foundEnd > str_len(body) ? str_len(body) : foundEnd;
            let observed = fctel-iso-ms(fctel-json-root-string(substring(body, from, end), "ts"));
            let nextLast = observed > 0 ? observed : last;
            foundEnd >= str_len(body) ? nextLast : fctg-last-ts-lines(body, foundEnd + 1, nextLast);
        }
        def fctg-last-ts-body(path, size) {
            let start = size < TailBytes() ? 0 : (size - TailBytes());
            let body = read_file_slice(path, start, size - start);
            let first = (Comparable) start == 0 ? 0 : (scan_run(body, 0, 5) + 1);
            fctg-last-ts-lines(body, first, 0);
        }
        def fctg-last-ts(path) = file_size(path) <= 0 ? 0 : fctg-last-ts-body(path, file_size(path));

        def fctg-bound-session() = file_size(BindPath()) <= 0 ? "" : fctel-trim-end(read_file(BindPath()));
        def fctg-pair-time(started0, ended0) = (started0 > 0) && (ended0 >= started0) ? list(started0, ended0) : list(0, 0);

        def fctg-refresh-scan(term, events, session) {
            let names = fctg-log-names(fs-list(term), fctg-names-none());
            let acc = fctg-dir(term, names, fctg-zero());
            let remote = fctg-count-file(events, TurnStartedMark());
            let tools = fctg-count-file(events, ToolCompletedMark());
            let ts = fctg-pair-time(fctg-first-ts(events), fctg-last-ts(events));
            let row = fctg-row(fs-path-basename(session), TurnScope(), acc[INative()], acc[INativeFail()], acc[ILocal()], acc[ILocalFail()], remote, acc[IStdout()], acc[IStderr()], acc[IShown()], tools, ts[0], ts[1]);
            let wrote = write_file_text(fctel-candidate-row-path(), row);
            (Comparable) fcte-valid?(fcte-parse(row)) == 1 ? fctg-refresh-observed(row, acc, remote) : fctg-refresh-unreconciled(row);
        }

        def fctg-refresh-observed(row, acc, remote) {
            let kept = write_file_text(fctel-observed-row-path(), row);
            fctel-join(list("turn-evidence-refresh=observed native=", int_to_str(acc[INative()]), " local=", int_to_str(acc[ILocal()]), " remote=", int_to_str(remote), fctg-lf()));
        }

        def fctg-refresh-unreconciled(row) {
            let kept = write_file_text(fctel-progress-path(), row);
            fctg-refresh-unreconciled-msg();
        }

        // An unbound host still has its own receipts. Read those, and the
        // provider-usage lines in its own transcript. Absence of a Codex
        // rollout is attention, not a withheld share.
        def fctg-no-lead-slash(path) = eq(str_byte_at(path, 0), 47) ? substring(path, 1, str_len(path)) : path;
        def fctg-cursor-root() = str_eq(fctd-home(), "") ? "" : fs-path-join(fs-path-join(fctd-home(), ".cursor/projects"), fctd-slug(fctg-no-lead-slash(fctd-here())));
        def fctg-receipt-names(names, acc) = eq(len(names), 0) ? acc : eq(fs-suffix?(head(names), ".log"), 1) || eq(fs-suffix?(head(names), ".txt"), 1) ? fctg-receipt-names(tail(names), cons(head(names), acc)) : fctg-receipt-names(tail(names), acc);
        def fctg-mark-value(s, mark) {
            let p = str_find(s, mark, 0);
            p < 0 ? "" : fctg-mark-rest(s, p + str_len(mark));
        }
        def fctg-mark-rest(s, a) {
            let b = str_find(s, fctg-lf(), a);
            fctel-trim-end(b < 0 ? substring(s, a, str_len(s)) : substring(s, a, b));
        }
        def fctg-min-pos(cur, v) = eq(v, 0) ? cur : eq(cur, 0) || v < cur ? v : cur;
        def fctg-max-pos(cur, v) = v > cur ? v : cur;
        def fctg-span(dir, names, lo, hi) = eq(len(names), 0) ? list(lo, hi) : fctg-span-one(dir, names, lo, hi);
        def fctg-span-one(dir, names, lo, hi) {
            let s = read_file(fs-path-join(dir, head(names)));
            let a = fctel-iso-ms(fctg-mark-value(s, "started_at: "));
            let b = fctel-iso-ms(fctg-mark-value(s, "ended_at: "));
            fctg-span(dir, tail(names), fctg-min-pos(lo, a), fctg-max-pos(hi, b));
        }
        def fctg-scan-nested(parent, names, current) = eq(len(names), 0) ? current : fctg-scan-nested-one(parent, names, current);
        def fctg-scan-nested-one(parent, names, current) {
            let sub = fs-path-join(parent, head(names));
            let found = eq(fs-is-dir?(sub), 1) ? fctd-newest-in(sub) : fctd-newest-none();
            let next = eq(fctd-newest-some?(found), 1) ? fctd-better(current, fctd-newest-path(found), fctd-newest-mtime(found)) : current;
            fctg-scan-nested(parent, tail(names), next);
        }
        def fctg-count-usage(lines) = eq(len(lines), 0) ? 0 : frte-call-local-usage-line?(head(lines)) + fctg-count-usage(tail(lines));
        def fctg-assistant-mark() = "{\"role\":\"assistant\"";
        def fctg-transcript-bind() = ".form-cli-turn-cursor-transcript";
        def fctg-provider-calls(path) {
            let usage = fctg-count-usage(split-on(read_file(path), fctg-lf()));
            usage > 0 ? usage : fctg-count-file(path, fctg-assistant-mark());
        }
        def fctg-tool-mark() = "\"type\":\"tool_use\"";
        def fctg-shell-mark() = "\"name\":\"Shell\"";
        def fctg-text-mark() = "\"type\":\"text\"";
        def fctg-lanes-zero() = list(0, 0, 0);
        def fctg-lanes-add(acc, native, local, remote) = list(acc[0] + native, acc[1] + local, acc[2] + remote);
        def fctg-command-key() = "\"command\":\"";
        def fctg-command-start(line, at) {
            let p = str_find(line, fctg-command-key(), at);
            p < 0 ? -1 : p + str_len(fctg-command-key());
        }
        def fctg-shell-native?(line, at) {
            let a = fctg-command-start(line, at);
            let end = a + 16384;
            let stop = a < 0 ? 0 : str_len(line) < end ? str_len(line) : end;
            let window = a < 0 ? "" : substring(line, a, stop);
            a < 0 ? 0 : str_find(window, "fkwu", 0) < 0 ? 0 : 1;
        }
        def fctg-shells(line, from, native, local) {
            let p = str_find(line, fctg-shell-mark(), from);
            p < 0 ? list(native, local)
            : eq(fctg-shell-native?(line, p), 1) ? fctg-shells(line, p + str_len(fctg-shell-mark()), native + 1, local)
            : fctg-shells(line, p + str_len(fctg-shell-mark()), native, local + 1);
        }
        def fctg-lane-line(line, acc) {
            let tools = fctg-count-mark(line, fctg-tool-mark(), 0, 0);
            let [native, shellLocal] = fctg-shells(line, 0, 0, 0);
            let other = tools - (native + shellLocal);
            let local = (other < 0 ? 0 : other) + shellLocal;
            let speech = str_find(line, fctg-assistant-mark(), 0) >= 0 && str_find(line, fctg-text-mark(), 0) >= 0 ? 1 : 0;
            fctg-lanes-add(acc, native, local, speech);
        }
        def fctg-lane-lines(lines, acc) = eq(len(lines), 0) ? acc : fctg-lane-lines(tail(lines), fctg-lane-line(head(lines), acc));
        def fctg-transcript-lanes(path) {
            let lines = split-on(read_file(path), fctg-lf());
            let usage = fctg-count-usage(lines);
            let lanes = fctg-lane-lines(lines, fctg-lanes-zero());
            let remote = usage > 0 ? usage : lanes[2];
            list(lanes[0], lanes[1], remote);
        }
        def fctg-with-lanes(acc, native, local) = list(native, local, acc[INativeFail()], acc[ILocalFail()], acc[IStdout()], acc[IStderr()], acc[IShown()]);
        def fctg-observed-foreign?() {
            file_size(fctel-observed-row-path()) <= 0 ? 0
            : fctg-observed-foreign-row(fctel-trim-end(read_file(fctel-observed-row-path())));
        }
        def fctg-observed-foreign-row(row) {
            let e = fcte-parse(row);
            eq(fcte-valid?(e), 0) ? 0 : str_eq(fcte-source(e), fcte-source-kind-grok()) ? 0 : 1;
        }
        def fctg-attend-write(acc, remote, started, ended) {
            let row = fctg-row(fctd-slug(fctg-no-lead-slash(fctd-here())), TurnScope(), acc[INative()], acc[INativeFail()], acc[ILocal()], acc[ILocalFail()], remote, acc[IStdout()], acc[IStderr()], acc[IShown()], 0, started, ended);
            let wrote = write_file_text(fctel-observed-row-path(), row);
            eq(fcte-valid?(fcte-parse(row)), 1) ? fctg-refresh-observed(row, acc, remote) : fctg-refresh-unreconciled(row);
        }
        def fctg-attend-term(root, term) {
            let names = fctg-receipt-names(fs-list(term), fctg-names-none());
            let acc = fctg-dir(term, names, fctg-zero());
            let [started, ended0] = fctg-span(term, names, 0, 0);
            let ended = ended0 >= started ? ended0 : started;
            let sessions = fs-path-join(root, "agent-transcripts");
            let newest = eq(fs-is-dir?(sessions), 0) ? fctd-newest-none() : fctg-scan-nested(sessions, fs-list(sessions), fctd-newest-none());
            let transcript = eq(fctd-newest-some?(newest), 0) ? "" : fctd-newest-path(newest);
            let kept-transcript = str_eq(transcript, "") ? 0 : write_file_text(fctg-transcript-bind(), transcript);
            let lanes = str_eq(transcript, "") ? fctg-lanes-zero() : fctg-transcript-lanes(transcript);
            let laneSum = lanes[0] + (lanes[1] + lanes[2]);
            let counted = laneSum > 0 ? fctg-with-lanes(acc, lanes[0], lanes[1]) : acc;
            let remote = laneSum > 0 ? lanes[2] : str_eq(transcript, "") ? 0 : fctg-provider-calls(transcript);
            let commands = counted[INative()] + counted[ILocal()];
            eq(started, 0) || eq(commands, 0) ? "turn-evidence-refresh=attention reason=receipts-without-a-time" ++ fctg-lf() : fctg-attend-write(counted, remote, started, ended);
        }
        def fctg-attend-cursor() {
            let root = fctg-cursor-root();
            let term = fs-path-join(root, "terminals");
            str_eq(root, "") || eq(fs-is-dir?(term), 0) ? "turn-evidence-refresh=attention reason=no-session-receipts" ++ fctg-lf() : fctg-attend-term(root, term);
        }
        def fctg-attend-unbound() = host_file_size(fctel-binding-path()) > 0 ? "" : eq(fctg-observed-foreign?(), 1) ? "" : fctg-attend-cursor();

        def fctg-refresh-once(session) {
            let term = fs-path-join(session, TerminalName());
            let events = fs-path-join(session, EventsName());
            ((Comparable) fs-is-dir?(term) == 0) || ((Comparable) fs-exists?(events) == 0) ? fctg-refresh-unavailable() : fctg-refresh-scan(term, events, session);
        }

        def fctg-bit(ok, bit) = ok ? bit : 0;

        def fctg-check() {
            let p1 = fs-temp-dir() ++ "/fk-grok-a.log";
            let p2 = fs-temp-dir() ++ "/fk-grok-b.log";
            let w1 = fs-write-text(p1, "@form fkwu 0 10 2 12" ++ fctg-lf() ++ "@form git 1 3 1 4" ++ fctg-lf());
            let w2 = fs-write-text(p2, "@form fkwu 0 5 0 5" ++ fctg-lf() ++ "not a receipt" ++ fctg-lf());
            let acc = fctg-add6(fctg-file(p1), fctg-file(p2));
            let row = fctg-row("thread-g", "turn-g", acc[INative()], acc[INativeFail()], acc[ILocal()], acc[ILocalFail()], 1, acc[IStdout()], acc[IStderr()], acc[IShown()], 2, 1000, 2000);
            let e = fcte-parse(row);
            let share = fcte-boundary-share(e);
            let c0 = fctg-bit(((Comparable) acc[INative()] == 2) && ((Comparable) acc[ILocal()] == 1), 1);
            let c1 = fctg-bit((String) fcte-source(e) == fcte-source-kind-grok(), 2);
            let c2 = fctg-bit(((Comparable) fcte-valid?(e) == 1) && ((String) fcte-kind-name(e) == "observed"), 4);
            let c3 = fctg-bit(((Comparable) fcte-native-commands(e) == 2) && (((Comparable) fcte-local-events(e) == 1) && ((Comparable) fcte-remote-events(e) == 1)), 8);
            let c4 = fctg-bit((Comparable) fcte-form-shown-bytes(e) == (fcte-form-stdout-bytes(e) + fcte-form-stderr-bytes(e)), 16);
            let c5 = fctg-bit((Comparable) sum(share) == 100, 32);
            let c6 = fctg-bit((String) fcte-kind-name(fcte-parse("unmeasured")) == "declared", 64);
            let c7 = fctg-bit((String) fcte-kind-name(fcte-parse("turn-evidence-v1|thread-1|turn-1|openai|gpt-test|1000|2000|1000|100|128|2|1000|600|400|0|200|50|1200|3|3|400|2048|2|1|100|20|120|1|0|2|2|5|1|codex-rollout-jsonl+explicit-form-binding|1")) == "observed", 128);
            c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + c7))))));
        }
    }
    0;
}
