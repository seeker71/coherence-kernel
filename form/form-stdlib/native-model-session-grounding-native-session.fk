; native-model-session-grounding-native-session.fk -- minimal shared session
; descriptor for discovery and transient privacy reduction.  The path remains
; local to the live evaluation; the cell carries its deterministic content
; address and imports no discovery, evaluator, ranker, or task vocabulary.
; preludes: form-stdlib/native-model-session-grounding-native-common.fk

(do
    ; tag, content address, local path, declared start time, filesystem mtime.
    (defn nmsgn-session (path started mtime)
        (list "native-session-descriptor-cell-v1"
              (nmsgn-sha256
                (nmsgn-cat (list path "\n" started "\n" (int_to_str mtime))))
              path started mtime))
    (defn nmsgn-session-address (row) (nth row 1))
    (defn nmsgn-session-path (row) (nth row 2))
    (defn nmsgn-session-started (row) (nth row 3))
    (defn nmsgn-session-mtime (row) (nth row 4))
    0)
