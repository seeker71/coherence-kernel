//////////////////////////////////////////////////////////////////////
//
// scale.bml
//
// Executable BML. The FIXED-POINT SCALE: parts-per-million is how the
// body writes a fraction without a float — coverage, budgets, expert
// weights, bounds. The scale is one number with one home; a ratio
// becomes ppm through one door and a ppm becomes a share of a total
// through the inverse door. An empty denominator answers 0, never
// dies: an absent total has no fraction. Before 2026-09-03 the scale
// was spelled inline in 303 cells with no defn.
//
// preludes: form-stdlib/core.fk
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormScale {
        thought scale-pattern = list("one-scale", "ratio-to-ppm", "ppm-to-share", "empty-total-is-zero");

        def ppm-scale() = 1000000;
        def ppm-of(num, den) = (Comparable) den == 0 ? 0 : ((num * ppm-scale()) / den);
        def ppm-share(ppm, total) = (ppm * total) / ppm-scale();
        def ppm-share-ceil(ppm, total) = ((ppm * total) + (ppm-scale() - 1)) / ppm-scale();
        def ppm-whole?(ppm) = (Comparable) ppm == ppm-scale() ? 1 : 0;
        def ppm-in-range?(ppm) = (ppm >= 0) && (ppm <= ppm-scale()) ? 1 : 0;
    }
    0;
}
