//////////////////////////////////////////////////////////////////////
//
// native-model-form-token-envelope.bml — executable registry-wide Form
// token projection and compact prompt envelope.
//
// Authority: form-stdlib/bml/native-model-form-token-envelope.bml
// preludes: form-stdlib/core.fk form-stdlib/native-model-control-plane.fk form-stdlib/native-model-control-plane-eval.fk form-stdlib/form-teach-layer.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelFormTokenEnvelopeAuthority {
        field NMFTEAuthorityPath = "form/form-stdlib/bml/native-model-form-token-envelope.bml";
        field NMFTEAuthorityKind = "high-bml-interface-class-const";
    }

    class NativeModelFormTokenEnvelope {
        field NMFTESchema = "native-model-form-token-envelope-v1";
        field NMFTEThreeB = "base.llama32-3b-metal";
        field NMFTEQwen = "challenger.qwen38-flash-next-q2-metal";
        field NMFTEDS4 = "challenger.deepseek-ds4-metal";
        field NMFTEWorld = "world.entity-state";
        field NMFTEControls = 8;
        field NMFTENativeWords = 20;

        ref nmfte-authority = NativeModelFormTokenEnvelopeAuthority;
        thought nmfte-law = list("one-control-semantics", "all-registry-rows-projected", "availability-is-explicit", "model-output-remains-inert");

        def nmfte-compact-prefix() {
            "Form output is inert until native validation. Primitives: mul add sub list lookup. Return one expression/tag/offered call.\n";
        }
        def nmfte-control-tags() = list("<CHOICE>", "<CUT>", "<FAIL>", "<STOP>", "<UNDO>", "<STORE>", "<RESTORE>", "<TIMEOUT>");

        // Native word row: tag, canonical word, family, witnessed substrate.
        // `crystalize` is accepted as the arrival spelling and normalized to
        // the body's existing `crystallize` spelling.
        def nmfte-native-word(word, family, substrate) = list("native-model-form-word", word, family, substrate);
        def nmfte-native-vocabulary() = list(nmfte-native-word("Node-ID", "identity", "make_nodeid/core"), nmfte-native-word("nothing", "state", "axiom-1/core"), nmfte-native-word("choice", "control", "control/choice-lane-core.fk"), nmfte-native-word("fail", "control", "control/offer-ack-core.fk"), nmfte-native-word("cut", "control", "control/choice-lane-core.fk"), nmfte-native-word("undo", "control", "control/choice-lane-core.fk"), nmfte-native-word("timeout", "control", "control/choice-lane-core.fk"), nmfte-native-word("eval", "evaluation", "form/form-stdlib/form-eval-full.fk"), nmfte-native-word("store", "memory", "control/choice-lane-core.fk"), nmfte-native-word("release", "lifecycle", "control/session-recording-lifecycle.fk"), nmfte-native-word("melt", "jit-lifecycle", "observe/jit-decision.fk"), nmfte-native-word("crystallize", "jit-lifecycle", "observe/native-crystallize.fk"), nmfte-native-word("open", "lifecycle", "observe/form-membrane-runtime-census.fk"), nmfte-native-word("interface", "contract", "form/form-stdlib/channel-interface.fk"), nmfte-native-word("protocol", "contract", "form/form-stdlib/form-agent-protocol.fk"), nmfte-native-word("offer", "relation", "control/offer-ack-core.fk"), nmfte-native-word("ask", "inquiry", "cognition/ask-grounded-rtx.fk"), nmfte-native-word("broadcast", "relation", "observe/world-perception.fk"), nmfte-native-word("mesh", "relation", "observe/mesh-join.fk"), nmfte-native-word("satsang", "relation", "form/form-stdlib/satsang.fk"));
        def nmfte-word-name(word) = nth(word, 1);
        def nmfte-word-family(word) = nth(word, 2);
        def nmfte-word-substrate(word) = nth(word, 3);
        def nmfte-canonical-word(word) = if str_eq(word, "crystalize") then "crystallize" else word;
        def nmfte-find-word(word, words) = if eq(len(words), 0) then list() else if str_eq(nmfte-canonical-word(word), nmfte-word-name(head(words))) then head(words) else nmfte-find-word(word, tail(words));
        def nmfte-native-word?(word) = if eq(len(nmfte-find-word(word, nmfte-native-vocabulary())), 0) then 0 else 1;

        def nmfte-local-class?(className) {
            if str_eq(className, "form-native") then 1
            else if str_eq(className, "local-finetuned") then 1
            else if str_eq(className, "local-native") then 1
            else if str_eq(className, "local-oracle") then 1
            else 0;
        }
        def nmfte-local?(row) = nmfte-local-class?(nmcp-class(row));
        def nmfte-unbound-runtime?(runtime) = if eq(str_find(runtime, "unbound-", 0), 0) then 1 else 0;
        def nmfte-textual?(row) {
            if str_eq(nmcp-modality(row), "text") then 1
            else if str_eq(nmcp-id(row), NMFTEWorld()) then 1
            else 0;
        }
        def nmfte-generative?(row) {
            if str_eq(nmcp-lane(row), "text-generation") then 1
            else if str_eq(nmcp-lane(row), "general-text") then 1
            else if str_eq(nmcp-lane(row), "general-text-code") then 1
            else if str_eq(nmcp-lane(row), "general-reasoning") then 1
            else if str_eq(nmcp-lane(row), "general-reasoning-code-agent") then 1
            else if str_eq(nmcp-lane(row), "form-knowledge") then 1
            else 0;
        }
        def nmfte-mode(row) {
            if eq(nmfte-local?(row), 0) then "excluded-remote-or-fixture"
            else if eq(nmfte-textual?(row), 0) then "not-applicable-nontext"
            else if eq(nmfte-unbound-runtime?(nmcp-runtime(row)), 1) then "blocked-runtime"
            else if and(str_eq(nmcp-class(row), "form-native"), eq(nmfte-generative?(row), 0)) then "native-primitives"
            else if str_eq(nmcp-id(row), NMFTEDS4()) then "control-logit+compact-prefix"
            else "compact-prefix";
        }
        def nmfte-prompt-admitted?(row) {
            let mode = nmfte-mode(row);
            if str_eq(mode, "compact-prefix") then 1
            else if str_eq(mode, "control-logit+compact-prefix") then 1
            else 0;
        }
        def nmfte-native-admitted?(row) = if str_eq(nmfte-mode(row), "native-primitives") then 1 else 0;
        def nmfte-state(row) {
            if eq(nmfte-prompt-admitted?(row), 1) then "prompt-admitted"
            else if eq(nmfte-native-admitted?(row), 1) then "native-admitted"
            else if str_eq(nmfte-mode(row), "blocked-runtime") then "blocked"
            else "not-admitted";
        }
        def nmfte-reason(row) {
            let mode = nmfte-mode(row);
            if str_eq(mode, "compact-prefix") then "bound-local-text-generator"
            else if str_eq(mode, "control-logit+compact-prefix") then "ds4-reserved-control-bank-plus-shared-text"
            else if str_eq(mode, "native-primitives") then "form-native-lane-already-executes-form-meaning"
            else if str_eq(mode, "blocked-runtime") then "artifact-present-with-no-bound-executor"
            else if str_eq(mode, "not-applicable-nontext") then "text-controls-do-not-impersonate-audio-or-vision-tokens"
            else "remote-or-policy-row-is-outside-local-admission";
        }

        // envelope row: tag, id, local, prompt-admitted, native-admitted,
        // delivery mode, control count, concept count, state, reason.
        def nmfte-project(row) {
            list("native-model-form-token-envelope", nmcp-id(row), nmfte-local?(row), nmfte-prompt-admitted?(row), nmfte-native-admitted?(row), nmfte-mode(row), NMFTEControls(), if eq(nmfte-local?(row), 1) then NMFTENativeWords() else 0, nmfte-state(row), nmfte-reason(row));
        }
        def nmfte-project-all(rows) = if eq(len(rows), 0) then list() else cons(nmfte-project(head(rows)), nmfte-project-all(tail(rows)));
        def nmfte-envelope-id(envelope) = nth(envelope, 1);
        def nmfte-envelope-local?(envelope) = nth(envelope, 2);
        def nmfte-envelope-prompt-admitted?(envelope) = nth(envelope, 3);
        def nmfte-envelope-native-admitted?(envelope) = nth(envelope, 4);
        def nmfte-envelope-mode(envelope) = nth(envelope, 5);
        def nmfte-envelope-controls(envelope) = nth(envelope, 6);
        def nmfte-envelope-concepts(envelope) = nth(envelope, 7);
        def nmfte-envelope-native-words(envelope) = nth(envelope, 7);
        def nmfte-envelope-state(envelope) = nth(envelope, 8);
        def nmfte-envelope-reason(envelope) = nth(envelope, 9);

        def nmfte-find-row(id, rows) = if eq(len(rows), 0) then list() else if str_eq(id, nmcp-id(head(rows))) then head(rows) else nmfte-find-row(id, tail(rows));
        def nmfte-find(id, envelopes) = if eq(len(envelopes), 0) then list() else if str_eq(id, nmfte-envelope-id(head(envelopes))) then head(envelopes) else nmfte-find(id, tail(envelopes));
        def nmfte-wrap(row, prompt) = if eq(nmfte-prompt-admitted?(row), 1) then str_concat(nmfte-compact-prefix(), prompt) else prompt;
        def nmfte-wrap-id(id, prompt) {
            let row = nmfte-find-row(id, nmcp-registry());
            if eq(len(row), 0) then "" else nmfte-wrap(row, prompt);
        }
        def nmfte-count-prompt-admitted(envelopes) = if eq(len(envelopes), 0) then 0 else add(nmfte-envelope-prompt-admitted?(head(envelopes)), nmfte-count-prompt-admitted(tail(envelopes)));
        def nmfte-count-native-admitted(envelopes) = if eq(len(envelopes), 0) then 0 else add(nmfte-envelope-native-admitted?(head(envelopes)), nmfte-count-native-admitted(tail(envelopes)));
        def nmfte-count-local(envelopes) = if eq(len(envelopes), 0) then 0 else add(nmfte-envelope-local?(head(envelopes)), nmfte-count-local(tail(envelopes)));
        def nmfte-has?(text, needle) = if ge(str_find(text, needle, 0), 0) then 1 else 0;
        def nmfte-prefix-complete?() {
            let p = nmfte-compact-prefix();
            if not(eq(len(nmfte-control-tags()), NMFTEControls())) then 0
            else if eq(nmfte-has?(p, "inert until native validation"), 0) then 0
            else if eq(nmfte-has?(p, "mul add sub list lookup"), 0) then 0
            else 1;
        }
        def nmfte-vocabulary-complete?() {
            if not(eq(len(nmfte-native-vocabulary()), NMFTENativeWords())) then 0
            else if eq(nmfte-native-word?("Node-ID"), 0) then 0
            else if eq(nmfte-native-word?("nothing"), 0) then 0
            else if eq(nmfte-native-word?("choice"), 0) then 0
            else if eq(nmfte-native-word?("fail"), 0) then 0
            else if eq(nmfte-native-word?("cut"), 0) then 0
            else if eq(nmfte-native-word?("undo"), 0) then 0
            else if eq(nmfte-native-word?("timeout"), 0) then 0
            else if eq(nmfte-native-word?("eval"), 0) then 0
            else if eq(nmfte-native-word?("store"), 0) then 0
            else if eq(nmfte-native-word?("release"), 0) then 0
            else if eq(nmfte-native-word?("melt"), 0) then 0
            else if eq(nmfte-native-word?("crystallize"), 0) then 0
            else if eq(nmfte-native-word?("open"), 0) then 0
            else if eq(nmfte-native-word?("interface"), 0) then 0
            else if eq(nmfte-native-word?("protocol"), 0) then 0
            else if eq(nmfte-native-word?("offer"), 0) then 0
            else if eq(nmfte-native-word?("ask"), 0) then 0
            else if eq(nmfte-native-word?("broadcast"), 0) then 0
            else if eq(nmfte-native-word?("mesh"), 0) then 0
            else if eq(nmfte-native-word?("satsang"), 0) then 0
            else if eq(nmfte-native-word?("crystalize"), 0) then 0
            else 1;
        }
    }
    0;
}
