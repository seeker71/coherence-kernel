; living-world-branch-overlap.fk -- overlap stays plural; branch release stays
; inside its authority boundary.
;
; Two valid continuity branches may share exact cells while carrying
; incompatible relations.  This organ derives that overlap and contention
; from their content-addressed projections.  Both routes remain present; the
; contention has no selected, primary, winning, or default route.  Optional
; declaration, lens, alternatives, and unknowable tissue may all be absent.
;
; A restored branch is a consented view, not an owner of its projected
; payload.  Scoped compost therefore retires only the exact restore candidate.
; Every active candidate holder must acknowledge the exact plan.  Integration
; appends one source-local revocation per candidate attribution and retains the
; prior world in a receipt.  Shared cells, relations, source attributions,
; other branches, and their restored candidates are never deleted.  Physical
; collection and global truth resolution are deliberately not claimed.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-continuity-branch.fk

(let LWBO-OVERLAP          (bp "LWBO-OVERLAP"))
(let LWBO-CONTENTION       (bp "LWBO-CONTENTION"))
(let LWBO-COMPOST-PLAN     (bp "LWBO-COMPOST-PLAN"))
(let LWBO-COMPOST-RECEIPT  (bp "LWBO-COMPOST-RECEIPT"))

(defn lwbo-intersection-items (items other)
    (if (eq (len items) 0) (lwo-empty-field)
        (do
            (let rest (lwbo-intersection-items (tail items) other))
            (if (eq (lwo-field-has? other (head items)) 1)
                (lwo-field-add rest (head items)) rest))))

(defn lwbo-intersection (left right)
    (lwbo-intersection-items (lwo-field-items left) right))

(defn lwbo-conflicts-with-items (relation items acc)
    (if (eq (len items) 0) acc
        (lwbo-conflicts-with-items relation (tail items)
            (if (eq (lwo-relations-conflict? relation (head items)) 1)
                (lwo-field-add acc
                    (lwo-contradiction relation (head items))) acc))))

(defn lwbo-cross-conflicts-items (left right acc)
    (if (eq (len left) 0) acc
        (lwbo-cross-conflicts-items (tail left) right
            (lwbo-conflicts-with-items (head left) right acc))))

(defn lwbo-cross-conflicts (world-a world-b)
    (lwbo-cross-conflicts-items
        (lwo-field-items (lwo-world-relations world-a))
        (lwo-field-items (lwo-world-relations world-b))
        (lwo-empty-field)))

(defn lwbo-routes-items (items acc)
    (if (eq (len items) 0) acc
        (do
            (let conflict (head items))
            (lwbo-routes-items (tail items)
                (lwo-field-add
                    (lwo-field-add acc
                        (nth (node_children conflict) 0))
                    (nth (node_children conflict) 1))))))

; children: exact branches, shared cells, shared relations, shared active
;           attributions, cross-branch conflicts, derived routes, local path
(defn lwbo-overlap (branch-a branch-b)
    (do
        (let world-a (lwcb-branch-world branch-a))
        (let world-b (lwcb-branch-world branch-b))
        (let conflicts (lwbo-cross-conflicts world-a world-b))
        (intern_node LWBO-OVERLAP
            (list branch-a branch-b
                  (lwbo-intersection
                    (lwo-world-cells world-a)
                    (lwo-world-cells world-b))
                  (lwbo-intersection
                    (lwo-world-relations world-a)
                    (lwo-world-relations world-b))
                  (lwbo-intersection
                    (lwo-world-attributions world-a)
                    (lwo-world-attributions world-b))
                  conflicts
                  (lwbo-routes-items
                    (lwo-field-items conflicts) (lwo-empty-field))
                  (lwo-local-path)))))

(defn lwbo-overlap? (cell) (lwo-category? cell LWBO-OVERLAP))
(defn lwbo-overlap-branch-a (overlap) (nth (node_children overlap) 0))
(defn lwbo-overlap-branch-b (overlap) (nth (node_children overlap) 1))
(defn lwbo-overlap-cells (overlap) (nth (node_children overlap) 2))
(defn lwbo-overlap-relations (overlap) (nth (node_children overlap) 3))
(defn lwbo-overlap-attributions (overlap) (nth (node_children overlap) 4))
(defn lwbo-overlap-conflicts (overlap) (nth (node_children overlap) 5))
(defn lwbo-overlap-routes (overlap) (nth (node_children overlap) 6))
(defn lwbo-overlap-path (overlap) (nth (node_children overlap) 7))

(defn lwbo-overlap-valid? (overlap)
    (if (eq (lwbo-overlap? overlap) 0) 0
        (do
            (let branch-a (lwbo-overlap-branch-a overlap))
            (let branch-b (lwbo-overlap-branch-b overlap))
            (if (and
                    (eq (lwcb-branch-valid? branch-a) 1)
                    (and
                        (eq (lwcb-branch-valid? branch-b) 1)
                        (and
                            (not (node_eq branch-a branch-b))
                            (and
                                (node_eq
                                    (lwcb-branch-image branch-a)
                                    (lwcb-branch-image branch-b))
                                (and
                                    (gt (lwo-field-size
                                        (lwbo-overlap-cells overlap)) 0)
                                    (node_eq overlap
                                        (lwbo-overlap branch-a branch-b)))))))
                1 0))))

; children: exact overlap, optional declaration, optional lens, additional
;           alternatives, optional unknowable remainder, local path.
; The two derived routes live in the overlap.  There is intentionally no
; selected-route child.
(defn lwbo-contention
    (overlap declaration lens alternatives unknowable)
    (intern_node LWBO-CONTENTION
        (list overlap declaration lens alternatives unknowable
              (lwo-local-path))))

(defn lwbo-contention? (cell) (lwo-category? cell LWBO-CONTENTION))
(defn lwbo-contention-overlap (contention) (nth (node_children contention) 0))
(defn lwbo-contention-declaration (contention) (nth (node_children contention) 1))
(defn lwbo-contention-lens (contention) (nth (node_children contention) 2))
(defn lwbo-contention-alternatives (contention) (nth (node_children contention) 3))
(defn lwbo-contention-unknowable (contention) (nth (node_children contention) 4))
(defn lwbo-contention-path (contention) (nth (node_children contention) 5))

(defn lwbo-contention-for
    (branch-a branch-b declaration lens alternatives unknowable)
    (do
        (let overlap (lwbo-overlap branch-a branch-b))
        (if (or (eq (lwbo-overlap-valid? overlap) 0)
                (eq (lwo-field-size
                        (lwbo-overlap-conflicts overlap)) 0))
            (lwo-none)
            (lwbo-contention overlap declaration lens alternatives
                unknowable))))

(defn lwbo-contention-valid? (contention)
    (if (eq (lwbo-contention? contention) 0) 0
        (do
            (let overlap (lwbo-contention-overlap contention))
            (if (and (eq (lwbo-overlap-valid? overlap) 1)
                     (and (gt (lwo-field-size
                                (lwbo-overlap-conflicts overlap)) 0)
                          (node_eq contention
                            (lwbo-contention overlap
                                (lwbo-contention-declaration contention)
                                (lwbo-contention-lens contention)
                                (lwbo-contention-alternatives contention)
                                (lwbo-contention-unknowable contention)))))
                1 0))))

; children: exact restored candidate, exact branch, active candidate
;           attributions, participants, optional declaration, optional lens,
;           alternatives, optional unknowable remainder, observed world root
(defn lwbo-compost-plan
    (world candidate declaration lens alternatives unknowable)
    (do
        (let restore (lwo-emergent-shape candidate))
        (let attributions (lwo-active-attributions-for world candidate))
        (let participants
            (lwt-sources-from-attributions
                (lwo-field-items attributions) (lwo-empty-field)))
        (intern_node LWBO-COMPOST-PLAN
            (list candidate (lwcb-restore-branch restore)
                  attributions participants declaration lens alternatives
                  unknowable world))))

(defn lwbo-compost-plan? (cell)
    (lwo-category? cell LWBO-COMPOST-PLAN))
(defn lwbo-compost-candidate (plan) (nth (node_children plan) 0))
(defn lwbo-compost-branch (plan) (nth (node_children plan) 1))
(defn lwbo-compost-attributions (plan) (nth (node_children plan) 2))
(defn lwbo-compost-participants (plan) (nth (node_children plan) 3))
(defn lwbo-compost-declaration (plan) (nth (node_children plan) 4))
(defn lwbo-compost-lens (plan) (nth (node_children plan) 5))
(defn lwbo-compost-alternatives (plan) (nth (node_children plan) 6))
(defn lwbo-compost-unknowable (plan) (nth (node_children plan) 7))
(defn lwbo-compost-world (plan) (nth (node_children plan) 8))

(defn lwbo-compost-proposal
    (world candidate declaration lens alternatives unknowable)
    (if (eq (lwcb-restored? world candidate) 0) (lwo-none)
        (do
            (let plan
                (lwbo-compost-plan world candidate declaration lens
                    alternatives unknowable))
            (if (or (eq (lwo-field-size
                            (lwbo-compost-attributions plan)) 0)
                    (eq (lwo-field-size
                            (lwbo-compost-participants plan)) 0))
                (lwo-none)
                (lwt-proposal plan
                    (lwbo-compost-participants plan) plan)))))

; Response offers extend the world but do not change candidate attributions.
; Exact current attribution identity is therefore the freshness boundary.
(defn lwbo-compost-current? (world proposal plan)
    (if (and
            (eq (lwt-proposal? proposal) 1)
            (and
                (eq (lwbo-compost-plan? plan) 1)
                (and
                    (node_eq plan (lwt-proposal-candidate proposal))
                    (and
                        (eq (lwcb-restored? world
                                (lwbo-compost-candidate plan)) 1)
                        (and
                            (node_eq
                                (lwo-active-attributions-for world
                                    (lwbo-compost-candidate plan))
                                (lwbo-compost-attributions plan))
                            (node_eq
                                (lwt-proposal-participants proposal)
                                (lwbo-compost-participants plan)))))))
        1 0))

(defn lwbo-add-candidate-revocations (items plan outcome acc)
    (if (eq (len items) 0) acc
        (do
            (let attribution (head items))
            (lwbo-add-candidate-revocations (tail items) plan outcome
                (lwo-field-add acc
                    (lwo-revocation
                        (lwo-attribution-payload attribution)
                        (lwo-attribution-source attribution)
                        plan outcome))))))

(defn lwbo-release-candidate-world (world plan outcome)
    (lwo-world
        (lwo-world-cells world)
        (lwo-world-relations world)
        (lwo-world-attributions world)
        (lwbo-add-candidate-revocations
            (lwo-field-items (lwbo-compost-attributions plan))
            plan outcome (lwo-world-revocations world))
        (lwo-world-events world)))

; children: exact plan, prior world, successor world, unanimous outcome
(defn lwbo-compost-receipt (plan prior successor outcome)
    (intern_node LWBO-COMPOST-RECEIPT
        (list plan prior successor outcome)))
(defn lwbo-compost-receipt? (cell)
    (lwo-category? cell LWBO-COMPOST-RECEIPT))
(defn lwbo-receipt-plan (receipt) (nth (node_children receipt) 0))
(defn lwbo-receipt-prior-world (receipt) (nth (node_children receipt) 1))
(defn lwbo-receipt-successor-world (receipt) (nth (node_children receipt) 2))
(defn lwbo-receipt-outcome (receipt) (nth (node_children receipt) 3))

(defn lwbo-integrate-compost (world proposal)
    (if (or (eq (lwt-proposal? proposal) 0)
            (eq (lwbo-compost-plan?
                    (lwt-proposal-candidate proposal)) 0))
        (lwo-transition world (oac-zero))
        (do
            (let plan (lwt-proposal-candidate proposal))
            (let outcome (lwt-evaluate-proposal world proposal))
            (if (or
                    (not (node_eq (lwt-outcome-status outcome)
                                  (lwt-status-acknowledged)))
                    (eq (lwbo-compost-current? world proposal plan) 0))
                (lwo-transition world (oac-zero))
                (do
                    (let successor
                        (lwbo-release-candidate-world world plan outcome))
                    (lwo-transition successor
                        (oac-node
                            (lwbo-compost-receipt
                                plan world successor outcome))))))))
