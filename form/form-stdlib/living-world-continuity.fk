; living-world-continuity.fk -- storage remembers; holders re-authorize life.
;
; A living world may be wrapped in a content-addressed continuity image. The
; manifest repeats every world component and exact field count so structural
; drift is observable. The image is an ordinary Recipe suitable for exact
; persistence once the active runtime exposes that carrier at this seam.
;
; A loaded image is inert evidence. It becomes a restore proposal only after a
; custodian offers that exact image through an ordinary living-world membrane.
; Every source with an active attribution in the snapshot participates; empty
; authority fields are refused. Their fresh unanimous responses are evaluated
; in the admission world. Only then does restoration return a successor of the
; exact stored snapshot carrying a new activation candidate attributed to each
; holder. The response derivations remain reachable through the activation
; outcome. Revoking the offered image before integration refuses restoration.
;
; This is protocol authority, not adversarial identity security. Source cells
; are not cryptographically authenticated by the present kernel. The layer
; proves exact Recipe re-derivation and consent-bound activation. The present
; fkwu source seed does not expose read_form_binary/write_form_binary, so a
; cross-process file roundtrip is deliberately not claimed here. Signatures,
; durable/atomic replacement, concurrent writers, and hostile-file admission
; remain outside its claim.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk

(let LWCN-MANIFEST (bp "LWCN-MANIFEST"))
(let LWCN-IMAGE    (bp "LWCN-IMAGE"))
(let LWCN-RESTORE  (bp "LWCN-RESTORE"))
(let LWCN-ORIGIN   (bp "LWCN-ORIGIN"))

; children: the five exact world fields followed by their exact sizes
(defn lwcn-manifest (world)
    (intern_node LWCN-MANIFEST
        (list (lwo-world-cells world)
              (lwo-world-relations world)
              (lwo-world-attributions world)
              (lwo-world-revocations world)
              (lwo-world-events world)
              (intern_trivial_int
                (lwo-field-size (lwo-world-cells world)))
              (intern_trivial_int
                (lwo-field-size (lwo-world-relations world)))
              (intern_trivial_int
                (lwo-field-size (lwo-world-attributions world)))
              (intern_trivial_int
                (lwo-field-size (lwo-world-revocations world)))
              (intern_trivial_int
                (lwo-field-size (lwo-world-events world))))))

(defn lwcn-manifest? (cell) (lwo-category? cell LWCN-MANIFEST))

; children: exact snapshot, redundant manifest, local path
(defn lwcn-image (world)
    (intern_node LWCN-IMAGE
        (list world (lwcn-manifest world) (lwo-local-path))))
(defn lwcn-image? (cell) (lwo-category? cell LWCN-IMAGE))
(defn lwcn-image-world (image) (nth (node_children image) 0))
(defn lwcn-image-manifest (image) (nth (node_children image) 1))
(defn lwcn-image-path (image) (nth (node_children image) 2))

(defn lwcn-image-valid? (image)
    (if (eq (lwcn-image? image) 0) 0
        (do
            (let world (lwcn-image-world image))
            (if (and (eq (lwo-category? world LWO-WORLD) 1)
                     (and (eq (lwcn-manifest?
                                (lwcn-image-manifest image)) 1)
                          (and (node_eq
                                (lwcn-image-manifest image)
                                (lwcn-manifest world))
                               (node_eq
                                (lwcn-image-path image)
                                (lwo-local-path))))) 1 0))))

(defn lwcn-active-sources-items (world items acc)
    (if (eq (len items) 0) acc
        (do
            (let attribution (head items))
            (lwcn-active-sources-items world (tail items)
                (if (eq (lwo-active-attribution?
                            world attribution) 1)
                    (lwo-field-add acc
                        (lwo-attribution-source attribution)) acc)))))

(defn lwcn-active-sources (world)
    (lwcn-active-sources-items world
        (lwo-field-items (lwo-world-attributions world))
        (lwo-empty-field)))

; children: image, exact snapshot, manifest, original active sources,
;           image-offer attributions, local path
(defn lwcn-restore (admission-world image)
    (do
        (let snapshot (lwcn-image-world image))
        (intern_node LWCN-RESTORE
            (list image snapshot (lwcn-image-manifest image)
                  (lwcn-active-sources snapshot)
                  (lwo-active-attributions-for admission-world image)
                  (lwo-local-path)))))
(defn lwcn-restore? (cell) (lwo-category? cell LWCN-RESTORE))
(defn lwcn-restore-image (restore) (nth (node_children restore) 0))
(defn lwcn-restore-world (restore) (nth (node_children restore) 1))
(defn lwcn-restore-manifest (restore) (nth (node_children restore) 2))
(defn lwcn-restore-sources (restore) (nth (node_children restore) 3))
(defn lwcn-restore-image-attributions (restore)
    (nth (node_children restore) 4))
(defn lwcn-restore-path (restore) (nth (node_children restore) 5))

(defn lwcn-origin (restore witnesses)
    (intern_node LWCN-ORIGIN (list restore witnesses)))

(defn lwcn-restore-proposal (admission-world image)
    (if (or (eq (lwcn-image-valid? image) 0)
            (eq (lwo-active? admission-world image) 0)) (lwo-none)
        (do
            (let restore (lwcn-restore admission-world image))
            (let sources (lwcn-restore-sources restore))
            (let witnesses (lwcn-restore-image-attributions restore))
            (if (or (eq (lwo-field-size sources) 0)
                    (eq (lwo-field-size witnesses) 0)) (lwo-none)
                (do
                    (let origin (lwcn-origin restore witnesses))
                    (let candidate
                        (lwo-emergent restore witnesses
                            (intern_trivial_int
                                (lwo-field-size sources))
                            (intern_trivial_int
                                (lwo-field-size
                                    (lwo-world-cells
                                        (lwcn-restore-world restore))))
                            (intern_trivial_int
                                (lwo-field-size witnesses)) origin))
                    (lwt-proposal candidate sources origin))))))

(defn lwcn-restore-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwcn-restore?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwcn-restore-current? (admission-world candidate)
    (if (eq (lwcn-restore-candidate? candidate) 0) 0
        (do
            (let restore (lwo-emergent-shape candidate))
            (let fresh
                (lwcn-restore-proposal admission-world
                    (lwcn-restore-image restore)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))

; Successful integration deliberately starts from the exact stored snapshot,
; not the admission world. The activation candidate and outcome are added as
; new reachable tissue; admission responses do not become arbitrary model data.
(defn lwcn-integrate-restore (round proposal action)
    (do
        (let admission-world (lwt-round-world round))
        (let candidate (lwt-proposal-candidate proposal))
        (let outcome (lwt-evaluate-proposal admission-world proposal))
        (if (and (eq (lwcn-restore-current?
                          admission-world candidate) 1)
                 (and (node_eq (lwt-outcome-status outcome)
                               (lwt-status-acknowledged))
                      (eq (lwo-emergent-ready?
                            admission-world candidate) 1)))
            (do
                (let restore (lwo-emergent-shape candidate))
                (let restored
                    (lwt-integrate-sources
                        (lwcn-restore-world restore)
                        (lwo-field-items
                            (lwt-proposal-participants proposal))
                        candidate action outcome))
                (lwt-round restored (lwt-round-proposals round)
                    (lwo-field-add (lwo-empty-field) outcome) round))
            (lwt-round admission-world (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field) outcome) round))))

(defn lwcn-restored? (world candidate)
    (if (and (eq (lwcn-restore-candidate? candidate) 1)
             (eq (lwo-active? world candidate) 1)) 1 0))
