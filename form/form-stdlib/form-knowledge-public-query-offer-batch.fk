; form-knowledge-public-query-offer-batch.fk -- answer-free public offers.
;
; One current public question in each canonical family becomes a source-bound
; scannerless query offer.  The offer contains the public question, its source
; identity and one question-derived discriminative anchor.  It contains no
; expected answer or answer hash.  Its two projections stay explicit:
;
;   canonical-heldout  -- unchanged public question, no offered query, eligible
;                         only for the existing heldout evaluator;
;   supervised-rag     -- exact query is offered, never heldout credit.
;
; The pure result retains raw local output so every digest is recomputable.
; Its public summary may omit those bytes, but the Form value does not turn
; into a log.  Missing rows return exact nothing; a present invalid or
; incomplete physical set returns ready=0.  Present answers "0" and "1" keep
; their own bits and never alias nothing.
;
; This cell opens no model or carrier.  The dormant one-residence driver is
; observe/qwen38-public-query-offer-batch-live-run.fk.
; Category 31.2.0.126 keeps this canonical-family batch distinct from the
; single-query offer and reversible-memory NodeID families.
;
; preludes: form-stdlib/form-knowledge-public-resident-eval.fk
; preludes: form-stdlib/form-knowledge-axioms-public-curriculum.fk
; preludes: form-stdlib/form-cli-heedmark-xtal.fk
; Proven by: form-stdlib/tests/form-knowledge-public-query-offer-batch-band.fk

(do
    (defn fkpqo-schema () "public-family-answer-free-query-offer-v1")
    (defn fkpqo-projection-schema () "public-family-query-projection-v1")
    (defn fkpqo-observation-schema () "public-family-supervised-rag-observation-v1")
    (defn fkpqo-result-schema () "public-family-supervised-rag-batch-result-v1")
    (defn fkpqo-family-total () (len (fkpfm-family-ids)))

    ; Every anchor is copied byte-for-byte from its independent public
    ; question.  It narrows source retrieval but does not carry the answer.
    (defn fkpqo-anchor (family)
        (if (str_eq family "axioms") "resting point"
        (if (str_eq family "bootstrap") "fib(10)"
        (if (str_eq family "form-stdlib") "ASCII transformations"
        (if (str_eq family "grammars") "duplicate names"
        (if (str_eq family "cognition") "passage's spectrum"
        (if (str_eq family "learn") "probe kinds"
        (if (str_eq family "observe") "equal quality score"
        (if (str_eq family "teachings") "success measured"
        (if (str_eq family "receipts") "no rollout or evidence row"
        (if (str_eq family "model") "memory covenant"
        (if (str_eq family "proof") "all four walkers agree"
        (if (str_eq family "control") "zero answered offers"
        (if (str_eq family "ingest") "named gap"
        (if (str_eq family "presence") "seven inquiry planes"
        (if (str_eq family "docs") "stale framebuffer response"
            (nothing)))))))))))))))))

    (defn fkpqo-query (anchor)
        (str_concat (fkqt-open) (str_concat anchor (fkqt-close))))

    ; offer = schema node node-key family row-id concept path source-sha
    ;         source-id question question-sha challenge-sha anchor query
    ;         model-executed answer-present
    (defn fkpqo-offer (row)
        (if (not (eq (fkhe-row? row) 1)) (nothing)
            (do
                (let family (fkhe-family row))
                (let anchor (fkpqo-anchor family))
                (let path (fkhe-source row))
                (let question (fkhe-prompt row))
                (if (or (nothing? anchor)
                    (or (eq (fkpfm-family? family) 0)
                    (or (le (file_size path) 0)
                    (or (eq (str_len anchor) 0)
                    (or (gt (str_len anchor) (fkss-max-query-atom))
                        (lt (str_find question anchor 0) 0)))))) (nothing)
                    (do
                        (let source-id (fkss-source-id path))
                        (let expected-source-id
                            (str_concat "sha256:" (fkhe-source-sha row)))
                        (if (not (str_eq source-id expected-source-id))
                            (nothing)
                            (do
                                (let question-sha (nmfe-sha256 question))
                                (let challenge-sha
                                    (fkpfm-family-challenge-sha family))
                                (let query (fkpqo-query anchor))
                                (let offer-key (nmfe-sha256 (nmfe-fields
                                    (list (fkpqo-schema) family (fkhe-id row)
                                          source-id question-sha challenge-sha
                                          query))))
                                (let node (intern_node
                                    (make_nodeid 31 2 0 126)
                                    (list
                                        (intern_trivial_string (fkpqo-schema))
                                        (intern_trivial_string family)
                                        (intern_trivial_string (fkhe-id row))
                                        (intern_trivial_string source-id)
                                        (intern_trivial_string question-sha)
                                        (intern_trivial_string challenge-sha)
                                        (intern_trivial_string query))))
                                (list (fkpqo-schema) node offer-key
                                      family (fkhe-id row) (fkhe-concept row)
                                      path (fkhe-source-sha row) source-id
                                      question question-sha challenge-sha
                                      anchor query 0 0))))))))

    (defn fkpqo-offer-node (o) (nth o 1))
    (defn fkpqo-offer-key (o) (nth o 2))
    (defn fkpqo-offer-family (o) (nth o 3))
    (defn fkpqo-offer-row-id (o) (nth o 4))
    (defn fkpqo-offer-concept (o) (nth o 5))
    (defn fkpqo-offer-path (o) (nth o 6))
    (defn fkpqo-offer-source-sha (o) (nth o 7))
    (defn fkpqo-offer-source-id (o) (nth o 8))
    (defn fkpqo-offer-question (o) (nth o 9))
    (defn fkpqo-offer-question-sha (o) (nth o 10))
    (defn fkpqo-offer-challenge-sha (o) (nth o 11))
    (defn fkpqo-offer-anchor (o) (nth o 12))
    (defn fkpqo-offer-query (o) (nth o 13))
    (defn fkpqo-offer-model-executed (o) (nth o 14))
    (defn fkpqo-offer-answer-present (o) (nth o 15))

    (defn fkpqo-offer-valid? (offer)
        (if (or (nothing? offer)
                (or (not (eq (fkpfm-list? offer) 1))
                    (not (eq (len offer) 16)))) 0
            (do
                (let row (fkhe-find-row (fkpqo-offer-row-id offer)
                                        (fkhe-rows)))
                (if (eq (len row) 0) 0
                    (do
                        (let rebuilt (fkpqo-offer row))
                        (if (nothing? rebuilt) 0
                            (if (and
                                (eq (fkpfm-equal? offer rebuilt) 1)
                                (and (eq (fkpqo-offer-model-executed offer) 0)
                                     (eq (fkpqo-offer-answer-present offer) 0)))
                                1 0)))))))

    (defn fkpqo-offers-loop (rows)
        (if (eq (len rows) 0) (list)
            (cons (fkpqo-offer (head rows))
                  (fkpqo-offers-loop (tail rows)))))
    (defn fkpqo-offers () (fkpqo-offers-loop (fkhe-rows)))
    (defn fkpqo-offer-for-family (family offers)
        (if (eq (len offers) 0) (nothing)
            (if (and (not (nothing? (head offers)))
                     (str_eq family (fkpqo-offer-family (head offers))))
                (head offers)
                (fkpqo-offer-for-family family (tail offers)))))
    (defn fkpqo-all-offers-valid? (offers)
        (if (eq (len offers) 0) 1
            (if (eq (fkpqo-offer-valid? (head offers)) 1)
                (fkpqo-all-offers-valid? (tail offers)) 0)))

    (defn fkpqo-rehearsal-prompt (offer)
        (if (eq (fkpqo-offer-valid? offer) 0) (nothing)
            (str_concat
                "Public source-bound, answer-task-disjoint RAG rehearsal. Your first generated bytes must be exactly this query token, byte for byte, with no leading prose: "
                (str_concat (fkpqo-offer-query offer)
                    (str_concat
                        " After Form injects the typed source observation, answer only the independent question in its requested shape. Question: "
                        (fkpqo-offer-question offer))))))

    ; projection = schema lane family row-id concept path source-sha question
    ;              prompt prompt-sha challenge-sha offer-key query
    ;              query-offered heldout-credit supervised-rag-credit
    ;              answer-in-offer
    (defn fkpqo-projection (offer lane)
        (if (or (eq (fkpqo-offer-valid? offer) 0)
                (not (or (str_eq lane "canonical-heldout")
                         (str_eq lane "supervised-rag")))) (nothing)
            (do
                (let supervised (if (str_eq lane "supervised-rag") 1 0))
                (let prompt (if (eq supervised 1)
                    (fkpqo-rehearsal-prompt offer)
                    (fkpqo-offer-question offer)))
                (list (fkpqo-projection-schema) lane
                      (fkpqo-offer-family offer)
                      (fkpqo-offer-row-id offer)
                      (fkpqo-offer-concept offer)
                      (fkpqo-offer-path offer)
                      (fkpqo-offer-source-sha offer)
                      (fkpqo-offer-question offer) prompt
                      (nmfe-sha256 prompt)
                      (fkpqo-offer-challenge-sha offer)
                      (fkpqo-offer-key offer)
                      (if (eq supervised 1) (fkpqo-offer-query offer) "")
                      supervised (if (eq supervised 1) 0 1) supervised 0))))

    (defn fkpqo-projection-lane (p) (nth p 1))
    (defn fkpqo-projection-family (p) (nth p 2))
    (defn fkpqo-projection-row-id (p) (nth p 3))
    (defn fkpqo-projection-prompt (p) (nth p 8))
    (defn fkpqo-projection-query-offered (p) (nth p 13))
    (defn fkpqo-projection-heldout-credit (p) (nth p 14))
    (defn fkpqo-projection-supervised-credit (p) (nth p 15))
    (defn fkpqo-projection-answer-present (p) (nth p 16))
    (defn fkpqo-projection-valid? (projection)
        (if (or (nothing? projection)
                (or (not (eq (fkpfm-list? projection) 1))
                    (not (eq (len projection) 17)))) 0
            (do
                (let row (fkpfm-heldout-row-for-family
                    (fkpqo-projection-family projection) (fkhe-rows)))
                (let offer (if (nothing? row) (nothing) (fkpqo-offer row)))
                (if (nothing? offer) 0
                    (do
                        (let rebuilt (fkpqo-projection offer
                            (fkpqo-projection-lane projection)))
                        (if (nothing? rebuilt) 0
                            (fkpfm-equal? projection rebuilt)))))))

    (defn fkpqo-projections-for (offer)
        (list (fkpqo-projection offer "canonical-heldout")
              (fkpqo-projection offer "supervised-rag")))
    (defn fkpqo-projections-loop (offers)
        (if (eq (len offers) 0) (list)
            (append (fkpqo-projections-for (head offers))
                    (fkpqo-projections-loop (tail offers)))))
    (defn fkpqo-projections () (fkpqo-projections-loop (fkpqo-offers)))
    (defn fkpqo-supervised-projections-loop (offers)
        (if (eq (len offers) 0) (list)
            (cons (fkpqo-projection (head offers) "supervised-rag")
                  (fkpqo-supervised-projections-loop (tail offers)))))
    (defn fkpqo-supervised-projections ()
        (fkpqo-supervised-projections-loop (fkpqo-offers)))

    (defn fkpqo-plan-sha-loop (offers acc)
        (if (eq (len offers) 0) acc
            (do
                (let offer (head offers))
                (fkpqo-plan-sha-loop (tail offers)
                    (nmfe-sha256 (nmfe-fields
                        (list "public-family-query-offer-plan-step-v1" acc
                              (fkpqo-offer-family offer)
                              (fkpqo-offer-row-id offer)
                              (fkpqo-offer-key offer)
                              (fkpqo-offer-source-sha offer)
                              (fkpqo-offer-question-sha offer)
                              (fkpqo-offer-challenge-sha offer)
                              (nmfe-sha256 (fkpqo-offer-query offer)))))))))
    (defn fkpqo-plan-sha ()
        (fkpqo-plan-sha-loop (fkpqo-offers)
            (nmfe-sha256 "public-family-query-offer-plan-root-v1")))

    ; The physical driver derives exact context needs before model open and
    ; sorts descending so the first admitted context can hold every later row.
    (defn fkpqo-scheduled (offer need)
        (list "public-family-query-offer-scheduled-v1" offer need))
    (defn fkpqo-scheduled-offer (s) (nth s 1))
    (defn fkpqo-scheduled-need (s) (nth s 2))
    (defn fkpqo-schedule-insert (item sorted)
        (if (eq (len sorted) 0) (list item)
            (if (ge (fkpqo-scheduled-need item)
                    (fkpqo-scheduled-need (head sorted)))
                (cons item sorted)
                (cons (head sorted)
                    (fkpqo-schedule-insert item (tail sorted))))))
    (defn fkpqo-schedule-sort (items sorted)
        (if (eq (len items) 0) sorted
            (fkpqo-schedule-sort (tail items)
                (fkpqo-schedule-insert (head items) sorted))))

    (defn fkpqo-report-field (raw name)
        (do
            (let marker (str_concat "\n" (str_concat name "=")))
            (let at (str_find raw marker 0))
            (if (lt at 0) ""
                (do
                    (let start (add at (str_len marker)))
                    (let end (str_find raw "\n" start))
                    (substring raw start
                        (if (lt end 0) (str_len raw) end))))))
    (defn fkpqo-report-int (raw name)
        (do
            (let value (fkpqo-report-field raw name))
            (if (or (eq (str_len value) 0) (gt (str_len value) 20)) -1
                (str_to_int value))))
    (defn fkpqo-state-released (raw)
        (if (eq (fkpqo-report-int raw "state_released") 1) 1 0))

    (defn fkpqo-query-once? (generated query)
        (do
            (let at (str_find generated query 0))
            (if (lt at 0) 0
                (if (lt (str_find generated query
                            (add at (str_len query))) 0) 1 0))))
    (defn fkpqo-generated-frame (generated)
        (do
            (let open-at (str_find generated (fkqt-open) 0))
            (if (lt open-at 0) ""
                (do
                    (let close-at (str_find generated (fkqt-close)
                        (add open-at (str_len (fkqt-open)))))
                    (if (lt close-at 0) ""
                        (substring generated open-at
                            (add close-at (str_len (fkqt-close)))))))))

    ; A generated reply may recursively ask for one refined observation, but
    ; the verifier never performs an unbounded text walk.  Once MaxHeeds valid
    ; frames have been seen, one more open marker is enough to reject.  A stray
    ; close, nested open, incomplete close, or parser-invalid frame is distinct
    ; evidence that the transport did not complete.
    ; scan = valid complete-frame-count
    (defn fkpqo-frame-scan (valid count) (list valid count))
    (defn fkpqo-frame-scan-valid (scan) (nth scan 0))
    (defn fkpqo-frame-scan-count (scan) (nth scan 1))
    (defn fkpqo-generated-frames-from (generated at count)
        (do
            (let open-at (str_find generated (fkqt-open) at))
            (let close-at (str_find generated (fkqt-close) at))
            (if (lt open-at 0)
                (if (lt close-at 0)
                    (fkpqo-frame-scan 1 count)
                    (fkpqo-frame-scan 0 count))
                (if (or (ge count (MaxHeeds))
                        (and (ge close-at 0) (lt close-at open-at)))
                    (fkpqo-frame-scan 0 count)
                    (do
                        (let body-at (add open-at (str_len (fkqt-open))))
                        (let frame-close (str_find generated (fkqt-close) body-at))
                        (let nested-open (str_find generated (fkqt-open) body-at))
                        (if (or (lt frame-close 0)
                                (and (ge nested-open 0)
                                     (lt nested-open frame-close)))
                            (fkpqo-frame-scan 0 count)
                            (do
                                (let end (add frame-close
                                    (str_len (fkqt-close))))
                                (let frame (substring generated open-at end))
                                (let request (fkqt-parse frame))
                                (if (eq (fkqt-request-ready? request) 0)
                                    (fkpqo-frame-scan 0 count)
                                    (fkpqo-generated-frames-from generated end
                                        (add count 1))))))))))
    (defn fkpqo-generated-frames (generated)
        (fkpqo-generated-frames-from generated 0 0))
    (defn fkpqo-frame-count-ready? (scan)
        (if (and (eq (fkpqo-frame-scan-valid scan) 1)
                 (and (ge (fkpqo-frame-scan-count scan) 1)
                      (le (fkpqo-frame-scan-count scan) (MaxHeeds)))) 1 0))

    (defn fkpqo-transport-counts-ready? (raw frame-count)
        (if (and (eq (fkpqo-report-int raw "heed_lookups") frame-count)
            (and (eq (fkpqo-report-int raw "heed_source_searches") frame-count)
            (and (eq (fkpqo-report-int raw "heed_honored") frame-count)
            (and (eq (fkpqo-report-int raw "heed_hits") frame-count)
                 (eq (fkpqo-report-int raw "heed_close_commits")
                     frame-count))))) 1 0))
    (defn fkpqo-transport-failures-zero? (raw)
        (if (and (eq (fkpqo-report-int raw "heed_misses") 0)
            (and (eq (fkpqo-report-int raw "heed_nothings") 0)
            (and (eq (fkpqo-report-int raw "heed_spent") 0)
            (and (eq (fkpqo-report-int raw "heed_injection_refusals") 0)
            (and (eq (fkpqo-report-int raw "heed_decode_timeout") 0)
                 (eq (fkpqo-report-int raw "heed_frame_refusals") 0)))))) 1 0))
    (defn fkpqo-transport-source-bound? (offer raw frame-count)
        (if (and (eq (fkpqo-report-int raw "heed_bound_source_matches")
                     frame-count)
            (and (eq (fkpqo-report-int raw "heed_bound_source_mismatches") 0)
            (and (str_eq (fkpqo-report-field raw "heed_source_path")
                         (fkpqo-offer-path offer))
                 (str_eq (fkpqo-report-field raw "heed_source_artifact")
                         (fkpqo-offer-source-id offer))))) 1 0))

    ; Transport success and answer quality are intentionally independent.
    ; The lookup's `model-executed=0` is not the Qwen generation flag.
    (defn fkpqo-transport-ready? (offer raw same-residence)
        (do
            (let parsed (fkhe-parse-resident-output raw))
            (let generated (fkhe-output-generated parsed))
            (let query (fkpqo-offer-query offer))
            (let frames (fkpqo-generated-frames generated))
            (let frame-count (fkpqo-frame-scan-count frames))
            (let doors-ready (if (and
                (eq (fkpqo-offer-valid? offer) 1)
                (and (str_eq (fkpqo-report-field raw "prompt_cursor")
                             "bmf-qtf2-live-v1")
                     (str_eq (fkpqo-report-field raw "heed_cursor")
                             "bounded-current-source-v1"))) 1 0))
            (let frames-ready (if (and
                (str_eq (fkpqo-generated-frame generated) query)
                (and (eq (str_find generated query 0) 0)
                (and (eq (fkpqo-query-once? generated query) 1)
                     (eq (fkpqo-frame-count-ready? frames) 1)))) 1 0))
            (let counts-ready (if (and
                (eq (fkpqo-transport-counts-ready? raw frame-count) 1)
                (and (eq (fkpqo-transport-failures-zero? raw) 1)
                     (eq (fkpqo-transport-source-bound?
                            offer raw frame-count) 1))) 1 0))
            (let evidence-ready (if (and
                (gt (fkpqo-report-int raw "heed_injected_tokens") 0)
                (and (str_eq (fkpqo-report-field raw "heed_evidence_status")
                             "hit")
                (and (str_eq (fkpqo-report-field raw "heed_evidence_reason")
                             "current-source-context-path-hit")
                     (eq (nmfe-sha256?
                            (fkpqo-report-field raw "heed_answer_key")) 1)))) 1 0))
            (let execution-ready (if (and
                (eq (fkpqo-report-int raw "heed_model_executed") 0)
                (and (eq (fkpqo-state-released raw) 1)
                (and (eq same-residence 1)
                (and (gt (fkpqo-report-int raw "heed_query_tokens") 0)
                (and (gt (fkpqo-report-int raw "heed_answer_tokens") 0)
                (and (gt (fkpqo-report-int raw "generated_tokens") 0)
                     (gt (fkpqo-report-int raw "forward_passes") 0))))))) 1 0))
            (if (and (eq doors-ready 1)
                (and (eq frames-ready 1)
                (and (eq counts-ready 1)
                (and (eq evidence-ready 1)
                     (eq execution-ready 1))))) 1 0)))

    (defn fkpqo-family-nonce
        (offer plan-sha run-id model-id residence-id)
        (nmfe-sha256 (nmfe-fields
            (list "public-family-supervised-rag-nonce-v1" plan-sha run-id
                  model-id residence-id (fkpqo-offer-family offer)
                  (fkpqo-offer-row-id offer) (fkpqo-offer-key offer)
                  (fkpqo-offer-source-sha offer)
                  (fkpqo-offer-challenge-sha offer)))))
    (defn fkpqo-content-sha (nonce raw)
        (nmfe-sha256 (nmfe-fields
            (list "public-family-supervised-rag-content-v1" nonce raw))))

    ; observation = schema family row-id lane source-sha challenge-sha
    ;   offer-key plan-sha run-id model-id residence-id nonce raw raw-sha
    ;   content-sha actual-query-sha answer-sha answer-key promotion error
    ;   transport answer95 live-cursor state-release same-residence local remote
    ;   generation-model-executed lookup-model-executed heldout-credit
    ;   supervised-rag-credit outcome present zero one latency-ms
    (defn fkpqo-observation
        (offer plan-sha run-id model-id residence-id raw same-residence
         local remote generation-model-executed latency)
        (if (eq (fkpqo-offer-valid? offer) 0) (nothing)
            (do
                ; Seal generated bytes before the scoring row exposes expected.
                (let raw-sha (nmfe-sha256 raw))
                (let nonce (fkpqo-family-nonce offer plan-sha run-id model-id
                                              residence-id))
                (let content-sha (fkpqo-content-sha nonce raw))
                (let parsed (fkhe-parse-resident-output raw))
                (let generated (fkhe-output-generated parsed))
                (let answer (fkhe-output-answer parsed))
                (let row (fkhe-find-row (fkpqo-offer-row-id offer)
                                        (fkhe-rows)))
                (let effective (fqt-bound-source-knowledge-prompt
                    (fkpqo-rehearsal-prompt offer)))
                (let scored (nmfe-observation effective (fkhe-expected row)
                    answer latency (fkhe-output-error parsed)))
                (let error (nmfe-obs-error scored))
                (let present (if (eq error 0) 1 0))
                (let transport (fkpqo-transport-ready? offer raw same-residence))
                (list (fkpqo-observation-schema)
                      (fkpqo-offer-family offer) (fkpqo-offer-row-id offer)
                      "supervised-rag" (fkpqo-offer-source-sha offer)
                      (fkpqo-offer-challenge-sha offer)
                      (fkpqo-offer-key offer) plan-sha run-id model-id
                      residence-id nonce raw raw-sha content-sha
                      (nmfe-sha256 (fkpqo-generated-frame generated))
                      (nmfe-sha256 answer)
                      (fkpqo-report-field raw "heed_answer_key")
                      (nmfe-obs-promotion scored) error transport
                      (if (and (eq error 0)
                               (ge (nmfe-obs-promotion scored) 950000)) 1 0)
                      (if (str_eq (fkpqo-report-field raw "prompt_cursor")
                                  "bmf-qtf2-live-v1") 1 0)
                      (fkpqo-state-released raw) same-residence local remote
                      generation-model-executed
                      (fkpqo-report-int raw "heed_model_executed")
                      0 transport (if (eq present 1) "value" "nothing")
                      present
                      (if (and (eq present 1) (str_eq answer "0")) 1 0)
                      (if (and (eq present 1) (str_eq answer "1")) 1 0)
                      latency))))

    (defn fkpqo-obs-family (o) (nth o 1))
    (defn fkpqo-obs-row-id (o) (nth o 2))
    (defn fkpqo-obs-plan-sha (o) (nth o 7))
    (defn fkpqo-obs-run-id (o) (nth o 8))
    (defn fkpqo-obs-model-id (o) (nth o 9))
    (defn fkpqo-obs-residence-id (o) (nth o 10))
    (defn fkpqo-obs-nonce (o) (nth o 11))
    (defn fkpqo-obs-raw (o) (nth o 12))
    (defn fkpqo-obs-raw-sha (o) (nth o 13))
    (defn fkpqo-obs-content-sha (o) (nth o 14))
    (defn fkpqo-obs-promotion (o) (nth o 18))
    (defn fkpqo-obs-error (o) (nth o 19))
    (defn fkpqo-obs-transport (o) (nth o 20))
    (defn fkpqo-obs-answer95 (o) (nth o 21))
    (defn fkpqo-obs-live-cursor (o) (nth o 22))
    (defn fkpqo-obs-state-release (o) (nth o 23))
    (defn fkpqo-obs-same-residence (o) (nth o 24))
    (defn fkpqo-obs-local (o) (nth o 25))
    (defn fkpqo-obs-remote (o) (nth o 26))
    (defn fkpqo-obs-generation-model-executed (o) (nth o 27))
    (defn fkpqo-obs-lookup-model-executed (o) (nth o 28))
    (defn fkpqo-obs-heldout-credit (o) (nth o 29))
    (defn fkpqo-obs-supervised-credit (o) (nth o 30))
    (defn fkpqo-obs-outcome (o) (nth o 31))
    (defn fkpqo-obs-present (o) (nth o 32))
    (defn fkpqo-obs-zero (o) (nth o 33))
    (defn fkpqo-obs-one (o) (nth o 34))
    (defn fkpqo-obs-latency (o) (nth o 35))

    (defn fkpqo-observation-valid? (observation)
        (if (or (nothing? observation)
                (or (not (eq (fkpfm-list? observation) 1))
                    (not (eq (len observation) 36)))) 0
            (do
                (let row (fkpfm-heldout-row-for-family
                    (fkpqo-obs-family observation) (fkhe-rows)))
                (let offer (if (nothing? row) (nothing) (fkpqo-offer row)))
                (if (nothing? offer) 0
                    (do
                        (let rebuilt (fkpqo-observation offer
                            (fkpqo-obs-plan-sha observation)
                            (fkpqo-obs-run-id observation)
                            (fkpqo-obs-model-id observation)
                            (fkpqo-obs-residence-id observation)
                            (fkpqo-obs-raw observation)
                            (fkpqo-obs-same-residence observation)
                            (fkpqo-obs-local observation)
                            (fkpqo-obs-remote observation)
                            (fkpqo-obs-generation-model-executed observation)
                            (fkpqo-obs-latency observation)))
                        (if (or (nothing? rebuilt)
                            (or (eq (str_len (fkpqo-obs-run-id observation)) 0)
                            (or (eq (str_len (fkpqo-obs-model-id observation)) 0)
                            (or (eq (str_len
                                    (fkpqo-obs-residence-id observation)) 0)
                            (or (not (eq (fkpqo-obs-local observation) 1))
                            (or (not (eq (fkpqo-obs-remote observation) 0))
                            (or (not (eq
                                (fkpqo-obs-generation-model-executed observation) 1))
                            (or (not (eq
                                (fkpqo-obs-lookup-model-executed observation) 0))
                            (or (not (eq (fkpqo-obs-heldout-credit observation) 0))
                                (not (eq (fkpfm-equal? observation rebuilt) 1)))))))))))
                            0 1))))))

    (defn fkpqo-all-observations-valid? (observations)
        (if (eq (len observations) 0) 1
            (if (eq (fkpqo-observation-valid? (head observations)) 1)
                (fkpqo-all-observations-valid? (tail observations)) 0)))
    (defn fkpqo-obs-families (observations)
        (if (eq (len observations) 0) (list)
            (cons (fkpqo-obs-family (head observations))
                  (fkpqo-obs-families (tail observations)))))
    (defn fkpqo-count-family (family observations)
        (if (eq (len observations) 0) 0
            (add (if (str_eq family
                        (fkpqo-obs-family (head observations))) 1 0)
                 (fkpqo-count-family family (tail observations)))))
    (defn fkpqo-every-family-once? (families observations)
        (if (eq (len families) 0) 1
            (if (eq (fkpqo-count-family (head families) observations) 1)
                (fkpqo-every-family-once? (tail families) observations) 0)))
    (defn fkpqo-string-in? (value values)
        (if (eq (len values) 0) 0
            (if (str_eq value (head values)) 1
                (fkpqo-string-in? value (tail values)))))
    (defn fkpqo-unique-strings? (values)
        (if (eq (len values) 0) 1
            (if (eq (fkpqo-string-in? (head values) (tail values)) 0)
                (fkpqo-unique-strings? (tail values)) 0)))
    (defn fkpqo-obs-nonces (observations)
        (if (eq (len observations) 0) (list)
            (cons (fkpqo-obs-nonce (head observations))
                  (fkpqo-obs-nonces (tail observations)))))
    (defn fkpqo-obs-content-shas (observations)
        (if (eq (len observations) 0) (list)
            (cons (fkpqo-obs-content-sha (head observations))
                  (fkpqo-obs-content-shas (tail observations)))))
    (defn fkpqo-obs-raw-shas (observations)
        (if (eq (len observations) 0) (list)
            (cons (fkpqo-obs-raw-sha (head observations))
                  (fkpqo-obs-raw-shas (tail observations)))))
    (defn fkpqo-same-identity? (observations plan run model residence)
        (if (eq (len observations) 0) 1
            (do
                (let o (head observations))
                (if (and (str_eq (fkpqo-obs-plan-sha o) plan)
                    (and (str_eq (fkpqo-obs-run-id o) run)
                    (and (str_eq (fkpqo-obs-model-id o) model)
                         (str_eq (fkpqo-obs-residence-id o) residence))))
                    (fkpqo-same-identity? (tail observations) plan run
                                          model residence) 0))))
    (defn fkpqo-sum-local (observations)
        (if (eq (len observations) 0) 0
            (add (fkpqo-obs-local (head observations))
                 (fkpqo-sum-local (tail observations)))))
    (defn fkpqo-sum-remote (observations)
        (if (eq (len observations) 0) 0
            (add (fkpqo-obs-remote (head observations))
                 (fkpqo-sum-remote (tail observations)))))
    (defn fkpqo-sum-transport (observations)
        (if (eq (len observations) 0) 0
            (add (fkpqo-obs-transport (head observations))
                 (fkpqo-sum-transport (tail observations)))))
    (defn fkpqo-sum-answer95 (observations)
        (if (eq (len observations) 0) 0
            (add (fkpqo-obs-answer95 (head observations))
                 (fkpqo-sum-answer95 (tail observations)))))
    (defn fkpqo-sum-heldout (observations)
        (if (eq (len observations) 0) 0
            (add (fkpqo-obs-heldout-credit (head observations))
                 (fkpqo-sum-heldout (tail observations)))))
    (defn fkpqo-sum-supervised (observations)
        (if (eq (len observations) 0) 0
            (add (fkpqo-obs-supervised-credit (head observations))
                 (fkpqo-sum-supervised (tail observations)))))

    ; result = schema observations family-total valid transport answer95
    ;          heldout-credit supervised-rag-credit local remote opens reopens
    ;          final-release complete ready
    (defn fkpqo-finalize (observations opens reopens final-release)
        (if (lt (len observations) (fkpqo-family-total)) (nothing)
            (do
                (let first (head observations))
                (let structural (if (and
                    (eq (len observations) (fkpqo-family-total))
                    (and (eq (fkpqo-all-observations-valid? observations) 1)
                    (and (eq (fkpqo-every-family-once?
                                (fkpfm-family-ids) observations) 1)
                    (and (eq (fkpqo-same-identity? observations
                                (fkpqo-obs-plan-sha first)
                                (fkpqo-obs-run-id first)
                                (fkpqo-obs-model-id first)
                                (fkpqo-obs-residence-id first)) 1)
                    (and (eq (fkpqo-unique-strings?
                                (fkpqo-obs-nonces observations)) 1)
                    (and (eq (fkpqo-unique-strings?
                                (fkpqo-obs-content-shas observations)) 1)
                    (and (eq (fkpqo-unique-strings?
                                (fkpqo-obs-raw-shas observations)) 1)
                    (and (str_eq (fkpqo-obs-plan-sha first)
                                 (fkpqo-plan-sha))
                    (and (eq opens 1)
                    (and (eq reopens 0)
                         (eq final-release 1))))))))))) 1 0))
                (let transport (fkpqo-sum-transport observations))
                (let answer95 (fkpqo-sum-answer95 observations))
                (let heldout (fkpqo-sum-heldout observations))
                (let supervised (fkpqo-sum-supervised observations))
                (let local (fkpqo-sum-local observations))
                (let remote (fkpqo-sum-remote observations))
                (let complete (if (and (eq structural 1)
                    (and (eq local (fkpqo-family-total))
                    (and (eq remote 0) (eq heldout 0)))) 1 0))
                (let ready (if (and (eq complete 1)
                                    (eq supervised (fkpqo-family-total))) 1 0))
                (list (fkpqo-result-schema) observations
                      (fkpqo-family-total) structural transport answer95
                      heldout supervised local remote opens reopens
                      final-release complete ready))))

    (defn fkpqo-result-observations (r) (nth r 1))
    (defn fkpqo-result-family-total (r) (nth r 2))
    (defn fkpqo-result-valid (r) (nth r 3))
    (defn fkpqo-result-transport (r) (nth r 4))
    (defn fkpqo-result-answer95 (r) (nth r 5))
    (defn fkpqo-result-heldout-credit (r) (nth r 6))
    (defn fkpqo-result-supervised-credit (r) (nth r 7))
    (defn fkpqo-result-local (r) (nth r 8))
    (defn fkpqo-result-remote (r) (nth r 9))
    (defn fkpqo-result-opens (r) (nth r 10))
    (defn fkpqo-result-reopens (r) (nth r 11))
    (defn fkpqo-result-release (r) (nth r 12))
    (defn fkpqo-result-complete (r) (nth r 13))
    (defn fkpqo-result-ready (r)
        (if (nothing? r) (nothing) (nth r 14)))

    0)
