; form-cli-peer-grounded-symbol-source-live-run.fk -- real current-source
; observation through an admission-born symbol. The absent model is deliberate:
; this runner proves the evidence gate before it takes Metal ownership.
;
; preludes: form-stdlib/form-cli-peer-grounded-symbol-answer.fk

(do
    (defn fcpagsal-line (key value)
        (print_str (str_concat key (str_concat "=" (str_concat value "\n")))))
    (let source-ctx (fcpalsa-live-source-context))
    (let result (fcpagsa-run (fcms-none "source-gate-no-model")
        "psci-schema :: What does psci-schema identify?" source-ctx 1))
    (fcpagsal-line "route" (fcpa-route (fcpagsa-peer result)))
    (fcpagsal-line "symbol-signal"
        (if (nothing? (fcpagsa-symbol-result result)) "nothing"
            (fcpssa-signal (fcpagsa-symbol-result result))))
    (fcpagsal-line "current-source-status"
        (fcpagsa-observation-status (fcpagsa-source-observation result)))
    (fcpagsal-line "current-source-reason"
        (fcpagsa-observation-reason (fcpagsa-source-observation result)))
    (fcpagsal-line "model-signal"
        (if (nothing? (fcpagsa-direct-result result)) "not-entered"
            (fcpdaa-signal (fcpagsa-direct-result result))))
    (fcpagsal-line "lookup-count"
        (int_to_str (fcpagsa-lookup-count result)))
    (fcpagsal-line "callback-calls"
        (int_to_str (fcpa-callback-calls (fcpagsa-peer result))))
    0)
