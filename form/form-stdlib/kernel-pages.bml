//////////////////////////////////////////////////////////////////////
//
// kernel-pages.bml — the live pages speak for themselves.
//
// Every kernel maps a 128 MiB live page, /fg-k<pid>, opens it fresh even on a
// recycled pid, and takes it with it when it ends. The census walks every
// pid's page name, so it is the organ that reads what the host holds, as
// organ-health-v1 readings (organ kernel-pages, flow host):
//
//   exit-burial   pages of ended kernels that wrote their final note: a clean
//                 exit takes its page, so one standing came from a binary
//                 older than the exit burial, or from a wound
//   killed-pages  pages of kernels that ended without one: they stand until
//                 the roster's sweep reaches their slot, or a burial is chosen
//   living-pages  roster kernels whose page does not name them, say alive and
//                 carry its layout (a kernel that has called defns reads hot
//                 rows; a page smaller than the layout reads none)
//
// A page the host will not let the census read answers as withheld, apart
// from one that does not stand (kernel_page_ended -1 and 0). The census reads
// the pages and the roster twice, half a second apart, and keeps what both
// reads agree on. A withheld page whose process has left could be an ended
// kernel's, so exit-burial and killed-pages stand on none; a withheld page
// whose process stands could be a roster kernel's, so living-pages stands on
// none, and on a roster read that holds the census; all three stand on a walk
// that read the census's own page. Over a read that did not answer they claim
// no health and observe nothing, and their needs name it (page-read,
// roster-read) with the pids it missed.
//
// A page another kernel left is buried only as care a caller chooses: Urs
// asked on 2026-09-11 to be asked first. kpg-bury takes the pids a caller
// names, touches only those the census reads as ended, sends each through
// kernel_page_bury's guard (it declines a pid that answers again, or a page
// opened after the pid was seen gone), and the census observes again.
//
// preludes: form/form-stdlib/roster-census.bml form-stdlib/organ-care.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class KernelPages {
        def kpg-word(page, k) = len(page) < (k + 1) ? -1 : page[k];
        // ended pids whose page's alive word reads a: 0 wrote the final note, 1 did not
        def kpg-alive-is(pids, a) = nil?(pids) ? list() : (Comparable) kpg-word(kernel_live(head(pids)), 19) == a ? cons(head(pids), kpg-alive-is(tail(pids), a)) : kpg-alive-is(tail(pids), a);
        // a page is whole when it names its kernel, says alive, and a kernel that has called defns (heat, word 5) reads hot rows
        def kpg-whole-at(pid, page) = ((Comparable) kpg-word(page, 1) == pid) && (((Comparable) kpg-word(page, 19) == 1) && ((kpg-word(page, 5) <= 0) || (len(kernel_page_hot(pid, 1)) > 0)));
        def kpg-broken(pids) = nil?(pids) ? list() : kpg-whole-at(head(pids), kernel_live(head(pids))) ? kpg-broken(tail(pids)) : cons(head(pids), kpg-broken(tail(pids)));
        // one take, as (ended broken withheld-gone withheld-living held paged): the walk's ended pages, the roster kernels
        // whose page is broken, the withheld pages whose process has left and whose process stands, whether the roster
        // holds the census and whether the walk read the census's own page
        def kpg-take-of(pages, roster) = list(pages[0], kpg-broken(roster), rce-alive-is(pages[2], 0), rce-alive-is(pages[2], 1), rce-in?(host_pid(), roster), rce-in?(host_pid(), pages[1]));
        def kpg-take() = kpg-take-of(rce-pages(), rce-roster());
        // taken twice: what both reads saw, every page either could not read, and a read either missed stays missed
        def kpg-settle(a, b) = list(rce-both(a[0], b[0]), rce-both(a[1], b[1]), rce-union(a[2], b[2]), rce-union(a[3], b[3]), rce-all(a[4], b[4]), rce-all(a[5], b[5]));
        def kpg-settled(wait-ms) {
            let a = kpg-take();
            let rest = host_sleep_ms(wait-ms);
            let b = kpg-take();
            kpg-settle(a, b);
        }
        // a read that did not answer, as a need: the census's own pid when the read did not see it, beside the pids it
        // could not reach
        def kpg-needs-of(resource, pids) = nil?(pids) ? list() : list(oh-need(resource, json-node-array(oh-ints(pids))));
        def kpg-self-if(read) = (Comparable) read == 1 ? list() : list(host_pid());
        def kpg-page-needs(paged, withheld) = kpg-needs-of("page-read", rce-union(kpg-self-if(paged), withheld));
        // one reading per aspect: none expected, how many observed; the pids are the need's detail and the evidence's.
        // Evidence has one shape in this organ and in kernel-roster: an object with pids, and unanswered when null.
        // missing: the needs of the reads this aspect stands on that did not answer
        def kpg-evidence(pids) = json-node-object(list(json-node-pair("pids", json-node-array(oh-ints(pids)))));
        // a null reading says why it is null: its evidence names the reads that did not answer
        def kpg-unanswered(missing) = missing |> map(it => oh-get(it, "resource"));
        def kpg-reading(missing, aspect, pids, resource, offers) = nil?(missing) ? kpg-seen(aspect, pids, resource, offers) : oh-reading("kernel-pages", "host", aspect, json-node-int(0), json-node-null(), json-node-null(), missing, list("request-evidence", "defer"), oh-set(kpg-evidence(list()), "unanswered", json-node-array(kpg-unanswered(missing))));
        def kpg-seen(aspect, pids, resource, offers) = oh-reading("kernel-pages", "host", aspect, json-node-int(0), json-node-int(len(pids)), json-node-int(nil?(pids) ? 1 : 0), nil?(pids) ? list() : list(oh-need(resource, json-node-array(oh-ints(pids)))), nil?(pids) ? list() : offers, kpg-evidence(pids));
        // p: a settled take (kpg-settled)
        def kpg-readings(p) = list(kpg-reading(kpg-page-needs(p[5], p[2]), "exit-burial", kpg-alive-is(p[0], 0), "exit-burial", list("bury-ended", "keep")), kpg-reading(kpg-page-needs(p[5], p[2]), "killed-pages", rce-minus(p[0], kpg-alive-is(p[0], 0)), "burial-word", list("bury-ended", "keep")), kpg-reading(append(kpg-page-needs(p[5], p[3]), kpg-needs-of("roster-read", kpg-self-if(p[4]))), "living-pages", p[1], "fresh-page", list("request-evidence", "defer")));
        def kpg-observe() = kpg-readings(kpg-settled(500));
        // care: the chosen pids this reading names, each through the guard, as (pid buried) with 0 for a declined burial
        def kpg-bury-each(pids) = pids |> map(pid => json-node-array(list(json-node-int(pid), json-node-int(kernel_page_bury(pid)))));
        def kpg-supply(chosen, reading, need) = json-node-object(list(json-node-pair("buried", json-node-array(kpg-bury-each(rce-both(chosen, oh-int-values(json-array-elements(oh-get(need, "detail")))))))));
        def kpg-emit(chosen, stage, row) = oh-voice(row);
        def kpg-observe-again(chosen, reading, delivery) = oh-set(oh-find(kpg-observe(), reading), "care_of", json-node-string(oh-str(reading, "id")));
        def kpg-provider() = oc-provider("page-burial", list("exit-burial", "burial-word"), "bury-ended", kpg-supply);
        // care answers only a measured reading whose need names a chosen pid; the others stay as observed
        def kpg-care(chosen, reading) = node_eq(oh-get(reading, "health"), json-node-null()) ? oc-answer(reading, "unmeasured") : !oh-pain(reading) ? oc-answer(reading, "no-need") : nil?(rce-both(chosen, oh-int-values(json-array-elements(oh-get(oc-first-need(reading), "detail"))))) ? oc-answer(reading, "not-chosen") : oc-care(chosen, reading, oc-first-need(reading), list(kpg-provider()), kpg-emit, kpg-observe-again);
        // the explicit burial: the readings speak, then care runs for the pids a caller chose
        def kpg-bury(chosen) = oc-care-each(chosen, oh-voice-all(kpg-observe()), kpg-care);
    }
    0;
}
