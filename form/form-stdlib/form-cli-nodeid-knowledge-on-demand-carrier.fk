; form-cli-nodeid-knowledge-on-demand-carrier.fk — keep the resident form-cli
; voice small while one stateless NodeID query enters its own current Form unit.
;
; This is an explicit process carrier, not the final in-process program-image
; call.  The parent retains the model residence; the child runs only the
; scannerless NodeID/current-source recipe and returns its typed text.  A cold
; child compiles its own source unit; a warm child loads its current .fkb.
; Nothing here flattens source, grows the C seed, opens a model, or owns Metal.
;
; `host-exec` currently exposes stdout but not child status or supplied stdin.
; The request therefore travels as one deliberately small argv alphabet.  Any
; other byte is refused as typed nothing before a shell is opened.  The result
; names the unobserved exit-status seam rather than inferring success from it.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-nodeid-knowledge-on-demand-carrier-band.fk

(do
    (defn fcnkc-byte-in? (b lo hi) (if (and (ge b lo) (le b hi)) 1 0))

    ; Concept keys use letters/digits/-/_/? and NodeID coordinates use @ and .
    ; The carrier surface additionally uses : between its three bounded fields.
    (defn fcnkc-byte-admitted? (b)
        (if (eq (fcnkc-byte-in? b 48 57) 1) 1
            (if (eq (fcnkc-byte-in? b 65 90) 1) 1
            (if (eq (fcnkc-byte-in? b 97 122) 1) 1
            (if (or (eq b 45) (or (eq b 46) (or (eq b 58)
                (or (eq b 63) (or (eq b 64) (eq b 95)))))) 1 0)))))

    (defn fcnkc-surface-admitted-loop? (s i)
        (if (ge i (str_len s)) 1
            (if (eq (fcnkc-byte-admitted? (str_byte_at s i)) 1)
                (fcnkc-surface-admitted-loop? s (add i 1)) 0)))

    (defn fcnkc-surface-admitted? (s)
        (if (and (gt (str_len s) 0) (le (str_len s) 512))
            (fcnkc-surface-admitted-loop? s 0) 0))

    (defn fcnkc-fkwu-path ()
        (if (eq (fs_exists "./fkwu") 1) "./fkwu"
            (if (eq (fs_exists "../fkwu") 1) "../fkwu" "")))

    (defn fcnkc-runner-path ()
        (if (eq (fs_exists
                "form/form-stdlib/form-cli-nodeid-knowledge-on-demand-run.fk") 1)
            "form/form-stdlib/form-cli-nodeid-knowledge-on-demand-run.fk"
            (if (eq (fs_exists
                    "form-stdlib/form-cli-nodeid-knowledge-on-demand-run.fk") 1)
                "form-stdlib/form-cli-nodeid-knowledge-on-demand-run.fk" "")))

    (defn fcnkc-result (kind status reason body)
        (str_concat kind
        (str_concat "\nstatus="
        (str_concat status
        (str_concat "\nreason="
        (str_concat reason
        (str_concat "\ncarrier=on-demand-fkwu-source-unit"
        (str_concat "\ncarrier-boundary=host-exec-stdout-v1"
        (str_concat "\nchild-exit=unobserved"
            (if (str_eq body "") "" (str_concat "\n" body)))))))))))

    (defn fcnkc-refuse (kind reason)
        (fcnkc-result kind "nothing" reason ""))

    (defn fcnkc-command (surface)
        (str_concat (fcnkc-fkwu-path)
            (str_concat " " (str_concat (fcnkc-runner-path)
                (str_concat " " surface)))))

    (defn fcnkc-offer (kind surface expected-head)
        (if (eq (fcnkc-surface-admitted? surface) 0)
            (fcnkc-refuse kind "carrier-surface-not-admitted")
            (if (str_eq (fcnkc-fkwu-path) "")
                (fcnkc-refuse kind "fkwu-carrier-absent")
                (if (str_eq (fcnkc-runner-path) "")
                    (fcnkc-refuse kind "nodeid-source-unit-absent")
                    (do
                        (let out (host-exec (fcnkc-command surface) ""))
                        (if (eq (str_find out expected-head 0) 0)
                            (fcnkc-result kind "observed"
                                "source-unit-returned-typed-result" out)
                            (fcnkc-refuse kind
                                "source-unit-returned-no-typed-result")))))))

    (defn fcnkc-query (input)
        (if (eq (fcnkc-surface-admitted? input) 0)
            (fcnkc-refuse "nodeid-knowledge"
                "carrier-surface-not-admitted")
            (fcnkc-offer "nodeid-knowledge" (str_concat "query:" input)
                "nodeid-knowledge")))

    (defn fcnkc-stage (stage input)
        (if (or (eq (fcnkc-surface-admitted? stage) 0)
                (eq (fcnkc-surface-admitted? input) 0))
            (fcnkc-refuse "nodeid-stage" "carrier-surface-not-admitted")
            (fcnkc-offer "nodeid-stage"
                (str_concat "stage:" (str_concat stage (str_concat ":" input)))
                "nodeid-stage")))

    0)
