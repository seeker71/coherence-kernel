  def nlg-long-stuck(acc,added) = if nlg-boundary(added) then nlg-long-looping(nlg-fold(str_concat(substring(acc,nlg-max(0,(str_len(acc) - (3 * nlg-long-max()))),str_len(acc)),added))) else 0;
  def nlg-long-looping(s) = if (str_len(s) < (2 * nlg-long-min())) then 0 else nlg-long-scan(s,str_len(s),substring(s,(str_len(s) - nlg-long-probe()),str_len(s)),0);
  def nlg-long-scan(s,end,probe,from) = nlg-long-at(s,end,probe,str_find(s,probe,from));
  def nlg-long-at(s,end,probe,at) = if (at < 0) then 0 else nlg-long-period(s,end,probe,at,((end - str_len(probe)) - at));
