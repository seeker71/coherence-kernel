  }
  def nlg-cache-bytes(model,positions) = 8 * (positions * (head(model)[6] * (head(model)[3] * head(model)[4])));
  def nlg-copy-cache(old,new,n,width) {
   nil?(old) ? 1 : nlg-copy-cache-next(old,new,n,width,nam-copy(head(old),head(new),n * width));
  }
  def nlg-copy-cache-next(old,new,n,width,rc) = nlg-copy-cache(tail(old),tail(new),n,width);
  def nlg-grow(model,ctx,used) {
   let size = nlg-min(head(model)[9],head(ctx) * 2);
   (size <= head(ctx)) || (!nlg-room(nlg-cache-bytes(model,size))) ? nothing() : nlg-grow-admitted(model,ctx,used,size);
  }
  def nlg-grow-admitted(model,ctx,used,size) {
   let next = nll-context(model,size); let width = head(model)[3] * head(model)[4];
   let k = nlg-copy-cache(ctx[1],next[1],used,width);
   let v = nlg-copy-cache(ctx[2],next[2],used,width);
   let done = nam-sync(); let released = nll-context-close(ctx);
   next;
  }
  def nlg-forward-next(model,ctx,ids,pos,events,stage) {
   let t0 = host_monotonic_ms(); let live = metal_live();
   let r = nll-forward(model,ctx,ids,pos,0);
   let selected = nll-select(head(r),head(model)[5]);
   let event = nlg-event(events,stage,len(ids),t0,live,model);
   let released = nll-forward-close(r);
   selected;
  }
  def nlg-forward-choice(model,ctx,ids,pos,events,stage) {
   let t0 = host_monotonic_ms(); let live = metal_live();
   let r = nll-forward(model,ctx,ids,pos,0);
