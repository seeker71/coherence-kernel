  def nlg-feed(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids) = if (!nlg-room(nlg-forward-bytes(model,1,pos))) then nlg-press(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,"memory-pressure") else nlg-chosen(model,tk,ctx,nlg-forward-choice(model,ctx,[id],pos,events,"decode"),(pos + 1),n,limit,acc,stream,cancel,events,ids);
