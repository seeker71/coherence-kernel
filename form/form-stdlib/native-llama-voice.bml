  def nlg-slice-ceiling() = nlg-slice-ceiling-of(metal_live());
  def nlg-slice-ceiling-of(live) = live[19] <= 0 ? 0 : (live[19] / nlg-slice-share());
  def nlg-slice-fits?(bytes) = nlg-room(bytes) && ((nlg-slice-ceiling() <= 0) || (bytes <= nlg-slice-ceiling()));
  def nlg-chunk(model,t,pos) = t <= 0 ? 0 : nlg-slice-fits?(nlg-forward-bytes(model,t,pos)) ? t : nlg-chunk(model,t / 2,pos);
  def nlg-prefill(model,ctx,ids,pos,events) {
