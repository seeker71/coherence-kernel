  def nlg-eos(t,id) = ((Comparable) id == nlt-special(t,"<|eot_id|>")) || ((Comparable) id == nlt-special(t,"<|end_of_text|>"));
  // Result: text, reason (empty only on EOS), emitted count, final context, event file.
