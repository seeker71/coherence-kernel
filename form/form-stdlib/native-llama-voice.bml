  }
  def nlg-adapt-emitted-go(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,logged) = if (pos >= head(ctx)) then nlg-grew(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,nlg-grow(model,ctx,pos)) else nlg-feed(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids);
  def nlg-decode(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids) {
