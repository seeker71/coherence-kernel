  def nlg-looping(acc) {
   let end = str_len(acc);
   if (end < nlg-repeat-min-bytes()) then 0 else nlg-looping-tail(nlg-fold(substring(acc,nlg-max(0,(end - nlg-repeat-window())),end)));
