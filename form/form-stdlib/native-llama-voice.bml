// Resident model/tokenizer ownership with a growing KV context and a token stream.
// maxTokens=0 keeps streaming until EOS, cancellation, architectural or memory pressure.
// A cap is a signal, not a ceiling. Caller token caps grow toward EOS.
// A 24-character tail repeat is a cap. A sentence-frame repeat (case-folded
// prefix of the current sentence matching an earlier sentence start) is a
// cap. A 12-character span appearing twice, case-folded, anywhere in the
// text is a cap. Prefer second-best, then third-best, when first-best would
// stick; stop as adapted-repeat when all three would. An adapted-repeat
// drops an unfinished last sentence. Admission that would refuse for want>maxpos clamps to
// maxpos when the prompt itself fits.
// Partial output always carries its actual stopping reason.
// preludes: form-stdlib/native-llama-metal.bml form-stdlib/native-llama-tokenizer.bml form-stdlib/spool-bell-transport.fk form-stdlib/form-fs.fk
section [form.bml] {
 class NativeLlamaVoice {
  def nlg-event(path,stage,count,start,live,model) {
   let now = host_monotonic_ms(); let current = metal_live();
   let event = json-node-object(list(json-node-pair("stage",json-node-string(stage)),json-node-pair("tokens",json-node-int(count)),json-node-pair("wall_ms",json-node-int(sub(now,start))),json-node-pair("gpu_busy_us",json-node-int(sub(nth(current,11),nth(live,11)))),json-node-pair("dispatches",json-node-int(sub(nth(current,7),nth(live,7)))),json-node-pair("buffers_created",json-node-int(sub(nth(current,16),nth(live,16)))),json-node-pair("new_pipelines",json-node-int(sub(nth(current,3),nth(live,3)))),json-node-pair("live_buffers",json-node-int(nth(current,2))),json-node-pair("device_bytes",json-node-int(nth(current,18))),json-node-pair("model",json-node-string(nth(model,4))),json-node-pair("adapter",json-node-string(nll-adapter(model))),json-node-pair("lora_pairs",json-node-int(nll-pair-count(nth(model,1)))),json-node-pair("lora_rank",json-node-int(if eq(nll-pair-count(nth(model,1)),0) then 0 else nll-rank(nth(model,1))))));
   if eq(str_len(path),0) then 0 else sbt-append(path,str_concat(json-emit(event),"\n"));
  }
  def nlg-open(dir,adapter) = nlg-open-at(dir,adapter,"");
  def nlg-open-at(dir,adapter,events) {
   let start = host_monotonic_ms(); let live = metal_live(); let model = nll-open(dir,adapter);
   let opened = nlg-event(events,"model-admission",0,start,live,model);
   let t0 = host_monotonic_ms(); let lg = metal_live(); let tk = nlt-open(dir);
   let indexed = nlg-event(events,"tokenizer-index",0,t0,lg,model);
   list(model,tk);
  }
  def nlg-close(session) = nll-close(head(session));
  def nlg-min(a,b) = if lt(a,b) then a else b;
  def nlg-max(a,b) = if gt(a,b) then a else b;
  def nlg-room(bytes) {
   let live = metal_live();
   and(gt(nth(live,19),0),le(add(nth(live,18),bytes),nth(live,19)));
  }
  def nlg-cache-bytes(model,positions) = mul(8,mul(positions,mul(nth(head(model),6),mul(nth(head(model),3),nth(head(model),4)))));
  def nlg-copy-cache(old,new,n,width) {
   if nil?(old) then 1 else nlg-copy-cache-next(old,new,n,width,nam-copy(head(old),head(new),mul(n,width)));
  }
  def nlg-copy-cache-next(old,new,n,width,rc) = nlg-copy-cache(tail(old),tail(new),n,width);
  def nlg-grow(model,ctx,used) {
   let size = nlg-min(nth(head(model),9),mul(head(ctx),2));
   if or(le(size,head(ctx)),not(nlg-room(nlg-cache-bytes(model,size)))) then nothing() else nlg-grow-admitted(model,ctx,used,size);
  }
  def nlg-grow-admitted(model,ctx,used,size) {
   let next = nll-context(model,size); let width = mul(nth(head(model),3),nth(head(model),4));
   let k = nlg-copy-cache(nth(ctx,1),nth(next,1),used,width);
   let v = nlg-copy-cache(nth(ctx,2),nth(next,2),used,width);
   let done = nam-sync(); let released = nll-context-close(ctx);
   next;
  }
  def nlg-forward-next(model,ctx,ids,pos,events,stage) {
   let t0 = host_monotonic_ms(); let live = metal_live();
   let r = nll-forward(model,ctx,ids,pos,0);
   let selected = nll-select(head(r),nth(head(model),5));
   let event = nlg-event(events,stage,len(ids),t0,live,model);
   let released = nll-forward-close(r);
   selected;
  }
  def nlg-forward-choice(model,ctx,ids,pos,events,stage) {
   let t0 = host_monotonic_ms(); let live = metal_live();
   let r = nll-forward(model,ctx,ids,pos,0);
   let vocab = nth(head(model),5);
   let best = nll-select(head(r),vocab);
   let second = nll-select-except(head(r),vocab,best);
   let third = nll-select-except2(head(r),vocab,best,second);
   let event = nlg-event(events,stage,len(ids),t0,live,model);
   let released = nll-forward-close(r);
   list(best,second,third);
  }
  def nlg-pick(acc,best-text,second-text,best-id,second-id) {
   if eq(nlg-stuck(acc,best-text),1) then nlg-pick-second(acc,second-text,second-id) else list(best-id,"");
  }
  def nlg-pick-second(acc,second-text,second-id) {
   if lt(second-id,0) then list(-1,"adapted-repeat") else if eq(nlg-stuck(acc,second-text),1) then list(-1,"adapted-repeat") else list(second-id,"adapted-choice");
  }
  def nlg-pick3(acc,t1,t2,t3,i1,i2,i3) {
   if eq(nlg-stuck(acc,t1),0) then list(i1,"") else if eq(nlg-stuck(acc,t2),0) then list(i2,"adapted-choice") else if eq(nlg-stuck(acc,t3),0) then list(i3,"adapted-choice") else list(-1,"adapted-repeat");
  }
  def nlg-decode-text(tk,id) = if or(lt(id,0),nlg-eos(tk,id)) then "" else nlt-decode-id(tk,id);
  def nlg-pick-id(tk,acc,best,second,third) {
   nlg-pick-candidates(tk,acc,list(best,second,third),0,0);
  }
  def nlg-pick-candidates(tk,acc,ids,rank,missing) {
   if nil?(ids) then list(if missing then -2 else -1,if missing then "tokenizer-candidates-absent" else "adapted-repeat")
   else if nlg-eos(tk,head(ids)) then list(head(ids),if rank then "adapted-choice" else "")
   else if not(nlt-known-id(tk,head(ids))) then nlg-pick-candidates(tk,acc,tail(ids),add(rank,1),1)
   else if nlg-stuck(acc,nlt-decode-id(tk,head(ids))) then nlg-pick-candidates(tk,acc,tail(ids),add(rank,1),missing)
   else list(head(ids),if rank then "adapted-choice" else "");
  }
  // Conservative byte estimate for the actual forward tape, including attention scores.
  def nlg-forward-bytes(model,t,pos) {
   let g = head(model); let d = nth(g,0); let kd = mul(nth(g,3),nth(g,4));
   let layer = add(mul(t,add(add(mul(7,d),mul(2,kd)),add(mul(3,nth(g,1)),2))),mul(t,mul(nth(g,2),add(pos,t))));
   mul(4,add(mul(nth(g,6),layer),add(mul(t,add(d,nll-rank(nth(model,1)))),add(nth(g,5),mul(2,d)))));
  }
  def nlg-chunk(model,t,pos) = if le(t,0) then 0 else if nlg-room(nlg-forward-bytes(model,t,pos)) then t else nlg-chunk(model,div(t,2),pos);
  def nlg-prefill(model,ctx,ids,pos,events) {
   let t = nlg-chunk(model,len(ids),pos);
   if eq(t,0) then list(-1,pos,"memory-pressure") else nlg-prefill-chunk(model,ctx,ids,pos,events,t);
  }
  def nlg-prefill-chunk(model,ctx,ids,pos,events,t) {
   if eq(t,len(ids)) then list(nlg-forward-choice(model,ctx,take(t,ids),pos,events,"prefill"),add(pos,t),"") else nlg-prefill-more(model,ctx,ids,pos,events,t);
  }
  def nlg-prefill-more(model,ctx,ids,pos,events,t) {
   let next = nlg-forward-next(model,ctx,take(t,ids),pos,events,"prefill");
   nlg-prefill(model,ctx,drop(t,ids),add(pos,t),events);
  }
  def nlg-eos(t,id) = or(eq(id,nlt-special(t,"<|eot_id|>")),eq(id,nlt-special(t,"<|end_of_text|>")));
  // Result: text, reason (empty only on EOS), emitted count, final context, event file.
  def nlg-result(text,why,n,ctx,events) = list(if str_eq(why,"adapted-repeat") then nlg-complete(text) else text,why,n,ctx,events);
  def nlg-stream(stream,text) = if eq(str_len(stream),0) then 0 else sbt-append(stream,text);
  def nlg-want-capacity(prompt-n,limit) = add(prompt-n,if gt(limit,0) then limit else 16);
  def nlg-admit-capacity(want,maxpos) = if gt(want,maxpos) then maxpos else want;
  def nlg-floor-capacity(prompt-n) = add(prompt-n,1);
  def nlg-shrink-capacity(capacity,prompt-n) {
   let floor = nlg-floor-capacity(prompt-n);
   if le(capacity,floor) then floor else nlg-max(floor,div(capacity,2));
  }
  def nlg-drop(xs,n) = if or(le(n,0),nil?(xs)) then xs else nlg-drop(tail(xs),sub(n,1));
  def nlg-take-last(xs,n) {
   let d = sub(len(xs),n);
   if le(d,0) then xs else nlg-drop(xs,d);
  }
  def nlg-slide-n(ids) {
   let n = len(ids);
   if le(n,1) then n else nlg-max(1,div(n,2));
  }
  // Retain each emitted ID alongside the current context's IDs.
  def nlg-remember(ids,id) = append(ids,list(id));
  def nlg-grown-limit(limit,maxpos,pos) {
   if le(limit,0) then 0 else nlg-grown-limit-room(limit,sub(maxpos,pos));
  }
  def nlg-grown-limit-room(limit,room) {
   if le(room,limit) then limit else if gt(mul(limit,2),room) then room else mul(limit,2);
  }
  def nlg-looping(acc) {
   if lt(str_len(acc),24) then 0 else nlg-looping-span(acc,substring(acc,sub(str_len(acc),24),str_len(acc)));
  }
  def nlg-looping-span(acc,span) {
   let first = str_find(acc,span,0);
   if lt(first,0) then 0 else if ge(str_find(acc,span,add(first,1)),0) then 1 else 0;
  }
  def nlg-lower-byte(b) = if and(ge(b,65),le(b,90)) then add(b,32) else b;
  def nlg-lower-at(s,i,acc) = if ge(i,str_len(s)) then acc else nlg-lower-at(s,add(i,1),str_concat(acc,byte_to_str(nlg-lower-byte(str_byte_at(s,i)))));
  def nlg-lower(s) = nlg-lower-at(s,0,"");
  def nlg-skip-space(s,i) = if ge(i,str_len(s)) then i else if eq(str_byte_at(s,i),32) then nlg-skip-space(s,add(i,1)) else i;
  def nlg-last-sep(acc,from,best) {
   let p = str_find(acc,". ",from);
   if lt(p,0) then best else nlg-last-sep(acc,add(p,1),p);
  }
  def nlg-complete(acc) {
   let sep = nlg-last-sep(acc,0,-1);
   if lt(sep,0) then acc else if ge(str_find(acc,".",add(sep,2)),0) then acc else substring(acc,0,add(sep,1));
  }
  def nlg-current-start(acc) {
   let sep = nlg-last-sep(acc,0,-1);
   if lt(sep,0) then 0 else nlg-skip-space(acc,add(sep,2));
  }
  def nlg-prefix-at(s,i,n) {
   if ge(i,str_len(s)) then "" else if lt(str_len(s),add(i,n)) then substring(s,i,str_len(s)) else substring(s,i,add(i,n));
  }
  def nlg-next-sentence(s,i) {
   let p = str_find(s,". ",i);
   if lt(p,0) then str_len(s) else nlg-skip-space(s,add(p,2));
  }
  def nlg-frame-hit(prior,prefix,i) {
   if or(eq(str_len(prefix),0),ge(i,str_len(prior))) then 0 else if str_eq(nlg-prefix-at(prior,i,str_len(prefix)),prefix) then 1 else nlg-frame-hit(prior,prefix,nlg-next-sentence(prior,i));
  }
  def nlg-framing(acc) {
   let start = nlg-current-start(acc);
   let cur = nlg-lower(nlg-prefix-at(acc,start,16));
   if lt(str_len(cur),8) then 0 else nlg-frame-hit(nlg-lower(substring(acc,0,start)),cur,0);
  }
  def nlg-echo-n() = 12;
  def nlg-echo-dup(s,i) {
   if gt(add(i,nlg-echo-n()),str_len(s)) then 0 else nlg-echo-dup-at(s,i,nlg-prefix-at(s,i,nlg-echo-n()));
  }
  def nlg-echo-dup-at(s,i,span) {
   let first = str_find(s,span,0);
   if lt(first,0) then nlg-echo-dup(s,add(i,1)) else if ge(str_find(s,span,add(first,1)),0) then 1 else nlg-echo-dup(s,add(i,1));
  }
  def nlg-echoing(acc) {
   let s = nlg-lower(acc);
   if lt(str_len(s),mul(nlg-echo-n(),2)) then 0 else nlg-echo-dup(s,0);
  }
  def nlg-stuck(acc,added) {
   let all = str_concat(acc,added);
   if eq(nlg-looping(all),1) then 1 else if eq(nlg-framing(all),1) then 1 else nlg-echoing(all);
  }
  def nlg-adapt-token(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids) {
   if eq(nlg-stuck(acc,""),1) then nlg-result(acc,"adapted-repeat",n,ctx,events)
   else nlg-adapt-grow(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,nlg-grown-limit(limit,nth(head(model),9),pos));
  }
  def nlg-adapt-grow(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,grown) {
   if le(grown,limit) then nlg-result(acc,"token-limit",n,ctx,events)
   else nlg-adapt-continue(model,tk,ctx,id,pos,n,grown,acc,stream,cancel,events,ids,nlg-event(events,"adapt-token-limit",n,host_monotonic_ms(),metal_live(),model));
  }
  def nlg-adapt-continue(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,logged) = nlg-decode(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids);
  def nlg-adapt-emitted(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids) {
   if eq(nlg-stuck(acc,""),1) then nlg-result(acc,"adapted-repeat",n,ctx,events)
   else nlg-adapt-emitted-grow(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,nlg-grown-limit(limit,nth(head(model),9),pos));
  }
  def nlg-adapt-emitted-grow(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,grown) {
   if le(grown,limit) then nlg-result(acc,"token-limit",n,ctx,events)
   else nlg-adapt-emitted-go(model,tk,ctx,id,pos,n,grown,acc,stream,cancel,events,ids,nlg-event(events,"adapt-token-limit",n,host_monotonic_ms(),metal_live(),model));
  }
  def nlg-adapt-emitted-go(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,logged) = if ge(pos,head(ctx)) then nlg-grew(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,nlg-grow(model,ctx,pos)) else nlg-feed(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids);
  def nlg-decode(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids) {
   if or(lt(id,0),ge(id,nth(head(model),5))) then nlg-result(acc,"non-finite-logits",n,ctx,events)
   else if nlg-eos(tk,id) then nlg-result(acc,"",n,ctx,events)
   else if not(nlt-known-id(tk,id)) then nlg-result(acc,str_concat("tokenizer-id-absent:",int_to_str(id)),n,ctx,events)
   else if and(gt(limit,0),ge(n,limit)) then nlg-adapt-token(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids)
   else if and(gt(str_len(cancel),0),gt(file_size(cancel),0)) then nlg-result(acc,"cancelled",n,ctx,events)
   else nlg-emit(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids);
  }
  def nlg-emit(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids) {
   let text = nlt-decode-id(tk,id); let sent = nlg-stream(stream,text);
   let all = str_concat(acc,text); let count = add(n,1); let held = nlg-remember(ids,id);
   if eq(nlg-stuck(acc,text),1) then nlg-result(all,"adapted-repeat",count,ctx,events)
   else if and(gt(limit,0),ge(count,limit)) then nlg-adapt-emitted(model,tk,ctx,id,pos,count,limit,all,stream,cancel,events,held)
   else if ge(pos,head(ctx)) then nlg-grew(model,tk,ctx,id,pos,count,limit,all,stream,cancel,events,held,nlg-grow(model,ctx,pos))
   else nlg-feed(model,tk,ctx,id,pos,count,limit,all,stream,cancel,events,held);
  }
  def nlg-grew(model,tk,old,id,pos,n,limit,acc,stream,cancel,events,ids,next) = if nothing?(next) then nlg-press(model,tk,old,id,pos,n,limit,acc,stream,cancel,events,ids,if ge(pos,nth(head(model),9)) then "model-position-limit" else "memory-pressure") else nlg-feed(model,tk,next,id,pos,n,limit,acc,stream,cancel,events,ids);
  def nlg-feed(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids) = if not(nlg-room(nlg-forward-bytes(model,1,pos))) then nlg-press(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,"memory-pressure") else nlg-chosen(model,tk,ctx,nlg-forward-choice(model,ctx,list(id),pos,events,"decode"),add(pos,1),n,limit,acc,stream,cancel,events,ids);
  def nlg-press(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,why) {
   let keep = nlg-take-last(ids,nlg-slide-n(ids));
   if ge(len(keep),len(ids)) then nlg-result(acc,why,n,ctx,events) else nlg-slide(model,tk,ctx,keep,n,limit,acc,stream,cancel,events);
  }
  def nlg-slide(model,tk,old,keep,n,limit,acc,stream,cancel,events) {
   let cap = nlg-admit-capacity(nlg-want-capacity(len(keep),if gt(limit,0) then nlg-max(1,sub(limit,n)) else 16),nth(head(model),9));
   if not(nlg-room(nlg-cache-bytes(model,cap))) then nlg-result(acc,"memory-pressure",n,old,events) else nlg-slide-go(model,tk,old,keep,n,limit,acc,stream,cancel,events,cap);
  }
  def nlg-slide-go(model,tk,old,keep,n,limit,acc,stream,cancel,events,cap) {
   let released = nll-context-close(old);
   let logged = nlg-event(events,"adapt-slide",n,host_monotonic_ms(),metal_live(),model);
   nlg-slide-admitted(model,tk,keep,n,limit,acc,stream,cancel,events,cap);
  }
  def nlg-slide-admitted(model,tk,keep,n,limit,acc,stream,cancel,events,cap) {
   let ctx = nll-context(model,cap);
   let pre = nlg-prefill(model,ctx,keep,0,events);
   if gt(str_len(nth(pre,2)),0) then nlg-result(acc,nth(pre,2),n,ctx,events) else nlg-chosen(model,tk,ctx,head(pre),nth(pre,1),n,limit,acc,stream,cancel,events,keep);
  }
  def nlg-chosen(model,tk,ctx,choice,pos,n,limit,acc,stream,cancel,events,ids) {
   let picked = nlg-pick-id(tk,acc,head(choice),nth(choice,1),nth(choice,2));
   if lt(head(picked),0) then nlg-result(acc,nth(picked,1),n,ctx,events)
   else nlg-chosen-go(model,tk,ctx,head(picked),pos,n,limit,acc,stream,cancel,events,ids,nth(picked,1));
  }
  def nlg-chosen-go(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids,why) {
   let logged = if str_eq(why,"adapted-choice") then nlg-event(events,"adapt-choice",n,host_monotonic_ms(),metal_live(),model) else 0;
   nlg-decode(model,tk,ctx,id,pos,n,limit,acc,stream,cancel,events,ids);
  }
  def nlg-finish-event(model,result,events,start) {
   let event = json-node-object(list(json-node-pair("stage",json-node-string("finished")),json-node-pair("wall_ms",json-node-int(sub(host_monotonic_ms(),start))),json-node-pair("tokens_emitted",json-node-int(nth(result,2))),json-node-pair("bytes_emitted",json-node-int(str_len(head(result)))),json-node-pair("reason",json-node-string(if eq(str_len(nth(result,1)),0) then "eos" else nth(result,1))),json-node-pair("model",json-node-string(nth(model,4))),json-node-pair("adapter",json-node-string(nll-adapter(model)))));
   if eq(str_len(events),0) then 0 else sbt-append(events,str_concat(json-emit(event),"\n"));
  }
  def nlg-ask(session,prompt,limit,stream,cancel,events) {
   let start = host_monotonic_ms();
   let result = nlg-ask-inner(session,prompt,limit,stream,cancel,events);
   let finished = nlg-finish-event(head(session),result,events,start);
   result;
  }
  def nlg-ask-inner(session,prompt,limit,stream,cancel,events) {
   let model = head(session); let tk = nth(session,1);
   let ids = nlt-chat(tk,prompt); let maxpos = nth(head(model),9);
   if or(lt(limit,0),gt(len(ids),maxpos)) then list("","context-admission-refused",0,events) else nlg-ask-fit(model,tk,ids,nlg-admit-capacity(nlg-want-capacity(len(ids),limit),maxpos),limit,stream,cancel,events);
  }
  def nlg-ask-fit(model,tk,ids,capacity,limit,stream,cancel,events) {
   if nlg-room(nlg-cache-bytes(model,capacity)) then nlg-ask-admitted(model,tk,ids,capacity,limit,stream,cancel,events) else nlg-ask-shrink(model,tk,ids,capacity,limit,stream,cancel,events,nlg-shrink-capacity(capacity,len(ids)));
  }
  def nlg-ask-shrink(model,tk,ids,capacity,limit,stream,cancel,events,next) {
   if ge(next,capacity) then list("","context-admission-refused",0,events) else nlg-ask-fit(model,tk,ids,next,limit,stream,cancel,events);
  }
  def nlg-ask-admitted(model,tk,ids,capacity,limit,stream,cancel,events) {
   let ctx = nll-context(model,capacity);
   let pre = nlg-prefill(model,ctx,ids,0,events);
   let result = if gt(str_len(nth(pre,2)),0) then nlg-result("",nth(pre,2),0,ctx,events) else nlg-chosen(model,tk,ctx,head(pre),nth(pre,1),0,limit,"",stream,cancel,events,ids);
   let released = nll-context-close(nth(result,3));
