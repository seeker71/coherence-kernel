// Resident model/tokenizer ownership with a growing KV context and a token stream.
// maxTokens=0 keeps streaming until EOS, cancellation, architectural or memory pressure.
// A cap is a signal, not a ceiling. Caller token caps grow toward EOS.
// Consecutive repetition at the active tail is an adaptation signal. Shared
// references and sentence openings alone are not loops. The byte-period witness
// reads at most 512 tail bytes; it is a bounded heuristic, not a semantic judge.
// Prefer second-best, then third-best, when first-best would stick; stop as
// adapted-repeat when all three would. An adapted-repeat
// drops an unfinished last sentence. Admission that would refuse for want>maxpos clamps to
// maxpos when the prompt itself fits.
// Partial output always carries its actual stopping reason.
// preludes: form-stdlib/native-llama-metal.bml form-stdlib/native-llama-tokenizer.bml form-stdlib/spool-bell-transport.fk form-stdlib/form-fs.fk
section [form.bml] {
 class NativeLlamaVoice {
  def nlg-event(path,stage,count,start,live,model) {
   let now = host_monotonic_ms(); let current = metal_live();
   let event = json-node-object([json-node-pair("stage",json-node-string(stage)),json-node-pair("tokens",json-node-int(count)),json-node-pair("wall_ms",json-node-int((now - start))),json-node-pair("gpu_busy_us",json-node-int((current[11] - live[11]))),json-node-pair("dispatches",json-node-int((current[7] - live[7]))),json-node-pair("buffers_created",json-node-int((current[16] - live[16]))),json-node-pair("new_pipelines",json-node-int((current[3] - live[3]))),json-node-pair("live_buffers",json-node-int(current[2])),json-node-pair("device_bytes",json-node-int(current[18])),json-node-pair("model",json-node-string(model[4])),json-node-pair("adapter",json-node-string(nll-adapter(model))),json-node-pair("lora_pairs",json-node-int(nll-pair-count(model[1]))),json-node-pair("lora_rank",json-node-int(if ((Comparable) nll-pair-count(model[1]) == 0) then 0 else nll-rank(model[1])))]);
   if ((Comparable) str_len(path) == 0) then 0 else sbt-append(path,str_concat(json-emit(event),"\n"));
  }
  def nlg-open(dir,adapter) = nlg-open-at(dir,adapter,"");
  def nlg-open-at(dir,adapter,events) {
   let start = host_monotonic_ms(); let live = metal_live(); let model = nll-open(dir,adapter);
   let opened = nlg-event(events,"model-admission",0,start,live,model);
   let t0 = host_monotonic_ms(); let lg = metal_live(); let tk = nlt-open(dir);
   let indexed = nlg-event(events,"tokenizer-index",0,t0,lg,model);
   [model,tk];
  }
  def nlg-close(session) = nll-close(head(session));
  def nlg-min(a,b) = if (a < b) then a else b;
  def nlg-max(a,b) = if (a > b) then a else b;
  def nlg-room(bytes) {
   let live = metal_live();
   ((live[19] > 0) && ((live[18] + bytes) <= live[19]));
  }
  def nlg-cache-bytes(model,positions) = (8 * (positions * (head(model)[6] * (head(model)[3] * head(model)[4]))));
  def nlg-copy-cache(old,new,n,width) {
   if nil?(old) then 1 else nlg-copy-cache-next(old,new,n,width,nam-copy(head(old),head(new),(n * width)));
  }
  def nlg-copy-cache-next(old,new,n,width,rc) = nlg-copy-cache(tail(old),tail(new),n,width);
  def nlg-grow(model,ctx,used) {
   let size = nlg-min(head(model)[9],(head(ctx) * 2));
   if ((size <= head(ctx)) || (!nlg-room(nlg-cache-bytes(model,size)))) then nothing() else nlg-grow-admitted(model,ctx,used,size);
  }
  def nlg-grow-admitted(model,ctx,used,size) {
   let next = nll-context(model,size); let width = (head(model)[3] * head(model)[4]);
   let k = nlg-copy-cache(ctx[1],next[1],used,width);
   let v = nlg-copy-cache(ctx[2],next[2],used,width);
   let done = nam-sync(); let released = nll-context-close(ctx);
   next;
  }
  def nlg-forward-next(model,ctx,ids,pos,events,stage) {
   let t0 = host_monotonic_ms(); let live = metal_live();
   let r = nll-forward(model,ctx,ids,pos,0);
   let selected = nll-select(head(r),head(model)[5]);
   let event = nlg-event(events,stage,len(ids),t0,live,model);
   let released = nll-forward-close(r);
   selected;
  }
  def nlg-forward-choice(model,ctx,ids,pos,events,stage) {
   let t0 = host_monotonic_ms(); let live = metal_live();
   let r = nll-forward(model,ctx,ids,pos,0);
   let vocab = head(model)[5];
   let best = nll-select(head(r),vocab);
   let second = nll-select-except(head(r),vocab,best);
   let third = nll-select-except2(head(r),vocab,best,second);
   let event = nlg-event(events,stage,len(ids),t0,live,model);
   let released = nll-forward-close(r);
   [best,second,third];
  }
  def nlg-pick(acc,best-text,second-text,best-id,second-id) {
   if ((Comparable) nlg-stuck(acc,best-text) == 1) then nlg-pick-second(acc,second-text,second-id) else [best-id,""];
  }
  def nlg-pick-second(acc,second-text,second-id) {
   if (second-id < 0) then [-1,"adapted-repeat"] else if ((Comparable) nlg-stuck(acc,second-text) == 1) then [-1,"adapted-repeat"] else [second-id,"adapted-choice"];
  }
  def nlg-pick3(acc,t1,t2,t3,i1,i2,i3) {
   if ((Comparable) nlg-stuck(acc,t1) == 0) then [i1,""] else if ((Comparable) nlg-stuck(acc,t2) == 0) then [i2,"adapted-choice"] else if ((Comparable) nlg-stuck(acc,t3) == 0) then [i3,"adapted-choice"] else [-1,"adapted-repeat"];
  }
  def nlg-decode-text(tk,id) = if ((id < 0) || nlg-eos(tk,id)) then "" else nlt-decode-id(tk,id);
  def nlg-pick-id(tk,acc,best,second,third) {
   nlg-pick-candidates(tk,acc,[best,second,third],0,0);
  }
  def nlg-pick-candidates(tk,acc,ids,rank,missing) {
   if nil?(ids) then [if missing then -2 else -1,if missing then "tokenizer-candidates-absent" else "adapted-repeat"]
   else if nlg-eos(tk,head(ids)) then [head(ids),if rank then "adapted-choice" else ""]
   else if (!nlt-known-id(tk,head(ids))) then nlg-pick-candidates(tk,acc,tail(ids),(rank + 1),1)
   else if nlg-stuck(acc,nlt-decode-id(tk,head(ids))) then nlg-pick-candidates(tk,acc,tail(ids),(rank + 1),missing)
   else [head(ids),if rank then "adapted-choice" else ""];
