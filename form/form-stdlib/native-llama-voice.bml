  def nlg-repeat-space(b) = (((Comparable) b == 32) || ((Comparable) b == 9)) || (((Comparable) b == 10) || ((Comparable) b == 13));
  def nlg-repeat-content(s,i,end) = i >= end ? 0 : nlg-repeat-space(str_byte_at(s,i)) ? nlg-repeat-content(s,i + 1,end) : 1;
