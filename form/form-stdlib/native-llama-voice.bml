section [form.bml] {
 let NLG-OWNED=record_new(0,"opening",nothing(),"owners",[]);
 class NativeLlamaVoice {
  def nlg-event(path,stage,count,start,live,model) {
    len(path)==0 ? 0 : {
   let now = host_monotonic_ms(); let current = metal_live();
   let event = json-node-object([json-node-pair("stage",json-node-string(stage)),json-node-pair("tokens",json-node-int(count)),json-node-pair("wall_ms",json-node-int(now - start)),json-node-pair("gpu_busy_us",json-node-int(current[11] - live[11])),json-node-pair("dispatches",json-node-int(current[7] - live[7])),json-node-pair("buffers_created",json-node-int(current[16] - live[16])),json-node-pair("new_pipelines",json-node-int(current[3] - live[3])),json-node-pair("live_buffers",json-node-int(current[2])),json-node-pair("device_bytes",json-node-int(current[18])),json-node-pair("model",json-node-string(model[4])),json-node-pair("adapter",json-node-string(nll-adapter(model))),json-node-pair("lora_pairs",json-node-int(nll-pair-count(model[1]))),json-node-pair("lora_rank",json-node-int((Comparable) nll-pair-count(model[1]) == 0 ? 0 : nll-rank(model[1])))]);
    sbt-append(path,json-emit(event) + "\n");
    };
  }
  def nlg-open(dir,adapter) = nlg-open-at(dir,adapter,"");
