  // Conservative byte estimate for the actual forward tape, including attention scores.
  def nlg-forward-bytes(model,t,pos) {
   let g = head(model); let d = g[0]; let kd = (g[3] * g[4]);
   let layer = ((t * (((7 * d) + (2 * kd)) + ((3 * g[1]) + 2))) + (t * (g[2] * (pos + t))));
   (4 * ((g[6] * layer) + ((t * (d + nll-rank(model[1]))) + (g[5] + (2 * d)))));
  }
  // Room is not wisdom. The tape a slice unrolls is layers x t x heads x (pos+t):
  // quadratic in the slice itself, so on a host with a large budget the first
  // chunk takes the whole prompt and holds tens of gigabytes — this 3B at 4,200
  // prompt IDs asks for seventy, which the budget allows and the machine cannot
  // work in. A slice is bounded by a share of the device's own budget, and the
  // prefill walks the prompt in as many slices as that takes.
  def nlg-slice-share() = 16;
  def nlg-slice-ceiling() = nlg-slice-ceiling-of(metal_live());
  def nlg-slice-ceiling-of(live) = if (live[19] <= 0) then 0 else (live[19] / nlg-slice-share());
  def nlg-slice-fits?(bytes) = (nlg-room(bytes) && ((nlg-slice-ceiling() <= 0) || (bytes <= nlg-slice-ceiling())));
  def nlg-chunk(model,t,pos) = if (t <= 0) then 0 else if nlg-slice-fits?(nlg-forward-bytes(model,t,pos)) then t else nlg-chunk(model,(t / 2),pos);
  def nlg-prefill(model,ctx,ids,pos,events) {
   let t = nlg-chunk(model,len(ids),pos);
   if ((Comparable) t == 0) then [-1,pos,"memory-pressure"] else nlg-prefill-chunk(model,ctx,ids,pos,events,t);
  }
  def nlg-prefill-chunk(model,ctx,ids,pos,events,t) {
   if ((Comparable) t == len(ids)) then [nlg-forward-choice(model,ctx,take(t,ids),pos,events,"prefill"),(pos + t),""] else nlg-prefill-more(model,ctx,ids,pos,events,t);
  }
  def nlg-prefill-more(model,ctx,ids,pos,events,t) {
   let next = nlg-forward-next(model,ctx,take(t,ids),pos,events,"prefill");
   nlg-prefill(model,ctx,drop(t,ids),(pos + t),events);
  }
  def nlg-eos(t,id) = (((Comparable) id == nlt-special(t,"<|eot_id|>")) || ((Comparable) id == nlt-special(t,"<|end_of_text|>")));
  // Result: text, reason (empty only on EOS), emitted count, final context, event file.
  def nlg-result(text,why,n,ctx,events) = [if ((String) why == "adapted-repeat") then nlg-complete(text) else text,why,n,ctx,events];
  def nlg-stream(stream,text) = if ((Comparable) str_len(stream) == 0) then 0 else sbt-append(stream,text);
  def nlg-want-capacity(prompt-n,limit) = (prompt-n + (if (limit > 0) then limit else 16));
  def nlg-admit-capacity(want,maxpos) = if (want > maxpos) then maxpos else want;
  def nlg-floor-capacity(prompt-n) = (prompt-n + 1);
  def nlg-shrink-capacity(capacity,prompt-n) {
   let floor = nlg-floor-capacity(prompt-n);
   if (capacity <= floor) then floor else nlg-max(floor,(capacity / 2));
  }
  def nlg-drop(xs,n) = if ((n <= 0) || nil?(xs)) then xs else nlg-drop(tail(xs),(n - 1));
  def nlg-take-last(xs,n) {
   let d = (len(xs) - n);
   if (d <= 0) then xs else nlg-drop(xs,d);
  }
  def nlg-slide-n(ids) {
   let n = len(ids);
   if (n <= 1) then n else nlg-max(1,(n / 2));
  }
  // Retain each emitted ID alongside the current context's IDs.
  def nlg-remember(ids,id) = append(ids,[id]);
  def nlg-grown-limit(limit,maxpos,pos) {
   if (limit <= 0) then 0 else nlg-grown-limit-room(limit,(maxpos - pos));
  }
  // An allowance grows toward the end of a sentence; the growing itself has an
  // end. Left to double into the room the context leaves, a voice that neither
  // repeats nor reaches an ending will run until the context is full: on
  // 2026-09-23 a walk asked for 512 and was still speaking sixteen hours later,
  // holding eleven gigabytes, with no answer written because an answer is only
  // written when generation returns. Past the reach the allowance stops growing
  // and the answer is given as it stands, which is what token-limit already
  // means. An asking larger than the reach is honoured as asked; it is only the
  // growing that stops here.
  def nlg-reach() = 4096;
  def nlg-grown-limit-room(limit,room) {
   if (room <= limit) then limit else if (limit >= nlg-reach()) then limit else nlg-min(nlg-reach(),if ((limit * 2) > room) then room else (limit * 2));
  }
  def nlg-repeat-min-bytes() = 24;
  def nlg-repeat-max-period() = 256;
  def nlg-repeat-window() = (2 * nlg-repeat-max-period());
  def nlg-repeat-copies(period) = if (period >= nlg-repeat-min-bytes()) then 2 else nlg-max(3,((nlg-repeat-min-bytes() + (period - 1)) / period));
  def nlg-repeat-space(b) = ((((Comparable) b == 32) || ((Comparable) b == 9)) || (((Comparable) b == 10) || ((Comparable) b == 13)));
  def nlg-repeat-content(s,i,end) = if (i >= end) then 0 else if nlg-repeat-space(str_byte_at(s,i)) then nlg-repeat-content(s,(i + 1),end) else 1;
  def nlg-repeat-equal(s,period,start,end) = ((String) substring(s,start,(end - period)) == substring(s,(start + period),end));
  def nlg-repeat-at(s,period,end) {
   let start = (end - (period * nlg-repeat-copies(period)));
   if (start < 0) then 0 else (nlg-repeat-content(s,(end - period),end) && nlg-repeat-equal(s,period,start,end));
  }
  def nlg-repeat-periods(s,period,end) {
   if ((period > nlg-repeat-max-period()) || ((period * 2) > end)) then 0
   else if nlg-repeat-at(s,period,end) then 1 else nlg-repeat-periods(s,(period + 1),end);
