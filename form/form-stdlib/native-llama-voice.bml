  def nlg-looping-tail(s) = nlg-repeat-periods(s,1,str_len(s));
  def nlg-lower-byte(b) = if ((b >= 65) && (b <= 90)) then (b + 32) else b;
  // Copies of one loop can differ only where a line wraps. Fold case and every
  // whitespace run to one space before reading the period; words are copied whole.
  def nlg-fold(s) = nlg-fold-from(s,0,str_len(s),"",0);
  def nlg-fold-from(s,i,n,acc,gap) = if (i >= n) then acc else if nlg-repeat-space(str_byte_at(s,i)) then nlg-fold-from(s,(i + 1),n,if gap then acc else str_concat(acc," "),1) else nlg-fold-word(s,i,nlg-word-end(s,i,n),n,acc);
  def nlg-fold-word(s,i,j,n,acc) = nlg-fold-from(s,j,n,str_concat(acc,nlg-lower-run(substring(s,i,j),0,"")),0);
  def nlg-word-end(s,i,n) = if (i >= n) then i else if nlg-repeat-space(str_byte_at(s,i)) then i else nlg-word-end(s,(i + 1),n);
  def nlg-lower-run(w,i,acc) = if (i >= str_len(w)) then acc else nlg-lower-run(w,(i + 1),str_concat(acc,byte_to_str(nlg-lower-byte(str_byte_at(w,i)))));
