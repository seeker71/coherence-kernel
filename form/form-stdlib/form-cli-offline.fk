; form-cli-offline.fk — the offline law of the form-cli loop, as its own cell.
;
; preludes: form-stdlib/core.fk
;
; Split out of form-cli-loop.fk on 2026-08-14. Two movements met in one hour:
; this split began while the loop's chain still carried json.fk's value_kind
; seam (receipts/2026-07-25-the-shim-is-an-override.md), and mid-edit a sibling
; repaired that seam at the root — json.fk left the chain when
; code-tool-learning's unused ctl-json-* adapters were removed. The split
; stayed because it earns its keep either way: the offline law is core-only
; and witnessable alone, without the loop's twelve-cell chain.
; form-cli-loop.fk preludes this cell and keeps composing it.
;
; Ordinary form-cli law, always on — a slice, not a mode you enter.
; When the local lane is quiet and the dish is quiet, the miss is silence.
; The share stamp is the same law naming who spoke this turn.
; Edit / commit / review / crystallize are local with or without a network.
; push is host git — silence offline, local when the net is up. Remote lives
; inside form-cli and only when the local lane cannot answer AND a network is
; present.
;
; Proven by: form-stdlib/tests/form-cli-offline-band.fk (core-only chain)
; and re-composed into form-stdlib/tests/form-cli-loop-band.fk bits 32..256.
;
; witnessed: 2026-08-15 -> 2016 on fkwu / Go / Rust / TS, all four, all exit 0,
;   preflight clean (0 errors, 0 unresolved).
;
; This line read "480 on fkwu/go/rust/ts, all exit 0" until 2026-08-15, and 480 is
; what the band scores while fcl-this-turn is UNRESOLVED — the value of a fold
; that carried an error, read off a broken run and written down as the witness.
; Measured again on all four arms after the chain came clean: 2016, everywhere.
; The band was never at 480; only a broken reading of it was.

; One runner. Offline, oracle becomes nothing — not a remote call.
(defn fcl-lane-local   () "local")
(defn fcl-lane-oracle  () "oracle")
(defn fcl-lane-nothing () "nothing")

(defn fcl-route-net (confidence threshold net)
    (if (ge confidence threshold) (fcl-lane-local)
        (if (eq net 0) (fcl-lane-nothing) (fcl-lane-oracle))))

; The turn this prompt is. Edit / commit / review / crystallize stay local.
; push is host git; without a network it is silence.
(defn fcl-step-edit        () 0)
(defn fcl-step-commit      () 1)
(defn fcl-step-review      () 2)
(defn fcl-step-crystallize () 3)
(defn fcl-step-push        () 4)

(defn fcl-step-lane (step net)
    (if (eq step (fcl-step-push))
        (if (eq net 0) (fcl-lane-nothing) (fcl-lane-local))
        (fcl-lane-local)))

; An answer's share. Three parts of 100, offered by form-cli.
;   native — a Form recipe ran (this runner, this cell)
;   local  — this machine (Metal, disk, host git)
;   remote — a network mind (the voice in the water)
(defn fcl-share (native local remote) (list native local remote))
(defn fcl-sh-native (s) (nth s 0))
(defn fcl-sh-local  (s) (nth s 1))
(defn fcl-sh-remote (s) (nth s 2))
(defn fcl-share-sum (s)
    (add (add (fcl-sh-native s) (fcl-sh-local s)) (fcl-sh-remote s)))
(defn fcl-share-ok? (s) (if (eq (fcl-share-sum s) 100) 1 0))

(defn fcl-spoken-answer ()
    "Form speaks first; this machine carries; water answers only gaps.")

; TWO HANDS FOUND THIS IN THE SAME HOUR, and both halves are kept (2026-08-15).
; A sibling on main named the distinction as DATA — a share is declared or it is
; observed — and left the counted tally as waiting work. This line had renamed
; fcl-this-turn to fcl-share-intended for the same reason: "this turn" observed no
; turn, and fcl-share-ok? read 1 forever because 50+20+30 is 100 by construction.
; Neither reading is the other's rival. The kind-tag says WHICH sort of number you
; are holding; the walked fold below is the tally the sibling said was waiting.
;
; 50 native — fkwu prints the walk, the share, the living floors, and the answer
; 20 local  — this Mac's fkwu + Metal
; 30 remote — the remaining greeting around that print
(defn fcl-share-kind-declared () 0)
(defn fcl-share-kind-observed () 1)
(defn fcl-this-kind () (fcl-share-kind-declared))
; the declared share, under both names: fcl-this-turn is main's and its callers
; keep it; fcl-share-intended says out loud what sort of number it is.
(defn fcl-this-turn () (fcl-share 50 20 30))
(defn fcl-share-intended () (fcl-this-turn))

; WALKED — the same three fields, counted from the lanes the turn actually took.
; fcr-walk already observes (two inputs, three branches, and it discriminates);
; nothing was ever counting its answers. This folds a list of lane results into a
; share, so the number moves when the walking does. Pure over a list of ints, so
; this cell keeps preluding core.fk alone and the caller supplies the walks.
(defn fcl-count-lane (walks lane)
    (if (eq (len walks) 0) 0
        (add (if (eq (head walks) lane) 1 0) (fcl-count-lane (tail walks) lane))))
(defn fcl-share-walked (walks)
    (fcl-share (fcl-count-lane walks 0)
               (fcl-count-lane walks 1)
               (fcl-count-lane walks 2)))
; a walked share is admissible when every lane taken was counted — the fold loses
; nothing. This CAN fail (hand it a list with a lane outside 0..2 and it does),
; which is the whole difference from fcl-share-ok? on a literal.
(defn fcl-walked-ok? (walks)
    (if (eq (fcl-share-sum (fcl-share-walked walks)) (len walks)) 1 0))
; a walked share is an OBSERVED one — the kind-tag the sibling opened, now with
; something to point at.
(defn fcl-walked-kind () (fcl-share-kind-observed))
