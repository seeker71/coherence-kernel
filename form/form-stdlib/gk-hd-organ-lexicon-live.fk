; gk-hd-organ-lexicon-live.fk — how many GK/HD words the field now holds.
;
; preludes: form-stdlib/core.fk form-stdlib/guidance-channel.fk form-stdlib/iching-channel.fk form-stdlib/codon-rings.fk form-stdlib/gk-hd-organ-lexicon.fk

(do
    (print "ghl-live unique-words=")
    (print (int_to_str (ghl-word-count)))
    (print " gates=")
    (print (int_to_str (ic64-seeded)))
    (print " rings=")
    (print (int_to_str (len (ghl-rings))))
    (print "\n")
    (print "ghl-live 48=")
    (print (gk-key-speak 48))
    (print "\n")
    (print "ghl-live 21=")
    (print (gk-key-speak 21))
    (print "\n")
    (print "ghl-live 40=")
    (print (gk-key-speak 40))
    (print "\n")
    (print "ghl-live 1 ic=")
    (print (ic-hexagram-speak 1))
    (print "\n")
    0)
