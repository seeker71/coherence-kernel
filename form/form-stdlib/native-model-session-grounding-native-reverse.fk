; native-model-session-grounding-native-reverse.fk -- reverse latest-pair
; cursor over already-bounded root sessions.
;
; The forward minimizer remains a public reference recipe that can count every
; pair.  This separately cacheable live carrier observes only the newest
; completed pair from each selected session, then chooses the newest of those
; local observations.  Raw language remains transient inside Form.
; preludes: form-stdlib/native-model-session-grounding-native-reverse-cursor.fk form-stdlib/native-model-session-grounding-native-reverse-state.fk

(do
    (defn nmsgn-scan-sessions-reverse-loop
        (sessions state started session-index)
        (if (eq (len sessions) 0) state
            (do
                (let session (head sessions))
                (let address (nmsgn-session-address session))
                (let path (nmsgn-session-path session))
                (let recorded-mtime (nmsgn-session-mtime session))
                (let current-mtime (fs-stat-mtime path))
                (if (not (eq current-mtime recorded-mtime))
                    (do
                        (let abstained
                            (lcfb-call-stream "native-session-grounding"
                                "session-pair-reverse" "abstain" "form-native"
                                "tail-identity-changed-before-scan"
                                (lcfb-resource-target
                                    (str_concat address ":changed"))
                                (add 60000 (mul session-index 2)) started
                                "form/form-stdlib/native-model-session-grounding-native-reverse.fk"
                                23 21))
                        (nmsgn-scan-sessions-reverse-loop (tail sessions) state
                            started (add session-index 1)))
                    (do
                        (let size (fs-stat-size path))
                        (let entered
                            (lcfb-call-stream "native-session-grounding"
                                "session-pair-reverse" "enter" "form-native"
                                "latest-pair-from-unchanged-tail"
                                (lcfb-resource-target (nmsgn-cat
                                    (list address ":" (int_to_str size))))
                                (add 60000 (mul session-index 2)) started
                                "form/form-stdlib/native-model-session-grounding-native-reverse.fk"
                                36 21))
                        (let local
                            (nmsgn-scan-session-reverse-loop path size 0 ""
                                address started 0))
                        (let stable-after
                            (eq (fs-stat-mtime path) recorded-mtime))
                        (let next-state
                            (if stable-after
                                (nmsgn-pairs-merge-latest state local) state))
                        (let left
                            (lcfb-call-stream "native-session-grounding"
                                "session-pair-reverse"
                                (if stable-after "leave" "abstain")
                                "form-native"
                                (if stable-after
                                    "latest-pair-from-unchanged-tail"
                                    "tail-identity-changed-during-scan")
                                (lcfb-resource-target (nmsgn-cat
                                    (list address ":"
                                        (if stable-after "stable" "changed")
                                        ":"
                                        (int_to_str
                                            (nmsgn-pairs-completed local)))))
                                (add 60001 (mul session-index 2)) started
                                "form/form-stdlib/native-model-session-grounding-native-reverse.fk"
                                53 21))
                        (nmsgn-scan-sessions-reverse-loop (tail sessions)
                            next-state started (add session-index 1)))))))
    (defn nmsgn-scan-sessions-reverse (sessions started)
        (nmsgn-scan-sessions-reverse-loop sessions (nmsgn-empty-pairs)
            started 0))
    (defn nmsgn-count-unchanged-sessions (sessions)
        (if (eq (len sessions) 0) 0
            (add
                (if (eq (fs-stat-mtime (nmsgn-session-path (head sessions)))
                        (nmsgn-session-mtime (head sessions))) 1 0)
                (nmsgn-count-unchanged-sessions (tail sessions)))))
    (defn nmsgn-count-changed-sessions (sessions)
        (sub (len sessions) (nmsgn-count-unchanged-sessions sessions)))
    0)
