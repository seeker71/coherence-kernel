; source-compiler.fk - Form-native source section compiler
;
; preludes: form-stdlib/core.fk form-stdlib/form-ontology-source-categories.fk form-stdlib/engine.fk form-stdlib/compiler-objects.fk form-stdlib/bmf-grammar.fk form-stdlib/bml-source.fk form-stdlib/bml.fk form-stdlib/form-bml-lower.fk
;
; This module is runtime tissue above the kernel. It reads source text and
; lowers first-class BMF sections into ordinary Form source, the text fkwu
; compiles and runs.

;; --- text scanning ------------------------------------------------

    (defn fsc-sub (s a b) (substring s a b))

    (defn fsc-find-string-at-len? (s needle s-len needle-len i j)
        (if (eq j needle-len) true
            (if (ge (add i j) s-len) false
                (if (str_eq (char_at s (add i j)) (char_at needle j))
                    (fsc-find-string-at-len? s needle s-len needle-len i (add j 1))
                    false))))

    (defn fsc-find-string-at? (s needle i j)
        (fsc-find-string-at-len? s needle (str_len s) (str_len needle) i j))

    ;; --- streaming scanners — dispatched to kernel-native `str_find` ---
    ;;
    ;; The earlier recursive scanners (fsc-find-string-from-len,
    ;; fsc-find-char-from-len) blew Go's stack when section bodies grew past
    ;; ~165 BMF rules. The first attempt (string_fold-based) eliminated the
    ;; recursion but moved the cost into per-byte Form-closure dispatch,
    ;; which is too slow when called 800+ times per source-compile run.
    ;;
    ;; The cure: a `str_find` kernel native that does the whole search in
    ;; Go/Rust/JS (one for-loop per call, no Form callback, no recursion).
    ;; This is what `tokenizeSexp` already does internally; we expose it so
    ;; Form code doesn't pay the closure-dispatch tax. The universal-
    ;; translator stream property holds: arbitrary-length input, zero Form
    ;; recursion, constant per-call cost.

    (defn fsc-find-string-from (s needle i)
        (str_find s needle i))

    (defn fsc-contains? (s needle)
        (ge (str_find s needle 0) 0))

    (defn fsc-find-char-from (s ch i)
        (str_find s ch i))

    (defn fsc-find-char-from-len (s ch _s-len i)
        (str_find s ch i))

    (defn fsc-space? (ch)
        (or (str_eq ch " ") (or (str_eq ch "\n") (or (str_eq ch "\t") (str_eq ch "\r")))))

    (defn fsc-skip-spaces (s i)
        (if (ge i (str_len s)) i
            (if (fsc-space? (char_at s i))
                (fsc-skip-spaces s (add i 1))
                i)))

    (defn fsc-rtrim-index (s i)
        (if (le i 0) 0
            (if (fsc-space? (char_at s (sub i 1)))
                (fsc-rtrim-index s (sub i 1))
                i)))

    (defn fsc-trim (s)
        (do
            (let start (fsc-skip-spaces s 0))
            (let end (fsc-rtrim-index s (str_len s)))
            (if (ge start end) "" (fsc-sub s start end))))

    (defn fsc-line-end (s i)
        (do
            (let e (fsc-find-char-from s "\n" i))
            (if (lt e 0) (str_len s) e)))

    (defn fsc-line-next (s i)
        (do
            (let e (fsc-line-end s i))
            (if (lt e (str_len s)) (add e 1) e)))

    (defn fsc-section-end (s i)
        (fsc-section-brace-end s i 0))

    ;; BMF/custom sections carry rule data. Words such as do/end and pattern
    ;; parentheses do not introduce executable BML scope in that data.
    (defn fsc-section-brace-end (s i depth)
        (do
            (let p (fsc-bml-skip-trivia s i (str_len s)))
            (if (ge p (str_len s))
                (fsc-compiler-error "section not closed before end of source")
                (do
                    (let after (fsc-bml-token-after s p (str_len s)))
                    (let token (fsc-sub s p after))
                    (if (str_eq token "{")
                        (fsc-section-brace-end s after (add depth 1))
                        (if (str_eq token "}")
                            (if (eq depth 0) p
                                (fsc-section-brace-end s after (sub depth 1)))
                            (fsc-section-brace-end s after depth)))))))

    ;; --- output strings ----------------------------------------------

    (defn fsc-quote-loop (s i)
        (if (ge i (str_len s)) ""
            (do
                (let ch (char_at s i))
                (let rest (fsc-quote-loop s (add i 1)))
                (if (str_eq ch "\\") (str_concat "\\\\" rest)
                (if (str_eq ch "\"") (str_concat "\\\"" rest)
                    (str_concat ch rest))))))

    (defn fsc-q (s)
        (str_concat "\"" (str_concat (fsc-quote-loop s 0) "\"")))

    (defn fsc-word-char? (ch)
        (do
            (let cp (ord ch))
            (or (and (ge cp 65) (le cp 90))
            (or (and (ge cp 97) (le cp 122))
            (or (and (ge cp 48) (le cp 57))
            (or (str_eq ch "_") (str_eq ch "-")))))))

    (defn fsc-word-start-char? (ch)
        (do
            (let cp (ord ch))
            (or (and (ge cp 65) (le cp 90))
            (or (and (ge cp 97) (le cp 122))
            (or (and (ge cp 48) (le cp 57))
                (str_eq ch "_"))))))

    (defn fsc-word-loop? (s i)
        (if (ge i (str_len s)) true
            (if (fsc-word-char? (char_at s i))
                (fsc-word-loop? s (add i 1))
                false)))

    (defn fsc-word? (s)
        (if (gt (str_len s) 0)
            (and (fsc-word-start-char? (char_at s 0))
                 (fsc-word-loop? s 1))
            false))

    (defn fsc-dialect-fn (dialect suffix)
        (str_concat dialect (str_concat "-" suffix)))

    (defn fsc-lit-fn (dialect value)
        (if (str_eq dialect "bmf")
            (if (fsc-word? value) "bmf-kw" "bmf-op")
            (if (fsc-word? value)
                (fsc-dialect-fn dialect "kw")
                (fsc-dialect-fn dialect "op"))))

    (defn fsc-literal-expr (dialect value)
        (str_concat "("
            (str_concat (fsc-lit-fn dialect value)
            (str_concat " " (str_concat (fsc-q value) ")")))))

    (defn fsc-capture-fn (dialect kind)
        (if (str_eq dialect "bmf")
            (if (str_eq kind "string") "bmf-string-lit"
            (if (str_eq kind "pattern") "bmf-pattern-lit"
            (if (str_eq kind "rules") "bmf-rules-lit" "bmf-name")))
            (if (str_eq kind "int") (fsc-dialect-fn dialect "int-lit")
            (if (str_eq kind "float") (fsc-dialect-fn dialect "float-lit")
            (if (str_eq kind "string") (fsc-dialect-fn dialect "string-lit")
            (if (str_eq kind "char") (fsc-dialect-fn dialect "char-lit")
            (if (str_eq kind "bytes") (fsc-dialect-fn dialect "bytes-lit")
            (if (str_eq kind "fstring") (fsc-dialect-fn dialect "fstring-lit")
            (if (str_eq kind "property") (fsc-dialect-fn dialect "prop")
                (fsc-dialect-fn dialect "name"))))))))))

    (defn fsc-capture-expr (dialect spec)
        (do
            (let colon (fsc-find-char-from spec ":" 0))
            (let name (fsc-sub spec 1 colon))
            (let kind (fsc-sub spec (add colon 1) (str_len spec)))
            (str_concat "("
                (str_concat (fsc-capture-fn dialect kind)
                (str_concat " " (str_concat (fsc-q name) ")"))))))

    (defn fsc-rule-ref-expr (dialect name)
        (str_concat "("
            (str_concat dialect
            (str_concat "-ref " (str_concat (fsc-q name) ")")))))

    (defn fsc-read-quoted-end (s i)
        (do (let end (scan_run s i 4))
            (if (ge end (str_len s)) end
                (if (str_eq (char_at s end) "\"") end
                    (fsc-read-quoted-end s (add end 2))))))

    (defn fsc-read-part-end (s i)
        (if (ge i (str_len s)) i
            (if (fsc-space? (char_at s i)) i
                (fsc-read-part-end s (add i 1)))))

    ;; fsc-skip-rule-line? — used by the Recipe-build path's rules loop.
    (defn fsc-skip-rule-line? (line)
        (if (str_eq line "") true
            (str_eq (char_at line 0) ";")))

    ;; --- Composted ---------------------------------------------------
    ;; The text-build path (fsc-pattern-items-loop, fsc-rule-line,
    ;; fsc-rules-loop, fsc-compile-bmf-section) emitted .fk source text
    ;; while compiling each rule. Each rule cost ~13 nested str_concats; whole
    ;; sections piled hundreds. The Recipe-build path below is the live
    ;; replacement — it constructs Recipe objects via intern_node first. Callers
    ;; can carry those objects directly (recipe_to_bytes/bytes_to_recipe) or ask
    ;; the source emitter for executable Form text when a text artifact is the
    ;; desired lens.
    ;;
    ;; fsc-literal-expr / fsc-capture-expr / fsc-rule-ref-expr were the
    ;; text formatters for the old path; their Recipe equivalents live in
    ;; fsc-pattern-item-recipe + fsc-rec-* helpers (further down). fsc-q
    ;; (defined above near fsc-quote-loop) still serves the high-level Form
    ;; source dialects: form.bml, form.action, and form.route.
    ;; until that path also gets the Recipe treatment.

    ;; --- high-level Form source dialect maintenance ------------------
    ;; These dialects are deliberately above the kernel. They give stdlib,
    ;; compiler, and rule-action code a smaller BML-shaped authoring surface,
    ;; then lower to ordinary Form source before sibling kernels execute
    ;; anything.

    (defn fsc-prefix? (s prefix)
        (fsc-find-string-at? s prefix 0 0))

    (defn fsc-compiler-error (message)
        (form_error (str_concat "source-compile: " message)))

    (defn fsc-compiler-error-line (message line)
        (fsc-compiler-error (str_concat message (str_concat ": " line))))

    (defn fsc-digit? (ch)
        (do
            (let cp (ord ch))
            (and (ge cp 48) (le cp 57))))

    (defn fsc-bml-block-end (body i depth)
        (fsc-bml-span-end body i (str_len body)
            (fsc-bml-brace-stack (add depth 1)) "group"))

    ;; One lexical boundary owns statements, headers and balanced bodies.
    ;; Positions refer to the original source; physical lines carry no scope.
    (defn fsc-bml-brace-stack (depth)
        (if (le depth 0) (empty)
            (cons "}" (fsc-bml-brace-stack (sub depth 1)))))

    (defn fsc-bml-comment-at? (s i)
        (or (fsc-find-string-at? s "//" i 0)
            (and (str_eq (char_at s i) ";")
                 (fsc-section-line-open? s i))))

    (defn fsc-bml-skip-trivia (s i end)
        (if (ge i end) end
            (if (fsc-space? (char_at s i))
                (fsc-bml-skip-trivia s (add i 1) end)
                (if (fsc-bml-comment-at? s i)
                    (fsc-bml-skip-trivia s (fsc-line-next s i) end)
                    i))))

    (defn fsc-bml-punctuation? (ch)
        (or (str_eq ch "(") (or (str_eq ch ")")
        (or (str_eq ch "{") (or (str_eq ch "}")
        (or (str_eq ch "[") (or (str_eq ch "]")
        (or (str_eq ch ";") (or (str_eq ch ",")
            (str_eq ch "="))))))))))

    (defn fsc-bml-token-end (s i end)
        (if (ge i end) end
            (if (or (fsc-space? (char_at s i))
                    (or (fsc-bml-punctuation? (char_at s i))
                        (or (str_eq (char_at s i) "\"")
                            (fsc-find-string-at? s "//" i 0)))) i
                (fsc-bml-token-end s (add i 1) end))))

    (defn fsc-bml-token-after (s i end)
        (if (str_eq (char_at s i) "\"")
            (do
                (let close (fsc-read-quoted-end s (add i 1)))
                (if (ge close end)
                    (fsc-compiler-error "unterminated string in form.bml source")
                    (add close 1)))
            (if (fsc-bml-punctuation? (char_at s i)) (add i 1)
                (fsc-bml-token-end s (add i 1) end))))

    (defn fsc-bml-token-closer (s token after end)
        (if (str_eq token "(") ")"
        (if (str_eq token "{") "}"
        (if (str_eq token "[") "]"
        (if (str_eq token "do")
            (do
                (let next (fsc-bml-skip-trivia s after end))
                (if (or (str_eq (char_at s next) "{")
                        (str_eq (char_at s after) "(")) "" "end"))
            "")))))

    (defn fsc-bml-span-end (s i end stack mode)
        (do
            (let p (fsc-bml-skip-trivia s i end))
            (if (ge p end)
                (if (eq (len stack) 0) end
                    (fsc-compiler-error-line "unclosed form.bml body" (head stack)))
            (do
                (let after (fsc-bml-token-after s p end))
                (let token (fsc-sub s p after))
                (let closer (fsc-bml-token-closer s token after end))
                (if (and (eq (len stack) 0)
                         (and (str_eq mode "header")
                              (or (str_eq token "{")
                                  (or (str_eq token "=") (str_eq token ";"))))) p
                (if (and (eq (len stack) 0)
                         (and (str_eq mode "statement") (str_eq token ";"))) after
                (if (gt (str_len closer) 0)
                    (fsc-bml-span-end s after end (cons closer stack) mode)
                (if (or (str_eq token ")") (or (str_eq token "}")
                        (or (str_eq token "]")
                            (and (str_eq token "end")
                                 (and (gt (len stack) 0) (str_eq (head stack) "end"))))))
                    (if (or (eq (len stack) 0) (not (str_eq token (head stack))))
                        (fsc-compiler-error-line "mismatched form.bml delimiter" token)
                        (if (and (eq (len stack) 1) (str_eq mode "group")) p
                            (fsc-bml-span-end s after end (tail stack) mode)))
                    (fsc-bml-span-end s after end stack mode)))))))))

    (defn fsc-bml-stmt-end (body i end)
        (fsc-bml-span-end body i end (empty) "statement"))

    (defn fsc-high-level-form-dialect? (dialect-name)
        (or (str_eq dialect-name "form.bml")
            (or (str_eq dialect-name "form.action")
                (str_eq dialect-name "form.route"))))

    ;; Local list-reverse — bounded by rule count (~200), not body length.
    ;; engine.fk's `reverse-list` isn't in scope during source-compile pre-pass.

    (defn fsc-empty? (xs) (eq (len xs) 0))

    (defn fsc-rev-into (xs acc)
        (if (fsc-empty? xs) acc
            (fsc-rev-into (tail xs) (cons (head xs) acc))))

    (defn fsc-rev (xs) (fsc-rev-into xs (empty)))

    ;; --- Recipe construction primitives ------------------------------
    ;;
    ;; Each helper builds a Recipe NodeID directly via intern_node (no
    ;; str_concat building source text the kernel re-parses). The shapes
    ;; mirror what the kernel's parser produces internally:
    ;;
    ;;   DO       : intern(catBlock(RBlockDo),    [child1, child2, ...])
    ;;   LET      : intern(catBlock(RBlockLet),   [string-trivial-name, value-recipe])
    ;;   IDENT    : intern(catIdent(),            [string-trivial-name])
    ;;   FNCALL   : intern(catFnCall(),           [ident-callee, arg1, arg2, ...])
    ;;
    ;; Built Recipe is emitted back to executable Form source by the source
    ;; emitter below, so source sections can cross kernel boundaries without a
    ;; binary sidecar. Persistence paths can still serialize Recipe nodes
    ;; deliberately when a cache or artifact is the desired carrier.
    ;; Source: form/form-kernel-go/main.go parseSexp around line 1942 (DO/LET) +
    ;; 2005 (FNCALL) + 1900 (IDENT).

    ;; --- Form ontology helpers — data lives in the kernel-native bp table --
    ;;
    ;; FORM-CATEGORY-TABLE and FORM-PRIMITIVE-TABLE are bound by
    ;; form-stdlib/form-ontology-loader.fk (loaded as a prelude before
    ;; this file). The loader asks the kernel-native bp table for the
    ;; coordinates and walks them into the row shape these helpers
    ;; consume. The authored ontology sources feed the generated bp table;
    ;; source compilation itself does not parse JSON.
    ;;
    ;; List-walk lookup — pure head/tail, no nth/nil? (we run before
    ;; core.fk). Returns the matched row or empty list.
    (defn form-table-lookup (table name)
        (if (fsc-empty? table) (empty)
            (if (str_eq (head (head table)) name)
                (head table)
                (form-table-lookup (tail table) name))))

    (defn form-row-type (row) (head (tail row)))
    (defn form-row-inst (row) (head (tail (tail row))))

    (defn form-cat-node (name)
        (do
            (let row (form-table-lookup FORM-CATEGORY-TABLE name))
            (make_nodeid 1 2 (form-row-type row) (form-row-inst row))))

    (defn form-prim-or-empty (name)
        (form-table-lookup FORM-PRIMITIVE-TABLE name))

    (defn form-prim-node (row)
        (make_nodeid 1 2 (form-row-type row) (form-row-inst row)))

    ;; Bind the common categories so emit sites read like names, not
    ;; table walks. The table is still the source — these are just the
    ;; rows resolved once at load time.
    (let fsc-rec-DO-CAT     (form-cat-node "do"))
    (let fsc-rec-LET-CAT    (form-cat-node "let"))
    (let fsc-rec-FNCALL-CAT (form-cat-node "fncall"))
    (let fsc-rec-IDENT-CAT  (form-cat-node "ident"))

    (defn fsc-rec-ident (name)
        (intern_node fsc-rec-IDENT-CAT (list (intern_trivial_string name))))

    (defn fsc-rec-let (name value-recipe)
        (intern_node fsc-rec-LET-CAT (list (intern_trivial_string name) value-recipe)))

    (defn fsc-rec-do (children-list)
        (intern_node fsc-rec-DO-CAT children-list))

    (defn fsc-rec-call (fn-name arg-recipes)
        (intern_node fsc-rec-FNCALL-CAT (cons (fsc-rec-ident fn-name) arg-recipes)))

    (defn fsc-rec-list-of (item-recipes)
        (fsc-rec-call "list" item-recipes))

    (defn fsc-rec-string (s)
        (intern_trivial_string s))

    (defn fsc-rec-string-list-items (xs)
        (if (fsc-empty? xs) (empty)
            (cons (fsc-rec-string (head xs))
                  (fsc-rec-string-list-items (tail xs)))))

    (defn fsc-rec-string-list (xs)
        (fsc-rec-list-of (fsc-rec-string-list-items xs)))

    ;; --- BMF section as Recipe ---------------------------------------
    ;;
    ;; Each rule line of a grammar section becomes a Recipe node directly; the
    ;; list of rule recipes becomes the value of the X-bmf-rules let.

    (defn fsc-pattern-item-recipe (dialect pattern i)
        (do
            (let p (fsc-skip-spaces pattern i))
            (if (ge p (str_len pattern)) (fsc-rec-call "empty" (list (intern_trivial_int 0)))
                (if (str_eq (char_at pattern p) "\"")
                    (do
                        (let e (fsc-read-quoted-end pattern (add p 1)))
                        (let value (fsc-sub pattern (add p 1) e))
                        (list (fsc-rec-call (fsc-lit-fn dialect value)
                                            (list (fsc-rec-string value)))
                              (add e 1)))
                    (do
                        (let e (fsc-read-part-end pattern p))
                        (let part (fsc-sub pattern p e))
                        (if (str_eq (char_at part 0) "$")
                            (do
                                (let colon (fsc-find-char-from part ":" 0))
                                (let name (fsc-sub part 1 colon))
                                (let kind (fsc-sub part (add colon 1) (str_len part)))
                                (list (fsc-rec-call (fsc-capture-fn dialect kind)
                                                    (list (fsc-rec-string name)))
                                      e))
                            (list (fsc-rec-call (fsc-dialect-fn dialect "ref")
                                                (list (fsc-rec-string part)))
                                  e)))))))

    (defn fsc-pattern-items-recipes (dialect pattern i acc)
        (do
            (let p (fsc-skip-spaces pattern i))
            (if (ge p (str_len pattern)) (fsc-rev acc)
                (do
                    (let result (fsc-pattern-item-recipe dialect pattern p))
                    (fsc-pattern-items-recipes dialect pattern
                                               (head (tail result))
                                               (cons (head result) acc))))))

    (defn fsc-rule-line-recipe (dialect line)
        (do
            (let sep (fsc-find-string-from line "::=" 0))
            (let arr (fsc-find-string-from line " => " sep))
            (let semi (fsc-find-char-from line ";" arr))
            (let rev (fsc-find-string-from line " <= " arr))
            (let name (fsc-trim (fsc-sub line 0 sep)))
            (let pattern (fsc-trim (fsc-sub line (add sep 3) arr)))
            (let action-end (if (and (ge rev 0) (lt rev semi)) rev semi))
            (let action (fsc-trim (fsc-sub line (add arr 4) action-end)))
            (let reverse (if (and (ge rev 0) (lt rev semi))
                             (fsc-trim (fsc-sub line (add rev 4) semi))
                             "bmf-default-reverse-emitter"))
            (let pattern-recipes (fsc-pattern-items-recipes dialect pattern 0 (empty)))
            (let sequence-recipe (fsc-rec-call "list"
                                               (cons (fsc-rec-string "sequence")
                                                     pattern-recipes)))
            (fsc-rec-list-of (list
                (fsc-rec-string name)
                sequence-recipe
                (fsc-rec-ident action)
                (fsc-rec-ident "bmf-identity-inverse")
                (fsc-rec-ident reverse)))))

    (defn fsc-rules-recipes-loop (dialect body i acc)
        (if (ge i (str_len body)) (fsc-rev acc)
            (do
                (let e (fsc-line-end body i))
                (let line (fsc-trim (fsc-sub body i e)))
                (let next-i (fsc-line-next body i))
                (if (fsc-skip-rule-line? line)
                    (fsc-rules-recipes-loop dialect body next-i acc)
                    (fsc-rules-recipes-loop dialect body next-i
                                            (cons (fsc-rule-line-recipe dialect line)
                                                  acc))))))

    (defn fsc-bmf-section-recipe (dialect-name body)
        (do
            (let dot (fsc-find-char-from dialect-name "." 0))
            (let dialect (fsc-sub dialect-name 0 dot))
            (let rules-name (str_concat dialect "-bmf-rules"))
            (let second-name (str_concat dialect "-bmf-second"))
            (let rule-recipes (fsc-rules-recipes-loop dialect body 0 (empty)))
            (let rules-list-recipe (fsc-rec-call "list" rule-recipes))
            (let second-value-recipe (fsc-rec-call "form-bmf-second" (list
                (fsc-rec-string dialect)
                (fsc-rec-call "bmf-section" (list
                    (fsc-rec-string dialect-name)
                    (fsc-rec-ident rules-name))))))
            (fsc-rec-do (list
                (fsc-rec-let rules-name rules-list-recipe)
                (fsc-rec-let second-name second-value-recipe)))))

    ;; --- high-level Form source section as Recipe -------------------
    ;;
    ;; The cursor reads a section into Recipe nodes: a DO Recipe over LET / FNDEF /
    ;; FNCALL children, which a single emitter turns back into executable Form
    ;; source for the next kernel.
    ;;
    ;; Categories (source: form-kernel-go/main.go parseSexp + walker):
    ;;   FNDEF (1 2 31 1): kids [trivial-string-name, SEQUENCE-of-trivial-
    ;;     strings (params), body-recipe]; walker ~1645 reads NameID
    ;;     straight from p.Inst on each param trivial — params must be
    ;;     trivial-strings, not IDENT-wrapped.
    ;;   IF3   (1 2 11 2): kids [cond, yes, no]
    ;;   SEQ   (1 2 9 2): block sequence (used for param-list)
    ;;   TrivBool (Level 1, Type 3): Inst 1=true, 0=false — bool literals
    ;;     bypass the env at parse time per main.go:1908.

    (let fsc-rec-FNDEF-CAT (form-cat-node "fndef"))
    (let fsc-rec-IF3-CAT   (form-cat-node "if"))
    (let fsc-rec-MATCH-CAT (form-cat-node "match"))
    (let fsc-rec-SEQ-CAT   (form-cat-node "sequence"))

    (defn fsc-rec-true ()  (intern_trivial_bool true))
    (defn fsc-rec-if3 (cond yes no)
        (intern_node fsc-rec-IF3-CAT (list cond yes no)))

    (defn fsc-rec-match-switch (children)
        (intern_node fsc-rec-MATCH-CAT children))

    ;; Param list: SEQUENCE of trivial-strings (NOT IDENT-wrapped).
    (defn fsc-rec-param-trivials (names)
        (if (fsc-empty? names) (empty)
            (cons (intern_trivial_string (head names))
                  (fsc-rec-param-trivials (tail names)))))

    (defn fsc-rec-fndef (name param-names body-recipe)
        (intern_node fsc-rec-FNDEF-CAT (list
            (intern_trivial_string name)
            (intern_node fsc-rec-SEQ-CAT (fsc-rec-param-trivials param-names))
            body-recipe)))


    ;; --- names and primitives the cursor's lowering asks of the compiler ---
    ;;
    ;; `form.route` and `form.action` read through the cursor like `form.bml`.
    ;; Shared source cells live in bml-source.fk.

    (defn fsc-bml-class-member-name (class-name member-name)
        (str_concat class-name (str_concat "_" member-name)))

    ;; Math/compare/logic primitives are parser SPECIAL FORMS in the
    ;; kernel — there's no env binding for `gt`, `add`, etc. Look the
    ;; name up in FORM-PRIMITIVE-TABLE; if present, lift to the typed
    ;; category; otherwise fall through to a real FNCALL.
    (defn fsc-rec-form-call (name args)
        (do
            (let prim-row (form-prim-or-empty name))
            (if (fsc-empty? prim-row)
                (fsc-rec-call name args)
                (intern_node (form-prim-node prim-row) args))))

    (defn fsc-bml-intrinsic-table (rows key table)
        (if (nil? rows) table
            (fsc-bml-intrinsic-table (tail rows) key (record_set table (nth (head rows) key) (head rows)))))
    (let FSC-BML-INTRINSICS (fsc-bml-intrinsic-table (form-bml-intrinsics) 0 (record_new 0)))
    (let FSC-BML-OWNERS (fsc-bml-intrinsic-table (form-bml-intrinsics) 1 (record_new 0)))
    (let FSC-BML-AND (form-prim-node (form-prim-or-empty "and")))
    (let FSC-BML-OR (form-prim-node (form-prim-or-empty "or")))
    (defn fsc-bml-call (name args)
        (do (let row (record_get FSC-BML-INTRINSICS name))
            (if (value_eq row 0) (fsc-rec-form-call name args) (fsc-rec-call name args))))
    (defn fsc-bml-call-arity (recipe)
        (do (let cat (node_category recipe)) (let kids (node_children recipe))
            (let boolean (or (node_eq cat FSC-BML-AND) (node_eq cat FSC-BML-OR)))
            (let row (if (node_eq cat fsc-rec-FNCALL-CAT) (record_get FSC-BML-OWNERS (fsc-bml-type-name (head kids))) 0))
            (let expected (if boolean 2 (if (value_eq row 0) -1 (nth row 2))))
            (let count (if boolean (len kids) (sub (len kids) 1)))
            (if (and (ge expected 0) (ne count expected))
                (fsc-compiler-error-line
                    (str_concat (if boolean "form.bml boolean call requires " "form.bml intrinsic call requires ")
                        (str_concat (int_to_str expected) (str_concat " arguments; got " (int_to_str count))))
                    (value_str recipe)) recipe)))
    (defn fsc-bml-apply (callee args)
        (if (node_eq (node_category callee) fsc-rec-IDENT-CAT)
            (fsc-bml-call (fsc-bml-type-name callee) args)
            (fsc-rec-do (list (fsc-rec-let "$callee" callee) (fsc-rec-call "$callee" args)))))
    ;; A pipeline owns its input once, before the stage's arguments. Library
    ;; functions and native operations receive it as their final argument.
    (defn fsc-bml-pipe (input stage)
        (do (let held (fsc-rec-ident "$pipe"))
            (let kids (node_children stage)) (let cat (node_category stage))
            (let call
                (if (node_eq cat fsc-rec-IDENT-CAT)
                    (fsc-bml-call (fsc-bml-type-name stage) (list held))
                (if (node_eq cat fsc-rec-FNCALL-CAT)
                    (if (str_eq (fsc-bml-type-name (head kids)) "$bml-lambda")
                        (fsc-rec-do (list (fsc-rec-let "$stage" stage) (fsc-rec-call "$stage" (list held))))
                        (fsc-bml-call (fsc-bml-type-name (head kids)) (append (tail kids) (list held))))
                    (if (str_eq (fsc-source-primitive-name cat) "")
                        (fsc-compiler-error "form.bml pipeline stage needs a function name, lambda or call")
                        (intern_node cat (append kids (list held)))))))
            (fsc-rec-do (list (fsc-rec-let "$pipe" input) call))))

    (defn fsc-bml-contract-name (name)
        (do (let binding (fsc-bml-binding name))
            (if (str_eq (nth binding 1) "") (head binding)
                (str_concat (head binding) (str_concat ":" (nth binding 1))))))
    (defn fsc-bml-lambda (params body)
        (fsc-rec-call "$bml-lambda" (list (fsc-rec-do (fsc-rec-param-trivials (map fsc-bml-contract-name params))) body)))
    ;; Anonymous functions become ordinary lexical defs before comparison and
    ;; capture lowering. Identity includes the unit and occurrence, so equal
    ;; lambda text in different scopes never shares a capture layout.
    (defn fsc-bml-expand-list (recipes state prefix)
        (if (nil? recipes) (empty)
            (cons (fsc-bml-expand-in (head recipes) state prefix) (fsc-bml-expand-list (tail recipes) state prefix))))
    (defn fsc-bml-expand-in (raw state prefix)
        (do (let recipe (fsc-bml-call-arity raw)) (let kids (node_children recipe)) (let cat (node_category recipe))
            (if (nil? kids) recipe
                (if (and (node_eq cat fsc-rec-FNCALL-CAT) (str_eq (fsc-bml-type-name (head kids)) "$bml-lambda"))
                    (do (let id (record_get state "next")) (record_set state "next" (add id 1))
                        (let name (str_concat prefix (str_concat "-" (int_to_str id))))
                        (fsc-rec-do (list
                            (fsc-rec-fndef name (fbl-names (node_children (nth kids 1))) (fsc-bml-expand-in (nth kids 2) state prefix))
                            (fsc-rec-ident name))))
                    (intern_node cat (fsc-bml-expand-list kids state prefix))))))
    (defn fsc-bml-expand (recipe)
        (fsc-bml-expand-in recipe (record_new 0) (str_concat "$lambda-" (value_str (fsc-bml-erased recipe)))))

    ;; ── the recover point and absence, lifted into BML ──────────────────
    ;; `x ?? y`, `try e else h` and `choose { e1; e2; ... }` lower to one shape:
    ;; hold the first value, and only when it is nothing walk the next. The next
    ;; recipe is a branch of the if, so an option not needed is never walked.
    ;;   (do (let <hold> first) (if (nothing? <hold>) next <hold>))
    ;; `try` and `choose` hold (attempt e): a stop inside e unwinds to it and reads
    ;; as nothing, so the next option answers; `??` holds x itself. A name is already
    ;; held, so `n ?? d` is the plain if -- no temporary between the reading and its test.
    (defn fsc-bml-when-nothing (hold first next)
        (if (node_eq (node_category first) fsc-rec-IDENT-CAT)
            (fsc-rec-if3 (fsc-rec-form-call "nothing?" (list first)) next first)
            (fsc-rec-do (list
                (fsc-rec-let hold first)
                (fsc-rec-if3 (fsc-rec-form-call "nothing?" (list (fsc-rec-ident hold)))
                             next
                             (fsc-rec-ident hold))))))
    (defn fsc-bml-attempt (e) (fsc-rec-call "attempt" (list e)))

    ;; every option of a choose is attempted in order; none landing is nothing
    (defn fsc-bml-choose-chain (options)
        (if (nil? options) (fsc-rec-call "nothing" (empty))
            (if (nil? (tail options)) (fsc-bml-attempt (head options))
                (fsc-bml-when-nothing "$choose" (fsc-bml-attempt (head options))
                    (fsc-bml-choose-chain (tail options))))))
    (defn fsc-bml-expression-name-loop? (s i)
        (if (ge i (str_len s)) true
            (do
                (let ch (char_at s i))
                (if (or (fsc-word-char? ch)
                        (or (str_eq ch "?") (or (str_eq ch "!")
                        (or (str_eq ch ".") (or (str_eq ch ":")
                        (or (str_eq ch "+") (or (str_eq ch "*")
                        (or (str_eq ch "/") (str_eq ch "%")))))))))
                    (fsc-bml-expression-name-loop? s (add i 1)) false))))

    (defn fsc-bml-expression-name? (s)
        (and (gt (str_len s) 0) (fsc-bml-expression-name-loop? s 0)))

    ;; --- plain generic stdlib class ----------------------------------
    ;;
    ;; A plain generic class `class Name<T,...> { def m(params) = expr; ... }`
    ;; (no `: Template` extension) is an organizing abstraction over stdlib
    ;; recipes. Its methods hoist to BARE top-level fndefs — built by the SAME
    ;; def lowerers a flat `def` rides, so the executable recipe is node-for-
    ;; node identical to writing those defs at the section top level. Callers
    ;; keep using the bare names; the type parameter is a contract that erases.
    ;; The class name also binds to a structural abstraction descriptor —
    ;; a nullary global `(defn Name () (list "abstraction" Name (type-params)
    ;; (member-names)))`, read as `(Name)`. A top-level `let` would leak its
    ;; binding to global scope on three kernels but stay `do`-scoped on fkwu
    ;; (the correct reading), so the descriptor rides a `defn` like every other
    ;; core binding — global and portable across all four arms.

    ;; A class member is a method (def), a field, a ref, or a thought. Methods
    ;; hoist to bare fndefs (reusing the flat def lowerers verbatim = node_eq to
    ;; the flat form). field / ref / thought each bind a nullary global
    ;; (defn NAME () <expr>): a field holds embedded knowledge (a constant), a
    ;; ref points at another cell, a thought computes derived knowledge. They
    ;; read as NAME(); the kind is recorded in the descriptor so the abstraction
    ;; DECLARES its structure (its knowledge), not just its callables.

    (defn fsc-bml-member? (xs name)
        (if (fsc-empty? xs) 0
            (if (str_eq (head xs) name) 1
                (fsc-bml-member? (tail xs) name))))

    (defn fsc-compile-form-bml-section-recipe (body first-line)
        (head (fsc-bml-typed (fsc-rec-do (fbl-section-recipes body first-line)) (empty) (empty))))

    ;; Declared comparison contracts are compiler metadata, never runtime
    ;; wrappers. They choose an equality relationship, not a representation or
    ;; a general type checker. Direct primitive calls retain their own meaning.
    (defn fsc-bml-comparison-type? (name)
        (or (str_eq name "Value") (or (str_eq name "String")
            (or (str_eq name "Number") (str_eq name "Comparable")))))
    (defn fsc-bml-binding (text)
        (do
            (let colon (str_find text ":" 0))
            (if (lt colon 0) (list text "")
                (do
                    (let name (fsc-trim (fsc-sub text 0 colon)))
                    (let kind (fsc-trim (fsc-sub text (add colon 1) (str_len text))))
                    (if (and (not (str_eq name "")) (fsc-bml-comparison-type? kind)) (list name kind)
                        (fsc-compiler-error-line "unknown form.bml comparison contract" text))))))
    (defn fsc-bml-type-find (rows name)
        (if (nil? rows) (empty)
            (if (str_eq (head (head rows)) name) (head rows) (fsc-bml-type-find (tail rows) name))))
    (defn fsc-bml-type-of (rows name)
        (do (let row (fsc-bml-type-find rows name)) (if (nil? row) "" (nth row 1))))
    (defn fsc-bml-type-name (recipe)
        (node_value (head (node_children recipe))))
    (defn fsc-bml-type-signatures (recipes out)
        (if (nil? recipes) out
            (fsc-bml-type-signatures (tail recipes)
                (if (node_eq (node_category (head recipes)) fsc-rec-FNDEF-CAT)
                    (cons (fsc-bml-binding (fsc-bml-type-name (head recipes))) out) out))))
    (defn fsc-bml-type-params (params)
        (if (nil? params) (empty)
            (cons (fsc-bml-binding (node_value (head params))) (fsc-bml-type-params (tail params)))))
    (defn fsc-bml-type-names (rows)
        (if (nil? rows) (empty) (cons (head (head rows)) (fsc-bml-type-names (tail rows)))))

    (defn fsc-form-signature-next (source i end markers)
        (if (nil? markers) end
            (do (let found (str_find source (head markers) i))
                (fsc-form-signature-next source i
                    (if (and (ge found 0) (lt found end)) found end) (tail markers)))))
    (defn fsc-form-signature-span (source i end out)
        (if (ge i end) out
            (if (str_eq (char_at source i) "\"")
                (fsc-form-signature-span source (fsc-bml-token-after source i end) end out)
            (if (str_eq (char_at source i) ";")
                (fsc-form-signature-span source (fsc-line-next source i) end out)
            (if (str_eq (fsc-sub source i (add i 2)) "//")
                (fsc-form-signature-span source (fsc-line-next source i) end out)
            (if (and (str_eq (fsc-sub source i (add i 5)) "(defn")
                     (bml-source-space? (char_at source (add i 5))))
                (do (let start (bml-source-skip-spaces source (add i 5)))
                    (let stop (bml-source-word-end source start))
                    (fsc-form-signature-span source stop end (cons (list (fsc-sub source start stop) "") out)))
                (fsc-form-signature-span source
                    (fsc-form-signature-next source (add i 1) end (list "\"" ";" "//" "(defn")) end out)))))))
    (defn fsc-bml-source-signatures (source i out)
        (do
            (let pos (fsc-find-section-open source i))
            (let prefix (fsc-form-signature-span source i (if (lt pos 0) (str_len source) pos) out))
            (if (lt pos 0) prefix
                (do
                    (let dialect-end (fsc-find-char-from source "]" (add pos 9)))
                    (let dialect (fsc-sub source (add pos 9) dialect-end))
                    (let open (fsc-find-char-from source "{" dialect-end))
                    (let close (if (fsc-high-level-form-dialect? dialect)
                        (fsc-bml-block-end source (add open 1) 0) (fsc-section-end source (add open 1))))
                    (fsc-bml-source-signatures source (fsc-section-after source close)
                        (if (fsc-bml-contract-dialect? dialect)
                            (fsc-bml-type-signatures
                                (fbl-section-recipes (fsc-sub source (add open 1) close) (fbr-line-at source (add open 1))) prefix)
                            prefix))))))
    (defn fsc-bml-contract-dialect? (name)
        (or (str_eq name "form.bml") (or (str_eq name "form.route") (str_eq name "form.action"))))
    (defn fsc-bml-dependency-signatures (owner tokens seen signatures observations homes)
        (if (nil? tokens) (list seen signatures observations)
            (do
                (let resolution (bml-source-resolution (bml-source-candidates owner (head tokens)) observations))
                (let path (head resolution))
                (if (nothing? path) (fsc-compiler-error-line "BML contract source unavailable" (head tokens))
                    (do
                        (let next (if (fsc-bml-member? seen path) (list seen signatures (nth resolution 1))
                            (fsc-bml-file-signatures path (fsc-bml-read-source path) (cons path seen) signatures (nth resolution 1) homes)))
                        (fsc-bml-dependency-signatures owner (tail tokens) (head next) (nth next 1) (nth next 2) homes))))))
    (defn fsc-bml-file-signatures (path source seen signatures observations homes)
        (if (nothing? source) (fsc-compiler-error-line "BML contract source unreadable" path)
            (do
                (let current (cons (list "F" (bml-source-absolute path) (bml-source-fingerprint source)) observations))
                (let surface (if (and (lt (fsc-find-section-open source 0) 0)
                                      (not (str_eq (substring path (sub (str_len path) 4) (str_len path)) ".bml"))) source
                    (str_concat (bml-source-prelude-prefix source) (form-source-compile-loop source path 0 (nothing)))))
                (let dependencies (bml-source-dependencies surface 1))
                (let imported (fsc-bml-dependency-signatures path dependencies seen signatures current homes))
                (let linked (fsc-bml-dependency-signatures path (fsc-bml-selected-homes surface homes)
                    (head imported) (nth imported 1) (nth imported 2) homes))
                (list (head linked) (fsc-bml-source-signatures source 0 (nth linked 1)) (nth linked 2)))))
    (defn fsc-bml-read-source (path)
        (do (let absolute (bml-source-absolute path)) (let source (read_file absolute))
            (if (nothing? source) (fsc-compiler-error-line "BML contract source unreadable" path)
                (if (eq (str_len source) (file_size absolute)) source
                    (fsc-compiler-error-line "BML contract source incomplete" path)))))

    ;; Home discovery reads the emitted symbol surface with comparison metadata
    ;; erased. It must not choose equality before the imported contracts arrive.
    (defn fsc-bml-erased-list (recipes)
        (if (nil? recipes) (empty) (cons (fsc-bml-erased (head recipes)) (fsc-bml-erased-list (tail recipes)))))
    (defn fsc-bml-erased (recipe)
        (do (let kids (node_children recipe)) (let cat (node_category recipe))
            (if (nil? kids) recipe
            (if (node_eq cat fsc-rec-FNDEF-CAT)
                (fsc-rec-fndef (head (fsc-bml-binding (node_value (head kids))))
                    (fsc-bml-type-names (fsc-bml-type-params (node_children (nth kids 1)))) (fsc-bml-erased (nth kids 2)))
            (if (node_eq cat fsc-rec-LET-CAT)
                (fsc-rec-let (head (fsc-bml-binding (node_value (head kids)))) (fsc-bml-erased (nth kids 1)))
            (if (and (node_eq cat fsc-rec-FNCALL-CAT) (str_eq (fsc-bml-type-name (head kids)) "$bml-as"))
                (fsc-bml-erased (nth kids 2))
            (if (and (node_eq cat fsc-rec-FNCALL-CAT)
                    (or (str_eq (fsc-bml-type-name (head kids)) "$bml==") (str_eq (fsc-bml-type-name (head kids)) "$bml!=")))
                (fsc-rec-form-call "value_eq" (fsc-bml-erased-list (tail kids)))
                (if (node_eq cat fsc-rec-FNCALL-CAT)
                    (do (let name (fsc-bml-type-name (head kids))) (let row (record_get FSC-BML-INTRINSICS name))
                        (fsc-rec-call (if (value_eq row 0) name (nth row 1)) (fsc-bml-erased-list (tail kids))))
                    (intern_node cat (fsc-bml-erased-list kids))))))))))
    (defn fsc-bml-home-byte? (ch)
        (and (not (str_eq ch "")) (lt (str_find " \t\n\r()\";,[]{}'`=:" ch 0) 0)))
    (defn fsc-bml-home-token-end (source at end)
        (if (and (lt at end) (fsc-bml-home-byte? (char_at source at)))
            (fsc-bml-home-token-end source (add at 1) end) at))
    (defn fsc-bml-home-symbols (source at end previous call-head homes used defined)
        (if (ge at end) (list used defined)
            (do (let ch (char_at source at))
                (if (or (str_eq ch ";") (str_eq (fsc-sub source at (add at 2)) "//"))
                    (fsc-bml-home-symbols source (fsc-line-next source at) end previous call-head homes used defined)
                (if (str_eq ch "\"")
                    (fsc-bml-home-symbols source (fsc-bml-token-after source at end) end previous 0 homes used defined)
                (if (not (fsc-bml-home-byte? ch))
                    (fsc-bml-home-symbols source (add at 1) end previous
                        (if (str_eq ch "(") 1 (if (bml-source-space? ch) call-head 0)) homes used defined)
                    (do
                        (let stop (fsc-bml-home-token-end source at end))
                        (let token (fsc-sub source at stop))
                        (let home (fsc-bml-type-find homes token))
                        (let known (not (nil? home)))
                        (let defining (or (str_eq previous "defn") (str_eq previous "def")))
                        (fsc-bml-home-symbols source stop end token 0 homes
                            (if (and known (and (not defining) (not (and call-head (nth home 2))))) (cons token used) used)
                            (if (and known defining) (cons token defined) defined)))))))))
    (defn fsc-bml-home-selected (rows used defined)
        (if (nil? rows) (empty)
            (do (let row (head rows)) (let rest (fsc-bml-home-selected (tail rows) used defined))
                (if (and (fsc-bml-member? used (head row)) (not (fsc-bml-member? defined (head row))))
                    (cons (nth row 1) rest) rest))))
    (defn fsc-bml-selected-homes (surface homes)
        (if (nil? homes) (empty)
            (do
                (let candidates (fsc-bml-home-candidates surface homes))
                (if (nil? candidates) (empty)
                    (do
                    (let names (fsc-bml-home-symbols surface 0 (str_len surface) "" 0 candidates (empty) (empty)))
                    (fsc-bml-home-selected candidates (head names) (nth names 1)))))))
    ;; A byte search only narrows the registry; the lexical pass still decides
    ;; whether a name is used or defined. Raw Form already has that surface.
    (defn fsc-bml-home-candidates (source rows)
        (if (nil? rows) (empty)
            (do (let rest (fsc-bml-home-candidates source (tail rows)))
                (if (ge (str_find source (head (head rows)) 0) 0) (cons (head rows) rest) rest))))
    (defn fsc-bml-home-rows (lines out bound)
        (if (nil? lines) (reverse out)
            (do (let line (bml-source-trim (head lines))) (let words (bml-source-words line))
                (fsc-bml-home-rows (tail lines)
                    (if (or (str_eq (substring line 0 1) "#") (lt (len words) 2)) out
                        (cons (list (head words) (nth words 1) (fsc-bml-member? bound (head words))) out)) bound))))
    (defn fsc-bml-home-open (path observations)
        (if (or (nothing? path) (lt (file_size (bml-source-absolute path)) 0))
            (list (empty) (if (nothing? path) observations (cons (list "N" (bml-source-absolute path) "0000000000000000") observations)))
            (do (let source (fsc-bml-read-source path))
                (let resolution (bml-source-resolution
                    (append (list "runtime/fkwu-optable.h" "../runtime/fkwu-optable.h") (bml-source-root-candidates "runtime/fkwu-optable.h"))
                    observations))
                (let table-path (head resolution))
                (if (nothing? table-path) (form_error "native call-head table unavailable")
                    (do (let table (fsc-bml-read-source table-path))
                        (list (fsc-bml-home-rows (split-on source "\n") (empty) (bml-source-reserved-heads table))
                            (cons (list "F" (bml-source-absolute table-path) (bml-source-fingerprint table))
                                (cons (list "F" (bml-source-absolute path) (bml-source-fingerprint source)) (nth resolution 1)))))))))
    (defn fsc-bml-home-context (owner)
        (do (let resolution (bml-source-resolution (bml-source-candidates owner "form-stdlib/home-index.txt") (empty)))
            (fsc-bml-home-open (head resolution) (nth resolution 1))))
    (defn fsc-bml-typed-list-in (recipes env signatures local)
        (if (nil? recipes) (empty)
            (cons (fsc-bml-typed-in (head recipes) env signatures local) (fsc-bml-typed-list-in (tail recipes) env signatures local))))
    (defn fsc-bml-typed-nodes (rows)
        (if (nil? rows) (empty) (cons (head (head rows)) (fsc-bml-typed-nodes (tail rows)))))
    (defn fsc-bml-typed-sequence (recipes env signatures out result-type)
        (fsc-bml-typed-sequence-in (node_children (fsc-bml-expand (fsc-rec-do recipes))) env signatures out result-type 0))
    (defn fsc-bml-typed-sequence-in (recipes env signatures out result-type local)
        (if (nil? recipes) (list (fsc-rec-do (fsc-rev out)) result-type)
            (do
                (let recipe (head recipes))
                (let row (fsc-bml-typed-in recipe env signatures local))
                (let function (and local (node_eq (node_category recipe) fsc-rec-FNDEF-CAT)))
                (let named (or (node_eq (node_category recipe) fsc-rec-FNDEF-CAT) (node_eq (node_category recipe) fsc-rec-LET-CAT)))
                (let name (if named (head (fsc-bml-binding (fsc-bml-type-name recipe))) ""))
                (let next-env (if function (cons (list name "" 1) env)
                    (if (node_eq (node_category recipe) fsc-rec-LET-CAT)
                        (cons (list name (nth row 1)) env) env)))
                ;; Bind a local function once in its owner's frame. Sibling
                ;; functions capture that value instead of re-reading its owner.
                (let next-out (cons (head row) out))
                (fsc-bml-typed-sequence-in (tail recipes) next-env signatures
                    (if function (cons (fsc-rec-let name (fsc-rec-ident name)) next-out) next-out) (nth row 1) local))))
    (defn fsc-bml-comparison-contract (left right)
        (if (or (str_eq left "Value") (str_eq right "Value")) "Value"
        (if (str_eq left "") right
        (if (str_eq right "") left
        (if (str_eq left right) left
        (if (and (or (str_eq left "Number") (str_eq left "Comparable"))
                 (or (str_eq right "Number") (str_eq right "Comparable"))) "Comparable"
            (fsc-compiler-error-line "incompatible form.bml equality contracts" (str_concat left (str_concat " / " right)))))))))
    (defn fsc-bml-typed-equality (name rows)
        (do
            (let kind (fsc-bml-comparison-contract (nth (head rows) 1) (nth (nth rows 1) 1)))
            (let args (fsc-bml-typed-nodes rows))
            (let numeric (or (str_eq kind "Number") (str_eq kind "Comparable")))
            (let positive (fsc-rec-form-call (if numeric "eq" (if (str_eq kind "String") "str_eq" "value_eq")) args))
            (list (if (str_eq name "$bml==") positive
                 (if numeric (fsc-rec-form-call "ne" args) (fsc-rec-form-call "not" (list positive)))) "")))
    ;; A nested def reads its immediate enclosing frame. Carry an outer name
    ;; through intervening functions when only a deeper function reads it.
    ;; These are lexical lets; no runtime lookup or additional carrier operation.
    (defn fsc-bml-nested-def? (recipe)
        (or (node_eq (node_category recipe) fsc-rec-FNDEF-CAT) (fsc-bml-nested-defs? (node_children recipe))))
    (defn fsc-bml-nested-defs? (recipes)
        (if (nil? recipes) 0 (or (fsc-bml-nested-def? (head recipes)) (fsc-bml-nested-defs? (tail recipes)))))
    (defn fsc-bml-descendant-use? (recipe name inside)
        (do (let kids (node_children recipe)) (let cat (node_category recipe))
            (if (node_eq cat fsc-rec-IDENT-CAT)
                (and inside (str_eq (node_value (head kids)) name))
            (if (node_eq cat fsc-rec-FNDEF-CAT)
                (if (nil? (fsc-bml-type-find (fsc-bml-type-params (node_children (nth kids 1))) name))
                    (fsc-bml-descendant-use? (nth kids 2) name 1) 0)
                (fsc-bml-descendant-uses? kids name inside)))))
    (defn fsc-bml-descendant-uses? (recipes name inside)
        (if (nil? recipes) 0
            (or (fsc-bml-descendant-use? (head recipes) name inside)
                (fsc-bml-descendant-uses? (tail recipes) name inside))))
    (defn fsc-bml-capture-bridges (recipe env bound)
        (if (nil? env) (empty)
            (do (let name (head (head env)))
                (let rest (fsc-bml-capture-bridges recipe (tail env) (cons (head env) bound)))
                (if (and (nil? (fsc-bml-type-find bound name)) (fsc-bml-descendant-use? recipe name 0))
                    (cons (fsc-rec-let name (fsc-rec-ident name)) rest) rest))))
    ;; Resolve source aliases after lexical bindings are known. Discovery may
    ;; read the canonical owner, while execution keeps a caller's bound name.
    (defn fsc-bml-unbound? (name env signatures)
        (and (nil? (fsc-bml-type-find env name)) (nil? (fsc-bml-type-find signatures name))))
    (defn fsc-bml-resolved-call (name args env signatures)
        (do (let row (record_get FSC-BML-INTRINSICS name))
            (if (and (not (value_eq row 0)) (fsc-bml-unbound? name env signatures))
                (fsc-bml-call-arity (fsc-rec-call (nth row 1) args))
                (fsc-rec-call name args))))
    (defn fsc-bml-typed (recipe env signatures) (fsc-bml-typed-in (fsc-bml-expand recipe) env signatures 0))
    (defn fsc-bml-typed-in (recipe env signatures local)
        (do
            (let kids (node_children recipe))
            (let cat (node_category recipe))
            (if (nil? kids) (list recipe "")
            (if (node_eq cat fsc-rec-IDENT-CAT)
                (do (let name (node_value (head kids)))
                    (list (if (and (or (str_eq name "fail") (str_eq name "stop"))
                                  (fsc-bml-unbound? name env signatures))
                              (fsc-bml-resolved-call name (empty) env signatures) recipe)
                          (fsc-bml-type-of env name)))
            (if (node_eq cat fsc-rec-DO-CAT)
                (fsc-bml-typed-sequence-in kids env (fsc-bml-type-signatures kids signatures) (empty) "" local)
            (if (node_eq cat fsc-rec-FNDEF-CAT)
                (do
                    (let binding (fsc-bml-binding (node_value (head kids))))
                    (let params (fsc-bml-type-params (node_children (nth kids 1))))
                    (let body (fsc-bml-typed-in (nth kids 2) (append params env) signatures 1))
                    (let bridges (if (fsc-bml-nested-def? (nth kids 2))
                        (fsc-bml-capture-bridges (nth kids 2) env params) (empty)))
                    (list (fsc-rec-fndef (head binding) (fsc-bml-type-names params)
                        (if (nil? bridges) (head body) (fsc-rec-do (append bridges (list (head body)))))) ""))
            (if (node_eq cat fsc-rec-LET-CAT)
                (do
                    (let binding (fsc-bml-binding (node_value (head kids))))
                    (let value (fsc-bml-typed-in (nth kids 1) env signatures local))
                    (list (fsc-rec-let (head binding) (head value))
                        (if (str_eq (nth binding 1) "") (nth value 1) (nth binding 1))))
            (if (node_eq cat fsc-rec-FNCALL-CAT)
                (do
                    (let name (fsc-bml-type-name (head kids)))
                    (if (str_eq name "$bml-as")
                        (list (head (fsc-bml-typed-in (nth kids 2) env signatures local)) (node_value (nth kids 1)))
                        (do
                            (let rows (fsc-bml-typed-list-in (tail kids) env signatures local))
                            (if (or (str_eq name "$bml==") (str_eq name "$bml!=")) (fsc-bml-typed-equality name rows)
                                (list (fsc-bml-resolved-call name (fsc-bml-typed-nodes rows) env signatures)
                                    (if (or (nil? (fsc-bml-type-find env name))
                                            (gt (len (fsc-bml-type-find env name)) 2))
                                        (fsc-bml-type-of signatures name) ""))))))
                (do
                    (let rows (fsc-bml-typed-list-in kids env signatures local))
                    (list (intern_node cat (fsc-bml-typed-nodes rows))
                        (if (and (node_eq cat fsc-rec-IF3-CAT) (str_eq (nth (nth rows 1) 1) (nth (nth rows 2) 1)))
                            (nth (nth rows 1) 1) "")))))))))))

    (defn fsc-compile-form-route-section-recipe (body)
        (fsc-compile-form-bml-section-recipe body 1))


    ;; --- Recipe source emitter ---------------------------------------
    ;;
    ;; The BML compiler builds Form Recipe nodes directly.  This native source
    ;; view emits their executable Form text, the source fkwu compiles.

    (defn fsc-source-emit-join (items)
        (if (fsc-empty? items) ""
            (if (fsc-empty? (tail items)) (head items)
                (str_concat (head items)
                    (str_concat " " (fsc-source-emit-join (tail items)))))))

    (defn fsc-source-emit-list-loop (recipes acc)
        (if (fsc-empty? recipes) (fsc-rev acc)
            (fsc-source-emit-list-loop (tail recipes)
                (cons (fsc-source-emit-recipe (head recipes)) acc))))

    (defn fsc-source-emit-list (recipes)
        (fsc-source-emit-join (fsc-source-emit-list-loop recipes (empty))))

    (defn fsc-source-emit-call (name args)
        (if (fsc-empty? args)
            (str_concat "(" (str_concat name ")"))
            (str_concat "("
                (str_concat name
                    (str_concat " "
                        (str_concat (fsc-source-emit-list args) ")"))))))

    ; The primitive nodes are resolved ONCE at load. The earlier loop
    ; called form-prim-node (a fresh make_nodeid mint) per row per lookup
    ; — thousands of undeduped value nodes per emitted module, which is
    ; what made every melt's O(pool) walk grow run over run (witnessed
    ; 2026-08-30, the churn half of the 122,158-melt reading).
    (defn fsc-prim-nodes-build (rows)
        (if (fsc-empty? rows) (empty)
            (cons (list (head (head rows)) (form-prim-node (head rows)))
                  (fsc-prim-nodes-build (tail rows)))))
    (let FORM-PRIMITIVE-NODES (fsc-prim-nodes-build FORM-PRIMITIVE-TABLE))

    (defn fsc-source-primitive-name-loop (rows cat)
        (if (fsc-empty? rows) ""
            (if (node_eq (head (tail (head rows))) cat)
                (head (head rows))
                (fsc-source-primitive-name-loop (tail rows) cat))))

    (defn fsc-source-primitive-name (cat)
        (fsc-source-primitive-name-loop FORM-PRIMITIVE-NODES cat))

    (defn fsc-source-emit-params-loop (param-items acc)
        (if (fsc-empty? param-items) (fsc-rev acc)
            (fsc-source-emit-params-loop (tail param-items)
                (cons (node_value (head param-items)) acc))))

    (defn fsc-source-emit-params (param-items)
        (fsc-source-emit-join (fsc-source-emit-params-loop param-items (empty))))

    ;; A trivial float leaf (node_type 7) carries an f64, not its source text.
    ;; int_to_str over that value answered "" (its digit walk hands a float to
    ;; byte_to_str), so every decimal literal in a .bml lowered to an EMPTY
    ;; argument: `list("x", 1.0, 0.5)` became `(list "x"  )` and answered 1
    ;; (ledger R76, witnessed 2026-09-04). The float's executable text is the
    ;; shortest decimal that READS BACK to the same f64 through str_to_float
    ;; (the reader the lowered text meets), always with a digit after the dot
    ;; so it stays a float literal: 1.0 -> "1.0", never "1". A value no width
    ;; up to 17 fractional digits reads back is refused by name.
    (defn fsc-float-text-at (af digits)
        (do
            (let scale (fstr-pow10 digits))
            (let scaled (float_to_int (add 0.5 (mul af scale))))
            (str_concat (int_to_str (div scaled scale))
                (str_concat "." (fstr-pad-left (int_to_str (mod scaled scale)) digits)))))

    (defn fsc-float-text-loop (value af neg digits)
        (if (gt digits 17)
            (fsc-compiler-error "float literal has no decimal text that reads back to its own value within 17 fractional digits")
            (do
                (let body (fsc-float-text-at af digits))
                (let text (if neg (str_concat "-" body) body))
                (if (eq (str_to_float text) value) text
                    (fsc-float-text-loop value af neg (add digits 1))))))

    (defn fsc-source-emit-float (value)
        (do
            (let neg (lt value 0))
            (fsc-float-text-loop value (if neg (sub 0 value) value) neg 1)))

    ;; Leaf text by node_type: 1 int, 5 int64, 2 string, 3 bool, 7 float. Any
    ;; other leaf refuses by name -- an unknown leaf rendered through int_to_str
    ;; is how the float vanished silently; never again an empty token.
    ;;
    ;; 5 is the SAME integer as 1, stored elsewhere. A kernel that inlines a
    ;; trivial int in the 32-bit inst slot moves past that ceiling into an
    ;; overflow table and gives the leaf a second type; the value decodes back
    ;; to the same int64 either way, so arithmetic never sees the split. This
    ;; emitter did, because it dispatches on the type, and it refused a plain
    ;; number: a band carrying a literal past 2^31 could not cross the source
    ;; lens at all (found 2026-09-10 by rag-crossfade-band, whose declared rule
    ;; folds to 501009504543). Where a value is asked for, ask for the value.
    ; Emit comment delimiters and section openers as string data. The source
    ; dependency carrier reads semicolons before parsing expressions and reads
    ; a line that opens with `section [` as a section even inside a literal, so
    ; neither may appear whole in its source stream. A semicolon is built from
    ; its byte; the opener is cut between `section` and ` [` and joined back by
    ; concatenation. Both preserve the exact value on every proof arm without
    ; asking that carrier to own more syntax.
    (defn fsc-source-emit-string (text)
        (if (and (lt (str_find text ";" 0) 0) (lt (str_find text "section [" 0) 0))
            (fsc-q text)
            (fsc-source-string-chunks text 0 (list))))
    ; Binary carries balance the emitted concatenation tree. Source chunks
    ; and runtime values copy by tree level, not by every preceding suffix.
    (defn fsc-source-string-join (left right)
        (str_concat "(str_concat " (str_concat left (str_concat " " (str_concat right ")")))))
    (defn fsc-source-string-push (bins expr weight)
        (if (nil? bins) (list (list weight expr))
            (if (eq (head (head bins)) weight)
                (fsc-source-string-push (tail bins)
                    (fsc-source-string-join (nth (head bins) 1) expr) (mul weight 2))
                (cons (list weight expr) bins))))
    (defn fsc-source-string-fragment (text from stop bins)
        (if (eq from stop) bins
            (fsc-source-string-push bins (fsc-q (substring text from stop)) 1)))
    (defn fsc-source-string-chunks (text from bins)
        (do (let semi (str_find text ";" from))
            (let opener (str_find text "section [" from))
            (if (and (ge semi 0) (or (lt opener 0) (lt semi opener)))
                (fsc-source-string-chunks text (add semi 1)
                    (fsc-source-string-push
                        (fsc-source-string-fragment text from semi bins)
                        "(byte_to_str 59)" 1))
                (if (ge opener 0)
                    (fsc-source-string-chunks text (add opener 7)
                        (fsc-source-string-fragment text from (add opener 7) bins))
                    (fsc-source-string-finish
                        (fsc-source-string-fragment text from (str_len text) bins) "")))))
    (defn fsc-source-string-finish (bins out)
        (if (nil? bins) out
            (fsc-source-string-finish (tail bins)
                (if (str_eq out "") (nth (head bins) 1)
                    (fsc-source-string-join (nth (head bins) 1) out)))))

    (defn fsc-source-emit-leaf (recipe)
        (do
            (let kind (node_type recipe))
            (if (eq kind 2) (fsc-source-emit-string (node_value recipe))
            (if (eq kind 7) (fsc-source-emit-float (node_value recipe))
            (if (or (eq kind 1) (or (eq kind 5) (eq kind 3))) (int_to_str (node_value recipe))
                (fsc-compiler-error
                    (str_concat "source-emit: leaf of unknown node_type "
                        (int_to_str kind))))))))

    ;; A match recipe emits the if-chain every kernel reads. Each arm compares its
    ;; pattern with the subject by value_eq, in source order; the `_` arm answers
    ;; when none does, wherever it stands. A subject that is not a name or a leaf
    ;; is bound once, so the chain never walks it twice. Every comparison of a
    ;; chain is spent before one of its bodies runs, so a match nested in a body
    ;; may rebind the same name without disturbing the chain around it.
    (defn fsc-source-leaf? (recipe)
        (and (fsc-empty? (node_children recipe)) (eq (node_level recipe) 1)))

    (defn fsc-source-default-arm? (pattern)
        (if (fsc-source-leaf? pattern) false
            (if (node_eq (node_category pattern) fsc-rec-IDENT-CAT)
                (str_eq (node_value (head (node_children pattern))) "_")
                false)))

    (defn fsc-source-match-chain (subject pairs dflt)
        (if (fsc-empty? pairs) dflt
            (do
                (let pattern (head pairs))
                (let rest (tail (tail pairs)))
                (if (fsc-source-default-arm? pattern)
                    (fsc-source-match-chain subject rest
                        (if (str_eq dflt "") (fsc-source-emit-recipe (head (tail pairs))) dflt))
                    (do
                        (let later (fsc-source-match-chain subject rest dflt))
                        (str_concat "(if (value_eq "
                            (str_concat subject
                                (str_concat " "
                                    (str_concat (fsc-source-emit-recipe pattern)
                                        (str_concat ") "
                                            (str_concat (fsc-source-emit-recipe (head (tail pairs)))
                                                (if (str_eq later "") ")"
                                                    (str_concat " " (str_concat later ")"))))))))))))))

    (defn fsc-source-emit-match (kids)
        (do
            (let subject (head kids))
            (if (if (fsc-source-leaf? subject) true
                    (node_eq (node_category subject) fsc-rec-IDENT-CAT))
                (fsc-source-match-chain (fsc-source-emit-recipe subject) (tail kids) "")
                (str_concat "(do (let fsc-match-subject "
                    (str_concat (fsc-source-emit-recipe subject)
                        (str_concat ") "
                            (str_concat (fsc-source-match-chain "fsc-match-subject" (tail kids) "")
                                ")")))))))

    (defn fsc-source-emit-recipe (recipe)
        (do
            (let kids (node_children recipe))
            (if (and (fsc-empty? kids) (eq (node_level recipe) 1))
                (fsc-source-emit-leaf recipe)
                (do
                    (let cat (node_category recipe))
                    (if (node_eq cat fsc-rec-DO-CAT)
                        (fsc-source-emit-call "do" kids)
                    (if (node_eq cat fsc-rec-LET-CAT)
                        (str_concat "(let "
                            (str_concat (node_value (head kids))
                                (str_concat " "
                                    (str_concat
                                        (fsc-source-emit-recipe (head (tail kids)))
                                        ")"))))
                    (if (node_eq cat fsc-rec-FNCALL-CAT)
                        (fsc-source-emit-call
                            (fsc-source-emit-recipe (head kids))
                            (tail kids))
                    (if (node_eq cat fsc-rec-IDENT-CAT)
                        (node_value (head kids))
                    (if (node_eq cat fsc-rec-FNDEF-CAT)
                        (str_concat "(defn "
                            (str_concat (node_value (head kids))
                                (str_concat " ("
                                    (str_concat
                                        (fsc-source-emit-params
                                            (node_children (head (tail kids))))
                                        (str_concat ") "
                                            (str_concat
                                                (fsc-source-emit-recipe
                                                    (head (tail (tail kids))))
                                                ")"))))))
	                    (if (node_eq cat fsc-rec-IF3-CAT)
	                        (fsc-source-emit-call "if" kids)
	                    (if (node_eq cat fsc-rec-MATCH-CAT)
	                        (fsc-source-emit-match kids)
	                    (do
	                        (let prim-name (fsc-source-primitive-name cat))
	                        (if (str_eq prim-name "")
	                            (fsc-source-emit-call "do" kids)
	                            (fsc-source-emit-call prim-name kids))))))))))))))

    ;; A compiled section is rooted at DO.  Emitting that root as one `(do ...)`
    ;; would turn module bindings into lexical bindings, so the native text path
    ;; emits the root children as top-level forms.
    (defn fsc-source-emit-module-loop (recipes)
        (if (fsc-empty? recipes) ""
            (str_concat
                (fsc-source-emit-recipe (head recipes))
                (str_concat "\n"
                    (fsc-source-emit-module-loop (tail recipes))))))

    (defn fsc-source-emit-module (recipe)
        (if (node_eq (node_category recipe) fsc-rec-DO-CAT)
            (fsc-source-emit-module-loop (node_children recipe))
            (str_concat (fsc-source-emit-recipe recipe) "\n")))

    ;; --- compile section as Form source ------------------------------

    ;; form.lift is read by its own declared grammar through the cursor's lowering
    ;; (form-bml-lower.fk, which this unit preludes), then the comparison-contract pass
    ;; every BML reading meets, where == becomes the equality its operands ask for
    (defn fsc-compile-section-recipe (dialect-name body)
        (if (str_eq dialect-name "form.lift")
            (head (fsc-bml-typed (fbl-lower (g-parse (form-lift-section-grammar) body)) (empty) (empty)))
        (if (str_eq dialect-name "form.route")
            (fsc-compile-form-route-section-recipe body)
        (if (str_eq dialect-name "form.bml")
            (fsc-compile-form-bml-section-recipe body 1)
        (if (str_eq dialect-name "form.action")
            (fsc-compile-form-bml-section-recipe body 1)
        (if (fsc-high-level-form-dialect? dialect-name)
            (g-parse (bml-grammar) body)
            (fsc-bmf-section-recipe dialect-name body)))))))

    (defn fsc-compile-section (dialect-name body out-path)
        (fsc-source-emit-module
            (fsc-compile-section-recipe dialect-name body)))

    ;; --- form.action BMF object rules --------------------------------
    ;; The text lowering above is the bootstrap path for source sections. The
    ;; living action dialect shape is BMF: completed action source objects
    ;; lower rule-by-rule into Form recipe nodes, and each rule carries a
    ;; reverse path back to the matched source span.

    ;; form.action BMF rule actions resolve through the same ontology
    ;; table as the Recipe-emit path. Names → kernel categories.
    (let FSC-ACTION-BLOCK-DO   (form-cat-node "do"))
    (let FSC-ACTION-BLOCK-SEQ  (form-cat-node "sequence"))
    (let FSC-ACTION-BLOCK-LET  (form-cat-node "let"))
    (let FSC-ACTION-COND-IF    (form-cat-node "if"))
    (let FSC-ACTION-FNDEF      (form-cat-node "fndef"))
    (let FSC-ACTION-FNCALL     (form-cat-node "fncall"))
    (let FSC-ACTION-IDENT      (form-cat-node "ident"))

    ;; --- streaming BMF source scanner --------------------------------
    ;; A scanner state is a cursor over source. It emits one BMF source
    ;; object and the next cursor; callers decide how much of a stream to
    ;; consume. Grammar meaning stays in BMF object rules below.

    (defn fsc-source-cursor-with-len (source offset line col source-len)
        (list "fsc-source-cursor" source offset line col source-len))

    (defn fsc-file-source-cursor (path offset line col source-len)
        (list "fsc-file-source-cursor" path offset line col source-len))

    (defn fsc-file-source-cursor-window (path offset line col source-len window-start window)
        (list "fsc-file-source-cursor-window"
              path
              offset
              line
              col
              source-len
              window-start
              window))

    (defn fsc-source-cursor-file? (cursor)
        (and (gt (len cursor) 0)
             (or (str_eq (head cursor) "fsc-file-source-cursor")
                 (str_eq (head cursor) "fsc-file-source-cursor-window"))))

    (defn fsc-source-cursor-file-window? (cursor)
        (and (gt (len cursor) 0)
             (str_eq (head cursor) "fsc-file-source-cursor-window")))

    (defn fsc-source-cursor (source offset line col)
        (fsc-source-cursor-with-len source offset line col (str_len source)))

    (defn fsc-source-cursor-source (cursor) (nth cursor 1))
    (defn fsc-source-cursor-offset (cursor) (nth cursor 2))
    (defn fsc-source-cursor-line (cursor) (nth cursor 3))
    (defn fsc-source-cursor-col (cursor) (nth cursor 4))
    (defn fsc-source-cursor-source-len (cursor)
        (if (gt (len cursor) 5)
            (nth cursor 5)
            (if (fsc-source-cursor-file? cursor)
                (file_size (fsc-source-cursor-source cursor))
                (str_len (fsc-source-cursor-source cursor)))))

    (defn fsc-source-window-size () 4096)

    (defn fsc-source-cursor-window-start (cursor) (nth cursor 6))
    (defn fsc-source-cursor-window (cursor) (nth cursor 7))

    (defn fsc-source-cursor-window-contains? (cursor offset)
        (and (fsc-source-cursor-file-window? cursor)
             (and (ge offset (fsc-source-cursor-window-start cursor))
                  (lt offset
                      (add (fsc-source-cursor-window-start cursor)
                           (str_len (fsc-source-cursor-window cursor)))))))

    (defn fsc-source-cursor-windowed (cursor)
        (if (fsc-source-cursor-window-contains? cursor
                                                (fsc-source-cursor-offset cursor))
            cursor
            (fsc-file-source-cursor-window
                (fsc-source-cursor-source cursor)
                (fsc-source-cursor-offset cursor)
                (fsc-source-cursor-line cursor)
                (fsc-source-cursor-col cursor)
                (fsc-source-cursor-source-len cursor)
                (fsc-source-cursor-offset cursor)
                (read_file_slice (fsc-source-cursor-source cursor)
                                 (fsc-source-cursor-offset cursor)
                                 (fsc-source-window-size)))))

    (defn fsc-source-cursor-end? (cursor)
        (ge (fsc-source-cursor-offset cursor)
            (fsc-source-cursor-source-len cursor)))

    (defn fsc-source-cursor-char (cursor)
        (if (fsc-source-cursor-end? cursor) ""
            (if (fsc-source-cursor-file? cursor)
                (do
                    (let windowed (fsc-source-cursor-windowed cursor))
                    (char_at
                        (fsc-source-cursor-window windowed)
                        (sub (fsc-source-cursor-offset cursor)
                             (fsc-source-cursor-window-start windowed))))
                (char_at (fsc-source-cursor-source cursor)
                         (fsc-source-cursor-offset cursor)))))

    (defn fsc-source-cursor-next (cursor offset line col)
        (if (fsc-source-cursor-file? cursor)
            (if (and (fsc-source-cursor-file-window? cursor)
                     (fsc-source-cursor-window-contains? cursor offset))
                (fsc-file-source-cursor-window
                    (fsc-source-cursor-source cursor)
                    offset
                    line
                    col
                    (fsc-source-cursor-source-len cursor)
                    (fsc-source-cursor-window-start cursor)
                    (fsc-source-cursor-window cursor))
                (fsc-file-source-cursor
                    (fsc-source-cursor-source cursor)
                    offset
                    line
                    col
                    (fsc-source-cursor-source-len cursor)))
            (fsc-source-cursor-with-len
                (fsc-source-cursor-source cursor)
                offset
                line
                col
                (fsc-source-cursor-source-len cursor))))

    (defn fsc-source-cursor-advance (cursor)
        (do
            (let ch (fsc-source-cursor-char cursor))
            (if (str_eq ch "\n")
                (fsc-source-cursor-next
                    cursor
                    (add (fsc-source-cursor-offset cursor) 1)
                    (add (fsc-source-cursor-line cursor) 1)
                    0)
                (fsc-source-cursor-next
                    cursor
                    (add (fsc-source-cursor-offset cursor) 1)
                    (fsc-source-cursor-line cursor)
                    (add (fsc-source-cursor-col cursor) 1)))))

    ;; Flat cursor motion for native byte-class strides. scan_run/str_find find
    ;; the next offset in host loops; this updates source position without one
    ;; Form call frame per byte.
    (defn fsc-source-cursor-jump-same-line (cursor offset)
        (fsc-source-cursor-next
            cursor
            offset
            (fsc-source-cursor-line cursor)
            (add (fsc-source-cursor-col cursor)
                 (sub offset (fsc-source-cursor-offset cursor)))))

    (defn fsc-source-cursor-jump-line-loop (source i end line line-start)
        (do
            (let nl (str_find source "\n" i))
            (if (or (lt nl 0) (ge nl end))
                (list line (sub end line-start))
                (fsc-source-cursor-jump-line-loop
                    source
                    (add nl 1)
                    end
                    (add line 1)
                    (add nl 1)))))

    (defn fsc-source-cursor-jump-string (cursor offset)
        (do
            (let start (fsc-source-cursor-offset cursor))
            (let source (fsc-source-cursor-source cursor))
            (let first-nl (str_find source "\n" start))
            (if (or (lt first-nl 0) (ge first-nl offset))
                (fsc-source-cursor-jump-same-line cursor offset)
                (do
                    (let lc
                        (fsc-source-cursor-jump-line-loop
                            source
                            (add first-nl 1)
                            offset
                            (add (fsc-source-cursor-line cursor) 1)
                            (add first-nl 1)))
                    (fsc-source-cursor-next cursor offset (nth lc 0) (nth lc 1))))))

    (defn fsc-source-cursor-jump-loop (cursor offset)
        (if (ge (fsc-source-cursor-offset cursor) offset)
            cursor
            (fsc-source-cursor-jump-loop
                (fsc-source-cursor-advance cursor)
                offset)))

    (defn fsc-source-cursor-jump (cursor offset)
        (if (fsc-source-cursor-file? cursor)
            (fsc-source-cursor-jump-loop cursor offset)
            (fsc-source-cursor-jump-string cursor offset)))

    (defn fsc-source-cursor-range (start end)
        (list "fsc-source-range"
              (fsc-source-cursor-offset start)
              (sub (fsc-source-cursor-offset end)
                   (fsc-source-cursor-offset start))
              (fsc-source-cursor-line start)
              (fsc-source-cursor-col start)
              (fsc-source-cursor-line end)
              (fsc-source-cursor-col end)))

    (defn fsc-source-object (kind value start end)
        (bmf-object kind
                    value
                    (bmf-match-source (bmf-empty 0)
                                      (list (fsc-source-cursor-range start end)))
                    bmf-identity-inverse))

    (defn fsc-scan-result (object cursor)
        (list "fsc-scan-result" object cursor))

    (defn fsc-scan-result-object (result) (nth result 1))
    (defn fsc-scan-result-cursor (result) (nth result 2))

    (defn fsc-string-list-contains? (xs value)
        (if (nil? xs) false
            (if (str_eq (head xs) value) true
                (fsc-string-list-contains? (tail xs) value))))

    (defn fsc-source-scan-skip (cursor)
        (if (fsc-source-cursor-end? cursor) cursor
            (if (fsc-source-cursor-file? cursor)
                (if (fsc-space? (fsc-source-cursor-char cursor))
                    (fsc-source-scan-skip (fsc-source-cursor-advance cursor))
                    cursor)
                (do
                    (let end
                        (scan_run
                            (fsc-source-cursor-source cursor)
                            (fsc-source-cursor-offset cursor)
                            0))
                    (if (eq end (fsc-source-cursor-offset cursor))
                        cursor
                        (fsc-source-cursor-jump cursor end))))))

    (defn fsc-source-name-char? (ch)
        (or (fsc-word-char? ch) (str_eq ch "?")))

    (defn fsc-source-name-start-char? (ch)
        (do
            (let cp (ord ch))
            (or (and (ge cp 65) (le cp 90))
            (or (and (ge cp 97) (le cp 122))
                (str_eq ch "_")))))

    ;; Extract a slice [start, end) from the cursor's underlying source,
    ;; whether it is an in-memory string or a file path.
    (defn fsc-source-cursor-slice (cursor start end)
        (if (fsc-source-cursor-file? cursor)
            (read_file_slice (fsc-source-cursor-source cursor)
                             start
                             (sub end start))
            (substring (fsc-source-cursor-source cursor) start end)))

    ;; Walk forward through name-chars without copying. scan_run class 3 is
    ;; the flat host-loop path for the common identifier body; a trailing `?`
    ;; suffix is admitted as one explicit byte to preserve predicate names.
    (defn fsc-source-scan-name-loop (start-cursor cursor)
        (if (fsc-source-cursor-file? cursor)
            (if (fsc-source-cursor-end? cursor)
                (list (fsc-source-cursor-slice
                           start-cursor
                           (fsc-source-cursor-offset start-cursor)
                           (fsc-source-cursor-offset cursor))
                      cursor)
                (do
                    (let ch (fsc-source-cursor-char cursor))
                    (if (fsc-source-name-char? ch)
                        (fsc-source-scan-name-loop start-cursor
                                                   (fsc-source-cursor-advance cursor))
                        (list (fsc-source-cursor-slice
                                   start-cursor
                                   (fsc-source-cursor-offset start-cursor)
                                   (fsc-source-cursor-offset cursor))
                              cursor))))
            (do
                (let source (fsc-source-cursor-source cursor))
                (let start (fsc-source-cursor-offset start-cursor))
                (let base-end (scan_run source start 3))
                (let end
                    (if (and (lt base-end (fsc-source-cursor-source-len cursor))
                             (str_eq (char_at source base-end) "?"))
                        (add base-end 1)
                        base-end))
                (let end-cursor (fsc-source-cursor-jump cursor end))
                (list (fsc-source-cursor-slice start-cursor start end)
                      end-cursor))))

    (defn fsc-source-name-kind (value keywords keyword-kind name-kind)
        (if (fsc-string-list-contains? keywords value)
            keyword-kind
            name-kind))

    (defn fsc-source-dialect (keywords keyword-kind name-kind int-kind string-kind op-kind eof-kind ops)
        (list "fsc-source-dialect"
              keywords
              keyword-kind
              name-kind
              int-kind
              string-kind
              op-kind
              eof-kind
              ops))

    (defn fsc-source-dialect-keywords (dialect) (nth dialect 1))
    (defn fsc-source-dialect-keyword-kind (dialect) (nth dialect 2))
    (defn fsc-source-dialect-name-kind (dialect) (nth dialect 3))
    (defn fsc-source-dialect-int-kind (dialect) (nth dialect 4))
    (defn fsc-source-dialect-string-kind (dialect) (nth dialect 5))
    (defn fsc-source-dialect-op-kind (dialect) (nth dialect 6))
    (defn fsc-source-dialect-eof-kind (dialect) (nth dialect 7))
    (defn fsc-source-dialect-ops (dialect) (nth dialect 8))

    (defn fsc-source-scan-name (start keywords keyword-kind name-kind)
        (do
            (let read (fsc-source-scan-name-loop start start))
            (let value (nth read 0))
            (let end (nth read 1))
            (fsc-scan-result
                (fsc-source-object
                    (fsc-source-name-kind value keywords keyword-kind name-kind)
                    value
                    start
                    end)
                end)))

    (defn fsc-source-scan-int-loop (start-cursor cursor)
        (if (fsc-source-cursor-file? cursor)
            (if (fsc-source-cursor-end? cursor)
                (list (fsc-source-cursor-slice
                           start-cursor
                           (fsc-source-cursor-offset start-cursor)
                           (fsc-source-cursor-offset cursor))
                      cursor)
                (do
                    (let ch (fsc-source-cursor-char cursor))
                    (if (fsc-digit? ch)
                        (fsc-source-scan-int-loop start-cursor
                                                  (fsc-source-cursor-advance cursor))
                        (list (fsc-source-cursor-slice
                                   start-cursor
                                   (fsc-source-cursor-offset start-cursor)
                                   (fsc-source-cursor-offset cursor))
                              cursor))))
            (do
                (let source (fsc-source-cursor-source cursor))
                (let start (fsc-source-cursor-offset start-cursor))
                (let end (scan_run source start 1))
                (let end-cursor (fsc-source-cursor-jump cursor end))
                (list (fsc-source-cursor-slice start-cursor start end)
                      end-cursor))))

    (defn fsc-source-scan-int (start int-kind)
        (do
            (let read (fsc-source-scan-int-loop start start))
            (let value (nth read 0))
            (let end (nth read 1))
            (fsc-scan-result
                (fsc-source-object int-kind value start end)
                end)))

    (defn fsc-source-scan-string-loop (start-cursor cursor)
        (if (fsc-source-cursor-file? cursor)
            (if (fsc-source-cursor-end? cursor)
                (list (fsc-source-cursor-slice
                           start-cursor
                           (fsc-source-cursor-offset start-cursor)
                           (fsc-source-cursor-offset cursor))
                      cursor)
                (if (str_eq (fsc-source-cursor-char cursor) "\"")
                    (list (fsc-source-cursor-slice
                               start-cursor
                               (fsc-source-cursor-offset start-cursor)
                               (fsc-source-cursor-offset cursor))
                          (fsc-source-cursor-advance cursor))
                    (fsc-source-scan-string-loop start-cursor
                                                 (fsc-source-cursor-advance cursor))))
            (do
                (let source (fsc-source-cursor-source cursor))
                (let start (fsc-source-cursor-offset start-cursor))
                (let q (str_find source "\"" start))
                (let end (if (lt q 0) (fsc-source-cursor-source-len cursor) q))
                (let next (if (lt q 0) end (add q 1)))
                (let end-cursor (fsc-source-cursor-jump cursor next))
                (list (fsc-source-cursor-slice start-cursor start end)
                      end-cursor))))

    (defn fsc-source-scan-string (start string-kind)
        (do
            (let body-start (fsc-source-cursor-advance start))
            (let read (fsc-source-scan-string-loop body-start body-start))
            (let value (nth read 0))
            (let end (nth read 1))
            (fsc-scan-result
                (fsc-source-object string-kind value start end)
                end)))

    (defn fsc-source-advance-n (cursor n)
        (if (le n 0) cursor
            (fsc-source-cursor-jump
                cursor
                (add (fsc-source-cursor-offset cursor) n))))

    (defn fsc-source-cursor-prefix? (cursor prefix)
        (do
            (let offset (fsc-source-cursor-offset cursor))
            (if (fsc-source-cursor-file? cursor)
                (fsc-source-cursor-file-prefix? cursor prefix 0)
                (fsc-find-string-at-len?
                    (fsc-source-cursor-source cursor)
                    prefix
                    (fsc-source-cursor-source-len cursor)
                    (str_len prefix)
                    offset
                    0))))

    (defn fsc-source-cursor-file-prefix? (cursor prefix j)
        (do
            (let remaining (substring prefix j (str_len prefix)))
            (let available
                (sub (fsc-source-cursor-source-len cursor)
                     (add (fsc-source-cursor-offset cursor) j)))
            (if (lt available (str_len remaining)) false
                (str_eq
                    (read_file_slice
                        (fsc-source-cursor-source cursor)
                        (add (fsc-source-cursor-offset cursor) j)
                        (str_len remaining))
                    remaining))))

    (defn fsc-source-match-op (cursor ops)
        (if (nil? ops) (fsc-source-cursor-char cursor)
            (if (fsc-source-cursor-prefix? cursor (head ops))
                (head ops)
                (fsc-source-match-op cursor (tail ops)))))

    (defn fsc-source-scan-op (start op-kind ops)
        (do
            (let value (fsc-source-match-op start ops))
            (let end (fsc-source-advance-n start (str_len value)))
            (fsc-scan-result
                (fsc-source-object op-kind value start end)
                end)))

    (defn fsc-source-scan-next (cursor keywords keyword-kind name-kind int-kind string-kind op-kind eof-kind ops)
        (do
            (let start (fsc-source-scan-skip cursor))
            (let ch (fsc-source-cursor-char start))
            (if (fsc-source-cursor-end? start)
                (fsc-scan-result
                    (fsc-source-object eof-kind "" start start)
                    start)
            (if (str_eq ch "\"")
                (fsc-source-scan-string start string-kind)
            (if (fsc-digit? ch)
                (fsc-source-scan-int start int-kind)
            (if (fsc-source-name-start-char? ch)
                (fsc-source-scan-name start keywords keyword-kind name-kind)
                (fsc-source-scan-op start op-kind ops)))))))

    (defn fsc-source-scan-next-dialect (cursor dialect)
        (fsc-source-scan-next cursor
                              (fsc-source-dialect-keywords dialect)
                              (fsc-source-dialect-keyword-kind dialect)
                              (fsc-source-dialect-name-kind dialect)
                              (fsc-source-dialect-int-kind dialect)
                              (fsc-source-dialect-string-kind dialect)
                              (fsc-source-dialect-op-kind dialect)
                              (fsc-source-dialect-eof-kind dialect)
                              (fsc-source-dialect-ops dialect)))

    (let fsc-action-keywords
        (list "def" "let" "if" "then" "else" "do"))

    (let fsc-common-op2
        (list "==" "!=" "<=" ">=" "->" "=>" ":=" "+=" "-=" "*=" "/=" "**" "//" "<<" ">>" "<-" "?."))

    (let fsc-action-source-dialect
        (fsc-source-dialect fsc-action-keywords
                            "form-action-keyword"
                            "form-action-name"
                            "form-action-int"
                            "form-action-string"
                            "form-action-op"
                            "form-action-eof"
                            fsc-common-op2))

    ;; --- active corpus roundtrip cells -------------------------------
    ;; These cells describe source-file bodies and target source lenses
    ;; above the kernel. They carry source objects beside the compiled
    ;; Form binary node so source -> binary -> source -> binary proof can
    ;; stay generic across dialects.

    (defn fsc-repo-file (path kind media-type byte-count sensed)
        (compiler-object "fsc-repo-file"
                         (list path kind media-type byte-count sensed)
                         sensed
                         compiler-identity-inverse))

    ;; --- repo ingestion objects --------------------------------------
    ;; These are native Form nodes for decoded file meaning. Paths and
    ;; media labels stay on the fsc-repo-file boundary. Transport bytes/text
    ;; are decoder input only; queryable content lives here as local kind
    ;; nodes, source spans, and parsed structures supplied by domain grammars.

    (let FSC-REPO-DOCUMENT (make_nodeid 8 45 6 10))
    (let FSC-REPO-TEXT-LINES (make_nodeid 8 45 6 11))
    (let FSC-REPO-TEXT-LINE (make_nodeid 8 45 6 12))
    (let FSC-REPO-MEANING (make_nodeid 8 45 6 13))
    (let FSC-REPO-MEANING-FIELD (make_nodeid 8 45 6 14))

    (defn fsc-repo-text-line-number (line)
        (if (gt (len line) 0)
            (nth line 3)
            (node_value (nth (node_children line) 2))))

    (defn fsc-repo-text-line-start-col (line)
        (if (gt (len line) 0)
            (nth line 4)
            (node_value (nth (node_children line) 3))))

    ;; --- source compiler ---------------------------------------------

    ;; Text outside `section [...]` blocks is emitted verbatim into the lowered
    ;; Form, but `.bml` modules carry `//` doc-comment lines (preludes, headers)
    ;; that the Form flattener cannot parse — it only knows `;` comments, so a
    ;; paren inside a `//` line would derail the function index. Strip the
    ;; `//`-only lines here in the compiler (after trimming leading space) and
    ;; pass Form code and `;` comments through untouched.
    (defn fsc-strip-bml-comments-loop (s i)
        (if (ge i (str_len s)) ""
            (do
                (let nxt (fsc-line-next s i))
                (let line (fsc-sub s i (fsc-line-end s i)))
                (if (fsc-prefix? (fsc-trim line) "//")
                    (fsc-strip-bml-comments-loop s nxt)
                    (str_concat (fsc-sub s i nxt)
                                (fsc-strip-bml-comments-loop s nxt))))))

    (defn fsc-strip-bml-comments (s)
        (fsc-strip-bml-comments-loop s 0))

    ;; A section opens at a whitespace-only line prefix or immediately after
    ;; the preceding fully consumed section. Searching past other source text
    ;; cannot create a new immediate boundary inside a comment or string.
    (defn fsc-line-start-of (s i)
        (if (le i 0) 0
            (if (str_eq (char_at s (sub i 1)) "\n") i
                (fsc-line-start-of s (sub i 1)))))
    (defn fsc-only-ws-between? (s a b)
        (if (ge a b) true
            (if (or (str_eq (char_at s a) " ") (str_eq (char_at s a) "\t"))
                (fsc-only-ws-between? s (add a 1) b)
                false)))
    (defn fsc-section-line-open? (s pos)
        (fsc-only-ws-between? s (fsc-line-start-of s pos) pos))
    (defn fsc-find-section-open-from (src i boundary)
        (do
            (let pos (fsc-find-string-from src "section [" i))
            (if (lt pos 0) pos
                (if (or (fsc-section-line-open? src pos)
                        (fsc-only-ws-between? src boundary pos)) pos
                    (fsc-find-section-open-from src (add pos 9) boundary)))))

    (defn fsc-find-section-open (src i)
        (fsc-find-section-open-from src i i))

    ;; A whitespace-only section terminator line contributes no extra module
    ;; separator. A same-line source suffix remains part of the next span.
    (defn fsc-section-after-spaces (src i)
        (if (ge i (str_len src)) i
            (if (or (str_eq (char_at src i) " ")
                    (or (str_eq (char_at src i) "\t") (str_eq (char_at src i) "\r")))
                (fsc-section-after-spaces src (add i 1)) i)))

    (defn fsc-section-after (src close)
        (do
            (let start (add close 1))
            (let p (fsc-section-after-spaces src start))
            (if (str_eq (char_at src p) "\n") (add p 1) start)))

    (defn form-source-compile-loop (src out-path i signatures)
        (do
            (let pos (fsc-find-section-open src i))
            (if (lt pos 0) (fsc-strip-bml-comments (fsc-sub src i (str_len src)))
                (do
                    (let dialect-start (add pos 9))
                    (let dialect-end (fsc-find-char-from src "]" dialect-start))
                    (let open (fsc-find-char-from src "{" dialect-end))
                    (let dialect-name (fsc-sub src dialect-start dialect-end))
                    (let close (if (fsc-high-level-form-dialect? dialect-name)
                        (fsc-bml-block-end src (add open 1) 0)
                        (fsc-section-end src (add open 1))))
                    (let body (fsc-sub src (add open 1) close))
                        (str_concat
                            (fsc-strip-bml-comments (fsc-sub src i pos))
                            (str_concat
                            (if (fsc-bml-contract-dialect? dialect-name)
                                (do (let recipes (fbl-section-recipes body (fbr-line-at src (add open 1))))
                                    (fsc-source-emit-module (if (nothing? signatures) (fsc-bml-erased (fsc-bml-expand (fsc-rec-do recipes)))
                                        (head (fsc-bml-typed-sequence recipes (empty) signatures (empty) "")))))
                                (fsc-compile-section dialect-name body out-path))
                            (form-source-compile-loop src out-path (fsc-section-after src close) signatures)))))))

    (defn form-source-compile-text (src out-path)
        (do (let owner out-path)
            (let homes (fsc-bml-home-context owner))
            (let catalog (fsc-bml-file-signatures owner src (list owner) (empty) (nth homes 1) (head homes)))
            (form-source-compile-loop src out-path 0 (nth catalog 1))))

    ;; The memo's dependency choices are Form data. The checkout carrier only
    ;; compares their bytes; it does not parse another dependency language.
    (defn form-source-compile-packet (src path prefix home-path)
        (do
            (let owner path)
            (let homes (fsc-bml-home-open home-path (empty)))
            (let catalog (fsc-bml-file-signatures owner src (list owner) (empty) (nth homes 1) (head homes)))
            (let compiler-resolution (bml-source-resolution
                (list "form/form-stdlib/bml-floor-compile.fk" "form-stdlib/bml-floor-compile.fk") (nth catalog 2)))
            (let compiler-path (head compiler-resolution))
            (let compiler-homes (fsc-bml-home-context compiler-path))
            (let shared (if (value_eq (head homes) (head compiler-homes)) (head catalog) (empty)))
            (let compiler (if (fsc-bml-member? shared compiler-path)
                (list (head catalog) (nth catalog 1) (nth compiler-resolution 1))
                (fsc-bml-file-signatures compiler-path (fsc-bml-read-source compiler-path) (cons compiler-path shared) (nth catalog 1)
                    (append (nth compiler-homes 1) (nth compiler-resolution 1)) (head compiler-homes))))
            (str_concat "fklow2\n"
                (str_concat (bml-source-manifest-row "P" path "0000000000000000")
                    (str_concat (bml-source-manifest-row "C" (host_cwd) "0000000000000000")
                      (str_concat (bml-source-manifest-row "H" home-path "0000000000000000")
                        (str_concat (bml-source-manifest (nth compiler 2))
                            (str_concat prefix (form-source-compile-loop src path 0 (nth catalog 1))))))))))

    (defn form-source-compile-file (in-path out-path)
        (do
            (let src (read_file in-path))
            (let compiled (form-source-compile-text src in-path))
            (write_file_text out-path compiled)))

0
