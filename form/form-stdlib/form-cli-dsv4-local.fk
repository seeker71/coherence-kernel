; form-cli-dsv4-local.fk — Form-owned offline DS4 inquiry route.
;
; Form owns prompt shaping, tokenization, the numeric carrier offer, result
; extraction, native token decode, content identities, and framebuffer inquiry
; surfaces. The current carrier crossing runs Form-emitted Metal kernels and
; returns its own detailed boundary/stage/state trace.
;
; preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk form-stdlib/dsv4-tokenizer.fk form-stdlib/dsv4-generation-request.fk form-stdlib/sha256.fk form-stdlib/native-model-evidence.fk form-stdlib/content-addressed-membrane.fk form-stdlib/content-addressed-membrane-framebuffer.fk config/dsv4-local-resource.fk native/metal/dsv4-native-session.fk

(do
    ; fkwu's current fs_mkdir carrier creates one level at a time. Keep that
    ; boundary explicit so a successful generation can never lose its receipt
    ; merely because an intermediate Form-owned directory was absent.
    (defn fdl-ensure-receipt-dir (root)
        (do
            (let body (str_concat root "/form-cli"))
            (let receipts (str_concat body "/receipts"))
            (fs_mkdir root)
            (fs_mkdir body)
            (fs_mkdir receipts)
            receipts))

    (defn fdl-chat-ids (src question)
        (append
            (list
                (tkz-stored-id-of src "<｜begin▁of▁sentence｜>")
                (tkz-stored-id-of src "<｜User｜>"))
            (append
                (tkz-encode src question)
                (list
                    (tkz-stored-id-of src "<｜Assistant｜>")
                    (tkz-stored-id-of src "</think>")))))

    (defn fdl-command (model ids n)
        (do
            (let csv (dgr-ids-csv ids))
            (let count (int_to_str n))
            (let a (str_concat (dsv4-local-carrier-resource) " "))
            (let b (str_concat a model))
            (let c (str_concat b " 0 --generate "))
            (let d (str_concat c csv))
            (str_concat d (str_concat " " count))))

    (defn fdl-tokenize (question)
        (do
            (let model (dsv4-local-model-resource))
            (let src (tkz-src model))
            (let ids (fdl-chat-ids src question))
            (let csv (dgr-ids-csv ids))
            (let r0 (str_concat "PASS form-cli-ds4-tokenize\nmodel=" model))
            (let r1 (str_concat r0
                (str_concat "\nprompt-token-count=" (int_to_str (len ids)))))
            (let r2 (str_concat r1 (str_concat "\nprompt-token-ids=" csv)))
            (let r3 (str_concat r2
                "\nprompt-shape=bos+user+content+assistant+think-end"))
            (let r4 (str_concat r3 "\ntokenizer-owner=form-native-gguf"))
            (let r5 (str_concat r4 "\nnetwork=0\nremote=0"))
            (str_concat r5 "\nrewitness-offer=form-cli-ds4-tokenize")))

    (defn fdl-line-value (text prefix)
        (do
            (let at (str_find text prefix 0))
            (if (lt at 0) ""
                (do
                    (let start (add at (str_len prefix)))
                    (let stop0 (str_find text "\n" start))
                    (let stop (if (lt stop0 0) (str_len text) stop0))
                    (substring text start stop)))))

    (defn fdl-result-csv (trace)
        (fdl-line-value trace "DS4-GENERATED-TOKEN-IDS "))

    (defn fdl-stop (trace)
        (fdl-line-value trace "TRACE result.stop="))

    (defn fdl-crossing-text (label crossing)
        (do
            (let x0 (str_concat label (str_concat ".id=" (cam-id crossing))))
            (let x1 (str_concat x0 (str_concat "\n" label)))
            (let x2 (str_concat x1 (str_concat ".payload-id=" (cam-payload-id crossing))))
            (let x3 (str_concat x2 (str_concat "\n" label)))
            (let x4 (str_concat x3 (str_concat ".what=" (cam-what crossing))))
            (let x5 (str_concat x4 (str_concat "\n" label)))
            (let x6 (str_concat x5 (str_concat ".where=" (cam-where crossing))))
            (let x7 (str_concat x6 (str_concat "\n" label)))
            (let x8 (str_concat x7 (str_concat ".when=" (cam-when crossing))))
            (let x9 (str_concat x8 (str_concat "\n" label)))
            (let x10 (str_concat x9 (str_concat ".who=" (cam-who crossing))))
            (let x11 (str_concat x10 (str_concat "\n" label)))
            (let x12 (str_concat x11 (str_concat ".how=" (cam-how crossing))))
            (let x13 (str_concat x12 (str_concat "\n" label)))
            (let x14 (str_concat x13 (str_concat ".which=" (cam-which crossing))))
            (let x15 (str_concat x14 (str_concat "\n" label)))
            (let x16 (str_concat x15 (str_concat ".why=" (cam-why crossing))))
            (let x17 (str_concat x16 (str_concat "\n" label)))
            (let x18 (str_concat x17 (str_concat ".root=" (cam-root crossing))))
            (let x19 (str_concat x18 (str_concat "\n" label)))
            (let x20 (str_concat x19 (str_concat ".freedom=" (cam-freedom crossing))))
            (let x21 (str_concat x20 (str_concat "\n" label)))
            (let x22 (str_concat x21 (str_concat ".freshness=" (cam-freshness crossing))))
            (let x23 (str_concat x22 (str_concat "\n" label)))
            (str_concat x23 (str_concat ".outcome=" (cam-outcome crossing)))))

    (defn fdl-crossing
        (payload what where when who how which why root freedom elapsed outcome)
        (cam-crossing
            (nmfe-sha256 payload)
            what where when who how which why root freedom
            1 elapsed
            "Form-native command encoder and direct result value"
            "this request"
            outcome))

    (defn fdl-inquiry-result (offered lane line)
        (do
            (let response (camf-inquire
                offered (cam-id (camf-receipt offered)) lane
                "form-stdlib/form-cli-dsv4-local.fk" line 1))
            (let r0 (str_concat lane ".ack="))
            (let r1 (str_concat r0 (nth response 0)))
            (let r2 (str_concat r1 "\n"))
            (let r3 (str_concat r2 lane))
            (let r4 (str_concat r3 ".value="))
            (str_concat r4 (nth response 1))))

    (defn fdl-inquire-lanes (offered lanes line)
        (if (eq (len lanes) 0) ""
            (do
                (let here (fdl-inquiry-result offered (head lanes) line))
                (let rest (fdl-inquire-lanes offered (tail lanes) (add line 1)))
                (if (eq (str_len rest) 0) here
                    (str_concat here (str_concat "\n" rest))))))

    (defn fdl-inquire-basic (offered line)
        (fdl-inquire-lanes offered
            (list "what" "where" "when" "who" "how"
                  "which" "why" "root" "freedom")
            line))

    (defn fdl-render (question n)
        (do
            (let model (dsv4-local-model-resource))
            (let before (fdl-crossing
                question
                "natural-language DS4 generation offer"
                "Form body to linked local model organ"
                "before local execution"
                "form-cli DS4 route"
                "one in-process local_model_generate call"
                "local DS4 engine over the configured 43-layer GGUF"
                "the resident local engine owns tokenization, prefill, and decode"
                "Form question value and local GGUF resource"
                "replace rented engine stages with Form-owned Metal recipes"
                0 "offered"))
            (let before-offer (camf-offer before
                "form-stdlib/form-cli-dsv4-local.fk" 78 1
                (intern_trivial_int 0)))
            (let trace (local_model_generate model question n))
            (let answer (fdl-line-value trace "DS4-GENERATED-TEXT "))
            (let result-csv (fdl-result-csv trace))
            (let after (fdl-crossing
                answer
                "decoded DS4 token stream"
                "local carrier cell to Form body"
                "after local execution"
                "form-cli DS4 route"
                "resident engine token callback and tokenizer decode"
                "full-vocabulary generated text"
                "Form requires the generated value to render the response"
                "GGUF output head and tokenizer vocabulary"
                "return the generated bytes directly as a Form value"
                0
                (if (eq (str_len answer) 0) "nothing" "success")))
            (let after-offer (camf-offer after
                "form-stdlib/form-cli-dsv4-local.fk" 102 1
                (camf-event before-offer)))
            (let r0 (str_concat answer
                "\nform-cli-generation-lane:local-ds4-form-metal"))
            (let r1 (str_concat r0 (str_concat "\nform-cli-model:" model)))
            (let r2 (str_concat r1
                (str_concat "\nform-cli-prompt-token-count:"
                    (fdl-line-value trace "TRACE request.prompt-token-count="))))
            (let r3 (str_concat r2
                "\nform-cli-prompt-token-owner:resident-ds4-engine"))
            (let r4 (str_concat r3
                (str_concat "\nform-cli-result-token-count:"
                    (fdl-line-value trace "ACK 1 local-in-process-generation prompt="))))
            (let r5 (str_concat r4
                (str_concat "\nform-cli-result-token-ids:" result-csv)))
            (let r6 (str_concat r5
                (str_concat "\nform-cli-result-stop:" (fdl-stop trace))))
            (let r7 (str_concat r6
                (str_concat "\nform-cli-prompt-crossing-id:" (cam-id before))))
            (let r8 (str_concat r7
                (str_concat "\nform-cli-result-crossing-id:" (cam-id after))))
            (let r9 (str_concat r8
                (str_concat "\nform-cli-framebuffer-events:"
                    (int_to_str (len (framebuffer-events))))))
            (let r10 (str_concat r9
                "\nform-cli-form-owned-routing-attempts:1\nform-cli-local-ds4-attempts:1"))
            (let r11 (str_concat r10
                (str_concat "\nform-cli-local-ds4-accepted:"
                    (if (gt (str_len answer) 0) "1" "0"))))
            (let r12 (str_concat r11
                "\nform-cli-remote-attempts:0\nform-cli-remote-accepted:0"))
            (let r13 (str_concat r12
                "\nform-cli-network:0\nform-cli-end-to-end-form-native:0\nform-cli-host-exec-crossings:0\nform-cli-shell-crossings:0\nform-cli-swift-crossings:0\nform-cli-local-rented-engine-crossings:1\nform-cli-carrier-trace:\n"))
            (let r14 (str_concat r13 trace))
            (let run-id (nmfe-sha256
                (nmfe-fields
                    (list model question result-csv
                          (cam-id before) (cam-id after)))))
            (let receipt-root ".coherence-network/form-cli")
            (let receipt-dir
                (fdl-ensure-receipt-dir ".coherence-network"))
            (let receipt-path (str_concat receipt-dir
                (str_concat "/" (str_concat run-id ".receipt.txt"))))
            (let q0 (str_concat "form-cli-receipt-version=1\nrun-id=" run-id))
            (let q1 (str_concat q0 (str_concat "\nmodel=" model)))
            (let q2 (str_concat q1 (str_concat "\nquestion=" question)))
            (let q3 (str_concat q2 "\nprompt-token-owner=resident-ds4-engine"))
            (let q4 (str_concat q3 (str_concat "\nresult-token-ids=" result-csv)))
            (let q5 (str_concat q4 (str_concat "\nanswer=" answer)))
            (let q6 (str_concat q5
                (str_concat "\n" (fdl-crossing-text "prompt-crossing" before))))
            (let q7 (str_concat q6
                (str_concat "\n" (fdl-crossing-text "result-crossing" after))))
            (let receipt (str_concat q7 (str_concat "\ncarrier-trace=\n" trace)))
            (let wrote (write_file receipt-path receipt))
            (let r15 (str_concat r14
                (str_concat "\nform-cli-run-id:" run-id)))
            (let r16 (str_concat r15
                (str_concat "\nform-cli-receipt-path:" receipt-path)))
            (let r17 (str_concat r16
                (str_concat "\nform-cli-receipt-written:"
                    (if (gt wrote 0) "1" "0"))))
            (str_concat r17
                (str_concat "\nform-cli-rewitness-offer:rewitness " question))))

    (defn fdl-native-render (question n)
        (do
            (let model (dsv4-local-model-resource))
            (let src (tkz-src model))
            (let prompt-ids (fdl-chat-ids src question))
            (let prompt-csv (dgr-ids-csv prompt-ids))
            (let before (fdl-crossing
                prompt-csv
                "tokenized inquiry offered to the native DS4 generation session"
                "Form CLI body to its in-process Form-emitted Metal model organ"
                "after native GGUF tokenization and before model prefill"
                "form-cli native DS4 route"
                "direct Form values through linked native model operations"
                "configured local 43-layer DS4 GGUF"
                "the inquiry asks for locally generalized generated tokens"
                "Form prompt recipe, GGUF tensors, and native Metal recipes"
                "fuse repeated model walks into the Form JIT when re-witnessed healthy"
                0 "offered"))
            (let before-offer (camf-offer before
                "form-stdlib/form-cli-dsv4-local.fk" 215 1
                (intern_trivial_int 0)))
            (let result-ids
                (dns-generate-ids-jit
                    (dsv4-local-jit-carrier-resource)
                    prompt-ids n))
            (let result-csv (dgr-ids-csv result-ids))
            (let answer (tkz-decode-text src result-ids))
            (let after (fdl-crossing
                result-csv
                "native argmax token ids and GGUF-vocabulary decoded answer"
                "in-process Form-emitted Metal model organ to Form CLI body"
                "after autoregressive generation and native decode"
                "form-cli native DS4 route"
                "native output head selects ids; Form tokenizer renders their bytes"
                "the generated token sequence selected from the full vocabulary"
                "the caller needs inspectable generated evidence rather than stored prose"
                "model output tensors, argmax recipe, and GGUF tokenizer vocabulary"
                "retain token ids as the replayable ground for every rendered answer"
                0 (if (eq (len result-ids) 0) "nothing" "success")))
            (let after-offer (camf-offer after
                "form-stdlib/form-cli-dsv4-local.fk" 232 1
                (camf-event before-offer)))
            (let r0 (str_concat answer
                "\nform-cli-generation-lane:native-ds4-form-metal"))
            (let r1 (str_concat r0 (str_concat "\nform-cli-model:" model)))
            (let r2 (str_concat r1
                (str_concat "\nform-cli-prompt-token-count:"
                    (int_to_str (len prompt-ids)))))
            (let r3 (str_concat r2
                (str_concat "\nform-cli-prompt-token-ids:" prompt-csv)))
            (let r4 (str_concat r3
                (str_concat "\nform-cli-result-token-count:"
                    (int_to_str (len result-ids)))))
            (let r5 (str_concat r4
                (str_concat "\nform-cli-result-token-ids:" result-csv)))
            (let r6 (str_concat r5
                "\nform-cli-form-owned-routing-attempts:1"))
            (let r7 (str_concat r6
                "\nform-cli-local-ds4-attempts:1\nform-cli-local-ds4-accepted:1"))
            (let r8 (str_concat r7
                "\nform-cli-remote-attempts:0\nform-cli-remote-accepted:0"))
            (let r9 (str_concat r8
                "\nform-cli-network:0\nform-cli-end-to-end-form-native:1"))
            (let r10 (str_concat r9
                "\nform-cli-host-exec-crossings:0\nform-cli-shell-crossings:0"))
            (let r11 (str_concat r10
                "\nform-cli-swift-crossings:0\nform-cli-temp-crossings:0"))
            (let r12 (str_concat r11
                (str_concat "\nform-cli-prompt-crossing-id:" (cam-id before))))
            (let r13 (str_concat r12
                (str_concat "\nform-cli-result-crossing-id:" (cam-id after))))
            (let r14 (str_concat r13
                (str_concat "\nform-cli-framebuffer-events:"
                    (int_to_str (len (framebuffer-events))))))
            (let r15 (str_concat r14
                (str_concat "\n" (fdl-crossing-text "prompt-crossing" before))))
            (let r16 (str_concat r15
                (str_concat "\n" (fdl-crossing-text "result-crossing" after))))
            (let r17 (str_concat r16
                (str_concat "\nprompt-crossing-inquiries:\n"
                    (fdl-inquire-basic before-offer 250))))
            (let r18 (str_concat r17
                (str_concat "\nresult-crossing-inquiries:\n"
                    (fdl-inquire-basic after-offer 260))))
            (let run-id (nmfe-sha256
                (nmfe-fields
                    (list model question prompt-csv result-csv
                          (cam-id before) (cam-id after)))))
            (let receipt-root ".coherence-network/form-cli")
            (let receipt-dir
                (fdl-ensure-receipt-dir ".coherence-network"))
            (let receipt-path (str_concat receipt-dir
                (str_concat "/" (str_concat run-id ".native.receipt.txt"))))
            (let receipt (str_concat
                "form-cli-native-receipt-version=1\n"
                (str_concat "run-id="
                    (str_concat run-id
                        (str_concat "\nquestion="
                            (str_concat question
                                (str_concat "\n" r18)))))))
            (let wrote (write_file receipt-path receipt))
            (let r19 (str_concat r18
                (str_concat "\nform-cli-run-id:" run-id)))
            (let r20 (str_concat r19
                (str_concat "\nform-cli-receipt-path:" receipt-path)))
            (let r21 (str_concat r20
                (str_concat "\nform-cli-receipt-written:"
                    (if (gt wrote 0) "1" "0"))))
            (str_concat r21
                (str_concat "\nform-cli-rewitness-offer:rewitness " question))))

    (defn fdl-generate (question) (fdl-native-render question 64))
    0)
