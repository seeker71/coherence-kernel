; living-world-recipe-tree-revision-prospective.fk -- a fresh three-way
; prospective comparison for the contradiction-composed successor.
;
; Historical incumbent, first Recipe-tree successor, and new composed
; successor execute the same exact dataset/split/contract.  Prospective binding
; identities must be disjoint from original retained bindings and the earlier
; E/F suite.  Suite sources must be recurrent and disjoint from construction
; and scoped-trial sources A-J.  Every match is evaluated; no representative is
; selected.  This is diagnostic non-promotion evidence only.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk

(let LWRTRP-DERIVATION (bp "LWRTRP-DERIVATION"))

(defn lwrtrp-parent-successor (candidate)
    (if (eq (lwrtrh-candidate? candidate) 0) (lwo-none)
        (do
            (let field (lwo-emergent-shape candidate))
            (let composition-candidate
                (lwrtrh-field-composition-candidate field))
            (lwrtr-field-successor
                (lwo-emergent-shape composition-candidate)))))
(defn lwrtrp-target-for (candidate)
    (lwrtep-target-for (lwrtrp-parent-successor candidate)))

(defn lwrtrp-history-bindings (candidate)
    (do
        (let field (lwo-emergent-shape candidate))
        (let composition-candidate
            (lwrtrh-field-composition-candidate field))
        (let composition-field (lwo-emergent-shape composition-candidate))
        (let prior-suite (lwrtr-field-suite composition-field))
        (lwrtr-union-items
            (lwo-field-items
                (lwps-dataset-bindings
                    (lwps-suite-dataset prior-suite)))
            (lwrtep-retained-bindings (lwrtrp-target-for candidate)))))
(defn lwrtrp-identity-clean? (candidate suite)
    (if (or (eq (lwrtrh-candidate? candidate) 0)
            (eq (lwps-suite-shape-valid? suite) 0)) 0
        (lwps-fields-disjoint?
            (lwps-split-prospective (lwps-suite-split suite))
            (lwrtrp-history-bindings candidate))))

(defn lwrtrp-match-source-clean-items? (items suite-sources)
    (if (eq (len items) 0) 1
        (do
            (let match (head items))
            (if (and
                    (eq (lwrth-fields-disjoint? suite-sources
                            (lwrtrh-match-construction-sources match)) 1)
                    (eq (lwrth-fields-disjoint? suite-sources
                            (lwrtrh-match-trial-sources match)) 1))
                (lwrtrp-match-source-clean-items? (tail items) suite-sources)
                0))))
(defn lwrtrp-source-clean? (world candidate suite threshold)
    (if (or (lt threshold 1)
            (eq (lwrtrh-candidate? candidate) 0)) 0
        (do
            (let sources (lwrtep-suite-sources world suite))
            (let matches
                (lwrtrh-field-matches (lwo-emergent-shape candidate)))
            (if (and (ge (lwo-field-size sources) threshold)
                     (eq (lwrtrp-match-source-clean-items?
                            (lwo-field-items matches) sources) 1)) 1 0))))
(defn lwrtrp-ready? (world candidate suite threshold)
    ; Suite recurrence closes first, before the successor graph is revisited.
    (if (eq (lwps-suite-current? world suite threshold) 0) 0
        (if (eq (lwrtrh-integrated-current? world candidate) 0) 0
            (if (eq (lwrtrp-identity-clean? candidate suite) 0) 0
                (lwrtrp-source-clean? world candidate suite threshold)))))

; children: exact successor match, Recipe, bindings, output, exact bit, path.
(defn lwrtrp-derivation (match bindings output exact)
    (intern_node LWRTRP-DERIVATION
        (list match (lwrtrh-match-recipe match) bindings output
              (intern_trivial_int exact) (lwo-local-path))))
(defn lwrtrp-derivation-output (derivation)
    (nth (node_children derivation) 3))
(defn lwrtrp-derive-items
    (items bindings expected derivations outputs matches)
    (if (eq (len items) 0) (list derivations outputs matches)
        (do
            (let match (head items))
            (let output
                (intern_trivial_int
                    (lwre-evaluate-bound
                        (lwrtrh-match-recipe match) bindings)))
            (let exact (if (node_eq output expected) 1 0))
            (let derivation
                (lwrtrp-derivation match bindings output exact))
            (lwrtrp-derive-items (tail items) bindings expected
                (lwo-field-add derivations derivation)
                (lwo-field-add outputs output)
                (if (eq exact 1)
                    (lwo-field-add matches derivation) matches)))))
(defn lwrtrp-place (candidate case)
    (do
        (let ack (lwps-case-immediate case))
        (let result
            (if (eq (oac-one? ack) 1)
                (lwrtrp-derive-items
                    (lwo-field-items
                        (lwrtrh-field-matches
                            (lwo-emergent-shape candidate)))
                    (lwps-case-bindings case) (oac-payload ack)
                    (lwo-empty-field) (lwo-empty-field) (lwo-empty-field))
                (list (lwo-empty-field) (lwo-empty-field)
                      (lwo-empty-field))))
        (lwps-placement case (nth result 0) (nth result 1) (nth result 2)
            (lwps-case-time case) (lwps-case-alternatives case)
            (lwps-case-unknown case) (lwps-case-lens case)
            (lwps-case-evidence case))))
(defn lwrtrp-place-items (items candidate field)
    (if (eq (len items) 0) field
        (lwrtrp-place-items (tail items) candidate
            (lwo-field-add field (lwrtrp-place candidate (head items))))))

(defn lwrtrp-evaluate-new-ready (candidate suite)
    (do
        (let dataset (lwps-suite-dataset suite))
        (let placements
            (lwrtrp-place-items
                (lwo-field-items (lwps-dataset-cases dataset)) candidate
                (lwo-empty-field)))
        (lwps-evaluation candidate dataset (lwps-suite-split suite)
            (lwps-suite-contract suite) placements
            (lwps-metrics-for placements))))
(defn lwrtrp-evaluate-first-ready (candidate suite)
    (lwrtep-evaluate-successor-ready
        (lwrtrp-parent-successor candidate) suite))
(defn lwrtrp-evaluate-incumbent-ready (candidate suite)
    (lwrtep-evaluate-incumbent-ready
        (lwrtrp-parent-successor candidate) suite))

(defn lwrtrp-evaluate-new (world candidate suite threshold)
    (if (eq (lwrtrp-ready? world candidate suite threshold) 0) (lwo-none)
        (lwrtrp-evaluate-new-ready candidate suite)))
(defn lwrtrp-evaluate-first (world candidate suite threshold)
    (if (eq (lwrtrp-ready? world candidate suite threshold) 0) (lwo-none)
        (lwrtrp-evaluate-first-ready candidate suite)))
(defn lwrtrp-evaluate-incumbent (world candidate suite threshold)
    (if (eq (lwrtrp-ready? world candidate suite threshold) 0) (lwo-none)
        (lwrtrp-evaluate-incumbent-ready candidate suite)))

(defn lwrtrp-compare-first-new (world candidate suite threshold)
    (if (eq (lwrtrp-ready? world candidate suite threshold) 0) (lwo-none)
        (lwps-compare (lwrtrp-evaluate-first-ready candidate suite)
            (lwrtrp-evaluate-new-ready candidate suite))))
(defn lwrtrp-compare-incumbent-new (world candidate suite threshold)
    (if (eq (lwrtrp-ready? world candidate suite threshold) 0) (lwo-none)
        (lwps-compare (lwrtrp-evaluate-incumbent-ready candidate suite)
            (lwrtrp-evaluate-new-ready candidate suite))))

(defn lwrtrp-progress-target (comparison)
    (if (node_eq comparison (lwo-none)) "comparison:nothing"
        (do
            (let delta
                (lwps-delta-values (lwps-comparison-delta comparison)))
            (lcfb-cat (list
                "admissible:"
                (int_to_str (lwps-comparison-admissible comparison))
                ":exact-delta:" (int_to_str (nth delta 2))
                ":plural-delta:" (int_to_str (nth delta 3))
                ":contradicted-delta:" (int_to_str (nth delta 4)))))))

