; form-knowledge-qwen-heldout-v2-diagnostic.fk -- one sealed held-out row,
; observed without crossing its prompt or answer into stdout.
;
; This cell is pure. It owns the strict selector, dataset-and-row-bound consent,
; admission shape, and the bounded allowlist for scalar generation-report
; metadata. The effectful door is the adjacent *-run.fk cell.
;
; This is deliberately not a small version of the 15-family evaluator. It has
; no aggregate and no ready95/full-suite credit path. Its only purpose is to
; re-observe one named row after a generation-path repair without paying for
; fourteen unrelated model calls.
;
; The report window ends immediately before `\ntext:\n`. Values are admitted
; only when they are short ASCII scalar tokens. Thus neither generated text nor
; a field-shaped string emitted by the model can enter the diagnostic record.
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-eval.fk
; Proven by: form-stdlib/tests/form-knowledge-qwen-heldout-v2-diagnostic-band.fk
; witnessed: 2026-08-24 -> band 8191 on fkwu; local model not invoked

(do
    (defn fkhv2-scope ()
        "isolated-heldout-v2-diagnostic-no-full-suite-credit")
    (defn fkhv2-selector-path ()
        ".form-knowledge-qwen-heldout-v2-selector")
    (defn fkhv2-consent-path ()
        ".form-knowledge-qwen-heldout-v2-consent")
    (defn fkhv2-max-stage-value-bytes () 64)

    ; One optional LF is the entire convenience surface. Spaces, CRLF, extra
    ; lines, and comments are rejected so selection can never be ambiguous.
    (defn fkhv2-drop-one-lf (s)
        (if (eq (str_len s) 0) ""
            (if (str_eq (char_at s (sub (str_len s) 1)) "\n")
                (substring s 0 (sub (str_len s) 1)) s)))
    (defn fkhv2-selector-id (raw)
        (do
            (let id (fkhv2-drop-one-lf raw))
            (if (or (eq (str_len id) 0)
                    (or (ge (str_find id "\n" 0) 0)
                        (ge (str_find id "\r" 0) 0))) "" id)))
    (defn fkhv2-selected-row (raw)
        (do
            (let id (fkhv2-selector-id raw))
            (if (str_eq id "") (list) (fkhe-find-row id (fkhe-rows)))))

    ; V2 consent binds both the immutable dataset seal and the one row that may
    ; run. Consent for h01 can never admit h03, even in the same checkout.
    (defn fkhv2-consent-token (id)
        (str_concat "run-local-qwen-heldout-v2:"
            (str_concat (fkhe-dataset-seal) (str_concat ":" id))))
    (defn fkhv2-consent-valid? (supplied id)
        (if (str_eq supplied (fkhv2-consent-token id)) 1
            (if (str_eq supplied
                    (str_concat (fkhv2-consent-token id) "\n")) 1 0)))

    ; plan = tag admitted missing-field id family. The missing field is a name,
    ; never supplied selector content. Dataset validity is handed in so the
    ; refusal band remains pure; the live door computes it only after selector
    ; and consent have both passed.
    (defn fkhv2-plan (admitted missing row)
        (list "form-knowledge-qwen-heldout-v2-diagnostic-plan" admitted missing
              (if (eq (len row) 0) "missing" (fkhe-id row))
              (if (eq (len row) 0) "missing" (fkhe-family row))))
    (defn fkhv2-plan-admitted (p) (nth p 1))
    (defn fkhv2-plan-missing (p) (nth p 2))
    (defn fkhv2-plan-id (p) (nth p 3))
    (defn fkhv2-plan-family (p) (nth p 4))
    (defn fkhv2-plan-with (dataset-ok selector consent)
        (do
            (let row (fkhv2-selected-row selector))
            (if (eq (len row) 0)
                (fkhv2-plan 0 "selected-heldout-row" row)
                (if (eq (fkhv2-consent-valid? consent (fkhe-id row)) 0)
                    (fkhv2-plan 0 "dataset-and-row-bound-v2-consent" row)
                    (if (not (eq dataset-ok 1))
                        (fkhv2-plan 0 "sealed-current-heldout-dataset" row)
                        (fkhv2-plan 1 "" row))))))

    ; Only scalar, non-content fields from fcmg-report are eligible. The last
    ; twelve are the two-ledger observation shape. A generator that has not yet
    ; landed them reports each one explicitly missing; absence never looks like
    ; a zero.
    (defn fkhv2-stage-fields ()
        (list "generated_tokens"
              "heed_cursor"
              "heed_lookup_budget"
              "heed_lookup_budget_remaining"
              "heed_honor_attempts"
              "heed_lookups"
              "heed_source_searches"
              "heed_honored"
              "heed_hits"
              "heed_misses"
              "heed_nothings"
              "heed_spent"
              "heed_injected_tokens"
              "heed_close_commits"
              "heed_terminal_forwards"
              "heed_injection_refusals"
              "heed_window_bytes"
              "heed_evidence_status"
              "heed_evidence_reason"
              "heed_model_executed"
              "heed_phase"
              "heed_query_budget"
              "heed_answer_reserve"
              "heed_query_tokens"
              "heed_answer_tokens"
              "heed_query_left"
              "heed_answer_left"
              "heed_query_fuel_cut"
              "heed_stream_bytes"
              "heed_decode_timeout"
              "heed_stopped"
              "heed_frame_refusals"))
    (defn fkhv2-stage-field-known? (name fields)
        (if (eq (len fields) 0) 0
            (if (str_eq name (head fields)) 1
                (fkhv2-stage-field-known? name (tail fields)))))

    ; Isolate the native report. Missing backend or text boundaries means there
    ; is no report window, so every stage field remains explicitly missing.
    (defn fkhv2-report-window (raw)
        (do
            (let marked (str_find raw "\nbackend=" 0))
            (let start
                (if (ge marked 0) (add marked 1)
                    (if (eq (str_find raw "backend=" 0) 0) 0 (sub 0 1))))
            (if (lt start 0) ""
                (do
                    (let end (str_find raw "\ntext:\n" start))
                    (if (lt end 0) "" (substring raw start end))))))

    (defn fkhv2-ascii-stage-char? (ch)
        (do
            (let c (ord ch))
            (if (or (and (ge c 48) (le c 57))
                    (or (and (ge c 65) (le c 90))
                    (or (and (ge c 97) (le c 122))
                        (or (eq c 45) (or (eq c 46) (eq c 95)))))) 1 0)))
    (defn fkhv2-ascii-stage-value-loop? (s i)
        (if (ge i (str_len s)) 1
            (if (eq (fkhv2-ascii-stage-char? (char_at s i)) 1)
                (fkhv2-ascii-stage-value-loop? s (add i 1)) 0)))
    (defn fkhv2-ascii-stage-value? (s)
        (fkhv2-ascii-stage-value-loop? s 0))
    (defn fkhv2-safe-stage-value (s)
        (if (eq (str_len s) 0) "empty"
            (if (gt (str_len s) (fkhv2-max-stage-value-bytes))
                "redacted-over-limit"
                (if (eq (fkhv2-ascii-stage-value? s) 1) s
                    "redacted-nonstage-value"))))

    ; field = tag name present safe-value
    (defn fkhv2-stage-field (window name)
        (if (eq (fkhv2-stage-field-known? name (fkhv2-stage-fields)) 0)
            (list "form-knowledge-qwen-heldout-v2-stage-field" name 0 "")
            (do
                (let marker (str_concat "\n" (str_concat name "=")))
                (let at (str_find window marker 0))
                (if (lt at 0)
                    (list "form-knowledge-qwen-heldout-v2-stage-field" name 0 "")
                    (do
                        (let start (add at (str_len marker)))
                        (let nl (str_find window "\n" start))
                        (let end (if (lt nl 0) (str_len window) nl))
                        (list "form-knowledge-qwen-heldout-v2-stage-field" name 1
                              (fkhv2-safe-stage-value
                                  (substring window start end))))))))
    (defn fkhv2-stage-name (f) (nth f 1))
    (defn fkhv2-stage-present (f) (nth f 2))
    (defn fkhv2-stage-value (f) (nth f 3))
    (defn fkhv2-stage-records-loop (window names)
        (if (eq (len names) 0) (list)
            (cons (fkhv2-stage-field window (head names))
                  (fkhv2-stage-records-loop window (tail names)))))
    (defn fkhv2-stage-records (raw)
        (fkhv2-stage-records-loop
            (fkhv2-report-window raw) (fkhv2-stage-fields)))

    (defn fkhv2-line (name value)
        (str_concat name (str_concat "=" (str_concat value "\n"))))
    (defn fkhv2-base-lines
        (id family exact f1 sequence promotion error latency)
        (str_concat (fkhv2-line "id" id)
        (str_concat (fkhv2-line "family" family)
        (str_concat (fkhv2-line "exact-ppm" (int_to_str exact))
        (str_concat (fkhv2-line "f1-ppm" (int_to_str f1))
        (str_concat (fkhv2-line "sequence-ppm" (int_to_str sequence))
        (str_concat (fkhv2-line "promotion-ppm" (int_to_str promotion))
        (str_concat (fkhv2-line "error" (int_to_str error))
                    (fkhv2-line "latency-ms" (int_to_str latency))))))))))
    (defn fkhv2-stage-line (f)
        (if (eq (fkhv2-stage-present f) 1)
            (str_concat "stage-" (str_concat (fkhv2-stage-name f)
                (str_concat "=" (str_concat (fkhv2-stage-value f) "\n"))))
            (str_concat "stage-missing-field="
                (str_concat (fkhv2-stage-name f) "\n"))))
    (defn fkhv2-stage-lines-loop (fields acc)
        (if (eq (len fields) 0) acc
            (fkhv2-stage-lines-loop (tail fields)
                (str_concat acc (fkhv2-stage-line (head fields))))))
    (defn fkhv2-stage-lines (raw)
        (fkhv2-stage-lines-loop (fkhv2-stage-records raw) ""))
    (defn fkhv2-refusal-lines (p)
        (str_concat
            (fkhv2-base-lines (fkhv2-plan-id p) (fkhv2-plan-family p)
                0 0 0 0 1 0)
            (str_concat "stage-missing-field=generation-report-absent-"
                (str_concat (fkhv2-plan-missing p) "\n"))))
    0)
