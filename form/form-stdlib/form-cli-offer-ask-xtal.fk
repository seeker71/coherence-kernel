
(let Offer (language-template-with-members "Offer" (list "T") (list (language-template-member "delay" "int") (language-template-member "cost" "int") (language-template-member "payload" "T"))))
(let QueryRow (language-template-with-members "QueryRow" (list "TQuery" "T") (list (language-template-member "query" "TQuery") (language-template-member "held" "Offer<T>"))))
(defn OfferAuthorityPath () "form/form-stdlib/bml/form-cli-offer-ask.bml")
(defn OfferAuthorityKind () "high-bml-class-template-field")
(defn FormOfferAskAuthority () (list "abstraction" "FormOfferAskAuthority" (list) (list) (list "OfferAuthorityPath" "OfferAuthorityKind") (list) (list)))
(defn MixA () 7)
(defn MixB () 13)
(defn DelayOffer () 0)
(defn DelayAsk () 1)
(defn CostOutside () 0)
(defn foa-authority () FormOfferAskAuthority)
(defn foa-pattern () (list "offer" "ask" "lookup" "catalog-n" "body-lookup" "cost-outside"))
(defn foa-absent () (tail (list "x")))
(defn foa-value (i) (add (mul i (MixA)) (MixB)))
(defn foa-query (i) (str_concat "q-" (int_to_str i)))
(defn foa-offer (x) (list "form-offer-v1" (DelayOffer) (CostOutside) x))
(defn foa-ask (p) (list "form-offer-v1" (DelayAsk) (nth p 2) (nth p 3)))
(defn foa-delay (p) (nth p 1))
(defn foa-cost (p) (nth p 2))
(defn foa-payload (p) (nth p 3))
(defn foa-reply (p) (if (eq (foa-delay p) (DelayAsk)) (foa-payload p) (foa-absent)))
(defn foa-row (i) (list (foa-query i) (foa-offer (foa-value i))))
(defn foa-catalog (n i acc) (if (eq i n) acc (foa-catalog n (add i 1) (cons (foa-row i) acc))))
(defn foa-rows (n) (foa-catalog n 0 (tail (list "x"))))
(defn foa-find (rows q) (if (eq (len rows) 0) (foa-absent) (if (str_eq (nth (head rows) 0) q) (nth (head rows) 1) (foa-find (tail rows) q))))
(defn foa-lookup (q n) (foa-find (foa-rows n) q))
(defn foa-ask-query (q n) (do (let p (foa-lookup q n)) (if (eq (len p) 0) (foa-absent) (foa-reply (foa-ask p)))))
(defn foa-row-ok (row) (do (let p (nth row 1)) (if (eq (len (foa-reply p)) 0) (if (eq (foa-reply (foa-ask p)) (foa-payload p)) 1 0) 0)))
(defn foa-catalog-ok (rows) (if (eq (len rows) 0) 1 (if (eq (foa-row-ok (head rows)) 0) 0 (foa-catalog-ok (tail rows)))))
(defn foa-catalog-live (n) (if (eq (len (foa-rows n)) 0) 0 (foa-catalog-ok (foa-rows n))))
(defn foa-from-word (w) (if (nothing? w) (foa-absent) (foa-offer w)))
(defn foa-body-lookup (q) (do (let rest (kra-answer q)) (if (eq (nothing? rest) 0) (foa-offer rest) (foa-from-word (kra-corpus-word q)))))
(defn foa-body-eval (x) (if (eq (lg-defer? x) 1) (lg-force x) x))
(defn foa-body-ask (q) (do (let p (foa-body-lookup q)) (if (eq (len p) 0) (foa-absent) (foa-body-eval (foa-reply (foa-ask p))))))
(defn foa-live-check () (do (let g (foa-body-lookup "bootstrap/ground")) (let restq "what names an answer that sleeps as a recipe until need wakes it into data?") (let c0 (foa-bit (eq (len (foa-body-lookup "no-such-query")) 0) 1)) (let c1 (foa-bit (eq (len (foa-reply g)) 0) 2)) (let c2 (foa-bit (eq (foa-body-ask "bootstrap/ground") 42) 4)) (let c3 (foa-bit (str_eq (foa-body-ask restq) "restanswer") 8)) (let c4 (foa-bit (eq (len (foa-body-lookup "a question the corpus never held")) 0) 16)) (let c5 (foa-bit (eq (lg-defer? (foa-payload g)) 1) 32)) (add c0 (add c1 (add c2 (add c3 (add c4 c5)))))))
(defn foa-bit (ok bit) (if ok bit 0))
(defn foa-check () (do (let n 8) (let rows (foa-rows n)) (let c0 (foa-bit (eq (len (foa-lookup "no-such" n)) 0) 1)) (let c1 (foa-bit (eq (len (foa-reply (foa-lookup "q-3" n))) 0) 2)) (let c2 (foa-bit (eq (foa-ask-query "q-3" n) (foa-value 3)) 4)) (let c3 (foa-bit (eq (foa-ask-query "q-0" n) (MixB)) 8)) (let c4 (foa-bit (eq (foa-catalog-live n) 1) 16)) (let c5 (foa-bit (eq (foa-cost (foa-lookup "q-3" n)) (CostOutside)) 32)) (let c6 (foa-bit (eq (len rows) n) 64)) (let c7 (foa-bit (eq (foa-catalog-live 16) 1) 128)) (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 c7)))))))))
(defn FormOfferAsk () (list "abstraction" "FormOfferAsk" (list "T") (list "foa-absent" "foa-value" "foa-query" "foa-offer" "foa-ask" "foa-delay" "foa-cost" "foa-payload" "foa-reply" "foa-row" "foa-catalog" "foa-rows" "foa-find" "foa-lookup" "foa-ask-query" "foa-row-ok" "foa-catalog-ok" "foa-catalog-live" "foa-from-word" "foa-body-lookup" "foa-body-eval" "foa-body-ask" "foa-live-check" "foa-bit" "foa-check") (list "MixA" "MixB" "DelayOffer" "DelayAsk" "CostOutside") (list "foa-authority") (list "foa-pattern")))
