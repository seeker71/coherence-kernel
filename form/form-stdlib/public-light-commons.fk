; public-light-commons.fk — form-neutral public routing through shared roles.
;
; The seven familiar names are locale aliases, never identity. Each role,
; route, state, scope, and cell kind is a numeric Form symbol composed by
; language-neutral-symbol-identity. A public message exists only after its
; author explicitly chooses public scope. The ledger is append-only: adding a
; message returns a new ledger and cannot rewrite an earlier cell.
;
; Shared roles are transparent symbols, not people or autonomous beings. A
; person may address a role or offer an expression through it; the author and
; route remain visible. This cell carries no private-circle packet or export.
;
; preludes: form-stdlib/core.fk cognition/language-neutral-symbol-identity.fk
;
; witnessed: 2026-08-15 -> fkwu 262143; Go/Rust/TypeScript agree at 262143

(do
    ;; Package 72 is the public light commons. Type coordinates keep roles,
    ;; routes, modes, cell kinds, and visibility in separate numeric planes.
    (defn plc-symbol (type instance) (lnsi-node 72 1 type instance))

    (defn plc-role-trust () (plc-symbol 1 1))
    (defn plc-role-clarity () (plc-symbol 1 2))
    (defn plc-role-surprise () (plc-symbol 1 3))
    (defn plc-role-joke () (plc-symbol 1 4))
    (defn plc-role-alien () (plc-symbol 1 5))
    (defn plc-role-beauty () (plc-symbol 1 6))
    (defn plc-role-fire () (plc-symbol 1 7))
    (defn plc-roles ()
        (list (plc-role-trust) (plc-role-clarity) (plc-role-surprise)
              (plc-role-joke) (plc-role-alien) (plc-role-beauty)
              (plc-role-fire)))

    (defn plc-route-to () (plc-symbol 2 1))
    (defn plc-route-through () (plc-symbol 2 2))
    (defn plc-mode-be () (plc-symbol 3 1))
    (defn plc-mode-do () (plc-symbol 3 2))
    (defn plc-mode-see () (plc-symbol 3 3))
    (defn plc-mode-humm () (plc-symbol 3 4))
    (defn plc-tag-message () (plc-symbol 4 1))
    (defn plc-scope-public () (plc-symbol 5 1))

    (defn plc-member? (values value)
        (if (nil? values) 0
            (if (eq (head values) value) 1
                (plc-member? (tail values) value))))
    (defn plc-role-known? (role) (plc-member? (plc-roles) role))
    (defn plc-route-known? (route)
        (if (eq route (plc-route-to)) 1
            (if (eq route (plc-route-through)) 1 0)))
    (defn plc-mode-known? (mode)
        (plc-member? (list (plc-mode-be) (plc-mode-do)
                           (plc-mode-see) (plc-mode-humm)) mode))
    (defn plc-nonempty? (value)
        (if (gt (str_len value) 0) 1 0))

    ;; Four locale surfaces demonstrate that spelling is an edge into one role
    ;; cell. Further locales extend this list without changing role identity.
    (defn plc-role-aliases ()
        (list
            (lnsi-alias 1 1 "en" "trust" (plc-role-trust))
            (lnsi-alias 1 1 "id" "kepercayaan" (plc-role-trust))
            (lnsi-alias 1 1 "zh" "信任" (plc-role-trust))
            (lnsi-alias 1 1 "ja" "信頼" (plc-role-trust))
            (lnsi-alias 1 1 "en" "clarity" (plc-role-clarity))
            (lnsi-alias 1 1 "id" "kejelasan" (plc-role-clarity))
            (lnsi-alias 1 1 "zh" "清晰" (plc-role-clarity))
            (lnsi-alias 1 1 "ja" "明晰" (plc-role-clarity))
            (lnsi-alias 1 1 "en" "surprise" (plc-role-surprise))
            (lnsi-alias 1 1 "id" "kejutan" (plc-role-surprise))
            (lnsi-alias 1 1 "zh" "惊喜" (plc-role-surprise))
            (lnsi-alias 1 1 "ja" "驚き" (plc-role-surprise))
            (lnsi-alias 1 1 "en" "joke" (plc-role-joke))
            (lnsi-alias 1 1 "id" "lelucon" (plc-role-joke))
            (lnsi-alias 1 1 "zh" "笑话" (plc-role-joke))
            (lnsi-alias 1 1 "ja" "冗談" (plc-role-joke))
            (lnsi-alias 1 1 "en" "alien" (plc-role-alien))
            (lnsi-alias 1 1 "id" "asing" (plc-role-alien))
            (lnsi-alias 1 1 "zh" "陌生" (plc-role-alien))
            (lnsi-alias 1 1 "ja" "異質" (plc-role-alien))
            (lnsi-alias 1 1 "en" "beauty" (plc-role-beauty))
            (lnsi-alias 1 1 "id" "keindahan" (plc-role-beauty))
            (lnsi-alias 1 1 "zh" "美" (plc-role-beauty))
            (lnsi-alias 1 1 "ja" "美" (plc-role-beauty))
            (lnsi-alias 1 1 "en" "fire" (plc-role-fire))
            (lnsi-alias 1 1 "id" "api" (plc-role-fire))
            (lnsi-alias 1 1 "zh" "火" (plc-role-fire))
            (lnsi-alias 1 1 "ja" "火" (plc-role-fire))))

    ;; The general lnsi resolver's dialect coordinate may be numeric. This
    ;; commons deliberately uses locale strings, so it keeps that comparison
    ;; typed here instead of asking an integer comparator to accept text.
    (defn plc-role-resolve-loop (aliases locale-name surface)
        (if (nil? aliases) (nothing)
            (do (let alias (head aliases))
                (if (and (str_eq (nth alias 2) locale-name)
                         (str_eq (nth alias 3) surface))
                    (nth alias 4)
                    (plc-role-resolve-loop (tail aliases) locale-name surface)))))
    (defn plc-role-resolve (locale-name surface)
        (plc-role-resolve-loop (plc-role-aliases) locale-name surface))
    (defn plc-role-render-loop (aliases role locale-name)
        (if (nil? aliases) (empty)
            (do (let alias (head aliases))
                (if (and (eq (nth alias 4) role)
                         (str_eq (nth alias 2) locale-name))
                    (list (nth alias 3))
                    (plc-role-render-loop (tail aliases) role locale-name)))))
    (defn plc-role-render-in (role locale-name)
        (plc-role-render-loop (plc-role-aliases) role locale-name))

    ;; These are authored interaction recipes, not claims of universal
    ;; semantics. They offer be/do/see/humm paths while preserving each role.
    (defn plc-role-recipe (role)
        (if (eq role (plc-role-trust))
            (list (plc-mode-be) (plc-mode-see))
        (if (eq role (plc-role-clarity))
            (list (plc-mode-see) (plc-mode-do))
        (if (eq role (plc-role-surprise))
            (list (plc-mode-see) (plc-mode-humm))
        (if (eq role (plc-role-joke))
            (list (plc-mode-do) (plc-mode-humm))
        (if (eq role (plc-role-alien))
            (list (plc-mode-see) (plc-mode-be))
        (if (eq role (plc-role-beauty))
            (list (plc-mode-be) (plc-mode-see) (plc-mode-humm))
        (if (eq role (plc-role-fire))
            (list (plc-mode-do) (plc-mode-be))
            (empty)))))))))

    (defn plc-recipe-valid-loop (modes)
        (if (nil? modes) 1
            (if (eq (plc-mode-known? (head modes)) 0) 0
                (plc-recipe-valid-loop (tail modes)))))
    (defn plc-recipe-valid? (role)
        (if (eq (plc-role-known? role) 0) 0
            (plc-recipe-valid-loop (plc-role-recipe role))))

    ;; Public message shape:
    ;; tag, id, author alias, role symbol, route symbol, payload, light code,
    ;; reply-to id, public scope, explicit public choice, receipt reference,
    ;; previous receipt reference.
    (defn plc-message (message-id author role route payload light-code reply-to
                       scope public-choice receipt-ref previous-receipt-ref)
        (list (plc-tag-message) message-id author role route payload light-code
              reply-to scope public-choice receipt-ref previous-receipt-ref))
    (defn plc-message? (message)
        (if (eq (len message) 12)
            (if (eq (nth message 0) (plc-tag-message)) 1 0) 0))
    (defn plc-message-id (message) (nth message 1))
    (defn plc-message-author (message) (nth message 2))
    (defn plc-message-role (message) (nth message 3))
    (defn plc-message-route (message) (nth message 4))
    (defn plc-message-payload (message) (nth message 5))
    (defn plc-message-light-code (message) (nth message 6))
    (defn plc-message-reply-to (message) (nth message 7))
    (defn plc-message-scope (message) (nth message 8))
    (defn plc-message-public-choice (message) (nth message 9))
    (defn plc-message-receipt (message) (nth message 10))
    (defn plc-message-previous-receipt (message) (nth message 11))

    (defn plc-message-valid? (message)
        (if (eq (plc-message? message) 0) 0
        (if (eq (plc-nonempty? (plc-message-id message)) 0) 0
        (if (eq (plc-nonempty? (plc-message-author message)) 0) 0
        (if (eq (plc-nonempty? (plc-message-payload message)) 0) 0
        (if (eq (plc-nonempty? (plc-message-receipt message)) 0) 0
        (if (eq (plc-role-known? (plc-message-role message)) 0) 0
        (if (eq (plc-route-known? (plc-message-route message)) 0) 0
        (if (not (eq (plc-message-scope message) (plc-scope-public))) 0
        (if (not (eq (plc-message-public-choice message) 1)) 0 1))))))))))

    ;; Publication returns an optional. No choice, private scope, an unknown
    ;; role, or an unknown direction leaves no message behind.
    (defn plc-publish (message-id author role route payload light-code reply-to
                       scope public-choice receipt-ref previous-receipt-ref)
        (do (let message (plc-message message-id author role route payload
                            light-code reply-to scope public-choice receipt-ref
                            previous-receipt-ref))
            (if (eq (plc-message-valid? message) 1) (list message) (empty))))

    (defn plc-ledger-has-id? (ledger message-id)
        (if (nil? ledger) 0
            (if (str_eq (plc-message-id (head ledger)) message-id) 1
                (plc-ledger-has-id? (tail ledger) message-id))))
    (defn plc-append (ledger message)
        (if (eq (plc-message-valid? message) 0) (empty)
        (if (eq (plc-ledger-has-id? ledger (plc-message-id message)) 1) (empty)
            (list (append ledger (list message))))))

    ;; Anyone who can reach the public carrier receives the same cells. Filters
    ;; select edges; they do not rewrite the message or its role identity.
    (defn plc-observe (ledger) ledger)
    (defn plc-observe-role (ledger role)
        (if (nil? ledger) (empty)
            (if (eq (plc-message-role (head ledger)) role)
                (cons (head ledger) (plc-observe-role (tail ledger) role))
                (plc-observe-role (tail ledger) role))))

    0)
