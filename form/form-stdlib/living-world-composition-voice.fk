; living-world-composition-voice.fk -- admitted composition speaks through capability.
;
; The emitter receives one integrated current composition candidate inside an
; authority-minimized capability context. It owns no vocabulary, position
; table, lens priority, relation rule, answer set, or remote route. Surface
; segments are read from the composition's exact learned-symbol sequence.
;
; UNOBSERVED and CONFIRMED compositions may form diagnostic utterance
; proposals. CONTESTED composition refuses a primary utterance while retaining
; its alternatives and unknown in the composition cell. Caller alternatives,
; unknown, and choice remain independently optional. Full-world freshness
; prevents ungranted outcome evidence from hiding a reopened composition.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-capability-context.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-native-voice.fk form-stdlib/living-world-relation-learning.fk form-stdlib/living-world-relation-plan.fk form-stdlib/living-world-relational-voice.fk form-stdlib/living-world-multilens-plan.fk form-stdlib/living-world-composition-outcome.fk

(let LWCV-UTTERANCE (bp "LWCV-UTTERANCE"))
(let LWCV-ORIGIN    (bp "LWCV-ORIGIN"))

(defn lwcv-composition-speakable? (composition)
    (if (and (eq (lwco-composition? composition) 1)
             (eq (lwco-contested?
                   (lwco-composition-state composition)) 0)) 1 0))

(defn lwcv-sequence-referents-match? (items referent)
    (if (eq (len items) 0) 1
        (do
            (let candidate (head items))
            (if (and (eq (lwsl-symbol-candidate? candidate) 1)
                     (node_eq
                        (lwnv-symbol-referent
                          (lwo-emergent-shape candidate)) referent))
                (lwcv-sequence-referents-match? (tail items) referent) 0))))

(defn lwcv-render-items (items text)
    (if (eq (len items) 0) text
        (lwcv-render-items (tail items)
            (str_concat text
                (lwnv-symbol-surface
                    (lwo-emergent-shape (head items)))))))

(defn lwcv-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwcv-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwcv-attribution-witnesses (world items witnesses)
    (if (eq (len items) 0) witnesses
        (lwcv-attribution-witnesses world (tail items)
            (lwcv-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world (head items)))
                witnesses))))
(defn lwcv-witnesses (context basis composition-candidate)
    (do
        (let world (lwcp-context-world context))
        (let with-basis
            (lwcv-attribution-witnesses world (list basis)
                (lwo-empty-field)))
        (let with-composition
            (lwcv-attribution-witnesses world (list composition-candidate)
                with-basis))
        (lwcv-field-union-items
            (lwo-field-items
                (lwcp-context-capability-attributions context))
            with-composition)))

; children: execution basis, referent, integrated composition candidate,
;           exact composition, sequence, surface, minimized context,
;           optional alternatives, optional unknown, optional choice,
;           witnesses, evidence, local path
(defn lwcv-utterance
    (basis referent composition-candidate composition sequence surface context
     alternatives unknown choice witnesses evidence)
    (intern_node LWCV-UTTERANCE
        (list basis referent composition-candidate composition sequence
              (intern_trivial_string surface) context alternatives unknown
              choice witnesses evidence (lwo-local-path))))
(defn lwcv-utterance? (cell) (lwo-category? cell LWCV-UTTERANCE))
(defn lwcv-utterance-basis (utterance) (nth (node_children utterance) 0))
(defn lwcv-utterance-referent (utterance) (nth (node_children utterance) 1))
(defn lwcv-utterance-composition-candidate (utterance)
    (nth (node_children utterance) 2))
(defn lwcv-utterance-composition (utterance) (nth (node_children utterance) 3))
(defn lwcv-utterance-sequence (utterance) (nth (node_children utterance) 4))
(defn lwcv-utterance-surface-cell (utterance) (nth (node_children utterance) 5))
(defn lwcv-utterance-surface (utterance)
    (node_value (lwcv-utterance-surface-cell utterance)))
(defn lwcv-utterance-context (utterance) (nth (node_children utterance) 6))
(defn lwcv-utterance-alternatives (utterance) (nth (node_children utterance) 7))
(defn lwcv-utterance-unknown (utterance) (nth (node_children utterance) 8))
(defn lwcv-utterance-choice (utterance) (nth (node_children utterance) 9))
(defn lwcv-utterance-witnesses (utterance) (nth (node_children utterance) 10))
(defn lwcv-utterance-evidence (utterance) (nth (node_children utterance) 11))
(defn lwcv-utterance-path (utterance) (nth (node_children utterance) 12))

(defn lwcv-emit
    (context basis referent composition-candidate alternatives unknown choice
     evidence)
    (if (or (eq (lwcp-context? context) 0)
            (or (eq (lwo-category? alternatives LWO-FIELD) 0)
                (or (eq (lwrv-optional-unknown-valid? unknown) 0)
                    (eq (lwrv-optional-choice-valid? choice) 0))))
        (lwo-none)
        (do
            (let world (lwcp-context-world context))
            (if (or (eq (lwnv-execution-basis?
                          world basis referent) 0)
                    (eq (lwco-integrated-current?
                          world composition-candidate) 0))
                (lwo-none)
                (do
                    (let composition
                        (lwo-emergent-shape composition-candidate))
                    (let sequence
                        (lwco-composition-sequence composition))
                    (let items (lwrp-sequence-items sequence))
                    (if (or (eq (lwcv-composition-speakable?
                                  composition) 0)
                            (eq (lwcv-sequence-referents-match?
                                  items referent) 0))
                        (lwo-none)
                        (lwcv-utterance basis referent composition-candidate
                            composition sequence (lwcv-render-items items "")
                            context alternatives unknown choice
                            (lwcv-witnesses
                                context basis composition-candidate)
                            evidence)))))))

(defn lwcv-utterance-current? (world utterance)
    (if (eq (lwcv-utterance? utterance) 0) 0
        (do
            (let context (lwcv-utterance-context utterance))
            (let basis (lwcv-utterance-basis utterance))
            (let referent (lwcv-utterance-referent utterance))
            (let composition-candidate
                (lwcv-utterance-composition-candidate utterance))
            (if (and (eq (lwcp-context-current? world context) 1)
                     (and (eq (lwnv-execution-basis?
                                world basis referent) 1)
                          (and (eq (lwco-integrated-current?
                                    world composition-candidate) 1)
                               (node_eq utterance
                                (lwcv-emit context basis referent
                                    composition-candidate
                                    (lwcv-utterance-alternatives utterance)
                                    (lwcv-utterance-unknown utterance)
                                    (lwcv-utterance-choice utterance)
                                    (lwcv-utterance-evidence utterance))))))
                1 0))))

(defn lwcv-origin (utterance)
    (intern_node LWCV-ORIGIN (list utterance (lwo-local-path))))
(defn lwcv-proposal
    (context basis referent composition-candidate alternatives unknown choice
     evidence)
    (do
        (let utterance
            (lwcv-emit context basis referent composition-candidate
                alternatives unknown choice evidence))
        (if (node_eq utterance (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwcv-utterance-witnesses utterance))
                (let count (lwo-field-size witnesses))
                (let origin (lwcv-origin utterance))
                (let candidate
                    (lwo-emergent utterance witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwcv-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (do
            (let candidate (lwt-proposal-candidate proposal))
            (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
                     (eq (lwcv-utterance-current? world
                            (lwo-emergent-shape candidate)) 1)) 1 0))))
(defn lwcv-integrate (round proposal action)
    (if (eq (lwcv-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
