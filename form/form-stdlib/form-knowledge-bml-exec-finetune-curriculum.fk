; form-knowledge-bml-exec-finetune-curriculum.fk -- Form-authored,
; source-disjoint scannerless BML adaptation rows.
;
; The 59cb diagnostic was observed before this curriculum existed.  These rows
; therefore never become new heldout evidence for that challenge.  They are an
; adaptive teaching movement whose later replay is regression evidence only.
; The frozen source group, challenge identifiers, oac/fkecc APIs, nonce,
; evaluator and expected score are excluded from every prompt and answer.
;
; Executable rows are lowered through the existing form.bml BMF grammar and
; evaluated by the Form cursor walker.  Grammar-only rows retain the surfaces
; that walker does not yet carry: lists, bare function values, empty and exact
; nothing/0/1.  No flatten table, C seed, HTTP or model server participates.
;
; row = schema split family instruction answer target expected executable
;
; preludes: form-stdlib/core.fk form-stdlib/json.fk

(do
    (defn fkbef-row (split family instruction answer target expected executable)
        (list "form-bml-exec-finetune-row-v1" split family instruction answer
              target expected executable))
    (defn fkbef-split (row) (nth row 1))
    (defn fkbef-family (row) (nth row 2))
    (defn fkbef-instruction (row) (nth row 3))
    (defn fkbef-answer (row) (nth row 4))
    (defn fkbef-target (row) (nth row 5))
    (defn fkbef-expected (row) (nth row 6))
    (defn fkbef-executable? (row) (nth row 7))

    (defn fkbef-prefix ()
        "Return only one complete bounded form.bml section body. No prose, Markdown fences, brackets, colon, return, None, or imports. ")
    (defn fkbef-prompt (row)
        (str_concat (fkbef-prefix) (fkbef-instruction row)))

    (defn fkbef-train-rows ()
        (list
            (fkbef-row "train" "amber-add"
                "Define amber-add(a,b), then zero-argument amber-main returning amber-add(17,25). Finish with 0;."
                "def amber-add(a,b) = add(a,b);\ndef amber-main() = amber-add(17,25);\n0;"
                "amber-main" 42 1)
            (fkbef-row "train" "birch-double"
                "Define birch-double(x), then zero-argument birch-main applying it to 21. Finish with 0;."
                "def birch-double(x) = add(x,x);\ndef birch-main() = birch-double(21);\n0;"
                "birch-main" 42 1)
            (fkbef-row "train" "cedar-nested"
                "Define cedar-inc(x), then zero-argument cedar-main applying cedar-inc twice to 40. Finish with 0;."
                "def cedar-inc(x) = add(x,1);\ndef cedar-main() = cedar-inc(cedar-inc(40));\n0;"
                "cedar-main" 42 1)
            (fkbef-row "train" "dune-multiply"
                "Define zero-argument dune-main multiplying 6 by 7 through call-form syntax. Finish with 0;."
                "def dune-main() = mul(6,7);\n0;"
                "dune-main" 42 1)
            (fkbef-row "train" "elm-subtract"
                "Define zero-argument elm-main subtracting 8 from 50. Finish with 0;."
                "def elm-main() = sub(50,8);\n0;"
                "elm-main" 42 1)
            (fkbef-row "train" "fern-divide"
                "Define zero-argument fern-main dividing 84 by 2. Finish with 0;."
                "def fern-main() = div(84,2);\n0;"
                "fern-main" 42 1)
            (fkbef-row "train" "grove-modulo"
                "Define zero-argument grove-main returning 142 modulo 100. Finish with 0;."
                "def grove-main() = mod(142,100);\n0;"
                "grove-main" 42 1)
            (fkbef-row "train" "harbor-equal"
                "Define harbor-select(x,y) using BML if/then/else to return 42 when equal and 0 otherwise; harbor-main calls it with 7 and 7. Finish with 0;."
                "def harbor-select(x,y) = if eq(x,y) then 42 else 0;\ndef harbor-main() = harbor-select(7,7);\n0;"
                "harbor-main" 42 1)
            (fkbef-row "train" "island-less"
                "Define island-select(x,y) returning 42 when x is less than y and 0 otherwise; island-main calls 3 and 5. Finish with 0;."
                "def island-select(x,y) = if lt(x,y) then 42 else 0;\ndef island-main() = island-select(3,5);\n0;"
                "island-main" 42 1)
            (fkbef-row "train" "juniper-greater"
                "Define juniper-select(x,y) returning 42 when x is greater than y and 0 otherwise; juniper-main calls 5 and 3. Finish with 0;."
                "def juniper-select(x,y) = if gt(x,y) then 42 else 0;\ndef juniper-main() = juniper-select(5,3);\n0;"
                "juniper-main" 42 1)
            (fkbef-row "train" "kelp-three"
                "Define kelp-sum3(a,b,c) by nested add calls; kelp-main supplies 10,11,21. Finish with 0;."
                "def kelp-sum3(a,b,c) = add(add(a,b),c);\ndef kelp-main() = kelp-sum3(10,11,21);\n0;"
                "kelp-main" 42 1)
            (fkbef-row "train" "lumen-zero"
                "Define zero-argument lumen-seed returning 40 and lumen-main adding 2 to its call. Finish with 0;."
                "def lumen-seed() = 40;\ndef lumen-main() = add(lumen-seed(),2);\n0;"
                "lumen-main" 42 1)
            (fkbef-row "train" "moss-else"
                "Define moss-select(x,y) returning 0 when equal and 42 otherwise; moss-main calls 4 and 5. Finish with 0;."
                "def moss-select(x,y) = if eq(x,y) then 0 else 42;\ndef moss-main() = moss-select(4,5);\n0;"
                "moss-main" 42 1)
            (fkbef-row "train" "night-mixed"
                "Define night-main adding 2 to the product of 5 and 8. Finish with 0;."
                "def night-main() = add(mul(5,8),2);\n0;"
                "night-main" 42 1)
            (fkbef-row "train" "opal-presence"
                "Define zero-argument opal-presence returning list(nothing(),0,1) in that order. Finish with 0;."
                "def opal-presence() = list(nothing(),0,1);\n0;"
                "-" 0 0)
            (fkbef-row "train" "pine-values"
                "Define pine-silent(args) returning nothing(), then pine-values() returning list(pine-silent,empty,0,1). Use the function as a bare value. Finish with 0;."
                "def pine-silent(args) = nothing();\ndef pine-values() = list(pine-silent,empty,0,1);\n0;"
                "-" 0 0)
            (fkbef-row "train" "willow-supplied"
                "Assume supplied willow-external(x) exists. Do not define it. Define willow-main() calling willow-external(40). Finish with 0;."
                "def willow-main() = willow-external(40);\n0;"
                "willow-main" 42 1)
            (fkbef-row "train" "xeno-supplied"
                "Assume supplied xeno-route(x,y) exists. Do not define it. Define xeno-main() calling xeno-route(7,7). Finish with 0;."
                "def xeno-main() = xeno-route(7,7);\n0;"
                "xeno-main" 42 1)
            (fkbef-row "train" "yarrow-choice-values"
                "Assume supplied yarrow-one(x) and yarrow-choice(alts,args) exist; do not define them. Define yarrow-silent(args) returning nothing(), yarrow-value(args) calling yarrow-one(1), and yarrow-main() calling yarrow-choice with list(yarrow-silent,yarrow-value) and empty. Finish with 0;."
                "def yarrow-silent(args) = nothing();\ndef yarrow-value(args) = yarrow-one(1);\ndef yarrow-main() = yarrow-choice(list(yarrow-silent,yarrow-value),empty);\n0;"
                "-" 0 0)
            (fkbef-row "train" "zephyr-cut-values"
                "Assume supplied zephyr-cut(alts,args) exists; do not define it. Define zephyr-silent(args) returning nothing(), zephyr-value(args) returning 1, and zephyr-main() calling zephyr-cut with both bare function values and empty. Finish with 0;."
                "def zephyr-silent(args) = nothing();\ndef zephyr-value(args) = 1;\ndef zephyr-main() = zephyr-cut(list(zephyr-silent,zephyr-value),empty);\n0;"
                "-" 0 0)
            (fkbef-row "train" "aurora-undo-call"
                "Assume supplied aurora-undo(ack,checkpoint,memory) exists; do not define it. Define aurora-main() calling it with nothing(), 12, and 88. Finish with 0;."
                "def aurora-main() = aurora-undo(nothing(),12,88);\n0;"
                "-" 0 0)
            (fkbef-row "train" "beacon-timeout-call"
                "Assume supplied beacon-timeout(alts,args,budget) exists; do not define it. Define beacon-silent(args) returning nothing(), beacon-value(args) returning 1, and beacon-main() calling beacon-timeout over both bare functions, empty, and budget 1. Finish with 0;."
                "def beacon-silent(args) = nothing();\ndef beacon-value(args) = 1;\ndef beacon-main() = beacon-timeout(list(beacon-silent,beacon-value),empty,1);\n0;"
                "-" 0 0)
            (fkbef-row "train" "coral-jit-call"
                "Assume supplied coral-jit(heat,pure) exists. Do not define it. Define coral-main() calling coral-jit with heat 6 and pure 1. Finish with 0;."
                "def coral-main() = coral-jit(6,1);\n0;"
                "coral-main" 42 1)
            (fkbef-row "train" "drift-thought-call"
                "Assume supplied drift-thought(plane,gap,rate) exists; do not define it. Define drift-main() calling drift-thought with string why, 6000, and 300. Finish with 0;."
                "def drift-main() = drift-thought(\"why\",6000,300);\n0;"
                "-" 0 0)))

    (defn fkbef-valid-rows ()
        (list
            (fkbef-row "valid" "quartz-add"
                "Define quartz-join(a,b), then quartz-main() returning quartz-join(19,23). Finish with 0;."
                "def quartz-join(a,b) = add(a,b);\ndef quartz-main() = quartz-join(19,23);\n0;"
                "quartz-main" 42 1)
            (fkbef-row "valid" "reed-nested"
                "Define reed-step(x) adding 2, then reed-main() applying reed-step twice to 38. Finish with 0;."
                "def reed-step(x) = add(x,2);\ndef reed-main() = reed-step(reed-step(38));\n0;"
                "reed-main" 42 1)
            (fkbef-row "valid" "stone-branch"
                "Define stone-select(x) returning 42 when x equals 9 and 0 otherwise; stone-main() supplies 9. Finish with 0;."
                "def stone-select(x) = if eq(x,9) then 42 else 0;\ndef stone-main() = stone-select(9);\n0;"
                "stone-main" 42 1)
            (fkbef-row "valid" "tide-absence"
                "Define tide-silent(args) returning nothing() and tide-values() returning list(tide-silent,empty,nothing(),0,1). Finish with 0;."
                "def tide-silent(args) = nothing();\ndef tide-values() = list(tide-silent,empty,nothing(),0,1);\n0;"
                "-" 0 0)
            (fkbef-row "valid" "wave-supplied"
                "Assume supplied wave-shift(x) exists. Do not define it. Define wave-main() calling wave-shift(39). Finish with 0;."
                "def wave-main() = wave-shift(39);\n0;"
                "wave-main" 42 1)
            (fkbef-row "valid" "xylem-choice-values"
                "Assume supplied xylem-choice(alts,args) exists; do not define it. Define xylem-silent(args) returning nothing(), xylem-value(args) returning 1, and xylem-main() calling xylem-choice with both bare functions and empty. Finish with 0;."
                "def xylem-silent(args) = nothing();\ndef xylem-value(args) = 1;\ndef xylem-main() = xylem-choice(list(xylem-silent,xylem-value),empty);\n0;"
                "-" 0 0)))

    (defn fkbef-append (left right)
        (if (nil? left) right
            (cons (head left) (fkbef-append (tail left) right))))

    ; Frozen before the adapter is trained.  These rows check generic transfer,
    ; not the already-observed 59cb challenge.
    (defn fkbef-test-rows ()
        (list
            (fkbef-row "test" "umbra-product"
                "Define umbra-product(a,b), then umbra-main() returning umbra-product(7,6). Finish with 0;."
                "def umbra-product(a,b) = mul(a,b);\ndef umbra-main() = umbra-product(7,6);\n0;"
                "umbra-main" 42 1)
            (fkbef-row "test" "violet-choice"
                "Define violet-pick(x) returning 42 when x is less than 10 and 0 otherwise; violet-main() supplies 8. Finish with 0;."
                "def violet-pick(x) = if lt(x,10) then 42 else 0;\ndef violet-main() = violet-pick(8);\n0;"
                "violet-main" 42 1)
            (fkbef-row "test" "zeal-supplied"
                "Assume supplied zeal-shift(x) exists. Do not define it. Define zeal-main() calling zeal-shift(37). Finish with 0;."
                "def zeal-main() = zeal-shift(37);\n0;"
                "zeal-main" 42 1)
            (fkbef-row "test" "aether-undo-call"
                "Assume supplied aether-undo(ack,checkpoint,memory) exists; do not define it. Define aether-main() calling aether-undo with nothing(), 13, and 87. Finish with 0;."
                "def aether-main() = aether-undo(nothing(),13,87);\n0;"
                "-" 0 0)))

    (defn fkbef-all-rows ()
        (fkbef-append (fkbef-train-rows)
            (fkbef-append (fkbef-valid-rows) (fkbef-test-rows))))

    (defn fkbef-message (role content)
        (json-node-object (list
            (json-node-pair "role" (json-node-string role))
            (json-node-pair "content" (json-node-string content)))))
    (defn fkbef-json-row (row)
        (json-emit (json-node-object (list
            (json-node-pair "messages" (json-node-array (list
                (fkbef-message "user" (fkbef-prompt row))
                (fkbef-message "assistant" (fkbef-answer row)))))))))
    (defn fkbef-jsonl-loop (rows)
        (if (nil? rows) ""
            (str_concat (fkbef-json-row (head rows))
                (str_concat "\n" (fkbef-jsonl-loop (tail rows))))))
    (defn fkbef-jsonl (split)
        (if (str_eq split "train") (fkbef-jsonl-loop (fkbef-train-rows))
            (if (str_eq split "valid") (fkbef-jsonl-loop (fkbef-valid-rows))
                (if (str_eq split "test") (fkbef-jsonl-loop (fkbef-test-rows))
                    (nothing)))))
    0)
