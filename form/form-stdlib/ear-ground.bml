//////////////////////////////////////////////////////////////////////
//
// ear-ground.bml — the ground under the ear: which of its delays are physics
// and which are furniture, how a line closes, and how the ground says when it
// is not standing.
//
// Authority: form/form-stdlib/bml/ear-ground.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-sensor-rows.bml
//
// Mouth to committed line, the live path costs seconds. Almost none of that is
// arithmetic. Measured on this Mac on 2026-09-08 with the floor lens reading
// 330.24 GB/s and 12.88 TFLOPS: the whisper open is 67 ms, the encoder over a
// full eight-second window is 5 ms, and a decoded line is 12-30 ms. The pass is
// thirty-five milliseconds. Everything else in the seconds is waiting, and each
// wait is one of two things.
//
// PHYSICS is a delay the world charges: a sound must exist before it can be
// heard, so a window has to fill; a model must see bytes before it can name
// them, so the encoder and the decoder cost what they cost.
//
// FURNITURE is a delay some earlier hand chose and nobody has re-opened. Three
// of them carry almost the whole reading:
//
//   the fork    each frame leaves the ear by a spool write and a fifo bell, and
//               the bell is `( ftimeout 5 sh -c 'printf x > bell' ) &`. A fork
//               is priced by what the forking process has touched (touchtoll,
//               corpus row 1341); from inside a process holding the model it
//               measured 7.5 ms, and a live frame rings TWO. The same line
//               crossing a gift frame on a handle the lane keeps open measured
//               under 5 us -- 200 writes in under a millisecond.
//   the wait    a line closes either on 500 ms of silence or on the decoder's
//               own end-of-line timestamp token AND three more passes agreeing.
//               The signal is read (enw-last-ts) and then gated behind 405 ms
//               of hops. Closing on the raw signal instead was tried in the
//               room and refused by it -- nineteen shattered lines in eight
//               seconds -- so what moves here is two of the three hops, 270 ms,
//               and the guard the third hop was really doing stays.
//   the open    every lane is its own process with its own opens. The whisper
//               open is cheap; the tongue lane's dense open is 2032 ms warm and
//               20449 ms cold, paid once per process per line-burst instead of
//               once per body.
//
// And one delay is furniture living somewhere this cell cannot reach: the
// microphone is delivered in 100 ms granules because the seed allocates its
// audio queue buffers at 3200 bytes. Asking for 20 ms at a time does not move
// it -- the ask returns five pieces instantly and then waits out the granule.
// That is one integer in the C seed, and it puts a 100 ms floor under every
// reaction the body can have. It is named here and left to the hand that owns
// the seed.
//
// The ledger below is data, so the arithmetic is checkable and the verdicts
// are countable. Each row carries what it was measured at, which of the two it
// is, and where it lives. A number here is a witness with a date, not a law.
//
// ; witnessed: 2026-09-08 -> ear-ground-band 32767
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormEarGroundAuthority {
        field EGAuthorityPath = "form/form-stdlib/bml/ear-ground.bml";
        field EGAuthorityKind = "high-bml-interface-class-const";
    }

    class FormEarGround {
        field EGSchema = "ear-ground-v1";
        field EGSensor = "earground";
        field EGCadenceMs = 100;
        field EGSilentFactor = 3;
        field EGQuietMs = 500;
        field EGStableHops = 3;
        field EGConfirmHops = 1;
        field EGHopMs = 135;
        field EGWitnessed = "2026-09-08";
        field EGFloor = "330.24 GB/s, 12.88 TFLOPS";
        ref eg-authority = FormEarGroundAuthority;
        thought eg-law = list("a-delay-is-physics-or-furniture", "the-model-closes-its-own-line", "a-kept-frame-does-not-fork", "a-ground-that-stopped-says-so");

        // --- the ledger: name, milliseconds measured, verdict, where it lives, and whether
        // this ground actually MOVED it or only named it. Naming a delay furniture and leaving
        // it standing is honest; calling it a saving is not. Two rows moved and eight did not,
        // and the eight say why in their own words.
        def eg-row(name, ms, verdict, where, fate) = list(name, ms, verdict, where, fate);
        def eg-row-name(r) = nth(r, 0);
        def eg-row-ms(r) = nth(r, 1);
        def eg-row-verdict(r) = nth(r, 2);
        def eg-row-where(r) = nth(r, 3);
        def eg-row-fate(r) = nth(r, 4);
        def eg-ledger() = list(
            eg-row("mic granule", 100, "furniture", "runtime/fkwu-uni.c fk_AQAllocBuf 3200 bytes", "named"),
            eg-row("mic read wait", 120, "furniture", "the ask is 120 ms for a 100 ms granule", "named"),
            eg-row("window fills", 300, "physics", "a sound must exist before it is heard", "named"),
            eg-row("encode 8 s", 5, "physics", "ear-native enw-encode-parts", "named"),
            eg-row("decode a line", 30, "physics", "ear-native enw-transcribe-from2", "named"),
            eg-row("spool append", 0, "furniture", "sbt-append, 45 us", "moved"),
            eg-row("two bell forks", 15, "furniture", "el-ring2, 7.5 ms each", "moved"),
            eg-row("wait for silence", 500, "furniture", "kept: the fallback for a line the model never closed", "named"),
            eg-row("two extra hops agreeing", 270, "furniture", "two of the three; the first hop is a real guard", "moved"),
            eg-row("tongue lane open", 2032, "furniture", "one process per line-burst, not per body", "named"));
        def eg-sum-go(rows, verdict, acc) = if eq(len(rows), 0) then acc else eg-sum-go(tail(rows), verdict, if str_eq(eg-row-verdict(head(rows)), verdict) then add(acc, eg-row-ms(head(rows))) else acc);
        def eg-ms(verdict) = eg-sum-go(eg-ledger(), verdict, 0);
        def eg-count-go(rows, verdict, acc) = if eq(len(rows), 0) then acc else eg-count-go(tail(rows), verdict, if str_eq(eg-row-verdict(head(rows)), verdict) then add(acc, 1) else acc);
        def eg-count(verdict) = eg-count-go(eg-ledger(), verdict, 0);
        def eg-total-ms() = add(eg-ms("physics"), eg-ms("furniture"));
        // every row is one of the two words and nothing else: a third word is a row that was never judged
        def eg-judged?() = if eq(add(eg-count("physics"), eg-count("furniture")), len(eg-ledger())) then 1 else 0;
        // what this ground actually took out of the path, in milliseconds a hop no longer pays
        def eg-moved-go(rows, acc) = if eq(len(rows), 0) then acc else eg-moved-go(tail(rows), if str_eq(eg-row-fate(head(rows)), "moved") then add(acc, eg-row-ms(head(rows))) else acc);
        def eg-moved-ms() = eg-moved-go(eg-ledger(), 0);
        // and what it named and left standing, so the two are never read as one number
        def eg-named-ms() = sub(eg-ms("furniture"), eg-moved-ms());
        // a moved row must be furniture: physics does not move
        def eg-moved-are-furniture-go(rows) = if eq(len(rows), 0) then 1 else if and(str_eq(eg-row-fate(head(rows)), "moved"), str_eq(eg-row-verdict(head(rows)), "physics")) then 0 else eg-moved-are-furniture-go(tail(rows));
        def eg-moved-are-furniture?() = eg-moved-are-furniture-go(eg-ledger());

        // --- how a line closes ------------------------------------------------
        // endsign is the decoder's own end-of-line timestamp (enw-last-ts): -1 when the line
        // did not close itself, its tick otherwise. stable is how many consecutive passes have
        // agreed. quiet is ms since the last sample above the speech level. full is 1 when the
        // window has no more room.
        //
        // Three policies live here because the room refused the obvious one.
        //
        // The OLD ground reads the model's own end and then refuses to act on it until three
        // more passes have agreed with the text: the model's moment plus three hops.
        //
        // The RAW policy was the re-envisioning that suggested itself -- close the instant the
        // model signals, since it already said the segment ended. Stood in the room on
        // 2026-09-08 it closed NINETEEN lines in eight seconds, most of them "[INAUDIBLE]".
        // The signal does not mean the speaker stopped; it means the audio in this window holds
        // a complete segment, which on a growing eight-second window is true on nearly every
        // pass. Three passes of agreement were never furniture for its own sake -- they were a
        // guard against exactly this, written by a hand that had met it.
        //
        // So the ground keeps the guard and prices it honestly: ONE confirming pass rather than
        // three. The model's signal still leads; the confirmation is one hop, not three; and
        // what is saved is the two hops nobody was ever using to learn anything.
        def eg-close-old(endsign, stable, quiet, full) = if and(ge(stable, EGStableHops()), ge(endsign, 0)) then "model-after-three" else if gt(quiet, EGQuietMs()) then "silence" else if eq(full, 1) then "window" else "";
        def eg-close-raw(endsign, quiet, full) = if ge(endsign, 0) then "model" else if gt(quiet, EGQuietMs()) then "silence" else if eq(full, 1) then "window" else "";
        def eg-close-new(endsign, stable, quiet, full) = if and(ge(stable, EGConfirmHops()), ge(endsign, 0)) then "model" else if gt(quiet, EGQuietMs()) then "silence" else if eq(full, 1) then "window" else "";
        def eg-closed?(reason) = if eq(str_len(reason), 0) then 0 else 1;
        // The frame's reason word carries more than a close: a hop that is still growing, or
        // quiet, or waiting on the mic says so too. Only these three words mean a line was
        // committed, and a reader that treats every non-empty reason as a close will count a
        // living line as a finished one.
        def eg-close-word?(reason) = if str_eq(reason, "model") then 1 else if str_eq(reason, "silence") then 1 else if str_eq(reason, "window") then 1 else if str_eq(reason, "model-after-three") then 1 else 0;
        // what the new close saves on a line the model closed itself: the hops it no longer
        // waits out. The silence is NOT added -- in the old lane the silence and the model path
        // are alternatives, not a sum, and a saving counted twice is a saving invented.
        def eg-close-saved-ms() = mul(sub(EGStableHops(), EGConfirmHops()), EGHopMs());

        // --- the standing word ------------------------------------------------
        // A resident that holds everything is one point of failure, and a lane that dies
        // silently is worse than a slow one (mutebirth, corpus row 1339): absence reads exactly
        // like a quiet room. So the ground's frame carries a sequence that advances every hop,
        // and a reader decides from the sequence and its age -- never from the fact that a file
        // exists. Three words, and the reader must be able to reach all three.
        //   absent    no frame is offered at all: nobody has ever stood here
        //   silent    a frame stands but its sequence has not moved past three cadences:
        //             a ground that stood and stopped, which is the dangerous case
        //   standing  the sequence moved within the cadence it declared
        def eg-standing(offered, seq, heldseq, agems) = if eq(offered, 0) then "absent" else if gt(agems, mul(EGSilentFactor(), EGCadenceMs())) then "silent" else if eq(seq, heldseq) then "silent" else "standing";
        def eg-alive?(word) = if str_eq(word, "standing") then 1 else 0;
        // the word a reader shows a person: never a number from a frame that stopped moving
        def eg-word-note(word) = if str_eq(word, "absent") then "no ear ground is standing; run observe/ear-ground-live.fk" else if str_eq(word, "silent") then "the ear ground stood and stopped giving; its last line is not the room now" else "the ear ground is giving";

        // --- the frame the ground gives ---------------------------------------
        // list(schema, epoch, pid, hops, closes, level, tongue, line, reason, standing-word)
        def eg-frame(epoch, pid, hops, closes, level, tongue, line, reason) = list(EGSchema(), epoch, pid, hops, closes, level, tongue, line, reason);
        def eg-frame-valid?(f) = if nothing?(f) then 0 else if not(eq(len(f), 9)) then 0 else if not(str_eq(nth(f, 0), EGSchema())) then 0 else 1;
        def eg-frame-epoch(f) = if eq(eg-frame-valid?(f), 1) then nth(f, 1) else -1;
        def eg-frame-pid(f) = if eq(eg-frame-valid?(f), 1) then nth(f, 2) else -1;
        def eg-frame-hops(f) = if eq(eg-frame-valid?(f), 1) then nth(f, 3) else -1;
        def eg-frame-closes(f) = if eq(eg-frame-valid?(f), 1) then nth(f, 4) else -1;
        def eg-frame-level(f) = if eq(eg-frame-valid?(f), 1) then nth(f, 5) else -120;
        def eg-frame-tongue(f) = if eq(eg-frame-valid?(f), 1) then nth(f, 6) else "";
        def eg-frame-line(f) = if eq(eg-frame-valid?(f), 1) then nth(f, 7) else "";
        def eg-frame-reason(f) = if eq(eg-frame-valid?(f), 1) then nth(f, 8) else "";
        def eg-publisher() = str_concat("glass.sensor.", EGSensor());
    }
}
