; circle.bml — consentful circle / satsang protocol cells.
;
; preludes: form-stdlib/core.fk form-stdlib/channel-interface.fk form-stdlib/channel-flow.fk
;
; A circle is a held group container, not an open broadcast mesh. The protocol
; makes discovery, invitation, owned sharing, export consent, refusal, silence,
; and truth-oriented inquiry visible as data the kernels can agree on.

section [form.bml] {
    let cc_tag_circle = bp("CELL-CIRCLE");
    let cc_tag_offer = bp("CIRCLE-OFFER");
    let cc_tag_invitation = bp("CIRCLE-INVITATION");
    let cc_tag_share = bp("CIRCLE-SHARE");
    let cc_tag_consensus = bp("CIRCLE-CONSENSUS");
    let cc_tag_refusal = bp("CIRCLE-REFUSAL");
    let cc_tag_export_consent = bp("CIRCLE-EXPORT-CONSENT");
    let cc_tag_receipt = bp("CIRCLE-RECEIPT");
    let cc_tag_satsang_silence = bp("SATSANG-SILENCE");
    let cc_tag_satsang_inquiry = bp("SATSANG-INQUIRY");
    let cc_tag_satsang_pointing = bp("SATSANG-POINTING");

    def cc-bool-score(ok, score) = if ok then score else 0;
    def cc-tagged?(value, tag, arity) = if ((Comparable) len(value) == arity) then node_eq(value[0], tag) else false;
    def cc-nonempty-string?(value) = (str_len(value) > 0);

    def cc-discovery-offered() = "offered";
    def cc-discovery-private() = "private";
    def cc-invitation-required() = "invitation-required";
    def cc-confidential-circle-only() = "circle-only";
    def cc-export-consent-required() = "explicit-consent-required";
    def cc-mode-circle-satsang() = "circle-satsang";
    def cc-visibility-circle-only() = "circle-only";
    def cc-visibility-exportable() = "exportable";
    def cc-fidelity-hash() = "hash";
    def cc-fidelity-summary() = "summary";
    def cc-fidelity-full() = "full-payload";
    def cc-action-integrated() = "integrated";
    def cc-action-refused() = "refused";
    def cc-action-exported() = "exported";
    def cc-share-observation() = "observation";
    def cc-share-impact() = "impact";
    def cc-share-feeling() = "feeling";
    def cc-share-desire() = "desire";
    def cc-share-request() = "request";
    def cc-share-boundary() = "boundary";
    def cc-share-silence() = "silence";
    def cc-strength-invitation() = "invitation";
    def cc-strength-reflection() = "reflection";
    def cc-strength-direct() = "direct";

    def cc-circle(id, members, shared_context, mode, interface_offer, discovery_policy, confidentiality_policy, export_policy, carrier_flow) = [cc_tag_circle, id, members, shared_context, mode, interface_offer, discovery_policy, confidentiality_policy, export_policy, carrier_flow];
    def cc-circle?(circle) = cc-tagged?(circle, cc_tag_circle, 10);
    def cc-circle-id(circle) = circle[1];
    def cc-circle-members(circle) = circle[2];
    def cc-circle-shared-context(circle) = circle[3];
    def cc-circle-mode(circle) = circle[4];
    def cc-circle-interface-offer(circle) = circle[5];
    def cc-circle-discovery-policy(circle) = circle[6];
    def cc-circle-confidentiality-policy(circle) = circle[7];
    def cc-circle-export-policy(circle) = circle[8];
    def cc-circle-carrier-flow(circle) = circle[9];
    def cc-circle-valid?(circle) = if cc-circle?(circle) then (cc-nonempty-string?(cc-circle-id(circle)) && ((len(cc-circle-members(circle)) > 0) && (cc-nonempty-string?(cc-circle-shared-context(circle)) && cc-channel-flow-valid-or-empty?(cc-circle-carrier-flow(circle))))) else false;
    def cc-channel-flow-valid-or-empty?(flow) = if ((Comparable) len(flow) == 0) then true else cf-channel-flow-valid?(flow);

    def cc-circle-offer(circle_id, offered_by, title, discovery_policy, invitation_policy, boundary) = [cc_tag_offer, circle_id, offered_by, title, discovery_policy, invitation_policy, boundary];
    def cc-circle-offer?(offer) = cc-tagged?(offer, cc_tag_offer, 7);
    def cc-offer-circle-id(offer) = offer[1];
    def cc-offer-offered-by(offer) = offer[2];
    def cc-offer-title(offer) = offer[3];
    def cc-offer-discovery-policy(offer) = offer[4];
    def cc-offer-invitation-policy(offer) = offer[5];
    def cc-offer-boundary(offer) = offer[6];
    def cc-offer-discoverable?(offer) = if cc-circle-offer?(offer) then ((String) cc-offer-discovery-policy(offer) == cc-discovery-offered()) else false;
    def cc-discoverable-set(offers) {
        if ((Comparable) len(offers) == 0) then empty else
        if cc-offer-discoverable?(head(offers)) then
            cons(head(offers), cc-discoverable-set(tail(offers)))
        else cc-discoverable-set(tail(offers));
    }
    def cc-discoverable-member?(offers, circle_id) {
        if ((Comparable) len(offers) == 0) then false else
        if (cc-offer-discoverable?(head(offers)) && ((String) cc-offer-circle-id(head(offers)) == circle_id)) then true
        else cc-discoverable-member?(tail(offers), circle_id);
    }

    def cc-circle-invitation(circle_id, inviter, invitee, invitation, boundary, expiry) = [cc_tag_invitation, circle_id, inviter, invitee, invitation, boundary, expiry];
    def cc-circle-invitation?(invitation) = cc-tagged?(invitation, cc_tag_invitation, 7);
    def cc-invitation-circle-id(invitation) = invitation[1];
    def cc-invitation-inviter(invitation) = invitation[2];
    def cc-invitation-invitee(invitation) = invitation[3];
    def cc-invitation-text(invitation) = invitation[4];
    def cc-invitation-boundary(invitation) = invitation[5];
    def cc-invitation-expiry(invitation) = invitation[6];
    def cc-joinable-by-invitation?(offer, invitation, requester) {
        if (cc-circle-offer?(offer) && cc-circle-invitation?(invitation)) then (((String) cc-offer-circle-id(offer) == cc-invitation-circle-id(invitation)) && (((String) cc-invitation-invitee(invitation) == requester) && ((String) cc-offer-invitation-policy(offer) == cc-invitation-required()))) else false;
    }

    def cc-circle-share(circle_id, author, kind, payload, visibility, consent_policy) = [cc_tag_share, circle_id, author, kind, payload, visibility, consent_policy];
    def cc-circle-share?(share) = cc-tagged?(share, cc_tag_share, 7);
    def cc-share-circle-id(share) = share[1];
    def cc-share-author(share) = share[2];
    def cc-share-kind(share) = share[3];
    def cc-share-payload(share) = share[4];
    def cc-share-visibility(share) = share[5];
    def cc-share-consent-policy(share) = share[6];
    def cc-share-valid?(share) = if cc-circle-share?(share) then (cc-nonempty-string?(cc-share-circle-id(share)) && (cc-nonempty-string?(cc-share-author(share)) && cc-nonempty-string?(cc-share-kind(share)))) else false;

    def cc-circle-consensus(circle_id, subject, voters, approvals, threshold, decision) = [cc_tag_consensus, circle_id, subject, voters, approvals, threshold, decision];
    def cc-circle-consensus?(consensus) = cc-tagged?(consensus, cc_tag_consensus, 7);
    def cc-consensus-circle-id(consensus) = consensus[1];
    def cc-consensus-subject(consensus) = consensus[2];
    def cc-consensus-voters(consensus) = consensus[3];
    def cc-consensus-approvals(consensus) = consensus[4];
    def cc-consensus-threshold(consensus) = consensus[5];
    def cc-consensus-decision(consensus) = consensus[6];
    def cc-consensus-passed?(consensus) = if cc-circle-consensus?(consensus) then ((cc-consensus-threshold(consensus) > 0) && ((cc-consensus-approvals(consensus) >= cc-consensus-threshold(consensus)) && (cc-consensus-approvals(consensus) <= len(cc-consensus-voters(consensus))))) else false;

    def cc-circle-refusal(circle_id, observer, subject, invasive_action, offered_interface, consensus, boundary) = [cc_tag_refusal, circle_id, observer, subject, invasive_action, offered_interface, consensus, boundary];
    def cc-circle-refusal?(refusal) = cc-tagged?(refusal, cc_tag_refusal, 8);
    def cc-refusal-circle-id(refusal) = refusal[1];
    def cc-refusal-observer(refusal) = refusal[2];
    def cc-refusal-subject(refusal) = refusal[3];
    def cc-refusal-invasive-action(refusal) = refusal[4];
    def cc-refusal-offered-interface(refusal) = refusal[5];
    def cc-refusal-consensus(refusal) = refusal[6];
    def cc-refusal-boundary(refusal) = refusal[7];
    def cc-refusal-valid?(refusal) = if cc-circle-refusal?(refusal) then (ci-invasion?(cc-refusal-invasive-action(refusal), cc-refusal-offered-interface(refusal)) && cc-consensus-passed?(cc-refusal-consensus(refusal))) else false;
    def cc-observed-invasion-consensus?(refusal) = cc-refusal-valid?(refusal);
    def cc-remove-circle-from-set(offers, circle_id) {
        if ((Comparable) len(offers) == 0) then empty else
        if ((String) cc-offer-circle-id(head(offers)) == circle_id) then
            cc-remove-circle-from-set(tail(offers), circle_id)
        else cons(head(offers), cc-remove-circle-from-set(tail(offers), circle_id));
    }
    def cc-discoverable-after-refusal(visible_offers, refusal) {
        if cc-observed-invasion-consensus?(refusal) then
            cc-remove-circle-from-set(visible_offers, cc-refusal-circle-id(refusal))
        else visible_offers;
    }

    def cc-circle-export-consent(circle_id, share, recipient, fidelity, purpose, expiry, consensus) = [cc_tag_export_consent, circle_id, share, recipient, fidelity, purpose, expiry, consensus];
    def cc-circle-export-consent?(consent) = cc-tagged?(consent, cc_tag_export_consent, 8);
    def cc-export-consent-circle-id(consent) = consent[1];
    def cc-export-consent-share(consent) = consent[2];
    def cc-export-consent-recipient(consent) = consent[3];
    def cc-export-consent-fidelity(consent) = consent[4];
    def cc-export-consent-purpose(consent) = consent[5];
    def cc-export-consent-expiry(consent) = consent[6];
    def cc-export-consent-consensus(consent) = consent[7];
    def cc-export-allowed?(share, consent) {
        if (cc-share-valid?(share) && cc-circle-export-consent?(consent)) then (((String) cc-share-circle-id(share) == cc-export-consent-circle-id(consent)) && (cc-nonempty-string?(cc-export-consent-recipient(consent)) && (cc-nonempty-string?(cc-export-consent-fidelity(consent)) && (cc-nonempty-string?(cc-export-consent-purpose(consent)) && cc-consensus-passed?(cc-export-consent-consensus(consent)))))) else false;
    }
    def cc-outside-flow-allowed?(share, consent_or_empty) = if ((Comparable) len(consent_or_empty) == 0) then false else cc-export-allowed?(share, consent_or_empty);

    def cc-circle-receipt(circle_id, member, subject, action, reason, cost) = [cc_tag_receipt, circle_id, member, subject, action, reason, cost];
    def cc-circle-receipt?(receipt) = cc-tagged?(receipt, cc_tag_receipt, 7);
    def cc-receipt-circle-id(receipt) = receipt[1];
    def cc-receipt-member(receipt) = receipt[2];
    def cc-receipt-subject(receipt) = receipt[3];
    def cc-receipt-action(receipt) = receipt[4];
    def cc-receipt-reason(receipt) = receipt[5];
    def cc-receipt-cost(receipt) = receipt[6];
    def cc-receipt-valid?(receipt) = if cc-circle-receipt?(receipt) then (cc-nonempty-string?(cc-receipt-circle-id(receipt)) && (cc-nonempty-string?(cc-receipt-member(receipt)) && cc-nonempty-string?(cc-receipt-action(receipt)))) else false;

    def cc-satsang-silence(circle_id, witnessed_by, quality, openness) = [cc_tag_satsang_silence, circle_id, witnessed_by, quality, openness];
    def cc-satsang-silence?(silence) = cc-tagged?(silence, cc_tag_satsang_silence, 5);
    def cc-silence-circle-id(silence) = silence[1];
    def cc-silence-witnessed-by(silence) = silence[2];
    def cc-silence-quality(silence) = silence[3];
    def cc-silence-openness(silence) = silence[4];
    def cc-satsang-silence-valid?(silence) = if cc-satsang-silence?(silence) then (cc-nonempty-string?(cc-silence-circle-id(silence)) && (len(cc-silence-witnessed-by(silence)) > 0)) else false;

    def cc-satsang-inquiry(circle_id, author, question, target, consent_policy) = [cc_tag_satsang_inquiry, circle_id, author, question, target, consent_policy];
    def cc-satsang-inquiry?(inquiry) = cc-tagged?(inquiry, cc_tag_satsang_inquiry, 6);
    def cc-inquiry-circle-id(inquiry) = inquiry[1];
    def cc-inquiry-author(inquiry) = inquiry[2];
    def cc-inquiry-question(inquiry) = inquiry[3];
    def cc-inquiry-target(inquiry) = inquiry[4];
    def cc-inquiry-consent-policy(inquiry) = inquiry[5];
    def cc-satsang-inquiry-valid?(inquiry) = if cc-satsang-inquiry?(inquiry) then (cc-nonempty-string?(cc-inquiry-circle-id(inquiry)) && (cc-nonempty-string?(cc-inquiry-author(inquiry)) && cc-nonempty-string?(cc-inquiry-question(inquiry)))) else false;

    def cc-satsang-pointing(circle_id, author, pointing, offered_to, strength, not_command) = [cc_tag_satsang_pointing, circle_id, author, pointing, offered_to, strength, not_command];
    def cc-satsang-pointing?(pointing) = cc-tagged?(pointing, cc_tag_satsang_pointing, 7);
    def cc-pointing-circle-id(pointing) = pointing[1];
    def cc-pointing-author(pointing) = pointing[2];
    def cc-pointing-text(pointing) = pointing[3];
    def cc-pointing-offered-to(pointing) = pointing[4];
    def cc-pointing-strength(pointing) = pointing[5];
    def cc-pointing-not-command(pointing) = pointing[6];
    def cc-satsang-pointing-valid?(pointing) = if cc-satsang-pointing?(pointing) then (cc-nonempty-string?(cc-pointing-circle-id(pointing)) && (cc-nonempty-string?(cc-pointing-author(pointing)) && cc-pointing-not-command(pointing))) else false;

    def cc-open-cell-satsang-circle(id, members, shared_context, carrier_flow) {
        cc-circle(id, members, shared_context, cc-mode-circle-satsang(), [m-witness(), m-see(), m-invite(), m-offer(), m-ask-permission(), m-ask-how()], cc-discovery-offered(), cc-confidential-circle-only(), cc-export-consent-required(), carrier_flow);
    }
    def cc-default-offer(circle, offered_by, title, boundary) = cc-circle-offer(cc-circle-id(circle), offered_by, title, cc-discovery-offered(), cc-invitation-required(), boundary);

    0;
}
