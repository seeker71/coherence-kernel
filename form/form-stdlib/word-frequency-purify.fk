// word-frequency-purify.fk — usage is alive; any word walks.
//
// A closed shelf of words is static. It contracts aliveness into a
// labyrinth. The living law is USAGE KIND, and it reads every word:
//   absence  — names what is missing and leaves the path unnamed
//   path     — names the offered way, so the body can walk
// Health is the kind of this usage. The surface stays the word it is.
//
// The seed rows are memory (axiom-3): examples that already lifted.
// A new word enters by admit. The seed stays referenced. Length is
// free to grow. Gene Keys already holds the shape (shadow -> gift
// -> siddhi). For "gate" the shape reads: at love it recognizes.
//
// preludes: form-stdlib/core.fk
//
// Proven by: form-stdlib/tests/word-frequency-purify-band.fk
// witnessed: 2026-08-14 -> band 8191
section [form.bml] {
    // row: (word common-desc purified-desc trust sov vit)
    // trust/sov/vit are the lifts of the PURIFIED usage, 1..3.
    def wfp-row(word, common, purified, t, s, v) = list(word, common, purified, t, s, v);
    def wfp-word(r) = nth(r, 0);
    def wfp-common(r) = nth(r, 1);
    def wfp-purified(r) = nth(r, 2);
    def wfp-trust(r) = nth(r, 3);
    def wfp-sov(r) = nth(r, 4);
    def wfp-vit(r) = nth(r, 5);
    // usage: 0 common / 1 purified. The surface is the same either way.
    def wfp-common-use() = 0;
    def wfp-pure-use() = 1;
    def wfp-healthy?(use) = (Comparable) use == wfp-pure-use() ? 1 : 0;
    // The living law. Any word. Kind is the read.
    def wfp-kind-absence() = 0;
    def wfp-kind-path() = 1;
    def wfp-usage(word, kind) = list(word, kind);
    def wfp-u-word(u) = nth(u, 0);
    def wfp-u-kind(u) = nth(u, 1);
    def wfp-path?(kind) = (Comparable) kind == wfp-kind-path() ? 1 : 0;
    def wfp-admit(rs, row) = cons(row, rs);
    def wfp-rows() = list(wfp-row("law", "a command from above that binds without being observed", "a currently-observed belief with a freshness stamp", 3, 2, 2), wfp-row("must", "an obligation backed by force", "this comes first; the order is named and the cell still chooses", 2, 2, 2), wfp-row("gate", "a guard that admits or keeps the stranger out", "a welcoming threshold that recognizes and names the edge", 3, 3, 3), wfp-row("refuse", "rejection of the person who offered", "this offer is not admitted; the cell remains, the person remains", 3, 3, 2), wfp-row("enforce", "force applied to make a body comply", "tend the boundary so what was offered stays true", 2, 2, 3), wfp-row("forbid", "a ban that sets the word itself down", "this path is not offered here; another path is named", 2, 3, 2), wfp-row("strict", "rigidity that punishes deviation", "the edge is exact so both sides can trust it", 3, 2, 2), wfp-row("mandatory", "no consent, no alternative", "this axis is load-bearing; the body says so plainly", 2, 2, 2), wfp-row("comply", "submit to an external will", "meet the offered interface; the ack is still sovereign", 2, 3, 2), wfp-row("violation", "a crime against a rule", "a breach of an offered interface, observable and healable", 3, 2, 2), wfp-row("not", "names what is absent and leaves the path unnamed", "name the path that is offered; say what happens instead", 3, 3, 3));
    def wfp-find-loop(rs, word) = (Comparable) len(rs) == 0 ? empty() : (String) wfp-word(head(rs)) == word ? head(rs) : wfp-find-loop(tail(rs), word);
    def wfp-find(word) = wfp-find-loop(wfp-rows(), word);
    def wfp-known?(word) = (Comparable) len(wfp-find(word)) == 0 ? 0 : 1;
    // Purification keeps the surface. A new description mints a new cell
    // (axiom-3); the word is still the word.
    def wfp-same-word?(r) = str_len(wfp-word(r)) > 0 ? 1 : 0;
    def wfp-desc-lifted?(r) = (String) wfp-common(r) == wfp-purified(r) ? 0 : 1;
    def wfp-lifts?(r) = wfp-trust(r) >= 1 && (wfp-sov(r) >= 1 && wfp-vit(r) >= 1) ? 1 : 0;
    // A count of the word is not a verdict. Common usage is attention.
    // Purified usage is healthy. Appearance alone decides nothing.
    def wfp-count-verdict(count, use) = (Comparable) use == wfp-pure-use() ? "healthy" : count > 0 ? "attention" : "clear";
    def wfp-all-kept-loop(rs) = (Comparable) len(rs) == 0 ? 1 : (Comparable) wfp-same-word?(head(rs)) == 1 ? wfp-all-kept-loop(tail(rs)) : 0;
    def wfp-all-lifted-loop(rs) = (Comparable) len(rs) == 0 ? 1 : (Comparable) wfp-desc-lifted?(head(rs)) == 1 && (Comparable) wfp-lifts?(head(rs)) == 1 ? wfp-all-lifted-loop(tail(rs)) : 0;
    def wfp-all-kept?() = wfp-all-kept-loop(wfp-rows());
    def wfp-all-lifted?() = wfp-all-lifted-loop(wfp-rows());
    def wfpk(cond, bit) = cond ? bit : 0;
    def wfp-check() = {
        let gate = wfp-find("gate");
        let law = wfp-find("law");
        let must = wfp-find("must");
        let refu = wfp-find("refuse");
        let neg = wfp-find("not");
        let grown = wfp-admit(wfp-rows(), wfp-row("aliveness", "a shelf to guard", "a usage that names a path", 3, 3, 3));
        wfpk((Comparable) wfp-all-kept?() == 1, 1) + wfpk((Comparable) wfp-all-lifted?() == 1, 2) + wfpk(len(grown) > len(wfp-rows()), 4) + wfpk(str_find(wfp-purified(gate), "recogn", 0) >= 0 && str_find(wfp-common(gate), "guard", 0) >= 0, 8) + wfpk(str_find(wfp-purified(law), "observed", 0) >= 0 && str_find(wfp-common(law), "command", 0) >= 0, 16) + wfpk((Comparable) wfp-healthy?(wfp-pure-use()) == 1, 32) + wfpk((Comparable) wfp-healthy?(wfp-common-use()) == 0, 64) + wfpk((String) wfp-count-verdict(3, wfp-pure-use()) == "healthy", 128) + wfpk((String) wfp-count-verdict(3, wfp-common-use()) == "attention", 256) + wfpk((String) wfp-count-verdict(0, wfp-common-use()) == "clear", 512) + wfpk((String) wfp-word(refu) == "refuse" && str_find(wfp-purified(refu), "remains", 0) >= 0, 1024) + wfpk((String) wfp-word(neg) == "not" && str_find(wfp-purified(neg), "instead", 0) >= 0, 2048) + wfpk((Comparable) wfp-path?(wfp-kind-path()) == 1 && (Comparable) wfp-path?(wfp-kind-absence()) == 0, 4096);
    };
    0;
}
