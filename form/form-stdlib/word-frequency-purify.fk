; word-frequency-purify.fk — usage is alive; any word walks.
;
; A closed shelf of words is static. It contracts aliveness into a
; labyrinth. The living law is USAGE KIND, and it reads every word:
;   absence  — names what is missing and leaves the path unnamed
;   path     — names the offered way, so the body can walk
; Health is the kind of this usage. The surface stays the word it is.
;
; The seed rows are memory (axiom-3): examples that already lifted.
; A new word enters by admit. The seed stays referenced. Length is
; free to grow. Gene Keys already holds the shape (shadow -> gift
; -> siddhi). agent-gate said it for "gate": at love it recognizes.
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/word-frequency-purify-band.fk
; witnessed: 2026-08-14 -> band 8191

(do
    ; row: (word common-desc purified-desc trust sov vit)
    ; trust/sov/vit are the lifts of the PURIFIED usage, 1..3.
    (defn wfp-row (word common purified t s v)
        (list word common purified t s v))
    (defn wfp-word     (r) (nth r 0))
    (defn wfp-common   (r) (nth r 1))
    (defn wfp-purified (r) (nth r 2))
    (defn wfp-trust    (r) (nth r 3))
    (defn wfp-sov      (r) (nth r 4))
    (defn wfp-vit      (r) (nth r 5))

    ; usage: 0 common / 1 purified. The surface is the same either way.
    (defn wfp-common-use () 0)
    (defn wfp-pure-use () 1)
    (defn wfp-healthy? (use) (if (eq use (wfp-pure-use)) 1 0))

    ; The living law. Any word. Kind is the read.
    (defn wfp-kind-absence () 0)
    (defn wfp-kind-path    () 1)
    (defn wfp-usage (word kind) (list word kind))
    (defn wfp-u-word (u) (nth u 0))
    (defn wfp-u-kind (u) (nth u 1))
    (defn wfp-path? (kind) (if (eq kind (wfp-kind-path)) 1 0))
    (defn wfp-admit (rs row) (cons row rs))

    (defn wfp-rows ()
        (list
            (wfp-row "law"
                "a command from above that binds without being observed"
                "a currently-observed belief with a freshness stamp"
                3 2 2)
            (wfp-row "must"
                "an obligation backed by force"
                "this comes first; the order is named and the cell still chooses"
                2 2 2)
            (wfp-row "gate"
                "a guard that admits or keeps the stranger out"
                "a welcoming threshold that recognizes and names the edge"
                3 3 3)
            (wfp-row "refuse"
                "rejection of the person who offered"
                "this offer is not admitted; the cell remains, the person remains"
                3 3 2)
            (wfp-row "enforce"
                "force applied to make a body comply"
                "tend the boundary so what was offered stays true"
                2 2 3)
            (wfp-row "forbid"
                "a ban that sets the word itself down"
                "this path is not offered here; another path is named"
                2 3 2)
            (wfp-row "strict"
                "rigidity that punishes deviation"
                "the edge is exact so both sides can trust it"
                3 2 2)
            (wfp-row "mandatory"
                "no consent, no alternative"
                "this axis is load-bearing; the body says so plainly"
                2 2 2)
            (wfp-row "comply"
                "submit to an external will"
                "meet the offered interface; the ack is still sovereign"
                2 3 2)
            (wfp-row "violation"
                "a crime against a rule"
                "a breach of an offered interface, observable and healable"
                3 2 2)
            (wfp-row "not"
                "names what is absent and leaves the path unnamed"
                "name the path that is offered; say what happens instead"
                3 3 3)))

    (defn wfp-find-loop (rs word)
        (if (eq (len rs) 0) (empty)
            (if (str_eq (wfp-word (head rs)) word) (head rs)
                (wfp-find-loop (tail rs) word))))
    (defn wfp-find (word) (wfp-find-loop (wfp-rows) word))
    (defn wfp-known? (word) (if (eq (len (wfp-find word)) 0) 0 1))

    ; Purification keeps the surface. A new description mints a new cell
    ; (axiom-3); the word is still the word.
    (defn wfp-same-word? (r)
        (if (gt (str_len (wfp-word r)) 0) 1 0))
    (defn wfp-desc-lifted? (r)
        (if (str_eq (wfp-common r) (wfp-purified r)) 0 1))
    (defn wfp-lifts? (r)
        (if (and (ge (wfp-trust r) 1)
            (and (ge (wfp-sov r) 1)
                 (ge (wfp-vit r) 1)))
            1 0))

    ; A count of the word is not a verdict. Common usage is attention.
    ; Purified usage is healthy. Appearance alone decides nothing.
    (defn wfp-count-verdict (count use)
        (if (eq use (wfp-pure-use)) "healthy"
            (if (gt count 0) "attention" "clear")))

    (defn wfp-all-kept-loop (rs)
        (if (eq (len rs) 0) 1
            (if (eq (wfp-same-word? (head rs)) 1)
                (wfp-all-kept-loop (tail rs))
                0)))
    (defn wfp-all-lifted-loop (rs)
        (if (eq (len rs) 0) 1
            (if (and (eq (wfp-desc-lifted? (head rs)) 1)
                     (eq (wfp-lifts? (head rs)) 1))
                (wfp-all-lifted-loop (tail rs))
                0)))
    (defn wfp-all-kept? () (wfp-all-kept-loop (wfp-rows)))
    (defn wfp-all-lifted? () (wfp-all-lifted-loop (wfp-rows)))

    (defn wfpk (cond bit) (if cond bit 0))
    (defn wfp-check ()
        (do
            (let gate (wfp-find "gate"))
            (let law  (wfp-find "law"))
            (let must (wfp-find "must"))
            (let refu (wfp-find "refuse"))
            (let neg  (wfp-find "not"))
            (let grown (wfp-admit (wfp-rows)
                (wfp-row "aliveness" "a shelf to guard" "a usage that names a path" 3 3 3)))
            (add (add (add (add (add (add (add (add (add (add (add (add
                (wfpk (eq (wfp-all-kept?) 1) 1)
                (wfpk (eq (wfp-all-lifted?) 1) 2))
                (wfpk (gt (len grown) (len (wfp-rows))) 4))
                (wfpk (and (ge (str_find (wfp-purified gate) "recogn" 0) 0)
                           (ge (str_find (wfp-common gate) "guard" 0) 0)) 8))
                (wfpk (and (ge (str_find (wfp-purified law) "observed" 0) 0)
                           (ge (str_find (wfp-common law) "command" 0) 0)) 16))
                (wfpk (eq (wfp-healthy? (wfp-pure-use)) 1) 32))
                (wfpk (eq (wfp-healthy? (wfp-common-use)) 0) 64))
                (wfpk (str_eq (wfp-count-verdict 3 (wfp-pure-use)) "healthy") 128))
                (wfpk (str_eq (wfp-count-verdict 3 (wfp-common-use)) "attention") 256))
                (wfpk (str_eq (wfp-count-verdict 0 (wfp-common-use)) "clear") 512))
                (wfpk (and (str_eq (wfp-word refu) "refuse")
                           (ge (str_find (wfp-purified refu) "remains" 0) 0)) 1024))
                (wfpk (and (str_eq (wfp-word neg) "not")
                           (ge (str_find (wfp-purified neg) "instead" 0) 0)) 2048))
                (wfpk (and (eq (wfp-path? (wfp-kind-path)) 1)
                           (eq (wfp-path? (wfp-kind-absence)) 0)) 4096))))

    0)
