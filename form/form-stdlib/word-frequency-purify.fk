    def wfp-arrived() = wfp-cat([wfp-arrived-0(), wfp-arrived-1(), wfp-arrived-2(), wfp-arrived-3(), wfp-arrived-4(), wfp-arrived-5(), wfp-arrived-6(), wfp-arrived-7(), wfp-arrived-8(), wfp-arrived-9(), wfp-arrived-10(), wfp-arrived-11(), wfp-arrived-12(), wfp-arrived-13(), wfp-arrived-14(), wfp-arrived-15(), wfp-arrived-16(), wfp-arrived-17(), wfp-arrived-18(), wfp-arrived-19()]);

    def wfp-lb(b) = b >= 65 && b <= 90 ? b + 32 : b;
    def wfp-letter?(b) = (b >= 97 && b <= 122) || (b >= 65 && b <= 90);
    def wfp-lower-go(s, i, n, out) = i >= n ? out : wfp-lower-go(s, i + 1, n, out + byte_to_str(wfp-lb(str_byte_at(s, i))));
    def wfp-lower(s) = wfp-lower-go(s, 0, len(s), "");
    def wfp-skip(s, i, n) = i >= n ? i : (Comparable) wfp-letter?(str_byte_at(s, i)) == 0 ? wfp-skip(s, i + 1, n) : i;
    def wfp-end(s, i, n) = i >= n ? i : (Comparable) wfp-letter?(str_byte_at(s, i)) == 1 ? wfp-end(s, i + 1, n) : i;
    def wfp-tokens-go(s, i, n, acc) {
        let a = wfp-skip(s, i, n);
        a >= n ? reverse(acc) : wfp-tokens-go(s, wfp-end(s, a, n), n, cons(substring(s, a, wfp-end(s, a, n)), acc));
    }
    def wfp-tokens(s) = wfp-tokens-go(s, 0, len(s), []);
    def wfp-stops() = ["the", "this", "that", "with", "from", "have", "been", "were", "they", "them", "their", "there", "what", "when", "where", "which", "while", "whose", "about", "after", "again", "being", "other", "into", "over", "such", "than", "then", "these", "those", "under", "very", "your", "just", "like", "make", "made", "many", "much", "only", "some", "will", "would", "could", "should", "above", "across", "against", "along", "among", "around", "because", "before", "behind", "below", "between", "during", "except", "inside", "outside", "toward", "towards", "without", "within", "people", "person", "something", "anything", "everything", "someone", "anyone", "every", "still", "through", "also", "more", "most", "same", "each", "both", "another", "already", "always", "never", "often", "once", "since", "until", "further", "however", "therefore", "otherwise", "section", "import", "return", "false", "true", "string", "number", "empty", "list", "form", "stdlib", "tests", "observe", "docs"];
    def wfp-stop?(word) = wfp-has?(word, wfp-stops());
    def wfp-has?(word, rs) = (Comparable) len(rs) == 0 ? 0 : (String) rs[0] == word ? 1 : wfp-has?(word, rs[1:]);
    def wfp-seen?(word, seen) = wfp-has?(word, seen);
    def wfp-in?(word, rows) = (Comparable) len(wfp-find-loop(rows, word)) == 0 ? 0 : 1;
    def wfp-join(xs) = (Comparable) len(xs) == 0 ? "" : (Comparable) len(xs) == 1 ? xs[0] : (xs[0] + (" " + wfp-join(xs[1:])));
    def wfp-window(tokens, i) {
        let a = i > 3 ? i - 3 : 0;
        let b = i + 4;
        let end = b > len(tokens) ? len(tokens) : b;
        wfp-join(tokens[a:end]);
    }
    def wfp-draft-of(word, window) = wfp-row(word, window, ("a path the teachings name for " + word), 2, 2, 2);
    def wfp-drafts(tokens) = wfp-drafts-go(tokens, 0, [], [], wfp-arrived());
    def wfp-drafts-go(tokens, i, seen, acc, arrived) = i >= len(tokens) ? reverse(acc) : wfp-drafts-step(tokens, i, seen, acc, arrived);
    def wfp-drafts-step(tokens, i, seen, acc, arrived) {
        let w = tokens[i];
        let fresh = (Comparable) len(w) >= 5 && (Comparable) wfp-stop?(w) == 0 && (Comparable) wfp-known?(w) == 0 && (Comparable) wfp-in?(w, arrived) == 0 && (Comparable) wfp-seen?(w, seen) == 0;
        fresh ? wfp-drafts-go(tokens, i + 1, cons(w, seen), cons(wfp-draft-of(w, wfp-window(tokens, i)), acc), arrived) : wfp-drafts-go(tokens, i + 1, seen, acc, arrived);
    }
    def wfp-admit-all(rs, drafts) = (Comparable) len(drafts) == 0 ? rs : wfp-admit-all(wfp-admit(rs, drafts[0]), drafts[1:]);
    def wfp-free?(t, at, wlen) = (at == 0 || (Comparable) wfp-letter?(str_byte_at(t, at - 1)) == 0) && (at + wlen >= len(t) || (Comparable) wfp-letter?(str_byte_at(t, at + wlen)) == 0);
    def wfp-count-go(t, w, from, acc) {
        let at = str_find(t, w, from);
        at < 0 ? acc : wfp-count-go(t, w, at + len(w), acc + (wfp-free?(t, at, len(w)) ? 1 : 0));
    }
    def wfp-register-of(text, rows) = foldl((a, r) => a + wfp-count-go(text, wfp-word(r), 0, 0), 0, rows);
    def wfp-cue?(text) = str_find(text, "completely normal", 0) >= 0 || str_find(text, "you've got this", 0) >= 0;
    def wfp-affirmed?(row) = (Comparable) wfp-desc-lifted?(row) == 1 && (Comparable) wfp-lifts?(row) == 1 && str_find(wfp-purified(row), "path", 0) >= 0 && (Comparable) wfp-cue?(wfp-purified(row)) == 0 ? 1 : 0;
    def wfp-affirmed-n(rows) = (Comparable) len(rows) == 0 ? 0 : (Number) wfp-affirmed?(rows[0]) + (Number) wfp-affirmed-n(rows[1:]);
    def wfp-axiom-words() = ["zero", "cell", "blueprint", "interface", "recipe"];
    def wfp-axiom-hits(text) = wfp-axiom-go(wfp-lower(text), wfp-axiom-words());
    def wfp-axiom-one(text, word) = wfp-count-go(text, word, 0, 0) > 0 ? 1 : 0;
    def wfp-axiom-go(text, words) = (Comparable) len(words) == 0 ? 0 : (Number) wfp-axiom-one(text, words[0]) + (Number) wfp-axiom-go(text, words[1:]);
    def wfp-passage(text) {
        let low = wfp-lower(text);
        let tokens = wfp-tokens(low);
        let arrived = wfp-arrived();
        let before = wfp-register-of(low, wfp-rows());
        let drafts = wfp-drafts-go(tokens, 0, [], [], arrived);
        let kept = filter(r => (Comparable) wfp-affirmed?(r) == 1, drafts);
        let grown = wfp-admit-all(append(wfp-rows(), arrived), kept);
        let after = wfp-register-of(low, grown);
        [before, after, len(kept), wfp-affirmed-n(kept), wfp-axiom-hits(low)];
    }
    def wfp-passage-grew?(text) {
        let read = wfp-passage(text);
        read[1] >= read[0] ? 1 : 0;
    }

    0;
