; form-knowledge-public-family-mastery-finalizer.fk -- exact public crossing.
;
; This pure organ joins three already-observed surfaces without pretending one
; can substitute for another:
;   1. the 30-trial public resident export (two fresh generations/family),
;   2. one family-executed BML+BMF+Form generative evidence/family, and
;   3. one family-native check with structured execution receipt/family.
;
; The worse resident trial is selected independently for each family. Both
; trials must be >=95 before that family has heldout standing. The canonical
; public-family mastery report receives only validated heldout, generative and
; execution evidence. Duplicate families or receipts, replay, family/source/
; model/run swaps, invalid nested rows and caller-supplied flag shapes are
; refused as actual `nothing`. A well-shaped but incomplete school remains a
; present result with ready=0. Native value-present is independent of the
; result value, so a present 0 or 1 cannot collapse into absence.
;
; PHYSICAL SEAM. Receipt validation proves content and binding consistency. It
; does not authenticate the model, Metal/GPU hardware, process, or host. Exact
; admitted receipts and their physical observations still need public durable
; persistence. Synthetic bands establish only this pure contract.
;
; Route addressability contributes literal 0 mastery credit.
; witnessed: 2026-08-25 -> 1073741823, exit 0
; preludes: form-stdlib/form-knowledge-public-resident-eval.fk form-stdlib/form-knowledge-family-native-exec-teach-check.fk

(do
    (defn fkpmf-basis ()
        "30-trial-worse-of-two+family-generative+family-native-receipt-v1")
    (defn fkpmf-authentication-seam ()
        "content-bound receipts do not authenticate model, Metal/GPU hardware, process, or host")
    (defn fkpmf-route-credit () 0)

    ; ---- supplied row sets ------------------------------------------
    (defn fkpmf-all-generative-valid? (rows)
        (if (eq (len rows) 0) 1
            (if (eq (fkpfm-generative-valid? (head rows)) 1)
                (fkpmf-all-generative-valid? (tail rows)) 0)))
    (defn fkpmf-all-native-valid? (rows)
        (if (eq (len rows) 0) 1
            (if (eq (fkfne-check-valid? (head rows)) 1)
                (fkpmf-all-native-valid? (tail rows)) 0)))
    (defn fkpmf-generative-family (e) (nth e 2))
    (defn fkpmf-native-family (check)
        (fkfne-binding-family (fkfne-check-binding check)))
    (defn fkpmf-generative-model (e) (nth e 3))
    (defn fkpmf-native-model (check) (fkfne-check-model-id check))
    (defn fkpmf-generative-receipt (e) (nth e 4))
    (defn fkpmf-native-receipt (check) (fkfne-check-receipt check))

    (defn fkpmf-count-generative-family (family rows)
        (if (eq (len rows) 0) 0
            (add (if (str_eq family
                    (fkpmf-generative-family (head rows))) 1 0)
                 (fkpmf-count-generative-family family (tail rows)))))
    (defn fkpmf-count-native-family (family rows)
        (if (eq (len rows) 0) 0
            (add (if (str_eq family
                    (fkpmf-native-family (head rows))) 1 0)
                 (fkpmf-count-native-family family (tail rows)))))
    (defn fkpmf-family-counts-unique? (families generative native)
        (if (eq (len families) 0) 1
            (if (and (le (fkpmf-count-generative-family
                              (head families) generative) 1)
                     (le (fkpmf-count-native-family
                              (head families) native) 1))
                (fkpmf-family-counts-unique? (tail families)
                    generative native) 0)))
    (defn fkpmf-all-generative-model? (rows model-id)
        (if (eq (len rows) 0) 1
            (if (str_eq (fkpmf-generative-model (head rows)) model-id)
                (fkpmf-all-generative-model? (tail rows) model-id) 0)))
    (defn fkpmf-all-native-model? (rows model-id)
        (if (eq (len rows) 0) 1
            (if (str_eq (fkpmf-native-model (head rows)) model-id)
                (fkpmf-all-native-model? (tail rows) model-id) 0)))

    (defn fkpmf-count-generative-receipt-sha (sha rows)
        (if (eq (len rows) 0) 0
            (add (if (str_eq sha (fkpfm-receipt-sha
                    (fkpmf-generative-receipt (head rows)))) 1 0)
                 (fkpmf-count-generative-receipt-sha sha (tail rows)))))
    (defn fkpmf-count-native-receipt-sha (sha rows)
        (if (eq (len rows) 0) 0
            (add (if (str_eq sha (fkpfm-receipt-sha
                    (fkpmf-native-receipt (head rows)))) 1 0)
                 (fkpmf-count-native-receipt-sha sha (tail rows)))))
    (defn fkpmf-generative-receipts-unique? (rows all-gen all-native)
        (if (eq (len rows) 0) 1
            (do
                (let sha (fkpfm-receipt-sha
                    (fkpmf-generative-receipt (head rows))))
                (if (eq (add (fkpmf-count-generative-receipt-sha sha all-gen)
                             (fkpmf-count-native-receipt-sha sha all-native)) 1)
                    (fkpmf-generative-receipts-unique?
                        (tail rows) all-gen all-native) 0))))
    (defn fkpmf-native-receipts-unique? (rows all-gen all-native)
        (if (eq (len rows) 0) 1
            (do
                (let sha (fkpfm-receipt-sha
                    (fkpmf-native-receipt (head rows))))
                (if (eq (add (fkpmf-count-generative-receipt-sha sha all-gen)
                             (fkpmf-count-native-receipt-sha sha all-native)) 1)
                    (fkpmf-native-receipts-unique?
                        (tail rows) all-gen all-native) 0))))

    (defn fkpmf-export-shape? (export)
        (if (not (eq (fkpfm-list? export) 1)) 0
        (if (not (eq (len export) 18)) 0
            (if (str_eq (head export)
                    "public-heldout-resident-export-v1") 1 0))))
    (defn fkpmf-inputs-valid? (export generative native)
        (if (not (eq (fkpfm-list? export) 1)) 0
        (if (not (eq (fkpfm-list? generative) 1)) 0
        (if (not (eq (fkpfm-list? native) 1)) 0
        (if (not (eq (fkpmf-export-shape? export) 1)) 0
        (if (or (gt (len generative) (fkpfm-family-total))
                (gt (len native) (fkpfm-family-total))) 0
        (if (not (eq (fkpmf-all-generative-valid? generative) 1)) 0
        (if (not (eq (fkpmf-all-native-valid? native) 1)) 0
            (do
                (let model-id (nth export 2))
                (let families (fkpfm-family-ids))
                (if (and (eq (fkpmf-family-counts-unique?
                                  families generative native) 1)
                     (and (eq (fkpmf-all-generative-model?
                                  generative model-id) 1)
                     (and (eq (fkpmf-all-native-model? native model-id) 1)
                     (and (eq (fkpmf-generative-receipts-unique?
                                  generative generative native) 1)
                     (and (eq (fkpmf-native-receipts-unique?
                                  native generative native) 1)
                          (eq (fkp30-export-valid? export) 1)))))) 1 0))))))))))

    (defn fkpmf-find-generative (family rows)
        (if (eq (len rows) 0) (nothing)
            (if (str_eq family (fkpmf-generative-family (head rows)))
                (head rows) (fkpmf-find-generative family (tail rows)))))
    (defn fkpmf-find-native (family rows)
        (if (eq (len rows) 0) (nothing)
            (if (str_eq family (fkpmf-native-family (head rows)))
                (head rows) (fkpmf-find-native family (tail rows)))))

    ; ---- two trials and their worse representative ------------------
    (defn fkpmf-trial-family (trial)
        (fkp30-presentation-family (fkp30-trial-presentation trial)))
    (defn fkpmf-trial-lane (trial)
        (fkp30-presentation-lane (fkp30-trial-presentation trial)))
    (defn fkpmf-trial-heldout95? (trial)
        (if (not (eq (fkp30-trial-valid? trial) 1)) 0
            (fkpmf-valid-trial-heldout95? trial)))
    ; Finalization reaches this helper only after fkp30-export-valid? has
    ; already recomputed every trial. Avoid rescoring those same bytes for
    ; every family row and aggregate count.
    (defn fkpmf-valid-trial-heldout95? (trial)
            (do
                (let observation
                    (fkhe-score-observation (fkp30-trial-score trial)))
                (if (and (eq (nmfe-obs-error observation) 0)
                     (and (eq (fkhe-at-least95?
                                   (nmfe-obs-promotion observation)) 1)
                     (and (eq (fkp30-trial-local trial) 1)
                     (and (eq (fkp30-trial-remote trial) 0)
                     (and (eq (fkp30-trial-model-executed trial) 1)
                     (and (eq (fkp30-trial-state-released trial) 1)
                     (and (eq (fkp30-trial-same-residence trial) 1)
                          (eq (fkp30-trial-telemetry-present? trial)
                              1)))))))) 1 0)))
    (defn fkpmf-worse-trial (a b)
        (if (le (nmfe-obs-promotion
                    (fkhe-score-observation (fkp30-trial-score a)))
                (nmfe-obs-promotion
                    (fkhe-score-observation (fkp30-trial-score b)))) a b))
    (defn fkpmf-family-trials (family trials)
        (do
            (let row (fkpfm-heldout-row-for-family family (fkhe-rows)))
            (if (nothing? row) (nothing)
                (do
                    (let a (fkp30-find-trial trials (fkhe-id row) "a"))
                    (let b (fkp30-find-trial trials (fkhe-id row) "b"))
                    (if (or (nothing? a) (nothing? b)) (nothing)
                        (list a b (fkpmf-worse-trial a b)))))))

    ; family row = tag family trial-a trial-b worse heldout generative
    ;              native-check execution both-heldout heldout-ok gen-ok
    ;              exec-ok value-present value mastered
    (defn fkpmf-family-row
        (family export report-valid trials generative native)
        (do
            (let pair (fkpmf-family-trials family trials))
            (let a (if (nothing? pair) (nothing) (nth pair 0)))
            (let b (if (nothing? pair) (nothing) (nth pair 1)))
            (let worse (if (nothing? pair) (nothing) (nth pair 2)))
            (let both (if (nothing? pair) 0
                (if (and (eq (fkpmf-valid-trial-heldout95? a) 1)
                         (eq (fkpmf-valid-trial-heldout95? b) 1)) 1 0)))
            (let report (nth export 5))
            (let heldout
                (if (and (eq both 1)
                         (eq report-valid 1))
                    (do
                        (let receipt (fkpfm-heldout-receipt family
                            (nth export 2) (nth export 3)
                            (fkp30-trial-raw-output worse) report))
                        (fkpfm-heldout-evidence family receipt report))
                    (nothing)))
            (let gen (fkpmf-find-generative family generative))
            (let check (fkpmf-find-native family native))
            (let execution (if (nothing? check) (nothing)
                (fkfne-check-evidence check)))
            ; Supplied generative/native rows were validated once at the input
            ; boundary. Fresh heldout evidence is validated by fkpfm-report.
            (let heldout-ok (if (nothing? heldout) 0 1))
            (let gen-ok (if (nothing? gen) 0 1))
            (let exec-ok (if (nothing? execution) 0 1))
            (let present (if (nothing? check) 0
                (frex-result-value-present? (fkfne-check-result check))))
            (let value (if (nothing? check) (nothing)
                (frex-result-value (fkfne-check-result check))))
            (let mastered (if (and (eq heldout-ok 1)
                (and (eq gen-ok 1) (and (eq exec-ok 1)
                     (eq present 1)))) 1 0))
            (list "public-family-mastery-finalizer-row-v1" family
                a b worse heldout gen check execution both heldout-ok gen-ok
                exec-ok present value mastered)))
    (defn fkpmf-family-rows-loop
        (families export report-valid trials generative native)
        (if (eq (len families) 0) (list)
            (cons (fkpmf-family-row (head families) export report-valid
                    trials generative native)
                (fkpmf-family-rows-loop (tail families) export report-valid
                    trials generative native))))
    (defn fkpmf-row-heldout (row) (nth row 5))
    (defn fkpmf-row-generative (row) (nth row 6))
    (defn fkpmf-row-execution (row) (nth row 8))
    (defn fkpmf-row-both-heldout? (row) (nth row 9))
    (defn fkpmf-row-heldout-valid? (row) (nth row 10))
    (defn fkpmf-row-generative-valid? (row) (nth row 11))
    (defn fkpmf-row-execution-valid? (row) (nth row 12))
    (defn fkpmf-row-value-present? (row) (nth row 13))
    (defn fkpmf-row-value (row) (nth row 14))
    (defn fkpmf-row-mastered? (row) (nth row 15))
    (defn fkpmf-count-row-field (rows index)
        (if (eq (len rows) 0) 0
            (add (nth (head rows) index)
                 (fkpmf-count-row-field (tail rows) index))))
    (defn fkpmf-count-good-trials (trials)
        (if (eq (len trials) 0) 0
            (add (fkpmf-valid-trial-heldout95? (head trials))
                 (fkpmf-count-good-trials (tail trials)))))

    (defn fkpmf-cons-present (x xs)
        (if (nothing? x) xs (cons x xs)))
    (defn fkpmf-row-evidences (row rest)
        (fkpmf-cons-present (fkpmf-row-heldout row)
            (fkpmf-cons-present (fkpmf-row-generative row)
                (fkpmf-cons-present (fkpmf-row-execution row) rest))))
    (defn fkpmf-evidences-loop (rows)
        (if (eq (len rows) 0) (list)
            (fkpmf-row-evidences (head rows)
                (fkpmf-evidences-loop (tail rows)))))

    ; result = tag basis status model resident-run total mastered percent ready
    ;          heldout-generations heldout-families generative-families
    ;          execution-families invalid rows mastery route-credit auth-seam
    (defn fkpmf-finalize (export generative native)
        (if (not (eq (fkpmf-inputs-valid? export generative native) 1))
            (nothing)
            (do
                (let trials (fkp30-public-trials-unseal (nth export 4)))
                (let report-valid
                    (fkpfm-heldout-report-valid? (nth export 5)))
                (let rows (fkpmf-family-rows-loop (fkpfm-family-ids)
                    export report-valid trials generative native))
                (let evidences (fkpmf-evidences-loop rows))
                (let mastery (fkpfm-report evidences))
                (let total (len rows))
                (let mastered (fkpmf-count-row-field rows 15))
                (let heldout-generations (fkpmf-count-good-trials trials))
                (let heldout-families (fkpmf-count-row-field rows 9))
                (let generative-families (fkpmf-count-row-field rows 11))
                (let execution-families (fkpmf-count-row-field rows 12))
                (let ready (if (and (eq total 15)
                    (and (eq mastered 15)
                    (and (eq heldout-generations 30)
                    (and (eq heldout-families 15)
                    (and (eq generative-families 15)
                    (and (eq execution-families 15)
                    (and (eq (fkpfm-report-total mastery) 15)
                    (and (eq (fkpfm-report-mastered mastery) 15)
                    (and (eq (fkpfm-report-ready95? mastery) 1)
                    (and (eq (fkpfm-report-invalid-evidence mastery) 0)
                         (eq (fkpfm-report-route-addressability-credit
                                  mastery) 0))))))))))) 1 0))
                (list "form-knowledge-public-family-mastery-finalizer-v1"
                    (fkpmf-basis) (if (eq ready 1) "value" "not-yet")
                    (nth export 2) (nth export 3) total mastered
                    (fkpfm-percent mastered total) ready heldout-generations
                    heldout-families generative-families execution-families
                    (fkpfm-report-invalid-evidence mastery) rows mastery
                    (fkpmf-route-credit) (fkpmf-authentication-seam)))))

    (defn fkpmf-result-status (r) (nth r 2))
    (defn fkpmf-result-total (r) (nth r 5))
    (defn fkpmf-result-mastered (r) (nth r 6))
    (defn fkpmf-result-percent (r) (nth r 7))
    (defn fkpmf-result-ready? (r) (nth r 8))
    (defn fkpmf-result-heldout-generations (r) (nth r 9))
    (defn fkpmf-result-heldout-families (r) (nth r 10))
    (defn fkpmf-result-generative-families (r) (nth r 11))
    (defn fkpmf-result-execution-families (r) (nth r 12))
    (defn fkpmf-result-invalid (r) (nth r 13))
    (defn fkpmf-result-rows (r) (nth r 14))
    (defn fkpmf-result-mastery (r) (nth r 15))
    (defn fkpmf-result-route-credit (r) (nth r 16))
    (defn fkpmf-result-authentication-seam (r) (nth r 17))
    (defn fkpmf-result-valid? (result export generative native)
        (if (not (eq (fkpfm-list? result) 1)) 0
        (if (not (eq (len result) 18)) 0
        (if (not (str_eq (head result)
                         "form-knowledge-public-family-mastery-finalizer-v1")) 0
            (do
                (let rebuilt (fkpmf-finalize export generative native))
                (if (nothing? rebuilt) 0
                    (fkpfm-equal? result rebuilt)))))))

    0)
