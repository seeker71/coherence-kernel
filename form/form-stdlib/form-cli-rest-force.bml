//////////////////////////////////////////////////////////////////////
//
// form-cli-rest-force.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-restanswer.bml
//
// The resting answer meets the crystallize door, authored at altitude:
// a rest pointer lowers into the heat gate's own program shape, an unspecialized
// force walks the form route counted, the fifth force births native
// once, and the op the lowering cannot express answers through the
// tree-walk as form-unlowerable — visible, never pretended, never
// refused. The .fk organ (rest-force-jit.fk) is the earlier lowering;
// rfb-agree() witnesses that surface and organ answer as one.
//
// Proven by: form-stdlib/tests/form-cli-rest-force-bml-band.fk
//
// preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk form-stdlib/learning-loop.fk form-stdlib/local-generate-organ.fk form-stdlib/form-asm.fk form-stdlib/form-lower.fk form-stdlib/jit-decision.fk form-stdlib/jit-once-born.fk form-stdlib/jit-heat-gate.fk form-stdlib/rest-force-jit.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormRestForceAuthority {
        field RestForceAuthorityPath = "form/form-stdlib/bml/form-cli-restanswer.bml";
        field RestForceAuthorityKind = "high-bml-class-template-field";
    }

    class FormRestForce {
        field OpAdd = 3;
        field OpSub = 4;
        field OpMul = 5;
        field OpNone = 0;
        field LitTag = 1;
        field GateSeed = 5151;

        ref rfb-authority = FormRestForceAuthority;
        thought rfb-pattern = list("lower", "below-threshold-tree-walk", "birth-once", "unlowerable-visible", "agree-with-organ");

        def rfb-op-tag(op) = if ((String) op == "add") then OpAdd() else if ((String) op == "sub") then OpSub() else if ((String) op == "mul") then OpMul() else OpNone();

        def rfb-emit-lit(x, prog) {
            let p2 = lg-cat(prog, list(list(LitTag(), x)));
            list(p2, (len(p2) - 1));
        }
        def rfb-emit-operand(x, prog) = if ((Comparable) lg-defer?(x) == 1) then rfb-emit(x, prog) else rfb-emit-lit(x, prog);
        def rfb-emit-close(tag, ea, eb) {
            let p3 = lg-cat(nth(eb, 0), list(list(tag, nth(ea, 1), nth(eb, 1))));
            list(p3, (len(p3) - 1));
        }
        def rfb-emit-b(tag, ea, p) {
            let eb = rfb-emit-operand(nth(p, 3), nth(ea, 0));
            if nothing?(eb) then nothing() else rfb-emit-close(tag, ea, eb);
        }
        def rfb-emit-a(tag, p, prog) {
            let ea = rfb-emit-operand(nth(p, 2), prog);
            if nothing?(ea) then nothing() else rfb-emit-b(tag, ea, p);
        }
        def rfb-emit(p, prog) {
            let tag = rfb-op-tag(nth(p, 1));
            if ((Comparable) tag == 0) then nothing() else rfb-emit-a(tag, p, prog);
        }
        def rfb-lower(p) = rfb-emit(p, tail(list("x")));

        def rfb-force(g, p) {
            let low = rfb-lower(p);
            if nothing?(low) then list(lg-force(p), "form-unlowerable", g, 0) else hg-request(g, nth(low, 0), nth(low, 1), 0);
        }

        def rfb-run(g, p, n, v, route, borns) {
            if ((Comparable) n == 0) then list(v, route, g, borns) else rfb-step(g, p, n, borns);
        }
        def rfb-step(g, p, n, borns) {
            let r = rfb-force(g, p);
            rfb-run(nth(r, 2), p, (n - 1), nth(r, 0), nth(r, 1), (borns + nth(r, 3)));
        }

        def rfb-bit(ok, bit) = if ok then bit else 0;
        def rfb-check() {
            let rest = lg-defer("mul", 6, 7);
            let nested = lg-defer("add", lg-defer("mul", 6, 7), lg-defer("sub", 9, 4));
            let odd = lg-defer("eq", 5, 5);
            let walked = rfb-force(hg-gate(GateSeed()), rest);
            let four = rfb-run(hg-gate(GateSeed()), rest, 4, 0, "", 0);
            let fifth = rfb-force(nth(four, 2), rest);
            let sixth = rfb-force(nth(fifth, 2), rest);
            let deep = rfb-force(hg-gate(GateSeed()), nested);
            let stray = rfb-force(hg-gate(GateSeed()), odd);
            let c0 = rfb-bit(((Comparable) nth(walked, 0) == 42), 1);
            let c1 = rfb-bit(((String) nth(walked, 1) == "form"), 2);
            let c2 = rfb-bit(((Comparable) nth(fifth, 3) == 1), 4);
            let c3 = rfb-bit(((String) nth(sixth, 1) == "native"), 8);
            let c4 = rfb-bit(((Comparable) nth(sixth, 0) == 42), 16);
            let c5 = rfb-bit(((Comparable) nth(deep, 0) == 47), 32);
            let c6 = rfb-bit(((String) nth(stray, 1) == "form-unlowerable"), 64);
            let c7 = rfb-bit(((Comparable) nth(stray, 0) == 1), 128);
            (c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + c7)))))));
        }
        def rfb-agree() {
            let rest = lg-defer("mul", 6, 7);
            let nested = lg-defer("add", lg-defer("mul", 6, 7), lg-defer("sub", 9, 4));
            let a0 = rfb-bit(((Value) rfb-lower(rest) == rfj-lower(rest)), 1);
            let a1 = rfb-bit(((Value) rfb-lower(nested) == rfj-lower(nested)), 2);
            let a2 = rfb-bit(((Comparable) nth(rfb-force(hg-gate(717), rest), 0) == nth(rfj-force(hg-gate(717), rest), 0)), 4);
            let a3 = rfb-bit(((Comparable) nothing?(rfb-lower(lg-defer("eq", 1, 1))) == nothing?(rfj-lower(lg-defer("eq", 1, 1)))), 8);
            (a0 + (a1 + (a2 + a3)));
        }
    }
    0;
}
