// form-cli-current-answer-thought-witness.fk -- observable full-REPL surface
// for the compact current-answer recipe-data evaluator.
//
import form-stdlib/core.fk;
import form-stdlib/form-cli-current-answer-thought-walk.fk;
import form-stdlib/form-program-image-call-protocol.fk;
import form-stdlib/form-cli-strict-route-image-call.fk;
section [form.bml] {
    def fcatww-values(source, answer-right) = [source, source, "answer", answer-right, "hit", "hit", "concept-registry-current-source-hit", "concept-registry-current-source-hit", 1, 1, 1, 1, 1, 1, "choice,cut,release", "choice,cut,release"];
    def fcatww-kinds() = [fcatw-kind-node(), fcatw-kind-node(), fcatw-kind-string(), fcatw-kind-string(), fcatw-kind-string(), fcatw-kind-string(), fcatw-kind-string(), fcatw-kind-string(), fcatw-kind-int(), fcatw-kind-int(), fcatw-kind-int(), fcatw-kind-int(), fcatw-kind-int(), fcatw-kind-int(), fcatw-kind-string(), fcatw-kind-string()];
    def fcatww-line(acc, key, value) = (acc + ("\n" + (key + ("=" + value))));
    def fcatww-live() = {
        let source = intern_trivial_string("sha256:resident-witness");
        let kinds = fcatww-kinds();
        let agreed = fcatw-run(fcatww-values(source, "answer"), kinds, 93);
        let disagreed = fcatw-run(fcatww-values(source, "different"), kinds, 93);
        let timed = fcatw-run(fcatww-values(source, "answer"), kinds, 92);
        // A caller and callee born as image data cross the generic
        // CALL_BINDING / OFFER / ACK organ in the actual REPL closure.
        let caller-image = fcatw-image([], [fcatw-row(1, 7, 0, 0)], [], 0);
        let callee-image = fcatw-image([], [fcatw-row(1, 1, 0, 0)], [], 0);
        let caller = fcatw-binding("repl/pulse-caller", caller-image);
        let callee = fcatw-binding("repl/pulse-callee", callee-image);
        let capability = intern_trivial_string("repl/pulse-capability");
        let correlation = intern_trivial_string("repl/pulse-correlation");
        let call = fpcp-call-binding(caller, "invoke", callee, capability);
        let protocol = fpcp-registry(fcatw-registry([caller, callee]), [capability], [call]);
        let offer = fpcp-offer(call, correlation, [], 1);
        let call-ack = fpcp-execute(protocol, offer);
        let call-timeout = fpcp-execute(protocol, fpcp-offer(call, correlation, [], 0));
        let unadmitted = fpcp-call-binding(caller, "invoke", callee, intern_trivial_string("repl/unadmitted-capability"));
        let call-nothing = fpcp-execute(protocol, fpcp-offer(unadmitted, correlation, [], 1));
        let denied-protocol = fpcp-registry(fcatw-registry([caller, callee]), [], [call]);
        let call-refused = fpcp-execute(denied-protocol, offer);
        // The strict route decision now crosses the same resident command
        // as image data.  These are already-observed facts; scanner,
        // current-source effects, and answer construction remain outside
        // this image and are not claimed by the witness.
        let route-correlation = intern_trivial_string("repl/strict-route-correlation");
        let route-ready = fcsri-receipt(1, "concept", 1, route-correlation, 17);
        let route-absent = fcsri-receipt(1, "concept", 0, route-correlation, 17);
        let route-ready-ack = route-ready[2];
        let route-absent-ack = route-absent[2];
        let out0 = "resident-thought";
        let out1 = fcatww-line(out0, "symbol", fcatw-symbol());
        let out2 = fcatww-line(out1, "agreement", fcatw-value(agreed).str());
        let out3 = fcatww-line(out2, "disagreement", fcatw-value(disagreed).str());
        let out4 = fcatww-line(out3, "timeout", ((String) fcatw-status(timed) == "timeout" && (Comparable) fcatw-output-count(timed) == 0 ? 1 : 0).str());
        let out5 = fcatww-line(out4, "malformed-is-nothing", (nothing?(fcatw-run([], kinds, 93)) ? 1 : 0).str());
        let out6 = fcatww-line(out5, "steps", fcatw-steps(agreed).str());
        let out7 = fcatww-line(out6, "process", "0");
        let out8 = fcatww-line(out7, "http", "0");
        let out9 = fcatww-line(out8, "model", "0");
        let out10 = fcatww-line(out9, "metal", "0");
        let out11 = fcatww-line(out10, "call-binding", fpcp-call-valid?(call).str());
        let out12 = fcatww-line(out11, "offer-ack", ((String) fpcp-ack-status(call-ack) == "returned" && ((Comparable) fpcp-value-raw(fpcp-ack-value(call-ack)) == 1 && (node_eq(fpcp-ack-correlation(call-ack), correlation) && (Comparable) fpcp-ack-observed?(protocol, offer, call-ack) == 1)) ? 1 : 0).str());
        let out13 = fcatww-line(out12, "offer-timeout", ((String) fpcp-ack-status(call-timeout) == "timeout" && (Comparable) fpcp-ack-output(call-timeout) == 0 ? 1 : 0).str());
        let out14 = fcatww-line(out13, "offer-nothing", ((String) fpcp-ack-status(call-nothing) == "nothing" && (Comparable) fpcp-ack-output(call-nothing) == 0 ? 1 : 0).str());
        let out15 = fcatww-line(out14, "offer-refused", ((String) fpcp-ack-status(call-refused) == "refused" && (String) fpcp-ack-reason(call-refused) == "capability-refused" ? 1 : 0).str());
        let out16 = fcatww-line(out15, "strict-route-image-admission", ((String) fpcp-ack-status(route-ready-ack) == "returned" && ((Comparable) fpcp-value-raw(fpcp-ack-value(route-ready-ack)) == 1 && (Comparable) route-ready[3] == 1) ? 1 : 0).str());
        fcatww-line(out16, "strict-route-present-zero", ((String) fpcp-ack-status(route-absent-ack) == "returned" && ((Comparable) fpcp-value-raw(fpcp-ack-value(route-absent-ack)) == 0 && (Comparable) route-absent[3] == 1) ? 1 : 0).str());
    };
    0;
}
