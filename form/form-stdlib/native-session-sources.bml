// Retained examples stay in their explicitly selected, authorized hearth;
// Form reads their records and assessment references without importing copies.
import form-stdlib/native-session-memory.bml;
section [form.bml] {
 class NativeSessionSources {
  def nss-absolute(root,path) = (Comparable) str_byte_at(path,0) == 47 ? path : nsm-at(root,path);
  def nss-reference(path) = json-node-object([nsm-s("path",path),nsm-n("bytes",file_size(path)),nsm-s("bytes_sha256",nsm-hash(nsm-text(path)))]);
  def nss-current(reference) = ((Comparable) nsm-num(reference,"bytes") == file_size(nsm-str(reference,"path"))) && ((String) nsm-str(reference,"bytes_sha256") == nsm-hash(nsm-text(nsm-str(reference,"path"))));
  def nss-references-current(refs) = nil?(refs) ? 1 : (nss-current(refs[0]) && nss-references-current(refs[1:]));
  def nss-authority() {
   let image = kernel_ast(host_pid(),-1);
   nothing?(image) || (len(image) < 10) ? json-node-object([nsm-s("basis","process-instance;no-cross-process-reuse"),nsm-n("pid",host_pid())]) : image[6] <= 0 ? json-node-object([nsm-s("basis","source-instance;no-cross-process-reuse"),nsm-n("pid",host_pid())]) : json-node-object([nsm-s("basis","running-program-image"),nsm-n("identity",image[8]),nsm-s("path",image[9])]);
  }
  def nss-source(home,name,config,assessment) {
   let dir = nsm-at(nsm-at(home,"rows"),name);
   let exclusions = [assessment,nss-reference(nsm-at(dir,"valid.jsonl"))];
   let source = oh-set(nss-reference(nsm-at(dir,"record.json")),"withdrawal",nss-reference(nsm-withdrawal(dir)));
   oh-set(oh-set(oh-set(source,"home",json-node-string(home)),"home_config",config),"assessment_sources",json-node-array(exclusions));
  }
  def nss-sources(root,home,names) = nil?(names) ? [] : {
   let config = nss-reference(nsm-at(home,"config.json"));
   let assessment = nss-reference(nss-absolute(root,nsm-valid-path(home)));
   names |> map(name => nss-source(home,name,config,assessment));
  };
  def nss-home(root,home) {
   let present = fs-is-dir?(home); let rows = nsm-retention(home) ? nsm-dirs(home) : [];
   json-node-object([nsm-s("root",root),nsm-s("home",home),nsm-s("state",!present ? "absent" : nothing?(rows) ? "unreadable" : "read"),json-node-pair("sources",json-node-array(nothing?(rows) ? [] : nss-sources(root,home,rows)))]);
  }
  def nss-flatten(homes) = nil?(homes) ? [] : append(json-array-elements(oh-get(homes[0],"sources")),nss-flatten(homes[1:]));
  def nss-catalog(home) = !nsm-retention(home) ? [] : nss-catalog-authorized(home);
  def nss-catalog-authorized(home) {
   let root = host_cwd(); let absolute = nss-absolute(root,home);
   let own = nss-home(root,absolute);
   nss-publish(home,"explicit-home-only",json-node-null(),[own]);
  }
  def nss-unread(homes) = nil?(homes) ? 0 : (((String) nsm-str(homes[0],"state") == "unreadable" ? 1 : 0) + nss-unread(homes[1:]));
  def nss-publish(home,scope,discovery,homes) {
   let data = json-node-object([nsm-s("scope",scope),json-node-pair("discovery",discovery),json-node-pair("homes",json-node-array(homes)),json-node-pair("authority",nss-authority())]);
   let coverage = [nsm-s("scope",scope),json-node-pair("complete",oh-get(discovery,"complete")),json-node-pair("exit",oh-get(discovery,"exit")),json-node-pair("homes",json-node-array(homes)),json-node-pair("authority",nss-authority())];
   let revision = nsm-hash(json-emit-precise(json-node-object(coverage)));
   let prior = nsm-json(nsm-at(home,"evidence-catalog.json"));
   let catalog = oh-set(oh-set(data,"revision",json-node-string(revision)),"observed_at_ms",json-node-int(now_unix_ms()));
   let saved = (String) nsm-str(prior,"revision") == revision ? prior : nss-published(home,scope,discovery,homes,catalog);
   nss-flatten(homes);
  }
  def nss-published(home,scope,discovery,homes,catalog) {
   let path = nsm-at(home,"evidence-catalog.json"); let saved = nsm-atomic(path,catalog);
   let complete = ((String) scope == "explicit-home-only") || ((Comparable) nsm-num(discovery,"complete") == 1);
   let unread = nss-unread(homes); let healthy = complete && ((Comparable) unread == 0);
   let expected = json-node-object([nsm-n("discovery_complete",1),nsm-n("unread_homes",0)]);
   let observed = json-node-object([nsm-n("discovery_complete",complete),nsm-n("unread_homes",unread)]);
   let reading = oh-reading("session-learning",home,"source-discovery",expected,observed,json-node-int(healthy),healthy ? [] : [oh-need("readable-local-memory-sources",oh-reference(path))],["retry-discovery","defer"],oh-reference(path));
   let emitted = nsm-event(home,"organ-health",[json-node-pair("health",reading)]);
   let response = healthy ? 0 : nsm-event(home,"organ-response",[json-node-pair("health",oh-response(reading,"defer"))]);
   catalog;
  }
  def nss-source-current(source) = !nsm-retention(nsm-str(source,"home")) || !nsm-row-in-scope(nsm-str(source,"home"),fs-path-dirname(nsm-str(source,"path"))) || nsm-withdrawn(fs-path-dirname(nsm-str(source,"path"))) || (!json-object-has?(source,"home_config")) ? 0 : (nss-current(source) && (nss-current(oh-get(source,"home_config")) && nss-references-current(json-array-elements(oh-get(source,"assessment_sources")))));
 }
 0;
}
