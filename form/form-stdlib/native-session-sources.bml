// Retained examples stay in their owning hearth. Git supplies the local roots;
// Form reads their records and assessment references without importing copies.
// preludes: form-stdlib/native-session-memory.bml
section [form.bml] {
 class NativeSessionSources {
  def nss-absolute(root,path) = (Comparable) str_byte_at(path,0) == 47 ? path : nsm-at(root,path);
  def nss-reference(path) = json-node-object(list(nsm-s("path",path),nsm-n("bytes",file_size(path)),nsm-s("bytes_sha256",nsm-hash(nsm-text(path)))));
  def nss-current(reference) = ((Comparable) nsm-num(reference,"bytes") == file_size(nsm-str(reference,"path"))) && ((String) nsm-str(reference,"bytes_sha256") == nsm-hash(nsm-text(nsm-str(reference,"path"))));
  def nss-references-current(refs) = nil?(refs) ? 1 : (nss-current(head(refs)) && nss-references-current(tail(refs)));
  def nss-authority() {
   let image = kernel_ast(host_pid(),-1);
   nothing?(image) || (len(image) < 10) ? json-node-object(list(nsm-s("basis","process-instance;no-cross-process-reuse"),nsm-n("pid",host_pid()))) : image[6] <= 0 ? json-node-object(list(nsm-s("basis","source-instance;no-cross-process-reuse"),nsm-n("pid",host_pid()))) : json-node-object(list(nsm-s("basis","running-program-image"),nsm-n("identity",image[8]),nsm-s("path",image[9])));
  }
  def nss-source(root,home,name) {
   let dir = nsm-at(nsm-at(home,"rows"),name);
   let exclusions = list(nss-reference(nss-absolute(root,nsm-valid-path(home))),nss-reference(nsm-at(dir,"valid.jsonl")));
   let source = oh-set(nss-reference(nsm-at(dir,"record.json")),"withdrawal",nss-reference(nsm-withdrawal(dir)));
   oh-set(oh-set(oh-set(source,"home",json-node-string(home)),"home_config",nss-reference(nsm-at(home,"config.json"))),"assessment_sources",json-node-array(exclusions));
  }
  def nss-sources(root,home,names) = nil?(names) ? list() : cons(nss-source(root,home,head(names)),nss-sources(root,home,tail(names)));
  def nss-home(root,home) {
   let present = fs-is-dir?(home); let rows = nsm-dirs(home);
   json-node-object(list(nsm-s("root",root),nsm-s("home",home),nsm-s("state",!present ? "absent" : nothing?(rows) ? "unreadable" : "read"),json-node-pair("sources",json-node-array(nothing?(rows) ? list() : nss-sources(root,home,rows)))));
  }
  def nss-roots(fields,current,held) = nil?(fields) ? held : (Comparable) str_find(head(fields),"worktree ",0) == 0 ? nss-root(substring(head(fields),9,str_len(head(fields))),tail(fields),current,held) : nss-roots(tail(fields),current,held);
  def nss-root(root,rest,current,held) = nss-roots(rest,current,((String) root == current) || nsm-has(held,root) ? held : append(held,list(root)));
  def nss-homes(roots) = nil?(roots) ? list() : cons(nss-home(head(roots),nsm-at(head(roots),hearth-session-learning())),nss-homes(tail(roots)));
  def nss-flatten(homes) = nil?(homes) ? list() : append(json-array-elements(oh-get(head(homes),"sources")),nss-flatten(tail(homes)));
  def nss-catalog(home) {
   let root = host_cwd(); let absolute = nss-absolute(root,home);
   let own = nss-home(root,absolute);
   !((String) absolute == nsm-at(root,hearth-session-learning())) ? nss-publish(home,"explicit-home-only",json-node-null(),list(own)) : nss-discover(home,root,own);
  }
  def nss-discover(home,root,own) {
   let made = fs-mkdir(nsm-at(home,"evidence-discovery"));
   let prefix = nsm-at(nsm-at(home,"evidence-discovery"),nsm-id());
   let output = prefix ++ ".worktrees"; let errors = prefix ++ ".err";
   let pid = host_spawn_at(list("git","-C",root,"worktree","list","--porcelain","-z"),list("/dev/null",output,errors));
   let rc = pid > 0 ? host_wait(pid) : -1;
   let inventory = nsm-text(output);
   let complete = ((Comparable) rc == 0) && ((str_len(inventory) > 0) && ((Comparable) str_byte_at(inventory,str_len(inventory) - 1) == 0));
   let discovery = json-node-object(list(nsm-n("exit",rc),nsm-n("complete",complete),json-node-pair("registry",nss-retain(output,".worktrees")),json-node-pair("stderr",nss-retain(errors,".err"))));
   let homes = complete ? cons(own,nss-homes(nss-roots(split-on(inventory,byte_to_str(0)),root,list()))) : list(own);
   nss-publish(home,complete ? "repository-worktrees" : "local-only;worktree-discovery-incomplete",discovery,homes);
  }
  def nss-retain(path,suffix) {
   let kept = nsm-at(fs-path-dirname(path),nsm-hash(nsm-text(path)) ++ suffix);
   let saved = fs-exists?(kept) ? fs-remove-file(path) : fs-rename(path,kept);
   !((Comparable) saved == 0) ? form_error("session source discovery evidence could not be retained") : nss-reference(kept);
  }
  def nss-unread(homes) = nil?(homes) ? 0 : (((String) nsm-str(head(homes),"state") == "unreadable" ? 1 : 0) + nss-unread(tail(homes)));
  def nss-publish(home,scope,discovery,homes) {
   let data = json-node-object(list(nsm-s("scope",scope),json-node-pair("discovery",discovery),json-node-pair("homes",json-node-array(homes)),json-node-pair("authority",nss-authority())));
   let coverage = list(nsm-s("scope",scope),json-node-pair("complete",oh-get(discovery,"complete")),json-node-pair("exit",oh-get(discovery,"exit")),json-node-pair("homes",json-node-array(homes)),json-node-pair("authority",nss-authority()));
   let revision = nsm-hash(json-emit-precise(json-node-object(coverage)));
   let prior = nsm-json(nsm-at(home,"evidence-catalog.json"));
   let catalog = oh-set(oh-set(data,"revision",json-node-string(revision)),"observed_at_ms",json-node-int(now_unix_ms()));
   let saved = (String) nsm-str(prior,"revision") == revision ? prior : nss-published(home,scope,discovery,homes,catalog);
   nss-flatten(homes);
  }
  def nss-published(home,scope,discovery,homes,catalog) {
   let path = nsm-at(home,"evidence-catalog.json"); let saved = nsm-atomic(path,catalog);
   let complete = ((String) scope == "explicit-home-only") || ((Comparable) nsm-num(discovery,"complete") == 1);
   let unread = nss-unread(homes); let healthy = complete && ((Comparable) unread == 0);
   let expected = json-node-object(list(nsm-n("discovery_complete",1),nsm-n("unread_homes",0)));
   let observed = json-node-object(list(nsm-n("discovery_complete",complete),nsm-n("unread_homes",unread)));
   let reading = oh-reading("session-learning",home,"source-discovery",expected,observed,json-node-int(healthy),healthy ? list() : list(oh-need("readable-local-memory-sources",oh-reference(path))),list("retry-discovery","defer"),oh-reference(path));
   let emitted = nsm-event(home,"organ-health",list(json-node-pair("health",reading)));
   let response = healthy ? 0 : nsm-event(home,"organ-response",list(json-node-pair("health",oh-response(reading,"defer"))));
   catalog;
  }
  def nss-source-current(source) = nsm-withdrawn(fs-path-dirname(nsm-str(source,"path"))) || (!json-object-has?(source,"home_config")) ? 0 : (nss-current(source) && (nss-current(oh-get(source,"home_config")) && nss-references-current(json-array-elements(oh-get(source,"assessment_sources")))));
 }
 0;
}
