// The checkout bootstrap must run before core/BML admission. Only native ops
// available to the older seed enter this unit; the supervisor owns Glass.
// preludes: NONE
section [form.bml] {
    // An opaque process-local suffix without the formatting layer being healed.
    def fgb-suffix(n) = n < 16 ? byte_to_str(97 + n) : str_concat(fgb-suffix(n / 16), byte_to_str(97 + n % 16));
    def fgb-run(argv, streams) = {
        let pid = host_spawn_at(argv, streams);
        pid > 0 ? host_wait(pid) : pid;
    };
    def fgb-job() = {
        let path = str_concat(host_temp_dir(), str_concat("/glass-bootstrap-", str_concat(fgb-suffix(host_pid()), str_concat("-", fgb-suffix(host_monotonic_ms())))));
        (Comparable) fs_mkdir(path) == 1 ? path : form_error("Glass bootstrap evidence directory unavailable");
    };
    def fgb-fresh(binary, job, phase) = {
        let out = str_concat(job, str_concat("/", phase));
        let status = fgb-run(list(binary, "form/form-stdlib/tests/binary-freshness-band.fk"), list("/dev/null", out, ""));
        let observed = read_file(out);
        let ready = (Comparable) status == 0 && (String) observed == "31\n";
        print(list("glass-bootstrap", phase, "exit", status, "fresh", ready, "evidence", out));
        ready;
    };
    def fgb-rebuild(job) = {
        let staged = str_concat("./fkwu.glass-", fgb-suffix(host_pid()));
        let started = host_monotonic_ms();
        print(list("glass-bootstrap", "selected", "rebuild-checkout-seed", "source", "runtime/fkwu-uni.c"));
        let status = fgb-run(list("cc", "-O2", "-o", staged, "runtime/fkwu-uni.c"), list("/dev/null", "", ""));
        print(list("glass-bootstrap", "compile-exit", status, "elapsed-ms", host_monotonic_ms() - started));
        !((Comparable) status == 0) ? {
            fs_remove(staged);
            form_error("Glass bootstrap compilation failed; existing kernel retained");
        } : !((Comparable) fs_rename(staged, "./fkwu") == 0) ? form_error("Glass bootstrap kernel publication failed; compiled candidate retained") : fgb-fresh("./fkwu", job, "reobserved") ? 1 : form_error("Glass bootstrap rebuilt kernel did not pass freshness");
    };
    def fgb-ensure() = {
        let job = fgb-job();
        file_size("runtime/fkwu-uni.c") <= 0 ? form_error("Glass bootstrap requires the checkout runtime source") : fgb-fresh("./fkwu", job, "observed") ? 1 : fgb-rebuild(job);
    };
    def fgb-launch() = {
        let ready = fgb-ensure();
        let status = ready ? fgb-run(list("./fkwu", "observe/form-glass-supervisor-run.fk"), list("", "", "")) : -1;
        (Comparable) status == 0 ? 0 : {
            print(list("glass-bootstrap", "supervisor-exit", status));
            form_error("Glass supervisor ended with an error");
        };
    };
    0;
}
