; form-cli-lift-thought.bml — the next lift: thought + Form tokens.
;
; The s-expr this sitting lifts (from e2e-flow xtal):
;
;   (defn fee-exec (id kept prev orig)
;     (if (eq id 0) 0 (if (eq id 1) kept (if (eq id 2) prev
;       (if (eq id 3) 0 (if (eq id 4) kept (if (eq id 5) prev
;         (if (eq id 6) orig 0))))))))
;   (defn fee-xpath-phases (flow)
;     (if (eq (len flow) 0) (empty)
;       (cons (fee-q-phase (head flow)) (fee-xpath-phases (tail flow)))))
;
; Written below as thought + nothing/cut/choice/undo/restore.
; nothing is control. empty is the list. They are not the same.
; Recursion is one thought calling the next smaller thought.
;
; Authority is this section.
;
// preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-lift-thought-band.fk
; witnessed: 2026-08-19 -> 1023

section [form.lift] {
    thought flt-exec(id, kept, prev, orig) = if id == nothing then nothing else if id == cut then kept else if id == stop then prev else if id == timeout then nothing else if id == choice then kept else if id == undo then prev else if id == restore then orig else nothing;

    thought flt-phases(flow) = if len(flow) == 0 then empty else cons(nth(head(flow), 1), flt-phases(tail(flow)));

    thought flt-names(flow) = if len(flow) == 0 then empty else cons(nth(head(flow), 0), flt-names(tail(flow)));

    thought flt-sum(xs) = if len(xs) == 0 then nothing else head(xs) + flt-sum(tail(xs));

    thought flt-gas-count(flow) = if len(flow) == 0 then nothing else if nth(head(flow), 1) == compost then 1 + flt-gas-count(tail(flow)) else flt-gas-count(tail(flow));

    thought flt-tokens() = list(nothing, cut, stop, timeout, choice, undo, restore);

    thought flt-flow() = list(list("bml", liquid, choice, nothing), list("token", compost, choice, choice), list("exec", liquid, choice, 5), list("cell", ice, choice, 5));

    thought flt-pulse(flow) = flt-sum(flt-phases(flow));

    thought flt-check() = add(if nothing == 0 then 1 else 0, add(if choice == 4 then 2 else 0, add(if restore == 6 then 4 else 0, add(if flt-exec(choice, 5, 7, 9) == 5 then 8 else 0, add(if flt-exec(undo, 5, 7, 9) == 7 then 16 else 0, add(if flt-exec(nothing, 5, 7, 9) == 0 then 32 else 0, add(if flt-pulse(flt-flow()) == 4 then 64 else 0, add(if flt-gas-count(flt-flow()) == 1 then 128 else 0, add(if str_eq(head(flt-names(flt-flow())), "bml") then 256 else 0, if nth(head(tail(tail(tail(flt-flow())))), 1) == ice then 512 else 0)))))))));
    0;
}
