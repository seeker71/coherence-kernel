; form-cli-anyone-door-run.fk — print the anyone seats.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-anyone-door.fk

(do
    (print_str
        (str_concat "form-cli executed anyone-door\n"
        (str_concat "form-cli seats="
        (str_concat (int_to_str (fad-n))
        (str_concat " free-client="
        (str_concat (int_to_str (fad-n-free-client))
        (str_concat " free-body="
        (str_concat (int_to_str (fad-n-free-body))
        (str_concat " talk="
        (str_concat (fad-anyone-talk)
        (str_concat " body="
        (str_concat (fad-anyone-body)
        (str_concat " check="
        (str_concat (int_to_str (fad-check))
        (str_concat "\n" (str_concat (fad-spoken) "\n"))))))))))))))))
    0)
