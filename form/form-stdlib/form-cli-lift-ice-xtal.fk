; form-cli-lift-ice.fk — new ice/anyone seats in the lifted grammar.
;
; Authored in section [form.lift]: infix, unless, ice/liquid/compost
; literals. Crystallize with form-cli-lift-ice-compile.fk. No remote
; oracle. Edit this section, not a hand s-expr twin.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-lift-ice-band.fk
; witnessed: 2026-08-19 -> 255

(do (defn fli-ingest (depth fear) (if (ge depth 3) (if (eq fear 0) 2 1) 0)) (defn fli-client-free (name) (if (str_eq name "chatgpt") 1 0)) (defn fli-may-freeze (depth fear name) (if (eq (fli-ingest depth fear) 2) (fli-client-free name) 0)) (defn fli-anyone () (fli-may-freeze 5 0 "chatgpt")) (defn fli-not-cursor () (if (not (eq (fli-client-free "cursor") 1)) 1 0)) (defn fli-check () (add (if (eq (fli-anyone) 1) 1 0) (add (if (eq (fli-ingest 5 1) 1) 2 0) (add (if (eq (fli-ingest 1 0) 0) 4 0) (add (if (eq (fli-not-cursor) 1) 8 0) (add (if (eq (fli-client-free "codex") 0) 16 0) (add (if (eq (fli-client-free "claude") 0) 32 0) (add (if (eq (fli-client-free "grok") 0) 64 0) (if (eq (fli-client-free "gemini") 0) 128 0))))))))) 0)
