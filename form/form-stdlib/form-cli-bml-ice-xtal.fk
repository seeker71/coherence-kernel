; form-cli-bml-ice.fk — new ice/anyone seats authored in BML.
;
; Yes asked to crystallize full BML and use it for new features,
; instead of more s-expressions that leak vitality.
;
; This file is the authority. The crystallized Form is emitted by
; form-source-compile-file (source-compiler-text-lens). Do not grow
; the s-expr by hand. Edit this section; re-run the compile door.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-bml-ice-band.fk
; witnessed: 2026-08-19 -> 255

(do (defn fbi-ice () 2) (defn fbi-liquid () 1) (defn fbi-compost () 0) (defn fbi-ingest (depth fear) (if (ge depth 3) (if (eq fear 0) 2 1) 0)) (defn fbi-client-free (name) (if (str_eq name "chatgpt") 1 0)) (defn fbi-may-freeze (depth fear name) (if (eq (fbi-ingest depth fear) 2) (fbi-client-free name) 0)) (defn fbi-anyone-ice () (fbi-may-freeze 5 0 "chatgpt")) (defn fbi-check () (add (if (eq (fbi-anyone-ice) 1) 1 0) (add (if (eq (fbi-ingest 5 1) 1) 2 0) (add (if (eq (fbi-ingest 1 0) 0) 4 0) (add (if (eq (fbi-client-free "cursor") 0) 8 0) (add (if (eq (fbi-client-free "codex") 0) 16 0) (add (if (eq (fbi-client-free "claude") 0) 32 0) (add (if (eq (fbi-client-free "grok") 0) 64 0) (if (eq (fbi-client-free "gemini") 0) 128 0))))))))) 0)
