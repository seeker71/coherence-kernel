; nl-wisdom-row.fk — the pivot row a conversation carried home: WISDOM IS TENDED.
;
; preludes: form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-loader.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk form-stdlib/string-case.fk form-stdlib/nl-lexicon-data.fk form-stdlib/nl-translate.fk form-stdlib/nl-tongues.fk
;
; Origin (2026-08-04): a dialogue at the door began "thinking is the spell that
; believes wisdom comes from knowledge", moved through "possession is the wrong
; frequency", and settled on the meaning this cell pins: wisdom is not a stock
; that is kept; it is tended — re-witnessed, or honestly released. The north
; star names the work order this answers: "every meaning the corpus carries
; gets its pivot row, and surfaces regenerate from it."
;
; Two new rows in the neutral symbol space (n7 wisdom, n8 tended — the corpus
; lexicon lives in the c-space, so n7/n8 were free), phase GAS: provisional,
; just-invented, expected to phase-change within their identity as they settle.
; Surfaces for all fourteen tongue columns are agent-authored seed (provenance:
; rented-oracle), awaiting native-speaker and corpus review — the same honest
; seeding the shelf itself began with. The pivot symbol and the NodeID identity
; are what this cell actually pins; every surface is a door, none is favored.
;
; Named boundaries, carried not hidden: the shelf's grammars fix one article
; per tongue (el/der/le/o) and one copula pronoun (هو), so tongues whose word
; for wisdom takes another agreement (die weisheit, la sagesse gave way to
; le discernement) speak here in the shelf's current bounded form; agreement
; lives in a tongue's own later column (nl-pivot-es.fk shows the shape), never
; in the pivot. Where a tongue offered a choice, the seed leans toward the
; body's own register (fr discernement, pt discernimento).
;
; This cell touches no proven cell: it appends rows through the shelf's own
; generic walks (nlt-cat, nlm-enc, nlm-dec-*) and wires wr-* doors beside the
; nlm-* ones. Adding a meaning is adding rows — the engine never changes.
;
; witnessed: 2026-08-04 -> tests/nl-wisdom-row-band.fk 268435455 four-way (fkwu + go/rust/ts heavy; arms and seams named in the band header)

(do
    ;; --- the two new rows for the elder pair's 4-column table (symbol phase en id) ---
    (defn wr-rows-en-id () (list
        (list "n7" "gas" "wisdom" "kebijaksanaan")
        (list "n8" "gas" "tended" "dirawat")))
    (defn wr-lexicon () (nlt-cat (wr-rows-en-id) (nlt-lexicon)))
    (defn wr-map (i j w) (nlt-pick (nlt-find (wr-lexicon) i w) j w))
    (defn wr-en->c (w)  (wr-map 2 0 w))
    (defn wr-c->en (sy) (wr-map 0 2 sy))
    (defn wr-id->c (w)  (wr-map 3 0 w))
    (defn wr-c->id (sy) (wr-map 0 3 sy))

    ;; --- elder-pair doors (en id), the shelf's own shapes with the wider lexicon ---
    (defn wr-norm-en (n) (intern_node (bp "property") (list (nlt-s (wr-en->c (nlt-kidv n 0))) (nlt-s (wr-en->c (nlt-kidv n 1))))))
    (defn wr-norm-id (n) (intern_node (bp "property") (list (nlt-s (wr-id->c (nlt-kidv n 0))) (nlt-s (wr-id->c (nlt-kidv n 1))))))
    (defn wr-dec-en (p) (nlt-sp "the" (nlt-sp (wr-c->en (nlt-kidv p 0)) (nlt-sp "is" (wr-c->en (nlt-kidv p 1))))))
    (defn wr-dec-id (p) (nlt-sp (wr-c->id (nlt-kidv p 0)) (nlt-sp "adalah" (wr-c->id (nlt-kidv p 1)))))
    (defn wr-enc-en (x) (wr-norm-en (g-parse (nl-en) x)))
    (defn wr-enc-id (x) (wr-norm-id (g-parse (nl-id) x)))

    ;; --- the twelve shelf tongues: two appended rows each (symbol surface) ---
    (defn wr-lex-es () (nlt-cat (list (list "n7" "saber")         (list "n8" "cuidado"))      (nlm-lex-es)))
    (defn wr-lex-de () (nlt-cat (list (list "n7" "weisheit")      (list "n8" "gepflegt"))     (nlm-lex-de)))
    (defn wr-lex-fr () (nlt-cat (list (list "n7" "discernement")  (list "n8" "soigne"))       (nlm-lex-fr)))
    (defn wr-lex-pt () (nlt-cat (list (list "n7" "discernimento") (list "n8" "cuidado"))      (nlm-lex-pt)))
    (defn wr-lex-ru () (nlt-cat (list (list "n7" "мудрость")      (list "n8" "ухожена"))      (nlm-lex-ru)))
    (defn wr-lex-sw () (nlt-cat (list (list "n7" "hekima")        (list "n8" "inatunzwa"))    (nlm-lex-sw)))
    (defn wr-lex-zh () (nlt-cat (list (list "n7" "智慧")          (list "n8" "培育"))          (nlm-lex-zh)))
    (defn wr-lex-ja () (nlt-cat (list (list "n7" "ちえ")          (list "n8" "そだてられる"))   (nlm-lex-ja)))
    (defn wr-lex-ar () (nlt-cat (list (list "n7" "حكمة")          (list "n8" "مرعية"))         (nlm-lex-ar)))
    (defn wr-lex-hi () (nlt-cat (list (list "n7" "प्रज्ञा")          (list "n8" "पोषित"))         (nlm-lex-hi)))
    (defn wr-lex-tr () (nlt-cat (list (list "n7" "bilgelik")      (list "n8" "bakılan"))      (nlm-lex-tr)))
    (defn wr-lex-sa () (nlt-cat (list (list "n7" "प्रज्ञा")          (list "n8" "पोषिता"))        (nlm-lex-sa)))

    ;; --- wired doors: the shelf's grammars and decoder templates, wider rows ---
    (defn wr-enc-es (x) (nlm-enc (nl-es) (wr-lex-es) x))
    (defn wr-dec-es (p) (nlm-dec-art-cop "el" "es" (wr-lex-es) p))
    (defn wr-enc-de (x) (nlm-enc (nl-de) (wr-lex-de) x))
    (defn wr-dec-de (p) (nlm-dec-art-cop "der" "ist" (wr-lex-de) p))
    (defn wr-enc-fr (x) (nlm-enc (nl-fr) (wr-lex-fr) x))
    (defn wr-dec-fr (p) (nlm-dec-art-cop "le" "est" (wr-lex-fr) p))
    (defn wr-enc-pt (x) (nlm-enc (nl-pt) (wr-lex-pt) x))
    (defn wr-dec-pt (p) (nlm-dec-art-cop "o" "e" (wr-lex-pt) p))
    (defn wr-enc-ru (x) (nlm-enc (nl-ru) (wr-lex-ru) x))
    (defn wr-dec-ru (p) (nlm-dec-mid-cop "есть" (wr-lex-ru) p))
    (defn wr-enc-sw (x) (nlm-enc (nl-sw) (wr-lex-sw) x))
    (defn wr-dec-sw (p) (nlm-dec-mid-cop "ni" (wr-lex-sw) p))
    (defn wr-enc-zh (x) (nlm-enc (nl-zh) (wr-lex-zh) x))
    (defn wr-dec-zh (p) (nlm-dec-mid-cop "是" (wr-lex-zh) p))
    (defn wr-enc-ar (x) (nlm-enc (nl-ar) (wr-lex-ar) x))
    (defn wr-dec-ar (p) (nlm-dec-mid-cop "هو" (wr-lex-ar) p))
    (defn wr-enc-hi (x) (nlm-enc (nl-hi) (wr-lex-hi) x))
    (defn wr-dec-hi (p) (nlm-dec-end-cop "है" (wr-lex-hi) p))
    (defn wr-enc-tr (x) (nlm-enc (nl-tr) (wr-lex-tr) x))
    (defn wr-dec-tr (p) (nlm-dec-end-cop "dir" (wr-lex-tr) p))
    (defn wr-enc-ja (x) (nlm-enc (nl-ja) (wr-lex-ja) x))
    (defn wr-dec-ja (p) (nlm-dec-topic-cop "は" "です" (wr-lex-ja) p))
    (defn wr-enc-sa (x) (nlm-enc (nl-sa) (wr-lex-sa) x))
    (defn wr-dec-sa (p) (nlm-dec-end-cop "अस्ति" (wr-lex-sa) p))

    0)
