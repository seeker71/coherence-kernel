; fsh-ask-ds4.fk — the ASK door for the DS4 lane as a FORM SHELL cell: every decision,
; validation, parse, and verdict that lived in ask_ds4.sh's bash now lives here, and
; the bash that remains is a doorknob that stages keyed stdin lines and execs fkwu.
;
; WHY THE TRANSMUTATION. ask-ds4.fk already said it: a decision in a carrier is a
; decision the body cannot state, band, or be held to. The 2026-08-13 carrier read
; the body's contract but still owned the walk — grep, awk, env wiring, the sanity
; subprocess, the footer. Now the body owns the walk: the contract functions are
; CALLED (not spawned and re-parsed), the stream sanity reading is dss-trip-count
; in process (not a probe file), and the one genuine host act left — running the
; model lane — crosses host-exec (optag 136), the same VIA-HOST port
; four-way-run.fk stands on. Command authority is this cell's, held to by its band.
;
; THE REQUEST arrives as keyed stdin lines, one meaning each, closed by `end`:
;   steps 40            optional; ad-default-steps otherwise
;   prompt <text>       required unless contract_only
;   situation <text>    optional; declared consent for the decode-hook door
;   hook_door <path>    optional; ad-token-hook-door otherwise
;   contract_only 1     optional; print the ask contract and stop, loading nothing
;   gates 1             optional; forward the stack's own 106-gate sweep switch
;   end
;
; RUN FROM form/ through the entry cell (the lane and cell paths are form-relative):
;   printf 'steps 8\nprompt The capital of France is\nend\n' | ../fkwu form-stdlib/fsh-ask-ds4-main.fk
;
; THE STREAM IS STILL READ BEFORE IT IS QUOTED, with one new honest seam: a token
; the hook door swapped in at the head IS a reserved-block id, put there by a
; witnessed choice receipt. Hiding it from the RESERVED reading silently would blind
; the reading; letting it trip the verdict would call a deliberate act degeneracy.
; So when the stack's TOKEN HOOK line reports a head swap, the verdict reads the
; model's OWN tokens (the tail) and SAYS the head verdict token was excluded and why.
;
; PROMPT AND SITUATION cross to the lane through files read back by the command's
; own $(cat …), never interpolated into the command text — a quote in a prompt is
; data, not syntax. The 8192-byte host-exec command cap is stated where it is real.
;
; preludes: form-stdlib/core.fk native/metal/ask-ds4.fk form-stdlib/ds4-stream-sanity.fk
;
; Proven by: form-stdlib/tests/fsh-ask-ds4-band.fk

(do
    ; ---- keyed stdin request ------------------------------------------------
    (defn fads-key (line)
        (do (let sp (str_find line " " 0))
            (if (lt sp 0) line (substring line 0 sp))))
    (defn fads-val (line)
        (do (let sp (str_find line " " 0))
            (if (lt sp 0) "" (substring line (add sp 1) (str_len line)))))
    (defn fads-read-request (acc)
        (do (let line (read_line))
            (if (eq line -1) acc
                (if (str_eq (fads-key line) "end") acc
                    (fads-read-request (cons (list (fads-key line) (fads-val line)) acc))))))
    (defn fads-req (req key otherwise)
        (if (eq (len req) 0) otherwise
            (if (str_eq (nth (head req) 0) key) (nth (head req) 1)
                (fads-req (tail req) key otherwise))))

    ; ---- string helpers -----------------------------------------------------
    (defn fads-nl () (byte_to_str 10))
    (defn fads-find-last-go (s key from best)
        (do (let at (str_find s key from))
            (if (lt at 0) best (fads-find-last-go s key (add at 1) at))))
    (defn fads-find-last (s key) (fads-find-last-go s key 0 -1))
    (defn fads-line-at (s at)
        (do (let stop (str_find s (fads-nl) at))
            (substring s at (if (lt stop 0) (str_len s) stop))))
    (defn fads-next-line (s at)
        (do (let nl (str_find s (fads-nl) at))
            (if (lt nl 0) "" (fads-line-at s (add nl 1)))))
    (defn fads-between (s open close from)
        (do (let a (str_find s open from))
            (if (lt a 0) ""
                (do (let b (str_find s close (add a (str_len open))))
                    (if (lt b 0) "" (substring s (add a (str_len open)) b))))))
    (defn fads-trim (s)
        (if (eq (str_len s) 0) s
            (if (eq (str_byte_at s 0) 32) (fads-trim (substring s 1 (str_len s))) s)))
    (defn fads-split-ints (s from acc)
        (do (let at (str_find s "," from))
            (let seg (fads-trim (substring s from (if (lt at 0) (str_len s) at))))
            (let acc2 (if (gt (str_len seg) 0) (cons (str_to_int seg) acc) acc))
            (if (lt at 0) acc2 (fads-split-ints s (add at 1) acc2))))
    (defn fads-rev (xs acc)
        (if (eq (len xs) 0) acc (fads-rev (tail xs) (cons (head xs) acc))))
    (defn fads-ids (s) (fads-rev (fads-split-ints s 0 (empty)) (empty)))
    (defn fads-ids-text (xs acc)
        (if (eq (len xs) 0) acc
            (fads-ids-text (tail xs)
                (str_concat acc (str_concat (if (eq (str_len acc) 0) "" ", ")
                                            (int_to_str (head xs)))))))

    ; ---- the lane output, parsed by name ------------------------------------
    (defn fads-out-ids-text (out)
        (do (let at (fads-find-last out "AUTOREGRESSIVE TOKEN FEEDBACK ("))
            (if (lt at 0) "" (fads-between out "[" "]" at))))
    (defn fads-out-answer (out)
        (do (let at (fads-find-last out "NATIVE DECODED CONTINUATION"))
            (if (lt at 0) "" (fads-next-line out at))))
    (defn fads-out-speed (out)
        (do (let at (fads-find-last out "generation "))
            (if (lt at 0) "speed unmeasured"
                (do (let line (fads-line-at out at))
                    (let stop (str_find line " t/s" 0))
                    (if (lt stop 0) "speed unmeasured"
                        (substring line 0 (add stop 4)))))))
    (defn fads-out-blob (out)
        (do (let at (str_find out "ds4 blob: " 0))
            (if (lt at 0) "unnamed"
                (do (let line (fads-line-at out at))
                    (let rest (substring line 10 (str_len line)))
                    (let sp (str_find rest " " 0))
                    (if (lt sp 0) rest (substring rest 0 sp))))))
    (defn fads-out-hook-line (out)
        (do (let at (fads-find-last out "TOKEN HOOK:"))
            (if (lt at 0) "" (fads-trim (fads-line-at out at)))))
    (defn fads-hook-field-int (line key)
        (do (let at (str_find line key 0))
            (if (lt at 0) 0
                (do (let from (add at (str_len key)))
                    (let sp (str_find line " " from))
                    (str_to_int (substring line from (if (lt sp 0) (str_len line) sp)))))))
    (defn fads-fails (out n from)
        (if (eq n 0) 0
            (do (let a (str_find out (str_concat (fads-nl) "FAIL") from))
                (let b (str_find out (str_concat (fads-nl) "SKIP") from))
                (let at (if (lt a 0) b (if (lt b 0) a (if (lt a b) a b))))
                (if (lt at 0) 0
                    (do (print_str (fads-line-at out (add at 1)))
                        (fads-fails out (sub n 1) (add at 1)))))))

    ; ---- the sanity verdict, hook-aware -------------------------------------
    (defn fads-verdict (ids swapped)
        (do (let read-ids (if (gt swapped 0) (tail ids) ids))
            (let trips (dss-trip-count read-ids))
            (let head-note (if (gt swapped 0)
                (str_concat " over the model's own "
                (str_concat (int_to_str (len read-ids))
                    " tokens (1 deliberate control verdict at the head, chosen by receipt, excluded from the reserved reading)"))
                ""))
            (if (eq trips 0)
                (str_concat "stream sane (0 of 3 readings tripped)" head-note)
                (str_concat "STREAM DEGENERATE - " (str_concat (int_to_str trips)
                    (str_concat " of 3 readings tripped" head-note))))))

    ; ---- the one host crossing ----------------------------------------------
    (defn fads-env (k v) (str_concat k (str_concat "=" (str_concat v " "))))
    (defn fads-env-int (k n) (fads-env k (int_to_str n)))
    (defn fads-env-file (k path)
        (str_concat k (str_concat "=\"$(cat " (str_concat path ")\" "))))
    (defn fads-command (steps gates prompt-file situation-file hook-door out-file)
        (str_concat (fads-env-int "FORM_DS4_KV_STEPS" steps)
        (str_concat (fads-env-int "FORM_DS4_KV_CAP" (ad-cap-for steps))
        (str_concat (fads-env-int "FORM_DS4_KV_SEQUENCE" (ad-needs-sequence?))
        (str_concat (fads-env-int "FORM_DS4_MATCH_ORDER" (ad-needs-match-order?))
        (str_concat (fads-env "FORM_DS4_GATES" gates)
        (str_concat (fads-env-file "FORM_DS4_PROMPT" prompt-file)
        (str_concat (fads-env-file "FORM_DS4_SITUATION" situation-file)
        (str_concat (fads-env "FORM_DS4_TOKENIZER" (ad-tokenizer))
        (str_concat (fads-env "FORM_DS4_TOKEN_SWAP_CELL" (ad-token-swap-cell))
        (str_concat (fads-env "FORM_DS4_TOKEN_HOOK_DOOR" hook-door)
        (str_concat (fads-env-int "FORM_DS4_TOKEN_BUDGET_MS" (ad-token-timeout-ms))
        (str_concat (fads-env-int "FORM_DS4_METAL_BANDWIDTH_BYTES_PER_MS" (ad-token-bandwidth-bytes-per-ms))
        (str_concat (fads-env-int "FORM_DS4_DEFAULT_TOKEN_BYTES" (ad-default-token-bytes))
        (str_concat (ad-lane)
        (str_concat " > " (str_concat out-file
                    " 2>&1; printf 'lane_rc=%d' $?")))))))))))))))))

    ; ---- the walk ------------------------------------------------------------
    (defn fads-run (req)
        (do (let steps (str_to_int (fads-req req "steps" (int_to_str (ad-default-steps)))))
            (let prompt (fads-req req "prompt" ""))
            (let situation (fads-req req "situation" ""))
            (let hook-door (fads-req req "hook_door" (ad-token-hook-door)))
            (let gates (fads-req req "gates" "0"))
            (if (lt steps 2)
                (do (print_str "fsh-ask-ds4: steps must be an integer at least 2") 2)
            (if (eq (str_len prompt) 0)
                (do (print_str "fsh-ask-ds4: a prompt is required (line: prompt <text>)") 2)
            (if (not (fs_exists (ad-lane)))
                (do (print_str (str_concat "fsh-ask-ds4: the lane is missing: " (ad-lane))) 1)
            (if (not (fs_exists hook-door))
                (do (print_str (str_concat "fsh-ask-ds4: the hook door cell is missing: " hook-door)) 1)
            (do (let prompt-file (str_concat (temp_dir) "/fsh-ask-ds4-prompt.txt"))
                (let situation-file (str_concat (temp_dir) "/fsh-ask-ds4-situation.txt"))
                (let out-file (str_concat (temp_dir) "/fsh-ask-ds4-lane-out.txt"))
                (let _wp (write_file_text prompt-file prompt))
                (let _ws (write_file_text situation-file situation))
                (let t0 (now_unix_ms))
                (let rc-text (host-exec
                    (fads-command steps gates prompt-file situation-file hook-door out-file) ""))
                (let wall-s (div (sub (now_unix_ms) t0) 1000))
                (let rc (fads-hook-field-int rc-text "lane_rc="))
                (let out (read_file out-file))
                (if (not (eq rc 0))
                    (do (fads-fails out 3 0)
                        (print_str (str_concat "fsh-ask-ds4: the lane did not complete (rc="
                            (str_concat (int_to_str rc) ")")))
                        rc)
                    (do (let ids (fads-ids (fads-out-ids-text out)))
                        (let hook-line (fads-out-hook-line out))
                        ; the reserved-reading exclusion is for a HEAD verdict only:
                        ; the lane marks that case with head_reason= on its hook line.
                        (let swapped (if (ge (str_find hook-line " head_reason=" 0) 0) 1 0))
                        (print_str "")
                        (print_str (str_concat prompt (fads-out-answer out)))
                        (print_str "")
                        (print_str (str_concat "  [form-native · 43 layers · "
                            (str_concat (fads-out-speed out)
                            (str_concat " · " (str_concat (int_to_str wall-s)
                                       "s wall · greedy, base-model continuation]")))))
                        (print_str (str_concat "  [weights: " (str_concat (fads-out-blob out) "]")))
                        (print_str (str_concat "  [token hook: "
                            (str_concat hook-door
                            (str_concat " · " (str_concat (int_to_str (ad-token-timeout-ms))
                            (str_concat "ms window · "
                            (str_concat (if (eq (str_len hook-line) 0)
                                            "the lane reported no hook line"
                                            hook-line) "]")))))))
                        (if (gt (len ids) 0)
                            (print_str (str_concat "  [" (str_concat (fads-verdict ids swapped) "]")))
                            0)
                        (print_str (str_concat "  [token ids: "
                            (str_concat (fads-ids-text ids "") "]")))
                        0)))))))))

    ; The ENTRY lives in fsh-ask-ds4-main.fk, not here: read_line is registered in
    ; the emitted walker only, and a top-level call here would run at every prelude
    ; load — the sibling kernels said so out loud the first time this cell carried
    ; its own call, and the split is their correction. This cell stays pure and
    ; four-way witnessable; the main is the fourth arm's own.
    (defn fads-main ()
        (do (let req (fads-read-request (empty)))
            (if (str_eq (fads-req req "contract_only" "0") "1")
                (ad-emit (str_to_int (fads-req req "steps" (int_to_str (ad-default-steps)))))
                (fads-run req))))
    0)
