// reason-coverage.fk -- explicit reason-manifest coverage for bands.
//
// This layer compares an explicit expected reason list with observed reason
// values produced by a band. It is not reflection, test generation, execution,
// file IO, or dynamic evaluation.
//
// preludes: form-stdlib/core.fk
section [form.bml] {
    def rcov-feature(name, status) = list("reason-coverage-feature", name, status);
    def rcov-feature-name(f) = nth(f, 1);
    def rcov-feature-status(f) = nth(f, 2);
    def reason-coverage-manifest() = list(rcov-feature("pure-list-coverage", 1), rcov-feature("explicit-reason-manifest-not-reflection", 1), rcov-feature("missing-reason-detection", 1), rcov-feature("unexpected-reason-detection", 1), rcov-feature("duplicate-observed-diagnostic", 1), rcov-feature("duplicate-expected-failure", 1), rcov-feature("deterministic-status-precedence", 1), rcov-feature("covered-predicate-no-missing-unexpected", 1), rcov-feature("duplicate-observed-does-not-fail-covered", 1), rcov-feature("self-status-coverage", 1), rcov-feature("applies-to-layer-branches", 1), rcov-feature("observed-from-real-invocations", 1), rcov-feature("no-file-io", 1), rcov-feature("no-dynamic-eval", 1), rcov-feature("no-runtime-execution", 1), rcov-feature("no-c-seed-growth", 1));
    def reason-coverage-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) rcov-feature-name(head(fs)) == name && (Comparable) rcov-feature-status(head(fs)) == 1 ? 1 : reason-coverage-manifest-has?(name, tail(fs));
    def rcov-status-covered() = "covered";
    def rcov-status-missing() = "missing";
    def rcov-status-unexpected() = "unexpected";
    def rcov-status-duplicate-expected() = "duplicate-expected";
    def rcov-status-duplicate-observed() = "duplicate-observed";
    def rcov-member?(x, xs) = nil?(xs) ? 0 : (String) x == head(xs) ? 1 : rcov-member?(x, tail(xs));
    def rcov-count(x, xs) = nil?(xs) ? 0 : ((String) x == head(xs) ? 1 : 0) + rcov-count(x, tail(xs));
    def rcov-missing(expected, observed) = nil?(expected) ? empty() : rcov-member?(head(expected), observed) ? rcov-missing(tail(expected), observed) : cons(head(expected), rcov-missing(tail(expected), observed));
    def rcov-unexpected(expected, observed) = nil?(observed) ? empty() : rcov-member?(head(observed), expected) ? rcov-unexpected(expected, tail(observed)) : cons(head(observed), rcov-unexpected(expected, tail(observed)));
    def rcov-duplicates-loop(xs, seen, dupes) = nil?(xs) ? dupes : rcov-member?(head(xs), seen) ? rcov-member?(head(xs), dupes) ? rcov-duplicates-loop(tail(xs), seen, dupes) : rcov-duplicates-loop(tail(xs), seen, cons(head(xs), dupes)) : rcov-duplicates-loop(tail(xs), cons(head(xs), seen), dupes);
    def rcov-duplicates(xs) = rcov-duplicates-loop(xs, empty(), empty());
    def rcov-empty?(xs) = nil?(xs);
    def rcov-status-from(missing, unexpected, duplicate-expected, duplicate-observed) = !rcov-empty?(missing) ? rcov-status-missing() : !rcov-empty?(unexpected) ? rcov-status-unexpected() : !rcov-empty?(duplicate-expected) ? rcov-status-duplicate-expected() : !rcov-empty?(duplicate-observed) ? rcov-status-duplicate-observed() : rcov-status-covered();
    // coverage = ("reason-coverage" expected observed missing unexpected
    //             duplicate-expected duplicate-observed status)
    def rcov-coverage(expected, observed) = {
        let missing = rcov-missing(expected, observed);
        let unexpected = rcov-unexpected(expected, observed);
        let duplicate-expected = rcov-duplicates(expected);
        let duplicate-observed = rcov-duplicates(observed);
        list("reason-coverage", expected, observed, missing, unexpected, duplicate-expected, duplicate-observed, rcov-status-from(missing, unexpected, duplicate-expected, duplicate-observed));
    };
    def rcov-coverage?(c) = (Comparable) len(c) == 8 ? (String) nth(c, 0) == "reason-coverage" : 0;
    def rcov-expected(c) = nth(c, 1);
    def rcov-observed(c) = nth(c, 2);
    def rcov-missing-list(c) = nth(c, 3);
    def rcov-unexpected-list(c) = nth(c, 4);
    def rcov-duplicate-expected-list(c) = nth(c, 5);
    def rcov-duplicate-observed-list(c) = nth(c, 6);
    def rcov-status(c) = nth(c, 7);
    // Consumers should gate on this predicate, not status equality: duplicate
    // observed reasons are diagnostic-only and may leave the row still covered.
    def rcov-covered?(c) = rcov-coverage?(c) ? rcov-empty?(rcov-missing-list(c)) ? rcov-empty?(rcov-unexpected-list(c)) ? rcov-empty?(rcov-duplicate-expected-list(c)) : 0 : 0 : 0;
}
