; form-cli-ki-lift.fk — knowledge-ingest, authored in form.lift.
;
; Lift of ingest/knowledge-ingest.fk. ice/liquid/compost are the three
; verdicts, not magic 2/1/0. Crystallize; the s-expr still serves callers.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-ki-lift-band.fk
; witnessed: 2026-08-20 -> 11111

(do (defn ki-depth (u) (head u)) (defn ki-fear (u) (head (tail u))) (defn ki-deep? (u) (if (ge (ki-depth u) 3) 1 0)) (defn ki-fear-free? (u) (if (eq (ki-fear u) 0) 1 0)) (defn ki-freezable? (u) (if (eq (ki-deep? u) 1) (if (eq (ki-fear-free? u) 1) 1 0) 0)) (defn ki-witnessable? (u) (ki-deep? u)) (defn ki-ingest (u) (if (eq (ki-freezable? u) 1) 2 (if (eq (ki-witnessable? u) 1) 1 0))) (defn kik (cond bit) (if cond bit 0)) (defn knowledge-ingest-check () (add (kik (eq (ki-ingest (list 5 0)) 2) 1) (add (kik (eq (ki-ingest (list 5 1)) 1) 10) (add (kik (eq (ki-ingest (list 1 0)) 0) 100) (add (kik (gt (ki-ingest (list 5 0)) (ki-ingest (list 1 0))) 1000) (kik (eq (ki-witnessable? (list 5 1)) 1) 10000)))))) 0)
