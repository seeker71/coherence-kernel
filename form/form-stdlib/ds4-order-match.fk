; ds4-order-match.fk — kernels that reproduce ds4's ARITHMETIC ORDER, not merely its recipe.
;
; WHY A CELL FOR THIS. Our lane now agrees with ds4 to r=0.999995 at three tokens and matches its
; argmax at every prompt length — inside ds4's own backend-to-backend spread. And it still cannot
; reproduce ds4's greedy TOKEN STREAM past two steps, because greedy decoding is discontinuous: at the
; third step ds4 chooses between " The" and " It" on a margin of 0.0197 logits out of 24, and whoever
; is on the wrong side of that tie never converges again (receipts/2026-07-30-tie-budget.md).
;
; Matching a stream therefore needs our f32 ERRORS to be ds4's f32 errors, which means matching its
; association exactly. Read from ds4.c, by line, never guessed:
;
;   :10246 dot_f32       — TWO NEON accumulators, 8 elements per step, vfmaq_f32 (FUSED multiply-add),
;                          reduced by vaddvq_f32(vaddq_f32(acc0, acc1))
;   :6664  dot_f16_row   — the same two-accumulator FMA shape over widened halves
;   :6814  dot_q8_0_row  — NOT an f32 fold at all: the ACTIVATION is quantised to int8 (:7051), each
;                          32-block is an EXACT int32 dot (vdotq_s32, four lanes of four products),
;                          and only the per-block scale product re-enters f32, through an FMA
;   :3480  ds4_vec_dot_q2_K_f32 — a plain ASCENDING scalar f32 sum, no NEON, no FMA
;
; So there is no single "ds4 order": each type has its own, and one of them is not floating-point
; arithmetic at all. That is the finding this cell exists to carry.
;
; THE TWO THINGS OUR LANE DOES DIFFERENTLY, both deliberate and both now optional:
;   1. `-ffp-contract=off` on every metallib — no FMA anywhere. ds4 fuses on every product it can.
;      A fused multiply-add rounds ONCE where ours rounds twice; over 4096 terms that is not noise
;      the far tail can absorb.
;   2. a 32-lane strided fold reduced by simd_sum. ds4 has 8 chains, not 32, and reduces pairwise.
;
; APORON — WHAT THIS CELL CANNOT GIVE. Matching the association makes the same roundings in the same
; places; it does NOT make our transcendentals ds4's. mla_exp is a range-reduced Taylor series and
; ds4 calls libm expf; they differ in the last ulp or two, which the softmax then spreads. So this
; cell narrows the tie budget, and a claim of stream equality has to be MEASURED, never inferred from
; "the order matches now".
;
; vdotq_s32 semantics, since the whole int path rests on it: lane l of the result gets
; acc[l] + sum over k in 0..3 of a[4l+k]*b[4l+k], in exact int32. A 32-element int8 dot cannot exceed
; 32*127*128 = 520 192 < 2^24, so the int32 -> f32 conversion that follows is exact.
;
; vaddvq_f32 over four lanes is the ARM pairwise tree (faddp, faddp): (v0+v1) + (v2+v3). Not a left
; fold — a left fold here would be a different answer and is the obvious wrong transcription.
;
; preludes: form-stdlib/core.fk
;
; Proven by: form-stdlib/tests/ds4-order-match-band.fk (the emitted text and the reduction shape)
;            and native/metal/metal_dsv4_stack.sh under FORM_DS4_MATCH_ORDER=1, against
;            `ds4 --head-test`'s own per-stage numbers.

(do
    ; --- the shape constants, so a band can pin them rather than read them out of a string ---
    (defn dom-neon-lanes () 4)        ; float32x4_t
    (defn dom-neon-accs () 2)         ; acc0 and acc1
    (defn dom-step () 8)              ; 8 elements per loop iteration (2 accs * 4 lanes)
    (defn dom-q8-block () 32)         ; Q8_0 block elements
    (defn dom-q8-block-bytes () 34)   ; 2 scale + 32 payload
    (defn dom-dot-lane-span () 4)     ; vdotq_s32: 4 products per lane

    ; =========================================================================
    ; THE ACTIVATION QUANTISER (ds4.c:7051 quantize_q8_0_activation), per 32-block.
    ; d = amax/127, id = 1/d or 0, then lrintf -> clamp. lrintf rounds half to EVEN under the default
    ; mode, which is metal::rint — NOT metal::round, which rounds half away from zero and would
    ; disagree on every exact .5 the activation happens to land on.
    ; =========================================================================
    (defn dom-q8a-quantize-body ()
        "kernel void form_dsv4_q8a_quantize_f32 (device const float* x [[buffer(0)]], device char* xq [[buffer(1)]], device float* xs [[buffer(2)]], constant uint& n [[buffer(3)]], uint b [[thread_position_in_grid]]) { uint blocks = (n + 31u) / 32u; if (b >= blocks) return; uint i0 = b * 32u; uint bn = (n - i0 < 32u) ? (n - i0) : 32u; float amax = 0.0f; for (uint i = 0u; i < bn; ++i) { float ax = metal::abs(x[i0 + i]); if (ax > amax) amax = ax; } float d = amax / 127.0f; float id = (d != 0.0f) ? (1.0f / d) : 0.0f; xs[b] = d; for (uint i = 0u; i < bn; ++i) { int v = int(metal::rint(x[i0 + i] * id)); if (v > 127) v = 127; if (v < -128) v = -128; xq[i0 + i] = char(v); } for (uint i = bn; i < 32u; ++i) xq[i0 + i] = char(0); } ")

    ; =========================================================================
    ; THE Q8_0 ROW DOT (ds4.c:6814), transcribed with its accumulator structure intact.
    ; ONE THREAD PER ROW — deliberately. A 32-lane split would be a different association, which is
    ; the whole thing this kernel exists not to do. Blocks are walked in PAIRS, block b landing in
    ; accv0 and block b+1 in accv1, with an odd tail block folded into accv0, exactly as ds4 does.
    ; =========================================================================
    (defn dom-q80-ordered-body ()
        "kernel void form_dsv4_q80_matvec_ordered (device const uchar* qb [[buffer(0)]], device const char* xq [[buffer(1)]], device const float* xs [[buffer(2)]], device float* y [[buffer(3)]], constant uint& rows [[buffer(4)]], constant uint& cols [[buffer(5)]], uint r [[thread_position_in_grid]]) { if (r >= rows) return; uint blocks = cols / 32u; ulong rowbase = (ulong)r * (ulong)blocks * 34ul; float a0[4]; float a1[4]; for (uint l = 0u; l < 4u; ++l) { a0[l] = 0.0f; a1[l] = 0.0f; } uint b = 0u; for (; b + 1u < blocks; b += 2u) { ulong o0 = rowbase + (ulong)b * 34ul; ulong o1 = rowbase + (ulong)(b + 1u) * 34ul; ushort h0 = (ushort)qb[o0] | ((ushort)qb[o0 + 1ul] << 8); ushort h1 = (ushort)qb[o1] | ((ushort)qb[o1 + 1ul] << 8); float s0 = float(as_type<half>(h0)) * xs[b]; float s1 = float(as_type<half>(h1)) * xs[b + 1u]; for (uint l = 0u; l < 4u; ++l) { int d0 = 0; int d1 = 0; for (uint k = 0u; k < 4u; ++k) { d0 += int((char)qb[o0 + 2ul + (ulong)(4u * l + k)]) * int(xq[b * 32u + 4u * l + k]); d0 += int((char)qb[o0 + 2ul + (ulong)(16u + 4u * l + k)]) * int(xq[b * 32u + 16u + 4u * l + k]); d1 += int((char)qb[o1 + 2ul + (ulong)(4u * l + k)]) * int(xq[(b + 1u) * 32u + 4u * l + k]); d1 += int((char)qb[o1 + 2ul + (ulong)(16u + 4u * l + k)]) * int(xq[(b + 1u) * 32u + 16u + 4u * l + k]); } a0[l] = metal::fma(float(d0), s0, a0[l]); a1[l] = metal::fma(float(d1), s1, a1[l]); } } if (b < blocks) { ulong o0 = rowbase + (ulong)b * 34ul; ushort h0 = (ushort)qb[o0] | ((ushort)qb[o0 + 1ul] << 8); float s0 = float(as_type<half>(h0)) * xs[b]; for (uint l = 0u; l < 4u; ++l) { int d0 = 0; for (uint k = 0u; k < 4u; ++k) { d0 += int((char)qb[o0 + 2ul + (ulong)(4u * l + k)]) * int(xq[b * 32u + 4u * l + k]); d0 += int((char)qb[o0 + 2ul + (ulong)(16u + 4u * l + k)]) * int(xq[b * 32u + 16u + 4u * l + k]); } a0[l] = metal::fma(float(d0), s0, a0[l]); } } float t0 = a0[0] + a1[0]; float t1 = a0[1] + a1[1]; float t2 = a0[2] + a1[2]; float t3 = a0[3] + a1[3]; y[r] = (t0 + t1) + (t2 + t3); } ")

    ; =========================================================================
    ; THE F16 ROW DOT (ds4.c:6664). Same two-accumulator FMA shape; the halves widen exactly.
    ; =========================================================================
    ; THE NEON LANES ARE THE PARALLELISM, and they were being emulated serially. ds4's two
    ; float32x4_t accumulators are EIGHT INDEPENDENT CHAINS: chain c takes every element j with
    ; j mod 8 == c, and they never interact until the final reduce. One thread per row put all eight on
    ; one lane — which mattered nowhere until profiling showed hc_attn_fn is [16384, 24] and
    ; output_hc_fn is [16384, 4], so this kernel was running on TWENTY-FOUR threads, and four.
    ; Eight threads per row, each owning one chain, then vaddvq's exact tree: t[l] = c[l] + c[4+l],
    ; result = (t0+t1) + (t2+t3). BIT-IDENTICAL to the one-thread form — the chains were already
    ; separate, they were just queued behind each other.
    ; AND THE LOADS ARE HOISTED, which is where the time actually was. Measured (a reviewer's
    ; standalone microbenchmark on this exact MSL, 2026-07-31): at [16384, 24] this kernel takes ~380 us
    ; whether it runs on 32 threads or 3072 — SIXTEEN TIMES the arithmetic for the same wall clock. It
    ; was never occupancy-bound. Each iteration loaded a weight and an activation and consumed them on
    ; the next instruction, so roughly one load was ever in flight and 2048 iterations cost ~200 ns
    ; each: pure exposed memory latency.
    ; Issuing eight loads before the eight fused multiply-adds fixes it — 380 us -> 81 us — and touches
    ; NOTHING about the order: chain c still sums j = c, c+8, c+16, ... strictly ascending into one
    ; accumulator, and the shuffle reduce below is unchanged. The association forbids reordering the
    ; ADDS and says nothing about when the loads happen. That distinction was worth 4.5x.
    ; (Rows-per-thread blocking, ds4's N_R0 idea, was measured on the same bench and LOSES here:
    ; NR=1 86 us, NR=2 102, NR=4 226 — register pressure beats load amortisation at this shape. It is
    ; why giving the IQ2 kernel four-row blocking bought 1%.)
    ; EIGHT CHAINS, EIGHT THREADS — the Q8_0 twin of the F16 fix, and the same insight: ds4's a0[4]
    ; and a1[4] are INDEPENDENT until the final tree, so serialising them in one thread was a choice, not
    ; the association. Chain (p,l) walks blocks b = p, p+2, ... in ascending order and owns int-dot lane
    ; l; the combine is vaddvq's exact tree over the eight shuffled results. Even blocks land in a0 and
    ; odd in a1 exactly as ds4 pairs them, trailing block included. Bit-identical.
    (defn dom-q80-ordered8-body ()
        "kernel void form_dsv4_q80_matvec_ordered8 (device const uchar* qb [[buffer(0)]], device const char* xq [[buffer(1)]], device const float* xs [[buffer(2)]], device float* y [[buffer(3)]], constant uint& rows [[buffer(4)]], constant uint& cols [[buffer(5)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) { uint r = gid / 8u; if (r >= rows) return; uint c = gid - r * 8u; uint p = c / 4u; uint l = c - p * 4u; uint blocks = cols / 32u; ulong rowbase = (ulong)r * (ulong)blocks * 34ul; float acc = 0.0f; for (uint b = p; b < blocks; b += 2u) { ulong o = rowbase + (ulong)b * 34ul; ushort h = (ushort)qb[o] | ((ushort)qb[o + 1ul] << 8); float s = float(as_type<half>(h)) * xs[b]; char4 wa = char4(*(device const packed_char4*)(qb + o + 2ul + (ulong)(4u * l))); char4 xa = char4(*(device const packed_char4*)(xq + b * 32u + 4u * l)); char4 wb = char4(*(device const packed_char4*)(qb + o + 2ul + (ulong)(16u + 4u * l))); char4 xb = char4(*(device const packed_char4*)(xq + b * 32u + 16u + 4u * l)); int d = (int(wa.x) * int(xa.x) + int(wa.y) * int(xa.y) + int(wa.z) * int(xa.z) + int(wa.w) * int(xa.w)) + (int(wb.x) * int(xb.x) + int(wb.y) * int(xb.y) + int(wb.z) * int(xb.z) + int(wb.w) * int(xb.w)); acc = metal::fma(float(d), s, acc); } uint ob = (lane / 8u) * 8u; float v0 = metal::simd_shuffle(acc, ob); float v1 = metal::simd_shuffle(acc, ob + 1u); float v2 = metal::simd_shuffle(acc, ob + 2u); float v3 = metal::simd_shuffle(acc, ob + 3u); float v4 = metal::simd_shuffle(acc, ob + 4u); float v5 = metal::simd_shuffle(acc, ob + 5u); float v6 = metal::simd_shuffle(acc, ob + 6u); float v7 = metal::simd_shuffle(acc, ob + 7u); if (c != 0u) return; float t0 = v0 + v4; float t1 = v1 + v5; float t2 = v2 + v6; float t3 = v3 + v7; y[r] = (t0 + t1) + (t2 + t3); } "
)

    ; --- THE Q8_0 MATVEC THE ORACLE'S OWN GPU RUNS (metal/dense.metal kernel_mul_mv_q8_0_f32_impl,
    ;     dispatched at ds4_metal.m:4346 with nsg = min(8, ceil(in_dim/128)) and nr0 = 2).
    ;
    ;     Everything above this line reproduces ds4's CPU association — the NEON path at ds4.c:6814,
    ;     which quantises the activation to int8 first (:7051) so each block is an exact int32 dot. That
    ;     is a faithful reading of one arm. It is not the arm ds4 runs on this device: its Metal kernel
    ;     never quantises the activation at all. `sumq += qs[i] * yl[i]` is int8 weight times FLOAT
    ;     activation, and the whole q8a_quantize stage — one dispatch before every Q8_0 matvec, 302 a
    ;     token — exists on our side only to feed an association the reference's GPU does not use.
    ;
    ;     The shape is the other half of the finding. ds4 gives a row 128 threads (256-thread group,
    ;     two rows); ours gave it eight. Thread (ix, il) owns block sgitg*8+ix and its EIGHT CONTIGUOUS
    ;     payload bytes at il*8, so a simdgroup walks 272 contiguous bytes of a row per pass instead of
    ;     68, and sixteen times as many requests are in flight. The row loop keeps ds4's two-row block
    ;     so the activation registers are loaded once and spent twice.
    ;
    ;     This CHANGES THE ASSOCIATION, and that is said plainly rather than assumed away: it is
    ;     tolerated here for the reason freewall (row 959) already recorded — ds4's own CPU and Metal
    ;     arms produce the identical stream under exactly these two associations — and it is CHECKED,
    ;     every run, against the reference's thirty tokens. ---
    (defn dom-q80-mv-ds4-body ()
        "kernel void form_dsv4_q80_matvec_ds4 (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort3 ntg [[threads_per_threadgroup]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { threadgroup float sh[64]; uint nb = cols / 32u; uint r0 = tgpig.x * 2u; uint nsg = (uint)ntg.x / 32u; uint stride = nsg * 8u; ushort ix = tiisg / 4u; ushort il = tiisg - ix * 4u; uint ib0 = (uint)sgitg * 8u + (uint)ix; float sumf0 = 0.0f; float sumf1 = 0.0f; float yl[8]; device const float* yb = x + ib0 * 32u + (uint)il * 8u; for (uint ib = ib0; ib < nb; ib += stride) { packed_float4 ya = *(device const packed_float4*)(yb); packed_float4 yc = *(device const packed_float4*)(yb + 4); yl[0] = ya.x; yl[1] = ya.y; yl[2] = ya.z; yl[3] = ya.w; yl[4] = yc.x; yl[5] = yc.y; yl[6] = yc.z; yl[7] = yc.w; for (ushort row = 0u; row < 2u; ++row) { uint r = r0 + (uint)row; if (r >= rows) continue; ulong bo = ((ulong)r * (ulong)nb + (ulong)ib) * 34ul; ushort h = (ushort)qb[bo] | ((ushort)qb[bo + 1ul] << 8); device const uchar* qs = qb + bo + 2ul + (ulong)((uint)il * 8u); char4 wa = char4(*(device const packed_char4*)(qs)); char4 wc = char4(*(device const packed_char4*)(qs + 4)); float sumq = 0.0f; sumq = sumq + float(wa.x) * yl[0]; sumq = sumq + float(wa.y) * yl[1]; sumq = sumq + float(wa.z) * yl[2]; sumq = sumq + float(wa.w) * yl[3]; sumq = sumq + float(wc.x) * yl[4]; sumq = sumq + float(wc.y) * yl[5]; sumq = sumq + float(wc.z) * yl[6]; sumq = sumq + float(wc.w) * yl[7]; float d = float(as_type<half>(h)); if (row == 0u) sumf0 = sumf0 + sumq * d; else sumf1 = sumf1 + sumq * d; } yb += stride * 32u; } if (sgitg == 0u) { sh[tiisg] = 0.0f; sh[32u + tiisg] = 0.0f; } sumf0 = metal::simd_sum(sumf0); sumf1 = metal::simd_sum(sumf1); metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (tiisg == 0u) { sh[sgitg] = sumf0; sh[32u + sgitg] = sumf1; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float t0 = metal::simd_sum(sh[tiisg]); float t1 = metal::simd_sum(sh[32u + tiisg]); if (tiisg == 0u && sgitg == 0u) { if (r0 < rows) y[r0] = t0; if (r0 + 1u < rows) y[r0 + 1u] = t1; } } ")

    ; --- THE F16 MATVEC WIDENED, because ablation said what doubling could not.
    ;     Doubling this kernel moved the floor 5 ms and it was believed; NOT ENCODING IT AT ALL moves
    ;     the floor 12 — the second largest cost in the token, for 0.678 GB, which is 57 GB/s on a bus
    ;     measured at 471. Doubling understated it because the second copy of a small tensor reads a
    ;     warm cache; the ablation cannot be fooled that way.
    ;     The cause is thread count, and it is extreme: hc_attn_fn and hc_ffn_fn are 24 rows of 16384,
    ;     and rows*8 is 192 THREADS on a device with about five thousand lanes. Eight chains a row is
    ;     ds4.c:6664's NEON association faithfully carried, and it is a ceiling of eight threads a row
    ;     wherever the row count is small.
    ;     So: ds4_metal.m:4346's own f16 dispatch instead — nsg = min(8, ceil(in_dim/128)), nr0 = 2, a
    ;     256-thread group to two rows, every thread striding the row in packed_half4, simd_sum and a
    ;     simd_sum over the simdgroups' partials. 192 threads become 3072.
    ;     This reassociates in f32 only — no quantisation changes hands, unlike the Q8_0 pair above —
    ;     and the stream is checked every run, as the wide RMSNorm was. ---
    (defn dom-f16-mv-wide-body ()
        "kernel void form_dsv4_f16_matvec_wide (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint3 tgpig [[threadgroup_position_in_grid]], ushort3 tpitg [[thread_position_in_threadgroup]], ushort3 ntg [[threads_per_threadgroup]], ushort tiisg [[thread_index_in_simdgroup]], ushort sgitg [[simdgroup_index_in_threadgroup]]) { threadgroup float sh[64]; uint r0 = (uint)tgpig.x * 2u; uint tid = (uint)tpitg.x; uint nt = (uint)ntg.x; uint n4 = cols / 4u; float s0 = 0.0f; float s1 = 0.0f; for (uint k = tid; k < n4; k += nt) { uint j = k * 4u; packed_float4 xv = *(device const packed_float4*)(x + j); if (r0 < rows) { device const packed_half4* w = (device const packed_half4*)(qb + ((ulong)r0 * (ulong)cols + (ulong)j) * 2ul); half4 h = half4(*w); s0 = s0 + (float(h.x) * xv.x + float(h.y) * xv.y) + (float(h.z) * xv.z + float(h.w) * xv.w); } if (r0 + 1u < rows) { device const packed_half4* w = (device const packed_half4*)(qb + ((ulong)(r0 + 1u) * (ulong)cols + (ulong)j) * 2ul); half4 h = half4(*w); s1 = s1 + (float(h.x) * xv.x + float(h.y) * xv.y) + (float(h.z) * xv.z + float(h.w) * xv.w); } } for (uint j = n4 * 4u + tid; j < cols; j += nt) { float xv = x[j]; if (r0 < rows) { ushort hb = *(device const ushort*)(qb + ((ulong)r0 * (ulong)cols + (ulong)j) * 2ul); s0 = s0 + float(as_type<half>(hb)) * xv; } if (r0 + 1u < rows) { ushort hb = *(device const ushort*)(qb + ((ulong)(r0 + 1u) * (ulong)cols + (ulong)j) * 2ul); s1 = s1 + float(as_type<half>(hb)) * xv; } } if (sgitg == 0u) { sh[tiisg] = 0.0f; sh[32u + tiisg] = 0.0f; } s0 = metal::simd_sum(s0); s1 = metal::simd_sum(s1); metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); if (tiisg == 0u) { sh[sgitg] = s0; sh[32u + sgitg] = s1; } metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup); float t0 = metal::simd_sum(sh[tiisg]); float t1 = metal::simd_sum(sh[32u + tiisg]); if (tiisg == 0u && sgitg == 0u) { if (r0 < rows) y[r0] = t0; if (r0 + 1u < rows) y[r0 + 1u] = t1; } } ")

    ; --- THE DENOMINATOR, MEASURED. Every claim about a matvec being "slow" is a claim about some peak
    ;     it is not reaching, and the peak had been taken from a spec sheet. This reads a span of the
    ;     resident file with nothing but 16-byte loads and an xor, so what it times is the bus and not
    ;     arithmetic, addressing or decode. The sink write is guarded by a value the xor cannot produce
    ;     often, so the loads cannot be dead-code-eliminated but the store never costs a token. ---
    (defn dom-bw-probe-body ()
        "kernel void form_bw_probe (device const uint* src [[buffer(0)]], device float* sink [[buffer(1)]], constant uint& nwords [[buffer(2)]], uint gid [[thread_position_in_grid]], uint gsz [[threads_per_grid]]) { uint acc = 0u; for (uint i = gid * 4u; i + 3u < nwords; i += gsz * 4u) { uint4 v = *(device const uint4*)(src + i); acc = acc ^ v.x; acc = acc ^ v.y; acc = acc ^ v.z; acc = acc ^ v.w; } if (acc == 0xFFFFFFFFu) sink[0] = float(acc); } ")

    (defn dom-f16-ordered8-body ()
        "kernel void form_dsv4_f16_matvec_ordered8 (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) { uint r = gid / 8u; if (r >= rows) return; uint c = gid - r * 8u; ulong base = (ulong)r * (ulong)cols; uint nfull = (cols / 8u) * 8u; float acc = 0.0f; uint j = c; for (; j + 56u < nfull; j += 64u) { ushort h0 = *(device const ushort*)(qb + (base + (ulong)j) * 2ul); ushort h1 = *(device const ushort*)(qb + (base + (ulong)(j + 8u)) * 2ul); ushort h2 = *(device const ushort*)(qb + (base + (ulong)(j + 16u)) * 2ul); ushort h3 = *(device const ushort*)(qb + (base + (ulong)(j + 24u)) * 2ul); ushort h4 = *(device const ushort*)(qb + (base + (ulong)(j + 32u)) * 2ul); ushort h5 = *(device const ushort*)(qb + (base + (ulong)(j + 40u)) * 2ul); ushort h6 = *(device const ushort*)(qb + (base + (ulong)(j + 48u)) * 2ul); ushort h7 = *(device const ushort*)(qb + (base + (ulong)(j + 56u)) * 2ul); float x0 = x[j]; float x1 = x[j + 8u]; float x2 = x[j + 16u]; float x3 = x[j + 24u]; float x4 = x[j + 32u]; float x5 = x[j + 40u]; float x6 = x[j + 48u]; float x7 = x[j + 56u]; acc = metal::fma(float(as_type<half>(h0)), x0, acc); acc = metal::fma(float(as_type<half>(h1)), x1, acc); acc = metal::fma(float(as_type<half>(h2)), x2, acc); acc = metal::fma(float(as_type<half>(h3)), x3, acc); acc = metal::fma(float(as_type<half>(h4)), x4, acc); acc = metal::fma(float(as_type<half>(h5)), x5, acc); acc = metal::fma(float(as_type<half>(h6)), x6, acc); acc = metal::fma(float(as_type<half>(h7)), x7, acc); } for (; j < nfull; j += 8u) { ushort h = *(device const ushort*)(qb + (base + (ulong)j) * 2ul); acc = metal::fma(float(as_type<half>(h)), x[j], acc); } uint ob = (lane / 8u) * 8u; float v0 = metal::simd_shuffle(acc, ob); float v1 = metal::simd_shuffle(acc, ob + 1u); float v2 = metal::simd_shuffle(acc, ob + 2u); float v3 = metal::simd_shuffle(acc, ob + 3u); float v4 = metal::simd_shuffle(acc, ob + 4u); float v5 = metal::simd_shuffle(acc, ob + 5u); float v6 = metal::simd_shuffle(acc, ob + 6u); float v7 = metal::simd_shuffle(acc, ob + 7u); if (c != 0u) return; float t0 = v0 + v4; float t1 = v1 + v5; float t2 = v2 + v6; float t3 = v3 + v7; float s = (t0 + t1) + (t2 + t3); for (uint j = nfull; j < cols; ++j) { ushort h = *(device const ushort*)(qb + (base + (ulong)j) * 2ul); s = s + float(as_type<half>(h)) * x[j]; } y[r] = s; } ")

    (defn dom-f16-ordered-body ()
        "kernel void form_dsv4_f16_matvec_ordered (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint r [[thread_position_in_grid]]) { if (r >= rows) return; ulong base = (ulong)r * (ulong)cols; float a0[4]; float a1[4]; for (uint l = 0u; l < 4u; ++l) { a0[l] = 0.0f; a1[l] = 0.0f; } uint i = 0u; for (; i + 8u <= cols; i += 8u) { for (uint l = 0u; l < 4u; ++l) { ushort hv0 = *(device const ushort*)(qb + (base + (ulong)(i + l)) * 2ul); ushort hv1 = *(device const ushort*)(qb + (base + (ulong)(i + 4u + l)) * 2ul); a0[l] = metal::fma(float(as_type<half>(hv0)), x[i + l], a0[l]); a1[l] = metal::fma(float(as_type<half>(hv1)), x[i + 4u + l], a1[l]); } } float t0 = a0[0] + a1[0]; float t1 = a0[1] + a1[1]; float t2 = a0[2] + a1[2]; float t3 = a0[3] + a1[3]; float acc = (t0 + t1) + (t2 + t3); for (; i < cols; ++i) { ushort hv = *(device const ushort*)(qb + (base + (ulong)i) * 2ul); acc = acc + float(as_type<half>(hv)) * x[i]; } y[r] = acc; } ")

    ; =========================================================================
    ; THE Q2_K ROW DOT (ds4.c:3480) — the easy one, and the one most unlike our own: a PLAIN ASCENDING
    ; SCALAR SUM. No NEON, no FMA, no blocking. Our fused kernel splits it 32 ways and simd_sums; this
    ; walks k from 0 upward and adds. q2k_w is q2k-dequant.fk's carver, unchanged.
    ; =========================================================================
    ; HOISTED, AND BIT-IDENTICAL. The naive form calls q2k_w per element, which re-derives per-BLOCK
    ; and per-GROUP constants every time: two f16 decodes (each a divide-and-compare chain) for every
    ; one of 256 elements that share them, plus a power-of-two loop per element. This walks the same k
    ; ASCENDING — blk outer, group next, l inner, so k = blk*256 + g*16 + l counts 0,1,2,... — and only
    ; moves the invariants out. The accumulation order is untouched, which is the whole point: order is
    ; what fidelity rests on, and decode placement is free.
    ;   ds = d*(sc mod 16) then ds*q  associates exactly as d*(sc mod 16)*q did (left to right)
    ;   dm = dmin*(sc/16)             is the per-group min, subtracted per element as before
    (defn dom-q2k-ordered-body ()
        "kernel void form_dsv4_q2k_matvec_ordered (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint r [[thread_position_in_grid]]) { if (r >= rows) return; uint nb = cols / 256u; ulong rowbase = (ulong)r * (ulong)nb * 84ul; float sum = 0.0f; for (uint blk = 0u; blk < nb; ++blk) { device const uchar* b = qb + rowbase + (ulong)blk * 84ul; float d = q2k_f16(int(b[80]) + 256 * int(b[81])); float dmin = q2k_f16(int(b[82]) + 256 * int(b[83])); device const float* xb = x + blk * 256u; for (uint g = 0u; g < 16u; ++g) { uint sc = uint(b[g]); float ds = d * float(q2k_umod(sc, 16u)); float dm = dmin * float(sc / 16u); uint qbase = 32u * (g / 8u) + 16u * q2k_umod(g, 2u); uint p2 = q2k_upow2(q2k_umod(g / 2u, 4u) * 2u); device const uchar* qs = b + 16u + qbase; device const float* xg = xb + g * 16u; for (uint l = 0u; l < 16u; ++l) { float w = ds * float(q2k_umod(uint(qs[l]) / p2, 4u)) - dm; sum = sum + w * xg[l]; } } } y[r] = sum; } ")

    ; =========================================================================
    ; IQ2_XXS, HOISTED. iq2_w re-derives, for EVERY weight: an f16 decode, a 4-byte aux1
    ; reconstruction, a scale, and TWO power-of-two loops (one to select the sign index, one to pick
    ; the sign bit). Of those, d/aux1/scalecode/scale are constant across a 32-element sub-block and
    ; the sign word is constant across each group of 8. Only the grid magnitude and one sign bit vary
    ; per element. On this file that redundancy is most of the model's work: gate AND up are IQ2_XXS,
    ; two of every three routed-expert weights.
    ;
    ; THE MAP CHANGES, and that is said out loud rather than hidden: each lane now owns whole 32-element
    ; sub-blocks (lane L takes sub-block L, L+32, ...) instead of striding single columns, so the
    ; within-lane summation order is NOT the old one. Unlike the Q2_K hoist, this is not bit-identical
    ; by construction, so the token stream has to be re-measured, not assumed.
    (defn dom-iq2-hoist-body ()
        "kernel void form_dsv4_iq2_matvec_hoist (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], constant uint& rows [[buffer(3)]], constant uint& cols [[buffer(4)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) { uint r = gid / 32u; if (r >= rows) return; uint nsub = cols / 32u; ulong rowbase = (ulong)r * (ulong)(cols / 256u) * 66ul; float acc = 0.0f; for (uint sub = lane; sub < nsub; sub += 32u) { uint blk = sub / 8u; uint ib32 = sub - blk * 8u; device const uchar* off = qb + rowbase + (ulong)blk * 66ul; float d = iq2_f16(int(off[0]) + 256 * int(off[1])); device const uchar* gbase = off + 2u + 8u * ib32; uint aux1 = uint(gbase[4]) + 256u * uint(gbase[5]) + 65536u * uint(gbase[6]) + 16777216u * uint(gbase[7]); int scalecode = int(uint(gbase[7]) >> 4u); float scale = 0.125f * d * float(2 * scalecode + 1); device const float* xs = x + sub * 32u; for (uint l = 0u; l < 4u; ++l) { int gidx = int(gbase[l]); uint signidx = (aux1 >> (7u * l)) & 127u; constant uchar* g8 = iq2_grid + uint(gidx) * 8u; device const float* xl = xs + l * 8u; uint sr = uint(iq2_ksigns[signidx]); for (uint j = 0u; j < 8u; ++j) { uint sbit = sr & 1u; sr = sr >> 1u; float sgn = (sbit == 1u) ? -1.0f : 1.0f; acc = acc + ((scale * sgn) * float(g8[j])) * xl[j]; } } } float s = metal::simd_sum(acc); if (lane == 0u) y[r] = s; } ")

    ; =========================================================================
    ; ALL SIX ROUTED EXPERTS IN ONE DISPATCH. The stack was asking the device 81 times per layer where
    ; ds4 runs a single fused graph, and THIRTY of those were the six experts taken one at a time:
    ; gate, up, swiglu, down, accumulate, six times over. At 72 us of measured cost per dispatch the
    ; asking, not the arithmetic, is what is left (callbias, corpus row 955).
    ;
    ; The expert ids already live in a device buffer — the router kernel writes them — so the slot loop
    ; never needed the CPU at all. gid now carries (slot, row, lane); the slot picks its id from that
    ; buffer and its byte slice from `stride`, exactly as the host was doing per call. Each expert's
    ; arithmetic is untouched, so every value is bit-identical; only the number of asks changes.
    (defn dom-iq2-experts-body ()
        "kernel void form_dsv4_iq2_matvec_experts (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], device const uint* ids [[buffer(3)]], constant uint& rows [[buffer(4)]], constant uint& cols [[buffer(5)]], constant uint& stride [[buffer(6)]], constant uint& nexp [[buffer(7)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) { uint per = rows * 32u; uint slot = gid / per; if (slot >= nexp) return; uint g = gid - slot * per; uint r = g / 32u; ulong ebase = (ulong)ids[slot] * (ulong)stride; uint nsub = cols / 32u; ulong rowbase = ebase + (ulong)r * (ulong)(cols / 256u) * 66ul; float acc = 0.0f; for (uint sub = lane; sub < nsub; sub += 32u) { uint blk = sub / 8u; uint ib32 = sub - blk * 8u; device const uchar* off = qb + rowbase + (ulong)blk * 66ul; float d = iq2_f16(int(off[0]) + 256 * int(off[1])); device const uchar* gb = off + 2u + 8u * ib32; uint aux1 = uint(gb[4]) + 256u * uint(gb[5]) + 65536u * uint(gb[6]) + 16777216u * uint(gb[7]); int scalecode = int(uint(gb[7]) >> 4u); float scale = 0.125f * d * float(2 * scalecode + 1); device const float* xs = x + sub * 32u; for (uint l = 0u; l < 4u; ++l) { int gidx = int(gb[l]); uint signidx = (aux1 >> (7u * l)) & 127u; constant uchar* g8 = iq2_grid + uint(gidx) * 8u; device const float* xl = xs + l * 8u; uint sr = uint(iq2_ksigns[signidx]); for (uint j = 0u; j < 8u; ++j) { uint sbit = sr & 1u; sr = sr >> 1u; float sgn = (sbit == 1u) ? -1.0f : 1.0f; acc = acc + ((scale * sgn) * float(g8[j])) * xl[j]; } } } float s = metal::simd_sum(acc); if (lane == 0u) y[slot * rows + r] = s; } ")

    ; FOUR ROWS PER THREAD, THE ACTIVATION HELD IN REGISTERS — read off ds4's own Metal shader
    ; (metal/moe.metal:3284, N_R0_IQ2_XXS = 4 at :15), which is the second implementation the reference
    ; carries and which I had never opened (secondoracle, corpus row 957). ds4 loads yl[32] once per
    ; 32-element sub-block and folds FOUR output rows against it; we were re-reading the same 32
    ; activations from device memory once per row. Same weights, same lane map, same per-row
    ; accumulation ORDER — sumf[rr] is added into directly, never via a per-sub-block temporary, so the
    ; chain each row sees is the chain it saw before. Bit-identical; only the reads change.
    (defn dom-iq2-experts4-body ()
        "kernel void form_dsv4_iq2_matvec_experts4 (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], device const uint* ids [[buffer(3)]], constant uint& rows [[buffer(4)]], constant uint& cols [[buffer(5)]], constant uint& stride [[buffer(6)]], constant uint& nexp [[buffer(7)]], uint gid [[thread_position_in_grid]], uint lane [[thread_index_in_simdgroup]]) { uint rg = rows / 4u; uint per = rg * 32u; uint slot = gid / per; if (slot >= nexp) return; uint g = gid - slot * per; uint r0 = (g / 32u) * 4u; ulong ebase = (ulong)ids[slot] * (ulong)stride; uint nsub = cols / 32u; ulong rstride = (ulong)(cols / 256u) * 66ul; float sumf[4]; for (uint i = 0u; i < 4u; ++i) sumf[i] = 0.0f; for (uint sub = lane; sub < nsub; sub += 32u) { float xl[32]; device const float* xsrc = x + sub * 32u; for (uint i = 0u; i < 32u; ++i) xl[i] = xsrc[i]; uint blk = sub / 8u; uint ib32 = sub - blk * 8u; for (uint rr = 0u; rr < 4u; ++rr) { device const uchar* off = qb + ebase + (ulong)(r0 + rr) * rstride + (ulong)blk * 66ul; float d = iq2_f16(int(off[0]) + 256 * int(off[1])); device const uchar* gb = off + 2u + 8u * ib32; uint aux1 = uint(gb[4]) + 256u * uint(gb[5]) + 65536u * uint(gb[6]) + 16777216u * uint(gb[7]); int scalecode = int(uint(gb[7]) >> 4u); float scale = 0.125f * d * float(2 * scalecode + 1); for (uint l = 0u; l < 4u; ++l) { int gidx = int(gb[l]); uint signidx = (aux1 >> (7u * l)) & 127u; constant uchar* g8 = iq2_grid + uint(gidx) * 8u; uint sr = uint(iq2_ksigns[signidx]); for (uint j = 0u; j < 8u; ++j) { uint sbit = sr & 1u; sr = sr >> 1u; float sgn = (sbit == 1u) ? -1.0f : 1.0f; sumf[rr] = sumf[rr] + ((scale * sgn) * float(g8[j])) * xl[l * 8u + j]; } } } } for (uint rr = 0u; rr < 4u; ++rr) { float s = metal::simd_sum(sumf[rr]); if (lane == 0u) y[slot * rows + r0 + rr] = s; } } ")

    (defn dom-q2k-experts-body ()
        "kernel void form_dsv4_q2k_matvec_experts (device const uchar* qb [[buffer(0)]], device const float* x [[buffer(1)]], device float* y [[buffer(2)]], device const uint* ids [[buffer(3)]], constant uint& rows [[buffer(4)]], constant uint& cols [[buffer(5)]], constant uint& stride [[buffer(6)]], constant uint& nexp [[buffer(7)]], uint gid [[thread_position_in_grid]]) { uint slot = gid / rows; if (slot >= nexp) return; uint r = gid - slot * rows; uint nb = cols / 256u; ulong rowbase = (ulong)ids[slot] * (ulong)stride + (ulong)r * (ulong)nb * 84ul; device const float* xe = x + slot * cols; float sum = 0.0f; for (uint blk = 0u; blk < nb; ++blk) { device const uchar* b = qb + rowbase + (ulong)blk * 84ul; float d = q2k_f16(int(b[80]) + 256 * int(b[81])); float dmin = q2k_f16(int(b[82]) + 256 * int(b[83])); device const float* xb = xe + blk * 256u; for (uint g = 0u; g < 16u; ++g) { uint sc = uint(b[g]); float ds = d * float(sc & 15u); float dm = dmin * float(sc >> 4u); uint qbase = 32u * (g >> 3u) + 16u * (g & 1u); uint sh = ((g >> 1u) & 3u) * 2u; device const uchar* qs = b + 16u + qbase; device const float* xg = xb + g * 16u; for (uint l = 0u; l < 16u; ++l) { float w = ds * float((uint(qs[l]) >> sh) & 3u) - dm; sum = sum + w * xg[l]; } } } y[slot * rows + r] = sum; } ")

    ; the swiglu over all six slots at once, each with its own routing weight, and the final sum of the
    ; six down-vectors. ds4 adds the experts in SLOT ORDER (ds4.c layer_routed_moe_one), so the reduce
    ; ascends over slots and the answer is the host loop's answer, not a reassociation of it.
    ; the SAME clamp asymmetry as form_dsv4_swiglu_f32 — cl_hi on the gate, cl_hi THEN cl_lo on the up.
    ; Written by reusing that kernel's own helpers rather than restating the recipe, because my first
    ; attempt restated it and got it wrong (a symmetric clamp and a stray +1). A fused kernel is a
    ; rearrangement of dispatches, never a second copy of the arithmetic.
    (defn dom-swiglu-experts-body ()
        "kernel void form_dsv4_swiglu_experts (device const float* gate [[buffer(0)]], device const float* up [[buffer(1)]], device float* out [[buffer(2)]], device const float* wts [[buffer(3)]], constant uint& n [[buffer(4)]], constant uint& nexp [[buffer(5)]], constant float& lim [[buffer(6)]], uint gid [[thread_position_in_grid]]) { uint total = n * nexp; if (gid >= total) return; uint slot = gid / n; float g = dm_cl_hi(gate[gid], lim); float u = dm_cl_lo(dm_cl_hi(up[gid], lim), lim); out[gid] = (dm_silu(g) * u) * wts[slot]; } ")
    (defn dom-moe-reduce-body ()
        "kernel void form_dsv4_moe_reduce (device const float* parts [[buffer(0)]], device float* out [[buffer(1)]], constant uint& n [[buffer(2)]], constant uint& nexp [[buffer(3)]], uint d [[thread_position_in_grid]]) { if (d >= n) return; float s = 0.0f; for (uint slot = 0u; slot < nexp; ++slot) s = s + parts[slot * n + d]; out[d] = s; } ")

    ; two appendices, because the Q2_K one needs q2k-msl.fk's carver in its translation unit and the
    ; others stand alone. A carrier composes nothing; it takes whichever its unit can compile.
    (defn dom-msl-appendix ()
        (str_concat (dom-q8a-quantize-body)
        (str_concat (dom-q80-ordered-body)
        (str_concat (dom-q80-ordered8-body)
        (str_concat (dom-q80-mv-ds4-body)
        (str_concat (dom-bw-probe-body)
        (str_concat (dom-f16-mv-wide-body)
        (str_concat (dom-f16-ordered-body) (dom-f16-ordered8-body)))))))))
    (defn dom-q2k-appendix () (str_concat (dom-q2k-ordered-body) (dom-q2k-experts-body)))
    (defn dom-iq2-appendix () (str_concat (dom-iq2-hoist-body) (str_concat (dom-iq2-experts-body) (dom-iq2-experts4-body))))
    (defn dom-ffn-appendix () (str_concat (dom-swiglu-experts-body) (dom-moe-reduce-body)))
    0)
