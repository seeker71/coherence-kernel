; core-word-inquiry.fk — a bounded deictic request beginning at the core
; words, then adding an inquiry lane, a time/lens relation, and sovereign
; inner ack.
;
; The terminal acknowledgement vocabulary is axiom-1 exactly:
;   nothing = no answer in the offered fuel
;   0       = the offered reading is excluded, or inner knowing declines it
;   1       = the given time/lens answers a computable when/where inquiry
;   node    = what/how/why remains alive as the next inquiry
;
; The word floor is:
;   i you me we us do be exist
; layered with:
;   when where what how why
;
; Each alphabetic word has two deliberate surfaces. UPPER is inclusive by
; default: it admits its own UPPER and lower surface. lower is exclusive by
; default: it admits only the exact lower surface. Inclusion does not erase
; identity; every surface has its own compact node.
;
; Geometric local node namespace:
;   root(word) = 2 + word-index * 2^31
;   lower/UPPER surfaces sit at root+0/root+1
;   timeless details begin at root+2;
;   situated details follow them and are mixed-radix packed without holes.
;
; The 2^31 root stride is the smallest power-of-two prefix region that makes
; the nearest cross-root distance strictly greater than the farthest possible
; detail from its root. Meaningful detail is dense locally; stark difference
; is sparse globally.
;
; Two logic modes are explicit:
;   timeless = identity is invariant across time, space, and lens
;   situated = identity carries time and the whole lens
;
; A lens is [point, direction, intensity, focus]. Each component is a bounded
; 3-bit ordinal (0..7), not a claimed physical unit. Time is an 8-bit local
; phase (0..255). The old 20-bit time/point context therefore becomes
; 8 + 3 + 3 + 3 + 3 bits without widening the situated namespace. Within the
; declared membrane the packing is reversible and collision-free. These are
; geometric local recipe ids, not kernel-issued four-u32 NodeIDs.
;
; Inner knowing is an offered 0/1 value. This cell never claims to infer it.
; witnessed: 2026-07-25 -> geometric law 2147483647 four-way;
; timeless/situated lens law 65535 four-way;
; actual fkwu nothing/0/1/node binding 15
;
; preludes: form-stdlib/core.fk

(do
    (defn cwi-core-words ()
        (list "i" "you" "me" "we" "us" "do" "be" "exist"))
    (defn cwi-inquiry-words ()
        (list "when" "where" "what" "how" "why"))
    (defn cwi-all-words ()
        (append (cwi-core-words) (cwi-inquiry-words)))
    (defn cwi-root-stride () 2147483648)
    (defn cwi-timeless-detail-base () 2)
    (defn cwi-timeless-detail-count () 640)
    (defn cwi-situated-detail-base () 642)
    (defn cwi-request-detail-max () 671089281)
    (defn cwi-cross-root-distance-min ()
        (sub (cwi-root-stride) (cwi-request-detail-max)))

    (defn cwi-index-loop (words word index)
        (if (eq (len words) 0) -1
            (if (str_eq (head words) word) index
                (cwi-index-loop (tail words) word (add index 1)))))
    (defn cwi-index (words word)
        (cwi-index-loop words word 0))

    (defn cwi-lower-byte (byte)
        (if (and (ge byte 65) (le byte 90)) (add byte 32) byte))
    (defn cwi-upper-byte (byte)
        (if (and (ge byte 97) (le byte 122)) (sub byte 32) byte))
    (defn cwi-case-loop (surface index upper acc)
        (if (ge index (str_len surface)) acc
            (do
                (let byte (str_byte_at surface index))
                (let folded
                    (if (eq upper 1)
                        (cwi-upper-byte byte)
                        (cwi-lower-byte byte)))
                (cwi-case-loop surface (add index 1) upper
                    (str_concat acc (byte_to_str folded))))))
    (defn cwi-lower (surface) (cwi-case-loop surface 0 0 ""))
    (defn cwi-upper (surface) (cwi-case-loop surface 0 1 ""))

    ; Only deliberate all-lower and all-UPPER surfaces enter. Mixed case waits.
    (defn cwi-word-index (surface)
        (do
            (let canonical (cwi-lower surface))
            (let index (cwi-index (cwi-all-words) canonical))
            (if (lt index 0) -1
                (if (or (str_eq surface canonical)
                        (str_eq surface (cwi-upper canonical)))
                    index
                    -1))))
    (defn cwi-inclusive? (surface)
        (if (lt (cwi-word-index surface) 0) 0
            (if (str_eq surface (cwi-upper (cwi-lower surface))) 1 0)))
    (defn cwi-exclusive? (surface)
        (if (lt (cwi-word-index surface) 0) 0
            (if (str_eq surface (cwi-lower surface)) 1 0)))

    ; UPPER includes both surfaces of the same canonical word. lower is exact.
    (defn cwi-scope-allows? (scope offered)
        (if (or (lt (cwi-word-index scope) 0)
                (lt (cwi-word-index offered) 0))
            0
            (if (eq (cwi-inclusive? scope) 1)
                (if (str_eq (cwi-lower scope) (cwi-lower offered)) 1 0)
                (if (str_eq scope offered) 1 0))))

    ; The two surfaces of one word are immediate neighbors. Different words
    ; begin in distinct root regions separated by the root stride.
    (defn cwi-word-node (surface)
        (do
            (let index (cwi-word-index surface))
            (if (lt index 0) (nothing)
                (add 2 (add (mul index (cwi-root-stride))
                            (cwi-inclusive? surface))))))
    (defn cwi-surface-nodes (words)
        (if (eq (len words) 0) (list)
            (do
                (let word (head words))
                (cons (cwi-word-node word)
                    (cons (cwi-word-node (cwi-upper word))
                        (cwi-surface-nodes (tail words)))))))
    (defn cwi-member-int? (value values)
        (if (eq (len values) 0) 0
            (if (eq value (head values)) 1
                (cwi-member-int? value (tail values)))))
    (defn cwi-unique-ints? (values)
        (if (eq (len values) 0) 1
            (if (eq (cwi-member-int? (head values) (tail values)) 1) 0
                (cwi-unique-ints? (tail values)))))
    (defn cwi-min-int (values current)
        (if (eq (len values) 0) current
            (cwi-min-int (tail values)
                (if (lt (head values) current) (head values) current))))
    (defn cwi-max-int (values current)
        (if (eq (len values) 0) current
            (cwi-max-int (tail values)
                (if (gt (head values) current) (head values) current))))
    (defn cwi-detail-pairs-near? (words)
        (if (eq (len words) 0) 1
            (do
                (let word (head words))
                (if (eq (sub (cwi-word-node (cwi-upper word))
                             (cwi-word-node word)) 1)
                    (cwi-detail-pairs-near? (tail words))
                    0))))
    (defn cwi-root-geometry? ()
        (if (gt (cwi-cross-root-distance-min)
                (cwi-request-detail-max)) 1 0))
    (defn cwi-word-nodes-geometric? ()
        (do
            (let nodes (cwi-surface-nodes (cwi-all-words)))
            (if (and (eq (len nodes) 26)
                (and (eq (cwi-unique-ints? nodes) 1)
                (and (eq (cwi-min-int nodes 27) 2)
                (and (eq (cwi-detail-pairs-near? (cwi-all-words)) 1)
                (and (eq (sub (cwi-word-node "you")
                              (cwi-word-node "i"))
                         (cwi-root-stride))
                     (eq (cwi-root-geometry?) 1)))))) 1 0)))

    ; Within a core word's root region, timeless details carry only terms that
    ; can vary without time or space:
    ; 2 scope cases × 16 offered surfaces × 10 inquiry surfaces ×
    ; 2 inner states = 640.
    ;
    ; Situated details then use the exact cardinality of the whole context:
    ; 2 scope cases × 16 offered surfaces × 10 inquiry surfaces ×
    ; 256 time phases × 4096 lenses × 2 inner states = 671088640.
    (defn cwi-core-slot (surface)
        (do
            (let canonical (cwi-lower surface))
            (let index (cwi-index (cwi-core-words) canonical))
            (if (or (lt index 0) (lt (cwi-word-index surface) 0)) -1
                (add (mul index 2) (cwi-inclusive? surface)))))
    (defn cwi-inquiry-slot (surface)
        (do
            (let canonical (cwi-lower surface))
            (let index (cwi-index (cwi-inquiry-words) canonical))
            (if (or (lt index 0) (lt (cwi-word-index surface) 0)) -1
                (add (mul index 2) (cwi-inclusive? surface)))))
    (defn cwi-logic-mode-timeless () 0)
    (defn cwi-logic-mode-situated () 1)
    (defn cwi-logic-mode? (mode)
        (if (or (eq mode (cwi-logic-mode-timeless))
                (eq mode (cwi-logic-mode-situated))) 1 0))
    (defn cwi-time? (value)
        (if (and (ge value 0) (le value 255)) 1 0))
    (defn cwi-lens-coordinate? (value)
        (if (and (ge value 0) (le value 7)) 1 0))
    (defn cwi-lens (point direction intensity focus)
        (list point direction intensity focus))
    (defn cwi-l-point (lens) (nth lens 0))
    (defn cwi-l-direction (lens) (nth lens 1))
    (defn cwi-l-intensity (lens) (nth lens 2))
    (defn cwi-l-focus (lens) (nth lens 3))
    (defn cwi-lens? (lens)
        (if (and (eq (len lens) 4)
            (and (eq (cwi-lens-coordinate? (cwi-l-point lens)) 1)
            (and (eq (cwi-lens-coordinate? (cwi-l-direction lens)) 1)
            (and (eq (cwi-lens-coordinate? (cwi-l-intensity lens)) 1)
                 (eq (cwi-lens-coordinate? (cwi-l-focus lens)) 1))))) 1 0))
    (defn cwi-lens-rank (lens)
        (if (eq (cwi-lens? lens) 0) (nothing)
            (add
                (mul
                    (add
                        (mul
                            (add (mul (cwi-l-point lens) 8)
                                 (cwi-l-direction lens))
                            8)
                        (cwi-l-intensity lens))
                    8)
                (cwi-l-focus lens))))
    (defn cwi-inner? (value)
        (if (or (eq value 0) (eq value 1)) 1 0))
    (defn cwi-core-request-valid? (scope offered inquiry inner)
        (if (and (ge (cwi-core-slot scope) 0)
            (and (ge (cwi-core-slot offered) 0)
            (and (ge (cwi-inquiry-slot inquiry) 0)
                 (eq (cwi-inner? inner) 1)))) 1 0))
    (defn cwi-request-valid? (scope offered inquiry time lens inner)
        (if (and (eq (cwi-core-request-valid?
                        scope offered inquiry inner) 1)
            (and (eq (cwi-time? time) 1)
                 (eq (cwi-lens? lens) 1))) 1 0))

    (defn cwi-root-index-for-surface (surface)
        (cwi-index (cwi-all-words) (cwi-lower surface)))
    (defn cwi-node-root-index (node)
        (div (sub node 2) (cwi-root-stride)))
    (defn cwi-node-detail (node)
        (mod (sub node 2) (cwi-root-stride)))

    ; Each mixed-radix rank is a bijection inside the scope word's prefix.
    ; Timeless identity deliberately does not inspect time or lens. Situated
    ; identity includes every lens component through its reversible lens rank.
    (defn cwi-logic-node (mode scope offered inquiry time lens inner)
        (if (eq (cwi-logic-mode? mode) 0) (nothing)
            (if (eq (cwi-core-request-valid?
                        scope offered inquiry inner) 0)
                (nothing)
                (if (and (eq mode (cwi-logic-mode-situated))
                         (eq (cwi-request-valid?
                                scope offered inquiry time lens inner) 0))
                    (nothing)
                    (do
                        (let root (add 2
                            (mul (cwi-root-index-for-surface scope)
                                 (cwi-root-stride))))
                        (let a (add (mul (cwi-inclusive? scope) 16)
                                    (cwi-core-slot offered)))
                        (let b (add (mul a 10)
                                    (cwi-inquiry-slot inquiry)))
                        (if (eq mode (cwi-logic-mode-timeless))
                            (add root
                                (add (cwi-timeless-detail-base)
                                     (add (mul b 2) inner)))
                            (do
                                (let c (add (mul b 256) time))
                                (let d (add (mul c 4096)
                                            (cwi-lens-rank lens)))
                                (add root
                                    (add (cwi-situated-detail-base)
                                         (add (mul d 2) inner))))))))))
    (defn cwi-request-node (scope offered inquiry time lens inner)
        (cwi-logic-node (cwi-logic-mode-situated)
            scope offered inquiry time lens inner))
    (defn cwi-request-node-max () 15703474819)
    (defn cwi-request-node? (node)
        (if (and (ge node 4) (le node (cwi-request-node-max)))
            (do
                (let root (cwi-node-root-index node))
                (let detail (cwi-node-detail node))
                (if (and (ge root 0)
                    (and (le root 7)
                    (and (ge detail 2)
                         (le detail (cwi-request-detail-max))))) 1 0))
            0))
    (defn cwi-node-mode (node)
        (if (eq (cwi-request-node? node) 0) -1
            (if (lt (cwi-node-detail node)
                    (cwi-situated-detail-base))
                (cwi-logic-mode-timeless)
                (cwi-logic-mode-situated))))

    ; Reversible situated projections: the node carries who/what/when/where,
    ; every lens component, and the offered inner trust bit without retaining
    ; request prose.
    (defn cwi-request-rank (node)
        (sub (cwi-node-detail node) (cwi-situated-detail-base)))
    (defn cwi-r-inner (node) (mod (cwi-request-rank node) 2))
    (defn cwi-r-before-inner (node) (div (cwi-request-rank node) 2))
    (defn cwi-r-lens-rank (node) (mod (cwi-r-before-inner node) 4096))
    (defn cwi-r-before-lens (node) (div (cwi-r-before-inner node) 4096))
    (defn cwi-r-focus (node) (mod (cwi-r-lens-rank node) 8))
    (defn cwi-r-before-focus (node) (div (cwi-r-lens-rank node) 8))
    (defn cwi-r-intensity (node) (mod (cwi-r-before-focus node) 8))
    (defn cwi-r-before-intensity (node) (div (cwi-r-before-focus node) 8))
    (defn cwi-r-direction (node) (mod (cwi-r-before-intensity node) 8))
    (defn cwi-r-point (node) (div (cwi-r-before-intensity node) 8))
    (defn cwi-r-time (node) (mod (cwi-r-before-lens node) 256))
    (defn cwi-r-before-time (node) (div (cwi-r-before-lens node) 256))
    (defn cwi-r-inquiry-slot (node) (mod (cwi-r-before-time node) 10))
    (defn cwi-r-before-inquiry (node) (div (cwi-r-before-time node) 10))
    (defn cwi-r-offered-slot (node) (mod (cwi-r-before-inquiry node) 16))
    (defn cwi-r-scope-case (node) (div (cwi-r-before-inquiry node) 16))
    (defn cwi-r-scope-slot (node)
        (add (mul (cwi-node-root-index node) 2)
             (cwi-r-scope-case node)))

    ; Four-way acknowledgement law. The proof siblings do not carry actual
    ; `nothing`, so the law uses the same kind vocabulary as offer-ack-core:
    ; 0 nothing / 1 zero / 2 one / 3 node. cwi-reply below binds the law to
    ; the actual fkwu values without pretending that sibling capability.
    (defn cwi-tag-nothing () 0)
    (defn cwi-tag-zero () 1)
    (defn cwi-tag-one () 2)
    (defn cwi-tag-node () 3)
    (defn cwi-outcome (kind node reason)
        (list kind node reason))
    (defn cwi-o-kind (outcome) (nth outcome 0))
    (defn cwi-o-node (outcome) (nth outcome 1))
    (defn cwi-o-reason (outcome) (nth outcome 2))
    (defn cwi-kind? (kind)
        (if (and (ge kind (cwi-tag-nothing))
                 (le kind (cwi-tag-node))) 1 0))

    ; The pure settlement crosses all four proof siblings.
    (defn cwi-settle-logic
        (mode scope offered inquiry time lens fuel inner)
        (if (or (eq (cwi-logic-mode? mode) 0)
            (or (eq (cwi-core-request-valid?
                        scope offered inquiry inner) 0)
                (and (eq mode (cwi-logic-mode-situated))
                     (eq (cwi-request-valid?
                            scope offered inquiry time lens inner) 0))))
            (cwi-outcome (cwi-tag-nothing) 2 1)
            (do
                (let node (cwi-logic-node
                    mode scope offered inquiry time lens inner))
                (if (le fuel 0)
                    (cwi-outcome (cwi-tag-nothing) node 2)
                    (if (eq (cwi-scope-allows? scope offered) 0)
                        (cwi-outcome (cwi-tag-zero) node 3)
                        (if (eq inner 0)
                            (cwi-outcome (cwi-tag-zero) node 4)
                            (if (or (str_eq (cwi-lower inquiry) "when")
                                    (str_eq (cwi-lower inquiry) "where"))
                                (cwi-outcome (cwi-tag-one) node 0)
                                (cwi-outcome (cwi-tag-node) node 0))))))))
    (defn cwi-settle (scope offered inquiry time lens fuel inner)
        (cwi-settle-logic (cwi-logic-mode-situated)
            scope offered inquiry time lens fuel inner))

    ; Proof vector keeps the four possible reply arms visible:
    ; [nothing, 0, 1, node, actual-ack, reason]
    ; reason 0 acknowledged, 1 invalid, 2 timeout, 3 excluded, 4 inner decline.
    (defn cwi-proof (node ack reason)
        (list (nothing) 0 1 node ack reason))
    (defn cwi-p-node (proof) (nth proof 3))
    (defn cwi-p-ack (proof) (nth proof 4))
    (defn cwi-p-reason (proof) (nth proof 5))
    (defn cwi-proof-arms? (proof)
        (if (and (nothing? (nth proof 0))
            (and (eq (nth proof 1) 0)
            (and (eq (nth proof 2) 1)
                 (ge (nth proof 3) 2)))) 1 0))
    (defn cwi-node-ack? (proof)
        (if (and (eq (cwi-request-node? (cwi-p-ack proof)) 1)
                 (eq (cwi-p-ack proof) (cwi-p-node proof))) 1 0))

    ; fkwu binding of the four-way law to actual nothing/0/1/node values.
    (defn cwi-reply-logic
        (mode scope offered inquiry time lens fuel inner)
        (do
            (let outcome
                (cwi-settle-logic
                    mode scope offered inquiry time lens fuel inner))
            (let kind (cwi-o-kind outcome))
            (let node (cwi-o-node outcome))
            (let reason (cwi-o-reason outcome))
            (if (eq kind (cwi-tag-nothing))
                (cwi-proof node (nothing) reason)
                (if (eq kind (cwi-tag-zero))
                    (cwi-proof node 0 reason)
                    (if (eq kind (cwi-tag-one))
                        (cwi-proof node 1 reason)
                        (cwi-proof node node reason))))))
    (defn cwi-reply (scope offered inquiry time lens fuel inner)
        (cwi-reply-logic (cwi-logic-mode-situated)
            scope offered inquiry time lens fuel inner))

    (defn cwi-ack-name (proof)
        (if (nothing? (cwi-p-ack proof)) "nothing"
            (if (eq (cwi-p-ack proof) 0) "0"
                (if (eq (cwi-p-ack proof) 1) "1"
                    (if (eq (cwi-node-ack? proof) 1) "node" "invalid")))))

    0)
