// block-join.fk — gap D of the LLM-inference arc: compose weight-load with the proven forward
// recipes. The load seam (gguf bytes → f32 weights) and the compute seam (tb-dot / tb-matvec /
// lblk-block-causal) were proven separately in gaps A/B/C; this cell is the JOIN — real weights
// from a buffer feed the same matvec/block algebra the toy bands already four-way.
//
// bj-dot-row-n / bj-matvec-q6k-row: load one Q6_K superblock from file bytes, then run the
// counted-dot semantic (bj-dot-fam — upward counted fold, the tree-walker twin of a native counted dot
// loop) over the dequantized f32 list.
//
// Kin: weight-load.fk (wl-load-q6k), transformer-block.fk (tb-dot/tb-matvec), llama-block.fk
// (lblk-proj-seq / lblk-block-causal), llama-gqa-block.fk (lgqa-block-causal).
//
// preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/gguf-read.fk form-stdlib/q4k-dequant.fk form-stdlib/q6k-dequant.fk form-stdlib/weight-load.fk form-stdlib/transformer-numerics.fk form-stdlib/trig.fk form-stdlib/llama-numerics.fk form-stdlib/rope.fk form-stdlib/transformer-block.fk form-stdlib/transformer-mh.fk form-stdlib/gqa-attn.fk form-stdlib/llama-block.fk form-stdlib/llama-gqa-block.fk
//
// The closure above carries the llama cells this unit calls — ln-rmsnorm, ln-swiglu
// (llama-numerics.fk), rope (rope.fk), lblk-block-causal (llama-block.fk) and lgqa-block-causal
// (llama-gqa-block.fk). Without them those five lower to nothing under axiom-5 and a band still prints a
// green verdict: bj-block-causal-d4 / bj-block-causal-gqa-d4 would be NUMB, not proven.
// Dependency-first FULL closure, so the block arms testify instead of recovering to silence.
//
// Proven by: form-stdlib/tests/block-join-band.fk
section [form.bml] {
    // --- the first n dequantized weights as a row vector (for embedding in wq/wk/...).
    // The reach is wl-q6k-at-FLAT, not wl-q6k-at: the flat accessor strides whole 210-byte
    // superblocks, so index 256 is weight 0 of the next block rather than a fabricated -0. A walk of
    // one superblock would have `nth` answer 0 past its 128/64/16-byte fields, correct only for
    // dim <= 16 (dim*dim <= 256) — silently, at full green, while a real llama3.2:3b row is 3072
    // weights wide. wl-q6k-at refuses out loud (q6k-at's form_error), and this call site takes the
    // striding door instead. ---
    def bj-row-n-from(bytes, off, i, n) = (Comparable) n == 0 ? empty() : cons(wl-q6k-at-flat(bytes, off, i), bj-row-n-from(bytes, off, i + 1, n - 1));
    def bj-row-n(bytes, off, n) = bj-row-n-from(bytes, off, 0, n);
    // --- dot semantics matching fam-dot-loop (upward counted fold; tree-walker twin of native lane) ---
    def bj-dot-fam-from(a, b, i, n, acc) = (Comparable) i == n ? acc : bj-dot-fam-from(tail(a), tail(b), i + 1, n, acc + head(a) * head(b));
    def bj-dot-fam(a, b) = bj-dot-fam-from(a, b, 0, len(a), 0.0);
    // --- dot the first n loaded weights with x (len x must be n) ---
    def bj-dot-row-n(bytes, off, n, x) = bj-dot-fam(bj-row-n(bytes, off, n), x);
    // --- load + dot: full 256-list dotted with x (len x must be 256) ---
    def bj-dot-q6k(bytes, off, x) = bj-dot-fam(wl-load-q6k(bytes, off), x);
    // --- load + single-row matvec: y = [ dot(first n weights, x) ] where n = len x ---
    def bj-matvec-q6k-row(bytes, off, x) = [bj-dot-row-n(bytes, off, len(x), x)];
    // --- replace row `r` of matrix `w` with `row` (same width); other rows unchanged ---
    def bj-replace-row-from(w, r, row, i) = (Comparable) len(w) == 0 ? empty() : (Comparable) i == r ? cons(row, tail(w)) : cons(head(w), bj-replace-row-from(tail(w), r, row, i + 1));
    def bj-replace-row(w, r, row) = bj-replace-row-from(w, r, row, 0);
    // --- load the first n weights from a Q6_K superblock into row r of matrix w ---
    def bj-wq-row-n(w, r, bytes, off, n) = bj-replace-row(w, r, bj-row-n(bytes, off, n));
    // --- a dim×dim matrix from consecutive dequantized weights starting at index `start`. The
    // maximum weight index it reaches is start + dim*dim - 1; bj-matrix-max-index names it so a
    // caller (or a band) can state the reach instead of discovering it as zeros. Since bj-row-n-from
    // strides, that index is now SERVED at any width rather than silently truncated at 255. ---
    def bj-matrix-max-index(start, dim) = start + dim * dim - 1;
    def bj-matrix-row(bytes, off, start, dim, r) = bj-row-n-from(bytes, off, start + r * dim, dim);
    def bj-matrix-from(bytes, off, start, dim, r) = (Comparable) r == dim ? empty() : cons(bj-matrix-row(bytes, off, start, dim, r), bj-matrix-from(bytes, off, start, dim, r + 1));
    def bj-matrix(bytes, off, start, dim) = bj-matrix-from(bytes, off, start, dim, 0);
    // --- all seven 4×4 projection matrices for one causal block (112 weights from one superblock) ---
    def bj-block-mats-d4(bytes, off) = [bj-matrix(bytes, off, 0, 4), bj-matrix(bytes, off, 16, 4), bj-matrix(bytes, off, 32, 4), bj-matrix(bytes, off, 48, 4), bj-matrix(bytes, off, 64, 4), bj-matrix(bytes, off, 80, 4), bj-matrix(bytes, off, 96, 4)];
    // --- causal llama block forward with every weight matrix from bj-block-mats-d4 ---
    def bj-block-causal-d4(mats, xs, g1, eps, g2) = lblk-block-causal(xs, g1, eps, mats[0], mats[1], mats[2], mats[3], 1.0 / tn-sqrt(4.0), 4, g2, mats[4], mats[5], mats[6]);
    // --- causal GQA llama3 block (n_q=2, n_kv=1, HD=2, cfg-llama3) over loaded 4×4 matrices ---
    def bj-block-causal-gqa-d4(mats, xs, g1, eps, g2) = lgqa-block-causal(xs, g1, eps, mats[0], mats[1], mats[2], mats[3], 1.0 / tn-sqrt(2.0), 2, 1, 2, rope-cfg-llama3(), g2, mats[4], mats[5], mats[6]);
    0;
}
