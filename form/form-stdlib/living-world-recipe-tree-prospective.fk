; living-world-recipe-tree-prospective.fk -- an admitted Recipe-tree successor
; meets identity-new, source-disjoint prospective observations.
;
; This is an evaluation membrane, not a promotion path.  It adapts the exact
; matches inside one current LWRTH field to the already-native LWPS held-out
; dataset/split/contract protocol without pretending those matches are the
; older LWPH hypothesis type.  Every successor match and every incumbent
; hypothesis is executed on the same exact cases.  No match or incumbent is
; selected as a representative.
;
; Prospective binding identities must be outside every placement retained by
; the contradicted parent tissue.  The recurrent sources of the prospective
; suite and cases must also be disjoint from both direct construction source
; sets carried by every successor match.  Failure of currentness, identity,
; recurrence, or disjointness returns nothing.  Exact derivations, plural
; outputs, alternatives, unknowns, NOTHING-now, timeout state, and the common
; dataset/split/contract identities remain inspectable.  Comparison moves no
; authority and never activates a Recipe.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk

(let LWRTE-DERIVATION (bp "LWRTE-DERIVATION"))

(defn lwrtep-target-for (candidate)
    (if (eq (lwrth-candidate? candidate) 0) (lwo-none)
        (do
            (let field (lwo-emergent-shape candidate))
            (let tree-candidate (lwrth-field-tree-candidate field))
            (lwrt-field-target (lwo-emergent-shape tree-candidate)))))

(defn lwrtep-placement-bindings-items (items field)
    (if (eq (len items) 0) field
        (do
            (let placement (lwo-emergent-shape (head items)))
            (lwrtep-placement-bindings-items (tail items)
                (lwo-field-add field
                    (lwph-probe-bindings
                        (lwph-placement-probe placement)))))))
(defn lwrtep-retained-bindings (target)
    (lwrtep-placement-bindings-items
        (lwo-field-items
            (lwht-tissue-placements (lwo-emergent-shape target)))
        (lwo-empty-field)))

(defn lwrtep-identity-clean? (candidate suite)
    (do
        (let target (lwrtep-target-for candidate))
        (if (or (node_eq target (lwo-none))
                (eq (lwps-suite-shape-valid? suite) 0)) 0
            (lwps-fields-disjoint?
                (lwps-split-prospective (lwps-suite-split suite))
                (lwrtep-retained-bindings target)))))

(defn lwrtep-union-sources (world cell field)
    (lwrth-field-union-items
        (lwo-field-items (lwrth-direct-sources world cell)) field))
(defn lwrtep-case-source-items (world items field)
    (if (eq (len items) 0) field
        (lwrtep-case-source-items world (tail items)
            (lwrtep-union-sources world (head items) field))))
(defn lwrtep-suite-sources (world suite)
    (do
        (let dataset (lwps-suite-dataset suite))
        (let with-cases
            (lwrtep-case-source-items world
                (lwo-field-items (lwps-dataset-cases dataset))
                (lwo-empty-field)))
        (lwrtep-union-sources world suite
            (lwrtep-union-sources world dataset
                (lwrtep-union-sources world (lwps-suite-split suite)
                    (lwrtep-union-sources world
                        (lwps-suite-contract suite) with-cases))))))

(defn lwrtep-match-source-clean-items? (items suite-sources)
    (if (eq (len items) 0) 1
        (do
            (let match (head items))
            (if (and
                    (eq (lwrth-fields-disjoint? suite-sources
                            (lwrth-match-tree-sources match)) 1)
                    (eq (lwrth-fields-disjoint? suite-sources
                            (lwrth-match-revision-sources match)) 1))
                (lwrtep-match-source-clean-items?
                    (tail items) suite-sources) 0))))
(defn lwrtep-source-clean? (world candidate suite threshold)
    (if (or (lt threshold 1)
            (eq (lwrth-candidate? candidate) 0)) 0
        (do
            (let sources (lwrtep-suite-sources world suite))
            (let matches
                (lwrth-field-matches (lwo-emergent-shape candidate)))
            (if (and (ge (lwo-field-size sources) threshold)
                     (eq (lwrtep-match-source-clean-items?
                            (lwo-field-items matches) sources) 1)) 1 0))))

(defn lwrtep-ready? (world candidate suite threshold)
    ; Staged explicitly: a non-recurrent or revoked suite closes this membrane
    ; before the deeper successor graph is recomputed.
    (if (eq (lwps-suite-current? world suite threshold) 0) 0
        (if (eq (lwrth-integrated-current? world candidate) 0) 0
            (if (eq (lwrtep-identity-clean? candidate suite) 0) 0
                (lwrtep-source-clean?
                    world candidate suite threshold)))))

; children: exact successor match, Recipe, bindings, output, exact-match bit,
; local path.
(defn lwrtep-derivation (match bindings output exact)
    (intern_node LWRTE-DERIVATION
        (list match (lwrth-match-recipe match) bindings output
              (intern_trivial_int exact) (lwo-local-path))))
(defn lwrtep-derivation? (cell)
    (lwo-category? cell LWRTE-DERIVATION))
(defn lwrtep-derivation-output (derivation)
    (nth (node_children derivation) 3))
(defn lwrtep-derivation-exact (derivation)
    (node_value (nth (node_children derivation) 4)))

(defn lwrtep-derive-items
    (items bindings expected derivations outputs matches)
    (if (eq (len items) 0) (list derivations outputs matches)
        (do
            (let match (head items))
            (let output
                (intern_trivial_int
                    (lwre-evaluate-bound
                        (lwrth-match-recipe match) bindings)))
            (let exact (if (node_eq output expected) 1 0))
            (let derivation
                (lwrtep-derivation match bindings output exact))
            (lwrtep-derive-items (tail items) bindings expected
                (lwo-field-add derivations derivation)
                (lwo-field-add outputs output)
                (if (eq exact 1)
                    (lwo-field-add matches derivation) matches)))))

(defn lwrtep-place (candidate case)
    (do
        (let ack (lwps-case-immediate case))
        (let result
            (if (eq (oac-one? ack) 1)
                (lwrtep-derive-items
                    (lwo-field-items
                        (lwrth-field-matches
                            (lwo-emergent-shape candidate)))
                    (lwps-case-bindings case) (oac-payload ack)
                    (lwo-empty-field) (lwo-empty-field) (lwo-empty-field))
                (list (lwo-empty-field) (lwo-empty-field)
                      (lwo-empty-field))))
        (lwps-placement case (nth result 0) (nth result 1) (nth result 2)
            (lwps-case-time case) (lwps-case-alternatives case)
            (lwps-case-unknown case) (lwps-case-lens case)
            (lwps-case-evidence case))))
(defn lwrtep-place-items (items candidate field)
    (if (eq (len items) 0) field
        (lwrtep-place-items (tail items) candidate
            (lwo-field-add field
                (lwrtep-place candidate (head items))))))

(defn lwrtep-evaluate-successor-ready (candidate suite)
    (do
        (let dataset (lwps-suite-dataset suite))
        (let placements
            (lwrtep-place-items
                (lwo-field-items (lwps-dataset-cases dataset))
                candidate (lwo-empty-field)))
        (lwps-evaluation candidate dataset (lwps-suite-split suite)
            (lwps-suite-contract suite) placements
            (lwps-metrics-for placements))))
(defn lwrtep-evaluate-successor (world candidate suite threshold)
    (if (eq (lwrtep-ready? world candidate suite threshold) 0) (lwo-none)
        (lwrtep-evaluate-successor-ready candidate suite)))

(defn lwrtep-incumbent-candidate (candidate)
    (do
        (let target (lwrtep-target-for candidate))
        (let tissue (lwo-emergent-shape target))
        (lwps-candidate target
            ; A fully contradicted tissue has no compatible hypotheses, but
            ; every historical incumbent remains present in an exact receipt.
            (lwht-receipt-hypotheses
                (lwo-field-items (lwht-tissue-receipts tissue))
                (lwo-empty-field))
            candidate)))
(defn lwrtep-evaluate-incumbent-ready (candidate suite)
    (do
        (let target (lwrtep-target-for candidate))
        (let dataset (lwps-suite-dataset suite))
        (let incumbent (lwrtep-incumbent-candidate candidate))
        (let placements
            (lwps-place-items
                (lwo-field-items (lwps-dataset-cases dataset))
                incumbent (lwo-empty-field)))
        (lwps-evaluation target dataset (lwps-suite-split suite)
            (lwps-suite-contract suite) placements
            (lwps-metrics-for placements))))
(defn lwrtep-evaluate-incumbent (world candidate suite threshold)
    (if (eq (lwrtep-ready? world candidate suite threshold) 0) (lwo-none)
        (lwrtep-evaluate-incumbent-ready candidate suite)))

(defn lwrtep-compare (world candidate suite threshold)
    (if (eq (lwrtep-ready? world candidate suite threshold) 0) (lwo-none)
        (lwps-compare
            (lwrtep-evaluate-incumbent-ready candidate suite)
            (lwrtep-evaluate-successor-ready candidate suite))))

(defn lwrtep-progress-target (comparison)
    (if (node_eq comparison (lwo-none)) "comparison:nothing"
        (do
            (let delta
                (lwps-delta-values
                    (lwps-comparison-delta comparison)))
            (lcfb-cat (list
                "admissible:"
                (int_to_str (lwps-comparison-admissible comparison))
                ":exact-delta:" (int_to_str (nth delta 2))
                ":plural-delta:" (int_to_str (nth delta 3))
                ":contradicted-delta:" (int_to_str (nth delta 4)))))))

