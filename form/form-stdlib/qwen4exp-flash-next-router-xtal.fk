
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/q6k-dequant.fk form-stdlib/q6k-msl.fk form-stdlib/transformer-numerics.fk form-stdlib/moe-msl.fk

(defn Q4RouterAuthorityPath () "form/form-stdlib/bml/qwen4exp-flash-next-router.bml")
(defn Q4RouterAuthorityKind () "high-bml-interface-class-const")
(defn Qwen4ExpFlashNextRouterAuthority () (list "abstraction" "Qwen4ExpFlashNextRouterAuthority" (list) (list) (list "Q4RouterAuthorityPath" "Q4RouterAuthorityKind") (list) (list)))
(defn Q4ExpertCount () 512)
(defn Q4SelectedCount () 10)
(defn Q4RefusedExpertCount () 513)
(defn q4r-authority () Qwen4ExpFlashNextRouterAuthority)
(defn q4r-pattern () (list "qwen4exp" "512-experts" "top-10" "softmax" "selected-renormalization" "best-first" "bounded-refusal"))
(defn q4r-logit (i) (sub (div (str_to_float (int_to_str i)) 64) 4))
(defn q4r-build (i n acc) (if (ge i n) (reverse acc) (q4r-build (add i 1) n (cons (q4r-logit i) acc))))
(defn q4r-logits () (q4r-build 0 (Q4ExpertCount) (tail (list "x"))))
(defn q4r-expect (j acc) (if (ge j (Q4SelectedCount)) (reverse acc) (q4r-expect (add j 1) (cons (sub (sub (Q4ExpertCount) 1) j) acc))))
(defn q4r-expected-ids () (q4r-expect 0 (tail (list "x"))))
(defn q4r-ids () (mm-route-ids (q4r-logits) (Q4ExpertCount) (Q4SelectedCount)))
(defn q4r-weights () (mm-route-weights (q4r-logits) (Q4ExpertCount) (Q4SelectedCount)))
(defn q4r-within-metal-radius (experts selected) (if (gt experts (Q4ExpertCount)) 0 (if (gt selected (Q4SelectedCount)) 0 (if (gt selected experts) 0 1))))
(defn q4r-ints-eq (a b) (if (eq (len a) (len b)) (if (eq (len a) 0) 1 (if (eq (head a) (head b)) (q4r-ints-eq (tail a) (tail b)) 0)) 0))
(defn q4r-distinct (xs) (if (le (len xs) 1) 1 (if (eq (mm-memq (head xs) (tail xs)) 1) 0 (q4r-distinct (tail xs)))))
(defn q4r-descending (xs) (if (le (len xs) 1) 1 (if (gt (head xs) (head (tail xs))) (q4r-descending (tail xs)) 0)))
(defn q4r-abs (x) (if (lt x 0) (sub 0 x) x))
(defn q4r-bit (ok bit) (if ok bit 0))
(defn q4r-check () (do (let ids (q4r-ids)) (let weights (q4r-weights)) (let c0 (q4r-bit (if (eq (Q4ExpertCount) 512) (eq (Q4SelectedCount) 10) 0) 1)) (let c1 (q4r-bit (eq (q4r-ints-eq ids (q4r-expected-ids)) 1) 2)) (let c2 (q4r-bit (if (eq (len ids) (Q4SelectedCount)) (q4r-distinct ids) 0) 4)) (let c3 (q4r-bit (lt (q4r-abs (sub (mm-sum weights 0) 1)) 1e-12) 8)) (let c4 (q4r-bit (q4r-descending weights) 16)) (let c5 (q4r-bit (if (eq (q4r-within-metal-radius 512 10) 1) (eq (q4r-within-metal-radius (Q4RefusedExpertCount) 10) 0) 0) 32)) (add c0 (add c1 (add c2 (add c3 (add c4 c5)))))))
(defn Qwen4ExpFlashNextRouter () (list "abstraction" "Qwen4ExpFlashNextRouter" (list) (list "q4r-logit" "q4r-build" "q4r-logits" "q4r-expect" "q4r-expected-ids" "q4r-ids" "q4r-weights" "q4r-within-metal-radius" "q4r-ints-eq" "q4r-distinct" "q4r-descending" "q4r-abs" "q4r-bit" "q4r-check") (list "Q4ExpertCount" "Q4SelectedCount" "Q4RefusedExpertCount") (list "q4r-authority") (list "q4r-pattern")))
0
