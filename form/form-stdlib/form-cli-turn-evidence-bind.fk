; form-cli-turn-evidence-bind.fk — bind one private rollout capability.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-turn-evidence-live.fk

(do
    (let path (read_line))
    (if (gt (file_size path) 0)
        (do
            (write_file_text (fctel-binding-path) path)
            ; A new explicit authority cannot inherit a byte cursor, partial
            ; row, or target from the previous rollout.
            (write_file_text (fctel-target-turn-path) "")
            (write_file_text (fctel-discovery-path) "")
            (write_file_text (fctel-progress-path) "")
            (write_file_text (fctel-candidate-row-path) "")
            (write_file_text (fctel-observed-row-path) "")
            (print_str "rollout-binding=observed\n")
            0)
        (do
            (print_str "rollout-binding=withheld\n")
            1)))
