; native-model-session-grounding-native-candidate.fk -- the minimal public
; candidate interface shared by discovery and privacy reduction.  It carries
; no embedding, ranking, task vocabulary, or evaluator dependency.  Each row
; is itself content-addressed from its exact local path and bounded text.
; preludes: form-stdlib/native-model-session-grounding-native-common.fk

(do
    ; tag, content address, local path identifier, bounded public text.
    (defn nmsgn-candidate (id text)
        (list "native-session-candidate-cell-v1"
              (nmsgn-sha256 (nmsgn-cat (list id "\n" text))) id text))
    (defn nmsgn-candidate-address (row) (nth row 1))
    (defn nmsgn-candidate-id (row) (nth row 2))
    (defn nmsgn-candidate-text (row) (nth row 3))
    (defn nmsgn-safe-path? (text)
        (if (gt (str_len text) 0)
            (if (str_eq (substring text 0 1) "/") 0
                (if (lt (str_find text ".." 0) 0) 1 0))
            0))
    (defn nmsgn-string-in? (value rows)
        (if (eq (len rows) 0) 0
            (if (str_eq value (head rows)) 1
                (nmsgn-string-in? value (tail rows)))))
    0)
