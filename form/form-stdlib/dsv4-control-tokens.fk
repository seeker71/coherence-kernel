; dsv4-control-tokens.fk — model-visible BMF control aliases over DS4's reserved bank.
;
; The artifact has no type-5 UNUSED rows. It does have 1,277 type-3 CONTROL
; rows, including 1,000 numbered placeholders beginning at 128000. We alias
; five of those already-resident embedding/output rows without changing the
; GGUF vocabulary or base weights. The alias makes the IDs representable now;
; semantic generation requires the companion adapter corpus.
;
; Canonical aliases:
;   NIL=128000 CUT=128001 FAIL=128002 TIMEOUT=128003 CHOICE=128004
;
; preludes: form-stdlib/dsv4-tokenizer.fk

(do
    (defn dct-model ()
        "/Users/ursmuff/models/ds4/ds4flash-v5mx-reap25-type40-mxfp8lt-dspark-v1.gguf")
    (defn dct-names () (list "NIL" "CUT" "FAIL" "TIMEOUT" "CHOICE"))
    (defn dct-ids () (list 128000 128001 128002 128003 128004))
    (defn dct-id (name)
        (if (str_eq name "NIL") 128000
        (if (str_eq name "CUT") 128001
        (if (str_eq name "FAIL") 128002
        (if (str_eq name "TIMEOUT") 128003
        (if (str_eq name "CHOICE") 128004 -1))))))
    (defn dct-name (id)
        (if (eq id 128000) "NIL"
        (if (eq id 128001) "CUT"
        (if (eq id 128002) "FAIL"
        (if (eq id 128003) "TIMEOUT"
        (if (eq id 128004) "CHOICE" ""))))))
    (defn dct-wire (name)
        (str_concat "<BMF:" (str_concat name ">")))

    ; GGUF token_type is i32. All five aliases must remain type-3 CONTROL.
    (defn dct-type-kv (src) (gmt-find src "tokenizer.ggml.token_type"))
    (defn dct-artifact-type (src id)
        (eqr-u32 src (gmt-arr-elem src (dct-type-kv src) id)))
    (defn dct-hd (n) (byte_to_str (if (lt n 10) (add 48 n) (add 87 n))))
    (defn dct-bhex (b) (str_concat (dct-hd (div b 16)) (dct-hd (mod b 16))))
    (defn dct-piece-hex-acc (src at j n acc)
        (if (eq j n) acc
            (dct-piece-hex-acc src at (add j 1) n
                (str_concat acc (dct-bhex (gmt-token-byte src at j))))))
    (defn dct-piece-hex (src id)
        (do (let at (gmt-token-off src id))
            (dct-piece-hex-acc src at 0 (gmt-token-len src at) "")))
    (defn dct-placeholder-hex (id)
        (str_concat
            "3cefbd9c706c616365e29681686f6c646572e296816e6fe29681"
            (str_concat (dct-bhex (add 48 (sub id 128000))) "efbd9c3e")))
    (defn dct-reserved-control? (src id)
        (if (if (ge id 128000) (le id 128999) 0)
            (if (eq (dct-artifact-type src id) 3)
                (str_eq (dct-piece-hex src id) (dct-placeholder-hex id))
                0)
            0))

    ; Stable manifest rows: (meaning id wire underlying-reserved-piece).
    (defn dct-manifest ()
        (list
            (list "NIL" 128000 "<BMF:NIL>" "<｜place▁holder▁no▁0｜>")
            (list "CUT" 128001 "<BMF:CUT>" "<｜place▁holder▁no▁1｜>")
            (list "FAIL" 128002 "<BMF:FAIL>" "<｜place▁holder▁no▁2｜>")
            (list "TIMEOUT" 128003 "<BMF:TIMEOUT>" "<｜place▁holder▁no▁3｜>")
            (list "CHOICE" 128004 "<BMF:CHOICE>" "<｜place▁holder▁no▁4｜>")))

    (defn dct-all-safe? (src rows)
        (if (eq (len rows) 0) 1
            (if (dct-reserved-control? src (nth (head rows) 1))
                (dct-all-safe? src (tail rows))
                0)))
    0)
