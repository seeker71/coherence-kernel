; living-world-tissue-prediction.fk -- admitted tissue may risk a local future.
;
; A newly offered target carries a before-cell, optional live context, optional
; alternatives, optional unknowable remainder, optional choice, and optional
; sender-authored timeout. An admitted contextual tissue then executes every
; distinct member Recipe through the existing bounded Form-native evaluator.
; A target may also carry an offered parameter environment.  Every member sees
; that same exact binding tissue, so admitted behavior can meet genuinely new
; cells without a host-side substitution layer or a representative Recipe.
; No Recipe is selected as a representative. If all native outputs agree, the
; prediction is CONSENSUS; if they differ, it is BRANCH; inability to execute or
; insufficient consent is OPEN.
;
; A later observation is another offered cell. Independent recurrence may
; become an admitted experience, but never retroactively edits the prediction.
; Current experiences participate in the next prediction. A confirmed output
; strengthens the same branch; a mismatch makes the next prediction branch
; instead of repeating the old answer. Revocation removes that experience from
; current prediction while preserving every historical cell.
;
; No domain vocabulary, answer set, remote oracle, representative Recipe, or
; hidden score enters this path. The finite evaluator interface is executable
; substrate only.
;
; witnessed: 2026-08-07 -> legacy prediction and parameter-tissue bands 32767
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-intention-graph.fk form-stdlib/living-world-recipe-transformation.fk form-stdlib/living-world-transformation-nursery.fk form-stdlib/living-world-behavioral-species.fk form-stdlib/living-world-contextual-species.fk

(let LWTP-TARGET              (bp "LWTP-TARGET"))
(let LWTP-FLOW                (bp "LWTP-FLOW"))
(let LWTP-EXECUTION           (bp "LWTP-EXECUTION"))
(let LWTP-DERIVATION          (bp "LWTP-DERIVATION"))
(let LWTP-PREDICTION          (bp "LWTP-PREDICTION"))
(let LWTP-CONSENSUS           (bp "LWTP-CONSENSUS"))
(let LWTP-BRANCH              (bp "LWTP-BRANCH"))
(let LWTP-OPEN                (bp "LWTP-OPEN"))
(let LWTP-PREDICTION-ORIGIN   (bp "LWTP-PREDICTION-ORIGIN"))
(let LWTP-OBSERVATION         (bp "LWTP-OBSERVATION"))
(let LWTP-EXPERIENCE          (bp "LWTP-EXPERIENCE"))
(let LWTP-CONFIRM             (bp "LWTP-CONFIRM"))
(let LWTP-DIVERGE             (bp "LWTP-DIVERGE"))
(let LWTP-WAIT                (bp "LWTP-WAIT"))
(let LWTP-RETURN              (bp "LWTP-RETURN"))
(let LWTP-EXPERIENCE-ORIGIN   (bp "LWTP-EXPERIENCE-ORIGIN"))

(defn lwtp-state (kind) (intern_node kind (empty)))
(defn lwtp-consensus () (lwtp-state LWTP-CONSENSUS))
(defn lwtp-branch () (lwtp-state LWTP-BRANCH))
(defn lwtp-open () (lwtp-state LWTP-OPEN))
(defn lwtp-consensus? (status)
    (if (node_eq status (lwtp-consensus)) 1 0))
(defn lwtp-branch? (status)
    (if (node_eq status (lwtp-branch)) 1 0))
(defn lwtp-open? (status)
    (if (node_eq status (lwtp-open)) 1 0))
(defn lwtp-confirm () (lwtp-state LWTP-CONFIRM))
(defn lwtp-diverge () (lwtp-state LWTP-DIVERGE))
(defn lwtp-wait () (lwtp-state LWTP-WAIT))
(defn lwtp-return () (lwtp-state LWTP-RETURN))
(defn lwtp-confirm? (status)
    (if (node_eq status (lwtp-confirm)) 1 0))
(defn lwtp-diverge? (status)
    (if (node_eq status (lwtp-diverge)) 1 0))
(defn lwtp-wait? (status)
    (if (node_eq status (lwtp-wait)) 1 0))

; --- separately offered future target ----------------------------------

; children: exact before cell, optional live declaration, alternatives,
; optional unknowable remainder, optional choice, optional timeout, evidence,
; local path
(defn lwtp-target
    (before context alternatives unknown choice timeout evidence)
    (intern_node LWTP-TARGET
        (list before context alternatives unknown choice timeout evidence
              (lwo-local-path))))
(defn lwtp-bound-target
    (before context alternatives unknown choice timeout evidence bindings)
    (intern_node LWTP-TARGET
        (list before context alternatives unknown choice timeout evidence
              bindings (lwo-local-path))))
(defn lwtp-target? (cell) (lwo-category? cell LWTP-TARGET))
(defn lwtp-target-before (target) (nth (node_children target) 0))
(defn lwtp-target-context (target) (nth (node_children target) 1))
(defn lwtp-target-alternatives (target) (nth (node_children target) 2))
(defn lwtp-target-unknown (target) (nth (node_children target) 3))
(defn lwtp-target-choice (target) (nth (node_children target) 4))
(defn lwtp-target-timeout (target) (nth (node_children target) 5))
(defn lwtp-target-evidence (target) (nth (node_children target) 6))
(defn lwtp-target-bindings (target)
    (if (eq (len (node_children target)) 8) (lwre-empty-bindings)
        (nth (node_children target) 7)))
(defn lwtp-target-path (target)
    (if (eq (len (node_children target)) 8)
        (nth (node_children target) 7)
        (nth (node_children target) 8)))
(defn lwtp-optional-timeout-valid? (timeout)
    (if (node_eq timeout (lwo-none)) 1
        (oac-timeout-valid? timeout)))
(defn lwtp-target-valid? (target)
    (if (eq (lwtp-target? target) 0) 0
        (do
            (let context (lwtp-target-context target))
            (if (and (or (node_eq context (lwo-none))
                         (eq (lwlc-declaration-valid? context) 1))
                     (and (eq (lwo-category?
                                  (lwtp-target-alternatives target)
                                  LWO-FIELD) 1)
                          (and (eq (lwac-optional-unknown-valid?
                                      (lwtp-target-unknown target)) 1)
                               (and (eq (lwlc-choice-valid?
                                          (lwtp-target-choice target)) 1)
                                    (and (eq (lwtp-optional-timeout-valid?
                                              (lwtp-target-timeout target)) 1)
                                         (eq (lwre-bindings-valid?
                                               (lwtp-target-bindings target))
                                             1))))))
                1 0))))
(defn lwtp-target-current? (world target)
    (if (and (eq (lwtp-target-valid? target) 1)
             (and (eq (lwo-active? world target) 1)
                  (and (eq (lwo-active?
                              world (lwtp-target-before target)) 1)
                       (and (eq (lwcs-context-current?
                                  world (lwtp-target-context target)) 1)
                            (eq (lwre-bindings-current?
                                  world
                                  (lwtp-target-bindings target)) 1))))) 1 0))
(defn lwtp-target-sources (world target)
    (lwt-sources-from-attributions
        (lwo-field-items
            (lwo-active-attributions-for world target))
        (lwo-empty-field)))
(defn lwtp-target-time-for (target observed-time)
    (do
        (let timeout (lwtp-target-timeout target))
        (if (node_eq timeout (lwo-none)) (lwo-none)
            (if (node_eq observed-time (lwo-none)) (lwo-none)
                (oac-timeout-condense timeout observed-time)))))
(defn lwtp-target-time-open? (target observed-time)
    (do
        (let timeout (lwtp-target-timeout target))
        (if (node_eq timeout (lwo-none)) 1
            (if (node_eq observed-time (lwo-none)) 0
                (if (eq (oac-time-pending?
                            (lwtp-target-time-for target observed-time)) 1)
                    1 0)))))

; --- execute every member Recipe ---------------------------------------

(defn lwtp-receipt-recipe (receipt) (lwbs-receipt-recipe receipt))
(defn lwtp-recipes-from-receipts-items (items field)
    (if (eq (len items) 0) field
        (lwtp-recipes-from-receipts-items (tail items)
            (lwo-field-add field
                (lwtp-receipt-recipe (head items))))))
(defn lwtp-recipes-from-receipts (receipts)
    (lwtp-recipes-from-receipts-items
        (lwo-field-items receipts) (lwo-empty-field)))
(defn lwtp-flow (target receipt)
    (intern_node LWTP-FLOW (list target receipt (lwo-local-path))))

; children: exact receipt, Recipe/declaration/lens, native trace, exact output,
; local path
(defn lwtp-execution
    (receipt recipe declaration lens trace output)
    (intern_node LWTP-EXECUTION
        (list receipt recipe declaration lens trace output
              (lwo-local-path))))
(defn lwtp-execution? (cell) (lwo-category? cell LWTP-EXECUTION))
(defn lwtp-execution-receipt (execution) (nth (node_children execution) 0))
(defn lwtp-execution-recipe (execution) (nth (node_children execution) 1))
(defn lwtp-execution-declaration (execution) (nth (node_children execution) 2))
(defn lwtp-execution-lens (execution) (nth (node_children execution) 3))
(defn lwtp-execution-trace (execution) (nth (node_children execution) 4))
(defn lwtp-execution-output (execution) (nth (node_children execution) 5))
(defn lwtp-execution-path (execution) (nth (node_children execution) 6))
(defn lwtp-execution-for (world target receipt recipes)
    (if (eq (lwbs-receipt-current? world receipt) 0) (lwo-none)
        (do
            (let trial
                (lwo-emergent-shape (lwbs-receipt-trial receipt)))
            (let candidate (lwtn-trial-candidate trial))
            (let recipe (lwtn-candidate-recipe candidate))
            (let declaration (lwtn-candidate-declaration candidate))
            (let lens (lwtn-candidate-lens candidate))
            (let flow (lwtp-flow target receipt))
            (let trace
                (lwre-execute-bound world declaration lens
                    (lwtp-target-before target)
                    (lwtp-target-bindings target) recipes
                    (lwtp-target-unknown target)
                    (lwtp-target-choice target) flow flow
                    (lwtp-target-evidence target)))
            (if (node_eq trace (lwo-none)) (lwo-none)
                (lwtp-execution receipt recipe declaration lens trace
                    (lwre-result-primary (lwre-trace-result trace)))))))
(defn lwtp-executions-for-receipts-items
    (world target receipts recipes field)
    (if (eq (len receipts) 0) field
        (do
            (let execution
                (lwtp-execution-for world target (head receipts) recipes))
            (lwtp-executions-for-receipts-items world target (tail receipts)
                recipes
                (if (node_eq execution (lwo-none)) field
                    (lwo-field-add field execution))))))
(defn lwtp-executions-for-receipts (world target receipts recipes)
    (lwtp-executions-for-receipts-items world target
        (lwo-field-items receipts) recipes (lwo-empty-field)))
(defn lwtp-execution-outputs-items (items field)
    (if (eq (len items) 0) field
        (lwtp-execution-outputs-items (tail items)
            (lwo-field-add field
                (lwtp-execution-output (head items))))))
(defn lwtp-execution-outputs (executions)
    (lwtp-execution-outputs-items
        (lwo-field-items executions) (lwo-empty-field)))
(defn lwtp-executions-current? (world items)
    (if (eq (len items) 0) 1
        (if (and (eq (lwtp-execution? (head items)) 1)
                 (eq (lwre-trace-current?
                         world (lwtp-execution-trace (head items))) 1))
            (lwtp-executions-current? world (tail items)) 0)))
(defn lwtp-execution-witnesses-items (items field)
    (if (eq (len items) 0) field
        (lwtp-execution-witnesses-items (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwre-trace-witnesses
                        (lwtp-execution-trace (head items)))) field))))

; --- admitted experiences feed later predictions -----------------------

(defn lwtp-experience? (cell) (lwo-category? cell LWTP-EXPERIENCE))
(defn lwtp-experience-prediction (experience) (nth (node_children experience) 0))
(defn lwtp-experience-target (experience) (nth (node_children experience) 1))
(defn lwtp-experience-observed (experience) (nth (node_children experience) 2))
(defn lwtp-experience-comparison (experience) (nth (node_children experience) 3))
(defn lwtp-experience-state (experience) (nth (node_children experience) 4))
(defn lwtp-experience-observation-evidence (experience)
    (nth (node_children experience) 5))
(defn lwtp-experience-alternatives (experience) (nth (node_children experience) 6))
(defn lwtp-experience-unknowns (experience) (nth (node_children experience) 7))
(defn lwtp-experience-witnesses (experience) (nth (node_children experience) 8))
(defn lwtp-experience-path (experience) (nth (node_children experience) 9))

(defn lwtp-experience-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwtp-experience?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

; --- prospective prediction --------------------------------------------

(defn lwtp-derivation
    (receipts executions experiences recipe-outputs experience-outputs
     combined-outputs)
    (intern_node LWTP-DERIVATION
        (list receipts executions experiences recipe-outputs
              experience-outputs combined-outputs (lwo-local-path))))
(defn lwtp-derivation? (cell) (lwo-category? cell LWTP-DERIVATION))
(defn lwtp-derivation-receipts (derivation) (nth (node_children derivation) 0))
(defn lwtp-derivation-executions (derivation) (nth (node_children derivation) 1))
(defn lwtp-derivation-experiences (derivation) (nth (node_children derivation) 2))
(defn lwtp-derivation-recipe-outputs (derivation) (nth (node_children derivation) 3))
(defn lwtp-derivation-experience-outputs (derivation) (nth (node_children derivation) 4))
(defn lwtp-derivation-combined-outputs (derivation) (nth (node_children derivation) 5))
(defn lwtp-derivation-path (derivation) (nth (node_children derivation) 6))

; children: admitted tissue, offered target, exact Recipes/executions,
; current experiences, recipe/experience/combined outputs, state, optional
; single prediction, alternatives, unknowns, time observation, derivation,
; local path
(defn lwtp-prediction
    (tissue target recipes executions experiences recipe-outputs
     experience-outputs combined-outputs status predicted alternatives
     unknowns time derivation)
    (intern_node LWTP-PREDICTION
        (list tissue target recipes executions experiences recipe-outputs
              experience-outputs combined-outputs status predicted
              alternatives unknowns time derivation (lwo-local-path))))
(defn lwtp-prediction? (cell) (lwo-category? cell LWTP-PREDICTION))
(defn lwtp-prediction-tissue (prediction) (nth (node_children prediction) 0))
(defn lwtp-prediction-target (prediction) (nth (node_children prediction) 1))
(defn lwtp-prediction-recipes (prediction) (nth (node_children prediction) 2))
(defn lwtp-prediction-executions (prediction) (nth (node_children prediction) 3))
(defn lwtp-prediction-experiences (prediction) (nth (node_children prediction) 4))
(defn lwtp-prediction-recipe-outputs (prediction) (nth (node_children prediction) 5))
(defn lwtp-prediction-experience-outputs (prediction) (nth (node_children prediction) 6))
(defn lwtp-prediction-combined-outputs (prediction) (nth (node_children prediction) 7))
(defn lwtp-prediction-status (prediction) (nth (node_children prediction) 8))
(defn lwtp-prediction-predicted (prediction) (nth (node_children prediction) 9))
(defn lwtp-prediction-alternatives (prediction) (nth (node_children prediction) 10))
(defn lwtp-prediction-unknowns (prediction) (nth (node_children prediction) 11))
(defn lwtp-prediction-time (prediction) (nth (node_children prediction) 12))
(defn lwtp-prediction-derivation (prediction) (nth (node_children prediction) 13))
(defn lwtp-prediction-path (prediction) (nth (node_children prediction) 14))

(defn lwtp-prediction-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwtp-prediction?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

; Experience usability is deliberately local and non-circular: all exact
; witnesses must still be active.  Exact proposal-current equality remains
; the stronger admission check below, after the experience recipe exists.
(defn lwtp-experience-candidate-usable? (world candidate)
    (if (and (eq (lwtp-experience-candidate? candidate) 1)
             (and (eq (lwo-active? world candidate) 1)
                  (eq (lwo-all-active? world
                        (lwo-field-items
                          (lwo-emergent-witnesses candidate))) 1))) 1 0))
(defn lwtp-current-experiences-items
    (world items tissue target field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (if (and (eq (lwtp-experience-candidate-usable?
                              world candidate) 1)
                     (do
                         (let experience (lwo-emergent-shape candidate))
                         (if (and
                              (node_eq
                                (lwtp-experience-target experience) target)
                              (node_eq
                                (lwtp-prediction-tissue
                                  (lwo-emergent-shape
                                    (lwtp-experience-prediction experience)))
                                tissue)) 1 0)))
                (lwtp-current-experiences-items world (tail items)
                    tissue target (lwo-field-add field candidate))
                (lwtp-current-experiences-items world (tail items)
                    tissue target field)))))
(defn lwtp-current-experiences (world tissue target)
    (lwtp-current-experiences-items world
        (lwo-field-items (lwo-world-cells world)) tissue target
        (lwo-empty-field)))
(defn lwtp-experience-outputs-items (items field)
    (if (eq (len items) 0) field
        (do
            (let experience (lwo-emergent-shape (head items)))
            (let observed (lwtp-experience-observed experience))
            (lwtp-experience-outputs-items (tail items)
                (if (node_eq observed (lwo-none)) field
                    (lwo-field-add field observed))))))
(defn lwtp-experience-outputs (experiences)
    (lwtp-experience-outputs-items
        (lwo-field-items experiences) (lwo-empty-field)))

(defn lwtp-experience-candidates-usable? (world items)
    (if (eq (len items) 0) 1
        (if (eq (lwtp-experience-candidate-usable?
                    world (head items)) 1)
            (lwtp-experience-candidates-usable? world (tail items)) 0)))
(defn lwtp-prediction-historical-valid? (world candidate)
    (if (eq (lwtp-prediction-candidate? candidate) 0) 0
        (do
            (let prediction (lwo-emergent-shape candidate))
            (if (and (eq (lwo-active? world candidate) 1)
                     (and (eq (lwcs-tissue-integrated-current?
                                  world
                                  (lwtp-prediction-tissue prediction)) 1)
                          (and (eq (lwtp-target-current?
                                      world
                                      (lwtp-prediction-target prediction)) 1)
                               (and (eq (lwtp-executions-current? world
                                           (lwo-field-items
                                             (lwtp-prediction-executions
                                               prediction))) 1)
                                    (and (eq
                                          (lwtp-experience-candidates-usable?
                                            world
                                            (lwo-field-items
                                              (lwtp-prediction-experiences
                                                prediction))) 1)
                                         (eq (lwo-all-active? world
                                               (lwo-field-items
                                                 (lwo-emergent-witnesses
                                                   candidate))) 1)))))) 1 0))))

(defn lwtp-experience-candidate-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (lwtp-experience-candidate-witnesses-items world (tail items)
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world (head items)))
                (lwac-field-union-items
                    (lwo-field-items
                        (lwo-emergent-witnesses (head items))) field)))))
(defn lwtp-prediction-witnesses
    (world tissue target executions experiences)
    (do
        (let with-tissue
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world tissue))
                (lwo-empty-field)))
        (let with-target
            (lwac-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world target))
                with-tissue))
        (let with-context
            (lwac-field-union-items
                (lwo-field-items
                    (lwcs-context-witnesses
                        world (lwtp-target-context target)))
                with-target))
        (let with-executions
            (lwtp-execution-witnesses-items
                (lwo-field-items executions) with-context))
        (lwtp-experience-candidate-witnesses-items world
            (lwo-field-items experiences) with-executions)))
(defn lwtp-prediction-alternatives-for
    (target recipes combined-outputs)
    (lwac-field-union-items
        (lwo-field-items combined-outputs)
        (lwac-field-union-items
            (lwo-field-items recipes)
            (lwtp-target-alternatives target))))
(defn lwtp-prediction-unknowns-for (target status combined-outputs)
    (do
        (let unknown (lwtp-target-unknown target))
        (let field
            (if (node_eq unknown (lwo-none)) (lwo-empty-field)
                (lwo-field-add (lwo-empty-field) unknown)))
        (if (eq (lwtp-consensus? status) 1) field
            (lwo-field-add field (lwlc-unknown combined-outputs)))))
(defn lwtp-prediction-for
    (world tissue target target-threshold observed-time)
    (if (or (eq (lwcs-tissue-integrated-current? world tissue) 0)
            (or (eq (lwtp-target-current? world target) 0)
                (lt (lwo-field-size
                        (lwtp-target-sources world target))
                    target-threshold)))
        (lwo-none)
        (do
            (let component
                (lwcs-tissue-component (lwo-emergent-shape tissue)))
            (let receipts (lwcs-component-receipts component))
            (let recipes (lwtp-recipes-from-receipts receipts))
            (let executions
                (lwtp-executions-for-receipts
                    world target receipts recipes))
            (let experiences
                (lwtp-current-experiences world tissue target))
            (let recipe-outputs (lwtp-execution-outputs executions))
            (let experience-outputs
                (lwtp-experience-outputs experiences))
            (let combined-outputs
                (lwac-field-union-items
                    (lwo-field-items experience-outputs) recipe-outputs))
            (let output-count (lwo-field-size combined-outputs))
            (let all-executed
                (if (eq (lwo-field-size executions)
                        (lwo-field-size recipes)) 1 0))
            (let time-open
                (lwtp-target-time-open? target observed-time))
            (let status
                (if (or (le target-threshold 0)
                        (or (eq all-executed 0)
                            (or (eq time-open 0)
                                (eq output-count 0))))
                    (lwtp-open)
                    (if (eq output-count 1)
                        (lwtp-consensus) (lwtp-branch))))
            (let predicted
                (if (eq (lwtp-consensus? status) 1)
                    (head (lwo-field-items combined-outputs))
                    (lwo-none)))
            (let derivation
                (lwtp-derivation receipts executions experiences
                    recipe-outputs experience-outputs combined-outputs))
            (lwtp-prediction tissue target recipes executions experiences
                recipe-outputs experience-outputs combined-outputs status
                predicted
                (lwtp-prediction-alternatives-for
                    target recipes combined-outputs)
                (lwtp-prediction-unknowns-for
                    target status combined-outputs)
                (lwtp-target-time-for target observed-time) derivation))))
(defn lwtp-prediction-origin
    (tissue target target-threshold observed-time)
    (intern_node LWTP-PREDICTION-ORIGIN
        (list tissue target (intern_trivial_int target-threshold)
              observed-time (lwo-local-path))))
(defn lwtp-prediction-origin-tissue (origin) (nth (node_children origin) 0))
(defn lwtp-prediction-origin-target (origin) (nth (node_children origin) 1))
(defn lwtp-prediction-origin-threshold (origin)
    (node_value (nth (node_children origin) 2)))
(defn lwtp-prediction-origin-time (origin) (nth (node_children origin) 3))
(defn lwtp-prediction-proposal
    (world tissue target target-threshold observed-time)
    (do
        (let prediction
            (lwtp-prediction-for
                world tissue target target-threshold observed-time))
        (if (or (node_eq prediction (lwo-none))
                (eq (lwtp-open? (lwtp-prediction-status prediction)) 1))
            (lwo-none)
            (do
                (let witnesses
                    (lwtp-prediction-witnesses world tissue target
                        (lwtp-prediction-executions prediction)
                        (lwtp-prediction-experiences prediction)))
                (let count (lwo-field-size witnesses))
                (let origin
                    (lwtp-prediction-origin tissue target
                        target-threshold observed-time))
                (let candidate
                    (lwo-emergent prediction witnesses
                        (intern_trivial_int
                            (lwo-field-size
                                (lwtp-prediction-recipes prediction)))
                        (intern_trivial_int
                            (lwo-field-size
                                (lwtp-prediction-combined-outputs prediction)))
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwtp-prediction-candidate-current? (world candidate)
    (if (eq (lwtp-prediction-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwtp-prediction-proposal world
                    (lwtp-prediction-origin-tissue origin)
                    (lwtp-prediction-origin-target origin)
                    (lwtp-prediction-origin-threshold origin)
                    (lwtp-prediction-origin-time origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwtp-prediction-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwtp-prediction-candidate-current?
                    world candidate) 1)) 1 0))
(defn lwtp-prediction-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwtp-prediction-candidate-current?
            world (lwt-proposal-candidate proposal))))
(defn lwtp-prediction-integrate (round proposal action)
    (if (eq (lwtp-prediction-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- later observation and experience ----------------------------------

; children: exact integrated prediction, optional observed output, ack,
; alternatives, optional unknown, observed time, offered evidence, local path
(defn lwtp-observation
    (prediction observed ack alternatives unknown observed-time evidence)
    (intern_node LWTP-OBSERVATION
        (list prediction observed ack alternatives unknown observed-time
              evidence (lwo-local-path))))
(defn lwtp-observation? (cell) (lwo-category? cell LWTP-OBSERVATION))
(defn lwtp-observation-prediction (observation) (nth (node_children observation) 0))
(defn lwtp-observation-observed (observation) (nth (node_children observation) 1))
(defn lwtp-observation-ack (observation) (nth (node_children observation) 2))
(defn lwtp-observation-alternatives (observation) (nth (node_children observation) 3))
(defn lwtp-observation-unknown (observation) (nth (node_children observation) 4))
(defn lwtp-observation-time (observation) (nth (node_children observation) 5))
(defn lwtp-observation-evidence (observation) (nth (node_children observation) 6))
(defn lwtp-observation-path (observation) (nth (node_children observation) 7))
(defn lwtp-observation-time-valid? (observation)
    (do
        (let prediction
            (lwo-emergent-shape
                (lwtp-observation-prediction observation)))
        (let timeout
            (lwtp-target-timeout
                (lwtp-prediction-target prediction)))
        (let observed-time (lwtp-observation-time observation))
        (if (node_eq timeout (lwo-none))
            (if (node_eq observed-time (lwo-none)) 1 0)
            (if (node_eq observed-time (lwo-none)) 0
                (oac-time-pending?
                    (oac-timeout-condense timeout observed-time))))))
(defn lwtp-observation-ack-coherent? (observation)
    (do
        (let prediction
            (lwo-emergent-shape
                (lwtp-observation-prediction observation)))
        (let predicted (lwtp-prediction-predicted prediction))
        (let observed (lwtp-observation-observed observation))
        (let ack (lwtp-observation-ack observation))
        (if (eq (oac-one? ack) 1)
            (if (and (not (node_eq predicted (lwo-none)))
                     (and (node_eq observed predicted)
                          (node_eq (oac-payload ack) predicted))) 1 0)
            (if (eq (oac-zero? ack) 1)
                (if (and (not (node_eq predicted (lwo-none)))
                         (and (not (node_eq observed (lwo-none)))
                              (not (node_eq observed predicted)))) 1 0)
                (if (eq (oac-nothing? ack) 1)
                    (if (node_eq observed (lwo-none)) 1 0)
                    (if (eq (oac-alternative-ack? ack) 1)
                        (if (and (node_eq
                                  (oac-alternative-reference
                                    (oac-payload ack)) predicted)
                                 (node_eq
                                  (oac-alternative-offered
                                    (oac-payload ack)) observed)) 1 0)
                        (if (eq (oac-node? ack) 1)
                            (node_eq (oac-payload ack) observed) 0)))))))
(defn lwtp-observation-valid? (observation)
    (if (eq (lwtp-observation? observation) 0) 0
        (if (and (eq (lwtp-prediction-candidate?
                         (lwtp-observation-prediction observation)) 1)
                 (and (eq (oac-valid-ack?
                              (lwtp-observation-ack observation)) 1)
                      (and (eq (lwo-category?
                                  (lwtp-observation-alternatives observation)
                                  LWO-FIELD) 1)
                           (and (eq (lwac-optional-unknown-valid?
                                      (lwtp-observation-unknown observation)) 1)
                                (and (eq (lwtp-observation-time-valid?
                                          observation) 1)
                                     (eq (lwtp-observation-ack-coherent?
                                           observation) 1)))))) 1 0)))
(defn lwtp-observation-independent-items
    (world items prediction field)
    (if (eq (len items) 0) field
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (lwtp-observation-independent-items world (tail items) prediction
                (if (eq (lwo-active-by? world prediction source) 1) field
                    (lwo-field-add field attribution))))))
(defn lwtp-observation-independent-attributions (world observation)
    (lwtp-observation-independent-items world
        (lwo-field-items
            (lwo-active-attributions-for world observation))
        (lwtp-observation-prediction observation) (lwo-empty-field)))
(defn lwtp-observation-independent-sources (world observation)
    (lwt-sources-from-attributions
        (lwo-field-items
            (lwtp-observation-independent-attributions world observation))
        (lwo-empty-field)))
(defn lwtp-experience-state-for (ack)
    (if (eq (oac-one? ack) 1) (lwtp-confirm)
        (if (or (eq (oac-zero? ack) 1)
                (eq (oac-alternative-ack? ack) 1))
            (lwtp-diverge)
            (if (eq (oac-nothing? ack) 1)
                (lwtp-wait) (lwtp-return)))))
(defn lwtp-experience-alternatives-for (prediction observation)
    (do
        (let base
            (lwac-field-union-items
                (lwo-field-items
                    (lwtp-observation-alternatives observation))
                (lwtp-prediction-alternatives prediction)))
        (let observed (lwtp-observation-observed observation))
        (if (node_eq observed (lwo-none)) base
            (lwo-field-add base observed))))
(defn lwtp-experience-unknowns-for (prediction observation)
    (do
        (let unknown (lwtp-observation-unknown observation))
        (let base (lwtp-prediction-unknowns prediction))
        (if (node_eq unknown (lwo-none)) base
            (lwo-field-add base unknown))))
(defn lwtp-experience-witnesses-for (world prediction observation)
    (lwac-field-union-items
        (lwo-field-items
            (lwtp-observation-independent-attributions world observation))
        (lwac-field-union-items
            (lwo-field-items (lwo-emergent-witnesses prediction))
            (lwo-active-attributions-for world prediction))))
(defn lwtp-experience
    (prediction target observed comparison state observation-evidence
     alternatives unknowns witnesses)
    (intern_node LWTP-EXPERIENCE
        (list prediction target observed comparison state observation-evidence
              alternatives unknowns witnesses (lwo-local-path))))
(defn lwtp-experience-for (world observation threshold)
    (if (or (eq (lwtp-observation-valid? observation) 0)
            (le threshold 0)) (lwo-none)
        (do
            (let prediction-candidate
                (lwtp-observation-prediction observation))
            (let sources
                (lwtp-observation-independent-sources world observation))
            (if (or (eq (lwtp-prediction-historical-valid?
                            world prediction-candidate) 0)
                    (or (eq (lwo-active? world observation) 0)
                        (lt (lwo-field-size sources) threshold)))
                (lwo-none)
                (do
                    (let prediction
                        (lwo-emergent-shape prediction-candidate))
                    (let ack (lwtp-observation-ack observation))
                    (lwtp-experience prediction-candidate
                        (lwtp-prediction-target prediction)
                        (lwtp-observation-observed observation) ack
                        (lwtp-experience-state-for ack)
                        (lwtp-observation-independent-attributions
                            world observation)
                        (lwtp-experience-alternatives-for
                            prediction observation)
                        (lwtp-experience-unknowns-for
                            prediction observation)
                        (lwtp-experience-witnesses-for
                            world prediction-candidate observation)))))))
(defn lwtp-experience-origin (observation threshold)
    (intern_node LWTP-EXPERIENCE-ORIGIN
        (list observation (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwtp-experience-origin-observation (origin)
    (nth (node_children origin) 0))
(defn lwtp-experience-origin-threshold (origin)
    (node_value (nth (node_children origin) 1)))
(defn lwtp-experience-proposal (world observation threshold)
    (do
        (let experience (lwtp-experience-for world observation threshold))
        (if (node_eq experience (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwtp-experience-witnesses experience))
                (let count (lwo-field-size witnesses))
                (let origin (lwtp-experience-origin observation threshold))
                (let candidate
                    (lwo-emergent experience witnesses
                        (intern_trivial_int
                            (lwo-field-size
                                (lwtp-experience-observation-evidence
                                    experience)))
                        (intern_trivial_int 1)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwtp-experience-candidate-current? (world candidate)
    (if (eq (lwtp-experience-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwtp-experience-proposal world
                    (lwtp-experience-origin-observation origin)
                    (lwtp-experience-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwtp-experience-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwtp-experience-candidate-current?
                    world candidate) 1)) 1 0))
(defn lwtp-experience-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (lwtp-experience-candidate-current?
            world (lwt-proposal-candidate proposal))))
(defn lwtp-experience-integrate (round proposal action)
    (if (eq (lwtp-experience-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
