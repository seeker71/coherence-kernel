//////////////////////////////////////////////////////////////////////
//
// native-model-route-table.bml
//
// Executable BML. The NATIVE-MODEL ROUTE TABLE: every LOCAL_MODEL_ROUTE
// name form/scripts/native_model_route.sh accepts, as rows of data —
// which door it carries the ask through, and the threshold that door
// needs (a step count for the direct-Metal door; nothing for the two
// ollama-carried routes, whose model identity IS their data). The shell
// carrier keeps only the host boundary a shell invocation is FOR: reading
// $LOCAL_MODEL_ROUTE from the environment, and (for the direct-Metal
// door) reading $FORM_METAL_STEPS as an override of this table's default.
// Which route names exist, which door each resolves to, and the
// ${FORM_METAL_STEPS:-12} default itself are read off this table, never
// hand-coded in a shell `case`.
//
// Checked against form/scripts/native_model_route.sh 2026-09-03: three
// kinds of body follow a resolved route --
//   direct-metal        execs the door script with (steps, prompt); no
//                        socket, HTTP, JSON, Ollama, or llama.cpp between
//                        the ask and the model.
//   ollama-compare       continues into the shared ollama comparator body
//                        already in the shell carrier, keyed by ollama
//                        model name and the registered-model id the
//                        ledger records the event under.
//   challenger-carrier    same ollama comparator body, but first runs its
//                        own verify door (nanbeige_gguf_verify.sh) and
//                        refuses the ask if that door does not admit the
//                        package. The verify door itself is untouched by
//                        this table — only its path is named as data.
//
// preludes: form-stdlib/core.fk form-stdlib/table.bml
//
// Proven by: form-stdlib/tests/native-model-route-table-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelRouteTable {
        thought native-model-route-table-pattern = list("routes-are-rows", "door-and-threshold-are-data", "unknown-route-is-typed", "no-case-statement-in-shell");

        def nmrt-row(name, kind, door, steps, model, registeredModel) = list(name, kind, door, steps, model, registeredModel);
        def nmrt-name(r) = nth(r, 0);
        def nmrt-kind(r) = nth(r, 1);
        def nmrt-door(r) = nth(r, 2);
        def nmrt-steps(r) = nth(r, 3);
        def nmrt-model(r) = nth(r, 4);
        def nmrt-registered-model(r) = nth(r, 5);

        // Every route name the shell carrier accepts, one row each. Two
        // names carry the same direct-Metal door (form-metal is the
        // short name, llama32.form-metal names the model explicitly);
        // both share the one step-count default.
        def nmrt-table() = list(
            nmrt-row("form-metal", "direct-metal", "form/native/metal/metal_ask.sh", 12, "", ""),
            nmrt-row("llama32.form-metal", "direct-metal", "form/native/metal/metal_ask.sh", 12, "", ""),
            nmrt-row("ollama-llama32", "ollama-compare", "", 0, "llama3.2:3b", "base.llama32-3b-local"),
            nmrt-row("nanbeige42", "challenger-carrier", "form/scripts/nanbeige_gguf_verify.sh", 0, "nanbeige42-local:Q4_K_M", "challenger.nanbeige42-3b-local"));

        def nmrt-none() = nmrt-row("", "unknown", "", 0, "", "");
        def nmrt-name-is?(r, name) = if str_eq(nmrt-name(r), name) then 1 else 0;
        def nmrt-or-none(r) = if eq(len(r), 0) then nmrt-none() else r;
        def nmrt-find(name) = nmrt-or-none(tb-find2(nmrt-table(), nmrt-name-is?, name));
        def nmrt-known?(name) = if eq(str_len(nmrt-name(nmrt-find(name))), 0) then 0 else 1;
        def nmrt-known-names() = tb-join(nmrt-table(), nmrt-name, ", ");
    }
    0;
}
