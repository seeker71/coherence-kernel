// Route names, request doors, token defaults and model identities are Form data.
// Direct Metal invokes the native file-input request door in the same fkwu
// that performs generation. The other two kinds are explicit comparator
// carriers; the challenger additionally requires its package verification.
// Current interface and migration boundaries: docs/native-metal-ask.md.
// preludes: form-stdlib/core.fk form-stdlib/table.bml
// Proven by: form-stdlib/tests/native-model-route-table-band.fk

section [form.bml] {
    class NativeModelRouteTable {
        thought native-model-route-table-pattern = list("routes-are-rows", "door-and-threshold-are-data", "unknown-route-is-typed", "no-case-statement-in-shell");

        def nmrt-row(name, kind, door, steps, model, registeredModel) = list(name, kind, door, steps, model, registeredModel);
        def nmrt-name(r) = nth(r, 0);
        def nmrt-kind(r) = nth(r, 1);
        def nmrt-door(r) = nth(r, 2);
        def nmrt-steps(r) = nth(r, 3);
        def nmrt-model(r) = nth(r, 4);
        def nmrt-registered-model(r) = nth(r, 5);

        // Both direct-Metal names carry the same native request contract.
        def nmrt-table() = list(
            nmrt-row("form-metal", "direct-metal", "observe/metal-ask-files-run.bml", 12, "llama3.2:3b", "base.llama32-3b-metal"),
            nmrt-row("llama32.form-metal", "direct-metal", "observe/metal-ask-files-run.bml", 12, "llama3.2:3b", "base.llama32-3b-metal"),
            nmrt-row("ollama-llama32", "ollama-compare", "", 0, "llama3.2:3b", "base.llama32-3b-local"),
            nmrt-row("nanbeige42", "challenger-carrier", "form/scripts/nanbeige_gguf_verify.sh", 0, "nanbeige42-local:Q4_K_M", "challenger.nanbeige42-3b-local"));

        def nmrt-none() = nmrt-row("", "unknown", "", 0, "", "");
        def nmrt-name-is?(r, name) = if str_eq(nmrt-name(r), name) then 1 else 0;
        def nmrt-or-none(r) = if eq(len(r), 0) then nmrt-none() else r;
        def nmrt-find(name) = nmrt-or-none(tb-find2(nmrt-table(), nmrt-name-is?, name));
        def nmrt-known?(name) = if eq(str_len(nmrt-name(nmrt-find(name))), 0) then 0 else 1;
        def nmrt-known-names() = tb-join(nmrt-table(), nmrt-name, ", ");
    }
    0;
}
