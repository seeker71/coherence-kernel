// Route names, request doors, token defaults and model identities are Form data.
// Every route is direct Metal: the native file-input request door in the same
// fkwu that performs generation. No row reaches a model server.
// Current interface and migration boundaries: docs/native-metal-ask.md.
// preludes: form-stdlib/core.fk form-stdlib/table.bml
// Proven by: form-stdlib/tests/native-model-route-table-band.fk

section [form.bml] {
    class NativeModelRouteTable {
        field NativeRouteDefaultTokens = 12;

        def nmrt-row(name, kind, door, steps, model, registeredModel) = list(name, kind, door, steps, model, registeredModel);
        def nmrt-name(r) = nth(r, 0);
        def nmrt-kind(r) = nth(r, 1);
        def nmrt-door(r) = nth(r, 2);
        def nmrt-steps(r) = nth(r, 3);
        def nmrt-model(r) = nth(r, 4);
        def nmrt-registered-model(r) = nth(r, 5);

        def nmrt-metal(name) = nmrt-row(name,"direct-metal","observe/metal-ask-files-run.bml",NativeRouteDefaultTokens(),"llama3.2:3b","base.llama32-3b-metal");
        def nmrt-table() = list("form-metal","llama32.form-metal") |> map(nmrt-metal);

        def nmrt-none() = nmrt-row("", "unknown", "", 0, "", "");
        def nmrt-find(name) = tb-first(nmrt-table(),r => ((String) nmrt-name(r) == name)) ?? nmrt-none();
        def nmrt-known?(name) = if ((Comparable) str_len(nmrt-name(nmrt-find(name))) == 0) then 0 else 1;
        def nmrt-known-names() = tb-join(nmrt-table(), nmrt-name, ", ");
    }
    0;
}
