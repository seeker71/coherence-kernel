; form-knowledge-public-resident-eval.fk -- two public trials per family.
;
; The public v1 heldout set owns fifteen sealed challenges, one per canonical
; knowledge family.  This cell does not invent fifteen more facts.  It makes
; two independent fresh-stream observations of each public challenge while one
; local model context remains resident: 30 trials, still a 15-family knowledge
; denominator.  The worse trial supplies the family's canonical fkhe score, so
; repetition can lower confidence and can never inflate coverage.
;
; A presentation contains the public prompt and its source/challenge hashes but
; no expected answer or answer hash.  Expected text is reached only after the
; generated bytes have been sealed into fkhe output/score evidence.  The public
; export removes prompt and expected answer text.  It deliberately retains the
; canonical raw generated bytes plus three independently checkable bindings:
; raw-output SHA, a family/challenge/run nonce, and nonce+content SHA.  This
; makes replay observable instead of trusting a supplied digest-shaped string.
;
; Missing telemetry is -1.  A generated `0` or `1` is a present value with its
; own hash-derived bit; neither is `nothing`.  Prose/self-scores have no entry.
;
; This cell is pure.  The dormant physical driver is
; observe/qwen38-public-heldout-30-resident-live-run.fk.
;
; preludes: form-stdlib/form-knowledge-public-family-mastery.fk
; Proven by: form-stdlib/tests/form-knowledge-public-resident-eval-band.fk

(do
    (defn fkp30-lanes () (list "a" "b"))
    (defn fkp30-trial-total () 30)
    (defn fkp30-family-total () (len (fkhe-families)))
    (defn fkp30-basis ()
        "public-v1-sealed-challenge+two-fresh-states+one-local-residence-v1")
    (defn fkp30-bit? (x) (if (or (eq x 0) (eq x 1)) 1 0))
    (defn fkp30-lane? (lane)
        (if (or (str_eq lane "a") (str_eq lane "b")) 1 0))

    (defn fkp30-challenge-sha (row)
        (nmfe-sha256
            (nmfe-fields
                (list "public-heldout-challenge-v1" (fkhe-id row)
                      (fkhe-family row) (fkhe-source-sha row)
                      (nmfe-sha256 (fkhe-prompt row))))))
    (defn fkp30-trial-id-for (row lane)
        (str_concat (fkhe-id row) (str_concat ":" lane)))

    (defn fkp30-session-id-for (run-id model-id)
        (nmfe-sha256
            (nmfe-fields
                (list "public-heldout-local-residence-session-v1"
                      (fkhe-dataset-seal) run-id model-id))))
    (defn fkp30-trial-nonce-for (run-id session-id p)
        (nmfe-sha256
            (nmfe-fields
                (list "public-heldout-family-trial-nonce-v1"
                      (fkhe-dataset-seal) run-id session-id
                      (fkp30-presentation-trial-id p)
                      (fkp30-presentation-row-id p)
                      (fkp30-presentation-lane p)
                      (fkp30-presentation-family p)
                      (fkp30-presentation-source-sha p)
                      (fkp30-presentation-prompt-sha p)
                      (fkp30-presentation-challenge-sha p)
                      (fkp30-presentation-effective-sha p)))))
    (defn fkp30-content-sha-for (nonce raw-output)
        (nmfe-sha256
            (nmfe-fields
                (list "public-heldout-family-output-content-v1"
                      nonce raw-output))))

    ; presentation = tag trial-id row-id lane family source source-sha prompt
    ;                raw-prompt-sha challenge-sha effective-prompt-sha
    (defn fkp30-presentation (row lane)
        (list "public-heldout-presentation-v1"
              (fkp30-trial-id-for row lane) (fkhe-id row) lane
              (fkhe-family row) (fkhe-source row) (fkhe-source-sha row)
              (fkhe-prompt row) (nmfe-sha256 (fkhe-prompt row))
              (fkp30-challenge-sha row)
              (nmfe-sha256 (fqt-knowledge-prompt (fkhe-prompt row)))))
    (defn fkp30-presentation-trial-id (p) (nth p 1))
    (defn fkp30-presentation-row-id (p) (nth p 2))
    (defn fkp30-presentation-lane (p) (nth p 3))
    (defn fkp30-presentation-family (p) (nth p 4))
    (defn fkp30-presentation-source (p) (nth p 5))
    (defn fkp30-presentation-source-sha (p) (nth p 6))
    (defn fkp30-presentation-prompt (p) (nth p 7))
    (defn fkp30-presentation-prompt-sha (p) (nth p 8))
    (defn fkp30-presentation-challenge-sha (p) (nth p 9))
    (defn fkp30-presentation-effective-sha (p) (nth p 10))
    (defn fkp30-presentation-valid? (p)
        (if (not (eq (fkpfm-list? p) 1)) 0
        (if (not (eq (len p) 11)) 0
        (if (not (str_eq (nth p 0) "public-heldout-presentation-v1")) 0
            (do
                (let row (fkhe-find-row (fkp30-presentation-row-id p)
                                        (fkhe-rows)))
                (if (eq (len row) 0) 0
                    (if (and (eq (fkp30-lane?
                                      (fkp30-presentation-lane p)) 1)
                         (and (str_eq (fkp30-presentation-trial-id p)
                                      (fkp30-trial-id-for row
                                          (fkp30-presentation-lane p)))
                         (and (str_eq (fkp30-presentation-family p)
                                      (fkhe-family row))
                         (and (str_eq (fkp30-presentation-source p)
                                      (fkhe-source row))
                         (and (str_eq (fkp30-presentation-source-sha p)
                                      (fkhe-source-sha row))
                         (and (str_eq (fkp30-presentation-prompt p)
                                      (fkhe-prompt row))
                         (and (str_eq (fkp30-presentation-prompt-sha p)
                                      (nmfe-sha256 (fkhe-prompt row)))
                         (and (str_eq (fkp30-presentation-challenge-sha p)
                                      (fkp30-challenge-sha row))
                              (str_eq (fkp30-presentation-effective-sha p)
                                  (nmfe-sha256 (fqt-knowledge-prompt
                                      (fkhe-prompt row)))))))))))) 1 0)))))))

    (defn fkp30-presentations-row (row)
        (list (fkp30-presentation row "a")
              (fkp30-presentation row "b")))
    (defn fkp30-presentations-loop (rows)
        (if (eq (len rows) 0) (list)
            (append (fkp30-presentations-row (head rows))
                    (fkp30-presentations-loop (tail rows)))))
    (defn fkp30-presentations () (fkp30-presentations-loop (fkhe-rows)))

    ; scheduled = tag presentation exact-context-need.  The live driver derives
    ; need from tokenizer IDs and Form's own context formula before model open.
    (defn fkp30-scheduled (presentation need)
        (list "public-heldout-scheduled-v1" presentation need))
    (defn fkp30-scheduled-presentation (s) (nth s 1))
    (defn fkp30-scheduled-need (s) (nth s 2))
    (defn fkp30-scheduled-valid? (s)
        (if (and (eq (fkpfm-list? s) 1)
                 (and (eq (len s) 3)
                 (and (str_eq (nth s 0) "public-heldout-scheduled-v1")
                 (and (eq (fkp30-presentation-valid? (nth s 1)) 1)
                      (gt (nth s 2) 0))))) 1 0))
    (defn fkp30-schedule-insert (item sorted)
        (if (eq (len sorted) 0) (list item)
            (if (ge (fkp30-scheduled-need item)
                    (fkp30-scheduled-need (head sorted)))
                (cons item sorted)
                (cons (head sorted)
                    (fkp30-schedule-insert item (tail sorted))))))
    (defn fkp30-schedule-sort (items acc)
        (if (eq (len items) 0) acc
            (fkp30-schedule-sort (tail items)
                (fkp30-schedule-insert (head items) acc))))
    (defn fkp30-schedule-descending? (items)
        (if (le (len items) 1) 1
            (if (ge (fkp30-scheduled-need (head items))
                    (fkp30-scheduled-need (nth items 1)))
                (fkp30-schedule-descending? (tail items)) 0)))

    ; trial = tag presentation score model-id run-id session-id raw-output
    ;         output-sha family-nonce content-sha local remote model-executed
    ;         state-released same-residence outcome present value-zero value-one
    ;         query-tokens answer-tokens generated-tokens hits misses nothings
    ;         timeout frame-refusals latency
    (defn fkp30-trial
        (presentation score model-id run-id session-id raw-output output-sha
         family-nonce content-sha local remote
         model-executed state-released same-residence outcome present
         value-zero value-one query-tokens answer-tokens generated-tokens
         hits misses nothings timeout frame-refusals latency)
        (list "public-heldout-resident-trial-v1" presentation score model-id
              run-id session-id raw-output output-sha family-nonce content-sha
              local remote model-executed state-released same-residence outcome
              present value-zero value-one query-tokens answer-tokens
              generated-tokens hits misses nothings timeout frame-refusals
              latency))
    (defn fkp30-trial-presentation (t) (nth t 1))
    (defn fkp30-trial-score (t) (nth t 2))
    (defn fkp30-trial-model-id (t) (nth t 3))
    (defn fkp30-trial-run-id (t) (nth t 4))
    (defn fkp30-trial-session-id (t) (nth t 5))
    (defn fkp30-trial-raw-output (t) (nth t 6))
    (defn fkp30-trial-output-sha (t) (nth t 7))
    (defn fkp30-trial-family-nonce (t) (nth t 8))
    (defn fkp30-trial-content-sha (t) (nth t 9))
    (defn fkp30-trial-local (t) (nth t 10))
    (defn fkp30-trial-remote (t) (nth t 11))
    (defn fkp30-trial-model-executed (t) (nth t 12))
    (defn fkp30-trial-state-released (t) (nth t 13))
    (defn fkp30-trial-same-residence (t) (nth t 14))
    (defn fkp30-trial-outcome (t) (nth t 15))
    (defn fkp30-trial-present (t) (nth t 16))
    (defn fkp30-trial-zero (t) (nth t 17))
    (defn fkp30-trial-one (t) (nth t 18))
    (defn fkp30-trial-query-tokens (t) (nth t 19))
    (defn fkp30-trial-answer-tokens (t) (nth t 20))
    (defn fkp30-trial-generated-tokens (t) (nth t 21))
    (defn fkp30-trial-hits (t) (nth t 22))
    (defn fkp30-trial-misses (t) (nth t 23))
    (defn fkp30-trial-nothings (t) (nth t 24))
    (defn fkp30-trial-timeout (t) (nth t 25))
    (defn fkp30-trial-frame-refusals (t) (nth t 26))
    (defn fkp30-trial-latency (t) (nth t 27))
    (defn fkp30-stage-int? (n) (if (ge n -1) 1 0))
    (defn fkp30-trial-telemetry-present? (t)
        (if (and (ge (fkp30-trial-query-tokens t) 0)
             (and (ge (fkp30-trial-answer-tokens t) 0)
             (and (ge (fkp30-trial-generated-tokens t) 0)
             (and (ge (fkp30-trial-hits t) 0)
             (and (ge (fkp30-trial-misses t) 0)
             (and (ge (fkp30-trial-nothings t) 0)
             (and (ge (fkp30-trial-timeout t) 0)
                  (ge (fkp30-trial-frame-refusals t) 0)))))))) 1 0))
    (defn fkp30-trial-valid? (t)
        (if (not (eq (fkpfm-list? t) 1)) 0
        (if (not (eq (len t) 28)) 0
        (if (not (str_eq (nth t 0) "public-heldout-resident-trial-v1")) 0
        (if (not (and (eq (fkp30-presentation-valid?
                                (fkp30-trial-presentation t)) 1)
                      (eq (fkhe-score-valid? (fkp30-trial-score t)
                              (fkhe-rows)) 1))) 0
            (do
                (let p (fkp30-trial-presentation t))
                (let s (fkp30-trial-score t))
                (let row (fkhe-find-row (fkp30-presentation-row-id p)
                                        (fkhe-rows)))
                (let raw (fkp30-trial-raw-output t))
                (let parsed (fkhe-parse-resident-output raw))
                (let rescored (fkhe-score row
                    (fqt-knowledge-prompt (fkhe-prompt row)) parsed
                    (fkp30-trial-latency t)))
                (let o (fkhe-score-observation s))
                (let error (nmfe-obs-error o))
                (let zero (if (and (eq error 0)
                                   (str_eq (nth s 8) (nmfe-sha256 "0"))) 1 0))
                (let one (if (and (eq error 0)
                                  (str_eq (nth s 8) (nmfe-sha256 "1"))) 1 0))
                (let shape
                    (if (eq error 1)
                        (if (and (str_eq (fkp30-trial-outcome t) "nothing")
                                 (and (eq (fkp30-trial-present t) 0)
                                 (and (eq (fkp30-trial-zero t) 0)
                                      (eq (fkp30-trial-one t) 0)))) 1 0)
                        (if (and (str_eq (fkp30-trial-outcome t) "value")
                                 (and (eq (fkp30-trial-present t) 1)
                                 (and (eq (fkp30-trial-zero t) zero)
                                      (eq (fkp30-trial-one t) one)))) 1 0)))
                (if (and (str_eq (fkhe-score-id s)
                                  (fkp30-presentation-row-id p))
                     (and (str_eq (fkhe-score-family s)
                                  (fkp30-presentation-family p))
                     (and (str_eq (nth s 3)
                                  (fkp30-presentation-source-sha p))
                     (and (str_eq (nth s 4)
                                  (fkp30-presentation-prompt-sha p))
                     (and (str_eq (nth s 6)
                                  (fkp30-presentation-effective-sha p))
                     (and (str_eq (fkp30-trial-output-sha t)
                                  (nmfe-sha256 raw))
                     (and (str_eq (fkp30-trial-output-sha t) (nth s 7))
                     (and (str_eq (fkp30-trial-family-nonce t)
                                  (fkp30-trial-nonce-for
                                      (fkp30-trial-run-id t)
                                      (fkp30-trial-session-id t) p))
                     (and (str_eq (fkp30-trial-content-sha t)
                                  (fkp30-content-sha-for
                                      (fkp30-trial-family-nonce t) raw))
                     (and (eq (fkpfm-equal? s rescored) 1)
                     (and (gt (str_len (fkp30-trial-model-id t)) 0)
                     (and (eq (nmfe-sha256? (fkp30-trial-run-id t)) 1)
                     (and (str_eq (fkp30-trial-session-id t)
                                  (fkp30-session-id-for
                                      (fkp30-trial-run-id t)
                                      (fkp30-trial-model-id t)))
                     (and (eq (fkp30-trial-local t) 1)
                     (and (eq (fkp30-trial-remote t) 0)
                     (and (eq (fkp30-bit? (fkp30-trial-model-executed t)) 1)
                     (and (eq (fkp30-bit? (fkp30-trial-state-released t)) 1)
                     (and (eq (fkp30-bit? (fkp30-trial-same-residence t)) 1)
                     (and (eq shape 1)
                     (and (eq (fkp30-stage-int? (fkp30-trial-query-tokens t)) 1)
                     (and (eq (fkp30-stage-int? (fkp30-trial-answer-tokens t)) 1)
                     (and (eq (fkp30-stage-int? (fkp30-trial-generated-tokens t)) 1)
                     (and (eq (fkp30-stage-int? (fkp30-trial-hits t)) 1)
                     (and (eq (fkp30-stage-int? (fkp30-trial-misses t)) 1)
                     (and (eq (fkp30-stage-int? (fkp30-trial-nothings t)) 1)
                     (and (eq (fkp30-stage-int? (fkp30-trial-timeout t)) 1)
                     (and (eq (fkp30-stage-int?
                                  (fkp30-trial-frame-refusals t)) 1)
                          (eq (fkp30-trial-latency t)
                              (nmfe-obs-latency o))))))))))))))))))))))))))))) 1 0)))))))

    (defn fkp30-count-row-lane (trials row-id lane)
        (if (eq (len trials) 0) 0
            (do
                (let p (fkp30-trial-presentation (head trials)))
                (add (if (and (str_eq (fkp30-presentation-row-id p) row-id)
                              (str_eq (fkp30-presentation-lane p) lane)) 1 0)
                     (fkp30-count-row-lane (tail trials) row-id lane)))))
    (defn fkp30-every-row-twice? (rows trials)
        (if (eq (len rows) 0) 1
            (if (and (eq (fkp30-count-row-lane trials
                                (fkhe-id (head rows)) "a") 1)
                     (eq (fkp30-count-row-lane trials
                                (fkhe-id (head rows)) "b") 1))
                (fkp30-every-row-twice? (tail rows) trials) 0)))
    (defn fkp30-all-trials-valid? (trials)
        (if (eq (len trials) 0) 1
            (if (eq (fkp30-trial-valid? (head trials)) 1)
                (fkp30-all-trials-valid? (tail trials)) 0)))
    (defn fkp30-all-same-model-run? (trials model-id run-id)
        (if (eq (len trials) 0) 1
            (if (and (str_eq (fkp30-trial-model-id (head trials)) model-id)
                     (str_eq (fkp30-trial-run-id (head trials)) run-id))
                (fkp30-all-same-model-run? (tail trials) model-id run-id) 0)))
    (defn fkp30-no-cross-family-output-replay-one? (trial others)
        (if (eq (len others) 0) 1
            (do
                (let a (fkp30-trial-presentation trial))
                (let b (fkp30-trial-presentation (head others)))
                (if (and (not (str_eq (fkp30-presentation-family a)
                                      (fkp30-presentation-family b)))
                         (str_eq (fkp30-trial-output-sha trial)
                                 (fkp30-trial-output-sha (head others))))
                    0
                    (fkp30-no-cross-family-output-replay-one?
                        trial (tail others))))))
    (defn fkp30-no-cross-family-output-replay? (trials)
        (if (eq (len trials) 0) 1
            (if (eq (fkp30-no-cross-family-output-replay-one?
                          (head trials) (tail trials)) 1)
                (fkp30-no-cross-family-output-replay? (tail trials)) 0)))
    (defn fkp30-trial-set-valid? (trials)
        (if (not (eq (len trials) (fkp30-trial-total))) 0
            (if (and (eq (fkp30-all-trials-valid? trials) 1)
                     (and (eq (fkp30-every-row-twice? (fkhe-rows) trials) 1)
                     (and (eq (fkp30-all-same-model-run? trials
                                  (fkp30-trial-model-id (head trials))
                                  (fkp30-trial-run-id (head trials))) 1)
                          (eq (fkp30-no-cross-family-output-replay? trials)
                              1)))) 1 0)))
    (defn fkp30-count-trial-field (trials index)
        (if (eq (len trials) 0) 0
            (add (nth (head trials) index)
                 (fkp30-count-trial-field (tail trials) index))))
    (defn fkp30-count-telemetry-present (trials)
        (if (eq (len trials) 0) 0
            (add (fkp30-trial-telemetry-present? (head trials))
                 (fkp30-count-telemetry-present (tail trials)))))

    (defn fkp30-find-trial (trials row-id lane)
        (if (eq (len trials) 0) (nothing)
            (do
                (let p (fkp30-trial-presentation (head trials)))
                (if (and (str_eq (fkp30-presentation-row-id p) row-id)
                         (str_eq (fkp30-presentation-lane p) lane))
                    (head trials) (fkp30-find-trial (tail trials) row-id lane)))))
    (defn fkp30-worse-score (a b)
        (if (le (nmfe-obs-promotion (fkhe-score-observation a))
                (nmfe-obs-promotion (fkhe-score-observation b))) a b))
    (defn fkp30-reduced-scores-loop (rows trials)
        (if (eq (len rows) 0) (list)
            (do
                (let a (fkp30-find-trial trials (fkhe-id (head rows)) "a"))
                (let b (fkp30-find-trial trials (fkhe-id (head rows)) "b"))
                (if (or (nothing? a) (nothing? b)) (list)
                    (cons (fkp30-worse-score (fkp30-trial-score a)
                                             (fkp30-trial-score b))
                          (fkp30-reduced-scores-loop (tail rows) trials))))))
    (defn fkp30-reduced-scores (trials)
        (if (eq (fkp30-trial-set-valid? trials) 1)
            (fkp30-reduced-scores-loop (fkhe-rows) trials) (list)))

    ; result = tag dataset model run trials reduced report opens reopens local
    ;          remote model-executed states-released same-residence telemetry
    ;          release complete ready95 basis
    (defn fkp30-result (trials opens reopens release-ok)
        (do
            (let set-ok (fkp30-trial-set-valid? trials))
            (let model-id (if (eq set-ok 1)
                (fkp30-trial-model-id (head trials)) ""))
            (let run-id (if (eq set-ok 1)
                (fkp30-trial-run-id (head trials)) (nothing)))
            (let scores (if (eq set-ok 1)
                (fkp30-reduced-scores-loop (fkhe-rows) trials) (list)))
            (let local (fkp30-count-trial-field trials 10))
            (let remote (fkp30-count-trial-field trials 11))
            (let executed (fkp30-count-trial-field trials 12))
            (let states (fkp30-count-trial-field trials 13))
            (let same (fkp30-count-trial-field trials 14))
            (let telemetry (fkp30-count-telemetry-present trials))
            (let complete
                (if (and (eq set-ok 1)
                     (and (eq opens 1)
                     (and (eq reopens 0)
                     (and (eq local (fkp30-trial-total))
                     (and (eq remote 0)
                     (and (eq executed (fkp30-trial-total))
                     (and (eq states (fkp30-trial-total))
                     (and (eq same (fkp30-trial-total))
                     (and (eq telemetry (fkp30-trial-total))
                          (eq release-ok 1)))))))))) 1 0))
            (let heldout (fkhe-report (fkhe-live-scope) model-id
                (if (eq executed (fkp30-trial-total)) 1 0)
                release-ok scores))
            (let ready (if (and (eq complete 1)
                                (eq (fkhe-report-live-credit heldout) 1)) 1 0))
            (list "public-heldout-resident-result-v1" (fkhe-dataset-seal)
                  model-id run-id trials scores heldout opens reopens local remote
                  executed states same telemetry release-ok complete ready
                  (fkp30-basis))))
    (defn fkp30-result-trials (r) (nth r 4))
    (defn fkp30-result-report (r) (nth r 6))
    (defn fkp30-result-complete? (r) (nth r 16))
    (defn fkp30-result-ready95? (r) (nth r 17))
    (defn fkp30-result-valid? (r)
        (if (and (eq (fkpfm-list? r) 1)
                 (and (eq (len r) 19)
                      (str_eq (nth r 0) "public-heldout-resident-result-v1")))
            (if (eq (fkpfm-equal? r
                    (fkp30-result (nth r 4) (nth r 7) (nth r 8) (nth r 15))) 1)
                1 0) 0))

    ; The public projection contains no prompt or expected-answer text.  It
    ; retains canonical raw output so every digest and score is recomputable.
    (defn fkp30-presentation-seal (p)
        (list "public-heldout-presentation-seal-v1"
              (fkp30-presentation-trial-id p)
              (fkp30-presentation-row-id p)
              (fkp30-presentation-lane p)
              (fkp30-presentation-family p)
              (fkp30-presentation-source-sha p)
              (fkp30-presentation-prompt-sha p)
              (fkp30-presentation-challenge-sha p)
              (fkp30-presentation-effective-sha p)))
    (defn fkp30-presentation-seal-valid? (seal)
        (if (and (eq (fkpfm-list? seal) 1)
                 (and (eq (len seal) 9)
                      (str_eq (nth seal 0)
                              "public-heldout-presentation-seal-v1")))
            (do
                (let row (fkhe-find-row (nth seal 2) (fkhe-rows)))
                (if (eq (len row) 0) 0
                    (eq (fkpfm-equal? seal
                            (fkp30-presentation-seal
                                (fkp30-presentation row (nth seal 3)))) 1)))
            0))
    (defn fkp30-public-trial (t)
        (list "public-heldout-resident-trial-export-v1"
              (fkp30-presentation-seal (fkp30-trial-presentation t))
              (fkp30-trial-score t) (fkp30-trial-model-id t)
              (fkp30-trial-run-id t) (fkp30-trial-session-id t)
              (fkp30-trial-raw-output t)
              (fkp30-trial-output-sha t)
              (fkp30-trial-family-nonce t) (fkp30-trial-content-sha t)
              (fkp30-trial-local t) (fkp30-trial-remote t)
              (fkp30-trial-model-executed t)
              (fkp30-trial-state-released t)
              (fkp30-trial-same-residence t) (fkp30-trial-outcome t)
              (fkp30-trial-present t) (fkp30-trial-zero t)
              (fkp30-trial-one t) (fkp30-trial-query-tokens t)
              (fkp30-trial-answer-tokens t)
              (fkp30-trial-generated-tokens t) (fkp30-trial-hits t)
              (fkp30-trial-misses t) (fkp30-trial-nothings t)
              (fkp30-trial-timeout t) (fkp30-trial-frame-refusals t)
              (fkp30-trial-latency t)))
    (defn fkp30-public-trial-unseal (e)
        (if (not (and (eq (fkpfm-list? e) 1)
                      (and (eq (len e) 28)
                      (and (str_eq (nth e 0)
                                    "public-heldout-resident-trial-export-v1")
                           (eq (fkp30-presentation-seal-valid? (nth e 1)) 1)))))
            (nothing)
            (do
                (let seal (nth e 1))
                (let row (fkhe-find-row (nth seal 2) (fkhe-rows)))
                (let p (fkp30-presentation row (nth seal 3)))
                (fkp30-trial p (nth e 2) (nth e 3) (nth e 4)
                    (nth e 5) (nth e 6) (nth e 7) (nth e 8)
                    (nth e 9) (nth e 10) (nth e 11) (nth e 12)
                    (nth e 13) (nth e 14) (nth e 15) (nth e 16)
                    (nth e 17) (nth e 18) (nth e 19) (nth e 20)
                    (nth e 21) (nth e 22) (nth e 23) (nth e 24)
                    (nth e 25) (nth e 26) (nth e 27)))))
    (defn fkp30-public-trials (trials)
        (if (eq (len trials) 0) (list)
            (cons (fkp30-public-trial (head trials))
                  (fkp30-public-trials (tail trials)))))
    (defn fkp30-public-trials-unseal (rows)
        (if (eq (len rows) 0) (list)
            (do
                (let trial (fkp30-public-trial-unseal (head rows)))
                (if (nothing? trial) (nothing)
                    (do
                        (let rest (fkp30-public-trials-unseal (tail rows)))
                        (if (nothing? rest) (nothing)
                            (cons trial rest)))))))
    (defn fkp30-export-unchecked (result)
        (list "public-heldout-resident-export-v1"
              (nth result 1) (nth result 2) (nth result 3)
              (fkp30-public-trials (nth result 4))
              (nth result 6) (nth result 7) (nth result 8)
              (nth result 9) (nth result 10) (nth result 11)
              (nth result 12) (nth result 13) (nth result 14)
              (nth result 15) (nth result 16) (nth result 17)
              (nth result 18)))
    (defn fkp30-export (result)
        (if (not (eq (fkp30-result-valid? result) 1)) (nothing)
            (fkp30-export-unchecked result)))
    (defn fkp30-export-valid? (e)
        (if (not (and (eq (fkpfm-list? e) 1)
                      (and (eq (len e) 18)
                      (and (str_eq (nth e 0)
                                    "public-heldout-resident-export-v1")
                      (and (str_eq (nth e 1) (fkhe-dataset-seal))
                           (eq (len (nth e 4)) (fkp30-trial-total))))))) 0
            (do
                (let trials (fkp30-public-trials-unseal (nth e 4)))
                (if (nothing? trials) 0
                    (do
                        (let rebuilt (fkp30-result trials
                            (nth e 6) (nth e 7) (nth e 14)))
                        (if (eq (fkpfm-equal? e
                                    (fkp30-export-unchecked rebuilt)) 1)
                            1 0))))))

    (defn fkp30-find-family-score-trial (trials family score)
        (if (eq (len trials) 0) (nothing)
            (do
                (let t (head trials))
                (if (and (str_eq (fkp30-presentation-family
                                    (fkp30-trial-presentation t)) family)
                         (eq (fkpfm-equal? (fkp30-trial-score t) score) 1))
                    t
                    (fkp30-find-family-score-trial
                        (tail trials) family score)))))
    (defn fkp30-family-evidences-loop
        (families trials model-id run-id report)
        (if (eq (len families) 0) (list)
            (do
                (let family (head families))
                (let score (fkhe-find-family-score (nth report 6) family))
                (let trial
                    (fkp30-find-family-score-trial trials family score))
                (if (nothing? trial) (nothing)
                    (do
                        (let receipt (fkpfm-heldout-receipt family model-id
                            run-id (fkp30-trial-raw-output trial) report))
                        (let evidence
                            (fkpfm-heldout-evidence family receipt report))
                        (let rest (fkp30-family-evidences-loop
                            (tail families) trials model-id run-id report))
                        (if (nothing? rest) (nothing)
                            (cons evidence rest)))))))
    (defn fkp30-export-heldout-evidences (export)
        (if (or (not (eq (fkp30-export-valid? export) 1))
                (not (eq (nth export 15) 1))) (nothing)
            (do
                (let trials (fkp30-public-trials-unseal (nth export 4)))
                (fkp30-family-evidences-loop (fkpfm-family-ids) trials
                    (nth export 2) (nth export 3) (nth export 5)))))

    0)
