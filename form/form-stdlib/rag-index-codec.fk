// rag-index-codec.fk — typed JSONL codec for NodeID-grounded RAG memory.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/hex.fk
//
// A grounded row keeps identity and location separate. `id` / `node_id` are the
// resolvable substrate coordinate; `source_path` is only the source lens:
//   {"id":"@8.3.4.9","node_id":"@8.3.4.9","content_node_id":"@8.4.4.2",
//    "source_path":"docs/a.form",
//    "schema":"nodeid-rag-v2","embedding_kind":"form-semantic-v2",
//    "kind":"cell","key":"152961502","persisted_source_sha256":"152961502",
//    "answer_key":"982d...",
//    "answer_hex":"74657874",
//    "snippet":"text","vec":[12,34,56]}
//
// Legacy path-id rows still parse for migration, but ric-grounding-ready? refuses
// them. A source path can therefore never become grounding merely by occupying
// the old `id` field. NodeID syntax, schema, embedding kind, source lens, and a
// non-empty vector must all land before the ask lane may admit the row.
//
section [form.bml] {
    // ── field extractor: "key":"value" -> value ("" if absent). ──
    // Field spacing and order may vary. String fields used for identity/path do
    // not carry quotes; snippet escaping remains the JSON carrier's concern.
    def ric-field(line, key) = {
        let patt = str_concat("\"", str_concat(key, "\""));
        let ki = str_find(line, patt, 0);
        ki < 0 ? "" : {
            let colon = str_find(line, ":", ki + str_len(patt));
            let q1 = str_find(line, "\"", colon + 1);
            let q2 = str_find(line, "\"", q1 + 1);
            q1 < 0 || q2 < 0 ? "" : substring(line, q1 + 1, q2);
        };
    };
    // ── named string fields ──
    def ric-id(line) = ric-field(line, "id");
    def ric-raw-node-id(line) = ric-field(line, "node_id");
    def ric-content-node-id(line) = ric-field(line, "content_node_id");
    def ric-raw-source-path(line) = ric-field(line, "source_path");
    def ric-schema(line) = ric-field(line, "schema");
    def ric-embedding-kind(line) = ric-field(line, "embedding_kind");
    def ric-kind(line) = ric-field(line, "kind");
    def ric-key(line) = ric-field(line, "key");
    def ric-persisted-source-sha256(line) = ric-field(line, "persisted_source_sha256");
    def ric-answer-key(line) = ric-field(line, "answer_key");
    def ric-answer-hex(line) = ric-field(line, "answer_hex");
    def ric-snippet(line) = ric-field(line, "snippet");
    // ── strict @p.l.t.i syntax. Four non-empty unsigned decimal coordinates. ──
    def ric-digit?(s, i) = {
        let b = str_byte_at(s, i);
        b >= 48 && b <= 57 ? 1 : 0;
    };
    def ric-digits?(s, i, end) = i >= end ? 1 : (Comparable) ric-digit?(s, i) == 1 ? ric-digits?(s, i + 1, end) : 0;
    def ric-node-id-valid?(node-id) = {
        let n = str_len(node-id);
        n < 8 || !((String) substring(node-id, 0, 1) == "@") ? 0 : {
            let d1 = str_find(node-id, ".", 1);
            let d2 = d1 < 0 ? -1 : str_find(node-id, ".", d1 + 1);
            let d3 = d2 < 0 ? -1 : str_find(node-id, ".", d2 + 1);
            let d4 = d3 < 0 ? -1 : str_find(node-id, ".", d3 + 1);
            d1 < 2 || d2 < d1 + 2 || (d3 < d2 + 2 || !(d3 < n - 1)) ? 0 : !(d4 < 0) ? 0 : (Comparable) ric-digits?(node-id, 1, d1) == 1 && (Comparable) ric-digits?(node-id, d1 + 1, d2) == 1 && ((Comparable) ric-digits?(node-id, d2 + 1, d3) == 1 && (Comparable) ric-digits?(node-id, d3 + 1, n) == 1) ? 1 : 0;
        };
    };
    // node_id is authoritative; `id` is accepted only when it is itself a NodeID.
    def ric-node-id(line) = {
        let explicit = ric-raw-node-id(line);
        (Comparable) ric-node-id-valid?(explicit) == 1 ? explicit : (Comparable) ric-node-id-valid?(ric-id(line)) == 1 ? ric-id(line) : "";
    };
    // source_path is a lens, never identity. Legacy path-id rows retain their
    // source lens for migration while remaining ungrounded.
    def ric-source-path(line) = {
        let explicit = ric-raw-source-path(line);
        str_len(explicit) > 0 ? explicit : (Comparable) ric-node-id-valid?(ric-id(line)) == 1 ? "" : ric-id(line);
    };
    // ── whitespace-tolerant signed decimal parse for JSON vectors. ──
    def ric-space?(s, i) = {
        let b = str_byte_at(s, i);
        (Comparable) b == 32 || ((Comparable) b == 9 || ((Comparable) b == 10 || (Comparable) b == 13)) ? 1 : 0;
    };
    def ric-left(s, i, n) = i >= n ? n : (Comparable) ric-space?(s, i) == 1 ? ric-left(s, i + 1, n) : i;
    def ric-right(s, i) = i <= 0 ? 0 : (Comparable) ric-space?(s, i - 1) == 1 ? ric-right(s, i - 1) : i;
    def ric-s2i-go(s, i, end, acc) = i >= end ? acc : ric-s2i-go(s, i + 1, end, acc * 10 + (str_byte_at(s, i) - 48));
    def ric-s2i(s) = {
        let start = ric-left(s, 0, str_len(s));
        let end = ric-right(s, str_len(s));
        start >= end || !((Comparable) ric-digits?(s, (String) substring(s, start, start + 1) == "-" ? start + 1 : start, end) == 1) ? 0 : (String) substring(s, start, start + 1) == "-" ? 0 - ric-s2i-go(s, start + 1, end, 0) : ric-s2i-go(s, start, end, 0);
    };
    def ric-split-ints(s) = (Comparable) str_len(s) == 0 ? empty() : {
        let ci = str_find(s, ",", 0);
        ci < 0 ? cons(ric-s2i(s), empty()) : cons(ric-s2i(substring(s, 0, ci)), ric-split-ints(substring(s, ci + 1, str_len(s))));
    };
    // Accept both compact Form JSON (`"vec":[`) and ordinary spaced JSON
    // (`"vec": [`). Locate the array structurally from the field name.
    def ric-vec(line) = {
        let vi = str_find(line, "\"vec\"", 0);
        vi < 0 ? empty() : {
            let colon = str_find(line, ":", vi + 5);
            let open = str_find(line, "[", colon + 1);
            let close = open < 0 ? -1 : str_find(line, "]", open + 1);
            open < 0 || close < 0 ? empty() : ric-split-ints(substring(line, open + 1, close));
        };
    };
    // form-semantic-v2 is a sequence of adjacent dual-hash feature pairs.
    // First and second hashes occupy disjoint domains; malformed/odd vectors and
    // duplicate pairs cannot enter grounding even if the surrounding JSON claims v2.
    def ric-first-code?(code) = code >= 0 && code < 1000003 ? 1 : 0;
    def ric-second-code?(code) = code >= 1000003 && code < 2000036 ? 1 : 0;
    def ric-pair-in?(first-code, second-code, pairs) = len(pairs) < 2 ? 0 : (Comparable) first-code == head(pairs) && (Comparable) second-code == head(tail(pairs)) ? 1 : ric-pair-in?(first-code, second-code, tail(tail(pairs)));
    def ric-semantic-pairs-valid?(pairs) = (Comparable) len(pairs) == 0 ? 1 : len(pairs) < 2 ? 0 : {
        let first-code = head(pairs);
        let second-code = head(tail(pairs));
        let rest = tail(tail(pairs));
        (Comparable) ric-first-code?(first-code) == 1 && (Comparable) ric-second-code?(second-code) == 1 && (Comparable) ric-pair-in?(first-code, second-code, rest) == 0 ? ric-semantic-pairs-valid?(rest) : 0;
    };
    def ric-semantic-vec-valid?(vec) = len(vec) > 0 && (Comparable) ric-semantic-pairs-valid?(vec) == 1 ? 1 : 0;
    // A row is eligible for grounding only under the typed schema. This is a
    // format admission gate; the substrate carrier remains responsible for
    // proving that the admitted coordinate resolves before writing the row.
    def ric-grounding-ready?(line) = {
        let identity-ready = (Comparable) ric-node-id-valid?(ric-raw-node-id(line)) == 1 && ((String) ric-id(line) == ric-raw-node-id(line) && (Comparable) ric-node-id-valid?(ric-content-node-id(line)) == 1);
        let source-ready = str_len(ric-source-path(line)) > 0 && str_len(ric-key(line)) > 0;
        let answer-ready = str_len(ric-answer-key(line)) > 0 && str_len(ric-answer-hex(line)) > 0;
        let persisted = ric-persisted-source-sha256(line);
        let persisted-ready = (Comparable) str_len(persisted) == 64 && ((Comparable) hex-valid?(persisted) == 1 && (String) ric-key(line) == persisted);
        let schema-ready = (String) ric-schema(line) == "nodeid-rag-v2" && (String) ric-embedding-kind(line) == "form-semantic-v2";
        let vector-ready = (Comparable) ric-semantic-vec-valid?(ric-vec(line)) == 1;
        identity-ready && (source-ready && (answer-ready && (persisted-ready && (schema-ready && vector-ready)))) ? 1 : 0;
    };
    // ── emitters ──
    def ric-join-ints(vec) = (Comparable) len(vec) == 0 ? "" : (Comparable) len(vec) == 1 ? int_to_str(head(vec)) : str_concat(int_to_str(head(vec)), str_concat(",", ric-join-ints(tail(vec))));
    def ric-emit-vec(vec) = str_concat("[", str_concat(ric-join-ints(vec), "]"));
    def ric-pair(key, value) = str_concat("\"", str_concat(key, str_concat("\":\"", str_concat(value, "\""))));
    def ric-cat(parts) = (Comparable) len(parts) == 0 ? "" : str_concat(head(parts), ric-cat(tail(parts)));
    // Legacy migration emitter. It deliberately does NOT claim nodeid-rag-v2.
    def ric-emit(id, kind, key, snippet, vec) = ric-cat(list("{", ric-pair("id", id), ",", ric-pair("kind", kind), ",", ric-pair("key", key), ",", ric-pair("snippet", snippet), ",\"vec\":", ric-emit-vec(vec), "}"));
    // Canonical grounded emitter. id duplicates node_id for readers that still
    // select the historical field, but both values are the same NodeID.
    def ric-emit-grounded(node-id, content-node-id, source-path, kind, key, answer-key, answer-hex, snippet, vec) = ric-cat(list("{", ric-pair("id", node-id), ",", ric-pair("node_id", node-id), ",", ric-pair("content_node_id", content-node-id), ",", ric-pair("source_path", source-path), ",", ric-pair("persisted_source_sha256", key), ",", ric-pair("schema", "nodeid-rag-v2"), ",", ric-pair("embedding_kind", "form-semantic-v2"), ",", ric-pair("kind", kind), ",", ric-pair("key", key), ",", ric-pair("answer_key", answer-key), ",", ric-pair("answer_hex", answer-hex), ",", ric-pair("snippet", snippet), ",\"vec\":", ric-emit-vec(vec), "}"));
    0;
}
