; situated-lens-conclusion-control.fk — pure policy and actuator for a
; situated conclusion that returned value, invalid, missing, or ambiguous.
;
; This cell is carrier-free so the controller/actuator law crosses all four
; proof siblings. observe/situated-lens-conclusion-cycle.fk binds it to the
; fkwu-only actual framebuffer carrier.
;
; Policy actions use the established bidirectional vocabulary:
;   value -> continue 0
;   invalid -> revise 2
;   ambiguous -> abstain 3
;   missing -> request evidence 4
;
; Actuated state:
;   [field, selected-node, action, accepted]
;
; preludes: form-stdlib/core.fk form-stdlib/core-word-inquiry.fk form-stdlib/situated-lens-conclusion.fk
; witnessed: 2026-07-26 -> 65535 four-way

(do
    (defn slcc-action (outcome)
        (if (eq (slc-o-kind outcome) (slc-tag-value)) 0
            (if (eq (slc-o-reason outcome) 1) 2
                (if (eq (slc-o-reason outcome) 2) 4
                    (if (eq (slc-o-reason outcome) 3) 3 3)))))

    (defn slcc-match-count (field time lens)
        (if (or (eq (slc-field-valid? field) 0)
                (eq (cwi-lens? lens) 0))
            -1
            (slc-match-count field time lens)))

    ; [kind, reason, time, lens-rank, match-count, conclusion-node]
    (defn slcc-payload (outcome field time lens)
        (list
            (slc-o-kind outcome)
            (slc-o-reason outcome)
            time
            (if (eq (cwi-lens? lens) 1) (cwi-lens-rank lens) -1)
            (slcc-match-count field time lens)
            (slc-o-node outcome)))

    (defn slcc-state (field selected-node action accepted)
        (list field selected-node action accepted))
    (defn slcc-s-field (state) (nth state 0))
    (defn slcc-s-selected (state) (nth state 1))
    (defn slcc-s-action (state) (nth state 2))
    (defn slcc-s-accepted (state) (nth state 3))

    (defn slcc-offered-exact? (offered time lens)
        (if (and (eq (slc-row-valid? offered) 1)
            (and (eq (slc-r-time offered) time)
                 (eq (slc-lens-eq? (slc-r-lens offered) lens) 1))) 1 0))

    (defn slcc-apply-action
        (action field offered time lens current-node alternative)
        (if (eq action 0)
            (slcc-state field current-node action 1)
            (if (eq action 3)
                (slcc-state field alternative action 1)
                (if (eq action 4)
                    (if (and (eq
                            (slcc-offered-exact?
                                offered time lens) 1)
                        (and (eq (slc-field-valid? field) 1)
                             (eq (slc-match-count
                                    field time lens) 0)))
                        (slcc-state (cons offered field)
                            (slc-r-source offered) action 1)
                        (slcc-state field alternative action 0))
                    (if (eq action 2)
                        (if (eq (slcc-offered-exact?
                                    offered time lens) 1)
                            (slcc-state (list offered)
                                (slc-r-source offered) action 1)
                            (slcc-state field alternative action 0))
                        (slcc-state field alternative action 0))))))

    0)
