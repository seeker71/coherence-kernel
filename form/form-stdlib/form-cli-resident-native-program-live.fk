; form-cli-resident-native-program-live.fk -- one resident program load, then
; a streaming local input channel. Each input line is an integer signal. EOF
; releases the loop; no process, HTTP, or model door is opened per request.
;
; preludes: form-stdlib/core.fk form-stdlib/bml/form-cli-resident-native-program.bml

(do
    (defn fcrnpl-frame (input invocation)
        (str_concat "resident-native-program"
            (str_concat " input="
                (str_concat input
                    (str_concat " signal="
                        (str_concat (fcrnp-invocation-signal invocation)
                            (str_concat " route="
                                (str_concat (fcrnp-invocation-route invocation)
                                    (str_concat " model="
                                        (str_concat (int_to_str
                                            (fcrnp-invocation-model-executed invocation))
                                            (str_concat " host-crossings="
                                                (int_to_str
                                                    (fcrnp-invocation-host-crossings invocation)))))))))))))
    (defn fcrnpl-loop (loaded)
        (do
            (let input (read_line))
            (if (nothing? input)
                0
                (do
                    (let invocation (fcrnp-invoke loaded (str_to_int input)))
                    (let emitted (print_str (fcrnpl-frame input invocation)))
                    (fcrnpl-loop loaded)))))
    (let loaded (fcrnp-load (frpce-empty)))
    (if (str_eq (fcrnp-loaded-status loaded) "returned")
        (fcrnpl-loop loaded)
        (do
            (let emitted (print_str (str_concat "resident-native-program load="
                (fcrnp-loaded-reason loaded))))
            0)))
