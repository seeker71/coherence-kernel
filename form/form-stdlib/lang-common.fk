// lang-common.fk — the statement + expression rules shared by every imperative
// language grammar (BML, Go, Java, …). Each language provides its own `method`,
// `param`, and `ifs` (where surfaces genuinely differ) and appends these.
//
// This is the core-abstraction-first payoff: the languages diverge only at the
// few rules where their surface actually differs; everything from `stmt` down to
// `atom` is one shared bag of rules emitting the universal vocabulary.
//
// A grammar's `stmt` references `ifs` by name — each language supplies its own
// `ifs`, resolved within that grammar — so the shared `stmt` works unchanged.
//
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk form-stdlib/line-grammar.fk form-stdlib/bmf-core.fk form-stdlib/bmf-grammar.fk
section [form.bml] {
    def common-rules() = [rule3("stmt", p-cap("v", ["alt", p-ref("ret"), p-ref("ifs"), p-ref("lets"), p-ref("exprs")]), t-splice("v")), rule3("ret", ["seq", p-lit("return"), p-cap("e", p-ref("expr")), p-lit(";")], t-emit("UE-JUMP-RETURN", [t-splice("e")])), rule3("lets", ["seq", p-cap("n", p-run("alpha")), p-lit("="), p-cap("e", p-ref("expr")), p-lit(";")], t-emit("let", [t-splice("n"), t-splice("e")])), rule3("exprs", ["seq", p-cap("e", p-ref("expr")), p-lit(";")], t-splice("e")), rule3("expr", p-cap("v", ["alt", p-ref("addx"), p-ref("subx"), p-ref("term")]), t-splice("v")), rule3("addx", ["seq", p-cap("l", p-ref("term")), p-lit("+"), p-cap("r", p-ref("expr"))], t-emit("add", [t-splice("l"), t-splice("r")])), rule3("subx", ["seq", p-cap("l", p-ref("term")), p-lit("-"), p-cap("r", p-ref("expr"))], t-emit("sub", [t-splice("l"), t-splice("r")])), rule3("term", p-cap("v", ["alt", p-ref("mulx"), p-ref("divx"), p-ref("factor")]), t-splice("v")), rule3("mulx", ["seq", p-cap("l", p-ref("factor")), p-lit("*"), p-cap("r", p-ref("term"))], t-emit("mul", [t-splice("l"), t-splice("r")])), rule3("divx", ["seq", p-cap("l", p-ref("factor")), p-lit("/"), p-cap("r", p-ref("term"))], t-emit("div", [t-splice("l"), t-splice("r")])), rule3("factor", ["alt", ["seq", p-lit("("), p-cap("v", p-ref("expr")), p-lit(")")], p-cap("v", p-ref("call")), p-cap("v", p-ref("atom"))], t-splice("v")), rule3("call", ["seq", p-cap("n", p-run("alpha")), p-lit("("), p-cap("args", p-sep(p-ref("expr"), p-lit(","))), p-lit(")")], t-emit("fncall", [t-splice("n"), t-splices("args")])), rule3("atom", p-cap("v", p-run("alnum")), t-splice("v"))];
}
