; living-world-enquiry-profile-voice.fk -- shared observed behavior may speak
; without appointing a representative hypothesis.
;
; A request addresses one current finite-space profile class and one exact
; current binding from that class.  The answer is derived from the class's
; binding/output points, never by selecting or re-executing one hypothesis.
; All hypotheses remain in the class and in the utterance lineage.
;
; The caller may independently omit alternatives, unknown, choice, timeout,
; and evidence.  Immediate NOTHING is retained separately from a pending time
; observation and from the sender-authored acknowledgment produced after
; expiration.  A timed default cannot manufacture profile evidence.
;
; Surface candidates are participant learned and offered in the request.  Zero
; current matching surfaces remains unvoiced NOTHING; one can form a diagnostic
; utterance; many remains explicit NODE plurality.  Construction is not an
; outward authority grant; callers still use the ordinary tending membrane for
; any external act.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-hypothesis-enquiry.fk form-stdlib/living-world-enquiry-profile.fk

(let LWEPV-REQUEST   (bp "LWEPV-REQUEST"))
(let LWEPV-ANSWER    (bp "LWEPV-ANSWER"))
(let LWEPV-PLAN      (bp "LWEPV-PLAN"))
(let LWEPV-UTTERANCE (bp "LWEPV-UTTERANCE"))

; children: current class, exact bindings, offered symbol candidates,
; alternatives, optional unknown, optional choice, optional timeout, observed
; time, evidence, local path
(defn lwepv-request
    (class bindings symbols alternatives unknown choice timeout observed-time
     evidence)
    (intern_node LWEPV-REQUEST
        (list class bindings symbols alternatives unknown choice timeout
              observed-time evidence (lwo-local-path))))
(defn lwepv-request? (cell) (lwo-category? cell LWEPV-REQUEST))
(defn lwepv-request-class (request) (nth (node_children request) 0))
(defn lwepv-request-bindings (request) (nth (node_children request) 1))
(defn lwepv-request-symbols (request) (nth (node_children request) 2))
(defn lwepv-request-alternatives (request) (nth (node_children request) 3))
(defn lwepv-request-unknown (request) (nth (node_children request) 4))
(defn lwepv-request-choice (request) (nth (node_children request) 5))
(defn lwepv-request-timeout (request) (nth (node_children request) 6))
(defn lwepv-request-observed-time (request) (nth (node_children request) 7))
(defn lwepv-request-evidence (request) (nth (node_children request) 8))
(defn lwepv-request-path (request) (nth (node_children request) 9))

(defn lwepv-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwepv-timeout-valid? (timeout)
    (if (node_eq timeout (lwo-none)) 1 (oac-timeout-valid? timeout)))
(defn lwepv-int-cell? (cell)
    (if (and (eq (node_level cell) 1)
             (eq (node_type cell) 1)) 1 0))
(defn lwepv-request-valid? (request)
    (if (eq (lwepv-request? request) 0) 0
        (if (eq (lwep-class? (lwepv-request-class request)) 0) 0
            (if (eq (lwre-bindings-valid?
                        (lwepv-request-bindings request)) 0) 0
                (if (eq (lwo-category?
                            (lwepv-request-symbols request) LWO-FIELD) 0) 0
                    (if (eq (lwo-category?
                                (lwepv-request-alternatives request)
                                LWO-FIELD) 0) 0
                        (if (eq (lwepv-unknown-valid?
                                    (lwepv-request-unknown request)) 0) 0
                            (if (eq (lwlc-choice-valid?
                                        (lwepv-request-choice request)) 0) 0
                                (if (eq (lwepv-timeout-valid?
                                            (lwepv-request-timeout request)) 0)
                                    0
                                    (lwepv-int-cell?
                                        (lwepv-request-observed-time
                                            request)))))))))))

(defn lwepv-request-current? (world request)
    (if (and (eq (lwepv-request-valid? request) 1)
             (and (eq (lwo-active? world request) 1)
                  (and (eq (lwep-class-current? world
                              (lwepv-request-class request)) 1)
                       (eq (lwre-bindings-current? world
                              (lwepv-request-bindings request)) 1)))) 1 0))

(defn lwepv-points-for-bindings (items bindings points)
    (if (eq (len items) 0) points
        (lwepv-points-for-bindings (tail items) bindings
            (if (node_eq (lwep-point-bindings (head items)) bindings)
                (lwo-field-add points (head items)) points))))

(defn lwepv-outputs-for-points (items outputs)
    (if (eq (len items) 0) outputs
        (lwepv-outputs-for-points (tail items)
            (lwo-field-add outputs (lwep-point-output (head items))))))

(defn lwepv-immediate-ack (outputs)
    (do
        (let count (lwo-field-size outputs))
        (if (eq count 0) (oac-nothing)
            (if (eq count 1)
                (oac-one (head (lwo-field-items outputs)))
                (oac-node outputs)))))

(defn lwepv-time-state (request)
    (if (node_eq (lwepv-request-timeout request) (lwo-none)) (lwo-none)
        (oac-timeout-condense (lwepv-request-timeout request)
            (lwepv-request-observed-time request))))

(defn lwepv-effective-ack (immediate time-state)
    (if (eq (oac-nothing? immediate) 0) immediate
        (if (eq (oac-time-outcome? time-state) 1)
            (oac-time-outcome-ack time-state) immediate)))

; children: exact request, matching points, distinct outputs, immediate ack,
; separate time state, effective ack, class hypotheses, local path
(defn lwepv-answer
    (request points outputs immediate time-state effective hypotheses)
    (intern_node LWEPV-ANSWER
        (list request points outputs immediate time-state effective hypotheses
              (lwo-local-path))))
(defn lwepv-answer? (cell) (lwo-category? cell LWEPV-ANSWER))
(defn lwepv-answer-request (answer) (nth (node_children answer) 0))
(defn lwepv-answer-points (answer) (nth (node_children answer) 1))
(defn lwepv-answer-outputs (answer) (nth (node_children answer) 2))
(defn lwepv-answer-immediate (answer) (nth (node_children answer) 3))
(defn lwepv-answer-time-state (answer) (nth (node_children answer) 4))
(defn lwepv-answer-effective (answer) (nth (node_children answer) 5))
(defn lwepv-answer-hypotheses (answer) (nth (node_children answer) 6))

(defn lwepv-answer-for (world request)
    (if (eq (lwepv-request-current? world request) 0) (lwo-none)
        (do
            (let class (lwepv-request-class request))
            (let points
                (lwepv-points-for-bindings
                    (lwo-field-items (lwep-class-points class))
                    (lwepv-request-bindings request) (lwo-empty-field)))
            (let outputs
                (lwepv-outputs-for-points
                    (lwo-field-items points) (lwo-empty-field)))
            (let immediate (lwepv-immediate-ack outputs))
            (let time-state (lwepv-time-state request))
            (lwepv-answer request points outputs immediate time-state
                (lwepv-effective-ack immediate time-state)
                (lwep-class-hypothesis-field class)))))

(defn lwepv-answer-current? (world answer)
    (if (eq (lwepv-answer? answer) 0) 0
        (node_eq answer
            (lwepv-answer-for world (lwepv-answer-request answer)))))

(defn lwepv-symbol-matches-output? (world output candidate)
    (if (and (eq (lwsl-integrated-current? world candidate) 1)
             (node_eq
                (lwnv-symbol-referent (lwo-emergent-shape candidate))
                output)) 1 0))

(defn lwepv-symbols-for-output (world output items matches)
    (if (eq (len items) 0) matches
        (lwepv-symbols-for-output world output (tail items)
            (if (eq (lwepv-symbol-matches-output?
                        world output (head items)) 1)
                (lwo-field-add matches (head items)) matches))))

(defn lwepv-plan-matches (world answer symbols)
    (do
        (let effective (lwepv-answer-effective answer))
        (if (eq (oac-one? effective) 0) (lwo-empty-field)
            (do
                (let output (oac-payload effective))
                (if (eq (lwo-field-has?
                            (lwepv-answer-outputs answer) output) 0)
                    (lwo-empty-field)
                    (lwepv-symbols-for-output world output
                        (lwo-field-items symbols) (lwo-empty-field)))))))

(defn lwepv-plan-ack (answer matches)
    (do
        (let effective (lwepv-answer-effective answer))
        (if (eq (oac-one? effective) 0) effective
            (if (eq (lwo-field-has?
                        (lwepv-answer-outputs answer)
                        (oac-payload effective)) 0) effective
                (do
                    (let count (lwo-field-size matches))
                    (if (eq count 0) (oac-nothing)
                        (if (eq count 1)
                            (oac-one (head (lwo-field-items matches)))
                            (oac-node matches))))))))

; children: exact answer, offered symbols, current matching symbols, voice ack,
; local path
(defn lwepv-plan (answer symbols matches ack)
    (intern_node LWEPV-PLAN
        (list answer symbols matches ack (lwo-local-path))))
(defn lwepv-plan? (cell) (lwo-category? cell LWEPV-PLAN))
(defn lwepv-plan-answer (plan) (nth (node_children plan) 0))
(defn lwepv-plan-symbols (plan) (nth (node_children plan) 1))
(defn lwepv-plan-matching-symbols (plan) (nth (node_children plan) 2))
(defn lwepv-plan-voice-ack (plan) (nth (node_children plan) 3))

(defn lwepv-plan-for (world answer symbols)
    (if (or (eq (lwepv-answer-current? world answer) 0)
            (eq (lwo-category? symbols LWO-FIELD) 0)) (lwo-none)
        (do
            (let matches (lwepv-plan-matches world answer symbols))
            (lwepv-plan answer symbols matches
                (lwepv-plan-ack answer matches)))))

(defn lwepv-plan-current? (world plan)
    (if (eq (lwepv-plan? plan) 0) 0
        (node_eq plan
            (lwepv-plan-for world (lwepv-plan-answer plan)
                (lwepv-plan-symbols plan)))))

(defn lwepv-witness-union (items field)
    (if (eq (len items) 0) field
        (lwepv-witness-union (tail items)
            (lwo-field-add field (head items)))))

(defn lwepv-witnesses (world answer symbol)
    (do
        (let request (lwepv-answer-request answer))
        (let class (lwepv-request-class request))
        (let with-class
            (lwepv-witness-union
                (lwo-field-items (lwep-class-witnesses class))
                (lwo-empty-field)))
        (let with-request
            (lwepv-witness-union
                (lwo-field-items
                    (lwo-active-attributions-for world request)) with-class))
        (lwepv-witness-union
            (lwo-field-items (lwo-active-attributions-for world symbol))
            with-request)))

; children: exact plan, class, all class hypotheses, points, output, exact
; learned symbol candidate, local surface, immediate/effective ack, time state,
; alternatives, unknown, choice, witnesses, evidence, local path
(defn lwepv-utterance
    (plan class hypotheses points output symbol surface immediate effective
     time-state alternatives unknown choice witnesses evidence)
    (intern_node LWEPV-UTTERANCE
        (list plan class hypotheses points output symbol
              (intern_trivial_string surface) immediate effective time-state
              alternatives unknown choice witnesses evidence
              (lwo-local-path))))
(defn lwepv-utterance? (cell) (lwo-category? cell LWEPV-UTTERANCE))
(defn lwepv-utterance-plan (utterance) (nth (node_children utterance) 0))
(defn lwepv-utterance-class (utterance) (nth (node_children utterance) 1))
(defn lwepv-utterance-hypotheses (utterance) (nth (node_children utterance) 2))
(defn lwepv-utterance-points (utterance) (nth (node_children utterance) 3))
(defn lwepv-utterance-output (utterance) (nth (node_children utterance) 4))
(defn lwepv-utterance-symbol (utterance) (nth (node_children utterance) 5))
(defn lwepv-utterance-surface-cell (utterance)
    (nth (node_children utterance) 6))
(defn lwepv-utterance-surface (utterance)
    (node_value (lwepv-utterance-surface-cell utterance)))
(defn lwepv-utterance-immediate (utterance) (nth (node_children utterance) 7))
(defn lwepv-utterance-effective (utterance) (nth (node_children utterance) 8))
(defn lwepv-utterance-time-state (utterance) (nth (node_children utterance) 9))
(defn lwepv-utterance-alternatives (utterance)
    (nth (node_children utterance) 10))
(defn lwepv-utterance-unknown (utterance) (nth (node_children utterance) 11))
(defn lwepv-utterance-choice (utterance) (nth (node_children utterance) 12))
(defn lwepv-utterance-witnesses (utterance) (nth (node_children utterance) 13))
(defn lwepv-utterance-evidence (utterance) (nth (node_children utterance) 14))

(defn lwepv-utterance-for (world plan)
    (if (eq (lwepv-plan-current? world plan) 0) (lwo-none)
        (do
            (let answer (lwepv-plan-answer plan))
            (let request (lwepv-answer-request answer))
            (let voice-ack (lwepv-plan-voice-ack plan))
            (if (eq (oac-one? voice-ack) 0) (lwo-none)
                (do
                    (let output (oac-payload
                                    (lwepv-answer-effective answer)))
                    (if (eq (lwo-field-has?
                                (lwepv-answer-outputs answer) output) 0)
                        (lwo-none)
                        (do
                            (let symbol (oac-payload voice-ack))
                            (lwepv-utterance plan
                                (lwepv-request-class request)
                                (lwepv-answer-hypotheses answer)
                                (lwepv-answer-points answer) output symbol
                                (lwnv-symbol-surface
                                    (lwo-emergent-shape symbol))
                                (lwepv-answer-immediate answer)
                                (lwepv-answer-effective answer)
                                (lwepv-answer-time-state answer)
                                (lwepv-request-alternatives request)
                                (lwepv-request-unknown request)
                                (lwepv-request-choice request)
                                (lwepv-witnesses world answer symbol)
                                (lwepv-request-evidence request)))))))))

(defn lwepv-utterance-current? (world utterance)
    (if (eq (lwepv-utterance? utterance) 0) 0
        (node_eq utterance
            (lwepv-utterance-for world
                (lwepv-utterance-plan utterance)))))

; witnessed: 2026-08-09 -> 2147483647 shared-profile native voice on fkwu
