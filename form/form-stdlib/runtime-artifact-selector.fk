// runtime-artifact-selector.fk -- Layer 9b plan coherence selector.
//
// This layer consumes Layer 9a `rap-plan` rows and emits selection rows. It is
// a selector face, not runtime execution and not an installed `fkwu` startup
// selector. It validates plan coherence, but it does not derive routes from
// descriptors, read or write disk, load or walk `.fkb`, load or call `.dylib`,
// resolve symbols, execute native bytes, reverify seals/proofs/callability,
// decide source-runner admission, or grow the C seed.
//
// The selector is total over readable plan-shaped rows:
//   coherent execution intent -> selected
//   upstream investigate plan  -> investigate
//   incoherent readable plan   -> investigate
//   malformed unreadable plan  -> refused
//
// preludes: form-stdlib/core.fk form-stdlib/source-artifact-cache.fk form-stdlib/source-artifact-descriptor.fk form-stdlib/runtime-artifact-plan.fk
section [form.bml] {
    def ras-feature(name, status) = ["runtime-artifact-selector-feature", name, status];
    def ras-feature-name(f) = f[1];
    def ras-feature-status(f) = f[2];
    def runtime-artifact-selector-manifest() = [ras-feature("selection-face-not-execution", 1), ras-feature("consumes-rap-plan-only", 1), ras-feature("plan-coherence-gate", 1), ras-feature("no-descriptor-route-derivation", 1), ras-feature("total-selection-row", 1), ras-feature("selected-investigate-refused-statuses", 1), ras-feature("malformed-refused-incoherent-investigates", 1), ras-feature("no-disk-io", 1), ras-feature("no-runtime-load", 1), ras-feature("no-native-execution", 1), ras-feature("no-seal-verification", 1), ras-feature("no-proof-callable-reverify", 1), ras-feature("no-admission-policy", 1), ras-feature("no-c-seed-growth", 1), ras-feature("no-fkwu-selector-install", 1), ras-feature("no-route-rederivation", 1)];
    def runtime-artifact-selector-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) ras-feature-name(head(fs)) == name && (Comparable) ras-feature-status(head(fs)) == 1 ? 1 : runtime-artifact-selector-manifest-has?(name, tail(fs));
    def ras-status-selected() = "selected";
    def ras-status-investigate() = "investigate";
    def ras-status-refused() = "refused";
    def ras-reason-selected-native() = "selected-native";
    def ras-reason-selected-program-image() = "selected-program-image";
    def ras-reason-selected-compile-source() = "selected-compile-source";
    def ras-reason-upstream-investigate() = "upstream-investigate";
    def ras-reason-malformed-plan() = "malformed-plan";
    def ras-reason-incoherent-native() = "incoherent-native-plan";
    def ras-reason-incoherent-program-image() = "incoherent-program-image-plan";
    def ras-reason-incoherent-compile-source() = "incoherent-compile-source-plan";
    def ras-reason-incoherent-investigate() = "incoherent-investigate-plan";
    def ras-reason-unknown-primary() = "unknown-primary";
    def ras-reason-route-mismatch() = "route-mismatch";
    // selection = ("runtime-artifact-selection" route selected fallback status
    //              skip-parse skip-recompute reason)
    def ras-selection(route, selected, fallback, status, skip-parse, skip-recompute, reason) = ["runtime-artifact-selection", route, selected, fallback, status, skip-parse, skip-recompute, reason];
    def ras-selection?(s) = (String) s[0] == "runtime-artifact-selection";
    def ras-selection-route(s) = s[1];
    def ras-selection-selected(s) = s[2];
    def ras-selection-fallback(s) = s[3];
    def ras-selection-status(s) = s[4];
    def ras-selection-skip-parse(s) = s[5];
    def ras-selection-skip-recompute(s) = s[6];
    def ras-selection-reason(s) = s[7];
    def ras-selected?(s) = ras-selection?(s) ? (String) ras-selection-status(s) == ras-status-selected() ? 1 : 0 : 0;
    def ras-investigate?(s) = ras-selection?(s) ? (String) ras-selection-status(s) == ras-status-investigate() ? 1 : 0 : 0;
    def ras-refused?(s) = ras-selection?(s) ? (String) ras-selection-status(s) == ras-status-refused() ? 1 : 0 : 0;
    def ras-bit?(x) = (Comparable) x == 0 ? 1 : (Comparable) x == 1 ? 1 : 0;
    def ras-plan-row?(p) = (Comparable) len(p) == 8 ? (String) p[0] == "runtime-artifact-plan" : 0;
    def ras-plan-readable?(p) = ras-plan-row?(p) ? ras-bit?(rap-plan-skip-parse(p)) ? ras-bit?(rap-plan-skip-recompute(p)) ? ras-bit?(rap-plan-deopt-anchor(p)) : 0 : 0 : 0;
    def ras-route-matches-primary?(p) = (String) rap-plan-primary(p) == rap-act-run-native() ? (Comparable) rap-plan-route(p) == sac-run-dylib() ? 1 : 0 : (String) rap-plan-primary(p) == rap-act-run-program-image() ? (Comparable) rap-plan-route(p) == sac-run-fkb() ? 1 : 0 : (String) rap-plan-primary(p) == rap-act-compile-source() ? (Comparable) rap-plan-route(p) == sac-run-source-compile() ? 1 : 0 : (String) rap-plan-primary(p) == rap-act-investigate() ? (Comparable) rap-plan-route(p) == sad-route-invalid() ? 1 : 0 : 0;
    def ras-coherent-native?(p) = (String) rap-plan-primary(p) == rap-act-run-native() ? (Comparable) ras-route-matches-primary?(p) == 1 ? (String) rap-plan-fallback(p) == rap-act-run-program-image() ? (Comparable) rap-plan-skip-parse(p) == 1 ? (Comparable) rap-plan-skip-recompute(p) == 1 ? (Comparable) rap-plan-deopt-anchor(p) == 1 ? 1 : 0 : 0 : 0 : 0 : 0 : 0;
    def ras-coherent-program-image?(p) = (String) rap-plan-primary(p) == rap-act-run-program-image() ? (Comparable) ras-route-matches-primary?(p) == 1 ? (String) rap-plan-fallback(p) == rap-act-compile-source() ? (Comparable) rap-plan-skip-parse(p) == 1 ? (Comparable) rap-plan-skip-recompute(p) == 0 ? (Comparable) rap-plan-deopt-anchor(p) == 1 ? 1 : 0 : 0 : 0 : 0 : 0 : 0;
    def ras-coherent-compile-source?(p) = (String) rap-plan-primary(p) == rap-act-compile-source() ? (Comparable) ras-route-matches-primary?(p) == 1 ? (String) rap-plan-fallback(p) == rap-act-none() ? (Comparable) rap-plan-skip-parse(p) == 0 ? (Comparable) rap-plan-skip-recompute(p) == 0 ? (Comparable) rap-plan-deopt-anchor(p) == 0 ? 1 : 0 : 0 : 0 : 0 : 0 : 0;
    def ras-coherent-investigate?(p) = (String) rap-plan-primary(p) == rap-act-investigate() ? (Comparable) ras-route-matches-primary?(p) == 1 ? (String) rap-plan-fallback(p) == rap-act-none() ? (Comparable) rap-plan-skip-parse(p) == 0 ? (Comparable) rap-plan-skip-recompute(p) == 0 ? (Comparable) rap-plan-deopt-anchor(p) == 0 ? 1 : 0 : 0 : 0 : 0 : 0 : 0;
    def ras-known-primary?(p) = (String) rap-plan-primary(p) == rap-act-run-native() ? 1 : (String) rap-plan-primary(p) == rap-act-run-program-image() ? 1 : (String) rap-plan-primary(p) == rap-act-compile-source() ? 1 : (String) rap-plan-primary(p) == rap-act-investigate() ? 1 : 0;
    def ras-selected-row(p, reason) = ras-selection(rap-plan-route(p), rap-plan-primary(p), rap-plan-fallback(p), ras-status-selected(), rap-plan-skip-parse(p), rap-plan-skip-recompute(p), reason);
    def ras-investigate-row(p, reason) = ras-selection(ras-plan-row?(p) ? rap-plan-route(p) : sad-route-invalid(), rap-act-investigate(), rap-act-none(), ras-status-investigate(), 0, 0, reason);
    def ras-refused-row() = ras-selection(sad-route-invalid(), rap-act-none(), rap-act-none(), ras-status-refused(), 0, 0, ras-reason-malformed-plan());
    def ras-selection-from-plan(p) = (Comparable) ras-plan-readable?(p) == 1 ? (String) rap-plan-primary(p) == rap-act-run-native() ? (Comparable) ras-coherent-native?(p) == 1 ? ras-selected-row(p, ras-reason-selected-native()) : (Comparable) ras-route-matches-primary?(p) == 1 ? ras-investigate-row(p, ras-reason-incoherent-native()) : ras-investigate-row(p, ras-reason-route-mismatch()) : (String) rap-plan-primary(p) == rap-act-run-program-image() ? (Comparable) ras-coherent-program-image?(p) == 1 ? ras-selected-row(p, ras-reason-selected-program-image()) : (Comparable) ras-route-matches-primary?(p) == 1 ? ras-investigate-row(p, ras-reason-incoherent-program-image()) : ras-investigate-row(p, ras-reason-route-mismatch()) : (String) rap-plan-primary(p) == rap-act-compile-source() ? (Comparable) ras-coherent-compile-source?(p) == 1 ? ras-selected-row(p, ras-reason-selected-compile-source()) : (Comparable) ras-route-matches-primary?(p) == 1 ? ras-investigate-row(p, ras-reason-incoherent-compile-source()) : ras-investigate-row(p, ras-reason-route-mismatch()) : (String) rap-plan-primary(p) == rap-act-investigate() ? (Comparable) ras-coherent-investigate?(p) == 1 ? ras-investigate-row(p, ras-reason-upstream-investigate()) : (Comparable) ras-route-matches-primary?(p) == 1 ? ras-investigate-row(p, ras-reason-incoherent-investigate()) : ras-investigate-row(p, ras-reason-route-mismatch()) : ras-investigate-row(p, ras-reason-unknown-primary()) : ras-refused-row();
}
