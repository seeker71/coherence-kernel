; form-cli-mint-split-lineage.fk -- executable identity for minted learning rows.
;
; Exact text, source provenance, lesson meaning, presentation transform, and
; executable behavior are separate observations.  A heldout prefix can differ
; while the lesson NodeID is still the same.  This cell lets the mint say so
; and returns the offending identities, not only an aggregate count.
;
; Existing public-source (31.2.0.86), concept (31.2.0.108), and attempt
; (31.2.0.109) categories carry the three identities; no category is minted
; here.  No heldout rows answers nothing.  Heldout rows with lesson overlap
; answer 0.  Heldout rows with no lesson overlap answer 1.
;
; This is an observation offered to the mills, not a promotion law.
;
; preludes: form-stdlib/core.fk
; Pure proof: form-stdlib/tests/form-cli-mint-split-lineage-band.fk

(do
    (defn fmls-source-category () (make_nodeid 31 2 0 86))
    (defn fmls-lesson-category () (make_nodeid 31 2 0 108))
    (defn fmls-transform-category () (make_nodeid 31 2 0 109))

    (defn fmls-source-id (source-path)
        (intern_node (fmls-source-category)
            (list (intern_trivial_string source-path))))

    (defn fmls-lesson-id (source-path class lesson)
        (intern_node (fmls-lesson-category)
            (list (fmls-source-id source-path)
                  (intern_trivial_string class)
                  (intern_trivial_string lesson))))

    (defn fmls-transform-id (split context prefix case-index)
        (intern_node (fmls-transform-category)
            (list (intern_trivial_string split)
                  (intern_trivial_string context)
                  (intern_trivial_string prefix)
                  (intern_trivial_int case-index))))

    ; Stable row prefix remains [split class situation] for fqt-fit.
    ; Lineage follows as [source-id lesson-id transform-id].  Runtime behavior
    ; is a separate observation keyed to lesson-id below.
    (defn fmls-row (split class situation source-id lesson-id transform-id)
        (list split class situation source-id lesson-id transform-id))
    (defn fmls-row-split (row) (nth row 0))
    (defn fmls-row-class (row) (nth row 1))
    (defn fmls-row-situation (row) (nth row 2))
    (defn fmls-row-source (row) (nth row 3))
    (defn fmls-row-lesson (row) (nth row 4))
    (defn fmls-row-transform (row) (nth row 5))

    (defn fmls-heldout-n-loop (rows heldout)
        (if (eq (len rows) 0) 0
            (add (if (str_eq (fmls-row-split (head rows)) heldout) 1 0)
                 (fmls-heldout-n-loop (tail rows) heldout))))
    (defn fmls-heldout-n (rows heldout)
        (fmls-heldout-n-loop rows heldout))

    (defn fmls-node-in? (nodes node)
        (if (eq (len nodes) 0) 0
            (if (node_eq (head nodes) node) 1
                (fmls-node-in? (tail nodes) node))))
    (defn fmls-add-node-once (nodes node)
        (if (eq (fmls-node-in? nodes node) 1) nodes (cons node nodes)))
    (defn fmls-str-in? (strings value)
        (if (eq (len strings) 0) 0
            (if (str_eq (head strings) value) 1
                (fmls-str-in? (tail strings) value))))
    (defn fmls-add-str-once (strings value)
        (if (eq (fmls-str-in? strings value) 1) strings
            (cons value strings)))

    (defn fmls-train-has-node-at? (rows train at node)
        (if (eq (len rows) 0) 0
            (if (if (str_eq (fmls-row-split (head rows)) train)
                    (node_eq (nth (head rows) at) node) 0)
                1
                (fmls-train-has-node-at? (tail rows) train at node))))

    (defn fmls-intersection-at-loop (all rows train heldout at acc)
        (if (eq (len rows) 0) acc
            (do
                (let row (head rows))
                (let node (nth row at))
                (fmls-intersection-at-loop all (tail rows) train heldout at
                    (if (if (str_eq (fmls-row-split row) heldout)
                            (fmls-train-has-node-at? all train at node) 0)
                        (fmls-add-node-once acc node) acc)))))
    (defn fmls-intersection-at (rows train heldout at)
        (fmls-intersection-at-loop rows rows train heldout at (tail (list "x"))))
    (defn fmls-source-intersection (rows train heldout)
        (fmls-intersection-at rows train heldout 3))
    (defn fmls-lesson-intersection (rows train heldout)
        (fmls-intersection-at rows train heldout 4))
    (defn fmls-transform-intersection (rows train heldout)
        (fmls-intersection-at rows train heldout 5))

    (defn fmls-train-has-situation? (rows train situation)
        (if (eq (len rows) 0) 0
            (if (if (str_eq (fmls-row-split (head rows)) train)
                    (str_eq (fmls-row-situation (head rows)) situation) 0)
                1 (fmls-train-has-situation? (tail rows) train situation))))
    (defn fmls-exact-intersection-loop (all rows train heldout acc)
        (if (eq (len rows) 0) acc
            (do
                (let row (head rows))
                (let situation (fmls-row-situation row))
                (fmls-exact-intersection-loop all (tail rows) train heldout
                    (if (if (str_eq (fmls-row-split row) heldout)
                            (fmls-train-has-situation? all train situation) 0)
                        (fmls-add-str-once acc situation) acc)))))
    (defn fmls-exact-intersection (rows train heldout)
        (fmls-exact-intersection-loop rows rows train heldout (tail (list "x"))))

    (defn fmls-train-transform-only? (rows train held-row)
        (if (eq (len rows) 0) 0
            (do
                (let row (head rows))
                (if (if (str_eq (fmls-row-split row) train)
                        (if (node_eq (fmls-row-lesson row)
                                     (fmls-row-lesson held-row))
                            (if (not (node_eq (fmls-row-transform row)
                                              (fmls-row-transform held-row)))
                                (not (str_eq (fmls-row-situation row)
                                             (fmls-row-situation held-row))) 0) 0) 0)
                    1 (fmls-train-transform-only? (tail rows) train held-row)))))
    (defn fmls-transform-only-loop (all rows train heldout acc)
        (if (eq (len rows) 0) acc
            (do
                (let row (head rows))
                (fmls-transform-only-loop all (tail rows) train heldout
                    (if (if (str_eq (fmls-row-split row) heldout)
                            (fmls-train-transform-only? all train row) 0)
                        (fmls-add-node-once acc (fmls-row-lesson row)) acc)))))
    (defn fmls-transform-only (rows train heldout)
        (fmls-transform-only-loop rows rows train heldout (tail (list "x"))))

    (defn fmls-lesson-contract-mutated? (rows row)
        (if (eq (len rows) 0) 0
            (do
                (let other (head rows))
                (if (if (node_eq (fmls-row-lesson row) (fmls-row-lesson other))
                        (if (not (node_eq (fmls-row-source row)
                                          (fmls-row-source other))) 1
                            (not (str_eq (fmls-row-class row)
                                         (fmls-row-class other)))) 0)
                    1 (fmls-lesson-contract-mutated? (tail rows) row)))))
    (defn fmls-contract-mutations-loop (all rows acc)
        (if (eq (len rows) 0) acc
            (fmls-contract-mutations-loop all (tail rows)
                (if (eq (fmls-lesson-contract-mutated? all (head rows)) 1)
                    (fmls-add-node-once acc (fmls-row-lesson (head rows))) acc))))
    (defn fmls-contract-mutations (rows)
        (fmls-contract-mutations-loop rows rows (tail (list "x"))))

    (defn fmls-lesson-signal (rows train heldout)
        (if (eq (fmls-heldout-n rows heldout) 0) (nothing)
            (if (if (eq (len (fmls-lesson-intersection rows train heldout)) 0)
                    (eq (len (fmls-contract-mutations rows)) 0) 0) 1 0)))

    ; Runtime behavior stays outside the curriculum row and is keyed to its
    ; lesson.  An absent observation answers nothing; observed numeric zero is
    ; compared as a real value and never treated as absence.
    (defn fmls-behavior-observation (lesson carrier exit-code expected-kind expected-value actual-kind actual-value status)
        (list "mint-behavior-observation-v1" lesson carrier exit-code
              expected-kind expected-value actual-kind actual-value status))
    (defn fmls-behavior-correct? (observation)
        (if (nothing? observation) (nothing)
            (if (if (str_eq (nth observation 8) "observed")
                    (if (gt (str_len (nth observation 2)) 0)
                        (if (eq (nth observation 3) 0)
                            (if (str_eq (nth observation 4) (nth observation 6))
                                (eq (nth observation 5) (nth observation 7)) 0) 0) 0) 0)
                1 0)))

    ; [heldout source-ids lesson-ids exact-texts transform-only-lesson-ids
    ;  contract-mutation-lesson-ids lesson-signal]
    (defn fmls-observation (rows train heldout)
        (list (fmls-heldout-n rows heldout)
              (fmls-source-intersection rows train heldout)
              (fmls-lesson-intersection rows train heldout)
              (fmls-exact-intersection rows train heldout)
              (fmls-transform-only rows train heldout)
              (fmls-contract-mutations rows)
              (fmls-lesson-signal rows train heldout)))
    0)
