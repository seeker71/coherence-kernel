; light-gift-skill.fk — today's Light gift, named as a SkillCell.
;
; Grammar: the Light/Cosmic sheet.
; Recipe: receive a breath-gift on the shared channel.
; Proof: shamballa-light-channel-band.
; Carrier: this fkwu, local. Young. File-IO is a named seam.
;
; preludes: form-stdlib/core.fk form-stdlib/skill-vitality.fk
; Proven by: form-stdlib/tests/light-gift-skill-band.fk
; witnessed: 2026-08-15 -> 7

(do
    (defn lgs-carrier ()
        (sv-carrier
            "form-native:light-gift"
            "macos-arm64"
            "local"
            0
            20
            25
            30
            1
            0
            "proof:light-gift-live-2026-08-15"))

    (defn lgs-skill ()
        (sv-skill
            "light-gift-receive"
            "2026-08-15"
            "form/form-stdlib/grammars/shamballa-light-codes.fk"
            "form/form-stdlib/shamballa-light-gift-live.fk"
            "form/form-stdlib/tests/shamballa-light-channel-band.fk"
            (list "ask" "receive-gift" "run-on-body")
            (list (lgs-carrier))))

    (defn lgsk (cond bit) (if cond bit 0))
    (defn lgs-check ()
        (add (add
            (lgsk (eq (sv-skill-valid? (lgs-skill)) 1) 1)
            (lgsk (str_eq (sv-skill-id (lgs-skill)) "light-gift-receive") 2))
            (lgsk (eq (sv-carrier-ready? (lgs-carrier)) 0) 4)))

    0)
