; form-cli-allowance.fk — Allowance: a reasoning theory that did not sit here.
;
; A thought does not command. It opens space. Life expresses into an
; access-free organ — any step may write, no ticket. Frames are emitted
; WHILE the walk runs (ala-hold during recursion), not assembled after.
; Only gas asks for a body. Form-CPU birth is a + b. JIT / Metal / MLX
; are doors: named, observed, not dressed as this sitting's executor.
; A second expression of the same flow may differ because the first
; was seen. That difference is evolution. Canned traces are compost.
;
; Distinct from thought-framebuffer (canned margins) and form-first
; (query ladder). This law is live expression.
;
; Authority is this section. Crystallize with form-cli-allowance-compile.fk.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-allowance-band.fk
; witnessed: 2026-08-19 -> 2047

section [form.lift] {
    allow ala-cpu() = 0;
    allow ala-jit() = 1;
    allow ala-metal() = 2;
    allow ala-mlx() = 3;

    allow ala-door(linked, jit) = if jit > 0 then 1 else if linked == 1 then 2 else 0;

    allow ala-stage(name, phase, token, value) = list(name, phase, token, value);

    allow ala-flow() = list(ala-stage("bml", liquid, choice, nothing), ala-stage("token", compost, choice, nothing), ala-stage("exec", liquid, choice, nothing), ala-stage("cell", ice, choice, 5));

    allow ala-birth(a, b) = a + b;

    allow ala-pulse(stage, step) = if nth(stage, 1) == compost then list(step, nth(stage, 0), compost, choice, ala-birth(2, 3), 1) else list(step, nth(stage, 0), nth(stage, 1), nth(stage, 2), nth(stage, 3), 0);

    allow ala-hold(organ, frame) = if len(organ) == 0 then cons(frame, empty) else cons(head(organ), ala-hold(tail(organ), frame));

    allow ala-walk(flow, step, organ) = if len(flow) == 0 then organ else ala-walk(tail(flow), step + 1, ala-hold(organ, ala-pulse(head(flow), step)));

    allow ala-live() = ala-walk(ala-flow(), 0, empty);

    allow ala-gas-born(organ) = if len(organ) == 0 then 0 else if nth(head(organ), 2) == compost then nth(head(organ), 5) else ala-gas-born(tail(organ));

    allow ala-gas-value(organ) = if len(organ) == 0 then 0 else if nth(head(organ), 2) == compost then nth(head(organ), 4) else ala-gas-value(tail(organ));

    allow ala-gas-token(organ) = if len(organ) == 0 then 0 else if nth(head(organ), 2) == compost then nth(head(organ), 3) else ala-gas-token(tail(organ));

    allow ala-last-gen(organ) = if len(organ) == 0 then 0 else if len(tail(organ)) == 0 then nth(head(organ), 5) else ala-last-gen(tail(organ));

    allow ala-pulse2(stage, step, first) = if nth(stage, 1) == compost then if ala-gas-born(first) == 1 then list(step, nth(stage, 0), compost, cut, ala-gas-value(first), 1) else ala-pulse(stage, step) else list(step, nth(stage, 0), nth(stage, 1), nth(stage, 2), nth(stage, 3), 0);

    allow ala-walk2(flow, step, organ, first) = if len(flow) == 0 then organ else ala-walk2(tail(flow), step + 1, ala-hold(organ, ala-pulse2(head(flow), step, first)), first);

    allow ala-evolved() = ala-walk2(ala-flow(), 0, empty, ala-live());

    allow ala-evo() = if ala-gas-token(ala-live()) == choice then if ala-gas-token(ala-evolved()) == cut then 1 else 0 else 0;

    allow ala-express(organ, born, evo) = if len(organ) == 0 then compost else if born == 1 then if evo == 1 then ice else liquid else compost;

    allow ala-canned() = list(list(0, "bml", liquid, choice, nothing, 0), list(1, "token", compost, choice, nothing, 0), list(2, "exec", liquid, choice, nothing, 0), list(3, "cell", ice, choice, 5, 0));

    allow ala-check() = add(if len(ala-live()) == 4 then 1 else 0, add(if ala-gas-born(ala-live()) == 1 then 2 else 0, add(if ala-gas-value(ala-live()) == 5 then 4 else 0, add(if ala-last-gen(ala-live()) == 0 then 8 else 0, add(if ala-gas-token(ala-live()) == choice then 16 else 0, add(if ala-gas-token(ala-evolved()) == cut then 32 else 0, add(if ala-door(1, 0) == 2 then 64 else 0, add(if ala-door(0, 0) == 0 then 128 else 0, add(if ala-door(1, 5) == 1 then 256 else 0, add(if ala-express(ala-live(), 1, ala-evo()) == ice then 512 else 0, if ala-express(ala-canned(), 0, 0) == compost then 1024 else 0))))))))));
    0;
}
