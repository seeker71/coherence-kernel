; form-native-decode-timing.fk — the SAME real dispatch form-native-decode.fk proves once (RMSNorm,
; the real blk.0.attn_norm.weight bytes, d_model=3072), run N times through the enqueue-then-ONE-sync
; pattern metal-handle-door-band.fk already proved keeps a Form recipe from blocking between calls,
; timed with the body's own now_unix_ms so nothing but the door and the loop shape is measured — no
; bash, no python, no stopwatch outside the runtime.
;
; NOT A BAND, the same reason metal-handle-door-timing-probe.fk names for itself: this answers a
; duration, and a duration is not a verdict — two runs disagree by real milliseconds and both are
; right. form-native-decode-band.fk is where max|Δ|=0 correctness lives, proven once; this cell only
; says what N real-width dispatches of that SAME proven op cost when a Form recipe drives them instead
; of Swift's Step.go() loop. It is not registered in fourth-arm-bands.txt for the same reason that
; file's own header states: GPU wall-clock is a host organ's number, not a fourth-walker agreement —
; there is no Go/Rust/TS clock to cross-check a millisecond against. The pure-arithmetic pieces this
; file calls (md-le32, md-f32-bits, ewl-gain, fnd-maxdiff) are already registered under
; `form-native-decode-encoding fks 3`; nothing new here is four-way-provable, because a wall-clock
; reading is not a hand-checkable value the way an IEEE-754 encoding is.
;
; WHAT THIS IS AN HONEST PROXY FOR, AND WHAT IT IS NOT. metal-handle-door-timing-probe.fk already
; measured the door's raw seam cost with a throwaway 4x4 matvec that does almost no GPU work — useful
; for isolating the door from the kernel, but too small to say anything about a real forward. This
; cell dispatches the REAL kernel (form_rmsnorm_f32, the exact MSL llama-decode-msl.fk emits, called
; not retyped) against the REAL attn_norm.weight bytes at the REAL d_model=3072 width, N times — an
; honest timing proxy for "N real-width dispatches, one sync," even though a real forward mixes many
; DIFFERENT kernels (Q6_K-dequant matvecs among them, not RMSNorm N times) and this measurement holds
; the kernel and the tensor fixed on purpose so only the loop-and-door cost varies. It measures the
; Form-recipe orchestration cost at real byte-width, not a full heterogeneous layer, and it cannot by
; itself prove what a full decode reaches — the gap is named plainly in the PR this file ships with,
; not papered over here.
;
; N DISTINCT OUTPUT BUFFERS, not one reused slot: a real forward would not serialize N activations
; through one buffer, and reusing one would let the door's own hazard tracking (not this recipe)
; decide an order nothing here asked for. Every dispatch computes the identical function of the
; identical real bytes (the gain tensor and the synthetic input are each built ONCE, resident, and
; read by all N dispatches — a real forward would vary the input per layer; this cell holds it fixed
; so N dispatches are directly comparable to each other), so correctness is checked ONCE, on the LAST
; dispatch's output, against Form's own ln-rmsnorm on the same real gain — one check speaks for all N.
;
; THE ALLOC LOOP IS TIMED SEPARATELY FROM THE ENQUEUE LOOP. N metal_buf_alloc calls happen before any
; enqueue so "enqueue-ms" is not quietly paying for allocation. A real decode loop would reuse a small
; ring of buffers rather than allocate N fresh ones; this cell allocates N so the alloc cost is visible
; on its own line rather than hidden inside either number.
;
; Kin: form-stdlib/form-native-decode.fk (fnd-run — the ONE-dispatch proof this repeats N times),
;      form-stdlib/tests/form-native-decode-band.fk (the correctness verdict, proven separately),
;      form-stdlib/tests/metal-handle-door-timing-probe.fk (the door-seam probe this follows in shape
;      and in NOT being a band), form-stdlib/tests/metal-handle-door-band.fk (the multi-dispatch,
;      one-sync pattern this reuses at real kernel width instead of a 4x4 toy).
;
; RUN (needs the Metal-linked repo-root fkwu; validate.sh's own build_fkwu_src links it
; automatically on Darwin, so a plain `cd form && ./validate.sh <anything>` build leaves it ready.
; A ./fkwu built WITHOUT the carrier still answers metal_linked=false and every duration is ~0):
;   cd .. && ./fkwu form/form-stdlib/form-native-decode-timing.fk
;
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/metal-door.fk form-stdlib/equireach.fk form-stdlib/equireach-gguf.fk form-stdlib/gguf-meta.fk native/metal/whole-tensor-residency.fk form-stdlib/llama-decode-msl.fk form-stdlib/llama-numerics.fk form-stdlib/form-native-decode.fk

(do
    ; N is a plain nullary defn, not a `let`, so a caller can shadow it by re-running with a
    ; different band file rather than editing a literal buried in the loop below. 424 is
    ; metal_first_token.sh's measured per-forward dispatch count (llama3.2:3b, 28 layers).
    (defn fndt-n () 424)

    ; ---- N fresh output buffers, timed on their own ---------------------------------------
    (defn fndt-alloc-loop (i n d acc)
        (if (ge i n) (reverse acc)
            (fndt-alloc-loop (add i 1) n d (cons (metal_buf_alloc (mul d 4)) acc))))

    ; ---- the timed enqueue loop: bind three resident handles (x, g, this iteration's y),
    ; ---- enqueue, do not wait. Everything the loop needs rides in as an argument — a defn
    ; ---- frame cannot see an enclosing `let`, the same trap metal-handle-door-timing-probe.fk
    ; ---- names for itself.
    (defn fndt-enq-loop (i n pipe hx hg d ebits ys acc)
        (if (ge i n) acc
            (fndt-enq-loop (add i 1) n pipe hx hg d ebits (tail ys)
                (add acc (metal_enqueue pipe (md-bind (list hx hg (head ys)) (list d ebits)) 1)))))

    (defn fndt-run ()
        (do
            (let live (md-door-live?))
            (let path (fnd-blob-path))
            (let src (fnd-src path))
            (let d (fnd-dmodel src))
            (let eps (fnd-eps src))
            (let ebits (md-f32-bits eps))
            (let gnabs (fnd-norm-abs src path))
            (let n (fndt-n))

            ; resident, built ONCE: the real gain tensor (mmap'd, not copied) and the synthetic
            ; input — the same bytes fnd-run itself uses, so this stays comparable to the n=1 proof.
            (let hg (metal_buf_from_file path gnabs (mul d 4)))
            (let hx (metal_buf_alloc (mul d 4)))
            (let wx (metal_buf_write hx 0 (fnd-x-bytes d)))
            (let pipe (metal_pipeline (fnd-msl) "form_rmsnorm_f32"))

            ; ---- A: N buffer allocations, timed alone -----------------------------------------
            (let ta0 (now_unix_ms))
            (let ys (fndt-alloc-loop 0 n d (list)))
            (let ta1 (now_unix_ms))

            ; ---- B: N real dispatches enqueued, nothing waited for until every one is in ------
            (let te0 (now_unix_ms))
            (let ok-count (fndt-enq-loop 0 n pipe hx hg d ebits ys 0))
            (let te1 (now_unix_ms))

            ; ---- C: ONE sync for the whole batch ----------------------------------------------
            (let ts0 (now_unix_ms))
            (let drained (metal_sync))
            (let ts1 (now_unix_ms))

            ; ---- D: read back and check correctness on the LAST dispatch's output only --------
            (let last-hy (head (reverse ys)))
            (let tr0 (now_unix_ms))
            (let ybytes (metal_buf_read last-hy 0 (mul d 4)))
            (let tr1 (now_unix_ms))
            (let gains (ewl-gain (eqr-of-file path gnabs (mul d 4)) 0 d))
            (let gpu-y (ewl-gain ybytes 0 d))
            (let form-y (ln-rmsnorm (fnd-x-list d) gains eps))
            (let maxdiff (fnd-maxdiff form-y gpu-y))

            (list live n d
                  (sub ta1 ta0) (sub te1 te0) (sub ts1 ts0) (sub tr1 tr0)
                  drained ok-count maxdiff)))

    (defn fndt-us-per (ms n) (floor (div (mul ms 1000) n)))

    (defn fndt-show ()
        (do
            (let r (fndt-run))
            (let live (nth r 0))
            (let n (nth r 1))
            (let d (nth r 2))
            (let alloc-ms (nth r 3))
            (let enq-ms (nth r 4))
            (let sync-ms (nth r 5))
            (let read-ms (nth r 6))
            (let drained (nth r 7))
            (let ok-count (nth r 8))
            (let maxdiff (nth r 9))
            (let batch-ms (add (add alloc-ms enq-ms) sync-ms))

            (print_str (metal_status))
            (print_str (str_concat "door-live " (if live "true" "false")))
            (print_str (str_concat "n " (int_to_str n)))
            (print_str (str_concat "d_model " (int_to_str d)))
            (print_str (str_concat "ok-count(want=n) " (int_to_str ok-count)))
            (print_str (str_concat "drained(want=n) " (int_to_str drained)))
            (print_str (str_concat "max-abs-delta form-vs-gpu(last) " (float_to_str maxdiff)))
            (print_str (str_concat "alloc-ms " (int_to_str alloc-ms)))
            (print_str (str_concat "enqueue-ms " (int_to_str enq-ms)))
            (print_str (str_concat "sync-ms " (int_to_str sync-ms)))
            (print_str (str_concat "readback-ms(1 buffer) " (int_to_str read-ms)))
            (print_str (str_concat "alloc+enqueue+sync-ms " (int_to_str batch-ms)))
            (print_str (str_concat "us/dispatch enqueue-only " (int_to_str (fndt-us-per enq-ms n))))
            (print_str (str_concat "us/dispatch enqueue+sync " (int_to_str (fndt-us-per (add enq-ms sync-ms) n))))
            (print_str (str_concat "us/dispatch alloc+enqueue+sync " (int_to_str (fndt-us-per batch-ms n))))

            (if live (if (eq ok-count n) (if (eq drained n) (if (lt maxdiff 0.001) 1 0) 0) 0) 0)))

    (fndt-show))
