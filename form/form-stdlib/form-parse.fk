// form-parse.fk — m4e3 path-b: a Form parser IN FORM that reads Form source
// text (a cursor over the string, no pre-tokenizer — the BMF discipline) and
// produces a Hati-OS kernel PROGRAM (cells via fk-lit/fk-add/...). Everything
// downstream — fkc-flatten, the emitter, the universal binary, the three
// walkers — then runs it unchanged. This is the bridge: real Form source ->
// a runnable program, parsed by Form itself.
//
// The grammar this first stone covers (the walker's pure-compute op set):
//   expr   := integer | '(' op expr+ ')'
//   op     := add | sub | le | if
// State threads as (cell, end-pos) lists; no let-in-defn (kernel trap), so the
// recursion is many small defns. mul/sub are full-engine ops (recipe, not band).
//
// The cursor carries real .fk file shape: whitespace is space/tab/CR/LF and a
// `;` comment runs to end of line — so a band file parses as it sits on disk
// (form-flatten.fk rides this same skip to flatten whole bands).
section [form.bml] {
    def fp-at(s, pos) = ord(char_at(s, pos));
    def fp-len(s) = str_len(s);
    def fp-isdigit(c) = c >= 48 && 57 >= c;
    def fp-isws(c) = (Comparable) c == 32 ? 1 : (Comparable) c == 10 ? 1 : (Comparable) c == 13 ? 1 : (Comparable) c == 9 ? 1 : 0;
    def fp-isdelim(c) = (Comparable) fp-isws(c) == 1 ? 1 : (Comparable) c == 40 ? 1 : (Comparable) c == 41 ? 1 : (Comparable) c == 59 ? 1 : 0;
    // end of line — the close of a `;` comment
    def fp-eol(s, pos) = pos >= fp-len(s) ? pos : (Comparable) fp-at(s, pos) == 10 ? pos + 1 : fp-eol(s, pos + 1);
    // skip whitespace and `;` comments
    def fp-skip(s, pos) = pos >= fp-len(s) ? pos : (Comparable) fp-isws(fp-at(s, pos)) == 1 ? fp-skip(s, pos + 1) : (Comparable) fp-at(s, pos) == 59 ? fp-skip(s, fp-eol(s, pos)) : pos;
    // read a run of digits from pos -> (value end-pos)
    def fp-digits(s, pos, acc) = pos >= fp-len(s) ? [acc, pos] : fp-isdigit(fp-at(s, pos)) ? fp-digits(s, pos + 1, acc * 10 + (fp-at(s, pos) - 48)) : [acc, pos];
    // end of a symbol (op name) — first delimiter at or after pos
    def fp-sym-end(s, pos) = pos >= fp-len(s) ? pos : (Comparable) fp-isdelim(fp-at(s, pos)) == 1 ? pos : fp-sym-end(s, pos + 1);
    // ── expr: integer or ( ... ) ─────────────────────────────────────────────
    def fp-expr(s, pos) = fp-expr2(s, fp-skip(s, pos));
    def fp-expr2(s, pos) = (Comparable) fp-at(s, pos) == 40 ?     // '('
fp-list(s, pos + 1) : fp-num(fp-digits(s, pos, 0));
    // integer -> (LIT v) end
    def fp-num(ve) = [fk-lit(ve[0]), ve[1]];
    // ── '(' op ... : read the op symbol, then dispatch on arity ──────────────
    def fp-list(s, pos) = fp-op(s, pos, fp-sym-end(s, pos));
    def fp-op(s, symStart, symEnd) = fp-byop(substring(s, symStart, symEnd), s, symEnd);
    // dispatch: 'if' is 3-arg, the rest 2-arg
    def fp-byop(op, s, pos) = (String) op == "if" ? fp-if(s, pos) : fp-bin(op, s, pos);
    // ── 2-arg op: parse a, parse b from a's end, close ')' ───────────────────
    def fp-bin(op, s, pos) = fp-bin-a(op, s, fp-expr(s, pos));
    def fp-bin-a(op, s, ae) = fp-bin-b(op, s, ae[0], fp-expr(s, ae[1]));
    def fp-bin-b(op, s, a, be) = [fp-mk(op, a, be[0]), fp-close(s, be[1])];
    def fp-mk(op, a, b) = (String) op == "add" ? fk-add(a, b) : (String) op == "sub" ? fk-sub(a, b) : (String) op == "le" ? fk-le(a, b) : fk-add(a, b);
    // ── 3-arg 'if': c t e then close ─────────────────────────────────────────
    def fp-if(s, pos) = fp-if-c(s, fp-expr(s, pos));
    def fp-if-c(s, ce) = fp-if-t(s, ce[0], fp-expr(s, ce[1]));
    def fp-if-t(s, c, te) = fp-if-e(s, c, te[0], fp-expr(s, te[1]));
    def fp-if-e(s, c, t, ee) = [fk-if(c, t, ee[0]), fp-close(s, ee[1])];
    // close: skip spaces then a ')' (return position after it)
    def fp-close(s, pos) = fp-skip(s, pos) >= fp-len(s) ? fp-skip(s, pos) : fp-skip(s, pos) + 1;
    // fp-parse: Form source string -> a Hati-OS kernel program (cells). The root
    // cell is the first of the (cell end-pos) pair returned by fp-expr at pos 0.
    def fp-parse(s) = fp-expr(s, 0)[0];
}
