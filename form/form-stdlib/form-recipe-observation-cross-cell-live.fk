; form-recipe-observation-cross-cell-live.fk — effectful native file crossing
; for one already-composed recipe observation. It writes the typed envelope,
; receives only the deserialized NodeID under the second identity, applies the
; two lenses, persists/reloads, and emits a payload-free receipt.
;
; This live witness does not execute a recipe, model, Metal program, or
; generated code. Its observation value 0 is scripted protocol data so the
; physical channel can prove that presence and value do not collapse.
;
; Verdict 4095 means all twelve receipt predicates agreed.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/form-recipe-observation-cross-cell.fk

(do
    (defn froclive-bit (condition bit) (if condition bit 0))
    (defn froclive-cat (parts)
        (if (eq (len parts) 0) ""
            (str_concat (head parts) (froclive-cat (tail parts)))))

    (let request (frex-parse (frex-surface (frex-recipe) 0 "auto")))
    (let result (frex-choice request
        (list (frex-offer "cpu" "value" 0 "typed-observation-data"))))
    (let channel-path
        (str_concat (temp_dir) "/form-recipe-observation-cross-cell-live.channel"))
    (let persistence-path
        (str_concat (temp_dir) "/form-recipe-observation-cross-cell-live.persistence"))
    (let crossing (froc-cross-frex channel-path persistence-path 1 result
        (str_len (frex-render result))))
    (let envelope (froc-cross-envelope crossing))
    (let emit (froc-cross-emit crossing))
    (let ack (froc-cross-ack crossing))
    (let received (froc-ack-received ack))
    (let meaning (froc-ack-meaning ack))
    (let vitality (froc-ack-vitality ack))
    (let persistence (froc-ack-persistence ack))

    (print (froclive-cat (list
        "form-recipe-observation-cross-cell-live"
        " emitter=" (froc-node-text (froc-ack-emitter ack))
        " receiver=" (froc-node-text (froc-ack-receiver ack))
        " channel=" (froc-node-text (froc-ack-channel ack))
        " observation=" (froc-node-text (froc-ack-observation ack))
        " received=" (froc-node-text received)
        " meaning=" (froc-node-text meaning)
        " vitality=" (froc-node-text vitality)
        " status=" (froc-ack-status ack)
        " present=" (int_to_str (froc-ack-value-present? ack))
        " value=" (int_to_str (froc-ack-value ack))
        " delivered=" (froc-ack-delivery-status ack)
        " transported=" (int_to_str (froc-ack-transported? ack))
        " mesh-transported=" (int_to_str (froc-ack-mesh-transported? ack))
        " persistence=" (froc-persistence-status persistence)
        " model-executed=" (int_to_str (froc-ack-model-executed? ack))
        " recipe-executed=" (int_to_str (frex-result-executed? result))
        " native-code-generated="
            (int_to_str (frex-result-native-code-generated? result))
        "\n")))

    (sum (list
        (froclive-bit (not (node_eq (froc-ack-emitter ack)
                                    (froc-ack-receiver ack))) 1)
        (froclive-bit (node_eq (froc-ack-envelope ack) envelope) 2)
        (froclive-bit (node_eq (froc-ack-observation ack)
                               (frex-result-observation result)) 4)
        (froclive-bit (and (str_eq (froc-ack-status ack) "value")
                           (eq (froc-ack-value-present? ack) 1)) 8)
        (froclive-bit (eq (froc-ack-value ack) 0) 16)
        (froclive-bit (and (str_eq (froc-ack-delivery-status ack) "delivered")
                           (eq (froc-ack-transported? ack) 1)) 32)
        (froclive-bit (eq (froc-ack-mesh-transported? ack) 0) 64)
        (froclive-bit (eq (froc-lenses-preserve-source?
                            (list meaning vitality) envelope) 1) 128)
        (froclive-bit (and (str_eq (froc-lens-name meaning) "meaning")
                           (str_eq (froc-lens-name vitality) "vitality")) 256)
        (froclive-bit (and (str_eq (froc-persistence-status persistence)
                                   "reloaded")
                           (node_eq (froc-persistence-received persistence)
                                    received)) 512)
        (froclive-bit (and (eq (froc-ack-model-executed? ack) 0)
                           (eq (frex-result-executed? result) 0)) 1024)
        (froclive-bit (and (eq (frex-result-native-code-generated? result) 0)
                           (eq (froc-emit-count emit) 1)) 2048))))
