// Natural-language transcripts from the native ear's already-decoded rows.
// No source-tree sampling, proof walker, translation call, or microphone action.
// Authority: form/form-stdlib/form-glass-meaning-ui.bml
import form/form-stdlib/form-glass-dashboard.bml;
import form/form-stdlib/bml/ear-transcript.bml;
section [form.bml] {
    class FormGlassMeaningUI {
        field FGLMSchema = "form-glass-transcripts-v1";
        def fglm-langs() = tln-rows();
        def fglm-key(lang) = lang[0];
        def fglm-lang-key?(key) = tln-known?(key);
        def fglm-selection(filter) = tln-selected-rows(fglm-langs(), filter);
        def fglm-selected-count(filter) = len(fglm-selection(filter));
        def fglm-toggle(filter, key) = if ((String) filter == "all") then key else tln-toggle(filter, key);
        def fglm-shortcuts(rows, n) = if ((Comparable) len(rows) == 0) then "" else ((String) fgd-cat([n.str(), " ", rows[0][1], " "]) + fglm-shortcuts(rows[1:], (n + 1)));
        def fglm-key-help() = (fglm-shortcuts(tln-defaults(), 1) + "| 0 none | l languages");
        def fglm-row(text, width, id, evidence) = fgd-segment-line(fgd-fit(text, width), width, fgd-neutral(220), id, ["transcript", "ear"], evidence);
        def fglm-transcripts(rows) = if ((Comparable) len(rows) == 0) then [] else if ((Comparable) etr-row?(rows[0]) == 1) then cons(rows[0], fglm-transcripts(rows[1:])) else fglm-transcripts(rows[1:]);
        def fglm-for-code(rows, code) = if ((Comparable) len(rows) == 0) then [] else if ((String) etr-code(rows[0]) == code) then cons(rows[0], fglm-for-code(rows[1:], code)) else fglm-for-code(rows[1:], code);
        def fglm-published-codes(rows, codes) = if ((Comparable) len(rows) == 0) then codes else fglm-published-codes(rows[1:], if ((Comparable) tln-member?(codes, etr-code(rows[0])) == 1) then codes else append(codes, [etr-code(rows[0])]));
        def fglm-ordered-codes(codes, order) = if ((Comparable) len(order) == 0) then [] else if tln-member?(codes, order[0]) then cons(order[0], fglm-ordered-codes(codes, order[1:])) else fglm-ordered-codes(codes, order[1:]);
        def fglm-unknown-codes(codes) = if ((Comparable) len(codes) == 0) then [] else if tln-known?(codes[0]) then fglm-unknown-codes(codes[1:]) else cons(codes[0], fglm-unknown-codes(codes[1:]));
        def fglm-all-codes(codes) = append(fglm-ordered-codes(codes, tln-keys(tln-rows())), fglm-unknown-codes(codes));
        def fglm-shown-codes(rows, filter) = if ((String) filter == "none") then [] else if ((String) filter == "all") then fglm-all-codes(fglm-published-codes(rows, [])) else tln-keys(fglm-selection(filter));
        // Conservative byte-budget wrap: never emit half a UTF-8 character.
        def fglm-char-bytes(b) = if (b < 128) then 1 else if (b < 224) then 2 else if (b < 240) then 3 else 4;
        def fglm-cut(text, at, end) = if (at >= len(text)) then at else if ((at + fglm-char-bytes(str_byte_at(text, at))) > end) then at else fglm-cut(text, (at + fglm-char-bytes(str_byte_at(text, at))), end);
        def fglm-clean(text, at, out) = if (at >= len(text)) then out else fglm-clean(text, (at + 1), ((String) out + (if ((str_byte_at(text, at) < 32) || ((Comparable) str_byte_at(text, at) == 127)) then " " else byte_to_str(str_byte_at(text, at)))));
        // The live body stays bytes. Visit only visible spans, never allocate every
        // growing text prefix or copy an off-screen transcript suffix each line.
        // fglm-clean remains a string compatibility door for bounded callers.
        def fglm-clean-byte(byte) = if ((byte < 32) || ((Comparable) byte == 127)) then 32 else byte;
        def fglm-clean-span(text, at, end) = if (at >= end) then [] else cons(fglm-clean-byte(str_byte_at(text, at)), fglm-clean-span(text, (at + 1), end));
        def fglm-byte-row(bytes, id, evidence) = [ftc-segment(ftc-byte-text(bytes), fgd-neutral(220), "none", id, ["transcript", "ear"], evidence)];
        def fglm-wrap(text, width, id, evidence, left) = fglm-wrap-at(text, 0, width, id, evidence, left);
        def fglm-wrap-at(text, at, width, id, evidence, left) {
            let end = fglm-cut(text, at, (at + width));
            if ((left <= 0) || (end <= at)) then []
            else cons(fglm-byte-row(fglm-clean-span(text, at, end), id, evidence),
                if (end >= len(text)) then [] else if ((Comparable) left == 1) then [fglm-row("[continued text exceeds this panel]", width, id, evidence)] else fglm-wrap-at(text, end, width, id, evidence, (left - 1)));
        }
        def fglm-transcript-lines(row, width) = fglm-transcript-lines-at(row, width, fglm-slot-lines());
        def fglm-transcript-lines-at(row, width, slots) {
            let headText = fgd-cat([tln-label(etr-code(row)), " | ", fgo-label(row), " | ", fgo-evidence(row), fgd-metric-age(row)]);
            cons(fglm-row(headText, width, ("selector." + fgd-metric-selector(row)), fgo-evidence(row)), fglm-slot-wrap(fgd-metric-value(row), 0, width, ("selector." + fgd-metric-selector(row)), fgo-evidence(row), (slots - 1)));
        }
        // Ellipsis occupies the last visible line, never a new line outside the slot.
        def fglm-slot-wrap(text, at, width, id, evidence, left) {
            let end = fglm-cut(text, at, (at + width));
            let clipped = (((Comparable) left == 1) && (end < len(text)));
            let cut = if (clipped && (width >= 3)) then fglm-cut(text, at, (at + (width - 3))) else end;
            let bytes = append(fglm-clean-span(text, at, cut), if (clipped && (width >= 3)) then [46, 46, 46] else []);
            if ((left <= 0) || (end <= at)) then [] else cons(fglm-byte-row(bytes, id, evidence), if (clipped || (end >= len(text))) then [] else fglm-slot-wrap(text, end, width, id, evidence, (left - 1)));
        }
        // One stable-height slot per selected language. Partials becoming final,
        // wrapping, or arriving in another tongue cannot move the other slots.
        def fglm-slot-lines() = 5;
        def fglm-pad-slot(lines, code, width) = fglm-pad-slot-at(lines, code, width, fglm-slot-lines());
        def fglm-pad-slot-at(lines, code, width, slots) = if (len(lines) >= slots) then lines else fglm-pad-slot-at(append(lines, [fglm-row("", width, ("transcript.space." + code), "declared")]), code, width, slots);
        def fglm-code-lines(rows, code, width) = fglm-code-lines-at(rows, code, width, fglm-slot-lines());
        def fglm-code-lines-at(rows, code, width, slots) = fglm-pad-slot-at(if ((Comparable) len(rows) == 0) then [fglm-row(fgd-cat([tln-label(code), ": no transcript/translation published; ear-organ owes ", code]), width, ("transcript.missing." + code), "unavailable")] else fglm-transcript-lines-at(etr-latest(rows), width, slots), code, width, slots);
        def fglm-present-lines(rows, width) = if ((Comparable) len(rows) == 0) then [] else append(fglm-transcript-lines(rows[0], width), fglm-present-lines(rows[1:], width));
        def fglm-codes-lines(rows, codes, width) = if ((Comparable) len(codes) == 0) then [] else append(fglm-code-lines(fglm-for-code(rows, codes[0]), codes[0], width), fglm-codes-lines(rows, codes[1:], width));
        def fglm-codes-lines-at(rows, codes, width, slots) = if ((Comparable) len(codes) == 0) then [] else append(fglm-code-lines-at(fglm-for-code(rows, codes[0]), codes[0], width, slots), fglm-codes-lines-at(rows, codes[1:], width, slots));
        def fglm-state(rows) = if ((Comparable) len(rows) == 0) then "ear publisher unavailable" else if ((String) fgo-id(rows[0]) == "ear.state") then fgd-metric-value(rows[0]) else fglm-state(rows[1:]);
        def fglm-lines(metrics, filter, epoch, width) = fglm-lines-fit(metrics, filter, epoch, width, 999);
        def fglm-lines-fit(metrics, filter, epoch, width, count) {
            let rows = fglm-transcripts(metrics);
            let codes = fglm-shown-codes(rows, filter);
            let slots = fgd-clamp((fgd-max(0, (count - 3)) / fgd-max(1, len(codes))), 2, fglm-slot-lines());
            let header = [fgd-title-segment-line("LIVE TRANSCRIPTS / NATURAL LANGUAGES", width, "section.meaning"), fglm-row(fglm-key-help(), width, "transcript.keys", "declared"), fglm-row(("display=" + filter), width, "transcript.selection", "declared")];
            let body = if ((String) filter == "none") then [fglm-row("No transcript languages selected; 1-4 toggle, l enters codes (en+de).", width, "transcript.none", "declared")] else if ((Comparable) len(codes) == 0) then [fglm-row(("No live transcript: " + fglm-state(metrics)), width, "transcript.waiting", "unavailable")] else fglm-codes-lines-at(rows, codes, width, slots);
            append(header, body);
        }
    }
    0;
}
