// Natural-language transcripts from the native ear's already-decoded rows.
// No source-tree sampling, proof walker, translation call, or microphone action.
// Authority: form/form-stdlib/bml/form-glass-meaning-ui.bml
// preludes: form/form-stdlib/form-glass-dashboard.bml form/form-stdlib/bml/ear-transcript.bml
section [form.bml] {
    class FormGlassMeaningUI {
        field FGLMSchema = "form-glass-transcripts-v1";
        def fglm-langs() = tln-rows();
        def fglm-key(lang) = head(lang);
        def fglm-lang-key?(key) = tln-known?(key);
        def fglm-selected?(filter, key) = tln-selected?(filter, key);
        def fglm-selection(filter) = tln-selected-rows(fglm-langs(), filter);
        def fglm-selected-count(filter) = len(fglm-selection(filter));
        def fglm-toggle(filter, key) = if str_eq(filter, "all") then key else tln-toggle(filter, key);
        def fglm-shortcuts(rows, n) = if eq(len(rows), 0) then "" else str_concat(fgd-cat(list(int_to_str(n), " ", nth(head(rows), 1), " ")), fglm-shortcuts(tail(rows), add(n, 1)));
        def fglm-key-help() = str_concat(fglm-shortcuts(tln-defaults(), 1), "| 0 none | l languages");
        def fglm-row(text, width, id, evidence) = fgd-segment-line(fgd-fit(text, width), width, fgd-neutral(220), id, list("transcript", "ear"), evidence);
        def fglm-transcripts(rows) = if eq(len(rows), 0) then list() else if eq(etr-row?(head(rows)), 1) then cons(head(rows), fglm-transcripts(tail(rows))) else fglm-transcripts(tail(rows));
        def fglm-for-code(rows, code) = if eq(len(rows), 0) then list() else if str_eq(etr-code(head(rows)), code) then cons(head(rows), fglm-for-code(tail(rows), code)) else fglm-for-code(tail(rows), code);
        def fglm-published-codes(rows, codes) = if eq(len(rows), 0) then codes else fglm-published-codes(tail(rows), if eq(tln-member?(codes, etr-code(head(rows))), 1) then codes else append(codes, list(etr-code(head(rows)))));
        def fglm-shown-codes(rows, filter) = if str_eq(filter, "none") then list() else if str_eq(filter, "all") then fglm-published-codes(rows, list()) else tln-keys(fglm-selection(filter));
        // Conservative byte-budget wrap: never emit half a UTF-8 character.
        def fglm-char-bytes(b) = if lt(b, 128) then 1 else if lt(b, 224) then 2 else if lt(b, 240) then 3 else 4;
        def fglm-cut(text, at, end) = if ge(at, str_len(text)) then at else if gt(add(at, fglm-char-bytes(str_byte_at(text, at))), end) then at else fglm-cut(text, add(at, fglm-char-bytes(str_byte_at(text, at))), end);
        def fglm-clean(text, at, out) = if ge(at, str_len(text)) then out else fglm-clean(text, add(at, 1), str_concat(out, if or(lt(str_byte_at(text, at), 32), eq(str_byte_at(text, at), 127)) then " " else byte_to_str(str_byte_at(text, at))));
        def fglm-wrap(text, width, id, evidence, left) {
            let end = fglm-cut(text, 0, width);
            if or(le(left, 0), le(end, 0)) then list()
            else if ge(end, str_len(text)) then list(fglm-row(text, width, id, evidence))
            else cons(fglm-row(substring(text, 0, end), width, id, evidence), if eq(left, 1) then list(fglm-row("[continued text exceeds this panel]", width, id, evidence)) else fglm-wrap(substring(text, end, str_len(text)), width, id, evidence, sub(left, 1)));
        }
        def fglm-transcript-lines(row, width) {
            let headText = fgd-cat(list(tln-label(etr-code(row)), " | ", fgo-label(row), " | ", fgo-evidence(row), fgd-metric-age(row)));
            cons(fglm-row(headText, width, str_concat("selector.", fgd-metric-selector(row)), fgo-evidence(row)), fglm-wrap(fglm-clean(fgd-metric-value(row), 0, ""), width, str_concat("selector.", fgd-metric-selector(row)), fgo-evidence(row), 4));
        }
        def fglm-code-lines(rows, code, width) = if eq(len(rows), 0) then list(fglm-row(fgd-cat(list(tln-label(code), ": no transcript/translation published; ear-organ owes ", code)), width, str_concat("transcript.missing.", code), "unavailable")) else fglm-present-lines(rows, width);
        def fglm-present-lines(rows, width) = if eq(len(rows), 0) then list() else append(fglm-transcript-lines(head(rows), width), fglm-present-lines(tail(rows), width));
        def fglm-codes-lines(rows, codes, width) = if eq(len(codes), 0) then list() else append(fglm-code-lines(fglm-for-code(rows, head(codes)), head(codes), width), fglm-codes-lines(rows, tail(codes), width));
        def fglm-state(rows) = if eq(len(rows), 0) then "ear publisher unavailable" else if str_eq(fgo-id(head(rows)), "ear.state") then fgd-metric-value(head(rows)) else fglm-state(tail(rows));
        def fglm-lines(metrics, filter, epoch, width) {
            let rows = fglm-transcripts(metrics);
            let codes = fglm-shown-codes(rows, filter);
            let header = list(fgd-title-segment-line("LIVE TRANSCRIPTS / NATURAL LANGUAGES", width, "section.meaning"), fglm-row(fglm-key-help(), width, "transcript.keys", "declared"), fglm-row(str_concat("display=", filter), width, "transcript.selection", "declared"));
            let body = if str_eq(filter, "none") then list(fglm-row("No transcript languages selected; 1-4 toggle, l enters codes (en+de).", width, "transcript.none", "declared")) else if eq(len(codes), 0) then list(fglm-row(str_concat("No live transcript: ", fglm-state(metrics)), width, "transcript.waiting", "unavailable")) else fglm-codes-lines(rows, codes, width);
            append(header, body);
        }
    }
    0;
}
