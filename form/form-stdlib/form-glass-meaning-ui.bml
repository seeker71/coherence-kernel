//////////////////////////////////////////////////////////////////////
//
// form-glass-meaning-ui.bml — live symbol and code-to-meaning sampling.
//
// Authority: form-stdlib/bml/form-glass-meaning-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-dashboard.bml
//
// Four dialects carry BMF categories in the reviewed table: GO, PY, RS, TS.
// Zero to four of them are selected at once; the selection is the view filter,
// so it travels through the existing correlated control offer and needs no
// second state channel.
//
// Nothing here is a fixture.  Each frame reads a bounded window of the real
// grammar beside a bounded window of that language's real source in this tree,
// and the category's NodeID is read from the dialect table by name.  A sample
// that is not found says so by name and is never replaced with a plausible one.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassMeaningUIAuthority {
        field FGLMAuthorityPath = "form/form-stdlib/bml/form-glass-meaning-ui.bml";
        field FGLMAuthorityKind = "high-bml-interface-class-const";
    }

    class FormGlassMeaningUI {
        field FGLMSchema = "form-glass-meaning-ui-v1";
        field FGLMCategoryTable = "form/form-stdlib/dialect-categories.fk";
        field FGLMCategoryDoor = "dialect-categories";
        field FGLMWindow = 4096;
        field FGLMRuleStride = 1153;
        field FGLMMeaningStride = 2477;
        field FGLMSourceStride = 617;
        field FGLMProbeTries = 40;
        ref fglm-authority = FormGlassMeaningUIAuthority;
        thought fglm-law = list("no-fixture-samples", "bounded-windows", "absent-says-absent", "selection-is-the-filter", "zero-to-four", "category-nodeid-named-with-its-door");

        def fglm-lang(key, prefix, grammar, root, suffix, plane) = list("glass-meaning-lang-v1", key, prefix, grammar, root, suffix, plane);
        def fglm-key(l) = nth(l, 1);
        def fglm-prefix(l) = nth(l, 2);
        def fglm-grammar(l) = nth(l, 3);
        def fglm-root(l) = nth(l, 4);
        def fglm-suffix(l) = nth(l, 5);
        def fglm-plane(l) = nth(l, 6);
        def fglm-langs() = list(
            fglm-lang("go", "GO", "form/form-stdlib/grammars/go-bmf.fk", "form/form-kernel-go", ".go", "cpu"),
            fglm-lang("py", "PY", "form/form-stdlib/grammars/python-bmf.fk", "form/scripts", ".py", "form"),
            fglm-lang("rs", "RS", "form/form-stdlib/grammars/rust-bmf.fk", "form/form-kernel-rust/src", ".rs", "metal"),
            fglm-lang("ts", "TS", "form/form-stdlib/grammars/typescript-bmf.fk", "form/form-kernel-ts/src", ".ts", "unified"));

        // --- selection: zero to four, carried as the view filter -----------
        def fglm-none?(filter) = if str_eq(filter, "none") then 1 else if str_eq(filter, "") then 1 else 0;
        def fglm-selected?(filter, key) = if eq(fglm-none?(filter), 1) then 0 else if str_eq(filter, "all") then 1 else if ge(str_find(filter, key, 0), 0) then 1 else 0;
        def fglm-selected-langs(langs, filter) = if eq(len(langs), 0) then list() else if eq(fglm-selected?(filter, fglm-key(head(langs))), 1) then cons(head(langs), fglm-selected-langs(tail(langs), filter)) else fglm-selected-langs(tail(langs), filter);
        def fglm-selection(filter) = fglm-selected-langs(fglm-langs(), filter);
        def fglm-selected-count(filter) = len(fglm-selection(filter));
        def fglm-toggle-cons(lang, rest, filter, key) {
            let k = fglm-key(lang);
            let was = fglm-selected?(filter, k);
            let now = if str_eq(k, key) then sub(1, was) else was;
            if eq(now, 1) then cons(k, rest) else rest;
        }
        def fglm-toggle-list(langs, filter, key) = if eq(len(langs), 0) then list() else fglm-toggle-cons(head(langs), fglm-toggle-list(tail(langs), filter, key), filter, key);
        def fglm-join-keys(keys) = if eq(len(keys), 0) then "none" else if eq(len(keys), 1) then head(keys) else str_concat(head(keys), str_concat("+", fglm-join-keys(tail(keys))));
        def fglm-toggle(filter, key) = fglm-join-keys(fglm-toggle-list(fglm-langs(), filter, key));
        def fglm-lang-key?(key) = if str_eq(key, "go") then 1 else if str_eq(key, "py") then 1 else if str_eq(key, "rs") then 1 else if str_eq(key, "ts") then 1 else 0;

        // --- bounded windows over real files -------------------------------
        // A window opens mid-line, so its first partial line is dropped before
        // anything is read from it.  Rules and emitters sit in one region of a
        // grammar, so a single window often holds neither: the probe walks a
        // bounded number of offsets and takes the first window that carries the
        // needle, rather than reporting absent from one unlucky landing.
        def fglm-rotate(size, seed, stride) {
            let span = sub(size, FGLMWindow());
            if le(span, 0) then 0 else sub(mul(seed, stride), mul(div(mul(seed, stride), span), span));
        }
        def fglm-nl-index(text, i) = if ge(i, str_len(text)) then -1 else if eq(str_byte_at(text, i), 10) then i else fglm-nl-index(text, add(i, 1));
        def fglm-body(w) {
            let nl = fglm-nl-index(w, 0);
            if lt(nl, 0) then w else substring(w, add(nl, 1), str_len(w));
        }
        def fglm-window-at(path, size, seed, stride) = if le(size, 0) then "" else fglm-body(read_file_slice(path, fglm-rotate(size, seed, stride), FGLMWindow()));
        def fglm-step-window(path, size, base, step) = if le(size, 0) then "" else fglm-body(read_file_slice(path, sub(base, mul(div(base, size), size)), FGLMWindow()));
        def fglm-probe-at(path, size, offset, needle, tries) {
            let at = sub(offset, mul(div(offset, size), size));
            let w = fglm-body(read_file_slice(path, at, FGLMWindow()));
            if ge(str_find(w, needle, 0), 0) then w else if le(tries, 0) then "" else fglm-probe-at(path, size, add(at, FGLMWindow()), needle, sub(tries, 1));
        }
        def fglm-probe(path, seed, stride, needle) {
            let size = file_size(path);
            if le(size, 0) then "" else fglm-probe-at(path, size, fglm-rotate(size, seed, stride), needle, FGLMProbeTries());
        }
        def fglm-line-start(text, pos) = if le(pos, 0) then 0 else if eq(str_byte_at(text, sub(pos, 1)), 10) then pos else fglm-line-start(text, sub(pos, 1));
        def fglm-line-end(text, pos) = if ge(pos, str_len(text)) then pos else if eq(str_byte_at(text, pos), 10) then pos else fglm-line-end(text, add(pos, 1));
        def fglm-line-at(text, pos) = substring(text, fglm-line-start(text, pos), fglm-line-end(text, pos));
        def fglm-space?(b) = if eq(b, 32) then 1 else if eq(b, 9) then 1 else 0;
        def fglm-lstrip-go(text, i) = if ge(i, str_len(text)) then "" else if eq(fglm-space?(str_byte_at(text, i)), 1) then fglm-lstrip-go(text, add(i, 1)) else substring(text, i, str_len(text));
        def fglm-lstrip(text) = if eq(str_len(text), 0) then "" else fglm-lstrip-go(text, 0);

        // --- the symbol side: a real rule of that language's grammar -------
        def fglm-rule-sample(lang, frame) {
            let w = fglm-probe(fglm-grammar(lang), frame, FGLMRuleStride(), "::=");
            let at = str_find(w, "::=", 0);
            if lt(at, 0) then "" else fglm-lstrip(fglm-line-at(w, at));
        }

        // --- the meaning side: the category the emitter interns ------------
        def fglm-cat-char?(b) = if and(ge(b, 65), le(b, 90)) then 1 else if eq(b, 45) then 1 else if and(ge(b, 48), le(b, 57)) then 1 else 0;
        def fglm-token-end(text, i) = if ge(i, str_len(text)) then i else if eq(fglm-cat-char?(str_byte_at(text, i)), 1) then fglm-token-end(text, add(i, 1)) else i;
        def fglm-category-sample(lang, frame) {
            let needle = str_concat("intern_node ", str_concat(fglm-prefix(lang), "-BMF-"));
            let w = fglm-probe(fglm-grammar(lang), frame, FGLMMeaningStride(), needle);
            let at = str_find(w, needle, 0);
            let start = add(at, str_len("intern_node "));
            if lt(at, 0) then "" else substring(w, start, fglm-token-end(w, start));
        }
        def fglm-digit?(b) = if and(ge(b, 48), le(b, 57)) then 1 else 0;
        def fglm-int-end(text, i) = if ge(i, str_len(text)) then i else if eq(fglm-digit?(str_byte_at(text, i)), 1) then fglm-int-end(text, add(i, 1)) else i;
        def fglm-inst-of(category) {
            let table = read_file(FGLMCategoryTable());
            let needle = str_concat("(let ", str_concat(category, " (intern_trivial_int "));
            let at = str_find(table, needle, 0);
            let start = add(at, str_len(needle));
            if lt(at, 0) then -1 else str_to_int(substring(table, start, fglm-int-end(table, start)));
        }
        def fglm-nodeid-text(category) {
            let inst = fglm-inst-of(category);
            if lt(inst, 0) then "no-row" else str_concat("@1.2.99.", int_to_str(inst));
        }

        // --- the code side: a real line of that language in this tree ------
        def fglm-named?(name, suffix) = fgo-suffix?(name, suffix);
        def fglm-with-suffix(names, suffix) = if eq(len(names), 0) then list() else if eq(fglm-named?(head(names), suffix), 1) then cons(head(names), fglm-with-suffix(tail(names), suffix)) else fglm-with-suffix(tail(names), suffix);
        def fglm-pick(names, frame) = if eq(len(names), 0) then "" else nth(names, sub(frame, mul(div(frame, len(names)), len(names))));
        def fglm-code-line?(line) {
            let t = fglm-lstrip(line);
            if lt(str_len(t), 4) then 0 else if eq(str_find(t, "//", 0), 0) then 0 else if eq(str_find(t, "#", 0), 0) then 0 else if eq(str_find(t, "*", 0), 0) then 0 else 1;
        }
        def fglm-code-scan(w, pos, tries) {
            let line = fglm-lstrip(fglm-line-at(w, pos));
            let nextPos = add(fglm-line-end(w, pos), 1);
            if le(tries, 0) then "" else if eq(fglm-code-line?(line), 1) then line else if ge(nextPos, str_len(w)) then "" else fglm-code-scan(w, nextPos, sub(tries, 1));
        }
        def fglm-source-sample(lang, frame) {
            let names = fglm-with-suffix(fs_list(fglm-root(lang)), fglm-suffix(lang));
            let name = fglm-pick(names, frame);
            let path = if str_eq(name, "") then "" else fgo-join(fglm-root(lang), name);
            let w = if str_eq(path, "") then "" else fglm-window-at(path, file_size(path), frame, FGLMSourceStride());
            list(name, if str_eq(w, "") then "" else fglm-code-scan(w, 0, 24));
        }

        // --- rows -----------------------------------------------------------
        def fglm-row(text, width, plane, id, evidence) = fgd-segment-line(fgd-fit(text, width), width, fgd-style-for-plane(plane, 200, 0), id, list("meaning", "grammar", plane), evidence);
        def fglm-rule-row(lang, frame, width) {
            let rule = fglm-rule-sample(lang, frame);
            let absent = str_eq(rule, "");
            let text = if eq(absent, 1) then fgd-cat(list(fglm-key(lang), " ::= UNAVAILABLE door=", fglm-grammar(lang), " reason=no-rule-in-window")) else fgd-cat(list(fglm-key(lang), " ::= ", rule));
            fglm-row(text, width, fglm-plane(lang), str_concat("meaning.rule.", fglm-key(lang)), if eq(absent, 1) then "unavailable" else "physical-live");
        }
        def fglm-meaning-row(lang, frame, width) {
            let category = fglm-category-sample(lang, frame);
            let sample = fglm-source-sample(lang, frame);
            let name = nth(sample, 0);
            let code = nth(sample, 1);
            let codeText = if str_eq(code, "") then "UNAVAILABLE door=source-window reason=no-code-line" else code;
            let meaning = if str_eq(category, "") then "UNAVAILABLE door=grammar-window reason=no-intern-node" else fgd-cat(list(category, " ", fglm-nodeid-text(category), " ", FGLMCategoryDoor()));
            let text = fgd-cat(list(fglm-key(lang), " -> ", meaning, " | ", name, ": ", codeText));
            fglm-row(text, width, fglm-plane(lang), str_concat("meaning.sample.", fglm-key(lang)), if str_eq(category, "") then "unavailable" else "physical-live");
        }
        def fglm-lang-rows(langs, frame, width) = if eq(len(langs), 0) then list() else append(list(fglm-rule-row(head(langs), frame, width), fglm-meaning-row(head(langs), frame, width)), fglm-lang-rows(tail(langs), frame, width));
        def fglm-roster-text(langs, filter) = if eq(len(langs), 0) then "" else str_concat(fgd-cat(list(if eq(fglm-selected?(filter, fglm-key(head(langs))), 1) then "[" else " ", fglm-key(head(langs)), if eq(fglm-selected?(filter, fglm-key(head(langs))), 1) then "]" else " ")), fglm-roster-text(tail(langs), filter));
        def fglm-header-row(filter, width) = fglm-row(fgd-cat(list("select 1 go  2 py  3 rs  4 ts  0 none   selected=", int_to_str(fglm-selected-count(filter)), "/4  ", fglm-roster-text(fglm-langs(), filter))), width, "membrane", "meaning.selection", "declared");
        def fglm-empty-row(width) = fglm-row("no language selected; press 1-4 to sample a dialect, 0 clears", width, "membrane", "meaning.none", "declared");
        def fglm-lines(filter, frame, width) {
            let langs = fglm-selection(filter);
            let title = fgd-title-segment-line("SYMBOL / CODE -> MEANING (live grammar + live source)", width, "section.meaning");
            let body = if eq(len(langs), 0) then list(fglm-empty-row(width)) else fglm-lang-rows(langs, frame, width);
            append(list(title, fglm-header-row(filter, width)), body);
        }
        def fglm-right-lines(filter, width) {
            let langs = fglm-selection(filter);
            let title = fgd-title-segment-line("DIALECT ROSTER", width, "section.meaning.right");
            append(list(title), fglm-roster-rows(fglm-langs(), filter, width));
        }
        def fglm-roster-rows(langs, filter, width) = if eq(len(langs), 0) then list() else cons(fglm-roster-row(head(langs), filter, width), fglm-roster-rows(tail(langs), filter, width));
        def fglm-roster-row(lang, filter, width) = fglm-row(fgd-cat(list(if eq(fglm-selected?(filter, fglm-key(lang)), 1) then "* " else "  ", fglm-key(lang), " ", fglm-prefix(lang), "-BMF-* ", fglm-root(lang))), width, fglm-plane(lang), str_concat("meaning.roster.", fglm-key(lang)), "catalog");
    }
    0;
}
