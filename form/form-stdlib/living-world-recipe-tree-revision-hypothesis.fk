; living-world-recipe-tree-revision-hypothesis.fk -- admit an exact successor
; hypothesis only after a composition-scoped independent trial is current.
;
; A match requires exact composition, Recipe, retained re-execution, and
; prospective re-execution identity.  Construction and trial source fields
; remain disjoint.  Alternatives and unknowns stay visible.  Admission grants
; no Recipe, answer, voice, or promotion authority.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk

(let LWRTRH-MATCH  (bp "LWRTRH-MATCH"))
(let LWRTRH-FIELD  (bp "LWRTRH-FIELD"))
(let LWRTRH-ORIGIN (bp "LWRTRH-ORIGIN"))

; children: exact composition/trial parents, exact composition/trial/Recipe,
; re-executed retained/prospective observations, source sets, alternatives,
; unknowns, local path.
(defn lwrtrh-match
    (composition-candidate trial-candidate composition trial recipe retained
     prospective construction-sources trial-sources alternatives unknowns)
    (intern_node LWRTRH-MATCH
        (list composition-candidate trial-candidate composition trial recipe
              retained prospective construction-sources trial-sources
              alternatives unknowns (lwo-local-path))))
(defn lwrtrh-match? (cell) (lwo-category? cell LWRTRH-MATCH))
(defn lwrtrh-match-composition-candidate (match)
    (nth (node_children match) 0))
(defn lwrtrh-match-trial-candidate (match)
    (nth (node_children match) 1))
(defn lwrtrh-match-composition (match) (nth (node_children match) 2))
(defn lwrtrh-match-trial (match) (nth (node_children match) 3))
(defn lwrtrh-match-recipe (match) (nth (node_children match) 4))
(defn lwrtrh-match-retained (match) (nth (node_children match) 5))
(defn lwrtrh-match-prospective (match) (nth (node_children match) 6))
(defn lwrtrh-match-construction-sources (match)
    (nth (node_children match) 7))
(defn lwrtrh-match-trial-sources (match) (nth (node_children match) 8))
(defn lwrtrh-match-alternatives (match) (nth (node_children match) 9))
(defn lwrtrh-match-unknowns (match) (nth (node_children match) 10))

(defn lwrtrh-match-for
    (composition-candidate trial-candidate composition trial)
    (do
        (let evidence (lwrtrt-trial-evidence trial))
        (let candidate (lwrtrt-evidence-candidate evidence))
        (let recipe (lwrtr-composition-recipe composition))
        (let construction-sources
            (lwrtrt-trial-construction-sources trial))
        (let trial-sources (lwrtrt-trial-sources trial))
        (let unknown (lwrtrt-candidate-unknown candidate))
        (let unknowns
            (lwrtr-union-items
                (lwo-field-items (lwrtr-composition-unknowns composition))
                (if (node_eq unknown (lwo-none)) (lwo-empty-field)
                    (lwo-field (list unknown)))))
        (if (or (not (node_eq composition
                        (lwrtrt-candidate-composition candidate)))
                (or (not (node_eq recipe
                            (lwrtrt-candidate-recipe candidate)))
                    (or (not (node_eq
                                (lwrtrt-trial-retained trial)
                                (lwrtr-composition-retained composition)))
                        (or (not (node_eq
                                    (lwrtrt-trial-prospective trial)
                                    (lwrtr-composition-placements composition)))
                            (or (eq (lwph-consistent?
                                        (lwrtrt-trial-state trial)) 0)
                                (or (lt (lwo-field-size
                                            construction-sources) 8)
                                    (or (lt (lwo-field-size trial-sources) 2)
                                        (eq (lwrth-fields-disjoint?
                                                construction-sources
                                                trial-sources) 0))))))))
            (lwo-none)
            (lwrtrh-match composition-candidate trial-candidate composition
                trial recipe (lwrtrt-trial-retained trial)
                (lwrtrt-trial-prospective trial) construction-sources
                trial-sources
                (lwrtr-union-items
                    (lwo-field-items
                        (lwrtrt-candidate-alternatives candidate))
                    (lwrtr-composition-alternatives composition)) unknowns))))

(defn lwrtrh-matches-for-trials
    (composition-candidate trial-candidate composition trials matches)
    (if (eq (len trials) 0) matches
        (do
            (let match
                (lwrtrh-match-for composition-candidate trial-candidate
                    composition (head trials)))
            (lwrtrh-matches-for-trials composition-candidate trial-candidate
                composition (tail trials)
                (if (node_eq match (lwo-none)) matches
                    (lwo-field-add matches match))))))

(defn lwrtrh-matches-for-ready
    (composition-candidate trial-candidate)
    (do
        (let composition-field (lwo-emergent-shape composition-candidate))
        (let trial-field (lwo-emergent-shape trial-candidate))
        (let composition (lwrtrt-field-composition trial-field))
        (if (eq (lwo-field-has?
                    (lwrtr-field-compatible composition-field)
                    composition) 0)
            (lwo-empty-field)
            (lwrtrh-matches-for-trials composition-candidate trial-candidate
                composition
                (lwo-field-items (lwrtrt-field-viable trial-field))
                (lwo-empty-field)))))

(defn lwrtrh-match-options (items alternatives unknowns)
    (if (eq (len items) 0) (list alternatives unknowns)
        (lwrtrh-match-options (tail items)
            (lwrtr-union-items
                (lwo-field-items (lwrtrh-match-alternatives (head items)))
                alternatives)
            (lwrtr-union-items
                (lwo-field-items (lwrtrh-match-unknowns (head items)))
                unknowns))))

; children: exact current parents, every exact match, status, alternatives,
; unknowns, witnesses, local path.
(defn lwrtrh-field-cell
    (composition-candidate trial-candidate matches status alternatives unknowns
     witnesses)
    (intern_node LWRTRH-FIELD
        (list composition-candidate trial-candidate matches status alternatives
              unknowns witnesses (lwo-local-path))))
(defn lwrtrh-field? (cell) (lwo-category? cell LWRTRH-FIELD))
(defn lwrtrh-field-composition-candidate (field)
    (nth (node_children field) 0))
(defn lwrtrh-field-trial-candidate (field) (nth (node_children field) 1))
(defn lwrtrh-field-matches (field) (nth (node_children field) 2))
(defn lwrtrh-field-status (field) (nth (node_children field) 3))
(defn lwrtrh-field-alternatives (field) (nth (node_children field) 4))
(defn lwrtrh-field-unknowns (field) (nth (node_children field) 5))
(defn lwrtrh-field-witnesses (field) (nth (node_children field) 6))

(defn lwrtrh-parent-witnesses (world candidate field)
    (lwrtr-union-items
        (lwo-field-items (lwo-active-attributions-for world candidate))
        (lwrtr-union-items
            (lwo-field-items (lwo-emergent-witnesses candidate)) field)))
(defn lwrtrh-trial-local-current-for-parent?
    (world trial-candidate composition-candidate)
    (if (or (eq (lwo-category? trial-candidate LWO-EMERGENT) 0)
            (or (eq (lwrtrt-field?
                        (lwo-emergent-shape trial-candidate)) 0)
                (not (node_eq
                    (lwrtrt-field-parent
                        (lwo-emergent-shape trial-candidate))
                    composition-candidate)))) 0
        (if (and (eq (lwo-active? world trial-candidate) 1)
                 (eq (lwrtrt-local-current-ready?
                        world trial-candidate) 1)) 1 0)))
(defn lwrtrh-field-for-ready
    (world composition-candidate trial-candidate)
    (do
        (let matches
            (lwrtrh-matches-for-ready composition-candidate trial-candidate))
        (let count (lwo-field-size matches))
        (let status
            (if (eq count 1) (lwhrn-ready)
                (if (gt count 1) (lwhrn-plural) (lwhrn-open))))
        (let options
            (lwrtrh-match-options (lwo-field-items matches)
                (lwo-empty-field) (lwo-empty-field)))
        (let witnesses
            (lwrtrh-parent-witnesses world trial-candidate
                (lwrtrh-parent-witnesses world composition-candidate
                    (lwo-empty-field))))
        (lwrtrh-field-cell composition-candidate trial-candidate matches status
            (nth options 0)
            (lwo-field-add (nth options 1) (lwlc-unknown matches)) witnesses)))
(defn lwrtrh-field-for (world composition-candidate trial-candidate)
    ; Trial revocation is the cheaper and more local failure boundary.
    (if (or (eq (lwrtrh-trial-local-current-for-parent?
                    world trial-candidate composition-candidate) 0)
            (eq (lwrtr-integrated-current?
                    world composition-candidate) 0))
        (lwo-none)
        (lwrtrh-field-for-ready world composition-candidate trial-candidate)))

(defn lwrtrh-origin (composition-candidate trial-candidate)
    (intern_node LWRTRH-ORIGIN
        (list composition-candidate trial-candidate (lwo-local-path))))
(defn lwrtrh-origin-composition-candidate (origin)
    (nth (node_children origin) 0))
(defn lwrtrh-origin-trial-candidate (origin)
    (nth (node_children origin) 1))
(defn lwrtrh-proposal-from-field (field)
    (if (or (node_eq field (lwo-none))
            (eq (lwo-field-size (lwrtrh-field-matches field)) 0))
        (lwo-none)
        (do
            (let witnesses (lwrtrh-field-witnesses field))
            (let count (lwo-field-size (lwrtrh-field-matches field)))
            (let origin
                (lwrtrh-origin
                    (lwrtrh-field-composition-candidate field)
                    (lwrtrh-field-trial-candidate field)))
            (let candidate
                (lwo-emergent field witnesses
                    (intern_trivial_int count) (intern_trivial_int count)
                    (intern_trivial_int (lwo-field-size witnesses)) origin))
            (lwt-proposal candidate
                (lwt-sources-from-attributions
                    (lwo-field-items witnesses) (lwo-empty-field)) origin))))
(defn lwrtrh-proposal-for (world composition-candidate trial-candidate)
    (lwrtrh-proposal-from-field
        (lwrtrh-field-for world composition-candidate trial-candidate)))
(defn lwrtrh-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrtrh-field? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwrtrh-local-current-ready? (world candidate)
    (do
        (let origin (lwo-emergent-provenance candidate))
        (let fresh
            (lwrtrh-proposal-from-field
                (lwrtrh-field-for-ready world
                    (lwrtrh-origin-composition-candidate origin)
                    (lwrtrh-origin-trial-candidate origin))))
        (if (node_eq fresh (lwo-none)) 0
            (node_eq candidate (lwt-proposal-candidate fresh)))))
(defn lwrtrh-candidate-current? (world candidate)
    (if (eq (lwrtrh-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            ; Cheap local mismatch and trial revocation close first.  The
            ; shared composition parent is then visited exactly once.
            (if (eq (lwrtrh-local-current-ready? world candidate) 0) 0
                (if (eq (lwrtrh-trial-local-current-for-parent? world
                            (lwrtrh-origin-trial-candidate origin)
                            (lwrtrh-origin-composition-candidate origin)) 0) 0
                    (lwrtr-integrated-current? world
                        (lwrtrh-origin-composition-candidate origin)))))))
(defn lwrtrh-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrtrh-candidate-current? world candidate) 1)) 1 0))
(defn lwrtrh-integrate (round proposal action)
    (if (eq (lwrtrh-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

(defn lwrtrh-progress-target (field)
    (if (node_eq field (lwo-none)) "field:nothing"
        (lcfb-cat (list
            "matches:" (int_to_str
                (lwo-field-size (lwrtrh-field-matches field)))
            ":ready:" (int_to_str
                (lwhrn-ready? (lwrtrh-field-status field)))
            ":plural:" (int_to_str
                (lwhrn-plural? (lwrtrh-field-status field)))))))

