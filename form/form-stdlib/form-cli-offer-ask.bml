//////////////////////////////////////////////////////////////////////
//
// form-cli-offer-ask.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-offer-ask.bml
//
// Generic Offer<T>: naming is an offer, ask replies T, unknown is
// nothing. Two lookup doors on one class: a generated catalog (N is
// an argument) and the living body (kra rest pointer, then corpus
// word). Ask pays outside the stream. Cost stays outside.
//
// Proven by: form-stdlib/tests/form-cli-offer-ask-bml-band.fk
// witnessed: 2026-08-30 -> 65535
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template Offer<T> {
        member delay: int;
        member cost: int;
        member payload: T;
    }

    template QueryRow<TQuery, T> {
        member query: TQuery;
        member held: Offer<T>;
    }

    class FormOfferAskAuthority {
        field OfferAuthorityPath = "form/form-stdlib/bml/form-cli-offer-ask.bml";
        field OfferAuthorityKind = "high-bml-class-template-field";
    }

    class FormOfferAsk<T> {
        field MixA = 7;
        field MixB = 13;
        field DelayOffer = 0;
        field DelayAsk = 1;
        field CostOutside = 0;

        ref foa-authority = FormOfferAskAuthority;
        thought foa-pattern = list("offer", "ask", "lookup", "catalog-n", "body-lookup", "cost-outside");

        def foa-absent() = tail(list("x"));
        def foa-value(i) = add(mul(i, MixA()), MixB());
        def foa-query(i) = str_concat("q-", int_to_str(i));

        def foa-offer(x) = list("form-offer-v1", DelayOffer(), CostOutside(), x);
        def foa-ask(p) = list("form-offer-v1", DelayAsk(), nth(p, 2), nth(p, 3));
        def foa-delay(p) = nth(p, 1);
        def foa-cost(p) = nth(p, 2);
        def foa-payload(p) = nth(p, 3);
        def foa-reply(p) = if eq(foa-delay(p), DelayAsk()) then foa-payload(p) else foa-absent();

        def foa-row(i) = list(foa-query(i), foa-offer(foa-value(i)));
        def foa-catalog(n, i, acc) = if eq(i, n) then acc else foa-catalog(n, add(i, 1), cons(foa-row(i), acc));
        def foa-rows(n) = foa-catalog(n, 0, tail(list("x")));

        def foa-find(rows, q) = if eq(len(rows), 0) then foa-absent() else if str_eq(nth(head(rows), 0), q) then nth(head(rows), 1) else foa-find(tail(rows), q);
        def foa-lookup(q, n) = foa-find(foa-rows(n), q);
        def foa-ask-query(q, n) {
            let p = foa-lookup(q, n);
            if eq(len(p), 0) then foa-absent() else foa-reply(foa-ask(p));
        }

        def foa-row-ok(row) {
            let p = nth(row, 1);
            if eq(len(foa-reply(p)), 0) then if eq(foa-reply(foa-ask(p)), foa-payload(p)) then 1 else 0 else 0;
        }
        def foa-catalog-ok(rows) = if eq(len(rows), 0) then 1 else if eq(foa-row-ok(head(rows)), 0) then 0 else foa-catalog-ok(tail(rows));
        def foa-catalog-live(n) = if eq(len(foa-rows(n)), 0) then 0 else foa-catalog-ok(foa-rows(n));

        def foa-from-word(w) = if nothing?(w) then foa-absent() else foa-offer(w);
        def foa-body-lookup(q) {
            let rest = kra-answer(q);
            if eq(nothing?(rest), 0) then foa-offer(rest) else foa-from-word(kra-corpus-word(q));
        }
        def foa-body-eval(x) = if eq(lg-defer?(x), 1) then lg-force(x) else x;
        def foa-body-ask(q) {
            let p = foa-body-lookup(q);
            if eq(len(p), 0) then foa-absent() else foa-body-eval(foa-reply(foa-ask(p)));
        }
        def foa-live-check() {
            let g = foa-body-lookup("bootstrap/ground");
            let restq = "what names an answer that sleeps as a recipe until need wakes it into data?";
            let c0 = foa-bit(eq(len(foa-body-lookup("no-such-query")), 0), 1);
            let c1 = foa-bit(eq(len(foa-reply(g)), 0), 2);
            let c2 = foa-bit(eq(foa-body-ask("bootstrap/ground"), 42), 4);
            let c3 = foa-bit(str_eq(foa-body-ask(restq), "restanswer"), 8);
            let c4 = foa-bit(eq(len(foa-body-lookup("a question the corpus never held")), 0), 16);
            let c5 = foa-bit(eq(lg-defer?(foa-payload(g)), 1), 32);
            add(c0, add(c1, add(c2, add(c3, add(c4, c5)))));
        }

        def foa-bit(ok, bit) = if ok then bit else 0;
        def foa-check() {
            let n = 8;
            let rows = foa-rows(n);
            let c0 = foa-bit(eq(len(foa-lookup("no-such", n)), 0), 1);
            let c1 = foa-bit(eq(len(foa-reply(foa-lookup("q-3", n))), 0), 2);
            let c2 = foa-bit(eq(foa-ask-query("q-3", n), foa-value(3)), 4);
            let c3 = foa-bit(eq(foa-ask-query("q-0", n), MixB()), 8);
            let c4 = foa-bit(eq(foa-catalog-live(n), 1), 16);
            let c5 = foa-bit(eq(foa-cost(foa-lookup("q-3", n)), CostOutside()), 32);
            let c6 = foa-bit(eq(len(rows), n), 64);
            let c7 = foa-bit(eq(foa-catalog-live(16), 1), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
