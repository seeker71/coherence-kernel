//////////////////////////////////////////////////////////////////////
//
// form-cli-offer-ask.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-offer-ask.bml
//
// Generic Offer<T>: naming is an offer, ask replies T, unknown is
// nothing. Two lookup doors on one class: a generated catalog (N is
// an argument) and the living body (kra rest pointer, then corpus
// word). Ask pays outside the stream. Cost stays outside.
//
// Proven by: form-stdlib/tests/form-cli-offer-ask-bml-band.fk
//
// preludes: form-stdlib/core.fk form-stdlib/language-model.fk form-stdlib/knowledge-rest-answer.fk
// witnessed: 2026-08-30 -> 65535
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template Offer<T> {
        member delay: int;
        member cost: int;
        member payload: T;
    }

    template QueryRow<TQuery, T> {
        member query: TQuery;
        member held: Offer<T>;
    }

    class FormOfferAskAuthority {
        field OfferAuthorityPath = "form/form-stdlib/bml/form-cli-offer-ask.bml";
        field OfferAuthorityKind = "high-bml-class-template-field";
    }

    class FormOfferAsk<T> {
        field MixA = 7;
        field MixB = 13;
        field DelayOffer = 0;
        field DelayAsk = 1;
        field CostOutside = 0;

        ref foa-authority = FormOfferAskAuthority;
        thought foa-pattern = list("offer", "ask", "lookup", "catalog-n", "body-lookup", "cost-outside");

        def foa-absent() = tail(list("x"));
        def foa-value(i) = ((i * MixA()) + MixB());
        def foa-query(i) = str_concat("q-", int_to_str(i));

        def foa-offer(x) = list("form-offer-v1", DelayOffer(), CostOutside(), x);
        def foa-ask(p) = list("form-offer-v1", DelayAsk(), nth(p, 2), nth(p, 3));
        def foa-delay(p) = nth(p, 1);
        def foa-cost(p) = nth(p, 2);
        def foa-payload(p) = nth(p, 3);
        def foa-reply(p) = if ((Comparable) foa-delay(p) == DelayAsk()) then foa-payload(p) else foa-absent();

        def foa-row(i) = list(foa-query(i), foa-offer(foa-value(i)));
        def foa-catalog(n, i, acc) = if ((Comparable) i == n) then acc else foa-catalog(n, (i + 1), cons(foa-row(i), acc));
        def foa-rows(n) = foa-catalog(n, 0, tail(list("x")));

        def foa-find(rows, q) = if ((Comparable) len(rows) == 0) then foa-absent() else if ((String) nth(head(rows), 0) == q) then nth(head(rows), 1) else foa-find(tail(rows), q);
        def foa-lookup(q, n) = foa-find(foa-rows(n), q);
        def foa-ask-query(q, n) {
            let p = foa-lookup(q, n);
            if ((Comparable) len(p) == 0) then foa-absent() else foa-reply(foa-ask(p));
        }

        def foa-row-ok(row) {
            let p = nth(row, 1);
            if ((Comparable) len(foa-reply(p)) == 0) then if ((Comparable) foa-reply(foa-ask(p)) == foa-payload(p)) then 1 else 0 else 0;
        }
        def foa-catalog-ok(rows) = if ((Comparable) len(rows) == 0) then 1 else if ((Comparable) foa-row-ok(head(rows)) == 0) then 0 else foa-catalog-ok(tail(rows));
        def foa-catalog-live(n) = if ((Comparable) len(foa-rows(n)) == 0) then 0 else foa-catalog-ok(foa-rows(n));

        def foa-from-word(w) = if nothing?(w) then foa-absent() else foa-offer(w);
        def foa-body-lookup(q) {
            let rest = kra-answer(q);
            if ((Comparable) nothing?(rest) == 0) then foa-offer(rest) else foa-from-word(kra-corpus-word(q));
        }
        def foa-body-eval(x) = if ((Comparable) lg-defer?(x) == 1) then lg-force(x) else x;
        def foa-body-ask(q) {
            let p = foa-body-lookup(q);
            if ((Comparable) len(p) == 0) then foa-absent() else foa-body-eval(foa-reply(foa-ask(p)));
        }
        def foa-live-check() {
            let g = foa-body-lookup("bootstrap/ground");
            let restq = "what names an answer that sleeps as a recipe until need wakes it into data?";
            let c0 = foa-bit(((Comparable) len(foa-body-lookup("no-such-query")) == 0), 1);
            let c1 = foa-bit(((Comparable) len(foa-reply(g)) == 0), 2);
            let c2 = foa-bit(((Comparable) foa-body-ask("bootstrap/ground") == 42), 4);
            let c3 = foa-bit(((String) foa-body-ask(restq) == "restanswer"), 8);
            let c4 = foa-bit(((Comparable) len(foa-body-lookup("a question the corpus never held")) == 0), 16);
            let c5 = foa-bit(((Comparable) lg-defer?(foa-payload(g)) == 1), 32);
            (c0 + (c1 + (c2 + (c3 + (c4 + c5)))));
        }

        def foa-bit(ok, bit) = if ok then bit else 0;
        def foa-check() {
            let n = 8;
            let rows = foa-rows(n);
            let c0 = foa-bit(((Comparable) len(foa-lookup("no-such", n)) == 0), 1);
            let c1 = foa-bit(((Comparable) len(foa-reply(foa-lookup("q-3", n))) == 0), 2);
            let c2 = foa-bit(((Comparable) foa-ask-query("q-3", n) == foa-value(3)), 4);
            let c3 = foa-bit(((Comparable) foa-ask-query("q-0", n) == MixB()), 8);
            let c4 = foa-bit(((Comparable) foa-catalog-live(n) == 1), 16);
            let c5 = foa-bit(((Comparable) foa-cost(foa-lookup("q-3", n)) == CostOutside()), 32);
            let c6 = foa-bit(((Comparable) len(rows) == n), 64);
            let c7 = foa-bit(((Comparable) foa-catalog-live(16) == 1), 128);
            (c0 + (c1 + (c2 + (c3 + (c4 + (c5 + (c6 + c7)))))));
        }
    }
    0;
}
