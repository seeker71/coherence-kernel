// native-model-owner-cadence.bml — live owner process truth, not model truth.
//
// Authority: form-stdlib/bml/native-model-owner-cadence.bml
// preludes: form/form-stdlib/form-glass-observer.bml form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/native-model-dual-telemetry.bml form/form-stdlib/hearth.bml
