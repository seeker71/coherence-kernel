section [form.bml] {
    class NativeModelOwnerCadenceAuthority {
    }

    class NativeModelOwnerCadence {
        field NMDOCSchema = "native-model-owner-liveness-v1";
        field NMDOCStepSchema = "native-model-owner-liveness-step-v1";
        field NMDOCCommandSchema = "native-model-owner-command-v1";
        field NMDOCObserverPrefix = "models.dual-liveness.";
        field NMDOCModelPublisherPrefix = "models.dual-resident.i";
        def NMDOCGlassRoot() = hearth-telemetry-root();
        ref nmdoc-authority = NativeModelOwnerCadenceAuthority;
        thought nmdoc-law = list("process-liveness-is-not-model-readiness", "target-pid-reuse-is-refused", "publisher-lifetime-is-temporally-contained", "four-hertz-is-observed-not-declared", "telemetry-id-is-not-a-node-id");

        def nmdoc-observer-incarnation(started) = "i" ++ int_to_str(started);
        def nmdoc-observer-publisher(started) = NMDOCObserverPrefix() ++ nmdoc-observer-incarnation(started);
        def nmdoc-correlation(observerPublisher, observerPid, observerStarted, observerIncarnation, sequence, observed, targetPublisher, targetPid, targetPublisherStarted, targetSnapshotEpoch, targetProcessStartFloor, targetLifetimeSignature, targetSnapshotOwnerPublisher, targetSnapshotOwnerPid, targetSnapshotOwnerStarted, targetSnapshotHeartbeatId, targetBinding) = list(NMDOCSchema(), observerPublisher, observerPid, observerStarted, observerIncarnation, sequence, observed, targetPublisher, targetPid, targetPublisherStarted, targetSnapshotEpoch, targetProcessStartFloor, targetLifetimeSignature, targetSnapshotOwnerPublisher, targetSnapshotOwnerPid, targetSnapshotOwnerStarted, targetSnapshotHeartbeatId, targetBinding);
        def nmdoc-observer-publisher-of(value) = value[1];
        def nmdoc-observer-pid(value) = value[2];
        def nmdoc-observer-started(value) = value[3];
        def nmdoc-observer-incarnation-of(value) = value[4];
        def nmdoc-sequence(value) = value[5];
        def nmdoc-observed(value) = value[6];
        def nmdoc-target-publisher(value) = value[7];
        def nmdoc-target-pid(value) = value[8];
        def nmdoc-target-publisher-started(value) = value[9];
        def nmdoc-target-snapshot-epoch(value) = value[10];
        def nmdoc-target-process-start-floor(value) = value[11];
        def nmdoc-target-lifetime-signature(value) = value[12];
        def nmdoc-target-snapshot-owner-publisher(value) = value[13];
        def nmdoc-target-snapshot-owner-pid(value) = value[14];
        def nmdoc-target-snapshot-owner-started(value) = value[15];
        def nmdoc-target-snapshot-heartbeat-id(value) = value[16];
        def nmdoc-target-binding(value) = value[17];
        def nmdoc-target-heartbeat-prefix(value) = "heartbeat.i" ++ int_to_str(nmdoc-target-publisher-started(value)) ++ ".s";
        def nmdoc-target-heartbeat-stable(value) = "heartbeat.i" ++ int_to_str(nmdoc-target-publisher-started(value));
        def nmdoc-target-heartbeat-id-valid?(value) {
            let prefix = nmdoc-target-heartbeat-prefix(value);
            let heartbeat = nmdoc-target-snapshot-heartbeat-id(value);
            (String) heartbeat == nmdoc-target-heartbeat-stable(value) ? 1 : !((Comparable) str_find(heartbeat, prefix, 0) == 0) ? 0 : fgtm-uint-text?(substring(heartbeat, str_len(prefix), str_len(heartbeat)));
        }
        def nmdoc-exact-binding?(value) = !((String) nmdoc-target-binding(value) == "exact-snapshot-owner") ? 0 : !((String) nmdoc-target-snapshot-owner-publisher(value) == nmdoc-target-publisher(value)) ? 0 : !((Comparable) nmdoc-target-snapshot-owner-pid(value) == nmdoc-target-pid(value)) ? 0 : !((Comparable) nmdoc-target-snapshot-owner-started(value) == nmdoc-target-publisher-started(value)) ? 0 : nmdoc-target-heartbeat-id-valid?(value);
        def nmdoc-unbound-binding?(value) = !((String) nmdoc-target-binding(value) == "unbound-last-observed") ? 0 : !((String) nmdoc-target-snapshot-owner-publisher(value) == "") ? 0 : !((Comparable) nmdoc-target-snapshot-owner-pid(value) == -1) ? 0 : !((Comparable) nmdoc-target-snapshot-owner-started(value) == -1) ? 0 : ((String) nmdoc-target-snapshot-heartbeat-id(value) == "");
        def nmdoc-correlation?(value) = nothing?(value) ? 0 : !((Comparable) len(value) == 18) ? 0 : !((String) head(value) == NMDOCSchema()) ? 0 : nmdoc-observer-pid(value) <= 0 ? 0 : nmdoc-observer-started(value) < 0 ? 0 : !((String) nmdoc-observer-incarnation-of(value) == nmdoc-observer-incarnation(nmdoc-observer-started(value))) ? 0 : !((String) nmdoc-observer-publisher-of(value) == nmdoc-observer-publisher(nmdoc-observer-started(value))) ? 0 : !((Comparable) fgtm-label?(nmdoc-observer-publisher-of(value)) == 1) ? 0 : nmdoc-sequence(value) < 1 ? 0 : nmdoc-observed(value) < nmdoc-observer-started(value) ? 0 : nmdoc-target-pid(value) <= 0 ? 0 : !((String) nmdoc-target-publisher(value) == nmdt-owner-publisher(nmdoc-target-publisher-started(value))) ? 0 : (!nothing?(nmdoc-target-process-start-floor(value))) && (nmdoc-target-publisher-started(value) < nmdoc-target-process-start-floor(value)) ? 0 : nmdoc-target-publisher-started(value) > nmdoc-target-snapshot-epoch(value) ? 0 : nmdoc-target-snapshot-epoch(value) > nmdoc-observed(value) ? 0 : str_len(nmdoc-target-lifetime-signature(value)) < 1 ? 0 : (Comparable) nmdoc-exact-binding?(value) == 1 ? 1 : nmdoc-unbound-binding?(value);

        def nmdoc-model-publisher?(publisher) = !((Comparable) str_find(publisher, NMDOCModelPublisherPrefix(), 0) == 0) ? 0 : fgtm-uint-text?(substring(publisher, str_len(NMDOCModelPublisherPrefix()), str_len(publisher)));
        def nmdoc-model-publisher-started(publisher) = (Comparable) nmdoc-model-publisher?(publisher) == 1 ? str_to_int(substring(publisher, str_len(NMDOCModelPublisherPrefix()), str_len(publisher))) : -1;
        def nmdoc-newest-model-publisher-go(publishers, held, heldStarted) = (Comparable) len(publishers) == 0 ? held : !((Comparable) nmdoc-model-publisher?(head(publishers)) == 1) ? nmdoc-newest-model-publisher-go(tail(publishers), held, heldStarted) : nmdoc-model-publisher-started(head(publishers)) > heldStarted ? nmdoc-newest-model-publisher-go(tail(publishers), head(publishers), nmdoc-model-publisher-started(head(publishers))) : nmdoc-newest-model-publisher-go(tail(publishers), held, heldStarted);
        def nmdoc-newest-model-publisher(publishers) = nmdoc-newest-model-publisher-go(publishers, "", -1);
        def nmdoc-liveness-publisher?(publisher) = !((Comparable) str_find(publisher, NMDOCObserverPrefix(), 0) == 0) ? 0 : !((String) substring(publisher, str_len(NMDOCObserverPrefix()), str_len(NMDOCObserverPrefix()) + 1) == "i") ? 0 : fgtm-uint-text?(substring(publisher, str_len(NMDOCObserverPrefix()) + 1, str_len(publisher)));
        def nmdoc-liveness-publisher-started(publisher) = (Comparable) nmdoc-liveness-publisher?(publisher) == 1 ? str_to_int(substring(publisher, str_len(NMDOCObserverPrefix()) + 1, str_len(publisher))) : -1;
        def nmdoc-newest-liveness-publisher-go(publishers, held, heldStarted) = (Comparable) len(publishers) == 0 ? held : !((Comparable) nmdoc-liveness-publisher?(head(publishers)) == 1) ? nmdoc-newest-liveness-publisher-go(tail(publishers), held, heldStarted) : nmdoc-liveness-publisher-started(head(publishers)) > heldStarted ? nmdoc-newest-liveness-publisher-go(tail(publishers), head(publishers), nmdoc-liveness-publisher-started(head(publishers))) : nmdoc-newest-liveness-publisher-go(tail(publishers), held, heldStarted);
        def nmdoc-newest-liveness-publisher(publishers) = nmdoc-newest-liveness-publisher-go(publishers, "", -1);

        def nmdoc-target-command() = "./fkwu observe/native-model-dual-resident-live-run.fk";
        def nmdoc-pid-command(pid) = "/bin/ps -p " ++ int_to_str(pid) ++ " -o command=";
        def nmdoc-pid-signature-command(pid) = "/bin/ps -p " ++ int_to_str(pid) ++ " -o lstart=,command=";
        def nmdoc-pid-command-text(pid) = trim(host-exec(nmdoc-pid-command(pid), ""));
        def nmdoc-pid-signature(pid) = trim(host-exec(nmdoc-pid-signature-command(pid), ""));
        // the owner's elapsed seconds from the host's row: nothing when the row is absent or the host withheld its start,
        // and then the correlation carries no start floor (nothing) and the lifetime signature stands alone
        def nmdoc-elapsed-in(rows,pid) = nil?(rows) ? nothing() : (len(head(rows)) >= 4) && ((Comparable) head(rows)[0] == pid) ? head(rows)[3] : nmdoc-elapsed-in(tail(rows),pid);
        def nmdoc-pid-elapsed(pid) = nmdoc-elapsed-in(host_processes("fkwu"),pid);
        def nmdoc-process-pids(rows) = nil?(rows) ? list() : len(head(rows)) < 4 ? nmdoc-process-pids(tail(rows)) : cons(int_to_str(head(rows)[0]),nmdoc-process-pids(tail(rows)));
        def nmdoc-target-pids(pids) = (Comparable) len(pids) == 0 ? list() : (String) nmdoc-pid-command-text(str_to_int(head(pids))) == nmdoc-target-command() ? cons(str_to_int(head(pids)), nmdoc-target-pids(tail(pids))) : nmdoc-target-pids(tail(pids));
        def nmdoc-target-pid-singleton() {
            let candidates = nmdoc-process-pids(host_processes("fkwu"));
            let targets = nmdoc-target-pids(candidates);
            (Comparable) len(targets) == 1 ? head(targets) : 0;
        }
        def nmdoc-self-pid() = host_pid();
        def nmdoc-start-floor(observed, elapsedSeconds) = nothing?(elapsedSeconds) ? nothing() : observed <= ((elapsedSeconds * 1000) + 1500) ? 0 : (observed - ((elapsedSeconds * 1000) + 1500));
        def nmdoc-reading-snapshot(reading) = !((String) fgtm-read-state-status(reading) == "current") ? list() : !((Comparable) fgtm-field-present?(fgtm-read-state-value(reading)) == 1) ? list() : fgtm-field-value(fgtm-read-state-value(reading));
        def nmdoc-sample-kind(samples, kind) = (Comparable) len(samples) == 0 ? list() : (String) fgtm-sample-kind(head(samples)) == kind ? head(samples) : nmdoc-sample-kind(tail(samples), kind);
        def nmdoc-snapshot-owner-heartbeat(snapshot) = !((Comparable) len(snapshot) == 4) ? list() : nmdoc-sample-kind(fgtm-snapshot-samples(snapshot), "owner-heartbeat");
        def nmdoc-present-number-or(field, fallback) = (Comparable) fgtm-field-present?(field) == 1 ? fgtm-field-value(field) : fallback;

        def nmdoc-discover(observerPid, observerStarted, sequence) {
            let observed = now_unix_ms();
            let inventory = fgtm-inventory(NMDOCGlassRoot());
            let targetPublisher = (String) inventory[2] == "current" ? nmdoc-newest-model-publisher(inventory[3]) : "";
            let snapshot = (Comparable) str_len(targetPublisher) == 0 ? list() : nmdoc-reading-snapshot(fgtm-read-current(NMDOCGlassRoot(), targetPublisher));
            let targetPid = nmdoc-target-pid-singleton();
            let elapsed = targetPid > 0 ? nmdoc-pid-elapsed(targetPid) : nothing();
            let signature = targetPid > 0 ? nmdoc-pid-signature(targetPid) : "";
            let targetStarted = nmdoc-model-publisher-started(targetPublisher);
            let snapshotEpoch = (Comparable) len(snapshot) == 4 ? fgtm-snapshot-epoch(snapshot) : -1;
            let ownerHeartbeat = nmdoc-snapshot-owner-heartbeat(snapshot);
            let snapshotOwnerPublisher = (Comparable) len(ownerHeartbeat) == 19 ? fgtm-sample-owner(ownerHeartbeat) : "";
            let snapshotOwnerPid = (Comparable) len(ownerHeartbeat) == 19 ? nmdoc-present-number-or(fgtm-sample-handle(ownerHeartbeat), -1) : -1;
            let snapshotOwnerStarted = (Comparable) len(ownerHeartbeat) == 19 ? nmdoc-present-number-or(fgtm-sample-write-epoch(ownerHeartbeat), -1) : -1;
            let snapshotHeartbeatId = (Comparable) len(ownerHeartbeat) == 19 ? fgtm-sample-id(ownerHeartbeat) : "";
            let binding = (Comparable) len(ownerHeartbeat) == 19 ? "exact-snapshot-owner" : "unbound-last-observed";
            let correlation = nmdoc-correlation(nmdoc-observer-publisher(observerStarted), observerPid, observerStarted, nmdoc-observer-incarnation(observerStarted), sequence, observed, targetPublisher, targetPid, targetStarted, snapshotEpoch, nmdoc-start-floor(observed, elapsed), signature, snapshotOwnerPublisher, snapshotOwnerPid, snapshotOwnerStarted, snapshotHeartbeatId, binding);
            (Comparable) nmdoc-correlation?(correlation) == 1 ? correlation : list("native-model-owner-liveness-invalid-v1");
        }

        def nmdoc-next-correlation(value, observed) = nmdoc-correlation(nmdoc-observer-publisher-of(value), nmdoc-observer-pid(value), nmdoc-observer-started(value), nmdoc-observer-incarnation-of(value), nmdoc-sequence(value) + 1, observed, nmdoc-target-publisher(value), nmdoc-target-pid(value), nmdoc-target-publisher-started(value), nmdoc-target-snapshot-epoch(value), nmdoc-target-process-start-floor(value), nmdoc-target-lifetime-signature(value), nmdoc-target-snapshot-owner-publisher(value), nmdoc-target-snapshot-owner-pid(value), nmdoc-target-snapshot-owner-started(value), nmdoc-target-snapshot-heartbeat-id(value), nmdoc-target-binding(value));
        def nmdoc-target-alive?(value) = !((Comparable) nmdoc-correlation?(value) == 1) ? 0 : ((String) nmdoc-pid-signature(nmdoc-target-pid(value)) == nmdoc-target-lifetime-signature(value));
        def nmdoc-observer-heartbeat-id(value) = "heartbeat." ++ nmdoc-observer-incarnation-of(value);
        def nmdoc-observer-heartbeat-sample(value) = fgtm-sample(nmdoc-observer-heartbeat-id(value), fgtm-absent(), "owner-observer", "form", nmdoc-observer-publisher-of(value), "model-owner", "owner-cadence-heartbeat", fgtm-absent(), fgtm-absent(), "active", fgtm-present(nmdoc-observed(value)), fgtm-present(nmdoc-observer-started(value)), fgtm-absent(), fgtm-present(nmdoc-observer-pid(value)), "never", "physical-live", "model.owner-observer", list("process", "model", "health", "membrane"));
        def nmdoc-target-liveness-purpose(value, alive) = (Comparable) alive == 0 ? "os-process-lifetime-ended" : (String) nmdoc-target-binding(value) == "exact-snapshot-owner" ? "os-process-lifetime-current" : "os-process-lifetime-current-owner-unbound";
        def nmdoc-target-liveness-sample(value, alive) = fgtm-sample("process.native-model-dual-resident", fgtm-absent(), "owner-liveness", "cpu", nmdoc-observer-publisher-of(value), "model-owner", nmdoc-target-liveness-purpose(value, alive), fgtm-absent(), fgtm-absent(), (Comparable) alive == 1 ? "active" : "failed", fgtm-present(nmdoc-observed(value)), fgtm-present(nmdoc-target-publisher-started(value)), fgtm-absent(), fgtm-present(nmdoc-target-pid(value)), "never", "physical-live", "process.lifetime", list("process", "model", "health", "membrane"));
        def nmdoc-publish(root, value, alive) = !((Comparable) nmdoc-correlation?(value) == 1) ? list("glass-publish-v1", "refused", "owner-liveness-correlation") : !(((Comparable) alive == 0) || ((Comparable) alive == 1)) ? list("glass-publish-v1", "refused", "owner-liveness-state") : fgtm-publish-snapshot(root, nmdoc-observer-publisher-of(value), nmdoc-observed(value), list(nmdoc-observer-heartbeat-sample(value), nmdoc-target-liveness-sample(value, alive)));
        def nmdoc-step(value, root) {
            let current = nmdoc-next-correlation(value, now_unix_ms());
            let alive = nmdoc-target-alive?(current);
            let published = nmdoc-publish(root, current, alive);
            list(NMDOCStepSchema(), current, alive, published);
        }
        def nmdoc-step-correlation(step) = step[1];
        def nmdoc-step-alive?(step) = step[2];
        def nmdoc-step-publish(step) = step[3];

        // Future-owner command ingress: one cell in one gift frame per owner publisher (the membrane's
        // fgtm-command-* doors), consumed once by the owner. A pending command IS the lease -- a second offer
        // while one stands and is younger than the lease is refused; the owner consumes by giving the empty
        // cell back. It avoids blocking read_line so the same owner can keep publishing; no file is touched.
        def nmdoc-command-frame(publisher) = FGTMOwnerCommandRoot() ++ "|" ++ fgtm-command-frame(publisher);
        def nmdoc-command-valid?(command) = (String) command == "heartbeat" ? 1 : (String) command == "status" ? 1 : (String) command == "qwen-step" ? 1 : (String) command == "3b-step" ? 1 : (String) command == "quit" ? 1 : 0;
        def nmdoc-command-result(status, command) = list(NMDOCCommandSchema(), status, command);
        def nmdoc-command-status(result) = result[1];
        def nmdoc-command-value(result) = result[2];
        def nmdoc-poll-command(publisher) {
            let consumed = (Comparable) fgtm-label?(publisher) == 1 ? fgtm-command-consume(publisher) : list("owner-command-consume-v2", "refused", "publisher");
            let status = fgtm-command-status(consumed);
            let command = fgtm-command-value(consumed);
            (String) status == "refused" ? nmdoc-command-result("refused", command) : (String) status == "waiting" ? nmdoc-command-result("waiting", "") : (String) status == "failed" ? nmdoc-command-result("failed", "release") : (Comparable) nmdoc-command-valid?(command) == 1 ? nmdoc-command-result("ready", command) : nmdoc-command-result("refused", "command");
        }
        def nmdoc-offer-command-at(publisher, command, epochMs) {
            let offered = ((Comparable) fgtm-label?(publisher) == 1) && ((Comparable) nmdoc-command-valid?(command) == 1) ? fgtm-command-offer-at(publisher, command, epochMs) : list("owner-command-offer-v2", "refused", command);
            let status = fgtm-command-status(offered);
            (String) status == "offered" ? nmdoc-command-result("offered", command) : (String) status == "failed" ? nmdoc-command-result("failed", command) : nmdoc-command-result("refused", command);
        }
        def nmdoc-offer-command(publisher, command) = nmdoc-offer-command-at(publisher, command, now_unix_ms());
        def nmdoc-command-pending(publisher) = fgtm-command-pending(publisher);
    }
    0;
}
