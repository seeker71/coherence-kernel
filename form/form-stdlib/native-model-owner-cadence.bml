//////////////////////////////////////////////////////////////////////
//
// native-model-owner-cadence.bml — live owner process truth, not model truth.
//
// Authority: form-stdlib/bml/native-model-owner-cadence.bml
// preludes: form/form-stdlib/form-glass-observer.bml form/form-stdlib/form-fs.fk form/form-stdlib/line-grammar.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/native-model-dual-telemetry.bml form/form-stdlib/hearth.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class NativeModelOwnerCadenceAuthority {
    }

    class NativeModelOwnerCadence {
        field NMDOCSchema = "native-model-owner-liveness-v1";
        field NMDOCStepSchema = "native-model-owner-liveness-step-v1";
        field NMDOCCommandSchema = "native-model-owner-command-v1";
        field NMDOCObserverPrefix = "models.dual-liveness.";
        field NMDOCModelPublisherPrefix = "models.dual-resident.i";
        def NMDOCGlassRoot() = hearth-telemetry-root();
        ref nmdoc-authority = NativeModelOwnerCadenceAuthority;
        thought nmdoc-law = ["process-liveness-is-not-model-readiness", "target-pid-reuse-is-refused", "publisher-lifetime-is-temporally-contained", "four-hertz-is-observed-not-declared", "telemetry-id-is-not-a-node-id"];

        def nmdoc-observer-incarnation(started) = str_concat("i", int_to_str(started));
        def nmdoc-observer-publisher(started) = str_concat(NMDOCObserverPrefix(), nmdoc-observer-incarnation(started));
        def nmdoc-correlation(observerPublisher, observerPid, observerStarted, observerIncarnation, sequence, observed, targetPublisher, targetPid, targetPublisherStarted, targetSnapshotEpoch, targetProcessStartFloor, targetLifetimeSignature, targetSnapshotOwnerPublisher, targetSnapshotOwnerPid, targetSnapshotOwnerStarted, targetSnapshotHeartbeatId, targetBinding) = [NMDOCSchema(), observerPublisher, observerPid, observerStarted, observerIncarnation, sequence, observed, targetPublisher, targetPid, targetPublisherStarted, targetSnapshotEpoch, targetProcessStartFloor, targetLifetimeSignature, targetSnapshotOwnerPublisher, targetSnapshotOwnerPid, targetSnapshotOwnerStarted, targetSnapshotHeartbeatId, targetBinding];
        def nmdoc-observer-publisher-of(value) = value[1];
        def nmdoc-observer-pid(value) = value[2];
        def nmdoc-observer-started(value) = value[3];
        def nmdoc-observer-incarnation-of(value) = value[4];
        def nmdoc-sequence(value) = value[5];
        def nmdoc-observed(value) = value[6];
        def nmdoc-target-publisher(value) = value[7];
        def nmdoc-target-pid(value) = value[8];
        def nmdoc-target-publisher-started(value) = value[9];
        def nmdoc-target-snapshot-epoch(value) = value[10];
        def nmdoc-target-process-start-floor(value) = value[11];
        def nmdoc-target-lifetime-signature(value) = value[12];
        def nmdoc-target-snapshot-owner-publisher(value) = value[13];
        def nmdoc-target-snapshot-owner-pid(value) = value[14];
        def nmdoc-target-snapshot-owner-started(value) = value[15];
        def nmdoc-target-snapshot-heartbeat-id(value) = value[16];
        def nmdoc-target-binding(value) = value[17];
        def nmdoc-target-heartbeat-prefix(value) = str_concat("heartbeat.i", str_concat(int_to_str(nmdoc-target-publisher-started(value)), ".s"));
        def nmdoc-target-heartbeat-stable(value) = str_concat("heartbeat.i", int_to_str(nmdoc-target-publisher-started(value)));
        def nmdoc-target-heartbeat-id-valid?(value) {
            let prefix = nmdoc-target-heartbeat-prefix(value);
            let heartbeat = nmdoc-target-snapshot-heartbeat-id(value);
            if ((String) heartbeat == nmdoc-target-heartbeat-stable(value)) then 1 else if (!((Comparable) str_find(heartbeat, prefix, 0) == 0)) then 0 else fgtm-uint-text?(substring(heartbeat, str_len(prefix), str_len(heartbeat)));
        }
        def nmdoc-exact-binding?(value) = if (!((String) nmdoc-target-binding(value) == "exact-snapshot-owner")) then 0 else if (!((String) nmdoc-target-snapshot-owner-publisher(value) == nmdoc-target-publisher(value))) then 0 else if (!((Comparable) nmdoc-target-snapshot-owner-pid(value) == nmdoc-target-pid(value))) then 0 else if (!((Comparable) nmdoc-target-snapshot-owner-started(value) == nmdoc-target-publisher-started(value))) then 0 else nmdoc-target-heartbeat-id-valid?(value);
        def nmdoc-unbound-binding?(value) = if (!((String) nmdoc-target-binding(value) == "unbound-last-observed")) then 0 else if (!((String) nmdoc-target-snapshot-owner-publisher(value) == "")) then 0 else if (!((Comparable) nmdoc-target-snapshot-owner-pid(value) == -1)) then 0 else if (!((Comparable) nmdoc-target-snapshot-owner-started(value) == -1)) then 0 else ((String) nmdoc-target-snapshot-heartbeat-id(value) == "");
        def nmdoc-correlation?(value) = if nothing?(value) then 0 else if (!((Comparable) len(value) == 18)) then 0 else if (!((String) head(value) == NMDOCSchema())) then 0 else if (nmdoc-observer-pid(value) <= 0) then 0 else if (nmdoc-observer-started(value) < 0) then 0 else if (!((String) nmdoc-observer-incarnation-of(value) == nmdoc-observer-incarnation(nmdoc-observer-started(value)))) then 0 else if (!((String) nmdoc-observer-publisher-of(value) == nmdoc-observer-publisher(nmdoc-observer-started(value)))) then 0 else if (!((Comparable) fgtm-label?(nmdoc-observer-publisher-of(value)) == 1)) then 0 else if (nmdoc-sequence(value) < 1) then 0 else if (nmdoc-observed(value) < nmdoc-observer-started(value)) then 0 else if (nmdoc-target-pid(value) <= 0) then 0 else if (!((String) nmdoc-target-publisher(value) == nmdt-owner-publisher(nmdoc-target-publisher-started(value)))) then 0 else if ((!nothing?(nmdoc-target-process-start-floor(value))) && (nmdoc-target-publisher-started(value) < nmdoc-target-process-start-floor(value))) then 0 else if (nmdoc-target-publisher-started(value) > nmdoc-target-snapshot-epoch(value)) then 0 else if (nmdoc-target-snapshot-epoch(value) > nmdoc-observed(value)) then 0 else if (str_len(nmdoc-target-lifetime-signature(value)) < 1) then 0 else if ((Comparable) nmdoc-exact-binding?(value) == 1) then 1 else nmdoc-unbound-binding?(value);

        def nmdoc-model-publisher?(publisher) = if (!((Comparable) str_find(publisher, NMDOCModelPublisherPrefix(), 0) == 0)) then 0 else fgtm-uint-text?(substring(publisher, str_len(NMDOCModelPublisherPrefix()), str_len(publisher)));
        def nmdoc-model-publisher-started(publisher) = if ((Comparable) nmdoc-model-publisher?(publisher) == 1) then str_to_int(substring(publisher, str_len(NMDOCModelPublisherPrefix()), str_len(publisher))) else -1;
        def nmdoc-newest-model-publisher-go(publishers, held, heldStarted) = if ((Comparable) len(publishers) == 0) then held else if (!((Comparable) nmdoc-model-publisher?(head(publishers)) == 1)) then nmdoc-newest-model-publisher-go(tail(publishers), held, heldStarted) else if (nmdoc-model-publisher-started(head(publishers)) > heldStarted) then nmdoc-newest-model-publisher-go(tail(publishers), head(publishers), nmdoc-model-publisher-started(head(publishers))) else nmdoc-newest-model-publisher-go(tail(publishers), held, heldStarted);
        def nmdoc-newest-model-publisher(publishers) = nmdoc-newest-model-publisher-go(publishers, "", -1);
        def nmdoc-liveness-publisher?(publisher) = if (!((Comparable) str_find(publisher, NMDOCObserverPrefix(), 0) == 0)) then 0 else if (!((String) substring(publisher, str_len(NMDOCObserverPrefix()), (str_len(NMDOCObserverPrefix()) + 1)) == "i")) then 0 else fgtm-uint-text?(substring(publisher, (str_len(NMDOCObserverPrefix()) + 1), str_len(publisher)));
        def nmdoc-liveness-publisher-started(publisher) = if ((Comparable) nmdoc-liveness-publisher?(publisher) == 1) then str_to_int(substring(publisher, (str_len(NMDOCObserverPrefix()) + 1), str_len(publisher))) else -1;
        def nmdoc-newest-liveness-publisher-go(publishers, held, heldStarted) = if ((Comparable) len(publishers) == 0) then held else if (!((Comparable) nmdoc-liveness-publisher?(head(publishers)) == 1)) then nmdoc-newest-liveness-publisher-go(tail(publishers), held, heldStarted) else if (nmdoc-liveness-publisher-started(head(publishers)) > heldStarted) then nmdoc-newest-liveness-publisher-go(tail(publishers), head(publishers), nmdoc-liveness-publisher-started(head(publishers))) else nmdoc-newest-liveness-publisher-go(tail(publishers), held, heldStarted);
        def nmdoc-newest-liveness-publisher(publishers) = nmdoc-newest-liveness-publisher-go(publishers, "", -1);

        def nmdoc-target-command() = "./fkwu observe/native-model-dual-resident-live-run.fk";
        def nmdoc-pid-command(pid) = str_concat("/bin/ps -p ", str_concat(int_to_str(pid), " -o command="));
        def nmdoc-pid-signature-command(pid) = str_concat("/bin/ps -p ", str_concat(int_to_str(pid), " -o lstart=,command="));
        def nmdoc-pid-command-text(pid) = trim(host-exec(nmdoc-pid-command(pid), ""));
        def nmdoc-pid-signature(pid) = trim(host-exec(nmdoc-pid-signature-command(pid), ""));
        // the owner's elapsed seconds from the host's row: nothing when the row is absent or the host withheld its start,
        // and then the correlation carries no start floor (nothing) and the lifetime signature stands alone
        def nmdoc-elapsed-in(rows,pid) = if nil?(rows) then nothing() else if ((len(head(rows)) >= 4) && ((Comparable) head(rows)[0] == pid)) then head(rows)[3] else nmdoc-elapsed-in(tail(rows),pid);
        def nmdoc-pid-elapsed(pid) = nmdoc-elapsed-in(host_processes("fkwu"),pid);
        def nmdoc-process-pids(rows) = if nil?(rows) then [] else if (len(head(rows)) < 4) then nmdoc-process-pids(tail(rows)) else cons(int_to_str(head(rows)[0]),nmdoc-process-pids(tail(rows)));
        def nmdoc-target-pids(pids) = if ((Comparable) len(pids) == 0) then [] else if ((String) nmdoc-pid-command-text(str_to_int(head(pids))) == nmdoc-target-command()) then cons(str_to_int(head(pids)), nmdoc-target-pids(tail(pids))) else nmdoc-target-pids(tail(pids));
        def nmdoc-target-pid-singleton() {
            let candidates = nmdoc-process-pids(host_processes("fkwu"));
            let targets = nmdoc-target-pids(candidates);
            if ((Comparable) len(targets) == 1) then head(targets) else 0;
        }
        def nmdoc-self-pid() = host_pid();
        def nmdoc-start-floor(observed, elapsedSeconds) = if nothing?(elapsedSeconds) then nothing() else if (observed <= ((elapsedSeconds * 1000) + 1500)) then 0 else (observed - ((elapsedSeconds * 1000) + 1500));
        def nmdoc-reading-snapshot(reading) = if (!((String) fgtm-read-state-status(reading) == "current")) then [] else if (!((Comparable) fgtm-field-present?(fgtm-read-state-value(reading)) == 1)) then [] else fgtm-field-value(fgtm-read-state-value(reading));
        def nmdoc-sample-kind(samples, kind) = if ((Comparable) len(samples) == 0) then [] else if ((String) fgtm-sample-kind(head(samples)) == kind) then head(samples) else nmdoc-sample-kind(tail(samples), kind);
        def nmdoc-snapshot-owner-heartbeat(snapshot) = if (!((Comparable) len(snapshot) == 4)) then [] else nmdoc-sample-kind(fgtm-snapshot-samples(snapshot), "owner-heartbeat");
        def nmdoc-present-number-or(field, fallback) = if ((Comparable) fgtm-field-present?(field) == 1) then fgtm-field-value(field) else fallback;

        def nmdoc-discover(observerPid, observerStarted, sequence) {
            let observed = now_unix_ms();
            let inventory = fgtm-inventory(NMDOCGlassRoot());
            let targetPublisher = if ((String) inventory[2] == "current") then nmdoc-newest-model-publisher(inventory[3]) else "";
            let snapshot = if ((Comparable) str_len(targetPublisher) == 0) then [] else nmdoc-reading-snapshot(fgtm-read-current(NMDOCGlassRoot(), targetPublisher));
            let targetPid = nmdoc-target-pid-singleton();
            let elapsed = if (targetPid > 0) then nmdoc-pid-elapsed(targetPid) else nothing();
            let signature = if (targetPid > 0) then nmdoc-pid-signature(targetPid) else "";
            let targetStarted = nmdoc-model-publisher-started(targetPublisher);
            let snapshotEpoch = if ((Comparable) len(snapshot) == 4) then fgtm-snapshot-epoch(snapshot) else -1;
            let ownerHeartbeat = nmdoc-snapshot-owner-heartbeat(snapshot);
            let snapshotOwnerPublisher = if ((Comparable) len(ownerHeartbeat) == 19) then fgtm-sample-owner(ownerHeartbeat) else "";
            let snapshotOwnerPid = if ((Comparable) len(ownerHeartbeat) == 19) then nmdoc-present-number-or(fgtm-sample-handle(ownerHeartbeat), -1) else -1;
            let snapshotOwnerStarted = if ((Comparable) len(ownerHeartbeat) == 19) then nmdoc-present-number-or(fgtm-sample-write-epoch(ownerHeartbeat), -1) else -1;
            let snapshotHeartbeatId = if ((Comparable) len(ownerHeartbeat) == 19) then fgtm-sample-id(ownerHeartbeat) else "";
            let binding = if ((Comparable) len(ownerHeartbeat) == 19) then "exact-snapshot-owner" else "unbound-last-observed";
            let correlation = nmdoc-correlation(nmdoc-observer-publisher(observerStarted), observerPid, observerStarted, nmdoc-observer-incarnation(observerStarted), sequence, observed, targetPublisher, targetPid, targetStarted, snapshotEpoch, nmdoc-start-floor(observed, elapsed), signature, snapshotOwnerPublisher, snapshotOwnerPid, snapshotOwnerStarted, snapshotHeartbeatId, binding);
            if ((Comparable) nmdoc-correlation?(correlation) == 1) then correlation else ["native-model-owner-liveness-invalid-v1"];
        }

        def nmdoc-next-correlation(value, observed) = nmdoc-correlation(nmdoc-observer-publisher-of(value), nmdoc-observer-pid(value), nmdoc-observer-started(value), nmdoc-observer-incarnation-of(value), (nmdoc-sequence(value) + 1), observed, nmdoc-target-publisher(value), nmdoc-target-pid(value), nmdoc-target-publisher-started(value), nmdoc-target-snapshot-epoch(value), nmdoc-target-process-start-floor(value), nmdoc-target-lifetime-signature(value), nmdoc-target-snapshot-owner-publisher(value), nmdoc-target-snapshot-owner-pid(value), nmdoc-target-snapshot-owner-started(value), nmdoc-target-snapshot-heartbeat-id(value), nmdoc-target-binding(value));
        def nmdoc-target-alive?(value) = if (!((Comparable) nmdoc-correlation?(value) == 1)) then 0 else ((String) nmdoc-pid-signature(nmdoc-target-pid(value)) == nmdoc-target-lifetime-signature(value));
        def nmdoc-observer-heartbeat-id(value) = str_concat("heartbeat.", nmdoc-observer-incarnation-of(value));
        def nmdoc-observer-heartbeat-sample(value) = fgtm-sample(nmdoc-observer-heartbeat-id(value), fgtm-absent(), "owner-observer", "form", nmdoc-observer-publisher-of(value), "model-owner", "owner-cadence-heartbeat", fgtm-absent(), fgtm-absent(), "active", fgtm-present(nmdoc-observed(value)), fgtm-present(nmdoc-observer-started(value)), fgtm-absent(), fgtm-present(nmdoc-observer-pid(value)), "never", "physical-live", "model.owner-observer", ["process", "model", "health", "membrane"]);
        def nmdoc-target-liveness-purpose(value, alive) = if ((Comparable) alive == 0) then "os-process-lifetime-ended" else if ((String) nmdoc-target-binding(value) == "exact-snapshot-owner") then "os-process-lifetime-current" else "os-process-lifetime-current-owner-unbound";
        def nmdoc-target-liveness-sample(value, alive) = fgtm-sample("process.native-model-dual-resident", fgtm-absent(), "owner-liveness", "cpu", nmdoc-observer-publisher-of(value), "model-owner", nmdoc-target-liveness-purpose(value, alive), fgtm-absent(), fgtm-absent(), if ((Comparable) alive == 1) then "active" else "failed", fgtm-present(nmdoc-observed(value)), fgtm-present(nmdoc-target-publisher-started(value)), fgtm-absent(), fgtm-present(nmdoc-target-pid(value)), "never", "physical-live", "process.lifetime", ["process", "model", "health", "membrane"]);
        def nmdoc-publish(root, value, alive) = if (!((Comparable) nmdoc-correlation?(value) == 1)) then ["glass-publish-v1", "refused", "owner-liveness-correlation"] else if (!(((Comparable) alive == 0) || ((Comparable) alive == 1))) then ["glass-publish-v1", "refused", "owner-liveness-state"] else fgtm-publish-snapshot(root, nmdoc-observer-publisher-of(value), nmdoc-observed(value), [nmdoc-observer-heartbeat-sample(value), nmdoc-target-liveness-sample(value, alive)]);
        def nmdoc-step(value, root) {
            let current = nmdoc-next-correlation(value, now_unix_ms());
            let alive = nmdoc-target-alive?(current);
            let published = nmdoc-publish(root, current, alive);
            [NMDOCStepSchema(), current, alive, published];
        }
        def nmdoc-step-correlation(step) = step[1];
        def nmdoc-step-alive?(step) = step[2];
        def nmdoc-step-publish(step) = step[3];

        // Future-owner command ingress: one cell in one gift frame per owner publisher (the membrane's
        // fgtm-command-* doors), consumed once by the owner. A pending command IS the lease -- a second offer
        // while one stands and is younger than the lease is refused; the owner consumes by giving the empty
        // cell back. It avoids blocking read_line so the same owner can keep publishing; no file is touched.
        def nmdoc-command-frame(publisher) = str_concat(FGTMOwnerCommandRoot(), str_concat("|", fgtm-command-frame(publisher)));
        def nmdoc-command-valid?(command) = if ((String) command == "heartbeat") then 1 else if ((String) command == "status") then 1 else if ((String) command == "qwen-step") then 1 else if ((String) command == "3b-step") then 1 else if ((String) command == "quit") then 1 else 0;
        def nmdoc-command-result(status, command) = [NMDOCCommandSchema(), status, command];
        def nmdoc-command-status(result) = result[1];
        def nmdoc-command-value(result) = result[2];
        def nmdoc-poll-command(publisher) {
            let consumed = if ((Comparable) fgtm-label?(publisher) == 1) then fgtm-command-consume(publisher) else ["owner-command-consume-v2", "refused", "publisher"];
            let status = fgtm-command-status(consumed);
            let command = fgtm-command-value(consumed);
            if ((String) status == "refused") then nmdoc-command-result("refused", command) else if ((String) status == "waiting") then nmdoc-command-result("waiting", "") else if ((String) status == "failed") then nmdoc-command-result("failed", "release") else if ((Comparable) nmdoc-command-valid?(command) == 1) then nmdoc-command-result("ready", command) else nmdoc-command-result("refused", "command");
        }
        def nmdoc-offer-command-at(publisher, command, epochMs) {
            let offered = if (((Comparable) fgtm-label?(publisher) == 1) && ((Comparable) nmdoc-command-valid?(command) == 1)) then fgtm-command-offer-at(publisher, command, epochMs) else ["owner-command-offer-v2", "refused", command];
            let status = fgtm-command-status(offered);
            if ((String) status == "offered") then nmdoc-command-result("offered", command) else if ((String) status == "failed") then nmdoc-command-result("failed", command) else nmdoc-command-result("refused", command);
        }
        def nmdoc-offer-command(publisher, command) = nmdoc-offer-command-at(publisher, command, now_unix_ms());
        def nmdoc-command-pending(publisher) = fgtm-command-pending(publisher);
    }
    0;
}
