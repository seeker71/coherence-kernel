section [form.bml] {
    class NativeModelOwnerCadenceAuthority {
    }

    class NativeModelOwnerCadence {
        field NMDOCSchema = "native-model-owner-liveness-v1";
        field NMDOCStepSchema = "native-model-owner-liveness-step-v1";
        field NMDOCCommandSchema = "native-model-owner-command-v1";
        field NMDOCObserverPrefix = "models.dual-liveness.";
        field NMDOCModelPublisherPrefix = "models.dual-resident.i";
        def NMDOCGlassRoot() = hearth-telemetry-root();
        field NMDOCControlRoot = "/tmp/form-native-model-owner-control";
        field NMDOCCommandSuffix = ".command";
        field NMDOCMaxCommandBytes = 32;
        field NMDOCCommandLeaseSeconds = 2;
        field NMDOCCommandLeaseSchema = "native-model-owner-command-lease-v1";
        ref nmdoc-authority = NativeModelOwnerCadenceAuthority;
        thought nmdoc-law = list("process-liveness-is-not-model-readiness", "target-pid-reuse-is-refused", "publisher-lifetime-is-temporally-contained", "four-hertz-is-observed-not-declared", "telemetry-id-is-not-a-node-id");

        def nmdoc-observer-incarnation(started) = str_concat("i", int_to_str(started));
        def nmdoc-observer-publisher(started) = str_concat(NMDOCObserverPrefix(), nmdoc-observer-incarnation(started));
        def nmdoc-correlation(observerPublisher, observerPid, observerStarted, observerIncarnation, sequence, observed, targetPublisher, targetPid, targetPublisherStarted, targetSnapshotEpoch, targetProcessStartFloor, targetLifetimeSignature, targetSnapshotOwnerPublisher, targetSnapshotOwnerPid, targetSnapshotOwnerStarted, targetSnapshotHeartbeatId, targetBinding) = list(NMDOCSchema(), observerPublisher, observerPid, observerStarted, observerIncarnation, sequence, observed, targetPublisher, targetPid, targetPublisherStarted, targetSnapshotEpoch, targetProcessStartFloor, targetLifetimeSignature, targetSnapshotOwnerPublisher, targetSnapshotOwnerPid, targetSnapshotOwnerStarted, targetSnapshotHeartbeatId, targetBinding);
        def nmdoc-observer-publisher-of(value) = nth(value, 1);
        def nmdoc-observer-pid(value) = nth(value, 2);
        def nmdoc-observer-started(value) = nth(value, 3);
        def nmdoc-observer-incarnation-of(value) = nth(value, 4);
        def nmdoc-sequence(value) = nth(value, 5);
        def nmdoc-observed(value) = nth(value, 6);
        def nmdoc-target-publisher(value) = nth(value, 7);
        def nmdoc-target-pid(value) = nth(value, 8);
        def nmdoc-target-publisher-started(value) = nth(value, 9);
        def nmdoc-target-snapshot-epoch(value) = nth(value, 10);
        def nmdoc-target-process-start-floor(value) = nth(value, 11);
        def nmdoc-target-lifetime-signature(value) = nth(value, 12);
        def nmdoc-target-snapshot-owner-publisher(value) = nth(value, 13);
        def nmdoc-target-snapshot-owner-pid(value) = nth(value, 14);
        def nmdoc-target-snapshot-owner-started(value) = nth(value, 15);
        def nmdoc-target-snapshot-heartbeat-id(value) = nth(value, 16);
        def nmdoc-target-binding(value) = nth(value, 17);
        def nmdoc-target-heartbeat-prefix(value) = str_concat("heartbeat.i", str_concat(int_to_str(nmdoc-target-publisher-started(value)), ".s"));
        def nmdoc-target-heartbeat-stable(value) = str_concat("heartbeat.i", int_to_str(nmdoc-target-publisher-started(value)));
        def nmdoc-target-heartbeat-id-valid?(value) {
            let prefix = nmdoc-target-heartbeat-prefix(value);
            let heartbeat = nmdoc-target-snapshot-heartbeat-id(value);
            if str_eq(heartbeat, nmdoc-target-heartbeat-stable(value)) then 1 else if not(eq(str_find(heartbeat, prefix, 0), 0)) then 0 else fgtm-uint-text?(substring(heartbeat, str_len(prefix), str_len(heartbeat)));
        }
        def nmdoc-exact-binding?(value) = if not(str_eq(nmdoc-target-binding(value), "exact-snapshot-owner")) then 0 else if not(str_eq(nmdoc-target-snapshot-owner-publisher(value), nmdoc-target-publisher(value))) then 0 else if not(eq(nmdoc-target-snapshot-owner-pid(value), nmdoc-target-pid(value))) then 0 else if not(eq(nmdoc-target-snapshot-owner-started(value), nmdoc-target-publisher-started(value))) then 0 else nmdoc-target-heartbeat-id-valid?(value);
        def nmdoc-unbound-binding?(value) = if not(str_eq(nmdoc-target-binding(value), "unbound-last-observed")) then 0 else if not(str_eq(nmdoc-target-snapshot-owner-publisher(value), "")) then 0 else if not(eq(nmdoc-target-snapshot-owner-pid(value), -1)) then 0 else if not(eq(nmdoc-target-snapshot-owner-started(value), -1)) then 0 else str_eq(nmdoc-target-snapshot-heartbeat-id(value), "");
        def nmdoc-correlation?(value) = if nothing?(value) then 0 else if not(eq(len(value), 18)) then 0 else if not(str_eq(head(value), NMDOCSchema())) then 0 else if le(nmdoc-observer-pid(value), 0) then 0 else if lt(nmdoc-observer-started(value), 0) then 0 else if not(str_eq(nmdoc-observer-incarnation-of(value), nmdoc-observer-incarnation(nmdoc-observer-started(value)))) then 0 else if not(str_eq(nmdoc-observer-publisher-of(value), nmdoc-observer-publisher(nmdoc-observer-started(value)))) then 0 else if not(eq(fgtm-label?(nmdoc-observer-publisher-of(value)), 1)) then 0 else if lt(nmdoc-sequence(value), 1) then 0 else if lt(nmdoc-observed(value), nmdoc-observer-started(value)) then 0 else if le(nmdoc-target-pid(value), 0) then 0 else if not(str_eq(nmdoc-target-publisher(value), nmdt-owner-publisher(nmdoc-target-publisher-started(value)))) then 0 else if lt(nmdoc-target-publisher-started(value), nmdoc-target-process-start-floor(value)) then 0 else if gt(nmdoc-target-publisher-started(value), nmdoc-target-snapshot-epoch(value)) then 0 else if gt(nmdoc-target-snapshot-epoch(value), nmdoc-observed(value)) then 0 else if lt(str_len(nmdoc-target-lifetime-signature(value)), 1) then 0 else if eq(nmdoc-exact-binding?(value), 1) then 1 else nmdoc-unbound-binding?(value);

        def nmdoc-model-publisher?(publisher) = if not(eq(str_find(publisher, NMDOCModelPublisherPrefix(), 0), 0)) then 0 else fgtm-uint-text?(substring(publisher, str_len(NMDOCModelPublisherPrefix()), str_len(publisher)));
        def nmdoc-model-publisher-started(publisher) = if eq(nmdoc-model-publisher?(publisher), 1) then str_to_int(substring(publisher, str_len(NMDOCModelPublisherPrefix()), str_len(publisher))) else -1;
        def nmdoc-newest-model-publisher-go(publishers, held, heldStarted) = if eq(len(publishers), 0) then held else if not(eq(nmdoc-model-publisher?(head(publishers)), 1)) then nmdoc-newest-model-publisher-go(tail(publishers), held, heldStarted) else if gt(nmdoc-model-publisher-started(head(publishers)), heldStarted) then nmdoc-newest-model-publisher-go(tail(publishers), head(publishers), nmdoc-model-publisher-started(head(publishers))) else nmdoc-newest-model-publisher-go(tail(publishers), held, heldStarted);
        def nmdoc-newest-model-publisher(publishers) = nmdoc-newest-model-publisher-go(publishers, "", -1);
        def nmdoc-liveness-publisher?(publisher) = if not(eq(str_find(publisher, NMDOCObserverPrefix(), 0), 0)) then 0 else if not(str_eq(substring(publisher, str_len(NMDOCObserverPrefix()), add(str_len(NMDOCObserverPrefix()), 1)), "i")) then 0 else fgtm-uint-text?(substring(publisher, add(str_len(NMDOCObserverPrefix()), 1), str_len(publisher)));
        def nmdoc-liveness-publisher-started(publisher) = if eq(nmdoc-liveness-publisher?(publisher), 1) then str_to_int(substring(publisher, add(str_len(NMDOCObserverPrefix()), 1), str_len(publisher))) else -1;
        def nmdoc-newest-liveness-publisher-go(publishers, held, heldStarted) = if eq(len(publishers), 0) then held else if not(eq(nmdoc-liveness-publisher?(head(publishers)), 1)) then nmdoc-newest-liveness-publisher-go(tail(publishers), held, heldStarted) else if gt(nmdoc-liveness-publisher-started(head(publishers)), heldStarted) then nmdoc-newest-liveness-publisher-go(tail(publishers), head(publishers), nmdoc-liveness-publisher-started(head(publishers))) else nmdoc-newest-liveness-publisher-go(tail(publishers), held, heldStarted);
        def nmdoc-newest-liveness-publisher(publishers) = nmdoc-newest-liveness-publisher-go(publishers, "", -1);

        def nmdoc-target-command() = "./fkwu observe/native-model-dual-resident-live-run.fk";
        def nmdoc-pid-command(pid) = str_concat("/bin/ps -p ", str_concat(int_to_str(pid), " -o command="));
        def nmdoc-pid-signature-command(pid) = str_concat("/bin/ps -p ", str_concat(int_to_str(pid), " -o lstart=,command="));
        def nmdoc-pid-elapsed-command(pid) = str_concat("/bin/ps -p ", str_concat(int_to_str(pid), " -o etime="));
        def nmdoc-pid-command-text(pid) = trim(host-exec(nmdoc-pid-command(pid), ""));
        def nmdoc-pid-signature(pid) = trim(host-exec(nmdoc-pid-signature-command(pid), ""));
        def nmdoc-pid-elapsed(pid) = fgo-ps-etime-seconds(trim(host-exec(nmdoc-pid-elapsed-command(pid), "")));
        def nmdoc-target-pids(pids) = if eq(len(pids), 0) then list() else if str_eq(nmdoc-pid-command-text(str_to_int(head(pids))), nmdoc-target-command()) then cons(str_to_int(head(pids)), nmdoc-target-pids(tail(pids))) else nmdoc-target-pids(tail(pids));
        def nmdoc-target-pid-singleton() {
            let candidates = fgo-pid-candidates(host-exec("/usr/bin/pgrep -x fkwu", ""));
            let targets = nmdoc-target-pids(candidates);
            if eq(len(targets), 1) then head(targets) else 0;
        }
        def nmdoc-self-pid() {
            let text = host-exec("printf '%s' \"$PPID\"", "");
            if eq(fgtm-uint-text?(text), 1) then str_to_int(text) else 0;
        }
        def nmdoc-start-floor(observed, elapsedSeconds) = if lt(elapsedSeconds, 0) then -1 else if le(observed, add(mul(elapsedSeconds, 1000), 1500)) then 0 else sub(observed, add(mul(elapsedSeconds, 1000), 1500));
        def nmdoc-reading-snapshot(reading) = if not(str_eq(fgtm-read-state-status(reading), "current")) then list() else if not(eq(fgtm-field-present?(fgtm-read-state-value(reading)), 1)) then list() else fgtm-field-value(fgtm-read-state-value(reading));
        def nmdoc-sample-kind(samples, kind) = if eq(len(samples), 0) then list() else if str_eq(fgtm-sample-kind(head(samples)), kind) then head(samples) else nmdoc-sample-kind(tail(samples), kind);
        def nmdoc-snapshot-owner-heartbeat(snapshot) = if not(eq(len(snapshot), 4)) then list() else nmdoc-sample-kind(fgtm-snapshot-samples(snapshot), "owner-heartbeat");
        def nmdoc-present-number-or(field, fallback) = if eq(fgtm-field-present?(field), 1) then fgtm-field-value(field) else fallback;

        def nmdoc-discover(observerPid, observerStarted, sequence) {
            let observed = now_unix_ms();
            let inventory = fgtm-inventory(NMDOCGlassRoot());
            let targetPublisher = if str_eq(nth(inventory, 2), "current") then nmdoc-newest-model-publisher(nth(inventory, 3)) else "";
            let snapshot = if eq(str_len(targetPublisher), 0) then list() else nmdoc-reading-snapshot(fgtm-read-current(NMDOCGlassRoot(), targetPublisher));
            let targetPid = nmdoc-target-pid-singleton();
            let elapsed = if gt(targetPid, 0) then nmdoc-pid-elapsed(targetPid) else -1;
            let signature = if gt(targetPid, 0) then nmdoc-pid-signature(targetPid) else "";
            let targetStarted = nmdoc-model-publisher-started(targetPublisher);
            let snapshotEpoch = if eq(len(snapshot), 4) then fgtm-snapshot-epoch(snapshot) else -1;
            let ownerHeartbeat = nmdoc-snapshot-owner-heartbeat(snapshot);
            let snapshotOwnerPublisher = if eq(len(ownerHeartbeat), 19) then fgtm-sample-owner(ownerHeartbeat) else "";
            let snapshotOwnerPid = if eq(len(ownerHeartbeat), 19) then nmdoc-present-number-or(fgtm-sample-handle(ownerHeartbeat), -1) else -1;
            let snapshotOwnerStarted = if eq(len(ownerHeartbeat), 19) then nmdoc-present-number-or(fgtm-sample-write-epoch(ownerHeartbeat), -1) else -1;
            let snapshotHeartbeatId = if eq(len(ownerHeartbeat), 19) then fgtm-sample-id(ownerHeartbeat) else "";
            let binding = if eq(len(ownerHeartbeat), 19) then "exact-snapshot-owner" else "unbound-last-observed";
            let correlation = nmdoc-correlation(nmdoc-observer-publisher(observerStarted), observerPid, observerStarted, nmdoc-observer-incarnation(observerStarted), sequence, observed, targetPublisher, targetPid, targetStarted, snapshotEpoch, nmdoc-start-floor(observed, elapsed), signature, snapshotOwnerPublisher, snapshotOwnerPid, snapshotOwnerStarted, snapshotHeartbeatId, binding);
            if eq(nmdoc-correlation?(correlation), 1) then correlation else list("native-model-owner-liveness-invalid-v1");
        }

        def nmdoc-next-correlation(value, observed) = nmdoc-correlation(nmdoc-observer-publisher-of(value), nmdoc-observer-pid(value), nmdoc-observer-started(value), nmdoc-observer-incarnation-of(value), add(nmdoc-sequence(value), 1), observed, nmdoc-target-publisher(value), nmdoc-target-pid(value), nmdoc-target-publisher-started(value), nmdoc-target-snapshot-epoch(value), nmdoc-target-process-start-floor(value), nmdoc-target-lifetime-signature(value), nmdoc-target-snapshot-owner-publisher(value), nmdoc-target-snapshot-owner-pid(value), nmdoc-target-snapshot-owner-started(value), nmdoc-target-snapshot-heartbeat-id(value), nmdoc-target-binding(value));
        def nmdoc-target-alive?(value) = if not(eq(nmdoc-correlation?(value), 1)) then 0 else str_eq(nmdoc-pid-signature(nmdoc-target-pid(value)), nmdoc-target-lifetime-signature(value));
        def nmdoc-observer-heartbeat-id(value) = str_concat("heartbeat.", nmdoc-observer-incarnation-of(value));
        def nmdoc-observer-heartbeat-sample(value) = fgtm-sample(nmdoc-observer-heartbeat-id(value), fgtm-absent(), "owner-observer", "form", nmdoc-observer-publisher-of(value), "model-owner", "owner-cadence-heartbeat", fgtm-absent(), fgtm-absent(), "active", fgtm-present(nmdoc-observed(value)), fgtm-present(nmdoc-observer-started(value)), fgtm-absent(), fgtm-present(nmdoc-observer-pid(value)), "never", "physical-live", "model.owner-observer", list("process", "model", "health", "membrane"));
        def nmdoc-target-liveness-purpose(value, alive) = if eq(alive, 0) then "os-process-lifetime-ended" else if str_eq(nmdoc-target-binding(value), "exact-snapshot-owner") then "os-process-lifetime-current" else "os-process-lifetime-current-owner-unbound";
        def nmdoc-target-liveness-sample(value, alive) = fgtm-sample("process.native-model-dual-resident", fgtm-absent(), "owner-liveness", "cpu", nmdoc-observer-publisher-of(value), "model-owner", nmdoc-target-liveness-purpose(value, alive), fgtm-absent(), fgtm-absent(), if eq(alive, 1) then "active" else "failed", fgtm-present(nmdoc-observed(value)), fgtm-present(nmdoc-target-publisher-started(value)), fgtm-absent(), fgtm-present(nmdoc-target-pid(value)), "never", "physical-live", "process.lifetime", list("process", "model", "health", "membrane"));
        def nmdoc-publish(root, value, alive) = if not(eq(nmdoc-correlation?(value), 1)) then list("glass-publish-v1", "refused", "owner-liveness-correlation") else if not(or(eq(alive, 0), eq(alive, 1))) then list("glass-publish-v1", "refused", "owner-liveness-state") else fgtm-publish-snapshot(root, nmdoc-observer-publisher-of(value), nmdoc-observed(value), list(nmdoc-observer-heartbeat-sample(value), nmdoc-target-liveness-sample(value, alive)));
        def nmdoc-step(value, root) {
            let current = nmdoc-next-correlation(value, now_unix_ms());
            let alive = nmdoc-target-alive?(current);
            let published = nmdoc-publish(root, current, alive);
            list(NMDOCStepSchema(), current, alive, published);
        }
        def nmdoc-step-correlation(step) = nth(step, 1);
        def nmdoc-step-alive?(step) = nth(step, 2);
        def nmdoc-step-publish(step) = nth(step, 3);

        // Future-owner command ingress: one atomic file, consumed once.  It
        // avoids blocking read_line so the same owner can keep publishing.
        def nmdoc-command-path(publisher) = fs-path-join(NMDOCControlRoot(), str_concat(publisher, NMDOCCommandSuffix()));
        def nmdoc-command-candidate-path(publisher) = str_concat(nmdoc-command-path(publisher), ".candidate");
        def nmdoc-command-lock-path(publisher) = str_concat(nmdoc-command-path(publisher), ".lock");
        def nmdoc-command-lease-path(publisher) = fs-path-join(nmdoc-command-lock-path(publisher), "lease");
        def nmdoc-command-lease-text(publisher) = str_concat(NMDOCCommandLeaseSchema(), str_concat("|", publisher));
        def nmdoc-command-lock-owned?(publisher) = if not(eq(fs-exists?(nmdoc-command-lease-path(publisher)), 1)) then 0 else str_eq(fs-read-text(nmdoc-command-lease-path(publisher)), nmdoc-command-lease-text(publisher));
        def nmdoc-command-lock-expired?(publisher, nowSeconds) = if not(eq(fs-exists?(nmdoc-command-lock-path(publisher)), 1)) then 0 else if le(fs-stat-mtime(nmdoc-command-lock-path(publisher)), 0) then 1 else if ge(nowSeconds, add(fs-stat-mtime(nmdoc-command-lock-path(publisher)), NMDOCCommandLeaseSeconds())) then 1 else 0;
        def nmdoc-command-valid?(command) = if str_eq(command, "heartbeat") then 1 else if str_eq(command, "status") then 1 else if str_eq(command, "qwen-step") then 1 else if str_eq(command, "3b-step") then 1 else if str_eq(command, "quit") then 1 else 0;
        def nmdoc-command-result(status, command) = list(NMDOCCommandSchema(), status, command);
        def nmdoc-command-status(result) = nth(result, 1);
        def nmdoc-command-value(result) = nth(result, 2);
        def nmdoc-poll-command(publisher) = nmdoc-poll-command-at(publisher, div(now_unix_ms(), 1000));
        def nmdoc-poll-command-at(publisher, nowSeconds) {
            let path = nmdoc-command-path(publisher);
            let lock = nmdoc-command-lock-path(publisher);
            if not(eq(fgtm-label?(publisher), 1)) then nmdoc-command-result("refused", "publisher") else if not(eq(fs-exists?(path), 1)) then if eq(nmdoc-command-lock-expired?(publisher, nowSeconds), 1) then nmdoc-heal-command-lock(publisher, "orphan-lock") else nmdoc-command-result("waiting", "") else if not(eq(nmdoc-command-lock-owned?(publisher), 1)) then nmdoc-heal-command-lock(publisher, "uncorrelated-command") else if gt(file_size(path), NMDOCMaxCommandBytes()) then nmdoc-poll-command-oversize(publisher, path) else nmdoc-poll-command-present(publisher, path, trim(fs-read-text(path)));
        }
        def nmdoc-release-command-lock(publisher) {
            let leaseRemoved = fs-remove-file(nmdoc-command-lease-path(publisher));
            fs-remove-tree(nmdoc-command-lock-path(publisher));
        }
        def nmdoc-remove-if-present(path) = if eq(fs-exists?(path), 1) then fs-remove-file(path) else 0;
        def nmdoc-heal-command-lock(publisher, reason) {
            let commandRemoved = nmdoc-remove-if-present(nmdoc-command-path(publisher));
            let candidateRemoved = nmdoc-remove-if-present(nmdoc-command-candidate-path(publisher));
            let unlocked = nmdoc-release-command-lock(publisher);
            if and(eq(commandRemoved, 0), and(eq(candidateRemoved, 0), eq(unlocked, 0))) then nmdoc-command-result("healed", reason) else nmdoc-command-result("failed", reason);
        }
        def nmdoc-poll-command-oversize(publisher, path) {
            let removed = fs-remove-file(path);
            let unlocked = nmdoc-release-command-lock(publisher);
            if not(and(eq(removed, 0), eq(unlocked, 0))) then nmdoc-command-result("failed", "oversize-release") else nmdoc-command-result("refused", "oversize");
        }
        def nmdoc-poll-command-present(publisher, path, command) {
            let removed = fs-remove-file(path);
            let unlocked = nmdoc-release-command-lock(publisher);
            if not(and(eq(removed, 0), eq(unlocked, 0))) then nmdoc-command-result("failed", "release") else if eq(nmdoc-command-valid?(command), 1) then nmdoc-command-result("ready", command) else nmdoc-command-result("refused", "command");
        }
        def nmdoc-offer-command(publisher, command) {
            let made = fs-mkdir(NMDOCControlRoot());
            let lock = nmdoc-command-lock-path(publisher);
            let candidate = nmdoc-command-candidate-path(publisher);
            let acquired = if and(eq(fgtm-label?(publisher), 1), eq(nmdoc-command-valid?(command), 1)) then fs-mkdir(lock) else -1;
            let leaseWrote = if eq(acquired, 1) then fs-write-text(nmdoc-command-lease-path(publisher), nmdoc-command-lease-text(publisher)) else -1;
            let wrote = if ge(leaseWrote, 0) then fs-write-text(candidate, command) else -1;
            let moved = if ge(wrote, 0) then fs-rename(candidate, nmdoc-command-path(publisher)) else -1;
            if eq(moved, 0) then nmdoc-command-result("offered", command) else nmdoc-offer-command-refused(candidate, lock, command, acquired);
        }
        def nmdoc-offer-command-refused(candidate, lock, command, acquired) {
            let cleaned = if eq(acquired, 1) then fs-remove-file(candidate) else -1;
            let leaseCleaned = if eq(acquired, 1) then fs-remove-file(fs-path-join(lock, "lease")) else -1;
            let unlocked = if eq(acquired, 1) then fs-remove-tree(lock) else -1;
            nmdoc-command-result("refused", command);
        }
    }
    0;
}
