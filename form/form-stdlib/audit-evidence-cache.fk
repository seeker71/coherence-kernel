; audit-evidence-cache.fk — the .fkb fast path for the audit index, split out
; 2026-08-15.
;
; preludes: form-stdlib/core.fk form-stdlib/audit-evidence-cells.fk
;
; These three were the only sites in audit-evidence-cells.fk reaching
; read_form_binary / write_form_binary. Those two are native on go / rust / ts and
; ABSENT on fkwu, so naming them in that cell handed the absence to every chain
; that preluded it: tests/audit-evidence-cells-band.fk answered 544 with exit 1,
; and its bits never touched the cache at all. A verdict folded over `nothing` in
; three places, in a band about evidence.
;
; The same repair as form-stdlib/cache-binary.fk, made for the same reason: a cell
; should not hand its callers a door they did not ask for and cannot open on their
; own arm. The freshness predicates stayed behind — they ask file_mtime and
; file_size, which every arm carries.
;
; Callers that want the fast path prelude this cell. Today none do; the index is
; built from source by aec-index-recipe-from-root, which needs no door.

(do
    (defn aec-ensure-index-cache (root cache-path)
        (do
            (let rows (aec-commit-evidence-rows root))
            (let source-max-mtime (aec-max-source-mtime root rows))
            (if (aec-index-cache-fresh-at? cache-path source-max-mtime)
                (aec-cache-result
                    "fresh"
                    cache-path
                    (file_size cache-path)
                    (len rows)
                    source-max-mtime
                    (file_mtime cache-path))
                (do
                    (let bytes-written (write_form_binary cache-path (aec-index-recipe-from-rows root rows)))
                    (aec-cache-result
                        "write"
                        cache-path
                        bytes-written
                        (len rows)
                        source-max-mtime
                        (file_mtime cache-path))))))

    (defn aec-write-index-cache (root cache-path)
        (write_form_binary cache-path (aec-index-recipe-from-root root)))

    (defn aec-read-index-cache (cache-path)
        (read_form_binary cache-path))
    0)
