// native-model-evidence.fk — deterministic evaluation evidence in Form.
//
// This is the compute that the retired host evaluator must not own: text
// normalization, tokenization, exact/F1/order-sensitive scores, aggregate
// evidence, semantic dataset identity, deterministic rotation, and overlap
// checks.  All hashes are the body's sha256.fk recipe over explicit bytes.
//
// The normalization contract is deliberately byte-honest.  It lowercases
// ASCII A-Z and collapses ASCII whitespace; UTF-8 bytes are retained exactly.
// It does NOT claim Unicode NFC/casefold.  A promotion corpus that needs those
// equivalences must arrive pre-normalized and record that fact in its seal.
// This narrower contract refuses an unimplemented Unicode promise while still
// scoring Portuguese and other UTF-8 text without discarding its bytes.
//
// preludes: form-stdlib/core.fk form-stdlib/sha256.fk
section [form.bml] {
    def nmfe-reverse-loop(xs, acc) = (Comparable) len(xs) == 0 ? acc : nmfe-reverse-loop(tail(xs), cons(head(xs), acc));
    def nmfe-reverse(xs) = nmfe-reverse-loop(xs, []);
    def nmfe-append(xs, ys) = (Comparable) len(xs) == 0 ? ys : cons(head(xs), nmfe-append(tail(xs), ys));
    def nmfe-string-bytes-loop(s, i, acc) = i >= str_len(s) ? nmfe-reverse(acc) : nmfe-string-bytes-loop(s, i + 1, cons(str_byte_at(s, i), acc));
    def nmfe-string-bytes(s) = nmfe-string-bytes-loop(s, 0, []);
    // Encode locally instead of importing hex.fk's decode sentinel.  Evidence
    // needs only the canonical lowercase direction and therefore does not need
    // the unrelated `bp` constructor used by that module's error value.
    def nmfe-hex-digit(n) = substring("0123456789abcdef", n, n + 1);
    def nmfe-hex-bytes-loop(bytes, acc) = (Comparable) len(bytes) == 0 ? acc : {
        let b = head(bytes);
        nmfe-hex-bytes-loop(tail(bytes), str_concat(acc, str_concat(nmfe-hex-digit(b / 16), nmfe-hex-digit(b % 16))));
    };
    def nmfe-hex-bytes(bytes) = nmfe-hex-bytes-loop(bytes, "");
    def nmfe-sha256(s) = nmfe-hex-bytes(sha256(nmfe-string-bytes(s)));
    def nmfe-lower-hex-byte?(b) = b >= 48 && b <= 57 || b >= 97 && b <= 102 ? 1 : 0;
    def nmfe-lower-hex-loop(s, i) = i >= 64 ? 1 : (Comparable) nmfe-lower-hex-byte?(str_byte_at(s, i)) == 1 ? nmfe-lower-hex-loop(s, i + 1) : 0;
    // a sha256 is a 64-byte lowercase hex string, asked of its kind before it is measured.
    def nmfe-sha256?(s) = !((String) value_kind(s) == "string") ? 0 : (Comparable) str_len(s) == 64 ? nmfe-lower-hex-loop(s, 0) : 0;
    // Length-prefixing makes concatenated evidence injective without relying
    // on JSON object order or separator escaping.
    def nmfe-field(s) = str_concat(int_to_str(str_len(s)), str_concat(":", s));
    def nmfe-fields(xs) = (Comparable) len(xs) == 0 ? "" : str_concat(nmfe-field(head(xs)), nmfe-fields(tail(xs)));
    def nmfe-ascii-ws?(b) = (Comparable) b == 32 || ((Comparable) b == 9 || ((Comparable) b == 10 || (Comparable) b == 13)) ? 1 : 0;
    def nmfe-ascii-upper?(b) = b >= 65 && b <= 90 ? 1 : 0;
    def nmfe-ascii-lower-byte(b) = (Comparable) nmfe-ascii-upper?(b) == 1 ? b + 32 : b;
    // pending-space records a run of whitespace only after content has begun.
    // It is emitted immediately before the next non-space byte, which trims
    // leading and trailing whitespace while collapsing internal runs.
    def nmfe-normalize-loop(s, i, started, pending-space, acc) = i >= str_len(s) ? acc : {
        let b = str_byte_at(s, i);
        (Comparable) nmfe-ascii-ws?(b) == 1 ? nmfe-normalize-loop(s, i + 1, started, started, acc) : nmfe-normalize-loop(s, i + 1, 1, 0, str_concat(acc, str_concat((Comparable) pending-space == 1 ? " " : "", byte_to_str(nmfe-ascii-lower-byte(b)))));
    };
    def nmfe-normalize(s) = nmfe-normalize-loop(s, 0, 0, 0, "");
    // ASCII word bytes follow the common word-character intent. Bytes
    // >=128 remain part of the surrounding token, keeping UTF-8 words intact.
    // Non-word ASCII punctuation is a one-byte token.
    def nmfe-word-byte?(b) = b >= 48 && b <= 57 || (b >= 65 && b <= 90 || (b >= 97 && b <= 122 || ((Comparable) b == 95 || b >= 128))) ? 1 : 0;
    def nmfe-flush-token(cur, acc) = (Comparable) str_len(cur) == 0 ? acc : cons(cur, acc);
    def nmfe-tokenize-loop(s, i, cur, acc) = i >= str_len(s) ? nmfe-reverse(nmfe-flush-token(cur, acc)) : {
        let b = str_byte_at(s, i);
        (Comparable) nmfe-ascii-ws?(b) == 1 ? nmfe-tokenize-loop(s, i + 1, "", nmfe-flush-token(cur, acc)) : (Comparable) nmfe-word-byte?(b) == 1 ? nmfe-tokenize-loop(s, i + 1, str_concat(cur, byte_to_str(nmfe-ascii-lower-byte(b))), acc) : nmfe-tokenize-loop(s, i + 1, "", cons(byte_to_str(b), nmfe-flush-token(cur, acc)));
    };
    def nmfe-tokens(s) = nmfe-tokenize-loop(nmfe-normalize(s), 0, "", []);
    def nmfe-round-div(num, den) = den <= 0 ? 0 : (num + den / 2) / den;
    // result = (found-bit remaining-list).  Prefix is reversed while walking.
    def nmfe-remove-first-loop(needle, xs, prefix) = (Comparable) len(xs) == 0 ? [0, nmfe-reverse(prefix)] : (String) needle == head(xs) ? [1, nmfe-append(nmfe-reverse(prefix), tail(xs))] : nmfe-remove-first-loop(needle, tail(xs), cons(head(xs), prefix));
    def nmfe-remove-first(needle, xs) = nmfe-remove-first-loop(needle, xs, []);
    def nmfe-overlap-loop(want, remaining-got, count) = (Comparable) len(want) == 0 ? count : {
        let removed = nmfe-remove-first(head(want), remaining-got);
        nmfe-overlap-loop(tail(want), removed[1], count + removed[0]);
    };
    // 2*overlap/(|expected|+|actual|), exactly the multiset token-F1
    // identity without separate floating-point precision and recall paths.
    def nmfe-token-f1-ppm(expected, actual) = {
        let want = nmfe-tokens(expected);
        let got = nmfe-tokens(actual);
        let total = len(want) + len(got);
        (Comparable) total == 0 ? 1000000 : nmfe-round-div(nmfe-overlap-loop(want, got, 0) * 2000000, total);
    };
    def nmfe-min2(a, b) = a < b ? a : b;
    def nmfe-min3(a, b, c) = nmfe-min2(a, nmfe-min2(b, c));
    def nmfe-iota(i, n) = i > n ? [] : cons(i, nmfe-iota(i + 1, n));
    def nmfe-last(xs) = (Comparable) len(xs) == 1 ? head(xs) : nmfe-last(tail(xs));
    def nmfe-lev-row-loop(token, reference, prev-rest, left, acc) = (Comparable) len(reference) == 0 ? acc : {
        let diag = head(prev-rest);
        let up = head(tail(prev-rest));
        let cost = (String) token == head(reference) ? 0 : 1;
        let cell = nmfe-min3(up + 1, left + 1, diag + cost);
        nmfe-lev-row-loop(token, tail(reference), tail(prev-rest), cell, cons(cell, acc));
    };
    def nmfe-lev-row(token, reference, i, prev) = nmfe-reverse(nmfe-lev-row-loop(token, reference, prev, i, cons(i, [])));
    def nmfe-lev-rows(hyp, reference, prev, i) = (Comparable) len(hyp) == 0 ? prev : nmfe-lev-rows(tail(hyp), reference, nmfe-lev-row(head(hyp), reference, i, prev), i + 1);
    def nmfe-token-distance(expected, actual) = {
        let want = nmfe-tokens(expected);
        let got = nmfe-tokens(actual);
        nmfe-last(nmfe-lev-rows(want, got, nmfe-iota(0, len(got)), 1));
    };
    def nmfe-sequence-ppm(expected, actual) = {
        let want = nmfe-tokens(expected);
        let got = nmfe-tokens(actual);
        let longest = len(want) > len(got) ? len(want) : len(got);
        (Comparable) longest == 0 ? 1000000 : 1000000 - nmfe-round-div(nmfe-token-distance(expected, actual) * 1000000, longest);
    };
    def nmfe-exact-ppm(expected, actual) = (String) nmfe-normalize(expected) == nmfe-normalize(actual) ? 1000000 : 0;
    def nmfe-promotion-score(f1, sequence) = f1 < sequence ? f1 : sequence;
    // observation = (native-model-form-observation prompt-hash expected-hash
    //                actual-hash exact f1 sequence promotion latency error)
    def nmfe-observation(prompt, expected, actual, latency, error) = {
        let f1 = (Comparable) error == 0 ? nmfe-token-f1-ppm(expected, actual) : 0;
        let sequence = (Comparable) error == 0 ? nmfe-sequence-ppm(expected, actual) : 0;
        ["native-model-form-observation", nmfe-sha256(prompt), nmfe-sha256(expected), nmfe-sha256(actual), (Comparable) error == 0 ? nmfe-exact-ppm(expected, actual) : 0, f1, sequence, nmfe-promotion-score(f1, sequence), latency, error];
    };
    def nmfe-observation?(r) = (Comparable) len(r) == 10 && (String) r[0] == "native-model-form-observation" ? 1 : 0;
    def nmfe-obs-exact(r) = r[4];
    def nmfe-obs-f1(r) = r[5];
    def nmfe-obs-sequence(r) = r[6];
    def nmfe-obs-promotion(r) = r[7];
    def nmfe-obs-latency(r) = r[8];
    def nmfe-obs-error(r) = r[9];
    def nmfe-sum-field(rows, index) = (Comparable) len(rows) == 0 ? 0 : head(rows)[index] + nmfe-sum-field(tail(rows), index);
    def nmfe-mean-field(rows, index) = (Comparable) len(rows) == 0 ? 0 : nmfe-round-div(nmfe-sum-field(rows, index), len(rows));
    // aggregate = (samples exact f1 sequence promotion latency errors)
    def nmfe-aggregate(rows) = [len(rows), nmfe-mean-field(rows, 4), nmfe-mean-field(rows, 5), nmfe-mean-field(rows, 6), nmfe-mean-field(rows, 7), nmfe-mean-field(rows, 8), nmfe-sum-field(rows, 9)];
    // A semantic row is (prompt-json expected).  File formatting and unrelated
    // metadata do not alter this identity.
    def nmfe-pair-message(row) = nmfe-fields(["native-model-pair-v1", row[0], row[1]]);
    def nmfe-pair-sha256(row) = nmfe-sha256(nmfe-pair-message(row));
    def nmfe-pair-sha256s(rows) = (Comparable) len(rows) == 0 ? [] : cons(nmfe-pair-sha256(head(rows)), nmfe-pair-sha256s(tail(rows)));
    def nmfe-prompt-sha256s(rows) = (Comparable) len(rows) == 0 ? [] : cons(nmfe-sha256(head(rows)[0]), nmfe-prompt-sha256s(tail(rows)));
    def nmfe-dataset-message(rows) = (Comparable) len(rows) == 0 ? "" : str_concat(nmfe-field(nmfe-pair-message(head(rows))), nmfe-dataset-message(tail(rows)));
    def nmfe-dataset-sha256(rows) = nmfe-sha256(nmfe-fields(["native-model-dataset-v1", nmfe-dataset-message(rows)]));
    def nmfe-string-in?(needle, xs) = (Comparable) len(xs) == 0 ? 0 : (String) needle == head(xs) ? 1 : nmfe-string-in?(needle, tail(xs));
    def nmfe-overlap-count(left, right) = (Comparable) len(left) == 0 ? 0 : nmfe-string-in?(head(left), right) + nmfe-overlap-count(tail(left), right);
    def nmfe-isolated?(heldout, training) = (Comparable) nmfe-overlap-count(nmfe-pair-sha256s(heldout), nmfe-pair-sha256s(training)) == 0 && (Comparable) nmfe-overlap-count(nmfe-prompt-sha256s(heldout), nmfe-prompt-sha256s(training)) == 0 ? 1 : 0;
    def nmfe-hex-value(b) = b >= 48 && b <= 57 ? b - 48 : b >= 97 && b <= 102 ? 10 + (b - 97) : 0;
    def nmfe-hex-mod-loop(hex, i, modulus, acc) = i >= str_len(hex) ? acc : nmfe-hex-mod-loop(hex, i + 1, modulus, (acc * 16 + nmfe-hex-value(str_byte_at(hex, i))) % modulus);
    def nmfe-rotation-start(seed, population) = population <= 0 ? 0 : nmfe-hex-mod-loop(nmfe-sha256(seed), 0, population, 0);
    def nmfe-rotating-loop(rows, population, at, remaining, acc) = remaining <= 0 ? nmfe-reverse(acc) : nmfe-rotating-loop(rows, population, (at + 1) % population, remaining - 1, cons(rows[at], acc));
    def nmfe-rotating-slice(rows, count, seed) = {
        let population = len(rows);
        let n = count < population ? count : population;
        (Comparable) population == 0 ? [] : nmfe-rotating-loop(rows, population, nmfe-rotation-start(seed, population), n, []);
    };
    0;
}
