; dsv4-control-token-cli.fk — exact Form-native control alias surface.
;
;   printf 'encode NIL\n' | ./fkwu form/form-stdlib/dsv4-control-token-cli.fk
;   printf 'decode 128000\n' | ./fkwu form/form-stdlib/dsv4-control-token-cli.fk
;
; preludes: form-stdlib/dsv4-control-tokens.fk

(do
    (defn dctc-encode (name)
        (do (let id (dct-id name))
            (print_str "channel=ds4.control-token.form-native")
            (print_str "operation=encode")
            (print_str (str_concat "control=" name))
            (print_str (str_concat "wire=" (dct-wire name)))
            (print_str (str_concat "token_id=" (int_to_str id)))
            id))
    (defn dctc-decode (id)
        (do (let name (dct-name id))
            (print_str "channel=ds4.control-token.form-native")
            (print_str "operation=decode")
            (print_str (str_concat "token_id=" (int_to_str id)))
            (print_str (str_concat "control=" name))
            (print_str (str_concat "wire=" (dct-wire name)))
            name))
    (defn dctc-main (line)
        (if (eq (substring line 0 (min2 7 (str_len line))) "encode ")
            (dctc-encode (substring line 7 (str_len line)))
        (if (eq (substring line 0 (min2 7 (str_len line))) "decode ")
            (dctc-decode (str_to_int (substring line 7 (str_len line))))
            (print_str "usage=encode NIL|CUT|FAIL|TIMEOUT|CHOICE | decode <token-id>"))))
    (dctc-main (read_line)))
