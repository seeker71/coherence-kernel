; stdin: revision, shard1 size/hash, shard2 size/hash, config/tokenizer/index hashes.
; preludes: form-stdlib/core.fk form-stdlib/nanbeige-package-admission.fk
(do
    (let revision (read_line))
    (let s1-size (str_to_int (read_line)))
    (let s1-sha (read_line))
    (let s2-size (str_to_int (read_line)))
    (let s2-sha (read_line))
    (let config-sha (read_line))
    (let tokenizer-sha (read_line))
    (let index-sha (read_line))
    (print_str (str_concat "package_admitted="
        (str_concat (int_to_str
            (nbpa-admit? revision s1-size s1-sha s2-size s2-sha
                         config-sha tokenizer-sha index-sha))
                    "\n"))))
