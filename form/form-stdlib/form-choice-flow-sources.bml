//////////////////////////////////////////////////////////////////////
//
// form-choice-flow-sources.bml — the places this body already decides,
// each given a choice point whose ledger is the count the body itself keeps.
//
// form-choice-flow.bml carries the shape of a choice: an option, a ledger,
// flow and restriction, a finding, a play. It stands empty until real
// decisions arrive. This shard is where they arrive from — and every ledger
// leg here is read from a counter the body was already keeping before this
// file existed. Nothing is sampled, nothing is estimated, and where a
// decision has only one leg the body can witness, it is published as ONE
// option so the corridor shows as a corridor.
//
// Seven points, and where each ledger comes from:
//
//   jit.crystallize   the live page's per-defn native flag (kernel_page_hot):
//                     >0 crystallized (taken), 0 still walking (held), <0
//                     refused (declined); the held rows' heat is the wait.
//   jit.box           both legs from the live page: fbox is a pool slot minted
//                     for a float result, and the fold column is a body that
//                     ran as this machine's own instructions with nothing
//                     minted per result. Flow here is how much of this body's
//                     float work runs in registers.
//   jit.mint          the mint ledger (kernel_page_box pid -n): a call either
//                     answered from an interned node or grew the arena.
//   organ.surprise-route  the organs frame's own choice rows, as NUMBERS: the
//                     routing row's capacity is every surprise attempted, the
//                     choice row's capacity is the part that moved, and the
//                     options are the movement states published in that row's
//                     own channels. surprise.last carries the epoch of the last
//                     surprise that MOVED, so the wait on every offer still
//                     resting is now minus that.
//   organ.protocol-floor  the same frame's protocol row: the proven count is
//                     its capacity, the floor's size still its purpose text.
//   glass.frame       the live roster: every publisher in this space, and
//                     whether its frame was GIVEN inside its window (a taking),
//                     absent or standing-but-silent (the offer held), or
//                     malformed (a decline). Standing is not giving: shared
//                     memory outlives the process.
//   governor.metal-admission  the resource governor's admission row, whose
//                     lifecycles ARE the body's outcomes — active is a taking,
//                     failed a decline, ready the held offer standing, and
//                     unknown a tick where the governor never read its signals
//                     and so put no choice at all. Fed through fcf-ledger-note,
//                     tick by tick, so this ledger grows as the governor
//                     decides and stands still when it never got to ask.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-choice-flow.bml form/form-stdlib/form-glass-telemetry-membrane.bml

section [form.bml] {
    class FormChoiceFlowSources {
        field FCFSHotRows = 24;
        // a frame not given for this many of its own tick windows is standing, not giving
        field FCFSFrameCadenceMs = 1000;
        field FCFSSilentFactor = 3;
        field FCFSOrgansPublisher = "organs";
        field FCFSGovernorPublisher = "resource.governor";
        field FCFSRouteSample = "surprise.routing";
        field FCFSChoiceSample = "choice.surprise-route";
        field FCFSLastSample = "surprise.last";
        field FCFSProtocolSample = "choice.protocol-floor";
        field FCFSAdmissionSample = "governor.admission.metal";

        // ---- one live page row: (heat name unit line col fbox unbox native mint fold) ----
        def fcfs-row-heat(r) = len(r) < 1 ? 0 : r[0];
        def fcfs-row-name(r) = len(r) < 2 ? "" : r[1];
        def fcfs-row-fbox(r) = len(r) < 6 ? 0 : r[5];
        def fcfs-row-unbox(r) = len(r) < 7 ? 0 : r[6];
        def fcfs-row-native(r) = len(r) < 8 ? 0 : r[7];
        def fcfs-row-mint(r) = len(r) < 9 ? 0 : r[8];
        // field 9: the FOLD leg -- calls this recipe ran as this machine's own
        // instructions, no pool slot per result. Absent from a row an older
        // kernel gave, and an absent count reads 0 folds, never a fabricated one.
        def fcfs-row-fold(r) = len(r) < 10 ? 0 : r[9];
        def fcfs-least(a, b) = a < b ? a : b;
        def fcfs-floor0(n) = n < 0 ? 0 : n;

        // ---- 1. crystallize or walk ------------------------------------------
        // The kernel decides this per defn, every time the heat lane sees one.
        // One walk of the rows, and one only: the page hands every leg over
        // acc = list(crystallized, walking, refused, waitServed, firstWalkingHeat)
        //   the wait a still-walking recipe has served is the calls it made while not yet crystallized
        // A recipe the heat lane has never ASKED about was never offered this
        // choice. The kernel puts the question at a 1024-call boundary
        // (FK_F64_HEAT in the seed: fk_heat_pulse and fk_f64_pulse both fire on
        // `heat & (FK_F64_HEAT - 1)`), so a defn called nine times is not a
        // recipe holding out against crystallization -- it is a recipe nobody
        // has been asked about yet. Every hot row counted as an offer until
        // 2026-09-08, which is why a kernel one second old read "24 of 24 held,
        // wait not falling" and published a stall that was a cold start.
        field FCFSAskedAt = 1024;
        // Two lanes put this question and they trigger differently: the loop
        // lane on a 1024-CALL boundary (fk_heat_pulse) and the float lane on a
        // 1024-BOX boundary (fk_f64_pulse from fk_fbox), so a float-heavy recipe
        // is asked after about five hundred calls. Witnessed 2026-09-08: a defn
        // called 1000 times already stood crystallized. An answer is proof the
        // question was put, whatever the heat says.
        def fcfs-row-asked?(r) = !((Comparable) fcfs-row-native(r) == 0) ? 1 : fcfs-row-heat(r) < FCFSAskedAt() ? 0 : 1;
        def fcfs-crystallize-step(r, acc) {
            let native = fcfs-row-native(r);
            let asked = fcfs-row-asked?(r);
            let walking = ((Comparable) asked == 1) && ((Comparable) native == 0) ? 1 : 0;
            list(acc[0] + (((Comparable) asked == 1) && (native > 0) ? 1 : 0),
                 acc[1] + walking,
                 acc[2] + (((Comparable) asked == 1) && (native < 0) ? 1 : 0),
                 acc[3] + (walking * fcfs-row-heat(r)),
                 ((Comparable) walking == 1) && (acc[4] < 0) ? fcfs-row-heat(r) : acc[4]);
        }
        def fcfs-crystallize-fold(rows, acc) = (Comparable) len(rows) == 0 ? acc : fcfs-crystallize-fold(tail(rows), fcfs-crystallize-step(head(rows), acc));
        def fcfs-asked-count(rows, acc) = (Comparable) len(rows) == 0 ? acc : fcfs-asked-count(tail(rows), acc + fcfs-row-asked?(head(rows)));
        def fcfs-crystallize-options() = list(
            fcf-option("walk", "walk the tree again, every call", 2, 1, 100, 100),
            fcf-option("crystallize", "run it as this machine's own instructions", 8, 40, 90, 80));
        def fcfs-crystallize-ledger(rows) {
            let f = fcfs-crystallize-fold(rows, list(0, 0, 0, 0, -1));
            fcf-ledger(fcfs-asked-count(rows, 0), f[0], f[1], f[2], f[3], fcfs-floor0(f[4]));
        }
        def fcfs-crystallize-point(rows) = fcf-point("jit.crystallize", "walk this recipe again, or crystallize it?", fcfs-crystallize-options(), fcfs-crystallize-ledger(rows));
        def fcfs-crystallize-point-live(pid) = fcfs-crystallize-point(kernel_page_hot(pid, FCFSHotRows()));

        // ---- 2. box or fold ---------------------------------------------------
        // acc = list(boxed, folded), one walk. BOTH legs are counted on the page
        // now: fbox is a pool slot minted for a float result, and the fold column
        // (kernel_page_hot with a negative n, or field 9 of any row) is a body
        // that ran as this machine's own instructions with its intermediates in
        // registers. Both legs are counted, so this is a real two-way choice
        def fcfs-box-step(r, acc) = list(acc[0] + fcfs-row-fbox(r), acc[1] + fcfs-row-fold(r));
        def fcfs-box-fold(rows, acc) = (Comparable) len(rows) == 0 ? acc : fcfs-box-fold(tail(rows), fcfs-box-step(head(rows), acc));
        def fcfs-box-options() = list(
            fcf-option("fold", "run the whole body in registers, no slot per result", 0, 8, 100, 100),
            fcf-option("box", "mint a float pool slot the value can be read from anywhere", 1, 4, 100, 100));
        def fcfs-box-ledger(rows) {
            let f = fcfs-box-fold(rows, list(0, 0));
            fcf-ledger(f[0] + f[1], f[1], 0, f[0], 0, 0);
        }
        def fcfs-box-point(rows) = fcf-point("jit.box", "box this float, or fold it where it stands?", fcfs-box-options(), fcfs-box-ledger(rows));
        def fcfs-box-point-live(pid) = fcfs-box-point(kernel_page_hot(pid, FCFSHotRows()));

        // ---- 3. reuse or mint -------------------------------------------------
        // Every call either answered from an interned node or grew the permanent
        // arena by one. Reuse is the taking; a mint is the offer to flow for free
        // closing, so it lands on the declined leg and reads as restriction.
        // acc = list(calls, minted), one walk for both columns
        def fcfs-mint-step(r, acc) = list(acc[0] + fcfs-row-heat(r), acc[1] + fcfs-row-mint(r));
        def fcfs-mint-fold(rows, acc) = (Comparable) len(rows) == 0 ? acc : fcfs-mint-fold(tail(rows), fcfs-mint-step(head(rows), acc));
        def fcfs-mint-options() = list(
            fcf-option("reuse", "answer from the node already interned", 0, 10, 100, 100),
            fcf-option("mint", "grow the permanent arena by one node", 10, 10, 70, 90));
        def fcfs-mint-ledger(rows) {
            let f = fcfs-mint-fold(rows, list(0, 0));
            let offered = f[0];
            let minted = fcfs-least(f[1], offered);
            fcf-ledger(offered, offered - minted, 0, minted, 0, 0);
        }
        def fcfs-mint-point(rows) = fcf-point("jit.mint", "reuse an interned value, or grow the arena with a fresh one?", fcfs-mint-options(), fcfs-mint-ledger(rows));
        // The HOT rows, not the mint-ranked ones. Ranking by mints means a body
        // whose arena stopped growing has no rows at all, so the point read DARK
        // -- never offered -- when the truth is the opposite: the choice was put
        // on every call and reuse won every time. Every call is offered this
        // choice, so every hot recipe is in the conversation.
        def fcfs-mint-point-live(pid) = fcfs-mint-point(kernel_page_hot(pid, FCFSHotRows()));

        // ---- reading a number the body already wrote into a row's purpose -----
        // A count the body publishes as a NUMBER is read as a number: the
        // membrane's own capacity field, through fcfs-sample-capacity. Only
        // where a row still carries a count in its purpose text alone does a
        // reader parse, and it never guesses a missing one — an absent marker
        // answers the caller's fallback.
        def fcfs-number-after(text, open, fallback) {
            let a = str_find(text, open, 0);
            a < 0 ? fallback : str_to_int(substring(text, a + str_len(open), str_len(text)));
        }
        def fcfs-sample-capacity(sample, fallback) = (Comparable) len(sample) == 0 ? fallback : (Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1 ? fgtm-field-value(fgtm-sample-capacity(sample)) : fallback;
        def fcfs-find-sample(samples, id) = (Comparable) len(samples) == 0 ? list() : (String) fgtm-sample-id(head(samples)) == id ? head(samples) : fcfs-find-sample(tail(samples), id);

        // ---- 4. where a surprise moves ---------------------------------------
        // The surprise organ has kept attempts, successes and failures since it
        // stood up, and it publishes the movement states it chooses among in the
        // choice row's own channels. Both are read here; neither is invented.
        def fcfs-route-channel-options(channels) = len(channels) <= 2 ? list() : fcfs-options-of-names(tail(tail(channels)));
        def fcfs-options-of-names(names) = (Comparable) len(names) == 0 ? list() : cons(fcf-option(head(names), "move as " ++ head(names), 1, 8, 100, 100), fcfs-options-of-names(tail(names)));
        def fcfs-surprise-options(choiceSample) = (Comparable) len(choiceSample) == 0 ? list() : fcfs-route-channel-options(fgtm-sample-channels(choiceSample));
        // The routing row's capacity is every surprise attempted; the choice
        // row's capacity is the part that MOVED. Everything else attempted is
        // held: a rested surprise is a movement chosen (hold, rest or compost),
        // never a decline — the routing row stopped calling its own resting
        // states failures. The rested count cancels: held is attempts less
        // carried, so only two numbers are ever read.
        // Both numbers, or no reading. A whole with no part is not a whole that
        // moved nothing: if the choice row is not standing, this point knows
        // only how many surprises arrived and nothing about where they went,
        // and answering "carried 0" there would publish 100% holding out of a
        // row that never came.
        def fcfs-capacity-read?(sample) = (Comparable) len(sample) == 0 ? 0 : fgtm-field-present?(fgtm-sample-capacity(sample));
        // The held offers here ARE clocked: surprise.last carries the epoch of
        // the last surprise that moved, so how long the routing has been resting
        // is now minus that. The point held nine of every ten offers with no
        // clock on them -- a real gap-unclocked, and it stood only because every
        // organ row stamped its write epoch "now" whatever it reported.
        def fcfs-sample-wrote-at(sample, fallback) = (Comparable) len(sample) == 0 ? fallback : (Comparable) fgtm-field-present?(fgtm-sample-write-epoch(sample)) == 1 ? fgtm-field-value(fgtm-sample-write-epoch(sample)) : fallback;
        def fcfs-rest-wait(lastSample, now) {
            let at = fcfs-sample-wrote-at(lastSample, now);
            (at < 0) || (at > now) ? 0 : (now - at);
        }
        def fcfs-surprise-ledger(routingSample, choiceSample, lastSample, now) {
            let attempts = fcfs-sample-capacity(routingSample, 0);
            let carried = fcfs-least(fcfs-sample-capacity(choiceSample, 0), attempts);
            let resting = fcfs-floor0(attempts - carried);
            let wait = fcfs-rest-wait(lastSample, now);
            (Comparable) fcfs-capacity-read?(routingSample) == 0 ? fcf-ledger-empty() : (Comparable) fcfs-capacity-read?(choiceSample) == 0 ? fcf-ledger-empty() : fcf-ledger(attempts, carried, resting, 0, resting * wait, wait);
        }
        def fcfs-surprise-point(routingSample, choiceSample, lastSample, now) = fcf-point("organ.surprise-route", "where does this surprise move?", fcfs-surprise-options(choiceSample), fcfs-surprise-ledger(routingSample, choiceSample, lastSample, now));
        def fcfs-surprise-point-of(samples) = fcfs-surprise-point(fcfs-find-sample(samples, FCFSRouteSample()), fcfs-find-sample(samples, FCFSChoiceSample()), fcfs-find-sample(samples, FCFSLastSample()), now_unix_ms());

        // ---- 5. the protocol floor -------------------------------------------
        def fcfs-protocol-options() = list(
            fcf-option("proven", "carry a source the four-way floor has proven", 2, 20, 100, 100),
            fcf-option("unproven", "carry a source no band has stood behind yet", 2, 20, 40, 30));
        // The proven count is the row's own capacity; only the floor's SIZE is
        // still text on this row, so exactly one number here is parsed.
        def fcfs-protocol-ledger(sample) {
            let total = fcfs-number-after((Comparable) len(sample) == 0 ? "" : fgtm-sample-purpose(sample), "-of-", 0);
            let proven = fcfs-least(fcfs-sample-capacity(sample, 0), total);
            (Comparable) fcfs-capacity-read?(sample) == 0 ? fcf-ledger-empty() : fcf-ledger(total, proven, total - proven, 0, 0, 0);
        }
        def fcfs-protocol-point(sample) = fcf-point("organ.protocol-floor", "which protocol sources does this channel stand on?", fcfs-protocol-options(), fcfs-protocol-ledger(sample));
        def fcfs-protocol-point-of(samples) = fcfs-protocol-point(fcfs-find-sample(samples, FCFSProtocolSample()));

        // ---- 6. which frame the glass takes ----------------------------------
        // Every tick the glass may take any publisher standing in this space.
        // A frame GIVEN inside its window is a taking; a frame absent, or
        // standing but silent, is the held offer -- its giver may speak again;
        // malformed or refused is a decline.
        // "current" only says a frame parsed, and shared memory outlives the
        // process, so the window is what tells a giver from a corpse
        // (fgtm-read-given-within?, where the membrane holds the reading).
        def fcfs-frame-window() = FCFSSilentFactor() * FCFSFrameCadenceMs();
        def fcfs-frame-status-at(root, publisher, now) {
            let reading = fgtm-read-current(root, publisher);
            let status = fgtm-read-state-status(reading);
            !((String) status == "current") ? status : (Comparable) fgtm-read-given-within?(reading, now, fcfs-frame-window()) == 1 ? "current" : "silent";
        }
        def fcfs-frame-status(root, publisher) = fcfs-frame-status-at(root, publisher, now_unix_ms());
        // The wait on a held offer here is not a guess: a silent frame's own age
        // IS how long that offer has stood. The point held half its offers with
        // no clock on them, which is a gap-unclocked waiting to fire -- and the
        // number was already being read one door away to decide "silent".
        def fcfs-frame-reading-at(root, publisher, now) {
            let reading = fgtm-read-current(root, publisher);
            let status = fgtm-read-state-status(reading);
            let age = fgtm-read-age(reading, now);
            let given = !((String) status == "current") ? 0 : fgtm-read-given-within?(reading, now, fcfs-frame-window());
            list(!((String) status == "current") ? status : (Comparable) given == 1 ? "current" : "silent", age < 0 ? 0 : age);
        }
        def fcfs-reading-status(r) = head(r);
        def fcfs-reading-age(r) = r[1];
        def fcfs-frame-taken?(status) = (String) status == "current" ? 1 : 0;
        def fcfs-frame-held?(status) = (String) status == "absent" ? 1 : (String) status == "silent" ? 1 : 0;
        def fcfs-frame-declined?(status) = (Comparable) fcfs-frame-taken?(status) == 1 ? 0 : (Comparable) fcfs-frame-held?(status) == 1 ? 0 : 1;
        // acc = list(taken, held, declined, waitOnHeld, firstHeldAge)
        def fcfs-frame-step(r, acc) {
            let held = fcfs-frame-held?(fcfs-reading-status(r));
            list(acc[0] + fcfs-frame-taken?(fcfs-reading-status(r)),
                 acc[1] + held,
                 acc[2] + fcfs-frame-declined?(fcfs-reading-status(r)),
                 acc[3] + (held * fcfs-reading-age(r)),
                 (((Comparable) held == 1) && (fcfs-reading-age(r) > 0)) && (acc[4] < 0) ? fcfs-reading-age(r) : acc[4]);
        }
        def fcfs-frame-fold(readings, acc) = (Comparable) len(readings) == 0 ? acc : fcfs-frame-fold(tail(readings), fcfs-frame-step(head(readings), acc));
        def fcfs-frame-readings(root, publishers) = (Comparable) len(publishers) == 0 ? list() : cons(fcfs-frame-reading-at(root, head(publishers), now_unix_ms()), fcfs-frame-readings(root, tail(publishers)));
        // a status with no age is a reading with no clock, and reads as one
        def fcfs-readings-of-statuses(ss) = (Comparable) len(ss) == 0 ? list() : cons(list(head(ss), 0), fcfs-readings-of-statuses(tail(ss)));
        def fcfs-frame-option(publisher, r) = fcf-option(publisher, "take the " ++ publisher ++ " frame", 1, 12, 100, (Comparable) fcfs-frame-taken?(fcfs-reading-status(r)) == 1 ? 100 : 0);
        def fcfs-frame-options(publishers, readings) = (Comparable) len(publishers) == 0 ? list() : cons(fcfs-frame-option(head(publishers), head(readings)), fcfs-frame-options(tail(publishers), tail(readings)));
        def fcfs-frame-ledger(readings) {
            let f = fcfs-frame-fold(readings, list(0, 0, 0, 0, -1));
            fcf-ledger(len(readings), f[0], f[1], f[2], f[3], fcfs-floor0(f[4]));
        }
        def fcfs-frame-point(publishers, readings) = fcf-point("glass.frame", "which publisher's frame does the glass take this tick?", fcfs-frame-options(publishers, readings), fcfs-frame-ledger(readings));
        def fcfs-frame-point-live(root) = fcfs-frame-point-with(root, fgtm-roster-in-space(gift_roster_names(), root));
        def fcfs-frame-point-with(root, publishers) = fcfs-frame-point(publishers, fcfs-frame-readings(root, publishers));

        // ---- 7. the governor's admission -------------------------------------
        // The admission row's three lifecycles are already the body's three
        // outcomes, so this point's ledger grows through fcf-ledger-note and
        // nothing here has to count anything twice.
        // A tick where the governor never read its signals put no choice at all,
        // and neither does a tick where the governor's frame is not standing.
        // Both once landed as silence, which counts an OFFER, so an idle host
        // grew a ledger of offers nobody ever made and the point read as a
        // wound. Nothing put, nothing noted.
        def fcfs-admission-outcome(sample) = (Comparable) len(sample) == 0 ? fcf-outcome-none() : (String) fgtm-sample-lifecycle(sample) == "unknown" ? fcf-outcome-none() : (String) fgtm-sample-lifecycle(sample) == "active" ? cr-outcome-success() : (String) fgtm-sample-lifecycle(sample) == "failed" ? cr-outcome-fail() : cr-outcome-silence();
        def fcfs-admission-options() = list(
            fcf-option("admit", "submit this quantum to the metal now", 4, 30, 100, 90),
            fcf-option("hold", "hold it until the frame has room", 1, 6, 100, 100));
        def fcfs-admission-point(ledger) = fcf-point("governor.metal-admission", "admit this metal quantum, or hold it?", fcfs-admission-options(), ledger);
        def fcfs-admission-note(ledger, sample, waitMs) = fcf-ledger-note(ledger, fcfs-admission-outcome(sample), waitMs);
        def fcfs-admission-point-of(samples, ledger, waitMs) = fcfs-admission-point(fcfs-admission-note(ledger, fcfs-find-sample(samples, FCFSAdmissionSample()), waitMs));

        // There is no route.category point, and the reason belongs here so it is
        // not re-added blind: brcr-protocol-choice-candidates has one caller in
        // the whole body, and it is a display of candidates for a choice no live
        // path ever puts. A point watching a lane nothing reaches learns nothing
        // and publishes a dark row every second. When a live path routes a
        // category, it comes back with a ledger.

        // ---- every point this body has, in one sequence ----------------------
        // The order is the order a decision actually travels: the kernel decides
        // how to run a recipe, then what to keep, then the organs decide where a
        // surprise goes, then the glass decides what to take, then the governor
        // decides whether the metal moves, and last the route lane that has
        // never been asked at all.
        def fcfs-points(pid, root, organSamples, governorSamples, admissionLedger, waitMs) = list(
            fcfs-crystallize-point-live(pid),
            fcfs-box-point-live(pid),
            fcfs-mint-point-live(pid),
            fcfs-surprise-point-of(organSamples),
            fcfs-protocol-point-of(organSamples),
            fcfs-frame-point-live(root),
            fcfs-admission-point-of(governorSamples, admissionLedger, waitMs));
        def fcfs-point-ids(points) = (Comparable) len(points) == 0 ? list() : cons(fcf-point-id(head(points)), fcfs-point-ids(tail(points)));
        def fcfs-find-point(points, id) = (Comparable) len(points) == 0 ? list() : (String) fcf-point-id(head(points)) == id ? head(points) : fcfs-find-point(tail(points), id);
    }
    0;
}
