//////////////////////////////////////////////////////////////////////
//
// form-choice-flow-sources.bml — the places this body already decides,
// each given a choice point whose ledger is the count the body itself keeps.
//
// form-choice-flow.bml carries the shape of a choice: an option, a ledger,
// flow and restriction, a finding, a play. It stands empty until real
// decisions arrive. This shard is where they arrive from — and every ledger
// leg here is read from a counter the body was already keeping before this
// file existed. Nothing is sampled, nothing is estimated, and where a
// decision has only one leg the body can witness, it is published as ONE
// option so the corridor shows as a corridor.
//
// Eight points, and where each ledger comes from:
//
//   jit.crystallize   the live page's per-defn native flag (kernel_page_hot):
//                     >0 crystallized (taken), 0 still walking (held), <0
//                     refused (declined); the held rows' heat is the wait.
//   jit.box           the boxing worklist (kernel_page_box pid n): slots
//                     minted and slots read. ONE option: the fold leg — the
//                     transparent f64 leaf — leaves no count on the page, so
//                     this point is a corridor and asks for its second leg.
//   jit.mint          the mint ledger (kernel_page_box pid -n): a call either
//                     answered from an interned node or grew the arena.
//   organ.surprise-route  the organs frame's own choice rows: attempts,
//                     successes and failures the surprise organ already keeps,
//                     and the options it publishes in the row's own channels.
//   organ.protocol-floor  the same frame's protocol row: proven-N-of-M.
//   glass.frame       the live roster: every publisher in this space, and
//                     whether its frame read current, absent or malformed.
//   governor.metal-admission  the resource governor's admission row, whose
//                     three lifecycles ARE the body's three outcomes —
//                     active is a taking, failed a decline, ready the held
//                     offer standing. Fed through fcf-ledger-note, tick by
//                     tick, so this ledger grows as the governor decides.
//   route.category    bml-route-choice-runtime's real protocol candidates,
//                     lifted through branch-choice-order so the option scale
//                     is the body's own. Its ledger is empty and it reads
//                     DARK: this lane has never been metered. That is the
//                     finding, not a defect in this file.
//
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-choice-flow.bml form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/bml-route-choice-runtime.fk

section [form.bml] {
    class FormChoiceFlowSources {
        field FCFSHotRows = 24;
        field FCFSOrgansPublisher = "organs";
        field FCFSGovernorPublisher = "resource.governor";
        field FCFSRouteSample = "surprise.routing";
        field FCFSChoiceSample = "choice.surprise-route";
        field FCFSProtocolSample = "choice.protocol-floor";
        field FCFSAdmissionSample = "governor.admission.metal";

        // ---- one live page row: (heat name unit line col fbox unbox native mint) ----
        def fcfs-row-heat(r) = if lt(len(r), 1) then 0 else nth(r, 0);
        def fcfs-row-name(r) = if lt(len(r), 2) then "" else nth(r, 1);
        def fcfs-row-fbox(r) = if lt(len(r), 6) then 0 else nth(r, 5);
        def fcfs-row-unbox(r) = if lt(len(r), 7) then 0 else nth(r, 6);
        def fcfs-row-native(r) = if lt(len(r), 8) then 0 else nth(r, 7);
        def fcfs-row-mint(r) = if lt(len(r), 9) then 0 else nth(r, 8);
        def fcfs-least(a, b) = if lt(a, b) then a else b;
        def fcfs-floor0(n) = if lt(n, 0) then 0 else n;

        // ---- 1. crystallize or walk ------------------------------------------
        // The kernel decides this per defn, every time the heat lane sees one.
        def fcfs-crystallized?(r) = if gt(fcfs-row-native(r), 0) then 1 else 0;
        def fcfs-walking?(r) = if eq(fcfs-row-native(r), 0) then 1 else 0;
        def fcfs-refused?(r) = if lt(fcfs-row-native(r), 0) then 1 else 0;
        def fcfs-sum-crystallized(rows, acc) = if eq(len(rows), 0) then acc else fcfs-sum-crystallized(tail(rows), add(acc, fcfs-crystallized?(head(rows))));
        def fcfs-sum-walking(rows, acc) = if eq(len(rows), 0) then acc else fcfs-sum-walking(tail(rows), add(acc, fcfs-walking?(head(rows))));
        def fcfs-sum-refused(rows, acc) = if eq(len(rows), 0) then acc else fcfs-sum-refused(tail(rows), add(acc, fcfs-refused?(head(rows))));
        // the wait a still-walking recipe has already served: the calls it made while not yet crystallized
        def fcfs-walking-wait(rows, acc) = if eq(len(rows), 0) then acc else fcfs-walking-wait(tail(rows), add(acc, mul(fcfs-walking?(head(rows)), fcfs-row-heat(head(rows)))));
        def fcfs-walking-last(rows) = if eq(len(rows), 0) then 0 else if eq(fcfs-walking?(head(rows)), 1) then fcfs-row-heat(head(rows)) else fcfs-walking-last(tail(rows));
        def fcfs-crystallize-options() = list(
            fcf-option("walk", "walk the tree again, every call", 2, 1, 100, 100),
            fcf-option("crystallize", "run it as this machine's own instructions", 8, 40, 90, 80));
        def fcfs-crystallize-ledger(rows) = fcf-ledger(len(rows), fcfs-sum-crystallized(rows, 0), fcfs-sum-walking(rows, 0), fcfs-sum-refused(rows, 0), fcfs-walking-wait(rows, 0), fcfs-walking-last(rows));
        def fcfs-crystallize-point(rows) = fcf-point("jit.crystallize", "walk this recipe again, or crystallize it?", fcfs-crystallize-options(), fcfs-crystallize-ledger(rows));
        def fcfs-crystallize-point-live(pid) = fcfs-crystallize-point(kernel_page_hot(pid, FCFSHotRows()));

        // ---- 2. box or fold ---------------------------------------------------
        // The page counts slots minted and slots read. It counts no folds: a
        // float that stayed transparent leaves nothing behind. So the point
        // carries the ONE option it can witness and reads as a corridor —
        // the ask is a counter for the fold leg, not a second option invented here.
        def fcfs-sum-fbox(rows, acc) = if eq(len(rows), 0) then acc else fcfs-sum-fbox(tail(rows), add(acc, fcfs-row-fbox(head(rows))));
        def fcfs-sum-read(rows, acc) = if eq(len(rows), 0) then acc else fcfs-sum-read(tail(rows), add(acc, fcfs-least(fcfs-row-fbox(head(rows)), fcfs-row-unbox(head(rows)))));
        def fcfs-box-options() = list(fcf-option("box", "mint a float slot the value can be read from", 3, 6, 100, 100));
        def fcfs-box-ledger(rows) = fcf-ledger(fcfs-sum-fbox(rows, 0), fcfs-sum-read(rows, 0), fcfs-floor0(sub(fcfs-sum-fbox(rows, 0), fcfs-sum-read(rows, 0))), 0, 0, 0);
        def fcfs-box-point(rows) = fcf-point("jit.box", "box this float, or fold it where it stands?", fcfs-box-options(), fcfs-box-ledger(rows));
        def fcfs-box-point-live(pid) = fcfs-box-point(kernel_page_box(pid, FCFSHotRows()));

        // ---- 3. reuse or mint -------------------------------------------------
        // Every call either answered from an interned node or grew the permanent
        // arena by one. Reuse is the taking; a mint is the offer to flow for free
        // closing, so it lands on the declined leg and reads as restriction.
        def fcfs-sum-heat(rows, acc) = if eq(len(rows), 0) then acc else fcfs-sum-heat(tail(rows), add(acc, fcfs-row-heat(head(rows))));
        def fcfs-sum-mint(rows, acc) = if eq(len(rows), 0) then acc else fcfs-sum-mint(tail(rows), add(acc, fcfs-row-mint(head(rows))));
        def fcfs-mint-options() = list(
            fcf-option("reuse", "answer from the node already interned", 0, 10, 100, 100),
            fcf-option("mint", "grow the permanent arena by one node", 10, 10, 70, 90));
        def fcfs-mint-ledger(rows) {
            let offered = fcfs-sum-heat(rows, 0);
            let minted = fcfs-least(fcfs-sum-mint(rows, 0), offered);
            fcf-ledger(offered, sub(offered, minted), 0, minted, 0, 0);
        }
        def fcfs-mint-point(rows) = fcf-point("jit.mint", "reuse an interned value, or grow the arena with a fresh one?", fcfs-mint-options(), fcfs-mint-ledger(rows));
        def fcfs-mint-point-live(pid) = fcfs-mint-point(kernel_page_box(pid, sub(0, FCFSHotRows())));

        // ---- reading a number the body already wrote into a row's purpose -----
        // The organs frame publishes its counts as text in the sample's own
        // purpose ("s3-f1", "proven-7-of-9"). This reads them back; it never
        // guesses a missing one — an absent marker answers the caller's fallback.
        def fcfs-number-between(text, open, close, fallback) {
            let a = str_find(text, open, 0);
            let b = if lt(a, 0) then -1 else str_find(text, close, add(a, str_len(open)));
            if lt(b, 0) then fallback else str_to_int(substring(text, add(a, str_len(open)), b));
        }
        def fcfs-number-after(text, open, fallback) {
            let a = str_find(text, open, 0);
            if lt(a, 0) then fallback else str_to_int(substring(text, add(a, str_len(open)), str_len(text)));
        }
        def fcfs-sample-capacity(sample, fallback) = if eq(len(sample), 0) then fallback else if eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1) then fgtm-field-value(fgtm-sample-capacity(sample)) else fallback;
        def fcfs-find-sample(samples, id) = if eq(len(samples), 0) then list() else if str_eq(fgtm-sample-id(head(samples)), id) then head(samples) else fcfs-find-sample(tail(samples), id);

        // ---- 4. where a surprise moves ---------------------------------------
        // The surprise organ has kept attempts, successes and failures since it
        // stood up, and it publishes the movement states it chooses among in the
        // choice row's own channels. Both are read here; neither is invented.
        def fcfs-route-channel-options(channels) = if le(len(channels), 2) then list() else fcfs-options-of-names(tail(tail(channels)));
        def fcfs-options-of-names(names) = if eq(len(names), 0) then list() else cons(fcf-option(head(names), str_concat("move as ", head(names)), 1, 8, 100, 100), fcfs-options-of-names(tail(names)));
        def fcfs-surprise-options(choiceSample) = if eq(len(choiceSample), 0) then list() else fcfs-route-channel-options(fgtm-sample-channels(choiceSample));
        def fcfs-surprise-ledger(routingSample) {
            let attempts = fcfs-sample-capacity(routingSample, 0);
            let purpose = if eq(len(routingSample), 0) then "" else fgtm-sample-purpose(routingSample);
            let successes = fcfs-number-between(purpose, "s", "-f", 0);
            let failures = fcfs-number-after(purpose, "-f", 0);
            fcf-ledger(attempts, successes, fcfs-floor0(sub(attempts, add(successes, failures))), failures, 0, 0);
        }
        def fcfs-surprise-point(routingSample, choiceSample) = fcf-point("organ.surprise-route", "where does this surprise move?", fcfs-surprise-options(choiceSample), fcfs-surprise-ledger(routingSample));
        def fcfs-surprise-point-of(samples) = fcfs-surprise-point(fcfs-find-sample(samples, FCFSRouteSample()), fcfs-find-sample(samples, FCFSChoiceSample()));

        // ---- 5. the protocol floor -------------------------------------------
        def fcfs-protocol-options() = list(
            fcf-option("proven", "carry a source the four-way floor has proven", 2, 20, 100, 100),
            fcf-option("unproven", "carry a source no band has stood behind yet", 2, 20, 40, 30));
        def fcfs-protocol-ledger(sample) {
            let purpose = if eq(len(sample), 0) then "" else fgtm-sample-purpose(sample);
            let total = fcfs-number-after(purpose, "-of-", 0);
            let proven = fcfs-least(fcfs-number-between(purpose, "proven-", "-of-", 0), total);
            fcf-ledger(total, proven, sub(total, proven), 0, 0, 0);
        }
        def fcfs-protocol-point(sample) = fcf-point("organ.protocol-floor", "which protocol sources does this channel stand on?", fcfs-protocol-options(), fcfs-protocol-ledger(sample));
        def fcfs-protocol-point-of(samples) = fcfs-protocol-point(fcfs-find-sample(samples, FCFSProtocolSample()));

        // ---- 6. which frame the glass takes ----------------------------------
        // Every tick the glass may take any publisher standing in this space.
        // A frame that reads current is a taking; absent is the held offer, it
        // may stand next tick; malformed or refused is a decline.
        def fcfs-frame-status(root, publisher) = fgtm-read-state-status(fgtm-read-current(root, publisher));
        def fcfs-frame-taken?(status) = if str_eq(status, "current") then 1 else 0;
        def fcfs-frame-held?(status) = if str_eq(status, "absent") then 1 else 0;
        def fcfs-frame-declined?(status) = if str_eq(status, "current") then 0 else if str_eq(status, "absent") then 0 else 1;
        def fcfs-frame-fold(statuses, taken, held, declined) = if eq(len(statuses), 0) then list(taken, held, declined) else fcfs-frame-fold(tail(statuses), add(taken, fcfs-frame-taken?(head(statuses))), add(held, fcfs-frame-held?(head(statuses))), add(declined, fcfs-frame-declined?(head(statuses))));
        def fcfs-frame-statuses(root, publishers) = if eq(len(publishers), 0) then list() else cons(fcfs-frame-status(root, head(publishers)), fcfs-frame-statuses(root, tail(publishers)));
        def fcfs-frame-option(publisher, status) = fcf-option(publisher, str_concat("take the ", str_concat(publisher, " frame")), 1, 12, 100, if eq(fcfs-frame-taken?(status), 1) then 100 else 0);
        def fcfs-frame-options(publishers, statuses) = if eq(len(publishers), 0) then list() else cons(fcfs-frame-option(head(publishers), head(statuses)), fcfs-frame-options(tail(publishers), tail(statuses)));
        def fcfs-frame-ledger(statuses) {
            let f = fcfs-frame-fold(statuses, 0, 0, 0);
            fcf-ledger(len(statuses), nth(f, 0), nth(f, 1), nth(f, 2), 0, 0);
        }
        def fcfs-frame-point(publishers, statuses) = fcf-point("glass.frame", "which publisher's frame does the glass take this tick?", fcfs-frame-options(publishers, statuses), fcfs-frame-ledger(statuses));
        def fcfs-frame-point-live(root) = fcfs-frame-point-with(root, fgtm-roster-in-space(gift_roster_names(), root));
        def fcfs-frame-point-with(root, publishers) = fcfs-frame-point(publishers, fcfs-frame-statuses(root, publishers));

        // ---- 7. the governor's admission -------------------------------------
        // The admission row's three lifecycles are already the body's three
        // outcomes, so this point's ledger grows through fcf-ledger-note and
        // nothing here has to count anything twice.
        def fcfs-admission-outcome(sample) = if eq(len(sample), 0) then cr-outcome-silence() else if str_eq(fgtm-sample-lifecycle(sample), "active") then cr-outcome-success() else if str_eq(fgtm-sample-lifecycle(sample), "failed") then cr-outcome-fail() else cr-outcome-silence();
        def fcfs-admission-options() = list(
            fcf-option("admit", "submit this quantum to the metal now", 4, 30, 100, 90),
            fcf-option("hold", "hold it until the frame has room", 1, 6, 100, 100));
        def fcfs-admission-point(ledger) = fcf-point("governor.metal-admission", "admit this metal quantum, or hold it?", fcfs-admission-options(), ledger);
        def fcfs-admission-note(ledger, sample, waitMs) = fcf-ledger-note(ledger, fcfs-admission-outcome(sample), waitMs);
        def fcfs-admission-point-of(samples, ledger, waitMs) = fcfs-admission-point(fcfs-admission-note(ledger, fcfs-find-sample(samples, FCFSAdmissionSample()), waitMs));

        // ---- 8. which route serves a category --------------------------------
        // bml-route-choice-runtime already builds real candidates; branch-choice
        // -order already carries the alignment-and-trust scale fcf-option takes.
        // So a candidate becomes an option through the body's own two lanes and
        // nothing is translated by hand. What is missing is the ledger: no
        // counter anywhere records that this choice was ever put. It reads DARK,
        // and asking for a counter is the whole value of publishing it.
        def fcfs-branch-of-candidate(c) = bco-candidate(bml-source-choice-candidate-path(c), 0, 0, 0, 0, bml-source-choice-candidate-score(c), bml-source-choice-candidate-pressure(c));
        def fcfs-option-of-branch(b) = fcf-option(bco-path(b), str_concat("route through ", bco-path(b)), add(bco-short-fail(b), bco-long-fail(b)), add(bco-short-success(b), bco-long-success(b)), bco-alignment(b), bco-trust(b));
        def fcfs-options-of-branches(bs) = if eq(len(bs), 0) then list() else cons(fcfs-option-of-branch(head(bs)), fcfs-options-of-branches(tail(bs)));
        def fcfs-branches-of-candidates(cs) = if eq(len(cs), 0) then list() else cons(fcfs-branch-of-candidate(head(cs)), fcfs-branches-of-candidates(tail(cs)));
        def fcfs-branch-ledger(bs, acc) = if eq(len(bs), 0) then acc else fcfs-branch-ledger(tail(bs), fcf-ledger(add(fcf-ledger-offered(acc), fcfs-branch-offers(head(bs))), add(fcf-ledger-taken(acc), add(bco-short-success(head(bs)), bco-long-success(head(bs)))), 0, add(fcf-ledger-declined(acc), add(bco-short-fail(head(bs)), bco-long-fail(head(bs)))), 0, 0));
        def fcfs-branch-offers(b) = add(add(bco-short-success(b), bco-short-fail(b)), add(bco-long-success(b), bco-long-fail(b)));
        def fcfs-branch-point(id, question, bs) = fcf-point(id, question, fcfs-options-of-branches(bs), fcfs-branch-ledger(bs, fcf-ledger-empty()));
        def fcfs-route-category-point(candidates) = fcfs-branch-point("route.category", "which route serves this category?", fcfs-branches-of-candidates(candidates));
        def fcfs-route-category-candidates() = brcr-protocol-choice-candidates("form/form-stdlib/bml-source.fk", "form/form-stdlib/kernel-http.fk", 60, 80, 40, 50);
        def fcfs-route-category-point-live() = fcfs-route-category-point(fcfs-route-category-candidates());

        // ---- every point this body has, in one sequence ----------------------
        // The order is the order a decision actually travels: the kernel decides
        // how to run a recipe, then what to keep, then the organs decide where a
        // surprise goes, then the glass decides what to take, then the governor
        // decides whether the metal moves, and last the route lane that has
        // never been asked at all.
        def fcfs-points(pid, root, organSamples, governorSamples, admissionLedger, waitMs) = list(
            fcfs-crystallize-point-live(pid),
            fcfs-box-point-live(pid),
            fcfs-mint-point-live(pid),
            fcfs-surprise-point-of(organSamples),
            fcfs-protocol-point-of(organSamples),
            fcfs-frame-point-live(root),
            fcfs-admission-point-of(governorSamples, admissionLedger, waitMs),
            fcfs-route-category-point-live());
        def fcfs-point-ids(points) = if eq(len(points), 0) then list() else cons(fcf-point-id(head(points)), fcfs-point-ids(tail(points)));
        def fcfs-find-point(points, id) = if eq(len(points), 0) then list() else if str_eq(fcf-point-id(head(points)), id) then head(points) else fcfs-find-point(tail(points), id);
    }
    0;
}
