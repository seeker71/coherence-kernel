//////////////////////////////////////////////////////////////////////
//
// form-cli-universe-mint.bml
//
// Executable BML. Authority: form-stdlib/bml/form-cli-universe-mint.bml
//
// Mints Form-native (split, class, situation) rows that teach the
// local layer the universe skills: BML, BMF, lift s-expr to BML,
// look up Form nodes, craft Blueprint/Recipe/Cell, inspect the
// framebuffer live, generate micro-kernel thoughts, evaluate.
// Combinatorial mix is the diversity — unlimited N, no remote
// oracle, no sealed prompt, no chat transcript.
// Overlay fit reuses the teach-layer centroid. LoRA writer stays 0.
//
// Proven by: form-stdlib/tests/form-cli-universe-mint-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    template SampleRow<TClass> {
        member split: String;
        member className: TClass;
        member situation: String;
        member sourceId: Object;
        member lessonId: Object;
        member transformId: Object;
    }

    class FormUniverseMintAuthority {
        field MintAuthorityPath = "form/form-stdlib/bml/form-cli-universe-mint.bml";
        field MintAuthorityKind = "high-bml-class-template-field";
    }

    class FormUniverseMint<T> {
        field MixA = 7;
        field MixB = 13;
        field NSkills = 8;
        field LoraWriter = 0;
        field SplitTrain = "train";
        field SplitHeldout = "heldout";

        ref fum-authority = FormUniverseMintAuthority;
        thought fum-pattern = list("mint", "lesson-lineage", "source-overlap-visible", "overlay-fit", "lora-waits");
        thought fum-skills = list("bml", "bmf", "lift-sexp", "node-lookup", "craft-cell", "framebuffer", "micro-thought", "evaluate");
        thought fum-contexts = list("scannerless cursor", "form.lift dialect", "generate door", "one-turn budget", "Metal organ", "local overlay", "recipe-exec session", "bidirectional diagnostic");
        thought fum-sources = list("form/form-stdlib/bml-bmf-stream-curriculum.bml", "form/form-stdlib/grammars/form-lift.fk", "form/form-stdlib/form-cli-qwen-teach-layer.fk", "observe/bidirectional-framebuffer-channel.fk", "observe/inquiry-planes.fk", "docs/live-dynamic-diagnostics.md");

        def fum-mix(i, n) = mod(add(mul(i, MixA()), MixB()), n);

        def fum-bml-stems() = list("BML is an executable source and authority whose lessons lower into Form", "section form.bml compiles through the cursor into recipes the walker runs", "high-grammar authority lives beside the executable companion", "class template field thought and allow are BML organs");
        def fum-bmf-stems() = list("a custom BMF grammar is walker-carried data that lowers named fields", "streaming transmutation consumes bytes directly with no tokenizer pre-step", "the live cursor folds raw bytes and preserves state across every chunk boundary", "scannerless-byte-fold is the cursor route never a token list");
        def fum-lift-stems() = list("form.lift sits above form.bml adding infix unless when ice liquid compost", "thought name args lowers to a recursive fndef micro-thought", "an s-expression defn lifts to a form.lift def with infix plus", "nothing is control empty is the list they are not the same");
        def fum-lookup-stems() = list("emit one complete knowledge-query envelope with compact anchor first and repo-relative path second", "wait for the typed observation then answer only what was requested", "a source-bound caller already carries the path the model owns only the discriminative anchor", "typed hit or miss opens the answer reserve typed nothing opens none");
        def fum-craft-stems() = list("NodeID names a cell in the graph after a recipe is interned", "Blueprint is the declared shape a recipe fills", "a recipe is Form the walker runs and a cell is a living organ", "a raw-byte recipe-birth frame interns an invented recipe as a NodeID");
        def fum-fb-stems() = list("execute then observe then outbound frame then adjudicate then inbound control then re-observe", "every framebuffer message carries direction exchange-id kind payload and alternative-node", "never store private prompt or answer content in the framebuffer", "a logged event without an applied response is observation not bidirectionality");
        def fum-thought-stems() = list("thought kernels route by inquiry plane and missing evidence remains nothing", "when where which are computable what who how why are learned", "a thought name args is a recursive micro-thought the walker can run", "invent a bounded affine recipe and request physical execution by NodeID");
        def fum-eval-stems() = list("evaluate is the walker running a recipe to a typed observation", "release is a distinct signal after execution never the same as generate", "a generation plan is not live native execution without separate carrier evidence", "request artifact execution observation refinement crystallization dissolution and release stay distinct");

        def fum-stems(class) = if str_eq(class, "bml") then fum-bml-stems() else if str_eq(class, "bmf") then fum-bmf-stems() else if str_eq(class, "lift-sexp") then fum-lift-stems() else if str_eq(class, "node-lookup") then fum-lookup-stems() else if str_eq(class, "craft-cell") then fum-craft-stems() else if str_eq(class, "framebuffer") then fum-fb-stems() else if str_eq(class, "micro-thought") then fum-thought-stems() else fum-eval-stems();

        def fum-prefix(split) = if str_eq(split, SplitTrain()) then "Observed " else "Boundary: observed ";

        def fum-source-id() = fmls-source-id(str_concat(MintAuthorityPath(), "#lesson-lineage-v1"));

        def fum-lesson-id(class, i) {
            let stems = fum-stems(class);
            let stem = nth(stems, fum-mix(i, len(stems)));
            fmls-lesson-id(str_concat(MintAuthorityPath(), "#lesson-lineage-v1"), class, stem);
        }

        def fum-transform-id(class, i, split) {
            let ctxs = fum-contexts();
            let ctx = nth(ctxs, fum-mix(i, len(ctxs)));
            fmls-transform-id(split, ctx, fum-prefix(split), i);
        }

        def fum-situation(class, i, split) {
            let ctxs = fum-contexts();
            let stems = fum-stems(class);
            let ctx = nth(ctxs, fum-mix(i, len(ctxs)));
            let stem = nth(stems, fum-mix(i, len(stems)));
            str_concat(fum-prefix(split), str_concat(ctx, str_concat(" ", str_concat(stem, str_concat(" case ", int_to_str(i))))));
        }

        def fum-row(class, i, split) = fmls-row(split, class, fum-situation(class, i, split), fum-source-id(), fum-lesson-id(class, i), fum-transform-id(class, i, split));

        def fum-class-rows(class, i, n, split, acc) = if eq(i, n) then acc else fum-class-rows(class, add(i, 1), n, split, cons(fum-row(class, i, split), acc));

        def fum-all-classes(names, tn, hn, acc) = if eq(len(names), 0) then acc else fum-all-classes(tail(names), tn, hn, fum-class-rows(head(names), tn, add(tn, hn), SplitHeldout(), fum-class-rows(head(names), 0, tn, SplitTrain(), acc)));

        def fum-corpus(tn, hn) = fum-all-classes(fum-skills(), tn, hn, tail(list("x")));

        def fum-n(tn, hn) = mul(NSkills(), add(tn, hn));

        def fum-has-situation(rows, s) = if eq(len(rows), 0) then 0 else if str_eq(nth(head(rows), 2), s) then 1 else fum-has-situation(tail(rows), s);

        def fum-train-only(rows, acc) = if eq(len(rows), 0) then acc else if str_eq(nth(head(rows), 0), SplitTrain()) then fum-train-only(tail(rows), cons(head(rows), acc)) else fum-train-only(tail(rows), acc);

        def fum-leakage-loop(all, rows) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), SplitHeldout()) then fum-has-situation(fum-train-only(all, tail(list("x"))), nth(head(rows), 2)) else 0, fum-leakage-loop(all, tail(rows)));

        def fum-leakage(rows) = fum-leakage-loop(rows, rows);

        def fum-lesson-leakage(rows) = len(fmls-lesson-intersection(rows, SplitTrain(), SplitHeldout()));

        def fum-lineage-signal(rows) = fmls-lesson-signal(rows, SplitTrain(), SplitHeldout());

        def fum-unique-loop(rows, seen) = if eq(len(rows), 0) then len(seen) else if eq(fum-has-situation(seen, nth(head(rows), 2)), 1) then fum-unique-loop(tail(rows), seen) else fum-unique-loop(tail(rows), cons(head(rows), seen));

        def fum-unique(rows) = fum-unique-loop(rows, tail(list("x")));

        def fum-count-split(rows, split) = if eq(len(rows), 0) then 0 else add(if str_eq(nth(head(rows), 0), split) then 1 else 0, fum-count-split(tail(rows), split));

        def fum-lora-writer() = LoraWriter();

        def fum-mix-diverse() = if eq(fum-mix(0, 8), fum-mix(1, 8)) then 0 else 1;

        def fum-predict(models, names, s) = nth(names, fqt-predict-index(models, s));

        def fum-heldout-hit(models, names, row) = if str_eq(nth(row, 0), SplitHeldout()) then if str_eq(fum-predict(models, names, nth(row, 2)), nth(row, 1)) then 1 else 0 else 0;

        def fum-heldout-correct-loop(models, names, rows) = if eq(len(rows), 0) then 0 else add(fum-heldout-hit(models, names, head(rows)), fum-heldout-correct-loop(models, names, tail(rows)));

        def fum-heldout-correct(rows) {
            let names = fum-skills();
            let models = fqt-fit(rows, names);
            fum-heldout-correct-loop(models, names, rows);
        }

        def fum-bit(ok, bit) = if ok then bit else 0;

        def fum-check() {
            let rows = fum-corpus(3, 1);
            let n = fum-n(3, 1);
            let correct = fum-heldout-correct(rows);
            let c0 = fum-bit(eq(n, 32), 1);
            let c1 = fum-bit(eq(fum-mix-diverse(), 1), 2);
            let c2 = fum-bit(and(eq(fum-leakage(rows), 0), eq(fum-lesson-leakage(rows), 0)), 4);
            let c3 = fum-bit(eq(fum-unique(rows), n), 8);
            let c4 = fum-bit(and(eq(fum-count-split(rows, SplitTrain()), 24), eq(fum-count-split(rows, SplitHeldout()), 8)), 16);
            let c5 = fum-bit(ge(correct, 6), 32);
            let c6 = fum-bit(eq(fum-lora-writer(), 0), 64);
            let c7 = fum-bit(eq(fum-n(5, 2), 56), 128);
            add(c0, add(c1, add(c2, add(c3, add(c4, add(c5, add(c6, c7)))))));
        }
    }
    0;
}
