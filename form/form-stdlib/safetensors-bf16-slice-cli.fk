; safetensors-bf16-slice-cli.fk — native-only live tensor window witness.
;
; stdin: path, absolute byte offset, bf16 element count.
; preludes: form-stdlib/core.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/safetensors-bf16-slice.fk

(do
    (let path (read_line))
    (let start (str_to_int (read_line)))
    (let count (str_to_int (read_line)))
    (let raw (read_file_slice path start (mul count 2)))
    (let values (sbfs-decode raw count))
    (let ok (if (eq (len values) count) 1 0))
    (print_str (str_concat "slice_ok="
        (str_concat (int_to_str ok)
        (str_concat "\ncount="
        (str_concat (int_to_str (len values))
        (str_concat "\nfirst_micro="
        (str_concat (if (eq ok 1)
                        (int_to_str (round (mul (nth values 0) 1000000.0)))
                        "0")
                    "\n")))))))
)