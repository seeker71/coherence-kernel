; living-world-enquiry-answer.fk -- derive, expose alternatives, or stay silent.
;
; An admitted current question may form one local answer proposal.  If every
; route yields one content-identical output, the answer returns that cell with
; an inspectable derivation.  If current routes disagree, the answer retains
; every route and uncertainty cell and acknowledges NOTHING.  No hidden rank,
; vote, imported label, or remote oracle chooses among alternatives.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-resonance.fk form-stdlib/living-world-resonance-evidence.fk form-stdlib/living-world-recursive-resonance.fk form-stdlib/living-world-recursive-resonance-eval.fk form-stdlib/living-world-experience.fk form-stdlib/living-world-recursive-evidence.fk form-stdlib/living-world-recursive-proposal.fk form-stdlib/living-world-lifecycle.fk form-stdlib/living-world-concept-field.fk form-stdlib/living-world-concept-application.fk form-stdlib/living-world-enquiry-route.fk form-stdlib/living-world-enquiry.fk

(let LWEN-ANSWER        (bp "LWEN-ANSWER"))
(let LWEN-ANSWER-ORIGIN (bp "LWEN-ANSWER-ORIGIN"))

(defn lwen-all-outputs-eq? (items wanted)
    (if (eq (len items) 0) 1
        (if (node_eq (lwen-route-output (head items)) wanted)
            (lwen-all-outputs-eq? (tail items) wanted) 0)))

(defn lwen-route-uncertainties (items acc)
    (if (eq (len items) 0) acc
        (lwen-route-uncertainties (tail items)
            (lwo-field-add acc
                (lwen-route-uncertainty (head items))))))

(defn lwen-answer-ack-for-routes (routes)
    (do
        (let items (lwo-field-items routes))
        (let first (head items))
        (if (eq (lwen-all-outputs-eq?
                    (tail items) (lwen-route-output first)) 1)
            (if (eq (len items) 1)
                (oac-node (lwen-route-derivation first))
                (oac-node routes))
            (oac-nothing))))

(defn lwen-answer-output-for-routes (routes)
    (do
        (let items (lwo-field-items routes))
        (let first (head items))
        (if (eq (lwen-all-outputs-eq?
                    (tail items) (lwen-route-output first)) 1)
            (lwen-route-output first) (lwo-none))))

; children: question candidate, output, acknowledgment, complete alternatives,
;           uncertainty field, active question attributions, local path
(defn lwen-answer (question-candidate routes question-attributions)
    (intern_node LWEN-ANSWER
        (list question-candidate
              (lwen-answer-output-for-routes routes)
              (lwen-answer-ack-for-routes routes)
              routes
              (lwen-route-uncertainties
                  (lwo-field-items routes) (lwo-empty-field))
              question-attributions (lwo-local-path))))
(defn lwen-answer? (cell) (lwo-category? cell LWEN-ANSWER))
(defn lwen-answer-question-candidate (answer) (nth (node_children answer) 0))
(defn lwen-answer-output (answer) (nth (node_children answer) 1))
(defn lwen-answer-ack (answer) (nth (node_children answer) 2))
(defn lwen-answer-alternatives (answer) (nth (node_children answer) 3))
(defn lwen-answer-uncertainties (answer) (nth (node_children answer) 4))
(defn lwen-answer-question-attributions (answer) (nth (node_children answer) 5))
(defn lwen-answer-path (answer) (nth (node_children answer) 6))

(defn lwen-answer-origin (answer)
    (intern_node LWEN-ANSWER-ORIGIN (list answer)))

(defn lwen-answer-shape (world question-candidate)
    (if (or (eq (lwen-question-candidate? question-candidate) 0)
            (or (eq (lwo-active? world question-candidate) 0)
                (eq (lwen-question-current?
                        world question-candidate) 0)))
        (lwo-none)
        (do
            (let question (lwo-emergent-shape question-candidate))
            (lwen-answer question-candidate
                (lwen-question-routes question)
                (lwo-active-attributions-for
                    world question-candidate)))))

(defn lwen-answer-proposal (world question-candidate)
    (do
        (let answer (lwen-answer-shape world question-candidate))
        (if (node_eq answer (lwo-none)) (lwo-none)
            (do
                (let witnesses
                    (lwen-answer-question-attributions answer))
                (let origin (lwen-answer-origin answer))
                (let candidate
                    (lwo-emergent answer witnesses
                        (intern_trivial_int
                            (lwo-field-size
                                (lwen-answer-alternatives answer)))
                        (intern_trivial_int 1)
                        (intern_trivial_int (lwo-field-size witnesses))
                        origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))

(defn lwen-answer-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwen-answer?
                    (lwo-emergent-shape candidate)) 1)) 1 0))

(defn lwen-answer-current? (world candidate)
    (if (eq (lwen-answer-candidate? candidate) 0) 0
        (do
            (let answer (lwo-emergent-shape candidate))
            (node_eq answer
                (lwen-answer-shape world
                    (lwen-answer-question-candidate answer))))))

(defn lwen-active-answer-for-items? (world items question-candidate)
    (if (eq (len items) 0) 0
        (do
            (let cell (head items))
            (if (and (eq (lwen-answer-candidate? cell) 1)
                     (and (eq (lwo-active? world cell) 1)
                          (and (eq (lwen-answer-current? world cell) 1)
                               (node_eq
                                  (lwen-answer-question-candidate
                                    (lwo-emergent-shape cell))
                                  question-candidate))))
                1
                (lwen-active-answer-for-items?
                    world (tail items) question-candidate)))))

(defn lwen-active-answer-for? (world question-candidate)
    (lwen-active-answer-for-items? world
        (lwo-field-items (lwo-world-cells world)) question-candidate))

(defn lwen-answer-proposals-items (world items acc)
    (if (eq (len items) 0) acc
        (do
            (let question-candidate (head items))
            (if (and (eq (lwen-question-candidate?
                              question-candidate) 1)
                     (and (eq (lwo-active?
                                  world question-candidate) 1)
                          (eq (lwen-active-answer-for?
                                  world question-candidate) 0)))
                (do
                    (let proposal
                        (lwen-answer-proposal world question-candidate))
                    (lwen-answer-proposals-items world (tail items)
                        (if (node_eq proposal (lwo-none)) acc
                            (lwo-field-add acc proposal))))
                (lwen-answer-proposals-items
                    world (tail items) acc)))))

(defn lwen-answer-proposals (world)
    (lwen-answer-proposals-items world
        (lwo-field-items (lwo-world-cells world)) (lwo-empty-field)))

(defn lwen-integrate-answer (round proposal action)
    (do
        (let candidate (lwt-proposal-candidate proposal))
        (if (eq (lwen-answer-current?
                    (lwt-round-world round) candidate) 0)
            (lwt-round (lwt-round-world round) (lwt-round-proposals round)
                (lwo-field-add (lwo-empty-field)
                    (lwt-evaluate-proposal
                        (lwt-round-world round) proposal)) round)
            (lwt-integrate round proposal action))))
