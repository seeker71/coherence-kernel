// HTTP/router values and policy expressed in BML.
//
// The focused header row/ASCII lookup lives in kernel-http-header.fk so a
// header-only consumer need not carry this whole request/router graph.
//
// preludes: form-stdlib/core.fk form-stdlib/kernel-http-header.fk form-stdlib/bml/string-join.bml
//
// This surface is value-shaped: requests, responses, routes, pressure rows,
// and route candidates are plain Form data with real validation and
// scoring recipes. Kernel adapters can carry these values without owning the
// routing decision.
//
section [form.bml] {
    let kh_tag_request = 43002;
    let kh_tag_response = 43003;
    let kh_tag_route = 43004;
    let kh_tag_pressure_row = 43005;
    let kh_tag_route_candidate = 43006;
    let kh_tag_route_data_ref = 43007;
    let kh_tag_field = 43008;
    let kh_tag_route_decision = 43009;
    let kh_tag_route_choice = 43010;
    let kh_tag_route_decision_signature = 43011;
    let kh_tag_route_choice_signature = 43012;
    let kh_tag_channel_policy = 43013;
    let kh_tag_method_bridge = 43014;
    def kh-bool-score(ok, score) = ok ? score : 0;
    def kh-tagged?(value, tag, arity) = (Comparable) len(value) == arity ? (Comparable) nth(value, 0) == tag : false;
    def kh-nonempty-string?(value) = str_len(value) > 0;
    def kh-path-valid?(path) = str_len(path) > 0 ? (String) char_at(path, 0) == "/" : false;
    def kh-prefix?(text, prefix) = str_len(prefix) > str_len(text) ? false : (String) substring(text, 0, str_len(prefix)) == prefix;
    def kh-list-string-present?(values, value) = any?(entry => (String) entry == value, values);
    def kh-join-strings(values, separator) = str-join-with(values, separator);
    def kh-method-bridge(route-method, request-method, pressure) = list(kh_tag_method_bridge, route-method, request-method, pressure);
    def kh-method-bridge?(bridge) = kh-tagged?(bridge, kh_tag_method_bridge, 4);
    def kh-method-bridge-route-method(bridge) = nth(bridge, 1);
    def kh-method-bridge-request-method(bridge) = nth(bridge, 2);
    def kh-method-bridge-pressure(bridge) = nth(bridge, 3);
    def kh-method-bridge-valid?(bridge) = kh-method-bridge?(bridge) ? kh-nonempty-string?(kh-method-bridge-route-method(bridge)) && (kh-nonempty-string?(kh-method-bridge-request-method(bridge)) && kh-method-bridge-pressure(bridge) >= 0) : false;
    def kh-method-bridges-valid?(bridges) = all?(kh-method-bridge-valid?, bridges);
    // Channel policy is the Form-visible protocol invitation and pressure map.
    // HTTP is one carrier/protocol value here, not a special host-owned branch.
    def kh-channel-policy(carrier, protocol, allowed-methods, method-bridges, no-body-methods, allow-methods, cache-policy, compression-policy, stream-policy, identity-policy, authorization-policy) = list(kh_tag_channel_policy, carrier, protocol, allowed-methods, method-bridges, no-body-methods, allow-methods, cache-policy, compression-policy, stream-policy, identity-policy, authorization-policy);
    def kh-channel-policy?(policy) = kh-tagged?(policy, kh_tag_channel_policy, 12);
    def kh-channel-policy-carrier(policy) = nth(policy, 1);
    def kh-channel-policy-protocol(policy) = nth(policy, 2);
    def kh-channel-policy-allowed-methods(policy) = nth(policy, 3);
    def kh-channel-policy-method-bridges(policy) = nth(policy, 4);
    def kh-channel-policy-no-body-methods(policy) = nth(policy, 5);
    def kh-channel-policy-allow-methods(policy) = nth(policy, 6);
    def kh-channel-policy-cache-policy(policy) = nth(policy, 7);
    def kh-channel-policy-compression-policy(policy) = nth(policy, 8);
    def kh-channel-policy-stream-policy(policy) = nth(policy, 9);
    def kh-channel-policy-identity-policy(policy) = nth(policy, 10);
    def kh-channel-policy-authorization-policy(policy) = nth(policy, 11);
    def kh-channel-policy-valid?(policy) = kh-channel-policy?(policy) ? kh-nonempty-string?(kh-channel-policy-carrier(policy)) && (kh-nonempty-string?(kh-channel-policy-protocol(policy)) && kh-method-bridges-valid?(kh-channel-policy-method-bridges(policy))) : false;
    def kh-default-allowed-methods() = list("GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS");
    def kh-default-channel-policy() = kh-channel-policy("tcp", "http/1.1", kh-default-allowed-methods(), list(kh-method-bridge("GET", "HEAD", 20)), list("HEAD"), kh-default-allowed-methods(), "cache-policy-observe", "compression-policy-observe", "stream-policy-buffered", "identity-policy-claim", "authorization-policy-capability");
    def kh-method-known-with-policy?(policy, method) = kh-list-string-present?(kh-channel-policy-allowed-methods(policy), method);
    def kh-method-known?(method) = kh-method-known-with-policy?(kh-default-channel-policy(), method);
    def kh-route-method-valid-with-policy?(policy, method) = kh-method-known-with-policy?(policy, method) || (String) method == "ANY";
    def kh-route-method-valid?(method) = kh-route-method-valid-with-policy?(kh-default-channel-policy(), method);
    def kh-policy-method-bridge-pressure-or(policy, route-method, request-method, fallback) = kh-method-bridge-pressure-or(kh-channel-policy-method-bridges(policy), route-method, request-method, fallback);
    def kh-method-bridge-pressure-or(bridges, route-method, request-method, fallback) = nil?(bridges) ? fallback : kh-method-bridge?(head(bridges)) && ((String) kh-method-bridge-route-method(head(bridges)) == route-method && (String) kh-method-bridge-request-method(head(bridges)) == request-method) ? kh-method-bridge-pressure(head(bridges)) : kh-method-bridge-pressure-or(tail(bridges), route-method, request-method, fallback);
    def kh-policy-no-body-method?(policy, method) = kh-list-string-present?(kh-channel-policy-no-body-methods(policy), method);
    def kh-policy-allow-header-value(policy) = kh-join-strings(kh-channel-policy-allow-methods(policy), ", ");
    def kh-field(name, value) = list(kh_tag_field, name, value);
    def kh-field?(field) = kh-tagged?(field, kh_tag_field, 3);
    def kh-field-name(field) = nth(field, 1);
    def kh-field-value(field) = nth(field, 2);
    def kh-fields-valid?(fields) = nil?(fields) ? true : kh-field?(head(fields)) ? kh-fields-valid?(tail(fields)) : false;
    def kh-field-present?(fields, name) = nil?(fields) ? false : (String) kh-field-name(head(fields)) == name ? true : kh-field-present?(tail(fields), name);
    def kh-field-value-or(fields, name, default-value) = nil?(fields) ? default-value : (String) kh-field-name(head(fields)) == name ? kh-field-value(head(fields)) : kh-field-value-or(tail(fields), name, default-value);
    def kh-field-int-or(fields, name, default-value) = {
        let raw = kh-field-value-or(fields, name, "");
        (String) raw == "" ? default-value : str_to_int(raw);
    };
    def kh-field-bool-or(fields, name, default-value) = {
        let raw = kh-field-value-or(fields, name, "");
        (String) raw == "" ? default-value : (String) raw == "true" || (String) raw == "1";
    };
    def kh-request(method, path, headers, query, body) = list(kh_tag_request, method, path, headers, query, body);
    def kh-request?(request) = kh-tagged?(request, kh_tag_request, 6);
    def kh-request-method(request) = nth(request, 1);
    def kh-request-path(request) = nth(request, 2);
    def kh-request-headers(request) = nth(request, 3);
    def kh-request-query(request) = nth(request, 4);
    def kh-request-body(request) = nth(request, 5);
    def kh-request-valid-with-policy?(policy, request) = kh-request?(request) ? kh-method-known-with-policy?(policy, kh-request-method(request)) && (kh-path-valid?(kh-request-path(request)) && (kh-headers-valid?(kh-request-headers(request)) && kh-fields-valid?(kh-request-query(request)))) : false;
    def kh-request-valid?(request) = kh-request-valid-with-policy?(kh-default-channel-policy(), request);
    def kh-query-value-or(request, name, default-value) = kh-field-value-or(kh-request-query(request), name, default-value);
    def kh-query-int-or(request, name, default-value) = kh-field-int-or(kh-request-query(request), name, default-value);
    def kh-query-bool-or(request, name, default-value) = kh-field-bool-or(kh-request-query(request), name, default-value);
    def kh-response(status, headers, body) = list(kh_tag_response, status, headers, body);
    def kh-response?(response) = kh-tagged?(response, kh_tag_response, 4);
    def kh-response-status(response) = nth(response, 1);
    def kh-response-headers(response) = nth(response, 2);
    def kh-response-body(response) = nth(response, 3);
    def kh-response-valid?(response) = kh-response?(response) ? kh-response-status(response) >= 100 && (kh-response-status(response) <= 599 && kh-headers-valid?(kh-response-headers(response))) : false;
    def kh-route(name, method, pattern, priority, handler, required-header, pressure-budget) = list(kh_tag_route, name, method, pattern, priority, handler, required-header, pressure-budget);
    def kh-route?(route) = kh-tagged?(route, kh_tag_route, 8);
    def kh-route-name(route) = nth(route, 1);
    def kh-route-method(route) = nth(route, 2);
    def kh-route-pattern(route) = nth(route, 3);
    def kh-route-priority(route) = nth(route, 4);
    def kh-route-handler(route) = nth(route, 5);
    def kh-route-required-header(route) = nth(route, 6);
    def kh-route-pressure-budget(route) = nth(route, 7);
    def kh-route-valid-with-policy?(policy, route) = kh-route?(route) ? kh-route-method-valid-with-policy?(policy, kh-route-method(route)) && (kh-path-valid?(kh-route-pattern(route)) && (kh-route-priority(route) >= 0 && (kh-nonempty-string?(kh-route-handler(route)) && kh-route-pressure-budget(route) >= 0))) : false;
    def kh-route-valid?(route) = kh-route-valid-with-policy?(kh-default-channel-policy(), route);
    def kh-route-data-ref(route-id, handler) = list(kh_tag_route_data_ref, route-id, handler);
    def kh-route-data-ref?(ref) = kh-tagged?(ref, kh_tag_route_data_ref, 3);
    def kh-route-data-ref-id(ref) = nth(ref, 1);
    def kh-route-data-ref-handler(ref) = nth(ref, 2);
    def kh-route-data-ref-valid?(ref) = kh-route-data-ref?(ref) ? kh-nonempty-string?(kh-route-data-ref-id(ref)) : false;
    def kh-pattern-wildcard?(pattern) = str_len(pattern) > 0 ? (String) char_at(pattern, str_len(pattern) - 1) == "*" : false;
    def kh-pattern-prefix(pattern) = kh-pattern-wildcard?(pattern) ? substring(pattern, 0, str_len(pattern) - 1) : pattern;
    def kh-head-through-get?(route, request) = (String) kh-route-method(route) == "GET" && (String) kh-request-method(request) == "HEAD";
    def kh-head-through-get-with-policy?(policy, route, request) = kh-policy-method-bridge-pressure-or(policy, kh-route-method(route), kh-request-method(request), 400) < 400;
    def kh-method-pressure-with-policy(policy, route, request) = {
        let bridge-pressure = kh-policy-method-bridge-pressure-or(policy, kh-route-method(route), kh-request-method(request), 400);
        (String) kh-route-method(route) == kh-request-method(request) ? 0 : bridge-pressure < 400 ? bridge-pressure : (String) kh-route-method(route) == "ANY" ? 40 : 400;
    };
    def kh-method-pressure(route, request) = kh-method-pressure-with-policy(kh-default-channel-policy(), route, request);
    def kh-path-pressure(route, request) = (String) kh-route-pattern(route) == kh-request-path(request) ? 0 : kh-pattern-wildcard?(kh-route-pattern(route)) && kh-prefix?(kh-request-path(request), kh-pattern-prefix(kh-route-pattern(route))) ? 25 : 500;
    def kh-header-pressure(route, request) = (String) kh-route-required-header(route) == "" ? 0 : kh-header-present?(kh-request-headers(request), kh-route-required-header(route)) ? 0 : 120;
    def kh-budget-pressure(total, budget) = total <= budget ? 0 : total - budget;
    def kh-pressure-row(axis, observed, expected, pressure) = list(kh_tag_pressure_row, axis, observed, expected, pressure);
    def kh-pressure-row?(row) = kh-tagged?(row, kh_tag_pressure_row, 5);
    def kh-pressure-row-axis(row) = nth(row, 1);
    def kh-pressure-row-observed(row) = nth(row, 2);
    def kh-pressure-row-expected(row) = nth(row, 3);
    def kh-pressure-row-pressure(row) = nth(row, 4);
    def kh-pressure-matrix-total(matrix) = nil?(matrix) ? 0 : kh-pressure-row-pressure(head(matrix)) + kh-pressure-matrix-total(tail(matrix));
    def kh-candidate-pressure-matrix-with-policy(policy, route, request) = {
        let method-pressure = kh-method-pressure-with-policy(policy, route, request);
        let path-pressure = kh-path-pressure(route, request);
        let header-pressure = kh-header-pressure(route, request);
        let base-pressure = sum(list(method-pressure, path-pressure, header-pressure));
        let budget-pressure = kh-budget-pressure(base-pressure, kh-route-pressure-budget(route));
        list(kh-pressure-row("method", kh-request-method(request), kh-route-method(route), method-pressure), kh-pressure-row("path", kh-request-path(request), kh-route-pattern(route), path-pressure), kh-pressure-row("header", kh-header-observation(kh-request-headers(request), kh-route-required-header(route)), kh-route-required-header(route), header-pressure), kh-pressure-row("budget", base-pressure, kh-route-pressure-budget(route), budget-pressure));
    };
    def kh-candidate-pressure-matrix(route, request) = kh-candidate-pressure-matrix-with-policy(kh-default-channel-policy(), route, request);
    def kh-candidate-score-from(route, pressure) = 1000 + kh-route-priority(route) * 10 - pressure;
    def kh-route-candidate-with-policy(policy, route, request) = {
        let matrix = kh-candidate-pressure-matrix-with-policy(policy, route, request);
        let pressure = kh-pressure-matrix-total(matrix);
        list(kh_tag_route_candidate, route, request, matrix, pressure, kh-candidate-score-from(route, pressure));
    };
    def kh-route-candidate(route, request) = kh-route-candidate-with-policy(kh-default-channel-policy(), route, request);
    def kh-route-candidate?(candidate) = kh-tagged?(candidate, kh_tag_route_candidate, 6);
    def kh-route-candidate-route(candidate) = nth(candidate, 1);
    def kh-route-candidate-request(candidate) = nth(candidate, 2);
    def kh-route-candidate-matrix(candidate) = nth(candidate, 3);
    def kh-route-candidate-pressure(candidate) = nth(candidate, 4);
    def kh-route-candidate-score(candidate) = nth(candidate, 5);
    def kh-route-candidate-valid?(candidate) = kh-route-candidate?(candidate) ? kh-route-valid?(kh-route-candidate-route(candidate)) && (kh-request-valid?(kh-route-candidate-request(candidate)) && ((Comparable) kh-route-candidate-pressure(candidate) == kh-pressure-matrix-total(kh-route-candidate-matrix(candidate)) && (Comparable) kh-route-candidate-score(candidate) == kh-candidate-score-from(kh-route-candidate-route(candidate), kh-route-candidate-pressure(candidate)))) : false;
    def kh-route-candidate-eligible?(candidate) = kh-route-candidate?(candidate) ? kh-route-candidate-pressure(candidate) <= kh-route-pressure-budget(kh-route-candidate-route(candidate)) : false;
    def kh-route-candidates-with-policy(policy, routes, request) = nil?(routes) ? empty() : cons(kh-route-candidate-with-policy(policy, head(routes), request), kh-route-candidates-with-policy(policy, tail(routes), request));
    def kh-route-candidates(routes, request) = kh-route-candidates-with-policy(kh-default-channel-policy(), routes, request);
    def kh-keep-eligible-candidate(candidate, rest) = kh-route-candidate-eligible?(candidate) ? cons(candidate, rest) : rest;
    def kh-eligible-candidates(candidates) = nil?(candidates) ? empty() : kh-keep-eligible-candidate(head(candidates), kh-eligible-candidates(tail(candidates)));
    def kh-route-eligible-candidates-with-policy(policy, routes, request) = kh-eligible-candidates(kh-route-candidates-with-policy(policy, routes, request));
    def kh-route-eligible-candidates(routes, request) = kh-route-eligible-candidates-with-policy(kh-default-channel-policy(), routes, request);
    def kh-route-same?(left, right) = kh-route?(left) ? kh-route?(right) ? (String) kh-route-name(left) == kh-route-name(right) && ((String) kh-route-method(left) == kh-route-method(right) && ((String) kh-route-pattern(left) == kh-route-pattern(right) && ((Comparable) kh-route-priority(left) == kh-route-priority(right) && ((String) kh-route-handler(left) == kh-route-handler(right) && ((String) kh-route-required-header(left) == kh-route-required-header(right) && (Comparable) kh-route-pressure-budget(left) == kh-route-pressure-budget(right)))))) : false : false;
    def kh-route-candidate-same?(left, right) = kh-route-candidate?(left) ? kh-route-candidate?(right) ? kh-route-same?(kh-route-candidate-route(left), kh-route-candidate-route(right)) && ((Comparable) kh-route-candidate-pressure(left) == kh-route-candidate-pressure(right) && (Comparable) kh-route-candidate-score(left) == kh-route-candidate-score(right)) : false : false;
    def kh-better-candidate(left, right) = kh-route-candidate-score(left) > kh-route-candidate-score(right) ? left : (Comparable) kh-route-candidate-score(left) == kh-route-candidate-score(right) ? kh-route-priority(kh-route-candidate-route(left)) >= kh-route-priority(kh-route-candidate-route(right)) ? left : right : right;
    def kh-select-route-candidate-loop(candidates, best) = nil?(candidates) ? best : kh-select-route-candidate-loop(tail(candidates), kh-better-candidate(best, head(candidates)));
    def kh-select-route-candidate(candidates) = nil?(candidates) ? empty() : kh-select-route-candidate-loop(tail(candidates), head(candidates));
    def kh-route-decision(candidate, eligible, selected) = list(kh_tag_route_decision, candidate, eligible, selected);
    def kh-route-decision?(decision) = kh-tagged?(decision, kh_tag_route_decision, 4);
    def kh-route-decision-candidate(decision) = nth(decision, 1);
    def kh-route-decision-eligible?(decision) = nth(decision, 2);
    def kh-route-decision-selected?(decision) = nth(decision, 3);
    def kh-route-decision-valid?(decision) = kh-route-decision?(decision) ? kh-route-candidate-valid?(kh-route-decision-candidate(decision)) : false;
    def kh-route-decisions(candidates, selected) = nil?(candidates) ? empty() : cons(kh-route-decision(head(candidates), kh-route-candidate-eligible?(head(candidates)), kh-route-candidate-same?(head(candidates), selected)), kh-route-decisions(tail(candidates), selected));
    def kh-route-decisions-valid?(decisions) = nil?(decisions) ? true : kh-route-decision-valid?(head(decisions)) ? kh-route-decisions-valid?(tail(decisions)) : false;
    // Fixed, data-oblivious buckets for route-choice attention. This borrows the
    // TurboQuant teaching: compression remains content-addressable only when the
    // quantizer is universal, not trained from the current route corpus.
    def kh-pressure-bucket(pressure) = (Comparable) pressure == 0 ? 0 : pressure <= 25 ? 1 : pressure <= 120 ? 2 : pressure <= 400 ? 3 : pressure <= 500 ? 4 : 5;
    def kh-score-bucket(score) = score < 0 ? 0 : score < 500 ? 1 : score < 900 ? 2 : score < 1000 ? 3 : score < 1100 ? 4 : 5;
    def kh-pressure-code(row) = list(kh-pressure-row-axis(row), kh-pressure-bucket(kh-pressure-row-pressure(row)));
    def kh-pressure-codes(matrix) = nil?(matrix) ? empty() : cons(kh-pressure-code(head(matrix)), kh-pressure-codes(tail(matrix)));
    def kh-route-decision-signature(decision) = {
        let candidate = kh-route-decision-candidate(decision);
        let route = kh-route-candidate-route(candidate);
        list(kh_tag_route_decision_signature, kh-route-name(route), kh-route-handler(route), kh-pressure-codes(kh-route-candidate-matrix(candidate)), kh-pressure-bucket(kh-route-candidate-pressure(candidate)), kh-score-bucket(kh-route-candidate-score(candidate)), kh-route-decision-eligible?(decision), kh-route-decision-selected?(decision));
    };
    def kh-route-decision-signature?(signature) = kh-tagged?(signature, kh_tag_route_decision_signature, 8);
    def kh-route-decision-signature-codes(signature) = nth(signature, 3);
    def kh-route-decision-signature-pressure-bucket(signature) = nth(signature, 4);
    def kh-route-decision-signature-score-bucket(signature) = nth(signature, 5);
    def kh-route-decision-signature-eligible?(signature) = nth(signature, 6);
    def kh-route-decision-signature-selected?(signature) = nth(signature, 7);
    def kh-route-decision-signatures(decisions) = nil?(decisions) ? empty() : cons(kh-route-decision-signature(head(decisions)), kh-route-decision-signatures(tail(decisions)));
    def kh-route-choice(request, candidates, decisions, selected) = list(kh_tag_route_choice, request, candidates, decisions, selected);
    def kh-route-choice?(choice) = kh-tagged?(choice, kh_tag_route_choice, 5);
    def kh-route-choice-request(choice) = nth(choice, 1);
    def kh-route-choice-candidates(choice) = nth(choice, 2);
    def kh-route-choice-decisions(choice) = nth(choice, 3);
    def kh-route-choice-selected(choice) = nth(choice, 4);
    def kh-route-choice-valid?(choice) = kh-route-choice?(choice) ? kh-request-valid?(kh-route-choice-request(choice)) && ((Comparable) len(kh-route-choice-candidates(choice)) == len(kh-route-choice-decisions(choice)) && kh-route-decisions-valid?(kh-route-choice-decisions(choice))) : false;
    def kh-route-choice-signature(choice) = list(kh_tag_route_choice_signature, kh-request-method(kh-route-choice-request(choice)), kh-request-path(kh-route-choice-request(choice)), kh-route-decision-signatures(kh-route-choice-decisions(choice)));
    def kh-route-choice-signature?(signature) = kh-tagged?(signature, kh_tag_route_choice_signature, 4);
    def kh-route-choice-signature-decision-signatures(signature) = nth(signature, 3);
    def kh-route-choice-for-request-with-policy(policy, routes, request) = {
        let candidates = kh-route-candidates-with-policy(policy, routes, request);
        let selected = kh-select-route-candidate(kh-eligible-candidates(candidates));
        kh-route-choice(request, candidates, kh-route-decisions(candidates, selected), selected);
    };
    def kh-route-choice-for-request(routes, request) = kh-route-choice-for-request-with-policy(kh-default-channel-policy(), routes, request);
    def kh-select-route-candidate-for-request-with-policy(policy, routes, request) = kh-route-choice-selected(kh-route-choice-for-request-with-policy(policy, routes, request));
    def kh-select-route-candidate-for-request(routes, request) = kh-route-choice-selected(kh-route-choice-for-request(routes, request));
    def kh-select-route-score(routes, request) = {
        let selected = kh-select-route-candidate-for-request(routes, request);
        nil?(selected) ? 0 : kh-route-candidate-score(selected);
    };
    0;
}
