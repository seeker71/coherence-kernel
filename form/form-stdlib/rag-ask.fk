// rag-ask.fk — NodeID-grounded semantic retrieval over the native JSONL index.
//
// preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
// rag-embed owns its scannerless semantic feature fold; this cell calls no
// `tk-*` symbol, so the legacy tokenizer remains independently loadable.
// preludes: form-stdlib/rag-embed.fk
// preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk
//
// The live fkwu path reads the staged question and typed nodeid-rag-v2 export,
// rejects path IDs and incomplete bindings, embeds the query through the same
// form-semantic-v2 sparse feature map as the corpus, ranks by query-feature overlap,
// and returns only `grounded:@p.l.t.i`. Selected-row metadata stays available as
// a structured hit for independent trust/sufficiency and host re-verification:
// cell REF, current content CTOR, source path/key, coverage, runner margin.
//
// Exact substring is gone. A paraphrase can land because source and query share
// authored semantic features; an unrelated query or an untyped/path-id row misses.
section [form.bml] {
    def ra-default-index() = ".coherence-network/rag-index/index.jsonl";
    def ra-staged-query() = ".coherence-network/rag-query.txt";
    def ra-grounded-prefix() = "grounded:";
    def ra-answer-key-of-hex(answer-hex) = (Comparable) hex-valid?(answer-hex) == 0 ? "" : hex-encode(sha256(hex-decode(answer-hex)));
    // ── JSONL -> typed retrieval entries ──
    def ra-lines(s) = (Comparable) str_len(s) == 0 ? empty() : {
        let nl = str_find(s, byte_to_str(10), 0);
        nl < 0 ? cons(s, empty()) : {
            let line = substring(s, 0, nl);
            let next = nl + 1;
            let rest = next >= str_len(s) ? "" : substring(s, next, str_len(s));
            cons(line, ra-lines(rest));
        };
    };
    def ra-entry-of-line(line) = append-1(rag-grounded-binding-entry(ric-node-id(line), ric-content-node-id(line), ric-source-path(line), ric-key(line), ric-answer-key(line), ric-answer-hex(line), ric-vec(line), (Comparable) ric-grounding-ready?(line) == 1 && ((Comparable) hex-valid?(ric-answer-hex(line)) == 1 && (String) ric-answer-key(line) == ra-answer-key-of-hex(ric-answer-hex(line))) ? 1 : 0), ric-persisted-source-sha256(line));
    // Streaming rank admission is structural and hex-safe. Hashing every answer
    // on every query made corpus ranking proportional to all answer bytes rather
    // than the sparse semantic vectors. The selected best/runner pair is checked
    // cryptographically below before any hit can be returned.
    def ra-rank-entry-of-line(line) = append-1(rag-grounded-binding-entry(ric-node-id(line), ric-content-node-id(line), ric-source-path(line), ric-key(line), ric-answer-key(line), ric-answer-hex(line), ric-vec(line), (Comparable) ric-grounding-ready?(line) == 1 && (Comparable) hex-valid?(ric-answer-hex(line)) == 1 ? 1 : 0), ric-persisted-source-sha256(line));
    def ra-entry-answer-valid?(entry) = (Comparable) rag-admitted?(entry) == 1 && ((Comparable) hex-valid?(rag-answer-hex(entry)) == 1 && (String) rag-answer-key(entry) == ra-answer-key-of-hex(rag-answer-hex(entry))) ? 1 : 0;
    def ra-line-ready?(line) = (Comparable) ric-grounding-ready?(line) == 1 && ((Comparable) hex-valid?(ric-answer-hex(line)) == 1 && (String) ric-answer-key(line) == ra-answer-key-of-hex(ric-answer-hex(line))) ? 1 : 0;
    def ra-line-rank-ready?(line) = (Comparable) ric-grounding-ready?(line) == 1 && (Comparable) hex-valid?(ric-answer-hex(line)) == 1 ? 1 : 0;
    // Fail closed: only typed, dual-NodeID rows with source/key/vector admission
    // enter ranking. Legacy path-id and malformed rows are absent, not low-ranked.
    def ra-entries-of(lines) = (Comparable) len(lines) == 0 ? empty() : (Comparable) str_len(head(lines)) == 0 || (Comparable) ra-line-ready?(head(lines)) == 0 ? ra-entries-of(tail(lines)) : cons(ra-entry-of-line(head(lines)), ra-entries-of(tail(lines)));
    // Interning the host-read string stabilizes it across the fkwu call frame
    // before recursive line parsing. The runtime remains zero-Python/zero-model.
    // `fs_exists` BEFORE `read_file`, and `str_len` after it — never `nil?`. `nil?` is a LIST cell
    // (core.fk names why), so on fkwu it read 1 for every string and this whole index came back
    // empty; on go/rust/ts it worked only by the coincidence that null's `len` is 0. The existence
    // question belongs to the filesystem, and asking it first is also what keeps a null out of
    // `str_len`, which rust and ts refuse rather than answer with 0.
    def ra-read-index(index-path) = fs_exists(index-path) ? {
        let raw = read_file(index-path);
        (Comparable) str_len(raw) == 0 ? empty() : {
            let text = node_value(intern_trivial_string(raw));
            ra-entries-of(ra-lines(text));
        };
    } : empty();
    def ra-staged-query-text() = {
        let path = ra-staged-query();
        fs_exists(path) ? read_file(path) : "";
    };
    def ra-query-text(query) = {
        let raw = (Comparable) str_len(query) == 0 ? ra-staged-query-text() : query;
        (Comparable) str_len(raw) == 0 ? "" : node_value(intern_trivial_string(raw));
    };
    // Compatibility name now routes through semantic overlap, not L1/exact text.
    def ra-nearest-id-for(query, entries) = rag-best-overlap-id(re-semantic-vec(query), entries);
    // ── structured selected hit ──
    // (status entry score runner query-total confidence)
    def ra-hit-row(status, entry, score, runner, query-total, confidence) = list(status, entry, score, runner, query-total, confidence);
    def ra-empty-entry() = rag-grounded-binding-entry("", "", "", "", "", "", empty(), 0);
    def ra-miss() = ra-hit-row("miss", ra-empty-entry(), 0, 0, 0, 0);
    def ra-hit?(hit) = (String) nth(hit, 0) == "hit" ? 1 : 0;
    def ra-hit-entry(hit) = nth(hit, 1);
    def ra-hit-node-id(hit) = rag-id(ra-hit-entry(hit));
    def ra-hit-content-node-id(hit) = rag-content-node-id(ra-hit-entry(hit));
    def ra-hit-source-path(hit) = rag-source-path(ra-hit-entry(hit));
    def ra-hit-key(hit) = rag-key(ra-hit-entry(hit));
    def ra-hit-persisted-source-sha256(hit) = rag-persisted-source-sha256(ra-hit-entry(hit));
    def ra-hit-answer-key(hit) = rag-answer-key(ra-hit-entry(hit));
    def ra-hit-answer-hex(hit) = rag-answer-hex(ra-hit-entry(hit));
    def ra-hit-admitted?(hit) = rag-admitted?(ra-hit-entry(hit));
    // "resolves" here means the row came from the typed substrate-resolved export.
    // Fresh query-time REF->CTOR/source/key resolution remains the host verifier's
    // independent signal; this function never pretends an offline cache is live DB.
    def ra-hit-resolves?(hit) = (Comparable) ra-hit?(hit) == 1 && (Comparable) ra-hit-admitted?(hit) == 1 ? 1 : 0;
    def ra-hit-score(hit) = nth(hit, 2);
    def ra-hit-runner-score(hit) = nth(hit, 3);
    def ra-hit-query-total(hit) = nth(hit, 4);
    def ra-hit-confidence(hit) = nth(hit, 5);
    def ra-hit-threshold(hit) =     // qtotal is two codes per deduplicated feature. Require whole pairs for
    // at least two-thirds of query features: 2 * ceil(qtotal / 3).
ra-hit-query-total(hit) <= 0 ? 0 : 2 * ((ra-hit-query-total(hit) + 2) / 3);
    // Content sufficiency is query coverage only. Ranking confidence and live
    // resolution are deliberately separate axes for the trust gate.
    def ra-hit-sufficient?(hit) = (Comparable) ra-hit?(hit) == 1 && (ra-hit-score(hit) > 0 && ra-hit-score(hit) >= ra-hit-threshold(hit)) ? 1 : 0;
    def ra-confidence(best-score, runner-score) = (Comparable) best-score == 0 ? 0 : (best-score - runner-score) * 100 / best-score;
    def ra-select-hit(query, entries) = (Comparable) str_len(query) == 0 || (Comparable) len(entries) == 0 ? ra-miss() : {
        let qvec = re-semantic-vec(query);
        let qtotal = len(qvec);
        let top = rag-topk-overlap(qvec, entries, 2);
        (Comparable) qtotal == 0 || (Comparable) len(top) == 0 ? ra-miss() : {
            let best = nth(top, 0);
            let score = rag-overlap-score(qvec, best);
            let runner = len(top) < 2 ? 0 : rag-overlap-score(qvec, nth(top, 1));
            let hit = ra-hit-row("hit", best, score, runner, qtotal, ra-confidence(score, runner));
            (Comparable) ra-hit-sufficient?(hit) == 1 ? hit : ra-miss();
        };
    };
    // ── bounded-memory / bounded-depth JSONL ranking ──
    // The production index is several megabytes. Building ra-lines + ra-entries
    // retains the whole parsed corpus, while a linear recursive scanner retains
    // one emitted-walker frame per row. Balanced LF-aligned ranges keep call
    // depth logarithmic and merge only each half's deterministic best two.
    def ra-empty-ranking() = list(empty(), empty());
    def ra-ranking-add(qvec, ranked, candidate) = {
        let best = nth(ranked, 0);
        let runner = nth(ranked, 1);
        (Comparable) len(candidate) == 0 ? ranked : (Comparable) len(best) == 0 ? list(candidate, runner) : (Comparable) rag-overlap-better?(qvec, candidate, best) == 1 ? list(candidate, best) : (String) rag-id(candidate) == rag-id(best) ? ranked : (Comparable) len(runner) == 0 || (Comparable) rag-overlap-better?(qvec, candidate, runner) == 1 ? list(best, candidate) : ranked;
    };
    def ra-ranking-merge(qvec, left, right) = ra-ranking-add(qvec, ra-ranking-add(qvec, left, nth(right, 0)), nth(right, 1));
    def ra-stream-effective-end(text) = {
        let n = str_len(text);
        n > 0 && (Comparable) str_byte_at(text, n - 1) == 10 ? n - 1 : n;
    };
    def ra-stream-range-split(text, start, end) = {
        let mid = (start + end) / 2;
        let after-mid = scan_run(text, mid, 5);
        after-mid < end ? after-mid : scan_run(text, start, 5);
    };
    def ra-stream-rank-range(text, start, end, qvec) = start >= end ? ra-empty-ranking() : {
        let split = ra-stream-range-split(text, start, end);
        split >= end ? {
            let line = substring(text, start, end);
            (Comparable) ra-line-rank-ready?(line) == 0 ? ra-empty-ranking() : list(ra-rank-entry-of-line(line), empty());
        } : ra-ranking-merge(qvec, ra-stream-rank-range(text, start, split, qvec), ra-stream-rank-range(text, split + 1, end, qvec));
    };
    def ra-stream-hit(text, query) = {
        let qvec = re-semantic-vec(query);
        (Comparable) str_len(text) == 0 || (Comparable) len(qvec) == 0 ? ra-miss() : {
            let ranked = ra-stream-rank-range(text, 0, ra-stream-effective-end(text), qvec);
            let best = nth(ranked, 0);
            let runner-entry = nth(ranked, 1);
            (Comparable) len(best) == 0 || (Comparable) ra-entry-answer-valid?(best) == 0 ? ra-miss() : {
                let score = rag-overlap-score(qvec, best);
                let runner-score = (Comparable) len(runner-entry) == 0 || (Comparable) ra-entry-answer-valid?(runner-entry) == 0 ? 0 : rag-overlap-score(qvec, runner-entry);
                let hit = ra-hit-row("hit", best, score, runner-score, len(qvec), ra-confidence(score, runner-score));
                (Comparable) ra-hit-sufficient?(hit) == 1 ? hit : ra-miss();
            };
        };
    };
    def ra-grounded-hit-at(index-path, query) =     // Keep the host-read values rooted in this live frame and feed those
    // exact string values to the streaming ranker.  `read_file` already
    // interns its byte buffer in the emitted walker. Projecting it through
    // intern_trivial_string -> node_value changes the value category on that
    // carrier and made valid standalone rows miss even though direct
    // ra-stream-hit over the same bytes succeeded.
file_size(index-path) <= 0 ? ra-miss() : (Comparable) str_len(query) == 0 ? file_size(ra-staged-query()) <= 0 ? ra-miss() : {
        let raw-index = read_file(index-path);
        let raw-query = read_file(ra-staged-query());
        ra-stream-hit(raw-index, raw-query);
    } : {
        let raw-index = read_file(index-path);
        ra-stream-hit(raw-index, query);
    };
    def ra-grounded-hit(query) = ra-grounded-hit-at(ra-default-index(), query);
    // ── exact answer decode, attributed output, and binding proofs ──
    def ra-bytes-string-loop(bytes, out) = (Comparable) len(bytes) == 0 ? out : ra-bytes-string-loop(tail(bytes), str_concat(out, byte_to_str(head(bytes))));
    def ra-answer-from-hex(answer-hex) = (Comparable) hex-valid?(answer-hex) == 0 ? "" : ra-bytes-string-loop(hex-decode(answer-hex), "");
    def ra-hit-answer(hit) = ra-answer-from-hex(ra-hit-answer-hex(hit));
    def ra-cat(parts) = (Comparable) len(parts) == 0 ? "" : str_concat(head(parts), ra-cat(tail(parts)));
    def ra-hit-binding-lines(hit) = (Comparable) ra-hit?(hit) == 0 ? "" : ra-cat(list("content-node:", ra-hit-content-node-id(hit), "\nsource-path:", ra-hit-source-path(hit), "\nsource-key:", ra-hit-key(hit), "\nanswer-key:", ra-hit-answer-key(hit)));
    def ra-hit-score-lines(hit) = ra-cat(list("retrieval-score:", int_to_str(ra-hit-score(hit)), "\nretrieval-runner-score:", int_to_str(ra-hit-runner-score(hit)), "\nretrieval-query-total:", int_to_str(ra-hit-query-total(hit)), "\nretrieval-threshold:", int_to_str(ra-hit-threshold(hit)), "\nretrieval-confidence:", int_to_str(ra-hit-confidence(hit))));
    // The answer is LAST, so arbitrary newlines in the exact decoded excerpt
    // cannot be confused with metadata. The whole payload is regenerated from the
    // selected hit for binding comparison; no wrapper concatenates answer text.
    def ra-hit-output(hit) = (Comparable) ra-hit?(hit) == 1 && ((Comparable) ric-node-id-valid?(ra-hit-node-id(hit)) == 1 && (Comparable) ric-node-id-valid?(ra-hit-content-node-id(hit)) == 1) ? ra-cat(list(ra-grounded-prefix(), ra-hit-node-id(hit), "\n", ra-hit-binding-lines(hit), "\n", ra-hit-score-lines(hit), "\nlocal-lane:fkwu-rag-grounded", "\nsynthesis-lane:fkwu-rag-grounded", "\nanswer-byte-length:", int_to_str(str_len(ra-hit-answer(hit))), "\nanswer:", ra-hit-answer(hit))) : "grounded:miss";
    def ra-output-node-id(output) = (Comparable) str_find(output, ra-grounded-prefix(), 0) == 0 ? {
        let nl = str_find(output, byte_to_str(10), 0);
        substring(output, str_len(ra-grounded-prefix()), nl < 0 ? str_len(output) : nl);
    } : "";
    def ra-output-valid?(output) = (Comparable) ric-node-id-valid?(ra-output-node-id(output)) == 1 ? 1 : 0;
    def ra-output-binds-hit?(output, hit) = (Comparable) ra-output-valid?(output) == 1 && (String) output == ra-hit-output(hit) ? 1 : 0;
    def ra-output-answer(output) = {
        let marker = "\nanswer:";
        let at = str_find(output, marker, 0);
        at < 0 ? "" : substring(output, at + str_len(marker), str_len(output));
    };
    def ra-output-answer-binds-hit?(output, hit) = (Comparable) ra-output-binds-hit?(output, hit) == 1 && (String) ra-output-answer(output) == ra-hit-answer(hit) ? 1 : 0;
    def ra-grounded-at(index-path, query) = ra-hit-output(ra-grounded-hit-at(index-path, query));
    def ra-grounded(query) = ra-grounded-at(ra-default-index(), query);
    0;
}
