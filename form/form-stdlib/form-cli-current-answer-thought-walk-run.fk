; preludes: form-stdlib/core.fk
; preludes: form-stdlib/form-cli-current-answer-thought-walk.fk

(do
    (let source (intern_trivial_string "sha256:current-source"))
    (let values (list source source "answer" "answer" "hit" "hit"
        "concept-registry-current-source-hit"
        "concept-registry-current-source-hit"
        1 1 1 1 1 1 "choice,cut,release" "choice,cut,release"))
    (let kinds (list
        (fcatw-kind-node) (fcatw-kind-node)
        (fcatw-kind-string) (fcatw-kind-string)
        (fcatw-kind-string) (fcatw-kind-string)
        (fcatw-kind-string) (fcatw-kind-string)
        (fcatw-kind-int) (fcatw-kind-int)
        (fcatw-kind-int) (fcatw-kind-int)
        (fcatw-kind-int) (fcatw-kind-int)
        (fcatw-kind-string) (fcatw-kind-string)))
    (let result (fcatw-run values kinds 93))
    (list (fcatw-version) (fcatw-symbol) (fcatw-status result)
        (fcatw-reason result) (fcatw-value result) (fcatw-kind result)
        (fcatw-steps result) (fcatw-output-count result)))
