// form-cli-turn-evidence.fk — validate one completed Codex turn and derive
// an explicitly scoped event share from it.
//
// preludes: form-stdlib/core.fk form-stdlib/line-grammar.fk
//
// The Form carrier derives measurements without emitting prose content. This
// cell owns trust: a row is observed only when its identity, time, provider
// usage-event count, tool accounting, form-run byte accounting, lane totals,
// source, and completion flag reconcile. The percentage is not a measure of
// semantic contribution. It is a largest-remainder normalization of observed
// boundary events for one completed turn:
//   native = completed fkwu receipt rows in native-request output tails
//   local  = other completed tool outputs and non-fkwu rows in those tails
//   remote = provider-usage events
section [form.bml] {
    def fcte-tag-v1() = "turn-evidence-v1";
    def fcte-tag() = "turn-evidence-v2";
    def fcte-tag-v3() = "turn-evidence-v3";
    def fcte-tag-current() = "turn-evidence-v4";
    def fcte-source-kind() = "codex-rollout-jsonl+explicit-form-binding";
    def fcte-source-kind-grok() = "grok-form-run-logs+explicit-form-binding";
    def fcte-source-ok?(e) = (String) fcte-source(e) == fcte-source-kind() ? 1 : (String) fcte-source(e) == fcte-source-kind-grok() ? 1 : 0;
    def fcte-field-count-v1() = 35;
    def fcte-field-count-v2() = 36;
    def fcte-field-count() = 39;
    def fcte-parse(row) = split-on(row, "|");
    def fcte-thread-id(e) = nth(e, 1);
    def fcte-turn-id(e) = nth(e, 2);
    def fcte-model-provider(e) = nth(e, 3);
    def fcte-model(e) = nth(e, 4);
    def fcte-started-ms(e) = str_to_int(nth(e, 5));
    def fcte-ended-ms(e) = str_to_int(nth(e, 6));
    def fcte-duration-ms(e) = str_to_int(nth(e, 7));
    def fcte-ttft-ms(e) = str_to_int(nth(e, 8));
    def fcte-final-output-bytes(e) = str_to_int(nth(e, 9));
    def fcte-model-calls(e) = str_to_int(nth(e, 10));
    def fcte-input-tokens(e) = str_to_int(nth(e, 11));
    def fcte-cached-input-tokens(e) = str_to_int(nth(e, 12));
    def fcte-uncached-input-tokens(e) = str_to_int(nth(e, 13));
    def fcte-cache-write-input-tokens(e) = str_to_int(nth(e, 14));
    def fcte-output-tokens(e) = str_to_int(nth(e, 15));
    def fcte-reasoning-output-tokens(e) = str_to_int(nth(e, 16));
    def fcte-total-tokens(e) = str_to_int(nth(e, 17));
    def fcte-tool-calls(e) = str_to_int(nth(e, 18));
    def fcte-tool-outputs(e) = str_to_int(nth(e, 19));
    def fcte-tool-wall-ms(e) = str_to_int(nth(e, 20));
    def fcte-tool-output-bytes(e) = str_to_int(nth(e, 21));
    def fcte-form-commands(e) = str_to_int(nth(e, 22));
    def fcte-form-failures(e) = str_to_int(nth(e, 23));
    def fcte-form-stdout-bytes(e) = str_to_int(nth(e, 24));
    def fcte-form-stderr-bytes(e) = str_to_int(nth(e, 25));
    def fcte-form-shown-bytes(e) = str_to_int(nth(e, 26));
    def fcte-native-commands(e) = str_to_int(nth(e, 27));
    def fcte-native-failures(e) = str_to_int(nth(e, 28));
    def fcte-local-events(e) = str_to_int(nth(e, 29));
    def fcte-remote-events(e) = str_to_int(nth(e, 30));
    def fcte-total-events(e) = str_to_int(nth(e, 31));
    def fcte-patch-events(e) = str_to_int(nth(e, 32));
    def fcte-source(e) = nth(e, 33);
    def fcte-complete(e) = str_to_int(nth(e, 34));
    def fcte-unattributed-tokens(e) = len(e) >= fcte-field-count-v2() ? str_to_int(nth(e, 35)) : 0;
    def fcte-carrier-size(e) = (Comparable) len(e) == fcte-field-count() ? str_to_int(nth(e, 36)) : 0;
    def fcte-start-at(e) = (Comparable) len(e) == fcte-field-count() ? str_to_int(nth(e, 37)) : 0;
    def fcte-complete-at(e) = (Comparable) len(e) == fcte-field-count() ? str_to_int(nth(e, 38)) : 0;
    def fcte-digits-loop?(s, i) = (Comparable) i == str_len(s) ? 1 : is-digit-cp(ord(char_at(s, i))) ? fcte-digits-loop?(s, i + 1) : 0;
    def fcte-digits?(s) = (Comparable) str_len(s) == 0 ? 0 : fcte-digits-loop?(s, 0);
    def fcte-numeric-fields-loop?(e, i) = (Comparable) i == 33 ? (Comparable) fcte-digits?(nth(e, 34)) == 0 ? 0 : (Comparable) len(e) == fcte-field-count-v1() ? 1 : (Comparable) fcte-digits?(nth(e, 35)) == 0 ? 0 : (Comparable) len(e) == fcte-field-count-v2() ? 1 : (Comparable) fcte-digits?(nth(e, 36)) == 0 ? 0 : (Comparable) fcte-digits?(nth(e, 37)) == 0 ? 0 : fcte-digits?(nth(e, 38)) : fcte-digits?(nth(e, i)) ? fcte-numeric-fields-loop?(e, i + 1) : 0;
    def fcte-shape?(e) = (Comparable) len(e) == fcte-field-count() ? (String) nth(e, 0) == fcte-tag-current() || (String) nth(e, 0) == fcte-tag-v3() ? 1 : 0 : (Comparable) len(e) == fcte-field-count-v2() ? (String) nth(e, 0) == fcte-tag() ? 1 : 0 : (Comparable) len(e) == fcte-field-count-v1() ? (String) nth(e, 0) == fcte-tag-v1() ? 1 : 0 : 0;
    def fcte-provenance-shape?(e) = (Comparable) len(e) == fcte-field-count() && (((String) nth(e, 0) == fcte-tag-current() || (String) nth(e, 0) == fcte-tag-v3()) && (fcte-carrier-size(e) >= 1 && (fcte-start-at(e) >= 0 && (fcte-complete-at(e) >= fcte-start-at(e) && fcte-complete-at(e) < fcte-carrier-size(e))))) ? 1 : 0;
    def fcte-identity?(e) = str_len(fcte-thread-id(e)) > 0 && (str_len(fcte-turn-id(e)) > 0 && (str_len(fcte-model-provider(e)) > 0 && str_len(fcte-model(e)) > 0)) ? 1 : 0;
    def fcte-time-valid?(e) = fcte-ended-ms(e) >= fcte-started-ms(e) && ((Comparable) fcte-duration-ms(e) == fcte-ended-ms(e) - fcte-started-ms(e) && (fcte-ttft-ms(e) <= fcte-duration-ms(e) && fcte-final-output-bytes(e) >= 0)) ? 1 : 0;
    def fcte-token-valid?(e) = fcte-cached-input-tokens(e) <= fcte-input-tokens(e) && ((Comparable) fcte-uncached-input-tokens(e) == fcte-input-tokens(e) - fcte-cached-input-tokens(e) && (fcte-reasoning-output-tokens(e) <= fcte-output-tokens(e) && ((Comparable) fcte-total-tokens(e) == fcte-input-tokens(e) + (fcte-output-tokens(e) + fcte-unattributed-tokens(e)) && (Comparable) fcte-model-calls(e) == fcte-remote-events(e)))) ? 1 : 0;
    def fcte-tool-valid?(e) = (Comparable) fcte-tool-calls(e) == fcte-tool-outputs(e) && (fcte-tool-wall-ms(e) >= 0 && fcte-tool-output-bytes(e) >= 0) ? 1 : 0;
    def fcte-form-valid?(e) = fcte-form-failures(e) <= fcte-form-commands(e) && ((Comparable) fcte-form-shown-bytes(e) == fcte-form-stdout-bytes(e) + fcte-form-stderr-bytes(e) && (fcte-native-commands(e) <= fcte-form-commands(e) && fcte-native-failures(e) <= fcte-native-commands(e))) ? 1 : 0;
    def fcte-lanes-valid?(e) = (Comparable) fcte-total-events(e) == fcte-native-commands(e) + (fcte-local-events(e) + fcte-remote-events(e)) ? 1 : 0;
    def fcte-carrier-present?(e) = fcte-shape?(e) ? fcte-identity?(e) ? fcte-numeric-fields-loop?(e, 5) : 0 : 0;
    def fcte-valid?(e) = fcte-carrier-present?(e) ? fcte-time-valid?(e) && (fcte-token-valid?(e) && (fcte-tool-valid?(e) && (fcte-form-valid?(e) && (fcte-lanes-valid?(e) && ((Comparable) fcte-source-ok?(e) == 1 && ((Comparable) fcte-complete(e) == 1 &&     // v1/v2 remain readable receipts.  v3 earns its newer tag
    // only when its source-coordinate tuple is structurally
    // present; the live Codex validator then recontacts those
    // coordinates before exposing a percentage.
((Comparable) len(e) == fcte-field-count() ? fcte-provenance-shape?(e) : 1))))))) ? 1 : 0 : 0;
    // Declared means there is no usable carrier row. Embodied means a carrier row
    // crossed the body but did not completely reconcile. Observed is earned only
    // by the full validation above.
    def fcte-kind-declared() = 0;
    def fcte-kind-observed() = 1;
    def fcte-kind-embodied() = 2;
    def fcte-kind(e) = (Comparable) fcte-valid?(e) == 1 ? fcte-kind-observed() : (Comparable) fcte-carrier-present?(e) == 1 ? fcte-kind-embodied() : fcte-kind-declared();
    def fcte-kind-name(e) = (Comparable) fcte-kind(e) == fcte-kind-observed() ? "observed" : (Comparable) fcte-kind(e) == fcte-kind-embodied() ? "embodied" : "declared";
    // Deterministic largest-remainder apportionment. Ties resolve native, local,
    // remote so the same evidence is bit-identical on all proof walkers.
    def fcte-share-base(part, total) = part * 100 / total;
    def fcte-share-rem(part, total) = part * 100 % total;
    def fcte-first-winner(rn, rl, rr) = rn >= rl && rn >= rr ? 0 : rl >= rr ? 1 : 2;
    def fcte-second-winner(first, rn, rl, rr) = (Comparable) first == 0 ? rl >= rr ? 1 : 2 : (Comparable) first == 1 ? rn >= rr ? 0 : 2 : rn >= rl ? 0 : 1;
    def fcte-boundary-share(e) = {
        let native = fcte-native-commands(e);
        let local = fcte-local-events(e);
        let remote = fcte-remote-events(e);
        let total = fcte-total-events(e);
        (Comparable) total == 0 ? list(0, 0, 0) : {
            let bn = fcte-share-base(native, total);
            let bl = fcte-share-base(local, total);
            let br = fcte-share-base(remote, total);
            let left = 100 - (bn + (bl + br));
            let rn = fcte-share-rem(native, total);
            let rl = fcte-share-rem(local, total);
            let rr = fcte-share-rem(remote, total);
            let first = fcte-first-winner(rn, rl, rr);
            let second = fcte-second-winner(first, rn, rl, rr);
            list(bn + ((left >= 1 && (Comparable) first == 0 ? 1 : 0) + ((Comparable) left == 2 && (Comparable) second == 0 ? 1 : 0)), bl + ((left >= 1 && (Comparable) first == 1 ? 1 : 0) + ((Comparable) left == 2 && (Comparable) second == 1 ? 1 : 0)), br + ((left >= 1 && (Comparable) first == 2 ? 1 : 0) + ((Comparable) left == 2 && (Comparable) second == 2 ? 1 : 0)));
        };
    };
}
