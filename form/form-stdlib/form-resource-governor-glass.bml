//////////////////////////////////////////////////////////////////////
//
// form-resource-governor-glass.bml — bounded governor telemetry adapter.
//
// It deliberately reads stable governor value shapes instead of importing
// the large governor implementation.  The governor remains the sole policy
// owner; this shard only validates and projects its result into Glass.
//
// Authority: form-stdlib/bml/form-resource-governor-glass.bml
// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/form-resource-governor.bml form/form-stdlib/hearth.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormResourceGovernorGlassAuthority {
        field FRGGAuthorityPath = "form/form-stdlib/bml/form-resource-governor-glass.bml";
        field FRGGAuthorityKind = "high-bml-interface-class-const";
    }

    class FormResourceGovernorGlass {
        field FRGGSchema = "form-resource-governor-glass-v1";
        field FRGGPublisher = "resource.governor";
        ref frgg-authority = FormResourceGovernorGlassAuthority;
        thought frgg-law = list("physical-unknown-fails-closed", "grant-and-target-stay-distinct", "permit-coordinates-survive-projection", "release-is-not-pressure", "publication-uses-existing-membrane");

        def frgg-tagged?(value, count, tag) = nothing?(value) ? 0 : !((Comparable) len(value) == count) ? 0 : ((String) head(value) == tag);
        def frgg-text?(value) = nothing?(value) ? 0 : (str_len(value) > 0);
        def frgg-safe-label(value, fallback) = (Comparable) frgg-text?(value) == 0 ? fallback : (Comparable) fgtm-label?(value) == 1 ? value : fallback;
        def frgg-clamp-heat(value) = value < 0 ? 0 : value > 1000 ? 1000 : value;
        def frgg-utilization(grant, target) = target <= 0 ? 0 : frgg-clamp-heat((grant * 1000) / target);
        def frgg-field(value, present) = (Comparable) present == 1 ? fgtm-present(value) : fgtm-absent();

        // These readers mirror committed governor/v2 shapes.  They do not
        // recreate policy; they keep this adapter a small independently
        // cacheable shard rather than flattening the governor into Glass.
        def frgg-policy-fresh-frames(policy) = policy[7];
        def frgg-policy-pressure-critical(policy) = policy[11];
        def frgg-signal-truth(signal) = signal[1];
        def frgg-signal-age(signal) = signal[2];
        def frgg-signal-provenance(signal) = signal[3];
        def frgg-truth-kind(truth) = truth[1];
        def frgg-truth-value(truth) = truth[2];
        def frgg-provenance-evidence(provenance) = provenance[1];
        def frgg-provenance-publisher(provenance) = provenance[2];
        def frgg-provenance-lifetime-truth(provenance) = provenance[3];
        def frgg-provenance-sequence-truth(provenance) = provenance[4];
        def frgg-provenance-observed-truth(provenance) = provenance[5];
        def frgg-lifetime(truth) = truth[2];
        def frgg-lifetime-pid(lifetime) = lifetime[1];
        def frgg-lifetime-started(lifetime) = lifetime[2];
        def frgg-lifetime-incarnation(lifetime) = lifetime[3];
        def frgg-truth-measured?(truth) = !((Comparable) frgg-tagged?(truth, 9, "glass-truth-v2") == 1) ? 0 : !((String) frgg-truth-kind(truth) == "measured") ? 0 : nothing?(frgg-truth-value(truth)) ? 0 : !nothing?(truth[3]) ? 0 : !nothing?(truth[4]) ? 0 : !nothing?(truth[5]) ? 0 : !nothing?(truth[6]) ? 0 : !nothing?(truth[7]) ? 0 : !nothing?(truth[8]) ? 0 : 1;
        def frgg-lifetime-current?(truth) = !((Comparable) frgg-truth-measured?(truth) == 1) ? 0 : !((Comparable) frgg-tagged?(frgg-lifetime(truth), 4, "glass-process-lifetime-v2") == 1) ? 0 : frgg-lifetime-pid(frgg-lifetime(truth)) <= 0 ? 0 : frgg-lifetime-started(frgg-lifetime(truth)) < 0 ? 0 : frgg-text?(frgg-lifetime-incarnation(frgg-lifetime(truth)));
        def frgg-provenance-current?(provenance) = !((Comparable) frgg-tagged?(provenance, 7, "glass-provenance-v2") == 1) ? 0 : !((String) frgg-provenance-evidence(provenance) == "physical-live") ? 0 : !((Comparable) frgg-text?(frgg-provenance-publisher(provenance)) == 1) ? 0 : !((Comparable) frgg-lifetime-current?(frgg-provenance-lifetime-truth(provenance)) == 1) ? 0 : !((Comparable) frgg-truth-measured?(frgg-provenance-sequence-truth(provenance)) == 1) ? 0 : frgg-truth-value(frgg-provenance-sequence-truth(provenance)) < 0 ? 0 : !((Comparable) frgg-truth-measured?(frgg-provenance-observed-truth(provenance)) == 1) ? 0 : frgg-truth-value(frgg-provenance-observed-truth(provenance)) < 0 ? 0 : !((Comparable) frgg-text?(provenance[6]) == 1) ? 0 : 1;
        def frgg-signal-current?(signal, freshFrames) = !((Comparable) frgg-tagged?(signal, 4, "form-resource-signal-v1") == 1) ? 0 : !((Comparable) frgg-truth-measured?(frgg-signal-truth(signal)) == 1) ? 0 : frgg-truth-value(frgg-signal-truth(signal)) < 0 ? 0 : frgg-signal-age(signal) < 0 ? 0 : frgg-signal-age(signal) > freshFrames ? 0 : frgg-provenance-current?(frgg-signal-provenance(signal));
        def frgg-signals-current?(signals, freshFrames) = (Comparable) len(signals) == 0 ? 1 : (Comparable) frgg-signal-current?(head(signals), freshFrames) == 1 ? frgg-signals-current?(tail(signals), freshFrames) : 0;
        def frgg-resource-current?(resource, freshFrames) = !((Comparable) frgg-tagged?(resource, 5, "form-resource-observation-v1") == 1) ? 0 : frgg-signals-current?(list(resource[2], resource[3], resource[4]), freshFrames);
        def frgg-sample-current?(policy, sample) = !((Comparable) frgg-tagged?(policy, 17, "form-resource-policy-v1") == 1) ? 0 : !((Comparable) frgg-tagged?(sample, 11, "form-resource-sample-v1") == 1) ? 0 : !((Comparable) frgg-resource-current?(sample[2], frgg-policy-fresh-frames(policy)) == 1) ? 0 : !((Comparable) frgg-resource-current?(sample[3], frgg-policy-fresh-frames(policy)) == 1) ? 0 : !((Comparable) frgg-resource-current?(sample[4], frgg-policy-fresh-frames(policy)) == 1) ? 0 : frgg-signals-current?(list(sample[1], sample[5], sample[6], sample[7], sample[8], sample[9], sample[10]), frgg-policy-fresh-frames(policy));

        def frgg-decision-reason(decision) = decision[1];
        def frgg-decision-target(decision, index) = decision[index];
        def frgg-decision-grant(decision, index) = decision[index];
        def frgg-decision-metal-submit(decision) = decision[9];
        def frgg-decision-permit(decision) = decision[11];
        def frgg-zero-grants?(decision) = !((Comparable) decision[6] == 0) ? 0 : !((Comparable) decision[7] == 0) ? 0 : !((Comparable) decision[8] == 0) ? 0 : ((Comparable) decision[9] == 0);
        def frgg-decision-reason-known?(reason) = (String) reason == "additive-recovery" ? 1 : (String) reason == "half-backoff" ? 1 : (String) reason == "stop-backoff" ? 1 : (String) reason == "typed-signal-not-current" ? 1 : 0;
        def frgg-decision-safe?(policy, sample, decision) = !((Comparable) frgg-tagged?(decision, 13, "form-resource-decision-v1") == 1) ? 0 : !((Comparable) frgg-decision-reason-known?(frgg-decision-reason(decision)) == 1) ? 0 : (Comparable) frgg-sample-current?(policy, sample) == 1 ? 1 : !((String) frgg-decision-reason(decision) == "typed-signal-not-current") ? 0 : frgg-zero-grants?(decision);

        def frgg-resource-row(id, plane, grant, target, epoch, safe) {
            let measured = ((Comparable) safe == 1) && (target > 0) ? 1 : 0;
            fgtm-sample(id, fgtm-absent(), "governor-grant", plane, FRGGPublisher(), "scheduler", (Comparable) measured == 1 ? "target-utilization" : "target-unavailable", frgg-field(grant, measured), frgg-field(target, measured), !((Comparable) measured == 1) ? "unknown" : grant > 0 ? "active" : "idle", frgg-field(epoch, measured), frgg-field(epoch, measured), (Comparable) measured == 1 ? fgtm-present(frgg-utilization(grant, target)) : fgtm-absent(), fgtm-absent(), "never", "derived-window", (Comparable) measured == 1 ? "governor.decision" : "governor.fail-closed", list("governor", "health", "memory", plane));
        }
        def frgg-pressure-signal(sample) = (Comparable) frgg-tagged?(sample, 11, "form-resource-sample-v1") == 1 ? sample[7] : list();
        def frgg-pressure-kind(signal) = !((Comparable) frgg-tagged?(signal, 4, "form-resource-signal-v1") == 1) ? "invalid" : frgg-safe-label(frgg-truth-kind(frgg-signal-truth(signal)), "invalid");
        def frgg-pressure-purpose(signal, current, critical) = !((Comparable) current == 1) ? "pressure-" ++ frgg-pressure-kind(signal) : frgg-truth-value(frgg-signal-truth(signal)) >= critical ? "pressure-critical" : frgg-truth-value(frgg-signal-truth(signal)) > 0 ? "pressure-warning" : "pressure-zero";
        def frgg-pressure-row(policy, sample) {
            let signal = frgg-pressure-signal(sample);
            let current = frgg-signal-current?(signal, frgg-policy-fresh-frames(policy));
            let critical = frgg-policy-pressure-critical(policy);
            let value = (Comparable) current == 1 ? frgg-truth-value(frgg-signal-truth(signal)) : 0;
            let provenance = (Comparable) current == 1 ? frgg-signal-provenance(signal) : list();
            let observed = (Comparable) current == 1 ? frgg-truth-value(frgg-provenance-observed-truth(provenance)) : 0;
            let lifetime = (Comparable) current == 1 ? frgg-lifetime(frgg-provenance-lifetime-truth(provenance)) : list();
            fgtm-sample("governor.pressure.memory", fgtm-absent(), "pressure", "unified", (Comparable) current == 1 ? frgg-safe-label(frgg-provenance-publisher(provenance), FRGGPublisher()) : FRGGPublisher(), "scheduler", frgg-pressure-purpose(signal, current, critical), frgg-field(value, current), frgg-field(critical, current), !((Comparable) current == 1) ? "unknown" : value > 0 ? "active" : "idle", frgg-field(observed, current), (Comparable) current == 1 ? fgtm-present(frgg-lifetime-started(lifetime)) : fgtm-absent(), (Comparable) current == 1 ? fgtm-present(frgg-utilization(value, critical)) : fgtm-absent(), (Comparable) current == 1 ? fgtm-present(frgg-lifetime-pid(lifetime)) : fgtm-absent(), "never", (Comparable) current == 1 ? "physical-live" : "derived-window", (Comparable) current == 1 ? "governor.pressure" : "governor.fail-closed", list("governor", "health", "memory", "pressure"));
        }

        def frgg-permit-shape?(permit) = frgg-tagged?(permit, 9, "form-resource-metal-permit-v2");
        def frgg-permit-id(permit) = permit[1];
        def frgg-permit-tick(permit) = permit[2];
        def frgg-permit-status(permit) = permit[3];
        def frgg-permit-provenance(permit) = permit[4];
        def frgg-permit-handle(permit) = permit[5];
        def frgg-permit-submit-provenance(permit) = permit[6];
        def frgg-permit-slot-path(permit) = permit[7];
        def frgg-permit-owner-text(permit) = permit[8];
        def frgg-metal-owner-text(permit) {
            let provenance = frgg-permit-provenance(permit);
            let lifetime = frgg-lifetime(frgg-provenance-lifetime-truth(provenance));
            let permitLine = "schema=form-resource-metal-owner-v2\npermit=" ++ frgg-permit-id(permit);
            let publisherLine = permitLine ++ "\npublisher=" ++ frgg-provenance-publisher(provenance);
            let pidLine = publisherLine ++ "\npid=" ++ int_to_str(frgg-lifetime-pid(lifetime));
            let startedLine = pidLine ++ "\nstarted=" ++ int_to_str(frgg-lifetime-started(lifetime));
            let incarnationLine = startedLine ++ "\nincarnation=" ++ frgg-lifetime-incarnation(lifetime);
            let sequenceLine = incarnationLine ++ "\nsequence=" ++ int_to_str(frgg-truth-value(frgg-provenance-sequence-truth(provenance)));
            let observedLine = sequenceLine ++ "\nobserved=" ++ int_to_str(frgg-truth-value(frgg-provenance-observed-truth(provenance)));
            observedLine ++ "\nsource=" ++ provenance[6] ++ "\n";
        }
        def frgg-permit-coordinate(provenance, coordinate) = !((Comparable) frgg-provenance-current?(provenance) == 1) ? 0 : frgg-truth-value((String) coordinate == "sequence" ? frgg-provenance-sequence-truth(provenance) : frgg-provenance-observed-truth(provenance));
        def frgg-provenance-same-lifetime?(left, right) = !(((Comparable) frgg-provenance-current?(left) == 1) && ((Comparable) frgg-provenance-current?(right) == 1)) ? 0 : !((String) frgg-provenance-publisher(left) == frgg-provenance-publisher(right)) ? 0 : !((Comparable) frgg-lifetime-pid(frgg-lifetime(frgg-provenance-lifetime-truth(left))) == frgg-lifetime-pid(frgg-lifetime(frgg-provenance-lifetime-truth(right)))) ? 0 : !((Comparable) frgg-lifetime-started(frgg-lifetime(frgg-provenance-lifetime-truth(left))) == frgg-lifetime-started(frgg-lifetime(frgg-provenance-lifetime-truth(right)))) ? 0 : ((String) frgg-lifetime-incarnation(frgg-lifetime(frgg-provenance-lifetime-truth(left))) == frgg-lifetime-incarnation(frgg-lifetime(frgg-provenance-lifetime-truth(right))));
        def frgg-provenance-exact?(left, right) = !((Comparable) frgg-provenance-same-lifetime?(left, right) == 1) ? 0 : !((Comparable) frgg-permit-coordinate(left, "sequence") == frgg-permit-coordinate(right, "sequence")) ? 0 : !((Comparable) frgg-permit-coordinate(left, "observed") == frgg-permit-coordinate(right, "observed")) ? 0 : ((String) left[6] == right[6]);
        def frgg-provenance-advances?(prior, next) = !((Comparable) frgg-provenance-same-lifetime?(prior, next) == 1) ? 0 : frgg-permit-coordinate(next, "sequence") <= frgg-permit-coordinate(prior, "sequence") ? 0 : frgg-permit-coordinate(next, "observed") <= frgg-permit-coordinate(prior, "observed") ? 0 : 1;
        def frgg-permit-valid?(permit) = !((Comparable) frgg-permit-shape?(permit) == 1) ? 0 : !((Comparable) frgg-text?(frgg-permit-id(permit)) == 1) ? 0 : frgg-permit-tick(permit) < 0 ? 0 : !((Comparable) frgg-provenance-current?(frgg-permit-provenance(permit)) == 1) ? 0 : (String) frgg-permit-status(permit) == "open" ? (((Comparable) frgg-permit-handle(permit) == 0) && (((Comparable) str_len(frgg-permit-slot-path(permit)) == 0) && ((Comparable) str_len(frgg-permit-owner-text(permit)) == 0)) ? 1 : 0) : (String) frgg-permit-status(permit) == "reserved" ? (((Comparable) frgg-permit-handle(permit) == 0) && (((String) frgg-permit-slot-path(permit) == frg-metal-slot-path()) && ((String) frgg-permit-owner-text(permit) == frgg-metal-owner-text(permit))) ? 1 : 0) : (String) frgg-permit-status(permit) == "submitted" ? ((frgg-permit-handle(permit) > 0) && (((String) frgg-permit-slot-path(permit) == frg-metal-slot-path()) && (((String) frgg-permit-owner-text(permit) == frgg-metal-owner-text(permit)) && ((Comparable) frgg-provenance-advances?(frgg-permit-provenance(permit), frgg-permit-submit-provenance(permit)) == 1))) ? 1 : 0) : 0;
        def frgg-permit-same-base?(left, right) = !(((Comparable) frgg-permit-valid?(left) == 1) && ((Comparable) frgg-permit-valid?(right) == 1)) ? 0 : !((String) frgg-permit-id(left) == frgg-permit-id(right)) ? 0 : frgg-provenance-exact?(frgg-permit-provenance(left), frgg-permit-provenance(right));

        def frgg-state-holds-permit?(state, permit) = !((Comparable) frgg-tagged?(state, 7, "form-resource-governor-state-v1") == 1) ? 0 : ((Value) state[6] == permit);
        def frgg-slot-result-valid?(result, permit) = !((Comparable) frgg-tagged?(result, 6, "form-resource-metal-slot-result-v2") == 1) ? 0 : !((String) result[1] == "acquired") ? 0 : !((Comparable) result[4] == 1) ? 0 : !((Comparable) result[5] == str_len(frgg-permit-owner-text(permit))) ? 0 : ((Value) result[3] == permit);
        def frgg-consume-attempted?(result) = frgg-tagged?(result, 6, "form-resource-permit-consume-v2");
        def frgg-consume-admitted?(result, decision) = !((Comparable) frgg-tagged?(result, 6, "form-resource-permit-consume-v2") == 1) ? 0 : !((String) result[1] == "admitted") ? 0 : !((Comparable) frgg-permit-valid?(result[3]) == 1) ? 0 : !((String) frgg-permit-status(result[3]) == "reserved") ? 0 : !((Comparable) frgg-permit-same-base?(result[3], frgg-decision-permit(decision)) == 1) ? 0 : !((Comparable) frgg-state-holds-permit?(result[4], result[3]) == 1) ? 0 : frgg-slot-result-valid?(result[5], result[3]);
        def frgg-submit-attempted?(result) = frgg-tagged?(result, 6, "form-resource-metal-submit-bind-v2");
        def frgg-quantum-id(quantum) = quantum[1];
        def frgg-quantum-valid?(quantum) = !((Comparable) frgg-tagged?(quantum, 6, "form-resource-quantum-v1") == 1) ? 0 : frgg-text?(frgg-quantum-id(quantum));
        def frgg-submit-receipt-valid?(receipt) = !((Comparable) frgg-tagged?(receipt, 6, "form-resource-metal-submit-receipt-v2") == 1) ? 0 : !((String) receipt[1] == "submitted") ? 0 : receipt[2] <= 0 ? 0 : !((Comparable) frgg-text?(receipt[3]) == 1) ? 0 : !((Comparable) frgg-text?(receipt[4]) == 1) ? 0 : frgg-provenance-current?(receipt[5]);
        def frgg-submit-admitted?(result, decision, consumeResult, quantum) {
            let admitted = !((Comparable) frgg-tagged?(result, 6, "form-resource-metal-submit-bind-v2") == 1) ? 0 : (String) result[1] == "admitted" ? 1 : 0;
            let permit = (Comparable) admitted == 1 ? result[3] : list();
            let receipt = (Comparable) admitted == 1 ? result[5] : list();
            let reserved = (Comparable) frgg-consume-admitted?(consumeResult, decision) == 1 ? consumeResult[3] : list();
            !((Comparable) admitted == 1) ? 0 : !((Comparable) frgg-consume-admitted?(consumeResult, decision) == 1) ? 0 : !((Comparable) frgg-quantum-valid?(quantum) == 1) ? 0 : !((Comparable) frgg-permit-valid?(permit) == 1) ? 0 : !((String) frgg-permit-status(permit) == "submitted") ? 0 : !((Comparable) frgg-submit-receipt-valid?(receipt) == 1) ? 0 : !((Comparable) frgg-permit-same-base?(reserved, permit) == 1) ? 0 : !((Comparable) frgg-state-holds-permit?(result[4], permit) == 1) ? 0 : !((Comparable) frgg-permit-handle(permit) == receipt[2]) ? 0 : !((String) frgg-quantum-id(quantum) == receipt[3]) ? 0 : !((String) frgg-permit-id(permit) == receipt[4]) ? 0 : !((Comparable) frgg-provenance-exact?(frgg-permit-submit-provenance(permit), receipt[5]) == 1) ? 0 : 1;
        }
        def frgg-selected-permit(decision, consumeResult, submitBind, quantum) = (Comparable) frgg-submit-admitted?(submitBind, decision, consumeResult, quantum) == 1 ? submitBind[3] : (Comparable) frgg-consume-admitted?(consumeResult, decision) == 1 ? consumeResult[3] : (Comparable) frgg-permit-valid?(frgg-decision-permit(decision)) == 1 ? frgg-decision-permit(decision) : list();
        def frgg-permit-lifecycle(status) = (String) status == "submitted" ? "active" : (String) status == "reserved" ? "ready" : (String) status == "open" ? "ready" : "unknown";
        def frgg-permit-purpose(status) = (String) status == "submitted" ? "permit-submitted-correlated" : (String) status == "reserved" ? "permit-reserved" : (String) status == "open" ? "permit-open" : "permit-none";
        def frgg-permit-heat(status) = (String) status == "submitted" ? 1000 : (String) status == "reserved" ? 500 : (String) status == "open" ? 250 : 0;
        def frgg-permit-row(permit) {
            let present = frgg-permit-valid?(permit);
            let status = (Comparable) present == 1 ? frgg-permit-status(permit) : "none";
            let provenance = (Comparable) present == 1 ? frgg-permit-provenance(permit) : list();
            let current = (Comparable) present == 1 ? frgg-provenance-current?(provenance) : 0;
            let lifetime = (Comparable) current == 1 ? frgg-lifetime(frgg-provenance-lifetime-truth(provenance)) : list();
            let submitted = ((Comparable) present == 1) && ((String) status == "submitted") ? 1 : 0;
            let submitProvenance = (Comparable) submitted == 1 ? frgg-permit-submit-provenance(permit) : list();
            fgtm-sample("governor.permit." ++ status, fgtm-absent(), "permit", "metal", (Comparable) current == 1 ? frgg-safe-label(frgg-provenance-publisher(provenance), FRGGPublisher()) : FRGGPublisher(), "scheduler", frgg-permit-purpose(status), (Comparable) current == 1 ? fgtm-present(frgg-lifetime-pid(lifetime)) : fgtm-absent(), (Comparable) current == 1 ? fgtm-present(frgg-lifetime-started(lifetime)) : fgtm-absent(), frgg-permit-lifecycle(status), (Comparable) current == 1 ? fgtm-present(frgg-permit-coordinate(provenance, "observed")) : fgtm-absent(), (Comparable) submitted == 1 ? fgtm-present(frgg-permit-coordinate(submitProvenance, "observed")) : fgtm-absent(), (Comparable) present == 1 ? fgtm-present(frgg-permit-heat(status)) : fgtm-absent(), (Comparable) submitted == 1 ? fgtm-present(frgg-permit-handle(permit)) : fgtm-absent(), "never", "derived-window", (Comparable) current == 1 ? "governor.permit" : "governor.fail-closed", list("governor", "metal", "admission", "protocol"));
        }

        // A governor that could not read its signals granted nothing because it
        // never got to ask -- the same not-knowing the pressure row beside this
        // one already calls "unknown". Only a governor that read the frame and
        // then closed the door has refused. Both once read "failed", so an idle
        // host looked like a body declining every quantum it was never offered.
        def frgg-admission-unmeasured?(decision) = (String) frgg-decision-reason(decision) == "typed-signal-not-current";
        def frgg-admission-lifecycle(safe, decision, consumeResult, submitBind, quantum) = !((Comparable) safe == 1) ? "failed" : (Comparable) frgg-submit-admitted?(submitBind, decision, consumeResult, quantum) == 1 ? "active" : (Comparable) frgg-submit-attempted?(submitBind) == 1 ? "failed" : (Comparable) frgg-consume-admitted?(consumeResult, decision) == 1 ? "ready" : (Comparable) frgg-consume-attempted?(consumeResult) == 1 ? "failed" : (Comparable) frgg-decision-metal-submit(decision) == 1 ? "ready" : (Comparable) frgg-admission-unmeasured?(decision) == 1 ? "unknown" : "failed";
        def frgg-admission-purpose(safe, decision, consumeResult, submitBind, quantum) = !((Comparable) safe == 1) ? "adapter-input-invalid" : (Comparable) frgg-submit-admitted?(submitBind, decision, consumeResult, quantum) == 1 ? "admission-submitted-correlated" : (Comparable) frgg-submit-attempted?(submitBind) == 1 ? "admission-submit-refused" : (Comparable) frgg-consume-admitted?(consumeResult, decision) == 1 ? "admission-reserved" : (Comparable) frgg-consume-attempted?(consumeResult) == 1 ? "admission-reserve-refused" : (Comparable) frgg-decision-metal-submit(decision) == 1 ? "admission-offered" : (Comparable) frgg-admission-unmeasured?(decision) == 1 ? "admission-unmeasured" : "admission-refused";
        def frgg-admission-row(safe, decision, consumeResult, submitBind, quantum, permit, epoch) {
            let granted = !((Comparable) safe == 1) ? 0 : (Comparable) frgg-submit-admitted?(submitBind, decision, consumeResult, quantum) == 1 ? 1 : (Comparable) frgg-submit-attempted?(submitBind) == 1 ? 0 : (Comparable) frgg-consume-admitted?(consumeResult, decision) == 1 ? 1 : (Comparable) frgg-consume-attempted?(consumeResult) == 1 ? 0 : frgg-decision-metal-submit(decision);
            let submitted = ((Comparable) frgg-permit-valid?(permit) == 1) && ((String) frgg-permit-status(permit) == "submitted") ? 1 : 0;
