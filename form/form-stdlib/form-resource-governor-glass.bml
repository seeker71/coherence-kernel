//////////////////////////////////////////////////////////////////////
//
// form-resource-governor-glass.bml — bounded governor telemetry adapter.
//
// It deliberately reads stable governor value shapes instead of importing
// the large governor implementation.  The governor remains the sole policy
// owner; this shard only validates and projects its result into Glass.
//
// Authority: form-stdlib/bml/form-resource-governor-glass.bml
// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/form-resource-governor.bml form/form-stdlib/hearth.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormResourceGovernorGlassAuthority {
        field FRGGAuthorityPath = "form/form-stdlib/bml/form-resource-governor-glass.bml";
        field FRGGAuthorityKind = "high-bml-interface-class-const";
    }

    class FormResourceGovernorGlass {
        field FRGGSchema = "form-resource-governor-glass-v1";
        field FRGGPublisher = "resource.governor";
        ref frgg-authority = FormResourceGovernorGlassAuthority;
        thought frgg-law = ["physical-unknown-fails-closed", "grant-and-target-stay-distinct", "permit-coordinates-survive-projection", "release-is-not-pressure", "publication-uses-existing-membrane"];

        def frgg-tagged?(value, count, tag) = if nothing?(value) then 0 else if (!((Comparable) len(value) == count)) then 0 else ((String) head(value) == tag);
        def frgg-text?(value) = if nothing?(value) then 0 else (str_len(value) > 0);
        def frgg-safe-label(value, fallback) = if ((Comparable) frgg-text?(value) == 0) then fallback else if ((Comparable) fgtm-label?(value) == 1) then value else fallback;
        def frgg-clamp-heat(value) = if (value < 0) then 0 else if (value > 1000) then 1000 else value;
        def frgg-utilization(grant, target) = if (target <= 0) then 0 else frgg-clamp-heat(((grant * 1000) / target));
        def frgg-field(value, present) = if ((Comparable) present == 1) then fgtm-present(value) else fgtm-absent();

        // These readers mirror committed governor/v2 shapes.  They do not
        // recreate policy; they keep this adapter a small independently
        // cacheable shard rather than flattening the governor into Glass.
        def frgg-policy-fresh-frames(policy) = policy[7];
        def frgg-policy-pressure-critical(policy) = policy[11];
        def frgg-signal-truth(signal) = signal[1];
        def frgg-signal-age(signal) = signal[2];
        def frgg-signal-provenance(signal) = signal[3];
        def frgg-truth-kind(truth) = truth[1];
        def frgg-truth-value(truth) = truth[2];
        def frgg-provenance-evidence(provenance) = provenance[1];
        def frgg-provenance-publisher(provenance) = provenance[2];
        def frgg-provenance-lifetime-truth(provenance) = provenance[3];
        def frgg-provenance-sequence-truth(provenance) = provenance[4];
        def frgg-provenance-observed-truth(provenance) = provenance[5];
        def frgg-lifetime(truth) = truth[2];
        def frgg-lifetime-pid(lifetime) = lifetime[1];
        def frgg-lifetime-started(lifetime) = lifetime[2];
        def frgg-lifetime-incarnation(lifetime) = lifetime[3];
        def frgg-truth-measured?(truth) = if (!((Comparable) frgg-tagged?(truth, 9, "glass-truth-v2") == 1)) then 0 else if (!((String) frgg-truth-kind(truth) == "measured")) then 0 else if nothing?(frgg-truth-value(truth)) then 0 else if (!nothing?(truth[3])) then 0 else if (!nothing?(truth[4])) then 0 else if (!nothing?(truth[5])) then 0 else if (!nothing?(truth[6])) then 0 else if (!nothing?(truth[7])) then 0 else if (!nothing?(truth[8])) then 0 else 1;
        def frgg-lifetime-current?(truth) = if (!((Comparable) frgg-truth-measured?(truth) == 1)) then 0 else if (!((Comparable) frgg-tagged?(frgg-lifetime(truth), 4, "glass-process-lifetime-v2") == 1)) then 0 else if (frgg-lifetime-pid(frgg-lifetime(truth)) <= 0) then 0 else if (frgg-lifetime-started(frgg-lifetime(truth)) < 0) then 0 else frgg-text?(frgg-lifetime-incarnation(frgg-lifetime(truth)));
        def frgg-provenance-current?(provenance) = if (!((Comparable) frgg-tagged?(provenance, 7, "glass-provenance-v2") == 1)) then 0 else if (!((String) frgg-provenance-evidence(provenance) == "physical-live")) then 0 else if (!((Comparable) frgg-text?(frgg-provenance-publisher(provenance)) == 1)) then 0 else if (!((Comparable) frgg-lifetime-current?(frgg-provenance-lifetime-truth(provenance)) == 1)) then 0 else if (!((Comparable) frgg-truth-measured?(frgg-provenance-sequence-truth(provenance)) == 1)) then 0 else if (frgg-truth-value(frgg-provenance-sequence-truth(provenance)) < 0) then 0 else if (!((Comparable) frgg-truth-measured?(frgg-provenance-observed-truth(provenance)) == 1)) then 0 else if (frgg-truth-value(frgg-provenance-observed-truth(provenance)) < 0) then 0 else if (!((Comparable) frgg-text?(provenance[6]) == 1)) then 0 else 1;
        def frgg-signal-current?(signal, freshFrames) = if (!((Comparable) frgg-tagged?(signal, 4, "form-resource-signal-v1") == 1)) then 0 else if (!((Comparable) frgg-truth-measured?(frgg-signal-truth(signal)) == 1)) then 0 else if (frgg-truth-value(frgg-signal-truth(signal)) < 0) then 0 else if (frgg-signal-age(signal) < 0) then 0 else if (frgg-signal-age(signal) > freshFrames) then 0 else frgg-provenance-current?(frgg-signal-provenance(signal));
        def frgg-signals-current?(signals, freshFrames) = if ((Comparable) len(signals) == 0) then 1 else if ((Comparable) frgg-signal-current?(head(signals), freshFrames) == 1) then frgg-signals-current?(tail(signals), freshFrames) else 0;
        def frgg-resource-current?(resource, freshFrames) = if (!((Comparable) frgg-tagged?(resource, 5, "form-resource-observation-v1") == 1)) then 0 else frgg-signals-current?([resource[2], resource[3], resource[4]], freshFrames);
        def frgg-sample-current?(policy, sample) = if (!((Comparable) frgg-tagged?(policy, 17, "form-resource-policy-v1") == 1)) then 0 else if (!((Comparable) frgg-tagged?(sample, 11, "form-resource-sample-v1") == 1)) then 0 else if (!((Comparable) frgg-resource-current?(sample[2], frgg-policy-fresh-frames(policy)) == 1)) then 0 else if (!((Comparable) frgg-resource-current?(sample[3], frgg-policy-fresh-frames(policy)) == 1)) then 0 else if (!((Comparable) frgg-resource-current?(sample[4], frgg-policy-fresh-frames(policy)) == 1)) then 0 else frgg-signals-current?([sample[1], sample[5], sample[6], sample[7], sample[8], sample[9], sample[10]], frgg-policy-fresh-frames(policy));

        def frgg-decision-reason(decision) = decision[1];
        def frgg-decision-target(decision, index) = decision[index];
        def frgg-decision-grant(decision, index) = decision[index];
        def frgg-decision-metal-submit(decision) = decision[9];
        def frgg-decision-permit(decision) = decision[11];
        def frgg-zero-grants?(decision) = if (!((Comparable) decision[6] == 0)) then 0 else if (!((Comparable) decision[7] == 0)) then 0 else if (!((Comparable) decision[8] == 0)) then 0 else ((Comparable) decision[9] == 0);
        def frgg-decision-reason-known?(reason) = if ((String) reason == "additive-recovery") then 1 else if ((String) reason == "half-backoff") then 1 else if ((String) reason == "stop-backoff") then 1 else if ((String) reason == "typed-signal-not-current") then 1 else 0;
        def frgg-decision-safe?(policy, sample, decision) = if (!((Comparable) frgg-tagged?(decision, 13, "form-resource-decision-v1") == 1)) then 0 else if (!((Comparable) frgg-decision-reason-known?(frgg-decision-reason(decision)) == 1)) then 0 else if ((Comparable) frgg-sample-current?(policy, sample) == 1) then 1 else if (!((String) frgg-decision-reason(decision) == "typed-signal-not-current")) then 0 else frgg-zero-grants?(decision);

        def frgg-resource-row(id, plane, grant, target, epoch, safe) {
            let measured = if (((Comparable) safe == 1) && (target > 0)) then 1 else 0;
            fgtm-sample(id, fgtm-absent(), "governor-grant", plane, FRGGPublisher(), "scheduler", if ((Comparable) measured == 1) then "target-utilization" else "target-unavailable", frgg-field(grant, measured), frgg-field(target, measured), if (!((Comparable) measured == 1)) then "unknown" else if (grant > 0) then "active" else "idle", frgg-field(epoch, measured), frgg-field(epoch, measured), if ((Comparable) measured == 1) then fgtm-present(frgg-utilization(grant, target)) else fgtm-absent(), fgtm-absent(), "never", "derived-window", if ((Comparable) measured == 1) then "governor.decision" else "governor.fail-closed", ["governor", "health", "memory", plane]);
        }
        def frgg-pressure-signal(sample) = if ((Comparable) frgg-tagged?(sample, 11, "form-resource-sample-v1") == 1) then sample[7] else [];
        def frgg-pressure-kind(signal) = if (!((Comparable) frgg-tagged?(signal, 4, "form-resource-signal-v1") == 1)) then "invalid" else frgg-safe-label(frgg-truth-kind(frgg-signal-truth(signal)), "invalid");
        def frgg-pressure-purpose(signal, current, critical) = if (!((Comparable) current == 1)) then str_concat("pressure-", frgg-pressure-kind(signal)) else if (frgg-truth-value(frgg-signal-truth(signal)) >= critical) then "pressure-critical" else if (frgg-truth-value(frgg-signal-truth(signal)) > 0) then "pressure-warning" else "pressure-zero";
        def frgg-pressure-row(policy, sample) {
            let signal = frgg-pressure-signal(sample);
            let current = frgg-signal-current?(signal, frgg-policy-fresh-frames(policy));
            let critical = frgg-policy-pressure-critical(policy);
            let value = if ((Comparable) current == 1) then frgg-truth-value(frgg-signal-truth(signal)) else 0;
            let provenance = if ((Comparable) current == 1) then frgg-signal-provenance(signal) else [];
            let observed = if ((Comparable) current == 1) then frgg-truth-value(frgg-provenance-observed-truth(provenance)) else 0;
            let lifetime = if ((Comparable) current == 1) then frgg-lifetime(frgg-provenance-lifetime-truth(provenance)) else [];
            fgtm-sample("governor.pressure.memory", fgtm-absent(), "pressure", "unified", if ((Comparable) current == 1) then frgg-safe-label(frgg-provenance-publisher(provenance), FRGGPublisher()) else FRGGPublisher(), "scheduler", frgg-pressure-purpose(signal, current, critical), frgg-field(value, current), frgg-field(critical, current), if (!((Comparable) current == 1)) then "unknown" else if (value > 0) then "active" else "idle", frgg-field(observed, current), if ((Comparable) current == 1) then fgtm-present(frgg-lifetime-started(lifetime)) else fgtm-absent(), if ((Comparable) current == 1) then fgtm-present(frgg-utilization(value, critical)) else fgtm-absent(), if ((Comparable) current == 1) then fgtm-present(frgg-lifetime-pid(lifetime)) else fgtm-absent(), "never", if ((Comparable) current == 1) then "physical-live" else "derived-window", if ((Comparable) current == 1) then "governor.pressure" else "governor.fail-closed", ["governor", "health", "memory", "pressure"]);
        }

        def frgg-permit-shape?(permit) = frgg-tagged?(permit, 9, "form-resource-metal-permit-v2");
        def frgg-permit-id(permit) = permit[1];
        def frgg-permit-tick(permit) = permit[2];
        def frgg-permit-status(permit) = permit[3];
        def frgg-permit-provenance(permit) = permit[4];
        def frgg-permit-handle(permit) = permit[5];
        def frgg-permit-submit-provenance(permit) = permit[6];
        def frgg-permit-slot-path(permit) = permit[7];
        def frgg-permit-owner-text(permit) = permit[8];
        def frgg-metal-owner-text(permit) {
            let provenance = frgg-permit-provenance(permit);
            let lifetime = frgg-lifetime(frgg-provenance-lifetime-truth(provenance));
            let permitLine = str_concat("schema=form-resource-metal-owner-v2\npermit=", frgg-permit-id(permit));
            let publisherLine = str_concat(permitLine, str_concat("\npublisher=", frgg-provenance-publisher(provenance)));
            let pidLine = str_concat(publisherLine, str_concat("\npid=", int_to_str(frgg-lifetime-pid(lifetime))));
            let startedLine = str_concat(pidLine, str_concat("\nstarted=", int_to_str(frgg-lifetime-started(lifetime))));
            let incarnationLine = str_concat(startedLine, str_concat("\nincarnation=", frgg-lifetime-incarnation(lifetime)));
            let sequenceLine = str_concat(incarnationLine, str_concat("\nsequence=", int_to_str(frgg-truth-value(frgg-provenance-sequence-truth(provenance)))));
            let observedLine = str_concat(sequenceLine, str_concat("\nobserved=", int_to_str(frgg-truth-value(frgg-provenance-observed-truth(provenance)))));
            str_concat(observedLine, str_concat("\nsource=", str_concat(provenance[6], "\n")));
        }
        def frgg-permit-coordinate(provenance, coordinate) = if (!((Comparable) frgg-provenance-current?(provenance) == 1)) then 0 else frgg-truth-value(if ((String) coordinate == "sequence") then frgg-provenance-sequence-truth(provenance) else frgg-provenance-observed-truth(provenance));
        def frgg-provenance-same-lifetime?(left, right) = if (!(((Comparable) frgg-provenance-current?(left) == 1) && ((Comparable) frgg-provenance-current?(right) == 1))) then 0 else if (!((String) frgg-provenance-publisher(left) == frgg-provenance-publisher(right))) then 0 else if (!((Comparable) frgg-lifetime-pid(frgg-lifetime(frgg-provenance-lifetime-truth(left))) == frgg-lifetime-pid(frgg-lifetime(frgg-provenance-lifetime-truth(right))))) then 0 else if (!((Comparable) frgg-lifetime-started(frgg-lifetime(frgg-provenance-lifetime-truth(left))) == frgg-lifetime-started(frgg-lifetime(frgg-provenance-lifetime-truth(right))))) then 0 else ((String) frgg-lifetime-incarnation(frgg-lifetime(frgg-provenance-lifetime-truth(left))) == frgg-lifetime-incarnation(frgg-lifetime(frgg-provenance-lifetime-truth(right))));
        def frgg-provenance-exact?(left, right) = if (!((Comparable) frgg-provenance-same-lifetime?(left, right) == 1)) then 0 else if (!((Comparable) frgg-permit-coordinate(left, "sequence") == frgg-permit-coordinate(right, "sequence"))) then 0 else if (!((Comparable) frgg-permit-coordinate(left, "observed") == frgg-permit-coordinate(right, "observed"))) then 0 else ((String) left[6] == right[6]);
        def frgg-provenance-advances?(prior, next) = if (!((Comparable) frgg-provenance-same-lifetime?(prior, next) == 1)) then 0 else if (frgg-permit-coordinate(next, "sequence") <= frgg-permit-coordinate(prior, "sequence")) then 0 else if (frgg-permit-coordinate(next, "observed") <= frgg-permit-coordinate(prior, "observed")) then 0 else 1;
        def frgg-permit-valid?(permit) = if (!((Comparable) frgg-permit-shape?(permit) == 1)) then 0 else if (!((Comparable) frgg-text?(frgg-permit-id(permit)) == 1)) then 0 else if (frgg-permit-tick(permit) < 0) then 0 else if (!((Comparable) frgg-provenance-current?(frgg-permit-provenance(permit)) == 1)) then 0 else if ((String) frgg-permit-status(permit) == "open") then if (((Comparable) frgg-permit-handle(permit) == 0) && (((Comparable) str_len(frgg-permit-slot-path(permit)) == 0) && ((Comparable) str_len(frgg-permit-owner-text(permit)) == 0))) then 1 else 0 else if ((String) frgg-permit-status(permit) == "reserved") then if (((Comparable) frgg-permit-handle(permit) == 0) && (((String) frgg-permit-slot-path(permit) == frg-metal-slot-path()) && ((String) frgg-permit-owner-text(permit) == frgg-metal-owner-text(permit)))) then 1 else 0 else if ((String) frgg-permit-status(permit) == "submitted") then if ((frgg-permit-handle(permit) > 0) && (((String) frgg-permit-slot-path(permit) == frg-metal-slot-path()) && (((String) frgg-permit-owner-text(permit) == frgg-metal-owner-text(permit)) && ((Comparable) frgg-provenance-advances?(frgg-permit-provenance(permit), frgg-permit-submit-provenance(permit)) == 1)))) then 1 else 0 else 0;
        def frgg-permit-same-base?(left, right) = if (!(((Comparable) frgg-permit-valid?(left) == 1) && ((Comparable) frgg-permit-valid?(right) == 1))) then 0 else if (!((String) frgg-permit-id(left) == frgg-permit-id(right))) then 0 else frgg-provenance-exact?(frgg-permit-provenance(left), frgg-permit-provenance(right));

        def frgg-state-holds-permit?(state, permit) = if (!((Comparable) frgg-tagged?(state, 7, "form-resource-governor-state-v1") == 1)) then 0 else ((Value) state[6] == permit);
        def frgg-slot-result-valid?(result, permit) = if (!((Comparable) frgg-tagged?(result, 6, "form-resource-metal-slot-result-v2") == 1)) then 0 else if (!((String) result[1] == "acquired")) then 0 else if (!((Comparable) result[4] == 1)) then 0 else if (!((Comparable) result[5] == str_len(frgg-permit-owner-text(permit)))) then 0 else ((Value) result[3] == permit);
        def frgg-consume-attempted?(result) = frgg-tagged?(result, 6, "form-resource-permit-consume-v2");
        def frgg-consume-admitted?(result, decision) = if (!((Comparable) frgg-tagged?(result, 6, "form-resource-permit-consume-v2") == 1)) then 0 else if (!((String) result[1] == "admitted")) then 0 else if (!((Comparable) frgg-permit-valid?(result[3]) == 1)) then 0 else if (!((String) frgg-permit-status(result[3]) == "reserved")) then 0 else if (!((Comparable) frgg-permit-same-base?(result[3], frgg-decision-permit(decision)) == 1)) then 0 else if (!((Comparable) frgg-state-holds-permit?(result[4], result[3]) == 1)) then 0 else frgg-slot-result-valid?(result[5], result[3]);
        def frgg-submit-attempted?(result) = frgg-tagged?(result, 6, "form-resource-metal-submit-bind-v2");
        def frgg-quantum-id(quantum) = quantum[1];
        def frgg-quantum-valid?(quantum) = if (!((Comparable) frgg-tagged?(quantum, 6, "form-resource-quantum-v1") == 1)) then 0 else frgg-text?(frgg-quantum-id(quantum));
        def frgg-submit-receipt-valid?(receipt) = if (!((Comparable) frgg-tagged?(receipt, 6, "form-resource-metal-submit-receipt-v2") == 1)) then 0 else if (!((String) receipt[1] == "submitted")) then 0 else if (receipt[2] <= 0) then 0 else if (!((Comparable) frgg-text?(receipt[3]) == 1)) then 0 else if (!((Comparable) frgg-text?(receipt[4]) == 1)) then 0 else frgg-provenance-current?(receipt[5]);
        def frgg-submit-admitted?(result, decision, consumeResult, quantum) {
            let admitted = if (!((Comparable) frgg-tagged?(result, 6, "form-resource-metal-submit-bind-v2") == 1)) then 0 else if ((String) result[1] == "admitted") then 1 else 0;
            let permit = if ((Comparable) admitted == 1) then result[3] else [];
            let receipt = if ((Comparable) admitted == 1) then result[5] else [];
            let reserved = if ((Comparable) frgg-consume-admitted?(consumeResult, decision) == 1) then consumeResult[3] else [];
            if (!((Comparable) admitted == 1)) then 0 else if (!((Comparable) frgg-consume-admitted?(consumeResult, decision) == 1)) then 0 else if (!((Comparable) frgg-quantum-valid?(quantum) == 1)) then 0 else if (!((Comparable) frgg-permit-valid?(permit) == 1)) then 0 else if (!((String) frgg-permit-status(permit) == "submitted")) then 0 else if (!((Comparable) frgg-submit-receipt-valid?(receipt) == 1)) then 0 else if (!((Comparable) frgg-permit-same-base?(reserved, permit) == 1)) then 0 else if (!((Comparable) frgg-state-holds-permit?(result[4], permit) == 1)) then 0 else if (!((Comparable) frgg-permit-handle(permit) == receipt[2])) then 0 else if (!((String) frgg-quantum-id(quantum) == receipt[3])) then 0 else if (!((String) frgg-permit-id(permit) == receipt[4])) then 0 else if (!((Comparable) frgg-provenance-exact?(frgg-permit-submit-provenance(permit), receipt[5]) == 1)) then 0 else 1;
        }
        def frgg-selected-permit(decision, consumeResult, submitBind, quantum) = if ((Comparable) frgg-submit-admitted?(submitBind, decision, consumeResult, quantum) == 1) then submitBind[3] else if ((Comparable) frgg-consume-admitted?(consumeResult, decision) == 1) then consumeResult[3] else if ((Comparable) frgg-permit-valid?(frgg-decision-permit(decision)) == 1) then frgg-decision-permit(decision) else [];
        def frgg-permit-lifecycle(status) = if ((String) status == "submitted") then "active" else if ((String) status == "reserved") then "ready" else if ((String) status == "open") then "ready" else "unknown";
        def frgg-permit-purpose(status) = if ((String) status == "submitted") then "permit-submitted-correlated" else if ((String) status == "reserved") then "permit-reserved" else if ((String) status == "open") then "permit-open" else "permit-none";
        def frgg-permit-heat(status) = if ((String) status == "submitted") then 1000 else if ((String) status == "reserved") then 500 else if ((String) status == "open") then 250 else 0;
        def frgg-permit-row(permit) {
            let present = frgg-permit-valid?(permit);
            let status = if ((Comparable) present == 1) then frgg-permit-status(permit) else "none";
            let provenance = if ((Comparable) present == 1) then frgg-permit-provenance(permit) else [];
            let current = if ((Comparable) present == 1) then frgg-provenance-current?(provenance) else 0;
            let lifetime = if ((Comparable) current == 1) then frgg-lifetime(frgg-provenance-lifetime-truth(provenance)) else [];
            let submitted = if (((Comparable) present == 1) && ((String) status == "submitted")) then 1 else 0;
            let submitProvenance = if ((Comparable) submitted == 1) then frgg-permit-submit-provenance(permit) else [];
            fgtm-sample(str_concat("governor.permit.", status), fgtm-absent(), "permit", "metal", if ((Comparable) current == 1) then frgg-safe-label(frgg-provenance-publisher(provenance), FRGGPublisher()) else FRGGPublisher(), "scheduler", frgg-permit-purpose(status), if ((Comparable) current == 1) then fgtm-present(frgg-lifetime-pid(lifetime)) else fgtm-absent(), if ((Comparable) current == 1) then fgtm-present(frgg-lifetime-started(lifetime)) else fgtm-absent(), frgg-permit-lifecycle(status), if ((Comparable) current == 1) then fgtm-present(frgg-permit-coordinate(provenance, "observed")) else fgtm-absent(), if ((Comparable) submitted == 1) then fgtm-present(frgg-permit-coordinate(submitProvenance, "observed")) else fgtm-absent(), if ((Comparable) present == 1) then fgtm-present(frgg-permit-heat(status)) else fgtm-absent(), if ((Comparable) submitted == 1) then fgtm-present(frgg-permit-handle(permit)) else fgtm-absent(), "never", "derived-window", if ((Comparable) current == 1) then "governor.permit" else "governor.fail-closed", ["governor", "metal", "admission", "protocol"]);
        }

        // A governor that could not read its signals granted nothing because it
        // never got to ask -- the same not-knowing the pressure row beside this
        // one already calls "unknown". Only a governor that read the frame and
        // then closed the door has refused. Both once read "failed", so an idle
        // host looked like a body declining every quantum it was never offered.
        def frgg-admission-unmeasured?(decision) = ((String) frgg-decision-reason(decision) == "typed-signal-not-current");
        def frgg-admission-lifecycle(safe, decision, consumeResult, submitBind, quantum) = if (!((Comparable) safe == 1)) then "failed" else if ((Comparable) frgg-submit-admitted?(submitBind, decision, consumeResult, quantum) == 1) then "active" else if ((Comparable) frgg-submit-attempted?(submitBind) == 1) then "failed" else if ((Comparable) frgg-consume-admitted?(consumeResult, decision) == 1) then "ready" else if ((Comparable) frgg-consume-attempted?(consumeResult) == 1) then "failed" else if ((Comparable) frgg-decision-metal-submit(decision) == 1) then "ready" else if ((Comparable) frgg-admission-unmeasured?(decision) == 1) then "unknown" else "failed";
        def frgg-admission-purpose(safe, decision, consumeResult, submitBind, quantum) = if (!((Comparable) safe == 1)) then "adapter-input-invalid" else if ((Comparable) frgg-submit-admitted?(submitBind, decision, consumeResult, quantum) == 1) then "admission-submitted-correlated" else if ((Comparable) frgg-submit-attempted?(submitBind) == 1) then "admission-submit-refused" else if ((Comparable) frgg-consume-admitted?(consumeResult, decision) == 1) then "admission-reserved" else if ((Comparable) frgg-consume-attempted?(consumeResult) == 1) then "admission-reserve-refused" else if ((Comparable) frgg-decision-metal-submit(decision) == 1) then "admission-offered" else if ((Comparable) frgg-admission-unmeasured?(decision) == 1) then "admission-unmeasured" else "admission-refused";
        def frgg-admission-row(safe, decision, consumeResult, submitBind, quantum, permit, epoch) {
