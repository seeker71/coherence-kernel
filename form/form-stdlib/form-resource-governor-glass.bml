//////////////////////////////////////////////////////////////////////
//
// form-resource-governor-glass.bml — bounded governor telemetry adapter.
//
// It deliberately reads stable governor value shapes instead of importing
// the large governor implementation.  The governor remains the sole policy
// owner; this shard only validates and projects its result into Glass.
//
// Authority: form-stdlib/bml/form-resource-governor-glass.bml
// preludes: form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/form-resource-governor.bml form/form-stdlib/hearth.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormResourceGovernorGlassAuthority {
        field FRGGAuthorityPath = "form/form-stdlib/bml/form-resource-governor-glass.bml";
        field FRGGAuthorityKind = "high-bml-interface-class-const";
    }

    class FormResourceGovernorGlass {
        field FRGGSchema = "form-resource-governor-glass-v1";
        field FRGGPublisher = "resource.governor";
        ref frgg-authority = FormResourceGovernorGlassAuthority;
        thought frgg-law = list("physical-unknown-fails-closed", "grant-and-target-stay-distinct", "permit-coordinates-survive-projection", "release-is-not-pressure", "publication-uses-existing-membrane");

        def frgg-tagged?(value, count, tag) = if nothing?(value) then 0 else if not(eq(len(value), count)) then 0 else str_eq(head(value), tag);
        def frgg-text?(value) = if nothing?(value) then 0 else gt(str_len(value), 0);
        def frgg-safe-label(value, fallback) = if eq(frgg-text?(value), 0) then fallback else if eq(fgtm-label?(value), 1) then value else fallback;
        def frgg-clamp-heat(value) = if lt(value, 0) then 0 else if gt(value, 1000) then 1000 else value;
        def frgg-utilization(grant, target) = if le(target, 0) then 0 else frgg-clamp-heat(div(mul(grant, 1000), target));
        def frgg-field(value, present) = if eq(present, 1) then fgtm-present(value) else fgtm-absent();

        // These readers mirror committed governor/v2 shapes.  They do not
        // recreate policy; they keep this adapter a small independently
        // cacheable shard rather than flattening the governor into Glass.
        def frgg-policy-fresh-frames(policy) = nth(policy, 7);
        def frgg-policy-pressure-critical(policy) = nth(policy, 11);
        def frgg-signal-truth(signal) = nth(signal, 1);
        def frgg-signal-age(signal) = nth(signal, 2);
        def frgg-signal-provenance(signal) = nth(signal, 3);
        def frgg-truth-kind(truth) = nth(truth, 1);
        def frgg-truth-value(truth) = nth(truth, 2);
        def frgg-provenance-evidence(provenance) = nth(provenance, 1);
        def frgg-provenance-publisher(provenance) = nth(provenance, 2);
        def frgg-provenance-lifetime-truth(provenance) = nth(provenance, 3);
        def frgg-provenance-sequence-truth(provenance) = nth(provenance, 4);
        def frgg-provenance-observed-truth(provenance) = nth(provenance, 5);
        def frgg-lifetime(truth) = nth(truth, 2);
        def frgg-lifetime-pid(lifetime) = nth(lifetime, 1);
        def frgg-lifetime-started(lifetime) = nth(lifetime, 2);
        def frgg-lifetime-incarnation(lifetime) = nth(lifetime, 3);
        def frgg-truth-measured?(truth) = if not(eq(frgg-tagged?(truth, 9, "glass-truth-v2"), 1)) then 0 else if not(str_eq(frgg-truth-kind(truth), "measured")) then 0 else if nothing?(frgg-truth-value(truth)) then 0 else if not(nothing?(nth(truth, 3))) then 0 else if not(nothing?(nth(truth, 4))) then 0 else if not(nothing?(nth(truth, 5))) then 0 else if not(nothing?(nth(truth, 6))) then 0 else if not(nothing?(nth(truth, 7))) then 0 else if not(nothing?(nth(truth, 8))) then 0 else 1;
        def frgg-lifetime-current?(truth) = if not(eq(frgg-truth-measured?(truth), 1)) then 0 else if not(eq(frgg-tagged?(frgg-lifetime(truth), 4, "glass-process-lifetime-v2"), 1)) then 0 else if le(frgg-lifetime-pid(frgg-lifetime(truth)), 0) then 0 else if lt(frgg-lifetime-started(frgg-lifetime(truth)), 0) then 0 else frgg-text?(frgg-lifetime-incarnation(frgg-lifetime(truth)));
        def frgg-provenance-current?(provenance) = if not(eq(frgg-tagged?(provenance, 7, "glass-provenance-v2"), 1)) then 0 else if not(str_eq(frgg-provenance-evidence(provenance), "physical-live")) then 0 else if not(eq(frgg-text?(frgg-provenance-publisher(provenance)), 1)) then 0 else if not(eq(frgg-lifetime-current?(frgg-provenance-lifetime-truth(provenance)), 1)) then 0 else if not(eq(frgg-truth-measured?(frgg-provenance-sequence-truth(provenance)), 1)) then 0 else if lt(frgg-truth-value(frgg-provenance-sequence-truth(provenance)), 0) then 0 else if not(eq(frgg-truth-measured?(frgg-provenance-observed-truth(provenance)), 1)) then 0 else if lt(frgg-truth-value(frgg-provenance-observed-truth(provenance)), 0) then 0 else if not(eq(frgg-text?(nth(provenance, 6)), 1)) then 0 else 1;
        def frgg-signal-current?(signal, freshFrames) = if not(eq(frgg-tagged?(signal, 4, "form-resource-signal-v1"), 1)) then 0 else if not(eq(frgg-truth-measured?(frgg-signal-truth(signal)), 1)) then 0 else if lt(frgg-truth-value(frgg-signal-truth(signal)), 0) then 0 else if lt(frgg-signal-age(signal), 0) then 0 else if gt(frgg-signal-age(signal), freshFrames) then 0 else frgg-provenance-current?(frgg-signal-provenance(signal));
        def frgg-signals-current?(signals, freshFrames) = if eq(len(signals), 0) then 1 else if eq(frgg-signal-current?(head(signals), freshFrames), 1) then frgg-signals-current?(tail(signals), freshFrames) else 0;
        def frgg-resource-current?(resource, freshFrames) = if not(eq(frgg-tagged?(resource, 5, "form-resource-observation-v1"), 1)) then 0 else frgg-signals-current?(list(nth(resource, 2), nth(resource, 3), nth(resource, 4)), freshFrames);
        def frgg-sample-current?(policy, sample) = if not(eq(frgg-tagged?(policy, 17, "form-resource-policy-v1"), 1)) then 0 else if not(eq(frgg-tagged?(sample, 11, "form-resource-sample-v1"), 1)) then 0 else if not(eq(frgg-resource-current?(nth(sample, 2), frgg-policy-fresh-frames(policy)), 1)) then 0 else if not(eq(frgg-resource-current?(nth(sample, 3), frgg-policy-fresh-frames(policy)), 1)) then 0 else if not(eq(frgg-resource-current?(nth(sample, 4), frgg-policy-fresh-frames(policy)), 1)) then 0 else frgg-signals-current?(list(nth(sample, 1), nth(sample, 5), nth(sample, 6), nth(sample, 7), nth(sample, 8), nth(sample, 9), nth(sample, 10)), frgg-policy-fresh-frames(policy));

        def frgg-decision-reason(decision) = nth(decision, 1);
        def frgg-decision-target(decision, index) = nth(decision, index);
        def frgg-decision-grant(decision, index) = nth(decision, index);
        def frgg-decision-metal-submit(decision) = nth(decision, 9);
        def frgg-decision-permit(decision) = nth(decision, 11);
        def frgg-zero-grants?(decision) = if not(eq(nth(decision, 6), 0)) then 0 else if not(eq(nth(decision, 7), 0)) then 0 else if not(eq(nth(decision, 8), 0)) then 0 else eq(nth(decision, 9), 0);
        def frgg-decision-reason-known?(reason) = if str_eq(reason, "additive-recovery") then 1 else if str_eq(reason, "half-backoff") then 1 else if str_eq(reason, "stop-backoff") then 1 else if str_eq(reason, "typed-signal-not-current") then 1 else 0;
        def frgg-decision-safe?(policy, sample, decision) = if not(eq(frgg-tagged?(decision, 13, "form-resource-decision-v1"), 1)) then 0 else if not(eq(frgg-decision-reason-known?(frgg-decision-reason(decision)), 1)) then 0 else if eq(frgg-sample-current?(policy, sample), 1) then 1 else if not(str_eq(frgg-decision-reason(decision), "typed-signal-not-current")) then 0 else frgg-zero-grants?(decision);

        def frgg-resource-row(id, plane, grant, target, epoch, safe) {
            let measured = if and(eq(safe, 1), gt(target, 0)) then 1 else 0;
            fgtm-sample(id, fgtm-absent(), "governor-grant", plane, FRGGPublisher(), "scheduler", if eq(measured, 1) then "target-utilization" else "target-unavailable", frgg-field(grant, measured), frgg-field(target, measured), if not(eq(measured, 1)) then "unknown" else if gt(grant, 0) then "active" else "idle", frgg-field(epoch, measured), frgg-field(epoch, measured), if eq(measured, 1) then fgtm-present(frgg-utilization(grant, target)) else fgtm-absent(), fgtm-absent(), "never", "derived-window", if eq(measured, 1) then "governor.decision" else "governor.fail-closed", list("governor", "health", "memory", plane));
        }
        def frgg-pressure-signal(sample) = if eq(frgg-tagged?(sample, 11, "form-resource-sample-v1"), 1) then nth(sample, 7) else list();
        def frgg-pressure-kind(signal) = if not(eq(frgg-tagged?(signal, 4, "form-resource-signal-v1"), 1)) then "invalid" else frgg-safe-label(frgg-truth-kind(frgg-signal-truth(signal)), "invalid");
        def frgg-pressure-purpose(signal, current, critical) = if not(eq(current, 1)) then str_concat("pressure-", frgg-pressure-kind(signal)) else if ge(frgg-truth-value(frgg-signal-truth(signal)), critical) then "pressure-critical" else if gt(frgg-truth-value(frgg-signal-truth(signal)), 0) then "pressure-warning" else "pressure-zero";
        def frgg-pressure-row(policy, sample) {
            let signal = frgg-pressure-signal(sample);
            let current = frgg-signal-current?(signal, frgg-policy-fresh-frames(policy));
            let critical = frgg-policy-pressure-critical(policy);
            let value = if eq(current, 1) then frgg-truth-value(frgg-signal-truth(signal)) else 0;
            let provenance = if eq(current, 1) then frgg-signal-provenance(signal) else list();
            let observed = if eq(current, 1) then frgg-truth-value(frgg-provenance-observed-truth(provenance)) else 0;
            let lifetime = if eq(current, 1) then frgg-lifetime(frgg-provenance-lifetime-truth(provenance)) else list();
            fgtm-sample("governor.pressure.memory", fgtm-absent(), "pressure", "unified", if eq(current, 1) then frgg-safe-label(frgg-provenance-publisher(provenance), FRGGPublisher()) else FRGGPublisher(), "scheduler", frgg-pressure-purpose(signal, current, critical), frgg-field(value, current), frgg-field(critical, current), if not(eq(current, 1)) then "unknown" else if gt(value, 0) then "active" else "idle", frgg-field(observed, current), if eq(current, 1) then fgtm-present(frgg-lifetime-started(lifetime)) else fgtm-absent(), if eq(current, 1) then fgtm-present(frgg-utilization(value, critical)) else fgtm-absent(), if eq(current, 1) then fgtm-present(frgg-lifetime-pid(lifetime)) else fgtm-absent(), "never", if eq(current, 1) then "physical-live" else "derived-window", if eq(current, 1) then "governor.pressure" else "governor.fail-closed", list("governor", "health", "memory", "pressure"));
        }

        def frgg-permit-shape?(permit) = frgg-tagged?(permit, 9, "form-resource-metal-permit-v2");
        def frgg-permit-id(permit) = nth(permit, 1);
        def frgg-permit-tick(permit) = nth(permit, 2);
        def frgg-permit-status(permit) = nth(permit, 3);
        def frgg-permit-provenance(permit) = nth(permit, 4);
        def frgg-permit-handle(permit) = nth(permit, 5);
        def frgg-permit-submit-provenance(permit) = nth(permit, 6);
        def frgg-permit-slot-path(permit) = nth(permit, 7);
        def frgg-permit-owner-text(permit) = nth(permit, 8);
        def frgg-metal-owner-text(permit) {
            let provenance = frgg-permit-provenance(permit);
            let lifetime = frgg-lifetime(frgg-provenance-lifetime-truth(provenance));
            let permitLine = str_concat("schema=form-resource-metal-owner-v2\npermit=", frgg-permit-id(permit));
            let publisherLine = str_concat(permitLine, str_concat("\npublisher=", frgg-provenance-publisher(provenance)));
            let pidLine = str_concat(publisherLine, str_concat("\npid=", int_to_str(frgg-lifetime-pid(lifetime))));
            let startedLine = str_concat(pidLine, str_concat("\nstarted=", int_to_str(frgg-lifetime-started(lifetime))));
            let incarnationLine = str_concat(startedLine, str_concat("\nincarnation=", frgg-lifetime-incarnation(lifetime)));
            let sequenceLine = str_concat(incarnationLine, str_concat("\nsequence=", int_to_str(frgg-truth-value(frgg-provenance-sequence-truth(provenance)))));
            let observedLine = str_concat(sequenceLine, str_concat("\nobserved=", int_to_str(frgg-truth-value(frgg-provenance-observed-truth(provenance)))));
            str_concat(observedLine, str_concat("\nsource=", str_concat(nth(provenance, 6), "\n")));
        }
        def frgg-permit-coordinate(provenance, coordinate) = if not(eq(frgg-provenance-current?(provenance), 1)) then 0 else frgg-truth-value(if str_eq(coordinate, "sequence") then frgg-provenance-sequence-truth(provenance) else frgg-provenance-observed-truth(provenance));
        def frgg-provenance-same-lifetime?(left, right) = if not(and(eq(frgg-provenance-current?(left), 1), eq(frgg-provenance-current?(right), 1))) then 0 else if not(str_eq(frgg-provenance-publisher(left), frgg-provenance-publisher(right))) then 0 else if not(eq(frgg-lifetime-pid(frgg-lifetime(frgg-provenance-lifetime-truth(left))), frgg-lifetime-pid(frgg-lifetime(frgg-provenance-lifetime-truth(right))))) then 0 else if not(eq(frgg-lifetime-started(frgg-lifetime(frgg-provenance-lifetime-truth(left))), frgg-lifetime-started(frgg-lifetime(frgg-provenance-lifetime-truth(right))))) then 0 else str_eq(frgg-lifetime-incarnation(frgg-lifetime(frgg-provenance-lifetime-truth(left))), frgg-lifetime-incarnation(frgg-lifetime(frgg-provenance-lifetime-truth(right))));
        def frgg-provenance-exact?(left, right) = if not(eq(frgg-provenance-same-lifetime?(left, right), 1)) then 0 else if not(eq(frgg-permit-coordinate(left, "sequence"), frgg-permit-coordinate(right, "sequence"))) then 0 else if not(eq(frgg-permit-coordinate(left, "observed"), frgg-permit-coordinate(right, "observed"))) then 0 else str_eq(nth(left, 6), nth(right, 6));
        def frgg-provenance-advances?(prior, next) = if not(eq(frgg-provenance-same-lifetime?(prior, next), 1)) then 0 else if le(frgg-permit-coordinate(next, "sequence"), frgg-permit-coordinate(prior, "sequence")) then 0 else if le(frgg-permit-coordinate(next, "observed"), frgg-permit-coordinate(prior, "observed")) then 0 else 1;
        def frgg-permit-valid?(permit) = if not(eq(frgg-permit-shape?(permit), 1)) then 0 else if not(eq(frgg-text?(frgg-permit-id(permit)), 1)) then 0 else if lt(frgg-permit-tick(permit), 0) then 0 else if not(eq(frgg-provenance-current?(frgg-permit-provenance(permit)), 1)) then 0 else if str_eq(frgg-permit-status(permit), "open") then if and(eq(frgg-permit-handle(permit), 0), and(eq(str_len(frgg-permit-slot-path(permit)), 0), eq(str_len(frgg-permit-owner-text(permit)), 0))) then 1 else 0 else if str_eq(frgg-permit-status(permit), "reserved") then if and(eq(frgg-permit-handle(permit), 0), and(str_eq(frgg-permit-slot-path(permit), frg-metal-slot-path()), str_eq(frgg-permit-owner-text(permit), frgg-metal-owner-text(permit)))) then 1 else 0 else if str_eq(frgg-permit-status(permit), "submitted") then if and(gt(frgg-permit-handle(permit), 0), and(str_eq(frgg-permit-slot-path(permit), frg-metal-slot-path()), and(str_eq(frgg-permit-owner-text(permit), frgg-metal-owner-text(permit)), eq(frgg-provenance-advances?(frgg-permit-provenance(permit), frgg-permit-submit-provenance(permit)), 1)))) then 1 else 0 else 0;
        def frgg-permit-same-base?(left, right) = if not(and(eq(frgg-permit-valid?(left), 1), eq(frgg-permit-valid?(right), 1))) then 0 else if not(str_eq(frgg-permit-id(left), frgg-permit-id(right))) then 0 else frgg-provenance-exact?(frgg-permit-provenance(left), frgg-permit-provenance(right));

        def frgg-state-holds-permit?(state, permit) = if not(eq(frgg-tagged?(state, 7, "form-resource-governor-state-v1"), 1)) then 0 else value_eq(nth(state, 6), permit);
        def frgg-slot-result-valid?(result, permit) = if not(eq(frgg-tagged?(result, 6, "form-resource-metal-slot-result-v2"), 1)) then 0 else if not(str_eq(nth(result, 1), "acquired")) then 0 else if not(eq(nth(result, 4), 1)) then 0 else if not(eq(nth(result, 5), str_len(frgg-permit-owner-text(permit)))) then 0 else value_eq(nth(result, 3), permit);
        def frgg-consume-attempted?(result) = frgg-tagged?(result, 6, "form-resource-permit-consume-v2");
        def frgg-consume-admitted?(result, decision) = if not(eq(frgg-tagged?(result, 6, "form-resource-permit-consume-v2"), 1)) then 0 else if not(str_eq(nth(result, 1), "admitted")) then 0 else if not(eq(frgg-permit-valid?(nth(result, 3)), 1)) then 0 else if not(str_eq(frgg-permit-status(nth(result, 3)), "reserved")) then 0 else if not(eq(frgg-permit-same-base?(nth(result, 3), frgg-decision-permit(decision)), 1)) then 0 else if not(eq(frgg-state-holds-permit?(nth(result, 4), nth(result, 3)), 1)) then 0 else frgg-slot-result-valid?(nth(result, 5), nth(result, 3));
        def frgg-submit-attempted?(result) = frgg-tagged?(result, 6, "form-resource-metal-submit-bind-v2");
        def frgg-quantum-id(quantum) = nth(quantum, 1);
        def frgg-quantum-valid?(quantum) = if not(eq(frgg-tagged?(quantum, 6, "form-resource-quantum-v1"), 1)) then 0 else frgg-text?(frgg-quantum-id(quantum));
        def frgg-submit-receipt-valid?(receipt) = if not(eq(frgg-tagged?(receipt, 6, "form-resource-metal-submit-receipt-v2"), 1)) then 0 else if not(str_eq(nth(receipt, 1), "submitted")) then 0 else if le(nth(receipt, 2), 0) then 0 else if not(eq(frgg-text?(nth(receipt, 3)), 1)) then 0 else if not(eq(frgg-text?(nth(receipt, 4)), 1)) then 0 else frgg-provenance-current?(nth(receipt, 5));
        def frgg-submit-admitted?(result, decision, consumeResult, quantum) {
            let admitted = if not(eq(frgg-tagged?(result, 6, "form-resource-metal-submit-bind-v2"), 1)) then 0 else if str_eq(nth(result, 1), "admitted") then 1 else 0;
            let permit = if eq(admitted, 1) then nth(result, 3) else list();
            let receipt = if eq(admitted, 1) then nth(result, 5) else list();
            let reserved = if eq(frgg-consume-admitted?(consumeResult, decision), 1) then nth(consumeResult, 3) else list();
            if not(eq(admitted, 1)) then 0 else if not(eq(frgg-consume-admitted?(consumeResult, decision), 1)) then 0 else if not(eq(frgg-quantum-valid?(quantum), 1)) then 0 else if not(eq(frgg-permit-valid?(permit), 1)) then 0 else if not(str_eq(frgg-permit-status(permit), "submitted")) then 0 else if not(eq(frgg-submit-receipt-valid?(receipt), 1)) then 0 else if not(eq(frgg-permit-same-base?(reserved, permit), 1)) then 0 else if not(eq(frgg-state-holds-permit?(nth(result, 4), permit), 1)) then 0 else if not(eq(frgg-permit-handle(permit), nth(receipt, 2))) then 0 else if not(str_eq(frgg-quantum-id(quantum), nth(receipt, 3))) then 0 else if not(str_eq(frgg-permit-id(permit), nth(receipt, 4))) then 0 else if not(eq(frgg-provenance-exact?(frgg-permit-submit-provenance(permit), nth(receipt, 5)), 1)) then 0 else 1;
        }
        def frgg-selected-permit(decision, consumeResult, submitBind, quantum) = if eq(frgg-submit-admitted?(submitBind, decision, consumeResult, quantum), 1) then nth(submitBind, 3) else if eq(frgg-consume-admitted?(consumeResult, decision), 1) then nth(consumeResult, 3) else if eq(frgg-permit-valid?(frgg-decision-permit(decision)), 1) then frgg-decision-permit(decision) else list();
        def frgg-permit-lifecycle(status) = if str_eq(status, "submitted") then "active" else if str_eq(status, "reserved") then "ready" else if str_eq(status, "open") then "ready" else "unknown";
        def frgg-permit-purpose(status) = if str_eq(status, "submitted") then "permit-submitted-correlated" else if str_eq(status, "reserved") then "permit-reserved" else if str_eq(status, "open") then "permit-open" else "permit-none";
        def frgg-permit-heat(status) = if str_eq(status, "submitted") then 1000 else if str_eq(status, "reserved") then 500 else if str_eq(status, "open") then 250 else 0;
        def frgg-permit-row(permit) {
            let present = frgg-permit-valid?(permit);
            let status = if eq(present, 1) then frgg-permit-status(permit) else "none";
            let provenance = if eq(present, 1) then frgg-permit-provenance(permit) else list();
            let current = if eq(present, 1) then frgg-provenance-current?(provenance) else 0;
            let lifetime = if eq(current, 1) then frgg-lifetime(frgg-provenance-lifetime-truth(provenance)) else list();
            let submitted = if and(eq(present, 1), str_eq(status, "submitted")) then 1 else 0;
            let submitProvenance = if eq(submitted, 1) then frgg-permit-submit-provenance(permit) else list();
            fgtm-sample(str_concat("governor.permit.", status), fgtm-absent(), "permit", "metal", if eq(current, 1) then frgg-safe-label(frgg-provenance-publisher(provenance), FRGGPublisher()) else FRGGPublisher(), "scheduler", frgg-permit-purpose(status), if eq(current, 1) then fgtm-present(frgg-lifetime-pid(lifetime)) else fgtm-absent(), if eq(current, 1) then fgtm-present(frgg-lifetime-started(lifetime)) else fgtm-absent(), frgg-permit-lifecycle(status), if eq(current, 1) then fgtm-present(frgg-permit-coordinate(provenance, "observed")) else fgtm-absent(), if eq(submitted, 1) then fgtm-present(frgg-permit-coordinate(submitProvenance, "observed")) else fgtm-absent(), if eq(present, 1) then fgtm-present(frgg-permit-heat(status)) else fgtm-absent(), if eq(submitted, 1) then fgtm-present(frgg-permit-handle(permit)) else fgtm-absent(), "never", "derived-window", if eq(current, 1) then "governor.permit" else "governor.fail-closed", list("governor", "metal", "admission", "protocol"));
        }

        def frgg-admission-lifecycle(safe, decision, consumeResult, submitBind, quantum) = if not(eq(safe, 1)) then "failed" else if eq(frgg-submit-admitted?(submitBind, decision, consumeResult, quantum), 1) then "active" else if eq(frgg-submit-attempted?(submitBind), 1) then "failed" else if eq(frgg-consume-admitted?(consumeResult, decision), 1) then "ready" else if eq(frgg-consume-attempted?(consumeResult), 1) then "failed" else if eq(frgg-decision-metal-submit(decision), 1) then "ready" else "failed";
        def frgg-admission-purpose(safe, decision, consumeResult, submitBind, quantum) = if not(eq(safe, 1)) then "adapter-input-invalid" else if eq(frgg-submit-admitted?(submitBind, decision, consumeResult, quantum), 1) then "admission-submitted-correlated" else if eq(frgg-submit-attempted?(submitBind), 1) then "admission-submit-refused" else if eq(frgg-consume-admitted?(consumeResult, decision), 1) then "admission-reserved" else if eq(frgg-consume-attempted?(consumeResult), 1) then "admission-reserve-refused" else if eq(frgg-decision-metal-submit(decision), 1) then "admission-offered" else "admission-refused";
        def frgg-admission-row(safe, decision, consumeResult, submitBind, quantum, permit, epoch) {
            let granted = if not(eq(safe, 1)) then 0 else if eq(frgg-submit-admitted?(submitBind, decision, consumeResult, quantum), 1) then 1 else if eq(frgg-submit-attempted?(submitBind), 1) then 0 else if eq(frgg-consume-admitted?(consumeResult, decision), 1) then 1 else if eq(frgg-consume-attempted?(consumeResult), 1) then 0 else frgg-decision-metal-submit(decision);
            let submitted = if and(eq(frgg-permit-valid?(permit), 1), str_eq(frgg-permit-status(permit), "submitted")) then 1 else 0;
            fgtm-sample("governor.admission.metal", fgtm-absent(), "admission", "metal", FRGGPublisher(), "scheduler", frgg-admission-purpose(safe, decision, consumeResult, submitBind, quantum), frgg-field(granted, safe), frgg-field(1, safe), frgg-admission-lifecycle(safe, decision, consumeResult, submitBind, quantum), frgg-field(epoch, safe), frgg-field(epoch, safe), if eq(safe, 1) then fgtm-present(if eq(granted, 1) then 1000 else 0) else fgtm-absent(), if eq(submitted, 1) then fgtm-present(frgg-permit-handle(permit)) else fgtm-absent(), "never", "derived-window", if eq(safe, 1) then "governor.admission" else "governor.fail-closed", list("governor", "metal", "admission", "query-lane"));
        }
        def frgg-backoff-level(reason) = if str_eq(reason, "stop-backoff") then 1000 else if str_eq(reason, "half-backoff") then 500 else if str_eq(reason, "additive-recovery") then 0 else 1000;
        def frgg-backoff-lifecycle(reason, safe) = if not(eq(safe, 1)) then "failed" else if str_eq(reason, "additive-recovery") then "idle" else "active";
        def frgg-reason-row(reason, safe, epoch) = fgtm-sample(str_concat("governor.reason.", if eq(safe, 1) then frgg-safe-label(reason, "invalid") else "adapter-input-invalid"), fgtm-absent(), "backoff", "form", FRGGPublisher(), "scheduler", if eq(safe, 1) then frgg-safe-label(reason, "invalid") else "adapter-input-invalid", fgtm-present(frgg-backoff-level(if eq(safe, 1) then reason else "invalid")), fgtm-present(1000), frgg-backoff-lifecycle(reason, safe), fgtm-present(epoch), fgtm-present(epoch), fgtm-present(frgg-backoff-level(if eq(safe, 1) then reason else "invalid")), fgtm-absent(), "never", "derived-window", if eq(safe, 1) then "governor.decision" else "governor.fail-closed", list("governor", "health", "backoff", "scheduler"));

        def frgg-release-shape?(plan) = frgg-tagged?(plan, 6, "form-resource-release-plan-v1");
        def frgg-release-status(plan) = if eq(frgg-release-shape?(plan), 1) then nth(plan, 1) else "unobserved";
        def frgg-release-reason(plan) = if eq(frgg-release-shape?(plan), 1) then frgg-safe-label(nth(plan, 5), "invalid") else "release-unobserved";
        def frgg-release-selection-count(plan) = if eq(frgg-release-shape?(plan), 1) then len(nth(plan, 4)) else 0;
        def frgg-release-lifecycle(status) = if str_eq(status, "planned") then "active" else if str_eq(status, "none") then "idle" else if str_eq(status, "unobserved") then "unknown" else "failed";
        def frgg-release-row(plan, epoch) {
            let present = frgg-release-shape?(plan);
            let status = frgg-release-status(plan);
            let required = if eq(present, 1) then nth(plan, 2) else 0;
            let reclaimed = if eq(present, 1) then nth(plan, 3) else 0;
            fgtm-sample(str_concat("governor.release.", status), fgtm-absent(), "release-plan", "unified", FRGGPublisher(), "scheduler", frgg-release-reason(plan), frgg-field(reclaimed, present), frgg-field(required, present), frgg-release-lifecycle(status), frgg-field(epoch, present), frgg-field(epoch, present), if eq(present, 1) then fgtm-present(frgg-utilization(reclaimed, required)) else fgtm-absent(), fgtm-absent(), "pressure-only", "derived-window", if eq(present, 1) then "governor.release" else "governor.fail-closed", list("governor", "memory", "release", "health"));
        }
        def frgg-release-selection-row(plan, epoch) {
            let present = frgg-release-shape?(plan);
            let status = frgg-release-status(plan);
            fgtm-sample("governor.release.selection-count", fgtm-absent(), "release-selection", "unified", FRGGPublisher(), "scheduler", "selected-whole-handles", frgg-field(frgg-release-selection-count(plan), present), fgtm-absent(), frgg-release-lifecycle(status), frgg-field(epoch, present), frgg-field(epoch, present), fgtm-absent(), fgtm-absent(), "pressure-only", "derived-window", if eq(present, 1) then "governor.release" else "governor.fail-closed", list("governor", "memory", "release", "health"));
        }

        def frgg-slot-shape?(observation) = frgg-tagged?(observation, 5, "form-resource-metal-slot-observation-v2");
        def frgg-slot-status(observation) = if eq(frgg-slot-shape?(observation), 1) then frgg-safe-label(nth(observation, 1), "invalid") else "unobserved";
        def frgg-slot-lifecycle(status) = if str_eq(status, "absent") then "idle" else if str_eq(status, "occupied-current") then "active" else if str_eq(status, "unobserved") then "unknown" else "failed";
        def frgg-slot-row(observation, epoch) {
            let present = frgg-slot-shape?(observation);
            let status = frgg-slot-status(observation);
            fgtm-sample(str_concat("governor.slot.", status), fgtm-absent(), "singleton-slot", "metal", FRGGPublisher(), "scheduler", status, fgtm-absent(), fgtm-present(1), frgg-slot-lifecycle(status), frgg-field(epoch, present), fgtm-absent(), if eq(present, 1) then fgtm-present(if str_eq(status, "occupied-current") then 1000 else 0) else fgtm-absent(), fgtm-absent(), "never", if eq(present, 1) then "physical-live" else "derived-window", if eq(present, 1) then "governor.slot" else "governor.fail-closed", list("governor", "metal", "admission", "health"));
        }

        // Frame sidecar keeps the complete permit coordinates that cannot fit
        // honestly in the bounded generic Glass row vocabulary.
        def frgg-frame(samples, safe, reason, permitId, permitStatus, publisher, pid, started, incarnation, sequence, observed, submitSequence, submitObserved, handle, correlation, releaseStatus, releaseReason, releaseSelectionCount, slotStatus) = list(FRGGSchema(), samples, safe, reason, permitId, permitStatus, publisher, pid, started, incarnation, sequence, observed, submitSequence, submitObserved, handle, correlation, releaseStatus, releaseReason, releaseSelectionCount, slotStatus);
        def frgg-frame-samples(frame) = nth(frame, 1);
        def frgg-frame-safe?(frame) = nth(frame, 2);
        def frgg-frame-reason(frame) = nth(frame, 3);
        def frgg-frame-permit-id(frame) = nth(frame, 4);
        def frgg-frame-permit-status(frame) = nth(frame, 5);
        def frgg-frame-permit-publisher(frame) = nth(frame, 6);
        def frgg-frame-permit-pid(frame) = nth(frame, 7);
        def frgg-frame-permit-started(frame) = nth(frame, 8);
        def frgg-frame-permit-incarnation(frame) = nth(frame, 9);
        def frgg-frame-permit-sequence(frame) = nth(frame, 10);
        def frgg-frame-permit-observed(frame) = nth(frame, 11);
        def frgg-frame-submit-sequence(frame) = nth(frame, 12);
        def frgg-frame-submit-observed(frame) = nth(frame, 13);
        def frgg-frame-command-handle(frame) = nth(frame, 14);
        def frgg-frame-correlation(frame) = nth(frame, 15);
        def frgg-frame-release-status(frame) = nth(frame, 16);
        def frgg-frame-release-reason(frame) = nth(frame, 17);
        def frgg-frame-release-selection-count(frame) = nth(frame, 18);
        def frgg-frame-slot-status(frame) = nth(frame, 19);
        def frgg-frame-valid?(frame) = if not(eq(frgg-tagged?(frame, 20, FRGGSchema()), 1)) then 0 else fgtm-samples-valid?(frgg-frame-samples(frame));
        def frgg-correlation(decision, consumeResult, submitBind, quantum, permit) = if eq(frgg-submit-admitted?(submitBind, decision, consumeResult, quantum), 1) then "exact-submit-correlated" else if eq(frgg-submit-attempted?(submitBind), 1) then "submit-refused" else if eq(frgg-consume-admitted?(consumeResult, decision), 1) then "atomic-reservation" else if eq(frgg-consume-attempted?(consumeResult), 1) then "reservation-refused" else if eq(frgg-permit-valid?(permit), 1) then if str_eq(frgg-permit-status(permit), "open") then "open-offer" else "retained-owner" else "none";

        def frgg-project(policy, sample, decision, consumeResult, submitBind, quantum, releasePlan, slotObservation, epoch) {
            let safe = frgg-decision-safe?(policy, sample, decision);
            let reason = if eq(safe, 1) then frgg-decision-reason(decision) else "adapter-input-invalid";
            let permit = if eq(safe, 1) then frgg-selected-permit(decision, consumeResult, submitBind, quantum) else list();
            let permitPresent = frgg-permit-valid?(permit);
            let permitStatus = if eq(permitPresent, 1) then frgg-permit-status(permit) else "none";
            let provenance = if eq(permitPresent, 1) then frgg-permit-provenance(permit) else list();
            let provenanceCurrent = if eq(permitPresent, 1) then frgg-provenance-current?(provenance) else 0;
            let lifetime = if eq(provenanceCurrent, 1) then frgg-lifetime(frgg-provenance-lifetime-truth(provenance)) else list();
            let submitted = if and(eq(permitPresent, 1), str_eq(permitStatus, "submitted")) then 1 else 0;
            let submitProvenance = if eq(submitted, 1) then frgg-permit-submit-provenance(permit) else list();
            let rows = list(frgg-resource-row("governor.target.cpu", "cpu", if eq(safe, 1) then nth(decision, 6) else 0, if eq(safe, 1) then nth(decision, 3) else 0, epoch, safe), frgg-resource-row("governor.target.gpu", "gpu", if eq(safe, 1) then nth(decision, 7) else 0, if eq(safe, 1) then nth(decision, 4) else 0, epoch, safe), frgg-resource-row("governor.target.memory", "unified", if eq(safe, 1) then nth(decision, 8) else 0, if eq(safe, 1) then nth(decision, 5) else 0, epoch, safe), frgg-pressure-row(policy, sample), frgg-admission-row(safe, decision, consumeResult, submitBind, quantum, permit, epoch), frgg-permit-row(permit), frgg-reason-row(reason, safe, epoch), frgg-release-row(releasePlan, epoch), frgg-release-selection-row(releasePlan, epoch), frgg-slot-row(slotObservation, epoch));
            frgg-frame(rows, safe, reason, if eq(permitPresent, 1) then frgg-permit-id(permit) else "", permitStatus, if eq(provenanceCurrent, 1) then frgg-provenance-publisher(provenance) else "", if eq(provenanceCurrent, 1) then frgg-lifetime-pid(lifetime) else 0, if eq(provenanceCurrent, 1) then frgg-lifetime-started(lifetime) else 0, if eq(provenanceCurrent, 1) then frgg-lifetime-incarnation(lifetime) else "", if eq(provenanceCurrent, 1) then frgg-permit-coordinate(provenance, "sequence") else 0, if eq(provenanceCurrent, 1) then frgg-permit-coordinate(provenance, "observed") else 0, if eq(submitted, 1) then frgg-permit-coordinate(submitProvenance, "sequence") else 0, if eq(submitted, 1) then frgg-permit-coordinate(submitProvenance, "observed") else 0, if eq(submitted, 1) then frgg-permit-handle(permit) else 0, frgg-correlation(decision, consumeResult, submitBind, quantum, permit), frgg-release-status(releasePlan), frgg-release-reason(releasePlan), frgg-release-selection-count(releasePlan), frgg-slot-status(slotObservation));
        }
        def frgg-publish(root, epoch, frame) = if not(eq(frgg-frame-valid?(frame), 1)) then list("glass-publish-v1", "refused", "governor-frame") else fgtm-publish-snapshot(root, FRGGPublisher(), epoch, frgg-frame-samples(frame));
    }
    0;
}
