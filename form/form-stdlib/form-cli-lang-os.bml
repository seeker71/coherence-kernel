; form-cli-lang-os.bml — form-cli as a language OS: seats, ontology, cache.
;
; Yes asked to turn form-cli into a self-evolving Form language OS that
; holds BMF, form, BML, python, C, go, typescript, chinese, indonesian,
; german, french, portuguese, english — new grammars as data, remote
; only when local is quiet, shared cache crystallized into sovereignty.
;
; Honest floor this sitting: seats and shared ontology are observed.
; Full parsers already live for python/go/ts/natural-en/id, form.bml,
; form.lift. C has no grammar file. zh/de/fr/pt sit as ontology, not
; as python-bmf-scale grammars. Remote is a sealed lookup payload that
; only enters through the remote lane — not a live ChatGPT GET.
;
; The surprise is 71, and only when every seat is home, the Portuguese
; remote row has frozen, and Licht/guang/cahaya ask the same LIGHT.
;
; Authority is this section.
;
// preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-lang-os-band.fk
; witnessed: 2026-08-19 -> 2047

section [form.lift] {
    def flo-names() = list("bmf", "form", "bml", "python", "c", "go", "typescript", "zh", "id", "de", "fr", "pt", "en");
    def flo-file() = list(1, 1, 1, 1, 0, 1, 1, 0, 1, 0, 0, 0, 1);
    def flo-onto-be() = list("is", "adalah", "ist", "est", "e", "shi", "eq", "eqeq", "eqeqeq", "fact");
    def flo-onto-light() = list("light", "luz", "licht", "lumiere", "cahaya", "guang");
    def flo-steps() = list("seat", "copula", "compile", "cache", "ask");

    def flo-has(xs, s) = if len(xs) == 0 then 0 else if str_eq(head(xs), s) then 1 else flo-has(tail(xs), s);

    def flo-root(s) = if flo-has(flo-onto-light(), s) then "LIGHT" else if flo-has(flo-onto-be(), s) then "BE" else s;

    def flo-find-surface(cache, s) = if len(cache) == 0 then 0 else if str_eq(nth(head(cache), 0), s) then nth(head(cache), 2) else flo-find-surface(tail(cache), s);

    def flo-find-root(cache, root) = if len(cache) == 0 then 0 else if str_eq(nth(head(cache), 1), root) then nth(head(cache), 2) else flo-find-root(tail(cache), root);

    def flo-ask(cache, s) = if flo-find-surface(cache, s) == 0 then if str_eq(flo-root(s), "LIGHT") then flo-find-root(cache, "LIGHT") else 0 else flo-find-surface(cache, s);

    def flo-hit(cache, s) = if flo-ask(cache, s) == 0 then 0 else 1;

    def flo-walk(hit, local-ready) = if hit == 1 then 0 else if local-ready == 1 then 1 else 2;

    def flo-phase(depth, fear) = if depth >= 3 then if fear == 0 then ice else liquid else compost;

    def flo-oracle-luz() = list("luz", "LIGHT", 71);

    def flo-ingest(cache, row, depth, fear) = if flo-phase(depth, fear) == ice then cons(row, cache) else cache;

    def flo-home() = flo-ingest(empty, flo-oracle-luz(), 5, 0);

    def flo-surprise() = if len(flo-names()) == 13 then if flo-ask(empty, "licht") == 0 then if flo-walk(flo-hit(empty, "licht"), 0) == 2 then if flo-ask(flo-home(), "licht") == 71 then if flo-ask(flo-home(), "guang") == 71 then if flo-ask(flo-home(), "cahaya") == 71 then if flo-ask(flo-home(), "light") == 71 then if flo-walk(flo-hit(flo-home(), "licht"), 0) == 0 then if nth(flo-file(), 4) == 0 then 71 else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0 else 0;

    def flo-surprise-short() = unless len(list("en", "id")) == 13 then 0 else 71;

    def flo-check() = add(if len(flo-names()) == 13 then 1 else 0, add(if nth(flo-file(), 4) == 0 then 2 else 0, add(if nth(flo-file(), 8) == 1 then 4 else 0, add(if flo-ask(empty, "licht") == 0 then 8 else 0, add(if flo-walk(0, 0) == 2 then 16 else 0, add(if flo-ask(flo-home(), "licht") == 71 then 32 else 0, add(if flo-ask(flo-home(), "guang") == 71 then 64 else 0, add(if flo-ask(flo-home(), "cahaya") == 71 then 128 else 0, add(if flo-walk(1, 0) == 0 then 256 else 0, add(if flo-surprise() == 71 then 512 else 0, if flo-surprise-short() == 0 then 1024 else 0))))))))));
    0;
}
