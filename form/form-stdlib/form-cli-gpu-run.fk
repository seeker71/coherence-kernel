; form-cli-gpu-run.fk — JIT, Metal GPU, and MLX softmax/attention in one breath.
;
; BML names the MLX programs. JIT is jit_arm64_u32_leaf. Metal is the
; body's own MSL add. mlx_run is the GPU IR door. No flags.
;
; preludes: form-stdlib/core.fk form-stdlib/metal-door.fk form-stdlib/form-cli-gpu.bml

(do
    (defn fcg-nl () (byte_to_str 10))
    (defn fcg-msl ()
        (str_concat "#include <metal_stdlib>"
        (str_concat (fcg-nl)
        (str_concat "using namespace metal;"
        (str_concat (fcg-nl)
                    "kernel void form_gpu_add(device uint *a [[buffer(0)]], constant uint &b [[buffer(1)]], uint gid [[thread_position_in_grid]]) { if (gid == 0) a[0] = a[0] + b; }")))))
    (defn fcg-jit-add (a b)
        (jit_arm64_u32_leaf (list (list 2) (list 1 b) (list 3 0 1)) 2 a))

    (print "form-cli executed gpu-lane\n")
    (print "form-cli mlx-linked=")
    (print (if (lt (str_find (mlx_status) "mlx_linked=true" 0) 0) "false" "true"))
    (print "\nform-cli mlx-add=")
    (print (int_to_str (mlx_run (fcg-add))))
    (print "\nform-cli mlx-softmax-sum=")
    (print (int_to_str (mlx_run (fcg-softmax-sum))))
    (print "\nform-cli mlx-attn-sharp=")
    (print (int_to_str (mlx_run (fcg-attn-sharp))))
    (print "\nform-cli mlx-attn-uniform=")
    (print (int_to_str (mlx_run (fcg-attn-uniform))))
    (print "\nform-cli jit-add=")
    (print (int_to_str (fcg-jit-add 2 3)))
    (print "\n")

    (let gbuf (metal_buf_alloc 4))
    (metal_buf_write gbuf 0 (md-le32 2))
    (let gpipe (metal_pipeline (fcg-msl) "form_gpu_add"))
    (let genq (metal_enqueue gpipe (md-bind (list gbuf) (list 3)) 1))
    (let gsync (metal_sync))
    (let gres (metal_buf_read gbuf 0 4))
    (print "form-cli metal-pipeline=")
    (print (int_to_str gpipe))
    (print " enqueue=")
    (print (int_to_str genq))
    (print " sync=")
    (print (int_to_str gsync))
    (print " byte0=")
    (print (int_to_str (str_byte_at gres 0)))
    (print "\nform-cli metal=\n")
    (print (metal_status))
    (print "\nform-cli mlx=\n")
    (print (mlx_status))
    (print "\n")
    (metal_buf_free gbuf)
    0)
