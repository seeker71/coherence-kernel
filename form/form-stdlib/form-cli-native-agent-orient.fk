; form-cli-native-agent-orient.fk — seven seats of the local native agent CLI.
;
; The north star is one Form-native form-cli that can answer, build, design,
; collaborate, grow, expand, and guide on this computer. This cell is the
; orientation, not the voice. Each seat is three integers:
;   organ — 1 when a cell already holds the capability
;   door  — 1 when form-cli already dispatches a verb for it
;   enter — 0 named, 1 lesson, 2 observed (same shape as name-build-observe)
;
; Direct-answer has executed on the resident Qwen/KV route and scored 0, so
; generative answer remains a lesson. Lookup verbs (improve, inquire, grounded)
; are observed elsewhere and do not upgrade this seat. Design is the honest
; hole: arch-gen lives, and form-cli has no design verb. Voice stays pending.
;
; Next owed movement is answer-generate: a held-out local answer with an
; equivalence bit, after cold-admission status is Form-visible.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-native-agent-orient-band.fk
; witnessed: 2026-08-30 -> 4095

(do
    (defn fnao-named () 0)
    (defn fnao-lesson () 1)
    (defn fnao-observed () 2)

    (defn fnao-seat-answer () 0)
    (defn fnao-seat-build () 1)
    (defn fnao-seat-design () 2)
    (defn fnao-seat-collaborate () 3)
    (defn fnao-seat-grow () 4)
    (defn fnao-seat-expand () 5)
    (defn fnao-seat-guide () 6)
    (defn fnao-seat-n () 7)

    (defn fnao-next-answer-generate () 0)
    (defn fnao-next () (fnao-next-answer-generate))
    (defn fnao-next-name () "answer-generate")
    (defn fnao-voice-pending () "pending")

    (defn fnao-seat-name (seat)
        (if (eq seat (fnao-seat-answer)) "answer"
            (if (eq seat (fnao-seat-build)) "build"
                (if (eq seat (fnao-seat-design)) "design"
                    (if (eq seat (fnao-seat-collaborate)) "collaborate"
                        (if (eq seat (fnao-seat-grow)) "grow"
                            (if (eq seat (fnao-seat-expand)) "expand"
                                "guide")))))))

    (defn fnao-seat-of (name)
        (if (str_eq name "answer") (fnao-seat-answer)
            (if (str_eq name "build") (fnao-seat-build)
                (if (str_eq name "design") (fnao-seat-design)
                    (if (str_eq name "collaborate") (fnao-seat-collaborate)
                        (if (str_eq name "grow") (fnao-seat-grow)
                            (if (str_eq name "expand") (fnao-seat-expand)
                                (if (str_eq name "guide") (fnao-seat-guide)
                                    (sub 0 1)))))))))

    ; organs already in the body, one per seat
    (defn fnao-organ (seat)
        (if (and (ge seat 0) (lt seat (fnao-seat-n))) 1 0))

    ; design has no form-cli verb yet; the other six already dispatch
    (defn fnao-door (seat)
        (if (eq seat (fnao-seat-design)) 0
            (if (and (ge seat 0) (lt seat (fnao-seat-n))) 1 0)))

    ; none of the seven north-star seats is a live observed agent capability
    (defn fnao-enter (seat)
        (if (and (ge seat 0) (lt seat (fnao-seat-n))) (fnao-lesson) (fnao-named)))

    (defn fnao-row (seat)
        (str_concat "seat=" (str_concat (fnao-seat-name seat)
        (str_concat " organ=" (str_concat (int_to_str (fnao-organ seat))
        (str_concat " door=" (str_concat (int_to_str (fnao-door seat))
        (str_concat " enter=" (str_concat (int_to_str (fnao-enter seat)) "\n")))))))))

    (defn fnao-rows (seat n acc)
        (if (ge seat n) acc
            (fnao-rows (add seat 1) n (str_concat acc (fnao-row seat)))))

    (defn fnao-speak ()
        (str_concat "form-cli native-agent orientation\n"
        (str_concat "north-star=answer,build,design,collaborate,grow,expand,guide\n"
        (str_concat (fnao-rows 0 (fnao-seat-n) "")
        (str_concat "next=" (str_concat (fnao-next-name)
        (str_concat "\nvoice=" (str_concat (fnao-voice-pending) "\n"))))))))

    (defn fnao-doors-except-design (seat)
        (if (ge seat (fnao-seat-n)) 1
            (if (eq seat (fnao-seat-design))
                (fnao-doors-except-design (add seat 1))
                (if (eq (fnao-door seat) 1)
                    (fnao-doors-except-design (add seat 1))
                    0))))

    (defn fnao-all-organs (seat)
        (if (ge seat (fnao-seat-n)) 1
            (if (eq (fnao-organ seat) 1)
                (fnao-all-organs (add seat 1))
                0)))

    (defn fnao-all-lesson (seat)
        (if (ge seat (fnao-seat-n)) 1
            (if (eq (fnao-enter seat) (fnao-lesson))
                (fnao-all-lesson (add seat 1))
                0)))

    (defn fnao-none-observed (seat)
        (if (ge seat (fnao-seat-n)) 1
            (if (eq (fnao-enter seat) (fnao-observed)) 0
                (fnao-none-observed (add seat 1)))))

    (defn fnaok (cond bit) (if cond bit 0))
    (defn fnao-check ()
        (do
            (let speak (fnao-speak))
            (sum (list
                (fnaok (and (eq (fnao-seat-n) 7)
                            (and (eq (fnao-seat-guide) 6)
                                 (str_eq (fnao-seat-name (fnao-seat-collaborate)) "collaborate"))) 1)
                (fnaok (eq (fnao-all-organs 0) 1) 2)
                (fnaok (eq (fnao-door (fnao-seat-design)) 0) 4)
                (fnaok (eq (fnao-doors-except-design 0) 1) 8)
                (fnaok (eq (fnao-all-lesson 0) 1) 16)
                (fnaok (eq (fnao-none-observed 0) 1) 32)
                (fnaok (and (eq (fnao-next) (fnao-next-answer-generate))
                            (str_eq (fnao-next-name) "answer-generate")) 64)
                (fnaok (not (lt (str_find speak "north-star=answer,build,design,collaborate,grow,expand,guide" 0) 0)) 128)
                (fnaok (not (lt (str_find speak "voice=pending" 0) 0)) 256)
                (fnaok (not (lt (str_find speak "seat=design organ=1 door=0 enter=1" 0) 0)) 512)
                (fnaok (lt (str_find speak "voice=observed" 0) 0) 1024)
                (fnaok (and (eq (fnao-seat-of "answer") 0)
                            (and (eq (fnao-seat-of "guide") 6)
                                 (eq (fnao-seat-of "missing") (sub 0 1)))) 2048)))))
)
