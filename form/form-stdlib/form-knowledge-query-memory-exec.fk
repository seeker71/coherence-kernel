; form-knowledge-query-memory-exec.fk — join answer-free query-memory recipe
; DATA to the existing one-lookup path, by walking the request's own children.
;
; THE CROSSING. form-knowledge-query-memory-rotation-token.fk mints a request
; whose recipe already contains the exact answer-free query bytes; that cell
; states plainly that it performs no execution. form-knowledge-query-token.fk
; performs exactly one grounded lookup from a surface. Nothing joined them.
; This cell is the join, and it holds one rule: everything it needs is read out
; of the request node's children, so no curriculum, plan, evaluation closure or
; registry is imported to execute one memory.
;
; NO FUNCTION SEAT PER MEMORY. A thousand memories are a thousand request
; nodes walked by these same defns. The temporary C seed's FK_FN_CAP bounds a
; static function arena in runtime/fkwu-uni.c and appears in no sibling kernel;
; it was never in this path and does not become so at any memory count.
;
; VALIDATION IS FROM CHILDREN, NOT FROM A PLAN. fkqmrt-request-valid? needs the
; originating plan to re-derive identity. A resident carrier holding only the
; request has no plan, so this cell re-checks the whole shape structurally:
; both categories, both schemas, exact action identity 31.2.0.109, the nested
; memory/rollback/offer nodes agreeing between request and recipe, scannerless=1
; and pretokenized=0, the six provenance flags, four 64-hex digests, and the
; content those digests name. A request that fails any gate returns a named
; refusal and NEVER reaches a lookup. Digest shape alone is not content
; addressing: query bytes are rehashed here, while source and question
; identities are cross-bound to the offer node that carried them.
;
; ANSWER-FREE IS CHECKED, NOT ASSUMED. answer-stored must be 0 and the walked
; query bytes must be exactly one open mark, an anchor, and one close mark —
; nothing after the close. A recipe carrying an answer would make the lookup a
; formality and the observation a lie about where the content came from.
;
; MODEL-EXECUTED IS 0 IN EVERY OUTCOME. The recipe declares it, this cell
; re-checks it, and the observation carries it. No logit executed a lookup.
;
; preludes: form-stdlib/core.fk form-stdlib/form-cli-router.fk
; preludes: form-stdlib/str-byte-at.fk form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/text-tokenize.fk form-stdlib/rag-embed.fk
; preludes: form-stdlib/rag-index-codec.fk form-stdlib/rag-retrieve.fk form-stdlib/rag-ask.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; preludes: form-stdlib/form-knowledge-query-memory-rotation-token.fk
;
; Proven by: form-stdlib/tests/form-knowledge-query-memory-exec-band.fk

(do
    ; ── identities this cell expects, all read from the minting cell ───────
    (defn fkqmx-offer-category () (make_nodeid 31 2 0 123))
    (defn fkqmx-offer-schema () "axioms-public-rag-query-offer-v1")
    (defn fkqmx-open-mark () "<|form:knowledge-query|>")
    (defn fkqmx-close-mark () "<|/form:knowledge-query|>")

    ; ── generic child reading; the whole cell touches nothing else ─────────
    (defn fkqmx-kids (node)
        (if (nothing? node) (list) (node_children node)))
    (defn fkqmx-kid (node i)
        (do (let cs (fkqmx-kids node))
            (if (lt i (len cs)) (nth cs i) (nothing))))
    (defn fkqmx-str (node i)
        (do (let c (fkqmx-kid node i))
            (if (nothing? c) "" (node_value c))))
    (defn fkqmx-int (node i)
        (do (let c (fkqmx-kid node i))
            (if (nothing? c) -1 (node_value c))))

    (defn fkqmx-hex64-loop (s i)
        (if (ge i 64) 1
            (do (let b (str_byte_at s i))
                (if (or (and (ge b 48) (le b 57)) (and (ge b 97) (le b 102)))
                    (fkqmx-hex64-loop s (add i 1)) 0))))
    (defn fkqmx-hex64? (s)
        (if (not (eq (str_len s) 64)) 0 (fkqmx-hex64-loop s 0)))

    ; ── the recipe's own positions, named once ─────────────────────────────
    (defn fkqmx-recipe-memory (r)   (fkqmx-kid r 1))
    (defn fkqmx-recipe-rollback (r) (fkqmx-kid r 2))
    (defn fkqmx-recipe-offer (r)    (fkqmx-kid r 3))
    (defn fkqmx-recipe-question-sha (r) (fkqmx-str r 4))
    (defn fkqmx-recipe-source-sha (r)   (fkqmx-str r 5))
    (defn fkqmx-recipe-present-sha (r)  (fkqmx-str r 6))
    (defn fkqmx-recipe-query-sha (r)    (fkqmx-str r 7))
    (defn fkqmx-recipe-trial (r)  (fkqmx-str r 8))
    (defn fkqmx-recipe-lane (r)   (fkqmx-str r 9))
    (defn fkqmx-recipe-rag (r)            (fkqmx-int r 10))
    (defn fkqmx-recipe-supervised (r)     (fkqmx-int r 11))
    (defn fkqmx-recipe-heldout (r)        (fkqmx-int r 12))
    (defn fkqmx-recipe-learned (r)        (fkqmx-int r 13))
    (defn fkqmx-recipe-answer-stored (r)  (fkqmx-int r 14))
    (defn fkqmx-recipe-model-executed (r) (fkqmx-int r 15))

    (defn fkqmx-request-action (q)   (fkqmx-kid q 1))
    (defn fkqmx-request-recipe (q)   (fkqmx-kid q 2))
    (defn fkqmx-request-memory (q)   (fkqmx-kid q 3))
    (defn fkqmx-request-rollback (q) (fkqmx-kid q 4))
    (defn fkqmx-request-trial (q)    (fkqmx-str q 5))
    (defn fkqmx-request-lane (q)     (fkqmx-str q 6))
    (defn fkqmx-request-pretokenized (q) (fkqmx-int q 7))
    (defn fkqmx-request-scannerless (q)  (fkqmx-int q 8))

    ; ── walking the query bytes out of the recipe ──────────────────────────
    ; The offer node holds the exact surface the rotation organ minted. This
    ; cell copies nothing and rebuilds nothing: it reads child 2 and hands
    ; those bytes to the lookup.
    (defn fkqmx-query-bytes (recipe)
        (fkqmx-str (fkqmx-recipe-offer recipe) 2))

    (defn fkqmx-query-sha (recipe)
        (hex-encode (sha256-stream-string (fkqmx-query-bytes recipe))))

    (defn fkqmx-query-digest-ok? (recipe)
        (if (str_eq (fkqmx-query-sha recipe)
                    (fkqmx-recipe-query-sha recipe)) 1 0))

    (defn fkqmx-source-binding-ok? (recipe)
        (do
            (let offer (fkqmx-recipe-offer recipe))
            (if (str_eq (fkqmx-str offer 1)
                    (str_concat "sha256:" (fkqmx-recipe-source-sha recipe)))
                1 0)))

    (defn fkqmx-question-binding-ok? (recipe)
        (do
            (let offer (fkqmx-recipe-offer recipe))
            (if (not (str_eq (fkqmx-str offer 3)
                             (fkqmx-recipe-question-sha recipe))) 0
                (if (str_eq (fkqmx-recipe-question-sha recipe)
                            (fkqmx-recipe-present-sha recipe)) 1 0))))

    (defn fkqmx-answer-free? (surface)
        (do (let o (str_find surface (fkqmx-open-mark) 0))
            (let c (str_find surface (fkqmx-close-mark) 0))
            (if (not (eq o 0)) 0
                (if (lt c 0) 0
                    (if (ge (str_find surface (fkqmx-open-mark)
                                (str_len (fkqmx-open-mark))) 0) 0
                        (if (not (eq (add c (str_len (fkqmx-close-mark)))
                                     (str_len surface))) 0
                            (if (gt c (str_len (fkqmx-open-mark))) 1 0)))))))

    ; ── the gates, in order, each with its own name ────────────────────────
    (defn fkqmx-offer-ok? (offer)
        (if (nothing? offer) 0
            (if (not (node_eq (node_category offer) (fkqmx-offer-category))) 0
                (if (not (eq (len (fkqmx-kids offer)) 4)) 0
                    (if (str_eq (fkqmx-str offer 0) (fkqmx-offer-schema)) 1 0)))))

    (defn fkqmx-flags-ok? (r)
        (if (not (eq (fkqmx-recipe-rag r) 1)) 0
            (if (not (eq (fkqmx-recipe-supervised r) 1)) 0
                (if (not (eq (fkqmx-recipe-heldout r) 0)) 0
                    (if (not (eq (fkqmx-recipe-learned r) 0)) 0
                        (if (not (eq (fkqmx-recipe-answer-stored r) 0)) 0
                            (if (eq (fkqmx-recipe-model-executed r) 0) 1 0)))))))

    (defn fkqmx-hashes-ok? (r)
        (if (not (eq (fkqmx-hex64? (fkqmx-recipe-question-sha r)) 1)) 0
            (if (not (eq (fkqmx-hex64? (fkqmx-recipe-source-sha r)) 1)) 0
                (if (not (eq (fkqmx-hex64? (fkqmx-recipe-present-sha r)) 1)) 0
                    (if (eq (fkqmx-hex64? (fkqmx-recipe-query-sha r)) 1) 1 0)))))

    (defn fkqmx-nested-ok? (q r)
        (if (not (node_eq (fkqmx-request-memory q) (fkqmx-recipe-memory r))) 0
            (if (not (node_eq (fkqmx-request-rollback q)
                              (fkqmx-recipe-rollback r))) 0
                (if (not (str_eq (fkqmx-request-trial q)
                                 (fkqmx-recipe-trial r))) 0
                    (if (str_eq (fkqmx-request-lane q)
                                (fkqmx-recipe-lane r)) 1 0)))))

    ; One reason per gate. A single "invalid" would make every refusal look
    ; like every other, and the first question anyone asks a refusal is which
    ; gate it failed.
    (defn fkqmx-refuse-reason (q)
        (if (nothing? q) "request-absent"
            (if (not (node_eq (node_category q) (fkqmrt-request-category)))
                "request-category"
            (if (not (eq (len (fkqmx-kids q)) 9)) "request-arity"
            (if (not (str_eq (fkqmx-str q 0) (fkqmrt-request-schema)))
                "request-schema"
            (if (not (node_eq (fkqmx-request-action q) (fkqmrt-action-node)))
                "action-identity"
            (if (not (eq (fkqmx-request-scannerless q) 1)) "not-scannerless"
            (if (not (eq (fkqmx-request-pretokenized q) 0)) "pretokenized"
            (do (let r (fkqmx-request-recipe q))
                (if (nothing? r) "recipe-absent"
                (if (not (node_eq (node_category r) (fkqmrt-recipe-category)))
                    "recipe-category"
                (if (not (eq (len (fkqmx-kids r)) 16)) "recipe-arity"
                (if (not (str_eq (fkqmx-str r 0) (fkqmrt-recipe-schema)))
                    "recipe-schema"
                (if (eq (fkqmx-nested-ok? q r) 0) "nested-incoherent"
                (if (eq (fkqmx-flags-ok? r) 0) "provenance-flags"
                (if (eq (fkqmx-hashes-ok? r) 0) "digest-shape"
                (if (eq (fkqmx-offer-ok? (fkqmx-recipe-offer r)) 0) "offer-shape"
                (if (eq (fkqmx-answer-free? (fkqmx-query-bytes r)) 0)
                    "not-answer-free"
                (if (eq (fkqmx-query-digest-ok? r) 0)
                    "query-digest-mismatch"
                (if (eq (fkqmx-source-binding-ok? r) 0)
                    "source-binding-mismatch"
                (if (eq (fkqmx-question-binding-ok? r) 0)
                    "question-binding-mismatch"
                    "ready")))))))))))))))))))))


    (defn fkqmx-ready? (q) (if (str_eq (fkqmx-refuse-reason q) "ready") 1 0))

    ; ── the typed observation ──────────────────────────────────────────────
    ; observation = (schema status reason request fkqt-request fkqt-observation
    ;                query-sha source-sha lookups hits model-executed executed
    ;                rendered-span)
    ;
    ; THE SPAN IS RENDERED HERE, where the fkqt RESULT is still in hand, and
    ; carried rather than re-derived. fkqt-render takes the whole 20-field
    ; result; `fkqt-observation` is one field OF that result, and handing the
    ; field to the renderer returns an empty string rather than an error — a
    ; caller downstream then has a hit with nothing to show for it. Witnessed
    ; 2026-08-26: the live crossing reported every stage ran and answered with
    ; an empty span. Rendering at the source removes the chance to confuse them.
    (defn fkqmx-observation-schema ()
        "form-knowledge-query-memory-exec-observation-v1")
    (defn fkqmx-observation-with-span (status reason request fq fo qsha ssha
                                       lookups hits executed span)
        (list (fkqmx-observation-schema) status reason request fq fo
              qsha ssha lookups hits 0 executed span))
    (defn fkqmx-observation (status reason request fq fo qsha ssha
                             lookups hits executed)
        (fkqmx-observation-with-span status reason request fq fo qsha ssha
              lookups hits executed ""))
    (defn fkqmx-obs-status (o)   (nth o 1))
    (defn fkqmx-obs-reason (o)   (nth o 2))
    (defn fkqmx-obs-request (o)  (nth o 3))
    (defn fkqmx-obs-fkqt-request (o)     (nth o 4))
    (defn fkqmx-obs-fkqt-observation (o) (nth o 5))
    (defn fkqmx-obs-query-sha (o)  (nth o 6))
    (defn fkqmx-obs-source-sha (o) (nth o 7))
    (defn fkqmx-obs-lookups (o) (nth o 8))
    (defn fkqmx-obs-hits (o)    (nth o 9))
    (defn fkqmx-obs-model-executed (o) (nth o 10))
    (defn fkqmx-obs-executed (o) (nth o 11))
    ; the typed observation as bytes a reader or a peer can be shown
    (defn fkqmx-obs-span (o) (if (lt (len o) 13) "" (nth o 12)))

    (defn fkqmx-status? (s)
        (if (or (str_eq s "hit") (or (str_eq s "miss") (or (str_eq s "nothing")
            (or (str_eq s "timeout") (str_eq s "failure"))))) 1 0))

    (defn fkqmx-refusal (q reason)
        (fkqmx-observation "failure" reason q (nothing) (nothing) "" "" 0 0 0))

    ; ── the one crossing ───────────────────────────────────────────────────
    ; Exactly one fkqt-execute-at, reached only through `ready`. The lookup
    ; count is taken from fkqt's own report rather than counted here, so the
    ; observation cannot claim a lookup the lookup path did not make.
    (defn fkqmx-execute-at (index-path request local-ready)
        (do
            (let reason (fkqmx-refuse-reason request))
            (if (not (str_eq reason "ready")) (fkqmx-refusal request reason)
                (do
                    (let recipe (fkqmx-request-recipe request))
                    (let result (fkqt-execute-at index-path
                                    (fkqmx-query-bytes recipe) local-ready))
                    ; A general RAG index may return a semantically close row
                    ; from a different source. The memory names one exact
                    ; source digest, so that is a visible failure rather than
                    ; permission to relabel the foreign hit as source-bound.
                    ; the guard binds only where the recipe NAMES a source; an
                    ; unbound request cannot mismatch what it never claimed.
                    (if (and (str_eq (fkqt-status result) "hit")
                        (and (gt (str_len (fkqmx-recipe-source-sha recipe)) 0)
                             (not (str_eq (fkqt-source-key result)
                                 (fkqmx-recipe-source-sha recipe)))))
                        (fkqmx-observation "failure" "source-result-mismatch"
                            request (fkqt-result-request-token result)
                            (fkqt-observation result)
                            (fkqmx-recipe-query-sha recipe)
                            (fkqmx-recipe-source-sha recipe)
                            (fkqt-lookup-count result) 0
                            (fkqt-executed? result))
                        ; the span rendered where the RESULT is in hand — the
                        ; silent-empty repair rides with the mismatch guard.
                        (fkqmx-observation-with-span
                            (fkqt-status result)
                            (fkqt-reason result)
                            request
                            (fkqt-result-request-token result)
                            (fkqt-observation result)
                            (fkqmx-recipe-query-sha recipe)
                            (fkqmx-recipe-source-sha recipe)
                            (fkqt-lookup-count result)
                            (fkqt-hit-count result)
                            (fkqt-executed? result)
                            (fkqt-render result)))))))

    0)
