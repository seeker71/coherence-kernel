; form-cli-resident-multi-skill-school.fk -- one reusable, selected-model Form
; school door.  Its caller supplies the model path; no user path or model
; default is compiled into this cell.  The stateful REPL can admit this recipe
; and retain the `models`/`use` selection today, but cannot call it in-process
; until the fkwu program-image/source-call seam is built.
;
; `fscs-school` is effectful only after a nonempty, existing selected path is
; supplied.  It opens one Qwen context, retains the same KV residence through
; knowledge/teaching/check/refinement, releases every opened handle, and returns
; one compact typed result string.  The empty-selection refusal and result
; formatter are pure so dispatch can be proved without touching model bytes.
;
; A composing lane supplies form-nodeid-knowledge-routed-query.fk before this
; cell.  Keeping that shared dependency out of this cell's own prelude avoids
; loading the same public concept corpus twice in direct-source compositions.
; preludes: form-stdlib/form-cli-resident-multi-skill-loop.fk

(do
    (defn fscs-concept () "defn-psci-schema")
    (defn fscs-result-open () "<|form:school-result|>")
    (defn fscs-result-close () "<|/form:school-result|>")
    (defn fscs-strip-last-byte-if (text code)
        (do
            (let n (str_len text))
            (if (and (gt n 0) (eq (str-byte-at text (sub n 1)) code))
                (substring text 0 (sub n 1)) text)))
    (defn fscs-strip-eol (text)
        (fscs-strip-last-byte-if (fscs-strip-last-byte-if text 10) 13))
    (defn fscs-selected-digest (path)
        (nmfe-sha256 (nmfe-fields (list "selected-model-path" path))))
    (defn fscs-result
        (status reason verdict selected-digest open-count same-residence
         observations expected-observations knowledge-status knowledge-binding
         attempt-one attempt-two lane acknowledgment bml bmf form leakage
         model-executed loop-valid release-ok)
        (fmsl-cat (list
            (fscs-result-open)
            "\nschema=form-school-result-v1"
            "\nstatus=" status
            "\nreason=" reason
            "\nverdict=" (int_to_str verdict)
            "\nselected-model-digest=" selected-digest
            "\nopen-count=" (int_to_str open-count)
            "\nsame-residence=" (int_to_str same-residence)
            "\nobservations=" (int_to_str observations)
            "\nexpected-observations=" (int_to_str expected-observations)
            "\nknowledge-status=" knowledge-status
            "\nknowledge-binding=" (int_to_str knowledge-binding)
            "\nattempt-one=" (int_to_str attempt-one)
            "\nattempt-two=" (int_to_str attempt-two)
            "\nlane=" lane
            "\nack=" acknowledgment
            "\nbml=" (int_to_str bml)
            "\nbmf=" (int_to_str bmf)
            "\nform=" (int_to_str form)
            "\nleakage=" (int_to_str leakage)
            "\nmodel-executed-form=" (int_to_str model-executed)
            "\nloop-valid=" (int_to_str loop-valid)
            "\nrelease=" (int_to_str release-ok)
            "\n" (fscs-result-close))))
    (defn fscs-refusal (path reason)
        (fscs-result "nothing" reason 0 (fscs-selected-digest path)
            0 0 0 0 "nothing" 0 0 0 "none" "" 0 0 0 0 0 0 1))
    (defn fscs-result-valid? (text)
        (if (not (eq (str_find text (fscs-result-open) 0) 0)) 0
        (if (not (ge (str_find text "\nschema=form-school-result-v1" 0) 0)) 0
        (if (not (ge (str_find text "\nselected-model-digest=" 0) 0)) 0
        (if (not (ge (str_find text "\nmodel-executed-form=" 0) 0)) 0
        (if (not (ge (str_find text "\nrelease=" 0) 0)) 0
            (if (eq (str_find text (fscs-result-close) 0)
                    (sub (str_len text) (str_len (fscs-result-close))))
                1 0)))))))
    (defn fscs-prompt ()
        (do
            (let surface (fknq-concept-surface (fscs-concept)))
            (fhcs-cat (list
                "Remain in one local Form learning residence. First output exactly this scannerless control frame, with no prose before or after it:\n"
                surface
                "\nAfter the typed knowledge observation, reply exactly `knowledge-held "
                (fscs-concept)
                " source=<observed source path>` using the actual path and no other bytes. Then embody the executable BML/BMF/Form teaching frame and return exactly <BML>, <BMF>, and <FORM> artifacts. A typed check binds your exact candidate to its executed verdict. Reply exactly `embodied and held` only on success. On failure, undo and return one corrected three-artifact candidate; after its distinct executed check, acknowledge only if that check passes. Never repeat a query and never claim Form executed inside the model."))))
    (defn fscs-exact-request? (result)
        (if (and
            (str_eq (fknq-request-kind (fknq-request result)) "concept")
            (str_eq (fknq-request-coordinate (fknq-request result))
                (fscs-concept))) 1 0))
    (defn fscs-source-id (result)
        (do
            (let source (fknq-source-original-of result))
            (if (eq (psci-source-node-valid? source) 1)
                (psci-source-id source) "")))
    (defn fscs-knowledge-response (result)
        (fmsl-knowledge-response (fscs-concept) (fknq-source-path result)))
    (defn fscs-context-state-same? (opened final)
        (if (and (node_eq (head (fcms-ctx opened)) (head (fcms-ctx final)))
                 (node_eq (head (fcms-sts opened)) (head (fcms-sts final))))
            1 0))

    (defn fscs-school-opened (path opened root)
        (do
            (let artifact (fknq-default-artifact))
            (let exec-ctx (fknsc-public-context root artifact 0
                (fknq-max-frame-bytes)))
            (let moved (fknss-run-with opened 192 exec-ctx
                fknqr-public-strict-executor))
            (let knowledge-session (fknss-session moved))
            (let crossed (fknss-crossed? moved))
            (if (not (eq crossed 1))
                (do
                    (let release-ok (fcms-release-ok? knowledge-session))
                    (fscs-result "not-yet" "knowledge-crossing-not-held" 0
                        (fscs-selected-digest path) 1 1
                        (fcms-observations knowledge-session) 1 "nothing" 0
                        0 0 "none" "" 0 0 0 0 0 0 release-ok))
                (do
                    (let result (fknss-bridge-result moved))
                    (let exact-request (fscs-exact-request? result))
                    (let response-used (if (str_eq (fknss-after-text moved)
                        (fscs-knowledge-response result)) 1 0))
                    (let binding (fmsl-knowledge-binding (fscs-concept)
                        (fknq-request-kind (fknq-request result))
                        (fknq-request-coordinate (fknq-request result))
                        (fknq-concept-surface (fscs-concept))
                        (fknq-status result) (fknq-reason result)
                        (fscs-source-id result) (fknq-source-path result)
                        (fknq-answer result) (fknss-injected-text moved)
                        (fknss-after-text moved)))
                    (let binding-valid
                        (fmsl-knowledge-binding-valid? binding))
                    (let knowledge-evidence (fmsl-knowledge-evidence
                        (fknq-status result) crossed
                        (fknss-callback-calls moved)
                        (fknss-lookup-count moved)
                        (fknsc-injections (fknss-cursor moved))
                        (fknq-scannerless? result)
                        (fknq-pretokenized? result)
                        (fknss-model-executed-form? moved)
                        1 exact-request response-used binding))
                    (let teach-frame (fmsl-teaching-frame (fscs-concept)))
                    (let taught (fcms-observe knowledge-session teach-frame))
                    (let first-generation (fcms-generate taught 900))
                    (let first-session
                        (fcms-generation-session first-generation))
                    (let first-attempt (fmsl-candidate-attempt 1 "candidate"
                        "root" (fcms-generation-text first-generation)))
                    (let first-verdict (fmsl-attempt-verdict first-attempt))
                    (let first-pass
                        (eq (fgsg-verdict-overall first-verdict) 1))
                    (let check-frame (fmsl-check-frame first-attempt))
                    (let checked (fcms-observe first-session check-frame))
                    (let second-generation (fcms-generate checked
                        (if first-pass 96 900)))
                    (let resumed
                        (fcms-generation-session second-generation))
                    (let second-text
                        (fcms-generation-text second-generation))
                    (let second-attempt (if first-pass
                        (fmsl-ack-attempt 2 (nmfe-sha256 check-frame)
                            second-text)
                        (fmsl-candidate-attempt 2 "refinement"
                            (nmfe-sha256 check-frame) second-text)))
                    (let final-attempt (if first-pass first-attempt
                        second-attempt))
                    (let final-verdict
                        (fmsl-attempt-verdict final-attempt))
                    (let final-signal
                        (fmsl-attempt-signal final-attempt))
                    (let final-check (if first-pass check-frame
                        (fmsl-check-frame second-attempt)))
                    (let final-checked (if first-pass checked
                        (fcms-observe resumed final-check)))
                    (let ack-generation (if first-pass (nothing)
                        (fcms-generate final-checked 96)))
                    (let ack-text (if first-pass second-text
                        (fcms-generation-text ack-generation)))
                    (let acknowledged (if first-pass resumed
                        (fcms-generation-session ack-generation)))
                    (let branch (if first-pass "first-pass"
                        "supervised-refinement"))
                    (let lane (if first-pass "independent-generative"
                        "supervised-embodiment"))
                    (let finalization (fmsl-finalization branch final-check
                        ack-text (fmsl-snapshot final-checked)
                        (fmsl-snapshot acknowledged)))
                    (let observations (fcms-observations acknowledged))
                    (let expected-observations (if first-pass 3 4))
                    (let same-residence
                        (fscs-context-state-same? opened acknowledged))
                    (let live-leakage (sum (list
                        (fmsl-attempt-leakage first-attempt)
                        (fmsl-attempt-leakage second-attempt)
                        (fgsg-material-leakage-one (fscs-prompt))
                        (fgsg-material-leakage-one teach-frame)
                        (fgsg-material-leakage-one check-frame)
                        (if first-pass 0
                            (fgsg-material-leakage-one final-check))
                        (fgsg-material-leakage-one ack-text))))
                    (let release-ok (fcms-release-ok? acknowledged))
                    (let loop (fmsl-loop (fmsl-snapshot opened)
                        (fmsl-snapshot knowledge-session) (fmsl-snapshot taught)
                        (fmsl-snapshot first-session) (fmsl-snapshot checked)
                        (fmsl-snapshot resumed) knowledge-evidence
                        (fmsl-skill-evidence final-attempt lane) final-signal
                        (fknss-injected-text moved) teach-frame check-frame
                        first-attempt second-attempt finalization 1 0 release-ok))
                    (let loop-valid (if (and
                        (eq (fmsl-loop-valid? loop) 1)
                        (and (eq live-leakage 0)
                        (and (str_eq ack-text "embodied and held")
                             (eq observations expected-observations)))) 1 0))
                    (let attempt-one-valid
                        (fmsl-attempt-valid? first-attempt))
                    (let attempt-two-valid
                        (fmsl-attempt-valid? second-attempt))
                    (let verdict (sum (list
                        (if (eq crossed 1) 1 0)
                        (if (eq exact-request 1) 2 0)
                        (if (eq response-used 1) 4 0)
                        (if (eq binding-valid 1) 8 0)
                        (if (eq same-residence 1) 16 0)
                        (if (eq observations expected-observations) 32 0)
                        (if (eq attempt-one-valid 1) 64 0)
                        (if (eq attempt-two-valid 1) 128 0)
                        (if (eq (fgsg-verdict-overall final-verdict) 1) 256 0)
                        (if (eq live-leakage 0) 512 0)
                        (if (str_eq ack-text "embodied and held") 1024 0)
                        (if (eq loop-valid 1) 2048 0)
                        (if (eq release-ok 1) 4096 0)
                        (if (and
                            (eq (fknss-model-executed-form? moved) 0)
                            (eq (fgsg-verdict-model-executed?
                                final-verdict) 0)) 8192 0))))
                    (fscs-result (if (eq loop-valid 1) "embodied" "not-yet")
                        (if (eq loop-valid 1) "held" "school-verdict-not-held")
                        verdict (fscs-selected-digest path) 1 same-residence
                        observations expected-observations (fknq-status result)
                        binding-valid attempt-one-valid attempt-two-valid lane
                        ack-text (fgsg-verdict-bml final-verdict)
                        (fgsg-verdict-bmf final-verdict)
                        (fgsg-verdict-form final-verdict) live-leakage
                        (fgsg-verdict-model-executed? final-verdict)
                        loop-valid release-ok)))))

    (defn fscs-school (selected-path)
        (do
            (let path (fscs-strip-eol selected-path))
            (if (str_eq path "")
                (fscs-refusal "" "no-model-selected-use-models-then-use")
            (if (not (eq (fs_exists path) 1))
                (fscs-refusal path "selected-model-path-not-found")
                (do
                    (let root (fhcs-default-root))
                    (if (str_eq root "")
                        (fscs-refusal path "body-root-unresolved")
                        (do
                            (let opened (fcms-open path (fscs-prompt) 6144))
                            (if (not (eq (fcms-live? opened) 1))
                                (do
                                    (let release-ok (fcms-release-ok? opened))
                                    (fscs-result "nothing" (fcms-reason opened) 0
                                        (fscs-selected-digest path) 1 0 0 0
                                        "nothing" 0 0 0 "none" "" 0 0 0 0
                                        0 0 release-ok))
                                (fscs-school-opened path opened root)))))))))

    0)
