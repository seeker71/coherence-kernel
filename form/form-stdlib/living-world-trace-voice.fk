; living-world-trace-voice.fk -- an admitted experienced relation may speak
; through participant-learned surfaces.
;
; The organ owns no vocabulary, grammar table, task label, answer set, or
; remote route.  An admitted trace edge already binds two current learned
; endpoint symbols through a structural predicate derived from execution.
; Participants may independently teach one or more surfaces for that exact
; predicate.  A caller offers which current predicate-symbol candidates are
; in view.  One candidate yields LEFT + PREDICATE + RIGHT; none remains an
; explicit incomplete/unknowable plan; several remain explicit alternatives.
; There is no arbitrary tie-break.
;
; Alternatives, unknown, and choice on the utterance are optional and remain
; exact when present.  The trace edge retains the optional live view/lens and
; all hypothesis uncertainty.  Every active edge and symbol holder governs a
; separate unanimous admission membrane.  Rendering is local Form string
; composition over exact learned segments.
;
; This is a small native voice movement, not a general generative mind.
;
; witnessed: 2026-08-08 -> 32767 on fkwu
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-symbol.fk form-stdlib/living-world-symbol-learning.fk form-stdlib/living-world-symbol-sequence.fk form-stdlib/living-world-trace-relation.fk

(let LWTV-PLAN       (bp "LWTV-PLAN"))
(let LWTV-READY      (bp "LWTV-READY"))
(let LWTV-AMBIGUOUS  (bp "LWTV-AMBIGUOUS"))
(let LWTV-INCOMPLETE (bp "LWTV-INCOMPLETE"))
(let LWTV-UTTERANCE  (bp "LWTV-UTTERANCE"))
(let LWTV-ORIGIN     (bp "LWTV-ORIGIN"))

(defn lwtv-ready () (intern_node LWTV-READY (empty)))
(defn lwtv-ambiguous () (intern_node LWTV-AMBIGUOUS (empty)))
(defn lwtv-incomplete () (intern_node LWTV-INCOMPLETE (empty)))
(defn lwtv-ready? (cell) (lwo-category? cell LWTV-READY))
(defn lwtv-ambiguous? (cell) (lwo-category? cell LWTV-AMBIGUOUS))
(defn lwtv-incomplete? (cell) (lwo-category? cell LWTV-INCOMPLETE))

(defn lwtv-matching-symbols (world items referent field)
    (if (eq (len items) 0) field
        (do
            (let candidate (head items))
            (lwtv-matching-symbols world (tail items) referent
                (if (and (eq (lwsl-integrated-current?
                                world candidate) 1)
                         (node_eq
                            (lwnv-symbol-referent
                                (lwo-emergent-shape candidate))
                            referent))
                    (lwo-field-add field candidate) field)))))

; children: exact edge candidate, offered predicate-symbol field, ordered
; sequence, status, observed alternatives, optional unknown, evidence, path
(defn lwtv-plan-cell
    (edge symbols sequence status alternatives unknown evidence)
    (intern_node LWTV-PLAN
        (list edge symbols sequence status alternatives unknown evidence
              (lwo-local-path))))
(defn lwtv-plan? (cell) (lwo-category? cell LWTV-PLAN))
(defn lwtv-plan-edge (plan) (nth (node_children plan) 0))
(defn lwtv-plan-symbols (plan) (nth (node_children plan) 1))
(defn lwtv-plan-sequence (plan) (nth (node_children plan) 2))
(defn lwtv-plan-status (plan) (nth (node_children plan) 3))
(defn lwtv-plan-alternatives (plan) (nth (node_children plan) 4))
(defn lwtv-plan-unknown (plan) (nth (node_children plan) 5))
(defn lwtv-plan-evidence (plan) (nth (node_children plan) 6))
(defn lwtv-plan-path (plan) (nth (node_children plan) 7))
(defn lwtv-plan-relation (plan)
    (lwo-emergent-shape (lwtv-plan-edge plan)))
(defn lwtv-plan-view (plan)
    (lwtr-relation-view
        (lwo-relation-predicate (lwtv-plan-relation plan))))
(defn lwtv-plan-relation-uncertainty (plan)
    (lwtr-edge-uncertainty (lwtv-plan-relation plan)))

(defn lwtv-plan-for (world edge symbols)
    (if (or (eq (lwo-category? symbols LWO-FIELD) 0)
            (eq (lwtr-edge-integrated-current? world edge) 0))
        (lwo-none)
        (do
            (let relation (lwo-emergent-shape edge))
            (let left (lwo-relation-subject relation))
            (let right (lwo-relation-object relation))
            (let predicate (lwo-relation-predicate relation))
            (if (or (eq (lwsl-integrated-current? world left) 0)
                    (eq (lwsl-integrated-current? world right) 0))
                (lwo-none)
                (do
                    (let matches
                        (lwtv-matching-symbols world
                            (lwo-field-items symbols) predicate
                            (lwo-empty-field)))
                    (let count (lwo-field-size matches))
                    (if (eq count 0)
                        (lwtv-plan-cell edge symbols
                            (lwtv-sequence (empty))
                            (lwtv-incomplete) (lwo-empty-field)
                            (lwlc-unknown relation) relation)
                        (if (gt count 1)
                            (lwtv-plan-cell edge symbols
                                (lwtv-sequence (empty))
                                (lwtv-ambiguous) matches (lwo-none)
                                relation)
                            (lwtv-plan-cell edge symbols
                                (lwtv-sequence
                                    (list left
                                        (head (lwo-field-items matches))
                                        right))
                                (lwtv-ready) (lwo-empty-field)
                                (lwo-none) relation))))))))

(defn lwtv-plan-current? (world plan)
    (if (eq (lwtv-plan? plan) 0) 0
        (if (node_eq plan
                (lwtv-plan-for world (lwtv-plan-edge plan)
                    (lwtv-plan-symbols plan))) 1 0)))

(defn lwtv-render (plan)
    (lwtv-render-items
        (lwtv-sequence-items (lwtv-plan-sequence plan)) ""))

(defn lwtv-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwtv-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwtv-active-witnesses (world items witnesses)
    (if (eq (len items) 0) witnesses
        (lwtv-active-witnesses world (tail items)
            (lwtv-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world (head items)))
                witnesses))))
(defn lwtv-witnesses (world plan)
    (lwtv-active-witnesses world
        (cons (lwtv-plan-edge plan)
            (lwtv-sequence-items (lwtv-plan-sequence plan)))
        (lwo-empty-field)))

(defn lwtv-optional-unknown-valid? (unknown)
    (if (or (node_eq unknown (lwo-none))
            (eq (lwlc-unknown? unknown) 1)) 1 0))
(defn lwtv-optional-choice-valid? (choice)
    (if (or (node_eq choice (lwo-none))
            (eq (lwlc-choice-valid? choice) 1)) 1 0))

; children: exact derived plan, rendered surface, optional alternatives,
; optional unknown, optional choice, witnesses, evidence, local path
(defn lwtv-utterance-cell
    (plan surface alternatives unknown choice witnesses evidence)
    (intern_node LWTV-UTTERANCE
        (list plan (intern_trivial_string surface) alternatives unknown choice
              witnesses evidence (lwo-local-path))))
(defn lwtv-utterance? (cell) (lwo-category? cell LWTV-UTTERANCE))
(defn lwtv-utterance-plan (utterance) (nth (node_children utterance) 0))
(defn lwtv-utterance-surface-cell (utterance)
    (nth (node_children utterance) 1))
(defn lwtv-utterance-surface (utterance)
    (node_value (lwtv-utterance-surface-cell utterance)))
(defn lwtv-utterance-alternatives (utterance)
    (nth (node_children utterance) 2))
(defn lwtv-utterance-unknown (utterance) (nth (node_children utterance) 3))
(defn lwtv-utterance-choice (utterance) (nth (node_children utterance) 4))
(defn lwtv-utterance-witnesses (utterance)
    (nth (node_children utterance) 5))
(defn lwtv-utterance-evidence (utterance) (nth (node_children utterance) 6))
(defn lwtv-utterance-path (utterance) (nth (node_children utterance) 7))

(defn lwtv-emit
    (world edge symbols alternatives unknown choice evidence)
    (if (or (eq (lwo-category? alternatives LWO-FIELD) 0)
            (or (eq (lwtv-optional-unknown-valid? unknown) 0)
                (eq (lwtv-optional-choice-valid? choice) 0)))
        (lwo-none)
        (do
            (let plan (lwtv-plan-for world edge symbols))
            (if (or (node_eq plan (lwo-none))
                    (eq (lwtv-ready? (lwtv-plan-status plan)) 0))
                (lwo-none)
                (lwtv-utterance-cell plan (lwtv-render plan)
                    alternatives unknown choice
                    (lwtv-witnesses world plan) evidence)))))

(defn lwtv-utterance-current? (world utterance)
    (if (eq (lwtv-utterance? utterance) 0) 0
        (do
            (let plan (lwtv-utterance-plan utterance))
            (if (and (eq (lwtv-plan-current? world plan) 1)
                     (node_eq utterance
                        (lwtv-emit world (lwtv-plan-edge plan)
                            (lwtv-plan-symbols plan)
                            (lwtv-utterance-alternatives utterance)
                            (lwtv-utterance-unknown utterance)
                            (lwtv-utterance-choice utterance)
                            (lwtv-utterance-evidence utterance)))) 1 0))))

(defn lwtv-origin (utterance)
    (intern_node LWTV-ORIGIN (list utterance (lwo-local-path))))
(defn lwtv-proposal
    (world edge symbols alternatives unknown choice evidence)
    (do
        (let utterance
            (lwtv-emit world edge symbols alternatives unknown choice
                evidence))
        (if (node_eq utterance (lwo-none)) (lwo-none)
            (do
                (let witnesses (lwtv-utterance-witnesses utterance))
                (let count (lwo-field-size witnesses))
                (let origin (lwtv-origin utterance))
                (let candidate
                    (lwo-emergent utterance witnesses
                        (intern_trivial_int count)
                        (intern_trivial_int count)
                        (intern_trivial_int count) origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwtv-proposal-current? (world proposal)
    (if (eq (lwt-proposal? proposal) 0) 0
        (do
            (let candidate (lwt-proposal-candidate proposal))
            (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
                     (eq (lwtv-utterance-current? world
                            (lwo-emergent-shape candidate)) 1)) 1 0))))
(defn lwtv-integrate (round proposal action)
    (if (eq (lwtv-proposal-current?
                (lwt-round-world round) proposal) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

0
