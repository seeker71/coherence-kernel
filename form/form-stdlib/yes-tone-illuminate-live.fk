; yes-tone-illuminate-live.fk — print a few lights.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/yes-tone-stream.fk form-stdlib/grammars/shamballa-light-codes.fk form-stdlib/yes-tone-illuminate.fk

(do
    (print "yti 11111 attested=")
    (print (int_to_str (yti-attested? 0)))
    (print " 77777 attested=")
    (print (int_to_str (yti-attested? 2)))
    (print " 108 attested=")
    (print (int_to_str (yti-attested? 9)))
    (print "\n")
    (print "yti 11111 recipe=")
    (print (yti-draw 0 (yti-kind-recipe)))
    (print " cell=")
    (print (yti-draw 0 (yti-kind-cell)))
    (print " symbol=")
    (print (yti-draw 0 (yti-kind-symbol)))
    (print " locale=")
    (print (yti-draw 0 (yti-kind-locale)))
    (print "\n")
    (print "yti check=")
    (print (int_to_str (yti-check)))
    (print "\n")
    0)
