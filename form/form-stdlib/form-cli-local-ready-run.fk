; form-cli-local-ready-run.fk — print the local-ready flywheel from public marks.
;
; preludes: form-stdlib/core.fk form-stdlib/language-model.fk
; preludes: form-stdlib/form-cli-router.fk
; preludes: form-stdlib/form-cli-local-ready-xtal.fk

(do
    (print_str (str_concat "flr check=" (str_concat (int_to_str (flr-check)) "\n")))
    (print_str (str_concat "flr walk native-hit=" (str_concat (int_to_str (fcr-walk 1 1)) "\n")))
    (print_str (str_concat "flr walk unresolved=" (str_concat (int_to_str (flr-walk 0 (UnresolvedMark))) "\n")))
    (print_str (str_concat "flr walk unbalanced=" (str_concat (int_to_str (flr-walk 0 (UnbalancedMark))) "\n")))
    (print_str (str_concat "flr walk quiet=" (str_concat (int_to_str (flr-walk 0 (Quiet))) "\n")))
    (print_str (str_concat "flr control unresolved=" (str_concat (flr-control (UnresolvedMark)) "\n")))
    (print_str (str_concat "flr control unbalanced=" (str_concat (flr-control (UnbalancedMark)) "\n")))
    (print_str (str_concat "flr control heldout-unbalanced=" (str_concat (flr-control (flr-shape-of (HeldoutUnbalanced))) "\n")))
    (print_str (str_concat "flr host ls=" (str_concat (int_to_str (flr-kind-walk 0 (HostLs))) "\n")))
    (print_str (str_concat "flr host rg=" (str_concat (int_to_str (flr-kind-walk 0 (HostRg))) "\n")))
    (print_str (str_concat "flr host command=" (str_concat (int_to_str (flr-kind-walk 0 "command")) "\n")))
    0)
