; form-knowledge-qwen-heldout-v2-diagnostic-run.fk -- effectful one-row door.
;
; DO NOT preflight this cell: when both repo-local gate files are exact, its top
; level admits the 29GB model. The pure/refusal contract is proven in the
; adjacent test band without running weights.
;
; Put exactly one held-out id (for example h01) in:
;   .form-knowledge-qwen-heldout-v2-selector
; and this exact dataset-and-row-bound token in:
;   .form-knowledge-qwen-heldout-v2-consent
;   run-local-qwen-heldout-v2:<fkhe-dataset-seal>:<id>
;
; The selected prompt, expected answer, generated text, normalized answer, and
; their hashes are never printed or written. Output is five scalar evaluation
; fields plus the diagnostic cell's allowlisted generation-stage scalars. This
; cell never calls fkhe-report and therefore cannot grant ready95 or full-suite
; credit. It releases the one-shot residence before printing.
;
; preludes: form-stdlib/form-knowledge-qwen-heldout-v2-diagnostic.fk
; preludes: form-stdlib/form-cli-model-generate.fk form-stdlib/model-registry.bml

(do
    (defn fkhv2-model-path ()
        (mr-path (mr-find "qwen38-q8")))
    (defn fkhv2-print-refusal (plan)
        (do (print_str (fkhv2-refusal-lines plan)) 0))
    (defn fkhv2-run-row (row)
        (do
            (let before (now_unix_ms))
            (let generated
                (fcmg-generate-current-source-resident-at
                    (fcmr-none) (fkhv2-model-path)
                    (fkhe-prompt row) (fkhe-source row)))
            (let after (now_unix_ms))
            (let raw (nth generated 0))
            (let parsed (fkhe-parse-resident-output raw))
            (let score
                (fkhe-score row (fqt-knowledge-prompt (fkhe-prompt row))
                    parsed (sub after before)))
            (let observation (fkhe-score-observation score))
            (let release-ok (fcmr-release-ok? (nth generated 1)))
            (let error
                (if (or (eq (nmfe-obs-error observation) 1)
                        (not (eq release-ok 1))) 1 0))
            (let promotion
                (if (eq error 1) 0 (nmfe-obs-promotion observation)))
            (print_str
                (fkhv2-base-lines (fkhe-id row) (fkhe-family row)
                    (nmfe-obs-exact observation)
                    (nmfe-obs-f1 observation)
                    (nmfe-obs-sequence observation)
                    promotion error (nmfe-obs-latency observation)))
            (print_str (fkhv2-stage-lines raw))
            0))

    (defn fkhv2-run-selected ()
        (do
            (let selector (read_file (fkhv2-selector-path)))
            (let row (fkhv2-selected-row selector))
            (if (eq (len row) 0)
                (fkhv2-print-refusal
                    (fkhv2-plan 0 "selected-heldout-row" row))
                (do
                    (let consent (read_file (fkhv2-consent-path)))
                    (if (eq (fkhv2-consent-valid? consent (fkhe-id row)) 0)
                        (fkhv2-print-refusal
                            (fkhv2-plan 0
                                "dataset-and-row-bound-v2-consent" row))
                        ; Current-source hashes, answer-key hashes, family
                        ; coverage, leakage audit, and dataset seal are checked
                        ; only after cheap selector/consent refusal gates.
                        (if (not (eq (fkhe-dataset-valid?) 1))
                            (fkhv2-print-refusal
                                (fkhv2-plan 0
                                    "sealed-current-heldout-dataset" row))
                            (fkhv2-run-row row)))))))

    (fkhv2-run-selected))
