; form-recipe-data-walk.fk — evaluate a content-addressed recipe from ITS OWN
; CHILDREN, and plug into the exec cursor's executor seam.
;
; WHY THIS EXISTS, and it is an architecture answer rather than a convenience.
; A recipe is evaluated from its own children, so composing a thousand recipes
; registers no function per recipe: the function seats are the walker's own
; defns, and that count does not move with the number of recipes walked. The
; seed's function image itself grows on demand (runtime/fkwu-uni.c
; fk_fn_reserve; form-stdlib/tests/no-fixed-tables-band.fk registers 4600
; defns), and no Go, Rust or TS kernel carries a function-seat table at all.
;
; But the deeper answer is that a recipe does not need a function seat AT ALL.
; `frex-recipe` in form-recipe-exec-token.fk is a NODE whose six children say
; everything the computation is:
;
;   (affine-scalar-v1  3  7  signed-int  signed-int  recipe-exec-lifecycle-v1)
;      kind           mul add  in-type    out-type    schema
;
; That is recipe-DATA. Walking it needs the node and an input, and imports no
; source closure, defines no functions per recipe, and therefore never
; approaches a function arena of any size. A thousand recipes are a thousand
; nodes, not a thousand defns. The cap was never in this path.
;
; WHAT THIS CELL DOES NOT DO. It runs no model, no Metal, no MLX, no CPU
; emission and no JIT. It generates no native code. `frdw-model-executed` is 0
; by construction, and the cursor's own validity predicate REFUSES any result
; claiming otherwise — the standing refusal is enforced by the type, not by a
; promise in a comment.
;
; AN UNKNOWN KIND RETURNS NOTHING, NEVER A NUMBER. A walker that guesses at a
; schema it does not know is worse than one that declines: the guess arrives
; wearing the same shape as an answer. Every gate below returns `nothing` with
; a named reason, and `nothing` is axiom-1's third state, distinct from a
; grounded 0.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/form-recipe-exec-token.fk
;
; Proven by: form-stdlib/tests/form-recipe-data-walk-band.fk

(do
    ; ── reading recipe-data, and only recipe-data ──────────────────────────
    ; Every accessor below takes the recipe NODE. None reaches for a binding,
    ; a prelude, a registry or a file. That is the whole architectural claim.
    (defn frdw-child (recipe i)
        (do (let cs (node_children recipe))
            (if (lt i (len cs)) (nth cs i) (nothing))))

    (defn frdw-kind (recipe)
        (do (let c (frdw-child recipe 0))
            (if (nothing? c) "" (node_value c))))

    (defn frdw-in-type (recipe)
        (do (let c (frdw-child recipe 3))
            (if (nothing? c) "" (node_value c))))
    (defn frdw-out-type (recipe)
        (do (let c (frdw-child recipe 4))
            (if (nothing? c) "" (node_value c))))
    (defn frdw-schema (recipe)
        (do (let c (frdw-child recipe 5))
            (if (nothing? c) "" (node_value c))))

    ; ── the kinds this walker knows, named and closed ──────────────────────
    (defn frdw-affine-kind () "affine-scalar-v1")
    (defn frdw-signed-int () "signed-int")
    (defn frdw-lifecycle () "recipe-exec-lifecycle-v1")

    (defn frdw-knows? (recipe)
        (if (str_eq (frdw-kind recipe) (frdw-affine-kind)) 1 0))

    ; The declared types are checked, not assumed. A recipe whose schema drifts
    ; is refused rather than evaluated under the old reading — the same
    ; discipline the exec token applies to its coordinates.
    (defn frdw-shape-ok? (recipe)
        (if (nothing? recipe) 0
            (if (not (eq (len (node_children recipe)) 6)) 0
                (if (not (str_eq (frdw-in-type recipe) (frdw-signed-int))) 0
                    (if (not (str_eq (frdw-out-type recipe) (frdw-signed-int))) 0
                        (if (str_eq (frdw-schema recipe) (frdw-lifecycle)) 1 0))))))

    (defn frdw-refuse-reason (recipe)
        (if (nothing? recipe) "recipe-absent"
            (if (not (eq (len (node_children recipe)) 6)) "recipe-arity"
                (if (eq (frdw-knows? recipe) 0) "recipe-kind-unknown"
                    (if (eq (frdw-shape-ok? recipe) 0) "recipe-schema-drift"
                        "ready")))))

    ; ── the evaluation, which is arithmetic over two children ──────────────
    (defn frdw-mul (recipe) (node_value (frdw-child recipe 1)))
    (defn frdw-add (recipe) (node_value (frdw-child recipe 2)))

    ; nothing for anything not fully known. Never a number by default.
    (defn frdw-apply (recipe input)
        (if (eq (frdw-knows? recipe) 0) (nothing)
            (if (eq (frdw-shape-ok? recipe) 0) (nothing)
                (add (mul (frdw-mul recipe) input) (frdw-add recipe)))))

    ; ── the executor seam ──────────────────────────────────────────────────
    ; form-cli-recipe-exec-cursor.fk offers a parsed request exactly once
    ; through `(executor ctx request)` and calls that "the future carrier
    ; boundary". This is a carrier: a pure Form one. ctx is accepted and never
    ; read, so the same seam takes a resident walker or a JIT later without the
    ; cursor changing.
    (defn frdw-executed () 1)
    (defn frdw-model-executed () 0)
    (defn frdw-native-code-generated () 0)
    (defn frdw-carrier () "form-recipe-data-walk")

    (defn frdw-result (request status reason value present trace)
        (frex-result-with-flags status reason request (frdw-carrier)
            value present trace 1
            (frdw-executed) (frdw-model-executed) (frdw-native-code-generated)))

    (defn frdw-executor (ctx request)
        (do
            (let recipe (frex-request-recipe request))
            (let reason (frdw-refuse-reason recipe))
            (if (not (str_eq reason "ready"))
                (frdw-result request "nothing" reason 0 0
                    (list (frex-event request "refuse" (frdw-carrier) "nothing" 1)))
                (do
                    (let v (frdw-apply recipe (frex-request-input request)))
                    (if (nothing? v)
                        (frdw-result request "nothing" "recipe-not-walkable" 0 0
                            (list (frex-event request "refuse" (frdw-carrier) "nothing" 1)))
                        (frdw-result request "value" "recipe-data-walked" v 1
                            (list (frex-event request "walk" (frdw-carrier) "value" 1))))))))

    0)
