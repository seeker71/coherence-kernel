; form-stdlib/stone-ledger.fk — pure folds over the stones ledger text.
; A stone STANDS while its additions outnumber its releases. A release
; line (stone=released name=<name> <witness>) records a re-observation
; that found the burn gone, and a released name can be stoned again when
; it re-heats — the ledger breathes both ways instead of fossilizing its
; first sighting (voice-frequency stood at cpu-s=143 for a burn once-hold
; had already healed to 0.13s; nothing could say so).
; Exact-field match: every ledger line writes "name=<name> " with one
; trailing space before the detail, so "name=x " never collides with
; "name=xy ".
; preludes: form-stdlib/core.fk

(do
    (defn sl-count-go (text needle from acc)
        (do (let at (str_find text needle from))
            (if (lt at 0) acc
                (sl-count-go text needle (add at (str_len needle)) (add acc 1)))))
    (defn sl-count (text needle) (sl-count-go text needle 0 0))
    (defn sl-name-key (name) (str_concat "name=" (str_concat name " ")))
    ; every line mentioning the name, additions and releases alike
    (defn sl-mentions (ledger name) (sl-count ledger (sl-name-key name)))
    (defn sl-releases (ledger name)
        (sl-count ledger (str_concat "stone=released " (sl-name-key name))))
    ; mentions = additions + releases; standing while additions > releases
    (defn sl-standing? (ledger name)
        (if (gt (sl-mentions ledger name) (mul 2 (sl-releases ledger name))) 1 0))
    0)
