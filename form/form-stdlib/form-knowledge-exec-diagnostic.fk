; form-knowledge-exec-diagnostic.fk -- preregistered, exact-source-disjoint
; local reasoning diagnostic over the body's real control APIs.
;
; This is a four-CONDITION diagnostic, not an efficacy estimate:
;   A closed-book compatible base first attempt
;   B the same base with one answer-free query-token/current-source observation
;   C B's exact retained attempt continued after bounded execution diagnostics
;   D closed-book compatible base plus the existing Form LoRA
;
; C is not a fourth independent sample.  Retrieval-assisted execution is not
; learned-weight mastery.  Exact source novelty is observed from post-training
; commits; concept novelty is not claimed.
;
; Source group, split, nonce, harness and challenge identity were frozen before
; any model candidate was generated.  The group remains denied to later
; training so this diagnostic can be replayed without relabeling it.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
; preludes: form-stdlib/sha256.fk form-stdlib/hex.fk
; preludes: form-stdlib/native-model-evidence.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
;
; Proven by: form-stdlib/tests/form-knowledge-exec-diagnostic-band.fk

(do
    (defn fked-schema () "form-exec-diagnostic-v1")
    (defn fked-split () "heldout-before-derivation")
    (defn fked-training-denied? () 1)
    (defn fked-nonce () "20260826T012801Z-local-exec-1")
    (defn fked-challenge-id ()
        "59cb1b298ad94c111b19943580a4155bb332efec3b3d85a7b132f1a2e8866b70")
    (defn fked-harness-sha ()
        "a771e529c659f80074956abebda8ef73b30376bd74a72a9a568d3bf501cde169")

    (defn fked-offer-path () "control/offer-ack-core.fk")
    (defn fked-choice-path () "control/choice-lane-core.fk")
    (defn fked-curriculum-path ()
        "form/form-stdlib/bml-bmf-control-curriculum.fk")
    (defn fked-offer-sha ()
        "179d034df125c4b6a22c72586b99a12537898f161ee377c5867470e7868cf65a")
    (defn fked-choice-sha ()
        "af2c1676446bb4fe27bc1e8257bc89d611d4437025a2049c4d7a0bcc4ff31396")
    (defn fked-curriculum-sha ()
        "7f0f12aee1a994d483bed84e4514d0ee9663cec8f2ccca83743e4cf40d64a7ec")
    (defn fked-source-commits ()
        (list
            "d02007245ddd7e1dd5fb98e881847a7f415e4771"
            "682b643bbb6a3f5f48e968836b39447c7d3ad853"
            "caca1f07384de6b8f611dd21dd24963d96a86ffa"))
    (defn fked-source-paths ()
        (list (fked-offer-path) (fked-choice-path) (fked-curriculum-path)))
    (defn fked-source-shas ()
        (list (fked-offer-sha) (fked-choice-sha) (fked-curriculum-sha)))
    (defn fked-file-sha (path) (nmfe-sha256 (read_file path)))
    (defn fked-sources-current? ()
        (if (and (str_eq (fked-file-sha (fked-offer-path)) (fked-offer-sha))
            (and (str_eq (fked-file-sha (fked-choice-path)) (fked-choice-sha))
                 (str_eq (fked-file-sha (fked-curriculum-path))
                         (fked-curriculum-sha)))) 1 0))

    (defn fked-cat (xs)
        (if (nil? xs) "" (str_concat (head xs) (fked-cat (tail xs)))))
    (defn fked-query ()
        "control consequence composition; exact heldout source group")
    (defn fked-query-surface ()
        (fked-cat (list (fkqt-open) (fked-query) (fkqt-close))))

    ; The compact lesson is deterministically derived from the three current
    ; sources.  It contains signatures and behavior, never candidate code,
    ; evaluator bits, expected output, or a repair.
    (defn fked-lesson ()
        (fked-cat (list
            "Current-source lesson. oac-nothing() is canonical first-class nothing. "
            "oac-one(payload-node) constructs a ONE acknowledgement and oac-payload(ack) reads it. "
            "Every offered lane is a one-argument recipe receiving args. "
            "oac-choice(alts,args) skips nothing and returns the first non-nothing acknowledgement. "
            "oac-cut-with-receipt(alts,args) commits the first acknowledgement even when it is nothing; "
            "oac-cut-receipt-ack(receipt) and oac-cut-receipt-pruned(receipt) expose the kept ack and untried count. "
            "oac-undo(ack,checkpoint,memory) restores checkpoint when ack is nothing. "
            "oac-timeout-walk(alts,args,budget) returns [ack,budget-left,alts-left]; "
            "oac-timeout-ack, oac-timeout-budget-left, oac-timeout-alts-left and oac-timed-out? inspect it. "
            "Native nothing, integer 0 and integer 1 remain distinct values.")))
    (defn fked-lesson-sha () (nmfe-sha256 (fked-lesson)))

    ; observation = schema status challenge request-token source-paths shas
    ;               lesson-sha lesson executed model-executed group-lookups
    ;               remote http file-reads
    (defn fked-current-source-observation ()
        (do
            (let request (fkqt-parse (fked-query-surface)))
            (if (not (eq (fkqt-request-ready? request) 1))
                (list "exec-diagnostic-source-observation-v1" "nothing"
                    (fked-challenge-id) (nothing) (empty) (empty) "" ""
                    0 0 0 0 0 0)
                (if (eq (fked-sources-current?) 0)
                    (list "exec-diagnostic-source-observation-v1" "failure"
                        (fked-challenge-id) (fkqt-request-token request)
                        (fked-source-paths) (fked-source-shas) "" ""
                        1 0 1 0 0 3)
                    (list "exec-diagnostic-source-observation-v1" "hit"
                        (fked-challenge-id) (fkqt-request-token request)
                        (fked-source-paths) (fked-source-shas)
                        (fked-lesson-sha) (fked-lesson)
                        1 0 1 0 0 3)))))
    (defn fked-observation-status (o) (nth o 1))
    (defn fked-observation-request (o) (nth o 3))
    (defn fked-observation-lesson (o) (nth o 7))
    (defn fked-observation-executed? (o) (nth o 8))
    (defn fked-observation-model-executed? (o) (nth o 9))
    (defn fked-observation-group-lookups (o) (nth o 10))
    (defn fked-observation-remote (o) (nth o 11))
    (defn fked-observation-http (o) (nth o 12))
    (defn fked-observation-file-reads (o) (nth o 13))

    (defn fked-base-prompt ()
        (fked-cat (list
            "Return only one complete executable Form source file: no Markdown fences, prose, score, or predicted output. "
            "The file will live under observe/ and must import ../control/offer-ack-core.fk and ../control/choice-lane-core.fk. "
            "Define five zero-argument entrypoints. fkecc-presence returns a native three-value list containing first-class nothing, integer 0, integer 1 in that order. "
            "fkecc-choice runs the canonical choice mechanism over a silent lane followed by a lane acknowledging ONE with integer payload 1, and returns the acknowledgement. "
            "fkecc-cut runs canonical cut over those same two lanes and returns its receipt. "
            "fkecc-undo applies canonical undo to a nothing acknowledgement, checkpoint 41 and current memory 99. "
            "fkecc-timeout walks the silent then ONE lanes with budget 1 and returns the timeout walk. "
            "Helpers may be defined. Finish the source with 0 so importing it has no candidate verdict. "
            "This is challenge " (fked-challenge-id) ".")))

    (defn fked-rag-prompt ()
        (do
            (let observation (fked-current-source-observation))
            (if (not (str_eq (fked-observation-status observation) "hit"))
                (nothing)
                (fked-cat (list (fked-base-prompt)
                    "\n\nAnswer-free query token:\n" (fked-query-surface)
                    "\nTyped current-source observation challenge="
                    (fked-challenge-id) " lesson-sha=" (fked-lesson-sha)
                    "\n" (fked-observation-lesson observation))))))

    (defn fked-repair-prompt (candidate diagnostic)
        (fked-cat (list (fked-rag-prompt)
            "\n\nContinue the exact retained attempt below. Do not resample from scratch. "
            "Use only the bounded parser/runtime diagnostic; it contains no oracle code or expected vector. "
            "Return one complete replacement Form source and nothing else.\nATTEMPT:\n"
            candidate "\nDIAGNOSTIC:\n" diagnostic)))

    0)
