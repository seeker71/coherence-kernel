; living-world-recipe-tree-relation-offer.fk -- a recurrent relation may be
; offered back to the exact participants whose current successor exposed it.
;
; The nursery does not choose.  This membrane makes one proposal per exact
; invariant/operator combination and preserves zero, one, or many proposals.
; A single proposal is convenient, not privileged: no ordering or score elects
; among plural alternatives.  Each proposal carries the whole diagnostic field,
; alternatives, unknowns, and optional declaration/timeout positions.  The
; positions default to nothing and may be populated only by a later exact offer.
;
; The relation Recipe remains inactive after relation admission.  Admission
; activates only the emergent relation candidate, through the ordinary tending
; round and unanimous active participant acknowledgments.  Parent change or
; revocation invalidates exact reconstruction; local relation revocation closes
; only this layer.
;
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-prospective-suite.fk form-stdlib/living-world-hypothesis-revision-nursery.fk form-stdlib/living-world-recipe-tree.fk form-stdlib/living-world-recipe-tree-hypothesis.fk form-stdlib/living-world-recipe-tree-prospective.fk form-stdlib/living-world-recipe-tree-revision.fk form-stdlib/living-world-recipe-tree-revision-trial.fk form-stdlib/living-world-recipe-tree-revision-hypothesis.fk form-stdlib/living-world-recipe-tree-revision-prospective.fk form-stdlib/living-world-recipe-tree-relation-nursery.fk

(let LWRRO-CHOICE (bp "LWRRO-CHOICE"))
(let LWRRO-ORIGIN (bp "LWRRO-ORIGIN"))

; children: exact current relation field, invariant, viable trial, optional
; declaration, alternatives, unknowns, optional timeout, evidence, local path.
(defn lwrro-choice
    (field invariant trial declaration alternatives unknowns timeout evidence)
    (intern_node LWRRO-CHOICE
        (list field invariant trial declaration alternatives unknowns timeout
              evidence (lwo-local-path))))
(defn lwrro-choice? (cell) (lwo-category? cell LWRRO-CHOICE))
(defn lwrro-choice-field (choice) (nth (node_children choice) 0))
(defn lwrro-choice-invariant (choice) (nth (node_children choice) 1))
(defn lwrro-choice-trial (choice) (nth (node_children choice) 2))
(defn lwrro-choice-declaration (choice) (nth (node_children choice) 3))
(defn lwrro-choice-alternatives (choice) (nth (node_children choice) 4))
(defn lwrro-choice-unknowns (choice) (nth (node_children choice) 5))
(defn lwrro-choice-timeout (choice) (nth (node_children choice) 6))
(defn lwrro-choice-evidence (choice) (nth (node_children choice) 7))

(defn lwrro-optional-declaration-valid? (declaration)
    (if (node_eq declaration (lwo-none)) 1
        (lwlc-declaration-valid? declaration)))
(defn lwrro-optional-timeout-valid? (timeout)
    (if (node_eq timeout (lwo-none)) 1 (oac-timeout-valid? timeout)))
(defn lwrro-choice-members-valid? (field invariant trial)
    (if (eq (lwrrn-field? field) 0) 0
        (if (eq (lwo-field-has?
                    (lwrrn-field-invariants field) invariant) 0) 0
            (lwo-field-has? (lwrrn-field-viable field) trial))))
(defn lwrro-choice-observation-valid? (invariant trial)
    (if (eq (lwph-consistent? (lwrrn-trial-state trial)) 0) 0
        (if (not (eq (lwrrn-trial-exact trial)
                     (lwrrn-trial-total trial))) 0
            (if (lt (lwrrn-trial-total trial) 2) 0
                (if (lt (lwo-field-size
                            (lwrrn-invariant-support invariant)) 2) 0 1)))))
(defn lwrro-choice-valid? (choice)
    (if (eq (lwrro-choice? choice) 0) 0
        (do
            (let field (lwrro-choice-field choice))
            (let invariant (lwrro-choice-invariant choice))
            (let trial (lwrro-choice-trial choice))
            (if (eq (lwrro-choice-members-valid?
                        field invariant trial) 0) 0
                (if (eq (lwrro-choice-observation-valid?
                            invariant trial) 0) 0
                    (if (eq (lwrro-optional-declaration-valid?
                                (lwrro-choice-declaration choice)) 0) 0
                        (lwrro-optional-timeout-valid?
                            (lwrro-choice-timeout choice))))))))

(defn lwrro-canonical-choice (field invariant trial)
    (lwrro-choice field invariant trial (lwo-none)
        (lwrrn-field-trials field) (lwrrn-field-unknowns field)
        (lwo-none) field))

; children: exact parent, suite, recurrence threshold, and exact choice.
(defn lwrro-origin (parent suite threshold choice)
    (intern_node LWRRO-ORIGIN
        (list parent suite (intern_trivial_int threshold) choice
              (lwo-local-path))))
(defn lwrro-origin-parent (origin) (nth (node_children origin) 0))
(defn lwrro-origin-suite (origin) (nth (node_children origin) 1))
(defn lwrro-origin-threshold (origin)
    (node_value (nth (node_children origin) 2)))
(defn lwrro-origin-choice (origin) (nth (node_children origin) 3))

(defn lwrro-parent-witnesses (world parent)
    (lwo-active-attributions-for world parent))
(defn lwrro-choice-current? (world parent suite threshold choice)
    (if (eq (lwrro-choice-valid? choice) 0) 0
        (do
            (let field (lwrrn-field-for world parent suite threshold))
            (if (node_eq field (lwo-none)) 0
                (node_eq field (lwrro-choice-field choice))))))

(defn lwrro-proposal-from-current-choice
    (world parent suite threshold choice)
    (if (eq (lwrro-choice-valid? choice) 0) (lwo-none)
        (do
            (let witnesses (lwrro-parent-witnesses world parent))
            (let participants
                (lwt-sources-from-attributions
                    (lwo-field-items witnesses) (lwo-empty-field)))
            (if (or (lt (lwo-field-size witnesses) threshold)
                    (eq (lwo-field-size participants) 0))
                (lwo-none)
                (do
                    (let trial (lwrro-choice-trial choice))
                    (let invariant (lwrro-choice-invariant choice))
                    (let origin (lwrro-origin parent suite threshold choice))
                    (let candidate
                        (lwo-emergent choice witnesses
                            (intern_trivial_int (lwrrn-trial-exact trial))
                            (intern_trivial_int
                                (lwo-field-size
                                    (lwrrn-invariant-support invariant)))
                            (intern_trivial_int threshold) origin))
                    (lwt-proposal candidate participants origin))))))
(defn lwrro-proposal-from-choice (world parent suite threshold choice)
    (if (eq (lwrro-choice-current?
                world parent suite threshold choice) 0) (lwo-none)
        (lwrro-proposal-from-current-choice
            world parent suite threshold choice)))

(defn lwrro-proposals-for-trials
    (world parent suite threshold field invariant trials proposals)
    (if (eq (len trials) 0) proposals
        (do
            (let choice
                (lwrro-canonical-choice field invariant (head trials)))
            (let proposal
                (lwrro-proposal-from-current-choice
                    world parent suite threshold choice))
            (lwrro-proposals-for-trials world parent suite threshold field
                invariant (tail trials)
                (if (node_eq proposal (lwo-none)) proposals
                    (lwo-field-add proposals proposal))))))
(defn lwrro-proposals-for-invariants
    (world parent suite threshold field invariants trials proposals)
    (if (eq (len invariants) 0) proposals
        (lwrro-proposals-for-invariants world parent suite threshold field
            (tail invariants) trials
            (lwrro-proposals-for-trials world parent suite threshold field
                (head invariants) trials proposals))))

(defn lwrro-proposals-for (world parent suite threshold)
    (do
        (let field (lwrrn-field-for world parent suite threshold))
        (if (node_eq field (lwo-none)) (lwo-empty-field)
            (lwrro-proposals-for-invariants world parent suite threshold field
                (lwo-field-items (lwrrn-field-invariants field))
                (lwo-field-items (lwrrn-field-viable field))
                (lwo-empty-field)))))

; Convenience exposes the unambiguous case only.  Plural remains plural and
; zero remains nothing; neither is collapsed by ordering.
(defn lwrro-ready-proposal (proposals)
    (if (eq (lwo-field-size proposals) 1)
        (head (lwo-field-items proposals)) (lwo-none)))

(defn lwrro-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwrro-choice? (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwrro-candidate-current? (world candidate)
    (if (eq (lwrro-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let parent (lwrro-origin-parent origin))
            (let suite (lwrro-origin-suite origin))
            (let threshold (lwrro-origin-threshold origin))
            (let prior-choice (lwrro-origin-choice origin))
            ; `lwrrn-field-for` already performs the complete parent/suite
            ; currentness check.  Reuse its exact result below rather than
            ; rebuilding that graph through the public proposal boundary.
            (let field (lwrrn-field-for world parent suite threshold))
            (if (node_eq field (lwo-none)) 0
                (do
                    (let fresh-choice
                        (lwrro-choice field
                            (lwrro-choice-invariant prior-choice)
                            (lwrro-choice-trial prior-choice)
                            (lwrro-choice-declaration prior-choice)
                            (lwrrn-field-trials field)
                            (lwrrn-field-unknowns field)
                            (lwrro-choice-timeout prior-choice) field))
                    (let fresh
                        (lwrro-proposal-from-current-choice world parent suite
                            threshold fresh-choice))
                    (if (node_eq fresh (lwo-none)) 0
                        (node_eq candidate
                            (lwt-proposal-candidate fresh))))))))
(defn lwrro-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwrro-candidate-current? world candidate) 1)) 1 0))
(defn lwrro-integrate (round proposal action)
    (if (eq (lwrro-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

(defn lwrro-progress-target (proposals)
    (lcfb-cat (list
        "proposals:" (int_to_str (lwo-field-size proposals))
        ":ready:" (int_to_str
            (not (node_eq (lwrro-ready-proposal proposals) (lwo-none))))
        ":plural:" (int_to_str (gt (lwo-field-size proposals) 1)))))

; witnessed: 2026-08-09 -> relation offer/ack/currentness/revocation observed on fkwu
