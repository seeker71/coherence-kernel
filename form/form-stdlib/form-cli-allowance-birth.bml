; form-cli-allowance-birth.bml — BML names the add; JIT births it.
;
; Yes was surprised the 5 was Form-CPU and JIT sat quiet. It sat quiet
; because we never asked metal_pipeline / metal_enqueue. BML is not a
; second binary — it is this section: lhs 2, rhs 3, expect 5.
;
; Authority is this section.
;
// preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-allowance-birth-band.fk
; witnessed: 2026-08-20 -> 255

section [form.lift] {
    allow alb-lhs() = 2;
    allow alb-rhs() = 3;
    allow alb-expect() = 5;
    allow alb-bml() = alb-lhs() + alb-rhs();
    allow alb-check() = add(if alb-lhs() == 2 then 1 else 0, add(if alb-rhs() == 3 then 2 else 0, add(if alb-expect() == 5 then 4 else 0, if alb-bml() == 5 then 8 else 0)));
    0;
}
