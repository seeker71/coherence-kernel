//////////////////////////////////////////////////////////////////////
//
// form-node-category.bml — executable explicit node category binding.
//
// Authority: form-stdlib/bml/form-node-category.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/operator-type-id.bml form/form-stdlib/line-grammar.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormNodeCategory {
        field FNCSchema = "form-node-category-binding-v1";
        field FNCPackedSchema = "form-node-id-packed-v1";
        field FNCPackedStatus = "packed";
        field FNCPackOverflowStatus = "overflow";
        field FNCBase36Digits = "0123456789abcdefghijklmnopqrstuvwxyz";
        field FNCPack32PackageMax = 15;
        field FNCPack32LevelMax = 15;
        field FNCPack32TypeMax = 255;
        field FNCPack32InstanceMax = 65535;
        field FNCPack64PackageMax = 255;
        field FNCPack64LevelMax = 255;
        field FNCPack64TypeMax = 65535;

        def fnc-cat(parts) = (Comparable) len(parts) == 0 ? "" : (Comparable) len(tail(parts)) == 0 ? head(parts) : head(parts) ++ fnc-cat(tail(parts));
        def fnc-node-id-string(node) = fnc-cat(list(int_to_str(node_pkg(node)), ".", int_to_str(node_level(node)), ".", int_to_str(node_type(node)), ".", int_to_str(node_inst(node))));
        def fnc-digits-at?(text, position) = position >= str_len(text) ? 1 : str_find("0123456789", substring(text, position, position + 1), 0) < 0 ? 0 : fnc-digits-at?(text, position + 1);
        def fnc-uint?(text) = is-blank?(text) ? 0 : fnc-digits-at?(text, 0);
        def fnc-node-part?(text, ceiling) = !((Comparable) fnc-uint?(text) == 1) ? 0 : (str_to_int(text) <= ceiling);
        def fnc-node-id?(text) {
            let parts = split-on(text, ".");
            !((Comparable) len(parts) == 4) ? 0 : !((Comparable) fnc-node-part?(parts[0], oti-family-capacity() - 1) == 1) ? 0 : !((Comparable) fnc-node-part?(parts[1], oti-family-capacity() - 1) == 1) ? 0 : !((Comparable) fnc-node-part?(parts[2], oti-family-capacity() - 1) == 1) ? 0 : fnc-node-part?(parts[3], oti-operation-capacity() - 1);
        }
        def fnc-family-id(categoryId) {
            let parts = split-on(categoryId, ".");
            !((Comparable) len(parts) == 4) ? "invalid" : fnc-cat(list(parts[0], ".", parts[1], ".", parts[2]));
        }
        def fnc-family-id?(text) {
            let parts = split-on(text, ".");
            !((Comparable) len(parts) == 3) ? 0 : !((Comparable) fnc-node-part?(parts[0], oti-family-capacity() - 1) == 1) ? 0 : !((Comparable) fnc-node-part?(parts[1], oti-family-capacity() - 1) == 1) ? 0 : fnc-node-part?(parts[2], oti-family-capacity() - 1);
        }
        def fnc-role?(role) = match (String) role { "blueprint" | "recipe" | "cell" | "value" => 1, _ => 0 };
        def fnc-label?(text) = is-blank?(text) ? 0 : str_find(text, "|", 0) >= 0 ? 0 : str_find(text, ",", 0) >= 0 ? 0 : 1;
        def fnc-binding(cellId, categoryId, familyId, role, stageType) = list(FNCSchema(), cellId, categoryId, familyId, role, stageType);
        def fnc-binding-cell(binding) = binding[1];
        def fnc-binding-category(binding) = binding[2];
        def fnc-binding-family(binding) = binding[3];
        def fnc-binding-role(binding) = binding[4];
        def fnc-binding-type(binding) = binding[5];
        def fnc-binding-valid?(binding) = !((Comparable) len(binding) == 6) ? 0 : !((String) head(binding) == FNCSchema()) ? 0 : !((Comparable) fnc-node-id?(fnc-binding-cell(binding)) == 1) ? 0 : !((Comparable) fnc-node-id?(fnc-binding-category(binding)) == 1) ? 0 : !((Comparable) fnc-family-id?(fnc-binding-family(binding)) == 1) ? 0 : !((String) fnc-binding-family(binding) == fnc-family-id(fnc-binding-category(binding))) ? 0 : !((Comparable) fnc-role?(fnc-binding-role(binding)) == 1) ? 0 : fnc-label?(fnc-binding-type(binding));
        def fnc-from-node(node, role, stageType) {
            let category = node_category(node);
            fnc-binding(fnc-node-id-string(node), fnc-node-id-string(category), fnc-family-id(fnc-node-id-string(category)), role, stageType);
        }
        def fnc-binding-wire(binding) = fnc-cat(list(fnc-binding-cell(binding), "|", fnc-binding-category(binding), "|", fnc-binding-family(binding), "|", fnc-binding-role(binding), "|", fnc-binding-type(binding)));
        def fnc-binding-from-fields(fields, start) = fnc-binding(fields[start], fields[start + 1], fields[start + 2], fields[start + 3], fields[start + 4]);

        // These transport profiles admit external coordinate tuples and keep
        // their wire spelling stable. Native node storage is one generated
        // 64-bit word defined by native-node-word.bml. A Form integer cannot
        // expose every unsigned 64-bit pattern, so transport uses exact u32 limbs.
        def fnc-packed(status, width, high, low, reason) = list(FNCPackedSchema(), status, width, high, low, reason);
        def fnc-packed-status(packed) = packed[1];
        def fnc-packed-width(packed) = packed[2];
        def fnc-packed-high(packed) = packed[3];
        def fnc-packed-low(packed) = packed[4];
        def fnc-packed-reason(packed) = packed[5];
        def fnc-pack-overflow(reason) = fnc-packed(FNCPackOverflowStatus(), 0, 0, 0, reason);
        def fnc-packed-shape?(packed) = !((Comparable) len(packed) == 6) ? 0 : !((String) head(packed) == FNCPackedSchema()) ? 0 : 1;
        def fnc-packed-ok?(packed) = !((Comparable) fnc-packed-shape?(packed) == 1) ? 0 : !((String) fnc-packed-status(packed) == FNCPackedStatus()) ? 0 : !(((Comparable) fnc-packed-width(packed) == 32) || ((Comparable) fnc-packed-width(packed) == 64)) ? 0 : !((Comparable) oti-u32?(fnc-packed-high(packed)) == 1) ? 0 : !((Comparable) oti-u32?(fnc-packed-low(packed)) == 1) ? 0 : ((Comparable) fnc-packed-width(packed) == 32) && (!((Comparable) fnc-packed-high(packed) == 0)) ? 0 : 1;
        def fnc-pack32-fits?(pkg, lvl, typ, inst) = pkg > FNCPack32PackageMax() ? 0 : lvl > FNCPack32LevelMax() ? 0 : typ > FNCPack32TypeMax() ? 0 : inst > FNCPack32InstanceMax() ? 0 : 1;
        def fnc-pack64-fits?(pkg, lvl, typ, inst) = pkg > FNCPack64PackageMax() ? 0 : lvl > FNCPack64LevelMax() ? 0 : typ > FNCPack64TypeMax() ? 0 : oti-u32?(inst);
        def fnc-pack32-values(pkg, lvl, typ, inst) = fnc-packed(FNCPackedStatus(), 32, 0, (pkg * 268435456) + ((lvl * 16777216) + ((typ * 65536) + inst)), "p4.l4.t8.i16");
        def fnc-pack64-values(pkg, lvl, typ, inst) = fnc-packed(FNCPackedStatus(), 64, (pkg * 16777216) + ((lvl * 65536) + typ), inst, "p8.l8.t16.i32");
        def fnc-transport-coordinate?(pkg, lvl, typ, inst) = oti-u16?(pkg) && (oti-u16?(lvl) && (oti-u16?(typ) && oti-u32?(inst)));
        def fnc-pack-values(pkg, lvl, typ, inst) = !((Comparable) fnc-transport-coordinate?(pkg, lvl, typ, inst) == 1) ? fnc-pack-overflow("coordinate-outside-u16.u16.u16.u32") : (Comparable) fnc-pack32-fits?(pkg, lvl, typ, inst) == 1 ? fnc-pack32-values(pkg, lvl, typ, inst) : (Comparable) fnc-pack64-fits?(pkg, lvl, typ, inst) == 1 ? fnc-pack64-values(pkg, lvl, typ, inst) : fnc-pack-overflow("coordinate-exceeds-p8.l8.t16.i32");
        def fnc-pack-node(node) = fnc-pack-values(node_pkg(node), node_level(node), node_type(node), node_inst(node));
        def fnc-unpack32(packed) {
            let word = fnc-packed-low(packed);
            let pkg = word / 268435456;
            let afterPkg = word % 268435456;
            let lvl = afterPkg / 16777216;
            let afterLvl = afterPkg % 16777216;
            let typ = afterLvl / 65536;
            list(pkg, lvl, typ, afterLvl % 65536);
        }
        def fnc-unpack64(packed) {
            let high = fnc-packed-high(packed);
            let pkg = high / 16777216;
            let afterPkg = high % 16777216;
            let lvl = afterPkg / 65536;
            list(pkg, lvl, afterPkg % 65536, fnc-packed-low(packed));
        }
        def fnc-unpack(packed) = !((Comparable) fnc-packed-ok?(packed) == 1) ? nothing() : (Comparable) fnc-packed-width(packed) == 32 ? fnc-unpack32(packed) : fnc-unpack64(packed);
        def fnc-packed-roundtrip?(packed, pkg, lvl, typ, inst) = !((Comparable) fnc-packed-ok?(packed) == 1) ? 0 : ((Value) fnc-unpack(packed) == list(pkg, lvl, typ, inst));

        // Base36 shortens each u32 limb to at most seven bytes. It is only a
        // projection of the numeric limbs and decodes with an explicit u32
        // ceiling; identity and comparisons remain numeric.  There is exactly
        // one spelling: lowercase, no leading zeroes, and no overflow alias.
        def fnc-base36(value) = value < 36 ? substring(FNCBase36Digits(), value, value + 1) : fnc-base36(value / 36) ++ substring(FNCBase36Digits(), value % 36, (value % 36) + 1);
        def fnc-base36-parse-loop(text, at, value) {
            at >= str_len(text) ? value
            : fnc-base36-parse-digit(text, at, value, str_find(FNCBase36Digits(), substring(text, at, at + 1), 0));
        }
        def fnc-base36-parse-digit(text, at, value, digit) = digit < 0 ? nothing() : value > ((oti-u32-max() - digit) / 36) ? nothing() : fnc-base36-parse-loop(text, at + 1, (value * 36) + digit);
        def fnc-base36-parse(text) = (Comparable) str_len(text) == 0 ? nothing() : fnc-base36-parse-loop(text, 0, 0);
        def fnc-base36-canonical?(text) {
            let value = fnc-base36-parse(text);
            nothing?(value) ? 0 : ((String) fnc-base36(value) == text);
        }
        def fnc-packed-key(packed) = !((Comparable) fnc-packed-ok?(packed) == 1) ? nothing() : (Comparable) fnc-packed-width(packed) == 32 ? "n32." ++ fnc-base36(fnc-packed-low(packed)) : fnc-cat(list("n64.", fnc-base36(fnc-packed-high(packed)), ".", fnc-base36(fnc-packed-low(packed))));
        def fnc-packed-from-key32(parts) {
            let low = fnc-base36-parse(parts[1]);
            !((Comparable) fnc-base36-canonical?(parts[1]) == 1) ? fnc-pack-overflow("packed-key-noncanonical") : fnc-packed(FNCPackedStatus(), 32, 0, low, "p4.l4.t8.i16");
        }
        def fnc-packed-from-key64(parts) {
            let high = fnc-base36-parse(parts[1]);
            let low = fnc-base36-parse(parts[2]);
            (!((Comparable) fnc-base36-canonical?(parts[1]) == 1)) || (!((Comparable) fnc-base36-canonical?(parts[2]) == 1)) ? fnc-pack-overflow("packed-key-noncanonical") : fnc-packed(FNCPackedStatus(), 64, high, low, "p8.l8.t16.i32");
        }
        def fnc-packed-adaptive-key?(packed, text) {
            let coordinate = fnc-unpack(packed);
            nothing?(coordinate) ? 0 : ((String) fnc-packed-key(fnc-pack-values(coordinate[0], coordinate[1], coordinate[2], coordinate[3])) == text);
        }
        def fnc-packed-from-key-candidate(text, parts) = ((Comparable) len(parts) == 2) && ((String) head(parts) == "n32") ? fnc-packed-from-key32(parts) : ((Comparable) len(parts) == 3) && ((String) head(parts) == "n64") ? fnc-packed-from-key64(parts) : fnc-pack-overflow("packed-key-shape");
        def fnc-packed-from-key(text) {
            let parts = split-on(text, ".");
            let candidate = fnc-packed-from-key-candidate(text, parts);
            !((Comparable) fnc-packed-ok?(candidate) == 1) ? candidate : (Comparable) fnc-packed-adaptive-key?(candidate, text) == 1 ? candidate : fnc-pack-overflow("packed-key-nonadaptive");
        }
    }
    0;
}
