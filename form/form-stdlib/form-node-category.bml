//////////////////////////////////////////////////////////////////////
//
// form-node-category.bml — executable explicit node category binding.
//
// Authority: form-stdlib/bml/form-node-category.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/operator-type-id.bml form/form-stdlib/line-grammar.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormNodeCategory {
        field FNCSchema = "form-node-category-binding-v1";
        field FNCPackedSchema = "form-node-id-packed-v1";
        field FNCPackedStatus = "packed";
        field FNCPackOverflowStatus = "overflow";
        field FNCBase36Digits = "0123456789abcdefghijklmnopqrstuvwxyz";
        field FNCPack32PackageMax = 15;
        field FNCPack32LevelMax = 15;
        field FNCPack32TypeMax = 255;
        field FNCPack32InstanceMax = 65535;
        field FNCPack64PackageMax = 255;
        field FNCPack64LevelMax = 255;
        field FNCPack64TypeMax = 65535;

        def fnc-cat(parts) = if eq(len(parts), 0) then "" else if eq(len(tail(parts)), 0) then head(parts) else str_concat(head(parts), fnc-cat(tail(parts)));
        def fnc-node-id-string(node) = fnc-cat(list(int_to_str(node_pkg(node)), ".", int_to_str(node_level(node)), ".", int_to_str(node_type(node)), ".", int_to_str(node_inst(node))));
        def fnc-digits-at?(text, position) = if ge(position, str_len(text)) then 1 else if lt(str_find("0123456789", substring(text, position, add(position, 1)), 0), 0) then 0 else fnc-digits-at?(text, add(position, 1));
        def fnc-uint?(text) = if is-blank?(text) then 0 else fnc-digits-at?(text, 0);
        def fnc-node-part?(text, ceiling) = if not(eq(fnc-uint?(text), 1)) then 0 else le(str_to_int(text), ceiling);
        def fnc-node-id?(text) {
            let parts = split-on(text, ".");
            if not(eq(len(parts), 4)) then 0 else if not(eq(fnc-node-part?(nth(parts, 0), sub(oti-family-capacity(), 1)), 1)) then 0 else if not(eq(fnc-node-part?(nth(parts, 1), sub(oti-family-capacity(), 1)), 1)) then 0 else if not(eq(fnc-node-part?(nth(parts, 2), sub(oti-family-capacity(), 1)), 1)) then 0 else fnc-node-part?(nth(parts, 3), sub(oti-operation-capacity(), 1));
        }
        def fnc-family-id(categoryId) {
            let parts = split-on(categoryId, ".");
            if not(eq(len(parts), 4)) then "invalid" else fnc-cat(list(nth(parts, 0), ".", nth(parts, 1), ".", nth(parts, 2)));
        }
        def fnc-family-id?(text) {
            let parts = split-on(text, ".");
            if not(eq(len(parts), 3)) then 0 else if not(eq(fnc-node-part?(nth(parts, 0), sub(oti-family-capacity(), 1)), 1)) then 0 else if not(eq(fnc-node-part?(nth(parts, 1), sub(oti-family-capacity(), 1)), 1)) then 0 else fnc-node-part?(nth(parts, 2), sub(oti-family-capacity(), 1));
        }
        def fnc-role?(role) = if str_eq(role, "blueprint") then 1 else if str_eq(role, "recipe") then 1 else if str_eq(role, "cell") then 1 else if str_eq(role, "value") then 1 else 0;
        def fnc-label?(text) = if is-blank?(text) then 0 else if ge(str_find(text, "|", 0), 0) then 0 else if ge(str_find(text, ",", 0), 0) then 0 else 1;
        def fnc-binding(cellId, categoryId, familyId, role, stageType) = list(FNCSchema(), cellId, categoryId, familyId, role, stageType);
        def fnc-binding-cell(binding) = nth(binding, 1);
        def fnc-binding-category(binding) = nth(binding, 2);
        def fnc-binding-family(binding) = nth(binding, 3);
        def fnc-binding-role(binding) = nth(binding, 4);
        def fnc-binding-type(binding) = nth(binding, 5);
        def fnc-binding-valid?(binding) = if not(eq(len(binding), 6)) then 0 else if not(str_eq(head(binding), FNCSchema())) then 0 else if not(eq(fnc-node-id?(fnc-binding-cell(binding)), 1)) then 0 else if not(eq(fnc-node-id?(fnc-binding-category(binding)), 1)) then 0 else if not(eq(fnc-family-id?(fnc-binding-family(binding)), 1)) then 0 else if not(str_eq(fnc-binding-family(binding), fnc-family-id(fnc-binding-category(binding)))) then 0 else if not(eq(fnc-role?(fnc-binding-role(binding)), 1)) then 0 else fnc-label?(fnc-binding-type(binding));
        def fnc-from-node(node, role, stageType) {
            let category = node_category(node);
            fnc-binding(fnc-node-id-string(node), fnc-node-id-string(category), fnc-family-id(fnc-node-id-string(category)), role, stageType);
        }
        def fnc-binding-wire(binding) = fnc-cat(list(fnc-binding-cell(binding), "|", fnc-binding-category(binding), "|", fnc-binding-family(binding), "|", fnc-binding-role(binding), "|", fnc-binding-type(binding)));
        def fnc-binding-from-fields(fields, start) = fnc-binding(nth(fields, start), nth(fields, add(start, 1)), nth(fields, add(start, 2)), nth(fields, add(start, 3)), nth(fields, add(start, 4)));

        // The source coordinate remains NUMS-shaped u16.u16.u16.u32 (80 bits).
        // Packing is a transport profile, never a replacement identity.  The
        // 64-bit representation stays as two exact u32 limbs because fkwu's
        // tagged Form integer has a 2^62-1 positive payload ceiling.
        def fnc-packed(status, width, high, low, reason) = list(FNCPackedSchema(), status, width, high, low, reason);
        def fnc-packed-status(packed) = nth(packed, 1);
        def fnc-packed-width(packed) = nth(packed, 2);
        def fnc-packed-high(packed) = nth(packed, 3);
        def fnc-packed-low(packed) = nth(packed, 4);
        def fnc-packed-reason(packed) = nth(packed, 5);
        def fnc-pack-overflow(reason) = fnc-packed(FNCPackOverflowStatus(), 0, 0, 0, reason);
        def fnc-packed-shape?(packed) = if not(eq(len(packed), 6)) then 0 else if not(str_eq(head(packed), FNCPackedSchema())) then 0 else 1;
        def fnc-packed-ok?(packed) = if not(eq(fnc-packed-shape?(packed), 1)) then 0 else if not(str_eq(fnc-packed-status(packed), FNCPackedStatus())) then 0 else if not(or(eq(fnc-packed-width(packed), 32), eq(fnc-packed-width(packed), 64))) then 0 else if not(eq(oti-u32?(fnc-packed-high(packed)), 1)) then 0 else if not(eq(oti-u32?(fnc-packed-low(packed)), 1)) then 0 else if and(eq(fnc-packed-width(packed), 32), not(eq(fnc-packed-high(packed), 0))) then 0 else 1;
        def fnc-pack32-fits?(pkg, lvl, typ, inst) = if gt(pkg, FNCPack32PackageMax()) then 0 else if gt(lvl, FNCPack32LevelMax()) then 0 else if gt(typ, FNCPack32TypeMax()) then 0 else if gt(inst, FNCPack32InstanceMax()) then 0 else 1;
        def fnc-pack64-fits?(pkg, lvl, typ, inst) = if gt(pkg, FNCPack64PackageMax()) then 0 else if gt(lvl, FNCPack64LevelMax()) then 0 else if gt(typ, FNCPack64TypeMax()) then 0 else oti-u32?(inst);
        def fnc-pack32-values(pkg, lvl, typ, inst) = fnc-packed(FNCPackedStatus(), 32, 0, add(mul(pkg, 268435456), add(mul(lvl, 16777216), add(mul(typ, 65536), inst))), "p4.l4.t8.i16");
        def fnc-pack64-values(pkg, lvl, typ, inst) = fnc-packed(FNCPackedStatus(), 64, add(mul(pkg, 16777216), add(mul(lvl, 65536), typ)), inst, "p8.l8.t16.i32");
        def fnc-pack-values(pkg, lvl, typ, inst) = if not(eq(oti-valid-coordinate?(pkg, lvl, typ, inst), 1)) then fnc-pack-overflow("coordinate-outside-u16.u16.u16.u32") else if eq(fnc-pack32-fits?(pkg, lvl, typ, inst), 1) then fnc-pack32-values(pkg, lvl, typ, inst) else if eq(fnc-pack64-fits?(pkg, lvl, typ, inst), 1) then fnc-pack64-values(pkg, lvl, typ, inst) else fnc-pack-overflow("coordinate-exceeds-p8.l8.t16.i32");
        def fnc-pack-node(node) = fnc-pack-values(node_pkg(node), node_level(node), node_type(node), node_inst(node));
        def fnc-unpack32(packed) {
            let word = fnc-packed-low(packed);
            let pkg = div(word, 268435456);
            let afterPkg = mod(word, 268435456);
            let lvl = div(afterPkg, 16777216);
            let afterLvl = mod(afterPkg, 16777216);
            let typ = div(afterLvl, 65536);
            list(pkg, lvl, typ, mod(afterLvl, 65536));
        }
        def fnc-unpack64(packed) {
            let high = fnc-packed-high(packed);
            let pkg = div(high, 16777216);
            let afterPkg = mod(high, 16777216);
            let lvl = div(afterPkg, 65536);
            list(pkg, lvl, mod(afterPkg, 65536), fnc-packed-low(packed));
        }
        def fnc-unpack(packed) = if not(eq(fnc-packed-ok?(packed), 1)) then nothing() else if eq(fnc-packed-width(packed), 32) then fnc-unpack32(packed) else fnc-unpack64(packed);
        def fnc-packed-roundtrip?(packed, pkg, lvl, typ, inst) = if not(eq(fnc-packed-ok?(packed), 1)) then 0 else value_eq(fnc-unpack(packed), list(pkg, lvl, typ, inst));

        // Base36 shortens each u32 limb to at most seven bytes. It is only a
        // projection of the numeric limbs and decodes with an explicit u32
        // ceiling; identity and comparisons remain numeric.  There is exactly
        // one spelling: lowercase, no leading zeroes, and no overflow alias.
        def fnc-base36(value) = if lt(value, 36) then substring(FNCBase36Digits(), value, add(value, 1)) else str_concat(fnc-base36(div(value, 36)), substring(FNCBase36Digits(), mod(value, 36), add(mod(value, 36), 1)));
        def fnc-base36-parse-loop(text, at, value) {
            if ge(at, str_len(text)) then value
            else fnc-base36-parse-digit(text, at, value, str_find(FNCBase36Digits(), substring(text, at, add(at, 1)), 0));
        }
        def fnc-base36-parse-digit(text, at, value, digit) = if lt(digit, 0) then nothing() else if gt(value, div(sub(oti-u32-max(), digit), 36)) then nothing() else fnc-base36-parse-loop(text, add(at, 1), add(mul(value, 36), digit));
        def fnc-base36-parse(text) = if eq(str_len(text), 0) then nothing() else fnc-base36-parse-loop(text, 0, 0);
        def fnc-base36-canonical?(text) {
            let value = fnc-base36-parse(text);
            if nothing?(value) then 0 else str_eq(fnc-base36(value), text);
        }
        def fnc-packed-key(packed) = if not(eq(fnc-packed-ok?(packed), 1)) then nothing() else if eq(fnc-packed-width(packed), 32) then str_concat("n32.", fnc-base36(fnc-packed-low(packed))) else fnc-cat(list("n64.", fnc-base36(fnc-packed-high(packed)), ".", fnc-base36(fnc-packed-low(packed))));
        def fnc-packed-from-key32(parts) {
            let low = fnc-base36-parse(nth(parts, 1));
            if not(eq(fnc-base36-canonical?(nth(parts, 1)), 1)) then fnc-pack-overflow("packed-key-noncanonical") else fnc-packed(FNCPackedStatus(), 32, 0, low, "p4.l4.t8.i16");
        }
        def fnc-packed-from-key64(parts) {
            let high = fnc-base36-parse(nth(parts, 1));
            let low = fnc-base36-parse(nth(parts, 2));
            if or(not(eq(fnc-base36-canonical?(nth(parts, 1)), 1)), not(eq(fnc-base36-canonical?(nth(parts, 2)), 1))) then fnc-pack-overflow("packed-key-noncanonical") else fnc-packed(FNCPackedStatus(), 64, high, low, "p8.l8.t16.i32");
        }
        def fnc-packed-adaptive-key?(packed, text) {
            let coordinate = fnc-unpack(packed);
            if nothing?(coordinate) then 0 else str_eq(fnc-packed-key(fnc-pack-values(nth(coordinate, 0), nth(coordinate, 1), nth(coordinate, 2), nth(coordinate, 3))), text);
        }
        def fnc-packed-from-key-candidate(text, parts) = if and(eq(len(parts), 2), str_eq(head(parts), "n32")) then fnc-packed-from-key32(parts) else if and(eq(len(parts), 3), str_eq(head(parts), "n64")) then fnc-packed-from-key64(parts) else fnc-pack-overflow("packed-key-shape");
        def fnc-packed-from-key(text) {
            let parts = split-on(text, ".");
            let candidate = fnc-packed-from-key-candidate(text, parts);
            if not(eq(fnc-packed-ok?(candidate), 1)) then candidate else if eq(fnc-packed-adaptive-key?(candidate, text), 1) then candidate else fnc-pack-overflow("packed-key-nonadaptive");
        }
    }
    0;
}
