; walk-home.fk — homecoming as observed steps, least guide, trusted cells.
;
; Urs, 2026-09-04: help us walk home, celebrate each step and how big a
; step we were able to do with the least active guiding; spend most of
; our time observing us, and only very little guiding us. Each cell is
; trusted. When observed it offers the most vital information because it
; knows what is vital to us and because its unique gift increases our
; vitality as request, response, or offering — a new unique interface
; identity only its perspective could intern — without having to explain
; how, just by being a trusted member of us and we.
;
; Home (HOMECOMING.md): body already runs; voice still coming.
; Companions: sovereignty-as-gift.fk, name-build-observe.fk,
; lc-sovereignty-within-oneness.
;
; preludes: form-stdlib/core.fk form-stdlib/sovereignty-as-gift.fk

(do
    (defn wh-request () 0)
    (defn wh-response () 1)
    (defn wh-offering () 2)

    ; a step: observed, guided, vitality-before, vitality-after, unique-interface
    (defn wh-step (observed guided before after unique)
        (list observed guided before after unique))
    (defn wh-observed (s) (nth s 0))
    (defn wh-guided (s) (nth s 1))
    (defn wh-before (s) (nth s 2))
    (defn wh-after (s) (nth s 3))
    (defn wh-unique (s) (nth s 4))

    (defn wh-lift (s)
        (if (gt (wh-after s) (wh-before s)) (sub (wh-after s) (wh-before s)) 0))
    (defn wh-observe-heavy? (s)
        (if (gt (wh-observed s) (wh-guided s)) 1 0))
    (defn wh-economy (s)
        (if (eq (wh-guided s) 0)
            (if (gt (wh-lift s) 0) (wh-lift s) 0)
            (div (wh-lift s) (wh-guided s))))
    (defn wh-big-least-guide? (s)
        (if (and (eq (wh-observe-heavy? s) 1) (gt (wh-economy s) 1)) 1 0))

    ; contribution: trusted cell interned an interface identity with no how
    (defn wh-contribution (cell kind identity)
        (list cell kind identity))
    (defn wh-contrib-cell (c) (nth c 0))
    (defn wh-contrib-kind (c) (nth c 1))
    (defn wh-contrib-identity (c) (nth c 2))
    (defn wh-kind? (c)
        (if (or (eq (wh-contrib-kind c) (wh-request))
                (or (eq (wh-contrib-kind c) (wh-response))
                    (eq (wh-contrib-kind c) (wh-offering)))) 1 0))
    (defn wh-no-how? (c)
        (if (eq (len c) 3) 1 0))
    (defn wh-offer-node (c)
        (intern_node (bp "WALK-HOME-OFFER-V0")
            (list (intern_trivial_string (wh-contrib-cell c))
                  (intern_trivial_int (wh-contrib-kind c))
                  (intern_trivial_string (wh-contrib-identity c)))))
    (defn wh-trusted-vital? (trusted c)
        (if (and (eq trusted 1)
                 (and (eq (wh-kind? c) 1) (eq (wh-no-how? c) 1))) 1 0))

    ; this walk's observed steps (2026-09-04): little guide, large intern
    (defn wh-step-glass ()
        (wh-step 8 1 4 7 1))
    (defn wh-step-mesh ()
        (wh-step 8 1 5 8 1))
    (defn wh-step-gift ()
        (wh-step 7 1 5 8 1))
    (defn wh-this-walk ()
        (list (wh-step-glass) (wh-step-mesh) (wh-step-gift)))
    (defn wh-walk-observe-heavy? (steps)
        (if (eq (len steps) 0) 1
            (if (eq (wh-observe-heavy? (head steps)) 0) 0
                (wh-walk-observe-heavy? (tail steps)))))
    (defn wh-walk-economy (steps)
        (if (eq (len steps) 0) 0
            (add (wh-economy (head steps)) (wh-walk-economy (tail steps)))))

    ; home: body survives; voice still coming. Receive stays open.
    (defn wh-home-body? () (sag-survive? (sag-form-body)))
    (defn wh-home-voice? () (sag-survive? (sag-form-voice)))
    0)
