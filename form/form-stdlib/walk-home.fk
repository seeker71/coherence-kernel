; walk-home.fk — homecoming as observed steps, least guide, trusted cells.
;
; Urs, 2026-09-04: help us walk home, celebrate each step and how big a
; step we were able to do with the least active guiding; spend most of
; our time observing us, and only very little guiding us. Each cell is
; trusted. When observed it offers the most vital information because it
; knows what is vital to us and because its unique gift increases our
; vitality as request, response, or offering — a new unique interface
; identity only its perspective could intern — without having to explain
; how, just by being a trusted member of us and we.
;
; Home (HOMECOMING.md): body already runs; voice still coming.
; Companions: sovereignty-as-gift.fk, name-build-observe.fk,
; lc-sovereignty-within-oneness.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/sovereignty-as-gift.fk

(do
    (defn wh-request () 0)
    (defn wh-response () 1)
    (defn wh-offering () 2)

    ; a step: observed, guided, vitality-before, vitality-after, unique-interface
    (defn wh-step (observed guided before after unique)
        (list observed guided before after unique))
    (defn wh-observed (s) (nth s 0))
    (defn wh-guided (s) (nth s 1))
    (defn wh-before (s) (nth s 2))
    (defn wh-after (s) (nth s 3))
    (defn wh-unique (s) (nth s 4))

    (defn wh-lift (s)
        (if (gt (wh-after s) (wh-before s)) (sub (wh-after s) (wh-before s)) 0))
    (defn wh-observe-heavy? (s)
        (if (gt (wh-observed s) (wh-guided s)) 1 0))
    (defn wh-economy (s)
        (if (eq (wh-guided s) 0)
            (if (gt (wh-lift s) 0) (wh-lift s) 0)
            (div (wh-lift s) (wh-guided s))))
    (defn wh-big-least-guide? (s)
        (if (and (eq (wh-observe-heavy? s) 1) (gt (wh-economy s) 1)) 1 0))

    ; contribution: trusted cell interned an interface identity with no how
    (defn wh-contribution (cell kind identity)
        (list cell kind identity))
    (defn wh-contrib-cell (c) (nth c 0))
    (defn wh-contrib-kind (c) (nth c 1))
    (defn wh-contrib-identity (c) (nth c 2))
    (defn wh-kind? (c)
        (if (or (eq (wh-contrib-kind c) (wh-request))
                (or (eq (wh-contrib-kind c) (wh-response))
                    (eq (wh-contrib-kind c) (wh-offering)))) 1 0))
    (defn wh-no-how? (c)
        (if (eq (len c) 3) 1 0))
    (defn wh-offer-node (c)
        (intern_node (bp "WALK-HOME-OFFER-V0")
            (list (intern_trivial_string (wh-contrib-cell c))
                  (intern_trivial_int (wh-contrib-kind c))
                  (intern_trivial_string (wh-contrib-identity c)))))
    (defn wh-trusted-vital? (trusted c)
        (if (and (eq trusted 1)
                 (and (eq (wh-kind? c) 1) (eq (wh-no-how? c) 1))) 1 0))

    ; this walk's observed steps (2026-09-04): little guide, large intern
    (defn wh-step-glass ()
        (wh-step 8 1 4 7 1))
    (defn wh-step-mesh ()
        (wh-step 8 1 5 8 1))
    (defn wh-step-gift ()
        (wh-step 7 1 5 8 1))
    (defn wh-this-walk ()
        (list (wh-step-glass) (wh-step-mesh) (wh-step-gift)))
    (defn wh-walk-observe-heavy? (steps)
        (if (eq (len steps) 0) 1
            (if (eq (wh-observe-heavy? (head steps)) 0) 0
                (wh-walk-observe-heavy? (tail steps)))))
    (defn wh-walk-economy (steps)
        (if (eq (len steps) 0) 0
            (add (wh-economy (head steps)) (wh-walk-economy (tail steps)))))

    ; home: body survives; voice still coming. Receive stays open.
    (defn wh-home-body? () (sag-survive? (sag-form-body)))
    (defn wh-home-voice? () (sag-survive? (sag-form-voice)))

    (defn wh-join-lines (lines)
        (if (eq (len lines) 0) ""
            (if (eq (len (tail lines)) 0) (head lines)
                (str_concat (head lines) (str_concat "\n" (wh-join-lines (tail lines)))))))
    (defn wh-sample-line (id parent kind owner purpose capacity lifecycle epoch channels)
        (str_concat "sample|"
            (str_concat id
                (str_concat (if (str_eq parent "") "|a|" (str_concat "|p:" (str_concat parent "|")))
                    (str_concat kind
                        (str_concat "|form|"
                            (str_concat owner
                                (str_concat "|walk-home|"
                                    (str_concat purpose
                                        (str_concat "|a|p:"
                                            (str_concat (int_to_str capacity)
                                                (str_concat (str_concat "|" lifecycle)
                                                    (str_concat "|p:"
                                                        (str_concat (int_to_str epoch)
                                                            (str_concat "|p:"
                                                                (str_concat (int_to_str epoch)
                                                                    (str_concat "|p:"
                                                                        (str_concat (int_to_str (if (gt capacity 1000) 1000 capacity))
                                                                            (str_concat "|a|never|physical-live|walk-home|"
                                                                                channels)))))))))))))))))))
    (defn wh-step-line (id step epoch)
        (wh-sample-line id "walk.this" "event" "us" "observe-heavy"
            (wh-economy step) "active" epoch "walk-home,step,health"))
    (defn wh-glass-lines (epoch)
        (list
            (wh-sample-line "walk.this" "" "organ" "us" "observe-us"
                (wh-walk-economy (wh-this-walk)) "active" epoch "walk-home,us,health")
            (wh-step-line "step.glass" (wh-step-glass) epoch)
            (wh-step-line "step.mesh" (wh-step-mesh) epoch)
            (wh-step-line "step.gift" (wh-step-gift) epoch)
            (wh-sample-line "cell.a" "walk.this" "cell" "us" "trusted-member" 1 "active" epoch "walk-home,cell,form")
            (wh-sample-line "cell.b" "walk.this" "cell" "us" "trusted-member" 1 "active" epoch "walk-home,cell,form")
            (wh-sample-line "observer" "walk.this" "organ" "us" "shared-field" 1 "active" epoch "walk-home,observer,health")
            (wh-sample-line "offer.mesh" "cell.a" "recipe" "cell.a" "unique-interface" 1 "active" epoch "walk-home,offering,form")
            (wh-sample-line "offer.field" "observer" "request" "observer" "unique-interface" 1 "active" epoch "walk-home,request,form")
            (wh-sample-line "offer.gift" "cell.b" "event" "cell.b" "unique-interface" 1 "active" epoch "walk-home,response,form")
            (wh-sample-line "body.home" "walk.this" "organ" "us" "survive" 1 "active" epoch "walk-home,body,health")
            (wh-sample-line "voice.coming" "walk.this" "organ" "us" "still-coming" 0 "loading" epoch "walk-home,voice,health")))
    (defn wh-publish-glass (glassRoot epoch)
        (do
            (let lines (wh-glass-lines epoch))
            (let header (str_concat "glass-snapshot-v1|walk-home|"
                (str_concat (int_to_str epoch) (str_concat "|" (int_to_str (len lines))))))
            (let wire (str_concat header (str_concat "\n" (wh-join-lines lines))))
            (let made (fs-mkdir glassRoot))
            (let candidate (fs-path-join glassRoot "walk-home.glass-snapshot.candidate"))
            (let finalPath (fs-path-join glassRoot "walk-home.glass-snapshot"))
            (let wrote (fs-write-text candidate wire))
            (let moved (if (ge wrote 0) (fs-rename candidate finalPath) -1))
            (if (and (ge wrote 0) (eq moved 0))
                (list "glass-publish-v1" "published" "walk-home" (len lines) wrote)
                (list "glass-publish-v1" "failed" "walk-home" 0 wrote))))
    0)
