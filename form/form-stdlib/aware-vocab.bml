//////////////////////////////////////////////////////////////////////
//
// aware-vocab.bml — the words this body has itself minted.
//
// Authority: form/form-stdlib/aware-vocab.bml
// preludes: form/form-stdlib/aware-axes.bml learn/homecoming-distillation-corpus.fk
//
// The `own` axis asks a narrower question than any dictionary can: not "is this
// a word" but "is this OUR word". The only honest answer is the body's own
// record of the words it named fresh -- one per distillation row, verified
// absent from the body at the moment it was offered. That list is the corpus
// itself, read as data, never a second copy of it.
//
// Built ONCE for a process's life and carried: hdc-rows() rebuilds the whole
// row list on every call, so a caller that asked per line would pay the corpus
// again per line.
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormAwareVocab {
        def awv-fresh-go(rows, acc) = if eq(len(rows), 0) then acc else awv-fresh-go(tail(rows), cons(hdc-fresh(head(rows)), acc));
        def awv-vocab() = awv-fresh-go(hdc-rows(), list());
        def awv-size() = len(awv-vocab());
    }
    0;
}
