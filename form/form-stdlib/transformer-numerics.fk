// transformer-numerics.fk — M3 of form-native-models.form: softmax, gelu, layernorm as proven Form.
//
// The stone that connects the layer math to a real transformer block: the three numerics every
// attention+FFN block needs (M4), composed from primitives only — exp by square-and-reduce Taylor,
// sqrt by fixed-count Newton, tanh from exp. All fp64; the recipe DEFINES the reduction order and
// the approximation, so every kernel computes the same bits (determinism is the feature, not the
// constraint). Format-parameterized variants (bf16/fp8 via apply_arith) are M1's stone, not this one.
// The band's claims are pinned to the PyTorch fp64 reference (softmax / layer_norm eps=1e-5 /
// gelu approximate='tanh'), each value reduced to an integer at 1e-6 — the conformance discipline
// turned toward the reference implementation the weights will arrive from (M6: whisper-tiny).
// --- scalar numerics: abs, exp, tanh, sqrt ---
section [form.bml] {
    def tn-abs(x) = x < 0.0 ? 0.0 - x : x;
    // exp: Taylor at 0 (14 terms, |x| <= 0.5), reached by halving, then squared back up.
    def tn-exp-acc(x, n, term, acc) = n > 14.0 ? acc : tn-exp-acc(x, n + 1.0, term * (x / n), acc + term * (x / n));
    def tn-exp-small(x) = tn-exp-acc(x, 1.0, 1.0, 1.0);
    def tn-pow2k(v, k) = (Comparable) k == 0 ? v : tn-pow2k(v * v, k - 1);
    def tn-exp-reduce(x, k) = tn-abs(x) <= 0.5 ? tn-pow2k(tn-exp-small(x), k) : tn-exp-reduce(x / 2.0, k + 1);
    def tn-exp(x) = tn-exp-reduce(x, 0);
    // tanh from exp: (e^2x − 1) / (e^2x + 1)
    def tn-tanh-of(e2x) = (e2x - 1.0) / (e2x + 1.0);
    def tn-tanh(x) = tn-tanh-of(tn-exp(2.0 * x));
    // sqrt: Newton from the value itself, fixed 50 iterations — converged is a fixed point, so the
    // count buys determinism, not drift.
    def tn-sqrt-iter(v, g, n) = (Comparable) n == 0 ? g : tn-sqrt-iter(v, 0.5 * (g + v / g), n - 1);
    def tn-sqrt(v) = v <= 0.0 ? 0.0 : tn-sqrt-iter(v, v, 50);
    // tn-rsqrt — 1/sqrt(v) as its own recipe, beside tn-sqrt rather than as 1/tn-sqrt. Newton on
    // y <- y*(1.5 - 0.5*v*y*y) carries no division once it starts, which is the form a GPU normalizer
    // wants, and the form an emitted-bytes rsqrt takes when it has no recipe to answer
    // to. The seed 1/(1+v) is its one division, named rather than hidden, and it sits inside Newton's
    // basin for every v > 0 (v*y0*y0 <= 1/4 < 3), so the walk cannot diverge; climbing from below
    // multiplies y by about 1.5 a step, so 80 steps reach v = 1e20 with room to spare.
    def tn-rsqrt-iter(v, y, n) = (Comparable) n == 0 ? y : tn-rsqrt-iter(v, y * (1.5 - 0.5 * (v * (y * y))), n - 1);
    def tn-rsqrt(v) = v <= 0.0 ? 0.0 : tn-rsqrt-iter(v, 1.0 / (1.0 + v), 80);
    // --- vector helpers (float-counted: no int/float mixing) ---
    def tn-flen(xs) = (Comparable) len(xs) == 0 ? 0.0 : 1.0 + tn-flen(tail(xs));
    def tn-sum-acc(acc, xs) = (Comparable) len(xs) == 0 ? acc : tn-sum-acc(acc + head(xs), tail(xs));
    def tn-sum(xs) = tn-sum-acc(0.0, xs);
    def tn-max-acc(best, xs) = (Comparable) len(xs) == 0 ? best : head(xs) > best ? tn-max-acc(head(xs), tail(xs)) : tn-max-acc(best, tail(xs));
    def tn-max(xs) = tn-max-acc(head(xs), tail(xs));
    def tn-sub-scalar(xs, c) = (Comparable) len(xs) == 0 ? empty() : cons(head(xs) - c, tn-sub-scalar(tail(xs), c));
    def tn-scale(xs, s) = (Comparable) len(xs) == 0 ? empty() : cons(head(xs) * s, tn-scale(tail(xs), s));
    def tn-exp-map(xs) = (Comparable) len(xs) == 0 ? empty() : cons(tn-exp(head(xs)), tn-exp-map(tail(xs)));
    // --- softmax: max-subtract for stability, exp, normalize ---
    def tn-softmax-norm(es) = tn-scale(es, 1.0 / tn-sum(es));
    def tn-softmax(xs) = tn-softmax-norm(tn-exp-map(tn-sub-scalar(xs, tn-max(xs))));
    // --- layernorm: biased variance, eps inside the sqrt (the torch shape), gamma=1 beta=0 ---
    def tn-mean(xs) = tn-sum(xs) / tn-flen(xs);
    def tn-var-acc(m, acc, xs) = (Comparable) len(xs) == 0 ? acc : tn-var-acc(m, acc + (head(xs) - m) * (head(xs) - m), tail(xs));
    def tn-var(xs) = tn-var-acc(tn-mean(xs), 0.0, xs) / tn-flen(xs);
    def tn-layernorm(xs, eps) = tn-scale(tn-sub-scalar(xs, tn-mean(xs)), 1.0 / tn-sqrt(tn-var(xs) + eps));
    // --- gelu: the tanh approximation (whisper/GPT lineage), 0.5·x·(1 + tanh(√(2/π)·(x + 0.044715·x³))) ---
    def tn-gelu(x) = 0.5 * x * (1.0 + tn-tanh(0.7978845608028654 * (x + 0.044715 * (x * (x * x)))));
}
