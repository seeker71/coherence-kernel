// bml-bmf-control-curriculum.fk -- executable control semantics for local teaching.
//
// This curriculum is deliberately behavioral.  It does not teach the model to
// merely spell choice/cut/undo/timeout/JIT/thought-kernel names; the held-out
// band makes the choices, observes the acknowledgements, restores a checkpoint,
// and exhausts a real step budget.
//
// Ground:
//   control/offer-ack-core.fk       one invocation/communication mechanism
//   control/choice-lane-core.fk     choice/cut/store/restore/undo/timeout
//   form/form-stdlib/jit-decision.fk hot+pure admission with hysteresis
//   observe/inquiry-planes.fk       computable and learned thought kernels
//
// Honest JIT boundary: `bbcc-auto-jit-plan` makes the repository's actual
// crystallize/melt decision and executes the semantic Form recipe.  It does not
// claim a native carrier was installed or called; that requires separate live
// execution evidence.
//
// witnessed: 2026-08-24 -> direct fkwu held-out band
// preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/jit-decision.fk observe/inquiry-planes.fk
section [form.bml] {
    def bbcc-feature(name, status, source) = ["bml-bmf-control-feature", name, status, source];
    def bbcc-feature-name(row) = row[1];
    def bbcc-feature-status(row) = row[2];
    def bbcc-manifest() = [bbcc-feature("choice-executes-first-evidenced-winner", 1, "control/offer-ack-core.fk:oac-choice"), bbcc-feature("ambiguity-abstains-as-nothing", 1, "bbcc-evidence-choice"), bbcc-feature("cut-commits-and-prunes", 1, "control/choice-lane-core.fk:oac-cut-with-receipt"), bbcc-feature("undo-restores-checkpoint", 1, "control/choice-lane-core.fk:oac-undo"), bbcc-feature("timeout-is-budgeted-nothing", 1, "control/choice-lane-core.fk:oac-timeout-walk"), bbcc-feature("nothing-distinct-from-zero-one", 1, "bbcc-nothing-vector"), bbcc-feature("auto-jit-is-earned-plan", 1, "form/form-stdlib/jit-decision.fk"), bbcc-feature("thought-kernels-route-by-plane", 1, "observe/inquiry-planes.fk"), bbcc-feature("live-native-jit-needs-carrier-proof", 1, "bbcc-auto-jit-plan")];
    def bbcc-manifest-has?(name, rows) = nil?(rows) ? 0 : (String) bbcc-feature-name(head(rows)) == name && (Comparable) bbcc-feature-status(head(rows)) == 1 ? 1 : bbcc-manifest-has?(name, tail(rows));
    // Curriculum rows use disjoint families between training and held-out.
    def bbcc-lesson(split, primitive, family, situation, expected, source) = ["bml-bmf-control-lesson", split, primitive, family, situation, expected, source];
    def bbcc-lesson-split(row) = row[1];
    def bbcc-lesson-primitive(row) = row[2];
    def bbcc-lesson-family(row) = row[3];
    def bbcc-lesson-situation(row) = row[4];
    def bbcc-lesson-expected(row) = row[5];
    def bbcc-training-rows() = [bbcc-lesson("train", "choice", "metric", "one metric lane declines and one supplies a witnessed node", "first non-nothing acknowledgement wins", "control/offer-ack-core.fk"), bbcc-lesson("train", "undo", "alarm", "an alarm candidate fails after a stored checkpoint", "restore the checkpoint value", "control/choice-lane-core.fk"), bbcc-lesson("train", "auto-jit", "route", "a hot pure route earns crystallization", "plan native; preserve Form semantic result", "form/form-stdlib/jit-decision.fk")];
    def bbcc-heldout-rows() = [bbcc-lesson("heldout", "choice-cut", "signal", "two signal lanes tie, then one obtains stronger evidence", "tie is nothing; stronger lane executes; cut prunes", "control/choice-lane-core.fk"), bbcc-lesson("heldout", "undo-timeout", "cursor-state", "a malformed stream follows a good checkpoint and a winner lies beyond budget", "undo exact state; timeout is nothing with alternatives left", "control/choice-lane-core.fk"), bbcc-lesson("heldout", "thought-jit", "why-plane", "route a why enquiry and decide whether its pure recipe is hot", "learned thought kernel executes; JIT remains an earned plan", "observe/inquiry-planes.fk")];
    def bbcc-row-exact?(a, b) = (String) bbcc-lesson-primitive(a) == bbcc-lesson-primitive(b) && ((String) bbcc-lesson-family(a) == bbcc-lesson-family(b) && ((String) bbcc-lesson-situation(a) == bbcc-lesson-situation(b) && (String) bbcc-lesson-expected(a) == bbcc-lesson-expected(b)));
    def bbcc-row-in?(row, rows) = nil?(rows) ? 0 : bbcc-row-exact?(row, head(rows)) ? 1 : bbcc-row-in?(row, tail(rows));
    def bbcc-leakage-loop(held, train) = nil?(held) ? 0 : bbcc-row-in?(head(held), train) + bbcc-leakage-loop(tail(held), train);
    def bbcc-exact-leakage() = bbcc-leakage-loop(bbcc-heldout-rows(), bbcc-training-rows());
    // Offered cells used by the held-out control walk.
    def bbcc-cell-silent(args) = oac-nothing();
    def bbcc-cell-twelve(args) = oac-one(intern_trivial_int(12));
    def bbcc-cell-thirty-four(args) = oac-one(intern_trivial_int(34));
    def bbcc-ack-int(ack) = (Comparable) oac-one?(ack) == 1 ? node_value(oac-payload(ack)) : 0 - 1;
    // Equal evidence is genuine ambiguity and abstains as first-class nothing.
    // Otherwise the better-evidenced lane is offered first, and normal choice
    // still skips a declining winner candidate if it cannot answer.
    def bbcc-evidence-choice(left-score, left-cell, right-score, right-cell, args) = (Comparable) left-score == right-score ? oac-nothing() : left-score > right-score ? oac-choice([left-cell, right-cell], args) : oac-choice([right-cell, left-cell], args);
    // A thought-kernel routing receipt.  This calls the actual inquiry-plane
    // recipes; missing planes remain nothing, never a guessed learned kernel.
    def bbcc-thought-route(word, gap, rate) = {
        let found = find-plane(the-planes(), word);
        nil?(found) ? nothing() : ["thought-kernel-route", word, p-kind(found), epochs-to-fluency(p-kind(found), gap, rate)];
    };
    // Automatic JIT decision plus semantic execution.  The receipt says PLAN,
    // never "native executed".  Hysteresis and purity come from jd-* directly.
    def bbcc-jit-plan-row(route, value, live-native) = ["auto-jit-plan", route, value, live-native];
    def bbcc-jit-plan-route(row) = row[1];
    def bbcc-jit-plan-value(row) = row[2];
    def bbcc-jit-plan-live-native?(row) = row[3];
    def bbcc-auto-jit-plan(heat, pure, loss-before, loss-after, epochs) = {
        let value = measure-rate(loss-before, loss-after, epochs);
        (Comparable) jd-crystallize?(heat, pure) == 1 ? bbcc-jit-plan-row("crystallize-plan", value, 0) : (Comparable) jd-melt?(heat) == 1 ? bbcc-jit-plan-row("melt-to-form", value, 0) : bbcc-jit-plan-row("form-walk", value, 0);
    };
    // Strict nothing vector.  It never orders, branches on, or computes with
    // nothing; only equality/nothing? on the four-way conformance surface.
    def bbcc-nothing-vector() = [nothing(), nothing?(nothing()), (Comparable) nothing() == 0, (Comparable) nothing() == 1, nothing?(0), nothing?(1)];
    0;
}
