; bml-bmf-control-curriculum.fk -- executable control semantics for local teaching.
;
; This curriculum is deliberately behavioral.  It does not teach the model to
; merely spell choice/cut/undo/timeout/JIT/thought-kernel names; the held-out
; band makes the choices, observes the acknowledgements, restores a checkpoint,
; and exhausts a real step budget.
;
; Ground:
;   control/offer-ack-core.fk       one invocation/communication mechanism
;   control/choice-lane-core.fk     choice/cut/store/restore/undo/timeout
;   observe/nothing-conformance.fk  nothing distinct from 0, 1, empty, ""
;   form/form-stdlib/jit-decision.fk hot+pure admission with hysteresis
;   observe/inquiry-planes.fk       computable and learned thought kernels
;   docs/native-thought-kernels.form sovereignty/measurement contract
;   receipts/2026-06-30-form-native-jit-live-execution-evidence.md
;
; Honest JIT boundary: `bbcc-auto-jit-plan` makes the repository's actual
; crystallize/melt decision and executes the semantic Form recipe.  It does not
; claim a native carrier was installed or called; that requires the separate
; live execution evidence suite named above.
;
; witnessed: 2026-08-24 -> direct fkwu held-out band
; preludes: form-stdlib/core.fk form-stdlib/json.fk form-stdlib/cache.fk form-stdlib/form-ontology-bp.fk control/offer-ack-core.fk control/choice-lane-core.fk form-stdlib/jit-decision.fk observe/inquiry-planes.fk

(do
    (defn bbcc-feature (name status source)
        (list "bml-bmf-control-feature" name status source))
    (defn bbcc-feature-name (row) (nth row 1))
    (defn bbcc-feature-status (row) (nth row 2))
    (defn bbcc-manifest ()
        (list
            (bbcc-feature "choice-executes-first-evidenced-winner" 1
                "control/offer-ack-core.fk:oac-choice")
            (bbcc-feature "ambiguity-abstains-as-nothing" 1
                "bbcc-evidence-choice")
            (bbcc-feature "cut-commits-and-prunes" 1
                "control/choice-lane-core.fk:oac-cut-with-receipt")
            (bbcc-feature "undo-restores-checkpoint" 1
                "control/choice-lane-core.fk:oac-undo")
            (bbcc-feature "timeout-is-budgeted-nothing" 1
                "control/choice-lane-core.fk:oac-timeout-walk")
            (bbcc-feature "nothing-distinct-from-zero-one" 1
                "observe/nothing-conformance.fk")
            (bbcc-feature "auto-jit-is-earned-plan" 1
                "form/form-stdlib/jit-decision.fk")
            (bbcc-feature "thought-kernels-route-by-plane" 1
                "observe/inquiry-planes.fk")
            (bbcc-feature "live-native-jit-needs-carrier-proof" 1
                "receipts/2026-06-30-form-native-jit-live-execution-evidence.md")))
    (defn bbcc-manifest-has? (name rows)
        (if (nil? rows) 0
            (if (and (str_eq (bbcc-feature-name (head rows)) name)
                     (eq (bbcc-feature-status (head rows)) 1))
                1
                (bbcc-manifest-has? name (tail rows)))))

    ; Curriculum rows use disjoint families between training and held-out.
    (defn bbcc-lesson (split primitive family situation expected source)
        (list "bml-bmf-control-lesson" split primitive family situation expected source))
    (defn bbcc-lesson-split (row) (nth row 1))
    (defn bbcc-lesson-primitive (row) (nth row 2))
    (defn bbcc-lesson-family (row) (nth row 3))
    (defn bbcc-lesson-situation (row) (nth row 4))
    (defn bbcc-lesson-expected (row) (nth row 5))
    (defn bbcc-training-rows ()
        (list
            (bbcc-lesson "train" "choice" "metric"
                "one metric lane declines and one supplies a witnessed node"
                "first non-nothing acknowledgement wins"
                "control/offer-ack-core.fk")
            (bbcc-lesson "train" "undo" "alarm"
                "an alarm candidate fails after a stored checkpoint"
                "restore the checkpoint value"
                "control/choice-lane-core.fk")
            (bbcc-lesson "train" "auto-jit" "route"
                "a hot pure route earns crystallization"
                "plan native; preserve Form semantic result"
                "form/form-stdlib/jit-decision.fk")))
    (defn bbcc-heldout-rows ()
        (list
            (bbcc-lesson "heldout" "choice-cut" "signal"
                "two signal lanes tie, then one obtains stronger evidence"
                "tie is nothing; stronger lane executes; cut prunes"
                "control/choice-lane-core.fk")
            (bbcc-lesson "heldout" "undo-timeout" "cursor-state"
                "a malformed stream follows a good checkpoint and a winner lies beyond budget"
                "undo exact state; timeout is nothing with alternatives left"
                "control/choice-lane-core.fk")
            (bbcc-lesson "heldout" "thought-jit" "why-plane"
                "route a why enquiry and decide whether its pure recipe is hot"
                "learned thought kernel executes; JIT remains an earned plan"
                "observe/inquiry-planes.fk")))
    (defn bbcc-row-exact? (a b)
        (and (str_eq (bbcc-lesson-primitive a) (bbcc-lesson-primitive b))
             (and (str_eq (bbcc-lesson-family a) (bbcc-lesson-family b))
                  (and (str_eq (bbcc-lesson-situation a) (bbcc-lesson-situation b))
                       (str_eq (bbcc-lesson-expected a) (bbcc-lesson-expected b))))))
    (defn bbcc-row-in? (row rows)
        (if (nil? rows) 0
            (if (bbcc-row-exact? row (head rows)) 1
                (bbcc-row-in? row (tail rows)))))
    (defn bbcc-leakage-loop (held train)
        (if (nil? held) 0
            (add (bbcc-row-in? (head held) train)
                 (bbcc-leakage-loop (tail held) train))))
    (defn bbcc-exact-leakage ()
        (bbcc-leakage-loop (bbcc-heldout-rows) (bbcc-training-rows)))

    ; Offered cells used by the held-out control walk.
    (defn bbcc-cell-silent (args) (oac-nothing))
    (defn bbcc-cell-twelve (args)
        (oac-one (intern_trivial_int 12)))
    (defn bbcc-cell-thirty-four (args)
        (oac-one (intern_trivial_int 34)))
    (defn bbcc-ack-int (ack)
        (if (eq (oac-one? ack) 1) (node_value (oac-payload ack)) (sub 0 1)))

    ; Equal evidence is genuine ambiguity and abstains as first-class nothing.
    ; Otherwise the better-evidenced lane is offered first, and normal choice
    ; still skips a declining winner candidate if it cannot answer.
    (defn bbcc-evidence-choice (left-score left-cell right-score right-cell args)
        (if (eq left-score right-score) (oac-nothing)
            (if (gt left-score right-score)
                (oac-choice (list left-cell right-cell) args)
                (oac-choice (list right-cell left-cell) args))))

    ; A thought-kernel routing receipt.  This calls the actual inquiry-plane
    ; recipes; missing planes remain nothing, never a guessed learned kernel.
    (defn bbcc-thought-route (word gap rate)
        (do
            (let found (find-plane (the-planes) word))
            (if (nil? found) (nothing)
                (list "thought-kernel-route" word (p-kind found)
                    (epochs-to-fluency (p-kind found) gap rate)))))

    ; Automatic JIT decision plus semantic execution.  The receipt says PLAN,
    ; never "native executed".  Hysteresis and purity come from jd-* directly.
    (defn bbcc-jit-plan-row (route value live-native)
        (list "auto-jit-plan" route value live-native))
    (defn bbcc-jit-plan-route (row) (nth row 1))
    (defn bbcc-jit-plan-value (row) (nth row 2))
    (defn bbcc-jit-plan-live-native? (row) (nth row 3))
    (defn bbcc-auto-jit-plan (heat pure loss-before loss-after epochs)
        (do
            (let value (measure-rate loss-before loss-after epochs))
            (if (eq (jd-crystallize? heat pure) 1)
                (bbcc-jit-plan-row "crystallize-plan" value 0)
                (if (eq (jd-melt? heat) 1)
                    (bbcc-jit-plan-row "melt-to-form" value 0)
                    (bbcc-jit-plan-row "form-walk" value 0)))))

    ; Strict nothing vector.  It never orders, branches on, or computes with
    ; nothing; only equality/nothing? on the four-way conformance surface.
    (defn bbcc-nothing-vector ()
        (list
            (nothing)
            (nothing? (nothing))
            (eq (nothing) 0)
            (eq (nothing) 1)
            (nothing? 0)
            (nothing? 1)))

    0)
