// blueprint-authority.fk -- policy for blueprint name/NodeID authority.
//
// This layer answers the "where does a blueprint name get its NodeID?" boundary
// without pretending to have migrated the full registry. The current Form
// runtime has a reviewed bootstrap `bp` table. The JSON registry is the
// authoring source. Target executable symbol/dependency truth belongs in
// program-image `.fkb`; that is not a claim that a live `.fkb` loader is
// installed today. `.sym` is a locale/domain presentation lens.
//
// This is pure policy over supplied rows. It does not read blueprint-registry
// JSON, import host tables, call `bp`, load `.fkb`, parse `.sym`, or grow the
// C seed.
//
import form-stdlib/core.fk;
section [form.bml] {
    def bpa-version() = "blueprint-authority-v1";
    def bpa-feature(name, status) = ["blueprint-authority-feature", name, status];
    def bpa-feature-name(f) = f[1];
    def bpa-feature-status(f) = f[2];
    def blueprint-authority-manifest() = [bpa-feature("reviewed-bootstrap-runtime-authority", 1), bpa-feature("registry-json-authoring-source", 1), bpa-feature("program-image-fkb-executable-symbol-truth", 1), bpa-feature("program-image-fkb-target-not-current-loader", 1), bpa-feature("sym-locale-domain-presentation-lens", 1), bpa-feature("unknown-name-refuse-or-investigate", 1), bpa-feature("no-fake-nodeid-fallback", 1), bpa-feature("no-runtime-json-registry-read", 1), bpa-feature("no-host-table-authority", 1), bpa-feature("no-c-seed-growth", 1)];
    def blueprint-authority-manifest-has?(name, fs) = nil?(fs) ? 0 : (String) bpa-feature-name(fs[0]) == name && (Comparable) bpa-feature-status(fs[0]) == 1 ? 1 : blueprint-authority-manifest-has?(name, fs[1:]);
    def bpa-kind-bootstrap() = "form-bootstrap";
    def bpa-kind-registry-json() = "registry-json";
    def bpa-kind-program-image-fkb() = "program-image-fkb";
    def bpa-kind-sym-lens() = "sym-lens";
    def bpa-kind-c-seed-growth() = "c-seed-growth";
    // row = ("blueprint-authority-row" kind admitted authoring current-runtime
    //        presentation executable-deps c-seed-growth)
    def bpa-row(kind, admitted, authoring, current-runtime, presentation, executable-deps, c-seed-growth) = ["blueprint-authority-row", kind, admitted, authoring, current-runtime, presentation, executable-deps, c-seed-growth];
    def bpa-row?(r) = (Comparable) len(r) == 8 ? (String) r[0] == "blueprint-authority-row" : 0;
    def bpa-kind(r) = r[1];
    def bpa-admitted(r) = r[2];
    def bpa-authoring(r) = r[3];
    def bpa-current-runtime(r) = r[4];
    def bpa-presentation(r) = r[5];
    def bpa-executable-deps(r) = r[6];
    def bpa-c-seed-growth(r) = r[7];
    def bpa-bootstrap-row() = bpa-row(bpa-kind-bootstrap(), 1, 0, 1, 0, 1, 0);
    def bpa-registry-json-row() = bpa-row(bpa-kind-registry-json(), 1, 1, 0, 0, 0, 0);
    def bpa-program-image-fkb-row() = bpa-row(bpa-kind-program-image-fkb(), 1, 0, 0, 0, 1, 0);
    def bpa-sym-lens-row() = bpa-row(bpa-kind-sym-lens(), 1, 0, 0, 1, 0, 0);
    def bpa-c-seed-growth-row() = bpa-row(bpa-kind-c-seed-growth(), 0, 0, 0, 0, 0, 1);
    def bpa-runtime-authority?(r) = bpa-row?(r) ? (Comparable) bpa-admitted(r) == 1 && ((Comparable) bpa-current-runtime(r) == 1 && ((Comparable) bpa-presentation(r) == 0 && (Comparable) bpa-c-seed-growth(r) == 0)) : 0;
    def bpa-authoring-source?(r) = bpa-row?(r) ? (Comparable) bpa-admitted(r) == 1 && ((Comparable) bpa-authoring(r) == 1 && (Comparable) bpa-current-runtime(r) == 0) : 0;
    def bpa-presentation-lens-only?(r) = bpa-row?(r) ? (Comparable) bpa-admitted(r) == 1 && ((Comparable) bpa-presentation(r) == 1 && ((Comparable) bpa-current-runtime(r) == 0 && (Comparable) bpa-executable-deps(r) == 0)) : 0;
    def bpa-executable-dependency-authority?(r) = bpa-row?(r) ? (Comparable) bpa-admitted(r) == 1 && ((Comparable) bpa-presentation(r) == 0 && ((Comparable) bpa-c-seed-growth(r) == 0 && (Comparable) bpa-executable-deps(r) == 1)) : 0;
    def bpa-c-seed-growth-refused?(r) = bpa-row?(r) ? (Comparable) bpa-c-seed-growth(r) == 1 && (Comparable) bpa-admitted(r) == 0 : 0;
    def bpa-sym-lens-admitted?(presentation-only, carries-executable-deps) = (Comparable) presentation-only == 1 ? (Comparable) carries-executable-deps == 1 ? 0 : 1 : 0;
    def bpa-status-admitted() = "admitted";
    def bpa-status-investigate() = "investigate";
    // resolution = ("blueprint-resolution" known status has-nodeid)
    def bpa-resolution(known) = ["blueprint-resolution", known, (Comparable) known == 1 ? bpa-status-admitted() : bpa-status-investigate(), (Comparable) known == 1 ? 1 : 0];
    def bpa-resolution-known(r) = r[1];
    def bpa-resolution-status(r) = r[2];
    def bpa-resolution-has-nodeid(r) = r[3];
    def bpa-unknown-refuses-nodeid?() = {
        let r = bpa-resolution(0);
        (Comparable) bpa-resolution-known(r) == 0 && ((String) bpa-resolution-status(r) == bpa-status-investigate() && (Comparable) bpa-resolution-has-nodeid(r) == 0);
    };
}
