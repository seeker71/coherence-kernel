; moe-route-wide-demo.fk — the fixture the wide router is judged on, emitted in
; the SCALAR/VEC stream metal_moe_gpu.sh's runner already parses.
;
; The GPU is judged against THIS BODY'S OWN recipe (mm-route-weights, fp64),
; never against a second hand-rolled reference — the same evidence discipline
; the DS4 GPU stones keep. What crosses to the runner is: the logits, and what
; the recipe says the answer is.
;
; WHY THE IDS CAN BE CHECKED EXACTLY. The fixture's logits are
; (i*97 mod 257)/32 - 4, so distinct experts sit at least 1/32 = 0.03125 apart
; in logit space — roughly six orders of magnitude above f32 epsilon near 1.
; The top-k selection therefore cannot be flipped by f32 rounding, and id
; equality is a legitimate EXACT gate rather than a tolerance in disguise. The
; weights are a different matter: the recipe folds in fp64 and the kernel in
; f32, so they get an envelope, and the envelope is stated as a bound rather
; than tuned to what came out.
;
; moe-route-radius.fk holds the shape, the fixture and the closed-form truth;
; this cell only prints them.
;
; The second fixture is the BML-crystallized Qwen3.8-Flash-Next shape: 512
; routed experts, 10 selected. Its increasing logits give an independent exact
; id truth [511..502], so the same runner exercises the widened radius rather
; than inferring it from emitted text.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/equireach.fk form-stdlib/format-arith.fk form-stdlib/f16-decode.fk form-stdlib/q6k-dequant.fk form-stdlib/q6k-msl.fk form-stdlib/transformer-numerics.fk form-stdlib/moe-msl.fk form-stdlib/moe-route-radius.fk form-stdlib/qwen4exp-flash-next-router-xtal.fk

; EMITTED ON fkwu, NOT ON THE GO SIBLING. The DS4 demo harnesses shell out to
; $GO_BIN for this stream because `print` is a Go-arm op that fkwu's door
; does not carry. AGENTS.md is explicit that the Go/Rust/TS kernels are proof
; siblings and never the runtime, so this cell reaches the same stream through
; fkwu's own `print_str` with core.fk's int_to_str/float_to_str. The fixture a
; GPU is judged against should come out of the kernel the body actually runs on.

(do
    (defn mrwd-nl (s) (print_str s))   ; print_str already terminates the line
    (defn mrwd-i (n) (mrwd-nl (int_to_str n)))
    (defn mrwd-f (x) (mrwd-nl (float_to_str x)))
    ; THE JUDGE IS EMITTED AS SCALED INTEGERS, AND THAT IS NOT FUSSINESS.
    ; float_to_str carries six decimals: it prints 0.13909075244867469 as
    ; "0.139091", losing 2.4e-7. An f32 computation's own relative error near 1
    ; is about 1e-7 — the SAME ORDER — so a fixture printed through float_to_str
    ; would have made the printer, not the arithmetic, the thing the envelope
    ; measured. The gate would have looked rigorous and been blind. Weights
    ; therefore cross as round(w * 1e9), nine significant digits, and the runner
    ; divides back. The plain-float vector rides along beside it for a human
    ; reading the stream, and is never the judge.
    (defn mrwd-scaled (x) (math_floor (add (mul x 1000000000.0) 0.5)))
    (defn mrwd-slist (xs) (if (eq (len xs) 0) (mrwd-nl "ENDVEC") (do (mrwd-i (mrwd-scaled (head xs))) (mrwd-slist (tail xs)))))
    (defn mrwd-svec (name xs) (do (mrwd-nl (str_concat "VEC " name)) (mrwd-slist xs)))
    (defn mrwd-plist (xs) (if (eq (len xs) 0) (mrwd-nl "ENDVEC") (do (mrwd-f (head xs)) (mrwd-plist (tail xs)))))
    (defn mrwd-ilist (xs) (if (eq (len xs) 0) (mrwd-nl "ENDVEC") (do (mrwd-i (head xs)) (mrwd-ilist (tail xs)))))
    (defn mrwd-vec (name xs) (do (mrwd-nl (str_concat "VEC " name)) (mrwd-plist xs)))
    (defn mrwd-ivec (name xs) (do (mrwd-nl (str_concat "VEC " name)) (mrwd-ilist xs)))
    (defn mrwd-scalar (name v) (do (mrwd-nl (str_concat "SCALAR " name)) (mrwd-i v)))

    (defn mrwd-emit-all ()
        (do
            (mrwd-nl "ROUTEWIDEDEMO")
            (mrwd-scalar "ne" (mrr-ne))
            (mrwd-scalar "nsel" (mrr-nsel))
            (mrwd-svec "logitsE9" (mrr-logits))       ; the input, at nine digits
            ; what the recipe answers — the judge
            (mrwd-ivec "expectIds" (mrr-ids))
            (mrwd-svec "expectWtsE9" (mrr-weights))   ; the judge
            (mrwd-vec  "expectWts"   (mrr-weights))   ; human-readable only
            ; the closed-form truth the recipe was itself checked against
            ; (i = 53*r mod 257), carried so the runner can confirm the judge
            ; agrees with arithmetic that never entered a softmax
            (mrwd-ivec "closedFormIds" (mrr-expected-ids))
            ; qwen4exp exact-radius fixture, authored in BML and crystallized
            (mrwd-scalar "q4_ne" (Q4ExpertCount))
            (mrwd-scalar "q4_nsel" (Q4SelectedCount))
            (mrwd-svec "q4_logitsE9" (q4r-logits))
            (mrwd-ivec "q4_expectIds" (q4r-ids))
            (mrwd-svec "q4_expectWtsE9" (q4r-weights))
            (mrwd-ivec "q4_closedFormIds" (q4r-expected-ids))
            (mrwd-nl "END")
            0))
    0)
