; living-world-capability-context.fk -- a restored body is not one open room.
;
; Any offered cell may name a purpose/capability. A holder may grant one of
; its own active payload attributions to that purpose by offering an LWCP-GRANT
; cell. Source identity is absent from the grant payload and recovered only
; from its active attribution. Shared payloads enter a context only when every
; active holder has an active exact grant; one holder cannot expose another's
; indistinguishable contribution. A holder may revoke only its own grant.
;
; A context is an authority-minimized world projection: only granted payloads,
; their active attributions, and granted relations enter. Historical events,
; ungranted cells, grant-control tissue, and revoked attributions do not leak
; into the projected world. The context retains exact grant evidence and the
; active purpose attribution, but never embeds the source world root. Existing
; enquiry and learning organs can run over the projection unchanged. A future
; native voice emitter must receive the same projected world, not raw storage.
;
; Capability cells and grant evidence are ontology-open offered tissue. This
; module names no query, training, language, or voice vocabulary.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk

(let LWCP-GRANT          (bp "LWCP-GRANT"))
(let LWCP-GRANT-EVIDENCE (bp "LWCP-GRANT-EVIDENCE"))
(let LWCP-PROJECTION     (bp "LWCP-PROJECTION"))
(let LWCP-CONTEXT        (bp "LWCP-CONTEXT"))

; children: payload, purpose/capability, offered evidence, local path.
; Source identity deliberately is absent.
(defn lwcp-grant (payload capability evidence)
    (intern_node LWCP-GRANT
        (list payload capability evidence (lwo-local-path))))
(defn lwcp-grant? (cell) (lwo-category? cell LWCP-GRANT))
(defn lwcp-grant-payload (grant) (nth (node_children grant) 0))
(defn lwcp-grant-capability (grant) (nth (node_children grant) 1))
(defn lwcp-grant-offered-evidence (grant) (nth (node_children grant) 2))
(defn lwcp-grant-path (grant) (nth (node_children grant) 3))

(defn lwcp-grant-for? (grant payload capability)
    (if (and (eq (lwcp-grant? grant) 1)
             (and (node_eq (lwcp-grant-payload grant) payload)
                  (node_eq (lwcp-grant-capability grant)
                           capability))) 1 0))

(defn lwcp-source-granted-items?
    (world items payload capability source)
    (if (eq (len items) 0) 0
        (do
            (let grant (head items))
            (if (and (eq (lwcp-grant-for?
                              grant payload capability) 1)
                     (and (eq (lwo-active-by?
                                  world grant source) 1)
                          (eq (lwo-active-by?
                                  world payload source) 1)))
                1
                (lwcp-source-granted-items? world (tail items)
                    payload capability source)))))

(defn lwcp-source-granted? (world payload capability source)
    (lwcp-source-granted-items? world
        (lwo-field-items (lwo-world-cells world))
        payload capability source))

(defn lwcp-holders-granted-items?
    (world items payload capability)
    (if (eq (len items) 0) 1
        (do
            (let source
                (lwo-attribution-source (head items)))
            (if (eq (lwcp-source-granted?
                        world payload capability source) 1)
                (lwcp-holders-granted-items? world (tail items)
                    payload capability) 0))))

(defn lwcp-authorized? (world payload capability)
    (if (or (eq (lwo-active? world capability) 0)
            (eq (lwo-active? world payload) 0)) 0
        (do
            (let holders (lwo-active-attributions-for world payload))
            (if (and (gt (lwo-field-size holders) 0)
                     (eq (lwcp-holders-granted-items? world
                            (lwo-field-items holders)
                            payload capability) 1)) 1 0))))

(defn lwcp-field-union-items (items acc)
    (if (eq (len items) 0) acc
        (lwcp-field-union-items (tail items)
            (lwo-field-add acc (head items)))))

; children: admitted cells, admitted relations, active attributions
(defn lwcp-projection (cells relations attributions)
    (intern_node LWCP-PROJECTION
        (list cells relations attributions)))
(defn lwcp-projection-cells (projection) (nth (node_children projection) 0))
(defn lwcp-projection-relations (projection) (nth (node_children projection) 1))
(defn lwcp-projection-attributions (projection)
    (nth (node_children projection) 2))

(defn lwcp-project-items
    (world items capability cells relations attributions)
    (if (eq (len items) 0)
        (lwcp-projection cells relations attributions)
        (do
            (let payload (head items))
            (if (eq (lwcp-authorized?
                        world payload capability) 0)
                (lwcp-project-items world (tail items) capability
                    cells relations attributions)
                (lwcp-project-items world (tail items) capability
                    (lwo-field-add cells payload)
                    (if (eq (lwo-relation? payload) 1)
                        (lwo-field-add relations payload) relations)
                    (lwcp-field-union-items
                        (lwo-field-items
                            (lwo-active-attributions-for world payload))
                        attributions))))))

; A projection filters each original field in place. Reassembling authorized
; payloads into a fresh accumulator reverses their order; in a content-
; addressed body that is not cosmetic, because it changes evidence identity.
(defn lwcp-filter-cells (world items capability)
    (if (eq (len items) 0) (lwo-empty-field)
        (do
            (let rest
                (lwcp-filter-cells world (tail items) capability))
            (if (eq (lwcp-authorized?
                        world (head items) capability) 1)
                (lwo-field-add rest (head items)) rest))))

(defn lwcp-filter-relations (world items capability)
    (if (eq (len items) 0) (lwo-empty-field)
        (do
            (let rest
                (lwcp-filter-relations world (tail items) capability))
            (if (eq (lwcp-authorized?
                        world (head items) capability) 1)
                (lwo-field-add rest (head items)) rest))))

(defn lwcp-filter-attributions (world items capability)
    (if (eq (len items) 0) (lwo-empty-field)
        (do
            (let attribution (head items))
            (let rest
                (lwcp-filter-attributions world (tail items) capability))
            (if (and (eq (lwo-active-attribution?
                              world attribution) 1)
                     (eq (lwcp-authorized? world
                            (lwo-attribution-payload attribution)
                            capability) 1))
                (lwo-field-add rest attribution) rest))))

(defn lwcp-projection-for (world capability)
    (lwcp-projection
        (lwcp-filter-cells world
            (lwo-field-items (lwo-world-cells world)) capability)
        (lwcp-filter-relations world
            (lwo-field-items (lwo-world-relations world)) capability)
        (lwcp-filter-attributions world
            (lwo-field-items (lwo-world-attributions world)) capability)))

(defn lwcp-projected-world (projection)
    (lwo-world (lwcp-projection-cells projection)
               (lwcp-projection-relations projection)
               (lwcp-projection-attributions projection)
               (lwo-empty-field) (lwo-empty-field)))

(defn lwcp-valid-grant-attributions-items
    (world items payload acc)
    (if (eq (len items) 0) acc
        (do
            (let attribution (head items))
            (let source (lwo-attribution-source attribution))
            (lwcp-valid-grant-attributions-items world (tail items) payload
                (if (eq (lwo-active-by? world payload source) 1)
                    (lwo-field-add acc attribution) acc)))))

(defn lwcp-grant-evidence (grant attributions)
    (intern_node LWCP-GRANT-EVIDENCE (list grant attributions)))
(defn lwcp-grant-evidence-grant (evidence) (nth (node_children evidence) 0))
(defn lwcp-grant-evidence-attributions (evidence)
    (nth (node_children evidence) 1))

(defn lwcp-evidence-for-payload-items
    (world items payload capability acc)
    (if (eq (len items) 0) acc
        (do
            (let grant (head items))
            (if (and (eq (lwcp-grant-for?
                              grant payload capability) 1)
                     (eq (lwo-active? world grant) 1))
                (do
                    (let attributions
                        (lwcp-valid-grant-attributions-items world
                            (lwo-field-items
                                (lwo-active-attributions-for world grant))
                            payload (lwo-empty-field)))
                    (lwcp-evidence-for-payload-items world (tail items)
                        payload capability
                        (if (eq (lwo-field-size attributions) 0) acc
                            (lwo-field-add acc
                                (lwcp-grant-evidence grant attributions)))))
                (lwcp-evidence-for-payload-items world (tail items)
                    payload capability acc)))))

(defn lwcp-context-evidence-items
    (world payloads all-items capability acc)
    (if (eq (len payloads) 0) acc
        (lwcp-context-evidence-items world (tail payloads) all-items
            capability
            (lwcp-field-union-items
                (lwo-field-items
                    (lwcp-evidence-for-payload-items world all-items
                        (head payloads) capability (lwo-empty-field)))
                acc))))

(defn lwcp-context-evidence (world projection capability)
    (do
        (let items (lwo-field-items (lwo-world-cells world)))
        (lwcp-context-evidence-items world
            (lwo-field-items (lwcp-projection-cells projection))
            items capability (lwo-empty-field))))

; children: purpose/capability, authority-minimized projected world,
;           exact grant evidence, capability attributions, local path
(defn lwcp-context (world capability)
    (do
        (let projection (lwcp-projection-for world capability))
        (intern_node LWCP-CONTEXT
            (list capability (lwcp-projected-world projection)
                  (lwcp-context-evidence world projection capability)
                  (lwo-active-attributions-for world capability)
                  (lwo-local-path)))))
(defn lwcp-context? (cell) (lwo-category? cell LWCP-CONTEXT))
(defn lwcp-context-capability (context) (nth (node_children context) 0))
(defn lwcp-context-world (context) (nth (node_children context) 1))
(defn lwcp-context-grant-evidence (context) (nth (node_children context) 2))
(defn lwcp-context-capability-attributions (context)
    (nth (node_children context) 3))
(defn lwcp-context-path (context) (nth (node_children context) 4))

(defn lwcp-context-current? (world context)
    (if (eq (lwcp-context? context) 0) 0
        (if (node_eq context
                (lwcp-context world
                    (lwcp-context-capability context))) 1 0)))
