; form-cli-lift-parse-probe.fk — does the new grammar parse, locally.
;
; preludes: form-stdlib/core.fk form-stdlib/grammars/form-lift.fk

(do
    (defn flp-fail? (n)
        (if (eq (node_level n) 1)
            (if (eq (node_type n) 2)
                (str_eq (node_value n) "PARSE-FAIL")
                0)
            0))
    (print "lift parse add=")
    (print (if (eq (flp-fail? (g-parse-full (form-lift-section-grammar) "def f() = 1 + 2;\n0;\n")) 1) "FAIL" "OK"))
    (print " ge=")
    (print (if (eq (flp-fail? (g-parse-full (form-lift-section-grammar) "def f(d) = if d >= 3 then ice else compost;\n0;\n")) 1) "FAIL" "OK"))
    (print " unless=")
    (print (if (eq (flp-fail? (g-parse-full (form-lift-section-grammar) "def f(x) = unless x == 1 then 1 else 0;\n0;\n")) 1) "FAIL" "OK"))
    (print "\n")
    0)
