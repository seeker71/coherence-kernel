; living-world-continuity-durable.fk -- settled tissue crosses a process seam.
;
; The semantic continuity image remains inert.  This layer only gives that
; exact image a local text carrier using cell-coordinate-stream: no blueprint
; name registry, remote oracle, Python bridge, or C-seed growth enters the
; answer path.  Loading still grants no authority; lwcn-restore-proposal keeps
; the historical holders' fresh unanimous re-authorization gate.
; witnessed: 2026-08-08 -> 32767 on direct-source fkwu and 31/31 cross-process
;
; Saving is append-new in meaning.  An existing destination or pending path is
; refused rather than overwritten.  A candidate is written to <path>.pending,
; read back, canonically decoded, required to equal the offered image and pass
; its manifest, then renamed into place and read back again.  Interrupted or
; failed attempts remain visible at the pending path; this layer never deletes
; them or silently retries with different content.
;
; Result fields are all explicit offers: status, optional carried image, local
; path, optional evidence, optional alternatives, optional unknowable.  ABSENT
; is not NOTHING, UNKNOWABLE is not REFUSED, and INVESTIGATE is not success.
; Alternatives and unknowable may both be absent without changing the result.
;
; Boundary: the active carrier is single-writer.  POSIX rename is atomic but
; not no-replace, so concurrent writers, hostile file parsing, cryptographic
; authentication, signatures, and cross-device rename are not claimed.  The
; restored image's own holder consent remains the authority boundary.
;
; preludes: form-stdlib/core.fk form-stdlib/form-fs.fk form-stdlib/cell-coordinate-stream.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-continuity.fk

(let LWCD-RESULT       (bp "LWCD-RESULT"))
(let LWCD-SAVED        (bp "LWCD-SAVED"))
(let LWCD-LOADED       (bp "LWCD-LOADED"))
(let LWCD-ABSENT       (bp "LWCD-ABSENT"))
(let LWCD-REFUSED      (bp "LWCD-REFUSED"))
(let LWCD-INVESTIGATE  (bp "LWCD-INVESTIGATE"))
(let LWCD-UNKNOWABLE   (bp "LWCD-UNKNOWABLE"))

(defn lwcd-status (category) (intern_node category (empty)))
(defn lwcd-saved-status () (lwcd-status LWCD-SAVED))
(defn lwcd-loaded-status () (lwcd-status LWCD-LOADED))
(defn lwcd-absent-status () (lwcd-status LWCD-ABSENT))
(defn lwcd-refused-status () (lwcd-status LWCD-REFUSED))
(defn lwcd-investigate-status () (lwcd-status LWCD-INVESTIGATE))
(defn lwcd-unknowable-status () (lwcd-status LWCD-UNKNOWABLE))

; children: status, optional image, path, optional evidence,
;           optional alternatives, optional unknowable
(defn lwcd-result (status image path evidence alternatives unknowable)
    (intern_node LWCD-RESULT
        (list status image (intern_trivial_string path)
              evidence alternatives unknowable)))

(defn lwcd-result? (result) (lwo-category? result LWCD-RESULT))
(defn lwcd-result-status (result) (nth (node_children result) 0))
(defn lwcd-result-image (result) (nth (node_children result) 1))
(defn lwcd-result-path (result) (node_value (nth (node_children result) 2)))
(defn lwcd-result-evidence (result) (nth (node_children result) 3))
(defn lwcd-result-alternatives (result) (nth (node_children result) 4))
(defn lwcd-result-unknowable (result) (nth (node_children result) 5))

(defn lwcd-status? (result status)
    (if (and (eq (lwcd-result? result) 1)
             (node_eq (lwcd-result-status result) status)) 1 0))
(defn lwcd-saved? (result) (lwcd-status? result (lwcd-saved-status)))
(defn lwcd-loaded? (result) (lwcd-status? result (lwcd-loaded-status)))
(defn lwcd-absent? (result) (lwcd-status? result (lwcd-absent-status)))
(defn lwcd-refused? (result) (lwcd-status? result (lwcd-refused-status)))
(defn lwcd-investigate? (result)
    (lwcd-status? result (lwcd-investigate-status)))
(defn lwcd-unknowable? (result)
    (lwcd-status? result (lwcd-unknowable-status)))

(defn lwcd-pending-path (path) (str_concat path ".pending"))

(defn lwcd-text-image (text)
    (if (or (eq (str_len text) 0)
            (not (eq (ccs-composite-at? text 0) 1))) (lwo-none)
        (do
            (let parsed (ccs-parse-at text 0))
            (let image (ccs-pair-value parsed))
            (if (and (eq (ccs-pair-next parsed) (str_len text))
                     (and (eq (ccs-canonical? text) 1)
                          (eq (lwcn-image-valid? image) 1)))
                image (lwo-none)))))

(defn lwcd-save-new-with-options
    (path image evidence alternatives unknowable)
    (do
        (let pending (lwcd-pending-path path))
        (if (or (eq (str_len path) 0)
                (or (eq (fs-exists? path) 1)
                    (eq (fs-exists? pending) 1)))
            (lwcd-result (lwcd-refused-status) image path evidence
                         alternatives unknowable)
        (if (eq (lwcn-image-valid? image) 0)
            (lwcd-result (lwcd-refused-status) image path evidence
                         alternatives unknowable)
        (if (eq (ccs-supported? image) 0)
            (lwcd-result (lwcd-unknowable-status) image path evidence
                         alternatives unknowable)
            (do
                (let text (ccs-emit image))
                (let wrote (fs-write-text pending text))
                (if (or (not (eq wrote (str_len text)))
                        (not (eq (fs-stat-size pending) (str_len text))))
                    (lwcd-result (lwcd-investigate-status) image path evidence
                                 alternatives unknowable)
                    (do
                        (let pending-text (fs-read-text pending))
                        (let pending-image (lwcd-text-image pending-text))
                        (if (or (not (str_eq pending-text text))
                                (not (node_eq pending-image image)))
                            (lwcd-result (lwcd-investigate-status) image path
                                         evidence alternatives unknowable)
                            (do
                                (let renamed (fs-rename pending path))
                                (if (not (eq renamed 0))
                                    (lwcd-result (lwcd-investigate-status)
                                        image path evidence alternatives
                                        unknowable)
                                    (do
                                        (let final-text (fs-read-text path))
                                        (let final-image
                                            (lwcd-text-image final-text))
                                        (if (and (str_eq final-text text)
                                                 (node_eq final-image image))
                                            (lwcd-result (lwcd-saved-status)
                                                image path evidence alternatives
                                                unknowable)
                                            (lwcd-result
                                                (lwcd-investigate-status)
                                                image path evidence alternatives
                                                unknowable))))))))))))))

(defn lwcd-save-new (path image evidence)
    (lwcd-save-new-with-options path image evidence
        (lwo-none) (lwo-none)))

(defn lwcd-load-with-options (path evidence alternatives unknowable)
    (if (eq (fs-exists? path) 0)
        (lwcd-result (lwcd-absent-status) (lwo-none) path evidence
                     alternatives unknowable)
    (if (eq (fs-is-dir? path) 1)
        (lwcd-result (lwcd-refused-status) (lwo-none) path evidence
                     alternatives unknowable)
        (do
            (let text (fs-read-text path))
            (if (or (eq (str_len text) 0)
                    (not (eq (ccs-composite-at? text 0) 1)))
                (lwcd-result (lwcd-unknowable-status) (lwo-none) path
                             evidence alternatives unknowable)
                (do
                    (let image (lwcd-text-image text))
                    (if (node_eq image (lwo-none))
                        (lwcd-result (lwcd-refused-status) (lwo-none) path
                                     evidence alternatives unknowable)
                        (lwcd-result (lwcd-loaded-status) image path evidence
                                     alternatives unknowable))))))))

(defn lwcd-load (path evidence)
    (lwcd-load-with-options path evidence (lwo-none) (lwo-none)))
