; form-cli-current-answer-in-process.fk -- strict form-cli query result
; enters the canonical resident current-answer recipe in the same Form process.
;
; The query is executed exactly once through the strict one-bucket route.  Its
; typed result is retained beside the resident receipt, so miss, stale, failure,
; timeout, nothing, present 0, and present 1 cannot be collapsed by rendering.
; No host-exec, HTTP, model, Metal, global operations table, or ambient path
; authority is introduced.
;
; preludes: form-stdlib/form-cli-nodeid-knowledge-door.fk
; preludes: form-stdlib/runtime-program-image-fkb-current-answer-recipe.fk
;
; Proven by: form-stdlib/tests/form-cli-current-answer-in-process-band.fk

(do
    (defn fcaip-version () "form-cli-current-answer-in-process-v1")
    (defn fcaip-step-budget () 93)

    ; receipt = marker, canonical program-symbol recipe, strict query result,
    ; resident execution receipt.  The query result remains present even when
    ; the resident admission returns exact nothing.
    (defn fcaip-receipt-row (result execution)
        (list (fcaip-version) (rpicr-recipe-identity) result execution))
    (defn fcaip-receipt-recipe (receipt) (nth receipt 1))
    (defn fcaip-receipt-result (receipt) (nth receipt 2))
    (defn fcaip-receipt-execution (receipt) (nth receipt 3))

    (defn fcaip-from-result (result step-budget)
        (fcaip-receipt-row result
            (rpicr-execution-from-result result step-budget)))

    (defn fcaip-execute-input (input local-ready step-budget)
        (do
            (let surface (fcnkd-surface input))
            (let result (fknqr-execute-strict surface local-ready))
            (fcaip-from-result result step-budget)))

    (defn fcaip-recipe-identity? (identity)
        (rpsw-request-matches? identity (rpicr-recipe-identity)))

    (defn fcaip-receipt? (receipt)
        (if (nothing? receipt) 0
        (if (not (eq (len receipt) 4)) 0
        (if (not (str_eq (nth receipt 0) (fcaip-version))) 0
        (if (eq (fcaip-recipe-identity?
                    (fcaip-receipt-recipe receipt)) 0) 0
        (if (eq (rpica-result-shaped?
                    (fcaip-receipt-result receipt)) 0) 0
            (do
                (let execution (fcaip-receipt-execution receipt))
                (if (nothing? execution) 1
                    (rpica-execution-receipt? execution)))))))))

    (defn fcaip-status (receipt)
        (do
            (let execution (fcaip-receipt-execution receipt))
            (if (nothing? execution)
                (if (str_eq
                        (fknq-status (fcaip-receipt-result receipt)) "hit")
                    "nothing"
                    (fknq-status (fcaip-receipt-result receipt)))
                (rpica-execution-status execution))))

    (defn fcaip-reason (receipt)
        (do
            (let execution (fcaip-receipt-execution receipt))
            (if (nothing? execution)
                (if (str_eq
                        (fknq-status (fcaip-receipt-result receipt)) "hit")
                    "resident-capability-not-admitted"
                    (fknq-reason (fcaip-receipt-result receipt)))
                (rpica-execution-reason execution))))

    (defn fcaip-phase (receipt at)
        (do
            (let execution (fcaip-receipt-execution receipt))
            (if (nothing? execution) 0
                (rpica-phase-observed
                    (nth (rpica-execution-lifecycle execution) at)))))

    (defn fcaip-resident-value (receipt)
        (do
            (let execution (fcaip-receipt-execution receipt))
            (if (nothing? execution) (nothing)
                (do
                    (let trace
                        (rpica-walk-trace
                            (rpica-execution-walk execution)))
                    (if (eq (rpiwt-trace-output-count trace) 1)
                        (rpiwt-trace-first-value trace)
                        (nothing))))))

    (defn fcaip-line (acc key value)
        (str_concat acc
            (str_concat "\n" (str_concat key (str_concat "=" value)))))

    (defn fcaip-value-text (value)
        (if (nothing? value) "nothing" (int_to_str value)))

    (defn fcaip-render (receipt)
        (do
            (let result (fcaip-receipt-result receipt))
            (let r0 (fcaip-line "current-answer-in-process"
                "schema" (fcaip-version)))
            (let r1 (fcaip-line r0 "status" (fcaip-status receipt)))
            (let r2 (fcaip-line r1 "reason" (fcaip-reason receipt)))
            (let r3 (fcaip-line r2 "route-mode" "strict-one-bucket"))
            (let r4 (fcaip-line r3 "recipe-symbol"
                (pise-request-canonical-key
                    (fcaip-receipt-recipe receipt))))
            (let r5 (fcaip-line r4 "source"
                (fknq-node-key (fknq-source result))))
            (let r6 (fcaip-line r5 "entry"
                (fknq-node-key (fknq-entry result))))
            (let r7 (fcaip-line r6 "request"
                (fknq-node-key (fknq-request result))))
            (let r8 (fcaip-line r7 "path" (fknq-source-path result)))
            (let r9 (fcaip-line r8 "answer" (fknq-answer result)))
            (let r10 (fcaip-line r9 "lookup-count"
                (int_to_str (fknq-lookup-count result))))
            (let r11 (fcaip-line r10 "trace"
                (fknq-trace-actions (fknq-trace result))))
            (let r12 (fcaip-line r11 "resident-value"
                (fcaip-value-text (fcaip-resident-value receipt))))
            (let r13 (fcaip-line r12 "load"
                (int_to_str (fcaip-phase receipt 0))))
            (let r14 (fcaip-line r13 "call"
                (int_to_str (fcaip-phase receipt 1))))
            (let r15 (fcaip-line r14 "return"
                (int_to_str (fcaip-phase receipt 2))))
            (let r16 (fcaip-line r15 "fault"
                (int_to_str (fcaip-phase receipt 3))))
            (let r17 (fcaip-line r16 "timeout"
                (int_to_str (fcaip-phase receipt 4))))
            (fcaip-line r17 "release"
                (int_to_str (fcaip-phase receipt 5)))))

    (defn fcaip-query (input)
        (if (not (eq (fcnkd-input-valid? input) 1))
            "usage: current-answer <concept-key>"
            (fcaip-render
                (fcaip-execute-input input 0 (fcaip-step-budget)))))

    0)
