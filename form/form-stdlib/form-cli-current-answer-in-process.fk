// form-cli-current-answer-in-process.fk -- strict form-cli query result
// enters the canonical resident current-answer recipe in the same Form process.
//
// The query is executed exactly once through the strict one-bucket route.  Its
// typed result is retained beside the resident receipt, so miss, stale, failure,
// timeout, nothing, present 0, and present 1 cannot be collapsed by rendering.
// No host-exec, HTTP, model, Metal, global operations table, or ambient path
// authority is introduced.
//
// preludes: form-stdlib/form-cli-nodeid-knowledge-door.fk
// preludes: form-stdlib/runtime-program-image-fkb-current-answer-recipe.fk
//
section [form.bml] {
    def fcaip-version() = "form-cli-current-answer-in-process-v1";
    def fcaip-step-budget() = 93;
    // receipt = marker, canonical program-symbol recipe, strict query result,
    // resident execution receipt.  The query result remains present even when
    // the resident admission returns exact nothing.
    def fcaip-receipt-row(result, execution) = [fcaip-version(), rpicr-recipe-identity(), result, execution];
    def fcaip-receipt-recipe(receipt) = receipt[1];
    def fcaip-receipt-result(receipt) = receipt[2];
    def fcaip-receipt-execution(receipt) = receipt[3];
    def fcaip-from-result(result, step-budget) = fcaip-receipt-row(result, rpicr-execution-from-result(result, step-budget));
    def fcaip-execute-input(input, local-ready, step-budget) = {
        let surface = fcnkd-surface(input);
        let result = fknqr-execute-strict(surface, local-ready);
        fcaip-from-result(result, step-budget);
    };
    def fcaip-recipe-identity?(identity) = rpsw-request-matches?(identity, rpicr-recipe-identity());
    def fcaip-receipt?(receipt) = nothing?(receipt) ? 0 : !((Comparable) len(receipt) == 4) ? 0 : !((String) receipt[0] == fcaip-version()) ? 0 : (Comparable) fcaip-recipe-identity?(fcaip-receipt-recipe(receipt)) == 0 ? 0 : (Comparable) rpica-result-shaped?(fcaip-receipt-result(receipt)) == 0 ? 0 : {
        let execution = fcaip-receipt-execution(receipt);
        nothing?(execution) ? 1 : rpica-execution-receipt?(execution);
    };
    def fcaip-status(receipt) = {
        let execution = fcaip-receipt-execution(receipt);
        nothing?(execution) ? (String) fknq-status(fcaip-receipt-result(receipt)) == "hit" ? "nothing" : fknq-status(fcaip-receipt-result(receipt)) : rpica-execution-status(execution);
    };
    def fcaip-reason(receipt) = {
        let execution = fcaip-receipt-execution(receipt);
        nothing?(execution) ? (String) fknq-status(fcaip-receipt-result(receipt)) == "hit" ? "resident-capability-not-admitted" : fknq-reason(fcaip-receipt-result(receipt)) : rpica-execution-reason(execution);
    };
    def fcaip-phase(receipt, at) = {
        let execution = fcaip-receipt-execution(receipt);
        nothing?(execution) ? 0 : rpica-phase-observed(rpica-execution-lifecycle(execution)[at]);
    };
    def fcaip-resident-value(receipt) = {
        let execution = fcaip-receipt-execution(receipt);
        nothing?(execution) ? nothing() : {
            let trace = rpica-walk-trace(rpica-execution-walk(execution));
            (Comparable) rpiwt-trace-output-count(trace) == 1 ? rpiwt-trace-first-value(trace) : nothing();
        };
    };
    def fcaip-line(acc, key, value) = str_concat(acc, str_concat("\n", str_concat(key, str_concat("=", value))));
    def fcaip-value-text(value) = nothing?(value) ? "nothing" : int_to_str(value);
    def fcaip-render(receipt) = {
        let result = fcaip-receipt-result(receipt);
        let r0 = fcaip-line("current-answer-in-process", "schema", fcaip-version());
        let r1 = fcaip-line(r0, "status", fcaip-status(receipt));
        let r2 = fcaip-line(r1, "reason", fcaip-reason(receipt));
        let r3 = fcaip-line(r2, "route-mode", "strict-one-bucket");
        let r4 = fcaip-line(r3, "recipe-symbol", pise-request-canonical-key(fcaip-receipt-recipe(receipt)));
        let r5 = fcaip-line(r4, "source", fknq-node-key(fknq-source(result)));
        let r6 = fcaip-line(r5, "entry", fknq-node-key(fknq-entry(result)));
        let r7 = fcaip-line(r6, "request", fknq-node-key(fknq-request(result)));
        let r8 = fcaip-line(r7, "path", fknq-source-path(result));
        let r9 = fcaip-line(r8, "answer", fknq-answer(result));
        let r10 = fcaip-line(r9, "lookup-count", int_to_str(fknq-lookup-count(result)));
        let r11 = fcaip-line(r10, "trace", fknq-trace-actions(fknq-trace(result)));
        let r12 = fcaip-line(r11, "resident-value", fcaip-value-text(fcaip-resident-value(receipt)));
        let r13 = fcaip-line(r12, "load", int_to_str(fcaip-phase(receipt, 0)));
        let r14 = fcaip-line(r13, "call", int_to_str(fcaip-phase(receipt, 1)));
        let r15 = fcaip-line(r14, "return", int_to_str(fcaip-phase(receipt, 2)));
        let r16 = fcaip-line(r15, "fault", int_to_str(fcaip-phase(receipt, 3)));
        let r17 = fcaip-line(r16, "timeout", int_to_str(fcaip-phase(receipt, 4)));
        fcaip-line(r17, "release", int_to_str(fcaip-phase(receipt, 5)));
    };
    def fcaip-query(input) = !((Comparable) fcnkd-input-valid?(input) == 1) ? "usage: current-answer <concept-key>" : fcaip-render(fcaip-execute-input(input, 0, fcaip-step-budget()));
    0;
}
