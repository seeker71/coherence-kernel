; form-cli-nodeid-answer.fk — a delayed execution pointer as the answer.
;
; An answer can be a node-id: a blueprint, a recipe, or a cell. Naming it is
; an offer. An ask receives a reply. Evaluation sits outside the local LLM
; token stream, can run beside it, and can be embedded in another recipe.
; Only after an ask may JIT resolve the code into data. An offer without an
; ask replies nothing — not a timeout, not a zero. Ask does not mint
; equivalence.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-cli-nodeid-answer-band.fk
; witnessed: 2026-08-30 -> 2047

(do
    (defn fnid-kind-none () 0)
    (defn fnid-kind-blueprint () 1)
    (defn fnid-kind-recipe () 2)
    (defn fnid-kind-cell () 3)
    (defn fnid-kind-name (k)
        (if (eq k (fnid-kind-none)) "none"
            (if (eq k (fnid-kind-blueprint)) "blueprint"
                (if (eq k (fnid-kind-recipe)) "recipe" "cell"))))

    (defn fnid-delay-offer () 0)
    (defn fnid-delay-ask () 1)
    (defn fnid-delay-name (d)
        (if (eq d (fnid-delay-offer)) "offer" "ask"))

    (defn fnid-cost-outside () 0)
    (defn fnid-cost-stream () 1)
    (defn fnid-cost-name (c)
        (if (eq c (fnid-cost-outside)) "outside" "stream"))

    (defn fnid-pointer (kind)
        (list "form-cli-nodeid-v1" kind (fnid-delay-offer) (fnid-cost-outside)))
    (defn fnid-kind (p) (nth p 1))
    (defn fnid-delay (p) (nth p 2))
    (defn fnid-cost (p) (nth p 3))
    (defn fnid-pointer? (p)
        (if (and (ge (len p) 4) (str_eq (nth p 0) "form-cli-nodeid-v1")) 1 0))

    (defn fnid-ask (p)
        (if (eq (fnid-kind p) (fnid-kind-none)) p
            (if (eq (len p) 7)
                (list "form-cli-nodeid-v1" (fnid-kind p) (fnid-delay-ask)
                    (fnid-cost p) (nth p 4) (nth p 5) (nth p 6))
                (list "form-cli-nodeid-v1" (fnid-kind p) (fnid-delay-ask)
                    (fnid-cost p)))))

    (defn fnid-recipe (op a b)
        (list "form-cli-nodeid-v1" (fnid-kind-recipe) (fnid-delay-offer)
            (fnid-cost-outside) op a b))
    (defn fnid-op (p) (nth p 4))
    (defn fnid-a (p) (nth p 5))
    (defn fnid-b (p) (nth p 6))
    (defn fnid-eval (op a b)
        (if (str_eq op "add") (add a b)
            (if (str_eq op "mul") (mul a b)
                (if (str_eq op "sub") (sub a b)
                    (if (str_eq op "eq") (eq a b) (nothing))))))
    (defn fnid-reply (p)
        (if (eq (fnid-delay p) (fnid-delay-ask))
            (if (eq (len p) 7) (fnid-eval (fnid-op p) (fnid-a p) (fnid-b p))
                (nothing))
            (nothing)))
    (defn fnid-reply-name (x)
        (if (nothing? x) "nothing" (int_to_str x)))
    (defn fnid-ask-speak ()
        (do
            (let p (fnid-recipe "add" 2 3))
            (str_concat "node-id offer-reply=" (str_concat (fnid-reply-name (fnid-reply p))
            (str_concat " ask-reply=" (str_concat (fnid-reply-name (fnid-reply (fnid-ask p)))
                " cost=outside\n"))))))

    (defn fnid-embed (host guest) (cons guest host))
    (defn fnid-embed-held? (host)
        (if (eq (len host) 0) 1
            (if (eq (fnid-delay (head host)) (fnid-delay-offer))
                (fnid-embed-held? (tail host))
                0)))

    (defn fnid-jit-ready? (p)
        (if (and (eq (fnid-kind p) (fnid-kind-recipe))
                 (eq (fnid-delay p) (fnid-delay-ask))) 1 0))

    (defn fnid-speak ()
        "node-id observe=node kind=recipe delay=offer cost=outside\n")

    (defn fnidk (cond bit) (if cond bit 0))
    (defn fnid-check-pointer ()
        (add (add (add (add (add (add (add
            (fnidk (eq (fnid-kind (fnid-pointer (fnid-kind-recipe))) (fnid-kind-recipe)) 1)
            (fnidk (eq (fnid-delay (fnid-pointer (fnid-kind-recipe))) (fnid-delay-offer)) 2))
            (fnidk (eq (fnid-cost (fnid-pointer (fnid-kind-recipe))) (fnid-cost-outside)) 4))
            (fnidk (eq (fnid-embed-held? (fnid-embed (empty) (fnid-pointer (fnid-kind-recipe)))) 1) 8))
            (fnidk (eq (fnid-jit-ready? (fnid-pointer (fnid-kind-recipe))) 0) 16))
            (fnidk (eq (fnid-jit-ready? (fnid-ask (fnid-pointer (fnid-kind-recipe)))) 1) 32))
            (fnidk (eq (fnid-kind (fnid-ask (fnid-pointer (fnid-kind-recipe)))) (fnid-kind-recipe)) 64))
            (fnidk (not (lt (str_find (fnid-speak) "kind=recipe delay=offer cost=outside" 0) 0)) 128)))
    (defn fnid-check-ask ()
        (add (add
            (fnidk (nothing? (fnid-reply (fnid-recipe "add" 2 3))) 256)
            (fnidk (eq (fnid-reply (fnid-ask (fnid-recipe "add" 2 3))) 5) 512))
            (fnidk (eq (fnid-cost (fnid-ask (fnid-recipe "add" 2 3))) (fnid-cost-outside)) 1024)))
    (defn fnid-check ()
        (add (fnid-check-pointer) (fnid-check-ask)))
)
