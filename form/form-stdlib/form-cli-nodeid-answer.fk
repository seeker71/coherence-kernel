// form-cli-nodeid-answer.fk — a delayed execution pointer as the answer.
//
// An answer can be a node-id: a blueprint, a recipe, or a cell. Naming it is
// an offer. An ask receives a reply. Evaluation sits outside the local LLM
// token stream, can run beside it, and can be embedded in another recipe.
// Only after an ask may JIT resolve the code into data. An offer without an
// ask replies nothing — not a timeout, not a zero. Ask does not mint
// equivalence.
//
// preludes: form-stdlib/core.fk
// Nested offers scale: one ask at the rim replies through the tree.
// witnessed: 2026-08-30 -> 65535
section [form.bml] {
    def fnid-kind-none() = 0;
    def fnid-kind-blueprint() = 1;
    def fnid-kind-recipe() = 2;
    def fnid-kind-cell() = 3;
    def fnid-kind-name(k) = (Comparable) k == fnid-kind-none() ? "none" : (Comparable) k == fnid-kind-blueprint() ? "blueprint" : (Comparable) k == fnid-kind-recipe() ? "recipe" : "cell";
    def fnid-delay-offer() = 0;
    def fnid-delay-ask() = 1;
    def fnid-delay-name(d) = (Comparable) d == fnid-delay-offer() ? "offer" : "ask";
    def fnid-cost-outside() = 0;
    def fnid-cost-stream() = 1;
    def fnid-cost-name(c) = (Comparable) c == fnid-cost-outside() ? "outside" : "stream";
    def fnid-pointer(kind) = list("form-cli-nodeid-v1", kind, fnid-delay-offer(), fnid-cost-outside());
    def fnid-kind(p) = nth(p, 1);
    def fnid-delay(p) = nth(p, 2);
    def fnid-cost(p) = nth(p, 3);
    def fnid-pointer?(p) = len(p) >= 4 && (String) nth(p, 0) == "form-cli-nodeid-v1" ? 1 : 0;
    def fnid-ask(p) = (Comparable) fnid-kind(p) == fnid-kind-none() ? p : (Comparable) len(p) == 7 ? list("form-cli-nodeid-v1", fnid-kind(p), fnid-delay-ask(), fnid-cost(p), nth(p, 4), nth(p, 5), nth(p, 6)) : list("form-cli-nodeid-v1", fnid-kind(p), fnid-delay-ask(), fnid-cost(p));
    def fnid-recipe(op, a, b) = list("form-cli-nodeid-v1", fnid-kind-recipe(), fnid-delay-offer(), fnid-cost-outside(), op, a, b);
    def fnid-op(p) = nth(p, 4);
    def fnid-a(p) = nth(p, 5);
    def fnid-b(p) = nth(p, 6);
    def fnid-eval(op, a, b) = (String) op == "add" ? a + b : (String) op == "mul" ? a * b : (String) op == "sub" ? a - b : (String) op == "eq" ? (Comparable) a == b : nothing();
    def fnid-operand-reply(x) = (Comparable) fnid-pointer?(x) == 1 ? fnid-reply(fnid-ask(x)) : x;
    def fnid-reply(p) = (Comparable) fnid-delay(p) == fnid-delay-ask() ? (Comparable) len(p) == 7 ? fnid-eval(fnid-op(p), fnid-operand-reply(fnid-a(p)), fnid-operand-reply(fnid-b(p))) : nothing() : nothing();
    def fnid-offers(x) = (Comparable) fnid-pointer?(x) == 1 ? (Comparable) len(x) == 7 ? 1 + (fnid-offers(fnid-a(x)) + fnid-offers(fnid-b(x))) : 1 : 0;
    def fnid-composed() = fnid-recipe("add", fnid-recipe("mul", 6, 7), fnid-recipe("sub", 9, 4));
    def fnid-sum-acc(n, acc) = (Comparable) n == 0 ? acc : fnid-sum-acc(n - 1, fnid-recipe("add", acc, n));
    def fnid-sum-tree(n) = fnid-sum-acc(n, 0);
    def fnid-max(a, b) = a > b ? a : b;
    def fnid-depth(x) = (Comparable) fnid-pointer?(x) == 1 ? (Comparable) len(x) == 7 ? 1 + fnid-max(fnid-depth(fnid-a(x)), fnid-depth(fnid-b(x))) : 1 : 0;
    def fnid-rev(xs, acc) = (Comparable) len(xs) == 0 ? acc : fnid-rev(tail(xs), cons(head(xs), acc));
    def fnid-range(n, acc) = (Comparable) n == 0 ? acc : fnid-range(n - 1, cons(n, acc));
    def fnid-pair(xs, acc) = (Comparable) len(xs) == 0 ? acc : (Comparable) len(tail(xs)) == 0 ? cons(head(xs), acc) : fnid-pair(tail(tail(xs)), cons(fnid-recipe("add", head(xs), head(tail(xs))), acc));
    def fnid-pyramid(xs) = (Comparable) len(xs) == 0 ? 0 : (Comparable) len(xs) == 1 ? head(xs) : fnid-pyramid(fnid-rev(fnid-pair(xs, empty()), empty()));
    def fnid-scale(n) = fnid-pyramid(fnid-range(n, empty()));
    def fnid-reply-name(x) = nothing?(x) ? "nothing" : int_to_str(x);
    def fnid-ask-speak() = {
        let p = fnid-recipe("add", 2, 3);
        str_concat("node-id offer-reply=", str_concat(fnid-reply-name(fnid-reply(p)), str_concat(" ask-reply=", str_concat(fnid-reply-name(fnid-reply(fnid-ask(p))), " cost=outside\n"))));
    };
    def fnid-tree-speak() = {
        let t = fnid-composed();
        let s = fnid-sum-tree(10);
        str_concat("node-id tree-offers=", str_concat(int_to_str(fnid-offers(t)), str_concat(" offer-reply=", str_concat(fnid-reply-name(fnid-reply(t)), str_concat(" ask-reply=", str_concat(fnid-reply-name(fnid-reply(fnid-ask(t))), str_concat(" scale-offers=", str_concat(int_to_str(fnid-offers(s)), str_concat(" scale-ask-reply=", str_concat(fnid-reply-name(fnid-reply(fnid-ask(s))), " cost=outside\n"))))))))));
    };
    def fnid-scale-speak() = {
        let p = fnid-scale(16384);
        str_concat("node-id scale-leaves=16384 offers=", str_concat(int_to_str(fnid-offers(p)), str_concat(" depth=", str_concat(int_to_str(fnid-depth(p)), str_concat(" offer-reply=", str_concat(fnid-reply-name(fnid-reply(p)), str_concat(" ask-reply=", str_concat(fnid-reply-name(fnid-reply(fnid-ask(p))), " cost=outside\n"))))))));
    };
    def fnid-embed(host, guest) = cons(guest, host);
    def fnid-embed-held?(host) = (Comparable) len(host) == 0 ? 1 : (Comparable) fnid-delay(head(host)) == fnid-delay-offer() ? fnid-embed-held?(tail(host)) : 0;
    def fnid-jit-ready?(p) = (Comparable) fnid-kind(p) == fnid-kind-recipe() && (Comparable) fnid-delay(p) == fnid-delay-ask() ? 1 : 0;
    def fnid-speak() = "node-id observe=node kind=recipe delay=offer cost=outside\n";
    def fnidk(cond, bit) = cond ? bit : 0;
    def fnid-check-pointer() = fnidk((Comparable) fnid-kind(fnid-pointer(fnid-kind-recipe())) == fnid-kind-recipe(), 1) + fnidk((Comparable) fnid-delay(fnid-pointer(fnid-kind-recipe())) == fnid-delay-offer(), 2) + fnidk((Comparable) fnid-cost(fnid-pointer(fnid-kind-recipe())) == fnid-cost-outside(), 4) + fnidk((Comparable) fnid-embed-held?(fnid-embed(empty(), fnid-pointer(fnid-kind-recipe()))) == 1, 8) + fnidk((Comparable) fnid-jit-ready?(fnid-pointer(fnid-kind-recipe())) == 0, 16) + fnidk((Comparable) fnid-jit-ready?(fnid-ask(fnid-pointer(fnid-kind-recipe()))) == 1, 32) + fnidk((Comparable) fnid-kind(fnid-ask(fnid-pointer(fnid-kind-recipe()))) == fnid-kind-recipe(), 64) + fnidk(!(str_find(fnid-speak(), "kind=recipe delay=offer cost=outside", 0) < 0), 128);
    def fnid-check-ask() = fnidk(nothing?(fnid-reply(fnid-recipe("add", 2, 3))), 256) + fnidk((Comparable) fnid-reply(fnid-ask(fnid-recipe("add", 2, 3))) == 5, 512) + fnidk((Comparable) fnid-cost(fnid-ask(fnid-recipe("add", 2, 3))) == fnid-cost-outside(), 1024);
    def fnid-check-tree() = fnidk(nothing?(fnid-reply(fnid-composed())), 2048) + fnidk((Comparable) fnid-reply(fnid-ask(fnid-composed())) == 47, 4096) + fnidk((Comparable) fnid-offers(fnid-composed()) == 3, 8192) + fnidk((Comparable) fnid-reply(fnid-ask(fnid-sum-tree(10))) == 55, 16384) + fnidk((Comparable) fnid-cost(fnid-ask(fnid-composed())) == fnid-cost-outside(), 32768);
    def fnid-check-scale() = fnidk((Comparable) fnid-offers(fnid-scale(8)) == 7, 65536) + fnidk((Comparable) fnid-reply(fnid-ask(fnid-scale(8))) == 36, 131072) + fnidk((Comparable) fnid-depth(fnid-scale(8)) == 3, 262144) + fnidk((Comparable) fnid-depth(fnid-sum-tree(8)) == 8, 524288);
    def fnid-check() = fnid-check-pointer() + fnid-check-ask() + fnid-check-tree() + fnid-check-scale();
}
