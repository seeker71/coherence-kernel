//////////////////////////////////////////////////////////////////////
//
// form-glass-observation-ui.bml — typed observation and selection shard.
//
// Authority: form-stdlib/bml/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/bml/form-glass-observation-v2.bml form/form-stdlib/form-glass-dashboard.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassObservationUI {
        field FGLObservationShardSchema = "form-glass-observation-ui-v1";

        def fgd-view?(view) = if str_eq(view, "help") then 1 else if str_eq(view, "meaning") then 1 else if str_eq(view, "kernel") then 1 else if str_eq(view, "events") then 1 else if str_eq(view, "channels") then 1 else if str_eq(view, "atlas") then 1 else if str_eq(view, "raster") then 1 else if str_eq(view, "overview") then 1 else if str_eq(view, "memory") then 1 else if str_eq(view, "flow") then 1 else if str_eq(view, "recipes") then 1 else if str_eq(view, "choice") then 1 else 0;
        def fglui-view(view) = if eq(fgd-view?(view), 1) then view else "atlas";
        def fglui-filter-metrics(rows, filter) = if or(is-blank?(filter), str_eq(filter, "all")) then rows else fgd-filter-metrics(rows, filter);
        def fglui-filter-samples(rows, filter) = if or(is-blank?(filter), str_eq(filter, "all")) then rows else fgd-top-samples(rows, filter, len(rows));
        def fglui-kind-samples(rows, kind) = if eq(len(rows), 0) then list() else if str_eq(fgtm-sample-kind(head(rows)), kind) then cons(head(rows), fglui-kind-samples(tail(rows), kind)) else fglui-kind-samples(tail(rows), kind);
        def fglui-overview-metrics(rows) = append(fgd-focus-metrics(rows, "all"), append(fgd-filter-metrics(rows, "queue"), append(fgd-filter-metrics(rows, "request"), append(fgd-filter-metrics(rows, "recipe"), fgd-filter-metrics(rows, "blueprint")))));
        def fglui-existing-metrics(rows) = if eq(len(rows), 0) then list() else if eq(len(head(rows)), 0) then fglui-existing-metrics(tail(rows)) else cons(head(rows), fglui-existing-metrics(tail(rows)));
        def fglui-flow-attention-metrics(rows) = fglui-existing-metrics(list(fgd-find-metric(rows, "model-owner-cpu"), fgd-find-metric(rows, "model-owner-rss"), fgd-find-metric(rows, "model-owner-nice"), fgd-find-metric(rows, "route.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth"), fgd-find-metric(rows, "route.models.parallel-ready")));
        // ---- events and channels: the live samples by kind, newest first; an organ with no publisher is named absent ----
        def fglui-event-kinds() = list("event", "choice", "expert-route", "resolver", "request", "glass-flow");
        def fglui-channel-kinds() = list("channel", "channel-edge", "grammar", "mesh", "ear", "we-share", "field-observer", "meaning-code");
        def fglui-kinds-samples(rows, kinds) = if eq(len(kinds), 0) then list() else append(fglui-kind-samples(rows, head(kinds)), fglui-kinds-samples(rows, tail(kinds)));
        def fglui-awareness-part(rows, wanted) = if eq(len(rows), 0) then list() else if eq(str_eq(fgtm-sample-lane(head(rows)), "awareness"), wanted) then cons(head(rows), fglui-awareness-part(tail(rows), wanted)) else fglui-awareness-part(tail(rows), wanted);
        def fglui-awareness-findings(rows, wanted) = if eq(len(rows), 0) then list() else if eq(fglui-awareness-event?(head(rows)), wanted) then cons(head(rows), fglui-awareness-findings(tail(rows), wanted)) else fglui-awareness-findings(tail(rows), wanted);
        def fglui-events-ordered(rows) = append(fglui-awareness-findings(rows, 1), append(fglui-awareness-part(fglui-awareness-findings(rows, 0), 1), fglui-awareness-part(rows, 0)));
        def fglui-events-samples(rows) = fglui-events-ordered(fglui-kinds-samples(rows, fglui-event-kinds()));
        def fglui-channels-samples(rows) = fglui-kinds-samples(rows, fglui-channel-kinds());
        def fglui-absent-line(text, width, id) = fgd-segment-line(text, width, fgd-neutral(96), id, list("events", "absent"), "unavailable");
        // ---- the organs' rows: the organs process (observe/form-glass-organs-live.fk) gives surprise routing, the route chosen,
        // the protocol floor, and every standing channel with its grammar into the `organs` frame; each sample carries that frame
        // (source fg-xxxxxxxx) and the sequence its give landed at (handle), so the row names the surface it was read from ----
        def fglui-organs-sample?(sample) = str_eq(fgtm-sample-owner(sample), "organs");
        def fglui-organs-seq-text(sample) = if eq(fgtm-field-present?(fgtm-sample-handle(sample)), 1) then int_to_str(fgtm-field-value(fgtm-sample-handle(sample))) else "?";
        def fglui-organs-source(sample) = fgd-cat(list("shm:/", fgtm-sample-source(sample), "#", fglui-organs-seq-text(sample)));
        def fglui-organs-amount(sample) = if eq(fgtm-field-present?(fgtm-sample-capacity(sample)), 1) then fgd-format-count(fgtm-field-value(fgtm-sample-capacity(sample))) else "";
        def fglui-awareness-meaning(reason) = if str_eq(reason, "observation-gap") then "Evidence is missing; ask this source" else if str_eq(reason, "stale-source") then "The reading aged; observe this source again" else if str_eq(reason, "freshness-unproven") then "Current activity is not yet witnessed" else if str_eq(reason, "organ-failed") then "This organ asks for a healing actuator" else if str_eq(reason, "restricted-flow") then "This organ reports blocked flow" else if str_eq(reason, "capacity-edge") then "At the reported capacity; inspect its meaning" else if str_eq(reason, "new-native-identity") then "A native identity entered this window" else if str_eq(reason, "new-interface") then "An interface entered this window" else if str_eq(reason, "flow-restored") then "Fresh evidence returned" else if str_eq(reason, "grammar-changed") then "The carried grammar changed" else if str_eq(reason, "channel-restarted") then "The channel sequence restarted" else reason;
        def fglui-awareness-event?(sample) = and(str_eq(fgtm-sample-lane(sample), "awareness"), eq(str_find(fgtm-sample-id(sample), "awareness.event.", 0), 0));
        def fglui-awareness-text(sample, width, epoch) {
            let channels = fgtm-sample-channels(sample);
            let target = if lt(len(channels), 5) then "native detail" else fgd-cat(list(nth(channels, 3), "/", nth(channels, 4)));
            let source = fgd-cat(list(" | ", fglui-organs-source(sample), " ", fgd-sample-latest-age-text(sample, epoch)));
            let body = fgd-cat(list(target, ": ", fglui-awareness-meaning(fgtm-sample-purpose(sample))));
            fgd-fit(str_concat(fgd-fit(body, fgd-max(0, sub(width, str_len(source)))), source), width);
        }
        def fglui-organs-text(sample, width, epoch) = if eq(fglui-awareness-event?(sample), 1) then fglui-awareness-text(sample, width, epoch) else fgd-fit(fgd-cat(list(fgd-state-symbol(fgtm-sample-lifecycle(sample)), " ", fgd-pad-right(fgtm-sample-id(sample), 30), " ", fgd-pad-right(fgtm-sample-purpose(sample), 28), " ", fgd-pad-left(fglui-organs-amount(sample), 6), " ", fglui-organs-source(sample), " ", fgd-sample-latest-age-text(sample, epoch))), width);
        def fglui-organs-row(sample, width, epoch) = fgd-segment-line(fglui-organs-text(sample, width, epoch), width, fgd-sample-style(sample, epoch), fgd-sample-projection-id(sample), append(list(fgtm-sample-id(sample)), fgtm-sample-channels(sample)), fgtm-sample-evidence(sample));
        def fglui-sample-lines(samples, width, epoch) = if eq(len(samples), 0) then list() else cons(if eq(fglui-organs-sample?(head(samples)), 1) then fglui-organs-row(head(samples), width, epoch) else fgd-sample-segment-line(head(samples), width, epoch), fglui-sample-lines(tail(samples), width, epoch));
        def fglui-events-lines(samples, epoch, width, count) {
            let rows = fglui-events-samples(samples);
            let lines = fglui-sample-lines(fgd-take(rows, count), width, epoch);
            append(list(fgd-title-segment-line("EVENTS live: surprise routing, choice points, routes, resolver, requests", width, "section.events")), if eq(len(lines), 0) then list(fglui-absent-line("? no organs frame stands: run observe/form-glass-organs-live.fk (surprise, choice points); doors: we-glass, cell-channel-glass", width, "events.absent")) else lines);
        }
        def fglui-channels-lines(samples, epoch, width, count) {
            let rows = fglui-channels-samples(samples);
            let lines = fglui-sample-lines(fgd-take(rows, count), width, epoch);
            append(list(fgd-title-segment-line("CHANNELS live: channels + protocols, grammars, mesh, ear streams, shares", width, "section.channels")), if eq(len(lines), 0) then list(fglui-absent-line("? no organs frame stands: run observe/form-glass-organs-live.fk (channels, grammars); doors: cell-channel-glass, ear-glass-live", width, "channels.absent")) else lines);
        }
        def fglui-view-metrics(rows, view) = if str_eq(view, "help") then list() else if str_eq(view, "meaning") then list() else if str_eq(view, "kernel") then append(fgd-filter-metrics(rows, "gift"), append(fgd-filter-metrics(rows, "machine"), fgd-filter-metrics(rows, "kernel"))) else if str_eq(view, "events") then append(fgd-filter-metrics(rows, "request"), fgd-filter-metrics(rows, "route")) else if str_eq(view, "channels") then fgd-filter-metrics(rows, "channel") else if str_eq(view, "atlas") then rows else if str_eq(view, "memory") then append(fgd-filter-metrics(rows, "memory"), fgd-filter-metrics(rows, "cell")) else if str_eq(view, "flow") then append(fglui-flow-attention-metrics(rows), append(fgd-filter-metrics(rows, "queue"), append(fgd-filter-metrics(rows, "request"), fgd-filter-metrics(rows, "metal")))) else if str_eq(view, "recipes") then append(fgd-filter-metrics(rows, "cell"), append(fgd-filter-metrics(rows, "primitive"), append(fgd-filter-metrics(rows, "jit"), append(fgd-filter-metrics(rows, "cache"), append(fgd-filter-metrics(rows, "recipe"), fgd-filter-metrics(rows, "blueprint")))))) else fglui-overview-metrics(rows);
        def fglui-view-samples(rows, view) = if str_eq(view, "memory") then fgd-top-samples(rows, "memory", len(rows)) else if str_eq(view, "flow") then fgd-top-samples(rows, "query-lane", len(rows)) else if str_eq(view, "recipes") then append(fgd-top-samples(rows, "recipe", len(rows)), append(fgd-top-samples(rows, "blueprint", len(rows)), fgd-top-samples(rows, "jit", len(rows)))) else rows;
        // A producer-local node id is display evidence, not a globally unique
        // Glass interaction key.  Publisher + lane + raw id names one exact
        // sample while raw ids remain accepted for older non-flow controls.
        def fglui-sample-selection-id(sample) = fgtm-sample-selection-id(sample);
        def fglui-sample-selected?(sample, id) = if str_eq(fglui-sample-selection-id(sample), id) then 1 else str_eq(fgtm-sample-id(sample), id);
        def fglui-find-sample(rows, id) = if eq(len(rows), 0) then list() else if eq(fglui-sample-selected?(head(rows), id), 1) then head(rows) else fglui-find-sample(tail(rows), id);
        def fglui-find-observation(rows, id) = if eq(len(rows), 0) then list() else if str_eq(fgov2-observation-id(head(rows)), id) then head(rows) else fglui-find-observation(tail(rows), id);

        def fglui-measured-text(truth, unit) = if str_eq(unit, "state") then fgov2-truth-value(truth) else if str_eq(unit, "bytes") then fgd-format-bytes(fgov2-truth-value(truth)) else fgd-format-count(fgov2-truth-value(truth));
        def fglui-truth-text(truth, unit, epoch) = if eq(fgov2-measured?(truth), 1) then fglui-measured-text(truth, unit) else if eq(fgov2-absent?(truth), 1) then fgd-cat(list("absent reason=", fgov2-truth-reason(truth))) else if eq(fgov2-unavailable?(truth), 1) then fgd-cat(list("UNAVAILABLE door=", fgov2-truth-door(truth), " reason=", fgov2-truth-reason(truth))) else if eq(fgov2-stale?(truth), 1) then fgd-cat(list("STALE ", fglui-measured-text(truth, unit), " age=", fgd-format-age-ms(if ge(epoch, fgov2-truth-last-observed(truth)) then sub(epoch, fgov2-truth-last-observed(truth)) else 0), " reason=", fgov2-truth-reason(truth))) else fgd-cat(list("ERROR stage=", fgov2-truth-stage(truth), " code=", fgov2-truth-code(truth), " retry=", int_to_str(fgov2-truth-retryable(truth))));
        def fglui-state-text(truth) = if eq(fgov2-measured?(truth), 1) then fgov2-truth-value(truth) else fgov2-truth-kind(truth);
        def fglui-observation-age(observation, epoch) {
            let truth = fgov2-provenance-observed(fgov2-observation-provenance(observation));
            if eq(fgov2-measured?(truth), 1) then fgd-format-age-ms(if ge(epoch, fgov2-truth-value(truth)) then sub(epoch, fgov2-truth-value(truth)) else 0) else fgov2-truth-kind(truth);
        }
        def fglui-observation-view?(observation, view) {
            let kind = fgov2-observation-kind(observation);
            if str_eq(view, "memory") then if str_eq(kind, "cell") then 1 else if str_eq(kind, "blueprint") then 1 else if str_eq(kind, "recipe") then 1 else if str_eq(kind, "tensor") then 1 else if str_eq(kind, "memory") then 1 else if str_eq(kind, "cache") then 1 else 0 else if str_eq(view, "recipes") then if str_eq(kind, "recipe") then 1 else if str_eq(kind, "jit") then 1 else if str_eq(kind, "blueprint") then 1 else 0 else if str_eq(view, "flow") then if str_eq(kind, "metal") then 1 else if str_eq(kind, "mlx") then 1 else if str_eq(kind, "queue") then 1 else 0 else 1;
        }
        def fglui-view-observations(rows, view) = if eq(len(rows), 0) then list() else if eq(fglui-observation-view?(head(rows), view), 1) then cons(head(rows), fglui-view-observations(tail(rows), view)) else fglui-view-observations(tail(rows), view);
        def fglui-observation-available?(observation) {
            let truth = fgov2-observation-measurement(observation);
            if eq(fgov2-measured?(truth), 1) then 1 else if eq(fgov2-stale?(truth), 1) then 1 else 0;
        }
        def fglui-available-observations(rows) = if eq(len(rows), 0) then list() else if eq(fglui-observation-available?(head(rows)), 1) then cons(head(rows), fglui-available-observations(tail(rows))) else fglui-available-observations(tail(rows));
        def fglui-seam-observations(rows) = if eq(len(rows), 0) then list() else if eq(fglui-observation-available?(head(rows)), 0) then cons(head(rows), fglui-seam-observations(tail(rows))) else fglui-seam-observations(tail(rows));
        def fglui-prioritized-observations(rows) = append(fglui-available-observations(rows), fglui-seam-observations(rows));
        def fglui-observation-summary-value(observation) {
            let measurement = fgov2-observation-measurement(observation);
            if eq(fgov2-measured?(measurement), 1) then fglui-measured-text(measurement, fgov2-observation-unit(observation)) else if eq(fgov2-stale?(measurement), 1) then fglui-measured-text(measurement, fgov2-observation-unit(observation)) else "?";
        }
        def fglui-observation-summary-age(observation, epoch) {
            let observed = fgov2-provenance-observed(fgov2-observation-provenance(observation));
            if eq(fgov2-measured?(observed), 1) then fgd-format-age-ms(if ge(epoch, fgov2-truth-value(observed)) then sub(epoch, fgov2-truth-value(observed)) else 0) else "";
        }
        def fglui-observation-line(observation, epoch, width) {
            let measurement = fgov2-observation-measurement(observation);
            let provenance = fgov2-observation-provenance(observation);
            let evidence = fgov2-provenance-evidence(provenance);
            let prefix = if eq(fgov2-measured?(measurement), 1) then "*" else if eq(fgov2-stale?(measurement), 1) then "+" else if eq(fgov2-error?(measurement), 1) then "!" else "?";
            let label = fgov2-observation-id(observation);
            let publisher = fgov2-provenance-publisher(provenance);
            let text = if lt(width, 57) then fgd-cat(list(prefix, " ", fgd-fit(label, fgd-max(4, sub(width, 27))), "=", fgd-fit(fglui-observation-summary-value(observation), 8), " @", fgd-fit(publisher, 14))) else fgd-cat(list(prefix, " ", fgd-pad-right(label, fgd-max(8, sub(width, 50))), " ", fgd-pad-left(fglui-observation-summary-value(observation), 12), " ", fgd-pad-right(fgov2-observation-unit(observation), 10), " ", fgd-pad-left(fglui-observation-summary-age(observation, epoch), 7), " ", fgd-fit(publisher, 14)));
            fgd-segment-line(text, width, fgd-style-for-plane(fgov2-observation-plane(observation), if eq(fgov2-stale?(measurement), 1) then 112 else 220, 0), fgov2-observation-id(observation), list(fgov2-observation-kind(observation), fgov2-observation-plane(observation), fgov2-observation-access(observation)), evidence);
        }
        def fglui-observation-lines(rows, epoch, width) = if eq(len(rows), 0) then list() else cons(fglui-observation-line(head(rows), epoch, width), fglui-observation-lines(tail(rows), epoch, width));
    }
    0;
}
