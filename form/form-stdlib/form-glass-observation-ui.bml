//////////////////////////////////////////////////////////////////////
//
// form-glass-observation-ui.bml — typed observation and selection shard.
//
// Authority: form-stdlib/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/bml/form-glass-observation-v2.bml form/form-stdlib/form-glass-dashboard.bml form/form-stdlib/bml/ear-transcript.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassObservationUI {
        field FGLObservationShardSchema = "form-glass-observation-ui-v1";

        def fgd-view?(view) = (String) view == "help" ? 1 : (String) view == "meaning" ? 1 : (String) view == "kernel" ? 1 : (String) view == "events" ? 1 : (String) view == "channels" ? 1 : (String) view == "atlas" ? 1 : (String) view == "raster" ? 1 : (String) view == "overview" ? 1 : (String) view == "memory" ? 1 : (String) view == "flow" ? 1 : (String) view == "recipes" ? 1 : (String) view == "choice" ? 1 : 0;
        def fglui-view(view) = (Comparable) fgd-view?(view) == 1 ? view : "atlas";
        def fglui-filter-metrics(rows, filter) = is-blank?(filter) || ((String) filter == "all") ? rows : fgd-filter-metrics(rows, filter);
        def fglui-filter-samples(rows, filter) = is-blank?(filter) || ((String) filter == "all") ? rows : fgd-top-samples(rows, filter, len(rows));
        def fglui-kind-samples(rows, kind) = (Comparable) len(rows) == 0 ? list() : (String) fgtm-sample-kind(head(rows)) == kind ? cons(head(rows), fglui-kind-samples(tail(rows), kind)) : fglui-kind-samples(tail(rows), kind);
        def fglui-overview-metrics(rows) = append(fgd-focus-metrics(rows, "all"), append(fgd-filter-metrics(rows, "queue"), append(fgd-filter-metrics(rows, "request"), append(fgd-filter-metrics(rows, "recipe"), fgd-filter-metrics(rows, "blueprint")))));
        def fglui-existing-metrics(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) len(head(rows)) == 0 ? fglui-existing-metrics(tail(rows)) : cons(head(rows), fglui-existing-metrics(tail(rows)));
        def fglui-flow-attention-metrics(rows) = fglui-existing-metrics(list(fgd-find-metric(rows, "model-owner-cpu"), fgd-find-metric(rows, "model-owner-rss"), fgd-find-metric(rows, "model-owner-nice"), fgd-find-metric(rows, "route.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth"), fgd-find-metric(rows, "route.models.parallel-ready")));
        // ---- events and channels: the live samples by kind, newest first; an organ with no publisher is named absent ----
        def fglui-event-kinds() = list("event", "choice", "expert-route", "resolver", "request", "glass-flow");
        def fglui-channel-kinds() = list("channel", "channel-edge", "grammar", "mesh", "ear", "we-share", "field-observer", "meaning-code");
        def fglui-kinds-samples(rows, kinds) = (Comparable) len(kinds) == 0 ? list() : append(fglui-kind-samples(rows, head(kinds)), fglui-kinds-samples(rows, tail(kinds)));
        def fglui-awareness-part(rows, wanted) = (Comparable) len(rows) == 0 ? list() : (Comparable) ((String) fgtm-sample-lane(head(rows)) == "awareness") == wanted ? cons(head(rows), fglui-awareness-part(tail(rows), wanted)) : fglui-awareness-part(tail(rows), wanted);
        def fglui-awareness-findings(rows, wanted) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglui-awareness-event?(head(rows)) == wanted ? cons(head(rows), fglui-awareness-findings(tail(rows), wanted)) : fglui-awareness-findings(tail(rows), wanted);
        def fglui-events-ordered(rows) = append(fglui-awareness-findings(rows, 1), append(fglui-awareness-part(fglui-awareness-findings(rows, 0), 1), fglui-awareness-part(rows, 0)));
        def fglui-events-samples(rows) = fglui-events-ordered(fglui-kinds-samples(rows, fglui-event-kinds()));
        def fglui-channels-samples(rows) = fglui-kinds-samples(rows, fglui-channel-kinds());
        def fglui-absent-line(text, width, id) = fgd-segment-line(text, width, fgd-neutral(96), id, list("events", "absent"), "unavailable");
        // ---- the organs' rows: the organs process (observe/form-glass-organs-live.fk) gives surprise routing, the route chosen,
        // the protocol floor, and every standing channel with its grammar into the `organs` frame; each sample carries that frame
        // (source fg-xxxxxxxx) and the sequence its give landed at (handle), so the row names the surface it was read from ----
        def fglui-organs-sample?(sample) = (String) fgtm-sample-owner(sample) == "organs";
        def fglui-organs-seq-text(sample) = (Comparable) fgtm-field-present?(fgtm-sample-handle(sample)) == 1 ? int_to_str(fgtm-field-value(fgtm-sample-handle(sample))) : "?";
        def fglui-organs-source(sample) = fgd-cat(list("shm:/", fgtm-sample-source(sample), "#", fglui-organs-seq-text(sample)));
        def fglui-organs-amount(sample) = (Comparable) fgtm-field-present?(fgtm-sample-capacity(sample)) == 1 ? fgd-format-count(fgtm-field-value(fgtm-sample-capacity(sample))) : "";
        def fglui-awareness-meaning(reason) = (String) reason == "observation-gap" ? "Evidence is missing; ask this source" : (String) reason == "stale-source" ? "The reading aged; observe this source again" : (String) reason == "freshness-unproven" ? "Current activity is not yet witnessed" : (String) reason == "organ-failed" ? "This organ asks for a healing actuator" : (String) reason == "restricted-flow" ? "This organ reports blocked flow" : (String) reason == "capacity-edge" ? "At the reported capacity; inspect its meaning" : (String) reason == "new-native-identity" ? "A native identity entered this window" : (String) reason == "new-interface" ? "An interface entered this window" : (String) reason == "flow-restored" ? "Fresh evidence returned" : (String) reason == "grammar-changed" ? "The carried grammar changed" : (String) reason == "channel-restarted" ? "The channel sequence restarted" : reason;
        def fglui-awareness-event?(sample) = ((String) fgtm-sample-lane(sample) == "awareness") && ((Comparable) str_find(fgtm-sample-id(sample), "awareness.event.", 0) == 0);
        def fglui-awareness-text(sample, width, epoch) {
            let channels = fgtm-sample-channels(sample);
            let target = len(channels) < 5 ? "native detail" : fgd-cat(list(channels[3], "/", channels[4]));
            let source = fgd-cat(list(" | ", fglui-organs-source(sample), " ", fgd-sample-latest-age-text(sample, epoch)));
            let body = fgd-cat(list(target, ": ", fglui-awareness-meaning(fgtm-sample-purpose(sample))));
            fgd-fit(fgd-fit(body, fgd-max(0, width - str_len(source))) ++ source, width);
        }
        def fglui-organs-text(sample, width, epoch) = (Comparable) fglui-awareness-event?(sample) == 1 ? fglui-awareness-text(sample, width, epoch) : fgd-fit(fgd-cat(list(fgd-state-symbol(fgtm-sample-lifecycle(sample)), " ", fgd-pad-right(fgtm-sample-id(sample), 30), " ", fgd-pad-right(fgtm-sample-purpose(sample), 28), " ", fgd-pad-left(fglui-organs-amount(sample), 6), " ", fglui-organs-source(sample), " ", fgd-sample-latest-age-text(sample, epoch))), width);
        def fglui-organs-row(sample, width, epoch) = fgd-segment-line(fglui-organs-text(sample, width, epoch), width, fgd-sample-style(sample, epoch), fgd-sample-projection-id(sample), append(list(fgtm-sample-id(sample), "selector." ++ fgtm-sample-selection-id(sample)), fgtm-sample-channels(sample)), fgtm-sample-evidence(sample));
        def fglui-sample-lines(samples, width, epoch) = (Comparable) len(samples) == 0 ? list() : cons((Comparable) fglui-organs-sample?(head(samples)) == 1 ? fglui-organs-row(head(samples), width, epoch) : fgd-sample-segment-line(head(samples), width, epoch), fglui-sample-lines(tail(samples), width, epoch));
        def fglui-events-lines(samples, epoch, width, count) {
            let rows = fglui-events-samples(samples);
            let lines = fglui-sample-lines(fgd-take(rows, count), width, epoch);
            append(list(fgd-title-segment-line("EVENTS live: surprise routing, choice points, routes, resolver, requests", width, "section.events")), (Comparable) len(lines) == 0 ? list(fglui-absent-line("? no matching event rows; c clears filter. Source: gift:glass.organs; we-glass, cell-channel-glass", width, "events.absent")) : lines);
        }
        def fglui-channels-lines(samples, epoch, width, count) {
            let rows = fglui-channels-samples(samples);
            let lines = fglui-sample-lines(fgd-take(rows, count), width, epoch);
            append(list(fgd-title-segment-line("CHANNELS live: channels + protocols, grammars, mesh, ear streams, shares", width, "section.channels")), (Comparable) len(lines) == 0 ? list(fglui-absent-line("? no matching channel rows; c clears filter. Source: gift:glass.organs; cell-channel-glass, ear-glass-live", width, "channels.absent")) : lines);
        }
        def fglui-memory-metric?(row) = (String) fgo-domain(row) == "memory" ? 1 : (String) fgo-domain(row) == "cell" ? 1 : (String) fgo-plane(row) == "os-memory" ? 1 : ((String) fgo-unit(row) == "bytes") && fgd-kind-in?(fgo-domain(row), list("metal", "mlx", "model", "catalog")) ? 1 : 0;
        def fglui-memory-metrics(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglui-memory-metric?(head(rows)) == 1 ? cons(head(rows), fglui-memory-metrics(tail(rows))) : fglui-memory-metrics(tail(rows));
        def fglui-view-metrics(rows, view) = (String) view == "help" ? list() : (String) view == "meaning" ? list() : (String) view == "kernel" ? append(fgd-filter-metrics(rows, "gift"), append(fgd-filter-metrics(rows, "machine"), fgd-filter-metrics(rows, "kernel"))) : (String) view == "events" ? append(fgd-filter-metrics(rows, "request"), fgd-filter-metrics(rows, "route")) : (String) view == "channels" ? fgd-filter-metrics(rows, "channel") : (String) view == "atlas" ? rows : (String) view == "memory" ? fglui-memory-metrics(rows) : (String) view == "flow" ? append(fglui-flow-attention-metrics(rows), append(fgd-filter-metrics(rows, "queue"), append(fgd-filter-metrics(rows, "request"), fgd-filter-metrics(rows, "metal")))) : (String) view == "recipes" ? append(fgd-filter-metrics(rows, "cell"), append(fgd-filter-metrics(rows, "primitive"), append(fgd-filter-metrics(rows, "jit"), append(fgd-filter-metrics(rows, "cache"), append(fgd-filter-metrics(rows, "recipe"), fgd-filter-metrics(rows, "blueprint")))))) : fglui-overview-metrics(rows);
        def fglui-view-samples(rows, view) = (String) view == "memory" ? fgd-top-samples(rows, "memory", len(rows)) : (String) view == "flow" ? fgd-top-samples(rows, "query-lane", len(rows)) : (String) view == "recipes" ? append(fgd-top-samples(rows, "recipe", len(rows)), append(fgd-top-samples(rows, "blueprint", len(rows)), fgd-top-samples(rows, "jit", len(rows)))) : rows;
        // A producer-local node id is display evidence, not a globally unique
        // Glass interaction key.  Publisher + lane + raw id names one exact
        // sample while raw ids remain accepted for older non-flow controls.
        def fglui-sample-selection-id(sample) = fgtm-sample-selection-id(sample);
        def fglui-sample-selected?(sample, id) = (String) fglui-sample-selection-id(sample) == id ? 1 : ((String) fgtm-sample-id(sample) == id);
        def fglui-find-sample(rows, id) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglui-sample-selected?(head(rows), id) == 1 ? head(rows) : fglui-find-sample(tail(rows), id);
        def fglui-find-observation(rows, id) = (Comparable) len(rows) == 0 ? list() : (String) fgov2-observation-id(head(rows)) == id ? head(rows) : fglui-find-observation(tail(rows), id);
        def fglui-metric-keys(rows) = (Comparable) len(rows) == 0 ? list() : cons(fgd-metric-selector(head(rows)), fglui-metric-keys(tail(rows)));
        def fglui-sample-keys(rows) = (Comparable) len(rows) == 0 ? list() : cons(fglui-sample-selection-id(head(rows)), fglui-sample-keys(tail(rows)));
        def fglui-observation-keys(rows) = (Comparable) len(rows) == 0 ? list() : cons(fgov2-observation-id(head(rows)), fglui-observation-keys(tail(rows)));
        def fglui-navigation-samples(samples, view, filter) {
            let rows = fglui-filter-samples(samples, filter);
            (String) view == "events" ? fglui-events-samples(rows) : (String) view == "channels" ? fglui-channels-samples(rows) : fgd-kind-in?(view, list("meaning", "kernel", "help", "choice", "raster")) ? list() : fglui-view-samples(rows, view);
        }
        def fglui-navigation-metrics(metrics, view, filter) = (String) view == "meaning" ? fglui-selected-transcripts(metrics, filter) : fgd-kind-in?(view, list("events", "channels", "help", "choice", "raster")) ? list() : fglui-view-metrics(fglui-filter-metrics(metrics, filter), view);
        def fglui-selected-transcripts(rows, filter) = (Comparable) len(rows) == 0 ? list() : ((Comparable) etr-row?(head(rows)) == 1) && ((Comparable) tln-selected?(filter, etr-code(head(rows))) == 1) ? cons(head(rows), fglui-selected-transcripts(tail(rows), filter)) : fglui-selected-transcripts(tail(rows), filter);
        def fglui-navigation-observations(observations, view) = fgd-kind-in?(view, list("meaning", "events", "channels", "kernel", "help", "choice", "raster")) ? list() : fglui-view-observations(observations, view);
        def fglui-key-held?(keys, key) = (Comparable) len(keys) == 0 ? 0 : (String) head(keys) == key ? 1 : fglui-key-held?(tail(keys), key);
        def fglui-distinct-keys(keys, held) = (Comparable) len(keys) == 0 ? reverse(held) : fglui-distinct-keys(tail(keys), (Comparable) fglui-key-held?(held, head(keys)) == 1 ? held : cons(head(keys), held));
        def fglui-navigation-keys(metrics, samples, observations, view, filter) = fglui-distinct-keys(append(fglui-metric-keys(fglui-navigation-metrics(metrics, view, filter)), append(fglui-sample-keys(fglui-navigation-samples(samples, view, filter)), fglui-observation-keys(fglui-navigation-observations(observations, view)))), list());

        def fglui-measured-text(truth, unit) = (String) unit == "state" ? fgov2-truth-value(truth) : (String) unit == "bytes" ? fgd-format-bytes(fgov2-truth-value(truth)) : fgd-format-count(fgov2-truth-value(truth));
        def fglui-truth-text(truth, unit, epoch) = (Comparable) fgov2-measured?(truth) == 1 ? fglui-measured-text(truth, unit) : (Comparable) fgov2-absent?(truth) == 1 ? fgd-cat(list("absent reason=", fgov2-truth-reason(truth))) : (Comparable) fgov2-unavailable?(truth) == 1 ? fgd-cat(list("UNAVAILABLE door=", fgov2-truth-door(truth), " reason=", fgov2-truth-reason(truth))) : (Comparable) fgov2-stale?(truth) == 1 ? fgd-cat(list("STALE ", fglui-measured-text(truth, unit), " age=", fgd-format-age-ms(epoch >= fgov2-truth-last-observed(truth) ? (epoch - fgov2-truth-last-observed(truth)) : 0), " reason=", fgov2-truth-reason(truth))) : fgd-cat(list("ERROR stage=", fgov2-truth-stage(truth), " code=", fgov2-truth-code(truth), " retry=", int_to_str(fgov2-truth-retryable(truth))));
        def fglui-state-text(truth) = (Comparable) fgov2-measured?(truth) == 1 ? fgov2-truth-value(truth) : fgov2-truth-kind(truth);
        def fglui-observation-age(observation, epoch) {
            let truth = fgov2-provenance-observed(fgov2-observation-provenance(observation));
            (Comparable) fgov2-measured?(truth) == 1 ? fgd-format-age-ms(epoch >= fgov2-truth-value(truth) ? (epoch - fgov2-truth-value(truth)) : 0) : fgov2-truth-kind(truth);
        }
        def fglui-observation-view?(observation, view) {
            let kind = fgov2-observation-kind(observation);
            (String) view == "memory" ? ((String) kind == "cell" ? 1 : (String) kind == "blueprint" ? 1 : (String) kind == "recipe" ? 1 : (String) kind == "tensor" ? 1 : (String) kind == "memory" ? 1 : (String) kind == "cache" ? 1 : 0) : (String) view == "recipes" ? ((String) kind == "recipe" ? 1 : (String) kind == "jit" ? 1 : (String) kind == "blueprint" ? 1 : 0) : (String) view == "flow" ? ((String) kind == "metal" ? 1 : (String) kind == "mlx" ? 1 : (String) kind == "queue" ? 1 : 0) : 1;
        }
        def fglui-view-observations(rows, view) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglui-observation-view?(head(rows), view) == 1 ? cons(head(rows), fglui-view-observations(tail(rows), view)) : fglui-view-observations(tail(rows), view);
        def fglui-observation-available?(observation) {
            let truth = fgov2-observation-measurement(observation);
            (Comparable) fgov2-measured?(truth) == 1 ? 1 : (Comparable) fgov2-stale?(truth) == 1 ? 1 : 0;
        }
        def fglui-available-observations(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglui-observation-available?(head(rows)) == 1 ? cons(head(rows), fglui-available-observations(tail(rows))) : fglui-available-observations(tail(rows));
        def fglui-seam-observations(rows) = (Comparable) len(rows) == 0 ? list() : (Comparable) fglui-observation-available?(head(rows)) == 0 ? cons(head(rows), fglui-seam-observations(tail(rows))) : fglui-seam-observations(tail(rows));
        def fglui-prioritized-observations(rows) = append(fglui-available-observations(rows), fglui-seam-observations(rows));
        def fglui-observation-summary-value(observation) {
            let measurement = fgov2-observation-measurement(observation);
            (Comparable) fgov2-measured?(measurement) == 1 ? fglui-measured-text(measurement, fgov2-observation-unit(observation)) : (Comparable) fgov2-stale?(measurement) == 1 ? fglui-measured-text(measurement, fgov2-observation-unit(observation)) : "?";
        }
        def fglui-observation-summary-age(observation, epoch) {
            let observed = fgov2-provenance-observed(fgov2-observation-provenance(observation));
            (Comparable) fgov2-measured?(observed) == 1 ? fgd-format-age-ms(epoch >= fgov2-truth-value(observed) ? (epoch - fgov2-truth-value(observed)) : 0) : "";
        }
        def fglui-observation-line(observation, epoch, width) {
            let measurement = fgov2-observation-measurement(observation);
            let provenance = fgov2-observation-provenance(observation);
            let evidence = fgov2-provenance-evidence(provenance);
            let prefix = (Comparable) fgov2-measured?(measurement) == 1 ? fgd-truth-symbol(evidence) : (Comparable) fgov2-stale?(measurement) == 1 ? "+" : (Comparable) fgov2-error?(measurement) == 1 ? "!" : "?";
            let label = fgov2-observation-id(observation);
            let publisher = fgov2-provenance-publisher(provenance);
            let text = width < 57 ? fgd-cat(list(prefix, " ", fgd-fit(label, fgd-max(4, width - 27)), "=", fgd-fit(fglui-observation-summary-value(observation), 8), " @", fgd-fit(publisher, 14))) : fgd-cat(list(prefix, " ", fgd-pad-right(label, fgd-max(8, width - 50)), " ", fgd-pad-left(fglui-observation-summary-value(observation), 12), " ", fgd-pad-right(fgov2-observation-unit(observation), 10), " ", fgd-pad-left(fglui-observation-summary-age(observation, epoch), 7), " ", fgd-fit(publisher, 14)));
            fgd-segment-line(text, width, fgd-style-for-plane(fgov2-observation-plane(observation), (Comparable) fgov2-stale?(measurement) == 1 ? 112 : 220, 0), fgov2-observation-id(observation), list("selector.observation." ++ fgov2-observation-id(observation), fgov2-observation-kind(observation), fgov2-observation-plane(observation), fgov2-observation-access(observation)), evidence);
        }
        def fglui-observation-lines(rows, epoch, width) = (Comparable) len(rows) == 0 ? list() : cons(fglui-observation-line(head(rows), epoch, width), fglui-observation-lines(tail(rows), epoch, width));
    }
    0;
}
