//////////////////////////////////////////////////////////////////////
//
// form-glass-observation-ui.bml — typed observation and selection shard.
//
// Authority: form-stdlib/bml/form-glass-live-ui.bml
// preludes: form/form-stdlib/core.fk form/form-stdlib/form-glass-telemetry-membrane.bml form/form-stdlib/bml/form-glass-observation-v2.bml form/form-stdlib/form-glass-dashboard.bml
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormGlassObservationUI {
        field FGLObservationShardSchema = "form-glass-observation-ui-v1";

        def fgd-view?(view) = if str_eq(view, "help") then 1 else if str_eq(view, "atlas") then 1 else if str_eq(view, "raster") then 1 else if str_eq(view, "overview") then 1 else if str_eq(view, "memory") then 1 else if str_eq(view, "flow") then 1 else if str_eq(view, "recipes") then 1 else 0;
        def fglui-view(view) = if eq(fgd-view?(view), 1) then view else "atlas";
        def fglui-filter-metrics(rows, filter) = if or(is-blank?(filter), str_eq(filter, "all")) then rows else fgd-filter-metrics(rows, filter);
        def fglui-filter-samples(rows, filter) = if or(is-blank?(filter), str_eq(filter, "all")) then rows else fgd-top-samples(rows, filter, len(rows));
        def fglui-kind-samples(rows, kind) = if eq(len(rows), 0) then list() else if str_eq(fgtm-sample-kind(head(rows)), kind) then cons(head(rows), fglui-kind-samples(tail(rows), kind)) else fglui-kind-samples(tail(rows), kind);
        def fglui-overview-metrics(rows) = append(fgd-focus-metrics(rows, "all"), append(fgd-filter-metrics(rows, "queue"), append(fgd-filter-metrics(rows, "request"), append(fgd-filter-metrics(rows, "recipe"), fgd-filter-metrics(rows, "blueprint")))));
        def fglui-existing-metrics(rows) = if eq(len(rows), 0) then list() else if eq(len(head(rows)), 0) then fglui-existing-metrics(tail(rows)) else cons(head(rows), fglui-existing-metrics(tail(rows)));
        def fglui-flow-attention-metrics(rows) = fglui-existing-metrics(list(fgd-find-metric(rows, "model-owner-cpu"), fgd-find-metric(rows, "model-owner-rss"), fgd-find-metric(rows, "model-owner-nice"), fgd-find-metric(rows, "route.model.qwen3.8-flash-next.ud-q2_k_xl.unsloth"), fgd-find-metric(rows, "route.models.parallel-ready")));
        def fglui-view-metrics(rows, view) = if str_eq(view, "help") then list() else if str_eq(view, "atlas") then rows else if str_eq(view, "memory") then append(fgd-filter-metrics(rows, "memory"), fgd-filter-metrics(rows, "cell")) else if str_eq(view, "flow") then append(fglui-flow-attention-metrics(rows), append(fgd-filter-metrics(rows, "queue"), append(fgd-filter-metrics(rows, "request"), fgd-filter-metrics(rows, "metal")))) else if str_eq(view, "recipes") then append(fgd-filter-metrics(rows, "cell"), append(fgd-filter-metrics(rows, "primitive"), append(fgd-filter-metrics(rows, "jit"), append(fgd-filter-metrics(rows, "cache"), append(fgd-filter-metrics(rows, "recipe"), fgd-filter-metrics(rows, "blueprint")))))) else fglui-overview-metrics(rows);
        def fglui-view-samples(rows, view) = if str_eq(view, "memory") then fgd-top-samples(rows, "memory", len(rows)) else if str_eq(view, "flow") then fgd-top-samples(rows, "query-lane", len(rows)) else if str_eq(view, "recipes") then append(fgd-top-samples(rows, "recipe", len(rows)), append(fgd-top-samples(rows, "blueprint", len(rows)), fgd-top-samples(rows, "jit", len(rows)))) else rows;
        // A producer-local node id is display evidence, not a globally unique
        // Glass interaction key.  Publisher + lane + raw id names one exact
        // sample while raw ids remain accepted for older non-flow controls.
        def fglui-sample-selection-id(sample) = fgtm-sample-selection-id(sample);
        def fglui-sample-selected?(sample, id) = if str_eq(fglui-sample-selection-id(sample), id) then 1 else str_eq(fgtm-sample-id(sample), id);
        def fglui-find-sample(rows, id) = if eq(len(rows), 0) then list() else if eq(fglui-sample-selected?(head(rows), id), 1) then head(rows) else fglui-find-sample(tail(rows), id);
        def fglui-find-observation(rows, id) = if eq(len(rows), 0) then list() else if str_eq(fgov2-observation-id(head(rows)), id) then head(rows) else fglui-find-observation(tail(rows), id);

        def fglui-measured-text(truth, unit) = if str_eq(unit, "state") then fgov2-truth-value(truth) else if str_eq(unit, "bytes") then fgd-format-bytes(fgov2-truth-value(truth)) else fgd-format-count(fgov2-truth-value(truth));
        def fglui-truth-text(truth, unit, epoch) = if eq(fgov2-measured?(truth), 1) then fglui-measured-text(truth, unit) else if eq(fgov2-absent?(truth), 1) then fgd-cat(list("absent reason=", fgov2-truth-reason(truth))) else if eq(fgov2-unavailable?(truth), 1) then fgd-cat(list("UNAVAILABLE door=", fgov2-truth-door(truth), " reason=", fgov2-truth-reason(truth))) else if eq(fgov2-stale?(truth), 1) then fgd-cat(list("STALE ", fglui-measured-text(truth, unit), " age=", fgd-format-age-ms(if ge(epoch, fgov2-truth-last-observed(truth)) then sub(epoch, fgov2-truth-last-observed(truth)) else 0), " reason=", fgov2-truth-reason(truth))) else fgd-cat(list("ERROR stage=", fgov2-truth-stage(truth), " code=", fgov2-truth-code(truth), " retry=", int_to_str(fgov2-truth-retryable(truth))));
        def fglui-state-text(truth) = if eq(fgov2-measured?(truth), 1) then fgov2-truth-value(truth) else fgov2-truth-kind(truth);
        def fglui-observation-age(observation, epoch) {
            let truth = fgov2-provenance-observed(fgov2-observation-provenance(observation));
            if eq(fgov2-measured?(truth), 1) then fgd-format-age-ms(if ge(epoch, fgov2-truth-value(truth)) then sub(epoch, fgov2-truth-value(truth)) else 0) else fgov2-truth-kind(truth);
        }
        def fglui-observation-view?(observation, view) {
            let kind = fgov2-observation-kind(observation);
            if str_eq(view, "memory") then if str_eq(kind, "cell") then 1 else if str_eq(kind, "blueprint") then 1 else if str_eq(kind, "recipe") then 1 else if str_eq(kind, "tensor") then 1 else if str_eq(kind, "memory") then 1 else if str_eq(kind, "cache") then 1 else 0 else if str_eq(view, "recipes") then if str_eq(kind, "recipe") then 1 else if str_eq(kind, "jit") then 1 else if str_eq(kind, "blueprint") then 1 else 0 else if str_eq(view, "flow") then if str_eq(kind, "metal") then 1 else if str_eq(kind, "mlx") then 1 else if str_eq(kind, "queue") then 1 else 0 else 1;
        }
        def fglui-view-observations(rows, view) = if eq(len(rows), 0) then list() else if eq(fglui-observation-view?(head(rows), view), 1) then cons(head(rows), fglui-view-observations(tail(rows), view)) else fglui-view-observations(tail(rows), view);
        def fglui-observation-available?(observation) {
            let truth = fgov2-observation-measurement(observation);
            if eq(fgov2-measured?(truth), 1) then 1 else if eq(fgov2-stale?(truth), 1) then 1 else 0;
        }
        def fglui-available-observations(rows) = if eq(len(rows), 0) then list() else if eq(fglui-observation-available?(head(rows)), 1) then cons(head(rows), fglui-available-observations(tail(rows))) else fglui-available-observations(tail(rows));
        def fglui-seam-observations(rows) = if eq(len(rows), 0) then list() else if eq(fglui-observation-available?(head(rows)), 0) then cons(head(rows), fglui-seam-observations(tail(rows))) else fglui-seam-observations(tail(rows));
        def fglui-prioritized-observations(rows) = append(fglui-available-observations(rows), fglui-seam-observations(rows));
        def fglui-observation-summary-value(observation) {
            let measurement = fgov2-observation-measurement(observation);
            if eq(fgov2-measured?(measurement), 1) then fglui-measured-text(measurement, fgov2-observation-unit(observation)) else if eq(fgov2-stale?(measurement), 1) then fglui-measured-text(measurement, fgov2-observation-unit(observation)) else "?";
        }
        def fglui-observation-summary-age(observation, epoch) {
            let observed = fgov2-provenance-observed(fgov2-observation-provenance(observation));
            if eq(fgov2-measured?(observed), 1) then fgd-format-age-ms(if ge(epoch, fgov2-truth-value(observed)) then sub(epoch, fgov2-truth-value(observed)) else 0) else "";
        }
        def fglui-observation-line(observation, epoch, width) {
            let measurement = fgov2-observation-measurement(observation);
            let evidence = fgov2-provenance-evidence(fgov2-observation-provenance(observation));
            let prefix = if eq(fgov2-measured?(measurement), 1) then "*" else if eq(fgov2-stale?(measurement), 1) then "+" else if eq(fgov2-error?(measurement), 1) then "!" else "?";
            let label = fgov2-observation-id(observation);
            let text = if lt(width, 44) then fgd-cat(list(prefix, " ", label, "=", fglui-observation-summary-value(observation))) else fgd-cat(list(prefix, " ", fgd-pad-right(label, fgd-max(8, sub(width, 35))), " ", fgd-pad-left(fglui-observation-summary-value(observation), 12), " ", fgd-pad-right(fgov2-observation-unit(observation), 10), " ", fgd-pad-left(fglui-observation-summary-age(observation, epoch), 7)));
            fgd-segment-line(text, width, fgd-style-for-plane(fgov2-observation-plane(observation), if eq(fgov2-stale?(measurement), 1) then 112 else 220, 0), fgov2-observation-id(observation), list(fgov2-observation-kind(observation), fgov2-observation-plane(observation), fgov2-observation-access(observation)), evidence);
        }
        def fglui-observation-lines(rows, epoch, width) = if eq(len(rows), 0) then list() else cons(fglui-observation-line(head(rows), epoch, width), fglui-observation-lines(tail(rows), epoch, width));
    }
    0;
}
