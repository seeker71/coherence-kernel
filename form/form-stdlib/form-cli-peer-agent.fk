    };
    def fcpa-task-alias-resolve(registry, alias) = {
        let resolved = fcpa-alias-resolve(registry, alias);
        (String) fcpa-alias-resolution-status(resolved) == "value" && (Comparable) fcpa-task-ref?(fcpa-alias-resolution-target(resolved)) == 0 ? fcpa-alias-resolution("failure", "alias-target-not-task-reference", nothing(), 0) : resolved;
    };
    def fcpa-task-alias-surface(registry, alias, action-ref) = {
        let resolved = fcpa-task-alias-resolve(registry, alias);
        !((String) fcpa-alias-resolution-status(resolved) == "value") || (Comparable) fcpa-action-ref?(action-ref) == 0 ? "(agent-task nothing)" : str_concat("(agent-task ", str_concat(node_value(head(node_children(action-ref))), str_concat(" ", str_concat(alias, ")"))));
    };
    def fcpa-bootstrap-core() = str_concat("You are a resident local Form peer inside one living fkwu process. ", str_concat("Keep the body's typed distinctions: nothing is not integer 0 or 1; ", str_concat("choice, cut, undo, timeout, failure and release are observations. ", str_concat("Each later tool observation tagged form:agent-task is a new task. ", str_concat("Held meanings may arrive as (agent-task verb @task) or (agent-task verb alias); the verb remains explicit while resident-born NodeIDs or locally announced aliases replace repeated nouns. Absent or ambiguous aliases are signals, never guesses. ", str_concat("When a task supplies a form:recipe-exec surface and physical execution serves it, emit that exact surface once, then read the typed observation and answer. ", "For tasks needing no recipe, answer directly and tersely. Reply now with exactly READY."))))));
    def fcpa-bootstrap() = str_concat(fqt-overlay-prefix(), str_concat("\n", fcpa-bootstrap-core()));
    // The first six seats are the original result ABI.  The remaining seats
    // are route-neutral effect evidence so durable egress never has to pretend
    // every cursor is the affine recipe cursor.
    // result = tag session cursor response elapsed-ms contribution route
    //          callback-calls tool-status carrier value-present value
    //          native-code-generated injected-bytes lifecycle lookup-count
    def fcpa-result-full(session, cursor, response, elapsed, contribution, route, callback-calls, tool-status, carrier, value-present, value, native-code-generated, injected-bytes, lifecycle, lookup-count) = list("form-cli-peer-agent-result-v2", session, cursor, response, elapsed, contribution, route, callback-calls, tool-status, carrier, value-present, value, native-code-generated, injected-bytes, lifecycle, lookup-count);
    def fcpa-result(session, cursor, response, elapsed, contribution) = fcpa-result-full(session, cursor, response, elapsed, contribution, "recipe", frxc-callback-calls(cursor), frxc-status(cursor), frxc-carrier(cursor), frxc-value-present?(cursor), frxc-value(cursor), frxc-callback-observed-code-generated?(cursor), frxc-injected-bytes(cursor), frex-trace-actions(frxc-trace(cursor)), 0);
    def fcpa-session(r) = nth(r, 1);
    def fcpa-cursor(r) = nth(r, 2);
    def fcpa-response(r) = nth(r, 3);
    def fcpa-elapsed-ms(r) = nth(r, 4);
    def fcpa-contribution(r) = nth(r, 5);
    def fcpa-route(r) = nth(r, 6);
    def fcpa-callback-calls(r) = nth(r, 7);
    def fcpa-tool-status(r) = nth(r, 8);
    def fcpa-carrier(r) = nth(r, 9);
    def fcpa-value-present?(r) = nth(r, 10);
    def fcpa-value(r) = nth(r, 11);
    def fcpa-native-code-generated?(r) = nth(r, 12);
    def fcpa-injected-bytes(r) = nth(r, 13);
    def fcpa-lifecycle(r) = nth(r, 14);
    def fcpa-lookup-count(r) = nth(r, 15);
    def fcpa-contribution-of(moved) = (Comparable) frxs-crossed?(moved) == 1 && (Comparable) frxs-carrier-executed?(moved) == 1 ? 1 : 0;
    // A research observation binds the exact response bytes to the body's
    // existing review validator.  The rows do not reward style or length: each
    // declared meaning needs one unique, fresh primary+negative-control pair.
    // PASS is an observed evaluation; REVISE is an observed useful finding.
    // OPEN remains unvalidated speech.
    def fcpa-research-observation(response, rows, declared-count) = list("form-cli-peer-research-observation-v1", response, rows, declared-count);
    def fcpa-research-observation?(observation) = nothing?(observation) ? 0 : (Comparable) len(observation) == 4 ? (String) nth(observation, 0) == "form-cli-peer-research-observation-v1" ? 1 : 0 : 0;
    def fcpa-research-response(observation) = nth(observation, 1);
    def fcpa-research-rows(observation) = nth(observation, 2);
    def fcpa-research-declared-count(observation) = nth(observation, 3);
    def fcpa-research-verdict(observation) = ro-verdict(fcpa-research-rows(observation), fcpa-research-declared-count(observation));
    def fcpa-research-observed?(response, observation) = (Comparable) fcpa-research-observation?(observation) == 0 ? 0 : (Comparable) str_len(response) == 0 ? 0 : (Comparable) ((String) response == fcpa-research-response(observation)) == 0 ? 0 : (Comparable) fcpa-research-verdict(observation) == ro-open() ? 0 : 1;
    // Post-hoc assessment keeps the v1 result and callback semantics intact.
    // result/evidence/contribution/kind remain separate so a recipe callback is
