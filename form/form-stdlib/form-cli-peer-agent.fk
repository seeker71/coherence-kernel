        let started = now_unix_ms();
        let root = fhcs-default-root();
        (String) root == "" ? fcpa-result-full(session, fknsc-fresh(), "", now_unix_ms() - started, 0, "source-knowledge", 0, "nothing", "form-current-source", 0, 0, 0, 0, "choice,nothing,release", 0) : {
            let ctx = fknsc-public-context(root, fknq-default-artifact(), 0, fknq-max-frame-bytes());
