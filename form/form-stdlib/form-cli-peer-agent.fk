    def fcpa-alias-resolution(status, reason, target, choices) = list(status, reason, target, choices);
    def fcpa-alias-resolution-status(resolution) = nth(resolution, 0);
    def fcpa-alias-resolution-reason(resolution) = nth(resolution, 1);
    def fcpa-alias-resolution-target(resolution) = nth(resolution, 2);
    def fcpa-alias-resolution-choices(resolution) = nth(resolution, 3);
    def fcpa-alias-resolve(registry, alias) = nothing?(registry) || !node_eq(node_category(registry), fcpa-alias-registry-category()) ? fcpa-alias-resolution("failure", "registry-malformed", nothing(), 0) : (Comparable) fcpa-alias-safe?(alias) == 0 ? fcpa-alias-resolution("failure", "alias-malformed", nothing(), 0) : (Comparable) fcpa-alias-bindings-valid?(fcpa-alias-registry-bindings(registry)) == 0 ? fcpa-alias-resolution("failure", "binding-malformed", nothing(), 0) : {
