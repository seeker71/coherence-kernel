// form-cli-peer-agent.fk -- a resident local Form peer receives typed tasks,
// may request a NodeID recipe through the scannerless live cursor, observes the
// physical result in the same KV stream, and keeps the residence for the next
// task.  The live door that keeps this residence is observe/form-cli-peer-contribution-live.fk.
//
// A contribution is deliberately narrower than fluent speech.  Recipe work
// counts only when the cursor accepted one request and typed callback evidence
// says the carrier executed.  Non-tool research/evaluation speech can be
// assessed afterward through review-operationalization's fresh primary +
// negative-control rows; incomplete, stale, duplicate, or unbound prose stays
// unvalidated and contributes zero.
//
// preludes: form-stdlib/peer-task-frame.fk form-stdlib/form-cli-recipe-exec-session.fk form-stdlib/form-cli-nodeid-knowledge-session.fk form-stdlib/form-nodeid-knowledge-routed-query.fk form-stdlib/form-agent-repo-patch-frame.fk observe/review-operationalization.fk
section [form.bml] {
    // the task-frame grammar lives in peer-task-frame.fk (preluded), so
    // senders and monitors speak it without loading this knowledge stack.
    // A meaning already taught during this residence does not need its bytes
    // replayed on every turn. The exact kind/payload and action are interned as
    // separate nodes; the hot task needs only its payload coordinate plus the
    // explicit action verb. The action node remains available to the resident
    // registry, but the verb already carries that relation to the current model.
    // These coordinates are residence-local by design and are never used as
    // restart identity or accepted from another process without resolution here.
    def fcpa-task-ref-category() = intern_trivial_string("form-cli-peer-task-reference-v1");
    def fcpa-action-ref-category() = intern_trivial_string("form-cli-peer-action-reference-v1");
    def fcpa-task-ref(kind, payload) = intern_node(fcpa-task-ref-category(), list(intern_trivial_string(kind), intern_trivial_string(payload)));
    def fcpa-action-ref(action) = intern_node(fcpa-action-ref-category(), list(intern_trivial_string(action)));
    def fcpa-task-ref?(node) = nothing?(node) ? 0 : !node_eq(node_category(node), fcpa-task-ref-category()) ? 0 : (Comparable) len(node_children(node)) == 2 ? 1 : 0;
    def fcpa-action-ref?(node) = nothing?(node) ? 0 : !node_eq(node_category(node), fcpa-action-ref-category()) ? 0 : (Comparable) len(node_children(node)) == 1 ? 1 : 0;
    def fcpa-task-ref-surface(task-ref, action-ref) = (Comparable) fcpa-task-ref?(task-ref) == 0 || (Comparable) fcpa-action-ref?(action-ref) == 0 ? "(agent-task nothing)" : str_concat("(agent-task ", str_concat(node_value(head(node_children(action-ref))), str_concat(" ", str_concat(frex-node-coordinate(task-ref), ")"))));
    // An alias is an announced, residence-local compression of a NodeID.  It
    // is never a global symbol table: each registry is supplied by the live
    // caller, validates every binding, and preserves absent and competing
    // meanings as typed observations instead of silently choosing one.
    def fcpa-alias-binding-category() = intern_trivial_string("form-cli-peer-alias-binding-v1");
    def fcpa-alias-registry-category() = intern_trivial_string("form-cli-peer-alias-registry-v1");
    def fcpa-alias-byte?(byte) = byte >= 97 && byte <= 122 ? 1 : byte >= 48 && byte <= 57 ? 1 : (Comparable) byte == 45 ? 1 : 0;
    def fcpa-alias-safe-at?(alias, at) = (Comparable) at == str_len(alias) ? 1 : (Comparable) fcpa-alias-byte?(str_byte_at(alias, at)) == 1 ? fcpa-alias-safe-at?(alias, at + 1) : 0;
    def fcpa-alias-safe?(alias) = nothing?(alias) || (Comparable) str_len(alias) == 0 ? 0 : fcpa-alias-safe-at?(alias, 0);
    def fcpa-alias-binding(alias, target) = intern_node(fcpa-alias-binding-category(), list(intern_trivial_string(alias), target));
    def fcpa-alias-binding-alias(binding) = node_value(head(node_children(binding)));
    def fcpa-alias-binding-target(binding) = nth(node_children(binding), 1);
    def fcpa-alias-binding-valid?(binding) = nothing?(binding) ? 0 : !node_eq(node_category(binding), fcpa-alias-binding-category()) ? 0 : !((Comparable) len(node_children(binding)) == 2) ? 0 : !((Comparable) node_type(head(node_children(binding))) == 2) ? 0 : (Comparable) fcpa-alias-safe?(fcpa-alias-binding-alias(binding)) == 0 ? 0 : nothing?(fcpa-alias-binding-target(binding)) ? 0 : 1;
    def fcpa-alias-registry(bindings) = intern_node(fcpa-alias-registry-category(), bindings);
    def fcpa-alias-registry-bindings(registry) = node_children(registry);
    def fcpa-alias-bindings-valid?(bindings) = nil?(bindings) ? 1 : (Comparable) fcpa-alias-binding-valid?(head(bindings)) == 1 ? fcpa-alias-bindings-valid?(tail(bindings)) : 0;
    def fcpa-alias-binding-matches(bindings, alias) = nil?(bindings) ? empty() : (String) fcpa-alias-binding-alias(head(bindings)) == alias ? cons(head(bindings), fcpa-alias-binding-matches(tail(bindings), alias)) : fcpa-alias-binding-matches(tail(bindings), alias);
    // resolution = status reason target choice-count.  `value` is the only
