        print_str(str_concat("form-peer stage route=repo-patch phase=", str_concat(phase, str_concat(" status=", str_concat(status, str_concat(" callbacks=", str_concat(int_to_str(callbacks), str_concat(" journaled=", str_concat(int_to_str(journaled), str_concat(" stamp-ms=", str_concat(int_to_str(stamp), "\n")))))))))));
