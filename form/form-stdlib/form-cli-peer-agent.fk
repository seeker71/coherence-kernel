    def fcpa-knowledge-stage-frame(ctx, stage, phase, status, generated, callbacks, lookups, injections, stamp) = str_concat(fcpa-peer-stage-open(), str_concat("\n", str_concat(fcpa-stage-field("route", "source-knowledge"), str_concat(fcpa-stage-field("task-node", fcpa-knowledge-stage-egress-task-node(ctx)), str_concat(fcpa-stage-field("task-key", fcpa-knowledge-stage-egress-task-key(ctx)), str_concat(fcpa-stage-field("stage", stage), str_concat(fcpa-stage-field("phase", phase), str_concat(fcpa-stage-field("status", status), str_concat(fcpa-stage-field("generated", int_to_str(generated)), str_concat(fcpa-stage-field("callbacks", int_to_str(callbacks)), str_concat(fcpa-stage-field("lookup-count", int_to_str(lookups)), str_concat(fcpa-stage-field("injections", int_to_str(injections)), str_concat(fcpa-stage-field("stamp-ms", int_to_str(stamp)), fcpa-peer-stage-close())))))))))))));
