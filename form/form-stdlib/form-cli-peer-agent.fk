    def fcpa-peer-stage-open() = "<|form:peer-stage|>";
    def fcpa-peer-stage-close() = "<|/form:peer-stage|>\n";
    def fcpa-stage-field(name, value) = str_concat(name, str_concat("=", str_concat(value, "\n")));
    // The host append primitive is a byte carrier. Keep the conversion at this
    // membrane explicit; the stage itself remains scannerless Form text.
    def fcpa-bytes-go(text, at, out) = at >= str_len(text) ? reverse(out) : fcpa-bytes-go(text, at + 1, cons(str_byte_at(text, at), out));
    def fcpa-bytes(text) = fcpa-bytes-go(text, 0, list());
    // Caller-born context keeps progress on the task's own append-only Form
    // channel. It is structural only: no prompt, generated text, or source
