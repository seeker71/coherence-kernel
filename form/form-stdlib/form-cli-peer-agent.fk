        } : {
            let moved = frxs-run-protocol-with-injector(session, budget, farp-cursor-fresh(), patch-ctx, farp-cursor-feed, fcpa-patch-stage-observer, fcms-observe-inline-bml);
            let raw-cursor = frxs-cursor(moved);
            let held-timeout = nothing?(farp-cursor-result(raw-cursor)) && (String) farp-cursor-scan(raw-cursor) == "held" ? 1 : 0;
            let cursor = (Comparable) held-timeout == 1 ? farp-cursor-timeout(raw-cursor) : raw-cursor;
            let timeout-session = (Comparable) held-timeout == 1 ? fcms-observe(frxs-session(moved), farp-cursor-observation(cursor)) : frxs-session(moved);
            let kept-session = (Comparable) fcms-live?(timeout-session) == 1 ? timeout-session : frxs-session(moved);
            let response = str_concat(frxs-before-text(moved), frxs-after-text(moved));
            let patch-result = farp-cursor-result(cursor);
            nothing?(patch-result) ? fcpa-result-full(kept-session, cursor, response, now_unix_ms() - started, 0, "repo-patch", farp-cursor-callbacks(cursor), "nothing", "form-repo-guard", 0, 0, 0, farp-cursor-injected-bytes(cursor), (String) farp-cursor-scan(cursor) == "held" ? "choice,timeout,cut,undo,release" : "choice,nothing,release", 0) : fcpa-result-full(kept-session, cursor, response, now_unix_ms() - started, farp-contribution(patch-result), "repo-patch", farp-cursor-callbacks(cursor), farp-status(patch-result), "form-repo-guard", (String) farp-status(patch-result) == "value" ? 1 : 0, (String) farp-status(patch-result) == "value" ? 1 : 0, 0, farp-cursor-injected-bytes(cursor), farp-trace-text(farp-trace(patch-result)), 0);
        };
    };
    def fcpa-task-stage-category() = intern_trivial_string("form-cli-peer-task-stage-v1");
    def fcpa-task-stage-node(phase, turn, kind, bytes, status, stamp) = intern_node_at(fcpa-task-stage-category(), list(intern_trivial_string(phase), intern_trivial_int(turn), intern_trivial_string(kind), intern_trivial_int(bytes), intern_trivial_string(status), intern_trivial_int(stamp)), "form-cli-peer-agent.fk", 244, 1);
    def fcpa-task-stage-line(phase, turn, kind, bytes, status, stamp) = {
        let a = str_concat("form-peer stage route=task-observation phase=", phase);
        let b = str_concat(a, str_concat(" turn=", int_to_str(turn)));
        let c = str_concat(b, str_concat(" kind=", kind));
        let d = str_concat(c, str_concat(" bytes=", int_to_str(bytes)));
        let e = str_concat(d, str_concat(" status=", status));
        str_concat(e, str_concat(" stamp-ms=", str_concat(int_to_str(stamp), "\n")));
    };
    def fcpa-task-stage-write(phase, turn, kind, bytes, status) = {
        let stamp = now_unix_ms();
        let event = fcpa-task-stage-node(phase, turn, kind, bytes, status, stamp);
        print_str(fcpa-task-stage-line(phase, turn, kind, bytes, status, stamp));
        event;
    };
    def fcpa-observe-task(session, turn, kind, task) = {
        let frame = fcpa-task-frame(turn, kind, task);
        let begin = fcpa-task-stage-write("begin", turn, kind, str_len(frame), "choice");
        let observed = fcms-observe(session, frame);
        let end = fcpa-task-stage-write("end", turn, kind, str_len(frame), fcms-status(observed));
        observed;
    };
    def fcpa-observe-task-ref(session, turn, kind, task-ref, action-ref) = {
        let frame = fcpa-task-ref-surface(task-ref, action-ref);
        let begin = fcpa-task-stage-write("begin", turn, kind, str_len(frame), "choice");
        // This remains an external task role. Semantic compression removes
        // replayed meaning, not the speaker boundary.
        let observed = fcms-observe(session, frame);
        let end = fcpa-task-stage-write("end", turn, kind, str_len(frame), fcms-status(observed));
        observed;
    };
    // Resolve before crossing the model membrane.  A registry miss, conflict,
    // or malformed binding emits a content-free stage and keeps the resident
    // state untouched; it must not manufacture `(agent-task nothing)` as if it
    // were a requested task.
    def fcpa-observe-task-alias(session, turn, kind, registry, alias, action-ref) = {
        let resolved = fcpa-task-alias-resolve(registry, alias);
        !((String) fcpa-alias-resolution-status(resolved) == "value") ? {
            let blocked = fcpa-task-stage-write("resolve", turn, kind, 0, fcpa-alias-resolution-status(resolved));
            session;
        } : {
            let frame = fcpa-task-alias-surface(registry, alias, action-ref);
            let begin = fcpa-task-stage-write("begin", turn, kind, str_len(frame), "choice");
            let observed = fcms-observe(session, frame);
            let end = fcpa-task-stage-write("end", turn, kind, str_len(frame), fcms-status(observed));
            observed;
        };
    };
    def fcpa-signal(session) = (Comparable) fcms-live?(session) == 1 ? "value" : (Comparable) fcms-resident?(session) == 1 ? "nothing-owned" : "nothing";
    0;
}
