    // language nothing, integer 0, or integer 1.
    def fcpa-assessment(result, evidence, contribution, kind) = list("form-cli-peer-assessment-v1", result, evidence, contribution, kind);
    def fcpa-assessment-result(assessment) = nth(assessment, 1);
    def fcpa-assessment-evidence(assessment) = nth(assessment, 2);
    def fcpa-assessment-contribution(assessment) = nth(assessment, 3);
    def fcpa-assessment-kind(assessment) = nth(assessment, 4);
    def fcpa-assess(result, research-observation) = (Comparable) fcpa-contribution(result) == 1 ? fcpa-assessment(result, research-observation, 1, "recipe-callback") : (Comparable) fcpa-research-observed?(fcpa-response(result), research-observation) == 1 ? fcpa-assessment(result, research-observation, 1, "observed-research") : fcpa-assessment(result, research-observation, 0, "unvalidated-speech");
    // A fresh cursor belongs to each task. Model bytes before and after a tool
    // crossing remain distinct in `moved`; the human-facing response joins them
    // only after the contribution evidence has been computed.
    def fcpa-run(session, budget) = {
        let started = now_unix_ms();
        let moved = frxs-run-with-observer(session, budget, fcpa-recipe-stage-observer);
        let response = str_concat(frxs-before-text(moved), frxs-after-text(moved));
        fcpa-result(frxs-session(moved), frxs-cursor(moved), response, now_unix_ms() - started, fcpa-contribution-of(moved));
    };
    def fcpa-string-list(xs) = nil?(xs) ? "" : nil?(tail(xs)) ? head(xs) : str_concat(head(xs), str_concat(",", fcpa-string-list(tail(xs))));
    def fcpa-knowledge-lifecycle(cursor) = nothing?(fknsc-result(cursor)) ? "" : fcpa-string-list(fknq-trace(fknsc-result(cursor)));
    // Content-free live telemetry.  Each node enters the native framebuffer and
