    // never do.
    def fcpa-knowledge-stage-category() = intern_trivial_string("form-cli-peer-knowledge-stage-v1");
    def fcpa-recipe-stage-category() = intern_trivial_string("form-cli-peer-recipe-stage-v1");
    def fcpa-knowledge-stage-node(stage, phase, status, generated, callbacks, lookups, injections, stamp) = intern_node_at(fcpa-knowledge-stage-category(), list(intern_trivial_string("source-knowledge"), intern_trivial_string(stage), intern_trivial_string(phase), intern_trivial_string(status), intern_trivial_int(generated), intern_trivial_int(callbacks), intern_trivial_int(lookups), intern_trivial_int(injections), intern_trivial_int(stamp)), "form-cli-peer-agent.fk", 151, 1);
    def fcpa-knowledge-stage-line(stage, phase, status, generated, callbacks, lookups, injections, stamp) = {
        let a = str_concat("form-peer stage route=source-knowledge stage=", stage);
        let b = str_concat(a, str_concat(" phase=", phase));
        let c = str_concat(b, str_concat(" status=", status));
        let d = str_concat(c, str_concat(" generated=", int_to_str(generated)));
        let e = str_concat(d, str_concat(" callbacks=", int_to_str(callbacks)));
        let f = str_concat(e, str_concat(" lookups=", int_to_str(lookups)));
        let g = str_concat(f, str_concat(" injections=", int_to_str(injections)));
