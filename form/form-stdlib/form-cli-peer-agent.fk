    def fcpa-knowledge-stage-observer-with-context(ctx, stage, phase, cursor, generated) = fcpa-knowledge-stage-write-with-context(ctx, stage, phase, nothing?(fknsc-result(cursor)) ? fknsc-scan-state(cursor) : fknsc-status(cursor), generated, fknsc-callback-calls(cursor), fknsc-lookup-count(cursor), fknsc-injections(cursor));
