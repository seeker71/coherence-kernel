; dsv4-control-adapter-cli.fk — native fit + heldout confusion report.
; Run: ./fkwu form/form-stdlib/dsv4-control-adapter-cli.fk
; preludes: form-stdlib/dsv4-control-adapter.fk

(do
    (defn dcac-row (m i)
        (str_concat (int_to_str (nth m (mul i 5)))
        (str_concat " " (str_concat (int_to_str (nth m (add (mul i 5) 1)))
        (str_concat " " (str_concat (int_to_str (nth m (add (mul i 5) 2)))
        (str_concat " " (str_concat (int_to_str (nth m (add (mul i 5) 3)))
        (str_concat " " (int_to_str (nth m (add (mul i 5) 4))))))))))))
    (let report (dca-report))
    (let matrix (nth report 0))
    (print_str "channel=ds4.control-adapter.form-native")
    (print_str "trained_examples=600")
    (print_str "heldout_examples=150")
    (print_str "columns=NIL CUT FAIL TIMEOUT CHOICE")
    (print_str (str_concat "actual.NIL=" (dcac-row matrix 0)))
    (print_str (str_concat "actual.CUT=" (dcac-row matrix 1)))
    (print_str (str_concat "actual.FAIL=" (dcac-row matrix 2)))
    (print_str (str_concat "actual.TIMEOUT=" (dcac-row matrix 3)))
    (print_str (str_concat "actual.CHOICE=" (dcac-row matrix 4)))
    (print_str (str_concat "heldout_correct=" (int_to_str (nth report 1))))
    (print_str (str_concat "template_overlap=" (int_to_str (nth report 2))))
    (print_str (str_concat "sufficiency=" (nth report 3)))
    report)
