; form-knowledge-axioms-public-curriculum-run.fk -- direct-source public
; adapter witness.  It renders one current packet without model or carrier work.
;
; This top-level renderer is effectful (stdout), so prove the pure definitions
; and adversarial band with preflight; execute this file directly for the
; current NodeID/source observation.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk form-stdlib/form-fs.fk form-stdlib/file-byte-window.fk form-stdlib/sha256.fk form-stdlib/hex.fk form-stdlib/form-knowledge-source-search.fk form-stdlib/form-knowledge-axioms-public-curriculum.fk

(do
    (defn fkapr-line (name value)
        (print_str (str_concat name (str_concat "=" (str_concat value "\n")))))

    (let packet (fkap-source-bound-hook "states" 0))
    (if (nothing? packet)
        (fkapr-line "status" "nothing")
        (do
            (fkapr-line "status" (nth packet 5))
            (fkapr-line "concept" (nth packet 14))
            (fkapr-line "variation" (nth packet 15))
            (fkapr-line "lesson-nodeid" (nth packet 7))
            (fkapr-line "lesson-category" "31.2.0.120")
            (fkapr-line "packet-nodeid" (nth packet 2))
            (fkapr-line "packet-category" "31.2.0.121")
            (fkapr-line "nothing-alternative-nodeid" (nth packet 4))
            (fkapr-line "nothing-alternative-category" "31.2.0.122")
            (fkapr-line "source-id" (nth packet 13))
            (fkapr-line "source-bound-query" (nth packet 8))
            (fkapr-line "path-query" (nth packet 9))
            (fkapr-line "model-executed" (int_to_str (nth packet 17)))
            (fkapr-line "weights-trained" (int_to_str (nth packet 18)))
            (fkapr-line "packet-valid" (int_to_str (fkap-packet-valid? packet)))))
    0)
