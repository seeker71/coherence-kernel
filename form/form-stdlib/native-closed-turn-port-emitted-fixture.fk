; native-closed-turn-port-emitted-fixture.fk -- disposable Form-table crossing
; for the closed typed turn-port fixture.
;
; This is deliberately not a form-cli verb, native-op-manifest entry, source
; primitive, or public controller replacement.  It constructs tag 256 as Hati
; table data only, bakes that one table into a temporary native executable, and
; crosses one canonical exchange id from Form's read_line through a typed C ABI.
; The table fixes the five-step lifecycle: open -> fixed native-capability
; observation -> deterministic local run -> seal -> discard.  There is no
; shell command,
; argv operation, path, model locator, prompt, response, network target, or
; host-exec route in this fixture.
;
; The linked lifecycle library is also emitted from Form, but remains a
; separate translation unit so its POSIX headers cannot weaken or conflict with
; the generic table walker's declarations.  The table arm reads pool bytes and
; lengths directly; it never converts the exchange id through fk_cstr.  Its
; only return is one fixed content-blind decision token, which Form prints with
; tag 115.
;
; P1 limits remain named: this proves neither a local model nor resource use, no
; child timeout/output-cap/process-group boundary, no directory-fsync or
; power-loss durability, no same-UID leaf-race proof, and no historical or live
; promotion/authority movement.  The generic carrier contains dormant network
; helpers; this baked table contains no network opcode and this fixture makes no
; network call.  That is an executed-path observation, not a claim that the
; whole generic binary is network-free.
;
; Fixture build rule: the separate lifecycle library stays under full
; -Wall -Wextra -Werror.  The generic runner alone uses
; -Werror -Wno-unused-function because it deliberately retains optional generic
; arms/helpers outside this baked table; no other warning class is waived.
;
; preludes: form-stdlib/minimal-surface.fk form-stdlib/hati-os-kernel.fk form-stdlib/host-io-fs-fkwu-emit.fk form-stdlib/form-table-text.fk form-stdlib/fkc-table-serialize.fk form-stdlib/hati-os-kernel-emit.fk form-stdlib/native-closed-turn-port-fixture.fk

(do
    (defn fctpe-arm-slots () 257)

    ; This ABI is the entire bridge from the emitted walker to the separately
    ; Form-emitted FCTP library.  The two inputs are byte pointer + exact length;
    ; no C string is accepted from the walker.
    (defn fctpe-abi-decls ()
        "extern int fctp_emitted_dispatch(const char *, unsigned long, const char *, unsigned long, const char **, unsigned long *); ")

    ; The generic baked main names these optional genesis symbols.  This
    ; disposable fixture supplies a zero-length definition in its own
    ; Form-emitted translation unit solely for the link; it changes neither the
    ; normal platform nor the baked-main source.
    (defn fctpe-zero-genesis-c ()
        "const unsigned char fk_genesis[] = { 0 }; const long long fk_genesis_len = 0;\n")

    (defn fctpe-port-node (operation exchange-id)
        (fk-node 256 (ms-intern operation exchange-id)))

    (defn fctpe-read-line () (fk-node 114 (ms-cell 0)))
    (defn fctpe-print (value) (fk-node 115 value))

    (defn fctpe-open ()
        (fctpe-print (fctpe-port-node (fk-slit 0 "open") (fk-arg))))
    ; This stage is baked into the fixed table; Form input supplies only the
    ; exchange id, never a resource or mode choice.
    (defn fctpe-native-capability ()
        (fctpe-print (fctpe-port-node (fk-slit 1 "native-capability") (fk-arg))))
    (defn fctpe-run ()
        (fctpe-print (fctpe-port-node (fk-slit 2 "run") (fk-arg))))
    (defn fctpe-seal ()
        (fctpe-print (fctpe-port-node (fk-slit 3 "seal") (fk-arg))))
    (defn fctpe-discard ()
        (fctpe-print (fctpe-port-node (fk-slit 4 "discard") (fk-arg))))

    (defn fctpe-lifecycle ()
        (fk-sequence (fctpe-open)
        (fk-sequence (fctpe-native-capability)
        (fk-sequence (fctpe-run)
        (fk-sequence (fctpe-seal)
                     (fctpe-discard))))))

    ; fn 0 is the Form membrane: one stdin line becomes the only exchange-id
    ; value seen by the fixed tag-256 sequence in fn 1.
    (defn fctpe-fns ()
        (list (fk-call 1 (fctpe-read-line))
              (fctpe-lifecycle)))

    ; These are the only table-pool strings the custom arm can receive as an
    ; stage.  The id is not baked: the temporary test supplies it on stdin.
    (defn fctpe-pool ()
        (list "open" "native-capability" "run" "seal" "discard"))

    (defn fctpe-table ()
        (fks-table-file (fctpe-fns) (fctpe-pool)))

    ; Both operands are evaluated and parked before their pool slots are read.
    ; The exact-byte ABI rejects unknown operations and noncanonical ids; even a
    ; refused call returns only the fixed non-content token below.
    (defn fctpe-arm-text ()
        "if (t == 256) { long long fctpe_operation_value = fk_walk(fk_node[i][1], fp); fk_vp(fctpe_operation_value); long long fctpe_exchange_value = fk_walk(fk_node[i][2], fp); fk_vp(fctpe_exchange_value); long long fctpe_base = fk_vsp - 2; long long fctpe_operation_pool = fk_vs[fctpe_base] >> 1; long long fctpe_exchange_pool = fk_vs[fctpe_base + 1] >> 1; static const char fctpe_refused[] = \"fctp-port-refused\"; const char *fctpe_token = fctpe_refused; unsigned long fctpe_token_length = sizeof(fctpe_refused) - 1; if (fctpe_operation_pool >= 0 && fctpe_operation_pool < fk_sp && fctpe_exchange_pool >= 0 && fctpe_exchange_pool < fk_sp) { const char *fctpe_operation_bytes = fk_sb + fk_so[fctpe_operation_pool]; const char *fctpe_exchange_bytes = fk_sb + fk_so[fctpe_exchange_pool]; const char *fctpe_returned_token = 0; unsigned long fctpe_returned_length = 0; if (fctp_emitted_dispatch(fctpe_operation_bytes, (unsigned long)fk_sl[fctpe_operation_pool], fctpe_exchange_bytes, (unsigned long)fk_sl[fctpe_exchange_pool], &fctpe_returned_token, &fctpe_returned_length) != 0 && fctpe_returned_token != 0 && fctpe_returned_length > 0 && fctpe_returned_length <= 128) { fctpe_token = fctpe_returned_token; fctpe_token_length = fctpe_returned_length; } } fk_vsp = fctpe_base; return fk_sbuf(fctpe_token, (long long)fctpe_token_length); } ")

    (defn fctpe-emit-c ()
        (fkc-emit-combined-repl-with-extension
            (fctpe-table)
            (fctpe-arm-slots)
            (fctpe-abi-decls)
            (fctpe-arm-text)))

    (fctpe-emit-c))
