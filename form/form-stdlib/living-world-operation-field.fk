; living-world-operation-field.fk -- behavior, not a name, identifies an operation.
;
; Participants may offer any safe minimal evaluator surface and any ordering of
; already admitted opaque roles.  This organ grants neither surface nor order
; meaning.  It executes every recurrent carrier against the same recurrent,
; consented examples and identifies provisional operation classes only by exact
; example/output signatures.  Equivalent surfaces share a class; contradictory
; and unresolved surfaces remain present.  A held-out query observes every
; compatible profile.  Agreement yields ONE, divergence yields NODE, absence
; yields NOTHING, and sender-authored time remains a separate observation.
;
; No operator list, role vocabulary, answer table, representative carrier,
; majority, score, NodeID ordering, host route, file route, network route, or
; remote oracle lives here.  The minimal source codec still needs separately
; offered safe evaluator and variable tokens; unsupported evaluator surfaces
; remain an honest boundary of the underlying bounded Form interface.
;
; witnessed: 2026-08-07 -> 32767
; preludes: form-stdlib/core.fk form-stdlib/form-eval-full.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk form-stdlib/living-world-lens-channel.fk form-stdlib/living-world-recipe-execution.fk form-stdlib/living-world-action-cycle.fk form-stdlib/living-world-recipe-hypothesis.fk form-stdlib/living-world-hypothesis-tissue.fk form-stdlib/living-world-structural-recipe.fk

(let LWOE-CARRIER         (bp "LWOE-CARRIER"))
(let LWOE-EXAMPLE         (bp "LWOE-EXAMPLE"))
(let LWOE-TRIAL           (bp "LWOE-TRIAL"))
(let LWOE-SIGNATURE-ITEM  (bp "LWOE-SIGNATURE-ITEM"))
(let LWOE-SIGNATURE       (bp "LWOE-SIGNATURE"))
(let LWOE-PROFILE         (bp "LWOE-PROFILE"))
(let LWOE-CLASS           (bp "LWOE-CLASS"))
(let LWOE-FIELD           (bp "LWOE-FIELD"))
(let LWOE-ORIGIN          (bp "LWOE-ORIGIN"))
(let LWOE-QUERY           (bp "LWOE-QUERY"))
(let LWOE-QUERY-EVAL      (bp "LWOE-QUERY-EVAL"))
(let LWOE-ANSWER          (bp "LWOE-ANSWER"))

(defn lwoe-field-union-items (items field)
    (if (eq (len items) 0) field
        (lwoe-field-union-items (tail items)
            (lwo-field-add field (head items)))))
(defn lwoe-attributions (world cell field)
    (lwoe-field-union-items
        (lwo-field-items (lwo-active-attributions-for world cell)) field))

; --- separately offered executable carriers -------------------------

(defn lwoe-role-items-valid? (items seen)
    (if (eq (len items) 0) 1
        (do
            (let role (head items))
            (if (or (eq (lwsr-role-candidate? role) 0)
                    (eq (lwo-field-has? seen role) 1)) 0
                (lwoe-role-items-valid? (tail items)
                    (lwo-field-add seen role))))))
(defn lwoe-role-items-current? (world items)
    (if (eq (len items) 0) 1
        (if (eq (lwsr-role-integrated-current?
                    world (head items)) 1)
            (lwoe-role-items-current? world (tail items)) 0)))

; children: enquiry, offered evaluator surface, ordered admitted roles,
;           alternatives, optional unknown, evidence, local path
(defn lwoe-carrier
    (enquiry operator roles alternatives unknown evidence)
    (intern_node LWOE-CARRIER
        (list enquiry operator roles alternatives unknown evidence
              (lwo-local-path))))
(defn lwoe-carrier? (cell) (lwo-category? cell LWOE-CARRIER))
(defn lwoe-carrier-enquiry (carrier) (nth (node_children carrier) 0))
(defn lwoe-carrier-operator (carrier) (nth (node_children carrier) 1))
(defn lwoe-carrier-roles (carrier) (nth (node_children carrier) 2))
(defn lwoe-carrier-alternatives (carrier) (nth (node_children carrier) 3))
(defn lwoe-carrier-unknown (carrier) (nth (node_children carrier) 4))
(defn lwoe-carrier-evidence (carrier) (nth (node_children carrier) 5))
(defn lwoe-carrier-path (carrier) (nth (node_children carrier) 6))
(defn lwoe-carrier-valid? (carrier)
    (if (eq (lwoe-carrier? carrier) 0) 0
        (do
            (let roles (lwoe-carrier-roles carrier))
            (if (eq (lwph-enquiry-valid?
                        (lwoe-carrier-enquiry carrier)) 0) 0
                (if (eq (lwph-operator-valid?
                            (lwoe-carrier-operator carrier)) 0) 0
                    (if (not (node_eq
                                (lwph-operator-enquiry
                                    (lwoe-carrier-operator carrier))
                                (lwoe-carrier-enquiry carrier))) 0
                        (if (or (eq (lwsr-role-sequence? roles) 0)
                                (eq (len (lwsr-role-items roles)) 0)) 0
                            (if (eq (lwoe-role-items-valid?
                                      (lwsr-role-items roles)
                                      (lwo-empty-field)) 0) 0
                                (if (eq (lwo-category?
                                          (lwoe-carrier-alternatives carrier)
                                          LWO-FIELD) 0) 0
                                    (lwph-optional-unknown-valid?
                                        (lwoe-carrier-unknown
                                            carrier)))))))))))
(defn lwoe-carrier-current? (world carrier enquiry)
    (if (eq (lwoe-carrier-valid? carrier) 0) 0
        (if (not (node_eq
                    (lwoe-carrier-enquiry carrier) enquiry)) 0
            (if (eq (lwo-active? world carrier) 0) 0
                (if (eq (lwph-operator-current? world
                            (lwoe-carrier-operator carrier) enquiry) 0) 0
                    (lwoe-role-items-current? world
                        (lwsr-role-items
                            (lwoe-carrier-roles carrier))))))))
(defn lwoe-carrier-recurrent? (world carrier enquiry threshold)
    (if (and (gt threshold 0)
             (and (eq (lwoe-carrier-current?
                          world carrier enquiry) 1)
                  (ge (lwph-active-source-count world carrier)
                      threshold))) 1 0))
(defn lwoe-collect-carriers (world items enquiry threshold field)
    (if (eq (len items) 0) field
        (lwoe-collect-carriers world (tail items) enquiry threshold
            (if (eq (lwoe-carrier-recurrent?
                        world (head items) enquiry threshold) 1)
                (lwo-field-add field (head items)) field))))
(defn lwoe-carriers-for (world enquiry threshold)
    (lwoe-collect-carriers world
        (lwo-field-items (lwo-world-cells world)) enquiry threshold
        (lwo-empty-field)))

; --- consented transformation examples ------------------------------

(defn lwoe-values-valid-items? (items)
    (if (eq (len items) 0) 1
        (if (eq (lwsr-value-valid? (head items)) 1)
            (lwoe-values-valid-items? (tail items)) 0)))
(defn lwoe-values-current-items? (world items)
    (if (eq (len items) 0) 1
        (do
            (let value (head items))
            (if (eq (lwsr-value-current?
                        world value (lwsr-value-role value)) 1)
                (lwoe-values-current-items? world (tail items)) 0))))
(defn lwoe-observed-valid? (observed)
    (if (or (node_eq observed (lwo-none))
            (eq (node_type observed) 1)) 1 0))
(defn lwoe-example-ack-coherent? (observed ack)
    (if (eq (oac-one? ack) 1)
        (if (and (not (node_eq observed (lwo-none)))
                 (node_eq (oac-payload ack) observed)) 1 0)
        (if (eq (oac-nothing? ack) 1)
            (if (node_eq observed (lwo-none)) 1 0)
            (if (eq (oac-zero? ack) 1)
                (if (node_eq observed (lwo-none)) 1 0)
                1))))

; children: enquiry, exact opaque-role values, optional observed integer,
;           ack, alternatives, optional unknown, evidence, local path
(defn lwoe-example
    (enquiry values observed ack alternatives unknown evidence)
    (intern_node LWOE-EXAMPLE
        (list enquiry values observed ack alternatives unknown evidence
              (lwo-local-path))))
(defn lwoe-example? (cell) (lwo-category? cell LWOE-EXAMPLE))
(defn lwoe-example-enquiry (example) (nth (node_children example) 0))
(defn lwoe-example-values (example) (nth (node_children example) 1))
(defn lwoe-example-observed (example) (nth (node_children example) 2))
(defn lwoe-example-ack (example) (nth (node_children example) 3))
(defn lwoe-example-alternatives (example) (nth (node_children example) 4))
(defn lwoe-example-unknown (example) (nth (node_children example) 5))
(defn lwoe-example-evidence (example) (nth (node_children example) 6))
(defn lwoe-example-path (example) (nth (node_children example) 7))
(defn lwoe-example-valid? (example)
    (if (eq (lwoe-example? example) 0) 0
        (if (eq (lwph-enquiry-valid?
                    (lwoe-example-enquiry example)) 0) 0
            (if (eq (lwo-category?
                        (lwoe-example-values example) LWO-FIELD) 0) 0
                (if (eq (lwoe-values-valid-items?
                            (lwo-field-items
                                (lwoe-example-values example))) 0) 0
                    (if (eq (lwoe-observed-valid?
                                (lwoe-example-observed example)) 0) 0
                        (if (eq (oac-valid-ack?
                                    (lwoe-example-ack example)) 0) 0
                            (if (eq (lwoe-example-ack-coherent?
                                      (lwoe-example-observed example)
                                      (lwoe-example-ack example)) 0) 0
                                (if (eq (lwo-category?
                                          (lwoe-example-alternatives example)
                                          LWO-FIELD) 0) 0
                                    (lwph-optional-unknown-valid?
                                        (lwoe-example-unknown
                                            example)))))))))))
(defn lwoe-example-current? (world example enquiry)
    (if (eq (lwoe-example-valid? example) 0) 0
        (if (not (node_eq
                    (lwoe-example-enquiry example) enquiry)) 0
            (if (eq (lwph-enquiry-current? world enquiry) 0) 0
                (if (eq (lwo-active? world example) 0) 0
                    (lwoe-values-current-items? world
                        (lwo-field-items
                            (lwoe-example-values example))))))))
(defn lwoe-example-recurrent? (world example enquiry threshold)
    (if (and (gt threshold 0)
             (and (eq (lwoe-example-current?
                          world example enquiry) 1)
                  (ge (lwph-active-source-count world example)
                      threshold))) 1 0))
(defn lwoe-collect-examples (world items enquiry threshold field)
    (if (eq (len items) 0) field
        (lwoe-collect-examples world (tail items) enquiry threshold
            (if (eq (lwoe-example-recurrent?
                        world (head items) enquiry threshold) 1)
                (lwo-field-add field (head items)) field))))
(defn lwoe-examples-for (world enquiry threshold)
    (lwoe-collect-examples world
        (lwo-field-items (lwo-world-cells world)) enquiry threshold
        (lwo-empty-field)))

; --- exact native trials and behavior profiles ----------------------

(defn lwoe-codecs-current-for-roles? (world items codecs prior)
    (if (eq (len items) 0) 1
        (do
            (let role (head items))
            (let codec (lwsr-one-codec-for-role codecs role))
            (if (or (node_eq codec (lwo-none))
                    (or (eq (lwsr-codec-current?
                              world codec role) 0)
                        (eq (lwsr-token-in-roles?
                              prior codecs
                              (lwsr-codec-token codec)) 1))) 0
                (lwoe-codecs-current-for-roles? world (tail items)
                    codecs (append prior (list role)))))))
(defn lwoe-example-complete-for? (carrier codecs example)
    (lwsr-application-complete-items?
        (lwsr-role-items (lwoe-carrier-roles carrier)) (list)
        codecs (lwoe-example-values example)))
(defn lwoe-source-role-items (items codecs source)
    (if (eq (len items) 0) source
        (do
            (let codec
                (lwsr-one-codec-for-role codecs (head items)))
            (lwoe-source-role-items (tail items) codecs
                (str_concat source
                    (str_concat " " (lwsr-codec-token codec)))))))
(defn lwoe-source-for (carrier codecs)
    (str_concat
        (lwoe-source-role-items
            (lwsr-role-items (lwoe-carrier-roles carrier)) codecs
            (str_concat "("
                (lwph-operator-token
                    (lwoe-carrier-operator carrier))))
        ")"))
(defn lwoe-recipe-for (carrier codecs)
    (lwre-recipe (lwoe-source-for carrier codecs)
        (lwre-bound-form-contract 128 carrier) carrier))
(defn lwoe-bindings-for (carrier codecs values)
    (lwre-bindings
        (lwsr-bindings-items
            (lwsr-role-items (lwoe-carrier-roles carrier))
            codecs values (list))))

; children: carrier, example, exact Recipe/bindings, output, comparison,
;           state, local path
(defn lwoe-trial
    (carrier example recipe bindings output comparison state)
    (intern_node LWOE-TRIAL
        (list carrier example recipe bindings output comparison state
              (lwo-local-path))))
(defn lwoe-trial? (cell) (lwo-category? cell LWOE-TRIAL))
(defn lwoe-trial-carrier (trial) (nth (node_children trial) 0))
(defn lwoe-trial-example (trial) (nth (node_children trial) 1))
(defn lwoe-trial-recipe (trial) (nth (node_children trial) 2))
(defn lwoe-trial-bindings (trial) (nth (node_children trial) 3))
(defn lwoe-trial-output (trial) (nth (node_children trial) 4))
(defn lwoe-trial-comparison (trial) (nth (node_children trial) 5))
(defn lwoe-trial-state (trial) (nth (node_children trial) 6))
(defn lwoe-trial-path (trial) (nth (node_children trial) 7))
(defn lwoe-trial-for (world carrier codecs example enquiry)
    (if (or (eq (lwoe-carrier-current?
                    world carrier enquiry) 0)
            (or (eq (lwoe-example-current?
                        world example enquiry) 0)
                (eq (lwoe-example-complete-for?
                        carrier codecs example) 0))) (lwo-none)
        (do
            (let roles
                (lwsr-role-items (lwoe-carrier-roles carrier)))
            (if (eq (lwoe-codecs-current-for-roles?
                        world roles codecs (list)) 0) (lwo-none)
                (do
                    (let recipe (lwoe-recipe-for carrier codecs))
                    (let bindings
                        (lwoe-bindings-for carrier codecs
                            (lwoe-example-values example)))
                    (let output
                        (intern_trivial_int
                            (lwre-evaluate-bound recipe bindings)))
                    (let ack (lwoe-example-ack example))
                    (if (eq (oac-one? ack) 0)
                        (lwoe-trial carrier example recipe bindings output ack
                            (lwph-unresolved))
                        (do
                            (let observed
                                (lwoe-example-observed example))
                            (if (node_eq output observed)
                                (lwoe-trial carrier example recipe bindings
                                    output (oac-one output)
                                    (lwph-consistent))
                                (lwoe-trial carrier example recipe bindings
                                    output
                                    (oac-alternative-ack
                                        observed output example)
                                    (lwph-divergent))))))))))
(defn lwoe-trials-for-items
    (world carrier codecs items enquiry field)
    (if (eq (len items) 0) field
        (do
            (let trial
                (lwoe-trial-for world carrier codecs
                    (head items) enquiry))
            (lwoe-trials-for-items world carrier codecs (tail items) enquiry
                (if (node_eq trial (lwo-none)) field
                    (lwo-field-add field trial))))))

(defn lwoe-signature-item (example output)
    (intern_node LWOE-SIGNATURE-ITEM
        (list example output (lwo-local-path))))
(defn lwoe-signature-item-example (item) (nth (node_children item) 0))
(defn lwoe-signature-item-output (item) (nth (node_children item) 1))
(defn lwoe-signature (items)
    (intern_node LWOE-SIGNATURE items))
(defn lwoe-signature? (cell) (lwo-category? cell LWOE-SIGNATURE))
(defn lwoe-signature-items (trials items)
    (if (eq (len trials) 0) items
        (lwoe-signature-items (tail trials)
            (append items
                (list (lwoe-signature-item
                    (lwoe-trial-example (head trials))
                    (lwoe-trial-output (head trials))))))))
(defn lwoe-trials-state-items
    (items any-consistent any-divergent any-unresolved)
    (if (eq (len items) 0)
        (if (eq any-divergent 1) (lwph-divergent)
            (if (and (eq any-consistent 1)
                     (eq any-unresolved 0))
                (lwph-consistent) (lwph-unresolved)))
        (do
            (let state (lwoe-trial-state (head items)))
            (lwoe-trials-state-items (tail items)
                (if (eq (lwph-consistent? state) 1) 1 any-consistent)
                (if (eq (lwph-divergent? state) 1) 1 any-divergent)
                (if (eq (lwph-unresolved? state) 1) 1 any-unresolved)))))
(defn lwoe-trials-state (trials)
    (lwoe-trials-state-items
        (lwo-field-items trials) 0 0 0))

; children: exact carrier, trials, behavior signature, state,
;           alternatives, unknowns, local path
(defn lwoe-profile
    (carrier trials signature state alternatives unknowns)
    (intern_node LWOE-PROFILE
        (list carrier trials signature state alternatives unknowns
              (lwo-local-path))))
(defn lwoe-profile? (cell) (lwo-category? cell LWOE-PROFILE))
(defn lwoe-profile-carrier (profile) (nth (node_children profile) 0))
(defn lwoe-profile-trials (profile) (nth (node_children profile) 1))
(defn lwoe-profile-signature (profile) (nth (node_children profile) 2))
(defn lwoe-profile-state (profile) (nth (node_children profile) 3))
(defn lwoe-profile-alternatives (profile) (nth (node_children profile) 4))
(defn lwoe-profile-unknowns (profile) (nth (node_children profile) 5))
(defn lwoe-profile-path (profile) (nth (node_children profile) 6))
(defn lwoe-example-alternatives-items (items field)
    (if (eq (len items) 0) field
        (lwoe-example-alternatives-items (tail items)
            (lwoe-field-union-items
                (lwo-field-items
                    (lwoe-example-alternatives (head items))) field))))
(defn lwoe-example-unknowns-items (items field)
    (if (eq (len items) 0) field
        (do
            (let unknown (lwoe-example-unknown (head items)))
            (lwoe-example-unknowns-items (tail items)
                (if (node_eq unknown (lwo-none)) field
                    (lwo-field-add field unknown))))))
(defn lwoe-profile-for (world carrier codecs examples enquiry)
    (do
        (let trials
            (lwoe-trials-for-items world carrier codecs
                (lwo-field-items examples) enquiry (lwo-empty-field)))
        (if (not (eq (lwo-field-size trials)
                     (lwo-field-size examples))) (lwo-none)
            (do
                (let signature
                    (lwoe-signature
                        (lwoe-signature-items
                            (lwo-field-items trials) (list))))
                (let state (lwoe-trials-state trials))
                (let alternatives
                    (lwo-field-add
                        (lwoe-field-union-items
                            (lwo-field-items
                                (lwoe-carrier-alternatives carrier))
                            (lwoe-example-alternatives-items
                                (lwo-field-items examples)
                                (lwph-enquiry-alternatives enquiry)))
                        (lwoe-recipe-for carrier codecs)))
                (let unknowns
                    (lwoe-example-unknowns-items
                        (lwo-field-items examples)
                        (if (node_eq
                              (lwoe-carrier-unknown carrier) (lwo-none))
                            (lwo-empty-field)
                            (lwo-field-add (lwo-empty-field)
                                (lwoe-carrier-unknown carrier)))))
                (lwoe-profile carrier trials signature state
                    alternatives unknowns)))))
(defn lwoe-profiles-for-items
    (world carriers codecs examples enquiry field)
    (if (eq (len carriers) 0) field
        (do
            (let profile
                (lwoe-profile-for world (head carriers)
                    codecs examples enquiry))
            (lwoe-profiles-for-items world (tail carriers) codecs
                examples enquiry
                (if (node_eq profile (lwo-none)) field
                    (lwo-field-add field profile))))))
(defn lwoe-filter-profiles (items state field)
    (if (eq (len items) 0) field
        (lwoe-filter-profiles (tail items) state
            (if (node_eq (lwoe-profile-state (head items)) state)
                (lwo-field-add field (head items)) field))))

; --- behavior classes have no representative surface ---------------

(defn lwoe-signatures-for-profiles (items field)
    (if (eq (len items) 0) field
        (lwoe-signatures-for-profiles (tail items)
            (lwo-field-add field
                (lwoe-profile-signature (head items))))))
(defn lwoe-profiles-with-signature (items signature field)
    (if (eq (len items) 0) field
        (lwoe-profiles-with-signature (tail items) signature
            (if (node_eq
                    (lwoe-profile-signature (head items)) signature)
                (lwo-field-add field (head items)) field))))

; children: exact behavior signature, every compatible profile,
;           alternatives, unknowns, local path
(defn lwoe-class (signature profiles alternatives unknowns)
    (intern_node LWOE-CLASS
        (list signature profiles alternatives unknowns
              (lwo-local-path))))
(defn lwoe-class? (cell) (lwo-category? cell LWOE-CLASS))
(defn lwoe-class-signature (class) (nth (node_children class) 0))
(defn lwoe-class-profiles (class) (nth (node_children class) 1))
(defn lwoe-class-alternatives (class) (nth (node_children class) 2))
(defn lwoe-class-unknowns (class) (nth (node_children class) 3))
(defn lwoe-class-path (class) (nth (node_children class) 4))
(defn lwoe-profile-alternatives-items (items field)
    (if (eq (len items) 0) field
        (lwoe-profile-alternatives-items (tail items)
            (lwoe-field-union-items
                (lwo-field-items
                    (lwoe-profile-alternatives (head items))) field))))
(defn lwoe-profile-unknowns-items (items field)
    (if (eq (len items) 0) field
        (lwoe-profile-unknowns-items (tail items)
            (lwoe-field-union-items
                (lwo-field-items
                    (lwoe-profile-unknowns (head items))) field))))
(defn lwoe-classes-for-signatures
    (signatures profiles field)
    (if (eq (len signatures) 0) field
        (do
            (let signature (head signatures))
            (let members
                (lwoe-profiles-with-signature profiles signature
                    (lwo-empty-field)))
            (let alternatives
                (lwoe-profile-alternatives-items
                    (lwo-field-items members) (lwo-empty-field)))
            (let unknowns
                (lwo-field-add
                    (lwoe-profile-unknowns-items
                        (lwo-field-items members) (lwo-empty-field))
                    (lwlc-unknown members)))
            (lwoe-classes-for-signatures (tail signatures) profiles
                (lwo-field-add field
                    (lwoe-class signature members alternatives unknowns))))))

; --- field formation and unanimous admission ------------------------

(defn lwoe-carrier-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let carrier (head items))
            (let with-carrier (lwoe-attributions world carrier field))
            (let with-operator
                (lwoe-attributions world
                    (lwoe-carrier-operator carrier) with-carrier))
            (let with-roles
                (lwsr-role-candidate-witnesses world
                    (lwsr-role-items (lwoe-carrier-roles carrier))
                    with-operator))
            (lwoe-carrier-witnesses-items world (tail items) with-roles))))
(defn lwoe-example-witnesses-items (world items field)
    (if (eq (len items) 0) field
        (do
            (let example (head items))
            (let with-example (lwoe-attributions world example field))
            (let with-values
                (lwsr-codec-value-witnesses world
                    (lwo-field-items (lwoe-example-values example))
                    with-example))
            (lwoe-example-witnesses-items world (tail items) with-values))))
(defn lwoe-field-witnesses (world enquiry carriers examples codecs)
    (do
        (let with-enquiry
            (lwoe-attributions world enquiry (lwo-empty-field)))
        (let with-focus
            (lwoe-attributions world
                (lwph-enquiry-focus enquiry) with-enquiry))
        (let with-carriers
            (lwoe-carrier-witnesses-items world
                (lwo-field-items carriers) with-focus))
        (let with-examples
            (lwoe-example-witnesses-items world
                (lwo-field-items examples) with-carriers))
        (lwsr-codec-value-witnesses world
            (lwo-field-items codecs) with-examples)))

; children: enquiry, exact codecs, examples, profiles, compatible,
;           contradicted, unresolved, behavior classes, status,
;           alternatives, unknowns, witnesses, threshold, local path
(defn lwoe-field
    (enquiry codecs examples profiles compatible contradicted unresolved
     classes status alternatives unknowns witnesses threshold)
    (intern_node LWOE-FIELD
        (list enquiry codecs examples profiles compatible contradicted
              unresolved classes status alternatives unknowns witnesses
              (intern_trivial_int threshold) (lwo-local-path))))
(defn lwoe-field? (cell) (lwo-category? cell LWOE-FIELD))
(defn lwoe-field-enquiry (field) (nth (node_children field) 0))
(defn lwoe-field-codecs (field) (nth (node_children field) 1))
(defn lwoe-field-examples (field) (nth (node_children field) 2))
(defn lwoe-field-profiles (field) (nth (node_children field) 3))
(defn lwoe-field-compatible (field) (nth (node_children field) 4))
(defn lwoe-field-contradicted (field) (nth (node_children field) 5))
(defn lwoe-field-unresolved (field) (nth (node_children field) 6))
(defn lwoe-field-classes (field) (nth (node_children field) 7))
(defn lwoe-field-status (field) (nth (node_children field) 8))
(defn lwoe-field-alternatives (field) (nth (node_children field) 9))
(defn lwoe-field-unknowns (field) (nth (node_children field) 10))
(defn lwoe-field-witness-field (field) (nth (node_children field) 11))
(defn lwoe-field-threshold (field)
    (node_value (nth (node_children field) 12)))
(defn lwoe-field-path (field) (nth (node_children field) 13))
(defn lwoe-field-for (world enquiry codecs threshold)
    (if (or (le threshold 0)
            (or (eq (lwph-enquiry-current? world enquiry) 0)
                (eq (lwo-category? codecs LWO-FIELD) 0))) (lwo-none)
        (do
            (let carriers (lwoe-carriers-for world enquiry threshold))
            (let examples (lwoe-examples-for world enquiry threshold))
            (if (or (eq (lwo-field-size carriers) 0)
                    (eq (lwo-field-size examples) 0)) (lwo-none)
                (do
                    (let profiles
                        (lwoe-profiles-for-items world
                            (lwo-field-items carriers) codecs examples enquiry
                            (lwo-empty-field)))
                    (let compatible
                        (lwoe-filter-profiles
                            (lwo-field-items profiles)
                            (lwph-consistent) (lwo-empty-field)))
                    (let contradicted
                        (lwoe-filter-profiles
                            (lwo-field-items profiles)
                            (lwph-divergent) (lwo-empty-field)))
                    (let unresolved
                        (lwoe-filter-profiles
                            (lwo-field-items profiles)
                            (lwph-unresolved) (lwo-empty-field)))
                    (let signatures
                        (lwoe-signatures-for-profiles
                            (lwo-field-items compatible)
                            (lwo-empty-field)))
                    (let classes
                        (lwoe-classes-for-signatures
                            (lwo-field-items signatures)
                            (lwo-field-items compatible)
                            (lwo-empty-field)))
                    (let class-count (lwo-field-size classes))
                    (let status
                        (if (eq (lwo-field-size profiles) 0) (lwph-open)
                            (if (gt class-count 1) (lwph-plural)
                                (if (eq class-count 1) (lwph-singular)
                                    (if (eq
                                          (lwo-field-size contradicted)
                                          (lwo-field-size profiles))
                                        (lwph-refuted)
                                        (lwph-open))))))
                    (let alternatives
                        (lwoe-field-union-items
                            (lwo-field-items profiles)
                            (lwph-enquiry-alternatives enquiry)))
                    (let unknowns
                        (lwo-field-add
                            (if (node_eq
                                  (lwph-enquiry-unknown enquiry) (lwo-none))
                                (lwo-empty-field)
                                (lwo-field-add (lwo-empty-field)
                                    (lwph-enquiry-unknown enquiry)))
                            (lwlc-unknown profiles)))
                    (let witnesses
                        (lwoe-field-witnesses world enquiry carriers
                            examples codecs))
                    (lwoe-field enquiry codecs examples profiles compatible
                        contradicted unresolved classes status alternatives
                        unknowns witnesses threshold))))))

(defn lwoe-origin (enquiry codecs threshold)
    (intern_node LWOE-ORIGIN
        (list enquiry codecs (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwoe-origin-enquiry (origin) (nth (node_children origin) 0))
(defn lwoe-origin-codecs (origin) (nth (node_children origin) 1))
(defn lwoe-origin-threshold (origin)
    (node_value (nth (node_children origin) 2)))
(defn lwoe-proposal (world enquiry codecs threshold)
    (do
        (let field (lwoe-field-for world enquiry codecs threshold))
        (if (or (node_eq field (lwo-none))
                (eq (lwo-field-size
                        (lwoe-field-profiles field)) 0)) (lwo-none)
            (do
                (let witnesses (lwoe-field-witness-field field))
                (let origin (lwoe-origin enquiry codecs threshold))
                (let candidate
                    (lwo-emergent field witnesses
                        (intern_trivial_int
                            (lwo-field-size
                                (lwoe-field-classes field)))
                        (intern_trivial_int
                            (lwo-field-size
                                (lwoe-field-compatible field)))
                        (intern_trivial_int
                            (lwo-field-size
                                (lwoe-field-profiles field)))
                        origin))
                (lwt-proposal candidate
                    (lwt-sources-from-attributions
                        (lwo-field-items witnesses) (lwo-empty-field))
                    origin)))))
(defn lwoe-candidate? (candidate)
    (if (and (eq (lwo-category? candidate LWO-EMERGENT) 1)
             (eq (lwoe-field?
                    (lwo-emergent-shape candidate)) 1)) 1 0))
(defn lwoe-candidate-current? (world candidate)
    (if (eq (lwoe-candidate? candidate) 0) 0
        (do
            (let origin (lwo-emergent-provenance candidate))
            (let fresh
                (lwoe-proposal world
                    (lwoe-origin-enquiry origin)
                    (lwoe-origin-codecs origin)
                    (lwoe-origin-threshold origin)))
            (if (node_eq fresh (lwo-none)) 0
                (node_eq candidate (lwt-proposal-candidate fresh))))))
(defn lwoe-integrated-current? (world candidate)
    (if (and (eq (lwo-active? world candidate) 1)
             (eq (lwoe-candidate-current? world candidate) 1)) 1 0))
(defn lwoe-integrate (round proposal action)
    (if (eq (lwoe-candidate-current?
                (lwt-round-world round)
                (lwt-proposal-candidate proposal)) 0)
        (lwt-round (lwt-round-world round)
            (lwt-round-proposals round) (lwo-empty-field) round)
        (lwt-integrate round proposal action)))

; --- held-out questions observe every compatible profile ------------

; children: integrated field, opaque-role values, alternatives, optional
;           unknown, choice, timeout, evidence, local path
(defn lwoe-query
    (candidate values alternatives unknown choice timeout evidence)
    (intern_node LWOE-QUERY
        (list candidate values alternatives unknown choice timeout evidence
              (lwo-local-path))))
(defn lwoe-query? (cell) (lwo-category? cell LWOE-QUERY))
(defn lwoe-query-candidate (query) (nth (node_children query) 0))
(defn lwoe-query-values (query) (nth (node_children query) 1))
(defn lwoe-query-alternatives (query) (nth (node_children query) 2))
(defn lwoe-query-unknown (query) (nth (node_children query) 3))
(defn lwoe-query-choice (query) (nth (node_children query) 4))
(defn lwoe-query-timeout (query) (nth (node_children query) 5))
(defn lwoe-query-evidence (query) (nth (node_children query) 6))
(defn lwoe-query-path (query) (nth (node_children query) 7))
(defn lwoe-query-valid? (query)
    (if (eq (lwoe-query? query) 0) 0
        (if (eq (lwoe-candidate?
                    (lwoe-query-candidate query)) 0) 0
            (if (eq (lwo-category?
                        (lwoe-query-values query) LWO-FIELD) 0) 0
                (if (eq (lwoe-values-valid-items?
                            (lwo-field-items
                                (lwoe-query-values query))) 0) 0
                    (if (eq (lwo-category?
                                (lwoe-query-alternatives query)
                                LWO-FIELD) 0) 0
                        (if (eq (lwph-optional-unknown-valid?
                                    (lwoe-query-unknown query)) 0) 0
                            (if (eq (lwlc-choice-valid?
                                        (lwoe-query-choice query)) 0) 0
                                (lwac-optional-timeout-valid?
                                    (lwoe-query-timeout query)))))))))
(defn lwoe-query-profiles-complete? (items codecs values)
    (if (eq (len items) 0) 1
        (do
            (let carrier
                (lwoe-profile-carrier (head items)))
            (if (eq (lwsr-application-complete-items?
                        (lwsr-role-items
                            (lwoe-carrier-roles carrier))
                        (list) codecs values) 1)
                (lwoe-query-profiles-complete?
                    (tail items) codecs values) 0))))
(defn lwoe-query-current? (world query threshold)
    (if (or (le threshold 0)
            (eq (lwoe-query-valid? query) 0)) 0
        (do
            (let candidate (lwoe-query-candidate query))
            (let field (lwo-emergent-shape candidate))
            (let profiles (lwoe-field-compatible field))
            (if (or (eq (lwoe-integrated-current?
                            world candidate) 0)
                    (or (eq (lwo-active? world query) 0)
                        (or (lt (lwph-active-source-count
                                  world query) threshold)
                            (or (eq (lwoe-values-current-items? world
                                      (lwo-field-items
                                        (lwoe-query-values query))) 0)
                                (eq (lwoe-query-profiles-complete?
                                      (lwo-field-items profiles)
                                      (lwoe-field-codecs field)
                                      (lwoe-query-values query)) 0))))) 0 1))))

; children: exact profile, generated Recipe/bindings, output, local path
(defn lwoe-query-eval (profile recipe bindings output)
    (intern_node LWOE-QUERY-EVAL
        (list profile recipe bindings output (lwo-local-path))))
(defn lwoe-query-eval? (cell) (lwo-category? cell LWOE-QUERY-EVAL))
(defn lwoe-query-eval-profile (evaluation)
    (nth (node_children evaluation) 0))
(defn lwoe-query-eval-recipe (evaluation)
    (nth (node_children evaluation) 1))
(defn lwoe-query-eval-bindings (evaluation)
    (nth (node_children evaluation) 2))
(defn lwoe-query-eval-output (evaluation)
    (nth (node_children evaluation) 3))
(defn lwoe-query-evaluate-items (items codecs values field)
    (if (eq (len items) 0) field
        (do
            (let profile (head items))
            (let carrier (lwoe-profile-carrier profile))
            (let recipe (lwoe-recipe-for carrier codecs))
            (let bindings (lwoe-bindings-for carrier codecs values))
            (let output
                (intern_trivial_int
                    (lwre-evaluate-bound recipe bindings)))
            (lwoe-query-evaluate-items (tail items) codecs values
                (lwo-field-add field
                    (lwoe-query-eval profile recipe bindings output))))))
(defn lwoe-query-outputs-items (items field)
    (if (eq (len items) 0) field
        (lwoe-query-outputs-items (tail items)
            (lwo-field-add field
                (lwoe-query-eval-output (head items))))))
(defn lwoe-answer-immediate (outputs)
    (if (eq (lwo-field-size outputs) 0) (oac-nothing)
        (if (eq (lwo-field-size outputs) 1)
            (oac-one (head (lwo-field-items outputs)))
            (oac-node outputs))))
(defn lwoe-answer-time (query observed-time)
    (if (or (node_eq
              (lwoe-query-timeout query) (lwo-none))
            (node_eq observed-time (lwo-none))) (lwo-none)
        (oac-timeout-condense
            (lwoe-query-timeout query) observed-time)))
(defn lwoe-answer-witnesses (world query)
    (do
        (let candidate (lwoe-query-candidate query))
        (let field (lwo-emergent-shape candidate))
        (let with-field
            (lwoe-field-union-items
                (lwo-field-items
                    (lwo-active-attributions-for world candidate))
                (lwo-emergent-witnesses candidate)))
        (let with-query (lwoe-attributions world query with-field))
        (lwsr-codec-value-witnesses world
            (lwo-field-items (lwoe-query-values query)) with-query)))

; children: exact query, all compatible evaluations, unique outputs,
;           immediate ack, separate time observation, alternatives,
;           unknowns, witnesses, observed time, threshold, local path
(defn lwoe-answer
    (query evaluations outputs immediate time alternatives unknowns witnesses
     observed-time threshold)
    (intern_node LWOE-ANSWER
        (list query evaluations outputs immediate time alternatives unknowns
              witnesses observed-time (intern_trivial_int threshold)
              (lwo-local-path))))
(defn lwoe-answer? (cell) (lwo-category? cell LWOE-ANSWER))
(defn lwoe-answer-query (answer) (nth (node_children answer) 0))
(defn lwoe-answer-evaluations (answer) (nth (node_children answer) 1))
(defn lwoe-answer-outputs (answer) (nth (node_children answer) 2))
(defn lwoe-answer-immediate-ack (answer) (nth (node_children answer) 3))
(defn lwoe-answer-time-observation (answer) (nth (node_children answer) 4))
(defn lwoe-answer-alternatives (answer) (nth (node_children answer) 5))
(defn lwoe-answer-unknowns (answer) (nth (node_children answer) 6))
(defn lwoe-answer-witnesses-field (answer) (nth (node_children answer) 7))
(defn lwoe-answer-observed-time (answer) (nth (node_children answer) 8))
(defn lwoe-answer-threshold (answer)
    (node_value (nth (node_children answer) 9)))
(defn lwoe-answer-path (answer) (nth (node_children answer) 10))
(defn lwoe-answer-for (world query threshold observed-time)
    (if (eq (lwoe-query-current?
                world query threshold) 0) (lwo-none)
        (do
            (let candidate (lwoe-query-candidate query))
            (let field (lwo-emergent-shape candidate))
            (let evaluations
                (lwoe-query-evaluate-items
                    (lwo-field-items
                        (lwoe-field-compatible field))
                    (lwoe-field-codecs field)
                    (lwoe-query-values query) (lwo-empty-field)))
            (let outputs
                (lwoe-query-outputs-items
                    (lwo-field-items evaluations) (lwo-empty-field)))
            (let alternatives
                (lwoe-field-union-items
                    (lwo-field-items
                        (lwoe-field-alternatives field))
                    (lwoe-query-alternatives query)))
            (let unknowns
                (lwo-field-add
                    (lwoe-field-union-items
                        (lwo-field-items
                            (lwoe-field-unknowns field))
                        (if (node_eq
                              (lwoe-query-unknown query) (lwo-none))
                            (lwo-empty-field)
                            (lwo-field-add (lwo-empty-field)
                                (lwoe-query-unknown query))))
                    (lwlc-unknown outputs)))
            (lwoe-answer query evaluations outputs
                (lwoe-answer-immediate outputs)
                (lwoe-answer-time query observed-time)
                alternatives unknowns
                (lwoe-answer-witnesses world query)
                observed-time threshold))))
(defn lwoe-answer-current? (world answer)
    (if (eq (lwoe-answer? answer) 0) 0
        (node_eq answer
            (lwoe-answer-for world
                (lwoe-answer-query answer)
                (lwoe-answer-threshold answer)
                (lwoe-answer-observed-time answer)))))

0
