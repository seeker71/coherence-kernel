// bml-route-choice-runtime.fk - BML choiceReceipt metadata drives route choice.
//
// preludes: form-stdlib/core.fk form-stdlib/choice-receipt.fk form-stdlib/bml-source.fk form-stdlib/branch-choice-order.fk form-stdlib/kernel-http.fk
//
// This is the executable bridge between first-class BML choice metadata and
// the existing kernel HTTP route surface. It does not replace kernel-http; it
// lets BML choose when a trusted fast route can run and when a slower oracle
// branch should be selected instead.
section [form.bml] {
    def brcr-empty?(value) = (Comparable) len(value) == 0;
    def brcr-candidate-route-name(candidate) = brcr-empty?(candidate) ? "none" : kh-route-name(kh-route-candidate-route(candidate));
    def brcr-first-choice-path-by-category(candidates, category, fallback) = (Comparable) len(candidates) == 0 ? fallback : bml-source-choice-candidate-eligible?(head(candidates)) && (String) bml-source-choice-candidate-category(head(candidates)) == category ? bml-source-choice-candidate-path(head(candidates)) : brcr-first-choice-path-by-category(tail(candidates), category, fallback);
    def brcr-escalation-path(row, fallback) = brcr-first-choice-path-by-category(bml-source-choice-row-candidates(row), "oracle", brcr-first-choice-path-by-category(bml-source-choice-row-candidates(row), "http", fallback));
    def brcr-declared-source-path(row) = bml-source-choice-row-selected-path(row);
    def brcr-selected-source-path(row, threshold) = {
        let declared = brcr-declared-source-path(row);
        bml-source-choice-row-trust-matrix-ready?(row, threshold) ? declared : brcr-escalation-path(row, declared);
    };
    def brcr-protocol-compat-score(protocol, capability) = bml-source-protocol-accepts-capability?(protocol, capability) ? bml-source-capability-row-trust-floor(capability) : 0;
    def brcr-protocol-compat-outcome(protocol, capability) = bml-source-protocol-accepts-capability?(protocol, capability) ? cr-outcome-success() : cr-outcome-fail();
    def brcr-protocol-compat-why(protocol, capability) = bml-source-protocol-accepts-capability?(protocol, capability) ? "protocol-capability-compatible" : "protocol-capability-needs-comparison";
    def brcr-protocol-choice-candidates(native-path, fallback-path, native-pressure, native-score, fallback-pressure, fallback-score) = [bml-source-choice-candidate(native-path, "native", true, native-pressure, native-score, "protocol-capability-native"), bml-source-choice-candidate(fallback-path, "oracle", true, fallback-pressure, fallback-score, "protocol-capability-comparison")];
    def brcr-protocol-choice-row(protocol, capability, native-path, fallback-path, who, where, when-tick) = {
        let compat-score = brcr-protocol-compat-score(protocol, capability);
        let source-cost = bml-source-protocol-row-cost(protocol);
        bml-source-choice-receipt-row(bml-source-protocol-row-name(protocol), bml-source-protocol-row-surface(protocol), "protocol-choice", brcr-protocol-choice-candidates(native-path, fallback-path, source-cost, compat-score, 90, 96), native-path, brcr-protocol-compat-outcome(protocol, capability), compat-score, cr-kind-branch-feedback(), compat-score, compat-score, compat-score, compat-score, brcr-protocol-compat-why(protocol, capability), who, where, when-tick, source-cost, cr-choice-trace(2, bml-source-protocol-accepts-capability?(protocol, capability) ? 1 : 0, 0, bml-source-protocol-accepts-capability?(protocol, capability) ? 0 : 1));
    };
    def brcr-realize-protocol-capability(protocol, capability, native-path, fallback-path, routes, request, threshold, who, where, when-tick) = brcr-realize(brcr-protocol-choice-row(protocol, capability, native-path, fallback-path, who, where, when-tick), routes, request, threshold);
    def brcr-find-route-candidate-by-name(candidates, route-name) = (Comparable) len(candidates) == 0 ? empty() : (String) kh-route-name(kh-route-candidate-route(head(candidates))) == route-name ? head(candidates) : brcr-find-route-candidate-by-name(tail(candidates), route-name);
    def brcr-eligible-candidate-or(candidate, fallback) = brcr-empty?(candidate) ? fallback : kh-route-candidate-eligible?(candidate) ? candidate : fallback;
    def brcr-realization(row, threshold, selected-source-path, declared-path, escalation-needed, kernel-choice, selected-candidate, source-candidate-count) = ["bml-route-choice-runtime", row, threshold, selected-source-path, declared-path, escalation-needed, kernel-choice, selected-candidate, source-candidate-count];
    def brcr-realization?(value) = (Comparable) len(value) == 9 ? (String) value[0] == "bml-route-choice-runtime" : false;
    def brcr-realization-row(realization) = realization[1];
    def brcr-realization-threshold(realization) = realization[2];
    def brcr-realization-selected-source-path(realization) = realization[3];
    def brcr-realization-declared-path(realization) = realization[4];
    def brcr-realization-escalation-needed?(realization) = realization[5];
    def brcr-realization-kernel-choice(realization) = realization[6];
    def brcr-realization-selected-candidate(realization) = realization[7];
    def brcr-realization-source-candidate-count(realization) = realization[8];
    def brcr-realization-selected-route-name(realization) = brcr-candidate-route-name(brcr-realization-selected-candidate(realization));
    def brcr-realization-kernel-selected-route-name(realization) = brcr-candidate-route-name(kh-route-choice-selected(brcr-realization-kernel-choice(realization)));
    def brcr-realization-overrode-kernel?(realization) = !((String) brcr-realization-selected-route-name(realization) == brcr-realization-kernel-selected-route-name(realization));
    def brcr-realize(row, routes, request, threshold) = {
        let kernel-choice = kh-route-choice-for-request(routes, request);
        let selected-path = brcr-selected-source-path(row, threshold);
        let requested = brcr-find-route-candidate-by-name(kh-route-choice-candidates(kernel-choice), selected-path);
        let selected = brcr-eligible-candidate-or(requested, kh-route-choice-selected(kernel-choice));
        brcr-realization(row, threshold, selected-path, brcr-declared-source-path(row), bml-source-choice-row-escalation-needed?(row, threshold), kernel-choice, selected, len(bml-source-choice-row-candidates(row)));
    };
    def brcr-selected-pressure-bucket(realization) = brcr-empty?(brcr-realization-selected-candidate(realization)) ? 5 : kh-pressure-bucket(kh-route-candidate-pressure(brcr-realization-selected-candidate(realization)));
    def brcr-selected-score-bucket(realization) = brcr-empty?(brcr-realization-selected-candidate(realization)) ? 0 : kh-score-bucket(kh-route-candidate-score(brcr-realization-selected-candidate(realization)));
    def brcr-realization-signature(realization) = ["bml-route-choice-runtime-signature", bml-source-choice-row-category(brcr-realization-row(realization)), brcr-realization-selected-source-path(realization), brcr-realization-selected-route-name(realization), brcr-realization-declared-path(realization), brcr-realization-escalation-needed?(realization), brcr-selected-pressure-bucket(realization), brcr-selected-score-bucket(realization), brcr-realization-source-candidate-count(realization)];
    def brcr-realization-signature?(signature) = (Comparable) len(signature) == 9 ? (String) signature[0] == "bml-route-choice-runtime-signature" : false;
    def brcr-protocol-realization-signature(protocol, capability, realization) = ["bml-protocol-route-choice-signature", bml-source-protocol-row-name(protocol), bml-source-capability-row-name(capability), bml-source-protocol-accepts-capability?(protocol, capability), brcr-realization-selected-route-name(realization), brcr-realization-escalation-needed?(realization), brcr-realization-source-candidate-count(realization)];
    def brcr-protocol-realization-signature?(signature) = (Comparable) len(signature) == 7 ? (String) signature[0] == "bml-protocol-route-choice-signature" : false;
    def brcr-realization-valid?(realization) = brcr-realization?(realization) ? bml-source-choice-receipt-row?(brcr-realization-row(realization)) && (kh-route-choice-valid?(brcr-realization-kernel-choice(realization)) && ((Comparable) brcr-realization-source-candidate-count(realization) == len(bml-source-choice-row-candidates(brcr-realization-row(realization))) && ((brcr-empty?(brcr-realization-selected-candidate(realization)) ? false : kh-route-candidate-valid?(brcr-realization-selected-candidate(realization))) && (String) brcr-realization-selected-route-name(realization) == brcr-realization-selected-source-path(realization)))) : false;
    0;
}
