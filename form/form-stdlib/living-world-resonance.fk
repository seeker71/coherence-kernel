; living-world-resonance.fk -- non-identical shapes can teach a local lens.
;
; This is the third movement of the axiom-born living world organ.  It adds no
; language, domain, predicate, task class, or answer vocabulary.  A source may
; offer a generic correspondence between two cells.  The organ observes only
; their present composition: target children identical to exactly one source
; child become positional slots; target children absent from the source remain
; constants; duplicate matches remain explicit ambiguity rather than being
; guessed away.
;
; Multiple active correspondences with the same structural signature become
; support.  Correspondences in the same source/target category-and-arity domain
; but with another signature remain counterexamples.  The mapping retains both
; fields plus a transparent uncertainty vector: counterexample count, ambiguous
; target count, and unused source count.  No scalar hides those distinctions.
;
; A mapping is only a proposal.  Every active source attribution contributing
; support or a counterexample participates in its offer/ack cycle.  Any dissent
; blocks integration.  An application to an unseen active cell is a second
; proposal: both holders of the integrated mapping and holders of the new input
; must acknowledge before the application gains authority.  Revoking any
; witness before integration makes the proposal unready.  Earlier worlds remain
; reachable because every movement composes a new content-addressed world.
;
; Honest floor: alignment is immediate-child identity, not recursive graph
; analogy, learned morphology, semantic equivalence, autonomous enquiry, or
; native natural-language generation.  Constants are retained, not understood.
;
; preludes: form-stdlib/core.fk form-stdlib/offer-ack-core.fk form-stdlib/living-world-organ.fk form-stdlib/living-world-tending.fk

(let LWR-CORRESPONDENCE    (bp "LWR-CORRESPONDENCE"))
(let LWR-SLOT              (bp "LWR-SLOT"))
(let LWR-CONSTANT          (bp "LWR-CONSTANT"))
(let LWR-AMBIGUOUS         (bp "LWR-AMBIGUOUS"))
(let LWR-TEMPLATE          (bp "LWR-TEMPLATE"))
(let LWR-SIGNATURE         (bp "LWR-SIGNATURE"))

; --- generic offered correspondence --------------------------------------
(defn lwr-correspondence (source-shape target-shape)
    (intern_node LWR-CORRESPONDENCE (list source-shape target-shape)))
(defn lwr-raw-correspondence? (cell)
    (lwo-category? cell LWR-CORRESPONDENCE))

; A correspondence may arrive directly or as the exact shape of a separately
; governed emergent candidate.  Its wrapper remains the evidence identity;
; only these structural accessors unwrap the proposed shape.  Thus an observed
; application outcome can ask to become evidence without receiving authority
; before every dependency holder acknowledges that re-offer.
(defn lwr-correspondence? (cell)
    (if (eq (lwr-raw-correspondence? cell) 1) 1
        (if (and (eq (lwo-category? cell LWO-EMERGENT) 1)
                 (eq (lwr-raw-correspondence?
                        (lwo-emergent-shape cell)) 1)) 1 0)))
(defn lwr-correspondence-active? (world cell)
    (if (eq (lwr-raw-correspondence? cell) 1)
        (lwo-active? world cell)
        (if (eq (lwr-correspondence? cell) 0) 0
            (if (and (eq (lwo-active? world cell) 1)
                     (eq (lwo-emergent-ready? world cell) 1)) 1 0))))
(defn lwr-correspondence-shape (correspondence)
    (if (eq (lwr-raw-correspondence? correspondence) 1)
        correspondence
        (if (eq (lwr-correspondence? correspondence) 1)
            (lwo-emergent-shape correspondence) (lwo-none))))
(defn lwr-correspondence-source (correspondence)
    (nth (node_children (lwr-correspondence-shape correspondence)) 0))
(defn lwr-correspondence-target (correspondence)
    (nth (node_children (lwr-correspondence-shape correspondence)) 1))

; --- derive an ordered structural template -------------------------------
(defn lwr-indexes-for-items (items wanted index acc)
    (if (eq (len items) 0) acc
        (lwr-indexes-for-items (tail items) wanted (add index 1)
            (if (node_eq (head items) wanted)
                (lwo-field-add acc (intern_trivial_int index))
                acc))))

(defn lwr-indexes-for (items wanted)
    (lwr-indexes-for-items items wanted 0 (lwo-empty-field)))

(defn lwr-slot (index-cell) (intern_node LWR-SLOT (list index-cell)))
(defn lwr-constant (value) (intern_node LWR-CONSTANT (list value)))
(defn lwr-ambiguous (value indexes)
    (intern_node LWR-AMBIGUOUS (list value indexes)))

(defn lwr-slot? (term) (lwo-category? term LWR-SLOT))
(defn lwr-constant? (term) (lwo-category? term LWR-CONSTANT))
(defn lwr-ambiguous? (term) (lwo-category? term LWR-AMBIGUOUS))
(defn lwr-slot-index (term) (node_value (nth (node_children term) 0)))
(defn lwr-constant-value (term) (nth (node_children term) 0))

(defn lwr-term-for (source-items target-child)
    (do
        (let indexes (lwr-indexes-for source-items target-child))
        (let count (lwo-field-size indexes))
        (if (eq count 0) (lwr-constant target-child)
            (if (eq count 1)
                (lwr-slot (head (lwo-field-items indexes)))
                (lwr-ambiguous target-child indexes)))))

(defn lwr-template-terms (source-items target-items)
    (if (eq (len target-items) 0) (empty)
        (cons (lwr-term-for source-items (head target-items))
              (lwr-template-terms source-items (tail target-items)))))

(defn lwr-template (terms) (intern_node LWR-TEMPLATE terms))
(defn lwr-template-items (template) (node_children template))

(defn lwr-slot-count-items (items)
    (if (eq (len items) 0) 0
        (add (if (eq (lwr-slot? (head items)) 1) 1 0)
             (lwr-slot-count-items (tail items)))))

(defn lwr-ambiguous-count-items (items)
    (if (eq (len items) 0) 0
        (add (if (eq (lwr-ambiguous? (head items)) 1) 1 0)
             (lwr-ambiguous-count-items (tail items)))))

(defn lwr-template-slot-count (template)
    (lwr-slot-count-items (lwr-template-items template)))
(defn lwr-template-ambiguous-count (template)
    (lwr-ambiguous-count-items (lwr-template-items template)))

(defn lwr-source-index-used? (terms index)
    (if (eq (len terms) 0) 0
        (if (and (eq (lwr-slot? (head terms)) 1)
                 (eq (lwr-slot-index (head terms)) index)) 1
            (lwr-source-index-used? (tail terms) index))))

(defn lwr-unused-source-count-go (terms index arity)
    (if (ge index arity) 0
        (add (if (eq (lwr-source-index-used? terms index) 1) 0 1)
             (lwr-unused-source-count-go terms (add index 1) arity))))

(defn lwr-unused-source-count (template source-arity)
    (lwr-unused-source-count-go
        (lwr-template-items template) 0 source-arity))

; children: source-category, target-category, source-arity, target-arity,
;           ordered target template
(defn lwr-signature (source-category target-category source-arity target-arity template)
    (intern_node LWR-SIGNATURE
        (list source-category target-category
              (intern_trivial_int source-arity)
              (intern_trivial_int target-arity)
              template)))
(defn lwr-signature-source-category (signature) (nth (node_children signature) 0))
(defn lwr-signature-target-category (signature) (nth (node_children signature) 1))
(defn lwr-signature-source-arity (signature)
    (node_value (nth (node_children signature) 2)))
(defn lwr-signature-target-arity (signature)
    (node_value (nth (node_children signature) 3)))
(defn lwr-signature-template (signature) (nth (node_children signature) 4))

(defn lwr-signature-for (correspondence)
    (do
        (let source-shape (lwr-correspondence-source correspondence))
        (let target-shape (lwr-correspondence-target correspondence))
        (let source-items (node_children source-shape))
        (let target-items (node_children target-shape))
        (lwr-signature (node_category source-shape)
                       (node_category target-shape)
                       (len source-items) (len target-items)
                       (lwr-template
                           (lwr-template-terms source-items target-items)))))

(defn lwr-signature-domain-eq? (a b)
    (if (and (node_eq (lwr-signature-source-category a)
                      (lwr-signature-source-category b))
             (and (node_eq (lwr-signature-target-category a)
                           (lwr-signature-target-category b))
                  (and (eq (lwr-signature-source-arity a)
                           (lwr-signature-source-arity b))
                       (eq (lwr-signature-target-arity a)
                           (lwr-signature-target-arity b))))) 1 0))

(defn lwr-signature-valid? (signature)
    (do
        (let template (lwr-signature-template signature))
        (if (and (gt (lwr-template-slot-count template) 0)
                 (eq (lwr-template-ambiguous-count template) 0)) 1 0)))
