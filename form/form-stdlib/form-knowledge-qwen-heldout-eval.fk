// form-knowledge-qwen-heldout-eval.fk -- sealed cross-family local-Qwen audit.
//
// One independently authored question is held out for each live knowledge-census
// family. Expected facts come from current repository sources, never from model
// output. Literal source and answer-key SHA-256 values make drift observable.
//
// This cell owns dataset identity, leakage accounting, native-model-evidence
// scoring, family gates, and the >=95% rule. It never runs a model. A live
// run stays explicitly consent-gated because admitting the 29GB resident model
// is expensive.
//
// These fifteen rows were re-pinned on 2026-10-03 after their facts were read against their
// sources: h01 h03-h07 h10 h12-h15 took a new source sha and keep their question and answer, and
// h11 pinned a source that no longer stood and was replaced by a row read from one that does.
// Only h02, h08 and h09 stand as authored. The pins and the dataset seal are literals typed in
// this file; there is no sealing door, and the v3 band recomputes and checks them.
//
// Exact and normalized overlap are executable. The manual semantic-disjoint
// mark means only that Codex reviewed the currently executed fqt overlay/pairs
// on 2026-08-24; it is not an automatic paraphrase detector or independence
// from future teaching changes.
//
import form-stdlib/core.fk;
import form-stdlib/sha256.fk;
import form-stdlib/native-model-evidence.fk;
import form-stdlib/form-cli-qwen-teach-layer.fk;
import form-stdlib/form-knowledge-query-token.fk;
// Proven by: form-stdlib/tests/form-knowledge-qwen-heldout-v3-eval-band.fk (its
// leakage audit reads these fifteen rows against the teaching layer)
section [form.bml] {
    def fkhe-threshold-ppm() = 950000;
    def fkhe-live-scope() = "live-local-qwen-heldout-v1";
    def fkhe-fixture-scope() = "evaluation-fixture";
    def fkhe-split() = "heldout-local-qwen-v1";
    def fkhe-manual-audit() = "manual-semantic-disjoint-codex-2026-09-28";
    // row = tag id family concept source source-sha prompt expected answer-sha
    //       split manual-audit
    def fkhe-row(id, family, concept, source, source-sha, prompt, expected, answer-sha) = ["form-knowledge-qwen-heldout-row-v1", id, family, concept, source, source-sha, prompt, expected, answer-sha, fkhe-split(), fkhe-manual-audit()];
    def fkhe-row?(r) = (Comparable) len(r) == 11 && (String) r[0] == "form-knowledge-qwen-heldout-row-v1" ? 1 : 0;
    def fkhe-id(r) = r[1];
    def fkhe-family(r) = r[2];
    def fkhe-concept(r) = r[3];
    def fkhe-source(r) = r[4];
    def fkhe-source-sha(r) = r[5];
    def fkhe-prompt(r) = r[6];
    def fkhe-expected(r) = r[7];
    def fkhe-answer-sha(r) = r[8];
    def fkhe-row-split(r) = r[9];
    def fkhe-row-audit(r) = r[10];
    def fkhe-families() = ["axioms", "bootstrap", "form-stdlib", "grammars", "cognition", "learn", "observe", "teachings", "receipts", "model", "proof", "control", "ingest", "presence", "docs"];
    // Literal hashes are filled from Form's own nmfe-sha256 and then held still.
    def fkhe-rows() = [fkhe-row("h01", "axioms", "core-axiom-resting-count", "axioms/core-axioms.form", "75cc7c52ebd5037627b67176d94218a3326c9d02eafa7954d7163f6c0cfff95c", "How many axioms are held as the resting point in core-axioms.form? Reply with only the English number.", "five", "222b0bd51fcef7e65c2e62db2ed65457013bab56be6fafeb19ee11d453153c80"), fkhe-row("h02", "bootstrap", "recursive-ground-result", "bootstrap/ground-recursive.fk", "3c7d857abe9613a2c98842a628b6cb38e76e7e9d12a7f32b73fa0b72b15f13ec", "What integer does bootstrap/ground-recursive.fk return for fib(10)? Reply with only the integer.", "55", "02d20bbd7e394ad5999a4cebabac9619732c343a4cac99470c03e23ba2bdc2bc"), fkhe-row("h03", "form-stdlib", "evidence-ascii-normalization", "form/form-stdlib/native-model-evidence.fk", "29d582650cbd3aad9e32c5464cc3b5b32ec7f05c63be09de0ba2425e1cfcfe32", "Which two ASCII transformations does native-model-evidence apply before scoring? Reply with one short phrase.", "ASCII lowercasing and ASCII whitespace collapsing", "88b7bc2e07125db163f1acf50c4415b93ae1ef7dca868cd1a32901d1c2a370ac"), fkhe-row("h04", "grammars", "immutable-grammar-registration", "grammars/grammar-loader.fk", "e04ebf5e1de883ff8150d1d8102fcaccbef7e04f9f29c5e69f53d6e5605cc9f3", "Does gl-register mutate its registry or return a new one, and which entry wins on duplicate names? Reply in one short clause.", "It returns a new registry; the newest entry shadows the older one.", "d015e4ad0a9170ebf038b089a36389def23ca1022092b9f2437f716c54f8b5fb"), fkhe-row("h05", "cognition", "text-frequency-spectrum-formula", "cognition/text-frequency.fk", "96a156bf91a4fd2b76edf53ef86a2a5e9ac367be330e9eaa90340efba2d6a191", "How does text-frequency.fk compute a passage's spectrum? Reply with one short phrase.", "the intensity-weighted mean of word valence", "af8749d28260808ad66bdf73e1c43f8ad964bbd2fc4e9fe77594e3d932ab0938"), fkhe-row("h06", "learn", "complete-perturbation-suite", "learn/perturbation-pair.fk", "6c0c8aa41451e6838c447ab94d0265d49878fa70c57b34a228143e388c4ec686", "Which two probe kinds must a perturbation suite contain to avoid being half blind? Reply with only the two uppercase names joined by and.", "FLIP and HOLD", "5e0a4c8e0d181bf298b035a5bea75917d3bf01833495aa62b4f0dd6c29bcdb7f"), fkhe-row("h07", "observe", "native-rented-tie-policy", "form/form-stdlib/native-vs-rented.fk", "d78193958d60a0ecffd8a2e3a31ca32ae90408617762e33105a2cc55afd995fb", "In native-vs-rented.fk, does an equal quality score count as at least as good? Reply only yes or no.", "yes", "8a798890fe93817163b10b5f7bd2ca4d25d84c52739a645a889c173eee7d9d3d"), fkhe-row("h08", "teachings", "dialogue-success-measure", "teachings/uplifting-dialogue.md", "c8b630d0abae840fcebb1b50ebb35dfe7ca4d2bdef3c1a910209cfdbe75f56c3", "According to uplifting-dialogue.md, what is success measured by instead of extending the conversation? Reply in one short clause.", "the enquiry is lifted", "8f52791110827d5211d5f2565cda9a53706b72a91f44d7e5783df183019ef316"), fkhe-row("h09", "receipts", "unmeasured-share-kind", "receipts/2026-08-23-share-is-computed-apply-is-one.md", "665b4ed435ee04a2a3378a5748f629c5c8ba7856e8f450faa9e8287d3bcabaf7", "When there is no rollout or evidence row, what share kind does the 2026-08-23 receipt say Form computes? Reply with only the kind.", "declared", "f833228cb8681bbf3e38af9de7a212dfc542b3e3ba1312ec8a45bb2b67605dc7"), fkhe-row("h10", "model", "ctc-log-zero-sentinel", "model/ctc-logspace.fk", "735b665eeff9e5bfde18ed7ba2e5927cd4c7720337d5a80792554fd5432f0054", "What numeric literal does clog-z return as the log(0) sentinel in model/ctc-logspace.fk? Reply with only that literal.", "-1.0e18", "9bf64d0d36c8b49752413220b3378bd3e7134d27f64f57c4620f051fa37fa627"), fkhe-row("h11", "proof", "conformance-door-verdict", "gate/canonical-conformance.bml", "dd1fe6be9340b58a31d86fd1fd979ff058c1508318fe5ca88e6fb8f651e656d4", "What integer does ./fkwu gate/canonical-conformance-run.bml answer when every pinned observation passes? Reply with only the integer.", "1", "6b86b273ff34fce19d6b804eff5a3f5747ada4eaa22f1d49c01e52ddb7875b4b"), fkhe-row("h12", "control", "all-silent-census-readability", "control/offer-ack-core.fk", "e8096b81a3bfd2ee293986f078de8614c6f92d4031ba3bb51b9d666e44b326fa", "May an offer-ack census with zero answered offers be read as a verdict? Reply only yes or no.", "no", "9390298f3fb0c5b160498935d79cb139aef28e1c47358b4bbba61862b9c26e59"), fkhe-row("h13", "ingest", "judged-fear-entry-state", "ingest/judged-trust.fk", "c9069482131723c29904707f6959d5edaf8b6aee3ef0d4347c7b0f4b5ff2a4cd", "In ingest/judged-trust.fk, does judged fear become frozen, witnessed, or composted? Reply with only the state.", "witnessed", "a50f85c9fc5f6687c454e278002ab9744bbc5ab0f0bbf4da62ea72ffe6ba8848"), fkhe-row("h14", "presence", "computable-inquiry-plane-count", "presence/inquiry-planes.fk", "823a3f6017e8633e59411a77122edaddd6efac306b4f8f925f249a505da2f19d", "How many of the seven inquiry planes are classified as computable in presence/inquiry-planes.fk? Reply with only the integer.", "3", "4e07408562bedb8b60ce05c1decfe3ad16b72230967de01f640b7e4729b49fce"), fkhe-row("h15", "docs", "framebuffer-stale-response-guard", "docs/live-dynamic-diagnostics.md", "5a88e975057655d3fd09b90ba8754c299f147cb689f2e0f70e66db3a30fbe99a", "What prevents a stale framebuffer response from controlling a new observation? Reply with only the mechanism.", "correlation", "577bf0c4f4ee4f887ec975d9f5356309244babf9fad24797025228a2092d78fd")];
    def fkhe-count-string(x, xs) = (Comparable) len(xs) == 0 ? 0 : ((String) x == xs[0] ? 1 : 0) + fkhe-count-string(x, xs[1:]);
    def fkhe-row-families(rows) = (Comparable) len(rows) == 0 ? [] : cons(fkhe-family(rows[0]), fkhe-row-families(rows[1:]));
    def fkhe-row-ids(rows) = (Comparable) len(rows) == 0 ? [] : cons(fkhe-id(rows[0]), fkhe-row-ids(rows[1:]));
    def fkhe-every-exactly-once?(wanted, present) = (Comparable) len(wanted) == 0 ? 1 : (Comparable) fkhe-count-string(wanted[0], present) == 1 ? fkhe-every-exactly-once?(wanted[1:], present) : 0;
    def fkhe-unique-strings?(xs) = (Comparable) len(xs) == 0 ? 1 : (Comparable) fkhe-count-string(xs[0], xs[1:]) == 0 ? fkhe-unique-strings?(xs[1:]) : 0;
    def fkhe-family-coverage?(rows) = (Comparable) len(rows) == len(fkhe-families()) && (Comparable) fkhe-every-exactly-once?(fkhe-families(), fkhe-row-families(rows)) == 1 ? 1 : 0;
    def fkhe-row-current?(r) = (Comparable) fkhe-row?(r) == 0 ? 0 : file_size(fkhe-source(r)) > 0 && ((Comparable) nmfe-sha256?(fkhe-source-sha(r)) == 1 && ((String) nmfe-sha256(read_file(fkhe-source(r))) == fkhe-source-sha(r) && ((Comparable) nmfe-sha256?(fkhe-answer-sha(r)) == 1 && ((String) nmfe-sha256(fkhe-expected(r)) == fkhe-answer-sha(r) && ((String) fkhe-row-split(r) == fkhe-split() && (String) fkhe-row-audit(r) == fkhe-manual-audit()))))) ? 1 : 0;
    def fkhe-all-rows-current?(rows) = (Comparable) len(rows) == 0 ? 1 : (Comparable) fkhe-row-current?(rows[0]) == 1 ? fkhe-all-rows-current?(rows[1:]) : 0;
    // Dataset identity binds family, concept, current source hash, prompt,
    // expected text, and answer key. Formatting outside these fields is free.
    def fkhe-row-message(r) = nmfe-fields(["form-knowledge-qwen-heldout-row-v1", fkhe-id(r), fkhe-family(r), fkhe-concept(r), fkhe-source(r), fkhe-source-sha(r), fkhe-prompt(r), fkhe-expected(r), fkhe-answer-sha(r), fkhe-row-split(r), fkhe-row-audit(r)]);
    def fkhe-dataset-message-loop(rows) = (Comparable) len(rows) == 0 ? "" : ((String) nmfe-field(fkhe-row-message(rows[0])) + fkhe-dataset-message-loop(rows[1:]));
    def fkhe-dataset-sha256(rows) = nmfe-sha256(nmfe-fields(["form-knowledge-qwen-heldout-dataset-v1", fkhe-dataset-message-loop(rows)]));
    def fkhe-dataset-seal() = "c5dc0964978c8cb5e3440da7fe39fd17df5ea080a81d3958dca28ae3418ca477";
    def fkhe-pairs(rows) = (Comparable) len(rows) == 0 ? [] : cons([fkhe-prompt(rows[0]), fkhe-expected(rows[0])], fkhe-pairs(rows[1:]));
    def fkhe-normalized-pairs(rows) = (Comparable) len(rows) == 0 ? [] : cons([nmfe-normalize(rows[0][0]), nmfe-normalize(rows[0][1])], fkhe-normalized-pairs(rows[1:]));
    def fkhe-teach-control-pairs(rows) = (Comparable) len(rows) == 0 ? [] : cons([fqt-situation(rows[0]), fqt-row-class(rows[0])], fkhe-teach-control-pairs(rows[1:]));
    def fkhe-teach-pairs() = nmfe-append(fqt-pairs(), fkhe-teach-control-pairs(fqt-rows()));
    def fkhe-answer-shas(pairs) = (Comparable) len(pairs) == 0 ? [] : cons(nmfe-sha256(pairs[0][1]), fkhe-answer-shas(pairs[1:]));
    def fkhe-concept-overlap(rows) = (Comparable) len(rows) == 0 ? 0 : fqt-has(fkhe-concept(rows[0])) + fkhe-concept-overlap(rows[1:]);
    def fkhe-source-is-taught?(path, sources) = (Comparable) len(sources) == 0 ? 0 : (String) path == sources[0][1] ? 1 : fkhe-source-is-taught?(path, sources[1:]);
    def fkhe-source-overlap(rows) = (Comparable) len(rows) == 0 ? 0 : fkhe-source-is-taught?(fkhe-source(rows[0]), fqt-semantic-sources()) + fkhe-source-overlap(rows[1:]);
    def fkhe-teach-source-message(rows) = (Comparable) len(rows) == 0 ? "" : ((String) nmfe-field(nmfe-fields(rows[0])) + fkhe-teach-source-message(rows[1:]));
    def fkhe-teach-sha256() = nmfe-sha256(nmfe-fields(["form-qwen-teach-surface-v1", fqt-overlay-prefix(), fqt-knowledge-prefix(), nmfe-dataset-sha256(fkhe-teach-pairs()), fkhe-teach-source-message(fqt-semantic-sources())]));
    // audit = tag exact-pair exact-prompt normalized-pair normalized-prompt
    //         answer concept-family source teach-sha manual-mark
    def fkhe-leakage-audit(rows) = {
        let held = fkhe-pairs(rows);
        let teach = fkhe-teach-pairs();
        ["form-knowledge-qwen-leakage-audit-v1", nmfe-overlap-count(nmfe-pair-sha256s(held), nmfe-pair-sha256s(teach)), nmfe-overlap-count(nmfe-prompt-sha256s(held), nmfe-prompt-sha256s(teach)), nmfe-overlap-count(nmfe-pair-sha256s(fkhe-normalized-pairs(held)), nmfe-pair-sha256s(fkhe-normalized-pairs(teach))), nmfe-overlap-count(nmfe-prompt-sha256s(fkhe-normalized-pairs(held)), nmfe-prompt-sha256s(fkhe-normalized-pairs(teach))), nmfe-overlap-count(fkhe-answer-shas(held), fkhe-answer-shas(teach)), fkhe-concept-overlap(rows), fkhe-source-overlap(rows), fkhe-teach-sha256(), fkhe-manual-audit()];
    };
    def fkhe-leakage-audit-valid?(a) = (Comparable) len(a) == 10 && ((String) a[0] == "form-knowledge-qwen-leakage-audit-v1" && ((Comparable) a[1] == 0 && ((Comparable) a[2] == 0 && ((Comparable) a[3] == 0 && ((Comparable) a[4] == 0 && ((Comparable) a[5] == 0 && ((Comparable) a[6] == 0 && ((Comparable) a[7] == 0 && ((Comparable) nmfe-sha256?(a[8]) == 1 && (String) a[9] == fkhe-manual-audit()))))))))) ? 1 : 0;
    def fkhe-dataset-valid?() = {
        let rows = fkhe-rows();
        (Comparable) len(rows) == 15 && ((Comparable) fkhe-family-coverage?(rows) == 1 && ((Comparable) fkhe-unique-strings?(fkhe-row-ids(rows)) == 1 && ((Comparable) fkhe-all-rows-current?(rows) == 1 && ((Comparable) fkhe-leakage-audit-valid?(fkhe-leakage-audit(rows)) == 1 && (String) fkhe-dataset-sha256(rows) == fkhe-dataset-seal())))) ? 1 : 0;
    };
    // The resident result has choice metadata, backend/report metadata, then the
    // exact `\ntext:\n` marker and decoded model text. Only the text after that
    // marker may be scored. A completed knowledge-query envelope remains in the
    // decoded text by design; when present, scoring begins after its close token.
    // No-query answers remain byte-identical. Raw output survives only as a hash,
    // and a refusal found anywhere in it forces an error before normalization.
    // parsed = tag raw-sha generated-text answer-text error-bit refusal-bit
    def fkhe-output(raw-sha, generated, answer, error, refusal) = ["form-knowledge-qwen-output-v1", raw-sha, generated, answer, error, refusal];
    def fkhe-output-raw-sha(r) = r[1];
    def fkhe-output-generated(r) = r[2];
    def fkhe-output-answer(r) = r[3];
    def fkhe-output-error(r) = r[4];
    def fkhe-output-refusal(r) = r[5];
    def fkhe-refusal?(s) = str_find(s, "generation refused:", 0) >= 0 ? 1 : 0;
    def fkhe-strip-complete-query(generated) = {
        let open-at = str_find(generated, fkqt-open(), 0);
        open-at < 0 ? generated : {
            let close-at = str_find(generated, fkqt-close(), open-at + len(fkqt-open()));
            close-at < 0 ? generated : substring(generated, close-at + len(fkqt-close()), len(generated));
        };
    };
    def fkhe-parse-resident-output(raw) = {
        let raw-sha = nmfe-sha256(raw);
        let refusal = fkhe-refusal?(raw);
        let marker = "\ntext:\n";
        let at = str_find(raw, marker, 0);
        at < 0 ? fkhe-output(raw-sha, "", "", 1, refusal) : {
            let generated = substring(raw, at + len(marker), len(raw));
            let answer = fkhe-strip-complete-query(generated);
            fkhe-output(raw-sha, generated, answer, (Comparable) refusal == 1 || ((Comparable) len(generated) == 0 || (Comparable) len(answer) == 0) ? 1 : 0, refusal);
        };
    };
    def fkhe-find-row(id, rows) = (Comparable) len(rows) == 0 ? [] : (String) id == fkhe-id(rows[0]) ? rows[0] : fkhe-find-row(id, rows[1:]);
    // score = tag id family source-sha raw-prompt-sha answer-sha
    //         effective-prompt-sha raw-output-sha scored-answer-sha refusal
    //         native-model-observation
    def fkhe-score(row, effective-prompt, parsed, latency) = ["form-knowledge-qwen-score-v1", fkhe-id(row), fkhe-family(row), fkhe-source-sha(row), nmfe-sha256(fkhe-prompt(row)), fkhe-answer-sha(row), nmfe-sha256(effective-prompt), fkhe-output-raw-sha(parsed), nmfe-sha256(fkhe-output-answer(parsed)), fkhe-output-refusal(parsed), nmfe-observation(effective-prompt, fkhe-expected(row), fkhe-output-answer(parsed), latency, fkhe-output-error(parsed))];
    def fkhe-score-id(s) = s[1];
    def fkhe-score-family(s) = s[2];
    def fkhe-score-observation(s) = s[10];
    def fkhe-score-valid?(s, rows) = (Comparable) len(s) == 11 && (String) s[0] == "form-knowledge-qwen-score-v1" ? {
        let row = fkhe-find-row(fkhe-score-id(s), rows);
        (Comparable) len(row) == 0 ? 0 : {
            let o = fkhe-score-observation(s);
            (String) fkhe-score-family(s) == fkhe-family(row) && ((String) s[3] == fkhe-source-sha(row) && ((String) s[4] == nmfe-sha256(fkhe-prompt(row)) && ((String) s[5] == fkhe-answer-sha(row) && ((Comparable) nmfe-sha256?(s[7]) == 1 && ((Comparable) nmfe-sha256?(s[8]) == 1 && ((Comparable) nmfe-observation?(o) == 1 && ((String) s[6] == nmfe-sha256(fqt-knowledge-prompt(fkhe-prompt(row))) && ((String) s[6] == o[1] && ((String) fkhe-answer-sha(row) == o[2] && ((String) s[8] == o[3] && ((Comparable) s[9] == 1 ? (Comparable) nmfe-obs-error(o) == 1 : 1))))))))))) ? 1 : 0;
        };
    } : 0;
    def fkhe-all-scores-valid?(scores, rows) = (Comparable) len(scores) == 0 ? 1 : (Comparable) fkhe-score-valid?(scores[0], rows) == 1 ? fkhe-all-scores-valid?(scores[1:], rows) : 0;
    def fkhe-count-score-id(id, scores) = (Comparable) len(scores) == 0 ? 0 : ((String) id == fkhe-score-id(scores[0]) ? 1 : 0) + fkhe-count-score-id(id, scores[1:]);
    def fkhe-every-row-scored-once?(rows, scores) = (Comparable) len(rows) == 0 ? 1 : (Comparable) fkhe-count-score-id(fkhe-id(rows[0]), scores) == 1 ? fkhe-every-row-scored-once?(rows[1:], scores) : 0;
    def fkhe-complete-score-set?(scores, rows) = (Comparable) len(scores) == len(rows) && ((Comparable) fkhe-all-scores-valid?(scores, rows) == 1 && (Comparable) fkhe-every-row-scored-once?(rows, scores) == 1) ? 1 : 0;
    def fkhe-observations(scores) = (Comparable) len(scores) == 0 ? [] : cons(fkhe-score-observation(scores[0]), fkhe-observations(scores[1:]));
    def fkhe-at-least95?(ppm) = ppm >= fkhe-threshold-ppm() ? 1 : 0;
    def fkhe-every-family-at-least95?(scores, families) = (Comparable) len(families) == 0 ? 1 : {
        let id = families[0];
        let score = (Comparable) len(scores) == 0 ? [] : (String) fkhe-score-family(scores[0]) == id ? scores[0] : fkhe-find-family-score(scores[1:], id);
        (Comparable) len(score) == 0 ? 0 : (Comparable) fkhe-at-least95?(nmfe-obs-promotion(fkhe-score-observation(score))) == 1 ? fkhe-every-family-at-least95?(scores, families[1:]) : 0;
    };
    def fkhe-find-family-score(scores, family) = (Comparable) len(scores) == 0 ? [] : (String) fkhe-score-family(scores[0]) == family ? scores[0] : fkhe-find-family-score(scores[1:], family);
    // report = tag scope model-id dataset-sha audit family-count scores aggregate
    //          model-executed release-ok overall95 family95 live-credit
    def fkhe-report(scope, model-id, model-executed, release-ok, scores) = {
        let rows = fkhe-rows();
        let audit = fkhe-leakage-audit(rows);
        let aggregate = nmfe-aggregate(fkhe-observations(scores));
        let complete = fkhe-complete-score-set?(scores, rows);
        let overall95 = (Comparable) complete == 1 ? fkhe-at-least95?(aggregate[4]) : 0;
        let family95 = (Comparable) complete == 1 ? fkhe-every-family-at-least95?(scores, fkhe-families()) : 0;
        let live = (String) scope == fkhe-live-scope() && (len(model-id) > 0 && ((Comparable) model-executed == 1 && ((Comparable) release-ok == 1 && ((Comparable) fkhe-dataset-valid?() == 1 && ((Comparable) fkhe-leakage-audit-valid?(audit) == 1 && ((Comparable) complete == 1 && ((Comparable) aggregate[6] == 0 && ((Comparable) overall95 == 1 && (Comparable) family95 == 1)))))))) ? 1 : 0;
        ["form-knowledge-qwen-heldout-report-v1", scope, model-id, fkhe-dataset-sha256(rows), audit, len(fkhe-families()), scores, aggregate, model-executed, release-ok, overall95, family95, live];
    };
    def fkhe-report-aggregate(r) = r[7];
    def fkhe-report-overall95(r) = r[10];
    def fkhe-report-family95(r) = r[11];
    def fkhe-report-live-credit(r) = r[12];
