; form-knowledge-qwen-heldout-eval.fk -- sealed cross-family local-Qwen audit.
;
; One independently authored question is held out for each live knowledge-census
; family. Expected facts come from current repository sources, never from model
; output. Literal source and answer-key SHA-256 values make drift observable.
;
; This cell owns dataset identity, leakage accounting, native-model-evidence
; scoring, family gates, and the >=95% rule. It never runs a model. The live
; carrier is form-knowledge-qwen-heldout-eval-run.fk and remains explicitly
; consent-gated because admitting the 29GB resident model is expensive.
;
; Exact and normalized overlap are executable. The manual semantic-disjoint
; mark means only that Codex reviewed the currently executed fqt overlay/pairs
; on 2026-08-24; it is not an automatic paraphrase detector or independence
; from future teaching changes.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/sha256.fk
; preludes: form-stdlib/native-model-evidence.fk
; preludes: form-stdlib/form-cli-qwen-teach-layer.fk
; preludes: form-stdlib/form-knowledge-query-token.fk
; Proven by: form-stdlib/tests/form-knowledge-qwen-heldout-eval-band.fk
; witnessed: 2026-08-24 -> band 16383; dataset 15/15 families; local model not run

(do
    (defn fkhe-threshold-ppm () 950000)
    (defn fkhe-live-scope () "live-local-qwen-heldout-v1")
    (defn fkhe-fixture-scope () "evaluation-fixture")
    (defn fkhe-split () "heldout-local-qwen-v1")
    (defn fkhe-manual-audit () "manual-semantic-disjoint-codex-2026-08-24")

    ; row = tag id family concept source source-sha prompt expected answer-sha
    ;       split manual-audit
    (defn fkhe-row (id family concept source source-sha prompt expected answer-sha)
        (list "form-knowledge-qwen-heldout-row-v1" id family concept source
              source-sha prompt expected answer-sha (fkhe-split) (fkhe-manual-audit)))
    (defn fkhe-row? (r)
        (if (and (eq (len r) 11)
                 (str_eq (nth r 0) "form-knowledge-qwen-heldout-row-v1")) 1 0))
    (defn fkhe-id (r) (nth r 1))
    (defn fkhe-family (r) (nth r 2))
    (defn fkhe-concept (r) (nth r 3))
    (defn fkhe-source (r) (nth r 4))
    (defn fkhe-source-sha (r) (nth r 5))
    (defn fkhe-prompt (r) (nth r 6))
    (defn fkhe-expected (r) (nth r 7))
    (defn fkhe-answer-sha (r) (nth r 8))
    (defn fkhe-row-split (r) (nth r 9))
    (defn fkhe-row-audit (r) (nth r 10))

    (defn fkhe-families ()
        (list "axioms" "bootstrap" "form-stdlib" "grammars" "cognition"
              "learn" "observe" "teachings" "receipts" "model" "proof"
              "control" "ingest" "presence" "docs"))

    ; Literal hashes are filled from Form's own nmfe-sha256 and then held still.
    (defn fkhe-rows ()
        (list
            (fkhe-row "h01" "axioms" "core-axiom-resting-count"
                "axioms/core-axioms.form"
                "893d1a85f5a9475705e59f1bac50b9b19076e2fafb55751b52897af3a6d5bcad"
                "How many axioms are held as the resting point in core-axioms.form? Reply with only the English number."
                "five" "222b0bd51fcef7e65c2e62db2ed65457013bab56be6fafeb19ee11d453153c80")
            (fkhe-row "h02" "bootstrap" "recursive-ground-result"
                "bootstrap/ground-recursive.fk"
                "3c7d857abe9613a2c98842a628b6cb38e76e7e9d12a7f32b73fa0b72b15f13ec"
                "What integer does bootstrap/ground-recursive.fk return for fib(10)? Reply with only the integer."
                "55" "02d20bbd7e394ad5999a4cebabac9619732c343a4cac99470c03e23ba2bdc2bc")
            (fkhe-row "h03" "form-stdlib" "evidence-ascii-normalization"
                "form/form-stdlib/native-model-evidence.fk"
                "4bf0c64e473b9a4a5199252d68aec43db273b36d030538aeeaed67ee203566f3"
                "Which two ASCII transformations does native-model-evidence apply before scoring? Reply with one short phrase."
                "ASCII lowercasing and ASCII whitespace collapsing" "88b7bc2e07125db163f1acf50c4415b93ae1ef7dca868cd1a32901d1c2a370ac")
            (fkhe-row "h04" "grammars" "immutable-grammar-registration"
                "grammars/grammar-loader.fk"
                "0e52695af845a61a553d132f93fbd92ff35e5d4aa62af3304d36d3078771e290"
                "Does gl-register mutate its registry or return a new one, and which entry wins on duplicate names? Reply in one short clause."
                "It returns a new registry; the newest entry shadows the older one." "d015e4ad0a9170ebf038b089a36389def23ca1022092b9f2437f716c54f8b5fb")
            (fkhe-row "h05" "cognition" "text-frequency-spectrum-formula"
                "cognition/text-frequency.fk"
                "53458ec158678f5ef35897a5df8b869e4149444055a21aa8db69b88f299b3e51"
                "How does text-frequency.fk compute a passage's spectrum? Reply with one short phrase."
                "the intensity-weighted mean of word valence" "af8749d28260808ad66bdf73e1c43f8ad964bbd2fc4e9fe77594e3d932ab0938")
            (fkhe-row "h06" "learn" "complete-perturbation-suite"
                "learn/perturbation-pair.fk"
                "12f529345b944f4271b84409a4d4c5873deed4b3713eed416739231292c5d75a"
                "Which two probe kinds must a perturbation suite contain to avoid being half blind? Reply with only the two uppercase names joined by and."
                "FLIP and HOLD" "5e0a4c8e0d181bf298b035a5bea75917d3bf01833495aa62b4f0dd6c29bcdb7f")
            (fkhe-row "h07" "observe" "native-rented-tie-policy"
                "form/form-stdlib/native-vs-rented.fk"
                "b4c46eed825ca495717f4ec831555a636875e778a0080ed7956251dcc40bf31c"
                "In native-vs-rented.fk, does an equal quality score count as at least as good? Reply only yes or no."
                "yes" "8a798890fe93817163b10b5f7bd2ca4d25d84c52739a645a889c173eee7d9d3d")
            (fkhe-row "h08" "teachings" "dialogue-success-measure"
                "teachings/uplifting-dialogue.md"
                "fd449f30ac31dce25209f7d36925fa01c157ee6a1a96438b718581038addbfa3"
                "According to uplifting-dialogue.md, what is success measured by instead of extending the conversation? Reply in one short clause."
                "the enquiry is lifted" "8f52791110827d5211d5f2565cda9a53706b72a91f44d7e5783df183019ef316")
            (fkhe-row "h09" "receipts" "unmeasured-share-kind"
                "receipts/2026-08-23-share-is-computed-apply-is-one.md"
                "665b4ed435ee04a2a3378a5748f629c5c8ba7856e8f450faa9e8287d3bcabaf7"
                "When there is no rollout or evidence row, what share kind does the 2026-08-23 receipt say Form computes? Reply with only the kind."
                "declared" "f833228cb8681bbf3e38af9de7a212dfc542b3e3ba1312ec8a45bb2b67605dc7")
            (fkhe-row "h10" "model" "neutral-token-space-cap"
                "model/form-neutral-token-space.fk"
                "a97f329570657d9dec8d2221aae52c475764f76916a38c9a96f736b9ea536ac4"
                "What memory covenant bounds the active working set in form-neutral-token-space.fk? Reply with only the number and unit."
                "16 MiB" "d08b812290df301bfc71aa325ad5bcc27177c2828674a93c4930f2858fd3287e")
            (fkhe-row "h11" "proof" "four-way-agreement-verdict"
                "proof/four-way-run-recipe42.fk"
                "07bac70de7bc6934cf38eb9e5b319614756c5216fc9a81274df274477906e2dc"
                "What integer verdict does four-way-run-recipe42.fk assign when all four walkers agree? Reply with only the integer."
                "0" "5feceb66ffc86f38d952786c6d696c79c2dbc239dd4e91b46729d73a27fb57e9")
            (fkhe-row "h12" "control" "all-silent-census-readability"
                "control/offer-ack-core.fk"
                "179d034df125c4b6a22c72586b99a12537898f161ee377c5867470e7868cf65a"
                "May an offer-ack census with zero answered offers be read as a verdict? Reply only yes or no."
                "no" "9390298f3fb0c5b160498935d79cb139aef28e1c47358b4bbba61862b9c26e59")
            (fkhe-row "h13" "ingest" "named-only-entry-status"
                "ingest/name-build-observe.fk"
                "20d63c2c56f45841f4783adcab19f1890871f5eb8456066aaf3ad88e707bdfeb"
                "What does name-build-observe call a named gap that has not met an attempt? Reply with only its entry status."
                "not-yet" "919e2027179bbe21c3b8cf25e92c66ecc266ce46d3e45f3d7c9c0089e85db347")
            (fkhe-row "h14" "presence" "computable-inquiry-plane-count"
                "presence/inquiry-planes.fk"
                "af21bea4025f2616d024c9a49e1772aced95ddd7baae4b013b21d70ef1c3a5df"
                "How many of the seven inquiry planes are classified as computable in presence/inquiry-planes.fk? Reply with only the integer."
                "3" "4e07408562bedb8b60ce05c1decfe3ad16b72230967de01f640b7e4729b49fce")
            (fkhe-row "h15" "docs" "framebuffer-stale-response-guard"
                "docs/live-dynamic-diagnostics.md"
                "8a8fccc6c1c2c6a606a292e9c1a21e0c734ccf9c81e9b59e55421c90c5f80052"
                "What prevents a stale framebuffer response from controlling a new observation? Reply with only the mechanism."
                "correlation" "577bf0c4f4ee4f887ec975d9f5356309244babf9fad24797025228a2092d78fd")))

    (defn fkhe-count-string (x xs)
        (if (eq (len xs) 0) 0
            (add (if (str_eq x (head xs)) 1 0)
                 (fkhe-count-string x (tail xs)))))
    (defn fkhe-row-families (rows)
        (if (eq (len rows) 0) (list)
            (cons (fkhe-family (head rows)) (fkhe-row-families (tail rows)))))
    (defn fkhe-row-ids (rows)
        (if (eq (len rows) 0) (list)
            (cons (fkhe-id (head rows)) (fkhe-row-ids (tail rows)))))
    (defn fkhe-every-exactly-once? (wanted present)
        (if (eq (len wanted) 0) 1
            (if (eq (fkhe-count-string (head wanted) present) 1)
                (fkhe-every-exactly-once? (tail wanted) present) 0)))
    (defn fkhe-unique-strings? (xs)
        (if (eq (len xs) 0) 1
            (if (eq (fkhe-count-string (head xs) (tail xs)) 0)
                (fkhe-unique-strings? (tail xs)) 0)))
    (defn fkhe-family-coverage? (rows)
        (if (and (eq (len rows) (len (fkhe-families)))
                 (eq (fkhe-every-exactly-once? (fkhe-families)
                         (fkhe-row-families rows)) 1)) 1 0))

    (defn fkhe-row-current? (r)
        (if (eq (fkhe-row? r) 0) 0
            (if (and (gt (file_size (fkhe-source r)) 0)
                     (and (eq (nmfe-sha256? (fkhe-source-sha r)) 1)
                     (and (str_eq (nmfe-sha256 (read_file (fkhe-source r)))
                                  (fkhe-source-sha r))
                     (and (eq (nmfe-sha256? (fkhe-answer-sha r)) 1)
                     (and (str_eq (nmfe-sha256 (fkhe-expected r))
                                  (fkhe-answer-sha r))
                     (and (str_eq (fkhe-row-split r) (fkhe-split))
                          (str_eq (fkhe-row-audit r) (fkhe-manual-audit)))))))) 1 0)))
    (defn fkhe-all-rows-current? (rows)
        (if (eq (len rows) 0) 1
            (if (eq (fkhe-row-current? (head rows)) 1)
                (fkhe-all-rows-current? (tail rows)) 0)))

    ; Dataset identity binds family, concept, current source hash, prompt,
    ; expected text, and answer key. Formatting outside these fields is free.
    (defn fkhe-row-message (r)
        (nmfe-fields
            (list "form-knowledge-qwen-heldout-row-v1" (fkhe-id r)
                  (fkhe-family r) (fkhe-concept r) (fkhe-source r)
                  (fkhe-source-sha r) (fkhe-prompt r) (fkhe-expected r)
                  (fkhe-answer-sha r) (fkhe-row-split r) (fkhe-row-audit r))))
    (defn fkhe-dataset-message-loop (rows)
        (if (eq (len rows) 0) ""
            (str_concat (nmfe-field (fkhe-row-message (head rows)))
                        (fkhe-dataset-message-loop (tail rows)))))
    (defn fkhe-dataset-sha256 (rows)
        (nmfe-sha256
            (nmfe-fields
                (list "form-knowledge-qwen-heldout-dataset-v1"
                      (fkhe-dataset-message-loop rows)))))
    (defn fkhe-dataset-seal () "0c81b691767376c2f1308b3ef5ee6917e8cee872fee35a47dbafc269d512ba7a")

    (defn fkhe-pairs (rows)
        (if (eq (len rows) 0) (list)
            (cons (list (fkhe-prompt (head rows)) (fkhe-expected (head rows)))
                  (fkhe-pairs (tail rows)))))
    (defn fkhe-normalized-pairs (rows)
        (if (eq (len rows) 0) (list)
            (cons (list (nmfe-normalize (nth (head rows) 0))
                        (nmfe-normalize (nth (head rows) 1)))
                  (fkhe-normalized-pairs (tail rows)))))
    (defn fkhe-teach-control-pairs (rows)
        (if (eq (len rows) 0) (list)
            (cons (list (fqt-situation (head rows)) (fqt-row-class (head rows)))
                  (fkhe-teach-control-pairs (tail rows)))))
    (defn fkhe-teach-pairs ()
        (nmfe-append (fqt-pairs) (fkhe-teach-control-pairs (fqt-rows))))
    (defn fkhe-answer-shas (pairs)
        (if (eq (len pairs) 0) (list)
            (cons (nmfe-sha256 (nth (head pairs) 1))
                  (fkhe-answer-shas (tail pairs)))))
    (defn fkhe-concept-overlap (rows)
        (if (eq (len rows) 0) 0
            (add (fqt-has (fkhe-concept (head rows)))
                 (fkhe-concept-overlap (tail rows)))))
    (defn fkhe-source-is-taught? (path sources)
        (if (eq (len sources) 0) 0
            (if (str_eq path (nth (head sources) 1)) 1
                (fkhe-source-is-taught? path (tail sources)))))
    (defn fkhe-source-overlap (rows)
        (if (eq (len rows) 0) 0
            (add (fkhe-source-is-taught? (fkhe-source (head rows))
                                         (fqt-semantic-sources))
                 (fkhe-source-overlap (tail rows)))))

    (defn fkhe-teach-source-message (rows)
        (if (eq (len rows) 0) ""
            (str_concat (nmfe-field (nmfe-fields (head rows)))
                        (fkhe-teach-source-message (tail rows)))))
    (defn fkhe-teach-sha256 ()
        (nmfe-sha256
            (nmfe-fields
                (list "form-qwen-teach-surface-v1"
                      (fqt-overlay-prefix)
                      (fqt-knowledge-prefix)
                      (nmfe-dataset-sha256 (fkhe-teach-pairs))
                      (fkhe-teach-source-message (fqt-semantic-sources))))))

    ; audit = tag exact-pair exact-prompt normalized-pair normalized-prompt
    ;         answer concept-family source teach-sha manual-mark
    (defn fkhe-leakage-audit (rows)
        (do
            (let held (fkhe-pairs rows))
            (let teach (fkhe-teach-pairs))
            (list "form-knowledge-qwen-leakage-audit-v1"
                (nmfe-overlap-count (nmfe-pair-sha256s held)
                                    (nmfe-pair-sha256s teach))
                (nmfe-overlap-count (nmfe-prompt-sha256s held)
                                    (nmfe-prompt-sha256s teach))
                (nmfe-overlap-count
                    (nmfe-pair-sha256s (fkhe-normalized-pairs held))
                    (nmfe-pair-sha256s (fkhe-normalized-pairs teach)))
                (nmfe-overlap-count
                    (nmfe-prompt-sha256s (fkhe-normalized-pairs held))
                    (nmfe-prompt-sha256s (fkhe-normalized-pairs teach)))
                (nmfe-overlap-count (fkhe-answer-shas held)
                                    (fkhe-answer-shas teach))
                (fkhe-concept-overlap rows)
                (fkhe-source-overlap rows)
                (fkhe-teach-sha256)
                (fkhe-manual-audit))))
    (defn fkhe-leakage-audit-valid? (a)
        (if (and (eq (len a) 10)
                 (and (str_eq (nth a 0) "form-knowledge-qwen-leakage-audit-v1")
                 (and (eq (nth a 1) 0)
                 (and (eq (nth a 2) 0)
                 (and (eq (nth a 3) 0)
                 (and (eq (nth a 4) 0)
                 (and (eq (nth a 5) 0)
                 (and (eq (nth a 6) 0)
                 (and (eq (nth a 7) 0)
                 (and (eq (nmfe-sha256? (nth a 8)) 1)
                      (str_eq (nth a 9) (fkhe-manual-audit)))))))))))) 1 0))

    (defn fkhe-dataset-valid? ()
        (do
            (let rows (fkhe-rows))
            (if (and (eq (len rows) 15)
                 (and (eq (fkhe-family-coverage? rows) 1)
                 (and (eq (fkhe-unique-strings? (fkhe-row-ids rows)) 1)
                 (and (eq (fkhe-all-rows-current? rows) 1)
                 (and (eq (fkhe-leakage-audit-valid?
                                (fkhe-leakage-audit rows)) 1)
                      (str_eq (fkhe-dataset-sha256 rows)
                              (fkhe-dataset-seal))))))) 1 0)))

    ; The resident result has choice metadata, backend/report metadata, then the
    ; exact `\ntext:\n` marker and decoded model text. Only the text after that
    ; marker may be scored. A completed knowledge-query envelope remains in the
    ; decoded text by design; when present, scoring begins after its close token.
    ; No-query answers remain byte-identical. Raw output survives only as a hash,
    ; and a refusal found anywhere in it forces an error before normalization.
    ; parsed = tag raw-sha generated-text answer-text error-bit refusal-bit
    (defn fkhe-output (raw-sha generated answer error refusal)
        (list "form-knowledge-qwen-output-v1" raw-sha generated answer error refusal))
    (defn fkhe-output-raw-sha (r) (nth r 1))
    (defn fkhe-output-generated (r) (nth r 2))
    (defn fkhe-output-answer (r) (nth r 3))
    (defn fkhe-output-error (r) (nth r 4))
    (defn fkhe-output-refusal (r) (nth r 5))
    (defn fkhe-refusal? (s)
        (if (ge (str_find s "generation refused:" 0) 0) 1 0))
    (defn fkhe-strip-complete-query (generated)
        (do
            (let open-at (str_find generated (fkqt-open) 0))
            (if (lt open-at 0) generated
                (do
                    (let close-at (str_find generated (fkqt-close)
                        (add open-at (str_len (fkqt-open)))))
                    (if (lt close-at 0) generated
                        (substring generated
                            (add close-at (str_len (fkqt-close)))
                            (str_len generated)))))))
    (defn fkhe-parse-resident-output (raw)
        (do
            (let raw-sha (nmfe-sha256 raw))
            (let refusal (fkhe-refusal? raw))
            (let marker "\ntext:\n")
            (let at (str_find raw marker 0))
            (if (lt at 0) (fkhe-output raw-sha "" "" 1 refusal)
                (do
                    (let generated
                        (substring raw (add at (str_len marker)) (str_len raw)))
                    (let answer (fkhe-strip-complete-query generated))
                    (fkhe-output raw-sha generated answer
                        (if (or (eq refusal 1)
                                (or (eq (str_len generated) 0)
                                    (eq (str_len answer) 0))) 1 0)
                        refusal)))))

    (defn fkhe-find-row (id rows)
        (if (eq (len rows) 0) (list)
            (if (str_eq id (fkhe-id (head rows))) (head rows)
                (fkhe-find-row id (tail rows)))))

    ; score = tag id family source-sha raw-prompt-sha answer-sha
    ;         effective-prompt-sha raw-output-sha scored-answer-sha refusal
    ;         native-model-observation
    (defn fkhe-score (row effective-prompt parsed latency)
        (list "form-knowledge-qwen-score-v1" (fkhe-id row) (fkhe-family row)
              (fkhe-source-sha row) (nmfe-sha256 (fkhe-prompt row))
              (fkhe-answer-sha row) (nmfe-sha256 effective-prompt)
              (fkhe-output-raw-sha parsed)
              (nmfe-sha256 (fkhe-output-answer parsed))
              (fkhe-output-refusal parsed)
              (nmfe-observation effective-prompt (fkhe-expected row)
                                (fkhe-output-answer parsed) latency
                                (fkhe-output-error parsed))))
    (defn fkhe-score-id (s) (nth s 1))
    (defn fkhe-score-family (s) (nth s 2))
    (defn fkhe-score-observation (s) (nth s 10))
    (defn fkhe-score-valid? (s rows)
        (if (and (eq (len s) 11)
                 (str_eq (nth s 0) "form-knowledge-qwen-score-v1"))
            (do
                (let row (fkhe-find-row (fkhe-score-id s) rows))
                (if (eq (len row) 0) 0
                    (do
                        (let o (fkhe-score-observation s))
                        (if (and (str_eq (fkhe-score-family s) (fkhe-family row))
                             (and (str_eq (nth s 3) (fkhe-source-sha row))
                             (and (str_eq (nth s 4) (nmfe-sha256 (fkhe-prompt row)))
                             (and (str_eq (nth s 5) (fkhe-answer-sha row))
                             (and (eq (nmfe-sha256? (nth s 7)) 1)
                             (and (eq (nmfe-sha256? (nth s 8)) 1)
                             (and (eq (nmfe-observation? o) 1)
                             (and (str_eq (nth s 6)
                                          (nmfe-sha256
                                              (fqt-knowledge-prompt (fkhe-prompt row))))
                             (and (str_eq (nth s 6) (nth o 1))
                             (and (str_eq (fkhe-answer-sha row) (nth o 2))
                             (and (str_eq (nth s 8) (nth o 3))
                                  (if (eq (nth s 9) 1)
                                      (eq (nmfe-obs-error o) 1) 1)))))))))))) 1 0))))
            0))
    (defn fkhe-all-scores-valid? (scores rows)
        (if (eq (len scores) 0) 1
            (if (eq (fkhe-score-valid? (head scores) rows) 1)
                (fkhe-all-scores-valid? (tail scores) rows) 0)))
    (defn fkhe-count-score-id (id scores)
        (if (eq (len scores) 0) 0
            (add (if (str_eq id (fkhe-score-id (head scores))) 1 0)
                 (fkhe-count-score-id id (tail scores)))))
    (defn fkhe-every-row-scored-once? (rows scores)
        (if (eq (len rows) 0) 1
            (if (eq (fkhe-count-score-id (fkhe-id (head rows)) scores) 1)
                (fkhe-every-row-scored-once? (tail rows) scores) 0)))
    (defn fkhe-complete-score-set? (scores rows)
        (if (and (eq (len scores) (len rows))
                 (and (eq (fkhe-all-scores-valid? scores rows) 1)
                      (eq (fkhe-every-row-scored-once? rows scores) 1))) 1 0))
    (defn fkhe-observations (scores)
        (if (eq (len scores) 0) (list)
            (cons (fkhe-score-observation (head scores))
                  (fkhe-observations (tail scores)))))
    (defn fkhe-at-least95? (ppm)
        (if (ge ppm (fkhe-threshold-ppm)) 1 0))
    (defn fkhe-every-family-at-least95? (scores families)
        (if (eq (len families) 0) 1
            (do
                (let id (head families))
                (let score (if (eq (len scores) 0) (list)
                    (if (str_eq (fkhe-score-family (head scores)) id)
                        (head scores)
                        (fkhe-find-family-score (tail scores) id))))
                (if (eq (len score) 0) 0
                    (if (eq (fkhe-at-least95?
                            (nmfe-obs-promotion (fkhe-score-observation score))) 1)
                        (fkhe-every-family-at-least95? scores (tail families)) 0)))))
    (defn fkhe-find-family-score (scores family)
        (if (eq (len scores) 0) (list)
            (if (str_eq (fkhe-score-family (head scores)) family) (head scores)
                (fkhe-find-family-score (tail scores) family))))

    ; report = tag scope model-id dataset-sha audit family-count scores aggregate
    ;          model-executed release-ok overall95 family95 live-credit
    (defn fkhe-report (scope model-id model-executed release-ok scores)
        (do
            (let rows (fkhe-rows))
            (let audit (fkhe-leakage-audit rows))
            (let aggregate (nmfe-aggregate (fkhe-observations scores)))
            (let complete (fkhe-complete-score-set? scores rows))
            (let overall95 (if (eq complete 1)
                (fkhe-at-least95? (nth aggregate 4)) 0))
            (let family95 (if (eq complete 1)
                (fkhe-every-family-at-least95? scores (fkhe-families)) 0))
            (let live
                (if (and (str_eq scope (fkhe-live-scope))
                     (and (gt (str_len model-id) 0)
                     (and (eq model-executed 1)
                     (and (eq release-ok 1)
                     (and (eq (fkhe-dataset-valid?) 1)
                     (and (eq (fkhe-leakage-audit-valid? audit) 1)
                     (and (eq complete 1)
                     (and (eq (nth aggregate 6) 0)
                     (and (eq overall95 1) (eq family95 1)))))))))) 1 0))
            (list "form-knowledge-qwen-heldout-report-v1" scope model-id
                  (fkhe-dataset-sha256 rows) audit (len (fkhe-families))
                  scores aggregate model-executed release-ok overall95 family95 live)))
    (defn fkhe-report-aggregate (r) (nth r 7))
    (defn fkhe-report-overall95 (r) (nth r 10))
    (defn fkhe-report-family95 (r) (nth r 11))
    (defn fkhe-report-live-credit (r) (nth r 12))

    0)
