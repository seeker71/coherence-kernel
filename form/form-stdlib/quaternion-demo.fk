; quaternion-demo.fk — generates the numeric tables for a 4D-reasoning visualization, entirely
; inside the kernel: every printed number is COMPUTED by fkwu at run time (Taylor-series
; fsin/fcos, the Hamilton product, the Hopf map, stereographic division), never typed by hand.
; Run: (from form/form/)  ../fkwu form-stdlib/quaternion-demo.fk  — no --src needed, fkwu
; dispatches on the .fk suffix directly (see runtime/fkwu-uni.c's fk_run dispatch).
;
; The T2/T3 axis and side below are not a guess: form-stdlib/tests/quaternion-band.fk claims
; c9/c10 measure them directly (round-trip through a probe script, kept only in the receipt,
; not shipped) — an earlier draft had left/right backwards until the probe corrected it.
;
; Five tables, each one line per sample, tag-prefixed for easy parsing of the captured stdout:
;
;   T1  the fiber through the identity: orbit(t) = q-orbit(t, 1,0,0) [i-axis], t over a full
;       turn. Prints q(t), its Hopf image (CONSTANT (0,0,1) — q0=1 makes left/right multiply
;       the same thing, the degenerate case of T2's general rule), its stereographic image (a
;       genuine moving curve — a different map, blind to nothing), the rotation it induces on
;       its OWN axis (CONSTANT (1,0,0) — q-rotate3 fixes it), and on a PERPENDICULAR axis (a
;       circle at DOUBLE the parameter angle — the 2:1 cover made visible over one sweep of t).
;
;   T2  a second fiber, LEFT of a generic base point q0=(1,2,3,4)/|·|: rotor(t)·q0, i-axis
;       rotor. Measured to hold q-hopf CONSTANT at q-hopf(q0) — the fiber is a LEFT coset.
;
;   T3  the same base point and rotor, RIGHT-multiplied instead: q0·rotor(t). Measured to move
;       q-hopf away from q-hopf(q0) — the side of multiplication is not interchangeable.
;
;   T4  q-left-rotate(orbit_k(t), e1) — the isoclinic trajectory of the x-axis basis point
;       under pure left multiplication by a K-AXIS rotor (deliberately a different axis than
;       T1-T3 — this table is about the invariant-PLANE structure, not the fiber direction).
;       quaternion-band.fk's c8 already proved this stays EXACTLY inside the {e1,e2} plane
;       (w=0, z=0 identically) at one t; this sweeps the full circle it traces there.
;
;   T5  q-left-rotate(orbit_k(t), e0) — the companion trajectory of the OTHER invariant plane
;       {e0,e3}, traced at the same t values — the two simultaneous, independent 2-plane
;       rotations that together define an isoclinic 4D rotation.
;
; preludes: form-stdlib/core.fk form-stdlib/trig.fk form-stdlib/quaternion.fk

(do
    (defn qd-n () 24)
    ; t = (idx + 0.5) * TAU/N — the half-sample offset keeps every t off the pole (w=1) exactly,
    ; so T1's stereographic projection never divides by zero.
    (defn qd-t (idx) (div (mul (TAU) (add idx 0.5)) (mul (qd-n) 1.0)))
    (defn qd-q0 () (q-normalize (quat 1.0 2.0 3.0 4.0)))

    (defn qd-f (x) (float_to_str x))
    (defn qd-join (strs)
        (if (eq (len strs) 1) (head strs)
            (str_concat (head strs) (str_concat " " (qd-join (tail strs))))))
    (defn qd-row (tag idx t vals) (print (qd-join (cons tag (cons (int_to_str idx) (cons (qd-f t) (qd-fmap vals)))))))
    (defn qd-fmap (xs) (if (eq (len xs) 0) (empty) (cons (qd-f (head xs)) (qd-fmap (tail xs)))))

    ; --- T1: the fiber through the identity, i-axis ---
    (defn qd-t1-row (idx)
        (do
            (let t (qd-t idx))
            (let q (q-orbit t 1.0 0.0 0.0))
            (let h (q-hopf q))
            (let s (q-stereo q))
            (let rown (q-rotate3 q 1.0 0.0 0.0))
            (let rperp (q-rotate3 q 0.0 1.0 0.0))
            (qd-row "T1" idx t
                (list (qw q) (qx q) (qy q) (qz q)
                      (nth h 0) (nth h 1) (nth h 2)
                      (nth s 0) (nth s 1) (nth s 2)
                      (nth rown 0) (nth rown 1) (nth rown 2)
                      (nth rperp 0) (nth rperp 1) (nth rperp 2)))))
    (defn qd-t1-loop (idx) (if (eq idx (qd-n)) 0 (do (qd-t1-row idx) (qd-t1-loop (add idx 1)))))

    ; --- T2: a second fiber, LEFT of q0 — measured to hold q-hopf constant (the fiber side) ---
    (defn qd-t2-row (idx)
        (do
            (let t (qd-t idx))
            (let q (q-mul (q-orbit t 1.0 0.0 0.0) (qd-q0)))
            (let h (q-hopf q))
            (qd-row "T2" idx t (list (qw q) (qx q) (qy q) (qz q) (nth h 0) (nth h 1) (nth h 2)))))
    (defn qd-t2-loop (idx) (if (eq idx (qd-n)) 0 (do (qd-t2-row idx) (qd-t2-loop (add idx 1)))))

    ; --- T3: the same base point and rotor, RIGHT-multiplied — measured to move q-hopf ---
    (defn qd-t3-row (idx)
        (do
            (let t (qd-t idx))
            (let q (q-mul (qd-q0) (q-orbit t 1.0 0.0 0.0)))
            (let h (q-hopf q))
            (qd-row "T3" idx t (list (qw q) (qx q) (qy q) (qz q) (nth h 0) (nth h 1) (nth h 2)))))
    (defn qd-t3-loop (idx) (if (eq idx (qd-n)) 0 (do (qd-t3-row idx) (qd-t3-loop (add idx 1)))))

    ; --- T4 / T5: the two simultaneous invariant-plane trajectories of a K-AXIS isoclinic
    ; rotation (a different axis than T1-T3 on purpose — this pair is about the invariant-
    ; plane structure, independent of which axis happens to be a Hopf fiber direction) ---
    (defn qd-t4-row (idx)
        (do
            (let t (qd-t idx))
            (let l (q-left-rotate (q-orbit t 0.0 0.0 1.0) (quat 0.0 1.0 0.0 0.0)))
            (qd-row "T4" idx t (list (qw l) (qx l) (qy l) (qz l)))))
    (defn qd-t4-loop (idx) (if (eq idx (qd-n)) 0 (do (qd-t4-row idx) (qd-t4-loop (add idx 1)))))
    (defn qd-t5-row (idx)
        (do
            (let t (qd-t idx))
            (let l (q-left-rotate (q-orbit t 0.0 0.0 1.0) (quat 1.0 0.0 0.0 0.0)))
            (qd-row "T5" idx t (list (qw l) (qx l) (qy l) (qz l)))))
    (defn qd-t5-loop (idx) (if (eq idx (qd-n)) 0 (do (qd-t5-row idx) (qd-t5-loop (add idx 1)))))

    (defn qd-emit-all ()
        (do
            (print "QDEMO")
            (print (qd-join (list "HEADER-T1" "idx" "t" "w" "x" "y" "z" "hopfx" "hopfy" "hopfz" "sx" "sy" "sz" "rownx" "rowny" "rownz" "rperpx" "rperpy" "rperpz")))
            (qd-t1-loop 0)
            (print (qd-join (list "HEADER-T2" "idx" "t" "w" "x" "y" "z" "hopfx" "hopfy" "hopfz")))
            (qd-t2-loop 0)
            (print (qd-join (list "HEADER-T3" "idx" "t" "w" "x" "y" "z" "hopfx" "hopfy" "hopfz")))
            (qd-t3-loop 0)
            (print (qd-join (list "HEADER-T4" "idx" "t" "w" "x" "y" "z")))
            (qd-t4-loop 0)
            (print (qd-join (list "HEADER-T5" "idx" "t" "w" "x" "y" "z")))
            (qd-t5-loop 0)
            (print "END")
            0))
    (qd-emit-all))
