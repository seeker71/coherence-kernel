//////////////////////////////////////////////////////////////////////
//
// lane-motion.bml
//
// Executable BML. The LANE-MOTION WITNESS: every data point the glass
// shows, sampled as name=value lines, twice, and diffed by name — so
// "all data points move" is an observation, never a claim. A held
// point is reported with its value, because stillness is data too.
//
// This surface is also the single home of the ledger markers and the
// substrate-census command: any cell that counts prefills, walks
// signals, or asks the tree for its phases speaks these defs, never a
// repeated literal.
//
// preludes: form-stdlib/core.fk form-stdlib/text-rows.bml form-stdlib/hearth.bml form-stdlib/hearth-glass.bml form-stdlib/bml/form-cli-resident-birth-observation.bml
//
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormLaneMotion {
        thought lane-motion-pattern = list("sample-twice", "diff-by-name", "held-is-data", "one-home-per-literal");

        def lms-mark-prefill() = "prefill-complete";
        def lms-mark-checkpoint() = "decode-checkpoint";
        def lms-mark-timeout() = "decode-timeout";
        def lms-mark-turn() = "turn=";
        def lms-mark-elapsed() = "elapsed-ms";
        def lms-mark-pos() = "pos";
        def lms-mark-tokens() = "tokens";
        def lms-mark-choice() = "lifecycle=choice";
        def lms-mark-response() = "<|form:response|>";
        def lms-mark-fail() = "error=1";
        def lms-mark-rebuild() = "rebuilding from source";
        def lms-mark-stale() = "stale .fkb";
        def lms-mark-diag() = "error:";
        def lms-mark-warn() = "warning:";
        def lms-mark-events() = list("board-mended", "glass-reborn", "restart-needed", "prefill t=", "patch t=", "fail t=");
        def lms-mark-degraded() = "birth-degraded";
        def lms-mark-birth-start() = "model-session-seal-begin";
        // the heat file: "count name" per hot recipe, rewritten live
        // every ~64M dispatches by whichever walker burns.  The board's PID
        // selects the resident's own row, so this observing fkwu cannot
        // overwrite the work it is here to see.
        def lms-heat-path() = ".fkwu-heat." ++ int_to_str(hearth-board-pid());
        def lms-heat() = (Comparable) hearth-standing() == 1 ? lms-heat-of(read_file(lms-heat-path())) : "";
        def lms-heat-of(h) = h ?? "";
        // heat rows are tabular text ("count name"): the generic engine
        // reads them — one fold home, no hand-rolled walk.
        def lms-heat-max(text) = lms-heat-max-of(tx-max-line-by-int(text, 0));
        def lms-heat-max-of(line) = (Comparable) str_len(line) == 0 ? list(0, "-") : list(tx-int(line, 0), tx-field(line, 1));
        def lms-heat-count(text) = tx-count-lines(text);
        // an error is a signal to attend, then flow — counted within the
        // CURRENT birth's window, a fresh healthy birth reads zero and
        // the stale signal never dams the lane.
        def lms-birth-window(out) = lms-birth-window-at(out, gl-find-last(out, lms-mark-birth-start()));
        def lms-birth-window-at(out, at) = at < 0 ? out : substring(out, at, str_len(out));

        def lms-census-cmd() = "printf 'ice=%s water=%s src=%s' \"$(find . -name '*.fkb' -not -path './walkers/*' -not -path './.git/*' | wc -l | tr -d ' ')\" \"$(find . -name '*.fkb' -mmin -60 -not -path './walkers/*' -not -path './.git/*' | wc -l | tr -d ' ')\" \"$(find . \\( -name '*.fk' -o -name '*.bml' \\) -not -path './walkers/*' -not -path './.git/*' | wc -l | tr -d ' ')\"";
        def lms-lastland-cmd() = "git log -1 --format=who=%an-%cd --date=format:%H:%M origin/main";
        def lms-host-text(value) = value ?? "";
        def lms-census() = lms-host-text(host-exec(lms-census-cmd(), ""));
        def lms-siblings() = gl-count-of(lms-host-text(host-exec("pgrep -fl fkwu", "")), "fkwu") - 1;
        def lms-lastland() = gl-word-field(lms-host-text(host-exec(lms-lastland-cmd(), "")), "who");
        // peers standing beyond the board's one are orphans — strays a
        // misread left behind (two witnessed 2026-09-01); counted from
        // the anchored resident pattern, board pid excluded.
        // The board and the census share the same process-image definition.
        // A birth feeder is useful transport, but it is not a resident and
        // must not create a phantom orphan in the glass.
        def lms-peers-cmd() = hearth-resident-pids-command() ++ " | wc -l | tr -d ' '";
        def lms-orphans() = lms-orphans-of(fmv-last-int(lms-host-text(host-exec(lms-peers-cmd(), ""))), hearth-standing());
        def lms-orphans-of(peers, standing) = peers > standing ? (peers - standing) : 0;

        def lms-i(k, v) = hearth-kv(k, int_to_str(v));
        def lms-birth-text(k, v) = hearth-kv(k, fcrbo-display-text(v));
        def lms-birth-int(k, v) = hearth-kv(k, fcrbo-display-int(v));
        def lms-join(parts) = (Comparable) len(parts) == 0 ? "" : (Comparable) len(tail(parts)) == 0 ? head(parts) : head(parts) ++ lms-join(tail(parts));
        def lms-birth-part(birth) {
            lms-join(list(lms-birth-text("bootcache", fcrbo-cache(birth)), lms-birth-int("bootctx", fcrbo-source-context-ms(birth)), lms-birth-int("bootprog", fcrbo-native-program-ms(birth)), lms-birth-int("bootsetup", fcrbo-resident-setup-ms(birth)), lms-birth-int("bootprefill", fcrbo-prefill-ms(birth))));
        }
        def lms-out() = lms-host-text(read_file(hearth-out()));
        def lms-rsp() = lms-host-text(read_file(hearth-reply()));
        def lms-icemiss(out) = gl-count-of(out, lms-mark-rebuild()) + gl-count-of(out, lms-mark-stale());
        def lms-tpot(rsp) = lms-tpot-of(gl-newest(gl-collect(rsp, lms-mark-elapsed())), gl-newest(gl-collect(rsp, lms-mark-tokens())));
        def lms-tpot-of(ms, toks) = toks > 0 ? (ms / toks) : 0;
        // each spool is read ONCE per sample and its text travels by
        // parameter; the -of forms are the single-read seam, the nullary
        // doors stay for callers that sample in isolation.
        def lms-waiting-of(task, rsp) = gl-waiting-turns(gl-collect(task, lms-mark-pos-free-turn()), gl-collect(rsp, lms-mark-pos-free-turn()));
        def lms-waiting() = lms-waiting-of(lms-task(), lms-rsp());
        def lms-hopper() = len(lms-waiting());
        def lms-csv-go(ts, acc) = (Comparable) len(ts) == 0 ? acc : lms-csv-go(tail(ts), acc ++ "," ++ int_to_str(head(ts)));
        def lms-turns-csv(ts) = (Comparable) len(ts) == 0 ? "none" : lms-csv-go(tail(ts), int_to_str(head(ts)));
        def lms-mark-pos-free-turn() = "turn";
        // A fresh checkout has no task spool yet.  Keep that absence typed at
        // the file boundary, then present the turn allocator with empty text.
        def lms-max-turn(text) = gl-max-go(gl-collect(lms-host-text(text), lms-mark-pos-free-turn()), 0);

        def lms-part1() = lms-i("pid", hearth-board-pid()) ++ lms-i("alive", hearth-standing()) ++ lms-i("taskb", file_size(hearth-task())) ++ lms-i("replyb", file_size(hearth-reply()));
        def lms-part2(out) = lms-i("pf", gl-count-of(out, lms-mark-prefill())) ++ lms-i("cp", gl-count-of(out, lms-mark-checkpoint())) ++ lms-i("touts", gl-count-of(out, lms-mark-timeout())) ++ lms-i("icemiss", lms-icemiss(out)) ++ hearth-kv("direct", gl-flight-phase-now(out)) ++ lms-i("directage", gl-flight-age(out, now_unix_ms()));
        def lms-part3(rsp) = lms-i("lastms", gl-newest(gl-collect(rsp, lms-mark-elapsed()))) ++ lms-i("kvpos", gl-newest(gl-collect(rsp, lms-mark-pos()))) ++ lms-i("p50", gl-pct(gl-collect(rsp, lms-mark-elapsed()), 50)) ++ lms-i("p95", gl-pct(gl-collect(rsp, lms-mark-elapsed()), 95)) ++ lms-i("served", gl-count-of(rsp, lms-mark-turn())) ++ lms-i("choices", gl-count-of(rsp, lms-mark-choice())) ++ lms-i("fails", gl-count-of(rsp, lms-mark-fail())) ++ hearth-kv("sig", gl-word-field-last(rsp, "signal"));
        def lms-part4(census, siblings, lastland) = lms-i("ice", fmv-field(census, "ice")) ++ lms-i("water", fmv-field(census, "water")) ++ lms-i("gas", fmv-field(census, "src") - fmv-field(census, "ice")) ++ lms-i("siblings", siblings) ++ hearth-kv("lastland", lastland);
        def lms-task() = lms-host-text(read_file(hearth-task()));
        def lms-int-last(s, name) = fmv-field-at(s, name ++ "=", gl-find-last(s, name ++ "="));
        def lms-tag2(a, b) = a ++ ":" ++ b;
        def lms-choicet(rsp) = gl-turn-before(rsp, gl-find-last(rsp, lms-mark-choice()));
        def lms-part5(out, rsp, task) {
            let heat = lms-heat();
            let hm = lms-heat-max(heat);
            let route = lms-join(list(hearth-kv("route", gl-word-field-last(rsp, "route")), hearth-kv("selroute", gl-stage-field(out, "route")), hearth-kv("selphase", gl-stage-field(out, "phase")), hearth-kv("selstat", gl-stage-field(out, "status")), lms-i("gen", fmv-field(gl-stage-line(out), "generated")), hearth-kv("carrier", gl-word-field-last(rsp, "carrier")), hearth-kv("model", hearth-resident-model(hearth-resident-pid())), lms-i("hot", hm[0]), hearth-kv("hotname", hm[1]), lms-i("hotn", lms-heat-count(heat))));
            let birth = fcrbo-snapshot(out);
            let resident = lms-join(list(lms-i("floorpos", lms-int-last(out, "recycle-floor-pos")), lms-i("sesspos", lms-int-last(out, "session-pos")), lms-i("pending", lms-int-last(out, "session-pending")), lms-i("observ", lms-int-last(out, "session-observations")), lms-i("errs", gl-count-of(lms-birth-window(out), lms-mark-diag())), lms-i("degraded", gl-count-of(lms-birth-window(out), lms-mark-degraded())), lms-i("orphans", lms-orphans()), lms-birth-int("admit", fcrbo-prefill-ms(birth)), lms-birth-part(birth)));
            let tail = lms-join(list(lms-i("choicet", lms-choicet(rsp)), hearth-kv("lastask", lms-tag2(gl-word-field-last(task, "turn"), gl-word-field-last(task, "kind"))), hearth-kv("lastreply", lms-tag2(gl-word-field-last(rsp, "turn"), gl-word-field-last(rsp, "signal")))));
            lms-join(list(route, resident, tail));
        }
        def lms-sample-of(out, rsp, task, census, siblings, lastland) = lms-part1() ++ lms-part2(out) ++ lms-part3(rsp) ++ lms-i("tpot", lms-tpot(rsp)) ++ lms-i("hopper", lms-hopper()) ++ hearth-kv("waiting", lms-turns-csv(lms-waiting-of(task, rsp))) ++ lms-part5(out, rsp, task) ++ lms-part4(census, siblings, lastland);
        def lms-sample(census, siblings, lastland) = lms-sample-of(lms-out(), lms-rsp(), lms-task(), census, siblings, lastland);
        def lms-snap() = lms-sample(lms-census(), lms-siblings(), lms-lastland());

        def lms-names() = list("pid", "alive", "taskb", "replyb", "pf", "cp", "lastms", "hopper", "waiting", "kvpos", "tpot", "p50", "p95", "served", "sig", "choices", "fails", "touts", "icemiss", "direct", "directage", "route", "selroute", "selphase", "selstat", "gen", "carrier", "model", "hot", "hotname", "hotn", "floorpos", "sesspos", "pending", "observ", "errs", "degraded", "orphans", "admit", "bootcache", "bootctx", "bootprog", "bootsetup", "bootprefill", "choicet", "lastask", "lastreply", "gas", "water", "ice", "siblings", "lastland");
        def lms-moved(a, b, name) = (String) gl-word-field(a, name) == gl-word-field(b, name) ? 0 : 1;
        def lms-line(a, b, name) = (Comparable) lms-moved(a, b, name) == 1 ? lms-moved-line(a, b, name) : lms-held-line(a, name);
        def lms-moved-line(a, b, name) = tg-span("good", "MOVED ") ++ name ++ " " ++ gl-word-field(a, name) ++ " -> " ++ gl-word-field(b, name) ++ tg-nl();
        def lms-held-line(a, name) = tg-span("dim", "held  " ++ name ++ " " ++ gl-word-field(a, name)) ++ tg-nl();
        def lms-report-go(a, b, names, moved, acc) = (Comparable) len(names) == 0 ? acc ++ "moved=" ++ int_to_str(moved) ++ "/" ++ int_to_str(len(lms-names())) ++ tg-nl() : lms-report-go(a, b, tail(names), moved + lms-moved(a, b, head(names)), acc ++ lms-line(a, b, head(names)));
        def lms-report(a, b) = lms-report-go(a, b, lms-names(), 0, "");
    }
    0;
}
