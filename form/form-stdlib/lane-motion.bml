//////////////////////////////////////////////////////////////////////
//
// lane-motion.bml
//
// Executable BML. The LANE-MOTION WITNESS: every data point the glass
// shows, sampled as name=value lines, twice, and diffed by name — so
// "all data points move" is an observation, never a claim. A held
// point is reported with its value, because stillness is data too.
//
// This surface is also the single home of the ledger markers and the
// substrate-census command: any cell that counts prefills, walks
// signals, or asks the tree for its phases speaks these defs, never a
// repeated literal.
//
// preludes: form-stdlib/core.fk form-stdlib/hearth.bml form-stdlib/hearth-glass.bml
//
// Proven by: form-stdlib/tests/lane-motion-band.fk
//
//////////////////////////////////////////////////////////////////////

section [form.bml] {
    class FormLaneMotion {
        thought lane-motion-pattern = list("sample-twice", "diff-by-name", "held-is-data", "one-home-per-literal");

        def lms-mark-prefill() = "prefill-complete";
        def lms-mark-checkpoint() = "decode-checkpoint";
        def lms-mark-timeout() = "decode-timeout";
        def lms-mark-turn() = "turn=";
        def lms-mark-elapsed() = "elapsed-ms";
        def lms-mark-pos() = "pos";
        def lms-mark-tokens() = "tokens";
        def lms-mark-choice() = "signal=choice";
        def lms-mark-fail() = "error=1";
        def lms-mark-rebuild() = "rebuilding from source";
        def lms-mark-stale() = "stale .fkb";

        def lms-census-cmd() = "printf 'ice=%s water=%s src=%s' \"$(find . -name '*.fkb' -not -path './walkers/*' -not -path './.git/*' | wc -l | tr -d ' ')\" \"$(find . -name '*.fkb' -mmin -60 -not -path './walkers/*' -not -path './.git/*' | wc -l | tr -d ' ')\" \"$(find . \\( -name '*.fk' -o -name '*.bml' \\) -not -path './walkers/*' -not -path './.git/*' | wc -l | tr -d ' ')\"";
        def lms-lastland-cmd() = "git log -1 --format=who=%an-%cd --date=format:%H:%M origin/main";
        def lms-census() = host-exec(lms-census-cmd(), "");
        def lms-siblings() = sub(gl-count-of(host-exec("pgrep -fl fkwu", ""), "fkwu"), 1);
        def lms-lastland() = gl-word-field(host-exec(lms-lastland-cmd(), ""), "who");

        def lms-i(k, v) = hearth-kv(k, int_to_str(v));
        def lms-out() = read_file(hearth-out());
        def lms-rsp() = read_file(hearth-reply());
        def lms-icemiss(out) = add(gl-count-of(out, lms-mark-rebuild()), gl-count-of(out, lms-mark-stale()));
        def lms-tpot(rsp) = lms-tpot-of(gl-newest(gl-collect(rsp, lms-mark-elapsed())), gl-newest(gl-collect(rsp, lms-mark-tokens())));
        def lms-tpot-of(ms, toks) = if gt(toks, 0) then div(ms, toks) else 0;
        def lms-waiting() = gl-waiting-turns(gl-collect(read_file(hearth-task()), lms-mark-pos-free-turn()), gl-collect(lms-rsp(), lms-mark-pos-free-turn()));
        def lms-hopper() = len(lms-waiting());
        def lms-csv-go(ts, acc) = if eq(len(ts), 0) then acc else lms-csv-go(tail(ts), str_concat(acc, str_concat(",", int_to_str(head(ts)))));
        def lms-turns-csv(ts) = if eq(len(ts), 0) then "none" else lms-csv-go(tail(ts), int_to_str(head(ts)));
        def lms-mark-pos-free-turn() = "turn";
        def lms-max-turn(text) = gl-max-go(gl-collect(text, lms-mark-pos-free-turn()), 0);

        def lms-part1() = str_concat(lms-i("pid", hearth-board-pid()), str_concat(lms-i("alive", hearth-standing()), str_concat(lms-i("taskb", file_size(hearth-task())), lms-i("replyb", file_size(hearth-reply())))));
        def lms-part2(out) = str_concat(lms-i("pf", gl-count-of(out, lms-mark-prefill())), str_concat(lms-i("cp", gl-count-of(out, lms-mark-checkpoint())), str_concat(lms-i("touts", gl-count-of(out, lms-mark-timeout())), lms-i("icemiss", lms-icemiss(out)))));
        def lms-part3(rsp) = str_concat(lms-i("lastms", gl-newest(gl-collect(rsp, lms-mark-elapsed()))), str_concat(lms-i("kvpos", gl-newest(gl-collect(rsp, lms-mark-pos()))), str_concat(lms-i("p50", gl-pct(gl-collect(rsp, lms-mark-elapsed()), 50)), str_concat(lms-i("p95", gl-pct(gl-collect(rsp, lms-mark-elapsed()), 95)), str_concat(lms-i("served", gl-count-of(rsp, lms-mark-turn())), str_concat(lms-i("choices", gl-count-of(rsp, lms-mark-choice())), str_concat(lms-i("fails", gl-count-of(rsp, lms-mark-fail())), hearth-kv("sig", gl-word-field-last(rsp, "signal")))))))));
        def lms-part4(census, siblings, lastland) = str_concat(lms-i("ice", fmv-field(census, "ice")), str_concat(lms-i("water", fmv-field(census, "water")), str_concat(lms-i("gas", sub(fmv-field(census, "src"), fmv-field(census, "ice"))), str_concat(lms-i("siblings", siblings), hearth-kv("lastland", lastland)))));
        def lms-sample(census, siblings, lastland) = str_concat(lms-part1(), str_concat(lms-part2(lms-out()), str_concat(lms-part3(lms-rsp()), str_concat(lms-i("tpot", lms-tpot(lms-rsp())), str_concat(lms-i("hopper", lms-hopper()), str_concat(hearth-kv("waiting", lms-turns-csv(lms-waiting())), lms-part4(census, siblings, lastland)))))));
        def lms-snap() = lms-sample(lms-census(), lms-siblings(), lms-lastland());

        def lms-names() = list("pid", "alive", "taskb", "replyb", "pf", "cp", "lastms", "hopper", "waiting", "kvpos", "tpot", "p50", "p95", "served", "sig", "choices", "fails", "touts", "icemiss", "gas", "water", "ice", "siblings", "lastland");
        def lms-moved(a, b, name) = if str_eq(gl-word-field(a, name), gl-word-field(b, name)) then 0 else 1;
        def lms-line(a, b, name) = if eq(lms-moved(a, b, name), 1) then lms-moved-line(a, b, name) else lms-held-line(a, name);
        def lms-moved-line(a, b, name) = str_concat(tg-span("good", "MOVED "), str_concat(name, str_concat(" ", str_concat(gl-word-field(a, name), str_concat(" -> ", str_concat(gl-word-field(b, name), tg-nl()))))));
        def lms-held-line(a, name) = str_concat(tg-span("dim", str_concat("held  ", str_concat(name, str_concat(" ", gl-word-field(a, name))))), tg-nl());
        def lms-report-go(a, b, names, moved, acc) = if eq(len(names), 0) then str_concat(acc, str_concat("moved=", str_concat(int_to_str(moved), str_concat("/", str_concat(int_to_str(len(lms-names())), tg-nl()))))) else lms-report-go(a, b, tail(names), add(moved, lms-moved(a, b, head(names))), str_concat(acc, lms-line(a, b, head(names))));
        def lms-report(a, b) = lms-report-go(a, b, lms-names(), 0, "");
    }
    0;
}
