    (defn fkegto-all-released-local? (rows)
        (if (nil? rows) 1
            (if (and (eq (fkegto-released? (head rows)) 1)
                (and (eq (fkegto-http (head rows)) 0)
                     (eq (fkegto-remote (head rows)) 0)))
                (fkegto-all-released-local? (tail rows)) 0)))
