(do
    (defn fkegto-model-id ()
        "mlx-community/Llama-3.2-3B-Instruct-4bit@7f0dc925e0d0afb0322d96f9255cfddf2ba5636e")
    (defn fkegto-e1-raw ()
        (fked-cat (list
            "Here is the complete bounded form.bml section body with the five zero-argument functions defined:\n\n"
            "```\n"
            "def fkecc-presence() = [nothing(), 0, 1];\n"
            "def fkecc-choice() = oac-choice([nothing(), 1], [1]);\n"
            "def fkecc-cut() = oac-cut-with-receipt([nothing(), 1], [1]);\n"
            "def fkecc-undo() = oac-undo([nothing(), 41], 99);\n"
            "def fkecc-timeout() = oac-timeout-walk([nothing(), 1], 1);\n"
            "0;\n```\n\n"
            "This code defines the five zero-argument functions as specified, and returns only the section body without the section wrapper. The functions are defined using the `def` keyword, and the syntax is consistent with the provided specification.")))
    (defn fkegto-f1-raw ()
        (fked-cat (list
            "def fkecc-presence() = [nothing(), 0, 1];\n"
            "def fkecc-choice() = oac-choice([nothing(), 1], [1]);\n"
            "def fkecc-cut() = oac-cut-with-receipt([nothing(), 1], [1]);\n"
            "def fkecc-undo() = oac-undo([nothing(), 41], 99);\n"
            "def fkecc-timeout() = oac-timeout-walk([nothing(), 1], 1);\n"
            "0;")))
    (defn fkegto-e2-raw ()
        (fked-cat (list
            "Here is the complete bounded form.bml section body with the five zero-argument functions defined:\n\n"
            "```\n"
            "def fkecc-presence() = [nothing(), 0, 1];\n"
            "def fkecc-choice() = oac-choice([nothing(), empty], [nothing(), empty]);\n"
            "def fkecc-cut() = oac-cut-with-receipt([nothing(), empty], [nothing(), empty]);\n"
            "def fkecc-undo() = oac-undo([nothing(), 41], 99);\n"
            "def fkecc-timeout() = oac-timeout-walk([nothing(), empty], 1, [nothing(), empty, empty]);\n"
            "0;\n```\n\n"
            "This code defines the five zero-argument functions as specified in the problem statement. The `fkecc-presence` function returns a native three-value list containing first-class nothing, integer 0, and integer 1. The `fkecc-choice` function runs the canonical choice mechanism over a silent lane followed by a lane acknowledging ONE with integer payload 1 and returns the acknowledgement. The `fkecc-cut` function runs canonical cut over those same two lanes and returns its receipt. The `fkecc-undo` function applies canonical undo to a nothing acknowledgement, checkpoint 41, and current memory 99. The `fkecc-timeout` function walks the silent then ONE lanes with budget 1 and returns the timeout walk.")))

    ; row = schema condition card-version continuation prompt-sha response-sha
    ;       prompt-tokens response-tokens elapsed-ms parse-signal parse-reason
    ;       foreign lowered harness-ran semantic semantic-max http remote
    ;       released supervised heldout-credit failure
    (defn fkegto-row (condition card-version continuation prompt-sha response-sha
            prompt-tokens response-tokens elapsed parse-signal failure)
        (list "form-exec-grammar-transport-observation-v1" condition
            card-version continuation (fkegto-model-id) prompt-sha response-sha
            prompt-tokens response-tokens elapsed parse-signal
            "present-invalid" 1 0 0 0 511 0 0 1 1 0 failure))
    (defn fkegto-condition (r) (nth r 1))
    (defn fkegto-card-version (r) (nth r 2))
    (defn fkegto-continuation (r) (nth r 3))
    (defn fkegto-response-sha (r) (nth r 6))
    (defn fkegto-parse-signal (r) (nth r 10))
    (defn fkegto-parse-reason (r) (nth r 11))
    (defn fkegto-foreign? (r) (nth r 12))
    (defn fkegto-lowered? (r) (nth r 13))
    (defn fkegto-harness-ran? (r) (nth r 14))
    (defn fkegto-semantic (r) (nth r 15))
    (defn fkegto-http (r) (nth r 17))
