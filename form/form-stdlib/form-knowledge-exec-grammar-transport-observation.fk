    (defn fkegto-released? (r) (nth r 19))
    (defn fkegto-supervised? (r) (nth r 20))
    (defn fkegto-heldout-credit? (r) (nth r 21))
    (defn fkegto-failure (r) (nth r 22))
    (defn fkegto-observations ()
