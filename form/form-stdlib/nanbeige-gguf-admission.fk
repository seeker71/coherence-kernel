; nanbeige-gguf-admission.fk — admission for the observed local Q4 carrier.
;
; This admits one derivative carrier, not the original BF16 release and not
; benchmark authority.  Host code observes bytes; Form owns the identity law.
; preludes: form-stdlib/core.fk

(do
    (defn nbga-revision ()
        "a4008676ccf9f341f25ed8b50a7dda95eaf9977b")
    (defn nbga-size () 2574807936)
    (defn nbga-sha ()
        "9ffd17d14472ff208409b3f51a6d87a5e5ec1b878b9a6f4dfe15c2a883366104")
    (defn nbga-runtime-revision ()
        "d28da865bf284acaecc98ad18a3c1f607c0fd754")

    (defn nbga-admit? (revision size sha)
        (if (str_eq revision (nbga-revision))
            (if (eq size (nbga-size))
                (if (str_eq sha (nbga-sha)) 1 0)
                0)
            0))
    (defn nbga-runtime-admit? (revision)
        (if (str_eq revision (nbga-runtime-revision)) 1 0))
    (defn nbga-execution-admit? (revision size sha runtime-revision)
        (if (eq (nbga-admit? revision size sha) 1)
            (nbga-runtime-admit? runtime-revision)
            0))
    0)
