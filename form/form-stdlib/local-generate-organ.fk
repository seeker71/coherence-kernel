; local-generate-organ.fk — local offer whose thought kernel evaluates Form cells.
;
; NAME / PLANE / CARRIER name the organ. The kernel is source-resonance-stream
; for recipe opcodes it owns (add, eq); mul/sub evaluate natively.
;
; Structure path: paren cells in the prompt evaluate and may enter the stream.
; Soft NL is not a frozen catalog of knowledge — that was a canary. An optional
; seed helper remains for rehearsal; default think does not consult it.
; Soft door: propose text → parse cells → eval → equivalence vs held-out →
; commit|refuse. Empty held-out does not authorize. Outcomes feed learning-loop;
; champion flips only on earned evidence (min-trials + higher rate).
;
; A thought can also REST: lg-defer builds a delayed-execution pointer; lg-force
; evaluates at need. Pointers embed; force resolves depth-first.
;
; preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk form-stdlib/learning-loop.fk

(do
    (defn lg-organ (name plane carrier)
        (list "lg-organ" name plane carrier))
    (defn lg-name (o) (nth o 1))
    (defn lg-plane (o) (nth o 2))
    (defn lg-carrier (o) (nth o 3))

    (defn lg-digit? (c)
        (if (and (ge c 48) (le c 57)) 1 0))
    (defn lg-skip-space (s i L)
        (if (ge i L) i
            (if (eq (str_byte_at s i) 32) (lg-skip-space s (add i 1) L) i)))
    (defn lg-num-end (s i L)
        (if (ge i L) i
            (if (eq (lg-digit? (str_byte_at s i)) 1) (lg-num-end s (add i 1) L) i)))
    (defn lg-read-num (s i)
        (do
            (let L (str_len s))
            (let j (lg-skip-space s i L))
            (let k (lg-num-end s j L))
            (if (eq j k) (list 0 k)
                (list (str_to_int (substring s j k)) k))))

    ; thought = (op a b value text)
    (defn lg-thought (op a b value)
        (list op a b value
            (str_concat "("
            (str_concat op
            (str_concat " "
            (str_concat (int_to_str a)
            (str_concat " "
            (str_concat (int_to_str b)
            (str_concat ")=" (int_to_str value))))))))))
    (defn lg-thought-op (t) (nth t 0))
    (defn lg-thought-a (t) (nth t 1))
    (defn lg-thought-b (t) (nth t 2))
    (defn lg-thought-value (t) (nth t 3))
    (defn lg-thought-text (t) (nth t 4))

    ; Form cell surface without the evaluated suffix — for inject prompts.
    (defn lg-cell-surface (t)
        (str_concat "("
        (str_concat (lg-thought-op t)
        (str_concat " "
        (str_concat (int_to_str (lg-thought-a t))
        (str_concat " "
        (str_concat (int_to_str (lg-thought-b t)) ")")))))))

    (defn lg-cells-prompt (thoughts)
        (if (eq (len thoughts) 0) ""
            (if (eq (len (tail thoughts)) 0) (lg-cell-surface (head thoughts))
                (str_concat (lg-cell-surface (head thoughts))
                    (str_concat " " (lg-cells-prompt (tail thoughts)))))))

    (defn lg-eval (op a b)
        (if (str_eq op "add")
            (srs-step (srs-token (srs-tok-recipe) (srs-op-add)) a b)
            (if (str_eq op "eq")
                (srs-step (srs-token (srs-tok-recipe) (srs-op-eq)) a b)
                (if (str_eq op "mul") (mul a b)
                    (if (str_eq op "sub") (sub a b)
                        (sub 0 1))))))

    (defn lg-parse-op-at (prompt op from)
        (do
            (let needle (str_concat "(" (str_concat op " ")))
            (let at (str_find prompt needle from))
            (if (lt at 0) (empty)
                (do
                    (let p (lg-read-num prompt (add at (str_len needle))))
                    (let q (lg-read-num prompt (nth p 1)))
                    (list op (nth p 0) (nth q 0) at (nth q 1))))))

    (defn lg-earlier (a b)
        (if (eq (len a) 0) b
            (if (eq (len b) 0) a
                (if (lt (nth a 3) (nth b 3)) a b))))

    (defn lg-parse-next (prompt from)
        (lg-earlier (lg-parse-op-at prompt "add" from)
        (lg-earlier (lg-parse-op-at prompt "mul" from)
        (lg-earlier (lg-parse-op-at prompt "sub" from)
                    (lg-parse-op-at prompt "eq" from)))))

    (defn lg-parse-all (prompt from acc)
        (do
            (let hit (lg-parse-next prompt from))
            (if (eq (len hit) 0) acc
                (do
                    (let op (nth hit 0))
                    (let a (nth hit 1))
                    (let b (nth hit 2))
                    (let value (lg-eval op a b))
                    (lg-parse-all prompt (nth hit 4)
                        (cons (lg-thought op a b value) acc))))))

    (defn lg-rev (xs acc)
        (if (eq (len xs) 0) acc (lg-rev (tail xs) (cons (head xs) acc))))

    (defn lg-cat (a b)
        (if (eq (len a) 0) b (cons (head a) (lg-cat (tail a) b))))

    ; Optional rehearsal seed — not knowledge authority, not on the default path.
    (defn lg-row (nl op a b) (list nl op a b))
    (defn lg-seed-rows ()
        (list
            (lg-row "2 plus 3" "add" 2 3)
            (lg-row "the square of 7" "mul" 7 7)
            (lg-row "six times seven" "mul" 6 7)
            (lg-row "nine minus four" "sub" 9 4)
            (lg-row "does 5 equal 5" "eq" 5 5)
            (lg-row "6 times 7" "mul" 6 7)
            (lg-row "40 plus 2" "add" 40 2)
            (lg-row "ten minus three" "sub" 10 3)
            (lg-row "does 42 equal 42" "eq" 42 42)))

    (defn lg-seed-find (prompt rows)
        (if (eq (len rows) 0) (empty)
            (if (ge (str_find prompt (nth (head rows) 0) 0) 0)
                (do
                    (let r (head rows))
                    (let op (nth r 1))
                    (let a (nth r 2))
                    (let b (nth r 3))
                    (list (lg-thought op a b (lg-eval op a b))))
                (lg-seed-find prompt (tail rows)))))

    (defn lg-think-seed (prompt)
        (lg-seed-find prompt (lg-seed-rows)))

    ; A thought can also REST — delayed-execution pointer; force at need.
    (defn lg-defer (op a b) (list "lg-defer" op a b))
    (defn lg-defer? (x)
        (if (eq (len x) 4)
            (if (str_eq (nth x 0) "lg-defer") 1 0) 0))
    (defn lg-operand-text (x)
        (if (eq (lg-defer? x) 1) (lg-defer-text x) (int_to_str x)))
    (defn lg-defer-text (p)
        (str_concat "(" (str_concat (nth p 1)
        (str_concat " " (str_concat (lg-operand-text (nth p 2))
        (str_concat " " (str_concat (lg-operand-text (nth p 3)) ")")))))))
    (defn lg-operand-force (x)
        (if (eq (lg-defer? x) 1) (lg-force x) x))
    (defn lg-force (p)
        (lg-eval (nth p 1)
                 (lg-operand-force (nth p 2))
                 (lg-operand-force (nth p 3))))

    ; Default path: Form cells only. Soft NL without cells yields empty.
    (defn lg-think-all (prompt)
        (lg-rev (lg-parse-all prompt 0 (empty)) (empty)))

    (defn lg-think (prompt)
        (do
            (let all (lg-think-all prompt))
            (if (eq (len all) 0) (empty) (head all))))

    (defn lg-values-line (ts)
        (if (eq (len ts) 0) ""
            (if (eq (len (tail ts)) 0) (int_to_str (lg-thought-value (head ts)))
                (str_concat (int_to_str (lg-thought-value (head ts)))
                    (str_concat "|" (lg-values-line (tail ts)))))))

    (defn lg-gap-default () 2)

    ; Learning-loop candidates: 1 = structure path (paren eval), 2 = soft propose.
    (defn lg-cand-structure () 1)
    (defn lg-cand-soft () 2)

    (defn lg-thought-ok? (t)
        (if (eq (len t) 0) 0
            (if (eq (lg-thought-value t) (sub 0 1)) 0 1)))

    (defn lg-all-ok? (thoughts)
        (if (eq (len thoughts) 0) 0
            (if (eq (lg-thought-ok? (head thoughts)) 0) 0
                (if (eq (len (tail thoughts)) 0) 1
                    (lg-all-ok? (tail thoughts))))))

    (defn lg-events-from (thoughts cand acc)
        (if (eq (len thoughts) 0) (lg-rev acc (empty))
            (lg-events-from (tail thoughts) cand
                (cons (list cand (lg-thought-ok? (head thoughts))) acc))))

    (defn lg-events-for (thoughts)
        (if (gt (len thoughts) 0)
            (lg-events-from thoughts (lg-cand-structure) (empty))
            (list (list (lg-cand-soft) 0))))

    (defn lg-observe (prompt prior)
        (do
            (let thoughts (lg-think-all prompt))
            (let events (lg-events-for thoughts))
            (let stream (lg-cat prior events))
            (list thoughts stream (ll-champion stream) (lg-values-line thoughts))))

    ; Soft path: propose → eval → equivalence → commit|refuse.
    (defn lg-propose (proposal)
        (lg-think-all proposal))

    (defn lg-values-equivalent? (proposed heldout)
        (if (eq (len heldout) 0) 0
            (if (eq (len proposed) 0) 0
                (if (str_eq (lg-values-line proposed) (lg-values-line heldout)) 1 0))))

    (defn lg-soft (proposal heldout-prompt)
        (do
            (let thoughts (lg-propose proposal))
            (let heldout (lg-think-all heldout-prompt))
            (if (eq (len thoughts) 0)
                (list "silent" (empty) 0 (list (list (lg-cand-soft) 0)))
                (if (eq (lg-all-ok? thoughts) 0)
                    (list "refuse" thoughts 0 (list (list (lg-cand-soft) 0)))
                    (do
                        (let eqv (lg-values-equivalent? thoughts heldout))
                        (if (eq eqv 0)
                            (list "refuse" thoughts 0 (list (list (lg-cand-soft) 0)))
                            (list "commit" thoughts 1 (list (list (lg-cand-soft) 1)))))))))

    (defn lg-soft-status (s) (nth s 0))
    (defn lg-soft-thoughts (s) (nth s 1))
    (defn lg-soft-equivalent (s) (nth s 2))
    (defn lg-soft-events (s) (nth s 3))
    (defn lg-soft-commit? (s) (if (str_eq (lg-soft-status s) "commit") 1 0))

    (defn lg-observe-soft (prompt proposal heldout prior)
        (do
            (let struct (lg-think-all prompt))
            (if (gt (len struct) 0)
                (lg-observe prompt prior)
                (do
                    (let soft (lg-soft proposal heldout))
                    (let stream (lg-cat prior (lg-soft-events soft)))
                    (list (lg-soft-thoughts soft) stream (ll-champion stream)
                        (lg-values-line (lg-soft-thoughts soft))
                        (lg-soft-status soft) (lg-soft-equivalent soft))))))

    0)
