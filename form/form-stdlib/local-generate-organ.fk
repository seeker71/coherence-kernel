// local-generate-organ.fk — local offer whose thought kernel evaluates Form cells.
//
// NAME / PLANE / CARRIER name the organ. The kernel is source-resonance-stream
// for recipe opcodes it owns (add, eq); mul/sub evaluate natively.
//
// Structure path: paren cells in the prompt evaluate and may enter the stream.
// Soft NL is not a frozen catalog of knowledge — that was a canary. An optional
// seed helper remains for rehearsal; default think does not consult it.
// Soft door: propose text → parse cells → eval → equivalence vs held-out →
// commit|refuse. Empty held-out does not authorize. Outcomes feed learning-loop;
// champion flips only on earned evidence (min-trials + higher rate).
//
// A thought can also REST: lg-defer builds a delayed-execution pointer; lg-force
// evaluates at need. Pointers embed; force resolves depth-first.
//
// preludes: form-stdlib/core.fk form-stdlib/substrate-phase.fk form-stdlib/source-resonance-stream.fk form-stdlib/learning-loop.fk
// preludes: form-stdlib/bml/local-generate-literal.bml
section [form.bml] {
    def lg-organ(name, plane, carrier) = ["lg-organ", name, plane, carrier];
    def lg-name(o) = o[1];
    def lg-plane(o) = o[2];
    def lg-carrier(o) = o[3];
    def lg-digit?(c) = c >= 48 && c <= 57 ? 1 : 0;
    def lg-skip-space(s, i, L) = i >= L ? i : (Comparable) str_byte_at(s, i) == 32 ? lg-skip-space(s, i + 1, L) : i;
    def lg-num-end(s, i, L) = i >= L ? i : (Comparable) lg-digit?(str_byte_at(s, i)) == 1 ? lg-num-end(s, i + 1, L) : i;
    def lg-read-num(s, i) = {
        let L = str_len(s);
        let j = lg-skip-space(s, i, L);
        let k = lg-num-end(s, j, L);
        (Comparable) j == k ? [0, k] : [str_to_int(substring(s, j, k)), k];
    };
    // thought = (op a b value text)
    def lg-thought(op, a, b, value) = [op, a, b, value, str_concat("(", str_concat(op, str_concat(" ", str_concat(int_to_str(a), str_concat(" ", str_concat(int_to_str(b), str_concat(")=", int_to_str(value))))))))];
    def lg-thought-op(t) = t[0];
    def lg-thought-a(t) = t[1];
    def lg-thought-b(t) = t[2];
    def lg-thought-value(t) = t[3];
    def lg-thought-text(t) = t[4];
    // Form cell surface without the evaluated suffix — for inject prompts.
    def lg-cell-surface(t) = str_concat("(", str_concat(lg-thought-op(t), str_concat(" ", str_concat(int_to_str(lg-thought-a(t)), str_concat(" ", str_concat(int_to_str(lg-thought-b(t)), ")"))))));
    def lg-cells-prompt(thoughts) = (Comparable) len(thoughts) == 0 ? "" : (Comparable) len(tail(thoughts)) == 0 ? lg-cell-surface(head(thoughts)) : str_concat(lg-cell-surface(head(thoughts)), str_concat(" ", lg-cells-prompt(tail(thoughts))));
    def lg-eval(op, a, b) = (String) op == "add" ? srs-step(srs-token(srs-tok-recipe(), srs-op-add()), a, b) : (String) op == "eq" ? srs-step(srs-token(srs-tok-recipe(), srs-op-eq()), a, b) : (String) op == "mul" ? a * b : (String) op == "sub" ? a - b : 0 - 1;
    def lg-parse-op-at(prompt, op, from) = lgl-op-at(prompt, op, from);
    def lg-earlier(a, b) = (Comparable) len(a) == 0 ? b : (Comparable) len(b) == 0 ? a : a[3] < b[3] ? a : b;
    def lg-parse-next(prompt, from) = lg-earlier(lg-parse-op-at(prompt, "add", from), lg-earlier(lg-parse-op-at(prompt, "mul", from), lg-earlier(lg-parse-op-at(prompt, "sub", from), lg-parse-op-at(prompt, "eq", from))));
    def lg-parse-all(prompt, from, acc) = {
        let hit = lg-parse-next(prompt, from);
        (Comparable) len(hit) == 0 ? acc : {
            let op = hit[0];
            let a = hit[1];
            let b = hit[2];
            let value = lg-eval(op, a, b);
            lg-parse-all(prompt, hit[4], cons(lg-thought(op, a, b, value), acc));
        };
    };
    def lg-rev(xs, acc) = (Comparable) len(xs) == 0 ? acc : lg-rev(tail(xs), cons(head(xs), acc));
    def lg-cat(a, b) = (Comparable) len(a) == 0 ? b : cons(head(a), lg-cat(tail(a), b));
    // Optional rehearsal seed — not knowledge authority, not on the default path.
    def lg-row(nl, op, a, b) = [nl, op, a, b];
    def lg-seed-rows() = [lg-row("2 plus 3", "add", 2, 3), lg-row("the square of 7", "mul", 7, 7), lg-row("six times seven", "mul", 6, 7), lg-row("nine minus four", "sub", 9, 4), lg-row("does 5 equal 5", "eq", 5, 5), lg-row("6 times 7", "mul", 6, 7), lg-row("40 plus 2", "add", 40, 2), lg-row("ten minus three", "sub", 10, 3), lg-row("does 42 equal 42", "eq", 42, 42)];
    def lg-seed-find(prompt, rows) = (Comparable) len(rows) == 0 ? empty() : str_find(prompt, head(rows)[0], 0) >= 0 ? {
        let r = head(rows);
        let op = r[1];
        let a = r[2];
        let b = r[3];
        [lg-thought(op, a, b, lg-eval(op, a, b))];
    } : lg-seed-find(prompt, tail(rows));
    def lg-think-seed(prompt) = lg-seed-find(prompt, lg-seed-rows());
    // A thought can also REST — delayed-execution pointer; force at need.
    def lg-defer(op, a, b) = ["lg-defer", op, a, b];
    def lg-defer?(x) = (Comparable) len(x) == 4 ? (String) x[0] == "lg-defer" ? 1 : 0 : 0;
    def lg-operand-text(x) = (Comparable) lg-defer?(x) == 1 ? lg-defer-text(x) : int_to_str(x);
    def lg-defer-text(p) = str_concat("(", str_concat(p[1], str_concat(" ", str_concat(lg-operand-text(p[2]), str_concat(" ", str_concat(lg-operand-text(p[3]), ")"))))));
    def lg-operand-force(x) = (Comparable) lg-defer?(x) == 1 ? lg-force(x) : x;
    def lg-force(p) = lg-eval(p[1], lg-operand-force(p[2]), lg-operand-force(p[3]));
    // Default path: Form cells only. Soft NL without cells yields empty.
    def lg-think-all(prompt) = lg-rev(lg-parse-all(prompt, 0, empty()), empty());
    def lg-think(prompt) = {
        let all = lg-think-all(prompt);
        (Comparable) len(all) == 0 ? empty() : head(all);
    };
    def lg-values-line(ts) = (Comparable) len(ts) == 0 ? "" : (Comparable) len(tail(ts)) == 0 ? int_to_str(lg-thought-value(head(ts))) : str_concat(int_to_str(lg-thought-value(head(ts))), str_concat("|", lg-values-line(tail(ts))));
    def lg-gap-default() = 2;
    // Learning-loop candidates: 1 = structure path (paren eval), 2 = soft propose.
    def lg-cand-structure() = 1;
    def lg-cand-soft() = 2;
    def lg-thought-ok?(t) = (Comparable) len(t) == 0 ? 0 : (Comparable) lg-thought-value(t) == 0 - 1 ? 0 : 1;
    def lg-all-ok?(thoughts) = (Comparable) len(thoughts) == 0 ? 0 : (Comparable) lg-thought-ok?(head(thoughts)) == 0 ? 0 : (Comparable) len(tail(thoughts)) == 0 ? 1 : lg-all-ok?(tail(thoughts));
    def lg-events-from(thoughts, cand, acc) = (Comparable) len(thoughts) == 0 ? lg-rev(acc, empty()) : lg-events-from(tail(thoughts), cand, cons([cand, lg-thought-ok?(head(thoughts))], acc));
    def lg-events-for(thoughts) = len(thoughts) > 0 ? lg-events-from(thoughts, lg-cand-structure(), empty()) : [[lg-cand-soft(), 0]];
    def lg-observe(prompt, prior) = {
        let thoughts = lg-think-all(prompt);
        let events = lg-events-for(thoughts);
        let stream = lg-cat(prior, events);
        [thoughts, stream, ll-champion(stream), lg-values-line(thoughts)];
    };
    // Soft mouth often emits infix (7*7), (40+2), (9-4). Rewrite to Form
    // ops before propose — held-out equivalence still gates commit.
    // BML door named: SoftInfixNormalize lawface (authority not yet risen).
    def lg-infix-op-name(b) = (Comparable) b == 42 ? "mul" : (Comparable) b == 43 ? "add" : (Comparable) b == 45 ? "sub" : "";
    def lg-infix-try(s, at, L) = {
        let astart = lg-skip-space(s, at + 1, L);
        let p = lg-read-num(s, at + 1);
        (Comparable) p[1] == astart ? empty() : {
            let i = lg-skip-space(s, p[1], L);
            i >= L ? empty() : {
                let op = lg-infix-op-name(str_byte_at(s, i));
                (Comparable) str_len(op) == 0 ? empty() : {
                    let bstart = lg-skip-space(s, i + 1, L);
                    let q = lg-read-num(s, i + 1);
                    (Comparable) q[1] == bstart ? empty() : {
                        let j = lg-skip-space(s, q[1], L);
                        j >= L ? empty() : (Comparable) str_byte_at(s, j) == 41 ? [op, p[0], q[0], at, j + 1] : empty();
                    };
                };
            };
        };
    };
    def lg-infix-at(s, from) = {
        let L = str_len(s);
        let at = str_find(s, "(", from);
        at < 0 ? empty() : {
            let hit = lg-infix-try(s, at, L);
            (Comparable) len(hit) == 0 ? lg-infix-at(s, at + 1) : hit;
        };
    };
    def lg-normalize-rewrite(s, hit) = str_concat(substring(s, 0, hit[3]), str_concat("(", str_concat(hit[0], str_concat(" ", str_concat(int_to_str(hit[1]), str_concat(" ", str_concat(int_to_str(hit[2]), str_concat(")", substring(s, hit[4], str_len(s))))))))));
    def lg-normalize-proposal(s) = {
        let hit = lg-infix-at(s, 0);
        (Comparable) len(hit) == 0 ? s : lg-normalize-proposal(lg-normalize-rewrite(s, hit));
    };
    // Soft path: propose → eval → equivalence → commit|refuse.
    def lg-propose(proposal) = lg-think-all(lg-normalize-proposal(proposal));
    def lg-values-equivalent?(proposed, heldout) = (Comparable) len(heldout) == 0 ? 0 : (Comparable) len(proposed) == 0 ? 0 : (String) lg-values-line(proposed) == lg-values-line(heldout) ? 1 : 0;
    def lg-soft(proposal, heldout-prompt) = {
        let thoughts = lg-propose(proposal);
        let heldout = lg-think-all(heldout-prompt);
        (Comparable) len(thoughts) == 0 ? ["silent", empty(), 0, [[lg-cand-soft(), 0]]] : (Comparable) lg-all-ok?(thoughts) == 0 ? ["refuse", thoughts, 0, [[lg-cand-soft(), 0]]] : {
            let eqv = lg-values-equivalent?(thoughts, heldout);
            (Comparable) eqv == 0 ? ["refuse", thoughts, 0, [[lg-cand-soft(), 0]]] : ["commit", thoughts, 1, [[lg-cand-soft(), 1]]];
        };
    };
    def lg-soft-status(s) = s[0];
    def lg-soft-thoughts(s) = s[1];
    def lg-soft-equivalent(s) = s[2];
    def lg-soft-events(s) = s[3];
    def lg-soft-commit?(s) = (String) lg-soft-status(s) == "commit" ? 1 : 0;
    def lg-observe-soft(prompt, proposal, heldout, prior) = {
        let struct = lg-think-all(prompt);
        len(struct) > 0 ? lg-observe(prompt, prior) : {
            let soft = lg-soft(proposal, heldout);
            let stream = lg-cat(prior, lg-soft-events(soft));
            [lg-soft-thoughts(soft), stream, ll-champion(stream), lg-values-line(lg-soft-thoughts(soft)), lg-soft-status(soft), lg-soft-equivalent(soft)];
        };
    };
    0;
}
