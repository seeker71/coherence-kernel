; duplex-frame-grid-band -- contract for the frame-synchronous duplex seat.
;
; Nine witnessed bits over the produced grid, power-of-two weights:
;     1  every frame whole -- three channels valued, silence is a value
;     2  the grid hears every user word, overlap included
;     4  the turn-gated ear (the cascade's) loses at least one of them
;     8  yield on barge-in within 6 frames (480 ms, the model's measure)
;    16  agent takes the turn within 6 frames of user speech-end
;    32  the tool window stays voiced -- on-hold speech in every frame
;    64  tool markers well-formed: one open, one close, one response, ordered
;   128  overlap actually happened (the scenario is not vacuous)
;   256  frame-synchronous: one output frame per input frame
; verdict: 511
; witnessed: 2026-08-25 -> 511
;
; preludes: form-stdlib/core.fk
; import "presence/duplex-frame-grid.fk"

(do
    (defn dfgb-bit (ok bit) (if ok bit 0))
    (defn duplex-frame-grid-band ()
        (do
            (let frames (dfg-run (dfg-user-stream)))
            (let sent (dfg-count-user-words frames))
            (let gated (dfg-count-gated-heard frames))
            (let open (dfg-first-tool-loop frames 0 (dfg-tool-open)))
            (let close (dfg-first-tool-loop frames 0 (dfg-tool-close)))
            (let response (dfg-first-tool-loop frames 0 (dfg-tool-response)))
            (add
                (add
                    (add
                        (dfgb-bit (eq (dfg-count-whole frames) (len frames)) 1)
                        (dfgb-bit (eq (dfg-count-words-in-stream (dfg-user-stream)) sent) 2))
                    (add
                        (dfgb-bit (lt gated sent) 4)
                        (dfgb-bit (lt (dfg-yield-frames frames)
                                      (add (dfg-latency-bound-frames) 1)) 8)))
                (add
                    (add
                        (dfgb-bit (lt (dfg-turn-take-frames frames)
                                      (add (dfg-latency-bound-frames) 1)) 16)
                        (dfgb-bit (eq (dfg-hold-voiced-loop frames 0 open response) 1) 32))
                    (add
                        (add
                            (dfgb-bit
                                (if (eq (dfg-count-tool frames (dfg-tool-open)) 1)
                                    (if (eq (dfg-count-tool frames (dfg-tool-close)) 1)
                                        (if (eq (dfg-count-tool frames (dfg-tool-response)) 1)
                                            (if (lt open close) (lt close response) 0)
                                            0)
                                        0)
                                    0)
                                64)
                            (dfgb-bit (gt (dfg-count-overlap frames) 0) 128))
                        (dfgb-bit (eq (len frames) (len (dfg-user-stream))) 256))))))

    (duplex-frame-grid-band))
