// Read complete events while the owner continues. Missing evidence remains null.
// preludes: learn/bml-practice-fit.bml
section [form.bml] {
 class BmlPracticeFitObservation {
  def bpo-events(path) {
   let parts = split-on(nsm-text(path),"\n");
   beo-events(take(len(parts) - 1,parts));
  }
  def bpo-last(rows) = nil?(rows) ? json-node-null() : rows[len(rows) - 1];
  def bpo-select(events,stage) = beo-kept-events(events,list(stage));
  def bpo-sum(rows,field) = nil?(rows) ? 0 : (nsm-num(head(rows),field) + bpo-sum(tail(rows),field));
  def bpo-have(rows,field) = nil?(rows) ? 1 : (json-object-has?(head(rows),field) && bpo-have(tail(rows),field));
  def bpo-total(rows,field) = json-node-pair(field,nil?(rows) || (!bpo-have(rows,field)) ? json-node-null() : json-precise-float(bpo-sum(rows,field)));
  def bpo-totals(rows,fields) = nil?(fields) ? list() : cons(bpo-total(rows,head(fields)),bpo-totals(rows,tail(fields)));
  def bpo-practice(event) {
   let health = oh-get(event,"health"); let needs = json-array-elements(oh-get(health,"needs"));
   nil?(needs) ? json-node-null() : nsm-json(nsm-at(nsm-str(oh-get(head(needs),"detail"),"path"),"reading.json"));
  }
  def bpo-streams(dir,contracts) = nil?(contracts) ? list() : cons(bpo-stream(dir,nsm-str(head(contracts),"id")),bpo-streams(dir,tail(contracts)));
  def bpo-stream(dir,id) {
   let stem = nsm-at(dir,id); let events = bpo-events(stem ++ ".events.jsonl");
   let stream = stem ++ ".stream"; let present = fs-exists?(stream);
   json-node-object(list(nsm-s("id",id),nsm-s("events",stem ++ ".events.jsonl"),nsm-n("stream_present",present),json-node-pair("stream_bytes",present ? json-node-int(file_size(stream)) : json-node-null()),nsm-n("response_retained",file_size(stem ++ ".response.json") > 0),json-node-pair("last_model_event",bpo-last(events))));
  }
  def bpo-read(home) {
   let out = nsm-at(home,"fit"); let source = nsm-at(out,"training-events.jsonl"); let events = bpo-events(source); let latest = bpo-last(events);
   let rounds = bpo-select(events,"round"); let rows = bpo-select(events,"row"); let observations = bpo-select(events,"practice-observed");
   let resultPath = nsm-at(out,"result.json"); let current = file_size(resultPath) > 0 ? nsm-json(resultPath) : json-node-null();
   let finished = json-object-has?(current,"rounds_this_admission"); let result = finished ? current : json-node-null();
   let status = json-node-object(list(nsm-n("observed_at_ms",now_unix_ms()),nsm-s("source",source),nsm-n("complete_events",len(events)),nsm-n("completed_updates",len(rounds)),nsm-n("completed_training_rows",len(rows)),nsm-n("completed_practice_observations",len(observations)),json-node-pair("last_event",latest),json-node-pair("last_event_age_ms",nil?(events) ? json-node-null() : json-node-int(host_monotonic_ms() - nsm-num(latest,"at_ms"))),json-node-pair("last_round",bpo-last(rounds)),json-node-pair("last_practice",finished ? oh-get(result,"practice") : bpo-practice(bpo-last(observations))),json-node-pair("round_totals",json-node-object(bpo-totals(rounds,list("input_tokens","supervised_tokens","tokenize_ms","training_ms","update_ms","checkpoint_ms","wall_ms")))),json-node-pair("completed_row_totals",json-node-object(bpo-totals(rows,list("forward_ms","backward_ms","forward_gpu_us","backward_gpu_us","dispatches")))),json-node-pair("result",result),nsm-s("accounting","Completed events only; the current in-flight row is not counted as completed. Round totals and row totals overlap.")));
   let detailed = oh-set(oh-set(oh-set(status,"admission",bpo-last(bpo-select(events,"admitted"))),"last_selected_response",bpo-last(bpo-select(events,"practice-response"))),"run",current);
   let generation = bpo-last(bpo-select(events,"practice-start")); let dir = nsm-str(generation,"evidence");
   oh-set(detailed,"latest_generation_streams",(String) dir == "" ? json-node-null() : json-node-array(bpo-streams(dir,json-array-elements(nsm-json(nsm-at(out,"contracts.json"))))));
  }
  def bpo-status(home) {
   let reading = bpo-read(home);
   print_str(json-emit-precise(reading) ++ "\n");
   reading;
  }
 }
 0;
}
