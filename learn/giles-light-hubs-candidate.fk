; giles-light-hubs-candidate.fk — the first Satsang-selected material enters
; as exact identity and semantic structure, not an irrevocable public copy.
;
; Source 13 in core-text-source-registry.fk carries the SHA-256 identity of the
; 92-line, 2854-byte member-supplied transcription. The full surface body is
; not present in the public tree. These rows paraphrase its structure and keep
; reported place claims, visionary claims, and practical proposals distinct.
;
; witnessed: 2026-07-26 -> 255 live fkwu
import "core-text-source-registry.fk"

(do
  (defn glh-source-id () 13)
  (defn glh-sha256 ()
    "5e3f9a1152dcd083014eb8ea291947268c1980d6417eb3e55ea74c7a2e112d1d")

  (defn glh-reported-place () 1)
  (defn glh-visionary () 2)
  (defn glh-practical () 3)

  ; place = [order,name,region,evidence]. Evidence is the transmission's
  ; reported or visionary status, never external verification.
  (defn glh-place (order name region evidence)
    (list order name region evidence))
  (defn glh-places ()
    (list
      (glh-place 1 "Hati Suci Sanctuary" "Bali" (glh-reported-place))
      (glh-place 2 "Cacao Forest" "Bali" (glh-reported-place))
      (glh-place 3 "Nacpan Beach" "Palawan, Philippines"
        (glh-reported-place))
      (glh-place 4 "future European hub" "Europe" (glh-visionary))))

  ; Practical proposals are paraphrased functional categories.
  (defn glh-practices ()
    (list
      "food forests"
      "medicinal plants"
      "plant farming"
      "wellbeing education"
      "land-based living"
      "qigong"
      "dance"
      "breath practice"
      "yoga"
      "barefoot silent walking"
      "silent spaces"
      "labyrinths"
      "bee sanctuaries"
      "sewage wormeries"
      "compost toilets"
      "village schools"
      "animal-care houses"
      "communal kitchens"))

  ; The smallest functional kernel carried by the transmission:
  ; a hub is land + community + nature + practice + service.
  (defn glh-core-kernel ()
    (list "land" "community" "nature" "practice" "service"))

  (defn glh-segment-count-loop (segments n)
    (if (eq (len segments) 0) n
      (glh-segment-count-loop (tail segments)
        (add n (if (eq (ctsr-seg-source (head segments))
          (glh-source-id)) 1 0)))))
  (defn glh-public-segment-count ()
    (glh-segment-count-loop (ctsr-segments) 0))

  (defn glh-witness ()
    (do
      (let source (ctsr-find (glh-source-id)))
      (add
        (if (not (nothing? source)) 1 0)
        (add
          (if (str_eq (ctsr-work source) "The Light Hubs") 2 0)
          (add
            (if (eq (str_len (glh-sha256)) 64) 4 0)
            (add
              (if (eq (len (glh-places)) 4) 8 0)
              (add
                (if (eq (len (glh-practices)) 18) 16 0)
                (add
                  (if (eq (len (glh-core-kernel)) 5) 32 0)
                  (add
                    (if (and
                      (eq (ctsr-content-state source)
                        (ctsr-content-metadata))
                      (eq (glh-public-segment-count) 0)) 64 0)
                    (if (and
                      (eq (ctsr-rights source)
                        (ctsr-rights-recorded-permission))
                      (eq (ctsr-protocol source)
                        (ctsr-protocol-community-review))) 128 0)))))))))
    )

  0)
