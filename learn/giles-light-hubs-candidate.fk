; giles-light-hubs-candidate.fk — the first Satsang-selected material enters
; as exact identity and a language-neutral semantic kernel, not an
; irrevocable public copy.
;
; Source 13 in core-text-source-registry.fk carries the SHA-256 identity of the
; 92-line, 2854-byte member-supplied transcription. The full surface body is
; not present in the public tree. Numeric facts paraphrase its structure and
; keep reported, visionary, phenomenological, and practical claims distinct.
;
; witnessed: 2026-07-26 -> 255 live fkwu
import "core-text-source-registry.fk"
import "../cognition/giles-light-hubs-neutral-kernel.fk"

(do
  (defn glh-source-id () 13)
  (defn glh-sha256 ()
    "5e3f9a1152dcd083014eb8ea291947268c1980d6417eb3e55ea74c7a2e112d1d")

  (defn glh-reported-place () (glhn-evidence-reported))
  (defn glh-visionary () (glhn-evidence-visionary))
  (defn glh-practical () (glhn-evidence-proposal))

  ; These accessors expose numeric semantic facts. EN/ID labels are projection
  ; evidence in the neutral kernel, never graph identity.
  (defn glh-places () (glhn-place-facts))
  (defn glh-practices () (glhn-practice-facts))
  (defn glh-core-kernel () (glhn-core-concepts))

  (defn glh-segment-count-loop (segments n)
    (if (eq (len segments) 0) n
      (glh-segment-count-loop (tail segments)
        (add n (if (eq (ctsr-seg-source (head segments))
          (glh-source-id)) 1 0)))))
  (defn glh-public-segment-count ()
    (glh-segment-count-loop (ctsr-segments) 0))

  (defn glh-witness ()
    (do
      (let source (ctsr-find (glh-source-id)))
      (add
        (if (not (nothing? source)) 1 0)
        (add
          (if (str_eq (ctsr-work source) "The Light Hubs") 2 0)
          (add
            (if (eq (str_len (glh-sha256)) 64) 4 0)
            (add
              (if (eq (len (glh-places)) 4) 8 0)
              (add
                (if (eq (len (glh-practices)) 18) 16 0)
                (add
                  (if (eq (len (glh-core-kernel)) 5) 32 0)
                  (add
                    (if (and
                      (eq (ctsr-content-state source)
                        (ctsr-content-neutral-kernel))
                      (and
                        (eq (glh-public-segment-count) 0)
                        (eq (glhn-structure-witness) 127))) 64 0)
                    (if (and
                      (eq (ctsr-rights source)
                        (ctsr-rights-recorded-permission))
                      (eq (ctsr-protocol source)
                        (ctsr-protocol-open))) 128 0)))))))))
    )

  0)
