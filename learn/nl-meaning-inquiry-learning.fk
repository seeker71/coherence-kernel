// nl-meaning-inquiry-learning.fk — train on natural-language paraphrases, map
// held-out predictions to neutral identities, and execute every inquiry lane.
import "nl-meaning-net.fk"
import "nl-meaning-corpus.fk"
import "../cognition/language-neutral-inquiry-induction.fk"
section [form.bml] {
    def nmil-d() = 32;
    def nmil-eps() = 0.00001;
    def nmil-proto-text(class-id) = (Comparable) class-id == 0 ? "may all be happy" : (Comparable) class-id == 1 ? "truth alone triumphs" : (Comparable) class-id == 2 ? "i am" : "peace for every world";
    def nmil-proto(class-id) = [class-id, nmn-vec-norm(nmil-proto-text(class-id), nmil-d())];
    def nmil-protos() = [nmil-proto(0), nmil-proto(1), nmil-proto(2), nmil-proto(3)];
    def nmil-drop(xs, n) = (Comparable) n == 0 || (Comparable) len(xs) == 0 ? xs : nmil-drop(xs[1:], n - 1);
    def nmil-training-raw() = nmc-concat(tb-take(nmc-class0(), 40), nmc-concat(tb-take(nmc-class1(), 40), nmc-concat(tb-take(nmc-class2(), 40), tb-take(nmc-class3(), 40))));
    def nmil-held-raw() = nmc-concat(nmil-drop(nmc-class0(), 40), nmc-concat(nmil-drop(nmc-class1(), 40), nmc-concat(nmil-drop(nmc-class2(), 40), nmil-drop(nmc-class3(), 40))));
    def nmil-encode-training(rows) = (Comparable) len(rows) == 0 ? [] : cons([nmn-vec-norm(nmc-ex-text(rows[0]), nmil-d()), nmil-proto(nmc-ex-class(rows[0]))[1]], nmil-encode-training(rows[1:]));
    // [correct predictions, evaluated rows, inquiry+replay successes].
    def nmil-evaluate(stack, rows, protos, acc) = (Comparable) len(rows) == 0 ? acc : {
        let row = rows[0];
        let predicted = nmn-classify(stack, nmn-vec-norm(nmc-ex-text(row), nmil-d()), protos, nmil-eps());
        let correct = (Comparable) predicted == nmc-ex-class(row) ? 1 : 0;
        let node = lnii-node-for-meaning((Number) 301 + (Number) predicted);
        let lanes = lnii-lanes-ok(lnii-subject(node), 0, 0);
        nmil-evaluate(stack, rows[1:], protos, [(Number) acc[0] + (Number) correct, (Number) acc[1] + (Number) 1, (Number) acc[2] + (Number) lanes]);
    };
    def nmil-witness() = {
        let raw-train = nmil-training-raw();
        let held = nmil-held-raw();
        let examples = nmil-encode-training(raw-train);
        let protos = nmil-protos();
        let initial = nmn-stack(nmil-d());
        let loss-before = nmn-corpus-loss(initial, examples, nmil-eps());
        let before = nmil-evaluate(initial, held, protos, [0, 0, 0]);
        let trained = nmn-train(initial, examples, 0.02, nmil-eps(), 40);
        let loss-after = nmn-corpus-loss(trained, examples, nmil-eps());
        let after = nmil-evaluate(trained, held, protos, [0, 0, 0]);
        let before-correct = before[0];
        let after-correct = after[0];
        let held-count = after[1];
        let inquiry-ok = after[2];
        let expected-inquiries = held-count * 7;
        let trace-before = [fb-frame(0, 1, 1), fb-frame(1, before-correct, 1)];
        let trace-after = [fb-frame(0, 1, 1), fb-frame(1, after-correct, 1)];
        let learning-divergence = diverge(trace-before, trace-after);
        framebuffer-clear();
        let event0 = fb_record(intern_trivial_int(before-correct), "nl-meaning-inquiry-learning.fk", 1);
        let event1 = fb_record(intern_trivial_int(after-correct), "nl-meaning-inquiry-learning.fk", 2);
        let event2 = fb_record(intern_trivial_int(inquiry-ok), "nl-meaning-inquiry-learning.fk", 3);
        let frames = len(framebuffer-events());
        // Loss is scaled only for compact observable output; comparison uses floats.
        [nothing(), 0, 1, 1001099003, len(raw-train), held-count, before-correct, after-correct, inquiry-ok, expected-inquiries, learning-divergence, frames, loss-after < loss-before && (after-correct > before-correct && (after-correct > held-count / 4 && ((Comparable) inquiry-ok == expected-inquiries && ((Comparable) learning-divergence == 1 && (Comparable) frames == 3)))) ? 1 : 0];
    };
    0;
}
