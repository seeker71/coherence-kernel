; work-replay-field.fk — the living view over the WORK-REPLAY ledger, computed fresh.
;
; No stored report: this fold reads learn/work-replay-rows.txt at ask time and re-answers,
; the way hdc-field-code is computed fresh from rows. The ledger keeps every row the loops
; ever landed (adding without forgetting — the stream fold's teaching); the current view
; folds the LATEST row per episode; the history depth is shown beside it. Salience is
; surprise-salience.fk's lane: ss-peak names the single loudest outcome, ss-count-salient
; counts what cleared the floor. Any kernel runs this — no GPU in the fold. An episode
; type no loop has carried yet prints as pending; pending is honest.
;
;   ./fkwu --src learn/work-replay-field.fk
;
; preludes: form-stdlib/core.fk learn/work-replay-sense.fk

(do
    (defn wrf-type-line (rows eps t)
        (do (let total (wrs-eps-count-of-type eps t 0))
            (let ran (wrs-rows-count-of-type rows t 0))
            (print (str_concat "  " (str_concat t
                (if (lt ran total)
                    (str_concat " sensed=pending(" (str_concat (int_to_str ran)
                        (str_concat "/" (str_concat (int_to_str total)
                        (str_concat " ran) rented=" (str_concat (int_to_str (wrs-eps-rented-of-type eps t 0))
                        (str_concat "/" (int_to_str total))))))))
                    (str_concat " sensed=" (str_concat (int_to_str (wrs-rows-sensed-of-type rows t 0))
                        (str_concat "/" (str_concat (int_to_str total)
                        (str_concat " rented=" (str_concat (int_to_str (wrs-eps-rented-of-type eps t 0))
                        (str_concat "/" (int_to_str total))))))))))))
            0))
    (defn wrf-type-lines (rows eps types)
        (if (eq (len types) 0) 0
            (do (wrf-type-line rows eps (head types))
                (wrf-type-lines rows eps (tail types)))))

    (defn wrf-sum-sensed (rows acc)
        (if (eq (len rows) 0) acc
            (wrf-sum-sensed (tail rows) (add acc (wrs-row-sensed (head rows))))))
    (defn wrf-sum-rented (eps acc)
        (if (eq (len eps) 0) acc
            (wrf-sum-rented (tail eps) (add acc (wrs-ep-rented (head eps))))))
    (defn wrf-sum-retried (rows acc)
        (if (eq (len rows) 0) acc
            (wrf-sum-retried (tail rows)
                (add acc (if (gt (wrs-row-attempts (head rows)) 1) 1 0)))))

    (let eps (wrs-episodes))
    (let history (wrs-ledger-rows))
    (let rows (wrs-latest-rows history))
    (print "work-replay field (folded fresh from the living rows)")
    (wrf-type-lines rows eps (wrs-types))
    (print (str_concat "  total sensed=" (str_concat (int_to_str (wrf-sum-sensed rows 0))
        (str_concat "/" (str_concat (int_to_str (len rows))
        (str_concat " of " (str_concat (int_to_str (len eps))
        (str_concat " episodes; rented=" (str_concat (int_to_str (wrf-sum-rented eps 0))
        (str_concat "/" (str_concat (int_to_str (len eps))
        (str_concat "; history_depth=" (int_to_str (len history))))))))))))))
    (print (str_concat "  fed_back=" (int_to_str (wrf-sum-retried rows 0))))
    (let surprises (wrs-surprises rows))
    (print (str_concat "  salient=" (int_to_str (ss-count-salient surprises (wrs-salience-floor)))))
    (let peak (ss-peak surprises))
    (if (gt (len peak) 0)
        (print (str_concat "  peak=" (str_concat (nth peak 0)
            (str_concat ":" (int_to_str (ss-mag peak))))))
        (print "  peak=none (no rows yet)"))
    0)
