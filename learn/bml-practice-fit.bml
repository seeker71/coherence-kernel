   print_str(json-emit-precise(report) ++ "\n");
   report;
  }
  def bpf-prepare(home,teacher,parent,rate) {
   let manifest = bso-manifest(home); let dir = nsm-at(home,teacher); let condition = nsm-json(nsm-at(dir,"condition.json")); let out = nsm-at(home,"fit");
   fs-exists?(out) || (!((String) nsm-str(condition,"kind") == "practice")) ? form_error("Fit needs fresh output and verified teacher practice") : bpf-prepare-ready(home,dir,out,manifest,parent,rate);
  }
  def bpf-prepare-ready(home,dir,out,manifest,parent,rate) {
