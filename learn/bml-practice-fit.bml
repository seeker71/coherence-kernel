// Practice deepens until its generated behavior works, or an actual care signal stops it.
// One admission shares mutable LoRA tensors and Adam state across all rounds.
// Transfer tests are never read by this loop. Serving pointers remain caller-owned.
// preludes: learn/bml-scalar-observation.bml
section [form.bml] {
 class BmlPracticeFit {
  def bpf-compact(s,i,acc) = i >= str_len(s) ? acc : bpf-compact(s,i + 1,str_find(" \n\r\t",substring(s,i,i + 1),0) >= 0 ? acc : acc ++ substring(s,i,i + 1));
  def bpf-name-char(c) = str_find("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-?",c,0) >= 0;
  def bpf-number(s,i) = i >= str_len(s) ? (i > 0) : ((str_find("0123456789",substring(s,i,i + 1),0) >= 0) && bpf-number(s,i + 1));
  def bpf-word(word,allowed) = ((String) word == "") || (nsm-has(allowed,word) || bpf-number(word,0));
  def bpf-words(s,i,word,allowed) = i >= str_len(s) ? bpf-word(word,allowed) : bpf-char(s,i,word,allowed,substring(s,i,i + 1));
  def bpf-char(s,i,word,allowed,c) = bpf-name-char(c) ? bpf-words(s,i + 1,word ++ c,allowed) : ((str_find(" \n\r\t(),;=",c,0) >= 0) && (bpf-word(word,allowed) && bpf-words(s,i + 1,"",allowed)));
  def bpf-tail-calls(s,name,start) {
   let call = str_find(s,name ++ "(",start); let shape = name ++ "(tail(xs))";
   call < 0 ? 1 : (((String) substring(s,call,call + str_len(shape)) == shape) && bpf-tail-calls(s,name,call + str_len(shape)));
  }
  // This exercise's scalar-list contract: one pure declaration, an empty-list
  // base case, and structurally decreasing recursive calls. Other BML surfaces
  // need their own caller checker; they are not executed by this practice door.
  def bpf-pure(code,name) {
   let s = bpf-compact(code,0,""); let prefix = "def" ++ name ++ "(xs)=ifeq(len(xs),0)then";
   let branch = str_find(s,"else",str_len(prefix));
   let base = branch < 0 ? "" : substring(s,str_len(prefix),branch);
   let allowed = list("def",name,"xs","if","then","else","len","eq","gt","lt","head","tail","nothing?","nothing","add","sub","mul");
   bpf-words(code,0,"",allowed) && (((String) substring(s,0,str_len(prefix)) == prefix) && ((((String) base == "0") || ((String) base == "nothing()")) && (((Comparable) str_find(s,";",0) == (str_len(s) - 1)) && bpf-tail-calls(s,name,str_len(prefix)))));
  }
  def bpf-target(dir,row) {
   let id = nsm-str(row,"id"); let response = nsm-json(nsm-at(dir,id ++ ".response.json")); let answer = nsm-str(response,"text");
   let prompt = bso-context() ++ nsm-str(row,"prompt");
   let inputBound = ((String) nsm-str(response,"prompt_sha256") == nsm-hash(prompt)) && (((String) nsm-text(nsm-at(dir,id ++ ".prompt")) == prompt) && ((String) nsm-text(nsm-at(dir,id ++ ".proposal")) == answer));
   let target = oh-set(oh-set(oh-set(row,"answer",json-node-string(answer)),"completion",json-node-string(answer)),"reference",json-node-string(nsm-at(dir,id ++ "-execution")));
   bpf-pure(answer,id) && (inputBound && (((String) nsm-str(response,"reason") == "") && beo-reference-valid(target))) ? target : form_error("Teacher target needs the caller's pure contract and bound successful native execution");
  }
  def bpf-targets(dir,rows) = nil?(rows) ? list() : cons(bpf-target(dir,head(rows)),bpf-targets(dir,tail(rows)));
  def bpf-enqueue-row(home,session,row) = !beo-reference-valid(row) ? form_error("Native teacher execution changed before session retention") : nsm-record(home,session,nsm-str(row,"id"),"native-code",nsm-str(row,"prompt"),nsm-str(row,"completion"),"verified-answer",nsm-str(row,"reference"),0);
  def bpf-enqueue-rows(home,session,rows) = nil?(rows) ? list() : cons(bpf-enqueue-row(home,session,head(rows)),bpf-enqueue-rows(home,session,tail(rows)));
  def bpf-enqueue(home,teacher) {
   let manifest = bso-manifest(home); let dir = nsm-at(home,teacher); let condition = nsm-json(nsm-at(dir,"condition.json"));
   !((String) nsm-str(condition,"kind") == "practice") ? form_error("Only verified teacher practice enters session learning") : bpf-enqueue-ready(home,dir,manifest);
  }
  def bpf-enqueue-ready(home,dir,manifest) {
   let targets = bpf-targets(dir,beo-rows(manifest,"practice"));
   let session = "bml-local-teacher:" ++ nsm-hash(nsm-text(nsm-at(home,"manifest.json")) ++ nsm-text(nsm-at(dir,"generation.json")));
   let paths = bpf-enqueue-rows(hearth-session-learning(),session,targets);
