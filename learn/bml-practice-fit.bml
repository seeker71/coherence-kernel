   let bound = json-node-object(list(nsm-s("teacher",dir),nsm-s("teacher_reading_sha256",nsm-hash(nsm-text(nsm-at(dir,"reading.json")))),nsm-s("train_sha256",nsm-hash(text)),nsm-s("request_sha256",nsm-hash(json-emit-precise(request))),nsm-s("contracts_sha256",nsm-hash(nsm-text(nsm-at(out,"contracts.json")))),nsm-s("parent",parent),nsm-s("parent_seal",nsl-adapter-seal(parent)),nsm-s("base_seal",nsl-base-seal(nsm-model())),nsm-n("evaluation_gradients",0)));
   let boundSaved = nsm-write(nsm-at(out,"binding.json"),bound);
   nsm-write(nsm-at(out,"request.json"),request);
  }
  def bpf-check(dir,row) {
   let id = nsm-str(row,"id"); let response = nsm-json(nsm-at(dir,id ++ ".response.json"));
   let pure = bpf-pure(nsm-str(response,"text"),id); let complete = (String) nsm-str(response,"reason") == "";
   let checked = pure && complete ? beo-code(dir,row,response) : json-node-object(list(nsm-n("verified",0),nsm-s("execution","not-run; generated declaration does not meet the caller's pure scalar-list contract")));
   let reading = oh-set(oh-set(oh-set(checked,"id",json-node-string(id)),"pure_contract",json-node-int(pure)),"stop_reason",json-node-string(nsm-str(response,"reason")));
   let saved = nsm-write(nsm-at(dir,id ++ ".reading.json"),reading);
   let shown = print_str(json-emit-precise(reading) ++ "\n");
   reading;
  }
  def bpf-checks(dir,rows) = nil?(rows) ? list() : cons(bpf-check(dir,head(rows)),bpf-checks(dir,tail(rows)));
  def bpf-ready(rows) = nil?(rows) ? 1 : (((Comparable) nsm-num(head(rows),"verified") == 1) && bpf-ready(tail(rows)));
  def bpf-observe(session,out,contracts,round,step) {
   let dir = nsm-at(out,"practice-" ++ int_to_str(step) ++ "-" ++ int_to_str(host_monotonic_ms())); let made = fs-mkdir(dir); let start = host_monotonic_ms();
   let announced = ntr-event(out,"practice-start",list(nsm-n("optimizer_step",step),nsm-n("round",round),nsm-s("evidence",dir),nsm-n("contracts",len(contracts))));
   let responses = beo-generate-rows(dir,session,contracts,""); let checks = bpf-checks(dir,contracts);
   let reading = json-node-object(list(nsm-n("round",round),nsm-n("optimizer_step",step),nsm-n("ready",bpf-ready(checks)),nsm-s("evidence",dir),nsm-s("adapter",nll-adapter(head(session))),nsm-n("wall_ms",host_monotonic_ms() - start),json-node-pair("responses",json-node-array(responses)),json-node-pair("checks",json-node-array(checks))));
   let saved = nsm-write(nsm-at(dir,"reading.json"),reading);
   reading;
  }
  def bpf-model-at(model,checkpoint) = append(take(5,model),list(nsm-json(nsm-at(checkpoint,"adapter_config.json")),checkpoint));
  def bpf-regressed(before,after) = nil?(before) ? list() : nil?(after) || (!((String) nsm-str(head(before),"id") == nsm-str(head(after),"id"))) ? form_error("Update pressure lost its prior observation identity") : ((Comparable) nsm-num(head(before),"verified") == 1) && (!((Comparable) nsm-num(head(after),"verified") == 1)) ? cons(json-node-string(nsm-str(head(after),"id")),bpf-regressed(tail(before),tail(after))) : bpf-regressed(tail(before),tail(after));
  def bpf-pressure-rate(rate,regressed) = rate / (1 + len(regressed));
  def bpf-attune(r,observation) {
   let previousPath = nsm-str(r,"practice_observation_path");
   let previous = (String) previousPath == "" ? json-node-null() : nsm-json(previousPath);
   let regressed = bpf-regressed(beo-rows(previous,"checks"),beo-rows(observation,"checks"));
   let currentPath = nsm-at(nsm-str(observation,"evidence"),"reading.json");
   let rate = ntr-get(r,"learning_rate"); let nextRate = bpf-pressure-rate(rate,regressed);
   let detail = json-node-object(list(nsm-s("before",previousPath),nsm-s("after",currentPath),nsm-s("before_sha256",(String) previousPath == "" ? "" : nsm-hash(nsm-text(previousPath))),nsm-s("after_sha256",nsm-hash(nsm-text(currentPath))),json-node-pair("newly_unmet",json-node-array(regressed)),nsm-real("prior_learning_rate",rate),nsm-real("learning_rate",nextRate),nsm-s("policy","Divide update size by one plus the count of previously passing functions that now fail")));
   let health = oh-reading("native-bml-learning",ntr-get(r,"output"),"update-interference",json-node-int(0),json-node-int(len(regressed)),json-node-int(nil?(regressed)),nil?(regressed) ? list() : list(oh-need("smaller-update",oh-reference(currentPath))),list("continue-update-size","reduce-update-size"),oh-reference(currentPath));
   let selected = nil?(regressed) ? "continue-update-size" : "reduce-update-size";
   let voiced = ntr-health-event(ntr-get(r,"output"),"pressure-observed",health,list(json-node-pair("reading",detail)));
   let response = oh-response(health,selected); let incoming = ntr-health-event(ntr-get(r,"output"),"pressure-response",response,list());
