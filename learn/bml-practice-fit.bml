   let applied = ntr-health-event(ntr-get(r,"output"),"pressure-applied",oh-applied(health,choice,json-node-object(list(nsm-real("learning_rate",appliedRate)))),list());
   oh-set(oh-set(r,"learning_rate",json-precise-float(appliedRate)),"practice_observation_path",json-node-string(currentPath));
  }
  def bpf-loop(session,state,r,rows,contracts,step,round) {
   let out = ntr-get(r,"output"); let observation = bpf-observe(session,out,contracts,round,step); let ready = nsm-num(observation,"ready");
   let attuned = bpf-attune(r,observation);
