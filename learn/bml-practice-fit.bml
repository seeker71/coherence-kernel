  }
  def bpf-needed(contracts,checks) = (Comparable) len(contracts) != len(checks) ? form_error("Practice attention needs every caller observation") : nil?(contracts) ? list() : bpf-needed-row(contracts,checks);
  def bpf-needed-row(contracts,checks) {
