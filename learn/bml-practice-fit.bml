  def bpf-target-ids(rows) = nil?(rows) ? list() : cons(json-node-string(nsm-str(head(rows),"id")),bpf-target-ids(tail(rows)));
  def bpf-update(session,state,r,rows,contracts,step,round,health,selected,observation) {
   !((String) selected == "rehearse-verified-practice") ? list(step,round,"retained-without-update",json-node-null()) : bpf-focus(session,state,r,rows,contracts,step,round,health,observation,bpf-needed(contracts,beo-rows(observation,"checks")));
