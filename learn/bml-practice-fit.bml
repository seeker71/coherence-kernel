   let health = oh-reading("native-bml-learning",out,"generated-practice",json-node-int(1),json-node-int(ready),json-node-int(ready),ready ? list() : list(oh-need("executable-BML-practice",oh-reference(nsm-str(observation,"evidence")))),list("rehearse-verified-practice","retain-practice-ready","retain-checkpoint"),oh-reference(nsm-at(out,"binding.json")));
