; homecoming-work-census.fk — what the rented mind actually did these two weeks, and which
; lane can carry each kind of work offline. A census the body can read, in the shape
; switch-census.fk taught: rows, a number, and the reason beside each number.
;
; WHY. Urs, 2026-08-09: "how are we bringing all the remote oracle requests home to offline?"
; The answer starts with a requirements document: 199 receipts landed between 2026-07-25 and
; 2026-08-09, each one a task the rented mind performed. This cell holds that census, maps each
; task type to the local lane that can carry it today, names what is missing, and carries the
; first witnessed slice: ten frontier questions from the distillation corpus, re-asked offline
; through the dense Metal lanes, scored against the rented answers already on record.
;
; HOW THE CENSUS WAS TAKEN. Every receipt filename and opening lines in the window were read
; (2026-08-09) and each receipt assigned ONE primary type. Classification is a judgement and is
; meant to be argued with; the receipt list is not. Cross-cutting and counted separately: the
; window also landed 117 corpus rows (880..996) and every receipt closed with prose drafting —
; those two run through every type rather than beside them.
;
; THE SLICE-ELIGIBILITY READING, learned while choosing the ten: a large share of recent corpus
; answers are words this body COINED in-session (tickblind, floorspoke, askalike, ...). A coined
; word is unanswerable by construction — no other mind can guess a word that did not exist — so
; re-answering is only a measurement on rows whose answer predates the session. The ten below
; all carry dictionary answers, verified against the corpus by the band (never copied by hand:
; questions and answers are read from hdc-row-for-id at run time, the bp-table mirror teaching).
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk
;
; Proven by: learn/tests/homecoming-work-census-band.fk

(do
    ; ---- the census, read, not estimated -------------------------------------------------
    ; row: (type window-count carrier-today missing sequence-step)
    ;   type          — what the rented mind was doing
    ;   window-count  — receipts in 2026-07-25..2026-08-09 with this primary type
    ;   carrier-today — the offline lane that can hold this work now (or "body-alone")
    ;   missing       — the one thing between here and fully offline
    ;   sequence-step — order in the homecoming walk (1 = first)
    (defn hwc-task (type count carrier missing step) (list type count carrier missing step))
    (defn hwc-tasks () (list
        (hwc-task "write-form-cell-or-port-home" 62
            "kat-coder-whole-forward + qwen25-coder-32b dense lane; bands and preflight are the safety net"
            "the work loop: propose-cell -> preflight -> band -> red lines fed back until green" 4)
        (hwc-task "diagnose-defect-to-root" 44
            "deepseek-r1-32b dense lane proposes; the body's instruments (preflight, framebuffer, metal_status) answer"
            "the same work loop with instrument readings as the retrieval" 5)
        (hwc-task "performance-climb-derive-floor" 31
            "body-alone measures (metal_status, bands); a lane proposes the next rung over the measured table"
            "a rung-planner prompt over measurements; the loop again" 5)
        (hwc-task "knowledge-inquiry-through-the-body" 28
            "rag-retrieve over the body's own corpus + qwen25-72b or llama3b dense lane"
            "receipts/ and learn/ embedded into the rag index; answers that cite rows" 3)
        (hwc-task "census-survey-audit" 17
            "body-alone: grep, fsh, band folds — no model in the loop at all"
            "nothing structural; a standing sweep cell so the rented mind stops being the scheduler" 1)
        (hwc-task "coordination-reunion" 7
            "body-alone: the reunion protocol cells; git is mechanical"
            "nothing structural; renumbering already has a written practice" 1)
        (hwc-task "review-judge-verdict" 6
            "form-cli-judge tallies + a dense lane as the grader"
            "a judge driver in the slice-run shape, wired to dsr1q32" 2)
        (hwc-task "ask-lane-infra" 4
            "ask-lane-router + the dense-run family; this census's slice drivers"
            "one ask door that takes a prompt and returns text as a value — the slice wrapper is it" 1)))
    (defn hwc-type    (r) (nth r 0))
    (defn hwc-count   (r) (nth r 1))
    (defn hwc-carrier (r) (nth r 2))
    (defn hwc-missing (r) (nth r 3))
    (defn hwc-step    (r) (nth r 4))

    (defn hwc-sum-loop (rs acc)
        (if (eq (len rs) 0) acc (hwc-sum-loop (tail rs) (add acc (hwc-count (head rs))))))
    (defn hwc-total () (hwc-sum-loop (hwc-tasks) 0))
    (defn hwc-window-receipts () 199)   ; ls receipts/ | grep -E '2026-(07-2[5-9]|07-3[01]|08-0[1-9])' | wc -l
    (defn hwc-window-corpus-rows () 117) ; hdc rows with date-int in the window, counted 2026-08-09

    ; ---- the first slice: frontier questions re-asked offline ---------------------------
    ; Ten corpus rows in the window whose answers are dictionary words. The drivers
    ; (form/native/metal/homecoming-slice-run-*.fk) read each row from the corpus, ask the
    ; question through a dense Metal lane, and score the text with hwc-hit?. The hit rate is
    ; the finding either way: it is the measured distance between the local fleet and the
    ; rented mind on the corpus's own task.
    (defn hwc-slice-ids () (list 880 884 885 886 887 893 894 903 909 916))

    ; join corpus question tokens back into a sentence
    (defn hwc-join (xs acc)
        (if (eq (len xs) 0) acc
            (hwc-join (tail xs)
                (if (eq (str_len acc) 0) (head xs) (str_concat acc (str_concat " " (head xs)))))))
    ; the ask, spoken as a completion the base lanes can finish
    (defn hwc-prompt-for (qtokens)
        (str_concat "Question: " (str_concat (hwc-join qtokens "")
            "? Answer: the single word for this is \"")))

    ; ---- scoring: does the lane's text carry the recorded answer? -----------------------
    ; ASCII lowering + substring. A hit is the recorded answer-word OR the fresh-word
    ; appearing anywhere in the generated text (fresh covers hyphenated answers spoken
    ; apart: "normalization of deviance" carries deviance, not deviance-normalization).
    (defn hwc-lower-byte (b) (if (and (ge b 65) (le b 90)) (add b 32) b))
    (defn hwc-lower-loop (s i n acc)
        (if (ge i n) acc
            (hwc-lower-loop s (add i 1) n
                (str_concat acc (byte_to_str (hwc-lower-byte (str_byte_at s i)))))))
    (defn hwc-lower (s) (hwc-lower-loop s 0 (str_len s) ""))
    (defn hwc-contains? (hay needle)
        (if (ge (str_find (hwc-lower hay) (hwc-lower needle) 0) 0) 1 0))
    ; drop one trailing e so an inflected surface still meets its stem — witnessed need:
    ; the R1-32B lane answered "winsorizing" against the recorded "winsorize" (2026-08-09)
    ; and exact substring called that a miss. winsoriz- is the shared stem; one byte is the
    ; whole tolerance, deliberately no wider.
    (defn hwc-stem (w)
        (if (and (gt (str_len w) 3) (eq (str_byte_at w (sub (str_len w) 1)) 101))
            (substring w 0 (sub (str_len w) 1)) w))
    (defn hwc-hit? (text answer fresh)
        (if (eq (hwc-contains? text answer) 1) 1
            (if (eq (hwc-contains? text fresh) 1) 1
                (hwc-contains? text (hwc-stem answer)))))
    (defn hwc-hits-loop (pairs acc)
        (if (eq (len pairs) 0) acc
            (do (let p (head pairs))
                (hwc-hits-loop (tail pairs)
                    (add acc (hwc-hit? (nth p 0) (nth p 1) (nth p 2)))))))
    ; pairs: list of (text answer fresh)
    (defn hwc-hits (pairs) (hwc-hits-loop pairs 0))

    ; ---- the sequence to all-of-it-offline, stated where a reader meets it --------------
    (defn hwc-sequence () (list
        "1 land the ask wrapper + this benchmark; move census and coordination off the rented mind"
        "2 wire form-cli-judge to the dsr1q32 lane; local answers get local grades"
        "3 embed receipts/ and learn/ with the local embedder; inquiry answers cite the body"
        "4 the work loop v1: a lane proposes a cell, preflight and the band answer, red lines feed back"
        "5 the same loop with instruments as retrieval carries diagnosis and the floor climbs"
        "6 a homecoming ratchet beside sc-ceiling: the offline-carried share may only grow"))

    0)
