// Read the exact target decisions hidden by an average practice loss.
// Targets come from verified practice. This observes logits, never gradients.
// preludes: learn/bml-practice-fit.bml
section [form.bml] {
 class BmlTokenObservation {
  def bto-find(rows,id) = nil?(rows) ? form_error("Token observation requires a practice case") : (String) nsm-str(rows[0],"id") == id ? rows[0] : bto-find(rows[1:],id);
  def bto-positions(model,tk,forward,one,targets,mask,index,rows) {
   index >= len(targets) ? reverse(rows) : mask[index] <= 0 ? bto-positions(model,tk,forward,one,targets,mask,index + 1,rows) : bto-position(model,tk,forward,one,targets,mask,index,rows);
  }
  def bto-position(model,tk,forward,one,targets,mask,index,rows) {
   let vocab = model[0][5]; let copied = nll-last(forward[0],one,vocab,index * vocab);
   let predicted = nll-select(one,vocab); let target = targets[index];
   let row = json-node-object([nsm-n("position",index),nsm-n("target_id",target),nsm-n("predicted_id",predicted),nsm-n("matched",(Comparable) target == predicted),nsm-s("target_piece",nlt-decode-id(tk,target)),nsm-s("predicted_piece",nlt-decode-id(tk,predicted))]);
   bto-positions(model,tk,forward,one,targets,mask,index + 1,cons(row,rows));
  }
  def bto-errors(rows) = nil?(rows) ? [] : (Comparable) nsm-num(rows[0],"matched") == 1 ? bto-errors(rows[1:]) : cons(rows[0],bto-errors(rows[1:]));
  def bto-run(home,teacher,label,adapter,id) {
   let manifest = bso-manifest(home); let row = bpf-target(nsm-at(home,teacher),bto-find(beo-rows(manifest,"practice"),id));
   let dir = nsm-at(nsm-at(home,"token-observations"),label); let selected = nag-resolve(adapter);
   fs-exists?(dir) || (((String) selected == "") || (!fs-exists?(nsm-at(selected,"adapter_config.json")))) ? form_error("Token observation needs fresh evidence and an explicit available adapter") : bto-open(dir,row,selected);
  }
  def bto-open(dir,row,adapter) {
   let root = fs-mkdir(fs-path-dirname(dir)); let made = fs-mkdir(dir); let start = host_monotonic_ms();
   let binding = json-node-object([nsm-s("case",nsm-str(row,"id")),nsm-s("adapter",adapter),nsm-s("adapter_seal",nsl-adapter-seal(adapter)),nsm-s("base_seal",nsl-base-seal(nsm-model())),nsm-s("prompt_sha256",nsm-hash(nsm-str(row,"prompt"))),nsm-s("completion_sha256",nsm-hash(nsm-str(row,"completion"))),nsm-s("reference",nsm-str(row,"reference"))]);
   let saved = nsm-write(nsm-at(dir,"condition.json"),binding);
   let session = nlg-open-at(nsm-model(),adapter,nsm-at(dir,"admission.events.jsonl")); let admittedAt = host_monotonic_ms();
   (!((String) nll-adapter(session[0]) == adapter)) || (nll-pair-count(session[0][1]) <= 0) ? bto-unadapted(session) : bto-owned(session,dir,row,binding,start,admittedAt);
  }
  def bto-unadapted(session) {
   let closed = nlg-close(session);
   form_error("Token observation did not admit its selected LoRA tensors");
  }
  def bto-owned(session,dir,row,binding,start,admittedAt) {
   let model = session[0]; let tk = session[1];
   let sample = nld-prepare(tk,nld-lines(nsl-lines(bep-pairs([row]))),1)[0];
   let admitted = ntr-admit(model,sample); let ctx = nll-context(model,len(sample[0])); let preparedAt = host_monotonic_ms();
   let forward = nll-forward(model,ctx,sample[0],0,1); let forwardedAt = host_monotonic_ms(); let one = nam-alloc(model[0][5]);
   let positions = bto-positions(model,tk,forward,one,sample[1],sample[2],0,[]); let readAt = host_monotonic_ms(); let errors = bto-errors(positions);
   let pairs = nll-pair-count(model[1]); let freed = nam-free([one]); let forwardClosed = nll-forward-close(forward); let ctxClosed = nll-context-close(ctx); let closed = nlg-close(session);
   let identity = [nsm-s("case",nsm-str(row,"id")),nsm-s("model",nsm-model()),nsm-s("adapter",nsm-str(binding,"adapter")),nsm-n("lora_pairs",pairs),nsm-n("adapter_unchanged",(String) nsm-str(binding,"adapter_seal") == nsl-adapter-seal(nsm-str(binding,"adapter")))];
   let measured = [nsm-n("input_tokens",len(sample[0])),nsm-n("supervised_tokens",len(positions)),nsm-n("teacher_forced_wrong_argmax",len(errors)),nsm-n("retained_buffers",metal_live()[2]),nsm-n("admission_and_binding_ms",admittedAt - start),nsm-n("prepare_ms",preparedAt - admittedAt),nsm-n("forward_ms",forwardedAt - preparedAt),nsm-n("target_read_ms",readAt - forwardedAt),nsm-n("release_ms",host_monotonic_ms() - readAt),nsm-n("wall_ms",host_monotonic_ms() - start),nsm-n("training_updates",0),nsm-n("generated_tokens",0),nsm-n("remote_model_calls",0)];
   let reading = json-node-object(append(identity,append(measured,[json-node-pair("positions",json-node-array(positions))])));
   let saved = nsm-write(nsm-at(dir,"reading.json"),reading);
   let healthy = (Comparable) len(errors) == 0;
   let health = oh-reading("native-bml-learning",dir,"teacher-forced-decisions",json-node-int(0),json-node-int(len(errors)),json-node-int(healthy),healthy ? [] : [oh-need("target-decision-practice",oh-reference(nsm-at(dir,"reading.json")))],["retain-reading","rehearse-unmet-practice"],oh-reference(nsm-at(dir,"reading.json")));
   let event = nsm-event(dir,"decisions-observed",[json-node-pair("health",health)]);
   print_str(json-emit-precise(json-node-object([nsm-s("reading",nsm-at(dir,"reading.json")),nsm-n("supervised_tokens",len(positions)),nsm-n("wrong_argmax",len(errors))])) ++ "\n");
   reading;
  }
 }
 0;
}
