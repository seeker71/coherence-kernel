; zh-summary-eval.fk — the PRE-REGISTERED metric for rung 6 of the voice receipt,
; written before any comparison is run so it cannot be shaped to a result.
;
; preludes: form-stdlib/core.fk
;
; WHY THIS EXISTS. receipts/2026-06-29-native-zh-summary-PENDING.md rung 6 asks
; that the native summary be witnessed at least as good as the best rented model,
; and marks itself **blocked — no eval metric**, with the reason stated plainly:
; "until a metric is pre-registered ... 'earns observed' is a fake-in-waiting.
; Blocked, not shaped." A metric invented after seeing the outputs is not a
; measurement; it is a story told about numbers already in hand. So the rule is
; fixed here, in a cell with a band, while the native zh output does not yet
; exist to tempt it.
;
; THE RULE, FIXED NOW.
;   · Held-out items only — axiom -> summary pairs the native lane never trained on.
;   · Both lanes' outputs are scored in ONE batch, lane labels hidden from the
;     judge. Blindness is a PROTOCOL fact this cell cannot verify by computing;
;     it is carried as a flag the caller asserts, and an unblind batch earns
;     nothing however the scores fall. Saying that out loud is the honest floor —
;     a cell that pretended to check blindness would be the fake it guards against.
;   · Two axes per output, faithfulness and fluency, each 0..5 from the judge.
;   · At least ze-floor items, so a single lucky pair cannot carry it.
;   · Native earns it when its total REACHES the rented total — ge, not gt. A tie
;     is earned on purpose: the claim under test is "at least as good", and
;     demanding better-than would be a different claim than the one written.
;
; WHAT WOULD MAKE THIS CELL A FAKE, and the band's answer. A rule that answers
; "earned" whatever the numbers say is learn/benchbench.fk's bb-tag-constant-green
; and rates 0 there; learn/deadgreen.fk names the shape. So the band does not only
; ask whether a winning batch is earned — it asks whether a LOSING batch is
; earns nothing, whether an unblind one earns nothing, whether a short one earns
; nothing, and whether the reading moves between win and loss at all. Four of its
; ten bits exist to catch this cell answering in the body's favour whatever comes.
;
; Scoring is integers 0..5 summed — no ratios, no floats, so the reading is the
; same on every kernel and cannot drift at a decimal place.
;
; Proven by learn/tests/zh-summary-eval-band.fk.
; witnessed: 2026-08-14 -> band 1023 four-way (fkwu / Go / Rust / TS)

(do
    ; ---- one held-out item: both lanes scored on both axes ----
    (defn ze-item (nat-faith nat-flu rent-faith rent-flu)
        (list nat-faith nat-flu rent-faith rent-flu))
    (defn ze-nat  (i) (add (nth i 0) (nth i 1)))
    (defn ze-rent (i) (add (nth i 2) (nth i 3)))

    ; ---- batch folds ----
    (defn ze-sum-nat (b)  (if (eq (len b) 0) 0 (add (ze-nat  (head b)) (ze-sum-nat  (tail b)))))
    (defn ze-sum-rent (b) (if (eq (len b) 0) 0 (add (ze-rent (head b)) (ze-sum-rent (tail b)))))

    ; ---- the pre-registered floor: how many held-out items before any claim ----
    (defn ze-floor () 20)
    (defn ze-enough? (b) (if (ge (len b) (ze-floor)) 1 0))

    ; ---- THE RULE. blind and long enough and reaching, or nothing. ----
    (defn ze-earned? (b blind)
        (if (eq blind 1)
            (if (eq (ze-enough? b) 1)
                (if (ge (ze-sum-nat b) (ze-sum-rent b)) 1 0)
                0)
            0))

    ; ---- fixtures: batches built to a length, so no reading is a literal's size ----
    (defn ze-rep (n item) (if (eq n 0) (empty) (cons item (ze-rep (sub n 1) item))))
    (defn ze-win-item ()  (ze-item 4 4 3 4))   ; native 8, rented 7
    (defn ze-lose-item () (ze-item 3 3 4 4))   ; native 6, rented 8
    (defn ze-tie-item ()  (ze-item 4 3 3 4))   ; native 7, rented 7
    (defn ze-win-batch ()  (ze-rep 20 (ze-win-item)))
    (defn ze-lose-batch () (ze-rep 20 (ze-lose-item)))
    (defn ze-tie-batch ()  (ze-rep 20 (ze-tie-item)))
    (defn ze-short-batch () (ze-rep 19 (ze-win-item)))   ; winning, one item short

    ; ---- the instrument's own liveness: the reading moves between win and loss ----
    (defn ze-rule-moves? ()
        (if (eq (ze-earned? (ze-win-batch) 1) (ze-earned? (ze-lose-batch) 1)) 0 1))
    0)
