; core-text-source-registry.fk — source doors before source bodies.
;
; This registry starts the core-text ingest with exact editions, exact rights
; doors, and explicit protocol state. It does not equate "publicly reachable",
; "public domain", and "community-authorized for a derived corpus".
;
; A source row is:
;   [id, slug, work, tradition/community, language, script, age-band,
;    edition/contributor, content-uri, rights-kind, rights-uri, rights-scope,
;    collective-interest, protocol, content-state, translation-group,
;    witnessed-epoch]
;
; Rights:
;   0 unknown, 1 public-domain, 2 CC0, 3 CC-BY, 4 CC-BY-SA,
;   5 limited/non-commercial/no-derivatives, 6 closed,
;   7 exact recorded permission
; Protocol:
;   0 unresolved, 1 open-for-this-exact-edition, 2 community-review,
;   3 steward-declines-dataset/AI, 4 no-merge-or-scrape, 5 per-item-check
; Content state:
;   0 metadata-only, 1 one exact seed segment is present below
; Collective interest:
;   0 no specific collective-interest gate identified for this edition,
;   1 Indigenous/traditional collective authority is required,
;   2 a living religious/cultural steward has expressed an applicable intent
;
; The first six exact editions carry one small public-domain seed segment.
; Segment text excludes web footnote markers and normalizes line breaks to
; spaces; the edition URI and locator preserve the route back to the source.
; Metadata-only rows are genuine intake receipts but are not text admission.
; witnessed source pages and the honest limitations live in
; receipts/2026-07-26-core-text-36-layer-ingest.md.

(do
  (defn ctsr-rights-unknown () 0)
  (defn ctsr-rights-public-domain () 1)
  (defn ctsr-rights-cc0 () 2)
  (defn ctsr-rights-cc-by () 3)
  (defn ctsr-rights-cc-by-sa () 4)
  (defn ctsr-rights-limited () 5)
  (defn ctsr-rights-closed () 6)
  (defn ctsr-rights-recorded-permission () 7)

  (defn ctsr-protocol-unresolved () 0)
  (defn ctsr-protocol-open () 1)
  (defn ctsr-protocol-community-review () 2)
  (defn ctsr-protocol-no-dataset () 3)
  (defn ctsr-protocol-no-merge () 4)
  (defn ctsr-protocol-per-item () 5)

  (defn ctsr-content-metadata () 0)
  (defn ctsr-content-seed () 1)

  (defn ctsr-source
    (id slug work tradition language script age edition content-uri
      rights rights-uri rights-scope collective protocol content-state
      translation-group epoch)
    (list id slug work tradition language script age edition content-uri
      rights rights-uri rights-scope collective protocol content-state
      translation-group epoch))

  (defn ctsr-id (s) (nth s 0))
  (defn ctsr-slug (s) (nth s 1))
  (defn ctsr-work (s) (nth s 2))
  (defn ctsr-tradition (s) (nth s 3))
  (defn ctsr-language (s) (nth s 4))
  (defn ctsr-script (s) (nth s 5))
  (defn ctsr-age (s) (nth s 6))
  (defn ctsr-edition (s) (nth s 7))
  (defn ctsr-content-uri (s) (nth s 8))
  (defn ctsr-rights (s) (nth s 9))
  (defn ctsr-rights-uri (s) (nth s 10))
  (defn ctsr-rights-scope (s) (nth s 11))
  (defn ctsr-collective (s) (nth s 12))
  (defn ctsr-protocol (s) (nth s 13))
  (defn ctsr-content-state (s) (nth s 14))
  (defn ctsr-translation-group (s) (nth s 15))
  (defn ctsr-epoch (s) (nth s 16))

  (defn ctsr-sources ()
    (list
      (ctsr-source 1 "tao-teh-king-legge-1891"
        "The Tao Teh King, or the Tao and its Characteristics"
        "Chinese Taoist" "en" "latin" "late-warring-states"
        "Laozi; translated by James Legge, 1891; Project Gutenberg 216"
        "https://www.gutenberg.org/cache/epub/216/pg216.txt"
        (ctsr-rights-public-domain)
        "https://www.gutenberg.org/ebooks/216"
        "public-domain-in-USA; jurisdiction-recheck-owed"
        0 (ctsr-protocol-open) (ctsr-content-seed) 1 20260726)

      (ctsr-source 2 "babylonian-legends-budge-1921"
        "The Babylonian Legends of the Creation"
        "Babylonian and Assyrian" "en" "latin" "second-millennium-bce"
        "E. A. Wallis Budge, 1921; Project Gutenberg 9914"
        "https://www.gutenberg.org/cache/epub/9914/pg9914.html.utf8"
        (ctsr-rights-public-domain)
        "https://www.gutenberg.org/policy/permission"
        "public-domain-in-USA; jurisdiction-recheck-owed"
        0 (ctsr-protocol-open) (ctsr-content-seed) 2 20260726)

      (ctsr-source 3 "world-english-bible-genesis"
        "Genesis 1:1"
        "Hebrew Bible / Christian Bible" "en" "latin" "first-millennium-bce"
        "World English Bible Classic; eBible.org"
        "https://ebible.org/eng-web/GEN01.htm"
        (ctsr-rights-public-domain)
        "https://ebible.org/eng-web/copyright.htm"
        "publisher-declared-public-domain"
        0 (ctsr-protocol-open) (ctsr-content-seed) 100 20260726)

      (ctsr-source 4 "louis-segond-1910-genese"
        "Genesis 1:1"
        "Hebrew Bible / Christian Bible" "fr" "latin" "first-millennium-bce"
        "Louis Segond 1910; eBible.org"
        "https://ebible.org/fraLSG/GEN01.htm"
        (ctsr-rights-public-domain)
        "https://ebible.org/fraLSG/copyright.htm"
        "publisher-declared-public-domain"
        0 (ctsr-protocol-open) (ctsr-content-seed) 100 20260726)

      (ctsr-source 5 "reina-valera-1909-genesis"
        "Genesis 1:1"
        "Hebrew Bible / Christian Bible" "es" "latin" "first-millennium-bce"
        "Reina Valera 1909; eBible.org"
        "https://ebible.org/spaRV1909/GEN01.htm"
        (ctsr-rights-public-domain)
        "https://ebible.org/spaRV1909/copyright.htm"
        "publisher-declared-public-domain"
        0 (ctsr-protocol-open) (ctsr-content-seed) 100 20260726)

      (ctsr-source 6 "delitzsch-hebrew-genesis"
        "Genesis 1:1"
        "Hebrew Bible / Christian Bible" "he" "hebrew" "first-millennium-bce"
        "Modern Hebrew Bible attributed to Franz Delitzsch; eBible.org"
        "https://ebible.org/heb/GEN01.htm"
        (ctsr-rights-public-domain)
        "https://ebible.org/heb/copyright.htm"
        "publisher-declared-public-domain"
        0 (ctsr-protocol-open) (ctsr-content-seed) 100 20260726)

      ; Legally public-domain in the US, but this 1908 English mediation is not
      ; treated as K'iche community authority. Metadata enters; text waits.
      (ctsr-source 7 "popol-vuh-spence-1908"
        "The Popol Vuh: The Mythic and Heroic Sagas of the Kiches"
        "K'iche' Maya" "en" "latin" "pre-columbian-oral-seventeenth-century-record"
        "Lewis Spence, 1908; Project Gutenberg 56550"
        "https://www.gutenberg.org/ebooks/56550"
        (ctsr-rights-public-domain)
        "https://www.gutenberg.org/policy/permission"
        "public-domain-in-USA; jurisdiction-recheck-owed"
        1 (ctsr-protocol-community-review) (ctsr-content-metadata) 7 20260726)

      ; AILLA exposes open metadata, while media may be public, embargoed, or
      ; controlled. No collection/item rights were selected, so text waits.
      (ctsr-source 8 "ailla-catalog"
        "Archive of the Indigenous Languages of Latin America"
        "many Indigenous communities of Latin America" "many" "many" "living"
        "AILLA catalog; per-depositor and per-item access"
        "https://ailla.utexas.org/"
        (ctsr-rights-unknown)
        "https://ailla.utexas.org/"
        "per-item"
        1 (ctsr-protocol-per-item) (ctsr-content-metadata) 8 20260726)

      ; FirstVoices explicitly forbids scraping, merging, and republication
      ; without community authority. The refusal is part of the body.
      (ctsr-source 9 "firstvoices-catalog"
        "FirstVoices community language sites"
        "contributing First Nations language communities" "many" "many" "living"
        "community-owned FirstVoices content"
        "https://www.firstvoices.com/"
        (ctsr-rights-limited)
        "https://www.firstvoices.com/conditions-of-use"
        "site-terms"
        1 (ctsr-protocol-no-merge) (ctsr-content-metadata) 9 20260726)

      ; SuttaCentral's own material is CC0 and root texts are public domain,
      ; while its current licensing page asks that content not be scraped or
      ; used to create generative-AI datasets. Legal openness is not consent.
      (ctsr-source 10 "suttacentral-catalog"
        "Early Buddhist texts, translations, and parallels"
        "Buddhist traditions and SuttaCentral contributors" "many" "many"
        "first-millennium-bce-and-later"
        "SuttaCentral source and translation catalog"
        "https://suttacentral.net/"
        (ctsr-rights-cc0)
        "https://suttacentral.net/licensing"
        "CC0-material-varies-by-contributor; steward-request-applies"
        2 (ctsr-protocol-no-dataset) (ctsr-content-metadata) 10 20260726)

      ; African Storybook licenses vary by story (including non-commercial).
      ; The platform is a source catalog until an exact story is witnessed.
      (ctsr-source 11 "african-storybook-catalog"
        "African Storybook"
        "African authors, illustrators, translators, and communities"
        "many" "many" "living"
        "African Storybook; exact license and attribution vary by story"
        "https://africanstorybook.org/"
        (ctsr-rights-unknown)
        "https://africanstorybook.org/terms.html"
        "per-story"
        0 (ctsr-protocol-per-item) (ctsr-content-metadata) 11 20260726)

      ; StoryWeaver's books are CC-BY 4.0, but this row is catalog metadata.
      ; An exact book plus author/illustrator/translator attribution is owed.
      (ctsr-source 12 "storyweaver-catalog"
        "StoryWeaver multilingual storybooks"
        "Pratham Books and attributed creators/translators"
        "many" "many" "living"
        "StoryWeaver books; CC-BY 4.0; audiovisual works differ"
        "https://storyweaver.org.in/en/open-content"
        (ctsr-rights-cc-by)
        "https://storyweaver.org.in/en/open-content"
        "CC-BY-4.0-books; audiovisual-terms-differ"
        0 (ctsr-protocol-open) (ctsr-content-metadata) 12 20260726)

      ; Hati Suci's first selected material is identified exactly by the hash
      ; of the member-supplied transcription. The initiating member reports
      ; Giles' permission for quotation, reproduction, translation, open-AI
      ; reasoning/training use, and attribution, with revision/withdrawal.
      ; No direct signed author artifact is present. The initiating member
      ; records no additional sacred/cultural/community-use restrictions.
      ; No additional benefit/reciprocity is required. Freshness remains under
      ; no scheduled review with re-witness on change. The initiating member
      ; reports final Satsang ratification. A revocable carrier remains open.
      (ctsr-source 13 "giles-light-hubs-transmission"
        "The Light Hubs"
        "Hati Suci Satsang / Giles" "en" "latin" "living"
        "Giles; member-supplied transcription; original date/carrier and full attribution owed"
        "urn:sha256:5e3f9a1152dcd083014eb8ea291947268c1980d6417eb3e55ea74c7a2e112d1d"
        (ctsr-rights-recorded-permission)
        "urn:permission:giles-light-hubs:member-witnessed:20260726"
        "quote+reproduce+translate+open-ai-reasoning+ai-training; attribution=Giles; revise+withdraw; community-restrictions=none; benefit=none; freshness=no-scheduled-review; re-witness=on-change; final-satsang-ratification=member-witnessed; full-body-needs-revocable-carrier"
        1 (ctsr-protocol-open) (ctsr-content-metadata) 13 20260726)))

  (defn ctsr-find-loop (sources id)
    (if (eq (len sources) 0) (nothing)
      (if (eq (ctsr-id (head sources)) id) (head sources)
        (ctsr-find-loop (tail sources) id))))
  (defn ctsr-find (id) (ctsr-find-loop (ctsr-sources) id))

  ; A segment is [source-id, segment-id, translation-group, locator,
  ;               language, edition-bound surface text].
  ; Translation-group membership proposes alignment; it never asserts that
  ; translations are identical or that any one language owns the meaning.
  (defn ctsr-segment (source id group locator language text)
    (list source id group locator language text))
  (defn ctsr-seg-source (s) (nth s 0))
  (defn ctsr-seg-id (s) (nth s 1))
  (defn ctsr-seg-group (s) (nth s 2))
  (defn ctsr-seg-locator (s) (nth s 3))
  (defn ctsr-seg-language (s) (nth s 4))
  (defn ctsr-seg-text (s) (nth s 5))

  (defn ctsr-segments ()
    (list
      (ctsr-segment 1 1 1 "chapter-1.1" "en"
        "The Tao that can be trodden is not the enduring and unchanging Tao.")
      (ctsr-segment 2 1 2 "first-tablet.1-3" "en"
        "When the heavens above were yet unnamed, And the name of the earth beneath had not been recorded, Apsu, the oldest of beings, their progenitor,")
      (ctsr-segment 3 1 100 "genesis-1.1" "en"
        "In the beginning, God created the heavens and the earth.")
      (ctsr-segment 4 1 100 "genesis-1.1" "fr"
        "Au commencement, Dieu créa les cieux et la terre.")
      (ctsr-segment 5 1 100 "genesis-1.1" "es"
        "EN el principio crió Dios los cielos y la tierra.")
      (ctsr-segment 6 1 100 "genesis-1.1" "he"
        "בראשית ברא אלהים את השמים ואת הארץ׃")))

  0)
