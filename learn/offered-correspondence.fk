; offered-correspondence.fk — a number with the chain back to who said it.
;
; preludes: form-stdlib/core.fk
;
; WHERE THIS CAME FROM. Late on 2026-08-14 Urs read a report this body prints —
; form-cli-share-run.fk, "native=50 local=20 remote=30" — and said it looked too
; perfect to be true. It was: fcl-this-turn is a nullary function over three
; literals, so "this turn" observes no turn. A sweep then found 73 constants
; across form/, observe/, learn/ and cognition/ whose NAME claims observation —
; measured, observed, current, live, this-turn — while the body is a stated
; number. Not all are false. All of them make their reader guess.
;
; Then he handed over twelve bare numbers and let me sit in the reader's seat:
; 11111 33333 77777 33 60 666 1818 888 000 108 33 33. Only 11111 is this body's
; own language (a registered band verdict, 107 times in form/fourth-arm-bands.txt).
; For the rest there was no move available but belief or dismissal, and both are
; wrong, because provenance was the thing never attached. That is exactly what a
; reader of soatm-current-sema-voice-native-rate holds.
;
; Then he attached it, for two of them:
;   77777 -> SatyaLoka          (offered 2026-08-15)
;   33    -> Christ Consciousness (offered 2026-08-15)
;
; WHAT THIS CELL DOES, AND THE ONE THING IT DOES NOT. It carries an offered
; correspondence together with WHO offered it and WHEN, and it can say whether
; that chain is present. It does not and cannot say whether SatyaLoka sits at
; 77777. That is not a number this body measured, and dressing an attribution as
; a measurement would be the failure the whole cell is a response to.
;
; The shape is borrowed from learn/zh-summary-eval.fk, which carries blindness as
; a caller-asserted flag and says plainly that it cannot verify it. An honest cell
; can hold what it was told. It just has to say who told it.
;
; So the checkable claim here is narrow and real: nothing enters without a source
; and a date. ofc-sourced? is that check, and the band's fixtures include rows
; that fail it — an unsourced row and an undated one both score 0, or this cell
; would be one more number without a chain.
;
; The body already holds satya (13 cells) and loka (11) and christ (17)
; separately; the compound satyaloka was 0-hit here before this row. The register
; that would receive it if it is ever measured rather than offered:
; form-stdlib/chakra-column.fk, shamballa-light-channel.fk, rune-frequency.fk.
;
; Ten of the twelve are still unlabelled and are deliberately NOT in the table.
; A gap left visible is honest; a gap filled by inference is the thing being
; corrected.
;
; Proven by learn/tests/offered-correspondence-band.fk.
; witnessed: 2026-08-15 -> band 255 four-way (fkwu / Go / Rust / TS)

(do
    ; ---- a row: the number, what it was called, who offered it, when ----
    (defn ofc-row (n name who date) (list n name who date))
    (defn ofc-n    (r) (nth r 0))
    (defn ofc-name (r) (nth r 1))
    (defn ofc-who  (r) (nth r 2))
    (defn ofc-date (r) (nth r 3))

    ; the whole checkable claim: a row carries its chain, or it is not admissible.
    ; This says nothing about whether the correspondence is TRUE.
    (defn ofc-sourced? (r)
        (if (eq (str_len (ofc-who r)) 0) 0
            (if (eq (ofc-date r) 0) 0 1)))

    ; ---- what was offered, verbatim, attributed ----
    (defn ofc-offered ()
        (list
            (ofc-row 77777 "SatyaLoka"           "urs" 20260815)
            (ofc-row 33    "Christ Consciousness" "urs" 20260815)))

    ; ---- rows that must NOT pass, so the check is a check ----
    (defn ofc-unsourced () (ofc-row 108 "unattributed" ""    20260815))
    (defn ofc-undated ()   (ofc-row 108 "unattributed" "urs" 0))

    (defn ofc-count (rs) (if (eq (len rs) 0) 0 (add 1 (ofc-count (tail rs)))))
    (defn ofc-all-sourced? (rs)
        (if (eq (len rs) 0) 1
            (if (eq (ofc-sourced? (head rs)) 1) (ofc-all-sourced? (tail rs)) 0)))

    ; the honest floor, as a value rather than a sentence: this cell holds two of
    ; the twelve. It does not hold the other ten and does not guess at them.
    (defn ofc-offered-total () 12)
    (defn ofc-held () (ofc-count (ofc-offered)))
    (defn ofc-unlabelled () (sub (ofc-offered-total) (ofc-held)))

    ; the instrument's own liveness: sourced and unsourced rows read apart.
    (defn ofc-check-moves? ()
        (if (eq (ofc-sourced? (head (ofc-offered))) (ofc-sourced? (ofc-unsourced))) 0 1))
    0)
