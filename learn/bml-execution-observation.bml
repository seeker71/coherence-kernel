// Generation, execution and learning remain separately observable actions.
// A caller inspects generated code before requesting execution of its tests.
// preludes: learn/bml-execution-practice.bml learn/bml-compact-practice.bml form-stdlib/native-session-learning.bml form-stdlib/bml/form-agent-json-query.bml
section [form.bml] {
 class BmlExecutionObservation {
  def beo-curriculum(manifest) = ((String) nsm-str(manifest,"schema") == "native-bml-compact-v1") ? list("learn/bml-compact-practice.bml",bcp-training(),bcp-tests()) : list("learn/bml-execution-practice.bml",bep-training(),bep-tests());
  def beo-manifest(home) {
   let manifest = nsm-json(nsm-at(home,"manifest.json")); let curriculum = beo-curriculum(manifest);
   let source = (String) nsm-str(manifest,"source_sha256") == nsm-hash(nsm-text(head(curriculum)));
   let rows = beo-bound-rows(beo-rows(manifest,"practice"),curriculum[1]) && beo-bound-rows(beo-rows(manifest,"test"),curriculum[2]);
   !(source && rows) ? form_error("BML curriculum changed after preparation; prepare a fresh comparison") : manifest;
  }
  def beo-rows(manifest,field) = json-array-elements(json-object-get(manifest,field));
  def beo-bound-fields(row,reference) = list("id","prompt","answer","checks","expected","kind") |> all?(f => (String) nsm-str(row,f) == nsm-str(reference,f));
  def beo-bound-rows(rows,references) = ((Comparable) len(rows) == len(references)) && (0 .. len(rows) |> all?(i => beo-bound-fields(rows[i],references[i])));
  def beo-condition(home,label) = nsm-at(home,label);
  // An answer is one definition: the cap grows toward a sentence end and stops at the voice's reach, so a row that never ends is kept as it stands.
  def beo-limit() = 1024;
  def beo-generate(home,label,adapter) {
   let manifest = beo-manifest(home); let dir = beo-condition(home,label);
   fs-exists?(dir) ? form_error("BML generation condition already exists; preserve its observations") : beo-generate-fresh(home,dir,adapter,manifest);
  }
  def beo-generate-fresh(home,dir,adapter,manifest) = beo-generate-context(home,dir,adapter,manifest,"");
  def beo-adapter-seal(adapter) = (String) adapter == "" ? "no-adapter" : nsl-adapter-seal(adapter);
  def beo-generate-context(home,dir,adapter,manifest,context) {
   let made = fs-mkdir(dir); let start = host_monotonic_ms(); let seal = beo-adapter-seal(adapter);
   let unassisted = ((String) value_kind(context) == "string") && ((String) context == "");
   let scope = unassisted ? "fresh compositions; supplied contracts and syntax; no RAG, answer hints or intervening training" : "assisted practice on the same compositions; executed practice references supplied; no test answers or intervening training";
   let contextText = (String) value_kind(context) == "string" ? context : json-emit-precise(context);
   let kept = nag-write(nsm-at(dir,"context.txt"),contextText);
   let admitted = nsm-write(nsm-at(dir,"condition.json"),json-node-object(list(nsm-s("model",nsm-model()),nsm-s("adapter",adapter),nsm-s("adapter_seal",seal),nsm-s("manifest_sha256",nsm-hash(nsm-text(nsm-at(home,"manifest.json")))),nsm-s("context_sha256",nsm-hash(contextText)),nsm-s("scope",scope))));
   let rows = beo-generate-owned(dir,nlg-open-at(nsm-model(),adapter,nsm-at(dir,"admission.events.jsonl")),beo-rows(manifest,"test"),context);
   let unchanged = (String) seal == beo-adapter-seal(adapter);
   let report = json-node-object(list(nsm-s("adapter",adapter),nsm-n("adapter_unchanged",unchanged),nsm-n("wall_ms",host_monotonic_ms() - start),nsm-n("remote_model_calls",0),nsm-n("training_updates",0),nsm-n("retained_buffers",metal_live()[2]),json-node-pair("responses",json-node-array(rows))));
   nsm-write(nsm-at(dir,"generation.json"),report);
  }
  def beo-generate-owned(dir,session,rows,context) {
   defer nlg-close(session);
   beo-generate-rows(dir,session,rows,context);
  }
  def beo-generate-rows(dir,session,rows,context) = rows |> map(row => beo-generate-row(dir,session,row,context));
  def beo-generate-row(dir,session,row,context) {
   let id = nsm-str(row,"id"); let stem = nsm-at(dir,id);
   let selectedContext = (String) value_kind(context) == "string" ? context : nsm-str(context,id);
   let prompt = selectedContext ++ nsm-str(row,"prompt");
   let saved = nag-write(stem ++ ".prompt",prompt); let start = host_monotonic_ms();
   let announced = print_str("generating=" ++ id ++ "\n");
   let answer = nlg-ask(session,prompt,beo-limit(),stem ++ ".stream",stem ++ ".cancel",stem ++ ".events.jsonl");
   let result = json-node-object(list(nsm-s("id",id),nsm-s("text",head(answer)),nsm-s("reason",answer[1]),nsm-n("tokens",answer[2]),nsm-n("wall_ms",host_monotonic_ms() - start),nsm-s("prompt_sha256",nsm-hash(prompt))));
   let saved = nsm-write(stem ++ ".response.json",result);
   let wrote = nag-write(stem ++ ".proposal",head(answer));
   let shown = print_str("generated=" ++ id ++ " tokens=" ++ int_to_str(answer[2]) ++ "\n");
   result;
  }
  def beo-example(row) = !beo-reference-valid(row) ? form_error("BML context reference is not execution-bound") : "Executed repository example:\n" ++ nsm-str(row,"prompt") ++ "\nVerified answer:\n" ++ nsm-str(row,"completion") ++ "\n\n";
  def beo-practice-context(rows) = (rows |> foldl((text,row) => text ++ beo-example(row),"")) ++ "Now solve the following task. Return only the requested output.\n";
  def beo-ground(home,label,adapter) {
   let manifest = beo-manifest(home); let dir = beo-condition(home,label);
   fs-exists?(dir) ? form_error("BML assisted condition already exists; preserve its observations") : beo-generate-context(home,dir,adapter,manifest,beo-practice-context(beo-rows(manifest,"practice")));
  }
  def beo-compiler-feedback(dir,rows) = rows |> foldl((text,row) => text ++ beo-case-feedback(dir,row),"");
  def beo-diagnostic-lines(lines) = 0 .. len(lines) |> foldl((text,i) => i == 0 ? lines[0] : text ++ "\n" ++ lines[i],"");
  def beo-case-feedback(dir,row) {
   let id = nsm-str(row,"id"); let reading = nsm-json(nsm-at(dir,id ++ ".reading.json"));
   (!((String) nsm-str(row,"kind") == "code")) || ((Comparable) nsm-num(reading,"verified") == 1) ? "" : beo-failed-code(dir,id,reading);
  }
  def beo-failed-code(dir,id,reading) {
   let response = nsm-json(nsm-at(dir,id ++ ".response.json"));
   let execution = oh-get(reading,"execution");
   let diagnostic = beo-diagnostic-lines(take(3,split-on(nsm-str(execution,"stderr"),"\n")));
   let result = (Comparable) nsm-num(execution,"exit") == 0 ? "It compiled but did not satisfy the caller checks." : "Compiler exit " ++ int_to_str(nsm-num(execution,"exit")) ++ ":\n" ++ diagnostic;
   "Prior local attempt for " ++ id ++ ":\n" ++ nsm-str(response,"text") ++ "\nObserved feedback: " ++ result ++ "\nRevise the attempt using the executed examples and the task contract.\n\n";
  }
  def beo-feedback(home,label,adapter,parent) {
   let manifest = beo-manifest(home); let dir = beo-condition(home,label); let prior = beo-condition(home,parent);
   let source = nsm-json(nsm-at(prior,"condition.json"));
   let bound = (String) nsm-str(source,"manifest_sha256") == nsm-hash(nsm-text(nsm-at(home,"manifest.json")));
   (!bound) || (!fs-exists?(nsm-at(prior,"reading.json"))) ? form_error("BML feedback requires a graded condition on the same manifest") : fs-exists?(dir) ? form_error("BML feedback condition already exists") : beo-feedback-ready(home,dir,adapter,manifest,prior);
  }
  def beo-feedback-ready(home,dir,adapter,manifest,prior) {
   let feedback = beo-compiler-feedback(prior,beo-rows(manifest,"test"));
   let context = feedback ++ beo-practice-context(beo-rows(manifest,"practice"));
   let made = fs-mkdir(dir);
   let saved = nsm-write(nsm-at(dir,"feedback-source.json"),json-node-object(list(nsm-s("condition",prior),nsm-s("reading_sha256",nsm-hash(nsm-text(nsm-at(prior,"reading.json")))),nsm-s("kind","assisted local repair; no test answer targets"))));
   beo-generate-context(home,dir,adapter,manifest,context);
  }
  def beo-rag-options(query,rows) = rows |> map(row => beo-rag-option(query,row));
  def beo-rag-option(query,row) {
   let features = re-semantic-features(nsm-str(row,"prompt")); let common = nse-common(query,features);
   let score = nil?(common) ? 0.0 : ((1.0 * len(common)) / ((len(query) + len(features)) - len(common)));
   oh-set(oh-set(row,"feature_overlap",json-precise-float(score)),"matched_features",json-node-array(oh-strings(common)));
  }
  def beo-focus-rows(prior,rows,practice) = rows |> map(row => beo-focus-row(prior,row,practice));
  def beo-focus-row(prior,row,practice) {
   let options = beo-rag-options(re-semantic-features(nsm-str(row,"prompt")),practice);
   let selected = nse-best(options,0,list());
   let context = beo-case-feedback(prior,row) ++ beo-practice-context(selected);
   json-node-object(list(nsm-s("id",nsm-str(row,"id")),nsm-s("context",context),json-node-pair("offered",json-node-array(options)),json-node-pair("selected",json-node-array(selected))));
  }
  def beo-context-pairs(rows) = rows |> map(row => nsm-s(nsm-str(row,"id"),nsm-str(row,"context")));
  def beo-focus(home,label,adapter,parent) {
   let manifest = beo-manifest(home); let dir = beo-condition(home,label); let prior = beo-condition(home,parent);
   let source = nsm-json(nsm-at(prior,"condition.json"));
   let bound = (String) nsm-str(source,"manifest_sha256") == nsm-hash(nsm-text(nsm-at(home,"manifest.json")));
   (!bound) || (!fs-exists?(nsm-at(prior,"reading.json"))) ? form_error("BML focus requires a graded condition on the same manifest") : fs-exists?(dir) ? form_error("BML focused condition already exists") : beo-focus-ready(home,dir,adapter,manifest,prior);
  }
  def beo-focus-ready(home,dir,adapter,manifest,prior) {
   let selected = beo-focus-rows(prior,beo-rows(manifest,"test"),beo-rows(manifest,"practice"));
   let made = fs-mkdir(dir);
   let saved = nsm-write(nsm-at(dir,"retrieval.json"),json-node-object(list(nsm-s("parent",prior),nsm-s("method","native RAG semantic features; shared-over-union; strongest with ties; only this case feedback"),json-node-pair("cases",json-node-array(selected)))));
   beo-generate-context(home,dir,adapter,manifest,json-node-object(beo-context-pairs(selected)));
  }
  def beo-array-text(raw) {
   let start = str_find(raw,"[",0); let end = start < 0 ? -1 : str_find(raw,"]",start);
   (start < 0) || (end < start) ? "" : substring(raw,start,end + 1);
  }
  def beo-matches(expected,actual) = len(0 .. len(expected) |> filter(i => i < len(actual) ? (String) json-emit-precise(expected[i]) == json-emit-precise(actual[i]) : 0));
  def beo-prediction(row,response) {
   let raw = nsm-str(response,"text"); let format = faj-valid(raw); let array = format ? raw : beo-array-text(raw); let valid = faj-valid(array);
   let expected = json-array-elements(parse-json("reference-output",nsm-str(row,"completion")));
   let actual = valid ? json-array-elements(parse-json("model-prediction",array)) : list();
   let correct = beo-matches(expected,actual);
   json-node-object(list(nsm-n("verified",format && (((Comparable) len(expected) == len(actual)) && ((Comparable) correct == len(expected)))),nsm-n("format_valid",format),nsm-n("correct",correct),nsm-n("checks",len(expected)),json-node-pair("expected",json-node-array(expected)),json-node-pair("observed",json-node-array(actual))));
  }
  def beo-code(dir,row,response) {
   let target = nsm-at(dir,nsm-str(row,"id") ++ "-execution"); let made = fs-mkdir(target);
   let result = bep-execute(target,bep-wrap(nsm-str(response,"text"),nsm-str(row,"checks")));
   let valid = ((Comparable) nsm-num(result,"exit") == 0) && ((String) bep-first-line(result) == nsm-str(row,"expected"));
   let assistance = json-object-has?(response,"transport") ? nsm-str(response,"transport") : "none; exact proposal enclosed by caller test wrapper";
   json-node-object(list(nsm-n("verified",valid),json-node-pair("execution",result),nsm-s("evidence",target),nsm-s("assistance",assistance)));
  }
  def beo-grade-row(home,dir,row) {
   let id = nsm-str(row,"id"); let response = nsm-json(nsm-at(dir,id ++ ".response.json"));
   let reading = (String) nsm-str(row,"kind") == "prediction" ? beo-prediction(row,response) : beo-code(dir,row,response);
   let report = oh-set(oh-set(reading,"id",json-node-string(id)),"stop_reason",json-node-string(nsm-str(response,"reason")));
   let saved = nsm-write(nsm-at(dir,id ++ ".reading.json"),report);
   let passed = ((Comparable) nsm-num(report,"verified") == 1) && ((String) nsm-str(response,"reason") == "");
   let retained = nsm-experience(hearth-session-learning(),home,fs-path-basename(dir) ++ "/" ++ id,"bml-execution-evaluation",nsm-str(row,"prompt"),nsm-str(response,"text"),passed ? "caller-contract-satisfied" : "caller-contract-needs-practice",nsm-at(dir,id ++ ".reading.json"),1);
   let health = oh-reading("native-bml-ability",dir,id,json-node-int(1),json-node-int(passed),json-node-int(passed),passed ? list() : list(oh-need("execution-grounded-practice",oh-reference(nsm-at(dir,id ++ ".reading.json")))),list("retain-observation","rehearse-related-semantics"),oh-reference(nsm-at(dir,id ++ ".reading.json")));
   let observed = nsm-event(home,"ability-observed",list(json-node-pair("health",health)));
   let responseEvent = oh-response(health,"retain-observation"); let selected = oh-select(health,responseEvent,"defer");
   let received = nsm-event(home,"ability-response",list(json-node-pair("health",responseEvent)));
   let applied = nsm-event(home,"ability-applied",list(json-node-pair("health",oh-applied(health,selected,json-node-object(list(nsm-s("experience",retained),nsm-n("assessment_gradients",0)))))));
   report;
  }
  def beo-grade-rows(home,dir,rows) = rows |> map(row => beo-grade-row(home,dir,row));
  def beo-grade(home,label) {
   let dir = beo-condition(home,label); let manifest = beo-manifest(home); let condition = nsm-json(nsm-at(dir,"condition.json"));
   let generation = nsm-json(nsm-at(dir,"generation.json"));
   let complete = ((Comparable) nsm-num(generation,"adapter_unchanged") == 1) && ((Comparable) len(json-array-elements(oh-get(generation,"responses"))) == len(beo-rows(manifest,"test")));
   !complete ? form_error("BML grading requires completed generation with its adapter unchanged") : fs-exists?(nsm-at(dir,"reading.json")) ? form_error("BML condition is already graded; retain its reading") : !((String) nsm-str(condition,"manifest_sha256") == nsm-hash(nsm-text(nsm-at(home,"manifest.json")))) ? form_error("BML test manifest changed after generation") : beo-grade-bound(home,dir,manifest);
  }
  def beo-grade-bound(home,dir,manifest) {
   let rows = beo-grade-rows(home,dir,beo-rows(manifest,"test"));
   let report = json-node-object(list(nsm-s("condition",dir),nsm-n("observed_at_ms",now_unix_ms()),json-node-pair("cases",json-node-array(rows))));
   let saved = nsm-write(nsm-at(dir,"reading.json"),report);
   print_str("reading=" ++ nsm-at(dir,"reading.json") ++ "\n");
   beo-show-cases(rows);
   report;
  }
  def beo-show-cases(rows) = rows |> foldl((shown,row) => shown + beo-show-case(row),0);
  def beo-show-case(row) {
   let common = list(nsm-s("id",nsm-str(row,"id")),json-node-pair("verified",oh-get(row,"verified")),nsm-s("stop_reason",nsm-str(row,"stop_reason")));
   let details = json-object-has?(row,"execution") ? list(json-node-pair("execution_exit",oh-get(oh-get(row,"execution"),"exit"))) : list(json-node-pair("format_valid",oh-get(row,"format_valid")),json-node-pair("correct",oh-get(row,"correct")),json-node-pair("checks",oh-get(row,"checks")));
   let compact = json-node-object(append(common,details));
   let shown = print_str(json-emit-precise(compact) ++ "\n");
   0;
  }
  def beo-events(lines) = lines |> filter(line => (String) trim(line) != "") |> map(line => parse-json("BML learning event",line));
  def beo-round-status(dir) {
   let result = nsm-json(nsm-at(dir,"result.json"));
   let eventsPath = nsm-at(nsm-at(dir,"adapter"),"training-events.jsonl");
   let events = beo-events(split-on(nsm-text(eventsPath),"\n"));
   json-node-object(list(nsm-s("row",dir),nsm-s("trainer",nlw-status(dir)),nsm-n("result_present",file_size(nsm-at(dir,"result.json")) > 0),json-node-pair("status",oh-get(result,"status")),json-node-pair("optimizer_step",oh-get(result,"optimizer_step")),json-node-pair("promoted",oh-get(result,"promoted")),json-node-pair("last_training_event",nil?(events) ? json-node-null() : events[len(events) - 1]),nsm-s("result",nsm-at(dir,"result.json")),nsm-s("training_events",eventsPath)));
  }
  def beo-round-statuses(paths) = paths |> map(path => beo-round-status(json-string-value(path)));
  def beo-status(home) {
   let queued = nsm-json(nsm-at(home,"queued.json"));
   let rows = beo-round-statuses(json-array-elements(oh-get(queued,"rows")));
   let report = json-node-object(list(nsm-n("observed_at_ms",now_unix_ms()),nsm-s("worker",nsm-worker-state(hearth-session-learning())),json-node-pair("state",nsm-state(hearth-session-learning())),json-node-pair("rounds",json-node-array(rows))));
   let saved = nsm-write(nsm-at(home,"learning-current.json"),report);
   print_str(json-emit-precise(report) ++ "\n");
   report;
  }
  def beo-kept-events(events,stages) = events |> filter(event => nsm-has(stages,nsm-str(event,"stage")));
  def beo-learning-row(dir) {
   let path = nsm-at(nsm-at(dir,"adapter"),"training-events.jsonl");
   let events = beo-events(split-on(nsm-text(path),"\n"));
   let stages = list("admitted","validation","assessment-before","row","round","assessment-after","finished");
   json-node-object(list(nsm-s("row",dir),nsm-n("result_present",file_size(nsm-at(dir,"result.json")) > 0),json-node-pair("result",nsm-json(nsm-at(dir,"result.json"))),nsm-s("events_source",path),json-node-pair("stages",json-node-array(beo-kept-events(events,stages)))));
  }
  def beo-learning-rows(paths) = paths |> map(path => beo-learning-row(json-string-value(path)));
  def beo-report(home) {
   let queued = nsm-json(nsm-at(home,"queued.json"));
   let rows = beo-learning-rows(json-array-elements(oh-get(queued,"rows")));
   let report = json-node-object(list(nsm-n("observed_at_ms",now_unix_ms()),nsm-s("worker",nsm-worker-state(hearth-session-learning())),json-node-pair("state",nsm-state(hearth-session-learning())),json-node-pair("rounds",json-node-array(rows))));
   let path = nsm-at(home,"learning-report.json"); let saved = nsm-write(path,report);
   print_str("learning_report=" ++ path ++ "\n");
   report;
  }
  def beo-reference-valid(row) {
   let reference = nsm-str(row,"reference"); let execution = nsm-json(nsm-at(reference,"execution.json")); let source = nsm-text(nsm-at(reference,"check.bml"));
   let bound = ((String) nsm-str(execution,"source_sha256") == nsm-hash(source)) && ((String) source == bep-wrap(nsm-str(row,"answer"),nsm-str(row,"checks")));
   let passed = ((Comparable) nsm-num(execution,"exit") == 0) && ((String) bep-first-line(execution) == nsm-str(row,"expected"));
   let target = (String) nsm-str(row,"kind") == "prediction" ? bep-first-line(execution) : nsm-str(row,"answer");
   bound && (passed && ((String) nsm-str(row,"completion") == target));
  }
  def beo-enqueue-row(home,session,row) {
   !beo-reference-valid(row) ? form_error("practice target is not bound to its native execution") : nsm-record(home,session,nsm-str(row,"id"),"caller",nsm-str(row,"prompt"),nsm-str(row,"completion"),"caller-teaching","explicit-local-correction",0);
  }
  def beo-enqueue-rows(home,session,rows) = rows |> map(row => beo-enqueue-row(home,session,row));
  def beo-enqueue(home) {
   let manifest = beo-manifest(home); let rows = beo-rows(manifest,"practice");
   let digest = nsm-hash(nsm-text(nsm-at(home,"manifest.json")));
   let session = "bml-practice:" ++ digest;
   let queued = beo-enqueue-rows(hearth-session-learning(),session,rows);
   let request = json-node-object(list(nsm-s("prompt",nsm-str(head(rows),"prompt")),nsm-s("completion",nsm-str(head(rows),"completion")),nsm-s("session",session),nsm-s("event",nsm-str(head(rows),"id"))));
   let saved = nsm-write(nsm-at(home,"embody.request.json"),request);
   let report = json-node-object(list(nsm-s("session",session),json-node-pair("rows",json-node-array(nsm-string-nodes(queued))),nsm-s("embody_request",nsm-at(home,"embody.request.json"))));
   let saved = nsm-write(nsm-at(home,"queued.json"),report);
   print_str(json-emit-precise(report) ++ "\n");
   report;
  }
 }
 0;
}
