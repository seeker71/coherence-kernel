; giles-light-hubs-permission.fk — scoped, attributed, revocable permission.
;
; The initiating Hati Suci member reports that Giles grants the permission
; requested in this conversation for the exact supplied Light Hubs body:
; public quotation and reproduction, translation, open-AI reasoning and
; training use, attribution to "Giles", and continuing revision/withdrawal.
;
; This is evidence level 1: a member-witnessed author grant. It is not dressed
; as a direct signed author artifact (0). Because immutable Git history cannot
; fulfill removal after withdrawal, the full surface body remains outside Git
; and needs a revocable publication carrier.
;
; witnessed: 2026-07-26 -> 1023 live fkwu
import "giles-light-hubs-candidate.fk"

(do
  (defn glhp-evidence-member-witnessed () 1)

  ; permission =
  ; [source-id,sha256,evidence,quote,reproduce,translate,ai-reasoning,
  ;  ai-training,attribution,attribution-name,revise,withdraw,
  ;  direct-author-artifact,public-body-in-git,revocable-carrier,epoch]
  (defn glhp-permission
    (source-id sha evidence quote reproduce translate ai-reasoning ai-training
      attribution attribution-name revise withdraw direct-author-artifact
      public-body-in-git revocable-carrier epoch)
    (list source-id sha evidence quote reproduce translate ai-reasoning
      ai-training attribution attribution-name revise withdraw
      direct-author-artifact public-body-in-git revocable-carrier epoch))

  (defn glhp-source-id (p) (nth p 0))
  (defn glhp-sha (p) (nth p 1))
  (defn glhp-evidence (p) (nth p 2))
  (defn glhp-quote (p) (nth p 3))
  (defn glhp-reproduce (p) (nth p 4))
  (defn glhp-translate (p) (nth p 5))
  (defn glhp-ai-reasoning (p) (nth p 6))
  (defn glhp-ai-training (p) (nth p 7))
  (defn glhp-attribution (p) (nth p 8))
  (defn glhp-attribution-name (p) (nth p 9))
  (defn glhp-revise (p) (nth p 10))
  (defn glhp-withdraw (p) (nth p 11))
  (defn glhp-direct-author-artifact (p) (nth p 12))
  (defn glhp-public-body-in-git (p) (nth p 13))
  (defn glhp-revocable-carrier (p) (nth p 14))
  (defn glhp-epoch (p) (nth p 15))

  (defn glhp-current ()
    (glhp-permission
      (glh-source-id) (glh-sha256) (glhp-evidence-member-witnessed)
      1 1 1 1 1 1 "Giles" 1 1 0 0 1 20260726))

  (defn glhp-witness ()
    (do
      (let p (glhp-current))
      (let source (ctsr-find (glhp-source-id p)))
      (add
        (if (and
          (not (nothing? source))
          (str_eq (glhp-sha p) (glh-sha256))) 1 0)
        (add
          (if (and
            (eq (glhp-evidence p) (glhp-evidence-member-witnessed))
            (eq (glhp-direct-author-artifact p) 0)) 2 0)
          (add
            (if (and (eq (glhp-quote p) 1)
              (eq (glhp-reproduce p) 1)) 4 0)
            (add
              (if (eq (glhp-translate p) 1) 8 0)
              (add
                (if (and (eq (glhp-ai-reasoning p) 1)
                  (eq (glhp-ai-training p) 1)) 16 0)
                (add
                  (if (and (eq (glhp-attribution p) 1)
                    (str_eq (glhp-attribution-name p) "Giles")) 32 0)
                  (add
                    (if (and (eq (glhp-revise p) 1)
                      (eq (glhp-withdraw p) 1)) 64 0)
                    (add
                      (if (and
                        (eq (ctsr-rights source)
                          (ctsr-rights-recorded-permission))
                        (str_eq (ctsr-rights-uri source)
                          "urn:permission:giles-light-hubs:member-witnessed:20260726"))
                        128 0)
                      (add
                        (if (and
                          (eq (glhp-public-body-in-git p) 0)
                          (eq (glh-public-segment-count) 0)) 256 0)
                        (if (and
                          (eq (glhp-revocable-carrier p) 1)
                          (and
                            (eq (ctsr-content-state source)
                              (ctsr-content-metadata))
                            (and
                              (eq (ctsr-protocol source)
                                (ctsr-protocol-community-review))
                              (str_eq (ctsr-rights-scope source)
                                "quote+reproduce+translate+open-ai-reasoning+ai-training; attribution=Giles; revise+withdraw; community-restrictions=none; benefit+freshness-owed; full-body-needs-revocable-carrier")))) 512 0)
                        ))))))))))
    )

  0)
