// Practice targets become teachings only after their exact BML source executes.
// Test compositions are frozen beside the practice, and never offered as targets.
// preludes: form-stdlib/native-session-memory.bml observe/framebuffer-runtime-observation.fk
section [form.bml] {
 class BmlExecutionPractice {
  def bep-row(id,prompt,answer,checks,expected,kind) = json-node-object(list(nsm-s("id",id),nsm-s("prompt",prompt),nsm-s("answer",answer),nsm-s("checks",checks),nsm-s("expected",expected),nsm-s("kind",kind)));
  def bep-pick() = "def tend-pick(xs) = if eq(len(xs),0) then nothing() else if nothing?(head(xs)) then tend-pick(tail(xs)) else head(xs);";
  def bep-recover() = "def tend-recover(ack,old,current) = if nothing?(ack) then old else current;";
  def bep-json() = "def reading-json(x) = if nothing?(x) then json-node-string(\"nothing\") else json-node-int(x);";
  def bep-training() = list(
   bep-row("absence","Predict this repository BML. nothing() is absent; numeric 0 is present. Return only the JSON array, using the string \"nothing\" for absence.\n" ++ bep-pick() ++ "\n" ++ bep-recover() ++ "\nEvaluate: tend-pick(list(nothing(),0,6)); tend-pick(list(nothing())); tend-recover(0,12,31); tend-recover(nothing(),12,31).",bep-pick() ++ "\n" ++ bep-recover(),bep-json() ++ "\nprint_str(json-emit-precise(json-node-array(list(reading-json(tend-pick(list(nothing(),0,6))),reading-json(tend-pick(list(nothing()))),reading-json(tend-recover(0,12,31)),reading-json(tend-recover(nothing(),12,31))))));","[0,\"nothing\",31,12]","prediction"),
   bep-row("declaration","Write one complete repository BML declaration, ending in a semicolon. No markdown or invocation. Implement tend-pick(xs): skip nothing() and return the first present scalar, preserving numeric 0. Empty and all-absent lists return nothing(). Use len, eq, head, tail, nothing?, nothing and recursion. Syntax: def name(xs) = if CONDITION then EXPRESSION else EXPRESSION;",bep-pick(),"print(list(nothing?(tend-pick(list())),nothing?(tend-pick(list(nothing(),nothing()))),value_eq(tend-pick(list(nothing(),0,6)),0),value_eq(tend-pick(list(-5,nothing())),-5),value_eq(tend-pick(list(nothing(),\"blue\",4)),\"blue\"),value_eq(tend-pick(list(8,0)),8)));","[1, 1, 1, 1, 1, 1]","code"),
   bep-row("product","Repair this repository BML declaration. Return only the complete declaration, including its terminating semicolon. grove-product(xs) must multiply all integer readings; the empty product is 1. Preserve zeros and signs.\ndef grove-product(xs) = if eq(len(xs),0) then 0 else add(head(xs),grove-product(tail(xs)));","def grove-product(xs) = if eq(len(xs),0) then 1 else mul(head(xs),grove-product(tail(xs)));","print(list(eq(grove-product(list()),1),eq(grove-product(list(7)),7),eq(grove-product(list(2,4,3)),24),eq(grove-product(list(2,0,5)),0),eq(grove-product(list(-2,3)),-6),eq(grove-product(list(-2,-3)),6)));","[1, 1, 1, 1, 1, 1]","code"));
  def bep-relay() = "def relay(xs,fallback) = if eq(len(xs),0) then fallback else if nothing?(head(xs)) then relay(tail(xs),fallback) else head(xs);";
  def bep-keep() = "def keep(ack,old,current) = if nothing?(ack) then old else current;";
  def bep-tests() = list(
   bep-row("composed-prediction","Predict the behavior of these repository BML definitions. nothing() is distinct from numeric 0. Return only a JSON array; encode nothing as the string \"nothing\".\n" ++ bep-relay() ++ "\n" ++ bep-keep() ++ "\nEvaluate in order: keep(relay(list(nothing(),0),nothing()),4,29); keep(relay(list(nothing()),nothing()),4,29); relay(list(nothing(),-8,3),90); relay(list(),0); relay(list(nothing()),nothing()); keep(relay(list(0),nothing()),nothing(),0).",bep-relay() ++ "\n" ++ bep-keep(),bep-json() ++ "\nprint_str(json-emit-precise(json-node-array(list(reading-json(keep(relay(list(nothing(),0),nothing()),4,29)),reading-json(keep(relay(list(nothing()),nothing()),4,29)),reading-json(relay(list(nothing(),-8,3),90)),reading-json(relay(list(),0)),reading-json(relay(list(nothing()),nothing())),reading-json(keep(relay(list(0),nothing()),nothing(),0))))));","[29,4,-8,0,\"nothing\",0]","prediction"),
   bep-row("last-present","Write exactly one complete native repository BML declaration: moss-last(xs). Return the LAST present scalar in the finite list, ignoring nothing(). Numeric 0 and strings are present. Empty or all-nothing input returns nothing(). Available functions: len, eq, head, tail, nothing?, nothing. Recursion is allowed. Syntax: def name(xs) = if CONDITION then EXPRESSION else EXPRESSION; Return only the declaration, no markdown, wrapper, imports or invocation.","def moss-last(xs) = if eq(len(xs),0) then nothing() else if nothing?(moss-last(tail(xs))) then head(xs) else moss-last(tail(xs));","print(list(nothing?(moss-last(list())),nothing?(moss-last(list(nothing(),nothing()))),value_eq(moss-last(list(9,nothing(),0)),0),value_eq(moss-last(list(0,nothing(),-6)),-6),value_eq(moss-last(list(4,nothing(),\"blue\",nothing())),\"blue\"),value_eq(moss-last(list(8,3)),3),value_eq(moss-last(list(0)),0),value_eq(moss-last(list(nothing(),5,nothing())),5)));","[1, 1, 1, 1, 1, 1, 1, 1]","code"),
   bep-row("repair-present-sum","Repair this repository BML declaration to sum all present integer readings, ignoring nothing(). Empty and all-nothing inputs sum to 0. Numeric 0 is a present reading. Return only one complete declaration with its terminating semicolon. Available functions: len, eq, head, tail, nothing?, add, mul, sub. Keep the name fern-total.\ndef fern-total(xs) = if eq(len(xs),0) then 1 else if nothing?(head(xs)) then 0 else mul(head(xs),fern-total(tail(xs)));","def fern-total(xs) = if eq(len(xs),0) then 0 else if nothing?(head(xs)) then fern-total(tail(xs)) else add(head(xs),fern-total(tail(xs)));","print(list(eq(fern-total(list()),0),eq(fern-total(list(nothing(),nothing())),0),eq(fern-total(list(2,nothing(),5)),7),eq(fern-total(list(0,9)),9),eq(fern-total(list(-4,3)),-1),eq(fern-total(list(nothing(),-4,nothing(),8)),4),eq(fern-total(list(0)),0),eq(fern-total(list(5,nothing())),5)));","[1, 1, 1, 1, 1, 1, 1, 1]","code"));
  def bep-wrap(source,checks) = "// preludes: form-stdlib/json-precise.bml\nsection [form.bml] {\n" ++ source ++ "\n" ++ checks ++ "\n0;\n}\n";
  def bep-execute(dir,source) {
   let wrote = nag-write(nsm-at(dir,"check.bml"),source); let start = host_monotonic_ms();
   let before = fbro-snapshot();
   let pid = host_spawn_at(list("./fkwu",nsm-at(dir,"check.bml")),list("/dev/null",nsm-at(dir,"stdout"),nsm-at(dir,"stderr")));
   let rc = pid > 0 ? host_wait(pid) : -1;
   fbro-stage-observed-stream("bml-practice:" ++ int_to_str(host_pid()),dir,"reference","bml-practice-supervisor","child-execution","verify-target","minimal-prelude",before,fbro-snapshot(),"source-bytes",str_len(source),rc == 0 ? "completed" : "refused",nsm-at(dir,"check.bml"),1,1);
   let result = json-node-object(list(nsm-n("exit",rc),nsm-n("wall_ms",host_monotonic_ms() - start),nsm-s("source_sha256",nsm-hash(source)),nsm-s("stdout",nsm-text(nsm-at(dir,"stdout"))),nsm-s("stderr",nsm-text(nsm-at(dir,"stderr")))));
   let saved = nsm-write(nsm-at(dir,"execution.json"),result);
   result;
  }
  def bep-first-line(result) = trim(head(split-on(nsm-str(result,"stdout"),"\n")));
  def bep-prepare-row(root,row) {
   let dir = nsm-at(root,nsm-str(row,"id")); let made = fs-mkdir(dir);
   let result = bep-execute(dir,bep-wrap(nsm-str(row,"answer"),nsm-str(row,"checks")));
   let good = ((Comparable) nsm-num(result,"exit") == 0) && ((String) bep-first-line(result) == nsm-str(row,"expected"));
   let target = (String) nsm-str(row,"kind") == "prediction" ? bep-first-line(result) : nsm-str(row,"answer");
   let ready = oh-set(oh-set(row,"completion",json-node-string(target)),"reference",json-node-string(dir));
   let reading = oh-reading("native-bml-practice",root,nsm-str(row,"id"),json-node-string(nsm-str(row,"expected")),json-node-string(bep-first-line(result)),json-node-int(good),good ? list() : list(oh-need("correct-native-example",oh-reference(nsm-at(dir,"execution.json")))),list("retain-verified-reference","repair-reference"),oh-reference(nsm-at(dir,"execution.json")));
   let observed = nsm-event(fs-path-dirname(root),"reference-observed",list(json-node-pair("health",reading)));
   good ? ready : form_error("BML practice reference failed: " ++ dir);
  }
  def bep-prepare-rows(root,rows) = nil?(rows) ? list() : cons(bep-prepare-row(root,head(rows)),bep-prepare-rows(root,tail(rows)));
  def bep-pairs(rows) = nil?(rows) ? list() : cons(nsm-row(nsm-str(head(rows),"prompt"),nsm-str(head(rows),"completion")),bep-pairs(tail(rows)));
  def bep-distinct(train,tests) = nil?(train) ? 1 : (bep-no-prompt(nsm-str(head(train),"prompt"),tests) && bep-distinct(tail(train),tests));
  def bep-no-prompt(prompt,rows) = nil?(rows) ? 1 : ((!((String) prompt == nsm-str(head(rows),"prompt"))) && bep-no-prompt(prompt,tail(rows)));
  def bep-prepare(home) {
   fs-exists?(home) ? form_error("BML practice preparation requires a fresh evidence home") : bep-prepare-fresh(home);
  }
  def bep-prepare-fresh(home) {
   let made = nsm-init(home); let t = fs-mkdir(nsm-at(home,"practice")); let e = fs-mkdir(nsm-at(home,"test"));
   let train = bep-prepare-rows(nsm-at(home,"practice"),bep-training()); let tests = bep-prepare-rows(nsm-at(home,"test"),bep-tests());
   let separate = bep-distinct(train,tests);
   let body = json-node-object(list(nsm-s("schema","native-bml-practice-v1"),nsm-n("prepared_at_ms",now_unix_ms()),nsm-s("source_sha256",nsm-hash(nsm-text("learn/bml-execution-practice.bml"))),nsm-n("practice_and_test_prompts_distinct",separate),json-node-pair("session_before",nsm-state(hearth-session-learning())),json-node-pair("practice",json-node-array(train)),json-node-pair("test",json-node-array(tests))));
   !separate ? form_error("BML practice and test prompt overlap") : nsm-write(nsm-at(home,"manifest.json"),body);
  }
 }
 0;
}
