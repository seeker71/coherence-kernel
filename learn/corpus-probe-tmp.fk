; preludes: form-stdlib/core.fk learn/homecoming-distillation-corpus.fk
(do
    (print_str (str_concat "count      " (str_concat (int_to_str (hdc-count (hdc-rows))) "\n")))
    (print_str (str_concat "admissible " (str_concat (int_to_str (hdc-count-admissible (hdc-rows))) "\n")))
    (print_str (str_concat "foundings  " (str_concat (int_to_str (hdc-foundings)) "\n")))
    (print_str (str_concat "max-mid    " (str_concat (int_to_str (hdc-max-mid (hdc-rows))) "\n")))
    (print_str (str_concat "dup-mid    " (str_concat (int_to_str (hdc-dup-mid-rows (hdc-rows))) "\n")))
    (print_str (str_concat "field-code " (str_concat (int_to_str (hdc-field-code)) "\n")))
    0)
