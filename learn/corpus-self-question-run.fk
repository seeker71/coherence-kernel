; corpus-self-question-run.fk — the live door: the real corpus reads its own
; weave and poses its own frontier question.
;
; The daily ritual has the rented mind ask the body one frontier question.
; This door inverts it: the body computes which of its teachings wove into
; later questions and which lie orphaned, then asks its own. The rented mind's
; part is to ANSWER, and the answered row re-enters the corpus — changing the
; weave, changing the next question the body will pose.
;
; preludes: form-stdlib/core.fk
; preludes: form-stdlib/corpus-self-question.fk
; preludes: learn/homecoming-distillation-corpus.fk

(do
    (defn csqr-tokens-text (tokens acc)
        (if (eq (len tokens) 0) acc
            (csqr-tokens-text (tail tokens)
                (str_concat acc (str_concat " " (head tokens))))))
    (let rows (hdc-rows))
    (let w (csq-weave rows))
    (print "corpus rows=" (hdc-count rows))
    (print "most-woven fresh word=" (csq-best-word w)
        " spoken-again=" (csq-best-count w))
    (print "orphans never spoken again=" (csq-orphan-count w))
    (print "oldest orphan=" (csq-orphan-word w)
        " (row " (csq-orphan-mid w) ")")
    (print "the body asks:"
        (csqr-tokens-text
            (csq-question (csq-best-word w) (csq-orphan-word w)) ""))
    0)
