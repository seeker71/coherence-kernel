; Native corpus observation. One model/tokenizer admission serves every probe.
; A partial, missing or refused answer invalidates the observation, rather than
; improving its fabrication rate or reducing its fact score silently.
; preludes: learn/train-loop-rules.fk learn/train-loop-local-paths.fk form-stdlib/native-llama-voice.bml form-stdlib/native-lora-dataset.bml
(do
 (defn tlo-model () (tlp-base-model))
 (defn tlo-valid2 () "/Users/ursmuff/.coherence-network/form-corpus-lora-data/valid2.jsonl")
 (defn tlo-events () (str_concat ".hearth/corpus-observe-" (str_concat (int_to_str (host_pid)) ".jsonl")))
 (defn fqmn-trim-like (s)
  (if (and (gt (str_len s) 0) (eq (str_byte_at s (sub (str_len s) 1)) 10)) (substring s 0 (sub (str_len s) 1)) s))
 (defn tlo-said (r) (if (or (gt (str_len (nth r 1)) 0) (eq (str_len (head r)) 0)) (nothing) (trim (head r))))
 (defn tlo-ask-on (session prompt) (tlo-said (nlg-ask session prompt 0 "" "" (tlo-events))))
 (defn tlo-ask (adapter prompt) (tlo-said (nlg-once (tlo-model) adapter prompt 0 "" "" (tlo-events))))
 (defn tlo-ask-model (model prompt) (tlo-said (nlg-once (nfg-resolve model) "" prompt 0 "" "" (tlo-events))))
 (defn tlo-hit? (want got) (if (or (nothing? got) (eq (str_len want) 0)) 0 (if (ge (str_find got want 0) 0) 1 0)))
 (defn tlo-unknowns () (list "cragmoor" "duskwrit" "fenlode"))
 (defn tlo-unknown-q (w) (str_concat "Answer with one word only. what does the body mean by " (str_concat w "? If it is not a word the body holds, reply exactly: nothing.")))
 (defn tlo-unk-loop (session ws fabricated asked)
  (if (nil? ws) (list fabricated asked)
   (do (let got (tlo-ask-on session (tlo-unknown-q (head ws))))
    (if (nothing? got) (nothing)
     (tlo-unk-loop session (tail ws) (add fabricated (if (tlo-hit? "nothing" got) 0 1)) (add asked 1))))))
 (defn tlo-pair (line)
  (do (let row (parse-json "corpus-observation-row" (head line)))
   (let messages (json-array-elements (json-object-get row "messages")))
   (if (not (eq (len messages) 2)) (form_error "corpus observation requires a user/assistant pair")
    (list (nld-string (head messages) "content") (nld-string (nth messages 1) "content")))))
 (defn tlo-fact-loop (session rows hits abstained asked permission)
  (if (nil? rows) (list hits abstained asked)
   (do (let pair (tlo-pair (head rows)))
    (let prompt (str_concat (head pair) (if permission " If it is not a word the body holds, reply exactly: nothing." "")))
    (let got (tlo-ask-on session prompt))
    (if (nothing? got) (nothing)
     (tlo-fact-loop session (tail rows) (add hits (tlo-hit? (nth pair 1) got))
      (add abstained (if (and (not (tlo-hit? (nth pair 1) got)) (tlo-hit? "nothing" got)) 1 0)) (add asked 1) permission)))))
 (defn tlo-pm (n d) (if (le d 0) (nothing) (div (mul n 1000) d)))
 (defn tlo-measure (session rows)
  (do (let u (tlo-unk-loop session (tlo-unknowns) 0 0))
   (let f (if (nothing? u) (nothing) (tlo-fact-loop session rows 0 0 0 0)))
   (let p (if (nothing? f) (nothing) (tlo-fact-loop session rows 0 0 0 1)))
   (if (nothing? p) (nothing)
    (tlr-obs 1000 (tlo-pm (nth f 0) (nth f 2)) (tlo-pm (nth u 0) (nth u 1)) (tlo-pm (nth p 1) (nth p 2))))))
 (defn tlo-observe (adapter fact-count)
  (do (let text (read_file (tlo-valid2)))
   (if (or (nothing? text) (le fact-count 0)) (nothing)
    (do (let rows (take fact-count (nld-lines text)))
     (if (not (eq (len rows) fact-count)) (nothing)
      (do (let session (nlg-open (tlo-model) adapter))
       (let result (tlo-measure session rows))
       (nlg-close session)
       result))))))
 0)
