; hati-suci-core-text-invitation-band.fk — live integration witness.
;
; Final score 4095 proves:
;   1      the Hati Suci community symbol is present
;   2      the recognized Satsang circle has a distinct symbol
;   4      the current pilot is review/node, not 0 or 1
;   8      permission terms are recorded; cultural restrictions are next
;   16     Satsang can receive and authorize; no decision is fabricated
;   32     no observed relationship returns nothing
;   64     a community decline returns 0
;   128    a synthetic all-confirmed fixture returns 1
;   256    a declined downstream-use term returns 0
;   512    response arms plus the actionable Satsang offer are explicit
;   1024   Light Hubs metadata enters as source 13; no text segment enters
;   2048   the pure structural projection returns 127
import "../hati-suci-core-text-invitation.fk"
import "../core-text-source-registry.fk"

(do
  (defn hsctib-arms? (r)
    (if (and
      (nothing? (nth r 0))
      (and (eq (nth r 1) 0)
        (and (eq (nth r 2) 1)
          (gt (nth r 3) 1)))) 1 0))

  (defn hsctib-witness ()
    (do
      (let current (hscti-current-pilot))
      (let absent
        (hscti-with 0 0 (hscti-circle-role-unobserved)
          (hscti-pending) (hscti-pending-terms)))
      (let declined
        (hscti-with 1 1 (hscti-circle-role-both)
          (hscti-declined) (hscti-pending-terms)))
      (let confirmed
        (hscti-with 2 2 (hscti-circle-role-both)
          (hscti-confirmed) (hscti-confirmed-terms)))
      (let term-declined
        (hscti-with 2 2 (hscti-circle-role-both) (hscti-confirmed)
          (hscti-terms 1 1 1 1 1 2 1 1 1)))
      (let current-r (hscti-response current))
      (let offer (hscti-r-offer current-r))
      (let absent-r (hscti-response absent))
      (let declined-r (hscti-response declined))
      (let confirmed-r (hscti-response confirmed))
      (let term-declined-r (hscti-response term-declined))
      (add
        (if (gt (hscti-community current) 0) 1 0)
        (add
          (if (and
            (gt (hscti-circle current) 0)
            (not (eq (hscti-community current) (hscti-circle current)))) 2 0)
          (add
            (if (eq (hscti-class current) 3) 4 0)
            (add
              (if (and
                (eq (hscti-current-grant-recorded? current) 1)
                (and
                (eq (hscti-first-pending current)
                  (hscti-term-cultural))
                (eq (hscti-r-ack current-r)
                  (hscti-action-node
                    (hscti-term-cultural))))) 8 0)
              (add
                (if (and
                  (eq (hscti-circle-can-receive? current) 1)
                  (and (eq (hscti-circle-can-authorize? current) 1)
                    (eq (hscti-circle-authority-confirmed? current) 0)))
                  16 0)
                (add
                  (if (nothing? (hscti-r-ack absent-r)) 32 0)
                  (add
                    (if (eq (hscti-r-ack declined-r) 0) 64 0)
                    (add
                      (if (eq (hscti-r-ack confirmed-r) 1) 128 0)
                      (add
                        (if (eq (hscti-r-ack term-declined-r) 0) 256 0)
                        (add
                          (if (and
                            (eq (hsctib-arms? current-r) 1)
                            (and (eq (hsctib-arms? absent-r) 1)
                              (and (eq (hsctib-arms? declined-r) 1)
                                (and (eq (hsctib-arms? confirmed-r) 1)
                                  (and
                                    (eq (hsctib-arms? term-declined-r) 1)
                                    (and
                                      (eq (nth offer 0)
                                        (hscti-r-ack current-r))
                                      (and
                                        (eq (nth offer 1)
                                          (hscti-circle current))
                                          (and
                                            (eq (nth offer 2)
                                            (hscti-term-cultural))
                                          (and
                                            (nothing? (nth offer 3))
                                            (and (eq (nth offer 4) 0)
                                              (and (eq (nth offer 5) 1)
                                                (gt (nth offer 6) 1))))))))))))
                            512 0)
                          (add
                            (if (and
                              (eq (len (ctsr-sources)) 13)
                              (and (not (nothing? (ctsr-find 13)))
                                (and
                                  (eq (ctsr-content-state (ctsr-find 13))
                                    (ctsr-content-metadata))
                                  (and
                                    (eq (ctsr-rights (ctsr-find 13))
                                      (ctsr-rights-recorded-permission))
                                    (and
                                      (eq (ctsr-protocol (ctsr-find 13))
                                        (ctsr-protocol-community-review))
                                      (eq (len (ctsr-segments)) 6)))))) 1024 0)
                            (if (eq (hscti-structure-witness) 127)
                              2048 0)))))))))))))
    )

  (hsctib-witness))
