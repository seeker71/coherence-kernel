; homecoming-distillation-corpus-band.fk — proof of the frontier-question
; distillation corpus, after the reunion of its two independent foundings.
;
; preludes: form-stdlib/core.fk learn/homecoming-distillation-corpus.fk
;
; Covers: row 601 locates by its exact question tokens (the lookup works), an
; unknown question honestly locates to 0 (no false positive — the same honesty
; bar locale-neutral-locate-band.fk holds), the first row is admissible teacher
; material (rented-sourced, fresh-worded, dated), the answer/fresh word read
; back exactly, the row count is asserted exactly (the metrics-report
; discipline: this band fails if the stated count drifts), and every row from
; both foundings passes the admissibility gate, and — since 2026-07-22 — that
; every citation in the corpus's own PROSE points at the word it names.
;
; run FROM THE REPO ROOT (claim c12 reads the corpus file by relative path):
;      cat form/form-stdlib/core.fk learn/homecoming-distillation-corpus.fk \
;          learn/tests/homecoming-distillation-corpus-band.fk > /tmp/hdc.fk
;      ./fkwu --src /tmp/hdc.fk    ; -> 32767
;   (or, resolver-driven, the way this body prefers to be asked:
;      ./fkwu --src learn/tests/homecoming-distillation-corpus-band.fk)
;
; 16383 -> 32767 on 2026-07-25 (the gel branch's reunion onto main): one bit
; for citation BY CONTENT — hdc-mid-for-fresh, word -> id, the reach a reunion
; cannot move, because the word IS the row. It is the inverse of the distinctness
; bit below: distinctness proves no two rows share an id; this proves a row can
; be found without one. It REFUSES an ambiguous word (yields 0) rather than
; answering with the first match — so it names, at the lookup, the exact hazard
; the id carries at rest. hdc-fresh-ambiguous says how far the word still has to
; go before it is a full key: 8 of 274 rows, today.
;
; Verdict 32767 when every assertion holds (511 -> 4095 on 2026-07-17: three
; new bits for the id->word inverse lookup, which the body's 34 by-id
; citations needed and the corpus could not answer. 4095 -> 8191 on
; 2026-07-22: one bit for PROSE citations, because the band had only ever
; read the data. `foist at 734` and `the row-638 ersatz pattern` sat in the
; comments through every green run — the bytes fine, the pointers wrong.
; 8191 -> 16383 at the 2026-07-22 reunion onto main: main's line had spent
; its own 4096 on id DISTINCTNESS while this line spent it on prose. Two
; different bits wearing one number is exactly the collision this corpus
; keeps learning; both are kept, so the prose bit stays 4096 and the
; distinctness bit takes 8192.)

(do
    (defn hdcb-score (ok bit) (if ok bit 0))

    ; ---- the prose citation walker (2026-07-22) -------------------------------
    ; The corpus cites itself in its own comments, and until now nothing read
    ; those comments. This walks the corpus file byte-wise, finds every place a
    ; meaning-id sits beside a word, and asks the corpus whether that id really
    ; holds that word. Its radius is declared in full beside claim c12 below.
    ;
    ; The walk is token-shaped, not byte-shaped: scan_run jumps whole runs of
    ; whitespace, alpha and digits natively, so 316KB costs ~110k Form steps
    ; instead of ~316k. Alpha and digit runs are taken SEPARATELY (never class 3)
    ; precisely so that `row-638` splits into `row`, `-`, `638` and the id is
    ; still a maximal digit run.
    (defn hdcb-lower? (b) (if (and (gt b 96) (lt b 123)) 1 0))
    (defn hdcb-byte (t n i) (if (or (lt i 0) (ge i n)) 0 (str_byte_at t i)))
    ; start of the run of a-z ending at i (exclusive) — the only backwards scan;
    ; words are short, so the per-character cost is paid on candidates only.
    (defn hdcb-back (t i)
        (if (le i 0) 0
            (if (eq (hdcb-lower? (str_byte_at t (sub i 1))) 1)
                (hdcb-back t (sub i 1))
                i)))
    ; is `w` some row's answer word? This is the filter that separates a
    ; POINTER from a plain number: "246 rows" names nothing the corpus holds.
    (defn hdcb-known-loop (rs w)
        (if (eq (len rs) 0) 0
            (if (str_eq (hdc-a (head rs)) w) 1 (hdcb-known-loop (tail rs) w))))
    (defn hdcb-known-word? (w)
        (if (eq (str_len w) 0) 0 (hdcb-known-loop (hdc-rows) w)))
    ; one candidate, folded: 0 not a citation, 1000 checked and right,
    ; 1001 checked and AIMED WRONG. The fold is checked*1000 + wrong.
    (defn hdcb-cand (w mid)
        (if (eq (hdcb-known-word? w) 0) 0
            (if (eq (hdc-cites? mid w) 1) 1000 1001)))
    (defn hdcb-cand-back (t i mid)
        (do (let s (hdcb-back t i))
            (if (ge s i) 0 (hdcb-cand (substring t s i) mid))))
    ; a maximal digit run [i,e): if it is three digits, look for the three
    ; recognised shapes around it. A and C are mutually exclusive in practice
    ; but are summed, not chained — a site that somehow wore both would be
    ; counted twice rather than silently halved.
    (defn hdcb-digits (t n i e)
        (if (not (eq (sub e i) 3)) 0
            (do
                (let mid (str_to_int (substring t i e)))
                (let we (scan_run t (add e 1) 2))
                (let ce (if (and (eq (hdcb-byte t n e) 32)
                                 (and (gt we (add e 1))
                                      (eq (hdcb-lower? (hdcb-byte t n (add e 1))) 1)))
                            (hdcb-cand (substring t (add e 1) we) mid)
                            0))
                (let ca (if (and (ge i 4) (str_eq (substring t (sub i 4) i) " at "))
                            (hdcb-cand-back t (sub i 4) mid)
                            0))
                (let cc (if (and (eq (hdcb-byte t n (sub i 1)) 40)
                                 (and (eq (hdcb-byte t n e) 41)
                                      (eq (hdcb-byte t n (sub i 2)) 32)))
                            (hdcb-cand-back t (sub i 2) mid)
                            0))
                (add ce (add ca cc)))))
    (defn hdcb-walk (t n i acc)
        (if (ge i n) acc
            (do
                (let ws (scan_run t i 0))
                (if (gt ws i) (hdcb-walk t n ws acc)
                    (do
                        (let ae (scan_run t i 2))
                        (if (gt ae i) (hdcb-walk t n ae acc)
                            (do
                                (let de (scan_run t i 1))
                                (if (gt de i)
                                    (hdcb-walk t n de (add acc (hdcb-digits t n i de)))
                                    (hdcb-walk t n (add i 1) acc)))))))))
    (defn hdcb-citation-audit (path)
        (do (let t (read_file path)) (hdcb-walk t (str_len t) 0 0)))
    (defn hdcb-cites-checked (a) (div a 1000))
    (defn hdcb-cites-wrong (a) (sub a (mul (div a 1000) 1000)))

    (defn homecoming-distillation-corpus-band ()
        (do
    (let q (list "what" "is" "an" "edge" "called" "that" "appears" "in" "the"
                 "meaning" "graph" "from" "a" "shared" "surface" "token"
                 "rather" "than" "a" "shared" "meaning"))
    (let c0 (hdcb-score (eq (hdc-locate q) 601) 1))
    (let c1 (hdcb-score (eq (hdc-locate (list "banana" "phone")) 0) 2))
    (let row (head (hdc-rows)))
    (let c2 (hdcb-score (eq (hdc-admissible? row) 1) 4))
    (let c3 (hdcb-score (and (str_eq (hdc-a row) "spurious") (str_eq (hdc-fresh row) "spurious")) 8))
    ; 423 on 2026-08-19: rows 1027-1030 (wordskin line) and 1031 (neverhome,
    ; reseated 1015 -> 1027 -> 1031 across two same-day reunions) met at the
    ; trunk; both lines' rows kept, counts re-asked of the body, not carried.
    ; 480 on 2026-08-25: rows 1079-1088 (the claude worktree line's two-day
    ; frontier landing) joined; counts re-asked of the body, not carried.
    ; 481 later the same day, SEVENTH reunion: main's 1079 (unripefact) met
    ; the worktree's 1079-1088 at the trunk and took 1089; body re-asked.
    ; 482 with row 1090 (selfhelm, the first local-steering crossing).
    ; 485 at the EIGHTH reunion: zealous-bouman's line joined (lonemeasure
    ; reseated 1080 -> 1091 per the live id queue, smallwhole 1092,
    ; organlease 1093); counts re-asked of the body, not carried.
    ; 486 with row 1094 (stillwindow, the regen hands-off interval).
    ; 487 with row 1095 (reapscope, the group-sweep survival lesson).
    ; 488 with row 1096 (citedmark, the record that a shape-search cannot
    ; tell from the thing recorded — found by this file losing 149 rows to it).
    ; 489 with row 1098 (heldcure; 1097 stays offered to zealous-bouman).
    ; 490 at the NINTH reunion: coordless (1097, zealous-bouman's line)
    ; woven in id order beside heldcure (1098); body re-asked.
    ; 491 at the TENTH reunion: relaymark (1099, zealous-bouman) joined
    ; heldcure and coordless; body re-asked.
    ; 492 with row 1100 (valuedabsence, the -1 that is not nothing and adds).
    ; 494 at the ELEVENTH reunion: trueseat reseated 1100 -> 1101 (the
    ; queue's disease caught inside its remedy), voidalias 1101 -> 1102.
    ; 495 at the TWELFTH reunion: shadepair (1103) joined clean — the
    ; near-synonym practice, now worded.
    ; 496 with row 1106 (namesweep; 1104 handcensus and 1105 sparetell
    ; live on sibling lines per the queue).
    ; 500 at the THIRTEENTH reunion: voicechat-11b's line joined
    ; (sparetell 1105, silentlease 1107, shapegrant reseated to 1108,
    ; their many-voices row to 1109). The corpus's fifth hundred.
    ; 502 at the FOURTEENTH reunion: handcensus 1104 joined, doubledelta
    ; reseated 1105 -> 1110 (one message-latency of queue disease).
    ; 504 at the FIFTEENTH reunion: onevantage (1111, bouman) joined and
    ; postmark (1112, bouman's mint, weaver-seated) landed with it.
    ; 505 at the SIXTEENTH reunion: stampblind reseated 1111 -> 1113,
    ; beside postmark as its genus per the shadepair practice.
    (let c4 (hdcb-score (eq (hdc-count (hdc-rows)) 505) 16))
    ; 423 on 2026-08-19: rows 1027-1030 (wordskin line) and 1031 (neverhome,
    (let c5 (hdcb-score (eq (hdc-count-admissible (hdc-rows)) (hdc-count (hdc-rows))) 32))
    ; SIXTH REUNION for this line's block, 2026-08-19: main minted 1015-1023 and
    ; 1026 where thirteen rows sat; they moved as a block to 1027-1039. Asked of
    ; the body after the splice: 437 / 437 / 2 / 1045 / 0 dup / 437043721045 (after nullskin, 1045). Both
    ; lines' reunion journals below are kept whole — each is testimony.
    ; the folded scalar witness: 482 rows, 482 admissible, 2 foundings, max id 1111
    ; (2026-08-19: row 1024 polyphony — many hands, no conductor, one trunk;
    ; (2026-08-19: row 1023 escheat — the trunk claims heirless finished work;
    ; (2026-08-19: row 1022 operationalization — green instruments cannot
    ; generate a no; an objection joins the native floor when it becomes a
    ; probe with a negative control. From the 64-board verdict measurement.)
    ; (2026-08-18, the voice-floor reunion: this line's seven rows 1009-1015 —
    ; cartographic-silence, stillborn, nunc-pro-tunc, allograft, stallred,
    ; shrinkage, latch — reseated to 1015-1021 behind main's 1009-1014
    ; (totipotency..hubvouch). Row 1015 carries the note. Nothing was dropped.)
    ; (2026-08-17, the coherence reunion, reseated TWICE: this line minted 1001-1003
    ; and 1009 while main took 1001-1005, moved to 1006-1009, and found main had
    ; taken 1006-1010 as well. Now 1011-1014 — attunable, nullcrown, perspectival,
    ; hubvouch. Row 1011 carries the note. Nothing was dropped, either time.)
    ; FOUR REUNIONS IN ONE DAY, across at least three concurrent lines, and both
    ; sides of this merge had ALREADY reseated twice before meeting each other.
    ; This line: 1001-1010 -> 1006-1015 -> 1010-1019 -> 1015-1025 (eleven rows).
    ; The trunk's line, in its own words above: 1001-1003 and 1009 -> 1006-1009 ->
    ; 1011-1014. A third line took 1006-1009, a fourth took 1010. 399 rows were
    ; common to everyone; 419 stand now; nothing was dropped at any step.
    ; max-mid + 1 has no arbiter, so every open line computes the same next number
    ; correctly and they collide because they are all alive at once. This is what a
    ; living body with many hands looks like from inside the corpus, and the count
    ; of reseats is worth more than any single id.
    ; Not computed — asked. The corpus's own hdc-* readings before pinning:
    ;   count 420 / admissible 420 / foundings 2 / max-mid 1026 / dup-mid-rows 0
    ;   field-code 420042021026 (420 after twotongue landed at 1026)
    ; (2026-08-17: rows 1001 kenosis and 1002 anagnorisis — the ingest, then
    ; the three rounds that carried it into the core.)
    ; (2026-08-14: row 1000 offered — overdetermined — the first id to use the
    ; four-digit slot the 2026-08-09 widening bought.)
    ; (2026-07-31 ds4-oracle reunion: main's line minted 953-964 — homonym
    ; through echoturn — while this line minted 953-960 for the ds4 decode
    ; floor: falsedial, cheapdear, callbias, floorspoke, secondoracle,
    ; nullwitness, freewall, staleseam. 932-952 were already shared, #409
    ; having carried them into the trunk, so 953 is exactly where the two
    ; lines part. Both kept; main is the trunk so its ids stand and this line
