; navier-stokes-band.fk — the incompressible Navier–Stokes cell, checked.
;
; preludes: form-stdlib/core.fk learn/navier-stokes.fk
;
; Band verdict 1023 when every claim lands (1+2+...+512):
;   1    all five momentum terms share one dimension
;   2    that dimension is force per volume, ( 1 -2 -2)
;   4    continuity's ∇·u is a rate, ( 0  0 -1)
;   8    the Reynolds group ρUL/μ is dimensionless
;   16   water at 1 m/s across 1 m gives Re = 1000000
;   32   the check DISCRIMINATES: a viscous term with one length instead of two
;        is caught. Without this bit the other checks could all be parse-to-true.
;   64   Re computed from the two term magnitudes equals Re from the group —
;        the ratio is what the number MEANS, arrived at twice
;   128  the system carries five momentum terms and one constraint
;   256  3D global existence and smoothness is held as OPEN, not answered
;   512  a term that is genuinely different is not equal to one that is not —
;        the dimension comparison can say no as well as yes

(do
    (add
        (add
            (add
                (if (eq (ns-momentum-homogeneous?) 1) 1 0)
                (if (ns-dim-eq? (ns-term-unsteady) (ns-d-force-density)) 2 0))
            (add
                (if (ns-dim-eq? (ns-term-continuity) (ns-d-rate)) 4 0)
                (if (eq (ns-reynolds-dimensionless?) 1) 8 0)))
        (add
            (add
                (add
                    (if (eq (ns-water-reynolds) 1000000) 16 0)
                    (if (eq (ns-broken-homogeneous?) 0) 32 0))
                (add
                    (if (eq (ns-reynolds-agrees? 1000 1000 1000 1) 1) 64 0)
                    (if (and (eq (ns-momentum-term-count) 5)
                             (eq (ns-constraint-count) 1)) 128 0)))
            (add
                (if (eq (ns-existence-3d-settled?) 0) 256 0)
                (if (ns-dim-eq? (ns-term-viscous) (ns-term-viscous-first-order)) 0 512)))))
