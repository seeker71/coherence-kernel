; navier-stokes-plate-band.fk — the body's own drawing and its own words, checked.
;
; preludes: form-stdlib/core.fk learn/navier-stokes.fk learn/navier-stokes-plate.fk
;
; Band verdict 1023 when every claim lands (1+2+...+512):
;   1    Poiseuille vanishes at both walls
;   2    its peak at the centre is H^2
;   4    it is symmetric about the centre line
;   8    its curvature is -2 at three separate interior points — a parabola, and the
;        reason a pressure gradient has to stand against it
;   16   Couette's curvature is 0 at the same three points — a straight line, needing
;        no pressure gradient
;   32   Couette's endpoints are the fixed wall at 0 and the sliding wall at 2kH
;   64   the plate emits, and emits something substantial rather than an empty document
;   128  the description names all five terms, walked from the same rows the plate draws
;   256  the plot scale is exact: the peak maps to the full panel width, so the picture
;        is not merely near the numbers, it is the numbers
;   512  the description carries the computed Reynolds number, not a typed one
;   1024 no attribute in the emitted document is empty. This bit exists because the
;        first plate had font-size="" on two elements and every other check still
;        passed: I had handed a fraction to int_to_str, and (int_to_str 10.5) answers
;        THREE different ways across the four kernels — "" on fkwu, "10" on go and
;        rust, "10.5" on ts. The band was 1023 on all four while the pictures differed.
;        An empty attribute is the cheap, general shape of that whole class.
;
; This band never writes a file. Emission is a separate verb so that running the proof
; leaves nothing behind.
;
; Byte identity is the stronger claim and it lives outside a band, because a band folds
; to a scalar and cannot compare documents: emit the plate on each kernel and hash it.
; Done 2026-07-26 — one hash across fkwu, Go, Rust and TypeScript.

(do
    (let svg (nsp-svg))
    (let words (nsp-description))
    (let h (nsp-half))
    (let k (nsp-slope))

    (add
        (add
            (add
                (if (and (eq (ns-poiseuille h (sub 0 h)) 0)
                         (eq (ns-poiseuille h h) 0)) 1 0)
                (if (eq (ns-poiseuille h 0) (mul h h)) 2 0))
            (add
                (if (eq (ns-poiseuille h 3) (ns-poiseuille h (sub 0 3))) 4 0)
                (if (and (eq (ns-curvature-poiseuille h 0) (sub 0 2))
                         (and (eq (ns-curvature-poiseuille h 5) (sub 0 2))
                              (eq (ns-curvature-poiseuille h (sub 0 7)) (sub 0 2)))) 8 0)))
        (add
            (add
                (add
                    (if (and (eq (ns-curvature-couette h k 0) 0)
                             (and (eq (ns-curvature-couette h k 5) 0)
                                  (eq (ns-curvature-couette h k (sub 0 7)) 0))) 16 0)
                    (if (and (eq (ns-couette h k (sub 0 h)) 0)
                             (eq (ns-couette h k h) (mul 2 (mul k h)))) 32 0))
                (add
                    (if (gt (str_len svg) 8000) 64 0)
                    (if (and (ge (str_find words (ns-term-name 0) 0) 0)
                        (and (ge (str_find words (ns-term-name 1) 0) 0)
                        (and (ge (str_find words (ns-term-name 2) 0) 0)
                        (and (ge (str_find words (ns-term-name 3) 0) 0)
                             (ge (str_find words (ns-term-name 4) 0) 0))))) 128 0)))
            (add
                (add
                    (if (eq (nsp-scale (nsp-peak)) (nsp-plot-w)) 256 0)
                    (if (ge (str_find words (nsp-n (ns-water-reynolds)) 0) 0) 512 0))
                (if (lt (str_find svg "=\"\"" 0) 0) 1024 0)))))
