; tests/world-model-pair-band.fk — the band for learn/world-model-pair.fk. Verdict 8191.
;
; preludes: form-stdlib/core.fk form-stdlib/world-model-update.fk learn/perturbation-pair.fk learn/world-model-pair.fk
;
; b2 is the finding and it stands alone: the body's own update step fails the HOLD
; probe. Not because refine is wrong — because nothing had ever asked it to stay.
; b1 and b2 together are the inverter's signature on a real organ: the flip lands,
; the hold cannot, and a criterion paying for motion sees only the first.
;
; b13 keeps the size claim honest by measuring it — the whole tunable state of this
; updater is three scalars, so "smaller than an LLM" is a length, not a boast.
;
; PERTURBATION OF THE TOP LEVEL: b12 asks whether the floor changes anything at
; all. If wmp-floored-hold read the same as wmp-open-hold, b2 and b4 would both
; stand while measuring nothing.
;
; witnessed: 2026-08-14 -> 8191 four-way (fkwu / Go / Rust / TS).

(do
    (defn wmpb-k (cond bit) (if cond bit 0))
    (defn world-model-pair-band ()
        (add (add (add (add (add (add (add (add (add (add (add (add (add
            ; the step as it stands lands a real change...
            (wmpb-k (eq (wmp-open-flip) 1) 1)
            ; ...and cannot hold against a flicker. THE FINDING.
            (wmpb-k (eq (wmp-open-hold) 0) 2))
            ; one comparison, and both kinds land
            (wmpb-k (eq (wmp-floored-flip 5.0) 1) 4))
            (wmpb-k (eq (wmp-floored-hold 5.0) 1) 8))
            ; a floor under the noise still chases the flicker
            (wmpb-k (eq (wmp-floored-hold 1.0) 0) 16))
            ; a floor over the signal goes deaf to a real change
            (wmpb-k (eq (wmp-floored-flip 150.0) 0) 32))
            ; the viable band, measured by sweeping eight floors
            (wmpb-k (eq (wmp-ok-count) 4) 64))
            ; its edges, named: 4 is under the noise, 5 is the first that holds
            (wmpb-k (eq (wmp-floor-ok? 4.0) 0) 128))
            (wmpb-k (eq (wmp-floor-ok? 5.0) 1) 256))
            ; 99 still hears the signal, 100 no longer does
            (wmpb-k (eq (wmp-floor-ok? 99.0) 1) 512))
            (wmpb-k (eq (wmp-floor-ok? 100.0) 0) 1024))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: the floor does something
            (wmpb-k (eq (wmp-floor-moves?) 1) 2048))
            ; the size claim, alive: a SHARED floor holds its length across a
            ; twenty-fold world, and the bit falls if the state ever goes per-entity
            (wmpb-k (if (eq (len (wmp-state-shared (wmp-world 2))) 3)
                        (eq (len (wmp-state-shared (wmp-world 40))) 3) 0) 4096))
            ; ...and the per-entity state DOES grow, which is what makes the hold
            ; above a reading rather than a literal's length restated
            (wmpb-k (if (eq (len (wmp-state-per-entity (wmp-world 2))) 4)
                        (eq (len (wmp-state-per-entity (wmp-world 40))) 42) 0) 8192)))
    (world-model-pair-band))
