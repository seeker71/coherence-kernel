; tests/perturbation-pair-band.fk — the band for learn/perturbation-pair.fk. Verdict 4095.
;
; preludes: form-stdlib/core.fk learn/perturbation-pair.fk
;
; A band for a cell about scoring carries the duty benchbench's band carries: it
; perturbs the top level, or it is the failure the cell is about. b12 does that —
; ppair-leak reads differently on two readers. If leak were a constant, b2 and b5
; could not both stand. They do, so the 1 in b5 is computed.
;
; The cell's whole teaching sits in four bits. b4 and b7: the sticker never moves
; and still collects a whole pair. b6 and b7 upside down: the inverter always moves
; and collects none. A criterion paying for motion certifies the second; one paying
; for stillness certifies the first; only asking where the answer landed parts them.
;
; witnessed: 2026-08-14 -> 4095 four-way (fkwu / Go / Rust / TS, all 4095).
; Integers and lists only, so nothing here needs a native the walkers lack.

(do
    (defn ppb-k (cond bit) (if cond bit 0))
    (defn perturbation-pair-band ()
        (add (add (add (add (add (add (add (add (add (add (add
            ; the tracker lands both kinds, and leaks no credit
            (ppb-k (eq (ppair-sum-whole (ppair-tracker)) 2) 1)
            (ppb-k (eq (ppair-leak (ppair-tracker)) 0) 2))
            ; the sticker: one whole pair, and it never moved to get it
            (ppb-k (eq (ppair-sum-whole (ppair-sticker)) 1) 4))
            (ppb-k (eq (ppair-none-moved? (ppair-sticker)) 1) 8))
            (ppb-k (eq (ppair-leak (ppair-sticker)) 1) 16))
            ; the inverter: nothing whole...
            (ppb-k (eq (ppair-sum-whole (ppair-inverter)) 0) 32))
            ; ...and its answers moved on every single probe
            (ppb-k (eq (ppair-all-moved? (ppair-inverter)) 1) 64))
            (ppb-k (eq (ppair-leak (ppair-inverter)) 1) 128))
            ; a suite of flips alone cannot see a reader that always moves
            (ppb-k (eq (ppair-complete? (ppair-flip-only)) 0) 256))
            ; a suite of holds alone cannot see one that never does
            (ppb-k (eq (ppair-complete? (ppair-hold-only)) 0) 512))
            ; the diagnosis separates the three readers: lands / leaks / leaks
            (ppb-k (eq (add (mul (ppair-verdict (ppair-tracker)) 100)
                       (add (mul (ppair-verdict (ppair-sticker)) 10)
                            (ppair-verdict (ppair-inverter)))) 11) 1024))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: leak is not a constant.
            (ppb-k (eq (ppair-leak-moves?) 1) 2048)))
    (perturbation-pair-band))
