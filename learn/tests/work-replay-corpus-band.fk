; work-replay-corpus-band.fk — pins the body's first WORK-REPLAY corpus.
;
; The corpus (learn/work-replay-corpus.jsonl) carries whole EPISODES from the real
; session logs — (context the rented mind saw, the action it took, the recorded
; outcome) — where the distillation corpus carries one-word teachings. Episodes are
; the replay material for sitting a local mind in the work loop; the band is the
; judge of any replay, so the band pins the corpus the replays cite.
;
; Verdict 15 when: the corpus file exists (1), it carries exactly 19 episodes (2),
; all five task types are present (4), and every episode carries a ground_truth
; field (8).
;
; preludes: form-stdlib/core.fk

(do
    (defn wrc-path () "learn/work-replay-corpus.jsonl")

    (defn wrc-count-loop (s patt i acc)
        (do (let j (str_find s patt i))
            (if (lt j 0) acc (wrc-count-loop s patt (add j (str_len patt)) (add acc 1)))))
    (defn wrc-count (s patt) (wrc-count-loop s patt 0 0))

    (defn wrc-has (s patt) (if (ge (str_find s patt 0) 0) 1 0))

    (defn work-replay-corpus-band ()
        (do (let present (fs_exists (wrc-path)))
            (if (eq present 0) 0
                (do (let s (read_file (wrc-path)))
                    (let c0 1)
                    (let c1 (if (eq (wrc-count s "\"id\": \"wr-") 19) 2 0))
                    (let c2 (if (eq (add (wrc-has s "predict-mutation-verdict")
                                   (add (wrc-has s "diagnose-defect-from-symptom")
                                   (add (wrc-has s "write-small-Form-fix")
                                   (add (wrc-has s "answer-from-source")
                                        (wrc-has s "choose-next-probe"))))) 5) 4 0))
                    (let c3 (if (eq (wrc-count s "\"ground_truth\"") 19) 8 0))
                    (add c0 (add c1 (add c2 c3)))))))

    (print (int_to_str (work-replay-corpus-band)))
    0)
