; tests/gender-three-lanes-band.fk — three kinds, two lanes apart, and the pivot
; left genderless on purpose.
;
; preludes: form-stdlib/core.fk form-stdlib/core-lexicon.fk learn/gender-three-lanes.fk
;
; run: ./fkwu learn/tests/gender-three-lanes-band.fk   ; -> 511
;
; S-EXPRESSION ON PURPOSE. energy-center-glands-band.bml carries the same lane law
; and is written in the BML brace surface, so `./fkwu` — the runner every
; receipt in this tree uses — cannot read it, and it has returned verdict=none
; since 2026-07-22 (corpus row 928, mutelaw). A law its judge cannot read is not a
; law. This band is written in the surface its judge speaks.
;
; Verdict 511 when:
;     1  three kinds, and they are the three the cell names
;     2  the LANE LAW holds: no kind claims evidence rank while being belief
;     4  every kind is PLACED — none is left to drift into the core by default
;     8  Sanskrit's three linga resolve, and the count is three
;    16  THE FALSIFIER: nouns exist whose class does not follow the sex of their
;        referent. If this list were empty, linga would be a claim about beings and
;        would belong in the belief lane with the archetypes.
;    32  the archetypal pairs are BELIEF, carry their tradition, and name a union
;    64  THE PIVOT INVARIANT: `they` and `it` are IN the core 64; `he` and `she`
;        are NOT. Checked against core-lexicon.fk itself, not against a copy.
;   128  the body's own emptiness is recorded, not filled: the Steiner graph has no
;        gender polarity and the Sanskrit cells have no linga
;   256  honest absence — a kind the cell does not carry answers nothing

(do
    (defn g3b-score (ok bit) (if ok bit 0))

    ; is a word among the core 64? asked with core-lexicon.fk's OWN predicate, so
    ; the question is put to the cell that holds the vocabulary rather than to a
    ; copy of it that could drift.
    (defn g3b-in-core (w) (cl-is-word? w))

    (defn g3b-all-absent (ws)
        (if (eq (len ws) 0) 1
            (if (eq (g3b-in-core (head ws)) 0) (g3b-all-absent (tail ws)) 0)))
    (defn g3b-all-present (ws)
        (if (eq (len ws) 0) 1
            (if (eq (g3b-in-core (head ws)) 1) (g3b-all-present (tail ws)) 0)))

    ; every mismatch row is complete and names one of the three linga
    (defn g3b-linga-known-loop (ls k)
        (if (eq (len ls) 0) 0 (if (str_eq (head ls) k) 1 (g3b-linga-known-loop (tail ls) k))))
    (defn g3b-mismatch-ok-loop (ms)
        (if (eq (len ms) 0) 1
            (if (eq (len (head ms)) 3)
                (if (eq (g3b-linga-known-loop (g3-linga) (nth (head ms) 2)) 1)
                    (g3b-mismatch-ok-loop (tail ms)) 0) 0)))

    ; every pair carries two poles and a tradition
    (defn g3b-pairs-ok-loop (ps)
        (if (eq (len ps) 0) 1
            (if (eq (len (head ps)) 3)
                (if (gt (str_len (nth (head ps) 2)) 0) (g3b-pairs-ok-loop (tail ps)) 0) 0)))

    (defn gender-three-lanes-band ()
        (do
            (let c0 (g3b-score (if (eq (len (g3-kinds)) (g3-kind-count))
                                   (if (eq (g3-known? (g3-find "linga")) 1)
                                       (if (eq (g3-known? (g3-find "sex")) 1)
                                           (g3-known? (g3-find "polarity")) 0) 0) 0) 1))
            (let c1 (g3b-score (eq (g3-lane-law?) 1) 2))
            (let c2 (g3b-score (eq (g3-all-placed?) 1) 4))
            (let c3 (g3b-score (if (eq (len (g3-linga)) (g3-linga-count))
                                   (eq (g3-linga-count) 3) 0) 8))
            ; the falsifier: the list must be NON-EMPTY, and every row well formed
            (let c4 (g3b-score (if (gt (len (g3-mismatches)) 0)
                                   (g3b-mismatch-ok-loop (g3-mismatches)) 0) 16))
            (let c5 (g3b-score (if (eq (g3-kind-lane (g3-find "polarity")) (g3-lane-belief))
                                   (if (eq (len (g3-pairs)) (g3-pair-count))
                                       (if (eq (g3b-pairs-ok-loop (g3-pairs)) 1)
                                           (if (gt (str_len (g3-union)) 0) 1 0) 0) 0) 0) 32))
            ; THE PIVOT INVARIANT, asked of core-lexicon.fk
            (let c6 (g3b-score (if (eq (g3b-all-absent (g3-core-must-lack)) 1)
                                   (g3b-all-present (g3-core-must-hold)) 0) 64))
            (let c7 (g3b-score (if (eq (g3-steiner-graph-has-gender-polarity?) 0)
                                   (if (eq (g3-sanskrit-cells-have-linga?) 0)
                                       (gt (str_len (g3-steiner-graph-polarity)) 0) 0) 0) 128))
            (let c8 (g3b-score (eq (g3-known? (g3-find "chromosome")) 0) 256))
            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 c8)))))))))
        )
    (gender-three-lanes-band))
