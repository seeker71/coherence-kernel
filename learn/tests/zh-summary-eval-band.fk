; tests/zh-summary-eval-band.fk — the band for learn/zh-summary-eval.fk. Verdict 1023.
;
; preludes: form-stdlib/core.fk learn/zh-summary-eval.fk
;
; Four of these ten bits exist to catch the cell answering in the body's favour
; whatever comes: b2 a losing batch earns nothing, b3 an unblind one, b4 a short
; one, b10 an empty one. A rule that said "earned" whatever arrived would pass b1
; alone and fall on every one of those.
;
; b8 PERTURBS THE TOP LEVEL: the reading has to move between a winning batch and a
; losing one, or ze-earned? is a constant and b1 means nothing.
;
; b9 pins the pre-registered floor at 20. It is here so the number cannot drift
; quietly later — a floor lowered after seeing the outputs is the same fake as a
; metric written after them.
;
; witnessed: 2026-08-14 -> 1023 four-way (fkwu / Go / Rust / TS).

(do
    (defn zeb-k (cond bit) (if cond bit 0))
    (defn zh-summary-eval-band ()
        (add (add (add (add (add (add (add (add (add
            ; blind, long enough, and reaching: earned
            (zeb-k (eq (ze-earned? (ze-win-batch) 1) 1) 1)
            ; falling short of the rented total: not earned
            (zeb-k (eq (ze-earned? (ze-lose-batch) 1) 0) 2))
            ; winning but NOT blind: not earned
            (zeb-k (eq (ze-earned? (ze-win-batch) 0) 0) 4))
            ; winning and blind but one item short of the floor: not earned
            (zeb-k (eq (ze-earned? (ze-short-batch) 1) 0) 8))
            ; a tie IS earned — "at least as good" is the claim under test
            (zeb-k (eq (ze-earned? (ze-tie-batch) 1) 1) 16))
            ; the sums are computed, not stipulated: 20 items x 8 native, x 7 rented
            (zeb-k (eq (ze-sum-nat (ze-win-batch)) 160) 32))
            (zeb-k (eq (ze-sum-rent (ze-win-batch)) 140) 64))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: win and loss read apart
            (zeb-k (eq (ze-rule-moves?) 1) 128))
            ; the pre-registered floor, pinned so it cannot drift later
            (zeb-k (eq (ze-floor) 20) 256))
            ; nothing at all earns nothing
            (zeb-k (eq (ze-earned? (empty) 1) 0) 512)))
    (zh-summary-eval-band))
