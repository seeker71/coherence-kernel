; work-replay-sense-band.fk — proves the WORK-REPLAY loop's reader, sensing, salience,
; and living rows.
;
; The sensing organ lives in form-cli-judge.fk (fcj-sense-*); the replay-specific tables,
; salience and row shape live in learn/work-replay-sense.fk; this band is the proof for
; both. The scanner reads the real corpus; the matcher kinds answer on synthetic truth
; knowable by eye; the judge is anchored on wr-02, the episode the rented mind missed —
; a continuation repeating the rented 251 answer senses red or the judge is broken. A
; sense that cannot fail is not a sense: every bit here has one independent anchor and
; the battery mutates each in turn.
;
; Verdict 8191 when:
;   bit    1  the corpus parses to exactly 19 episodes
;   bit    2  escape decode: wr-01's context carries a real newline and ends "the band prints"
;   bit    4  \u decode: wr-13's ground truth carries the em dash as three UTF-8 bytes
;   bit    8  the type census reads 4/5/4/3/3 across the five task types
;   bit   16  digit boundary: "249" unfound inside "2492492854", found beside a period,
;             found past an earlier bad occurrence (the rescan)
;   bit   32  word boundary: "mod" unfound inside "model", found after an open paren
;   bit   64  paren run: exactly thirteen senses; twelve and fourteen both lose
;   bit  128  the wr-02 anchor: 187 senses green, the rented 251 answer senses red,
;             naming both dark bits senses green
;   bit  256  every one of the 19 episodes has a non-empty judge
;   bit  512  the corpus's own record: 18 rented hits of 19, and wr-02 is the miss
;   bit 1024  salience: 90 beyond-record hit, 60 miss-where-carried, 30 fed-back green,
;             10 double miss, 0 expected hit; the floor flags exactly the loud two
;   bit 2048  living rows: a row's ten fields survive the roundtrip, and the latest
;             row per id wins the current view while history keeps both
;   bit 4096  the closest group: a half-matched pair beats a zero-matched single,
;             and a full group reads matched = size
;
; preludes: form-stdlib/core.fk learn/work-replay-sense.fk

(do
    (defn wrsb-count-judged (eps acc)
        (if (eq (len eps) 0) acc
            (wrsb-count-judged (tail eps)
                (add acc (if (gt (len (wrs-judge (wrs-ep-id (head eps)))) 0) 1 0)))))
    (defn wrsb-sum-rented (eps acc)
        (if (eq (len eps) 0) acc
            (wrsb-sum-rented (tail eps) (add acc (wrs-ep-rented (head eps))))))

    (defn work-replay-sense-band ()
        (do (let eps (wrs-episodes))
            (let c0 (if (eq (len eps) 19) 1 0))

            (let ctx1 (wrs-ep-ctx (wrs-ep-for-id eps "wr-01")))
            (let tail1 "the band prints")
            (let c1 (if (and (ge (str_find ctx1 (byte_to_str 10) 0) 0)
                             (str_eq (substring ctx1 (sub (str_len ctx1) (str_len tail1)) (str_len ctx1)) tail1))
                        2 0))

            (let c2 (if (ge (str_find (wrs-ep-gt (wrs-ep-for-id eps "wr-13")) (wrs-utf8 8212) 0) 0) 4 0))

            (let c3 (if (and (eq (wrs-eps-count-of-type eps "predict-mutation-verdict" 0) 4)
                        (and (eq (wrs-eps-count-of-type eps "diagnose-defect-from-symptom" 0) 5)
                        (and (eq (wrs-eps-count-of-type eps "write-small-Form-fix" 0) 4)
                        (and (eq (wrs-eps-count-of-type eps "answer-from-source" 0) 3)
                             (eq (wrs-eps-count-of-type eps "choose-next-probe" 0) 3)))))
                        8 0))

            (let c4 (if (and (eq (fcj-sense-scan "code 2492492854 here" "249" 1 0) 0)
                        (and (eq (fcj-sense-scan "the band prints 249." "249" 1 0) 1)
                             (eq (fcj-sense-scan "2492492854 and then 249." "249" 1 0) 1)))
                        16 0))
            (let c5 (if (and (eq (fcj-sense-scan "the model answers" "mod" 2 0) 0)
                             (eq (fcj-sense-scan "use (mod 97 257) here" "mod" 2 0) 1))
                        32 0))
            (let run13 "0)))))))))))))")
            (let c6 (if (and (eq (fcj-sense-scan (str_concat "ends " run13) run13 3 0) 1)
                        (and (eq (fcj-sense-scan (str_concat "ends " (str_concat run13 ")")) run13 3 0) 0)
                             (eq (fcj-sense-scan "ends 0))))))))))))" run13 3 0) 0)))
                        64 0))

            (let c7 (if (and (eq (wrs-sense-carries? "the band prints 187" "wr-02") 1)
                        (and (eq (wrs-sense-carries? "the band prints 251, only bit 4 goes dark" "wr-02") 0)
                             (eq (wrs-sense-carries? "Bit 4 and bit 64 both go dark" "wr-02") 1)))
                        128 0))

            (let c8 (if (eq (wrsb-count-judged eps 0) 19) 256 0))

            (let c9 (if (and (eq (wrsb-sum-rented eps 0) 18)
                             (eq (wrs-ep-rented (wrs-ep-for-id eps "wr-02")) 0))
                        512 0))

            (let c10 (if (and (eq (wrs-salience 1 0 1) 90)
                         (and (eq (wrs-salience 0 1 1) 60)
                         (and (eq (wrs-salience 1 1 2) 30)
                         (and (eq (wrs-salience 0 0 1) 10)
                         (and (eq (wrs-salience 1 1 1) 0)
                         (and (eq (ss-salient? (list "a" (wrs-salience 1 0 1)) (wrs-salience-floor)) 1)
                         (and (eq (ss-salient? (list "b" (wrs-salience 0 1 1)) (wrs-salience-floor)) 1)
                         (and (eq (ss-salient? (list "c" (wrs-salience 1 1 2)) (wrs-salience-floor)) 0)
                              (eq (ss-salient? (list "d" (wrs-salience 0 0 1)) (wrs-salience-floor)) 0)))))))))
                        1024 0))

            (let r1 (wrs-row "wr-77" "answer-from-source" "dsr1q32" 2 1 3 3 0 90 12345))
            (let r2 (wrs-row "wr-77" "answer-from-source" "dsr1q32" 1 0 1 3 0 60 999))
            (let r3 (wrs-row "wr-78" "choose-next-probe" "dsr1q32" 1 1 2 2 1 0 500))
            (let latest (wrs-latest-rows (list r1 r2 r3)))
            (let c11 (if (and (str_eq (wrs-row-id r1) "wr-77")
                         (and (str_eq (wrs-row-type r1) "answer-from-source")
                         (and (str_eq (wrs-row-lane r1) "dsr1q32")
                         (and (eq (wrs-row-attempts r1) 2)
                         (and (eq (wrs-row-sensed r1) 1)
                         (and (eq (wrs-row-coverm r1) 3)
                         (and (eq (wrs-row-covert r1) 3)
                         (and (eq (wrs-row-rented r1) 0)
                         (and (eq (wrs-row-sal r1) 90)
                         (and (eq (wrs-row-ms r1) 12345)
                         (and (eq (len latest) 2)
                              (eq (wrs-row-sensed (head (wrs-latest-rows (list r1 r2)))) 0))))))))))))
                        2048 0))

            (let best02 (wrs-sense-best "the band prints 251, only bit 4 goes dark" "wr-02"))
            (let full02 (wrs-sense-best "the band prints 187" "wr-02"))
            (let c12 (if (and (eq (nth best02 0) 1)
                         (and (eq (nth best02 1) 2)
                              (eq (nth full02 0) (nth full02 1))))
                        4096 0))

            (add c0 (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7
                (add c8 (add c9 (add c10 (add c11 c12))))))))))))))

    (print (int_to_str (work-replay-sense-band)))
    0)
