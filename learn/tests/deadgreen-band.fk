; tests/deadgreen-band.fk — the band for learn/deadgreen.fk. Verdict 255.
;
; preludes: form-stdlib/core.fk learn/benchbench.fk form-stdlib/world-model-update.fk learn/world-model-pair.fk learn/deadgreen.fk
;
; b1 is the shape the cell is named for: a len over a fixed literal never moves,
; whatever arrives. That is holo-boundary-size, and it was the first wmp-state.
;
; b5 and b6 are the body's own rating of it, asked of benchbench rather than
; restated: bb-score calls constant-green 0 and the four-way diagnosis 2. Without
; b6, b5 could be a scorer that answers 0 to everything.
;
; b8 PERTURBS THE TOP LEVEL: dg-alive? has to read differently on a dead check and
; a live one, or every bit above is one number wearing two names.
;
; witnessed: 2026-08-14 -> 255 four-way (fkwu / Go / Rust / TS).

(do
    (defn dgb-k (cond bit) (if cond bit 0))
    (defn deadgreen-band ()
        (add (add (add (add (add (add (add
            ; a len over a literal cannot move: DEAD
            (dgb-k (eq (dg-alive? 1) 0) 1)
            ; a per-entity state length grows with the world: ALIVE
            (dgb-k (eq (dg-alive? 2) 1) 2))
            ; a shared state length is constant — dead ON ITS OWN
            (dgb-k (eq (dg-alive? 3) 0) 4))
            ; ...and honest only because the live neighbour parts from it
            (dgb-k (eq (dg-pair-parts? 2 3) 1) 8))
            ; the body's own instrument already rates this shape fake...
            (dgb-k (eq (bb-score (bb-tag-constant-green)) 0) 16))
            ; ...and is not simply answering 0 to everything
            (dgb-k (eq (bb-score (bb-tag-diagnosis)) 2) 32))
            ; the sweep really sweeps: the observations differ
            (dgb-k (eq (dg-obs-differ?) 1) 64))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: dead and live read apart
            (dgb-k (if (eq (dg-alive? 1) (dg-alive? 2)) 0 1) 128)))
    (deadgreen-band))
