; tests/act-token-band.fk — the band for learn/act-token.fk. Verdict 1023.
;
; preludes: form-stdlib/core.fk learn/perturbation-pair.fk learn/act-token.fk
;
; b3 and b4 are the pair that makes this an alternative CHOICE rather than an
; intrusion: on a word-only stream the loop is byte-for-byte the plain argmax it
; replaces, and on a stream where an act wins it produces what plain argmax
; cannot. A lane that never fires would pass b3 and fall on b4; one that always
; fires does the reverse. b10 folds them and takes credit only for both.
;
; b6 is the honest half of the whole design: an act the native lane cannot serve
; answers with the escalation sentinel rather than a value. A fabricated result
; here would be indistinguishable from a served one downstream.
;
; b9 PERTURBS THE TOP LEVEL: healthy and unhealthy streams have to read apart, or
; atk-escalated is a constant and b7/b8 mean nothing.
;
; witnessed: 2026-08-14 -> 1023 four-way (fkwu / Go / Rust / TS).

(do
    (defn atb-k (cond bit) (if cond bit 0))
    (defn act-token-band ()
        (add (add (add (add (add (add (add (add (add
            ; the choice the loop already makes, unchanged
            (atb-k (eq (atk-argmax (atk-lw)) 2) 1)
            ; one index space: words below the split, acts at or above it
            (atb-k (if (eq (atk-word? 2) 1) (eq (atk-act? 6) 1) 0) 2))
            ; HOLD — with no act winning, the loop IS the plain argmax
            (atb-k (eq (atk-holds) 1) 4))
            ; FLIP — with an act winning, it produces what argmax cannot
            (atb-k (eq (atk-moves) 1) 8))
            ; the servable act runs and its result folds into the stream
            (atb-k (eq (atk-step (atk-la)) 42) 16))
            ; the unservable one says so instead of inventing a value
            (atb-k (eq (atk-step (atk-lu)) (atk-escalate)) 32))
            ; a stream that stayed inside the membrane owes the next layer nothing
            (atb-k (eq (atk-escalated (atk-with-act)) 0) 64))
            ; a stream that crossed out owes it exactly one step
            (atb-k (eq (atk-escalated (atk-with-unserved)) 1) 128))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: the two read apart
            (atb-k (if (eq (atk-escalated (atk-with-act))
                           (atk-escalated (atk-with-unserved))) 0 1) 256))
            ; the pair, whole: an alternative choice, not an intrusion
            (atb-k (eq (atk-whole) 1) 512)))
    (act-token-band))
