; homecoming-work-census-band.fk — proof of the homecoming work census and its slice scoring.
;
; preludes: form-stdlib/core.fk form-stdlib/str-byte-at.fk learn/homecoming-distillation-corpus.fk learn/homecoming-work-census.fk
;
; Covers: the census rows are well-formed and their counts reach exactly the window's 199
; receipts (the metrics-report discipline — this band answers differently the day the census
; drifts from its own total); every slice id locates a real, admissible corpus row with a
; nonempty answer and fresh word (the mirror is read, never copied); the ASCII lowering, the
; substring hit, the fresh-word fallback, and the miss each answer on synthetic truth the band
; states inline; and the tally folds a mixed list to the number the reader can count by eye.
;
; run FROM THE REPO ROOT, resolver-driven:
;      ./fkwu --src learn/tests/homecoming-work-census-band.fk    ; -> 2047
; or four-way through the sibling kernels:
;      cd form && ./validate.sh ../learn/tests/homecoming-work-census-band.fk
;
; Verdict 2047 = eleven claims, power-of-two weights (reference-verdict-fold-2-53-ceiling:
; bit weights, never decimal digits). 1023 -> 2047 on 2026-08-09: one bit for the one-byte
; stem, added when the R1-32B lane's real transcript said "winsorizing" and the exact
; substring called the recorded "winsorize" a miss.

(do
    (defn hwcb-bit (ok w) (if ok w 0))

    ; c1 (1): eight census rows, each carrying five fields
    (defn hwcb-rows-shaped-loop (rs)
        (if (eq (len rs) 0) 1
            (if (eq (len (head rs)) 5) (hwcb-rows-shaped-loop (tail rs)) 0)))
    (let c1 (hwcb-bit (and (eq (len (hwc-tasks)) 8)
                           (eq (hwcb-rows-shaped-loop (hwc-tasks)) 1)) 1))

    ; c2 (2): the primary-type counts sum to the window's receipt count exactly
    (let c2 (hwcb-bit (eq (hwc-total) (hwc-window-receipts)) 2))

    ; c3 (4): every slice id resolves to a corpus row that is admissible teacher material
    (defn hwcb-slice-ok-loop (ids)
        (if (eq (len ids) 0) 1
            (do (let r (hdc-row-for-id (head ids)))
                (if (eq (len r) 0) 0
                    (if (eq (hdc-admissible? r) 1) (hwcb-slice-ok-loop (tail ids)) 0)))))
    (let c3 (hwcb-bit (and (eq (len (hwc-slice-ids)) 10)
                           (eq (hwcb-slice-ok-loop (hwc-slice-ids)) 1)) 4))

    ; c4 (8): each slice row's answer and fresh word are nonempty, read from the corpus
    (defn hwcb-slice-words-loop (ids)
        (if (eq (len ids) 0) 1
            (do (let r (hdc-row-for-id (head ids)))
                (if (and (gt (str_len (hdc-a r)) 0) (gt (str_len (hdc-fresh r)) 0))
                    (hwcb-slice-words-loop (tail ids)) 0))))
    (let c4 (hwcb-bit (eq (hwcb-slice-words-loop (hwc-slice-ids)) 1) 8))

    ; c5 (16): lowering folds A..Z and touches nothing else
    (let c5 (hwcb-bit (str_eq (hwc-lower "AbC-Z z9") "abc-z z9") 16))

    ; c6 (32): a direct answer in mixed case is a hit
    (let c6 (hwcb-bit (eq (hwc-hit? "The word is Clusivity." "clusivity" "clusivity") 1) 32))

    ; c7 (64): unrelated text is a miss
    (let c7 (hwcb-bit (eq (hwc-hit? "i do not know that word" "clusivity" "clusivity") 0) 64))

    ; c8 (128): a hyphenated answer spoken apart still lands through the fresh word
    (let c8 (hwcb-bit (eq (hwc-hit? "the normalization of deviance"
                                    "deviance-normalization" "deviance") 1) 128))

    ; c9 (256): the tally over a mixed list counts exactly the hits
    (let c9 (hwcb-bit (eq (hwc-hits (list
                (list "it is epoche" "epoche" "epoche")
                (list "no idea" "homoplasy" "homoplasy")
                (list "a Gettier case" "gettier" "gettier"))) 2) 256))

    ; c10 (512): the prompt carries the question's own tokens and the completion cue
    (let p (hwc-prompt-for (list "what" "names" "x")))
    (let c10 (hwcb-bit (and (ge (str_find p "what names x" 0) 0)
                            (ge (str_find p "single word" 0) 0)) 512))

    ; c11 (1024): an inflected answer still lands through the one-byte stem — the R1-32B
    ; lane's own witnessed case, "winsorizing" for "winsorize" (2026-08-09)
    (let c11 (hwcb-bit (and (eq (hwc-hit? "the answer is winsorizing" "winsorize" "winsorize") 1)
                            (eq (hwc-hit? "no clue" "winsorize" "winsorize") 0)) 1024))

    (let verdict (add c1 (add c2 (add c3 (add c4 (add c5 (add c6 (add c7 (add c8 (add c9 (add c10 c11)))))))))))
    (print verdict)
    verdict)
