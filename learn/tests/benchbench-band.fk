; tests/benchbench-band.fk — the band for learn/benchbench.fk. Verdict 4095.
;
; preludes: form-stdlib/core.fk learn/benchbench.fk
;
; A band for a cell about bands has one extra duty: it must perturb the top
; level, or it is exactly the failure the cell is about. b12 does that —
; bbbb-flat-score feeds the level-4 instrument a triple that does not vary, and
; demands 0. If the level-4 measurement were constant, b10 and b12 could not
; both stand. They do, so the 2 in b10 is computed.
;
; witnessed: 2026-07-25 -> band 4095 four-way (fkwu / Go / Rust / TS, all 4095).
; The arithmetic is integers and lists only, so nothing here needs a native the
; walkers lack — and per this cell's own rule, four agreeing arms is not the
; measurement; b12 is.

(do
    (defn bbb-k (cond bit) (if cond bit 0))
    (defn benchbench-band ()
        (add (add (add (add (add (add (add (add (add (add (add
            ; the two fakes score nothing — neither perturbation moves them
            (bbb-k (eq (bb-score (bb-tag-parse-to-zero)) 0) 1)
            (bbb-k (eq (bb-score (bb-tag-constant-green)) 0) 2))
            ; agreement notices a disagreement but cannot say which arm
            (bbb-k (eq (bb-score (bb-tag-agreement)) 1) 4))
            ; a tally counts values; it still cannot locate the odd one
            (bbb-k (eq (bb-score (bb-tag-distinct-tally)) 1) 8))
            ; the body's own four-way-verdict shape separates both probes
            (bbb-k (eq (bb-score (bb-tag-diagnosis)) 2) 16))
            ; BenchBench over three suites: 2 real / 1-1-1 mixed / 2 fake
            (bbb-k (eq (bb-bench (bb-suite-all-real)) 20000) 32))
            (bbb-k (eq (bb-bench (bb-suite-mixed)) 10101) 64))
            (bbb-k (eq (bb-bench (bb-suite-all-fake)) 2) 128))
            ; BenchBenchBench: BenchBench is itself a real benchmark
            (bbb-k (eq (bbb-score) 2) 256))
            ; the level above it returns the same 2
            (bbb-k (eq (bbbb-score) 2) 512))
            ; ...which is the fixed point, stated as a value
            (bbb-k (eq (bb-fixed-point?) 1) 1024))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: a flat triple must
            ; measure nothing. Without this, b10's 2 could be a constant.
            (bbb-k (eq (bbbb-flat-score) 0) 2048)))
    (benchbench-band))
