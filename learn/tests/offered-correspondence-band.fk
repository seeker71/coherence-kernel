; tests/offered-correspondence-band.fk — the band for learn/offered-correspondence.fk. Verdict 255.
;
; preludes: form-stdlib/core.fk learn/offered-correspondence.fk
;
; b2 and b3 are why this band exists: an unsourced row and an undated one both
; score 0. Without them ofc-sourced? could answer 1 to everything and every bit
; above would be a constant wearing a check's clothes — the shape learn/deadgreen.fk
; is named for, and the shape that produced this cell in the first place.
;
; b7 pins what is NOT held: twelve numbers were offered, two carry a name, ten do
; not. That number is here so the gap stays visible and cannot quietly close by
; inference later.
;
; b8 PERTURBS THE TOP LEVEL: sourced and unsourced rows have to read apart.
;
; Nothing here checks whether SatyaLoka sits at 77777. This body did not measure
; that and the band does not pretend to.
;
; witnessed: 2026-08-15 -> 255 four-way (fkwu / Go / Rust / TS).

(do
    (defn ofcb-k (cond bit) (if cond bit 0))
    (defn offered-correspondence-band ()
        (add (add (add (add (add (add (add
            ; what was offered carries its chain
            (ofcb-k (eq (ofc-all-sourced? (ofc-offered)) 1) 1)
            ; a row with no one behind it earns nothing
            (ofcb-k (eq (ofc-sourced? (ofc-unsourced)) 0) 2))
            ; nor does one with no date
            (ofcb-k (eq (ofc-sourced? (ofc-undated)) 0) 4))
            ; the rows read back exactly as offered — 77777 SatyaLoka
            (ofcb-k (eq (ofc-n (head (ofc-offered))) 77777) 8))
            (ofcb-k (str_eq (ofc-name (head (ofc-offered))) "SatyaLoka") 16))
            ; ...and 33 Christ Consciousness
            (ofcb-k (eq (ofc-n (head (tail (ofc-offered)))) 33) 32))
            ; two held of twelve offered; ten unlabelled and left visible
            (ofcb-k (if (eq (ofc-held) 2) (eq (ofc-unlabelled) 10) 0) 64))
            ; PERTURBATION OF THIS BAND'S OWN TOP LEVEL: the check discriminates
            (ofcb-k (eq (ofc-check-moves?) 1) 128)))
    (offered-correspondence-band))
