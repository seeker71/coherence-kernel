// Frozen practice for the compact form.bml surface, and separate transfer rows.
// A reference enters the manifest only after ./fkwu executes it.
// Transfer prompts stay out of the gradient.
// preludes: learn/bml-execution-practice.bml
section [form.bml] {
 class BmlCompactPractice {
  def bcp-rule() = "Write repository form.bml. Return only code. Operators may be spaced or joined: a+b*2 is a + (b * 2). "
   ++ "c ? t : e chooses t when c is present and nonzero, otherwise e. lo .. hi includes lo and excludes hi. "
   ++ "xs |> map(f) maps f across xs, order kept; xs |> filter(p) keeps the items where p is true; xs |> foldl(f, start) folds with f(acc, item). "
   ++ "|> passes its input once as the final argument. n => expr and (a, b) => expr are lexical functions. "
   ++ "a ++ b joins strings. xs[i] is item i, counted from 0. "
   ++ "try e else h and choice { e1; e2 } recover from nothing. x ?? y is y when x is nothing. A blank string is present, so a gate turns it away: nothing?(v) || str_len(v) == 0 ? nothing() : v. "
   ++ "undo(a, saved, fresh) answers saved when a is nothing, otherwise fresh; store(v) names a checkpoint and restore(saved) returns it. "
   ++ "n |> cut(lanes) offers n to the first lane only and answers its acknowledgement, present or nothing(); a lane lands v with oac-one(intern_trivial_int(v)) and declines with nothing(); node_value(oac-payload(ack)) reads the landed value. "
   ++ "match x { 1 | 2 => a, _ => b } selects by value. let [a, _, c] = xs; binds by position. "
   ++ "defer e; runs e when the body ends, last defer first, even when the body stops. "
   ++ "class C : Disposable<Int> { def dispose(h) = release(h); } names how a handle is released; defer C_dispose(h); releases it. "
   ++ "retry-first(n, pause, f) answers the first present f(i) for i from 0, else nothing(). "
   ++ "wait-until(f, deadline, pause) answers 1 when f() is true, 0 once host_monotonic_ms() passes deadline. "
   ++ "Calls use parentheses. nothing() is absent; 0 is present. ";
  def bcp-row(id,contract,code,checks) = bep-row(id,bcp-rule() ++ contract,code,"print(list(" ++ checks ++ "));","[1, 1, 1, 1, 1, 1]","code");
  def bcp-effect(id,contract,code,checks,expected) = bep-row(id,bcp-rule() ++ contract,code,checks,expected,"code");
  def bcp-training() = list(
   bcp-row("kept","Implement kept(n): return n when n is greater than 0, otherwise 0. Use the ternary ? :.","def kept(n) = n > 0 ? n : 0;","eq(kept(5),5),eq(kept(1),1),eq(kept(0),0),eq(kept(0 - 2),0),eq(kept(0 - 9),0),eq(kept(8),8)"),
   bcp-row("span-twice","Bind doubled to the half-open range 1 .. 4 mapped by a named function twice(n) = n * 2, using .. and |>.","def twice(n) = n * 2;\nlet doubled = 1 .. 4 |> map(twice);","eq(head(doubled),2),eq(head(tail(doubled)),4),eq(head(tail(tail(doubled))),6),eq(len(doubled),3),eq(twice(1),2),eq(twice(4),8)"),
   bcp-row("span-lam","Bind lam to the half-open range 2 .. 5 mapped by the lambda n => n * 2, using .. and |>.","let lam = 2 .. 5 |> map(n => n * 2);","eq(head(lam),4),eq(head(tail(lam)),6),eq(head(tail(tail(lam))),8),eq(len(lam),3),eq(head(lam) + head(tail(lam)),10),eq(head(tail(tail(lam))) - 8,0)"),
   bcp-row("recovered","Implement recovered() with try nothing() else 3, and chosen() with choice { nothing(); 4 }.","def recovered() = try nothing() else 3;\ndef chosen() = choice { nothing(); 4 };","eq(recovered(),3),eq(chosen(),4),eq(recovered() + chosen(),7),eq(recovered() - 3,0),eq(chosen() - 4,0),eq(chosen() - recovered(),1)"),
   bcp-row("named","Implement named(x): return x unless x is nothing, in which case return 7. Use ??.","def named(x) = x ?? 7;","eq(named(nothing()),7),eq(named(1),1),eq(named(0),0),eq(named(0 - 2),0 - 2),eq(named(7),7),eq(named(nothing()) - 7,0)"),
   bcp-row("banner","Implement banner(s): return s followed by an exclamation mark. Join with ++.","def banner(s) = s ++ \"!\";","value_eq(banner(\"hi\"),\"hi!\"),value_eq(banner(\"\"),\"!\"),value_eq(banner(\"ab\"),\"ab!\"),eq(str_len(banner(\"xyz\")),4),value_eq(banner(banner(\"a\")),\"a!!\"),eq(str_len(banner(\"\")),1)"),
   bcp-row("third","Implement third(xs): return the item at position 2, counted from 0. Use xs[i].","def third(xs) = xs[2];","eq(third(list(1,2,3)),3),eq(third(list(9,8,7,6)),7),eq(third(list(0,0,5)),5),eq(third(list(4,5,0 - 6)),0 - 6),eq(third(list(1,1,1,1,1)),1),eq(third(list(0,0,0)),0)"),
   bcp-row("digit","Implement digit(n): return 10 when n is 1, 20 when n is 2 or 3, otherwise 0. Use match with | and _.","def digit(n) = match n { 1 => 10, 2 | 3 => 20, _ => 0 };","eq(digit(1),10),eq(digit(2),20),eq(digit(3),20),eq(digit(4),0),eq(digit(0),0),eq(digit(0 - 1),0)"),
   bcp-row("middle","Implement middle(xs): return the second item of a three-item list. Bind it with let [_, b, _] = xs;","def middle(xs) {\n let [_, b, _] = xs;\n b;\n}","eq(middle(list(1,2,3)),2),eq(middle(list(9,0,9)),0),eq(middle(list(4,5,6)),5),eq(middle(list(0,0 - 7,0)),0 - 7),eq(middle(list(1,8,1)),8),eq(middle(list(2,2,2)),2)"),
   bcp-row("scaled","Implement scaled(a,b): return a times b plus 1. Write the operators without spaces.","def scaled(a,b) = a*b+1;","eq(scaled(2,3),7),eq(scaled(0,5),1),eq(scaled(4,0),1),eq(scaled(1,1),2),eq(scaled(3,3),10),eq(scaled(0 - 2,3),0 - 5)"),
   bcp-row("positives","Implement positives(xs): return the items of xs greater than 0, order kept. Use |> filter with a lambda.","def positives(xs) = xs |> filter(x => x > 0);","eq(len(positives(list(1,0 - 2,3))),2),eq(head(positives(list(0 - 1,4))),4),eq(len(positives(list())),0),eq(len(positives(list(0,0))),0),eq(head(tail(positives(list(5,6)))),6),eq(len(positives(list(1,2,3))),3)"),
   bcp-row("total","Implement total(xs): return the sum of xs. Use |> foldl with a two-argument lambda and start 0.","def total(xs) = xs |> foldl((s,x) => s + x,0);","eq(total(list(1,2,3)),6),eq(total(list()),0),eq(total(list(5)),5),eq(total(list(0 - 2,2)),0),eq(total(list(10,20)),30),eq(total(list(4,0,0)),4)"),
   bcp-row("second-try","Implement second-try(): use retry-first with 4 tries, no pause, and an attempt i that answers nothing() when i is 0 and 100 + i otherwise.","def second-try() = retry-first(4, 0, i => i == 0 ? nothing() : 100 + i);","eq(second-try(),101),eq(second-try() - 100,1),eq(second-try() + 1,102),eq(second-try() * 2,202),eq(second-try() ?? 0,101),eq(second-try() - second-try(),0)"),
   bcp-row("timed-out","Implement timed-out(): use wait-until on a lambda that is never ready, with the deadline host_monotonic_ms() + 20 and no pause.","def timed-out() = wait-until(() => 0, host_monotonic_ms() + 20, 0);","eq(timed-out(),0),eq(timed-out() + 1,1),eq(timed-out() - 0,0),eq(timed-out() * 3,0),eq(timed-out() ?? 9,0),eq(timed-out() + timed-out(),0)"),
   bcp-row("tongue","Implement tongue(a, b): return a when it is a non-empty string, else b when it is a non-empty string, else \"none\". Gate each reading with arrived(v), which answers nothing() for nothing or a blank string, then walk them with choice { }.","def arrived(v) = nothing?(v) || str_len(v) == 0 ? nothing() : v;\ndef tongue(a, b) = choice { arrived(a); arrived(b); \"none\" };","value_eq(tongue(\"en\",\"fr\"),\"en\"),value_eq(tongue(\"\",\"fr\"),\"fr\"),value_eq(tongue(\"\",\"\"),\"none\"),value_eq(tongue(nothing(),\"de\"),\"de\"),value_eq(tongue(\"x\",\"\"),\"x\"),value_eq(tongue(nothing(),nothing()),\"none\")"),
   bcp-row("grown","Implement grown(watch, held): return held when watch is nothing(), otherwise held with watch added in front. Use undo(ack, checkpoint, memory) and cons.","def grown(watch, held) = undo(watch, held, cons(watch, held));","eq(len(grown(nothing(),list(1))),1),eq(head(grown(5,list(1))),5),eq(len(grown(5,list(1))),2),eq(len(grown(0,list())),1),eq(len(grown(nothing(),list())),0),eq(head(tail(grown(2,list(9)))),9)"),
   bcp-row("careful","Implement careful(x, held): let saved = store(held), then answer str_len(x) and, when that stops, restore(saved). Use try ... else.","def careful(x, held) {\n let saved = store(held);\n try str_len(x) else restore(saved);\n}","eq(careful(\"abc\",9),3),eq(careful(5,9),9),eq(careful(\"\",9),0),eq(careful(nothing(),4),4),eq(careful(\"ab\",7),2),eq(careful(0,1),1)"),
   bcp-row("owned","Declare gate(n), which lands n with oac-one(intern_trivial_int(n)) when n is greater than 5 and declines with nothing() otherwise, and spare(n), which lands 0 - n. Implement owned(n): offer n through cut over list(gate, spare), answer 0 when the acknowledgement is nothing?, else the landed value read with node_value(oac-payload(ack)).","def gate(n) = n > 5 ? oac-one(intern_trivial_int(n)) : nothing();\ndef spare(n) = oac-one(intern_trivial_int(0 - n));\ndef owned(n) {\n let ack = n |> cut(list(gate, spare));\n nothing?(ack) ? 0 : node_value(oac-payload(ack));\n}","eq(owned(9),9),eq(owned(3),0),eq(owned(6),6),eq(owned(5),0),eq(owned(20),20),eq(owned(0),0)"),
   bcp-effect("closing","Implement closing(x): defer print_str(\"a\"), then defer print_str(\"b\"), then answer len(x).","def closing(x) {\n defer print_str(\"a\");\n defer print_str(\"b\");\n len(x);\n}","print(list(try closing(nothing()) else 0));","b"),
   bcp-effect("slot","Declare class Slot : Disposable<Int> whose dispose(h) prints free followed by h using print_str and int_to_str. Implement spend(h, x): defer Slot_dispose(h), then answer len(x) * 2.","class Slot : Disposable<Int> {\n def dispose(h) = print_str(\"free\" ++ int_to_str(h));\n}\ndef spend(h, x) {\n defer Slot_dispose(h);\n len(x) * 2;\n}","print(list(try spend(5,nothing()) else 0));","free5"));
  def bcp-tests() = list(
   bcp-row("clipped","Implement clipped(n): return n when n is less than 10, otherwise 10. Use the ternary ? :.","def clipped(n) = n < 10 ? n : 10;","eq(clipped(3),3),eq(clipped(0),0),eq(clipped(9),9),eq(clipped(10),10),eq(clipped(12),10),eq(clipped(0 - 1),0 - 1)"),
   bcp-row("span-next","Bind nxt to the half-open range 0 .. 3 mapped by the lambda n => n + 1, using .. and |>.","let nxt = 0 .. 3 |> map(n => n + 1);","eq(head(nxt),1),eq(head(tail(nxt)),2),eq(head(tail(tail(nxt))),3),eq(len(nxt),3),eq(head(nxt) + 1,2),eq(head(tail(tail(nxt))) - 3,0)"),
   bcp-row("filled","Implement filled(x): return x unless x is nothing, in which case return 0. Use ??.","def filled(x) = x ?? 0;","eq(filled(nothing()),0),eq(filled(1),1),eq(filled(4),4),eq(filled(0 - 3),0 - 3),eq(filled(0),0),eq(filled(nothing()) + 2,2)"),
   bcp-row("sign","Implement sign(n): return 1 when n is positive, 0 - 1 when n is negative, otherwise 0. Chain two ternaries with ? :.","def sign(n) = n > 0 ? 1 : n < 0 ? 0 - 1 : 0;","eq(sign(5),1),eq(sign(0),0),eq(sign(0 - 4),0 - 1),eq(sign(1),1),eq(sign(0 - 1),0 - 1),eq(sign(100),1)"),
   bcp-row("squares","Bind sq to the half-open range 1 .. 4 mapped by n => n * n, using .. and |>.","let sq = 1 .. 4 |> map(n => n * n);","eq(head(sq),1),eq(head(tail(sq)),4),eq(head(tail(tail(sq))),9),eq(len(sq),3),eq(head(sq) + head(tail(sq)),5),eq(head(tail(tail(sq))) - 9,0)"),
   bcp-row("stepped","Define inc(n) = n + 1, then bind up to the half-open range 0 .. 3 mapped by inc.","def inc(n) = n + 1;\nlet up = 0 .. 3 |> map(inc);","eq(head(up),1),eq(head(tail(up)),2),eq(head(tail(tail(up))),3),eq(len(up),3),eq(inc(0),1),eq(inc(9),10)"),
   bcp-row("safe","Implement safe(x): return len(x), or 0 when x is nothing. Use try ... else.","def safe(x) = try len(x) else 0;","eq(safe(list(1,2)),2),eq(safe(nothing()),0),eq(safe(list()),0),eq(safe(list(0)),1),eq(safe(list(1,2,3)),3),eq(safe(nothing()) + 1,1)"),
   bcp-row("first-present","Implement first-present() with choice { } over nothing(), nothing() and 9.","def first-present() = choice { nothing(); nothing(); 9 };","eq(first-present(),9),eq(first-present() + 1,10),eq(first-present() - 9,0),eq(first-present() * 2,18),eq(first-present() ?? 0,9),eq(first-present() + first-present(),18)"),
   bcp-row("shout","Implement shout(s): return s wrapped in < and >. Join with ++.","def shout(s) = \"<\" ++ s ++ \">\";","value_eq(shout(\"a\"),\"<a>\"),value_eq(shout(\"\"),\"<>\"),eq(str_len(shout(\"abc\")),5),value_eq(shout(shout(\"x\")),\"<<x>>\"),value_eq(shout(\"hi\"),\"<hi>\"),eq(str_len(shout(\"\")),2)"),
   bcp-row("firsts","Implement firsts(xs): return the sum of the first two items. Use xs[i].","def firsts(xs) = xs[0] + xs[1];","eq(firsts(list(1,2,3)),3),eq(firsts(list(0,0)),0),eq(firsts(list(5,0 - 5,9)),0),eq(firsts(list(10,20)),30),eq(firsts(list(0 - 1,0 - 2)),0 - 3),eq(firsts(list(4,1,1,1)),5)"),
   bcp-row("last","Implement last(xs): return the final item of a non-empty list. Use xs[i] and len.","def last(xs) = xs[len(xs) - 1];","eq(last(list(1,2,3)),3),eq(last(list(7)),7),eq(last(list(0,0,9)),9),eq(last(list(5,6)),6),eq(last(list(1,0)),0),eq(last(list(0 - 4,0 - 5)),0 - 5)"),
   bcp-row("grade","Implement grade(n): return 1 when n is 0, 2 when n is 1 or 2, otherwise 3. Use match.","def grade(n) = match n { 0 => 1, 1 | 2 => 2, _ => 3 };","eq(grade(0),1),eq(grade(1),2),eq(grade(2),2),eq(grade(3),3),eq(grade(9),3),eq(grade(0 - 1),3)"),
   bcp-row("outer","Implement outer(xs): return the sum of the first and third items of a three-item list. Bind with let [a, _, c] = xs;","def outer(xs) {\n let [a, _, c] = xs;\n a + c;\n}","eq(outer(list(1,2,3)),4),eq(outer(list(0,9,0)),0),eq(outer(list(5,0,6)),11),eq(outer(list(0 - 1,0,1)),0),eq(outer(list(2,2,2)),4),eq(outer(list(10,0,20)),30)"),
   bcp-row("poly","Implement poly(x): return x squared plus 2 times x plus 1. Write the operators without spaces.","def poly(x) = x*x+2*x+1;","eq(poly(0),1),eq(poly(1),4),eq(poly(2),9),eq(poly(3),16),eq(poly(0 - 1),0),eq(poly(0 - 2),1)"),
   bcp-row("evens","Implement evens(xs): return the even items of xs, order kept. Use |> filter with a lambda and %.","def evens(xs) = xs |> filter(x => x % 2 == 0);","eq(len(evens(list(1,2,3,4))),2),eq(head(evens(list(1,2,3,4))),2),eq(len(evens(list())),0),eq(len(evens(list(1,3))),0),eq(head(evens(list(0,1))),0),eq(len(evens(list(2,4,6))),3)"),
   bcp-row("sumsq","Implement sumsq(xs): return the sum of the squares of xs. Chain |> map and |> foldl.","def sumsq(xs) = xs |> map(x => x * x) |> foldl((s,x) => s + x,0);","eq(sumsq(list(1,2,3)),14),eq(sumsq(list()),0),eq(sumsq(list(4)),16),eq(sumsq(list(0 - 2,2)),8),eq(sumsq(list(0,5)),25),eq(sumsq(list(1,1,1,1)),4)"),
   bcp-row("upto","Implement upto(n): return the sum of 1 through n. Use the half-open range 1 .. n + 1 and |> foldl.","def upto(n) = 1 .. n + 1 |> foldl((s,x) => s + x,0);","eq(upto(3),6),eq(upto(1),1),eq(upto(4),10),eq(upto(0),0),eq(upto(5),15),eq(upto(2),3)"),
   bcp-row("retried","Implement retried(): use retry-first with 5 tries, no pause, and an attempt i that answers nothing() when i is below 3 and i * 10 otherwise.","def retried() = retry-first(5, 0, i => i < 3 ? nothing() : i * 10);","eq(retried(),30),eq(retried() + 1,31),eq(retried() - 30,0),eq(retried() / 10,3),eq(retried() ?? 0,30),eq(retried() * 0,0)"),
   bcp-row("polled","Implement polled(): use wait-until on a lambda that is ready at once, with the deadline host_monotonic_ms() + 50 and no pause.","def polled() = wait-until(() => 1, host_monotonic_ms() + 50, 0);","eq(polled(),1),eq(polled() + 1,2),eq(polled() - 1,0),eq(polled() * 5,5),eq(polled() ?? 0,1),eq(polled() + polled(),2)"),
   bcp-row("heard","Implement heard(a, b, c): return the first of a, b and c that is a non-empty string, else \"silence\". Use choice { } over readings gated by present(v), which answers nothing() for nothing or a blank string.","def present(v) = nothing?(v) || str_len(v) == 0 ? nothing() : v;\ndef heard(a, b, c) = choice { present(a); present(b); present(c); \"silence\" };","value_eq(heard(\"a\",\"b\",\"c\"),\"a\"),value_eq(heard(\"\",\"b\",\"c\"),\"b\"),value_eq(heard(nothing(),\"\",\"c\"),\"c\"),value_eq(heard(\"\",\"\",\"\"),\"silence\"),value_eq(heard(nothing(),nothing(),nothing()),\"silence\"),value_eq(heard(\"\",\"z\",\"\"),\"z\")"),
   bcp-row("noted","Implement noted(arrival, log): return log unchanged when arrival is nothing(), otherwise log with arrival added in front. Use undo(ack, checkpoint, memory) and cons.","def noted(arrival, log) = undo(arrival, log, cons(arrival, log));","eq(len(noted(nothing(),list(1,2))),2),eq(head(noted(7,list(1))),7),eq(len(noted(7,list())),1),eq(len(noted(0,list(5))),2),eq(head(tail(noted(3,list(4)))),4),eq(len(noted(nothing(),list())),0)"),
   bcp-row("sized","Implement sized(x, dflt): let kept = store(dflt), then answer str_len(x) and, when that stops, restore(kept). Use try ... else.","def sized(x, dflt) {\n let kept = store(dflt);\n try str_len(x) else restore(kept);\n}","eq(sized(\"hello\",0),5),eq(sized(9,3),3),eq(sized(\"\",8),0),eq(sized(nothing(),2),2),eq(sized(\"a\",6),1),eq(sized(list(),4),4)"),
   bcp-row("first-owner","Declare low(n), which lands n with oac-one(intern_trivial_int(n)) when n is below 10 and declines with nothing() otherwise, and high(n), which lands 0 - n. Implement first-owner(n): offer n through cut over list(low, high), answer 0 when the acknowledgement is nothing?, else the landed value read with node_value(oac-payload(ack)).","def low(n) = n < 10 ? oac-one(intern_trivial_int(n)) : nothing();\ndef high(n) = oac-one(intern_trivial_int(0 - n));\ndef first-owner(n) {\n let ack = n |> cut(list(low, high));\n nothing?(ack) ? 0 : node_value(oac-payload(ack));\n}","eq(first-owner(3),3),eq(first-owner(12),0),eq(first-owner(9),9),eq(first-owner(10),0),eq(first-owner(0),0),eq(first-owner(99),0)"),
   bcp-effect("closing-2","Implement measure(x): defer print_str(\"<\"), then defer print_str(\">\"), then answer len(x) + 1.","def measure(x) {\n defer print_str(\"<\");\n defer print_str(\">\");\n len(x) + 1;\n}","print(list(try measure(nothing()) else 0));",">"),
   bcp-effect("slot-2","Declare class Lock : Disposable<Int> whose dispose(h) prints drop followed by h using print_str and int_to_str. Implement guarded(h, x): defer Lock_dispose(h), then answer len(x) + h.","class Lock : Disposable<Int> {\n def dispose(h) = print_str(\"drop\" ++ int_to_str(h));\n}\ndef guarded(h, x) {\n defer Lock_dispose(h);\n len(x) + h;\n}","print(list(try guarded(4,nothing()) else 0));","drop4"));
  def bcp-prepare(home) = fs-exists?(home) ? form_error("Compact curriculum needs a fresh evidence home") : bcp-fresh(home);
  def bcp-fresh(home) {
   let made = nsm-init(home); let p = fs-mkdir(nsm-at(home,"practice")); let t = fs-mkdir(nsm-at(home,"test"));
   let train = bep-prepare-rows(nsm-at(home,"practice"),bcp-training()); let test = bep-prepare-rows(nsm-at(home,"test"),bcp-tests());
   let manifest = json-node-object(list(nsm-s("schema","native-bml-compact-v1"),nsm-s("source_sha256",nsm-hash(nsm-text("learn/bml-compact-practice.bml"))),nsm-n("prepared_at_ms",now_unix_ms()),nsm-n("practice_and_test_prompts_distinct",bep-distinct(train,test)),json-node-pair("practice",json-node-array(train)),json-node-pair("test",json-node-array(test))));
   nsm-write(nsm-at(home,"manifest.json"),manifest);
  }
  def bcp-enqueue-row(home,session,row) = nsm-record(hearth-session-learning(),session,nsm-str(row,"id"),"native-code",nsm-str(row,"prompt"),nsm-str(row,"completion"),"verified-answer",nsm-str(row,"reference"),0);
  def bcp-enqueue-rows(home,session,rows) = nil?(rows) ? list() : cons(bcp-enqueue-row(home,session,head(rows)),bcp-enqueue-rows(home,session,tail(rows)));
  def bcp-enqueue(home) {
   let manifest = nsm-json(nsm-at(home,"manifest.json"));
   let source = (String) nsm-str(manifest,"source_sha256") == nsm-hash(nsm-text("learn/bml-compact-practice.bml"));
   !source ? form_error("Compact curriculum changed after preparation; prepare a fresh home") : bcp-enqueue-ready(home,manifest);
  }
  def bcp-enqueue-ready(home,manifest) {
   let session = "bml-compact:" ++ nsm-hash(nsm-text(nsm-at(home,"manifest.json")));
   let paths = bcp-enqueue-rows(home,session,json-array-elements(json-object-get(manifest,"practice")));
   let report = json-node-object(list(nsm-s("session",session),nsm-s("route","native-code"),nsm-n("rows",len(paths)),nsm-s("next","drain through observe/form-cli-session-home-embody-run.fk")));
   let saved = nsm-write(nsm-at(home,"enqueued.json"),report);
   print_str(json-emit-precise(report) ++ "\n");
   report;
  }
 }
 0;
}
