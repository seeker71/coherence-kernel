; train-loop-execute.fk — the hands. A directive goes in; bytes land on disk
; or a runnable command comes back. Asked plainly by Urs, 2026-08-26: "are we
; actually emitting things or just nothing?" — tlr-decide returned directive
; STRINGS nothing executed. This cell executes them.
;
; Data directives WRITE (returning total bytes, witnessed by the band against
; file_size). Training directives RUN — the first version returned the door's
; command string "because spawning the trainer is the host's act, not this
; cell's", and Urs asked two words: "no hands?" host-exec is a registered
; primitive (primitive-registry.fk: executes a host command, returns stdout).
; The boundary was manufactured; the body had hands all along. tle-train runs
; the door's command through them and returns the trainer's last line.
; host-exec takes TWO arguments — command and stdin — as every body call
; site shows ((host-exec "uname -s" "")); the one-arg form makes the reader
; consume the closing paren as the missing argument, print a stray-')'
; diagnostic, and recover. It still answers, which is how a wrong arity can
; ship: the diagnostic is the only witness, and a runner that filters
; warnings never sees it.
; An unhandled directive is NOTHING. Coverage mint has its own live emitter and
; a separate model-free band; this cell's dispatcher band must never invoke
; that carrier merely to prove that unknown directives abstain.
;
; preludes: learn/corpus-train-emit.fk learn/corpus-train-door.fk learn/coverage-mint.fk learn/train-loop-outcome-ack.fk

(do
    (defn tle-dir () "/Users/ursmuff/.coherence-network/form-corpus-lora-data-v3")

    (defn tle-take (xs k)
        (if (le k 0) (list)
            (if (eq (len xs) 0) (list) (cons (head xs) (tle-take (tail xs) (sub k 1))))))

    ; nothing-rows corpus: facts + 12 nothing stems (3 held out for eval)
    (defn tle-emit-nothing ()
        (do (let t (write_file (str_concat (tle-dir) "/train.jsonl")
                (str_concat (cte-train-text)
                    (cte-nothing-go (tle-take (cte-nothing-stems) 12) ""))))
            (let v (write_file (str_concat (tle-dir) "/valid.jsonl") (cte-valid-text)))
            (if (or (lt t 0) (lt v 0)) (nothing) (add t v))))

    ; calibration corpus: facts + nothing-rows + permission-phrased fact rows
    (defn tle-emit-calibration ()
        (do (let t (write_file (str_concat (tle-dir) "/train.jsonl")
                (str_concat (cte-train-text)
                (str_concat (cte-nothing-go (tle-take (cte-nothing-stems) 12) "")
                            (cte-calibration-text)))))
            (let v (write_file (str_concat (tle-dir) "/valid.jsonl") (cte-valid-text)))
            (if (or (lt t 0) (lt v 0)) (nothing) (add t v))))

    ; run the door's command through the body's own hands; hand back the
    ; trainer's final report line so the caller holds evidence, not a promise
    (defn tle-train (resume-adapter out-adapter)
        (do (let cmd (ctd-command resume-adapter out-adapter))
            (if (nothing? cmd) (nothing)
                (host-exec (str_concat cmd " 2>&1 | tail -1") ""))))

    ; rest-and-fuse is its own act: the adapter becomes the model, permanent.
    ; mlx_lm.fuse bakes the low-rank diff into the base weights on disk, so
    ; the learned words stop being a sidecar that can be left unloaded — the
    ; June adapter sat unloaded for two months for exactly that reason.
    (defn tle-fuse (adapter save-dir)
        (if (not (eq (tlp-base-ready?) 1))
            "status=refused\nreason=local-base-incomplete\nexit=-1\n"
        (if (not (eq (tlp-adapter-ready? adapter) 1))
            "status=refused\nreason=local-adapter-incomplete\nexit=-1\n"
            (do
                (let log "/Users/ursmuff/.coherence-network/form-train-runs/train-loop-fuse-last.log")
                (let cmd
                    (str_concat (tlp-offline-env)
                    (str_concat " /Users/ursmuff/.local/bin/mlx_lm.fuse --model "
                    (str_concat (tloa-shq (tlp-base-model))
                    (str_concat " --adapter-path " (str_concat (tloa-shq adapter)
                    (str_concat " --save-path " (str_concat (tloa-shq save-dir)
                    (str_concat " > " (str_concat (tloa-shq log)
                        " 2>&1; r=$?; if [ \"$r\" -eq 0 ]; then s=returned; q=fuse-exit-zero; else s=failure; q=fuse-nonzero; fi; /usr/bin/printf 'status=%s\\nreason=%s\\nexit=%s\\n' \"$s\" \"$q\" \"$r\""))))))))))
                (host-exec cmd "")))))

    ; coverage rows: minted from a source, appended to the v3 training file.
    ; Provenance keeps the row; the model attests beside it, never above it.
    (defn tle-emit-coverage (source-name source-path sealed)
        (do (let r (cm-mint source-name source-path sealed 99))
            (let prev (read_file (str_concat (tle-dir) "/train.jsonl")))
            (let w (write_file (str_concat (tle-dir) "/train.jsonl")
                        (str_concat prev (nth r 0))))
            (if (lt w 0) (nothing) (list w (nth r 1) (nth r 2)))))

    (defn tle-execute (directive resume-adapter out-adapter)
        (if (str_eq directive "emit-nothing-rows") (tle-emit-nothing)
        (if (str_eq directive "emit-permission-phrased-fact-rows") (tle-emit-calibration)
        (if (str_eq directive "train-more-epochs") (tle-train resume-adapter out-adapter)
        (if (str_eq directive "rest-and-fuse") (tle-fuse resume-adapter out-adapter)
        (if (str_eq directive "mint-coverage-rows-from-sources")
            (tle-emit-coverage "host-kernel.form" "axioms/host-kernel.form"
                (list "In host-kernel.form, what exact token names whether native resource replacement is optional?"))
            (nothing)))))))
    0)
