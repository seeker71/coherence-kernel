; corpus-query-offers.fk -- answer-free runtime door into distilled knowledge.
;
; corpus-teach-samples renders every won question and answer, but rendering is
; not a runtime edge. This cell binds an independent question and one of its
; discriminative tokens to the current corpus source. The resulting NodeID
; offer contains no answer. Form retains source authority, performs the lookup
; after the live stream emits the query, and may inject the attributed window.
;
; This makes every current corpus row reachable when a suitable question token
; is offered. It does not claim the local model selected the token, executed a
; lookup, answered correctly, or changed weights; those remain separate live
; observations.
;
; preludes: form-stdlib/core.fk learn/corpus-teach-samples.fk form-stdlib/form-knowledge-axioms-public-curriculum.fk
; Proven by: form-stdlib/tests/corpus-query-offers-band.fk

import "corpus-teach-samples.fk"
import "../form/form-stdlib/form-knowledge-axioms-public-curriculum.fk"

(do
    (defn cqo-source-path () "learn/homecoming-distillation-corpus.fk")
    (defn cqo-sample-count () (cts-count))
    (defn cqo-offer (question anchor)
        (fkap-rag-query-offer (cqo-source-path) anchor question))
    (defn cqo-offer-valid? (offer question)
        (if (and (str_eq (nth offer 4) (cqo-source-path))
                 (eq (fkap-rag-query-offer-valid? offer question) 1)) 1 0))
    (defn cqo-rehearsal-prompt (question anchor)
        (do
            (let offer (cqo-offer question anchor))
            (if (nothing? offer) (nothing)
                (fkap-query-rehearsal-prompt offer question))))
    (defn cqo-model-executed () 0)
    (defn cqo-weights-trained () 0)
    0)
