; form-knowledge-heldout-v4.fk — eight sealed facts over sources the v3 blind
; set does not touch: jit-decision.fk, core.fk, channel.fk, voice-attunement.md.
;
; This cell never runs a model. Each row carries a prompt that asks for one
; exact token or short phrase, and an expected answer copied VERBATIM from the
; source — the quoted line sits beside each row so a reader can re-witness the
; copy without leaving this file.
;
; SEALED: these eight expected answers stay out of every training file. The
; band (tests/form-knowledge-heldout-v4-band.fk) reads the current training
; JSONL and witnesses that none of the eight appears in it; when that file is
; absent there is nothing to leak from, and the check reports skipped rather
; than pretending a read it never made (fkh4-leak-status below). A minted
; question is kept away from these rows the same way: coverage-mint-sources.fk
; seals every fkh4 prompt through cm-guard-ok? before a row lands.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/form-knowledge-heldout-v4-band.fk

(do
    (defn fkh4-count () 8)
    (defn fkh4-train-path ()
        "/Users/ursmuff/.coherence-network/form-corpus-lora-data/train.jsonl")

    ; row = tag id source-path prompt expected
    (defn fkh4-row (id source prompt expected)
        (list "form-knowledge-heldout-row-v4" id source prompt expected))
    (defn fkh4-row? (r)
        (if (and (eq (len r) 5)
                 (str_eq (nth r 0) "form-knowledge-heldout-row-v4")) 1 0))
    (defn fkh4-id (r) (nth r 1))
    (defn fkh4-source (r) (nth r 2))
    (defn fkh4-prompt (r) (nth r 3))
    (defn fkh4-expected (r) (nth r 4))

    (defn fkh4-rows ()
        (list
            ; form/form-stdlib/jit-decision.fk:16
            ;   (if (eq pure 1) (if (ge heat 5) 1 0) 0))
            (fkh4-row "h401" "form/form-stdlib/jit-decision.fk"
                "In jit-decision.fk, which exact Form condition on heat holds before a pure recipe crystallizes to native? Reply with only the condition expression."
                "(ge heat 5)")
            ; form/form-stdlib/jit-decision.fk:17
            ;   (defn jd-melt? (heat) (if (lt heat 2) 1 0))
            (fkh4-row "h402" "form/form-stdlib/jit-decision.fk"
                "In jit-decision.fk, which exact Form condition sends a cooled recipe back to the tree-walker? Reply with only the condition expression."
                "(lt heat 2)")
            ; form/form-stdlib/channel.fk:37
            ;   (let CHANNEL-V0  (bp "CHANNEL-V0"))
            (fkh4-row "h403" "form/form-stdlib/channel.fk"
                "Which Blueprint name does channel.fk give the channel container Recipe? Reply with only the name."
                "CHANNEL-V0")
            ; form/form-stdlib/channel.fk:30
            ;   ;   - Real-time poll: callers compare file_mtime to detect change.
            (fkh4-row "h404" "form/form-stdlib/channel.fk"
                "Which kernel native does channel.fk tell real-time pollers to compare to detect change? Reply with only the native name."
                "file_mtime")
            ; form/form-stdlib/core.fk:19
            ;   (defn core-nothing () (head (list)))
            (fkh4-row "h405" "form/form-stdlib/core.fk"
                "What Form expression is the whole body of core-nothing in core.fk? Reply with only the expression."
                "(head (list))")
            ; form/form-stdlib/core.fk:43
            ;   ; Above 127 the three walkers read n as a CODEPOINT and hand back its two-byte
            (fkh4-row "h406" "form/form-stdlib/core.fk"
                "In core.fk's byte_to_str witness, what do the three walker kernels read n as above 127? Reply with only the capitalized word the source uses."
                "CODEPOINT")
            ; teachings/voice-attunement.md:34-35
            ;   The executable
            ;   overlay is `form/form-stdlib/word-frequency-purify.fk`.
            (fkh4-row "h407" "teachings/voice-attunement.md"
                "Which executable overlay does voice-attunement.md name for purified word usage? Reply with only the file path."
                "form/form-stdlib/word-frequency-purify.fk")
            ; teachings/voice-attunement.md:26
            ;   gate      a welcoming threshold that recognizes and names the edge
            (fkh4-row "h408" "teachings/voice-attunement.md"
                "What purified description does voice-attunement.md give the word gate? Reply with only the source's phrase."
                "a welcoming threshold that recognizes and names the edge")))

    ; find-row of an id nobody carries answers nothing — never a default row
    (defn fkh4-find-loop (id rows)
        (if (eq (len rows) 0) (nothing)
            (if (str_eq id (fkh4-id (head rows))) (head rows)
                (fkh4-find-loop id (tail rows)))))
    (defn fkh4-find-row (id) (fkh4-find-loop id (fkh4-rows)))

    ; ── the seal, witnessed against the live training file ─────────────────
    ; 2 = the training file is absent on this host: nothing to leak from,
    ;     reported as skipped rather than as a pass the read never earned
    ; 1 = the file is present and carries none of the eight expected answers
    ; 0 = an expected answer appears in training data — the seal is broken
    (defn fkh4-leak-in-text? (text rows)
        (if (eq (len rows) 0) 0
            (if (ge (str_find text (fkh4-expected (head rows)) 0) 0) 1
                (fkh4-leak-in-text? text (tail rows)))))
    (defn fkh4-leak-status ()
        (if (lt (file_size (fkh4-train-path)) 0) 2
            (if (eq (fkh4-leak-in-text? (read_file (fkh4-train-path))
                                        (fkh4-rows)) 1) 0 1)))
    0)
