// Frozen local-teacher practice and separate transfer contracts.
// Reference answers are execution witnesses; teacher prompts contain contracts only.
// preludes: learn/bml-execution-practice.bml
section [form.bml] {
 class BmlScalarPractice {
  def bsp-rule() = "Write one complete repository BML declaration, ending with a semicolon. Return only code. Syntax: def name(xs) = if CONDITION then EXPRESSION else EXPRESSION; Calls always use parentheses. nothing() is absent; 0 is present. Functions: len, eq, gt, lt, head, tail, nothing?, nothing, add, sub, mul. Finite lists; recursion allowed. ";
  def bsp-row(id,contract,code,checks) = bep-row(id,str_concat(bsp-rule(),contract),code,str_concat("print(list(",str_concat(checks,"));")),"[1, 1, 1, 1, 1, 1]","code");
  def bsp-training() = list(
   bsp-row("pollen-count","Implement pollen-count(xs): count all present entries, including 0 and negative integers; skip nothing(). Empty list gives 0.","def pollen-count(xs) = if eq(len(xs),0) then 0 else if nothing?(head(xs)) then pollen-count(tail(xs)) else add(1,pollen-count(tail(xs)));","eq(pollen-count(list()),0),eq(pollen-count(list(nothing(),nothing())),0),eq(pollen-count(list(0)),1),eq(pollen-count(list(2,nothing(),-5)),2),eq(pollen-count(list(0,0,0)),3),eq(pollen-count(list(nothing(),0,nothing(),7)),2)"),
   bsp-row("pollen-first-positive","Implement pollen-first-positive(xs): return the first strictly positive integer, skipping nothing(), zero and negative integers; return nothing() when none exists.","def pollen-first-positive(xs) = if eq(len(xs),0) then nothing() else if nothing?(head(xs)) then pollen-first-positive(tail(xs)) else if gt(head(xs),0) then head(xs) else pollen-first-positive(tail(xs));","nothing?(pollen-first-positive(list())),nothing?(pollen-first-positive(list(nothing(),0,-2))),eq(pollen-first-positive(list(2,5)),2),eq(pollen-first-positive(list(-1,nothing(),0,7)),7),eq(pollen-first-positive(list(nothing(),3,nothing(),8)),3),nothing?(pollen-first-positive(list(0,0)))"),
   bsp-row("pollen-sum-squares","Implement pollen-sum-squares(xs): sum the squares of all present integers, skip nothing(), and return 0 for empty or all-absent lists.","def pollen-sum-squares(xs) = if eq(len(xs),0) then 0 else if nothing?(head(xs)) then pollen-sum-squares(tail(xs)) else add(mul(head(xs),head(xs)),pollen-sum-squares(tail(xs)));","eq(pollen-sum-squares(list()),0),eq(pollen-sum-squares(list(nothing(),nothing())),0),eq(pollen-sum-squares(list(0)),0),eq(pollen-sum-squares(list(2,nothing(),-3)),13),eq(pollen-sum-squares(list(-4,0)),16),eq(pollen-sum-squares(list(nothing(),1,2,nothing())),5)"));
  def bsp-tests() = list(
   bsp-row("petal-count-zero","Implement petal-count-zero(xs): count only present numeric zeros. Skip nothing() and nonzero integers. Empty list gives 0.","def petal-count-zero(xs) = if eq(len(xs),0) then 0 else if nothing?(head(xs)) then petal-count-zero(tail(xs)) else if eq(head(xs),0) then add(1,petal-count-zero(tail(xs))) else petal-count-zero(tail(xs));","eq(petal-count-zero(list()),0),eq(petal-count-zero(list(nothing(),nothing())),0),eq(petal-count-zero(list(0)),1),eq(petal-count-zero(list(0,nothing(),0,-2)),2),eq(petal-count-zero(list(-1,2,3)),0),eq(petal-count-zero(list(nothing(),0,0,nothing(),0)),3)"),
   bsp-row("petal-first-negative","Implement petal-first-negative(xs): return the first strictly negative integer, skipping nothing(), zero and positive integers; return nothing() when none exists.","def petal-first-negative(xs) = if eq(len(xs),0) then nothing() else if nothing?(head(xs)) then petal-first-negative(tail(xs)) else if lt(head(xs),0) then head(xs) else petal-first-negative(tail(xs));","nothing?(petal-first-negative(list())),nothing?(petal-first-negative(list(nothing(),0,2))),eq(petal-first-negative(list(-2,-5)),-2),eq(petal-first-negative(list(1,nothing(),0,-7)),-7),eq(petal-first-negative(list(nothing(),-3,nothing(),-8)),-3),nothing?(petal-first-negative(list(0,0)))"),
   bsp-row("petal-sum-absolute","Implement petal-sum-absolute(xs): sum absolute values of present integers, ignoring nothing(); return 0 for empty or all-absent lists. Negate a negative number with sub(0,value).","def petal-sum-absolute(xs) = if eq(len(xs),0) then 0 else if nothing?(head(xs)) then petal-sum-absolute(tail(xs)) else add(if lt(head(xs),0) then sub(0,head(xs)) else head(xs),petal-sum-absolute(tail(xs)));","eq(petal-sum-absolute(list()),0),eq(petal-sum-absolute(list(nothing(),nothing())),0),eq(petal-sum-absolute(list(0)),0),eq(petal-sum-absolute(list(2,nothing(),-3)),5),eq(petal-sum-absolute(list(-4,0)),4),eq(petal-sum-absolute(list(nothing(),-1,2,nothing())),3)"));
  def bsp-prepare(home) = if fs-exists?(home) then form_error("Scalar curriculum needs a fresh evidence home") else bsp-fresh(home);
  def bsp-fresh(home) {
   let made = nsm-init(home); let p = fs-mkdir(nsm-at(home,"practice")); let t = fs-mkdir(nsm-at(home,"test"));
   let train = bep-prepare-rows(nsm-at(home,"practice"),bsp-training()); let test = bep-prepare-rows(nsm-at(home,"test"),bsp-tests());
   let manifest = json-node-object(list(nsm-s("source_sha256",nsm-hash(nsm-text("learn/bml-scalar-practice.bml"))),nsm-n("prepared_at_ms",now_unix_ms()),nsm-n("practice_and_test_prompts_distinct",bep-distinct(train,test)),json-node-pair("practice",json-node-array(train)),json-node-pair("test",json-node-array(test))));
   nsm-write(nsm-at(home,"manifest.json"),manifest);
  }
 }
 0;
}
