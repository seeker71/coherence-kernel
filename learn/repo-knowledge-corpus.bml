// Source-grounded teaching, not generated answers or a claim of runtime truth.
// No model admission, shell computation, assessment ingestion or serving change.
// preludes: form-stdlib/native-session-memory.bml learn/corpus-train-emit.fk
section [form.bml] {
 class RepoKnowledgeCorpus {
  def rkc-home() = nsm-knowledge-home(hearth-session-learning());
  def rkc-schema() = "repo-knowledge-corpus-v2";
  def rkc-modern?(manifest) = str_eq(nsm-str(manifest,"schema"),rkc-schema());
  def rkc-supported?(manifest) = or(rkc-modern?(manifest),str_eq(nsm-str(manifest,"schema"),"repo-knowledge-corpus-v1"));
  def rkc-docs() = list(
   "docs/native-jit-routing.md", "docs/native-tensors.md",
   "docs/native-llama-metal.md", "docs/fkwu-form-native-north-star.md",
   "docs/form-native-coding.md", "docs/form-native-agent-tools.md",
   "docs/native-model-control-plane.md", "docs/native-lora-training.md",
   "docs/native-lora-fusion.md", "docs/native-session-learning.md",
   "docs/native-whisper.md", "docs/native-authoring-guide.md",
   "docs/native-form-artifacts.md", "docs/native-source-preparation.md",
   "docs/native-gpu-source-generation.md", "docs/native-kernel-trace.md",
   "docs/native-independent-model-sessions.md",
   "docs/native-metal-ask.md", "docs/native-concept-source-audit.md",
   "docs/native-source-inventory.md", "docs/adaptive-artifact-depth.md",
   "docs/substring-one-meaning.md", "docs/str-find-one-meaning.md",
   "docs/declarative-attention.md", "docs/glass-awareness.md",
   "docs/glass-rendering.md", "docs/ear-quiet-speech.md",
   "docs/native-python-compiler.md", "docs/native-fp64-matrix.md",
   "docs/coherence-substrate/README.md",
   "docs/coherence-substrate/host-io-abi.md",
   "docs/coherence-substrate/ports-interface-and-structure.md",
   "docs/coherence-substrate/resources-as-cells.md",
   "docs/live-dynamic-diagnostics.md",
   "docs/fkwu-kernel-status.md", "docs/fkwu-c-bootstrap-inspection.md",
   "docs/native-dsv4-numeric-reference.md", "docs/form-cli-healing.md",
   "docs/form-glass-organ-care.md", "docs/form-share-measurement.md",
   "docs/glass-keyboard.md",
   "docs/coherence-substrate/current-language-artifact-path.md");
  def rkc-read(path) {
   let text = read_file(path);
   if nothing?(text) then form_error(str_concat("repository teaching source unreadable: ",path)) else text;
  }
  def rkc-source(path,text) = json-node-object(list(nsm-s("path",path),nsm-s("sha256",nsm-hash(text)),nsm-n("bytes",str_len(text))));
  def rkc-row(prompt,answer,source,key,kind,split) = json-node-object(list(nsm-s("prompt",prompt),nsm-s("completion",answer),json-node-pair("source",source),nsm-s("unit",key),nsm-s("evidence_kind",kind),nsm-s("split",split)));
  def rkc-split(key) = if eq(mod(cte-fold(nsm-hash(key)),7),0) then "heldout" else "train";
  // A whole document stays on one side. Teaching answer words keep their
  // existing split, including rows with different questions for the same word.
  def rkc-teachings(rows,source) {
   if nil?(rows) then list() else if not(hdc-admissible?(head(rows))) then rkc-teachings(tail(rows),source) else cons(rkc-teaching(head(rows),source),rkc-teachings(tail(rows),source));
  }
  def rkc-teaching(row,source) = rkc-row(cts-question(row),cts-answer(row),source,int_to_str(hdc-mid(row)),"attributed-rented-teaching",if cte-valid-row?(row) then "heldout" else "train");
  // Recognition alone puts the description in the prompt and only a coined
  // label in the supervised target. Teach the recorded association in both
  // directions, after exact deduplication. This adds examples, not lessons.
  def rkc-descriptive?(row) = str_eq(nsm-str(row,"evidence_kind"),"attributed-corpus-description");
  def rkc-description-prompt(row) = str_concat("Which recorded description belongs to the historical repository term `",str_concat(nsm-str(row,"completion"),str_concat("` in corpus row ",str_concat(nsm-str(row,"unit"),"? Quote the source association; do not claim a new execution result."))));
  def rkc-description(row) = rkc-row(rkc-description-prompt(row),nsm-str(row,"prompt"),json-object-get(row,"source"),nsm-str(row,"unit"),"attributed-corpus-description",nsm-str(row,"split"));
  def rkc-expand(rows) = if nil?(rows) then list() else if str_eq(nsm-str(head(rows),"evidence_kind"),"attributed-rented-teaching") then cons(head(rows),cons(rkc-description(head(rows)),rkc-expand(tail(rows)))) else cons(head(rows),rkc-expand(tail(rows)));
  def rkc-unit-key(row) = json-emit-precise(json-node-array(list(json-object-get(row,"source"),json-node-string(nsm-str(row,"unit")))));
  def rkc-unit-count(rows,seen) = if nil?(rows) then len(seen) else rkc-unit-count-key(tail(rows),seen,rkc-unit-key(head(rows)));
  def rkc-unit-count-key(rest,seen,key) = rkc-unit-count(rest,if nsm-has(seen,key) then seen else cons(key,seen));
  def rkc-description-keys(rows) = if nil?(rows) then list() else if rkc-descriptive?(head(rows)) then cons(json-emit-precise(head(rows)),rkc-description-keys(tail(rows))) else rkc-description-keys(tail(rows));
  // Pre-encode each association once. Every original must have its exact
  // description row on the SAME side, including identity and source evidence.
  def rkc-description-errors(rows,keys) = if nil?(rows) then 0 else add(if str_eq(nsm-str(head(rows),"evidence_kind"),"attributed-rented-teaching") then not(nsm-has(keys,json-emit-precise(rkc-description(head(rows))))) else 0,rkc-description-errors(tail(rows),keys));
  // These edge contracts have recorded arm differences. Do not teach a bare
  // registry sentence as the current native contract; keep the omission visible.
  def rkc-edge-omissions() = list("substring","char_at","str_byte_at","int_to_str");
  // Decode the registry's literal declaration envelope; never evaluate the
  // callback symbol. Comments and quoted examples cannot invent declarations.
  def rkc-ws(text,pos) {
   let next = json-skip-ws(text,pos);
   if ge(next,str_len(text)) then next else if eq(str_byte_at(text,next),59) then rkc-ws(text,rkc-eol(text,next)) else next;
  }
  def rkc-eol(text,pos) = if lt(str_find(text,"\n",pos),0) then str_len(text) else add(str_find(text,"\n",pos),1);
  def rkc-string(text,pos) {
   let start = rkc-ws(text,pos);
   if or(ge(start,str_len(text)),not(eq(str_byte_at(text,start),34))) then form_error("registry declaration requires a literal string") else rkc-string-at(text,start,rkc-string-end(text,add(start,1)));
  }
  def rkc-string-end(text,pos) {
   let next = scan_run(text,pos,4);
   if ge(next,str_len(text)) then form_error("registry declaration string is incomplete") else if eq(str_byte_at(text,next),92) then if ge(add(next,1),str_len(text)) then form_error("registry declaration escape is incomplete") else rkc-string-end(text,add(next,2)) else add(next,1);
  }
  def rkc-string-at(text,start,end) = if or(le(end,add(start,1)),not(eq(str_byte_at(text,sub(end,1)),34))) then form_error("registry declaration string is incomplete") else list(nth(json-scan-string(text,start),1),end);
  def rkc-atom-end(text,pos) = if ge(pos,str_len(text)) then pos else if or(le(str_byte_at(text,pos),32),or(eq(str_byte_at(text,pos),41),eq(str_byte_at(text,pos),40))) then pos else rkc-atom-end(text,add(pos,1));
  def rkc-atom(text,pos) {
   let start = rkc-ws(text,pos); let end = rkc-atom-end(text,start);
   if eq(start,end) then form_error("registry declaration requires a literal atom") else list(substring(text,start,end),end);
  }
  def rkc-decode-declaration(text,pos) {
   let name = rkc-string(text,pos); let category = rkc-string(text,nth(name,1)); let spec = rkc-string(text,nth(category,1));
   let callback = rkc-atom(text,nth(spec,1)); let expected = rkc-atom(text,nth(callback,1)); let mode = rkc-atom(text,nth(expected,1)); let end = rkc-ws(text,nth(mode,1));
   if not(and(or(str_eq(head(mode),"0"),str_eq(head(mode),"1")),eq(str_byte_at(str_concat(text," "),end),41))) then form_error("registry declaration envelope changed") else list(list(head(name),head(category),head(spec),str_to_int(head(mode))),add(end,1));
  }
  def rkc-declarations(text,pos,rows) {
   let start = rkc-ws(text,pos);
   if ge(start,str_len(text)) then reverse(rows) else if eq(str_byte_at(text,start),34) then rkc-declarations(text,nth(rkc-string(text,start),1),rows) else if rkc-declaration-start(text,start) then rkc-declared(text,rkc-decode-declaration(text,add(start,5)),rows) else rkc-declarations(text,add(start,1),rows);
  }
  def rkc-declaration-start(text,start) = if ge(add(start,5),str_len(text)) then 0 else and(str_eq(substring(text,start,add(start,5)),"(prim"),or(le(str_byte_at(text,add(start,5)),32),eq(str_byte_at(text,add(start,5)),59)));
  def rkc-declared(text,decoded,rows) = rkc-declarations(text,nth(decoded,1),cons(head(decoded),rows));
  def rkc-primitives(rows,source) {
   if nil?(rows) then list() else if nsm-has(rkc-edge-omissions(),head(head(rows))) then rkc-primitives(tail(rows),source) else cons(rkc-primitive(head(rows),source),rkc-primitives(tail(rows),source));
  }
  def rkc-primitive(row,source) {
   let name = head(row);
   let prompt = str_concat("What does Form's primitive registry declare for `",str_concat(name,"`? Include its category and verification boundary."));
   let answer = str_concat(nth(row,2),str_concat(". Category: ",str_concat(nth(row,1),if eq(nth(row,3),1) then ". The registry carries a nominal probe; that is not proof for every input or carrier." else ". The registry marks this carrier-gated; its declaration is not a portable runtime proof.")));
   rkc-row(prompt,answer,source,name,"declared-primitive-contract",rkc-split(str_concat("primitive/",name)));
  }
  def rkc-prefix(text,prefix) = eq(str_find(text,prefix,0),0);
  def rkc-run-length(text,byte,i) = if ge(i,str_len(text)) then i else if eq(str_byte_at(text,i),byte) then rkc-run-length(text,byte,add(i,1)) else i;
  def rkc-heading(line) {
   let n = rkc-run-length(line,35,0);
   if and(gt(n,0),and(le(n,6),eq(str_byte_at(str_concat(line," "),n),32))) then list(n,trim(substring(line,n,str_len(line)))) else list(0,"");
  }
  def rkc-fence(line) {
   let text = trim(line); let byte = if gt(str_len(text),0) then str_byte_at(text,0) else 0;
   let n = if or(eq(byte,96),eq(byte,126)) then rkc-run-length(text,byte,0) else 0;
   if ge(n,3) then list(byte,n) else list(0,0);
  }
  def rkc-path(stack,level,title) = append(rkc-ancestors(stack,level),list(list(level,title)));
  def rkc-ancestors(stack,level) = if nil?(stack) then list() else if ge(head(head(stack)),level) then list() else cons(head(stack),rkc-ancestors(tail(stack),level));
  def rkc-titles(stack) = if nil?(stack) then "" else str_concat(nth(head(stack),1),if nil?(tail(stack)) then "" else str_concat(" / ",rkc-titles(tail(stack))));
  def rkc-section(path,source,stack,start,body,rows) {
   let text = trim(body); let key = str_concat(int_to_str(start),str_concat(":",rkc-titles(stack)));
   if str_eq(text,"") then rows else cons(rkc-row(str_concat("According to `",str_concat(path,str_concat("`, what is the repository guidance under ",str_concat(rkc-titles(stack),str_concat(" (section starting line ",str_concat(int_to_str(start),")?")))))),text,source,key,"source-documentation",rkc-split(path)),rows);
  }
  // Headings inside fenced code are data. A torn fence is a source error,
  // never silently truncated training text. Long sections remain whole rows;
  // the trainer's tokenizer and memory admission decide whether they fit.
  def rkc-sections(path,source,lines,line,stack,start,body,fence,rows) {
   if nil?(lines) then if gt(head(fence),0) then form_error(str_concat("unclosed teaching source fence: ",path)) else reverse(rkc-section(path,source,stack,start,body,rows)) else rkc-section-line(path,source,head(lines),tail(lines),line,stack,start,body,fence,rows);
  }
  def rkc-section-line(path,source,text,rest,line,stack,start,body,fence,rows) {
   let mark = rkc-fence(text); let heading = if gt(head(fence),0) then list(0,"") else rkc-heading(text);
   let nextFence = if eq(head(fence),0) then mark else if and(eq(head(mark),head(fence)),and(ge(nth(mark,1),nth(fence,1)),str_eq(trim(substring(trim(text),nth(mark,1),str_len(trim(text)))),""))) then list(0,0) else fence;
   if gt(head(heading),0) then rkc-sections(path,source,rest,add(line,1),rkc-path(stack,head(heading),nth(heading,1)),line,"",nextFence,rkc-section(path,source,stack,start,body,rows)) else rkc-sections(path,source,rest,add(line,1),stack,start,str_concat(body,str_concat(text,"\n")),nextFence,rows);
  }
  def rkc-document(path) {
   let text = rkc-read(path); let source = rkc-source(path,text);
   rkc-sections(path,source,split-on(text,"\n"),1,list(list(0,path)),1,"",list(0,0),list());
  }
  def rkc-documents(paths) = if nil?(paths) then list() else append(rkc-document(head(paths)),rkc-documents(tail(paths)));
  def rkc-all() {
   let corpus = "learn/homecoming-distillation-corpus.fk"; let registry = "form/form-stdlib/primitive-registry.fk";
   let registryText = rkc-read(registry);
   append(rkc-documents(rkc-docs()),append(rkc-primitives(rkc-declarations(registryText,0,list()),rkc-source(registry,registryText)),rkc-teachings(hdc-rows(),rkc-source(corpus,rkc-read(corpus)))));
  }
  def rkc-sentinel-prompts(lines) = if nil?(lines) then list() else if str_eq(trim(head(lines)),"") then rkc-sentinel-prompts(tail(lines)) else cons(nsm-str(parse-json("training-sentinel",head(lines)),"prompt"),rkc-sentinel-prompts(tail(lines)));
  def rkc-clean(rows,seen,blocked,out) {
   if nil?(rows) then reverse(out) else rkc-clean-row(head(rows),tail(rows),seen,blocked,out);
  }
  def rkc-clean-row(row,rest,seen,blocked,out) {
   let prompt = nsm-str(row,"prompt"); let answer = nsm-str(row,"completion");
   let key = nsm-hash(json-emit-precise(nsm-row(prompt,answer)));
   if or(str_eq(prompt,""),str_eq(answer,"")) then form_error("empty repository teaching pair") else if nsm-has(blocked,prompt) then form_error("assessment prompt encountered in repository training sources") else if nsm-has(seen,key) then rkc-clean(rest,seen,blocked,out) else rkc-clean(rest,cons(key,seen),blocked,cons(row,out));
  }
  def rkc-text(rows,split) = if nil?(rows) then "" else str_concat(if str_eq(nsm-str(head(rows),"split"),split) then str_concat(json-emit-precise(head(rows)),"\n") else "",rkc-text(tail(rows),split));
  def rkc-count(rows,key,value) = if nil?(rows) then 0 else add(str_eq(nsm-str(head(rows),key),value),rkc-count(tail(rows),key,value));
  def rkc-json-lines(lines) = if nil?(lines) then list() else if str_eq(trim(head(lines)),"") then rkc-json-lines(tail(lines)) else cons(parse-json("repository-pair",head(lines)),rkc-json-lines(tail(lines)));
  def rkc-keys(rows,key) = if nil?(rows) then list() else cons(nsm-hash(nsm-str(head(rows),key)),rkc-keys(tail(rows),key));
  def rkc-overlap(rows,keys,key) = if nil?(rows) then 0 else add(nsm-has(keys,nsm-hash(nsm-str(head(rows),key))),rkc-overlap(tail(rows),keys,key));
  def rkc-sources(rows,seen) = if nil?(rows) then len(seen) else rkc-check-source(head(rows),tail(rows),seen);
  def rkc-check-source(row,rest,seen) {
   let source = json-object-get(row,"source"); let path = nsm-str(source,"path"); let key = str_concat(path,nsm-str(source,"sha256"));
   if nsm-has(seen,key) then rkc-sources(rest,seen) else if not(str_eq(nsm-hash(rkc-read(path)),nsm-str(source,"sha256"))) then form_error(str_concat("corpus source has changed since publication: ",path)) else rkc-sources(rest,cons(key,seen));
  }
  // Publication owns these live invariants; the observation door reuses them.
  def rkc-check(manifest) {
   let data = nsm-str(manifest,"data");
   let trainText = rkc-read(nsm-at(data,"train.jsonl")); let heldText = rkc-read(nsm-at(data,"heldout.jsonl")); let validText = rkc-read(nsm-at(data,"valid.jsonl"));
   let train = rkc-json-lines(split-on(trainText,"\n")); let held = rkc-json-lines(split-on(heldText,"\n")); let valid = rkc-json-lines(split-on(validText,"\n"));
   let samePrompt = rkc-overlap(train,rkc-keys(append(held,valid),"prompt"),"prompt"); let sameAnswer = rkc-overlap(train,rkc-keys(held,"completion"),"completion");
   let bound = and(str_eq(nsm-hash(trainText),nsm-str(manifest,"train_sha256")),and(str_eq(nsm-hash(heldText),nsm-str(manifest,"heldout_sha256")),str_eq(nsm-hash(validText),nsm-str(manifest,"validation_sha256"))));
   let counts = and(eq(len(train),nsm-num(manifest,"train_examples")),and(eq(len(held),nsm-num(manifest,"heldout_examples")),eq(len(valid),nsm-num(manifest,"validation_sentinels"))));
   let allRows = append(train,held); let units = rkc-unit-count(allRows,list());
   let descriptions = rkc-count(allRows,"evidence_kind","attributed-corpus-description");
   let descriptionErrors = if rkc-modern?(manifest) then add(rkc-description-errors(train,rkc-description-keys(train)),rkc-description-errors(held,rkc-description-keys(held))) else descriptions;
   let unitCounts = and(rkc-supported?(manifest),if rkc-modern?(manifest) then and(eq(units,nsm-num(manifest,"source_units")),and(eq(descriptions,nsm-num(manifest,"historical_description_examples")),eq(descriptions,rkc-count(allRows,"evidence_kind","attributed-rented-teaching")))) else eq(descriptions,0));
   let measured = json-node-object(list(nsm-n("train_examples",len(train)),nsm-n("heldout_examples",len(held)),nsm-n("validation_sentinels",len(valid)),nsm-n("source_units",units),nsm-n("historical_description_examples",descriptions),nsm-n("description_binding_errors",descriptionErrors),nsm-n("source_unit_counts_match",unitCounts),nsm-n("source_files_rehashed",rkc-sources(allRows,list())),nsm-n("heldout_prompt_overlap",samePrompt),nsm-n("heldout_completion_overlap",sameAnswer),nsm-n("dataset_hashes_match",bound),nsm-n("manifest_counts_match",counts)));
   if and(bound,and(counts,and(unitCounts,and(eq(descriptionErrors,0),and(eq(samePrompt,0),eq(sameAnswer,0)))))) then measured else form_error(str_concat("repository knowledge separation or content disagrees: ",json-emit-precise(measured)));
  }
  def rkc-keep(path,text) {
   if gt(file_size(path),0) then if str_eq(rkc-read(path),text) then 1 else form_error(str_concat("immutable corpus publication differs: ",path)) else nag-write(path,text);
  }
  def rkc-build(home) {
   let private = nsm-init(hearth-session-learning());
   let valid = rkc-read("model/fixtures/session-learning/valid.jsonl");
   let blocked = rkc-sentinel-prompts(split-on(valid,"\n"));
   let originals = rkc-clean(rkc-all(),list(),blocked,list());
   let rows = rkc-clean(rkc-expand(originals),list(),blocked,list());
   let train = rkc-text(rows,"train"); let heldout = rkc-text(rows,"heldout");
   let id = nsm-hash(str_concat(train,str_concat(heldout,valid))); let dir = nsm-at(nsm-at(home,"versions"),id);
   let root = fs-mkdir(home); let versions = fs-mkdir(nsm-at(home,"versions")); let made = fs-mkdir(dir);
   let t = rkc-keep(nsm-at(dir,"train.jsonl"),train); let v = rkc-keep(nsm-at(dir,"valid.jsonl"),valid); let h = rkc-keep(nsm-at(dir,"heldout.jsonl"),heldout);
   let manifest = json-node-object(list(nsm-s("schema",rkc-schema()),nsm-s("id",id),nsm-s("data",dir),nsm-n("examples",len(rows)),nsm-n("source_units",rkc-unit-count(rows,list())),nsm-n("train_examples",rkc-count(rows,"split","train")),nsm-n("heldout_examples",rkc-count(rows,"split","heldout")),nsm-n("validation_sentinels",len(rkc-sentinel-prompts(split-on(valid,"\n")))),nsm-n("documentation_examples",rkc-count(rows,"evidence_kind","source-documentation")),nsm-n("primitive_examples",rkc-count(rows,"evidence_kind","declared-primitive-contract")),nsm-n("historical_teachings",rkc-count(rows,"evidence_kind","attributed-rented-teaching")),nsm-n("historical_description_examples",rkc-count(rows,"evidence_kind","attributed-corpus-description")),json-node-pair("omitted_edge_contracts",json-node-array(nsm-string-nodes(rkc-edge-omissions()))),nsm-s("train_sha256",nsm-hash(train)),nsm-s("heldout_sha256",nsm-hash(heldout)),nsm-s("validation_sha256",nsm-hash(valid)),nsm-s("trained_examples","unmeasured; training-events own consumption"),nsm-s("scope","source-attributed knowledge, not verified session autonomy")));
   let checked = rkc-check(manifest);
   let complete = rkc-keep(nsm-at(dir,"manifest.json"),json-emit-precise(manifest));
   let published = nsm-atomic(nsm-at(home,"current.json"),manifest);
   let observed = nsm-hash(str_concat(rkc-read(nsm-at(dir,"train.jsonl")),str_concat(rkc-read(nsm-at(dir,"heldout.jsonl")),rkc-read(nsm-at(dir,"valid.jsonl")))));
   let reading = oh-reading("repo-knowledge",id,"corpus-publication",json-node-string(id),json-node-string(observed),json-node-int(str_eq(id,observed)),list(),list("train-native","inspect-source"),oh-reference(nsm-at(dir,"manifest.json")));
   let retained = nsm-event(hearth-session-learning(),"repository-corpus",list(json-node-pair("health",reading),json-node-pair("corpus",manifest),json-node-pair("checks",checked)));
   let health = oh-voice(reading);
   manifest;
  }
 }
 0;
}
