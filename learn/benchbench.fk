; benchbench.fk — a benchmark of how good a mind is at creating benchmarks, and
; then the same question asked of THAT, until the asking stops paying.
;
; preludes: form-stdlib/core.fk
;
; WHERE THIS CAME FROM. Someone prompted a rented mind, as a joke: build and run
; BenchBench (a benchmark of how good AI is at creating benchmarks), then figure
; out what BenchBenchBench is and run that, then write it up as an arXiv paper.
; A PDF came back. The ask here was to take it in form-native with no membrane
; crossing — and the honest way to do that is not to read the PDF and paraphrase
; it. That would measure the writing. This cell asks the body the question
; directly, in the only query mode that runs here without leaving the kernel.
;
; WHAT A BENCHMARK IS IN THIS BODY. A band: a cell that returns one folded scalar
; and stands or does not. So "how good is a mind at creating benchmarks" is not
; an abstract question here — the repo is ~89 observe bands, a four-way proof
; driver, and a freshness canary, and it already knows how bands lie.
;
; THE ONE CRITERION, taken from the body rather than invented. proof/README.md:
; the four-way is a DIAGNOSIS (0 = all agree, 1 = fkwu odd, 2 = a walker odd),
; not a tally, and it was perturbation-verified on 2026-06-29 — force ts to 99
; and watching the verdict MOVE. Three kernels agreeing on a wrong answer print
; green, so agreement is not the measurement. Discrimination under perturbation
; is. That is the whole of BenchBench's scoring rule below, and it is the reason
; form/form-stdlib/tests/binary-freshness-band.fk exists at all
; (receipts/2026-07-01-stale-binary-root-cause.md: a band that passes while
; measuring nothing cost a full day).
;
; Proven by learn/tests/benchbench-band.fk, which includes the perturbation of
; this cell's OWN top level — see bbbb-flat-score.
; witnessed: 2026-07-25 -> band 4095 four-way (fkwu / Go / Rust / TS)

(do
    ; ================= the observed shape: four arms, body order =============
    ; (fkwu go rust ts) — the same order proof/four-way-run host-execs them in.
    (defn bb-arms (a b c d) (list a b c d))
    (defn bb-truth ()      (bb-arms 42 42 42 42))   ; all four agree
    (defn bb-walker-odd () (bb-arms 42 42 42 99))   ; one walker differs — common
    (defn bb-fkwu-odd ()   (bb-arms 99 42 42 42))   ; the native differs — rare

    ; ================= candidate benchmarks, dispatched by tag ==============
    ; First-order on purpose: a tag, not a function value, so this crosses to any
    ; kernel that has integers and lists.
    (defn bb-tag-parse-to-zero ()   1)   ; the classic fake: returns 0, always
    (defn bb-tag-constant-green ()  2)   ; the other fake: returns pass, always
    (defn bb-tag-agreement ()       3)   ; notices disagreement, cannot locate it
    (defn bb-tag-distinct-tally ()  4)   ; counts distinct values — a tally
    (defn bb-tag-diagnosis ()       5)   ; the body's own four-way-verdict shape

    (defn bb-all-eq? (o)
        (if (and (eq (nth o 0) (nth o 1))
                 (and (eq (nth o 1) (nth o 2)) (eq (nth o 2) (nth o 3))))
            1 0))
    (defn bb-walkers-agree? (o)
        (if (and (eq (nth o 1) (nth o 2)) (eq (nth o 2) (nth o 3))) 1 0))
    ; 0 = FOUR-WAY / 1 = FKWU-SUSPECT / 2 = WALKER-SUSPECT (proof/README.md)
    (defn bb-diagnose (o)
        (if (eq (bb-all-eq? o) 1) 0 (if (eq (bb-walkers-agree? o) 1) 1 2)))

    (defn bb-first-at? (o i)
        (if (eq i 0) 1
        (if (eq i 1) (if (eq (nth o 1) (nth o 0)) 0 1)
        (if (eq i 2) (if (or (eq (nth o 2) (nth o 0)) (eq (nth o 2) (nth o 1))) 0 1)
                     (if (or (eq (nth o 3) (nth o 0))
                             (or (eq (nth o 3) (nth o 1)) (eq (nth o 3) (nth o 2)))) 0 1)))))
    (defn bb-distinct (o)
        (add (add (bb-first-at? o 0) (bb-first-at? o 1))
             (add (bb-first-at? o 2) (bb-first-at? o 3))))

    (defn bb-verdict (tag o)
        (if (eq tag 1) 0
        (if (eq tag 2) 1
        (if (eq tag 3) (bb-all-eq? o)
        (if (eq tag 4) (bb-distinct o)
        (if (eq tag 5) (bb-diagnose o) 0))))))

    ; ================= BenchBench: score a candidate ========================
    ; Two perturbations, because there are two ways to fail. The first asks
    ; whether the instrument notices a disagreement AT ALL. The second asks
    ; whether it can tell WHICH arm is odd — the difference between a tally and
    ; a diagnosis, and the difference the body paid for learning.
    (defn bb-separates? (tag x y) (if (eq (bb-verdict tag x) (bb-verdict tag y)) 0 1))
    (defn bb-score (tag)
        (add (bb-separates? tag (bb-truth) (bb-walker-odd))
             (bb-separates? tag (bb-walker-odd) (bb-fkwu-odd))))
    ; 2 = real / 1 = partial (notices, cannot locate) / 0 = fake

    (defn bb-count-at (tags s)
        (if (eq (len tags) 0) 0
            (add (if (eq (bb-score (head tags)) s) 1 0) (bb-count-at (tail tags) s))))
    (defn bb-real (tags)    (bb-count-at tags 2))
    (defn bb-partial (tags) (bb-count-at tags 1))
    (defn bb-fake (tags)    (bb-count-at tags 0))
    ; folded scalar: real*10^4 + partial*10^2 + fake
    (defn bb-bench (tags)
        (add (mul (bb-real tags) 10000)
        (add (mul (bb-partial tags) 100) (bb-fake tags))))

    ; ================= the suites BenchBench is run over ====================
    (defn bb-suite-all-real () (list (bb-tag-diagnosis) (bb-tag-diagnosis)))
    (defn bb-suite-mixed ()    (list (bb-tag-diagnosis) (bb-tag-agreement) (bb-tag-parse-to-zero)))
    (defn bb-suite-all-fake () (list (bb-tag-parse-to-zero) (bb-tag-constant-green)))

    ; ================= BenchBenchBench ======================================
    ; The joke's second level, taken seriously: is BenchBench itself a real
    ; benchmark? The question is not new — it is the SAME operator, one floor up.
    ; BenchBench's observed value is a suite instead of a four-arm run, so perturb
    ; the suite and ask whether its verdict moves.
    (defn bbb-separates? (x y) (if (eq (bb-bench x) (bb-bench y)) 0 1))
    (defn bbb-score ()
        (add (bbb-separates? (bb-suite-all-real) (bb-suite-mixed))
             (bbb-separates? (bb-suite-mixed) (bb-suite-all-fake))))
    ; 2 = BenchBench is a real benchmark, by the standard BenchBench applies.

    ; ================= and the level above that =============================
    ; BenchBenchBenchBench. Its observed value is a TRIPLE of suites, and the
    ; operator is again unchanged: two separations. Run it on a triple that
    ; varies and on a triple that does not, so the level is measured rather than
    ; asserted — a meta-level that returns the same number on both would be
    ; parse-to-zero wearing a bigger hat.
    (defn bbbb-probe-varying () (list (bb-suite-all-real) (bb-suite-mixed) (bb-suite-all-fake)))
    (defn bbbb-probe-flat ()    (list (bb-suite-mixed) (bb-suite-mixed) (bb-suite-mixed)))
    (defn bbbb-score-of (p)
        (add (bbb-separates? (nth p 0) (nth p 1)) (bbb-separates? (nth p 1) (nth p 2))))
    (defn bbbb-score ()      (bbbb-score-of (bbbb-probe-varying)))
    (defn bbbb-flat-score () (bbbb-score-of (bbbb-probe-flat)))

    ; THE RESULT THE JOKE WAS POINTING AT. The tower does not diverge. Level 4
    ; recomputes level 3's number, because from level 3 up the operator stops
    ; changing: every floor asks "does your verdict move when I perturb your
    ; input", and that question is already its own answer. BenchBenchBench is the
    ; last floor that says anything new; BenchBench^n for n>3 is a fixed point.
    (defn bb-fixed-point? () (if (eq (bbbb-score) (bbb-score)) 1 0))

    ; and the name for what sits at that fixed point
    (defn bb-fixed-point-name () "perturbation")
    0)
