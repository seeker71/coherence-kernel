; corpus-teach-samples.fk — the distillation corpus, rendered as something the
; local model can be taught from.
;
; THE GAP THIS CLOSES. On 2026-08-25, `form-cli-knowledge-mint.bml` and
; `form-cli-qwen-teach-layer.fk` between them contained ZERO references to
; homecoming-distillation-corpus.fk. One thousand and seventy-eight rows of
; distilled knowledge — every one of them a question this body could not answer
; natively and the fresh word that answered it — and the path that teaches the
; local model was minting its own samples from hardcoded stems instead.
;
; The corpus rows are already the right shape for teaching: a question in tokens
; and the one word that answers it, with the date it was won and the source that
; answered. Nothing needed inventing. It needed connecting.
;
; This cell renders them and nothing else. It classifies nothing, scores nothing,
; and refuses nothing — a row is a sample, and which samples a teacher wants is
; the teacher's decision, not this cell's.
;
; preludes: form-stdlib/core.fk learn/homecoming-distillation-corpus.fk

(do
    (defn cts-mid    (r) (nth r 0))
    (defn cts-date   (r) (nth r 1))
    (defn cts-tokens (r) (nth r 2))
    (defn cts-answer (r) (nth r 3))
    (defn cts-source (r) (nth r 5))

    (defn cts-join (ws acc)
        (if (eq (len ws) 0) acc
            (cts-join (tail ws)
                (str_concat acc (str_concat (if (str_eq acc "") "" " ") (head ws))))))

    (defn cts-question (r) (str_concat (cts-join (cts-tokens r) "") "?"))

    ; one sample, in the plainest shape a prompt or a fine-tune row can take
    (defn cts-sample (r)
        (str_concat "Q: " (str_concat (cts-question r)
            (str_concat "\nA: " (cts-answer r)))))

    (defn cts-samples-go (rs acc)
        (if (eq (len rs) 0) acc
            (cts-samples-go (tail rs) (append acc (list (cts-sample (head rs)))))))
    (defn cts-samples () (cts-samples-go (hdc-rows) (empty)))

    ; the rows won since a given meaning-id — what a teacher has not seen yet
    (defn cts-since-go (rs m acc)
        (if (eq (len rs) 0) acc
            (cts-since-go (tail rs) m
                (if (gt (cts-mid (head rs)) m) (append acc (list (head rs))) acc))))
    (defn cts-since (m) (cts-since-go (hdc-rows) m (empty)))

    (defn cts-count () (len (hdc-rows)))
    (defn cts-max-mid () (hdc-max-mid (hdc-rows)))

    ; a row located by its answer, so a teacher can check recall the same way the
    ; body checks it: the word must come back with the question that won it.
    (defn cts-row-for-go (rs w)
        (if (eq (len rs) 0) (empty)
            (if (str_eq (cts-answer (head rs)) w) (head rs)
                (cts-row-for-go (tail rs) w))))
    (defn cts-row-for (w) (cts-row-for-go (hdc-rows) w))
    (defn cts-knows? (w) (if (eq (len (cts-row-for w)) 0) 0 1))

    0)
