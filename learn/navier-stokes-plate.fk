; navier-stokes-plate.fk — the body draws the equation itself, and says what it drew.
;
; preludes: form-stdlib/core.fk learn/navier-stokes.fk
;
; THE ASK WAS 100% FORM NATIVE. So nothing here is a picture handed over and pasted in:
; every coordinate is computed by this cell from learn/navier-stokes.fk, and the SVG
; text is assembled by the kernel and written out with write_file_text. The five lens
; glyphs are not decoration — each is one bar per exponent of that term's dimension
; triple, drawn at the height the arithmetic gives, so a wrong dimension would be
; visibly wrong in the picture at the same place the band goes red.
;
; The two profiles at the foot are exact solutions of the equation, evaluated here:
; plane Poiseuille and plane Couette. Both are unidirectional, so the convective term
; vanishes identically, and what remains is a pressure gradient standing against
; curvature — which the plate shows by drawing the curvature this cell computes.
;
; ON THE VOICE. `nsp-description` composes its sentences in the kernel, walking the
; term rows in learn/navier-stokes.fk rather than reciting a paragraph stored as one
; string. That is composition from the body's own structure, and it is as far as this
; seam honestly reaches today — native GENERATION is still pending, tracked at
; receipts/2026-06-29-native-zh-summary-PENDING.md. Naming the difference is the point;
; calling this "native voice" outright would be overclaiming by exactly one rung.
;
; Every builder below is written flat, one `let` per fragment. The first draft nested
; str_concat eight deep and lost a paren the reader caught — depth is not free here,
; it is just harder to check.
;
; Emit:  (nsp-write-svg  "teachings/navier-stokes-plate.svg")
;        (nsp-write-text "teachings/navier-stokes-description.txt")
; Proven by learn/tests/navier-stokes-plate-band.fk.

(do
    ; ── string helpers ───────────────────────────────────────────────────────
    (defn nsp-n (v) (int_to_str v))
    (defn nsp-c2 (a b) (str_concat a b))
    (defn nsp-c3 (a b c) (str_concat a (str_concat b c)))
    (defn nsp-c4 (a b c d) (str_concat a (str_concat b (str_concat c d))))
    (defn nsp-q () "\"")
    (defn nsp-attr (k v)
        (do
            (let head (nsp-c3 " " k "="))
            (nsp-c4 head (nsp-q) v (nsp-q))))
    (defn nsp-attr-n (k v) (nsp-attr k (nsp-n v)))
    (defn nsp-nl (s) (nsp-c2 s "\n"))

    (defn nsp-line (x1 y1 x2 y2 col w)
        (do
            (let a (nsp-c2 "<line" (nsp-attr-n "x1" x1)))
            (let b (nsp-c2 a (nsp-attr-n "y1" y1)))
            (let c (nsp-c2 b (nsp-attr-n "x2" x2)))
            (let d (nsp-c2 c (nsp-attr-n "y2" y2)))
            (let e (nsp-c2 d (nsp-attr "stroke" col)))
            (let f (nsp-c2 e (nsp-attr "stroke-width" w)))
            (nsp-nl (nsp-c2 f "/>"))))

    (defn nsp-rect (x y w h fill)
        (do
            (let a (nsp-c2 "<rect" (nsp-attr-n "x" x)))
            (let b (nsp-c2 a (nsp-attr-n "y" y)))
            (let c (nsp-c2 b (nsp-attr-n "width" w)))
            (let d (nsp-c2 c (nsp-attr-n "height" h)))
            (let e (nsp-c2 d (nsp-attr "fill" fill)))
            (nsp-nl (nsp-c2 e "/>"))))

    (defn nsp-circle (cx cy r fill stroke)
        (do
            (let a (nsp-c2 "<circle" (nsp-attr-n "cx" cx)))
            (let b (nsp-c2 a (nsp-attr-n "cy" cy)))
            (let c (nsp-c2 b (nsp-attr-n "r" r)))
            (let d (nsp-c2 c (nsp-attr "fill" fill)))
            (let e (nsp-c2 d (nsp-attr "stroke" stroke)))
            (let f (nsp-c2 e (nsp-attr "stroke-width" "1")))
            (nsp-nl (nsp-c2 f "/>"))))

    (defn nsp-text (x y size col anchor body)
        (do
            (let a (nsp-c2 "<text" (nsp-attr-n "x" x)))
            (let b (nsp-c2 a (nsp-attr-n "y" y)))
            (let c (nsp-c2 b (nsp-attr "font-size" (nsp-n size))))
            (let d (nsp-c2 c (nsp-attr "fill" col)))
            (let e (nsp-c2 d (nsp-attr "text-anchor" anchor)))
            (let f (nsp-c3 e ">" body))
            (nsp-nl (nsp-c2 f "</text>"))))

    ; ── palette, one hue per term, in the order the equation is written ──────
    (defn nsp-hue (i)
        (if (eq i 0) "#BE8A2C"
        (if (eq i 1) "#2F5FA8"
        (if (eq i 2) "#6B7079"
        (if (eq i 3) "#7A5FB0" "#2E8B84")))))
    (defn nsp-ink () "#15171B")
    (defn nsp-muted () "#8B8E95")
    (defn nsp-hair () "#E4E1D9")

    ; ── plate geometry, all of it arithmetic ────────────────────────────────
    (defn nsp-w () 1040)
    (defn nsp-h () 940)
    (defn nsp-lens-r () 56)
    (defn nsp-lens-y () 210)
    (defn nsp-lens-x (i) (add 128 (mul i 196)))
    (defn nsp-gem-cx () 520)
    (defn nsp-gem-cy () 452)

    ; ── a lens: the term's dimension triple drawn as three signed bars ──────
    (defn nsp-bar (cx base i expo col)
        (do
            (let x (add (sub cx 27) (mul i 18)))
            (let mag (if (lt expo 0) (sub 0 expo) expo))
            (let hgt (mul mag 13))
            (if (eq expo 0)
                (nsp-line x base (add x 12) base (nsp-muted) "1.4")
                (if (lt expo 0)
                    (nsp-rect x base 12 hgt col)
                    (nsp-rect x (sub base hgt) 12 hgt col)))))

    (defn nsp-dim-caption (d)
        (do
            (let a (nsp-c2 "M " (nsp-n (ns-dim-m d))))
            (let b (nsp-c3 a "   L " (nsp-n (ns-dim-l d))))
            (nsp-c3 b "   T " (nsp-n (ns-dim-t d)))))

    (defn nsp-lens (i)
        (do
            (let cx (nsp-lens-x i))
            (let cy (nsp-lens-y))
            (let d (ns-term-dim i))
            (let col (nsp-hue i))
            (let s1 (nsp-circle cx cy (nsp-lens-r) "none" (nsp-hair)))
            (let s2 (nsp-c2 s1 (nsp-line (sub cx 34) cy (add cx 34) cy (nsp-hair) "1")))
            (let s3 (nsp-c2 s2 (nsp-bar cx cy 0 (ns-dim-m d) col)))
            (let s4 (nsp-c2 s3 (nsp-bar cx cy 1 (ns-dim-l d) col)))
            (let s5 (nsp-c2 s4 (nsp-bar cx cy 2 (ns-dim-t d) col)))
            (let s6 (nsp-c2 s5 (nsp-text cx (sub cy 84) 18 (nsp-ink) "middle" (ns-term-name i))))
            (let s7 (nsp-c2 s6 (nsp-text cx (sub cy 66) 12 (nsp-muted) "middle" (ns-term-symbol i))))
            (let s8 (nsp-c2 s7 (nsp-text cx (add cy 80) 11 (nsp-muted) "middle" (nsp-dim-caption d))))
            (nsp-c2 s8 (nsp-text cx (add cy 96) 9 (nsp-muted) "middle" "exponents of M L T"))))

    (defn nsp-lenses-loop (i acc)
        (if (eq i 5) acc (nsp-lenses-loop (add i 1) (nsp-c2 acc (nsp-lens i)))))
    (defn nsp-lenses () (nsp-lenses-loop 0 ""))

    ; ── a stream from the crystal up to each lens ───────────────────────────
    (defn nsp-stream (i)
        (do
            (let cx (nsp-lens-x i))
            (let mx (div (add cx (nsp-gem-cx)) 2))
            (let p1 (nsp-c3 "M " (nsp-n (nsp-gem-cx)) " "))
            (let p2 (nsp-c3 p1 (nsp-n (sub (nsp-gem-cy) 78)) " Q "))
            (let p3 (nsp-c3 p2 (nsp-n mx) " "))
            (let p4 (nsp-c3 p3 (nsp-n (sub (nsp-gem-cy) 156)) " "))
            (let p5 (nsp-c3 p4 (nsp-n cx) " "))
            (let p6 (nsp-c2 p5 (nsp-n (add (nsp-lens-y) (nsp-lens-r)))))
            (let a (nsp-c2 "<path" (nsp-attr "d" p6)))
            (let b (nsp-c2 a (nsp-attr "fill" "none")))
            (let c (nsp-c2 b (nsp-attr "stroke" (nsp-hue i))))
            (let e (nsp-c2 c (nsp-attr "stroke-width" "1.3")))
            (let f (nsp-c2 e (nsp-attr "opacity" "0.5")))
            (nsp-nl (nsp-c2 f "/>"))))
    (defn nsp-streams-loop (i acc)
        (if (eq i 5) acc (nsp-streams-loop (add i 1) (nsp-c2 acc (nsp-stream i)))))
    (defn nsp-streams () (nsp-streams-loop 0 ""))

    ; ── the crystal: a hexagon with its own facet lines ─────────────────────
    (defn nsp-pt (x y) (nsp-c3 (nsp-n x) "," (nsp-c2 (nsp-n y) " ")))
    (defn nsp-gem-points ()
        (do
            (let cx (nsp-gem-cx))
            (let cy (nsp-gem-cy))
            (let a (nsp-pt cx (sub cy 78)))
            (let b (nsp-c2 a (nsp-pt (add cx 68) (sub cy 39))))
            (let c (nsp-c2 b (nsp-pt (add cx 68) (add cy 39))))
            (let d (nsp-c2 c (nsp-pt cx (add cy 78))))
            (let e (nsp-c2 d (nsp-pt (sub cx 68) (add cy 39))))
            (nsp-c2 e (nsp-pt (sub cx 68) (sub cy 39)))))

    (defn nsp-gem ()
        (do
            (let cx (nsp-gem-cx))
            (let cy (nsp-gem-cy))
            (let a (nsp-c2 "<polygon" (nsp-attr "points" (nsp-gem-points))))
            (let b (nsp-c2 a (nsp-attr "fill" "#FFFFFF")))
            (let c (nsp-c2 b (nsp-attr "stroke" (nsp-muted))))
            (let d (nsp-c2 c (nsp-attr "stroke-width" "1")))
            (let poly (nsp-nl (nsp-c2 d "/>")))
            (let f1 (nsp-c2 poly (nsp-line cx (sub cy 78) cx (add cy 78) (nsp-hair) "0.8")))
            (let f2 (nsp-c2 f1 (nsp-line (sub cx 68) (sub cy 39) (add cx 68) (add cy 39) (nsp-hair) "0.8")))
            (let f3 (nsp-c2 f2 (nsp-line (add cx 68) (sub cy 39) (sub cx 68) (add cy 39) (nsp-hair) "0.8")))
            (let t1 (nsp-c2 f3 (nsp-text cx (sub cy 8) 17 (nsp-ink) "middle" "rho Du/Dt")))
            (let t2 (nsp-c2 t1 (nsp-line (sub cx 48) (sub cy 2) (add cx 48) (sub cy 2) (nsp-ink) "0.9")))
            (nsp-c2 t2 (nsp-text cx (add cy 20) 13 (nsp-muted) "middle" "div u = 0"))))

    ; ── the two exact solutions, plotted from the values themselves ─────────
    (defn nsp-half () 12)
    (defn nsp-slope () 6)
    (defn nsp-peak () 144)
    (defn nsp-plot-w () 300)
    (defn nsp-row-h () 11)
    (defn nsp-scale (uval) (div (mul uval (nsp-plot-w)) (nsp-peak)))

    (defn nsp-profile-row (x0 ybase y uval col)
        (do
            (let yy (add ybase (mul y (nsp-row-h))))
            (let xe (add x0 (nsp-scale uval)))
            (nsp-c2 (nsp-line x0 yy xe yy col "2.4") (nsp-circle xe yy 2 col col))))

    (defn nsp-profile-value (kind y)
        (if (eq kind 0) (ns-poiseuille (nsp-half) y) (ns-couette (nsp-half) (nsp-slope) y)))

    (defn nsp-profile-loop (x0 ybase y kind col acc)
        (if (gt y (nsp-half))
            acc
            (nsp-profile-loop x0 ybase (add y 1) kind col
                (nsp-c2 acc (nsp-profile-row x0 ybase y (nsp-profile-value kind y) col)))))

    (defn nsp-panel (x0 ybase kind title formula note)
        (do
            (let col (if (eq kind 0) (nsp-hue 2) (nsp-hue 3)))
            (let top (sub ybase (mul (nsp-half) (nsp-row-h))))
            (let bot (add ybase (mul (nsp-half) (nsp-row-h))))
            (let a (nsp-line x0 top x0 bot (nsp-ink) "1.4"))
            (let b (nsp-c2 a (nsp-line (sub x0 16) top (add x0 (nsp-plot-w)) top (nsp-hair) "1")))
            (let c (nsp-c2 b (nsp-line (sub x0 16) bot (add x0 (nsp-plot-w)) bot (nsp-hair) "1")))
            (let d (nsp-c2 c (nsp-profile-loop x0 ybase (sub 0 (nsp-half)) kind col "")))
            (let e (nsp-c2 d (nsp-text x0 (sub top 58) 18 (nsp-ink) "start" title)))
            (let f (nsp-c2 e (nsp-text x0 (sub top 38) 13 (nsp-ink) "start" formula)))
            (nsp-c2 f (nsp-text x0 (sub top 20) 11 (nsp-muted) "start" note))))

    ; ── the whole document ──────────────────────────────────────────────────
    (defn nsp-viewbox ()
        (do
            (let a (nsp-c2 "0 0 " (nsp-n (nsp-w))))
            (nsp-c3 a " " (nsp-n (nsp-h)))))

    (defn nsp-header ()
        (do
            (let a (nsp-c2 "<svg xmlns=\"http://www.w3.org/2000/svg\"" (nsp-attr "viewBox" (nsp-viewbox))))
            (let b (nsp-c2 a (nsp-attr-n "width" (nsp-w))))
            (let c (nsp-c2 b (nsp-attr-n "height" (nsp-h))))
            (let d (nsp-c2 c (nsp-attr "font-family" "Palatino, Georgia, serif")))
            (nsp-nl (nsp-c2 d ">"))))

    (defn nsp-titles ()
        (do
            (let a (nsp-text 520 50 27 (nsp-ink) "middle" "One balance, five terms"))
            (let b (nsp-c2 a (nsp-text 520 72 13 (nsp-muted) "middle"
                        "every term is a force per unit volume - that is why they may be added")))
            (nsp-c2 b (nsp-text 520 (sub (nsp-h) 20) 11 (nsp-muted) "middle"
                        "computed and drawn by learn/navier-stokes-plate.fk from learn/navier-stokes.fk"))))

    (defn nsp-svg ()
        (do
            (let a (nsp-c2 (nsp-header) (nsp-rect 0 0 (nsp-w) (nsp-h) "#FBFAF7")))
            (let b (nsp-c2 a (nsp-titles)))
            (let c (nsp-c2 b (nsp-streams)))
            (let d (nsp-c2 c (nsp-lenses)))
            (let e (nsp-c2 d (nsp-gem)))
            (let f (nsp-c2 e (nsp-panel 120 760 0 "plane Poiseuille" "u  =  H^2 - y^2"
                        "curvature -2 everywhere - a pressure gradient stands against it")))
            (let g (nsp-c2 f (nsp-panel 620 760 1 "plane Couette" "u  =  k (y + H)"
                        "curvature 0 - no pressure gradient is needed")))
            (nsp-c2 g "</svg>\n")))

    (defn nsp-write-svg (path) (write_file_text path (nsp-svg)))

    ; ── the description, composed by walking the same rows ──────────────────
    (defn nsp-term-sentence (i)
        (do
            (let d (ns-term-dim i))
            (let a (nsp-c3 "  " (ns-term-symbol i) " is the "))
            (let b (nsp-c3 a (ns-term-name i) " term: "))
            (let c (nsp-c3 b (ns-term-says i) ". Its dimension is M "))
            (let e (nsp-c3 c (nsp-n (ns-dim-m d)) ", L "))
            (let f (nsp-c3 e (nsp-n (ns-dim-l d)) ", T "))
            (nsp-c3 f (nsp-n (ns-dim-t d)) ".\n")))

    (defn nsp-terms-said-loop (i acc)
        (if (eq i 5) acc (nsp-terms-said-loop (add i 1) (nsp-c2 acc (nsp-term-sentence i)))))

    (defn nsp-description ()
        (do
            (let a "The incompressible Navier-Stokes equations, as this body holds them.\n\n")
            (let b (nsp-c2 a "rho du/dt + rho (u.grad)u = -grad p + mu lap u + rho g,  with div u = 0.\n\n"))
            (let c (nsp-c2 b "Five terms stand in one balance:\n"))
            (let d (nsp-c2 c (nsp-terms-said-loop 0 "")))
            (let e (nsp-c2 d "\nAll five reduce to M 1, L -2, T -2 - force per unit volume - and that shared\n"))
            (let f (nsp-c2 e "dimension is the whole reason they may be added at all. Continuity is not one\n"))
            (let g (nsp-c2 f "of them: div u is a rate, M 0, L 0, T -1, and it constrains the field rather\n"))
            (let h (nsp-c2 g "than pushing it.\n\n"))
            (let i (nsp-c2 h "Two exact solutions are computed here rather than quoted. Plane Poiseuille,\n"))
            (let j (nsp-c3 i "u = H^2 - y^2, has curvature " (nsp-n (ns-curvature-poiseuille (nsp-half) 0))))
            (let k (nsp-c2 j " everywhere, so a pressure\ngradient must stand against it. Plane Couette, u = k (y + H), has curvature "))
            (let l (nsp-c2 k (nsp-n (ns-curvature-couette (nsp-half) (nsp-slope) 0))))
            (let m (nsp-c2 l ",\nand needs no pressure gradient at all. Both are unidirectional, so the\nconvective term vanishes identically.\n\n"))
            (let o (nsp-c2 m "The Reynolds number is the ratio of the convective term to the viscous one.\n"))
            (let p (nsp-c3 o "For water at one metre per second across one metre it is " (nsp-n (ns-water-reynolds))))
            (let q (nsp-c2 p ".\n\nWhether smooth solutions in three dimensions always exist for all time is\n"))
            (nsp-c2 q "open, and this body records it as open rather than answering it.\n")))

    (defn nsp-write-text (path) (write_file_text path (nsp-description)))

    0)
