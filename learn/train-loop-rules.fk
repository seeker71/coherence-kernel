; train-loop-rules.fk — the day's diagnoses as executable rules, not prose.
;
; On 2026-08-26 a frontier mind sat between every pair of training runs and
; decided what to do next. Each decision, examined, was a rule over measured
; hit-rates — nothing in it was irreducibly frontier-shaped. This cell IS
; those rules, so the next loop consults a recipe where a mind used to sit.
;
; An observation is what one evaluation measured. A directive is what the loop
; does next. Rules match observations to directives in witnessed-priority
; order, and an observation no rule matches is NOTHING — the loop stops and
; surfaces, because an unmatched state is precisely where a mind is still
; needed. That third state is the honesty of this cell: it knows its own edge.
;
; Each rule carries the day's witness beside it. None is speculation.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/train-loop-rules-band.fk

(do
    ; ── an observation: one evaluation, as permille hit-rates ──────────────
    ; format-pm: answers in the target shape (one word)
    ; facts-pm:  seen facts recalled under reworded questions
    ; unknown-fabricated-pm: unknown probes answered with an invented token
    ; abstain-known-pm: known facts wrongly answered "nothing" under permission
    (defn tlr-obs (format-pm facts-pm unknown-fabricated-pm abstain-known-pm)
        (list "train-obs-v1" format-pm facts-pm unknown-fabricated-pm abstain-known-pm))
    (defn tlr-format (o)  (nth o 1))
    (defn tlr-facts (o)   (nth o 2))
    (defn tlr-fabri (o)   (nth o 3))
    (defn tlr-abstain (o) (nth o 4))

    ; ── directives: what the loop emits or runs next ───────────────────────
    (defn tlr-d-more-epochs ()      "train-more-epochs")
    (defn tlr-d-nothing-rows ()     "emit-nothing-rows")
    (defn tlr-d-coverage-rows ()    "mint-coverage-rows-from-sources")
    (defn tlr-d-calibration-rows () "emit-permission-phrased-fact-rows")
    (defn tlr-d-rest ()             "rest-and-fuse")

    ; ── the rules, in witnessed-priority order ─────────────────────────────
    ; fabrication first: an invented token poisons every downstream reading.
    ;   witness: base answered NR_replace for CAN-not-MUST -> nothing-rows
    ;            landed 3/3 on unseen stems (#494, #495)
    ; then under-exposure: format arrives before facts.
    ;   witness: 0.55 epochs -> one-word shape, 0/12 facts; 9 epochs -> 9/12
    ; then coverage: right shape, right exposure, still missing.
    ;   witness: heldout v3 misses were all facts absent from training
    ; then calibration: honesty eating recall.
    ;   witness: abstaintax 2/6 — changeling, candor withheld under permission
    (defn tlr-decide (o)
        (if (gt (tlr-fabri o) 100) (tlr-d-nothing-rows)
        (if (and (ge (tlr-format o) 800) (lt (tlr-facts o) 500))
            (tlr-d-more-epochs)
        (if (and (ge (tlr-format o) 800) (lt (tlr-facts o) 900))
            (tlr-d-coverage-rows)
        (if (gt (tlr-abstain o) 200) (tlr-d-calibration-rows)
        (if (and (ge (tlr-facts o) 900) (le (tlr-abstain o) 200))
            (tlr-d-rest)
            (nothing)))))))

    ; ── the loop's stop sense: two rounds without lift is a plateau ────────
    ;   witness: every productive retrain today lifted facts-pm; a loop that
    ;   cannot lift must hand back to a mind, not spin the door.
    (defn tlr-lifted? (prev cur) (if (gt (tlr-facts cur) (tlr-facts prev)) 1 0))
    (defn tlr-plateau? (a b c)
        (if (and (eq (tlr-lifted? a b) 0) (eq (tlr-lifted? b c) 0)) 1 0))

    0)
