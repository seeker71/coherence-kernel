// nl-meaning-error-adaptation.fk — witnessed mistakes become training signal,
// while a separate untouched partition adjudicates whether adaptation transfers.
import "nl-meaning-inquiry-learning.fk"
section [form.bml] {
    def nmea-split-loop(rows, index, adapt, eval) = (Comparable) len(rows) == 0 ? [adapt, eval] : (Comparable) (index % 2) == 0 ? nmea-split-loop(rows[1:], (Number) index + (Number) 1, cons(rows[0], adapt), eval) : nmea-split-loop(rows[1:], (Number) index + (Number) 1, adapt, cons(rows[0], eval));
    def nmea-split(rows) = nmea-split-loop(rows, 0, [], []);
    def nmea-errors(stack, rows, protos) = (Comparable) len(rows) == 0 ? [] : {
        let row = rows[0];
        let predicted = nmn-classify(stack, nmn-vec-norm(nmc-ex-text(row), nmil-d()), protos, nmil-eps());
        (Comparable) predicted == nmc-ex-class(row) ? nmea-errors(stack, rows[1:], protos) : cons(row, nmea-errors(stack, rows[1:], protos));
    };
    def nmea-predict(stack, row, protos) = nmn-classify(stack, nmn-vec-norm(nmc-ex-text(row), nmil-d()), protos, nmil-eps());
    // Transition counts are [correct->wrong, wrong->correct,
    // correct->correct, wrong->wrong]. They observe behavior directly.
    def nmea-transition-add(counts, truth, before, after) = {
        let before-ok = (Comparable) before == truth ? 1 : 0;
        let after-ok = (Comparable) after == truth ? 1 : 0;
        (Comparable) before-ok == 1 && (Comparable) after-ok == 0 ? [(Number) counts[0] + (Number) 1, counts[1], counts[2], counts[3]] : (Comparable) before-ok == 0 && (Comparable) after-ok == 1 ? [counts[0], (Number) counts[1] + (Number) 1, counts[2], counts[3]] : (Comparable) before-ok == 1 ? [counts[0], counts[1], (Number) counts[2] + (Number) 1, counts[3]] : [counts[0], counts[1], counts[2], (Number) counts[3] + (Number) 1];
    };
    // Returns [error-only transitions, rehearsal transitions, changed rows].
    // A changed row is [text-hash, byte-length, truth, base, error-only, rehearsal].
    def nmea-observe-transitions(rows, protos, base, error-only, rehearsal, errc, rehc, changed) = (Comparable) len(rows) == 0 ? [errc, rehc, changed] : {
        let row = rows[0];
        let truth = nmc-ex-class(row);
        let p0 = nmea-predict(base, row, protos);
        let pe = nmea-predict(error-only, row, protos);
        let pr = nmea-predict(rehearsal, row, protos);
        let record = [nmn-hash(nmc-ex-text(row)), len(nmc-ex-text(row)), truth, p0, pe, pr];
        nmea-observe-transitions(rows[1:], protos, base, error-only, rehearsal, nmea-transition-add(errc, truth, p0, pe), nmea-transition-add(rehc, truth, p0, pr), !((Comparable) p0 == pe) || !((Comparable) p0 == pr) ? cons(record, changed) : changed);
    };
    def nmea-observation-witness() = {
        let original = nmil-training-raw();
        let split = nmea-split(nmil-held-raw());
        let adapt = split[0];
        let eval = split[1];
        let protos = nmil-protos();
        let base = nmn-train(nmn-stack(nmil-d()), nmil-encode-training(original), 0.02, nmil-eps(), 40);
        let errors = nmea-errors(base, adapt, protos);
        let error-only = nmn-train(base, nmil-encode-training(errors), 0.01, nmil-eps(), 60);
        let replay = nmc-concat(nmil-encode-training(original), nmil-encode-training(errors));
        let rehearsal = nmn-train(base, replay, 0.01, nmil-eps(), 20);
        let observed = nmea-observe-transitions(eval, protos, base, error-only, rehearsal, [0, 0, 0, 0], [0, 0, 0, 0], []);
        let error-transitions = observed[0];
        let rehearsal-transitions = observed[1];
        let changed = observed[2];
        framebuffer-clear();
        let event0 = fb_record(intern_trivial_int(error-transitions[0]), "nl-meaning-error-adaptation.fk", 10);
        let event1 = fb_record(intern_trivial_int(error-transitions[1]), "nl-meaning-error-adaptation.fk", 11);
        let event2 = fb_record(intern_trivial_int(rehearsal-transitions[0]), "nl-meaning-error-adaptation.fk", 12);
        let event3 = fb_record(intern_trivial_int(rehearsal-transitions[1]), "nl-meaning-error-adaptation.fk", 13);
        let frames = len(framebuffer-events());
        [nothing(), 0, 1, 1001099005, len(eval), error-transitions, rehearsal-transitions, changed, frames, error-transitions[0] > error-transitions[1] && (rehearsal-transitions[1] > rehearsal-transitions[0] && (Comparable) frames == 4) ? 1 : 0];
    };
    def nmea-witness() = {
        let original = nmil-training-raw();
        let split = nmea-split(nmil-held-raw());
        let adapt = split[0];
        let eval = split[1];
        let protos = nmil-protos();
        let base = nmn-train(nmn-stack(nmil-d()), nmil-encode-training(original), 0.02, nmil-eps(), 40);
        let before = nmil-evaluate(base, eval, protos, [0, 0, 0]);
        let errors = nmea-errors(base, adapt, protos);
        // Observed misses enter learning alongside a replay of the established
        // ground. The separate transition witness measures whether this changes
        // regressions; no internal causal mechanism is asserted here.
        let rehearsal = nmc-concat(nmil-encode-training(original), nmil-encode-training(errors));
        let adapted = nmn-train(base, rehearsal, 0.01, nmil-eps(), 20);
        let after = nmil-evaluate(adapted, eval, protos, [0, 0, 0]);
        let before-correct = before[0];
        let after-correct = after[0];
        let inquiry-ok = after[2];
        let expected-inquiries = len(eval) * 7;
        let trace-before = [fb-frame(0, 1, 1), fb-frame(1, before-correct, 1)];
        let trace-after = [fb-frame(0, 1, 1), fb-frame(1, after-correct, 1)];
        let adaptation-divergence = diverge(trace-before, trace-after);
        framebuffer-clear();
        let event0 = fb_record(intern_trivial_int(len(errors)), "nl-meaning-error-adaptation.fk", 1);
        let event1 = fb_record(intern_trivial_int(before-correct), "nl-meaning-error-adaptation.fk", 2);
        let event2 = fb_record(intern_trivial_int(after-correct), "nl-meaning-error-adaptation.fk", 3);
        let event3 = fb_record(intern_trivial_int(inquiry-ok), "nl-meaning-error-adaptation.fk", 4);
        let frames = len(framebuffer-events());
        [nothing(), 0, 1, 1001099004, len(original), len(adapt), len(errors), len(eval), before-correct, after-correct, inquiry-ok, expected-inquiries, adaptation-divergence, frames, len(errors) > 0 && (after-correct > before-correct && ((Comparable) inquiry-ok == expected-inquiries && ((Comparable) adaptation-divergence == 1 && (Comparable) frames == 4))) ? 1 : 0];
    };
    0;
}
