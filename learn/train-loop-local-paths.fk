// train-loop-local-paths.fk — the one observed residence for this Mac's local
// Llama authoring lineage.  Model commands receive absolute paths only.  A
// Hugging Face repository name is provenance, never an executable locator.
//
// The six fused files are the locally runnable model manifest. A lone
// model.safetensors is weights, not a model voice: tokenizer and configuration
// travel in the same admitted artifact.
//
import form-stdlib/core.fk;
import form-stdlib/model-registry.bml;
import form-stdlib/native-fused-generation.bml;
section [form.bml] {
    def tlp-base-model() = mr-path(mr-find("llama32-3b-mlx-4bit"));
    def tlp-authoring-adapter() = "/Users/ursmuff/.coherence-network/form-train-runs/homecoming-authoring-adapter-20260826-2120";
    def tlp-authoring-fused() = "/Users/ursmuff/.coherence-network/form-train-runs/form-llama-3b-fused-authoring-20260826";
    def tlp-offline-env() = "HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1";
    def tlp-test-executable() = "/bin/test";
    def tlp-fused-roles() = ["config", "weights", "weights-index", "tokenizer", "tokenizer-config", "chat-template"];
    def tlp-join(dir, name) = (dir + ("/" + name));
    def tlp-fused-paths(dir) = nfg-paths(nfg-resolve(dir), nfg-names());
    def tlp-all-present?(paths) = (Comparable) len(paths) == 0 ? 1 : file_size(paths[0]) > 0 ? tlp-all-present?(paths[1:]) : 0;
    def tlp-base-ready?() = tlp-all-present?([tlp-join(tlp-base-model(), "config.json"), tlp-join(tlp-base-model(), "model.safetensors"), tlp-join(tlp-base-model(), "tokenizer.json"), tlp-join(tlp-base-model(), "tokenizer_config.json")]);
    def tlp-adapter-ready?(dir) = {
        let generation = nag-resolve(dir);
        tlp-all-present?([tlp-join(generation, "adapters.safetensors"), tlp-join(generation, "adapter_config.json")]);
    };
    def tlp-fused-ready?(dir) = tlp-all-present?(tlp-fused-paths(dir));
    0;
}
