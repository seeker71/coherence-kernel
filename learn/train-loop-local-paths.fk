; train-loop-local-paths.fk — the one observed residence for this Mac's local
; Llama authoring lineage.  Model commands receive absolute paths only.  A
; Hugging Face repository name is provenance, never an executable locator.
;
; The six fused files are the locally runnable model manifest. A lone
; model.safetensors is weights, not a model voice: tokenizer and configuration
; travel in the same admitted artifact.
;
; preludes: form-stdlib/core.fk form-stdlib/model-registry.bml form-stdlib/native-fused-generation.bml

(do
    (defn tlp-base-model ()
        (mr-path (mr-find "llama32-3b-mlx-4bit")))
    (defn tlp-authoring-adapter ()
        "/Users/ursmuff/.coherence-network/form-train-runs/homecoming-authoring-adapter-20260826-2120")
    (defn tlp-authoring-fused ()
        "/Users/ursmuff/.coherence-network/form-train-runs/form-llama-3b-fused-authoring-20260826")

    (defn tlp-offline-env ()
        "HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1")
    (defn tlp-test-executable () "/bin/test")

    (defn tlp-fused-roles ()
        (list "config" "weights" "weights-index" "tokenizer"
              "tokenizer-config" "chat-template"))
    (defn tlp-fused-names () (nfg-names))
    (defn tlp-join (dir name) (str_concat dir (str_concat "/" name)))
    (defn tlp-fused-paths (dir) (nfg-paths (nfg-resolve dir) (nfg-names)))
    (defn tlp-all-present? (paths)
        (if (eq (len paths) 0) 1
            (if (gt (file_size (head paths)) 0)
                (tlp-all-present? (tail paths)) 0)))
    (defn tlp-base-ready? ()
        (tlp-all-present?
            (list (tlp-join (tlp-base-model) "config.json")
                  (tlp-join (tlp-base-model) "model.safetensors")
                  (tlp-join (tlp-base-model) "tokenizer.json")
                  (tlp-join (tlp-base-model) "tokenizer_config.json"))))
    (defn tlp-adapter-ready? (dir)
        (do (let generation (nag-resolve dir))
            (tlp-all-present?
                (list (tlp-join generation "adapters.safetensors")
                      (tlp-join generation "adapter_config.json")))))
    (defn tlp-fused-ready? (dir)
        (tlp-all-present? (tlp-fused-paths dir)))
    0)
