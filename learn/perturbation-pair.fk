; perturbation-pair.fk — a probe and its twin, scored on where the answer LANDED.
; Motion is not tracking, and stillness is not tracking either.
;
; preludes: form-stdlib/core.fk
;
; WHERE THIS CAME FROM. A video arrived the evening of 2026-08-13 — Julian D.
; Michels of Sophontic, "AI Data Centers Will Be Obsolete (Geometric Reasoning
; Explained)". The transcript was pulled and read rather than summarized from a
; page description. What he actually says, and the whole of what is borrowed here:
; change two words in a question so the correct answer flips; someone who memorized
; the questions gets it wrong, someone who learned the reasoning gets it right; and
; almost no benchmark tests what happens when you flip the question.
;
; WHAT IS NOT BORROWED, credited by name. Atomic two-condition credit is older than
; this video in this body — learn/sema-mastery-readout.fk carries
;   (defn smr-mastered (train held) (if (eq train 1) (if (eq held 1) 1 0) 0))
; train AND held-out, or nothing. And problem-side perturbation with a direction
; check is here already too: form/form-stdlib/field-auto-research.fk mutates a
; source GAG->GTG and checks the motif count falls 2->1 with a reverse that
; restores it, and form/form-stdlib/tests/real-thought-ab-band.fk builds projC, a
; deliberately perturbed challenger and asks for it to be turned away — its own
; comment reads "the gate REJECTS a non-equivalent challenger". So "this body
; perturbs the witness, the teaching perturbs the problem" would be a tidy sentence
; and it is not true.
;
; THE SEAM THAT IS REAL, and it was witnessed, not argued. learn/benchbench.fk
; scores a candidate through
;   (defn bb-separates? (tag x y) (if (eq (bb-verdict tag x) (bb-verdict tag y)) 0 1))
; which is bare inequality: it can ask "did it move" and it has no argument position
; in which to ask "did it stay". Movement is rewarded unconditionally. Hand it a
; positional surface sum h(o) = 1*o0 + 2*o1 + 3*o2 + 4*o3 — a candidate with no
; concept of agreement, disagreement, or which arm is odd — and on benchbench's own
; three observations it reads 420 / 648 / 477, both separations fire, and bb-score
; answers 2: REAL, tied with the body's own four-way diagnosis. Measured on Go, Rust
; and TypeScript, 2026-08-14. A surface hash is certified because it moved.
;
; SO A PROBE COMES IN TWO KINDS, and a suite carrying only one kind is half blind:
;   FLIP  the surface changes and the correct answer changes with it
;   HOLD  the surface changes and the correct answer stays exactly where it was
; Sensitivity is itself a surface feature, so flips alone cannot catch a reader that
; simply always moves. Holds alone cannot catch one that never does. Two fixtures
; here are the two ways to fail without ever tracking anything:
;   ppair-sticker   answers the same thing always — every HOLD lands, every FLIP misses
;   ppair-inverter  answers differently always — every FLIP misses, every HOLD misses
; A criterion that pays for motion certifies the inverter. One that pays for
; stillness certifies the sticker. Only asking where the answer landed parts them.
;
; THE READING.
;   ppair-whole — 1 when BOTH halves land on their own correct value, either kind
;   ppair-tally — the per-item credit, 0..2, kept visible because it is the loophole
;   ppair-leak  — tally minus twice whole: what a per-item tally hands out that
;                 whole-pair scoring withholds. 0 when a reader tracks.
;   ppair-complete? — a suite carries at least one flip AND at least one hold, or it
;                 can only see one of the two failures. The guard, in the spirit of
;                 the corpus's hdc-field-code-safe?.
;
; Proven by learn/tests/perturbation-pair-band.fk, which perturbs this cell's own
; top level: if ppair-leak were constant, the tracker and sticker readings could not
; both stand.
; witnessed: 2026-08-14 -> band 4095 four-way (fkwu / Go / Rust / TS, all 4095), and
; perturbation-verified live: give ppair-flip-only a hold probe and every arm reads
; 3839 — bit 256 exactly, the one bit that says a flips-only suite is half blind.

(do
    ; ---- a probe pair: (canon-truth canon-said twin-truth twin-said) ----
    (defn ppair-make (ct cs pt ps) (list ct cs pt ps))
    (defn ppair-ct (p) (nth p 0))
    (defn ppair-cs (p) (nth p 1))
    (defn ppair-pt (p) (nth p 2))
    (defn ppair-ps (p) (nth p 3))

    ; the probe's KIND, read off its two truths — not a label anyone attached.
    (defn ppair-flip? (p) (if (eq (ppair-ct p) (ppair-pt p)) 0 1))
    (defn ppair-hold? (p) (if (eq (ppair-ct p) (ppair-pt p)) 1 0))

    ; did the reader's ANSWER move — the older criterion, kept as a number so the
    ; seam between moving and tracking is measured rather than asserted.
    (defn ppair-moved? (p) (if (eq (ppair-cs p) (ppair-ps p)) 0 1))

    ; atomic credit: both halves land on their own correct value, either kind, or 0.
    (defn ppair-whole (p)
        (if (eq (ppair-ct p) (ppair-cs p))
            (if (eq (ppair-pt p) (ppair-ps p)) 1 0)
            0))

    ; the loophole, named: per-item credit, blind to whether the halves belong together.
    (defn ppair-tally (p)
        (add (if (eq (ppair-ct p) (ppair-cs p)) 1 0)
             (if (eq (ppair-pt p) (ppair-ps p)) 1 0)))

    ; ---- suite folds (recursion is the loop) ----
    (defn ppair-sum-whole (ps)
        (if (eq (len ps) 0) 0 (add (ppair-whole (head ps)) (ppair-sum-whole (tail ps)))))
    (defn ppair-sum-tally (ps)
        (if (eq (len ps) 0) 0 (add (ppair-tally (head ps)) (ppair-sum-tally (tail ps)))))
    (defn ppair-all-moved? (ps)
        (if (eq (len ps) 0) 1
            (if (eq (ppair-moved? (head ps)) 1) (ppair-all-moved? (tail ps)) 0)))
    (defn ppair-none-moved? (ps)
        (if (eq (len ps) 0) 1
            (if (eq (ppair-moved? (head ps)) 0) (ppair-none-moved? (tail ps)) 0)))
    (defn ppair-has-flip? (ps)
        (if (eq (len ps) 0) 0
            (if (eq (ppair-flip? (head ps)) 1) 1 (ppair-has-flip? (tail ps)))))
    (defn ppair-has-hold? (ps)
        (if (eq (len ps) 0) 0
            (if (eq (ppair-hold? (head ps)) 1) 1 (ppair-has-hold? (tail ps)))))
    ; a suite sees both ways of failing only when it carries both kinds of probe.
    (defn ppair-complete? (ps)
        (if (eq (ppair-has-flip? ps) 1) (ppair-has-hold? ps) 0))

    ; THE NUMBER: what per-item tallying pays that whole-pair scoring withholds.
    (defn ppair-leak (ps) (sub (ppair-sum-tally ps) (mul 2 (ppair-sum-whole ps))))

    ; a diagnosis, not a tally — the 0/1/2 shape benchbench's own reading uses.
    ;   0 the reader landed every pair   1 surface credit is being paid
    ;   2 the suite is half blind and cannot say
    (defn ppair-verdict (ps)
        (if (eq (ppair-complete? ps) 0) 2
            (if (eq (ppair-leak ps) 0) 0 1)))

    ; ---- fixtures: one complete suite, three readers ----
    ; Each suite is [FLIP probe, HOLD probe]. The flip's truth moves 1 -> 0; the
    ; hold's stays at 1 while its surface changes.
    ; lands both kinds
    (defn ppair-tracker ()  (list (ppair-make 1 1 0 0) (ppair-make 1 1 1 1)))
    ; answers 1 always: the HOLD lands for the wrong reason, the FLIP is missed.
    (defn ppair-sticker ()  (list (ppair-make 1 1 0 1) (ppair-make 1 1 1 1)))
    ; answers differently always: the FLIP is missed both halves, the HOLD is broken
    ; by the very motion that would have certified it under a movement criterion.
    (defn ppair-inverter () (list (ppair-make 1 0 0 1) (ppair-make 1 1 1 0)))

    ; ---- half-blind suites, kept so ppair-complete? is measured, not asserted ----
    (defn ppair-flip-only () (list (ppair-make 1 1 0 0) (ppair-make 0 0 1 1)))
    (defn ppair-hold-only () (list (ppair-make 1 1 1 1) (ppair-make 0 0 0 0)))

    ; the instrument's own liveness: leak reads differently on two readers, or every
    ; leak number above is a constant wearing a result's clothes.
    (defn ppair-leak-moves? ()
        (if (eq (ppair-leak (ppair-sticker)) (ppair-leak (ppair-tracker))) 0 1))
    0)
