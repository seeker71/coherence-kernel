; act-token.fk — the decode step that can choose an ACT instead of a word, and
; hand the step it could not serve to the next layer without pretending otherwise.
;
; preludes: form-stdlib/core.fk learn/perturbation-pair.fk
;
; WHAT WAS ASKED, and what was actually missing. The ask: can a small local
; form-native model translate NL into Form, generate and retrieve blueprints,
; recipes and cells, run them JIT on Metal — inside the token pipeline, as an
; alternative choice to emitting a native token — and feed anything it could not
; serve back as learning? Six of those links have real tissue in this body. One
; did not exist at all, and it is the one the whole shape hangs from.
;
; Witnessed 2026-08-14 by reading cognition/native-generate.fk in full. The decode
; loop is ng-loop (:165). Every step is ng-next -> nds-best-loop, a plain argmax
; over the logits, and the only branch in the loop is (if (lt nx 0) ...), a
; GPU-refusal guard. There is nowhere a step can do anything but append a word.
; Not partial — absent. jit-decision.fk is the nearest neighbour and answers a
; different question: WHEN to crystallize a hot recipe, never whether to run one
; instead of speaking.
;
; THIS CELL IS THE MECHANISM AT ITS SMALLEST HONEST SIZE. It needs no checkpoint
; and no GPU: the logits arrive as data, so the choice can be witnessed on every
; kernel while the model that would produce those logits is still coming home.
; It is not wired to native-generate. Saying that plainly is the point — the
; mechanism standing and the mechanism running are different, and this is the
; first.
;
; THE SHAPE. A vocabulary carries words and acts in ONE index space, so the same
; argmax that picks a word can pick an act. An act runs and its result folds into
; the stream. An act the native lane cannot serve does not fabricate a result: it
; answers with the escalation sentinel, the step is marked unhealthy, and the
; count of such steps is what the learning lane is owed.
;
; THE GUARD, and it is the whole reason this can be trusted. An act lane that
; changes plain decoding is not an alternative choice, it is an intrusion. So the
; pair from learn/perturbation-pair.fk is aimed at the loop itself:
;   HOLD  a stream where no act ever wins produces EXACTLY the plain-argmax stream
;   FLIP  a stream where an act wins produces something plain argmax cannot
; Either alone is cheap. A lane that never fires holds and never flips; a lane
; that always fires flips and never holds. ppair-whole is the credit, composed.
;
; Proven by learn/tests/act-token-band.fk.
; witnessed: 2026-08-14 -> band 1023 four-way (fkwu / Go / Rust / TS)

(do
    ; ---- one index space: ids under the split are words, at or over it are acts ----
    (defn atk-split () 6)
    (defn atk-act? (id) (if (ge id (atk-split)) 1 0))
    (defn atk-word? (id) (if (ge id (atk-split)) 0 1))

    ; ---- argmax over integer logits: the choice the loop already makes ----
    (defn atk-max-loop (xs i best bi)
        (if (eq (len xs) 0) bi
            (if (gt (head xs) best)
                (atk-max-loop (tail xs) (add i 1) (head xs) i)
                (atk-max-loop (tail xs) (add i 1) best bi))))
    (defn atk-argmax (xs) (if (eq (len xs) 0) (sub 0 1) (atk-max-loop (tail xs) 1 (head xs) 0)))

    ; ---- acts, dispatched first-order by tag so this crosses every kernel ----
    ; act 6 is served natively: a recipe the body can run here and now.
    ; act 7 is not: the native lane has no way to answer it, and it says so rather
    ; than inventing a value. -1 is the escalation sentinel, never a result.
    (defn atk-escalate () (sub 0 1))
    (defn atk-run (id)
        (if (eq id 6) 42
        (if (eq id 7) (atk-escalate) (atk-escalate))))

    ; ---- one step: a word is emitted, an act is RUN and its result folds in ----
    (defn atk-step (logits)
        (do (let id (atk-argmax logits))
            (if (eq (atk-act? id) 1) (atk-run id) id)))
    ; the control: what the loop does today, every step, without exception
    (defn atk-plain-step (logits) (atk-argmax logits))

    ; ---- a step is healthy when it did not need the layer outside the membrane ----
    (defn atk-healthy? (logits)
        (if (eq (atk-step logits) (atk-escalate)) 0 1))

    ; ---- the stream ----
    (defn atk-stream (ls) (if (eq (len ls) 0) (empty) (cons (atk-step (head ls)) (atk-stream (tail ls)))))
    (defn atk-plain-stream (ls) (if (eq (len ls) 0) (empty) (cons (atk-plain-step (head ls)) (atk-plain-stream (tail ls)))))
    (defn atk-same? (a b)
        (if (eq (len a) 0) (if (eq (len b) 0) 1 0)
            (if (eq (len b) 0) 0
                (if (eq (head a) (head b)) (atk-same? (tail a) (tail b)) 0))))

    ; ---- what the learning lane is owed: the steps that crossed out ----
    (defn atk-escalated (ls)
        (if (eq (len ls) 0) 0
            (add (if (eq (atk-healthy? (head ls)) 1) 0 1) (atk-escalated (tail ls)))))

    ; ---- fixtures: logit vectors over an 8-wide space, 6 words and 2 acts ----
    ; a word wins (index 2)
    (defn atk-lw () (list 1 3 9 2 0 1 0 0))
    ; the servable act wins (index 6)
    (defn atk-la () (list 1 3 2 2 0 1 9 0))
    ; the unservable act wins (index 7)
    (defn atk-lu () (list 1 3 2 2 0 1 0 9))
    (defn atk-words-only () (list (atk-lw) (atk-lw)))
    (defn atk-with-act ()  (list (atk-lw) (atk-la)))
    (defn atk-with-unserved () (list (atk-lw) (atk-lu)))

    ; ---- the pair, aimed at the loop: it holds on words and moves on acts ----
    (defn atk-holds () (atk-same? (atk-stream (atk-words-only)) (atk-plain-stream (atk-words-only))))
    (defn atk-moves ()
        (if (eq (atk-same? (atk-stream (atk-with-act)) (atk-plain-stream (atk-with-act))) 1) 0 1))
    (defn atk-obs () (ppair-make 1 (atk-holds) 1 (atk-moves)))
    (defn atk-whole () (ppair-whole (atk-obs)))
    0)
