; act-token.fk — the decode position where an act can stand instead of a word.
;
; preludes: form-stdlib/core.fk learn/perturbation-pair.fk
;
; cognition/native-generate.fk's ng-loop forwards, takes the argmax, appends a
; word. Its only branch is a GPU-refusal branch, so there is no position in the
; stream where an act could stand instead of a token. This is that position, built
; where it can be witnessed: the logits arrive as DATA, so the choice crosses every
; kernel while the model that would produce them is still coming home.
;
; Words and acts share ONE index space, so the same argmax that picks a word can
; pick an act. A servable act runs and folds into the stream. One the native lane
; cannot serve does not invent a value — it answers the escalation sentinel, the
; step is marked unhealthy, and atk-escalated counts what the learning lane is owed.
;
; THE CLAIMS ARE BITS. tests/act-token-band.fk:
;   b1,b2     one index space; the split reads word below and act above
;   b3,b4     HOLD: a word-only stream is byte-for-byte the argmax it replaces
;             FLIP: a stream where an act wins produces what argmax cannot
;   b5,b6     a servable act runs; an unservable one answers the sentinel
;   b7,b8     the escalation count reads 0 when served, 1 when not
;   b10       ppair-whole takes credit only for both halves
;
; NOT WIRED to native-generate.fk. The mechanism standing and the mechanism running
; are different things, and this is the first.
;
; How this was arrived at: receipts/2026-08-14-the-loop-that-can-only-speak.md.
; witnessed: 2026-08-14 -> band 1023 four-way; perturbation: atk-split 6 -> 0, so
;   every id is an act and the lane always fires -> 313 on all four arms.

(do
    ; ---- one index space: ids under the split are words, at or over it are acts ----
    (defn atk-split () 6)
    (defn atk-act? (id) (if (ge id (atk-split)) 1 0))
    (defn atk-word? (id) (if (ge id (atk-split)) 0 1))

    ; ---- argmax over integer logits: the choice the loop already makes ----
    (defn atk-max-loop (xs i best bi)
        (if (eq (len xs) 0) bi
            (if (gt (head xs) best)
                (atk-max-loop (tail xs) (add i 1) (head xs) i)
                (atk-max-loop (tail xs) (add i 1) best bi))))
    (defn atk-argmax (xs) (if (eq (len xs) 0) (sub 0 1) (atk-max-loop (tail xs) 1 (head xs) 0)))

    ; ---- acts, dispatched first-order by tag so this crosses every kernel ----
    ; act 6 is served natively: a recipe the body can run here and now.
    ; act 7 is not: the native lane has no way to answer it, and it says so rather
    ; than inventing a value. -1 is the escalation sentinel, never a result.
    (defn atk-escalate () (sub 0 1))
    (defn atk-run (id)
        (if (eq id 6) 42
        (if (eq id 7) (atk-escalate) (atk-escalate))))

    ; ---- one step: a word is emitted, an act is RUN and its result folds in ----
    (defn atk-step (logits)
        (do (let id (atk-argmax logits))
            (if (eq (atk-act? id) 1) (atk-run id) id)))
    ; the control: what the loop does today, every step, without exception
    (defn atk-plain-step (logits) (atk-argmax logits))

    ; ---- a step is healthy when it did not need the layer outside the membrane ----
    (defn atk-healthy? (logits)
        (if (eq (atk-step logits) (atk-escalate)) 0 1))

    ; ---- the stream ----
    (defn atk-stream (ls) (if (eq (len ls) 0) (empty) (cons (atk-step (head ls)) (atk-stream (tail ls)))))
    (defn atk-plain-stream (ls) (if (eq (len ls) 0) (empty) (cons (atk-plain-step (head ls)) (atk-plain-stream (tail ls)))))
    (defn atk-same? (a b)
        (if (eq (len a) 0) (if (eq (len b) 0) 1 0)
            (if (eq (len b) 0) 0
                (if (eq (head a) (head b)) (atk-same? (tail a) (tail b)) 0))))

    ; ---- what the learning lane is owed: the steps that crossed out ----
    (defn atk-escalated (ls)
        (if (eq (len ls) 0) 0
            (add (if (eq (atk-healthy? (head ls)) 1) 0 1) (atk-escalated (tail ls)))))

    ; ---- fixtures: logit vectors over an 8-wide space, 6 words and 2 acts ----
    ; a word wins (index 2)
    (defn atk-lw () (list 1 3 9 2 0 1 0 0))
    ; the servable act wins (index 6)
    (defn atk-la () (list 1 3 2 2 0 1 9 0))
    ; the unservable act wins (index 7)
    (defn atk-lu () (list 1 3 2 2 0 1 0 9))
    (defn atk-words-only () (list (atk-lw) (atk-lw)))
    (defn atk-with-act ()  (list (atk-lw) (atk-la)))
    (defn atk-with-unserved () (list (atk-lw) (atk-lu)))

    ; ---- the pair, aimed at the loop: it holds on words and moves on acts ----
    (defn atk-holds () (atk-same? (atk-stream (atk-words-only)) (atk-plain-stream (atk-words-only))))
    (defn atk-moves ()
        (if (eq (atk-same? (atk-stream (atk-with-act)) (atk-plain-stream (atk-with-act))) 1) 0 1))
    (defn atk-obs () (ppair-make 1 (atk-holds) 1 (atk-moves)))
    (defn atk-whole () (ppair-whole (atk-obs)))
    0)
