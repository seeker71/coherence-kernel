; gender-three-lanes.fk — three things are called "gender", they are not one thing,
; and each belongs in a different place in this body.
;
; Urs: "what does Sanskrit and Rudolf Steiner say about the gender archetypes and
; how can we integrate gender into the core since in this earth experience gender
; is playing a core role."
;
; The last clause is taken as given, not argued with. Gender IS load-bearing in
; earth experience. The question this cell answers is WHERE it goes, and the answer
; is not one place, because the word carries three different kinds of claim.
;
; ── WHY NOT THE CORE 64 ──────────────────────────────────────────────────────
; core-lexicon.fk's person family is `you me we us they it self` — no he, no she.
; That looked like a stance when I first read it. It is not; it is forced.
;
; nl-pivot-es.fk states the invariant: "la fuente es nativa", "the source is
; native", "sumber adalah asli", "die quelle ist nativ" intern to the SAME pivot
; node, "witnessed by node identity, never by claim" — and gender lives "in the
; column, never in the pivot".
;
; INDONESIAN IS ONE OF THOSE FOUR TONGUES. Indonesian's third person is `dia`,
; which carries no gender. If he/she were primitives of the ground, the Indonesian
; column could not project the ground — it would have to guess or drop. The pivot
; would stop being a pivot and become a European one. So the emptiness where
; he/she would sit is what makes a fourth tongue possible, and a fifth.
;
; That is an argument from THIS body's own working code, not from a principle.
;
; ── THE THREE LANES ─────────────────────────────────────────────────────────
; Named after energy-center-glands.bml's discipline — belief and evidence held
; strictly apart, never merged — because the same temptation lives here: an
; archetype and a chromosome and a noun-class are three claims of three different
; kinds, and collapsing them is how each one gets used to argue for the others.
;
;   LINGA     grammatical noun class. A surface fact of one tongue. Sanskrit has
;             three (pum / stri / napumsaka). This lane is EVIDENCE — it is
;             checkable in a grammar, and it is checkably NOT about sex, which is
;             the whole reason it belongs here rather than beside the archetypes.
;
;   SEX       biological. Measurable. EVIDENCE lane, the same lane
;             energy-center-glands.bml puts molecular biology in.
;
;   POLARITY  archetypal. Samkhya's purusa (witness, still) and prakriti (nature,
;             generative); Saiva's Siva and Sakti; ardhanarisvara, the form that is
;             half woman, in which the two are one body. Steiner's masculine and
;             feminine sit here too. This lane is BELIEF — attested, held, never
;             asserted as cosmology.
;
; THE LANE LAW, borrowed unchanged from ecgb-lane-law-loop: belief strictly below
; evidence, for every row. A held correspondence must never outrank a measurement.
;
; ── WHAT THIS BODY ALREADY HOLDS, AND WHAT IT DOES NOT ──────────────────────
; cognition/steiner-neutral-kernel.fk holds Steiner as a surface-independent
; meaning graph — [subject, relation, object, evidence, order], with German AND
; English as registered projections precisely so that no English string can pose
; as the teaching. It contains a POLARITY, nine mentions of it, and that polarity
; is Lucifer / Ahriman with Christ mediating — "die zwei Gegenmaechte". It is not
; a gender polarity. So: on the question asked, the body's Steiner graph is SILENT,
; and this cell records that silence rather than filling it.
;
; learn/sanskrit-locale-baseline.fk and form-stdlib/sanskrit-channel.fk contain no
; linga at all. The Sanskrit that is here is roots and locale, not noun class.
;
; So both halves of the question reach real cells, and both cells are empty of it.
; That emptiness is the finding, and it is why this cell holds STRUCTURE plus a
; small number of claims each marked with its lane, rather than a confident table.
;
; ── THE CLAIMS, AND WHO IS ANSWERABLE FOR THEM ──────────────────────────────
; Every row below carries a source marker. `rented` means a rented mind supplied
; it and no cell in this body has witnessed it — it is admissible as a claim to be
; checked, never as ground. When a Sanskrit grammar lands in this tree, the linga
; rows become checkable and their marker changes. Until then the marker is the
; honest part of the row.
;
; preludes: form-stdlib/core.fk

(do
    ; ── lane codes. The ORDER is the law: belief must sort strictly below
    ; evidence, so the comparison is on these numbers, never on a name. ──
    (defn g3-lane-belief () 1)
    (defn g3-lane-evidence () 2)

    ; ── the three kinds, and what each one is a claim ABOUT ──
    ; (kind, lane, where-it-belongs)
    (defn g3-kind (name lane place) (list name lane place))
    (defn g3-kind-name (k) (nth k 0))
    (defn g3-kind-lane (k) (nth k 1))
    (defn g3-kind-place (k) (nth k 2))

    (defn g3-kinds ()
        (list (g3-kind "linga"    (g3-lane-evidence) "the emitter column, per tongue")
              (g3-kind "sex"      (g3-lane-evidence) "the measured lane, with the biology")
              (g3-kind "polarity" (g3-lane-belief)   "the meaning graph, held as belief")))

    (defn g3-kind-count () 3)

    ; ── Sanskrit's three noun classes. Named in transliteration, without
    ; diacritics, because this cell is ASCII and a wrong diacritic is a wrong
    ; claim. Each is a class of NOUNS, not a class of beings. ──
    (defn g3-linga () (list "pumlinga" "strilinga" "napumsakalinga"))
    (defn g3-linga-count () 3)

    ; ── THE FALSIFIER FOR LANE ONE, and it is the reason linga is evidence and
    ; not archetype: there exist nouns whose class does not follow the sex of what
    ; they name. If noun class tracked sex, this list would be empty. Each row is
    ; (word, gloss, class), marked `rented` — supplied by a rented mind, unchecked
    ; by any cell here. ──
    (defn g3-mismatch (word gloss klass) (list word gloss klass))
    (defn g3-mismatches ()
        (list (g3-mismatch "dara"    "wife"   "pumlinga")
              (g3-mismatch "kalatra" "wife"   "napumsakalinga")
              (g3-mismatch "mitra"   "friend" "napumsakalinga")))
    (defn g3-mismatch-source () "rented")

    ; ── the archetypal pairs, belief lane, each with the tradition that holds it.
    ; purusa is the still witness and prakriti is all activity INCLUDING mind —
    ; which is why this pair is not "men and women" even in the tradition that
    ; carries it. ardhanarisvara is listed as the pair's own resolution: one body,
    ; half woman, in which neither pole is the whole. ──
    (defn g3-pair (a b tradition) (list a b tradition))
    (defn g3-pairs ()
        (list (g3-pair "purusa" "prakriti" "samkhya")
              (g3-pair "siva"   "sakti"    "saiva")))
    (defn g3-union () "ardhanarisvara")
    (defn g3-pair-count () 2)

    ; ── what the body's own Steiner graph says on this question: nothing. Its
    ; polarity is Lucifer / Ahriman mediated by Christ, which is not gendered.
    ; Recorded as a fact ABOUT the cell, so a later reader does not go looking. ──
    (defn g3-steiner-graph-has-gender-polarity? () 0)
    (defn g3-steiner-graph-polarity () "lucifer-ahriman")
    (defn g3-sanskrit-cells-have-linga? () 0)

    ; ── THE PIVOT INVARIANT. he and she are absent from the core 64 and must stay
    ; absent; they and it are present and must stay present. This is checkable
    ; against core-lexicon.fk by any band that loads both. ──
    (defn g3-core-must-lack () (list "he" "she"))
    (defn g3-core-must-hold () (list "they" "it"))

    ; ── THE LANE LAW. First written as a walk over the kinds asking whether each
    ; one's lane was belief-or-better, which mutation testing showed to be a
    ; validity check wearing a law's name: moving polarity INTO the evidence lane —
    ; the exact merge the law exists to forbid — left it green. A per-row test
    ; cannot state this law, because each kind carries ONE lane and a law about
    ; ordering needs two things to order.
    ;
    ; So the law is stated where it lives: BELIEF RANKS STRICTLY BELOW EVIDENCE,
    ; and every kind sits on one of exactly those two. Then "strictly below" is a
    ; fact about the lanes that a row cannot quietly redefine, and ecgb-lane-law-loop's
    ; per-center comparison has something true to lean on.
    (defn g3-lane-order? () (if (lt (g3-lane-belief) (g3-lane-evidence)) 1 0))
    (defn g3-lane-valid-loop (ks)
        (if (eq (len ks) 0) 1
            (if (eq (g3-kind-lane (head ks)) (g3-lane-belief)) (g3-lane-valid-loop (tail ks))
                (if (eq (g3-kind-lane (head ks)) (g3-lane-evidence)) (g3-lane-valid-loop (tail ks)) 0))))
    (defn g3-lane-law? ()
        (if (eq (g3-lane-order?) 1) (g3-lane-valid-loop (g3-kinds)) 0))

    ; ── every kind is placed somewhere, and no kind is placed in the core ──
    (defn g3-placed-loop (ks)
        (if (eq (len ks) 0) 1
            (if (gt (str_len (g3-kind-place (head ks))) 0)
                (g3-placed-loop (tail ks)) 0)))
    (defn g3-all-placed? () (g3-placed-loop (g3-kinds)))

    ; ── honest absence: a kind this cell does not carry answers nothing ──
    (defn g3-find-loop (ks name)
        (if (eq (len ks) 0) (nothing)
            (if (str_eq (g3-kind-name (head ks)) name) (head ks)
                (g3-find-loop (tail ks) name))))
    (defn g3-find (name) (g3-find-loop (g3-kinds) name))
    (defn g3-known? (k) (if (nothing? k) 0 1))
    0)
