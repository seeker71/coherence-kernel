; The corpus door resumes the 16-layer authoring lineage on native Metal.
; Nine epochs, batch two and rate 2e-5 retain the witnessed training recipe.
; Prompt masking supervises the answer. Iterations derive from actual JSONL rows,
; including a final row without a newline. Worker failures retain their exit code.
; preludes: learn/train-loop-local-paths.fk form-stdlib/native-lora-worker.bml
(do
 (defn ctd-data-dir () "/Users/ursmuff/.coherence-network/form-corpus-lora-data")
 (defn ctd-model () (tlp-base-model))
 (defn ctd-epochs () 9)
 (defn ctd-batch () 2)
 (defn ctd-lr () 0.00002)
 (defn ctd-layers () 16)
 (defn ctd-rows-at (dir)
  (do (let text (read_file (str_concat dir "/train.jsonl")))
   (if (nothing? text) (nothing) (len (nld-lines text)))))
 (defn ctd-rows () (ctd-rows-at (ctd-data-dir)))
 (defn ctd-iters-for (rows) (div (add (mul (ctd-epochs) rows) (sub (ctd-batch) 1)) (ctd-batch)))
 (defn ctd-iters () (do (let rows (ctd-rows)) (if (nothing? rows) (nothing) (ctd-iters-for rows))))
 (defn ctd-request-at (data resume-adapter out-dir)
  (do (let rows (ctd-rows-at data))
   (if (or (nothing? rows) (le rows 0)) (nothing)
    (ntr-request (ctd-model) (nag-dir resume-adapter) data out-dir (ctd-iters-for rows) (ctd-batch) (ctd-lr) 1 (ctd-layers)))))
 (defn ctd-request (resume-adapter out-dir) (ctd-request-at (ctd-data-dir) resume-adapter out-dir))
 (defn ctd-run (resume-adapter out-dir)
  (do (let request (ctd-request resume-adapter out-dir))
   (if (nothing? request) (nothing) (nlw-run request (str_concat out-dir "/worker")))))
 0)
