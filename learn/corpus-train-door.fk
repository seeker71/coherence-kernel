; corpus-train-door.fk — the one training command, decisions baked, no flags.
;
; WHY NO OPTIONS. Urs, 2026-08-26: "why arguments for options that are always
; true? we always want to support all features we have access to, we know at
; compile time what the host supports, no runtime flags needed." Today's 9/12
; result was produced by a hand-typed command whose flags were decisions —
; --mask-prompt, --num-layers 16, --iters 2000 — each re-derivable, each
; forgettable, each a way for the next run to be silently worse. A flag is a
; decision deferred to whoever types next. These are decided HERE, once, with
; the reason beside the value:
;
;   prompt-masked   ALWAYS. The corpus is one-word answers; loss on the
;                   question teaches nothing and dilutes the answer signal.
;                   Witnessed: unmasked 0.55-epoch run learned format only.
;   layers 16       the adapter lineage (12..27 of 28) — resuming across a
;                   different layer set silently drops weights.
;   epochs 9        the measured knee: 0.55 epochs -> 0/12 facts, 9 -> 9/12.
;   lr 2e-5         the witnessed vocabulary-acquisition rate.
;   batch 2         fits every Apple-silicon host we run (3 GB peak).
;
; ITERS IS DERIVED, NEVER PASSED. iters = ceil(epochs * rows / batch), from
; the corpus file the door reads itself. A corpus that grows retrains fully
; with nobody updating a number.
;
; The door RESUMES from the newest adapter so learning accumulates, and dates
; its output. Nothing here is configurable because nothing here is open.
;
; preludes: form-stdlib/core.fk
; Proven by: form-stdlib/tests/corpus-train-door-band.fk

(do
    (defn ctd-data-dir () "/Users/ursmuff/.coherence-network/form-corpus-lora-data")
    (defn ctd-model () "mlx-community/Llama-3.2-3B-Instruct-4bit")
    (defn ctd-epochs () 9)
    (defn ctd-batch () 2)
    (defn ctd-lr () "2e-5")
    (defn ctd-layers () 16)

    ; rows = newline count of the train file, read by the door itself
    (defn ctd-count-nl (s i n acc)
        (if (ge i n) acc
            (ctd-count-nl s (add i 1) n (add acc (if (eq (str_byte_at s i) 10) 1 0)))))
    (defn ctd-rows-at (dir)
        (do (let p (str_concat dir "/train.jsonl"))
            (if (lt (file_size p) 0) (nothing)
                (do (let s (read_file p)) (ctd-count-nl s 0 (str_len s) 0)))))
    (defn ctd-rows () (ctd-rows-at (ctd-data-dir)))

    ; ceil(epochs*rows/batch), derived — a grown corpus retrains itself fully
    (defn ctd-iters ()
        (do (let r (ctd-rows))
            (if (nothing? r) (nothing)
                (div (add (mul (ctd-epochs) r) (sub (ctd-batch) 1)) (ctd-batch)))))

    ; the command, as one line anyone or any cell can hand to the host
    (defn ctd-command (resume-adapter out-dir)
        (do (let it (ctd-iters))
            (if (nothing? it) (nothing)
                (str_concat "uv run --with mlx-lm --python 3.12 python -m mlx_lm lora --train --mask-prompt"
                (str_concat " --model " (str_concat (ctd-model)
                (str_concat " --data " (str_concat (ctd-data-dir)
                (str_concat " --resume-adapter-file " (str_concat resume-adapter
                (str_concat " --adapter-path " (str_concat out-dir
                (str_concat " --num-layers " (str_concat (int_to_str (ctd-layers))
                (str_concat " --batch-size " (str_concat (int_to_str (ctd-batch))
                (str_concat " --learning-rate " (str_concat (ctd-lr)
                (str_concat " --iters " (int_to_str it))))))))))))))))))))
    0)
