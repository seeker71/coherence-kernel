; deadgreen.fk — a check whose green cannot turn red, and how to tell.
;
; preludes: form-stdlib/core.fk learn/benchbench.fk form-stdlib/world-model-update.fk learn/world-model-pair.fk
;
; WHAT IT READS. A check is ALIVE when some observation in its domain makes it
; answer differently, and DEAD when none does — benchbench's criterion aimed one
; notch lower, at a single bit rather than a whole instrument. Checks travel as
; first-order TAGS so this crosses to any kernel with integers and lists.
;
; THE CLAIMS ARE BITS, NOT SENTENCES. This header used to argue for each of them
; in a paragraph; the band already proves five, and a bit can fall where a
; paragraph cannot. Read tests/deadgreen-band.fk instead of trusting this:
;   b1,b2  a len over a literal never moves; a per-entity length does
;   b4     dg-tag-shared is dead on its own
;   b8     and becomes a reading only beside a neighbour that can move
;   b16    the body already scores this shape 0 (bb-tag-constant-green)
;   b32    and is not merely answering 0 to everything
;   b128   the walk discriminates at all
;
; TWO THINGS NO BIT HOLDS, so they are stated and dated rather than implied.
; grammars/holographic.fk's holo-boundary-size is (len ...) over a four-element
; literal — witnessed 2026-08-14 on fkwu, it reads 4 for an EMPTY bulk, so
; holographic-band's bit 10 cannot fall for any input. And the same shape was mine
; hours earlier: wmp-state was a nullary over a three-element literal under a band
; bit asserting its length. world-model-pair.fk now builds that state from a world.
;
; How this was arrived at: receipts/2026-08-14-a-green-that-cannot-turn-red.md.
; witnessed: 2026-08-14 -> band 255 four-way (fkwu / Go / Rust / TS)

(do
    ; ---- observations: worlds of different size ----
    (defn dg-obs () (list 0 2 40))

    ; ---- checks as tags, answered against one observation ----
    ;   1 the literal-length shape: holo-boundary-size / the first wmp-state
    ;   2 a per-entity state length: grows with the world
    ;   3 a shared state length: constant, and honest only beside tag 2
    (defn dg-check (tag n)
        (if (eq tag 1) (len (list 1 2 3 4))
        (if (eq tag 2) (len (wmp-state-per-entity (wmp-world n)))
        (if (eq tag 3) (len (wmp-state-shared (wmp-world n))) 0))))

    ; ---- alive?: does any observation move the answer ----
    (defn dg-first (tag) (dg-check tag (head (dg-obs))))
    (defn dg-moves-loop (tag os base)
        (if (eq (len os) 0) 0
            (if (eq (dg-check tag (head os)) base)
                (dg-moves-loop tag (tail os) base) 1)))
    (defn dg-alive? (tag) (dg-moves-loop tag (dg-obs) (dg-first tag)))

    ; ---- the pair reading: a dead check earns credit only beside a live one ----
    (defn dg-pair-parts? (a b)
        (if (eq (dg-check a 2) (dg-check b 2))
            (if (eq (dg-check a 40) (dg-check b 40)) 0 1)
            1))

    ; ---- the sweep is not degenerate: the observations really differ ----
    (defn dg-obs-differ? ()
        (if (eq (head (dg-obs)) (head (tail (dg-obs)))) 0 1))
    0)
