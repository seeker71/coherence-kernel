; deadgreen.fk — a check whose green can never turn red, and how to tell.
;
; preludes: form-stdlib/core.fk learn/benchbench.fk form-stdlib/world-model-update.fk learn/world-model-pair.fk
;
; WHERE THIS CAME FROM, and it came from being wrong. A cell landed this morning
; claiming four words — harmonic, geometric, holographic, fractal — were one
; invariant. Three readers were sent at it, and re-probing what they found broke
; the claim: ratio-cell holds only on the reducible ray (881:440 stays 881:440),
; and benchbench's fixed point is probe-dependent (bbbb-score-of on another
; varying triple reads 1, not 2). That cell is deleted. What survived is smaller
; and worse, and it is this.
;
; grammars/holographic.fk carries
;   (defn holo-boundary (bulk) (list (node_pkg bulk) (node_level bulk)
;                                    (node_type bulk) (node_inst bulk)))
;   (defn holo-boundary-size (bulk) (len (holo-boundary bulk)))   ; always 4
; and tests/holographic-band.fk asks (eq (holo-boundary-size small) 4) for bit 10.
; That length is 4 BY SYNTAX — a len over a four-element list literal. Witnessed
; 2026-08-14 on fkwu: it reads 4 for an EMPTY bulk. No input can make bit 10 fall.
; (Read further and the same probe shows the boundary VALUES growing with volume —
; [0,2,99,2], [0,2,99,6], [0,2,99,16] — so node_inst is an allocation index into a
; table that holds the content. That is a separate finding and it belongs to that
; cell's own keepers; this one is only about the unfallable bit.)
;
; THE BODY ALREADY RATES THIS SHAPE. learn/benchbench.fk names it outright —
; bb-tag-constant-green, "the other fake: returns pass, always" — and bb-score
; gives it 0. So the instrument for this was already here, four-way proven, and a
; band in the tree was standing green on a bit that instrument calls fake.
;
; AND THEN IT WAS MINE. Hours before writing any of this I wrote
;   (defn wmp-state () (list (wmp-base) (wmp-rate) 5.0))
; and a band bit (eq (len (wmp-state)) 3), under a receipt sentence that read "the
; claim is checkable, which is the only reason it is made." It was not checkable.
; Same shape, same morning, my own hand, in a band whose subject is checks that
; cannot move. world-model-pair.fk now builds the state FROM a world and pairs it
; against a per-entity state that grows, so the bit can fall.
;
; THE READING. A check is ALIVE when some observation in its domain makes it
; answer differently, and DEAD when none does. That is the whole of it, and it is
; benchbench's criterion aimed one notch lower — at a single bit rather than at a
; whole instrument. Checks are carried as first-order TAGS, not function values,
; the same discipline benchbench keeps so this crosses to any kernel with integers
; and lists.
;
; The trap kept as a fixture: dg-tag-shared is DEAD on its own — a shared floor's
; state length is 3 whatever world arrives — and it becomes a real reading only
; when the per-entity alternative is computed beside it and differs. A constant is
; not made honest by being true. It is made honest by having a live neighbour.
;
; Proven by learn/tests/deadgreen-band.fk, which perturbs its own top level: make
; the living check ignore its observation and it goes dead, and the two readings
; have to part.
; witnessed: 2026-08-14 -> band 255 four-way (fkwu / Go / Rust / TS)

(do
    ; ---- observations: worlds of different size ----
    (defn dg-obs () (list 0 2 40))

    ; ---- checks as tags, answered against one observation ----
    ;   1 the literal-length shape: holo-boundary-size / the first wmp-state
    ;   2 a per-entity state length: grows with the world
    ;   3 a shared state length: constant, and honest only beside tag 2
    (defn dg-check (tag n)
        (if (eq tag 1) (len (list 1 2 3 4))
        (if (eq tag 2) (len (wmp-state-per-entity (wmp-world n)))
        (if (eq tag 3) (len (wmp-state-shared (wmp-world n))) 0))))

    ; ---- alive?: does any observation move the answer ----
    (defn dg-first (tag) (dg-check tag (head (dg-obs))))
    (defn dg-moves-loop (tag os base)
        (if (eq (len os) 0) 0
            (if (eq (dg-check tag (head os)) base)
                (dg-moves-loop tag (tail os) base) 1)))
    (defn dg-alive? (tag) (dg-moves-loop tag (dg-obs) (dg-first tag)))

    ; ---- the pair reading: a dead check earns credit only beside a live one ----
    (defn dg-pair-parts? (a b)
        (if (eq (dg-check a 2) (dg-check b 2))
            (if (eq (dg-check a 40) (dg-check b 40)) 0 1)
            1))

    ; ---- the sweep is not degenerate: the observations really differ ----
    (defn dg-obs-differ? ()
        (if (eq (head (dg-obs)) (head (tail (dg-obs)))) 0 1))
    0)
