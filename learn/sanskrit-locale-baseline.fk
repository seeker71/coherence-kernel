// sanskrit-locale-baseline.fk -- small consentful seed for locale-neutral NL training.
//
// The source lines are romanized Sanskrit seed phrases with simple locale
// renderings. They are baseline alignment rows, not authority over sacred text.
// The body can use them now because the strings live here as attributed local
// data; broader public corpora can be added as consent/licensing rows later.
//
// Chinese and Arabic are ready in this small baseline. The broader Coherence
// Network self-corpus can still name them as bundle backfill targets.
section [form.bml] {
    def slb-locale(code, family, script, ready, consent, backfill) = ["sanskrit-baseline-locale", code, family, script, ready, consent, backfill];
    def slb-loc-kind(l) = l[0];
    def slb-loc-code(l) = l[1];
    def slb-loc-family(l) = l[2];
    def slb-loc-script(l) = l[3];
    def slb-loc-ready(l) = l[4];
    def slb-loc-consent(l) = l[5];
    def slb-loc-backfill(l) = l[6];
    def slb-locales() = [slb-locale("sa", "indo-european-vedic", "latin-romanized", 1, 1, 0), slb-locale("en", "indo-european-germanic", "latin", 1, 1, 0), slb-locale("de", "indo-european-germanic", "latin", 1, 1, 0), slb-locale("es", "indo-european-romance", "latin", 1, 1, 0), slb-locale("fr", "indo-european-romance", "latin", 1, 1, 0), slb-locale("it", "indo-european-romance", "latin", 1, 1, 0), slb-locale("id", "austronesian", "latin", 1, 1, 0), slb-locale("pt-br", "indo-european-romance", "latin", 1, 1, 0), slb-locale("la", "indo-european-classical", "latin", 1, 1, 0), slb-locale("zh", "sino-tibetan", "han", 1, 1, 0), slb-locale("ar", "afro-asiatic-semitic", "arabic", 1, 1, 0), slb-locale("nv", "dene", "latin", 0, 0, 0)];
    def slb-find-locale(rows, code) = (Comparable) len(rows) == 0 ? slb-locale("", "", "", 0, 0, 0) : (String) slb-loc-code(rows[0]) == code ? rows[0] : slb-find-locale(rows[1:], code);
    def slb-locale-for(code) = slb-find-locale(slb-locales(), code);
    def slb-locale-ready?(code) = {
        let row = slb-locale-for(code);
        (Comparable) slb-loc-ready(row) == 1 && (Comparable) slb-loc-consent(row) == 1 ? 1 : 0;
    };
    def slb-locale-backfill?(code) = {
        let row = slb-locale-for(code);
        (Comparable) slb-loc-backfill(row) == 1 && (Comparable) slb-loc-consent(row) == 1 ? 1 : 0;
    };
    def slb-ready-locale-count-loop(rows) = (Comparable) len(rows) == 0 ? 0 : (Number) ((Comparable) slb-loc-ready(rows[0]) == 1 && (Comparable) slb-loc-consent(rows[0]) == 1 ? 1 : 0) + (Number) slb-ready-locale-count-loop(rows[1:]);
    def slb-ready-locale-count() = slb-ready-locale-count-loop(slb-locales());
    def slb-line(meaning, key, form, sa, en, de, es, fr, it, ind, ptbr, la, zh, ar) = ["sanskrit-locale-baseline", meaning, key, form, sa, en, de, es, fr, it, ind, ptbr, la, zh, ar];
    def slb-kind(r) = r[0];
    def slb-meaning(r) = r[1];
    def slb-key(r) = r[2];
    def slb-form(r) = r[3];
    def slb-sa(r) = r[4];
    def slb-en(r) = r[5];
    def slb-de(r) = r[6];
    def slb-es(r) = r[7];
    def slb-fr(r) = r[8];
    def slb-it(r) = r[9];
    def slb-id(r) = r[10];
    def slb-ptbr(r) = r[11];
    def slb-la(r) = r[12];
    def slb-zh(r) = r[13];
    def slb-ar(r) = r[14];
    def slb-lines() = [slb-line(301, "sarve-bhavantu-sukhinah", ["wish", "all", "wellbeing"], ["sarve", "bhavantu", "sukhinah"], ["may", "all", "be", "happy"], ["moegen", "alle", "gluecklich", "sein"], ["que", "todos", "sean", "felices"], ["que", "tous", "soient", "heureux"], ["possano", "tutti", "essere", "felici"], ["semoga", "semua", "bahagia"], ["que", "todos", "sejam", "felizes"], ["omnes", "beati", "sint"], ["愿", "一切", "众生", "快乐"], ["ليكن", "الجميع", "سعداء"]), slb-line(302, "satyam-eva-jayate", ["truth", "alone", "wins"], ["satyam", "eva", "jayate"], ["truth", "alone", "triumphs"], ["die", "wahrheit", "allein", "siegt"], ["solo", "la", "verdad", "triunfa"], ["seule", "la", "verite", "triomphe"], ["solo", "la", "verita", "trionfa"], ["kebenaran", "saja", "menang"], ["so", "a", "verdade", "vence"], ["veritas", "sola", "vincit"], ["真理", "终将", "胜利"], ["الحقيقة", "وحدها", "تنتصر"]), slb-line(303, "aham-asmi", ["self", "present"], ["aham", "asmi"], ["i", "am"], ["ich", "bin"], ["yo", "soy"], ["je", "suis"], ["io", "sono"], ["aku", "ada"], ["eu", "sou"], ["ego", "sum"], ["我", "在"], ["أنا", "موجود"]), slb-line(304, "lokah-samastah-sukhino-bhavantu", ["wish", "worlds", "wellbeing"], ["lokah", "samastah", "sukhino", "bhavantu"], ["peace", "for", "every", "world"], ["frieden", "fuer", "jede", "welt"], ["paz", "para", "cada", "mundo"], ["paix", "pour", "chaque", "monde"], ["pace", "per", "ogni", "mondo"], ["damai", "untuk", "setiap", "dunia"], ["paz", "para", "cada", "mundo"], ["pax", "omni", "mundo"], ["愿", "所有", "世界", "安宁"], ["سلام", "لكل", "العوالم"])];
    def slb-empty-line() = slb-line(0, "", empty(), empty(), empty(), empty(), empty(), empty(), empty(), empty(), empty(), empty(), empty(), empty());
    def slb-find-line(rows, meaning) = (Comparable) len(rows) == 0 ? slb-empty-line() : (Comparable) slb-meaning(rows[0]) == meaning ? rows[0] : slb-find-line(rows[1:], meaning);
    def slb-line-by-meaning(meaning) = slb-find-line(slb-lines(), meaning);
    def slb-tokens(row, locale) = (String) locale == "sa" ? slb-sa(row) : (String) locale == "en" ? slb-en(row) : (String) locale == "de" ? slb-de(row) : (String) locale == "es" ? slb-es(row) : (String) locale == "fr" ? slb-fr(row) : (String) locale == "it" ? slb-it(row) : (String) locale == "id" ? slb-id(row) : (String) locale == "pt-br" ? slb-ptbr(row) : (String) locale == "la" ? slb-la(row) : (String) locale == "zh" ? slb-zh(row) : (String) locale == "ar" ? slb-ar(row) : empty();
    def slb-line-ready?(row, locale) = (Comparable) slb-locale-ready?(locale) == 1 && len(slb-tokens(row, locale)) > 0 ? 1 : 0;
    def slb-pair-ready?(a, b) = (Comparable) slb-locale-ready?(a) == 1 && ((Comparable) slb-locale-ready?(b) == 1 && !((String) a == b)) ? 1 : 0;
    // locate: the reverse of slb-tokens. Every existing sample in this
    // body builds FROM a meaning id TO locale tokens and asserts
    // the meaning id as given test data; nothing walks the other way, from
    // raw locale-specific tokens back TO the neutral meaning blueprint they
    // belong to. slb-meaning-for-tokens is that missing locate step -- the
    // honest floor: it only resolves tokens that exactly match one of this
    // baseline's four seed lines (0 = not found, same not-found sentinel
    // slb-find-line already uses). General vocabulary normalization across
    // open text stays open work.
    def slb-tokens-eq?(a, b) = (Comparable) len(a) == 0 && (Comparable) len(b) == 0 ? 1 : (Comparable) len(a) == 0 || (Comparable) len(b) == 0 ? 0 : (String) a[0] == b[0] ? slb-tokens-eq?(a[1:], b[1:]) : 0;
    def slb-meaning-for-tokens-loop(rows, locale, tokens) = (Comparable) len(rows) == 0 ? 0 : (Comparable) slb-tokens-eq?(slb-tokens(rows[0], locale), tokens) == 1 ? slb-meaning(rows[0]) : slb-meaning-for-tokens-loop(rows[1:], locale, tokens);
    def slb-meaning-for-tokens(locale, tokens) = slb-meaning-for-tokens-loop(slb-lines(), locale, tokens);
    // slb-locate-cross-locale?: does the SAME neutral meaning blueprint
    // locate from BOTH locale-specific token sets? This is the concrete,
    // runnable answer to "do a locale's tokens collapse to a shared
    // canonical Blueprint" -- 1 only when both sides locate to the same
    // nonzero meaning id, never by assuming the caller already knows it.
    def slb-locate-cross-locale?(locale-a, tokens-a, locale-b, tokens-b) = {
        let ma = slb-meaning-for-tokens(locale-a, tokens-a);
        let mb = slb-meaning-for-tokens(locale-b, tokens-b);
        ma > 0 && (Comparable) ma == mb ? 1 : 0;
    };
    0;
}
