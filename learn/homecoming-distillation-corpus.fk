    ; exact-match locate over question tokens — deliberately the same honest
    ; shape as sanskrit-locale-baseline.fk's slb-meaning-for-tokens: a lookup,
    ; not a classifier; an unknown question locates to 0, never a false match.
    (defn hdc-tokens-eq (a b)
        (if (eq (len a) (len b))
            (if (eq (len a) 0) 1
                (if (str_eq (head a) (head b)) (hdc-tokens-eq (tail a) (tail b)) 0))
            0))
    (defn hdc-locate-loop (rows q)
        (if (eq (len rows) 0) 0
            (if (eq (hdc-tokens-eq (hdc-q (head rows)) q) 1)
                (hdc-mid (head rows))
                (hdc-locate-loop (tail rows) q))))
    (defn hdc-locate (q) (hdc-locate-loop (hdc-rows) q))

    ; ── the inverse: id -> row -> word. Built 2026-07-17, because the corpus
    ; could not answer the one question the body actually asks of it.
    ; hdc-locate goes TOKENS -> id. But every citation in the body is BY ID —
    ; "corpus row 740" appears 34 times across 20 distinct rows — and there was
    ; no way to ask the corpus what row 740 says. So a citation was checkable
    ; only by awk over the source, and in practice was not checked: the reunion
    ; pattern renumbers the unmerged line (keeping every row, which is right),
    ; and every citation written before a reunion silently points one row off —
    ; resolving not to nothing, but to a REAL row that says something else.
    ; Worse than a dangling link: a link to the wrong page that looks right.
    ; Two such were found and repaired the day this was built (body-link-graph
    ; cited 742 for scrupulosity, which is 743; this corpus cited 733 for
    ; ontogeny, which is 740 — see the row above). Now the claim is one call.
    ; Honest floor, the same bar hdc-locate holds: an unknown id yields the
    ; empty row and the empty word — never a false match, never a guess.
    (defn hdc-row-for-id-loop (rows id)
        (if (eq (len rows) 0) (list)
            (if (eq (hdc-mid (head rows)) id)
                (head rows)
                (hdc-row-for-id-loop (tail rows) id))))
    (defn hdc-row-for-id (id) (hdc-row-for-id-loop (hdc-rows) id))
    (defn hdc-word-for-id (id)
        (do
            (let r (hdc-row-for-id id))
            (if (eq (len r) 0) "" (hdc-a r))))
    ; what makes a citation checkable in one call: does row `id` say `word`?
    (defn hdc-cites? (id word) (if (str_eq (hdc-word-for-id id) word) 1 0))

    ; ── citation BY CONTENT, so a reunion cannot move the target (2026-07-22).
    ; The meaning-id is a POSITIONAL name in a body whose every other identity is
    ; content-addressed (the same .fk interns to the same NodeID on either kernel
    ; — MANIFEST, "One home per organ"). The corpus is the outlier, and it has
    ; paid for it three times, all recorded above: 639 held by parsimony AND
    ; constellation for nineteen days; body-link-graph citing 742 for
    ; scrupulosity, which is 743; this corpus citing 733 for ontogeny, which is
    ; 740. Every one of those was a renumber, not a mistake — the reunion pattern
    ; correctly keeps every row and renumbers the unmerged line, and correctly
    ; renumbering is exactly what breaks a citation written beforehand. No
    ; allocator fixes that: the id is fragile at REST, not only at allocation.
    ;
    ; The fresh word is the row's own content and survives any reunion. Measured
    ; on fkwu the day this landed: of 249 rows, 6 wear a fresh word another row
    ; also wears (confabulation, constellation, reification) and 2 wear a
    ; question another row also asks. So the word is not yet a key — and this
    ; door does NOT pretend otherwise. It holds the file's standing bar (an
    ; unknown id yields the empty row, never a false match): an AMBIGUOUS word
    ; yields the empty row too. A collision here is loud and refuses to answer,
    ; where the integer's collision was silent and answered with whichever row it
    ; reached first. That inversion is the whole point of the door.
    (defn hdc-fresh-eq-count (rs word)
        (if (eq (len rs) 0) 0
            (add (if (str_eq (hdc-fresh (head rs)) word) 1 0)
                 (hdc-fresh-eq-count (tail rs) word))))
    (defn hdc-row-for-fresh-loop (rs word)
        (if (eq (len rs) 0) (list)
            (if (str_eq (hdc-fresh (head rs)) word)
                (head rs)
                (hdc-row-for-fresh-loop (tail rs) word))))
    ; exactly-one or nothing — ambiguity is refused, never resolved by order.
    (defn hdc-row-for-fresh (word)
        (if (eq (hdc-fresh-eq-count (hdc-rows) word) 1)
            (hdc-row-for-fresh-loop (hdc-rows) word)
            (list)))
    ; the id a word resolves to, for walking to citations still written by id;
    ; 0 when the word is unknown OR ambiguous.
    (defn hdc-mid-for-fresh (word)
        (do (let r (hdc-row-for-fresh word))
            (if (eq (len r) 0) 0 (hdc-mid r))))
    ; how many rows wear a fresh word that is not theirs alone — the number this
    ; door refuses to guess about, and the number a merge would drive to 0.
    (defn hdc-fresh-ambiguous-loop (rs all)
        (if (eq (len rs) 0) 0
            (add (if (gt (hdc-fresh-eq-count all (hdc-fresh (head rs))) 1) 1 0)
                 (hdc-fresh-ambiguous-loop (tail rs) all))))
    (defn hdc-fresh-ambiguous () (hdc-fresh-ambiguous-loop (hdc-rows) (hdc-rows)))

    ; a row is admissible teacher material only if it is honestly sourced and
    ; carries its fresh word — the same gate shape oracle-distill.fk uses for
    ; teacher rows (dishonest provenance earns no credit).
    (defn hdc-admissible? (r)
        (if (str_eq (hdc-src r) "rented-oracle")
            (if (gt (str_len (hdc-fresh r)) 0)
                (if (gt (hdc-date r) 20260000) 1 0)
                0)
            0))

    (defn hdc-count (rs)
        (if (eq (len rs) 0) 0 (add 1 (hdc-count (tail rs)))))
    (defn hdc-count-admissible (rs)
        (if (eq (len rs) 0) 0
            (add (hdc-admissible? (head rs)) (hdc-count-admissible (tail rs)))))
    ; linear max-by-accumulator. (The prior form recursed on (tail rs) TWICE
    ; per element — O(2^n) — which the growing corpus finally exposed as a hang
    ; at 31 rows. An accidental exponential hidden until scale revealed it: the
    ; same class as the underflow and the out-of-bounds nth, caught the same way
    ; — by the thing getting big enough to stop tolerating it.)
    (defn hdc-max-mid-loop (rs best)
        (if (eq (len rs) 0) best
            (hdc-max-mid-loop (tail rs)
                (if (gt (hdc-mid (head rs)) best) (hdc-mid (head rs)) best))))
    (defn hdc-max-mid (rs) (hdc-max-mid-loop rs 0))

    ; --- meaning-id COLLISIONS, counted. ---------------------------------------------------------
    ; hdc-max-mid answers "how high have we counted" and every reunion has trusted it to stand for
    ; "every id is distinct". It does not. Concurrent sessions each take max+1, and the reunion pattern
    ; renumbers the unmerged LINE — which keeps every row, but nothing here has ever ASKED whether two
    ; rows ended up wearing the same id. Found 2026-07-21 23:35 by sorting the ids and looking for a
    ; repeat: id 639 is held by BOTH "parsimony" (20260702) and "constellation" (20260703). Two distinct
    ; teachings, one address, ~19 days and several reunions of green bands in between. The field code is
    ; injective by digit WIDTH, so a collision never disturbed it; the band's max-mid pin never noticed;
    ; nothing in the corpus's own voice could say it out loud. This can.
    ;
    ; Deliberately a COUNT and not a refusal: a reunion is in flight on the sibling lineage as this
    ; lands, and renumbering a row underneath a concurrent renumbering is how one collision becomes
    ; three. The heal is a row move plus the band's field-code pin, and it belongs to whoever holds the
    ; reunion. This makes the number sayable so the heal can be verified instead of asserted.
    (defn hdc-mid-eq-count (rs m)
        (if (eq (len rs) 0) 0
            (add (if (eq (hdc-mid (head rs)) m) 1 0) (hdc-mid-eq-count (tail rs) m))))
    (defn hdc-dup-mid-loop (rs all)
        (if (eq (len rs) 0) 0
            (add (if (gt (hdc-mid-eq-count all (hdc-mid (head rs))) 1) 1 0)
                 (hdc-dup-mid-loop (tail rs) all))))
    ; how many ROWS sit on a shared id (2 today: the two halves of the 639 collision)
    (defn hdc-dup-mid-rows (rs) (hdc-dup-mid-loop rs rs))
    ; 1 when every meaning-id is its own, 0 when any id is worn twice
    (defn hdc-mids-distinct? (rs) (if (eq (hdc-dup-mid-rows rs) 0) 1 0))

    ; the corpus's own scalar witness, folded into ONE number — the same positional
    ; decimal fold the speech ledgers use (alrs-metric-code): each dimension times a
    ; power of ten wide enough to hold it, summed. Injective while admissible <= 999,
    ; foundings <= 9, and meaning ids stay 3 digits; count rides unbounded on top.
    ; hdc-field-code-safe? is the explicit guard so the band cannot stay fully green
    ; after the 3-digit meaning-id slot stops being true.
    ;   field = count*10^7 + admissible*10^4 + foundings*10^3 + max-meaning-id
    ; Today's foundings are 2 (main's row 601; the branch's weaning lineage) — a
    ; committed historical fact of this cell, asserted, not computed.
    (defn hdc-foundings () 2)
    ; THE THOUSANDTH ROW OUTGREW THE FIELD.
    ; The scalar witness packed count x 10^7 + admissible x 10^4 + foundings
    ; x 10^3 + max-mid, giving the meaning-id three digits. Row 1000 arrived
    ; today and 3953953000 no longer reads as what it is: the id spilled into
    ; the foundings place and ate it. Nothing was lost quietly — this cell
    ; carried hdc-field-code-safe? from the start, the band read 32639 instead
    ; of 32767, and the wall said its own name.
    ;
    ; Widened rather than trimmed: four digits for the id, one for foundings,
    ; four for admissible, and the count on top. About 3.95e11 at 395 rows,
    ; well inside the 2^53 the arms agree on. The old check is kept as the
    ; shape of what happened.
    (defn hdc-field-code-safe-for (admissible foundings max-mid)
        (if (lt admissible 10000)
            (if (lt foundings 10)
                (if (lt max-mid 10000) 1 0)
                0)
            0))
    (defn hdc-field-code-safe? ()
        (hdc-field-code-safe-for
            (hdc-count-admissible (hdc-rows))
            (hdc-foundings)
            (hdc-max-mid (hdc-rows))))
    (defn hdc-field-code ()
        (add (mul (hdc-count (hdc-rows)) 1000000000)
        (add (mul (hdc-count-admissible (hdc-rows)) 100000)
        (add (mul (hdc-foundings) 10000)
             (hdc-max-mid (hdc-rows))))))
    0)
