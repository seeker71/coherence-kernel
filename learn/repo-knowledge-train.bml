// The source corpus enters the existing native trainer in one model residence.
// A bounded request retains every checkpoint; it never promotes a serving voice.
// preludes: learn/repo-knowledge-corpus.bml form-stdlib/native-session-learning.bml
section [form.bml] {
 class RepoKnowledgeTrain {
  def rkt-archive-files(run,dir,names) {
   if nil?(names) then 0 else rkt-archive-file(run,dir,head(names),tail(names));
  }
  def rkt-archive-file(run,dir,name,rest) {
   let path = nsm-at(run,name);
   let copied = if fs-exists?(path) then rkc-keep(nsm-at(dir,name),rkc-read(path)) else 0;
   rkt-archive-files(run,dir,rest);
  }
  def rkt-preserve(run) {
   if nlw-running(run) then form_error("repository learner already running; observe its current attempt") else if not(fs-exists?(nsm-at(run,"train.log"))) then "first-attempt" else rkt-preserve-previous(run);
  }
  def rkt-preserve-previous(run) {
   let root = nsm-at(run,"attempts"); let made = fs-mkdir(root); let dir = nsm-at(root,nsm-id()); let ready = fs-mkdir(dir);
   let copied = rkt-archive-files(run,dir,list("train.log","train.err","train-supervisor.log","train-supervisor.err","train.pid","train-worker.pid","train.rc","result.json"));
   let status = nlw-status(run);
   let reading = oh-reading("repo-knowledge",run,"attempt-continuity",json-node-string("completed"),json-node-string(status),json-node-int(str_eq(status,"completed")),if str_eq(status,"completed") then list() else list(oh-need("completed-native-update",oh-reference(dir))),list("resume-preserved-attempt"),oh-reference(dir));
   let observed = nsm-event(hearth-session-learning(),"repository-continuity",list(json-node-pair("health",reading)));
   let response = oh-response(reading,"resume-preserved-attempt"); let selected = oh-select(reading,response,"defer");
   let received = nsm-event(hearth-session-learning(),"repository-continuity",list(json-node-pair("health",response)));
   let applied = nsm-event(hearth-session-learning(),"repository-continuity",list(json-node-pair("health",oh-applied(reading,selected,json-node-object(list(nsm-s("preserved_attempt",dir),nsm-s("action","preserved streams; retry admitted below")))))));
   if str_eq(selected,"resume-preserved-attempt") then dir else form_error("repository continuity response did not correlate");
  }
  def rkt-bound(manifest) {
   let data = nsm-str(manifest,"data");
   and(str_eq(nsm-hash(rkc-read(nsm-at(data,"train.jsonl"))),nsm-str(manifest,"train_sha256")),and(str_eq(nsm-hash(rkc-read(nsm-at(data,"valid.jsonl"))),nsm-str(manifest,"validation_sha256")),and(str_eq(nsm-hash(rkc-read(nsm-at(data,"heldout.jsonl"))),nsm-str(manifest,"heldout_sha256")),eq(len(nld-file(nsm-at(data,"train.jsonl"))),nsm-num(manifest,"train_examples")))));
  }
  def rkt-run(options) {
   let manifest = nsm-json(nsm-at(rkc-home(),"current.json"));
   if or(not(rkc-supported?(manifest)),not(rkt-bound(manifest))) then form_error("repository corpus absent or changed; rebuild from sources") else rkt-ready(manifest,options);
  }
  def rkt-ready(manifest,options) {
   let base = nsm-model(); let parent = nsl-candidate(hearth-session-learning(),base);
   let config = nsm-json(nsm-at(parent,"adapter_config.json"));
   let root = nsm-at(rkc-home(),"runs"); let made = fs-mkdir(root); let run = nsm-at(root,nsm-str(manifest,"id")); let directory = fs-mkdir(run);
   let previous = rkt-preserve(run);
   let steps = if json-object-has?(options,"steps") then nsm-num(options,"steps") else 2;
   let batch = if json-object-has?(options,"batch") then nsm-num(options,"batch") else 2;
   let request = ntr-request(base,parent,nsm-str(manifest,"data"),nsm-at(run,"adapter"),steps,batch,nsm-rate(hearth-session-learning()),1,nsm-num(config,"num_layers"));
   let selected = nsm-atomic(nsm-at(rkc-home(),"training-current.json"),json-node-object(list(nsm-s("corpus_id",nsm-str(manifest,"id")),nsm-n("available_training_examples",nsm-num(manifest,"train_examples")),nsm-s("run",run),json-node-pair("request",request),nsm-s("serving_policy","unchanged; research candidate"))));
   let result = nlw-run(request,run);
   let observed = json-node-object(list(nsm-s("corpus_id",nsm-str(manifest,"id")),nsm-s("status",head(result)),nsm-n("exit",nth(result,1)),nsm-s("run",run),nsm-s("training_events",nsm-at(nsm-at(run,"adapter"),"training-events.jsonl")),nsm-s("serving_policy","unchanged; research candidate")));
   let saved = nsm-atomic(nsm-at(run,"result.json"),observed);
   let reading = oh-reading("repo-knowledge",run,"native-training",json-node-int(0),json-node-int(nth(result,1)),json-node-int(eq(nth(result,1),0)),if eq(nth(result,1),0) then list() else list(oh-need("training-recovery",oh-reference(nsm-at(run,"train.err")))),list("inspect-per-row-loss","continue-native"),oh-reference(nsm-at(run,"result.json")));
   let retained = nsm-event(hearth-session-learning(),"repository-training",list(json-node-pair("health",reading)));
   let shown = oh-voice(reading);
   if eq(nth(result,1),0) then observed else form_error(str_concat("repository native training needs attention: ",nsm-at(run,"train.err")));
  }
 }
 0;
}
