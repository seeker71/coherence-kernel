; lane-fact-mint.fk — the lanes' own knowledge, minted for the local model:
; MLX, Metal, GPU, CPU-JIT facts extracted from the cells and the seed that
; ARE those lanes, so the model that will one day extend a missing stone has
; first eaten the stones that exist.
;
; THREE EXTRACTORS, each over a shape the body already writes:
;   defn-constants   (defn name () LITERAL) in Form cells — thresholds,
;                    marks, caps, paths: the lane's stated facts
;   defines          #define NAME VALUE in the seed — FK_INRAM_CACHE,
;                    FK_FN_CAP: the walls and their numbers
;   optable rows     { "name", arity, tag } — every native's arity and seat
;
; EVERY FACT EMITS UNDER THREE PHRASINGS. The same-door re-ask measured it:
; one row per fact does not survive paraphrase (#551). Three template
; phrasings per fact is the mechanical floor of the remedy; the guard from
; the coverage mint applies unchanged.
;
; preludes: form-stdlib/core.fk learn/corpus-train-emit.fk
;
; Proven by: form-stdlib/tests/lane-fact-mint-band.fk

(do
    ; ── shared: line walking ───────────────────────────────────────────────
    (defn lfm-line-at (s pos)
        (do (let e (str_find s "\n" pos))
            (if (lt e 0) (list (substring s pos (str_len s)) (str_len s))
                (list (substring s pos e) (add e 1)))))
    (defn lfm-clean? (tok i)
        (if (ge i (str_len tok)) (if (gt (str_len tok) 0) 1 0)
            (do (let b (str_byte_at tok i))
                (if (or (and (ge b 97) (le b 122)) (or (and (ge b 65) (le b 90))
                    (or (and (ge b 48) (le b 57)) (or (eq b 45) (or (eq b 95)
                        (or (eq b 46) (or (eq b 47) (eq b 63))))))))
                    (lfm-clean? tok (add i 1)) 0))))

    ; ── extractor 1: (defn name () LITERAL) ────────────────────────────────
    (defn lfm-defn-const (line)
        (do (let at (str_find line "(defn " 0))
            (if (lt at 0) (nothing)
                (do (let ns (add at 6))
                    (let ne (str_find line " " ns))
                    (if (lt ne 0) (nothing)
                        (do (let name (substring line ns ne))
                            (let pa (str_find line "()" ne))
                            (if (lt pa 0) (nothing)
                                (do (let vs (lfm-skip-sp line (add pa 2)))
                                    (lfm-literal line name vs)))))))))
    (defn lfm-skip-sp (s i)
        (if (ge i (str_len s)) i
            (if (eq (str_byte_at s i) 32) (lfm-skip-sp s (add i 1)) i)))
    ; a literal: "string") or number) — nothing for anything computed
    (defn lfm-literal (line name vs)
        (if (ge vs (str_len line)) (nothing)
            (do (let b (str_byte_at line vs))
                (if (eq b 34)
                    (do (let e (str_find line "\"" (add vs 1)))
                        (if (lt e 0) (nothing)
                            (lfm-fact name (substring line (add vs 1) e))))
                    (if (and (ge b 48) (le b 57))
                        (do (let e (lfm-num-end line vs))
                            (if (eq (str_byte_at line e) 41)
                                (lfm-fact name (substring line vs e))
                                (nothing)))
                        (nothing))))))
    (defn lfm-num-end (s i)
        (if (ge i (str_len s)) i
            (do (let b (str_byte_at s i))
                (if (and (ge b 48) (le b 57)) (lfm-num-end s (add i 1)) i))))
    (defn lfm-fact (name value)
        (if (and (eq (lfm-clean? name 0) 1) (gt (str_len value) 0))
            (list name value) (nothing)))

    ; ── extractor 2: #define NAME VALUE ────────────────────────────────────
    (defn lfm-define (line)
        (do (let at (str_find line "#define " 0))
            (if (lt at 0) (nothing)
                (do (let ns (add at 8))
                    (let ne (str_find line " " ns))
                    (if (lt ne 0) (nothing)
                        (do (let vs (lfm-skip-sp line ne))
                            (let ve (lfm-num-end line vs))
                            (if (le ve vs) (nothing)
                                (lfm-fact (substring line ns ne)
                                          (substring line vs ve)))))))))

    ; ── extractor 3: optable rows { "name", arity, tag } ───────────────────
    (defn lfm-optable (line)
        (do (let at (str_find line "{ \"" 0))
            (if (lt at 0) (nothing)
                (do (let ns (add at 3))
                    (let ne (str_find line "\"" ns))
                    (if (lt ne 0) (nothing)
                        (do (let name (substring line ns ne))
                            (let c1 (str_find line ", " ne))
                            (if (lt c1 0) (nothing)
                                (do (let a1 (add c1 2))
                                    (let a2 (lfm-num-end line a1))
                                    (if (le a2 a1) (nothing)
                                        (lfm-fact (str_concat name "/arity")
                                                  (substring line a1 a2)))))))))))

    ; ── walk a file with one extractor ─────────────────────────────────────
    (defn lfm-walk (s pos extractor out)
        (if (ge pos (str_len s)) out
            (do (let l (lfm-line-at s pos))
                (let f (extractor (nth l 0)))
                (lfm-walk s (nth l 1) extractor
                    (if (nothing? f) out (append out (list f)))))))
    (defn lfm-extract (path extractor)
        (if (lt (file_size path) 0) (list)
            (lfm-walk (read_file path) 0 extractor (list))))

    ; ── three phrasings per fact — the #551 remedy, mechanical ─────────────
    (defn lfm-q1 (src name)
        (str_concat "In " (str_concat src (str_concat ", what value does "
            (str_concat name " hold?")))))
    (defn lfm-q2 (src name)
        (str_concat "Name the exact value bound to " (str_concat name
            (str_concat " in " (str_concat src ".")))))
    (defn lfm-q3 (src name)
        (str_concat "What does " (str_concat name
            (str_concat " answer in " (str_concat src "?")))))

    (defn lfm-rows-for (src fact out)
        (do (let n (nth fact 0))
            (let v (nth fact 1))
            (append (append (append out
                (list (cm-lane-row (lfm-q1 src n) v)))
                (list (cm-lane-row (lfm-q2 src n) v)))
                (list (cm-lane-row (lfm-q3 src n) v)))))
    (defn cm-lane-row (q a)
        (str_concat "{\"messages\":[{\"role\":\"user\",\"content\":\"Answer with one word only. "
        (str_concat (cte-esc q)
        (str_concat "\"},{\"role\":\"assistant\",\"content\":\"" (str_concat (cte-esc a) "\"}]}")))))

    (defn lfm-rows-go (src facts out)
        (if (eq (len facts) 0) out
            (lfm-rows-go src (tail facts) (lfm-rows-for src (head facts) out))))

    (defn lfm-jsonl (rows)
        (if (eq (len rows) 0) ""
            (str_concat (head rows) (str_concat "\n" (lfm-jsonl (tail rows))))))

    ; ── the lanes: each source with its extractor ──────────────────────────
    (defn lfm-lanes ()
        (list
            (list "jit-decision.fk" "form/form-stdlib/jit-decision.fk" 1)
            (list "form-lower.fk" "form/form-stdlib/form-lower.fk" 1)
            (list "jit-once-born.fk" "form/form-stdlib/jit-once-born.fk" 1)
            (list "form-cli-peer-agent.fk" "form/form-stdlib/form-cli-peer-agent.fk" 1)
            (list "fkwu-uni.c" "runtime/fkwu-uni.c" 2)
            (list "fkwu-optable.h" "runtime/fkwu-optable.h" 3)))
    (defn lfm-extractor-for (kind)
        (if (eq kind 1) lfm-defn-const (if (eq kind 2) lfm-define lfm-optable)))

    (defn lfm-mint-lane (lane)
        (do (let facts (lfm-extract (nth lane 1) (lfm-extractor-for (nth lane 2))))
            (list (nth lane 0) (len facts)
                  (lfm-rows-go (nth lane 0) facts (list)))))
    (defn lfm-mint-all-go (lanes rows counts)
        (if (eq (len lanes) 0) (list rows counts)
            (do (let m (lfm-mint-lane (head lanes)))
                (lfm-mint-all-go (tail lanes)
                    (lfm-append-all rows (nth m 2))
                    (append counts (list (list (nth m 0) (nth m 1))))))))
    (defn lfm-append-all (a b)
        (if (eq (len b) 0) a (lfm-append-all (append a (list (head b))) (tail b))))
    (defn lfm-mint-all () (lfm-mint-all-go (lfm-lanes) (list) (list)))
    0)
