; hati-suci-core-text-invitation.fk — the first community invitation is a
; relationship receipt, never a text-admission receipt.
;
; Hati Suci is already named by NORTH_STAR.md as the household's first field.
; The initiating member has reported their own membership and may therefore
; introduce this enquiry to the community. That report opens an invitation
; route; it does not speak for the community, select a text, or license shared
; knowledge.
;
; Pilot:
;   [order,community-node,recognized-circle-node,initiating-member-role,
;    relationship-evidence,circle-evidence,circle-role,community-response,
;    terms,witnessed-epoch]
;
; Relationship evidence:
;   0 unobserved, 1 reported by the initiating member, 2 community-confirmed
; Circle evidence uses the same scale. The current Satsang recognition is
; member-reported=1.
; Circle role:
;   0 unobserved, 1 receive/witness, 2 select/approve, 3 both
; The current role is both. That names who may make the decision; it does not
; fabricate the circle's decision about an exact text.
; Community/term response:
;   0 pending, 1 confirmed, 2 declined
;
; Terms, in order:
;   exact text/item, community authority/process, cultural restrictions,
;   attribution/translator credit, translation/transliteration,
;   downstream/AI use, benefit/reciprocity, withdrawal/removal,
;   freshness/review date
;
; The four acknowledgement arms are:
;   nothing  no relationship door has been observed
;   0        the community or one of its terms declines
;   1        the community and every named term confirm
;   node     a concrete next action is offered to the responsible circle
;
; A 1 here authorizes handoff to the exact-edition source registry. It never
; admits text by itself. The Light Hubs is now selected and registered there
; as metadata-only. Giles' member-witnessed permission is recorded, while
; Hati Suci records no additional cultural restriction or benefit condition.
; Freshness and a revocable carrier remain open; no text body is present.
;
; witnessed: 2026-07-26 -> 4095 live fkwu integration;
;                              127 pure structural projection
import "../cognition/language-neutral-symbol-identity.fk"

(do
  (defn hscti-pending () 0)
  (defn hscti-confirmed () 1)
  (defn hscti-declined () 2)
  (defn hscti-circle-role-unobserved () 0)
  (defn hscti-circle-role-receive () 1)
  (defn hscti-circle-role-authorize () 2)
  (defn hscti-circle-role-both () 3)

  ; Levels 41-44 continue the core-text package after levels 36-40.
  (defn hscti-community-node () (lnsi-node 3 41 1 1))
  (defn hscti-initiating-member-role () (lnsi-node 3 41 2 1))
  (defn hscti-satsang-circle-node () (lnsi-node 3 41 3 1))
  (defn hscti-review-node (reason) (lnsi-node 3 42 reason 1))
  (defn hscti-action-node (term) (lnsi-node 3 43 (add term 1) 1))
  (defn hscti-counteroffer-node (term) (lnsi-node 3 44 (add term 1) 1))

  (defn hscti-term-exact-text () 0)
  (defn hscti-term-authority-process () 1)
  (defn hscti-term-cultural () 2)
  (defn hscti-term-attribution () 3)
  (defn hscti-term-translation () 4)
  (defn hscti-term-downstream () 5)
  (defn hscti-term-benefit () 6)
  (defn hscti-term-withdrawal () 7)
  (defn hscti-term-freshness () 8)

  (defn hscti-terms
    (exact-text authority cultural attribution translation downstream benefit
      withdrawal freshness)
    (list exact-text authority cultural attribution translation downstream
      benefit withdrawal freshness))

  (defn hscti-pending-terms ()
    (hscti-terms
      (hscti-pending) (hscti-pending) (hscti-pending)
      (hscti-pending) (hscti-pending) (hscti-pending)
      (hscti-pending) (hscti-pending) (hscti-pending)))

  (defn hscti-confirmed-terms ()
    (hscti-terms
      (hscti-confirmed) (hscti-confirmed) (hscti-confirmed)
      (hscti-confirmed) (hscti-confirmed) (hscti-confirmed)
      (hscti-confirmed) (hscti-confirmed) (hscti-confirmed)))

  (defn hscti-current-terms ()
    (hscti-terms
      (hscti-confirmed)
      (hscti-confirmed) (hscti-confirmed) (hscti-confirmed)
      (hscti-confirmed) (hscti-confirmed) (hscti-confirmed)
      (hscti-confirmed) (hscti-pending)))

  (defn hscti-current-decisions-recorded? (p)
    (do
      (let terms (hscti-pilot-terms p))
      (if (and
        (eq (nth terms 0) (hscti-confirmed))
        (and (eq (nth terms 1) (hscti-confirmed))
        (and (eq (nth terms 2) (hscti-confirmed))
        (and (eq (nth terms 3) (hscti-confirmed))
        (and (eq (nth terms 4) (hscti-confirmed))
        (and (eq (nth terms 5) (hscti-confirmed))
        (and (eq (nth terms 6) (hscti-confirmed))
        (and (eq (nth terms 7) (hscti-confirmed))
             (eq (nth terms 8) (hscti-pending)))))))))) 1 0)))

  (defn hscti-pilot
    (order community circle initiator relationship circle-evidence
      circle-role community-response terms epoch)
    (list order community circle initiator relationship circle-evidence
      circle-role community-response terms epoch))
  (defn hscti-order (p) (nth p 0))
  (defn hscti-community (p) (nth p 1))
  (defn hscti-circle (p) (nth p 2))
  (defn hscti-initiator (p) (nth p 3))
  (defn hscti-relationship (p) (nth p 4))
  (defn hscti-circle-evidence (p) (nth p 5))
  (defn hscti-circle-role (p) (nth p 6))
  (defn hscti-community-response (p) (nth p 7))
  (defn hscti-pilot-terms (p) (nth p 8))
  (defn hscti-epoch (p) (nth p 9))

  ; The currently grounded movement: first pilot, member-reported membership,
  ; member-reported recognition of Hati Suci's Satsang circle in both roles,
  ; and The Light Hubs selected as the exact first material. The initiating
  ; member now also reports Giles' scoped permission. A direct signed author
  ; artifact is not fabricated. No additional cultural restrictions are
  ; recorded, and no benefit is required; freshness and a revocable carrier
  ; remain open.
  (defn hscti-current-pilot ()
    (hscti-pilot 1
      (hscti-community-node)
      (hscti-satsang-circle-node)
      (hscti-initiating-member-role)
      1
      1
      (hscti-circle-role-both)
      (hscti-pending)
      (hscti-current-terms)
      20260726))

  (defn hscti-circle-recognized? (p)
    (if (and
      (gt (hscti-circle p) 0)
      (gt (hscti-circle-evidence p) 0)) 1 0))

  (defn hscti-circle-can-receive? (p)
    (if (and
      (gt (hscti-relationship p) 0)
      (and (eq (hscti-circle-recognized? p) 1)
        (or
          (eq (hscti-circle-role p) (hscti-circle-role-receive))
          (eq (hscti-circle-role p) (hscti-circle-role-both))))) 1 0))

  (defn hscti-circle-can-authorize? (p)
    (if (and
      (gt (hscti-relationship p) 0)
      (and (eq (hscti-circle-recognized? p) 1)
        (or
          (eq (hscti-circle-role p) (hscti-circle-role-authorize))
          (eq (hscti-circle-role p) (hscti-circle-role-both))))) 1 0))

  ; Recognized authority and a directly witnessed circle decision remain
  ; different receipts. Term 1 can carry the initiating member's report of
  ; selection plus the author's grant; this stricter predicate reaches 1 only
  ; when circle-evidence itself is direct (2).
  (defn hscti-circle-authority-confirmed? (p)
    (if (and
      (eq (hscti-circle-can-authorize? p) 1)
      (and (eq (hscti-circle-evidence p) 2)
        (eq (nth (hscti-pilot-terms p) 1) (hscti-confirmed)))) 1 0))

  (defn hscti-all-confirmed-loop (terms)
    (if (eq (len terms) 0) 1
      (if (eq (head terms) (hscti-confirmed))
        (hscti-all-confirmed-loop (tail terms)) 0)))
  (defn hscti-all-confirmed? (terms)
    (hscti-all-confirmed-loop terms))

  (defn hscti-any-declined-loop (terms)
    (if (eq (len terms) 0) 0
      (if (eq (head terms) (hscti-declined)) 1
        (hscti-any-declined-loop (tail terms)))))
  (defn hscti-any-declined? (terms)
    (hscti-any-declined-loop terms))

  (defn hscti-first-pending-loop (terms index)
    (if (eq (len terms) 0) (nothing)
      (if (eq (head terms) (hscti-pending)) index
        (hscti-first-pending-loop (tail terms) (add index 1)))))
  (defn hscti-first-pending (p)
    (hscti-first-pending-loop (hscti-pilot-terms p) 0))

  ; A node must offer movement, not merely rename incompleteness. The current
  ; action node encodes the first open term; the counteroffer node lets the
  ; circle propose a different candidate or condition without collapsing to 0.
  (defn hscti-next-action-node (p)
    (do
      (let term (hscti-first-pending p))
      (if (nothing? term)
        (hscti-review-node (hscti-reason p))
        (hscti-action-node term))))

  ; offer =
  ; [action-node,responsible-circle,term,nothing,0,1,counteroffer-node,epoch]
  ;
  ; For the current freshness/review query:
  ;   nothing no review date or cadence has been observed
  ;   0       permission expires or is not renewed at review
  ;   1       a date/cadence, "on change", or no scheduled review is recorded
  ;   node    Satsang proposes a precise re-witness schedule
  (defn hscti-action-offer (p)
    (do
      (let term (hscti-first-pending p))
      (if (nothing? term)
        (list (hscti-review-node (hscti-reason p))
          (hscti-circle p) term (nothing) 0 1
          (hscti-review-node (hscti-reason p)) (hscti-epoch p))
        (list (hscti-action-node term)
          (hscti-circle p) term (nothing) 0 1
          (hscti-counteroffer-node term) (hscti-epoch p)))))

  ; Class is a pure four-way projection:
  ;   0 unresolved/nothing, 1 refused/0, 2 confirmed/1, 3 review/node.
  (defn hscti-class (p)
    (if (eq (hscti-relationship p) 0) 0
      (if (eq (hscti-community-response p) (hscti-declined)) 1
        (if (eq (hscti-any-declined? (hscti-pilot-terms p)) 1) 1
          (if (and
            (eq (hscti-community-response p) (hscti-confirmed))
            (eq (hscti-all-confirmed? (hscti-pilot-terms p)) 1))
            2 3)))))

  ; Reason:
  ;   0 complete, 1 no relationship, 2 community declined,
  ;   3 one or more terms declined, 4 awaiting community response,
  ;   5 terms remain pending.
  (defn hscti-reason (p)
    (if (eq (hscti-relationship p) 0) 1
      (if (eq (hscti-community-response p) (hscti-declined)) 2
        (if (eq (hscti-any-declined? (hscti-pilot-terms p)) 1) 3
          (if (eq (hscti-community-response p) (hscti-pending)) 4
            (if (eq (hscti-all-confirmed? (hscti-pilot-terms p)) 1)
              0 5))))))

  (defn hscti-ack (p)
    (do
      (let class (hscti-class p))
      (if (eq class 0) (nothing)
        (if (eq class 1) 0
          (if (eq class 2) 1
            (hscti-next-action-node p))))))

  ; response =
  ; [nothing,0,1,alternative,ack,reason,community,circle,relationship,
  ;  circle-evidence,circle-role,community-response,terms,epoch,action-offer]
  (defn hscti-response (p)
    (list (nothing) 0 1 (hscti-next-action-node p)
      (hscti-ack p) (hscti-reason p) (hscti-community p)
      (hscti-circle p) (hscti-relationship p) (hscti-circle-evidence p)
      (hscti-circle-role p) (hscti-community-response p)
      (hscti-pilot-terms p) (hscti-epoch p) (hscti-action-offer p)))
  (defn hscti-r-ack (r) (nth r 4))
  (defn hscti-r-reason (r) (nth r 5))
  (defn hscti-r-offer (r) (nth r 14))

  (defn hscti-source-handoff-ready? (p)
    (if (eq (hscti-class p) 2) 1 0))

  ; Synthetic fixtures prove the membrane. They are not community receipts.
  (defn hscti-with
    (relationship circle-evidence circle-role community-response terms)
    (hscti-pilot 1
      (hscti-community-node)
      (hscti-satsang-circle-node)
      (hscti-initiating-member-role)
      relationship circle-evidence circle-role community-response terms
      20260726))

  (defn hscti-structure-witness ()
    (do
      (let current (hscti-current-pilot))
      (let absent
        (hscti-with 0 0 (hscti-circle-role-unobserved)
          (hscti-pending) (hscti-pending-terms)))
      (let declined
        (hscti-with 1 1 (hscti-circle-role-both)
          (hscti-declined) (hscti-pending-terms)))
      (let confirmed
        (hscti-with 2 2 (hscti-circle-role-both)
          (hscti-confirmed) (hscti-confirmed-terms)))
      (let term-declined
        (hscti-with 2 2 (hscti-circle-role-both) (hscti-confirmed)
          (hscti-terms
            1 1 1 1 1 2 1 1 1)))
      (add (if (eq (hscti-class current) 3) 1 0)
        (add (if (eq (hscti-class absent) 0) 2 0)
          (add (if (eq (hscti-class declined) 1) 4 0)
            (add (if (eq (hscti-class confirmed) 2) 8 0)
              (add (if (and
                (eq (hscti-circle-can-receive? current) 1)
                (and (eq (hscti-circle-can-authorize? current) 1)
                  (eq (hscti-circle-authority-confirmed? current) 0)))
                16 0)
                (add (if (eq (hscti-class term-declined) 1) 32 0)
                  (if (and
                    (eq (len (hscti-pilot-terms current)) 9)
                    (and (eq (hscti-current-decisions-recorded? current) 1)
                    (and (eq (hscti-all-confirmed?
                      (hscti-pilot-terms current)) 0)
                      (and (eq (hscti-first-pending current)
                        (hscti-term-freshness))
                        (eq (hscti-source-handoff-ready? current) 0)))))
                    64 0))))))))
    )

  0)
